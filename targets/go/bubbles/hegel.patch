diff --git a/cursor/hegel_shapes_test.go b/cursor/hegel_shapes_test.go
new file mode 100644
index 0000000..533bac4
--- /dev/null
+++ b/cursor/hegel_shapes_test.go
@@ -0,0 +1,61 @@
+package cursor
+
+// The shape regions of the recorded cursor bugs (bugs.toml bubbles/96, 97) and the
+// narrow properties over them: each region is a generator over the bug's shape with
+// random contents, judged exactly like the wide property (judgeCursor). Every narrow
+// property fails every run by default; under HEGEL_NO_KNOWN=1 its generator is the
+// region next to the shape instead (zootest.Shaped) and the property passes. Both
+// shapes are panics the library reaches on every instance (measured: 100 of 100 with
+// math/rand over the library).
+
+import (
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+// narrowCursor runs a narrow property: every drawn case through the wide property's
+// judge.
+func narrowCursor(t *testing.T, cases hegel.Generator[cursorCase]) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeCursor(j, c)
+	})
+}
+
+// --------------------------------------------------------------------------- bubbles/96
+
+// modeOutOfRange: a New() cursor, up to six quiet operations, a SetMode with a mode
+// past CursorHide (ignored by SetMode; the step note prints it with %v and Mode.String
+// panics on every such mode) and up to six operations more; past the shape, a mode in
+// range.
+var modeOutOfRange = casesOf(hegel.Just(false), zootest.Seq(
+	zootest.Counted(quietOps, 0, 6),
+	zootest.One(hegel.Map(zootest.Shaped(outOfRangeModes, inRangeModes), setMode)),
+	zootest.Counted(cursorOps, 0, 6),
+))
+
+func TestHegelCursorModeOutOfRange(t *testing.T) {
+	narrowCursor(t, modeOutOfRange)
+}
+
+// --------------------------------------------------------------------------- bubbles/97
+
+// zeroValueFocused: the zero-value Model in its blink mode, up to six operations that
+// keep it so (no Focus, no SetMode: Blur, blinks, the initial blink, SetChar and the
+// cancelled blink all work on it), then Focus or the focus message (a nil blink
+// context: a panic on every instance) and up to six operations more; past the shape,
+// New().
+var zeroValueFocused = casesOf(hegel.Just(zootest.Shaped(true, false)), zootest.Seq(
+	zootest.Counted(blinkOps, 0, 6),
+	zootest.One(zootest.Sampled(cursorOp{kind: "focus"}, cursorOp{kind: "focusmsg"})),
+	zootest.Counted(cursorOps, 0, 6),
+))
+
+func TestHegelCursorZeroValueFocused(t *testing.T) {
+	narrowCursor(t, zeroValueFocused)
+}
diff --git a/cursor/hegel_test.go b/cursor/hegel_test.go
new file mode 100644
index 0000000..b3e658f
--- /dev/null
+++ b/cursor/hegel_test.go
@@ -0,0 +1,354 @@
+package cursor
+
+// Hegel zoo: properties of the cursor component against a mirror of its
+// focus, mode, blink state and blink tag. A case is a start (New(), or one
+// time in five the zero-value Model, bubbles/97's shape) and a list of
+// operation records applied in order; the shapes of the recorded bugs are
+// drawn like any other case and fail naming them (cursorShape), and are not
+// drawn under HEGEL_NO_KNOWN=1.
+//
+// Run with BUBBLES_COLLECT=1 to record mismatches instead of failing.
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+var cursorChars = []string{"x", " ", "", "全", "ab", "é"}
+
+// cursorOp is one operation on the cursor: Focus/Blur, SetMode (a mode in range or,
+// one time in ten, one past CursorHide, which SetMode ignores and whose String panics:
+// bubbles/96), a blink message with the expected tag, a stale one (stale is the offset)
+// or another cursor's id, the initial blink, the focus and blur messages, SetChar and a
+// cancelled blink.
+type cursorOp struct {
+	kind    string
+	mode    Mode   // setmode
+	stale   int    // blink: offset from the expected tag, 0 for the expected tag
+	foreign bool   // blink: another cursor's id
+	char    string // setchar
+}
+
+func (o cursorOp) outOfRange() bool {
+	return o.kind == "setmode" && (o.mode < CursorBlink || o.mode > CursorHide)
+}
+func (o cursorOp) focuses() bool { return o.kind == "focus" || o.kind == "focusmsg" }
+
+// GoString is the draw report's spelling (the mode as a number: Mode.String panics out
+// of range, which is what String below is for).
+func (o cursorOp) GoString() string {
+	switch o.kind {
+	case "setmode":
+		return fmt.Sprintf("setmode(%d)", int(o.mode))
+	case "blink":
+		switch {
+		case o.foreign:
+			return "blink(foreign)"
+		case o.stale != 0:
+			return fmt.Sprintf("blink(tag%+d)", o.stale)
+		}
+		return "blink"
+	case "setchar":
+		return fmt.Sprintf("setchar(%q)", o.char)
+	}
+	return o.kind
+}
+
+// describe is the step note's spelling: the mode in the library's human-readable form
+// (Mode.String; called directly, since fmt swallows a panic in a String method).
+func (o cursorOp) describe() string {
+	if o.kind == "setmode" {
+		return "setmode(" + o.mode.String() + ")"
+	}
+	return o.GoString()
+}
+
+// cursorCase is a start and the operations.
+type cursorCase struct {
+	zero bool // the zero-value Model instead of New() (bubbles/97)
+	char string
+	ops  []cursorOp
+}
+
+func (c cursorCase) GoString() string {
+	start := "New()"
+	if c.zero {
+		start = "Model{}"
+	}
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	return fmt.Sprintf("%s char %q: %s", start, c.char, strings.Join(ops, ", "))
+}
+
+func modeOf(n int) Mode                          { return Mode(n) }
+func setMode(m Mode) cursorOp                    { return cursorOp{kind: "setmode", mode: m} }
+func setChar(s string) cursorOp                  { return cursorOp{kind: "setchar", char: s} }
+func staleBlink(off int) cursorOp                { return cursorOp{kind: "blink", stale: off} }
+func opOf(kind string) hegel.Generator[cursorOp] { return hegel.Just(cursorOp{kind: kind}) }
+
+var (
+	chars = zootest.Sampled(cursorChars...)
+
+	// inRangeModes: blink, static, hidden; outOfRangeModes: past CursorHide (SetMode
+	// ignores them; printing one is bubbles/96).
+	inRangeModes    = hegel.Map(zootest.Ints(0, 2), modeOf)
+	outOfRangeModes = hegel.Map(zootest.Ints(3, 7), modeOf)
+	// modes: in range, or one time in ten out of range (never under HEGEL_NO_KNOWN=1).
+	modes = zootest.Weighted(
+		zootest.W(9, inRangeModes),
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), outOfRangeModes),
+	)
+
+	// blinks: the expected blink message (13 in 20), a stale tag (4 in 20: off by -1,
+	// 1, 2 or 3) or another cursor's id (3 in 20).
+	blinks = zootest.Weighted(
+		zootest.W(13, opOf("blink")),
+		zootest.W(4, hegel.Map(zootest.Sampled(-1, 1, 2, 3), staleBlink)),
+		zootest.W(3, hegel.Just(cursorOp{kind: "blink", foreign: true})),
+	)
+
+	// cursorOps: the operations at the old property's weights, Focus first (the
+	// simplest; on the zero-value Model it is bubbles/97).
+	cursorOps = cursorOpsOf(modes, nil)
+	// quietOps: the operations that reach no recorded bug whatever the start: no Focus
+	// and no mode out of range (the narrow properties' prefixes); blinkOps keep the
+	// mode too (the zero-value Model panics on Focus in blink mode only).
+	quietOps = cursorOpsOf(inRangeModes, []string{"focus", "focusmsg"})
+	blinkOps = cursorOpsOf(inRangeModes, []string{"focus", "focusmsg", "setmode"})
+
+	// starts: the zero-value Model one time in five (first: the shape the wide property
+	// reaches every run, bubbles/97), never under HEGEL_NO_KNOWN=1.
+	starts = zootest.Weighted(
+		zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(true)),
+		zootest.W(4, hegel.Just(false)),
+	)
+
+	// cursorCases: a start, a character and one to fourteen operations.
+	cursorCases = casesOf(starts, zootest.Counted(cursorOps, 1, 14))
+)
+
+// cursorOpsOf: the operations with the mode generator, the kinds in without left out.
+func cursorOpsOf(modes hegel.Generator[Mode], without []string) hegel.Generator[cursorOp] {
+	w := func(weight int, kind string) int {
+		if slices.Contains(without, kind) {
+			return 0
+		}
+		return weight
+	}
+	return zootest.Weighted(
+		zootest.W(w(2, "focus"), opOf("focus")),
+		zootest.W(1, opOf("blur")),
+		zootest.W(w(2, "setmode"), hegel.Map(modes, setMode)),
+		zootest.W(4, blinks),
+		zootest.W(1, opOf("initial")),
+		zootest.W(w(1, "focusmsg"), opOf("focusmsg")),
+		zootest.W(1, opOf("blurmsg")),
+		zootest.W(1, hegel.Map(chars, setChar)),
+		zootest.W(1, opOf("canceled")),
+	)
+}
+
+// casesOf: a case from the start and the operations.
+func casesOf(zero hegel.Generator[bool], ops hegel.Generator[[]cursorOp]) hegel.Generator[cursorCase] {
+	return hegel.Composite(func(tc hegel.TestCase) cursorCase {
+		return cursorCase{zero: hegel.Draw(tc, zero), char: hegel.Draw(tc, chars), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+// cursorShape names the recorded bug whose shape the case has, by the first operation
+// that reaches one: a Focus (or focus message) of the zero-value Model, whose blink
+// context is nil (bubbles/97, a panic); a SetMode with a mode out of range, printed by
+// the step note (bubbles/96, a panic in Mode.String).
+func cursorShape(c cursorCase) string {
+	for _, o := range c.ops {
+		switch {
+		case c.zero && o.focuses():
+			return "bubbles/97"
+		case o.outOfRange():
+			return "bubbles/96"
+		}
+	}
+	return ""
+}
+
+// cmir mirrors the cursor.
+type cmir struct {
+	focus   bool
+	mode    Mode
+	blinked bool
+	tag     int
+	char    string
+}
+
+// judgeCursor drives the cursor through the case against the mirror and checks
+// IsBlinked, Mode, the blink tag, whether a command was returned and the view after
+// every step; the wide and the narrow properties share it.
+func judgeCursor(j *zootest.Judge, c cursorCase) {
+	j.Shape(cursorShape(c))
+	m := New()
+	if c.zero {
+		m = Model{}
+	}
+	// the mirror starts from the model's public blink state (New() blinks the cursor
+	// off; the zero value has it on) and its mode
+	s := &cmir{blinked: m.IsBlinked, mode: m.Mode()}
+	id := m.id
+
+	check := func(what string) {
+		if m.IsBlinked != s.blinked || m.Mode() != s.mode || m.blinkTag != s.tag || m.focus != s.focus {
+			j.Fail("%s: blinked %v mode %v tag %d focus %v, expected %v %v %d %v",
+				what, m.IsBlinked, m.Mode(), m.blinkTag, m.focus, s.blinked, s.mode, s.tag, s.focus)
+		}
+		cells := zootest.Cells(m.View())
+		if got := zootest.Plain(cells); got != s.char {
+			j.Fail("%s: view shows %q, expected %q", what, got, s.char)
+		}
+		for _, cell := range cells {
+			if cell.Rev == s.blinked {
+				j.Fail("%s: cell %q reverse %v with the cursor blinked %v", what, cell.S, cell.Rev, s.blinked)
+			}
+		}
+	}
+	wantCmd := func(what string, cmd tea.Cmd, want bool) {
+		if (cmd != nil) != want {
+			j.Fail("%s: command %v, expected %v", what, cmd != nil, want)
+		}
+	}
+	// focus mirrors Focus(): the cursor shows unless hidden, and blinks
+	// (a new tag) when in blink mode.
+	focus := func(what string, cmd tea.Cmd) {
+		s.focus = true
+		s.blinked = s.mode == CursorHide
+		if s.mode == CursorBlink {
+			s.tag++
+		}
+		wantCmd(what, cmd, s.mode == CursorBlink)
+		check(what)
+	}
+	blur := func(what string) {
+		s.focus = false
+		s.blinked = true
+		check(what)
+	}
+	// initial mirrors an initialBlinkMsg: a blink starts only when the
+	// cursor is focused and in blink mode.
+	initial := func(what string, cmd tea.Cmd) {
+		starts := s.focus && s.mode == CursorBlink
+		if starts {
+			s.tag++
+		}
+		wantCmd(what, cmd, starts)
+		check(what)
+	}
+
+	m.SetChar(c.char)
+	s.char = m.char
+	check("new")
+	for step, op := range c.ops {
+		switch op.kind {
+		case "focus":
+			focus("focus", m.Focus())
+		case "blur":
+			m.Blur()
+			blur("blur")
+		case "focusmsg":
+			var cmd tea.Cmd
+			m, cmd = m.Update(tea.FocusMsg{})
+			focus("focusmsg", cmd)
+		case "blurmsg":
+			var cmd tea.Cmd
+			m, cmd = m.Update(tea.BlurMsg{})
+			wantCmd("blurmsg", cmd, false)
+			blur("blurmsg")
+		case "setmode":
+			cmd := m.SetMode(op.mode)
+			if op.outOfRange() {
+				// Out of range: ignored.
+				wantCmd("setmode out of range", cmd, false)
+				check("setmode out of range")
+				break
+			}
+			s.mode = op.mode
+			s.blinked = op.mode == CursorHide || !s.focus
+			wantCmd("setmode", cmd, op.mode == CursorBlink)
+			check("setmode")
+			if cmd != nil {
+				// Deliver the initial blink it asked for.
+				m, cmd = m.Update(cmd())
+				initial("setmode initial blink", cmd)
+			}
+		case "initial":
+			var cmd tea.Cmd
+			m, cmd = m.Update(Blink())
+			initial("initial", cmd)
+		case "blink":
+			msg := BlinkMsg{id: id, tag: s.tag + op.stale}
+			if op.foreign {
+				msg.id = id + 1000
+			}
+			var cmd tea.Cmd
+			m, cmd = m.Update(msg)
+			accepted := s.focus && s.mode == CursorBlink && msg.id == id && msg.tag == s.tag
+			if accepted {
+				s.blinked = !s.blinked
+				s.tag++
+			}
+			wantCmd("blink", cmd, accepted)
+			check("blink")
+		case "setchar":
+			m.SetChar(op.char)
+			s.char = m.char
+			check("setchar")
+		case "canceled":
+			var cmd tea.Cmd
+			m, cmd = m.Update(blinkCanceled{})
+			wantCmd("canceled", cmd, false)
+			check("canceled")
+		}
+		// the step in the library's human-readable form (Mode.String panics on a
+		// mode out of range: bubbles/96)
+		j.Note("step %d: %s (focus %v, mode %v, blinked %v, tag %d)", step, op.describe(), s.focus, s.mode, s.blinked, s.tag)
+	}
+}
+
+// TestHegelCursorFollowsFocus drives a cursor with Focus/Blur/SetMode, the
+// focus and blur messages, initial and tagged blink messages, and checks
+// IsBlinked, Mode, the blink tag, whether a command was returned and the
+// view (the character, drawn in reverse video exactly when the cursor is
+// shown). Blink messages are built directly with the tag the mirror expects
+// rather than waited for.
+func TestHegelCursorFollowsFocus(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cursorCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeCursor(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// bubbles/96
+func TestHegelPinCursorModeStringPanics(t *testing.T) {
+	defer zootest.Guard(t)
+	_ = Mode(3).String()
+	_ = Mode(-1).String()
+}
+
+// bubbles/97
+func TestHegelPinCursorZeroValueFocusPanics(t *testing.T) {
+	defer zootest.Guard(t)
+	var m Model
+	m.SetChar("x")
+	_ = m.Focus()
+	_ = m.View()
+}
diff --git a/filepicker/hegel_test.go b/filepicker/hegel_test.go
new file mode 100644
index 0000000..6c69864
--- /dev/null
+++ b/filepicker/hegel_test.go
@@ -0,0 +1,779 @@
+package filepicker
+
+// Hegel properties for the file picker: a random directory tree is built in
+// a temporary directory and the picker driven through every binding, the
+// window messages and the setters against a mirror of its listing, window
+// and selection; the view, the highlighted path and the selection reports
+// are checked after every step.
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/dustin/go-humanize"
+	"hegel.dev/go/hegel"
+)
+
+// fent is one entry of a listing as the picker sees it.
+type fent struct {
+	name    string
+	dir     bool // IsDir of the entry itself (false for a symlink)
+	link    bool
+	target  string // EvalSymlinks of a symlink, "" when broken
+	linkDir bool   // the symlink's target is a directory
+	mode    string
+	size    string
+}
+
+// readEntries lists dir the way readDir does: directories first, names
+// ascending, hidden names dropped unless showHidden.
+func readEntries(dir string, showHidden bool) ([]fent, error) {
+	des, err := os.ReadDir(dir)
+	if err != nil {
+		return nil, err
+	}
+	sort.SliceStable(des, func(i, j int) bool {
+		if des[i].IsDir() == des[j].IsDir() {
+			return des[i].Name() < des[j].Name()
+		}
+		return des[i].IsDir()
+	})
+	var out []fent
+	for _, de := range des {
+		if !showHidden && strings.HasPrefix(de.Name(), ".") {
+			continue
+		}
+		info, err := de.Info()
+		if err != nil {
+			return nil, err
+		}
+		e := fent{name: de.Name(), dir: de.IsDir(), mode: info.Mode().String()}
+		e.size = strings.Replace(humanize.Bytes(uint64(info.Size())), " ", "", 1)
+		if info.Mode()&os.ModeSymlink != 0 {
+			e.link = true
+			e.target, _ = filepath.EvalSymlinks(filepath.Join(dir, de.Name()))
+			if st, err := os.Stat(e.target); err == nil && st.IsDir() {
+				e.linkDir = true
+			}
+		}
+		out = append(out, e)
+	}
+	return out, nil
+}
+
+func (e fent) row(selected bool, cursor string, perms, sizes bool) string {
+	var sb strings.Builder
+	if selected {
+		sb.WriteString(cursor)
+	} else {
+		sb.WriteString(" ")
+	}
+	if perms {
+		sb.WriteString(" " + e.mode)
+	}
+	if sizes {
+		fmt.Fprintf(&sb, "%7s", e.size)
+	}
+	sb.WriteString(" " + e.name)
+	if e.link {
+		sb.WriteString(" → " + e.target)
+	}
+	return sb.String()
+}
+
+var fileNames = []string{"a.go", "b.txt", "c.md", "d.go", "e", "ff.txt", ".h.txt", ".i.go"}
+var dirNames = []string{"d1", "d2", ".d3"}
+
+// buildTree fills root with a random tree: files, directories (one level of
+// nesting), and sometimes symlinks to a file, a directory or nowhere.
+func buildTree(tc hegel.TestCase, root string, depth int) {
+	for _, n := range fileNames {
+		if zootest.Chance(tc, 45) {
+			os.WriteFile(filepath.Join(root, n), []byte(strings.Repeat("x", zootest.N(tc, 0, 3000))), 0o644)
+		}
+	}
+	if depth < 2 {
+		for _, n := range dirNames {
+			if zootest.Chance(tc, 50) {
+				os.Mkdir(filepath.Join(root, n), 0o755)
+				buildTree(tc, filepath.Join(root, n), depth+1)
+			}
+		}
+	}
+	if zootest.Chance(tc, 25) {
+		os.Symlink(filepath.Join(root, "a.go"), filepath.Join(root, "ln-f"))
+	}
+	if zootest.Chance(tc, 25) {
+		os.Symlink(filepath.Join(root, "d1"), filepath.Join(root, "ln-d"))
+	}
+	if zootest.Chance(tc, 15) {
+		os.Symlink(filepath.Join(root, "nowhere"), filepath.Join(root, "ln-x"))
+	}
+}
+
+func keyMsg(s string) tea.KeyPressMsg {
+	switch s {
+	case "enter":
+		return tea.KeyPressMsg{Code: tea.KeyEnter}
+	case "pgdown":
+		return tea.KeyPressMsg{Code: tea.KeyPgDown}
+	case "pgup":
+		return tea.KeyPressMsg{Code: tea.KeyPgUp}
+	case "down":
+		return tea.KeyPressMsg{Code: tea.KeyDown}
+	case "up":
+		return tea.KeyPressMsg{Code: tea.KeyUp}
+	case "left":
+		return tea.KeyPressMsg{Code: tea.KeyLeft}
+	case "right":
+		return tea.KeyPressMsg{Code: tea.KeyRight}
+	case "backspace":
+		return tea.KeyPressMsg{Code: tea.KeyBackspace}
+	case "esc":
+		return tea.KeyPressMsg{Code: tea.KeyEscape}
+	case "ctrl+n":
+		return tea.KeyPressMsg{Code: 'n', Mod: tea.ModCtrl}
+	case "ctrl+p":
+		return tea.KeyPressMsg{Code: 'p', Mod: tea.ModCtrl}
+	}
+	r := []rune(s)[0]
+	return tea.KeyPressMsg{Code: r, Text: s}
+}
+
+// fpModel mirrors the picker: the listing, the window as the library
+// computes it (its arithmetic is short and mirrored exactly; the shapes
+// that break the window's invariants are counted below), the selection and
+// the view stack.
+type fpModel struct {
+	tmp, cwd string
+	files    []fent
+	sel      int
+	mn, mx   int
+	h        int
+	stack    []saved
+	path     string
+	hidden   bool
+	// after a back: the restored view came from a listing of another
+	// length (ShowHidden toggled) or from another height, and the shapes it
+	// already had when it was saved
+	changed, resized bool
+	restored         saved
+	// a page key was pressed while the height was negative: the window has
+	// drifted (bubbles/74) until the next reset
+	negPaged bool
+	// the last open/enter: was the entry eligible for selection, and did it
+	// enter a directory (the mirror has moved on when the report is checked)
+	eligible, entered bool
+}
+
+// saved is a view pushed on Open: the selection and window, the listing's
+// length and the height at the time, and the bug shapes it carried.
+type saved struct {
+	sel, mn, mx, n, h   int
+	hidden, tall, short string
+}
+
+func (s *fpModel) bottom(top int) int {
+	if s.h < 1 {
+		return top
+	}
+	return top + s.h - 1
+}
+
+func (s *fpModel) read() {
+	if fs, err := readEntries(s.cwd, s.hidden); err == nil {
+		s.files = fs
+		s.mx = max(s.mx, s.bottom(s.mn))
+	}
+}
+
+func (s *fpModel) setHeight(h int) {
+	s.h = h
+	if s.mx > s.h-1 {
+		s.mx = s.bottom(s.mn)
+	}
+}
+
+// TestHegelFilepickerFollowsTheModel: the listing is the directory's entries,
+// directories first, hidden names per ShowHidden; every binding, the window
+// messages and SetHeight move the selection and the window as the library
+// defines them and the window keeps the selection visible with Height rows;
+// View shows exactly the window's rows with the cursor on the selection;
+// HighlightedPath, CurrentDirectory, Path and the DidSelect reports follow.
+func TestHegelFilepickerFollowsTheModel(t *testing.T) {
+	zootest.Guard(t)
+	zootest.Property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		tmp, err := os.MkdirTemp("", "zoo-fp")
+		if err != nil {
+			ht.Fatalf("MkdirTemp: %v", err)
+		}
+		defer os.RemoveAll(tmp)
+		root := filepath.Join(tmp, "root")
+		os.Mkdir(root, 0o755)
+		buildTree(tc, root, 0)
+
+		m := New()
+		s := &fpModel{tmp: tmp, cwd: root}
+		m.CurrentDirectory = root
+		if zootest.Chance(tc, 30) {
+			m.ShowHidden, s.hidden = true, true
+		}
+		m.AutoHeight = zootest.Chance(tc, 70)
+		if zootest.Chance(tc, 30) {
+			m.ShowPermissions = false
+		}
+		if zootest.Chance(tc, 30) {
+			m.ShowSize = false
+		}
+		m.FileAllowed = zootest.Chance(tc, 80)
+		m.DirAllowed = zootest.Chance(tc, 40)
+		if zootest.Chance(tc, 40) {
+			m.AllowedTypes = zootest.Pick(tc, [][]string{{".go"}, {".txt", ".md"}, {".go", ".txt"}, {"e"}})
+		}
+		if zootest.Chance(tc, 70) {
+			h := zootest.N(tc, 1, 6)
+			m.SetHeight(h)
+			s.setHeight(h)
+		}
+		m, _ = m.Update(m.Init()())
+		s.read()
+
+		var log []string
+		var trail string
+		fail := func(format string, args ...any) {
+			zootest.Fail(ht, "%s\n%s\n"+format, append([]any{strings.Join(log, " "), trail}, args...)...)
+		}
+		var hidden, tall, short string
+		steps := zootest.N(tc, 1, 25)
+		for step := 0; step < steps; step++ {
+			op := zootest.Pick(tc, []string{"g", "G", "down", "down", "up", "up", "pgdown", "pgup", "back", "open", "enter", "enter", "size", "setheight", "togglehidden", "allowed", "flags"})
+			if op == "back" && s.cwd == tmp {
+				op = "up"
+			}
+			var msg tea.Msg
+			var cmd tea.Cmd
+			lenF := len(s.files)
+			var names []string
+			for _, f := range s.files {
+				names = append(names, f.name)
+			}
+			prevTall, prevShort := tall, short
+			before := fmt.Sprintf("[before %s: %v sel %d win [%d,%d] h %d flags %q/%q/%q stack %d]", op, names, s.sel, s.mn, s.mx, s.h, hidden, tall, short, len(s.stack))
+			switch op {
+			case "g":
+				msg = keyMsg("g")
+				s.sel, s.mn, s.mx = 0, 0, s.bottom(0)
+				s.negPaged = false
+			case "G":
+				msg = keyMsg("G")
+				s.sel, s.mn, s.mx = lenF-1, max(lenF-s.h, 0), lenF-1
+			case "down":
+				msg = keyMsg(zootest.Pick(tc, []string{"j", "down", "ctrl+n"}))
+				s.sel++
+				if s.sel >= lenF {
+					s.sel = lenF - 1
+				}
+				if s.sel > s.mx {
+					s.mn++
+					s.mx++
+				}
+			case "up":
+				msg = keyMsg(zootest.Pick(tc, []string{"k", "up", "ctrl+p"}))
+				s.sel--
+				if s.sel < 0 {
+					s.sel = 0
+				}
+				if s.sel < s.mn {
+					s.mn--
+					s.mx--
+				}
+			case "pgdown":
+				msg = keyMsg(zootest.Pick(tc, []string{"J", "pgdown"}))
+				if s.h < 0 {
+					s.negPaged = true
+				}
+				s.sel += s.h
+				if s.sel >= lenF {
+					s.sel = lenF - 1
+				}
+				s.mn += s.h
+				s.mx += s.h
+				if s.mx >= lenF {
+					s.mx = lenF - 1
+					s.mn = max(s.mx-s.h, 0)
+				}
+			case "pgup":
+				msg = keyMsg(zootest.Pick(tc, []string{"K", "pgup"}))
+				if s.h < 0 {
+					s.negPaged = true
+				}
+				s.sel -= s.h
+				if s.sel < 0 {
+					s.sel = 0
+				}
+				s.mn -= s.h
+				s.mx -= s.h
+				if s.mn < 0 {
+					s.mn = 0
+					s.mx = s.mn + s.h
+				}
+			case "back":
+				msg = keyMsg(zootest.Pick(tc, []string{"h", "backspace", "left", "esc"}))
+				s.cwd = filepath.Dir(s.cwd)
+				s.changed, s.resized = false, false
+				s.negPaged = false
+				if n := len(s.stack); n > 0 {
+					v := s.stack[n-1]
+					s.stack = s.stack[:n-1]
+					s.sel, s.mn, s.mx = v.sel, v.mn, v.mx
+					s.read()
+					s.changed, s.resized, s.restored = len(s.files) != v.n, s.h != v.h, v
+				} else {
+					s.sel, s.mn, s.mx = 0, 0, s.bottom(0)
+					s.read()
+				}
+			case "open", "enter":
+				if op == "open" {
+					msg = keyMsg(zootest.Pick(tc, []string{"l", "right"}))
+				} else {
+					msg = keyMsg("enter")
+				}
+				s.eligible, s.entered = false, false
+				if lenF > 0 {
+					if s.sel < 0 || s.sel >= lenF {
+						// bubbles/68: the selection was never clamped to the
+						// listing; Open indexes past it.
+						zootest.Count("bubbles/68")
+						return
+					}
+					f := s.files[s.sel]
+					if f.link && f.target == "" {
+						break // a broken symlink: nothing happens
+					}
+					isDir := f.dir || (f.link && f.linkDir)
+					s.eligible = (!isDir && m.FileAllowed) || (isDir && m.DirAllowed)
+					if s.eligible && op == "enter" {
+						s.path = filepath.Join(s.cwd, f.name)
+					}
+					if isDir {
+						s.entered = true
+						s.cwd = filepath.Join(s.cwd, f.name)
+						s.stack = append(s.stack, saved{s.sel, s.mn, s.mx, lenF, s.h, hidden, tall, short})
+						s.negPaged = false
+						s.sel, s.mn, s.mx = 0, 0, s.bottom(0)
+						s.read()
+					}
+				}
+			case "size":
+				hh := zootest.N(tc, 1, 12)
+				msg = tea.WindowSizeMsg{Width: 80, Height: hh}
+				if m.AutoHeight {
+					s.setHeight(hh - 5)
+				}
+				s.mx = s.bottom(s.mn)
+				op = fmt.Sprintf("size(%d)", hh)
+			case "setheight":
+				hh := zootest.N(tc, 0, 8)
+				m.SetHeight(hh)
+				s.setHeight(hh)
+				op = fmt.Sprintf("setheight(%d)", hh)
+			case "togglehidden":
+				m.ShowHidden = !m.ShowHidden
+				s.hidden = m.ShowHidden
+			case "allowed":
+				m.AllowedTypes = zootest.Pick(tc, [][]string{nil, {".go"}, {".txt", ".md"}, {"e"}})
+				op = fmt.Sprintf("allowed(%v)", m.AllowedTypes)
+			case "flags":
+				m.FileAllowed = zootest.Chance(tc, 80)
+				m.DirAllowed = zootest.Chance(tc, 40)
+				op = fmt.Sprintf("flags(%v,%v)", m.FileAllowed, m.DirAllowed)
+			}
+			log = append(log, op)
+			if len(log) > 0 {
+				log[len(log)-1] = op
+			}
+			trail = before
+			if msg != nil {
+				m, cmd = m.Update(msg)
+				if cmd != nil {
+					m, _ = m.Update(cmd())
+				}
+			}
+			// the selection reports on an enter
+			if op == "enter" {
+				got, gotPath := m.DidSelectFile(msg)
+				gotD, gotPathD := m.DidSelectDisabledFile(msg)
+				want := s.eligible && m.canSelect(s.path)
+				wantD := s.eligible && !m.canSelect(s.path)
+				if got != want || gotD != wantD || (got && gotPath != s.path) || (gotD && gotPathD != s.path) {
+					if s.entered {
+						// bubbles/72: after entering a directory with enter the
+						// report looks at the new directory's first entry.
+						zootest.Count("bubbles/72")
+						return
+					}
+					fail("DidSelectFile %v %q, DidSelectDisabledFile %v %q; want %v / %v with path %q (Path %q)", got, gotPath, gotD, gotPathD, want, wantD, s.path, m.Path)
+					return
+				}
+			}
+			if m.CurrentDirectory != s.cwd || m.Path != s.path {
+				fail("CurrentDirectory %q, Path %q; want %q, %q", m.CurrentDirectory, m.Path, s.cwd, s.path)
+				return
+			}
+			if len(m.files) != len(s.files) || m.selected != s.sel || m.minIdx != s.mn || m.maxIdx != s.mx || m.height != s.h {
+				fail("files %d sel %d win [%d,%d] h %d; want files %d sel %d win [%d,%d] h %d", len(m.files), m.selected, m.minIdx, m.maxIdx, m.height, len(s.files), s.sel, s.mn, s.mx, s.h)
+				return
+			}
+			lenF = len(s.files)
+			wantHP := ""
+			if lenF > 0 && s.sel >= 0 && s.sel < lenF {
+				wantHP = filepath.Join(s.cwd, s.files[s.sel].name)
+			}
+			if hp := m.HighlightedPath(); hp != wantHP {
+				fail("HighlightedPath %q, want %q", hp, wantHP)
+				return
+			}
+			// window invariants on the library's state
+			H := max(s.h, 1)
+			visible := 0
+			if lenF > 0 {
+				visible = max(0, min(s.mx, lenF-1)-s.mn+1)
+			}
+			cause := func(flag *string, cur string) bool {
+				if *flag != "" {
+					return true
+				}
+				*flag = cur
+				return cur != ""
+			}
+			resize := strings.HasPrefix(op, "size") || strings.HasPrefix(op, "setheight")
+			page := op == "pgdown" || op == "pgup"
+			// the shapes a back can leave: bubbles/68 (the listing changed
+			// under the saved view), bubbles/73 (the height did)
+			backCause := func(carried string) string {
+				switch {
+				case op != "back":
+					return ""
+				case s.changed:
+					return "bubbles/68"
+				case s.resized:
+					return "bubbles/73"
+				}
+				return carried // the saved view already had the shape
+			}
+			// a selection past the end (a back onto a changed listing,
+			// bubbles/68) counts as outside the window too
+			if lenF > 0 && (s.sel < 0 || s.sel >= lenF || s.sel < s.mn || s.sel > s.mx) {
+				cur := ""
+				switch {
+				case resize:
+					cur = "bubbles/65" // a smaller height hides the selection
+				case op == "G" && s.h < 1:
+					cur = "bubbles/66" // G without a height empties the window
+				case op == "back":
+					cur = backCause(s.restored.hidden)
+				case s.negPaged:
+					cur = "bubbles/74" // a negative height inverts the page keys
+				case page && prevTall != "":
+					cur = prevTall // a page key from an oversized window strands the selection
+				}
+				if !cause(&hidden, cur) {
+					fail("selection %d outside the window [%d,%d] (height %d)", s.sel, s.mn, s.mx, s.h)
+					return
+				}
+				zootest.Count(hidden)
+			} else {
+				hidden = ""
+			}
+			if visible > H {
+				cur := ""
+				switch {
+				case s.negPaged:
+					cur = "bubbles/74"
+				case page:
+					cur = "bubbles/64" // the page keys leave a window of H+1 rows
+				case op == "back":
+					cur = backCause(s.restored.tall)
+				}
+				if !cause(&tall, cur) {
+					fail("window [%d,%d] shows %d rows for height %d", s.mn, s.mx, visible, s.h)
+					return
+				}
+				zootest.Count(tall)
+			} else {
+				tall = ""
+			}
+			if visible < min(H, lenF) {
+				cur := ""
+				switch {
+				case resize:
+					cur = "bubbles/67" // a larger height does not fill the window
+				case op == "G" && s.h < 1:
+					cur = "bubbles/66"
+				case op == "back":
+					cur = backCause(s.restored.short)
+				case s.negPaged:
+					cur = "bubbles/74"
+				case page && prevTall != "":
+					cur = prevTall
+				case page && prevShort != "":
+					cur = prevShort
+				}
+				if !cause(&short, cur) {
+					fail("window [%d,%d] shows %d rows of %d for height %d", s.mn, s.mx, visible, lenF, s.h)
+					return
+				}
+				zootest.Count(short)
+			} else {
+				short = ""
+			}
+			// the view
+			view := ansi.Strip(m.View())
+			lines := strings.Split(view, "\n")
+			if lenF == 0 {
+				if !strings.HasPrefix(lines[0], "  Bummer. No Files Found.") || len(lines) != max(s.h, 1) {
+					fail("empty view %q for height %d", view, s.h)
+					return
+				}
+				continue
+			}
+			var rows []string
+			for i := s.mn; i <= s.mx && i < lenF; i++ {
+				if i < 0 {
+					continue
+				}
+				rows = append(rows, s.files[i].row(i == s.sel, m.Cursor, m.ShowPermissions, m.ShowSize))
+			}
+			if len(lines) != max(len(rows), s.h)+1 {
+				fail("view has %d lines for %d rows and height %d:\n%s", len(lines), len(rows), s.h, view)
+				return
+			}
+			for i, l := range lines {
+				want := ""
+				if i < len(rows) {
+					want = rows[i]
+				}
+				if strings.TrimRight(l, " ") != strings.TrimRight(want, " ") {
+					fail("view line %d %q, want %q\n%s", i, l, want, view)
+					return
+				}
+			}
+		}
+	})
+}
+
+// pinDir builds a directory of n files f00.txt… and the directories given,
+// returning its path.
+func pinDir(t *testing.T, n int, dirs ...string) string {
+	t.Helper()
+	root := t.TempDir()
+	for i := 0; i < n; i++ {
+		if err := os.WriteFile(filepath.Join(root, fmt.Sprintf("f%02d.txt", i)), []byte("x"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, d := range dirs {
+		if err := os.Mkdir(filepath.Join(root, d), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return root
+}
+
+// pinPicker returns a picker over dir with the height set (0: never set),
+// its listing read.
+func pinPicker(dir string, h int) Model {
+	m := New()
+	m.CurrentDirectory = dir
+	if h > 0 {
+		m.SetHeight(h)
+	}
+	m, _ = m.Update(m.Init()())
+	return m
+}
+
+func pinStep(m Model, msg tea.Msg) Model {
+	m, cmd := m.Update(msg)
+	if cmd != nil {
+		m, _ = m.Update(cmd())
+	}
+	return m
+}
+
+func pinRows(m Model) int {
+	n := 0
+	for _, l := range strings.Split(ansi.Strip(m.View()), "\n") {
+		if strings.TrimSpace(l) != "" {
+			n++
+		}
+	}
+	return n
+}
+
+// bubbles/64: when PageDown or PageUp clamps at an end of the listing the
+// window is set to Height+1 entries (maxIdx − Height … maxIdx), so the view
+// shows one row more than the height.
+func TestHegelPinFilepickerPageKeysShowOneRowTooMany(t *testing.T) {
+	m := pinPicker(pinDir(t, 10), 3)
+	for range 3 {
+		m = pinStep(m, keyMsg("pgdown"))
+	}
+	if rows := pinRows(m); rows > 3 {
+		t.Fatalf("after three PageDowns in ten entries with height 3: window [%d,%d], %d rows:\n%s", m.minIdx, m.maxIdx, rows, ansi.Strip(m.View()))
+	}
+}
+
+// bubbles/65: a smaller height (WindowSizeMsg or SetHeight) cuts the window
+// from its top, so a selection near the bottom falls out of view and no
+// cursor is drawn.
+func TestHegelPinFilepickerShrinkHidesTheSelection(t *testing.T) {
+	m := pinPicker(pinDir(t, 10), 4)
+	m = pinStep(m, keyMsg("G"))
+	m = pinStep(m, tea.WindowSizeMsg{Width: 80, Height: 7}) // height 2
+	if m.selected < m.minIdx || m.selected > m.maxIdx || !strings.Contains(ansi.Strip(m.View()), "> ") {
+		t.Fatalf("after G and a resize to height 2: selected %d, window [%d,%d]:\n%s", m.selected, m.minIdx, m.maxIdx, ansi.Strip(m.View()))
+	}
+}
+
+// bubbles/66: without a height (no WindowSizeMsg yet, SetHeight never
+// called) G sets minIdx to len(files) and maxIdx to len(files)−1, so the
+// view is empty and stays so through Up moves.
+func TestHegelPinFilepickerGoToLastWithoutHeightEmptiesTheView(t *testing.T) {
+	m := pinPicker(pinDir(t, 5), 0)
+	m = pinStep(m, keyMsg("G"))
+	m = pinStep(m, keyMsg("k"))
+	if v := ansi.Strip(m.View()); strings.TrimSpace(v) == "" {
+		t.Fatalf("G then k without a height: selected %d, window [%d,%d], view %q", m.selected, m.minIdx, m.maxIdx, v)
+	}
+}
+
+// bubbles/67: a larger height does not fill the window: SetHeight keeps
+// the old bottom when minIdx is 0 (maxIdx is compared with height−1 as if
+// it were a count), and a WindowSizeMsg keeps the old top, so rows stay
+// blank while entries are hidden.
+func TestHegelPinFilepickerSetHeightDoesNotFillTheWindow(t *testing.T) {
+	m := pinPicker(pinDir(t, 10), 2)
+	m.AutoHeight = false
+	m.SetHeight(6)
+	if rows := pinRows(m); rows < 6 {
+		t.Fatalf("SetHeight(6) over ten entries: window [%d,%d], %d rows:\n%s", m.minIdx, m.maxIdx, rows, ansi.Strip(m.View()))
+	}
+}
+
+// bubbles/68: readDirMsg never clamps the selection to the new listing, so
+// after ShowHidden is turned off inside a directory, Back restores a
+// selection past the end of the parent: HighlightedPath is empty, no cursor
+// is drawn and Open panics (a Down in an empty directory leaves −1 the same way).
+func TestHegelPinFilepickerStaleSelectionPanicsOnOpen(t *testing.T) {
+	root := pinDir(t, 0, ".a", ".b", "c")
+	m := New()
+	m.CurrentDirectory = root
+	m.ShowHidden = true
+	m.SetHeight(5)
+	m, _ = m.Update(m.Init()())
+	m = pinStep(m, keyMsg("G")) // c
+	m = pinStep(m, keyMsg("l"))
+	m.ShowHidden = false
+	m = pinStep(m, keyMsg("h"))
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("Back into the parent with hidden entries turned off: selected %d of %d, HighlightedPath %q; Open panics: %v", m.selected, len(m.files), m.HighlightedPath(), r)
+		}
+	}()
+	m = pinStep(m, keyMsg("enter"))
+	if m.HighlightedPath() == "" {
+		t.Fatalf("Back into the parent with hidden entries turned off: selected %d of %d, HighlightedPath empty", m.selected, len(m.files))
+	}
+}
+
+// bubbles/69: Open changes CurrentDirectory before the directory is read,
+// and a read error is ignored, so an unreadable directory is "entered" with
+// the parent's listing still shown: HighlightedPath joins the new directory
+// with the old entries.
+func TestHegelPinFilepickerEntersAnUnreadableDirectory(t *testing.T) {
+	if os.Geteuid() == 0 {
+		t.Skip("root can read anything")
+	}
+	root := pinDir(t, 2, "locked")
+	if err := os.Chmod(filepath.Join(root, "locked"), 0o000); err != nil {
+		t.Fatal(err)
+	}
+	defer os.Chmod(filepath.Join(root, "locked"), 0o755)
+	m := pinPicker(root, 5)
+	m = pinStep(m, keyMsg("l")) // locked sorts first
+	if m.CurrentDirectory != root {
+		t.Fatalf("after Open on an unreadable directory: CurrentDirectory %q, %d entries listed, HighlightedPath %q", m.CurrentDirectory, len(m.files), m.HighlightedPath())
+	}
+}
+
+// bubbles/70: Back computes filepath.Dir(CurrentDirectory), and Dir(".")
+// is ".", so with the default directory the Back key goes nowhere.
+func TestHegelPinFilepickerBackFromDotGoesNowhere(t *testing.T) {
+	m := pinPicker(".", 5)
+	m = pinStep(m, keyMsg("h"))
+	if m.CurrentDirectory == "." {
+		t.Fatalf("Back from %q: CurrentDirectory %q", ".", m.CurrentDirectory)
+	}
+}
+
+// bubbles/71: the view of a non-empty directory ends in a newline after
+// its Height lines, so it is one line taller than the empty directory's
+// view and than Height.
+func TestHegelPinFilepickerViewHasATrailingNewline(t *testing.T) {
+	m := pinPicker(pinDir(t, 2), 3)
+	e := pinPicker(pinDir(t, 0), 3)
+	if h, eh := lipgloss.Height(m.View()), lipgloss.Height(e.View()); h != 3 || eh != 3 {
+		t.Fatalf("height 3: the view of two files is %d lines (%q), of an empty directory %d", h, m.View(), eh)
+	}
+}
+
+// bubbles/72: after enter selects a directory (DirAllowed) the picker has
+// already entered it, so DidSelectFile looks at the new listing's first
+// entry: a directory holding only files is never reported selected when
+// FileAllowed is off, nor is an empty one.
+func TestHegelPinFilepickerDidSelectDirectoryLooksAtTheChild(t *testing.T) {
+	root := pinDir(t, 0, "d")
+	os.WriteFile(filepath.Join(root, "d", "a.go"), []byte("x"), 0o644)
+	m := pinPicker(root, 5)
+	m.DirAllowed, m.FileAllowed = true, false
+	enter := keyMsg("enter")
+	m = pinStep(m, enter)
+	ok, path := m.DidSelectFile(enter)
+	if !ok || path != filepath.Join(root, "d") {
+		t.Fatalf("enter on directory d with DirAllowed: Path %q, DidSelectFile %v %q", m.Path, ok, path)
+	}
+}
+
+// bubbles/73: Back restores the parent's saved selection and window
+// verbatim, so after a resize inside a subdirectory the parent shows the
+// old window: more rows than the height, or fewer.
+func TestHegelPinFilepickerBackRestoresAnUnfittedWindow(t *testing.T) {
+	m := pinPicker(pinDir(t, 10, "sub"), 5)
+	m = pinStep(m, keyMsg("l"))                             // sub sorts first
+	m = pinStep(m, tea.WindowSizeMsg{Width: 80, Height: 7}) // height 2
+	m = pinStep(m, keyMsg("h"))
+	if rows := pinRows(m); rows > 2 {
+		t.Fatalf("Back after a resize to height 2: window [%d,%d], %d rows:\n%s", m.minIdx, m.maxIdx, rows, ansi.Strip(m.View()))
+	}
+}
+
+// bubbles/74: SetHeight accepts a negative height (AutoHeight makes one
+// from a terminal under six rows) and the page keys add it, so PageUp moves
+// the selection and the window down and PageDown up, off the listing.
+func TestHegelPinFilepickerNegativeHeightInvertsThePageKeys(t *testing.T) {
+	m := pinPicker(pinDir(t, 10), 0)
+	m = pinStep(m, tea.WindowSizeMsg{Width: 80, Height: 2}) // height −3
+	m = pinStep(m, keyMsg("pgup"))
+	if m.selected != 0 || m.minIdx != 0 {
+		t.Fatalf("PageUp from the top at height %d: selected %d, window [%d,%d]", m.height, m.selected, m.minIdx, m.maxIdx)
+	}
+}
