diff --git a/viewport/hegel_shapes_test.go b/viewport/hegel_shapes_test.go
new file mode 100644
index 0000000..ff6eada
--- /dev/null
+++ b/viewport/hegel_shapes_test.go
@@ -0,0 +1,365 @@
+package viewport
+
+// The shape regions of the recorded viewport bugs (bugs.toml bubbles/27 to 39)
+// and the narrow properties over them: each region is a generator over the
+// bug's shape with random contents, judged exactly like the wide property of
+// its kind (judgeScroll, judgeHighlights). Every narrow property fails every
+// run by default; under HEGEL_NO_KNOWN=1 its generator is the region next to
+// the shape instead (zootest.Shaped) and the property passes. The hit rates
+// below were measured with the collector over the generators themselves
+// (BUBBLES_COLLECT=1 HEGEL_TEST_CASES=1000: the mismatches per case).
+// Every shape here is also drawn by a wide property at its natural rate; the
+// Style width (bubbles/37), styled content (35) and the unset selected style
+// (36) are drawn alternatives of the wide properties since this rewrite.
+
+import (
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"hegel.dev/go/hegel"
+)
+
+// narrowScroll and narrowHighlights run a narrow property: every drawn case
+// through the wide property's judge.
+func narrowScroll(t *testing.T, cases hegel.Generator[scrollCase]) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeScroll(j, c)
+	})
+}
+
+func narrowHighlights(t *testing.T, cases hegel.Generator[hiCase]) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeHighlights(j, c)
+	})
+}
+
+// plainContent is a content of the lines alone.
+func plainContent(lines ...string) vpContent { return vpContent{lines: lines, styled: -1} }
+
+// letterLines: lo to hi lines of up to n letters.
+func letterLines(lo, hi, n int) hegel.Generator[[]string] {
+	return zootest.Counted(textsOf(letters, 0, n), lo, hi)
+}
+
+// keyOpsUpTo: none to n key or offset operations.
+func keyOpsUpTo(n int) hegel.Generator[[]vpOp] { return zootest.Counted(keyOps, 0, n) }
+
+func ops(kinds ...string) []vpOp {
+	out := make([]vpOp, len(kinds))
+	for i, k := range kinds {
+		out[i] = vpOp{kind: k}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- bubbles/27
+
+// crlfContentKeepsTheCarriageReturn: two to eight lines joined by CRLF (past
+// the shape, by LF), any frameless viewport, up to four key operations: the
+// library keeps a CR on every line but the last (1000 of 1000).
+var crlfContentKeepsTheCarriageReturn = scrollCasesOf(
+	startsOf(hegel.Just(false), gutters, softs, fills, hegel.Just(0),
+		contentsOf(zootest.Counted(vpLines, 2, 8), zootest.Shaped(hegel.Just(true), hegel.Just(false)), hegel.Just(0), hegel.Just(-1))),
+	keyOpsUpTo(4),
+)
+
+func TestHegelViewportCRLFContentKeepsTheCarriageReturn(t *testing.T) {
+	narrowScroll(t, crlfContentKeepsTheCarriageReturn)
+}
+
+// --------------------------------------------------------------------------- bubbles/28
+
+// tabInTheContent: a first line of k letters with a tab among them (past the
+// shape, the letters alone), k at least the content width less three so that
+// the tab's four cells push the line past the width, the tab starting inside
+// the content width and a letter after it (a tab cut off or trailing shows
+// nothing), in view at the start (1000 of 1000).
+var tabInTheContent = hegel.Composite(func(tc hegel.TestCase) scrollCase {
+	gutter := hegel.Draw(tc, gutters)
+	width := hegel.Draw(tc, zootest.Ints(1+2*boolInt(gutter), 12))
+	mw := width - 2*boolInt(gutter)
+	k := hegel.Draw(tc, zootest.Ints(max(1, mw-3), 12))
+	text := hegel.Draw(tc, textsOf(letters, k, k))
+	pos := hegel.Draw(tc, zootest.Ints(0, min(k-1, mw-1)))
+	line := zootest.Shaped(text[:pos]+"\t"+text[pos:], text)
+	rest := hegel.Draw(tc, letterLines(0, 3, 12))
+	start := vpStart{width: width, height: hegel.Draw(tc, zootest.Ints(1, 6)), gutter: gutter, soft: hegel.Draw(tc, softs), fill: hegel.Draw(tc, fills)}
+	start.content = plainContent(append([]string{line}, rest...)...)
+	return scrollCase{start: start, ops: hegel.Draw(tc, keyOpsUpTo(3))}
+})
+
+func boolInt(b bool) int {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+func TestHegelViewportTabInTheContent(t *testing.T) {
+	narrowScroll(t, tabInTheContent)
+}
+
+// --------------------------------------------------------------------------- bubbles/29
+
+// horizontalScrollWithAGutterOrFrame: a gutter, a frame or both (past the
+// shape, neither), a first line wider than the content area, no more lines
+// than the content area holds, and three or four moves right: the model's end
+// is longest - content width, the library's longest - width (1000 of 1000).
+var horizontalScrollWithAGutterOrFrame = hegel.Composite(func(tc hegel.TestCase) scrollCase {
+	deco := hegel.Draw(tc, zootest.Shaped(zootest.Sampled("gutter", "frame", "both"), hegel.Just("none")))
+	gutter, frame := deco == "gutter" || deco == "both", deco == "frame" || deco == "both"
+	fw, gw := 2*boolInt(frame), 2*boolInt(gutter)
+	width := hegel.Draw(tc, zootest.Ints(fw+gw+1, 12))
+	height := hegel.Draw(tc, zootest.Ints(fw+1, 6))
+	mw, mh := width-fw-gw, height-fw
+	first := hegel.Draw(tc, textsOf(letters, mw+1, 16))
+	rest := hegel.Draw(tc, letterLines(0, mh-1, 16))
+	start := vpStart{width: width, height: height, frame: frame, gutter: gutter, fill: hegel.Draw(tc, fills)}
+	start.content = plainContent(append([]string{first}, rest...)...)
+	rights := hegel.Draw(tc, zootest.Counted(hegel.Map(zootest.Sampled("right", "l", "wheelright"), func(k string) vpOp { return vpOp{kind: k} }), 3, 4))
+	return scrollCase{start: start, ops: rights}
+})
+
+func TestHegelViewportHorizontalScrollWithAGutterOrFrame(t *testing.T) {
+	narrowScroll(t, horizontalScrollWithAGutterOrFrame)
+}
+
+// --------------------------------------------------------------------------- bubbles/30
+
+// pageDownInsideAFrame: a frame (past the shape, none), more than twice the
+// content height in lines and more than the outer height (so that the scroll
+// percentage at the top is right, bubbles/31's shape being apart), and a page
+// down: the library moves by the outer height (1000 of 1000).
+var pageDownInsideAFrame = hegel.Composite(func(tc hegel.TestCase) scrollCase {
+	frame := zootest.Shaped(true, false)
+	gutter := hegel.Draw(tc, gutters)
+	fw, gw := 2*boolInt(frame), 2*boolInt(gutter)
+	width := hegel.Draw(tc, zootest.Ints(fw+gw+1, 12))
+	height := hegel.Draw(tc, zootest.Ints(fw+1, 6))
+	mh := height - fw
+	lo := max(2*mh+1, height+1)
+	lines := hegel.Draw(tc, letterLines(lo, max(12, lo), 12))
+	start := vpStart{width: width, height: height, frame: frame, gutter: gutter, soft: hegel.Draw(tc, softs), fill: hegel.Draw(tc, fills)}
+	start.content = plainContent(lines...)
+	return scrollCase{start: start, ops: ops(hegel.Draw(tc, zootest.Sampled("f", "pgdown", "space")))}
+})
+
+func TestHegelViewportPageDownInsideAFrame(t *testing.T) {
+	narrowScroll(t, pageDownInsideAFrame)
+}
+
+// --------------------------------------------------------------------------- bubbles/31
+
+// scrollPercentInsideAFrame: a frame (past the shape, none) and one or two
+// lines more than the content area holds but no more than the outer height:
+// at the top the library reports 100 % (1000 of 1000).
+var scrollPercentInsideAFrame = hegel.Composite(func(tc hegel.TestCase) scrollCase {
+	frame := zootest.Shaped(true, false)
+	gutter := hegel.Draw(tc, gutters)
+	fw, gw := 2*boolInt(frame), 2*boolInt(gutter)
+	width := hegel.Draw(tc, zootest.Ints(fw+gw+1, 12))
+	height := hegel.Draw(tc, zootest.Ints(fw+1, 6))
+	mh := height - fw
+	lines := hegel.Draw(tc, letterLines(mh+1, mh+2, width))
+	start := vpStart{width: width, height: height, frame: frame, gutter: gutter, fill: hegel.Draw(tc, fills)}
+	start.content = plainContent(lines...)
+	return scrollCase{start: start}
+})
+
+func TestHegelViewportScrollPercentInsideAFrame(t *testing.T) {
+	narrowScroll(t, scrollPercentInsideAFrame)
+}
+
+// --------------------------------------------------------------------------- bubbles/32
+
+var (
+	wideRunes = zootest.Sampled('\u65e5', '\u672c', '\u8a9e', '\u6f22', '\u5b57')
+
+	// wideRuneOnASoftWrapBoundary: soft wrap in a viewport of height two or
+	// more (at height one the row the cut widens wraps below the view), a
+	// content width of two or more, a line of width-1 letters, a wide rune
+	// (across the boundary; past the shape, after width-2 letters, before it)
+	// and at least width-1 more letters: the library cuts the row by cells and
+	// keeps the wide rune whole, a cell too wide (1000 of 1000 standalone).
+	wideRuneOnASoftWrapBoundary = hegel.Composite(func(tc hegel.TestCase) scrollCase {
+		gutter := hegel.Draw(tc, gutters)
+		width := hegel.Draw(tc, zootest.Ints(2+2*boolInt(gutter), 12))
+		mw := width - 2*boolInt(gutter)
+		head := hegel.Draw(tc, textsOf(letters, zootest.Shaped(mw-1, mw-2), zootest.Shaped(mw-1, mw-2)))
+		tail := hegel.Draw(tc, textsOf(letters, mw-1, max(9, mw-1)))
+		line := head + string(hegel.Draw(tc, wideRunes)) + tail
+		start := vpStart{width: width, height: hegel.Draw(tc, zootest.Ints(2, 6)), gutter: gutter, soft: true, fill: hegel.Draw(tc, fills)}
+		start.content = plainContent(append([]string{line}, hegel.Draw(tc, letterLines(0, 3, mw))...)...)
+		return scrollCase{start: start, ops: hegel.Draw(tc, keyOpsUpTo(2))}
+	})
+	// wideRuneAcrossTheScrolledEdge: no soft wrap, a line of five letters (past
+	// the shape, four), a wide rune (across column 6, the first step right) and
+	// at least width-1 more letters so that the line scrolls, and a step right:
+	// the library keeps the wide rune whole and the row is a cell too wide
+	// (1000 of 1000 standalone; the two together, 2:1, 1000 of 1000).
+	wideRuneAcrossTheScrolledEdge = hegel.Composite(func(tc hegel.TestCase) scrollCase {
+		width := hegel.Draw(tc, zootest.Ints(1, 10))
+		head := hegel.Draw(tc, textsOf(letters, zootest.Shaped(5, 4), zootest.Shaped(5, 4)))
+		tail := hegel.Draw(tc, textsOf(letters, width-1, 9))
+		line := head + string(hegel.Draw(tc, wideRunes)) + tail
+		start := vpStart{width: width, height: hegel.Draw(tc, zootest.Ints(1, 6)), fill: hegel.Draw(tc, fills)}
+		start.content = plainContent(append([]string{line}, hegel.Draw(tc, letterLines(0, 3, width))...)...)
+		return scrollCase{start: start, ops: ops(hegel.Draw(tc, zootest.Sampled("right", "l", "wheelright")))}
+	})
+	wideRuneOnACutBoundary = zootest.Weighted(zootest.W(2, wideRuneOnASoftWrapBoundary), zootest.W(1, wideRuneAcrossTheScrolledEdge))
+)
+
+func TestHegelViewportWideRuneOnACutBoundary(t *testing.T) {
+	narrowScroll(t, wideRuneOnACutBoundary)
+}
+
+// --------------------------------------------------------------------------- bubbles/33
+
+// highlightUnderSoftWrap: soft wrap in a viewport of height h (1 to 3) and
+// width 1 to 4, a first line wrapping into more than h rows (past the shape,
+// fitting the width), then at least h more lines, and one match on the last of
+// them: the library scrolls to the match's line index, a visual row above it
+// (1000 of 1000).
+var highlightUnderSoftWrap = hegel.Composite(func(tc hegel.TestCase) hiCase {
+	h := hegel.Draw(tc, zootest.Ints(1, 3))
+	w := hegel.Draw(tc, zootest.Ints(1, 4))
+	r := hegel.Draw(tc, zootest.Shaped(zootest.Ints(h+1, min(5, 16/w)), hegel.Just(1)))
+	first := hegel.Draw(tc, textsOf(letters, (r-1)*w+1, r*w))
+	middle := hegel.Draw(tc, letterLines(h-1, 3, w))
+	last := hegel.Draw(tc, textsOf(letters, 1, w))
+	lines := append(append([]string{first}, middle...), last)
+	before := len([]rune(strings.Join(lines[:len(lines)-1], ""))) + len(lines) - 1
+	o := hegel.Draw(tc, zootest.Ints(0, len([]rune(last))-1))
+	start := hiStart{width: w, height: h, soft: true, content: plainContent(lines...)}
+	return hiCase{start: start, matches: []hiMatch{{skip: before + o, length: hegel.Draw(tc, zootest.Ints(1, 3))}}}
+})
+
+func TestHegelViewportHighlightUnderSoftWrap(t *testing.T) {
+	narrowHighlights(t, highlightUnderSoftWrap)
+}
+
+// --------------------------------------------------------------------------- bubbles/34
+
+// highlightPreviousFromNone: three to six lines, two to four one-rune matches
+// in the first line, the view scrolled below them (past the shape, at the top)
+// and HighlightPrevious: the library lands on the second-to-last match
+// (1000 of 1000).
+var highlightPreviousFromNone = hegel.Composite(func(tc hegel.TestCase) hiCase {
+	n := hegel.Draw(tc, zootest.Ints(3, 6))
+	k := hegel.Draw(tc, zootest.Ints(2, 4))
+	first := hegel.Draw(tc, textsOf(letters, 2*k, 12))
+	rest := hegel.Draw(tc, letterLines(n-1, n-1, 12))
+	matches := hegel.Draw(tc, zootest.Counted(hegel.Map(zootest.Ints(0, 1), func(skip int) hiMatch { return hiMatch{skip: skip, length: 1} }), k, k))
+	start := hiStart{width: hegel.Draw(tc, zootest.Ints(1, 12)), height: hegel.Draw(tc, zootest.Ints(1, n-1)), content: plainContent(append([]string{first}, rest...)...)}
+	start.y0 = zootest.Shaped(n-1, 0)
+	return hiCase{start: start, matches: matches, ops: []string{"prev"}}
+})
+
+func TestHegelViewportHighlightPreviousFromNone(t *testing.T) {
+	narrowHighlights(t, highlightPreviousFromNone)
+}
+
+// --------------------------------------------------------------------------- bubbles/35
+
+// highlightsOnStyledContent: two to five lines of one to eight letters, one of
+// them but the last rendered in a colour (past the shape, none), a match of
+// one to three runes on a later line, every line in view and the window wide
+// enough for every column: the library places the match by the raw bytes
+// (1000 of 1000).
+var highlightsOnStyledContent = hegel.Composite(func(tc hegel.TestCase) hiCase {
+	lines := hegel.Draw(tc, zootest.Counted(textsOf(letters, 1, 8), 2, 5))
+	n := len(lines)
+	s := hegel.Draw(tc, zootest.Ints(0, n-2))
+	t := hegel.Draw(tc, zootest.Ints(s+1, n-1))
+	before := len([]rune(strings.Join(lines[:t], ""))) + t
+	o := hegel.Draw(tc, zootest.Ints(0, len([]rune(lines[t]))-1))
+	content := vpContent{lines: lines, styled: zootest.Shaped(s, -1)}
+	start := hiStart{width: hegel.Draw(tc, zootest.Ints(10, 12)), height: hegel.Draw(tc, zootest.Ints(n, 6)), content: content}
+	return hiCase{start: start, matches: []hiMatch{{skip: before + o, length: hegel.Draw(tc, zootest.Ints(1, 3))}}, ops: hegel.Draw(tc, zootest.Counted(hiOps, 0, 2))}
+})
+
+func TestHegelViewportHighlightsOnStyledContent(t *testing.T) {
+	narrowHighlights(t, highlightsOnStyledContent)
+}
+
+// --------------------------------------------------------------------------- bubbles/36
+
+// selectedMatchWithTheDefaultStyle: SelectedHighlightStyle left unset (past the
+// shape, Reverse), a first line of one to six letters with a one-rune match
+// in it, selected at the top and in view: the library re-styles it with the
+// unset style, so it is the one match not highlighted (1000 of 1000).
+var selectedMatchWithTheDefaultStyle = hegel.Composite(func(tc hegel.TestCase) hiCase {
+	first := hegel.Draw(tc, textsOf(letters, 1, 6))
+	rest := hegel.Draw(tc, letterLines(0, 4, 8))
+	skip := hegel.Draw(tc, zootest.Ints(0, len([]rune(first))-1))
+	more := hegel.Draw(tc, zootest.Counted(hiMatches, 0, 2))
+	start := hiStart{width: hegel.Draw(tc, zootest.Ints(6, 12)), height: hegel.Draw(tc, zootest.Ints(1, 6)), selUnset: zootest.Shaped(true, false), content: plainContent(append([]string{first}, rest...)...)}
+	return hiCase{start: start, matches: append([]hiMatch{{skip: skip, length: 1}}, more...), ops: hegel.Draw(tc, zootest.Counted(zootest.Sampled("down", "up"), 0, 2))}
+})
+
+func TestHegelViewportSelectedMatchWithTheDefaultStyle(t *testing.T) {
+	narrowHighlights(t, selectedMatchWithTheDefaultStyle)
+}
+
+// --------------------------------------------------------------------------- bubbles/37
+
+// styleWidthBelowTheViewports: a Style width of 1 to width-1 (past the shape,
+// none) and a first line wider than it: the library cuts to the viewport's
+// width and renders at the Style's, wrapping the row (1000 of 1000).
+var styleWidthBelowTheViewports = hegel.Composite(func(tc hegel.TestCase) scrollCase {
+	width := hegel.Draw(tc, zootest.Ints(2, 12))
+	k := hegel.Draw(tc, zootest.Shaped(zootest.Ints(1, 11), hegel.Just(0)))
+	start := vpStart{width: width, height: hegel.Draw(tc, zootest.Ints(1, 6)), soft: hegel.Draw(tc, softs), fill: hegel.Draw(tc, fills), styleK: k}
+	first := hegel.Draw(tc, textsOf(letters, start.styleWidth()+1, 16))
+	start.content = plainContent(append([]string{first}, hegel.Draw(tc, letterLines(0, 3, 16))...)...)
+	return scrollCase{start: start, ops: hegel.Draw(tc, keyOpsUpTo(2))}
+})
+
+func TestHegelViewportStyleWidthBelowTheViewports(t *testing.T) {
+	narrowScroll(t, styleWidthBelowTheViewports)
+}
+
+// --------------------------------------------------------------------------- bubbles/38
+
+// fillRowsUnderSoftWrap: soft wrap, a gutter, FillHeight (past the shape, off),
+// one line wrapping into two to five rows and a height leaving a fill row
+// below them: the library numbers the fill rows (1000 of 1000).
+var fillRowsUnderSoftWrap = hegel.Composite(func(tc hegel.TestCase) scrollCase {
+	width := hegel.Draw(tc, zootest.Ints(3, 12))
+	mw := width - 2
+	line := hegel.Draw(tc, textsOf(letters, mw+1, min(16, 5*mw)))
+	r := (len(line) + mw - 1) / mw
+	start := vpStart{width: width, height: hegel.Draw(tc, zootest.Ints(r+1, 6)), gutter: true, soft: true, fill: zootest.Shaped(true, false)}
+	start.content = plainContent(line)
+	return scrollCase{start: start}
+})
+
+func TestHegelViewportFillRowsUnderSoftWrap(t *testing.T) {
+	narrowScroll(t, fillRowsUnderSoftWrap)
+}
+
+// --------------------------------------------------------------------------- bubbles/39
+
+// setContentKeepsTheXOffset: a first line wider than the viewport, a step right
+// (past the shape, none) and then a content that fits the width: the library
+// keeps the offset past the new content's end (1000 of 1000).
+var setContentKeepsTheXOffset = hegel.Composite(func(tc hegel.TestCase) scrollCase {
+	width := hegel.Draw(tc, zootest.Ints(1, 10))
+	first := hegel.Draw(tc, textsOf(letters, width+1, 16))
+	start := vpStart{width: width, height: hegel.Draw(tc, zootest.Ints(1, 6)), fill: hegel.Draw(tc, fills)}
+	start.content = plainContent(append([]string{first}, hegel.Draw(tc, letterLines(0, 3, 16))...)...)
+	next := plainContent(hegel.Draw(tc, letterLines(0, 6, width))...)
+	steps := zootest.Shaped[[]vpOp](ops(hegel.Draw(tc, zootest.Sampled("right", "l", "wheelright"))), nil)
+	return scrollCase{start: start, ops: append(steps, vpOp{kind: "setcontent", content: next})}
+})
+
+func TestHegelViewportSetContentKeepsTheXOffset(t *testing.T) {
+	narrowScroll(t, setContentKeepsTheXOffset)
+}
diff --git a/viewport/hegel_test.go b/viewport/hegel_test.go
new file mode 100644
index 0000000..211086d
--- /dev/null
+++ b/viewport/hegel_test.go
@@ -0,0 +1,1603 @@
+package viewport
+
+// Hegel property tests for the viewport bubble: a pager over lines with a
+// vertical (and, without soft wrap, horizontal) scroll position, an optional
+// left gutter and frame style, soft wrapping, and highlighted byte ranges.
+//
+// A case is a record of the start (the size, the frame, the gutter, soft wrap,
+// FillHeight, a Style width, the content as SetContent gets it) and a list of
+// operation records (every default key binding, the wheel, the setters,
+// SetContent, SetHeight and EnsureVisible) applied in order. The model turns
+// the content into visual rows of cells (one row per line, or greedy chunks of
+// the content width under soft wrap; a tab is four cells, the renderer's) and
+// predicts the scroll offsets of every operation (a page is the content height,
+// the horizontal end is longest - content width); after each one YOffset,
+// XOffset, TotalLineCount, AtTop/AtBottom, ScrollPercent, GetContent and the
+// view, parsed into cells, must follow: exactly height rows of width cells
+// showing gutter + the window of each row. Highlights are modelled as the cells
+// of the matched runes; the selected match is the first one whose visual row
+// is at or below the top, scrolled to by its visual row.
+//
+// The shapes of the recorded bugs are drawn like any other case (CRLF content,
+// a tab, a frame, a gutter, wide runes, a Style width, styled content, an unset
+// selected style) and a classifier over the model's state names the bug a step
+// has before it is taken (on a clone where the step must be replayed to
+// decide); the comparison is always made and fails naming the shape. Under
+// HEGEL_NO_KNOWN=1 the frame, CRLF, tabs, wide runes, the Style width, styled
+// content and the unset selected style are not drawn, soft-wrapped highlight
+// content fits the width, and the steps that still reach a shape (a stale
+// horizontal offset after SetContent, the horizontal end with a gutter,
+// EnsureVisible under soft wrap, the fill rows under soft wrap,
+// HighlightPrevious from no selection) are skipped by the judge.
+//
+// Set BUBBLES_COLLECT=1 (and HEGEL_TEST_CASES=n) to collect mismatches.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	property = zootest.Property
+	guard    = zootest.Guard
+)
+
+func keyOf(code rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: code} }
+func typed(r rune) tea.KeyPressMsg    { return tea.KeyPressMsg{Code: r, Text: string(r)} }
+
+// ---------------------------------------------------------------- generators
+
+// vpRunes: the runes of a line at the old generator's shares (a letter, a space,
+// a wide rune, a digit or mark, an accent); wide runes are bubbles/32's
+// ingredient and are not drawn under HEGEL_NO_KNOWN=1.
+var vpRunes = zootest.Weighted(
+	zootest.W(55, hegel.Map(zootest.Ints(0, 25), func(i int) rune { return 'a' + rune(i) })),
+	zootest.W(13, hegel.Just(' ')),
+	zootest.W(zootest.Unless(zootest.NoKnown, 10), zootest.Sampled('\u65e5', '\u672c', '\u8a9e', '\u6f22', '\u5b57')),
+	zootest.W(9, zootest.Sampled([]rune("0123456789.,-")...)),
+	zootest.W(13, zootest.Sampled('\u00e9', '\u00fc', '\u00f1')),
+)
+
+// textsOf is a string of lo to hi runes drawn from rs.
+func textsOf(rs hegel.Generator[rune], lo, hi int) hegel.Generator[string] {
+	return hegel.Map(zootest.Counted(rs, lo, hi), func(r []rune) string { return string(r) })
+}
+
+var (
+	letters = hegel.Map(zootest.Ints(0, 25), func(i int) rune { return 'a' + rune(i) })
+	// vpLines: a line of up to sixteen runes (the widest viewport plus four).
+	vpLines = textsOf(vpRunes, 0, 16)
+)
+
+// vpContent is the content of a viewport: the lines, whether they are joined
+// by CRLF (bubbles/27), a tab put in at the rune tab-1 modulo the runes of the
+// lines (0 for none; bubbles/28), and the index of a line rendered in a
+// foreground colour (-1 for none; bubbles/35).
+type vpContent struct {
+	lines  []string
+	crlf   bool
+	tab    int
+	styled int
+}
+
+// plain is the lines as the model holds them: the tab put in, no CR.
+func (c vpContent) plain() []string {
+	lines := append([]string{}, c.lines...)
+	total := 0
+	for _, l := range lines {
+		total += len([]rune(l))
+	}
+	if c.tab > 0 && total > 0 {
+		k := (c.tab - 1) % total
+		for i, l := range lines {
+			rs := []rune(l)
+			if k < len(rs) {
+				rs[k] = '\t'
+				lines[i] = string(rs)
+				break
+			}
+			k -= len(rs)
+		}
+	}
+	return lines
+}
+
+// styledLine is the index of the styled line (modulo the lines), -1 for none.
+func (c vpContent) styledLine() int {
+	if c.styled < 0 || len(c.lines) == 0 {
+		return -1
+	}
+	return c.styled % len(c.lines)
+}
+
+var redStyle = lipgloss.NewStyle().Foreground(lipgloss.Color("1"))
+
+// text is the content as SetContent gets it.
+func (c vpContent) text() string {
+	lines := c.plain()
+	if s := c.styledLine(); s >= 0 {
+		lines[s] = redStyle.Render(lines[s])
+	}
+	sep := "\n"
+	if c.crlf {
+		sep = "\r\n"
+	}
+	return strings.Join(lines, sep)
+}
+
+func (c vpContent) GoString() string {
+	s := fmt.Sprintf("%q", c.plain())
+	if c.crlf {
+		s += " joined by CRLF"
+	}
+	if k := c.styledLine(); k >= 0 {
+		s += fmt.Sprintf(" line %d styled", k)
+	}
+	return s
+}
+
+func contentsOf(lines hegel.Generator[[]string], crlfs hegel.Generator[bool], tabs, styled hegel.Generator[int]) hegel.Generator[vpContent] {
+	return hegel.Composite(func(tc hegel.TestCase) vpContent {
+		return vpContent{
+			lines:  hegel.Draw(tc, lines),
+			crlf:   hegel.Draw(tc, crlfs),
+			tab:    hegel.Draw(tc, tabs),
+			styled: hegel.Draw(tc, styled),
+		}
+	})
+}
+
+var (
+	// crlfs: CRLF line endings one time in ten (bubbles/27; never under
+	// HEGEL_NO_KNOWN=1); tabs: a tab one time in twelve (bubbles/28; likewise).
+	crlfs = zootest.Weighted(zootest.W(9, hegel.Just(false)), zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(true)))
+	tabs  = zootest.Maybe(zootest.Unless(zootest.NoKnown, 8), zootest.Ints(1, 40))
+	// scrollContents: none to eight lines, CRLF or a tab some of the time, never
+	// styled.
+	scrollContents = contentsOf(zootest.Counted(vpLines, 0, 8), crlfs, tabs, hegel.Just(-1))
+)
+
+// vpStart is the viewport a scroll case starts from: the size, a NormalBorder
+// frame, a two-cell gutter, SoftWrap, FillHeight, a Style width k cells above
+// the frame and gutter (0 for none; bubbles/37) and the content.
+type vpStart struct {
+	width, height int
+	frame, gutter bool
+	soft, fill    bool
+	styleK        int
+	content       vpContent
+}
+
+func (s vpStart) frameW() int {
+	if s.frame {
+		return 2
+	}
+	return 0
+}
+
+func (s vpStart) gutterW() int {
+	if s.gutter {
+		return 2
+	}
+	return 0
+}
+
+// styleWidth is the Style's width: frame + gutter + styleK, kept below the
+// viewport's width (modulo the content width less one), or 0 for none.
+func (s vpStart) styleWidth() int {
+	room := s.width - s.frameW() - s.gutterW() - 1
+	if s.styleK <= 0 || room < 1 {
+		return 0
+	}
+	return s.frameW() + s.gutterW() + 1 + (s.styleK-1)%room
+}
+
+func (s vpStart) String() string {
+	parts := []string{fmt.Sprintf("viewport %dx%d", s.width, s.height)}
+	if s.frame {
+		parts = append(parts, "frame")
+	}
+	if s.gutter {
+		parts = append(parts, "gutter")
+	}
+	if s.soft {
+		parts = append(parts, "softwrap")
+	}
+	if s.fill {
+		parts = append(parts, "fill")
+	}
+	if w := s.styleWidth(); w > 0 {
+		parts = append(parts, fmt.Sprintf("Style.Width(%d)", w))
+	}
+	return strings.Join(parts, " ") + " content " + s.content.GoString()
+}
+
+// gutter is a fixed two-cell gutter, as the library's example.
+func gutter(c GutterContext) string {
+	switch {
+	case c.Soft:
+		return "  "
+	case c.Index >= c.TotalLines:
+		return "~ "
+	default:
+		return fmt.Sprintf("%d ", (c.Index+1)%10)
+	}
+}
+
+// build makes the viewport of the start with its content set.
+func (s vpStart) build() Model {
+	m := New(WithWidth(s.width), WithHeight(s.height))
+	if s.frame {
+		m.Style = lipgloss.NewStyle().Border(lipgloss.NormalBorder())
+	}
+	if w := s.styleWidth(); w > 0 {
+		m.Style = m.Style.Width(w)
+	}
+	if s.gutter {
+		m.LeftGutterFunc = gutter
+	}
+	m.SoftWrap = s.soft
+	m.FillHeight = s.fill
+	m.SetContent(s.content.text())
+	return m
+}
+
+// startsOf: a start from the generators of its parts; the width is drawn from
+// frame + gutter + 1 (the content area is at least one cell) to 12, the height
+// from frame + 1 to 6.
+func startsOf(frames, gutters, softs, fills hegel.Generator[bool], styleKs hegel.Generator[int], contents hegel.Generator[vpContent]) hegel.Generator[vpStart] {
+	return hegel.Composite(func(tc hegel.TestCase) vpStart {
+		s := vpStart{frame: hegel.Draw(tc, frames), gutter: hegel.Draw(tc, gutters)}
+		s.width = hegel.Draw(tc, zootest.Ints(s.frameW()+s.gutterW()+1, 12))
+		s.height = hegel.Draw(tc, zootest.Ints(s.frameW()+1, 6))
+		s.soft = hegel.Draw(tc, softs)
+		s.fill = hegel.Draw(tc, fills)
+		s.styleK = hegel.Draw(tc, styleKs)
+		s.content = hegel.Draw(tc, contents)
+		return s
+	})
+}
+
+var (
+	// frames: a NormalBorder three times in ten (the page moves and the scroll
+	// percent then follow the outer height, bubbles/30 and 31; never under
+	// HEGEL_NO_KNOWN=1).
+	frames  = zootest.Weighted(zootest.W(7, hegel.Just(false)), zootest.W(zootest.Unless(zootest.NoKnown, 3), hegel.Just(true)))
+	gutters = zootest.Coin(30)
+	softs   = zootest.Coin(30)
+	fills   = zootest.Coin(50)
+	// styleKs: a Style width below the viewport's one time in ten (bubbles/37;
+	// never under HEGEL_NO_KNOWN=1).
+	styleKs      = zootest.Maybe(zootest.Unless(zootest.NoKnown, 10), zootest.Ints(1, 11))
+	scrollStarts = startsOf(frames, gutters, softs, fills, styleKs, scrollContents)
+)
+
+// vpOp is one operation of a scroll case: a key of the default key map, a
+// wheel direction, SetYOffset/SetXOffset with a literal argument, GotoTop/
+// GotoBottom, ScrollDown/ScrollUp by n, SetContent, SetHeight (the height taken
+// modulo 1 to 6 above the frame) or EnsureVisible (the line modulo the lines,
+// the columns modulo the line's width).
+type vpOp struct {
+	kind     string
+	n        int
+	content  vpContent
+	li, a, b int
+}
+
+func (o vpOp) GoString() string {
+	switch o.kind {
+	case "sety", "setx", "scrolldown", "scrollup", "setheight":
+		return fmt.Sprintf("%s(%d)", o.kind, o.n)
+	case "setcontent":
+		return "setcontent(" + o.content.GoString() + ")"
+	case "ensure":
+		return fmt.Sprintf("ensure(%d,%d,%d)", o.li, o.a, o.b)
+	}
+	return o.kind
+}
+
+func opOf(kind string) hegel.Generator[vpOp] { return hegel.Just(vpOp{kind: kind}) }
+
+func nOp(kind string, ns hegel.Generator[int]) hegel.Generator[vpOp] {
+	return hegel.Map(ns, func(n int) vpOp { return vpOp{kind: kind, n: n} })
+}
+
+var vpKeys = map[string]tea.Msg{
+	"j": typed('j'), "k": typed('k'), "f": typed('f'), "b": typed('b'), "d": typed('d'), "u": typed('u'),
+	"pgdown": keyOf(tea.KeyPgDown), "pgup": keyOf(tea.KeyPgUp), "space": keyOf(tea.KeySpace),
+	"down": keyOf(tea.KeyDown), "up": keyOf(tea.KeyUp), "left": keyOf(tea.KeyLeft), "right": keyOf(tea.KeyRight),
+	"h": typed('h'), "l": typed('l'),
+	"wheeldown": tea.MouseWheelMsg{Button: tea.MouseWheelDown}, "wheelup": tea.MouseWheelMsg{Button: tea.MouseWheelUp},
+	"wheelright": tea.MouseWheelMsg{Button: tea.MouseWheelRight},
+}
+
+// keyKinds: the key, wheel and offset operations (the keys first, j the
+// simplest); keyOps draws one of them at equal weights.
+var keyKinds = []string{"j", "k", "f", "b", "d", "u", "pgdown", "pgup", "space", "down", "up", "left", "right", "h", "l",
+	"wheeldown", "wheelup", "wheelright", "sety", "setx", "top", "bottom", "scrolldown", "scrollup"}
+
+func keyOpsOf(kinds []string) hegel.Generator[vpOp] {
+	var choices []zootest.Choice[vpOp]
+	for _, k := range kinds {
+		switch k {
+		case "sety":
+			choices = append(choices, zootest.W(1, nOp(k, zootest.Ints(-1, 12))))
+		case "setx":
+			choices = append(choices, zootest.W(1, nOp(k, zootest.Ints(-1, 20))))
+		case "scrolldown", "scrollup":
+			choices = append(choices, zootest.W(1, nOp(k, zootest.Ints(0, 4))))
+		default:
+			choices = append(choices, zootest.W(1, opOf(k)))
+		}
+	}
+	return zootest.Weighted(choices...)
+}
+
+var keyOps = keyOpsOf(keyKinds)
+
+// scrollOpsOf: the operations at equal weights (a key or offset operation,
+// SetContent with a content from the generator given, SetHeight, EnsureVisible).
+func scrollOpsOf(contents hegel.Generator[vpContent]) hegel.Generator[vpOp] {
+	return zootest.Weighted(
+		zootest.W(len(keyKinds), keyOps),
+		zootest.W(1, hegel.Map(contents, func(c vpContent) vpOp { return vpOp{kind: "setcontent", content: c} })),
+		zootest.W(1, nOp("setheight", zootest.Ints(1, 6))),
+		zootest.W(1, hegel.Composite(func(tc hegel.TestCase) vpOp {
+			return vpOp{kind: "ensure", li: hegel.Draw(tc, zootest.Ints(0, 7)), a: hegel.Draw(tc, zootest.Ints(0, 20)), b: hegel.Draw(tc, zootest.Ints(0, 20))}
+		})),
+	)
+}
+
+// scrollCase is a start and the operations.
+type scrollCase struct {
+	start vpStart
+	ops   []vpOp
+}
+
+func (c scrollCase) GoString() string {
+	ops := make([]string, len(c.ops))
+	for i, o := range c.ops {
+		ops[i] = o.GoString()
+	}
+	return c.start.String() + ": " + strings.Join(ops, ", ")
+}
+
+func scrollCasesOf(starts hegel.Generator[vpStart], ops hegel.Generator[[]vpOp]) hegel.Generator[scrollCase] {
+	return hegel.Composite(func(tc hegel.TestCase) scrollCase {
+		return scrollCase{start: hegel.Draw(tc, starts), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+var (
+	scrollOps = scrollOpsOf(scrollContents)
+	// scrollCases: a start and none to twelve operations.
+	scrollCases = scrollCasesOf(scrollStarts, zootest.Counted(scrollOps, 0, 12))
+)
+
+// ---------------------------------------------------------------- rows of cells
+
+type row = []zootest.Cell
+
+// cellsOf is the cells of a line as the renderer shows it: a tab is four cells.
+func cellsOf(line string) row { return zootest.Cells(strings.ReplaceAll(line, "\t", "    ")) }
+
+func rowWidth(r row) int { return zootest.Width(r) }
+
+// window returns the plain text of the cells of r between columns a and b
+// as ansi.Cut yields it: a wide cell cut by the left edge is kept whole (the
+// row is then one cell wider than the window, bubbles/32), one cut by the
+// right edge is dropped.
+func window(r row, a, b int) string {
+	var sb strings.Builder
+	p := 0
+	for _, c := range r {
+		if p+c.W > a && p < b && (p >= a || c.W > 1) && (p+c.W <= b || p < a) {
+			sb.WriteString(c.S)
+		}
+		p += c.W
+	}
+	return sb.String()
+}
+
+// wrapRows chunks r greedily into rows of at most width cells; a wide cell
+// that does not fit ends the row.
+func wrapRows(r row, width int) (rows []row) {
+	if width <= 0 {
+		return []row{r}
+	}
+	cur, w := row{}, 0
+	for _, c := range r {
+		if w+c.W > width && w > 0 {
+			rows = append(rows, cur)
+			cur, w = row{}, 0
+		}
+		cur = append(cur, c)
+		w += c.W
+	}
+	return append(rows, cur)
+}
+
+// visual describes the content as the viewport should show it.
+type visual struct {
+	rows    []row // visual rows (soft wrapped or not)
+	soft    []bool
+	lineIdx []int
+	longest int
+	// crossed: a line with a wide cell across a multiple of the content
+	// width, which the library's cut by cells keeps whole in the row before
+	// it, a cell too wide (bubbles/32).
+	crossed bool
+}
+
+func visualOf(lines []string, soft bool, maxWidth int) visual {
+	var v visual
+	if len(lines) == 1 && lines[0] == "" {
+		return v // no content, no rows
+	}
+	for i, l := range lines {
+		r := cellsOf(l)
+		v.longest = max(v.longest, rowWidth(r))
+		if !soft {
+			v.rows = append(v.rows, r)
+			v.soft = append(v.soft, false)
+			v.lineIdx = append(v.lineIdx, i)
+			continue
+		}
+		rows := wrapRows(r, maxWidth)
+		for k := maxWidth; maxWidth > 0 && k < rowWidth(r); k += maxWidth {
+			if straddles(r, k) {
+				v.crossed = true
+			}
+		}
+		for k, rr := range rows {
+			v.rows = append(v.rows, rr)
+			v.soft = append(v.soft, k > 0)
+			v.lineIdx = append(v.lineIdx, i)
+		}
+	}
+	return v
+}
+
+// firstRow is the visual row where line li starts.
+func (v visual) firstRow(li int) int {
+	for r, l := range v.lineIdx {
+		if l == li {
+			return r
+		}
+	}
+	return len(v.rows)
+}
+
+func clampInt(v, lo, hi int) int { return min(hi, max(lo, v)) }
+
+// ---------------------------------------------------------------- the scroll model
+
+// scrollModel is the viewport as it should be: the start, the live lines,
+// height and visual rows, and the two offsets.
+type scrollModel struct {
+	start  vpStart
+	lines  []string
+	height int
+	v      visual
+	y, x   int
+}
+
+func newScrollModel(s vpStart) *scrollModel {
+	m := &scrollModel{start: s, height: s.height}
+	m.setLines(s.content.plain())
+	return m
+}
+
+func (m *scrollModel) clone() *scrollModel {
+	d := *m
+	return &d
+}
+
+// width is the viewport's effective width: the Style's width when it is
+// smaller (the view is rendered at that width), else the width.
+func (m *scrollModel) width() int {
+	if w := m.start.styleWidth(); w > 0 {
+		return w
+	}
+	return m.start.width
+}
+
+func (m *scrollModel) maxWidth() int { return max(0, m.width()-m.start.frameW()-m.start.gutterW()) }
+func (m *scrollModel) maxH() int     { return max(0, m.height-m.start.frameW()) }
+func (m *scrollModel) maxY() int     { return max(0, len(m.v.rows)-m.maxH()) }
+func (m *scrollModel) maxX() int {
+	if m.start.soft {
+		return 0
+	}
+	return max(0, m.v.longest-m.maxWidth())
+}
+
+func (m *scrollModel) setLines(lines []string) {
+	m.lines = lines
+	m.v = visualOf(lines, m.start.soft, m.maxWidth())
+}
+
+// pct is the true scroll percentage: over the content height.
+func (m *scrollModel) pct() float64 {
+	if m.maxY() == 0 {
+		return 1
+	}
+	return min(1, float64(m.y)/float64(m.maxY()))
+}
+
+// libPct is the library's: over the outer height (bubbles/31).
+func (m *scrollModel) libPct() float64 {
+	total := len(m.v.rows)
+	if m.height >= total {
+		return 1
+	}
+	return clampFloat(float64(m.y)/float64(total-m.height), 0, 1)
+}
+
+func clampFloat(v, lo, hi float64) float64 { return min(hi, max(lo, v)) }
+
+// page is the page of a page move: the content height (the library's is the
+// outer height, bubbles/30).
+func (m *scrollModel) page() int { return m.maxH() }
+
+func (m *scrollModel) down(n int) {
+	if m.y < m.maxY() && n > 0 && len(m.lines) > 0 {
+		m.y = min(m.y+n, m.maxY())
+	}
+}
+
+func (m *scrollModel) up(n int) {
+	if m.y > 0 && n > 0 && len(m.lines) > 0 {
+		m.y = clampInt(m.y-n, 0, m.maxY()) // up moves snap a past-bottom offset back
+	}
+}
+
+// ensureArgs is the line and columns of an ensure operation on the live
+// content: the line modulo the lines, the columns modulo the line's width.
+func (m *scrollModel) ensureArgs(op vpOp) (li, a, b int) {
+	if len(m.lines) == 0 {
+		return 0, 0, 0
+	}
+	li = op.li % len(m.lines)
+	rw := rowWidth(cellsOf(m.lines[li]))
+	a = op.a % (rw + 1)
+	b = a + op.b%(rw-a+1)
+	return li, a, b
+}
+
+// setHeightArg is the height of a setheight operation: 1 to 6 above the frame.
+func (m *scrollModel) setHeightArg(op vpOp) int {
+	return m.start.frameW() + 1 + (op.n-1)%(6-m.start.frameW())
+}
+
+// apply performs op on the model.
+func (m *scrollModel) apply(op vpOp) {
+	switch op.kind {
+	case "j", "down":
+		m.down(1)
+	case "k", "up":
+		m.up(1)
+	case "f", "pgdown", "space":
+		m.down(m.page())
+	case "b", "pgup":
+		m.up(m.page())
+	case "d":
+		m.down(m.page() / 2)
+	case "u":
+		m.up(m.page() / 2)
+	case "left", "h":
+		m.x = clampInt(m.x-6, 0, m.maxX())
+	case "right", "l", "wheelright":
+		m.x = clampInt(m.x+6, 0, m.maxX())
+	case "wheeldown":
+		m.down(3)
+	case "wheelup":
+		m.up(3)
+	case "sety":
+		m.y = clampInt(op.n, 0, m.maxY())
+	case "setx":
+		m.x = clampInt(op.n, 0, m.maxX())
+	case "top":
+		m.y = 0
+	case "bottom":
+		m.y = m.maxY()
+	case "scrolldown":
+		m.down(op.n)
+	case "scrollup":
+		m.up(op.n)
+	case "setcontent":
+		m.setLines(op.content.plain())
+		m.y = min(m.y, m.maxY())
+		m.x = min(m.x, m.maxX())
+	case "setheight":
+		m.height = m.setHeightArg(op)
+		// no clamping: PastBottom is documented
+	case "ensure":
+		li, a, b := m.ensureArgs(op)
+		if !m.start.soft {
+			if b <= m.maxWidth() {
+				m.x = 0
+			} else {
+				m.x = clampInt(a-6, 0, m.maxX())
+			}
+		}
+		// the visual row of the column: scrolled to when it is outside
+		r := m.v.firstRow(li)
+		if m.start.soft && m.maxWidth() > 0 {
+			r += a / m.maxWidth()
+		}
+		if r < m.y || r >= m.y+m.maxH() {
+			m.y = clampInt(r, 0, m.maxY())
+		}
+	default:
+		panic("unknown op " + op.kind)
+	}
+}
+
+// libY is the offset the library's page move or EnsureVisible leaves, when it
+// differs from the model's: the page is the outer height (bubbles/30), the
+// line index is taken for a visual row (bubbles/33).
+func (m *scrollModel) libY(op vpOp) int {
+	d := m.clone()
+	switch op.kind {
+	case "f", "pgdown", "space":
+		d.down(m.height)
+	case "b", "pgup":
+		d.up(m.height)
+	case "d":
+		d.down(m.height / 2)
+	case "u":
+		d.up(m.height / 2)
+	case "ensure":
+		li, _, _ := m.ensureArgs(op)
+		if li < m.y || li >= m.y+m.maxH() {
+			d.y = clampInt(li, 0, m.maxY())
+		}
+	}
+	return d.y
+}
+
+// applyLib performs op on the viewport.
+func applyLib(m *Model, s *scrollModel, op vpOp) {
+	switch op.kind {
+	case "sety":
+		m.SetYOffset(op.n)
+	case "setx":
+		m.SetXOffset(op.n)
+	case "top":
+		m.GotoTop()
+	case "bottom":
+		m.GotoBottom()
+	case "scrolldown":
+		m.ScrollDown(op.n)
+	case "scrollup":
+		m.ScrollUp(op.n)
+	case "setcontent":
+		m.SetContent(op.content.text())
+	case "setheight":
+		m.SetHeight(s.setHeightArg(op))
+	case "ensure":
+		m.EnsureVisible(s.ensureArgs(op))
+	default:
+		*m, _ = m.Update(vpKeys[op.kind])
+	}
+}
+
+// hasCR and hasTab: the content's shapes (bubbles/27, 28).
+func hasCR(c vpContent) bool  { return c.crlf && len(c.lines) > 1 }
+func hasTab(c vpContent) bool { return strings.Contains(strings.Join(c.plain(), ""), "\t") }
+
+// stateShape names the recorded bug whose shape the model's state has: CRLF
+// content, which the library keeps the CR of (bubbles/27); a tab, which the
+// library counts as no cell (28); a Style width below the viewport's, which
+// the library renders at but does not cut to (37); a wide rune on a cut
+// boundary, which widens a soft-wrapped row or, scrolled horizontally, a
+// visible row past the content width (32); the horizontal offset past the
+// library's limit of longest - Width with a gutter or a frame (29); a frame
+// and a scroll percentage over the content height that differs from one over
+// the outer height (31); fill rows under soft wrap with a gutter, which the
+// library numbers (38).
+func stateShape(m *scrollModel, content vpContent) string {
+	switch {
+	case hasCR(content):
+		return "bubbles/27"
+	case hasTab(content):
+		return "bubbles/28"
+	case m.start.styleWidth() > 0:
+		return "bubbles/37"
+	case m.start.soft && m.v.crossed, !m.start.soft && m.overWide():
+		return "bubbles/32"
+	case (m.start.frame || m.start.gutter) && m.x > max(0, m.v.longest-m.start.width):
+		return "bubbles/29"
+	case m.start.frame && m.libPct() != m.pct():
+		return "bubbles/31"
+	case m.start.gutter && m.start.soft && m.start.fill && len(m.v.rows) > len(m.lines) && m.y+m.maxH() > len(m.v.rows):
+		return "bubbles/38"
+	}
+	return ""
+}
+
+// overWide reports a visible row whose window, with a wide cell kept whole at
+// its left edge, is wider than the content width.
+func (m *scrollModel) overWide() bool {
+	if m.x == 0 {
+		return false
+	}
+	for vi := m.y; vi < min(len(m.v.rows), m.y+m.maxH()); vi++ {
+		if rowWidth(cellsOf(window(m.v.rows[vi], m.x, m.x+m.maxWidth()))) > m.maxWidth() {
+			return true
+		}
+	}
+	return false
+}
+
+// stepShape names the recorded bug whose shape the operation has from the
+// model's state, before it is applied (on a clone where it is replayed): a
+// SetContent whose content is narrower than the horizontal offset, which the
+// library does not clamp (bubbles/39); a page move inside a frame that the
+// library makes by the outer height (30); an EnsureVisible under soft wrap
+// whose line index the library takes for a visual row (33); then the shapes
+// of the state the operation leaves.
+func stepShape(m *scrollModel, op vpOp) string {
+	d := m.clone()
+	d.apply(op)
+	content := m.start.content
+	switch op.kind {
+	case "setcontent":
+		content = op.content
+		if m.x > d.maxX() {
+			return "bubbles/39"
+		}
+	case "f", "pgdown", "space", "b", "pgup", "d", "u":
+		if m.start.frame && m.libY(op) != d.y {
+			return "bubbles/30"
+		}
+	case "ensure":
+		if m.start.soft && m.libY(op) != d.y {
+			return "bubbles/33"
+		}
+	}
+	return stateShape(d, content)
+}
+
+// judgeScroll drives the viewport through the case and checks the offsets, the
+// counts, the flags, the percentage, the content and the view against the model
+// after the start and after every operation; the wide and the narrow properties
+// share it.
+func judgeScroll(j *zootest.Judge, c scrollCase) {
+	s := newScrollModel(c.start)
+	j.Shape(stateShape(s, c.start.content))
+	m := c.start.build()
+	content := c.start.content
+	checkScroll(j, &m, s, content, "at the start")
+	for _, op := range c.ops {
+		j.Shape(stepShape(s, op))
+		applyLib(&m, s, op)
+		s.apply(op)
+		if op.kind == "setcontent" {
+			content = op.content
+		}
+		j.Note("%s -> y %d/%d x %d/%d", op.GoString(), m.YOffset(), s.y, m.XOffset(), s.x)
+		checkScroll(j, &m, s, content, "after "+op.GoString())
+	}
+}
+
+// checkScroll compares the viewport with the model: the offsets, the line
+// count, AtTop/AtBottom, ScrollPercent (over the content height), GetContent
+// (the lines, CR normalised) and the view: exactly height rows of width cells,
+// each the frame, the gutter and the window of its visual row (the gutter of a
+// fill row "~ "), blank rows past the content.
+func checkScroll(j *zootest.Judge, m *Model, s *scrollModel, content vpContent, what string) {
+	if m.YOffset() != s.y || m.XOffset() != s.x {
+		j.Fail("%s: offsets (y %d, x %d), want (%d, %d)", what, m.YOffset(), m.XOffset(), s.y, s.x)
+	}
+	if m.TotalLineCount() != len(s.v.rows) {
+		j.Fail("%s: TotalLineCount %d, want %d", what, m.TotalLineCount(), len(s.v.rows))
+	}
+	if m.AtTop() != (s.y <= 0) || m.AtBottom() != (s.y >= s.maxY()) {
+		j.Fail("%s: AtTop %v AtBottom %v at y %d (max %d)", what, m.AtTop(), m.AtBottom(), s.y, s.maxY())
+	}
+	if got, want := m.ScrollPercent(), s.pct(); got-want > 1e-9 || want-got > 1e-9 {
+		j.Fail("%s: ScrollPercent %.3f, want %.3f (y %d, max %d)", what, got, want, s.y, s.maxY())
+	}
+	if want := strings.Join(content.plain(), "\n"); content.styledLine() < 0 && m.GetContent() != want {
+		j.Fail("%s: GetContent %q, want %q", what, m.GetContent(), want)
+	}
+	view := m.View()
+	got := strings.Split(view, "\n")
+	if len(got) != s.height {
+		j.Fail("%s: view has %d rows, want %d:\n%s", what, len(got), s.height, view)
+	}
+	width, frame := s.width(), s.start.frameW()
+	for i, line := range got {
+		cells := cellsOf(line)
+		if rowWidth(cells) != width {
+			j.Fail("%s: row %d is %d cells wide, want %d: %q", what, i, rowWidth(cells), width, zootest.String(cells))
+		}
+		if frame > 0 && (i == 0 || i == s.height-1) {
+			continue // border rows
+		}
+		plain := zootest.Plain(cells)
+		if frame > 0 {
+			plain = strings.TrimSuffix(strings.TrimPrefix(plain, "\u2502"), "\u2502")
+		}
+		vi := s.y + i - frame/2
+		want := ""
+		if vi < len(s.v.rows) {
+			r := s.v.rows[vi]
+			if s.start.gutter {
+				want = gutter(GutterContext{Index: s.v.lineIdx[vi], TotalLines: len(s.v.rows), Soft: s.v.soft[vi]})
+			}
+			if s.start.soft {
+				want += zootest.Plain(r)
+			} else {
+				want += window(r, s.x, s.x+s.maxWidth())
+			}
+		} else if s.start.gutter && s.start.fill && s.maxWidth() > 0 {
+			want = gutter(GutterContext{Index: vi, TotalLines: len(s.v.rows)})
+		}
+		if strings.TrimRight(plain, " ") != strings.TrimRight(want, " ") {
+			j.Fail("%s: row %d (visual %d) is %q, want %q (y %d x %d; rows %q)", what, i, vi, plain, want, s.y, s.x, rowsOf(s.v))
+		}
+	}
+}
+
+func rowsOf(v visual) []string {
+	out := make([]string, len(v.rows))
+	for i, r := range v.rows {
+		out[i] = zootest.Plain(r)
+	}
+	return out
+}
+
+// TestHegelViewShowsTheScrolledRows: every key, wheel and method moves the
+// offsets as the model says (page = the content height; the bottom is
+// total − content height; horizontal end = longest − content width) and View
+// is exactly height rows of width cells: frame, gutter and the window of
+// each visual row from the offset, blank rows past the content.
+func TestHegelViewShowsTheScrolledRows(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, scrollCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeScroll(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- highlights
+
+// hiMatch is one match: skipped runes after the previous match's end (the
+// first one's modulo the content's runes) and the length in runes.
+type hiMatch struct {
+	skip, length int
+}
+
+type match struct {
+	start, end int // byte offsets in the content
+}
+
+// matchesOf turns the drawn matches into sorted, disjoint byte ranges on rune
+// boundaries of the plain content; one past the end is dropped, the first is
+// always kept.
+func matchesOf(content string, ms []hiMatch) []match {
+	var bounds []int
+	for i := range content {
+		bounds = append(bounds, i)
+	}
+	bounds = append(bounds, len(content))
+	runes := len(bounds) - 1
+	var out []match
+	end := 0
+	for i, hm := range ms {
+		a := end + hm.skip
+		if i == 0 {
+			a = hm.skip % runes
+		}
+		if a >= runes {
+			break
+		}
+		b := min(runes, a+hm.length)
+		out = append(out, match{bounds[a], bounds[b]})
+		end = b
+	}
+	return out
+}
+
+// hiStart is the viewport a highlight case starts from: the size, soft wrap,
+// whether SelectedHighlightStyle is left unset (bubbles/36), the content and
+// the offset set before the highlights (modulo the rows).
+type hiStart struct {
+	width, height int
+	soft          bool
+	selUnset      bool
+	content       vpContent
+	y0            int
+}
+
+func (s hiStart) String() string {
+	parts := []string{fmt.Sprintf("viewport %dx%d", s.width, s.height)}
+	if s.soft {
+		parts = append(parts, "softwrap")
+	}
+	if s.selUnset {
+		parts = append(parts, "SelectedHighlightStyle unset")
+	}
+	return strings.Join(parts, " ") + fmt.Sprintf(" content %s y0 %d", s.content.GoString(), s.y0)
+}
+
+func (s hiStart) build() Model {
+	m := New(WithWidth(s.width), WithHeight(s.height))
+	m.HighlightStyle = lipgloss.NewStyle().Reverse(true)
+	if !s.selUnset {
+		m.SelectedHighlightStyle = lipgloss.NewStyle().Reverse(true)
+	}
+	m.SoftWrap = s.soft
+	m.SetContent(s.content.text())
+	return m
+}
+
+// hiCase is a start, the matches and the operations (next, prev, down, up).
+type hiCase struct {
+	start   hiStart
+	matches []hiMatch
+	ops     []string
+}
+
+func (c hiCase) GoString() string {
+	ms := make([]string, len(c.matches))
+	for i, m := range c.matches {
+		ms[i] = fmt.Sprintf("+%d:%d", m.skip, m.length)
+	}
+	return fmt.Sprintf("%s matches %s: %s", c.start.String(), strings.Join(ms, " "), strings.Join(c.ops, ", "))
+}
+
+// hiStartsOf: a start from the generators of its parts, the content from the
+// width and soft wrap (under HEGEL_NO_KNOWN=1 soft-wrapped content fits the
+// width, bubbles/33's region being the lines that wrap).
+func hiStartsOf(widths, heights hegel.Generator[int], softs, selUnsets hegel.Generator[bool], contentsFor func(width int, soft bool) hegel.Generator[vpContent], y0s hegel.Generator[int]) hegel.Generator[hiStart] {
+	return hegel.Composite(func(tc hegel.TestCase) hiStart {
+		s := hiStart{width: hegel.Draw(tc, widths), height: hegel.Draw(tc, heights)}
+		s.soft = hegel.Draw(tc, softs)
+		s.selUnset = hegel.Draw(tc, selUnsets)
+		s.content = hegel.Draw(tc, contentsFor(s.width, s.soft))
+		s.y0 = hegel.Draw(tc, y0s)
+		return s
+	})
+}
+
+func hiCasesOf(starts hegel.Generator[hiStart], matches hegel.Generator[[]hiMatch], ops hegel.Generator[[]string]) hegel.Generator[hiCase] {
+	return hegel.Composite(func(tc hegel.TestCase) hiCase {
+		return hiCase{start: hegel.Draw(tc, starts), matches: hegel.Draw(tc, matches), ops: hegel.Draw(tc, ops)}
+	})
+}
+
+// hiLinesOf: lines of up to hi runes, the first of at least one (so the content
+// is never empty), one to six in all.
+func hiLinesOf(hi int) hegel.Generator[[]string] {
+	return zootest.Seq(zootest.One(textsOf(vpRunes, 1, hi)), zootest.Counted(textsOf(vpRunes, 0, hi), 0, 5))
+}
+
+// hiContentsFor: the content of a highlight case: a line styled in a colour
+// one time in ten (bubbles/35; never under HEGEL_NO_KNOWN=1); under
+// HEGEL_NO_KNOWN=1 soft-wrapped content fits the width.
+func hiContentsFor(width int, soft bool) hegel.Generator[vpContent] {
+	hi := 16
+	if zootest.NoKnown && soft {
+		hi = width
+	}
+	return contentsOf(hiLinesOf(hi), hegel.Just(false), hegel.Just(0), styledLines)
+}
+
+var (
+	styledLines = zootest.Weighted(zootest.W(9, hegel.Just(-1)), zootest.W(zootest.Unless(zootest.NoKnown, 1), zootest.Ints(0, 5)))
+	// selUnsets: SelectedHighlightStyle left unset one time in five (bubbles/36;
+	// never under HEGEL_NO_KNOWN=1).
+	selUnsets = zootest.Weighted(zootest.W(4, hegel.Just(false)), zootest.W(zootest.Unless(zootest.NoKnown, 1), hegel.Just(true)))
+	hiMatches = hegel.Composite(func(tc hegel.TestCase) hiMatch {
+		return hiMatch{skip: hegel.Draw(tc, zootest.Ints(0, 5)), length: hegel.Draw(tc, zootest.Ints(1, 6))}
+	})
+	hiOps    = zootest.Sampled("next", "prev", "down", "up")
+	hiStarts = hiStartsOf(zootest.Ints(1, 12), zootest.Ints(1, 6), zootest.Coin(20), selUnsets, hiContentsFor, zootest.Ints(0, 12))
+	// hiCases: a start, one to four matches and none to six operations; under
+	// HEGEL_NO_KNOWN=1 a HighlightPrevious with no selected match is left out
+	// (unshapedHi).
+	hiCases = hegel.Map(hiCasesOf(hiStarts, zootest.Counted(hiMatches, 1, 4), zootest.Counted(hiOps, 0, 6)), unshapedHi)
+)
+
+// unshapedHi is the case with, under HEGEL_NO_KNOWN=1, every HighlightPrevious
+// that would find no selected match among two or more (bubbles/34's shape, a
+// relation between the operation and the live selection) left out: the model is
+// replayed over the operations kept so far. By default the case is drawn as it is.
+func unshapedHi(c hiCase) hiCase {
+	if !zootest.NoKnown {
+		return c
+	}
+	m := newHiModel(c)
+	var kept []string
+	for _, op := range c.ops {
+		if op == "prev" && m.sel < 0 && len(m.ms) >= 2 {
+			continue
+		}
+		m.apply(op)
+		kept = append(kept, op)
+	}
+	return hiCase{start: c.start, matches: c.matches, ops: kept}
+}
+
+// cellRanges returns, per line, the cell ranges the matches cover.
+func cellRanges(lines []string, ms []match) map[int][][2]int {
+	out := map[int][][2]int{}
+	offset := 0
+	for li, l := range lines {
+		col := 0
+		for _, c := range cellsOf(l) {
+			bstart, bend := offset, offset+len(c.S)
+			for _, m := range ms {
+				if m.start < bend && bstart < m.end {
+					out[li] = append(out[li], [2]int{col, col + c.W})
+					break
+				}
+			}
+			col += c.W
+			offset += len(c.S)
+		}
+		offset++ // the newline
+	}
+	return out
+}
+
+func firstLine(content string, m match) int {
+	return strings.Count(content[:m.start], "\n")
+}
+
+// matchCells returns the first line the match touches and the cell columns
+// it covers there. A line's newline counts as one more cell after its last
+// (the library shows a match on it there and scrolls for it).
+func matchCells(lines []string, m match) (line, colstart, colend int) {
+	offset := 0
+	for li, l := range lines {
+		col, first, last := 0, -1, 0
+		cells := cellsOf(l)
+		if li < len(lines)-1 {
+			cells = append(cells, zootest.Cell{S: "\n", W: 1})
+		}
+		for _, c := range cells {
+			if m.start < offset+len(c.S) && offset < m.end {
+				if first < 0 {
+					first = col
+				}
+				last = col + c.W
+			}
+			col += c.W
+			offset += len(c.S)
+		}
+		if first >= 0 {
+			return li, first, last
+		}
+	}
+	return len(lines) - 1, 0, 0
+}
+
+// hiModel is the highlights as they should be: the content's lines and visual
+// rows, the matches, the selected index and the offsets.
+type hiModel struct {
+	start   hiStart
+	lines   []string
+	content string
+	v       visual
+	ms      []match
+	sel     int
+	y, x    int
+}
+
+func newHiModel(c hiCase) *hiModel {
+	lines := c.start.content.plain()
+	content := strings.Join(lines, "\n")
+	m := &hiModel{start: c.start, lines: lines, content: content}
+	m.v = visualOf(lines, c.start.soft, c.start.width)
+	m.ms = matchesOf(content, c.matches)
+	m.y = clampInt(c.start.y0%max(1, len(m.v.rows)), 0, m.maxY())
+	m.sel = m.nearest(m.y)
+	m.show()
+	return m
+}
+
+func (m *hiModel) maxY() int { return max(0, len(m.v.rows)-m.start.height) }
+
+// matchRow is the visual row of the match's first cell.
+func (m *hiModel) matchRow(i int) int {
+	li, cs, _ := matchCells(m.lines, m.ms[i])
+	r := m.v.firstRow(li)
+	if m.start.soft {
+		r += cs / m.start.width
+	}
+	return r
+}
+
+// nearest is the first match whose visual row is at or below the top.
+func (m *hiModel) nearest(y int) int {
+	for i := range m.ms {
+		if m.matchRow(i) >= y {
+			return i
+		}
+	}
+	return -1
+}
+
+// libNearest is the library's: the first match whose line is at or below the
+// top (bubbles/33 under soft wrap).
+func (m *hiModel) libNearest(y int) int {
+	for i, mm := range m.ms {
+		if firstLine(m.content, mm) >= y {
+			return i
+		}
+	}
+	return -1
+}
+
+// show scrolls the selected match into view: horizontally to colstart - 6 when
+// its end is past the width, vertically to its visual row when it is outside.
+func (m *hiModel) show() {
+	if m.sel < 0 {
+		return
+	}
+	_, cs, ce := matchCells(m.lines, m.ms[m.sel])
+	if !m.start.soft {
+		if ce <= m.start.width {
+			m.x = 0
+		} else {
+			m.x = clampInt(cs-6, 0, max(0, m.v.longest-m.start.width))
+		}
+	}
+	if r := m.matchRow(m.sel); r < m.y || r >= m.y+m.start.height {
+		m.y = clampInt(r, 0, m.maxY())
+	}
+}
+
+// libShowY is the offset the library's EnsureVisible leaves: the match's line
+// taken for a visual row (bubbles/33 under soft wrap).
+func (m *hiModel) libShowY() int {
+	if m.sel < 0 {
+		return m.y
+	}
+	li, _, _ := matchCells(m.lines, m.ms[m.sel])
+	if li < m.y || li >= m.y+m.start.height {
+		return clampInt(li, 0, m.maxY())
+	}
+	return m.y
+}
+
+func (m *hiModel) clone() *hiModel {
+	d := *m
+	return &d
+}
+
+func (m *hiModel) apply(op string) {
+	switch op {
+	case "next":
+		m.sel = (m.sel + 1) % len(m.ms)
+		m.show()
+	case "prev":
+		if m.sel < 0 {
+			m.sel = len(m.ms) - 1
+		} else {
+			m.sel = (m.sel - 1 + len(m.ms)) % len(m.ms)
+		}
+		m.show()
+	case "down":
+		if m.y < m.maxY() {
+			m.y++
+			m.sel = m.nearest(m.y)
+		}
+	case "up":
+		if m.y > 0 {
+			m.y--
+			m.sel = m.nearest(m.y)
+		}
+	}
+}
+
+// styledShape names bubbles/35's shape: a styled line and a match starting
+// after its newline, or reaching past it, which the library places by the raw
+// content's bytes (a match inside the styled line is placed right: the escapes
+// shift only the newlines after them).
+func (m *hiModel) styledShape() string {
+	s := m.start.content.styledLine()
+	if s < 0 {
+		return ""
+	}
+	nl := 0 // the byte offset of the styled line's newline
+	for i := 0; i <= s; i++ {
+		nl += len(m.lines[i]) + 1
+	}
+	nl--
+	for _, mm := range m.ms {
+		if mm.start > nl || mm.end > nl+1 {
+			return "bubbles/35"
+		}
+	}
+	return ""
+}
+
+// softShape names bubbles/33's shape at a step: under soft wrap the library's
+// nearest match or scroll, in line indices, differs from the model's, in
+// visual rows.
+func (m *hiModel) softShape(op string) string {
+	if !m.start.soft {
+		return ""
+	}
+	d := m.clone()
+	switch op {
+	case "":
+		if m.libNearest(m.y) != m.nearest(m.y) {
+			return "bubbles/33"
+		}
+		d.sel = m.nearest(m.y)
+		d.show()
+		if d.y != m.libShowY() {
+			return "bubbles/33"
+		}
+	case "next", "prev":
+		d.apply(op)
+		e := m.clone()
+		e.sel = d.sel
+		if d.y != e.libShowY() {
+			return "bubbles/33"
+		}
+	case "down", "up":
+		d.apply(op)
+		if d.nearest(d.y) != d.libNearest(d.y) {
+			return "bubbles/33"
+		}
+	}
+	return ""
+}
+
+// selectedShape names bubbles/36's shape: SelectedHighlightStyle unset and the
+// selected match with a cell in the window (the view is only checked without
+// soft wrap).
+func (m *hiModel) selectedShape() string {
+	if !m.start.selUnset || m.sel < 0 || m.start.soft {
+		return ""
+	}
+	for li, ranges := range cellRanges(m.lines, []match{m.ms[m.sel]}) {
+		if li < m.y || li >= m.y+m.start.height {
+			continue
+		}
+		for _, r := range ranges {
+			if r[0] >= m.x && r[1] <= m.x+m.start.width {
+				return "bubbles/36"
+			}
+		}
+	}
+	return ""
+}
+
+// straddles reports whether a wide cell of r sits across column x.
+func straddles(r row, x int) bool {
+	p := 0
+	for _, c := range r {
+		if p < x && x < p+c.W {
+			return true
+		}
+		p += c.W
+	}
+	return false
+}
+
+// straddleShape names bubbles/32's shape: a visible line with a wide cell
+// across the left edge of the window, kept whole, which shifts the row.
+func (m *hiModel) straddleShape() string {
+	if m.start.soft || m.x == 0 {
+		return ""
+	}
+	for li := m.y; li < min(len(m.lines), m.y+m.start.height); li++ {
+		if straddles(cellsOf(m.lines[li]), m.x) {
+			return "bubbles/32"
+		}
+	}
+	return ""
+}
+
+// hiStepShape names the recorded bug whose shape the operation has before it is
+// taken: HighlightPrevious with no selected match among two or more, which the
+// library lands on the second-to-last (bubbles/34); the soft-wrap scroll (33);
+// then the state it leaves (36, 32).
+func (m *hiModel) stepShape(op string) string {
+	if op == "prev" && m.sel < 0 && len(m.ms) >= 2 {
+		return "bubbles/34"
+	}
+	if s := m.softShape(op); s != "" {
+		return s
+	}
+	d := m.clone()
+	d.apply(op)
+	if s := d.selectedShape(); s != "" {
+		return s
+	}
+	return d.straddleShape()
+}
+
+// judgeHighlights sets the highlights, drives the operations and checks the
+// selected index, the offsets and the reversed cells of every visible line
+// against the model after each; the wide and the narrow properties share it.
+func judgeHighlights(j *zootest.Judge, c hiCase) {
+	s := newHiModel(c)
+	j.Shape(s.styledShape())
+	j.Shape(s.softShape(""))
+	j.Shape(s.selectedShape())
+	j.Shape(s.straddleShape())
+	m := c.start.build()
+	m.SetYOffset(c.start.y0 % max(1, len(s.v.rows)))
+	raw := make([][]int, 0, len(s.ms))
+	for _, mm := range s.ms {
+		raw = append(raw, []int{mm.start, mm.end})
+	}
+	m.SetHighlights(raw)
+	want := cellRanges(s.lines, s.ms)
+	checkHighlights(j, &m, s, want, "after SetHighlights")
+	for _, op := range c.ops {
+		j.Shape(s.stepShape(op))
+		switch op {
+		case "next":
+			m.HighlightNext()
+		case "prev":
+			m.HighlightPrevious()
+		case "down":
+			m.ScrollDown(1)
+		case "up":
+			m.ScrollUp(1)
+		}
+		s.apply(op)
+		j.Note("%s -> selected %d/%d y %d/%d", op, m.hiIdx, s.sel, m.YOffset(), s.y)
+		checkHighlights(j, &m, s, want, "after "+op)
+	}
+}
+
+func checkHighlights(j *zootest.Judge, m *Model, s *hiModel, want map[int][][2]int, what string) {
+	if m.hiIdx != s.sel || m.YOffset() != s.y || m.XOffset() != s.x {
+		j.Fail("%s: selected %d at (y %d, x %d), want %d at (%d, %d); matches %v rows %q", what, m.hiIdx, m.YOffset(), m.XOffset(), s.sel, s.y, s.x, s.ms, rowsOf(s.v))
+	}
+	if s.start.soft {
+		return // the rows are checked by the view property; cells here
+	}
+	width := s.start.width
+	for i, line := range strings.Split(m.View(), "\n") {
+		li := s.y + i
+		var visible [][2]int // the wanted cells inside the window
+		for _, r := range want[li] {
+			if r[0] >= s.x && r[1] <= s.x+width {
+				visible = append(visible, [2]int{r[0] - s.x, r[1] - s.x})
+			}
+		}
+		var got [][2]int
+		col := 0
+		for _, c := range cellsOf(line) {
+			if c.Rev {
+				got = append(got, [2]int{col, col + c.W})
+			}
+			col += c.W
+		}
+		if fmt.Sprint(got) != fmt.Sprint(visible) {
+			j.Fail("%s: line %d highlighted cells %v, want %v: %q (selected %d, matches %v)", what, li, got, visible, zootest.String(cellsOf(line)), s.sel, s.ms)
+		}
+	}
+}
+
+// TestHegelHighlightsMarkTheMatches: the highlighted cells of each visible
+// line are exactly the cells of the matched runes; SetHighlights selects the
+// first match at or below the top and scrolls it into view; HighlightNext /
+// HighlightPrevious cycle and scroll; scrolling reselects the nearest match.
+func TestHegelHighlightsMarkTheMatches(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, hiCases)
+		j := zootest.NewJudge(ht)
+		defer j.Recover()
+		judgeHighlights(j, c)
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+func plainRows(v string) []string {
+	var out []string
+	for _, l := range strings.Split(v, "\n") {
+		out = append(out, zootest.String(zootest.Cells(l)))
+	}
+	return out
+}
+
+// bubbles/27: SetContent splits on "\n" before the CRLF normalisation runs,
+// so CRLF content keeps a "\r" on every line.
+func TestHegelPinSetContentKeepsCarriageReturns(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(10), WithHeight(3))
+	m.SetContent("a\r\nb\r\nc")
+	if got := m.GetContent(); got != "a\nb\nc" {
+		t.Fatalf("GetContent after SetContent(\"a\\r\\nb\\r\\nc\") = %q, want \"a\\nb\\nc\"", got)
+	}
+}
+
+// bubbles/28: a tab is 0 cells to the viewport and 4 to the renderer: rows
+// overflow the width, are wrapped, and the view is taller than the height.
+func TestHegelPinTabsOverflowTheRow(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(3), WithHeight(1))
+	m.SetContent("a\tb")
+	if rows := strings.Split(m.View(), "\n"); len(rows) != 1 {
+		t.Fatalf("a 1-row viewport of \"a\\tb\" renders %d rows: %q", len(rows), plainRows(m.View()))
+	}
+}
+
+// bubbles/29: the horizontal end is longest − Width, not longest − content
+// width: with a gutter or a frame the last columns can never be shown.
+func TestHegelPinHorizontalScrollStopsShortWithAGutter(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(10), WithHeight(1))
+	m.LeftGutterFunc = func(GutterContext) string { return "|| " }
+	m.SetContent("0123456789abcdefghij")
+	for i := 0; i < 10; i++ {
+		m.ScrollRight(6)
+	}
+	if v := m.View(); !strings.Contains(v, "j") {
+		t.Fatalf("scrolled fully right (x %d), the line's last column is not shown: %q", m.XOffset(), plainRows(v))
+	}
+}
+
+// bubbles/30: PageDown/PageUp/HalfPage scroll by Height, frame included, so
+// a bordered viewport skips lines.
+func TestHegelPinPageDownSkipsLinesInsideAFrame(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(10), WithHeight(5))
+	m.Style = lipgloss.NewStyle().Border(lipgloss.NormalBorder())
+	m.SetContent("l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10")
+	m.PageDown()
+	if m.YOffset() != 3 {
+		t.Fatalf("PageDown in a bordered viewport showing 3 lines moved to y %d, want 3 (lines l4, l5 skipped)", m.YOffset())
+	}
+}
+
+// bubbles/31: ScrollPercent uses Height, frame included: 100 % before the
+// bottom, and always 100 % when the content is shorter than Height but
+// taller than the content area.
+func TestHegelPinScrollPercentIgnoresTheFrame(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(10), WithHeight(5))
+	m.Style = lipgloss.NewStyle().Border(lipgloss.NormalBorder())
+	m.SetContent("l1\nl2\nl3\nl4\nl5\nl6\nl7\nl8\nl9\nl10")
+	m.SetYOffset(5)
+	if m.AtBottom() {
+		t.Fatalf("unexpectedly at the bottom at y 5")
+	}
+	if p := m.ScrollPercent(); p >= 1 {
+		t.Fatalf("ScrollPercent %.2f at y 5 of max %d", p, m.maxYOffset())
+	}
+}
+
+// bubbles/32: soft-wrapped rows are counted as ceil(width/content width)
+// but cut by cells, so a wide rune on a boundary widens a row; the renderer
+// wraps it again and the view is taller than the height.
+func TestHegelPinSoftWrapOfWideRunesOverflowsTheHeight(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(3), WithHeight(2))
+	m.SoftWrap = true
+	m.SetContent("日本語")
+	if rows := strings.Split(m.View(), "\n"); len(rows) != 2 {
+		t.Fatalf("a 2-row soft-wrapping viewport of 日本語 renders %d rows (TotalLineCount %d): %q", len(rows), m.TotalLineCount(), plainRows(m.View()))
+	}
+}
+
+// bubbles/33: under soft wrap EnsureVisible and findNearestMatch take a
+// real line index for a visual offset: the highlighted match scrolls off.
+func TestHegelPinSoftWrapScrollsTheHighlightOffScreen(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(4), WithHeight(2))
+	m.SoftWrap = true
+	m.HighlightStyle = lipgloss.NewStyle().Reverse(true)
+	m.SelectedHighlightStyle = m.HighlightStyle
+	content := "aaaabbbbcccc\nl1\nl2\nl3\nl4\nl5\nl6"
+	m.SetContent(content)
+	i := strings.Index(content, "l5")
+	m.SetHighlights([][]int{{i, i + 2}})
+	if v := m.View(); !strings.Contains(v, "l5") {
+		t.Fatalf("after SetHighlights on l5 the view (y %d) shows %q", m.YOffset(), plainRows(v))
+	}
+}
+
+// bubbles/34: HighlightPrevious with no selected match lands on the
+// second-to-last one.
+func TestHegelPinHighlightPreviousFromNoneSkipsTheLast(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(10), WithHeight(1))
+	m.SetContent("m\nm\nm\nx\nx\nx")
+	m.SetHighlights([][]int{{0, 1}, {2, 3}, {4, 5}})
+	m.SetYOffset(5)
+	m.ScrollDown(1) // no-op at the bottom; reselect by hand as ScrollDown would
+	m.hiIdx = m.findNearestMatch()
+	if m.hiIdx != -1 {
+		t.Fatalf("expected no selected match below the matches, got %d", m.hiIdx)
+	}
+	m.HighlightPrevious()
+	if m.hiIdx != 2 {
+		t.Fatalf("HighlightPrevious from none selected match %d, want 2 (the last)", m.hiIdx)
+	}
+}
+
+// bubbles/35: highlights walk the graphemes of the stripped content but look
+// newlines up in the raw content, so styled content cannot be highlighted
+// with either raw or stripped byte offsets.
+func TestHegelPinStyledContentCannotBeHighlighted(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(10), WithHeight(2))
+	m.HighlightStyle = lipgloss.NewStyle().Reverse(true)
+	m.SelectedHighlightStyle = m.HighlightStyle
+	m.SetContent("\x1b[31mab\x1b[0m\ncd")
+	m.SetHighlights([][]int{{3, 5}}) // "cd" in the stripped content
+	rows := plainRows(m.View())
+	if !strings.Contains(rows[1], "[c][d]") {
+		m.SetHighlights([][]int{{10, 12}}) // "cd" in the raw content
+		rows2 := plainRows(m.View())
+		if !strings.Contains(rows2[1], "[c][d]") {
+			t.Fatalf("\"cd\" of styled content highlighted neither by stripped offsets %q nor raw ones %q", rows, rows2)
+		}
+	}
+}
+
+// bubbles/36: the selected match is re-styled with SelectedHighlightStyle
+// alone; with the default (unset) style it is the one match not highlighted.
+func TestHegelPinSelectedMatchLosesItsHighlight(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(6), WithHeight(1))
+	m.HighlightStyle = lipgloss.NewStyle().Reverse(true)
+	m.SetContent("ab")
+	m.SetHighlights([][]int{{0, 1}})
+	if v := plainRows(m.View())[0]; !strings.HasPrefix(v, "[a]") {
+		t.Fatalf("the only (selected) match is not highlighted: %q", v)
+	}
+}
+
+// bubbles/38: under soft wrap the gutter of FillHeight's blank rows gets a
+// real-line Index against a visual TotalLines, so they are numbered.
+func TestHegelPinSoftWrapNumbersTheFillRows(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(6), WithHeight(4))
+	m.SoftWrap = true
+	m.FillHeight = true
+	m.LeftGutterFunc = gutter
+	m.SetContent("abcdefgh") // two rows of four
+	rows := plainRows(m.View())
+	if !strings.HasPrefix(rows[2], "~ ") || !strings.HasPrefix(rows[3], "~ ") {
+		t.Fatalf("the fill rows below two soft-wrapped rows are gutted %q and %q, want \"~ \"", rows[2], rows[3])
+	}
+}
+
+// bubbles/39: SetContent clamps the vertical offset to the new content but
+// not the horizontal one, so narrower content stays scrolled off the left.
+func TestHegelPinSetContentKeepsAStaleHorizontalOffset(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(10), WithHeight(1))
+	m.SetContent("0123456789abcdef")
+	m.ScrollRight(6)
+	m.SetContent("hello")
+	if v := plainRows(m.View())[0]; !strings.HasPrefix(v, "hello") {
+		t.Fatalf("after SetContent(\"hello\") the view is %q (x %d)", v, m.XOffset())
+	}
+}
+
+// bubbles/37: a Style width smaller than the viewport's caps the render but
+// not the cut, so rows are wrapped by the renderer and the view grows.
+func TestHegelPinStyleWidthWrapsTheRows(t *testing.T) {
+	defer guard(t)
+	m := New(WithWidth(10), WithHeight(1))
+	m.Style = lipgloss.NewStyle().Width(4)
+	m.SetContent("0123456789")
+	if rows := strings.Split(m.View(), "\n"); len(rows) != 1 {
+		t.Fatalf("Style.Width(4) on a 1-row viewport renders %d rows: %q", len(rows), plainRows(m.View()))
+	}
+}
