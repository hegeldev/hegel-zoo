+func TestHegelPinTextareaDeleteWordBackwardEatsTheLeadingSpace(t *testing.T) {
+	defer guard(t)
+	m := pinArea(20, 3)
+	m.SetValue(" ab")
+	m = press(m, kDelWordBack)
+	if m.Value() != " " {
+		t.Fatalf("ctrl+w after \" ab\": value %q, want \" \"", m.Value())
+	}
+}
