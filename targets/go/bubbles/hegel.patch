+			fail(ht, "Cursor() row %d, want 0", c.Position.Y)
+		}
+		if c.Position.X != want {
+			if m.offset > 0 || uniseg.StringWidth(string(m.value[:m.pos])) != m.pos {
+				// Cursor() adds the rune index to the prompt width: wrong
+				// once the window has scrolled or a wide rune precedes the
+				// cursor (bubbles/8).
+				count("bubbles/8-shape")
+				return
+			}
+			fail(ht, "Cursor() at column %d, want %d (value %q pos %d window [%d,%d) width %d)", c.Position.X, want, m.Value(), m.pos, m.offset, m.offsetRight, m.Width())
+		}
+	})
+}
