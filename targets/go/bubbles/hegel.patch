+// bubbles/5: SetValue and Reset keep the matched suggestions of the previous
+// value; tab then completes the wrong text, or panics when the value is
+// longer than the stale suggestion.
+func TestHegelPinSetValueKeepsStaleSuggestions(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.ShowSuggestions = true
+	m.SetSuggestions([]string{"apple"})
+	m = press(m, typed('a'))
+	m.SetValue("zzz")
+	if got := m.CurrentSuggestion(); got != "" {
+		t.Fatalf("after SetValue(%q) the current suggestion is %q, want none", "zzz", got)
+	}
+	m = press(m, kTab)
+	if m.Value() != "zzz" {
+		t.Fatalf("tab after SetValue(%q) gives %q", "zzz", m.Value())
+	}
+	m = New()
+	m.Focus()
+	m.ShowSuggestions = true
+	m.SetSuggestions([]string{"apple"})
+	m = press(m, typed('a'))
+	m.SetValue("apple pie")
+	m = press(m, kTab)
+	if m.Value() != "apple pie" {
+		t.Fatalf("tab after SetValue(%q) gives %q", "apple pie", m.Value())
