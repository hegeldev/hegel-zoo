diff --git a/help/hegel_test.go b/help/hegel_test.go
new file mode 100644
index 0000000..6ae29e8
--- /dev/null
+++ b/help/hegel_test.go
@@ -0,0 +1,285 @@
+package help
+
+// Hegel properties for the help bubble: the short and the full view checked
+// against a layout model of the enabled bindings, the separators, the width
+// and the ellipsis.
+
+import (
+	"strings"
+	"testing"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	"charm.land/bubbles/v2/key"
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+)
+
+var helpWords = []string{"", "a", "?", "up", "esc", "ctrl+c", "↑/k", "quit", "move down", "全角", "x"}
+
+type hb struct {
+	key, desc string
+	on        bool
+}
+
+func (b hb) binding() key.Binding {
+	kb := key.NewBinding(key.WithKeys("x"), key.WithHelp(b.key, b.desc))
+	if !b.on {
+		kb.SetEnabled(false)
+	}
+	return kb
+}
+
+func genBinding(tc hegel.TestCase) hb {
+	return hb{key: zootest.Pick(tc, helpWords), desc: zootest.Pick(tc, helpWords), on: !zootest.Chance(tc, 15)}
+}
+
+func pad(s string, w int) string {
+	return s + strings.Repeat(" ", max(0, w-ansi.StringWidth(s)))
+}
+
+// fit is shouldAddItem done right: the item is added only when it fits; when
+// it does not, the ellipsis tail is added when there is room for it.
+// exact reports that the tail would fit exactly (bubbles/58's shape).
+func fit(width, total, w, tailW int) (add, tail, exact bool) {
+	if width <= 0 || total+w <= width {
+		return true, false, false
+	}
+	return false, total+tailW <= width, total+tailW == width
+}
+
+// shortModel is the short help line: enabled items "key desc" joined by the
+// separator, cut at the width with the ellipsis.
+func shortModel(width int, sep, ell string, bs []hb) (line string, overflow, exact bool) {
+	tailW := ansi.StringWidth(" " + ell)
+	total := 0
+	var sb strings.Builder
+	for _, b := range bs {
+		if !b.on {
+			continue
+		}
+		item := b.key + " " + b.desc
+		if total > 0 {
+			item = sep + item
+		}
+		w := ansi.StringWidth(item)
+		add, tail, ex := fit(width, total, w, tailW)
+		if !add {
+			if tail {
+				sb.WriteString(" " + ell)
+			}
+			return sb.String(), true, ex
+		}
+		total += w
+		sb.WriteString(item)
+	}
+	return sb.String(), false, false
+}
+
+// fullModel is the full help block: one column per group with an enabled
+// binding, keys and descriptions aligned, columns joined at the top.
+func fullModel(width int, sep, ell string, groups [][]hb) (lines []string, overflow, exact bool) {
+	type col struct {
+		lines []string
+		w     int
+	}
+	var cols []col
+	total := 0
+	tailW := ansi.StringWidth(" " + ell)
+	height := 0
+	for _, g := range groups {
+		var keys, descs []string
+		kw, dw := 0, 0
+		for _, b := range g {
+			if !b.on {
+				continue
+			}
+			keys = append(keys, b.key)
+			descs = append(descs, b.desc)
+			kw = max(kw, ansi.StringWidth(b.key))
+			dw = max(dw, ansi.StringWidth(b.desc))
+		}
+		if len(keys) == 0 {
+			continue
+		}
+		s := ""
+		if total > 0 {
+			s = sep
+		}
+		// the separator is a one-line block joined at the top: it shows on
+		// the first line only, the lines below get spaces
+		c := col{w: ansi.StringWidth(s) + kw + 1 + dw}
+		for i := range keys {
+			c.lines = append(c.lines, pad(s, ansi.StringWidth(s))+pad(keys[i], kw)+" "+pad(descs[i], dw))
+			s = strings.Repeat(" ", ansi.StringWidth(s))
+		}
+		add, tail, ex := fit(width, total, c.w, tailW)
+		if !add {
+			if tail {
+				cols = append(cols, col{lines: []string{" " + ell}, w: tailW})
+				height = max(height, 1)
+			}
+			overflow, exact = true, ex
+			break
+		}
+		total += c.w
+		cols = append(cols, c)
+		height = max(height, len(c.lines))
+	}
+	if len(cols) == 0 {
+		return nil, overflow, exact
+	}
+	for r := 0; r < height; r++ {
+		var sb strings.Builder
+		for _, c := range cols {
+			l := ""
+			if r < len(c.lines) {
+				l = c.lines[r]
+			}
+			sb.WriteString(pad(l, c.w))
+		}
+		lines = append(lines, sb.String())
+	}
+	return lines, overflow, exact
+}
+
+// TestHegelHelpFitsTheWidth: ShortHelpView is the enabled bindings' "key
+// desc" items joined by the separator, and FullHelpView one aligned column
+// per group; with a width set, both stop before the item or column that
+// does not fit and end in the ellipsis when there is room for it, so the
+// rendered width never exceeds the width.
+func TestHegelHelpFitsTheWidth(t *testing.T) {
+	zootest.Guard(t)
+	zootest.Property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		m := New()
+		if zootest.Chance(tc, 30) {
+			m.ShortSeparator = zootest.Pick(tc, []string{" | ", " ", "", "・"})
+			m.FullSeparator = zootest.Pick(tc, []string{" | ", "  ", "", " ・ "})
+		}
+		if zootest.Chance(tc, 30) {
+			m.Ellipsis = zootest.Pick(tc, []string{"...", "", "→", "…"})
+		}
+		width := 0
+		if zootest.Chance(tc, 80) {
+			width = zootest.N(tc, 1, 40)
+		}
+		m.SetWidth(width)
+		if m.Width() != width {
+			zootest.Fail(ht, "Width() %d after SetWidth(%d)", m.Width(), width)
+			return
+		}
+		var bs []hb
+		for range zootest.N(tc, 0, 6) {
+			bs = append(bs, genBinding(tc))
+		}
+		var kbs []key.Binding
+		for _, b := range bs {
+			kbs = append(kbs, b.binding())
+		}
+		got := m.ShortHelpView(kbs)
+		plain := ansi.Strip(got)
+		want, overflow, exact := shortModel(width, m.ShortSeparator, m.Ellipsis, bs)
+		if plain != want {
+			switch {
+			case overflow && exact:
+				// bubbles/58: an ellipsis that fits exactly is dropped (and
+				// the item added instead, bubbles/57's way).
+				zootest.Count("bubbles/58")
+				return
+			case width > 0 && ansi.StringWidth(plain) > width:
+				// bubbles/57: the item that does not fit is added when the
+				// ellipsis does not fit either.
+				zootest.Count("bubbles/57")
+				return
+			}
+			zootest.Fail(ht, "width %d, sep %q, ellipsis %q, bindings %+v:\nShortHelpView %q\nwant          %q", width, m.ShortSeparator, m.Ellipsis, bs, plain, want)
+			return
+		}
+		if ansi.StringWidth(got) != ansi.StringWidth(plain) || strings.Contains(got, "\n") {
+			zootest.Fail(ht, "styled short view %q is not one line of the plain width", got)
+			return
+		}
+		var groups [][]hb
+		var kgroups [][]key.Binding
+		for range zootest.N(tc, 0, 4) {
+			var g []hb
+			var kg []key.Binding
+			for range zootest.N(tc, 0, 3) {
+				b := genBinding(tc)
+				g = append(g, b)
+				kg = append(kg, b.binding())
+			}
+			if zootest.Chance(tc, 10) {
+				// a nil group is skipped like one without enabled bindings
+				kg, g = nil, nil
+			}
+			groups = append(groups, g)
+			kgroups = append(kgroups, kg)
+		}
+		got = m.FullHelpView(kgroups)
+		var lines []string
+		if got != "" {
+			lines = strings.Split(ansi.Strip(got), "\n")
+		}
+		wantLines, overflow, exact := fullModel(width, m.FullSeparator, m.Ellipsis, groups)
+		if strings.Join(lines, "\n") != strings.Join(wantLines, "\n") {
+			switch {
+			case overflow && exact:
+				zootest.Count("bubbles/58")
+				return
+			case width > 0 && len(lines) > 0 && ansi.StringWidth(lines[0]) > width:
+				zootest.Count("bubbles/57")
+				return
+			}
+			zootest.Fail(ht, "width %d, sep %q, ellipsis %q, groups %+v:\nFullHelpView\n%s\nwant\n%s", width, m.FullSeparator, m.Ellipsis, groups, strings.Join(lines, "\n"), strings.Join(wantLines, "\n"))
+			return
+		}
+		m.ShowAll = zootest.Chance(tc, 50)
+		km := zkeys{short: kbs, full: kgroups}
+		if v := ansi.Strip(m.View(km)); (m.ShowAll && v != strings.Join(lines, "\n")) || (!m.ShowAll && v != plain) {
+			zootest.Fail(ht, "View (ShowAll %v) %q", m.ShowAll, v)
+			return
+		}
+	})
+}
+
+type zkeys struct {
+	short []key.Binding
+	full  [][]key.Binding
+}
+
+func (k zkeys) ShortHelp() []key.Binding  { return k.short }
+func (k zkeys) FullHelp() [][]key.Binding { return k.full }
+
+func pinBindings(pairs ...string) []key.Binding {
+	var out []key.Binding
+	for i := 0; i+1 < len(pairs); i += 2 {
+		out = append(out, key.NewBinding(key.WithKeys("x"), key.WithHelp(pairs[i], pairs[i+1])))
+	}
+	return out
+}
+
+// bubbles/57: when the next item does not fit and there is no room for the
+// ellipsis either, shouldAddItem says to add the item, so the short and the
+// full help view overflow their width.
+func TestHegelPinHelpOverflowsWhenTheEllipsisDoesNotFit(t *testing.T) {
+	m := New()
+	m.SetWidth(5)
+	s := ansi.Strip(m.ShortHelpView(pinBindings("a", "b", "c", "d", "e", "f")))
+	f := ansi.Strip(m.FullHelpView([][]key.Binding{pinBindings("a", "b"), pinBindings("c", "d"), pinBindings("e", "f")}))
+	if ansi.StringWidth(s) > 5 || ansi.StringWidth(f) > 5 {
+		t.Fatalf("width 5: ShortHelpView %q (%d wide), FullHelpView %q (%d wide)", s, ansi.StringWidth(s), f, ansi.StringWidth(f))
+	}
+}
+
+// bubbles/58: the ellipsis is only used when totalWidth + its width is
+// strictly less than the width, so an ellipsis that would end exactly at the
+// width is dropped and (by bubbles/57) the item is added instead.
+func TestHegelPinHelpEllipsisFittingExactlyIsDropped(t *testing.T) {
+	m := New()
+	m.SetWidth(11)
+	s := ansi.Strip(m.ShortHelpView(pinBindings("a", "b", "c", "d", "e", "f")))
+	if s != "a b • c d …" {
+		t.Fatalf("width 11: ShortHelpView %q (%d wide), want %q", s, ansi.StringWidth(s), "a b • c d …")
+	}
+}
diff --git a/internal/zootest/zootest.go b/internal/zootest/zootest.go
new file mode 100644
index 0000000..12a7c99
--- /dev/null
+++ b/internal/zootest/zootest.go
@@ -0,0 +1,242 @@
+// Package zootest is the shared harness of the Hegel zoo's bubbles tests: a
+// property wrapper with a collect mode, small generators, and a parser that
+// turns a rendered view into cells with their reverse-video flag.
+package zootest
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+// Collecting is set by BUBBLES_COLLECT=1: mismatches are recorded and the
+// property goes on instead of failing at the first one.
+var Collecting = os.Getenv("BUBBLES_COLLECT") != ""
+
+type collected struct{}
+
+var (
+	mu    sync.Mutex
+	msgs  []string
+	stats = map[string]int{}
+)
+
+// Fail reports a mismatch: fatal normally, recorded in collect mode.
+func Fail(ht *hegel.T, format string, args ...any) {
+	if Collecting {
+		mu.Lock()
+		msgs = append(msgs, fmt.Sprintf(format, args...))
+		mu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+// Count bumps a statistic (the shape of a pinned bug, a generator branch).
+func Count(key string) {
+	mu.Lock()
+	stats[key]++
+	mu.Unlock()
+}
+
+// Guard turns a panic in a pin into a test failure with the panic's value.
+func Guard(t *testing.T) {
+	t.Helper()
+	if r := recover(); r != nil {
+		t.Fatalf("panic: %v", r)
+	}
+}
+
+func opts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// Property runs fn under Hegel; panics in the code under test become
+// failures (or recorded mismatches in collect mode).
+func Property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if Collecting {
+		mu.Lock()
+		msgs = nil
+		stats = map[string]int{}
+		mu.Unlock()
+		defer func() {
+			mu.Lock()
+			defer mu.Unlock()
+			keys := make([]string, 0, len(stats))
+			for k := range stats {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			var sb strings.Builder
+			for _, k := range keys {
+				fmt.Fprintf(&sb, " %s=%d", k, stats[k])
+			}
+			t.Logf("COLLECT %s: %d mismatches; stats%s", t.Name(), len(msgs), sb.String())
+			for i, m := range msgs {
+				if i == 40 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			msg := fmt.Sprintf("panic in the code under test: %v", r)
+			if Collecting {
+				mu.Lock()
+				msgs = append(msgs, msg)
+				mu.Unlock()
+				return
+			}
+			ht.Fatalf("%s", msg)
+		}()
+		fn(ht)
+	}, opts()...)
+}
+
+// N draws an integer in [lo, hi].
+func N(tc hegel.TestCase, lo, hi int) int {
+	return hegel.Draw(tc, hegel.Integers(lo, hi))
+}
+
+// Pick draws one of xs.
+func Pick[T any](tc hegel.TestCase, xs []T) T {
+	return xs[hegel.Draw(tc, hegel.Integers(0, len(xs)-1))]
+}
+
+// Chance is true pct percent of the time.
+func Chance(tc hegel.TestCase, pct int) bool {
+	return hegel.Draw(tc, hegel.Integers(0, 99)) < pct
+}
+
+// Note logs a line that Hegel shows with a failure.
+func Note(ht *hegel.T, format string, args ...any) {
+	ht.Logf(format, args...)
+}
+
+// Cell is one grapheme of a rendered view with its display width and whether
+// it was drawn in reverse video (how the bubbles' virtual cursor shows).
+type Cell struct {
+	S   string
+	W   int
+	Rev bool
+}
+
+// Cells parses a rendered line: SGR sequences set or clear reverse video,
+// other escape sequences are skipped, text is split into graphemes.
+func Cells(s string) []Cell {
+	var cells []Cell
+	rev := false
+	i := 0
+	for i < len(s) {
+		if s[i] == 0x1b && i+1 < len(s) {
+			switch s[i+1] {
+			case '[':
+				j := i + 2
+				for j < len(s) && !(s[j] >= 0x40 && s[j] <= 0x7e) {
+					j++
+				}
+				if j < len(s) && s[j] == 'm' {
+					params := s[i+2 : j]
+					if params == "" {
+						rev = false
+					}
+					for _, p := range strings.Split(params, ";") {
+						switch p {
+						case "", "0":
+							rev = false
+						case "7":
+							rev = true
+						case "27":
+							rev = false
+						}
+					}
+				}
+				i = j + 1
+				continue
+			case ']':
+				j := i + 2
+				for j < len(s) {
+					if s[j] == 0x07 {
+						j++
+						break
+					}
+					if s[j] == 0x1b && j+1 < len(s) && s[j+1] == '\\' {
+						j += 2
+						break
+					}
+					j++
+				}
+				i = j
+				continue
+			}
+		}
+		j := i
+		for j < len(s) && s[j] != 0x1b {
+			j++
+		}
+		g := uniseg.NewGraphemes(s[i:j])
+		for g.Next() {
+			cells = append(cells, Cell{S: g.Str(), W: g.Width(), Rev: rev})
+		}
+		i = j
+	}
+	return cells
+}
+
+// Plain is the text of the cells.
+func Plain(cells []Cell) string {
+	var sb strings.Builder
+	for _, c := range cells {
+		sb.WriteString(c.S)
+	}
+	return sb.String()
+}
+
+// Width is the display width of the cells.
+func Width(cells []Cell) int {
+	w := 0
+	for _, c := range cells {
+		w += c.W
+	}
+	return w
+}
+
+// String renders cells for a failure message: reversed cells in brackets.
+func String(cells []Cell) string {
+	var sb strings.Builder
+	for _, c := range cells {
+		if c.Rev {
+			sb.WriteString("[" + c.S + "]")
+		} else {
+			sb.WriteString(c.S)
+		}
+	}
+	return sb.String()
+}
