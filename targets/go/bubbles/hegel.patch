+	m := New(Root("root").Child("a", "b", "c", "d", "e", "f", "g", "h", "i", "j"), 30, 4)
+	for i := 0; i < 8; i++ {
+		m.Down()
+	}
+	m.SetNodes(Root("r\n2\n3").Child("a").Close())
+	if m.YOffset() != 0 {
