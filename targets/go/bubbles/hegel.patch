+package textinput
+
+// Hegel property tests for the textinput bubble: a single-line editor with a
+// cursor, an optional width (a horizontally scrolling window), a character
+// limit, a validator, echo modes and prefix suggestions.
+//
+// The model is a rune slice with a cursor. Every key of the default key map is
+// driven through Update; after each step Value, Position and Err must match the
+// model, and View, parsed into cells, must show the prompt, the window of the
+// value that contains the cursor (the library's own offsets are read, being
+// internal), the cursor in reverse video at the cursor's column, and the
+// padding that makes the field exactly Width+1 cells wide.
+//
+// Set BUBBLES_COLLECT=1 (and HEGEL_TEST_CASES=n) to collect mismatches.
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+	"unicode"
+
+	"charm.land/bubbles/v2/internal/zootest"
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/rivo/uniseg"
+	"hegel.dev/go/hegel"
+)
+
+var (
+	property = zootest.Property
+	fail     = zootest.Fail
+	count    = zootest.Count
+	guard    = zootest.Guard
+	n        = zootest.N
+	chance   = zootest.Chance
+	note     = zootest.Note
+)
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return zootest.Pick(tc, xs) }
+
+// ---------------------------------------------------------------- keys
+
+func keyOf(code rune, mod tea.KeyMod) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: code, Mod: mod}
+}
+
+func typed(r rune) tea.KeyPressMsg {
+	return tea.KeyPressMsg{Code: r, Text: string(r)}
+}
+
+var (
+	kLeft        = keyOf(tea.KeyLeft, 0)
+	kRight       = keyOf(tea.KeyRight, 0)
+	kHome        = keyOf(tea.KeyHome, 0)
+	kEnd         = keyOf(tea.KeyEnd, 0)
+	kBackspace   = keyOf(tea.KeyBackspace, 0)
+	kDelete      = keyOf(tea.KeyDelete, 0)
+	kDelWordBack = keyOf('w', tea.ModCtrl)
+	kDelWordFwd  = keyOf('d', tea.ModAlt)
+	kKill        = keyOf('k', tea.ModCtrl)
+	kKillBack    = keyOf('u', tea.ModCtrl)
+	kWordBack    = keyOf('b', tea.ModAlt)
+	kWordFwd     = keyOf('f', tea.ModAlt)
+	kTab         = keyOf(tea.KeyTab, 0)
+	kUp          = keyOf(tea.KeyUp, 0)
+	kDown        = keyOf(tea.KeyDown, 0)
+)
+
+func press(m Model, k tea.Msg) Model {
+	m2, _ := m.Update(k)
+	return m2
+}
+
+// ---------------------------------------------------------------- generators
+
+func genRune(tc hegel.TestCase) rune {
+	switch {
+	case chance(tc, 50):
+		return rune('a' + n(tc, 0, 25))
+	case chance(tc, 30):
+		return ' '
+	case chance(tc, 30):
+		return pick(tc, []rune("日本語漢字"))
+	case chance(tc, 40):
+		return rune('A' + n(tc, 0, 25))
+	case chance(tc, 50):
+		return pick(tc, []rune("0123456789.,-_/"))
+	default:
+		return pick(tc, []rune("éüñ"))
+	}
+}
+
+func genRunes(tc hegel.TestCase, lo, hi int) []rune {
+	k := n(tc, lo, hi)
+	rs := make([]rune, k)
+	for i := range rs {
+		rs[i] = genRune(tc)
+	}
+	return rs
+}
+
+// genPaste draws text as a paste would bring it: with tabs and newlines.
+func genPaste(tc hegel.TestCase) string {
+	rs := genRunes(tc, 0, 8)
+	for i := range rs {
+		if chance(tc, 10) {
+			rs[i] = pick(tc, []rune{'\t', '\n', '\r'})
+		}
+	}
+	return string(rs)
+}
+
+var (
+	errTooLong  = errors.New("too long")
+	errRequired = errors.New("required")
+)
+
+func genValidate(tc hegel.TestCase) (ValidateFunc, string) {
+	switch n(tc, 0, 2) {
+	case 0:
+		return nil, "none"
+	case 1:
+		k := n(tc, 1, 6)
+		return func(s string) error {
+			if len([]rune(s)) > k {
+				return errTooLong
+			}
+			return nil
+		}, fmt.Sprintf("max %d", k)
+	default:
+		return func(s string) error {
+			if s == "" {
+				return errRequired
+			}
+			return nil
+		}, "required"
+	}
+}
+
+func errString(err error) string {
+	if err == nil {
+		return "<nil>"
+	}
+	return err.Error()
+}
+
+// ---------------------------------------------------------------- the model
+
+type editModel struct {
+	value    []rune
+	pos      int
+	limit    int
+	err      error
+	validate ValidateFunc
+	echo     EchoMode
+}
+
+// sanitize is what the input sanitizer does: tabs and newline characters
+// become single spaces, one each.
+func sanitize(rs []rune) []rune {
+	out := make([]rune, 0, len(rs))
+	for _, r := range rs {
+		if r == '\t' || r == '\n' || r == '\r' {
+			r = ' '
+		}
+		out = append(out, r)
+	}
+	return out
+}
+
+func (e *editModel) check(v []rune) error {
+	if e.validate != nil {
+		return e.validate(string(v))
+	}
+	return nil
+}
+
+func (e *editModel) setValue(s string) {
+	rs := sanitize([]rune(s))
+	e.err = e.check(rs)
+	empty := len(e.value) == 0
+	if e.limit > 0 && len(rs) > e.limit {
+		rs = rs[:e.limit]
+	}
+	e.value = rs
+	if (e.pos == 0 && empty) || e.pos > len(e.value) {
+		e.pos = len(e.value)
+	}
+}
+
+func (e *editModel) insert(rs []rune) {
+	rs = sanitize(rs)
+	if e.limit > 0 {
+		avail := e.limit - len(e.value)
+		if avail <= 0 {
+			return
+		}
+		if len(rs) > avail {
+			rs = rs[:avail]
+		}
+	}
+	v := make([]rune, 0, len(e.value)+len(rs))
+	v = append(v, e.value[:e.pos]...)
+	v = append(v, rs...)
+	v = append(v, e.value[e.pos:]...)
+	empty := len(e.value) == 0
+	e.pos += len(rs)
+	e.err = e.check(v)
+	e.value = v
+	if (e.pos == 0 && empty) || e.pos > len(v) {
+		e.pos = len(v)
+	}
+}
+
+func (e *editModel) cut(from, to int) {
+	v := make([]rune, 0, len(e.value))
+	v = append(v, e.value[:from]...)
+	v = append(v, e.value[to:]...)
+	e.value = v
+	e.err = e.check(v)
+}
+
+func isSpace(r rune) bool { return unicode.IsSpace(r) }
+
+func (e *editModel) clamp(p int) int {
+	return max(0, min(p, len(e.value)))
+}
+
+// wordStart is where a backward word motion from pos ends: past any spaces,
+// then past the word.
+func (e *editModel) wordStart() int {
+	s := e.pos
+	for s > 0 && isSpace(e.value[s-1]) {
+		s--
+	}
+	for s > 0 && !isSpace(e.value[s-1]) {
+		s--
+	}
+	return s
+}
+
+// wordEnd is where a forward word motion from pos ends.
+func (e *editModel) wordEnd() int {
+	t := e.pos
+	for t < len(e.value) && isSpace(e.value[t]) {
+		t++
+	}
+	for t < len(e.value) && !isSpace(e.value[t]) {
+		t++
+	}
+	return t
+}
+
+// ---------------------------------------------------------------- views
+
+func echo(m Model, s string) string {
+	switch m.EchoMode {
+	case EchoPassword:
+		return strings.Repeat(string(m.EchoCharacter), uniseg.StringWidth(s))
+	case EchoNone:
+		return ""
+	}
+	return s
+}
+
+func spaces(k int) string {
+	if k <= 0 {
+		return ""
+	}
+	return strings.Repeat(" ", k)
+}
+
+// checkView compares View with the window the library keeps (offset,
+// offsetRight) around the cursor: the text, the cursor cell and the width.
+func checkView(ht *hegel.T, m Model, what string) {
+	if m.EchoMode == EchoNone {
+		return
+	}
+	value, pos, off, right := m.value, m.pos, m.offset, m.offsetRight
+	if !(0 <= off && off <= pos && pos <= right && right <= len(value)) {
+		fail(ht, "%s: window [%d,%d) does not hold the cursor %d in a value of %d runes", what, off, right, pos, len(value))
+	}
+	if m.Width() <= 0 && (off != 0 || right != len(value)) {
+		fail(ht, "%s: no width, but the window is [%d,%d) of %d runes", what, off, right, len(value))
+	}
+	cells := zootest.Cells(m.View())
+	promptW := lipgloss.Width(m.Prompt)
+	window := echo(m, string(value[off:right]))
+	cursorChar := " "
+	if pos < right {
+		cursorChar = echo(m, string(value[pos]))
+	} else if pos < len(value) {
+		// The rune under the cursor is past the window: the cursor shows as
+		// a blank at the right edge (bubbles/11).
+		count("bubbles/11-shape")
+	}
+	want := m.Prompt + window
+	if pos == right {
+		want += " "
+	}
+	shown := uniseg.StringWidth(window)
+	if pos == right {
+		shown++
+	}
+	if m.Width() > 0 {
+		pad := m.Width() + 1 - shown
+		if pad < 0 {
+			// The window is only re-fitted when the cursor crosses one of
+			// its edges: SetWidth, an insertion inside the window and
+			// ctrl+u leave it wider than the width (bubbles/7).
+			count("bubbles/7-shape")
+			pad = 0
+		}
+		want += spaces(pad)
+	}
+	if got := zootest.Plain(cells); got != want {
+		fail(ht, "%s: view text %q, want %q (window [%d,%d) cursor %d width %d)\nview %s", what, got, want, off, right, pos, m.Width(), zootest.String(cells))
+	}
+	// The cursor: one reversed run at the cursor's column.
+	col := promptW + uniseg.StringWidth(echo(m, string(value[off:pos])))
+	x, start, revW := 0, -1, 0
+	for _, c := range cells {
+		if c.Rev {
+			if start < 0 {
+				start = x
+			} else if revW != x-start {
+				fail(ht, "%s: reversed cells are not one run\nview %s", what, zootest.String(cells))
+			}
+			revW += c.W
+		}
+		x += c.W
+	}
+	if start != col || revW != uniseg.StringWidth(cursorChar) {
+		fail(ht, "%s: the cursor run is at column %d, %d wide; want column %d, %d wide (%q)\nview %s", what, start, revW, col, uniseg.StringWidth(cursorChar), cursorChar, zootest.String(cells))
+	}
+}
+
+// ---------------------------------------------------------------- properties
+
+// TestHegelEditingFollowsTheModel: every key of the default key map, pastes,
+// SetValue, SetCursor and Reset against the rune-slice model; Value, Position,
+// Err and the View after each step.
+func TestHegelEditingFollowsTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := New()
+		m.Focus()
+		m.Prompt = pick(ht, []string{"> ", "", "Name: ", "→ "})
+		if chance(ht, 60) {
+			m.SetWidth(n(ht, 1, 12))
+		}
+		e := &editModel{}
+		if chance(ht, 30) {
+			e.limit = n(ht, 1, 8)
+			m.CharLimit = e.limit
+		}
+		var vname string
+		e.validate, vname = genValidate(ht)
+		m.Validate = e.validate
+		switch {
+		case chance(ht, 20):
+			e.echo = EchoPassword
+		case chance(ht, 12):
+			e.echo = EchoNone
+		}
+		m.EchoMode = e.echo
+		if chance(ht, 70) {
+			s := string(genRunes(ht, 0, 14))
+			m.SetValue(s)
+			e.setValue(s)
+		}
+		note(ht, "prompt %q width %d limit %d validate %s echo %d value %q", m.Prompt, m.Width(), e.limit, vname, e.echo, m.Value())
+		steps := n(ht, 1, 40)
+		for i := 0; i < steps; i++ {
+			var what string
+			switch n(ht, 0, 17) {
+			case 0, 1, 2, 3, 4:
+				r := genRune(ht)
+				what = fmt.Sprintf("type %q", r)
+				m = press(m, typed(r))
+				e.insert([]rune{r})
+			case 5:
+				what = "left"
+				m = press(m, kLeft)
+				if e.pos > 0 {
+					e.pos--
+				}
+			case 6:
+				what = "right"
+				m = press(m, kRight)
+				if e.pos < len(e.value) {
+					e.pos++
+				}
+			case 7:
+				what = "backspace"
+				m = press(m, kBackspace)
+				if len(e.value) > 0 {
+					if e.pos > 0 {
+						e.cut(e.pos-1, e.pos)
+						e.pos--
+					} else {
+						e.err = e.check(e.value)
+					}
+				} else if e.check(e.value) != nil {
+					// Backspace on an empty input clears Err without asking
+					// the validator (bubbles/9).
+					count("bubbles/9-shape")
+					e.err = nil
+				} else {
+					e.err = nil
+				}
+			case 8:
+				what = "delete"
+				m = press(m, kDelete)
+				if e.pos < len(e.value) {
+					e.cut(e.pos, e.pos+1)
+				}
+			case 9:
+				what = "ctrl+w"
+				if e.pos > 0 && len(e.value) > 0 {
+					if e.echo != EchoNormal {
+						e.cut(0, e.pos)
+						e.pos = 0
+					} else {
+						s := e.wordStart()
+						if s == 1 {
+							// A word at the start of the input takes the
+							// space before it along (bubbles/10).
+							count("bubbles/10-shape")
+							s = 0
+						}
+						e.cut(s, e.pos)
+						e.pos = s
+					}
+				}
+				m = press(m, kDelWordBack)
+			case 10:
+				what = "alt+d"
+				if e.pos < len(e.value) && e.echo == EchoNormal &&
+					(e.pos+1 == len(e.value) || (!isSpace(e.value[e.pos]) && isSpace(e.value[e.pos+1]))) {
+					// deleteWordForward steps over the rune under the cursor
+					// first: on the last rune it indexes past the value and
+					// panics; on the last rune of a word it deletes the next
+					// word too (bubbles/1). Not pressed.
+					count("bubbles/1-shape")
+					continue
+				}
+				if e.pos < len(e.value) {
+					if e.echo != EchoNormal {
+						e.cut(e.pos, len(e.value))
+					} else {
+						e.cut(e.pos, e.wordEnd())
+					}
+				}
+				m = press(m, kDelWordFwd)
+			case 11:
+				what = "ctrl+k"
+				m = press(m, kKill)
+				e.cut(e.pos, len(e.value))
+			case 12:
+				what = "ctrl+u"
+				m = press(m, kKillBack)
+				e.cut(0, e.pos)
+				e.pos = 0
+			case 13:
+				what = pick(ht, []string{"home", "end", "alt+b", "alt+f"})
+				switch what {
+				case "home":
+					m = press(m, kHome)
+					e.pos = 0
+				case "end":
+					m = press(m, kEnd)
+					e.pos = len(e.value)
+				case "alt+b":
+					m = press(m, kWordBack)
+					if e.pos > 0 && len(e.value) > 0 {
+						if e.echo != EchoNormal {
+							e.pos = 0
+						} else {
+							e.pos = e.wordStart()
+						}
+					}
+				case "alt+f":
+					m = press(m, kWordFwd)
+					if e.pos < len(e.value) {
+						if e.echo != EchoNormal {
+							e.pos = len(e.value)
+						} else {
+							e.pos = e.wordEnd()
+						}
+					}
+				}
+			case 14:
+				s := genPaste(ht)
+				what = fmt.Sprintf("paste %q", s)
+				m = press(m, tea.PasteMsg{Content: s})
+				e.insert([]rune(s))
+			case 15:
+				s := string(genRunes(ht, 0, 14))
+				what = fmt.Sprintf("SetValue(%q)", s)
+				m.SetValue(s)
+				e.setValue(s)
+			case 16:
+				p := n(ht, -1, 16)
+				what = fmt.Sprintf("SetCursor(%d)", p)
+				m.SetCursor(p)
+				e.pos = e.clamp(p)
+			default:
+				what = "Reset"
+				m.Reset()
+				e.value = nil
+				e.pos = 0
+			}
+			note(ht, "%s -> %q pos %d", what, m.Value(), m.Position())
+			if m.Value() != string(e.value) {
+				fail(ht, "after %s: value %q, want %q", what, m.Value(), string(e.value))
+			}
+			if m.Position() != e.pos {
+				fail(ht, "after %s: cursor at %d, want %d (value %q)", what, m.Position(), e.pos, m.Value())
+			}
+			if errString(m.Err) != errString(e.err) {
+				fail(ht, "after %s: Err %v, want %v (value %q, validator %s)", what, m.Err, e.err, m.Value(), vname)
+			}
+			checkView(ht, m, "after "+what)
+		}
+	})
+}
+
+// TestHegelPlaceholderFillsTheField: with no value the field shows the
+// placeholder, cut to the width and padded to width+1, cursor on its first
+// cell.
+func TestHegelPlaceholderFillsTheField(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := New()
+		if chance(ht, 50) {
+			m.Focus()
+		}
+		m.Prompt = pick(ht, []string{"> ", "", "Name: "})
+		ascii := chance(ht, 60)
+		var rs []rune
+		for k := n(ht, 1, 20); k > 0; k-- {
+			if ascii {
+				rs = append(rs, pick(ht, []rune("abcdefghij .,")))
+			} else {
+				rs = append(rs, genRune(ht))
+			}
+		}
+		m.Placeholder = string(rs)
+		width := n(ht, -1, 24)
+		if width >= 0 {
+			m.SetWidth(width)
+		}
+		note(ht, "placeholder %q width %d", m.Placeholder, width)
+		if width < 0 {
+			count("bubbles/4-shape") // View panics on a negative width
+			return
+		}
+		if width == 0 {
+			count("bubbles/2-shape") // the placeholder is cut to one rune
+			return
+		}
+		if !ascii {
+			count("bubbles/3-shape") // runes sliced by display width
+			return
+		}
+		cells := zootest.Cells(m.View())
+		promptW := lipgloss.Width(m.Prompt)
+		// The field is width+1 cells: the cursor cell and width more.
+		text := string(rs)
+		if len(rs) > width+1 {
+			text = string(rs[:width+1])
+		}
+		want := m.Prompt + text + spaces(width+1-len([]rune(text)))
+		if got := zootest.Plain(cells); got != want {
+			fail(ht, "placeholder view %q, want %q\n%s", got, want, zootest.String(cells))
+		}
+		if strings.Contains(zootest.Plain(cells), "\x00") {
+			fail(ht, "placeholder view contains NUL: %q", zootest.Plain(cells))
+		}
+		for i, c := range cells {
+			if c.Rev != (m.Focused() && i == promptW) {
+				fail(ht, "the cursor is not exactly on the first placeholder cell (focused %v)\n%s", m.Focused(), zootest.String(cells))
+			}
+		}
+	})
+}
+
+// suggestion model
+type sugModel struct {
+	value   string
+	sugs    []string
+	matched []string
+	idx     int
+}
+
+func (s *sugModel) update() {
+	if s.value == "" || len(s.sugs) == 0 {
+		// Nothing matches an empty value; the index is left as it was
+		// (it is reset the next time the matches change).
+		s.matched = nil
+		return
+	}
+	var matched []string
+	for _, x := range s.sugs {
+		if strings.HasPrefix(strings.ToLower(x), strings.ToLower(s.value)) {
+			matched = append(matched, x)
+		}
+	}
+	if !equalStrings(matched, s.matched) {
+		s.idx = 0
+	}
+	s.matched = matched
+}
+
+func equalStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// TestHegelSuggestionsFollowThePrefix: the matched suggestions are those
+// with the value as a case-insensitive prefix; up/down cycle, tab completes,
+// the view shows the completion after the cursor.
+func TestHegelSuggestionsFollowThePrefix(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := New()
+		m.Focus()
+		m.ShowSuggestions = true
+		alphabet := []rune("abAB ")
+		s := &sugModel{}
+		for k := n(ht, 0, 5); k > 0; k-- {
+			var w []rune
+			for j := n(ht, 1, 5); j > 0; j-- {
+				w = append(w, pick(ht, alphabet))
+			}
+			s.sugs = append(s.sugs, string(w))
+		}
+		m.SetSuggestions(s.sugs)
+		note(ht, "suggestions %q", s.sugs)
+		if got := m.AvailableSuggestions(); !equalStrings(got, s.sugs) {
+			fail(ht, "AvailableSuggestions %q, want %q", got, s.sugs)
+		}
+		for i := n(ht, 1, 25); i > 0; i-- {
+			var what string
+			switch n(ht, 0, 9) {
+			case 0, 1, 2, 3:
+				r := pick(ht, alphabet)
+				what = fmt.Sprintf("type %q", r)
+				m = press(m, typed(r))
+				s.value += string(r)
+				s.update()
+			case 4:
+				what = "backspace"
+				m = press(m, kBackspace)
+				if rs := []rune(s.value); len(rs) > 0 {
+					s.value = string(rs[:len(rs)-1])
+				}
+				s.update()
+			case 5:
+				what = "down"
+				m = press(m, kDown)
+				s.idx++
+				if s.idx >= len(s.matched) {
+					s.idx = 0
+				}
+				s.update()
+			case 6:
+				what = "up"
+				if len(s.matched) == 0 {
+					// previousSuggestion goes to -1 with nothing matched
+					// and CurrentSuggestion then panics (bubbles/6).
+					count("bubbles/6-shape")
+					continue
+				}
+				m = press(m, kUp)
+				s.idx--
+				if s.idx < 0 {
+					s.idx = len(s.matched) - 1
+				}
+				s.update()
+			case 7, 8:
+				what = "tab"
+				m = press(m, kTab)
+				if len(s.matched) > 0 {
+					// The typed prefix keeps its case; the suggestion's
+					// remainder is appended.
+					s.value += string([]rune(s.matched[s.idx])[len([]rune(s.value)):])
+				}
+				s.update()
+			default:
+				// SetValue and Reset leave the matched suggestions where
+				// they were (bubbles/5): the sequence ends here.
+				count("bubbles/5-shape")
+				return
+			}
+			note(ht, "%s -> %q matched %q idx %d", what, m.Value(), m.MatchedSuggestions(), m.CurrentSuggestionIndex())
+			if m.Value() != s.value {
+				fail(ht, "after %s: value %q, want %q", what, m.Value(), s.value)
+			}
+			if got := m.MatchedSuggestions(); !equalStrings(got, s.matched) {
+				fail(ht, "after %s: matched %q, want %q (value %q of %q)", what, got, s.matched, s.value, s.sugs)
+			}
+			if m.CurrentSuggestionIndex() != s.idx {
+				fail(ht, "after %s: suggestion index %d, want %d (matched %q)", what, m.CurrentSuggestionIndex(), s.idx, s.matched)
+			}
+			wantCur := ""
+			if s.idx < len(s.matched) {
+				wantCur = s.matched[s.idx]
+			}
+			if got := m.CurrentSuggestion(); got != wantCur {
+				fail(ht, "after %s: CurrentSuggestion %q, want %q", what, got, wantCur)
+			}
+			// The view: value, then the rest of the current suggestion.
+			plain := zootest.Plain(zootest.Cells(m.View()))
+			want := m.Prompt + s.value
+			if len(s.matched) > 0 && len([]rune(wantCur)) > len([]rune(s.value)) {
+				want += string([]rune(wantCur)[len([]rune(s.value)):])
+			} else {
+				want += " "
+			}
+			if plain != want {
+				fail(ht, "after %s: view %q, want %q (matched %q idx %d)", what, plain, want, s.matched, s.idx)
+			}
+		}
+	})
+}
+
+// TestHegelRealCursorSitsUnderTheVirtualOne: with the virtual cursor off,
+// Cursor() reports the column where View draws the cursor.
+func TestHegelRealCursorSitsUnderTheVirtualOne(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		m := New()
+		m.Focus()
+		m.Prompt = pick(ht, []string{"> ", "", "Name: "})
+		if chance(ht, 70) {
+			m.SetWidth(n(ht, 1, 10))
+		}
+		m.SetValue(string(genRunes(ht, 0, 14)))
+		for i := n(ht, 0, 4); i > 0; i-- {
+			m.SetCursor(n(ht, 0, len(m.value)))
+		}
+		note(ht, "width %d value %q pos %d window [%d,%d)", m.Width(), m.Value(), m.pos, m.offset, m.offsetRight)
+		checkView(ht, m, "virtual cursor")
+		want := lipgloss.Width(m.Prompt) + uniseg.StringWidth(string(m.value[m.offset:m.pos]))
+		m.SetVirtualCursor(false)
+		c := m.Cursor()
+		if c == nil {
+			fail(ht, "Cursor() is nil for a focused input without a virtual cursor")
+		}
+		if c.Position.Y != 0 {
+			fail(ht, "Cursor() row %d, want 0", c.Position.Y)
+		}
+		if c.Position.X != want {
+			if m.offset > 0 || uniseg.StringWidth(string(m.value[:m.pos])) != m.pos {
+				// Cursor() adds the rune index to the prompt width: wrong
+				// once the window has scrolled or a wide rune precedes the
+				// cursor (bubbles/8).
+				count("bubbles/8-shape")
+				return
+			}
+			fail(ht, "Cursor() at column %d, want %d (value %q pos %d window [%d,%d) width %d)", c.Position.X, want, m.Value(), m.pos, m.offset, m.offsetRight, m.Width())
+		}
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+// bubbles/1: deleteWordForward moves past the rune under the cursor before it
+// looks for the word: at the last rune it indexes past the value.
+func TestHegelPinDeleteWordForwardStartsOneRuneTooFar(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetValue("ab c")
+	m.SetCursor(1)
+	m = press(m, kDelWordFwd)
+	if m.Value() != "a c" {
+		t.Fatalf("alt+d at a|b c gives %q, want %q", m.Value(), "a c")
+	}
+	m = New()
+	m.Focus()
+	m.SetValue("ab")
+	m.SetCursor(1)
+	m = press(m, kDelWordFwd)
+	if m.Value() != "a" {
+		t.Fatalf("alt+d at a|b gives %q, want %q", m.Value(), "a")
+	}
+}
+
+// bubbles/2: without a width the placeholder is cut to its first rune.
+func TestHegelPinPlaceholderIsCutToOneRuneWithoutWidth(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Placeholder = "Hello"
+	if got := zootest.Plain(zootest.Cells(m.View())); got != "> Hello" {
+		t.Fatalf("View with placeholder %q and no width shows %q, want %q", m.Placeholder, got, "> Hello")
+	}
+}
+
+// bubbles/3: the placeholder is sliced by its display width as if it were a
+// rune count: NUL runes appear after wide characters, and a wide placeholder
+// overflows the width.
+func TestHegelPinPlaceholderIsSlicedByDisplayWidth(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Placeholder = "输入消息..."
+	m.SetWidth(20)
+	v := m.View()
+	if strings.Contains(v, "\x00") {
+		t.Fatalf("View with placeholder %q width 20 contains NUL runes: %q", m.Placeholder, v)
+	}
+	m.Placeholder = "输入消息"
+	m.SetWidth(3)
+	if w := lipgloss.Width(m.View()); w > 2+4 {
+		t.Fatalf("View with placeholder %q width 3 is %d cells wide, want at most %d: %q", m.Placeholder, w, 2+4, m.View())
+	}
+}
+
+// bubbles/4: a negative width (documented as ignored) with a placeholder
+// panics in View.
+func TestHegelPinNegativeWidthPlaceholderPanics(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Placeholder = "Hello"
+	m.SetWidth(-1)
+	_ = m.View()
+}
+
+// bubbles/5: SetValue and Reset keep the matched suggestions of the previous
+// value; tab then completes the wrong text, or panics when the value is
+// longer than the stale suggestion.
+func TestHegelPinSetValueKeepsStaleSuggestions(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.ShowSuggestions = true
+	m.SetSuggestions([]string{"apple"})
+	m = press(m, typed('a'))
+	m.SetValue("zzz")
+	if got := m.CurrentSuggestion(); got != "" {
+		t.Fatalf("after SetValue(%q) the current suggestion is %q, want none", "zzz", got)
+	}
+	m = press(m, kTab)
+	if m.Value() != "zzz" {
+		t.Fatalf("tab after SetValue(%q) gives %q", "zzz", m.Value())
+	}
+	m = New()
+	m.Focus()
+	m.ShowSuggestions = true
+	m.SetSuggestions([]string{"apple"})
+	m = press(m, typed('a'))
+	m.SetValue("apple pie")
+	m = press(m, kTab)
+	if m.Value() != "apple pie" {
+		t.Fatalf("tab after SetValue(%q) gives %q", "apple pie", m.Value())
+	}
+}
+
+// bubbles/6: up with no matched suggestion sets the index to -1 and
+// CurrentSuggestion panics.
+func TestHegelPinPrevSuggestionWithoutMatchesPanics(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.ShowSuggestions = true
+	m.SetSuggestions([]string{"apple"})
+	m = press(m, kUp)
+	if got := m.CurrentSuggestion(); got != "" {
+		t.Fatalf("CurrentSuggestion %q, want none", got)
+	}
+	if i := m.CurrentSuggestionIndex(); i < 0 {
+		t.Fatalf("CurrentSuggestionIndex %d", i)
+	}
+}
+
+// bubbles/7: SetWidth after the value is set does not scroll the window; the
+// whole value stays visible until the cursor crosses an edge.
+func TestHegelPinSetWidthDoesNotScrollTheView(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetValue("abcdefghij")
+	m.SetCursor(3)
+	m.SetWidth(5)
+	if w := lipgloss.Width(m.View()); w != 2+6 {
+		t.Fatalf("after SetWidth(5) the view is %d cells wide, want %d: %q", w, 2+6, m.View())
+	}
+}
+
+// bubbles/8: Cursor() places the real cursor at prompt + rune index, ignoring
+// the scrolled window and wide runes.
+func TestHegelPinRealCursorIgnoresTheScroll(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetWidth(5)
+	m.SetValue("abcdefghij")
+	m.SetCursor(5) // the window is [5,10): the cursor sits on the first visible cell
+	m.SetVirtualCursor(false)
+	if x := m.Cursor().Position.X; x != 2 {
+		t.Fatalf("Cursor() at column %d, want 2 (window [%d,%d), view %q)", x, m.offset, m.offsetRight, m.View())
+	}
+}
+
+// bubbles/9: backspace on an empty input clears Err without validating.
+func TestHegelPinBackspaceOnEmptyClearsErr(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.Validate = func(s string) error {
+		if s == "" {
+			return errRequired
+		}
+		return nil
+	}
+	m.SetValue("")
+	if m.Err == nil {
+		t.Fatalf("SetValue(\"\") did not set Err")
+	}
+	m = press(m, kBackspace)
+	if m.Err == nil {
+		t.Fatalf("backspace on the empty input cleared Err although the validator rejects \"\"")
+	}
+}
+
+// bubbles/10: ctrl+w on a word at the start of the input deletes the single
+// space before it as well.
+func TestHegelPinDeleteWordBackwardEatsTheLeadingSpace(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetValue(" ab")
+	m = press(m, kDelWordBack)
+	if m.Value() != " " {
+		t.Fatalf("ctrl+w at %q gives %q, want %q", " ab", m.Value(), " ")
+	}
+}
+
+// bubbles/11: scrolling forward, the window ends at the cursor: the rune under
+// it is not shown and the cursor is a blank at the right edge.
+func TestHegelPinForwardScrollHidesTheRuneUnderTheCursor(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetWidth(5)
+	m.SetValue("abcdefghij")
+	m.SetCursor(0)
+	for i := 0; i < 6; i++ {
+		m = press(m, kRight)
+	}
+	cells := zootest.Cells(m.View())
+	for _, c := range cells {
+		if c.Rev && c.S != "g" {
+			t.Fatalf("with the cursor on %q the view shows %s", "g", zootest.String(cells))
+		}
+	}
+}
+
+// bubbles/12: with EchoNone the padding is computed from the hidden value, so
+// the field shrinks as text is typed.
+func TestHegelPinEchoNonePadsByTheHiddenWidth(t *testing.T) {
+	defer guard(t)
+	m := New()
+	m.Focus()
+	m.SetWidth(3)
+	m.EchoMode = EchoNone
+	empty := lipgloss.Width(m.View())
+	m.SetValue("ab")
+	if w := lipgloss.Width(m.View()); w != empty {
+		t.Fatalf("EchoNone field is %d cells wide empty and %d with %q", empty, w, "ab")
+	}
+}
diff --git a/tree/hegel_test.go b/tree/hegel_test.go
new file mode 100644
index 0000000..0ed8288
--- /dev/null
+++ b/tree/hegel_test.go
@@ -0,0 +1,826 @@
+package tree
+
+// Hegel zoo: properties of the tree component against a mirror of its
+// selection, its line offsets, its viewport scroll and its rendered rows.
+//
+// Run with BUBBLES_COLLECT=1 to record mismatches instead of failing.
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	ltree "charm.land/lipgloss/v2/tree"
+	"github.com/charmbracelet/x/ansi"
+	"hegel.dev/go/hegel"
+
+	"charm.land/bubbles/v2/internal/zootest"
+)
+
+// ---------------------------------------------------------------- the model
+
+// tn mirrors one node: its value, whether it was made with Root (and so
+// carries an open/closed indicator), its open state and its children.
+type tn struct {
+	val  string
+	rows []string
+	sub  bool
+	open bool
+	kids []*tn
+	node *Node
+
+	// filled by layout
+	parent *tn
+	last   bool
+	pre    string // the ancestors' indents
+	y      int    // offset in nodes
+	line   int    // offset in rendered lines
+	shift  int    // lines the library's offset is short by (bubbles/86)
+}
+
+var words = []string{"a", "bb", "ccc", "dddd", "emacs", "zsh", "go.mod", "x", "README", "tools", "img.png", "b2", "q"}
+
+func genValue(tc hegel.TestCase) string {
+	switch {
+	case zootest.Chance(tc, 3):
+		return ""
+	case zootest.Chance(tc, 2):
+		zootest.Count("gen-wide")
+		return strings.Repeat(zootest.Pick(tc, words)+"-", zootest.N(tc, 8, 14))
+	case zootest.Chance(tc, 10):
+		n := zootest.N(tc, 2, 3)
+		rows := make([]string, n)
+		for i := range rows {
+			rows[i] = zootest.Pick(tc, words)
+		}
+		zootest.Count("gen-multiline")
+		return strings.Join(rows, "\n")
+	}
+	return zootest.Pick(tc, words)
+}
+
+func genTree(tc hegel.TestCase, depth int) *tn {
+	n := &tn{val: genValue(tc)}
+	n.rows = strings.Split(n.val, "\n")
+	if depth == 0 || zootest.Chance(tc, 45) {
+		return n // a leaf
+	}
+	n.sub = true
+	n.open = !zootest.Chance(tc, 25)
+	k := zootest.N(tc, 0, 4)
+	for i := 0; i < k; i++ {
+		n.kids = append(n.kids, genTree(tc, depth-1))
+	}
+	return n
+}
+
+// build makes the library's nodes for the mirror (and remembers them).
+func build(n *tn) *Node {
+	if !n.sub {
+		return nil // leaves are added to the parent as strings
+	}
+	root := Root(n.val)
+	for _, k := range n.kids {
+		if k.sub {
+			root.Child(build(k))
+		} else {
+			root.Child(k.val)
+		}
+	}
+	n.node = root
+	kids := root.ChildNodes()
+	for i, k := range n.kids {
+		if !k.sub {
+			k.node = kids[i]
+		}
+	}
+	if !n.open {
+		root.Close()
+	}
+	return root
+}
+
+// tm mirrors the model: the tree, the selection, the sizes and the viewport.
+type tm struct {
+	root     *tn
+	vis      []*tn
+	total    int
+	sel      int
+	w, h     int
+	vh       int // the viewport's height (h minus the help at the last SetSize)
+	vpY      int
+	so       int
+	showHelp bool
+	showAll  bool
+	sizedAll bool // ShowAll at the last SetSize
+	lastEnum string
+	openCh   string
+	closedCh string
+	cursor   string
+
+	// the content as rendered at the last updateViewport
+	rows    []string
+	wide    bool
+	renderW int
+
+	sized     bool // a resize since the last scroll fix (bubbles/78)
+	helpStale bool // the viewport was sized by the help at the old width (bubbles/89)
+	rootStale bool // the selection was clamped to the root without a scroll (bubbles/90)
+}
+
+func (s *tm) layout() {
+	s.vis = s.vis[:0]
+	s.total = 0
+	s.walk(s.root, nil, false, "", 0)
+}
+
+func (s *tm) walk(n *tn, parent *tn, last bool, pre string, shift int) {
+	n.parent, n.last, n.pre, n.shift = parent, last, pre, shift
+	n.y = len(s.vis)
+	n.line = s.total
+	s.vis = append(s.vis, n)
+	s.total += len(n.rows)
+	if !n.open {
+		return
+	}
+	// The library's line offsets are short by the extra rows of every
+	// multi-line ancestor (bubbles/86) and by one for every earlier sibling
+	// (of the node or of an ancestor) that is an open, empty-valued node
+	// with children, whose own rendering drops its root line (bubbles/88).
+	short := 0
+	for i, k := range n.kids {
+		kpre := pre
+		if parent != nil { // the root's children carry no indent
+			if last {
+				kpre += "   "
+			} else {
+				kpre += "│  "
+			}
+		}
+		s.walk(k, n, i == len(n.kids)-1, kpre, shift+len(n.rows)-1+short)
+		if k.sub && k.val == "" && k.open && len(k.kids) > 0 {
+			short++
+		}
+	}
+}
+
+func (s *tm) indicator(n *tn) string {
+	if !n.sub {
+		return ""
+	}
+	ch := s.closedCh
+	if n.open {
+		ch = s.openCh
+	}
+	if ch != "" {
+		ch += " "
+	}
+	return ch
+}
+
+// nodeRows are the rendered lines of one node, without the cursor column.
+func (s *tm) nodeRows(n *tn) []string {
+	ind := s.indicator(n)
+	pad := strings.Repeat(" ", ansi.StringWidth(ind))
+	var out []string
+	if n.parent == nil {
+		out = append(out, ind+n.rows[0])
+		for _, r := range n.rows[1:] {
+			out = append(out, pad+r)
+		}
+		return out
+	}
+	enum := "├──"
+	indent := "│  "
+	if n.last {
+		enum = s.lastEnum
+		indent = "   "
+	}
+	out = append(out, n.pre+enum+ind+n.rows[0])
+	for _, r := range n.rows[1:] {
+		out = append(out, n.pre+indent+pad+r)
+	}
+	return out
+}
+
+// render mirrors updateViewport's SetContent: the cursor column joined to
+// the tree's rows, and whether any row is wider than the width (bubbles/79).
+func (s *tm) render() {
+	s.rows = s.rows[:0]
+	s.wide = false
+	s.renderW = s.w
+	cw := ansi.StringWidth(s.cursor)
+	blank := strings.Repeat(" ", cw) + " "
+	for i, n := range s.vis {
+		for j, r := range s.nodeRows(n) {
+			row := r
+			if s.cursor != "" {
+				if i == s.sel && j == 0 {
+					row = s.cursor + " " + r
+				} else {
+					row = blank + r
+				}
+			}
+			if ansi.StringWidth(row) > s.w {
+				s.wide = true
+			}
+			s.rows = append(s.rows, row)
+		}
+	}
+}
+
+func (s *tm) maxY() int { return max(0, s.total-s.vh) }
+
+func (s *tm) setContent() {
+	if s.vpY > s.maxY() {
+		s.vpY = s.maxY()
+	}
+}
+
+// update mirrors Model.updateViewport(movement).
+func (s *tm) update(movement int) {
+	s.sel = max(min(len(s.vis)-1, s.sel+movement), 0)
+	s.render()
+	s.setContent()
+	if s.sel == 0 && movement == 0 {
+		// The "initial render" early return: no scroll, whatever the
+		// viewport's offset (bubbles/90 when it is past the root).
+		s.rootStale = s.vpY > 0
+		return
+	}
+	s.sized = false
+	s.rootStale = false
+	// The library scrolls by its own line offset, short by the extra
+	// rows of multi-line ancestors (bubbles/86).
+	line := s.vis[s.sel].line - s.vis[s.sel].shift
+	height := max(0, min(s.vh, s.total-s.vpY)) // VisibleLineCount
+	if s.vh <= 0 {
+		height = 0
+	}
+	so := min(s.so, height/2)
+	minTop := max(line-so, 0)
+	minBottom := min(s.total-1, line+so)
+	if s.vpY > minTop {
+		s.vpY = min(max(minTop, 0), s.maxY())
+	} else if s.vpY+height < minBottom+1 {
+		s.vpY = min(max(minBottom-height+1, 0), s.maxY())
+	}
+}
+
+// setSize mirrors SetSize; before is the help's height as it was before the
+// call (SetSize measures it before giving the help its new width, bubbles/89).
+func (s *tm) setSize(m *Model, w, h int, before int) {
+	s.w, s.h = w, h
+	hv, now := 0, 0
+	if s.showHelp {
+		hv = before
+		now = lipgloss.Height(m.helpView())
+	}
+	s.vh = h - hv
+	s.helpStale = hv != now
+	s.sizedAll = s.showAll
+	s.sized = true
+}
+
+// helpHeight is the help view's height as the library measures it now.
+func helpHeight(m *Model) int { return lipgloss.Height(m.helpView()) }
+
+func (s *tm) toggle(open bool) {
+	n := s.vis[s.sel]
+	n.open = open
+	s.layout()
+	s.update(0)
+}
+
+// ---------------------------------------------------------------- keys
+
+func keyOf(tc hegel.TestCase, op string) tea.KeyPressMsg {
+	pick := func(ks ...tea.KeyPressMsg) tea.KeyPressMsg { return zootest.Pick(tc, ks) }
+	ch := func(r rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: r, Text: string(r)} }
+	ctrl := func(r rune) tea.KeyPressMsg { return tea.KeyPressMsg{Code: r, Mod: tea.ModCtrl} }
+	switch op {
+	case "down":
+		return pick(tea.KeyPressMsg{Code: tea.KeyDown}, ch('j'), ctrl('n'))
+	case "up":
+		return pick(tea.KeyPressMsg{Code: tea.KeyUp}, ch('k'), ctrl('p'))
+	case "pgdown":
+		return pick(tea.KeyPressMsg{Code: tea.KeyPgDown}, tea.KeyPressMsg{Code: tea.KeySpace, Text: " "}, ch('f'))
+	case "pgup":
+		return pick(tea.KeyPressMsg{Code: tea.KeyPgUp}, ch('b'))
+	case "halfdown":
+		return pick(ch('d'), ctrl('d'))
+	case "halfup":
+		return pick(ch('u'), ctrl('u'))
+	case "top":
+		return pick(ch('g'), tea.KeyPressMsg{Code: tea.KeyHome})
+	case "bottom":
+		return pick(ch('G'), tea.KeyPressMsg{Code: tea.KeyEnd})
+	case "toggle":
+		return tea.KeyPressMsg{Code: tea.KeyEnter}
+	case "open":
+		return pick(ch('l'), tea.KeyPressMsg{Code: tea.KeyRight})
+	case "close":
+		return pick(ch('h'), tea.KeyPressMsg{Code: tea.KeyLeft})
+	case "help":
+		return ch('?')
+	}
+	panic(op)
+}
+
+var treeOps = []string{
+	"down", "down", "down", "down", "down", "down", "down", "down",
+	"up", "up", "up", "up", "up", "up",
+	"pgdown", "pgdown", "pgdown", "pgup", "pgup", "pgup",
+	"halfdown", "halfdown", "halfup", "halfup",
+	"top", "top", "bottom", "bottom",
+	"toggle", "toggle", "toggle", "toggle", "toggle", "toggle",
+	"open", "open", "open", "close", "close", "close",
+	"help", "help",
+	"setyoffset", "setyoffset",
+	"setsize", "setsize", "setsize", "setheight", "setheight", "setwidth",
+	"setscrolloff", "setscrolloff", "setshowhelp", "setshowhelp",
+	"setnodes", "setcursor",
+}
+
+// ---------------------------------------------------------------- property
+
+func TestHegelTreeFollowsTheModel(t *testing.T) {
+	zootest.Property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		s := &tm{lastEnum: "└──", openCh: "▼", closedCh: "▶", cursor: "→", so: 5, showHelp: true}
+
+		// The tree: always a Root at the top.
+		s.root = genTree(tc, 3)
+		s.root.sub = true
+		s.root.open = !zootest.Chance(tc, 10)
+		if len(s.root.kids) == 0 {
+			s.root.kids = append(s.root.kids, genTree(tc, 2))
+		}
+		root := build(s.root)
+
+		w := zootest.N(tc, 24, 60)
+		if zootest.Chance(tc, 3) {
+			w = zootest.N(tc, 6, 23)
+		}
+		h := zootest.N(tc, 3, 18)
+		if zootest.Chance(tc, 5) {
+			h = zootest.N(tc, 0, 2)
+		}
+		m := New(root, w, h)
+		if zootest.Chance(tc, 40) {
+			s.so = zootest.N(tc, 0, 8)
+			m.SetScrollOff(s.so)
+		}
+		if zootest.Chance(tc, 20) {
+			s.showHelp = false
+			m.SetShowHelp(false)
+		}
+		switch {
+		case zootest.Chance(tc, 10):
+			s.cursor = ""
+			m.SetCursorCharacter("")
+		case zootest.Chance(tc, 10):
+			s.cursor = "👉"
+			m.SetCursorCharacter("👉")
+		}
+		switch {
+		case zootest.Chance(tc, 10):
+			s.openCh, s.closedCh = "-", "+"
+			m.SetOpenCharacter("-")
+			m.SetClosedCharacter("+")
+		case zootest.Chance(tc, 5):
+			s.openCh, s.closedCh = "", ""
+			m.SetOpenCharacter("")
+			m.SetClosedCharacter("")
+		}
+		if zootest.Chance(tc, 20) {
+			s.lastEnum = "╰──"
+			m.Enumerator(ltree.RoundedEnumerator)
+		}
+		hb := helpHeight(&m)
+		m.SetSize(w, h)
+		s.setSize(&m, w, h, hb)
+		m.SetNodes(root) // renders with every option applied
+		s.layout()
+		s.update(0)
+
+		var trail []string
+		nops := zootest.N(tc, 1, 45)
+		for step := 0; step < nops; step++ {
+			op := zootest.Pick(tc, treeOps)
+			desc := op
+			switch op {
+			case "down", "up", "pgdown", "pgup", "halfdown", "halfup", "top", "bottom", "toggle", "open", "close", "help":
+				k := keyOf(tc, op)
+				desc = fmt.Sprintf("%s(%s)", op, k.String())
+				var cmd tea.Cmd
+				m, cmd = m.Update(k)
+				if cmd != nil {
+					if msg := cmd(); msg != nil {
+						m, _ = m.Update(msg)
+					}
+				}
+				switch op {
+				case "down":
+					s.update(1)
+				case "up":
+					s.update(-1)
+				case "pgdown":
+					if k.Code == tea.KeySpace {
+						zootest.Count("bubbles/87") // bound as " ", reported as "space"
+					} else {
+						s.update(s.vh)
+					}
+				case "pgup":
+					s.update(-s.vh)
+				case "halfdown":
+					s.update(s.vh / 2)
+				case "halfup":
+					s.update(-s.vh / 2)
+				case "top":
+					s.update(-s.sel)
+				case "bottom":
+					s.update(len(s.vis))
+				case "toggle":
+					s.toggle(!s.vis[s.sel].open)
+				case "open":
+					s.toggle(true)
+				case "close":
+					s.toggle(false)
+				case "help":
+					s.showAll = !s.showAll
+				}
+			case "setyoffset":
+				y := zootest.N(tc, -1, len(s.vis)+1)
+				desc = fmt.Sprintf("setyoffset(%d)", y)
+				m.SetYOffset(y)
+				s.update(y - s.sel)
+			case "setsize", "setheight", "setwidth":
+				nw, nh := s.w, s.h
+				if op != "setheight" {
+					nw = zootest.N(tc, 24, 60)
+					if zootest.Chance(tc, 10) {
+						nw = zootest.N(tc, 6, 23)
+					}
+				}
+				if op != "setwidth" {
+					nh = zootest.N(tc, 3, 18)
+					if zootest.Chance(tc, 10) {
+						nh = zootest.N(tc, 0, 2)
+					}
+				}
+				desc = fmt.Sprintf("%s(%d,%d)", op, nw, nh)
+				hb := helpHeight(&m)
+				switch op {
+				case "setsize":
+					m.SetSize(nw, nh)
+				case "setheight":
+					m.SetHeight(nh)
+				case "setwidth":
+					m.SetWidth(nw)
+				}
+				s.setSize(&m, nw, nh, hb)
+			case "setscrolloff":
+				s.so = zootest.N(tc, 0, 8)
+				desc = fmt.Sprintf("setscrolloff(%d)", s.so)
+				m.SetScrollOff(s.so)
+			case "setshowhelp":
+				s.showHelp = zootest.Chance(tc, 50)
+				desc = fmt.Sprintf("setshowhelp(%v)", s.showHelp)
+				hb := helpHeight(&m)
+				m.SetShowHelp(s.showHelp)
+				s.setSize(&m, s.w, s.h, hb)
+			case "setnodes":
+				s.root = genTree(tc, 3)
+				s.root.sub = true
+				s.root.open = !zootest.Chance(tc, 10)
+				root = build(s.root)
+				m.SetNodes(root)
+				s.layout()
+				s.update(0)
+			case "setcursor":
+				s.cursor = zootest.Pick(tc, []string{"→", ">", "", "👉", "»"})
+				desc = fmt.Sprintf("setcursor(%q)", s.cursor)
+				m.SetCursorCharacter(s.cursor)
+				hb := helpHeight(&m)
+				m.SetSize(s.w, s.h)
+				s.setSize(&m, s.w, s.h, hb)
+			}
+			trail = append(trail, desc)
+			ctx := func() string {
+				return fmt.Sprintf("after %v\nsel=%d of %d, total=%d lines, vpY=%d, w=%d h=%d vh=%d so=%d help=%v/%v cursor=%q",
+					trail, s.sel, len(s.vis), s.total, s.vpY, s.w, s.h, s.vh, s.so, s.showHelp, s.showAll, s.cursor)
+			}
+
+			// The selection and the offsets.
+			if m.YOffset() != s.sel {
+				zootest.Fail(ht, "YOffset %d, want %d\n%s", m.YOffset(), s.sel, ctx())
+			}
+			if m.Root().Size() != len(s.vis) {
+				zootest.Fail(ht, "Size %d, want %d\n%s", m.Root().Size(), len(s.vis), ctx())
+			}
+			if m.NodeAtCurrentOffset() != s.vis[s.sel].node {
+				zootest.Fail(ht, "NodeAtCurrentOffset is %v, want %q\n%s", m.NodeAtCurrentOffset().GivenValue(), s.vis[s.sel].val, ctx())
+			}
+			for i, n := range s.vis {
+				if n.node.YOffset() != i {
+					zootest.Fail(ht, "node %q at y=%d, want y=%d\n%s", n.val, n.node.YOffset(), i, ctx())
+				}
+				if n.shift > 0 {
+					zootest.Count("bubbles/86")
+				} else if n.node.LineOffset() != n.line {
+					zootest.Fail(ht, "node %q at line=%d, want line=%d\n%s", n.val, n.node.LineOffset(), n.line, ctx())
+				}
+				if n.node.IsSelected() != (i == s.sel) {
+					zootest.Fail(ht, "node %q IsSelected %v at y=%d (selected %d)\n%s", n.val, n.node.IsSelected(), i, s.sel, ctx())
+				}
+				if m.Node(i) != n.node {
+					zootest.Fail(ht, "Node(%d) is not %q\n%s", i, n.val, ctx())
+				}
+			}
+			if m.Node(len(s.vis)) != nil {
+				zootest.Fail(ht, "Node(%d) past the end is %v\n%s", len(s.vis), m.Node(len(s.vis)).GivenValue(), ctx())
+			}
+			if m.Width() != s.w || m.Height() != s.h {
+				zootest.Fail(ht, "size %dx%d, want %dx%d\n%s", m.Width(), m.Height(), s.w, s.h, ctx())
+			}
+			if m.viewport.Height() != s.vh {
+				zootest.Fail(ht, "viewport height %d, want %d\n%s", m.viewport.Height(), s.vh, ctx())
+			}
+			if s.wide {
+				// A row wider than the width is wrapped by the tree style,
+				// so the content has more lines than the model: the scroll
+				// is the library's while that lasts (bubbles/79).
+				zootest.Count("bubbles/79")
+				s.vpY = m.ViewportYOffset()
+				continue
+			}
+			if m.ViewportYOffset() != s.vpY {
+				zootest.Fail(ht, "viewport YOffset %d, want %d\n%s", m.ViewportYOffset(), s.vpY, ctx())
+			}
+
+			// The selection is in view (bubbles/78 after a resize).
+			if s.vh >= 1 {
+				line := s.vis[s.sel].line
+				if line < s.vpY || line >= s.vpY+s.vh {
+					if s.sized {
+						zootest.Count("bubbles/78")
+					} else if s.rootStale {
+						zootest.Count("bubbles/90")
+					} else if s.vis[s.sel].shift > 0 {
+						zootest.Count("bubbles/86")
+					} else {
+						zootest.Fail(ht, "selected line %d outside the window [%d,%d)\n%s", line, s.vpY, s.vpY+s.vh, ctx())
+					}
+				}
+			}
+
+			// The view.
+			if s.vis[s.sel].shift > 0 {
+				zootest.Count("bubbles/86") // the cursor is drawn on the library's line
+				continue
+			}
+			view := strings.Split(ansi.Strip(m.View()), "\n")
+			hv := 0
+			if s.showHelp {
+				hv = lipgloss.Height(m.helpView())
+			}
+			want := max(s.vh, 1) + hv
+			if len(view) != want {
+				zootest.Fail(ht, "view has %d lines, want %d\n%s\n%s", len(view), want, ctx(), strings.Join(view, "\n"))
+			}
+			if s.vh >= 1 && want != s.h {
+				if s.showAll != s.sizedAll {
+					zootest.Count("bubbles/77")
+				} else if s.helpStale {
+					zootest.Count("bubbles/89")
+				} else {
+					zootest.Fail(ht, "view has %d lines for a height of %d\n%s", want, s.h, ctx())
+				}
+			}
+			if s.vh >= 1 && s.w >= 1 {
+				for i := 0; i < s.vh; i++ {
+					exp := ""
+					if idx := s.vpY + i; idx < len(s.rows) {
+						exp = s.rows[idx]
+					}
+					exp = strings.TrimRight(ansi.Truncate(exp, s.w, ""), " ")
+					got := strings.TrimRight(view[i], " ")
+					if got != exp {
+						zootest.Fail(ht, "row %d is %q, want %q\n%s\n%s", i, got, exp, ctx(), strings.Join(view, "\n"))
+					}
+				}
+			}
+		}
+	})
+}
+
+// ---------------------------------------------------------------- pins
+
+func pinTree(children ...any) Model {
+	return New(Root("root").Child(children...), 30, 8)
+}
+
+// cursorRow is the stripped view row carrying the cursor, or "".
+func cursorRow(m Model) string {
+	for _, l := range strings.Split(ansi.Strip(m.View()), "\n") {
+		if strings.HasPrefix(l, "→") {
+			return l
+		}
+	}
+	return ""
+}
