+// yaml/10
+func TestHegelPointerToNodeTargetsReceiveTheNode(t *testing.T) {
+	type P struct {
+		NP *Node `yaml:"np"`
+	}
+	for _, c := range []struct {
+		doc  string
+		kind Kind
+	}{{"np: 0\n", ScalarNode}, {"np: x\n", ScalarNode}, {"np: [1]\n", SequenceNode}, {"np: {a: 1}\n", MappingNode}} {
+		var p P
+		if err := Load([]byte(c.doc), &p); err != nil {
+			t.Errorf("Load(%q) into a struct with a *Node field: %v", c.doc, err)
+			continue
+		}
+		if p.NP == nil || p.NP.Kind != c.kind {
+			t.Errorf("Load(%q) into a struct with a *Node field: got %+v, want a %v node", c.doc, p.NP, c.kind)
+		}
+	}
+	// the encoder's own output
+	in := P{NP: &Node{Kind: ScalarNode, Tag: "!!int", Value: "7"}}
+	doc := mustDump(t, &in)
+	var back P
+	if err := Load(doc, &back); err != nil {
+		t.Errorf("Dump(%+v) = %q; Load: %v", in.NP, doc, err)
+	} else if back.NP == nil || back.NP.Value != "7" {
+		t.Errorf("Dump(%+v) = %q; Load gives %+v", in.NP, doc, back.NP)
+	}
+	var m map[string]*Node
+	if err := Load([]byte("a: 0\nb: [1]\n"), &m); err != nil {
+		t.Errorf("Load into map[string]*Node: %v", err)
+	}
+	var s []*Node
+	if err := Load([]byte("- 0\n- x\n"), &s); err != nil {
+		t.Errorf("Load into []*Node: %v", err)
+	}
+	// a Node value receives everything
+	type V struct {
+		ND Node `yaml:"nd"`
+	}
+	var v V
+	if err := Load([]byte("nd: 0\n"), &v); err != nil || v.ND.Kind != ScalarNode || v.ND.Value != "0" {
+		t.Errorf("Load(nd: 0) into a struct with a Node field: %+v, %v", v.ND, err)
+	}
+}
