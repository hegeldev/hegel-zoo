+// yaml/8
+func TestHegelTimestampsTheEncoderWritesAreReadable(t *testing.T) {
+	for _, tm := range []time.Time{time.Date(10000, 1, 1, 0, 0, 0, 0, time.UTC), time.Date(12345, 6, 7, 8, 9, 10, 0, time.UTC), time.Date(0, 1, 1, 0, 0, 0, 0, time.UTC), time.Date(-1, 1, 1, 0, 0, 0, 0, time.UTC)} {
+		in := map[string]any{"t": tm}
+		doc, err := Dump(in)
+		if err != nil {
+			continue // refusing to write an unrepresentable time is fine
+		}
+		var got map[string]time.Time
+		if err := Load(doc, &got); err != nil {
+			t.Errorf("Dump(%v) = %q without error; Load: %v", tm, doc, err)
+			continue
+		}
+		if !got["t"].Equal(tm) {
+			t.Errorf("Dump(%v) = %q; Load gives %v", tm, doc, got["t"])
+		}
+	}
+}
