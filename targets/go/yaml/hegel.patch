+// yaml/12
+func TestHegelIndentThreeWithCompactSequencesWritesReadableNestedSequences(t *testing.T) {
+	in := []any{map[string]any{"a": []any{nil}}}
+	check := func(what string, doc []byte, err error) {
+		t.Helper()
+		if err != nil {
+			t.Errorf("%s: %v", what, err)
+			return
+		}
+		got, err := loadAny(doc)
+		if err != nil {
+			t.Errorf("%s wrote %q; Load: %v", what, doc, err)
+			return
+		}
+		if !sameCanon(canon(got), canon(in)) {
+			t.Errorf("%s wrote %q; Load gives %#v", what, doc, got)
+		}
+		var v3 any
+		if err := yamlv3.Unmarshal(doc, &v3); err != nil {
+			t.Errorf("%s wrote %q; yaml.v3 rejects it: %v", what, doc, err)
+		}
+	}
+	doc, err := Dump(in, WithIndent(3))
+	check("Dump(WithIndent(3))", doc, err)
+	doc, err = Dump(in, WithIndent(3), WithCompactSeqIndent(true))
+	check("Dump(WithIndent(3), WithCompactSeqIndent(true))", doc, err)
+	doc, err = Dump(in, WithV3Defaults(), WithIndent(3), WithCompactSeqIndent(true))
+	check("Dump(WithV3Defaults(), WithIndent(3), WithCompactSeqIndent(true))", doc, err)
+	var buf bytes.Buffer
+	enc := NewEncoder(&buf)
+	enc.SetIndent(3)
+	enc.CompactSeqIndent()
+	err = enc.Encode(in)
+	if err == nil {
+		err = enc.Close()
+	}
+	check("Encoder.SetIndent(3)+CompactSeqIndent", buf.Bytes(), err)
+	// the other indents are fine
+	for _, ind := range []int{2, 4, 5, 9} {
+		doc, err = Dump(in, WithIndent(ind), WithCompactSeqIndent(true))
+		check(fmt.Sprintf("Dump(WithIndent(%d), WithCompactSeqIndent(true))", ind), doc, err)
+	}
+}
