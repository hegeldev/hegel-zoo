+// yaml/15
+func TestHegelDumpLeavesTheInputNodeUnchanged(t *testing.T) {
+	for _, c := range []struct{ tag, value string }{{"!!float", "1"}, {"!!str", "1"}, {"!!str", ""}, {"!!int", "1"}, {"!!bool", "true"}, {"!!null", ""}} {
+		leaf := &Node{Kind: ScalarNode, Tag: c.tag, Value: c.value}
+		m := &Node{Kind: MappingNode, Content: []*Node{{Kind: ScalarNode, Value: "a"}, leaf}}
+		before := *leaf
+		var want any
+		if err := leaf.Decode(&want); err != nil {
+			t.Fatalf("Decode of %+v before Dump: %v", before, err)
+		}
+		doc := mustDump(t, m)
+		if leaf.Tag != before.Tag || leaf.Style != before.Style || leaf.Value != before.Value {
+			t.Errorf("Dump (%q) changed the input node from {Tag:%q Style:%v Value:%q} to {Tag:%q Style:%v Value:%q}", doc, before.Tag, before.Style, before.Value, leaf.Tag, leaf.Style, leaf.Value)
+		}
+		var after any
+		if err := leaf.Decode(&after); err != nil {
+			t.Errorf("Decode of the node after Dump: %v", err)
+		} else if fmt.Sprintf("%T %v", after, after) != fmt.Sprintf("%T %v", want, want) {
+			t.Errorf("the node from {Tag:%q Value:%q} decodes as %T %v before Dump and %T %v after", before.Tag, before.Value, want, want, after, after)
+		}
+	}
+}
