+// yaml/1
+func TestHegelCanonicalOutputKeepsScalarTypes(t *testing.T) {
+	in := map[string]any{"i": 1, "b": true, "n": nil, "f": 1.5, "s": "1"}
+	doc := mustDump(t, in, WithCanonical())
+	got, err := loadAny(doc)
+	if err != nil {
+		t.Fatalf("Dump(WithCanonical) = %q; Load: %v", doc, err)
+	}
+	m, _ := got.(map[string]any)
+	for k, want := range in {
+		if fmt.Sprintf("%T", m[k]) != fmt.Sprintf("%T", want) {
+			t.Errorf("Dump(WithCanonical) = %q; key %s read back as %T %#v, want %T %#v", doc, k, m[k], m[k], want, want)
+		}
+	}
+	if !bytes.Contains(doc, []byte("!!int")) {
+		t.Errorf("canonical output %q carries no !!int tag", doc)
+	}
+}
