+package yaml_test
+
+// Hegel properties for go.yaml.in/yaml/v4 (the Hegel zoo, targets/go/yaml).
+//
+// Oracles: go.yaml.in/yaml/v3 (the previous major version, in the same process), goccy/go-yaml
+// (an independent Go implementation, in the same process) and PyYAML with libyaml (a child
+// process) read everything v4's Dump/Marshal/Encoder writes; a value model of our own is
+// written as YAML by a writer of ours whose every spelling is drawn as data, so that v4's Load
+// can be checked against the tree a document was written from (yaml.v3 arbitrates every
+// generated document first); v4 against itself for value, struct, Node and stream round trips
+// under its dump options.
+// Generated text stays inside YAML 1.2 as all four readers understand it: no YAML 1.1 line
+// breaks (U+0085, U+2028, U+2029), no control characters, no byte order marks.
+//
+// A case is drawn as data: each property draws one record - a value tree carrying, where the
+// property needs them, the Go types the encoder is handed and the YAML spellings the writer
+// uses for every node, the dump options, the framing of a document - built from the binding's
+// combinators; pure functions turn the tree into Go values (toGo) and into YAML text
+// (document), and the oracles read the record.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property().
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"os/exec"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unicode"
+
+	goccy "github.com/goccy/go-yaml"
+	yamlv3 "go.yaml.in/yaml/v3"
+	. "go.yaml.in/yaml/v4"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see HACKING.md).
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a
+// failure of the current test case (hegel-go re-raises panics after shrinking, which would
+// abort the test binary and hide every later test).  Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...interface{}) {
+	ht.Note(fmt.Sprintf(format, args...))
+}
+
+// ---------------------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what
+// it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+func ptrTo[T any](x T) *T { return &x }
+
+// ptrs: pointers to the values of g.
+func ptrs[T any](g hegel.Generator[T]) hegel.Generator[*T] { return hegel.Map(g, ptrTo[T]) }
+
+// ---------------------------------------------------------------------------------------
+// The value model: a YAML document as a tree, independent of every implementation.  A node
+// carries, when the property drew them, the Go type toGo gives it (rep) and the spellings the
+// writer uses for it (st).
+
+type val struct {
+	kind  string // null bool int uint float string seq map
+	b     bool
+	i     int64
+	u     uint64
+	f     float64
+	s     string
+	items []*val
+	kids  map[string]*val
+	keys  []string // the kids in key order, the order the writer uses
+	rep   rep      // how toGo types the node (the encoder properties)
+	st    style    // how the writer spells the node (the decoder property)
+}
+
+// Generation modes for strings.
+type strMode struct {
+	noNewline bool // single-line strings only (keys)
+	printable bool // printable runes only (keys)
+}
+
+var asciiPieces = []string{"a", "b", "z", "A", "Z", "0", "7", "_", "-", ".", " ", "  ", "'", "''", "\"", "\\", "#", "=", "[", "]", "{", "}", ",", "/", ":", ": ", "+", "?", "!", "&", "*", "|", ">", "%", "@", "`", "~", "<<", "- ", "e", "x", "o", "n", "t", "y", "null", "true", "yes", "1e3", "0x", "1_0", ".inf", "---", "...", "\t", "1:20", "2001-12-14"}
+var unicodePieces = []string{"é", "ß", "日本", "😀", "\U0010ffff", "Ω", "\u00a0", "ø"}
+var newlinePieces = []string{"\n", "\n\n", "\n "}
+
+// texts: up to seven pieces, an ASCII piece 70% of the time, a non-ASCII one 20% and a line
+// break 10% (none in noNewline mode); the printable mode replaces unprintable runes by "p", and
+// a string of a pinned shape (avoidString) becomes a harmless variant of the same pieces.
+func texts(m strMode) hegel.Generator[string] {
+	pieces := weighted(
+		choice[string]{70, hegel.SampledFrom(asciiPieces)},
+		choice[string]{20, hegel.SampledFrom(unicodePieces)},
+		choice[string]{10, hegel.SampledFrom(newlinePieces)},
+	)
+	if m.noNewline {
+		pieces = weighted(
+			choice[string]{70, hegel.SampledFrom(asciiPieces)},
+			choice[string]{20, hegel.SampledFrom(unicodePieces)},
+		)
+	}
+	return hegel.Map(hegel.Lists(pieces).MaxSize(7), func(ps []string) string {
+		s := strings.Join(ps, "")
+		if m.printable {
+			s = strings.Map(func(r rune) rune {
+				if r == '\n' || r == ' ' || unicode.IsPrint(r) {
+					return r
+				}
+				return 'p'
+			}, s)
+		}
+		if avoidString(s) {
+			// a harmless variant of the same pieces
+			s = "x" + strings.ReplaceAll(s, "\n ", "\n")
+			if avoidString(s) {
+				s = strings.ReplaceAll(s, "\n", " ")
+			}
+		}
+		return s
+	})
+}
+
+var (
+	anyTexts  = texts(strMode{})
+	lineTexts = texts(strMode{noNewline: true})
+)
+
+var twoSignsRe = regexp.MustCompile(`^[-+][-+]`)
+
+// avoidString reports whether s has one of the pinned shapes the general encoder properties
+// must not exercise (each is a bug of its own, see bugs.toml): a multi-line string whose
+// first non-empty line starts with a space or a tab.  Written as a literal block, such a
+// string needs an indentation indicator; v4 writes none when leading newlines precede the
+// space (yaml/2) or when the line starts with a tab (yaml/13), and a wrong one inside
+// sequences at every indent but 2 (yaml/3).
+func avoidString(s string) bool {
+	if !strings.Contains(s, "\n") {
+		return false
+	}
+	for _, line := range strings.Split(s, "\n") {
+		if line == "" {
+			continue
+		}
+		return strings.HasPrefix(line, " ") || strings.HasPrefix(line, "\t")
+	}
+	return false
+}
+
+// resolvesToNonString reports whether yaml.v3 or v4 reads the bare scalar s as something
+// other than a string (an integer, float, bool, null, merge key or timestamp).
+func resolvesToNonString(s string) bool {
+	if strings.ContainsAny(s, "\n#:") && !strings.Contains(s, ":") {
+		return false
+	}
+	if strings.ContainsAny(s, "\n#") {
+		return false
+	}
+	var v any
+	if err := yamlv3.Unmarshal([]byte(s), &v); err == nil {
+		if _, isStr := v.(string); !isStr {
+			return true
+		}
+	}
+	var w any
+	if err := Load([]byte(s), &w); err == nil {
+		if _, isStr := w.(string); !isStr {
+			return true
+		}
+	}
+	return false
+}
+
+// hasYAML11Only reports whether the tree holds a string a YAML 1.1 reader (PyYAML, goccy in
+// places) resolves to a non-string or rejects (sexagesimals, timestamps, `=`, `<<`,
+// y/n/yes/no/on/off), or one of goccy's own quirks: a two-sign prefix read as a number
+// (go-yaml/16), a key ending in `<<` (go-yaml/24), underscores in what would otherwise be a
+// number (`.0_` is 0 for goccy, a string for v4 and yaml.v3).
+func hasYAML11Only(v *val) bool {
+	switch v.kind {
+	case "string":
+		return goccyQuirk(v.s)
+	case "seq":
+		for _, it := range v.items {
+			if hasYAML11Only(it) {
+				return true
+			}
+		}
+	case "map":
+		for k, kid := range v.kids {
+			if goccyQuirk(k) || hasYAML11Only(kid) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func hasNull(v *val) bool {
+	switch v.kind {
+	case "null":
+		return true
+	case "seq":
+		for _, it := range v.items {
+			if hasNull(it) {
+				return true
+			}
+		}
+	case "map":
+		for _, kid := range v.kids {
+			if hasNull(kid) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func goccyQuirk(s string) bool {
+	if yaml11Only(s) || twoSignsRe.MatchString(s) || strings.HasSuffix(s, "<<") {
+		return true
+	}
+	return strings.Contains(s, "_") && resolvesToNonString(strings.ReplaceAll(s, "_", ""))
+}
+
+// keys: a map key, single-line and printable: a word of one to six characters over a small
+// alphabet 60% of the time ("k" in front when it would resolve to a number or a bool), else a
+// text of pieces.
+var keys = weighted(
+	choice[string]{60, hegel.Map(hegel.Text().Alphabet("abcXYZ019_-.").MinSize(1).MaxSize(6), func(s string) string {
+		if resolvesToNonString(s) {
+			return "k" + s
+		}
+		return s
+	})},
+	choice[string]{40, texts(strMode{noNewline: true, printable: true})},
+)
+
+// int64s: small, medium and large ranges, the 32-bit bounds, and the whole range twice.
+var int64s = hegel.OneOf(
+	hegel.Integers[int64](-10, 10),
+	hegel.Integers[int64](-300, 300),
+	hegel.Integers[int64](-70000, 70000),
+	hegel.Integers[int64](math.MinInt32-5, math.MaxInt32+5),
+	hegel.Integers[int64](math.MinInt64, math.MaxInt64),
+	hegel.Integers[int64](math.MinInt64, math.MaxInt64),
+)
+
+// uint64s: a small count, or a value above the int64 range 30% of the time.
+var uint64s = weighted(
+	choice[uint64]{70, hegel.Map(hegel.Integers(0, 1000), func(x int) uint64 { return uint64(x) })},
+	choice[uint64]{30, hegel.Map(hegel.Integers[int64](0, math.MaxInt64), func(x int64) uint64 { return uint64(x) + uint64(math.MaxInt64) + 1 })},
+)
+
+var floatPool = []float64{0, 0.5, -0.5, 1, -1, 1.5, 100, 1e15, 123456.789, 0.1, 0.2, 0.3, 1e-3, 3.14159, -2.5e10, 1.5e300, 2.5e-300, math.MaxFloat64, math.SmallestNonzeroFloat64, 4.9e-324, 0.000123}
+
+var (
+	nonFinites = hegel.SampledFrom([]float64{math.Inf(1), math.Inf(-1), math.NaN()})
+	eighths    = hegel.Map(hegel.Integers(-1000, 1000), func(x int) float64 { return float64(x) / 8 })
+	// anyBits: every finite double (a NaN or infinity bit pattern becomes 0.75)
+	anyBits = hegel.Map(hegel.Integers[int64](math.MinInt64, math.MaxInt64), func(b int64) float64 {
+		f := math.Float64frombits(uint64(b))
+		if math.IsNaN(f) || math.IsInf(f, 0) {
+			return 0.75
+		}
+		return f
+	})
+)
+
+// floats: a finite or, when allowed, non-finite float whose shortest representation carries a
+// dot (goccy and PyYAML, YAML 1.1 readers, take `1e+21` for a string) and is not negative
+// zero: the pool 30% of the time, a non-finite value (or 2.5) 10%, an eighth 10%, any bit
+// pattern otherwise.
+func floats(nonFinite bool) hegel.Generator[float64] {
+	special := nonFinites
+	if !nonFinite {
+		special = hegel.Just(2.5)
+	}
+	return hegel.Map(weighted(
+		choice[float64]{30, hegel.SampledFrom(floatPool)},
+		choice[float64]{10, special},
+		choice[float64]{10, eighths},
+		choice[float64]{50, anyBits},
+	), func(f float64) float64 {
+		if avoidFloat(f) {
+			return f/3 + 0.5
+		}
+		return f
+	})
+}
+
+var (
+	anyFloats    = floats(true)
+	finiteFloats = floats(false)
+)
+
+// avoidFloat reports whether f is written with an exponent and no dot (1e+21, 1e-07), which
+// the YAML 1.1 oracles read as strings, or is negative zero (yaml/7).
+func avoidFloat(f float64) bool {
+	if math.IsNaN(f) || math.IsInf(f, 0) {
+		return false
+	}
+	if f == 0 && math.Signbit(f) {
+		return true
+	}
+	s := strconv.FormatFloat(f, 'g', -1, 64)
+	return strings.ContainsAny(s, "eE") && !strings.Contains(s, ".")
+}
+
+// scalarValues: null and bool once each, int and float twice, uint once, string three times.
+func scalarValues(m strMode, nonFinite bool) hegel.Generator[val] {
+	return weighted(
+		choice[val]{10, hegel.Just(val{kind: "null"})},
+		choice[val]{10, hegel.Map(hegel.Booleans(), func(b bool) val { return val{kind: "bool", b: b} })},
+		choice[val]{20, hegel.Map(int64s, func(i int64) val { return val{kind: "int", i: i} })},
+		choice[val]{10, hegel.Map(uint64s, func(u uint64) val { return val{kind: "uint", u: u} })},
+		choice[val]{20, hegel.Map(floats(nonFinite), func(f float64) val { return val{kind: "float", f: f} })},
+		choice[val]{30, hegel.Map(texts(m), func(s string) val { return val{kind: "string", s: s} })},
+	)
+}
+
+// treeCfg: what a tree generator draws.
+type treeCfg struct {
+	depth     int // collections nest this deep; below it every node is a scalar
+	m         strMode
+	nonFinite bool
+	typed     bool // draw the Go typing (rep) of every node
+	spelled   bool // draw the YAML spellings (st) of every node
+}
+
+// trees draws a value tree: a scalar 55% of the time by weight (the die is boundary-biased, so
+// nearer 65% in fact), else a sequence of up to four nodes or a mapping of up to four distinct
+// keys.  The generator refers to itself through nodes, and the depth counter in the closure
+// tracks the live recursion (hegel-go's ExampleComposite_recursive): at the bound every node
+// is a scalar.
+func trees(c treeCfg) hegel.Generator[*val] {
+	depth := 0
+	var nodes hegel.Generator[*val]
+	// dress adds the Go typing and the spellings the configuration asks for.
+	dress := func(tc hegel.TestCase, v *val) *val {
+		if c.typed {
+			v.rep = hegel.Draw(tc, reps(v.kind))
+		}
+		if c.spelled {
+			v.st = hegel.Draw(tc, styles(v.kind))
+		}
+		return v
+	}
+	scalars := scalarValues(c.m, c.nonFinite)
+	leaves := hegel.Composite(func(tc hegel.TestCase) *val {
+		v := hegel.Draw(tc, scalars)
+		return dress(tc, &v)
+	})
+	seqs := hegel.Composite(func(tc hegel.TestCase) *val {
+		depth++
+		defer func() { depth-- }()
+		return dress(tc, &val{kind: "seq", items: hegel.Draw(tc, hegel.Lists(nodes).MaxSize(4))})
+	})
+	maps := hegel.Composite(func(tc hegel.TestCase) *val {
+		depth++
+		defer func() { depth-- }()
+		kids := hegel.Draw(tc, hegel.Maps(keys, nodes).MaxSize(4))
+		return dress(tc, &val{kind: "map", kids: kids, keys: sortedKeys(kids)})
+	})
+	branches := weighted(choice[*val]{110, leaves}, choice[*val]{45, seqs}, choice[*val]{45, maps})
+	nodes = hegel.Composite(func(tc hegel.TestCase) *val {
+		if depth >= c.depth {
+			return hegel.Draw(tc, leaves)
+		}
+		return hegel.Draw(tc, branches)
+	})
+	return nodes
+}
+
+func sortedKeys(kids map[string]*val) []string {
+	ks := make([]string, 0, len(kids))
+	for k := range kids {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+func isColl(v *val) bool { return v.kind == "seq" || v.kind == "map" }
+
+// size is the number of items or entries of a collection.
+func size(v *val) int {
+	if v.kind == "map" {
+		return len(v.kids)
+	}
+	return len(v.items)
+}
+
+var (
+	typedTrees   = trees(treeCfg{depth: 3, nonFinite: true, typed: true})
+	typedTrees2  = trees(treeCfg{depth: 2, nonFinite: true, typed: true})
+	typedTrees1  = trees(treeCfg{depth: 1, nonFinite: true, typed: true})
+	typedScalars = trees(treeCfg{depth: 0, nonFinite: true, typed: true})
+	spelledTrees = trees(treeCfg{depth: 3, nonFinite: true, spelled: true})
+	// yaml12Trees: the trees without a string a YAML 1.1 reader (PyYAML, goccy in places)
+	// resolves to a non-string or rejects, or one goccy misreads by a defect of its own
+	// (hasYAML11Only): v4's output for those is not the 1.1 readers' concern.
+	yaml12Trees = hegel.Filter(typedTrees, func(v *val) bool { return !hasYAML11Only(v) })
+)
+
+// ---------------------------------------------------------------------------------------
+// The Go values handed to the encoder.
+
+// rep: the Go type toGo gives a node.
+type rep struct {
+	width   int  // an integer: 0 int64/uint64, 1 int/uint, 2 32 bits, 3 16 bits, 4 8 bits (the widest of it and what fits)
+	typed   bool // a sequence of strings: []string
+	anyKeys bool // a mapping: map[any]any
+}
+
+var (
+	intWidths = hegel.SampledFrom([]int{0, 0, 1, 1, 2, 3, 4, 4})
+	intReps   = hegel.Map(intWidths, func(w int) rep { return rep{width: w} })
+	repOf     = map[string]hegel.Generator[rep]{
+		"int":  intReps,
+		"uint": intReps,
+		"seq":  hegel.Map(chance(20), func(b bool) rep { return rep{typed: b} }),
+		"map":  hegel.Map(chance(15), func(b bool) rep { return rep{anyKeys: b} }),
+	}
+	noRep = hegel.Just(rep{})
+)
+
+// reps: the typing choices a node of the kind has.
+func reps(kind string) hegel.Generator[rep] {
+	if g, ok := repOf[kind]; ok {
+		return g
+	}
+	return noRep
+}
+
+// toGo converts the model to the Go values handed to the encoder: integers in the sized Go
+// integer types the node's rep asks for (as far as the value fits), a sequence of strings as
+// []string and a mapping as map[any]any when it asks.
+func toGo(v *val) any {
+	switch v.kind {
+	case "null":
+		return nil
+	case "bool":
+		return v.b
+	case "int":
+		return sizedInt(v.i, v.rep.width)
+	case "uint":
+		return sizedUint(v.u, v.rep.width)
+	case "float":
+		return v.f
+	case "string":
+		return v.s
+	case "seq":
+		out := make([]any, 0, len(v.items))
+		allStr := true
+		for _, it := range v.items {
+			out = append(out, toGo(it))
+			allStr = allStr && it.kind == "string"
+		}
+		if v.rep.typed && len(out) > 0 && allStr {
+			ss := make([]string, len(out))
+			for i, x := range out {
+				ss[i] = x.(string)
+			}
+			return ss
+		}
+		return out
+	case "map":
+		out := make(map[string]any, len(v.kids))
+		for k, kid := range v.kids {
+			out[k] = toGo(kid)
+		}
+		if v.rep.anyKeys {
+			out2 := make(map[any]any, len(out))
+			for k, x := range out {
+				out2[k] = x
+			}
+			return out2
+		}
+		return out
+	}
+	panic("bad kind " + v.kind)
+}
+
+func sizedInt(i int64, width int) any {
+	switch {
+	case width >= 4 && i >= math.MinInt8 && i <= math.MaxInt8:
+		return int8(i)
+	case width >= 3 && i >= math.MinInt16 && i <= math.MaxInt16:
+		return int16(i)
+	case width >= 2 && i >= math.MinInt32 && i <= math.MaxInt32:
+		return int32(i)
+	case width >= 1:
+		return int(i)
+	}
+	return i
+}
+
+func sizedUint(u uint64, width int) any {
+	switch {
+	case width >= 4 && u <= math.MaxUint8:
+		return uint8(u)
+	case width >= 3 && u <= math.MaxUint16:
+		return uint16(u)
+	case width >= 2 && u <= math.MaxUint32:
+		return uint32(u)
+	case width >= 1:
+		return uint(u)
+	}
+	return u
+}
+
+// ---------------------------------------------------------------------------------------
+// Canonical forms, so that trees from v4, yaml.v3, goccy and the model compare.  Numbers
+// compare by value (v4 writes the float 1 as `1`, which every reader takes for an integer:
+// documented, so the general properties do not hold the int/float distinction against it;
+// the typed-field properties do).
+
+func canonFloat(f float64) string {
+	if math.IsNaN(f) {
+		return "NaN"
+	}
+	if f == math.Trunc(f) && math.Abs(f) < 1<<63 {
+		return strconv.FormatInt(int64(f), 10)
+	}
+	return strconv.FormatFloat(f, 'g', -1, 64)
+}
+
+func canonVal(v *val) any {
+	switch v.kind {
+	case "null":
+		return "null"
+	case "bool":
+		return "b:" + strconv.FormatBool(v.b)
+	case "int":
+		return "n:" + strconv.FormatInt(v.i, 10)
+	case "uint":
+		return "n:" + strconv.FormatUint(v.u, 10)
+	case "float":
+		return "n:" + canonFloat(v.f)
+	case "string":
+		return "s:" + v.s
+	case "seq":
+		out := make([]any, 0, len(v.items))
+		for _, it := range v.items {
+			out = append(out, canonVal(it))
+		}
+		return out
+	case "map":
+		out := make(map[string]any, len(v.kids))
+		for k, kid := range v.kids {
+			out[k] = canonVal(kid)
+		}
+		return out
+	}
+	panic("bad kind")
+}
+
+// canon canonicalises a decoded Go value (from v4, yaml.v3 or goccy).
+func canon(x any) any {
+	switch v := x.(type) {
+	case nil:
+		return "null"
+	case bool:
+		return "b:" + strconv.FormatBool(v)
+	case string:
+		return "s:" + v
+	case float64:
+		return "n:" + canonFloat(v)
+	case float32:
+		return "n:" + canonFloat(float64(v))
+	case time.Time:
+		return "time:" + v.UTC().Format(time.RFC3339Nano)
+	case []byte:
+		return "bytes:" + string(v)
+	case []any:
+		out := make([]any, len(v))
+		for i, it := range v {
+			out[i] = canon(it)
+		}
+		return out
+	case []string:
+		out := make([]any, len(v))
+		for i, it := range v {
+			out[i] = "s:" + it
+		}
+		return out
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for k, it := range v {
+			out[k] = canon(it)
+		}
+		return out
+	case map[any]any:
+		out := make(map[string]any, len(v))
+		for k, it := range v {
+			out[fmt.Sprint(k)] = canon(it)
+		}
+		return out
+	}
+	rv := reflect.ValueOf(x)
+	switch rv.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return "n:" + strconv.FormatInt(rv.Int(), 10)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return "n:" + strconv.FormatUint(rv.Uint(), 10)
+	}
+	return fmt.Sprintf("?:%T(%v)", x, x)
+}
+
+func render(x any) string {
+	b, _ := json.Marshal(x)
+	return string(b)
+}
+
+func sameCanon(a, b any) bool { return reflect.DeepEqual(a, b) }
+
+// ---------------------------------------------------------------------------------------
+// PyYAML (libyaml) as a child process: tagged trees over JSON lines.
+
+const pyyamlScript = `
+import sys, json, yaml
+def node(v):
+    if isinstance(v, bool):
+        return {"t": "bool", "s": "true" if v else "false"}
+    if v is None:
+        return {"t": "null"}
+    if isinstance(v, str):
+        return {"t": "str", "s": v}
+    if isinstance(v, (int, float)):
+        return {"t": "num", "s": repr(v)}
+    if isinstance(v, dict):
+        return {"t": "map", "kids": {(k if isinstance(k, str) else "<" + type(k).__name__ + ">" + str(k)): node(x) for k, x in v.items()}}
+    if isinstance(v, list):
+        return {"t": "seq", "items": [node(x) for x in v]}
+    return {"t": "other", "s": type(v).__name__ + ":" + str(v)}
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        v = yaml.load(req["doc"], Loader=yaml.CSafeLoader)
+        out = {"ok": True, "tree": node(v)}
+    except Exception as e:
+        out = {"ok": False, "err": type(e).__name__ + ": " + str(e)[:300]}
+    sys.stdout.write(json.dumps(out) + "\n")
+    sys.stdout.flush()
+`
+
+type pyNode struct {
+	T     string             `json:"t"`
+	S     string             `json:"s"`
+	Kids  map[string]*pyNode `json:"kids"`
+	Items []*pyNode          `json:"items"`
+}
+
+var (
+	pyOnce  sync.Once
+	pyMu    sync.Mutex
+	pyIn    *bufio.Writer
+	pyOut   *bufio.Reader
+	pyError error
+)
+
+func startPython() {
+	cmd := exec.Command("python3", "-c", pyyamlScript)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		pyError = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		pyError = err
+		return
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		pyError = err
+		return
+	}
+	pyIn, pyOut = bufio.NewWriter(stdin), bufio.NewReader(stdout)
+}
+
+func pyyaml(t testing.TB, doc string) (*pyNode, string) {
+	pyOnce.Do(startPython)
+	if pyError != nil {
+		t.Fatalf("cannot start python3: %v", pyError)
+	}
+	pyMu.Lock()
+	defer pyMu.Unlock()
+	req, _ := json.Marshal(map[string]string{"doc": doc})
+	pyIn.Write(req)
+	pyIn.WriteByte('\n')
+	if err := pyIn.Flush(); err != nil {
+		t.Fatalf("writing to python: %v", err)
+	}
+	line, err := pyOut.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("reading from python: %v", err)
+	}
+	var resp struct {
+		OK   bool    `json:"ok"`
+		Tree *pyNode `json:"tree"`
+		Err  string  `json:"err"`
+	}
+	if err := json.Unmarshal(line, &resp); err != nil {
+		t.Fatalf("bad python response %q: %v", line, err)
+	}
+	if !resp.OK {
+		return nil, resp.Err
+	}
+	return resp.Tree, ""
+}
+
+var (
+	sexagesimalRe = regexp.MustCompile(`^[-+]?[0-9][0-9_]*(:[0-5]?[0-9])+(\.[0-9_]*)?$`)
+	timestampRe   = regexp.MustCompile(`^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}([Tt ].*)?$`)
+	yaml11BoolRe  = regexp.MustCompile(`^(y|Y|yes|Yes|YES|n|N|no|No|NO|on|On|ON|off|Off|OFF)$`)
+)
+
+// yaml11Only reports whether a YAML 1.1 reader resolves the bare string s to a non-string
+// where YAML 1.2 (v4, yaml.v3) has a string: not v4's concern.
+func yaml11Only(s string) bool {
+	return sexagesimalRe.MatchString(s) || timestampRe.MatchString(s) || yaml11BoolRe.MatchString(s) || s == "=" || s == "<<"
+}
+
+// pyMatch checks PyYAML's tree against the model: strings and structure exactly, numbers by
+// value, booleans and nulls exactly.  Returns "" or a description of the first difference.
+func pyMatch(path string, v *val, p *pyNode) string {
+	if p == nil {
+		return path + ": missing"
+	}
+	switch v.kind {
+	case "null":
+		if p.T != "null" {
+			return fmt.Sprintf("%s: want null, PyYAML has %s %q", path, p.T, p.S)
+		}
+	case "bool":
+		if p.T != "bool" || p.S != strconv.FormatBool(v.b) {
+			return fmt.Sprintf("%s: want bool %v, PyYAML has %s %q", path, v.b, p.T, p.S)
+		}
+	case "int", "uint", "float":
+		if p.T != "num" {
+			return fmt.Sprintf("%s: want a number, PyYAML has %s %q", path, p.T, p.S)
+		}
+		want := v.f
+		if v.kind == "int" {
+			want = float64(v.i)
+		} else if v.kind == "uint" {
+			want = float64(v.u)
+		}
+		got, err := strconv.ParseFloat(p.S, 64)
+		if err != nil || (got != want && !(math.IsNaN(got) && math.IsNaN(want))) {
+			return fmt.Sprintf("%s: want %v, PyYAML has %q", path, want, p.S)
+		}
+	case "string":
+		if yaml11Only(v.s) {
+			return ""
+		}
+		if p.T != "str" || p.S != v.s {
+			return fmt.Sprintf("%s: want string %q, PyYAML has %s %q", path, v.s, p.T, p.S)
+		}
+	case "seq":
+		if p.T != "seq" || len(p.Items) != len(v.items) {
+			return fmt.Sprintf("%s: want a sequence of %d, PyYAML has %s of %d", path, len(v.items), p.T, len(p.Items))
+		}
+		for i, it := range v.items {
+			if d := pyMatch(fmt.Sprintf("%s[%d]", path, i), it, p.Items[i]); d != "" {
+				return d
+			}
+		}
+	case "map":
+		if p.T != "map" || len(p.Kids) != len(v.kids) {
+			return fmt.Sprintf("%s: want a mapping of %d, PyYAML has %s of %d", path, len(v.kids), p.T, len(p.Kids))
+		}
+		for k, kid := range v.kids {
+			if yaml11Only(k) {
+				continue
+			}
+			pk, ok := p.Kids[k]
+			if !ok {
+				return fmt.Sprintf("%s: key %q missing in PyYAML's mapping (keys %v)", path, k, pyKeys(p))
+			}
+			if d := pyMatch(path+"."+k, kid, pk); d != "" {
+				return d
+			}
+		}
+	}
+	return ""
+}
+
+func pyKeys(p *pyNode) []string {
+	var ks []string
+	for k := range p.Kids {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+// ---------------------------------------------------------------------------------------
+// Dump options: the v4 Dump API with random options, the legacy Marshal and the Encoder.
+
+type dumpOpts struct {
+	mode          string // dump marshal encoder
+	v3            bool
+	indent        int  // 0: default
+	compact       int  // 0 default, 1 on, 2 off
+	quote         int  // 0 default, 1 single, 2 double, 3 legacy
+	width         *int // nil: default
+	asciiOnly     bool
+	crlf          bool
+	explicitStart bool
+	explicitEnd   bool
+	flowSimple    bool
+}
+
+var (
+	allModes = []string{"dump", "dump", "dump", "dump", "marshal", "encoder"}
+	dumpOnly = []string{"dump"}
+	// indent 3 with compact sequences is yaml/12, so 3 is in neither list
+	encoderIndents = hegel.SampledFrom([]int{1, 2, 4, 5, 6, 7, 8, 9})
+	dumpIndents    = hegel.SampledFrom([]int{2, 4, 5, 6, 7, 8, 9})
+	lineWidths     = hegel.SampledFrom([]int{-1, 0, 10, 20, 40, 80, 200})
+)
+
+// dumpOptions: one of the modes (Dump four times in six with allModes) with its options drawn
+// independently: for Dump the v3 defaults 25% of the time, an indent half the time, a compact
+// sequence indent setting half the time, a quote preference 60%, a line width 30%, ASCII-only
+// output 15%, CRLF line breaks 15% (never when crlf is false), explicit markers 20% each and
+// flow simple collections 25%; for an Encoder an indent half the time and one of the three
+// sequence indent settings.
+func dumpOptions(modes []string, crlf bool) hegel.Generator[dumpOpts] {
+	crlfs := hegel.Just(false)
+	if crlf {
+		crlfs = chance(15)
+	}
+	dumps := hegel.Composite(func(tc hegel.TestCase) dumpOpts {
+		return dumpOpts{
+			mode:          "dump",
+			v3:            hegel.Draw(tc, chance(25)),
+			indent:        hegel.Draw(tc, maybe(50, dumpIndents)),
+			compact:       hegel.Draw(tc, hegel.SampledFrom([]int{0, 0, 1, 2})),
+			quote:         hegel.Draw(tc, hegel.SampledFrom([]int{0, 0, 1, 2, 3})),
+			width:         hegel.Draw(tc, maybe(30, ptrs(lineWidths))),
+			asciiOnly:     hegel.Draw(tc, chance(15)),
+			crlf:          hegel.Draw(tc, crlfs),
+			explicitStart: hegel.Draw(tc, chance(20)),
+			explicitEnd:   hegel.Draw(tc, chance(20)),
+			flowSimple:    hegel.Draw(tc, chance(25)),
+		}
+	})
+	encoders := hegel.Composite(func(tc hegel.TestCase) dumpOpts {
+		return dumpOpts{
+			mode:    "encoder",
+			indent:  hegel.Draw(tc, maybe(50, encoderIndents)),
+			compact: hegel.Draw(tc, hegel.SampledFrom([]int{0, 1, 2})),
+		}
+	})
+	return hegel.FlatMap(hegel.SampledFrom(modes), func(mode string) hegel.Generator[dumpOpts] {
+		switch mode {
+		case "marshal":
+			return hegel.Just(dumpOpts{mode: "marshal"})
+		case "encoder":
+			return encoders
+		}
+		return dumps
+	})
+}
+
+var (
+	dumpOptsAny = dumpOptions(allModes, true)
+	// goccy is not fed CRLF output: it truncates single-quoted scalars folded across CRLF (its
+	// own bug)
+	dumpOptsNoCRLF = dumpOptions(allModes, false)
+	dumpOptsDump   = dumpOptions(dumpOnly, true)
+)
+
+func (o dumpOpts) list() []Option {
+	var opts []Option
+	if o.v3 {
+		opts = append(opts, WithV3Defaults())
+	}
+	if o.indent != 0 {
+		opts = append(opts, WithIndent(o.indent))
+	}
+	switch o.compact {
+	case 1:
+		opts = append(opts, WithCompactSeqIndent(true))
+	case 2:
+		opts = append(opts, WithCompactSeqIndent(false))
+	}
+	switch o.quote {
+	case 1:
+		opts = append(opts, WithQuotePreference(QuoteSingle))
+	case 2:
+		opts = append(opts, WithQuotePreference(QuoteDouble))
+	case 3:
+		opts = append(opts, WithQuotePreference(QuoteLegacy))
+	}
+	if o.width != nil {
+		opts = append(opts, WithLineWidth(*o.width))
+	}
+	if o.asciiOnly {
+		opts = append(opts, WithUnicode(false))
+	}
+	if o.crlf {
+		opts = append(opts, WithLineBreak(LineBreakCRLN))
+	}
+	if o.explicitStart {
+		opts = append(opts, WithExplicitStart())
+	}
+	if o.explicitEnd {
+		opts = append(opts, WithExplicitEnd())
+	}
+	if o.flowSimple {
+		opts = append(opts, WithFlowSimpleCollections())
+	}
+	return opts
+}
+
+// dump writes in under the options: Dump, the legacy Marshal, or an Encoder.
+func (o dumpOpts) dump(in any) ([]byte, error) {
+	switch o.mode {
+	case "marshal":
+		return Marshal(in)
+	case "encoder":
+		var buf bytes.Buffer
+		enc := NewEncoder(&buf)
+		if o.indent != 0 {
+			enc.SetIndent(o.indent)
+		}
+		switch o.compact {
+		case 1:
+			enc.CompactSeqIndent()
+		case 2:
+			enc.DefaultSeqIndent()
+		}
+		if err := enc.Encode(in); err != nil {
+			return nil, err
+		}
+		if err := enc.Close(); err != nil {
+			return nil, err
+		}
+		return buf.Bytes(), nil
+	}
+	return Dump(in, o.list()...)
+}
+
+func (o dumpOpts) String() string {
+	if o.mode != "dump" {
+		return fmt.Sprintf("mode=%s indent=%d compact=%d", o.mode, o.indent, o.compact)
+	}
+	width := "default"
+	if o.width != nil {
+		width = strconv.Itoa(*o.width)
+	}
+	return fmt.Sprintf("dump v3=%v indent=%d compact=%d quote=%d width=%s ascii=%v crlf=%v start=%v end=%v flowSimple=%v",
+		o.v3, o.indent, o.compact, o.quote, width, o.asciiOnly, o.crlf, o.explicitStart, o.explicitEnd, o.flowSimple)
+}
+
+// ---------------------------------------------------------------------------------------
+// General properties: the encoder.
+
+// dumpCase: a value tree with its Go typing and the options it is dumped under.
+type dumpCase struct {
+	opts dumpOpts
+	v    *val
+}
+
+func dumpCases(opts hegel.Generator[dumpOpts], vs hegel.Generator[*val]) hegel.Generator[dumpCase] {
+	return hegel.Composite(func(tc hegel.TestCase) dumpCase {
+		return dumpCase{opts: hegel.Draw(tc, opts), v: hegel.Draw(tc, vs)}
+	})
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c dumpCase) GoString() string {
+	return fmt.Sprintf("%s dumped with %s", render(canonVal(c.v)), c.opts)
+}
+
+var (
+	v3Cases     = dumpCases(dumpOptsAny, typedTrees)
+	goccyCases  = dumpCases(dumpOptsNoCRLF, yaml12Trees)
+	pyyamlCases = dumpCases(dumpOptsAny, yaml12Trees)
+)
+
+// identityCase: a dump case and the options the loaded Node is dumped again under.
+type identityCase struct {
+	dumpCase
+	again dumpOpts
+}
+
+var identityCases = hegel.Composite(func(tc hegel.TestCase) identityCase {
+	return identityCase{dumpCase: hegel.Draw(tc, v3Cases), again: hegel.Draw(tc, dumpOptsAny)}
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c identityCase) GoString() string {
+	return fmt.Sprintf("%s, the Node dumped again with %s", c.dumpCase.GoString(), c.again)
+}
+
+// streamCase: one to four documents (a Dumper that wrote nothing cannot be closed: yaml/11)
+// and the Dump options of the stream.
+type streamCase struct {
+	opts dumpOpts
+	vs   []*val
+}
+
+var streamCases = hegel.Composite(func(tc hegel.TestCase) streamCase {
+	return streamCase{opts: hegel.Draw(tc, dumpOptsDump), vs: hegel.Draw(tc, hegel.Lists(typedTrees2).MinSize(1).MaxSize(4))}
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c streamCase) GoString() string {
+	docs := make([]string, len(c.vs))
+	for i, v := range c.vs {
+		docs[i] = render(canonVal(v))
+	}
+	return fmt.Sprintf("%d documents %s dumped with %s", len(c.vs), strings.Join(docs, " "), c.opts)
+}
+
+func TestHegelDumpThenLoadIntoAnInterfaceIsTheIdentity(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, identityCases)
+		o, v := tcase.opts, tcase.v
+		in := toGo(v)
+		doc, err := o.dump(in)
+		if err != nil {
+			ht.Fatalf("dump(%s) with %s: %v", render(in), o, err)
+		}
+		note(ht, "document:\n%s", doc)
+		want := canonVal(v)
+		var got any
+		if err := Load(doc, &got); err != nil {
+			ht.Fatalf("Load of v4's own output: %v", err)
+		}
+		if !sameCanon(canon(got), want) {
+			ht.Fatalf("round trip changed the value:\n want %s\n got  %s", render(want), render(canon(got)))
+		}
+		var got2 any
+		if err := Unmarshal(doc, &got2); err != nil {
+			ht.Fatalf("Unmarshal of v4's own output: %v", err)
+		}
+		if !sameCanon(canon(got2), want) {
+			ht.Fatalf("Unmarshal differs from Load:\n want %s\n got  %s", render(want), render(canon(got2)))
+		}
+		var got3 any
+		if err := NewDecoder(bytes.NewReader(doc)).Decode(&got3); err != nil {
+			ht.Fatalf("Decoder.Decode: %v", err)
+		}
+		if !sameCanon(canon(got3), want) {
+			ht.Fatalf("Decoder.Decode differs:\n want %s\n got  %s", render(want), render(canon(got3)))
+		}
+		// Through a Node: what was loaded is dumped again and read as the same value.
+		var nd Node
+		if err := Load(doc, &nd); err != nil {
+			ht.Fatalf("Load into a Node: %v", err)
+		}
+		var viaNode any
+		if err := nd.Decode(&viaNode); err != nil {
+			ht.Fatalf("Node.Decode: %v", err)
+		}
+		if !sameCanon(canon(viaNode), want) {
+			ht.Fatalf("Node.Decode differs:\n want %s\n got  %s", render(want), render(canon(viaNode)))
+		}
+		o2 := tcase.again
+		doc2, err := o2.dump(&nd)
+		if err != nil {
+			ht.Fatalf("dump of the Node with %s: %v", o2, err)
+		}
+		var got4 any
+		if err := Load(doc2, &got4); err != nil {
+			ht.Fatalf("Load of the re-dumped Node (%s):\n%s\n%v", o2, doc2, err)
+		}
+		if !sameCanon(canon(got4), want) {
+			ht.Fatalf("Node round trip (%s) changed the value:\n%s\n want %s\n got  %s", o2, doc2, render(want), render(canon(got4)))
+		}
+	})
+}
+
+func TestHegelDumpOutputIsReadBackByYamlV3AsTheInput(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, v3Cases)
+		o, v := tcase.opts, tcase.v
+		in := toGo(v)
+		doc, err := o.dump(in)
+		if err != nil {
+			ht.Fatalf("dump(%s) with %s: %v", render(in), o, err)
+		}
+		note(ht, "document:\n%s", doc)
+		var got any
+		if err := yamlv3.Unmarshal(doc, &got); err != nil {
+			ht.Fatalf("yaml.v3 rejects v4's output: %v", err)
+		}
+		want := canonVal(v)
+		if !sameCanon(canon(got), want) {
+			ht.Fatalf("yaml.v3 reads v4's output differently:\n want %s\n got  %s", render(want), render(canon(got)))
+		}
+	})
+}
