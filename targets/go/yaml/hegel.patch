+// times: an instant of years 1..9999 in every zone, with nanoseconds half the time, in a fixed
+// zone of whole hours and a quarter, or of zero (time.UTC for half of those).
+var times = hegel.Composite(func(tc hegel.TestCase) time.Time {
+	sec := hegel.Draw(tc, hegel.Integers[int64](-62135596800+86400, 253402300799-86400))
+	nanos := hegel.Draw(tc, maybe(50, hegel.Integers(0, 999999999)))
+	off := hegel.Draw(tc, hegel.Integers(-23, 23))*3600 + hegel.Draw(tc, hegel.SampledFrom([]int{0, 0, 1800, 2700, 900, -1800, -2700, -900}))
+	zero := hegel.Draw(tc, chance(30))
+	utc := hegel.Draw(tc, chance(50))
+	if zero {
+		off = 0
+	}
+	loc := time.FixedZone("", off)
+	if off == 0 && utc {
+		loc = time.UTC
+	}
+	return time.Unix(sec, int64(nanos)).In(loc)
+})
