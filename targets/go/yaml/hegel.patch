+// ---------------------------------------------------------------------------------------
+// Known fields.
+
+type strictTarget struct {
+	Alpha int            `yaml:"alpha"`
+	Beta  string         `yaml:"beta"`
+	Gamma map[string]int `yaml:"gamma"`
+}
+
+// knownCase: the three known keys, each present or not, up to two extra keys with their
+// values, and the options the mapping is dumped under.
+type knownCase struct {
+	alpha *int
+	beta  *string
+	gamma bool
+	extra map[string]int
+	opts  dumpOpts
+}
+
+var knownCases = hegel.Composite(func(tc hegel.TestCase) knownCase {
+	return knownCase{
+		alpha: hegel.Draw(tc, maybe(70, ptrs(smallInts))),
+		beta:  hegel.Draw(tc, maybe(70, ptrs(lineTexts))),
+		gamma: hegel.Draw(tc, chance(50)),
+		extra: hegel.Draw(tc, hegel.Maps(keys, hegel.Integers(0, 9)).MaxSize(2)),
+		opts:  hegel.Draw(tc, dumpOptsAny),
+	}
+})
+
+// value is the mapping to dump and the number of its unknown keys (an extra key spelled like
+// a known one is dropped).
+func (c knownCase) value() (map[string]any, int) {
+	m := map[string]any{}
+	if c.alpha != nil {
+		m["alpha"] = *c.alpha
+	}
+	if c.beta != nil {
+		m["beta"] = *c.beta
+	}
+	if c.gamma {
+		m["gamma"] = map[string]int{"x": 1}
+	}
+	unknown := 0
+	for k, x := range c.extra {
+		if k == "alpha" || k == "beta" || k == "gamma" {
+			continue
+		}
+		m[k] = x
+		unknown++
+	}
+	return m, unknown
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c knownCase) GoString() string {
+	m, unknown := c.value()
+	return fmt.Sprintf("%s (%d unknown keys) dumped with %s", render(m), unknown, c.opts)
+}
+
+func TestHegelKnownFieldsFailsExactlyWhenUnknownKeysArePresent(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, knownCases)
+		m, unknown := tcase.value()
+		o := tcase.opts
+		doc, err := o.dump(m)
+		if err != nil {
+			ht.Fatalf("dump with %s: %v", o, err)
+		}
+		note(ht, "document:\n%s", doc)
+		var lenient strictTarget
+		if err := Load(doc, &lenient); err != nil {
+			ht.Fatalf("lenient load failed: %v", err)
+		}
+		var strict strictTarget
+		err = Load(doc, &strict, WithKnownFields())
+		if (err != nil) != (unknown > 0) {
+			ht.Fatalf("WithKnownFields: %d unknown keys, error %v", unknown, err)
+		}
+		if err == nil && !reflect.DeepEqual(lenient, strict) {
+			ht.Fatalf("strict and lenient loads differ: %+v vs %+v", strict, lenient)
+		}
+		dec := NewDecoder(bytes.NewReader(doc))
+		dec.KnownFields(true)
+		var viaDec strictTarget
+		err = dec.Decode(&viaDec)
+		if (err != nil) != (unknown > 0) {
+			ht.Fatalf("Decoder.KnownFields: %d unknown keys, error %v", unknown, err)
+		}
+	})
+}
