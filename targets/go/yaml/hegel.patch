+// yaml/14
+func TestHegelNullNodesWithAnEmptyValueStayNullInFlowStyle(t *testing.T) {
+	for _, doc := range []string{"a:\n", "a:\n# c\n", "- \n", "{a: }\n"} {
+		var nd Node
+		if err := Load([]byte(doc), &nd); err != nil {
+			t.Fatalf("Load(%q) into a Node: %v", doc, err)
+		}
+		var direct any
+		if err := Load([]byte(doc), &direct); err != nil {
+			t.Fatalf("Load(%q): %v", doc, err)
+		}
+		for _, opts := range [][]Option{nil, {WithFlowSimpleCollections()}} {
+			out, err := Dump(&nd, opts...)
+			if err != nil {
+				t.Errorf("Dump of the Node from %q with %d options: %v", doc, len(opts), err)
+				continue
+			}
+			got, err := loadAny(out)
+			if err != nil {
+				t.Errorf("Node from %q dumped as %q; Load: %v", doc, out, err)
+				continue
+			}
+			if !sameCanon(canon(got), canon(direct)) {
+				t.Errorf("Node from %q dumped as %q (%d options), which loads as %#v instead of %#v", doc, out, len(opts), got, direct)
+			}
+		}
+	}
+	// a null node built by hand, in a flow mapping
+	m := &Node{Kind: MappingNode, Style: FlowStyle, Content: []*Node{{Kind: ScalarNode, Value: "a"}, {Kind: ScalarNode, Tag: "!!null", Value: ""}}}
+	out := mustDump(t, m)
+	got, err := loadAny(out)
+	if err != nil {
+		t.Fatalf("Dump of a flow mapping with a null node = %q; Load: %v", out, err)
+	}
+	if !sameCanon(canon(got), canon(map[string]any{"a": nil})) {
+		t.Errorf("Dump of a flow mapping with a !!null node = %q, which loads as %#v", out, got)
+	}
+}
