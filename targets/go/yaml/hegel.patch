+// same is the round-trip equality: nil and empty collections are equal, NaN equals NaN,
+// times compare as instants with the same offset, interface values by canonical form,
+// Nodes by kind, tag and value, unexported and skipped fields are ignored.
+func same(a, b reflect.Value, path string) string {
+	if a.Kind() == reflect.Interface {
+		if !sameCanon(canon(a.Interface()), canon(b.Interface())) {
+			return fmt.Sprintf("%s: %s vs %s", path, render(canon(a.Interface())), render(canon(b.Interface())))
+		}
+		return ""
+	}
+	if a.Type() != b.Type() {
+		return fmt.Sprintf("%s: types %s vs %s", path, a.Type(), b.Type())
+	}
+	switch a.Kind() {
+	case reflect.Ptr:
+		if a.IsNil() != b.IsNil() {
+			return fmt.Sprintf("%s: nil %v vs %v", path, a.IsNil(), b.IsNil())
+		}
+		if a.IsNil() {
+			return ""
+		}
+		return same(a.Elem(), b.Elem(), path)
+	case reflect.Struct:
+		if t, ok := a.Interface().(time.Time); ok {
+			u := b.Interface().(time.Time)
+			_, oa := t.Zone()
+			_, ob := u.Zone()
+			if !t.Equal(u) || oa != ob {
+				return fmt.Sprintf("%s: %v vs %v", path, t, u)
+			}
+			return ""
+		}
+		if x, ok := a.Interface().(Node); ok {
+			y := b.Interface().(Node)
+			if x.Kind != y.Kind || x.Value != y.Value || x.ShortTag() != y.ShortTag() {
+				return fmt.Sprintf("%s: node %v %q %q vs %v %q %q", path, x.Kind, x.ShortTag(), x.Value, y.Kind, y.ShortTag(), y.Value)
+			}
+			return ""
+		}
+		for i := 0; i < a.NumField(); i++ {
+			f := a.Type().Field(i)
+			if f.PkgPath != "" || f.Tag.Get("yaml") == "-" {
+				continue
+			}
+			if d := same(a.Field(i), b.Field(i), path+"."+f.Name); d != "" {
+				return d
+			}
+		}
+		return ""
+	case reflect.Slice:
+		if a.Len() != b.Len() {
+			return fmt.Sprintf("%s: length %d vs %d", path, a.Len(), b.Len())
+		}
+		for i := 0; i < a.Len(); i++ {
+			if d := same(a.Index(i), b.Index(i), fmt.Sprintf("%s[%d]", path, i)); d != "" {
+				return d
+			}
+		}
+		return ""
+	case reflect.Array:
+		for i := 0; i < a.Len(); i++ {
+			if d := same(a.Index(i), b.Index(i), fmt.Sprintf("%s[%d]", path, i)); d != "" {
+				return d
+			}
+		}
+		return ""
+	case reflect.Map:
+		if a.Len() != b.Len() {
+			return fmt.Sprintf("%s: %d keys vs %d", path, a.Len(), b.Len())
+		}
+		iter := a.MapRange()
+		for iter.Next() {
+			bv := b.MapIndex(iter.Key())
+			if !bv.IsValid() {
+				return fmt.Sprintf("%s: key %v missing", path, iter.Key())
+			}
+			if d := same(iter.Value(), bv, fmt.Sprintf("%s[%v]", path, iter.Key())); d != "" {
+				return d
+			}
+		}
+		return ""
+	case reflect.Float32, reflect.Float64:
+		x, y := a.Float(), b.Float()
+		if x != y && !(math.IsNaN(x) && math.IsNaN(y)) {
+			return fmt.Sprintf("%s: %v vs %v", path, x, y)
+		}
+		return ""
+	}
+	if !reflect.DeepEqual(a.Interface(), b.Interface()) {
+		return fmt.Sprintf("%s: %#v vs %#v", path, a.Interface(), b.Interface())
+	}
+	return ""
+}
