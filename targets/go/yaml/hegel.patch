+// yaml/11
+func TestHegelAnEmptyDocumentStreamCanBeDumped(t *testing.T) {
+	var buf bytes.Buffer
+	d, err := NewDumper(&buf)
+	if err != nil {
+		t.Fatalf("NewDumper: %v", err)
+	}
+	if err := d.Close(); err != nil {
+		t.Errorf("closing a Dumper that dumped nothing: %v", err)
+	}
+	buf.Reset()
+	enc := NewEncoder(&buf)
+	if err := enc.Close(); err != nil {
+		t.Errorf("closing an Encoder that encoded nothing: %v", err)
+	}
+	out, err := Dump([]any{}, WithAllDocuments())
+	if err != nil {
+		t.Errorf("Dump([]any{}, WithAllDocuments()): %v", err)
+	}
+	var all []any
+	if err := Load(out, &all, WithAllDocuments()); err != nil || len(all) != 0 {
+		t.Errorf("Load of the empty stream %q: %v %v", out, all, err)
+	}
+}
