+func genTime(tc hegel.TestCase) time.Time {
+	sec := int64(hegel.Draw(tc, hegel.Integers[int64](-62135596800+86400, 253402300799-86400))) // years 1..9999 in every zone
+	nanos := 0
+	if chance(tc, 50) {
+		nanos = n(tc, 0, 999999999)
+	}
+	off := n(tc, -23, 23)*3600 + pick(tc, []int{0, 0, 1800, 2700, 900})*(1-2*n(tc, 0, 1))
+	if chance(tc, 30) {
+		off = 0
+	}
+	loc := time.FixedZone("", off)
+	if off == 0 && chance(tc, 50) {
+		loc = time.UTC
+	}
+	return time.Unix(sec, int64(nanos)).In(loc)
+}
