+package yaml_test
+
+// Hegel properties for go.yaml.in/yaml/v4 (the Hegel zoo, targets/go/yaml).
+//
+// Oracles: go.yaml.in/yaml/v3 (the previous major version, in the same process), goccy/go-yaml
+// (an independent Go implementation, in the same process) and PyYAML with libyaml (a child
+// process) read everything v4's Dump/Marshal/Encoder writes; a value model of our own is
+// written as YAML by a randomised writer of ours so that v4's Load can be checked against the
+// tree a document was written from (yaml.v3 arbitrates every generated document first); v4
+// against itself for value, struct, Node and stream round trips under its dump options.
+// Generated text stays inside YAML 1.2 as all four readers understand it: no YAML 1.1 line
+// breaks (U+0085, U+2028, U+2029), no control characters, no byte order marks.
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"os/exec"
+	"reflect"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+	"unicode"
+
+	goccy "github.com/goccy/go-yaml"
+	yamlv3 "go.yaml.in/yaml/v3"
+	. "go.yaml.in/yaml/v4"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see HACKING.md).
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a
+// failure of the current test case (hegel-go re-raises panics after shrinking, which would
+// abort the test binary and hide every later test).  Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int {
+	return int(hegel.Draw(tc, hegel.Integers[int64](int64(lo), int64(hi))))
+}
+func chance(tc hegel.TestCase, pct int) bool  { return n(tc, 1, 100) <= pct }
+func pick[T any](tc hegel.TestCase, xs []T) T { return xs[n(tc, 0, len(xs)-1)] }
+func note(ht *hegel.T, format string, args ...interface{}) {
+	ht.Note(fmt.Sprintf(format, args...))
+}
+
+// ---------------------------------------------------------------------------------------
+// The value model: a YAML document as a tree, independent of every implementation.
+
+type val struct {
+	kind  string // null bool int uint float string seq map
+	b     bool
+	i     int64
+	u     uint64
+	f     float64
+	s     string
+	items []*val
+	kids  map[string]*val
+	keys  []string // generation order of kids
+}
+
+// Generation modes for strings.
+type strMode struct {
+	noNewline bool // single-line strings only (keys)
+	printable bool // printable runes only (keys)
+}
+
+var asciiPieces = []string{"a", "b", "z", "A", "Z", "0", "7", "_", "-", ".", " ", "  ", "'", "''", "\"", "\\", "#", "=", "[", "]", "{", "}", ",", "/", ":", ": ", "+", "?", "!", "&", "*", "|", ">", "%", "@", "`", "~", "<<", "- ", "e", "x", "o", "n", "t", "y", "null", "true", "yes", "1e3", "0x", "1_0", ".inf", "---", "...", "\t", "1:20", "2001-12-14"}
+var unicodePieces = []string{"é", "ß", "日本", "😀", "\U0010ffff", "Ω", "\u00a0", "ø"}
+var newlinePieces = []string{"\n", "\n\n", "\n "}
+
+func genString(tc hegel.TestCase, m strMode) string {
+	k := n(tc, 0, 7)
+	var sb strings.Builder
+	for i := 0; i < k; i++ {
+		switch n(tc, 1, 10) {
+		case 1, 2:
+			sb.WriteString(pick(tc, unicodePieces))
+		case 3:
+			if !m.noNewline {
+				sb.WriteString(pick(tc, newlinePieces))
+			}
+		default:
+			sb.WriteString(pick(tc, asciiPieces))
+		}
+	}
+	s := sb.String()
+	if m.printable {
+		s = strings.Map(func(r rune) rune {
+			if r == '\n' || r == ' ' || unicode.IsPrint(r) {
+				return r
+			}
+			return 'p'
+		}, s)
+	}
+	if avoidString(s) {
+		// a harmless variant of the same pieces
+		s = "x" + strings.ReplaceAll(s, "\n ", "\n")
+		if avoidString(s) {
+			s = strings.ReplaceAll(s, "\n", " ")
+		}
+	}
+	return s
+}
+
+var twoSignsRe = regexp.MustCompile(`^[-+][-+]`)
+
+// avoidString reports whether s has one of the pinned shapes the general encoder properties
+// must not exercise (each is a bug of its own, see bugs.toml): a multi-line string whose
+// first non-empty line starts with a space or a tab.  Written as a literal block, such a
+// string needs an indentation indicator; v4 writes none when leading newlines precede the
+// space (yaml/2) or when the line starts with a tab (yaml/13), and a wrong one inside
+// sequences at every indent but 2 (yaml/3).
+func avoidString(s string) bool {
+	if !strings.Contains(s, "\n") {
+		return false
+	}
+	for _, line := range strings.Split(s, "\n") {
+		if line == "" {
+			continue
+		}
+		return strings.HasPrefix(line, " ") || strings.HasPrefix(line, "\t")
+	}
+	return false
+}
+
+// resolvesToNonString reports whether yaml.v3 or v4 reads the bare scalar s as something
+// other than a string (an integer, float, bool, null, merge key or timestamp).
+func resolvesToNonString(s string) bool {
+	if strings.ContainsAny(s, "\n#:") && !strings.Contains(s, ":") {
+		return false
+	}
+	if strings.ContainsAny(s, "\n#") {
+		return false
+	}
+	var v any
+	if err := yamlv3.Unmarshal([]byte(s), &v); err == nil {
+		if _, isStr := v.(string); !isStr {
+			return true
+		}
+	}
+	var w any
+	if err := Load([]byte(s), &w); err == nil {
+		if _, isStr := w.(string); !isStr {
+			return true
+		}
+	}
+	return false
+}
+
+// hasYAML11Only reports whether the tree holds a string a YAML 1.1 reader (PyYAML, goccy in
+// places) resolves to a non-string or rejects (sexagesimals, timestamps, `=`, `<<`,
+// y/n/yes/no/on/off), or one of goccy's own quirks: a two-sign prefix read as a number
+// (go-yaml/16), a key ending in `<<` (go-yaml/24), underscores in what would otherwise be a
+// number (`.0_` is 0 for goccy, a string for v4 and yaml.v3).
+func hasYAML11Only(v *val) bool {
+	switch v.kind {
+	case "string":
+		return goccyQuirk(v.s)
+	case "seq":
+		for _, it := range v.items {
+			if hasYAML11Only(it) {
+				return true
+			}
+		}
+	case "map":
+		for k, kid := range v.kids {
+			if goccyQuirk(k) || hasYAML11Only(kid) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func hasNull(v *val) bool {
+	switch v.kind {
+	case "null":
+		return true
+	case "seq":
+		for _, it := range v.items {
+			if hasNull(it) {
+				return true
+			}
+		}
+	case "map":
+		for _, kid := range v.kids {
+			if hasNull(kid) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func goccyQuirk(s string) bool {
+	if yaml11Only(s) || twoSignsRe.MatchString(s) || strings.HasSuffix(s, "<<") {
+		return true
+	}
+	return strings.Contains(s, "_") && resolvesToNonString(strings.ReplaceAll(s, "_", ""))
+}
+
+// genKey draws a map key: single-line and printable.
+func genKey(tc hegel.TestCase) string {
+	if chance(tc, 60) {
+		const alphabet = "abcXYZ019_-."
+		k := n(tc, 1, 6)
+		b := make([]byte, k)
+		for i := range b {
+			b[i] = alphabet[n(tc, 0, len(alphabet)-1)]
+		}
+		if resolvesToNonString(string(b)) {
+			return "k" + string(b)
+		}
+		return string(b)
+	}
+	return genString(tc, strMode{noNewline: true, printable: true})
+}
+
+func genInt64(tc hegel.TestCase) int64 {
+	switch n(tc, 1, 6) {
+	case 1:
+		return int64(n(tc, -10, 10))
+	case 2:
+		return int64(n(tc, -300, 300))
+	case 3:
+		return int64(n(tc, -70000, 70000))
+	case 4:
+		return int64(hegel.Draw(tc, hegel.Integers[int64](math.MinInt32-5, math.MaxInt32+5)))
+	default:
+		return int64(hegel.Draw(tc, hegel.Integers[int64](math.MinInt64, math.MaxInt64)))
+	}
+}
+
+var floatPool = []float64{0, 0.5, -0.5, 1, -1, 1.5, 100, 1e15, 123456.789, 0.1, 0.2, 0.3, 1e-3, 3.14159, -2.5e10, 1.5e300, 2.5e-300, math.MaxFloat64, math.SmallestNonzeroFloat64, 4.9e-324, 0.000123}
+
+// genFloat returns a finite or non-finite float whose shortest representation carries a dot
+// (goccy and PyYAML, YAML 1.1 readers, take `1e+21` for a string) and is not negative zero.
+func genFloat(tc hegel.TestCase, allowNonFinite bool) float64 {
+	var f float64
+	switch n(tc, 1, 10) {
+	case 1, 2, 3:
+		f = pick(tc, floatPool)
+	case 4:
+		if allowNonFinite {
+			f = pick(tc, []float64{math.Inf(1), math.Inf(-1), math.NaN()})
+		} else {
+			f = 2.5
+		}
+	case 5:
+		f = float64(n(tc, -1000, 1000)) / 8
+	default:
+		f = math.Float64frombits(uint64(hegel.Draw(tc, hegel.Integers[int64](math.MinInt64, math.MaxInt64))))
+		if math.IsNaN(f) || math.IsInf(f, 0) {
+			f = 0.75
+		}
+	}
+	if avoidFloat(f) {
+		return f/3 + 0.5
+	}
+	return f
+}
+
+// avoidFloat reports whether f is written with an exponent and no dot (1e+21, 1e-07), which
+// the YAML 1.1 oracles read as strings, or is negative zero (yaml/7).
+func avoidFloat(f float64) bool {
+	if math.IsNaN(f) || math.IsInf(f, 0) {
+		return false
+	}
+	if f == 0 && math.Signbit(f) {
+		return true
+	}
+	s := strconv.FormatFloat(f, 'g', -1, 64)
+	return strings.ContainsAny(s, "eE") && !strings.Contains(s, ".")
+}
+
+func genScalar(tc hegel.TestCase, m strMode, allowNonFinite bool) *val {
+	switch n(tc, 1, 10) {
+	case 1:
+		return &val{kind: "null"}
+	case 2:
+		return &val{kind: "bool", b: chance(tc, 50)}
+	case 3, 4:
+		return &val{kind: "int", i: genInt64(tc)}
+	case 5:
+		if chance(tc, 30) {
+			return &val{kind: "uint", u: uint64(hegel.Draw(tc, hegel.Integers[int64](0, math.MaxInt64))) + uint64(math.MaxInt64) + 1}
+		}
+		return &val{kind: "uint", u: uint64(n(tc, 0, 1000))}
+	case 6, 7:
+		return &val{kind: "float", f: genFloat(tc, allowNonFinite)}
+	default:
+		return &val{kind: "string", s: genString(tc, m)}
+	}
+}
+
+func genVal(tc hegel.TestCase, depth int, m strMode, allowNonFinite bool) *val {
+	if depth > 0 && chance(tc, 35) {
+		if chance(tc, 50) {
+			return genSeq(tc, depth, m, allowNonFinite)
+		}
+		return genMap(tc, depth, m, allowNonFinite)
+	}
+	return genScalar(tc, m, allowNonFinite)
+}
+
+func genSeq(tc hegel.TestCase, depth int, m strMode, allowNonFinite bool) *val {
+	v := &val{kind: "seq", items: []*val{}}
+	k := n(tc, 0, 4)
+	for i := 0; i < k; i++ {
+		v.items = append(v.items, genVal(tc, depth-1, m, allowNonFinite))
+	}
+	return v
+}
+
+func genMap(tc hegel.TestCase, depth int, m strMode, allowNonFinite bool) *val {
+	v := &val{kind: "map", kids: map[string]*val{}}
+	k := n(tc, 0, 4)
+	for i := 0; i < k; i++ {
+		key := genKey(tc)
+		if _, dup := v.kids[key]; dup {
+			continue
+		}
+		v.kids[key] = genVal(tc, depth-1, m, allowNonFinite)
+		v.keys = append(v.keys, key)
+	}
+	return v
+}
+
+// toGo converts the model to the Go values handed to the encoder; integers are spread over
+// the sized Go integer types.
+func toGo(tc hegel.TestCase, v *val) any {
+	switch v.kind {
+	case "null":
+		return nil
+	case "bool":
+		return v.b
+	case "int":
+		i := v.i
+		switch {
+		case i >= math.MinInt8 && i <= math.MaxInt8 && chance(tc, 30):
+			return int8(i)
+		case i >= math.MinInt16 && i <= math.MaxInt16 && chance(tc, 30):
+			return int16(i)
+		case i >= math.MinInt32 && i <= math.MaxInt32 && chance(tc, 30):
+			return int32(i)
+		case chance(tc, 50):
+			return int(i)
+		}
+		return i
+	case "uint":
+		u := v.u
+		switch {
+		case u <= math.MaxUint8 && chance(tc, 30):
+			return uint8(u)
+		case u <= math.MaxUint16 && chance(tc, 30):
+			return uint16(u)
+		case u <= math.MaxUint32 && chance(tc, 30):
+			return uint32(u)
+		case chance(tc, 50):
+			return uint(u)
+		}
+		return u
+	case "float":
+		return v.f
+	case "string":
+		return v.s
+	case "seq":
+		out := make([]any, 0, len(v.items))
+		for _, it := range v.items {
+			out = append(out, toGo(tc, it))
+		}
+		if chance(tc, 20) && len(out) > 0 {
+			// a typed slice when all items share a kind
+			allStr := true
+			for _, it := range v.items {
+				if it.kind != "string" {
+					allStr = false
+				}
+			}
+			if allStr {
+				ss := make([]string, len(out))
+				for i, x := range out {
+					ss[i] = x.(string)
+				}
+				return ss
+			}
+		}
+		return out
+	case "map":
+		out := make(map[string]any, len(v.kids))
+		for k, kid := range v.kids {
+			out[k] = toGo(tc, kid)
+		}
+		if chance(tc, 15) {
+			out2 := make(map[any]any, len(out))
+			for k, x := range out {
+				out2[k] = x
+			}
+			return out2
+		}
+		return out
+	}
+	panic("bad kind " + v.kind)
+}
+
+// ---------------------------------------------------------------------------------------
+// Canonical forms, so that trees from v4, yaml.v3, goccy and the model compare.  Numbers
+// compare by value (v4 writes the float 1 as `1`, which every reader takes for an integer:
+// documented, so the general properties do not hold the int/float distinction against it;
+// the typed-field properties do).
+
+func canonFloat(f float64) string {
+	if math.IsNaN(f) {
+		return "NaN"
+	}
+	if f == math.Trunc(f) && math.Abs(f) < 1<<63 {
+		return strconv.FormatInt(int64(f), 10)
+	}
+	return strconv.FormatFloat(f, 'g', -1, 64)
+}
+
+func canonVal(v *val) any {
+	switch v.kind {
+	case "null":
+		return "null"
+	case "bool":
+		return "b:" + strconv.FormatBool(v.b)
+	case "int":
+		return "n:" + strconv.FormatInt(v.i, 10)
+	case "uint":
+		return "n:" + strconv.FormatUint(v.u, 10)
+	case "float":
+		return "n:" + canonFloat(v.f)
+	case "string":
+		return "s:" + v.s
+	case "seq":
+		out := make([]any, 0, len(v.items))
+		for _, it := range v.items {
+			out = append(out, canonVal(it))
+		}
+		return out
+	case "map":
+		out := make(map[string]any, len(v.kids))
+		for k, kid := range v.kids {
+			out[k] = canonVal(kid)
+		}
+		return out
+	}
+	panic("bad kind")
+}
+
+// canon canonicalises a decoded Go value (from v4, yaml.v3 or goccy).
+func canon(x any) any {
+	switch v := x.(type) {
+	case nil:
+		return "null"
+	case bool:
+		return "b:" + strconv.FormatBool(v)
+	case string:
+		return "s:" + v
+	case float64:
+		return "n:" + canonFloat(v)
+	case float32:
+		return "n:" + canonFloat(float64(v))
+	case time.Time:
+		return "time:" + v.UTC().Format(time.RFC3339Nano)
+	case []byte:
+		return "bytes:" + string(v)
+	case []any:
+		out := make([]any, len(v))
+		for i, it := range v {
+			out[i] = canon(it)
+		}
+		return out
+	case []string:
+		out := make([]any, len(v))
+		for i, it := range v {
+			out[i] = "s:" + it
+		}
+		return out
+	case map[string]any:
+		out := make(map[string]any, len(v))
+		for k, it := range v {
+			out[k] = canon(it)
+		}
+		return out
+	case map[any]any:
+		out := make(map[string]any, len(v))
+		for k, it := range v {
+			out[fmt.Sprint(k)] = canon(it)
+		}
+		return out
+	}
+	rv := reflect.ValueOf(x)
+	switch rv.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		return "n:" + strconv.FormatInt(rv.Int(), 10)
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
+		return "n:" + strconv.FormatUint(rv.Uint(), 10)
+	}
+	return fmt.Sprintf("?:%T(%v)", x, x)
+}
+
+func render(x any) string {
+	b, _ := json.Marshal(x)
+	return string(b)
+}
+
+func sameCanon(a, b any) bool { return reflect.DeepEqual(a, b) }
+
+// ---------------------------------------------------------------------------------------
+// PyYAML (libyaml) as a child process: tagged trees over JSON lines.
+
+const pyyamlScript = `
+import sys, json, yaml
+def node(v):
+    if isinstance(v, bool):
+        return {"t": "bool", "s": "true" if v else "false"}
+    if v is None:
+        return {"t": "null"}
+    if isinstance(v, str):
+        return {"t": "str", "s": v}
+    if isinstance(v, (int, float)):
+        return {"t": "num", "s": repr(v)}
+    if isinstance(v, dict):
+        return {"t": "map", "kids": {(k if isinstance(k, str) else "<" + type(k).__name__ + ">" + str(k)): node(x) for k, x in v.items()}}
+    if isinstance(v, list):
+        return {"t": "seq", "items": [node(x) for x in v]}
+    return {"t": "other", "s": type(v).__name__ + ":" + str(v)}
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        v = yaml.load(req["doc"], Loader=yaml.CSafeLoader)
+        out = {"ok": True, "tree": node(v)}
+    except Exception as e:
+        out = {"ok": False, "err": type(e).__name__ + ": " + str(e)[:300]}
+    sys.stdout.write(json.dumps(out) + "\n")
+    sys.stdout.flush()
+`
+
+type pyNode struct {
+	T     string             `json:"t"`
+	S     string             `json:"s"`
+	Kids  map[string]*pyNode `json:"kids"`
+	Items []*pyNode          `json:"items"`
+}
+
+var (
+	pyOnce  sync.Once
+	pyMu    sync.Mutex
+	pyIn    *bufio.Writer
+	pyOut   *bufio.Reader
+	pyError error
+)
+
+func startPython() {
+	cmd := exec.Command("python3", "-c", pyyamlScript)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		pyError = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		pyError = err
+		return
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		pyError = err
+		return
+	}
+	pyIn, pyOut = bufio.NewWriter(stdin), bufio.NewReader(stdout)
+}
+
+func pyyaml(t testing.TB, doc string) (*pyNode, string) {
+	pyOnce.Do(startPython)
+	if pyError != nil {
+		t.Fatalf("cannot start python3: %v", pyError)
+	}
+	pyMu.Lock()
+	defer pyMu.Unlock()
+	req, _ := json.Marshal(map[string]string{"doc": doc})
+	pyIn.Write(req)
+	pyIn.WriteByte('\n')
+	if err := pyIn.Flush(); err != nil {
+		t.Fatalf("writing to python: %v", err)
+	}
+	line, err := pyOut.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("reading from python: %v", err)
+	}
+	var resp struct {
+		OK   bool    `json:"ok"`
+		Tree *pyNode `json:"tree"`
+		Err  string  `json:"err"`
+	}
+	if err := json.Unmarshal(line, &resp); err != nil {
+		t.Fatalf("bad python response %q: %v", line, err)
+	}
+	if !resp.OK {
+		return nil, resp.Err
+	}
+	return resp.Tree, ""
+}
+
+var (
+	sexagesimalRe = regexp.MustCompile(`^[-+]?[0-9][0-9_]*(:[0-5]?[0-9])+(\.[0-9_]*)?$`)
+	timestampRe   = regexp.MustCompile(`^[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}([Tt ].*)?$`)
+	yaml11BoolRe  = regexp.MustCompile(`^(y|Y|yes|Yes|YES|n|N|no|No|NO|on|On|ON|off|Off|OFF)$`)
+)
+
+// yaml11Only reports whether a YAML 1.1 reader resolves the bare string s to a non-string
+// where YAML 1.2 (v4, yaml.v3) has a string: not v4's concern.
+func yaml11Only(s string) bool {
+	return sexagesimalRe.MatchString(s) || timestampRe.MatchString(s) || yaml11BoolRe.MatchString(s) || s == "=" || s == "<<"
+}
+
+// pyMatch checks PyYAML's tree against the model: strings and structure exactly, numbers by
+// value, booleans and nulls exactly.  Returns "" or a description of the first difference.
+func pyMatch(path string, v *val, p *pyNode) string {
+	if p == nil {
+		return path + ": missing"
+	}
+	switch v.kind {
+	case "null":
+		if p.T != "null" {
+			return fmt.Sprintf("%s: want null, PyYAML has %s %q", path, p.T, p.S)
+		}
+	case "bool":
+		if p.T != "bool" || p.S != strconv.FormatBool(v.b) {
+			return fmt.Sprintf("%s: want bool %v, PyYAML has %s %q", path, v.b, p.T, p.S)
+		}
+	case "int", "uint", "float":
+		if p.T != "num" {
+			return fmt.Sprintf("%s: want a number, PyYAML has %s %q", path, p.T, p.S)
+		}
+		want := v.f
+		if v.kind == "int" {
+			want = float64(v.i)
+		} else if v.kind == "uint" {
+			want = float64(v.u)
+		}
+		got, err := strconv.ParseFloat(p.S, 64)
+		if err != nil || (got != want && !(math.IsNaN(got) && math.IsNaN(want))) {
+			return fmt.Sprintf("%s: want %v, PyYAML has %q", path, want, p.S)
+		}
+	case "string":
+		if yaml11Only(v.s) {
+			return ""
+		}
+		if p.T != "str" || p.S != v.s {
+			return fmt.Sprintf("%s: want string %q, PyYAML has %s %q", path, v.s, p.T, p.S)
+		}
+	case "seq":
+		if p.T != "seq" || len(p.Items) != len(v.items) {
+			return fmt.Sprintf("%s: want a sequence of %d, PyYAML has %s of %d", path, len(v.items), p.T, len(p.Items))
+		}
+		for i, it := range v.items {
+			if d := pyMatch(fmt.Sprintf("%s[%d]", path, i), it, p.Items[i]); d != "" {
+				return d
+			}
+		}
+	case "map":
+		if p.T != "map" || len(p.Kids) != len(v.kids) {
+			return fmt.Sprintf("%s: want a mapping of %d, PyYAML has %s of %d", path, len(v.kids), p.T, len(p.Kids))
+		}
+		for k, kid := range v.kids {
+			if yaml11Only(k) {
+				continue
+			}
+			pk, ok := p.Kids[k]
+			if !ok {
+				return fmt.Sprintf("%s: key %q missing in PyYAML's mapping (keys %v)", path, k, pyKeys(p))
+			}
+			if d := pyMatch(path+"."+k, kid, pk); d != "" {
+				return d
+			}
+		}
+	}
+	return ""
+}
+
+func pyKeys(p *pyNode) []string {
+	var ks []string
+	for k := range p.Kids {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+// ---------------------------------------------------------------------------------------
+// Dump options: the v4 Dump API with random options, the legacy Marshal and the Encoder.
+
+type dumpOpts struct {
+	mode                           string // dump marshal encoder
+	v3                             bool
+	indent                         int // 0: default
+	compact                        int // 0 default, 1 on, 2 off
+	quote                          int // 0 default, 1 single, 2 double, 3 legacy
+	widthSet                       bool
+	width                          int
+	asciiOnly, crlf, explicitStart bool
+	explicitEnd, flowSimple        bool
+}
+
+func genDumpOpts(tc hegel.TestCase) dumpOpts {
+	o := dumpOpts{mode: pick(tc, []string{"dump", "dump", "dump", "dump", "marshal", "encoder"})}
+	switch o.mode {
+	case "encoder":
+		if chance(tc, 50) {
+			o.indent = pick(tc, []int{1, 2, 4, 5, 6, 7, 8, 9}) // indent 3 is yaml/12
+		}
+		o.compact = pick(tc, []int{0, 1, 2})
+	case "dump":
+		o.v3 = chance(tc, 25)
+		if chance(tc, 50) {
+			o.indent = pick(tc, []int{2, 4, 5, 6, 7, 8, 9}) // indent 3 is yaml/12
+		}
+		o.compact = pick(tc, []int{0, 0, 1, 2})
+		o.quote = pick(tc, []int{0, 0, 1, 2, 3})
+		if chance(tc, 30) {
+			o.widthSet = true
+			o.width = pick(tc, []int{-1, 0, 10, 20, 40, 80, 200})
+		}
+		o.asciiOnly = chance(tc, 15)
+		o.crlf = chance(tc, 15)
+		o.explicitStart = chance(tc, 20)
+		o.explicitEnd = chance(tc, 20)
+		o.flowSimple = chance(tc, 25)
+	}
+	return o
+}
+
+func (o dumpOpts) list() []Option {
+	var opts []Option
+	if o.v3 {
+		opts = append(opts, WithV3Defaults())
+	}
+	if o.indent != 0 {
+		opts = append(opts, WithIndent(o.indent))
+	}
+	switch o.compact {
+	case 1:
+		opts = append(opts, WithCompactSeqIndent(true))
+	case 2:
+		opts = append(opts, WithCompactSeqIndent(false))
+	}
+	switch o.quote {
+	case 1:
+		opts = append(opts, WithQuotePreference(QuoteSingle))
+	case 2:
+		opts = append(opts, WithQuotePreference(QuoteDouble))
+	case 3:
+		opts = append(opts, WithQuotePreference(QuoteLegacy))
+	}
+	if o.widthSet {
+		opts = append(opts, WithLineWidth(o.width))
+	}
+	if o.asciiOnly {
+		opts = append(opts, WithUnicode(false))
+	}
+	if o.crlf {
+		opts = append(opts, WithLineBreak(LineBreakCRLN))
+	}
+	if o.explicitStart {
+		opts = append(opts, WithExplicitStart())
+	}
+	if o.explicitEnd {
+		opts = append(opts, WithExplicitEnd())
+	}
+	if o.flowSimple {
+		opts = append(opts, WithFlowSimpleCollections())
+	}
+	return opts
+}
+
+// dump writes in under the options: Dump, the legacy Marshal, or an Encoder.
+func (o dumpOpts) dump(in any) ([]byte, error) {
+	switch o.mode {
+	case "marshal":
+		return Marshal(in)
+	case "encoder":
+		var buf bytes.Buffer
+		enc := NewEncoder(&buf)
+		if o.indent != 0 {
+			enc.SetIndent(o.indent)
+		}
+		switch o.compact {
+		case 1:
+			enc.CompactSeqIndent()
+		case 2:
+			enc.DefaultSeqIndent()
+		}
+		if err := enc.Encode(in); err != nil {
+			return nil, err
+		}
+		if err := enc.Close(); err != nil {
+			return nil, err
+		}
+		return buf.Bytes(), nil
+	}
+	return Dump(in, o.list()...)
+}
+
+func (o dumpOpts) String() string {
+	if o.mode != "dump" {
+		return fmt.Sprintf("mode=%s indent=%d compact=%d", o.mode, o.indent, o.compact)
+	}
+	return fmt.Sprintf("dump v3=%v indent=%d compact=%d quote=%d width=%v/%d ascii=%v crlf=%v start=%v end=%v flowSimple=%v",
+		o.v3, o.indent, o.compact, o.quote, o.widthSet, o.width, o.asciiOnly, o.crlf, o.explicitStart, o.explicitEnd, o.flowSimple)
+}
