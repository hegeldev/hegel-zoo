+func TestHegelUniqueKeysCompareResolvedValues(t *testing.T) {
+	// false duplicates: distinct keys with the same text
+	for _, in := range []map[any]any{{1: "a", "1": "b"}, {true: "a", "true": "b"}, {nil: "a", "null": "b"}, {1.5: "a", "1.5": "b"}} {
