+// yaml/9
+func TestHegelNumericLiteralsIntoDurationFieldsAreConsistent(t *testing.T) {
+	type D struct {
+		D time.Duration `yaml:"d"`
+	}
+	for _, pair := range [][2]string{{"d: 1e9", "d: 1000000000"}, {"d: 1.5e9", "d: 1500000000"}, {"d: 0.0", "d: 0"}, {"d: -1e9", "d: -1000000000"}} {
+		var a, b D
+		ea := Load([]byte(pair[0]), &a)
+		eb := Load([]byte(pair[1]), &b)
+		if (ea == nil) != (eb == nil) || a.D != b.D {
+			t.Errorf("Load(%q) into time.Duration: %v, %v; Load(%q): %v, %v -- the same number spelled as a float and as an integer are treated differently", pair[0], a.D, ea, pair[1], b.D, eb)
+		}
+	}
+}
