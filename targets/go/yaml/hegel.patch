+func mustDump(t *testing.T, v any, opts ...Option) []byte {
+	t.Helper()
+	b, err := Dump(v, opts...)
+	if err != nil {
+		t.Fatalf("Dump(%#v): %v", v, err)
+	}
+	return b
+}
+
+func loadAny(doc []byte) (any, error) {
+	var v any
+	err := Load(doc, &v)
+	return v, err
+}
