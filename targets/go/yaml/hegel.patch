+func TestHegelStringsWhoseFirstContentLineStartsWithATabRoundTrip(t *testing.T) {
+	for _, s := range []string{"\ta\nb", "\n\tb", "\t\na", "\té\n", "\t\n"} {
+		for _, opts := range [][]Option{nil, {WithV3Defaults()}} {
+			in := map[string]any{"k": s}
+			doc := mustDump(t, in, opts...)
+			got, err := loadAny(doc)
+			if err != nil {
+				t.Errorf("Dump(%q) = %q; Load: %v", s, doc, err)
+				continue
+			}
+			if !sameCanon(canon(got), canon(in)) {
+				t.Errorf("Dump(%q) = %q; Load gives %#v", s, doc, got)
+			}
+			var v3 any
+			if err := yamlv3.Unmarshal(doc, &v3); err != nil || !sameCanon(canon(v3), canon(in)) {
+				t.Errorf("Dump(%q) = %q; yaml.v3 reads %#v (%v)", s, doc, v3, err)
+			}
+			if _, perr := pyyaml(t, string(doc)); perr != "" {
+				t.Errorf("Dump(%q) = %q; libyaml rejects it: %s", s, doc, perr)
+			}
+		}
+	}
+	// a tab after the first character, or on a later line, is fine
+	for _, s := range []string{"a\tb\nc", "a\n\tb", " \ta\nb"} {
+		in := map[string]any{"k": s}
+		doc := mustDump(t, in)
+		got, err := loadAny(doc)
+		if err != nil || !sameCanon(canon(got), canon(in)) {
+			t.Errorf("Dump(%q) = %q; Load gives %#v, %v", s, doc, got, err)
+		}
+	}
+}
