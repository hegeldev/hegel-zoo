+func TestHegelLeadingSpaceMultilineStringsInSequencesAreReadableAtEveryIndent(t *testing.T) {
+	in := []any{" a\nb", "x"}
+	check := func(what string, doc []byte, err error) {
+		t.Helper()
+		if err != nil {
+			t.Errorf("%s: %v", what, err)
+			return
+		}
+		got, err := loadAny(doc)
+		if err != nil {
+			t.Errorf("%s wrote %q; Load: %v", what, doc, err)
+			return
+		}
+		if !sameCanon(canon(got), canon(in)) {
+			t.Errorf("%s wrote %q; Load gives %#v", what, doc, got)
+		}
+		var v3 any
+		if err := yamlv3.Unmarshal(doc, &v3); err != nil {
+			t.Errorf("%s wrote %q; yaml.v3 rejects it: %v", what, doc, err)
+		}
+	}
+	doc, err := Marshal(in)
+	check("Marshal", doc, err)
+	for _, ind := range []int{2, 3, 4, 8} {
+		doc, err = Dump(in, WithIndent(ind))
+		check(fmt.Sprintf("Dump(WithIndent(%d))", ind), doc, err)
+		doc, err = Dump(in, WithIndent(ind), WithCompactSeqIndent(false))
+		check(fmt.Sprintf("Dump(WithIndent(%d), WithCompactSeqIndent(false))", ind), doc, err)
+		var buf bytes.Buffer
+		enc := NewEncoder(&buf)
+		enc.SetIndent(ind)
+		err = enc.Encode(in)
+		if err == nil {
+			err = enc.Close()
+		}
+		check(fmt.Sprintf("Encoder.SetIndent(%d)", ind), buf.Bytes(), err)
+	}
+}
