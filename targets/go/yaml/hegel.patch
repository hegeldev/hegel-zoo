+func TestHegelUniqueKeysCompareResolvedValues(t *testing.T) {
+	// false duplicates: distinct keys with the same text
+	for _, in := range []map[any]any{{1: "a", "1": "b"}, {true: "a", "true": "b"}, {nil: "a", "null": "b"}, {1.5: "a", "1.5": "b"}} {
+		doc := mustDump(t, in)
+		var got map[any]any
+		if err := Load(doc, &got); err != nil {
+			t.Errorf("Dump(%#v) = %q; Load: %v", in, doc, err)
+			continue
+		}
+		if len(got) != 2 {
+			t.Errorf("Dump(%#v) = %q; Load gives %#v", in, doc, got)
+		}
+	}
+	for _, doc := range []string{"? [a]\n: 1\n? [b]\n: 2\n", "? {x: 1}\n: 1\n? {x: 2}\n: 2\n"} {
+		var nd Node
+		if err := Load([]byte(doc), &nd); err != nil {
+			t.Errorf("Load(%q) into a Node: %v", doc, err)
+		}
+		var got any
+		if err := Load([]byte(doc), &got); err != nil {
+			t.Errorf("Load(%q): %v", doc, err)
+		}
+	}
+	// missed duplicates: the same key spelled differently
+	for _, doc := range []string{"1: a\n0x1: b\n", "1: a\n01: b\n", "1: a\n+1: b\n", "true: a\nTrue: b\n"} {
+		var got map[any]any
+		if err := Load([]byte(doc), &got); err == nil {
+			t.Errorf("Load(%q) with unique keys (the default) accepted the duplicate key: %#v", doc, got)
