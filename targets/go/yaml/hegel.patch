+// ---------------------------------------------------------------------------------------
+// Numeric literals into typed fields.
+
+func intFits(neg bool, mag uint64, bits int, unsigned bool) bool {
+	if unsigned {
+		return !neg && (bits == 64 || mag < 1<<uint(bits))
+	}
+	if neg {
+		return mag <= 1<<uint(bits-1)
+	}
+	return mag < 1<<uint(bits-1)
+}
+
+var fieldTypes = map[string]reflect.Type{
+	"I": reflect.TypeOf(int(0)), "I8": reflect.TypeOf(int8(0)), "I16": reflect.TypeOf(int16(0)), "I32": reflect.TypeOf(int32(0)), "I64": reflect.TypeOf(int64(0)),
+	"U": reflect.TypeOf(uint(0)), "U8": reflect.TypeOf(uint8(0)), "U16": reflect.TypeOf(uint16(0)), "U32": reflect.TypeOf(uint32(0)), "U64": reflect.TypeOf(uint64(0)),
+	"F32": reflect.TypeOf(float32(0)), "F64": reflect.TypeOf(float64(0)), "Any": reflect.TypeOf((*any)(nil)).Elem(),
+}
+
+// decodeField loads doc into a one-field struct whose field n has the named type.
+func decodeField(doc string, field string) (reflect.Value, error) {
+	st := reflect.StructOf([]reflect.StructField{{Name: "N", Type: fieldTypes[field], Tag: `yaml:"n"`}})
+	ptr := reflect.New(st)
+	err := Load([]byte(doc), ptr.Interface())
+	return ptr.Elem().Field(0), err
+}
+
+// intLit: an integer literal for the typed-field property: a magnitude, a sign (taken only
+// when the magnitude allows it) and a spelling.
+type intLit struct {
+	mag uint64
+	neg bool
+	sp  spelling
+}
+
+func (l intLit) negative() bool { return l.neg && l.mag <= 1<<63 && l.mag > 0 }
+func (l intLit) text() string   { return spellInt(l.negative(), l.mag, l.sp) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (l intLit) GoString() string {
+	return fmt.Sprintf("%s (neg=%v mag=%d)", l.text(), l.negative(), l.mag)
+}
+
+// magnitudes: small, medium, the int64 range, and above it.
+var magnitudes = hegel.OneOf(
+	hegel.Map(hegel.Integers(0, 300), func(x int) uint64 { return uint64(x) }),
+	hegel.Map(hegel.Integers(0, 70000), func(x int) uint64 { return uint64(x) }),
+	hegel.Map(hegel.Integers[int64](0, math.MaxInt64), func(x int64) uint64 { return uint64(x) }),
+	hegel.Map(hegel.Integers[int64](0, math.MaxInt64), func(x int64) uint64 { return uint64(x) + 1<<63 }),
+)
+
+var intLits = hegel.Composite(func(tc hegel.TestCase) intLit {
+	return intLit{mag: hegel.Draw(tc, magnitudes), neg: hegel.Draw(tc, chance(35)), sp: hegel.Draw(tc, intSpells)}
+})
+
+func TestHegelIntegerLiteralsLoadIntoNumericFieldsExactlyWhenTheyFit(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		// magnitude and sign, spelled in one of YAML 1.2's integer forms
+		l := hegel.Draw(ht, intLits)
+		neg, mag := l.negative(), l.mag
+		lit := l.text()
+		doc := "n: " + lit
+		type tf struct {
+			name     string
+			bits     int
+			unsigned bool
+		}
+		for _, f := range []tf{{"I", 64, false}, {"I8", 8, false}, {"I16", 16, false}, {"I32", 32, false}, {"I64", 64, false}, {"U", 64, true}, {"U8", 8, true}, {"U16", 16, true}, {"U32", 32, true}, {"U64", 64, true}} {
+			got, err := decodeField(doc, f.name)
+			fits := intFits(neg, mag, f.bits, f.unsigned)
+			if fits && err != nil {
+				ht.Fatalf("%s fits into %s but: %v", lit, f.name, err)
+			}
+			if !fits {
+				if err == nil {
+					ht.Fatalf("%s does not fit into %s but loaded as %v", lit, f.name, got)
+				}
+				continue
+			}
+			var gotText string
+			if f.unsigned {
+				gotText = strconv.FormatUint(got.Uint(), 10)
+			} else {
+				gotText = strconv.FormatInt(got.Int(), 10)
+			}
+			wantText := strconv.FormatUint(mag, 10)
+			if neg && mag != 0 {
+				wantText = "-" + wantText
+			}
+			if gotText != wantText {
+				ht.Fatalf("%s into %s: want %s got %s", lit, f.name, wantText, gotText)
+			}
+		}
+		// float fields take the value exactly as float64(x) would
+		want := float64(mag)
+		if neg {
+			want = -want
+		}
+		got, err := decodeField(doc, "F64")
+		if err != nil || got.Float() != want {
+			ht.Fatalf("%s into float64: want %v got %v (%v)", lit, want, got, err)
+		}
+		got, err = decodeField(doc, "F32")
+		if err != nil || got.Float() != float64(float32(want)) {
+			ht.Fatalf("%s into float32: want %v got %v (%v)", lit, float32(want), got, err)
+		}
+		// interface{} gets an integer of the right value
+		got, err = decodeField(doc, "Any")
+		if err != nil {
+			ht.Fatalf("%s into interface{}: %v", lit, err)
+		}
+		wantText := strconv.FormatUint(mag, 10)
+		if neg && mag != 0 {
+			wantText = "-" + wantText
+		}
+		x := got.Interface()
+		switch x.(type) {
+		case int, int64, uint64:
+		default:
+			ht.Fatalf("%s into interface{}: %T %v, want an integer", lit, x, x)
+		}
+		if c := canon(x); c != "n:"+wantText {
+			ht.Fatalf("%s into interface{}: want n:%s got %v", lit, wantText, c)
+		}
+	})
+}
+
+// floatLit: a float literal for the typed-field property: the value and a spelling.
+type floatLit struct {
+	f  float64
+	sp spelling
+}
+
+func (l floatLit) text() string { return spellFloat(l.f, l.sp) }
+
+// GoString is what the draw report prints (it uses %#v).
+func (l floatLit) GoString() string { return fmt.Sprintf("%s (float %v)", l.text(), l.f) }
+
+var floatLits = hegel.Composite(func(tc hegel.TestCase) floatLit {
+	return floatLit{f: hegel.Draw(tc, anyFloats), sp: hegel.Draw(tc, floatSpells)}
+})
