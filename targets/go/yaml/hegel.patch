+func TestHegelDumperStreamsAreReadBackDocumentByDocument(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		o := genDumpOpts(ht)
+		if o.mode != "dump" {
+			o = dumpOpts{mode: "dump"}
+		}
+		k := n(ht, 1, 4) // a Dumper that wrote nothing cannot be closed: yaml/11
+		var vals []*val
+		var ins []any
+		for i := 0; i < k; i++ {
+			v := genVal(ht, 2, strMode{}, true)
+			vals = append(vals, v)
+			ins = append(ins, toGo(ht, v))
+		}
+		var buf bytes.Buffer
+		d, err := NewDumper(&buf, o.list()...)
+		if err != nil {
+			ht.Fatalf("NewDumper with %s: %v", o, err)
+		}
+		for _, in := range ins {
+			if err := d.Dump(in); err != nil {
+				ht.Fatalf("Dumper.Dump(%s): %v", render(in), err)
+			}
+		}
+		if err := d.Close(); err != nil {
+			ht.Fatalf("Dumper.Close: %v", err)
+		}
+		stream := buf.Bytes()
+		note(ht, "options: %s\n%d documents:\n%s", o, k, stream)
+		l, err := NewLoader(bytes.NewReader(stream))
+		if err != nil {
+			ht.Fatalf("NewLoader: %v", err)
+		}
+		for i := 0; ; i++ {
+			var got any
+			err := l.Load(&got)
+			if err == io.EOF {
+				if i != k {
+					ht.Fatalf("Loader gave %d documents, %d were dumped", i, k)
+				}
+				break
+			}
+			if err != nil {
+				ht.Fatalf("Loader.Load #%d: %v", i, err)
+			}
+			if i >= k {
+				ht.Fatalf("Loader gave more than the %d documents dumped: %s", k, render(canon(got)))
+			}
+			if want := canonVal(vals[i]); !sameCanon(canon(got), want) {
+				ht.Fatalf("document %d changed:\n want %s\n got  %s", i, render(want), render(canon(got)))
+			}
+		}
+		var all []any
+		if err := Load(stream, &all, WithAllDocuments()); err != nil {
+			ht.Fatalf("Load with WithAllDocuments: %v", err)
+		}
+		if len(all) != k {
+			ht.Fatalf("WithAllDocuments gave %d documents, %d were dumped", len(all), k)
+		}
+		for i, got := range all {
+			if want := canonVal(vals[i]); !sameCanon(canon(got), want) {
+				ht.Fatalf("WithAllDocuments document %d:\n want %s\n got  %s", i, render(want), render(canon(got)))
+			}
+		}
+		// Dump with WithAllDocuments writes the same stream a Dumper does, document for document.
+		doc2, err := Dump(ins, append(o.list(), WithAllDocuments())...)
+		if err != nil {
+			ht.Fatalf("Dump with WithAllDocuments: %v", err)
+		}
+		var all2 []any
+		if err := Load(doc2, &all2, WithAllDocuments()); err != nil {
+			ht.Fatalf("Load of Dump(WithAllDocuments) output: %v\n%s", err, doc2)
+		}
+		if !sameCanon(canon(all2), canon(all)) {
+			ht.Fatalf("Dump(WithAllDocuments) differs from the Dumper:\n%s\nvs\n%s", doc2, stream)
+		}
+	})
+}
