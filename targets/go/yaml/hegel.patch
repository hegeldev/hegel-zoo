+func TestHegelStructsRoundTripThroughDumpAndLoad(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, structCases)
+		o, in := tcase.opts, tcase.in
+		doc, err := o.dump(in)
+		if err != nil {
+			ht.Fatalf("dump(%+v) with %s: %v", in, o, err)
+		}
+		note(ht, "document:\n%s", doc)
+		var got rich
+		if err := Load(doc, &got, WithKnownFields()); err != nil {
+			ht.Fatalf("Load (known fields) of v4's own output: %v", err)
+		}
+		want := *in
+		want.Skip = 0
+		if d := same(reflect.ValueOf(want), reflect.ValueOf(got), "rich"); d != "" {
+			ht.Fatalf("round trip changed a field: %s", d)
+		}
+		var got2 rich
+		if err := Unmarshal(doc, &got2); err != nil {
+			ht.Fatalf("Unmarshal of v4's own output: %v", err)
+		}
+		if d := same(reflect.ValueOf(want), reflect.ValueOf(got2), "rich"); d != "" {
+			ht.Fatalf("Unmarshal round trip changed a field: %s", d)
+		}
+		dec := NewDecoder(bytes.NewReader(doc))
+		dec.KnownFields(true)
+		var got3 rich
+		if err := dec.Decode(&got3); err != nil {
+			ht.Fatalf("Decoder (known fields) of v4's own output: %v", err)
+		}
+	})
+}
