+func TestHegelDumpThenLoadIntoAnInterfaceIsTheIdentity(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		o := genDumpOpts(ht)
+		v := genVal(ht, 3, strMode{}, true)
+		in := toGo(ht, v)
+		doc, err := o.dump(in)
+		if err != nil {
+			ht.Fatalf("dump(%s) with %s: %v", render(in), o, err)
+		}
+		note(ht, "options: %s\nvalue: %s\ndocument:\n%s", o, render(in), doc)
+		want := canonVal(v)
+		var got any
+		if err := Load(doc, &got); err != nil {
+			ht.Fatalf("Load of v4's own output: %v", err)
+		}
+		if !sameCanon(canon(got), want) {
+			ht.Fatalf("round trip changed the value:\n want %s\n got  %s", render(want), render(canon(got)))
+		}
+		var got2 any
+		if err := Unmarshal(doc, &got2); err != nil {
+			ht.Fatalf("Unmarshal of v4's own output: %v", err)
+		}
+		if !sameCanon(canon(got2), want) {
+			ht.Fatalf("Unmarshal differs from Load:\n want %s\n got  %s", render(want), render(canon(got2)))
+		}
+		var got3 any
+		if err := NewDecoder(bytes.NewReader(doc)).Decode(&got3); err != nil {
+			ht.Fatalf("Decoder.Decode: %v", err)
+		}
+		if !sameCanon(canon(got3), want) {
+			ht.Fatalf("Decoder.Decode differs:\n want %s\n got  %s", render(want), render(canon(got3)))
+		}
+		// Through a Node: what was loaded is dumped again and read as the same value.
+		var nd Node
+		if err := Load(doc, &nd); err != nil {
+			ht.Fatalf("Load into a Node: %v", err)
+		}
+		var viaNode any
+		if err := nd.Decode(&viaNode); err != nil {
+			ht.Fatalf("Node.Decode: %v", err)
+		}
+		if !sameCanon(canon(viaNode), want) {
+			ht.Fatalf("Node.Decode differs:\n want %s\n got  %s", render(want), render(canon(viaNode)))
+		}
+		o2 := genDumpOpts(ht)
+		doc2, err := o2.dump(&nd)
+		if err != nil {
+			ht.Fatalf("dump of the Node with %s: %v", o2, err)
+		}
+		var got4 any
+		if err := Load(doc2, &got4); err != nil {
+			ht.Fatalf("Load of the re-dumped Node (%s):\n%s\n%v", o2, doc2, err)
+		}
+		if !sameCanon(canon(got4), want) {
+			ht.Fatalf("Node round trip (%s) changed the value:\n%s\n want %s\n got  %s", o2, doc2, render(want), render(canon(got4)))
+		}
+	})
+}
