+func genFloat32(tc hegel.TestCase) float32 {
+	for i := 0; i < 20; i++ {
+		f := float32(genFloat(tc, false))
+		if math.IsInf(float64(f), 0) {
+			continue
+		}
+		s := strconv.FormatFloat(float64(f), 'g', -1, 32)
+		if strings.ContainsAny(s, "eE") && !strings.Contains(s, ".") {
+			continue
+		}
+		return f
+	}
+	return 1.5
+}
