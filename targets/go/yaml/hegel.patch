+// float32OK reports whether f is finite and its shortest text carries a dot or no exponent
+// (the YAML 1.1 readers take 1e+20 for a string), and is not negative zero.
+func float32OK(f float32) bool {
+	d := float64(f)
+	if math.IsInf(d, 0) || math.IsNaN(d) || (f == 0 && math.Signbit(d)) {
+		return false
+	}
+	s := strconv.FormatFloat(d, 'g', -1, 32)
+	return !strings.ContainsAny(s, "eE") || strings.Contains(s, ".")
+}
+
+// float32s: the pool and the eighths narrowed to 32 bits, or any 32-bit pattern.
+var float32s = hegel.Filter(hegel.OneOf(
+	hegel.Map(hegel.SampledFrom(floatPool), func(f float64) float32 { return float32(f) }),
+	hegel.Map(eighths, func(f float64) float32 { return float32(f) }),
+	hegel.Map(hegel.Integers[int64](0, math.MaxUint32), func(b int64) float32 { return math.Float32frombits(uint32(b)) }),
+), float32OK)
+
+var inners = hegel.Composite(func(tc hegel.TestCase) inner {
+	return inner{A: hegel.Draw(tc, hegel.Integers(-100, 100)), B: hegel.Draw(tc, lineTexts)}
+})
+
+var (
+	smallInts = hegel.Integers(-9, 9)
+	// prefixedKeys: the inline map's keys, distinct from every named field
+	prefixedKeys = hegel.Map(keys, func(k string) string { return "x_" + k })
+	// nodeTexts: the Node field's value, single-line and printable
+	nodeTexts  = texts(strMode{noNewline: true, printable: true})
