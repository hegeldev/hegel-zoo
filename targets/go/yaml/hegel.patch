+	// missed duplicates: the same key spelled differently
+	for _, doc := range []string{"1: a\n0x1: b\n", "1: a\n01: b\n", "1: a\n+1: b\n", "true: a\nTrue: b\n"} {
+		var got map[any]any
+		if err := Load([]byte(doc), &got); err == nil {
+			t.Errorf("Load(%q) with unique keys (the default) accepted the duplicate key: %#v", doc, got)
