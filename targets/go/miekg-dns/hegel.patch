+var tsigAlgs = []string{dns.HmacSHA1, dns.HmacSHA224, dns.HmacSHA256, dns.HmacSHA384, dns.HmacSHA512}
+
+// tsigCase: an uncompressed message (not NOTAUTH while TsigVerify refuses
+// those unverified) and the key it is signed with.
+type tsigCase struct {
+	spec    msgSpec
+	keyName string
+	secret  string // base64
+	alg     string
+	fudge   uint16
+}
+
+var tsigCases = hegel.Composite(func(tc hegel.TestCase) tsigCase {
+	spec := hegel.Draw(tc, msgSpecs)
+	spec.compress = false
+	if Known.tsigVerifyRefusesNotAuth && spec.rcodeValue()&0xF == dns.RcodeNotAuth {
+		spec.rcode = dns.RcodeSuccess
+		if spec.opt != nil {
+			o := *spec.opt
+			o.extRcode = 0
+			spec.opt = &o
+		}
+	}
+	return tsigCase{
+		spec:    spec,
+		keyName: strings.ToLower(hegel.Draw(tc, hostNames)),
+		secret:  hegel.Draw(tc, b64s(1, 64)),
+		alg:     hegel.Draw(tc, hegel.SampledFrom(tsigAlgs)),
+		fudge:   uint16(hegel.Draw(tc, hegel.SampledFrom([]int{300, 60, 3600}))),
+	}
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c tsigCase) GoString() string {
+	return fmt.Sprintf("key %s alg %s fudge %d\n%s", c.keyName, c.alg, c.fudge, c.spec.msg().String())
+}
