+// TestHegelTsigInteroperates: a message signed with TsigGenerate verifies in
+// dnspython, a message signed by dnspython verifies with TsigVerify, and a
+// damaged message verifies in neither.
+func TestHegelTsigInteroperates(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, tsigCases)
+		m, keyName, secret, alg, fudge := tcase.spec.msg(), tcase.keyName, tcase.secret, tcase.alg, tcase.fudge
+
+		// signed here, verified there
+		m.SetTsig(keyName, alg, fudge, time.Now().Unix())
+		signed, mac, err := dns.TsigGenerate(m, secret, "", false)
+		if err != nil {
+			ht.Fatalf("TsigGenerate: %v\n%s", err, m.String())
+		}
+		var pv struct {
+			OK  bool   `json:"ok"`
+			Mac string `json:"mac"`
+			Err string `json:"err"`
+		}
+		if err := py.call(t, map[string]any{"op": "tsig_verify", "wire": hex.EncodeToString(signed), "keyname": keyName, "secret": secret, "alg": alg}, &pv); err != nil {
+			ht.Fatalf("dnspython tsig verify call: %v", err)
+		}
+		if !pv.OK {
+			ht.Fatalf("dnspython rejects a message signed by TsigGenerate: %s\nkey %s alg %s\nwire %s\n%s", pv.Err, keyName, alg, hex.EncodeToString(signed), m.String())
+		}
+		if !strings.EqualFold(pv.Mac, mac) {
+			ht.Fatalf("MAC %s but dnspython read %s", mac, pv.Mac)
+		}
+		// and here again (on a copy: TsigVerify writes into its argument)
+		verified := signed
+		if Known.tsigVerifyMutates {
+			verified = append([]byte(nil), signed...)
+		}
+		if err := dns.TsigVerify(verified, secret, "", false); err != nil {
+			ht.Fatalf("TsigVerify rejects TsigGenerate's own output: %v\nkey %s alg %s\n%s", err, keyName, alg, m.String())
+		}
+		var back dns.Msg
+		if err := back.Unpack(signed); err != nil {
+			ht.Fatalf("Unpack of the signed message: %v", err)
+		}
+		ts := back.IsTsig()
+		if ts == nil {
+			ht.Fatalf("the signed message has no TSIG record after Unpack\nwire %s\n%s", hex.EncodeToString(signed), back.String())
+		}
+		if !strings.EqualFold(ts.Algorithm, alg) || !strings.EqualFold(ts.Hdr.Name, keyName) || int(ts.MACSize)*2 != len(ts.MAC) || !strings.EqualFold(ts.MAC, mac) || ts.Fudge != fudge {
+			ht.Fatalf("TSIG record read back differs: %s (mac %s)", ts.String(), mac)
+		}
+		// a damaged message (the QR bit; the ID is not covered, RFC 8945 5.3.1 restores the original)
+		damaged := append([]byte(nil), signed...)
+		damaged[2] ^= 0x80
+		if err := dns.TsigVerify(damaged, secret, "", false); err == nil {
+			ht.Fatalf("TsigVerify accepts a message with a changed QR bit\nkey %s alg %s", keyName, alg)
+		}
+		if err := py.call(t, map[string]any{"op": "tsig_verify", "wire": hex.EncodeToString(damaged), "keyname": keyName, "secret": secret, "alg": alg}, &pv); err == nil && pv.OK {
+			ht.Fatalf("dnspython accepts a message with a changed QR bit that this library signed")
+		}
+		// wrong secret
+		if err := dns.TsigVerify(signed, b64Of([]byte("other")), "", false); err == nil {
+			ht.Fatalf("TsigVerify accepts the wrong secret")
+		}
+
+		// signed there, verified here (TsigGenerate removed the TSIG stub from m)
+		plain, err := m.Pack()
+		if err != nil {
+			ht.Fatalf("Pack: %v", err)
+		}
+		var ps struct {
+			Wire string `json:"wire"`
+		}
+		if err := py.call(t, map[string]any{"op": "tsig_sign", "wire": hex.EncodeToString(plain), "keyname": keyName, "secret": secret, "alg": alg, "fudge": int(fudge)}, &ps); err != nil {
+			ht.Fatalf("dnspython signing: %v\n%s", err, m.String())
+		}
+		pySigned, _ := hex.DecodeString(ps.Wire)
+		if err := dns.TsigVerify(append([]byte(nil), pySigned...), secret, "", false); err != nil {
+			ht.Fatalf("TsigVerify rejects a message signed by dnspython: %v\nkey %s alg %s\nwire %s\n%s", err, keyName, alg, ps.Wire, m.String())
+		}
+		var back2 dns.Msg
+		if err := back2.Unpack(pySigned); err != nil {
+			ht.Fatalf("Unpack of dnspython's signed message: %v\nwire %s", err, ps.Wire)
+		}
+		if back2.IsTsig() == nil {
+			ht.Fatalf("dnspython's signed message has no TSIG after Unpack")
+		}
+		back2.Extra = back2.Extra[:len(back2.Extra)-1]
+		// (dnspython loses backslashes in URI targets and CAA values: not judged)
+		if !pyLosesBackslash(m) {
+			want, _ := summarize(m)
+			// (dnspython compresses names case-insensitively, so letter case may change)
+			if got, err := summarize(&back2); err != nil || !reflect.DeepEqual(foldSummary(got), foldSummary(want)) {
+				ht.Fatalf("dnspython's signed message carries a different message (%v)\n%s", err, diffSummary(want, got))
+			}
+		}
+	})
+}
