+// Message generation ---------------------------------------------------------
+
+// genMsgRR returns a random record of a type both libraries read, in class IN.
+func genMsgRR(tc hegel.TestCase) dns.RR {
+	for {
+		typ := pick(tc, rrTypes...)
+		// TTLs below 2^31: dnspython reads larger ones as 0 (RFC 2181 section 8)
+		text := fmt.Sprintf("%s %d IN %s %s", genName(tc), u32(tc)&0x7fffffff, typ, genRdata(tc, typ))
+		rr, err := dns.NewRR(text)
+		if err == nil {
+			return rr
+		}
+	}
+}
+
+func genOption(tc hegel.TestCase) dns.EDNS0 {
+	switch n(tc, 0, 12) {
+	case 0:
+		return &dns.EDNS0_NSID{Code: dns.EDNS0NSID, Nsid: hexOf(genBytes(tc, 0, 16))}
+	case 1:
+		o := &dns.EDNS0_SUBNET{Code: dns.EDNS0SUBNET}
+		if chance(tc, 50) {
+			o.Family = 1
+			o.SourceNetmask = uint8(n(tc, 0, 32))
+			o.Address = net.ParseIP(genIP4(tc)).To4().Mask(net.CIDRMask(int(o.SourceNetmask), 32))
+		} else {
+			o.Family = 2
+			o.SourceNetmask = uint8(n(tc, 0, 128))
+			o.Address = net.ParseIP(genIP6(tc)).Mask(net.CIDRMask(int(o.SourceNetmask), 128))
+		}
+		if chance(tc, 30) {
+			o.SourceScope = uint8(n(tc, 0, int(o.SourceNetmask)))
+		}
+		return o
+	case 2:
+		// dnspython reads 8-byte client cookies with 8 to 32 bytes of server cookie
+		size := pick(tc, 8, 16, 24, 40, n(tc, 16, 40))
+		return &dns.EDNS0_COOKIE{Code: dns.EDNS0COOKIE, Cookie: hexOf(genBytes(tc, size, size))}
+	case 3:
+		return &dns.EDNS0_EXPIRE{Code: dns.EDNS0EXPIRE, Expire: u32(tc), Empty: chance(tc, 30)}
+	case 4:
+		return &dns.EDNS0_TCP_KEEPALIVE{Code: dns.EDNS0TCPKEEPALIVE, Timeout: uint16(u16(tc)), Length: uint16(pick(tc, 0, 2))}
+	case 5:
+		return &dns.EDNS0_PADDING{Padding: genBytes(tc, 0, 40)}
+	case 6:
+		return &dns.EDNS0_EDE{InfoCode: uint16(pick(tc, 0, 6, 18, 24, u16(tc))), ExtraText: pick(tc, "", "a", "stale answer", strings.Repeat("x", n(tc, 1, 60)))}
+	case 7:
+		return &dns.EDNS0_DAU{Code: dns.EDNS0DAU, AlgCode: genBytes(tc, 0, 6)}
+	case 8:
+		return &dns.EDNS0_LOCAL{Code: uint16(pick(tc, 65001, 65100, 65534)), Data: genBytes(tc, 0, 20)}
+	case 9:
+		return &dns.EDNS0_LLQ{Code: dns.EDNS0LLQ, Version: uint16(u16(tc)), Opcode: uint16(u16(tc)), Error: uint16(u16(tc)), Id: uint64(u32(tc))<<32 | uint64(u32(tc)), LeaseLife: u32(tc)}
+	case 10:
+		return &dns.EDNS0_UL{Code: dns.EDNS0UL, Lease: u32(tc), KeyLease: uint32(pick(tc, 0, 0, int(u32(tc))))}
+	case 11:
+		return &dns.EDNS0_N3U{Code: dns.EDNS0N3U, AlgCode: genBytes(tc, 0, 3)}
+	default:
+		return &dns.EDNS0_ESU{Code: dns.EDNS0ESU, Uri: pick(tc, "sip:example.com", "tel:+123", "")}
+	}
+}
+
+// genMsg builds a random message: header bits, questions, records in the
+// three sections, an OPT with random options half of the time.
+func genMsg(tc hegel.TestCase) *dns.Msg {
+	m := new(dns.Msg)
+	m.Id = uint16(u16(tc))
+	m.Response = chance(tc, 50)
+	// (no UPDATE: dnspython reads update messages with the semantics of RFC 2136)
+	m.Opcode = pick(tc, dns.OpcodeQuery, dns.OpcodeQuery, dns.OpcodeNotify, dns.OpcodeIQuery, dns.OpcodeStatus, pick(tc, 3, 7, 8, 15))
+	m.Authoritative = chance(tc, 30)
+	m.Truncated = chance(tc, 10)
+	m.RecursionDesired = chance(tc, 60)
+	m.RecursionAvailable = chance(tc, 40)
+	m.Zero = chance(tc, 5)
+	m.AuthenticatedData = chance(tc, 20)
+	m.CheckingDisabled = chance(tc, 20)
+	m.Rcode = pick(tc, dns.RcodeSuccess, dns.RcodeSuccess, dns.RcodeNameError, dns.RcodeServerFailure, dns.RcodeRefused, n(tc, 0, 15))
+	for i := n(tc, 0, 2); i > 0; i-- {
+		q := dns.Question{Name: genName(tc), Qtype: uint16(pick(tc, 1, 28, 15, 255, 252, 6, 16, 65280, u16(tc))), Qclass: uint16(pick(tc, 1, 1, 255, 3, 254))}
+		m.Question = append(m.Question, q)
+	}
+	for i := n(tc, 0, 4); i > 0; i-- {
+		m.Answer = append(m.Answer, genMsgRR(tc))
+	}
+	for i := n(tc, 0, 3); i > 0; i-- {
+		m.Ns = append(m.Ns, genMsgRR(tc))
+	}
+	for i := n(tc, 0, 3); i > 0; i-- {
+		m.Extra = append(m.Extra, genMsgRR(tc))
+	}
+	if chance(tc, 50) {
+		opt := &dns.OPT{Hdr: dns.RR_Header{Name: ".", Rrtype: dns.TypeOPT}}
+		opt.SetUDPSize(uint16(pick(tc, 512, 1232, 4096, 65535, u16(tc))))
+		opt.SetDo(chance(tc, 50))
+		if chance(tc, 20) {
+			opt.SetCo(true)
+		}
+		if chance(tc, 10) {
+			opt.SetVersion(uint8(n(tc, 1, 255)))
+		}
+		if chance(tc, 10) {
+			opt.SetZ(uint16(n(tc, 0, 0x3fff)))
+		}
+		for i := n(tc, 0, 4); i > 0; i-- {
+			opt.Option = append(opt.Option, genOption(tc))
+		}
+		m.Extra = append(m.Extra, opt)
+		if chance(tc, 20) {
+			m.Rcode = n(tc, 16, 4095)
+		}
+	}
+	m.Compress = chance(tc, 50)
+	return m
+}
+
+// Summaries ------------------------------------------------------------------
+
+type rrKey struct {
+	Name  string // owner in wire form, hex
+	Type  uint16
+	Class uint16
+	TTL   uint32
+	Rdata string // uncompressed rdata, hex
+}
+
+type optKey struct {
+	Code uint16
+	Data string
+}
+
+type ednsSummary struct {
+	Version uint8
+	Payload uint16
+	Flags   uint32 // the OPT TTL field: extended rcode, version, DO/CO/Z
+	Options []optKey
+}
+
+type msgSummary struct {
+	ID       uint16
+	Flags    uint16
+	Rcode    int
+	Question []rrKey // TTL and Rdata unused
+	Sections [3][]rrKey
+	Edns     *ednsSummary
+}
+
+func nameHex(name string) string {
+	w, err := packName(name)
+	if err != nil {
+		return "bad:" + name
+	}
+	return hex.EncodeToString(w)
+}
+
+func rrKeyOf(rr dns.RR) rrKey {
+	_, rdata, err := packRR(rr)
+	if err != nil {
+		return rrKey{Name: nameHex(rr.Header().Name), Type: rr.Header().Rrtype, Class: rr.Header().Class, TTL: rr.Header().Ttl, Rdata: "err:" + err.Error()}
+	}
+	return rrKey{Name: nameHex(rr.Header().Name), Type: rr.Header().Rrtype, Class: rr.Header().Class, TTL: rr.Header().Ttl, Rdata: hex.EncodeToString(rdata)}
+}
+
+func sortKeys(ks []rrKey) []rrKey {
+	sort.Slice(ks, func(i, j int) bool { return fmt.Sprint(ks[i]) < fmt.Sprint(ks[j]) })
+	if len(ks) == 0 {
+		return nil
+	}
+	return ks
+}
+
+// optionsOf reads the options out of the packed OPT rdata.
+func optionsOf(opt *dns.OPT) ([]optKey, error) {
+	_, rdata, err := packRR(opt)
+	if err != nil {
+		return nil, err
+	}
+	var out []optKey
+	for off := 0; off < len(rdata); {
+		if off+4 > len(rdata) {
+			return nil, fmt.Errorf("truncated option at %d", off)
+		}
+		code := binary.BigEndian.Uint16(rdata[off:])
+		size := int(binary.BigEndian.Uint16(rdata[off+2:]))
+		off += 4
+		if off+size > len(rdata) {
+			return nil, fmt.Errorf("option %d overruns the rdata", code)
+		}
+		out = append(out, optKey{Code: code, Data: hex.EncodeToString(rdata[off : off+size])})
+		off += size
+	}
+	return out, nil
+}
+
+func headerFlags(m *dns.Msg) uint16 {
+	var f uint16
+	if m.Response {
+		f |= 1 << 15
+	}
+	f |= uint16(m.Opcode&0xF) << 11
+	if m.Authoritative {
+		f |= 1 << 10
+	}
+	if m.Truncated {
+		f |= 1 << 9
+	}
+	if m.RecursionDesired {
+		f |= 1 << 8
+	}
+	if m.RecursionAvailable {
+		f |= 1 << 7
+	}
+	if m.Zero {
+		f |= 1 << 6
+	}
+	if m.AuthenticatedData {
+		f |= 1 << 5
+	}
+	if m.CheckingDisabled {
+		f |= 1 << 4
+	}
+	f |= uint16(m.Rcode & 0xF)
+	return f
+}
+
+func summarize(m *dns.Msg) (msgSummary, error) {
+	s := msgSummary{ID: m.Id, Flags: headerFlags(m), Rcode: m.Rcode}
+	for _, q := range m.Question {
+		s.Question = append(s.Question, rrKey{Name: nameHex(q.Name), Type: q.Qtype, Class: q.Qclass})
+	}
+	for i, sec := range [][]dns.RR{m.Answer, m.Ns, m.Extra} {
+		var ks []rrKey
+		for _, rr := range sec {
+			if opt, ok := rr.(*dns.OPT); ok {
+				if s.Edns != nil {
+					return s, fmt.Errorf("two OPT records")
+				}
+				opts, err := optionsOf(opt)
+				if err != nil {
+					return s, err
+				}
+				// Pack writes the extended rcode into the OPT TTL of the wire form
+				s.Edns = &ednsSummary{Version: opt.Version(), Payload: opt.UDPSize(), Flags: opt.Hdr.Ttl&0x00ffffff | uint32(m.Rcode>>4)<<24, Options: opts}
+				continue
+			}
+			ks = append(ks, rrKeyOf(rr))
+		}
+		s.Sections[i] = sortKeys(ks)
+	}
+	if s.Edns == nil {
+		s.Rcode &= 0xF
+	}
+	return s, nil
+}
+
+type pyMsg struct {
+	ID       int `json:"id"`
+	Flags    int `json:"flags"`
+	Rcode    int `json:"rcode"`
+	Question []struct {
+		Name  string `json:"name"`
+		Type  int    `json:"type"`
+		Class int    `json:"class"`
+	} `json:"question"`
+	Sections [][]struct {
+		Name  string `json:"name"`
+		Type  int    `json:"type"`
+		Class int    `json:"class"`
+		TTL   uint32 `json:"ttl"`
+		Rdata string `json:"rdata"`
+		Text  string `json:"text"`
+	} `json:"sections"`
+	Rewire string `json:"rewire"`
+	Edns   *struct {
+		Version   int    `json:"version"`
+		Payload   int    `json:"payload"`
+		EdnsFlags uint32 `json:"ednsflags"`
+		Options   []struct {
+			Otype int    `json:"otype"`
+			Data  string `json:"data"`
+			Text  string `json:"text"`
+		} `json:"options"`
+	} `json:"edns"`
+}
+
+func (p *pyMsg) summary() msgSummary {
+	s := msgSummary{ID: uint16(p.ID), Flags: uint16(p.Flags), Rcode: p.Rcode}
+	for _, q := range p.Question {
+		s.Question = append(s.Question, rrKey{Name: q.Name, Type: uint16(q.Type), Class: uint16(q.Class)})
+	}
+	for i, sec := range p.Sections {
+		var ks []rrKey
+		for _, r := range sec {
+			ks = append(ks, rrKey{Name: r.Name, Type: uint16(r.Type), Class: uint16(r.Class), TTL: r.TTL, Rdata: r.Rdata})
+		}
+		if i < 3 {
+			s.Sections[i] = sortKeys(ks)
+		}
+	}
+	if p.Edns != nil {
+		e := &ednsSummary{Version: uint8(p.Edns.Version), Payload: uint16(p.Edns.Payload), Flags: p.Edns.EdnsFlags}
+		for _, o := range p.Edns.Options {
+			e.Options = append(e.Options, optKey{Code: uint16(o.Otype), Data: o.Data})
+		}
+		s.Edns = e
+	}
+	return s
+}
+
+func diffSummary(a, b msgSummary) string {
+	var sb strings.Builder
+	if a.ID != b.ID || a.Flags != b.Flags || a.Rcode != b.Rcode {
+		fmt.Fprintf(&sb, " header: id %d/%d flags %#x/%#x rcode %d/%d\n", a.ID, b.ID, a.Flags, b.Flags, a.Rcode, b.Rcode)
+	}
+	if !reflect.DeepEqual(a.Question, b.Question) {
+		fmt.Fprintf(&sb, " question:\n  %v\n  %v\n", a.Question, b.Question)
+	}
+	for i := range a.Sections {
+		if !reflect.DeepEqual(a.Sections[i], b.Sections[i]) {
+			fmt.Fprintf(&sb, " section %d:\n  %v\n  %v\n", i, a.Sections[i], b.Sections[i])
+		}
+	}
+	if !reflect.DeepEqual(a.Edns, b.Edns) {
+		fmt.Fprintf(&sb, " edns:\n  %+v\n  %+v\n", a.Edns, b.Edns)
+	}
+	return sb.String()
+}
+
+// foldSummary lowercases the ASCII letters in names and rdata.
+func foldSummary(s msgSummary) msgSummary {
+	s.Question = append([]rrKey(nil), s.Question...)
+	for i := range s.Question {
+		s.Question[i].Name = foldHex(s.Question[i].Name)
+	}
+	for i := range s.Sections {
+		ks := append([]rrKey(nil), s.Sections[i]...)
+		for j := range ks {
+			ks[j].Name = foldHex(ks[j].Name)
+			ks[j].Rdata = foldHex(ks[j].Rdata)
+		}
+		s.Sections[i] = sortKeys(ks)
+	}
+	return s
+}
+
+func pyLosesBackslash(m *dns.Msg) bool {
+	for _, sec := range [][]dns.RR{m.Answer, m.Ns, m.Extra} {
+		for _, rr := range sec {
+			switch rr.Header().Rrtype {
+			case dns.TypeURI, dns.TypeCAA:
+				if _, rdata, err := packRR(rr); err == nil && bytes.Contains(rdata, []byte{'\\'}) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+func msgLenIsApproximate(m *dns.Msg) bool {
+	for _, sec := range [][]dns.RR{m.Answer, m.Ns, m.Extra} {
+		for _, rr := range sec {
+			if lenIsApproximate(rr.String(), dns.TypeToString[rr.Header().Rrtype]) {
+				return true
+			}
+		}
+	}
+	for _, q := range m.Question {
+		if strings.Contains(q.Name, "\\") {
+			return true
+		}
+	}
+	return false
+}
+
+// Properties ------------------------------------------------------------------
+
+// TestHegelMessagesAgreeWithDnspython: a packed message (compressed or not)
+// is read by dnspython to the same header, questions, records and EDNS data;
+// dnspython's re-serialisation unpacks to the same message; the library's own
+// unpack and repack are byte-stable; Len equals the packed size; Copy is equal.
+func TestHegelMessagesAgreeWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		m := genMsg(tc)
+		want, err := summarize(m)
+		if err != nil {
+			fail(ht, "summarising the generated message: %v\n%s", err, m.String())
+		}
+		note(ht, "message (compress %v):\n%s", m.Compress, m.String())
+		wire, err := m.Pack()
+		if err != nil {
+			fail(ht, "Pack: %v\n%s", err, m.String())
+		}
+		if l := m.Len(); l < len(wire) || (l != len(wire) && !(Known.lenOverestimates && msgLenIsApproximate(m))) {
+			fail(ht, "Len %d but Pack wrote %d bytes (compress %v)\n%s", l, len(wire), m.Compress, m.String())
+		}
+		// dnspython reads it
+		var pm pyMsg
+		if err := py.call(t, map[string]any{"op": "message", "wire": hex.EncodeToString(wire)}, &pm); err != nil {
+			fail(ht, "dnspython rejects the packed message: %v\nwire %s\n%s", err, hex.EncodeToString(wire), m.String())
+		}
+		if got := pm.summary(); !reflect.DeepEqual(got, want) {
+			fail(ht, "dnspython reads the message differently (go / python)\n%s\nwire %s\n%s", diffSummary(want, got), hex.EncodeToString(wire), m.String())
+		}
+		// dnspython's own serialisation unpacks to the same message (dnspython
+		// loses backslashes in URI targets and CAA values on the way: not judged)
+		if pyLosesBackslash(m) {
+			return
+		}
+		rewire, err := hex.DecodeString(pm.Rewire)
+		if err != nil {
+			fail(ht, "bad rewire hex: %v", err)
+		}
+		var fromPy dns.Msg
+		if err := fromPy.Unpack(rewire); err != nil {
+			fail(ht, "Unpack of dnspython's serialisation: %v\nwire %s\n%s", err, pm.Rewire, m.String())
+		}
+		// (dnspython compresses names case-insensitively, so letter case may change)
+		if got, err := summarize(&fromPy); err != nil || !reflect.DeepEqual(foldSummary(got), foldSummary(want)) {
+			fail(ht, "dnspython's serialisation unpacks differently (%v) (go / from python)\n%s\nwire %s\n%s", err, diffSummary(want, got), pm.Rewire, m.String())
+		}
+		// the library's own round trip
+		var back dns.Msg
+		if err := back.Unpack(wire); err != nil {
+			fail(ht, "Unpack of Pack: %v\nwire %s\n%s", err, hex.EncodeToString(wire), m.String())
+		}
+		if got, err := summarize(&back); err != nil || !reflect.DeepEqual(got, want) {
+			fail(ht, "Unpack(Pack) differs (%v) (original / unpacked)\n%s\nwire %s\n%s", err, diffSummary(want, got), hex.EncodeToString(wire), m.String())
+		}
+		back.Compress = m.Compress
+		wire2, err := back.Pack()
+		if err != nil {
+			fail(ht, "Pack of the unpacked message: %v\n%s", err, m.String())
+		}
+		if !bytes.Equal(wire, wire2) {
+			fail(ht, "Pack(Unpack(Pack)) differs (compress %v)\n first  %s\n second %s\n%s", m.Compress, hex.EncodeToString(wire), hex.EncodeToString(wire2), m.String())
+		}
+		// the other compression setting gives the same message
+		other := m.Copy()
+		other.Compress = !m.Compress
+		wire3, err := other.Pack()
+		if err != nil {
+			fail(ht, "Pack (compress %v): %v\n%s", other.Compress, err, m.String())
+		}
+		var back3 dns.Msg
+		if err := back3.Unpack(wire3); err != nil {
+			fail(ht, "Unpack (compress %v): %v\nwire %s\n%s", other.Compress, err, hex.EncodeToString(wire3), m.String())
+		}
+		if got, err := summarize(&back3); err != nil || !reflect.DeepEqual(got, want) {
+			fail(ht, "Unpack(Pack) with compress %v differs (%v)\n%s\n%s", other.Compress, err, diffSummary(want, got), m.String())
+		}
+		if m.Compress && len(wire) > len(wire3) {
+			fail(ht, "compressed form (%d bytes) longer than uncompressed (%d)\n%s", len(wire), len(wire3), m.String())
+		}
+		if got, err := summarize(m.Copy()); err != nil || !reflect.DeepEqual(got, want) {
+			fail(ht, "Copy differs (%v)\n%s\n%s", err, diffSummary(want, got), m.String())
+		}
+		if strings.TrimSpace(m.String()) == "" {
+			fail(ht, "String() is empty")
+		}
+	})
+}
+
+// TestHegelTruncateFits: Truncate(size) leaves a message whose Len is at most
+// the size (or 512), keeps the question and the OPT, drops records only from
+// the end of the sections, sets TC exactly when it dropped something, and
+// changes nothing when the message already fits.
+func TestHegelTruncateFits(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		m := genMsg(tc)
+		m.Truncated = chance(tc, 10)
+		full := m.Len()
+		size := pick(tc, 512, 1232, 4096, 65535, n(tc, 0, 600), full, full-1, full+1, n(tc, 12, full+50))
+		note(ht, "size %d full %d compress %v\n%s", size, full, m.Compress, m.String())
+		before, err := summarize(m)
+		if err != nil {
+			fail(ht, "summarising: %v", err)
+		}
+		c := m.Copy()
+		c.Truncate(size)
+		limit := size
+		if limit < dns.MinMsgSize {
+			limit = dns.MinMsgSize
+		}
+		after, err := summarize(c)
+		if err != nil {
+			fail(ht, "summarising the truncated message: %v", err)
+		}
+		if after.ID != before.ID || after.Rcode != before.Rcode || !reflect.DeepEqual(after.Question, before.Question) || !reflect.DeepEqual(after.Edns, before.Edns) {
+			fail(ht, "Truncate changed the header, question or OPT\n%s\nsize %d\n%s", diffSummary(before, after), size, m.String())
+		}
+		dropped := 0
+		for i, sec := range [][]dns.RR{m.Answer, m.Ns, withoutOPT(m.Extra)} {
+			csec := [][]dns.RR{c.Answer, c.Ns, withoutOPT(c.Extra)}[i]
+			if len(csec) > len(sec) {
+				fail(ht, "Truncate added records to section %d", i)
+			}
+			for j := range csec {
+				if csec[j].String() != sec[j].String() {
+					fail(ht, "Truncate changed record %d of section %d: %s -> %s\nsize %d\n%s", j, i, sec[j], csec[j], size, m.String())
+				}
+			}
+			dropped += len(sec) - len(csec)
+		}
+		if c.Truncated != (m.Truncated || dropped > 0) {
+			fail(ht, "TC %v after dropping %d records (TC before %v)\nsize %d\n%s", c.Truncated, dropped, m.Truncated, size, m.String())
+		}
+		wire, err := c.Pack()
+		if err != nil {
+			fail(ht, "Pack of the truncated message: %v\nsize %d\n%s", err, size, c.String())
+		}
+		if len(wire) > limit && dropped < len(m.Answer)+len(m.Ns)+len(m.Extra)-optCount(m) {
+			fail(ht, "truncated message is %d bytes for size %d (Len %d, compress %v) with %d records left to drop\n%s", len(wire), size, c.Len(), c.Compress, len(c.Answer)+len(c.Ns)+len(c.Extra)-optCount(c)-1, c.String())
+		}
+		if dropped > 0 && len(m.Extra) > optCount(m) && len(c.Extra) > optCount(c) && len(c.Answer) < len(m.Answer) {
+			// answers are dropped before the other sections are emptied
+			fail(ht, "Truncate dropped answers while keeping %d additional records\nsize %d\n%s", len(c.Extra)-optCount(c), size, m.String())
+		}
+		if full <= limit && (dropped > 0 || c.Truncated != m.Truncated) {
+			fail(ht, "Truncate dropped %d records from a message of %d bytes for size %d\n%s", dropped, full, size, m.String())
+		}
+	})
+}
+
+func withoutOPT(rrs []dns.RR) []dns.RR {
+	var out []dns.RR
+	for _, rr := range rrs {
+		if _, ok := rr.(*dns.OPT); !ok {
+			out = append(out, rr)
+		}
+	}
+	return out
+}
+
+func optCount(m *dns.Msg) int {
+	k := 0
+	for _, rr := range m.Extra {
+		if _, ok := rr.(*dns.OPT); ok {
+			k++
+		}
+	}
+	return k
+}
