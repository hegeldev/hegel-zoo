+// TestHegelDnssecPrimitivesAgreeWithDnspython: NSEC3 hashing, DNSKEY key tags
+// and DS digests agree with dnspython.
+func TestHegelDnssecPrimitivesAgreeWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, dnssecCases)
+		name, salt, iter := tcase.name, tcase.salt, tcase.iter
+		// NSEC3
+		pySalt := salt
+		if pySalt == "-" {
+			pySalt = "" // HashName takes the salt as hex, "-" is the presentation form of no salt
+		}
+		got := dns.HashName(name, dns.SHA1, uint16(iter), pySalt)
+		var ph struct {
+			Hash string `json:"hash"`
+		}
+		if err := py.call(t, map[string]any{"op": "nsec3", "name": name, "salt": pySalt, "iter": iter, "alg": 1}, &ph); err != nil {
+			ht.Fatalf("dnspython nsec3_hash(%q, %q, %d): %v", name, salt, iter, err)
+		}
+		if !strings.EqualFold(got, ph.Hash) {
+			ht.Fatalf("HashName(%q, SHA1, %d, %q) = %q, dnspython %q", name, iter, salt, got, ph.Hash)
+		}
+		if got == "" {
+			ht.Fatalf("HashName(%q, SHA1, %d, %q) is empty", name, iter, salt)
+		}
+		// DNSKEY key tag and DS
+		text := fmt.Sprintf("%s 3600 IN DNSKEY %d 3 %d %s", name, tcase.flags, tcase.alg, b64Of(tcase.key))
+		rr, err := dns.NewRR(text)
+		if err != nil {
+			ht.Fatalf("NewRR(%q): %v", text, err)
+		}
+		dk := rr.(*dns.DNSKEY)
+		_, rdata, err := packRR(dk)
+		if err != nil {
+			ht.Fatalf("PackRR(%q): %v", text, err)
+		}
+		var pk struct {
+			Tag int `json:"tag"`
+		}
+		if err := py.call(t, map[string]any{"op": "keytag", "wire": hex.EncodeToString(rdata)}, &pk); err != nil {
+			ht.Fatalf("dnspython key_id: %v\n%s", err, text)
+		}
+		if int(dk.KeyTag()) != pk.Tag {
+			ht.Fatalf("KeyTag %d, dnspython %d\n%s", dk.KeyTag(), pk.Tag, text)
+		}
+		for _, h := range []uint8{dns.SHA1, dns.SHA256, dns.SHA384} {
+			ds := dk.ToDS(h)
+			if ds == nil {
+				ht.Fatalf("ToDS(%d) is nil\n%s", h, text)
+			}
+			var pd struct {
+				Text string `json:"text"`
+				Wire string `json:"wire"`
+			}
+			if err := py.call(t, map[string]any{"op": "ds", "name": name, "wire": hex.EncodeToString(rdata), "alg": int(h)}, &pd); err != nil {
+				ht.Fatalf("dnspython make_ds(%d): %v\n%s", h, err, text)
+			}
+			_, dsWire, err := packRR(ds)
+			if err != nil {
+				ht.Fatalf("PackRR of the DS: %v", err)
+			}
+			if hex.EncodeToString(dsWire) != pd.Wire {
+				ht.Fatalf("ToDS(%d) = %s, dnspython %s\n%s", h, hex.EncodeToString(dsWire), pd.Wire, text)
+			}
+			if ds.KeyTag != dk.KeyTag() || ds.Algorithm != dk.Algorithm || ds.DigestType != h {
+				ht.Fatalf("ToDS(%d) fields %d %d %d differ from the key\n%s", h, ds.KeyTag, ds.Algorithm, ds.DigestType, text)
+			}
+		}
+	})
+}
