+package dns_test
+
+import (
+	"encoding/hex"
+	"fmt"
+	"net"
+	"strings"
+	"testing"
+
+	"github.com/miekg/dns"
+	"hegel.dev/go/hegel"
+)
+
+type pyName struct {
+	Wire      string `json:"wire"`
+	Text      string `json:"text"`
+	Canonical string `json:"canonical"`
+	Labels    int    `json:"labels"`
+	Relation  int    `json:"relation"`
+	Order     int    `json:"order"`
+	Common    int    `json:"common"`
+	Subdomain bool   `json:"subdomain"`
+}
+
+// packName packs a name without compression.
+func packName(name string) ([]byte, error) {
+	buf := make([]byte, 1024)
+	off, err := dns.PackDomainName(name, buf, 0, nil, false)
+	if err != nil {
+		return nil, err
+	}
+	return buf[:off], nil
+}
+
+// genRelated returns a name related to name: itself, a parent, a child, a
+// case variant, or an unrelated name.
+func genRelated(tc hegel.TestCase, name string) string {
+	switch n(tc, 0, 5) {
+	case 0:
+		return name
+	case 1: // a parent
+		labels := dns.SplitDomainName(name)
+		if len(labels) == 0 {
+			return name
+		}
+		k := n(tc, 1, len(labels))
+		if k == len(labels) {
+			return "."
+		}
+		return strings.Join(labels[k:], ".") + "."
+	case 2: // a child
+		if name == "." {
+			return genLabel(tc) + "."
+		}
+		return genLabel(tc) + "." + name
+	case 3: // a case variant
+		var sb strings.Builder
+		for i := 0; i < len(name); i++ {
+			c := name[i]
+			if c >= 'a' && c <= 'z' && chance(tc, 50) {
+				c -= 'a' - 'A'
+			} else if c >= 'A' && c <= 'Z' && chance(tc, 50) {
+				c += 'a' - 'A'
+			}
+			sb.WriteByte(c)
+		}
+		return sb.String()
+	default:
+		return genName(tc)
+	}
+}
+
+// TestHegelNamesAgreeWithDnspython: a name in presentation form packs to the
+// same wire form in this library and in dnspython; unpacking gives text that
+// packs back identically; canonical form, label count and split points,
+// common-suffix count and subdomain relation agree with dnspython (python's
+// dns.name treats names as label sequences, so it is the arbiter of what an
+// escaped name means).
+func TestHegelNamesAgreeWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		name := genName(tc)
+		other := genRelated(tc, name)
+		note(ht, "name %q other %q", name, other)
+
+		var pn pyName
+		perr := py.call(t, map[string]any{"op": "name", "text": name, "other": other}, &pn)
+		labels, ok := dns.IsDomainName(name)
+		wire, gerr := packName(name)
+		if perr != nil {
+			if ok && gerr == nil {
+				fail(ht, "dnspython rejects a name the library packs (%s): %v\nname %q", hex.EncodeToString(wire), perr, name)
+			}
+			note(ht, "both reject %q: go %v/%v python %v", name, ok, gerr, perr)
+			return
+		}
+		if !ok || gerr != nil {
+			fail(ht, "the library rejects a name dnspython accepts (IsDomainName %v, pack %v)\nname %q", ok, gerr, name)
+		}
+		if hex.EncodeToString(wire) != pn.Wire {
+			fail(ht, "wire form differs\n go     %s\n python %s\nname %q", hex.EncodeToString(wire), pn.Wire, name)
+		}
+		// dnspython counts the root label; IsDomainName counts one label for the root name
+		if labels != pn.Labels-1 && name != "." {
+			fail(ht, "IsDomainName counts %d labels, dnspython %d\nname %q", labels, pn.Labels-1, name)
+		}
+		if name == "." {
+			labels = 0
+		}
+		if c := dns.CountLabel(name); c != labels {
+			fail(ht, "CountLabel %d but IsDomainName counted %d\nname %q", c, labels, name)
+		}
+		if sp := dns.Split(name); len(sp) != labels {
+			fail(ht, "Split gives %d offsets for %d labels: %v\nname %q", len(sp), labels, sp, name)
+		} else {
+			for i, off := range sp {
+				if off < 0 || off >= len(name) {
+					fail(ht, "Split offset %d out of range: %v\nname %q", off, sp, name)
+				}
+				if got, _ := dns.NextLabel(name, off); i+1 < len(sp) && got != sp[i+1] {
+					fail(ht, "NextLabel(%d) = %d, Split says %d\nname %q", off, got, sp[i+1], name)
+				}
+				if got, _ := dns.PrevLabel(name, len(sp)-i); got != off {
+					fail(ht, "PrevLabel(%d) = %d, Split says %d\nname %q", len(sp)-i, got, off, name)
+				}
+				suffix := name[off:]
+				sw, err := packName(suffix)
+				if err != nil {
+					fail(ht, "the suffix %q at Split offset %d does not pack: %v\nname %q", suffix, off, err, name)
+				}
+				// the suffix is the tail of the wire form
+				if !strings.HasSuffix(hex.EncodeToString(wire), hex.EncodeToString(sw)) {
+					fail(ht, "the suffix %q at Split offset %d is not a wire suffix\n name   %s\n suffix %s\nname %q", suffix, off, hex.EncodeToString(wire), hex.EncodeToString(sw), name)
+				}
+			}
+		}
+		if parts := dns.SplitDomainName(name); len(parts) != labels {
+			fail(ht, "SplitDomainName gives %d labels for %d: %q\nname %q", len(parts), labels, parts, name)
+		} else if labels > 0 {
+			joined := strings.Join(parts, ".") + "."
+			if jw, err := packName(joined); err != nil || hex.EncodeToString(jw) != pn.Wire {
+				fail(ht, "SplitDomainName labels joined back pack differently (%v)\n labels %q\n joined %s\n name   %s\nname %q", err, parts, hex.EncodeToString(jw), pn.Wire, name)
+			}
+		}
+		// unpack gives text that packs back to the same wire, and that dnspython reads alike
+		s, off, err := dns.UnpackDomainName(wire, 0)
+		if err != nil || off != len(wire) {
+			fail(ht, "UnpackDomainName: %v (off %d of %d)\nname %q", err, off, len(wire), name)
+		}
+		if w2, err := packName(s); err != nil || hex.EncodeToString(w2) != pn.Wire {
+			fail(ht, "unpacked text %q packs differently: %v %s\nname %q", s, err, hex.EncodeToString(w2), name)
+		}
+		var pn2 pyName
+		if err := py.call(t, map[string]any{"op": "name", "text": s}, &pn2); err != nil {
+			fail(ht, "dnspython rejects the unpacked text %q: %v\nname %q", s, err, name)
+		} else if pn2.Wire != pn.Wire {
+			fail(ht, "dnspython reads the unpacked text %q as %s, not %s\nname %q", s, pn2.Wire, pn.Wire, name)
+		}
+		// dnspython's own text reads back the same here
+		if w3, err := packName(pn.Text); err != nil || hex.EncodeToString(w3) != pn.Wire {
+			fail(ht, "dnspython's text %q packs differently: %v %s\nname %q", pn.Text, err, hex.EncodeToString(w3), name)
+		}
+		// canonical form
+		cw, err := packName(dns.CanonicalName(name))
+		if (err != nil || hex.EncodeToString(cw) != pn.Canonical) && !(Known.canonicalKeepsEscapedCase && strings.Contains(name, "\\")) {
+			fail(ht, "CanonicalName %q packs to %s, dnspython's canonical form is %s (%v)\nname %q", dns.CanonicalName(name), hex.EncodeToString(cw), pn.Canonical, err, name)
+		}
+		// relations with the other name
+		if _, ok := dns.IsDomainName(other); !ok {
+			return
+		}
+		if Known.textualDuplicates && (strings.Contains(name, "\\") || strings.Contains(other, "\\")) {
+			return // the comparisons are textual: escape variants of a label differ
+		}
+		if c := dns.CompareDomainName(name, other); c != pn.Common-1 {
+			fail(ht, "CompareDomainName(%q, %q) = %d, dnspython says %d labels in common", name, other, c, pn.Common-1)
+		}
+		if sub := dns.IsSubDomain(other, name); sub != pn.Subdomain {
+			fail(ht, "IsSubDomain(%q, %q) = %v, dnspython says %v", other, name, sub, pn.Subdomain)
+		}
+		// relation 3 = NAMEREL_EQUAL in dnspython
+		if eq := pn.Relation == 3; eq != (hex.EncodeToString(cw) == pn.Canonical && dns.CanonicalName(name) == dns.CanonicalName(other)) {
+			if eq != strings.EqualFold(dns.CanonicalName(name), dns.CanonicalName(other)) {
+				note(ht, "equal names in different escapes: %q %q", name, other)
+			}
+		}
+	})
+}
+
+// TestHegelReverseNamesAgreeWithDnspython: ReverseAddr matches dnspython's
+// reversename for random IPv4 and IPv6 addresses.
+func TestHegelReverseNamesAgreeWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		ip := genIP4(tc)
+		if chance(tc, 50) {
+			ip = genIP6(tc)
+		}
+		got, err := dns.ReverseAddr(ip)
+		var pr struct {
+			Text string `json:"text"`
+		}
+		perr := py.call(t, map[string]any{"op": "reverse", "ip": ip}, &pr)
+		if perr != nil || err != nil {
+			if (perr == nil) != (err == nil) {
+				fail(ht, "ReverseAddr(%q): go %v, python %v", ip, err, perr)
+			}
+			return
+		}
+		if !strings.EqualFold(got, pr.Text) {
+			fail(ht, "ReverseAddr(%q) = %q, dnspython %q", ip, got, pr.Text)
+		}
+		// and the name is fully qualified and parses
+		if !dns.IsFqdn(got) {
+			fail(ht, "ReverseAddr(%q) = %q is not fully qualified", ip, got)
+		}
+		if net.ParseIP(ip) == nil {
+			fail(ht, "generated address %q does not parse", ip)
+		}
+	})
+}
+
+var _ = fmt.Sprintf
