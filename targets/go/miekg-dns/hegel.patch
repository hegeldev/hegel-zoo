+package dns_test
+
+// The dnspython oracle: one python3 child per test binary, fed JSON requests
+// one per line and answering one JSON line each.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"sync"
+	"testing"
+)
+
+const pyScript = `
+import sys, json, base64, binascii
+import dns, dns.name, dns.rdata, dns.rdataclass, dns.rdatatype, dns.message, dns.rrset, dns.edns, dns.dnssec, dns.tsig, dns.zone, dns.reversename, dns.flags, dns.opcode, dns.rcode, dns.rdtypes.ANY.DNSKEY, dns.exception
+
+ROOT = dns.name.root
+
+def rr_out(name, rd, ttl):
+    try:
+        text = rd.to_text()
+    except Exception as e:  # HIP servers are printed through IDNA decoding, which may fail
+        text = None
+    return {"name": name.to_wire().hex(), "type": rd.rdtype, "class": rd.rdclass, "ttl": ttl, "rdata": rd.to_wire(origin=None).hex(), "text": text}
+
+def sections(m):
+    out = []
+    for sec in (m.answer, m.authority, m.additional):
+        rrs = []
+        for rrset in sec:
+            for rd in rrset:
+                rrs.append(rr_out(rrset.name, rd, rrset.ttl))
+        out.append(rrs)
+    return out
+
+def message_out(m):
+    res = {"id": m.id, "flags": m.flags, "opcode": dns.opcode.from_flags(m.flags), "rcode": m.rcode(),
+           "question": [{"name": q.name.to_wire().hex(), "type": q.rdtype, "class": q.rdclass} for q in m.question],
+           "sections": sections(m), "rewire": m.to_wire().hex()}
+    if m.opt is not None:
+        res["edns"] = {"version": m.edns, "payload": m.payload, "ednsflags": m.ednsflags,
+                       "options": [{"otype": o.otype, "data": o.to_wire().hex(), "text": o.to_text()} for o in m.options]}
+    return res
+
+def handle(req):
+    op = req["op"]
+    if op == "version":
+        return {"version": dns.version.version}
+    if op == "rdata":
+        rd = dns.rdata.from_text(req["class"], req["type"], req["text"], origin=ROOT, relativize=False)
+        w = rd.to_wire(origin=None)
+        rd2 = dns.rdata.from_wire(rd.rdclass, rd.rdtype, w, 0, len(w))
+        return {"wire": w.hex(), "text": rd.to_text(), "rewire": rd2.to_wire(origin=None).hex(), "retext": rd2.to_text()}
+    if op == "rdata_wire":
+        w = bytes.fromhex(req["wire"])
+        rd = dns.rdata.from_wire(req["class"], req["type"], w, 0, len(w))
+        try:
+            rd2 = dns.rdata.from_text(rd.rdclass, rd.rdtype, rd.to_text(), origin=ROOT, relativize=False)
+            textwire = rd2.to_wire(origin=None).hex()
+        except Exception as e:  # dnspython's own text round trip is not under test
+            textwire = None
+        return {"text": rd.to_text(), "rewire": rd.to_wire(origin=None).hex(), "textwire": textwire}
+    if op == "name":
+        n = dns.name.from_text(req["text"], origin=ROOT)
+        res = {"wire": n.to_wire().hex(), "text": n.to_text(), "canonical": n.canonicalize().to_wire().hex(), "labels": len(n.labels)}
+        if "other" in req:
+            o = dns.name.from_text(req["other"], origin=ROOT)
+            rel, order, nlabels = n.fullcompare(o)
+            res["relation"] = int(rel)
+            res["order"] = order
+            res["common"] = nlabels
+            res["subdomain"] = n.is_subdomain(o)
+        return res
+    if op == "name_wire":
+        n, used = dns.name.from_wire(bytes.fromhex(req["wire"]), 0)
+        return {"text": n.to_text(), "used": used}
+    if op == "reverse":
+        return {"text": dns.reversename.from_address(req["ip"]).to_text()}
+    if op == "message":
+        m = dns.message.from_wire(bytes.fromhex(req["wire"]), one_rr_per_rrset=True, ignore_trailing=False)
+        return message_out(m)
+    if op == "nsec3":
+        return {"hash": dns.dnssec.nsec3_hash(req["name"], req["salt"], req["iter"], req["alg"])}
+    if op == "keytag":
+        rd = dns.rdata.from_wire("IN", "DNSKEY", bytes.fromhex(req["wire"]), 0, len(bytes.fromhex(req["wire"])))
+        return {"tag": dns.dnssec.key_id(rd)}
+    if op == "ds":
+        w = bytes.fromhex(req["wire"])
+        rd = dns.rdata.from_wire("IN", "DNSKEY", w, 0, len(w))
+        ds = dns.dnssec.make_ds(dns.name.from_text(req["name"]), rd, req["alg"], policy=dns.dnssec.allow_all_policy)
+        return {"text": ds.to_text(), "wire": ds.to_wire(origin=None).hex()}
+    if op == "tsig_verify":
+        keyring = {dns.name.from_text(req["keyname"]): dns.tsig.Key(req["keyname"], req["secret"], req["alg"])}
+        try:
+            m = dns.message.from_wire(bytes.fromhex(req["wire"]), keyring=keyring, request_mac=bytes.fromhex(req.get("requestMac", "")))
+            return {"ok": True, "mac": m.mac.hex()}
+        except dns.exception.DNSException as e:
+            return {"ok": False, "err": type(e).__name__ + ": " + str(e)[:200]}
+    if op == "tsig_sign":
+        m = dns.message.from_wire(bytes.fromhex(req["wire"]), one_rr_per_rrset=True)  # keep duplicate records
+        key = dns.tsig.Key(req["keyname"], req["secret"], req["alg"])
+        m.use_tsig(key, fudge=req.get("fudge", 300))
+        return {"wire": m.to_wire().hex()}
+    if op == "zone":
+        z = dns.zone.from_text(req["text"], origin=req["origin"], relativize=False, check_origin=False, allow_include=False)
+        rrs = []
+        for name, node in z.nodes.items():
+            for rdataset in node.rdatasets:
+                for rd in rdataset:
+                    rrs.append(rr_out(name, rd, rdataset.ttl))
+        return {"rrs": rrs}
+    return {"error": "unknown op " + op}
+
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        res = handle(req)
+    except Exception as e:
+        res = {"error": type(e).__name__ + ": " + str(e)[:300]}
+    sys.stdout.write(json.dumps(res) + "\n")
+    sys.stdout.flush()
+`
+
+type python struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Scanner
+}
+
+var (
+	pyOnce sync.Once
+	pyInst *python
+	pyErr  error
+)
+
+// oracle starts (once) the dnspython child and returns it.
+func oracle(t *testing.T) *python {
+	t.Helper()
+	pyOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pyScript)
+		cmd.Stderr = os.Stderr
+		stdin, err := cmd.StdinPipe()
+		if err != nil {
+			pyErr = err
+			return
+		}
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			pyErr = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			pyErr = fmt.Errorf("starting python3: %v", err)
+			return
+		}
+		sc := bufio.NewScanner(stdout)
+		sc.Buffer(make([]byte, 1<<20), 64<<20)
+		pyInst = &python{cmd: cmd, in: bufio.NewWriter(stdin), out: sc}
+		var v struct {
+			Version string `json:"version"`
+			Error   string `json:"error"`
+		}
+		if err := pyInst.rawCall(map[string]any{"op": "version"}, &v); err != nil || v.Version == "" {
+			pyErr = fmt.Errorf("python3 with the dnspython package is needed as the oracle (%v %s)", err, v.Error)
+			return
+		}
+		fmt.Printf("oracle: dnspython %s\n", v.Version)
+	})
+	if pyErr != nil {
+		t.Fatalf("%v", pyErr)
+	}
+	return pyInst
+}
+
+type oracleError struct{ msg string }
+
+func (e *oracleError) Error() string { return e.msg }
+
+func (g *python) rawCall(req map[string]any, res any) error {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		return err
+	}
+	if _, err := g.in.Write(append(b, '\n')); err != nil {
+		return err
+	}
+	if err := g.in.Flush(); err != nil {
+		return err
+	}
+	if !g.out.Scan() {
+		return fmt.Errorf("the python oracle exited: %v", g.out.Err())
+	}
+	var probe struct {
+		Error string `json:"error"`
+	}
+	line := g.out.Bytes()
+	if err := json.Unmarshal(line, &probe); err != nil {
+		return fmt.Errorf("bad oracle reply %q: %v", line, err)
+	}
+	if probe.Error != "" {
+		return &oracleError{probe.Error}
+	}
+	return json.Unmarshal(line, res)
+}
+
+// call asks the oracle; a python-side exception is returned as *oracleError
+// (the caller decides whether that is a legitimate rejection), any other
+// failure is fatal.
+func (g *python) call(t *testing.T, req map[string]any, res any) error {
+	t.Helper()
+	err := g.rawCall(req, res)
+	if err != nil {
+		if _, ok := err.(*oracleError); ok {
+			return err
+		}
+		t.Fatalf("oracle: %v", err)
+	}
+	return nil
+}
