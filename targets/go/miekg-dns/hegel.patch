+package dns_test
+
+// Generators: domain names in presentation form, and resource records as
+// "owner TTL class TYPE rdata" text in the syntax both libraries read.
+
+import (
+	"encoding/base32"
+	"encoding/base64"
+	"encoding/hex"
+	"fmt"
+	"net"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/miekg/dns"
+	"hegel.dev/go/hegel"
+)
+
+// Names -----------------------------------------------------------------------
+
+var labelPool = []string{
+	"a", "b", "www", "mail", "example", "com", "net", "org", "arpa", "in-addr", "_sip", "_tcp",
+	"xn--4gbwdl", "A", "Example", "COM", "x-y", "a1", "9", "_", "-a", "a-", "aa", "ab", "abc",
+	"foo", "bar", "baz", "z", "Z",
+}
+
+// genLabel returns one label in presentation form (escapes included).
+func genLabel(tc hegel.TestCase) string {
+	switch n(tc, 0, 9) {
+	case 0:
+		// an escaped byte: \DDD
+		return pick(tc, labelPool...) + fmt.Sprintf("\\%03d", pick(tc, 0, 32, 46, 64, 92, 127, 128, 200, 255, n(tc, 0, 255)))
+	case 1:
+		// an escaped dot, backslash or other character
+		return pick(tc, labelPool...) + pick(tc, "\\.", "\\\\", "\\a", "\\ ", "\\;", "\\(", "\\@", "\\$") + pick(tc, "", "x")
+	case 2:
+		return strings.Repeat(pick(tc, "a", "b", "Q"), n(tc, 1, 63))
+	case 3:
+		return strings.ToUpper(pick(tc, labelPool...))
+	default:
+		return pick(tc, labelPool...)
+	}
+}
+
+// genName returns an absolute name in presentation form.
+func genName(tc hegel.TestCase) string {
+	if chance(tc, 5) {
+		return "."
+	}
+	var labels []string
+	for i := n(tc, 1, 4); i > 0; i-- {
+		labels = append(labels, genLabel(tc))
+	}
+	return strings.Join(labels, ".") + "."
+}
+
+// genHostName returns a plain LDH absolute name (no escapes).
+func genHostName(tc hegel.TestCase) string {
+	var labels []string
+	for i := n(tc, 1, 3); i > 0; i-- {
+		labels = append(labels, pick(tc, labelPool[:16]...))
+	}
+	return strings.Join(labels, ".") + "."
+}
+
+// Bytes and encodings -------------------------------------------------------
+
+func genBytes(tc hegel.TestCase, lo, hi int) []byte {
+	b := make([]byte, n(tc, lo, hi))
+	for i := range b {
+		b[i] = byte(n(tc, 0, 255))
+	}
+	return b
+}
+
+func hexOf(b []byte) string { return hex.EncodeToString(b) }
+
+func b64Of(b []byte) string { return base64.StdEncoding.EncodeToString(b) }
+
+var b32hex = base32.HexEncoding.WithPadding(base32.NoPadding)
+
+func genIP4(tc hegel.TestCase) string {
+	return fmt.Sprintf("%d.%d.%d.%d", n(tc, 0, 255), n(tc, 0, 255), n(tc, 0, 255), n(tc, 0, 255))
+}
+
+func genIP6(tc hegel.TestCase) string {
+	switch n(tc, 0, 5) {
+	case 0:
+		return "::"
+	case 1:
+		return "::1"
+	case 2:
+		return "::ffff:" + genIP4(tc)
+	case 3:
+		return fmt.Sprintf("2001:db8::%x", n(tc, 1, 65535))
+	default:
+		ip := make(net.IP, 16)
+		for i := range ip {
+			if chance(tc, 40) {
+				ip[i] = 0
+			} else {
+				ip[i] = byte(n(tc, 0, 255))
+			}
+		}
+		return ip.String()
+	}
+}
+
+// genGatewayIP6 is genIP6 without IPv4-mapped addresses while the library
+// rejects them as IPSECKEY/AMTRELAY gateways and SVCB ipv6hints.
+func genGatewayIP6(tc hegel.TestCase) string {
+	for {
+		ip := genIP6(tc)
+		if !Known.mappedGatewayRejected || net.ParseIP(ip).To4() == nil {
+			return ip
+		}
+	}
+}
+
+// Character strings -----------------------------------------------------------
+
+// genCharString returns a quoted <character-string> of at most 255 octets
+// with escapes both libraries read: \" \\ \DDD.
+func genCharString(tc hegel.TestCase, maxLen int) string {
+	return genCharStringOpt(tc, maxLen, false)
+}
+
+// genCharStringOpt is genCharString; asciiOnly keeps the \DDD escapes below
+// 128 (dnspython reads the NAPTR and ISDN strings as text and writes them in
+// UTF-8, so a high byte does not survive it).
+func genCharStringOpt(tc hegel.TestCase, maxLen int, asciiOnly bool) string {
+	var sb strings.Builder
+	sb.WriteByte('"')
+	size := 0
+	for i := n(tc, 0, 6); i > 0 && size < maxLen; i-- {
+		switch n(tc, 0, 7) {
+		case 0:
+			sb.WriteString("\\\"")
+		case 1:
+			sb.WriteString("\\\\")
+		case 2:
+			b := pick(tc, 0, 10, 32, 34, 92, 127, 128, 255, n(tc, 0, 255))
+			if asciiOnly {
+				b &= 127
+			}
+			sb.WriteString(fmt.Sprintf("\\%03d", b))
+		case 3:
+			sb.WriteString(" ")
+		case 4:
+			w := strings.Repeat(pick(tc, "x", "ab"), n(tc, 1, 40))
+			if size+len(w) > maxLen {
+				w = w[:maxLen-size]
+			}
+			sb.WriteString(w)
+			size += len(w) - 1
+		default:
+			sb.WriteString(pick(tc, "a", "hello", "v=spf1 -all", "app-name:X", "0123456789", "~", "=", "/", ";", "(", ")", "@"))
+		}
+		size++
+	}
+	sb.WriteByte('"')
+	return sb.String()
+}
+
+// Type names both libraries know (for NSEC/CSYNC bitmaps and RRSIG covers).
+var typeNamePool = []string{"A", "NS", "CNAME", "SOA", "PTR", "MX", "TXT", "AAAA", "SRV", "NAPTR", "DS", "RRSIG", "NSEC", "DNSKEY", "NSEC3", "NSEC3PARAM", "TLSA", "CAA", "HTTPS", "SVCB", "TYPE1234", "TYPE65280", "URI", "OPENPGPKEY", "ZONEMD", "SPF", "HINFO", "CERT", "LOC", "APL"}
+
+func genTypeList(tc hegel.TestCase, lo, hi int) string {
+	seen := map[string]bool{}
+	var out []string
+	for i := n(tc, lo, hi); i > 0; i-- {
+		t := pick(tc, typeNamePool...)
+		if !seen[t] {
+			seen[t] = true
+			out = append(out, t)
+		}
+	}
+	if Known.unsortedTypeBitmap {
+		sort.Slice(out, func(i, j int) bool { return typeCode(out[i]) < typeCode(out[j]) })
+	}
+	return strings.Join(out, " ")
+}
+
+// typeCode returns the numeric type of a mnemonic (TYPEnnn or a known name).
+func typeCode(s string) int {
+	if strings.HasPrefix(s, "TYPE") {
+		v, _ := strconv.Atoi(s[4:])
+		return v
+	}
+	return int(dns.StringToType[s])
+}
+
+func u16(tc hegel.TestCase) int { return pick(tc, 0, 1, 10, 255, 256, 65535, n(tc, 0, 65535)) }
+
+func u32(tc hegel.TestCase) uint32 {
+	return uint32(pick(tc, 0, 1, 3600, 86400, 2147483647, 2147483648, 4294967295, n(tc, 0, 1<<31-1)))
+}
+
+func u8(tc hegel.TestCase) int { return pick(tc, 0, 1, 2, 3, 8, 13, 15, 255, n(tc, 0, 255)) }
+
+// genTime returns an RRSIG time as YYYYMMDDHHmmSS.
+func genTime(tc hegel.TestCase) string {
+	y := pick(tc, 1971, 2000, 2026, 2038, 2100, 2105, n(tc, 1971, 2105))
+	mo := n(tc, 1, 12)
+	d := n(tc, 1, 28)
+	return fmt.Sprintf("%04d%02d%02d%02d%02d%02d", y, mo, d, n(tc, 0, 23), n(tc, 0, 59), n(tc, 0, 59))
+}
+
+// LOC sizes with an exact cm mantissa/exponent representation.
+var locSizes = []string{"0.01m", "0.05m", "0.3m", "1m", "7m", "40m", "500m", "6000m", "90000m", "800000m", "9000000m", "10000000m", "90000000m", "900000000m", "1m", "1m"}
+
+// locMillis returns the fractional part of LOC seconds; exact binary fractions
+// while the float truncation bug is open.
+func locMillis(tc hegel.TestCase) int {
+	if Known.locFloatTruncation {
+		return pick(tc, 0, 125, 250, 375, 500, 625, 750, 875)
+	}
+	return n(tc, 0, 999)
+}
+
+func genLOC(tc hegel.TestCase) string {
+	lat := fmt.Sprintf("%d %d %d.%03d %s", n(tc, 0, 89), n(tc, 0, 59), n(tc, 0, 59), locMillis(tc), pick(tc, "N", "S"))
+	switch {
+	case chance(tc, 20):
+		lat = fmt.Sprintf("%d %s", n(tc, 0, 90), pick(tc, "N", "S"))
+	case !Known.locMinutesNeedSeconds && chance(tc, 30):
+		lat = fmt.Sprintf("%d %d %s", n(tc, 0, 89), n(tc, 0, 59), pick(tc, "N", "S"))
+	}
+	lon := fmt.Sprintf("%d %d %d.%03d %s", n(tc, 0, 179), n(tc, 0, 59), n(tc, 0, 59), locMillis(tc), pick(tc, "E", "W"))
+	switch {
+	case chance(tc, 20):
+		lon = fmt.Sprintf("%d %s", n(tc, 0, 180), pick(tc, "E", "W"))
+	case !Known.locMinutesNeedSeconds && chance(tc, 30):
+		lon = fmt.Sprintf("%d %d %s", n(tc, 0, 179), n(tc, 0, 59), pick(tc, "E", "W"))
+	}
+	// altitude within RFC 1876's range; while the float truncation bug is open the
+	// fractions are exact binary fractions (dnspython truncates 0.58*100 to 57 too)
+	cents := n(tc, 0, 99)
+	if Known.locFloatTruncation {
+		cents = pick(tc, 0, 25, 50, 75)
+	}
+	alt := fmt.Sprintf("%d.%02dm", pick(tc, 0, 10, -24, -99999, 42849672, n(tc, -99999, 42849671)), cents)
+	if chance(tc, 30) {
+		alt = fmt.Sprintf("%dm", n(tc, -100000, 42849672))
+	}
+	out := lat + " " + lon + " " + alt
+	for i := n(tc, 0, 3); i > 0; i-- {
+		out += " " + pick(tc, locSizes...)
+	}
+	return out
+}
+
+func genSVCBParams(tc hegel.TestCase) string {
+	var params []string
+	keys := map[string]bool{}
+	add := func(k, v string) {
+		if !keys[k] {
+			keys[k] = true
+			params = append(params, v)
+		}
+	}
+	for i := n(tc, 0, 4); i > 0; i-- {
+		switch n(tc, 0, 7) {
+		case 0:
+			add("alpn", "alpn="+pick(tc, "h2", "h3", "\"h2,h3\"", "\"h3,h2,http/1.1\"", "dot"))
+		case 1:
+			add("port", fmt.Sprintf("port=%d", u16(tc)))
+		case 2:
+			add("ipv4hint", "ipv4hint="+genIP4(tc)+pick(tc, "", ","+genIP4(tc)))
+		case 3:
+			add("ipv6hint", "ipv6hint="+genGatewayIP6(tc)+pick(tc, "", ","+genGatewayIP6(tc)))
+		case 4:
+			// RFC 9460 7.1.1: only self-consistent with alpn (dnspython checks)
+			if keys["alpn"] {
+				add("no-default-alpn", "no-default-alpn")
+			}
+		case 5:
+			add("ech", "ech="+b64Of(genBytes(tc, 1, 20)))
+		case 6:
+			add("dohpath", "dohpath="+pick(tc, "/dns-query{?dns}", "\"/q{?dns}\""))
+		default:
+			k := pick(tc, 65280, 65500, 65534)
+			add(fmt.Sprintf("key%d", k), fmt.Sprintf("key%d=%s", k, pick(tc, "\"a b\"", "abc", "\"\"", "\"x\\\\y\"")))
+		}
+	}
+	if keys["alpn"] && chance(tc, 40) {
+		params = append(params, "mandatory="+pick(tc, "alpn", "alpn,port", "port"))
+		if !keys["port"] {
+			params = append(params, fmt.Sprintf("port=%d", u16(tc)))
+		}
+	}
+	return strings.Join(params, " ")
+}
+
+// Records ---------------------------------------------------------------------
+
+// rrTypes are the record types both libraries read from text.
+var rrTypes = []string{
+	"A", "AAAA", "NS", "CNAME", "PTR", "DNAME", "NSAP-PTR", "MX", "KX", "RT", "AFSDB", "LP", "SOA", "TXT", "SPF",
+	"AVC", "NINFO", "RESINFO", "HINFO", "ISDN", "X25", "RP", "PX", "GPOS", "SRV", "NAPTR", "CERT", "LOC", "RRSIG",
+	"NSEC", "NSEC3", "NSEC3PARAM", "DS", "CDS", "DLV", "DNSKEY", "CDNSKEY", "SSHFP", "TLSA", "SMIMEA", "HIP",
+	"OPENPGPKEY", "DHCID", "CAA", "URI", "EUI48", "EUI64", "ZONEMD", "CSYNC", "L32", "L64", "NID", "AMTRELAY",
+	"IPSECKEY", "APL", "SVCB", "HTTPS", "TYPE65280", "TYPE1234",
+}
+
+// genRdata returns the presentation rdata of a record of the type.
+func genRdata(tc hegel.TestCase, typ string) string {
+	switch typ {
+	case "A":
+		return genIP4(tc)
+	case "AAAA":
+		return genIP6(tc)
+	case "NS", "CNAME", "PTR", "DNAME", "NSAP-PTR":
+		return genName(tc)
+	case "MX", "KX", "RT", "AFSDB", "LP":
+		return fmt.Sprintf("%d %s", u16(tc), genName(tc))
+	case "SOA":
+		return fmt.Sprintf("%s %s %d %d %d %d %d", genName(tc), genName(tc), u32(tc), u32(tc), u32(tc), u32(tc), u32(tc))
+	case "TXT", "SPF", "AVC", "NINFO", "RESINFO":
+		var parts []string
+		for i := n(tc, 1, 4); i > 0; i-- {
+			if chance(tc, 20) {
+				parts = append(parts, pick(tc, "abc", "v=spf1", "x", "0"))
+			} else {
+				parts = append(parts, genCharString(tc, 255))
+			}
+		}
+		return strings.Join(parts, " ")
+	case "HINFO":
+		return genCharStringOpt(tc, 255, true) + " " + genCharStringOpt(tc, 255, true)
+	case "ISDN":
+		// dnspython omits an empty subaddress from the wire form (RFC 1183 makes it optional)
+		return genCharStringOpt(tc, 255, true) + " " + pick(tc, "1", "004", "\"sub\"", "\"a b\"")
+	case "X25":
+		if Known.x25TakesOneToken {
+			return pick(tc, "311061700956", "1", "0", "abc")
+		}
+		return genCharString(tc, 255)
+	case "RP":
+		return genName(tc) + " " + genName(tc)
+	case "PX":
+		return fmt.Sprintf("%d %s %s", u16(tc), genName(tc), genName(tc))
+	case "GPOS":
+		// RFC 1712 orders longitude, latitude, altitude; dnspython reads latitude first and
+		// range-checks it, so both angles stay within 90 degrees
+		return fmt.Sprintf("%d.%d %d.%d %d.%d", n(tc, -89, 89), n(tc, 0, 9999), n(tc, -89, 89), n(tc, 0, 9999), n(tc, -1000, 100000), n(tc, 0, 99))
+	case "SRV":
+		return fmt.Sprintf("%d %d %d %s", u16(tc), u16(tc), u16(tc), genName(tc))
+	case "NAPTR":
+		return fmt.Sprintf("%d %d %s %s %s %s", u16(tc), u16(tc), genCharStringOpt(tc, 20, true), genCharStringOpt(tc, 30, true), genCharStringOpt(tc, 60, true), genName(tc))
+	case "CERT":
+		ctype := pick(tc, "PKIX", "SPKI", "PGP", "IPKIX", "ISPKI", "IPGP", "ACPKIX", "IACPKIX", "URI", "OID", "1", "8", "253", "65535")
+		if ctype == "IPKIX" && Known.certIPKIXMisspelt {
+			ctype = "4"
+		}
+		return fmt.Sprintf("%s %d %d %s", ctype, u16(tc), u8(tc), b64Of(genBytes(tc, 1, 40)))
+	case "LOC":
+		return genLOC(tc)
+	case "RRSIG":
+		return fmt.Sprintf("%s %d %d %d %s %s %d %s %s", pick(tc, typeNamePool...), u8(tc), n(tc, 0, 127), u32(tc), genTime(tc), genTime(tc), u16(tc), genName(tc), b64Of(genBytes(tc, 1, 80)))
+	case "NSEC":
+		return genName(tc) + pick(tc, "", " "+genTypeList(tc, 1, 6))
+	case "NSEC3":
+		salt := pick(tc, "-", hexOf(genBytes(tc, 1, 16)))
+		// the library packs a hash length of 20 whatever the hash: SHA-1 lengths only while open
+		next := b32hex.EncodeToString(genBytes(tc, 20, 20))
+		if !Known.nsec3HashLengthFixed && chance(tc, 30) {
+			next = b32hex.EncodeToString(genBytes(tc, pick(tc, 5, 10, 15, 25, 32), 32))
+		}
+		return fmt.Sprintf("%d %d %d %s %s%s", u8(tc), pick(tc, 0, 1), u16(tc), salt, next, pick(tc, "", " "+genTypeList(tc, 1, 6)))
+	case "NSEC3PARAM":
+		return fmt.Sprintf("%d %d %d %s", u8(tc), pick(tc, 0, 1), u16(tc), pick(tc, "-", hexOf(genBytes(tc, 1, 16))))
+	case "DS", "CDS", "DLV":
+		// dnspython checks the digest length of the known digest types
+		dt := pick(tc, 1, 2, 4, n(tc, 1, 255))
+		size := map[int]int{1: 20, 2: 32, 3: 32, 4: 48}[dt]
+		if size == 0 {
+			size = n(tc, 1, 48)
+		}
+		return fmt.Sprintf("%d %d %d %s", u16(tc), u8(tc), dt, hexOf(genBytes(tc, size, size)))
+	case "DNSKEY", "CDNSKEY":
+		return fmt.Sprintf("%d %d %d %s", pick(tc, 256, 257, 0, u16(tc)), pick(tc, 3, u8(tc)), pick(tc, 8, 13, 15, u8(tc)), b64Of(genBytes(tc, 1, 70)))
+	case "SSHFP":
+		return fmt.Sprintf("%d %d %s", u8(tc), u8(tc), hexOf(genBytes(tc, 1, 32)))
+	case "TLSA", "SMIMEA":
+		return fmt.Sprintf("%d %d %d %s", u8(tc), u8(tc), u8(tc), hexOf(genBytes(tc, 1, 40)))
+	case "HIP":
+		out := fmt.Sprintf("%d %s %s", u8(tc), hexOf(genBytes(tc, 1, 20)), b64Of(genBytes(tc, 1, 40)))
+		for i := n(tc, 0, 3); i > 0; i-- {
+			out += " " + genName(tc)
+		}
+		return out
+	case "OPENPGPKEY", "DHCID":
+		return b64Of(genBytes(tc, 1, 60))
+	case "CAA":
+		return fmt.Sprintf("%d %s %s", pick(tc, 0, 128, u8(tc)), pick(tc, "issue", "issuewild", "iodef", "contactemail", "x1"), genCharStringOpt(tc, 200, true))
+	case "URI":
+		// RFC 7553: the target must not be empty (dnspython checks)
+		target := genCharStringOpt(tc, 200, true)
+		if target == "\"\"" {
+			target = "\"https://example.com/\""
+		}
+		return fmt.Sprintf("%d %d %s", u16(tc), u16(tc), target)
+	case "EUI48":
+		b := genBytes(tc, 6, 6)
+		return fmt.Sprintf("%02x-%02x-%02x-%02x-%02x-%02x", b[0], b[1], b[2], b[3], b[4], b[5])
+	case "EUI64":
+		b := genBytes(tc, 8, 8)
+		return fmt.Sprintf("%02x-%02x-%02x-%02x-%02x-%02x-%02x-%02x", b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7])
+	case "ZONEMD":
+		switch n(tc, 0, 2) {
+		case 0:
+			return fmt.Sprintf("%d 1 1 %s", u32(tc), hexOf(genBytes(tc, 48, 48)))
+		case 1:
+			return fmt.Sprintf("%d 1 2 %s", u32(tc), hexOf(genBytes(tc, 64, 64)))
+		default:
+			return fmt.Sprintf("%d %d %d %s", u32(tc), pick(tc, 1, 240), pick(tc, 240, 241), hexOf(genBytes(tc, 12, 40)))
+		}
+	case "CSYNC":
+		return fmt.Sprintf("%d %d%s", u32(tc), pick(tc, 0, 1, 2, 3, u16(tc)), pick(tc, "", " "+genTypeList(tc, 1, 5)))
+	case "L32":
+		return fmt.Sprintf("%d %s", u16(tc), genIP4(tc))
+	case "L64", "NID":
+		return fmt.Sprintf("%d %04x:%04x:%04x:%04x", u16(tc), n(tc, 0, 65535), n(tc, 0, 65535), n(tc, 0, 65535), n(tc, 0, 65535))
+	case "AMTRELAY":
+		// the D bit is left clear while the library drops the gateway when it is set
+		d := pick(tc, 0, 1)
+		if Known.amtrelayDBitDropsGateway {
+			d = 0
+		}
+		switch n(tc, 0, 2) {
+		case 0:
+			return fmt.Sprintf("%d %d 1 %s", u8(tc), d, genIP4(tc))
+		case 1:
+			return fmt.Sprintf("%d %d 2 %s", u8(tc), d, genGatewayIP6(tc))
+		default:
+			return fmt.Sprintf("%d %d 3 %s", u8(tc), d, genName(tc))
+		}
+	case "IPSECKEY":
+		key := b64Of(genBytes(tc, 1, 40))
+		switch n(tc, 0, 3) {
+		case 0:
+			return fmt.Sprintf("%d 0 %d . %s", u8(tc), u8(tc), key)
+		case 1:
+			return fmt.Sprintf("%d 1 %d %s %s", u8(tc), u8(tc), genIP4(tc), key)
+		case 2:
+			return fmt.Sprintf("%d 2 %d %s %s", u8(tc), u8(tc), genGatewayIP6(tc), key)
+		default:
+			return fmt.Sprintf("%d 3 %d %s %s", u8(tc), u8(tc), genName(tc), key)
+		}
+	case "APL":
+		var parts []string
+		for i := n(tc, 0, 4); i > 0; i-- {
+			// the library requires the bits beyond the prefix to be zero (dnspython does not)
+			neg := pick(tc, "", "!")
+			if chance(tc, 50) {
+				bits := n(tc, 0, 32)
+				ip := net.ParseIP(genIP4(tc)).To4().Mask(net.CIDRMask(bits, 32))
+				parts = append(parts, fmt.Sprintf("%s1:%s/%d", neg, ip, bits))
+			} else {
+				bits := n(tc, 0, 128)
+				ip := net.ParseIP(genIP6(tc)).Mask(net.CIDRMask(bits, 128))
+				parts = append(parts, fmt.Sprintf("%s2:%s/%d", neg, ip, bits))
+			}
+		}
+		return strings.Join(parts, " ")
+	case "SVCB", "HTTPS":
+		if chance(tc, 20) {
+			return "0 " + genName(tc)
+		}
+		return fmt.Sprintf("%d %s %s", n(tc, 1, 65535), pick(tc, ".", genName(tc)), genSVCBParams(tc))
+	default: // TYPE65280, TYPE1234: unknown rdata
+		b := genBytes(tc, 0, 30)
+		if len(b) == 0 {
+			return "\\# 0"
+		}
+		return fmt.Sprintf("\\# %d %s", len(b), hexOf(b))
+	}
+}
+
+// genTTL returns a TTL in presentation form (plain or with units).
+func genTTL(tc hegel.TestCase) (string, uint32) {
+	if chance(tc, 20) {
+		h, m := n(tc, 0, 100), n(tc, 0, 59)
+		return fmt.Sprintf("%dh%dm", h, m), uint32(h*3600 + m*60)
+	}
+	v := u32(tc)
+	return fmt.Sprint(v), v
+}
