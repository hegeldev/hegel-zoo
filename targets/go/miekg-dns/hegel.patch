+package dns_test
+
+// One plain test per bug in bugs.toml. Each fails while the bug is open and
+// is listed under [expected_failures] in target.toml.
+
+import (
+	"bytes"
+	"encoding/hex"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/miekg/dns"
+)
+
+func mustRR(t *testing.T, text string) dns.RR {
+	t.Helper()
+	rr, err := dns.NewRR(text)
+	if err != nil {
+		t.Fatalf("NewRR(%q): %v", text, err)
+	}
+	return rr
+}
+
+func mustPack(t *testing.T, rr dns.RR) []byte {
+	t.Helper()
+	wire, _, err := packRR(rr)
+	if err != nil {
+		t.Fatalf("PackRR(%s): %v", rr, err)
+	}
+	return wire
+}
+
+func zoneRecords(t *testing.T, zone, origin string) ([]dns.RR, error) {
+	t.Helper()
+	var out []dns.RR
+	zp := dns.NewZoneParser(strings.NewReader(zone), origin, "")
+	for rr, ok := zp.Next(); ok; rr, ok = zp.Next() {
+		out = append(out, rr)
+	}
+	return out, zp.Err()
+}
+
+// 1: Len returns the length of the uncompressed wire form.
+func TestHegelPinLenIsTheWireLength(t *testing.T) {
+	for _, text := range []string{
+		`a. 1 IN TXT "\\"`,
+		`a. 1 IN TXT "\065"`,
+		`a. 1 IN DNSKEY 256 3 8 ZAKoSg==`,
+		`a. 1 IN CERT PGP 1 1 SwA=`,
+		`a. 1 IN NSEC b.`,
+		`a. 1 IN CSYNC 1 3`,
+		`a. 1 IN HIP 8 0657 pUo= .`,
+		`a. 1 IN AMTRELAY 1 0 3 a\064.`,
+		`a. 1 IN APL 2:::/3`,
+		`a\032. 1 IN A 1.2.3.4`,
+	} {
+		rr := mustRR(t, text)
+		if got, want := dns.Len(rr), len(mustPack(t, rr)); got != want {
+			t.Errorf("Len(%s) = %d, PackRR writes %d bytes", text, got, want)
+		}
+	}
+}
+
+// 2: type bitmaps written in any order pack.
+func TestHegelPinTypeBitmapOrderIsFree(t *testing.T) {
+	for _, text := range []string{
+		"a. 1 IN NSEC b. MX A",
+		"a. 1 IN NSEC3 1 0 0 - AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA MX A",
+		"a. 1 IN CSYNC 1 3 MX A",
+	} {
+		rr := mustRR(t, text)
+		buf := make([]byte, 512)
+		if _, err := dns.PackRR(rr, buf, 0, nil, false); err != nil {
+			t.Errorf("PackRR(%s): %v", text, err)
+		}
+	}
+}
+
+// 3: names and records equal on the wire are duplicates and compare equal.
+func TestHegelPinDuplicatesAreJudgedOnTheWire(t *testing.T) {
+	a := mustRR(t, `a\032. 1 IN A 1.2.3.4`)
+	b := mustRR(t, `a\ . 1 IN A 1.2.3.4`)
+	if !dns.IsDuplicate(a, b) {
+		t.Errorf("IsDuplicate(%s, %s) = false", a, b)
+	}
+	if !dns.IsDuplicate(mustRR(t, `a. 1 IN TXT "\065"`), mustRR(t, `a. 1 IN TXT "A"`)) {
+		t.Errorf(`IsDuplicate of TXT "\065" and "A" = false`)
+	}
+	if !dns.IsDuplicate(mustRR(t, `a. 1 IN SSHFP 1 1 abcd`), mustRR(t, `a. 1 IN SSHFP 1 1 ABCD`)) {
+		t.Errorf("IsDuplicate of SSHFP abcd and ABCD = false")
+	}
+	if n := dns.CompareDomainName(`a\032.`, `a\ .`); n != 1 {
+		t.Errorf(`CompareDomainName("a\032.", "a\ .") = %d, want 1`, n)
+	}
+	if !dns.IsSubDomain(`a\032.`, `b.a\ .`) {
+		t.Errorf(`IsSubDomain("a\032.", "b.a\ .") = false`)
+	}
+}
+
+// 4: LOC minutes may be given without seconds (RFC 1876 section 3).
+func TestHegelPinLOCMinutesWithoutSeconds(t *testing.T) {
+	for _, text := range []string{
+		"a. 1 IN LOC 42 30 N 56 40 W 10m",
+		"a. 1 IN LOC 42 30 N 56 W 10m",
+		"a. 1 IN LOC 42 N 56 40 W 10m",
+	} {
+		if _, err := dns.NewRR(text); err != nil {
+			t.Errorf("NewRR(%q): %v", text, err)
+		}
+	}
+}
+
+// 5: the X25 address is a <character-string> and may be quoted (RFC 1183 3.1).
+func TestHegelPinX25AcceptsQuotedAddress(t *testing.T) {
+	rr, err := dns.NewRR(`a. 1 IN X25 "311061700956"`)
+	if err != nil {
+		t.Fatalf("NewRR: %v", err)
+	}
+	if got := rr.(*dns.X25).PSDNAddress; got != "311061700956" {
+		t.Errorf("PSDNAddress = %q", got)
+	}
+}
+
+// 6: an unpacked CAA or URI prints so that it reads back to the same data.
+func TestHegelPinUnpackedOctetStringsPrintEscaped(t *testing.T) {
+	for _, text := range []string{`a. 1 IN CAA 0 issue "a\\b"`, `a. 1 IN URI 1 1 "a\\b"`} {
+		rr := mustRR(t, text)
+		wire := mustPack(t, rr)
+		back, _, err := dns.UnpackRR(wire, 0)
+		if err != nil {
+			t.Fatalf("UnpackRR: %v", err)
+		}
+		again, err := dns.NewRR(back.String())
+		if err != nil {
+			t.Fatalf("NewRR(%q): %v", back.String(), err)
+		}
+		if got := mustPack(t, again); !bytes.Equal(got, wire) {
+			t.Errorf("%s unpacked prints %q, which packs to %s, not %s", text, back.String(), hex.EncodeToString(got), hex.EncodeToString(wire))
+		}
+	}
+}
+
+// 7: an IPv4-mapped IPv6 address is an IPv6 gateway (AAAA accepts it).
+func TestHegelPinMappedIPv6Gateways(t *testing.T) {
+	for _, text := range []string{
+		"a. 1 IN IPSECKEY 1 2 1 ::ffff:1.2.3.4 pUo=",
+		"a. 1 IN AMTRELAY 1 0 2 ::ffff:1.2.3.4",
+		"a. 1 IN SVCB 1 . ipv6hint=::ffff:1.2.3.4",
+	} {
+		if _, err := dns.NewRR(text); err != nil {
+			t.Errorf("NewRR(%q): %v", text, err)
+		}
+	}
+	// and the wire form's String() reads back
+	wire, _ := hex.DecodeString("016100002d000100000001001501020100000000000000000000ffff01020304a54a")
+	rr, _, err := dns.UnpackRR(wire, 0)
+	if err != nil {
+		t.Fatalf("UnpackRR: %v", err)
+	}
+	if _, err := dns.NewRR(rr.String()); err != nil {
+		t.Errorf("NewRR(%q) of an unpacked IPSECKEY: %v", rr.String(), err)
+	}
+}
+
+// 8: the canonical form lowercases letters written as escapes (RFC 4034 6.2).
+func TestHegelPinCanonicalNameLowercasesEscapes(t *testing.T) {
+	c := dns.CanonicalName(`x\070.`)
+	w, err := packName(c)
+	if err != nil || hex.EncodeToString(w) != "02786600" {
+		t.Errorf(`CanonicalName("x\070.") = %q packs to %s (%v), want 02786600 ("xf.")`, c, hex.EncodeToString(w), err)
+	}
+}
+
+// 9: LOC seconds keep their milliseconds.
+func TestHegelPinLOCSecondsAreExact(t *testing.T) {
+	rr := mustRR(t, "a. 1 IN LOC 0 0 4.031 N 0 E 0m")
+	if got := rr.(*dns.LOC).Latitude; got != 1<<31+4031 {
+		t.Errorf("Latitude = %d (%d ms), want %d", got, int64(got)-1<<31, 1<<31+4031)
+	}
+}
+
+// 10: an altitude outside RFC 1876's range is rejected, not wrapped.
+func TestHegelPinLOCAltitudeRange(t *testing.T) {
+	for _, text := range []string{"a. 1 IN LOC 0 N 0 E -100001m", "a. 1 IN LOC 0 N 0 E 42849673m"} {
+		rr, err := dns.NewRR(text)
+		if err == nil {
+			t.Errorf("NewRR(%q) accepted, altitude field %d (%s)", text, rr.(*dns.LOC).Altitude, rr)
+		}
+	}
+}
+
+// 11: the NSEC3 hash length is the length of the hash.
+func TestHegelPinNSEC3HashLength(t *testing.T) {
+	rr := mustRR(t, "a. 1 IN NSEC3 1 0 0 - VE08UH3B")
+	wire := mustPack(t, rr)
+	back, off, err := dns.UnpackRR(wire, 0)
+	if err != nil || off != len(wire) {
+		t.Fatalf("UnpackRR(PackRR) of a 5-byte hash: %v (wire %s)", err, hex.EncodeToString(wire))
+	}
+	if back.(*dns.NSEC3).HashLength != 5 {
+		t.Errorf("hash length %d, want 5", back.(*dns.NSEC3).HashLength)
+	}
+}
+
+// 12: the AMTRELAY gateway is packed whatever the D bit.
+func TestHegelPinAMTRELAYKeepsGatewayWithDBit(t *testing.T) {
+	rr := mustRR(t, "a. 1 IN AMTRELAY 1 1 1 1.2.3.4")
+	_, rdata, err := packRR(rr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := hex.EncodeToString(rdata); got != "018101020304" {
+		t.Errorf("rdata %s, want 018101020304", got)
+	}
+}
+
+// 13: a comment inside parentheses is allowed in every record.
+func TestHegelPinCommentsInsideParentheses(t *testing.T) {
+	for _, zone := range []string{
+		"$TTL 1\n@ NSEC ( a. ; c\n SRV APL )\n",
+		"$TTL 1\n@ NSEC3 ( 1 0 0 - AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA ; c\n SRV APL )\n",
+		"$TTL 1\n@ CSYNC ( 1 3 ; c\n SRV APL )\n",
+		"$TTL 1\n@ RRSIG ( A 8 2 3600 20260101000000 ; c\n 20250101000000 1 a. AAAA )\n",
+	} {
+		if rrs, err := zoneRecords(t, zone, "example.com."); err != nil || len(rrs) != 1 {
+			t.Errorf("%q: %d records, %v", zone, len(rrs), err)
+		}
+	}
+}
+
+// 14: a blank owner before any record is not an empty name.
+func TestHegelPinBlankFirstOwner(t *testing.T) {
+	rrs, err := zoneRecords(t, "$TTL 1\n  A 1.2.3.4\n", "example.com.")
+	if err != nil {
+		return // rejecting the zone is fine
+	}
+	for _, rr := range rrs {
+		if rr.Header().Name == "" {
+			t.Errorf("record with an empty owner name: %q", rr.String())
+		}
+	}
+}
+
+// 15: TsigVerify leaves the message buffer as it was.
+func TestHegelPinTsigVerifyKeepsTheBuffer(t *testing.T) {
+	m := new(dns.Msg)
+	m.SetQuestion("example.com.", dns.TypeA)
+	m.SetTsig("key.", dns.HmacSHA256, 300, time.Now().Unix())
+	signed, _, err := dns.TsigGenerate(m, "c2VjcmV0", "", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := append([]byte(nil), signed...)
+	if err := dns.TsigVerify(signed, "c2VjcmV0", "", false); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(before, signed) {
+		t.Errorf("TsigVerify changed the buffer: arcount %v -> %v", before[10:12], signed[10:12])
+	}
+}
+
+// 16: the key tag of an RSA/MD5 key follows RFC 4034 appendix B.1.
+func TestHegelPinKeyTagRSAMD5(t *testing.T) {
+	rr := mustRR(t, "a. 1 IN DNSKEY 257 3 1 MWwoyw8q95pCE4xPuwfJBoYj7lnjNMY8XDIilQ==")
+	if got := rr.(*dns.DNSKEY).KeyTag(); got != 12834 {
+		t.Errorf("KeyTag = %d, want 12834 (0x3222, the 3rd and 2nd to last octets of the key)", got)
+	}
+}
+
+// 17: an IPSECKEY record may be followed by another record.
+func TestHegelPinIPSECKEYThenAnotherRecord(t *testing.T) {
+	rrs, err := zoneRecords(t, "$TTL 1\n@ IPSECKEY 1 1 1 1.2.3.4 pUo=\n@ A 1.2.3.4\n", "example.com.")
+	if err != nil || len(rrs) != 2 {
+		t.Errorf("%d records, %v", len(rrs), err)
+	}
+}
+
+// 18: a signed NOTAUTH message (RFC 2136 responses, RFC 8945 BADTIME answers)
+// verifies like any other.
+func TestHegelPinTsigVerifiesNotAuthMessages(t *testing.T) {
+	m := new(dns.Msg)
+	m.SetQuestion("example.com.", dns.TypeSOA)
+	m.Response = true
+	m.Rcode = dns.RcodeNotAuth
+	m.SetTsig("key.", dns.HmacSHA256, 300, time.Now().Unix())
+	signed, _, err := dns.TsigGenerate(m, "c2VjcmV0", "", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := dns.TsigVerify(signed, "c2VjcmV0", "", false); err != nil {
+		t.Errorf("TsigVerify of a correctly signed NOTAUTH response: %v", err)
+	}
+}
+
+// 19: CERT type 4 is IPKIX (RFC 4398 section 2.1).
+func TestHegelPinCERTTypeIPKIX(t *testing.T) {
+	if got := dns.CertTypeToString[4]; got != "IPKIX" {
+		t.Errorf("CertTypeToString[4] = %q, want IPKIX", got)
+	}
+	if _, err := dns.NewRR("a. 1 IN CERT IPKIX 1 8 ElQ="); err != nil {
+		t.Errorf("NewRR of a CERT IPKIX: %v", err)
+	}
+}
diff --git a/hegel_records_test.go b/hegel_records_test.go
new file mode 100644
index 0000000..a8f1eea
--- /dev/null
+++ b/hegel_records_test.go
@@ -0,0 +1,185 @@
+package dns_test
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/miekg/dns"
+	"hegel.dev/go/hegel"
+)
+
+// packRR packs a record without compression and returns the whole wire form
+// and the rdata part.
+func packRR(rr dns.RR) (wire, rdata []byte, err error) {
+	buf := make([]byte, 65535)
+	off, err := dns.PackRR(rr, buf, 0, nil, false)
+	if err != nil {
+		return nil, nil, err
+	}
+	wire = buf[:off]
+	nameLen, err := dns.PackDomainName(rr.Header().Name, buf[off:], 0, nil, false)
+	if err != nil {
+		return nil, nil, err
+	}
+	return wire, wire[nameLen+10:], nil
+}
+
+// lenIsApproximate reports the shapes for which Len is known to overestimate:
+// escaped names and strings, base64 fields (their padding), empty type bitmaps.
+func lenIsApproximate(text, typ string) bool {
+	if strings.Contains(text, "\\") {
+		return true
+	}
+	switch typ {
+	case "CERT", "DNSKEY", "CDNSKEY", "RRSIG", "HIP", "IPSECKEY", "OPENPGPKEY", "DHCID", "AMTRELAY":
+		return true
+	case "NSEC", "NSEC3", "CSYNC", "APL":
+		return true
+	}
+	return false
+}
+
+// hasHexField reports the types with a hex string field, which the library
+// compares case-sensitively (unpacking gives lower case, String() upper case).
+func hasHexField(typ string) bool {
+	switch typ {
+	case "SSHFP", "NSEC3PARAM", "NSEC3", "DS", "CDS", "DLV", "TLSA", "SMIMEA", "HIP", "ZONEMD", "TYPE65280", "TYPE1234":
+		return true
+	}
+	return false
+}
+
+func isASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= 128 {
+			return false
+		}
+	}
+	return true
+}
+
+type pyRdata struct {
+	Wire   string `json:"wire"`
+	Text   string `json:"text"`
+	Rewire string `json:"rewire"`
+	Retext string `json:"retext"`
+}
+
+type pyRdataWire struct {
+	Text     string `json:"text"`
+	Rewire   string `json:"rewire"`
+	TextWire string `json:"textwire"`
+}
+
+// TestHegelRecordsAgreeWithDnspython: a record written in presentation form
+// packs to the same rdata in this library and in dnspython; the wire form
+// read back by either library prints and re-packs stably; Len matches the
+// packed size and the text round trip is exact.
+func TestHegelRecordsAgreeWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		typ := pick(tc, rrTypes...)
+		rdata := genRdata(tc, typ)
+		owner := genName(tc)
+		ttlText, ttl := genTTL(tc)
+		class := pick(tc, "IN", "IN", "IN", "CH", "HS", "CLASS250")
+		text := fmt.Sprintf("%s %s %s %s %s", owner, ttlText, class, typ, rdata)
+		note(ht, "record %s", text)
+
+		rr, gerr := dns.NewRR(text)
+		var pr pyRdata
+		// dnspython's class-specific types live under IN only (CH A is Chaosnet's A); the
+		// library reads every class alike, so the oracle always parses in class IN
+		perr := py.call(t, map[string]any{"op": "rdata", "type": typ, "class": "IN", "text": rdata}, &pr)
+		if perr != nil && gerr != nil {
+			note(ht, "both reject: go %v; python %v", gerr, perr)
+			return
+		}
+		if gerr != nil {
+			fail(ht, "NewRR rejects text dnspython accepts (wire %s): %v\nrecord %s", pr.Wire, gerr, text)
+		}
+		if perr != nil {
+			fail(ht, "dnspython rejects text NewRR accepts (%s): %v\nrecord %s", rr.String(), perr, text)
+		}
+		wire, got, err := packRR(rr)
+		if err != nil {
+			fail(ht, "PackRR failed: %v\nrecord %s", err, text)
+		}
+		if hex.EncodeToString(got) != pr.Wire {
+			fail(ht, "rdata wire differs\n go     %s\n python %s\nrecord %s\ngo text %s\npython text %s", hex.EncodeToString(got), pr.Wire, text, rr.String(), pr.Text)
+		}
+		// header
+		h := rr.Header()
+		if h.Ttl != ttl {
+			fail(ht, "TTL %d parsed as %d\nrecord %s", ttl, h.Ttl, text)
+		}
+		if dns.Len(rr) < len(wire) {
+			fail(ht, "Len %d but PackRR wrote %d bytes\nrecord %s", dns.Len(rr), len(wire), text)
+		}
+		if dns.Len(rr) != len(wire) && !(Known.lenOverestimates && lenIsApproximate(text, typ)) {
+			fail(ht, "Len %d but PackRR wrote %d bytes\nrecord %s", dns.Len(rr), len(wire), text)
+		}
+		// the library reads its own wire form back to the same record
+		back, off, err := dns.UnpackRR(wire, 0)
+		if err != nil || off != len(wire) {
+			fail(ht, "UnpackRR of PackRR: %v (off %d of %d)\nrecord %s", err, off, len(wire), text)
+		}
+		// the unpacked record prints to text that reads back to the same wire form
+		reback, err := dns.NewRR(back.String())
+		if err != nil {
+			fail(ht, "NewRR rejects the String() of an unpacked record: %v\n%s\nrecord %s", err, back.String(), text)
+		}
+		octetBackslash := Known.octetPrintUnescaped && (typ == "CAA" || typ == "URI") && bytes.Contains(got, []byte{'\\'})
+		if w2, _, err := packRR(reback); (err != nil || !bytes.Equal(w2, wire)) && !octetBackslash {
+			fail(ht, "String() of an unpacked record reads back differently (%v)\n parsed   %s\n unpacked %s\nrecord %s", err, rr.String(), back.String(), text)
+		}
+		if !dns.IsDuplicate(rr, back) && !(Known.textualDuplicates && strings.Contains(text, "\\")) {
+			fail(ht, "IsDuplicate false for a record and its wire copy\nrecord %s", text)
+		}
+		octetField := typ == "CAA" || typ == "URI" // stored raw after unpacking, escaped after parsing
+		if !dns.IsDuplicate(back, reback) && !(Known.textualDuplicates && (hasHexField(typ) || octetField)) && !octetBackslash {
+			fail(ht, "IsDuplicate false for an unpacked record and its reparsed String()\nrecord %s", text)
+		}
+		// the library's text round trip
+		again, err := dns.NewRR(rr.String())
+		if err != nil {
+			fail(ht, "NewRR rejects the library's own String(): %v\n%s\nrecord %s", err, rr.String(), text)
+		}
+		wire2, got2, err := packRR(again)
+		if err != nil {
+			fail(ht, "PackRR of the reparsed record: %v\nrecord %s", err, text)
+		}
+		if !bytes.Equal(got, got2) {
+			fail(ht, "text round trip changes the rdata\n first  %s\n second %s\nString() %s\nrecord %s", hex.EncodeToString(got), hex.EncodeToString(got2), rr.String(), text)
+		}
+		if !bytes.Equal(wire, wire2) {
+			fail(ht, "text round trip changes the header: %s -> %s\nrecord %s", h.String(), again.Header().String(), text)
+		}
+		// dnspython reads the library's wire form to its own text
+		var pw pyRdataWire
+		if err := py.call(t, map[string]any{"op": "rdata_wire", "type": typ, "class": "IN", "wire": hex.EncodeToString(got)}, &pw); err != nil {
+			fail(ht, "dnspython cannot read the rdata wire %s: %v\nrecord %s", hex.EncodeToString(got), err, text)
+		}
+		if pw.Text != pr.Text {
+			fail(ht, "dnspython prints the wire form differently from its own parse\n from text %s\n from wire %s\nrecord %s", pr.Text, pw.Text, text)
+		}
+		// and the library reads dnspython's re-serialised text, when it parses at all
+		// (dnspython does not escape backslashes in URI targets: not judged)
+		if typ == "URI" || !isASCII(pr.Text) {
+			return
+		}
+		back2, err := dns.NewRR(fmt.Sprintf("%s %d %s %s %s", owner, ttl, class, typ, pr.Text))
+		if err != nil {
+			note(ht, "NewRR rejects dnspython's text %q: %v", pr.Text, err)
+		} else {
+			_, got3, err := packRR(back2)
+			if err == nil && !bytes.Equal(got, got3) {
+				fail(ht, "dnspython's text %q parses to different rdata\n go from it %s\n go from original %s\nrecord %s", pr.Text, hex.EncodeToString(got3), hex.EncodeToString(got), text)
+			}
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..0976eee
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,150 @@
+package dns_test
+
+// Hegel properties for github.com/miekg/dns: records, names, messages,
+// zone files and DNSSEC/TSIG primitives against dnspython (the other
+// complete DNS library, as a child process), plus library-internal
+// identities (text and wire round trips, lengths, compression, truncation,
+// duplicates).
+//
+// Needs python3 with the `dnspython` package (2.x) on PATH.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 400 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); every switch
+// is on while the bug is open so the properties run clean, and the pin tests
+// in hegel_pins_test.go assert the correct behaviour and fail meanwhile.
+var Known = struct {
+	lenOverestimates          bool // 1: Len counts escapes, base64 padding, empty bitmaps
+	unsortedTypeBitmap        bool // 2: NSEC/NSEC3/CSYNC text with unsorted types cannot be packed
+	textualDuplicates         bool // 3: IsDuplicate, CompareDomainName compare the presentation text
+	locMinutesNeedSeconds     bool // 4: LOC text with minutes but no seconds is rejected
+	x25TakesOneToken          bool // 5: X25 rejects a quoted character-string
+	octetPrintUnescaped       bool // 6: unpacked CAA/URI values print backslashes as escapes
+	mappedGatewayRejected     bool // 7: IPSECKEY/AMTRELAY/SVCB reject an IPv4-mapped IPv6 address
+	canonicalKeepsEscapedCase bool // 8: CanonicalName leaves an escaped upper-case letter
+	locFloatTruncation        bool // 9: LOC seconds lose a millisecond to float truncation
+	locAltitudeWraps          bool // 10: LOC altitude outside the range wraps around
+	nsec3HashLengthFixed      bool // 11: NSEC3 packs a hash length of 20 whatever the hash
+	amtrelayDBitDropsGateway  bool // 12: AMTRELAY with the D bit set packs without its gateway
+	parenCommentBreaksBitmap  bool // 13: a comment inside parentheses breaks NSEC/NSEC3/CSYNC/RRSIG parsing
+	blankFirstOwnerEmpty      bool // 14: a blank owner before any record gives an empty owner name
+	tsigVerifyMutates         bool // 15: TsigVerify decrements the ARCOUNT in the caller's buffer
+	keyTagRSAMD5              bool // 16: KeyTag ignores the RSAMD5 rule of RFC 4034 appendix B.1
+	ipseckeyEatsNewline       bool // 17: an IPSECKEY record cannot be followed by another record
+	tsigVerifyRefusesNotAuth  bool // 18: TsigVerify rejects every NOTAUTH message unverified
+	certIPKIXMisspelt         bool // 19: CERT type 4 is spelt IPIX instead of IPKIX
+}{
+	lenOverestimates:          true,
+	unsortedTypeBitmap:        true,
+	textualDuplicates:         true,
+	locMinutesNeedSeconds:     true,
+	x25TakesOneToken:          true,
+	octetPrintUnescaped:       true,
+	mappedGatewayRejected:     true,
+	canonicalKeepsEscapedCase: true,
+	locFloatTruncation:        true,
+	locAltitudeWraps:          true,
+	nsec3HashLengthFixed:      true,
+	amtrelayDBitDropsGateway:  true,
+	parenCommentBreaksBitmap:  true,
+	blankFirstOwnerEmpty:      true,
+	tsigVerifyMutates:         true,
+	keyTagRSAMD5:              true,
+	ipseckeyEatsNewline:       true,
+	tsigVerifyRefusesNotAuth:  true,
+	certIPKIXMisspelt:         true,
+}
