+// dnssecCase: an owner name, the NSEC3 salt and iterations to hash it with,
+// and a DNSKEY's key bytes, flags and algorithm.
+type dnssecCase struct {
+	name  string
+	salt  string // hex, or "-" (the presentation form of no salt)
+	iter  int
+	key   []byte
+	flags int
+	alg   int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c dnssecCase) GoString() string {
+	return fmt.Sprintf("name %q salt %q iterations %d; DNSKEY %d 3 %d %s", c.name, c.salt, c.iter, c.flags, c.alg, b64Of(c.key))
+}
+
+var (
+	// dnssecNames: names without escapes while CanonicalName keeps an escaped letter's case
+	dnssecNames = func() hegel.Generator[string] {
+		if Known.canonicalKeepsEscapedCase {
+			return plainNames
+		}
+		return names
+	}()
+	// dnskeyAlgs: the algorithms in use and any; RSA/MD5 becomes RSA/SHA-256 while KeyTag ignores its rule
+	dnskeyAlgs = hegel.Map(hegel.OneOf(hegel.SampledFrom([]int{8, 13, 15, 5, 7, 10, 14, 16}), u8s), func(alg int) int {
+		if alg == 1 && Known.keyTagRSAMD5 {
+			return 8
+		}
+		return alg
+	})
+	dnssecCases = hegel.Composite(func(tc hegel.TestCase) dnssecCase {
+		return dnssecCase{
+			name:  hegel.Draw(tc, dnssecNames),
+			salt:  hegel.Draw(tc, hegel.OneOf(lit(""), lit("-"), hexs(1, 32))),
+			iter:  hegel.Draw(tc, hegel.OneOf(hegel.SampledFrom([]int{0, 1, 10, 150}), hegel.Integers(0, 500))),
+			key:   hegel.Draw(tc, hegel.Binary(1, 80)),
+			flags: hegel.Draw(tc, hegel.OneOf(hegel.SampledFrom([]int{256, 257, 0}), u16s)),
+			alg:   hegel.Draw(tc, dnskeyAlgs),
+		}
+	})
+)
