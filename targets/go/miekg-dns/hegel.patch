+package dns_test
+
+import (
+	"encoding/hex"
+	"fmt"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/miekg/dns"
+	"hegel.dev/go/hegel"
+)
+
+// dnssecCase: an owner name, the NSEC3 salt and iterations to hash it with,
+// and a DNSKEY's key bytes, flags and algorithm.
+type dnssecCase struct {
+	name  string
+	salt  string // hex, or "-" (the presentation form of no salt)
+	iter  int
+	key   []byte
+	flags int
+	alg   int
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c dnssecCase) GoString() string {
+	return fmt.Sprintf("name %q salt %q iterations %d; DNSKEY %d 3 %d %s", c.name, c.salt, c.iter, c.flags, c.alg, b64Of(c.key))
+}
+
+var (
+	// dnssecNames: any name (CanonicalName, which HashName and ToDS use,
+	// keeps an escaped letter's case, miekg-dns/8); names without escapes
+	// under HEGEL_NO_KNOWN=1
+	dnssecNames = shaped(names, plainNames)
+	// dnskeyAlgs: the algorithms in use and any; under HEGEL_NO_KNOWN=1 RSA/MD5
+	// becomes RSA/SHA-256 (KeyTag ignores its rule, miekg-dns/16)
+	dnskeyAlgs = hegel.Map(hegel.OneOf(hegel.SampledFrom([]int{8, 13, 15, 5, 7, 10, 14, 16}), u8s), func(alg int) int {
+		if alg == 1 && Known.keyTagRSAMD5 {
+			return 8
+		}
+		return alg
+	})
+	hashSalts   = hegel.OneOf(lit(""), lit("-"), hexs(1, 32))
+	iterations  = hegel.OneOf(hegel.SampledFrom([]int{0, 1, 10, 150}), hegel.Integers(0, 500))
+	dnskeyFlags = hegel.OneOf(hegel.SampledFrom([]int{256, 257, 0}), u16s)
+	dnssecCases = dnssecCasesOf(dnssecNames, dnskeyAlgs)
+)
+
+// keysOf: the public key of a DNSKEY of the algorithm: 1 to 80 bytes, at
+// least 3 for RSA/MD5, whose key tag is read from the last three (RFC 4034
+// appendix B.1; dnspython's key_id wants them).
+func keysOf(alg int) hegel.Generator[[]byte] {
+	if alg == 1 {
+		return hegel.Binary(3, 80)
+	}
+	return hegel.Binary(1, 80)
+}
+
+// dnssecCasesOf: a case over the names and DNSKEY algorithms given.
+func dnssecCasesOf(nameGen hegel.Generator[string], algs hegel.Generator[int]) hegel.Generator[dnssecCase] {
+	return hegel.Composite(func(tc hegel.TestCase) dnssecCase {
+		alg := hegel.Draw(tc, algs)
+		return dnssecCase{
+			name:  hegel.Draw(tc, nameGen),
+			salt:  hegel.Draw(tc, hashSalts),
+			iter:  hegel.Draw(tc, iterations),
+			key:   hegel.Draw(tc, keysOf(alg)),
+			flags: hegel.Draw(tc, dnskeyFlags),
+			alg:   alg,
+		}
+	})
+}
+
+// TestHegelDnssecPrimitivesAgreeWithDnspython: NSEC3 hashing, DNSKEY key tags
+// and DS digests agree with dnspython.
+func TestHegelDnssecPrimitivesAgreeWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		dnssecAgrees(ht, t, py, hegel.Draw(ht, dnssecCases))
+	})
+}
+
+// dnssecAgrees is the body of TestHegelDnssecPrimitivesAgreeWithDnspython
+// for one case.
+func dnssecAgrees(ht *hegel.T, t *testing.T, py *python, tcase dnssecCase) {
+	name, salt, iter := tcase.name, tcase.salt, tcase.iter
+	// NSEC3
+	pySalt := salt
+	if pySalt == "-" {
+		pySalt = "" // HashName takes the salt as hex, "-" is the presentation form of no salt
+	}
+	got := dns.HashName(name, dns.SHA1, uint16(iter), pySalt)
+	var ph struct {
+		Hash string `json:"hash"`
+	}
+	if err := py.call(t, map[string]any{"op": "nsec3", "name": name, "salt": pySalt, "iter": iter, "alg": 1}, &ph); err != nil {
+		ht.Fatalf("dnspython nsec3_hash(%q, %q, %d): %v", name, salt, iter, err)
+	}
+	if !strings.EqualFold(got, ph.Hash) {
+		ht.Fatalf("HashName(%q, SHA1, %d, %q) = %q, dnspython %q", name, iter, salt, got, ph.Hash)
+	}
+	if got == "" {
+		ht.Fatalf("HashName(%q, SHA1, %d, %q) is empty", name, iter, salt)
+	}
+	// DNSKEY key tag and DS
+	text := fmt.Sprintf("%s 3600 IN DNSKEY %d 3 %d %s", name, tcase.flags, tcase.alg, b64Of(tcase.key))
+	rr, err := dns.NewRR(text)
+	if err != nil {
+		ht.Fatalf("NewRR(%q): %v", text, err)
+	}
+	dk := rr.(*dns.DNSKEY)
+	_, rdata, err := packRR(dk)
+	if err != nil {
+		ht.Fatalf("PackRR(%q): %v", text, err)
+	}
+	var pk struct {
+		Tag int `json:"tag"`
+	}
+	if err := py.call(t, map[string]any{"op": "keytag", "wire": hex.EncodeToString(rdata)}, &pk); err != nil {
+		ht.Fatalf("dnspython key_id: %v\n%s", err, text)
+	}
+	if int(dk.KeyTag()) != pk.Tag {
+		ht.Fatalf("KeyTag %d, dnspython %d\n%s", dk.KeyTag(), pk.Tag, text)
+	}
+	for _, h := range []uint8{dns.SHA1, dns.SHA256, dns.SHA384} {
+		ds := dk.ToDS(h)
+		if ds == nil {
+			ht.Fatalf("ToDS(%d) is nil\n%s", h, text)
+		}
+		var pd struct {
+			Text string `json:"text"`
+			Wire string `json:"wire"`
+		}
+		if err := py.call(t, map[string]any{"op": "ds", "name": name, "wire": hex.EncodeToString(rdata), "alg": int(h)}, &pd); err != nil {
+			ht.Fatalf("dnspython make_ds(%d): %v\n%s", h, err, text)
+		}
+		_, dsWire, err := packRR(ds)
+		if err != nil {
+			ht.Fatalf("PackRR of the DS: %v", err)
+		}
+		if hex.EncodeToString(dsWire) != pd.Wire {
+			ht.Fatalf("ToDS(%d) = %s, dnspython %s\n%s", h, hex.EncodeToString(dsWire), pd.Wire, text)
+		}
+		if ds.KeyTag != dk.KeyTag() || ds.Algorithm != dk.Algorithm || ds.DigestType != h {
+			ht.Fatalf("ToDS(%d) fields %d %d %d differ from the key\n%s", h, ds.KeyTag, ds.Algorithm, ds.DigestType, text)
+		}
+	}
+}
+
+var tsigAlgs = []string{dns.HmacSHA1, dns.HmacSHA224, dns.HmacSHA256, dns.HmacSHA384, dns.HmacSHA512}
+
+// tsigCase: an uncompressed message and the key it is signed with.
+type tsigCase struct {
+	spec    msgSpec
+	keyName string
+	secret  string // base64
+	alg     string
+	fudge   uint16
+}
+
+// withRcode is the specification with its rcode (the header's, and the
+// extended one of its OPT) replaced.
+func (s msgSpec) withRcode(rcode int) msgSpec {
+	s.rcode = rcode & 0xF
+	if s.opt != nil {
+		o := *s.opt
+		o.extRcode = 0
+		if rcode > 0xF {
+			o.extRcode = rcode
+		}
+		s.opt = &o
+	}
+	return s
+}
+
+// tsigSpecs: uncompressed messages; under HEGEL_NO_KNOWN=1 not NOTAUTH
+// (TsigVerify refuses those unverified, miekg-dns/18).
+var tsigSpecs = hegel.Map(msgSpecs, func(spec msgSpec) msgSpec {
+	spec.compress = false
+	if Known.tsigVerifyRefusesNotAuth && spec.rcodeValue()&0xF == dns.RcodeNotAuth {
+		spec = spec.withRcode(dns.RcodeSuccess)
+	}
+	return spec
+})
+
+// tsigCasesOf: a message of the specifications signed with a random key.
+func tsigCasesOf(specs hegel.Generator[msgSpec]) hegel.Generator[tsigCase] {
+	return hegel.Composite(func(tc hegel.TestCase) tsigCase {
+		return tsigCase{
+			spec:    hegel.Draw(tc, specs),
+			keyName: strings.ToLower(hegel.Draw(tc, hostNames)),
+			secret:  hegel.Draw(tc, b64s(1, 64)),
+			alg:     hegel.Draw(tc, hegel.SampledFrom(tsigAlgs)),
+			fudge:   uint16(hegel.Draw(tc, hegel.SampledFrom([]int{300, 60, 3600}))),
+		}
+	})
+}
+
+var tsigCases = tsigCasesOf(tsigSpecs)
+
+// GoString is what the draw report prints (it uses %#v).
+func (c tsigCase) GoString() string {
+	return fmt.Sprintf("key %s alg %s fudge %d\n%s", c.keyName, c.alg, c.fudge, c.spec.msg().String())
+}
+
+// TestHegelTsigInteroperates: a message signed with TsigGenerate verifies in
+// dnspython, a message signed by dnspython verifies with TsigVerify, and a
+// damaged message verifies in neither.
+func TestHegelTsigInteroperates(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		tsigAgrees(ht, t, py, hegel.Draw(ht, tsigCases))
+	})
+}
+
+// tsigAgrees is the body of TestHegelTsigInteroperates for one case.
+func tsigAgrees(ht *hegel.T, t *testing.T, py *python, tcase tsigCase) {
+	m, keyName, secret, alg, fudge := tcase.spec.msg(), tcase.keyName, tcase.secret, tcase.alg, tcase.fudge
+
+	// signed here, verified there
+	m.SetTsig(keyName, alg, fudge, time.Now().Unix())
+	signed, mac, err := dns.TsigGenerate(m, secret, "", false)
+	if err != nil {
+		ht.Fatalf("TsigGenerate: %v\n%s", err, m.String())
+	}
+	var pv struct {
+		OK  bool   `json:"ok"`
+		Mac string `json:"mac"`
+		Err string `json:"err"`
+	}
+	if err := py.call(t, map[string]any{"op": "tsig_verify", "wire": hex.EncodeToString(signed), "keyname": keyName, "secret": secret, "alg": alg}, &pv); err != nil {
+		ht.Fatalf("dnspython tsig verify call: %v", err)
+	}
+	if !pv.OK {
+		ht.Fatalf("dnspython rejects a message signed by TsigGenerate: %s\nkey %s alg %s\nwire %s\n%s", pv.Err, keyName, alg, hex.EncodeToString(signed), m.String())
+	}
+	if !strings.EqualFold(pv.Mac, mac) {
+		ht.Fatalf("MAC %s but dnspython read %s", mac, pv.Mac)
+	}
+	// and here again (miekg-dns/15: TsigVerify writes into its argument, so
+	// the Unpack below finds no TSIG; under HEGEL_NO_KNOWN=1 a copy is verified)
+	verified := signed
+	if Known.tsigVerifyMutates {
+		verified = append([]byte(nil), signed...)
+	}
+	if err := dns.TsigVerify(verified, secret, "", false); err != nil {
+		ht.Fatalf("TsigVerify rejects TsigGenerate's own output: %v\nkey %s alg %s\n%s", err, keyName, alg, m.String())
+	}
+	var back dns.Msg
+	if err := back.Unpack(signed); err != nil {
+		ht.Fatalf("Unpack of the signed message: %v", err)
+	}
+	ts := back.IsTsig()
+	if ts == nil {
+		ht.Fatalf("the signed message has no TSIG record after Unpack\nwire %s\n%s", hex.EncodeToString(signed), back.String())
+	}
+	if !strings.EqualFold(ts.Algorithm, alg) || !strings.EqualFold(ts.Hdr.Name, keyName) || int(ts.MACSize)*2 != len(ts.MAC) || !strings.EqualFold(ts.MAC, mac) || ts.Fudge != fudge {
+		ht.Fatalf("TSIG record read back differs: %s (mac %s)", ts.String(), mac)
+	}
+	// a damaged message (the QR bit; the ID is not covered, RFC 8945 5.3.1 restores the original)
+	damaged := append([]byte(nil), signed...)
+	damaged[2] ^= 0x80
+	if err := dns.TsigVerify(damaged, secret, "", false); err == nil {
+		ht.Fatalf("TsigVerify accepts a message with a changed QR bit\nkey %s alg %s", keyName, alg)
+	}
+	if err := py.call(t, map[string]any{"op": "tsig_verify", "wire": hex.EncodeToString(damaged), "keyname": keyName, "secret": secret, "alg": alg}, &pv); err == nil && pv.OK {
+		ht.Fatalf("dnspython accepts a message with a changed QR bit that this library signed")
+	}
+	// wrong secret
+	if err := dns.TsigVerify(signed, b64Of([]byte("other")), "", false); err == nil {
+		ht.Fatalf("TsigVerify accepts the wrong secret")
+	}
+
+	// signed there, verified here (TsigGenerate removed the TSIG stub from m)
+	plain, err := m.Pack()
+	if err != nil {
+		ht.Fatalf("Pack: %v", err)
+	}
+	var ps struct {
+		Wire string `json:"wire"`
+	}
+	if err := py.call(t, map[string]any{"op": "tsig_sign", "wire": hex.EncodeToString(plain), "keyname": keyName, "secret": secret, "alg": alg, "fudge": int(fudge)}, &ps); err != nil {
+		ht.Fatalf("dnspython signing: %v\n%s", err, m.String())
+	}
+	pySigned, _ := hex.DecodeString(ps.Wire)
+	if err := dns.TsigVerify(append([]byte(nil), pySigned...), secret, "", false); err != nil {
+		ht.Fatalf("TsigVerify rejects a message signed by dnspython: %v\nkey %s alg %s\nwire %s\n%s", err, keyName, alg, ps.Wire, m.String())
+	}
+	var back2 dns.Msg
+	if err := back2.Unpack(pySigned); err != nil {
+		ht.Fatalf("Unpack of dnspython's signed message: %v\nwire %s", err, ps.Wire)
+	}
+	if back2.IsTsig() == nil {
+		ht.Fatalf("dnspython's signed message has no TSIG after Unpack")
+	}
+	back2.Extra = back2.Extra[:len(back2.Extra)-1]
+	// (dnspython loses backslashes in URI targets and CAA values: not judged)
+	if !pyLosesBackslash(m) {
+		want, _ := summarize(m)
+		// (dnspython compresses names case-insensitively, so letter case may change)
+		if got, err := summarize(&back2); err != nil || !reflect.DeepEqual(foldSummary(got), foldSummary(want)) {
+			ht.Fatalf("dnspython's signed message carries a different message (%v)\n%s", err, diffSummary(want, got))
+		}
+	}
+}
+
+// Zone files -------------------------------------------------------------------
+
+// zoneOwner: how a record's owner is written.
+type zoneOwner struct {
+	kind int    // 0 "@", 1 an absolute name under the current origin, 2 a relative name, 3 blank (the previous owner), 4 a fixed word
+	name string // kinds 1, 2 and 4
+}
+
+// text renders the owner under the current $ORIGIN; a blank owner before any
+// record (miekg-dns/14 gives it an empty name) is written "@" under
+// HEGEL_NO_KNOWN=1.
+func (o zoneOwner) text(current string, havePrev bool) string {
+	switch o.kind {
+	case 1:
+		return strings.TrimSuffix(o.name+current, ".") + "."
+	case 2, 4:
+		return o.name
+	case 3:
+		if havePrev || !Known.blankFirstOwnerEmpty {
+			return ""
+		}
+	}
+	return "@"
+}
+
+// zoneEntry: one entry of a zone file: an $ORIGIN directive (origin != ""),
+// or a record with its owner, type, rdata, TTL and class and the way it is
+// written.
+type zoneEntry struct {
+	origin   string // "sub" or "Sub.a": a $ORIGIN directive for that subdomain of the zone's origin
+	lead     string // a blank or comment line before the record
+	owner    zoneOwner
+	typ      string
+	rdata    string
+	ttl      string // "" for none
+	class    string // "" for none
+	ttlFirst bool   // the TTL before the class
+	parens   bool   // rdata of three fields or more, without quotes: in parentheses across lines
+	trailing bool   // a trailing comment
+}
+
+var (
+	// namedZoneOwners: the owners written out; zoneOwners: those and a blank owner
+	namedZoneOwners = hegel.OneOf(
+		hegel.Just(zoneOwner{kind: 0}),
+		hegel.Map(hostNames, func(h string) zoneOwner { return zoneOwner{1, strings.ToLower(h)} }),
+		hegel.Map(hostNames, func(h string) zoneOwner { return zoneOwner{2, strings.TrimSuffix(h, ".")} }),
+		hegel.Map(hegel.SampledFrom([]string{"www", "MAIL", "_tcp", "a.b"}), func(w string) zoneOwner { return zoneOwner{4, w} }),
+	)
+	zoneOwners = hegel.OneOf(namedZoneOwners, hegel.Just(zoneOwner{kind: 3}))
+	// the fields of a record entry and the directives of a zone
+	zoneLeads     = maybe(10, hegel.SampledFrom([]string{"\n", "; a comment\n", "   ; indented comment\n"}))
+	entryTTLs     = hegel.SampledFrom([]string{"", "", "3600", "1h", "0", "2147483647"})
+	entryClasses  = hegel.SampledFrom([]string{"", "", "IN"})
+	zoneOrigins   = hegel.SampledFrom([]string{"example.com.", "Example.ORG.", "a.b.c.", "x."})
+	zoneTTLs      = hegel.SampledFrom([]string{"3600", "1h", "86400", "0"})
+	originEntries = hegel.Map(hegel.SampledFrom([]string{"sub", "Sub.a"}), func(s string) zoneEntry { return zoneEntry{origin: s} })
+	// zoneTypes: the types of a zone's records: no SOA (dnspython wants it at
+	// the origin only) or CNAME (alone at its node); IPSECKEY eats the record
+	// after it (miekg-dns/17), so it is left out under HEGEL_NO_KNOWN=1
+	zoneTypes = func() []string {
+		var ts []string
+		for _, t := range rrTypes {
+			if t == "SOA" || t == "CNAME" || (t == "IPSECKEY" && Known.ipseckeyEatsNewline) {
+				continue
+			}
+			ts = append(ts, t)
+		}
+		return ts
+	}()
+	zoneRecordEntries = zoneRecordEntriesOf(zoneTypes)
+	// zoneEntries: a record nine times in ten, else an $ORIGIN directive
+	zoneEntries = zoneEntriesOf(zoneRecordEntries)
+)
+
+// zoneRecordsOf: a record entry of the type with the rdata and one of the
+// owners, written every way the zone syntax allows.
+func zoneRecordsOf(typ string, rdata hegel.Generator[string], owners hegel.Generator[zoneOwner]) hegel.Generator[zoneEntry] {
+	return hegel.Composite(func(tc hegel.TestCase) zoneEntry {
+		return zoneEntry{
+			lead:     hegel.Draw(tc, zoneLeads),
+			owner:    hegel.Draw(tc, owners),
+			typ:      typ,
+			rdata:    hegel.Draw(tc, rdata),
+			ttl:      hegel.Draw(tc, entryTTLs),
+			class:    hegel.Draw(tc, entryClasses),
+			ttlFirst: hegel.Draw(tc, chance(50)),
+			parens:   hegel.Draw(tc, chance(20)),
+			trailing: hegel.Draw(tc, chance(15)),
+		}
+	})
+}
+
+// zoneRecordEntriesOf: a record entry of one of the types.
+func zoneRecordEntriesOf(types []string) hegel.Generator[zoneEntry] {
+	return hegel.FlatMap(hegel.SampledFrom(types), func(typ string) hegel.Generator[zoneEntry] {
+		return zoneRecordsOf(typ, zoneRdatas(typ), zoneOwners)
+	})
+}
+
+// zoneEntriesOf: one of the records nine times in ten, else an $ORIGIN directive.
+func zoneEntriesOf(records hegel.Generator[zoneEntry]) hegel.Generator[zoneEntry] {
+	return weighted(choice[zoneEntry]{90, records}, choice[zoneEntry]{10, originEntries})
+}
+
+// zoneCoveredTypes: the types a zone's RRSIG covers: not CNAME, which
+// dnspython's zone takes for CNAME data (an RRSIG counts as the type it
+// covers), refusing it beside other data at the node as it refuses a CNAME.
+var zoneCoveredTypes = func() []string {
+	var ts []string
+	for _, t := range typeNamePool {
+		if t != "CNAME" {
+			ts = append(ts, t)
+		}
+	}
+	return ts
+}()
+
+// zoneRdatas: the rdata of the type; the name-bearing types NS, PTR, DNAME
+// and MX carry a relative name 30% of the time.
+func zoneRdatas(typ string) hegel.Generator[string] {
+	switch typ {
+	case "NS", "PTR", "DNAME":
+		return weighted(choice[string]{70, rdataGens[typ]}, choice[string]{30, hegel.SampledFrom([]string{"ns1", "@", "a.b", "Mail"})})
+	case "MX":
+		return weighted(choice[string]{70, rdataGens[typ]}, choice[string]{30, fields(d16, hegel.SampledFrom([]string{"mail", "@", "mx.example"}))})
+	case "RRSIG":
+		return rrsigsOf(hegel.SampledFrom(zoneCoveredTypes))
+	}
+	return rdataGens[typ]
+}
+
+// zoneCase: a zone file: its origin, the $TTL directive and up to eight entries.
+type zoneCase struct {
+	origin  string
+	ttl     string
+	entries []zoneEntry
+}
+
+// zoneCasesOf: a zone file with the entries.
+func zoneCasesOf(entries hegel.Generator[[]zoneEntry]) hegel.Generator[zoneCase] {
+	return hegel.Composite(func(tc hegel.TestCase) zoneCase {
+		return zoneCase{
+			origin:  hegel.Draw(tc, zoneOrigins),
+			ttl:     hegel.Draw(tc, zoneTTLs),
+			entries: hegel.Draw(tc, entries),
+		}
+	})
+}
+
+var zoneCases = zoneCasesOf(hegel.Lists(zoneEntries).MaxSize(8))
+
+// text writes the zone in master file syntax: $TTL and $ORIGIN directives,
+// relative and absolute owners, @, blank owners, parentheses, comments, TTL
+// and class in either order or omitted.
+func (z zoneCase) text() string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "$TTL %s\n", z.ttl)
+	current := z.origin
+	havePrev := false
+	for _, e := range z.entries {
+		if e.origin != "" {
+			current = e.origin + "." + z.origin
+			fmt.Fprintf(&sb, "$ORIGIN %s\n", current)
+			continue
+		}
+		sb.WriteString(e.lead)
+		owner := e.owner.text(current, havePrev)
+		line := owner
+		order := []string{e.ttl, e.class}
+		if !e.ttlFirst {
+			order = []string{e.class, e.ttl}
+		}
+		for _, f := range order {
+			if f != "" {
+				line += " " + f
+			}
+		}
+		if owner == "" {
+			line = " " + line
+		}
+		line += " " + e.typ + " "
+		if e.parens && strings.Count(e.rdata, " ") >= 2 && !strings.Contains(e.rdata, "\"") {
+			// parentheses around the rdata, split over lines with a comment after
+			// the first field (which the readers of type bitmaps and RRSIG
+			// signatures reject, miekg-dns/13: no comment there under HEGEL_NO_KNOWN=1)
+			parts := strings.SplitN(e.rdata, " ", 3)
+			comment := " ; first"
+			if Known.parenCommentBreaksBitmap && commentBreaksParens(e.typ) {
+				comment = ""
+			}
+			line += "( " + parts[0] + comment + "\n\t" + parts[1] + "\n\t" + parts[2] + " )"
+		} else {
+			line += e.rdata
+		}
+		if e.trailing {
+			line += " ; trailing comment"
+		}
+		sb.WriteString(line + "\n")
+		havePrev = true
+	}
+	return sb.String()
+}
+
+// commentBreaksParens reports the types whose parser rejects a comment inside
+// parentheses (miekg-dns/13).
+func commentBreaksParens(typ string) bool {
+	switch typ {
+	case "NSEC", "NSEC3", "CSYNC", "RRSIG":
+		return true
+	}
+	return false
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (z zoneCase) GoString() string { return fmt.Sprintf("origin %s zone:\n%s", z.origin, z.text()) }
+
+type rrsetKey struct {
+	Name  string
+	Type  uint16
+	Class uint16
+}
+
+type rrset struct {
+	TTL    uint32
+	Rdatas []string
+}
+
+// isSingleton reports dnspython's singleton types, of which a node holds one
+// rdata: the last one written replaces the others (Rdataset.add).
+func isSingleton(typ uint16) bool {
+	switch typ {
+	case dns.TypeSOA, dns.TypeNXT, dns.TypeDNAME, dns.TypeNSEC, dns.TypeCNAME:
+		return true
+	}
+	return false
+}
+
+// rrsets groups records the way dnspython's zone does: one TTL (the minimum)
+// per owner/type/class, no duplicate rdata, and a single rdata (the last) for
+// the singleton types.
+func rrsets(keys []rrKey) map[rrsetKey]rrset {
+	out := map[rrsetKey]rrset{}
+	for _, k := range keys {
+		sk := rrsetKey{foldHex(k.Name), k.Type, k.Class}
+		set, ok := out[sk]
+		if !ok || k.TTL < set.TTL {
+			set.TTL = k.TTL
+		}
+		if isSingleton(k.Type) {
+			set.Rdatas = nil
+		}
+		dup := false
+		for _, r := range set.Rdatas {
+			if r == k.Rdata {
+				dup = true
+			}
+		}
+		if !dup {
+			set.Rdatas = append(set.Rdatas, k.Rdata)
+		}
+		sort.Strings(set.Rdatas)
+		out[sk] = set
+	}
+	return out
+}
+
+// foldHex lowercases the ASCII letters of hex-encoded bytes (dnspython's zone
+// keeps the first spelling of a name for all records at a node).
+func foldHex(h string) string {
+	b, err := hex.DecodeString(h)
+	if err != nil {
+		return h
+	}
+	for i, c := range b {
+		if c >= 'A' && c <= 'Z' {
+			b[i] = c + 'a' - 'A'
+		}
+	}
+	return hex.EncodeToString(b)
+}
+
+func fmtRRsets(m map[rrsetKey]rrset) string {
+	var lines []string
+	for k, v := range m {
+		lines = append(lines, fmt.Sprintf("  %s %d %d ttl %d %v", k.Name, k.Type, k.Class, v.TTL, v.Rdatas))
+	}
+	sort.Strings(lines)
+	return strings.Join(lines, "\n")
+}
+
+// TestHegelZoneParserAgreesWithDnspython: a generated zone file yields the
+// same records (per owner/type/class, with dnspython's rrset TTL, duplicate
+// and singleton rules) from NewZoneParser and from dnspython's zone reader,
+// and each record's owner is under the origin.
+func TestHegelZoneParserAgreesWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		zoneAgrees(ht, t, py, hegel.Draw(ht, zoneCases))
+	})
+}
+
+// zoneAgrees is the body of TestHegelZoneParserAgreesWithDnspython for one
+// zone file.
+func zoneAgrees(ht *hegel.T, t *testing.T, py *python, tcase zoneCase) {
+	origin, zone := tcase.origin, tcase.text()
+
+	var got []rrKey
+	zp := dns.NewZoneParser(strings.NewReader(zone), origin, "zone")
+	for rr, ok := zp.Next(); ok; rr, ok = zp.Next() {
+		got = append(got, rrKeyOf(rr))
+		if !dns.IsSubDomain(origin, rr.Header().Name) {
+			ht.Fatalf("record %s outside the origin %s\nzone:\n%s", rr.String(), origin, zone)
+		}
+	}
+	gerr := zp.Err()
+	var pz struct {
+		RRs []struct {
+			Name  string `json:"name"`
+			Type  int    `json:"type"`
+			Class int    `json:"class"`
+			TTL   uint32 `json:"ttl"`
+			Rdata string `json:"rdata"`
+			Text  string `json:"text"`
+		} `json:"rrs"`
+	}
+	perr := py.call(t, map[string]any{"op": "zone", "text": zone, "origin": origin}, &pz)
+	if gerr != nil && perr != nil {
+		note(ht, "both reject: go %v python %v", gerr, perr)
+		return
+	}
+	if gerr != nil {
+		ht.Fatalf("ZoneParser rejects a zone dnspython reads: %v\nzone:\n%s", gerr, zone)
+	}
+	if perr != nil {
+		ht.Fatalf("dnspython rejects a zone ZoneParser reads: %v\nzone:\n%s", perr, zone)
+	}
+	var want []rrKey
+	for _, r := range pz.RRs {
+		want = append(want, rrKey{Name: r.Name, Type: uint16(r.Type), Class: uint16(r.Class), TTL: r.TTL, Rdata: r.Rdata})
+	}
+	g, w := rrsets(got), rrsets(want)
+	if fmtRRsets(g) != fmtRRsets(w) {
+		ht.Fatalf("records differ\n go:\n%s\n python:\n%s\nzone:\n%s", fmtRRsets(g), fmtRRsets(w), zone)
+	}
+}
diff --git a/hegel_gen_test.go b/hegel_gen_test.go
new file mode 100644
index 0000000..97ddf24
--- /dev/null
+++ b/hegel_gen_test.go
@@ -0,0 +1,646 @@
+package dns_test
+
+// Generators: domain names in presentation form, character strings, and the
+// rdata of the record types both libraries read, as generator values.  A
+// field list is `fields(...)`: the parts drawn independently and joined with
+// spaces; a token of several pieces is `cat(...)`.  Each record type's rdata
+// generator is an entry of rdataGens.
+
+import (
+	"encoding/base32"
+	"encoding/base64"
+	"encoding/hex"
+	"fmt"
+	"net"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/miekg/dns"
+	"hegel.dev/go/hegel"
+)
+
+// Names -----------------------------------------------------------------------
+
+var labelPool = []string{
+	"a", "b", "www", "mail", "example", "com", "net", "org", "arpa", "in-addr", "_sip", "_tcp",
+	"xn--4gbwdl", "A", "Example", "COM", "x-y", "a1", "9", "_", "-a", "a-", "aa", "ab", "abc",
+	"foo", "bar", "baz", "z", "Z",
+}
+
+var (
+	poolLabels = hegel.SampledFrom(labelPool)
+	// hostLabels: plain LDH labels (the first sixteen of the pool)
+	hostLabels = hegel.SampledFrom(labelPool[:16])
+	// dddEscapes: a \DDD escape of a byte of note or of any byte
+	dddEscapes = hegel.Map(hegel.OneOf(hegel.SampledFrom([]int{0, 32, 46, 64, 92, 127, 128, 200, 255}), hegel.Integers(0, 255)), func(b int) string {
+		return fmt.Sprintf("\\%03d", b)
+	})
+	// charEscapes: an escaped dot, backslash or other character
+	charEscapes = hegel.SampledFrom([]string{"\\.", "\\\\", "\\a", "\\ ", "\\;", "\\(", "\\@", "\\$"})
+	// plainLabels: a pool label six times in eight, else one upper-cased or a run of one letter up to 63 long
+	plainLabels = weighted(
+		choice[string]{60, poolLabels},
+		choice[string]{10, hegel.Map(poolLabels, strings.ToUpper)},
+		choice[string]{10, hegel.Map(pairs(hegel.SampledFrom([]string{"a", "b", "Q"}), hegel.Integers(1, 63)), func(p pair[string, int]) string {
+			return strings.Repeat(p.a, p.b)
+		})},
+	)
+	// labels: a plain label 80% of the time, else a pool label with a \DDD escape or an escaped character appended
+	labels = weighted(
+		choice[string]{80, plainLabels},
+		choice[string]{10, cat(poolLabels, dddEscapes)},
+		choice[string]{10, cat(poolLabels, charEscapes, hegel.SampledFrom([]string{"", "x"}))},
+	)
+)
+
+func dotted(ls []string) string { return strings.Join(ls, ".") + "." }
+
+// namesOf: an absolute name: the root 5% of the time, else one to four of the labels.
+func namesOf(ls hegel.Generator[string]) hegel.Generator[string] {
+	return weighted(
+		choice[string]{5, lit(".")},
+		choice[string]{95, hegel.Map(hegel.Lists(ls).MinSize(1).MaxSize(4), dotted)},
+	)
+}
+
+var (
+	names = namesOf(labels)
+	// plainNames: names without escapes
+	plainNames = namesOf(plainLabels)
+	// hostNames: plain LDH names of one to three labels
+	hostNames = hegel.Map(hegel.Lists(hostLabels).MinSize(1).MaxSize(3), dotted)
+)
+
+// Bytes and encodings -------------------------------------------------------
+
+func hexOf(b []byte) string { return hex.EncodeToString(b) }
+
+func b64Of(b []byte) string { return base64.StdEncoding.EncodeToString(b) }
+
+var b32hex = base32.HexEncoding.WithPadding(base32.NoPadding)
+
+// hexs, b64s: lo to hi bytes in hex or base64.
+func hexs(lo, hi int) hegel.Generator[string] { return hegel.Map(hegel.Binary(lo, hi), hexOf) }
+
+func b64s(lo, hi int) hegel.Generator[string] { return hegel.Map(hegel.Binary(lo, hi), b64Of) }
+
+// Numbers ---------------------------------------------------------------------
+
+var (
+	anyByte = hegel.Integers(0, 255)
+	// u8s, u16s, u32s: the values of note of the width half the time, any value otherwise
+	u8s  = hegel.OneOf(hegel.SampledFrom([]int{0, 1, 2, 3, 8, 13, 15, 255}), anyByte)
+	u16s = hegel.OneOf(hegel.SampledFrom([]int{0, 1, 10, 255, 256, 65535}), hegel.Integers(0, 65535))
+	u32s = hegel.OneOf(
+		hegel.SampledFrom([]uint32{0, 1, 3600, 86400, 2147483647, 2147483648, 4294967295}),
+		hegel.Map(hegel.Integers(0, 1<<31-1), func(x int) uint32 { return uint32(x) }),
+	)
+	d8, d16, d32 = dec(u8s), dec(u16s), dec(u32s)
+)
+
+// Addresses -------------------------------------------------------------------
+
+var (
+	ip4s = hegel.Map(fixed(anyByte, 4), func(b []int) string {
+		return fmt.Sprintf("%d.%d.%d.%d", b[0], b[1], b[2], b[3])
+	})
+	// ip6Bytes: a zero byte 40% of the time, so that :: runs appear
+	ip6Bytes   = weighted(choice[int]{40, hegel.Just(0)}, choice[int]{60, anyByte})
+	randomIP6s = hegel.Map(fixed(ip6Bytes, 16), func(bs []int) string {
+		ip := make(net.IP, 16)
+		for i, b := range bs {
+			ip[i] = byte(b)
+		}
+		return ip.String()
+	})
+	mappedIP6s = cat(lit("::ffff:"), ip4s)
+	db8IP6s    = hegel.Map(hegel.Integers(1, 65535), func(x int) string { return fmt.Sprintf("2001:db8::%x", x) })
+)
+
+// ip6sOf: "::", "::1", a 2001:db8:: address, an IPv4-mapped address when
+// allowed, and a random address (two shares).
+func ip6sOf(mapped bool) hegel.Generator[string] {
+	gens := []hegel.Generator[string]{lit("::"), lit("::1"), db8IP6s}
+	if mapped {
+		gens = append(gens, mappedIP6s)
+	}
+	return hegel.OneOf(append(gens, randomIP6s, randomIP6s)...)
+}
+
+var (
+	ip6s = ip6sOf(true)
+	// unmappedIP6s: ip6s without IPv4-mapped addresses (a random address is
+	// mapped once in a million draws, so a filter covers the remainder)
+	unmappedIP6s = hegel.Filter(ip6sOf(false), func(s string) bool { return net.ParseIP(s).To4() == nil })
+	// gatewayIP6s: the IPv6 of IPSECKEY/AMTRELAY gateways and SVCB ipv6hints;
+	// the library rejects a mapped one (miekg-dns/7), left out under HEGEL_NO_KNOWN=1
+	gatewayIP6s = shaped(ip6s, unmappedIP6s)
+)
+
+// Character strings -----------------------------------------------------------
+
+var (
+	charWords = hegel.SampledFrom([]string{"a", "hello", "v=spf1 -all", "app-name:X", "0123456789", "~", "=", "/", ";", "(", ")", "@"})
+	// charRuns: a run of x or ab, up to 40 long
+	charRuns = hegel.Map(pairs(hegel.SampledFrom([]string{"x", "ab"}), hegel.Integers(1, 40)), func(p pair[string, int]) string {
+		return strings.Repeat(p.a, p.b)
+	})
+	charEscapeBytes = hegel.OneOf(hegel.SampledFrom([]int{0, 10, 32, 34, 92, 127, 128, 255}), anyByte)
+)
+
+// charPieces: the pieces of a <character-string>: a word three times in
+// eight, and once each a space, \", \\, a \DDD escape (below 128 when ascii:
+// dnspython reads the NAPTR and ISDN strings as text and writes them in
+// UTF-8, so a high byte does not survive it) and a run.
+func charPieces(ascii bool) hegel.Generator[string] {
+	ddd := hegel.Map(charEscapeBytes, func(b int) string {
+		if ascii {
+			b &= 127
+		}
+		return fmt.Sprintf("\\%03d", b)
+	})
+	return weighted(
+		choice[string]{3, charWords},
+		choice[string]{1, lit(" ")},
+		choice[string]{1, lit("\\\"")},
+		choice[string]{1, lit("\\\\")},
+		choice[string]{1, ddd},
+		choice[string]{1, charRuns},
+	)
+}
+
+// octetCount is the number of octets a piece of presentation text stands
+// for: an escape (\DDD or \x) is one.
+func octetCount(s string) int {
+	n := 0
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\\' && i+3 < len(s) && s[i+1] >= '0' && s[i+1] <= '9' {
+			i += 3
+		} else if s[i] == '\\' && i+1 < len(s) {
+			i++
+		}
+		n++
+	}
+	return n
+}
+
+// charStrings: a quoted <character-string> of up to six pieces and at most
+// maxLen octets (a run is cut to fit; the pieces after the limit are
+// dropped), with the escapes both libraries read: \" \\ \DDD.
+func charStrings(maxLen int, ascii bool) hegel.Generator[string] {
+	return hegel.Map(hegel.Lists(charPieces(ascii)).MaxSize(6), func(ps []string) string { return quoteCharString(ps, maxLen) })
+}
+
+// quoteCharString joins the pieces into a quoted <character-string> of at
+// most maxLen octets.
+func quoteCharString(ps []string, maxLen int) string {
+	var sb strings.Builder
+	sb.WriteByte('"')
+	size := 0
+	for _, p := range ps {
+		n := octetCount(p)
+		if size+n > maxLen {
+			if strings.Contains(p, "\\") {
+				break
+			}
+			p = p[:maxLen-size]
+			n = len(p)
+		}
+		sb.WriteString(p)
+		size += n
+		if size >= maxLen {
+			break
+		}
+	}
+	sb.WriteByte('"')
+	return sb.String()
+}
+
+// Type bitmaps ------------------------------------------------------------------
+
+// Type names both libraries know (for NSEC/CSYNC bitmaps and RRSIG covers).
+var typeNamePool = []string{"A", "NS", "CNAME", "SOA", "PTR", "MX", "TXT", "AAAA", "SRV", "NAPTR", "DS", "RRSIG", "NSEC", "DNSKEY", "NSEC3", "NSEC3PARAM", "TLSA", "CAA", "HTTPS", "SVCB", "TYPE1234", "TYPE65280", "URI", "OPENPGPKEY", "ZONEMD", "SPF", "HINFO", "CERT", "LOC", "APL"}
+
+// typeLists: lo to hi type mnemonics, distinct, in the order drawn (the
+// library cannot pack an unsorted bitmap, miekg-dns/2); sorted by type code
+// under HEGEL_NO_KNOWN=1.
+func typeLists(lo, hi int) hegel.Generator[string] {
+	return typeListsOf(lo, hi, Known.unsortedTypeBitmap)
+}
+
+// typeListsOf: lo to hi distinct type mnemonics, sorted by type code or in
+// the order drawn.
+func typeListsOf(lo, hi int, sorted bool) hegel.Generator[string] {
+	return hegel.Map(hegel.Lists(hegel.SampledFrom(typeNamePool)).MinSize(lo).MaxSize(hi), func(ts []string) string {
+		out := distinct(ts)
+		if sorted {
+			sortTypes(out)
+		}
+		return strings.Join(out, " ")
+	})
+}
+
+// sortTypes sorts type mnemonics by type code, the order of the wire bitmap.
+func sortTypes(ts []string) {
+	sort.Slice(ts, func(i, j int) bool { return typeCode(ts[i]) < typeCode(ts[j]) })
+}
+
+// optTypeLists: nothing, or a space and one to hi types, half the time each.
+func optTypeLists(hi int) hegel.Generator[string] {
+	return optTypeListsOf(hi, Known.unsortedTypeBitmap)
+}
+
+func optTypeListsOf(hi int, sorted bool) hegel.Generator[string] {
+	return hegel.OneOf(lit(""), cat(lit(" "), typeListsOf(1, hi, sorted)))
+}
+
+// typeCode returns the numeric type of a mnemonic (TYPEnnn or a known name).
+func typeCode(s string) int {
+	if strings.HasPrefix(s, "TYPE") {
+		v, _ := strconv.Atoi(s[4:])
+		return v
+	}
+	return int(dns.StringToType[s])
+}
+
+// Times, LOC, SVCB --------------------------------------------------------------
+
+// rrsigTimes: an RRSIG time as YYYYMMDDHHmmSS, the years of note half the time.
+var rrsigTimes = cat(
+	padded(4, hegel.OneOf(hegel.SampledFrom([]int{1971, 2000, 2026, 2038, 2100, 2105}), hegel.Integers(1971, 2105))),
+	padded(2, hegel.Integers(1, 12)),
+	padded(2, hegel.Integers(1, 28)),
+	padded(2, hegel.Integers(0, 23)),
+	padded(2, hegel.Integers(0, 59)),
+	padded(2, hegel.Integers(0, 59)),
+)
+
+// LOC sizes with an exact cm mantissa/exponent representation.
+var locSizes = []string{"0.01m", "0.05m", "0.3m", "1m", "7m", "40m", "500m", "6000m", "90000m", "800000m", "9000000m", "10000000m", "90000000m", "900000000m", "1m", "1m"}
+
+// locsOf: a LOC rdata from its latitude, longitude and altitude generators.
+func locsOf(lat, long, alt hegel.Generator[string]) hegel.Generator[string] {
+	return cat(fields(lat, long, alt), locSizeLists)
+}
+
+var (
+	// exactMillis: milliseconds that are exact binary fractions of a second
+	exactMillis = hegel.SampledFrom([]int{0, 125, 250, 375, 500, 625, 750, 875})
+	// locMillis: the milliseconds of LOC seconds, any (the parser truncates
+	// 1000*4.031 to 4030, miekg-dns/9); exact binary fractions under
+	// HEGEL_NO_KNOWN=1
+	locMillis = shaped(hegel.Integers(0, 999), exactMillis)
+	// locCents: the centimetres of LOC altitudes: exact binary fractions,
+	// since dnspython truncates 0.58*100 to 57 (an oracle difference, not
+	// judged; the library rounds)
+	locCents = hegel.SampledFrom([]int{0, 25, 50, 75})
+	// rangedAltitudes: within RFC 1876's range, whole metres 30% of the time
+	rangedAltitudes = weighted(
+		choice[string]{30, cat(dec(hegel.Integers(-100000, 42849672)), lit("m"))},
+		choice[string]{70, cat(
+			dec(hegel.OneOf(hegel.SampledFrom([]int{0, 10, -24, -99999, 42849672}), hegel.Integers(-99999, 42849671))),
+			lit("."), padded(2, locCents), lit("m"),
+		)},
+	)
+	// wrappedAltitudes: below -100000.00m or above 42849672.95m, which the
+	// parser wraps around instead of rejecting (miekg-dns/10)
+	wrappedAltitudes = hegel.OneOf(
+		cat(dec(hegel.Integers(-1000000, -100001)), lit("m")),
+		cat(dec(hegel.Integers(42849673, 100000000)), lit("m")),
+		cat(lit("-100000."), padded(2, hegel.Integers(1, 99)), lit("m")),
+	)
+	// altitudes: in range, and one in ten out of it; under HEGEL_NO_KNOWN=1 in range only
+	altitudes    = shaped(weighted(choice[string]{90, rangedAltitudes}, choice[string]{10, wrappedAltitudes}), rangedAltitudes)
+	locSizeLists = hegel.Map(hegel.Lists(hegel.SampledFrom(locSizes)).MaxSize(3), func(ss []string) string {
+		return strings.Join(prefixed(" ", ss), "")
+	})
+	latitudes, longitudes = angles(90, []string{"N", "S"}), angles(180, []string{"E", "W"})
+	locs                  = locsOf(latitudes, longitudes, altitudes)
+)
+
+// prefixed puts p in front of every string.
+func prefixed(p string, ss []string) []string {
+	out := make([]string, len(ss))
+	for i, s := range ss {
+		out[i] = p + s
+	}
+	return out
+}
+
+// angles: a LOC latitude or longitude: degrees with the hemisphere letter
+// 20% of the time, degrees and minutes 30% (which the parser rejects,
+// miekg-dns/4; left out under HEGEL_NO_KNOWN=1), else degrees, minutes and
+// seconds with milliseconds.
+func angles(maxDeg int, hems []string) hegel.Generator[string] {
+	return anglesOf(maxDeg, hems, locMillis, !Known.locMinutesNeedSeconds)
+}
+
+// anglesOf: an angle with the milliseconds of its seconds drawn from millis,
+// and the degrees-and-minutes form among the alternatives when minuteForm.
+func anglesOf(maxDeg int, hems []string, millis hegel.Generator[int], minuteForm bool) hegel.Generator[string] {
+	hem := hegel.SampledFrom(hems)
+	cs := []choice[string]{{20, fields(dec(hegel.Integers(0, maxDeg)), hem)}}
+	if minuteForm {
+		cs = append(cs, choice[string]{30, minuteAngles(maxDeg, hems)})
+	}
+	return weighted(append(cs, choice[string]{50, secondAngles(maxDeg, hems, millis)})...)
+}
+
+// minuteAngles: degrees and minutes without seconds (RFC 1876 section 3).
+func minuteAngles(maxDeg int, hems []string) hegel.Generator[string] {
+	return fields(dec(hegel.Integers(0, maxDeg-1)), dec(hegel.Integers(0, 59)), hegel.SampledFrom(hems))
+}
+
+// secondAngles: degrees, minutes and seconds with milliseconds from millis.
+func secondAngles(maxDeg int, hems []string, millis hegel.Generator[int]) hegel.Generator[string] {
+	secs := cat(dec(hegel.Integers(0, 59)), lit("."), padded(3, millis))
+	return fields(dec(hegel.Integers(0, maxDeg-1)), dec(hegel.Integers(0, 59)), secs, hegel.SampledFrom(hems))
+}
+
+// svcbParam: one SvcParam, with its key for the duplicate rule.
+type svcbParam struct {
+	key, text string
+}
+
+func svcbParamOf(key string, values hegel.Generator[string]) hegel.Generator[svcbParam] {
+	return hegel.Map(values, func(v string) svcbParam { return svcbParam{key, key + "=" + v} })
+}
+
+// svcbParams: the SvcParams both libraries read; a second hint address half the time.
+var svcbParams = hegel.OneOf(
+	svcbParamOf("alpn", hegel.SampledFrom([]string{"h2", "h3", "\"h2,h3\"", "\"h3,h2,http/1.1\"", "dot"})),
+	svcbParamOf("port", d16),
+	svcbParamOf("ipv4hint", cat(ip4s, hegel.OneOf(lit(""), cat(lit(","), ip4s)))),
+	svcbParamOf("ipv6hint", cat(gatewayIP6s, hegel.OneOf(lit(""), cat(lit(","), gatewayIP6s)))),
+	hegel.Just(svcbParam{"no-default-alpn", "no-default-alpn"}),
+	svcbParamOf("ech", b64s(1, 20)),
+	svcbParamOf("dohpath", hegel.SampledFrom([]string{"/dns-query{?dns}", "\"/q{?dns}\""})),
+	hegel.Map(pairs(hegel.SampledFrom([]int{65280, 65500, 65534}), hegel.SampledFrom([]string{"\"a b\"", "abc", "\"\"", "\"x\\\\y\""})), func(p pair[int, string]) svcbParam {
+		k := fmt.Sprintf("key%d", p.a)
+		return svcbParam{k, k + "=" + p.b}
+	}),
+)
+
+// svcbSpec: up to four SvcParams and, beside an alpn, a mandatory list 40%
+// of the time with the port it may name.
+type svcbSpec struct {
+	params    []svcbParam
+	mandatory string
+	port      int
+}
+
+var svcbSpecs = hegel.Composite(func(tc hegel.TestCase) svcbSpec {
+	return svcbSpec{
+		params:    hegel.Draw(tc, hegel.Lists(svcbParams).MaxSize(4)),
+		mandatory: hegel.Draw(tc, maybe(40, hegel.SampledFrom([]string{"alpn", "alpn,port", "port"}))),
+		port:      hegel.Draw(tc, u16s),
+	}
+})
+
+// text renders the SvcParams: the first of each key, no-default-alpn only
+// after an alpn (RFC 9460 7.1.1: dnspython checks), the mandatory list last.
+func (s svcbSpec) text() string {
+	seen := map[string]bool{}
+	var out []string
+	for _, p := range s.params {
+		if seen[p.key] || (p.key == "no-default-alpn" && !seen["alpn"]) {
+			continue
+		}
+		seen[p.key] = true
+		out = append(out, p.text)
+	}
+	if seen["alpn"] && s.mandatory != "" {
+		out = append(out, "mandatory="+s.mandatory)
+		if !seen["port"] {
+			out = append(out, fmt.Sprintf("port=%d", s.port))
+		}
+	}
+	return strings.Join(out, " ")
+}
+
+var svcbParamTexts = hegel.Map(svcbSpecs, svcbSpec.text)
+
+// Records ---------------------------------------------------------------------
+
+// rrTypes are the record types both libraries read from text.
+var rrTypes = []string{
+	"A", "AAAA", "NS", "CNAME", "PTR", "DNAME", "NSAP-PTR", "MX", "KX", "RT", "AFSDB", "LP", "SOA", "TXT", "SPF",
+	"AVC", "NINFO", "RESINFO", "HINFO", "ISDN", "X25", "RP", "PX", "GPOS", "SRV", "NAPTR", "CERT", "LOC", "RRSIG",
+	"NSEC", "NSEC3", "NSEC3PARAM", "DS", "CDS", "DLV", "DNSKEY", "CDNSKEY", "SSHFP", "TLSA", "SMIMEA", "HIP",
+	"OPENPGPKEY", "DHCID", "CAA", "URI", "EUI48", "EUI64", "ZONEMD", "CSYNC", "L32", "L64", "NID", "AMTRELAY",
+	"IPSECKEY", "APL", "SVCB", "HTTPS", "TYPE65280", "TYPE1234",
+}
+
+// rrsigsOf: an RRSIG over one of the covered types.
+func rrsigsOf(covered hegel.Generator[string]) hegel.Generator[string] {
+	return fields(covered, d8, dec(hegel.Integers(0, 127)), d32, rrsigTimes, rrsigTimes, d16, names, b64s(1, 80))
+}
+
+// decimals: whole.frac
+func decimals(whole, frac hegel.Generator[int]) hegel.Generator[string] {
+	return cat(dec(whole), lit("."), dec(frac))
+}
+
+// hyphenHex writes bytes as xx-xx-xx (EUI48, EUI64).
+func hyphenHex(b []byte) string {
+	parts := make([]string, len(b))
+	for i, x := range b {
+		parts[i] = fmt.Sprintf("%02x", x)
+	}
+	return strings.Join(parts, "-")
+}
+
+// aplItems: an APL address prefix, IPv4 or IPv6, negated half the time; the
+// library requires the bits beyond the prefix to be zero (dnspython does
+// not), so the address is masked.
+func aplItemsOf(family int, bits int, addrs hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		neg := hegel.Draw(tc, hegel.SampledFrom([]string{"", "!"}))
+		n := hegel.Draw(tc, hegel.Integers(0, bits))
+		ip := net.ParseIP(hegel.Draw(tc, addrs))
+		if family == 1 {
+			ip = ip.To4()
+		}
+		return fmt.Sprintf("%s%d:%s/%d", neg, family, ip.Mask(net.CIDRMask(n, bits)), n)
+	})
+}
+
+var (
+	// txtParts: a bare word 20% of the time, else a quoted string
+	txtParts = weighted(
+		choice[string]{20, hegel.SampledFrom([]string{"abc", "v=spf1", "x", "0"})},
+		choice[string]{80, charStrings(255, false)},
+	)
+	txts    = hegel.Map(hegel.Lists(txtParts).MinSize(1).MaxSize(4), func(ps []string) string { return strings.Join(ps, " ") })
+	asciiCS = charStrings(255, true)
+	// bareX25Addrs, quotedX25Addrs: the X25 address bare, or quoted as the
+	// <character-string> it is (RFC 1183 3.1; dnspython writes it through
+	// UTF-8, so ASCII), which the parser rejects (miekg-dns/5)
+	bareX25Addrs   = hegel.SampledFrom([]string{"311061700956", "1", "0", "abc"})
+	quotedX25Addrs = charStrings(255, true)
+	// x25Addrs: bare or quoted; bare only under HEGEL_NO_KNOWN=1
+	x25Addrs = shaped(hegel.OneOf(bareX25Addrs, quotedX25Addrs), bareX25Addrs)
+	// certTypes: the mnemonics of RFC 4398 and numbers; type 4 (IPKIX, which
+	// the library spells IPIX, miekg-dns/19) written numerically under
+	// HEGEL_NO_KNOWN=1
+	certTypes = hegel.Map(hegel.SampledFrom([]string{"PKIX", "SPKI", "PGP", "IPKIX", "ISPKI", "IPGP", "ACPKIX", "IACPKIX", "URI", "OID", "1", "8", "253", "65535"}), func(s string) string {
+		if s == "IPKIX" && Known.certIPKIXMisspelt {
+			return "4"
+		}
+		return s
+	})
+	salts = hegel.OneOf(lit("-"), hexs(1, 16))
+	// sha1Hashes, otherHashes: an NSEC3 next hashed owner of 20 bytes (SHA-1),
+	// or of 1 to 32 bytes but 20 (which the library packs with a hash length
+	// of 20, miekg-dns/11)
+	sha1Hashes  = hegel.Map(hegel.Binary(20, 20), b32hex.EncodeToString)
+	otherHashes = hegel.Map(hegel.Filter(hegel.Binary(1, 32), func(b []byte) bool { return len(b) != 20 }), b32hex.EncodeToString)
+	// nsec3Hashes: SHA-1 length seven times in ten; SHA-1 only under HEGEL_NO_KNOWN=1
+	nsec3Hashes = shaped(weighted(choice[string]{70, sha1Hashes}, choice[string]{30, otherHashes}), sha1Hashes)
+	// dss: dnspython checks the digest length of the known digest types
+	dss = hegel.FlatMap(hegel.OneOf(hegel.SampledFrom([]int{1, 2, 4}), hegel.Integers(1, 255)), func(dt int) hegel.Generator[string] {
+		digest := hexs(1, 48)
+		if size := map[int]int{1: 20, 2: 32, 3: 32, 4: 48}[dt]; size != 0 {
+			digest = hexs(size, size)
+		}
+		return fields(d16, d8, lit(strconv.Itoa(dt)), digest)
+	})
+	dnskeys = fields(
+		dec(hegel.OneOf(hegel.SampledFrom([]int{256, 257, 0}), u16s)),
+		dec(hegel.OneOf(hegel.Just(3), u8s)),
+		dec(hegel.OneOf(hegel.SampledFrom([]int{8, 13, 15}), u8s)),
+		b64s(1, 70),
+	)
+	// uriTargets: RFC 7553: the target must not be empty (dnspython checks)
+	uriTargets = hegel.Map(charStrings(200, true), func(s string) string {
+		if s == "\"\"" {
+			return "\"https://example.com/\""
+		}
+		return s
+	})
+	// dBits: the AMTRELAY D bit (the library drops the gateway when it is
+	// set, miekg-dns/12); clear under HEGEL_NO_KNOWN=1
+	dBits    = shaped(hegel.SampledFrom([]string{"0", "1"}), lit("0"))
+	hexQuads = hegel.Map(fixed(hegel.Integers(0, 65535), 4), func(q []int) string {
+		return fmt.Sprintf("%04x:%04x:%04x:%04x", q[0], q[1], q[2], q[3])
+	})
+	unknownRdatas = hegel.Map(hegel.Binary(0, 30), func(b []byte) string {
+		if len(b) == 0 {
+			return "\\# 0"
+		}
+		return fmt.Sprintf("\\# %d %s", len(b), hexOf(b))
+	})
+)
+
+// rdataGens: the presentation rdata of each record type.
+var rdataGens = func() map[string]hegel.Generator[string] {
+	m := map[string]hegel.Generator[string]{
+		"A":     ip4s,
+		"AAAA":  ip6s,
+		"SOA":   fields(names, names, d32, d32, d32, d32, d32),
+		"HINFO": fields(asciiCS, asciiCS),
+		// ISDN: dnspython omits an empty subaddress from the wire form (RFC 1183 makes it optional)
+		"ISDN": fields(asciiCS, hegel.SampledFrom([]string{"1", "004", "\"sub\"", "\"a b\""})),
+		"X25":  x25Addrs,
+		"RP":   fields(names, names),
+		"PX":   fields(d16, names, names),
+		// GPOS: RFC 1712 orders longitude, latitude, altitude; dnspython reads latitude first and
+		// range-checks it, so both angles stay within 90 degrees
+		"GPOS": fields(
+			decimals(hegel.Integers(-89, 89), hegel.Integers(0, 9999)),
+			decimals(hegel.Integers(-89, 89), hegel.Integers(0, 9999)),
+			decimals(hegel.Integers(-1000, 100000), hegel.Integers(0, 99)),
+		),
+		"SRV":        fields(d16, d16, d16, names),
+		"NAPTR":      fields(d16, d16, charStrings(20, true), charStrings(30, true), charStrings(60, true), names),
+		"CERT":       fields(certTypes, d16, d8, b64s(1, 40)),
+		"LOC":        locs,
+		"RRSIG":      rrsigsOf(hegel.SampledFrom(typeNamePool)),
+		"NSEC":       cat(names, optTypeLists(6)),
+		"NSEC3":      cat(fields(d8, hegel.SampledFrom([]string{"0", "1"}), d16, salts, nsec3Hashes), optTypeLists(6)),
+		"NSEC3PARAM": fields(d8, hegel.SampledFrom([]string{"0", "1"}), d16, salts),
+		"SSHFP":      fields(d8, d8, hexs(1, 32)),
+		"HIP":        cat(fields(d8, hexs(1, 20), b64s(1, 40)), hegel.Map(hegel.Lists(names).MaxSize(3), func(ns []string) string { return strings.Join(prefixed(" ", ns), "") })),
+		"CAA":        fields(dec(hegel.OneOf(hegel.SampledFrom([]int{0, 128}), u8s)), hegel.SampledFrom([]string{"issue", "issuewild", "iodef", "contactemail", "x1"}), charStrings(200, true)),
+		"URI":        fields(d16, d16, uriTargets),
+		"EUI48":      hegel.Map(hegel.Binary(6, 6), hyphenHex),
+		"EUI64":      hegel.Map(hegel.Binary(8, 8), hyphenHex),
+		"ZONEMD": hegel.OneOf(
+			fields(d32, lit("1 1"), hexs(48, 48)),
+			fields(d32, lit("1 2"), hexs(64, 64)),
+			fields(d32, hegel.SampledFrom([]string{"1", "240"}), hegel.SampledFrom([]string{"240", "241"}), hexs(12, 40)),
+		),
+		"CSYNC": cat(fields(d32, dec(hegel.OneOf(hegel.SampledFrom([]int{0, 1, 2, 3}), u16s))), optTypeLists(5)),
+		"L32":   fields(d16, ip4s),
+		"AMTRELAY": hegel.OneOf(
+			fields(d8, dBits, lit("1"), ip4s),
+			fields(d8, dBits, lit("2"), gatewayIP6s),
+			fields(d8, dBits, lit("3"), names),
+		),
+		"IPSECKEY": ipseckeysOf(gatewayIP6s),
+		"APL": hegel.Map(hegel.Lists(hegel.OneOf(aplItemsOf(1, 32, ip4s), aplItemsOf(2, 128, ip6s))).MaxSize(4), func(ps []string) string {
+			return strings.Join(ps, " ")
+		}),
+	}
+	for _, t := range []string{"NS", "CNAME", "PTR", "DNAME", "NSAP-PTR"} {
+		m[t] = names
+	}
+	for _, t := range []string{"MX", "KX", "RT", "AFSDB", "LP"} {
+		m[t] = fields(d16, names)
+	}
+	for _, t := range []string{"TXT", "SPF", "AVC", "NINFO", "RESINFO"} {
+		m[t] = txts
+	}
+	for _, t := range []string{"DS", "CDS", "DLV"} {
+		m[t] = dss
+	}
+	for _, t := range []string{"DNSKEY", "CDNSKEY"} {
+		m[t] = dnskeys
+	}
+	for _, t := range []string{"TLSA", "SMIMEA"} {
+		m[t] = fields(d8, d8, d8, hexs(1, 40))
+	}
+	for _, t := range []string{"OPENPGPKEY", "DHCID"} {
+		m[t] = b64s(1, 60)
+	}
+	for _, t := range []string{"L64", "NID"} {
+		m[t] = fields(d16, hexQuads)
+	}
+	// SVCB, HTTPS: AliasMode 20% of the time, else a priority, a target (the root half the time) and SvcParams
+	for _, t := range []string{"SVCB", "HTTPS"} {
+		m[t] = weighted(
+			choice[string]{20, cat(lit("0 "), names)},
+			choice[string]{80, fields(dec(hegel.Integers(1, 65535)), hegel.OneOf(lit("."), names), svcbParamTexts)},
+		)
+	}
+	for _, t := range []string{"TYPE65280", "TYPE1234"} {
+		m[t] = unknownRdatas
+	}
+	return m
+}()
+
+// ipseckeysOf: an IPSECKEY rdata with each gateway type, the IPv6 gateways
+// from gw6.
+func ipseckeysOf(gw6 hegel.Generator[string]) hegel.Generator[string] {
+	keys := b64s(1, 40)
+	return hegel.OneOf(
+		fields(d8, lit("0"), d8, lit("."), keys),
+		fields(d8, lit("1"), d8, ip4s, keys),
+		fields(d8, lit("2"), d8, gw6, keys),
+		fields(d8, lit("3"), d8, names, keys),
+	)
+}
+
+// ttl: a TTL in presentation form (plain or with units) and its value.
+type ttl struct {
+	text  string
+	value uint32
+}
+
+var ttls = weighted(
+	choice[ttl]{80, hegel.Map(u32s, func(v uint32) ttl { return ttl{fmt.Sprint(v), v} })},
+	choice[ttl]{20, hegel.Map(pairs(hegel.Integers(0, 100), hegel.Integers(0, 59)), func(p pair[int, int]) ttl {
+		return ttl{fmt.Sprintf("%dh%dm", p.a, p.b), uint32(p.a*3600 + p.b*60)}
+	})},
+)
diff --git a/hegel_messages_test.go b/hegel_messages_test.go
new file mode 100644
index 0000000..7db3b47
--- /dev/null
+++ b/hegel_messages_test.go
@@ -0,0 +1,719 @@
+package dns_test
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/hex"
+	"fmt"
+	"net"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"github.com/miekg/dns"
+	"hegel.dev/go/hegel"
+)
+
+// Message generation ---------------------------------------------------------
+
+// rrText: a record of a type both libraries read, in class IN, with a TTL
+// below 2^31 (dnspython reads larger ones as 0, RFC 2181 section 8).
+type rrText struct {
+	name  string
+	ttl   uint32
+	typ   string
+	rdata string
+}
+
+func (r rrText) text() string { return fmt.Sprintf("%s %d IN %s %s", r.name, r.ttl, r.typ, r.rdata) }
+
+// rrTextsOf: a record of one of the types.
+func rrTextsOf(types []string) hegel.Generator[rrText] {
+	return hegel.FlatMap(hegel.SampledFrom(types), func(typ string) hegel.Generator[rrText] {
+		return hegel.Composite(func(tc hegel.TestCase) rrText {
+			return rrText{
+				name:  hegel.Draw(tc, names),
+				ttl:   hegel.Draw(tc, u32s) & 0x7fffffff,
+				typ:   typ,
+				rdata: hegel.Draw(tc, rdataGens[typ]),
+			}
+		})
+	})
+}
+
+// msgRRsOf: the parsed records; the text NewRR rejects (the shapes of
+// miekg-dns/4, 5, 7 and 19, a few percent) is filtered out.
+func msgRRsOf(texts hegel.Generator[rrText]) hegel.Generator[dns.RR] {
+	return hegel.Filter(hegel.Map(texts, func(r rrText) dns.RR {
+		rr, _ := dns.NewRR(r.text())
+		return rr
+	}), func(rr dns.RR) bool { return rr != nil })
+}
+
+var (
+	rrTexts = rrTextsOf(rrTypes)
+	msgRRs  = msgRRsOf(rrTexts)
+)
+
+// subnetsOf: an EDNS client subnet option of the family: a masked address
+// with a source netmask up to bits, and a scope 30% of the time.
+func subnetsOf(family uint16, bits int, addrs hegel.Generator[string]) hegel.Generator[dns.EDNS0] {
+	return hegel.Composite(func(tc hegel.TestCase) dns.EDNS0 {
+		mask := hegel.Draw(tc, hegel.Integers(0, bits))
+		ip := net.ParseIP(hegel.Draw(tc, addrs))
+		if family == 1 {
+			ip = ip.To4()
+		}
+		return &dns.EDNS0_SUBNET{
+			Code:          dns.EDNS0SUBNET,
+			Family:        family,
+			SourceNetmask: uint8(mask),
+			SourceScope:   uint8(hegel.Draw(tc, maybe(30, hegel.Integers(0, mask)))),
+			Address:       ip.Mask(net.CIDRMask(mask, bits)),
+		}
+	})
+}
+
+// ednsOptions: one of the options both libraries read.
+var ednsOptions = hegel.OneOf(
+	hegel.Map(hexs(0, 16), func(s string) dns.EDNS0 { return &dns.EDNS0_NSID{Code: dns.EDNS0NSID, Nsid: s} }),
+	hegel.OneOf(subnetsOf(1, 32, ip4s), subnetsOf(2, 128, ip6s)),
+	// dnspython reads 8-byte client cookies with 8 to 32 bytes of server cookie
+	hegel.Map(hegel.FlatMap(hegel.OneOf(hegel.SampledFrom([]int{8, 16, 24, 40}), hegel.Integers(16, 40)), func(k int) hegel.Generator[string] {
+		return hexs(k, k)
+	}), func(s string) dns.EDNS0 { return &dns.EDNS0_COOKIE{Code: dns.EDNS0COOKIE, Cookie: s} }),
+	hegel.Map(pairs(u32s, chance(30)), func(p pair[uint32, bool]) dns.EDNS0 {
+		return &dns.EDNS0_EXPIRE{Code: dns.EDNS0EXPIRE, Expire: p.a, Empty: p.b}
+	}),
+	hegel.Map(pairs(u16s, hegel.SampledFrom([]int{0, 2})), func(p pair[int, int]) dns.EDNS0 {
+		return &dns.EDNS0_TCP_KEEPALIVE{Code: dns.EDNS0TCPKEEPALIVE, Timeout: uint16(p.a), Length: uint16(p.b)}
+	}),
+	hegel.Map(hegel.Binary(0, 40), func(b []byte) dns.EDNS0 { return &dns.EDNS0_PADDING{Padding: b} }),
+	hegel.Map(pairs(
+		hegel.OneOf(hegel.SampledFrom([]int{0, 6, 18, 24}), u16s),
+		hegel.OneOf(hegel.SampledFrom([]string{"", "a", "stale answer"}), hegel.Map(hegel.Integers(1, 60), func(n int) string { return strings.Repeat("x", n) })),
+	), func(p pair[int, string]) dns.EDNS0 {
+		return &dns.EDNS0_EDE{InfoCode: uint16(p.a), ExtraText: p.b}
+	}),
+	hegel.Map(hegel.Binary(0, 6), func(b []byte) dns.EDNS0 { return &dns.EDNS0_DAU{Code: dns.EDNS0DAU, AlgCode: b} }),
+	hegel.Map(pairs(hegel.SampledFrom([]int{65001, 65100, 65534}), hegel.Binary(0, 20)), func(p pair[int, []byte]) dns.EDNS0 {
+		return &dns.EDNS0_LOCAL{Code: uint16(p.a), Data: p.b}
+	}),
+	hegel.Composite(func(tc hegel.TestCase) dns.EDNS0 {
+		return &dns.EDNS0_LLQ{
+			Code:      dns.EDNS0LLQ,
+			Version:   uint16(hegel.Draw(tc, u16s)),
+			Opcode:    uint16(hegel.Draw(tc, u16s)),
+			Error:     uint16(hegel.Draw(tc, u16s)),
+			Id:        uint64(hegel.Draw(tc, u32s))<<32 | uint64(hegel.Draw(tc, u32s)),
+			LeaseLife: hegel.Draw(tc, u32s),
+		}
+	}),
+	hegel.Map(pairs(u32s, hegel.OneOf(hegel.Just(uint32(0)), hegel.Just(uint32(0)), u32s)), func(p pair[uint32, uint32]) dns.EDNS0 {
+		return &dns.EDNS0_UL{Code: dns.EDNS0UL, Lease: p.a, KeyLease: p.b}
+	}),
+	hegel.Map(hegel.Binary(0, 3), func(b []byte) dns.EDNS0 { return &dns.EDNS0_N3U{Code: dns.EDNS0N3U, AlgCode: b} }),
+	hegel.Map(hegel.SampledFrom([]string{"sip:example.com", "tel:+123", ""}), func(s string) dns.EDNS0 { return &dns.EDNS0_ESU{Code: dns.EDNS0ESU, Uri: s} }),
+)
+
+// optSpec: an OPT record: the UDP size, the DO and CO bits, a version and Z
+// bits 10% of the time each, up to four options, and an extended rcode 20%
+// of the time (0: the header rcode stands).
+type optSpec struct {
+	udpSize  int
+	do, co   bool
+	version  int
+	z        int
+	options  []dns.EDNS0
+	extRcode int
+}
+
+var optSpecs = hegel.Composite(func(tc hegel.TestCase) optSpec {
+	return optSpec{
+		udpSize:  hegel.Draw(tc, hegel.OneOf(hegel.SampledFrom([]int{512, 1232, 4096, 65535}), u16s)),
+		do:       hegel.Draw(tc, chance(50)),
+		co:       hegel.Draw(tc, chance(20)),
+		version:  hegel.Draw(tc, maybe(10, hegel.Integers(1, 255))),
+		z:        hegel.Draw(tc, maybe(10, hegel.Integers(0, 0x3fff))),
+		options:  hegel.Draw(tc, hegel.Lists(ednsOptions).MaxSize(4)),
+		extRcode: hegel.Draw(tc, maybe(20, hegel.Integers(16, 4095))),
+	}
+})
+
+// msgSpec: a message: header bits, questions, records in the three
+// sections, an OPT half of the time, compression or not.  (No UPDATE:
+// dnspython reads update messages with the semantics of RFC 2136.)
+type msgSpec struct {
+	id                 int
+	response           bool
+	opcode             int
+	authoritative      bool
+	truncated          bool
+	recursionDesired   bool
+	recursionAvailable bool
+	zero               bool
+	authenticatedData  bool
+	checkingDisabled   bool
+	rcode              int
+	question           []dns.Question
+	answer, ns, extra  []dns.RR
+	opt                *optSpec
+	compress           bool
+}
+
+var (
+	questions = hegel.Composite(func(tc hegel.TestCase) dns.Question {
+		return dns.Question{
+			Name:   hegel.Draw(tc, names),
+			Qtype:  uint16(hegel.Draw(tc, hegel.OneOf(hegel.SampledFrom([]int{1, 28, 15, 255, 252, 6, 16, 65280}), u16s))),
+			Qclass: uint16(hegel.Draw(tc, hegel.SampledFrom([]int{1, 1, 255, 3, 254}))),
+		}
+	})
+	opcodes = hegel.OneOf(
+		hegel.SampledFrom([]int{dns.OpcodeQuery, dns.OpcodeQuery, dns.OpcodeNotify, dns.OpcodeIQuery, dns.OpcodeStatus}),
+		hegel.SampledFrom([]int{3, 7, 8, 15}),
+	)
+	rcodes = hegel.OneOf(
+		hegel.SampledFrom([]int{dns.RcodeSuccess, dns.RcodeSuccess, dns.RcodeNameError, dns.RcodeServerFailure, dns.RcodeRefused}),
+		hegel.Integers(0, 15),
+	)
+	msgSpecs = msgSpecsOf(msgRRs)
+)
+
+// msgSpecsOf: a message whose sections hold the records.
+func msgSpecsOf(records hegel.Generator[dns.RR]) hegel.Generator[msgSpec] {
+	return hegel.Composite(func(tc hegel.TestCase) msgSpec {
+		return msgSpec{
+			id:                 hegel.Draw(tc, u16s),
+			response:           hegel.Draw(tc, chance(50)),
+			opcode:             hegel.Draw(tc, opcodes),
+			authoritative:      hegel.Draw(tc, chance(30)),
+			truncated:          hegel.Draw(tc, chance(10)),
+			recursionDesired:   hegel.Draw(tc, chance(60)),
+			recursionAvailable: hegel.Draw(tc, chance(40)),
+			zero:               hegel.Draw(tc, chance(5)),
+			authenticatedData:  hegel.Draw(tc, chance(20)),
+			checkingDisabled:   hegel.Draw(tc, chance(20)),
+			rcode:              hegel.Draw(tc, rcodes),
+			question:           hegel.Draw(tc, hegel.Lists(questions).MaxSize(2)),
+			answer:             hegel.Draw(tc, hegel.Lists(records).MaxSize(4)),
+			ns:                 hegel.Draw(tc, hegel.Lists(records).MaxSize(3)),
+			extra:              hegel.Draw(tc, hegel.Lists(records).MaxSize(3)),
+			opt:                hegel.Draw(tc, hegel.Optional(optSpecs)),
+			compress:           hegel.Draw(tc, chance(50)),
+		}
+	})
+}
+
+// rcodeValue is the rcode the message carries: the extended one with an OPT.
+func (s msgSpec) rcodeValue() int {
+	if s.opt != nil && s.opt.extRcode != 0 {
+		return s.opt.extRcode
+	}
+	return s.rcode
+}
+
+// msg builds the message (fresh slices, so the message can be truncated or
+// signed without touching the specification).
+func (s msgSpec) msg() *dns.Msg {
+	m := new(dns.Msg)
+	m.Id = uint16(s.id)
+	m.Response = s.response
+	m.Opcode = s.opcode
+	m.Authoritative = s.authoritative
+	m.Truncated = s.truncated
+	m.RecursionDesired = s.recursionDesired
+	m.RecursionAvailable = s.recursionAvailable
+	m.Zero = s.zero
+	m.AuthenticatedData = s.authenticatedData
+	m.CheckingDisabled = s.checkingDisabled
+	m.Rcode = s.rcodeValue()
+	m.Question = append([]dns.Question(nil), s.question...)
+	m.Answer = append([]dns.RR(nil), s.answer...)
+	m.Ns = append([]dns.RR(nil), s.ns...)
+	m.Extra = append([]dns.RR(nil), s.extra...)
+	if o := s.opt; o != nil {
+		opt := &dns.OPT{Hdr: dns.RR_Header{Name: ".", Rrtype: dns.TypeOPT}}
+		opt.SetUDPSize(uint16(o.udpSize))
+		opt.SetDo(o.do)
+		if o.co {
+			opt.SetCo(true)
+		}
+		if o.version != 0 {
+			opt.SetVersion(uint8(o.version))
+		}
+		if o.z != 0 {
+			opt.SetZ(uint16(o.z))
+		}
+		opt.Option = append([]dns.EDNS0(nil), o.options...)
+		m.Extra = append(m.Extra, opt)
+	}
+	m.Compress = s.compress
+	return m
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (s msgSpec) GoString() string {
+	return fmt.Sprintf("message (compress %v):\n%s", s.compress, s.msg().String())
+}
+
+// Summaries ------------------------------------------------------------------
+
+type rrKey struct {
+	Name  string // owner in wire form, hex
+	Type  uint16
+	Class uint16
+	TTL   uint32
+	Rdata string // uncompressed rdata, hex
+}
+
+type optKey struct {
+	Code uint16
+	Data string
+}
+
+type ednsSummary struct {
+	Version uint8
+	Payload uint16
+	Flags   uint32 // the OPT TTL field: extended rcode, version, DO/CO/Z
+	Options []optKey
+}
+
+type msgSummary struct {
+	ID       uint16
+	Flags    uint16
+	Rcode    int
+	Question []rrKey // TTL and Rdata unused
+	Sections [3][]rrKey
+	Edns     *ednsSummary
+}
+
+func nameHex(name string) string {
+	w, err := packName(name)
+	if err != nil {
+		return "bad:" + name
+	}
+	return hex.EncodeToString(w)
+}
+
+func rrKeyOf(rr dns.RR) rrKey {
+	_, rdata, err := packRR(rr)
+	if err != nil {
+		return rrKey{Name: nameHex(rr.Header().Name), Type: rr.Header().Rrtype, Class: rr.Header().Class, TTL: rr.Header().Ttl, Rdata: "err:" + err.Error()}
+	}
+	return rrKey{Name: nameHex(rr.Header().Name), Type: rr.Header().Rrtype, Class: rr.Header().Class, TTL: rr.Header().Ttl, Rdata: hex.EncodeToString(rdata)}
+}
+
+func sortKeys(ks []rrKey) []rrKey {
+	sort.Slice(ks, func(i, j int) bool { return fmt.Sprint(ks[i]) < fmt.Sprint(ks[j]) })
+	if len(ks) == 0 {
+		return nil
+	}
+	return ks
+}
+
+// optionsOf reads the options out of the packed OPT rdata.
+func optionsOf(opt *dns.OPT) ([]optKey, error) {
+	_, rdata, err := packRR(opt)
+	if err != nil {
+		return nil, err
+	}
+	var out []optKey
+	for off := 0; off < len(rdata); {
+		if off+4 > len(rdata) {
+			return nil, fmt.Errorf("truncated option at %d", off)
+		}
+		code := binary.BigEndian.Uint16(rdata[off:])
+		size := int(binary.BigEndian.Uint16(rdata[off+2:]))
+		off += 4
+		if off+size > len(rdata) {
+			return nil, fmt.Errorf("option %d overruns the rdata", code)
+		}
+		out = append(out, optKey{Code: code, Data: hex.EncodeToString(rdata[off : off+size])})
+		off += size
+	}
+	return out, nil
+}
+
+func headerFlags(m *dns.Msg) uint16 {
+	var f uint16
+	if m.Response {
+		f |= 1 << 15
+	}
+	f |= uint16(m.Opcode&0xF) << 11
+	if m.Authoritative {
+		f |= 1 << 10
+	}
+	if m.Truncated {
+		f |= 1 << 9
+	}
+	if m.RecursionDesired {
+		f |= 1 << 8
+	}
+	if m.RecursionAvailable {
+		f |= 1 << 7
+	}
+	if m.Zero {
+		f |= 1 << 6
+	}
+	if m.AuthenticatedData {
+		f |= 1 << 5
+	}
+	if m.CheckingDisabled {
+		f |= 1 << 4
+	}
+	f |= uint16(m.Rcode & 0xF)
+	return f
+}
+
+func summarize(m *dns.Msg) (msgSummary, error) {
+	s := msgSummary{ID: m.Id, Flags: headerFlags(m), Rcode: m.Rcode}
+	for _, q := range m.Question {
+		s.Question = append(s.Question, rrKey{Name: nameHex(q.Name), Type: q.Qtype, Class: q.Qclass})
+	}
+	for i, sec := range [][]dns.RR{m.Answer, m.Ns, m.Extra} {
+		var ks []rrKey
+		for _, rr := range sec {
+			if opt, ok := rr.(*dns.OPT); ok {
+				if s.Edns != nil {
+					return s, fmt.Errorf("two OPT records")
+				}
+				opts, err := optionsOf(opt)
+				if err != nil {
+					return s, err
+				}
+				// Pack writes the extended rcode into the OPT TTL of the wire form
+				s.Edns = &ednsSummary{Version: opt.Version(), Payload: opt.UDPSize(), Flags: opt.Hdr.Ttl&0x00ffffff | uint32(m.Rcode>>4)<<24, Options: opts}
+				continue
+			}
+			ks = append(ks, rrKeyOf(rr))
+		}
+		s.Sections[i] = sortKeys(ks)
+	}
+	if s.Edns == nil {
+		s.Rcode &= 0xF
+	}
+	return s, nil
+}
+
+type pyMsg struct {
+	ID       int `json:"id"`
+	Flags    int `json:"flags"`
+	Rcode    int `json:"rcode"`
+	Question []struct {
+		Name  string `json:"name"`
+		Type  int    `json:"type"`
+		Class int    `json:"class"`
+	} `json:"question"`
+	Sections [][]struct {
+		Name  string `json:"name"`
+		Type  int    `json:"type"`
+		Class int    `json:"class"`
+		TTL   uint32 `json:"ttl"`
+		Rdata string `json:"rdata"`
+		Text  string `json:"text"`
+	} `json:"sections"`
+	Rewire string `json:"rewire"`
+	Edns   *struct {
+		Version   int    `json:"version"`
+		Payload   int    `json:"payload"`
+		EdnsFlags uint32 `json:"ednsflags"`
+		Options   []struct {
+			Otype int    `json:"otype"`
+			Data  string `json:"data"`
+			Text  string `json:"text"`
+		} `json:"options"`
+	} `json:"edns"`
+}
+
+func (p *pyMsg) summary() msgSummary {
+	s := msgSummary{ID: uint16(p.ID), Flags: uint16(p.Flags), Rcode: p.Rcode}
+	for _, q := range p.Question {
+		s.Question = append(s.Question, rrKey{Name: q.Name, Type: uint16(q.Type), Class: uint16(q.Class)})
+	}
+	for i, sec := range p.Sections {
+		var ks []rrKey
+		for _, r := range sec {
+			ks = append(ks, rrKey{Name: r.Name, Type: uint16(r.Type), Class: uint16(r.Class), TTL: r.TTL, Rdata: r.Rdata})
+		}
+		if i < 3 {
+			s.Sections[i] = sortKeys(ks)
+		}
+	}
+	if p.Edns != nil {
+		e := &ednsSummary{Version: uint8(p.Edns.Version), Payload: uint16(p.Edns.Payload), Flags: p.Edns.EdnsFlags}
+		for _, o := range p.Edns.Options {
+			e.Options = append(e.Options, optKey{Code: uint16(o.Otype), Data: o.Data})
+		}
+		s.Edns = e
+	}
+	return s
+}
+
+func diffSummary(a, b msgSummary) string {
+	var sb strings.Builder
+	if a.ID != b.ID || a.Flags != b.Flags || a.Rcode != b.Rcode {
+		fmt.Fprintf(&sb, " header: id %d/%d flags %#x/%#x rcode %d/%d\n", a.ID, b.ID, a.Flags, b.Flags, a.Rcode, b.Rcode)
+	}
+	if !reflect.DeepEqual(a.Question, b.Question) {
+		fmt.Fprintf(&sb, " question:\n  %v\n  %v\n", a.Question, b.Question)
+	}
+	for i := range a.Sections {
+		if !reflect.DeepEqual(a.Sections[i], b.Sections[i]) {
+			fmt.Fprintf(&sb, " section %d:\n  %v\n  %v\n", i, a.Sections[i], b.Sections[i])
+		}
+	}
+	if !reflect.DeepEqual(a.Edns, b.Edns) {
+		fmt.Fprintf(&sb, " edns:\n  %+v\n  %+v\n", a.Edns, b.Edns)
+	}
+	return sb.String()
+}
+
+// foldSummary lowercases the ASCII letters in names and rdata.
+func foldSummary(s msgSummary) msgSummary {
+	s.Question = append([]rrKey(nil), s.Question...)
+	for i := range s.Question {
+		s.Question[i].Name = foldHex(s.Question[i].Name)
+	}
+	for i := range s.Sections {
+		ks := append([]rrKey(nil), s.Sections[i]...)
+		for j := range ks {
+			ks[j].Name = foldHex(ks[j].Name)
+			ks[j].Rdata = foldHex(ks[j].Rdata)
+		}
+		s.Sections[i] = sortKeys(ks)
+	}
+	return s
+}
+
+func pyLosesBackslash(m *dns.Msg) bool {
+	for _, sec := range [][]dns.RR{m.Answer, m.Ns, m.Extra} {
+		for _, rr := range sec {
+			switch rr.Header().Rrtype {
+			case dns.TypeURI, dns.TypeCAA:
+				if _, rdata, err := packRR(rr); err == nil && bytes.Contains(rdata, []byte{'\\'}) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+// msgLenIsApproximate: the message holds a record whose own Len is off (bug 1:
+// escapes, base64 padding, empty bitmaps). String() prints a \DDD escape of a
+// printable byte as the byte itself (TXT "\032" prints as " "), so the text is
+// not enough: each record's Len is compared with its packed size too.
+func msgLenIsApproximate(m *dns.Msg) bool {
+	for _, sec := range [][]dns.RR{m.Answer, m.Ns, m.Extra} {
+		for _, rr := range sec {
+			if lenIsApproximate(rr.String(), dns.TypeToString[rr.Header().Rrtype]) {
+				return true
+			}
+			if wire, _, err := packRR(rr); err == nil && dns.Len(rr) != len(wire) {
+				return true
+			}
+		}
+	}
+	for _, q := range m.Question {
+		if strings.Contains(q.Name, "\\") {
+			return true
+		}
+	}
+	return false
+}
+
+// Properties ------------------------------------------------------------------
+
+// TestHegelMessagesAgreeWithDnspython: a packed message (compressed or not)
+// is read by dnspython to the same header, questions, records and EDNS data;
+// dnspython's re-serialisation unpacks to the same message; the library's own
+// unpack and repack are byte-stable; Len equals the packed size; Copy is equal.
+func TestHegelMessagesAgreeWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		m := hegel.Draw(ht, msgSpecs).msg()
+		want, err := summarize(m)
+		if err != nil {
+			ht.Fatalf("summarising the generated message: %v\n%s", err, m.String())
+		}
+		wire, err := m.Pack()
+		if err != nil {
+			ht.Fatalf("Pack: %v\n%s", err, m.String())
+		}
+		// (miekg-dns/1: Len overestimates; not judged for the shapes under HEGEL_NO_KNOWN=1)
+		if l := m.Len(); l < len(wire) || (l != len(wire) && !(Known.lenOverestimates && msgLenIsApproximate(m))) {
+			ht.Fatalf("Len %d but Pack wrote %d bytes (compress %v)\n%s", l, len(wire), m.Compress, m.String())
+		}
+		// dnspython reads it
+		var pm pyMsg
+		if err := py.call(t, map[string]any{"op": "message", "wire": hex.EncodeToString(wire)}, &pm); err != nil {
+			ht.Fatalf("dnspython rejects the packed message: %v\nwire %s\n%s", err, hex.EncodeToString(wire), m.String())
+		}
+		if got := pm.summary(); !reflect.DeepEqual(got, want) {
+			ht.Fatalf("dnspython reads the message differently (go / python)\n%s\nwire %s\n%s", diffSummary(want, got), hex.EncodeToString(wire), m.String())
+		}
+		// dnspython's own serialisation unpacks to the same message (dnspython
+		// loses backslashes in URI targets and CAA values on the way: not judged)
+		if !pyLosesBackslash(m) {
+			rewire, err := hex.DecodeString(pm.Rewire)
+			if err != nil {
+				ht.Fatalf("bad rewire hex: %v", err)
+			}
+			var fromPy dns.Msg
+			if err := fromPy.Unpack(rewire); err != nil {
+				ht.Fatalf("Unpack of dnspython's serialisation: %v\nwire %s\n%s", err, pm.Rewire, m.String())
+			}
+			// (dnspython compresses names case-insensitively, so letter case may change)
+			if got, err := summarize(&fromPy); err != nil || !reflect.DeepEqual(foldSummary(got), foldSummary(want)) {
+				ht.Fatalf("dnspython's serialisation unpacks differently (%v) (go / from python)\n%s\nwire %s\n%s", err, diffSummary(want, got), pm.Rewire, m.String())
+			}
+		}
+		// the library's own round trip.  An unpacked CAA or URI value with a
+		// backslash packs without it (packOctetString reads the raw octets the
+		// unpacker stored as escapes: the pack side of miekg-dns/6), so the
+		// re-packed forms of such a message are not judged under HEGEL_NO_KNOWN=1.
+		octetBackslash := Known.octetPrintUnescaped && pyLosesBackslash(m)
+		var back dns.Msg
+		if err := back.Unpack(wire); err != nil {
+			ht.Fatalf("Unpack of Pack: %v\nwire %s\n%s", err, hex.EncodeToString(wire), m.String())
+		}
+		if got, err := summarize(&back); !octetBackslash && (err != nil || !reflect.DeepEqual(got, want)) {
+			ht.Fatalf("Unpack(Pack) differs (%v) (original / unpacked)\n%s\nwire %s\n%s", err, diffSummary(want, got), hex.EncodeToString(wire), m.String())
+		}
+		back.Compress = m.Compress
+		wire2, err := back.Pack()
+		if err != nil {
+			ht.Fatalf("Pack of the unpacked message: %v\n%s", err, m.String())
+		}
+		if !octetBackslash && !bytes.Equal(wire, wire2) {
+			ht.Fatalf("Pack(Unpack(Pack)) differs (compress %v)\n first  %s\n second %s\n%s", m.Compress, hex.EncodeToString(wire), hex.EncodeToString(wire2), m.String())
+		}
+		// the other compression setting gives the same message
+		other := m.Copy()
+		other.Compress = !m.Compress
+		wire3, err := other.Pack()
+		if err != nil {
+			ht.Fatalf("Pack (compress %v): %v\n%s", other.Compress, err, m.String())
+		}
+		var back3 dns.Msg
+		if err := back3.Unpack(wire3); err != nil {
+			ht.Fatalf("Unpack (compress %v): %v\nwire %s\n%s", other.Compress, err, hex.EncodeToString(wire3), m.String())
+		}
+		if got, err := summarize(&back3); !octetBackslash && (err != nil || !reflect.DeepEqual(got, want)) {
+			ht.Fatalf("Unpack(Pack) with compress %v differs (%v)\n%s\n%s", other.Compress, err, diffSummary(want, got), m.String())
+		}
+		if m.Compress && len(wire) > len(wire3) {
+			ht.Fatalf("compressed form (%d bytes) longer than uncompressed (%d)\n%s", len(wire), len(wire3), m.String())
+		}
+		if got, err := summarize(m.Copy()); err != nil || !reflect.DeepEqual(got, want) {
+			ht.Fatalf("Copy differs (%v)\n%s\n%s", err, diffSummary(want, got), m.String())
+		}
+		if strings.TrimSpace(m.String()) == "" {
+			ht.Fatalf("String() is empty")
+		}
+	})
+}
+
+// truncateCase: a message and the size it is truncated to: a size of note,
+// a size around the message's own length, or a small or a nearby size.
+type truncateCase struct {
+	spec msgSpec
+	size int
+}
+
+var truncateCases = hegel.FlatMap(msgSpecs, func(s msgSpec) hegel.Generator[truncateCase] {
+	full := s.msg().Len()
+	return hegel.Map(hegel.OneOf(
+		hegel.SampledFrom([]int{512, 1232, 4096, 65535}),
+		hegel.SampledFrom([]int{full, full - 1, full + 1}),
+		hegel.Integers(0, 600),
+		hegel.Integers(12, full+50),
+	), func(size int) truncateCase { return truncateCase{s, size} })
+})
+
+// GoString is what the draw report prints (it uses %#v).
+func (c truncateCase) GoString() string {
+	m := c.spec.msg()
+	return fmt.Sprintf("size %d full %d compress %v\n%s", c.size, m.Len(), m.Compress, m.String())
+}
+
+// TestHegelTruncateFits: Truncate(size) leaves a message whose Len is at most
+// the size (or 512), keeps the question and the OPT, drops records only from
+// the end of the sections, sets TC exactly when it dropped something, and
+// changes nothing when the message already fits.
+func TestHegelTruncateFits(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		tcase := hegel.Draw(ht, truncateCases)
+		m, size := tcase.spec.msg(), tcase.size
+		full := m.Len()
+		before, err := summarize(m)
+		if err != nil {
+			ht.Fatalf("summarising: %v", err)
+		}
+		c := m.Copy()
+		c.Truncate(size)
+		limit := size
+		if limit < dns.MinMsgSize {
+			limit = dns.MinMsgSize
+		}
+		after, err := summarize(c)
+		if err != nil {
+			ht.Fatalf("summarising the truncated message: %v", err)
+		}
+		if after.ID != before.ID || after.Rcode != before.Rcode || !reflect.DeepEqual(after.Question, before.Question) || !reflect.DeepEqual(after.Edns, before.Edns) {
+			ht.Fatalf("Truncate changed the header, question or OPT\n%s\nsize %d\n%s", diffSummary(before, after), size, m.String())
+		}
+		dropped := 0
+		for i, sec := range [][]dns.RR{m.Answer, m.Ns, withoutOPT(m.Extra)} {
+			csec := [][]dns.RR{c.Answer, c.Ns, withoutOPT(c.Extra)}[i]
+			if len(csec) > len(sec) {
+				ht.Fatalf("Truncate added records to section %d", i)
+			}
+			for j := range csec {
+				if csec[j].String() != sec[j].String() {
+					ht.Fatalf("Truncate changed record %d of section %d: %s -> %s\nsize %d\n%s", j, i, sec[j], csec[j], size, m.String())
+				}
+			}
+			dropped += len(sec) - len(csec)
+		}
+		if c.Truncated != (m.Truncated || dropped > 0) {
+			ht.Fatalf("TC %v after dropping %d records (TC before %v)\nsize %d\n%s", c.Truncated, dropped, m.Truncated, size, m.String())
+		}
+		wire, err := c.Pack()
+		if err != nil {
+			ht.Fatalf("Pack of the truncated message: %v\nsize %d\n%s", err, size, c.String())
+		}
+		if len(wire) > limit && dropped < len(m.Answer)+len(m.Ns)+len(m.Extra)-optCount(m) {
+			ht.Fatalf("truncated message is %d bytes for size %d (Len %d, compress %v) with %d records left to drop\n%s", len(wire), size, c.Len(), c.Compress, len(c.Answer)+len(c.Ns)+len(c.Extra)-optCount(c)-1, c.String())
+		}
+		if dropped > 0 && len(m.Extra) > optCount(m) && len(c.Extra) > optCount(c) && len(c.Answer) < len(m.Answer) {
+			// answers are dropped before the other sections are emptied
+			ht.Fatalf("Truncate dropped answers while keeping %d additional records\nsize %d\n%s", len(c.Extra)-optCount(c), size, m.String())
+		}
+		if full <= limit && (dropped > 0 || c.Truncated != m.Truncated) {
+			ht.Fatalf("Truncate dropped %d records from a message of %d bytes for size %d\n%s", dropped, full, size, m.String())
+		}
+	})
+}
+
+func withoutOPT(rrs []dns.RR) []dns.RR {
+	var out []dns.RR
+	for _, rr := range rrs {
+		if _, ok := rr.(*dns.OPT); !ok {
+			out = append(out, rr)
+		}
+	}
+	return out
+}
+
+func optCount(m *dns.Msg) int {
+	k := 0
+	for _, rr := range m.Extra {
+		if _, ok := rr.(*dns.OPT); ok {
+			k++
+		}
+	}
+	return k
+}
diff --git a/hegel_names_test.go b/hegel_names_test.go
new file mode 100644
index 0000000..29c56e6
--- /dev/null
+++ b/hegel_names_test.go
@@ -0,0 +1,239 @@
+package dns_test
+
+import (
+	"encoding/hex"
+	"fmt"
+	"net"
+	"strings"
+	"testing"
+
+	"github.com/miekg/dns"
+	"hegel.dev/go/hegel"
+)
+
+type pyName struct {
+	Wire      string `json:"wire"`
+	Text      string `json:"text"`
+	Canonical string `json:"canonical"`
+	Labels    int    `json:"labels"`
+	Relation  int    `json:"relation"`
+	Order     int    `json:"order"`
+	Common    int    `json:"common"`
+	Subdomain bool   `json:"subdomain"`
+}
+
+// packName packs a name without compression.
+func packName(name string) ([]byte, error) {
+	buf := make([]byte, 1024)
+	off, err := dns.PackDomainName(name, buf, 0, nil, false)
+	if err != nil {
+		return nil, err
+	}
+	return buf[:off], nil
+}
+
+// relatives: a name related to name: itself, a parent, a child, a case
+// variant (each letter flipped or not), or an unrelated name (two shares).
+func relatives(name string) hegel.Generator[string] {
+	parts := dns.SplitDomainName(name)
+	parent := hegel.Just(name)
+	if len(parts) > 0 {
+		parent = hegel.Map(hegel.Integers(1, len(parts)), func(k int) string {
+			if k == len(parts) {
+				return "."
+			}
+			return strings.Join(parts[k:], ".") + "."
+		})
+	}
+	child := hegel.Map(labels, func(l string) string {
+		if name == "." {
+			return l + "."
+		}
+		return l + "." + name
+	})
+	caseVariant := hegel.Map(fixed(hegel.Booleans(), len(name)), func(flip []bool) string {
+		b := []byte(name)
+		for i, c := range b {
+			switch {
+			case c >= 'a' && c <= 'z' && flip[i]:
+				b[i] = c - 'a' + 'A'
+			case c >= 'A' && c <= 'Z' && flip[i]:
+				b[i] = c - 'A' + 'a'
+			}
+		}
+		return string(b)
+	})
+	return hegel.OneOf(hegel.Just(name), parent, child, caseVariant, names, names)
+}
+
+// nameCase: a name and a relative of it.
+type nameCase struct {
+	name, other string
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c nameCase) GoString() string { return fmt.Sprintf("name %q other %q", c.name, c.other) }
+
+// nameCasesOf: a name of nameGen and a relative of it.
+func nameCasesOf(nameGen hegel.Generator[string]) hegel.Generator[nameCase] {
+	return hegel.FlatMap(nameGen, func(name string) hegel.Generator[nameCase] {
+		return hegel.Map(relatives(name), func(other string) nameCase { return nameCase{name, other} })
+	})
+}
+
+var nameCases = nameCasesOf(names)
+
+// TestHegelNamesAgreeWithDnspython: a name in presentation form packs to the
+// same wire form in this library and in dnspython; unpacking gives text that
+// packs back identically; canonical form, label count and split points,
+// common-suffix count and subdomain relation agree with dnspython (python's
+// dns.name treats names as label sequences, so it is the arbiter of what an
+// escaped name means).
+func TestHegelNamesAgreeWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		nameAgrees(ht, t, py, hegel.Draw(ht, nameCases))
+	})
+}
+
+// nameAgrees is the body of TestHegelNamesAgreeWithDnspython for one name
+// and a relative of it.
+func nameAgrees(ht *hegel.T, t *testing.T, py *python, tcase nameCase) {
+	name, other := tcase.name, tcase.other
+
+	var pn pyName
+	perr := py.call(t, map[string]any{"op": "name", "text": name, "other": other}, &pn)
+	labels, ok := dns.IsDomainName(name)
+	wire, gerr := packName(name)
+	if perr != nil {
+		if ok && gerr == nil {
+			ht.Fatalf("dnspython rejects a name the library packs (%s): %v\nname %q", hex.EncodeToString(wire), perr, name)
+		}
+		note(ht, "both reject %q: go %v/%v python %v", name, ok, gerr, perr)
+		return
+	}
+	if !ok || gerr != nil {
+		ht.Fatalf("the library rejects a name dnspython accepts (IsDomainName %v, pack %v)\nname %q", ok, gerr, name)
+	}
+	if hex.EncodeToString(wire) != pn.Wire {
+		ht.Fatalf("wire form differs\n go     %s\n python %s\nname %q", hex.EncodeToString(wire), pn.Wire, name)
+	}
+	// dnspython counts the root label; IsDomainName counts one label for the root name
+	if labels != pn.Labels-1 && name != "." {
+		ht.Fatalf("IsDomainName counts %d labels, dnspython %d\nname %q", labels, pn.Labels-1, name)
+	}
+	if name == "." {
+		labels = 0
+	}
+	if c := dns.CountLabel(name); c != labels {
+		ht.Fatalf("CountLabel %d but IsDomainName counted %d\nname %q", c, labels, name)
+	}
+	if sp := dns.Split(name); len(sp) != labels {
+		ht.Fatalf("Split gives %d offsets for %d labels: %v\nname %q", len(sp), labels, sp, name)
+	} else {
+		for i, off := range sp {
+			if off < 0 || off >= len(name) {
+				ht.Fatalf("Split offset %d out of range: %v\nname %q", off, sp, name)
+			}
+			if got, _ := dns.NextLabel(name, off); i+1 < len(sp) && got != sp[i+1] {
+				ht.Fatalf("NextLabel(%d) = %d, Split says %d\nname %q", off, got, sp[i+1], name)
+			}
+			if got, _ := dns.PrevLabel(name, len(sp)-i); got != off {
+				ht.Fatalf("PrevLabel(%d) = %d, Split says %d\nname %q", len(sp)-i, got, off, name)
+			}
+			suffix := name[off:]
+			sw, err := packName(suffix)
+			if err != nil {
+				ht.Fatalf("the suffix %q at Split offset %d does not pack: %v\nname %q", suffix, off, err, name)
+			}
+			// the suffix is the tail of the wire form
+			if !strings.HasSuffix(hex.EncodeToString(wire), hex.EncodeToString(sw)) {
+				ht.Fatalf("the suffix %q at Split offset %d is not a wire suffix\n name   %s\n suffix %s\nname %q", suffix, off, hex.EncodeToString(wire), hex.EncodeToString(sw), name)
+			}
+		}
+	}
+	if parts := dns.SplitDomainName(name); len(parts) != labels {
+		ht.Fatalf("SplitDomainName gives %d labels for %d: %q\nname %q", len(parts), labels, parts, name)
+	} else if labels > 0 {
+		joined := strings.Join(parts, ".") + "."
+		if jw, err := packName(joined); err != nil || hex.EncodeToString(jw) != pn.Wire {
+			ht.Fatalf("SplitDomainName labels joined back pack differently (%v)\n labels %q\n joined %s\n name   %s\nname %q", err, parts, hex.EncodeToString(jw), pn.Wire, name)
+		}
+	}
+	// unpack gives text that packs back to the same wire, and that dnspython reads alike
+	s, off, err := dns.UnpackDomainName(wire, 0)
+	if err != nil || off != len(wire) {
+		ht.Fatalf("UnpackDomainName: %v (off %d of %d)\nname %q", err, off, len(wire), name)
+	}
+	if w2, err := packName(s); err != nil || hex.EncodeToString(w2) != pn.Wire {
+		ht.Fatalf("unpacked text %q packs differently: %v %s\nname %q", s, err, hex.EncodeToString(w2), name)
+	}
+	var pn2 pyName
+	if err := py.call(t, map[string]any{"op": "name", "text": s}, &pn2); err != nil {
+		ht.Fatalf("dnspython rejects the unpacked text %q: %v\nname %q", s, err, name)
+	} else if pn2.Wire != pn.Wire {
+		ht.Fatalf("dnspython reads the unpacked text %q as %s, not %s\nname %q", s, pn2.Wire, pn.Wire, name)
+	}
+	// dnspython's own text reads back the same here
+	if w3, err := packName(pn.Text); err != nil || hex.EncodeToString(w3) != pn.Wire {
+		ht.Fatalf("dnspython's text %q packs differently: %v %s\nname %q", pn.Text, err, hex.EncodeToString(w3), name)
+	}
+	// canonical form (miekg-dns/8: a letter written as an escape keeps its
+	// case; names with escapes are not judged here under HEGEL_NO_KNOWN=1)
+	cw, err := packName(dns.CanonicalName(name))
+	if (err != nil || hex.EncodeToString(cw) != pn.Canonical) && !(Known.canonicalKeepsEscapedCase && strings.Contains(name, "\\")) {
+		ht.Fatalf("CanonicalName %q packs to %s, dnspython's canonical form is %s (%v)\nname %q", dns.CanonicalName(name), hex.EncodeToString(cw), pn.Canonical, err, name)
+	}
+	// relations with the other name (a relative of a name dnspython read is a name too)
+	_, otherOK := dns.IsDomainName(other)
+	ht.Assume(otherOK)
+	// (miekg-dns/3: the comparisons are textual, so escape variants of a
+	// label differ; names with escapes are not judged under HEGEL_NO_KNOWN=1)
+	if !(Known.textualDuplicates && (strings.Contains(name, "\\") || strings.Contains(other, "\\"))) {
+		if c := dns.CompareDomainName(name, other); c != pn.Common-1 {
+			ht.Fatalf("CompareDomainName(%q, %q) = %d, dnspython says %d labels in common", name, other, c, pn.Common-1)
+		}
+		if sub := dns.IsSubDomain(other, name); sub != pn.Subdomain {
+			ht.Fatalf("IsSubDomain(%q, %q) = %v, dnspython says %v", other, name, sub, pn.Subdomain)
+		}
+		// relation 3 = NAMEREL_EQUAL in dnspython
+		if eq := pn.Relation == 3; eq != (hex.EncodeToString(cw) == pn.Canonical && dns.CanonicalName(name) == dns.CanonicalName(other)) {
+			if eq != strings.EqualFold(dns.CanonicalName(name), dns.CanonicalName(other)) {
+				note(ht, "equal names in different escapes: %q %q", name, other)
+			}
+		}
+	}
+}
+
+// reverseIPs: an IPv4 or an IPv6 address.
+var reverseIPs = hegel.OneOf(ip4s, ip6s)
+
+// TestHegelReverseNamesAgreeWithDnspython: ReverseAddr matches dnspython's
+// reversename for random IPv4 and IPv6 addresses.
+func TestHegelReverseNamesAgreeWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		ip := hegel.Draw(ht, reverseIPs)
+		got, err := dns.ReverseAddr(ip)
+		var pr struct {
+			Text string `json:"text"`
+		}
+		perr := py.call(t, map[string]any{"op": "reverse", "ip": ip}, &pr)
+		if perr != nil || err != nil {
+			if (perr == nil) != (err == nil) {
+				ht.Fatalf("ReverseAddr(%q): go %v, python %v", ip, err, perr)
+			}
+			return
+		}
+		if !strings.EqualFold(got, pr.Text) {
+			ht.Fatalf("ReverseAddr(%q) = %q, dnspython %q", ip, got, pr.Text)
+		}
+		// and the name is fully qualified and parses
+		if !dns.IsFqdn(got) {
+			ht.Fatalf("ReverseAddr(%q) = %q is not fully qualified", ip, got)
+		}
+		if net.ParseIP(ip) == nil {
+			ht.Fatalf("generated address %q does not parse", ip)
+		}
+	})
+}
diff --git a/hegel_oracle_test.go b/hegel_oracle_test.go
new file mode 100644
index 0000000..d805a3f
--- /dev/null
+++ b/hegel_oracle_test.go
@@ -0,0 +1,225 @@
+package dns_test
+
+// The dnspython oracle: one python3 child per test binary, fed JSON requests
+// one per line and answering one JSON line each.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"sync"
+	"testing"
+)
+
+const pyScript = `
+import sys, json, base64, binascii
+import dns, dns.name, dns.rdata, dns.rdataclass, dns.rdatatype, dns.message, dns.rrset, dns.edns, dns.dnssec, dns.tsig, dns.zone, dns.reversename, dns.flags, dns.opcode, dns.rcode, dns.rdtypes.ANY.DNSKEY, dns.exception
+
+ROOT = dns.name.root
+
+def rr_out(name, rd, ttl):
+    try:
+        text = rd.to_text()
+    except Exception as e:  # HIP servers are printed through IDNA decoding, which may fail
+        text = None
+    return {"name": name.to_wire().hex(), "type": rd.rdtype, "class": rd.rdclass, "ttl": ttl, "rdata": rd.to_wire(origin=None).hex(), "text": text}
+
+def sections(m):
+    out = []
+    for sec in (m.answer, m.authority, m.additional):
+        rrs = []
+        for rrset in sec:
+            for rd in rrset:
+                rrs.append(rr_out(rrset.name, rd, rrset.ttl))
+        out.append(rrs)
+    return out
+
+def message_out(m):
+    res = {"id": m.id, "flags": m.flags, "opcode": dns.opcode.from_flags(m.flags), "rcode": m.rcode(),
+           "question": [{"name": q.name.to_wire().hex(), "type": q.rdtype, "class": q.rdclass} for q in m.question],
+           "sections": sections(m), "rewire": m.to_wire().hex()}
+    if m.opt is not None:
+        res["edns"] = {"version": m.edns, "payload": m.payload, "ednsflags": m.ednsflags,
+                       "options": [{"otype": o.otype, "data": o.to_wire().hex(), "text": o.to_text()} for o in m.options]}
+    return res
+
+def handle(req):
+    op = req["op"]
+    if op == "version":
+        return {"version": dns.version.version}
+    if op == "rdata":
+        rd = dns.rdata.from_text(req["class"], req["type"], req["text"], origin=ROOT, relativize=False)
+        w = rd.to_wire(origin=None)
+        rd2 = dns.rdata.from_wire(rd.rdclass, rd.rdtype, w, 0, len(w))
+        return {"wire": w.hex(), "text": rd.to_text(), "rewire": rd2.to_wire(origin=None).hex(), "retext": rd2.to_text()}
+    if op == "rdata_wire":
+        w = bytes.fromhex(req["wire"])
+        rd = dns.rdata.from_wire(req["class"], req["type"], w, 0, len(w))
+        try:
+            rd2 = dns.rdata.from_text(rd.rdclass, rd.rdtype, rd.to_text(), origin=ROOT, relativize=False)
+            textwire = rd2.to_wire(origin=None).hex()
+        except Exception as e:  # dnspython's own text round trip is not under test
+            textwire = None
+        return {"text": rd.to_text(), "rewire": rd.to_wire(origin=None).hex(), "textwire": textwire}
+    if op == "name":
+        n = dns.name.from_text(req["text"], origin=ROOT)
+        res = {"wire": n.to_wire().hex(), "text": n.to_text(), "canonical": n.canonicalize().to_wire().hex(), "labels": len(n.labels)}
+        if "other" in req:
+            o = dns.name.from_text(req["other"], origin=ROOT)
+            rel, order, nlabels = n.fullcompare(o)
+            res["relation"] = int(rel)
+            res["order"] = order
+            res["common"] = nlabels
+            res["subdomain"] = n.is_subdomain(o)
+        return res
+    if op == "name_wire":
+        n, used = dns.name.from_wire(bytes.fromhex(req["wire"]), 0)
+        return {"text": n.to_text(), "used": used}
+    if op == "reverse":
+        return {"text": dns.reversename.from_address(req["ip"]).to_text()}
+    if op == "message":
+        m = dns.message.from_wire(bytes.fromhex(req["wire"]), one_rr_per_rrset=True, ignore_trailing=False)
+        return message_out(m)
+    if op == "nsec3":
+        return {"hash": dns.dnssec.nsec3_hash(req["name"], req["salt"], req["iter"], req["alg"])}
+    if op == "keytag":
+        rd = dns.rdata.from_wire("IN", "DNSKEY", bytes.fromhex(req["wire"]), 0, len(bytes.fromhex(req["wire"])))
+        return {"tag": dns.dnssec.key_id(rd)}
+    if op == "ds":
+        w = bytes.fromhex(req["wire"])
+        rd = dns.rdata.from_wire("IN", "DNSKEY", w, 0, len(w))
+        ds = dns.dnssec.make_ds(dns.name.from_text(req["name"]), rd, req["alg"], policy=dns.dnssec.allow_all_policy)
+        return {"text": ds.to_text(), "wire": ds.to_wire(origin=None).hex()}
+    if op == "tsig_verify":
+        keyring = {dns.name.from_text(req["keyname"]): dns.tsig.Key(req["keyname"], req["secret"], req["alg"])}
+        try:
+            m = dns.message.from_wire(bytes.fromhex(req["wire"]), keyring=keyring, request_mac=bytes.fromhex(req.get("requestMac", "")))
+            return {"ok": True, "mac": m.mac.hex()}
+        except dns.exception.DNSException as e:
+            return {"ok": False, "err": type(e).__name__ + ": " + str(e)[:200]}
+    if op == "tsig_sign":
+        m = dns.message.from_wire(bytes.fromhex(req["wire"]), one_rr_per_rrset=True)  # keep duplicate records
+        key = dns.tsig.Key(req["keyname"], req["secret"], req["alg"])
+        m.use_tsig(key, fudge=req.get("fudge", 300))
+        return {"wire": m.to_wire().hex()}
+    if op == "zone":
+        z = dns.zone.from_text(req["text"], origin=req["origin"], relativize=False, check_origin=False, allow_include=False)
+        rrs = []
+        for name, node in z.nodes.items():
+            for rdataset in node.rdatasets:
+                for rd in rdataset:
+                    rrs.append(rr_out(name, rd, rdataset.ttl))
+        return {"rrs": rrs}
+    return {"error": "unknown op " + op}
+
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        res = handle(req)
+    except Exception as e:
+        res = {"error": type(e).__name__ + ": " + str(e)[:300]}
+    sys.stdout.write(json.dumps(res) + "\n")
+    sys.stdout.flush()
+`
+
+type python struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  *bufio.Writer
+	out *bufio.Scanner
+}
+
+var (
+	pyOnce sync.Once
+	pyInst *python
+	pyErr  error
+)
+
+// oracle starts (once) the dnspython child and returns it.
+func oracle(t *testing.T) *python {
+	t.Helper()
+	pyOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pyScript)
+		cmd.Stderr = os.Stderr
+		stdin, err := cmd.StdinPipe()
+		if err != nil {
+			pyErr = err
+			return
+		}
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			pyErr = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			pyErr = fmt.Errorf("starting python3: %v", err)
+			return
+		}
+		sc := bufio.NewScanner(stdout)
+		sc.Buffer(make([]byte, 1<<20), 64<<20)
+		pyInst = &python{cmd: cmd, in: bufio.NewWriter(stdin), out: sc}
+		var v struct {
+			Version string `json:"version"`
+			Error   string `json:"error"`
+		}
+		if err := pyInst.rawCall(map[string]any{"op": "version"}, &v); err != nil || v.Version == "" {
+			pyErr = fmt.Errorf("python3 with the dnspython package is needed as the oracle (%v %s)", err, v.Error)
+			return
+		}
+		fmt.Printf("oracle: dnspython %s\n", v.Version)
+	})
+	if pyErr != nil {
+		t.Fatalf("%v", pyErr)
+	}
+	return pyInst
+}
+
+type oracleError struct{ msg string }
+
+func (e *oracleError) Error() string { return e.msg }
+
+func (g *python) rawCall(req map[string]any, res any) error {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		return err
+	}
+	if _, err := g.in.Write(append(b, '\n')); err != nil {
+		return err
+	}
+	if err := g.in.Flush(); err != nil {
+		return err
+	}
+	if !g.out.Scan() {
+		return fmt.Errorf("the python oracle exited: %v", g.out.Err())
+	}
+	var probe struct {
+		Error string `json:"error"`
+	}
+	line := g.out.Bytes()
+	if err := json.Unmarshal(line, &probe); err != nil {
+		return fmt.Errorf("bad oracle reply %q: %v", line, err)
+	}
+	if probe.Error != "" {
+		return &oracleError{probe.Error}
+	}
+	return json.Unmarshal(line, res)
+}
+
+// call asks the oracle; a python-side exception is returned as *oracleError
+// (the caller decides whether that is a legitimate rejection), any other
+// failure is fatal.
+func (g *python) call(t *testing.T, req map[string]any, res any) error {
+	t.Helper()
+	err := g.rawCall(req, res)
+	if err != nil {
+		if _, ok := err.(*oracleError); ok {
+			return err
+		}
+		t.Fatalf("oracle: %v", err)
+	}
+	return nil
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..e5f5c12
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,304 @@
+package dns_test
+
+// One plain test per bug in bugs.toml. Each fails while the bug is open and
+// is listed under [expected_failures] in target.toml.
+
+import (
+	"bytes"
+	"encoding/hex"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/miekg/dns"
+)
+
+func mustRR(t *testing.T, text string) dns.RR {
+	t.Helper()
+	rr, err := dns.NewRR(text)
+	if err != nil {
+		t.Fatalf("NewRR(%q): %v", text, err)
+	}
+	return rr
+}
+
+func mustPack(t *testing.T, rr dns.RR) []byte {
+	t.Helper()
+	wire, _, err := packRR(rr)
+	if err != nil {
+		t.Fatalf("PackRR(%s): %v", rr, err)
+	}
+	return wire
+}
+
+func zoneRecords(t *testing.T, zone, origin string) ([]dns.RR, error) {
+	t.Helper()
+	var out []dns.RR
+	zp := dns.NewZoneParser(strings.NewReader(zone), origin, "")
+	for rr, ok := zp.Next(); ok; rr, ok = zp.Next() {
+		out = append(out, rr)
+	}
+	return out, zp.Err()
+}
+
+// 1: Len returns the length of the uncompressed wire form.
+func TestHegelPinLenIsTheWireLength(t *testing.T) {
+	for _, text := range []string{
+		`a. 1 IN TXT "\\"`,
+		`a. 1 IN TXT "\065"`,
+		`a. 1 IN DNSKEY 256 3 8 ZAKoSg==`,
+		`a. 1 IN CERT PGP 1 1 SwA=`,
+		`a. 1 IN NSEC b.`,
+		`a. 1 IN CSYNC 1 3`,
+		`a. 1 IN HIP 8 0657 pUo= .`,
+		`a. 1 IN AMTRELAY 1 0 3 a\064.`,
+		`a. 1 IN APL 2:::/3`,
+		`a\032. 1 IN A 1.2.3.4`,
+	} {
+		rr := mustRR(t, text)
+		if got, want := dns.Len(rr), len(mustPack(t, rr)); got != want {
+			t.Errorf("Len(%s) = %d, PackRR writes %d bytes", text, got, want)
+		}
+	}
+}
+
+// 2: type bitmaps written in any order pack.
+func TestHegelPinTypeBitmapOrderIsFree(t *testing.T) {
+	for _, text := range []string{
+		"a. 1 IN NSEC b. MX A",
+		"a. 1 IN NSEC3 1 0 0 - AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA MX A",
+		"a. 1 IN CSYNC 1 3 MX A",
+	} {
+		rr := mustRR(t, text)
+		buf := make([]byte, 512)
+		if _, err := dns.PackRR(rr, buf, 0, nil, false); err != nil {
+			t.Errorf("PackRR(%s): %v", text, err)
+		}
+	}
+}
+
+// 3: names and records equal on the wire are duplicates and compare equal.
+func TestHegelPinDuplicatesAreJudgedOnTheWire(t *testing.T) {
+	a := mustRR(t, `a\032. 1 IN A 1.2.3.4`)
+	b := mustRR(t, `a\ . 1 IN A 1.2.3.4`)
+	if !dns.IsDuplicate(a, b) {
+		t.Errorf("IsDuplicate(%s, %s) = false", a, b)
+	}
+	if !dns.IsDuplicate(mustRR(t, `a. 1 IN TXT "\065"`), mustRR(t, `a. 1 IN TXT "A"`)) {
+		t.Errorf(`IsDuplicate of TXT "\065" and "A" = false`)
+	}
+	if !dns.IsDuplicate(mustRR(t, `a. 1 IN SSHFP 1 1 abcd`), mustRR(t, `a. 1 IN SSHFP 1 1 ABCD`)) {
+		t.Errorf("IsDuplicate of SSHFP abcd and ABCD = false")
+	}
+	if n := dns.CompareDomainName(`a\032.`, `a\ .`); n != 1 {
+		t.Errorf(`CompareDomainName("a\032.", "a\ .") = %d, want 1`, n)
+	}
+	if !dns.IsSubDomain(`a\032.`, `b.a\ .`) {
+		t.Errorf(`IsSubDomain("a\032.", "b.a\ .") = false`)
+	}
+}
+
+// 4: LOC minutes may be given without seconds (RFC 1876 section 3).
+func TestHegelPinLOCMinutesWithoutSeconds(t *testing.T) {
+	for _, text := range []string{
+		"a. 1 IN LOC 42 30 N 56 40 W 10m",
+		"a. 1 IN LOC 42 30 N 56 W 10m",
+		"a. 1 IN LOC 42 N 56 40 W 10m",
+	} {
+		if _, err := dns.NewRR(text); err != nil {
+			t.Errorf("NewRR(%q): %v", text, err)
+		}
+	}
+}
+
+// 5: the X25 address is a <character-string> and may be quoted (RFC 1183 3.1).
+func TestHegelPinX25AcceptsQuotedAddress(t *testing.T) {
+	rr, err := dns.NewRR(`a. 1 IN X25 "311061700956"`)
+	if err != nil {
+		t.Fatalf("NewRR: %v", err)
+	}
+	if got := rr.(*dns.X25).PSDNAddress; got != "311061700956" {
+		t.Errorf("PSDNAddress = %q", got)
+	}
+}
+
+// 6: an unpacked CAA or URI prints so that it reads back to the same data.
+func TestHegelPinUnpackedOctetStringsPrintEscaped(t *testing.T) {
+	for _, text := range []string{`a. 1 IN CAA 0 issue "a\\b"`, `a. 1 IN URI 1 1 "a\\b"`} {
+		rr := mustRR(t, text)
+		wire := mustPack(t, rr)
+		back, _, err := dns.UnpackRR(wire, 0)
+		if err != nil {
+			t.Fatalf("UnpackRR: %v", err)
+		}
+		again, err := dns.NewRR(back.String())
+		if err != nil {
+			t.Fatalf("NewRR(%q): %v", back.String(), err)
+		}
+		if got := mustPack(t, again); !bytes.Equal(got, wire) {
+			t.Errorf("%s unpacked prints %q, which packs to %s, not %s", text, back.String(), hex.EncodeToString(got), hex.EncodeToString(wire))
+		}
+	}
+}
+
+// 7: an IPv4-mapped IPv6 address is an IPv6 gateway (AAAA accepts it).
+func TestHegelPinMappedIPv6Gateways(t *testing.T) {
+	for _, text := range []string{
+		"a. 1 IN IPSECKEY 1 2 1 ::ffff:1.2.3.4 pUo=",
+		"a. 1 IN AMTRELAY 1 0 2 ::ffff:1.2.3.4",
+		"a. 1 IN SVCB 1 . ipv6hint=::ffff:1.2.3.4",
+	} {
+		if _, err := dns.NewRR(text); err != nil {
+			t.Errorf("NewRR(%q): %v", text, err)
+		}
+	}
+	// and the wire form's String() reads back
+	wire, _ := hex.DecodeString("016100002d000100000001001501020100000000000000000000ffff01020304a54a")
+	rr, _, err := dns.UnpackRR(wire, 0)
+	if err != nil {
+		t.Fatalf("UnpackRR: %v", err)
+	}
+	if _, err := dns.NewRR(rr.String()); err != nil {
+		t.Errorf("NewRR(%q) of an unpacked IPSECKEY: %v", rr.String(), err)
+	}
+}
+
+// 8: the canonical form lowercases letters written as escapes (RFC 4034 6.2).
+func TestHegelPinCanonicalNameLowercasesEscapes(t *testing.T) {
+	c := dns.CanonicalName(`x\070.`)
+	w, err := packName(c)
+	if err != nil || hex.EncodeToString(w) != "02786600" {
+		t.Errorf(`CanonicalName("x\070.") = %q packs to %s (%v), want 02786600 ("xf.")`, c, hex.EncodeToString(w), err)
+	}
+}
+
+// 9: LOC seconds keep their milliseconds.
+func TestHegelPinLOCSecondsAreExact(t *testing.T) {
+	rr := mustRR(t, "a. 1 IN LOC 0 0 4.031 N 0 E 0m")
+	if got := rr.(*dns.LOC).Latitude; got != 1<<31+4031 {
+		t.Errorf("Latitude = %d (%d ms), want %d", got, int64(got)-1<<31, 1<<31+4031)
+	}
+}
+
+// 10: an altitude outside RFC 1876's range is rejected, not wrapped.
+func TestHegelPinLOCAltitudeRange(t *testing.T) {
+	for _, text := range []string{"a. 1 IN LOC 0 N 0 E -100001m", "a. 1 IN LOC 0 N 0 E 42849673m"} {
+		rr, err := dns.NewRR(text)
+		if err == nil {
+			t.Errorf("NewRR(%q) accepted, altitude field %d (%s)", text, rr.(*dns.LOC).Altitude, rr)
+		}
+	}
+}
+
+// 11: the NSEC3 hash length is the length of the hash.
+func TestHegelPinNSEC3HashLength(t *testing.T) {
+	rr := mustRR(t, "a. 1 IN NSEC3 1 0 0 - VE08UH3B")
+	wire := mustPack(t, rr)
+	back, off, err := dns.UnpackRR(wire, 0)
+	if err != nil || off != len(wire) {
+		t.Fatalf("UnpackRR(PackRR) of a 5-byte hash: %v (wire %s)", err, hex.EncodeToString(wire))
+	}
+	if back.(*dns.NSEC3).HashLength != 5 {
+		t.Errorf("hash length %d, want 5", back.(*dns.NSEC3).HashLength)
+	}
+}
+
+// 12: the AMTRELAY gateway is packed whatever the D bit.
+func TestHegelPinAMTRELAYKeepsGatewayWithDBit(t *testing.T) {
+	rr := mustRR(t, "a. 1 IN AMTRELAY 1 1 1 1.2.3.4")
+	_, rdata, err := packRR(rr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := hex.EncodeToString(rdata); got != "018101020304" {
+		t.Errorf("rdata %s, want 018101020304", got)
+	}
+}
+
+// 13: a comment inside parentheses is allowed in every record.
+func TestHegelPinCommentsInsideParentheses(t *testing.T) {
+	for _, zone := range []string{
+		"$TTL 1\n@ NSEC ( a. ; c\n SRV APL )\n",
+		"$TTL 1\n@ NSEC3 ( 1 0 0 - AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA ; c\n SRV APL )\n",
+		"$TTL 1\n@ CSYNC ( 1 3 ; c\n SRV APL )\n",
+		"$TTL 1\n@ RRSIG ( A 8 2 3600 20260101000000 ; c\n 20250101000000 1 a. AAAA )\n",
+	} {
+		if rrs, err := zoneRecords(t, zone, "example.com."); err != nil || len(rrs) != 1 {
+			t.Errorf("%q: %d records, %v", zone, len(rrs), err)
+		}
+	}
+}
+
+// 14: a blank owner before any record is not an empty name.
+func TestHegelPinBlankFirstOwner(t *testing.T) {
+	rrs, err := zoneRecords(t, "$TTL 1\n  A 1.2.3.4\n", "example.com.")
+	if err != nil {
+		return // rejecting the zone is fine
+	}
+	for _, rr := range rrs {
+		if rr.Header().Name == "" {
+			t.Errorf("record with an empty owner name: %q", rr.String())
+		}
+	}
+}
+
+// 15: TsigVerify leaves the message buffer as it was.
+func TestHegelPinTsigVerifyKeepsTheBuffer(t *testing.T) {
+	m := new(dns.Msg)
+	m.SetQuestion("example.com.", dns.TypeA)
+	m.SetTsig("key.", dns.HmacSHA256, 300, time.Now().Unix())
+	signed, _, err := dns.TsigGenerate(m, "c2VjcmV0", "", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := append([]byte(nil), signed...)
+	if err := dns.TsigVerify(signed, "c2VjcmV0", "", false); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(before, signed) {
+		t.Errorf("TsigVerify changed the buffer: arcount %v -> %v", before[10:12], signed[10:12])
+	}
+}
+
+// 16: the key tag of an RSA/MD5 key follows RFC 4034 appendix B.1.
+func TestHegelPinKeyTagRSAMD5(t *testing.T) {
+	rr := mustRR(t, "a. 1 IN DNSKEY 257 3 1 MWwoyw8q95pCE4xPuwfJBoYj7lnjNMY8XDIilQ==")
+	if got := rr.(*dns.DNSKEY).KeyTag(); got != 12834 {
+		t.Errorf("KeyTag = %d, want 12834 (0x3222, the 3rd and 2nd to last octets of the key)", got)
+	}
+}
+
+// 17: an IPSECKEY record may be followed by another record.
+func TestHegelPinIPSECKEYThenAnotherRecord(t *testing.T) {
+	rrs, err := zoneRecords(t, "$TTL 1\n@ IPSECKEY 1 1 1 1.2.3.4 pUo=\n@ A 1.2.3.4\n", "example.com.")
+	if err != nil || len(rrs) != 2 {
+		t.Errorf("%d records, %v", len(rrs), err)
+	}
+}
+
+// 18: a signed NOTAUTH message (RFC 2136 responses, RFC 8945 BADTIME answers)
+// verifies like any other.
+func TestHegelPinTsigVerifiesNotAuthMessages(t *testing.T) {
+	m := new(dns.Msg)
+	m.SetQuestion("example.com.", dns.TypeSOA)
+	m.Response = true
+	m.Rcode = dns.RcodeNotAuth
+	m.SetTsig("key.", dns.HmacSHA256, 300, time.Now().Unix())
+	signed, _, err := dns.TsigGenerate(m, "c2VjcmV0", "", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := dns.TsigVerify(signed, "c2VjcmV0", "", false); err != nil {
+		t.Errorf("TsigVerify of a correctly signed NOTAUTH response: %v", err)
+	}
+}
+
+// 19: CERT type 4 is IPKIX (RFC 4398 section 2.1).
+func TestHegelPinCERTTypeIPKIX(t *testing.T) {
+	if got := dns.CertTypeToString[4]; got != "IPKIX" {
+		t.Errorf("CertTypeToString[4] = %q, want IPKIX", got)
+	}
+	if _, err := dns.NewRR("a. 1 IN CERT IPKIX 1 8 ElQ="); err != nil {
+		t.Errorf("NewRR of a CERT IPKIX: %v", err)
+	}
+}
diff --git a/hegel_records_test.go b/hegel_records_test.go
new file mode 100644
index 0000000..80933ef
--- /dev/null
+++ b/hegel_records_test.go
@@ -0,0 +1,262 @@
+package dns_test
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"net"
+	"strings"
+	"testing"
+
+	"github.com/miekg/dns"
+	"hegel.dev/go/hegel"
+)
+
+// packRR packs a record without compression and returns the whole wire form
+// and the rdata part.
+func packRR(rr dns.RR) (wire, rdata []byte, err error) {
+	buf := make([]byte, 65535)
+	off, err := dns.PackRR(rr, buf, 0, nil, false)
+	if err != nil {
+		return nil, nil, err
+	}
+	wire = buf[:off]
+	nameLen, err := dns.PackDomainName(rr.Header().Name, buf[off:], 0, nil, false)
+	if err != nil {
+		return nil, nil, err
+	}
+	return wire, wire[nameLen+10:], nil
+}
+
+// lenIsApproximate reports the shapes for which Len is known to overestimate:
+// escaped names and strings, base64 fields (their padding), empty type bitmaps.
+func lenIsApproximate(text, typ string) bool {
+	if strings.Contains(text, "\\") {
+		return true
+	}
+	switch typ {
+	case "CERT", "DNSKEY", "CDNSKEY", "RRSIG", "HIP", "IPSECKEY", "OPENPGPKEY", "DHCID", "AMTRELAY":
+		return true
+	case "NSEC", "NSEC3", "CSYNC", "APL":
+		return true
+	}
+	return false
+}
+
+// hasHexField reports the types with a hex string field, which the library
+// compares case-sensitively (unpacking gives lower case, String() upper case).
+func hasHexField(typ string) bool {
+	switch typ {
+	case "SSHFP", "NSEC3PARAM", "NSEC3", "DS", "CDS", "DLV", "TLSA", "SMIMEA", "HIP", "ZONEMD", "TYPE65280", "TYPE1234":
+		return true
+	}
+	return false
+}
+
+func isASCII(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] >= 128 {
+			return false
+		}
+	}
+	return true
+}
+
+type pyRdata struct {
+	Wire   string `json:"wire"`
+	Text   string `json:"text"`
+	Rewire string `json:"rewire"`
+	Retext string `json:"retext"`
+}
+
+type pyRdataWire struct {
+	Text     string `json:"text"`
+	Rewire   string `json:"rewire"`
+	TextWire string `json:"textwire"`
+}
+
+// recordCase: a record in presentation form, "owner TTL class TYPE rdata".
+type recordCase struct {
+	owner string
+	ttl   ttl
+	class string
+	typ   string
+	rdata string
+}
+
+func (c recordCase) text() string {
+	return fmt.Sprintf("%s %s %s %s %s", c.owner, c.ttl.text, c.class, c.typ, c.rdata)
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c recordCase) GoString() string { return c.text() }
+
+var (
+	classes = hegel.SampledFrom([]string{"IN", "IN", "IN", "CH", "HS", "CLASS250"})
+	// recordCases: a type with its rdata, an escaped owner, a TTL with or without units, a class
+	recordCases = hegel.FlatMap(hegel.SampledFrom(rrTypes), func(typ string) hegel.Generator[recordCase] {
+		return hegel.Composite(func(tc hegel.TestCase) recordCase {
+			return recordCase{
+				typ:   typ,
+				rdata: hegel.Draw(tc, rdataGens[typ]),
+				owner: hegel.Draw(tc, names),
+				ttl:   hegel.Draw(tc, ttls),
+				class: hegel.Draw(tc, classes),
+			}
+		})
+	})
+)
+
+// TestHegelRecordsAgreeWithDnspython: a record written in presentation form
+// packs to the same rdata in this library and in dnspython; the wire form
+// read back by either library prints and re-packs stably; Len matches the
+// packed size and the text round trip is exact.
+func TestHegelRecordsAgreeWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		recordAgrees(ht, t, py, hegel.Draw(ht, recordCases))
+	})
+}
+
+// zeroAnglesNorthEast is dnspython's LOC text with a zero latitude or
+// longitude in the northern or eastern hemisphere: read from text, dnspython
+// keeps the S or W the text gave a zero angle, read from the wire form (where
+// zero has no sign) it prints N or E (a difference in dnspython's printing,
+// not judged).
+func zeroAnglesNorthEast(typ, text string) string {
+	if typ != "LOC" {
+		return text
+	}
+	if rest, zeroSouth := strings.CutPrefix(text, "0 0 0.000 S "); zeroSouth {
+		text = "0 0 0.000 N " + rest
+	}
+	return strings.Replace(text, " 0 0 0.000 W ", " 0 0 0.000 E ", 1)
+}
+
+// sameAddressesSpeltDifferently reports two rdata texts that differ only in
+// fields that are the same IP address written differently: dnspython echoes
+// the gateway of an IPSECKEY or AMTRELAY as the text gave it (0::1:0) and
+// prints it from the wire form in its own spelling (::0.1.0.0, the
+// IPv4-compatible form for ::/96); a difference in dnspython's printing, not
+// judged.
+func sameAddressesSpeltDifferently(a, b string) bool {
+	fa, fb := strings.Fields(a), strings.Fields(b)
+	if len(fa) != len(fb) {
+		return false
+	}
+	for i := range fa {
+		if fa[i] == fb[i] {
+			continue
+		}
+		ipa, ipb := net.ParseIP(fa[i]), net.ParseIP(fb[i])
+		if ipa == nil || !ipa.Equal(ipb) {
+			return false
+		}
+	}
+	return true
+}
+
+// recordAgrees is the body of TestHegelRecordsAgreeWithDnspython for one
+// record; the properties over the shape regions of the recorded bugs
+// (hegel_shapes_test.go) judge their records with it too.
+func recordAgrees(ht *hegel.T, t *testing.T, py *python, tcase recordCase) {
+	typ, rdata, owner, ttl, class := tcase.typ, tcase.rdata, tcase.owner, tcase.ttl.value, tcase.class
+	text := tcase.text()
+
+	rr, gerr := dns.NewRR(text)
+	var pr pyRdata
+	// dnspython's class-specific types live under IN only (CH A is Chaosnet's A); the
+	// library reads every class alike, so the oracle always parses in class IN
+	perr := py.call(t, map[string]any{"op": "rdata", "type": typ, "class": "IN", "text": rdata}, &pr)
+	if perr != nil && gerr != nil {
+		note(ht, "both reject: go %v; python %v", gerr, perr)
+		return
+	}
+	if gerr != nil {
+		ht.Fatalf("NewRR rejects text dnspython accepts (wire %s): %v\nrecord %s", pr.Wire, gerr, text)
+	}
+	if perr != nil {
+		ht.Fatalf("dnspython rejects text NewRR accepts (%s): %v\nrecord %s", rr.String(), perr, text)
+	}
+	wire, got, err := packRR(rr)
+	if err != nil {
+		ht.Fatalf("PackRR failed: %v\nrecord %s", err, text)
+	}
+	if hex.EncodeToString(got) != pr.Wire {
+		ht.Fatalf("rdata wire differs\n go     %s\n python %s\nrecord %s\ngo text %s\npython text %s", hex.EncodeToString(got), pr.Wire, text, rr.String(), pr.Text)
+	}
+	// header
+	h := rr.Header()
+	if h.Ttl != ttl {
+		ht.Fatalf("TTL %d parsed as %d\nrecord %s", ttl, h.Ttl, text)
+	}
+	if dns.Len(rr) < len(wire) {
+		ht.Fatalf("Len %d but PackRR wrote %d bytes\nrecord %s", dns.Len(rr), len(wire), text)
+	}
+	// (miekg-dns/1: Len overestimates escapes, base64 padding, empty bitmaps
+	// and APL prefixes; those shapes are not judged under HEGEL_NO_KNOWN=1)
+	if dns.Len(rr) != len(wire) && !(Known.lenOverestimates && lenIsApproximate(text, typ)) {
+		ht.Fatalf("Len %d but PackRR wrote %d bytes\nrecord %s", dns.Len(rr), len(wire), text)
+	}
+	// the library reads its own wire form back to the same record
+	back, off, err := dns.UnpackRR(wire, 0)
+	if err != nil || off != len(wire) {
+		ht.Fatalf("UnpackRR of PackRR: %v (off %d of %d)\nrecord %s", err, off, len(wire), text)
+	}
+	// the unpacked record prints to text that reads back to the same wire form
+	reback, err := dns.NewRR(back.String())
+	if err != nil {
+		ht.Fatalf("NewRR rejects the String() of an unpacked record: %v\n%s\nrecord %s", err, back.String(), text)
+	}
+	// (miekg-dns/6: an unpacked CAA/URI value with a backslash prints
+	// re-interpreted; miekg-dns/3: duplicates are judged on the text, so a
+	// record with an escape, a hex field or an octet field differs from
+	// its wire copy; neither shape is judged under HEGEL_NO_KNOWN=1)
+	octetBackslash := Known.octetPrintUnescaped && (typ == "CAA" || typ == "URI") && bytes.Contains(got, []byte{'\\'})
+	if w2, _, err := packRR(reback); (err != nil || !bytes.Equal(w2, wire)) && !octetBackslash {
+		ht.Fatalf("String() of an unpacked record reads back differently (%v)\n parsed   %s\n unpacked %s\nrecord %s", err, rr.String(), back.String(), text)
+	}
+	if !dns.IsDuplicate(rr, back) && !(Known.textualDuplicates && strings.Contains(text, "\\")) {
+		ht.Fatalf("IsDuplicate false for a record and its wire copy\nrecord %s", text)
+	}
+	octetField := typ == "CAA" || typ == "URI" // stored raw after unpacking, escaped after parsing
+	if !dns.IsDuplicate(back, reback) && !(Known.textualDuplicates && (hasHexField(typ) || octetField)) && !octetBackslash {
+		ht.Fatalf("IsDuplicate false for an unpacked record and its reparsed String()\nrecord %s", text)
+	}
+	// the library's text round trip
+	again, err := dns.NewRR(rr.String())
+	if err != nil {
+		ht.Fatalf("NewRR rejects the library's own String(): %v\n%s\nrecord %s", err, rr.String(), text)
+	}
+	wire2, got2, err := packRR(again)
+	if err != nil {
+		ht.Fatalf("PackRR of the reparsed record: %v\nrecord %s", err, text)
+	}
+	if !bytes.Equal(got, got2) {
+		ht.Fatalf("text round trip changes the rdata\n first  %s\n second %s\nString() %s\nrecord %s", hex.EncodeToString(got), hex.EncodeToString(got2), rr.String(), text)
+	}
+	if !bytes.Equal(wire, wire2) {
+		ht.Fatalf("text round trip changes the header: %s -> %s\nrecord %s", h.String(), again.Header().String(), text)
+	}
+	// dnspython reads the library's wire form to its own text
+	var pw pyRdataWire
+	if err := py.call(t, map[string]any{"op": "rdata_wire", "type": typ, "class": "IN", "wire": hex.EncodeToString(got)}, &pw); err != nil {
+		ht.Fatalf("dnspython cannot read the rdata wire %s: %v\nrecord %s", hex.EncodeToString(got), err, text)
+	}
+	if pw.Text != zeroAnglesNorthEast(typ, pr.Text) && !sameAddressesSpeltDifferently(pr.Text, pw.Text) {
+		ht.Fatalf("dnspython prints the wire form differently from its own parse\n from text %s\n from wire %s\nrecord %s", pr.Text, pw.Text, text)
+	}
+	// and the library reads dnspython's re-serialised text, when it parses at all
+	// (dnspython does not escape backslashes in URI targets: not judged)
+	if typ != "URI" && isASCII(pr.Text) {
+		back2, err := dns.NewRR(fmt.Sprintf("%s %d %s %s %s", owner, ttl, class, typ, pr.Text))
+		if err != nil {
+			note(ht, "NewRR rejects dnspython's text %q: %v", pr.Text, err)
+		} else {
+			_, got3, err := packRR(back2)
+			if err == nil && !bytes.Equal(got, got3) {
+				ht.Fatalf("dnspython's text %q parses to different rdata\n go from it %s\n go from original %s\nrecord %s", pr.Text, hex.EncodeToString(got3), hex.EncodeToString(got), text)
+			}
+		}
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..754f280
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,778 @@
+package dns_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape
+// region with random contents, judged by the body of the wide property that
+// found it (recordAgrees, nameAgrees, dnssecAgrees, tsigAgrees, zoneAgrees)
+// or by the identity the bug falsifies, so that each bug has a property that
+// finds it every run; the wide properties reach the shapes at their natural
+// rate. Under HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug
+// does not touch instead (a sorted type list, a 20-byte hash, an altitude in
+// range, the same letter written raw, the IPSECKEY as the last record, ...)
+// and passes.
+
+import (
+	"bytes"
+	"encoding/hex"
+	"fmt"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/miekg/dns"
+	"hegel.dev/go/hegel"
+)
+
+// positions: an index into data of unknown size, taken modulo the size when
+// applied.
+var positions = hegel.Integers(0, 99)
+
+// insertAt puts p into ps at position at (modulo the length plus one).
+func insertAt(ps []string, at int, p string) []string {
+	at %= len(ps) + 1
+	out := append([]string{}, ps[:at]...)
+	out = append(out, p)
+	return append(out, ps[at:]...)
+}
+
+// recordCasesOf: records of the type with the rdata, a plain owner, a TTL
+// with or without units and a class.
+func recordCasesOf(typ string, rdata hegel.Generator[string]) hegel.Generator[recordCase] {
+	return hegel.Composite(func(tc hegel.TestCase) recordCase {
+		return recordCase{
+			typ:   typ,
+			rdata: hegel.Draw(tc, rdata),
+			owner: hegel.Draw(tc, plainNames),
+			ttl:   hegel.Draw(tc, ttls),
+			class: hegel.Draw(tc, classes),
+		}
+	})
+}
+
+// plainPieces: the pieces of a character string without a backslash: a
+// word three times in five, and once each a space and a run.
+var plainPieces = weighted(
+	choice[string]{3, charWords},
+	choice[string]{1, lit(" ")},
+	choice[string]{1, charRuns},
+)
+
+// mustRRs parses a record text inside a property.
+func mustRRs(ht *hegel.T, text string) dns.RR {
+	rr, err := dns.NewRR(text)
+	if err != nil {
+		ht.Fatalf("NewRR(%q): %v", text, err)
+	}
+	return rr
+}
+
+// mustPacks packs a record inside a property.
+func mustPacks(ht *hegel.T, rr dns.RR) []byte {
+	wire, _, err := packRR(rr)
+	if err != nil {
+		ht.Fatalf("PackRR(%s): %v", rr, err)
+	}
+	return wire
+}
+
+// --------------------------------------------------------------------------- miekg-dns/1
+
+var (
+	// escapePieces: the pieces Len counts by their text: \\ and \" (two
+	// characters for one octet) and \DDD (four for one)
+	escapePieces = hegel.OneOf(lit("\\\\"), lit("\\\""), hegel.Map(charEscapeBytes, func(b int) string { return fmt.Sprintf("\\%03d", b) }))
+	// escapedTxts: a TXT string with an escape piece among plain ones; under
+	// HEGEL_NO_KNOWN=1 the plain ones alone
+	escapedTxts = hegel.Composite(func(tc hegel.TestCase) string {
+		ps := hegel.Draw(tc, hegel.Lists(plainPieces).MaxSize(5))
+		if !noKnown {
+			ps = insertAt(ps, hegel.Draw(tc, positions), hegel.Draw(tc, escapePieces))
+		}
+		return quoteCharString(ps, 255)
+	})
+	// paddedKeys, unpaddedKeys: key bytes whose base64 has padding (Len
+	// counts it) or has none
+	paddedKeys = hegel.FlatMap(hegel.Integers(0, 25), func(k int) hegel.Generator[[]byte] {
+		return hegel.OneOf(hegel.Binary(3*k+1, 3*k+1), hegel.Binary(3*k+2, 3*k+2))
+	})
+	unpaddedKeys = hegel.FlatMap(hegel.Integers(1, 26), func(k int) hegel.Generator[[]byte] { return hegel.Binary(3*k, 3*k) })
+	// emptyBitmaps: no NSEC types (Len counts 2 for a bitmap that packs to
+	// nothing); under HEGEL_NO_KNOWN=1 a type list
+	emptyBitmaps = shaped(lit(""), cat(lit(" "), typeListsOf(1, 6, true)))
+	// textGateways: an IPSECKEY host gateway that is the root or has escapes
+	// (Len counts the text); under HEGEL_NO_KNOWN=1 a plain host
+	textGateways = shaped(hegel.OneOf(lit("."), hegel.Map(hegel.Lists(cat(poolLabels, dddEscapes)).MinSize(1).MaxSize(3), dotted)), hostNames)
+	// lenRecords: a record of one of the shapes whose Len is off
+	lenRecords = hegel.OneOf(
+		recordCasesOf("TXT", escapedTxts),
+		recordCasesOf("NSEC", cat(plainNames, emptyBitmaps)),
+		recordCasesOf("DNSKEY", fields(dec(dnskeyFlags), lit("3"), lit("8"), hegel.Map(shaped(paddedKeys, unpaddedKeys), b64Of))),
+		recordCasesOf("IPSECKEY", fields(d8, lit("3"), d8, textGateways, hegel.Map(unpaddedKeys, b64Of))),
+	)
+)
+
+// TestHegelLenIsTheWireLength: Len is the length of the uncompressed wire
+// form for strings with escapes, base64 fields with padding, empty type
+// bitmaps and gateway host names; the generated len methods count the
+// presentation text (miekg-dns/1).
+func TestHegelLenIsTheWireLength(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, lenRecords)
+		rr := mustRRs(ht, c.text())
+		wire := mustPacks(ht, rr)
+		if dns.Len(rr) != len(wire) {
+			ht.Fatalf("Len %d but PackRR wrote %d bytes\nrecord %s", dns.Len(rr), len(wire), c.text())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/2
+
+// bitmapByte is the index of the wire bitmap byte that holds the type
+// (window and byte together): packDataNsec refuses a type whose byte comes
+// before the previous type's.
+func bitmapByte(typ string) int { return typeCode(typ) / 8 }
+
+// unsortedOnTheWire reports a type list with two neighbours in decreasing
+// bitmap-byte order.
+func unsortedOnTheWire(ts []string) bool {
+	for i := 1; i < len(ts); i++ {
+		if bitmapByte(ts[i]) < bitmapByte(ts[i-1]) {
+			return true
+		}
+	}
+	return false
+}
+
+var (
+	// unsortedTypeLists: two to six distinct types in an order other than
+	// the wire order: sorted, with the last (the largest) moved before a
+	// type of an earlier bitmap byte (the rare list within one byte is
+	// filtered out)
+	unsortedTypeLists = hegel.Map(hegel.Filter(hegel.Composite(func(tc hegel.TestCase) []string {
+		ts := distinct(hegel.Draw(tc, hegel.Lists(hegel.SampledFrom(typeNamePool)).MinSize(2).MaxSize(6)))
+		sortTypes(ts)
+		last := ts[len(ts)-1]
+		var earlier []int // the positions of the types of an earlier byte
+		for i, typ := range ts[:len(ts)-1] {
+			if bitmapByte(typ) < bitmapByte(last) {
+				earlier = append(earlier, i)
+			}
+		}
+		if len(earlier) == 0 {
+			return ts
+		}
+		at := earlier[hegel.Draw(tc, positions)%len(earlier)]
+		copy(ts[at+1:], ts[at:len(ts)-1])
+		ts[at] = last
+		return ts
+	}), unsortedOnTheWire), func(ts []string) string { return strings.Join(ts, " ") })
+	// bitmapTypeLists: unsorted, or sorted under HEGEL_NO_KNOWN=1
+	bitmapTypeLists = shaped(unsortedTypeLists, typeListsOf(2, 6, true))
+	bitmapRecords   = hegel.OneOf(
+		recordCasesOf("NSEC", fields(plainNames, bitmapTypeLists)),
+		recordCasesOf("NSEC3", fields(d8, hegel.SampledFrom([]string{"0", "1"}), d16, salts, sha1Hashes, bitmapTypeLists)),
+		recordCasesOf("CSYNC", fields(d32, dec(hegel.OneOf(hegel.SampledFrom([]int{0, 1, 2, 3}), u16s)), bitmapTypeLists)),
+	)
+)
+
+// TestHegelTypeBitmapOrderIsFree: an NSEC, NSEC3 or CSYNC record whose type
+// mnemonics are written in an order other than the wire's parses, packs to
+// dnspython's rdata and reads back; the parser keeps the written order and
+// the packer refuses it (miekg-dns/2).
+func TestHegelTypeBitmapOrderIsFree(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		recordAgrees(ht, t, py, hegel.Draw(ht, bitmapRecords))
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/3
+
+// spellings: two presentation texts of one record (and, for names, the two
+// owner names) that pack to the same wire form.
+type spellings struct {
+	kind         string // "name", "txt" or "hex"
+	a, b         string // the record texts
+	nameA, nameB string // the owners (kind name)
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (s spellings) GoString() string { return fmt.Sprintf("%s spellings %q and %q", s.kind, s.a, s.b) }
+
+const (
+	rawLabelBytes  = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_"
+	escapedLabelBy = ". @\\;()$"
+)
+
+// labelSpellings: the two ways byte b is written in a label: raw or as
+// \DDD for a letter, digit or hyphen; \c or \DDD for a character that
+// needs an escape.
+func labelSpellings(b byte) [2]string {
+	ddd := fmt.Sprintf("\\%03d", b)
+	if strings.IndexByte(rawLabelBytes, b) >= 0 {
+		return [2]string{string(b), ddd}
+	}
+	return [2]string{"\\" + string(b), ddd}
+}
+
+// txtSpellings: the two ways byte b is written in a character string: raw
+// or as \DDD for a letter or digit; \" or \\ or \DDD for the quote and the
+// backslash.
+func txtSpellings(b byte) [2]string {
+	ddd := fmt.Sprintf("\\%03d", b)
+	if b == '"' || b == '\\' {
+		return [2]string{"\\" + string(b), ddd}
+	}
+	return [2]string{string(b), ddd}
+}
+
+// twoWays: the two spellings of a byte in either order; the same one twice
+// under HEGEL_NO_KNOWN=1.
+func twoWays(tc hegel.TestCase, ss [2]string) (string, string) {
+	i := hegel.Draw(tc, hegel.Integers(0, 1))
+	if noKnown {
+		return ss[i], ss[i]
+	}
+	return ss[i], ss[1-i]
+}
+
+var (
+	labelPads = hegel.Text().Alphabet("abcxyz01").MaxSize(4)
+	// nameSpellings: two A records whose owners write one byte of a label in
+	// two ways
+	nameSpellings = hegel.Composite(func(tc hegel.TestCase) spellings {
+		a, b := twoWays(tc, labelSpellings(hegel.Draw(tc, hegel.SampledFrom([]byte(rawLabelBytes+escapedLabelBy)))))
+		pre, suf := hegel.Draw(tc, labelPads), hegel.Draw(tc, labelPads)
+		rest := hegel.Draw(tc, hegel.Lists(hostLabels).MaxSize(2))
+		rdata := hegel.Draw(tc, ip4s)
+		nameOf := func(s string) string { return dotted(append([]string{pre + s + suf}, rest...)) }
+		na, nb := nameOf(a), nameOf(b)
+		return spellings{"name", na + " 0 IN A " + rdata, nb + " 0 IN A " + rdata, na, nb}
+	})
+	// txtSpellings: two TXT records whose strings write one byte in two ways
+	txtSpellingRecords = hegel.Composite(func(tc hegel.TestCase) spellings {
+		a, b := twoWays(tc, txtSpellings(hegel.Draw(tc, hegel.SampledFrom([]byte(rawLabelBytes+"\"\\ ")))))
+		pre, suf := hegel.Draw(tc, plainPieces), hegel.Draw(tc, plainPieces)
+		owner := hegel.Draw(tc, plainNames)
+		textOf := func(s string) string { return owner + " 0 IN TXT " + quoteCharString([]string{pre, s, suf}, 255) }
+		return spellings{kind: "txt", a: textOf(a), b: textOf(b)}
+	})
+	// hexSpellings: two SSHFP records whose fingerprints differ in hex case
+	hexSpellings = hegel.Composite(func(tc hegel.TestCase) spellings {
+		lower := hegel.Draw(tc, hexs(1, 32))
+		upper := strings.ToUpper(lower)
+		if noKnown {
+			upper = lower
+		}
+		owner := hegel.Draw(tc, plainNames)
+		head := owner + " 0 IN SSHFP " + hegel.Draw(tc, d8) + " " + hegel.Draw(tc, d8) + " "
+		return spellings{kind: "hex", a: head + lower, b: head + upper}
+	})
+	sameWireSpellings = hegel.OneOf(nameSpellings, txtSpellingRecords, hexSpellings)
+)
+
+// TestHegelDuplicatesAreJudgedOnTheWire: two records that pack to the same
+// wire form are IsDuplicate whatever the spelling of their names, strings
+// or hex fields, and two spellings of one name compare equal and are
+// subdomains of each other as dnspython says; the library compares the
+// presentation text (miekg-dns/3).
+func TestHegelDuplicatesAreJudgedOnTheWire(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		s := hegel.Draw(ht, sameWireSpellings)
+		ra, rb := mustRRs(ht, s.a), mustRRs(ht, s.b)
+		wa, wb := mustPacks(ht, ra), mustPacks(ht, rb)
+		if !bytes.Equal(wa, wb) {
+			ht.Fatalf("the two spellings pack differently (a fault of the test)\n a %s\n b %s", hex.EncodeToString(wa), hex.EncodeToString(wb))
+		}
+		if !dns.IsDuplicate(ra, rb) {
+			ht.Fatalf("IsDuplicate false for two spellings of one record (wire %s)\n a %s\n b %s", hex.EncodeToString(wa), s.a, s.b)
+		}
+		if s.kind != "name" {
+			return
+		}
+		var pn pyName
+		if err := py.call(t, map[string]any{"op": "name", "text": s.nameA, "other": s.nameB}, &pn); err != nil {
+			ht.Fatalf("dnspython rejects %q or %q: %v", s.nameA, s.nameB, err)
+		}
+		if pn.Relation != 3 {
+			ht.Fatalf("dnspython reads %q and %q as different names (a fault of the test)", s.nameA, s.nameB)
+		}
+		if c := dns.CompareDomainName(s.nameA, s.nameB); c != pn.Common-1 {
+			ht.Fatalf("CompareDomainName(%q, %q) = %d, dnspython says %d labels in common", s.nameA, s.nameB, c, pn.Common-1)
+		}
+		if !dns.IsSubDomain(s.nameA, s.nameB) || !dns.IsSubDomain(s.nameB, s.nameA) {
+			ht.Fatalf("IsSubDomain false between two spellings of one name %q %q", s.nameA, s.nameB)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/4, 9, 10 (LOC)
+
+var (
+	north, east = []string{"N", "S"}, []string{"E", "W"}
+	// exactLatitudes, exactLongitudes: angles the parser reads exactly:
+	// degrees alone, or degrees, minutes and seconds with binary-fraction
+	// milliseconds
+	exactLatitudes  = anglesOf(90, north, exactMillis, false)
+	exactLongitudes = anglesOf(180, east, exactMillis, false)
+	// minuteLocs: at least the latitude written as degrees and minutes
+	// without seconds; under HEGEL_NO_KNOWN=1 neither angle
+	minuteLocs = locsOf(
+		shaped(minuteAngles(90, north), exactLatitudes),
+		shaped(hegel.OneOf(exactLongitudes, minuteAngles(180, east)), exactLongitudes),
+		rangedAltitudes,
+	)
+)
+
+// TestHegelLOCMinutesWithoutSeconds: a LOC angle of degrees and minutes
+// without seconds (RFC 1876 section 3) parses and packs as dnspython packs
+// it; the parser requires seconds after minutes (miekg-dns/4).
+func TestHegelLOCMinutesWithoutSeconds(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		recordAgrees(ht, t, py, hegel.Draw(ht, recordCasesOf("LOC", minuteLocs)))
+	})
+}
+
+// secondsTruncate reports whether the parser's uint32(1000 * f) of the
+// seconds "s.mmm" falls one millisecond short.
+func secondsTruncate(s, ms int) bool {
+	f, _ := strconv.ParseFloat(fmt.Sprintf("%d.%03d", s, ms), 64)
+	return uint32(1000*f) != uint32(s*1000+ms)
+}
+
+// truncatingSeconds and wholeSeconds are the "s.mmm" whose float product
+// truncates (372 of the 60000) and the rest.
+var truncatingSeconds, wholeSeconds = func() (truncating, whole []string) {
+	for s := 0; s < 60; s++ {
+		for ms := 0; ms < 1000; ms++ {
+			text := fmt.Sprintf("%d.%03d", s, ms)
+			if secondsTruncate(s, ms) {
+				truncating = append(truncating, text)
+			} else {
+				whole = append(whole, text)
+			}
+		}
+	}
+	return truncating, whole
+}()
+
+var (
+	// exactSeconds: seconds whose float product is whole
+	exactSeconds = hegel.SampledFrom(wholeSeconds)
+	// truncatingLocs: a latitude whose seconds truncate; under HEGEL_NO_KNOWN=1 exact ones
+	truncatingLocs = locsOf(
+		fields(dec(hegel.Integers(0, 89)), dec(hegel.Integers(0, 59)), shaped[hegel.Generator[string]](hegel.SampledFrom(truncatingSeconds), exactSeconds), hegel.SampledFrom(north)),
+		exactLongitudes,
+		rangedAltitudes,
+	)
+)
+
+// TestHegelLOCSecondsAreExact: the milliseconds of a LOC seconds field are
+// packed as written, as dnspython packs them; the parser converts through
+// a float and truncates 4.031 to 4030 ms (miekg-dns/9).
+func TestHegelLOCSecondsAreExact(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		recordAgrees(ht, t, py, hegel.Draw(ht, recordCasesOf("LOC", truncatingLocs)))
+	})
+}
+
+// wrappedLocs: an altitude outside RFC 1876's range; in range under HEGEL_NO_KNOWN=1
+var wrappedLocs = locsOf(exactLatitudes, exactLongitudes, shaped(wrappedAltitudes, rangedAltitudes))
+
+// TestHegelLOCAltitudeOutOfRangeIsRejected: a LOC altitude below
+// -100000.00m or above 42849672.95m is rejected, as dnspython rejects it;
+// the parser converts it to uint32 without a range check and it wraps
+// around (miekg-dns/10).
+func TestHegelLOCAltitudeOutOfRangeIsRejected(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		recordAgrees(ht, t, py, hegel.Draw(ht, recordCasesOf("LOC", wrappedLocs)))
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/5
+
+// TestHegelX25AcceptsQuotedAddress: an X25 address written as a quoted
+// <character-string> (RFC 1183 section 3.1) parses and packs as dnspython
+// packs it; the parser takes one bare token (miekg-dns/5).
+func TestHegelX25AcceptsQuotedAddress(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		recordAgrees(ht, t, py, hegel.Draw(ht, recordCasesOf("X25", shaped(quotedX25Addrs, bareX25Addrs))))
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/6
+
+var (
+	// backslashValues: a CAA value or URI target with a \\ among its pieces;
+	// under HEGEL_NO_KNOWN=1 the pieces alone
+	backslashValues = hegel.Composite(func(tc hegel.TestCase) string {
+		ps := hegel.Draw(tc, hegel.Lists(plainPieces).MinSize(1).MaxSize(5))
+		if !noKnown {
+			ps = insertAt(ps, hegel.Draw(tc, positions), "\\\\")
+		}
+		return quoteCharString(ps, 200)
+	})
+	octetRecords = hegel.OneOf(
+		recordCasesOf("CAA", fields(dec(hegel.OneOf(hegel.SampledFrom([]int{0, 128}), u8s)), hegel.SampledFrom([]string{"issue", "issuewild", "iodef", "contactemail", "x1"}), backslashValues)),
+		recordCasesOf("URI", fields(d16, d16, backslashValues)),
+	)
+)
+
+// TestHegelUnpackedOctetStringsPrintEscaped: a CAA or URI record read from
+// the wire prints so that its String() reads back to the same wire form,
+// and packs to its own wire form again; the unpacker stores the raw octets
+// where the parser stores escaped text, and both the printer and the
+// packer re-interpret a raw backslash (miekg-dns/6).
+func TestHegelUnpackedOctetStringsPrintEscaped(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, octetRecords)
+		wire := mustPacks(ht, mustRRs(ht, c.text()))
+		back, _, err := dns.UnpackRR(wire, 0)
+		if err != nil {
+			ht.Fatalf("UnpackRR: %v\nrecord %s", err, c.text())
+		}
+		again := mustRRs(ht, back.String())
+		if w := mustPacks(ht, again); !bytes.Equal(w, wire) {
+			ht.Fatalf("the unpacked record prints %q, which packs to %s, not %s\nrecord %s", back.String(), hex.EncodeToString(w), hex.EncodeToString(wire), c.text())
+		}
+		if w := mustPacks(ht, back); !bytes.Equal(w, wire) {
+			ht.Fatalf("Pack(Unpack(wire)) is %s, not %s\nrecord %s", hex.EncodeToString(w), hex.EncodeToString(wire), c.text())
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/7
+
+var (
+	// mappedGateways: an IPv4-mapped IPv6 address; under HEGEL_NO_KNOWN=1 an unmapped one
+	mappedGateways       = shaped(mappedIP6s, unmappedIP6s)
+	mappedGatewayRecords = hegel.OneOf(
+		recordCasesOf("IPSECKEY", fields(d8, lit("2"), d8, mappedGateways, b64s(1, 40))),
+		recordCasesOf("AMTRELAY", fields(d8, lit("0"), lit("2"), mappedGateways)),
+		recordCasesOf("SVCB", fields(dec(hegel.Integers(1, 65535)), hegel.OneOf(lit("."), plainNames), cat(lit("ipv6hint="), mappedGateways))),
+	)
+)
+
+// TestHegelMappedIPv6Gateways: an IPv4-mapped IPv6 address is an IPv6
+// gateway of IPSECKEY and AMTRELAY and an ipv6hint of SVCB, as dnspython
+// reads it (and AAAA accepts it); the parsers reject it with an empty error
+// (miekg-dns/7).
+func TestHegelMappedIPv6Gateways(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		recordAgrees(ht, t, py, hegel.Draw(ht, mappedGatewayRecords))
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/8
+
+var (
+	// upperEscapedNames: a name whose first label writes an upper-case letter
+	// as a \DDD escape; under HEGEL_NO_KNOWN=1 the letter itself
+	upperEscapedNames = hegel.Composite(func(tc hegel.TestCase) string {
+		letter := hegel.Draw(tc, hegel.Integers(65, 90))
+		spelt := fmt.Sprintf("\\%03d", letter)
+		if noKnown {
+			spelt = string(rune(letter))
+		}
+		pre, suf := hegel.Draw(tc, labelPads), hegel.Draw(tc, labelPads)
+		rest := hegel.Draw(tc, hegel.Lists(hostLabels).MaxSize(2))
+		return dotted(append([]string{pre + spelt + suf}, rest...))
+	})
+	upperEscapedNameCases   = nameCasesOf(upperEscapedNames)
+	upperEscapedDnssecCases = dnssecCasesOf(upperEscapedNames, hegel.SampledFrom([]int{8, 13, 15}))
+)
+
+// TestHegelCanonicalNameLowercasesEscapes: the canonical form of a name
+// with an upper-case letter written as \DDD is dnspython's (RFC 4034
+// section 6.2 lowercases every US-ASCII letter), and so are the NSEC3 hash
+// and DS digests computed from it; CanonicalName lowercases the text and
+// leaves the escape (miekg-dns/8).
+func TestHegelCanonicalNameLowercasesEscapes(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		nameAgrees(ht, t, py, hegel.Draw(ht, upperEscapedNameCases))
+		dnssecAgrees(ht, t, py, hegel.Draw(ht, upperEscapedDnssecCases))
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/11
+
+var (
+	// hashLengthRecords: an NSEC3 whose next hashed owner is not 20 bytes;
+	// 20 bytes under HEGEL_NO_KNOWN=1
+	hashLengthRecords = recordCasesOf("NSEC3", cat(
+		fields(d8, hegel.SampledFrom([]string{"0", "1"}), d16, salts, shaped(otherHashes, sha1Hashes)),
+		optTypeListsOf(6, true),
+	))
+)
+
+// TestHegelNSEC3HashLengthIsTheHashLength: an NSEC3 record packs the length
+// of its next hashed owner name field (RFC 5155 section 3.1.7) and reads
+// back, as dnspython packs it; the parser sets the length to 20 whatever
+// the hash (miekg-dns/11).
+func TestHegelNSEC3HashLengthIsTheHashLength(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		recordAgrees(ht, t, py, hegel.Draw(ht, hashLengthRecords))
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/12
+
+var (
+	// setDBits: the D bit set; clear under HEGEL_NO_KNOWN=1
+	setDBits = shaped(lit("1"), lit("0"))
+	// dBitRelays: an AMTRELAY with the D bit and a gateway of each type
+	dBitRelays = recordCasesOf("AMTRELAY", hegel.OneOf(
+		fields(d8, setDBits, lit("1"), ip4s),
+		fields(d8, setDBits, lit("2"), unmappedIP6s),
+		fields(d8, setDBits, lit("3"), plainNames),
+	))
+)
+
+// TestHegelAMTRELAYKeepsGatewayWithDBit: an AMTRELAY record with the D bit
+// set packs its gateway (RFC 8777 section 4.2), as dnspython packs it; the
+// packer matches the gateway type with the D bit still in it and writes
+// no gateway (miekg-dns/12).
+func TestHegelAMTRELAYKeepsGatewayWithDBit(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		recordAgrees(ht, t, py, hegel.Draw(ht, dBitRelays))
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/13, 14, 17 (zone files)
+
+// plainRRTypes: record types whose rdata carries none of the recorded
+// shapes, for the messages and zones around the shape of one bug.
+var plainRRTypes = []string{"A", "AAAA", "NS", "PTR", "MX", "TXT", "SRV", "DS", "SSHFP", "TLSA", "NAPTR", "HINFO", "SOA"}
+
+// plainZoneRecords: a zone record of the plain types (SOA excluded:
+// dnspython wants it at the origin).
+var plainZoneRecords = zoneRecordEntriesOf(plainRRTypes[:len(plainRRTypes)-1])
+
+// parenRdatas: rdata of the types whose readers stop at a comment inside
+// parentheses, with sorted type lists and SHA-1 hashes so that nothing
+// else is off; every one has three fields or more and no quotes, which is
+// what the zone writer puts in parentheses.
+var parenRdatas = map[string]hegel.Generator[string]{
+	"NSEC":  fields(plainNames, typeListsOf(2, 6, true)),
+	"NSEC3": fields(d8, hegel.SampledFrom([]string{"0", "1"}), d16, salts, sha1Hashes, typeListsOf(1, 6, true)),
+	"CSYNC": fields(d32, dec(hegel.OneOf(hegel.SampledFrom([]int{0, 1, 2, 3}), u16s)), typeListsOf(1, 5, true)),
+	"RRSIG": rrsigsOf(hegel.SampledFrom(zoneCoveredTypes)),
+}
+
+// parenZones: a zone of one such record written in parentheses across
+// lines (the writer puts a comment after the first field, or none under
+// HEGEL_NO_KNOWN=1).
+var parenZones = zoneCasesOf(hegel.Map(hegel.FlatMap(hegel.SampledFrom([]string{"NSEC", "NSEC3", "CSYNC", "RRSIG"}), func(typ string) hegel.Generator[zoneEntry] {
+	return zoneRecordsOf(typ, parenRdatas[typ], namedZoneOwners)
+}), func(e zoneEntry) []zoneEntry {
+	e.parens = true
+	return []zoneEntry{e}
+}))
+
+// TestHegelCommentsInsideParentheses: an NSEC, NSEC3, CSYNC or RRSIG record
+// written in parentheses across lines with a comment before a line break
+// (RFC 1035 section 5.1) parses as dnspython parses it; the readers of the
+// type bitmap and of the signature take the next line's first token as
+// the comment's (miekg-dns/13).
+func TestHegelCommentsInsideParentheses(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		zoneAgrees(ht, t, py, hegel.Draw(ht, parenZones))
+	})
+}
+
+// blankFirstZones: a zone whose first record has a blank owner, before any
+// record (written "@" under HEGEL_NO_KNOWN=1), and plain records after it.
+var blankFirstZones = zoneCasesOf(hegel.Composite(func(tc hegel.TestCase) []zoneEntry {
+	first := hegel.Draw(tc, plainZoneRecords)
+	first.owner = zoneOwner{kind: 3}
+	return append([]zoneEntry{first}, hegel.Draw(tc, hegel.Lists(plainZoneRecords).MaxSize(5))...)
+}))
+
+// TestHegelBlankFirstOwnerIsNotEmpty: a zone whose first record has a blank
+// owner yields records under the origin (dnspython uses the origin, BIND
+// rejects the zone); the parser uses its empty previous owner and yields a
+// nameless record (miekg-dns/14).
+func TestHegelBlankFirstOwnerIsNotEmpty(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		zoneAgrees(ht, t, py, hegel.Draw(ht, blankFirstZones))
+	})
+}
+
+// ipseckeyZones: a zone with an IPSECKEY record (on its own line, gateway
+// not mapped) before one to four plain records; under HEGEL_NO_KNOWN=1
+// after them.
+var ipseckeyZones = zoneCasesOf(hegel.Composite(func(tc hegel.TestCase) []zoneEntry {
+	ipseckey := hegel.Draw(tc, zoneRecordsOf("IPSECKEY", ipseckeysOf(unmappedIP6s), namedZoneOwners))
+	ipseckey.parens = false
+	others := hegel.Draw(tc, hegel.Lists(plainZoneRecords).MinSize(1).MaxSize(4))
+	if noKnown {
+		return append(others, ipseckey)
+	}
+	return append([]zoneEntry{ipseckey}, others...)
+}))
+
+// TestHegelIPSECKEYThenAnotherRecord: a zone file with a record after an
+// IPSECKEY parses as dnspython parses it; the IPSECKEY parser eats the
+// line's end and takes the next record's owner as garbage (miekg-dns/17).
+func TestHegelIPSECKEYThenAnotherRecord(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		zoneAgrees(ht, t, py, hegel.Draw(ht, ipseckeyZones))
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/15, 18 (TSIG)
+
+var (
+	// plainMsgSpecs: uncompressed messages of plain records (no other bug's
+	// shape rides in them)
+	plainMsgSpecs = hegel.Map(msgSpecsOf(msgRRsOf(rrTextsOf(plainRRTypes))), func(spec msgSpec) msgSpec {
+		spec.compress = false
+		return spec
+	})
+	// plainTsigCases: such a message, not NOTAUTH, signed with a random key
+	plainTsigCases = tsigCasesOf(hegel.Map(plainMsgSpecs, func(spec msgSpec) msgSpec {
+		if spec.rcodeValue()&0xF == dns.RcodeNotAuth {
+			spec = spec.withRcode(dns.RcodeSuccess)
+		}
+		return spec
+	}))
+)
+
+// TestHegelTsigVerifyKeepsTheBuffer: TsigVerify of a message signed with
+// TsigGenerate succeeds and leaves the caller's buffer as it was, so the
+// message still unpacks with its TSIG; stripTsig writes the decremented
+// ARCOUNT into the buffer (miekg-dns/15; under HEGEL_NO_KNOWN=1 a copy is
+// verified and the original is checked).
+func TestHegelTsigVerifyKeepsTheBuffer(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, plainTsigCases)
+		m := c.spec.msg()
+		m.SetTsig(c.keyName, c.alg, c.fudge, time.Now().Unix())
+		signed, _, err := dns.TsigGenerate(m, c.secret, "", false)
+		if err != nil {
+			ht.Fatalf("TsigGenerate: %v\n%s", err, m.String())
+		}
+		before := append([]byte(nil), signed...)
+		verified := signed
+		if Known.tsigVerifyMutates {
+			verified = append([]byte(nil), signed...)
+		}
+		if err := dns.TsigVerify(verified, c.secret, "", false); err != nil {
+			ht.Fatalf("TsigVerify: %v\n%s", err, m.String())
+		}
+		if !bytes.Equal(before, signed) {
+			ht.Fatalf("TsigVerify changed the buffer: header %s -> %s\n%s", hex.EncodeToString(before[:12]), hex.EncodeToString(signed[:12]), m.String())
+		}
+		var back dns.Msg
+		if err := back.Unpack(signed); err != nil {
+			ht.Fatalf("Unpack after TsigVerify: %v", err)
+		}
+		if back.IsTsig() == nil {
+			ht.Fatalf("no TSIG record after TsigVerify\n%s", back.String())
+		}
+	})
+}
+
+// notAuthSpecs: messages of plain records whose rcode is NOTAUTH (9), plain
+// or as the low bits of an extended rcode; under HEGEL_NO_KNOWN=1 NOERROR
+// in the same form.
+var notAuthSpecs = hegel.Map(pairs(plainMsgSpecs, hegel.Integers(0, 255)), func(p pair[msgSpec, int]) msgSpec {
+	return p.a.withRcode(p.b<<4 | shaped(dns.RcodeNotAuth, dns.RcodeSuccess))
+})
+
+// TestHegelTsigVerifiesNotAuthMessages: a NOTAUTH message (a dynamic update
+// response, RFC 2136 section 2.2, or a BADTIME answer, RFC 8945 section
+// 5.2.3) signed with TsigGenerate verifies in dnspython and in TsigVerify
+// like any other; stripTsig returns ErrAuth for rcode 9 before looking at
+// the signature (miekg-dns/18).
+func TestHegelTsigVerifiesNotAuthMessages(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		tsigAgrees(ht, t, py, hegel.Draw(ht, tsigCasesOf(notAuthSpecs)))
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/16
+
+// rsamd5Cases: a DNSKEY of algorithm 1 (RSA/MD5); algorithm 8 under HEGEL_NO_KNOWN=1.
+var rsamd5Cases = dnssecCasesOf(plainNames, shaped(hegel.Just(1), hegel.Just(8)))
+
+// TestHegelKeyTagFollowsTheRSAMD5Rule: the key tag of an RSA/MD5 DNSKEY is
+// the most significant 16 bits of the least significant 24 bits of the
+// modulus (RFC 4034 appendix B.1), as dnspython's key_id computes it, and
+// its DS records carry it; KeyTag applies the ones-complement sum of every
+// other algorithm (miekg-dns/16).
+func TestHegelKeyTagFollowsTheRSAMD5Rule(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		dnssecAgrees(ht, t, py, hegel.Draw(ht, rsamd5Cases))
+	})
+}
+
+// --------------------------------------------------------------------------- miekg-dns/19
+
+// certType: a CERT type mnemonic and its number.
+type certType struct {
+	mnemonic string
+	code     int
+}
+
+// certCase: a CERT record with its type written as a mnemonic.
+type certCase struct {
+	typ  certType
+	rest string // key tag, algorithm, certificate
+	rec  recordCase
+}
+
+// GoString is what the draw report prints (it uses %#v).
+func (c certCase) GoString() string { return c.rec.text() }
+
+var (
+	ipkix          = certType{"IPKIX", 4}
+	otherCertTypes = []certType{{"PKIX", 1}, {"SPKI", 2}, {"PGP", 3}, {"ISPKI", 5}, {"IPGP", 6}, {"ACPKIX", 7}, {"IACPKIX", 8}, {"URI", 253}, {"OID", 254}}
+	// certAlgs: the algorithms both libraries spell alike (dnspython writes
+	// DSANSEC3SHA1, RSASHA1NSEC3SHA1 and ECCGOST without the hyphens the
+	// library prints), and two without a mnemonic
+	certAlgs = dec(hegel.SampledFrom([]int{1, 2, 3, 5, 8, 10, 13, 14, 15, 16, 252, 253, 254, 100, 255}))
+	// certCases: a CERT of type 4 spelt IPKIX (RFC 4398 section 2.1); under
+	// HEGEL_NO_KNOWN=1 one of the other mnemonics
+	certCases = hegel.Composite(func(tc hegel.TestCase) certCase {
+		typ := hegel.Draw(tc, shaped(hegel.Just(ipkix), hegel.SampledFrom(otherCertTypes)))
+		rest := hegel.Draw(tc, fields(d16, certAlgs, b64s(1, 40)))
+		rec := hegel.Draw(tc, recordCasesOf("CERT", lit(typ.mnemonic+" "+rest)))
+		return certCase{typ, rest, rec}
+	})
+)
+
+// TestHegelCERTType4IsIPKIX: a CERT record of type 4 is written and read as
+// IPKIX (RFC 4398 section 2.1): the mnemonic parses and packs as dnspython
+// packs it, and the numeric form prints a mnemonic dnspython reads; the
+// library spells it IPIX (miekg-dns/19).
+func TestHegelCERTType4IsIPKIX(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, certCases)
+		recordAgrees(ht, t, py, c.rec)
+		numeric := c.rec
+		numeric.rdata = fmt.Sprintf("%d %s", c.typ.code, c.rest)
+		rr := mustRRs(ht, numeric.text())
+		printed := strings.Split(rr.String(), "\t")
+		var pr pyRdata
+		if err := py.call(t, map[string]any{"op": "rdata", "type": "CERT", "class": "IN", "text": printed[len(printed)-1]}, &pr); err != nil {
+			ht.Fatalf("dnspython rejects the String() of a CERT of type %d: %v\n%s", c.typ.code, err, rr.String())
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..b3f6781
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,244 @@
+package dns_test
+
+// Hegel properties for github.com/miekg/dns: records, names, messages,
+// zone files and DNSSEC/TSIG primitives against dnspython (the other
+// complete DNS library, as a child process), plus library-internal
+// identities (text and wire round trips, lengths, compression, truncation,
+// duplicates).
+//
+// A case is drawn as data: each property draws one record (a resource
+// record in presentation form with its parts, a name and a relative of it,
+// the specification of a message, the entries of a zone file) built from
+// the binding's combinators; pure functions render the record as text or as
+// a dns.Msg, and the oracle reads the result.
+//
+// Needs python3 with the `dnspython` package (2.x) on PATH.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn by default and the
+// properties that meet them fail; hegel_shapes_test.go has one property per
+// bug over its shape region alone, and hegel_pins_test.go the regression
+// examples. HEGEL_NO_KNOWN=1 switches the known shapes off (noKnown, below)
+// for a run that looks past the bugs.
+//
+// Conventions: hegel-go reads no environment variable itself, so
+// HEGEL_TEST_CASES (and HEGEL_VERBOSE) are passed through hegelOpts; a panic
+// in the code under test is turned into a failure of the current test case
+// by property().
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see HACKING.md).
+
+func hegelOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	if os.Getenv("HEGEL_VERBOSE") != "" {
+		opts = append(opts, hegel.WithVerbosity(hegel.VerbosityVerbose))
+	}
+	return opts
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under
+// test into a failure of the current test case (hegel-go re-raises panics
+// after shrinking, which would abort the test binary and hide every later
+// test).  Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// Generator idioms.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability
+// proportional to its weight; it shrinks towards the first choice, so the
+// simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers
+// shrinks to 0, so the true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value
+// otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pair holds two independent draws as one value (the binding has no tuple
+// combinator).
+type pair[A, B any] struct {
+	a A
+	b B
+}
+
+func pairs[A, B any](ga hegel.Generator[A], gb hegel.Generator[B]) hegel.Generator[pair[A, B]] {
+	return hegel.Composite(func(tc hegel.TestCase) pair[A, B] {
+		return pair[A, B]{hegel.Draw(tc, ga), hegel.Draw(tc, gb)}
+	})
+}
+
+// fixed is a list of exactly k elements.
+func fixed[T any](g hegel.Generator[T], k int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(k).MaxSize(k)
+}
+
+// seq draws one string from each generator and joins them with sep: the
+// fields of a record, the pieces of a token.
+func seq(sep string, gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		parts := make([]string, len(gens))
+		for i, g := range gens {
+			parts[i] = hegel.Draw(tc, g)
+		}
+		return strings.Join(parts, sep)
+	})
+}
+
+// fields: space-separated rdata fields; cat: pieces of one token.
+func fields(gens ...hegel.Generator[string]) hegel.Generator[string] { return seq(" ", gens...) }
+
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] { return seq("", gens...) }
+
+func lit(s string) hegel.Generator[string] { return hegel.Just(s) }
+
+// dec is the decimal text of an integer generator.
+func dec[T int | uint32](g hegel.Generator[T]) hegel.Generator[string] {
+	return hegel.Map(g, func(x T) string { return fmt.Sprint(x) })
+}
+
+// padded is the decimal text of an integer generator, zero-padded to width.
+func padded(width int, g hegel.Generator[int]) hegel.Generator[string] {
+	return hegel.Map(g, func(x int) string { return fmt.Sprintf("%0*d", width, x) })
+}
+
+// distinct drops the repeats of a list, keeping the first occurrences.
+func distinct[T comparable](xs []T) []T {
+	seen := map[T]bool{}
+	var out []T
+	for _, x := range xs {
+		if !seen[x] {
+			seen[x] = true
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read
+// once. By default the generators draw the bugs' shapes and the properties
+// that meet them fail (STYLE.md rule 11); under HEGEL_NO_KNOWN=1 the gates of
+// Known are on: the shapes are left out of the generators (shaped) and the
+// checks a shape falsifies are skipped for the records that still carry it.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// shaped is the generator (or value) for a recorded bug's shape region or,
+// under HEGEL_NO_KNOWN=1, for the neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// Known gates the input shapes of recorded bugs (see bugs.toml); on means the
+// shape is left out or its check skipped, which is so only under
+// HEGEL_NO_KNOWN=1. The pin tests in hegel_pins_test.go assert the correct
+// behaviour on fixed examples and hegel_shapes_test.go has one property per
+// bug over its shape region.
+var Known = struct {
+	lenOverestimates          bool // 1: Len counts escapes, base64 padding, empty bitmaps
+	unsortedTypeBitmap        bool // 2: NSEC/NSEC3/CSYNC text with unsorted types cannot be packed
+	textualDuplicates         bool // 3: IsDuplicate, CompareDomainName compare the presentation text
+	locMinutesNeedSeconds     bool // 4: LOC text with minutes but no seconds is rejected
+	x25TakesOneToken          bool // 5: X25 rejects a quoted character-string
+	octetPrintUnescaped       bool // 6: unpacked CAA/URI values print backslashes as escapes
+	mappedGatewayRejected     bool // 7: IPSECKEY/AMTRELAY/SVCB reject an IPv4-mapped IPv6 address
+	canonicalKeepsEscapedCase bool // 8: CanonicalName leaves an escaped upper-case letter
+	locFloatTruncation        bool // 9: LOC seconds lose a millisecond to float truncation
+	locAltitudeWraps          bool // 10: LOC altitude outside the range wraps around
+	nsec3HashLengthFixed      bool // 11: NSEC3 packs a hash length of 20 whatever the hash
+	amtrelayDBitDropsGateway  bool // 12: AMTRELAY with the D bit set packs without its gateway
+	parenCommentBreaksBitmap  bool // 13: a comment inside parentheses breaks NSEC/NSEC3/CSYNC/RRSIG parsing
+	blankFirstOwnerEmpty      bool // 14: a blank owner before any record gives an empty owner name
+	tsigVerifyMutates         bool // 15: TsigVerify decrements the ARCOUNT in the caller's buffer
+	keyTagRSAMD5              bool // 16: KeyTag ignores the RSAMD5 rule of RFC 4034 appendix B.1
+	ipseckeyEatsNewline       bool // 17: an IPSECKEY record cannot be followed by another record
+	tsigVerifyRefusesNotAuth  bool // 18: TsigVerify rejects every NOTAUTH message unverified
+	certIPKIXMisspelt         bool // 19: CERT type 4 is spelt IPIX instead of IPKIX
+}{
+	lenOverestimates:          noKnown,
+	unsortedTypeBitmap:        noKnown,
+	textualDuplicates:         noKnown,
+	locMinutesNeedSeconds:     noKnown,
+	x25TakesOneToken:          noKnown,
+	octetPrintUnescaped:       noKnown,
+	mappedGatewayRejected:     noKnown,
+	canonicalKeepsEscapedCase: noKnown,
+	locFloatTruncation:        noKnown,
+	locAltitudeWraps:          noKnown,
+	nsec3HashLengthFixed:      noKnown,
+	amtrelayDBitDropsGateway:  noKnown,
+	parenCommentBreaksBitmap:  noKnown,
+	blankFirstOwnerEmpty:      noKnown,
+	tsigVerifyMutates:         noKnown,
+	keyTagRSAMD5:              noKnown,
+	ipseckeyEatsNewline:       noKnown,
+	tsigVerifyRefusesNotAuth:  noKnown,
+	certIPKIXMisspelt:         noKnown,
+}
