+package dns_test
+
+import (
+	"encoding/hex"
+	"fmt"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/miekg/dns"
+	"hegel.dev/go/hegel"
+)
+
+// TestHegelDnssecPrimitivesAgreeWithDnspython: NSEC3 hashing, DNSKEY key tags
+// and DS digests agree with dnspython.
+func TestHegelDnssecPrimitivesAgreeWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		name := genName(tc)
+		if Known.canonicalKeepsEscapedCase && strings.Contains(name, "\\") {
+			name = genHostName(tc)
+		}
+		// NSEC3
+		salt := pick(tc, "", "-", hexOf(genBytes(tc, 1, 32)))
+		iter := pick(tc, 0, 1, 10, 150, n(tc, 0, 500))
+		pySalt := salt
+		if pySalt == "-" {
+			pySalt = "" // HashName takes the salt as hex, "-" is the presentation form of no salt
+		}
+		got := dns.HashName(name, dns.SHA1, uint16(iter), pySalt)
+		var ph struct {
+			Hash string `json:"hash"`
+		}
+		if err := py.call(t, map[string]any{"op": "nsec3", "name": name, "salt": pySalt, "iter": iter, "alg": 1}, &ph); err != nil {
+			fail(ht, "dnspython nsec3_hash(%q, %q, %d): %v", name, salt, iter, err)
+		}
+		if !strings.EqualFold(got, ph.Hash) {
+			fail(ht, "HashName(%q, SHA1, %d, %q) = %q, dnspython %q", name, iter, salt, got, ph.Hash)
+		}
+		if got == "" {
+			fail(ht, "HashName(%q, SHA1, %d, %q) is empty", name, iter, salt)
+		}
+		// DNSKEY key tag and DS
+		key := genBytes(tc, 1, 80)
+		flags := pick(tc, 256, 257, 0, u16(tc))
+		alg := pick(tc, 8, 13, 15, 5, 7, 10, 14, 16, u8(tc))
+		if alg == 1 && Known.keyTagRSAMD5 {
+			alg = 8
+		}
+		text := fmt.Sprintf("%s 3600 IN DNSKEY %d 3 %d %s", name, flags, alg, b64Of(key))
+		rr, err := dns.NewRR(text)
+		if err != nil {
+			fail(ht, "NewRR(%q): %v", text, err)
+		}
+		dk := rr.(*dns.DNSKEY)
+		_, rdata, err := packRR(dk)
+		if err != nil {
+			fail(ht, "PackRR(%q): %v", text, err)
+		}
+		var pk struct {
+			Tag int `json:"tag"`
+		}
+		if err := py.call(t, map[string]any{"op": "keytag", "wire": hex.EncodeToString(rdata)}, &pk); err != nil {
+			fail(ht, "dnspython key_id: %v\n%s", err, text)
+		}
+		if int(dk.KeyTag()) != pk.Tag {
+			fail(ht, "KeyTag %d, dnspython %d\n%s", dk.KeyTag(), pk.Tag, text)
+		}
+		for _, h := range []uint8{dns.SHA1, dns.SHA256, dns.SHA384} {
+			ds := dk.ToDS(h)
+			if ds == nil {
+				fail(ht, "ToDS(%d) is nil\n%s", h, text)
+			}
+			var pd struct {
+				Text string `json:"text"`
+				Wire string `json:"wire"`
+			}
+			if err := py.call(t, map[string]any{"op": "ds", "name": name, "wire": hex.EncodeToString(rdata), "alg": int(h)}, &pd); err != nil {
+				fail(ht, "dnspython make_ds(%d): %v\n%s", h, err, text)
+			}
+			_, dsWire, err := packRR(ds)
+			if err != nil {
+				fail(ht, "PackRR of the DS: %v", err)
+			}
+			if hex.EncodeToString(dsWire) != pd.Wire {
+				fail(ht, "ToDS(%d) = %s, dnspython %s\n%s", h, hex.EncodeToString(dsWire), pd.Wire, text)
+			}
+			if ds.KeyTag != dk.KeyTag() || ds.Algorithm != dk.Algorithm || ds.DigestType != h {
+				fail(ht, "ToDS(%d) fields %d %d %d differ from the key\n%s", h, ds.KeyTag, ds.Algorithm, ds.DigestType, text)
+			}
+		}
+	})
+}
+
+var tsigAlgs = []string{dns.HmacSHA1, dns.HmacSHA224, dns.HmacSHA256, dns.HmacSHA384, dns.HmacSHA512}
+
+// TestHegelTsigInteroperates: a message signed with TsigGenerate verifies in
+// dnspython, a message signed by dnspython verifies with TsigVerify, and a
+// damaged message verifies in neither.
+func TestHegelTsigInteroperates(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		m := genMsg(tc)
+		m.Compress = false
+		if Known.tsigVerifyRefusesNotAuth && m.Rcode&0xF == dns.RcodeNotAuth {
+			m.Rcode = dns.RcodeSuccess
+		}
+		keyName := strings.ToLower(genHostName(tc))
+		secret := b64Of(genBytes(tc, 1, 64))
+		alg := pick(tc, tsigAlgs...)
+		fudge := uint16(pick(tc, 300, 60, 3600))
+		note(ht, "key %s alg %s fudge %d\n%s", keyName, alg, fudge, m.String())
+
+		// signed here, verified there
+		m.SetTsig(keyName, alg, fudge, time.Now().Unix())
+		signed, mac, err := dns.TsigGenerate(m, secret, "", false)
+		if err != nil {
+			fail(ht, "TsigGenerate: %v\n%s", err, m.String())
+		}
+		var pv struct {
+			OK  bool   `json:"ok"`
+			Mac string `json:"mac"`
+			Err string `json:"err"`
+		}
+		if err := py.call(t, map[string]any{"op": "tsig_verify", "wire": hex.EncodeToString(signed), "keyname": keyName, "secret": secret, "alg": alg}, &pv); err != nil {
+			fail(ht, "dnspython tsig verify call: %v", err)
+		}
+		if !pv.OK {
+			fail(ht, "dnspython rejects a message signed by TsigGenerate: %s\nkey %s alg %s\nwire %s\n%s", pv.Err, keyName, alg, hex.EncodeToString(signed), m.String())
+		}
+		if !strings.EqualFold(pv.Mac, mac) {
+			fail(ht, "MAC %s but dnspython read %s", mac, pv.Mac)
+		}
+		// and here again (on a copy: TsigVerify writes into its argument)
+		verified := signed
+		if Known.tsigVerifyMutates {
+			verified = append([]byte(nil), signed...)
+		}
+		if err := dns.TsigVerify(verified, secret, "", false); err != nil {
+			fail(ht, "TsigVerify rejects TsigGenerate's own output: %v\nkey %s alg %s\n%s", err, keyName, alg, m.String())
+		}
+		var back dns.Msg
+		if err := back.Unpack(signed); err != nil {
+			fail(ht, "Unpack of the signed message: %v", err)
+		}
+		ts := back.IsTsig()
+		if ts == nil {
+			fail(ht, "the signed message has no TSIG record after Unpack\nwire %s\n%s", hex.EncodeToString(signed), back.String())
+		}
+		if !strings.EqualFold(ts.Algorithm, alg) || !strings.EqualFold(ts.Hdr.Name, keyName) || int(ts.MACSize)*2 != len(ts.MAC) || !strings.EqualFold(ts.MAC, mac) || ts.Fudge != fudge {
+			fail(ht, "TSIG record read back differs: %s (mac %s)", ts.String(), mac)
+		}
+		// a damaged message (the QR bit; the ID is not covered, RFC 8945 5.3.1 restores the original)
+		damaged := append([]byte(nil), signed...)
+		damaged[2] ^= 0x80
+		if err := dns.TsigVerify(damaged, secret, "", false); err == nil {
+			fail(ht, "TsigVerify accepts a message with a changed QR bit\nkey %s alg %s", keyName, alg)
+		}
+		if err := py.call(t, map[string]any{"op": "tsig_verify", "wire": hex.EncodeToString(damaged), "keyname": keyName, "secret": secret, "alg": alg}, &pv); err == nil && pv.OK {
+			fail(ht, "dnspython accepts a message with a changed QR bit that this library signed")
+		}
+		// wrong secret
+		if err := dns.TsigVerify(signed, b64Of([]byte("other")), "", false); err == nil {
+			fail(ht, "TsigVerify accepts the wrong secret")
+		}
+
+		// signed there, verified here (TsigGenerate removed the TSIG stub from m)
+		plain, err := m.Pack()
+		if err != nil {
+			fail(ht, "Pack: %v", err)
+		}
+		var ps struct {
+			Wire string `json:"wire"`
+		}
+		if err := py.call(t, map[string]any{"op": "tsig_sign", "wire": hex.EncodeToString(plain), "keyname": keyName, "secret": secret, "alg": alg, "fudge": int(fudge)}, &ps); err != nil {
+			fail(ht, "dnspython signing: %v\n%s", err, m.String())
+		}
+		pySigned, _ := hex.DecodeString(ps.Wire)
+		if err := dns.TsigVerify(append([]byte(nil), pySigned...), secret, "", false); err != nil {
+			fail(ht, "TsigVerify rejects a message signed by dnspython: %v\nkey %s alg %s\nwire %s\n%s", err, keyName, alg, ps.Wire, m.String())
+		}
+		var back2 dns.Msg
+		if err := back2.Unpack(pySigned); err != nil {
+			fail(ht, "Unpack of dnspython's signed message: %v\nwire %s", err, ps.Wire)
+		}
+		if back2.IsTsig() == nil {
+			fail(ht, "dnspython's signed message has no TSIG after Unpack")
+		}
+		back2.Extra = back2.Extra[:len(back2.Extra)-1]
+		if pyLosesBackslash(m) {
+			return // dnspython loses backslashes in URI targets and CAA values
+		}
+		want, _ := summarize(m)
+		// (dnspython compresses names case-insensitively, so letter case may change)
+		if got, err := summarize(&back2); err != nil || !reflect.DeepEqual(foldSummary(got), foldSummary(want)) {
+			fail(ht, "dnspython's signed message carries a different message (%v)\n%s", err, diffSummary(want, got))
+		}
+	})
+}
+
+// Zone files -------------------------------------------------------------------
+
+// genZone writes a zone in master file syntax: $TTL and $ORIGIN directives,
+// relative and absolute owners, @, blank owners, parentheses, comments, TTL
+// and class in either order or omitted.
+func genZone(tc hegel.TestCase, origin string) string {
+	var sb strings.Builder
+	fmt.Fprintf(&sb, "$TTL %s\n", pick(tc, "3600", "1h", "86400", "0"))
+	current := origin
+	havePrev := false
+	for i := n(tc, 0, 8); i > 0; i-- {
+		if chance(tc, 10) {
+			current = pick(tc, "sub", "Sub.a") + "." + origin
+			fmt.Fprintf(&sb, "$ORIGIN %s\n", current)
+			continue
+		}
+		if chance(tc, 10) {
+			sb.WriteString(pick(tc, "\n", "; a comment\n", "   ; indented comment\n"))
+		}
+		var owner string
+		switch n(tc, 0, 4) {
+		case 0:
+			owner = "@"
+		case 1:
+			owner = strings.ToLower(genHostName(tc)) + current
+			owner = strings.TrimSuffix(owner, ".") + "."
+		case 2:
+			owner = strings.TrimSuffix(genHostName(tc), ".") // relative
+		case 3:
+			owner = "" // the previous owner
+			if !havePrev {
+				owner = "@"
+			}
+		default:
+			owner = pick(tc, "www", "MAIL", "_tcp", "a.b")
+		}
+		typ := pick(tc, rrTypes...)
+		for typ == "SOA" || typ == "CNAME" || (typ == "IPSECKEY" && Known.ipseckeyEatsNewline) {
+			// dnspython's zone: SOA at the origin only, CNAME alone at its node
+			typ = pick(tc, rrTypes...)
+		}
+		rdata := genRdata(tc, typ)
+		// relative names in rdata for the name-bearing types
+		if chance(tc, 30) {
+			switch typ {
+			case "NS", "PTR", "DNAME":
+				rdata = pick(tc, "ns1", "@", "a.b", "Mail")
+			case "MX":
+				rdata = fmt.Sprintf("%d %s", u16(tc), pick(tc, "mail", "@", "mx.example"))
+			}
+		}
+		ttl := pick(tc, "", "", "3600", "1h", "0", "2147483647")
+		class := pick(tc, "", "", "IN")
+		var fields []string
+		if chance(tc, 50) {
+			fields = append(fields, ttl, class)
+		} else {
+			fields = append(fields, class, ttl)
+		}
+		line := owner
+		for _, f := range fields {
+			if f != "" {
+				line += " " + f
+			}
+		}
+		if owner == "" {
+			line = " " + line
+		}
+		line += " " + typ + " "
+		if chance(tc, 20) && strings.Count(rdata, " ") >= 2 && !strings.Contains(rdata, "\"") {
+			// parentheses around the rdata, split over lines with comments
+			parts := strings.SplitN(rdata, " ", 3)
+			comment := " ; first"
+			switch typ {
+			case "NSEC", "NSEC3", "CSYNC", "RRSIG":
+				if Known.parenCommentBreaksBitmap {
+					comment = ""
+				}
+			}
+			line += "( " + parts[0] + comment + "\n\t" + parts[1] + "\n\t" + parts[2] + " )"
+		} else {
+			line += rdata
+		}
+		if chance(tc, 15) {
+			line += " ; trailing comment"
+		}
+		sb.WriteString(line + "\n")
+		havePrev = true
+	}
+	return sb.String()
+}
+
+type rrsetKey struct {
+	Name  string
+	Type  uint16
+	Class uint16
+}
+
+type rrset struct {
+	TTL    uint32
+	Rdatas []string
+}
+
+// rrsets groups records the way dnspython's zone does: one TTL (the minimum)
+// per owner/type/class and no duplicate rdata.
+func rrsets(keys []rrKey) map[rrsetKey]rrset {
+	out := map[rrsetKey]rrset{}
+	for _, k := range keys {
+		sk := rrsetKey{foldHex(k.Name), k.Type, k.Class}
+		set, ok := out[sk]
+		if !ok || k.TTL < set.TTL {
+			set.TTL = k.TTL
+		}
+		dup := false
+		for _, r := range set.Rdatas {
+			if r == k.Rdata {
+				dup = true
+			}
+		}
+		if !dup {
+			set.Rdatas = append(set.Rdatas, k.Rdata)
+		}
+		sort.Strings(set.Rdatas)
+		out[sk] = set
+	}
+	return out
+}
+
+// foldHex lowercases the ASCII letters of hex-encoded bytes (dnspython's zone
+// keeps the first spelling of a name for all records at a node).
+func foldHex(h string) string {
+	b, err := hex.DecodeString(h)
+	if err != nil {
+		return h
+	}
+	for i, c := range b {
+		if c >= 'A' && c <= 'Z' {
+			b[i] = c + 'a' - 'A'
+		}
+	}
+	return hex.EncodeToString(b)
+}
+
+func fmtRRsets(m map[rrsetKey]rrset) string {
+	var lines []string
+	for k, v := range m {
+		lines = append(lines, fmt.Sprintf("  %s %d %d ttl %d %v", k.Name, k.Type, k.Class, v.TTL, v.Rdatas))
+	}
+	sort.Strings(lines)
+	return strings.Join(lines, "\n")
+}
+
+// TestHegelZoneParserAgreesWithDnspython: a generated zone file yields the
+// same records (per owner/type/class, with dnspython's rrset TTL and
+// duplicate rules) from NewZoneParser and from dnspython's zone reader, and
+// each record's owner is under the origin.
+func TestHegelZoneParserAgreesWithDnspython(t *testing.T) {
+	py := oracle(t)
+	property(t, func(ht *hegel.T) {
+		var tc hegel.TestCase = ht
+		origin := pick(tc, "example.com.", "Example.ORG.", "a.b.c.", "x.")
+		zone := genZone(tc, origin)
+		note(ht, "origin %s zone:\n%s", origin, zone)
+
+		var got []rrKey
+		zp := dns.NewZoneParser(strings.NewReader(zone), origin, "zone")
+		for rr, ok := zp.Next(); ok; rr, ok = zp.Next() {
+			got = append(got, rrKeyOf(rr))
+			if !dns.IsSubDomain(origin, rr.Header().Name) {
+				fail(ht, "record %s outside the origin %s\nzone:\n%s", rr.String(), origin, zone)
+			}
+		}
+		gerr := zp.Err()
+		var pz struct {
+			RRs []struct {
+				Name  string `json:"name"`
+				Type  int    `json:"type"`
+				Class int    `json:"class"`
+				TTL   uint32 `json:"ttl"`
+				Rdata string `json:"rdata"`
+				Text  string `json:"text"`
+			} `json:"rrs"`
+		}
+		perr := py.call(t, map[string]any{"op": "zone", "text": zone, "origin": origin}, &pz)
+		if gerr != nil && perr != nil {
+			note(ht, "both reject: go %v python %v", gerr, perr)
+			return
+		}
+		if gerr != nil {
+			fail(ht, "ZoneParser rejects a zone dnspython reads: %v\nzone:\n%s", gerr, zone)
+		}
+		if perr != nil {
+			fail(ht, "dnspython rejects a zone ZoneParser reads: %v\nzone:\n%s", perr, zone)
+		}
+		var want []rrKey
+		for _, r := range pz.RRs {
+			want = append(want, rrKey{Name: r.Name, Type: uint16(r.Type), Class: uint16(r.Class), TTL: r.TTL, Rdata: r.Rdata})
+		}
+		g, w := rrsets(got), rrsets(want)
+		if fmtRRsets(g) != fmtRRsets(w) {
+			fail(ht, "records differ\n go:\n%s\n python:\n%s\nzone:\n%s", fmtRRsets(g), fmtRRsets(w), zone)
+		}
+	})
+}
