diff --git a/hegel/hegel_zoo_const_test.go b/hegel/hegel_zoo_const_test.go
new file mode 100644
index 0000000..776d18d
--- /dev/null
+++ b/hegel/hegel_zoo_const_test.go
@@ -0,0 +1,127 @@
+package hegel
+
+// TestHegelConstValues: the constants of a file of const declarations (lone and grouped,
+// with iota, implicit repetition, comments and empty lines between them) have the same
+// values after gofumpt, as go/types evaluates them.
+
+import (
+	"fmt"
+	"go/ast"
+	"go/importer"
+	"go/parser"
+	"go/token"
+	"go/types"
+	"sort"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// hzGenConstFile generates a package of const (and a few var) declarations.
+func hzGenConstFile(g *hzGen) string {
+	g.b.Reset()
+	g.w("package p\n\n")
+	names := 0
+	fresh := func() string { names++; return fmt.Sprintf("k%d", names) }
+	value := func() string {
+		return g.pick("iota", "iota", "iota + 1", "iota * 2", "1 << iota", "3", "-1", "iota - 1", "len(\"ab\")", "1.5", "'a'", "\"s\"", "true", "iota == 2")
+	}
+	n := g.draw(1, 6)
+	prevConst, blank := false, false
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			blank = false
+			switch g.draw(1, 6) {
+			case 1:
+				g.w("\n")
+				blank = true
+			case 2:
+				g.w(g.lineComment() + "\n")
+			case 3:
+				g.w("\n" + g.lineComment() + "\n")
+				blank = true
+			}
+		}
+		kind := g.draw(1, 4)
+		if kind != 2 && prevConst && !blank && HZKnown.constIotaGrouped {
+			// Adjacent const declarations (a lone one after a lone one or a group) reach the
+			// recorded bug: an empty line breaks the chain.
+			hzAvoid("constIotaGrouped")
+			g.w("\n")
+		}
+		prevConst = kind != 2
+		switch kind {
+		case 1:
+			// A group with implicit repetition.
+			g.w("const (" + g.eol())
+			m := g.draw(1, 4)
+			for j := 0; j < m; j++ {
+				if j > 0 && g.chance(30) {
+					g.w("\n")
+				}
+				if j > 0 && g.chance(30) {
+					g.w("\t" + fresh() + g.eol())
+					continue
+				}
+				g.w("\t" + fresh() + " = " + value() + g.eol())
+			}
+			g.w(")" + g.eol())
+		case 2:
+			g.w("var " + fresh() + " = " + g.pick("1", "2.5", "\"v\"") + g.eol())
+		default:
+			g.w("const " + fresh() + " = " + value() + g.eol())
+		}
+	}
+	return g.b.String()
+}
+
+// hzConstValues type-checks the source and lists its package-level constants and their
+// values.
+func hzConstValues(src string) ([]string, error) {
+	fset := token.NewFileSet()
+	f, err := parser.ParseFile(fset, "p.go", src, parser.ParseComments)
+	if err != nil {
+		return nil, err
+	}
+	conf := types.Config{Importer: importer.Default()}
+	pkg, err := conf.Check("p", fset, []*ast.File{f}, nil)
+	if err != nil {
+		return nil, err
+	}
+	var out []string
+	for _, name := range pkg.Scope().Names() {
+		if c, ok := pkg.Scope().Lookup(name).(*types.Const); ok {
+			out = append(out, name+" = "+c.Val().ExactString())
+		}
+	}
+	sort.Strings(out)
+	return out, nil
+}
+
+func TestHegelConstValues(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		g := hzNewGen(ht)
+		src := hzGenConstFile(g)
+		want, err := hzConstValues(src)
+		if err != nil {
+			ht.Fatalf("the generated constants do not type-check: %v\n%s", err, src)
+		}
+		o := hzOptions(ht)
+		out, err, p := hzFumpt(src, o)
+		if p != nil || err != nil {
+			c.failClass(ht, "error", "gofumpt fails: %v %v\n%s\nsource:\n%s", p, err, hzOptString(o), src)
+			return
+		}
+		got, err := hzConstValues(out)
+		if err != nil {
+			c.failClass(ht, "invalid", "gofumpt's output does not type-check: %v\n%s\noutput:\n%s\nsource:\n%s", err, hzOptString(o), out, src)
+			return
+		}
+		if !hzEqStrings(want, got) {
+			c.failClass(ht, "values", "the constants change value\nsource: %v\noutput: %v\n%s\noutput:\n%s\nsource:\n%s", want, got, hzOptString(o), out, src)
+			return
+		}
+		c.count("ok")
+	})
+}
diff --git a/hegel/hegel_zoo_gen_test.go b/hegel/hegel_zoo_gen_test.go
new file mode 100644
index 0000000..c52eeec
--- /dev/null
+++ b/hegel/hegel_zoo_gen_test.go
@@ -0,0 +1,1616 @@
+package hegel
+
+// A generator of Go source files: declarations, statements and expressions of every kind the
+// syntax tree has, with comments (line, block, multi-line block, empty, directive-like,
+// non-ASCII) and blank lines at many of the places the grammar allows them, and the shapes
+// gofumpt's rules act on (a newline after an assignment operator, empty lines around bodies
+// and inside literals and field lists, single-spec var groups, adjacent lone declarations,
+// mixed import groups, multi-line case clauses, octal literals, comments without a space,
+// var statements, useless parentheses, gofmt -s shapes, naked returns). The text is fed to
+// gofumpt as it is or gofmt-formatted first.
+
+import (
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"regexp"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+)
+
+type hzGen struct {
+	tc            *hegel.T
+	b             strings.Builder
+	n             int      // comment counter
+	comments      []string // the comment texts emitted, in order
+	budget        int      // statements left to generate
+	labelN        int
+	fnN           int
+	hdr           bool // inside an if/for/switch header, where composite literals need parentheses
+	fieldList     int  // depth of parameter and result lists being generated
+	noCommentNext bool
+	forceMulti    bool   // the next call spreads its arguments over lines
+	caseMulti     bool   // the case list just written spans lines
+	caseTrail     bool   // the case list just written wants a trailing comment with trailing spaces
+	tail          string // a comment group the file ends with, right after the imports
+}
+
+func hzNewGen(tc *hegel.T) *hzGen {
+	return &hzGen{tc: tc, budget: hzDrawInt(tc, 3, 30)}
+}
+
+func (g *hzGen) w(s string) { g.b.WriteString(s) }
+
+func (g *hzGen) chance(pct int) bool { return hzChance(g.tc, pct) }
+
+func (g *hzGen) draw(lo, hi int) int { return hzDrawInt(g.tc, lo, hi) }
+
+func (g *hzGen) pick(xs ...string) string { return hzPick(g.tc, xs) }
+
+// text is the body of a fresh comment.
+func (g *hzGen) text() string {
+	g.n++
+	body := fmt.Sprintf("c%d", g.n)
+	switch g.draw(1, 12) {
+	case 1:
+		body += " " + string(rune(233)) + string(rune(0x4e2d)) // non-ASCII: e-acute, a CJK char
+	case 2:
+		body = "" // an empty comment
+	case 3:
+		body += " with a much longer text that runs on for a while to change the alignment"
+	case 4:
+		body += "\ttab" // a tab inside
+	case 5:
+		body = body + "  " // trailing spaces (gofmt strips them from line comments)
+	}
+	return body
+}
+
+// lineComment is a // comment (no newline).
+func (g *hzGen) lineComment() string {
+	t := g.text()
+	c := "//" + g.pick(" ", "", "  ", "\t") + t
+	if strings.TrimSpace(t) == "" {
+		c = "//"
+	}
+	if g.chance(15) {
+		c = g.pick("//go:noinline", "//nolint:all", "//lint:ignore SA1000 x", "//export F", "//#nosec G101", "//NOSONAR",
+			"//sys foo()", "//noinspection X", "//line a.go:1", "//x := 1", "//}", "//{", "//TODO: x", "//	code()", "//c.d", "//go-sumtype:decl T", "//extern f", "//nolintx", "//sysx", "//a:b", "//1st", "//!x")
+	}
+	g.comments = append(g.comments, c)
+	return c
+}
+
+// blockComment is a single-line /* */ comment.
+func (g *hzGen) blockComment() string {
+	c := "/*" + g.pick(" ", "") + g.text() + g.pick(" ", "") + "*/"
+	g.comments = append(g.comments, c)
+	return c
+}
+
+// multiComment is a /* */ comment spanning 2-3 lines (only where a newline is allowed).
+func (g *hzGen) multiComment(indent string) string {
+	lines := []string{"/* " + g.text()}
+	for i := g.draw(1, 2); i > 0; i-- {
+		lines = append(lines, indent+g.pick("", "   ", "\t")+g.text())
+	}
+	if g.chance(50) {
+		lines = append(lines, indent+"*/")
+	} else {
+		lines[len(lines)-1] += " */"
+	}
+	c := strings.Join(lines, "\n")
+	g.comments = append(g.comments, c)
+	return c
+}
+
+// sp is the space between two tokens on a line: sometimes with a block comment.
+func (g *hzGen) sp() string {
+	if g.chance(6) {
+		return g.pick(" ", "") + g.blockComment() + g.pick(" ", "")
+	}
+	return " "
+}
+
+// eol ends a line: sometimes with a trailing comment.
+func (g *hzGen) eol() string {
+	switch {
+	case g.chance(12):
+		return " " + g.lineComment() + "\n"
+	case g.chance(4):
+		return " " + g.blockComment() + "\n"
+	case g.chance(2):
+		return " " + g.blockComment() + " " + g.lineComment() + "\n"
+	}
+	return "\n"
+}
+
+// between goes between two items of a list of lines (statements, declarations, fields):
+// blank lines and whole-line comments.
+func (g *hzGen) between(indent string) {
+	for i := g.draw(0, 2); i > 0; i-- {
+		var piece string
+		switch g.draw(1, 10) {
+		case 1, 2, 3:
+			piece = "\n"
+		case 4, 5, 6:
+			piece = indent + g.lineComment() + "\n"
+		case 7:
+			piece = indent + g.blockComment() + "\n"
+		case 8:
+			piece = indent + g.multiComment(indent) + "\n"
+		case 9:
+			piece = indent + g.lineComment() + "\n" + indent + g.lineComment() + "\n"
+		case 10:
+			piece = "\n" + indent + g.lineComment() + "\n\n"
+		}
+		g.w(piece)
+	}
+}
+
+// --------------------------------------------------------------------------- expressions
+
+var hzIdents = []string{"a", "b", "c", "x", "y", "i", "n", "s", "ch", "err", "p", "m"}
+var hzTypeNames = []string{"int", "string", "bool", "byte", "T1", "T2", "error", "any", "float64", "rune"}
+
+func (g *hzGen) ident() string { return hzPick(g.tc, hzIdents) }
+
+func (g *hzGen) literal() string {
+	switch g.draw(1, 12) {
+	case 1:
+		return fmt.Sprint(g.draw(0, 1000))
+	case 2:
+		return g.pick("0x1F", "0o17", "0b1010", "1_000_000", "017", "0X_ff", "0755", "0_7", "00", "0", "0o_17", "0O17", "01_2")
+	case 3:
+		return g.pick("1.5", "1e9", ".5", "1.", "0x1p-2", "2.5e-3")
+	case 4:
+		return g.pick("2i", "1.5i", "0i")
+	case 5:
+		return g.pick("'a'", "'\\n'", "'\\x41'", "'\\u00e9'", "'\\''")
+	case 6:
+		return g.pick(`"s"`, `""`, `"tab\there"`, `"quote\"d"`, `"line\n"`, `"é"`)
+	case 7:
+		return "`raw`"
+	case 8:
+		return "`raw\nmulti\n\tline`"
+	case 9:
+		return g.pick("true", "false", "nil", "iota")
+	default:
+		return fmt.Sprint(g.draw(0, 9))
+	}
+}
+
+func (g *hzGen) typ(depth int) string {
+	if depth <= 0 || g.chance(40) {
+		return hzPick(g.tc, hzTypeNames)
+	}
+	switch g.draw(1, 12) {
+	case 1:
+		return "*" + g.sp0() + g.typ(depth-1)
+	case 2:
+		return "[]" + g.typ(depth-1)
+	case 3:
+		return "[" + g.sp0() + fmt.Sprint(g.draw(0, 5)) + g.sp0() + "]" + g.typ(depth-1)
+	case 4:
+		return "map[" + g.typ(depth-1) + "]" + g.typ(depth-1)
+	case 5:
+		return g.pick("chan ", "<-chan ", "chan<- ") + g.typ(depth-1)
+	case 6:
+		return "func(" + g.params(depth-1, false) + ")" + g.results(depth-1)
+	case 7:
+		return g.structType(depth-1, "\t")
+	case 8:
+		return g.ifaceType(depth-1, "\t")
+	case 9:
+		return "pkg." + g.pick("Type", "Reader")
+	case 10:
+		return g.pick("List", "Map") + "[" + g.typ(depth-1) + g.pick("", ", "+g.typ(depth-1)) + "]"
+	case 11:
+		return "(" + g.typ(depth-1) + ")"
+	default:
+		return hzPick(g.tc, hzTypeNames)
+	}
+}
+
+// sp0 is an optional inline comment with no surrounding space requirement.
+func (g *hzGen) sp0() string {
+	if g.chance(5) {
+		return " " + g.blockComment() + " "
+	}
+	return ""
+}
+
+func (g *hzGen) params(depth int, allowVariadic bool) string {
+	g.fieldList++
+	defer func() { g.fieldList-- }()
+	n := g.draw(0, 3)
+	if n == 0 {
+		return g.pick(g.sp0(), g.sp0(), "\n")
+	}
+	var ps []string
+	named := g.chance(60)
+	for i := 0; i < n; i++ {
+		t := g.typ(depth)
+		if allowVariadic && i == n-1 && g.chance(20) {
+			t = "..." + g.sp0() + t
+		}
+		if named {
+			names := g.ident()
+			if !strings.HasPrefix(t, "...") && g.chance(20) {
+				names += "," + g.sp() + g.ident()
+			}
+			if g.chance(10) {
+				t = g.pick("struct", "interface") + g.pick("", " ") + "{" + g.emptyBraces("") + "}"
+			}
+			for strings.HasPrefix(t, "(") && strings.HasSuffix(t, ")") && HZKnown.groupParamsCollapse {
+				// A parenthesised type reads the same as another only once the parentheses
+				// are gone (the group_params rule).
+				hzAvoid("groupParamsCollapse")
+				t = t[1 : len(t)-1]
+			}
+			if g.chance(8) {
+				// Two parameters of the same empty type, one of them written over lines (the
+				// group_params rule).
+				kind := g.pick("struct", "interface")
+				ps = append(ps, g.ident()+" "+kind+" {"+g.emptyBraces("")+"}", g.ident()+" "+kind+"{}")
+				continue
+			}
+			ps = append(ps, names+g.sp()+t)
+		} else {
+			ps = append(ps, t)
+		}
+	}
+	if g.chance(15) {
+		// One parameter per line.
+		return g.eol() + "\t" + strings.Join(ps, ","+g.eol()+"\t") + "," + g.eol()
+	}
+	if g.chance(10) {
+		// Split over lines, the closing parenthesis on the last one.
+		return strings.Join(ps, ","+g.eol()+"\t")
+	}
+	return strings.Join(ps, ","+g.sp())
+}
+
+func (g *hzGen) results(depth int) string {
+	g.fieldList++
+	defer func() { g.fieldList-- }()
+	switch g.draw(1, 5) {
+	case 1:
+		return ""
+	case 2:
+		return " " + g.typ(depth)
+	case 3:
+		return " (" + g.typ(depth) + "," + g.sp() + g.typ(depth) + ")"
+	case 4:
+		return " (" + g.ident() + " " + g.typ(depth) + "," + g.sp() + g.ident() + " " + g.typ(depth) + ")"
+	default:
+		return " (" + g.ident() + " " + g.typ(depth) + ")"
+	}
+}
+
+func (g *hzGen) structType(depth int, indent string) string {
+	n := g.draw(0, 3)
+	if n == 0 {
+		return "struct" + g.pick("", " ") + "{" + g.emptyBraces(indent) + "}"
+	}
+	var sb strings.Builder
+	sb.WriteString("struct" + g.sp0() + "{" + g.eol())
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			g.betweenTo(&sb, indent+"\t")
+		}
+		sb.WriteString(indent + "\t")
+		switch g.draw(1, 5) {
+		case 1:
+			sb.WriteString(g.typ(0)) // embedded
+		case 2:
+			sb.WriteString(g.ident() + "," + g.sp() + g.ident() + " " + g.typ(depth))
+		case 3:
+			sb.WriteString(g.ident() + " " + g.typ(depth) + " `json:\"" + g.ident() + "\"`")
+		default:
+			sb.WriteString(g.ident() + g.sp() + g.typ(depth))
+		}
+		sb.WriteString(g.eol())
+	}
+	sb.WriteString(indent + "}")
+	return sb.String()
+}
+
+func (g *hzGen) ifaceType(depth int, indent string) string {
+	n := g.draw(0, 3)
+	if n == 0 {
+		return "interface" + g.pick("", " ") + "{" + g.emptyBraces(indent) + "}"
+	}
+	var sb strings.Builder
+	sb.WriteString("interface" + g.sp0() + "{" + g.eol())
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			g.betweenTo(&sb, indent+"\t")
+		}
+		sb.WriteString(indent + "\t")
+		switch g.draw(1, 4) {
+		case 1:
+			sb.WriteString(g.pick("fmt.Stringer", "T1", "comparable"))
+		case 2:
+			sb.WriteString(g.pick("~int", "int | string", "~int | ~string"))
+		default:
+			sb.WriteString("M" + fmt.Sprint(g.draw(1, 3)) + "(" + g.params(depth, false) + ")" + g.results(depth))
+		}
+		sb.WriteString(g.eol())
+	}
+	sb.WriteString(indent + "}")
+	return sb.String()
+}
+
+// emptyBraces is the inside of an empty struct or interface type: nothing, a comment or
+// newlines. In a parameter or result list a comment reaches the recorded bug (and in some
+// shapes makes even gofmt unstable: gofmt's business, and hzInput skips those files).
+func (g *hzGen) emptyBraces(indent string) string {
+	s := g.pick(g.sp0(), g.sp0(), "\n"+indent, "\n\n"+indent, " "+g.blockComment()+" ")
+	if g.fieldList > 0 && strings.Contains(s, "/*") && HZKnown.emptyTypeCommentFieldList {
+		hzAvoid("emptyTypeCommentFieldList")
+		return ""
+	}
+	if g.fieldList > 0 && strings.Contains(s, "\n") && HZKnown.groupParamsCollapse {
+		// An empty type over two lines in a parameter list reaches the recorded bug (with
+		// group_params).
+		hzAvoid("groupParamsCollapse")
+		return ""
+	}
+	return s
+}
+
+// lastLine is the last line of the text so far (the line before the cursor when the text
+// ends in a newline).
+func (g *hzGen) lastLine() string {
+	s := strings.TrimSuffix(g.b.String(), "\n")
+	if i := strings.LastIndex(s, "\n"); i >= 0 {
+		return s[i+1:]
+	}
+	return s
+}
+
+// prevLine is the line before the one being written (the text ends in an indentation).
+func (g *hzGen) prevLine() string {
+	s := g.b.String()
+	i := strings.LastIndex(s, "\n")
+	if i < 0 {
+		return ""
+	}
+	s = s[:i]
+	if j := strings.LastIndex(s, "\n"); j >= 0 {
+		return s[j+1:]
+	}
+	return s
+}
+
+// blankBeforeLine inserts an empty line before the line being written.
+func (g *hzGen) blankBeforeLine() {
+	s := g.b.String()
+	i := strings.LastIndex(s, "\n")
+	g.b.Reset()
+	g.w(s[:i+1] + "\n" + s[i+1:])
+}
+
+// betweenTo is between() into another builder.
+func (g *hzGen) betweenTo(sb *strings.Builder, indent string) {
+	saved := g.b
+	g.b = strings.Builder{}
+	g.between(indent)
+	sb.WriteString(g.b.String())
+	g.b = saved
+}
+
+func (g *hzGen) expr(depth int) string {
+	if depth <= 0 || g.chance(30) {
+		if g.chance(50) {
+			return g.ident()
+		}
+		return g.literal()
+	}
+	switch g.draw(1, 20) {
+	case 1, 2:
+		op := g.pick("+", "-", "*", "/", "%", "==", "!=", "<", "<=", "&&", "||", "&", "|", "^", "<<", ">>", "&^")
+		right := g.sp()
+		if op == "/" {
+			right = " " // a block comment right after / would start a line comment
+		}
+		return g.expr(depth-1) + g.sp() + op + right + g.expr(depth-1)
+	case 3:
+		// A space after the operator: &^x or - -x would lex differently.
+		return g.pick("-", "!", "^", "&", "*", "<-", "+") + g.sp0() + " " + g.expr(depth-1)
+	case 4, 5:
+		return g.call(depth - 1)
+	case 6:
+		base := g.expr(depth - 1)
+		if !hzIdentStart(base) {
+			base = "(" + base + ")" // 0.Field would lex as the float 0., -0.Field too
+		}
+		return base + g.sp0() + "." + g.sp0() + g.pick("Field", "Method", "x")
+	case 7:
+		return g.expr(depth-1) + "[" + g.sp0() + g.expr(depth-1) + g.sp0() + "]"
+	case 8:
+		lo, hi := g.pick("", g.expr(depth-1)), g.pick("", g.expr(depth-1))
+		s := g.expr(depth-1) + "[" + lo + g.sp0() + ":" + hi
+		if hi != "" && g.chance(30) {
+			s += ":" + g.expr(depth-1)
+		}
+		return s + "]"
+	case 9:
+		base := g.expr(depth - 1)
+		if !hzIdentStart(base) {
+			base = "(" + base + ")" // 0x1F.(T) would lex as a hexadecimal float
+		}
+		return base + ".(" + g.sp0() + g.typ(1) + ")"
+	case 10, 11:
+		if g.hdr {
+			return "(" + g.composite(depth-1) + ")"
+		}
+		return g.composite(depth - 1)
+	case 12:
+		return g.funcLit(depth - 1)
+	case 13:
+		if g.chance(30) {
+			return "((" + g.sp0() + g.expr(depth-1) + "))"
+		}
+		return "(" + g.sp0() + g.expr(depth-1) + g.sp0() + ")"
+	case 17:
+		return g.pick("(a)", "(f)()", "(a.b).c", "(-x)", "(*p)", "(T1{}).x", "(s{}.Foo())", "(<-ch)", "(x[1])", "(f(2))", "(x.(T1))", "([]int{1})[0]", "((a) + (b))", "(F[int])(x)", "x[(1):(2)]", "f((3))", "(x).f()", "((*p).y)")
+	case 18:
+		return g.pick("s[a:len(s)]", "s[:len(s)]", "s[1:len(x)]", "s.x[a:len(s.x)]", "[]T1{T1{1}}", "[]*T1{&T1{}}", "map[string]T1{\"a\": T1{}}", "[][]int{[]int{1}, []int{2}}", "map[T1]T1{T1{}: T1{}}", "[]any{T1{}}", "[2]T1{T1{}, {}}")
+	case 14:
+		ct := g.typ(1)
+		if strings.HasPrefix(ct, "func") || strings.HasPrefix(ct, "chan") || strings.HasPrefix(ct, "<-") || strings.HasPrefix(ct, "*") {
+			ct = "(" + ct + ")" // func()(x) would parse as a signature
+		}
+		return ct + "(" + g.expr(depth-1) + ")"
+	case 15:
+		return g.pick("F", "G", "Map") + "[" + g.typ(1) + g.pick("", ", "+g.typ(1)) + "](" + g.expr(depth-1) + ")"
+	case 16:
+		if g.hdr {
+			return "(struct{ A int }{" + g.expr(depth-1) + "})"
+		}
+		return "struct{ A int }{" + g.expr(depth-1) + "}"
+	default:
+		return g.call(depth - 1)
+	}
+}
+
+var hzIdentRe = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
+
+// hzIdentStart: the text is a plain identifier, so a . or .( may follow it (a + 0.Field or
+// 0x1F.(T) would lex differently).
+func hzIdentStart(s string) bool { return hzIdentRe.MatchString(s) }
+
+func (g *hzGen) call(depth int) string { return g.callWith(depth, false) }
+
+// callWith generates a call; named keeps the function a plain name (go and defer statements
+// need a call, not a parenthesised one).
+func (g *hzGen) callWith(depth int, named bool) string {
+	fn := g.pick("f", "g.m", "x.y.z", "fmt.Println", "make", "len", "append", "new", "panic")
+	if !named && g.chance(15) {
+		fn = g.expr(depth)
+	}
+	n := g.draw(0, 3)
+	if g.forceMulti {
+		n = g.draw(1, 3)
+	}
+	var args []string
+	for i := 0; i < n; i++ {
+		args = append(args, g.expr(depth))
+	}
+	if fn == "make" || fn == "new" {
+		args = append([]string{g.typ(1)}, args...)
+	}
+	s := fn + g.sp0() + "("
+	if n > 0 && (g.forceMulti || g.chance(15)) {
+		g.forceMulti = false
+		// Arguments one per line.
+		s += g.eol() + "\t\t" + strings.Join(args, ","+g.eol()+"\t\t") + ","
+		if g.chance(30) {
+			s = strings.TrimSuffix(s, ",") + g.sp0() + "..." + "," // the last argument is variadic
+			args[len(args)-1] = g.ident()
+			s = fn + g.sp0() + "(" + g.eol() + "\t\t" + strings.Join(args, ","+g.eol()+"\t\t") + g.sp0() + "...,"
+		}
+		if g.chance(25) {
+			// The closing parenthesis on the last argument's line.
+			return strings.TrimSuffix(s, ",") + ")"
+		}
+		if g.chance(20) {
+			// The first argument on the opening line, the rest on their own lines.
+			return fn + "(" + strings.Join(args, ","+g.eol()+"\t\t") + g.pick("", ","+g.eol()+"\t") + ")"
+		}
+		return s + g.eol() + "\t)"
+	}
+	if n > 0 && g.chance(15) {
+		args[len(args)-1] = g.ident() + g.sp0() + "..." // a variadic call (never after a literal: 0... lexes as 0.)
+	}
+	s += g.sp0() + strings.Join(args, ","+g.sp())
+	return s + g.sp0() + ")"
+}
+
+func (g *hzGen) composite(depth int) string {
+	t := g.pick("T1", "[]int", "map[string]int", "[...]string", "[]T2", "struct{ A, B int }", "&T1", "pkg.T", "[]T1", "[]*T1", "map[string]T1", "[2][]int", "map[T1]T1")
+	n := g.draw(0, 3)
+	var elts []string
+	for i := 0; i < n; i++ {
+		e := g.expr(depth)
+		switch g.draw(1, 4) {
+		case 1:
+			e = g.ident() + g.sp0() + ":" + g.sp() + e
+		case 2:
+			e = g.literal() + ":" + g.sp() + e
+		case 3:
+			if g.chance(50) {
+				e = "{" + e + "}" // a nested elided-type literal
+			} else {
+				e = g.pick("T1", "&T1", "[]int", "T2", "pkg.T") + "{" + e + "}" // gofmt -s may elide the type
+			}
+		}
+		elts = append(elts, e)
+	}
+	if n > 0 && g.chance(35) {
+		switch g.draw(1, 4) {
+		case 1:
+			// Newlines between some elements only, none around.
+			return t + "{" + elts[0] + "," + g.eol() + "\t\t" + strings.Join(elts[1:], ", ") + "}"
+		case 2:
+			// Empty lines around the elements.
+			return t + "{" + g.eol() + "\n\t\t" + strings.Join(elts, ","+g.eol()+"\t\t") + "," + g.eol() + "\n\t}"
+		}
+		return t + "{" + g.eol() + "\t\t" + strings.Join(elts, ","+g.eol()+"\t\t") + "," + g.eol() + "\t}"
+	}
+	if n == 0 {
+		return t + "{" + g.sp0() + "}"
+	}
+	return t + "{" + g.sp0() + strings.Join(elts, ","+g.sp()) + g.sp0() + "}"
+}
+
+func (g *hzGen) funcLit(depth int) string {
+	s := "func" + g.sp0() + "(" + g.params(1, true) + ")" + g.results(1) + g.sp() + "{"
+	saved := g.b
+	g.b = strings.Builder{}
+	g.body(depth, "\t\t")
+	s += g.b.String()
+	g.b = saved
+	return s + "\t}"
+}
+
+// --------------------------------------------------------------------------- statements
+
+// body writes the inside of a block after its "{" (through the closing indentation, not the
+// "}").
+func (g *hzGen) body(depth int, indent string) {
+	g.w(g.eol())
+	n := g.draw(0, 4)
+	if depth <= 0 || g.budget <= 0 {
+		n = g.draw(0, 1)
+	}
+	if n == 0 && g.chance(40) {
+		g.between(indent)
+	}
+	for i := 0; i < n; i++ {
+		if i > 0 || g.chance(30) {
+			g.noCommentNext = false // a statement follows: harmless
+			g.between(indent)
+		}
+		g.stmt(depth-1, indent)
+	}
+	if g.budget > 0 && g.chance(8) {
+		// A multi-result return whose first result spans lines, closing the block.
+		g.budget--
+		g.noCommentNext = false
+		g.between(indent)
+		g.forceMulti = true
+		prefix := g.pick("", "- ", "(")
+		first := prefix + g.callWith(depth, false)
+		if prefix == "(" {
+			first += ")"
+		}
+		g.forceMulti = false
+		g.w(indent + "return" + g.sp() + first + "," + g.sp() + g.expr(0) + g.eol())
+		g.noCommentNext = true
+	}
+	if g.chance(10) || (g.noCommentNext && g.chance(60)) {
+		g.between(indent)
+	}
+	g.noCommentNext = false
+	g.w(indent[:len(indent)-1])
+}
+
+// block writes "{ body }" (no trailing newline).
+func (g *hzGen) block(depth int, indent string) {
+	g.w("{")
+	g.body(depth, indent+"\t")
+	g.w("}")
+}
+
+// opNL is the space after an assignment operator: sometimes a newline (gofumpt joins it).
+func (g *hzGen) opNL() string {
+	if g.chance(15) {
+		return g.eol() + "\t\t"
+	}
+	return g.sp()
+}
+
+func (g *hzGen) simpleStmt(depth int) string {
+	switch g.draw(1, 7) {
+	case 7:
+		// The shapes of the error-check rule.
+		return g.ident() + ", err" + g.sp() + g.pick(":=", "=") + g.sp() + g.call(depth)
+	case 1:
+		return g.ident() + g.sp() + ":=" + g.opNL() + g.expr(depth)
+	case 2:
+		return g.ident() + "," + g.sp() + g.ident() + g.sp() + g.pick(":=", "=") + g.sp() + g.expr(depth) + "," + g.sp() + g.expr(depth)
+	case 3:
+		return g.ident() + g.sp() + g.pick("+=", "-=", "*=", "<<=", "&^=", "=") + g.opNL() + g.expr(depth)
+	case 4:
+		return g.ident() + g.sp0() + g.pick("++", "--")
+	case 5:
+		return g.ident() + g.sp() + "<-" + g.sp() + g.expr(depth)
+	default:
+		return g.call(depth)
+	}
+}
+
+func (g *hzGen) stmt(depth int, indent string) {
+	g.budget--
+	g.noCommentNext = false
+	g.w(indent)
+	switch g.draw(1, 22) {
+	case 1, 2, 3:
+		g.w(g.simpleStmt(depth) + g.eol())
+	case 4:
+		switch g.draw(1, 4) {
+		case 1:
+			g.w("var" + g.sp() + g.ident() + g.sp() + g.typ(1) + g.pick("", g.sp()+"="+g.sp()+g.expr(depth)) + g.eol())
+		case 2, 3:
+			// A var statement (gofumpt makes it a short assignment).
+			head := "var" + g.sp() + g.pick(g.ident(), "_") + g.sp() + "="
+			if g.draw(1, 2) == 2 {
+				head = "var" + g.sp() + g.ident() + ", " + g.pick(g.ident(), "_") + g.sp() + "="
+			}
+			nl := g.opNL()
+			if strings.Contains(nl, "\n") && (strings.Contains(head+nl, "//") || strings.Contains(head+nl, "/*")) && HZKnown.varCommentContinuation {
+				// A comment before the value on the next line reaches the recorded bug: join
+				// the lines.
+				hzAvoid("varCommentContinuation")
+				head, nl = "var "+g.ident()+" =", " "
+			}
+			s := head + nl + g.expr(depth)
+			if strings.Contains(head, ", ") {
+				s += ", " + g.expr(depth)
+			}
+			g.w(s + g.eol())
+		default:
+			// A one-spec var group (gofumpt makes it a short assignment).
+			eol := g.eol()
+			if eol != "\n" && HZKnown.varGroupCommentBlankLine {
+				// A trailing comment on the spec reaches the recorded bug when the group ends the
+				// block.
+				hzAvoid("varGroupCommentBlankLine")
+				eol = "\n"
+			}
+			if HZKnown.varGroupCommentBlankLine && hzCommentAbove(g.prevLine()) {
+				hzAvoid("varGroupCommentBlankLine") // so does a comment on the line above
+				g.blankBeforeLine()
+			}
+			g.w("var" + g.sp() + "(" + g.eol() + indent + "\t" + g.ident() + " = " + g.expr(depth) + eol + indent + ")" + g.eol())
+		}
+	case 5:
+		kw := g.pick("var", "const")
+		n := g.draw(0, 4)
+		if kw == "var" && g.chance(40) {
+			n = 1 // the one-spec var group gofumpt unwraps
+		}
+		noComments := kw == "var" && n == 1 && HZKnown.varGroupCommentBlankLine
+		if noComments {
+			// A comment on the spec of a one-spec var group, or on the line above the group,
+			// reaches the recorded bug when the group ends the block.
+			hzAvoid("varGroupCommentBlankLine")
+			if hzCommentAbove(g.prevLine()) {
+				g.blankBeforeLine()
+			}
+		}
+		g.w(kw + g.sp() + "(")
+		open := g.eol()
+		if noComments {
+			open = "\n"
+		}
+		g.specList(depth, indent+"\t", kw == "const", n, open, noComments)
+		g.w(indent + ")" + g.eol())
+	case 6:
+		g.w("type" + g.sp() + g.pick("T3", "T4") + g.sp() + g.pick("", "= ") + g.typ(2) + g.eol())
+	case 7, 8:
+		if g.chance(25) {
+			g.w(g.ident() + ", err := " + g.call(depth) + g.eol() + g.pick("", "\n", "\n\n") + indent + "if err != nil" + g.sp() + "{" + g.eol() + indent + "\treturn" + g.eol() + indent + "}" + g.eol())
+			return
+		}
+		g.w("if" + g.sp())
+		g.hdr = true
+		if g.chance(30) {
+			g.w(g.simpleStmt(depth) + ";" + g.sp())
+		}
+		g.w(g.expr(depth) + g.sp())
+		g.hdr = false
+		g.block(depth, indent)
+		for i := 0; i < 2 && g.chance(30); i++ {
+			g.hdr = true
+			g.w(g.sp() + "else" + g.sp() + "if" + g.sp() + g.expr(depth) + g.sp())
+			g.hdr = false
+			g.block(depth, indent)
+		}
+		if g.chance(40) {
+			g.w(g.sp() + "else" + g.sp())
+			g.block(depth, indent)
+		}
+		g.w(g.eol())
+	case 9, 10:
+		g.w("for" + g.sp())
+		g.hdr = true
+		switch g.draw(1, 6) {
+		case 1:
+		case 2:
+			g.w(g.expr(depth) + g.sp())
+		case 3:
+			g.w(g.ident() + " := 0;" + g.sp() + g.ident() + " < " + g.expr(depth) + ";" + g.sp() + g.ident() + "++" + g.sp())
+		case 4:
+			g.w(g.pick(";;", "; "+g.expr(depth)+";", "i := 0; ; i++") + g.sp())
+		case 5:
+			g.w(g.pick(g.ident(), g.ident()+", "+g.ident(), g.ident()+", _", "_, "+g.ident(), "_", "_, _") + g.sp() + g.pick(":=", "=") + g.sp() + "range" + g.sp() + g.expr(depth) + g.sp())
+		default:
+			g.w("range" + g.sp() + g.expr(depth) + g.sp())
+		}
+		g.hdr = false
+		g.block(depth, indent)
+		g.w(g.eol())
+	case 11:
+		g.switchStmt(depth, indent)
+	case 12:
+		g.selectStmt(depth, indent)
+	case 13:
+		switch g.draw(1, 4) {
+		case 1:
+			g.w("return" + g.eol())
+		case 2:
+			g.w("return" + g.sp() + g.expr(depth) + g.eol())
+		default:
+			first := g.expr(depth)
+			results := first + "," + g.sp() + g.expr(depth)
+			g.w("return" + g.sp() + results + g.eol())
+			g.noCommentNext = strings.Contains(results, "\n")
+		}
+	case 14:
+		g.w(g.pick("go", "defer") + g.sp() + g.callWith(depth, true) + g.eol())
+	case 15:
+		g.labelN++
+		l := fmt.Sprintf("L%d", g.labelN)
+		g.w(l + g.sp0() + ":" + g.pick(g.eol()+indent, g.sp()))
+		if g.chance(50) {
+			g.w("for" + g.sp())
+			g.block(depth, indent)
+			g.w(g.eol())
+		} else {
+			g.w(g.simpleStmt(depth) + g.eol())
+		}
+		if g.chance(50) {
+			g.between(indent)
+			g.w(indent + g.pick("goto", "break", "continue") + g.sp() + l + g.eol())
+		}
+	case 16:
+		g.w(g.pick("break", "continue", "fallthrough") + g.eol())
+	case 17:
+		g.block(depth, indent)
+		g.w(g.eol())
+	case 18:
+		g.w(g.pick("<-ch", "<-"+g.expr(depth)) + g.eol())
+	case 19:
+		g.w(g.pick("F", "F", "x.f") + g.sp0() + "(" + g.sp0() + ")" + g.sp0() + "(" + g.sp0() + ")" + g.eol())
+	default:
+		g.w(g.simpleStmt(depth) + g.eol())
+	}
+}
+
+// groupEnd ends the ")" line of a declaration group: an empty group gets no trailing comment,
+// since gofmt -s removes the group and the comment becomes the next declaration's doc comment
+// (with a directive among them gofmt -s itself is then not idempotent: gofmt's business).
+func (g *hzGen) groupEnd(empty bool) string {
+	if empty {
+		return "\n"
+	}
+	return g.eol()
+}
+
+// emptyGroupGap separates an empty declaration group from a comment line before it, which
+// would otherwise be its doc comment: gofmt -s keeps the group for the comment's sake, and
+// when go/printer drops the comment (an empty //) the group goes in the second run (gofmt's
+// business).
+func (g *hzGen) emptyGroupGap(empty bool) {
+	if empty && hzIsCommentLine(g.lastLine()) {
+		g.w("\n")
+	}
+}
+
+// specList writes n specs of a grouped var/const/type declaration after "(", through the
+// closing indentation; open ends the "(" line, and noComments keeps comments and empty
+// lines out of the group.
+func (g *hzGen) specList(depth int, indent string, isConst bool, n int, open string, noComments bool) {
+	g.w(open)
+	if n == 0 && g.chance(50) && !noComments {
+		g.between(indent)
+	}
+	for i := 0; i < n; i++ {
+		if (i > 0 || g.chance(20)) && !noComments {
+			g.between(indent)
+		}
+		if n == 1 && !noComments && g.chance(40) {
+			g.w(indent + g.lineComment() + "\n") // a doc comment on the only spec
+		}
+		var spec string
+		switch g.draw(1, 5) {
+		case 5:
+			spec = g.ident() + g.sp() + "=" + g.sp() + "`raw\nmulti\n\tline`" // a multi-line raw string value
+		case 1:
+			if isConst {
+				spec = g.ident() // a repeated const expression
+			} else {
+				spec = g.ident() + g.sp() + g.typ(1)
+			}
+		case 2:
+			spec = g.ident() + g.sp() + g.typ(1)
+		case 3:
+			spec = g.ident() + g.sp() + "=" + g.sp() + g.expr(depth)
+		default:
+			spec = g.ident() + "," + g.sp() + g.ident() + g.sp() + g.typ(1) + g.sp() + "=" + g.sp() + g.expr(depth) + "," + g.sp() + g.expr(depth)
+		}
+		eol := g.eol()
+		if noComments {
+			eol = "\n"
+		}
+		g.w(indent + spec + eol)
+	}
+	g.w(indent[:len(indent)-1])
+}
+
+func (g *hzGen) switchStmt(depth int, indent string) {
+	g.w("switch" + g.sp())
+	typeSwitch := g.chance(30)
+	g.hdr = true
+	if g.chance(30) {
+		g.w(g.simpleStmt(depth) + ";" + g.sp())
+	}
+	if typeSwitch {
+		g.w(g.pick("", g.ident()+" := ") + g.pick(g.ident(), g.ident()+"."+g.ident(), g.callWith(depth, true)) + ".(type)" + g.sp())
+	} else if g.chance(70) {
+		g.w(g.expr(depth) + g.sp())
+	}
+	g.hdr = false
+	g.w("{" + g.eol())
+	n := g.draw(0, 3)
+	if n == 0 && g.chance(50) {
+		g.between(indent)
+	}
+	for i := 0; i < n; i++ {
+		if g.chance(25) {
+			g.between(indent)
+		}
+		g.w(indent)
+		if i == n-1 && g.chance(40) {
+			g.w("default" + g.sp0() + ":")
+		} else if typeSwitch {
+			g.w("case" + g.sp() + g.typ(1) + g.pick("", ","+g.sp()+g.typ(1), ", nil") + g.sp0() + ":")
+		} else if g.chance(30) {
+			// A case list spanning lines (gofumpt puts a short one on one line).
+			exprs := []string{g.expr(depth), g.expr(depth)}
+			if g.chance(50) {
+				exprs = append(exprs, g.expr(depth))
+			}
+			if g.chance(25) {
+				// Directed: a list whose length is around gofumpt's short-line limit, with a
+				// trailing comment (spaces after it count for the limit in the first run only).
+				exprs = []string{strings.Repeat("y", g.draw(12, 48)), g.ident()}
+				g.caseTrail = true
+			}
+			multi := true
+			for _, e := range exprs {
+				if HZKnown.caseListLengthCollapse && (strings.ContainsAny(e, "({\n") || hzOctalLit.MatchString(e)) {
+					// An expression gofumpt or go/printer may shorten (parentheses removed, a
+					// two-line type or literal on one line) or lengthen (0o) changes the length
+					// gofumpt measures in the second run.
+					hzAvoid("caseListLengthCollapse")
+					multi = false
+				}
+			}
+			sep := "," + g.sp()
+			if multi {
+				sep = "," + g.eol() + indent + "\t"
+			}
+			g.w("case" + g.sp() + strings.Join(exprs, sep) + g.sp0() + ":")
+			g.caseMulti = multi
+		} else {
+			g.w("case" + g.sp() + g.expr(depth) + g.pick("", ","+g.sp()+g.expr(depth)) + g.sp0() + ":")
+		}
+		g.caseBody(depth, indent+"\t")
+	}
+	if g.chance(15) {
+		g.between(indent)
+	}
+	g.w(indent + "}" + g.eol())
+}
+
+// caseBody writes the statements of a case clause after the colon.
+func (g *hzGen) caseBody(depth int, indent string) {
+	eol := g.eol()
+	if g.caseTrail {
+		eol = " " + g.lineComment() + g.pick("  ", " ", "\t") + "\n"
+	}
+	g.caseTrail = false
+	if g.caseMulti && HZKnown.caseListLengthCollapse {
+		// Trailing spaces in the comment after the colon count for the length gofumpt measures
+		// in the first run only.
+		if trimmed := strings.TrimRight(eol, " \n") + "\n"; trimmed != eol {
+			hzAvoid("caseListLengthCollapse")
+			eol = trimmed
+		}
+	}
+	g.caseMulti = false
+	g.w(eol)
+	n := g.draw(0, 3)
+	if depth <= 0 || g.budget <= 0 {
+		n = g.draw(0, 1)
+	}
+	if n == 0 && g.chance(40) {
+		g.between(indent)
+	}
+	for i := 0; i < n; i++ {
+		if i > 0 || g.chance(30) {
+			g.noCommentNext = false // a statement follows: harmless
+			g.between(indent)
+		}
+		g.stmt(depth-1, indent)
+	}
+	if g.noCommentNext && g.chance(60) {
+		g.between(indent)
+	}
+	g.noCommentNext = false
+}
+
+func (g *hzGen) selectStmt(depth int, indent string) {
+	g.w("select" + g.sp() + "{" + g.eol())
+	n := g.draw(0, 3)
+	if n == 0 && g.chance(50) {
+		g.between(indent)
+	}
+	for i := 0; i < n; i++ {
+		if g.chance(25) {
+			g.between(indent)
+		}
+		g.w(indent)
+		switch g.draw(1, 5) {
+		case 1:
+			g.w("default" + g.sp0() + ":")
+		case 2:
+			g.w("case" + g.sp() + g.ident() + g.sp() + "<-" + g.sp() + g.expr(depth) + g.sp0() + ":")
+		case 3:
+			g.w("case" + g.sp() + g.ident() + g.pick("", ", ok") + g.sp() + g.pick(":=", "=") + g.sp() + "<-" + g.sp0() + g.ident() + g.sp0() + ":")
+		default:
+			g.w("case" + g.sp() + "<-" + g.sp0() + g.ident() + g.sp0() + ":")
+		}
+		g.caseBody(depth, indent+"\t")
+	}
+	g.w(indent + "}" + g.eol())
+}
+
+// --------------------------------------------------------------------------- declarations
+
+func (g *hzGen) decl() {
+	switch g.draw(1, 10) {
+	case 1:
+		if g.chance(40) {
+			// A call split after its parenthesis (the balance_calls rule), often with a
+			// trailing comment.
+			g.w("var " + g.ident() + " = " + g.ident() + "(\n\t" + g.expr(1) + g.pick("", ", "+g.expr(1)) + ")" + g.pick(g.eol(), " "+g.lineComment()+"\n"))
+			return
+		}
+		g.w("var" + g.sp() + g.ident() + g.sp() + g.pick(g.typ(2), "= "+g.expr(2), g.typ(1)+" = "+g.expr(2), "="+g.eol()+"\t"+g.expr(2)) + g.eol())
+	case 2:
+		kw := g.pick("var", "const")
+		n := g.draw(0, 4)
+		g.emptyGroupGap(n == 0)
+		sp, open, closing := g.sp(), g.eol(), g.groupEnd(n == 0)
+		noComments := kw == "var" && n == 1 && HZKnown.varGroupCommentDoc
+		if noComments {
+			// A comment anywhere around the spec of a one-spec var group (before the
+			// parenthesis, on its line, above the spec, after the closing parenthesis) reaches
+			// the recorded bug.
+			hzAvoid("varGroupCommentDoc")
+			sp, open, closing = " ", "\n", "\n"
+		}
+		g.w(kw + sp + "(")
+		g.specList(2, "\t", kw == "const", n, open, noComments)
+		g.w(")" + closing)
+	case 6:
+		// Lone declarations of one kind in a row (gofumpt groups them), sometimes with doc
+		// comments.
+		kw := g.pick("var", "const")
+		for i, n := 0, g.draw(2, 3); i < n; i++ {
+			if g.chance(30) {
+				// A doc comment, often a third-party directive (which keeps the declaration
+				// out of the group).
+				g.w(g.pick(g.lineComment(), g.lineComment(), "//noinspection X", "//#nosec G101", "//NOSONAR", "//sys foo()", "//nolint") + "\n")
+			}
+			value := g.expr(1)
+			if i == 0 && g.chance(40) {
+				// A value over two lines that go/printer puts on one, on the first declaration.
+				value = g.pick("struct {\n}{}", "[]int{\n}", "interface {\n}(nil)", "len([1]int{\n})", "map[string]int{\n}")
+			}
+			g.w(kw + " " + g.ident() + " = " + value + g.eol())
+		}
+	case 3:
+		g.w("const" + g.sp() + g.ident() + g.sp() + "=" + g.sp() + g.expr(2) + g.eol())
+	case 4:
+		g.w("type" + g.sp() + g.pick("T1", "T2") + g.pick("", "[T any]", "[K comparable, V any]") + g.sp() + g.pick("", "= ") + g.typ(3) + g.eol())
+	case 5:
+		n := g.draw(0, 3)
+		g.emptyGroupGap(n == 0)
+		g.w("type" + g.sp() + "(")
+		g.w(g.eol())
+		for i := 0; i < n; i++ {
+			g.between("\t")
+			g.w("\t" + g.pick("T1", "T2", "T3") + g.sp() + g.typ(2) + g.eol())
+		}
+		g.w(")" + g.groupEnd(n == 0))
+	default:
+		g.funcDecl()
+	}
+}
+
+func (g *hzGen) funcDecl() {
+	g.fnN++
+	g.w("func" + g.sp())
+	if g.chance(30) {
+		g.w("(" + g.pick("", g.ident()+" ") + g.pick("", "*") + "T1" + g.pick("", "[T]") + g.sp0() + ")" + g.sp())
+	}
+	g.w(fmt.Sprintf("f%d", g.fnN))
+	if g.chance(25) {
+		g.w("[" + g.pick("T any", "T, U any", "T ~int | ~string", "T interface{ M() }") + "]")
+	}
+	g.w(g.sp0() + "(" + g.params(2, true) + ")" + g.results(2))
+	if g.chance(5) {
+		g.w(g.eol()) // an external function has no body
+		return
+	}
+	g.w(g.sp())
+	g.block(3, "")
+	g.w(g.eol())
+}
+
+func (g *hzGen) imports() {
+	switch g.draw(1, 5) {
+	case 1:
+		return
+	case 2:
+		// One or two lone imports (gofumpt groups two).
+		second := g.chance(50)
+		eol1, eol2 := g.eol(), g.eol()
+		if second && (eol1 != "\n" || eol2 != "\n") && HZKnown.loneDeclCommentMerge {
+			hzAvoid("loneDeclCommentMerge")
+			eol1, eol2 = "\n", "\n"
+		}
+		p1, p2 := g.pick(`"fmt"`, `"foo.com/bar"`, `"os"`), g.pick(`"strings"`, `"github.com/x/y"`)
+		name1, name2, gap := g.pick("", "f ", ". ", "_ "), g.pick("", "_ "), g.pick("", "\n")
+		directed := second && g.chance(30)
+		if directed {
+			// Directed: a std import sorting after a third-party one, and the file ending with a
+			// comment group starting with a directive right after them (the rest of the group
+			// is respaced in the second run only when the group is displaced).
+			if g.chance(50) {
+				p1, p2 = `"os"`, `"github.com/x/y"`
+			} else {
+				p1, p2 = `"foo.com/bar"`, `"strings"`
+			}
+			name1, name2, gap = "", "", ""
+		}
+		g.w("import" + g.sp() + name1 + p1 + eol1)
+		if second {
+			g.w(gap + "import" + g.sp() + name2 + p2 + eol2)
+			if hzThirdParty(p1) != hzThirdParty(p2) && HZKnown.importJoinTrailingComment {
+				// A comment group right after a std and a third-party lone import reaches the
+				// recorded bug: an empty line keeps it apart.
+				hzAvoid("importJoinTrailingComment")
+				g.w("\n")
+			}
+			if directed {
+				g.tail = g.pick("//nolint:all", "//#nosec G101", "//NOSONAR") + "\n//" + g.text() + "\n"
+			}
+		}
+	default:
+		// An import group: specs with empty lines, doc comments and trailing comments.
+		n := g.draw(0, 6)
+		paths := []string{`"fmt"`, `"os"`, `"strings"`, `"go/ast"`, `"github.com/x/y"`, `"foo.com/bar"`, `"mycorp/mod1/sub"`, `"test/x"`, `"example/y"`, `"a/b.com/c"`, `"sort"`, `"zz.dev/q"`}
+		used := map[int]bool{}
+		var specs, docs, eols []string
+		var blanks []bool
+		thirdParty := false
+		needsSort := false
+		for i := 0; i < n; i++ {
+			k := g.draw(0, len(paths)-1)
+			if used[k] {
+				continue
+			}
+			used[k] = true
+			blank := len(specs) > 0 && g.chance(25)
+			doc := ""
+			if g.chance(15) {
+				doc = "\t" + g.lineComment() + "\n"
+			}
+			specs = append(specs, "\t"+g.pick("", "", "f"+fmt.Sprint(k)+" ", ". ", "_ ")+paths[k])
+			blanks = append(blanks, blank)
+			docs = append(docs, doc)
+			eols = append(eols, g.eol())
+			// A std import after a third-party one or after an empty line: gofumpt moves it up.
+			if hzMaybeStd(paths[k]) && (thirdParty || blank) {
+				needsSort = true
+			}
+			if hzThirdParty(paths[k]) {
+				thirdParty = true
+			}
+		}
+		if needsSort && HZKnown.importGroupCommentSort {
+			// Comments in a group that gofumpt reorders reach the recorded bug: none here.
+			hzAvoid("importGroupCommentSort")
+			for i := range specs {
+				docs[i], eols[i] = "", "\n"
+			}
+		}
+		g.emptyGroupGap(len(specs) == 0)
+		g.w("import" + g.sp() + "(" + g.eol())
+		for i, spec := range specs {
+			if blanks[i] {
+				g.w("\n")
+			}
+			g.w(docs[i] + spec + eols[i])
+		}
+		if g.chance(20) {
+			g.between("\t")
+		}
+		g.w(")" + g.groupEnd(len(specs) == 0))
+	}
+	if g.chance(30) {
+		g.between("")
+	}
+}
+
+// file generates a whole source file (unformatted).
+func (g *hzGen) file() string {
+	g.b.Reset()
+	if g.chance(40) {
+		g.between("")
+	}
+	if g.chance(50) {
+		g.w(g.lineComment() + "\n")
+		if g.chance(30) {
+			g.w("\n")
+		}
+	}
+	if g.chance(5) {
+		g.w("//go:build linux\n\n")
+	}
+	g.w("package" + g.sp() + g.pick("p", "main") + g.eol())
+	if g.chance(60) {
+		g.between("")
+	}
+	g.imports()
+	if g.tail != "" {
+		g.w(g.tail)
+		g.tail = ""
+		return g.fixup(g.b.String())
+	}
+	n := g.draw(0, 4)
+	for i := 0; i < n; i++ {
+		if i > 0 || g.chance(40) {
+			g.between("")
+		}
+		if g.chance(30) {
+			// A doc comment, sometimes a directive.
+			g.w(g.pick(g.lineComment(), g.lineComment(), g.blockComment(), "//go:noinline", g.lineComment()+"\n//\n"+g.lineComment(),
+				"//"+g.pick("\t", "  ")+g.text()+"\n//"+g.text()) + "\n")
+		}
+		g.decl()
+	}
+	if g.chance(30) {
+		g.between("")
+	}
+	return g.fixup(g.b.String())
+}
+
+// hzDirective is gofumpt's rxCommentDirective: the comments its comment-spacing rule leaves
+// alone.
+var hzDirective = regexp.MustCompile(`^(?:[a-z0-9-]+:[a-z0-9]|export |extern |line |no(?:inspection|lint)\b|#nosec\b|NOSONAR\b|sys(?:nb)?\b)`)
+
+// hzRespaced reports whether gofumpt's comment-spacing rule adds a space after the // of a
+// comment with this body (a letter or digit first, not a directive; the rule also skips
+// comment groups that parse as code, which is over-approximated here).
+func hzRespaced(body string) bool {
+	r, _ := utf8.DecodeRuneInString(body)
+	return (unicode.IsLetter(r) || unicode.IsNumber(r)) && !hzDirective.MatchString(body)
+}
+
+// hzEndsRespaced reports whether the line ends in a // comment that gofumpt respaces.
+func hzEndsRespaced(line string) bool {
+	i := strings.Index(line, "//")
+	return i >= 0 && hzRespaced(line[i+2:])
+}
+
+// fixup applies the text-level avoidances of the recorded bugs to a generated file: both
+// come from gofumpt's comment-spacing rule lengthening a comment's text without moving its
+// end position, so that the comment seems to end on the next line.
+func (g *hzGen) fixup(src string) string {
+	lines := strings.Split(src, "\n")
+	if HZKnown.respacedCommentEnd {
+		// Empty lines between a line ending in a respaced comment and a closing } or ) go.
+		var out []string
+		for i := 0; i < len(lines); i++ {
+			if strings.TrimSpace(lines[i]) == "" && len(out) > 0 && hzEndsRespaced(out[len(out)-1]) {
+				j := i
+				for j < len(lines) && strings.TrimSpace(lines[j]) == "" {
+					j++
+				}
+				if j < len(lines) {
+					if next := strings.TrimLeft(lines[j], "\t "); strings.HasPrefix(next, "}") || strings.HasPrefix(next, ")") {
+						hzAvoid("respacedCommentEnd")
+						i = j - 1
+						continue
+					}
+				}
+			}
+			out = append(out, lines[i])
+		}
+		lines = out
+	}
+	if HZKnown.docCommentRespacedEnd {
+		// A column-1 // comment group right before code, with an indented line: its last line
+		// gets its space from the generator instead.
+		for i := 0; i < len(lines); i++ {
+			if !strings.HasPrefix(lines[i], "//") {
+				continue
+			}
+			j, indented := i, false
+			for j < len(lines) && strings.HasPrefix(lines[j], "//") {
+				if b := lines[j][2:]; strings.HasPrefix(b, "\t") || strings.HasPrefix(b, "  ") {
+					indented = true
+				}
+				j++
+			}
+			if j < len(lines) && strings.TrimSpace(lines[j]) != "" && indented && hzRespaced(lines[j-1][2:]) {
+				hzAvoid("docCommentRespacedEnd")
+				lines[j-1] = "// " + lines[j-1][2:]
+			}
+			i = j
+		}
+	}
+	if HZKnown.printerRespacedDirective {
+		// A third-party directive in a column-1 comment group right before a lone var, const
+		// or type declaration gets its space from the generator.
+		for i := 0; i < len(lines); i++ {
+			if !strings.HasPrefix(lines[i], "//") {
+				continue
+			}
+			j := i
+			for j < len(lines) && strings.HasPrefix(lines[j], "//") {
+				j++
+			}
+			if j < len(lines) && (strings.HasPrefix(lines[j], "var ") || strings.HasPrefix(lines[j], "const ") || strings.HasPrefix(lines[j], "type ")) {
+				for k := i; k < j; k++ {
+					if hzPrinterDirective.MatchString(lines[k][2:]) {
+						hzAvoid("printerRespacedDirective")
+						lines[k] = "// " + lines[k][2:]
+					}
+				}
+			}
+			i = j
+		}
+	}
+	if HZKnown.varGroupCommentBlankLine {
+		// A one-spec var group in a block right after a comment line gets an empty line
+		// between the two.
+		for i := 1; i+2 < len(lines); i++ {
+			l := strings.TrimSpace(lines[i])
+			if !strings.HasPrefix(lines[i], "\t") || !strings.HasPrefix(l, "var") || !strings.HasSuffix(l, "(") || !hzCommentAbove(lines[i-1]) {
+				continue
+			}
+			// The group's closing parenthesis: where the bracket depth is back to zero.
+			depth, j := 1, i+1
+			for ; j < len(lines) && depth > 0; j++ {
+				depth += hzBracketDepth(lines[j])
+			}
+			j--
+			if depth == 0 && strings.HasPrefix(strings.TrimSpace(lines[j]), ")") && j > i+1 {
+				hzAvoid("varGroupCommentBlankLine")
+				lines = append(lines[:i], append([]string{""}, lines[i:]...)...)
+				i++
+			}
+		}
+	}
+	if HZKnown.loneDeclCommentMerge || HZKnown.loneDeclCollapseJoin {
+		// Adjacent lone var, const or type declarations (gofumpt groups them) get an empty
+		// line between them when one has a trailing comment, or when the first spans lines
+		// (the printer may put it on one).
+		var last *hzLoneDecl
+		var inserts []int
+		var names []string
+		for i := 0; i < len(lines); i++ {
+			d := hzLoneDeclAt(lines, i)
+			if d == nil {
+				if strings.TrimSpace(lines[i]) == "" || !hzIsCommentLine(lines[i]) {
+					last = nil // an empty line or code breaks the chain; comments continue it
+				}
+				continue
+			}
+			if last != nil && last.kw == d.kw {
+				switch {
+				case (last.comment || d.comment) && HZKnown.loneDeclCommentMerge:
+					inserts, names = append(inserts, last.end+1), append(names, "loneDeclCommentMerge")
+				case last.end > last.start && HZKnown.loneDeclCollapseJoin:
+					inserts, names = append(inserts, last.end+1), append(names, "loneDeclCollapseJoin")
+				}
+			}
+			last = d
+			i = d.end
+		}
+		for i := len(inserts) - 1; i >= 0; i-- {
+			hzAvoid(names[i])
+			lines = append(lines[:inserts[i]], append([]string{""}, lines[inserts[i]:]...)...)
+		}
+	}
+	if HZKnown.balanceCallsSeparatedDecl {
+		// A top-level declaration spanning lines with a trailing comment on its last line gets
+		// an empty line after it.
+		for i := 0; i+1 < len(lines); i++ {
+			if !hzDeclStart(lines[i]) {
+				continue
+			}
+			end := hzDeclEnd(lines, i)
+			if end > i && end+1 < len(lines) && strings.TrimSpace(lines[end+1]) != "" && hzEndsInComment(lines[end]) {
+				hzAvoid("balanceCallsSeparatedDecl")
+				lines = append(lines[:end+1], append([]string{""}, lines[end+1:]...)...)
+			}
+			i = end
+		}
+	}
+	{
+		// A comment group of empty // lines right before code: go/printer drops it, so a
+		// doc comment that gofumpt's rules saw is gone in the second run (gofmt's business).
+		// An empty line after the group makes it a floating comment.
+		for i := 0; i < len(lines); i++ {
+			if strings.TrimSpace(lines[i]) != "//" {
+				continue
+			}
+			j := i
+			for j < len(lines) && strings.TrimSpace(lines[j]) == "//" {
+				j++
+			}
+			if j < len(lines) && strings.TrimSpace(lines[j]) != "" && !hzIsCommentLine(lines[j]) {
+				lines = append(lines[:j], append([]string{""}, lines[j:]...)...)
+			}
+			i = j
+		}
+	}
+	src = strings.Join(lines, "\n")
+	if HZKnown.respacedCommentEnd {
+		// A respaced comment on the line closing a call opened on an earlier line (the
+		// balance_calls rule), in a parameter or result list spanning lines, or in an import
+		// group gets its space from the generator.
+		fset := token.NewFileSet()
+		if f, err := parser.ParseFile(fset, "", src, parser.ParseComments); err == nil {
+			line := func(p token.Pos) int { return fset.Position(p).Line }
+			affected := map[int]bool{}
+			span := func(from, to token.Pos) {
+				if line(from) != line(to) {
+					for l := line(from); l <= line(to); l++ {
+						affected[l] = true
+					}
+				}
+			}
+			ast.Inspect(f, func(n ast.Node) bool {
+				switch n := n.(type) {
+				case *ast.CallExpr:
+					if line(n.Lparen) != line(n.Rparen) {
+						affected[line(n.Rparen)] = true
+					}
+				case *ast.FuncType:
+					if n.Params != nil {
+						span(n.Params.Opening, n.Params.Closing)
+					}
+					if n.Results != nil && n.Results.Opening.IsValid() {
+						span(n.Results.Opening, n.Results.Closing)
+					}
+				case *ast.GenDecl:
+					if n.Tok == token.IMPORT && n.Lparen.IsValid() {
+						span(n.Lparen, n.Rparen)
+					}
+				}
+				return true
+			})
+			var offs []int
+			for _, cg := range f.Comments {
+				for _, c := range cg.List {
+					if strings.HasPrefix(c.Text, "//") && hzRespaced(c.Text[2:]) && affected[line(c.Slash)] {
+						offs = append(offs, fset.Position(c.Slash).Offset+2)
+					}
+				}
+			}
+			for i := len(offs) - 1; i >= 0; i-- {
+				hzAvoid("respacedCommentEnd")
+				src = src[:offs[i]] + " " + src[offs[i]:]
+			}
+		}
+	}
+	return src
+}
+
+// hzDeclStart reports whether a generated line starts a top-level declaration (a keyword at
+// column 1).
+func hzDeclStart(line string) bool {
+	for _, kw := range []string{"var", "const", "type", "func", "import"} {
+		if strings.HasPrefix(line, kw+" ") || strings.HasPrefix(line, kw+"/*") || strings.HasPrefix(line, kw+"(") {
+			return true
+		}
+	}
+	return false
+}
+
+// hzDeclEnd is the last line of the top-level declaration starting at line i: the line before
+// the next empty line (outside brackets), declaration or column-1 comment.
+func hzDeclEnd(lines []string, i int) int {
+	end := i
+	depth := hzBracketDepth(lines[i])
+	for end+1 < len(lines) && (strings.TrimSpace(lines[end+1]) != "" || depth > 0) && !hzDeclStart(lines[end+1]) &&
+		!strings.HasPrefix(lines[end+1], "//") && !strings.HasPrefix(lines[end+1], "/*") {
+		end++
+		depth += hzBracketDepth(lines[end])
+	}
+	return end
+}
+
+// hzBracketDepth is the number of brackets a line opens minus the number it closes, comments
+// and string literals left out (roughly: the generator's text keeps them simple).
+func hzBracketDepth(line string) int {
+	depth := 0
+	inString := byte(0)
+	for i := 0; i < len(line); i++ {
+		c := line[i]
+		switch {
+		case inString != 0:
+			if c == '\\' && inString == '"' {
+				i++
+			} else if c == inString {
+				inString = 0
+			}
+		case c == '"' || c == '`' || c == '\'':
+			inString = c
+		case c == '/' && i+1 < len(line) && line[i+1] == '/':
+			return depth
+		case c == '/' && i+1 < len(line) && line[i+1] == '*':
+			j := strings.Index(line[i+2:], "*/")
+			if j < 0 {
+				return depth
+			}
+			i += 2 + j + 1
+		case c == '{' || c == '(' || c == '[':
+			depth++
+		case c == '}' || c == ')' || c == ']':
+			depth--
+		}
+	}
+	return depth
+}
+
+// hzCommentAbove reports whether the line above a declaration is a comment line or ends a
+// block comment (the comment then documents the declaration).
+func hzCommentAbove(line string) bool {
+	return hzIsCommentLine(line) || strings.HasSuffix(strings.TrimSpace(line), "*/")
+}
+
+// hzEndsInComment reports whether a line of code ends in a comment.
+func hzEndsInComment(line string) bool {
+	l := strings.TrimSpace(line)
+	return strings.Contains(l, "//") || strings.HasSuffix(l, "*/")
+}
+
+// hzLoneDecl is a top-level lone var, const or type declaration in the generated lines: its
+// line range, keyword, and whether it carries a comment.
+type hzLoneDecl struct {
+	start, end int
+	kw         string
+	comment    bool
+}
+
+var hzGroupDecl = regexp.MustCompile(`^(var|const|type)\s+(/\*.*?\*/\s*)?\(`)
+
+// hzLoneDeclAt recognises a lone declaration starting at line i (with its indented
+// continuation lines).
+func hzLoneDeclAt(lines []string, i int) *hzLoneDecl {
+	l := lines[i]
+	kw := ""
+	switch {
+	case strings.HasPrefix(l, "var "), strings.HasPrefix(l, "var/*"):
+		kw = "var"
+	case strings.HasPrefix(l, "const "), strings.HasPrefix(l, "const/*"):
+		kw = "const"
+	case strings.HasPrefix(l, "type "), strings.HasPrefix(l, "type/*"):
+		kw = "type"
+	default:
+		return nil
+	}
+	d := &hzLoneDecl{start: i, end: i, kw: kw}
+	if hzGroupDecl.MatchString(l) {
+		// A one-spec var group is unwrapped to a lone declaration, which then joins a chain.
+		if kw != "var" {
+			return nil
+		}
+		depth, j := hzBracketDepth(l), i+1
+		for ; j < len(lines) && depth > 0; j++ {
+			depth += hzBracketDepth(lines[j])
+		}
+		j--
+		if depth != 0 || j >= len(lines) || !strings.HasPrefix(strings.TrimSpace(lines[j]), ")") {
+			return nil
+		}
+		specs := 0
+		for _, sl := range lines[i+1 : j] {
+			if s := strings.TrimSpace(sl); s != "" && !hzIsCommentLine(sl) && strings.HasPrefix(sl, "\t") && !strings.HasPrefix(sl, "\t\t") {
+				specs++
+			}
+		}
+		if specs != 1 {
+			return nil
+		}
+		d.end = j
+	} else {
+		d.end = hzDeclEnd(lines, i)
+	}
+	for d.end+1 < len(lines) && strings.Count(strings.Join(lines[d.start:d.end+1], ""), "`")%2 == 1 {
+		d.end++ // the rest of a raw string
+	}
+	for _, l := range lines[d.start : d.end+1] {
+		if strings.Contains(l, "//") || strings.Contains(l, "/*") {
+			d.comment = true
+		}
+	}
+	return d
+}
+
+// hzPrinterDirective: the directives of gofumpt's rxCommentDirective that go/printer's doc
+// comment formatting does not know (it keeps //word: and //export, //extern, //line).
+var hzPrinterDirective = regexp.MustCompile(`^(?:no(?:inspection|lint)\b|#nosec\b|NOSONAR\b|sys(?:nb)?\b)`)
+
+// hzThirdParty reports whether gofumpt may take an import path for a third-party one: a dot
+// in the first element, the reserved test/ and example/ prefixes, or the generator's module
+// path prefix mycorp/ (third-party when the options name that module).
+func hzThirdParty(spec string) bool {
+	path := spec[strings.Index(spec, `"`)+1:]
+	first, _, _ := strings.Cut(path, "/")
+	return strings.Contains(first, ".") || strings.HasPrefix(path, "test/") || strings.HasPrefix(path, "example/") || strings.HasPrefix(path, "mycorp/")
+}
+
+// hzMaybeStd reports whether gofumpt may take an import path for a std one (mycorp/ is,
+// unless the options name that module).
+func hzMaybeStd(spec string) bool {
+	path := spec[strings.Index(spec, `"`)+1:]
+	first, _, _ := strings.Cut(path, "/")
+	return !strings.Contains(first, ".") && !strings.HasPrefix(path, "test/") && !strings.HasPrefix(path, "example/")
+}
+
+// hzOctalLit matches an old-style octal literal, which gofumpt rewrites to 0o.
+var hzOctalLit = regexp.MustCompile(`\b0[0-7_]+\b`)
+
+// hzIsCommentLine reports whether a line of generated text starts with a comment.
+func hzIsCommentLine(line string) bool {
+	s := strings.TrimSpace(line)
+	return strings.HasPrefix(s, "//") || strings.HasPrefix(s, "/*")
+}
diff --git a/hegel/hegel_zoo_norm_test.go b/hegel/hegel_zoo_norm_test.go
new file mode 100644
index 0000000..b911497
--- /dev/null
+++ b/hegel/hegel_zoo_norm_test.go
@@ -0,0 +1,286 @@
+package hegel
+
+// The syntax-tree normalisation for TestHegelSyntax: both the input's and the output's trees
+// are brought to a form in which gofumpt's documented rewrites (gofmt -s simplifications,
+// var statements as short assignments, 0o octal literals, grouped and ungrouped
+// declarations, std imports first, useless parentheses removed, parameters with equal types
+// grouped, naked returns clothed) make no difference; what remains must be equal.
+
+import (
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"math/big"
+	"reflect"
+	"sort"
+	"strings"
+
+	"golang.org/x/tools/go/ast/astutil"
+	"mvdan.cc/gofumpt/format"
+)
+
+// hzCommentTexts lists a file's comments, sorted, a line comment's leading blanks after //
+// dropped (gofumpt adds a space to //x).
+func hzCommentTexts(f *ast.File) []string {
+	var out []string
+	for _, cg := range f.Comments {
+		for _, cm := range cg.List {
+			s := cm.Text
+			if strings.HasPrefix(s, "//") {
+				// go/printer strips trailing blanks from line comments, and drops the empty //
+				// lines at the edges of a doc comment.
+				s = "//" + strings.TrimRight(strings.TrimLeft(s[2:], " \t"), " \t")
+				if s == "//" {
+					continue
+				}
+			} else if strings.Contains(s, "\n") {
+				// go/printer re-indents the lines of a block comment, strips their trailing
+				// blanks and, for a doc comment, reflows the paragraphs: only the words count.
+				s = strings.Join(strings.Fields(s), " ")
+			}
+			out = append(out, s)
+		}
+	}
+	sort.Strings(out)
+	return out
+}
+
+// hzIntValue is the decimal value of an integer literal, or the literal itself when it does
+// not parse.
+func hzIntValue(lit string) string {
+	s := strings.ReplaceAll(lit, "_", "")
+	var z big.Int
+	if len(s) > 1 && s[0] == '0' && (s[1] == 'o' || s[1] == 'O') {
+		s = "0" + s[2:]
+	}
+	if _, ok := z.SetString(s, 0); !ok {
+		return lit
+	}
+	return z.String()
+}
+
+// hzIsIdent reports whether e is the identifier name, parentheses aside (gofumpt removes
+// them, and the naked-return check runs before the normaliser strips them).
+func hzIsIdent(e ast.Expr, name string) bool {
+	for {
+		p, ok := e.(*ast.ParenExpr)
+		if !ok {
+			break
+		}
+		e = p.X
+	}
+	id, ok := e.(*ast.Ident)
+	return ok && id.Name == name
+}
+
+// hzNormalize rewrites the file in place and returns it.
+func hzNormalize(f *ast.File, o format.Options) *ast.File {
+	var funcs []*ast.FuncType
+	pre := func(c *astutil.Cursor) bool {
+		switch n := c.Node().(type) {
+		case *ast.FuncDecl:
+			funcs = append(funcs, n.Type)
+		case *ast.FuncLit:
+			funcs = append(funcs, n.Type)
+		case *ast.ReturnStmt:
+			// A return of exactly the enclosing function's named results, in order, is a
+			// naked return (the clothe_returns rule).
+			if len(funcs) == 0 || len(n.Results) == 0 {
+				break
+			}
+			var names []string
+			res := funcs[len(funcs)-1].Results
+			if res != nil {
+				for _, fl := range res.List {
+					for _, id := range fl.Names {
+						names = append(names, id.Name)
+					}
+				}
+			}
+			if len(names) != len(n.Results) {
+				break
+			}
+			for i, r := range n.Results {
+				if !hzIsIdent(r, names[i]) || names[i] == "_" {
+					return true
+				}
+			}
+			n.Results = nil
+		}
+		return true
+	}
+	post := func(c *astutil.Cursor) bool {
+		switch n := c.Node().(type) {
+		case *ast.FuncDecl, *ast.FuncLit:
+			funcs = funcs[:len(funcs)-1]
+		case *ast.ParenExpr:
+			c.Replace(n.X)
+		case *ast.BasicLit:
+			if n.Kind == token.INT {
+				n.Value = hzIntValue(n.Value)
+			}
+		case *ast.DeclStmt:
+			d, ok := n.Decl.(*ast.GenDecl)
+			if !ok || d.Tok != token.VAR || len(d.Specs) != 1 {
+				break
+			}
+			spec := d.Specs[0].(*ast.ValueSpec)
+			if spec.Type != nil || len(spec.Values) == 0 {
+				break
+			}
+			tok := token.ASSIGN
+			lhs := make([]ast.Expr, len(spec.Names))
+			for i, id := range spec.Names {
+				lhs[i] = id
+				if id.Name != "_" {
+					tok = token.DEFINE
+				}
+			}
+			c.Replace(&ast.AssignStmt{Lhs: lhs, Tok: tok, Rhs: spec.Values})
+		case *ast.RangeStmt:
+			if n.Value != nil && hzIsIdent(n.Value, "_") {
+				n.Value = nil
+			}
+			if n.Key != nil && hzIsIdent(n.Key, "_") && n.Value == nil {
+				n.Key = nil
+			}
+			if n.Key == nil {
+				n.Tok = token.ILLEGAL
+			}
+		case *ast.SliceExpr:
+			if call, ok := n.High.(*ast.CallExpr); ok && hzIsIdent(call.Fun, "len") && len(call.Args) == 1 {
+				if x, ok := n.X.(*ast.Ident); ok && hzIsIdent(call.Args[0], x.Name) {
+					n.High = nil
+				}
+			}
+		case *ast.CompositeLit:
+			elide := func(e ast.Expr) ast.Expr {
+				if u, ok := e.(*ast.UnaryExpr); ok && u.Op == token.AND {
+					if cl, ok := u.X.(*ast.CompositeLit); ok {
+						cl.Type = nil
+						return cl
+					}
+				}
+				if cl, ok := e.(*ast.CompositeLit); ok {
+					cl.Type = nil
+				}
+				return e
+			}
+			for i, e := range n.Elts {
+				if kv, ok := e.(*ast.KeyValueExpr); ok {
+					kv.Key = elide(kv.Key)
+					kv.Value = elide(kv.Value)
+					continue
+				}
+				n.Elts[i] = elide(e)
+			}
+		case *ast.FieldList:
+			if n == nil {
+				break
+			}
+			var list []*ast.Field
+			for _, fl := range n.List {
+				if len(fl.Names) <= 1 {
+					list = append(list, fl)
+					continue
+				}
+				for _, id := range fl.Names {
+					list = append(list, &ast.Field{Names: []*ast.Ident{id}, Type: fl.Type, Tag: fl.Tag})
+				}
+			}
+			n.List = list
+		}
+		return true
+	}
+	astutil.Apply(f, pre, post)
+
+	// Declarations: one spec per declaration, imports first and sorted.
+	var imports []*ast.ImportSpec
+	var decls []ast.Decl
+	for _, d := range f.Decls {
+		gd, ok := d.(*ast.GenDecl)
+		if !ok {
+			decls = append(decls, d)
+			continue
+		}
+		for _, s := range gd.Specs {
+			if is, ok := s.(*ast.ImportSpec); ok {
+				imports = append(imports, is)
+				continue
+			}
+			decls = append(decls, &ast.GenDecl{Tok: gd.Tok, Specs: []ast.Spec{s}})
+		}
+	}
+	sort.SliceStable(imports, func(i, j int) bool {
+		if imports[i].Path.Value != imports[j].Path.Value {
+			return imports[i].Path.Value < imports[j].Path.Value
+		}
+		return hzImportName(imports[i]) < hzImportName(imports[j])
+	})
+	var out []ast.Decl
+	for _, is := range imports {
+		out = append(out, &ast.GenDecl{Tok: token.IMPORT, Specs: []ast.Spec{is}})
+	}
+	f.Decls = append(out, decls...)
+	f.Comments = nil
+	f.Imports = nil
+	return f
+}
+
+func hzImportName(is *ast.ImportSpec) string {
+	if is.Name == nil {
+		return ""
+	}
+	return is.Name.Name
+}
+
+var hzPosType = reflect.TypeOf(token.Pos(0))
+
+// hzASTEqual compares two syntax trees without their positions, comments and resolution
+// information.
+func hzASTEqual(a, b any) bool { return hzEq(reflect.ValueOf(a), reflect.ValueOf(b)) }
+
+func hzEq(a, b reflect.Value) bool {
+	if a.Type() != b.Type() {
+		return false
+	}
+	if a.Type() == hzPosType {
+		return true
+	}
+	switch a.Kind() {
+	case reflect.Ptr, reflect.Interface:
+		if a.IsNil() || b.IsNil() {
+			return a.IsNil() == b.IsNil()
+		}
+		return hzEq(a.Elem(), b.Elem())
+	case reflect.Struct:
+		for i := 0; i < a.NumField(); i++ {
+			switch a.Type().Field(i).Name {
+			case "Doc", "Comment", "Comments", "Obj", "Scope", "Unresolved", "Imports":
+				continue
+			}
+			if !hzEq(a.Field(i), b.Field(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Slice:
+		if a.Len() != b.Len() {
+			return false
+		}
+		for i := 0; i < a.Len(); i++ {
+			if !hzEq(a.Index(i), b.Index(i)) {
+				return false
+			}
+		}
+		return true
+	case reflect.Map:
+		return true
+	}
+	return reflect.DeepEqual(a.Interface(), b.Interface())
+}
+
+// hzParse parses Go source with comments.
+func hzParse(src string) (*ast.File, error) {
+	return parser.ParseFile(token.NewFileSet(), "", src, parser.ParseComments)
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..4b3a2ff
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,235 @@
+package hegel
+
+// Pins: one test per recorded bug (bugs.toml), asserting the documented behaviour; each fails
+// while its bug exists and is listed under [expected_failures] in target.toml.
+
+import (
+	"strings"
+	"testing"
+
+	"mvdan.cc/gofumpt/format"
+	gofmt "mvdan.cc/gofumpt/internal/govendor/go/format"
+)
+
+var hzPinOpts = format.Options{LangVersion: "go1.21"}
+
+// hzPinInput checks that gofmt itself is idempotent on a pin's input (otherwise the bug
+// would be gofmt's).
+func hzPinInput(t *testing.T, src string) {
+	t.Helper()
+	b1, err := gofmt.Source([]byte(src))
+	if err != nil {
+		t.Fatalf("gofmt rejects the input: %v", err)
+	}
+	b2, _ := gofmt.Source(b1)
+	if string(b1) != string(b2) {
+		t.Fatalf("gofmt itself is not idempotent on the input (gofmt's business)\n%s", hzShowDiff(string(b1), string(b2)))
+	}
+}
+
+// hzPinIdempotent checks that a second gofumpt run changes nothing.
+func hzPinIdempotent(t *testing.T, src string) string {
+	t.Helper()
+	return hzPinIdempotentOpts(t, src, hzPinOpts)
+}
+
+func hzPinIdempotentOpts(t *testing.T, src string, o format.Options) string {
+	t.Helper()
+	hzPinInput(t, src)
+	out1, err, p := hzFumpt(src, o)
+	if p != nil || err != nil {
+		t.Fatalf("gofumpt fails: %v %v", p, err)
+	}
+	out2, err, p := hzFumpt(out1, o)
+	if p != nil || err != nil {
+		t.Fatalf("the second gofumpt run fails: %v %v", p, err)
+	}
+	if out1 != out2 {
+		t.Fatalf("a second gofumpt run changes the output\n%s", hzShowDiff(out1, out2))
+	}
+	return out1
+}
+
+// hzPinGofmtStable checks that gofmt changes nothing in gofumpt's output.
+func hzPinGofmtStable(t *testing.T, src string) {
+	t.Helper()
+	hzPinInput(t, src)
+	out1, err, p := hzFumpt(src, hzPinOpts)
+	if p != nil || err != nil {
+		t.Fatalf("gofumpt fails: %v %v", p, err)
+	}
+	b, err := gofmt.Source([]byte(out1))
+	if err != nil {
+		t.Fatalf("gofmt rejects gofumpt's output: %v\n%s", err, out1)
+	}
+	if string(b) != out1 {
+		t.Fatalf("gofmt changes gofumpt's output\n%s", hzShowDiff(out1, string(b)))
+	}
+}
+
+// gofumpt/1: grouping adjacent lone const declarations changes the value of iota.
+func TestHegelPinConstIotaGrouped(t *testing.T) {
+	src := "package p\n\nconst a = iota\nconst b = iota\n"
+	want, err := hzConstValues(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	out, err, p := hzFumpt(src, hzPinOpts)
+	if p != nil || err != nil {
+		t.Fatalf("gofumpt fails: %v %v", p, err)
+	}
+	got, err := hzConstValues(out)
+	if err != nil {
+		t.Fatalf("the output does not type-check: %v\n%s", err, out)
+	}
+	if !hzEqStrings(want, got) {
+		t.Fatalf("the constants change value: %v -> %v\noutput:\n%s", want, got, out)
+	}
+}
+
+// gofumpt/2: the empty line between a //c comment (which gofumpt respaces to // c) and the
+// closing brace is removed only in the second run.
+func TestHegelPinRespacedCommentEnd(t *testing.T) {
+	hzPinIdempotent(t, "package p\n\nfunc f() {\n\tx() //c\n\n}\n")
+}
+
+// gofumpt/3: var x = // c NEWLINE v becomes x := // c NEWLINE v with the value not indented as
+// a continuation line.
+func TestHegelPinVarCommentContinuation(t *testing.T) {
+	hzPinGofmtStable(t, "package p\n\nfunc f() {\n\tvar s = // c\n\t\ty\n}\n")
+}
+
+// gofumpt/4: two lone imports, one with a trailing comment, are merged into a group with the
+// comment after the closing parenthesis, and the second run re-sorts the group (lone consts
+// or vars with trailing block comments get the parenthesis glued to the last comment).
+func TestHegelPinLoneDeclCommentMerge(t *testing.T) {
+	hzPinIdempotent(t, "package p\n\nimport \"os\" // c\nimport \"github.com/x/y\"\n")
+}
+
+// gofumpt/5: a doc comment with an indented line whose last line gofumpt respaces is not
+// reformatted the way gofmt reformats doc comments (the // separating the code block from
+// the text is missing), so gofmt changes the output.
+func TestHegelPinDocCommentRespacedEnd(t *testing.T) {
+	hzPinGofmtStable(t, "package p\n\n//\tc\n//d\nfunc f() {}\n")
+}
+
+// gofumpt/6: a one-spec var group with a trailing comment (or a comment on the line above) at
+// the end of a block becomes a short assignment followed by an empty line, which the second
+// run removes.
+func TestHegelPinVarGroupCommentBlankLine(t *testing.T) {
+	hzPinIdempotent(t, "package p\n\nfunc f() {\n\tvar (\n\t\ts = c // c\n\t)\n}\n")
+}
+
+// gofumpt/7: an import group ending in a std import with a trailing comment after a
+// third-party import is sorted in the first run, and the empty line between the std and the
+// other imports is added only in the second run (a doc comment after an empty line, hiding
+// the empty line, is the other shape).
+func TestHegelPinImportGroupCommentSort(t *testing.T) {
+	hzPinIdempotent(t, "package p\n\nimport (\n\t\"zz.dev/q\"\n\t\"go/ast\" // c\n)\n")
+}
+
+// gofumpt/8: a //nolint doc comment keeps two lone const declarations apart in the first run
+// only: go/printer's doc comment formatting spaces it to // nolint, the second run no longer
+// sees a directive and groups the declarations, and iota changes value.
+func TestHegelPinPrinterRespacedDirective(t *testing.T) {
+	src := "package p\n\n//nolint\nconst a = iota\nconst b = iota\n"
+	want, err := hzConstValues(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	out1, err, p := hzFumpt(src, hzPinOpts)
+	if p != nil || err != nil {
+		t.Fatalf("gofumpt fails: %v %v", p, err)
+	}
+	out2, err, p := hzFumpt(out1, hzPinOpts)
+	if p != nil || err != nil {
+		t.Fatalf("the second gofumpt run fails: %v %v", p, err)
+	}
+	got, err := hzConstValues(out2)
+	if err != nil {
+		t.Fatalf("the output does not type-check: %v\n%s", err, out2)
+	}
+	if !hzEqStrings(want, got) {
+		t.Fatalf("the constants change value in the second run: %v -> %v\nfirst output:\n%s\nsecond output:\n%s", want, got, out1, out2)
+	}
+}
+
+// gofumpt/9: a comment on the ( line (or above the spec) of a one-spec top-level var group
+// becomes the declaration's doc comment, but is formatted as a doc comment only in the second
+// run.
+func TestHegelPinVarGroupCommentDoc(t *testing.T) {
+	hzPinIdempotent(t, "package p\n\nvar ( //  c\n\ty = 1\n)\n")
+}
+
+// gofumpt/10: an empty struct type with a comment inside, in a parameter or result list, is
+// printed over two lines by go/printer, and the second run then puts the closing parenthesis
+// of the list on its own line.
+func TestHegelPinEmptyTypeCommentFieldList(t *testing.T) {
+	hzPinIdempotent(t, "package p\n\nfunc f(a struct { /* c */ }, b int) {\n\tx()\n}\n")
+}
+
+// gofumpt/11: a lone const spanning two lines only for an empty composite literal written over
+// two lines is not joined with the next lone const in the first run; go/printer puts it on
+// one line, and the second run joins the two, changing the value of iota.
+func TestHegelPinLoneDeclCollapseJoin(t *testing.T) {
+	src := "package p\n\nconst a = len([1]int{\n})\nconst b = iota\n"
+	want, err := hzConstValues(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	out1, err, p := hzFumpt(src, hzPinOpts)
+	if p != nil || err != nil {
+		t.Fatalf("gofumpt fails: %v %v", p, err)
+	}
+	out2, err, p := hzFumpt(out1, hzPinOpts)
+	if p != nil || err != nil {
+		t.Fatalf("the second gofumpt run fails: %v %v", p, err)
+	}
+	got, err := hzConstValues(out2)
+	if err != nil {
+		t.Fatalf("the output does not type-check: %v\n%s", err, out2)
+	}
+	if !hzEqStrings(want, got) {
+		t.Fatalf("the constants change value in the second run: %v -> %v\nfirst output:\n%s\nsecond output:\n%s", want, got, out1, out2)
+	}
+}
+
+// gofumpt/12: with balance_calls, a call spanning lines in a top-level declaration with a
+// trailing comment, directly followed by another declaration spanning lines, is balanced only
+// in the second run (the first inserts the empty line between the declarations).
+func TestHegelPinBalanceCallsSeparatedDecl(t *testing.T) {
+	o := hzPinOpts
+	o.Extra.BalanceCalls = true
+	hzPinIdempotentOpts(t, "package p\n\nvar n = f(\n\tb) // c\nfunc f1(n int) {\n}\n", o)
+}
+
+// gofumpt/13: with group_params, two parameters whose types are the same only once go/printer
+// has put a two-line empty interface on one line are grouped only in the second run.
+func TestHegelPinGroupParamsCollapse(t *testing.T) {
+	o := hzPinOpts
+	o.Extra.GroupParams = true
+	hzPinIdempotentOpts(t, "package p\n\nfunc f(a interface {\n}, b interface{}) {\n}\n", o)
+}
+
+// gofumpt/14: a comment group directly after two lone imports, one std and one third-party,
+// is printed as a trailing comment of the closing parenthesis of the group gofumpt makes of
+// them.
+func TestHegelPinImportJoinTrailingComment(t *testing.T) {
+	src := "package p\n\nimport \"os\"\nimport \"github.com/x/y\"\n// c\n"
+	hzPinInput(t, src)
+	out, err, p := hzFumpt(src, hzPinOpts)
+	if p != nil || err != nil {
+		t.Fatalf("gofumpt fails: %v %v", p, err)
+	}
+	want := "package p\n\nimport (\n\t\"os\"\n\n\t\"github.com/x/y\"\n)\n\n// c\n"
+	if out != want {
+		t.Fatalf("the comment after the imports moves\n%s", strings.NewReplacer("--- first:", "--- want:", "--- second:", "--- got:").Replace(hzShowDiff(want, out)))
+	}
+}
+
+// gofumpt/15: a case list spanning lines is put on one line only in the second run when the
+// length gofumpt measures for it (the clause without its body, plus its trailing comment)
+// shrinks in the first: here the trailing spaces of the comment, which go/printer strips.
+func TestHegelPinCaseListLengthCollapse(t *testing.T) {
+	hzPinIdempotent(t, "package p\n\nfunc f() {\n\tswitch x {\n\tcase "+strings.Repeat("y", 28)+",\n\t\tz: // c  \n\t\tg()\n\t}\n}\n")
+}
diff --git a/hegel/hegel_zoo_props_test.go b/hegel/hegel_zoo_props_test.go
new file mode 100644
index 0000000..2641ae1
--- /dev/null
+++ b/hegel/hegel_zoo_props_test.go
@@ -0,0 +1,201 @@
+package hegel
+
+// The properties: TestHegelIdempotent (a second gofumpt run changes nothing),
+// TestHegelGofmtStable (gofmt - the go/format gofumpt vendors, so that the toolchain's
+// version does not matter - changes nothing in gofumpt's output), TestHegelSyntax (the
+// output parses to the same syntax tree as the input, modulo the documented rewrites, and
+// keeps every comment).
+
+import (
+	"bytes"
+	"fmt"
+	gofmt "go/format"
+	"go/parser"
+	"go/token"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+	"mvdan.cc/gofumpt/format"
+	vgofmt "mvdan.cc/gofumpt/internal/govendor/go/format"
+)
+
+var hzLangVersions = []string{"", "go1", "go1.12", "go1.13", "go1.18", "go1.21", "go1.26", "go1.26.1", "go1.27rc1"}
+
+var hzModulePaths = []string{"", "foo.com/bar", "mycorp/mod1", "mycorp", "github.com/x/y", "test", "zz.dev/q/r"}
+
+// hzOptions draws gofumpt options.
+func hzOptions(tc hegel.TestCase) format.Options {
+	var o format.Options
+	o.LangVersion = hzPick(tc, hzLangVersions)
+	o.ModulePath = hzPick(tc, hzModulePaths)
+	switch hzDrawInt(tc, 1, 6) {
+	case 1:
+		o.ExtraRules = true
+	case 2:
+		o.Extra.GroupParams = hzChance(tc, 50)
+		o.Extra.ClotheReturns = hzChance(tc, 50)
+		o.Extra.BalanceCalls = hzChance(tc, 50)
+	}
+	return o
+}
+
+func hzOptString(o format.Options) string {
+	return fmt.Sprintf("LangVersion=%q ModulePath=%q ExtraRules=%v Extra=%q", o.LangVersion, o.ModulePath, o.ExtraRules, o.Extra.String())
+}
+
+// hzInput is the generated file, as it is or gofmt-formatted (the generator's text must be
+// valid Go; gofumpt takes it either way).
+func hzInput(ht *hegel.T, c *hzCollector, g *hzGen) string {
+	raw := g.file()
+	if _, err := parser.ParseFile(token.NewFileSet(), "", raw, parser.ParseComments); err != nil {
+		ht.Fatalf("the generator produced invalid Go: %v\n%s", err, raw)
+	}
+	src, err := gofmt.Source([]byte(raw))
+	if err != nil {
+		ht.Fatalf("gofmt rejects the generator's Go: %v\n%s", err, raw)
+	}
+	if _, err := parser.ParseFile(token.NewFileSet(), "", src, parser.ParseComments); err != nil {
+		// gofmt's business (go/printer joins lines in some comment placements).
+		c.count("gofmt output invalid")
+		return ""
+	}
+	if src2, err := gofmt.Source(src); err != nil || !bytes.Equal(src, src2) {
+		// gofmt's business too (its doc comment reflow is not always idempotent); gofumpt
+		// would inherit the instability.
+		c.count("gofmt unstable")
+		return ""
+	}
+	if hzChance(ht, 50) {
+		c.count("input raw")
+		return raw
+	}
+	c.count("input gofmt")
+	return string(src)
+}
+
+// hzFumpt runs gofumpt, recovering a panic.
+func hzFumpt(src string, o format.Options) (out string, err error, panicked any) {
+	panicked = hzCatch(func() {
+		var b []byte
+		b, err = format.Source([]byte(src), o)
+		out = string(b)
+	})
+	return
+}
+
+func TestHegelIdempotent(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		g := hzNewGen(ht)
+		src := hzInput(ht, c, g)
+		if src == "" {
+			return
+		}
+		o := hzOptions(ht)
+		out1, err, p := hzFumpt(src, o)
+		if p != nil {
+			c.failClass(ht, "panic", "gofumpt panics: %v\n%s\nsource:\n%s", p, hzOptString(o), src)
+			return
+		}
+		if err != nil {
+			c.failClass(ht, "error", "gofumpt fails: %v\n%s\nsource:\n%s", err, hzOptString(o), src)
+			return
+		}
+		out2, err, p := hzFumpt(out1, o)
+		if p != nil {
+			c.failClass(ht, "panic second", "the second gofumpt run panics: %v\n%s\nfirst output:\n%s", p, hzOptString(o), out1)
+			return
+		}
+		if err != nil {
+			c.failClass(ht, "error second", "the second gofumpt run fails: %v\n%s\nfirst output:\n%s", err, hzOptString(o), out1)
+			return
+		}
+		if out1 != out2 {
+			c.failClass(ht, hzDiffClass(out1, out2), "a second gofumpt run changes the output\n%s\n%s\nsource:\n%s", hzOptString(o), hzShowDiff(out1, out2), src)
+			return
+		}
+		c.count("ok")
+	})
+}
+
+func TestHegelGofmtStable(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		g := hzNewGen(ht)
+		src := hzInput(ht, c, g)
+		if src == "" {
+			return
+		}
+		o := hzOptions(ht)
+		out1, err, p := hzFumpt(src, o)
+		if p != nil || err != nil {
+			c.count("gofumpt fails (TestHegelIdempotent's business)")
+			return
+		}
+		b, err := vgofmt.Source([]byte(out1))
+		if err != nil {
+			c.failClass(ht, "invalid", "gofmt rejects gofumpt's output: %v\n%s\noutput:\n%s\nsource:\n%s", err, hzOptString(o), out1, src)
+			return
+		}
+		if string(b) != out1 {
+			c.failClass(ht, hzDiffClass(out1, string(b)), "gofmt changes gofumpt's output\n%s\n%s\nsource:\n%s", hzOptString(o), strings.Replace(hzShowDiff(out1, string(b)), "--- second:", "--- gofmt:", 1), src)
+			return
+		}
+		c.count("ok")
+	})
+}
+
+func TestHegelSyntax(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		g := hzNewGen(ht)
+		src := hzInput(ht, c, g)
+		if src == "" {
+			return
+		}
+		o := hzOptions(ht)
+		out1, err, p := hzFumpt(src, o)
+		if p != nil || err != nil {
+			c.count("gofumpt fails (TestHegelIdempotent's business)")
+			return
+		}
+		in, err := parser.ParseFile(token.NewFileSet(), "", src, parser.ParseComments)
+		if err != nil {
+			ht.Fatalf("go/parser on the source: %v", err)
+		}
+		outFile, err := parser.ParseFile(token.NewFileSet(), "", out1, parser.ParseComments)
+		if err != nil {
+			c.failClass(ht, "invalid", "gofumpt's output does not parse: %v\n%s\noutput:\n%s\nsource:\n%s", err, hzOptString(o), out1, src)
+			return
+		}
+		wantC := hzCommentTexts(in)
+		gotC := hzCommentTexts(outFile)
+		if !hzEqStrings(wantC, gotC) {
+			c.failClass(ht, "comments", "the comments differ\nwant %q\ngot  %q\n%s\noutput:\n%s\nsource:\n%s", wantC, gotC, hzOptString(o), out1, src)
+			return
+		}
+		a := hzNormalize(in, o)
+		b := hzNormalize(outFile, o)
+		if !hzASTEqual(a, b) {
+			var ba, bb bytes.Buffer
+			gofmt.Node(&ba, token.NewFileSet(), a)
+			gofmt.Node(&bb, token.NewFileSet(), b)
+			c.failClass(ht, "syntax", "the syntax tree differs\n%s\n%s\noutput:\n%s\nsource:\n%s", hzOptString(o), strings.NewReplacer("--- first:", "--- normalised source:", "--- second:", "--- normalised output:").Replace(hzShowDiff(ba.String(), bb.String())), out1, src)
+			return
+		}
+		c.count("ok")
+	})
+}
+
+func hzEqStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..1024032
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,243 @@
+package hegel
+
+// Hegel property tests for mvdan/gofumpt, written for the Hegel zoo. See
+// targets/go/gofumpt/README.md. They live in a package of their own (hegel/) and drive the
+// public API: format.Source with every Options combination, on generated Go source files
+// with the shapes gofumpt's rules act on.
+//
+// Oracles: gofumpt's own contract (a second run changes nothing, and gofmt changes nothing),
+// go/parser (the output parses to the same syntax tree, modulo the documented rewrites), and
+// the documented rules as postconditions on the output.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hzOpts; a panic in the code under test is turned into a failure of the current test
+// case by hzProperty(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unsafe"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hzOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+func hzDrawInt(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func hzChance(tc hegel.TestCase, pct int) bool { return hzDrawInt(tc, 1, 100) <= pct }
+
+func hzPick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != ""
+
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzAvoidedMu.Lock()
+		for k, v := range hzAvoided {
+			parts = append(parts, fmt.Sprintf("avoided %s=%d", k, v))
+		}
+		hzAvoided = map[string]int{}
+		hzAvoidedMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// hzCatch runs fn and returns the value it panicked with, or nil.
+func hzCatch(fn func()) (r any) {
+	defer func() { r = recover() }()
+	fn()
+	return nil
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// HZKnown: the recorded bugs (bugs.toml) that the generated cases reach. While a switch is on
+// the generators keep away from the behaviour (and count the avoidance); the pins assert the
+// documented behaviour and fail while the bug exists.
+var HZKnown = struct {
+	constIotaGrouped          bool // adjacent lone const declarations are grouped, which changes the value of iota in the later ones
+	respacedCommentEnd        bool // a //c comment respaced to // c seems to end on the next line: empty lines before a closing } or ) survive the first run, balance_calls skips the call
+	varCommentContinuation    bool // var x = // c NEWLINE v becomes x := // c NEWLINE v with the value not indented as a continuation (gofmt changes it)
+	loneDeclCommentMerge      bool // lone declarations with trailing comments are merged with the ) glued to a block comment (gofmt realigns) or, for imports, the comment after the ) and the group re-sorted in the second run
+	docCommentRespacedEnd     bool // a doc comment with an indented line whose last line is respaced is not reformatted as gofmt does (no // before the text after a code block)
+	varGroupCommentBlankLine  bool // a one-spec var group with a comment (trailing, or on the line above) at the end of a block leaves an empty line before the closing brace in the first run
+	importGroupCommentSort    bool // comments in an import group with a std import to move up: the group is put in order (std first, an empty line between) only in the second run
+	printerRespacedDirective  bool // a //nolint, //noinspection, //#nosec, //NOSONAR or //sys doc comment on a lone var/const/type declaration is spaced by go/printer, and the second run joins the declaration with the next
+	varGroupCommentDoc        bool // a comment on the ( line or above the spec of a one-spec top-level var group becomes the declaration's doc comment, formatted as one only in the second run
+	emptyTypeCommentFieldList bool // an empty struct or interface type with a comment inside, in a parameter or result list, is printed over two lines, and the second run then puts the closing parenthesis on its own line
+	loneDeclCollapseJoin      bool // a lone declaration spanning lines only for an empty type or literal written over two lines is joined with the next lone declaration in the second run, when go/printer has put it on one line
+	balanceCallsSeparatedDecl bool // balance_calls: a call spanning lines in a top-level declaration with a trailing comment, directly followed by another multi-line declaration, is balanced only in the second run
+	groupParamsCollapse       bool // group_params: parameters whose types read the same only once formatted (a two-line empty type on one line, parentheses gone) are grouped only in the second run
+	importJoinTrailingComment bool // a comment group ending the file directly after two lone imports, a std one sorting after a third-party one, is printed as a trailing comment of the closing parenthesis of the group gofumpt makes of them (a directive there keeps the rest of the group from being respaced until the second run)
+	caseListLengthCollapse    bool // a case list spanning lines is put on one line only in the second run when the length gofumpt measures for it shrinks in the first: trailing spaces stripped from its trailing comment, or a two-line empty type or body in it collapsed by go/printer
+}{true, true, true, true, true, true, true, true, true, true, true, true, true, true, true}
+
+// hzAvoided counts the cases where a generator kept away from a known bug (printed by the
+// collector).
+var (
+	hzAvoidedMu sync.Mutex
+	hzAvoided   = map[string]int{}
+)
+
+func hzAvoid(name string) {
+	hzAvoidedMu.Lock()
+	hzAvoided[name]++
+	hzAvoidedMu.Unlock()
+}
+
+// ZOO_KNOWN_OFF=name,name turns switches off, to check that the properties then fail on them
+// (never set in the zoo's runs).
+func init() {
+	off := os.Getenv("ZOO_KNOWN_OFF")
+	if off == "" {
+		return
+	}
+	v := reflect.ValueOf(&HZKnown).Elem()
+	for _, name := range strings.Split(off, ",") {
+		f := v.FieldByName(name)
+		if !f.IsValid() {
+			panic("ZOO_KNOWN_OFF: no switch " + name)
+		}
+		reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().SetBool(false)
+	}
+}
+
+// --------------------------------------------------------------------------- diffs
+
+// hzFirstDiffLine finds the first line where a and b differ: the index, and the two lines
+// (empty when a side has run out).
+func hzFirstDiffLine(a, b string) (int, string, string) {
+	al := strings.Split(a, "\n")
+	bl := strings.Split(b, "\n")
+	for i := 0; i < len(al) || i < len(bl); i++ {
+		var x, y string
+		if i < len(al) {
+			x = al[i]
+		}
+		if i < len(bl) {
+			y = bl[i]
+		}
+		if x != y {
+			return i, x, y
+		}
+	}
+	return -1, "", ""
+}
+
+// hzDiffClass names the kind of the first difference: a blank line, a comment or code.
+func hzDiffClass(a, b string) string {
+	_, x, y := hzFirstDiffLine(a, b)
+	if strings.TrimSpace(x) == "" || strings.TrimSpace(y) == "" {
+		return "blank line"
+	}
+	if strings.Contains(x, "//") || strings.Contains(x, "/*") || strings.Contains(y, "//") || strings.Contains(y, "/*") {
+		return "comment"
+	}
+	return "code"
+}
+
+// hzShowDiff prints both texts with a marker on the first differing line.
+func hzShowDiff(want, got string) string {
+	i, _, _ := hzFirstDiffLine(want, got)
+	mark := func(s string) string {
+		l := strings.Split(s, "\n")
+		for j := range l {
+			if j == i {
+				l[j] = ">>> " + l[j]
+			} else {
+				l[j] = "    " + l[j]
+			}
+		}
+		return strings.Join(l, "\n")
+	}
+	return fmt.Sprintf("first difference at line %d\n--- first:\n%s\n--- second:\n%s", i+1, mark(want), mark(got))
+}
