diff --git a/hegel/hegel_zoo_const_test.go b/hegel/hegel_zoo_const_test.go
new file mode 100644
index 0000000..b3e7061
--- /dev/null
+++ b/hegel/hegel_zoo_const_test.go
@@ -0,0 +1,219 @@
+package hegel
+
+// TestHegelConstValues: the constants of a file of const declarations (lone and grouped,
+// with iota, implicit repetition, comments and empty lines between them) have the same
+// values after gofumpt, as go/types evaluates them.
+
+import (
+	"fmt"
+	"go/ast"
+	"go/importer"
+	"go/parser"
+	"go/token"
+	"go/types"
+	"sort"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+	"mvdan.cc/gofumpt/format"
+)
+
+// --------------------------------------------------------------------------- data
+
+// hzConstValuePool: the values of the constants (most of them depend on iota).
+var hzConstValuePool = []string{"iota", "iota", "iota + 1", "iota * 2", "1 << iota", "3", "-1", "iota - 1", "len(\"ab\")", "1.5", "'a'", "\"s\"", "true", "iota == 2"}
+
+// The gap before a declaration (after the first): nothing, an empty line, a comment line, an
+// empty line and a comment line.
+const (
+	gapNone = iota
+	gapBlank
+	gapComment
+	gapBlankComment
+)
+
+var gaps = hegel.SampledFrom([]int{gapNone, gapNone, gapNone, gapBlank, gapComment, gapBlankComment})
+
+// The kinds of declaration: a lone const, a const group with implicit repetition, a var.
+const (
+	constLone = iota
+	constGroup
+	constVar
+)
+
+var constKinds = hegel.SampledFrom([]int{constLone, constLone, constGroup, constVar})
+
+// constSpec is one spec of a group: an empty line before it, and either a bare name (the
+// implicit repetition of the previous spec) or a value.
+type constSpec struct {
+	blank bool
+	bare  bool
+	value int
+}
+
+var constSpecs = hegel.Composite(func(tc hegel.TestCase) constSpec {
+	return constSpec{
+		blank: hegel.Draw(tc, chance(30)),
+		bare:  hegel.Draw(tc, chance(30)),
+		value: hegel.Draw(tc, hegel.Integers(0, len(hzConstValuePool)-1)),
+	}
+})
+
+// constItem is one top-level declaration of the const file.
+type constItem struct {
+	gap      int
+	c        lineCmt
+	kind     int
+	value    int
+	specs    []constSpec
+	varValue string
+}
+
+var constItems = hegel.Composite(func(tc hegel.TestCase) constItem {
+	return constItem{
+		gap:      hegel.Draw(tc, gaps),
+		c:        hegel.Draw(tc, lineCmts),
+		kind:     hegel.Draw(tc, constKinds),
+		value:    hegel.Draw(tc, hegel.Integers(0, len(hzConstValuePool)-1)),
+		specs:    hegel.Draw(tc, many(constSpecs, 1, 4)),
+		varValue: hegel.Draw(tc, pick("1", "2.5", "\"v\"")),
+	}
+})
+
+type constFile struct {
+	items []constItem
+}
+
+var constFiles = hegel.Composite(func(tc hegel.TestCase) constFile {
+	return constFile{items: hegel.Draw(tc, many(constItems, 1, 6))}
+})
+
+// --------------------------------------------------------------------------- rendering
+
+// hzRenderConst writes the const file: the names are k1, k2, ... in order.
+func hzRenderConst(f constFile, tape []trivia) string {
+	w := &hzWriter{tape: tape}
+	w.w("package p\n\n")
+	names := 0
+	fresh := func() string { names++; return fmt.Sprintf("k%d", names) }
+	value := func(i int) string { return hzConstValuePool[i] }
+	prevConst := false
+	for i, it := range f.items {
+		blank := false
+		if i > 0 {
+			switch it.gap {
+			case gapBlank:
+				w.w("\n")
+				blank = true
+			case gapComment:
+				w.w(w.lineComment(it.c) + "\n")
+			case gapBlankComment:
+				w.w("\n" + w.lineComment(it.c) + "\n")
+				blank = true
+			}
+		}
+		if it.kind != constVar && prevConst && !blank && HZKnown.constIotaGrouped {
+			// Adjacent const declarations (a lone one after a lone one or a group) reach the
+			// recorded bug: an empty line breaks the chain.
+			hzAvoid("constIotaGrouped")
+			w.w("\n")
+		}
+		prevConst = it.kind != constVar
+		switch it.kind {
+		case constGroup:
+			// A group with implicit repetition.
+			w.w("const (" + w.eol())
+			for j, s := range it.specs {
+				if j > 0 && s.blank {
+					w.w("\n")
+				}
+				if j > 0 && s.bare {
+					w.w("\t" + fresh() + w.eol())
+					continue
+				}
+				w.w("\t" + fresh() + " = " + value(s.value) + w.eol())
+			}
+			w.w(")" + w.eol())
+		case constVar:
+			w.w("var " + fresh() + " = " + it.varValue + w.eol())
+		default:
+			w.w("const " + fresh() + " = " + value(it.value) + w.eol())
+		}
+	}
+	return w.sb.String()
+}
+
+// constCase is one case of TestHegelConstValues.
+type constCase struct {
+	file constFile
+	tape []trivia
+	opts format.Options
+}
+
+func (c constCase) source() string { return hzRenderConst(c.file, c.tape) }
+
+func (c constCase) GoString() string {
+	return fmt.Sprintf("constCase{%s, source:\n%s}", hzOptString(c.opts), strings.TrimRight(c.source(), "\n"))
+}
+
+var constCases = hegel.Composite(func(tc hegel.TestCase) constCase {
+	return constCase{
+		file: hegel.Draw(tc, constFiles),
+		tape: hegel.Draw(tc, tapes),
+		opts: hegel.Draw(tc, hzOptions),
+	}
+})
+
+// --------------------------------------------------------------------------- oracle
+
+// hzConstValues type-checks the source and lists its package-level constants and their
+// values.
+func hzConstValues(src string) ([]string, error) {
+	fset := token.NewFileSet()
+	f, err := parser.ParseFile(fset, "p.go", src, parser.ParseComments)
+	if err != nil {
+		return nil, err
+	}
+	conf := types.Config{Importer: importer.Default()}
+	pkg, err := conf.Check("p", fset, []*ast.File{f}, nil)
+	if err != nil {
+		return nil, err
+	}
+	var out []string
+	for _, name := range pkg.Scope().Names() {
+		if c, ok := pkg.Scope().Lookup(name).(*types.Const); ok {
+			out = append(out, name+" = "+c.Val().ExactString())
+		}
+	}
+	sort.Strings(out)
+	return out, nil
+}
+
+func TestHegelConstValues(t *testing.T) {
+	c := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		cc := hegel.Draw(ht, constCases)
+		src := cc.source()
+		want, err := hzConstValues(src)
+		if err != nil {
+			ht.Fatalf("the generated constants do not type-check: %v\n%s", err, src)
+		}
+		o := cc.opts
+		out, err, p := hzFumpt(src, o)
+		if p != nil || err != nil {
+			c.failClass(ht, "error", "gofumpt fails: %v %v\n%s\nsource:\n%s", p, err, hzOptString(o), src)
+			return
+		}
+		got, err := hzConstValues(out)
+		if err != nil {
+			c.failClass(ht, "invalid", "gofumpt's output does not type-check: %v\n%s\noutput:\n%s\nsource:\n%s", err, hzOptString(o), out, src)
+			return
+		}
+		if !hzEqStrings(want, got) {
+			c.failClass(ht, "values", "the constants change value\nsource: %v\noutput: %v\n%s\noutput:\n%s\nsource:\n%s", want, got, hzOptString(o), out, src)
+			return
+		}
+		c.count("ok")
+	})
+}
diff --git a/hegel/hegel_zoo_gen_test.go b/hegel/hegel_zoo_gen_test.go
new file mode 100644
index 0000000..e504ff8
--- /dev/null
+++ b/hegel/hegel_zoo_gen_test.go
@@ -0,0 +1,1485 @@
+package hegel
+
+// The grammar of the generated Go source files, as generator values: a file is a tree
+// (package clause, imports, declarations, statements, expressions, types) whose nodes carry
+// their comments and empty lines as data, rendered to text by the pure writer in
+// hegel_zoo_render_test.go. The spacing at token gaps (a block comment between two tokens,
+// a trailing comment at the end of a line) is read from a drawn tape recycled modulo its
+// length, so an empty tape renders the plain text and that is what a case shrinks to. The
+// tree holds the shapes gofumpt's rules act on (a newline after an assignment operator,
+// empty lines around bodies and inside literals and field lists, single-spec var groups,
+// adjacent lone declarations, mixed import groups, multi-line case clauses, octal literals,
+// comments without a space, var statements, useless parentheses, gofmt -s shapes, naked
+// returns) and the shapes of the recorded bugs at their natural rate; under HEGEL_NO_KNOWN=1
+// the writer and the fixup pass keep the recorded shapes out.
+//
+// The grammar is built once (hzFiles); its recursion goes through forward references read
+// when drawn, with depth counters in the closure (hegel-go's ExampleComposite_recursive,
+// restored by defer) and a statement budget per file, the fallbacks inside the weighted
+// choice's own span so that a case stays under the engine's nesting cap.
+
+import (
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- comments
+
+// A comment's body is "cN" (numbered by the writer), plain or decorated: non-ASCII text
+// after it, empty, a long text, a tab inside, trailing spaces (gofmt strips them from line
+// comments).
+const (
+	cmtPlain = iota
+	cmtNonASCII
+	cmtEmpty
+	cmtLong
+	cmtTab
+	cmtTrailing
+)
+
+var cmtKinds = hegel.SampledFrom([]int{cmtPlain, cmtPlain, cmtPlain, cmtPlain, cmtPlain, cmtPlain, cmtPlain, cmtNonASCII, cmtEmpty, cmtLong, cmtTab, cmtTrailing})
+
+// hzDirectivePool: the whole texts a line comment is 15% of the time: directives (which
+// gofumpt's comment-spacing rule and go/printer's doc-comment formatting treat specially),
+// code-like comments, and near misses.
+var hzDirectivePool = []string{
+	"//go:noinline", "//nolint:all", "//lint:ignore SA1000 x", "//export F", "//#nosec G101", "//NOSONAR",
+	"//sys foo()", "//noinspection X", "//line a.go:1", "//x := 1", "//}", "//{", "//TODO: x", "//\tcode()", "//c.d", "//go-sumtype:decl T", "//extern f", "//nolintx", "//sysx", "//a:b", "//1st", "//!x",
+}
+
+// hzGaps: the spacing after the // of a line comment (gofumpt adds a space to //c).
+var hzGaps = []string{" ", "", "  ", "\t"}
+
+// lineCmt is a // comment: its body kind, the gap after the //, and (when directive is not
+// 0) the whole text from hzDirectivePool instead.
+type lineCmt struct {
+	text      int
+	gap       int
+	directive int
+}
+
+var lineCmts = hegel.Composite(func(tc hegel.TestCase) lineCmt {
+	return lineCmt{
+		text:      hegel.Draw(tc, cmtKinds),
+		gap:       hegel.Draw(tc, hegel.Integers(0, len(hzGaps)-1)),
+		directive: hegel.Draw(tc, maybe(15, hegel.Integers(1, len(hzDirectivePool)))),
+	}
+})
+
+// blockCmt is a one-line /* */ comment; tight leaves out the space inside a delimiter.
+type blockCmt struct {
+	text           int
+	tightL, tightR bool
+}
+
+var blockCmts = hegel.Composite(func(tc hegel.TestCase) blockCmt {
+	return blockCmt{text: hegel.Draw(tc, cmtKinds), tightL: hegel.Draw(tc, chance(50)), tightR: hegel.Draw(tc, chance(50))}
+})
+
+// multiCmt is a /* */ comment over two to three lines: the first line's body, one or two
+// more lines with their own indentation, the closing */ on a line of its own or not.
+type multiLine struct {
+	indent int // 0 none, 1 three spaces, 2 a tab
+	text   int
+}
+
+var multiLines = hegel.Composite(func(tc hegel.TestCase) multiLine {
+	return multiLine{indent: hegel.Draw(tc, hegel.Integers(0, 2)), text: hegel.Draw(tc, cmtKinds)}
+})
+
+type multiCmt struct {
+	text     int
+	more     []multiLine
+	closeOwn bool
+}
+
+var multiCmts = hegel.Composite(func(tc hegel.TestCase) multiCmt {
+	return multiCmt{text: hegel.Draw(tc, cmtKinds), more: hegel.Draw(tc, many(multiLines, 1, 2)), closeOwn: hegel.Draw(tc, chance(50))}
+})
+
+// piece is one item between two lines of a list (statements, declarations, fields): an
+// empty line, a whole-line comment of some kind, two comment lines, or an empty line, a
+// comment and an empty line.
+const (
+	pieceBlank = iota
+	pieceLine
+	pieceBlock
+	pieceMulti
+	pieceTwoLines
+	pieceBlankLineBlank
+)
+
+type piece struct {
+	kind   int
+	c1, c2 lineCmt
+	blk    blockCmt
+	multi  multiCmt
+}
+
+var pieces = weighted(
+	choice[piece]{weight: 3, gen: hegel.Just(piece{kind: pieceBlank})},
+	choice[piece]{weight: 3, gen: hegel.Map(lineCmts, func(c lineCmt) piece { return piece{kind: pieceLine, c1: c} })},
+	choice[piece]{weight: 1, gen: hegel.Map(blockCmts, func(c blockCmt) piece { return piece{kind: pieceBlock, blk: c} })},
+	choice[piece]{weight: 1, gen: hegel.Map(multiCmts, func(c multiCmt) piece { return piece{kind: pieceMulti, multi: c} })},
+	choice[piece]{weight: 1, gen: hegel.Composite(func(tc hegel.TestCase) piece {
+		return piece{kind: pieceTwoLines, c1: hegel.Draw(tc, lineCmts), c2: hegel.Draw(tc, lineCmts)}
+	})},
+	choice[piece]{weight: 1, gen: hegel.Map(lineCmts, func(c lineCmt) piece { return piece{kind: pieceBlankLineBlank, c1: c} })},
+)
+
+// betweens: what goes between two items of a list: zero to two pieces.
+var betweens = many(pieces, 0, 2)
+
+// rarely: betweens pct percent of the time, nothing otherwise.
+func rarely(pct int) hegel.Generator[[]piece] { return maybe(pct, betweens) }
+
+// --------------------------------------------------------------------------- the trivia tape
+
+// trivia is one entry of the tape the writer reads at a token gap: sp decides whether a
+// block comment stands between two tokens (6% for sp, 5% for sp0, and how it is padded),
+// eol whether a line ends in a trailing comment (12% a line comment, 4% a block comment, 2%
+// both), and the comments themselves. The zero entry is a plain space and a plain newline.
+type trivia struct {
+	sp   int
+	eol  int
+	line lineCmt
+	blk  blockCmt
+}
+
+var trivias = hegel.Composite(func(tc hegel.TestCase) trivia {
+	return trivia{
+		sp:   hegel.Draw(tc, hegel.Integers(0, 99)),
+		eol:  hegel.Draw(tc, hegel.Integers(0, 99)),
+		line: hegel.Draw(tc, lineCmts),
+		blk:  hegel.Draw(tc, blockCmts),
+	}
+})
+
+// tapes: up to eighty entries; a file with more gaps recycles them.
+var tapes = many(trivias, 0, 80)
+
+// --------------------------------------------------------------------------- pools
+
+var (
+	hzIdents    = []string{"a", "b", "c", "x", "y", "i", "n", "s", "ch", "err", "p", "m"}
+	hzTypeNames = []string{"int", "string", "bool", "byte", "T1", "T2", "error", "any", "float64", "rune"}
+	idents      = hegel.SampledFrom(hzIdents)
+	typeNames   = hegel.SampledFrom(hzTypeNames)
+)
+
+// literals: every literal form: small and larger decimal integers, the integer spellings
+// (hexadecimal, octal old and new, binary, underscores), floats, imaginaries, runes,
+// strings (with escapes and non-ASCII text), raw strings on one line and over lines, and
+// the predeclared words.
+var literals = weighted(
+	choice[string]{weight: 4, gen: hegel.Map(hegel.Integers(0, 9), itoa)},
+	choice[string]{weight: 1, gen: hegel.Map(hegel.Integers(0, 1000), itoa)},
+	choice[string]{weight: 1, gen: pick("0x1F", "0o17", "0b1010", "1_000_000", "017", "0X_ff", "0755", "0_7", "00", "0", "0o_17", "0O17", "01_2")},
+	choice[string]{weight: 1, gen: pick("1.5", "1e9", ".5", "1.", "0x1p-2", "2.5e-3")},
+	choice[string]{weight: 1, gen: pick("2i", "1.5i", "0i")},
+	choice[string]{weight: 1, gen: pick("'a'", "'\\n'", "'\\x41'", "'\\u00e9'", "'\\''")},
+	choice[string]{weight: 1, gen: pick(`"s"`, `""`, `"tab\there"`, `"quote\"d"`, `"line\n"`, `"é"`)},
+	choice[string]{weight: 1, gen: hegel.Just("`raw`")},
+	choice[string]{weight: 1, gen: hegel.Just("`raw\nmulti\n\tline`")},
+	choice[string]{weight: 1, gen: pick("true", "false", "nil", "iota")},
+)
+
+// --------------------------------------------------------------------------- the tree
+
+// expr, typ, stmt and decl are the nodes of the tree; each renders itself through the
+// writer (hegel_zoo_render_test.go).
+type (
+	expr interface{ render(w *hzWriter) string }
+	typ  interface {
+		render(w *hzWriter, indent string) string
+	}
+	stmt interface{ render(w *hzWriter, indent string) }
+	decl interface{ render(w *hzWriter) }
+)
+
+// ---- types
+
+type (
+	nameType  struct{ name string }
+	ptrType   struct{ elem typ }
+	sliceType struct{ elem typ }
+	arrayType struct {
+		n    int
+		elem typ
+	}
+	mapType  struct{ key, elem typ }
+	chanType struct {
+		dir  string
+		elem typ
+	}
+	funcType struct {
+		params  fieldList
+		results results
+	}
+	pkgType     struct{ name string }
+	genericType struct {
+		name string
+		args []typ // one or two
+	}
+	parenType struct{ elem typ }
+	// structType: fields, or (with none) the empty type; space: "struct {" against "struct{".
+	structType struct {
+		fields []field
+		empty  emptyBraces
+		space  bool
+	}
+	ifaceType struct {
+		methods []method
+		empty   emptyBraces
+		space   bool
+	}
+)
+
+// emptyBraces is the inside of an empty struct or interface type: a gap read from the tape
+// (sp0, twice as likely), a newline, an empty line, or a block comment (in a parameter or
+// result list the comment reaches gofumpt/10, and a newline gofumpt/13 with group_params).
+const (
+	emptyGap = iota
+	emptyNewline
+	emptyBlankLine
+	emptyComment
+)
+
+type emptyBraces struct {
+	kind int
+	blk  blockCmt
+}
+
+var emptyBracesGen = weighted(
+	choice[emptyBraces]{weight: 2, gen: hegel.Just(emptyBraces{kind: emptyGap})},
+	choice[emptyBraces]{weight: 1, gen: hegel.Just(emptyBraces{kind: emptyNewline})},
+	choice[emptyBraces]{weight: 1, gen: hegel.Just(emptyBraces{kind: emptyBlankLine})},
+	choice[emptyBraces]{weight: 1, gen: hegel.Map(blockCmts, func(c blockCmt) emptyBraces { return emptyBraces{kind: emptyComment, blk: c} })},
+)
+
+// field is a struct field: plain (twice as likely), embedded, two names, or tagged.
+const (
+	fieldPlain = iota
+	fieldEmbedded
+	fieldTwoNames
+	fieldTagged
+)
+
+type field struct {
+	pre  []piece
+	kind int
+	a, b string
+	tn   string // the embedded type's name
+	t    typ
+	tag  string
+}
+
+// method is an interface element: a method (twice as likely), an embedded interface, or a
+// union.
+const (
+	methodMethod = iota
+	methodEmbedded
+	methodUnion
+)
+
+type method struct {
+	pre     []piece
+	kind    int
+	n       int // M1..M3
+	embed   string
+	union   string
+	params  fieldList
+	results results
+}
+
+// fieldList is a parameter list: the parameters (with none, an empty list whose inside is a
+// gap or a newline), named or not, inline, one per line or split over lines, and whether
+// the last one is variadic (where the list allows it).
+const (
+	layoutInline = iota
+	layoutPerLine
+	layoutSplit
+)
+
+type fieldList struct {
+	params   []param
+	named    bool
+	layout   int
+	emptyNL  bool // no parameters: a newline inside the parentheses (else a gap)
+	variadic bool
+}
+
+// param is one parameter: one or two names (when named), its type; or, in place of the type,
+// an empty struct or interface type (10%); or two parameters of the same empty type, one of
+// them written over lines (8%, the shape of gofumpt/13 with group_params).
+type param struct {
+	a, b      string
+	two       bool
+	t         typ
+	emptyT    *emptyType
+	pairEmpty *emptyPair
+}
+
+type emptyType struct {
+	iface  bool
+	space  bool
+	braces emptyBraces
+}
+
+type emptyPair struct {
+	a, b   string
+	iface  bool
+	braces emptyBraces
+}
+
+// results: none, one type, two types, two named, one named.
+type results struct {
+	kind   int
+	a, b   string
+	t1, t2 typ
+}
+
+// ---- expressions
+
+type (
+	identExpr struct{ name string }
+	litExpr   struct{ lit string }
+	// binaryExpr: a sp() before and after the operator (a block comment right after / would
+	// start a line comment: none there).
+	binaryExpr struct {
+		op   string
+		a, b expr
+	}
+	unaryExpr struct {
+		op string
+		a  expr
+	}
+	selectorExpr struct {
+		base expr
+		name string
+	}
+	indexExpr struct{ a, i expr }
+	sliceExpr struct {
+		a      expr
+		lo, hi *expr
+		max    *expr // only with hi
+	}
+	assertExpr struct {
+		a expr
+		t typ
+	}
+	parenExpr struct {
+		a      expr
+		double bool
+	}
+	poolExpr struct{ text string }
+	convExpr struct {
+		t typ
+		a expr
+	}
+	instExpr struct {
+		fn   string
+		args []typ // one or two
+		a    expr
+	}
+	structLitExpr struct{ a expr }
+	funcLitExpr   struct {
+		params  fieldList
+		results results
+		body    body
+	}
+)
+
+// callExpr is a call: a function name from the pool or (15%) an expression; the arguments;
+// multi puts them one per line, and then variadic makes the last the identifier vararg
+// followed by ..., and closing says where the ) goes: on a line of its own, on the last
+// argument's line, or (the first argument on the opening line) after the arguments with or
+// without a trailing comma. Inline, variadic makes the last argument vararg followed by ...
+const (
+	closingOwnLine = iota
+	closingLastLine
+	closingFirstOnOpen
+)
+
+type callExpr struct {
+	fn       string
+	fnExpr   expr
+	args     []expr
+	makeT    typ // for make and new: the type first
+	vararg   string
+	multi    bool
+	variadic bool
+	closing  int
+	comma    bool
+}
+
+// compositeExpr is a composite literal: a type from the pool, elements (plain, keyed by an
+// identifier or a literal, a nested literal with or without its type), and a layout: inline,
+// newlines between some elements, empty lines around the elements, one element per line.
+const (
+	eltPlain = iota
+	eltIdentKey
+	eltLitKey
+	eltNested
+	eltNestedTyped
+)
+
+const (
+	litInline = iota
+	litSomeNewlines
+	litBlankLines
+	litPerLine
+)
+
+type elt struct {
+	kind int
+	key  string
+	lit  string
+	t    string
+	v    expr
+}
+
+type compositeExpr struct {
+	t      string
+	elts   []elt
+	layout int
+}
+
+// ---- statements
+
+// simpleStmt: a call, a short declaration, a two-value assignment, an operator assignment,
+// an increment, a send, or an error check (x, err := f()). nl puts the value on the next
+// line after the operator (gofumpt joins it).
+const (
+	simpleCall = iota
+	simpleDefine
+	simpleTwo
+	simpleOpAssign
+	simpleIncDec
+	simpleSend
+	simpleErrCheck
+)
+
+type simpleStmt struct {
+	kind   int
+	a, b   string
+	tok    string // := or =
+	op     string
+	incdec string
+	x, y   expr
+	nl     bool
+	call   callExpr
+}
+
+// varStmt: var x T [= e]; var x = e / var x, _ = e, e (a var statement gofumpt makes a short
+// assignment, cont puts the value on the next line, blank makes the last name _); or a
+// one-spec var group.
+const (
+	varTyped = iota
+	varAssign
+	varGroup
+)
+
+type varStmt struct {
+	kind    int
+	a, b    string
+	t       typ
+	x, y    expr
+	hasInit bool
+	two     bool
+	blank   bool
+	cont    int
+	c       lineCmt
+}
+
+// The continuation of a var statement's value: on the same line, on the next line, or on
+// the next line after a comment (gofumpt/3's shape).
+const (
+	contSpace = iota
+	contNewline
+	contComment
+)
+
+var conts = hegel.SampledFrom([]int{contSpace, contSpace, contSpace, contSpace, contNewline, contComment, contComment})
+
+// spec is one spec of a var/const group: a bare name (const: a repeated expression; var: a
+// typed name), a typed name, a name with a value, two names with a type and two values, or
+// a name with a multi-line raw string value.
+const (
+	specBare = iota
+	specTyped
+	specValue
+	specTwo
+	specRaw
+)
+
+type spec struct {
+	pre  []piece
+	kind int
+	a, b string
+	t    typ
+	x, y expr
+}
+
+// groupDecl is a grouped var/const declaration (a statement or a top-level declaration):
+// its specs, pieces before the first spec (20%) and inside an empty group (50%), and a doc
+// comment on the only spec of a one-spec group (40%); one makes a statement's var group a
+// one-spec group of only (which gofumpt unwraps).
+type groupDecl struct {
+	kw    string
+	specs []spec
+	one   bool
+	only  spec
+	first []piece
+	lead  []piece
+	doc   *lineCmt
+}
+
+type typeStmt struct {
+	name  string
+	alias bool
+	t     typ
+}
+
+// ifStmt: an if/else chain, or (errCheck) the shape of the error-check rule: x, err := f()
+// then if err != nil { return } with a gap of none, one or two empty lines.
+type elif struct {
+	cond expr
+	then body
+}
+
+type ifStmt struct {
+	errCheck bool
+	name     string
+	call     callExpr
+	gap      int
+	init     *simpleStmt
+	cond     expr
+	then     body
+	elifs    []elif
+	els      *body
+}
+
+// forStmt: for {}, for cond, a three-clause loop, a fixed three-clause form, a range with
+// a key/value form, or a bare range.
+const (
+	forPlain = iota
+	forCond
+	forThree
+	forFixed
+	forRangeKV
+	forRange
+)
+
+type forStmt struct {
+	kind    int
+	a, b, c string
+	x       expr
+	fixed   string
+	kv      string
+	tok     string
+	then    body
+}
+
+// clause is a case clause of a switch: default (only last, 40%), a type case with one or
+// two types (or nil), a case list spanning lines (30%: two or three expressions, or
+// directed: a long identifier and a short one, with a trailing comment carrying trailing
+// spaces), or one or two expressions inline.
+type clause struct {
+	pre       []piece
+	isDefault bool
+	t1, t2    typ
+	extra     int // type case: 0 one type, 1 a second type, 2 ", nil"
+	multi     bool
+	exprs     []expr // two or three
+	directed  bool
+	yLen      int
+	id        string
+	trail     lineCmt
+	trailSp   int // 0 two spaces, 1 one, 2 a tab
+	x, y      expr
+	second    bool
+	body      caseBody
+}
+
+type switchStmt struct {
+	init       *simpleStmt
+	typeSwitch bool
+	bind       string // "" or "x := "
+	subject    int    // type switch: 0 ident, 1 ident.ident, 2 a call
+	a, b       string
+	call       callExpr
+	tag        *expr
+	clauses    []clause
+	lead       []piece
+	tail       []piece
+}
+
+const (
+	selRecv = iota
+	selDefault
+	selSend
+	selRecvAssign
+)
+
+type selClause struct {
+	pre  []piece
+	kind int
+	a, b string
+	ok   bool
+	tok  string
+	x    expr
+	body caseBody
+}
+
+type selectStmt struct {
+	clauses []selClause
+	lead    []piece
+}
+
+// retStmt: a bare return, one result, or two.
+type retStmt struct {
+	kind int
+	x, y expr
+}
+
+type goDeferStmt struct {
+	kw   string
+	call callExpr
+}
+
+// labelStmt: a label (on its own line or before the statement) on a for loop or a simple
+// statement, and 50% of the time a goto/break/continue to it after some pieces.
+type labelStmt struct {
+	ownLine bool
+	isFor   bool
+	then    body
+	simple  simpleStmt
+	jump    string // "" none
+	jumpPre []piece
+}
+
+type (
+	branchStmt struct{ kw string }
+	blockStmt  struct{ then body }
+	recvStmt   struct{ x *expr } // nil: <-ch
+	dblCallStmt struct{ fn string }
+	simpleOnly  struct{ s simpleStmt }
+	varOnly     struct{ s varStmt }
+	groupStmt   struct{ g groupDecl }
+)
+
+// multiRet is the return that may close a block: two results, the first a call with its
+// arguments over lines, under a prefix ("", "- " or parentheses).
+type multiRet struct {
+	pre    []piece
+	prefix int
+	call   callExpr
+	x      expr
+}
+
+// body is the inside of a block: pieces before the first statement (or in an empty body),
+// the statements each with the pieces before it, 8% of the time a multiRet closing the
+// block, and pieces before the closing brace: 10% of the time, or 60% after a return whose
+// results span lines (the shape gofumpt's empty-line rules look at).
+type item struct {
+	pre []piece
+	s   stmt
+}
+
+type body struct {
+	lead   []piece
+	items  []item
+	multi  *multiRet
+	tail   []piece
+	tail60 []piece
+}
+
+// caseBody is the body of a case clause: as a body, without the multiRet and the 10% tail.
+type caseBody struct {
+	lead   []piece
+	items  []item
+	tail60 []piece
+}
+
+// ---- declarations
+
+// loneVar: a lone var declaration: 40% a call split after its parenthesis (the balance_calls
+// rule) with a trailing comment half of the time, else var x with a type, a value, both, or
+// a value on the next line.
+const (
+	varFormType = iota
+	varFormValue
+	varFormTypeValue
+	varFormNextLine
+)
+
+type loneVar struct {
+	balance bool
+	name    string
+	callee  string
+	args    []expr // one or two
+	cmt     *lineCmt
+	form    int
+	t       typ
+	x       expr
+}
+
+// loneRow: two or three lone declarations of one kind in a row (gofumpt groups them), each
+// with a doc comment 30% of the time (often a third-party directive), the first 40% of the
+// time with a value over two lines that go/printer puts on one.
+type loneItem struct {
+	doc   int // 0 none, else hzLoneDocs[doc-1] ("line": the line comment c)
+	c     lineCmt
+	name  string
+	value expr
+}
+
+type loneRow struct {
+	kw      string
+	items   []loneItem
+	twoLine int // 0 none, else hzTwoLineValues[twoLine-1]
+}
+
+var (
+	hzLoneDocs      = []string{"line", "line", "//noinspection X", "//#nosec G101", "//NOSONAR", "//sys foo()", "//nolint"}
+	hzTwoLineValues = []string{"struct {\n}{}", "[]int{\n}", "interface {\n}(nil)", "len([1]int{\n})", "map[string]int{\n}"}
+)
+
+type loneConst struct {
+	name string
+	x    expr
+}
+
+type typeDecl struct {
+	name    string
+	tparams string
+	alias   bool
+	t       typ
+}
+
+type typeSpec struct {
+	pre  []piece
+	name string
+	t    typ
+}
+
+type typeGroup struct{ specs []typeSpec }
+
+type recv struct {
+	named  bool
+	name   string
+	ptr    bool
+	tparam bool
+}
+
+type funcDecl struct {
+	recv     *recv
+	tparams  string
+	params   fieldList
+	results  results
+	external bool
+	then     body
+}
+
+type groupTop struct{ g groupDecl }
+
+// docCmt is the doc comment before a top-level declaration: a line comment (three times as
+// likely), a block comment, //go:noinline, two line comments around an empty //, or an
+// indented line followed by a plain one (gofumpt/5's shape when the last is respaced).
+const (
+	docLine = iota
+	docBlock
+	docNoinline
+	docEmptyMiddle
+	docIndented
+)
+
+type docCmt struct {
+	kind   int
+	c1, c2 lineCmt
+	blk    blockCmt
+	tab    bool
+	t1, t2 int
+}
+
+type declItem struct {
+	pre []piece
+	doc *docCmt
+	d   decl
+}
+
+// ---- imports
+
+// importSpec is a member of an import group: a path from the pool, an alias (none, fK, a
+// dot or a blank), an empty line before it, and a doc comment 15% of the time.
+type importSpec struct {
+	path  int
+	alias int // 0 none, 1 none, 2 fK, 3 dot, 4 blank
+	blank bool
+	doc   *lineCmt
+}
+
+var hzImportPaths = []string{`"fmt"`, `"os"`, `"strings"`, `"go/ast"`, `"github.com/x/y"`, `"foo.com/bar"`, `"mycorp/mod1/sub"`, `"test/x"`, `"example/y"`, `"a/b.com/c"`, `"sort"`, `"zz.dev/q"`}
+
+// imports: none; one or two lone imports (gofumpt groups two; directed: a std import
+// sorting after a third-party one and the file ending in a comment group right after them,
+// gofumpt/14's shape); or an import group (three times as likely).
+const (
+	importsNone = iota
+	importsLone
+	importsGroup
+)
+
+type imports struct {
+	kind         int
+	second       bool
+	p1, p2       int // indices into the lone pools
+	name1, name2 int
+	gap          bool
+	directed     bool
+	directedOs   bool
+	tailDir      int // the directive starting the file-ending comment group
+	tailText     int
+	specs        []importSpec
+	trail        []piece
+	after        []piece
+}
+
+var (
+	hzLonePaths1 = []string{`"fmt"`, `"foo.com/bar"`, `"os"`}
+	hzLonePaths2 = []string{`"strings"`, `"github.com/x/y"`}
+	hzLoneNames1 = []string{"", "f ", ". ", "_ "}
+	hzLoneNames2 = []string{"", "_ "}
+	hzTailDirs   = []string{"//nolint:all", "//#nosec G101", "//NOSONAR"}
+)
+
+// ---- the file
+
+type fileSpec struct {
+	lead      []piece
+	head      *lineCmt
+	headBlank bool
+	buildTag  bool
+	pkg       string
+	afterPkg  []piece
+	imports   imports
+	firstPre  bool // the pieces before the first declaration are written (40%)
+	decls     []declItem
+	tail      []piece
+}
+
+// --------------------------------------------------------------------------- the grammar
+
+const (
+	maxStmtDepth = 3 // blocks nested inside blocks (function literals count)
+	maxExprDepth = 2 // compound expressions inside compound expressions
+	maxTypeDepth = 2 // type constructors inside type constructors
+)
+
+// newGrammar builds the file generator once.
+func newGrammar() hegel.Generator[fileSpec] {
+	sdepth, edepth, tdepth, budget := 0, 0, 0, 0
+	// Forward references of the grammar's cycles, read when drawn.
+	var (
+		exprs  hegel.Generator[expr]
+		types  hegel.Generator[typ]
+		stmts  hegel.Generator[stmt]
+		bodies hegel.Generator[body]
+	)
+
+	// ---- types ---------------------------------------------------------
+
+	leafTypes := hegel.Map(typeNames, func(n string) typ { return nameType{n} })
+	// deeperType builds a type one level down.
+	deeperType := func(build func(tc hegel.TestCase) typ) hegel.Generator[typ] {
+		return hegel.Composite(func(tc hegel.TestCase) typ {
+			tdepth++
+			defer func() { tdepth-- }()
+			return build(tc)
+		})
+	}
+
+	var fieldLists func(variadic bool) hegel.Generator[fieldList]
+	var resultsGen hegel.Generator[results]
+
+	fields := hegel.Composite(func(tc hegel.TestCase) field {
+		return field{
+			pre:  hegel.Draw(tc, betweens),
+			kind: hegel.Draw(tc, hegel.SampledFrom([]int{fieldPlain, fieldPlain, fieldEmbedded, fieldTwoNames, fieldTagged})),
+			a:    hegel.Draw(tc, idents),
+			b:    hegel.Draw(tc, idents),
+			tn:   hegel.Draw(tc, typeNames),
+			t:    hegel.Draw(tc, types),
+			tag:  hegel.Draw(tc, idents),
+		}
+	})
+	structTypes := deeperType(func(tc hegel.TestCase) typ {
+		return structType{fields: hegel.Draw(tc, many(fields, 0, 3)), empty: hegel.Draw(tc, emptyBracesGen), space: hegel.Draw(tc, chance(50))}
+	})
+	methods := hegel.Composite(func(tc hegel.TestCase) method {
+		return method{
+			pre:     hegel.Draw(tc, betweens),
+			kind:    hegel.Draw(tc, hegel.SampledFrom([]int{methodMethod, methodMethod, methodEmbedded, methodUnion})),
+			n:       hegel.Draw(tc, hegel.Integers(1, 3)),
+			embed:   hegel.Draw(tc, pick("fmt.Stringer", "T1", "comparable")),
+			union:   hegel.Draw(tc, pick("~int", "int | string", "~int | ~string")),
+			params:  hegel.Draw(tc, fieldLists(false)),
+			results: hegel.Draw(tc, resultsGen),
+		}
+	})
+	ifaceTypes := deeperType(func(tc hegel.TestCase) typ {
+		return ifaceType{methods: hegel.Draw(tc, many(methods, 0, 3)), empty: hegel.Draw(tc, emptyBracesGen), space: hegel.Draw(tc, chance(50))}
+	})
+	compoundTypes := weighted(
+		choice[typ]{weight: 1, gen: deeperType(func(tc hegel.TestCase) typ { return ptrType{hegel.Draw(tc, types)} })},
+		choice[typ]{weight: 1, gen: deeperType(func(tc hegel.TestCase) typ { return sliceType{hegel.Draw(tc, types)} })},
+		choice[typ]{weight: 1, gen: deeperType(func(tc hegel.TestCase) typ {
+			return arrayType{n: hegel.Draw(tc, hegel.Integers(0, 5)), elem: hegel.Draw(tc, types)}
+		})},
+		choice[typ]{weight: 1, gen: deeperType(func(tc hegel.TestCase) typ {
+			return mapType{key: hegel.Draw(tc, types), elem: hegel.Draw(tc, types)}
+		})},
+		choice[typ]{weight: 1, gen: deeperType(func(tc hegel.TestCase) typ {
+			return chanType{dir: hegel.Draw(tc, pick("chan ", "<-chan ", "chan<- ")), elem: hegel.Draw(tc, types)}
+		})},
+		choice[typ]{weight: 1, gen: deeperType(func(tc hegel.TestCase) typ {
+			return funcType{params: hegel.Draw(tc, fieldLists(false)), results: hegel.Draw(tc, resultsGen)}
+		})},
+		choice[typ]{weight: 1, gen: structTypes},
+		choice[typ]{weight: 1, gen: ifaceTypes},
+		choice[typ]{weight: 1, gen: hegel.Map(pick("Type", "Reader"), func(n string) typ { return pkgType{n} })},
+		choice[typ]{weight: 1, gen: deeperType(func(tc hegel.TestCase) typ {
+			return genericType{name: hegel.Draw(tc, pick("List", "Map")), args: hegel.Draw(tc, many(types, 1, 2))}
+		})},
+		choice[typ]{weight: 1, gen: deeperType(func(tc hegel.TestCase) typ { return parenType{hegel.Draw(tc, types)} })},
+	)
+	types = weightedOr(func() hegel.Generator[typ] {
+		if tdepth >= maxTypeDepth {
+			return leafTypes
+		}
+		return nil
+	}, choice[typ]{weight: 2, gen: leafTypes}, choice[typ]{weight: 3, gen: compoundTypes})
+
+	emptyTypes := hegel.Composite(func(tc hegel.TestCase) emptyType {
+		return emptyType{iface: hegel.Draw(tc, chance(50)), space: hegel.Draw(tc, chance(50)), braces: hegel.Draw(tc, emptyBracesGen)}
+	})
+	emptyPairs := hegel.Composite(func(tc hegel.TestCase) emptyPair {
+		return emptyPair{a: hegel.Draw(tc, idents), b: hegel.Draw(tc, idents), iface: hegel.Draw(tc, chance(50)), braces: hegel.Draw(tc, emptyBracesGen)}
+	})
+	params := hegel.Composite(func(tc hegel.TestCase) param {
+		return param{
+			a:         hegel.Draw(tc, idents),
+			b:         hegel.Draw(tc, idents),
+			two:       hegel.Draw(tc, chance(20)),
+			t:         hegel.Draw(tc, types),
+			emptyT:    hegel.Draw(tc, optional(10, emptyTypes)),
+			pairEmpty: hegel.Draw(tc, optional(8, emptyPairs)),
+		}
+	})
+	layouts := weighted(
+		choice[int]{weight: 75, gen: hegel.Just(layoutInline)},
+		choice[int]{weight: 15, gen: hegel.Just(layoutPerLine)},
+		choice[int]{weight: 10, gen: hegel.Just(layoutSplit)},
+	)
+	fieldLists = func(variadic bool) hegel.Generator[fieldList] {
+		variadics := hegel.Just(false)
+		if variadic {
+			variadics = chance(20)
+		}
+		return hegel.Composite(func(tc hegel.TestCase) fieldList {
+			return fieldList{
+				params:   hegel.Draw(tc, many(params, 0, 3)),
+				named:    hegel.Draw(tc, chance(60)),
+				layout:   hegel.Draw(tc, layouts),
+				emptyNL:  hegel.Draw(tc, chance(33)),
+				variadic: hegel.Draw(tc, variadics),
+			}
+		})
+	}
+	resultsGen = hegel.Composite(func(tc hegel.TestCase) results {
+		return results{
+			kind: hegel.Draw(tc, hegel.Integers(0, 4)),
+			a:    hegel.Draw(tc, idents),
+			b:    hegel.Draw(tc, idents),
+			t1:   hegel.Draw(tc, types),
+			t2:   hegel.Draw(tc, types),
+		}
+	})
+
+	// ---- expressions ---------------------------------------------------
+
+	leafExprs := weighted(
+		choice[expr]{weight: 1, gen: hegel.Map(idents, func(n string) expr { return identExpr{n} })},
+		choice[expr]{weight: 1, gen: hegel.Map(literals, func(l string) expr { return litExpr{l} })},
+	)
+	// deeper builds an expression one level down.
+	deeper := func(build func(tc hegel.TestCase) expr) hegel.Generator[expr] {
+		return hegel.Composite(func(tc hegel.TestCase) expr {
+			edepth++
+			defer func() { edepth-- }()
+			return build(tc)
+		})
+	}
+	closings := weighted(
+		choice[int]{weight: 60, gen: hegel.Just(closingOwnLine)},
+		choice[int]{weight: 25, gen: hegel.Just(closingLastLine)},
+		choice[int]{weight: 15, gen: hegel.Just(closingFirstOnOpen)},
+	)
+	// calls: named keeps the function a plain name (go and defer need a call, not a
+	// parenthesised one); multi forces the arguments over lines (the block-closing return).
+	calls := func(named, multi bool) hegel.Generator[callExpr] {
+		fnExprs, multis, lo := hegel.Just[expr](nil), chance(15), 0
+		if !named {
+			// exprs is assigned after the calls are built: a late reference.
+			fnExprs = weighted(choice[expr]{weight: 85, gen: hegel.Just[expr](nil)}, later(15, &exprs))
+		}
+		if multi {
+			multis, lo = hegel.Just(true), 1
+		}
+		return hegel.Composite(func(tc hegel.TestCase) callExpr {
+			c := callExpr{
+				fn:      hegel.Draw(tc, pick("f", "g.m", "x.y.z", "fmt.Println", "make", "len", "append", "new", "panic")),
+				fnExpr:  hegel.Draw(tc, fnExprs),
+				args:    hegel.Draw(tc, many(exprs, lo, 3)),
+				vararg:  hegel.Draw(tc, idents),
+				multi:   hegel.Draw(tc, multis),
+				closing: hegel.Draw(tc, closings),
+				comma:   hegel.Draw(tc, chance(50)),
+			}
+			if c.fn == "make" || c.fn == "new" {
+				c.makeT = hegel.Draw(tc, types)
+			}
+			if c.multi {
+				c.variadic = hegel.Draw(tc, chance(30))
+			} else {
+				c.variadic = hegel.Draw(tc, chance(15))
+			}
+			return c
+		})
+	}
+	plainCalls := calls(false, false)
+	namedCalls := calls(true, false)
+	multiCalls := calls(false, true)
+
+	elts := hegel.Composite(func(tc hegel.TestCase) elt {
+		return elt{
+			kind: hegel.Draw(tc, hegel.SampledFrom([]int{eltPlain, eltPlain, eltIdentKey, eltIdentKey, eltLitKey, eltLitKey, eltNested, eltNestedTyped})),
+			key:  hegel.Draw(tc, idents),
+			lit:  hegel.Draw(tc, literals),
+			t:    hegel.Draw(tc, pick("T1", "&T1", "[]int", "T2", "pkg.T")),
+			v:    hegel.Draw(tc, exprs),
+		}
+	})
+	litLayouts := weighted(
+		choice[int]{weight: 65, gen: hegel.Just(litInline)},
