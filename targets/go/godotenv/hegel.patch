+// Package hegel holds the zoo's Hegel property tests for godotenv. See the
+// target's README.
+package hegel
diff --git a/hegel/hegel_dotenv_test.go b/hegel/hegel_dotenv_test.go
new file mode 100644
index 0000000..270766d
--- /dev/null
+++ b/hegel/hegel_dotenv_test.go
@@ -0,0 +1,392 @@
+package hegel
+
+import (
+	"bufio"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"testing"
+	"unicode/utf8"
+
+	"github.com/joho/godotenv"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Generators.
+
+// keys is the alphabet of variable names: [A-Za-z0-9_.], never a name of the
+// process environment.
+var keys = []string{"A", "B", "C", "FOO", "BAR_1", "a", "bar", "K.1", "_X", "1A", "Mixed_Case", "Z9"}
+
+// refs are the names variable references use: the keys, a name set in the
+// environment of both parsers (ZOO_PRE=pre), and names set nowhere.
+var refs = append(append([]string(nil), keys...), "ZOO_PRE", "NOPE", "nope", "Zoo_Pre")
+
+// words is the alphabet of value pieces that mean the same in every quoting.
+var words = []string{"x", "y", "hello", "123", "a b", "=", ":", ";", "é", "日本", "😀", "'", "\"", "\\", "#", "{}", "$", "http://h:80/p?q=1"}
+
+// unquotedWords are the words allowed in an unquoted value: no backslash
+// (unquoted escapes differ between Ruby and Node dotenv, and godotenv follows
+// Node), no # (a # starts a comment in Ruby and Node, in godotenv only after
+// a space: a tested divergence).
+var unquotedWords = func() []string {
+	var ws []string
+	for _, w := range words {
+		if !strings.ContainsAny(w, "\\#") {
+			ws = append(ws, w)
+		}
+	}
+	return ws
+}()
+
+var (
+	word    = hegel.SampledFrom(words)
+	refName = hegel.SampledFrom(refs)
+
+	// reference is a variable reference: $NAME, ${NAME}, or an escaped \$NAME.
+	reference = hegel.OneOf(
+		prefixed("$", refName),
+		hegel.Map(refName, func(name string) string { return "${" + name + "}" }),
+		prefixed("\\$", refName))
+
+	// newline is a line break inside a quoted value, with a comment-looking
+	// tail one time in three.
+	newline = hegel.SampledFrom([]string{"\n", " # c\n", "\r\n"})
+	blank   = hegel.SampledFrom([]string{" ", "\t", "  "})
+)
+
+// unquoted is an unquoted value: one to four words or references, a blank
+// between two pieces three times in ten, never starting with a quote.
+var unquoted = hegel.Map(seq(unquotedPiece, many(seq(optional(30, blank), unquotedPiece), 3)), func(s string) string {
+	if s == "" || s[0] == '\'' || s[0] == '"' {
+		return "v" + s
+	}
+	return s
+})
+
+var unquotedPiece = weighted(choice[string]{7, hegel.SampledFrom(unquotedWords)}, choice[string]{3, reference})
+
+// singleInside is a single-quoted value's inside: anything but an unescaped
+// quote; \' is an escaped quote (kept literally by both); newlines allowed.
+var singleInside = hegel.Map(many(weighted(
+	choice[string]{3, word},
+	choice[string]{1, reference},
+	choice[string]{1, hegel.Just("\\'")},
+	choice[string]{1, hegel.SampledFrom([]string{"\\n", "\\\\", "\\t", "\\$"})},
+	choice[string]{1, newline}), 4), func(s string) string {
+	s = strings.ReplaceAll(s, "'", "\\'")
+	// Ruby's regex reads any backslash before a quote as an escape (no
+	// parity), godotenv counts backslashes: keep single backslashes before
+	// quotes and none before the closing quote.
+	s = manyBackslashesBeforeQuote.ReplaceAllString(s, "\\'")
+	return strings.TrimRight(s, "\\")
+})
+
+var manyBackslashesBeforeQuote = regexp.MustCompile(`\\{2,}'`)
+
+// doubleWord is a word with its backslashes and double quotes escaped.
+var doubleWord = hegel.Map(word, func(w string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(w, "\\", "\\\\"), "\"", "\\\"")
+})
+
+// doubleInside is a double-quoted value's inside: words, references, escapes
+// (\n \r \t \\ \" \$ \q \'), newlines; never ending in a backslash.
+var doubleInside = hegel.Map(many(weighted(
+	choice[string]{3, doubleWord},
+	choice[string]{1, reference},
+	choice[string]{1, hegel.SampledFrom([]string{"\\n", "\\r", "\\t", "\\\\", "\\\"", "\\$", "\\q", "\\'"})},
+	choice[string]{1, newline}), 4), func(s string) string { return strings.TrimRight(s, "\\") })
+
+type entry struct {
+	key, raw string // raw is the value as written, quotes included
+	quote    byte   // 0, '\'' or '"'
+}
+
+// value is the right-hand side of an entry as written and its quoting.
+type value struct {
+	raw   string
+	quote byte
+}
+
+var (
+	emptyValue    = hegel.Just(value{})
+	unquotedValue = hegel.Map(unquoted, func(s string) value { return value{s, 0} })
+	singleValue   = hegel.Map(singleInside, func(s string) value { return value{"'" + s + "'", '\''} })
+	doubleValue   = hegel.Map(doubleInside, func(s string) value { return value{"\"" + s + "\"", '"'} })
+
+	// anyValue: empty one time in five, unquoted two, single- and
+	// double-quoted one each.
+	anyValue = weighted(choice[value]{1, emptyValue}, choice[value]{2, unquotedValue}, choice[value]{1, singleValue}, choice[value]{1, doubleValue})
+
+	// exportedValue is never empty: Ruby reads "export KEY=" as "export KEY"
+	// (an error, or no change when KEY is defined); godotenv and Node dotenv
+	// set "".
+	exportedValue = weighted(choice[value]{3, unquotedValue}, choice[value]{1, singleValue}, choice[value]{1, doubleValue})
+)
+
+// line is one line of a .env text, without its line end, and the entry it
+// declares, if any.
+type line struct {
+	text  string
+	entry *entry
+}
+
+var (
+	blankLine       = hegel.Map(hegel.SampledFrom([]string{"", " ", "\t"}), func(s string) line { return line{s, nil} })
+	commentLine     = hegel.Map(seq(hegel.SampledFrom([]string{"", "  ", "\t"}), hegel.Just("#"), hegel.SampledFrom([]string{"", " comment", "A=1", " export B=2"})), func(s string) line { return line{s, nil} })
+	indentedComment = hegel.Just(line{"   # c", nil})
+
+	leading    = hegel.SampledFrom([]string{"", "", "", " ", "\t"})
+	export     = optional(20, prefixed("export", blank))
+	separator  = weighted(choice[string]{85, hegel.SampledFrom([]string{"=", "=", "=", " = ", "= ", " ="})}, choice[string]{15, hegel.Just(": ")}) // yaml-ish, Ruby needs the space
+	trailing   = optional(25, blank)
+	endComment = optional(20, hegel.SampledFrom([]string{" #", " # c", "\t# c", " #A=1"}))
+
+	// entryLine is KEY=value with optional leading whitespace, export prefix,
+	// trailing whitespace and end-of-line comment; the value depends on the
+	// export prefix.
+	entryLine = hegel.Composite(func(tc hegel.TestCase) line {
+		lead, exp := hegel.Draw(tc, leading), hegel.Draw(tc, export)
+		key := hegel.Draw(tc, hegel.SampledFrom(keys))
+		sep := hegel.Draw(tc, separator)
+		values := anyValue
+		if exp != "" {
+			values = exportedValue
+		}
+		v := hegel.Draw(tc, values)
+		tail := hegel.Draw(tc, trailing) + hegel.Draw(tc, endComment)
+		return line{lead + exp + key + sep + v.raw + tail, &entry{key, v.raw, v.quote}}
+	})
+
+	// envLine is an entry two times in three, else a blank line, a comment or
+	// an indented comment.
+	envLine = weighted(choice[line]{1, blankLine}, choice[line]{1, commentLine}, choice[line]{1, indentedComment}, choice[line]{6, entryLine})
+
+	eol = hegel.SampledFrom([]string{"\n", "\n", "\n", "\r\n"})
+)
+
+type env struct {
+	text    string
+	entries []*entry
+}
+
+// dotenv is a .env text of up to six lines with one line end (CRLF one time
+// in four), the final line end dropped one time in five.
+var dotenv = hegel.Composite(func(tc hegel.TestCase) env {
+	end := hegel.Draw(tc, eol)
+	var b strings.Builder
+	var es []*entry
+	for _, l := range hegel.Draw(tc, hegel.Lists(envLine).MaxSize(6)) {
+		b.WriteString(l.text + end)
+		if l.entry != nil {
+			es = append(es, l.entry)
+		}
+	}
+	s := b.String()
+	if hegel.Draw(tc, chance(20)) {
+		s = strings.TrimSuffix(s, end)
+	}
+	return env{s, es}
+})
+
+// marshalMap is a map of up to five values of up to three pieces: words,
+// newlines, tabs, references, comment markers, quotes and $(x).
+var marshalMap = hegel.Maps(hegel.SampledFrom(keys), many(hegel.SampledFrom(append(append([]string(nil), words...),
+	"\n", "\r", "\t", " ", "\\n", "$A", "${A}", "\\$A", " # c", "\"q\"", "'q'", "$(x)")), 3)).MaxSize(5)
+
+// ---------------------------------------------------------------------------
+// Oracle: Ruby dotenv in a child process.
+
+type oracle struct {
+	cmd *exec.Cmd
+	in  io.WriteCloser
+	out *bufio.Reader
+}
+
+var ruby *oracle
+
+func TestMain(m *testing.M) {
+	os.Setenv("ZOO_PRE", "pre")
+	os.Unsetenv("NOPE")
+	code := m.Run()
+	if ruby != nil {
+		ruby.in.Close()
+		ruby.cmd.Wait()
+	}
+	os.Exit(code)
+}
+
+func startOracle(t testing.TB) {
+	if ruby != nil {
+		return
+	}
+	wd, _ := os.Getwd()
+	cmd := exec.Command("ruby", filepath.Join(wd, "oracle.rb"))
+	cmd.Env = []string{
+		"PATH=" + os.Getenv("PATH"),
+		"HOME=" + os.Getenv("HOME"), // user gems
+		"LANG=C.UTF-8",
+		"ZOO_PRE=pre",
+		"DOTENV_LINEBREAK_MODE=legacy",
+	}
+	for _, k := range []string{"GEM_HOME", "GEM_PATH"} {
+		if v, ok := os.LookupEnv(k); ok {
+			cmd.Env = append(cmd.Env, k+"="+v)
+		}
+	}
+	in, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	out, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd.Stderr = os.Stderr
+	if err := cmd.Start(); err != nil {
+		t.Fatalf("starting ruby: %v", err)
+	}
+	ruby = &oracle{cmd, in, bufio.NewReader(out)}
+	// a first request checks the gem is there
+	if _, err := ruby.parse("A=1\n"); err != nil {
+		t.Fatalf("ruby dotenv not usable: %v", err)
+	}
+}
+
+// parse asks Ruby dotenv for the map of text; an error is Ruby's rejection.
+func (o *oracle) parse(text string) (map[string]string, error) {
+	if _, err := fmt.Fprintf(o.in, "%s\n", hex.EncodeToString([]byte(text))); err != nil {
+		panic(fmt.Sprintf("oracle write: %v", err))
+	}
+	line, err := o.out.ReadString('\n')
+	if err != nil {
+		panic(fmt.Sprintf("oracle read: %v", err))
+	}
+	line = strings.TrimSuffix(line, "\n")
+	if strings.HasPrefix(line, "error ") {
+		msg, _ := hex.DecodeString(line[6:])
+		return nil, fmt.Errorf("%s", msg)
+	}
+	if !strings.HasPrefix(line, "ok") {
+		panic("oracle said " + line)
+	}
+	m := map[string]string{}
+	for _, f := range strings.Fields(line[2:]) {
+		k, v, _ := strings.Cut(f, "=")
+		kb, _ := hex.DecodeString(k)
+		vb, _ := hex.DecodeString(v)
+		m[string(kb)] = string(vb)
+	}
+	return m, nil
+}
+
+func showMap(m map[string]string) string {
+	ks := make([]string, 0, len(m))
+	for k := range m {
+		ks = append(ks, k)
+	}
+	sort.Strings(ks)
+	var b strings.Builder
+	for _, k := range ks {
+		fmt.Fprintf(&b, "  %q=%q\n", k, m[k])
+	}
+	return b.String()
+}
+
+// ---------------------------------------------------------------------------
+// Properties.
+
+// TestHegelParseMatchesRuby: Parse of a generated .env text gives the map
+// Ruby dotenv gives.
+func TestHegelParseMatchesRuby(t *testing.T) {
+	startOracle(t)
+	property(t, func(ht *hegel.T) {
+		e := hegel.Draw(ht, dotenv)
+		if !utf8.ValidString(e.text) {
+			panic("generator made invalid UTF-8")
+		}
+		want, rerr := ruby.parse(e.text)
+		// A text Ruby rejects (with or without godotenv) gives nothing to
+		// compare.
+		ht.Assume(rerr == nil)
+		got, gerr := unmarshal(e.text)
+		if gerr != nil {
+			ht.Assume(knownReject(e, gerr) == "")
+			ht.Fatalf("godotenv rejects (%v), Ruby dotenv gives\n%stext %q", gerr, showMap(want), e.text)
+		}
+		ht.Assume(known(e, got, want) == "")
+		for _, k := range sortedKeys(want, got) {
+			gv, gok := got[k]
+			wv, wok := want[k]
+			if gok != wok || gv != wv {
+				ht.Fatalf("key %q: godotenv %q (present %v), Ruby dotenv %q (present %v)\ngot:\n%swant:\n%stext %q",
+					k, gv, gok, wv, wok, showMap(got), showMap(want), e.text)
+			}
+		}
+	})
+}
+
+// unmarshal is godotenv.Unmarshal with panics turned into errors.
+func unmarshal(text string) (m map[string]string, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			err = fmt.Errorf("panic: %v", r)
+		}
+	}()
+	return godotenv.Unmarshal(text)
+}
+
+func sortedKeys(ms ...map[string]string) []string {
+	seen := map[string]bool{}
+	var ks []string
+	for _, m := range ms {
+		for k := range m {
+			if !seen[k] {
+				seen[k] = true
+				ks = append(ks, k)
+			}
+		}
+	}
+	sort.Strings(ks)
+	return ks
+}
+
+// TestHegelMarshalRoundTrip: Marshal of a map parses back to the same map
+// with godotenv and with Ruby dotenv.
+func TestHegelMarshalRoundTrip(t *testing.T) {
+	startOracle(t)
+	property(t, func(ht *hegel.T) {
+		m := hegel.Draw(ht, marshalMap)
+		text, err := godotenv.Marshal(m)
+		if err != nil {
+			ht.Fatalf("Marshal(%s): %v", showMap(m), err)
+		}
+		ht.Assume(knownMarshal(m, text) == "")
+		got, err := godotenv.Unmarshal(text)
+		if err != nil {
+			ht.Fatalf("Unmarshal(Marshal(m)): %v\nm:\n%stext %q", err, showMap(m), text)
+		}
+		if showMap(got) != showMap(m) {
+			ht.Fatalf("Unmarshal(Marshal(m)) differs\nm:\n%sgot:\n%stext %q", showMap(m), showMap(got), text)
+		}
+		// A backslash before n or r, or a trailing one: the references read
+		// Marshal's output differently, so only the package's own round trip
+		// is judged.
+		if !rubyCannotRead(m) {
+			want, rerr := ruby.parse(text)
+			if rerr != nil {
+				ht.Fatalf("Ruby dotenv rejects Marshal's output: %v\nm:\n%stext %q", rerr, showMap(m), text)
+			}
+			if showMap(want) != showMap(m) {
+				ht.Fatalf("Ruby dotenv reads Marshal's output differently\nm:\n%sruby:\n%stext %q", showMap(m), showMap(want), text)
+			}
+		}
+	})
+}
diff --git a/hegel/hegel_pins_test.go b/hegel/hegel_pins_test.go
new file mode 100644
index 0000000..8b2be97
--- /dev/null
+++ b/hegel/hegel_pins_test.go
@@ -0,0 +1,73 @@
+package hegel
+
+import (
+	"testing"
+
+	"github.com/joho/godotenv"
+)
+
+// Pins: one deterministic reproducer per bug in bugs.toml. Each fails while
+// its bug is open. The expectations are what Ruby dotenv 3.2.0 (with
+// DOTENV_LINEBREAK_MODE=legacy) and Node dotenv 18 give for the same text.
+
+func parse(t *testing.T, text string) map[string]string {
+	t.Helper()
+	m, err := godotenv.Unmarshal(text)
+	if err != nil {
+		t.Fatalf("Unmarshal(%q): %v", text, err)
+	}
+	return m
+}
+
+// godotenv/1: a variable reference names any variable, in any case (Ruby
+// dotenv's pattern is case-insensitive, dotenv-expand's is \w+); godotenv's
+// pattern is [A-Z0-9_]+, so $low stays literal and ${Mixed_Case} substitutes
+// M and leaves ixed_Case}.
+func TestHegelPinLowerCaseReference(t *testing.T) {
+	m := parse(t, "low=2\nC=$low ${low}\nMixed_Case=5\nD=${Mixed_Case}\n")
+	if m["C"] != "2 2" {
+		t.Errorf("C=$low ${low} with low=2: %q; Ruby dotenv gives %q", m["C"], "2 2")
+	}
+	if m["D"] != "5" {
+		t.Errorf("D=${Mixed_Case} with Mixed_Case=5: %q; Ruby dotenv gives %q", m["D"], "5")
+	}
+}
+
+// godotenv/2: a value that is only a comment (KEY= # comment, KEY=#comment)
+// is the empty string; godotenv panics with an index out of range.
+func TestHegelPinCommentAsValuePanics(t *testing.T) {
+	for _, text := range []string{"A= # to be filled in\n", "A=#c\n", "A: # c\n"} {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					t.Errorf("Unmarshal(%q) panics: %v; Ruby and Node dotenv give A=\"\"", text, r)
+				}
+			}()
+			m := parse(t, text)
+			if m["A"] != "" {
+				t.Errorf("Unmarshal(%q): A=%q, want \"\"", text, m["A"])
+			}
+		}()
+	}
+}
+
+// godotenv/3: a quoted value ending with an escaped quote loses the quote:
+// the value between the quotes is trimmed of every quote character at both
+// ends instead of one.
+func TestHegelPinEscapedQuoteBeforeClosingQuote(t *testing.T) {
+	if m := parse(t, "B='it\\''\n"); m["B"] != "it\\'" {
+		t.Errorf("B='it\\'': %q; Ruby and Node dotenv give %q", m["B"], "it\\'")
+	}
+	if m := parse(t, "B=\"a\\\"\"\n"); m["B"] != "a\"" {
+		t.Errorf("B=\"a\\\"\": %q; Ruby dotenv gives %q", m["B"], "a\"")
+	}
+	// The package's own round trip.
+	in := map[string]string{"Q": "say \"hi\""}
+	text, err := godotenv.Marshal(in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if out := parse(t, text); out["Q"] != in["Q"] {
+		t.Errorf("Unmarshal(Marshal(%q)) = %q (text %q)", in["Q"], out["Q"], text)
+	}
+}
diff --git a/hegel/hegel_test.go b/hegel/hegel_test.go
new file mode 100644
index 0000000..3260f1c
--- /dev/null
+++ b/hegel/hegel_test.go
@@ -0,0 +1,108 @@
+package hegel
+
+// Hegel property tests for godotenv: generated .env texts, parsed by this
+// package and by Ruby dotenv (the library it is a port of), must give the
+// same map.
+//
+// Needs ruby with the dotenv gem.
+
+import (
+	"os"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+// property runs fn as a Hegel test; a panic in the harness (the oracle's
+// pipe, say) fails the test case instead of aborting the test binary
+// (hegel-go re-raises panics after shrinking).
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the harness: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// ---------------------------------------------------------------------------
+// Generator helpers.
+
+// weighted chooses among generators in proportion to integer weights with
+// one draw; it shrinks towards the first choice, so the simplest comes first.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false.
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// optional generates a draw from g pct percent of the time, else ""; it
+// shrinks to "".
+func optional(pct int, g hegel.Generator[string]) hegel.Generator[string] {
+	return weighted(choice[string]{100 - pct, hegel.Just("")}, choice[string]{pct, g})
+}
+
+func prefixed(prefix string, g hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Map(g, func(s string) string { return prefix + s })
+}
+
+// seq generates the concatenation of one draw from each generator.
+func seq(gs ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gs {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+// many generates up to n draws from g, concatenated.
+func many(g hegel.Generator[string], n int) hegel.Generator[string] {
+	return hegel.Map(hegel.Lists(g).MaxSize(n), func(parts []string) string { return strings.Join(parts, "") })
+}
diff --git a/hegel/known.go b/hegel/known.go
new file mode 100644
index 0000000..4feba3a
--- /dev/null
+++ b/hegel/known.go
@@ -0,0 +1,96 @@
+package hegel
+
+import (
+	"os"
+	"regexp"
+	"strings"
+)
+
+// Gates for the recorded bugs (bugs.toml). A case that has a known bug's
+// shape is discarded (Assume), not judged. HEGEL_NO_KNOWN=1 disables the
+// gates.
+
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") != ""
+
+// known returns the id of a recorded bug whose shape the text has, given
+// both parsers' maps, or "".
+func known(e env, got, want map[string]string) string {
+	if noKnown {
+		return ""
+	}
+	for _, en := range e.entries {
+		if en.quote != '\'' && lowerRef.MatchString(unescape(en.raw)) {
+			return "godotenv/1"
+		}
+		if en.quote != 0 && endsWithEscapedQuote(en.raw, en.quote) {
+			return "godotenv/3"
+		}
+	}
+	return ""
+}
+
+// endsWithEscapedQuote: the quoted raw value's content ends with an escaped
+// quote (an odd run of backslashes and the quote) before the closing quote.
+func endsWithEscapedQuote(raw string, q byte) bool {
+	if len(raw) < 4 || raw[len(raw)-1] != q || raw[len(raw)-2] != q {
+		return false
+	}
+	bs := 0
+	for i := len(raw) - 3; i >= 1 && raw[i] == '\\'; i-- {
+		bs++
+	}
+	return bs%2 == 1
+}
+
+// unescape removes the backslashes of escapes other than \$, as both parsers
+// do before expanding references (so "$\t" and "$B\t" name t and Bt).
+func unescape(raw string) string {
+	return escapes.ReplaceAllString(raw, "$1")
+}
+
+var escapes = regexp.MustCompile(`\\([^$])`)
+
+// lowerRef: an unescaped reference to a name with a lower-case letter.
+var lowerRef = regexp.MustCompile(`(^|[^\\])\$\{?[A-Za-z0-9_]*[a-z]`)
+
+// valueIsComment: a separator followed by spaces and a #.
+var valueIsComment = regexp.MustCompile(`[=:][ \t]*#`)
+
+// knownReject gates godotenv's rejections of texts Ruby dotenv accepts.
+func knownReject(e env, err error) string {
+	if noKnown {
+		return ""
+	}
+	if strings.Contains(err.Error(), "index out of range [-1]") && valueIsComment.MatchString(e.text) {
+		return "godotenv/2"
+	}
+	return ""
+}
+
+// knownMarshal gates Marshal outputs Ruby dotenv reads differently.
+func knownMarshal(m map[string]string, text string) string {
+	if noKnown {
+		return ""
+	}
+	for _, v := range m {
+		if strings.HasSuffix(v, "\"") {
+			return "godotenv/3"
+		}
+	}
+	return ""
+}
+
+// rubyCannotRead reports whether a value of m has a backslash followed by n
+// or r, or ends with a backslash: Marshal writes them as \\n and \\" and
+// Ruby dotenv (legacy line-break mode, expanding \n before unescaping \\;
+// a regex that reads any backslash before a quote as an escape) and Node
+// dotenv (the same regex) read them as a backslash and a newline, and as an
+// escaped quote. Limitations of the references, not of the package.
+func rubyCannotRead(m map[string]string) bool {
+	for _, v := range m {
+		if strings.Contains(v, "\\n") || strings.Contains(v, "\\r") || strings.HasSuffix(v, "\\") {
+			return true
+		}
+	}
+	return false
+}
diff --git a/hegel/oracle.rb b/hegel/oracle.rb
new file mode 100644
index 0000000..3633269
--- /dev/null
+++ b/hegel/oracle.rb
@@ -0,0 +1,20 @@
+# Oracle for the zoo's godotenv tests: Ruby dotenv's parser, one request per
+# line on stdin. Request: the .env text as hex (UTF-8). Reply: "ok" followed by
+# " <hexkey>=<hexvalue>" per pair, or "error <hexmessage>".
+#
+# Run with a controlled environment (DOTENV_LINEBREAK_MODE=legacy so that \n in
+# double quotes is a newline, as in godotenv and dotenv 2.x).
+require "dotenv"
+
+STDOUT.sync = true
+while (line = STDIN.gets)
+  text = [line.chomp].pack("H*").force_encoding("UTF-8")
+  begin
+    h = Dotenv::Parser.call(text)
+    out = "ok"
+    h.each { |k, v| out << " " << k.unpack1("H*") << "=" << v.to_s.unpack1("H*") }
+    puts out
+  rescue Exception => e # FormatError is a SyntaxError, not a StandardError
+    puts "error " + "#{e.class}: #{e.message}".unpack1("H*")
+  end
+end
