@@ -0,0 +1,1030 @@
+package jsonnet_test
+
+// A generator of Jsonnet programs. Expressions are generated by the kind
+// of value wanted (number, string, boolean, null, array, object, function)
+// with a few percent of deliberately mistyped operands, unknown variables,
+// failing asserts and `error`s, so that both implementations' error paths
+// are exercised too. Everything is bounded: no unbounded recursion, small
+// ranges and repeat counts, depth at most four.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+type kind int
+
+const (
+	kAny kind = iota
+	kNum
+	kStr
+	kBool
+	kNull
+	kArr
+	kObj
+	kFunc
+)
+
+var kindNames = map[kind]string{kNum: "number", kStr: "string", kBool: "boolean", kNull: "null", kArr: "array", kObj: "object", kFunc: "function"}
+
+type binding struct {
+	name       string
+	k          kind
+	arity      int  // functions: number of positional parameters
+	hasDefault bool // functions: has a parameter with a default
+}
+
+type gen struct {
+	tc      hegel.TestCase
+	vars    []binding
+	inObj   int  // > 0 inside an object body: self and $ are usable
+	superOK bool // inside the right operand of an object +: super is usable
+	compTop bool // inside a comprehension entered outside any object: $ is not bound in the C++ implementation
+	noFunc  bool // no function values (arguments of the YAML manifesters while Known.yamlFunction)
+	intOnly bool // only small integers (arguments of the JSON/YAML manifesters while Known.manifestNumber)
+	counter int
+	ext     map[string]string // external string variables
+	extc    map[string]string // external code variables
+}
+
+func newGen(tc hegel.TestCase) *gen { return &gen{tc: tc} }
+
+func (g *gen) n(lo, hi int) int         { return n(g.tc, lo, hi) }
+func (g *gen) chance(pct int) bool      { return chance(g.tc, pct) }
+func (g *gen) pick(xs ...string) string { return pick(g.tc, xs...) }
+
+func (g *gen) fresh(prefix string) string {
+	g.counter++
+	return fmt.Sprintf("%s%d", prefix, g.counter)
+}
+
+// ws is optional whitespace or a comment.
+func (g *gen) ws() string {
+	switch g.n(1, 20) {
+	case 1:
+		return "\n"
+	case 2:
+		return "  "
+	case 3:
+		return " // c\n"
+	case 4:
+		return " /* c */ "
+	case 5:
+		return " # c\n"
+	case 6:
+		return "\t"
+	case 7:
+		return ""
+	}
+	return " "
+}
+
+// ---------------------------------------------------------------------------
+// Literals.
+
+var numLits = []string{"0", "1", "2", "3", "7", "10", "42", "100", "255", "0.5", "1.5", "2.25", "1e3", "1E-3", "1.5e2", "3.14159", "1e308", "1e-308", "9007199254740993", "123456789012345678", "0.1", "1e21", "1e-7", "4.9e-324", "0.30000000000000004", "1000000", "65536", "2147483648", "0.000001", "12.5", "1e100", "1.7976931348623157e308", "5e-324", "0.2", "1e15", "1e16", "1e17", "99999999999999999", "0.1e1", "1.0", "8"}
+
+func (g *gen) numLit() string {
+	if g.intOnly {
+		return g.pick(strconv.Itoa(g.n(0, 1000)), strconv.Itoa(g.n(0, 20)), "0", "1", "-1", "42", "255", "1000000", "65536", "-7", "2147483648")
+	}
+	switch g.n(1, 10) {
+	case 1, 2:
+		return strconv.Itoa(g.n(0, 1000))
+	case 3:
+		return strconv.Itoa(g.n(0, 20))
+	case 4:
+		return "-" + g.pick(numLits...)
+	}
+	return g.pick(numLits...)
+}
+
+var strPieces = []string{"a", "b", "hello", "", " ", "0", "-1", "\u00e9", "\u2603", "\U0001F600", "'", "%", "{", "}", "[", "]", ":", ",", ".", "/", "\\", "\"", "x y", "A", "Z", "abc", "1.5", "true", "null", "\t", "\u00a0", "\u4e2d", "e", "E", "-", "+", "_"}
+
+// strLit is a string literal in one of Jsonnet's forms.
+func (g *gen) strLit() string {
+	k := g.n(0, 3)
+	var parts []string
+	for i := 0; i < k; i++ {
+		parts = append(parts, g.pick(strPieces...))
+	}
+	s := strings.Join(parts, "")
+	switch g.n(1, 12) {
+	case 1, 2:
+		// single quoted
+		return "'" + strings.NewReplacer("\\", "\\\\", "'", "\\'", "\n", "\\n", "\t", "\\t", "\x00", "\\u0000").Replace(s) + "'"
+	case 3:
+		// verbatim
+		if strings.ContainsAny(s, "\n\x00") {
+			return "@'" + strings.ReplaceAll(strings.NewReplacer("\n", "", "\x00", "").Replace(s), "'", "''") + "'"
+		}
+		return "@\"" + strings.ReplaceAll(s, "\"", "\"\"") + "\""
+	case 4:
+		// text block
+		lines := []string{}
+		for i := 0; i < g.n(1, 3); i++ {
+			l := g.pick("a", "b c", "  d", "\u00e9", "%s", "'x'", "\"y\"", "\\n", "|||", "z:")
+			lines = append(lines, "  "+l)
+		}
+		term := g.pick("|||", "|||", "|||-")
+		return "|||\n" + strings.Join(lines, "\n") + "\n" + term
+	case 5:
+		// escapes written out
+		return "\"" + g.pick(`\n`, `\t`, `\"`, `\\`, `\/`, `\b`, `\f`, `\r`, `\u00e9`, `\ud83d\ude00`, `\u2603`, `\uFFFF`, `a\nb`, `\u0041\u0042`) + "\""
+	}
+	return "\"" + strings.NewReplacer("\\", "\\\\", "\"", "\\\"", "\n", "\\n", "\t", "\\t", "\x00", "\\u0000").Replace(s) + "\""
+}
+
+// fieldName is an object field name, quoted when it must be.
+func (g *gen) fieldName() string {
+	nm := g.pick("a", "b", "c", "foo", "bar", "x", "y", "k", "name", "id")
+	switch g.n(1, 10) {
+	case 1:
+		return "\"" + g.pick("bar baz", "x-y", "", "1", "true", "self", "\u00e9", "a.b", "$") + "\""
+	case 2:
+		return "'" + nm + "'"
+	case 3:
+		return "[" + g.pick(g.strLit(), g.strLit(), "\"a\" + \"b\"", "std.toString(1)", "\"k\" + std.toString(2)", "std.asciiUpper(\"f\")") + "]" // computed (no object literal in here: the C++ desugarer loses track of self)
+	}
+	return nm
+}
+
+// ---------------------------------------------------------------------------
+// Expressions by kind.
+
+func (g *gen) expr(k kind, d int) string {
+	if k == kAny {
+		k = kind(g.n(int(kNum), int(kObj)))
+		if g.chance(3) && !g.noFunc {
+			k = kFunc
+		}
+	}
+	if g.chance(2) {
+		return g.wrong(k, d) // a deliberately mistyped or failing expression
+	}
+	if d <= 0 {
+		return g.atom(k)
+	}
+	switch g.n(1, 10) {
+	case 1:
+		return g.atom(k)
+	case 2:
+		return g.local(k, d)
+	case 3:
+		return g.ifThenElse(k, d)
+	case 4:
+		return g.viaStd(k, d)
+	case 5:
+		return g.callLocalFunc(k, d)
+	case 6:
+		return g.indexInto(k, d)
+	}
+	switch k {
+	case kNum:
+		return g.numExpr(d)
+	case kStr:
+		return g.strExpr(d)
+	case kBool:
+		return g.boolExpr(d)
+	case kNull:
+		return g.pick("null", "null", "if false then 1")
+	case kArr:
+		return g.arrExpr(d)
+	case kObj:
+		return g.objExpr(d)
+	case kFunc:
+		return g.funcExpr(d)
+	}
+	return "null"
+}
+
+func (g *gen) varOf(k kind) (binding, bool) {
+	var cands []binding
+	for _, b := range g.vars {
+		if b.k == k || (k == kAny && b.k != kFunc) {
+			cands = append(cands, b)
+		}
+	}
+	if len(cands) == 0 {
+		return binding{}, false
+	}
+	return cands[g.n(0, len(cands)-1)], true
+}
+
+func (g *gen) atom(k kind) string {
+	if b, ok := g.varOf(k); ok && g.chance(35) {
+		return b.name
+	}
+	if g.ext != nil && g.chance(15) {
+		switch k {
+		case kStr:
+			return "std.extVar(" + g.quoted(g.extName()) + ")"
+		case kNum:
+			if len(g.extc) > 0 {
+				return "std.extVar(" + g.quoted(g.extcName()) + ")"
+			}
+		}
+	}
+	switch k {
+	case kNum:
+		return g.numLit()
+	case kStr:
+		return g.strLit()
+	case kBool:
+		return g.pick("true", "false")
+	case kNull:
+		return "null"
+	case kArr:
+		if g.intOnly {
+			return g.pick("[]", "[1, 2, 3]", "[\"a\", \"b\"]", "[true, null]", "[[1], [2, 3]]", "[1, \"a\", null, {}]", "[3, 1, 2]")
+		}
+		return g.pick("[]", "[1, 2, 3]", "[\"a\", \"b\"]", "[true, null]", "[[1], [2, 3]]", "[1, \"a\", null, {}]", "[0.5, -1]", "[3, 1, 2]", "[\"b\", \"a\", \"c\"]")
+	case kObj:
+		return g.pick("{}", "{a: 1}", "{a: 1, b: \"x\"}", "{a: {b: [1]}}", "{\"x y\": null}", "{a:: 1, b: 2}", "{a: 1, b: self.a + 1}", "{b: 2, a: 1}")
+	case kFunc:
+		return g.pick("(function(x) x)", "(function(x) x + 1)", "(function(x) std.toString(x))", "(function(a, b) a + b)", "(function(x) x * 2)", "std.length", "std.toString", "(function(x) !x)", "(function(x) [x])")
+	}
+	return "null"
+}
+
+func (g *gen) quoted(s string) string { return strconv.Quote(s) }
+
+// wrong is an expression that is mistyped for k, or fails outright.
+func (g *gen) wrong(k kind, d int) string {
+	switch g.n(1, 8) {
+	case 1:
+		return "error " + g.expr(kStr, 0)
+	case 2:
+		return g.fresh("undefined") // an unknown variable: a static error
+	case 3:
+		return "(assert " + g.boolExpr(1) + " : " + g.strLit() + "; " + g.expr(k, 0) + ")"
+	case 4:
+		return g.pick(g.failing()...)
+	}
+	// mistyped: another kind
+	o := kind(g.n(int(kNum), int(kObj)))
+	if o == k {
+		o = kNull
+	}
+	return g.expr(o, d-1)
+}
+
+// failingExprs are expressions that fail (or are mistyped) on both sides.
+var failingExprs = []string{"1/0", "std.range(1, 3)[5]", "{a: 1}.b", "\"abc\"[10]", "std.parseInt(\"x\")", "std.char(-1)", "std.substr(\"a\", -1, 1)", "[1][-1]", "std.codepoint(\"\")", "std.strReplace(\"a\", \"\", \"b\")", "std.join(\",\", [1])", "std.parseJson(\"{\")", "{a: 1} + 1", "\"a\" - 1", "[1] * 2", "null.x", "1 in 2", "std.sort([1, \"a\"])", "std.mod(\"a\", 1)", "std.repeat(\"a\", -1)", "std.makeArray(-1, function(i) i)", "std.format(\"%d\", \"x\")", "std.format(\"%d %d\", [1])", "std.format(\"%z\", [1])", "std.base64Decode(\"!\")", "std.decodeUTF8([300])", "std.parseHex(\"g\")", "std.parseOctal(\"8\")", "std.pow(2, 1024) - std.pow(2, 1024)", "1e400", "std.sqrt(-1)", "std.log(0)", "std.asin(2)", "{a: 1, a: 2}", "{[null]: 1}", "{assert false}", "local x = x; x", "[1, 2][1:0][0]", "std.slice([1, 2, 3], 0, 3, 0)", "std.char(1114112)", "std.manifestJson(function() 1)", "[function() 1]", "std.toString(function() 1)", "{a: function() 1}", "std.objectFields(1)", "std.length(1)", "std.length(true)", "super.a", "self.a", "$.a", "std.native(\"x\")(1)", "std.extVar(\"nope\")", "std.thisFile", "importstr \"nope.txt\"", "import \"nope.jsonnet\"", "local f(x) = f(x); f(1)", "std.foldl(function(a, b) a + b, [1, \"a\"], 0)", "std.xor(1, 2)", "std.makeArray(2, function(a, b=1) a)", "std.parseInt(\"+3\")", "std.parseInt(\"-0\")"}
+
+// failing is failingExprs less the shapes gated by Known.
+func (g *gen) failing() []string {
+	var out []string
+	for _, e := range failingExprs {
+		switch {
+		case g.noFunc && strings.Contains(e, "function"):
+			continue
+		case Known.makeArraySize && (e == "std.makeArray(-1, function(i) i)" || e == "std.repeat(\"a\", -1)"):
+			continue
+		case Known.makeArrayArity && strings.HasPrefix(e, "std.makeArray(2,"):
+			continue
+		case Known.xorTypes && strings.HasPrefix(e, "std.xor("):
+			continue
+		case Known.parseIntPlus && e == "std.parseInt(\"+3\")":
+			continue
+		case Known.parseIntNegZero && e == "std.parseInt(\"-0\")":
+			continue
+		}
+		out = append(out, e)
+	}
+	return out
+}
+
+func (g *gen) local(k kind, d int) string {
+	m := g.n(1, 2)
+	var binds []string
+	var added []binding
+	for i := 0; i < m; i++ {
+		bk := kind(g.n(int(kNum), int(kObj)))
+		if g.chance(20) {
+			bk = kFunc
+		}
+		nm := g.fresh(g.pick("x", "y", "v", "t"))
+		var rhs string
+		b := binding{name: nm, k: bk}
+		if bk == kFunc {
+			arity := g.n(1, 2)
+			b.arity = arity
+			params := []string{}
+			for j := 0; j < arity; j++ {
+				p := g.fresh("p")
+				params = append(params, p)
+			}
+			if g.chance(30) {
+				params = append(params, g.fresh("q")+"="+g.atom(kNum))
+				b.hasDefault = true
+			}
+			// function body with the parameters in scope (as any)
+			saved := g.vars
+			for _, p := range params {
+				g.vars = append(g.vars, binding{name: strings.SplitN(p, "=", 2)[0], k: kAny})
+			}
+			body := g.expr(kAny, d-1)
+			g.vars = saved
+			if g.chance(50) {
+				binds = append(binds, nm+"("+strings.Join(params, ", ")+") = "+body)
+			} else {
+				binds = append(binds, nm+" = function("+strings.Join(params, ", ")+") "+body)
+			}
+		} else {
+			rhs = g.expr(bk, d-1)
+			binds = append(binds, nm+g.ws()+"="+g.ws()+rhs)
+		}
+		added = append(added, b)
+	}
+	saved := g.vars
+	g.vars = append(g.vars, added...)
+	body := g.expr(k, d-1)
+	g.vars = saved
+	if g.chance(50) && m == 1 {
+		return "local " + binds[0] + ";" + g.ws() + body
+	}
+	if g.chance(50) {
+		return "local " + strings.Join(binds, ", ") + ";" + g.ws() + body
+	}
+	var b strings.Builder
+	for _, bd := range binds {
+		b.WriteString("local " + bd + ";" + g.ws())
+	}
+	b.WriteString(body)
+	return b.String()
+}
+
+func (g *gen) ifThenElse(k kind, d int) string {
+	c := g.boolExpr(d - 1)
+	if g.chance(10) && k == kNull {
+		return "if " + c + " then " + g.expr(kNull, d-1)
+	}
+	return "if " + c + g.ws() + "then " + g.expr(k, d-1) + g.ws() + "else " + g.expr(k, d-1)
+}
+
+func (g *gen) callLocalFunc(k kind, d int) string {
+	var fs []binding
+	for _, b := range g.vars {
+		if b.k == kFunc {
+			fs = append(fs, b)
+		}
+	}
+	if len(fs) == 0 {
+		return g.recTemplate(k, d)
+	}
+	f := fs[g.n(0, len(fs)-1)]
+	args := []string{}
+	for i := 0; i < f.arity; i++ {
+		args = append(args, g.expr(kAny, d-1))
+	}
+	if g.chance(5) {
+		args = args[:len(args)/2] // too few
+	}
+	call := f.name + "(" + strings.Join(args, ", ") + ")"
+	if g.chance(10) && !(Known.tailstrictDefault && f.hasDefault) {
+		call += " tailstrict"
+	}
+	return call
+}
+
+// recTemplate is one of a few bounded recursive functions.
+func (g *gen) recTemplate(k kind, d int) string {
+	i := strconv.Itoa(g.n(0, 12))
+	switch g.n(1, 6) {
+	case 1:
+		return "(local fib(n) = if n < 2 then n else fib(n - 1) + fib(n - 2); fib(" + i + "))"
+	case 2:
+		return "(local fact(n) = if n <= 1 then 1 else n * fact(n - 1); fact(" + i + "))"
+	case 3:
+		return "(local loop(n, acc) = if n == 0 then acc else loop(n - 1, acc + [n]) tailstrict; loop(" + i + ", []))"
+	case 4:
+		return "(local sum(a, i=0, acc=0) = if i >= std.length(a) then acc else sum(a, i + 1, acc + a[i]) tailstrict; sum(" + g.arrOf(kNum, 1) + "))"
+	case 5:
+		return "(local f(x) = if std.type(x) == 'number' then x + 1 else if std.type(x) == 'array' then [f(e) for e in x] else x; f(" + g.expr(kAny, d-1) + "))"
+	}
+	return "(local deep(n) = if n == 0 then {} else {[\"k\" + n]: deep(n - 1)}; deep(" + i + "))"
+}
+
+func (g *gen) indexInto(k kind, d int) string {
+	switch g.n(1, 6) {
+	case 1:
+		// array element
+		return "[" + g.expr(k, d-1) + ", " + g.expr(kAny, d-1) + "][" + g.pick("0", "0", "1", "-1", "2", "std.length([1]) - 1") + "]"
+	case 2:
+		// object field
+		nm := g.pick("a", "b", "f")
+		return "{" + nm + ": " + g.expr(k, d-1) + ", other: " + g.expr(kAny, d-1) + "}" + g.pick("."+nm, "[\""+nm+"\"]", "."+nm, ".missing", "[\"a\" + \"\"]")
+	case 3:
+		// self-referential object
+		nm := g.pick("a", "b")
+		g.inObj++
+		e := g.expr(k, d-1)
+		g.inObj--
+		dollar := "$"
+		if g.compTop {
+			dollar = "self"
+		}
+		return "{" + nm + ": " + e + ", r: self." + nm + ", d:: " + dollar + "." + nm + "}" + g.pick(".r", ".d", ".r")
+	case 4:
+		// std.get
+		return "std.get({a: " + g.expr(k, d-1) + ", h:: 1}, " + g.pick("\"a\"", "\"h\"", "\"z\"") + g.pick("", ", default=null", ", "+g.expr(k, 0), ", null, true", ", null, false") + ")"
+	case 5:
+		// string / array slice
+		if k == kStr {
+			return g.strExpr(d-1) + "[" + g.pick("0:", "1:", ":2", "0:1", "::2", "1:3", ":", "0:0", "-1:", "0:-1", ":10") + "]"
+		}
+		if k == kArr {
+			return g.arrExpr(d-1) + "[" + g.pick("0:", "1:", ":2", "0:1", "::2", "1:3:1", "::-1", ":", "0:0", "1:2:2") + "]"
+		}
+	}
+	// object merge then field
+	return "(" + g.objExpr(d-1) + " + {z: " + g.expr(k, d-1) + "}).z"
+}
+
+// ---------------------------------------------------------------------------
+// Numbers.
+
+func (g *gen) numExpr(d int) string {
+	if d <= 0 {
+		return g.atom(kNum)
+	}
+	a := g.numExpr(d - 1)
+	b := g.numExpr(d - 1)
+	if g.intOnly {
+		// stays a small integer: no division, multiplication, shifts or real functions
+		switch g.n(1, 8) {
+		case 1, 2:
+			return a + g.ws() + g.pick("+", "-", "%") + g.ws() + b
+		case 3:
+			return g.pick("-", "+", "~") + a
+		case 4:
+			return a + " " + g.pick("&", "|", "^", ">>") + " " + b
+		case 5:
+			return "std.length(" + g.pick(g.strExpr(d-1), g.arrExpr(d-1), g.objExpr(d-1)) + ")"
+		case 6:
+			return "std." + g.pick("floor", "ceil", "round", "abs", "sign") + "(" + a + ")"
+		case 7:
+			return "std." + g.pick("max", "min", "mod") + "(" + a + ", " + b + ")"
+		}
+		return "std.codepoint(" + g.pick("\"a\"", "\"\u00e9\"", "\"\U0001F600\"") + ")"
+	}
+	switch g.n(1, 12) {
+	case 1, 2:
+		return a + g.ws() + g.pick("+", "-", "*", "/", "%") + g.ws() + b
+	case 3:
+		return g.pick("-", "+", "~") + a
+	case 4:
+		op := g.pick("&", "|", "^", "<<", ">>")
+		if Known.shiftRange && (op == "<<" || op == ">>") {
+			return g.pick("0", "1", "2", "7", "-8", "255") + " " + op + " " + g.pick("0", "1", "2", "7", "8", "31")
+		}
+		return a + " " + op + " " + b
+	case 5:
+		f := g.funcExpr(d - 1)
+		if Known.functionLength {
+			f = g.func1(d - 1)
+		}
+		return "std.length(" + g.pick(g.strExpr(d-1), g.arrExpr(d-1), g.objExpr(d-1), f) + ")"
+	case 6:
+		if Known.parenLayers && strings.HasPrefix(a, "(") && strings.HasSuffix(a, ")") {
+			return a // jsonnetfmt strips one layer of parentheses per run
+		}
+		return "(" + a + ")"
+	case 7:
+		if g.chance(25) {
+			// transcendental functions: libm and Go's math package differ in the last bit, so only exact arguments
+			return g.pick("std.exp(0)", "std.log(1)", "std.log2("+g.pick("1", "2", "4", "8", "1024")+")", "std.log10("+g.pick("1", "10", "100")+")", "std.sin(0)", "std.cos(0)", "std.tan(0)", "std.asin(0)", "std.acos(1)", "std.atan(0)", "std.sin(-0)", "std.exp(-0)")
+		}
+		return "std." + g.pick("floor", "ceil", "round", "abs", "sign", "sqrt", "mantissa", "exponent") + "(" + a + ")"
+	case 8:
+		if g.chance(30) {
+			return g.pick("std.pow("+g.pick("0", "1", "-1", "2", "3", "0.5", "-2", "10", "4")+", "+g.pick("0", "1", "-1", "2", "3", "-2", "10", "4")+")", "std.hypot("+g.pick("3", "0", "5", "-3")+", "+g.pick("4", "0", "12", "-4")+")", "std.atan2(0, 1)", "std.atan2(0, -1)")
+		}
+		return "std." + g.pick("max", "min", "mod", "mod") + "(" + a + ", " + b + ")"
+	case 9:
+		return "std." + g.pick("parseInt", "parseOctal", "parseHex") + "(" + g.pick("\"12\"", "\"-7\"", "\"0\"", "\"777\"", "\"ff\"", "\"1e3\"", "\"08\"", "\" 1\"", "\"1_0\"", "\"0x10\"", "\"9007199254740993\"", "\"\"", "\"-\"", "\"00\"", "\"1 \"") + ")"
+	case 10:
+		return "std.codepoint(" + g.pick("\"a\"", "\"\u00e9\"", "\"\U0001F600\"", "\"\\ud83d\\ude00\"", g.strExpr(0)) + ")"
+	case 11:
+		if Known.minArraySingle && g.chance(50) {
+			return "std." + g.pick("minArray", "maxArray") + "([" + g.numExpr(d-1) + ", " + g.numExpr(d-1) + "])"
+		}
+		return "std." + g.pick("sum", "avg") + "(" + g.arrOf(kNum, d-1) + ")"
+	}
+	return "std.clamp(" + a + ", " + b + ", " + g.numExpr(d-1) + ")"
+}
+
+// ---------------------------------------------------------------------------
+// Strings.
+
+var fmtSpecs = []string{"%d", "%i", "%u", "%o", "%x", "%X", "%e", "%E", "%f", "%F", "%g", "%G", "%c", "%s", "%%", "%5d", "%-5d", "%05d", "%+d", "% d", "%.3f", "%10.2e", "%#x", "%#o", "%.0f", "%.10g", "%3s", "%-3s", "%.2s", "%08.3f", "%+.2e", "%#g", "%.0e", "%x", "%5.1f", "%c", "%.3d", "%20.15g", "%.17g", "%'d", "%08d", "%-08d", "%+05d"}
+
+func (g *gen) strExpr(d int) string {
+	if d <= 0 {
+		return g.atom(kStr)
+	}
+	switch g.n(1, 16) {
+	case 1, 2:
+		return g.strExpr(d-1) + g.ws() + "+" + g.ws() + g.pick(g.strExpr(d-1), g.numExpr(d-1), g.boolExpr(d-1), "null", g.arrExpr(d-1), g.objExpr(d-1))
+	case 3:
+		return g.pick(g.numExpr(d-1), g.boolExpr(d-1), "null", g.objExpr(d-1)) + " + " + g.strExpr(d-1)
+	case 4:
+		return "std.toString(" + g.expr(kAny, d-1) + ")"
+	case 5:
+		return "std.type(" + g.expr(kAny, d-1) + ")"
+	case 6:
+		return "std.join(" + g.pick("\",\"", "\"\"", "\" - \"", "\"\\n\"", g.strExpr(0)) + ", " + g.arrOf(kStr, d-1) + ")"
+	case 7:
+		// % formatting
+		k := g.n(1, 3)
+		var specs []string
+		for i := 0; i < k; i++ {
+			specs = append(specs, g.pick(fmtSpecs...))
+		}
+		f := strings.Join(specs, g.pick(" ", "", "/", "x"))
+		if g.chance(15) {
+			f = "%(a)" + g.pick("s", "d", "g", "5.2f", "x") + " " + g.pick("%(b)s", "%(a)d", "", "%(c)s")
+			return g.quoted(f) + " % " + "{a: " + g.expr(kAny, d-1) + ", b: " + g.expr(kAny, d-1) + "}"
+		}
+		var args []string
+		for i := 0; i < k; i++ {
+			args = append(args, g.expr(kAny, d-1))
+		}
+		if g.chance(8) {
+			args = args[:len(args)-1]
+		}
+		if g.chance(30) {
+			return "std.format(" + g.quoted(f) + ", [" + strings.Join(args, ", ") + "])"
+		}
+		if len(args) == 1 && g.chance(40) {
+			return g.quoted(f) + " % " + args[0]
+		}
+		return g.quoted(f) + " % [" + strings.Join(args, ", ") + "]"
+	case 8:
+		fn := g.pick("manifestJson", "manifestJsonMinified", "manifestYamlDoc", "manifestPython", "manifestJsonMinified", "manifestJson", "manifestYamlStream")
+		return "std." + fn + "(" + g.yamlSafe(fn, d-1) + ")"
+	case 9:
+		return "std.manifestJsonEx(" + g.yamlSafe("manifestJsonEx", d-1) + ", " + g.pick("\"  \"", "\"\"", "\"\\t\"", "\" \"") + g.pick("", ", \"\\n\"", ", \"\\n\", \": \"", ", \"\", \":\"", ", newline=\"\\r\\n\"") + ")"
+	case 10:
+		return "std." + g.pick("asciiUpper", "asciiLower", "escapeStringJson", "escapeStringBash", "escapeStringDollars", "escapeStringPython", "escapeStringXML", "trim", "base64", "md5", "base64Decode") + "(" + g.strExpr(d-1) + ")"
+	case 11:
+		return "std." + g.pick("strReplace", "strReplace") + "(" + g.strExpr(d-1) + ", " + g.pick("\"a\"", "\"b\"", "\"ab\"", "\" \"", "\"\u00e9\"", g.strExpr(0)) + ", " + g.strExpr(d-1) + ")"
+	case 12:
+		return "std.substr(" + g.strExpr(d-1) + ", " + g.pick("0", "1", "2", "10") + ", " + g.pick("0", "1", "2", "100") + ")"
+	case 13:
+		return "std." + g.pick("lstripChars", "rstripChars", "stripChars") + "(" + g.strExpr(d-1) + ", " + g.pick("\"a\"", "\" \"", "\"ab\"", "\"\"", "\"\u00e9 \"") + ")"
+	case 14:
+		return "std.char(" + g.pick("65", "233", "128512", "32", "9731", "1", "1114111", g.numExpr(0)) + ")"
+	case 15:
+		return "std.manifestYamlDoc(" + g.yamlSafe("manifestYamlDoc", d-1) + g.pick("", ", true", ", false, true", ", indent_array_in_object=true", ", quote_keys=false") + ")"
+	}
+	return "std." + g.pick("manifestToml", "manifestPythonVars", "manifestIni") + "(" + g.tomlLike(d-1) + ")"
+}
+
+// separators are the optional separator/limit arguments of the split family
+// (and harmless extras for the others); no empty separator while
+// Known.emptySeparator.
+func (g *gen) separators() []string {
+	out := []string{"", ", \"a\"", ", \",\", 1", ", \"a\", -1", ", \", \", 2"}
+	if !Known.emptySeparator {
+		out = append(out, ", \"\", 2")
+	}
+	return out
+}
+
+// keyF is an optional keyF argument; total functions only while
+// Known.sortKeySingle (go-jsonnet applies it to a single element too).
+func (g *gen) keyF() string {
+	if Known.sortKeySingle {
+		return g.pick("", "", ", keyF=function(x) x", ", function(x) std.toString(x)", ", keyF=function(x) std.length(std.toString(x))")
+	}
+	return g.pick("", "", ", keyF=function(x) -x", ", function(x) std.toString(x)", ", keyF=function(x) x.a")
+}
+
+// literal is a literal that cannot fail to evaluate.
+func (g *gen) literal() string {
+	switch g.n(1, 4) {
+	case 1:
+		return g.numLit()
+	case 2:
+		return g.strLit()
+	case 3:
+		return g.pick("true", "false", "null")
+	}
+	return g.pick("[]", "[1]", "{}", "{a: 1}")
+}
+
+// yamlSafe is an argument for the JSON/YAML manifester fn: while
+// Known.yamlFunction the YAML ones get no function values (they manifest as
+// nothing); while Known.manifestNumber only small integers (they format
+// numbers in the shortest form).
+func (g *gen) yamlSafe(fn string, d int) string {
+	if Known.yamlFunction && strings.HasPrefix(fn, "manifestYaml") {
+		saved := g.noFunc
+		g.noFunc = true
+		defer func() { g.noFunc = saved }()
+	}
+	if Known.manifestNumber {
+		saved := g.intOnly
+		g.intOnly = true
+		defer func() { g.intOnly = saved }()
+	}
+	if fn == "manifestYamlStream" {
+		return g.arrOf(kAny, d)
+	}
+	return g.expr(kAny, d)
+}
+
+// func1 is a function of exactly one parameter.
+func (g *gen) func1(d int) string {
+	p := g.fresh("i")
+	saved := g.vars
+	g.vars = append(g.vars, binding{name: p, k: kAny})
+	body := g.expr(kAny, d)
+	g.vars = saved
+	return "(function(" + p + ") " + body + ")"
+}
+
+// tomlLike is an object of the shape manifestToml/manifestIni accept.
+func (g *gen) tomlLike(d int) string {
+	if g.chance(30) {
+		return "{sections: {s1: {a: " + g.numExpr(0) + ", b: " + g.strExpr(0) + "}, s2: {}}" + g.pick("", ", main: {x: 1}", ", main: {y: \"z\", w: [1, 2]}") + "}"
+	}
+	return "{a: " + g.expr(kAny, d) + ", b: " + g.pick(g.strExpr(0), g.numExpr(0), "true", "[1, \"a\"]", "{c: 1}", "[{d: 1}, {d: 2}]", "[[1]]") + "}"
+}
+
+// ---------------------------------------------------------------------------
+// Booleans.
+
+func (g *gen) boolExpr(d int) string {
+	if d <= 0 {
+		return g.atom(kBool)
+	}
+	switch g.n(1, 12) {
+	case 1, 2:
+		return g.expr(kAny, d-1) + " " + g.pick("==", "!=") + " " + g.expr(kAny, d-1)
+	case 3:
+		return g.numExpr(d-1) + " " + g.pick("<", "<=", ">", ">=") + " " + g.numExpr(d-1)
+	case 4:
+		return g.strExpr(d-1) + " " + g.pick("<", "<=", ">", ">=") + " " + g.strExpr(d-1)
+	case 5:
+		return g.boolExpr(d-1) + " " + g.pick("&&", "||") + " " + g.boolExpr(d-1)
+	case 6:
+		return "!" + g.boolExpr(d-1)
+	case 7:
+		return g.strExpr(d-1) + " in " + g.pick(g.objExpr(d-1), "{a: 1}", "{}", "{a:: 1}")
+	case 8:
+		return "std." + g.pick("isNumber", "isString", "isBoolean", "isArray", "isObject", "isFunction", "isNull", "isEven", "isOdd", "isInteger", "isDecimal") + "(" + g.expr(kAny, d-1) + ")"
+	case 9:
+		if g.chance(20) {
+			return "std.isEmpty(" + g.strExpr(d-1) + ")"
+		}
+		return "std." + g.pick("startsWith", "endsWith", "equalsIgnoreCase") + "(" + g.strExpr(d-1) + ", " + g.strExpr(d-1) + ")"
+	case 10:
+		needle := g.expr(kAny, d-1)
+		if Known.needleForced {
+			needle = g.literal()
+		}
+		return "std." + g.pick("member", "contains", "setMember") + "(" + g.pick(g.arrExpr(d-1), g.strExpr(d-1)) + ", " + needle + ")"
+	case 11:
+		return "std." + g.pick("objectHas", "objectHasAll", "objectHasEx") + "(" + g.objExpr(d-1) + ", " + g.pick("\"a\"", "\"b\"", "\"z\"", g.strExpr(0)) + g.pick("", ", true", ", false") + ")"
+	}
+	if g.chance(20) {
+		if Known.xorTypes {
+			return "std." + g.pick("xor", "xnor") + "(" + g.boolExpr(d-1) + ", " + g.boolExpr(d-1) + ")"
+		}
+		return "std." + g.pick("xor", "xnor") + "(" + g.expr(kAny, d-1) + ", " + g.expr(kAny, d-1) + ")"
+	}
+	return "std." + g.pick("equals", "primitiveEquals", "all", "any", "assertEqual") + "(" + g.expr(kAny, d-1) + g.pick(", "+g.expr(kAny, d-1), "") + ")"
+}
+
+// ---------------------------------------------------------------------------
+// Arrays.
+
+func (g *gen) arrOf(k kind, d int) string {
+	m := g.n(0, 4)
+	var parts []string
+	for i := 0; i < m; i++ {
+		parts = append(parts, g.expr(k, d))
+	}
+	sep := g.pick(", ", ",", " , ", ",\n  ")
+	trail := g.pick("", "", ",")
+	if m == 0 {
+		trail = ""
+	}
+	return "[" + g.ws() + strings.Join(parts, sep) + trail + g.ws() + "]"
+}
+
+func (g *gen) arrExpr(d int) string {
+	if d <= 0 {
+		return g.atom(kArr)
+	}
+	switch g.n(1, 14) {
+	case 1, 2:
+		return g.arrOf(kAny, d-1)
+	case 3:
+		return g.arrOf(kind(g.n(int(kNum), int(kObj))), d-1)
+	case 4:
+		return g.arrExpr(d-1) + " + " + g.arrExpr(d-1)
+	case 5:
+		// comprehension
+		v := g.fresh("e")
+		saved := g.vars
+		savedComp := g.compTop
+		if g.inObj == 0 {
+			g.compTop = true
+		}
+		g.vars = append(g.vars, binding{name: v, k: kAny})
+		body := g.expr(kAny, d-1)
+		cond := ""
+		if g.chance(40) {
+			cond = " if " + g.boolExpr(d-1)
+		}
+		g.vars = saved
+		g.compTop = savedComp
+		extra := ""
+		if g.chance(20) {
+			extra = " for " + g.fresh("f") + " in " + g.arrOf(kNum, 0)
+		}
+		return "[" + body + " for " + v + " in " + g.arrExpr(d-1) + extra + cond + "]"
+	case 6:
+		if g.chance(20) {
+			return "std.base64DecodeBytes(" + g.strExpr(d-1) + ")"
+		}
+		return "std.range(" + g.pick("0", "1", "-2", "3") + ", " + g.pick("0", "3", "5", "-1", "2") + ")"
+	case 7:
+		f := g.funcExpr(d - 1)
+		if Known.makeArrayArity {
+			f = g.func1(d - 1)
+		}
+		return "std.makeArray(" + g.pick("0", "1", "3", "5") + ", " + f + ")"
+	case 8:
+		return "std." + g.pick("map", "filter", "flatMap", "mapWithIndex", "filterMap") + "(" + g.funcExpr(d-1) + ", " + g.pick(g.arrExpr(d-1), g.strExpr(0), "[1, 2, 3]", "[\"a\", \"b\"]") + g.pick("", ", "+g.funcExpr(d-1)) + ")"
+	case 9:
+		return "std." + g.pick("sort", "uniq", "set", "reverse", "flattenArrays", "flattenDeepArray", "prune", "sort", "set") + "(" + g.arrExpr(d-1) + g.keyF() + ")"
+	case 10:
+		return "std." + g.pick("setUnion", "setInter", "setDiff") + "(" + g.arrOf(kNum, 0) + ", " + g.arrOf(kNum, 0) + g.keyF() + ")"
+	case 11:
+		return "std." + g.pick("split", "splitLimit", "splitLimitR", "stringChars", "encodeUTF8", "lines", "objectFields", "objectFieldsAll", "objectValues", "objectValuesAll", "objectKeysValues", "objectKeysValuesAll") + "(" + g.pick(g.strExpr(d-1), g.objExpr(d-1), g.arrOf(kStr, 0)) + g.pick(g.separators()...) + ")"
+	case 12:
+		fn := g.pick("slice", "repeat", "remove", "removeAt", "find", "findSubstr")
+		arg := g.pick(g.arrExpr(d-1), g.strExpr(d-1))
+		if Known.stringAsArray && (fn == "remove" || fn == "removeAt") {
+			arg = g.arrExpr(d - 1)
+		}
+		second := g.pick("0", "1", "2", "-1", "\"a\"", g.expr(kAny, 0))
+		if Known.needleForced && (fn == "remove" || fn == "removeAt") {
+			second = g.pick("0", "1", "2", "-1", "\"a\"", g.literal())
+		}
+		if Known.removeAtRange && fn == "removeAt" {
+			// an index at or beyond the length crashes go-jsonnet
+			arg = "[" + g.numExpr(d-1) + ", " + g.numExpr(d-1) + ", " + g.numExpr(d-1) + "]"
+			second = g.pick("0", "1", "2")
+		}
+		if Known.makeArraySize && fn == "repeat" {
+			second = g.pick("0", "1", "2", "3")
+		}
+		return "std." + fn + "(" + arg + ", " + second + g.pick("", ", 2", ", null, null", ", 3, 1", ", 1, -1") + ")"
+	case 13:
+		return "std." + g.pick("foldl", "foldr") + "(" + g.pick("function(a, b) a + [b]", "function(a, b) [a] + [b]", "function(a, b) a + b", "function(acc, x) acc + [x * 2]") + ", " + g.arrExpr(d-1) + ", " + g.pick("[]", "[0]", g.arrExpr(0)) + ")"
+	}
+	return g.arrExpr(d-1) + "[" + g.pick("1:", ":2", "::2", "::-1", "1:3", ":", "0:0", "-2:", ":-1", "1::2") + "]"
+}
+
+// ---------------------------------------------------------------------------
+// Objects.
+
+func (g *gen) objExpr(d int) string {
+	if d <= 0 {
+		return g.atom(kObj)
+	}
+	switch g.n(1, 10) {
+	case 1, 2, 3:
+		return g.objLit(d - 1)
+	case 4:
+		// merge with super
+		left := g.objLit(d - 1)
+		saved := g.superOK
+		g.superOK = true
+		right := g.objLit(d - 1)
+		g.superOK = saved
+		return left + g.ws() + "+" + g.ws() + right
+	case 5:
+		// object comprehension
+		v := g.fresh("k")
+		saved := g.vars
+		savedComp := g.compTop
+		if g.inObj == 0 {
+			g.compTop = true
+		}
+		g.vars = append(g.vars, binding{name: v, k: kStr})
+		body := g.expr(kAny, d-1)
+		g.vars = saved
+		g.compTop = savedComp
+		return "{[" + g.pick(v, v, v+" + \"x\"", "std.toString("+v+")", "\"k\" + "+v) + "]: " + body + " for " + v + " in " + g.pick("[\"a\", \"b\"]", "[\"x\"]", "[]", "std.objectFields({a: 1, b: 2})", "[\"a\", \"a\"]", "[1, 2]", "std.range(1, 3)", g.arrOf(kStr, 0)) + g.pick("", " if "+v+" != \"a\"") + "}"
+	case 6:
+		return "std." + g.pick("mergePatch", "mergePatch") + "(" + g.expr(kAny, d-1) + ", " + g.expr(kAny, d-1) + ")"
+	case 7:
+		return "std.objectRemoveKey(" + g.objExpr(d-1) + ", " + g.pick("\"a\"", "\"z\"", g.strExpr(0)) + ")"
+	case 8:
+		return "std.prune(" + g.objExpr(d-1) + ")"
+	case 9:
+		if g.intOnly {
+			return "std.parseJson(" + g.pick("std.manifestJson("+g.expr(kAny, d-1)+")", "\"{\\\"a\\\": [1, 2, null, true, \\\"s\\\"]}\"", "\"{}\"", "\"[1]\"") + ")"
+		}
+		return "std.parseJson(" + g.pick("std.manifestJson("+g.expr(kAny, d-1)+")", "\"{\\\"a\\\": [1, 2.5, null, true, \\\"s\\\"]}\"", "\"{}\"", "\"[1]\"", "\"1.0\"", "\"{\\\"a\\\": 1, \\\"a\\\": 2}\"", "\"\\\"\\\\ud83d\\\\ude00\\\"\"", "\"12345678901234567890\"", "\"0.1\"", "\"[1,]\"", "\" \"", "\"nul\"") + ")"
+	}
+	if g.intOnly {
+		return "std.parseYaml(" + g.pick("\"a: 1\\nb: [x, q]\"", "\"{a: {b: c}}\"", "\"key: 'v'\"", "\"1\"") + ")"
+	}
+	return "std.parseYaml(" + g.pick("\"a: 1\\nb: [x, q]\"", "\"- 1\\n- 2.5\\n- x\"", "\"{a: {b: c}}\"", "\"a: 1\\n---\\nb: 2\"", "\"key: 'v'\"", "\"1\"", "\"c: 1e3\"", "\"a: 2001-12-14\"", "std.manifestYamlDoc("+g.yamlSafe("manifestYamlDoc", d-1)+")", "\"a: [1, 2\"") + ")"
+}
+
+func (g *gen) objLit(d int) string {
+	m := g.n(0, 3)
+	var parts []string
+	var locals []string
+	g.inObj++
+	used := map[string]bool{}
+	for i := 0; i < m; i++ {
+		switch g.n(1, 14) {
+		case 1:
+			locals = append(locals, "local "+g.fresh("l")+" = "+g.expr(kAny, d))
+			continue
+		case 2:
+			parts = append(parts, "assert "+g.boolExpr(d)+g.pick("", " : \"failed\"", " : "+g.strExpr(0)))
+			continue
+		}
+		nm := g.fieldName()
+		if used[nm] && !g.chance(10) {
+			nm = "\"" + g.fresh("u") + "\""
+		}
+		used[nm] = true
+		sep := g.pick(":", ":", ":", "::", ":::", "+:", "+::")
+		val := g.expr(kAny, d)
+		if g.chance(15) {
+			val = "self." + g.pick("a", "b", "x", "missing") + g.pick("", " + 1", "")
+		} else if g.chance(8) && !g.compTop {
+			val = "$." + g.pick("a", "b", "x")
+		} else if g.superOK && g.chance(25) {
+			val = g.pick("super."+g.pick("a", "b", "x"), "super["+g.strExpr(0)+"]", "if \"a\" in super then super.a else 0", "super.a + 1", "std.objectFields(super)", "super")
+		} else if g.chance(8) && !g.noFunc {
+			// method
+			p := g.fresh("m")
+			saved := g.vars
+			g.vars = append(g.vars, binding{name: p, k: kAny})
+			val = g.expr(kAny, d)
+			g.vars = saved
+			nm = nm + "(" + p + g.pick("", ", "+g.fresh("o")+"=1") + ")"
+		}
+		w := g.ws()
+		if w == "" && sep != ":" && Known.sepGlue {
+			w = " " // go-jsonnet/7: `a::-1` does not parse
+		}
+		parts = append(parts, nm+sep+w+val)
+	}
+	g.inObj--
+	hasField := false
+	for _, p := range parts {
+		if !strings.HasPrefix(p, "assert ") {
+			hasField = true
+		}
+	}
+	if hasField {
+		// an object local without a field is dropped by the C++ desugarer
+		// before static analysis (an unknown variable in it goes unnoticed)
+		parts = append(locals, parts...)
+	}
+	sep := g.pick(", ", ",", ",\n  ", " , ")
+	trail := g.pick("", "", ",")
+	if len(parts) == 0 {
+		trail = ""
+	}
+	return "{" + g.ws() + strings.Join(parts, sep) + trail + g.ws() + "}"
+}
+
+// ---------------------------------------------------------------------------
+// Functions.
+
+func (g *gen) funcExpr(d int) string {
+	if d <= 0 {
+		return g.atom(kFunc)
+	}
+	switch g.n(1, 4) {
+	case 1:
+		return g.atom(kFunc)
+	case 2:
+		if Known.stringAsArray {
+			return g.pick("std.length", "std.toString", "std.type", "std.abs", "std.isNumber", "std.asciiUpper", "std.md5", "std.objectFields")
+		}
+		return g.pick("std.length", "std.toString", "std.type", "std.abs", "std.isNumber", "std.reverse", "std.asciiUpper", "std.md5", "std.objectFields")
+	}
+	p := g.fresh("a")
+	saved := g.vars
+	g.vars = append(g.vars, binding{name: p, k: kAny})
+	if g.chance(30) {
+		q := g.fresh("b")
+		g.vars = append(g.vars, binding{name: q, k: kAny})
+		body := g.expr(kAny, d-1)
+		g.vars = saved
+		return "(function(" + p + ", " + q + g.pick("", "=null", "=1") + ") " + body + ")"
+	}
+	body := g.expr(kAny, d-1)
+	g.vars = saved
+	return "(function(" + p + ") " + body + ")"
+}
+
+// ---------------------------------------------------------------------------
+// std calls returning a given kind, mostly covered above; viaStd adds the
+// cross-kind ones.
+
+func (g *gen) viaStd(k kind, d int) string {
+	switch k {
+	case kNum:
+		return g.numExpr(d)
+	case kStr:
+		return g.strExpr(d)
+	case kBool:
+		return g.boolExpr(d)
+	case kArr:
+		return g.arrExpr(d)
+	case kObj:
+		return g.objExpr(d)
+	case kFunc:
+		return g.funcExpr(d)
+	}
+	return g.pick("std.prune(null)", "std.get({}, \"a\")", "if false then 1", "std.parseJson(\"null\")", "std.mergePatch({a: 1}, {a: null}).a", "{a: null}.a")
+}
+
+// ---------------------------------------------------------------------------
+// External and top-level variables.
+
+func (g *gen) extName() string {
+	names := make([]string, 0, len(g.ext))
+	for k := range g.ext {
+		names = append(names, k)
+	}
+	sortStrings(names)
+	return names[g.n(0, len(names)-1)]
+}
+
+func (g *gen) extcName() string {
+	names := make([]string, 0, len(g.extc))
+	for k := range g.extc {
+		names = append(names, k)
+	}
+	sortStrings(names)
+	return names[g.n(0, len(names)-1)]
+}
+
+func sortStrings(xs []string) {
+	for i := 1; i < len(xs); i++ {
+		for j := i; j > 0 && xs[j] < xs[j-1]; j-- {
+			xs[j], xs[j-1] = xs[j-1], xs[j]
+		}
+	}
+}
+
+// program is a whole program with its external / top-level variables.
+func (g *gen) program() oracleCase {
+	c := oracleCase{}
+	if g.chance(15) {
+		g.ext = map[string]string{"s": g.pick("hello", "", "\u00e9\u2603", "a\nb", "1", "\"q\"", "{a: 1}")}
+		if g.chance(50) {
+			g.ext["t"] = g.pick("x", "ab c")
+		}
+		g.extc = map[string]string{"n": g.pick("1", "5", "[1, 2]", "{a: 1}", "null", "1 + 1", "std.range(0, 2)")}
+		c.Ext = g.ext
+		c.ExtCode = g.extc
+	}
+	d := g.n(1, 4)
+	src := g.expr(kAny, d)
+	if g.chance(12) {
+		// top-level function
+		params := []string{"a", "b"}
+		saved := g.vars
+		g.vars = append(g.vars, binding{name: "a", k: kAny}, binding{name: "b", k: kAny})
+		body := g.expr(kAny, d)
+		g.vars = saved
+		defaults := g.pick("", "=1", "='x'")
+		src = "function(" + params[0] + ", " + params[1] + defaults + ") " + body
+		c.TLA = map[string]string{"a": g.pick("v", "", "1")}
+		if g.chance(50) {
+			c.TLACode = map[string]string{"b": g.pick("2", "[1]", "{x: 1}", "null", "1 + 1")}
+		} else if g.chance(50) {
+			c.TLA["b"] = "w"
+		}
+		if g.chance(8) {
+			c.TLA["zz"] = "unused" // an unknown parameter
+		}
+	}
+	if g.chance(20) {
+		src = g.ws() + src + g.ws()
+	}
+	c.Src = src
+	return c
+}
diff --git a/hegel_oracle_test.go b/hegel_oracle_test.go
new file mode 100644
index 0000000..f6cf961
--- /dev/null
+++ b/hegel_oracle_test.go
@@ -0,0 +1,216 @@
+package jsonnet_test
+
+// The C++ Jsonnet implementation as a child process, through the Python
+// `jsonnet` package: one JSON request per line (a batch of programs), one
+// JSON reply per line. Each case
+//
+//	{"src": program, "ext": {...}, "extc": {...}, "tla": {...}, "tlac": {...}}
+//
+// answers {"out": json} or {"err": message}; a message starting with
+// "STATIC ERROR" is a parse/static error, one starting with "RUNTIME ERROR"
+// a runtime one.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os/exec"
+	"runtime/debug"
+	"strings"
+	"sync"
+	"testing"
+
+	jsonnet "github.com/google/go-jsonnet"
+)
+
+const pyScript = `
+import sys, json
+import _jsonnet
+
+sys.stdout.write(json.dumps({'version': _jsonnet.version}) + '\n')
+sys.stdout.flush()
+
+def run(case):
+    kw = {}
+    if case.get('ext'):
+        kw['ext_vars'] = case['ext']
+    if case.get('extc'):
+        kw['ext_codes'] = case['extc']
+    if case.get('tla'):
+        kw['tla_vars'] = case['tla']
+    if case.get('tlac'):
+        kw['tla_codes'] = case['tlac']
+    return {'out': _jsonnet.evaluate_snippet('snip', case['src'], **kw)}
+
+for line in sys.stdin:
+    req = json.loads(line)
+    out = []
+    for case in req['cases']:
+        try:
+            out.append(run(case))
+        except Exception as ex:
+            try:
+                msg = str(ex)
+            except Exception:
+                msg = '(unprintable)'
+            out.append({'err': msg})
+    sys.stdout.write(json.dumps({'results': out}, sort_keys=True) + '\n')
+    sys.stdout.flush()
+`
+
+type oracleCase struct {
+	Src     string            `json:"src"`
+	Ext     map[string]string `json:"ext,omitempty"`
+	ExtCode map[string]string `json:"extc,omitempty"`
+	TLA     map[string]string `json:"tla,omitempty"`
+	TLACode map[string]string `json:"tlac,omitempty"`
+}
+
+type oracleReq struct {
+	Cases []oracleCase `json:"cases"`
+}
+
+type oracleResult struct {
+	Out string `json:"out"`
+	Err string `json:"err"`
+}
+
+type oracleResp struct {
+	Results []oracleResult `json:"results"`
+}
+
+var (
+	oracleOnce    sync.Once
+	oracleMu      sync.Mutex
+	oracleIn      io.WriteCloser
+	oracleOut     *bufio.Scanner
+	oracleErr     error
+	oracleVersion string
+	oracleCmd     *exec.Cmd
+	oracleStderr  strings.Builder
+)
+
+func startOracle() {
+	cmd := exec.Command("python3", "-c", pyScript)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		oracleErr = err
+		return
+	}
+	cmd.Stderr = &oracleStderr
+	oracleCmd = cmd
+	if err := cmd.Start(); err != nil {
+		oracleErr = fmt.Errorf("starting python3: %v", err)
+		return
+	}
+	oracleIn = stdin
+	oracleOut = bufio.NewScanner(stdout)
+	oracleOut.Buffer(make([]byte, 1<<20), 64<<20)
+	if !oracleOut.Scan() {
+		_ = cmd.Wait()
+		oracleErr = fmt.Errorf("jsonnet oracle did not start (python3 with the jsonnet package needed): %s", oracleStderr.String())
+		return
+	}
+	var v struct {
+		Version string `json:"version"`
+	}
+	if err := json.Unmarshal(oracleOut.Bytes(), &v); err != nil {
+		oracleErr = err
+		return
+	}
+	oracleVersion = v.Version
+}
+
+func oracle(t testing.TB, cases []oracleCase) []oracleResult {
+	oracleOnce.Do(startOracle)
+	if oracleErr != nil {
+		t.Fatalf("oracle: %v", oracleErr)
+	}
+	oracleMu.Lock()
+	defer oracleMu.Unlock()
+	req, _ := json.Marshal(oracleReq{Cases: cases})
+	if _, err := oracleIn.Write(append(req, '\n')); err != nil {
+		_ = oracleCmd.Wait()
+		t.Fatalf("oracle write: %v\nstderr: %s", err, oracleStderr.String())
+	}
+	if !oracleOut.Scan() {
+		_ = oracleCmd.Wait()
+		t.Fatalf("oracle died: %v\nstderr: %s", oracleOut.Err(), oracleStderr.String())
+	}
+	var resp oracleResp
+	if err := json.Unmarshal(oracleOut.Bytes(), &resp); err != nil {
+		t.Fatalf("oracle reply: %v: %s", err, oracleOut.Bytes())
+	}
+	if len(resp.Results) != len(cases) {
+		t.Fatalf("oracle returned %d results for %d cases", len(resp.Results), len(cases))
+	}
+	return resp.Results
+}
+
+// shortStack keeps the go-jsonnet frames of a panic's stack.
+func shortStack(b []byte) string {
+	var keep []string
+	lines := strings.Split(string(b), "\n")
+	for i := 0; i+1 < len(lines); i++ {
+		if strings.Contains(lines[i], "go-jsonnet.") && !strings.Contains(lines[i], "_test.") {
+			keep = append(keep, strings.TrimSpace(lines[i])+" "+strings.TrimSpace(lines[i+1]))
+		}
+		if len(keep) == 6 {
+			break
+		}
+	}
+	return strings.Join(keep, "\n")
+}
+
+// goEval evaluates a case with go-jsonnet; err is the formatted error
+// message ("PANIC: ..." with a stack for a panic), "" on success.
+func goEval(c oracleCase) (out string, err string) {
+	defer func() {
+		if r := recover(); r != nil {
+			out, err = "", fmt.Sprintf("PANIC: %v\n%s", r, shortStack(debug.Stack()))
+		}
+	}()
+	vm := jsonnet.MakeVM()
+	for k, v := range c.Ext {
+		vm.ExtVar(k, v)
+	}
+	for k, v := range c.ExtCode {
+		vm.ExtCode(k, v)
+	}
+	for k, v := range c.TLA {
+		vm.TLAVar(k, v)
+	}
+	for k, v := range c.TLACode {
+		vm.TLACode(k, v)
+	}
+	out, e := vm.EvaluateSnippet("snip", c.Src) // like the C++ evaluate_snippet, std.thisFile is the file name
+	if e != nil {
+		return "", e.Error()
+	}
+	return out, ""
+}
+
+// errKind classifies a formatted error message of either implementation.
+func errKind(msg string) string {
+	if strings.HasPrefix(msg, "RUNTIME ERROR") {
+		return "runtime"
+	}
+	return "static"
+}
+
+func TestHegelOracleVersion(t *testing.T) {
+	r := oracle(t, []oracleCase{{Src: "std.extVar('a') + std.extVar('x')", Ext: map[string]string{"a": "b"}, ExtCode: map[string]string{"x": "'c'"}}})
+	t.Logf("jsonnet %s (go-jsonnet %s)", oracleVersion, jsonnet.Version())
+	if strings.TrimPrefix(oracleVersion, "v") != strings.TrimPrefix(jsonnet.Version(), "v") {
+		t.Fatalf("the oracle should be the same version as go-jsonnet: %s vs %s", oracleVersion, jsonnet.Version())
+	}
+	if r[0].Err != "" || r[0].Out != "\"bc\"\n" {
+		t.Fatalf("oracle smoke test: %+v", r[0])
+	}
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..5af43eb
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,103 @@
+package jsonnet_test
+
+// Pins: one deterministic case per known bug (bugs.toml), each failing
+// while the bug is open.
+
+import (
+	"testing"
+
+	"github.com/google/go-jsonnet/formatter"
+)
+
+// pin evaluates src on both sides and expects agreement: the same output,
+// or failure on both.
+func pin(t *testing.T, src string) {
+	t.Helper()
+	py := oracle(t, []oracleCase{{Src: src}})[0]
+	gout, gerr := goEval(oracleCase{Src: src})
+	switch {
+	case gerr == "" && py.Err == "":
+		if gout != py.Out {
+			t.Fatalf("output differs for %q\ngo:  %q\ncpp: %q", src, gout, py.Out)
+		}
+	case gerr == "":
+		t.Fatalf("go-jsonnet succeeds on %q with %q; jsonnet: %s", src, gout, firstLine(py.Err))
+	case py.Err == "":
+		t.Fatalf("go-jsonnet fails on %q: %s; jsonnet: %q", src, firstLine(gerr), py.Out)
+	}
+}
+
+// go-jsonnet/1
+func TestHegelPinParseIntPlus(t *testing.T) { pin(t, `std.parseInt("+3")`) }
+
+// go-jsonnet/2
+func TestHegelPinParseIntNegativeZero(t *testing.T) { pin(t, `std.parseInt("-0")`) }
+
+// go-jsonnet/3
+func TestHegelPinMakeArrayNegativeSize(t *testing.T) {
+	pin(t, `std.makeArray(-1, function(i) i)`)
+}
+
+// go-jsonnet/4
+func TestHegelPinMakeArrayFunctionArity(t *testing.T) {
+	pin(t, `std.makeArray(2, function(a, b=1) a + b)`)
+}
+
+// go-jsonnet/5
+func TestHegelPinXorNonBoolean(t *testing.T) { pin(t, `std.xor(1, 2)`) }
+
+// go-jsonnet/6
+func TestHegelPinManifestYamlFunction(t *testing.T) {
+	pin(t, `std.manifestYamlDoc({a: function() 1})`)
+}
+
+// go-jsonnet/7
+func TestHegelPinSeparatorGluedToOperator(t *testing.T) { pin(t, `{a:::-1, b::$.a, c+::!true}`) }
+
+// go-jsonnet/8
+func TestHegelPinManifestJsonNumberFormat(t *testing.T) { pin(t, `std.manifestJson(0.1 + 0.7)`) }
+
+// go-jsonnet/9
+func TestHegelPinFunctionLength(t *testing.T) { pin(t, `std.length(function(a, b=null) a)`) }
+
+// go-jsonnet/10
+func TestHegelPinStringAsArray(t *testing.T) { pin(t, `std.reverse("abc")`) }
+
+// go-jsonnet/11
+func TestHegelPinSortKeyOnSingleton(t *testing.T) { pin(t, `std.sort([1], keyF=function(x) x.a)`) }
+
+// go-jsonnet/12
+func TestHegelPinMemberForcesNeedle(t *testing.T) { pin(t, `std.member([], error "x")`) }
+
+// go-jsonnet/13
+func TestHegelPinShiftOutOfRange(t *testing.T) { pin(t, `1 << 63`) }
+
+// go-jsonnet/14
+func TestHegelPinTailstrictDefaultCrash(t *testing.T) {
+	pin(t, `local f(a, b=a) = a + b; f(1) tailstrict`)
+}
+
+// go-jsonnet/15
+func TestHegelPinFormatIdempotent(t *testing.T) {
+	opts := formatter.DefaultOptions()
+	f, err := formatter.Format("snip", "(((1e3)))", opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f2, err := formatter.Format("snip", f, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if f != f2 {
+		t.Fatalf("Format is not idempotent: %q then %q", f, f2)
+	}
+}
+
+// go-jsonnet/16
+func TestHegelPinRemoveAtBeyondLength(t *testing.T) { pin(t, `std.removeAt([1, 2], 5)`) }
+
+// go-jsonnet/17
+func TestHegelPinMinArraySingleton(t *testing.T) { pin(t, `std.minArray([{}])`) }
+
+// go-jsonnet/18
+func TestHegelPinSplitLimitEmptySeparator(t *testing.T) { pin(t, `std.splitLimit("ab", "", 2)`) }
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..610f4a1
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,124 @@
+package jsonnet_test
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/go-jsonnet/formatter"
+	"hegel.dev/go/hegel"
+)
+
+// compare judges go-jsonnet's result against the C++ implementation's for
+// one program: both succeed with the same output, or both fail with the
+// same kind of error. Error messages are not compared (go-jsonnet words its
+// own).
+func compare(ht *hegel.T, c oracleCase, gout, gerr string, py oracleResult) {
+	if strings.HasPrefix(gerr, "PANIC") {
+		fail(ht, "go-jsonnet panics\nsrc:  %q\n%s", c.Src, gerr)
+	}
+	switch {
+	case gerr == "" && py.Err == "":
+		if gout != py.Out {
+			fail(ht, "output differs\nsrc:  %q\ngo:   %q\ncpp:  %q", c.Src, gout, py.Out)
+		}
+	case gerr == "":
+		fail(ht, "go-jsonnet succeeds, jsonnet fails\nsrc:  %q\ngo:   %q\ncpp:  %s", c.Src, gout, firstLine(py.Err))
+	case py.Err == "":
+		fail(ht, "go-jsonnet fails, jsonnet succeeds\nsrc:  %q\ngo:   %s\ncpp:  %q", c.Src, firstLine(gerr), py.Out)
+	default:
+		if errKind(gerr) != errKind(py.Err) {
+			fail(ht, "error kind differs (go %s, cpp %s)\nsrc:  %q\ngo:   %s\ncpp:  %s", errKind(gerr), errKind(py.Err), c.Src, firstLine(gerr), firstLine(py.Err))
+		}
+	}
+}
+
+func firstLine(s string) string {
+	if i := strings.IndexByte(s, '\n'); i >= 0 {
+		return s[:i]
+	}
+	return s
+}
+
+// TestHegelEvalAgreesWithJsonnet: a generated program (literals of every
+// kind, locals, functions, objects with self/super/$ and hidden fields,
+// comprehensions, slices, the operators, std library calls, % formatting,
+// external and top-level variables) evaluates to the same JSON in
+// go-jsonnet and in the C++ implementation, or fails in both with the same
+// kind of error.
+func TestHegelEvalAgreesWithJsonnet(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 4)
+		var cases []oracleCase
+		for i := 0; i < k; i++ {
+			g := newGen(ht)
+			cases = append(cases, g.program())
+		}
+		res := oracle(ht, cases)
+		for i, c := range cases {
+			note(ht, "program %q ext=%v extc=%v tla=%v tlac=%v", c.Src, c.Ext, c.ExtCode, c.TLA, c.TLACode)
+			gout, gerr := goEval(c)
+			compare(ht, c, gout, gerr, res[i])
+		}
+	})
+}
+
+// TestHegelFormatPreservesMeaning: jsonnetfmt (formatter.Format with the
+// default options) formats every program that evaluates (or fails at
+// runtime), is idempotent, and its output evaluates like the original in go-jsonnet and
+// like the original in the C++ implementation.
+func TestHegelFormatPreservesMeaning(t *testing.T) {
+	opts := formatter.DefaultOptions()
+	property(t, func(ht *hegel.T) {
+		k := n(ht, 1, 3)
+		var orig, fmted []oracleCase
+		for i := 0; i < k; i++ {
+			g := newGen(ht)
+			c := g.program()
+			note(ht, "program %q", c.Src)
+			f, ferr := formatter.Format("snip", c.Src, opts)
+			if ferr != nil {
+				// only a program with a static error may be unformattable
+				if gout, gerr := goEval(c); gerr == "" || errKind(gerr) != "static" {
+					fail(ht, "Format rejects a program that evaluates\nsrc:  %q\nfmt:  %v\ngo:   %s%s", c.Src, ferr, gout, firstLine(gerr))
+				}
+				continue
+			}
+			f2, err := formatter.Format("snip", f, opts)
+			if err != nil {
+				fail(ht, "Format rejects its own output\nsrc:  %q\nfmt:  %q\nerr:  %v", c.Src, f, err)
+			}
+			if f2 != f {
+				fail(ht, "Format is not idempotent\nsrc:  %q\nfmt:  %q\nfmt2: %q", c.Src, f, f2)
+			}
+			c2 := c
+			c2.Src = f
+			orig = append(orig, c)
+			fmted = append(fmted, c2)
+		}
+		if len(orig) == 0 {
+			return
+		}
+		res := oracle(ht, fmted)
+		for i := range orig {
+			gout, gerr := goEval(orig[i])
+			fout, ferr := goEval(fmted[i])
+			note(ht, "formatted %q", fmted[i].Src)
+			if strings.HasPrefix(gerr, "PANIC") {
+				fail(ht, "go-jsonnet panics\nsrc:  %q\n%s", orig[i].Src, gerr)
+			}
+			switch {
+			case gerr == "" && ferr == "":
+				if gout != fout {
+					fail(ht, "formatted program evaluates differently\nsrc:  %q\nfmt:  %q\ngo:   %q\nfmtd: %q", orig[i].Src, fmted[i].Src, gout, fout)
+				}
+			case (gerr == "") != (ferr == ""):
+				fail(ht, "formatted program fails/succeeds unlike the original\nsrc:  %q\nfmt:  %q\ngo:   %s\nfmtd: %s", orig[i].Src, fmted[i].Src, firstLine(gerr), firstLine(ferr))
+			default:
+				if errKind(gerr) != errKind(ferr) {
+					fail(ht, "formatted program fails with another kind of error\nsrc:  %q\nfmt:  %q\ngo:   %s\nfmtd: %s", orig[i].Src, fmted[i].Src, firstLine(gerr), firstLine(ferr))
+				}
+			}
+			compare(ht, fmted[i], fout, ferr, res[i])
+		}
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..8896a76
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,151 @@
+package jsonnet_test
+
+// Generated Jsonnet programs evaluated by go-jsonnet and by the C++
+// implementation (the Python `jsonnet` package, as a child process) must
+// agree: the same programs succeed or fail, with the same JSON output and
+// the same kind of error (static or runtime); and jsonnetfmt's formatting
+// preserves the meaning of a program.
+//
+// Needs python3 with the `jsonnet` package on PATH.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------
+// Plumbing.
+
+var (
+	collecting    = os.Getenv("HEGEL_COLLECT") != ""
+	collectedMu   sync.Mutex
+	collectedMsgs []string
+)
+
+type collected struct{}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = nil
+		collectedMu.Unlock()
+		defer func() {
+			collectedMu.Lock()
+			defer collectedMu.Unlock()
+			sort.Slice(collectedMsgs, func(i, j int) bool { return len(collectedMsgs[i]) < len(collectedMsgs[j]) })
+			t.Logf("COLLECT %s: %d mismatches", t.Name(), len(collectedMsgs))
+			for i, m := range collectedMsgs {
+				if i == 400 {
+					break
+				}
+				t.Logf("MISMATCH %d\n%s", i, m)
+			}
+		}()
+	}
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			if _, ok := r.(collected); ok {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			fail(ht, "panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func hegelOpts() []hegel.Option {
+	// A case is a batch of programs through the oracle: large and slow by
+	// hegel's defaults.
+	opts := []hegel.Option{hegel.SuppressHealthCheck(hegel.TooSlow, hegel.TestCasesTooLarge, hegel.LargeInitialTestCase)}
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			opts = append(opts, hegel.WithTestCases(n))
+		}
+	}
+	return opts
+}
+
+// fail reports a property failure; in collect mode it records the message
+// and moves on to the next case.
+func fail(ht *hegel.T, format string, args ...any) {
+	if collecting {
+		collectedMu.Lock()
+		collectedMsgs = append(collectedMsgs, fmt.Sprintf(format, args...))
+		collectedMu.Unlock()
+		panic(collected{})
+	}
+	ht.Fatalf(format, args...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs ...T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+func note(ht *hegel.T, format string, args ...any) { ht.Note(fmt.Sprintf(format, args...)) }
+
+// ---------------------------------------------------------------------------
+// Known bugs (see bugs.toml). Each gate keeps the generator away from a
+// shape that is known to differ from the C++ implementation while the bug
+// is open; the pins in hegel_pins_test.go fail while it is.
+
+var Known = struct {
+	parseIntPlus      bool // std.parseInt accepts a leading plus ("+3"), the C++ implementation does not
+	parseIntNegZero   bool // std.parseInt("-0") is 0, not -0
+	makeArraySize     bool // std.makeArray accepts a negative size (giving []) and rejects a fractional one the C++ implementation truncates
+	makeArrayArity    bool // std.makeArray accepts a function with optional extra parameters, the C++ implementation requires exactly one
+	xorTypes          bool // std.xor / std.xnor reject non-boolean arguments the C++ implementation compares
+	yamlFunction      bool // std.manifestYamlDoc / manifestYamlStream manifest a function value as nothing instead of failing
+	sepGlue           bool // a field separator other than : glued to a following operator character (a::-1, a+::$.x) does not parse
+	manifestNumber    bool // std.manifestJson/JsonEx/JsonMinified/YamlDoc/YamlStream format numbers in the shortest form, not %.17g
+	functionLength    bool // std.length of a function counts the required parameters only, the C++ implementation all of them
+	stringAsArray     bool // std.reverse/sort/set/removeAt/minArray/maxArray/sum reject a string the C++ implementation treats as an array of characters
+	sortKeySingle     bool // std.sort/set apply keyF to a single element, the C++ implementation returns the array untouched
+	needleForced      bool // std.member/contains/remove/removeAt force the needle for an empty array, the C++ implementation never looks at it
+	shiftRange        bool // a shift result outside the safe integer range wraps (1 << 63) instead of failing
+	tailstrictDefault bool // a tailstrict call of a function whose default parameter refers to an outer variable crashes (INTERNAL ERROR)
+	parenLayers       bool // jsonnetfmt strips one layer of redundant parentheses per run: not idempotent on ((x))
+	removeAtRange     bool // std.removeAt with an index at or beyond the length crashes (INTERNAL ERROR)
+	minArraySingle    bool // std.minArray/maxArray return a single non-comparable element the C++ implementation rejects
+	emptySeparator    bool // std.splitLimit rejects an empty separator the C++ implementation accepts
+}{
+	parseIntPlus:      true,
+	parseIntNegZero:   true,
+	makeArraySize:     true,
+	makeArrayArity:    true,
+	xorTypes:          true,
+	yamlFunction:      true,
+	sepGlue:           true,
+	manifestNumber:    true,
+	functionLength:    true,
+	stringAsArray:     true,
+	sortKeySingle:     true,
+	needleForced:      true,
+	shiftRange:        true,
+	tailstrictDefault: true,
+	parenLayers:       true,
+	removeAtRange:     true,
+	minArraySingle:    true,
+	emptySeparator:    true,
+}
