+package etree_test
+
+// The token API and the paths against the model: see hegel_test.go for the model.
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/beevik/etree"
+)
+
+// catching runs library code that may panic and returns the panic value, nil when it returned.
+func catching(f func()) (p any) {
+	defer func() { p = recover() }()
+	f()
+	return nil
+}
+
+// at is the live position a drawn number selects: the number modulo the size.
+func at(i, size int) int {
+	if size <= 0 {
+		return 0
+	}
+	return i % size
+}
+
+// --------------------------------------------------------------------------- paths
+
+// vref is a filter value: one of the tree's own values (an attribute value or a text, by
+// position modulo their number) when fromTree and the tree has any, else the literal.
+type vref struct {
+	fromTree bool
+	i        int
+	lit      string
+}
+
+func (v vref) resolve(from []string) string {
+	if v.fromTree && len(from) > 0 {
+		return from[at(v.i, len(from))]
+	}
+	return v.lit
+}
+
+type pfilter struct {
+	kind       string // attr attrval child childval pos fn fnval
+	space, key string
+	fn         string
+	ref        vref   // the value before resolution (attrval, childval, fnval)
+	val        string // the resolved value
+	pos        int
+	quote      byte
+}
+
+type pseg struct {
+	sel        string // self parent children desc tag root
+	space, tag string
+	filters    []pfilter
+}
+
+type ppath struct {
+	abs    bool
+	search bool // a leading ".//": the common relative search from an element
+	segs   []pseg
+}
+
+var fnNames = []string{"text", "local-name", "name", "namespace-prefix", "namespace-uri"}
+
+func (f pfilter) String() string {
+	q := string(f.quote)
+	key := f.key
+	if f.space != "" {
+		key = f.space + ":" + f.key
+	}
+	switch f.kind {
+	case "attr":
+		return "[@" + key + "]"
+	case "attrval":
+		return "[@" + key + "=" + q + f.val + q + "]"
+	case "child":
+		return "[" + key + "]"
+	case "childval":
+		return "[" + key + "=" + q + f.val + q + "]"
+	case "pos":
+		return "[" + fmt.Sprint(f.pos) + "]"
+	case "fn":
+		return "[" + f.fn + "()]"
+	default:
+		return "[" + f.fn + "()=" + q + f.val + q + "]"
+	}
+}
+
+func (s pseg) String() string {
+	var b strings.Builder
+	switch s.sel {
+	case "self":
+		b.WriteString(".")
+	case "parent":
+		b.WriteString("..")
+	case "children":
+		b.WriteString("*")
+	case "desc":
+	case "tag":
+		if s.space != "" {
+			b.WriteString(s.space + ":")
+		}
+		b.WriteString(s.tag)
+	}
+	for _, f := range s.filters {
+		b.WriteString(f.String())
+	}
+	return b.String()
+}
+
+func (p ppath) String() string {
+	var parts []string
+	for _, s := range p.segs {
+		parts = append(parts, s.String())
+	}
+	s := strings.Join(parts, "/")
+	if p.abs {
+		s = "/" + s
+	}
+	return s
+}
+
+func (p ppath) GoString() string { return fmt.Sprintf("%q", p.String()) }
+
+// values of the tree a filter may compare with, to get hits; under HEGEL_NO_KNOWN=1 those with
+// a '[' are left out (etree/8).
+func treeValues(m *tok) (attrVals, texts []string) {
+	seen := map[string]bool{}
+	for _, e := range m.elements() {
+		for _, a := range e.attrs {
+			if !seen["a"+a.val] && !(Known.bracketInQuotedValue && strings.Contains(a.val, "[")) {
+				seen["a"+a.val] = true
+				attrVals = append(attrVals, a.val)
+			}
+		}
+		if tx := e.text(); !seen["t"+tx] && !(Known.bracketInQuotedValue && strings.Contains(tx, "[")) {
+			seen["t"+tx] = true
+			texts = append(texts, tx)
+		}
+	}
+	return
+}
+
+var (
+	quotes      = hegel.Map(chance(30), func(d bool) byte { return map[bool]byte{false: '\'', true: '"'}[d] })
+	filterNames = hegel.Composite(func(tc hegel.TestCase) [2]string {
+		return [2]string{hegel.Draw(tc, maybe(25, pick("p", "q"))), hegel.Draw(tc, tags)}
+	})
+	// literal values: a few with a '[' in them (etree/8), none under HEGEL_NO_KNOWN=1
+	literals = pick(shaped([]string{"", "v", "a", "1", "x/y", "a]b", "a=b", "[", " "}, []string{"", "v", "a", "1", "x/y", "a]b", "a=b", " "})...)
+	// vrefs: a tree value seven times in ten, a literal otherwise
+	vrefs = hegel.Composite(func(tc hegel.TestCase) vref {
+		return vref{fromTree: hegel.Draw(tc, chance(70)), i: hegel.Draw(tc, hegel.Integers(0, 63)), lit: hegel.Draw(tc, literals)}
+	})
+	literalRef = func(g hegel.Generator[string]) hegel.Generator[vref] {
+		return hegel.Map(g, func(s string) vref { return vref{lit: s} })
+	}
+	// positions: 1 first; 0 (etree/7) only by default
+	positions = shaped(hegel.SampledFrom([]int{1, 2, 3, 4, 0, -1, -2, -3}), hegel.SampledFrom([]int{1, 2, 3, 4, -1, -2, -3}))
+
+	attrFilters = hegel.Composite(func(tc hegel.TestCase) pfilter {
+		return pfilter{kind: "attr", space: hegel.Draw(tc, filterNames)[0], key: hegel.Draw(tc, keys)}
+	})
+	attrvalFilters = hegel.Composite(func(tc hegel.TestCase) pfilter {
+		return pfilter{kind: "attrval", space: hegel.Draw(tc, filterNames)[0], key: hegel.Draw(tc, keys), ref: hegel.Draw(tc, vrefs)}
+	})
+	childFilters = hegel.Composite(func(tc hegel.TestCase) pfilter {
+		nm := hegel.Draw(tc, filterNames)
+		return pfilter{kind: "child", space: nm[0], key: nm[1]}
+	})
+	childvalFilters = hegel.Composite(func(tc hegel.TestCase) pfilter {
+		nm := hegel.Draw(tc, filterNames)
+		return pfilter{kind: "childval", space: nm[0], key: nm[1], ref: hegel.Draw(tc, vrefs)}
+	})
+	posFilters = hegel.Map(positions, func(p int) pfilter { return pfilter{kind: "pos", pos: p} })
+	fnFilters  = hegel.Map(hegel.SampledFrom(fnNames), func(fn string) pfilter { return pfilter{kind: "fn", fn: fn} })
+	// fnvalFilters compare a function with a value of its kind.
+	fnvalFilters = hegel.FlatMap(hegel.SampledFrom(fnNames), func(fn string) hegel.Generator[pfilter] {
+		var ref hegel.Generator[vref]
+		switch fn {
+		case "text":
+			ref = vrefs
+		case "local-name":
+			ref = literalRef(tags)
+		case "name":
+			ref = literalRef(hegel.Composite(func(tc hegel.TestCase) string {
+				t := hegel.Draw(tc, tags)
+				return hegel.Draw(tc, maybe(40, pick("p:", "q:"))) + t
+			}))
+		case "namespace-prefix":
+			ref = literalRef(pick("p", "q", "", "x"))
+		default:
+			ref = literalRef(pick("urn:p", "urn:q", "urn:d", "", "urn:p2"))
+		}
+		return hegel.Map(ref, func(r vref) pfilter { return pfilter{kind: "fnval", fn: fn, ref: r} })
+	})
+	filters = hegel.FlatMap(quotes, func(q byte) hegel.Generator[pfilter] {
+		return hegel.Map(hegel.OneOf(attrFilters, attrvalFilters, childFilters, childvalFilters, posFilters, fnFilters, fnvalFilters),
+			func(f pfilter) pfilter { f.quote = q; return f })
+	})
+	// segFilters: none, one (45%) or two (a quarter of those)
+	segFilters = weighted(choice[[]pfilter]{55, hegel.Just[[]pfilter](nil)}, choice[[]pfilter]{34, many(filters, 1, 1)}, choice[[]pfilter]{11, many(filters, 2, 2)})
+	// segments: a tag by default, the other selectors by name
+	segments = hegel.Composite(func(tc hegel.TestCase) pseg {
+		s := pseg{sel: hegel.Draw(tc, weighted(choice[string]{50, hegel.Just("tag")}, choice[string]{10, hegel.Just("self")},
+			choice[string]{10, hegel.Just("parent")}, choice[string]{15, hegel.Just("children")}, choice[string]{15, hegel.Just("desc")}))}
+		nm := hegel.Draw(tc, filterNames)
+		s.space, s.tag = nm[0], nm[1]
+		s.filters = hegel.Draw(tc, segFilters)
+		return s
+	})
+	rawPaths = hegel.Composite(func(tc hegel.TestCase) ppath {
+		return ppath{abs: hegel.Draw(tc, chance(25)), search: hegel.Draw(tc, chance(40)), segs: hegel.Draw(tc, many(segments, 1, 4))}
+	})
+	paths = hegel.Map(rawPaths, wellFormed)
+)
+
+// wellFormed puts a drawn path into the documented grammar: the descendants selector only
+// after a first segment (or in an absolute path) and not last, the leading search only on a
+// relative path; under HEGEL_NO_KNOWN=1 a position filter never follows a child filter in a
+// segment (etree/6).
+func wellFormed(p ppath) ppath {
+	k := len(p.segs)
+	segs := make([]pseg, 0, k+2)
+	if p.search && !p.abs {
+		segs = append(segs, pseg{sel: "self"}, pseg{sel: "desc"})
+	}
+	for i, s := range p.segs {
+		if s.sel == "desc" && !((i > 0 || p.abs) && i < k-1) {
+			s.sel = "tag"
+		}
+		if s.sel != "tag" {
+			s.space, s.tag = "", ""
+		}
+		if Known.childFilterDuplicates {
+			var pos, rest []pfilter
+			for _, f := range s.filters {
+				if f.kind == "pos" {
+					pos = append(pos, f)
+				} else {
+					rest = append(rest, f)
+				}
+			}
+			s.filters = append(pos, rest...)
+		}
+		segs = append(segs, s)
+	}
+	p.segs = segs
+	return p
+}
+
+// resolved is the path with its filter values taken from the tree where they refer to it, and
+// the quote around a value kept out of it.
+func resolved(p ppath, m *tok) ppath {
+	attrVals, texts := treeValues(m)
+	segs := make([]pseg, len(p.segs))
+	for i, s := range p.segs {
+		fs := make([]pfilter, len(s.filters))
+		for j, f := range s.filters {
+			switch {
+			case f.kind == "attrval":
+				f.val = f.ref.resolve(attrVals)
+			case f.kind == "childval", f.kind == "fnval" && f.fn == "text":
+				f.val = f.ref.resolve(texts)
+			case f.kind == "fnval":
+				f.val = f.ref.lit
+			}
+			// The value may not contain the quote used around it.
+			f.val = strings.ReplaceAll(f.val, string(f.quote), "")
+			fs[j] = f
+		}
+		s.filters = fs
+		segs[i] = s
+	}
+	p.segs = segs
+	return p
+}
+
+// pathShapes names the recorded bugs a path runs into: a '[' in a quoted value (etree/8), a
+// [0] filter (etree/7), a position filter after a child filter (etree/6).
+func pathShapes(p ppath) []string {
+	var shapes []string
+	add := func(s string) {
+		for _, x := range shapes {
+			if x == s {
+				return
+			}
+		}
+		shapes = append(shapes, s)
+	}
+	for _, s := range p.segs {
+		childSeen := false
+		for _, f := range s.filters {
+			if strings.Contains(f.val, "[") {
+				add("etree/8")
+			}
+			if f.kind == "pos" && f.pos == 0 {
+				add("etree/7")
+			}
+			if f.kind == "child" || f.kind == "childval" {
+				childSeen = true
+			}
+			if childSeen && f.kind == "pos" {
+				add("etree/6")
+			}
+		}
+	}
+	return shapes
+}
+
+// evalPath evaluates a path on the model as documented: breadth-first over the segments,
+// selectors then filters, results deduplicated.
+func evalPath(start *tok, p ppath) []*tok {
+	type node struct {
+		e    *tok
+		rest []pseg
+	}
+	segs := p.segs
+	if p.abs {
+		segs = append([]pseg{{sel: "root"}}, segs...)
+	}
+	queue := []node{{start, segs}}
+	seen := map[*tok]bool{}
+	var res []*tok
+	for len(queue) > 0 {
+		nd := queue[0]
+		queue = queue[1:]
+		seg, rest := nd.rest[0], nd.rest[1:]
+		cands := selectModel(nd.e, seg)
+		for _, f := range seg.filters {
+			cands = filterModel(cands, f)
+		}
+		if len(rest) == 0 {
+			for _, c := range cands {
+				if !seen[c] {
+					seen[c] = true
+					res = append(res, c)
+				}
+			}
+		} else {
+			for _, c := range cands {
+				queue = append(queue, node{c, rest})
+			}
+		}
+	}
+	return res
+}
+
+func spaceMatch(sel, have string) bool { return sel == "" || sel == have }
+
+func childElems(e *tok) []*tok {
+	var out []*tok
+	for _, c := range e.kids {
+		if c.kind == kElem {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+func selectModel(e *tok, seg pseg) []*tok {
+	switch seg.sel {
+	case "self":
+		return []*tok{e}
+	case "parent":
+		if e.parent != nil {
+			return []*tok{e.parent}
+		}
+		return nil
+	case "children":
+		return childElems(e)
+	case "desc":
+		var out []*tok
+		queue := []*tok{e}
+		for len(queue) > 0 {
+			x := queue[0]
+			queue = queue[1:]
+			out = append(out, x)
+			queue = append(queue, childElems(x)...)
+		}
+		return out
+	case "tag":
+		var out []*tok
+		for _, c := range childElems(e) {
+			if spaceMatch(seg.space, c.space) && c.tag == seg.tag {
+				out = append(out, c)
+			}
+		}
+		return out
+	case "root":
+		r := e
+		for r.parent != nil {
+			r = r.parent
+		}
+		return []*tok{r}
+	}
+	return nil
+}
+
+func fnValue(e *tok, fn string) string {
+	switch fn {
+	case "text":
+		return e.text()
+	case "local-name":
+		return e.tag
+	case "name":
+		return e.fullTag()
+	case "namespace-prefix":
+		return e.space
+	case "namespace-uri":
+		if e.tag == "" {
+			return ""
+		}
+		return e.resolveNS(e.space)
+	}
+	return ""
+}
+
+func filterModel(cands []*tok, f pfilter) []*tok {
+	var out []*tok
+	switch f.kind {
+	case "pos":
+		switch {
+		case f.pos > 0 && f.pos <= len(cands):
+			out = append(out, cands[f.pos-1])
+		case f.pos < 0 && -f.pos <= len(cands):
+			out = append(out, cands[len(cands)+f.pos])
+		}
+		return out
+	case "attr", "attrval":
+		for _, c := range cands {
+			for _, a := range c.attrs {
+				if spaceMatch(f.space, a.space) && a.key == f.key && (f.kind == "attr" || a.val == f.val) {
+					out = append(out, c)
+					break
+				}
+			}
+		}
+	case "child", "childval":
+		for _, c := range cands {
+			for _, cc := range childElems(c) {
+				if spaceMatch(f.space, cc.space) && cc.tag == f.key && (f.kind == "child" || cc.text() == f.val) {
+					out = append(out, c)
+					break
+				}
+			}
+		}
+	case "fn":
+		for _, c := range cands {
+			if fnValue(c, f.fn) != "" {
+				out = append(out, c)
+			}
+		}
+	case "fnval":
+		for _, c := range cands {
+			if fnValue(c, f.fn) == f.val {
+				out = append(out, c)
+			}
+		}
+	}
+	return out
+}
+
+// xpathOf translates a path to XPath for lxml, "" when the path uses what the two read
+// differently ([tag='v'] and [text()] compare etree's Text, not the string value; negative
+// and zero positions; namespace-prefix(); filters on the descendants selector).
+func xpathOf(p ppath) string {
+	var parts []string
+	for i, s := range p.segs {
+		var b strings.Builder
+		switch s.sel {
+		case "self":
+			b.WriteString("self::node()")
+		case "parent":
+			b.WriteString("parent::node()")
+		case "children":
+			b.WriteString("*")
+		case "desc":
+			if len(s.filters) > 0 {
+				return ""
+			}
+			b.WriteString("descendant-or-self::*")
+		case "tag":
+			b.WriteString("*[local-name()='" + s.tag + "'")
+			if s.space != "" {
+				b.WriteString(" and namespace-uri()='" + prefixURI[s.space] + "'")
+			}
+			b.WriteString("]")
+		}
+		for _, f := range s.filters {
+			q := string(f.quote)
+			ns := ""
+			if f.space != "" {
+				ns = " and namespace-uri()='" + prefixURI[f.space] + "'"
+			}
+			switch f.kind {
+			case "attr":
+				b.WriteString("[@*[local-name()='" + f.key + "'" + ns + "]]")
+			case "attrval":
+				b.WriteString("[@*[local-name()='" + f.key + "'" + ns + "]=" + q + f.val + q + "]")
+			case "child":
+				b.WriteString("[*[local-name()='" + f.key + "'" + ns + "]]")
+			case "pos":
+				if f.pos <= 0 {
+					return ""
+				}
+				b.WriteString("[" + fmt.Sprint(f.pos) + "]")
+			case "fn":
+				switch f.fn {
+				case "local-name", "name", "namespace-uri":
+					b.WriteString("[" + f.fn + "()!='']")
+				default:
+					return ""
+				}
+			case "fnval":
+				switch f.fn {
+				case "local-name", "name", "namespace-uri":
+					b.WriteString("[" + f.fn + "()=" + q + f.val + q + "]")
+				default:
+					return ""
+				}
+			default:
+				return ""
+			}
+		}
+		if i == 0 && !p.abs && s.sel == "desc" {
+			return ""
+		}
+		parts = append(parts, b.String())
+	}
+	x := strings.Join(parts, "/")
+	if p.abs {
+		x = "/" + x
+	}
+	return x
+}
+
+func idsOf[T comparable](elems []T, index map[T]int) []int {
+	var ids []int
+	for _, e := range elems {
+		if i, ok := index[e]; ok {
+			ids = append(ids, i)
+		}
+	}
+	sort.Ints(ids)
+	return ids
+}
+
+func sameInts(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// pathCase: a tree, a path, the element the search starts from (the document for -1, else the
+// element modulo their number) and whether the Seq form is left early.
+type pathCase struct {
+	tree  *tok
+	path  ppath
+	ctx   int
+	early bool
+}
+
+func (c pathCase) GoString() string {
+	return fmt.Sprintf("path %q from %d (early %v) in %s", resolved(c.path, c.tree).String(), c.ctx, c.early, c.tree.GoString())
+}
+
+var (
+	pathTrees = docsOf(treeOpts{attrWS: true, redeclare: true, wsText: true, maxDepth: 4, maxKids: 4})
+	pathCases = hegel.Composite(func(tc hegel.TestCase) pathCase {
+		return pathCase{tree: hegel.Draw(tc, pathTrees), path: hegel.Draw(tc, paths), ctx: hegel.Draw(tc, hegel.Integers(-1, 63)), early: hegel.Draw(tc, chance(50))}
+	})
+)
+
+// TestHegelPathsFollowTheModel: CompilePath accepts every path of the documented grammar;
+// FindElements from any element returns the model's set with no duplicates, FindElement its
+// first element, the Seq forms the same; lxml's XPath agrees on the shared subset. A '[' in a
+// quoted value (etree/8), a [0] filter (etree/7) and a position after a child filter (etree/6)
+// fail naming the bug.
+func TestHegelPathsFollowTheModel(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, pathCases)
+		m := c.tree
+		p := resolved(c.path, m)
+		ps := p.String()
+		shapes := pathShapes(p)
+		cp, err := etree.CompilePath(ps)
+		if err != nil {
+			col.mismatch(ht, shapes, "CompilePath(%q): %v", ps, err)
+			return
+		}
+		d := build(m)
+		me := m.elements()
+		// document order of etree's elements
+		var ee []*etree.Element
+		var walk func(*etree.Element)
+		walk = func(e *etree.Element) {
+			for _, c := range e.ChildElements() {
+				ee = append(ee, c)
+				walk(c)
+			}
+		}
+		walk(&d.Element)
+		if len(me) != len(ee) {
+			col.fail(ht, "built tree has %d elements, model %d", len(ee), len(me))
+			return
+		}
+		mIndex := map[*tok]int{m: -1}
+		eIndex := map[*etree.Element]int{&d.Element: -1}
+		for i := range me {
+			mIndex[me[i]] = i
+			eIndex[ee[i]] = i
+		}
+		ctx := -1
+		start, estart := m, &d.Element
+		if c.ctx >= 0 {
+			ctx = at(c.ctx, len(me))
+			start, estart = me[ctx], ee[ctx]
+		}
+		want := evalPath(start, p)
+		wantIDs := idsOf(want, mIndex)
+		got := estart.FindElementsPath(cp)
+		gotIDs := idsOf(got, eIndex)
+		gotSet := map[*etree.Element]bool{}
+		for _, e := range got {
+			if gotSet[e] {
+				col.mismatch(ht, shapes, "FindElements(%q) from %d returns an element twice", ps, ctx)
+				return
+			}
+			gotSet[e] = true
+		}
+		if !sameInts(wantIDs, gotIDs) {
+			out, _ := d.WriteToString()
+			col.mismatch(ht, shapes, "FindElements(%q) from element %d = %v, model %v\n%s", ps, ctx, gotIDs, wantIDs, out)
+			return
+		}
+		first := estart.FindElementPath(cp)
+		if (first == nil) != (len(got) == 0) || (first != nil && first != got[0]) {
+			col.fail(ht, "FindElement(%q) = %v, FindElements starts with %v", ps, first, got)
+			return
+		}
+		if len(got) > 0 {
+			k := 0
+			for e := range estart.FindElementsPathSeq(cp) {
+				if e != got[k] {
+					col.fail(ht, "FindElementsPathSeq(%q) differs from FindElementsPath at %d", ps, k)
+					return
+				}
+				k++
+				if k == 1 && c.early {
+					break
+				}
+			}
+		}
+		if len(want) == 0 {
+			col.count("empty")
+		} else {
+			col.count("hits")
+		}
+		// lxml on the shared subset.
+		x := xpathOf(p)
+		if x == "" || redeclared(m) || ctx < 0 {
+			return
+		}
+		for _, e := range want {
+			if e == m {
+				return // the document element has no lxml counterpart
+			}
+		}
+		d.WriteSettings.CanonicalText = true
+		d.WriteSettings.CanonicalAttrVal = true
+		out, _ := d.WriteToString()
+		lx, err := lxmlXPath(t, out, x, nil, ctx)
+		if err != nil {
+			col.fail(ht, "lxml xpath %q (from %q): %v\n%s", x, ps, err, out)
+			return
+		}
+		if !sameInts(lx, wantIDs) {
+			col.fail(ht, "lxml xpath %q (from etree path %q) from element %d = %v, etree and model %v\n%s", x, ps, ctx, lx, wantIDs, out)
+			return
+		}
+		col.count("lxml")
+	})
+}
+
+// --------------------------------------------------------------------------- mutations
+
+// pairing keeps model tokens and etree tokens aligned.
+type pairing struct {
+	toE map[*tok]etree.Token
+	toM map[etree.Token]*tok
+}
+
+func pairUp(m *tok, e *etree.Element, pr *pairing) {
+	if len(m.kids) != len(e.Child) {
+		panic("pairing: child count")
+	}
+	for i, k := range m.kids {
+		pr.toE[k] = e.Child[i]
+		pr.toM[e.Child[i]] = k
+		if k.kind == kElem {
+			pairUp(k, e.Child[i].(*etree.Element), pr)
+		}
+	}
+}
+
+// checkIndices: every child of every element knows its parent and its index.
+func checkIndices(e *etree.Element) string {
+	for i, c := range e.Child {
+		if c.Index() != i {
+			return fmt.Sprintf("child %d of <%s> has Index() %d", i, e.FullTag(), c.Index())
+		}
+		if c.Parent() != e {
+			return fmt.Sprintf("child %d of <%s> has another parent", i, e.FullTag())
+		}
+		if ce, ok := c.(*etree.Element); ok {
+			if s := checkIndices(ce); s != "" {
+				return s
+			}
+		}
+	}
+	return ""
+}
+
+func modelSetText(e *tok, s string, cdata bool) {
+	end := 0
+	for end < len(e.kids) && e.kids[end].isChar() {
+		end++
+	}
+	k := kText
+	if cdata {
+		k = kCData
+	}
+	var repl []*tok
+	if s != "" {
+		repl = []*tok{{kind: k, data: s, parent: e, created: true}}
+	}
+	e.kids = append(e.kids[:0:0], append(append(append([]*tok{}, e.kids[:0]...), repl...), e.kids[end:]...)...)
+}
+
+func modelSetTail(e *tok, s string) {
+	p := e.parent
+	if p == nil {
+		return
+	}
+	i := e.index() + 1
+	end := i
+	for end < len(p.kids) && p.kids[end].isChar() {
+		end++
+	}
+	var repl []*tok
+	if s != "" {
+		repl = []*tok{{kind: kText, data: s, parent: p, created: true}}
+	}
+	rest := append([]*tok{}, p.kids[end:]...)
+	p.kids = append(append(p.kids[:i], repl...), rest...)
+}
+
+// leadingCommentBeforeText: a comment among the leading character data (etree/5).
+func leadingCommentBeforeText(e *tok) bool {
+	comment := false
+	for _, c := range e.kids {
+		switch {
+		case c.kind == kComment:
+			comment = true
+		case c.isChar():
+			if comment {
+				return true
+			}
+		default:
+			return false
+		}
+	}
+	return false
+}
+
+// freshSpec is a token made outside the tree: an element, a text, a comment or an instruction
+// (the last two are numbered when made).
+type freshSpec struct {
+	kind  kind
+	space string
+	tag   string
+	text  string
+}
+
+var freshSpecs = hegel.OneOf(
+	hegel.Composite(func(tc hegel.TestCase) freshSpec {
+		return freshSpec{kind: kElem, space: hegel.Draw(tc, spaces), tag: hegel.Draw(tc, tags)}
+	}),
+	hegel.Map(texts, func(s string) freshSpec { return freshSpec{kind: kText, text: s} }),
+	hegel.Just(freshSpec{kind: kComment}),
+	hegel.Just(freshSpec{kind: kPI}),
+)
+
+// mop is one drawn operation of the mutation sequence; positions are taken modulo the live
+// sizes when it is applied.
+type mop struct {
+	op       string
+	target   int       // an element (the document included)
+	tok      int       // a token of the tree, or of the detached pool
+	fresh    bool      // a fresh token rather than one of the tree (add, insert, setRoot)
+	spec     freshSpec // the fresh token
+	index    int       // the child position (insert, removeAt)
+	negative bool      // index -1 instead (etree/2)
+	other    int       // another element (remove)
+	coin     bool      // remove: try the other element's RemoveChild; setRoot: a fresh element
+	text     string    // setText, setCData, setTail
+	attr     attr      // attr
+}
+
+func (o mop) GoString() string {
+	switch o.op {
+	case "add", "insert":
+		if o.fresh {
+			return fmt.Sprintf("%s{target:%d, fresh:%+v, index:%d, negative:%v}", o.op, o.target, o.spec, o.index, o.negative)
+		}
+		return fmt.Sprintf("%s{target:%d, tok:%d, index:%d, negative:%v}", o.op, o.target, o.tok, o.index, o.negative)
+	case "removeAt":
+		return fmt.Sprintf("removeAt{target:%d, index:%d, negative:%v}", o.target, o.index, o.negative)
+	case "remove":
+		return fmt.Sprintf("remove{tok:%d, other:%d, viaOther:%v}", o.tok, o.other, o.coin)
+	case "removeTok", "siblings", "textTail", "sortAttrs", "copy":
+		return fmt.Sprintf("%s{tok:%d, target:%d}", o.op, o.tok, o.target)
+	case "removeDetached":
+		return fmt.Sprintf("removeDetached{tok:%d, fresh:%+v}", o.tok, o.spec)
+	case "setText", "setCData", "setTail":
+		return fmt.Sprintf("%s{target:%d, tok:%d, text:%q}", o.op, o.target, o.tok, o.text)
+	case "attr", "removeAttr":
+		return fmt.Sprintf("%s{target:%d, attr:%+v, tok:%d}", o.op, o.target, o.attr, o.tok)
+	case "setRoot":
+		return fmt.Sprintf("setRoot{fresh:%v, spec:%+v, target:%d}", o.coin, o.spec, o.target)
+	}
+	return fmt.Sprintf("%+v", o)
+}
+
+var (
+	elemPicks = hegel.Integers(0, 63)
+	tokPicks  = hegel.Integers(0, 127)
+	indexes   = hegel.Integers(0, 63)
+	negatives = chance(8)
+	// attrs: an attribute to create (a prefix two times in five, so that an unprefixed
+	// attribute beside a prefixed one of its key is drawn: etree/10)
+	attrs = hegel.Composite(func(tc hegel.TestCase) attr {
+		return attr{space: hegel.Draw(tc, spaces), key: hegel.Draw(tc, keys), val: hegel.Draw(tc, shortTexts)}
+	})
+	// mutation ops: a read-only check first, then the operations with their weights
+	mopsOf = func(op string, g hegel.Generator[mop]) hegel.Generator[mop] {
+		return hegel.Map(g, func(o mop) mop { o.op = op; return o })
+	}
+	tokOps = hegel.Composite(func(tc hegel.TestCase) mop {
+		return mop{tok: hegel.Draw(tc, tokPicks), target: hegel.Draw(tc, elemPicks)}
+	})
+	placeOps = hegel.Composite(func(tc hegel.TestCase) mop {
+		return mop{target: hegel.Draw(tc, elemPicks), tok: hegel.Draw(tc, tokPicks), fresh: hegel.Draw(tc, chance(40)), spec: hegel.Draw(tc, freshSpecs),
+			index: hegel.Draw(tc, indexes), negative: hegel.Draw(tc, negatives)}
+	})
+	textOps = hegel.Composite(func(tc hegel.TestCase) mop {
+		return mop{target: hegel.Draw(tc, elemPicks), tok: hegel.Draw(tc, tokPicks), text: hegel.Draw(tc, shortTexts)}
+	})
+	mops = weighted(
+		choice[mop]{1, mopsOf("textTail", tokOps)},
+		choice[mop]{1, mopsOf("siblings", tokOps)},
+		choice[mop]{2, mopsOf("add", placeOps)},
+		choice[mop]{2, mopsOf("insert", placeOps)},
+		choice[mop]{1, mopsOf("removeAt", placeOps)},
+		choice[mop]{1, mopsOf("remove", hegel.Composite(func(tc hegel.TestCase) mop {
+			return mop{tok: hegel.Draw(tc, tokPicks), other: hegel.Draw(tc, elemPicks), coin: hegel.Draw(tc, chance(30))}
+		}))},
+		choice[mop]{1, mopsOf("removeTok", tokOps)},
+		choice[mop]{1, mopsOf("removeDetached", hegel.Composite(func(tc hegel.TestCase) mop {
+			return mop{tok: hegel.Draw(tc, tokPicks), spec: hegel.Draw(tc, freshSpecs)}
+		}))},
+		choice[mop]{2, mopsOf("setText", textOps)},
+		choice[mop]{1, mopsOf("setCData", textOps)},
+		choice[mop]{1, mopsOf("setTail", textOps)},
+		choice[mop]{2, mopsOf("attr", hegel.Composite(func(tc hegel.TestCase) mop {
+			return mop{target: hegel.Draw(tc, elemPicks), attr: hegel.Draw(tc, attrs)}
+		}))},
+		choice[mop]{1, mopsOf("removeAttr", tokOps)},
+		choice[mop]{1, mopsOf("sortAttrs", tokOps)},
+		choice[mop]{1, mopsOf("setRoot", hegel.Composite(func(tc hegel.TestCase) mop {
+			return mop{coin: hegel.Draw(tc, chance(50)), spec: hegel.Draw(tc, freshSpecs), target: hegel.Draw(tc, elemPicks)}
+		}))},
+		choice[mop]{1, mopsOf("copy", tokOps)},
+	)
+	mutationTrees = docsOf(treeOpts{attrWS: true, docTokens: true, wsText: true, maxDepth: 3, maxKids: 3})
+	mutationCases = hegel.Composite(func(tc hegel.TestCase) mutationCase {
+		return mutationCase{tree: hegel.Draw(tc, mutationTrees), ops: hegel.Draw(tc, many(mops, 1, 25))}
+	})
+)
+
+type mutationCase struct {
+	tree *tok
+	ops  []mop
+}
+
+func (c mutationCase) GoString() string {
+	var ops []string
+	for _, o := range c.ops {
+		ops = append(ops, o.GoString())
+	}
+	return fmt.Sprintf("tree %s ops [%s]", c.tree.GoString(), strings.Join(ops, " "))
+}
+
+// mutation is the live state of one case: the model, the document, their pairing, the pool of
+// detached tokens (removed or made and not placed) with their etree counterparts, and the
+// fresh-token counter.
+type mutation struct {
+	col   *collector
+	ht    *hegel.T
+	m     *tok
+	d     *etree.Document
+	pr    *pairing
+	pool  []*tok
+	poolE map[*tok]etree.Token
+	fresh int
+	bad   bool // the case has failed (or been skipped): stop applying
+}
+
+func (s *mutation) repair() {
+	s.pr = &pairing{toE: map[*tok]etree.Token{}, toM: map[etree.Token]*tok{}}
+	s.pr.toE[s.m] = &s.d.Element
+	s.pr.toM[&s.d.Element] = s.m
+	pairUp(s.m, &s.d.Element, s.pr)
+}
+
+func (s *mutation) fail(format string, args ...any) {
+	s.bad = true
+	s.col.fail(s.ht, format, args...)
+}
+
+func (s *mutation) mismatch(shapes []string, format string, args ...any) {
+	s.bad = true
+	s.col.mismatch(s.ht, shapes, format, args...)
+}
+
+// etok is the etree token of a model token, attached or pooled.
+func (s *mutation) etok(t *tok) etree.Token {
+	if e, ok := s.pr.toE[t]; ok {
+		return e
+	}
+	return s.poolE[t]
+}
+
+// newTok makes a fresh token from its spec, into the pool.
+func (s *mutation) newTok(spec freshSpec) *tok {
+	s.fresh++
+	var mt *tok
+	var et etree.Token
+	switch spec.kind {
+	case kElem:
+		mt = elem(spec.space, spec.tag)
+		et = etree.NewElement(mt.fullTag())
+	case kText:
+		mt = &tok{kind: kText, data: spec.text, created: true}
+		et = etree.NewText(spec.text)
+	case kComment:
+		mt = &tok{kind: kComment, data: fmt.Sprint("c", s.fresh)}
+		et = etree.NewComment(mt.data)
+	default:
+		mt = &tok{kind: kPI, target: "t", data: fmt.Sprint("i", s.fresh)}
+		et = etree.NewProcInst("t", mt.data)
+	}
+	s.toPool(mt, et)
+	return mt
+}
+
+func (s *mutation) toPool(t *tok, e etree.Token) {
+	if s.poolE == nil {
+		s.poolE = map[*tok]etree.Token{}
+	}
+	if _, ok := s.poolE[t]; !ok {
+		s.pool = append(s.pool, t)
+	}
+	s.poolE[t] = e
+}
+
+func (s *mutation) fromPool(t *tok) {
+	for i, p := range s.pool {
+		if p == t {
+			s.pool = append(s.pool[:i], s.pool[i+1:]...)
+			break
+		}
+	}
+	delete(s.poolE, t)
+}
+
+func (s *mutation) anyElem(i int) *tok {
+	els := append([]*tok{s.m}, s.m.elements()...)
+	return els[at(i, len(els))]
+}
+
+func (s *mutation) anyTok(i int) *tok {
+	all := s.m.all()[1:]
+	if len(all) == 0 {
+		return nil
+	}
+	return all[at(i, len(all))]
+}
+
+// apply runs one operation on the document and the model and checks what the operation
+// documents.
+func (s *mutation) apply(o mop) {
+	m, d, pr, col := s.m, s.d, s.pr, s.col
+	switch o.op {
+	case "add", "insert":
+		target := s.anyElem(o.target)
+		var tk *tok
+		if o.fresh {
+			tk = s.newTok(o.spec)
+		} else {
+			tk = s.anyTok(o.tok)
+			if tk == nil || (tk.kind == kElem && isAncestor(tk, target)) {
+				col.count("noop")
+				return
+			}
+		}
+		et := s.etok(tk)
+		te := pr.toE[target].(*etree.Element)
+		if o.op == "add" {
+			te.AddChild(et)
+			tk.detach()
+			s.fromPool(tk)
+			target.add(tk)
+			return
+		}
+		i := at(o.index, len(target.kids)+2)
+		if o.negative {
+			i = -1
+		}
+		if i < 0 && Known.negativeIndexPanics {
+			col.count("negative-gated")
+			return
+		}
+		if i < 0 {
+			if p := catching(func() { te.InsertChildAt(i, et) }); p != nil {
+				s.mismatch([]string{"etree/2"}, "InsertChildAt(%d) panics: %v", i, p)
+				return
+			}
+			// Not documented beyond "a negative index is out of bounds": the token is a child
+			// of the target (the pin asserts that much); the model takes the position etree chose.
+			if et.Parent() != te {
+				s.fail("InsertChildAt(%d) did not insert the token", i)
+				return
+			}
+			i = et.Index()
+		} else {
+			te.InsertChildAt(i, et)
+		}
+		j := i
+		if tk.parent == target && tk.index() < i {
+			j--
+		}
+		tk.detach()
+		s.fromPool(tk)
+		target.insertAt(j, tk)
+	case "removeAt":
+		target := s.anyElem(o.target)
+		te := pr.toE[target].(*etree.Element)
+		i := at(o.index, len(target.kids)+2)
+		if o.negative {
+			i = -1
+		}
+		if i < 0 && Known.negativeIndexPanics {
+			col.count("negative-gated")
+			return
+		}
+		var got etree.Token
+		if p := catching(func() { got = te.RemoveChildAt(i) }); p != nil {
+			s.mismatch([]string{"etree/2"}, "RemoveChildAt(%d) of %d children panics: %v", i, len(target.kids), p)
+			return
+		}
+		if i < 0 || i >= len(target.kids) {
+			if got != nil {
+				s.fail("RemoveChildAt(%d) of %d children returned a token", i, len(target.kids))
+			}
+			return
+		}
+		want := target.kids[i]
+		if got != pr.toE[want] {
+			s.fail("RemoveChildAt(%d) returned another token", i)
+			return
+		}
+		if got.Parent() != nil || got.Index() != -1 {
+			s.fail("removed token has parent %v index %d", got.Parent(), got.Index())
+			return
+		}
+		want.detach()
+		s.toPool(want, got)
+	case "remove", "removeTok":
+		tk := s.anyTok(o.tok)
+		if tk == nil {
+			col.count("noop")
+			return
+		}
+		et := pr.toE[tk]
+		parent := pr.toE[tk.parent].(*etree.Element)
+		if o.op == "remove" {
+			other := pr.toE[s.anyElem(o.other)].(*etree.Element)
+			if o.coin && other != parent {
+				if r := other.RemoveChild(et); r != nil {
+					s.fail("RemoveChild of a token that is not a child returned it")
+				}
+				return
+			}
+			if r := parent.RemoveChild(et); r != et {
+				s.fail("RemoveChild returned %v", r)
+				return
+			}
+		} else if !et.Remove() {
+			s.fail("Remove() of a parented token returned false")
+			return
+		}
+		if et.Parent() != nil || et.Index() != -1 {
+			s.fail("removed token has parent %v index %d", et.Parent(), et.Index())
+			return
+		}
+		tk.detach()
+		s.toPool(tk, et)
+	case "removeDetached":
+		// Remove() on a token without a parent returns false and changes nothing (etree/1).
+		if Known.removeUnparentedPanics {
+			col.count("detached-remove-gated")
+			return
+		}
+		var tk *tok
+		if len(s.pool) > 0 {
+			tk = s.pool[at(o.tok, len(s.pool))]
+		} else {
+			tk = s.newTok(o.spec)
+		}
+		et := s.poolE[tk]
+		var r bool
+		if p := catching(func() { r = et.Remove() }); p != nil {
+			s.mismatch([]string{"etree/1"}, "Remove() of a %s without a parent panics: %v", kindNames[tk.kind], p)
+			return
+		}
+		if r {
+			s.fail("Remove() of a %s without a parent returned true", kindNames[tk.kind])
+			return
+		}
+		if et.Parent() != nil || et.Index() != -1 {
+			s.fail("a detached token has parent %v index %d after Remove()", et.Parent(), et.Index())
+			return
+		}
+	case "setText", "setCData":
+		target := s.anyElem(o.target)
+		te := pr.toE[target].(*etree.Element)
+		s2 := o.text
+		comment := leadingCommentBeforeText(target)
+		if o.op == "setText" {
+			te.SetText(s2)
+		} else {
+			te.SetCData(s2)
+		}
+		modelSetText(target, s2, o.op == "setCData")
+		if comment && Known.setTextIgnoresComments {
+			col.count("settext-comment-gated")
+		} else if te.Text() != s2 {
+			var shapes []string
+			if comment {
+				shapes = []string{"etree/5"}
+			}
+			s.mismatch(shapes, "%s(%q) then Text() = %q (children %s)", o.op, s2, te.Text(), describe(target))
+			return
+		}
+		// New CharData tokens: pair them up again below.
+	case "setTail":
+		tk := s.anyTok(o.tok)
+		if tk == nil || tk.kind != kElem {
+			col.count("noop")
+			return
+		}
+		te := pr.toE[tk].(*etree.Element)
+		te.SetTail(o.text)
+		modelSetTail(tk, o.text)
+		if te.Tail() != o.text {
+			s.fail("SetTail(%q) then Tail() = %q", o.text, te.Tail())
+			return
+		}
+	case "attr":
+		target := s.anyElem(o.target)
+		if target == m {
+			col.count("noop")
+			return
+		}
+		te := pr.toE[target].(*etree.Element)
+		a := o.attr
+		te.CreateAttr(a.fullKey(), a.val)
+		found := false
+		for i := range target.attrs {
+			if target.attrs[i].space == a.space && target.attrs[i].key == a.key {
+				target.attrs[i].val = a.val
+				found = true
+			}
+		}
+		if !found {
+			target.attrs = append(target.attrs, a)
+		}
+		// SelectAttr with the full key finds it (an unprefixed key may find a prefixed
+		// attribute first: etree/10).
+		shadow := false
+		if a.space == "" {
+			for _, b := range target.attrs {
+				if b.key == a.key && b.space != "" {
+					shadow = true
+				}
+			}
+		}
+		if shadow && Known.prefixedAttrShadows {
+			col.count("attr-shadow-gated")
+		} else if v := te.SelectAttrValue(a.fullKey(), "\x00"); v != a.val {
+			var shapes []string
+			if shadow {
+				shapes = []string{"etree/10"}
+			}
+			s.mismatch(shapes, "CreateAttr(%q, %q) then SelectAttrValue = %q (attrs %v)", a.fullKey(), a.val, v, target.attrs)
+			return
+		}
+	case "removeAttr":
+		target := s.anyElem(o.target)
+		if target == m || len(target.attrs) == 0 {
+			col.count("noop")
+			return
+		}
+		te := pr.toE[target].(*etree.Element)
+		a := target.attrs[at(o.tok, len(target.attrs))]
+		got := te.RemoveAttr(a.fullKey())
+		if got == nil || got.Value != a.val || got.Space != a.space || got.Key != a.key {
+			s.fail("RemoveAttr(%q) = %+v, want %+v", a.fullKey(), got, a)
+			return
+		}
+		for i := range target.attrs {
+			if target.attrs[i].space == a.space && target.attrs[i].key == a.key {
+				target.attrs = append(target.attrs[:i], target.attrs[i+1:]...)
+				break
+			}
+		}
+		if te.RemoveAttr("nosuch:"+a.key) != nil {
+			s.fail("RemoveAttr of a missing attribute returned one")
+			return
+		}
+	case "sortAttrs":
+		target := s.anyElem(o.target)
+		te := pr.toE[target].(*etree.Element)
+		te.SortAttrs()
+		sort.SliceStable(target.attrs, func(i, j int) bool {
+			a, b := target.attrs[i], target.attrs[j]
+			if a.space != b.space {
+				return a.space < b.space
+			}
+			return a.key < b.key
+		})
+	case "setRoot":
+		var tk *tok
+		if o.coin {
+			tk = s.newTok(o.spec)
+			if tk.kind != kElem {
+				col.count("noop")
+				return
+			}
+		} else {
+			els := append([]*tok{elem("", "n")}, m.elements()...)
+			tk = els[at(o.target, len(els))]
+			if tk.parent == nil {
+				s.toPool(tk, etree.NewElement("n"))
+			}
+		}
+		et := s.etok(tk).(*etree.Element)
+		d.SetRoot(et)
+		tk.detach()
+		s.fromPool(tk)
+		replaced := false
+		for i, k := range m.kids {
+			if k.kind == kElem {
+				m.kids[i] = tk
+				tk.parent = m
+				k.parent = nil
+				if k != tk {
+					s.toPool(k, pr.toE[k])
+				}
+				replaced = true
+				break
+			}
+		}
+		if !replaced {
+			m.add(tk)
+		}
+		if d.Root() != et {
+			s.fail("Root() after SetRoot is another element")
+			return
+		}
+	case "copy":
+		target := s.anyElem(o.target)
+		if target == m {
+			col.count("noop")
+			return
+		}
+		te := pr.toE[target].(*etree.Element)
+		cp := te.Copy()
+		cd := etree.NewDocumentWithRoot(cp)
+		cm := norm(fromEtree(cd), true)
+		want := elem("", "")
+		want.add(target.clone())
+		if dd := diff(norm(want, true), cm, false, false, "copy"); dd != "" {
+			s.fail("Copy differs from the original: %s", dd)
+			return
+		}
+		if cp.Parent() != cd.Root().Parent() {
+			s.fail("copy's parent is not the new document")
+			return
+		}
+		cp2 := te.Copy()
+		if cp2.Parent() != nil {
+			s.fail("Copy() has a parent")
+			return
+		}
+		if Known.copyKeepsIndex {
+			col.count("copy-index-gated")
+		} else if cp2.Index() != -1 {
+			s.mismatch([]string{"etree/3"}, "Copy() of the child at index %d has Index() %d without a parent", te.Index(), cp2.Index())
+			return
+		}
+		cp.CreateElement("added").CreateText("x")
+		cp.CreateAttr("added", "1")
+	case "siblings":
+		tk := s.anyTok(o.tok)
+		if tk == nil || tk.kind != kElem {
+			col.count("noop")
+			return
+		}
+		te := pr.toE[tk].(*etree.Element)
+		sibs := childElems(tk.parent)
+		i := 0
+		for sibs[i] != tk {
+			i++
+		}
+		var wantPrev, wantNext etree.Token
+		if i > 0 {
+			wantPrev = pr.toE[sibs[i-1]]
+		}
+		if i+1 < len(sibs) {
+			wantNext = pr.toE[sibs[i+1]]
+		}
+		if p := te.PrevSibling(); (p == nil) != (wantPrev == nil) || (p != nil && etree.Token(p) != wantPrev) {
+			s.fail("PrevSibling wrong")
+			return
+		}
+		if nx := te.NextSibling(); (nx == nil) != (wantNext == nil) || (nx != nil && etree.Token(nx) != wantNext) {
+			s.fail("NextSibling wrong")
+			return
+		}
+		if te.Index() != tk.index() {
+			s.fail("Index() = %d, model %d", te.Index(), tk.index())
+			return
+		}
+	case "textTail":
+		tk := s.anyTok(o.tok)
+		if tk == nil || tk.kind != kElem {
+			col.count("noop")
+			return
+		}
+		te := pr.toE[tk].(*etree.Element)
+		if te.Text() != tk.text() {
+			s.fail("Text() = %q, model %q (children %s)", te.Text(), tk.text(), describe(tk))
+			return
+		}
+		if te.Tail() != tk.tail() {
+			s.fail("Tail() = %q, model %q", te.Tail(), tk.tail())
+			return
+		}
+	}
+}
+
+// TestHegelMutationsFollowTheModel: random sequences of AddChild, InsertChildAt, RemoveChildAt,
+// RemoveChild, Remove (on children and on detached tokens), SetText/SetCData/SetTail,
+// CreateAttr/RemoveAttr/SortAttrs, SetRoot and Copy keep the tree equal to the model, every
+// child's Index and Parent right, Text/Tail, siblings and attribute lookups as documented, and
+// the tree writable and readable. Remove() on a detached token (etree/1), a negative index
+// (etree/2), Copy's Index (etree/3), SetText below a leading comment (etree/5) and an
+// unprefixed attribute beside a prefixed one (etree/10) fail naming the bug.
+func TestHegelMutationsFollowTheModel(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, mutationCases)
+		s := &mutation{col: col, ht: ht, m: c.tree, d: build(c.tree)}
+		s.repair()
+		for _, o := range c.ops {
+			s.apply(o)
+			if s.bad {
+				return
+			}
+			if r := checkIndices(&s.d.Element); r != "" {
+				col.fail(ht, "after %s: %s", o.op, r)
+				return
+			}
+			got := fromEtree(s.d)
+			if dd := diff(s.m, got, false, false, "doc"); dd != "" {
+				col.fail(ht, "after %s the tree differs from the model: %s", o.op, dd)
+				return
+			}
+			// Re-pair (SetText/SetTail create tokens).
+			s.repair()
+		}
+		// The result writes and reads back.
+		m, d := s.m, s.d
+		out, err := d.WriteToString()
+		if err != nil {
+			col.fail(ht, "WriteToString: %v", err)
+			return
+		}
+		shapes := rawWhitespaceShapes(m, d.WriteSettings, false)
+		if len(shapes) > 0 && Known.rawWhitespace {
+			col.count("cr-gated")
+			return
+		}
+		d2 := etree.NewDocument()
+		d2.ReadSettings.PreserveCData = true
+		if err := d2.ReadFromString(out); err != nil {
+			col.mismatch(ht, shapes, "ReadFromString after mutations: %v\n%s", err, out)
+			return
+		}
+		if dd := diff(norm(expected(m), true), norm(fromEtree(d2), true), false, false, "doc"); dd != "" {
+			col.mismatch(ht, shapes, "read(write) after mutations differs: %s\n%s", dd, out)
+			return
+		}
+		col.count("ok")
+	})
+}
+
+// --------------------------------------------------------------------------- indentation
+
+type indentOpts struct {
+	spaces                     int
+	tabs, crlf, preserveLeaf   bool
+	suppressTrailingWhitespace bool
+}
+
+var indentSettings = hegel.Composite(func(tc hegel.TestCase) indentOpts {
+	return indentOpts{spaces: hegel.Draw(tc, hegel.Integers(-1, 4)), tabs: hegel.Draw(tc, chance(25)), crlf: hegel.Draw(tc, chance(25)),
+		preserveLeaf: hegel.Draw(tc, chance(30)), suppressTrailingWhitespace: hegel.Draw(tc, chance(30))}
+})
+
+func (o indentOpts) settings() *etree.IndentSettings {
+	is := etree.NewIndentSettings()
+	is.Spaces = o.spaces
+	is.UseTabs = o.tabs
+	is.UseCRLF = o.crlf
+	is.PreserveLeafWhitespace = o.preserveLeaf
+	is.SuppressTrailingWhitespace = o.suppressTrailingWhitespace
+	return is
+}
+
+func indentString(o indentOpts, depth int) string {
+	nl := "\n"
+	if o.crlf {
+		nl = "\r\n"
+	}
+	if o.tabs {
+		if depth < 0 {
+			return nl
+		}
+		return nl + strings.Repeat("\t", depth)
+	}
+	if o.spaces < 0 {
+		return ""
+	}
+	k := depth * o.spaces
+	if k < 0 {
+		return nl
+	}
+	return nl + strings.Repeat(" ", k)
+}
+
+func isWSTok(t *tok) bool { return t.kind == kText && !t.created }
+
+// modelIndent is the documented Indent: earlier indentation (whitespace-only text) is removed,
+// then every non-character child is put on a new line at its depth and the end tag on its own.
+func modelIndent(e *tok, depth int, o indentOpts) {
+	// strip
+	nws := 0
+	for _, c := range e.kids {
+		if isWSTok(c) {
+			nws++
+		}
+	}
+	if nws > 0 && !(nws == len(e.kids) && len(e.kids) == 1 && o.preserveLeaf) {
+		var kept []*tok
+		for _, c := range e.kids {
+			if !isWSTok(c) {
+				kept = append(kept, c)
+			}
+		}
+		e.kids = kept
+	}
+	if len(e.kids) == 0 {
+		return
+	}
+	old := e.kids
+	e.kids = nil
+	isChar, firstNon := false, true
+	for _, c := range old {
+		isChar = c.isChar()
+		if !isChar {
+			if !firstNon || depth > 0 {
+				if s := indentString(o, depth); s != "" {
+					e.add(&tok{kind: kText, data: s})
+				}
+			}
+			firstNon = false
+		}
+		e.add(c)
+		if c.kind == kElem {
+			modelIndent(c, depth+1, o)
+		}
+	}
+	if !isChar && (!firstNon || depth > 0) {
+		if s := indentString(o, depth-1); s != "" {
+			e.add(&tok{kind: kText, data: s})
+		}
+	}
+}
+
+// whitespaceByModel marks every whitespace-only text as whitespace, as documented, whatever
+// made it.
+func whitespaceByModel(m *tok) *tok {
+	for _, k := range m.all() {
+		if k.kind == kText {
+			k.created = !isWS(k.data)
+		}
+	}
+	return m
+}
+
+// createdWhitespace says whether a tree built through the API holds a whitespace-only text
+// (etree/4's shape: etree does not flag it).
+func createdWhitespace(m *tok) bool {
+	for _, k := range m.all() {
+		if k.kind == kText && isWS(k.data) {
+			return true
+		}
+	}
+	return false
+}
+
+// indentCase: a tree, whether the document is the parsed form of it or the tree as built
+// through the API, and the settings.
+type indentCase struct {
+	tree  *tok
+	built bool
+	opts  indentOpts
+}
+
+func (c indentCase) GoString() string {
+	return fmt.Sprintf("indent %+v of %s tree %s", c.opts, map[bool]string{false: "parsed", true: "built"}[c.built], c.tree.GoString())
+}
+
+var (
+	indentTrees = docsOf(treeOpts{attrWS: true, docTokens: true, wsText: true, maxDepth: 4, maxKids: 4})
+	// builtTrees: under HEGEL_NO_KNOWN=1 no whitespace-only text is created through the API.
+	builtTrees  = docsOf(treeOpts{attrWS: true, docTokens: true, wsText: shaped(true, false), maxDepth: 4, maxKids: 4})
+	indentCases = hegel.Composite(func(tc hegel.TestCase) indentCase {
+		c := indentCase{built: hegel.Draw(tc, chance(50)), opts: hegel.Draw(tc, indentSettings)}
+		if c.built {
+			c.tree = hegel.Draw(tc, builtTrees)
+		} else {
+			c.tree = hegel.Draw(tc, indentTrees)
+		}
+		return c
+	})
+)
+
+// TestHegelIndentFollowsTheModel: on a parsed document, and on one built through the API,
+// IndentWithSettings (spaces, tabs, CRLF, PreserveLeafWhitespace, SuppressTrailingWhitespace)
+// produces the modelled tree; the indented document reads back to itself; Indent is
+// idempotent; Unindent restores the whitespace-stripped tree. A whitespace-only text created
+// through the API, which Indent should strip like parsed whitespace (etree/4), fails naming
+// the bug.
+func TestHegelIndentFollowsTheModel(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, indentCases)
+		m0, o := c.tree, c.opts
+		var d *etree.Document
+		var m *tok
+		var shapes []string
+		src := ""
+		if c.built {
+			d = build(m0)
+			m = whitespaceByModel(m0.clone())
+			if createdWhitespace(m0) {
+				shapes = []string{"etree/4"}
+			}
+			col.count("built")
+		} else {
+			// Work on a parsed tree so that whitespace flags are the parser's.
+			d0 := build(m0)
+			src, _ = d0.WriteToString()
+			d = etree.NewDocument()
+			d.ReadSettings.PreserveCData = true
+			if err := d.ReadFromString(src); err != nil {
+				col.fail(ht, "ReadFromString: %v", err)
+				return
+			}
+			m = whitespaceByModel(norm(expected(m0), true))
+			col.count("parsed")
+		}
+		is := o.settings()
+		d.IndentWithSettings(is)
+		want := m.clone()
+		modelIndent(want, 0, o)
+		if o.suppressTrailingWhitespace {
+			for len(want.kids) > 0 && want.kids[len(want.kids)-1].isChar() && isWS(want.kids[len(want.kids)-1].data) {
+				want.kids = want.kids[:len(want.kids)-1]
+			}
+		}
+		got := fromEtree(d)
+		if dd := diff(norm(want, true), norm(got, true), false, false, "doc"); dd != "" {
+			out, _ := d.WriteToString()
+			col.mismatch(ht, shapes, "indent %+v differs from the model: %s\nsource %s\nindented %q", o, dd, src, out)
+			return
+		}
+		// idempotent
+		d.IndentWithSettings(is)
+		if dd := diff(norm(got, true), norm(fromEtree(d), true), false, false, "doc"); dd != "" {
+			col.fail(ht, "a second identical Indent changed the tree: %s", dd)
+			return
+		}
+		// reads back (sanitised as every write is)
+		out, _ := d.WriteToString()
+		d2 := etree.NewDocument()
+		d2.ReadSettings.PreserveCData = true
+		if err := d2.ReadFromString(out); err != nil {
+			col.fail(ht, "indented document does not read: %v\n%q", err, out)
+			return
+		}
+		back := expected(got)
+		if o.crlf {
+			// the parser normalises CRLF
+			for _, k := range back.all() {
+				if k.kind == kText || k.kind == kCData || k.kind == kComment || k.kind == kPI {
+					k.data = normCR(k.data)
+				}
+			}
+		}
+		if dd := diff(norm(back, true), norm(fromEtree(d2), true), false, false, "doc"); dd != "" {
+			col.fail(ht, "indented document reads back differently: %s\n%q", dd, out)
+			return
+		}
+		// Unindent strips every whitespace text.
+		d.Unindent()
+		stripped := m.clone()
+		modelIndent(stripped, 0, indentOpts{spaces: -1})
+		if dd := diff(norm(stripped, true), norm(fromEtree(d), true), false, false, "doc"); dd != "" {
+			col.fail(ht, "Unindent after Indent differs from the stripped tree: %s\n%q", dd, out)
+			return
+		}
+		col.count(fmt.Sprintf("spaces=%d", o.spaces))
+	})
+}
