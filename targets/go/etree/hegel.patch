+package etree_test
+
+// lxml (Python) as the second voice: it parses the XML etree writes (and the
+// XML the harness writes) into a tree the properties compare with the model,
+// and evaluates XPath expressions translated from etree paths. One persistent
+// child process answers newline-delimited JSON requests.
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"sync"
+	"testing"
+)
+
+const pythonScript = `
+import sys, json
+from lxml import etree as L
+
+def conv(e):
+    kids = []
+    if e.text:
+        kids.append({"k": "t", "d": e.text})
+    for c in e:
+        kids.append(node(c))
+        if c.tail:
+            kids.append({"k": "t", "d": c.tail})
+    return {"k": "e", "tag": e.tag, "prefix": e.prefix or "",
+            "attrs": [[k, v] for k, v in e.attrib.items()], "kids": kids}
+
+def node(c):
+    if isinstance(c.tag, str):
+        return conv(c)
+    if c.tag is L.Comment:
+        return {"k": "c", "d": c.text or ""}
+    if c.tag is L.ProcessingInstruction:
+        return {"k": "p", "target": c.target, "d": c.text or ""}
+    return {"k": "?", "d": str(c.tag)}
+
+def parser():
+    return L.XMLParser(strip_cdata=True, resolve_entities=False, remove_comments=False,
+                       remove_pis=False, remove_blank_text=False, huge_tree=True)
+
+def parse(xml):
+    root = L.fromstring(xml.encode("utf-8"), parser())
+    tree = root.getroottree()
+    prevs = []
+    p = root.getprevious()
+    while p is not None:
+        prevs.append(node(p))
+        p = p.getprevious()
+    kids = list(reversed(prevs))
+    kids.append(conv(root))
+    n = root.getnext()
+    while n is not None:
+        kids.append(node(n))
+        n = n.getnext()
+    return {"doctype": tree.docinfo.doctype or "", "kids": kids}
+
+def xpath(xml, expr, ns, ctx):
+    root = L.fromstring(xml.encode("utf-8"), parser())
+    elems = [e for e in root.iter() if isinstance(e.tag, str)]
+    idx = {}
+    for i, e in enumerate(elems):
+        idx[e] = i
+    res = elems[ctx].xpath(expr, namespaces=ns or None)
+    out = set()
+    for e in res:
+        if isinstance(e, L._Element) and isinstance(e.tag, str):
+            out.add(idx[e])
+    return sorted(out)
+
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        if req["cmd"] == "P":
+            rep = parse(req["xml"])
+        elif req["cmd"] == "X":
+            rep = {"ids": xpath(req["xml"], req["expr"], req.get("ns") or {}, req["ctx"])}
+        else:
+            rep = {"error": "unknown command"}
+    except Exception as ex:
+        rep = {"error": type(ex).__name__ + ": " + str(ex)}
+    sys.stdout.write(json.dumps(rep) + "\n")
+    sys.stdout.flush()
+`
+
+type pyChild struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  io.WriteCloser
+	out *bufio.Reader
+}
+
+var (
+	oracleOnce sync.Once
+	oracleInst *pyChild
+	oracleErr  error
+)
+
+func oracle(t testing.TB) *pyChild {
+	oracleOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			oracleErr = err
+			return
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			oracleErr = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			oracleErr = err
+			return
+		}
+		oracleInst = &pyChild{cmd: cmd, in: in, out: bufio.NewReaderSize(out, 1<<20)}
+	})
+	if oracleErr != nil {
+		t.Fatalf("lxml oracle: %v", oracleErr)
+	}
+	return oracleInst
+}
+
+func (p *pyChild) ask(t testing.TB, req map[string]any, rep any) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		t.Fatalf("oracle marshal: %v", err)
+	}
+	if _, err := p.in.Write(append(b, '\n')); err != nil {
+		t.Fatalf("oracle write: %v", err)
+	}
+	line, err := p.out.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("oracle read: %v", err)
+	}
+	if err := json.Unmarshal(line, rep); err != nil {
+		t.Fatalf("oracle reply %q: %v", line, err)
+	}
+}
+
+// lxmlNode is lxml's view of a node.
+type lxmlNode struct {
+	K      string     `json:"k"`
+	Tag    string     `json:"tag"`
+	Prefix string     `json:"prefix"`
+	Attrs  [][]string `json:"attrs"`
+	Kids   []lxmlNode `json:"kids"`
+	D      string     `json:"d"`
+	Target string     `json:"target"`
+}
+
+type lxmlDoc struct {
+	Doctype string     `json:"doctype"`
+	Kids    []lxmlNode `json:"kids"`
+	Error   string     `json:"error"`
+}
+
+func lxmlParse(t testing.TB, xml string) (*lxmlDoc, error) {
+	var rep lxmlDoc
+	oracle(t).ask(t, map[string]any{"cmd": "P", "xml": xml}, &rep)
+	if rep.Error != "" {
+		return nil, fmt.Errorf("%s", rep.Error)
+	}
+	return &rep, nil
+}
+
+func lxmlXPath(t testing.TB, xml, expr string, ns map[string]string, ctx int) ([]int, error) {
+	var rep struct {
+		IDs   []int  `json:"ids"`
+		Error string `json:"error"`
+	}
+	oracle(t).ask(t, map[string]any{"cmd": "X", "xml": xml, "expr": expr, "ns": ns, "ctx": ctx}, &rep)
+	if rep.Error != "" {
+		return nil, fmt.Errorf("%s", rep.Error)
+	}
+	return rep.IDs, nil
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..1f0e1d4
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,207 @@
+package etree_test
+
+// Pins: one plain test per recorded bug (bugs.toml). Each asserts the documented behaviour and
+// fails while the bug exists; the target lists them as expected failures.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/beevik/etree"
+)
+
+func noPanic(t *testing.T, what string, f func()) {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("%s panics: %v", what, r)
+		}
+	}()
+	f()
+}
+
+// etree/1: Remove() on a token without a parent panics; the documentation says it returns false.
+func TestHegelPinRemoveWithoutParentReturnsFalse(t *testing.T) {
+	noPanic(t, "NewElement(\"a\").Remove()", func() {
+		if etree.NewElement("a").Remove() {
+			t.Fatalf("Remove() of an unparented element returned true")
+		}
+	})
+	noPanic(t, "NewText(\"a\").Remove()", func() {
+		if etree.NewText("a").Remove() {
+			t.Fatalf("Remove() of an unparented text returned true")
+		}
+	})
+	noPanic(t, "NewComment(\"a\").Remove()", func() {
+		if etree.NewComment("a").Remove() {
+			t.Fatalf("Remove() of an unparented comment returned true")
+		}
+	})
+}
+
+// etree/2: RemoveChildAt and InsertChildAt with a negative index panic (RemoveChildAt documents
+// that an out-of-bounds index removes nothing and returns nil).
+func TestHegelPinNegativeIndexIsOutOfBounds(t *testing.T) {
+	e := etree.NewElement("a")
+	e.CreateElement("b")
+	noPanic(t, "RemoveChildAt(-1)", func() {
+		if r := e.RemoveChildAt(-1); r != nil {
+			t.Fatalf("RemoveChildAt(-1) returned %v", r)
+		}
+	})
+	noPanic(t, "InsertChildAt(-1, ...)", func() {
+		e.InsertChildAt(-1, etree.NewElement("c"))
+	})
+	if len(e.Child) != 2 {
+		t.Fatalf("after RemoveChildAt(-1) and InsertChildAt(-1): %d children", len(e.Child))
+	}
+}
+
+// etree/3: Copy() of a child element keeps the original's index although it has no parent.
+func TestHegelPinCopyHasNoIndex(t *testing.T) {
+	e := etree.NewElement("a")
+	e.CreateElement("b")
+	c := e.CreateElement("c")
+	cp := c.Copy()
+	if cp.Parent() != nil {
+		t.Fatalf("Copy() has a parent")
+	}
+	if cp.Index() != -1 {
+		t.Fatalf("Copy() of the child at index 1 has Index() %d without a parent, want -1", cp.Index())
+	}
+}
+
+// etree/4: a whitespace-only text created with NewText/CreateText/SetText is not IsWhitespace,
+// while the same text set with SetData or parsed is; Indent keeps the one and strips the other.
+func TestHegelPinWhitespaceTextIsWhitespace(t *testing.T) {
+	if !etree.NewText("  ").IsWhitespace() {
+		t.Errorf("NewText(\"  \").IsWhitespace() = false")
+	}
+	e := etree.NewElement("e")
+	if !e.CreateText("\n\t").IsWhitespace() {
+		t.Errorf("CreateText(\"\\n\\t\").IsWhitespace() = false")
+	}
+	x := etree.NewText("x")
+	x.SetData("  ")
+	if !x.IsWhitespace() {
+		t.Errorf("SetData(\"  \") then IsWhitespace() = false")
+	}
+	d := etree.NewDocument()
+	r := d.CreateElement("r")
+	r.CreateElement("a").CreateText("  ")
+	d.Indent(2)
+	created, _ := d.WriteToString()
+	d2 := etree.NewDocument()
+	d2.ReadFromString("<r><a>  </a></r>")
+	d2.Indent(2)
+	parsed, _ := d2.WriteToString()
+	if created != parsed {
+		t.Errorf("Indent of the same tree built (%q) and parsed (%q) differs", created, parsed)
+	}
+}
+
+// etree/5: Text() skips comments among the leading character data, SetText replaces only the
+// character data before the first comment.
+func TestHegelPinSetTextThenText(t *testing.T) {
+	e := etree.NewElement("e")
+	e.CreateText("a")
+	e.CreateComment("c")
+	e.CreateText("b")
+	if got := e.Text(); got != "ab" {
+		t.Fatalf("Text() = %q, want \"ab\" (comments are ignored)", got)
+	}
+	e.SetText("new")
+	if got := e.Text(); got != "new" {
+		t.Fatalf("SetText(\"new\") then Text() = %q", got)
+	}
+}
+
+// etree/6: [tag] keeps a candidate once per matching child, so a following [n] counts
+// duplicates: a[b][2] returns the first a when it has two b children.
+func TestHegelPinChildFilterKeepsEachCandidateOnce(t *testing.T) {
+	d := etree.NewDocument()
+	if err := d.ReadFromString(`<r><a id="1"><b/><b/></a><a id="2"><b/></a></r>`); err != nil {
+		t.Fatal(err)
+	}
+	got := d.Root().FindElements("./a[b][2]")
+	if len(got) != 1 || got[0].SelectAttrValue("id", "") != "2" {
+		var ids []string
+		for _, e := range got {
+			ids = append(ids, e.SelectAttrValue("id", "?"))
+		}
+		t.Fatalf("./a[b][2] selected ids %v, want [2]", ids)
+	}
+}
+
+// etree/7: [0] selects the first element although indices start from 1.
+func TestHegelPinZeroIndexSelectsNothing(t *testing.T) {
+	d := etree.NewDocument()
+	if err := d.ReadFromString(`<r><a>1</a><a>2</a></r>`); err != nil {
+		t.Fatal(err)
+	}
+	if got := d.Root().FindElements("./a[0]"); len(got) != 0 {
+		t.Fatalf("./a[0] selected %d elements (text %q), want none", len(got), got[0].Text())
+	}
+}
+
+// etree/8: a quoted filter value containing '[' does not compile.
+func TestHegelPinBracketInQuotedValueCompiles(t *testing.T) {
+	d := etree.NewDocument()
+	if err := d.ReadFromString(`<r><a x="["/><a x="]"/></r>`); err != nil {
+		t.Fatal(err)
+	}
+	p, err := etree.CompilePath(`./a[@x='[']`)
+	if err != nil {
+		t.Fatalf("CompilePath(\"./a[@x='[']\"): %v", err)
+	}
+	if got := d.Root().FindElementsPath(p); len(got) != 1 || got[0].SelectAttrValue("x", "") != "[" {
+		t.Fatalf("./a[@x='['] selected %d elements", len(got))
+	}
+}
+
+// etree/9: with the default WriteSettings a carriage return in text or an attribute value is
+// written raw and normalised away when the document is read back.
+func TestHegelPinCarriageReturnSurvivesARoundTrip(t *testing.T) {
+	d := etree.NewDocument()
+	r := d.CreateElement("r")
+	r.CreateAttr("a", "x\ry")
+	r.CreateText("a\rb")
+	s, _ := d.WriteToString()
+	d2 := etree.NewDocument()
+	if err := d2.ReadFromString(s); err != nil {
+		t.Fatal(err)
+	}
+	if got := d2.Root().Text(); got != "a\rb" {
+		t.Errorf("text %q written as %q reads back as %q", "a\rb", s, got)
+	}
+	if got := d2.Root().SelectAttrValue("a", ""); got != "x\ry" {
+		t.Errorf("attribute %q written as %q reads back as %q", "x\ry", s, got)
+	}
+}
+
+// etree/10: SelectAttr with an unprefixed key returns a prefixed attribute of that key that
+// precedes the unprefixed one.
+func TestHegelPinCreateAttrThenSelectAttr(t *testing.T) {
+	e := etree.NewElement("e")
+	e.CreateAttr("p:x", "1")
+	e.CreateAttr("x", "2")
+	if got := e.SelectAttrValue("x", ""); got != "2" {
+		t.Fatalf("CreateAttr(\"x\", \"2\") then SelectAttrValue(\"x\") = %q (attributes p:x=1 x=2)", got)
+	}
+}
+
+// etree/11: CDATA contents are not sanitised of forbidden characters, so the output cannot be
+// read back (text and attribute values get U+FFFD).
+func TestHegelPinCDataIsSanitised(t *testing.T) {
+	d := etree.NewDocument()
+	d.CreateElement("r").CreateCData("a\x01b")
+	s, _ := d.WriteToString()
+	d2 := etree.NewDocument()
+	d2.ReadSettings.PreserveCData = true
+	if err := d2.ReadFromString(s); err != nil {
+		t.Fatalf("etree cannot read its own output %q: %v", s, err)
+	}
+	if got := d2.Root().Text(); strings.ContainsRune(got, 1) {
+		t.Fatalf("the forbidden character survived: %q", got)
+	}
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..e3c4c4b
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,829 @@
+package etree_test
+
+// One narrow property per recorded bug (bugs.toml): each draws the bug's shape region with
+// random contents and judges it by the model of hegel_test.go and hegel_api_test.go; under
+// HEGEL_NO_KNOWN=1 each draws the neighbouring region instead and passes.
+
+import (
+	"fmt"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/beevik/etree"
+)
+
+var smallTrees = docsOf(treeOpts{attrWS: true, docTokens: true, wsText: true, maxDepth: 3, maxKids: 3})
+
+// --------------------------------------------------------------------------- etree/1
+
+// detachCase: a tree and a way to come by a token without a parent (or, under
+// HEGEL_NO_KNOWN=1, a token of the tree).
+type detachCase struct {
+	tree *tok
+	way  string
+	spec freshSpec
+	tok  int
+}
+
+func (c detachCase) GoString() string {
+	return fmt.Sprintf("%s token %d (fresh %+v) of %s", c.way, c.tok, c.spec, c.tree.GoString())
+}
+
+var (
+	detachWays  = shaped(pick("fresh", "removeAt", "removeChild", "remove", "copy", "setRoot"), pick("attached"))
+	detachCases = hegel.Composite(func(tc hegel.TestCase) detachCase {
+		return detachCase{tree: hegel.Draw(tc, smallTrees), way: hegel.Draw(tc, detachWays), spec: hegel.Draw(tc, freshSpecs), tok: hegel.Draw(tc, tokPicks)}
+	})
+)
+
+// TestHegelRemoveOnDetachedTokenReturnsFalse: Remove() on a token without a parent, made
+// fresh or detached by RemoveChildAt, RemoveChild, Remove, Copy or SetRoot, returns false and
+// changes nothing (etree/1 dereferences nil). Under HEGEL_NO_KNOWN=1: Remove() on a token of
+// the tree removes it.
+func TestHegelRemoveOnDetachedTokenReturnsFalse(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, detachCases)
+		s := &mutation{col: col, ht: ht, m: c.tree, d: build(c.tree)}
+		s.repair()
+		m, d := s.m, s.d
+		all := m.all()[1:]
+		tk := all[at(c.tok, len(all))]
+		et := s.pr.toE[tk]
+		var det etree.Token
+		switch c.way {
+		case "attached":
+			if !et.Remove() {
+				col.fail(ht, "Remove() of a %s with a parent returned false", kindNames[tk.kind])
+				return
+			}
+			tk.detach()
+			if et.Parent() != nil || et.Index() != -1 {
+				col.fail(ht, "removed token has parent %v index %d", et.Parent(), et.Index())
+				return
+			}
+			if dd := diff(m, fromEtree(d), false, false, "doc"); dd != "" {
+				col.fail(ht, "after Remove() the tree differs from the model: %s", dd)
+			}
+			return
+		case "fresh":
+			tk = s.newTok(c.spec)
+			det = s.poolE[tk]
+		case "removeAt":
+			det = s.pr.toE[tk.parent].(*etree.Element).RemoveChildAt(tk.index())
+			tk.detach()
+		case "removeChild":
+			det = s.pr.toE[tk.parent].(*etree.Element).RemoveChild(et)
+			tk.detach()
+		case "remove":
+			et.Remove()
+			det = et
+			tk.detach()
+		case "copy":
+			if tk.kind != kElem {
+				tk = m.elements()[0]
+				et = s.pr.toE[tk]
+			}
+			det = et.(*etree.Element).Copy()
+			tk = tk.clone()
+		case "setRoot":
+			root := m.elements()[0]
+			det = s.pr.toE[root]
+			d.SetRoot(etree.NewElement("n"))
+			i := root.index()
+			root.detach()
+			m.insertAt(i, elem("", "n"))
+			tk = root
+		}
+		if det == nil {
+			col.fail(ht, "%s did not return the token", c.way)
+			return
+		}
+		if det.Parent() != nil {
+			col.fail(ht, "the %s token has a parent", c.way)
+			return
+		}
+		var r bool
+		if p := catching(func() { r = det.Remove() }); p != nil {
+			col.mismatch(ht, []string{"etree/1"}, "Remove() of a %s without a parent (%s) panics: %v", kindNames[tk.kind], c.way, p)
+			return
+		}
+		if r {
+			col.fail(ht, "Remove() of a %s without a parent (%s) returned true", kindNames[tk.kind], c.way)
+			return
+		}
+		if det.Parent() != nil || det.Index() != -1 {
+			col.fail(ht, "a detached token has parent %v index %d after Remove()", det.Parent(), det.Index())
+			return
+		}
+		if dd := diff(m, fromEtree(d), false, false, "doc"); dd != "" {
+			col.fail(ht, "Remove() of a detached token changed the tree: %s", dd)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- etree/2
+
+type indexCase struct {
+	tree   *tok
+	target int
+	index  int
+	insert bool
+	spec   freshSpec
+}
+
+func (c indexCase) GoString() string {
+	op := "RemoveChildAt"
+	if c.insert {
+		op = "InsertChildAt"
+	}
+	return fmt.Sprintf("%s(%d) on element %d (fresh %+v) of %s", op, c.index, c.target, c.spec, c.tree.GoString())
+}
+
+var (
+	// negative indices by default; any position up to the child count under HEGEL_NO_KNOWN=1
+	indexDraws = shaped(hegel.Integers(-4, -1), hegel.Integers(0, 63))
+	indexCases = hegel.Composite(func(tc hegel.TestCase) indexCase {
+		return indexCase{tree: hegel.Draw(tc, smallTrees), target: hegel.Draw(tc, elemPicks), index: hegel.Draw(tc, indexDraws),
+			insert: hegel.Draw(tc, hegel.Booleans()), spec: hegel.Draw(tc, freshSpecs)}
+	})
+)
+
+// TestHegelNegativeIndicesAreOutOfBounds: RemoveChildAt with a negative index returns nil and
+// changes nothing, InsertChildAt with one inserts the token (etree/2 panics on both). Under
+// HEGEL_NO_KNOWN=1: indices up to the child count remove or insert at the position.
+func TestHegelNegativeIndicesAreOutOfBounds(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, indexCases)
+		s := &mutation{col: col, ht: ht, m: c.tree, d: build(c.tree)}
+		s.repair()
+		m, d := s.m, s.d
+		target := s.anyElem(c.target)
+		te := s.pr.toE[target].(*etree.Element)
+		i := c.index
+		if i >= 0 {
+			i = at(i, len(target.kids)+1)
+		}
+		if !c.insert {
+			var got etree.Token
+			if p := catching(func() { got = te.RemoveChildAt(i) }); p != nil {
+				col.mismatch(ht, []string{"etree/2"}, "RemoveChildAt(%d) of %d children panics: %v", i, len(target.kids), p)
+				return
+			}
+			if i < 0 || i >= len(target.kids) {
+				if got != nil {
+					col.fail(ht, "RemoveChildAt(%d) of %d children returned a token", i, len(target.kids))
+					return
+				}
+			} else {
+				if got != s.pr.toE[target.kids[i]] {
+					col.fail(ht, "RemoveChildAt(%d) returned another token", i)
+					return
+				}
+				target.kids[i].detach()
+			}
+			if dd := diff(m, fromEtree(d), false, false, "doc"); dd != "" {
+				col.fail(ht, "after RemoveChildAt(%d) the tree differs from the model: %s", i, dd)
+			}
+			return
+		}
+		tk := s.newTok(c.spec)
+		et := s.poolE[tk]
+		if p := catching(func() { te.InsertChildAt(i, et) }); p != nil {
+			col.mismatch(ht, []string{"etree/2"}, "InsertChildAt(%d) of %d children panics: %v", i, len(target.kids), p)
+			return
+		}
+		if et.Parent() != te {
+			col.fail(ht, "InsertChildAt(%d) did not insert the token", i)
+			return
+		}
+		if i < 0 {
+			// Not documented beyond "out of bounds": the model takes the position etree chose.
+			i = et.Index()
+		}
+		target.insertAt(i, tk)
+		if dd := diff(m, fromEtree(d), false, false, "doc"); dd != "" {
+			col.fail(ht, "after InsertChildAt(%d) the tree differs from the model: %s", i, dd)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- etree/3
+
+type copyCase struct {
+	tree   *tok
+	target int
+}
+
+func (c copyCase) GoString() string { return fmt.Sprintf("copy of element %d of %s", c.target, c.tree.GoString()) }
+
+var copyCases = hegel.Composite(func(tc hegel.TestCase) copyCase {
+	return copyCase{tree: hegel.Draw(tc, smallTrees), target: hegel.Draw(tc, elemPicks)}
+})
+
+// TestHegelCopyOfChildHasNoIndex: Copy() of an element of a tree is a deep copy without a
+// parent and so with Index() -1 (etree/3 keeps the original's index). Under HEGEL_NO_KNOWN=1
+// the element copied is detached.
+func TestHegelCopyOfChildHasNoIndex(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, copyCases)
+		m := c.tree
+		els := m.elements()
+		orig := els[at(c.target, len(els))]
+		var te *etree.Element
+		if Known.copyKeepsIndex {
+			te = etree.NewElement(orig.fullTag())
+			for _, a := range orig.attrs {
+				te.CreateAttr(a.fullKey(), a.val)
+			}
+			buildKids(te, orig)
+		} else {
+			d := build(m)
+			s := &mutation{m: m, d: d}
+			s.repair()
+			te = s.pr.toE[orig].(*etree.Element)
+		}
+		cp := te.Copy()
+		if cp.Parent() != nil {
+			col.fail(ht, "Copy() has a parent")
+			return
+		}
+		index := cp.Index()
+		want := elem("", "")
+		want.add(orig.clone())
+		if dd := diff(norm(want, true), norm(fromEtree(etree.NewDocumentWithRoot(cp)), true), false, false, "copy"); dd != "" {
+			col.fail(ht, "Copy differs from the original: %s", dd)
+			return
+		}
+		if index != -1 {
+			col.mismatch(ht, []string{"etree/3"}, "Copy() of the element at index %d has Index() %d without a parent", te.Index(), index)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- etree/4
+
+type wsCase struct {
+	tree   *tok
+	target int
+	ws     string
+	opts   indentOpts
+}
+
+func (c wsCase) GoString() string {
+	return fmt.Sprintf("text %q on element %d, indent %+v, of %s", c.ws, c.target, c.opts, c.tree.GoString())
+}
+
+var (
+	whitespaces = joined(many(pick(" ", "\t", "\n"), 1, 4), "")
+	wsCases     = hegel.Composite(func(tc hegel.TestCase) wsCase {
+		return wsCase{tree: hegel.Draw(tc, smallTrees), target: hegel.Draw(tc, elemPicks), ws: hegel.Draw(tc, whitespaces), opts: hegel.Draw(tc, indentSettings)}
+	})
+)
+
+// TestHegelWhitespaceTextThroughTheAPIIsWhitespace: a whitespace-only text created with
+// CreateText is IsWhitespace and Indent treats it as indentation, as it does the same text
+// parsed (etree/4 flags only parsed whitespace). Under HEGEL_NO_KNOWN=1 the text is parsed.
+func TestHegelWhitespaceTextThroughTheAPIIsWhitespace(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, wsCases)
+		m := c.tree
+		els := m.elements()
+		target := els[at(c.target, len(els))]
+		target.add(&tok{kind: kText, data: c.ws})
+		var d *etree.Document
+		var want *tok
+		if Known.whitespaceFlagByOrigin {
+			src, _ := build(m).WriteToString()
+			d = etree.NewDocument()
+			d.ReadSettings.PreserveCData = true
+			if err := d.ReadFromString(src); err != nil {
+				col.fail(ht, "ReadFromString: %v", err)
+				return
+			}
+			want = whitespaceByModel(norm(expected(m), true))
+		} else {
+			d = build(m)
+			want = whitespaceByModel(m.clone())
+		}
+		for _, k := range fromEtree(d).all() {
+			if k.kind == kText && isWS(k.data) && k.created {
+				col.mismatch(ht, []string{"etree/4"}, "the whitespace-only text %q is not IsWhitespace", k.data)
+				return
+			}
+		}
+		d.IndentWithSettings(c.opts.settings())
+		modelIndent(want, 0, c.opts)
+		if c.opts.suppressTrailingWhitespace {
+			for len(want.kids) > 0 && want.kids[len(want.kids)-1].isChar() && isWS(want.kids[len(want.kids)-1].data) {
+				want.kids = want.kids[:len(want.kids)-1]
+			}
+		}
+		if dd := diff(norm(want, true), norm(fromEtree(d), true), false, false, "doc"); dd != "" {
+			out, _ := d.WriteToString()
+			col.mismatch(ht, []string{"etree/4"}, "indent %+v differs from the model: %s\nindented %q", c.opts, dd, out)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- etree/5
+
+type setTextCase struct {
+	tree    *tok
+	target  int
+	before  []string
+	comment string
+	after   []string
+	text    string
+}
+
+func (c setTextCase) GoString() string {
+	return fmt.Sprintf("SetText(%q) on element %d with leading %q, comment %q, %q, of %s", c.text, c.target, c.before, c.comment, c.after, c.tree.GoString())
+}
+
+var (
+	// leadingComments: a comment among the leading character data by default, none under
+	// HEGEL_NO_KNOWN=1 (the generator leaves it out and the texts around it stay)
+	leadingComments = shaped(textsOf(plainPieces, 3), hegel.Just(""))
+	setTextCases    = hegel.Composite(func(tc hegel.TestCase) setTextCase {
+		return setTextCase{tree: hegel.Draw(tc, smallTrees), target: hegel.Draw(tc, elemPicks), before: hegel.Draw(tc, many(shortTexts, 0, 2)),
+			comment: hegel.Draw(tc, leadingComments), after: hegel.Draw(tc, many(shortTexts, 1, 2)), text: hegel.Draw(tc, shortTexts)}
+	})
+)
+
+// TestHegelSetTextThenTextWithLeadingComment: after SetText(s) on an element whose leading
+// character data has a comment among it, Text() is s and the children after the leading
+// character data are untouched (etree/5 replaces only the data before the comment while Text
+// reads past it). Under HEGEL_NO_KNOWN=1 there is no comment among the leading data.
+func TestHegelSetTextThenTextWithLeadingComment(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, setTextCases)
+		m := c.tree
+		els := append([]*tok{m}, m.elements()...)
+		target := els[at(c.target, len(els))]
+		var lead []*tok
+		for _, s := range c.before {
+			lead = append(lead, &tok{kind: kText, data: s})
+		}
+		if !Known.setTextIgnoresComments {
+			lead = append(lead, &tok{kind: kComment, data: c.comment})
+		}
+		for _, s := range c.after {
+			lead = append(lead, &tok{kind: kText, data: s})
+		}
+		rest := target.kids
+		target.kids = nil
+		for _, k := range lead {
+			target.add(k)
+		}
+		for _, k := range rest {
+			target.add(k)
+		}
+		d := build(m)
+		s := &mutation{m: m, d: d}
+		s.repair()
+		te := s.pr.toE[target].(*etree.Element)
+		te.SetText(c.text)
+		if got := te.Text(); got != c.text {
+			col.mismatch(ht, []string{"etree/5"}, "SetText(%q) then Text() = %q (children %s)", c.text, got, describe(target))
+			return
+		}
+		// The children after the leading run (character data and comments) are untouched.
+		for len(rest) > 0 && (rest[0].isChar() || rest[0].kind == kComment) {
+			rest = rest[1:]
+		}
+		got := elem("", "")
+		fromEtreeKids(got, te)
+		if !sameTail(got, rest) {
+			col.fail(ht, "after SetText(%q) the children after the leading data changed: %s", c.text, describe(got))
+		}
+	})
+}
+
+// sameTail says whether the last len(rest) children of e equal rest.
+func sameTail(e *tok, rest []*tok) bool {
+	off := len(e.kids) - len(rest)
+	if off < 0 {
+		return false
+	}
+	for i, r := range rest {
+		if diff(e.kids[off+i], r, false, false, "") != "" {
+			return false
+		}
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- etree/6
+
+// siblingsCase: a root with several children of two tags, some with children of the two tags,
+// and a path tag[child][n] on it (tag[n][child] under HEGEL_NO_KNOWN=1).
+type siblingsCase struct {
+	kids     [][]string // the children's tags, each with its children's tags
+	tag      string
+	childTag string
+	pos      int
+}
+
+func (c siblingsCase) GoString() string {
+	return fmt.Sprintf("path %q on root children %v", c.path().String(), c.kids)
+}
+
+func (c siblingsCase) tree() *tok {
+	doc := elem("", "")
+	root := doc.add(elem("", "r"))
+	for _, k := range c.kids {
+		e := root.add(elem("", k[0]))
+		for _, g := range k[1:] {
+			e.add(elem("", g))
+		}
+	}
+	return doc
+}
+
+func (c siblingsCase) path() ppath {
+	child := pfilter{kind: "child", key: c.childTag, quote: '\''}
+	pos := pfilter{kind: "pos", pos: c.pos}
+	filters := shaped([]pfilter{child, pos}, []pfilter{pos, child})
+	return ppath{segs: []pseg{{sel: "tag", tag: c.tag, filters: filters}}}
+}
+
+var (
+	twoTags       = pick("a", "b")
+	siblingsCases = hegel.Composite(func(tc hegel.TestCase) siblingsCase {
+		kids := hegel.Draw(tc, many(hegel.Composite(func(tc hegel.TestCase) []string {
+			return append([]string{hegel.Draw(tc, twoTags)}, hegel.Draw(tc, many(twoTags, 0, 3))...)
+		}), 2, 5))
+		return siblingsCase{kids: kids, tag: hegel.Draw(tc, twoTags), childTag: hegel.Draw(tc, twoTags), pos: hegel.Draw(tc, hegel.SampledFrom([]int{1, 2, 3, 4, -1, -2}))}
+	})
+)
+
+// TestHegelChildFilterThenPositionCountsCandidatesOnce: tag[child][n] selects the n-th element
+// among the children that have a child of that tag, each counted once however many such
+// children it has (etree/6 counts it once per matching child). Under HEGEL_NO_KNOWN=1 the
+// position comes first: tag[n][child].
+func TestHegelChildFilterThenPositionCountsCandidatesOnce(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, siblingsCases)
+		m := c.tree()
+		p := c.path()
+		checkPath(ht, col, m, p, m.elements()[0], []string{"etree/6"})
+	})
+}
+
+// checkPath compares FindElementsPath from an element with the model, naming shapes on a
+// mismatch.
+func checkPath(ht *hegel.T, col *collector, m *tok, p ppath, start *tok, shapes []string) {
+	ps := p.String()
+	cp, err := etree.CompilePath(ps)
+	if err != nil {
+		col.mismatch(ht, shapes, "CompilePath(%q): %v", ps, err)
+		return
+	}
+	d := build(m)
+	s := &mutation{m: m, d: d}
+	s.repair()
+	me := m.elements()
+	mIndex := map[*tok]int{m: -1}
+	eIndex := map[*etree.Element]int{&d.Element: -1}
+	for i, e := range me {
+		mIndex[e] = i
+		eIndex[s.pr.toE[e].(*etree.Element)] = i
+	}
+	estart := &d.Element
+	if start != m {
+		estart = s.pr.toE[start].(*etree.Element)
+	}
+	wantIDs := idsOf(evalPath(start, p), mIndex)
+	gotIDs := idsOf(estart.FindElementsPath(cp), eIndex)
+	if !sameInts(wantIDs, gotIDs) {
+		out, _ := d.WriteToString()
+		col.mismatch(ht, shapes, "FindElements(%q) = %v, model %v\n%s", ps, gotIDs, wantIDs, out)
+	}
+}
+
+// --------------------------------------------------------------------------- etree/7
+
+type zeroCase struct {
+	tree *tok
+	seg  pseg
+	ctx  int
+}
+
+func (c zeroCase) GoString() string {
+	return fmt.Sprintf("segment %q from %d of %s", c.seg.String(), c.ctx, c.tree.GoString())
+}
+
+var (
+	// zeroPositions: [0] by default, [1] under HEGEL_NO_KNOWN=1
+	zeroPositions = hegel.Just(pfilter{kind: "pos", pos: shaped(0, 1)})
+	zeroCases     = hegel.Composite(func(tc hegel.TestCase) zeroCase {
+		seg := hegel.Draw(tc, segments)
+		if seg.sel == "desc" {
+			seg.sel = "tag"
+		}
+		seg.filters = append(seg.filters, hegel.Draw(tc, zeroPositions))
+		return zeroCase{tree: hegel.Draw(tc, pathTrees), seg: seg, ctx: hegel.Draw(tc, hegel.Integers(-1, 63))}
+	})
+)
+
+// TestHegelZeroPositionSelectsNothing: a [0] filter after any selector and filters selects
+// nothing, positions counting from 1 (etree/7 selects the first). Under HEGEL_NO_KNOWN=1 the
+// filter is [1].
+func TestHegelZeroPositionSelectsNothing(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, zeroCases)
+		m := c.tree
+		p := resolved(ppath{segs: []pseg{c.seg}}, m)
+		start := m
+		if c.ctx >= 0 {
+			me := m.elements()
+			start = me[at(c.ctx, len(me))]
+		}
+		checkPath(ht, col, m, p, start, []string{"etree/7"})
+	})
+}
+
+// --------------------------------------------------------------------------- etree/8
+
+type bracketCase struct {
+	tree  *tok
+	seg   pseg
+	kind  string
+	quote byte
+	value string
+	ctx   int
+}
+
+func (c bracketCase) GoString() string {
+	return fmt.Sprintf("%s filter %c%s%c on segment %q from %d of %s", c.kind, c.quote, c.value, c.quote, c.seg.String(), c.ctx, c.tree.GoString())
+}
+
+var (
+	valuePieces = pick("a", "b", "]", "=", "/", " ", "x")
+	// bracketValues: a '[' somewhere in the value by default, none under HEGEL_NO_KNOWN=1
+	bracketValues = hegel.Composite(func(tc hegel.TestCase) string {
+		return hegel.Draw(tc, textsOf(valuePieces, 3)) + shaped("[", "") + hegel.Draw(tc, textsOf(valuePieces, 3))
+	})
+	bracketCases = hegel.Composite(func(tc hegel.TestCase) bracketCase {
+		seg := hegel.Draw(tc, segments)
+		if seg.sel == "desc" {
+			seg.sel = "tag"
+		}
+		seg.filters = nil
+		return bracketCase{tree: hegel.Draw(tc, pathTrees), seg: seg, kind: hegel.Draw(tc, pick("attrval", "childval", "fnval")),
+			quote: hegel.Draw(tc, quotes), value: hegel.Draw(tc, bracketValues), ctx: hegel.Draw(tc, hegel.Integers(-1, 63))}
+	})
+)
+
+// TestHegelQuotedValuesWithBracketsCompile: a quoted filter value with a '[' in it compiles and
+// filters by the value (etree/8 splits the path at the bracket). Under HEGEL_NO_KNOWN=1 the
+// values have no '['.
+func TestHegelQuotedValuesWithBracketsCompile(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, bracketCases)
+		m := c.tree
+		f := pfilter{kind: c.kind, quote: c.quote, val: c.value}
+		switch c.kind {
+		case "attrval":
+			f.key = attrKeys[0]
+		case "childval":
+			f.key = tagNames[0]
+		default:
+			f.fn = "text"
+		}
+		seg := c.seg
+		seg.filters = []pfilter{f}
+		p := ppath{segs: []pseg{seg}}
+		start := m
+		if c.ctx >= 0 {
+			me := m.elements()
+			start = me[at(c.ctx, len(me))]
+		}
+		checkPath(ht, col, m, p, start, []string{"etree/8"})
+	})
+}
+
+// --------------------------------------------------------------------------- etree/9
+
+type rawWSCase struct {
+	tree   *tok
+	target int
+	where  string // text attr attrTabNL
+	ws     string
+	before string
+	after  string
+	key    string
+	escape bool // write with the settings that escape the whitespace (HEGEL_NO_KNOWN=1)
+}
+
+func (c rawWSCase) GoString() string {
+	return fmt.Sprintf("%s %q on element %d (escaped %v) of %s", c.where, c.before+c.ws+c.after, c.target, c.escape, c.tree.GoString())
+}
+
+var (
+	rawWSTrees = docsOf(treeOpts{invalid: true, redeclare: true, docTokens: true, wsText: true, maxDepth: 3, maxKids: 3})
+	rawWSCases = hegel.FlatMap(pick("text", "attr", "attrTabNL"), func(where string) hegel.Generator[rawWSCase] {
+		ws := pick("\r", "\r\n")
+		if where == "attrTabNL" {
+			ws = pick("\t", "\n")
+		}
+		// Under HEGEL_NO_KNOWN=1: the canonical settings escape the whitespace, or there is none.
+		escape := shaped(hegel.Just(false), hegel.Booleans())
+		return hegel.Composite(func(tc hegel.TestCase) rawWSCase {
+			c := rawWSCase{tree: hegel.Draw(tc, rawWSTrees), target: hegel.Draw(tc, elemPicks), where: where, ws: hegel.Draw(tc, ws),
+				before: hegel.Draw(tc, textsOf(plainAttrPieces, 3)), after: hegel.Draw(tc, textsOf(plainAttrPieces, 3)), key: hegel.Draw(tc, keys),
+				escape: hegel.Draw(tc, escape)}
+			if Known.rawWhitespace && !c.escape {
+				c.ws = " "
+			}
+			return c
+		})
+	})
+)
+
+// TestHegelRawWhitespaceSurvivesDefaultEscaping: with the default WriteSettings a carriage
+// return in text or an attribute value survives etree's own round trip, and a tab or newline in
+// an attribute value survives a conforming parser's (lxml), as the writer is to escape them
+// (etree/9 writes them raw). Under HEGEL_NO_KNOWN=1 the canonical settings are used, or the
+// whitespace is a space.
+func TestHegelRawWhitespaceSurvivesDefaultEscaping(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, rawWSCases)
+		m := c.tree
+		els := m.elements()
+		target := els[at(c.target, len(els))]
+		val := c.before + c.ws + c.after
+		if c.where == "text" {
+			target.add(&tok{kind: kText, data: val})
+		} else {
+			setAttr(target, attr{key: c.key, val: val})
+		}
+		m.resolve()
+		d := build(m)
+		if c.escape {
+			d.WriteSettings.CanonicalText = true
+			d.WriteSettings.CanonicalAttrVal = true
+		}
+		out, err := d.WriteToString()
+		if err != nil {
+			col.fail(ht, "WriteToString: %v", err)
+			return
+		}
+		shapes := rawWhitespaceShapes(m, d.WriteSettings, true)
+		if c.where == "attrTabNL" {
+			ld, err := lxmlParse(t, out)
+			if err != nil {
+				col.fail(ht, "lxml rejects etree's output: %v\n%s", err, out)
+				return
+			}
+			if dd := viewDiff(docViewOfModel(m), lxmlDocView(ld), "doc"); dd != "" {
+				col.mismatch(ht, shapes, "lxml's tree differs from the model: %s\n%s", dd, out)
+			}
+			return
+		}
+		d2 := etree.NewDocument()
+		d2.ReadSettings.PreserveCData = true
+		if err := d2.ReadFromString(out); err != nil {
+			col.fail(ht, "ReadFromString of etree's own output: %v\n%s", err, out)
+			return
+		}
+		if dd := diff(norm(expected(m), true), norm(fromEtree(d2), true), false, false, "doc"); dd != "" {
+			col.mismatch(ht, shapes, "read(write(tree)) differs: %s\n%s", dd, out)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- etree/10
+
+type shadowCase struct {
+	tag    string
+	attrs  []attr
+	space  string // the prefix of the attribute of the same key that comes first
+	key    string
+	first  string
+	second string
+}
+
+func (c shadowCase) GoString() string {
+	return fmt.Sprintf("<%s %v> then CreateAttr(%q, %q)", c.tag, c.attrs, c.key, c.second)
+}
+
+var (
+	// otherAttrs: attributes around the pair; unprefixed only under HEGEL_NO_KNOWN=1
+	otherAttrs = hegel.Composite(func(tc hegel.TestCase) attr {
+		return attr{space: hegel.Draw(tc, shaped(spaces, hegel.Just(""))), key: hegel.Draw(tc, keys), val: hegel.Draw(tc, shortTexts)}
+	})
+	shadowCases = hegel.Composite(func(tc hegel.TestCase) shadowCase {
+		return shadowCase{tag: hegel.Draw(tc, tags), attrs: hegel.Draw(tc, many(otherAttrs, 0, 3)), space: hegel.Draw(tc, shaped(pick("p", "q"), hegel.Just(""))),
+			key: hegel.Draw(tc, keys), first: hegel.Draw(tc, shortTexts), second: hegel.Draw(tc, shortTexts)}
+	})
+)
+
+// TestHegelCreateAttrBesidePrefixedAttrIsSelected: after CreateAttr(key, v) on an element that
+// has a prefixed attribute of the same key before it, SelectAttr(key) and SelectAttrValue(key)
+// return the unprefixed attribute (etree/10 returns the prefixed one). Under HEGEL_NO_KNOWN=1
+// every attribute is unprefixed.
+func TestHegelCreateAttrBesidePrefixedAttrIsSelected(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, shadowCases)
+		e := etree.NewElement(c.tag)
+		for _, a := range c.attrs {
+			e.CreateAttr(a.fullKey(), a.val)
+		}
+		firstKey := c.key
+		if c.space != "" {
+			firstKey = c.space + ":" + c.key
+		}
+		e.CreateAttr(firstKey, c.first)
+		e.CreateAttr(c.key, c.second)
+		var shapes []string
+		for _, a := range e.Attr {
+			if a.Key == c.key && a.Space != "" {
+				shapes = []string{"etree/10"}
+			}
+		}
+		if v := e.SelectAttrValue(c.key, "\x00"); v != c.second {
+			col.mismatch(ht, shapes, "CreateAttr(%q, %q) then SelectAttrValue(%q) = %q (attrs %v)", c.key, c.second, c.key, v, e.Attr)
+			return
+		}
+		if a := e.SelectAttr(c.key); a == nil || a.Space != "" || a.Value != c.second {
+			col.mismatch(ht, shapes, "CreateAttr(%q, %q) then SelectAttr(%q) = %+v (attrs %v)", c.key, c.second, c.key, a, e.Attr)
+		}
+	})
+}
+
+// --------------------------------------------------------------------------- etree/11
+
+type cdataCase struct {
+	tree   *tok
+	target int
+	before string
+	bad    string
+	after  string
+}
+
+func (c cdataCase) GoString() string {
+	return fmt.Sprintf("CDATA %q on element %d of %s", c.before+c.bad+c.after, c.target, c.tree.GoString())
+}
+
+var (
+	// forbidden: a forbidden character by default, a plain piece under HEGEL_NO_KNOWN=1
+	forbidden  = shaped(badPieces, plainPieces)
+	cdataCases = hegel.Composite(func(tc hegel.TestCase) cdataCase {
+		return cdataCase{tree: hegel.Draw(tc, smallTrees), target: hegel.Draw(tc, elemPicks), before: hegel.Draw(tc, textsOf(plainPieces, 3)),
+			bad: hegel.Draw(tc, forbidden), after: hegel.Draw(tc, textsOf(plainPieces, 3))}
+	})
+)
+
+// TestHegelCDataWithForbiddenCharactersReadsBack: a CDATA section with a character XML forbids
+// is written sanitised (U+FFFD, like text) and etree reads its output back (etree/11 writes it
+// raw and cannot read it). Under HEGEL_NO_KNOWN=1 the CDATA is clean.
+func TestHegelCDataWithForbiddenCharactersReadsBack(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cdataCases)
+		m := c.tree
+		els := m.elements()
+		target := els[at(c.target, len(els))]
+		target.add(&tok{kind: kCData, data: c.before + c.bad + c.after})
+		d := build(m)
+		out, err := d.WriteToString()
+		if err != nil {
+			col.fail(ht, "WriteToString: %v", err)
+			return
+		}
+		shapes := unsanitisedShapes(m, false)
+		d2 := etree.NewDocument()
+		d2.ReadSettings.PreserveCData = true
+		if err := d2.ReadFromString(out); err != nil {
+			col.mismatch(ht, shapes, "ReadFromString of etree's own output: %v\n%s", err, out)
+			return
+		}
+		if dd := diff(norm(expected(m), true), norm(fromEtree(d2), true), false, false, "doc"); dd != "" {
+			col.mismatch(ht, shapes, "read(write(tree)) differs: %s\n%s", dd, out)
+		}
+	})
+}
+
+// setAttr sets an attribute of the model element: the value of the one with the prefix and
+// key when there is one, else a new attribute at the end.
+func setAttr(e *tok, a attr) {
+	for i := range e.attrs {
+		if e.attrs[i].space == a.space && e.attrs[i].key == a.key {
+			e.attrs[i].val = a.val
+			return
+		}
+	}
+	e.attrs = append(e.attrs, a)
+}
