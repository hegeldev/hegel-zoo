+package etree_test
+
+// Hegel property tests for beevik/etree, written for the Hegel zoo.
+// See targets/go/etree/README.md.
+//
+// Oracles: a model tree (elements with prefixes, attributes and namespace declarations, text,
+// CDATA, comments, processing instructions, a DOCTYPE) that is built through the etree API and
+// written by the harness in varied XML syntax; the documented semantics of the token API
+// (Text/Tail, Insert/Remove, Copy, Indent/Unindent, attributes, namespace resolution) and of
+// etree paths, evaluated on the model; and lxml (Python) as an independent XML parser for what
+// etree writes and as an XPath engine on the subset of paths both read alike.
+//
+// Generators are package-level values built from the binding's combinators: a string is a list
+// of piece choices, a document is a tree of records drawn from a grammar built once per option
+// set (its kid lists memoised per depth) and turned into the model by a pure function with the
+// element budget applied afterwards, the harness's XML syntax is a tape of choices consumed by
+// a pure writer, and each property draws one case record.
+//
+// The shapes of the recorded bugs (bugs.toml) are drawn by default and a mismatch on one fails
+// naming the bug, so the wide properties that meet them are the expected failures beside the
+// pins; hegel_shapes_test.go has one narrow property per bug. HEGEL_NO_KNOWN=1 (noKnown, read
+// once into the Known switches) switches the shapes off: the generators leave them out and the
+// checks only a recorded bug can fail are skipped by name.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/beevik/etree"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// every Known switch is off, the generators draw the bugs' shapes at their natural rate and a
+// mismatch on one fails naming the bug; under HEGEL_NO_KNOWN=1 the switches are on and the
+// shapes are left out of the generators or skipped by name.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// collector counts the classes of every generated case and, in collect mode, records mismatches
+// instead of failing.
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// mismatch reports a failure on a case whose recorded shapes are named (none for a plain
+// failure): by default the failure names the bugs, under HEGEL_NO_KNOWN=1 a case with a shape is
+// counted and assumed away.
+func (c *collector) mismatch(ht *hegel.T, shapes []string, format string, args ...any) {
+	for _, s := range shapes {
+		c.count("shape " + s)
+	}
+	if len(shapes) > 0 {
+		if noKnown {
+			c.count("known-skipped")
+			ht.Assume(false)
+		}
+		format += " (the shape of " + strings.Join(shapes, ", ") + ")"
+	}
+	c.fail(ht, format, args...)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). A switch that is on keeps the bug's shape out of the
+// generators or skips the check only that bug can fail; every switch is off by default and on
+// under HEGEL_NO_KNOWN=1. The pins assert the correct behaviour and fail while the bug exists.
+var Known = struct {
+	// etree/1: Remove() on a token without a parent dereferences nil instead of returning false.
+	removeUnparentedPanics bool
+	// etree/2: RemoveChildAt and InsertChildAt with a negative index panic (RemoveChildAt
+	// documents "out of bounds ... nil is returned").
+	negativeIndexPanics bool
+	// etree/3: Copy() of a child token keeps the original's Index() although the copy has no
+	// parent (Index documents -1 then).
+	copyKeepsIndex bool
+	// etree/4: a whitespace-only CharData created with NewText/CreateText/SetText is not
+	// IsWhitespace, while the same text parsed or set with SetData is; Indent then keeps the one
+	// and strips the other.
+	whitespaceFlagByOrigin bool
+	// etree/5: Text() skips comments among the leading character data but SetText replaces only
+	// the character data before the first comment, so SetText(s); Text() != s.
+	setTextIgnoresComments bool
+	// etree/6: the [tag] and [tag='v'] filters keep a candidate once per matching child, so a
+	// following [n] filter counts duplicates (a[b][2] returns the first a when it has two b
+	// children).
+	childFilterDuplicates bool
+	// etree/7: the [0] filter selects the first element, like [1].
+	zeroIndexIsFirst bool
+	// etree/8: a quoted filter value containing '[' fails to compile.
+	bracketInQuotedValue bool
+	// etree/9: with the default WriteSettings a carriage return in text or an attribute value,
+	// and a tab or newline in an attribute value, are written raw and are normalised away by any
+	// XML parser (etree's own for the carriage return).
+	rawWhitespace bool
+	// etree/10: SelectAttr/SelectAttrValue with an unprefixed key return a prefixed attribute
+	// of that key that precedes the unprefixed one, so CreateAttr(k, v); SelectAttrValue(k) != v.
+	prefixedAttrShadows bool
+	// etree/11: CDATA (and comment and processing-instruction) contents are not sanitised of
+	// characters XML forbids, and the CDATA case makes the output unreadable by etree itself.
+	unsanitisedCData bool
+}{noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown, noKnown}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value otherwise, which is what it
+// shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pick is one of a small table of texts (the first is the shrink target).
+func pick(xs ...string) hegel.Generator[string] { return hegel.SampledFrom(xs) }
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// joined is the texts of a list generator joined with sep.
+func joined(g hegel.Generator[[]string], sep string) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, sep) })
+}
+
+// --------------------------------------------------------------------------- model
+
+type kind int
+
+const (
+	kElem kind = iota
+	kText
+	kCData
+	kComment
+	kPI
+	kDirective
+)
+
+var kindNames = []string{"element", "text", "cdata", "comment", "pi", "directive"}
+
+type attr struct {
+	space, key, val string
+	uri             string // resolved namespace URI (filled by resolve)
+}
+
+// tok is a model token; the document is an element with an empty tag whose children are the
+// document-level tokens, like etree's Document.Element.
+type tok struct {
+	kind       kind
+	space, tag string
+	attrs      []attr
+	kids       []*tok
+	data       string // text, cdata, comment, directive, pi instruction
+	target     string // pi target
+	parent     *tok
+	uri        string // resolved namespace URI (filled by resolve)
+	created    bool   // text created through the API, which etree does not flag as whitespace (etree/4)
+}
+
+func elem(space, tag string) *tok { return &tok{kind: kElem, space: space, tag: tag} }
+
+func (t *tok) add(c *tok) *tok {
+	c.parent = t
+	t.kids = append(t.kids, c)
+	return c
+}
+
+func (t *tok) clone() *tok {
+	c := *t
+	c.parent = nil
+	c.attrs = append([]attr(nil), t.attrs...)
+	c.kids = nil
+	for _, k := range t.kids {
+		c.add(k.clone())
+	}
+	return &c
+}
+
+func (t *tok) fullTag() string {
+	if t.space == "" {
+		return t.tag
+	}
+	return t.space + ":" + t.tag
+}
+
+func (a attr) fullKey() string {
+	if a.space == "" {
+		return a.key
+	}
+	return a.space + ":" + a.key
+}
+
+func (t *tok) isChar() bool { return t.kind == kText || t.kind == kCData }
+
+func (t *tok) isDoc() bool { return t.kind == kElem && t.tag == "" && t.parent == nil }
+
+// text models Element.Text: the character data after the opening tag, comments skipped.
+func (t *tok) text() string {
+	var b strings.Builder
+	for _, c := range t.kids {
+		switch {
+		case c.isChar():
+			b.WriteString(c.data)
+		case c.kind == kComment:
+		default:
+			return b.String()
+		}
+	}
+	return b.String()
+}
+
+// tail models Element.Tail: the character data after the end tag.
+func (t *tok) tail() string {
+	if t.parent == nil {
+		return ""
+	}
+	var b strings.Builder
+	for _, c := range t.parent.kids[t.index()+1:] {
+		if !c.isChar() {
+			break
+		}
+		b.WriteString(c.data)
+	}
+	return b.String()
+}
+
+func (t *tok) index() int {
+	if t.parent == nil {
+		return -1
+	}
+	for i, c := range t.parent.kids {
+		if c == t {
+			return i
+		}
+	}
+	return -1
+}
+
+func (t *tok) detach() {
+	if t.parent == nil {
+		return
+	}
+	p := t.parent
+	i := t.index()
+	p.kids = append(p.kids[:i], p.kids[i+1:]...)
+	t.parent = nil
+}
+
+func (t *tok) insertAt(i int, c *tok) {
+	c.detach()
+	if i >= len(t.kids) {
+		t.add(c)
+		return
+	}
+	c.parent = t
+	t.kids = append(t.kids, nil)
+	copy(t.kids[i+1:], t.kids[i:])
+	t.kids[i] = c
+}
+
+// resolveNS resolves a namespace prefix through the declarations on the element and its
+// ancestors ("" is the default namespace).
+func (t *tok) resolveNS(prefix string) string {
+	for e := t; e != nil; e = e.parent {
+		for _, a := range e.attrs {
+			if prefix == "" && a.space == "" && a.key == "xmlns" {
+				return a.val
+			}
+			if prefix != "" && a.space == "xmlns" && a.key == prefix {
+				return a.val
+			}
+		}
+	}
+	return ""
+}
+
+func (t *tok) resolve() {
+	if t.kind == kElem {
+		if t.tag != "" {
+			t.uri = t.resolveNS(t.space)
+		}
+		for i := range t.attrs {
+			if t.attrs[i].space == "" {
+				t.attrs[i].uri = ""
+			} else {
+				t.attrs[i].uri = t.resolveNS(t.attrs[i].space)
+			}
+		}
+	}
+	for _, c := range t.kids {
+		c.resolve()
+	}
+}
+
+// elements lists the elements in document order, the document itself excluded.
+func (t *tok) elements() []*tok {
+	var out []*tok
+	var walk func(*tok)
+	walk = func(e *tok) {
+		if e.kind != kElem {
+			return
+		}
+		if !e.isDoc() {
+			out = append(out, e)
+		}
+		for _, c := range e.kids {
+			walk(c)
+		}
+	}
+	walk(t)
+	return out
+}
+
+func (t *tok) depth() int {
+	d := 0
+	for _, c := range t.kids {
+		if c.kind == kElem {
+			if cd := c.depth() + 1; cd > d {
+				d = cd
+			}
+		}
+	}
+	return d
+}
+
+func (t *tok) all() []*tok {
+	out := []*tok{t}
+	for _, c := range t.kids {
+		out = append(out, c.all()...)
+	}
+	return out
+}
+
+// GoString is what the draw report prints (it uses %#v): the plain XML spelling of the tree.
+func (t *tok) GoString() string {
+	w := &xmlWriter{tp: &tape{}}
+	if t.isDoc() {
+		for _, k := range t.kids {
+			w.tok(k)
+		}
+	} else {
+		w.tok(t)
+	}
+	return fmt.Sprintf("%q", w.b.String())
+}
+
+func isAncestor(a, d *tok) bool {
+	for e := d; e != nil; e = e.parent {
+		if e == a {
+			return true
+		}
+	}
+	return false
+}
+
+func isWS(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if c := s[i]; c != ' ' && c != '\t' && c != '\n' && c != '\r' {
+			return false
+		}
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- text rules
+
+func validXMLChar(r rune) bool {
+	return r == 0x09 || r == 0x0A || r == 0x0D || r >= 0x20 && r <= 0xD7FF ||
+		r >= 0xE000 && r <= 0xFFFD || r >= 0x10000 && r <= 0x10FFFF
+}
+
+func hasInvalid(s string) bool {
+	for i := 0; i < len(s); {
+		r, w := utf8.DecodeRuneInString(s[i:])
+		if !validXMLChar(r) || (r == utf8.RuneError && w == 1) {
+			return true
+		}
+		i += w
+	}
+	return false
+}
+
+// fixInvalid is the documented sanitisation of text and attribute values: every character XML
+// forbids, and every invalid byte, becomes U+FFFD.
+func fixInvalid(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); {
+		r, w := utf8.DecodeRuneInString(s[i:])
+		if !validXMLChar(r) || (r == utf8.RuneError && w == 1) {
+			b.WriteRune(0xFFFD)
+		} else {
+			b.WriteString(s[i : i+w])
+		}
+		i += w
+	}
+	return b.String()
+}
+
+// normCR is the XML line-end normalisation every parser applies to literal carriage returns.
+func normCR(s string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(s, "\r\n", "\n"), "\r", "\n")
+}
+
+// sanComment: a space is inserted before a hyphen that follows a hyphen and after a trailing one.
+func sanComment(s string) string {
+	var b strings.Builder
+	hyphen := false
+	for i := 0; i < len(s); i++ {
+		if s[i] == '-' {
+			if hyphen {
+				b.WriteByte(' ')
+			}
+			hyphen = true
+		} else {
+			hyphen = false
+		}
+		b.WriteByte(s[i])
+	}
+	if hyphen {
+		b.WriteByte(' ')
+	}
+	return b.String()
+}
+
+// sanPI: "?>" becomes "? >".
+func sanPI(s string) string { return strings.ReplaceAll(s, "?>", "? >") }
+
+func hasAny(s, chars string) bool { return strings.ContainsAny(s, chars) }
+
+// --------------------------------------------------------------------------- generators: strings
+
+var (
+	tagNames  = []string{"a", "b", "c", "d", "e", "r"}
+	attrKeys  = []string{"x", "y", "z", "id"}
+	prefixes  = []string{"", "", "", "p", "q"}
+	prefixURI = map[string]string{"p": "urn:p", "q": "urn:q", "": "urn:d"}
+	piTargets = []string{"t", "xml-stylesheet", "pi-2"}
+
+	tags    = hegel.SampledFrom(tagNames)
+	keys    = hegel.SampledFrom(attrKeys)
+	spaces  = hegel.SampledFrom(prefixes) // unprefixed three times in five
+	targets = hegel.SampledFrom(piTargets)
+)
+
+// textPieces: the alphabet of text, attribute values, comments and instructions; attrPieces leaves
+// out the tab and the newline, which a conforming parser normalises in an attribute value
+// (etree/9's second shape); forbiddenPieces are what XML does not allow (and invalid UTF-8).
+var (
+	textPieces = []string{"a", "b", "Z", "0", " ", " ", "\t", "\n", "<", ">", "&", "'", "\"", "]]>", "]]", "--", "-",
+		"?>", "?", "é", "€", "\U0001F600", "&amp;", "&#60;", ";", "=", "/", "[", "]"}
+	forbiddenPieces = []string{"\x01", "\x00", "\x7f", "\xff", "\xc3", "\uFFFE", "\uFEFF"}
+	attrPieces      = without(textPieces, "\t", "\n")
+
+	plainPieces     = hegel.SampledFrom(textPieces)
+	plainAttrPieces = hegel.SampledFrom(attrPieces)
+	crPieces        = pick("\r", "\r\n")
+	badPieces       = hegel.SampledFrom(forbiddenPieces)
+)
+
+func without(xs []string, drop ...string) []string {
+	var out []string
+	for _, x := range xs {
+		keep := true
+		for _, d := range drop {
+			if x == d {
+				keep = false
+			}
+		}
+		if keep {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// piecesOf is the piece alphabet of a string: a plain piece first, a carriage return one time in
+// twenty and a forbidden piece three times in twenty when they are allowed.
+func piecesOf(plain hegel.Generator[string], cr, bad bool) hegel.Generator[string] {
+	w := [3]int{100, 0, 0}
+	if bad {
+		w[2] = 15
+		w[0] -= 15
+	}
+	if cr {
+		w[1] = 5
+		if bad {
+			w[1] = 4
+		}
+		w[0] -= w[1]
+	}
+	return weighted(choice[string]{w[0], plain}, choice[string]{w[1], crPieces}, choice[string]{w[2], badPieces})
+}
+
+// textsOf is zero to max pieces joined.
+func textsOf(pieces hegel.Generator[string], max int) hegel.Generator[string] {
+	return joined(hegel.Lists(pieces).MaxSize(max), "")
+}
+
+var (
+	// texts: plain text of up to six pieces, for the mutation properties' tokens; shortTexts of
+	// up to three, for the values they set.
+	texts      = textsOf(plainPieces, 6)
+	shortTexts = textsOf(plainPieces, 3)
+)
+
+// --------------------------------------------------------------------------- generators: trees
+
+// treeOpts shapes a document grammar; a grammar is built once per option set.
+type treeOpts struct {
+	crText    bool // carriage returns in text (raw under the default escaping: etree/9)
+	crAttr    bool // carriage returns in attribute values (etree/9)
+	attrWS    bool // tabs and newlines in attribute values (raw under the default escaping, normalised by a conforming parser: etree/9)
+	invalid   bool // forbidden characters in text and attribute values (sanitised to U+FFFD)
+	badCData  bool // forbidden characters in CDATA, comments, instructions (etree/11)
+	redeclare bool // namespace redeclarations below the root
+	docTokens bool // comments, instructions and a DOCTYPE at document level
+	wsText    bool // whitespace-only text tokens
+	maxDepth  int
+	maxKids   int
+}
+
+// node is a drawn token: the record the grammar produces, turned into a model token by toTok.
+type node struct {
+	kind   kind
+	space  string
+	tag    string
+	redecl attr // a namespace redeclaration on the element, key "" when there is none
+	attrs  []attr
+	kids   []node
+	data   string
+	target string
+}
+
+// docSpec is a drawn document: miscellany around a root element that declares the p and q
+// prefixes (and sometimes a default namespace), and the budget of elements below the root.
+type docSpec struct {
+	before    []node
+	doctype   bool
+	defaultNS bool
+	root      node
+	after     []node
+	budget    int
+}
+
+// grammar holds the generators of one option set; the kid lists are memoised per depth.
+type grammar struct {
+	o      treeOpts
+	kids   map[int]hegel.Generator[[]node]
+	attrs  hegel.Generator[[]attr]
+	redecl hegel.Generator[attr]
+	texts  hegel.Generator[node]
+	cdata  hegel.Generator[node]
+	misc   hegel.Generator[node]
+}
+
+var (
+	grammarsMu sync.Mutex
+	docsMemo   = map[treeOpts]hegel.Generator[*tok]{}
+)
+
+// docsOf is the model-tree generator of an option set, built once.
+func docsOf(o treeOpts) hegel.Generator[*tok] {
+	grammarsMu.Lock()
+	defer grammarsMu.Unlock()
+	if g, ok := docsMemo[o]; ok {
+		return g
+	}
+	g := hegel.Map(newGrammar(o).docs(), toModel)
+	docsMemo[o] = g
+	return g
+}
+
+var (
+	// redecls: a prefix redeclared on an element (to its own URI or another; distinct URIs per
+	// prefix, since two prefixes on one URI would make p:y and q:y one attribute), or the
+	// default namespace redeclared or undeclared.
+	prefixRedecls = hegel.FlatMap(pick("p", "q"), func(px string) hegel.Generator[attr] {
+		return hegel.Map(pick("urn:"+px+"2", "urn:"+px), func(uri string) attr { return attr{space: "xmlns", key: px, val: uri} })
+	})
+	defaultRedecls = hegel.Map(pick("urn:d2", ""), func(uri string) attr { return attr{key: "xmlns", val: uri} })
+	redecls        = weighted(choice[attr]{50, prefixRedecls}, choice[attr]{50, defaultRedecls})
+)
+
+func newGrammar(o treeOpts) *grammar {
+	g := &grammar{o: o, kids: map[int]hegel.Generator[[]node]{}}
+	crAny := o.crText || o.crAttr
+	attrPlain := plainPieces
+	if !o.attrWS {
+		attrPlain = plainAttrPieces
+	}
+	attrVals := textsOf(piecesOf(attrPlain, o.crAttr, o.invalid), 4)
+	attrs := hegel.Composite(func(tc hegel.TestCase) attr {
+		return attr{space: hegel.Draw(tc, spaces), key: hegel.Draw(tc, keys), val: hegel.Draw(tc, attrVals)}
+	})
+	g.attrs = hegel.Map(many(attrs, 0, 3), dedupeAttrs)
+	g.redecl = hegel.Just(attr{})
+	if o.redeclare {
+		g.redecl = maybe(10, redecls)
+	}
+	g.texts = hegel.Map(textsOf(piecesOf(plainPieces, o.crText, o.invalid), 6), func(s string) node {
+		if !o.wsText && isWS(s) {
+			s += "t"
+		}
+		return node{kind: kText, data: s}
+	})
+	// Comments, instructions and CDATA carry what the parser hands over raw.
+	other := piecesOf(plainPieces, crAny, o.badCData)
+	g.cdata = hegel.Map(joined(many(other, 1, 6), ""), func(s string) node { return node{kind: kCData, data: s} })
+	comments := hegel.Map(textsOf(other, 6), func(s string) node { return node{kind: kComment, data: s} })
+	instructions := hegel.Composite(func(tc hegel.TestCase) node {
+		return node{kind: kPI, target: hegel.Draw(tc, targets), data: strings.TrimLeft(hegel.Draw(tc, textsOf(other, 6)), " \t\r\n")}
+	})
+	g.misc = weighted(choice[node]{50, comments}, choice[node]{50, instructions})
+	return g
+}
+
+// dedupeAttrs keeps the first attribute of each (prefix, key).
+func dedupeAttrs(as []attr) []attr {
+	var out []attr
+	for _, a := range as {
+		dup := false
+		for _, b := range out {
+			if b.space == a.space && b.key == a.key {
+				dup = true
+			}
+		}
+		if !dup {
+			out = append(out, a)
+		}
+	}
+	return out
+}
+
+// kidsAt is the children of an element whose children sit at the given depth: a text first,
+// an element (when the depth allows one, whose own children come from the next depth), CDATA
+// or a comment or instruction, up to maxKids of them.
+func (g *grammar) kidsAt(depth int) hegel.Generator[[]node] {
+	if k, ok := g.kids[depth]; ok {
+		return k
+	}
+	var kinds hegel.Generator[node]
+	if depth < g.o.maxDepth {
+		kinds = weighted(choice[node]{25, g.texts}, choice[node]{45, g.elemsAt(depth)}, choice[node]{12, g.cdata}, choice[node]{18, g.misc})
+	} else {
+		kinds = weighted(choice[node]{70, g.texts}, choice[node]{12, g.cdata}, choice[node]{18, g.misc})
+	}
+	k := hegel.Lists(kinds).MaxSize(g.o.maxKids)
+	g.kids[depth] = k
+	return k
+}
+
+// elemsAt is an element at the given depth, with children from the depth below.
+func (g *grammar) elemsAt(depth int) hegel.Generator[node] {
+	kids := g.kidsAt(depth + 1)
+	return hegel.Composite(func(tc hegel.TestCase) node {
+		return node{
+			kind:   kElem,
+			space:  hegel.Draw(tc, spaces),
+			tag:    hegel.Draw(tc, tags),
+			redecl: hegel.Draw(tc, g.redecl),
+			attrs:  hegel.Draw(tc, g.attrs),
+			kids:   hegel.Draw(tc, kids),
+		}
+	})
+}
+
+// docs is a document: comments and instructions and a DOCTYPE around the root when docTokens.
+func (g *grammar) docs() hegel.Generator[docSpec] {
+	miscs := hegel.Just[[]node](nil)
+	doctype := hegel.Just(false)
+	if g.o.docTokens {
+		miscs = many(g.misc, 0, 2)
+		doctype = chance(30)
+	}
+	rootKids := g.kidsAt(1)
+	return hegel.Composite(func(tc hegel.TestCase) docSpec {
+		return docSpec{
+			before:    hegel.Draw(tc, miscs),
+			doctype:   hegel.Draw(tc, doctype),
+			defaultNS: hegel.Draw(tc, chance(30)),
+			root:      node{kind: kElem, space: hegel.Draw(tc, spaces), tag: "r", attrs: hegel.Draw(tc, g.attrs), kids: hegel.Draw(tc, rootKids)},
+			after:     hegel.Draw(tc, miscs),
+			budget:    hegel.Draw(tc, hegel.Integers(1, 14)),
+		}
+	})
+}
+
+func (nd node) toTok() *tok {
+	t := &tok{kind: nd.kind, space: nd.space, tag: nd.tag, data: nd.data, target: nd.target}
+	if nd.kind == kElem {
+		if nd.redecl.key != "" {
+			t.attrs = append(t.attrs, nd.redecl)
+		}
+		t.attrs = append(t.attrs, nd.attrs...)
+		for _, k := range nd.kids {
+			t.add(k.toTok())
+		}
+	}
+	return t
+}
+
+// toModel is the model tree of a drawn document: the prefix declarations on the root and the
+// element budget applied (the first budget elements below the root in document order are kept).
+func toModel(s docSpec) *tok {
+	doc := elem("", "")
+	for _, k := range s.before {
+		doc.add(k.toTok())
+	}
+	if s.doctype {
+		doc.add(&tok{kind: kDirective, data: "DOCTYPE r"})
+	}
+	root := doc.add(s.root.toTok())
+	decl := []attr{{space: "xmlns", key: "p", val: "urn:p"}, {space: "xmlns", key: "q", val: "urn:q"}}
+	if s.defaultNS {
+		decl = append(decl, attr{key: "xmlns", val: "urn:d"})
+	}
+	root.attrs = append(decl, root.attrs...)
+	capElements(root, s.budget)
+	for _, k := range s.after {
+		doc.add(k.toTok())
+	}
+	return doc
+}
+
+func capElements(root *tok, budget int) {
+	var walk func(e *tok)
+	walk = func(e *tok) {
+		var kept []*tok
+		for _, c := range e.kids {
+			if c.kind == kElem {
+				if budget == 0 {
+					continue
+				}
+				budget--
+				walk(c)
+			}
+			kept = append(kept, c)
+		}
+		e.kids = kept
+	}
+	walk(root)
+}
+
+// redeclared says whether an element below the root declares a namespace (lxml's XPath then
+// resolves prefixes differently from the fixed table).
+func redeclared(m *tok) bool {
+	els := m.elements()
+	if len(els) == 0 {
+		return false
+	}
+	for _, e := range els[1:] {
+		for _, a := range e.attrs {
+			if a.space == "xmlns" || a.key == "xmlns" {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- etree <-> model
+
+// build creates the etree document for a model through the public API.
+func build(m *tok) *etree.Document {
+	d := etree.NewDocument()
+	buildKids(&d.Element, m)
+	return d
+}
+
+func buildKids(e *etree.Element, m *tok) {
+	for _, c := range m.kids {
+		switch c.kind {
+		case kElem:
+			ce := e.CreateElement(c.fullTag())
+			for _, a := range c.attrs {
+				ce.CreateAttr(a.fullKey(), a.val)
+			}
+			buildKids(ce, c)
+		case kText:
+			e.CreateText(c.data)
+		case kCData:
+			e.CreateCData(c.data)
+		case kComment:
+			e.CreateComment(c.data)
+		case kPI:
+			e.CreateProcInst(c.target, c.data)
+		case kDirective:
+			e.CreateDirective(c.data)
+		}
+	}
+}
+
+// fromEtree reads an etree document into the model, with namespace URIs as etree resolves them
+// and the whitespace flags etree keeps.
+func fromEtree(d *etree.Document) *tok {
+	m := elem("", "")
+	fromEtreeKids(m, &d.Element)
+	return m
+}
+
+func fromEtreeKids(m *tok, e *etree.Element) {
+	for _, c := range e.Child {
+		switch c := c.(type) {
+		case *etree.Element:
+			t := m.add(elem(c.Space, c.Tag))
+			t.uri = c.NamespaceURI()
+			for i := range c.Attr {
+				a := &c.Attr[i]
+				t.attrs = append(t.attrs, attr{space: a.Space, key: a.Key, val: a.Value, uri: a.NamespaceURI()})
+			}
+			fromEtreeKids(t, c)
+		case *etree.CharData:
+			k := kText
+			if c.IsCData() {
+				k = kCData
+			}
+			m.add(&tok{kind: k, data: c.Data, created: !c.IsWhitespace()})
+		case *etree.Comment:
+			m.add(&tok{kind: kComment, data: c.Data})
+		case *etree.Directive:
+			m.add(&tok{kind: kDirective, data: c.Data})
+		case *etree.ProcInst:
+			m.add(&tok{kind: kPI, target: c.Target, data: c.Inst})
+		default:
+			m.add(&tok{kind: kDirective, data: fmt.Sprintf("unknown token %T", c)})
+		}
+	}
+}
+
+// norm puts a tree in the form a parse produces: adjacent character data of one kind merged,
+// empty character data dropped, CDATA turned into text when it is not preserved.
+func norm(t *tok, keepCData bool) *tok {
+	c := *t
+	c.parent = nil
+	c.attrs = append([]attr(nil), t.attrs...)
+	c.kids = nil
+	for _, k := range t.kids {
+		nk := norm(k, keepCData)
+		if nk.kind == kCData && !keepCData {
+			nk.kind = kText
+		}
+		if nk.isChar() && nk.data == "" {
+			continue
+		}
+		if l := len(c.kids); l > 0 && nk.isChar() && c.kids[l-1].kind == nk.kind {
+			c.kids[l-1].data += nk.data
+			continue
+		}
+		c.add(nk)
+	}
+	return &c
+}
+
+// expected transforms a model into what etree should read back from its own output: text,
+// attribute values and CDATA sanitised of forbidden characters (U+FFFD), a comment's hyphens and
+// an instruction's "?>" spaced, an instruction's leading whitespace dropped, the carriage returns
+// a CDATA section cannot escape normalised by the parser. Carriage returns in text and attribute
+// values survive, as documented: the writer is to escape them (it does not under the default
+// settings, etree/9), and a CDATA section is to be sanitised (it is not, etree/11).
+func expected(t *tok) *tok {
+	c := *t
+	c.parent = nil
+	c.attrs = nil
+	for _, a := range t.attrs {
+		c.attrs = append(c.attrs, attr{space: a.space, key: a.key, val: fixInvalid(a.val)})
+	}
+	switch t.kind {
+	case kText:
+		c.data = fixInvalid(t.data)
+	case kCData:
+		c.data = normCR(fixInvalid(t.data))
+	case kComment:
+		// encoding/xml hands comments over raw: no line-end normalisation.
+		c.data = sanComment(t.data)
+	case kPI:
+		c.data = sanPI(strings.TrimLeft(t.data, " \t\r\n"))
+		c.target = t.target
+	}
+	c.kids = nil
+	for _, k := range t.kids {
+		c.add(expected(k))
+	}
+	return &c
+}
+
+// diff describes the first difference between two model trees, "" when they agree. Namespace
+// URIs are compared when checkURI is set; whitespace flags when checkWS is set.
+func diff(a, b *tok, checkURI, checkWS bool, path string) string {
+	if a.kind != b.kind {
+		return fmt.Sprintf("%s: %s vs %s", path, kindNames[a.kind], kindNames[b.kind])
+	}
+	switch a.kind {
+	case kElem:
+		if a.space != b.space || a.tag != b.tag {
+			return fmt.Sprintf("%s: tag %q vs %q", path, a.fullTag(), b.fullTag())
+		}
+		if checkURI && a.uri != b.uri {
+			return fmt.Sprintf("%s: namespace %q vs %q", path, a.uri, b.uri)
+		}
+		if len(a.attrs) != len(b.attrs) {
+			return fmt.Sprintf("%s: %d vs %d attributes (%v vs %v)", path, len(a.attrs), len(b.attrs), a.attrs, b.attrs)
+		}
+		for i := range a.attrs {
+			x, y := a.attrs[i], b.attrs[i]
+			if x.space != y.space || x.key != y.key || x.val != y.val || (checkURI && x.uri != y.uri) {
+				return fmt.Sprintf("%s: attribute %d %+v vs %+v", path, i, x, y)
+			}
+		}
+		if len(a.kids) != len(b.kids) {
+			return fmt.Sprintf("%s: %d vs %d children (%s vs %s)", path, len(a.kids), len(b.kids), describe(a), describe(b))
+		}
+		for i := range a.kids {
+			if d := diff(a.kids[i], b.kids[i], checkURI, checkWS, fmt.Sprintf("%s/%d", path, i)); d != "" {
+				return d
+			}
+		}
+	case kPI:
+		if a.target != b.target || a.data != b.data {
+			return fmt.Sprintf("%s: pi (%q,%q) vs (%q,%q)", path, a.target, a.data, b.target, b.data)
+		}
+	default:
+		if a.data != b.data {
+			return fmt.Sprintf("%s: %s %q vs %q", path, kindNames[a.kind], a.data, b.data)
+		}
+		if checkWS && a.kind == kText && a.created != b.created {
+			return fmt.Sprintf("%s: whitespace flag %v vs %v for %q", path, !a.created, !b.created, a.data)
+		}
+	}
+	return ""
+}
+
+func describe(t *tok) string {
+	var parts []string
+	for _, k := range t.kids {
+		switch k.kind {
+		case kElem:
+			parts = append(parts, "<"+k.fullTag()+">")
+		case kPI:
+			parts = append(parts, fmt.Sprintf("pi(%q)", k.target))
+		default:
+			parts = append(parts, fmt.Sprintf("%s(%q)", kindNames[k.kind], k.data))
+		}
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+// --------------------------------------------------------------------------- known shapes
+
+// rawWhitespaceShapes names etree/9 when the model holds whitespace the write settings leave
+// raw and a parser normalises: a carriage return in text unless CanonicalText, a carriage return
+// in an attribute value unless CanonicalAttrVal without AttrSingleQuote, and (strict, for a
+// conforming parser such as lxml) a tab or newline in an attribute value under the same settings.
+func rawWhitespaceShapes(m *tok, ws etree.WriteSettings, strict bool) []string {
+	for _, t := range m.all() {
+		if t.kind == kText && !ws.CanonicalText && strings.Contains(t.data, "\r") {
+			return []string{"etree/9"}
+		}
+		if t.kind == kElem && !(ws.CanonicalAttrVal && !ws.AttrSingleQuote) {
+			for _, a := range t.attrs {
+				if strings.Contains(a.val, "\r") || (strict && hasAny(a.val, "\t\n")) {
+					return []string{"etree/9"}
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// unsanitisedShapes names etree/11 when a CDATA section holds a forbidden character (etree
+// cannot read its own output), or, strict, a comment or instruction does (a conforming parser
+// rejects the output).
+func unsanitisedShapes(m *tok, strict bool) []string {
+	for _, t := range m.all() {
+		if (t.kind == kCData || strict && (t.kind == kComment || t.kind == kPI)) && hasInvalid(t.data) {
+			return []string{"etree/11"}
+		}
+	}
+	return nil
+}
+
+// --------------------------------------------------------------------------- lxml view
+
+// view is the namespace-resolved, character-data-flattened shape of a tree: what lxml reports.
+type view struct {
+	kind   kind
+	tag    string // {uri}local or local
+	prefix string
+	attrs  [][2]string // {uri}key or key, value; declarations excluded
+	data   string
+	target string
+	kids   []*view
+}
+
+// viewOfModel is what a conforming parser sees of the model as etree should write it: text and
+// attribute values sanitised and otherwise intact (the harness and the canonical settings escape
+// their whitespace, the default settings do not: etree/9), CDATA flattened into the text with its
+// line ends normalised, comments and instructions sanitised and normalised.
+func viewOfModel(t *tok) *view {
+	v := &view{kind: t.kind, target: t.target}
+	switch t.kind {
+	case kElem:
+		v.tag = t.tag
+		v.prefix = t.space
+		if t.uri != "" {
+			v.tag = "{" + t.uri + "}" + t.tag
+		}
+		for _, a := range t.attrs {
+			if a.space == "xmlns" || (a.space == "" && a.key == "xmlns") {
+				continue
+			}
+			k := a.key
+			if a.space != "" {
+				k = "{" + a.uri + "}" + a.key
+			}
+			v.attrs = append(v.attrs, [2]string{k, fixInvalid(a.val)})
+		}
+		var text strings.Builder
+		flush := func() {
+			if text.Len() > 0 {
+				v.kids = append(v.kids, &view{kind: kText, data: text.String()})
+				text.Reset()
+			}
+		}
+		for _, k := range t.kids {
+			switch k.kind {
+			case kText:
+				text.WriteString(fixInvalid(k.data))
+			case kCData:
+				text.WriteString(normCR(fixInvalid(k.data)))
+			default:
+				flush()
+				v.kids = append(v.kids, viewOfModel(k))
+			}
+		}
+		flush()
+	case kComment:
+		v.data = normCR(sanComment(t.data))
+	case kPI:
+		v.data = normCR(sanPI(strings.TrimLeft(t.data, " \t\r\n")))
+	case kDirective:
+		v.data = t.data
+	}
+	return v
+}
+
+func viewOfLxml(nd *lxmlNode) *view {
+	switch nd.K {
+	case "e":
+		v := &view{kind: kElem, tag: nd.Tag, prefix: nd.Prefix}
+		for _, a := range nd.Attrs {
+			v.attrs = append(v.attrs, [2]string{a[0], a[1]})
+		}
+		for i := range nd.Kids {
+			v.kids = append(v.kids, viewOfLxml(&nd.Kids[i]))
+		}
+		return v
+	case "t":
+		return &view{kind: kText, data: nd.D}
+	case "c":
+		return &view{kind: kComment, data: nd.D}
+	case "p":
+		return &view{kind: kPI, target: nd.Target, data: nd.D}
+	}
+	return &view{kind: kDirective, data: "unknown lxml node " + nd.K + " " + nd.D}
+}
+
+func viewDiff(a, b *view, path string) string {
+	if a.kind != b.kind {
+		return fmt.Sprintf("%s: %s vs %s", path, kindNames[a.kind], kindNames[b.kind])
+	}
+	switch a.kind {
+	case kElem:
+		if a.tag != b.tag || a.prefix != b.prefix {
+			return fmt.Sprintf("%s: tag %s (prefix %q) vs %s (prefix %q)", path, a.tag, a.prefix, b.tag, b.prefix)
+		}
+		if len(a.attrs) != len(b.attrs) {
+			return fmt.Sprintf("%s: attributes %v vs %v", path, a.attrs, b.attrs)
+		}
+		for i := range a.attrs {
+			if a.attrs[i] != b.attrs[i] {
+				return fmt.Sprintf("%s: attribute %d %v vs %v", path, i, a.attrs[i], b.attrs[i])
+			}
+		}
+		if len(a.kids) != len(b.kids) {
+			return fmt.Sprintf("%s: %d vs %d children", path, len(a.kids), len(b.kids))
+		}
+		for i := range a.kids {
+			if d := viewDiff(a.kids[i], b.kids[i], fmt.Sprintf("%s/%d", path, i)); d != "" {
+				return d
+			}
+		}
+	default:
+		if a.data != b.data || a.target != b.target {
+			return fmt.Sprintf("%s: %s (%q,%q) vs (%q,%q)", path, kindNames[a.kind], a.target, a.data, b.target, b.data)
+		}
+	}
+	return ""
+}
+
+// lxmlDocView turns lxml's document into a view rooted at a document element.
+func lxmlDocView(ld *lxmlDoc) *view {
+	v := &view{kind: kElem}
+	for i := range ld.Kids {
+		v.kids = append(v.kids, viewOfLxml(&ld.Kids[i]))
+	}
+	return v
+}
+
+// docViewOfModel is the model's document view: directives are compared separately (lxml reports
+// the DOCTYPE through docinfo), so they are left out here.
+func docViewOfModel(m *tok) *view {
+	v := &view{kind: kElem}
+	for _, k := range m.kids {
+		if k.kind == kDirective {
+			continue
+		}
+		v.kids = append(v.kids, viewOfModel(k))
+	}
+	return v
+}
+
+// --------------------------------------------------------------------------- write settings
+
+// writeSettings: every flag off most of the time, so the shrunk case is the default spelling.
+var writeSettings = hegel.Composite(func(tc hegel.TestCase) etree.WriteSettings {
+	return etree.WriteSettings{
+		CanonicalEndTags: hegel.Draw(tc, chance(30)),
+		CanonicalText:    hegel.Draw(tc, chance(40)),
+		CanonicalAttrVal: hegel.Draw(tc, chance(40)),
+		AttrSingleQuote:  hegel.Draw(tc, chance(30)),
+	}
+})
+
+// writerTrees is the tree generator of the writer properties: every piece allowed, the
+// recorded shapes included. Under HEGEL_NO_KNOWN=1 the carriage returns (and, for the
+// conforming parser, the attribute tabs and newlines) are drawn only where the write settings
+// escape them, and CDATA, comments and instructions carry no forbidden character.
+func writerTrees(ws etree.WriteSettings, strict bool) hegel.Generator[*tok] {
+	o := treeOpts{crText: true, crAttr: true, attrWS: true, invalid: true, badCData: !Known.unsanitisedCData,
+		redeclare: true, docTokens: true, wsText: true, maxDepth: 4, maxKids: 4}
+	if Known.rawWhitespace {
+		o.crText = ws.CanonicalText
+		o.crAttr = ws.CanonicalAttrVal && !ws.AttrSingleQuote
+		o.attrWS = !strict || o.crAttr
+	}
+	return docsOf(o)
+}
+
+// --------------------------------------------------------------------------- properties
+
+// roundTrip: a tree, the settings it is written with and the settings it is read with.
+type roundTrip struct {
+	ws       etree.WriteSettings
+	tree     *tok
+	keep     bool // ReadSettings.PreserveCData
+	maxDepth int  // ReadSettings.MaxDepth, 0 for no limit
+}
+
+func (c roundTrip) GoString() string {
+	return fmt.Sprintf("settings %+v preserveCData=%v maxDepth=%d tree %s", c.ws, c.keep, c.maxDepth, c.tree.GoString())
+}
+
+var roundTrips = hegel.Composite(func(tc hegel.TestCase) roundTrip {
+	ws := hegel.Draw(tc, writeSettings)
+	return roundTrip{
+		ws:       ws,
+		tree:     hegel.Draw(tc, writerTrees(ws, false)),
+		keep:     hegel.Draw(tc, chance(70)),
+		maxDepth: hegel.Draw(tc, maybe(30, hegel.Integers(1, 6))),
+	}
+})
+
+// TestHegelWriteThenReadIsIdentity: a tree built through the API, written with any
+// WriteSettings and read back with PreserveCData, is the same tree up to the documented
+// sanitisation (forbidden characters to U+FFFD, comment hyphens, "?>" in instructions) and the
+// parser's line-end normalisation of CDATA; without PreserveCData the CDATA sections become text;
+// MaxDepth is honoured exactly; every text token read back is IsWhitespace exactly when it holds
+// only whitespace. A carriage return the settings leave raw (etree/9) and a forbidden character
+// in CDATA (etree/11) fail naming the bug.
+func TestHegelWriteThenReadIsIdentity(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, roundTrips)
+		m, ws := c.tree, c.ws
+		d := build(m)
+		d.WriteSettings = ws
+		out, err := d.WriteToString()
+		if err != nil {
+			col.fail(ht, "WriteToString: %v", err)
+			return
+		}
+		shapes := append(rawWhitespaceShapes(m, ws, false), unsanitisedShapes(m, false)...)
+		want := norm(expected(m), c.keep)
+		want.resolve()
+		d2 := etree.NewDocument()
+		d2.ReadSettings.PreserveCData = c.keep
+		d2.ReadSettings.MaxDepth = c.maxDepth
+		depth := m.depth()
+		err = d2.ReadFromString(out)
+		if md := c.maxDepth; md > 0 && depth > md {
+			if err != etree.ErrMaxDepth {
+				col.mismatch(ht, shapes, "ReadFromString of a depth-%d tree with MaxDepth %d: err = %v, want ErrMaxDepth\n%s", depth, md, err, out)
+				return
+			}
+			col.count("too-deep")
+			return
+		}
+		if err != nil {
+			col.mismatch(ht, shapes, "ReadFromString of etree's own output: %v\n%s", err, out)
+			return
+		}
+		got := fromEtree(d2)
+		if dd := diff(want, norm(got, true), true, false, "doc"); dd != "" {
+			col.mismatch(ht, shapes, "read(write(tree)) differs: %s\nsettings %+v preserveCData=%v\n%s", dd, ws, c.keep, out)
+			return
+		}
+		// Every whitespace-only text read back is flagged, nothing else is.
+		for _, k := range got.all() {
+			if k.kind == kText && k.created == isWS(k.data) {
+				col.fail(ht, "parsed text %q has IsWhitespace = %v", k.data, !k.created)
+				return
+			}
+		}
+		if c.keep {
+			col.count("cdata-kept")
+		} else {
+			col.count("cdata-flattened")
+		}
+	})
+}
+
+// lxmlCase: a tree and the settings etree writes it with.
+type lxmlCase struct {
+	ws   etree.WriteSettings
+	tree *tok
+}
+
+func (c lxmlCase) GoString() string {
+	return fmt.Sprintf("settings %+v tree %s", c.ws, c.tree.GoString())
+}
+
+var lxmlCases = hegel.Composite(func(tc hegel.TestCase) lxmlCase {
+	ws := hegel.Draw(tc, writeSettings)
+	return lxmlCase{ws: ws, tree: hegel.Draw(tc, writerTrees(ws, true))}
+})
+
+// TestHegelLxmlReadsTheOutput: lxml parses what etree writes (any WriteSettings) and sees the
+// model: resolved element and attribute namespaces, attribute values, character data, comments,
+// instructions and the DOCTYPE. Whitespace the settings leave raw (etree/9) and a forbidden
+// character in CDATA, a comment or an instruction (etree/11) fail naming the bug.
+func TestHegelLxmlReadsTheOutput(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, lxmlCases)
+		m, ws := c.tree, c.ws
+		m.resolve()
+		d := build(m)
+		d.WriteSettings = ws
+		out, err := d.WriteToString()
+		if err != nil {
+			col.fail(ht, "WriteToString: %v", err)
+			return
+		}
+		shapes := append(rawWhitespaceShapes(m, ws, true), unsanitisedShapes(m, true)...)
+		ld, err := lxmlParse(t, out)
+		if err != nil {
+			col.mismatch(ht, shapes, "lxml rejects etree's output: %v\nsettings %+v\n%s", err, ws, out)
+			return
+		}
+		wantDoctype := ""
+		for _, k := range m.kids {
+			if k.kind == kDirective {
+				wantDoctype = "<!" + k.data + ">"
+			}
+		}
+		if ld.Doctype != wantDoctype {
+			col.fail(ht, "lxml doctype %q, want %q\n%s", ld.Doctype, wantDoctype, out)
+			return
+		}
+		if dd := viewDiff(docViewOfModel(m), lxmlDocView(ld), "doc"); dd != "" {
+			col.mismatch(ht, shapes, "lxml's tree differs from the model: %s\nsettings %+v\n%s", dd, ws, out)
+			return
+		}
+		col.count("ok")
+	})
+}
+
+// --------------------------------------------------------------------------- XML writer
+
+// tape is a list of drawn choices read in order and recycled; an empty tape reads as zeros, the
+// plainest spelling of everything.
+type tape struct {
+	vals []int
+	i    int
+}
+
+func (t *tape) next() int {
+	if len(t.vals) == 0 {
+		return 0
+	}
+	v := t.vals[t.i%len(t.vals)]
+	t.i++
+	return v
+}
+
+func (t *tape) pick(xs ...string) string { return xs[t.next()%len(xs)] }
+
+func (t *tape) chance(pct int) bool { return t.next() >= 100-pct }
+
+// dupSpec: an attribute of the root written twice, the second time with the value "dup".
+type dupSpec struct {
+	on   bool
+	at   int  // which attribute, modulo the root's attribute count
+	keep bool // ReadSettings.PreserveDuplicateAttrs
+}
+
+// syntax is the drawn spelling of the harness's XML: a tape of choices for the writer and the
+// duplicate attribute.
+type syntax struct {
+	tape []int
+	dup  dupSpec
+}
+
+var (
+	dups = maybe(20, hegel.Composite(func(tc hegel.TestCase) dupSpec {
+		return dupSpec{on: true, at: hegel.Draw(tc, hegel.Integers(0, 9)), keep: hegel.Draw(tc, chance(50))}
+	}))
+	syntaxes = hegel.Composite(func(tc hegel.TestCase) syntax {
+		return syntax{tape: hegel.Draw(tc, hegel.Lists(hegel.Integers(0, 99)).MaxSize(80)), dup: hegel.Draw(tc, dups)}
+	})
+)
+
+var wsChoices = []string{" ", " ", "\t", "\n", "  ", "\r\n"}
+
+// xmlWriter serialises a model in varied but well-formed syntax, every choice read from the
+// tape: character and entity references, attribute quotes and whitespace, empty-element or
+// open/close tags, and the duplicate attribute (dupAt) of dupElem.
+type xmlWriter struct {
+	tp      *tape
+	b       strings.Builder
+	dupElem *tok
+	dupAt   int
+}
+
+func writeXML(m *tok, tp []int, dupElem *tok, dupAt int) string {
+	w := &xmlWriter{tp: &tape{vals: tp}, dupElem: dupElem, dupAt: dupAt}
+	for _, k := range m.kids {
+		w.tok(k)
+	}
+	return w.b.String()
+}
+
+func (w *xmlWriter) escape(s string, quote byte, attrMode bool) {
+	tp := w.tp
+	for i := 0; i < len(s); {
+		r, n := utf8.DecodeRuneInString(s[i:])
+		i += n
+		switch {
+		case r == '<':
+			w.b.WriteString(tp.pick("&lt;", "&#60;", "&#x3C;", "&#x3c;"))
+		case r == '&':
+			w.b.WriteString(tp.pick("&amp;", "&#38;", "&#x26;"))
+		case r == '>':
+			w.b.WriteString(tp.pick("&gt;", "&#62;", "&gt;"))
+		case r == '"' && (quote == '"' || tp.chance(30)):
+			w.b.WriteString(tp.pick("&quot;", "&#34;"))
+		case r == '\'' && (quote == '\'' || tp.chance(30)):
+			w.b.WriteString(tp.pick("&apos;", "&#39;"))
+		case attrMode && (r == '\t' || r == '\n' || r == '\r'):
+			fmt.Fprintf(&w.b, "&#x%X;", r)
+		case r == '\r':
+			w.b.WriteString("&#xD;")
+		case r < 128 && tp.chance(5):
+			fmt.Fprintf(&w.b, "&#%d;", r)
+		default:
+			w.b.WriteRune(r)
+		}
+	}
+}
+
+func (w *xmlWriter) attr(a attr) {
+	tp := w.tp
+	w.b.WriteString(tp.pick(wsChoices...))
+	w.b.WriteString(a.fullKey())
+	if tp.chance(20) {
+		w.b.WriteString(tp.pick(wsChoices...))
+	}
+	w.b.WriteByte('=')
+	if tp.chance(20) {
+		w.b.WriteString(tp.pick(wsChoices...))
+	}
+	q := byte('"')
+	if tp.chance(40) {
+		q = '\''
+	}
+	w.b.WriteByte(q)
+	w.escape(a.val, q, true)
+	w.b.WriteByte(q)
+}
+
+func (w *xmlWriter) tok(t *tok) {
+	tp := w.tp
+	switch t.kind {
+	case kElem:
+		w.b.WriteByte('<')
+		w.b.WriteString(t.fullTag())
+		for i, a := range t.attrs {
+			w.attr(a)
+			if t == w.dupElem && i == w.dupAt {
+				w.attr(attr{space: a.space, key: a.key, val: "dup"})
+			}
+		}
+		if tp.chance(20) {
+			w.b.WriteString(tp.pick(wsChoices...))
+		}
+		if len(t.kids) == 0 && tp.chance(60) {
+			w.b.WriteString("/>")
+			return
+		}
+		w.b.WriteByte('>')
+		for _, k := range t.kids {
+			w.tok(k)
+		}
+		w.b.WriteString("</")
+		w.b.WriteString(t.fullTag())
+		if tp.chance(20) {
+			w.b.WriteString(tp.pick(wsChoices...))
+		}
+		w.b.WriteByte('>')
+	case kText:
+		w.escape(t.data, 0, false)
+	case kCData:
+		w.b.WriteString("<![CDATA[")
+		w.b.WriteString(strings.ReplaceAll(t.data, "]]>", "]]]]><![CDATA[>"))
+		w.b.WriteString("]]>")
+	case kComment:
+		w.b.WriteString("<!--")
+		w.b.WriteString(sanComment(t.data))
+		w.b.WriteString("-->")
+	case kPI:
+		w.b.WriteString("<?")
+		w.b.WriteString(t.target)
+		if t.data != "" {
+			w.b.WriteString(tp.pick(" ", " ", "\t"))
+			w.b.WriteString(sanPI(t.data))
+		}
+		w.b.WriteString("?>")
+	case kDirective:
+		w.b.WriteString("<!")
+		w.b.WriteString(t.data)
+		w.b.WriteByte('>')
+	}
+}
+
+// parseCase: a tree the harness writes, and the syntax it writes it in.
+type parseCase struct {
+	tree *tok
+	syn  syntax
+}
+
+func (c parseCase) GoString() string {
+	return fmt.Sprintf("tree %s syntax %+v", c.tree.GoString(), c.syn)
+}
+
+// presanitised is the tree with its comments, instructions and CDATA reduced to what survives
+// a parse: those carry no escaping, so the model is sanitised and line-end normalised up front.
+func presanitised(m *tok) *tok {
+	for _, k := range m.all() {
+		switch k.kind {
+		case kComment:
+			k.data = sanComment(normCR(k.data))
+		case kPI:
+			k.data = sanPI(normCR(k.data))
+		case kCData:
+			k.data = normCR(k.data)
+		}
+	}
+	return m
+}
+
+var (
+	parseTrees = hegel.Map(docsOf(treeOpts{attrWS: true, redeclare: true, docTokens: true, wsText: true, maxDepth: 4, maxKids: 4}), presanitised)
+	parseCases = hegel.Composite(func(tc hegel.TestCase) parseCase {
+		return parseCase{tree: hegel.Draw(tc, parseTrees), syn: hegel.Draw(tc, syntaxes)}
+	})
+)
+
+// TestHegelParsesLikeLxml: the harness writes a model in varied well-formed syntax; etree
+// (PreserveCData) reads the model back, with the CDATA flags, the whitespace flags and the
+// namespaces the model resolves, and lxml reads the same document. Duplicate attributes
+// (lxml refuses them) follow PreserveDuplicateAttrs.
+func TestHegelParsesLikeLxml(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, parseCases)
+		m := c.tree
+		m.resolve()
+		// A duplicate attribute on the root (written right after the original, value "dup"):
+		// PreserveDuplicateAttrs keeps both in order, otherwise the last value wins in the first slot.
+		root := m.elements()[0]
+		dup := c.syn.dup.on && len(root.attrs) > 2
+		var dupElem *tok
+		dupAt := 0
+		if dup {
+			dupElem, dupAt = root, c.syn.dup.at%len(root.attrs)
+		}
+		xml := writeXML(m, c.syn.tape, dupElem, dupAt)
+		if dup {
+			a := root.attrs[dupAt]
+			if c.syn.dup.keep {
+				root.attrs = append(root.attrs[:dupAt+1], append([]attr{{space: a.space, key: a.key, val: "dup"}}, root.attrs[dupAt+1:]...)...)
+			} else {
+				root.attrs[dupAt].val = "dup"
+			}
+			col.count("dup-attr")
+		}
+		d := etree.NewDocument()
+		d.ReadSettings.PreserveCData = true
+		d.ReadSettings.PreserveDuplicateAttrs = dup && c.syn.dup.keep
+		if err := d.ReadFromString(xml); err != nil {
+			col.fail(ht, "etree rejects well-formed XML: %v\n%s", err, xml)
+			return
+		}
+		got := fromEtree(d)
+		want := norm(m, true)
+		want.resolve()
+		for _, k := range want.all() {
+			if k.kind == kText {
+				k.created = !isWS(k.data)
+			}
+		}
+		if dd := diff(want, norm(got, true), true, true, "doc"); dd != "" {
+			col.fail(ht, "etree's tree differs from the model: %s\n%s", dd, xml)
+			return
+		}
+		if dup {
+			return
+		}
+		ld, err := lxmlParse(t, xml)
+		if err != nil {
+			col.fail(ht, "lxml rejects the harness's XML: %v\n%s", err, xml)
+			return
+		}
+		if dd := viewDiff(docViewOfModel(m), lxmlDocView(ld), "doc"); dd != "" {
+			col.fail(ht, "lxml's tree differs from the model: %s\n%s", dd, xml)
+			return
+		}
+		col.count("ok")
+	})
+}
