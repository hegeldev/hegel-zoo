+package etree_test
+
+// The token API and the paths against the model: see hegel_test.go for the model.
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/beevik/etree"
+)
+
+// --------------------------------------------------------------------------- paths
+
+type pfilter struct {
+	kind       string // attr attrval child childval pos fn fnval
+	space, key string
+	fn         string
+	val        string
+	pos        int
+	quote      byte
+}
+
+type pseg struct {
+	sel        string // self parent children desc tag root
+	space, tag string
+	filters    []pfilter
+}
+
+type ppath struct {
+	abs  bool
+	segs []pseg
+}
+
+var fnNames = []string{"text", "local-name", "name", "namespace-prefix", "namespace-uri"}
+
+func (f pfilter) String() string {
+	q := string(f.quote)
+	key := f.key
+	if f.space != "" {
+		key = f.space + ":" + f.key
+	}
+	switch f.kind {
+	case "attr":
+		return "[@" + key + "]"
+	case "attrval":
+		return "[@" + key + "=" + q + f.val + q + "]"
+	case "child":
+		return "[" + key + "]"
+	case "childval":
+		return "[" + key + "=" + q + f.val + q + "]"
+	case "pos":
+		return "[" + fmt.Sprint(f.pos) + "]"
+	case "fn":
+		return "[" + f.fn + "()]"
+	default:
+		return "[" + f.fn + "()=" + q + f.val + q + "]"
+	}
+}
+
+func (s pseg) String() string {
+	var b strings.Builder
+	switch s.sel {
+	case "self":
+		b.WriteString(".")
+	case "parent":
+		b.WriteString("..")
+	case "children":
+		b.WriteString("*")
+	case "desc":
+	case "tag":
+		if s.space != "" {
+			b.WriteString(s.space + ":")
+		}
+		b.WriteString(s.tag)
+	}
+	for _, f := range s.filters {
+		b.WriteString(f.String())
+	}
+	return b.String()
+}
+
+func (p ppath) String() string {
+	var parts []string
+	for _, s := range p.segs {
+		parts = append(parts, s.String())
+	}
+	s := strings.Join(parts, "/")
+	if p.abs {
+		s = "/" + s
+	}
+	return s
+}
+
+// values of the tree a filter may compare with, to get hits.
+func treeValues(m *tok) (attrVals, texts []string) {
+	seen := map[string]bool{}
+	for _, e := range m.elements() {
+		for _, a := range e.attrs {
+			if !seen["a"+a.val] {
+				seen["a"+a.val] = true
+				attrVals = append(attrVals, a.val)
+			}
+		}
+		if tx := e.text(); !seen["t"+tx] {
+			seen["t"+tx] = true
+			texts = append(texts, tx)
+		}
+	}
+	return
+}
+
+func genFilter(tc hegel.TestCase, m *tok, attrVals, texts []string) pfilter {
+	f := pfilter{quote: '\''}
+	if chance(tc, 30) {
+		f.quote = '"'
+	}
+	name := func() (string, string) {
+		sp := ""
+		if chance(tc, 25) {
+			sp = pick(tc, []string{"p", "q"})
+		}
+		return sp, pick(tc, tagNames)
+	}
+	val := func(from []string) string {
+		if len(from) > 0 && chance(tc, 70) {
+			return pick(tc, from)
+		}
+		return pick(tc, []string{"", "v", "a", "1", "x/y", "a]b", "a=b", "[", " "})
+	}
+	switch n(tc, 1, 7) {
+	case 1:
+		f.kind = "attr"
+		f.space, _ = name()
+		f.key = pick(tc, attrKeys)
+	case 2:
+		f.kind = "attrval"
+		f.space, _ = name()
+		f.key = pick(tc, attrKeys)
+		f.val = val(attrVals)
+	case 3:
+		f.kind = "child"
+		f.space, f.key = name()
+	case 4:
+		f.kind = "childval"
+		f.space, f.key = name()
+		f.val = val(texts)
+	case 5:
+		f.kind = "pos"
+		f.pos = n(tc, -3, 4)
+	case 6:
+		f.kind = "fn"
+		f.fn = pick(tc, fnNames)
+	default:
+		f.kind = "fnval"
+		f.fn = pick(tc, fnNames)
+		switch f.fn {
+		case "text":
+			f.val = val(texts)
+		case "local-name":
+			f.val = pick(tc, tagNames)
+		case "name":
+			_, t := name()
+			f.val = t
+			if chance(tc, 40) {
+				f.val = pick(tc, []string{"p", "q"}) + ":" + t
+			}
+		case "namespace-prefix":
+			f.val = pick(tc, []string{"p", "q", "", "x"})
+		case "namespace-uri":
+			f.val = pick(tc, []string{"urn:p", "urn:q", "urn:d", "", "urn:p2"})
+		}
+	}
+	// The value may not contain the quote used around it.
+	f.val = strings.ReplaceAll(f.val, string(f.quote), "")
+	return f
+}
+
+func genPath(tc hegel.TestCase, m *tok) ppath {
+	attrVals, texts := treeValues(m)
+	p := ppath{abs: chance(tc, 25)}
+	k := n(tc, 1, 4)
+	if !p.abs && chance(tc, 40) {
+		// .//... : the common relative search from an element
+		p.segs = append(p.segs, pseg{sel: "self"}, pseg{sel: "desc"})
+	}
+	for i := 0; i < k; i++ {
+		s := pseg{}
+		switch r := n(tc, 1, 100); {
+		case r <= 10:
+			s.sel = "self"
+		case r <= 20:
+			s.sel = "parent"
+		case r <= 35:
+			s.sel = "children"
+		case r <= 50 && (i > 0 || p.abs) && i < k-1:
+			s.sel = "desc"
+		default:
+			s.sel = "tag"
+			if chance(tc, 25) {
+				s.space = pick(tc, []string{"p", "q"})
+			}
+			s.tag = pick(tc, tagNames)
+		}
+		nf := 0
+		if chance(tc, 45) {
+			nf = 1
+			if chance(tc, 25) {
+				nf = 2
+			}
+		}
+		for j := 0; j < nf; j++ {
+			s.filters = append(s.filters, genFilter(tc, m, attrVals, texts))
+		}
+		p.segs = append(p.segs, s)
+	}
+	return p
+}
+
+// evalPath evaluates a path on the model as documented: breadth-first over the segments,
+// selectors then filters, results deduplicated.
+func evalPath(start *tok, p ppath) []*tok {
+	type node struct {
+		e    *tok
+		rest []pseg
+	}
+	segs := p.segs
+	if p.abs {
+		segs = append([]pseg{{sel: "root"}}, segs...)
+	}
+	queue := []node{{start, segs}}
+	seen := map[*tok]bool{}
+	var res []*tok
+	for len(queue) > 0 {
+		nd := queue[0]
+		queue = queue[1:]
+		seg, rest := nd.rest[0], nd.rest[1:]
+		cands := selectModel(nd.e, seg)
+		for _, f := range seg.filters {
+			cands = filterModel(cands, f)
+		}
+		if len(rest) == 0 {
+			for _, c := range cands {
+				if !seen[c] {
+					seen[c] = true
+					res = append(res, c)
+				}
+			}
+		} else {
+			for _, c := range cands {
+				queue = append(queue, node{c, rest})
+			}
+		}
+	}
+	return res
+}
+
+func spaceMatch(sel, have string) bool { return sel == "" || sel == have }
+
+func childElems(e *tok) []*tok {
+	var out []*tok
+	for _, c := range e.kids {
+		if c.kind == kElem {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+func selectModel(e *tok, seg pseg) []*tok {
+	switch seg.sel {
+	case "self":
+		return []*tok{e}
+	case "parent":
+		if e.parent != nil {
+			return []*tok{e.parent}
+		}
+		return nil
+	case "children":
+		return childElems(e)
+	case "desc":
+		var out []*tok
+		queue := []*tok{e}
+		for len(queue) > 0 {
+			x := queue[0]
+			queue = queue[1:]
+			out = append(out, x)
+			queue = append(queue, childElems(x)...)
+		}
+		return out
+	case "tag":
+		var out []*tok
+		for _, c := range childElems(e) {
+			if spaceMatch(seg.space, c.space) && c.tag == seg.tag {
+				out = append(out, c)
+			}
+		}
+		return out
+	case "root":
+		r := e
+		for r.parent != nil {
+			r = r.parent
+		}
+		return []*tok{r}
+	}
+	return nil
+}
+
+func fnValue(e *tok, fn string) string {
+	switch fn {
+	case "text":
+		return e.text()
+	case "local-name":
+		return e.tag
+	case "name":
+		return e.fullTag()
+	case "namespace-prefix":
+		return e.space
+	case "namespace-uri":
+		if e.tag == "" {
+			return ""
+		}
+		return e.resolveNS(e.space)
+	}
+	return ""
+}
+
+func filterModel(cands []*tok, f pfilter) []*tok {
+	var out []*tok
+	switch f.kind {
+	case "pos":
+		switch {
+		case f.pos > 0 && f.pos <= len(cands):
+			out = append(out, cands[f.pos-1])
+		case f.pos < 0 && -f.pos <= len(cands):
+			out = append(out, cands[len(cands)+f.pos])
+		}
+		return out
+	case "attr", "attrval":
+		for _, c := range cands {
+			for _, a := range c.attrs {
+				if spaceMatch(f.space, a.space) && a.key == f.key && (f.kind == "attr" || a.val == f.val) {
+					out = append(out, c)
+					break
+				}
+			}
+		}
+	case "child", "childval":
+		for _, c := range cands {
+			for _, cc := range childElems(c) {
+				if spaceMatch(f.space, cc.space) && cc.tag == f.key && (f.kind == "child" || cc.text() == f.val) {
+					out = append(out, c)
+					break
+				}
+			}
+		}
+	case "fn":
+		for _, c := range cands {
+			if fnValue(c, f.fn) != "" {
+				out = append(out, c)
+			}
+		}
+	case "fnval":
+		for _, c := range cands {
+			if fnValue(c, f.fn) == f.val {
+				out = append(out, c)
+			}
+		}
+	}
+	return out
+}
+
+// xpathOf translates a path to XPath for lxml, "" when the path uses what the two read
+// differently ([tag='v'] and [text()] compare etree's Text, not the string value; negative
+// and zero positions; namespace-prefix(); filters on the descendants selector).
+func xpathOf(p ppath) string {
+	var parts []string
+	for i, s := range p.segs {
+		var b strings.Builder
+		switch s.sel {
+		case "self":
+			b.WriteString("self::node()")
+		case "parent":
+			b.WriteString("parent::node()")
+		case "children":
+			b.WriteString("*")
+		case "desc":
+			if len(s.filters) > 0 {
+				return ""
+			}
+			b.WriteString("descendant-or-self::*")
+		case "tag":
+			b.WriteString("*[local-name()='" + s.tag + "'")
+			if s.space != "" {
+				b.WriteString(" and namespace-uri()='" + prefixURI[s.space] + "'")
+			}
+			b.WriteString("]")
+		}
+		for _, f := range s.filters {
+			q := string(f.quote)
+			ns := ""
+			if f.space != "" {
+				ns = " and namespace-uri()='" + prefixURI[f.space] + "'"
+			}
+			switch f.kind {
+			case "attr":
+				b.WriteString("[@*[local-name()='" + f.key + "'" + ns + "]]")
+			case "attrval":
+				b.WriteString("[@*[local-name()='" + f.key + "'" + ns + "]=" + q + f.val + q + "]")
+			case "child":
+				b.WriteString("[*[local-name()='" + f.key + "'" + ns + "]]")
+			case "pos":
+				if f.pos <= 0 {
+					return ""
+				}
+				b.WriteString("[" + fmt.Sprint(f.pos) + "]")
+			case "fn":
+				switch f.fn {
+				case "local-name", "name", "namespace-uri":
+					b.WriteString("[" + f.fn + "()!='']")
+				default:
+					return ""
+				}
+			case "fnval":
+				switch f.fn {
+				case "local-name", "name", "namespace-uri":
+					b.WriteString("[" + f.fn + "()=" + q + f.val + q + "]")
+				default:
+					return ""
+				}
+			default:
+				return ""
+			}
+		}
+		if i == 0 && !p.abs && s.sel == "desc" {
+			return ""
+		}
+		parts = append(parts, b.String())
+	}
+	x := strings.Join(parts, "/")
+	if p.abs {
+		x = "/" + x
+	}
+	return x
+}
+
+// pathGated says which recorded bug a path may run into, "" for none.
+func pathGated(p ppath) string {
+	for _, s := range p.segs {
+		childSeen := false
+		for _, f := range s.filters {
+			if Known.bracketInQuotedValue && strings.Contains(f.val, "[") {
+				return "bracket-gated"
+			}
+			if Known.zeroIndexIsFirst && f.kind == "pos" && f.pos == 0 {
+				return "zero-gated"
+			}
+			if f.kind == "child" || f.kind == "childval" {
+				childSeen = true
+			}
+			if Known.childFilterDuplicates && childSeen && f.kind == "pos" {
+				return "dup-gated"
+			}
+		}
+	}
+	return ""
+}
+
+func idsOf[T comparable](elems []T, index map[T]int) []int {
+	var ids []int
+	for _, e := range elems {
+		if i, ok := index[e]; ok {
+			ids = append(ids, i)
+		}
+	}
+	sort.Ints(ids)
+	return ids
+}
+
+func sameInts(a, b []int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// TestHegelPathsFollowTheModel: CompilePath accepts every path of the documented grammar;
+// FindElements from any element returns the model's set with no duplicates, FindElement its
+// first element, the Seq forms the same; lxml's XPath agrees on the shared subset.
+func TestHegelPathsFollowTheModel(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		m, st := genDoc(ht, treeOpts{redeclare: true, wsText: true, maxDepth: 4, maxKids: 4})
+		p := genPath(ht, m)
+		ps := p.String()
+		if g := pathGated(p); g != "" {
+			col.count(g)
+			return
+		}
+		cp, err := etree.CompilePath(ps)
+		if err != nil {
+			col.fail(ht, "CompilePath(%q): %v", ps, err)
+			return
+		}
+		d := build(m)
+		me := m.elements()
+		ee := (&d.Element).FindElements("//*")
+		// document order of etree's elements
+		ee = nil
+		var walk func(*etree.Element)
+		walk = func(e *etree.Element) {
+			for _, c := range e.ChildElements() {
+				ee = append(ee, c)
+				walk(c)
+			}
+		}
+		walk(&d.Element)
+		if len(me) != len(ee) {
+			col.fail(ht, "built tree has %d elements, model %d", len(ee), len(me))
+			return
+		}
+		mIndex := map[*tok]int{m: -1}
+		eIndex := map[*etree.Element]int{&d.Element: -1}
+		for i := range me {
+			mIndex[me[i]] = i
+			eIndex[ee[i]] = i
+		}
+		ctx := n(ht, -1, len(me)-1)
+		var start *tok
+		var estart *etree.Element
+		if ctx < 0 {
+			start, estart = m, &d.Element
+		} else {
+			start, estart = me[ctx], ee[ctx]
+		}
+		want := evalPath(start, p)
+		wantIDs := idsOf(want, mIndex)
+		got := estart.FindElementsPath(cp)
+		gotIDs := idsOf(got, eIndex)
+		gotSet := map[*etree.Element]bool{}
+		for _, e := range got {
+			if gotSet[e] {
+				col.fail(ht, "FindElements(%q) from %d returns an element twice", ps, ctx)
+				return
+			}
+			gotSet[e] = true
+		}
+		if !sameInts(wantIDs, gotIDs) {
+			out, _ := d.WriteToString()
+			col.fail(ht, "FindElements(%q) from element %d = %v, model %v\n%s", ps, ctx, gotIDs, wantIDs, out)
+			return
+		}
+		first := estart.FindElementPath(cp)
+		if (first == nil) != (len(got) == 0) || (first != nil && first != got[0]) {
+			col.fail(ht, "FindElement(%q) = %v, FindElements starts with %v", ps, first, got)
+			return
+		}
+		if len(got) > 0 {
+			k := 0
+			for e := range estart.FindElementsPathSeq(cp) {
+				if e != got[k] {
+					col.fail(ht, "FindElementsPathSeq(%q) differs from FindElementsPath at %d", ps, k)
+					return
+				}
+				k++
+				if k == 1 && chance(ht, 50) {
+					break
+				}
+			}
+		}
+		if len(want) == 0 {
+			col.count("empty")
+		} else {
+			col.count("hits")
+		}
+		// lxml on the shared subset.
+		x := xpathOf(p)
+		if x == "" || st.redeclared || ctx < 0 {
+			return
+		}
+		for _, e := range want {
+			if e == m {
+				return // the document element has no lxml counterpart
+			}
+		}
+		d.WriteSettings.CanonicalText = true
+		d.WriteSettings.CanonicalAttrVal = true
+		out, _ := d.WriteToString()
+		lx, err := lxmlXPath(t, out, x, nil, ctx)
+		if err != nil {
+			col.fail(ht, "lxml xpath %q (from %q): %v\n%s", x, ps, err, out)
+			return
+		}
+		if !sameInts(lx, wantIDs) {
+			col.fail(ht, "lxml xpath %q (from etree path %q) from element %d = %v, etree and model %v\n%s", x, ps, ctx, lx, wantIDs, out)
+			return
+		}
+		col.count("lxml")
+	})
+}
+
+// --------------------------------------------------------------------------- mutations
+
+// pairing keeps model tokens and etree tokens aligned.
+type pairing struct {
+	toE map[*tok]etree.Token
+	toM map[etree.Token]*tok
+}
+
+func pairUp(m *tok, e *etree.Element, pr *pairing) {
+	if len(m.kids) != len(e.Child) {
+		panic("pairing: child count")
+	}
+	for i, k := range m.kids {
+		pr.toE[k] = e.Child[i]
+		pr.toM[e.Child[i]] = k
+		if k.kind == kElem {
+			pairUp(k, e.Child[i].(*etree.Element), pr)
+		}
+	}
+}
+
+// checkIndices: every child of every element knows its parent and its index.
+func checkIndices(e *etree.Element) string {
+	for i, c := range e.Child {
+		if c.Index() != i {
+			return fmt.Sprintf("child %d of <%s> has Index() %d", i, e.FullTag(), c.Index())
+		}
+		if c.Parent() != e {
+			return fmt.Sprintf("child %d of <%s> has another parent", i, e.FullTag())
+		}
+		if ce, ok := c.(*etree.Element); ok {
+			if s := checkIndices(ce); s != "" {
+				return s
+			}
+		}
+	}
+	return ""
+}
+
+func modelSetText(e *tok, s string, cdata bool) {
+	end := 0
+	for end < len(e.kids) && e.kids[end].isChar() {
+		end++
+	}
+	k := kText
+	if cdata {
+		k = kCData
+	}
+	var repl []*tok
+	if s != "" {
+		repl = []*tok{{kind: k, data: s, parent: e, created: true}}
+	}
+	e.kids = append(e.kids[:0:0], append(append(append([]*tok{}, e.kids[:0]...), repl...), e.kids[end:]...)...)
+}
+
+func modelSetTail(e *tok, s string) {
+	p := e.parent
+	if p == nil {
+		return
+	}
+	i := e.index() + 1
+	end := i
+	for end < len(p.kids) && p.kids[end].isChar() {
+		end++
+	}
+	var repl []*tok
+	if s != "" {
+		repl = []*tok{{kind: kText, data: s, parent: p, created: true}}
+	}
+	rest := append([]*tok{}, p.kids[end:]...)
+	p.kids = append(append(p.kids[:i], repl...), rest...)
+}
+
+// leadingCommentBeforeText: a comment among the leading character data (etree/5).
+func leadingCommentBeforeText(e *tok) bool {
+	comment := false
+	for _, c := range e.kids {
+		switch {
+		case c.kind == kComment:
+			comment = true
+		case c.isChar():
+			if comment {
+				return true
+			}
+		default:
+			return false
+		}
+	}
+	return false
+}
+
+// TestHegelMutationsFollowTheModel: random sequences of AddChild, InsertChildAt, RemoveChildAt,
+// RemoveChild, Remove, SetText/SetCData/SetTail, CreateAttr/RemoveAttr/SortAttrs, SetRoot and
+// Copy keep the tree equal to the model, every child's Index and Parent right, Text/Tail,
+// siblings and attribute lookups as documented, and the tree writable and readable.
+func TestHegelMutationsFollowTheModel(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		m, _ := genDoc(ht, treeOpts{docTokens: true, wsText: true, maxDepth: 3, maxKids: 3})
+		d := build(m)
+		pr := &pairing{toE: map[*tok]etree.Token{}, toM: map[etree.Token]*tok{}}
+		pr.toE[m] = &d.Element
+		pr.toM[&d.Element] = m
+		pairUp(m, &d.Element, pr)
+		fresh := 0
+		newTok := func() *tok {
+			fresh++
+			var mt *tok
+			var et etree.Token
+			switch n(ht, 1, 4) {
+			case 1:
+				mt = elem(pick(ht, prefixes), pick(ht, tagNames))
+				et = etree.NewElement(mt.fullTag())
+			case 2:
+				s := genString(ht, strOpts{quotes: true})
+				mt = &tok{kind: kText, data: s, created: true}
+				et = etree.NewText(s)
+			case 3:
+				mt = &tok{kind: kComment, data: fmt.Sprint("c", fresh)}
+				et = etree.NewComment(mt.data)
+			default:
+				mt = &tok{kind: kPI, target: "t", data: fmt.Sprint("i", fresh)}
+				et = etree.NewProcInst("t", mt.data)
+			}
+			pr.toE[mt] = et
+			pr.toM[et] = mt
+			return mt
+		}
+		anyElem := func() *tok {
+			els := append([]*tok{m}, m.elements()...)
+			return pick(ht, els)
+		}
+		anyTok := func() *tok {
+			all := m.all()[1:]
+			if len(all) == 0 {
+				return nil
+			}
+			return pick(ht, all)
+		}
+		for step := n(ht, 1, 25); step > 0; step-- {
+			op := pick(ht, []string{"add", "add", "insert", "insert", "removeAt", "remove", "removeTok", "setText", "setText", "setCData", "setTail", "attr", "attr", "removeAttr", "sortAttrs", "setRoot", "copy", "siblings", "textTail"})
+			switch op {
+			case "add", "insert":
+				target := anyElem()
+				var tk *tok
+				if chance(ht, 40) {
+					tk = newTok()
+				} else {
+					tk = anyTok()
+					if tk == nil || (tk.kind == kElem && isAncestor(tk, target)) {
+						continue
+					}
+				}
+				et := pr.toE[tk]
+				te := pr.toE[target].(*etree.Element)
+				if op == "add" {
+					te.AddChild(et)
+					tk.detach()
+					target.add(tk)
+				} else {
+					i := n(ht, 0, len(target.kids)+1)
+					if chance(ht, 8) {
+						i = -1
+					}
+					if i < 0 && Known.negativeIndexPanics {
+						col.count("negative-gated")
+						continue
+					}
+					te.InsertChildAt(i, et)
+					j := i
+					if tk.parent == target && tk.index() < i {
+						j--
+					}
+					target.insertAt(j, tk)
+				}
+			case "removeAt":
+				target := anyElem()
+				te := pr.toE[target].(*etree.Element)
+				i := n(ht, 0, len(target.kids)+1)
+				if chance(ht, 8) {
+					i = -1
+				}
+				if i < 0 && Known.negativeIndexPanics {
+					col.count("negative-gated")
+					continue
+				}
+				got := te.RemoveChildAt(i)
+				if i < 0 || i >= len(target.kids) {
+					if got != nil {
+						col.fail(ht, "RemoveChildAt(%d) of %d children returned a token", i, len(target.kids))
+						return
+					}
+					continue
+				}
+				want := target.kids[i]
+				if got != pr.toE[want] {
+					col.fail(ht, "RemoveChildAt(%d) returned another token", i)
+					return
+				}
+				if got.Parent() != nil || got.Index() != -1 {
+					col.fail(ht, "removed token has parent %v index %d", got.Parent(), got.Index())
+					return
+				}
+				want.detach()
+			case "remove", "removeTok":
+				tk := anyTok()
+				if tk == nil {
+					continue
+				}
+				et := pr.toE[tk]
+				parent := pr.toE[tk.parent].(*etree.Element)
+				if op == "remove" {
+					other := pr.toE[anyElem()].(*etree.Element)
+					if chance(ht, 30) && other != parent {
+						if r := other.RemoveChild(et); r != nil {
+							col.fail(ht, "RemoveChild of a token that is not a child returned it")
+							return
+						}
+						continue
+					}
+					if r := parent.RemoveChild(et); r != et {
+						col.fail(ht, "RemoveChild returned %v", r)
+						return
+					}
+				} else if !et.Remove() {
+					col.fail(ht, "Remove() of a parented token returned false")
+					return
+				}
+				if et.Parent() != nil || et.Index() != -1 {
+					col.fail(ht, "removed token has parent %v index %d", et.Parent(), et.Index())
+					return
+				}
+				tk.detach()
+			case "setText", "setCData":
+				target := anyElem()
+				te := pr.toE[target].(*etree.Element)
+				s := genString(ht, strOpts{quotes: true, maxPieces: 3})
+				gated := Known.setTextIgnoresComments && leadingCommentBeforeText(target)
+				if op == "setText" {
+					te.SetText(s)
+				} else {
+					te.SetCData(s)
+				}
+				modelSetText(target, s, op == "setCData")
+				if !gated && te.Text() != s {
+					col.fail(ht, "%s(%q) then Text() = %q (children %s)", op, s, te.Text(), describe(target))
+					return
+				}
+				if gated {
+					col.count("settext-comment-gated")
+				}
+				// New CharData tokens: pair them up again below.
+			case "setTail":
+				tk := anyTok()
+				if tk == nil || tk.kind != kElem {
+					continue
+				}
+				te := pr.toE[tk].(*etree.Element)
+				s := genString(ht, strOpts{quotes: true, maxPieces: 3})
+				te.SetTail(s)
+				modelSetTail(tk, s)
+				if te.Tail() != s {
+					col.fail(ht, "SetTail(%q) then Tail() = %q", s, te.Tail())
+					return
+				}
+			case "attr":
+				target := anyElem()
+				if target == m {
+					continue
+				}
+				te := pr.toE[target].(*etree.Element)
+				a := attr{space: pick(ht, prefixes), key: pick(ht, attrKeys), val: genString(ht, strOpts{quotes: true, maxPieces: 3})}
+				te.CreateAttr(a.fullKey(), a.val)
+				found := false
+				for i := range target.attrs {
+					if target.attrs[i].space == a.space && target.attrs[i].key == a.key {
+						target.attrs[i].val = a.val
+						found = true
+					}
+				}
+				if !found {
+					target.attrs = append(target.attrs, a)
+				}
+				// SelectAttr with the full key finds it (an unprefixed key may find a prefixed
+				// attribute first: etree/10).
+				shadow := false
+				if a.space == "" {
+					for _, b := range target.attrs {
+						if b.key == a.key && b.space != "" {
+							shadow = true
+						}
+					}
+				}
+				if shadow && Known.prefixedAttrShadows {
+					col.count("attr-shadow-gated")
+				} else if v := te.SelectAttrValue(a.fullKey(), "\x00"); v != a.val {
+					col.fail(ht, "CreateAttr(%q, %q) then SelectAttrValue = %q (attrs %v)", a.fullKey(), a.val, v, target.attrs)
+					return
+				}
+			case "removeAttr":
+				target := anyElem()
+				if target == m || len(target.attrs) == 0 {
+					continue
+				}
+				te := pr.toE[target].(*etree.Element)
+				a := pick(ht, target.attrs)
+				got := te.RemoveAttr(a.fullKey())
+				if got == nil || got.Value != a.val || got.Space != a.space || got.Key != a.key {
+					col.fail(ht, "RemoveAttr(%q) = %+v, want %+v", a.fullKey(), got, a)
+					return
+				}
+				for i := range target.attrs {
+					if target.attrs[i].space == a.space && target.attrs[i].key == a.key {
+						target.attrs = append(target.attrs[:i], target.attrs[i+1:]...)
+						break
+					}
+				}
+				if te.RemoveAttr("nosuch:"+a.key) != nil {
+					col.fail(ht, "RemoveAttr of a missing attribute returned one")
+					return
+				}
+			case "sortAttrs":
+				target := anyElem()
+				te := pr.toE[target].(*etree.Element)
+				te.SortAttrs()
+				sort.SliceStable(target.attrs, func(i, j int) bool {
+					a, b := target.attrs[i], target.attrs[j]
+					if a.space != b.space {
+						return a.space < b.space
+					}
+					return a.key < b.key
+				})
+			case "setRoot":
+				var tk *tok
+				if chance(ht, 50) {
+					tk = newTok()
+					if tk.kind != kElem {
+						continue
+					}
+				} else {
+					tk = pick(ht, append([]*tok{elem("", "n")}, m.elements()...))
+					if tk.parent == nil {
+						pr.toE[tk] = etree.NewElement("n")
+						pr.toM[pr.toE[tk]] = tk
+					}
+				}
+				et := pr.toE[tk].(*etree.Element)
+				d.SetRoot(et)
+				tk.detach()
+				replaced := false
+				for i, k := range m.kids {
+					if k.kind == kElem {
+						m.kids[i] = tk
+						tk.parent = m
+						k.parent = nil
+						replaced = true
+						break
+					}
+				}
+				if !replaced {
+					m.add(tk)
+				}
+				if d.Root() != et {
+					col.fail(ht, "Root() after SetRoot is another element")
+					return
+				}
+			case "copy":
+				target := anyElem()
+				if target == m {
+					continue
+				}
+				te := pr.toE[target].(*etree.Element)
+				cp := te.Copy()
+				cd := etree.NewDocumentWithRoot(cp)
+				cm := norm(fromEtree(cd), true)
+				want := elem("", "")
+				want.add(target.clone())
+				if dd := diff(norm(want, true), cm, false, false, "copy"); dd != "" {
+					col.fail(ht, "Copy differs from the original: %s", dd)
+					return
+				}
+				if cp.Parent() != cd.Root().Parent() {
+					col.fail(ht, "copy's parent is not the new document")
+					return
+				}
+				cp2 := te.Copy()
+				if cp2.Parent() != nil {
+					col.fail(ht, "Copy() has a parent")
+					return
+				}
+				if !Known.copyKeepsIndex && cp2.Index() != -1 {
+					col.fail(ht, "Copy() has Index() %d without a parent", cp2.Index())
+					return
+				}
+				cp.CreateElement("added").CreateText("x")
+				cp.CreateAttr("added", "1")
+			case "siblings":
+				tk := anyTok()
+				if tk == nil || tk.kind != kElem {
+					continue
+				}
+				te := pr.toE[tk].(*etree.Element)
+				sibs := childElems(tk.parent)
+				i := 0
+				for sibs[i] != tk {
+					i++
+				}
+				var wantPrev, wantNext etree.Token
+				if i > 0 {
+					wantPrev = pr.toE[sibs[i-1]]
+				}
+				if i+1 < len(sibs) {
+					wantNext = pr.toE[sibs[i+1]]
+				}
+				if p := te.PrevSibling(); (p == nil) != (wantPrev == nil) || (p != nil && etree.Token(p) != wantPrev) {
+					col.fail(ht, "PrevSibling wrong")
+					return
+				}
+				if nx := te.NextSibling(); (nx == nil) != (wantNext == nil) || (nx != nil && etree.Token(nx) != wantNext) {
+					col.fail(ht, "NextSibling wrong")
+					return
+				}
+				if te.Index() != tk.index() {
+					col.fail(ht, "Index() = %d, model %d", te.Index(), tk.index())
+					return
+				}
+			case "textTail":
+				tk := anyTok()
+				if tk == nil || tk.kind != kElem {
+					continue
+				}
+				te := pr.toE[tk].(*etree.Element)
+				if te.Text() != tk.text() {
+					col.fail(ht, "Text() = %q, model %q (children %s)", te.Text(), tk.text(), describe(tk))
+					return
+				}
+				if te.Tail() != tk.tail() {
+					col.fail(ht, "Tail() = %q, model %q", te.Tail(), tk.tail())
+					return
+				}
+			}
+			if s := checkIndices(&d.Element); s != "" {
+				col.fail(ht, "after %s: %s", op, s)
+				return
+			}
+			got := fromEtree(d)
+			if dd := diff(m, got, false, false, "doc"); dd != "" {
+				col.fail(ht, "after %s the tree differs from the model: %s", op, dd)
+				return
+			}
+			// Re-pair (SetText/SetTail create tokens).
+			pr = &pairing{toE: map[*tok]etree.Token{}, toM: map[etree.Token]*tok{}}
+			pr.toE[m] = &d.Element
+			pr.toM[&d.Element] = m
+			pairUp(m, &d.Element, pr)
+		}
+		// The result writes and reads back.
+		out, err := d.WriteToString()
+		if err != nil {
+			col.fail(ht, "WriteToString: %v", err)
+			return
+		}
+		if Known.rawWhitespace && rawWSGated(m, d.WriteSettings, false) {
+			col.count("cr-gated")
+			return
+		}
+		d2 := etree.NewDocument()
+		d2.ReadSettings.PreserveCData = true
+		if err := d2.ReadFromString(out); err != nil {
+			col.fail(ht, "ReadFromString after mutations: %v\n%s", err, out)
+			return
+		}
+		if dd := diff(norm(expected(m, d.WriteSettings), true), norm(fromEtree(d2), true), false, false, "doc"); dd != "" {
+			col.fail(ht, "read(write) after mutations differs: %s\n%s", dd, out)
+			return
+		}
+		col.count("ok")
+	})
+}
+
+// --------------------------------------------------------------------------- indentation
+
+type indentOpts struct {
+	spaces                     int
+	tabs, crlf, preserveLeaf   bool
+	suppressTrailingWhitespace bool
+}
+
+func indentString(o indentOpts, depth int) string {
+	nl := "\n"
+	if o.crlf {
+		nl = "\r\n"
+	}
+	if o.tabs {
+		if depth < 0 {
+			return nl
+		}
+		return nl + strings.Repeat("\t", depth)
+	}
+	if o.spaces < 0 {
+		return ""
+	}
+	k := depth * o.spaces
+	if k < 0 {
+		return nl
+	}
+	return nl + strings.Repeat(" ", k)
+}
+
+func isWSTok(t *tok) bool { return t.kind == kText && !t.created }
+
+// modelIndent is the documented Indent: earlier indentation (whitespace-only text) is removed,
+// then every non-character child is put on a new line at its depth and the end tag on its own.
+func modelIndent(e *tok, depth int, o indentOpts) {
+	// strip
+	nws := 0
+	for _, c := range e.kids {
+		if isWSTok(c) {
+			nws++
+		}
+	}
+	if nws > 0 && !(nws == len(e.kids) && len(e.kids) == 1 && o.preserveLeaf) {
+		var kept []*tok
+		for _, c := range e.kids {
+			if !isWSTok(c) {
+				kept = append(kept, c)
+			}
+		}
+		e.kids = kept
+	}
+	if len(e.kids) == 0 {
+		return
+	}
+	old := e.kids
+	e.kids = nil
+	isChar, firstNon := false, true
+	for _, c := range old {
+		isChar = c.isChar()
+		if !isChar {
+			if !firstNon || depth > 0 {
+				if s := indentString(o, depth); s != "" {
+					e.add(&tok{kind: kText, data: s})
+				}
+			}
+			firstNon = false
+		}
+		e.add(c)
+		if c.kind == kElem {
+			modelIndent(c, depth+1, o)
+		}
+	}
+	if !isChar && (!firstNon || depth > 0) {
+		if s := indentString(o, depth-1); s != "" {
+			e.add(&tok{kind: kText, data: s})
+		}
+	}
+}
+
+// TestHegelIndentFollowsTheModel: on a parsed document, IndentWithSettings (spaces, tabs, CRLF,
+// PreserveLeafWhitespace, SuppressTrailingWhitespace) produces the modelled tree; the indented
+// document reads back to itself; Indent is idempotent; Unindent restores the whitespace-stripped
+// tree.
+func TestHegelIndentFollowsTheModel(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		m0, _ := genDoc(ht, treeOpts{docTokens: true, wsText: true, maxDepth: 4, maxKids: 4})
+		// Work on a parsed tree so that whitespace flags are the parser's (etree/4).
+		d0 := build(m0)
+		src, _ := d0.WriteToString()
+		d := etree.NewDocument()
+		d.ReadSettings.PreserveCData = true
+		if err := d.ReadFromString(src); err != nil {
+			col.fail(ht, "ReadFromString: %v", err)
+			return
+		}
+		m := norm(expected(m0, etree.WriteSettings{}), true)
+		for _, k := range m.all() {
+			if k.kind == kText {
+				k.created = !isWS(k.data)
+			}
+		}
+		o := indentOpts{spaces: n(ht, -1, 4), tabs: chance(ht, 25), crlf: chance(ht, 25), preserveLeaf: chance(ht, 30), suppressTrailingWhitespace: chance(ht, 30)}
+		is := etree.NewIndentSettings()
+		is.Spaces = o.spaces
+		is.UseTabs = o.tabs
+		is.UseCRLF = o.crlf
+		is.PreserveLeafWhitespace = o.preserveLeaf
+		is.SuppressTrailingWhitespace = o.suppressTrailingWhitespace
+		d.IndentWithSettings(is)
+		want := m.clone()
+		modelIndent(want, 0, o)
+		if o.suppressTrailingWhitespace {
+			for len(want.kids) > 0 && want.kids[len(want.kids)-1].isChar() && isWS(want.kids[len(want.kids)-1].data) {
+				want.kids = want.kids[:len(want.kids)-1]
+			}
+		}
+		got := fromEtree(d)
+		if dd := diff(norm(want, true), norm(got, true), false, false, "doc"); dd != "" {
+			out, _ := d.WriteToString()
+			col.fail(ht, "indent %+v differs from the model: %s\nsource %s\nindented %q", o, dd, src, out)
+			return
+		}
+		// idempotent
+		d.IndentWithSettings(is)
+		if dd := diff(norm(got, true), norm(fromEtree(d), true), false, false, "doc"); dd != "" {
+			col.fail(ht, "a second identical Indent changed the tree: %s", dd)
+			return
+		}
+		// reads back
+		out, _ := d.WriteToString()
+		d2 := etree.NewDocument()
+		d2.ReadSettings.PreserveCData = true
+		if err := d2.ReadFromString(out); err != nil {
+			col.fail(ht, "indented document does not read: %v\n%q", err, out)
+			return
+		}
+		if o.crlf {
+			// the parser normalises CRLF
+			for _, k := range got.all() {
+				if k.kind == kText || k.kind == kCData || k.kind == kComment || k.kind == kPI {
+					k.data = normCR(k.data)
+				}
+			}
+		}
+		if dd := diff(norm(got, true), norm(fromEtree(d2), true), false, false, "doc"); dd != "" {
+			col.fail(ht, "indented document reads back differently: %s\n%q", dd, out)
+			return
+		}
+		// Unindent strips every whitespace text.
+		d.Unindent()
+		stripped := m.clone()
+		modelIndent(stripped, 0, indentOpts{spaces: -1})
+		if dd := diff(norm(stripped, true), norm(fromEtree(d), true), false, false, "doc"); dd != "" {
+			col.fail(ht, "Unindent after Indent differs from the stripped tree: %s\n%q", dd, out)
+			return
+		}
+		col.count(fmt.Sprintf("spaces=%d", o.spaces))
+	})
+}
