+        kids.append(node(c))
+        if c.tail:
+            kids.append({"k": "t", "d": c.tail})
+    return {"k": "e", "tag": e.tag, "prefix": e.prefix or "",
+            "attrs": [[k, v] for k, v in e.attrib.items()], "kids": kids}
+
+def node(c):
+    if isinstance(c.tag, str):
+        return conv(c)
+    if c.tag is L.Comment:
+        return {"k": "c", "d": c.text or ""}
+    if c.tag is L.ProcessingInstruction:
+        return {"k": "p", "target": c.target, "d": c.text or ""}
+    return {"k": "?", "d": str(c.tag)}
+
+def parser():
+    return L.XMLParser(strip_cdata=True, resolve_entities=False, remove_comments=False,
+                       remove_pis=False, remove_blank_text=False, huge_tree=True)
+
+def parse(xml):
+    root = L.fromstring(xml.encode("utf-8"), parser())
+    tree = root.getroottree()
+    prevs = []
+    p = root.getprevious()
+    while p is not None:
+        prevs.append(node(p))
+        p = p.getprevious()
+    kids = list(reversed(prevs))
+    kids.append(conv(root))
+    n = root.getnext()
+    while n is not None:
+        kids.append(node(n))
+        n = n.getnext()
+    return {"doctype": tree.docinfo.doctype or "", "kids": kids}
+
+def xpath(xml, expr, ns, ctx):
+    root = L.fromstring(xml.encode("utf-8"), parser())
+    elems = [e for e in root.iter() if isinstance(e.tag, str)]
+    idx = {}
+    for i, e in enumerate(elems):
+        idx[e] = i
+    res = elems[ctx].xpath(expr, namespaces=ns or None)
+    out = set()
+    for e in res:
+        if isinstance(e, L._Element) and isinstance(e.tag, str):
+            out.add(idx[e])
+    return sorted(out)
+
+for line in sys.stdin:
+    req = json.loads(line)
+    try:
+        if req["cmd"] == "P":
+            rep = parse(req["xml"])
+        elif req["cmd"] == "X":
+            rep = {"ids": xpath(req["xml"], req["expr"], req.get("ns") or {}, req["ctx"])}
+        else:
+            rep = {"error": "unknown command"}
+    except Exception as ex:
+        rep = {"error": type(ex).__name__ + ": " + str(ex)}
+    sys.stdout.write(json.dumps(rep) + "\n")
+    sys.stdout.flush()
+`
+
+type pyChild struct {
+	mu  sync.Mutex
+	cmd *exec.Cmd
+	in  io.WriteCloser
+	out *bufio.Reader
+}
+
+var (
+	oracleOnce sync.Once
+	oracleInst *pyChild
+	oracleErr  error
+)
+
+func oracle(t testing.TB) *pyChild {
+	oracleOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pythonScript)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			oracleErr = err
+			return
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			oracleErr = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			oracleErr = err
+			return
+		}
+		oracleInst = &pyChild{cmd: cmd, in: in, out: bufio.NewReaderSize(out, 1<<20)}
+	})
+	if oracleErr != nil {
+		t.Fatalf("lxml oracle: %v", oracleErr)
+	}
+	return oracleInst
+}
+
+func (p *pyChild) ask(t testing.TB, req map[string]any, rep any) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	b, err := json.Marshal(req)
+	if err != nil {
+		t.Fatalf("oracle marshal: %v", err)
+	}
+	if _, err := p.in.Write(append(b, '\n')); err != nil {
+		t.Fatalf("oracle write: %v", err)
+	}
+	line, err := p.out.ReadBytes('\n')
+	if err != nil {
+		t.Fatalf("oracle read: %v", err)
+	}
+	if err := json.Unmarshal(line, rep); err != nil {
+		t.Fatalf("oracle reply %q: %v", line, err)
+	}
+}
+
+// lxmlNode is lxml's view of a node.
+type lxmlNode struct {
+	K      string     `json:"k"`
+	Tag    string     `json:"tag"`
+	Prefix string     `json:"prefix"`
+	Attrs  [][]string `json:"attrs"`
+	Kids   []lxmlNode `json:"kids"`
+	D      string     `json:"d"`
+	Target string     `json:"target"`
+}
+
+type lxmlDoc struct {
+	Doctype string     `json:"doctype"`
+	Kids    []lxmlNode `json:"kids"`
+	Error   string     `json:"error"`
+}
+
+func lxmlParse(t testing.TB, xml string) (*lxmlDoc, error) {
+	var rep lxmlDoc
+	oracle(t).ask(t, map[string]any{"cmd": "P", "xml": xml}, &rep)
+	if rep.Error != "" {
+		return nil, fmt.Errorf("%s", rep.Error)
+	}
+	return &rep, nil
+}
+
+func lxmlXPath(t testing.TB, xml, expr string, ns map[string]string, ctx int) ([]int, error) {
+	var rep struct {
+		IDs   []int  `json:"ids"`
+		Error string `json:"error"`
+	}
+	oracle(t).ask(t, map[string]any{"cmd": "X", "xml": xml, "expr": expr, "ns": ns, "ctx": ctx}, &rep)
+	if rep.Error != "" {
+		return nil, fmt.Errorf("%s", rep.Error)
+	}
+	return rep.IDs, nil
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..1f0e1d4
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,207 @@
+package etree_test
+
+// Pins: one plain test per recorded bug (bugs.toml). Each asserts the documented behaviour and
+// fails while the bug exists; the target lists them as expected failures.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/beevik/etree"
+)
+
+func noPanic(t *testing.T, what string, f func()) {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("%s panics: %v", what, r)
+		}
+	}()
+	f()
+}
+
+// etree/1: Remove() on a token without a parent panics; the documentation says it returns false.
+func TestHegelPinRemoveWithoutParentReturnsFalse(t *testing.T) {
+	noPanic(t, "NewElement(\"a\").Remove()", func() {
+		if etree.NewElement("a").Remove() {
+			t.Fatalf("Remove() of an unparented element returned true")
+		}
+	})
+	noPanic(t, "NewText(\"a\").Remove()", func() {
+		if etree.NewText("a").Remove() {
+			t.Fatalf("Remove() of an unparented text returned true")
+		}
+	})
+	noPanic(t, "NewComment(\"a\").Remove()", func() {
+		if etree.NewComment("a").Remove() {
+			t.Fatalf("Remove() of an unparented comment returned true")
+		}
+	})
+}
+
+// etree/2: RemoveChildAt and InsertChildAt with a negative index panic (RemoveChildAt documents
+// that an out-of-bounds index removes nothing and returns nil).
+func TestHegelPinNegativeIndexIsOutOfBounds(t *testing.T) {
+	e := etree.NewElement("a")
+	e.CreateElement("b")
+	noPanic(t, "RemoveChildAt(-1)", func() {
+		if r := e.RemoveChildAt(-1); r != nil {
+			t.Fatalf("RemoveChildAt(-1) returned %v", r)
+		}
+	})
+	noPanic(t, "InsertChildAt(-1, ...)", func() {
+		e.InsertChildAt(-1, etree.NewElement("c"))
+	})
+	if len(e.Child) != 2 {
+		t.Fatalf("after RemoveChildAt(-1) and InsertChildAt(-1): %d children", len(e.Child))
+	}
+}
+
+// etree/3: Copy() of a child element keeps the original's index although it has no parent.
+func TestHegelPinCopyHasNoIndex(t *testing.T) {
+	e := etree.NewElement("a")
+	e.CreateElement("b")
+	c := e.CreateElement("c")
+	cp := c.Copy()
+	if cp.Parent() != nil {
+		t.Fatalf("Copy() has a parent")
+	}
+	if cp.Index() != -1 {
+		t.Fatalf("Copy() of the child at index 1 has Index() %d without a parent, want -1", cp.Index())
+	}
+}
+
+// etree/4: a whitespace-only text created with NewText/CreateText/SetText is not IsWhitespace,
+// while the same text set with SetData or parsed is; Indent keeps the one and strips the other.
+func TestHegelPinWhitespaceTextIsWhitespace(t *testing.T) {
+	if !etree.NewText("  ").IsWhitespace() {
+		t.Errorf("NewText(\"  \").IsWhitespace() = false")
+	}
+	e := etree.NewElement("e")
+	if !e.CreateText("\n\t").IsWhitespace() {
+		t.Errorf("CreateText(\"\\n\\t\").IsWhitespace() = false")
+	}
+	x := etree.NewText("x")
+	x.SetData("  ")
+	if !x.IsWhitespace() {
+		t.Errorf("SetData(\"  \") then IsWhitespace() = false")
+	}
+	d := etree.NewDocument()
+	r := d.CreateElement("r")
+	r.CreateElement("a").CreateText("  ")
+	d.Indent(2)
+	created, _ := d.WriteToString()
+	d2 := etree.NewDocument()
+	d2.ReadFromString("<r><a>  </a></r>")
+	d2.Indent(2)
+	parsed, _ := d2.WriteToString()
+	if created != parsed {
+		t.Errorf("Indent of the same tree built (%q) and parsed (%q) differs", created, parsed)
+	}
+}
+
+// etree/5: Text() skips comments among the leading character data, SetText replaces only the
+// character data before the first comment.
+func TestHegelPinSetTextThenText(t *testing.T) {
+	e := etree.NewElement("e")
+	e.CreateText("a")
+	e.CreateComment("c")
+	e.CreateText("b")
+	if got := e.Text(); got != "ab" {
+		t.Fatalf("Text() = %q, want \"ab\" (comments are ignored)", got)
+	}
+	e.SetText("new")
+	if got := e.Text(); got != "new" {
+		t.Fatalf("SetText(\"new\") then Text() = %q", got)
+	}
+}
+
+// etree/6: [tag] keeps a candidate once per matching child, so a following [n] counts
+// duplicates: a[b][2] returns the first a when it has two b children.
+func TestHegelPinChildFilterKeepsEachCandidateOnce(t *testing.T) {
+	d := etree.NewDocument()
+	if err := d.ReadFromString(`<r><a id="1"><b/><b/></a><a id="2"><b/></a></r>`); err != nil {
+		t.Fatal(err)
+	}
+	got := d.Root().FindElements("./a[b][2]")
+	if len(got) != 1 || got[0].SelectAttrValue("id", "") != "2" {
+		var ids []string
+		for _, e := range got {
+			ids = append(ids, e.SelectAttrValue("id", "?"))
+		}
+		t.Fatalf("./a[b][2] selected ids %v, want [2]", ids)
+	}
+}
+
+// etree/7: [0] selects the first element although indices start from 1.
+func TestHegelPinZeroIndexSelectsNothing(t *testing.T) {
+	d := etree.NewDocument()
+	if err := d.ReadFromString(`<r><a>1</a><a>2</a></r>`); err != nil {
+		t.Fatal(err)
+	}
+	if got := d.Root().FindElements("./a[0]"); len(got) != 0 {
+		t.Fatalf("./a[0] selected %d elements (text %q), want none", len(got), got[0].Text())
+	}
+}
+
+// etree/8: a quoted filter value containing '[' does not compile.
+func TestHegelPinBracketInQuotedValueCompiles(t *testing.T) {
+	d := etree.NewDocument()
+	if err := d.ReadFromString(`<r><a x="["/><a x="]"/></r>`); err != nil {
+		t.Fatal(err)
+	}
+	p, err := etree.CompilePath(`./a[@x='[']`)
+	if err != nil {
+		t.Fatalf("CompilePath(\"./a[@x='[']\"): %v", err)
+	}
+	if got := d.Root().FindElementsPath(p); len(got) != 1 || got[0].SelectAttrValue("x", "") != "[" {
+		t.Fatalf("./a[@x='['] selected %d elements", len(got))
+	}
+}
+
+// etree/9: with the default WriteSettings a carriage return in text or an attribute value is
+// written raw and normalised away when the document is read back.
+func TestHegelPinCarriageReturnSurvivesARoundTrip(t *testing.T) {
+	d := etree.NewDocument()
+	r := d.CreateElement("r")
+	r.CreateAttr("a", "x\ry")
+	r.CreateText("a\rb")
+	s, _ := d.WriteToString()
+	d2 := etree.NewDocument()
+	if err := d2.ReadFromString(s); err != nil {
+		t.Fatal(err)
+	}
+	if got := d2.Root().Text(); got != "a\rb" {
+		t.Errorf("text %q written as %q reads back as %q", "a\rb", s, got)
+	}
+	if got := d2.Root().SelectAttrValue("a", ""); got != "x\ry" {
+		t.Errorf("attribute %q written as %q reads back as %q", "x\ry", s, got)
+	}
+}
+
+// etree/10: SelectAttr with an unprefixed key returns a prefixed attribute of that key that
+// precedes the unprefixed one.
+func TestHegelPinCreateAttrThenSelectAttr(t *testing.T) {
+	e := etree.NewElement("e")
+	e.CreateAttr("p:x", "1")
+	e.CreateAttr("x", "2")
+	if got := e.SelectAttrValue("x", ""); got != "2" {
+		t.Fatalf("CreateAttr(\"x\", \"2\") then SelectAttrValue(\"x\") = %q (attributes p:x=1 x=2)", got)
+	}
+}
+
+// etree/11: CDATA contents are not sanitised of forbidden characters, so the output cannot be
+// read back (text and attribute values get U+FFFD).
+func TestHegelPinCDataIsSanitised(t *testing.T) {
+	d := etree.NewDocument()
+	d.CreateElement("r").CreateCData("a\x01b")
+	s, _ := d.WriteToString()
+	d2 := etree.NewDocument()
+	d2.ReadSettings.PreserveCData = true
+	if err := d2.ReadFromString(s); err != nil {
+		t.Fatalf("etree cannot read its own output %q: %v", s, err)
+	}
+	if got := d2.Root().Text(); strings.ContainsRune(got, 1) {
+		t.Fatalf("the forbidden character survived: %q", got)
+	}
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..f2cc3b2
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,1288 @@
+package etree_test
+
+// Hegel property tests for beevik/etree, written for the Hegel zoo.
+// See targets/go/etree/README.md.
+//
+// Oracles: a model tree (elements with prefixes, attributes and namespace declarations, text,
+// CDATA, comments, processing instructions, a DOCTYPE) that is built through the etree API and
+// written by the harness in varied XML syntax; the documented semantics of the token API
+// (Text/Tail, Insert/Remove, Copy, Indent/Unindent, attributes, namespace resolution) and of
+// etree paths, evaluated on the model; and lxml (Python) as an independent XML parser for what
+// etree writes and as an XPath engine on the subset of paths both read alike.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current test
+// case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead of
+// failing (one long run lists every remaining shape at once).
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"unicode/utf8"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/beevik/etree"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+// collector counts the classes of every generated case and, in collect mode, records mismatches
+// instead of failing.
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if len(c.msgs) < 25 {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The properties avoid a shape while its switch is on;
+// the pins assert the correct behaviour and fail while the bug exists.
+var Known = struct {
+	// etree/1: Remove() on a token without a parent dereferences nil instead of returning false.
+	removeUnparentedPanics bool
+	// etree/2: RemoveChildAt and InsertChildAt with a negative index panic (RemoveChildAt
+	// documents "out of bounds ... nil is returned").
+	negativeIndexPanics bool
+	// etree/3: Copy() of a child token keeps the original's Index() although the copy has no
+	// parent (Index documents -1 then).
+	copyKeepsIndex bool
+	// etree/4: a whitespace-only CharData created with NewText/CreateText/SetText is not
+	// IsWhitespace, while the same text parsed or set with SetData is; Indent then keeps the one
+	// and strips the other.
+	whitespaceFlagByOrigin bool
+	// etree/5: Text() skips comments among the leading character data but SetText replaces only
+	// the character data before the first comment, so SetText(s); Text() != s.
+	setTextIgnoresComments bool
+	// etree/6: the [tag] and [tag='v'] filters keep a candidate once per matching child, so a
+	// following [n] filter counts duplicates (a[b][2] returns the first a when it has two b
+	// children).
+	childFilterDuplicates bool
+	// etree/7: the [0] filter selects the first element, like [1].
+	zeroIndexIsFirst bool
+	// etree/8: a quoted filter value containing '[' fails to compile.
+	bracketInQuotedValue bool
+	// etree/9: with the default WriteSettings a carriage return in text or an attribute value,
+	// and a tab or newline in an attribute value, are written raw and are normalised away by any
+	// XML parser (etree's own for the carriage return).
+	rawWhitespace bool
+	// etree/10: SelectAttr/SelectAttrValue with an unprefixed key return a prefixed attribute
+	// of that key that precedes the unprefixed one, so CreateAttr(k, v); SelectAttrValue(k) != v.
+	prefixedAttrShadows bool
+	// etree/11: CDATA (and comment and processing-instruction) contents are not sanitised of
+	// characters XML forbids, and the CDATA case makes the output unreadable by etree itself.
+	unsanitisedCData bool
+}{true, true, true, true, true, true, true, true, true, true, true}
+
+// --------------------------------------------------------------------------- model
+
+type kind int
+
+const (
+	kElem kind = iota
+	kText
+	kCData
+	kComment
+	kPI
+	kDirective
+)
+
+var kindNames = []string{"element", "text", "cdata", "comment", "pi", "directive"}
+
+type attr struct {
+	space, key, val string
+	uri             string // resolved namespace URI (filled by resolve)
+}
+
+// tok is a model token; the document is an element with an empty tag whose children are the
+// document-level tokens, like etree's Document.Element.
+type tok struct {
+	kind       kind
+	space, tag string
+	attrs      []attr
+	kids       []*tok
+	data       string // text, cdata, comment, directive, pi instruction
+	target     string // pi target
+	parent     *tok
+	uri        string // resolved namespace URI (filled by resolve)
+	created    bool   // whitespace text created through the API (etree/4)
+	dupAttr    int    // writeXML repeats this attribute (-1: none)
+}
+
+func elem(space, tag string) *tok { return &tok{kind: kElem, space: space, tag: tag, dupAttr: -1} }
+
+func (t *tok) add(c *tok) *tok {
+	c.parent = t
+	t.kids = append(t.kids, c)
+	return c
+}
+
+func (t *tok) clone() *tok {
+	c := *t
+	c.parent = nil
+	c.attrs = append([]attr(nil), t.attrs...)
+	c.kids = nil
+	for _, k := range t.kids {
+		c.add(k.clone())
+	}
+	return &c
+}
+
+func (t *tok) fullTag() string {
+	if t.space == "" {
+		return t.tag
+	}
+	return t.space + ":" + t.tag
+}
+
+func (a attr) fullKey() string {
+	if a.space == "" {
+		return a.key
+	}
+	return a.space + ":" + a.key
+}
+
+func (t *tok) isChar() bool { return t.kind == kText || t.kind == kCData }
+
+func (t *tok) isDoc() bool { return t.kind == kElem && t.tag == "" && t.parent == nil }
+
+// text models Element.Text: the character data after the opening tag, comments skipped.
+func (t *tok) text() string {
+	var b strings.Builder
+	for _, c := range t.kids {
+		switch {
+		case c.isChar():
+			b.WriteString(c.data)
+		case c.kind == kComment:
+		default:
+			return b.String()
+		}
+	}
+	return b.String()
+}
+
+// tail models Element.Tail: the character data after the end tag.
+func (t *tok) tail() string {
+	if t.parent == nil {
+		return ""
+	}
+	var b strings.Builder
+	for _, c := range t.parent.kids[t.index()+1:] {
+		if !c.isChar() {
+			break
+		}
+		b.WriteString(c.data)
+	}
+	return b.String()
+}
+
+func (t *tok) index() int {
+	if t.parent == nil {
+		return -1
+	}
+	for i, c := range t.parent.kids {
+		if c == t {
+			return i
+		}
+	}
+	return -1
+}
+
+func (t *tok) detach() {
+	if t.parent == nil {
+		return
+	}
+	p := t.parent
+	i := t.index()
+	p.kids = append(p.kids[:i], p.kids[i+1:]...)
+	t.parent = nil
+}
+
+func (t *tok) insertAt(i int, c *tok) {
+	c.detach()
+	if i >= len(t.kids) {
+		t.add(c)
+		return
+	}
+	c.parent = t
+	t.kids = append(t.kids, nil)
+	copy(t.kids[i+1:], t.kids[i:])
+	t.kids[i] = c
+}
+
+// resolveNS resolves a namespace prefix through the declarations on the element and its
+// ancestors ("" is the default namespace).
+func (t *tok) resolveNS(prefix string) string {
+	for e := t; e != nil; e = e.parent {
+		for _, a := range e.attrs {
+			if prefix == "" && a.space == "" && a.key == "xmlns" {
+				return a.val
+			}
+			if prefix != "" && a.space == "xmlns" && a.key == prefix {
+				return a.val
+			}
+		}
+	}
+	return ""
+}
+
+func (t *tok) resolve() {
+	if t.kind == kElem {
+		if t.tag != "" {
+			t.uri = t.resolveNS(t.space)
+		}
+		for i := range t.attrs {
+			if t.attrs[i].space == "" {
+				t.attrs[i].uri = ""
+			} else {
+				t.attrs[i].uri = t.resolveNS(t.attrs[i].space)
+			}
+		}
+	}
+	for _, c := range t.kids {
+		c.resolve()
+	}
+}
+
+// elements lists the elements in document order, the document itself excluded.
+func (t *tok) elements() []*tok {
+	var out []*tok
+	var walk func(*tok)
+	walk = func(e *tok) {
+		if e.kind != kElem {
+			return
+		}
+		if !e.isDoc() {
+			out = append(out, e)
+		}
+		for _, c := range e.kids {
+			walk(c)
+		}
+	}
+	walk(t)
+	return out
+}
+
+func (t *tok) depth() int {
+	d := 0
+	for _, c := range t.kids {
+		if c.kind == kElem {
+			if cd := c.depth() + 1; cd > d {
+				d = cd
+			}
+		}
+	}
+	return d
+}
+
+func (t *tok) all() []*tok {
+	out := []*tok{t}
+	for _, c := range t.kids {
+		out = append(out, c.all()...)
+	}
+	return out
+}
+
+func isAncestor(a, d *tok) bool {
+	for e := d; e != nil; e = e.parent {
+		if e == a {
+			return true
+		}
+	}
+	return false
+}
+
+func isWS(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if c := s[i]; c != ' ' && c != '\t' && c != '\n' && c != '\r' {
+			return false
+		}
+	}
+	return true
+}
+
+// --------------------------------------------------------------------------- text rules
+
+func validXMLChar(r rune) bool {
+	return r == 0x09 || r == 0x0A || r == 0x0D || r >= 0x20 && r <= 0xD7FF ||
+		r >= 0xE000 && r <= 0xFFFD || r >= 0x10000 && r <= 0x10FFFF
+}
+
+func hasInvalid(s string) bool {
+	for i := 0; i < len(s); {
+		r, w := utf8.DecodeRuneInString(s[i:])
+		if !validXMLChar(r) || (r == utf8.RuneError && w == 1) {
+			return true
+		}
+		i += w
+	}
+	return false
+}
+
+// fixInvalid is the documented sanitisation of text and attribute values: every character XML
+// forbids, and every invalid byte, becomes U+FFFD.
+func fixInvalid(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); {
+		r, w := utf8.DecodeRuneInString(s[i:])
+		if !validXMLChar(r) || (r == utf8.RuneError && w == 1) {
+			b.WriteRune(0xFFFD)
+		} else {
+			b.WriteString(s[i : i+w])
+		}
+		i += w
+	}
+	return b.String()
+}
+
+// normCR is the XML line-end normalisation every parser applies to literal carriage returns.
+func normCR(s string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(s, "\r\n", "\n"), "\r", "\n")
+}
+
+// attrWS is the attribute-value normalisation of a conforming parser: after the line-end
+// normalisation, tabs and newlines become spaces.
+func attrWS(s string) string {
+	return strings.NewReplacer("\t", " ", "\n", " ").Replace(normCR(s))
+}
+
+// sanComment: a space is inserted before a hyphen that follows a hyphen and after a trailing one.
+func sanComment(s string) string {
+	var b strings.Builder
+	hyphen := false
+	for i := 0; i < len(s); i++ {
+		if s[i] == '-' {
+			if hyphen {
+				b.WriteByte(' ')
+			}
+			hyphen = true
+		} else {
+			hyphen = false
+		}
+		b.WriteByte(s[i])
+	}
+	if hyphen {
+		b.WriteByte(' ')
+	}
+	return b.String()
+}
+
+// sanPI: "?>" becomes "? >".
+func sanPI(s string) string { return strings.ReplaceAll(s, "?>", "? >") }
+
+func hasAny(s, chars string) bool { return strings.ContainsAny(s, chars) }
+
+// --------------------------------------------------------------------------- generators
+
+var (
+	tagNames  = []string{"a", "b", "c", "d", "e", "r"}
+	attrKeys  = []string{"x", "y", "z", "id"}
+	prefixes  = []string{"", "", "", "p", "q"}
+	prefixURI = map[string]string{"p": "urn:p", "q": "urn:q", "": "urn:d"}
+	piTargets = []string{"t", "xml-stylesheet", "pi-2"}
+)
+
+// textPieces: the alphabet of text, attribute values, comments and instructions.
+var textPieces = []string{"a", "b", "Z", "0", " ", " ", "\t", "\n", "<", ">", "&", "'", "\"", "]]>", "]]", "--", "-",
+	"?>", "?", "é", "€", "\U0001F600", "&amp;", "&#60;", ";", "=", "/", "[", "]"}
+
+var badPieces = []string{"\x01", "\x00", "\x7f", "\xff", "\xc3", "\uFFFE", "\uFEFF"}
+
+type strOpts struct {
+	cr, invalid bool // allow carriage returns / forbidden characters
+	quotes      bool // allow quotes
+	maxPieces   int
+}
+
+func genString(tc hegel.TestCase, o strOpts) string {
+	mx := o.maxPieces
+	if mx == 0 {
+		mx = 6
+	}
+	k := n(tc, 0, mx)
+	var b strings.Builder
+	for i := 0; i < k; i++ {
+		switch {
+		case o.invalid && chance(tc, 15):
+			b.WriteString(pick(tc, badPieces))
+		case o.cr && chance(tc, 5):
+			b.WriteString(pick(tc, []string{"\r", "\r\n"}))
+		default:
+			p := pick(tc, textPieces)
+			if !o.quotes && (p == "'" || p == "\"") {
+				p = "q"
+			}
+			b.WriteString(p)
+		}
+	}
+	return b.String()
+}
+
+type treeOpts struct {
+	cr, invalid  bool // in text and attribute values
+	badCData     bool // forbidden characters in CDATA, comments, instructions
+	redeclare    bool // namespace redeclarations below the root
+	docTokens    bool // comments, instructions and a DOCTYPE at document level
+	wsText       bool // whitespace-only text tokens
+	maxDepth     int
+	maxKids      int
+	elementsOnly bool
+}
+
+type genState struct {
+	budget     int
+	redeclared bool
+	prefixes   map[string]bool
+}
+
+// genDoc generates a document model: comments/instructions around a single root element, which
+// declares the p and q prefixes (and sometimes a default namespace).
+func genDoc(tc hegel.TestCase, o treeOpts) (*tok, *genState) {
+	if o.maxDepth == 0 {
+		o.maxDepth = 4
+	}
+	if o.maxKids == 0 {
+		o.maxKids = 4
+	}
+	st := &genState{budget: n(tc, 1, 14), prefixes: map[string]bool{}}
+	doc := elem("", "")
+	if o.docTokens {
+		for i := n(tc, 0, 2); i > 0; i-- {
+			doc.add(genMisc(tc, o))
+		}
+		if chance(tc, 30) {
+			doc.add(&tok{kind: kDirective, data: "DOCTYPE r"})
+		}
+	}
+	root := doc.add(elem(pick(tc, prefixes), "r"))
+	root.attrs = append(root.attrs, attr{space: "xmlns", key: "p", val: "urn:p"}, attr{space: "xmlns", key: "q", val: "urn:q"})
+	if chance(tc, 30) {
+		root.attrs = append(root.attrs, attr{space: "", key: "xmlns", val: "urn:d"})
+	}
+	genAttrs(tc, root, o)
+	genKids(tc, root, 1, o, st)
+	if o.docTokens {
+		for i := n(tc, 0, 2); i > 0; i-- {
+			doc.add(genMisc(tc, o))
+		}
+	}
+	return doc, st
+}
+
+func genMisc(tc hegel.TestCase, o treeOpts) *tok {
+	so := strOpts{cr: o.cr, invalid: o.badCData, quotes: true}
+	if chance(tc, 50) {
+		return &tok{kind: kComment, data: genString(tc, so)}
+	}
+	inst := strings.TrimLeft(genString(tc, so), " \t\r\n")
+	return &tok{kind: kPI, target: pick(tc, piTargets), data: inst}
+}
+
+func genAttrs(tc hegel.TestCase, e *tok, o treeOpts) {
+	for i := n(tc, 0, 3); i > 0; i-- {
+		a := attr{space: pick(tc, prefixes), key: pick(tc, attrKeys)}
+		dup := false
+		for _, b := range e.attrs {
+			if b.space == a.space && b.key == a.key {
+				dup = true
+			}
+		}
+		if dup {
+			continue
+		}
+		a.val = genString(tc, strOpts{cr: o.cr, invalid: o.invalid, quotes: true, maxPieces: 4})
+		e.attrs = append(e.attrs, a)
+	}
+}
+
+func genKids(tc hegel.TestCase, e *tok, depth int, o treeOpts, st *genState) {
+	for i := n(tc, 0, o.maxKids); i > 0; i-- {
+		switch r := n(tc, 1, 100); {
+		case r <= 45 && depth < o.maxDepth && st.budget > 0:
+			st.budget--
+			c := e.add(elem(pick(tc, prefixes), pick(tc, tagNames)))
+			if o.redeclare && chance(tc, 10) {
+				st.redeclared = true
+				if chance(tc, 50) {
+					// distinct URIs per prefix: two prefixes on one URI would make p:y and q:y one attribute
+					px := pick(tc, []string{"p", "q"})
+					c.attrs = append(c.attrs, attr{space: "xmlns", key: px, val: pick(tc, []string{"urn:" + px + "2", "urn:" + px})})
+				} else {
+					c.attrs = append(c.attrs, attr{space: "", key: "xmlns", val: pick(tc, []string{"urn:d2", ""})})
+				}
+			}
+			genAttrs(tc, c, o)
+			genKids(tc, c, depth+1, o, st)
+		case o.elementsOnly:
+			if depth < o.maxDepth && st.budget > 0 {
+				st.budget--
+				c := e.add(elem("", pick(tc, tagNames)))
+				genKids(tc, c, depth+1, o, st)
+			}
+		case r <= 70:
+			s := genString(tc, strOpts{cr: o.cr, invalid: o.invalid, quotes: true})
+			if !o.wsText && isWS(s) {
+				s += "t"
+			}
+			e.add(&tok{kind: kText, data: s})
+		case r <= 82:
+			s := genString(tc, strOpts{cr: o.cr, invalid: o.badCData, quotes: true})
+			if s == "" {
+				s = "c"
+			}
+			e.add(&tok{kind: kCData, data: s})
+		default:
+			e.add(genMisc(tc, o))
+		}
+	}
+}
+
+// --------------------------------------------------------------------------- etree <-> model
+
+// build creates the etree document for a model through the public API.
+func build(m *tok) *etree.Document {
+	d := etree.NewDocument()
+	buildKids(&d.Element, m)
+	return d
+}
+
+func buildKids(e *etree.Element, m *tok) {
+	for _, c := range m.kids {
+		switch c.kind {
+		case kElem:
+			ce := e.CreateElement(c.fullTag())
+			for _, a := range c.attrs {
+				ce.CreateAttr(a.fullKey(), a.val)
+			}
+			buildKids(ce, c)
+		case kText:
+			e.CreateText(c.data)
+		case kCData:
+			e.CreateCData(c.data)
+		case kComment:
+			e.CreateComment(c.data)
+		case kPI:
+			e.CreateProcInst(c.target, c.data)
+		case kDirective:
+			e.CreateDirective(c.data)
+		}
+	}
+}
+
+// fromEtree reads an etree document into the model, with namespace URIs as etree resolves them
+// and the whitespace flags etree keeps.
+func fromEtree(d *etree.Document) *tok {
+	m := elem("", "")
+	fromEtreeKids(m, &d.Element)
+	return m
+}
+
+func fromEtreeKids(m *tok, e *etree.Element) {
+	for _, c := range e.Child {
+		switch c := c.(type) {
+		case *etree.Element:
+			t := m.add(elem(c.Space, c.Tag))
+			t.uri = c.NamespaceURI()
+			for i := range c.Attr {
+				a := &c.Attr[i]
+				t.attrs = append(t.attrs, attr{space: a.Space, key: a.Key, val: a.Value, uri: a.NamespaceURI()})
+			}
+			fromEtreeKids(t, c)
+		case *etree.CharData:
+			k := kText
+			if c.IsCData() {
+				k = kCData
+			}
+			m.add(&tok{kind: k, data: c.Data, created: !c.IsWhitespace()})
+		case *etree.Comment:
+			m.add(&tok{kind: kComment, data: c.Data})
+		case *etree.Directive:
+			m.add(&tok{kind: kDirective, data: c.Data})
+		case *etree.ProcInst:
+			m.add(&tok{kind: kPI, target: c.Target, data: c.Inst})
+		default:
+			m.add(&tok{kind: kDirective, data: fmt.Sprintf("unknown token %T", c)})
+		}
+	}
+}
+
+// norm puts a tree in the form a parse produces: adjacent character data of one kind merged,
+// empty character data dropped, CDATA turned into text when it is not preserved.
+func norm(t *tok, keepCData bool) *tok {
+	c := *t
+	c.parent = nil
+	c.attrs = append([]attr(nil), t.attrs...)
+	c.kids = nil
+	for _, k := range t.kids {
+		nk := norm(k, keepCData)
+		if nk.kind == kCData && !keepCData {
+			nk.kind = kText
+		}
+		if nk.isChar() && nk.data == "" {
+			continue
+		}
+		if l := len(c.kids); l > 0 && nk.isChar() && c.kids[l-1].kind == nk.kind {
+			c.kids[l-1].data += nk.data
+			continue
+		}
+		c.add(nk)
+	}
+	return &c
+}
+
+// expected transforms a model into what etree reads back from its own output under the given
+// write settings, CDATA preserved.
+func expected(t *tok, ws etree.WriteSettings) *tok {
+	c := *t
+	c.parent = nil
+	c.attrs = nil
+	for _, a := range t.attrs {
+		v := fixInvalid(a.val)
+		if !(ws.CanonicalAttrVal && !ws.AttrSingleQuote) {
+			v = normCR(v)
+		}
+		c.attrs = append(c.attrs, attr{space: a.space, key: a.key, val: v})
+	}
+	switch t.kind {
+	case kText:
+		c.data = fixInvalid(t.data)
+		if !ws.CanonicalText {
+			c.data = normCR(c.data)
+		}
+	case kCData:
+		c.data = normCR(t.data)
+	case kComment:
+		// encoding/xml hands comments over raw: no line-end normalisation.
+		c.data = sanComment(t.data)
+	case kPI:
+		c.data = sanPI(strings.TrimLeft(t.data, " \t\r\n"))
+		c.target = t.target
+	}
+	c.kids = nil
+	for _, k := range t.kids {
+		c.add(expected(k, ws))
+	}
+	return &c
+}
+
+// diff describes the first difference between two model trees, "" when they agree. Namespace
+// URIs are compared when checkURI is set; whitespace flags when checkWS is set.
+func diff(a, b *tok, checkURI, checkWS bool, path string) string {
+	if a.kind != b.kind {
+		return fmt.Sprintf("%s: %s vs %s", path, kindNames[a.kind], kindNames[b.kind])
+	}
+	switch a.kind {
+	case kElem:
+		if a.space != b.space || a.tag != b.tag {
+			return fmt.Sprintf("%s: tag %q vs %q", path, a.fullTag(), b.fullTag())
+		}
+		if checkURI && a.uri != b.uri {
+			return fmt.Sprintf("%s: namespace %q vs %q", path, a.uri, b.uri)
+		}
+		if len(a.attrs) != len(b.attrs) {
+			return fmt.Sprintf("%s: %d vs %d attributes (%v vs %v)", path, len(a.attrs), len(b.attrs), a.attrs, b.attrs)
+		}
+		for i := range a.attrs {
+			x, y := a.attrs[i], b.attrs[i]
+			if x.space != y.space || x.key != y.key || x.val != y.val || (checkURI && x.uri != y.uri) {
+				return fmt.Sprintf("%s: attribute %d %+v vs %+v", path, i, x, y)
+			}
+		}
+		if len(a.kids) != len(b.kids) {
+			return fmt.Sprintf("%s: %d vs %d children (%s vs %s)", path, len(a.kids), len(b.kids), describe(a), describe(b))
+		}
+		for i := range a.kids {
+			if d := diff(a.kids[i], b.kids[i], checkURI, checkWS, fmt.Sprintf("%s/%d", path, i)); d != "" {
+				return d
+			}
+		}
+	case kPI:
+		if a.target != b.target || a.data != b.data {
+			return fmt.Sprintf("%s: pi (%q,%q) vs (%q,%q)", path, a.target, a.data, b.target, b.data)
+		}
+	default:
+		if a.data != b.data {
+			return fmt.Sprintf("%s: %s %q vs %q", path, kindNames[a.kind], a.data, b.data)
+		}
+		if checkWS && a.kind == kText && a.created != b.created {
+			return fmt.Sprintf("%s: whitespace flag %v vs %v for %q", path, !a.created, !b.created, a.data)
+		}
+	}
+	return ""
+}
+
+func describe(t *tok) string {
+	var parts []string
+	for _, k := range t.kids {
+		switch k.kind {
+		case kElem:
+			parts = append(parts, "<"+k.fullTag()+">")
+		case kPI:
+			parts = append(parts, fmt.Sprintf("pi(%q)", k.target))
+		default:
+			parts = append(parts, fmt.Sprintf("%s(%q)", kindNames[k.kind], k.data))
+		}
+	}
+	return "[" + strings.Join(parts, " ") + "]"
+}
+
+// --------------------------------------------------------------------------- lxml view
+
+// view is the namespace-resolved, character-data-flattened shape of a tree: what lxml reports.
+type view struct {
+	kind   kind
+	tag    string // {uri}local or local
+	prefix string
+	attrs  [][2]string // {uri}key or key, value; declarations excluded
+	data   string
+	target string
+	kids   []*view
+}
+
+func viewOfModel(t *tok, ws etree.WriteSettings) *view {
+	v := &view{kind: t.kind, target: t.target}
+	switch t.kind {
+	case kElem:
+		v.tag = t.tag
+		v.prefix = t.space
+		if t.uri != "" {
+			v.tag = "{" + t.uri + "}" + t.tag
+		}
+		for _, a := range t.attrs {
+			if a.space == "xmlns" || (a.space == "" && a.key == "xmlns") {
+				continue
+			}
+			k := a.key
+			if a.space != "" {
+				k = "{" + a.uri + "}" + a.key
+			}
+			val := fixInvalid(a.val)
+			if ws.CanonicalAttrVal && !ws.AttrSingleQuote {
+				// character references keep every character
+			} else {
+				val = attrWS(val)
+			}
+			v.attrs = append(v.attrs, [2]string{k, val})
+		}
+		var text strings.Builder
+		flush := func() {
+			if text.Len() > 0 {
+				v.kids = append(v.kids, &view{kind: kText, data: text.String()})
+				text.Reset()
+			}
+		}
+		for _, k := range t.kids {
+			switch k.kind {
+			case kText:
+				s := fixInvalid(k.data)
+				if !ws.CanonicalText {
+					s = normCR(s)
+				}
+				text.WriteString(s)
+			case kCData:
+				text.WriteString(normCR(k.data))
+			default:
+				flush()
+				v.kids = append(v.kids, viewOfModel(k, ws))
+			}
+		}
+		flush()
+	case kComment:
+		v.data = normCR(sanComment(t.data))
+	case kPI:
+		v.data = normCR(sanPI(strings.TrimLeft(t.data, " \t\r\n")))
+	case kDirective:
+		v.data = t.data
+	}
+	return v
+}
+
+func viewOfLxml(nd *lxmlNode) *view {
+	switch nd.K {
+	case "e":
+		v := &view{kind: kElem, tag: nd.Tag, prefix: nd.Prefix}
+		for _, a := range nd.Attrs {
+			v.attrs = append(v.attrs, [2]string{a[0], a[1]})
+		}
+		for i := range nd.Kids {
+			v.kids = append(v.kids, viewOfLxml(&nd.Kids[i]))
+		}
+		return v
+	case "t":
+		return &view{kind: kText, data: nd.D}
+	case "c":
+		return &view{kind: kComment, data: nd.D}
+	case "p":
+		return &view{kind: kPI, target: nd.Target, data: nd.D}
+	}
+	return &view{kind: kDirective, data: "unknown lxml node " + nd.K + " " + nd.D}
+}
+
+func viewDiff(a, b *view, path string) string {
+	if a.kind != b.kind {
+		return fmt.Sprintf("%s: %s vs %s", path, kindNames[a.kind], kindNames[b.kind])
+	}
+	switch a.kind {
+	case kElem:
+		if a.tag != b.tag || a.prefix != b.prefix {
+			return fmt.Sprintf("%s: tag %s (prefix %q) vs %s (prefix %q)", path, a.tag, a.prefix, b.tag, b.prefix)
+		}
+		if len(a.attrs) != len(b.attrs) {
+			return fmt.Sprintf("%s: attributes %v vs %v", path, a.attrs, b.attrs)
+		}
+		for i := range a.attrs {
+			if a.attrs[i] != b.attrs[i] {
+				return fmt.Sprintf("%s: attribute %d %v vs %v", path, i, a.attrs[i], b.attrs[i])
+			}
+		}
+		if len(a.kids) != len(b.kids) {
+			return fmt.Sprintf("%s: %d vs %d children", path, len(a.kids), len(b.kids))
+		}
+		for i := range a.kids {
+			if d := viewDiff(a.kids[i], b.kids[i], fmt.Sprintf("%s/%d", path, i)); d != "" {
+				return d
+			}
+		}
+	default:
+		if a.data != b.data || a.target != b.target {
+			return fmt.Sprintf("%s: %s (%q,%q) vs (%q,%q)", path, kindNames[a.kind], a.target, a.data, b.target, b.data)
+		}
+	}
+	return ""
+}
+
+// lxmlDocView turns lxml's document into a view rooted at a document element.
+func lxmlDocView(ld *lxmlDoc) *view {
+	v := &view{kind: kElem}
+	for i := range ld.Kids {
+		v.kids = append(v.kids, viewOfLxml(&ld.Kids[i]))
+	}
+	return v
+}
+
+// docViewOfModel is the model's document view: directives are compared separately (lxml reports
+// the DOCTYPE through docinfo), so they are left out here.
+func docViewOfModel(m *tok, ws etree.WriteSettings) *view {
+	v := &view{kind: kElem}
+	for _, k := range m.kids {
+		if k.kind == kDirective {
+			continue
+		}
+		v.kids = append(v.kids, viewOfModel(k, ws))
+	}
+	return v
+}
+
+// --------------------------------------------------------------------------- write settings
+
+func genWriteSettings(tc hegel.TestCase) etree.WriteSettings {
+	return etree.WriteSettings{
+		CanonicalEndTags: chance(tc, 30),
+		CanonicalText:    chance(tc, 40),
+		CanonicalAttrVal: chance(tc, 40),
+		AttrSingleQuote:  chance(tc, 30),
+	}
+}
+
+// rawWSGated says whether the model has whitespace that the default escaping writes raw and a
+// parser normalises (etree/9): a carriage return in text or attribute values, a tab or newline
+// in attribute values (only lxml normalises those; strict is true for the lxml comparison).
+func rawWSGated(m *tok, ws etree.WriteSettings, strict bool) bool {
+	for _, t := range m.all() {
+		if t.kind == kText && !ws.CanonicalText && strings.Contains(t.data, "\r") {
+			return true
+		}
+		if t.kind == kElem && !(ws.CanonicalAttrVal && !ws.AttrSingleQuote) {
+			for _, a := range t.attrs {
+				if strings.Contains(a.val, "\r") || (strict && hasAny(a.val, "\t\n")) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+// --------------------------------------------------------------------------- properties
+
+// TestHegelWriteThenReadIsIdentity: a tree built through the API, written with any
+// WriteSettings and read back with PreserveCData, is the same tree up to the documented
+// sanitisation (forbidden characters to U+FFFD, comment hyphens, "?>" in instructions) and the
+// parser's line-end normalisation; without PreserveCData the CDATA sections become text; MaxDepth
+// is honoured exactly.
+func TestHegelWriteThenReadIsIdentity(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		m, _ := genDoc(ht, treeOpts{cr: true, invalid: true, redeclare: true, docTokens: true, wsText: true, badCData: !Known.unsanitisedCData})
+		ws := genWriteSettings(ht)
+		d := build(m)
+		d.WriteSettings = ws
+		out, err := d.WriteToString()
+		if err != nil {
+			col.fail(ht, "WriteToString: %v", err)
+			return
+		}
+		if Known.rawWhitespace && rawWSGated(m, ws, false) {
+			col.count("cr-gated")
+			return
+		}
+		keep := chance(ht, 70)
+		want := norm(expected(m, ws), keep)
+		want.resolve()
+		d2 := etree.NewDocument()
+		d2.ReadSettings.PreserveCData = keep
+		depth := m.depth()
+		if chance(ht, 30) {
+			d2.ReadSettings.MaxDepth = n(ht, 1, 6)
+		}
+		err = d2.ReadFromString(out)
+		if md := d2.ReadSettings.MaxDepth; md > 0 && depth > md {
+			if err != etree.ErrMaxDepth {
+				col.fail(ht, "ReadFromString of a depth-%d tree with MaxDepth %d: err = %v, want ErrMaxDepth\n%s", depth, md, err, out)
+			}
+			col.count("too-deep")
+			return
+		}
+		if err != nil {
+			col.fail(ht, "ReadFromString of etree's own output: %v\n%s", err, out)
+			return
+		}
+		got := fromEtree(d2)
+		if dd := diff(want, norm(got, true), true, false, "doc"); dd != "" {
+			col.fail(ht, "read(write(tree)) differs: %s\nsettings %+v preserveCData=%v\n%s", dd, ws, keep, out)
+			return
+		}
+		// Every whitespace-only text read back is flagged, nothing else is.
+		for _, k := range got.all() {
+			if k.kind == kText && k.created == isWS(k.data) {
+				col.fail(ht, "parsed text %q has IsWhitespace = %v", k.data, !k.created)
+				return
+			}
+		}
+		if keep {
+			col.count("cdata-kept")
+		} else {
+			col.count("cdata-flattened")
+		}
+	})
+}
+
+// TestHegelLxmlReadsTheOutput: lxml parses what etree writes (any WriteSettings) and sees the
+// model: resolved element and attribute namespaces, attribute values, character data, comments,
+// instructions and the DOCTYPE.
+func TestHegelLxmlReadsTheOutput(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		m, _ := genDoc(ht, treeOpts{cr: true, invalid: true, redeclare: true, docTokens: true, wsText: true, badCData: !Known.unsanitisedCData})
+		m.resolve()
+		ws := genWriteSettings(ht)
+		d := build(m)
+		d.WriteSettings = ws
+		out, err := d.WriteToString()
+		if err != nil {
+			col.fail(ht, "WriteToString: %v", err)
+			return
+		}
+		if Known.rawWhitespace && rawWSGated(m, ws, true) {
+			col.count("raw-ws-gated")
+			return
+		}
+		ld, err := lxmlParse(t, out)
+		if err != nil {
+			col.fail(ht, "lxml rejects etree's output: %v\nsettings %+v\n%s", err, ws, out)
+			return
+		}
+		wantDoctype := ""
+		for _, k := range m.kids {
+			if k.kind == kDirective {
+				wantDoctype = "<!" + k.data + ">"
+			}
+		}
+		if ld.Doctype != wantDoctype {
+			col.fail(ht, "lxml doctype %q, want %q\n%s", ld.Doctype, wantDoctype, out)
+			return
+		}
+		if dd := viewDiff(docViewOfModel(m, ws), lxmlDocView(ld), "doc"); dd != "" {
+			col.fail(ht, "lxml's tree differs from the model: %s\nsettings %+v\n%s", dd, ws, out)
+			return
+		}
+		col.count("ok")
+	})
+}
+
+// --------------------------------------------------------------------------- XML writer
+
+// writeXML serialises a model in varied but well-formed syntax: character and entity
+// references, attribute quotes and whitespace, empty-element or open/close tags.
+func writeXML(tc hegel.TestCase, m *tok) string {
+	var b strings.Builder
+	for _, k := range m.kids {
+		writeTok(tc, &b, k)
+	}
+	return b.String()
+}
+
+func escapeFor(tc hegel.TestCase, s string, quote byte, attrMode bool) string {
+	var b strings.Builder
+	for i := 0; i < len(s); {
+		r, w := utf8.DecodeRuneInString(s[i:])
+		i += w
+		switch {
+		case r == '<':
+			b.WriteString(pick(tc, []string{"&lt;", "&#60;", "&#x3C;", "&#x3c;"}))
+		case r == '&':
+			b.WriteString(pick(tc, []string{"&amp;", "&#38;", "&#x26;"}))
+		case r == '>':
+			b.WriteString(pick(tc, []string{"&gt;", "&#62;", "&gt;"}))
+		case r == '"' && (quote == '"' || chance(tc, 30)):
+			b.WriteString(pick(tc, []string{"&quot;", "&#34;"}))
+		case r == '\'' && (quote == '\'' || chance(tc, 30)):
+			b.WriteString(pick(tc, []string{"&apos;", "&#39;"}))
+		case attrMode && (r == '\t' || r == '\n' || r == '\r'):
+			b.WriteString(fmt.Sprintf("&#x%X;", r))
+		case r == '\r':
+			b.WriteString("&#xD;")
+		case r < 128 && chance(tc, 5):
+			b.WriteString(fmt.Sprintf("&#%d;", r))
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+var wsChoices = []string{" ", " ", "\t", "\n", "  ", "\r\n"}
+
+func writeAttr(tc hegel.TestCase, b *strings.Builder, a attr) {
+	b.WriteString(pick(tc, wsChoices))
+	b.WriteString(a.fullKey())
+	if chance(tc, 20) {
+		b.WriteString(pick(tc, wsChoices))
+	}
+	b.WriteByte('=')
+	if chance(tc, 20) {
+		b.WriteString(pick(tc, wsChoices))
+	}
+	q := byte('"')
+	if chance(tc, 40) {
+		q = '\''
+	}
+	b.WriteByte(q)
+	b.WriteString(escapeFor(tc, a.val, q, true))
+	b.WriteByte(q)
+}
+
+func writeTok(tc hegel.TestCase, b *strings.Builder, t *tok) {
+	switch t.kind {
+	case kElem:
+		b.WriteByte('<')
+		b.WriteString(t.fullTag())
+		for i, a := range t.attrs {
+			writeAttr(tc, b, a)
+			if i == t.dupAttr {
+				writeAttr(tc, b, attr{space: a.space, key: a.key, val: "dup"})
+			}
+		}
+		if chance(tc, 20) {
+			b.WriteString(pick(tc, wsChoices))
+		}
+		if len(t.kids) == 0 && chance(tc, 60) {
+			b.WriteString("/>")
+			return
+		}
+		b.WriteByte('>')
+		for _, k := range t.kids {
+			writeTok(tc, b, k)
+		}
+		b.WriteString("</")
+		b.WriteString(t.fullTag())
+		if chance(tc, 20) {
+			b.WriteString(pick(tc, wsChoices))
+		}
+		b.WriteByte('>')
+	case kText:
+		b.WriteString(escapeFor(tc, t.data, 0, false))
+	case kCData:
+		b.WriteString("<![CDATA[")
+		b.WriteString(strings.ReplaceAll(t.data, "]]>", "]]]]><![CDATA[>"))
+		b.WriteString("]]>")
+	case kComment:
+		b.WriteString("<!--")
+		b.WriteString(sanComment(t.data))
+		b.WriteString("-->")
+	case kPI:
+		b.WriteString("<?")
+		b.WriteString(t.target)
+		if t.data != "" {
+			b.WriteString(pick(tc, []string{" ", " ", "\t"}))
+			b.WriteString(sanPI(t.data))
+		}
+		b.WriteString("?>")
+	case kDirective:
+		b.WriteString("<!")
+		b.WriteString(t.data)
+		b.WriteByte('>')
+	}
+}
+
+// TestHegelParsesLikeLxml: the harness writes a model in varied well-formed syntax; etree
+// (PreserveCData) reads the model back, with the CDATA flags, the whitespace flags and the
+// namespaces the model resolves, and lxml reads the same document. Duplicate attributes
+// (lxml refuses them) follow PreserveDuplicateAttrs.
+func TestHegelParsesLikeLxml(t *testing.T) {
+	col := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		m, _ := genDoc(ht, treeOpts{redeclare: true, docTokens: true, wsText: true})
+		// Comments and instructions carry no escaping, so their text is kept to what survives.
+		for _, k := range m.all() {
+			switch k.kind {
+			case kComment:
+				k.data = sanComment(normCR(k.data))
+			case kPI:
+				k.data = sanPI(normCR(k.data))
+			case kCData:
+				k.data = normCR(k.data)
+			}
+		}
+		m.resolve()
+		// A duplicate attribute on the root (written right after the original, value "dup"):
+		// PreserveDuplicateAttrs keeps both in order, otherwise the last value wins in the first slot.
+		dupKeep := false
+		dup := false
+		root := m.elements()[0]
+		if chance(ht, 20) && len(root.attrs) > 2 {
+			dup = true
+			dupKeep = chance(ht, 50)
+			root.dupAttr = n(ht, 0, len(root.attrs)-1)
+		}
+		xml := writeXML(ht, m)
+		if dup {
+			a := root.attrs[root.dupAttr]
+			if dupKeep {
+				root.attrs = append(root.attrs[:root.dupAttr+1], append([]attr{{space: a.space, key: a.key, val: "dup"}}, root.attrs[root.dupAttr+1:]...)...)
+			} else {
+				root.attrs[root.dupAttr].val = "dup"
+			}
+			col.count("dup-attr")
+		}
+		d := etree.NewDocument()
+		d.ReadSettings.PreserveCData = true
+		d.ReadSettings.PreserveDuplicateAttrs = dupKeep
+		if err := d.ReadFromString(xml); err != nil {
+			col.fail(ht, "etree rejects well-formed XML: %v\n%s", err, xml)
+			return
+		}
+		got := fromEtree(d)
+		want := norm(m, true)
+		want.resolve()
+		for _, k := range want.all() {
+			if k.kind == kText {
+				k.created = !isWS(k.data)
+			}
+		}
+		if dd := diff(want, norm(got, true), true, true, "doc"); dd != "" {
+			col.fail(ht, "etree's tree differs from the model: %s\n%s", dd, xml)
+			return
+		}
+		if dup {
+			return
+		}
+		ld, err := lxmlParse(t, xml)
+		if err != nil {
+			col.fail(ht, "lxml rejects the harness's XML: %v\n%s", err, xml)
+			return
+		}
+		if dd := viewDiff(docViewOfModel(m, etree.WriteSettings{CanonicalText: true, CanonicalAttrVal: true}), lxmlDocView(ld), "doc"); dd != "" {
+			col.fail(ht, "lxml's tree differs from the model: %s\n%s", dd, xml)
+			return
+		}
+		col.count("ok")
+	})
+}
