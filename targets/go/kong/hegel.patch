+package hegel
+
+// The model: a replica of kong's scanner (scanner.go) and tracer (context.go) over the spec,
+// with the mappers of the fifteen kinds (mapper.go), taking the switch set (known) as a
+// value. With every switch off it states the documented behaviour (the README's grammar and
+// the design notes of the target README); with a switch on it reproduces the recorded bug
+// as a replica of kong's rule, transcribed at the point named beside the read. runExpected
+// is the property's model: the whole set of checked values for a case and a switch set.
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+// --------------------------------------------------------------------------- model: tokens
+
+const (
+	tUntyped = iota
+	tEOL
+	tFlag
+	tFlagValue
+	tShort
+	tShortTail
+	tPos
+)
+
+var hzTokTypeNames = [...]string{"untyped", "<EOL>", "long flag", "flag value", "short flag", "short flag remainder", "positional argument"}
+
+type mTok struct {
+	typ int
+	s   string
+}
+
+func (t mTok) String() string {
+	switch t.typ {
+	case tFlag:
+		return "--" + t.s
+	case tShort:
+		return "-" + t.s
+	case tEOL:
+		return "EOL"
+	}
+	return t.s
+}
+
+func (t mTok) inferred() int {
+	if t.typ != tUntyped {
+		return t.typ
+	}
+	switch {
+	case strings.HasPrefix(t.s, "--"):
+		return tFlag
+	case t.s == "-":
+		return tPos
+	case strings.HasPrefix(t.s, "-"):
+		return tShort
+	}
+	return tUntyped
+}
+
+func (t mTok) isValue() bool {
+	tt := t.inferred()
+	return tt == tFlagValue || tt == tShortTail || tt == tPos || (tt == tUntyped && !strings.HasPrefix(t.String(), "-"))
+}
+
+type mScan struct{ args []mTok }
+
+func (s *mScan) pop() mTok {
+	if len(s.args) == 0 {
+		return mTok{typ: tEOL}
+	}
+	t := s.args[0]
+	s.args = s.args[1:]
+	return t
+}
+
+func (s *mScan) peek() mTok {
+	if len(s.args) == 0 {
+		return mTok{typ: tEOL}
+	}
+	return s.args[0]
+}
+
+func (s *mScan) push(t mTok) { s.args = append([]mTok{t}, s.args...) }
+
+type mExpected struct {
+	context string
+	tok     mTok
+}
+
+func (e *mExpected) Error() string {
+	return fmt.Sprintf("expected %s value but got %q (%s)", e.context, e.tok.String(), hzTokTypeNames[e.tok.inferred()])
+}
+
+func (s *mScan) popValue(context string) (mTok, error) {
+	t := s.pop()
+	if !t.isValue() {
+		return t, &mExpected{context, t}
+	}
+	return t, nil
+}
+
+func (s *mScan) popWhileValue() []mTok {
+	var out []mTok
+	for s.peek().isValue() {
+		out = append(out, s.pop())
+	}
+	return out
+}
+
+type mUnknownFlag struct{ cause error }
+
+func (e *mUnknownFlag) Error() string { return e.cause.Error() }
+
+// --------------------------------------------------------------------------- model: values
+
+type mVal struct {
+	kind    int
+	b       bool
+	s       string
+	i       int64
+	u       uint64
+	f       float64
+	ss      []string
+	is      []int64
+	m       map[string]string
+	mi      map[string]int64
+	nonNil  bool // slices, maps and pointers: allocated
+	counted bool // counters: the traced value has been touched
+}
+
+func (v *mVal) clone() *mVal {
+	c := *v
+	c.ss = append([]string(nil), v.ss...)
+	c.is = append([]int64(nil), v.is...)
+	if v.m != nil {
+		c.m = map[string]string{}
+		for k, x := range v.m {
+			c.m[k] = x
+		}
+	}
+	if v.mi != nil {
+		c.mi = map[string]int64{}
+		for k, x := range v.mi {
+			c.mi[k] = x
+		}
+	}
+	return &c
+}
+
+func (v *mVal) format() string {
+	switch v.kind {
+	case kBool, kNegBool:
+		return strconv.FormatBool(v.b)
+	case kString, kEnum:
+		return strconv.Quote(v.s)
+	case kInt, kInt8, kCounter, kDuration:
+		return strconv.FormatInt(v.i, 10)
+	case kUint16:
+		return strconv.FormatUint(v.u, 10)
+	case kFloat:
+		return strconv.FormatFloat(v.f, 'g', -1, 64)
+	case kStrSlice:
+		if !v.nonNil {
+			return "nil"
+		}
+		var parts []string
+		for _, s := range v.ss {
+			parts = append(parts, strconv.Quote(s))
+		}
+		return "[" + strings.Join(parts, ",") + "]"
+	case kIntSlice:
+		if !v.nonNil {
+			return "nil"
+		}
+		var parts []string
+		for _, i := range v.is {
+			parts = append(parts, strconv.FormatInt(i, 10))
+		}
+		return "[" + strings.Join(parts, ",") + "]"
+	case kStrMap, kIntMap:
+		if !v.nonNil {
+			return "nil"
+		}
+		var parts []string
+		for k, x := range v.m {
+			parts = append(parts, strconv.Quote(k)+"="+strconv.Quote(x))
+		}
+		for k, x := range v.mi {
+			parts = append(parts, strconv.Quote(k)+"="+strconv.FormatInt(x, 10))
+		}
+		sort.Strings(parts)
+		return "{" + strings.Join(parts, ",") + "}"
+	case kPtrInt:
+		if !v.nonNil {
+			return "nil"
+		}
+		return strconv.FormatInt(v.i, 10)
+	}
+	return "?"
+}
+
+// --------------------------------------------------------------------------- model: decoding
+
+func mParseBool(t mTok) (bool, error) {
+	switch strings.ToLower(t.s) {
+	case "true", "1", "yes":
+		return true, nil
+	case "false", "0", "no":
+		return false, nil
+	}
+	return false, fmt.Errorf("bool value must be true, 1, yes, false, 0 or no but got %q", strings.ToLower(t.s))
+}
+
+// mTranscode is what Scanner.PopValueInto does to a string on its way into the target
+// (mapper.go jsonTranscode: json.Marshal then json.Unmarshal): every byte that is not valid
+// UTF-8 becomes U+FFFD. Only the byte-split short of kong/1 (mSplitShort) makes such a byte,
+// landing in a passthrough positional or a value.
+func mTranscode(s string) string {
+	if utf8.ValidString(s) {
+		return s
+	}
+	var b strings.Builder
+	for i := 0; i < len(s); {
+		r, size := utf8.DecodeRuneInString(s[i:])
+		if r == utf8.RuneError && size == 1 {
+			b.WriteRune(utf8.RuneError)
+		} else {
+			b.WriteString(s[i : i+size])
+		}
+		i += size
+	}
+	return b.String()
+}
+
+// mSplitEscaped is kong.SplitEscaped.
+func mSplitEscaped(s string, sep rune) (out []string) {
+	escaped := false
+	token := ""
+	for i, ch := range s {
+		switch {
+		case escaped:
+			if ch != sep {
+				token += `\`
+			}
+			token += string(ch)
+			escaped = false
+		case ch == '\\' && i < len(s)-1:
+			escaped = true
+		case ch == sep && !escaped:
+			out = append(out, token)
+			token = ""
+			escaped = false
+		default:
+			token += string(ch)
+		}
+	}
+	if token != "" {
+		out = append(out, token)
+	}
+	return
+}
+
+func mDecodeInt(scan *mScan, bits int) (int64, error) {
+	t, err := scan.popValue("int")
+	if err != nil {
+		return 0, err
+	}
+	n, err := strconv.ParseInt(t.s, 0, bits)
+	if err != nil {
+		return 0, fmt.Errorf("expected a valid %d bit int but got %q", bits, t.s)
+	}
+	return n, nil
+}
+
+// mDecode is the mapper of the kind over the scanner, writing into target.
+func mDecode(v *hzVal, kind int, scan *mScan, target *mVal, k known) error {
+	switch kind {
+	case kBool, kNegBool:
+		if scan.peek().typ == tFlagValue {
+			b, err := mParseBool(scan.pop())
+			if err != nil {
+				return err
+			}
+			target.b = b
+		} else {
+			target.b = true
+		}
+	case kString, kEnum:
+		t, err := scan.popValue("string")
+		if err != nil {
+			return err
+		}
+		target.s = mTranscode(t.s)
+	case kInt, kCounter:
+		n, err := mDecodeInt(scan, 64)
+		if err != nil {
+			return err
+		}
+		target.i = n
+	case kPtrInt:
+		n, err := mDecodeInt(scan, 64)
+		if err != nil {
+			return err
+		}
+		target.i = n
+		target.nonNil = true
+	case kInt8:
+		n, err := mDecodeInt(scan, 8)
+		if err != nil {
+			return err
+		}
+		target.i = n
+	case kUint16:
+		t, err := scan.popValue("uint")
+		if err != nil {
+			return err
+		}
+		n, err := strconv.ParseUint(t.s, 0, 16)
+		if err != nil {
+			return fmt.Errorf("expected a valid 16 bit uint but got %q", t.s)
+		}
+		target.u = n
+	case kFloat:
+		t, err := scan.popValue("float")
+		if err != nil {
+			return err
+		}
+		n, err := strconv.ParseFloat(t.s, 64)
+		if err != nil {
+			return fmt.Errorf("expected a float but got %q (string)", t.String())
+		}
+		target.f = n
+	case kDuration:
+		t, err := scan.popValue("duration")
+		if err != nil {
+			return err
+		}
+		d, err := time.ParseDuration(t.s)
+		if err != nil {
+			return fmt.Errorf("expected duration but got %q: %v", t.s, err)
+		}
+		target.i = int64(d)
+	case kStrSlice, kIntSlice:
+		var child *mScan
+		if !v.pos {
+			t := scan.pop()
+			if t.typ == tEOL {
+				return fmt.Errorf("missing value, expecting \"<arg>,...\"")
+			}
+			child = &mScan{}
+			for _, part := range mSplitEscaped(t.s, ',') {
+				child.args = append(child.args, mTok{t.typ, part})
+			}
+		} else {
+			child = &mScan{args: mPopPositionalValues(scan, k)}
+		}
+		for child.peek().typ != tEOL {
+			if kind == kStrSlice {
+				t, err := child.popValue("string")
+				if err != nil {
+					return err
+				}
+				target.ss = append(target.ss, mTranscode(t.s))
+			} else {
+				n, err := mDecodeInt(child, 64)
+				if err != nil {
+					return err
+				}
+				target.is = append(target.is, n)
+			}
+		}
+	case kStrMap, kIntMap:
+		target.nonNil = true
+		if kind == kStrMap && target.m == nil {
+			target.m = map[string]string{}
+		}
+		if kind == kIntMap && target.mi == nil {
+			target.mi = map[string]int64{}
+		}
+		var child *mScan
+		if !v.pos {
+			t := scan.pop()
+			if t.typ == tEOL {
+				return fmt.Errorf("missing value, expecting \"<key>=<value>;...\"")
+			}
+			child = &mScan{}
+			for _, part := range mSplitEscaped(t.s, ';') {
+				child.args = append(child.args, mTok{t.typ, part})
+			}
+		} else {
+			child = &mScan{args: mPopPositionalValues(scan, k)}
+		}
+		for child.peek().typ != tEOL {
+			t, err := child.popValue("map")
+			if err != nil {
+				return err
+			}
+			parts := strings.SplitN(mTranscode(t.s), "=", 2)
+			if len(parts) != 2 {
+				return fmt.Errorf("expected \"<key>=<value>\" but got %q", mTranscode(t.s))
+			}
+			if kind == kStrMap {
+				target.m[parts[0]] = parts[1]
+			} else {
+				n, err := strconv.ParseInt(parts[1], 0, 64)
+				if err != nil {
+					return fmt.Errorf("invalid map value %q", parts[1])
+				}
+				target.mi[parts[0]] = n
+			}
+		}
+	}
+	return nil
+}
+
+// mPopPositionalValues pops the values of a cumulative positional argument. With
+// kDashDashStopsCumulative on (kong/4) they end at a "--", as the slice and map decoders do
+// (mapper.go sliceDecoder and mapDecoder: "PopWhile(func(t Token) bool { return t.IsValue()
+// })", which stops at the untyped "--"), which then ends the parsing with the rest
+// unexpected; as documented "--" ends the parsing and the rest is appended.
+func mPopPositionalValues(scan *mScan, k known) []mTok {
+	out := scan.popWhileValue()
+	if !k[kDashDashStopsCumulative] && scan.peek().typ == tUntyped && scan.peek().s == "--" {
+		scan.pop()
+		scan.endParsing()
+		out = append(out, scan.popWhileValue()...)
+	}
+	return out
+}
+
+// mDecodeValue is Value.Parse's decode for the kind: the counter mapper, else mDecode. With
+// kCounterIgnoresDefault on (kong/6) an increment starts from the traced zero (mapper.go
+// counterMapper: "target.SetInt(target.Int() + 1)" on the value Context.getValue made
+// fresh); as documented from the default value.
+func mDecodeValue(v *hzVal, scan *mScan, target *mVal, k known) error {
+	if v.kind == kCounter {
+		if !k[kCounterIgnoresDefault] && !target.counted && v.hasDef && !v.pos {
+			// As documented an increment starts from the default value.
+			target.counted = true
+			if n, err := strconv.ParseInt(v.def, 10, 64); err == nil {
+				target.i = n
+			}
+		}
+		target.counted = true
+		if scan.peek().typ == tFlagValue {
+			t, err := scan.popValue("counter")
+			if err != nil {
+				return err
+			}
+			n, err := strconv.ParseInt(t.s, 10, 64)
+			if err != nil {
+				return fmt.Errorf("expected a counter but got %q (string)", t.String())
+			}
+			target.i = n
+			return nil
+		}
+		target.i++
+		return nil
+	}
+	return mDecode(v, v.kind, scan, target, k)
+}
+
+// --------------------------------------------------------------------------- model: the parse
+
+type mPath struct {
+	node  *hzNode // command entries
+	flag  *hzVal
+	pos   *hzVal
+	flags []*hzVal
+}
+
+type mCtx struct {
+	root   *hzNode
+	scan   *mScan
+	values map[*hzVal]*mVal
+	set    map[*hzVal]bool // Value.Set: parsed from the command line or from a default
+	given  map[*hzVal]bool // parsed from the command line
+	path   []mPath
+	peers  map[*hzVal][]*hzVal
+	k      known
+}
+
+// isSetXor is what the xor (and lastwins) group checks count as a flag in use: with
+// kDefaultsCountInXor on (kong/2) a flag with a default counts (context.go
+// checkXorDuplicates reads flag.Set, which Context.Reset set through Value.Parse; and
+// checkMissingFlags' "if flag.Set { choiceGroupSet[group] = true }"); as documented only a
+// flag given on the command line. isSetAnd is the same for the and groups under
+// kDefaultsCountInAnd (kong/3; checkAndMissing reads flag.Set).
+func (c *mCtx) isSetXor(f *hzVal) bool {
+	if c.k[kDefaultsCountInXor] {
+		return c.set[f]
+	}
+	return c.given[f]
+}
+
+func (c *mCtx) isSetAnd(f *hzVal) bool {
+	if c.k[kDefaultsCountInAnd] {
+		return c.set[f]
+	}
+	return c.given[f]
+}
+
+func (c *mCtx) getValue(v *hzVal) *mVal {
+	x, ok := c.values[v]
+	if !ok {
+		x = &mVal{kind: v.kind}
+		switch {
+		case v.isSlice(), v.isMap(), v.kind == kPtrInt:
+			x.nonNil = true
+		}
+		if v.kind == kStrMap {
+			x.m = map[string]string{}
+		}
+		if v.kind == kIntMap {
+			x.mi = map[string]int64{}
+		}
+		c.values[v] = x
+	}
+	return x
+}
+
+// parseValue is Value.Parse into the traced value.
+func (c *mCtx) parseValue(v *hzVal, scan *mScan) error {
+	if err := mDecodeValue(v, scan, c.getValue(v), c.k); err != nil {
+		return fmt.Errorf("%s: %w", v.shortSummary(), err)
+	}
+	c.set[v] = true
+	c.given[v] = true
+	return nil
+}
+
+func (c *mCtx) endParsing() { c.scan.endParsing() }
+
+func (s *mScan) endParsing() {
+	var args []string
+	for {
+		t := s.pop()
+		if t.typ == tEOL {
+			break
+		}
+		args = append(args, t.String())
+	}
+	for i := range args {
+		s.push(mTok{tPos, args[len(args)-1-i]})
+	}
+}
+
+// mSplitShort cuts the head of a short-flag token (the text after the dash, or a short-flag
+// remainder) from its tail. With kShortSplitsByBytes on (kong/1) the head is the first BYTE
+// (context.go trace: "c.scan.PushTyped(v[1:2], ShortFlagToken)" with the tail "v[2:]", and
+// for a remainder "token.String()[0:1]" with the tail "[1:]"), so a multi-byte rune is cut in
+// two and the flag looked up is "-" plus its first byte; as documented the head is the first
+// rune (Tag.GetRune accepts any rune as a short and parseFlag matches "-" + string(Short)).
+func mSplitShort(s string, k known) (head, tail string) {
+	if k[kShortSplitsByBytes] {
+		return s[:1], s[1:]
+	}
+	_, size := utf8.DecodeRuneInString(s)
+	return s[:size], s[size:]
+}
+
+// mLevenshtein is kong's levenshtein.
+func mLevenshtein(a, b string) int {
+	f := make([]int, utf8.RuneCountInString(b)+1)
+	for j := range f {
+		f[j] = j
+	}
+	for _, ca := range a {
+		j := 1
+		fj1 := f[0]
+		f[0]++
+		for _, cb := range b {
+			mn := min(f[j]+1, f[j-1]+1)
+			if cb != ca {
+				mn = min(mn, fj1+1)
+			} else {
+				mn = min(mn, fj1)
+			}
+			fj1, f[j] = f[j], mn
+			j++
+		}
+	}
+	return f[len(f)-1]
+}
+
+// mCandidates is findPotentialCandidates: the "did you mean" suggestions, the candidates
+// with the needle as prefix or within Levenshtein distance 2 (over runes: a needle holding
+// the first byte of a cut rune ranges as "-" and U+FFFD, two runes, so every candidate of
+// three runes or fewer is within 2 and every short starting with the same byte is a prefix
+// match).
+func mCandidates(needle string, haystack []string, prefix string) error {
+	if len(haystack) == 0 {
+		return errors.New(prefix)
+	}
+	var closest []string
+	for _, c := range haystack {
+		if strings.HasPrefix(c, needle) || mLevenshtein(c, needle) <= 2 {
+			closest = append(closest, fmt.Sprintf("%q", c))
+		}
+	}
+	if len(closest) == 1 {
+		return fmt.Errorf("%s, did you mean %s?", prefix, closest[0])
+	} else if len(closest) > 1 {
+		return fmt.Errorf("%s, did you mean one of %s?", prefix, strings.Join(closest, ", "))
+	}
+	return errors.New(prefix)
+}
+
+func (c *mCtx) parseFlag(flags []*hzVal, match string) error {
+	var candidates []string
+	for _, f := range flags {
+		long := "--" + f.name
+		matched := long == match
+		candidates = append(candidates, long)
+		if f.short != 0 {
+			short := "-" + string(f.short)
+			matched = matched || short == match
+			candidates = append(candidates, short)
+		}
+		for _, a := range f.aliases {
+			af := "--" + a
+			if utf8.RuneCountInString(a) == 1 {
+				af = "-" + a
+			}
+			matched = matched || af == match
+			candidates = append(candidates, af)
+		}
+		neg := f.negName()
+		if !matched && match != neg {
+			continue
+		}
+		c.scan.pop()
+		if match == neg && f.negation != "" {
+			nv := true
+			if c.scan.peek().typ == tFlagValue {
+				t, err := c.scan.popValue("bool")
+				if err != nil {
+					return err
+				}
+				nv, err = mParseBool(t)
+				if err != nil {
+					return err
+				}
+			}
+			c.scan.push(mTok{tFlagValue, strconv.FormatBool(!nv)})
+		}
+		for _, peer := range c.peers[f] {
+			c.set[peer] = false
+			c.given[peer] = false
+			delete(c.values, peer)
+		}
+		if err := c.parseValue(f, c.scan); err != nil {
+			var ee *mExpected
+			if errors.As(err, &ee) && (ee.tok.inferred() == tFlag || ee.tok.inferred() == tShort) {
+				return fmt.Errorf("%s; perhaps try %s=%q?", err.Error(), f.shortSummary(), ee.tok.String())
+			}
+			return err
+		}
+		c.path = append(c.path, mPath{flag: f})
+		return nil
+	}
+	return &mUnknownFlag{mCandidates(match, candidates, "unknown flag "+match)}
+}
+
+// trace is Context.trace.
+func (c *mCtx) trace(node *hzNode) error {
+	positional := 0
+	flagNode := node
+	if node.defaultCmd != nil && node.defaultCmd.def == 2 {
+		flagNode = node.defaultCmd
+	}
+	flags := mAllFlags(flagNode)
+	if node.passthrough {
+		c.endParsing()
+	}
+	for c.scan.peek().typ != tEOL {
+		tok := c.scan.peek()
+		switch tok.typ {
+		case tUntyped:
+			v := tok.s
+			switch {
+			case v == "-":
+				c.scan.pop()
+				c.scan.push(mTok{tPos, v})
+			case v == "--":
+				c.endParsing()
+				if !(positional < len(node.pos) && node.pos[positional].passMode != 0) {
+					c.scan.pop()
+				}
+			case strings.HasPrefix(v, "--"):
+				c.scan.pop()
+				parts := strings.SplitN(v[2:], "=", 2)
+				if len(parts) > 1 {
+					c.scan.push(mTok{tFlagValue, parts[1]})
+				}
+				c.scan.push(mTok{tFlag, parts[0]})
+			case strings.HasPrefix(v, "-"):
+				c.scan.pop()
+				head, tail := mSplitShort(v[1:], c.k)
+				if tail != "" {
+					c.scan.push(mTok{tShortTail, tail})
+				}
+				c.scan.push(mTok{tShort, head})
+			default:
+				c.scan.pop()
+				c.scan.push(mTok{tPos, v})
+			}
+		case tShortTail:
+			c.scan.pop()
+			head, tail := mSplitShort(tok.String(), c.k)
+			if tail != "" {
+				c.scan.push(mTok{tShortTail, tail})
+			}
+			c.scan.push(mTok{tShort, head})
+		case tFlag, tShort:
+			if err := c.parseFlag(flags, tok.String()); err != nil {
+				var unknown *mUnknownFlag
+				if errors.As(err, &unknown) && positional < len(node.pos) && node.pos[positional].passMode == 1 {
+					c.scan.pop()
+					c.scan.push(mTok{tPos, tok.String()})
+				} else {
+					return err
+				}
+			}
+		case tFlagValue:
+			return fmt.Errorf("unexpected flag argument %q", tok.s)
+		case tPos:
+			if positional < len(node.pos) {
+				arg := node.pos[positional]
+				if arg.passMode != 0 {
+					c.endParsing()
+				}
+				if err := c.parseValue(arg, c.scan); err != nil {
+					return err
+				}
+				c.path = append(c.path, mPath{pos: arg})
+				positional++
+				continue
+			}
+			cmds := map[string]bool{}
+			for _, br := range node.children {
+				cmds[br.name] = true
+			}
+			val := tok.s
+		aliases:
+			for _, br := range node.children {
+				for _, a := range br.aliases {
+					if val == a && !cmds[a] {
+						val = br.name
+						break aliases
+					}
+				}
+			}
+			var candidates []string
+			for _, br := range node.children {
+				if !br.hidden {
+					candidates = append(candidates, br.name)
+				}
+				if br.name == val {
+					c.scan.pop()
+					c.path = append(c.path, mPath{node: br, flags: br.flags})
+					return c.trace(br)
+				}
+			}
+			if node.defaultCmd != nil && node.defaultCmd.def == 2 {
+				c.path = append(c.path, mPath{node: node.defaultCmd, flags: node.defaultCmd.flags})
+				return c.trace(node.defaultCmd)
+			}
+			return mCandidates(tok.String(), candidates, "unexpected argument "+tok.String())
+		}
+	}
+	if node.defaultCmd != nil {
+		c.path = append(c.path, mPath{node: node.defaultCmd, flags: node.defaultCmd.flags})
+	}
+	return nil
+}
+
+func mVisitValues(n *hzNode, fn func(*hzVal)) {
+	for _, f := range n.flags {
+		fn(f)
+	}
+	for _, p := range n.pos {
+		fn(p)
+	}
+	for _, c := range n.children {
+		mVisitValues(c, fn)
+	}
+}
+
+func mCheckEnum(v *hzVal, got string) error {
+	var enums []string
+	for _, e := range v.enum {
+		if e == got {
+			return nil
+		}
+		enums = append(enums, fmt.Sprintf("%q", e))
+	}
+	return fmt.Errorf("%s must be one of %s but got %q", v.shortSummary(), strings.Join(enums, ","), got)
+}
+
+// checkMissingFlags is context.go checkMissingFlags over one path element's flags. A flag's
+// effective requiredness is computed here (an and group with one required member makes all
+// its members required: "flag.Required = andGroupRequired[and]" in kong, which writes into
+// the model; the spec is never written). A required flag that is set, by the command line or
+// by its default, is never missing (the design note; "if !flag.Required || flag.Set"). A
+// choice group (xor, lastwins) is satisfied by a member in use: with kDefaultsCountInXor on
+// (kong/2) a member with a default counts ("if flag.Set { choiceGroupSet[group] = true }",
+// Set by Context.Reset), as documented only a member given on the command line (isSetXor);
+// kong's "andGroupSet" is written and never read, so the and groups have no such read. A
+// group whose required members are all missing is reported only with two or more of them
+// ("len(flags) > 1", the same rule for the choice groups and the and groups) with
+// kLoneRequiredChoiceMember on (kong/5 covers all three group kinds); as documented a lone
+// required member is required. For an and group the shape is exactly a group of one member:
+// with two or more members one required member makes every member required, so with none
+// given the group is reported, and with some given the members missing here are fewer than
+// the group's and kong reports the group through checkAndMissing ("must be used together",
+// checkXorAnd below), a documented-by-code choice of message the model keeps.
+func (c *mCtx) checkMissingFlags(flags []*hzVal) error {
+	choiceSet := map[string]bool{}
+	choiceGroups := map[string][]string{}
+	andGroup := map[string][]string{}
+	var missing []string
+	andRequired := map[string]bool{}
+	andSize := map[string]int{}
+	for _, f := range flags {
+		if f.and != "" {
+			andSize[f.and]++
+			if f.required {
+				andRequired[f.and] = true
+			}
+		}
+	}
+	for _, f := range flags {
+		required := f.required
+		if f.and != "" {
+			required = andRequired[f.and]
+		}
+		var groups []string
+		if f.xor != "" {
+			groups = append(groups, "xor:"+f.xor)
+		}
+		if f.lastwins != "" {
+			groups = append(groups, "lastwins:"+f.lastwins)
+		}
+		if c.isSetXor(f) {
+			for _, g := range groups {
+				choiceSet[g] = true
+			}
+		}
+		if !required || c.set[f] {
+			continue
+		}
+		if len(groups) > 0 || f.and != "" {
+			for _, g := range groups {
+				if choiceSet[g] {
+					continue
+				}
+				choiceGroups[g] = append(choiceGroups[g], f.summary())
+			}
+			if f.and != "" {
+				andGroup[f.and] = append(andGroup[f.and], f.summary())
+			}
+		} else {
+			missing = append(missing, f.summary())
+		}
+	}
+	for g, fl := range choiceGroups {
+		if !choiceSet[g] && (len(fl) > 1 || !c.k[kLoneRequiredChoiceMember]) {
+			missing = append(missing, strings.Join(fl, " or "))
+		}
+	}
+	for g, fl := range andGroup {
+		if len(fl) > 1 || (andSize[g] == 1 && !c.k[kLoneRequiredChoiceMember]) {
+			missing = append(missing, strings.Join(fl, " and "))
+		}
+	}
+	if len(missing) == 0 {
+		return nil
+	}
+	sort.Strings(missing)
+	return fmt.Errorf("missing flags: %s", strings.Join(missing, ", "))
+}
+
+func (c *mCtx) checkMissingChildren(node *hzNode) error {
+	var missing, missingArgs []string
+	for _, p := range node.pos {
+		if p.required && !c.set[p] {
+			missingArgs = append(missingArgs, p.summary())
+		}
+	}
+	if len(missingArgs) > 0 {
+		missing = append(missing, strconv.Quote(strings.Join(missingArgs, " ")))
+	}
+	for _, ch := range node.children {
+		if ch.hidden {
+			continue
+		}
+		missing = append(missing, strconv.Quote(ch.name))
+	}
+	if len(missing) == 0 {
+		return nil
+	}
+	if len(missing) > 5 {
+		missing = append(missing[:5], "...")
+	}
+	if len(missing) == 1 {
+		return fmt.Errorf("expected %s", missing[0])
+	}
+	return fmt.Errorf("expected one of %s", strings.Join(missing, ", "))
+}
+
+// checkXorAnd is checkXorDuplicatedAndAndMissing: the xor groups with two members in use
+// (checkXorDuplicates; isSetXor reads kDefaultsCountInXor), then the and groups with one
+// member in use and one not (checkAndMissing; isSetAnd reads kDefaultsCountInAnd).
+func (c *mCtx) checkXorAnd() error {
+	var errs []string
+xor:
+	for _, p := range c.path {
+		seen := map[string]*hzVal{}
+		for _, f := range p.flags {
+			if !c.isSetXor(f) || f.xor == "" {
+				continue
+			}
+			if o := seen[f.xor]; o != nil {
+				errs = append(errs, fmt.Sprintf("--%s and --%s can't be used together", o.name, f.name))
+				break xor
+			}
+			seen[f.xor] = f
+		}
+	}
+	for _, p := range c.path {
+		var msgs []string
+		groups := map[string][]*hzVal{}
+		var order []string
+		for _, f := range p.flags {
+			if f.and != "" {
+				if groups[f.and] == nil {
+					order = append(order, f.and)
+				}
+				groups[f.and] = append(groups[f.and], f)
+			}
+		}
+		for _, g := range order {
+			oneSet, notSet := false, 0
+			var names []string
+			for _, f := range groups[g] {
+				names = append(names, f.name)
+				if c.isSetAnd(f) {
+					oneSet = true
+				} else {
+					notSet++
+				}
+			}
+			if notSet > 0 && oneSet {
+				msgs = append(msgs, fmt.Sprintf("--%s must be used together", strings.Join(names, " and --")))
+			}
+		}
+		if len(msgs) > 0 {
+			errs = append(errs, strings.Join(msgs, ", "))
+			break
+		}
+	}
+	if len(errs) > 0 {
+		return errors.New(strings.Join(errs, ", "))
+	}
+	return nil
+}
+
+// mParse is Kong.Parse over the spec under the switch set: the command string and the
+// fields, or the error. Pure: it writes into its own values only, never into the spec.
+func mParse(root *hzNode, args []string, k known) (string, map[string]string, error) {
+	c := &mCtx{root: root, scan: &mScan{}, values: map[*hzVal]*mVal{}, set: map[*hzVal]bool{}, given: map[*hzVal]bool{}, peers: map[*hzVal][]*hzVal{}, k: k}
+	for _, a := range args {
+		c.scan.args = append(c.scan.args, mTok{tUntyped, a})
+	}
+	var nodes []*hzNode
+	nodes = append(nodes, root)
+	for len(nodes) > 0 {
+		n := nodes[0]
+		nodes = append(nodes[1:], n.children...)
+		groups := map[string][]*hzVal{}
+		for _, f := range n.flags {
+			if f.lastwins != "" {
+				groups[f.lastwins] = append(groups[f.lastwins], f)
+			}
+		}
+		for _, members := range groups {
+			if len(members) < 2 {
+				continue
+			}
+			for _, m := range members {
+				for _, o := range members {
+					if o != m {
+						c.peers[m] = append(c.peers[m], o)
+					}
+				}
+			}
+		}
+	}
+	c.path = append(c.path, mPath{node: root, flags: root.flags})
+	if err := c.trace(root); err != nil {
+		return "", nil, err
+	}
+	// Reset: zero or default, defaults failing off the selected path are ignored.
+	selected := map[*hzVal]bool{}
+	for _, p := range c.path {
+		if p.node != nil {
+			for _, f := range p.node.flags {
+				selected[f] = true
+			}
+			for _, x := range p.node.pos {
+				selected[x] = true
+			}
+		}
+	}
+	final := map[*hzVal]*mVal{}
+	var resetErr error
+	mVisitValues(root, func(v *hzVal) {
+		if resetErr != nil {
+			return
+		}
+		x := &mVal{kind: v.kind}
+		final[v] = x
+		if v.hasDef {
+			if v.kind == kPtrInt {
+				x.nonNil = true
+			}
+			if v.kind == kStrMap {
+				x.m = map[string]string{}
+			}
+			if v.kind == kIntMap {
+				x.mi = map[string]int64{}
+			}
+			scan := &mScan{args: []mTok{{tFlagValue, v.def}}}
+			err := mDecodeValue(v, scan, x, k)
+			if err != nil {
+				if !selected[v] {
+					final[v] = &mVal{kind: v.kind}
+					return
+				}
+				resetErr = fmt.Errorf("%s: %w", v.shortSummary(), err)
+				return
+			}
+			if v.isSlice() && (len(x.ss) > 0 || len(x.is) > 0) {
+				x.nonNil = true
+			}
+			c.set[v] = true
+		}
+	})
+	if resetErr != nil {
+		return "", nil, resetErr
+	}
+	// Apply.
+	for _, p := range c.path {
+		switch {
+		case p.flag != nil:
+			if x, ok := c.values[p.flag]; ok {
+				final[p.flag] = x.clone()
+			}
+		case p.pos != nil:
+			if x, ok := c.values[p.pos]; ok {
+				final[p.pos] = x.clone()
+			}
+		}
+	}
+	// Validate.
+	for _, p := range c.path {
+		if p.node == nil {
+			continue
+		}
+		for _, f := range p.node.flags {
+			if f.kind == kEnum && (!f.required || f.hasDef) {
+				if err := mCheckEnum(f, final[f].s); err != nil {
+					return "", nil, err
+				}
+			}
+		}
+	}
+	for _, p := range c.path {
+		if p.flag != nil && p.flag.kind == kEnum {
+			if err := mCheckEnum(p.flag, final[p.flag].s); err != nil {
+				return "", nil, err
+			}
+		}
+		if err := c.checkMissingFlags(p.flags); err != nil {
+			return "", nil, err
+		}
+	}
+	node := root
+	for _, p := range c.path {
+		if p.node != nil {
+			node = p.node
+		}
+	}
+	if err := c.checkMissingChildren(node); err != nil {
+		return "", nil, err
+	}
+	positionals := 0
+	for _, p := range c.path {
+		if p.pos != nil {
+			positionals = p.pos.position + 1
+		}
+	}
+	if positionals < len(node.pos) && node.pos[positionals].required {
+		var missing []string
+		for ; positionals < len(node.pos); positionals++ {
+			missing = append(missing, "<"+node.pos[positionals].name+">")
+		}
+		return "", nil, fmt.Errorf("missing positional arguments %s", strings.Join(missing, " "))
+	}
+	if err := c.checkXorAnd(); err != nil {
+		return "", nil, err
+	}
+	var cmd []string
+	for _, p := range c.path {
+		switch {
+		case p.pos != nil:
+			cmd = append(cmd, "<"+p.pos.name+">")
+		case p.node != nil && p.node != root:
+			cmd = append(cmd, p.node.name)
+		}
+	}
+	fields := map[string]string{}
+	mVisitValues(root, func(v *hzVal) {
+		key := v.name
+		if v.pos {
+			key = "<" + v.name + ">"
+		}
+		fields[v.owner.path()+key] = final[v].format()
+	})
+	return strings.Join(cmd, " "), fields, nil
+}
+
+// --------------------------------------------------------------------------- the property's
+// model
+
+// runExpected states what Parse must give for the case under the switch set: "new" (the
+// result of kong.New: always "ok"), "err" (the error text, "" for none), and when there is
+// none "cmd" (Context.Command) and one "field <path><name>" per value of the spec in spec
+// order (hzFmtReal's print). With every switch off this is the documented behaviour; with a
+// switch on, kong's rule for that bug (the replicas in mParse).
+func runExpected(c runCase, k known) checks {
+	w := checks{"new": "ok"}
+	cmd, fields, err := mParse(c.spec, c.args, k)
+	if err != nil {
+		w["err"] = err.Error()
+		return w
+	}
+	w["err"] = ""
+	w["cmd"] = cmd
+	for key, v := range fields {
+		w["field "+key] = v
+	}
+	return w
+}
diff --git a/hegel/hegel_zoo_pins_test.go b/hegel/hegel_zoo_pins_test.go
new file mode 100644
index 0000000..d345822
--- /dev/null
+++ b/hegel/hegel_zoo_pins_test.go
@@ -0,0 +1,99 @@
+package hegel
+
+// One pin per recorded bug (bugs.toml), asserting the documented behaviour; expected failures
+// in target.toml while the bug exists.
+
+import (
+	"testing"
+
+	"github.com/alecthomas/kong"
+)
+
+// hzPinParse builds the parser and parses args; the error text or "".
+func hzPinParse(t *testing.T, grammar any, args ...string) (*kong.Context, string) {
+	t.Helper()
+	k, err := kong.New(grammar, kong.Name("app"), kong.NoDefaultHelp(), kong.Exit(func(int) {}))
+	if err != nil {
+		t.Fatalf("kong.New: %v", err)
+	}
+	ctx, err := k.Parse(args)
+	if err != nil {
+		return nil, err.Error()
+	}
+	return ctx, ""
+}
+
+// kong/1: a short flag declared as a non-ASCII rune (the tag accepts any rune) can never be
+// given: the scanner takes one byte of the token as the short name.
+func TestHegelPinNonASCIIShortFlag(t *testing.T) {
+	var cli struct {
+		E bool `short:"é"`
+	}
+	_, err := hzPinParse(t, &cli, "-é")
+	if err != "" || !cli.E {
+		t.Fatalf("-é (short:\"é\"): error %q, E = %v; want E = true", err, cli.E)
+	}
+}
+
+// kong/2: a flag with a default counts as used in its xor group: giving the other member is
+// an error.
+func TestHegelPinXorDefaultNotUsed(t *testing.T) {
+	var cli struct {
+		A string `xor:"g" default:"1"`
+		B string `xor:"g"`
+	}
+	_, err := hzPinParse(t, &cli, "--b", "2")
+	if err != "" || cli.B != "2" {
+		t.Fatalf("--b 2 with --a in the same xor group holding a default: error %q, B = %q; want B = \"2\"", err, cli.B)
+	}
+}
+
+// kong/3: a flag with a default counts as used in its and group: an empty command line is
+// an error.
+func TestHegelPinAndDefaultNotUsed(t *testing.T) {
+	var cli struct {
+		A string `and:"g" default:"1"`
+		B string `and:"g"`
+	}
+	_, err := hzPinParse(t, &cli)
+	if err != "" {
+		t.Fatalf("no arguments with --a holding a default in an and group: error %q; want none", err)
+	}
+}
+
+// kong/4: "--" after the first value of a cumulative positional ends the argument; the rest
+// is "unexpected" instead of appended.
+func TestHegelPinDashDashAfterCumulative(t *testing.T) {
+	var cli struct {
+		A string   `arg:""`
+		C []string `arg:"" optional:""`
+	}
+	_, err := hzPinParse(t, &cli, "a", "x", "--", "-y")
+	if err != "" || len(cli.C) != 2 || cli.C[0] != "x" || cli.C[1] != "-y" {
+		t.Fatalf("a x -- -y: error %q, C = %q; want [x -y]", err, cli.C)
+	}
+}
+
+// kong/5: a required flag whose xor group has no other required member is not required at
+// all: nothing given passes.
+func TestHegelPinRequiredXorMember(t *testing.T) {
+	var cli struct {
+		A string `xor:"g" required:""`
+		B string `xor:"g"`
+	}
+	_, err := hzPinParse(t, &cli)
+	if err == "" {
+		t.Fatalf("no arguments with --a required in an xor group: no error; want a missing flags error")
+	}
+}
+
+// kong/6: a counter flag with a default increments from zero, not from the default.
+func TestHegelPinCounterDefaultIncrement(t *testing.T) {
+	var cli struct {
+		V int `type:"counter" short:"v" default:"5"`
+	}
+	_, err := hzPinParse(t, &cli, "-v")
+	if err != "" || cli.V != 6 {
+		t.Fatalf("-v with default 5: error %q, V = %d; want 6", err, cli.V)
+	}
+}
diff --git a/hegel/hegel_zoo_run_test.go b/hegel/hegel_zoo_run_test.go
new file mode 100644
index 0000000..5e40cf3
--- /dev/null
+++ b/hegel/hegel_zoo_run_test.go
@@ -0,0 +1,92 @@
+package hegel
+
+// The wide property: a generated grammar and an argument list, kong.New and Kong.Parse on
+// them, the error text or the selected command and every field read back, against the model
+// with every switch off. A case whose values the model changes under some switch has the
+// shape of that bug (the classifier): it fails by default naming the bug, and is drawn again
+// under HEGEL_NO_KNOWN=1 (runCases).
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/alecthomas/kong"
+)
+
+// hzErrClass is the collector's class of an error text (the counts the collector prints).
+func hzErrClass(err string) string {
+	for _, p := range []string{"unknown flag", "unexpected argument", "missing flags", "expected one of", "expected \"",
+		"missing value", "must be one of", "can't be used together", "must be used together", "bool value must be",
+		"unexpected flag argument", "missing positional"} {
+		if strings.HasPrefix(err, p) || strings.Contains(err, ": "+p) {
+			return p
+		}
+	}
+	if strings.Contains(err, "expected") {
+		return "value"
+	}
+	return "other"
+}
+
+// runActual asks the library the model's questions: "new" is "ok" or the error of kong.New
+// (or "panic: ..."); "err" the error of Parse ("" for none, "panic: ..." for a panic, so that
+// a panic is judged like any other value); when Parse succeeds "cmd" is Context.Command and
+// the fields are read back from the grammar struct. On a kong.New failure only "new" is
+// answered, so every other check of the model shows as "(none)".
+func runActual(c runCase) checks {
+	got := checks{}
+	grammar := reflect.New(c.spec.typ)
+	var k *kong.Kong
+	var newErr error
+	if r := hzCatch(func() {
+		k, newErr = kong.New(grammar.Interface(), kong.Name("app"), kong.NoDefaultHelp(), kong.Exit(func(int) {}))
+	}); r != nil {
+		got.set("new", "panic: "+hzPanicText(r))
+		return got
+	}
+	if newErr != nil {
+		got.set("new", "error: "+newErr.Error())
+		return got
+	}
+	got.set("new", "ok")
+	var ctx *kong.Context
+	var err error
+	if r := hzCatch(func() { ctx, err = k.Parse(c.args) }); r != nil {
+		got.set("err", "panic: "+hzPanicText(r))
+		return got
+	}
+	if err != nil {
+		got.set("err", err.Error())
+		hzTally("err " + hzErrClass(err.Error()))
+		return got
+	}
+	hzTally("ok")
+	got.set("err", "")
+	got.set("cmd", ctx.Command())
+	fields := map[string]string{}
+	hzReadReal(c.spec, grammar.Elem(), fields)
+	for key, v := range fields {
+		got.set("field "+key, v)
+	}
+	return got
+}
+
+// hzPanicText is the text of a recovered panic value.
+func hzPanicText(r any) string {
+	if e, ok := r.(error); ok {
+		return e.Error()
+	}
+	return fmt.Sprint(r)
+}
+
+// TestHegelRun: for a generated grammar and argument list, kong.New succeeds and Kong.Parse
+// gives the documented error or the documented command and field values (the README's
+// grammar and the design notes). By default a case with the shape of a recorded bug fails
+// naming it (expected_failures); under HEGEL_NO_KNOWN=1 such cases are drawn again.
+func TestHegelRun(t *testing.T) {
+	judged(t, runCases, func(j *hzCaseJudge, c runCase) {
+		judgeBy(j, c, runExpected, runActual)
+	})
+}
diff --git a/hegel/hegel_zoo_shapes_test.go b/hegel/hegel_zoo_shapes_test.go
new file mode 100644
index 0000000..dad461e
--- /dev/null
+++ b/hegel/hegel_zoo_shapes_test.go
