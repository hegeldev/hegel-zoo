+package hegel
+
+// The narrow properties: one per recorded bug, drawing the region of its shape (so that it
+// fails every run by default, naming the bug) and under HEGEL_NO_KNOWN=1 the neighbouring
+// region past it (hzShaped), which must pass. Each is the wide property's judge over a
+// restricted grammar: the shaped flags or positionals first on a command that is the root or
+// a subcommand "run" of a flagless root (the level), beside zero to two plain flags (no
+// group, no default, not required: nothing an earlier bug would be named for), and an
+// argument list that reaches the bug. The cases run through regionOf, which keeps the cases
+// the classifier names for the bug (by default) or none (under HEGEL_NO_KNOWN=1); the
+// rejections are counted "filtered kong/N" and measured in the comments.
+
+import (
+	"strconv"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- the level
+
+// placed is a shaped command placed at its level: the whole grammar, the command, and the
+// tokens that reach it (nothing at the root, "run" below).
+type placed struct {
+	spec   *hzNode
+	node   *hzNode
+	prefix []string
+}
+
+// atLevel is the raw command built as the root (first: the shrink target) or as the one
+// subcommand of a flagless root, 40 of the time.
+func atLevel(raw rawNode) hegel.Generator[placed] {
+	root := hegel.Map(hegel.Just(raw), func(r rawNode) placed {
+		spec := buildSpec(r)
+		return placed{spec: spec, node: spec}
+	})
+	below := hegel.Map(hegel.Just(raw), func(r rawNode) placed {
+		spec := buildSpec(rawNode{body: rawBody{children: []rawChild{{node: r, name: 0}}, defIdx: -1}})
+		return placed{spec: spec, node: spec.children[0], prefix: []string{"run"}}
+	})
+	return dieChoice(
+		hzW(60, root),
+		hzW(40, below), // a subcommand nominal 40: realises 39 to 42 over the six properties (3000 cases each, HEGEL_SEED=7)
+	)
+}
+
+// plainFlags is a flag an earlier bug cannot be named for: any kind but a counter (a
+// counter's default is kong/6's shape; it has none here, but the counter forms would add
+// nothing) and an enum (kong.New wants an enum required or defaulted), a name, an ASCII
+// short or none, no alias, no group, no default, not required.
+var plainFlags = hegel.Composite(func(tc hegel.TestCase) rawFlag {
+	f := rawFlag{kind: hegel.Draw(tc, plainKinds), name: hegel.Draw(tc, flagNames), short: -1}
+	if f.kind == kNegBool {
+		f.negNo = hegel.Draw(tc, negStyles)
+	}
+	if hegel.Draw(tc, dieCoin(50)) { // a short nominal 50: realises 47 to 53 over the six
+		f.short = hegel.Draw(tc, rangeHalves(0, len(hzShorts)-1))
+	}
+	return f
+})
+
+var plainKinds = halvesOver([]int{3, 2, 3, 2, 1, 1, 1, 1, 2, 1, 1, 1, 1}, kBool, kNegBool, kString, kInt, kInt8, kUint16, kFloat, kDuration,
+	kStrSlice, kIntSlice, kStrMap, kIntMap, kPtrInt) // the kinds but the counter and the enum, at the wide property's weights
+
+// withPlain is the shaped flags followed by zero to two plain flags.
+func withPlain(shaped []rawFlag) hegel.Generator[[]rawFlag] {
+	return hegel.Map(countedHalves(plainFlags, 0, 2), func(plain []rawFlag) []rawFlag { // 0 to 2 plain flags, nominal 33 each: realise 31 / 34 / 35 for kong/1, 28 to 38 over the six
+		return append(append([]rawFlag(nil), shaped...), plain...)
+	})
+}
+
+// emissionsAfter is zero or one emission of the command's flags after the shaped tokens:
+// one of the flags by its long form (longFormOf: a valid value, so that only the shape can
+// make the parse fail).
+func emissionsAfter(node *hzNode) hegel.Generator[[]string] {
+	return emissionsOf(mAllFlags(node))
+}
+
+func emissionsOf(flags []*hzVal) hegel.Generator[[]string] {
+	if len(flags) == 0 {
+		return hegel.Just[[]string](nil)
+	}
+	return dieChoice(
+		hzW(60, hegel.Just[[]string](nil)),
+		hzW(40, hegel.FlatMap(evenHalves(flags...), longFormOf)), // one emission after nominal 40: realises 45 for kong/1 (every flag of the command), 27 to 31 of the cases of the others (only the plain flags, none in 29 to 32 of the cases)
+	)
+}
+
+// caseOf is the run case of a placed command and the tokens after its prefix.
+func caseOf(p placed, toks hegel.Generator[[]string]) hegel.Generator[runCase] {
+	return hegel.Map(toks, func(ts []string) runCase {
+		return runCase{spec: p.spec, args: append(append([]string(nil), p.prefix...), ts...)}
+	})
+}
+
+// --------------------------------------------------------------------------- kong/1
+
+// nonASCIIShortCases: a flag whose short is a non-ASCII rune (one of the two of the wide
+// property; an ASCII one past the shape), given by one of its short forms (the long forms of
+// the flag's kind with the short in place of the long name: -s, -s=value, -svalue, -s value,
+// and for a bool the combined token with another flag's short), then zero or one more
+// emission. Every short form reaches the bug: the scanner cuts the first byte of the rune.
+var nonASCIIShortCases = hegel.FlatMap(hegel.Composite(func(tc hegel.TestCase) rawFlag {
+	f := rawFlag{kind: hegel.Draw(tc, plainKinds), name: hegel.Draw(tc, flagNames)}
+	if f.kind == kNegBool {
+		f.negNo = hegel.Draw(tc, negStyles)
+	}
+	f.short = hegel.Draw(tc, hzShaped(rangeHalves(len(hzShorts), len(hzShorts)+len(hzWideShorts)-1), rangeHalves(0, len(hzShorts)-1)))
+	return f
+}), func(shaped rawFlag) hegel.Generator[runCase] {
+	return hegel.FlatMap(withPlain([]rawFlag{shaped}), func(flags []rawFlag) hegel.Generator[runCase] {
+		return hegel.FlatMap(atLevel(rawNode{flags: flags, body: rawBody{defIdx: -1}}), func(p placed) hegel.Generator[runCase] {
+			f := p.node.flags[0]
+			short := "-" + string(f.short)
+			var forms hegel.Generator[[]string]
+			switch {
+			case f.isBool():
+				forms = boolForms(f, short, short, mAllFlags(p.node))
+			case f.kind == kCounter:
+				forms = counterForms(f, short, short)
+			default:
+				forms = valuedForms(f, short, short)
+			}
+			return caseOf(p, hzSeq(forms, emissionsAfter(p.node)))
+		})
+	})
+})
+
+// TestHegelNonASCIIShortFlagsAreGiven: a flag declared with a non-ASCII short (the tag
+// accepts any rune) is given by that short as an ASCII one is. kong/1: the scanner cuts the
+// token by bytes, so the flag is unknown and the error suggests the flag itself. Under
+// HEGEL_NO_KNOWN=1 the short is ASCII and the case passes.
+func TestHegelNonASCIIShortFlagsAreGiven(t *testing.T) {
+	judged(t, regionOf("kong/1", runExpected, nonASCIIShortCases), func(j *hzCaseJudge, c runCase) {
+		judgeBy(j, c, runExpected, runActual)
+	})
+}
+
+// --------------------------------------------------------------------------- kong/2 and
+// kong/3: group members with a default
+
+// groupKinds are the kinds of a group member with a default: the plain kinds and the enum
+// (an enum member always has a default; a counter's default is kong/6's shape).
+var groupKinds = halvesOver([]int{3, 2, 3, 2, 1, 1, 1, 1, 2, 1, 1, 1, 1, 2}, kBool, kNegBool, kString, kInt, kInt8, kUint16, kFloat, kDuration,
+	kStrSlice, kIntSlice, kStrMap, kIntMap, kPtrInt, kEnum)
+
+// memberFlags is a member of the group (xor g1, lastwins l1 or and h0): a defaulted one of
+// the group kinds with a valid default, an undefaulted one of the plain kinds; not
+// required, no alias, an ASCII short or none.
+func memberFlags(group int, defaulted bool) hegel.Generator[rawFlag] {
+	kinds := plainKinds
+	if defaulted {
+		kinds = groupKinds
+	}
+	return hegel.Composite(func(tc hegel.TestCase) rawFlag {
+		f := rawFlag{kind: hegel.Draw(tc, kinds), name: hegel.Draw(tc, flagNames), short: -1, group: group}
+		if f.kind == kNegBool {
+			f.negNo = hegel.Draw(tc, negStyles)
+		}
+		if hegel.Draw(tc, dieCoin(50)) { // a short nominal 50: realises 49.2 (kong/2), 50.0 (kong/3), 51.8 (kong/5)
+			f.short = hegel.Draw(tc, rangeHalves(0, len(hzShorts)-1))
+		}
+		if defaulted {
+			f.hasDef = true
+			f.def = hegel.Draw(tc, evenHalves(hzValidValues[f.kind]...))
+		}
+		return f
+	})
+}
+
+// defaultedXorCases: an xor group of two or three members, the first with a default (none
+// past the shape; an enum always has one, so past the shape the first member is not an
+// enum), the second given on the command line by its long form (with a valid value of its
+// kind), beside zero to two plain flags, then zero or one emission of a plain flag.
+// Documented: the default does not count, the parse succeeds. kong/2: "can't be used
+// together". The same bug from the other side, not drawn here (no member is required):
+// struct{ A string `xor:"g" required:""`; B bool `xor:"g" default:"true"` } with no
+// arguments parses with no error (reproduced standalone) where the documentation says
+// "missing flags: --a", because the default counts as the group's use in checkMissingFlags'
+// choiceGroupSet and A is never collected; the classifier names such a case kong/2 by bug
+// order (kong/5's switch alone moves it too: A is a lone required member).
+var defaultedXorCases = hegel.FlatMap(hzTuple(memberFlags(gXor, hzShaped(true, false)), memberFlags(gXor, false), memberFlags(gXor, false)), func(members []rawFlag) hegel.Generator[runCase] {
+	if hzNoKnown && members[0].kind == kEnum {
+		members[0].kind = kString
+		members[0].hasDef = false
+	}
+	return hegel.FlatMap(dieChoice(hzW(50, hegel.Just(members[:2])), hzW(50, hegel.Just(members))), func(ms []rawFlag) hegel.Generator[runCase] { // three members nominal 50: realises 51.1
+		return hegel.FlatMap(withPlain(ms), func(flags []rawFlag) hegel.Generator[runCase] {
+			return hegel.FlatMap(atLevel(rawNode{flags: flags, body: rawBody{defIdx: -1}}), func(p placed) hegel.Generator[runCase] {
+				given := p.node.flags[1]
+				return caseOf(p, hzSeq(longFormOf(given), plainEmissions(p.node, len(ms))))
+			})
+		})
+	})
+})
+
+// hzValidValues are values every mapper of the kind accepts (the wide property's fit lists
+// without the odd ones: a map default "k", an empty default): the defaults and the values
+// the narrow properties give, so that nothing but the shape makes the parse fail.
+var hzValidValues = map[int][]string{
+	kBool: {"true", "false", "1", "yes", "no"}, kNegBool: {"true", "false", "1", "yes", "no"},
+	kString: {"d", "dd", "x-y", "a,b"}, kEnum: hzEnumValues,
+	kInt: {"1", "-2", "0", "0x10", "100"}, kPtrInt: {"1", "-2", "0", "0x10", "100"}, kInt8: {"1", "-2", "0", "0x10", "100"},
+	kUint16: {"1", "0", "65535"}, kFloat: {"1.5", "1e3", "-0.25"}, kDuration: {"1h", "1h30m", "-2s", "0"},
+	kStrSlice: {"a,b", "a", "a,,b,"}, kIntSlice: {"1,2", "1", "1,-2"},
+	kStrMap: {"a=1;b=2", "a=1"}, kIntMap: {"a=1;b=2", "a=1"}, kCounter: {"0", "2"},
+}
+
+// longFormOf is the flag given by its long form: --name for a bool or a counter, --name=value
+// with a valid value of the kind for the rest.
+func longFormOf(f *hzVal) hegel.Generator[[]string] {
+	if f.isBool() || f.kind == kCounter {
+		return hegel.Just([]string{"--" + f.name})
+	}
+	return hegel.Map(evenHalves(hzValidValues[f.kind]...), func(v string) []string { return []string{"--" + f.name + "=" + v} })
+}
+
+// TestHegelDefaultsDoNotCountInXorGroups: an xor group member with a default does not
+// conflict with another member given on the command line. kong/2: it does. Under
+// HEGEL_NO_KNOWN=1 the member has no default and the case passes.
+func TestHegelDefaultsDoNotCountInXorGroups(t *testing.T) {
+	judged(t, regionOf("kong/2", runExpected, defaultedXorCases), func(j *hzCaseJudge, c runCase) {
+		judgeBy(j, c, runExpected, runActual)
+	})
+}
+
+// defaultedAndCases: an and group of two or three members, the first with a default (none
+// past the shape), none given on the command line, beside zero to two plain flags; zero or
+// one emission of a plain flag. Documented: the default does not count, nothing is missing.
+// kong/3: "must be used together".
+var defaultedAndCases = hegel.FlatMap(hzTuple(memberFlags(gAnd, hzShaped(true, false)), memberFlags(gAnd, false), memberFlags(gAnd, false)), func(members []rawFlag) hegel.Generator[runCase] {
+	if hzNoKnown && members[0].kind == kEnum {
+		members[0].kind = kString
+		members[0].hasDef = false
+	}
+	return hegel.FlatMap(dieChoice(hzW(50, hegel.Just(members[:2])), hzW(50, hegel.Just(members))), func(ms []rawFlag) hegel.Generator[runCase] { // three members nominal 50: realises 51.3
+		return hegel.FlatMap(withPlain(ms), func(flags []rawFlag) hegel.Generator[runCase] {
+			return hegel.FlatMap(atLevel(rawNode{flags: flags, body: rawBody{defIdx: -1}}), func(p placed) hegel.Generator[runCase] {
+				return caseOf(p, plainEmissions(p.node, len(ms)))
+			})
+		})
+	})
+})
+
+// plainEmissions is nothing or one emission of the command's flags past the first n (the
+// shaped ones), by their long forms.
+func plainEmissions(node *hzNode, n int) hegel.Generator[[]string] {
+	return emissionsOf(node.flags[n:])
+}
+
+// TestHegelDefaultsDoNotCountInAndGroups: an and group member with a default does not make
+// the other members missing. kong/3: it does. Under HEGEL_NO_KNOWN=1 the member has no
+// default and the case passes.
+func TestHegelDefaultsDoNotCountInAndGroups(t *testing.T) {
+	judged(t, regionOf("kong/3", runExpected, defaultedAndCases), func(j *hzCaseJudge, c runCase) {
+		judgeBy(j, c, runExpected, runActual)
+	})
+}
+
+// --------------------------------------------------------------------------- kong/4
+
+// dashDashCases: a command with one or two positionals, the last cumulative (a string
+// slice, an int slice or a string map, no passthrough), given a token for each earlier one,
+// one to three fit tokens for the cumulative one, then "--" (nothing past the shape) and one
+// to three more fit tokens; the cumulative positional is required or optional. Documented:
+// "--" ends the flags and the rest is appended. kong/4: the decoder stops at "--" and the
+// rest is unexpected.
+var dashDashCases = hegel.FlatMap(hegel.Composite(func(tc hegel.TestCase) rawNode {
+	n := hegel.Draw(tc, rangeHalves(1, 2)) // one or two positionals, nominal 50 each: realise 50.7 / 49.3
+	var pos []rawPos
+	for i := 0; i < n-1; i++ {
+		pos = append(pos, rawPos{name: hegel.Draw(tc, posNames), kind: hegel.Draw(tc, plainPosKinds)})
+	}
+	last := rawPos{name: hegel.Draw(tc, posNames), kind: hegel.Draw(tc, cumKinds)}
+	last.optional = hegel.Draw(tc, dieCoin(35)) // optional nominal 35: realises 34.4 (the last one a string slice 48.9, an int slice 25.4, a string map 25.7)
+	pos = append(pos, last)
+	return rawNode{body: rawBody{pos: pos, defIdx: -1}}
+}), func(raw rawNode) hegel.Generator[runCase] {
+	return hegel.FlatMap(atLevel(raw), func(p placed) hegel.Generator[runCase] {
+		var gens []hegel.Generator[[]string]
+		for _, x := range p.node.pos[:len(p.node.pos)-1] {
+			gens = append(gens, hzOne(fitTokensFor(x)))
+		}
+		last := p.node.pos[len(p.node.pos)-1]
+		gens = append(gens, countedHalves(fitTokensFor(last), 1, 3)) // 1 to 3 tokens before "--", nominal 33 each: realise 34.0 / 33.6 / 32.4
+		gens = append(gens, hegel.Just(hzShaped([]string{"--"}, nil)))
+		gens = append(gens, countedHalves(fitTokensFor(last), 1, 3)) // 1 to 3 tokens after, nominal 33 each: realise 32.4 / 32.5 / 35.0
+		return caseOf(p, hzSeq(gens...))
+	})
+})
+
+// fitTokensFor is a token the positional's kind accepts (the wide property's fit tokens
+// without "-3", a short flag to the scanner, and "3,4", one value of an int slice flag but
+// not of a positional).
+func fitTokensFor(p *hzVal) hegel.Generator[string] {
+	switch p.kind {
+	case kInt, kInt8, kIntSlice:
+		return evenHalves("1", "2", "0x1f")
+	case kStrMap:
+		return evenHalves("a=1", "b=2", "a=b=c")
+	}
+	return evenHalves("a", "b", "pa", "run", "sub", "x y", "a,b")
+}
+
+// TestHegelDashDashInsideCumulativePositionals: "--" among the values of a cumulative
+// positional argument ends the flags and the rest is appended. kong/4: the rest is
+// "unexpected argument". Under HEGEL_NO_KNOWN=1 there is no "--" and the case passes.
+func TestHegelDashDashInsideCumulativePositionals(t *testing.T) {
+	judged(t, regionOf("kong/4", runExpected, dashDashCases), func(j *hzCaseJudge, c runCase) {
+		judgeBy(j, c, runExpected, runActual)
+	})
+}
+
+// --------------------------------------------------------------------------- kong/5
+
+// loneRequiredCases: a group (xor 45 of the time, lastwins 30, and 25: kong's choice groups
+// and its and groups follow the same rule) whose first member is required (not past the
+// shape) and the others, zero or two for a choice group and none for an and group (with two
+// or more members one required member makes every member required and the group is
+// reported), are not, no member given, no defaults, beside zero to two plain flags; zero or
+// one emission of a plain flag. Documented: "missing flags: --x". kong/5: nothing is
+// missing, a group with one required member unset is never reported.
+var loneRequiredCases = hegel.FlatMap(hzTuple(memberFlags(gXor, false), memberFlags(gXor, false), memberFlags(gXor, false)), func(members []rawFlag) hegel.Generator[runCase] {
+	members[0].required = hzShaped(true, false)
+	for i := range members {
+		if members[i].kind == kEnum {
+			members[i].kind = kString
+			members[i].hasDef = false
+		}
+	}
+	return hegel.FlatMap(dieChoice(hzW(46, hegel.Just(gXor)), hzW(29, hegel.Just(gLastWins)), hzW(25, hegel.Just(gAnd))), func(group int) hegel.Generator[runCase] { // xor nominal 45, lastwins 30, and 25: weights 46 / 29 / 25 realise 46.1 / 28.8 / 25.0 (45 / 30 / 25 realised 44.0 / 32.5 / 23.5)
+		for i := range members {
+			members[i].group = group
+		}
+		counts := dieChoice(hzW(51, hegel.Just(members[:1])), hzW(49, hegel.Just(members))) // three members nominal 50 of the choice groups: weight 49 realises 48.0 (50 realised 53.8 and 47 43.7: the figure swings with the draws around it)
+		if group == gAnd {
+			counts = hegel.Just(members[:1])
+		}
+		return hegel.FlatMap(counts, func(ms []rawFlag) hegel.Generator[runCase] {
+			return hegel.FlatMap(withPlain(ms), func(flags []rawFlag) hegel.Generator[runCase] {
+				return hegel.FlatMap(atLevel(rawNode{flags: flags, body: rawBody{defIdx: -1}}), func(p placed) hegel.Generator[runCase] {
+					return caseOf(p, plainEmissions(p.node, len(ms)))
+				})
+			})
+		})
+	})
+})
+
+// TestHegelLoneRequiredChoiceMembersAreRequired: the one required member of a choice group
+// (xor, lastwins), or the lone member of an and group, is missing when not given. kong/5: it
+// is not reported. Under HEGEL_NO_KNOWN=1 the member is not required and the case passes.
+func TestHegelLoneRequiredChoiceMembersAreRequired(t *testing.T) {
+	judged(t, regionOf("kong/5", runExpected, loneRequiredCases), func(j *hzCaseJudge, c runCase) {
+		judgeBy(j, c, runExpected, runActual)
+	})
+}
+
+// --------------------------------------------------------------------------- kong/6
+
+// counterDefaultCases: a counter flag with a non-zero default (1 to 3; none past the shape:
+// a default of 0 does not reach the bug, the increment from the traced zero and from the
+// default agree), beside zero to two plain flags, incremented one to three times by its long
+// form or its short (a short run or repeated tokens), then zero or one emission of a plain
+// flag. Documented: the default plus the increments. kong/6: the increments alone.
+var counterDefaultCases = hegel.FlatMap(hegel.Composite(func(tc hegel.TestCase) rawFlag {
+	f := rawFlag{kind: kCounter, name: hegel.Draw(tc, flagNames), short: -1}
+	if hegel.Draw(tc, dieCoin(50)) { // a short nominal 50: realises 48.3
+		f.short = hegel.Draw(tc, rangeHalves(0, len(hzShorts)-1))
+	}
+	if hzShaped(true, false) {
+		f.hasDef = true
+		f.def = strconv.Itoa(hegel.Draw(tc, rangeHalves(1, 3))) // default 1 to 3, nominal 33 each: realise 33.0 / 33.2 / 33.8
+	}
+	return f
+}), func(shaped rawFlag) hegel.Generator[runCase] {
+	return hegel.FlatMap(withPlain([]rawFlag{shaped}), func(flags []rawFlag) hegel.Generator[runCase] {
+		return hegel.FlatMap(atLevel(rawNode{flags: flags, body: rawBody{defIdx: -1}}), func(p placed) hegel.Generator[runCase] {
+			f := p.node.flags[0]
+			return caseOf(p, hzSeq(incrementsOf(f), plainEmissions(p.node, 1)))
+		})
+	})
+})
+
+// incrementsOf is one to three increments of the counter: its long form repeated, or when
+// it has a short, a short run (-ccc) or the short repeated.
+func incrementsOf(f *hzVal) hegel.Generator[[]string] {
+	return hegel.FlatMap(rangeHalves(1, 3), func(n int) hegel.Generator[[]string] { // 1 to 3 increments, nominal 33 each: realise 34.3 / 32.3 / 33.4
+		long := make([]string, n)
+		for i := range long {
+			long[i] = "--" + f.name
+		}
+		if f.short == 0 {
+			return hegel.Just(long)
+		}
+		short := make([]string, n)
+		for i := range short {
+			short[i] = "-" + string(f.short)
+		}
+		run := "-"
+		for i := 0; i < n; i++ {
+			run += string(f.short)
+		}
+		return dieChoice(
+			hzW(40, hegel.Just(long)),
+			hzW(30, hegel.Just([]string{run})), // a short run nominal 30: the run and the repeated short realise 58.3 together (the long form 41.7; one increment is the same token either way)
+			hzW(30, hegel.Just(short)),         // the short repeated nominal 30
+		)
+	})
+}
+
+// TestHegelCountersIncrementFromTheirDefault: a counter flag with a default counts up from
+// it. kong/6: it counts up from zero. Under HEGEL_NO_KNOWN=1 the counter has no default and
+// the case passes.
+func TestHegelCountersIncrementFromTheirDefault(t *testing.T) {
+	judged(t, regionOf("kong/6", runExpected, counterDefaultCases), func(j *hzCaseJudge, c runCase) {
+		judgeBy(j, c, runExpected, runActual)
+	})
+}
