@@ -0,0 +1,1257 @@
+package hegel
+
+// The records and generators of the properties. A grammar is drawn as RAW MATERIAL (rawNode:
+// per command the flag count, per flag its kind, a name index into hzFlagNames, the negation
+// style, a short index or none, alias indices, required, hidden, a default and the group
+// draw; per positional its material; per child the same recursively with its name index,
+// alias indices, hidden and the default-command draw) and built into the spec (hzNode, hzVal)
+// by the pure buildSpec, which resolves the collisions kong's duplicate check (build.go)
+// would refuse exactly as the old generator's taken map did: a flag name or negation form
+// taken by an earlier flag of the level or an ancestor takes the next free name of the pool
+// (the old eight-try loop dropped the flag only when every try failed, about never), a short
+// already taken takes the next free short of its pool (ASCII or non-ASCII; the old four-try
+// loop), an alias form already taken is dropped (as before), a child name repeating a
+// sibling's takes the next free name of the pool (the old six-try loop). The argument list
+// is a record drawn with a FlatMap over the built spec (argsFor: today's walk from the root
+// as a chain of draws over the spec). The population is the one the old hzGen* functions
+// drew (the same pools byte for byte, the same shares; the two non-ASCII shorts added to the
+// short pool at one in twelve of the shorts are the shape of kong/1, never drawn under
+// HEGEL_NO_KNOWN=1); every weight below is nominal and the figure beside it is the realised
+// rate the probe measured over 3000 cases (HEGEL_SEED=7) in context, in percent of the draws
+// of that choice: the grammar's over the drawn grammars, the argument list's over the lists
+// drawn for one fixed grammar of four flags (a bool, an int with an alias, a counter, a
+// negatable bool, all but the last with a short) and two subcommands. The engine's dice are
+// not even (hegel_zoo_idioms_test.go) and it draws a repeated short case again, so the
+// simplest alternatives realise under their weight; a weight was raised or lowered where the
+// gap was over two points, and the figures swing a few points between revisions of the
+// generators (every change reorders the draws), so a figure within four points of nominal was
+// left. The simplest alternative comes first in every choice, so the shrink target is a root
+// with no flags, no positionals, no children, and an empty argument list.
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- spec
+
+const (
+	kBool = iota
+	kNegBool
+	kString
+	kInt
+	kInt8
+	kUint16
+	kFloat
+	kDuration
+	kStrSlice
+	kIntSlice
+	kStrMap
+	kIntMap
+	kCounter
+	kPtrInt
+	kEnum
+	kNumKinds
+)
+
+var hzKindNames = [...]string{"bool", "negbool", "string", "int", "int8", "uint16", "float", "duration",
+	"strslice", "intslice", "strmap", "intmap", "counter", "ptrint", "enum"}
+
+// hzVal is a flag or a positional argument of the spec.
+type hzVal struct {
+	field    string
+	name     string
+	kind     int
+	pos      bool // positional argument
+	short    rune
+	aliases  []string
+	negation string // negatable flags: "_" for --no-<name>, else the negation's name
+	required bool
+	hidden   bool
+	hasDef   bool
+	def      string
+	xor      string
+	and      string
+	lastwins string
+	enum     []string
+	passMode int // positionals: 0 none, 1 passthrough (all), 2 passthrough partial
+	position int
+	owner    *hzNode // the command the value is declared on (buildSpec sets it; the model keys the fields by it)
+}
+
+// hzNode is a command of the spec (the root has no parent); typ is its struct type, built
+// with reflect.StructOf by buildSpec.
+type hzNode struct {
+	name        string
+	aliases     []string
+	hidden      bool
+	flags       []*hzVal
+	pos         []*hzVal
+	children    []*hzNode
+	def         int // 0 none, 1 default:"1", 2 default:"withargs"
+	passthrough bool
+	parent      *hzNode
+	defaultCmd  *hzNode
+	typ         reflect.Type
+}
+
+func (n *hzNode) path() string {
+	if n.parent == nil {
+		return ""
+	}
+	return n.parent.path() + n.name + "/"
+}
+
+func (v *hzVal) isBool() bool  { return v.kind == kBool || v.kind == kNegBool }
+func (v *hzVal) isSlice() bool { return v.kind == kStrSlice || v.kind == kIntSlice }
+func (v *hzVal) isMap() bool   { return v.kind == kStrMap || v.kind == kIntMap }
+func (v *hzVal) isCumulative() bool {
+	return v.isSlice() || v.isMap()
+}
+
+func (v *hzVal) negName() string {
+	switch v.negation {
+	case "":
+		return ""
+	case "_":
+		return "--no-" + v.name
+	default:
+		return "--" + v.negation
+	}
+}
+
+// shortSummary is Value.ShortSummary.
+func (v *hzVal) shortSummary() string {
+	if !v.pos {
+		return "--" + v.name
+	}
+	s := "<" + v.name + ">"
+	if v.isCumulative() {
+		s += " ..."
+	}
+	if !v.required {
+		s = "[" + s + "]"
+	}
+	return s
+}
+
+// summary is Value.Summary (Flag.Summary).
+func (v *hzVal) summary() string {
+	if !v.pos {
+		if v.isBool() {
+			return "--" + v.name
+		}
+		return "--" + v.name + "=" + v.placeholder()
+	}
+	return v.shortSummary()
+}
+
+// placeholder is Flag.FormatPlaceHolder for the kinds of the spec.
+func (v *hzVal) placeholder() string {
+	tail := ""
+	if v.isSlice() {
+		tail = ",..."
+	}
+	if v.hasDef {
+		if v.kind == kString || v.kind == kEnum {
+			return strconv.Quote(v.def) + tail
+		}
+		return v.def + tail
+	}
+	if v.isMap() {
+		return "KEY=VALUE;..."
+	}
+	switch v.kind {
+	case kString, kEnum:
+		return "STRING"
+	case kInt, kCounter:
+		return "INT"
+	case kInt8:
+		return "INT-8"
+	case kUint16:
+		return "UINT-16"
+	case kFloat:
+		return "FLOAT-64"
+	case kDuration:
+		return "DURATION"
+	}
+	return strings.ToUpper(v.name) + tail
+}
+
+// --------------------------------------------------------------------------- the pools
+
+// hzFlagNames, hzShorts, hzAliasPool, hzCmdNames and hzEnumValues are the pools of the old
+// generator, byte for byte; hzWideShorts are the two non-ASCII shorts added for the shape of
+// kong/1 (written as escapes), hzPosNames the positional names.
+var (
+	hzFlagNames  = []string{"al", "alp", "alpha", "be", "beta", "ga", "gam", "de", "x", "y", "z", "x-y", "v", "no-de"}
+	hzShorts     = []rune("abcdev")
+	hzWideShorts = []rune{'\u00e9', '\u00fc'}
+	hzAliasPool  = []string{"q", "w", "al", "be", "ga", "x", "y", "t"}
+	hzCmdNames   = []string{"run", "ru", "rm", "ls", "list", "sub", "s", "go", "get", "x"}
+	hzEnumValues = []string{"a", "b", "c"}
+	hzPosNames   = []string{"pa", "pb", "pc", "path", "name"}
+)
+
+// hzFitDefaults and hzUnfitDefaults are the default values per kind (the lists of the old
+// hzDefFor): a fit one 88 times in a hundred where an unfit list exists.
+var (
+	hzFitDefaults = map[int][]string{
+		kBool: {"true", "false", "1", "yes", "no"}, kNegBool: {"true", "false", "1", "yes", "no"},
+		kString: {"d", "dd", "", "x-y", "a,b"}, kEnum: hzEnumValues,
+		kInt: {"1", "-2", "0", "0x10", "100"}, kPtrInt: {"1", "-2", "0", "0x10", "100"}, kInt8: {"1", "-2", "0", "0x10", "100"},
+		kUint16: {"1", "0", "65535"}, kFloat: {"1.5", "1e3", "-0.25"}, kDuration: {"1h", "1h30m", "-2s", "0"},
+		kStrSlice: {"a,b", "a", "", "a,,b,", ",a"}, kIntSlice: {"1,2", "1", "1,-2"},
+		kStrMap: {"a=1;b=2", "a=1", "", "k"}, kIntMap: {"a=1;b=2", "a=1"}, kCounter: {"0", "2"},
+	}
+	hzUnfitDefaults = map[int][]string{
+		kBool: {"maybe"}, kNegBool: {"maybe"}, kEnum: {"zz"},
+		kInt: {"zz", "300", "1.5"}, kPtrInt: {"zz", "300", "1.5"}, kInt8: {"zz", "300", "1.5"},
+		kUint16: {"-1", "70000"}, kFloat: {"x"}, kDuration: {"5", "x"},
+		kIntSlice: {"1,x"}, kIntMap: {"a=x"}, kCounter: {"x"},
+	}
+)
+
+// hzValues are the command-line values per kind (the lists of the old hzValueFor, fit ones
+// and not); hzOddFlagTokens the odd tokens an emission is four times in a hundred,
+// hzOddPosTokens the odd positional tokens, hzOddTailTokens the odd token after a childless
+// command, hzTailValues the value after a second short in a combined token.
+var (
+	hzValues = map[int][]string{
+		kBool: {"true", "false", "1", "0", "yes", "no", "maybe", ""}, kNegBool: {"true", "false", "1", "0", "yes", "no", "maybe", ""},
+		kString: {"a", "b", "x-y", "", "-", "--q", "-q", "a,b", "k=v", " a "},
+		kEnum:   {"a", "b", "c", "zz", ""},
+		kInt:    {"1", "-2", "0", "0x10", "1_0", "7", "300", "zz", "1.5", "", "3", "42"}, kPtrInt: {"1", "-2", "0", "0x10", "1_0", "7", "300", "zz", "1.5", "", "3", "42"},
+		kInt8: {"1", "-2", "127", "200", "zz", "0", "5"}, kUint16: {"1", "0", "70000", "-1", "zz", "65535", "8"},
+		kFloat: {"1.5", "1e3", "-0.25", "x", "inf", "", "2", "0.5"}, kDuration: {"1h", "1h30m", "-2s", "5", "x", "1.5h", "300ms", "0"},
+		kStrSlice: {"a,b", "a", "", "a\\,b", "a,,b,", ",a", "a,-b", "-b", "a\\"}, kIntSlice: {"1,2", "1", "1,x", "1,-2", "", "-1"},
+		kStrMap: {"a=1;b=2", "a=1", "k", "=1", "a=1\\;b=2", "", "a=b=c", "-a=1"}, kIntMap: {"a=1;b=2", "a=x", "a=1", "k"},
+		kCounter: {"3", "x", "-2", "0"},
+	}
+	hzOddFlagTokens = []string{"--zzz", "-q", "--no-zzz", "--=x", "--al=1", "-", "--", " --x", "", "-1"}
+	hzOddPosTokens  = []string{"-", "--", "-1", "", "--x"}
+	hzOddTailTokens = []string{"x", "zzz", "--", "-"}
+	hzTailValues    = []string{"1", "x", "a,b"}
+)
+
+// --------------------------------------------------------------------------- weighted
+// halving
+
+// halvesOver is a table at the weights (the first value the shrink target) drawn by halving
+// like evenHalves: the entries are cut where the cumulative weight is nearest half, a
+// fair-bit choice between the two parts at their summed weights (dieChoice), and each part
+// again, down to one value. Every split is two-way, so the uneven three-way hzDie(3) of
+// dieTree is never used; an entry of weight zero is never drawn.
+func halvesOver[T any](weights []int, values ...T) hegel.Generator[T] {
+	if len(weights) != len(values) {
+		panic("halvesOver: weights and values differ in length")
+	}
+	var ws []int
+	var vs []T
+	for i, w := range weights {
+		if w > 0 {
+			ws = append(ws, w)
+			vs = append(vs, values[i])
+		}
+	}
+	if len(vs) == 0 {
+		panic("halvesOver: every entry has weight 0")
+	}
+	if len(vs) == 1 {
+		return hegel.Just(vs[0])
+	}
+	total := 0
+	for _, w := range ws {
+		total += w
+	}
+	cut, acc, best := 1, 0, -1
+	for i := 1; i < len(vs); i++ {
+		acc += ws[i-1]
+		d := 2*acc - total
+		if d < 0 {
+			d = -d
+		}
+		if best < 0 || d < best {
+			cut, best = i, d
+		}
+	}
+	left := 0
+	for _, w := range ws[:cut] {
+		left += w
+	}
+	return dieChoice(hzW(left, halvesOver(ws[:cut], vs[:cut]...)), hzW(total-left, halvesOver(ws[cut:], vs[cut:]...)))
+}
+
+// countedOver is a list of lo, lo+1, ... elements at the weights (halvesOver), nil for none.
+func countedOver[T any](g hegel.Generator[T], lo int, weights ...int) hegel.Generator[[]T] {
+	values := make([]int, len(weights))
+	for i := range values {
+		values[i] = lo + i
+	}
+	return hegel.FlatMap(halvesOver(weights, values...), func(n int) hegel.Generator[[]T] { return hzCounted(g, n, n) })
+}
+
+// --------------------------------------------------------------------------- the raw
+// records
+
+// rawFlag is a flag as drawn: the kind, a name index into hzFlagNames, the negation style
+// (negatable bools), a short index (-1 none; 0 to 5 hzShorts, 6 and 7 hzWideShorts), alias
+// indices into hzAliasPool, required, hidden, the default, the group kind and the group
+// index (xor g1/g2, lastwins l1/l2; an and group is the level's).
+type rawFlag struct {
+	kind     int
+	name     int
+	negNo    bool
+	short    int
+	aliases  []int
+	required bool
+	hidden   bool
+	hasDef   bool
+	def      string
+	group    int
+	groupIdx int
+}
+
+const (
+	gNone = iota
+	gXor
+	gAnd
+	gLastWins
+)
+
+// rawPos is a positional as drawn: a name index into hzPosNames, the kind, optional, the
+// default, the passthrough mode.
+type rawPos struct {
+	name     int
+	kind     int
+	optional bool
+	hasDef   bool
+	def      string
+	pass     int
+}
+
+// rawBody is what a command holds below its flags: nothing, positionals, or children with
+// the default-command draw (defIdx -1 for none; defOne for default:"1" when the child can
+// take it).
+type rawBody struct {
+	pos      []rawPos
+	children []rawChild
+	defIdx   int
+	defOne   bool
+}
+
+// rawChild is a subcommand as drawn: its node, a name index into hzCmdNames, alias indices
+// into hzCmdNames, hidden.
+type rawChild struct {
+	node    rawNode
+	name    int
+	aliases []int
+	hidden  bool
+}
+
+// rawNode is a command as drawn: a passthrough command (one args slice, required or not), or
+// its flags and body.
+type rawNode struct {
+	passthrough bool
+	passReq     bool
+	flags       []rawFlag
+	body        rawBody
+}
+
+// --------------------------------------------------------------------------- the generators
+
+// hzKindWeights are the shares of the fifteen kinds (the 24-entry list of the old generator:
+// bool three, negbool two, string three, int two, strslice two, counter two, enum two, the
+// rest one each).
+var hzKindWeights = []int{3, 2, 3, 2, 1, 1, 1, 1, 2, 1, 1, 1, 2, 1, 2}
+
+// defaultsFor is a default value for the kind: fit 88 times in a hundred where the kind has
+// unfit defaults, from the pools.
+func defaultsFor(kind int) hegel.Generator[string] {
+	fit := evenHalves(hzFitDefaults[kind]...)
+	unfit, ok := hzUnfitDefaults[kind]
+	if !ok {
+		return fit
+	}
+	return dieChoice(hzW(88, fit), hzW(12, evenHalves(unfit...))) // fit nominal 88: realises 89.5
+}
+
+var (
+	hzDefaults  = kindTable(defaultsFor)
+	hzValueGens = kindTable(func(kind int) hegel.Generator[string] { return evenHalves(hzValues[kind]...) })
+)
+
+// kindTable is a generator per kind.
+func kindTable(f func(int) hegel.Generator[string]) [kNumKinds]hegel.Generator[string] {
+	var t [kNumKinds]hegel.Generator[string]
+	for k := range t {
+		t[k] = f(k)
+	}
+	return t
+}
+
+var (
+	flagKinds = halvesOver(hzKindWeights, kBool, kNegBool, kString, kInt, kInt8, kUint16, kFloat, kDuration,
+		kStrSlice, kIntSlice, kStrMap, kIntMap, kCounter, kPtrInt, kEnum) // the fifteen kinds at 3/2/3/2/1/1/1/1/2/1/1/1/2/1/2 of 24: realise 12.5/7.9/12.3/8.4/4.2/4.6/5.0/4.6/8.0/3.9/3.8/3.3/8.8/4.1/8.7
+	flagNames = rangeHalves(0, len(hzFlagNames)-1) // the fourteen names, nominal 7.1 each: realise 6.3 to 7.7
+	negStyles = dieCoin(67)                        // --no-<name> nominal 70: dieCoin(67) realises 65.9
+
+	// shortIdx is the index of a short: one of the six ASCII shorts eleven times in twelve,
+	// one of the two non-ASCII shorts once (the shape of kong/1; weight zero under
+	// HEGEL_NO_KNOWN=1); shorts is none 45, a short 55.
+	shortIdx = dieChoice(
+		hzW(11, rangeHalves(0, len(hzShorts)-1)),                                                   // ASCII nominal 91.7 of the shorts: realises 91.0
+		hzW(hzUnless(hzNoKnown, 1), rangeHalves(len(hzShorts), len(hzShorts)+len(hzWideShorts)-1)), // non-ASCII nominal 8.3 of the shorts: realises 9.0
+	)
+	shorts = dieChoice(
+		hzW(45, hegel.Just(-1)),
+		hzW(55, shortIdx), // a short nominal 55: realises 57.3
+	)
+	aliasIdx   = rangeHalves(0, len(hzAliasPool)-1)
+	aliasLists = dieChoice(
+		hzW(70, hegel.Just[[]int](nil)),
+		hzW(30, countedHalves(aliasIdx, 1, 2)), // aliases nominal 30: realises 29.3 (one 50.3, two 49.7 of them)
+	)
+	groups = dieChoice(
+		hzW(72, hegel.Just(gNone)),
+		hzW(13, hegel.Just(gXor)),     // xor nominal 12: weight 13 realises 14.0
+		hzW(8, hegel.Just(gAnd)),      // and nominal 8: realises 7.8
+		hzW(8, hegel.Just(gLastWins)), // lastwins nominal 8: realises 7.5
+	)
+	groupIdxs = rangeHalves(0, 1)
+
+	// rawFlags is a flag as drawn, in the old generator's order: the kind, the name, the
+	// negation style of a negatable bool, the short, the aliases, required 20, hidden 10, a
+	// default 30 (an enum always has one unless required), the group. A Composite: the draws
+	// depend on the kind, and it only draws.
+	rawFlags = hegel.Composite(func(tc hegel.TestCase) rawFlag {
+		f := rawFlag{kind: hegel.Draw(tc, flagKinds), name: hegel.Draw(tc, flagNames)}
+		if f.kind == kNegBool {
+			f.negNo = hegel.Draw(tc, negStyles)
+		}
+		f.short = hegel.Draw(tc, shorts)
+		f.aliases = hegel.Draw(tc, aliasLists)
+		f.required = hegel.Draw(tc, dieCoin(20)) // required nominal 20: realises 19.4
+		f.hidden = hegel.Draw(tc, dieCoin(10))   // hidden nominal 10: realises 10.8
+		f.hasDef = hegel.Draw(tc, dieCoin(30))   // a default nominal 30: realises 30.4 of the non-enums (enums 100 unless required)
+		if f.kind == kEnum && !f.required {
+			f.hasDef = true
+		}
+		if f.hasDef {
+			f.def = hegel.Draw(tc, hzDefaults[f.kind])
+		}
+		f.group = hegel.Draw(tc, groups)
+		if f.group == gXor || f.group == gLastWins {
+			f.groupIdx = hegel.Draw(tc, groupIdxs)
+		}
+		return f
+	})
+
+	posNames      = rangeHalves(0, len(hzPosNames)-1)
+	cumKinds      = halvesOver([]int{2, 1, 1}, kStrSlice, kIntSlice, kStrMap) // strslice 50, intslice 25, strmap 25 of the cumulative ones: realise 50.7 / 24.4 / 24.9
+	plainPosKinds = halvesOver([]int{2, 1, 1}, kString, kInt, kInt8)          // string 50, int 25, int8 25: realise 47.3 / 27.0 / 25.7
+	passModes     = halvesOver([]int{2, 1}, 1, 2)                             // all 67, partial 33 of the passthrough ones: realise 59 / 41 (222 draws)
+
+	// rawPositionals is the positionals of a command, in the old generator's order: one to
+	// three, each with its name, the last one cumulative 45, optional from the first optional
+	// on (35 each until one is), a default 25 of the optional ones, passthrough 30 of a last
+	// string slice. A Composite: the draws depend on the position and on the ones before.
+	rawPositionals = hegel.Composite(func(tc hegel.TestCase) []rawPos {
+		n := hegel.Draw(tc, rangeHalves(1, 3)) // 1 to 3 positionals, nominal 33 each: realise 31.5 / 33.0 / 35.5
+		optional := false
+		var out []rawPos
+		for i := 0; i < n; i++ {
+			p := rawPos{name: hegel.Draw(tc, posNames)}
+			last := i == n-1
+			if last && hegel.Draw(tc, dieCoin(45)) { // the last one cumulative nominal 45: realises 45.6
+				p.kind = hegel.Draw(tc, cumKinds)
+			} else {
+				p.kind = hegel.Draw(tc, plainPosKinds)
+			}
+			if !optional && hegel.Draw(tc, dieCoin(35)) { // optional from here on nominal 35: realises 35.6 of the draws
+				optional = true
+			}
+			p.optional = optional
+			if optional && hegel.Draw(tc, dieCoin(25)) { // a default nominal 25 of the optional ones: realises 25.0
+				p.hasDef = true
+				p.def = hegel.Draw(tc, hzDefaults[p.kind])
+			}
+			if last && p.kind == kStrSlice && hegel.Draw(tc, dieCoin(30)) { // passthrough nominal 30 of the last string slices: realises 29.7
+				p.pass = hegel.Draw(tc, passModes)
+			}
+			out = append(out, p)
+		}
+		return out
+	})
+
+	cmdNames      = rangeHalves(0, len(hzCmdNames)-1) // the ten names, nominal 10 each: realise 9.0 to 10.8
+	cmdAliasLists = dieChoice(
+		hzW(70, hegel.Just[[]int](nil)),
+		hzW(30, countedHalves(cmdNames, 1, 2)), // aliases nominal 30: realises 30.2 (one 51.7, two 48.3 of them)
+	)
+
+	// rawRoots is the grammar as drawn: the root at depth 0.
+	rawRoots = rawNodeAt(0)
+
+	// specs is the grammar built from the raw material, with its struct types.
+	specs = hegel.Map(rawRoots, buildSpec)
+)
+
+// bodiesAt is the body of a command at the depth: nothing 12, positionals 40, children 48
+// (one to three; a default command 30 of the time: one of them, default:"1" when it has no
+// children and no positionals half the time, else withargs); below depth 2 nothing 60 or
+// positionals 40 (the old generator drew children at depth < 2 only). Nothing first: the
+// shrink target.
+func bodiesAt(depth int) hegel.Generator[rawBody] {
+	none := hegel.Just(rawBody{defIdx: -1})
+	positionals := hegel.Map(rawPositionals, func(ps []rawPos) rawBody { return rawBody{pos: ps, defIdx: -1} })
+	if depth >= 2 {
+		return dieChoice(
+			hzW(61, none),
+			hzW(39, positionals), // positionals nominal 40 at depth 2: weight 39 realises 38.8
+		)
+	}
+	kids := hegel.FlatMap(countedHalves(rawChildrenAt(depth+1), 1, 3), func(cs []rawChild) hegel.Generator[rawBody] { // 1 to 3 children, nominal 33 each: realise 29.7 / 35.5 / 34.8 at the root
+		return dieChoice(
+			hzW(70, hegel.Just(rawBody{children: cs, defIdx: -1})),
+			hzW(30, hegel.Map(hzTuple(rangeHalves(0, len(cs)-1), hegel.Map(dieCoin(50), func(b bool) int { // a default command nominal 30: realises 31.8 at the root; the default:"1" coin nominal 50: realises 52.3
+				if b {
+					return 1
+				}
+				return 0
+			})), func(d []int) rawBody {
+				return rawBody{children: cs, defIdx: d[0], defOne: d[1] == 1}
+			})),
+		)
+	})
+	return dieChoice(
+		hzW(15, none),        // nothing nominal 12: weight 15 realises 11.4 at the root (the engine draws the shortest cases again)
+		hzW(42, positionals), // positionals nominal 40: weight 42 realises 40.4 at the root
+		hzW(43, kids),        // children nominal 48: weight 43 realises 48.2 at the root
+	)
+}
+
+// rawChildrenAt is a subcommand at the depth: its node, a name, aliases 30 (one or two, not
+// deduplicated: the model knows the rules), hidden 12.
+func rawChildrenAt(depth int) hegel.Generator[rawChild] {
+	return hegel.FlatMap(rawNodeAt(depth), func(n rawNode) hegel.Generator[rawChild] {
+		return hegel.FlatMap(cmdNames, func(name int) hegel.Generator[rawChild] {
+			return hegel.FlatMap(cmdAliasLists, func(aliases []int) hegel.Generator[rawChild] {
+				return hegel.Map(dieCoin(12), func(hidden bool) rawChild { // hidden nominal 12: realises 12.5
+					return rawChild{node: n, name: name, aliases: aliases, hidden: hidden}
+				})
+			})
+		})
+	})
+}
+
+// rawNodeAt is a command at the depth: a regular one with zero to three flags (zero to two
+// below the root) and its body, or below the root a passthrough command seven times in a
+// hundred.
+func rawNodeAt(depth int) hegel.Generator[rawNode] {
+	maxFlags := 3
+	if depth > 0 {
+		maxFlags = 2
+	}
+	bodies := bodiesAt(depth)
+	counts := countedHalves(rawFlags, 0, maxFlags) // 0 to 3 flags at the root, nominal 25 each: realise 24.5 / 24.9 / 24.8 / 25.8
+	if depth > 0 {
+		counts = countedOver(rawFlags, 0, 33, 34, 33) // 0 to 2 flags below, nominal 33 each: realise 29.4 / 35.4 / 35.1 at depth 1, 33.5 / 33.3 / 33.2 at depth 2
+	}
+	regular := hegel.FlatMap(counts, func(fs []rawFlag) hegel.Generator[rawNode] {
+		return hegel.Map(bodies, func(b rawBody) rawNode { return rawNode{flags: fs, body: b} })
+	})
+	passthrough := hegel.Map(dieCoin(50), func(req bool) rawNode { return rawNode{passthrough: true, passReq: req} }) // required nominal 50 of the passthrough commands: realises 53.7
+	return dieChoice(
+		hzW(93, regular),
+		hzW(hzUnless(depth == 0, 8), passthrough), // a passthrough command nominal 7 below the root: weight 8 realises 7.4 at depth 1, 7.9 at depth 2 (the engine draws the shortest cases again)
+	)
+}
+
+// --------------------------------------------------------------------------- the pure
+// builder
+
+// buildSpec is the grammar of the raw material: the collisions resolved as the old taken
+// map did (the forms kong's duplicate check records: "--name", "-s", the alias forms, the
+// negation's name; the sub-map copied per child), the fields named by position, the struct
+// types built.
+func buildSpec(raw rawNode) *hzNode {
+	return buildNode(raw, nil, 0, map[string]bool{})
+}
+
+func buildNode(raw rawNode, parent *hzNode, depth int, taken map[string]bool) *hzNode {
+	n := &hzNode{parent: parent}
+	if raw.passthrough {
+		// A passthrough command: one []string positional, no flags, no children.
+		n.passthrough = true
+		n.pos = []*hzVal{{field: "P0", pos: true, name: "args", kind: kStrSlice, required: raw.passReq, owner: n}}
+		n.typ = hzBuildType(n)
+		return n
+	}
+	andGroup := "h" + strconv.Itoa(depth)
+	for _, rf := range raw.flags {
+		if f := buildFlag(rf, andGroup, taken); f != nil {
+			f.field = "F" + strconv.Itoa(len(n.flags))
+			f.owner = n
+			n.flags = append(n.flags, f)
+		}
+	}
+	for i, rp := range raw.body.pos {
+		p := &hzVal{field: "P" + strconv.Itoa(i), pos: true, position: i, owner: n, name: hzPosNames[rp.name], kind: rp.kind}
+		for _, o := range n.pos {
+			if o.name == p.name {
+				p.name = p.name + strconv.Itoa(i)
+			}
+		}
+		p.required = !rp.optional
+		if rp.optional && rp.hasDef {
+			p.hasDef, p.def = true, rp.def
+		}
+		p.passMode = rp.pass
+		n.pos = append(n.pos, p)
+	}
+	for _, rc := range raw.body.children {
+		sub := map[string]bool{}
+		for k := range taken {
+			sub[k] = true
+		}
+		c := buildNode(rc.node, n, depth+1, sub)
+		c.name = freeCmdName(rc.name, n.children)
+		for _, a := range rc.aliases {
+			c.aliases = append(c.aliases, hzCmdNames[a])
+		}
+		c.hidden = rc.hidden
+		n.children = append(n.children, c)
+	}
+	if raw.body.defIdx >= 0 && raw.body.defIdx < len(n.children) {
+		c := n.children[raw.body.defIdx]
+		if len(c.children) == 0 && len(c.pos) == 0 && raw.body.defOne {
+			c.def = 1
+		} else {
+			c.def = 2
+		}
+		n.defaultCmd = c
+	}
+	n.typ = hzBuildType(n)
+	return n
+}
+
+// freeCmdName is the name at the index, or the next one of hzCmdNames no sibling has.
+func freeCmdName(idx int, siblings []*hzNode) string {
+	for j := range hzCmdNames {
+		name := hzCmdNames[(idx+j)%len(hzCmdNames)]
+		dup := false
+		for _, o := range siblings {
+			if o.name == name {
+				dup = true
+			}
+		}
+		if !dup {
+			return name
+		}
+	}
+	return hzCmdNames[idx]
+}
+
+// buildFlag is the flag of the raw material against the forms taken so far (adding its own):
+// the name at the index, or the next one of hzFlagNames whose long form and negation form
+// are free (nil when none is); the short at the index, or the next free one of its pool
+// (none when the pool is used up); the aliases whose form is free.
+func buildFlag(rf rawFlag, andGroup string, taken map[string]bool) *hzVal {
+	f := &hzVal{kind: rf.kind}
+	for j := range hzFlagNames {
+		name := hzFlagNames[(rf.name+j)%len(hzFlagNames)]
+		if taken["--"+name] {
+			continue
+		}
+		neg := ""
+		if rf.kind == kNegBool {
+			if rf.negNo {
+				neg = "--no-" + name
+			} else {
+				neg = "--un" + name
+			}
+			if taken[neg] {
+				continue
+			}
+		}
+		f.name = name
+		taken["--"+name] = true
+		if neg != "" {
+			taken[neg] = true
+			if rf.negNo {
+				f.negation = "_"
+			} else {
+				f.negation = "un" + name
+			}
+		}
+		break
+	}
+	if f.name == "" {
+		return nil
+	}
+	if rf.short >= 0 {
+		pool, idx := hzShorts, rf.short
+		if rf.short >= len(hzShorts) {
+			pool, idx = hzWideShorts, rf.short-len(hzShorts)
+		}
+		for j := range pool {
+			r := pool[(idx+j)%len(pool)]
+			if !taken["-"+string(r)] {
+				f.short = r
+				taken["-"+string(r)] = true
+				break
+			}
+		}
+	}
+	for _, ai := range rf.aliases {
+		a := hzAliasPool[ai]
+		form := "--" + a
+		if len(a) == 1 {
+			form = "-" + a
+		}
+		if taken[form] {
+			continue
+		}
+		taken[form] = true
+		f.aliases = append(f.aliases, a)
+	}
+	f.required = rf.required
+	f.hidden = rf.hidden
+	if rf.hasDef {
+		f.hasDef, f.def = true, rf.def
+	}
+	if rf.kind == kEnum {
+		f.enum = hzEnumValues
+	}
+	switch rf.group {
+	case gXor:
+		f.xor = "g" + strconv.Itoa(rf.groupIdx+1)
+	case gAnd:
+		f.and = andGroup
+	case gLastWins:
+		f.lastwins = "l" + strconv.Itoa(rf.groupIdx+1)
+	}
+	return f
+}
+
+// --------------------------------------------------------------------------- the struct type
+
+var hzGoTypes = map[int]reflect.Type{
+	kBool: reflect.TypeOf(false), kNegBool: reflect.TypeOf(false), kString: reflect.TypeOf(""),
+	kInt: reflect.TypeOf(int(0)), kInt8: reflect.TypeOf(int8(0)), kUint16: reflect.TypeOf(uint16(0)),
+	kFloat: reflect.TypeOf(float64(0)), kDuration: reflect.TypeOf(time.Duration(0)),
+	kStrSlice: reflect.TypeOf([]string(nil)), kIntSlice: reflect.TypeOf([]int(nil)),
+	kStrMap: reflect.TypeOf(map[string]string(nil)), kIntMap: reflect.TypeOf(map[string]int(nil)),
+	kCounter: reflect.TypeOf(int(0)), kPtrInt: reflect.TypeOf((*int)(nil)), kEnum: reflect.TypeOf(""),
+}
+
+// hzValTag is the tag of a value as kong documents the tags.
+func hzValTag(v *hzVal) string {
+	var parts []string
+	if v.pos {
+		parts = append(parts, `arg:""`)
+	}
+	parts = append(parts, `name:"`+v.name+`"`)
+	if v.short != 0 {
+		parts = append(parts, `short:"`+string(v.short)+`"`)
+	}
+	if len(v.aliases) > 0 {
+		parts = append(parts, `aliases:"`+strings.Join(v.aliases, ",")+`"`)
+	}
+	if v.pos {
+		if !v.required && !v.hasDef {
+			parts = append(parts, `optional:""`)
+		}
+	} else if v.required {
+		parts = append(parts, `required:""`)
+	}
+	if v.hasDef {
+		parts = append(parts, `default:"`+v.def+`"`)
+	}
+	if v.hidden {
+		parts = append(parts, `hidden:""`)
+	}
+	if v.negation == "_" {
+		parts = append(parts, `negatable:""`)
+	} else if v.negation != "" {
+		parts = append(parts, `negatable:"`+v.negation+`"`)
+	}
+	if v.xor != "" {
+		parts = append(parts, `xor:"`+v.xor+`"`)
+	}
+	if v.and != "" {
+		parts = append(parts, `and:"`+v.and+`"`)
+	}
+	if v.lastwins != "" {
+		parts = append(parts, `lastwins:"`+v.lastwins+`"`)
+	}
+	if v.kind == kCounter {
+		parts = append(parts, `type:"counter"`)
+	}
+	if v.kind == kEnum {
+		parts = append(parts, `enum:"`+strings.Join(v.enum, ",")+`"`)
+	}
+	switch v.passMode {
+	case 1:
+		parts = append(parts, `passthrough:""`)
+	case 2:
+		parts = append(parts, `passthrough:"partial"`)
+	}
+	return strings.Join(parts, " ")
+}
+
+func hzNodeTag(n *hzNode) string {
+	parts := []string{`cmd:""`, `name:"` + n.name + `"`}
+	if len(n.aliases) > 0 {
+		parts = append(parts, `aliases:"`+strings.Join(n.aliases, ",")+`"`)
+	}
+	if n.hidden {
+		parts = append(parts, `hidden:""`)
+	}
+	switch n.def {
+	case 1:
+		parts = append(parts, `default:"1"`)
+	case 2:
+		parts = append(parts, `default:"withargs"`)
+	}
+	if n.passthrough {
+		parts = append(parts, `passthrough:""`)
+	}
+	return strings.Join(parts, " ")
+}
+
+// hzBuildType is the struct type of a command: its flags, positionals and children as
+// fields, with the tags (the children's types built already: buildNode is post-order).
+func hzBuildType(n *hzNode) reflect.Type {
+	var fields []reflect.StructField
+	for _, f := range n.flags {
+		fields = append(fields, reflect.StructField{Name: f.field, Type: hzGoTypes[f.kind], Tag: reflect.StructTag(hzValTag(f))})
+	}
+	for _, p := range n.pos {
+		fields = append(fields, reflect.StructField{Name: p.field, Type: hzGoTypes[p.kind], Tag: reflect.StructTag(hzValTag(p))})
+	}
+	for i, c := range n.children {
+		fields = append(fields, reflect.StructField{Name: fmt.Sprintf("C%d", i), Type: c.typ, Tag: reflect.StructTag(hzNodeTag(c))})
+	}
+	return reflect.StructOf(fields)
+}
+
+// hzFmtReal prints a field of the grammar struct as the model prints its values (nil kept
+// apart from empty for slices, maps and pointers).
+func hzFmtReal(kind int, rv reflect.Value) string {
+	switch kind {
+	case kBool, kNegBool:
+		return strconv.FormatBool(rv.Bool())
+	case kString, kEnum:
+		return strconv.Quote(rv.String())
+	case kInt, kInt8, kCounter, kDuration:
+		return strconv.FormatInt(rv.Int(), 10)
+	case kUint16:
+		return strconv.FormatUint(rv.Uint(), 10)
+	case kFloat:
+		return strconv.FormatFloat(rv.Float(), 'g', -1, 64)
+	case kStrSlice:
+		if rv.IsNil() {
+			return "nil"
+		}
+		var parts []string
+		for i := 0; i < rv.Len(); i++ {
+			parts = append(parts, strconv.Quote(rv.Index(i).String()))
+		}
+		return "[" + strings.Join(parts, ",") + "]"
+	case kIntSlice:
+		if rv.IsNil() {
+			return "nil"
+		}
+		var parts []string
+		for i := 0; i < rv.Len(); i++ {
+			parts = append(parts, strconv.FormatInt(rv.Index(i).Int(), 10))
+		}
+		return "[" + strings.Join(parts, ",") + "]"
+	case kStrMap, kIntMap:
+		if rv.IsNil() {
+			return "nil"
+		}
+		var parts []string
+		iter := rv.MapRange()
+		for iter.Next() {
+			if kind == kStrMap {
+				parts = append(parts, strconv.Quote(iter.Key().String())+"="+strconv.Quote(iter.Value().String()))
+			} else {
+				parts = append(parts, strconv.Quote(iter.Key().String())+"="+strconv.FormatInt(iter.Value().Int(), 10))
+			}
+		}
+		sort.Strings(parts)
+		return "{" + strings.Join(parts, ",") + "}"
+	case kPtrInt:
+		if rv.IsNil() {
+			return "nil"
+		}
+		return strconv.FormatInt(rv.Elem().Int(), 10)
+	}
+	return "?"
+}
+
+// hzReadReal reads every field of the grammar struct back, keyed as the model keys its
+// values (the command path and the name).
+func hzReadReal(n *hzNode, rv reflect.Value, out map[string]string) {
+	i := 0
+	for _, f := range n.flags {
+		out[n.path()+f.name] = hzFmtReal(f.kind, rv.Field(i))
+		i++
+	}
+	for _, p := range n.pos {
+		out[n.path()+"<"+p.name+">"] = hzFmtReal(p.kind, rv.Field(i))
+		i++
+	}
+	for _, c := range n.children {
+		hzReadReal(c, rv.Field(i), out)
+		i++
+	}
+}
+
+// hzDescribe prints the spec as the messages show it: one line per value with its kind and
+// tag, the commands indented.
+func hzDescribe(n *hzNode, indent string) string {
+	var b strings.Builder
+	for _, f := range n.flags {
+		b.WriteString(fmt.Sprintf("%s  %s %s\n", indent, hzKindNames[f.kind], hzValTag(f)))
+	}
+	for _, p := range n.pos {
+		b.WriteString(fmt.Sprintf("%s  %s %s\n", indent, hzKindNames[p.kind], hzValTag(p)))
+	}
+	for _, c := range n.children {
+		b.WriteString(fmt.Sprintf("%s  %s\n", indent, hzNodeTag(c)))
+		b.WriteString(hzDescribe(c, indent+"  "))
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- the cases
+
+// runCase is a case of the wide property: the built grammar and the argument list.
+type runCase struct {
+	spec *hzNode
+	args []string
+}
+
+func (c runCase) GoString() string {
+	return fmt.Sprintf("runCase{args: %q}\nspec:\n%s", c.args, hzDescribe(c.spec, ""))
+}
+
+// runCases are the cases of the wide property: a grammar and an argument list drawn over it;
+// under HEGEL_NO_KNOWN=1 the cases the classifier names are drawn again (withoutShapes: the
+// shapes of kong/2 to 6 are properties of the grammar and the argument list together; kong/1
+// is not drawn at all).
+var runCases = withoutShapes(runExpected, hegel.FlatMap(specs, func(root *hzNode) hegel.Generator[runCase] {
+	return hegel.Map(argsFor(root), func(args []string) runCase { return runCase{spec: root, args: args} })
+}))
+
+// --------------------------------------------------------------------------- the argument
+// list
+
+// mAllFlags is the flags a command accepts: its ancestors' and its own (Node.AllFlags).
+func mAllFlags(n *hzNode) []*hzVal {
+	var out []*hzVal
+	if n.parent != nil {
+		out = append(out, mAllFlags(n.parent)...)
+	}
+	return append(out, n.flags...)
+}
+
+// argsFor is the argument list over the built grammar: the walk from the root (argsAt), cut
+// to eight tokens.
+func argsFor(root *hzNode) hegel.Generator[[]string] {
+	return hegel.Map(argsAt(root), func(args []string) []string {
+		if len(args) > 8 {
+			args = args[:8]
+		}
+		return args
+	})
+}
+
+// argsAt is the tokens of the walk from a command: the flags in play (the default command's
+// 70 of the time when it is withargs), zero to two flag emissions, then the rest: a child 80
+// of the time when there are children, else the positionals or an odd token.
+func argsAt(node *hzNode) hegel.Generator[[]string] {
+	plain := mAllFlags(node)
+	flagSets := hegel.Just(plain)
+	if node.defaultCmd != nil && node.defaultCmd.def == 2 {
+		flagSets = dieChoice(
+			hzW(30, hegel.Just(plain)),
+			hzW(70, hegel.Just(mAllFlags(node.defaultCmd))), // the default command's flags nominal 70: realises 68.6 (twice the share of emissions naming the default command's one flag beside the root's one)
+		)
+	}
+	return hegel.FlatMap(flagSets, func(flags []*hzVal) hegel.Generator[[]string] {
+		front := hegel.Map(countedHalves(flagTokensFor(flags), 0, 2), flatten) // 0 to 2 emissions, nominal 33 each: realise 32.5 / 34.7 / 32.8 at the root
+		return hzSeq(front, restAt(node, flags))
+	})
+}
+
+func flatten(xs [][]string) []string {
+	var out []string
+	for _, x := range xs {
+		out = append(out, x...)
+	}
+	return out
+}
+
+// restAt is the tokens after the flag emissions of a command: for a command with children
+// the walk into one of them 80 of the time, else what a childless command gets (leafAt).
+func restAt(node *hzNode, flags []*hzVal) hegel.Generator[[]string] {
+	if len(node.children) > 0 {
+		return dieChoice(
+			hzW(24, leafAt(node, flags)),
+			hzW(76, childAt(node)), // a child nominal 80: weight 76 realises 81 (the engine draws the shortest cases again)
+		)
+	}
+	return leafAt(node, flags)
+}
+
+// leafAt is the tokens of a command the walk ends at: its positionals, or an odd token 15 of
+// the time when it has none.
+func leafAt(node *hzNode, flags []*hzVal) hegel.Generator[[]string] {
+	if len(node.pos) > 0 {
+		return positionalsAt(node, flags)
+	}
+	return dieChoice(
+		hzW(85, hegel.Just[[]string](nil)),
+		hzW(15, hzOne(evenHalves(hzOddTailTokens...))), // an odd token nominal 15: realises 19 (134 of the 702 walks ending at the root)
+	)
+}
+
+// childAt is the walk into one of the children: its name, or one of its aliases 35 of the
+// time when it has any, or a miss 8 of the time (zzz, the name plus x, the name minus its
+// last byte, ru); after an alias or a miss the walk goes on below half the time.
+func childAt(node *hzNode) hegel.Generator[[]string] {
+	return hegel.FlatMap(evenHalves(node.children...), func(c *hzNode) hegel.Generator[[]string] {
+		spelled := dieChoice(
+			hzW(92, hegel.Just(c.name)),
+			hzW(8, evenHalves("zzz", c.name+"x", c.name[:len(c.name)-1], "ru")), // a miss nominal 8 (of the non-alias spellings): realises 7.4
+		)
+		if len(c.aliases) > 0 {
+			spelled = dieChoice(
+				hzW(61, spelled),
+				hzW(39, evenHalves(c.aliases...)), // an alias nominal 35: weight 39 realises 32.9
+			)
+		}
+		return hegel.FlatMap(spelled, func(name string) hegel.Generator[[]string] {
+			descend := hegel.Map(argsAt(c), func(rest []string) []string { return append([]string{name}, rest...) })
+			if name == c.name {
+				return descend
+			}
+			return dieChoice(
+				hzW(50, hegel.Just([]string{name})),
+				hzW(50, descend), // the walk going on after an alias or a miss nominal 50: realises 50.4
+			)
+		})
+	})
+}
+
+// positionalsAt is the positional tokens of a command: zero to n+1 of them for n
+// positionals (the last one's for the extra), each with "--" before it 12 of the time, then
+// a flag emission after them 30 of the time.
+func positionalsAt(node *hzNode, flags []*hzVal) hegel.Generator[[]string] {
+	toks := hegel.FlatMap(rangeHalves(0, len(node.pos)+1), func(n int) hegel.Generator[[]string] { // 0 to n+1 tokens, nominal even: realise 19.7 / 29.4 / 25.3 / 25.6 for n = 2
+		if n == 0 {
+			return hegel.Just[[]string](nil)
+		}
+		gens := make([]hegel.Generator[[]string], n)
+		for i := range gens {
+			gens[i] = posTokenAt(node.pos[min(i, len(node.pos)-1)])
+		}
+		return hzSeq(gens...)
+	})
+	return hegel.FlatMap(toks, func(ts []string) hegel.Generator[[]string] {
+		return dieChoice(
+			hzW(66, hegel.Just(ts)),
+			hzW(34, hegel.Map(flagTokensFor(flags), func(fl []string) []string { // a flag emission after nominal 30: weight 34 realises 33.9
+				return append(append([]string(nil), ts...), fl...)
+			})),
+		)
+	})
+}
+
+// posTokenAt is one token for the positional, with "--" before it 12 of the time.
+func posTokenAt(p *hzVal) hegel.Generator[[]string] {
+	return hegel.FlatMap(dieCoin(12), func(dd bool) hegel.Generator[[]string] { // "--" before nominal 12: realises 11.6
+		return hegel.Map(posTokensFor(p), func(t string) []string {
+			if dd {
+				return []string{"--", t}
+			}
+			return []string{t}
+		})
+	})
+}
+
+// posTokensFor is a positional token: an odd one 10 of the time, else one fit for the kind
+// (and some not).
+func posTokensFor(p *hzVal) hegel.Generator[string] {
+	var fit hegel.Generator[string]
+	switch p.kind {
+	case kInt, kInt8:
+		fit = evenHalves("1", "2", "-3", "x", "0x1f")
+	case kIntSlice:
+		fit = evenHalves("1", "2", "x", "3,4")
+	case kStrMap:
+		fit = evenHalves("a=1", "b=2", "k", "a=b=c")
+	default:
+		fit = evenHalves("a", "b", "pa", "run", "sub", "x y", "a,b")
+	}
+	return dieChoice(
+		hzW(90, fit),
+		hzW(10, evenHalves(hzOddPosTokens...)), // an odd token nominal 10: realises 6.7
+	)
+}
+
+var (
+	oddFlagTokens = hzOne(evenHalves(hzOddFlagTokens...))
+	boolValues    = hzValueGens[kBool]
+	counterValues = hzValueGens[kCounter]
+)
+
+// flagTokensFor is one flag emission from the flags in play: one of them in one of its forms
+// (formsOf), or an odd token four times in a hundred (always when there is no flag).
+func flagTokensFor(flags []*hzVal) hegel.Generator[[]string] {
+	if len(flags) == 0 {
+		return oddFlagTokens
+	}
+	return dieChoice(
+		hzW(95, hegel.FlatMap(evenHalves(flags...), func(f *hzVal) hegel.Generator[[]string] { return formsOf(f, flags) })),
+		hzW(5, oddFlagTokens), // an odd token nominal 4: weight 5 realises 4.3
+	)
+}
+
+// aliasForm is the command-line form of an alias: one dash for a single rune.
+func aliasForm(a string) string {
+	if len(a) == 1 {
+		return "-" + a
+	}
+	return "--" + a
+}
+
+// formsOf is one emission of the flag: its long name (an alias 40 of the time when it has
+// any), its short, and by kind the forms of the old generator; a negatable flag by its
+// negation 40 of the time (with =value 30 of those).
+func formsOf(f *hzVal, flags []*hzVal) hegel.Generator[[]string] {
+	long := hegel.Just("--" + f.name)
+	if len(f.aliases) > 0 {
+		long = dieChoice(
+			hzW(59, hegel.Just("--"+f.name)),
+			hzW(41, hegel.Map(evenHalves(f.aliases...), aliasForm)), // an alias nominal 40: weight 41 realises 40.9
+		)
+	}
+	short := ""
+	if f.short != 0 {
+		short = "-" + string(f.short)
+	}
+	plain := hegel.FlatMap(long, func(long string) hegel.Generator[[]string] {
+		switch {
+		case f.isBool():
+			return boolForms(f, long, short, flags)
+		case f.kind == kCounter:
+			return counterForms(f, long, short)
+		}
+		return valuedForms(f, long, short)
+	})
+	if f.negation == "" {
+		return plain
+	}
+	neg := f.negName()
+	negated := dieChoice(
+		hzW(70, hegel.Just([]string{neg})),
+		hzW(30, hegel.Map(boolValues, func(v string) []string { return []string{neg + "=" + v} })), // =value nominal 30 of the negations: realises 26.4
+	)
+	return dieChoice(
+		hzW(62, plain),
+		hzW(38, negated), // the negation nominal 40: weight 38 realises 40.1
+	)
+}
+
+// boolForms is an emission of a bool flag: the long form 4 of 10, --x=value 2, a combined
+// short token 3 (this short followed by another flag's short half the time, with a value
+// after a value-taking one half of those; the long form when the flag has no short),
+// -s=value or the long form with a value after it 1.
+func boolForms(f *hzVal, long, short string, flags []*hzVal) hegel.Generator[[]string] {
+	combined := hegel.Just([]string{long})
+	withValue := hegel.Map(boolValues, func(v string) []string { return []string{long, v} })
+	if short != "" {
+		combined = hegel.Map(tailsOf(flags), func(tail string) []string { return []string{short + tail} })
+		withValue = hegel.Map(boolValues, func(v string) []string { return []string{short + "=" + v} })
+	}
+	return dieChoice(
+		hzW(9, hegel.Just([]string{long})),
+		hzW(5, hegel.Map(boolValues, func(v string) []string { return []string{long + "=" + v} })), // =value nominal 20: weight 5 of 23 realises 20.5 (the long form 43.2)
+		hzW(7, combined),  // combined nominal 30: weight 7 realises 29.2
+		hzW(2, withValue), // -s=value nominal 10: realises 7.1
+	)
+}
+
+// tailsOf is the tail of a combined short token: nothing half the time, else another flag's
+// short (nothing when it has none) with a value after it half the time when it takes one.
+func tailsOf(flags []*hzVal) hegel.Generator[string] {
+	return dieChoice(
+		hzW(50, hegel.Just("")),
+		hzW(50, hegel.FlatMap(evenHalves(flags...), func(o *hzVal) hegel.Generator[string] { // a tail nominal 50: realises 43 of the combined tokens (one of the four flags has no short)
+			if o.short == 0 {
+				return hegel.Just("")
+			}
+			t := string(o.short)
+			if o.isBool() || o.kind == kCounter {
+				return hegel.Just(t)
+			}
+			return dieChoice(
+				hzW(50, hegel.Just(t)),
+				hzW(50, hegel.Map(evenHalves(hzTailValues...), func(v string) string { return t + v })), // a value after nominal 50: realises 46 of the tails of the one value-taking flag
+			)
+		})),
+	)
+}
+
+// counterForms is an emission of a counter flag: the long form 2 of 6, --x=value 1, a short
+// run of one to three 2 (the long form twice when it has no short), the short with a value
+// glued or the long form with one after it 1.
+func counterForms(f *hzVal, long, short string) hegel.Generator[[]string] {
+	run := hegel.Just([]string{long, long})
+	withValue := hegel.Map(counterValues, func(v string) []string { return []string{long, v} })
+	if short != "" {
+		run = hegel.Map(rangeHalves(0, 2), func(n int) []string { return []string{short + strings.Repeat(string(f.short), n)} }) // a run of 1 to 3, nominal 33 each: realise 31.0 / 40.2 / 28.7
+		withValue = hegel.Map(counterValues, func(v string) []string { return []string{short + v} })
+	}
+	return dieChoice(
+		hzW(8, hegel.Just([]string{long})),
+		hzW(4, hegel.Map(counterValues, func(v string) []string { return []string{long + "=" + v} })), // =value nominal 17: realises 18.4 (the long form 34.6)
+		hzW(8, run),       // a run nominal 33: realises 34.3
+		hzW(3, withValue), // a value nominal 17: weight 3 of 23 realises 12.6
+	)
+}
+
+// valuedForms is an emission of a value-taking flag: --x value 3 of 10, --x=value 3, --x
+// alone 1, -svalue 1, -s value 1, -s=value 1 (the long forms when the flag has no short).
+func valuedForms(f *hzVal, long, short string) hegel.Generator[[]string] {
+	return hegel.FlatMap(hzValueGens[f.kind], func(val string) hegel.Generator[[]string] {
+		spaced := []string{long, val}
+		glued := []string{long + "=" + val}
+		shortGlued, shortSpaced, shortEq := spaced, spaced, spaced
+		if short != "" {
+			shortGlued, shortSpaced, shortEq = []string{short + val}, []string{short, val}, []string{short + "=" + val}
+		} else {
+			shortSpaced = glued
+		}
+		return dieChoice(
+			hzW(3, hegel.Just(spaced)),
+			hzW(3, hegel.Just(glued)),          // --x=value nominal 30: realises 25.5 (--x value 36.2)
+			hzW(1, hegel.Just([]string{long})), // --x alone nominal 10: realises 8.1
+			hzW(1, hegel.Just(shortGlued)),     // -svalue nominal 10: realises 10.4
+			hzW(1, hegel.Just(shortSpaced)),    // -s value nominal 10: realises 12.3
+			hzW(1, hegel.Just(shortEq)),        // -s=value nominal 10: realises 7.5
+		)
+	})
+}
diff --git a/hegel/hegel_zoo_test.go b/hegel/hegel_zoo_test.go
new file mode 100644
index 0000000..4c826e6
--- /dev/null
+++ b/hegel/hegel_zoo_test.go
@@ -0,0 +1,609 @@
+package hegel
+
+// Hegel property tests for alecthomas/kong, written for the Hegel zoo. See targets/go/kong/README.md.
+// They live in a package of their own (hegel/) and drive the public API: a grammar struct
+// built with reflect.StructOf from a generated spec, kong.New and Kong.Parse on generated
+// argument lists, the selected command and the struct's field values read back.
+//
+// Oracle: a model of the documented command-line grammar (flags with values by space or
+// '=', bool and negatable flags, short flags and their tails, aliases, '--', flags inherited
+// by subcommands, subcommands and their aliases, positional arguments, slice and map flags,
+// counters, required flags, xor/and/lastwins groups, default commands, passthrough).
+//
+// The files: hegel_zoo_idioms_test.go has the generator idioms (the weighted choices, the
+// fair-bit dice, the halving helpers); this file the harness (hzOpts, hzProperty, the
+// collector, the known value, the judge, the classifier); hegel_zoo_spec_test.go the spec
+// records drawn as raw material and built by the pure buildSpec, the struct type, and the
+// argument-list records; hegel_zoo_model_test.go the model (a replica of kong's scanner and
+// tracer) with the switch set threaded, runExpected and the classifier's model;
+// hegel_zoo_run_test.go the wide property TestHegelRun; hegel_zoo_shapes_test.go one narrow
+// property per recorded bug; hegel_zoo_pins_test.go the pins.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES and
+// HEGEL_SEED are passed through hzOpts; a panic in the code under test is turned into a
+// failure of the current test case by the judge's Recover, which names the shape of the
+// recorded bug the case has. ZOO_COLLECT=1 makes the properties record their mismatches
+// instead of failing and print the counts. The model states the documented behaviour (every
+// switch of the known value below off) and the properties judge the library against it; the
+// shape of a recorded bug is named before the library is called (the classifier shapeBy runs
+// the model per switch), fails by default "(the shape of kong/N)", and under HEGEL_NO_KNOWN=1
+// is not drawn (kong/1: the non-ASCII shorts have weight zero) or filtered out of the cases
+// by the classifier (kong/2 to 6: withoutShapes), so that a run looks past the known bugs.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+// hzOpts passes HEGEL_TEST_CASES and HEGEL_SEED through to the engine, which reads no
+// environment variable itself (the seed is for the rate measurements of the probe and the
+// collector).
+func hzOpts() []hegel.Option {
+	var opts []hegel.Option
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			opts = append(opts, hegel.WithTestCases(v))
+		}
+	}
+	if s := os.Getenv("HEGEL_SEED"); s != "" {
+		if seed, err := strconv.ParseInt(s, 10, 64); err == nil {
+			opts = append(opts, hegel.WithSeed(seed))
+		}
+	}
+	return opts
+}
+
+// hzProperty runs a property with the library's panics turned into failures and the wrapped
+// hegel control-flow error let through (the go/excelize, go/graphql-go, go/cobra,
+// go/cascadia, go/carbon, go/orb, go/chi, go/go-debian, go/gin and go/cellbuf judge).
+func hzProperty(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+				// A wrapped hegel control-flow error (E_STOP_TEST on an overrun draw).
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hzOpts()...)
+}
+
+var hzCollecting = os.Getenv("ZOO_COLLECT") != "" || os.Getenv("HEGEL_COLLECT") != ""
+
+// hzCollector counts the classes of one property's cases and mismatches and prints them at
+// the end in collect mode ("COLLECT TestHegel...: N mismatches; class=count ..."), with the
+// judge's counters (hzStats) and the first two messages of each mismatch class ("MISMATCH").
+type hzCollector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func hzNewCollector(t *testing.T) *hzCollector {
+	c := &hzCollector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !hzCollecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		hzStatsMu.Lock()
+		stats := make([]string, 0, len(hzStats))
+		for k := range hzStats {
+			stats = append(stats, k)
+		}
+		sort.Strings(stats)
+		for _, k := range stats {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, hzStats[k]))
+		}
+		hzStats = map[string]int{}
+		hzStatsMu.Unlock()
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *hzCollector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// note records a message of a class that is not a failure (a replica disagreement): counted,
+// and its first two messages kept.
+func (c *hzCollector) note(class string, format string, args ...any) {
+	c.mu.Lock()
+	c.counts[class]++
+	if c.counts[class] <= 2 {
+		c.msgs = append(c.msgs, c.name+" "+class+": "+fmt.Sprintf(format, args...))
+	}
+	c.mu.Unlock()
+}
+
+// failClass is a failure with a class: in collect mode the class is counted and only its
+// first two messages are kept.
+func (c *hzCollector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if hzCollecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- the switches
+
+// known: the recorded bugs (bugs.toml) the model can follow, indexed by the constants below in
+// bug order (the id of a switch is "kong/<index+1>"). The model (mParse, hegel_zoo_model_test.go)
+// is a pure function of (case, known): with every switch off (hzKnownNone) it states the
+// documented behaviour (the README's grammar and the design notes of the target README) and is
+// what the properties judge the library against; with a switch on it reproduces that bug as a
+// replica of kong's rule, transcribed from context.go and mapper.go at the point named beside
+// the switch. The classifier runs the model with several sets to name the shape of a case
+// before the library is called; the pins assert the documented behaviour and fail while the
+// bug exists.
+type known [6]bool
+
+const (
+	// kong/1: a short flag declared as a non-ASCII rune can never be given on the command line (Context.trace splits a short token by bytes)
+	kShortSplitsByBytes = iota
+	// kong/2: a flag with a default counts as used in its xor group, so giving the other member is an error (checkXorDuplicates counts Set members)
+	kDefaultsCountInXor
+	// kong/3: a flag with a default counts as used in its and group, so an empty command line is an error (checkAndMissing counts Set members)
+	kDefaultsCountInAnd
+	// kong/4: a -- after the first value of a cumulative positional ends it and the rest is unexpected (the slice and map decoders pop while IsValue)
+	kDashDashStopsCumulative
+	// kong/5: a required flag alone in its xor or lastwins group is not required at all (checkMissingFlags reports a choice group, and an and group, only with two or more missing; a lone and member too)
+	kLoneRequiredChoiceMember
+	// kong/6: a counter flag with a default increments from zero, not from the default (the counter mapper increments the traced zero)
+	kCounterIgnoresDefault
+	hzKnownCount
+)
+
+// hzKnownID is the bug id of a switch ("kong/N"); hzKnownIndex the switch of a bug id (-1
+// for none or the hole).
+func hzKnownID(i int) string { return "kong/" + strconv.Itoa(i+1) }
+
+func hzKnownIndex(id string) int {
+	n, err := strconv.Atoi(strings.TrimPrefix(id, "kong/"))
+	if err != nil || n < 1 || n > hzKnownCount {
+		return -1
+	}
+	return n - 1
+}
+
+var (
+	hzKnownNone = known{}
+	hzKnownAll  = func() known {
+		var k known
+		for i := range k {
+			k[i] = true
+		}
+		return k
+	}()
+)
+
+// hzKnownOnly is the set of the one switch i; hzKnownAllBut every switch but i.
+func hzKnownOnly(i int) known {
+	var k known
+	k[i] = true
+	return k
+}
+
+func hzKnownAllBut(i int) known {
+	k := hzKnownAll
+	k[i] = false
+	return k
+}
+
+// hzStats counts (hzTally) the shapes of the recorded bugs the cases have ("shape kong/N" per
+// case), the rule of the classifier that named them ("shape via sufficiency", "shape via
+// necessity", "shape hole"), the cases skipped for them under HEGEL_NO_KNOWN=1 ("known
+// kong/N"), the checks dropped for them under HEGEL_NO_KNOWN=1 ("dropped kong/N"), the draws
+// the filters rejected ("filtered <name>"), the replica's agreement with the library on the
+// shaped cases ("replica agreement", "replica disagreement"), and the wide property's outcome
+// classes ("ok", "err <class>"); printed and reset by the collector, under hzStatsMu. (A case
+// assumed away for an unrecorded candidate bug would be counted "candidate/go/kong-N ..."
+// here; none is left.)
+var (
+	hzStatsMu sync.Mutex
+	hzStats   = map[string]int{}
+)
+
+func hzTally(key string) {
+	hzStatsMu.Lock()
+	hzStats[key]++
+	hzStatsMu.Unlock()
+}
+
+// hzCaseJudge judges one drawn case (the go/excelize, go/bubbles, go/graphql-go, go/cobra,
+// go/cascadia, go/carbon, go/orb, go/chi, go/go-debian, go/gin and go/cellbuf judge, with the
+// collector's mismatch classes): it names the recorded bug whose shape the case has, so that
+// a mismatch or a library panic fails "(the shape of kong/N)", and under HEGEL_NO_KNOWN=1
+// skips the case instead (counted as known). The wide and the narrow properties share their
+// judge function and so this. The classifier that names the shape is computed from the case
+// alone (the model run with several sets of switches), before the library is called.
+type hzCaseJudge struct {
+	ht    *hegel.T
+	col   *hzCollector
+	shape string
+}
+
+// hzNewJudge is the judge of the case drawn by the property ht runs, reporting to col.
+func hzNewJudge(ht *hegel.T, col *hzCollector) *hzCaseJudge { return &hzCaseJudge{ht: ht, col: col} }
+
+// Shape records that the case has the shape of the recorded bug id ("" for none): counted,
+// and the first shape named is the one a failure reports. Under HEGEL_NO_KNOWN=1 the case is
+// assumed away (counted as known); the generators keep that rare (the shapes are filtered
+// out of the cases by the classifier, or the regions past them drawn), and the collector
+// measures it.
+func (j *hzCaseJudge) Shape(id string) {
+	if id == "" {
+		return
+	}
+	hzTally("shape " + id)
+	if j.shape == "" {
+		j.shape = id
+	}
+	if hzNoKnown {
+		hzTally("known " + id)
+		j.ht.Assume(false)
+	}
+}
+
+// Dropped is Shape for a shape that is some checks of a case rather than the whole case: by
+// default the shape is named and the checks are made (false); under HEGEL_NO_KNOWN=1 the
+// checks are dropped (true, counted as "dropped kong/N") and the case goes on
+// (judgeByDropping; no property of this target needs it, the form is kept with the harness).
+func (j *hzCaseJudge) Dropped(id string) bool {
+	if id == "" {
+		return false
+	}
+	if hzNoKnown {
+		hzTally("dropped " + id)
+		return true
+	}
+	j.Shape(id)
+	return false
+}
+
+// Named is the suffix a failure carries: the shape of the recorded bug, if any.
+func (j *hzCaseJudge) Named() string {
+	if j.shape == "" {
+		return ""
+	}
+	return " (the shape of " + j.shape + ")"
+}
+
+// Fail reports a mismatch of the given collector class, naming the shape: fatal normally,
+// recorded in collect mode (the property then goes on; a mismatch with no shape is counted
+// as "unshaped", the classifier's gap).
+func (j *hzCaseJudge) Fail(class, format string, args ...any) {
+	if j.shape == "" {
+		hzTally("unshaped")
+		class = "unshaped " + class
+	}
+	j.col.failClass(j.ht, class, format+"%s", append(args, j.Named())...)
+}
+
+// Note logs a line Hegel shows with a failure; the line is formatted at once, so a %v of a
+// library value is part of the test.
+func (j *hzCaseJudge) Note(format string, args ...any) {
+	j.ht.Log(fmt.Sprintf(format, args...))
+}
+
+// Recover, deferred in the property body after the judge is made, turns a panic in the code
+// under test into a failure naming the shape (hzProperty's own recovery sees only what this
+// lets through: Hegel's control flow). The wide property catches Parse's panics itself
+// (hzCatch) into the check value "panic: ..." so that they are judged like any other value;
+// this is the net under everything else.
+func (j *hzCaseJudge) Recover() {
+	r := recover()
+	if r == nil {
+		return
+	}
+	tn := reflect.TypeOf(r).String()
+	if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+		panic(r)
+	}
+	if e, ok := r.(error); ok && strings.Contains(e.Error(), "hegel") {
+		panic(r)
+	}
+	j.Fail("panic", "panic in the code under test: %v", r)
+}
+
+// judged runs one property over the cases: the judge is made, the library's panics are
+// recovered into failures naming the shape, and fn judges the case.
+func judged[T any](t *testing.T, cases hegel.Generator[T], fn func(j *hzCaseJudge, c T)) {
+	t.Helper()
+	col := hzNewCollector(t)
+	hzProperty(t, func(ht *hegel.T) {
+		c := hegel.Draw(ht, cases)
+		j := hzNewJudge(ht, col)
+		defer j.Recover()
+		fn(j, c)
+		col.count("cases")
+	})
+}
+
+// --------------------------------------------------------------------------- checks and the
+// classifier (the go/carbon, go/orb, go/chi, go/go-debian, go/gin and go/cellbuf form: every
+// value here is text compared exactly).
+
+// checks is the set of values a model states or the library gives, by check name: a model
+// returns the whole set for a case and a switch set, the property asks the library the same
+// questions, and the judge compares the two.
+type checks map[string]string
+
+func (c checks) set(name string, v any) { c[name] = fmt.Sprint(v) }
+
+// checkOrder is the order the checks of a case are reported in when it fails (the order the
+// model states them in): the result of kong.New, the error text, the selected command, then
+// the fields ("field <path><name>"), which sort by text.
+var checkOrder = map[string]int{
+	"new": 0, "err": 1, "cmd": 2,
+}
+
+func checkLess(a, b string) bool {
+	ar, aok := checkOrder[a]
+	br, bok := checkOrder[b]
+	if aok && bok && ar != br {
+		return ar < br
+	}
+	if aok != bok {
+		return aok
+	}
+	return a < b
+}
+
+func sortedKeys(c checks) []string {
+	keys := make([]string, 0, len(c))
+	for k := range c {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool { return checkLess(keys[i], keys[j]) })
+	return keys
+}
+
+// sameChecks reports whether two statements agree: the same checks, each value equal.
+func sameChecks(a, b checks) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if w, ok := b[k]; !ok || w != v {
+			return false
+		}
+	}
+	return true
+}
+
+// diffChecks lists the checks on which a (the library's values) and b (a model's) differ, in
+// check order.
+func diffChecks(a, b checks) string {
+	var parts []string
+	for _, k := range sortedKeys(a) {
+		if w, ok := b[k]; !ok || a[k] != w {
+			if !ok {
+				parts = append(parts, fmt.Sprintf("%s = %s, want (none)", k, a[k]))
+			} else {
+				parts = append(parts, fmt.Sprintf("%s = %s, want %s", k, a[k], w))
+			}
+		}
+	}
+	for _, k := range sortedKeys(b) {
+		if _, ok := a[k]; !ok {
+			parts = append(parts, fmt.Sprintf("%s = (none), want %s", k, b[k]))
+		}
+	}
+	return strings.Join(parts, "; ")
+}
+
+// shapeBy names the recorded bug whose shape the case has, from the model alone: none when
+// every switch leaves the model unchanged; else the first bug in bug order whose switch alone
+// moves the model from the documented values ("sufficiency"), else the first whose switch is
+// needed by the full set ("necessity"), else a hole ("kong/?", a defect of the model). The
+// order matters where two shapes meet (a defaulted xor member beside a lone required one
+// meets kong/2 and kong/5; a counter with a default inside a group kong/2 or 3 and kong/6):
+// sufficiency in bug order names the lower id.
+func shapeBy[T any](c T, expected func(T, known) checks) (string, string) {
+	none, all := expected(c, hzKnownNone), expected(c, hzKnownAll)
+	if sameChecks(none, all) {
+		return "", ""
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownOnly(i)), none) {
+			return hzKnownID(i), "sufficiency"
+		}
+	}
+	for i := 0; i < hzKnownCount; i++ {
+		if !sameChecks(expected(c, hzKnownAllBut(i)), all) {
+			return hzKnownID(i), "necessity"
+		}
+	}
+	return "kong/?", "hole"
+}
+
+// shapeID is the shape alone (the narrow properties' filters and the case filter).
+func shapeID[T any](c T, expected func(T, known) checks) string {
+	id, _ := shapeBy(c, expected)
+	return id
+}
+
+// classify names the shape of the case and counts the classifier's rule.
+func classify[T any](c T, expected func(T, known) checks) string {
+	shape, rule := shapeBy(c, expected)
+	if rule != "" {
+		hzTally("shape via " + rule)
+	}
+	return shape
+}
+
+// restrict is the library's values for the checks a model states; a check the model states
+// and the library cannot answer stays missing ("(none)").
+func restrict(got, to checks) checks {
+	out := checks{}
+	for k, v := range got {
+		if _, ok := to[k]; ok {
+			out[k] = v
+		}
+	}
+	return out
+}
+
+// classOf is the collector class of a check name: the name's first word ("field" for every
+// field check).
+func classOf(name string) string {
+	if i := strings.IndexByte(name, ' '); i > 0 {
+		return name[:i]
+	}
+	return name
+}
+
+// verdict judges the library's values against the documented ones (one failure listing every
+// differing check, classed by the first, naming the shape) after counting, on a shaped case,
+// whether the replica (every switch on) agrees with the library.
+func verdict[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks) {
+	verdictBy(j, c, got, want, shape, expected, sameChecks)
+}
+
+// verdictBy is verdict with the family's own notion of replica agreement (this target needs
+// none; the form is kept from go/chi, whose RouteHeaders replica is a set and agreement is
+// membership).
+func verdictBy[T any](j *hzCaseJudge, c T, got, want checks, shape string, expected func(T, known) checks, agrees func(got, replica checks) bool) {
+	if shape != "" {
+		if replica := expected(c, hzKnownAll); agrees(restrict(got, replica), replica) {
+			hzTally("replica agreement")
+		} else {
+			hzTally("replica disagreement")
+			j.col.note("replica disagreement", "%s for\n%#v", diffChecks(restrict(got, replica), replica), c)
+		}
+	}
+	got = restrict(got, want)
+	if sameChecks(got, want) {
+		return
+	}
+	class := ""
+	for _, k := range sortedKeys(want) {
+		if g, ok := got[k]; !ok || g != want[k] {
+			class = k
+			break
+		}
+	}
+	if class == "" {
+		for _, k := range sortedKeys(got) {
+			if _, ok := want[k]; !ok {
+				class = k
+				break
+			}
+		}
+	}
+	j.Fail(classOf(class), "%s for\n%#v", diffChecks(got, want), c)
+}
+
+// judgeBy is the judge of a family: the shape first, then the library.
+func judgeBy[T any](j *hzCaseJudge, c T, expected func(T, known) checks, actual func(T) checks) {
+	shape := classify(c, expected)
+	j.Shape(shape)
+	want := expected(c, hzKnownNone)
+	verdict(j, c, actual(c), want, shape, expected)
+}
+
+// judgeByDropping is judgeBy for a family whose shapes are some checks of a case rather than
+// the whole case (the go/orb, go/chi and go/go-debian form): by default the shape is named and
+// every check judged; under HEGEL_NO_KNOWN=1 the checks the shapes cover (those on which the
+// replica with every switch on differs from the documented model, or which it does not
+// state) are dropped from the case (hzCaseJudge.Dropped, counted "dropped kong/N") and the
+// rest judged, the case not skipped. No property of this target needs it (the shapes are
+// filtered out of the cases instead); kept with the harness.
+func judgeByDropping[T any](j *hzCaseJudge, c T, expected func(T, known) checks, actual func(T) checks) {
+	shape := classify(c, expected)
+	want := expected(c, hzKnownNone)
+	if shape != "" && j.Dropped(shape) {
+		all := expected(c, hzKnownAll)
+		for name, v := range want {
+			if w, ok := all[name]; !ok || w != v {
+				delete(want, name)
+			}
+		}
+		verdict(j, c, actual(c), want, "", expected)
+		return
+	}
+	verdict(j, c, actual(c), want, shape, expected)
+}
+
+// regionOf is the cases of the region of the recorded bug id, by the classifier: by default
+// only the cases with that shape, under HEGEL_NO_KNOWN=1 only the cases with none (the
+// rejections are counted as "filtered <id>"); the narrow properties' filter. The classifier
+// runs the model only (no library call), so a rejected draw costs a few parses.
+func regionOf[T any](id string, expected func(T, known) checks, cases hegel.Generator[T]) hegel.Generator[T] {
+	want := hzShaped(id, "")
+	return hzOnly(true, id, cases, func(c T) bool { return shapeID(c, expected) == want })
+}
+
+// withoutShapes is the cases of g with no shape by the classifier under HEGEL_NO_KNOWN=1
+// (each rejection counted "filtered kong/N" by the shape it had), g itself otherwise: the
+// wide property's case generator runs through it (a shape of kong/2 to 6 is a property of
+// the grammar and the argument list together), so that a case with a known shape is drawn
+// again rather than skipped.
+func withoutShapes[T any](expected func(T, known) checks, g hegel.Generator[T]) hegel.Generator[T] {
+	if !hzNoKnown {
+		return g
+	}
+	return hegel.Filter(g, func(c T) bool {
+		id := shapeID(c, expected)
+		if id != "" {
+			hzTally("filtered " + id)
+		}
+		return id == ""
+	})
+}
+
+// hzCatch runs f and returns what it panicked with, nil when it returned.
+func hzCatch(f func()) (recovered any) {
+	defer func() {
+		recovered = recover()
+	}()
+	f()
+	return nil
+}
