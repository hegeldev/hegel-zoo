+			ht.Fatalf("Mul: %v", err)
+		}
+		wantDecimal(ht, fmt.Sprintf("Mul(%s, 1) with RoundCeiling [prec %d Emin %d]", x, prec, emin), &d, wantCeil)
+		c.Rounding = RoundFloor
+		c.Mul(&d, x, New(1, 0))
