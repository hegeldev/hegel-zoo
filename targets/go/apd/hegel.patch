+// ---------------------------------------------------------------------------------------
+// Decimal-level helpers against models.
+
+// model renders a finite decimal (coefficient digits, exponent, sign) the way the Text
+// documentation describes for 'e', 'E' and 'f'.
+func modelText(neg bool, digits string, exp int, format byte) string {
+	sign := ""
+	if neg {
+		sign = "-"
+	}
+	switch format {
+	case 'e', 'E':
+		adj := exp + len(digits) - 1
+		s := digits[:1]
+		if len(digits) > 1 {
+			s += "." + digits[1:]
+		}
+		es := strconv.Itoa(adj)
+		if adj < 0 {
+			es = strconv.Itoa(-adj)
+		}
+		if adj < 0 {
+			es = "-" + es
+		} else {
+			es = "+" + es
+		}
+		return sign + s + string(format) + es
+	case 'f':
+		if exp >= 0 {
+			return sign + digits + strings.Repeat("0", exp)
+		}
+		frac := -exp
+		if frac >= len(digits) {
+			return sign + "0." + strings.Repeat("0", frac-len(digits)) + digits
+		}
+		return sign + digits[:len(digits)-frac] + "." + digits[len(digits)-frac:]
+	}
+	panic("format")
+}
+
+// Text('e'), Text('E') and Text('f') render the exact coefficient and exponent (the
+// exponent with as many digits as it needs — the documented two-digit minimum is apd/13);
+// 'g'/'G' pick one of them; String() parses back to the same representation;
+// Append equals Text; fmt's %e/%f/%g/%v agree with Text and honour width and sign flags.
+func TestHegelTextFormatsAgreeWithTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		xs := genDecimal(ht, 25, 40, 0)
+		d := parse(xs)
+		neg := strings.HasPrefix(xs, "-")
+		digits := d.Coeff.String()
+		exp := int(d.Exponent)
+		note(ht, "x=%s digits=%s exp=%d", xs, digits, exp)
+		for _, f := range []byte{'e', 'E', 'f'} {
+			if got, want := d.Text(f), modelText(neg, digits, exp, f); got != want {
+				ht.Fatalf("Text(%q) of %s = %q, want %q", f, xs, got, want)
+			}
+			if got := string(d.Append([]byte("v="), f)); got != "v="+d.Text(f) {
+				ht.Fatalf("Append(%q) of %s = %q, Text gives %q", f, xs, got, d.Text(f))
+			}
+		}
+		for _, f := range []byte{'g', 'G'} {
+			got := d.Text(f)
+			e := d.Text(f - 'g' + 'e')
+			if got != e && got != d.Text('f') {
+				ht.Fatalf("Text(%q) of %s = %q, neither %q nor %q", f, xs, got, e, d.Text('f'))
+			}
+			back, _, err := NewFromString(got)
+			if err != nil || back.CmpTotal(d) != 0 {
+				ht.Fatalf("Text(%q) of %s = %q does not parse back to it: %s %v", f, xs, got, back, err)
+			}
+		}
+		if d.String() != d.Text('G') {
+			ht.Fatalf("String() of %s = %q, Text('G') = %q", xs, d.String(), d.Text('G'))
+		}
+		for _, verb := range []string{"%e", "%E", "%f", "%F", "%g", "%G", "%v", "%s"} {
+			f := verb[1]
+			switch f {
+			case 'F':
+				f = 'f'
+			case 'v', 's':
+				f = 'G'
+			}
+			if got, want := fmt.Sprintf(verb, d), d.Text(f); got != want {
+				ht.Fatalf("Sprintf(%q, %s) = %q, Text(%q) = %q", verb, xs, got, f, want)
+			}
+		}
+		// Width, '+' and '-' flags.
+		w := n(ht, 0, 40)
+		plain := d.Text('e')
+		if got := fmt.Sprintf("%*e", w, d); strings.TrimLeft(got, " ") != plain || len(got) != max(w, len(plain)) {
+			ht.Fatalf("Sprintf(%%%de, %s) = %q", w, xs, got)
+		}
+		if got := fmt.Sprintf("%-*e|", w, d); strings.TrimRight(got, " |") != plain || len(got) != max(w, len(plain))+1 {
+			ht.Fatalf("Sprintf(%%-%de, %s) = %q", w, xs, got)
+		}
+		if got := fmt.Sprintf("%+f", d); !neg && got != "+"+d.Text('f') || neg && got != d.Text('f') {
+			ht.Fatalf("Sprintf(%%+f, %s) = %q", xs, got)
+		}
+		if got := fmt.Sprintf("% f", d); !neg && got != " "+d.Text('f') || neg && got != d.Text('f') {
+			ht.Fatalf("Sprintf(%% f, %s) = %q", xs, got)
+		}
+		if got := fmt.Sprintf("%0*f", w, d); len(got) != max(w, len(d.Text('f'))) || strings.TrimLeft(strings.TrimPrefix(got, "-"), "0") != strings.TrimLeft(strings.TrimPrefix(d.Text('f'), "-"), "0") {
+			ht.Fatalf("Sprintf(%%0%df, %s) = %q, Text('f') = %q", w, xs, got, d.Text('f'))
+		}
+	})
+}
