+// ErrDecimal computes what the Context computes, stops at the first error and reports it.
+func TestHegelErrDecimalMatchesContext(t *testing.T) {
+	ops := []string{"Add", "Sub", "Mul", "Quo", "QuoInteger", "Rem", "Abs", "Neg", "Sqrt", "Ln", "Exp", "Log10", "Pow", "Floor", "Ceil", "Round", "RoundToIntegralExact", "RoundToIntegralValue"}
+	property(t, func(ht *hegel.T) {
+		prec := n(ht, 1, 20)
+		c := &Context{Precision: uint32(prec), MaxExponent: int32(n(ht, 5, 999)), MinExponent: -int32(n(ht, 5, 999)), Traps: DefaultTraps, Rounding: pick(ht, roundings).apd}
+		if chance(ht, 30) {
+			c.Traps |= Inexact
+		}
+		e := MakeErrDecimal(c)
+		steps := n(ht, 1, 6)
+		var firstErr error
+		var flags Condition
+		for i := 0; i < steps; i++ {
+			name := pick(ht, ops)
+			xs, ys := genDecimal(ht, 10, 8, 4), genDecimal(ht, 5, 3, 2)
+			x, y := parse(xs), parse(ys)
+			var want, got Decimal
+			var cond Condition
+			var err error
+			switch name {
+			case "Add":
+				cond, err = c.Add(&want, x, y)
+				e.Add(&got, x, y)
+			case "Sub":
+				cond, err = c.Sub(&want, x, y)
+				e.Sub(&got, x, y)
+			case "Mul":
+				cond, err = c.Mul(&want, x, y)
+				e.Mul(&got, x, y)
+			case "Quo":
+				cond, err = c.Quo(&want, x, y)
+				e.Quo(&got, x, y)
+			case "QuoInteger":
+				cond, err = c.QuoInteger(&want, x, y)
+				e.QuoInteger(&got, x, y)
+			case "Rem":
+				cond, err = c.Rem(&want, x, y)
+				e.Rem(&got, x, y)
+			case "Abs":
+				cond, err = c.Abs(&want, x)
+				e.Abs(&got, x)
+			case "Neg":
+				cond, err = c.Neg(&want, x)
+				e.Neg(&got, x)
+			case "Sqrt":
+				cond, err = c.Sqrt(&want, x)
+				e.Sqrt(&got, x)
+			case "Ln":
+				cond, err = c.Ln(&want, x)
+				e.Ln(&got, x)
+			case "Exp":
+				cond, err = c.Exp(&want, x)
+				e.Exp(&got, x)
+			case "Log10":
+				cond, err = c.Log10(&want, x)
+				e.Log10(&got, x)
+			case "Pow":
+				cond, err = c.Pow(&want, x, y)
+				e.Pow(&got, x, y)
+			case "Floor":
+				cond, err = c.Floor(&want, x)
+				e.Floor(&got, x)
+			case "Ceil":
+				cond, err = c.Ceil(&want, x)
+				e.Ceil(&got, x)
+			case "Round":
+				cond, err = c.Round(&want, x)
+				e.Round(&got, x)
+			case "RoundToIntegralExact":
+				cond, err = c.RoundToIntegralExact(&want, x)
+				e.RoundToIntegralExact(&got, x)
+			case "RoundToIntegralValue":
+				cond, err = c.RoundToIntegralValue(&want, x)
+				e.RoundToIntegralValue(&got, x)
+			}
+			if firstErr == nil {
+				flags |= cond
+				if err != nil {
+					firstErr = err
+				} else if got.CmpTotal(&want) != 0 {
+					ht.Fatalf("step %d %s(%s, %s): ErrDecimal %s, Context %s", i, name, xs, ys, &got, &want)
+				}
+			}
+		}
+		if (e.Err() == nil) != (firstErr == nil) || firstErr != nil && e.Err().Error() != firstErr.Error() {
+			ht.Fatalf("ErrDecimal.Err() = %v, Context's first error %v", e.Err(), firstErr)
+		}
+		if firstErr == nil && e.Flags != flags {
+			ht.Fatalf("ErrDecimal.Flags = %s, accumulated conditions %s", e.Flags, flags)
+		}
+	})
+}
