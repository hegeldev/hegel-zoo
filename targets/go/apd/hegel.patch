+// z, x, y (z is the receiver, possibly aliased with x or y); the math side receives the
+// same values as big.Ints.  Both return a string describing every output.
+type bigOp struct {
+	name string
+	apd  func(z, x, y *BigInt, k, m int) string
+	math func(z, x, y *big.Int, k, m int) string
+}
