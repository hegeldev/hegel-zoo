+// Hegel property tests for apd (the Hegel zoo, https://github.com/hegeldev/hegel-zoo).
+//
+// Oracles: math/big for BigInt (apd's own testing/quick suite ported and widened to aliased
+// operands, more methods and mixed inline/heap sizes), and Python's decimal module — the
+// reference implementation of the same General Decimal Arithmetic specification apd
+// implements — for every Context operation, run as a child process with the same precision,
+// rounding, exponent range and no traps, comparing the result's exact representation and the
+// condition flags.  The Decimal-level helpers (formatting, conversions, Modf, Reduce,
+// Compose/Decompose, sql Scan/Value, text marshalling) are checked against small models and
+// round trips.
+package apd_test
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/gob"
+	"encoding/json"
+	"fmt"
+	"math"
+	"math/big"
+	"os"
+	"os/exec"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	. "github.com/cockroachdb/apd/v3"
+	"hegel.dev/go/hegel"
+)
+
+// ---------------------------------------------------------------------------------------
+// Harness (the zoo's Go conventions, see targets/go/jsonparser).
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if n, err := strconv.Atoi(s); err == nil && n > 0 {
+			return []hegel.Option{hegel.WithTestCases(n)}
+		}
+	}
+	return nil
+}
+
+// property runs fn as a Hegel property, turning a panic in the code under test into a
+// failure of the current test case (hegel-go re-raises panics after shrinking, which would
+// abort the test binary and hide every later test).  Hegel's own control-flow panics pass.
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int {
+	return int(hegel.Draw(tc, hegel.Integers[int64](int64(lo), int64(hi))))
+}
+func chance(tc hegel.TestCase, pct int) bool  { return hegel.Draw(tc, hegel.WeightedBooleans(float64(pct)/100)) }
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+// ---------------------------------------------------------------------------------------
+// Generators.
+
+var interesting = []string{
+	"-9223372036854775809", "-9223372036854775808", "-9223372036854775807", "-2147483648",
+	"-32768", "-128", "-1", "0", "1", "127", "255", "32767", "65535", "2147483647",
+	"4294967295", "9223372036854775806", "9223372036854775807", "9223372036854775808",
+	"18446744073709551614", "18446744073709551615", "18446744073709551616",
+	"340282366920938463463374607431768211455", "340282366920938463463374607431768211456",
+	"-340282366920938463463374607431768211456",
+}
+
+// genDigits draws a decimal coefficient of 1..maxDigits digits with no leading zero
+// (except the single digit 0).
+func genDigits(tc hegel.TestCase, maxDigits int) string {
+	k := n(tc, 1, maxDigits)
+	var sb strings.Builder
+	sb.WriteByte(byte('1' + n(tc, 0, 8)))
+	for i := 1; i < k; i++ {
+		sb.WriteByte(byte('0' + n(tc, 0, 9)))
+	}
+	if chance(tc, 10) {
+		return "0"
+	}
+	return sb.String()
+}
+
+// genInt draws a signed integer as a decimal string: an interesting edge value, a small
+// number, or a random one of up to maxDigits digits.
+func genInt(tc hegel.TestCase, maxDigits int) string {
+	switch {
+	case chance(tc, 30):
+		return pick(tc, interesting)
+	case chance(tc, 30):
+		return strconv.Itoa(n(tc, -1000, 1000))
+	}
+	s := genDigits(tc, maxDigits)
+	if s != "0" && chance(tc, 50) {
+		s = "-" + s
+	}
+	return s
+}
+
+func toApd(s string) *BigInt {
+	z, ok := new(BigInt).SetString(s, 10)
+	if !ok {
+		panic("bad number " + s)
+	}
+	return z
+}
+
+func toMath(s string) *big.Int {
+	z, ok := new(big.Int).SetString(s, 10)
+	if !ok {
+		panic("bad number " + s)
+	}
+	return z
+}
+
+// call runs f and returns its result, or "panic: <message>" if it panicked.
+func call(f func() string) (s string) {
+	defer func() {
+		if r := recover(); r != nil {
+			s = fmt.Sprintf("panic: %v", r)
+		}
+	}()
+	return f()
+}
+
