+// Float64 equals strconv.ParseFloat of the decimal's text; SetFloat64 holds the exact
+// binary value; Int64 is exact or an error; Scan/Value round trip through every supported
+// source type; MarshalText/UnmarshalText round trip.
+func TestHegelConversionsAgreeWithStrconv(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		xs := genDecimal(ht, 25, 330, 5)
+		d := parse(xs)
+		note(ht, "x=%s", xs)
+		// Float64.
+		f, err := d.Float64()
+		want, werr := strconv.ParseFloat(d.String(), 64)
+		if (err != nil) != (werr != nil) || (err == nil && !(f == want || math.IsNaN(f) && math.IsNaN(want))) {
+			ht.Fatalf("Float64 of %s = %v (%v); strconv.ParseFloat gives %v (%v)", xs, f, err, want, werr)
+		}
+		// Int64: exact integers in range only.
+		i, err := d.Int64()
+		var wantI *big.Int
+		if d.Form == Finite {
+			var r big.Rat
+			if _, ok := r.SetString(d.String()); ok && r.IsInt() && r.Num().IsInt64() {
+				wantI = r.Num()
+			}
+		}
+		if (wantI == nil) != (err != nil) || wantI != nil && i != wantI.Int64() {
+			ht.Fatalf("Int64 of %s = %d (%v); model %v", xs, i, err, wantI)
+		}
+		// MarshalText round trip.
+		text, err := d.MarshalText()
+		if err != nil {
+			ht.Fatalf("MarshalText of %s: %v", xs, err)
+		}
+		var back Decimal
+		if err := back.UnmarshalText(text); err != nil || back.CmpTotal(d) != 0 {
+			ht.Fatalf("UnmarshalText(%q) = %s (%v), want %s", text, &back, err, d)
+		}
+		// sql Scan from string, []byte and its own Value.
+		v, err := d.Value()
+		if err != nil {
+			ht.Fatalf("Value of %s: %v", xs, err)
+		}
+		for _, src := range []interface{}{d.String(), []byte(d.String()), v} {
+			var s Decimal
+			if err := s.Scan(src); err != nil || s.CmpTotal(d) != 0 {
+				ht.Fatalf("Scan(%#v) = %s (%v), want %s", src, &s, err, d)
+			}
+		}
+		// Scan from int64 and float64 sources.
+		k := int64(n(ht, -1<<40, 1<<40)) * int64(n(ht, 1, 1<<20))
+		var s Decimal
+		if err := s.Scan(k); err != nil || s.String() != strconv.FormatInt(k, 10) {
+			ht.Fatalf("Scan(int64 %d) = %s (%v)", k, &s, err)
+		}
+		if d.Form == Finite && err == nil {
+			if f, err := d.Float64(); err == nil && !math.IsInf(f, 0) {
+				var s Decimal
+				if err := s.Scan(f); err != nil {
+					ht.Fatalf("Scan(float64 %v): %v", f, err)
+				}
+				if g, _ := s.Float64(); g != f {
+					ht.Fatalf("Scan(float64 %v) = %s, whose Float64 is %v", f, &s, g)
+				}
+			}
+		}
+	})
+}
