+// apd/10: Log10 of an exact power of ten is flagged inexact and padded with zeros.
+func TestHegelLog10OfPowersOfTenIsExact(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		e := n(ht, -30, 30)
+		c := &Context{Precision: uint32(n(ht, 3, 20)), MaxExponent: 999, MinExponent: -999}
+		var d Decimal
+		cond, err := c.Log10(&d, parse("1E"+strconv.Itoa(e)))
+		if err != nil {
+			ht.Fatalf("Log10: %v", err)
+		}
+		if cond.Inexact() || d.CmpTotal(New(int64(e), 0)) != 0 {
+			ht.Fatalf("Log10(1E%d) = %s with condition %s, want %d exact", e, &d, cond, e)
+		}
+	})
+}
+
+// apd/11: the NaN produced by an impossible integer division takes the dividend's sign.
+func TestHegelNaNResultsAreUnsigned(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		prec := n(ht, 1, 5)
+		c := &Context{Precision: uint32(prec), MaxExponent: 999, MinExponent: -999}
+		x := parse("-" + genDigits(ht, 3) + "E" + strconv.Itoa(prec+n(ht, 1, 10)))
+		ht.Assume(x.Coeff.Sign() != 0)
+		var d Decimal
+		cond, _ := c.QuoInteger(&d, x, New(3, 0))
+		ht.Assume(cond.DivisionImpossible())
+		if d.Negative {
+			ht.Fatalf("QuoInteger(%s, 3) [prec %d] = %s, want NaN", x, prec, &d)
+		}
+	})
+}
+
+// apd/12: Decimal.Reduce drops the sign of a negative zero (Context.Reduce keeps it).
+func TestHegelReduceKeepsTheSignOfZero(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		x := parse("-0E" + strconv.Itoa(n(ht, -20, 20)))
+		var r Decimal
+		r.Reduce(x)
+		if !r.Negative {
+			ht.Fatalf("Reduce(%s) = %s, want -0", x, &r)
+		}
+	})
+}
