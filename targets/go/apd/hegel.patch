+// Context.SetString rounds a parsed string exactly as Python's create_decimal, with the
+// same flags; the plain SetString keeps the exact representation, and String() round
+// trips through both parsers.
+func TestHegelSetStringAgreesWithPythonDecimal(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c, base := drawContext(ht, 1, 40)
+		xs := genDecimal(ht, 40, 80, 5)
+		// Spell it in one of the ways both parsers accept.
+		spell := xs
+		if d := parse(xs); d.Form == Finite && chance(ht, 50) {
+			spell = pick(ht, []string{d.Text('e'), d.Text('E'), d.Text('f'), d.Text('g'), d.Text('G'), d.String()})
+		}
+		note(ht, "s=%q prec=%d rounding=%s", spell, c.Precision, c.Rounding)
+		q := base
+		q.Op, q.Args = "round", []string{spell}
+		want := ask(ht, q)
+		ht.Assume(!strings.Contains(strings.Join(want.Flags, ","), "Overflow"))  // apd/3
+		ht.Assume(!strings.Contains(strings.Join(want.Flags, ","), "Subnormal")) // apd/2
+		d, cond, err := c.NewFromString(spell)
+		if err != nil {
+			ht.Fatalf("NewFromString(%q): %v", spell, err)
+		}
+		if !sameRepr(d, *want.Result) {
+			ht.Fatalf("Context.NewFromString(%q) [prec %d %s] = %s, Python create_decimal %s", spell, c.Precision, c.Rounding, d, *want.Result)
+		}
+		noRounded := func(fs []string) (out []string) {
+			for _, f := range fs {
+				if f != "Rounded" {
+					out = append(out, f)
+				}
+			}
+			return
+		}
+		if gf, wf := sortedFlags(noRounded(flagNames(cond))), sortedFlags(noRounded(want.Flags)); gf != wf {
+			ht.Fatalf("Context.NewFromString(%q) [prec %d %s]: condition %s (%q), Python flags %q", spell, c.Precision, c.Rounding, cond, gf, wf)
+		}
+		// The exact parse and its string round trip.
+		e, cond, err := NewFromString(spell)
+		if err != nil || cond != 0 {
+			ht.Fatalf("NewFromString(%q): %v, condition %s", spell, err, cond)
+		}
+		q.Op, q.Args, q.Prec = "to_sci", []string{spell}, 400
+		if want := ask(ht, q); !sameRepr(e, *want.Result) {
+			ht.Fatalf("NewFromString(%q).String() = %s, Python str() %s", spell, e, *want.Result)
+		}
+		back, _, err := NewFromString(e.String())
+		if err != nil || back.CmpTotal(e) != 0 {
+			ht.Fatalf("String round trip of %q: %s -> %s (%v)", spell, e, back, err)
+		}
+	})
+}
