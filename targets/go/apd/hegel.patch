+// SetFloat64 sets the shortest decimal that converts back to the float, with its sign,
+// and Float64 inverts it.
+func TestHegelSetFloat64RoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		var f float64
+		switch n(ht, 0, 3) {
+		case 0:
+			f = math.Float64frombits(uint64(hegel.Draw(ht, hegel.Integers[int64](math.MinInt64, math.MaxInt64))))
+		case 1:
+			f = float64(n(ht, -1000000, 1000000)) / float64(n(ht, 1, 1000))
+		case 2:
+			f = pick(ht, []float64{0, math.Copysign(0, -1), 1, -1, 0.1, 1e-320, 5e-324, math.MaxFloat64, math.SmallestNonzeroFloat64, 1e22, 1e23, 123456789.125})
+		default:
+			f = math.Ldexp(float64(n(ht, -1<<30, 1<<30)), n(ht, -1074, 970))
+		}
+		if math.IsNaN(f) || math.IsInf(f, 0) {
+			ht.Assume(false)
+		}
+		note(ht, "f=%v bits=%x", f, math.Float64bits(f))
+		var d Decimal
+		if _, err := d.SetFloat64(f); err != nil {
+			ht.Fatalf("SetFloat64(%v): %v", f, err)
+		}
+		// The value is the shortest decimal that round-trips to f (the exact binary value the
+		// documentation promises is pinned as apd/14).
+		if want := strconv.FormatFloat(f, 'e', -1, 64); parse(want).Cmp(&d) != 0 {
+			ht.Fatalf("SetFloat64(%v) = %s, shortest representation %s", f, d.Text('e'), want)
+		}
+		if math.Signbit(f) != d.Negative && f != 0 {
+			ht.Fatalf("SetFloat64(%v): Negative=%v", f, d.Negative)
+		}
+		if back, err := d.Float64(); err != nil || back != f {
+			ht.Fatalf("SetFloat64(%v).Float64() = %v (%v)", f, back, err)
+		}
+	})
+}
