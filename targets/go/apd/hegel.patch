+// The BigInt methods agree with math/big.Int — results, panics and the receiver's final
+// value — for every method, with the receiver aliased to an operand or not, over values
+// that are inline (small) or heap-backed (up to 60 digits).
+func TestHegelBigIntAgreesWithMathBig(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		op := pick(ht, bigOps)
+		zs, xs, ys := genInt(ht, 60), genInt(ht, 60), genInt(ht, 60)
+		k, m := n(ht, 0, 70), n(ht, 0, 70)
+		alias := n(ht, 0, 3) // 0: distinct, 1: z==x, 2: z==y, 3: x==y
+		note(ht, "op=%s z=%s x=%s y=%s k=%d m=%d alias=%d", op.name, zs, xs, ys, k, m, alias)
+
+		za, xa, ya := toApd(zs), toApd(xs), toApd(ys)
+		zb, xb, yb := toMath(zs), toMath(xs), toMath(ys)
+		switch alias {
+		case 1:
+			za, zb = xa, xb
+		case 2:
+			za, zb = ya, yb
+		case 3:
+			ya, yb = xa, xb
+		}
+		ra := call(func() string { return op.apd(za, xa, ya, k, m) })
+		rb := call(func() string { return op.math(zb, xb, yb, k, m) })
+		if ra != rb {
+			ht.Fatalf("%s: apd %q, math/big %q", op.name, ra, rb)
+		}
+		// The receiver and operands must end up the same too.
+		if za.String() != zb.String() || xa.String() != xb.String() || ya.String() != yb.String() {
+			ht.Fatalf("%s: after the call apd z=%s x=%s y=%s, math/big z=%s x=%s y=%s",
+				op.name, za, xa, ya, zb, xb, yb)
+		}
+		// And the apd value must round-trip through math/big.
+		if rt := new(BigInt).SetMathBigInt(za.MathBigInt()); rt.Cmp(za) != 0 {
+			ht.Fatalf("%s: round trip through big.Int changed %s into %s", op.name, za, rt)
+		}
+	})
+}
+
+// SetString on BigInt agrees with big.Int on arbitrary strings (accepted or not) in every
+// base, including base 0 with prefixes and underscores.
+func TestHegelBigIntSetStringAgreesWithMathBig(t *testing.T) {
+	alphabet := []rune("0123456789abcdefxyzXYZ_+- .oObB")
+	property(t, func(ht *hegel.T) {
+		var s string
+		if chance(ht, 50) {
+			s = genInt(ht, 40)
+			if chance(ht, 30) {
+				s = pick(ht, []string{"0x", "0X", "0b", "0o", "0", "+", "-", "-0x"}) + strings.TrimPrefix(s, "-")
+			}
+		} else {
+			k := n(ht, 0, 12)
+			rs := make([]rune, k)
+			for i := range rs {
+				rs[i] = pick(ht, alphabet)
+			}
+			s = string(rs)
+		}
+		base := pick(ht, []int{0, 2, 8, 10, 16, 36, 62})
+		note(ht, "s=%q base=%d", s, base)
+		za, oka := new(BigInt).SetString(s, base)
+		zb, okb := new(big.Int).SetString(s, base)
+		if oka != okb {
+			ht.Fatalf("SetString(%q, %d): apd ok=%v, math/big ok=%v", s, base, oka, okb)
+		}
+		if oka && za.String() != zb.String() {
+			ht.Fatalf("SetString(%q, %d): apd %s, math/big %s", s, base, za, zb)
+		}
+		if !oka && za != nil {
+			ht.Fatalf("SetString(%q, %d): apd returned %v with ok=false (math/big returns nil)", s, base, za)
+		}
+	})
+}
+
+// NumDigits counts the decimal digits of a BigInt's absolute value.
+func TestHegelNumDigitsCountsDigits(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		s := genInt(ht, 80)
+		want := int64(len(strings.TrimPrefix(s, "-")))
+		got := NumDigits(toApd(s))
+		if got != want {
+			ht.Fatalf("NumDigits(%s) = %d, want %d", s, got, want)
+		}
+		if d := NewWithBigInt(toApd(strings.TrimPrefix(s, "-")), 0); d.NumDigits() != want {
+			ht.Fatalf("Decimal(%s).NumDigits() = %d, want %d", s, d.NumDigits(), want)
+		}
+	})
+}
+
+// ---------------------------------------------------------------------------------------
+// The Python oracle.
+
+const pyOracle = `
+import sys, json, decimal
+from decimal import Decimal, Context
+R = {r: getattr(decimal, r) for r in ["ROUND_DOWN","ROUND_HALF_UP","ROUND_HALF_EVEN","ROUND_CEILING","ROUND_FLOOR","ROUND_HALF_DOWN","ROUND_UP","ROUND_05UP"]}
+for line in sys.stdin:
+    q = json.loads(line)
+    ctx = Context(prec=q["prec"], rounding=R[q["rounding"]], Emin=q["emin"], Emax=q["emax"], capitals=1, clamp=0, traps=[], flags=[])
+    a = [Decimal(s) for s in q["args"]]
+    op = q["op"]; r = None; err = None
+    try:
+        if op == "add": r = ctx.add(a[0], a[1])
+        elif op == "subtract": r = ctx.subtract(a[0], a[1])
+        elif op == "multiply": r = ctx.multiply(a[0], a[1])
+        elif op == "divide": r = ctx.divide(a[0], a[1])
+        elif op == "divide_int": r = ctx.divide_int(a[0], a[1])
+        elif op == "remainder": r = ctx.remainder(a[0], a[1])
+        elif op == "abs": r = ctx.abs(a[0])
+        elif op == "minus": r = ctx.minus(a[0])
+        elif op == "plus": r = ctx.plus(a[0])
+        elif op == "compare": r = ctx.compare(a[0], a[1])
+        elif op == "compare_total": r = ctx.compare_total(a[0], a[1])
+        elif op == "quantize": r = ctx.quantize(a[0], Decimal((0, (1,), q["exp"])))
+        elif op == "reduce": r = ctx.normalize(a[0])
+        elif op == "round": r = ctx.create_decimal(a[0])
+        elif op == "to_integral_exact": r = ctx.to_integral_exact(a[0])
+        elif op == "to_integral_value": r = ctx.to_integral_value(a[0])
+        elif op == "floor": r = ctx.create_decimal(a[0].to_integral_value(rounding=decimal.ROUND_FLOOR, context=ctx))
+        elif op == "ceil": r = ctx.create_decimal(a[0].to_integral_value(rounding=decimal.ROUND_CEILING, context=ctx))
+        elif op == "sqrt": r = ctx.sqrt(a[0])
+        elif op == "exp": r = ctx.exp(a[0])
+        elif op == "ln": r = ctx.ln(a[0])
+        elif op == "log10": r = ctx.log10(a[0])
+        elif op == "power": r = ctx.power(a[0], a[1])
+        elif op == "to_sci": r = str(a[0])
+        elif op == "to_eng": r = a[0].to_eng_string()
+        else: err = "unknown op " + op
+    except Exception as e:
+        err = repr(e)
+    flags = sorted(k.__name__ for k, v in ctx.flags.items() if v and k.__name__ != "FloatOperation")
+    print(json.dumps({"result": None if r is None else str(r), "flags": flags, "error": err}), flush=True)
+`
+
+type pyReq struct {
+	Op       string   `json:"op"`
+	Args     []string `json:"args"`
+	Prec     int      `json:"prec"`
+	Rounding string   `json:"rounding"`
+	Emin     int      `json:"emin"`
+	Emax     int      `json:"emax"`
+	Exp      int      `json:"exp"`
+}
+
+type pyResp struct {
+	Result *string  `json:"result"`
+	Flags  []string `json:"flags"`
+	Error  *string  `json:"error"`
+}
+
+var (
+	pyOnce sync.Once
+	pyIn   *bufio.Writer
+	pyOut  *bufio.Reader
+	pyErr  error
+)
+
+func python() (*bufio.Writer, *bufio.Reader, error) {
+	pyOnce.Do(func() {
+		cmd := exec.Command("python3", "-c", pyOracle)
+		cmd.Stderr = os.Stderr
+		in, err := cmd.StdinPipe()
+		if err != nil {
+			pyErr = err
+			return
+		}
+		out, err := cmd.StdoutPipe()
+		if err != nil {
+			pyErr = err
+			return
+		}
+		if err := cmd.Start(); err != nil {
+			pyErr = err
+			return
+		}
+		pyIn, pyOut = bufio.NewWriter(in), bufio.NewReader(out)
+	})
+	return pyIn, pyOut, pyErr
+}
+
+func ask(t *hegel.T, q pyReq) pyResp {
+	in, out, err := python()
+	if err != nil {
+		panic("python3 oracle: " + err.Error())
+	}
+	b, _ := json.Marshal(q)
+	in.Write(b)
+	in.WriteByte('\n')
+	if err := in.Flush(); err != nil {
+		panic("python3 oracle write: " + err.Error())
+	}
+	line, err := out.ReadBytes('\n')
+	if err != nil {
+		panic("python3 oracle read: " + err.Error())
+	}
+	var r pyResp
+	if err := json.Unmarshal(line, &r); err != nil {
+		panic("python3 oracle: bad reply " + string(line))
+	}
+	if r.Error != nil {
+		panic("python3 oracle: " + *r.Error)
+	}
+	return r
+}
+
+// ---------------------------------------------------------------------------------------
+// Decimal generators and the Context differential.
+
+var roundings = []struct {
+	apd Rounder
+	py  string
+}{
+	{RoundDown, "ROUND_DOWN"}, {RoundHalfUp, "ROUND_HALF_UP"}, {RoundHalfEven, "ROUND_HALF_EVEN"},
+	{RoundCeiling, "ROUND_CEILING"}, {RoundFloor, "ROUND_FLOOR"}, {RoundHalfDown, "ROUND_HALF_DOWN"},
+	{RoundUp, "ROUND_UP"}, {Round05Up, "ROUND_05UP"},
+}
+
+// genDecimal draws a finite decimal as "[-]coefficientE<exp>" with up to maxDigits
+// digits (trailing zeros included) and an exponent within ±expRange, or, with pct chance,
+// a special value.
+func genDecimal(tc hegel.TestCase, maxDigits, expRange, specialPct int) string {
+	if chance(tc, specialPct) {
+		return pick(tc, []string{"Infinity", "-Infinity", "NaN", "-NaN", "sNaN", "-sNaN"})
+	}
+	coeff := genDigits(tc, maxDigits)
+	if chance(tc, 25) {
+		coeff += strings.Repeat("0", n(tc, 1, 6))
+	}
+	exp := n(tc, -expRange, expRange)
+	if chance(tc, 30) {
+		exp = n(tc, -3, 3)
+	}
+	s := coeff + "E" + strconv.Itoa(exp)
+	if chance(tc, 45) {
+		s = "-" + s
+	}
+	return s
+}
+
+func parse(s string) *Decimal {
+	d, _, err := new(Decimal).SetString(s)
+	if err != nil {
+		panic("parse " + s + ": " + err.Error())
+	}
+	return d
+}
+
+// flagNames maps an apd Condition to Python's flag names (GDA's division-impossible and
+// division-undefined are sub-conditions of invalid-operation, which is the flag Python
+// records); the system-limit flags have no Python counterpart.
+func flagNames(c Condition) []string {
+	var out []string
+	if c.Inexact() {
+		out = append(out, "Inexact")
+	}
+	if c.Rounded() {
+		out = append(out, "Rounded")
+	}
+	if c.Subnormal() {
+		out = append(out, "Subnormal")
+	}
+	if c.Underflow() {
+		out = append(out, "Underflow")
+	}
+	if c.Overflow() {
+		out = append(out, "Overflow")
+	}
+	if c.Clamped() {
+		out = append(out, "Clamped")
+	}
+	if c.DivisionByZero() {
+		out = append(out, "DivisionByZero")
+	}
+	if c.InvalidOperation() || c.DivisionImpossible() || c.DivisionUndefined() {
+		out = append(out, "InvalidOperation")
+	}
+	return out
+}
+
+func sortedFlags(xs []string) string {
+	m := map[string]bool{}
+	for _, x := range xs {
+		m[x] = true
+	}
+	var out []string
+	for k := range m {
+		out = append(out, k)
+	}
+	// small slices: insertion sort
+	for i := 1; i < len(out); i++ {
+		for j := i; j > 0 && out[j] < out[j-1]; j-- {
+			out[j], out[j-1] = out[j-1], out[j]
+		}
+	}
+	return strings.Join(out, ",")
+}
+
+// ctxOp is one Context operation and its Python counterpart.
+type ctxOp struct {
+	name  string
+	arity int
+	py    string
+	run   func(c *Context, d, x, y *Decimal, exp int32) (Condition, error)
+}
+
+var ctxOps = []ctxOp{
+	{"Add", 2, "add", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Add(d, x, y) }},
+	{"Sub", 2, "subtract", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Sub(d, x, y) }},
+	{"Mul", 2, "multiply", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Mul(d, x, y) }},
+	{"Quo", 2, "divide", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Quo(d, x, y) }},
+	{"QuoInteger", 2, "divide_int", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.QuoInteger(d, x, y) }},
+	{"Rem", 2, "remainder", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Rem(d, x, y) }},
+	{"Abs", 1, "abs", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Abs(d, x) }},
+	{"Neg", 1, "minus", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Neg(d, x) }},
+	{"Cmp", 2, "compare", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Cmp(d, x, y) }},
+	{"Quantize", 1, "quantize", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Quantize(d, x, e) }},
+	{"Reduce", 1, "reduce", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) {
+		_, res, err := c.Reduce(d, x)
+		return res, err
+	}},
+	{"Round", 1, "round", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Round(d, x) }},
+	{"RoundToIntegralExact", 1, "to_integral_exact", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.RoundToIntegralExact(d, x) }},
+	{"RoundToIntegralValue", 1, "to_integral_value", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.RoundToIntegralValue(d, x) }},
+	{"Floor", 1, "floor", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Floor(d, x) }},
+	{"Ceil", 1, "ceil", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Ceil(d, x) }},
+	{"Sqrt", 1, "sqrt", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Sqrt(d, x) }},
+	{"Exp", 1, "exp", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Exp(d, x) }},
+	{"Ln", 1, "ln", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Ln(d, x) }},
+	{"Log10", 1, "log10", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Log10(d, x) }},
+	{"Pow", 2, "power", func(c *Context, d, x, y *Decimal, e int32) (Condition, error) { return c.Pow(d, x, y) }},
+}
+
+func opByName(name string) ctxOp {
+	for _, o := range ctxOps {
+		if o.name == name {
+			return o
+		}
+	}
+	panic(name)
+}
+
+// drawContext draws a Context (no traps) and the matching Python parameters.
+func drawContext(tc hegel.TestCase, minPrec, maxPrec int) (*Context, pyReq) {
+	prec := n(tc, minPrec, maxPrec)
+	if chance(tc, 20) {
+		prec = n(tc, minPrec, min(maxPrec, 5))
+	}
+	r := pick(tc, roundings)
+	emax := pick(tc, []int{6, 99, 999, 9999})
+	emin := -emax
+	if chance(tc, 30) {
+		emin = -pick(tc, []int{6, 99, 999, 9999})
+	}
+	c := &Context{Precision: uint32(prec), MaxExponent: int32(emax), MinExponent: int32(emin), Traps: 0, Rounding: r.apd}
+	return c, pyReq{Prec: prec, Rounding: r.py, Emin: emin, Emax: emax}
+}
+
+// ulpApart reports whether two finite decimals differ by exactly one unit in the last
+// place of the result (apd's own GDA harness allows 1 ulp for exp, ln, log10 and power).
+func ulpApart(a, b *Decimal) bool {
+	if a.Form != Finite || b.Form != Finite {
+		return false
+	}
+	var diff Decimal
+	c := &Context{Precision: 0, MaxExponent: MaxExponent, MinExponent: MinExponent}
+	if _, err := c.Sub(&diff, a, b); err != nil {
+		return false
+	}
+	if diff.Form != Finite || diff.Coeff.Cmp(NewBigInt(1)) != 0 {
+		return false
+	}
+	return diff.Exponent == a.Exponent || diff.Exponent == b.Exponent
+}
+
+// sameRepr reports whether apd's result and Python's have the same representation: form,
+// sign, coefficient and exponent (apd prints small zeros as 0.000 for PostgreSQL's sake,
+// so strings are not compared).
+func sameRepr(d *Decimal, py string) bool {
+	w, _, err := NewFromString(py)
+	if err != nil {
+		return false
+	}
+	if (d.Form == NaN || d.Form == NaNSignaling) && d.Form == w.Form {
+		return true // the sign of a NaN result is pinned separately (apd/11)
+	}
+	if d.Form == Finite && w.Form == Finite && d.Coeff.Sign() == 0 && w.Coeff.Sign() == 0 {
+		return d.Negative == w.Negative // zero exponents beyond the range are clamped by Python, not apd (not counted)
+	}
+	return d.CmpTotal(w) == 0 && d.Negative == w.Negative
+}
+
+// sameValue compares numerically only (same sign of zero), for the operations whose
+// result exponent is pinned as differing from GDA's ideal exponent (apd/9, apd/10).
+func sameValue(d *Decimal, py string) bool {
+	w, _, err := NewFromString(py)
+	if err != nil {
+		return false
+	}
+	if d.Form != Finite || w.Form != Finite {
+		return sameRepr(d, py)
+	}
+	return d.Cmp(w) == 0 && d.Negative == w.Negative
+}
+
+// adjusted returns the adjusted exponent of a finite decimal (exponent of its first digit).
+func adjusted(d *Decimal) int64 { return int64(d.Exponent) + d.NumDigits() - 1 }
+
+// pinned reports whether a case has one of the shapes pinned as an expected failure, so
+// that the general properties leave it out (each is asserted by its own test below).
+func pinned(op ctxOp, c *Context, x, y *Decimal, exp int32, want pyResp) bool {
+	flags := map[string]bool{}
+	for _, f := range want.Flags {
+		flags[f] = true
+	}
+	if flags["Overflow"] {
+		return true // apd/3: overflow ignores the rounding mode
+	}
+	if flags["Subnormal"] {
+		return true // apd/2: subnormal directed rounding of negative numbers
+	}
+	switch op.name {
+	case "Quantize", "RoundToIntegralExact", "RoundToIntegralValue":
+		target := int64(exp)
+		if op.name != "Quantize" {
+			target = 0
+		}
+		if x.Form == Finite && x.Coeff.Sign() != 0 && adjusted(x) < target {
+			return true // apd/1: a value below one unit rounds to zero in every mode
+		}
+		if op.name != "Quantize" && x.Form == Finite && x.Exponent > 0 {
+			return true // apd/9: the positive exponent is not kept
+		}
+		if op.name != "Quantize" && x.Form == Finite && x.Coeff.Sign() != 0 && adjusted(x) > int64(c.MaxExponent) {
+			return true // apd clamps every result to the exponent range; GDA's to-integral does not (not counted)
+		}
+		if op.name == "Quantize" && x.Form == Finite && exp > x.Exponent &&
+			x.NumDigits()-int64(exp-x.Exponent)-1 > int64(c.MaxExponent) {
+			return true // apd/17: a result with more than MaxExponent+1 digits is NaN when digits are discarded
+		}
+	case "Floor", "Ceil":
+		if x.Form != Finite {
+			return true // apd/4
+		}
+		if flags["Rounded"] {
+			return true // apd/8: the integral part is not rounded to the precision
+		}
+	case "Neg":
+		if c.Rounding == RoundFloor && x.Form == Finite && x.Coeff.Sign() == 0 {
+			return true // GDA's minus(0) is -0 under round-floor; apd's Neg flips the sign (not counted)
+		}
+	case "Exp":
+		if c.Precision <= 3 {
+			return true // apd/5
+		}
+		if x.Form == Finite {
+			var lim Decimal
+			lim.SetInt64(20000)
+			if new(Decimal).Abs(x).Cmp(&lim) > 0 {
+				return true // apd/6
+			}
+		}
+	case "Quo":
+		if want.Result != nil && flags["Inexact"] {
+			if w, _, err := NewFromString(*want.Result); err == nil && w.Form == Finite {
+				one := "1" + strings.Repeat("0", int(c.Precision)-1)
+				if w.Coeff.String() == one {
+					return true // apd/8: a rounding carry leaves precision+1 digits
+				}
+			}
+		}
+	case "Sqrt":
+		if x.Form == Finite && x.Coeff.Sign() == 0 {
+			return true // apd/9: exponent of the square root of zero
+		}
+	case "Reduce":
+		if flags["Inexact"] {
+			return true // apd/16: zeros produced by the rounding are not removed
+		}
+	case "Rem":
+		if y.Form == Infinite {
+			return true // apd/8: the dividend comes back unrounded
+		}
+	}
+	return false
+}
+
+// compareWithPython runs one Context operation in apd and in Python and returns a
+// description of any disagreement ("" if none).  Flags named in ignore are not compared.
+func compareWithPython(ht *hegel.T, c *Context, base pyReq, op ctxOp, xs, ys string, exp int32, alias bool, oneUlp bool, ignore ...string) string {
+	x, y := parse(xs), parse(ys)
+	d := new(Decimal)
+	if alias && op.name != "Floor" && op.name != "Ceil" { // apd/15: Floor/Ceil with an aliased result
+		d = x
+	}
+	args := []string{xs}
+	if op.arity == 2 {
+		args = append(args, ys)
+	}
+	q := base
+	q.Op, q.Args, q.Exp = op.py, args, int(exp)
+	want := ask(ht, q)
+	if want.Result == nil {
+		panic("python3 oracle returned no result")
+	}
+	ht.Assume(!pinned(op, c, x, y, exp, want))
+	cond, err := op.run(c, d, x, y, exp)
+	where := fmt.Sprintf("%s(%s, %s) [prec %d %s Emax %d Emin %d]", op.name, xs, ys, c.Precision, c.Rounding, c.MaxExponent, c.MinExponent)
+	if op.arity == 1 {
+		where = fmt.Sprintf("%s(%s) [prec %d %s Emax %d Emin %d]", op.name, xs, c.Precision, c.Rounding, c.MaxExponent, c.MinExponent)
+		if op.name == "Quantize" {
+			where = fmt.Sprintf("Quantize(%s, %d) [prec %d %s Emax %d Emin %d]", xs, exp, c.Precision, c.Rounding, c.MaxExponent, c.MinExponent)
+		}
+	}
+	if err != nil {
+		return fmt.Sprintf("%s: apd error %v (condition %s); Python gives %s flags %v", where, err, cond, *want.Result, want.Flags)
+	}
+	wantS := *want.Result
+	same := sameRepr(d, wantS)
+	switch op.name {
+	case "Quo", "Log10", "Sqrt", "Exp", "Ln", "Pow":
+		same = sameValue(d, wantS) // apd/9, apd/10: the representation is pinned separately
+	}
+	if !same {
+		if w, _, err := NewFromString(wantS); oneUlp && err == nil && ulpApart(d, w) {
+			note(ht, "%s: %s is within 1 ulp of Python's %s (tolerated)", op.name, d, wantS)
+		} else {
+			return fmt.Sprintf("%s: apd %s (condition %s), Python %s (flags %v)", where, d, cond, wantS, want.Flags)
+		}
+	}
+	// Rounded is never compared: apd's own GDA harness strips it ("TODO(mjibson): after
+	// upscaling, operations need to remove the 0s added"), and apd raises it on exact zero
+	// results where Python does not.
+	drop := map[string]bool{"Rounded": true}
+	if d.Form == Finite && d.Coeff.Sign() == 0 {
+		drop["Clamped"] = true // a zero's exponent beyond the range: apd and Python flag it differently
+	}
+	for _, f := range ignore {
+		drop[f] = true
+	}
+	filter := func(fs []string) []string {
+		var out []string
+		for _, f := range fs {
+			if !drop[f] {
+				out = append(out, f)
+			}
+		}
+		return out
+	}
+	gf, wf := sortedFlags(filter(flagNames(cond))), sortedFlags(filter(want.Flags))
+	if gf != wf {
+		return fmt.Sprintf("%s = %s: apd condition %s (compared as %q), Python flags %q", where, d, cond, gf, wf)
+	}
+	return ""
+}
