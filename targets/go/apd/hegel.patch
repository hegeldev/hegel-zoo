+// apd/2: in the subnormal range, RoundCeiling and RoundFloor act on negative numbers as if
+// they were positive (ceiling moves away from zero, floor towards it).
+func TestHegelSubnormalDirectedRoundingRespectsTheSign(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		prec := n(ht, 1, 5)
+		emin := -n(ht, 2, 9)
+		etiny := emin - prec + 1
+		c := &Context{Precision: uint32(prec), MaxExponent: 99, MinExponent: int32(emin)}
+		// A negative value strictly between two multiples of 10^etiny.
+		digits := genDigits(ht, 3)
+		ht.Assume(!strings.HasSuffix(digits, "0"))
+		x := parse("-" + digits + "E" + strconv.Itoa(etiny-len(digits)))
+		q := pyReq{Prec: prec, Rounding: "ROUND_CEILING", Emin: emin, Emax: 99, Op: "multiply", Args: []string{x.String(), "1"}}
+		wantCeil := *ask(ht, q).Result
