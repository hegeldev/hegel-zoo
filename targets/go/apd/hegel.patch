+// apd/1: a value smaller than one unit of the target exponent rounds to zero under every
+// rounding mode; ceiling, floor (for negatives), up and 05up must produce one unit.
+func TestHegelQuantizeRoundsTinyValuesInTheRoundingDirection(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		c := &Context{Precision: 10, MaxExponent: 999, MinExponent: -999}
+		exp := int32(n(ht, -5, 5))
+		digits := genDigits(ht, 4)
+		ht.Assume(digits != "0")
+		// |x| < 10^exp: put the digits at least two places below the target exponent.
+		x := parse(digits + "E" + strconv.Itoa(int(exp)-len(digits)-n(ht, 1, 30)))
+		var d Decimal
+		c.Rounding = RoundUp
+		if _, err := c.Quantize(&d, x, exp); err != nil {
+			ht.Fatalf("Quantize: %v", err)
+		}
+		wantDecimal(ht, fmt.Sprintf("Quantize(%s, %d) with RoundUp", x, exp), &d, "1E"+strconv.Itoa(int(exp)))
+		c.Rounding = RoundCeiling
+		c.Quantize(&d, x, exp)
+		wantDecimal(ht, fmt.Sprintf("Quantize(%s, %d) with RoundCeiling", x, exp), &d, "1E"+strconv.Itoa(int(exp)))
+		c.Rounding = RoundFloor
+		neg := new(Decimal).Neg(x)
+		c.Quantize(&d, neg, exp)
+		wantDecimal(ht, fmt.Sprintf("Quantize(%s, %d) with RoundFloor", neg, exp), &d, "-1E"+strconv.Itoa(int(exp)))
+		if exp == 0 {
+			c.Rounding = RoundCeiling
+			c.RoundToIntegralValue(&d, x)
+			wantDecimal(ht, fmt.Sprintf("RoundToIntegralValue(%s) with RoundCeiling", x), &d, "1")
+			c.Rounding = RoundFloor
+			c.RoundToIntegralExact(&d, neg)
+			wantDecimal(ht, fmt.Sprintf("RoundToIntegralExact(%s) with RoundFloor", neg), &d, "-1")
+		}
+	})
+}
