+// apd/13: Text('e') is documented as "-d.dddde±dd" but writes the exponent with as few
+// digits as it needs ("1e+5").
+func TestHegelTextExponentHasTwoDigits(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		xs := genDecimal(ht, 8, 9, 0)
+		d := parse(xs)
+		got := d.Text('e')
+		i := strings.IndexAny(got, "e")
+		if i < 0 || len(got)-i-2 < 2 {
+			ht.Fatalf("Text('e') of %s = %q: exponent without two digits", xs, got)
+		}
+	})
+}
