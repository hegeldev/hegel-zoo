+// Modf splits a decimal into integral and fractional parts that add back exactly, with
+// the documented signs and exponents; Reduce removes exactly the trailing zeros; Abs, Neg,
+// Sign and IsZero are consistent; Compose(Decompose) is the identity.
+func TestHegelDecimalHelpersAgreeWithTheModel(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		xs := genDecimal(ht, 30, 50, 5)
+		d := parse(xs)
+		note(ht, "x=%s", xs)
+		if d.Form == Finite {
+			var integ, frac Decimal
+			d.Modf(&integ, &frac)
+			var sum Decimal
+			c := &Context{Precision: 0, MaxExponent: MaxExponent, MinExponent: MinExponent}
+			if _, err := c.Add(&sum, &integ, &frac); err != nil {
+				ht.Fatalf("Modf(%s) parts %s + %s: %v", xs, &integ, &frac, err)
+			}
+			if sum.Cmp(d) != 0 {
+				ht.Fatalf("Modf(%s) = %s + %s = %s", xs, &integ, &frac, &sum)
+			}
+			if integ.Exponent < 0 || frac.Exponent > 0 {
+				ht.Fatalf("Modf(%s): integ exponent %d, frac exponent %d", xs, integ.Exponent, frac.Exponent)
+			}
+			if d.Sign() < 0 && (integ.Sign() > 0 || frac.Sign() > 0) || d.Sign() > 0 && (integ.Sign() < 0 || frac.Sign() < 0) {
+				ht.Fatalf("Modf(%s): signs %s %s", xs, &integ, &frac)
+			}
+			var fr big.Rat
+			fr.SetString(frac.Text('e'))
+			if fr.Cmp(big.NewRat(1, 1)) >= 0 || fr.Cmp(big.NewRat(-1, 1)) <= 0 {
+				ht.Fatalf("Modf(%s): fractional part %s not in (-1, 1)", xs, &frac)
+			}
+			// Modf with one nil argument.
+			var only Decimal
+			d.Modf(&only, nil)
+			if only.CmpTotal(&integ) != 0 {
+				ht.Fatalf("Modf(%s, nil) integ %s, both-arg call gave %s", xs, &only, &integ)
+			}
+			d.Modf(nil, &only)
+			if only.CmpTotal(&frac) != 0 {
+				ht.Fatalf("Modf(nil, %s) frac %s, both-arg call gave %s", xs, &only, &frac)
+			}
+
+			// Reduce.
+			var r Decimal
+			_, k := r.Reduce(d)
+			digits := d.Coeff.String()
+			wantK := len(digits) - len(strings.TrimRight(digits, "0"))
+			if digits == "0" {
+				wantK = 0
+			}
+			if k != wantK || r.Cmp(d) != 0 || (r.Coeff.Sign() != 0 && strings.HasSuffix(r.Coeff.String(), "0")) || (r.Negative != d.Negative && d.Coeff.Sign() != 0) {
+				ht.Fatalf("Reduce(%s) = %s removing %d zeros; want %d removed", xs, &r, k, wantK)
+			}
+		}
+		// Abs / Neg / Sign / IsZero.
+		var a, ng Decimal
+		a.Abs(d)
+		ng.Neg(d)
+		if a.Negative || (d.Form != NaN && d.Form != NaNSignaling && (a.Sign() < 0 || ng.Sign() != -d.Sign())) {
+			ht.Fatalf("Abs(%s) = %s, Neg = %s", xs, &a, &ng)
+		}
+		if d.IsZero() != (d.Form == Finite && d.Coeff.Sign() == 0) {
+			ht.Fatalf("IsZero(%s) = %v", xs, d.IsZero())
+		}
+		// Decompose / Compose (the form byte has no signaling NaN).
+		if d.Form == NaNSignaling {
+			return
+		}
+		form, negative, coeff, exp := d.Decompose(nil)
+		var back Decimal
+		if err := back.Compose(form, negative, coeff, exp); err != nil || back.CmpTotal(d) != 0 || back.Negative != d.Negative {
+			ht.Fatalf("Compose(Decompose(%s)) = %s (%v)", xs, &back, err)
+		}
+	})
+}
