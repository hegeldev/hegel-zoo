+// apd/14: SetFloat64 is documented to hold the exact value of the float; it holds the
+// shortest decimal that rounds to it.
+func TestHegelSetFloat64IsExact(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		f := math.Ldexp(float64(n(ht, 1, 1<<30)), n(ht, -1074, 900))
+		ht.Assume(f != 0 && !math.IsInf(f, 0))
+		var d Decimal
+		d.SetFloat64(f)
+		exact := new(big.Rat).SetFloat64(f)
+		got, _ := new(big.Rat).SetString(d.Text('e'))
+		if got == nil || got.Cmp(exact) != 0 {
+			ht.Fatalf("SetFloat64(%v) = %s, exact value %s", f, d.Text('e'), exact.FloatString(30))
+		}
+	})
+}
