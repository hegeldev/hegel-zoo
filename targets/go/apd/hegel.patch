+// apd/3: on overflow, RoundDown, Round05Up, RoundCeiling (negative results) and RoundFloor
+// (positive results) give the largest finite number, not infinity.
+func TestHegelOverflowRoundsToTheLargestFiniteNumber(t *testing.T) {
