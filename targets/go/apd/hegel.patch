+// gob-encoding a Decimal's coefficient (BigInt) and text-marshalling round trip through
+// the standard encoders.
+func TestHegelBigIntEncodingRoundTrips(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		xs := genInt(ht, 60)
+		x := toApd(xs)
+		var buf bytes.Buffer
+		if err := gob.NewEncoder(&buf).Encode(x); err != nil {
+			ht.Fatalf("gob encode %s: %v", xs, err)
+		}
+		var back BigInt
+		if err := gob.NewDecoder(&buf).Decode(&back); err != nil || back.Cmp(x) != 0 {
+			ht.Fatalf("gob round trip of %s: %s (%v)", xs, &back, err)
+		}
+		j, err := json.Marshal(x)
+		if err != nil || string(j) != xs {
+			ht.Fatalf("json.Marshal(%s) = %s (%v)", xs, j, err)
+		}
+		var jb BigInt
+		if err := json.Unmarshal(j, &jb); err != nil || jb.Cmp(x) != 0 {
+			ht.Fatalf("json round trip of %s: %s (%v)", xs, &jb, err)
+		}
+	})
+}
