+// apd/17: Quantize returns NaN with InvalidOperation whenever it discards digits and the
+// result has more than MaxExponent+1 digits, whatever the precision and the result's
+// magnitude: Quantize(1.2345, -3) with MaxExponent 2 is NaN instead of 1.235 (the intermediate
+// rounding in quantize() runs at exponent 0 and trips the MaxExponent check).
+func TestHegelQuantizeAcceptsResultsWithMoreDigitsThanMaxExponent(t *testing.T) {
+	property(t, func(ht *hegel.T) {
+		prec := n(ht, 3, 20)
+		emax := n(ht, 1, prec-2)
+		p := n(ht, emax+2, prec) // digits in the result: more than MaxExponent+1, within the precision
+		digits := genDigits(ht, p+1)
+		ht.Assume(len(digits) == p+1 && digits[0] != '0')
+		x := parse(digits[:1] + "." + digits[1:]) // p+1 digits, adjusted exponent 0
+		exp := int32(-(p - 1))
+		c := &Context{Precision: uint32(prec), MaxExponent: int32(emax), MinExponent: -999, Rounding: pick(ht, roundings).apd}
+		wide := c.WithPrecision(uint32(prec))
+		wide.MaxExponent = 999
+		var want Decimal
+		if _, err := wide.Quantize(&want, x, exp); err != nil {
+			ht.Fatalf("Quantize with MaxExponent 999: %v", err)
+		}
+		var d Decimal
+		cond, err := c.Quantize(&d, x, exp)
+		if err != nil {
+			ht.Fatalf("Quantize: %v", err)
+		}
+		if cond.InvalidOperation() || d.Form != Finite || d.CmpTotal(&want) != 0 {
+			ht.Fatalf("Quantize(%s, %d) [prec %d Emax %d %s] = %s with condition %s, want %s", x, exp, prec, emax, c.Rounding, &d, cond, &want)
+		}
+	})
+}
