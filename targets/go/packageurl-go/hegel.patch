@@ -0,0 +1,407 @@
+package packageurl_test
+
+// Generators: purl components (valid and not) as a purl record drawn from piece-list
+// generators, a spelling record (per-byte encoding tapes, hex case, scheme form, slash
+// variants, empty qualifiers) rendered by a pure function into a purl string the parse
+// procedure accepts, and mutations as small records applied modulo the live length to reach the
+// malformed strings. Every generator is a package-level value and the plainest alternative
+// comes first in every choice. The shapes of the recorded bugs are drawn by default (types and
+// keys starting with punctuation, slashes inside segments and around the name, dotted and
+// empty subpath segments, empty-valued qualifiers with invalid keys, the unenforced type rules);
+// under HEGEL_NO_KNOWN=1 (noKnown) the tables leave those shapes out and the Known gates of
+// the properties skip what the composition still reaches.
+
+import (
+	"fmt"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// pieces: the strings components are made of. Some need encoding (space, '/', '@', '?', '#',
+// '&', '=', '%', '+', ',', ';', 'é', '日'), some are case pairs, some are '.'/'..'. The plain
+// piece comes first (SampledFrom shrinks to it).
+var pieces = []string{"a", "b", "A", "B", "x1", "foo", "Foo", "org", "-", "_", ".", "~", ":", " ", "/", "@", "?", "#", "&", "=", "%", "+", ",", ";", "é", "日", "..", "0", "1", "::"}
+
+var qualKeys = []string{"arch", "Arch", "ARCH", "repository_url", "uuid", "tag_id", "k.1-_", "a", "z", "1k", ".k", "-k", "_k", "k%41", "", "k é"}
+
+// segs is a table entry written with its separators, as segments.
+func segs(s string) []string { return strings.Split(s, "/") }
+
+// The tables that differ under HEGEL_NO_KNOWN=1: a namespace or subpath segment then holds no
+// slash (encoded inside a segment it is packageurl-go/3, joined it makes empty segments, /4
+// and /5), a name holds no slash (slashes around it are /5), a type starts with a letter and
+// holds no '+' (/1), a qualifier key starts with a letter (/2), no namespace table entry has an
+// inner empty segment (/5), no subpath table entry a dot or empty segment (/4).
+var (
+	segmentPieces = shaped(pieces, without(pieces, "/"))
+	typeTable     = append([]string{"generic"}, registeredTypes...)
+	invalidTypes  = shaped(
+		[]string{"", "1t", "+type", ".type", "-type", "ty+pe", "ty_pe", "ty pe", "ty/pe", "typé", "ty%70e", "ty:pe"},
+		[]string{"", "1t", "ty_pe", "ty pe", "ty/pe", "typé", "ty%70e", "ty:pe"},
+	)
+	keyTable       = shaped(qualKeys, without(qualKeys, ".k", "-k", "_k"))
+	slashedNames   = shaped(pick("a/b", "/n", "n/", "/n/", "//"), pick("a/b"))
+	namespaceTable = shaped(
+		[][]string{segs("/ns"), segs("ns/"), segs("/a/b/"), segs("a//b"), segs("//"), segs("/"), {"@scope"}, segs("GitHub.com/x"), {"DROLSKY"}, segs("homebrew/core")},
+		[][]string{segs("/ns"), segs("ns/"), segs("/a/b/"), segs("//"), segs("/"), {"@scope"}, segs("GitHub.com/x"), {"DROLSKY"}, segs("homebrew/core")},
+	)
+	subpathTable = shaped(
+		[][]string{segs("a/b/c"), segs("./a"), segs("../a"), segs("a/./b"), segs("a/../b"), {"."}, {".."}, segs("/a/"), segs("a//b"), segs("/")},
+		[][]string{segs("a/b/c"), segs("a/b")},
+	)
+)
+
+// --------------------------------------------------------------------------- components
+
+var (
+	piece = hegel.SampledFrom(pieces)
+	// segment: one or two pieces, for a namespace or subpath segment and a name.
+	segment = joined(many(hegel.SampledFrom(segmentPieces), 1, 2), "")
+
+	// types: a registered type (mostly), one in mixed case, an unregistered valid one, or an
+	// invalid one.
+	types = weighted(
+		choice[string]{6, hegel.SampledFrom(typeTable)},
+		choice[string]{1, pick("NPM", "Golang", "PyPI", "Chrome-Extension", "OCI", "Hex")},
+		choice[string]{1, pick("generic2", "my-type", "a.b", "t", "x-y.z")},
+		choice[string]{2, hegel.SampledFrom(invalidTypes)},
+	)
+
+	// names: pieces (mostly), empty, a chrome-extension id, one with slashes.
+	names = weighted(
+		choice[string]{9, joined(many(hegel.SampledFrom(segmentPieces), 1, 3), "")},
+		choice[string]{1, hegel.Just("")},
+		choice[string]{1, pick("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "dlpngalgnefjeiefhmpklpfiohadpglk", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaz", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "abc")},
+		choice[string]{1, slashedNames},
+	)
+
+	// namespaces: absent (mostly), one to three segments, or a table entry. Under
+	// HEGEL_NO_KNOWN=1 a type whose definition requires or prohibits a namespace, unchecked
+	// upstream (packageurl-go/8), gets one that fits: namespacesFor.
+	namespaces = weighted(
+		choice[[]string]{4, hegel.Just([]string(nil))},
+		choice[[]string]{5, many(segment, 1, 3)},
+		choice[[]string]{1, hegel.SampledFrom(namespaceTable)},
+	)
+	someNamespace = many(segment, 1, 3)
+	noNamespace   = hegel.Just([]string(nil))
+
+	versions = weighted(
+		choice[string]{3, hegel.Just("")},
+		choice[string]{1, pick("1.2.3", "1.2.3.4.5", "1.2-beta", "v1", "refs/tags/v1", "sha256:abc", "REV", "1.0+b", ".1")},
+		choice[string]{4, joined(many(piece, 1, 3), "")},
+	)
+
+	// qualifier values: empty, a realistic one, or pieces. Under HEGEL_NO_KNOWN=1 an empty
+	// value goes only with a key FromString accepts: ToString before Normalize writes the pair
+	// and FromString rejects the key (packageurl-go/9).
+	qualValues = weighted(
+		choice[string]{1, hegel.Just("")},
+		choice[string]{1, pick("https://x.databricks.com/api", "azureml", "a,b", "git+https://h/p.git@x", "sha256:abc")},
+		choice[string]{4, joined(many(piece, 1, 3), "")},
+	)
+	nonEmptyQualValues = weighted(
+		choice[string]{1, pick("https://x.databricks.com/api", "azureml", "a,b", "git+https://h/p.git@x", "sha256:abc")},
+		choice[string]{4, joined(many(piece, 1, 3), "")},
+	)
+	qualifiers = hegel.FlatMap(hegel.SampledFrom(keyTable), func(k string) hegel.Generator[kv] {
+		values := qualValues
+		if noKnown && !qualKeyRE.MatchString(lower(k)) {
+			values = nonEmptyQualValues
+		}
+		return hegel.Map(values, func(v string) kv { return kv{k, v} })
+	})
+	qualifierLists = many(qualifiers, 0, 3)
+
+	// subpathSegment: a segment; under HEGEL_NO_KNOWN=1 never '.' or '..' (packageurl-go/4).
+	subpathSegment = shaped(segment, hegel.Filter(segment, func(s string) bool { return s != "." && s != ".." }))
+	subpaths       = weighted(
+		choice[[]string]{3, hegel.Just([]string(nil))},
+		choice[[]string]{4, many(subpathSegment, 1, 3)},
+		choice[[]string]{1, hegel.SampledFrom(subpathTable)},
+	)
+)
+
+// purl is a purl as drawn: the namespace and subpath as segment lists (a segment may hold a
+// slash, which the spelling percent-encodes), the qualifiers in drawn order.
+type purl struct {
+	typ     string
+	ns      []string
+	name    string
+	version string
+	quals   []kv
+	subpath []string
+}
+
+// comps is the purl as the model's six components.
+func (p purl) comps() comps {
+	return comps{typ: p.typ, ns: strings.Join(p.ns, "/"), name: p.name, version: p.version, quals: p.quals, subpath: strings.Join(p.subpath, "/")}
+}
+
+func (p purl) GoString() string {
+	return fmt.Sprintf("purl{type %q, namespace %q, name %q, version %q, qualifiers %v, subpath %q}", p.typ, p.ns, p.name, p.version, p.quals, p.subpath)
+}
+
+// namespacesFor is the namespace generator for a drawn type: namespaces, or under
+// HEGEL_NO_KNOWN=1 one that fits a definition's requirement upstream does not check.
+func namespacesFor(typ string) hegel.Generator[[]string] {
+	if !noKnown || enforcesNamespace(lower(typ)) {
+		return namespaces
+	}
+	switch typeRules[lower(typ)].nsReq {
+	case "required":
+		return someNamespace
+	case "prohibited":
+		return noNamespace
+	}
+	return namespaces
+}
+
+var purls = hegel.Composite(func(tc hegel.TestCase) purl {
+	typ := hegel.Draw(tc, types)
+	return purl{
+		typ:     typ,
+		ns:      hegel.Draw(tc, namespacesFor(typ)),
+		name:    hegel.Draw(tc, names),
+		version: hegel.Draw(tc, versions),
+		quals:   hegel.Draw(tc, qualifierLists),
+		subpath: hegel.Draw(tc, subpaths),
+	}
+})
+
+// --------------------------------------------------------------------------- spelling
+
+// spelling is how a purl string is written from its components: the scheme form, whether the
+// percent-encoding is loose (permitted characters sometimes encoded, others sometimes bare,
+// decided per byte by the two tapes read modulo their length), the hex case, an extra slash
+// after a namespace segment, and the empty forms ('@' without a version, '?' without pairs, a
+// leading '&', '=' after a key with an empty value, '#' without a subpath). The zero value is
+// the canonical spelling with "pkg:".
+type spelling struct {
+	scheme          string
+	loose           bool
+	hexLower        bool
+	encodePermitted []bool // tape: a permitted byte is encoded (loose only)
+	bareOther       []bool // tape: an unpermitted non-separator byte is left bare (loose only)
+	doubleSlash     []bool // tape: an extra '/' after the namespace segment
+	emptyVersion    bool
+	emptyQuals      bool
+	leadingAmp      bool
+	equalsOnEmpty   []bool // tape: '=' after a key whose value is empty
+	emptySubpath    bool
+}
+
+var canonicalSpelling = spelling{scheme: "pkg:"}
+
+var spellings = hegel.Composite(func(tc hegel.TestCase) spelling {
+	return spelling{
+		scheme:          hegel.Draw(tc, pick("pkg:", "pkg:", "pkg:", "PKG:", "Pkg:", "pkg:/", "pkg://", "pkg:///")),
+		loose:           hegel.Draw(tc, chance(60)),
+		hexLower:        hegel.Draw(tc, chance(20)),
+		encodePermitted: hegel.Draw(tc, many(chance(15), 0, 8)),
+		bareOther:       hegel.Draw(tc, many(chance(30), 0, 8)),
+		doubleSlash:     hegel.Draw(tc, many(chance(10), 0, 3)),
+		emptyVersion:    hegel.Draw(tc, chance(5)),
+		emptyQuals:      hegel.Draw(tc, chance(5)),
+		leadingAmp:      hegel.Draw(tc, chance(10)),
+		equalsOnEmpty:   hegel.Draw(tc, many(chance(50), 0, 3)),
+		emptySubpath:    hegel.Draw(tc, chance(5)),
+	}
+})
+
+// at reads a tape at a position modulo its length; an empty tape is all false.
+func at(tape []bool, i int) bool { return len(tape) > 0 && tape[i%len(tape)] }
+
+// spell percent-encodes s for a component, choosing per byte whether to encode it when both
+// spellings mean the same: bytes that are separators of this or a later component are always
+// encoded, permitted characters never (canonical) or by the tape (loose), the rest always
+// (canonical) or by the tape (loose).
+func (sp spelling) spell(s string, mustEncode string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		enc := false
+		switch {
+		case c == '%' || c >= 0x80 || c < 0x20:
+			enc = true
+		case strings.IndexByte(mustEncode, c) >= 0:
+			enc = true
+		case isPermitted(c):
+			enc = sp.loose && at(sp.encodePermitted, i)
+		default:
+			enc = !sp.loose || !at(sp.bareOther, i)
+		}
+		if enc {
+			if sp.hexLower {
+				fmt.Fprintf(&b, "%%%02x", c)
+			} else {
+				fmt.Fprintf(&b, "%%%02X", c)
+			}
+		} else {
+			b.WriteByte(c)
+		}
+	}
+	return b.String()
+}
+
+// render spells the purl as a string the parse procedure should read back. A slash inside a
+// namespace or subpath segment is encoded (the segment is one segment); an unencoded '@' at
+// the very start of the remainder would be read as a version separator by the specification
+// and as an npm scope by upstream, so '@' is always encoded.
+func render(p purl, sp spelling) string {
+	var b strings.Builder
+	b.WriteString(sp.scheme)
+	b.WriteString(p.typ)
+	b.WriteByte('/')
+	for i, seg := range p.ns {
+		b.WriteString(sp.spell(seg, "/@?#"))
+		b.WriteByte('/')
+		if at(sp.doubleSlash, i) {
+			b.WriteByte('/')
+		}
+	}
+	b.WriteString(sp.spell(p.name, "/@?#"))
+	if p.version != "" || sp.emptyVersion {
+		b.WriteByte('@')
+		b.WriteString(sp.spell(p.version, "?#"))
+	}
+	if len(p.quals) > 0 || sp.emptyQuals {
+		b.WriteByte('?')
+		for i, q := range p.quals {
+			if i > 0 || sp.leadingAmp {
+				b.WriteByte('&')
+			}
+			b.WriteString(q.k) // keys are never encoded
+			if q.v != "" || at(sp.equalsOnEmpty, i) {
+				b.WriteByte('=')
+				b.WriteString(sp.spell(q.v, "&#"))
+			}
+		}
+	}
+	if len(p.subpath) > 0 || sp.emptySubpath {
+		b.WriteByte('#')
+		for i, seg := range p.subpath {
+			if i > 0 {
+				b.WriteByte('/')
+			}
+			b.WriteString(sp.spell(seg, "/"))
+		}
+	}
+	return b.String()
+}
+
+// --------------------------------------------------------------------------- mutations
+
+// mutation is one change of a purl string, to reach the malformed strings: a byte deleted, a
+// separator or a bad escape inserted, the prefix uppercased; the position is taken modulo the
+// live length.
+type mutation struct {
+	kind  string
+	at    int
+	piece string
+}
+
+func (m mutation) apply(s string) string {
+	i := m.at % (len(s) + 1)
+	switch m.kind {
+	case "delete":
+		if i < len(s) {
+			return s[:i] + s[i+1:]
+		}
+		return s
+	case "insert":
+		return s[:i] + m.piece + s[i:]
+	case "upper":
+		return strings.ToUpper(s[:i]) + s[i:]
+	}
+	panic("mutation " + m.kind)
+}
+
+func (m mutation) GoString() string {
+	if m.kind == "insert" {
+		return fmt.Sprintf("insert %q at %d", m.piece, m.at)
+	}
+	return fmt.Sprintf("%s at %d", m.kind, m.at)
+}
+
+var (
+	positions = hegel.Integers(0, 199)
+	mutations = weighted(
+		choice[mutation]{1, hegel.Map(positions, func(at int) mutation { return mutation{kind: "delete", at: at} })},
+		choice[mutation]{1, hegel.Composite(func(tc hegel.TestCase) mutation {
+			return mutation{kind: "insert", at: hegel.Draw(tc, positions), piece: hegel.Draw(tc, pick("/", "@", "?", "#", "&", "=", "%", "%2", "%ZZ", ":", " ", "é"))}
+		})},
+		choice[mutation]{1, hegel.Map(positions, func(at int) mutation { return mutation{kind: "upper", at: at} })},
+	)
+	// mutationLists: none three times in four, else one or two.
+	mutationLists = maybe(25, many(mutations, 1, 2))
+)
+
+// --------------------------------------------------------------------------- cases
+
+// parseCase is a purl, a spelling of it and the mutations applied to the spelled string.
+type parseCase struct {
+	p    purl
+	sp   spelling
+	muts []mutation
+}
+
+func (c parseCase) text() string {
+	s := render(c.p, c.sp)
+	for _, m := range c.muts {
+		s = m.apply(s)
+	}
+	return s
+}
+
+func (c parseCase) GoString() string {
+	return fmt.Sprintf("parseCase{text %q; %#v; mutations %#v}", c.text(), c.p, c.muts)
+}
+
+var parseCases = hegel.Composite(func(tc hegel.TestCase) parseCase {
+	return parseCase{p: hegel.Draw(tc, purls), sp: hegel.Draw(tc, spellings), muts: hegel.Draw(tc, mutationLists)}
+})
+
+// roundTripCase is a purl string: the ToString of the drawn components as they are (half
+// the time, first), or a spelled and mutated string.
+type roundTripCase struct {
+	p       purl
+	spelled bool
+	sp      spelling
+	muts    []mutation
+}
+
+func (c roundTripCase) text() string {
+	if !c.spelled {
+		p := toPURL(c.p.comps())
+		return p.ToString()
+	}
+	return parseCase{c.p, c.sp, c.muts}.text()
+}
+
+func (c roundTripCase) GoString() string {
+	if !c.spelled {
+		return fmt.Sprintf("roundTripCase{ToString of %#v}", c.p)
+	}
+	return fmt.Sprintf("roundTripCase{spelled: %#v}", parseCase{c.p, c.sp, c.muts})
+}
+
+var roundTripCases = weighted(
+	choice[roundTripCase]{1, hegel.Map(purls, func(p purl) roundTripCase { return roundTripCase{p: p} })},
+	choice[roundTripCase]{1, hegel.Map(parseCases, func(c parseCase) roundTripCase {
+		return roundTripCase{p: c.p, spelled: true, sp: c.sp, muts: c.muts}
+	})},
+)
+
+// qualifierMaps: up to four distinct keys (a key of the table with a suffix) with values of
+// pieces, for QualifiersFromMap; hegel.Maps yields nil for zero entries, Map() does not.
+var qualifierMaps = hegel.Map(
+	hegel.Maps(cat(hegel.SampledFrom(qualKeys), pick("", "2", "_x")), joined(many(piece, 0, 2), "")).MaxSize(4),
+	func(m map[string]string) map[string]string {
+		if m == nil {
+			return map[string]string{}
+		}
+		return m
+	},
+)
