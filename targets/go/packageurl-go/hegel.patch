+package packageurl_test
+
+// Hegel property tests for package-url/packageurl-go, written for the Hegel zoo.
+// See targets/go/packageurl-go/README.md.
+//
+// Oracles: the purl specification's own algorithms, "How to parse a PURL" and "How to build a
+// PURL" (docs/specification/how-to-parse.md, how-to-build.md in package-url/purl-spec), with the
+// character-encoding rule and the per-type case rules of the type definitions
+// (types/<type>-definition.json), restated as a model in hegel_model_test.go; and the laws the
+// package documents: FromString and ToString are inverse on canonical strings, Normalize is
+// idempotent and is what FromString applies, QualifiersFromMap and Map are inverse.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+func n(tc hegel.TestCase, lo, hi int) int { return hegel.Draw(tc, hegel.Integers(lo, hi)) }
+
+func chance(tc hegel.TestCase, pct int) bool { return n(tc, 1, 100) <= pct }
+
+func pick[T any](tc hegel.TestCase, xs []T) T { return hegel.Draw(tc, hegel.SampledFrom(xs)) }
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// Known: the recorded bugs (bugs.toml). The properties avoid a shape while its switch is on;
+// the pins assert the specified behaviour and fail while the bug exists.
+var Known = struct {
+	// a type may start with '.', '-' or '+' and contain '+' (spec 5.6.2: letters, digits,
+	// '.' and '-', starting with a letter)
+	typePunctuation bool
+	// a qualifier key may start with '.', '-' or '_' (spec 5.6.6: starts with a letter)
+	keyPunctuation bool
+	// a percent-encoded slash inside a namespace or subpath segment is accepted and becomes a
+	// segment separator (spec 5.6.3, 5.6.7: a decoded segment shall not contain a slash)
+	encodedSlash bool
+	// subpath segments '.', '..' and empty are kept when leading and rejected otherwise
+	// (spec: discarded on parse and build)
+	subpathDots bool
+	// a name is not stripped of leading and trailing slashes (spec build procedure)
+	nameSlashes bool
+	// Normalize keeps empty inner namespace segments that ToString drops
+	emptyNamespaceSegments bool
+	// the case rules of the type definitions of hex, luarocks, oci, otp, pub, pypi (version),
+	// vscode-extension and chrome-extension are not applied
+	caseRules bool
+	// chrome-extension names accept letters q-z (spec: ^[a-p]{32}$)
+	chromeExtensionLetters bool
+	// the namespace requirement of most type definitions is not checked
+	namespaceRequirement bool
+	// ToString before Normalize writes qualifiers with an empty value (and percent-encodes
+	// their keys), which FromString may reject
+	emptyQualifierWritten bool
+	// the swid type's required tag_id qualifier is not checked (julia's uuid is)
+	swidTagID bool
+}{
+	typePunctuation:        true,
+	keyPunctuation:         true,
+	encodedSlash:           true,
+	subpathDots:            true,
+	nameSlashes:            true,
+	emptyNamespaceSegments: true,
+	caseRules:              true,
+	chromeExtensionLetters: true,
+	namespaceRequirement:   true,
+	emptyQualifierWritten:  true,
+	swidTagID:              true,
+}
