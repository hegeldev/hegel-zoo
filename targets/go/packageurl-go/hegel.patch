diff --git a/hegel_gen_test.go b/hegel_gen_test.go
new file mode 100644
index 0000000..a18bc21
--- /dev/null
+++ b/hegel_gen_test.go
@@ -0,0 +1,218 @@
+package packageurl_test
+
+// Generators: purl components (valid and not) and purl strings spelled in the many ways the
+// parse procedure accepts (percent-encoding or not, hex case, scheme case, extra slashes,
+// empty qualifiers, unsorted keys).
+
+import (
+	"fmt"
+	"strings"
+
+	"hegel.dev/go/hegel"
+)
+
+// pieces: the strings components are made of. Some need encoding (space, '/', '@', '?', '#',
+// '&', '=', '%', '+', ',', ';', 'é', '日'), some are case pairs, some are '.'/'..'.
+var pieces = []string{"a", "b", "A", "B", "x1", "foo", "Foo", "org", "-", "_", ".", "~", ":", " ", "/", "@", "?", "#", "&", "=", "%", "+", ",", ";", "é", "日", "..", "0", "1", "::"}
+
+var qualKeys = []string{"arch", "Arch", "ARCH", "repository_url", "uuid", "tag_id", "k.1-_", "a", "z", "1k", ".k", "-k", "_k", "k%41", "", "k é"}
+
+func genPiece(tc hegel.TestCase, count int) string {
+	var b strings.Builder
+	for i := 0; i < count; i++ {
+		b.WriteString(pick(tc, pieces))
+	}
+	return b.String()
+}
+
+// genType: a registered type (mostly), an unregistered valid one, or an invalid one.
+func genType(tc hegel.TestCase) string {
+	switch n(tc, 1, 10) {
+	case 1, 2, 3, 4, 5, 6:
+		return pick(tc, registeredTypes)
+	case 7:
+		return pick(tc, []string{"NPM", "Golang", "PyPI", "Chrome-Extension", "OCI", "Hex"})
+	case 8:
+		return pick(tc, []string{"generic2", "my-type", "a.b", "t", "x-y.z"})
+	default:
+		return pick(tc, []string{"", "1t", "+type", ".type", "-type", "ty+pe", "ty_pe", "ty pe", "ty/pe", "typé", "ty%70e", "ty:pe"})
+	}
+}
+
+// genName draws a name; some pick a chrome-extension id, some empty.
+func genName(tc hegel.TestCase) string {
+	switch n(tc, 1, 12) {
+	case 1:
+		return ""
+	case 2:
+		return pick(tc, []string{"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "dlpngalgnefjeiefhmpklpfiohadpglk", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaz", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "abc"})
+	case 3:
+		return pick(tc, []string{"/n", "n/", "/n/", "a/b", "//"})
+	default:
+		return genPiece(tc, n(tc, 1, 3))
+	}
+}
+
+func genNamespace(tc hegel.TestCase) string {
+	switch n(tc, 1, 10) {
+	case 1, 2, 3, 4:
+		return ""
+	case 5:
+		return pick(tc, []string{"/ns", "ns/", "/a/b/", "a//b", "//", "/", "@scope", "GitHub.com/x", "DROLSKY", "homebrew/core"})
+	default:
+		var segs []string
+		for i := n(tc, 1, 3); i > 0; i-- {
+			segs = append(segs, genPiece(tc, n(tc, 1, 2)))
+		}
+		return strings.Join(segs, "/")
+	}
+}
+
+func genVersion(tc hegel.TestCase) string {
+	switch n(tc, 1, 8) {
+	case 1, 2, 3:
+		return ""
+	case 4:
+		return pick(tc, []string{"1.2.3", "1.2.3.4.5", "1.2-beta", "v1", "refs/tags/v1", "sha256:abc", "REV", "1.0+b", ".1"})
+	default:
+		return genPiece(tc, n(tc, 1, 3))
+	}
+}
+
+func genQuals(tc hegel.TestCase) []kv {
+	var qs []kv
+	for i := n(tc, 0, 3); i > 0; i-- {
+		k := pick(tc, qualKeys)
+		var v string
+		switch n(tc, 1, 6) {
+		case 1:
+			v = ""
+		case 2:
+			v = pick(tc, []string{"https://x.databricks.com/api", "azureml", "a,b", "git+https://h/p.git@x", "sha256:abc"})
+		default:
+			v = genPiece(tc, n(tc, 1, 3))
+		}
+		qs = append(qs, kv{k, v})
+	}
+	return qs
+}
+
+func genSubpath(tc hegel.TestCase) string {
+	switch n(tc, 1, 8) {
+	case 1, 2, 3:
+		return ""
+	case 4:
+		return pick(tc, []string{"./a", "../a", "a/./b", "a/../b", ".", "..", "/a/", "a//b", "/", "a/b/c"})
+	default:
+		var segs []string
+		for i := n(tc, 1, 3); i > 0; i-- {
+			segs = append(segs, genPiece(tc, n(tc, 1, 2)))
+		}
+		return strings.Join(segs, "/")
+	}
+}
+
+func genComps(tc hegel.TestCase) comps {
+	return comps{typ: genType(tc), ns: genNamespace(tc), name: genName(tc), version: genVersion(tc), quals: genQuals(tc), subpath: genSubpath(tc)}
+}
+
+// spell percent-encodes s for the given component, choosing for each byte whether to encode
+// it when both spellings mean the same: bytes that are separators of this or a later
+// component are always encoded, permitted characters never (canonical) or sometimes (loose).
+// hexLower writes lowercase hex digits.
+func spell(tc hegel.TestCase, s string, mustEncode string, loose, hexLower bool) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		enc := false
+		switch {
+		case c == '%' || c >= 0x80 || c < 0x20:
+			enc = true
+		case strings.IndexByte(mustEncode, c) >= 0:
+			enc = true
+		case isPermitted(c):
+			enc = loose && chance(tc, 15)
+		default:
+			enc = !loose || chance(tc, 70)
+		}
+		if enc {
+			if hexLower {
+				fmt.Fprintf(&b, "%%%02x", c)
+			} else {
+				fmt.Fprintf(&b, "%%%02X", c)
+			}
+		} else {
+			b.WriteByte(c)
+		}
+	}
+	return b.String()
+}
+
+// genString spells the components as a purl string the parse procedure should read back
+// (loose spelling, extra slashes, empty and unsorted qualifiers, uppercase scheme and type).
+func genString(tc hegel.TestCase, c comps) string {
+	loose := chance(tc, 60)
+	hexLower := chance(tc, 20)
+	var b strings.Builder
+	b.WriteString(pick(tc, []string{"pkg:", "pkg:", "pkg:", "PKG:", "Pkg:", "pkg:/", "pkg://", "pkg:///"}))
+	b.WriteString(c.typ)
+	b.WriteByte('/')
+	if c.ns != "" {
+		for _, seg := range strings.Split(c.ns, "/") {
+			// an unencoded '@' at the very start of the remainder is read as a version separator
+			// by the specification and as an npm scope by upstream; encode it
+			b.WriteString(spell(tc, seg, "/@?#", loose, hexLower))
+			b.WriteByte('/')
+			if chance(tc, 10) {
+				b.WriteByte('/')
+			}
+		}
+	}
+	b.WriteString(spell(tc, c.name, "/@?#", loose, hexLower))
+	if c.version != "" || chance(tc, 5) {
+		b.WriteByte('@')
+		b.WriteString(spell(tc, c.version, "?#", loose, hexLower))
+	}
+	if len(c.quals) > 0 || chance(tc, 5) {
+		b.WriteByte('?')
+		for i, q := range c.quals {
+			if i > 0 || chance(tc, 10) {
+				b.WriteByte('&')
+			}
+			b.WriteString(q.k) // keys are never encoded
+			if q.v != "" || chance(tc, 50) {
+				b.WriteByte('=')
+				b.WriteString(spell(tc, q.v, "&#", loose, hexLower))
+			}
+		}
+	}
+	if c.subpath != "" || chance(tc, 5) {
+		b.WriteByte('#')
+		for i, seg := range strings.Split(c.subpath, "/") {
+			if i > 0 {
+				b.WriteByte('/')
+			}
+			b.WriteString(spell(tc, seg, "/", loose, hexLower))
+		}
+	}
+	return b.String()
+}
+
+// mutate inserts or deletes one byte, to reach the malformed strings.
+func mutate(tc hegel.TestCase, s string) string {
+	if s == "" {
+		return pick(tc, []string{"pkg", "pkg:", ":", "/"})
+	}
+	i := n(tc, 0, len(s))
+	switch n(tc, 1, 3) {
+	case 1:
+		return s[:i] + pick(tc, []string{"/", "@", "?", "#", "&", "=", "%", "%2", "%ZZ", ":", " ", "é"}) + s[i:]
+	case 2:
+		if i < len(s) {
+			return s[:i] + s[i+1:]
+		}
+		return s
+	default:
+		return strings.ToUpper(s[:i]) + s[i:]
+	}
+}
diff --git a/hegel_model_test.go b/hegel_model_test.go
new file mode 100644
index 0000000..0d9bb61
--- /dev/null
+++ b/hegel_model_test.go
@@ -0,0 +1,435 @@
+package packageurl_test
+
+// A model of the purl specification: "How to build a PURL", "How to parse a PURL", the
+// character-encoding clause (5.4), the component rules (5.6) and the type definitions
+// (types/<type>-definition.json) as of purl-spec 9d6b901, the commit upstream's testdata
+// submodule pins.
+
+import (
+	"errors"
+	"fmt"
+	"net/url"
+	"regexp"
+	"sort"
+	"strings"
+	"unicode/utf8"
+)
+
+type kv struct{ k, v string }
+
+// comps is a purl as six components; qualifiers keep their order.
+type comps struct {
+	typ, ns, name, version string
+	quals                  []kv
+	subpath                string
+}
+
+// typeRule is what a type definition says about a component.
+type typeRule struct {
+	nsReq                        string // "required", "optional", "prohibited"
+	nsLower, nameLower, verLower bool   // case_sensitive: false ("the form shall be lowercase")
+	requiredQuals                []string
+	namePattern, verPattern      *regexp.Regexp // permitted_characters
+}
+
+// typeRules: the registered types at 9d6b901. Types not listed are unregistered: the type
+// component alone is validated. (Normalization rules given as prose - hackage "Apply
+// kebab-case", pub "Replace non-[a-z] letters...", pypi "Replace underscore with dash" - are
+// modelled only for pypi, whose rule upstream implements; hackage and pub names are kept as
+// they are, see the README.)
+var typeRules = map[string]typeRule{
+	"alpm":             {nsReq: "required", nsLower: true, nameLower: true},
+	"apk":              {nsReq: "required", nsLower: true, nameLower: true},
+	"bazel":            {nsReq: "prohibited"},
+	"bitbucket":        {nsReq: "required", nsLower: true, nameLower: true},
+	"bitnami":          {nsReq: "prohibited", nameLower: true},
+	"brew":             {nsReq: "optional", nsLower: true, nameLower: true},
+	"cargo":            {nsReq: "prohibited"},
+	"chrome-extension": {nsReq: "prohibited", nameLower: true, namePattern: regexp.MustCompile(`^[a-p]{32}$`), verPattern: regexp.MustCompile(`^\d+(\.\d+){0,3}$`)},
+	"cocoapods":        {nsReq: "prohibited"},
+	"composer":         {nsReq: "required", nsLower: true, nameLower: true},
+	"conan":            {nsReq: "optional"},
+	"conda":            {nsReq: "prohibited"},
+	"cpan":             {nsReq: "optional"},
+	"cran":             {nsReq: "prohibited"},
+	"deb":              {nsReq: "required", nsLower: true, nameLower: true},
+	"docker":           {nsReq: "optional"},
+	"gem":              {nsReq: "prohibited"},
+	"generic":          {nsReq: "optional"},
+	"github":           {nsReq: "required", nsLower: true, nameLower: true},
+	"golang":           {nsReq: "required", nsLower: true, nameLower: true}, // case_sensitive: true, but "must be lowercased" in the notes; upstream lowercases
+	"hackage":          {nsReq: "prohibited"},
+	"hex":              {nsReq: "optional", nsLower: true, nameLower: true},
+	"huggingface":      {nsReq: "required", verLower: true},
+	"julia":            {nsReq: "prohibited", requiredQuals: []string{"uuid"}},
+	"luarocks":         {nsReq: "optional", nsLower: true, nameLower: true},
+	"maven":            {nsReq: "required"},
+	"mlflow":           {nsReq: "prohibited"},
+	"npm":              {nsReq: "optional"},
+	"nuget":            {nsReq: "prohibited"},
+	"oci":              {nsReq: "prohibited", nameLower: true, verLower: true},
+	"opam":             {nsReq: "prohibited"},
+	"otp":              {nsReq: "prohibited", nameLower: true},
+	"pub":              {nsReq: "prohibited", nameLower: true},
+	"pypi":             {nsReq: "prohibited", nameLower: true, verLower: true},
+	"qpkg":             {nsReq: "required", nsLower: true},
+	"rpm":              {nsReq: "required", nsLower: true},
+	"swid":             {nsReq: "optional", requiredQuals: []string{"tag_id"}},
+	"swift":            {nsReq: "required"},
+	"vcpkg":            {nsReq: "prohibited"},
+	"vscode-extension": {nsReq: "required", nsLower: true, nameLower: true, verLower: true},
+	"yocto":            {nsReq: "optional", nsLower: true},
+}
+
+// registeredTypes in sorted order, for the generator.
+var registeredTypes = func() []string {
+	var xs []string
+	for t := range typeRules {
+		xs = append(xs, t)
+	}
+	sort.Strings(xs)
+	return xs
+}()
+
+// isPermitted: 5.4, the characters that shall not be percent-encoded in a component (the
+// Alphanumeric and Punctuation Characters and the colon).
+func isPermitted(c byte) bool {
+	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '.' || c == '-' || c == '_' || c == '~' || c == ':'
+}
+
+// encode percent-encodes s per 5.4: UTF-8 bytes, uppercase hex.
+func encode(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if isPermitted(c) {
+			b.WriteByte(c)
+		} else {
+			fmt.Fprintf(&b, "%%%02X", c)
+		}
+	}
+	return b.String()
+}
+
+// decode percent-decodes s ('+' is literal); invalid escapes are an error.
+func decode(s string) (string, error) {
+	return url.PathUnescape(s)
+}
+
+var typeRE = regexp.MustCompile(`^[a-z][a-z0-9.-]*$`)            // 5.6.2, after lowercasing
+var qualKeyRE = regexp.MustCompile(`^[a-z][a-z0-9._-]*$`)        // 5.6.6, after lowercasing
+var lenientTypeRE = regexp.MustCompile(`^[a-z.+-][a-z0-9.+-]*$`) // what upstream accepts (go/packageurl-go/1)
+
+func lower(s string) string { return strings.ToLower(s) }
+
+// nsSegments splits a namespace into its non-empty segments.
+func nsSegments(ns string) []string {
+	var out []string
+	for _, s := range strings.Split(ns, "/") {
+		if s != "" {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+// subpathSegments: the segments of a subpath after discarding empty, '.' and '..' ones.
+func subpathSegments(sp string) []string {
+	var out []string
+	for _, s := range strings.Split(sp, "/") {
+		if s != "" && s != "." && s != ".." {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+// normalizeQuals applies 5.6.6 and the build procedure: drop empty values, lowercase keys,
+// validate them, reject duplicates, sort.
+func normalizeQuals(qs []kv) ([]kv, error) {
+	var out []kv
+	seen := map[string]bool{}
+	for _, q := range qs {
+		if q.k == "" {
+			// upstream rejects an empty key before looking at the value; the build procedure
+			// would discard the pair when the value is empty (README, accepted differences)
+			return nil, errors.New("empty qualifier key")
+		}
+		if q.v == "" {
+			continue
+		}
+		k := lower(q.k)
+		if !qualKeyRE.MatchString(k) {
+			return nil, fmt.Errorf("invalid qualifier key %q", q.k)
+		}
+		if seen[k] {
+			return nil, fmt.Errorf("duplicate qualifier key %q", k)
+		}
+		seen[k] = true
+		out = append(out, kv{k, q.v})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].k < out[j].k })
+	return out, nil
+}
+
+// applyTypeRules lowercases what the type definition says is case-insensitive, applies the
+// pypi rule and checks the requirements. c must already have normalized qualifiers.
+func applyTypeRules(c *comps) error {
+	r, known := typeRules[c.typ]
+	if !known {
+		return nil
+	}
+	if r.nsLower {
+		c.ns = lower(c.ns)
+	}
+	if r.nameLower {
+		c.name = lower(c.name)
+	}
+	if c.typ == "pypi" {
+		c.name = strings.ReplaceAll(c.name, "_", "-")
+	}
+	if c.typ == "mlflow" {
+		for _, q := range c.quals {
+			if q.k == "repository_url" && strings.Contains(q.v, "databricks") {
+				c.name = lower(c.name)
+			}
+		}
+	}
+	if r.verLower {
+		c.version = lower(c.version)
+	}
+	switch r.nsReq {
+	case "required":
+		if c.ns == "" {
+			return fmt.Errorf("%s: namespace is required", c.typ)
+		}
+	case "prohibited":
+		if c.ns != "" {
+			return fmt.Errorf("%s: namespace is prohibited", c.typ)
+		}
+	}
+	for _, want := range r.requiredQuals {
+		if Known.swidTagID && c.typ == "swid" {
+			continue
+		}
+		found := false
+		for _, q := range c.quals {
+			found = found || q.k == want
+		}
+		if !found {
+			return fmt.Errorf("%s: qualifier %s is required", c.typ, want)
+		}
+	}
+	if r.namePattern != nil && !r.namePattern.MatchString(c.name) {
+		return fmt.Errorf("%s: name %q not permitted", c.typ, c.name)
+	}
+	if r.verPattern != nil && c.version != "" && !r.verPattern.MatchString(c.version) {
+		return fmt.Errorf("%s: version %q not permitted", c.typ, c.version)
+	}
+	if c.typ == "cpan" {
+		if strings.ToUpper(c.ns) != c.ns {
+			return errors.New("cpan: namespace must be uppercase")
+		}
+		if strings.Contains(c.name, "::") {
+			return errors.New("cpan: name must not contain ::")
+		}
+	}
+	return nil
+}
+
+// build follows "How to build a PURL": the canonical string and the normalized components,
+// or an error when the components are not a valid purl.
+func build(in comps) (string, comps, error) {
+	c := comps{typ: lower(in.typ), version: in.version}
+	if !typeRE.MatchString(c.typ) {
+		return "", c, fmt.Errorf("invalid type %q", in.typ)
+	}
+	c.ns = strings.Join(nsSegments(strings.Trim(in.ns, "/")), "/")
+	c.name = strings.Trim(in.name, "/")
+	if c.name == "" {
+		return "", c, errors.New("name is required")
+	}
+	var err error
+	if c.quals, err = normalizeQuals(in.quals); err != nil {
+		return "", c, err
+	}
+	c.subpath = strings.Join(subpathSegments(in.subpath), "/")
+	if err := applyTypeRules(&c); err != nil {
+		return "", c, err
+	}
+	var b strings.Builder
+	b.WriteString("pkg:")
+	b.WriteString(c.typ)
+	b.WriteByte('/')
+	if c.ns != "" {
+		for _, seg := range strings.Split(c.ns, "/") {
+			b.WriteString(encode(seg))
+			b.WriteByte('/')
+		}
+	}
+	b.WriteString(encode(c.name))
+	if c.version != "" {
+		b.WriteByte('@')
+		b.WriteString(encode(c.version))
+	}
+	if len(c.quals) > 0 {
+		b.WriteByte('?')
+		for i, q := range c.quals {
+			if i > 0 {
+				b.WriteByte('&')
+			}
+			b.WriteString(q.k)
+			b.WriteByte('=')
+			b.WriteString(encode(q.v))
+		}
+	}
+	if c.subpath != "" {
+		b.WriteByte('#')
+		for i, seg := range strings.Split(c.subpath, "/") {
+			if i > 0 {
+				b.WriteByte('/')
+			}
+			b.WriteString(encode(seg))
+		}
+	}
+	return b.String(), c, nil
+}
+
+// parse follows "How to parse a PURL", then applies the same normalization and type rules as
+// build (the specification's parse procedure ends with "apply type-specific normalization").
+func parse(s string) (comps, error) {
+	c, err := parseRaw(s)
+	if err != nil {
+		return c, err
+	}
+	_, out, err := build(c)
+	if err != nil {
+		return c, err
+	}
+	return out, nil
+}
+
+// parseRaw is the parse procedure alone: components percent-decoded, not yet normalized.
+// Trailing slashes before the name are not stripped, although the procedure says so: the
+// specification's test suite requires "pkg:swift/github.com/Alamofire/@5.4.3" to fail.
+func parseRaw(s string) (comps, error) {
+	var c comps
+	rem := s
+	// subpath
+	if i := strings.LastIndexByte(rem, '#'); i >= 0 {
+		var segs []string
+		for _, seg := range strings.Split(rem[i+1:], "/") {
+			d, err := decode(seg)
+			if err != nil {
+				return c, fmt.Errorf("subpath: %v", err)
+			}
+			if d == "" || d == "." || d == ".." {
+				continue
+			}
+			if strings.Contains(d, "/") {
+				return c, fmt.Errorf("subpath segment %q contains a slash", d)
+			}
+			segs = append(segs, d)
+		}
+		c.subpath = strings.Join(segs, "/")
+		rem = rem[:i]
+	}
+	// qualifiers
+	if i := strings.LastIndexByte(rem, '?'); i >= 0 {
+		var qs []kv
+		for _, pair := range strings.Split(rem[i+1:], "&") {
+			if pair == "" {
+				continue
+			}
+			k, v, _ := strings.Cut(pair, "=")
+			dv, err := decode(v)
+			if err != nil {
+				return c, fmt.Errorf("qualifier value: %v", err)
+			}
+			if dv == "" {
+				continue
+			}
+			qs = append(qs, kv{k, dv})
+		}
+		c.quals = qs
+		rem = rem[:i]
+	}
+	// scheme
+	scheme, rest, ok := strings.Cut(rem, ":")
+	if !ok || lower(scheme) != "pkg" {
+		return c, errors.New("scheme is not pkg")
+	}
+	rem = strings.TrimLeft(rest, "/")
+	// type
+	typ, rest, ok := strings.Cut(rem, "/")
+	if !ok {
+		return c, errors.New("type or name is missing")
+	}
+	c.typ = lower(typ)
+	if !typeRE.MatchString(c.typ) {
+		return c, fmt.Errorf("invalid type %q", typ)
+	}
+	rem = rest
+	// version
+	if i := strings.LastIndexByte(rem, '@'); i >= 0 {
+		v, err := decode(rem[i+1:])
+		if err != nil {
+			return c, fmt.Errorf("version: %v", err)
+		}
+		c.version = v
+		rem = rem[:i]
+	}
+	// name
+	var name string
+	if i := strings.LastIndexByte(rem, '/'); i >= 0 {
+		name = rem[i+1:]
+		rem = rem[:i]
+	} else {
+		name = rem
+		rem = ""
+	}
+	dn, err := decode(name)
+	if err != nil {
+		return c, fmt.Errorf("name: %v", err)
+	}
+	c.name = dn
+	// namespace
+	var segs []string
+	for _, seg := range strings.Split(rem, "/") {
+		if seg == "" {
+			continue
+		}
+		d, err := decode(seg)
+		if err != nil {
+			return c, fmt.Errorf("namespace: %v", err)
+		}
+		if strings.Contains(d, "/") {
+			return c, fmt.Errorf("namespace segment %q contains a slash", d)
+		}
+		segs = append(segs, d)
+	}
+	c.ns = strings.Join(segs, "/")
+	if c.name == "" {
+		return c, errors.New("name is required")
+	}
+	return c, nil
+}
+
+// canonical reports whether s is the canonical form of what it parses to.
+func canonical(s string) bool {
+	c, err := parse(s)
+	if err != nil {
+		return false
+	}
+	out, _, err := build(c)
+	return err == nil && out == s
+}
+
+func validUTF8(ss ...string) bool {
+	for _, s := range ss {
+		if !utf8.ValidString(s) {
+			return false
+		}
+	}
+	return true
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..95a225a
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,165 @@
+package packageurl_test
+
+// One plain test per recorded bug (bugs.toml): each asserts what the purl specification (at
+// the commit upstream's testdata pins, purl-spec 9d6b901) says and fails while the bug exists;
+// target.toml lists them as expected failures.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/package-url/packageurl-go"
+)
+
+// packageurl-go/1: a type may start with '.', '-' or '+' and contain '+'; spec 5.6.2 allows
+// ASCII letters, digits, '.' and '-', starting with a letter.
+func TestHegelPinTypeStartsWithALetter(t *testing.T) {
+	for _, s := range []string{"pkg:+type/name", "pkg:.type/name", "pkg:-type/name", "pkg:ty+pe/name"} {
+		if _, err := packageurl.FromString(s); err == nil {
+			t.Errorf("FromString(%q) accepted; the type shall start with a letter and hold only letters, digits, '.' and '-'", s)
+		}
+	}
+}
+
+// packageurl-go/2: a qualifier key may start with '.', '-' or '_'; spec 5.6.6: a key shall
+// start with an ASCII letter.
+func TestHegelPinQualifierKeyStartsWithALetter(t *testing.T) {
+	for _, s := range []string{"pkg:generic/name?.k=v", "pkg:generic/name?-k=v", "pkg:generic/name?_k=v"} {
+		if _, err := packageurl.FromString(s); err == nil {
+			t.Errorf("FromString(%q) accepted; a qualifier key shall start with a letter", s)
+		}
+	}
+	p := packageurl.PackageURL{Type: "generic", Name: "name", Qualifiers: packageurl.Qualifiers{{Key: "_k", Value: "v"}}}
+	if err := p.Normalize(); err == nil {
+		t.Errorf("Normalize accepted the qualifier key %q", "_k")
+	}
+}
+
+// packageurl-go/3: a percent-encoded slash inside a namespace or subpath segment is accepted
+// and becomes a segment separator; spec 5.6.3 and 5.6.7: a decoded segment shall not contain a
+// slash.
+func TestHegelPinEncodedSlashInASegmentIsRejected(t *testing.T) {
+	if p, err := packageurl.FromString("pkg:generic/ns%2Fx/name"); err == nil {
+		t.Errorf("FromString(%q) = namespace %q, want an error (the decoded segment contains a slash)", "pkg:generic/ns%2Fx/name", p.Namespace)
+	}
+	if p, err := packageurl.FromString("pkg:generic/name#a%2Fb"); err == nil {
+		t.Errorf("FromString(%q) = subpath %q (ToString %q), want an error", "pkg:generic/name#a%2Fb", p.Subpath, p.ToString())
+	}
+}
+
+// packageurl-go/4: subpath segments '.', '..' and empty are kept when leading and rejected
+// otherwise; the parse and build procedures discard them.
+func TestHegelPinSubpathDotSegmentsAreDiscarded(t *testing.T) {
+	for in, want := range map[string]string{"pkg:generic/name#./a": "a", "pkg:generic/name#../a": "a", "pkg:generic/name#a/./b": "a/b", "pkg:generic/name#a//b": "a/b", "pkg:generic/name#..": ""} {
+		p, err := packageurl.FromString(in)
+		if err != nil {
+			t.Errorf("FromString(%q): %v; want subpath %q", in, err, want)
+			continue
+		}
+		if p.Subpath != want {
+			t.Errorf("FromString(%q).Subpath = %q, want %q", in, p.Subpath, want)
+		}
+	}
+}
+
+// packageurl-go/5: Normalize keeps slashes around the name and empty namespace segments, so a
+// normalized value differs from what its own string parses to.
+func TestHegelPinNormalizeAgreesWithItsString(t *testing.T) {
+	for _, p := range []packageurl.PackageURL{
+		{Type: "generic", Namespace: "a//b", Name: "n"},
+		{Type: "generic", Name: "/n/"},
+		{Type: "generic", Namespace: "a", Name: "n/"},
+	} {
+		q := p
+		if err := q.Normalize(); err != nil {
+			t.Errorf("Normalize(%+v): %v", p, err)
+			continue
+		}
+		back, err := packageurl.FromString(q.ToString())
+		if err != nil {
+			t.Errorf("FromString(%q) after Normalize(%+v): %v", q.ToString(), p, err)
+			continue
+		}
+		if back.Namespace != q.Namespace || back.Name != q.Name {
+			t.Errorf("Normalize(%+v) = namespace %q name %q, but its string %q parses to namespace %q name %q", p, q.Namespace, q.Name, q.ToString(), back.Namespace, back.Name)
+		}
+		if strings.Contains(q.Namespace, "//") || q.Name != strings.Trim(q.Name, "/") {
+			t.Errorf("Normalize(%+v) left namespace %q name %q; the build procedure strips slashes around the name and empty segments", p, q.Namespace, q.Name)
+		}
+	}
+}
+
+// packageurl-go/6: the type definitions mark the hex, luarocks, otp, pub and vscode-extension
+// names, the hex, luarocks, yocto and vscode-extension namespaces and the oci, pypi and
+// vscode-extension versions case insensitive ("the form shall be lowercase"); upstream keeps
+// their case.
+func TestHegelPinCaseInsensitiveComponentsAreLowercased(t *testing.T) {
+	for in, want := range map[string]string{
+		"pkg:hex/NS/Name":                "pkg:hex/ns/name",
+		"pkg:luarocks/NS/Name":           "pkg:luarocks/ns/name",
+		"pkg:oci/Name@V":                 "pkg:oci/name@v",
+		"pkg:otp/Name":                   "pkg:otp/name",
+		"pkg:pub/Name":                   "pkg:pub/name",
+		"pkg:pypi/name@V1":               "pkg:pypi/name@v1",
+		"pkg:vscode-extension/NS/Name@V": "pkg:vscode-extension/ns/name@v",
+		"pkg:yocto/NS/Name":              "pkg:yocto/ns/Name",
+	} {
+		p, err := packageurl.FromString(in)
+		if err != nil {
+			t.Errorf("FromString(%q): %v", in, err)
+			continue
+		}
+		if got := p.ToString(); got != want {
+			t.Errorf("FromString(%q).ToString() = %q, want %q", in, got, want)
+		}
+	}
+}
+
+// packageurl-go/7: chrome-extension names accept the letters q-z; the type definition's
+// permitted characters are ^[a-p]{32}$.
+func TestHegelPinChromeExtensionNameIsBase16Letters(t *testing.T) {
+	if _, err := packageurl.FromString("pkg:chrome-extension/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaz"); err == nil {
+		t.Errorf("FromString accepted a chrome-extension name with 'z'; the permitted characters are a-p")
+	}
+}
+
+// packageurl-go/8: the namespace requirement of the type definitions is checked for six types
+// only.
+func TestHegelPinNamespaceRequirementIsChecked(t *testing.T) {
+	for _, s := range []string{"pkg:maven/name", "pkg:github/name", "pkg:golang/name", "pkg:deb/name", "pkg:rpm/name", "pkg:huggingface/name"} {
+		if _, err := packageurl.FromString(s); err == nil {
+			t.Errorf("FromString(%q) accepted; the type definition requires a namespace", s)
+		}
+	}
+	for _, s := range []string{"pkg:pypi/ns/name", "pkg:cargo/ns/name", "pkg:gem/ns/name", "pkg:nuget/ns/name", "pkg:cran/ns/name", "pkg:oci/ns/name"} {
+		if _, err := packageurl.FromString(s); err == nil {
+			t.Errorf("FromString(%q) accepted; the type definition prohibits a namespace", s)
+		}
+	}
+}
+
+// packageurl-go/9: ToString on a value that has not been normalized writes qualifiers with an
+// empty value, percent-encoding their keys, so the string may not parse; the build procedure
+// discards pairs with an empty value.
+func TestHegelPinToStringDropsEmptyQualifiers(t *testing.T) {
+	p := packageurl.PackageURL{Type: "generic", Name: "name", Qualifiers: packageurl.Qualifiers{{Key: "k", Value: ""}, {Key: "a", Value: "b"}}}
+	if got, want := p.ToString(), "pkg:generic/name?a=b"; got != want {
+		t.Errorf("ToString() = %q, want %q", got, want)
+	}
+	p = packageurl.PackageURL{Type: "generic", Name: "name", Qualifiers: packageurl.Qualifiers{{Key: "1k", Value: ""}}}
+	s := p.ToString()
+	if _, err := packageurl.FromString(s); err != nil {
+		t.Errorf("ToString() = %q, which FromString rejects: %v (Normalize accepts the value, dropping the pair)", s, err)
+	}
+	if _, err := packageurl.FromString("pkg:generic/name?1k="); err != nil {
+		t.Errorf("FromString(%q): %v; the parse procedure discards a pair with an empty value before anything else, as Normalize does", "pkg:generic/name?1k=", err)
+	}
+}
+
+// packageurl-go/10: the swid type definition requires the tag_id qualifier; upstream checks
+// julia's uuid but not swid's tag_id.
+func TestHegelPinSwidRequiresTagID(t *testing.T) {
+	if _, err := packageurl.FromString("pkg:swid/Fedora@29"); err == nil {
+		t.Errorf("FromString(%q) accepted; a swid purl must have a tag_id qualifier", "pkg:swid/Fedora@29")
+	}
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..840a7c0
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,457 @@
+package packageurl_test
+
+import (
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/package-url/packageurl-go"
+)
+
+// toPURL and fromPURL convert between the model's components and the package's struct.
+func toPURL(c comps) packageurl.PackageURL {
+	var qs packageurl.Qualifiers
+	for _, q := range c.quals {
+		qs = append(qs, packageurl.Qualifier{Key: q.k, Value: q.v})
+	}
+	return packageurl.PackageURL{Type: c.typ, Namespace: c.ns, Name: c.name, Version: c.version, Qualifiers: qs, Subpath: c.subpath}
+}
+
+func fromPURL(p packageurl.PackageURL) comps {
+	c := comps{typ: p.Type, ns: p.Namespace, name: p.Name, version: p.Version, subpath: p.Subpath}
+	for _, q := range p.Qualifiers {
+		c.quals = append(c.quals, kv{q.Key, q.Value})
+	}
+	return c
+}
+
+func sameComps(a, b comps) bool {
+	if len(a.quals) == 0 {
+		a.quals = nil
+	}
+	if len(b.quals) == 0 {
+		b.quals = nil
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+// knownComps reports (and counts) whether the components fall under a Known switch.
+func knownComps(c *collector, in comps) bool {
+	switch {
+	case Known.typePunctuation && lenientTypeRE.MatchString(lower(in.typ)) && !typeRE.MatchString(lower(in.typ)):
+		c.count("skipped: type starting with punctuation or holding +")
+		return true
+	case Known.nameSlashes && in.name != "" && in.name != strings.Trim(in.name, "/"):
+		c.count("skipped: name with leading or trailing slash")
+		return true
+	case Known.emptyNamespaceSegments && strings.Contains(strings.Trim(in.ns, "/"), "//"):
+		c.count("skipped: empty namespace segment")
+		return true
+	case Known.subpathDots && subpathHasDots(in.subpath):
+		c.count("skipped: subpath with dot or empty segments")
+		return true
+	case Known.namespaceRequirement && namespaceRuleUnenforced(in):
+		c.count("skipped: namespace requirement not enforced upstream")
+		return true
+	case Known.emptyQualifierWritten && hasEmptyValuedQualifier(in):
+		c.count("skipped: qualifier with an empty value (written by ToString)")
+		return true
+	case Known.caseRules && affectedByCaseRules(in):
+		c.count("skipped: case rule not applied upstream")
+		return true
+	case Known.chromeExtensionLetters && lower(in.typ) == "chrome-extension" && strings.ContainsAny(in.name, "qrstuvwxyz"):
+		c.count("skipped: chrome-extension name with q-z")
+		return true
+	}
+	for _, q := range in.quals {
+		if Known.keyPunctuation && q.v != "" && (strings.HasPrefix(q.k, ".") || strings.HasPrefix(q.k, "-") || strings.HasPrefix(q.k, "_")) {
+			c.count("skipped: qualifier key starting with punctuation")
+			return true
+		}
+	}
+	return false
+}
+
+func subpathHasDots(sp string) bool {
+	if sp == "" {
+		return false
+	}
+	for _, s := range strings.Split(strings.Trim(sp, "/"), "/") {
+		if s == "" || s == "." || s == ".." {
+			return true
+		}
+	}
+	return false
+}
+
+func hasEmptyValuedQualifier(in comps) bool {
+	for _, q := range in.quals {
+		if q.v == "" {
+			return true
+		}
+	}
+	return false
+}
+
+// enforcesNamespace: the types whose namespace requirement upstream checks.
+func enforcesNamespace(typ string) bool {
+	switch typ {
+	case "swift", "vscode-extension", "chrome-extension", "julia", "otp", "vcpkg":
+		return true
+	}
+	return false
+}
+
+// namespaceRuleUnenforced: the type definition requires or prohibits a namespace and upstream
+// does not check it (it checks swift and vscode-extension for required, chrome-extension,
+// julia, otp and vcpkg for prohibited).
+func namespaceRuleUnenforced(in comps) bool {
+	r, ok := typeRules[lower(in.typ)]
+	if !ok {
+		return false
+	}
+	ns := strings.Join(nsSegments(in.ns), "/")
+	if enforcesNamespace(lower(in.typ)) {
+		return false
+	}
+	return r.nsReq == "required" && ns == "" || r.nsReq == "prohibited" && ns != ""
+}
+
+// affectedByCaseRules: the type definitions lowercase a component that upstream keeps.
+func affectedByCaseRules(in comps) bool {
+	switch lower(in.typ) {
+	case "hex", "luarocks", "vscode-extension":
+		return lower(in.ns) != in.ns || lower(in.name) != in.name || lower(in.typ) == "vscode-extension" && lower(in.version) != in.version
+	case "yocto":
+		return lower(in.ns) != in.ns
+	case "oci":
+		return lower(in.name) != in.name || lower(in.version) != in.version
+	case "otp", "pub":
+		return lower(in.name) != in.name
+	case "pypi":
+		return lower(in.version) != in.version
+	case "chrome-extension":
+		return lower(in.name) != in.name
+	}
+	return false
+}
+
+// TestHegelBuildFollowsTheSpec: Normalize and ToString on components against the
+// specification's build procedure: the same acceptance, the same normalized components and
+// the same canonical string; the string ToString produces before Normalize parses back to
+// the same purl.
+func TestHegelBuildFollowsTheSpec(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		in := genComps(tc)
+		if knownComps(c, in) {
+			return
+		}
+		want, wantComps, wantErr := build(in)
+		p := toPURL(in)
+		raw := p.ToString()
+		q := p
+		err := q.Normalize()
+		if (err == nil) != (wantErr == nil) {
+			c.failClass(ht, "accept", "Normalize(%+v): err=%v; the specification says err=%v", in, err, wantErr)
+			return
+		}
+		if err != nil {
+			c.count("rejected by both")
+			return
+		}
+		if got := fromPURL(q); !sameComps(got, wantComps) {
+			c.failClass(ht, "normalize", "Normalize(%+v)\n  = %+v\n  spec %+v", in, got, wantComps)
+			return
+		}
+		if got := q.ToString(); got != want {
+			c.failClass(ht, "string", "ToString(Normalize(%+v))\n  = %q\n  spec %q", in, got, want)
+			return
+		}
+		if q.String() != want {
+			c.failClass(ht, "string", "String() != ToString() for %+v", in)
+			return
+		}
+		// The un-normalized ToString must at least mean the same purl.
+		back, err := packageurl.FromString(raw)
+		if err != nil {
+			c.failClass(ht, "raw", "FromString(ToString(%+v) = %q): %v", in, raw, err)
+			return
+		}
+		if got := fromPURL(back); !sameComps(got, wantComps) {
+			c.failClass(ht, "raw", "FromString(ToString(%+v) = %q)\n  = %+v\n  want %+v", in, raw, got, wantComps)
+			return
+		}
+		c.count("agreed")
+	})
+}
+
+// TestHegelParseFollowsTheSpec: FromString against the specification's parse procedure on
+// strings spelled in the accepted variety and on mutated strings.
+func TestHegelParseFollowsTheSpec(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		in := genComps(tc)
+		s := genString(tc, in)
+		if chance(tc, 25) {
+			s = mutate(tc, s)
+		}
+		if !validUTF8(s) {
+			c.count("skipped: invalid UTF-8")
+			return
+		}
+		if strings.Count(s, "#") > 1 || strings.Count(strings.SplitN(s, "#", 2)[0], "?") > 1 {
+			// an unencoded second '?' or '#' is not a valid purl; the procedure text splits
+			// once from the right, upstream at the first (README, accepted differences)
+			c.count("skipped: repeated ? or #")
+			return
+		}
+		if q := strings.SplitN(s, "#", 2)[0]; strings.Contains(q, "?") && strings.Contains(q[strings.Index(q, "?"):], ";") {
+			// ';' is not a permitted character; upstream rejects it in the qualifiers as
+			// url.ParseQuery does, the model reads it as data (README, accepted differences)
+			c.count("skipped: unencoded ; in the qualifiers")
+			return
+		}
+		if Known.emptyQualifierWritten && emptyValuedInvalidKey(s) {
+			c.count("skipped: empty-valued qualifier with an invalid key")
+			return
+		}
+		raw, rawErr := parseRaw(s)
+		if rawErr == nil && Known.nameSlashes && raw.name != strings.Trim(raw.name, "/") {
+			c.count("skipped: name with leading or trailing slash")
+			return
+		}
+		wantComps, wantErr := parse(s)
+		if wantErr == nil && knownComps(c, wantComps) {
+			return
+		}
+		if Known.namespaceRequirement && wantErr != nil && strings.Contains(wantErr.Error(), "namespace is ") && !enforcesNamespace(lower(typeOf(s))) {
+			c.count("skipped: namespace requirement not enforced upstream")
+			return
+		}
+		if Known.encodedSlash && wantErr != nil && strings.Contains(wantErr.Error(), "contains a slash") {
+			c.count("skipped: percent-encoded slash in a segment")
+			return
+		}
+		if Known.subpathDots && wantErr == nil && subpathDotsInString(s) {
+			c.count("skipped: subpath with dot or empty segments")
+			return
+		}
+		if Known.typePunctuation && wantErr != nil && strings.Contains(wantErr.Error(), "invalid type") && lenientTypeRE.MatchString(lower(typeOf(s))) {
+			c.count("skipped: type starting with punctuation or holding +")
+			return
+		}
+		if Known.keyPunctuation && wantErr != nil && strings.Contains(wantErr.Error(), "invalid qualifier key") && keyStartsWithPunct(s) {
+			c.count("skipped: qualifier key starting with punctuation")
+			return
+		}
+		if remainderStartsWithAt(s) {
+			c.count("skipped: unencoded @ at the start of the remainder (npm scope leniency)")
+			return
+		}
+		got, err := packageurl.FromString(s)
+		if (err == nil) != (wantErr == nil) {
+			c.failClass(ht, "accept", "FromString(%q): err=%v; the specification says err=%v (components %+v)", s, err, wantErr, wantComps)
+			return
+		}
+		if err != nil {
+			c.count("rejected by both")
+			return
+		}
+		g := fromPURL(got)
+		if Known.caseRules && affectedByCaseRules(g) {
+			c.count("skipped: case rule not applied upstream")
+			return
+		}
+		if !sameComps(g, wantComps) {
+			c.failClass(ht, "components", "FromString(%q)\n  = %+v\n  spec %+v", s, g, wantComps)
+			return
+		}
+		c.count("agreed")
+	})
+}
+
+// typeOf returns the type part of a purl string as written.
+func typeOf(s string) string {
+	_, rest, ok := strings.Cut(s, ":")
+	if !ok {
+		return ""
+	}
+	rest = strings.TrimLeft(rest, "/")
+	typ, _, _ := strings.Cut(rest, "/")
+	return typ
+}
+
+func remainderStartsWithAt(s string) bool {
+	_, rest, ok := strings.Cut(s, ":")
+	if !ok {
+		return false
+	}
+	rest = strings.TrimLeft(rest, "/")
+	_, rem, ok := strings.Cut(rest, "/")
+	return ok && strings.HasPrefix(rem, "@")
+}
+
+func keyStartsWithPunct(s string) bool {
+	if i := strings.IndexByte(s, '#'); i >= 0 {
+		s = s[:i]
+	}
+	_, q, ok := strings.Cut(s, "?")
+	if !ok {
+		return false
+	}
+	for _, pair := range strings.Split(q, "&") {
+		k, _, _ := strings.Cut(pair, "=")
+		if strings.HasPrefix(k, ".") || strings.HasPrefix(k, "-") || strings.HasPrefix(k, "_") {
+			return true
+		}
+	}
+	return false
+}
+
+// emptyValuedInvalidKey: the string has a qualifier pair with an empty value whose key is not
+// valid (the parse procedure discards the pair; upstream checks the key first).
+func emptyValuedInvalidKey(s string) bool {
+	if i := strings.IndexByte(s, '#'); i >= 0 {
+		s = s[:i]
+	}
+	_, q, ok := strings.Cut(s, "?")
+	if !ok {
+		return false
+	}
+	for _, pair := range strings.Split(q, "&") {
+		if pair == "" {
+			continue
+		}
+		k, v, _ := strings.Cut(pair, "=")
+		if v == "" && !qualKeyRE.MatchString(lower(k)) {
+			return true
+		}
+	}
+	return false
+}
+
+func subpathDotsInString(s string) bool {
+	i := strings.LastIndexByte(s, '#')
+	if i < 0 {
+		return false
+	}
+	for _, seg := range strings.Split(s[i+1:], "/") {
+		d, _ := decode(seg)
+		if d == "" || d == "." || d == ".." {
+			return true
+		}
+	}
+	return false
+}
+
+// TestHegelRoundTrip: the laws the package documents, without the model. A canonical string
+// is a fixed point of ToString after FromString; a parsed value is a fixed point of
+// Normalize and of FromString after ToString; Copy-free.
+func TestHegelRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		in := genComps(tc)
+		var s string
+		if chance(tc, 50) {
+			s = genString(tc, in)
+			if chance(tc, 25) {
+				s = mutate(tc, s)
+			}
+		} else {
+			p := toPURL(in)
+			s = p.ToString()
+		}
+		if !validUTF8(s) {
+			c.count("skipped: invalid UTF-8")
+			return
+		}
+		p, err := packageurl.FromString(s)
+		if err != nil {
+			c.count("rejected")
+			return
+		}
+		if Known.subpathDots && subpathHasDots(p.Subpath) {
+			c.count("skipped: subpath with dot or empty segments")
+			return
+		}
+		if Known.nameSlashes && p.Name != strings.Trim(p.Name, "/") {
+			c.count("skipped: name with leading or trailing slash")
+			return
+		}
+		if Known.emptyNamespaceSegments && strings.Contains(p.Namespace, "//") {
+			c.count("skipped: empty namespace segment")
+			return
+		}
+		canon := p.ToString()
+		q, err := packageurl.FromString(canon)
+		if err != nil {
+			c.failClass(ht, "reparse", "FromString(%q) = %+v, whose ToString %q does not parse: %v", s, p, canon, err)
+			return
+		}
+		if !sameComps(fromPURL(q), fromPURL(p)) {
+			c.failClass(ht, "reparse", "FromString(%q) = %+v, but FromString(ToString) = %+v (string %q)", s, p, q, canon)
+			return
+		}
+		if again := q.ToString(); again != canon {
+			c.failClass(ht, "fixed point", "ToString is not a fixed point: %q then %q (from %q)", canon, again, s)
+			return
+		}
+		r := p
+		if err := r.Normalize(); err != nil {
+			c.failClass(ht, "normalize", "Normalize on a parsed purl %+v (from %q) fails: %v", p, s, err)
+			return
+		}
+		if !sameComps(fromPURL(r), fromPURL(p)) {
+			c.failClass(ht, "normalize", "Normalize is not idempotent: %+v then %+v (from %q)", p, r, s)
+			return
+		}
+		c.count("agreed")
+	})
+}
+
+// TestHegelQualifiersRoundTrip: QualifiersFromMap and Map are inverse, Qualifiers.String is
+// the sorted, encoded form, Qualifier.String encodes key and value.
+func TestHegelQualifiersRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		tc := hegel.TestCase(ht)
+		m := map[string]string{}
+		for i := n(tc, 0, 4); i > 0; i-- {
+			m[pick(tc, qualKeys)+pick(tc, []string{"", "2", "_x"})] = genPiece(tc, n(tc, 0, 2))
+		}
+		qs := packageurl.QualifiersFromMap(m)
+		if got := qs.Map(); !reflect.DeepEqual(got, m) {
+			c.failClass(ht, "map", "QualifiersFromMap(%v).Map() = %v", m, got)
+			return
+		}
+		keys := make([]string, 0, len(m))
+		for k := range m {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for i, q := range qs {
+			if q.Key != keys[i] {
+				c.failClass(ht, "order", "QualifiersFromMap(%v) = %v, not sorted by key", m, qs)
+				return
+			}
+			parts = append(parts, encode(q.Key)+"="+encode(q.Value))
+			if q.String() != encode(q.Key)+"="+encode(q.Value) {
+				c.failClass(ht, "qualifier", "Qualifier%v.String() = %q, want %q", q, q.String(), encode(q.Key)+"="+encode(q.Value))
+				return
+			}
+		}
+		if got, want := qs.String(), strings.Join(parts, "&"); got != want {
+			c.failClass(ht, "string", "Qualifiers(%v).String() = %q, want %q", m, got, want)
+			return
+		}
+		c.count("agreed")
+	})
+}
