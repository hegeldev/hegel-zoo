index 0000000..2040608
--- /dev/null
+++ b/hegel_model_test.go
@@ -0,0 +1,432 @@
+package packageurl_test
+
+// A model of the purl specification: "How to build a PURL", "How to parse a PURL", the
+// character-encoding clause (5.4), the component rules (5.6) and the type definitions
+// (types/<type>-definition.json) as of purl-spec 9d6b901, the commit upstream's testdata
+// submodule pins.
+
+import (
+	"errors"
+	"fmt"
+	"net/url"
+	"regexp"
+	"sort"
+	"strings"
+	"unicode/utf8"
+)
+
+type kv struct{ k, v string }
+
+// comps is a purl as six components; qualifiers keep their order.
+type comps struct {
+	typ, ns, name, version string
+	quals                  []kv
+	subpath                string
+}
+
+// typeRule is what a type definition says about a component.
+type typeRule struct {
+	nsReq                        string // "required", "optional", "prohibited"
+	nsLower, nameLower, verLower bool   // case_sensitive: false ("the form shall be lowercase")
+	requiredQuals                []string
+	namePattern, verPattern      *regexp.Regexp // permitted_characters
+}
+
+// typeRules: the registered types at 9d6b901. Types not listed are unregistered: the type
+// component alone is validated. (Normalization rules given as prose - hackage "Apply
+// kebab-case", pub "Replace non-[a-z] letters...", pypi "Replace underscore with dash" - are
+// modelled only for pypi, whose rule upstream implements; hackage and pub names are kept as
+// they are, see the README.)
+var typeRules = map[string]typeRule{
+	"alpm":             {nsReq: "required", nsLower: true, nameLower: true},
+	"apk":              {nsReq: "required", nsLower: true, nameLower: true},
+	"bazel":            {nsReq: "prohibited"},
+	"bitbucket":        {nsReq: "required", nsLower: true, nameLower: true},
+	"bitnami":          {nsReq: "prohibited", nameLower: true},
+	"brew":             {nsReq: "optional", nsLower: true, nameLower: true},
+	"cargo":            {nsReq: "prohibited"},
+	"chrome-extension": {nsReq: "prohibited", nameLower: true, namePattern: regexp.MustCompile(`^[a-p]{32}$`), verPattern: regexp.MustCompile(`^\d+(\.\d+){0,3}$`)},
+	"cocoapods":        {nsReq: "prohibited"},
+	"composer":         {nsReq: "required", nsLower: true, nameLower: true},
+	"conan":            {nsReq: "optional"},
+	"conda":            {nsReq: "prohibited"},
+	"cpan":             {nsReq: "optional"},
+	"cran":             {nsReq: "prohibited"},
+	"deb":              {nsReq: "required", nsLower: true, nameLower: true},
+	"docker":           {nsReq: "optional"},
+	"gem":              {nsReq: "prohibited"},
+	"generic":          {nsReq: "optional"},
+	"github":           {nsReq: "required", nsLower: true, nameLower: true},
+	"golang":           {nsReq: "required", nsLower: true, nameLower: true}, // case_sensitive: true, but "must be lowercased" in the notes; upstream lowercases
+	"hackage":          {nsReq: "prohibited"},
+	"hex":              {nsReq: "optional", nsLower: true, nameLower: true},
+	"huggingface":      {nsReq: "required", verLower: true},
+	"julia":            {nsReq: "prohibited", requiredQuals: []string{"uuid"}},
+	"luarocks":         {nsReq: "optional", nsLower: true, nameLower: true},
+	"maven":            {nsReq: "required"},
+	"mlflow":           {nsReq: "prohibited"},
+	"npm":              {nsReq: "optional"},
+	"nuget":            {nsReq: "prohibited"},
+	"oci":              {nsReq: "prohibited", nameLower: true, verLower: true},
+	"opam":             {nsReq: "prohibited"},
+	"otp":              {nsReq: "prohibited", nameLower: true},
+	"pub":              {nsReq: "prohibited", nameLower: true},
+	"pypi":             {nsReq: "prohibited", nameLower: true, verLower: true},
+	"qpkg":             {nsReq: "required", nsLower: true},
+	"rpm":              {nsReq: "required", nsLower: true},
+	"swid":             {nsReq: "optional", requiredQuals: []string{"tag_id"}},
+	"swift":            {nsReq: "required"},
+	"vcpkg":            {nsReq: "prohibited"},
+	"vscode-extension": {nsReq: "required", nsLower: true, nameLower: true, verLower: true},
+	"yocto":            {nsReq: "optional", nsLower: true},
+}
+
+// registeredTypes in sorted order, for the generator.
+var registeredTypes = func() []string {
+	var xs []string
+	for t := range typeRules {
+		xs = append(xs, t)
+	}
+	sort.Strings(xs)
+	return xs
+}()
+
+// isPermitted: 5.4, the characters that shall not be percent-encoded in a component (the
+// Alphanumeric and Punctuation Characters and the colon).
+func isPermitted(c byte) bool {
+	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '.' || c == '-' || c == '_' || c == '~' || c == ':'
+}
+
+// encode percent-encodes s per 5.4: UTF-8 bytes, uppercase hex.
+func encode(s string) string {
+	var b strings.Builder
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if isPermitted(c) {
+			b.WriteByte(c)
+		} else {
+			fmt.Fprintf(&b, "%%%02X", c)
+		}
+	}
+	return b.String()
+}
+
+// decode percent-decodes s ('+' is literal); invalid escapes are an error.
+func decode(s string) (string, error) {
+	return url.PathUnescape(s)
+}
+
+var typeRE = regexp.MustCompile(`^[a-z][a-z0-9.-]*$`)            // 5.6.2, after lowercasing
+var qualKeyRE = regexp.MustCompile(`^[a-z][a-z0-9._-]*$`)        // 5.6.6, after lowercasing
+var lenientTypeRE = regexp.MustCompile(`^[a-z.+-][a-z0-9.+-]*$`) // what upstream accepts (go/packageurl-go/1)
+
+func lower(s string) string { return strings.ToLower(s) }
+
+// nsSegments splits a namespace into its non-empty segments.
+func nsSegments(ns string) []string {
+	var out []string
+	for _, s := range strings.Split(ns, "/") {
+		if s != "" {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+// subpathSegments: the segments of a subpath after discarding empty, '.' and '..' ones.
+func subpathSegments(sp string) []string {
+	var out []string
+	for _, s := range strings.Split(sp, "/") {
+		if s != "" && s != "." && s != ".." {
+			out = append(out, s)
+		}
+	}
+	return out
+}
+
+// normalizeQuals applies 5.6.6 and the build procedure: drop empty values, lowercase keys,
+// validate them, reject duplicates, sort.
+func normalizeQuals(qs []kv) ([]kv, error) {
+	var out []kv
+	seen := map[string]bool{}
+	for _, q := range qs {
+		if q.k == "" {
+			// upstream rejects an empty key before looking at the value; the build procedure
+			// would discard the pair when the value is empty (README, accepted differences)
+			return nil, errors.New("empty qualifier key")
+		}
+		if q.v == "" {
+			continue
+		}
+		k := lower(q.k)
+		if !qualKeyRE.MatchString(k) {
+			return nil, fmt.Errorf("invalid qualifier key %q", q.k)
+		}
+		if seen[k] {
+			return nil, fmt.Errorf("duplicate qualifier key %q", k)
+		}
+		seen[k] = true
+		out = append(out, kv{k, q.v})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].k < out[j].k })
+	return out, nil
+}
+
+// applyTypeRules lowercases what the type definition says is case-insensitive, applies the
+// pypi rule and checks the requirements. c must already have normalized qualifiers.
+func applyTypeRules(c *comps) error {
+	r, known := typeRules[c.typ]
+	if !known {
+		return nil
+	}
+	if r.nsLower {
+		c.ns = lower(c.ns)
+	}
+	if r.nameLower {
+		c.name = lower(c.name)
+	}
+	if c.typ == "pypi" {
+		c.name = strings.ReplaceAll(c.name, "_", "-")
+	}
+	if c.typ == "mlflow" {
+		for _, q := range c.quals {
+			if q.k == "repository_url" && strings.Contains(q.v, "databricks") {
+				c.name = lower(c.name)
+			}
+		}
+	}
+	if r.verLower {
+		c.version = lower(c.version)
+	}
+	switch r.nsReq {
+	case "required":
+		if c.ns == "" {
+			return fmt.Errorf("%s: namespace is required", c.typ)
+		}
+	case "prohibited":
+		if c.ns != "" {
+			return fmt.Errorf("%s: namespace is prohibited", c.typ)
+		}
+	}
+	for _, want := range r.requiredQuals {
+		found := false
+		for _, q := range c.quals {
+			found = found || q.k == want
+		}
+		if !found {
+			return fmt.Errorf("%s: qualifier %s is required", c.typ, want)
+		}
+	}
+	if r.namePattern != nil && !r.namePattern.MatchString(c.name) {
+		return fmt.Errorf("%s: name %q not permitted", c.typ, c.name)
+	}
+	if r.verPattern != nil && c.version != "" && !r.verPattern.MatchString(c.version) {
+		return fmt.Errorf("%s: version %q not permitted", c.typ, c.version)
+	}
+	if c.typ == "cpan" {
+		if strings.ToUpper(c.ns) != c.ns {
+			return errors.New("cpan: namespace must be uppercase")
+		}
+		if strings.Contains(c.name, "::") {
+			return errors.New("cpan: name must not contain ::")
+		}
+	}
+	return nil
+}
+
+// build follows "How to build a PURL": the canonical string and the normalized components,
+// or an error when the components are not a valid purl.
+func build(in comps) (string, comps, error) {
+	c := comps{typ: lower(in.typ), version: in.version}
+	if !typeRE.MatchString(c.typ) {
+		return "", c, fmt.Errorf("invalid type %q", in.typ)
+	}
+	c.ns = strings.Join(nsSegments(strings.Trim(in.ns, "/")), "/")
+	c.name = strings.Trim(in.name, "/")
+	if c.name == "" {
+		return "", c, errors.New("name is required")
+	}
+	var err error
+	if c.quals, err = normalizeQuals(in.quals); err != nil {
+		return "", c, err
+	}
+	c.subpath = strings.Join(subpathSegments(in.subpath), "/")
+	if err := applyTypeRules(&c); err != nil {
+		return "", c, err
+	}
+	var b strings.Builder
+	b.WriteString("pkg:")
+	b.WriteString(c.typ)
+	b.WriteByte('/')
+	if c.ns != "" {
+		for _, seg := range strings.Split(c.ns, "/") {
+			b.WriteString(encode(seg))
+			b.WriteByte('/')
+		}
+	}
+	b.WriteString(encode(c.name))
+	if c.version != "" {
+		b.WriteByte('@')
+		b.WriteString(encode(c.version))
+	}
+	if len(c.quals) > 0 {
+		b.WriteByte('?')
+		for i, q := range c.quals {
+			if i > 0 {
+				b.WriteByte('&')
+			}
+			b.WriteString(q.k)
+			b.WriteByte('=')
+			b.WriteString(encode(q.v))
+		}
+	}
+	if c.subpath != "" {
+		b.WriteByte('#')
+		for i, seg := range strings.Split(c.subpath, "/") {
+			if i > 0 {
+				b.WriteByte('/')
+			}
+			b.WriteString(encode(seg))
+		}
+	}
+	return b.String(), c, nil
+}
+
+// parse follows "How to parse a PURL", then applies the same normalization and type rules as
+// build (the specification's parse procedure ends with "apply type-specific normalization").
+func parse(s string) (comps, error) {
+	c, err := parseRaw(s)
+	if err != nil {
+		return c, err
+	}
+	_, out, err := build(c)
+	if err != nil {
+		return c, err
+	}
+	return out, nil
+}
+
+// parseRaw is the parse procedure alone: components percent-decoded, not yet normalized.
+// Trailing slashes before the name are not stripped, although the procedure says so: the
+// specification's test suite requires "pkg:swift/github.com/Alamofire/@5.4.3" to fail.
+func parseRaw(s string) (comps, error) {
+	var c comps
+	rem := s
+	// subpath
+	if i := strings.LastIndexByte(rem, '#'); i >= 0 {
+		var segs []string
+		for _, seg := range strings.Split(rem[i+1:], "/") {
+			d, err := decode(seg)
+			if err != nil {
+				return c, fmt.Errorf("subpath: %v", err)
+			}
+			if d == "" || d == "." || d == ".." {
+				continue
+			}
+			if strings.Contains(d, "/") {
+				return c, fmt.Errorf("subpath segment %q contains a slash", d)
+			}
+			segs = append(segs, d)
+		}
+		c.subpath = strings.Join(segs, "/")
+		rem = rem[:i]
+	}
+	// qualifiers
+	if i := strings.LastIndexByte(rem, '?'); i >= 0 {
+		var qs []kv
+		for _, pair := range strings.Split(rem[i+1:], "&") {
+			if pair == "" {
+				continue
+			}
+			k, v, _ := strings.Cut(pair, "=")
+			dv, err := decode(v)
+			if err != nil {
+				return c, fmt.Errorf("qualifier value: %v", err)
+			}
+			if dv == "" {
+				continue
+			}
+			qs = append(qs, kv{k, dv})
+		}
+		c.quals = qs
+		rem = rem[:i]
+	}
+	// scheme
+	scheme, rest, ok := strings.Cut(rem, ":")
+	if !ok || lower(scheme) != "pkg" {
+		return c, errors.New("scheme is not pkg")
+	}
+	rem = strings.TrimLeft(rest, "/")
+	// type
+	typ, rest, ok := strings.Cut(rem, "/")
+	if !ok {
+		return c, errors.New("type or name is missing")
+	}
+	c.typ = lower(typ)
+	if !typeRE.MatchString(c.typ) {
+		return c, fmt.Errorf("invalid type %q", typ)
+	}
+	rem = rest
+	// version
+	if i := strings.LastIndexByte(rem, '@'); i >= 0 {
+		v, err := decode(rem[i+1:])
+		if err != nil {
+			return c, fmt.Errorf("version: %v", err)
+		}
+		c.version = v
+		rem = rem[:i]
+	}
+	// name
+	var name string
+	if i := strings.LastIndexByte(rem, '/'); i >= 0 {
+		name = rem[i+1:]
+		rem = rem[:i]
+	} else {
+		name = rem
+		rem = ""
+	}
+	dn, err := decode(name)
+	if err != nil {
+		return c, fmt.Errorf("name: %v", err)
+	}
+	c.name = dn
+	// namespace
+	var segs []string
+	for _, seg := range strings.Split(rem, "/") {
+		if seg == "" {
+			continue
+		}
+		d, err := decode(seg)
+		if err != nil {
+			return c, fmt.Errorf("namespace: %v", err)
+		}
+		if strings.Contains(d, "/") {
+			return c, fmt.Errorf("namespace segment %q contains a slash", d)
+		}
+		segs = append(segs, d)
+	}
+	c.ns = strings.Join(segs, "/")
+	if c.name == "" {
+		return c, errors.New("name is required")
+	}
+	return c, nil
+}
+
+// canonical reports whether s is the canonical form of what it parses to.
+func canonical(s string) bool {
+	c, err := parse(s)
+	if err != nil {
+		return false
+	}
+	out, _, err := build(c)
+	return err == nil && out == s
+}
+
+func validUTF8(ss ...string) bool {
+	for _, s := range ss {
+		if !utf8.ValidString(s) {
+			return false
+		}
+	}
+	return true
+}
diff --git a/hegel_pins_test.go b/hegel_pins_test.go
new file mode 100644
index 0000000..95a225a
--- /dev/null
+++ b/hegel_pins_test.go
@@ -0,0 +1,165 @@
+package packageurl_test
+
+// One plain test per recorded bug (bugs.toml): each asserts what the purl specification (at
+// the commit upstream's testdata pins, purl-spec 9d6b901) says and fails while the bug exists;
+// target.toml lists them as expected failures.
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/package-url/packageurl-go"
+)
+
+// packageurl-go/1: a type may start with '.', '-' or '+' and contain '+'; spec 5.6.2 allows
+// ASCII letters, digits, '.' and '-', starting with a letter.
+func TestHegelPinTypeStartsWithALetter(t *testing.T) {
+	for _, s := range []string{"pkg:+type/name", "pkg:.type/name", "pkg:-type/name", "pkg:ty+pe/name"} {
+		if _, err := packageurl.FromString(s); err == nil {
+			t.Errorf("FromString(%q) accepted; the type shall start with a letter and hold only letters, digits, '.' and '-'", s)
+		}
+	}
+}
+
+// packageurl-go/2: a qualifier key may start with '.', '-' or '_'; spec 5.6.6: a key shall
+// start with an ASCII letter.
+func TestHegelPinQualifierKeyStartsWithALetter(t *testing.T) {
+	for _, s := range []string{"pkg:generic/name?.k=v", "pkg:generic/name?-k=v", "pkg:generic/name?_k=v"} {
+		if _, err := packageurl.FromString(s); err == nil {
+			t.Errorf("FromString(%q) accepted; a qualifier key shall start with a letter", s)
+		}
+	}
+	p := packageurl.PackageURL{Type: "generic", Name: "name", Qualifiers: packageurl.Qualifiers{{Key: "_k", Value: "v"}}}
+	if err := p.Normalize(); err == nil {
+		t.Errorf("Normalize accepted the qualifier key %q", "_k")
+	}
+}
+
+// packageurl-go/3: a percent-encoded slash inside a namespace or subpath segment is accepted
+// and becomes a segment separator; spec 5.6.3 and 5.6.7: a decoded segment shall not contain a
+// slash.
+func TestHegelPinEncodedSlashInASegmentIsRejected(t *testing.T) {
+	if p, err := packageurl.FromString("pkg:generic/ns%2Fx/name"); err == nil {
+		t.Errorf("FromString(%q) = namespace %q, want an error (the decoded segment contains a slash)", "pkg:generic/ns%2Fx/name", p.Namespace)
+	}
+	if p, err := packageurl.FromString("pkg:generic/name#a%2Fb"); err == nil {
+		t.Errorf("FromString(%q) = subpath %q (ToString %q), want an error", "pkg:generic/name#a%2Fb", p.Subpath, p.ToString())
+	}
+}
+
+// packageurl-go/4: subpath segments '.', '..' and empty are kept when leading and rejected
+// otherwise; the parse and build procedures discard them.
+func TestHegelPinSubpathDotSegmentsAreDiscarded(t *testing.T) {
+	for in, want := range map[string]string{"pkg:generic/name#./a": "a", "pkg:generic/name#../a": "a", "pkg:generic/name#a/./b": "a/b", "pkg:generic/name#a//b": "a/b", "pkg:generic/name#..": ""} {
+		p, err := packageurl.FromString(in)
+		if err != nil {
+			t.Errorf("FromString(%q): %v; want subpath %q", in, err, want)
+			continue
+		}
+		if p.Subpath != want {
+			t.Errorf("FromString(%q).Subpath = %q, want %q", in, p.Subpath, want)
+		}
+	}
+}
+
+// packageurl-go/5: Normalize keeps slashes around the name and empty namespace segments, so a
+// normalized value differs from what its own string parses to.
+func TestHegelPinNormalizeAgreesWithItsString(t *testing.T) {
+	for _, p := range []packageurl.PackageURL{
+		{Type: "generic", Namespace: "a//b", Name: "n"},
+		{Type: "generic", Name: "/n/"},
+		{Type: "generic", Namespace: "a", Name: "n/"},
+	} {
+		q := p
+		if err := q.Normalize(); err != nil {
+			t.Errorf("Normalize(%+v): %v", p, err)
+			continue
+		}
+		back, err := packageurl.FromString(q.ToString())
+		if err != nil {
+			t.Errorf("FromString(%q) after Normalize(%+v): %v", q.ToString(), p, err)
+			continue
+		}
+		if back.Namespace != q.Namespace || back.Name != q.Name {
+			t.Errorf("Normalize(%+v) = namespace %q name %q, but its string %q parses to namespace %q name %q", p, q.Namespace, q.Name, q.ToString(), back.Namespace, back.Name)
+		}
+		if strings.Contains(q.Namespace, "//") || q.Name != strings.Trim(q.Name, "/") {
+			t.Errorf("Normalize(%+v) left namespace %q name %q; the build procedure strips slashes around the name and empty segments", p, q.Namespace, q.Name)
+		}
+	}
+}
+
+// packageurl-go/6: the type definitions mark the hex, luarocks, otp, pub and vscode-extension
+// names, the hex, luarocks, yocto and vscode-extension namespaces and the oci, pypi and
+// vscode-extension versions case insensitive ("the form shall be lowercase"); upstream keeps
+// their case.
+func TestHegelPinCaseInsensitiveComponentsAreLowercased(t *testing.T) {
+	for in, want := range map[string]string{
+		"pkg:hex/NS/Name":                "pkg:hex/ns/name",
+		"pkg:luarocks/NS/Name":           "pkg:luarocks/ns/name",
+		"pkg:oci/Name@V":                 "pkg:oci/name@v",
+		"pkg:otp/Name":                   "pkg:otp/name",
+		"pkg:pub/Name":                   "pkg:pub/name",
+		"pkg:pypi/name@V1":               "pkg:pypi/name@v1",
+		"pkg:vscode-extension/NS/Name@V": "pkg:vscode-extension/ns/name@v",
+		"pkg:yocto/NS/Name":              "pkg:yocto/ns/Name",
+	} {
+		p, err := packageurl.FromString(in)
+		if err != nil {
+			t.Errorf("FromString(%q): %v", in, err)
+			continue
+		}
+		if got := p.ToString(); got != want {
+			t.Errorf("FromString(%q).ToString() = %q, want %q", in, got, want)
+		}
+	}
+}
+
+// packageurl-go/7: chrome-extension names accept the letters q-z; the type definition's
+// permitted characters are ^[a-p]{32}$.
+func TestHegelPinChromeExtensionNameIsBase16Letters(t *testing.T) {
+	if _, err := packageurl.FromString("pkg:chrome-extension/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaz"); err == nil {
+		t.Errorf("FromString accepted a chrome-extension name with 'z'; the permitted characters are a-p")
+	}
+}
+
+// packageurl-go/8: the namespace requirement of the type definitions is checked for six types
+// only.
+func TestHegelPinNamespaceRequirementIsChecked(t *testing.T) {
+	for _, s := range []string{"pkg:maven/name", "pkg:github/name", "pkg:golang/name", "pkg:deb/name", "pkg:rpm/name", "pkg:huggingface/name"} {
+		if _, err := packageurl.FromString(s); err == nil {
+			t.Errorf("FromString(%q) accepted; the type definition requires a namespace", s)
+		}
+	}
+	for _, s := range []string{"pkg:pypi/ns/name", "pkg:cargo/ns/name", "pkg:gem/ns/name", "pkg:nuget/ns/name", "pkg:cran/ns/name", "pkg:oci/ns/name"} {
+		if _, err := packageurl.FromString(s); err == nil {
+			t.Errorf("FromString(%q) accepted; the type definition prohibits a namespace", s)
+		}
+	}
+}
+
+// packageurl-go/9: ToString on a value that has not been normalized writes qualifiers with an
+// empty value, percent-encoding their keys, so the string may not parse; the build procedure
+// discards pairs with an empty value.
+func TestHegelPinToStringDropsEmptyQualifiers(t *testing.T) {
+	p := packageurl.PackageURL{Type: "generic", Name: "name", Qualifiers: packageurl.Qualifiers{{Key: "k", Value: ""}, {Key: "a", Value: "b"}}}
+	if got, want := p.ToString(), "pkg:generic/name?a=b"; got != want {
+		t.Errorf("ToString() = %q, want %q", got, want)
+	}
+	p = packageurl.PackageURL{Type: "generic", Name: "name", Qualifiers: packageurl.Qualifiers{{Key: "1k", Value: ""}}}
+	s := p.ToString()
+	if _, err := packageurl.FromString(s); err != nil {
+		t.Errorf("ToString() = %q, which FromString rejects: %v (Normalize accepts the value, dropping the pair)", s, err)
+	}
+	if _, err := packageurl.FromString("pkg:generic/name?1k="); err != nil {
+		t.Errorf("FromString(%q): %v; the parse procedure discards a pair with an empty value before anything else, as Normalize does", "pkg:generic/name?1k=", err)
+	}
+}
+
+// packageurl-go/10: the swid type definition requires the tag_id qualifier; upstream checks
+// julia's uuid but not swid's tag_id.
+func TestHegelPinSwidRequiresTagID(t *testing.T) {
+	if _, err := packageurl.FromString("pkg:swid/Fedora@29"); err == nil {
+		t.Errorf("FromString(%q) accepted; a swid purl must have a tag_id qualifier", "pkg:swid/Fedora@29")
+	}
+}
diff --git a/hegel_props_test.go b/hegel_props_test.go
new file mode 100644
index 0000000..81c1874
--- /dev/null
+++ b/hegel_props_test.go
@@ -0,0 +1,458 @@
+package packageurl_test
+
+import (
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+
+	"github.com/package-url/packageurl-go"
+)
+
+// toPURL and fromPURL convert between the model's components and the package's struct.
+func toPURL(c comps) packageurl.PackageURL {
+	var qs packageurl.Qualifiers
+	for _, q := range c.quals {
+		qs = append(qs, packageurl.Qualifier{Key: q.k, Value: q.v})
+	}
+	return packageurl.PackageURL{Type: c.typ, Namespace: c.ns, Name: c.name, Version: c.version, Qualifiers: qs, Subpath: c.subpath}
+}
+
+func fromPURL(p packageurl.PackageURL) comps {
+	c := comps{typ: p.Type, ns: p.Namespace, name: p.Name, version: p.Version, subpath: p.Subpath}
+	for _, q := range p.Qualifiers {
+		c.quals = append(c.quals, kv{q.Key, q.Value})
+	}
+	return c
+}
+
+func sameComps(a, b comps) bool {
+	if len(a.quals) == 0 {
+		a.quals = nil
+	}
+	if len(b.quals) == 0 {
+		b.quals = nil
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+// knownComps reports (and counts) whether the components fall under a Known switch.
+func knownComps(c *collector, in comps) bool {
+	switch {
+	case Known.typePunctuation && lenientTypeRE.MatchString(lower(in.typ)) && !typeRE.MatchString(lower(in.typ)):
+		c.count("skipped: type starting with punctuation or holding +")
+		return true
+	case Known.nameSlashes && in.name != "" && in.name != strings.Trim(in.name, "/"):
+		c.count("skipped: name with leading or trailing slash")
+		return true
+	case Known.emptyNamespaceSegments && strings.Contains(strings.Trim(in.ns, "/"), "//"):
+		c.count("skipped: empty namespace segment")
+		return true
+	case Known.subpathDots && subpathHasDots(in.subpath):
+		c.count("skipped: subpath with dot or empty segments")
+		return true
+	case Known.namespaceRequirement && namespaceRuleUnenforced(in):
+		c.count("skipped: namespace requirement not enforced upstream")
+		return true
+	case Known.emptyQualifierWritten && hasEmptyValuedInvalidKey(in):
+		c.count("skipped: qualifier with an empty value and an invalid key (written by ToString)")
+		return true
+	case Known.caseRules && affectedByCaseRules(in):
+		c.count("skipped: case rule not applied upstream")
+		return true
+	case Known.chromeExtensionLetters && lower(in.typ) == "chrome-extension" && strings.ContainsAny(in.name, "qrstuvwxyz"):
+		c.count("skipped: chrome-extension name with q-z")
+		return true
+	case Known.swidTagID && lower(in.typ) == "swid" && !hasQualifier(in, "tag_id"):
+		c.count("skipped: swid without tag_id")
+		return true
+	}
+	for _, q := range in.quals {
+		if Known.keyPunctuation && q.v != "" && (strings.HasPrefix(q.k, ".") || strings.HasPrefix(q.k, "-") || strings.HasPrefix(q.k, "_")) {
+			c.count("skipped: qualifier key starting with punctuation")
+			return true
+		}
+	}
+	return false
+}
+
+func subpathHasDots(sp string) bool {
+	if sp == "" {
+		return false
+	}
+	for _, s := range strings.Split(strings.Trim(sp, "/"), "/") {
+		if s == "" || s == "." || s == ".." {
+			return true
+		}
+	}
+	return false
+}
+
+// hasEmptyValuedInvalidKey: a qualifier with an empty value whose key is not a valid key, which
+// Normalize drops and ToString before Normalize writes for FromString to reject.
+func hasEmptyValuedInvalidKey(in comps) bool {
+	for _, q := range in.quals {
+		if q.v == "" && !qualKeyRE.MatchString(lower(q.k)) {
+			return true
+		}
+	}
+	return false
+}
+
+// hasQualifier: the key is present with a non-empty value (after lowercasing).
+func hasQualifier(in comps, key string) bool {
+	for _, q := range in.quals {
+		if lower(q.k) == key && q.v != "" {
+			return true
+		}
+	}
+	return false
+}
+
+// enforcesNamespace: the types whose namespace requirement upstream checks.
+func enforcesNamespace(typ string) bool {
+	switch typ {
+	case "swift", "vscode-extension", "chrome-extension", "julia", "otp", "vcpkg":
+		return true
+	}
+	return false
+}
+
+// namespaceRuleUnenforced: the type definition requires or prohibits a namespace and upstream
+// does not check it (it checks swift and vscode-extension for required, chrome-extension,
+// julia, otp and vcpkg for prohibited).
+func namespaceRuleUnenforced(in comps) bool {
+	r, ok := typeRules[lower(in.typ)]
+	if !ok {
+		return false
+	}
+	ns := strings.Join(nsSegments(in.ns), "/")
+	if enforcesNamespace(lower(in.typ)) {
+		return false
+	}
+	return r.nsReq == "required" && ns == "" || r.nsReq == "prohibited" && ns != ""
+}
+
+// affectedByCaseRules: the type definitions lowercase a component that upstream keeps.
+func affectedByCaseRules(in comps) bool {
+	switch lower(in.typ) {
+	case "hex", "luarocks", "vscode-extension":
+		return lower(in.ns) != in.ns || lower(in.name) != in.name || lower(in.typ) == "vscode-extension" && lower(in.version) != in.version
+	case "yocto":
+		return lower(in.ns) != in.ns
+	case "oci":
+		return lower(in.name) != in.name || lower(in.version) != in.version
+	case "otp", "pub":
+		return lower(in.name) != in.name
+	case "pypi":
+		return lower(in.version) != in.version
+	case "chrome-extension":
+		return lower(in.name) != in.name
+	}
+	return false
+}
+
+// checkBuild judges one set of components: Normalize and ToString against the
+// specification's build procedure (the same acceptance, the same normalized components and
+// the same canonical string), and FromString of the string ToString writes before Normalize.
+func checkBuild(c *collector, ht *hegel.T, in comps) {
+	if knownComps(c, in) {
+		ht.Assume(false)
+	}
+	want, wantComps, wantErr := build(in)
+	p := toPURL(in)
+	raw := p.ToString()
+	q := p
+	err := q.Normalize()
+	if (err == nil) != (wantErr == nil) {
+		c.failClass(ht, "accept", "Normalize(%+v): err=%v; the specification says err=%v", in, err, wantErr)
+		return
+	}
+	if err != nil {
+		c.count("rejected by both")
+		return
+	}
+	if got := fromPURL(q); !sameComps(got, wantComps) {
+		c.failClass(ht, "normalize", "Normalize(%+v)\n  = %+v\n  spec %+v", in, got, wantComps)
+		return
+	}
+	if got := q.ToString(); got != want {
+		c.failClass(ht, "string", "ToString(Normalize(%+v))\n  = %q\n  spec %q", in, got, want)
+		return
+	}
+	if q.String() != want {
+		c.failClass(ht, "string", "String() != ToString() for %+v", in)
+		return
+	}
+	// The un-normalized ToString must at least mean the same purl.
+	back, err := packageurl.FromString(raw)
+	if err != nil {
+		c.failClass(ht, "raw", "FromString(ToString(%+v) = %q): %v", in, raw, err)
+		return
+	}
+	if got := fromPURL(back); !sameComps(got, wantComps) {
+		c.failClass(ht, "raw", "FromString(ToString(%+v) = %q)\n  = %+v\n  want %+v", in, raw, got, wantComps)
+		return
+	}
+	c.count("agreed")
+}
+
+// TestHegelBuildFollowsTheSpec: Normalize and ToString on components against the
+// specification's build procedure: the same acceptance, the same normalized components and
+// the same canonical string; the string ToString produces before Normalize parses back to
+// the same purl. The shapes of packageurl-go/1, 2, 4, 5, 6, 7, 8, 9 and 10 are drawn and fail;
+// HEGEL_NO_KNOWN=1 leaves them out and skips what is left.
+func TestHegelBuildFollowsTheSpec(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkBuild(c, ht, hegel.Draw(ht, purls).comps())
+	})
+}
+
+// checkParse judges one purl string: FromString against the specification's parse procedure.
+func checkParse(c *collector, ht *hegel.T, s string) {
+	if !validUTF8(s) {
+		c.skip(ht, "skipped: invalid UTF-8")
+	}
+	if strings.Count(s, "#") > 1 || strings.Count(strings.SplitN(s, "#", 2)[0], "?") > 1 {
+		// an unencoded second '?' or '#' is not a valid purl; the procedure text splits
+		// once from the right, upstream at the first (README, accepted differences)
+		c.skip(ht, "skipped: repeated ? or #")
+	}
+	if q := strings.SplitN(s, "#", 2)[0]; strings.Contains(q, "?") && strings.Contains(q[strings.Index(q, "?"):], ";") {
+		// ';' is not a permitted character; upstream rejects it in the qualifiers as
+		// url.ParseQuery does, the model reads it as data (README, accepted differences)
+		c.skip(ht, "skipped: unencoded ; in the qualifiers")
+	}
+	if Known.emptyQualifierWritten && emptyValuedInvalidKey(s) {
+		c.skip(ht, "skipped: empty-valued qualifier with an invalid key")
+	}
+	raw, rawErr := parseRaw(s)
+	if rawErr == nil && Known.nameSlashes && raw.name != strings.Trim(raw.name, "/") {
+		c.skip(ht, "skipped: name with leading or trailing slash")
+	}
+	wantComps, wantErr := parse(s)
+	if wantErr == nil && knownComps(c, wantComps) {
+		ht.Assume(false)
+	}
+	if Known.namespaceRequirement && wantErr != nil && strings.Contains(wantErr.Error(), "namespace is ") && !enforcesNamespace(lower(typeOf(s))) {
+		c.skip(ht, "skipped: namespace requirement not enforced upstream")
+	}
+	if Known.swidTagID && wantErr != nil && strings.Contains(wantErr.Error(), "tag_id is required") {
+		c.skip(ht, "skipped: swid without tag_id")
+	}
+	if Known.encodedSlash && wantErr != nil && strings.Contains(wantErr.Error(), "contains a slash") {
+		c.skip(ht, "skipped: percent-encoded slash in a segment")
+	}
+	if Known.subpathDots && wantErr == nil && subpathDotsInString(s) {
+		c.skip(ht, "skipped: subpath with dot or empty segments")
+	}
+	if Known.typePunctuation && wantErr != nil && strings.Contains(wantErr.Error(), "invalid type") && lenientTypeRE.MatchString(lower(typeOf(s))) {
+		c.skip(ht, "skipped: type starting with punctuation or holding +")
+	}
+	if Known.keyPunctuation && wantErr != nil && strings.Contains(wantErr.Error(), "invalid qualifier key") && keyStartsWithPunct(s) {
+		c.skip(ht, "skipped: qualifier key starting with punctuation")
+	}
+	if remainderStartsWithAt(s) {
+		c.skip(ht, "skipped: unencoded @ at the start of the remainder (npm scope leniency)")
+	}
+	got, err := packageurl.FromString(s)
+	if (err == nil) != (wantErr == nil) {
+		c.failClass(ht, "accept", "FromString(%q): err=%v; the specification says err=%v (components %+v)", s, err, wantErr, wantComps)
+		return
+	}
+	if err != nil {
+		c.count("rejected by both")
+		return
+	}
+	g := fromPURL(got)
+	if Known.caseRules && affectedByCaseRules(g) {
+		c.skip(ht, "skipped: case rule not applied upstream")
+	}
+	if !sameComps(g, wantComps) {
+		c.failClass(ht, "components", "FromString(%q)\n  = %+v\n  spec %+v", s, g, wantComps)
+		return
+	}
+	c.count("agreed")
+}
+
+// TestHegelParseFollowsTheSpec: FromString against the specification's parse procedure on
+// strings spelled in the accepted variety and on mutated strings. The shapes of
+// packageurl-go/1, 2, 3, 4, 5, 6, 8, 9 and 10 are drawn and fail; HEGEL_NO_KNOWN=1 leaves
+// them out and skips what is left.
+func TestHegelParseFollowsTheSpec(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkParse(c, ht, hegel.Draw(ht, parseCases).text())
+	})
+}
+
+// typeOf returns the type part of a purl string as written.
+func typeOf(s string) string {
+	_, rest, ok := strings.Cut(s, ":")
+	if !ok {
+		return ""
+	}
+	rest = strings.TrimLeft(rest, "/")
+	typ, _, _ := strings.Cut(rest, "/")
+	return typ
+}
+
+func remainderStartsWithAt(s string) bool {
+	_, rest, ok := strings.Cut(s, ":")
+	if !ok {
+		return false
+	}
+	rest = strings.TrimLeft(rest, "/")
+	_, rem, ok := strings.Cut(rest, "/")
+	return ok && strings.HasPrefix(rem, "@")
+}
+
+func keyStartsWithPunct(s string) bool {
+	if i := strings.IndexByte(s, '#'); i >= 0 {
+		s = s[:i]
+	}
+	_, q, ok := strings.Cut(s, "?")
+	if !ok {
+		return false
+	}
+	for _, pair := range strings.Split(q, "&") {
+		k, _, _ := strings.Cut(pair, "=")
+		if strings.HasPrefix(k, ".") || strings.HasPrefix(k, "-") || strings.HasPrefix(k, "_") {
+			return true
+		}
+	}
+	return false
+}
+
+// emptyValuedInvalidKey: the string has a qualifier pair with an empty value whose key is not
+// valid (the parse procedure discards the pair; upstream checks the key first).
+func emptyValuedInvalidKey(s string) bool {
+	if i := strings.IndexByte(s, '#'); i >= 0 {
+		s = s[:i]
+	}
+	_, q, ok := strings.Cut(s, "?")
+	if !ok {
+		return false
+	}
+	for _, pair := range strings.Split(q, "&") {
+		if pair == "" {
+			continue
+		}
+		k, v, _ := strings.Cut(pair, "=")
+		if v == "" && !qualKeyRE.MatchString(lower(k)) {
+			return true
+		}
+	}
+	return false
+}
+
+func subpathDotsInString(s string) bool {
+	i := strings.LastIndexByte(s, '#')
+	if i < 0 {
+		return false
+	}
+	for _, seg := range strings.Split(s[i+1:], "/") {
+		d, _ := decode(seg)
+		if d == "" || d == "." || d == ".." {
+			return true
+		}
+	}
+	return false
+}
+
+// checkRoundTrip judges one purl string by the laws the package documents, without the model:
+// on a string FromString accepts, ToString parses back to the same value and is a fixed point,
+// and Normalize on the parsed value changes nothing.
+func checkRoundTrip(c *collector, ht *hegel.T, s string) {
+	if !validUTF8(s) {
+		c.skip(ht, "skipped: invalid UTF-8")
+	}
+	p, err := packageurl.FromString(s)
+	if err != nil {
+		c.count("rejected")
+		return
+	}
+	if Known.subpathDots && subpathHasDots(p.Subpath) {
+		c.skip(ht, "skipped: subpath with dot or empty segments")
+	}
+	if Known.nameSlashes && p.Name != strings.Trim(p.Name, "/") {
+		c.skip(ht, "skipped: name with leading or trailing slash")
+	}
+	if Known.emptyNamespaceSegments && strings.Contains(p.Namespace, "//") {
+		c.skip(ht, "skipped: empty namespace segment")
+	}
+	canon := p.ToString()
+	q, err := packageurl.FromString(canon)
+	if err != nil {
+		c.failClass(ht, "reparse", "FromString(%q) = %+v, whose ToString %q does not parse: %v", s, p, canon, err)
+		return
+	}
+	if !sameComps(fromPURL(q), fromPURL(p)) {
+		c.failClass(ht, "reparse", "FromString(%q)\n  = %+v\n  but FromString(ToString) = %+v (string %q)", s, fromPURL(p), fromPURL(q), canon)
+		return
+	}
+	if again := q.ToString(); again != canon {
+		c.failClass(ht, "fixed point", "ToString is not a fixed point: %q then %q (from %q)", canon, again, s)
+		return
+	}
+	r := p
+	if err := r.Normalize(); err != nil {
+		c.failClass(ht, "normalize", "Normalize on a parsed purl %+v (from %q) fails: %v", p, s, err)
+		return
+	}
+	if !sameComps(fromPURL(r), fromPURL(p)) {
+		c.failClass(ht, "normalize", "Normalize is not idempotent: %+v then %+v (from %q)", p, r, s)
+		return
+	}
+	c.count("agreed")
+}
+
+// TestHegelRoundTrip: the laws the package documents, without the model. A canonical string
+// is a fixed point of ToString after FromString; a parsed value is a fixed point of
+// Normalize and of FromString after ToString; Copy-free. The shapes of packageurl-go/4 and 5
+// are drawn and fail; HEGEL_NO_KNOWN=1 leaves them out and skips what is left.
+func TestHegelRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkRoundTrip(c, ht, hegel.Draw(ht, roundTripCases).text())
+	})
+}
+
+// TestHegelQualifiersRoundTrip: QualifiersFromMap and Map are inverse, Qualifiers.String is
+// the sorted, encoded form, Qualifier.String encodes key and value.
+func TestHegelQualifiersRoundTrip(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		m := hegel.Draw(ht, qualifierMaps)
+		qs := packageurl.QualifiersFromMap(m)
+		if got := qs.Map(); !reflect.DeepEqual(got, m) {
+			c.failClass(ht, "map", "QualifiersFromMap(%v).Map() = %v", m, got)
+			return
+		}
+		keys := make([]string, 0, len(m))
+		for k := range m {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for i, q := range qs {
+			if q.Key != keys[i] {
+				c.failClass(ht, "order", "QualifiersFromMap(%v) = %v, not sorted by key", m, qs)
+				return
+			}
+			parts = append(parts, encode(q.Key)+"="+encode(q.Value))
+			if q.String() != encode(q.Key)+"="+encode(q.Value) {
+				c.failClass(ht, "qualifier", "Qualifier%v.String() = %q, want %q", q, q.String(), encode(q.Key)+"="+encode(q.Value))
+				return
+			}
+		}
+		if got, want := qs.String(), strings.Join(parts, "&"); got != want {
+			c.failClass(ht, "string", "Qualifiers(%v).String() = %q, want %q", m, got, want)
+			return
+		}
+		c.count("agreed")
+	})
+}
diff --git a/hegel_shapes_test.go b/hegel_shapes_test.go
new file mode 100644
index 0000000..f573bc8
--- /dev/null
+++ b/hegel_shapes_test.go
@@ -0,0 +1,373 @@
+package packageurl_test
+
+// One property per recorded bug (bugs.toml): a generator over the bug's shape region with
+// random contents, judged by the same model as the wide properties (checkBuild on the
+// components, checkParse on the canonical spelling), so that each bug has a property that
+// finds it every run (the wide properties reach the shapes at their natural rate). Under
+// HEGEL_NO_KNOWN=1 each draws the neighbouring region the bug does not touch instead (a type
+// starting with a letter, a key starting with a letter, an encoded slash in the name or
+// version, dotted words as subpath segments, a slash inside the name, uppercase components of
+// a case-sensitive type, 32 letters a-p, the enforced types or a namespace that fits, an
+// empty-valued qualifier with a valid key, swid with its tag_id) and passes.
+
+import (
+	"strings"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// Pieces the regions are filled with: lowercase words of letters and digits, letters alone (so
+// that uppercasing changes them), and words of the pieces that are not a recorded shape of
+// their own (no slash, no '.' or '..').
+var (
+	lowerWord   = hegel.Text().Alphabet("abcdefghijklmnopqrstuvwxyz0123456789").MinSize(1).MaxSize(6)
+	letters     = hegel.Text().Alphabet("abcdefghijklmnopqrstuvwxyz").MinSize(1).MaxSize(6)
+	plainPieces = without(pieces, "/", ".", "..")
+	plainWord   = joined(many(hegel.SampledFrom(plainPieces), 1, 3), "")
+)
+
+// named is a purl of the generic type with the name.
+func named(name string) purl { return purl{typ: "generic", name: name} }
+
+// --------------------------------------------------------------------------- packageurl-go/1
+
+// punctuationTypes: a type starting with '.', '-' or '+', or holding a '+'; under
+// HEGEL_NO_KNOWN=1 an unregistered type starting with a letter.
+var (
+	punctuationTypes = weighted(
+		choice[string]{3, cat(pick(".", "-", "+"), lowerWord)},
+		choice[string]{1, cat(letters, hegel.Just("+"), lowerWord)},
+	)
+	letterTypes = cat(pick("t", "x", "z"), hegel.Text().Alphabet("abcdefghijklmnopqrstuvwxyz0123456789.-").MaxSize(6))
+	typeCases   = hegel.Composite(func(tc hegel.TestCase) purl {
+		return purl{typ: hegel.Draw(tc, shaped(punctuationTypes, letterTypes)), name: hegel.Draw(tc, plainWord)}
+	})
+)
+
+// TestHegelTypeStartsWithALetter: FromString rejects a type that starts with '.', '-' or '+'
+// or holds a '+' (spec 5.6.2: letters, digits, '.' and '-', starting with a letter); upstream
+// accepts them (packageurl-go/1).
+func TestHegelTypeStartsWithALetter(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkParse(c, ht, render(hegel.Draw(ht, typeCases), canonicalSpelling))
+	})
+}
+
+// --------------------------------------------------------------------------- packageurl-go/2
+
+// punctuationKeys: a qualifier key starting with '.', '-' or '_', with a value; under
+// HEGEL_NO_KNOWN=1 a key starting with a letter.
+var (
+	punctuationKeys = cat(pick(".", "-", "_"), lowerWord)
+	letterKeys      = cat(letters, lowerWord)
+	keyCases        = hegel.Composite(func(tc hegel.TestCase) purl {
+		p := named(hegel.Draw(tc, plainWord))
+		p.quals = []kv{{hegel.Draw(tc, shaped(punctuationKeys, letterKeys)), hegel.Draw(tc, plainWord)}}
+		return p
+	})
+)
+
+// TestHegelQualifierKeyStartsWithALetter: Normalize rejects a qualifier key that starts with
+// '.', '-' or '_' (spec 5.6.6: a key shall start with a letter); upstream accepts them
+// (packageurl-go/2).
+func TestHegelQualifierKeyStartsWithALetter(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkBuild(c, ht, hegel.Draw(ht, keyCases).comps())
+	})
+}
+
+// --------------------------------------------------------------------------- packageurl-go/3
+
+// slashSegmentCases: a namespace or subpath segment holding a slash, which the canonical
+// spelling percent-encodes; under HEGEL_NO_KNOWN=1 the slash is in the name or the version,
+// where it is allowed.
+var (
+	slashed           = cat(plainWord, hegel.Just("/"), plainWord)
+	slashSegmentCases = weighted(
+		choice[purl]{1, hegel.Composite(func(tc hegel.TestCase) purl {
+			p := named(hegel.Draw(tc, plainWord))
+			p.ns = []string{hegel.Draw(tc, slashed)}
+			return p
+		})},
+		choice[purl]{1, hegel.Composite(func(tc hegel.TestCase) purl {
+			p := named(hegel.Draw(tc, plainWord))
+			p.subpath = []string{hegel.Draw(tc, slashed)}
+			return p
+		})},
+	)
+	slashInNameOrVersion = weighted(
+		choice[purl]{1, hegel.Map(slashed, named)},
+		choice[purl]{1, hegel.Composite(func(tc hegel.TestCase) purl {
+			p := named(hegel.Draw(tc, plainWord))
+			p.version = hegel.Draw(tc, slashed)
+			return p
+		})},
+	)
+)
+
+// TestHegelEncodedSlashInASegmentIsRejected: FromString rejects a namespace or subpath
+// segment whose percent-decoded form holds a slash (spec 5.6.3, 5.6.7); upstream accepts the
+// segment and the decoded slash becomes a separator (packageurl-go/3).
+func TestHegelEncodedSlashInASegmentIsRejected(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkParse(c, ht, render(hegel.Draw(ht, shaped(slashSegmentCases, slashInNameOrVersion)), canonicalSpelling))
+	})
+}
+
+// --------------------------------------------------------------------------- packageurl-go/4
+
+// dotSubpaths: subpath segments with a '.' or '..' among them, or an inner empty one; under
+// HEGEL_NO_KNOWN=1 words with dots in them.
+var (
+	dotSubpaths = weighted(
+		choice[[]string]{1, hegel.Composite(func(tc hegel.TestCase) []string {
+			before := hegel.Draw(tc, many(lowerWord, 0, 2))
+			dot := hegel.Draw(tc, pick(".", ".."))
+			after := hegel.Draw(tc, many(lowerWord, 0, 2))
+			return append(append(before, dot), after...)
+		})},
+		choice[[]string]{1, hegel.Composite(func(tc hegel.TestCase) []string {
+			before := hegel.Draw(tc, many(lowerWord, 1, 2))
+			after := hegel.Draw(tc, many(lowerWord, 1, 2))
+			return append(append(before, ""), after...)
+		})},
+	)
+	dottedWordSubpaths = many(weighted(choice[string]{1, lowerWord}, choice[string]{1, pick("...", "a.", ".a", "..a", "a..", "a.b")}), 1, 3)
+	subpathCases       = hegel.Composite(func(tc hegel.TestCase) purl {
+		p := named(hegel.Draw(tc, plainWord))
+		p.subpath = hegel.Draw(tc, shaped(dotSubpaths, dottedWordSubpaths))
+		return p
+	})
+)
+
+// TestHegelSubpathDotSegmentsAreDiscarded: FromString discards subpath segments that are
+// empty, '.' or '..' (the parse procedure); upstream keeps a leading one and rejects an inner
+// one (packageurl-go/4).
+func TestHegelSubpathDotSegmentsAreDiscarded(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkParse(c, ht, render(hegel.Draw(ht, subpathCases), canonicalSpelling))
+	})
+}
+
+// --------------------------------------------------------------------------- packageurl-go/5
+
+// slashedNameCases: a name with a leading or trailing slash, or a namespace with an inner
+// empty segment; under HEGEL_NO_KNOWN=1 a slash inside the name, or plain segments.
+var (
+	slashedNameCases = weighted(
+		choice[purl]{1, hegel.Map(cat(hegel.Just("/"), plainWord), named)},
+		choice[purl]{1, hegel.Map(cat(plainWord, hegel.Just("/")), named)},
+		choice[purl]{1, hegel.Map(cat(hegel.Just("/"), plainWord, hegel.Just("/")), named)},
+		choice[purl]{1, hegel.Composite(func(tc hegel.TestCase) purl {
+			p := named(hegel.Draw(tc, plainWord))
+			p.ns = []string{hegel.Draw(tc, plainWord), "", hegel.Draw(tc, plainWord)}
+			return p
+		})},
+	)
+	innerSlashCases = weighted(
+		choice[purl]{1, hegel.Map(slashed, named)},
+		choice[purl]{1, hegel.Composite(func(tc hegel.TestCase) purl {
+			p := named(hegel.Draw(tc, plainWord))
+			p.ns = hegel.Draw(tc, many(plainWord, 1, 3))
+			return p
+		})},
+	)
+)
+
+// TestHegelNormalizeAgreesWithItsString: Normalize strips the slashes around the name and
+// the empty namespace segments (the build procedure), so the normalized value is what its own
+// string parses to; upstream keeps them (packageurl-go/5).
+func TestHegelNormalizeAgreesWithItsString(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkBuild(c, ht, hegel.Draw(ht, shaped(slashedNameCases, innerSlashCases)).comps())
+	})
+}
+
+// --------------------------------------------------------------------------- packageurl-go/6
+
+// caseRule is a type and a component its definition marks case insensitive (hasNamespace:
+// the purl gets a namespace), or under HEGEL_NO_KNOWN=1 a case-sensitive type and a component.
+type caseRule struct {
+	typ, component string
+	hasNamespace   bool
+}
+
+var (
+	insensitiveRules = []caseRule{
+		{"hex", "name", true}, {"hex", "namespace", true}, {"luarocks", "name", true}, {"luarocks", "namespace", true},
+		{"vscode-extension", "name", true}, {"vscode-extension", "namespace", true}, {"vscode-extension", "version", true},
+		{"yocto", "namespace", true}, {"oci", "name", false}, {"oci", "version", false}, {"otp", "name", false},
+		{"pub", "name", false}, {"pypi", "version", false},
+	}
+	sensitiveRules = []caseRule{{"generic", "name", false}, {"generic", "namespace", true}, {"maven", "namespace", true}, {"npm", "name", true}, {"cargo", "version", false}, {"swid", "name", false}}
+	caseRuleCases  = hegel.Composite(func(tc hegel.TestCase) purl {
+		r := hegel.Draw(tc, hegel.SampledFrom(shaped(insensitiveRules, sensitiveRules)))
+		p := purl{typ: r.typ, name: hegel.Draw(tc, letters), version: hegel.Draw(tc, letters)}
+		if r.hasNamespace {
+			p.ns = []string{hegel.Draw(tc, letters)}
+		}
+		if r.typ == "swid" {
+			p.quals = []kv{{"tag_id", hegel.Draw(tc, lowerWord)}}
+		}
+		switch r.component {
+		case "name":
+			p.name = strings.ToUpper(p.name)
+		case "namespace":
+			p.ns[0] = strings.ToUpper(p.ns[0])
+		case "version":
+			p.version = strings.ToUpper(p.version)
+		}
+		return p
+	})
+)
+
+// TestHegelCaseInsensitiveComponentsAreLowercased: FromString lowercases the components the
+// type definitions mark case insensitive (hex, luarocks, otp, pub and vscode-extension names,
+// hex, luarocks, yocto and vscode-extension namespaces, oci, pypi and vscode-extension
+// versions); upstream keeps their case (packageurl-go/6).
+func TestHegelCaseInsensitiveComponentsAreLowercased(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkParse(c, ht, render(hegel.Draw(ht, caseRuleCases), canonicalSpelling))
+	})
+}
+
+// --------------------------------------------------------------------------- packageurl-go/7
+
+// chromeNames: 32 letters a-p with one of q-z put at a position; under HEGEL_NO_KNOWN=1 the
+// 32 letters a-p.
+var (
+	base16Letters = hegel.Text().Alphabet("abcdefghijklmnop").MinSize(32).MaxSize(32)
+	chromeNames   = hegel.Composite(func(tc hegel.TestCase) string {
+		name := []byte(hegel.Draw(tc, base16Letters))
+		letter := hegel.Draw(tc, pick("q", "r", "s", "t", "u", "v", "w", "x", "y", "z"))
+		at := hegel.Draw(tc, hegel.Integers(0, 31))
+		if !noKnown {
+			name[at] = letter[0]
+		}
+		return string(name)
+	})
+	chromeCases = hegel.Map(chromeNames, func(name string) purl { return purl{typ: "chrome-extension", name: name} })
+)
+
+// TestHegelChromeExtensionNameIsBase16Letters: Normalize rejects a chrome-extension name
+// with a letter past p (the definition's permitted characters are ^[a-p]{32}$); upstream
+// checks [a-z]{32} (packageurl-go/7).
+func TestHegelChromeExtensionNameIsBase16Letters(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkBuild(c, ht, hegel.Draw(ht, chromeCases).comps())
+	})
+}
+
+// --------------------------------------------------------------------------- packageurl-go/8
+
+// namespaceRuleCases: a type whose definition requires a namespace without one, or whose
+// definition prohibits one with one, among the types upstream does not check; under
+// HEGEL_NO_KNOWN=1 the six types it checks (both reject) or the others with the rule met.
+var (
+	requiredUnenforced   = []string{"alpm", "apk", "bitbucket", "composer", "deb", "github", "golang", "huggingface", "maven", "qpkg", "rpm"}
+	prohibitedUnenforced = []string{"bazel", "bitnami", "cargo", "cocoapods", "conda", "cran", "gem", "hackage", "mlflow", "nuget", "oci", "opam", "pub", "pypi"}
+	// names of letters a-p, so that a chrome-extension case is judged on its namespace alone
+	base16Word       = hegel.Text().Alphabet("abcdefghijklmnop").MinSize(1).MaxSize(6)
+	withoutNamespace = func(types []string) hegel.Generator[purl] {
+		return hegel.Composite(func(tc hegel.TestCase) purl {
+			return purl{typ: hegel.Draw(tc, hegel.SampledFrom(types)), name: hegel.Draw(tc, base16Word)}
+		})
+	}
+	withNamespace = func(types []string) hegel.Generator[purl] {
+		return hegel.Composite(func(tc hegel.TestCase) purl {
+			return purl{typ: hegel.Draw(tc, hegel.SampledFrom(types)), ns: []string{hegel.Draw(tc, base16Word)}, name: hegel.Draw(tc, base16Word)}
+		})
+	}
+	namespaceRuleCases = shaped(
+		weighted(
+			choice[purl]{1, withoutNamespace(requiredUnenforced)},
+			choice[purl]{1, withNamespace(prohibitedUnenforced)},
+		),
+		weighted(
+			choice[purl]{1, withNamespace(requiredUnenforced)},
+			choice[purl]{1, withoutNamespace(prohibitedUnenforced)},
+			choice[purl]{1, withoutNamespace([]string{"swift", "vscode-extension"})},
+			choice[purl]{1, withNamespace([]string{"chrome-extension", "julia", "otp", "vcpkg"})},
+		),
+	)
+)
+
+// TestHegelNamespaceRequirementIsChecked: Normalize rejects a purl whose namespace is
+// missing where the type definition requires one or present where it prohibits one;
+// upstream checks six of the thirty-one types with such a rule (packageurl-go/8).
+func TestHegelNamespaceRequirementIsChecked(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkBuild(c, ht, hegel.Draw(ht, namespaceRuleCases).comps())
+	})
+}
+
+// --------------------------------------------------------------------------- packageurl-go/9
+
+// emptyQualifierCases: a qualifier with an empty value whose key FromString rejects (a digit
+// first, a space, a non-ASCII letter or a percent sign in it), with or without a plain pair
+// beside it; under HEGEL_NO_KNOWN=1 an empty-valued qualifier with a valid key.
+var (
+	rejectedKeys = weighted(
+		choice[string]{1, cat(pick("1", "0", "9"), lowerWord)},
+		choice[string]{1, cat(letters, pick(" ", "é", "%41", "%"), lowerWord)},
+	)
+	validKeys           = cat(letters, hegel.Text().Alphabet("abcdefghijklmnopqrstuvwxyz0123456789._-ABC").MaxSize(5))
+	emptyQualifierCases = hegel.Composite(func(tc hegel.TestCase) purl {
+		p := named(hegel.Draw(tc, plainWord))
+		p.quals = []kv{{hegel.Draw(tc, shaped(rejectedKeys, validKeys)), ""}}
+		if hegel.Draw(tc, chance(50)) {
+			p.quals = append(p.quals, kv{hegel.Draw(tc, letterKeys), hegel.Draw(tc, plainWord)})
+		}
+		return p
+	})
+)
+
+// TestHegelToStringDropsEmptyQualifiers: the string ToString writes before Normalize means
+// the same purl, so a qualifier with an empty value is dropped from it (the build procedure
+// discards the pair); upstream writes the pair with its key percent-encoded and FromString
+// then rejects the key (packageurl-go/9).
+func TestHegelToStringDropsEmptyQualifiers(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkBuild(c, ht, hegel.Draw(ht, emptyQualifierCases).comps())
+	})
+}
+
+// --------------------------------------------------------------------------- packageurl-go/10
+
+// swidCases: a swid purl without a tag_id qualifier (other qualifiers, a namespace and a
+// version optional); under HEGEL_NO_KNOWN=1 with one.
+var (
+	otherQualifiers = maybe(50, hegel.Composite(func(tc hegel.TestCase) []kv {
+		return []kv{{hegel.Draw(tc, pick("arch", "repository_url", "k")), hegel.Draw(tc, plainWord)}}
+	}))
+	tagID     = hegel.Map(lowerWord, func(v string) []kv { return []kv{{"tag_id", v}} })
+	swidCases = hegel.Composite(func(tc hegel.TestCase) purl {
+		return purl{
+			typ:     "swid",
+			ns:      hegel.Draw(tc, maybe(50, many(plainWord, 1, 2))),
+			name:    hegel.Draw(tc, plainWord),
+			version: hegel.Draw(tc, maybe(50, plainWord)),
+			quals:   append(hegel.Draw(tc, shaped(hegel.Just([]kv(nil)), tagID)), hegel.Draw(tc, otherQualifiers)...),
+		}
+	})
+)
+
+// TestHegelSwidRequiresTagID: Normalize rejects a swid purl without a tag_id qualifier (the
+// definition lists it as required, as julia's uuid is); upstream checks julia's uuid only
+// (packageurl-go/10).
+func TestHegelSwidRequiresTagID(t *testing.T) {
+	c := newCollector(t)
+	property(t, func(ht *hegel.T) {
+		checkBuild(c, ht, hegel.Draw(ht, swidCases).comps())
+	})
+}
diff --git a/hegel_test.go b/hegel_test.go
new file mode 100644
index 0000000..eee3dc5
--- /dev/null
+++ b/hegel_test.go
@@ -0,0 +1,279 @@
+package packageurl_test
+
+// Hegel property tests for package-url/packageurl-go, written for the Hegel zoo.
+// See targets/go/packageurl-go/README.md.
+//
+// Oracles: the purl specification's own algorithms, "How to parse a PURL" and "How to build a
+// PURL" (docs/specification/how-to-parse.md, how-to-build.md in package-url/purl-spec), with the
+// character-encoding rule and the per-type case rules of the type definitions
+// (types/<type>-definition.json), restated as a model in hegel_model_test.go; and the laws the
+// package documents: FromString and ToString are inverse on canonical strings, Normalize is
+// idempotent and is what FromString applies, QualifiersFromMap and Map are inverse.
+//
+// Conventions: hegel-go reads no environment variable itself, so HEGEL_TEST_CASES is passed
+// through hegelOpts; a panic in the code under test is turned into a failure of the current
+// test case by property(). ZOO_COLLECT=1 makes the properties record their mismatches instead
+// of failing. The generators (hegel_gen_test.go) are package-level values; each property draws
+// one case record. The shapes of the recorded bugs (bugs.toml) are drawn by default, so the
+// wide properties that meet them fail and are the expected failures mapped to the bugs;
+// hegel_shapes_test.go has one narrow property per bug over its shape region, and the pins
+// (hegel_pins_test.go) are the regression examples. HEGEL_NO_KNOWN=1 (noKnown, below) switches
+// the known shapes off: the generators draw less of those regions and the Known gates skip
+// what is left.
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+
+	"hegel.dev/go/hegel"
+)
+
+// --------------------------------------------------------------------------- harness
+
+func hegelOpts() []hegel.Option {
+	if s := os.Getenv("HEGEL_TEST_CASES"); s != "" {
+		if v, err := strconv.Atoi(s); err == nil && v > 0 {
+			return []hegel.Option{hegel.WithTestCases(v)}
+		}
+	}
+	return nil
+}
+
+func property(t *testing.T, fn func(ht *hegel.T)) {
+	t.Helper()
+	hegel.Test(t, func(ht *hegel.T) {
+		defer func() {
+			r := recover()
+			if r == nil {
+				return
+			}
+			tn := reflect.TypeOf(r).String()
+			if err, ok := r.(error); ok && strings.Contains(err.Error(), "hegel_") {
+				panic(r) // libhegel control flow
+			}
+			if strings.HasPrefix(tn, "*hegel.") || strings.HasPrefix(tn, "hegel.") || strings.HasPrefix(tn, "libhegel.") {
+				panic(r)
+			}
+			ht.Fatalf("panic in the code under test: %v", r)
+		}()
+		fn(ht)
+	}, hegelOpts()...)
+}
+
+var collecting = os.Getenv("ZOO_COLLECT") != ""
+
+type collector struct {
+	name   string
+	mu     sync.Mutex
+	counts map[string]int
+	msgs   []string
+	bad    int
+}
+
+func newCollector(t *testing.T) *collector {
+	c := &collector{name: t.Name(), counts: map[string]int{}}
+	t.Cleanup(func() {
+		if !collecting {
+			return
+		}
+		keys := make([]string, 0, len(c.counts))
+		for k := range c.counts {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var parts []string
+		for _, k := range keys {
+			parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+		}
+		fmt.Printf("COLLECT %s: %d mismatches; %s\n", c.name, c.bad, strings.Join(parts, " "))
+		for _, m := range c.msgs {
+			fmt.Printf("MISMATCH %s\n", m)
+		}
+	})
+	return c
+}
+
+func (c *collector) count(class string) {
+	c.mu.Lock()
+	c.counts[class]++
+	c.mu.Unlock()
+}
+
+// skip counts the reason and rejects the case (Assume, so the engine sees the rate).
+func (c *collector) skip(ht *hegel.T, reason string) {
+	c.count(reason)
+	ht.Assume(false)
+}
+
+func (c *collector) fail(ht *hegel.T, format string, args ...any) {
+	c.failClass(ht, "", format, args...)
+}
+
+// failClass is fail with a class: in collect mode the class is counted and only its first two
+// messages are kept.
+func (c *collector) failClass(ht *hegel.T, class string, format string, args ...any) {
+	msg := fmt.Sprintf(format, args...)
+	if collecting {
+		c.mu.Lock()
+		c.bad++
+		if class != "" {
+			c.counts["mismatch "+class]++
+		}
+		if (class == "" && len(c.msgs) < 25) || (class != "" && c.counts["mismatch "+class] <= 2) {
+			c.msgs = append(c.msgs, c.name+": "+msg)
+		}
+		c.mu.Unlock()
+		return
+	}
+	ht.Fatalf("%s", msg)
+}
+
+// --------------------------------------------------------------------------- generator idioms
+
+// hegel-go has no weighted choice, biased coin, optional with a probability or tuple
+// combinator; these are the zoo's spellings.
+
+// choice is one alternative of a weighted choice.
+type choice[T any] struct {
+	weight int
+	gen    hegel.Generator[T]
+}
+
+// weighted generates from one of the choices, chosen with probability proportional to its
+// weight; it shrinks towards the first choice, so the simplest comes first.
+func weighted[T any](choices ...choice[T]) hegel.Generator[T] {
+	total := 0
+	for _, c := range choices {
+		total += c.weight
+	}
+	return hegel.FlatMap(hegel.Integers(0, total-1), func(i int) hegel.Generator[T] {
+		for _, c := range choices {
+			if i < c.weight {
+				return c.gen
+			}
+			i -= c.weight
+		}
+		panic("unreachable")
+	})
+}
+
+// chance is true pct percent of the time; it shrinks to false (Integers shrinks to 0, so the
+// true range is the top of the die, not the bottom).
+func chance(pct int) hegel.Generator[bool] {
+	return hegel.Map(hegel.Integers(0, 99), func(x int) bool { return x >= 100-pct })
+}
+
+// maybe generates from g pct percent of the time and the zero value (the empty string, the nil
+// list) otherwise, which is what it shrinks to.
+func maybe[T any](pct int, g hegel.Generator[T]) hegel.Generator[T] {
+	var zero T
+	return weighted(choice[T]{100 - pct, hegel.Just(zero)}, choice[T]{pct, g})
+}
+
+// pick is one of a small table of texts (the first is the shrink target).
+func pick(xs ...string) hegel.Generator[string] { return hegel.SampledFrom(xs) }
+
+// many is a list of lo to hi elements.
+func many[T any](g hegel.Generator[T], lo, hi int) hegel.Generator[[]T] {
+	return hegel.Lists(g).MinSize(lo).MaxSize(hi)
+}
+
+// joined is the texts of a list generator joined with sep.
+func joined(g hegel.Generator[[]string], sep string) hegel.Generator[string] {
+	return hegel.Map(g, func(xs []string) string { return strings.Join(xs, sep) })
+}
+
+// cat draws one text from each generator and concatenates them (a tuple of texts; a Composite
+// only because the binding has no tuple combinator).
+func cat(gens ...hegel.Generator[string]) hegel.Generator[string] {
+	return hegel.Composite(func(tc hegel.TestCase) string {
+		var sb strings.Builder
+		for _, g := range gens {
+			sb.WriteString(hegel.Draw(tc, g))
+		}
+		return sb.String()
+	})
+}
+
+// shaped is the value for a recorded bug's shape region or, under HEGEL_NO_KNOWN=1, for the
+// neighbouring region past it.
+func shaped[T any](known, past T) T {
+	if noKnown {
+		return past
+	}
+	return known
+}
+
+// without is the table without the given entries.
+func without(xs []string, drop ...string) []string {
+	var out []string
+	for _, x := range xs {
+		keep := true
+		for _, d := range drop {
+			keep = keep && x != d
+		}
+		if keep {
+			out = append(out, x)
+		}
+	}
+	return out
+}
+
+// --------------------------------------------------------------------------- known bugs
+
+// noKnown: HEGEL_NO_KNOWN=1 looks past the recorded bugs (bugs.toml), read once. By default
+// the generators draw the bugs' shapes and the properties fail on them (the wide properties are
+// the expected failures mapped to the bugs they find, beside the pins and the narrow properties
+// of hegel_shapes_test.go); under HEGEL_NO_KNOWN=1 every Known switch below is on, the
+// generators draw less of the shapes and the switches skip what is left.
+var noKnown = os.Getenv("HEGEL_NO_KNOWN") == "1"
+
+// Known: the recorded bugs (bugs.toml). The properties skip a shape while its switch is on
+// (HEGEL_NO_KNOWN=1); the pins assert the specified behaviour and fail while the bug exists.
+var Known = struct {
+	// a type may start with '.', '-' or '+' and contain '+' (spec 5.6.2: letters, digits,
+	// '.' and '-', starting with a letter)
+	typePunctuation bool
+	// a qualifier key may start with '.', '-' or '_' (spec 5.6.6: starts with a letter)
+	keyPunctuation bool
+	// a percent-encoded slash inside a namespace or subpath segment is accepted and becomes a
+	// segment separator (spec 5.6.3, 5.6.7: a decoded segment shall not contain a slash)
+	encodedSlash bool
+	// subpath segments '.', '..' and empty are kept when leading and rejected otherwise
+	// (spec: discarded on parse and build)
+	subpathDots bool
+	// a name is not stripped of leading and trailing slashes (spec build procedure)
+	nameSlashes bool
+	// Normalize keeps empty inner namespace segments that ToString drops
+	emptyNamespaceSegments bool
+	// the case rules of the type definitions of hex, luarocks, oci, otp, pub, pypi (version),
+	// vscode-extension and chrome-extension are not applied
+	caseRules bool
+	// chrome-extension names accept letters q-z (spec: ^[a-p]{32}$)
+	chromeExtensionLetters bool
+	// the namespace requirement of most type definitions is not checked
+	namespaceRequirement bool
+	// ToString before Normalize writes qualifiers with an empty value (and percent-encodes
+	// their keys), which FromString may reject
+	emptyQualifierWritten bool
+	// the swid type's required tag_id qualifier is not checked (julia's uuid is)
+	swidTagID bool
+}{
+	typePunctuation:        noKnown,
+	keyPunctuation:         noKnown,
+	encodedSlash:           noKnown,
+	subpathDots:            noKnown,
+	nameSlashes:            noKnown,
+	emptyNamespaceSegments: noKnown,
+	caseRules:              noKnown,
+	chromeExtensionLetters: noKnown,
+	namespaceRequirement:   noKnown,
+	emptyQualifierWritten:  noKnown,
+	swidTagID:              noKnown,
+}
