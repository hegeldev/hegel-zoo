+// ---------------------------------------------------------------------------
+// Helpers on the crate's side
+// ---------------------------------------------------------------------------
+
+fn entry_options(e: &Entry) -> Vec<String> {
+    match e.option_list() {
+        None => vec![],
+        Some(ol) => ol
+            .options()
+            .map(|o| match (o.key(), o.value()) {
+                (Some(k), Some(v)) => format!("{k}={v}"),
+                (Some(k), None) => k,
+                (None, v) => format!("?={v:?}"),
+            })
+            .collect(),
+    }
+}
+
+/// The entry as python-debian would report it.
+fn entry_as_py(e: &Entry) -> PyEntry {
+    let url = e.url();
+    let (url, pattern, version, script) = match py_split_url(&url) {
+        Some((base, pat)) => (base, Some(pat), e.version_policy_text(), e.script()),
+        None => (url, e.matching_pattern(), e.version_policy_text(), e.script()),
+    };
+    PyEntry { url, matching_pattern: pattern, version, script, options: entry_options(e) }
+}
+
+trait PolicyText {
+    fn version_policy_text(&self) -> Option<String>;
+}
+
+impl PolicyText for Entry {
+    fn version_policy_text(&self) -> Option<String> {
+        self.version_node().map(|n| n.policy())
+    }
+}
+
+fn wentry_as_py(e: &WEntry) -> PyEntry {
+    match py_split_url(&e.url) {
+        Some((base, pat)) => PyEntry {
+            url: base,
+            matching_pattern: Some(pat),
+            version: e.policy.clone(),
+            script: e.script.clone(),
+            options: e.option_texts(),
+        },
+        None => PyEntry {
+            url: e.url.clone(),
+            matching_pattern: e.pattern.clone(),
+            version: e.policy.clone(),
+            script: e.script.clone(),
+            options: e.option_texts(),
+        },
+    }
+}
