+#[hegel::composite]
+fn arb_edit(tc: &hegel::TestCase) -> Edit {
+    match tc.draw(int!(0, 6)) {
+        0 => Edit::Url(pick(tc, &["https://new.example.org/", "ftp://a/b/", "https://github.com/@PACKAGE@/releases"]).to_string()),
+        1 => Edit::Pattern(pick(tc, PATTERNS).to_string()),
+        2 => Edit::Policy(pick(tc, POLICIES).to_string()),
+        3 => Edit::Script(pick(tc, SCRIPTS).to_string()),
+        4 => {
+            let (k, vals) = pick(tc, VALUE_KEYS);
+            Edit::SetOpt(k.to_string(), pick(tc, vals).to_string())
+        }
+        5 => Edit::DelOpt(pick(tc, &["compression", "mode", "bare", "repack", "component", "nosuch"]).to_string()),
+        _ => Edit::Version(pick(tc, &[3, 4, 5])),
+    }
+}
