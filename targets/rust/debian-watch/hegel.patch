+/// debian-watch/9: the default `pretty` pattern is `0.0~git%cd.h%`, a typo
+/// of uscan's `0.0~git%cd.%h`.
+#[hegel::test]
+fn the_default_pretty_pattern_is_uscans(tc: hegel::TestCase) {
+    let text = pick(&tc, &["version=4\nopts=mode=git https://h.example.org/foo.git refs/tags/v([\\d.]+)\n", "version=4\nhttps://h.example.org/releases/ .*/v?(\\d\\S+)\\.tar\\.gz\n"]);
