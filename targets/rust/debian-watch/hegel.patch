+/// A filename and the template it should (or should not) match.
+#[derive(Clone, Debug)]
+struct Sample {
+    template: String,
+    input: String,
+    /// The input has a `v`/`V` before the version (uscan's `[Vv]?`).
+    v_prefix: bool,
+    /// The input uses a zstd extension (uscan's `tar\.zstd?`).
+    zst: bool,
+}
+
+#[hegel::composite]
+fn arb_sample(tc: &hegel::TestCase) -> Sample {
+    let package = "foo";
+    let sep = pick(tc, &["-", "_", ""]);
+    let v = pick(tc, &["", "", "v", "V"]);
+    let version = pick(tc, &["1.2.3", "1.0", "2.0~rc1", "1.2.3+dfsg1", "0.9.4-beta", "10", "1.2.3:4"]);
+    let ext = pick(tc, &[".tar.gz", ".tar.xz", ".tar.bz2", ".zip", ".tgz", ".TAR.GZ", ".tar.zst", ".tar.zstd", ".tar", ".tar.gz.asc", ".zip.sig"]);
+    let template = pick(tc, &["@PACKAGE@-@ANY_VERSION@@ARCHIVE_EXT@", "@PACKAGE@@ANY_VERSION@@ARCHIVE_EXT@", "@PACKAGE@-@ANY_VERSION@@SIGNATURE_EXT@", ".*/@PACKAGE@-@ANY_VERSION@\\.tar\\.gz", "@ANY_VERSION@@DEB_EXT@"]);
+    let dir = pick(tc, &["", "dl/", "a/b/"]);
+    let input = format!("{dir}{package}{sep}{v}{version}{ext}");
+    Sample { template: template.to_string(), input, v_prefix: !v.is_empty(), zst: ext.contains("zst") }
+}
+
+fn our_match(template: &str, input: &str, package: &str) -> (bool, Option<String>) {
+    let re = format!("^{}$", subst(template, || package.to_string(), || String::new()));
+    let re = regex::Regex::new(&re).unwrap_or_else(|e| panic!("{re:?}: {e}"));
+    match re.captures(input) {
+        Some(c) => (true, c.get(1).map(|m| m.as_str().to_string())),
+        None => (false, None),
+    }
+}
+
+#[hegel::test]
+fn expanded_patterns_match_like_uscan(tc: hegel::TestCase) {
+    let s = tc.draw(arb_sample().print_as_debug());
+    if s.v_prefix || s.zst {
+        return;
+    }
+    let (m, cap, re) = uscan_match(&s.template, &s.input, "foo");
+    let (om, ocap) = our_match(&s.template, &s.input, "foo");
+    assert_eq!((om, ocap), (m, cap), "template {:?} on {:?} (uscan regex {re:?})", s.template, s.input);
+}
