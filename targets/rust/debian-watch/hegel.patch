+/// debian-watch/12: an option value containing `=` (common in mangle
+/// rules) is truncated at that `=` by `get_option`/`opts`.
+#[hegel::test]
+fn option_values_containing_an_equals_sign_are_whole(tc: hegel::TestCase) {
+    let (key, value) = pick(&tc, &[("filenamemangle", "s/.*ref=(.*)/$1/"), ("downloadurlmangle", "s/tag=v/tag=/"), ("uversionmangle", "s/=//")]);
+    let quoted = tc.draw(generators::booleans());
+    let opts = if quoted { format!("opts=\"{key}={value}\"") } else { format!("opts={key}={value}") };
+    let text = format!("version=4\n{opts} https://h.example.org/releases/ .*/v?(\\d\\S+)\\.tar\\.gz\n");
+    let py = py_watch(&text).unwrap().unwrap();
+    assert_eq!(py.entries[0].options, vec![format!("{key}={value}")]);
+    let wf = WatchFile::from_str(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    let e = wf.entries().next().unwrap();
+    assert_eq!(e.get_option(key).as_deref(), Some(value), "{text:?}");
+    assert_eq!(e.opts().get(key).map(|s| s.as_str()), Some(value), "{text:?}");
+    assert_eq!(entry_options(&e), py.entries[0].options, "{text:?}");
+}
