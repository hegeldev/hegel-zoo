+/// debian-watch/6: `@ANY_VERSION@` lacks uscan's `[Vv]?` and `@ARCHIVE_EXT@`
+/// lacks `tar\.zstd?`, so patterns using them miss files uscan matches.
+#[hegel::test]
+fn substitutions_match_what_uscan_matches(tc: hegel::TestCase) {
+    let mut s = tc.draw(arb_sample().print_as_debug());
+    if !s.v_prefix && !s.zst {
+        s.input = "foo-v1.2.3.tar.gz".to_string();
+        s.template = "@PACKAGE@-@ANY_VERSION@@ARCHIVE_EXT@".to_string();
+    }
+    let (m, cap, re) = uscan_match(&s.template, &s.input, "foo");
+    let (om, ocap) = our_match(&s.template, &s.input, "foo");
+    assert_eq!((om, ocap), (m, cap), "template {:?} on {:?} (uscan regex {re:?})", s.template, s.input);
+}
