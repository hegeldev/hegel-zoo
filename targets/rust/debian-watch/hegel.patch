+/// debian-watch/7: a flag option (`bare`, `repack`, …) that ends the option
+/// list is a parse error ("expected `=`"), quoted or not.
+#[hegel::test]
+fn a_flag_option_can_end_the_option_list(tc: hegel::TestCase) {
+    let opts = pick(&tc, &["opts=bare", "opts=\"bare\"", "opts=repack,bare", "opts=\"compression=xz,repack\"", "opts=bare \\\n  "]);
+    let rest = pick(&tc, &["https://h.example.org/releases/ .*/v?(\\d\\S+)\\.tar\\.gz", "https://h.example.org/releases/"]);
+    let sep = if opts.ends_with(' ') { "" } else { " " };
+    let text = format!("version=4\n{opts}{sep}{rest}\n");
+    let py = py_watch(&text).unwrap().unwrap();
+    assert_eq!(py.entries.len(), 1);
+    let wf = WatchFile::from_str(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    let e = wf.entries().next().unwrap();
+    assert_eq!(entry_options(&e), py.entries[0].options, "{text:?}");
+    assert_eq!(e.url(), py.entries[0].url);
+}
