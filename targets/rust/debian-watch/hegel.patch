+// ---------------------------------------------------------------------------
+// Mangling rules against uscan
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn substitution_rules_mangle_like_uscan(tc: hegel::TestCase) {
+    let rule = tc.draw(arb_subst_rule(true).print_as_debug());
+    let input = tc.draw(arb_input());
+    let text = rule.text();
+    // Perl and the regex crate differ on an empty match right after a
+    // non-empty one (`s/a*/A/g`): a regex-dialect nuance, not a watch bug.
+    if rule.flags.contains('g') && rule.pattern.nullable {
+        return;
+    }
+    // uscan implements `g` as a loop of single substitutions on the
+    // modified string, so `s/^x//g` strips repeatedly: a uscan quirk.
+    if rule.flags.contains('g') && rule.pattern.text.starts_with('^') {
+        return;
+    }
+    let theirs = uscan_mangle(&text, &input);
+    let ours = apply_mangle(&text, &input);
+    match theirs {
+        Ok(t) => {
+            let o = ours.unwrap_or_else(|e| panic!("uscan mangles {text:?} on {input:?} to {t:?}, we fail: {e}"));
+            assert_eq!(o, t, "rule {text:?} on {input:?}");
+        }
+        Err(e) => assert!(ours.is_err(), "uscan refuses {text:?} ({e}), we produce {ours:?} on {input:?}"),
+    }
+    // The parsed expression reads back what we generated.
+    let expr = parse_mangle_expr(&text).unwrap();
+    assert_eq!(expr.pattern, rule.pattern.text);
+    assert_eq!(expr.replacement, rule.replacement);
+    assert_eq!(expr.flags.unwrap_or_default(), rule.flags);
+}
