+/// debian-watch/7 (second face): an entry built with only a flag option
+/// renders to text the parser rejects.
+#[hegel::test]
+fn a_built_entry_with_a_flag_option_is_read_back(tc: hegel::TestCase) {
+    let flag = pick(&tc, FLAG_KEYS);
