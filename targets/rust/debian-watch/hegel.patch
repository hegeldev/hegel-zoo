+/// debian-watch/10: when the URL's last component carries the pattern
+/// (uscan: "no separate filepattern field"), the following fields are the
+/// version policy and script; the crate reports the policy as the matching
+/// pattern and the script as the policy.
+#[hegel::test]
+fn fields_after_an_inline_pattern_url_are_the_policy_and_script(tc: hegel::TestCase) {
+    let url = pick(&tc, &["https://pypi.debian.net/foo/foo-(.+)\\.tar\\.gz", "https://example.org/dir/foo-(\\d[\\d.]*)\\.tar\\.gz"]);
+    let policy = pick(&tc, POLICIES);
+    let script = pick(&tc, &[None, Some("uupdate")]);
+    let mut line = format!("{url} {policy}");
+    if let Some(s) = script {
+        line.push(' ');
+        line.push_str(s);
+    }
+    let text = format!("version=4\n{line}\n");
+    let py = py_watch(&text).unwrap().unwrap();
+    assert_eq!(py.entries[0].version.as_deref(), Some(policy));
+    assert_eq!(py.entries[0].script.as_deref(), script);
+    let wf = WatchFile::from_str(&text).unwrap();
+    let e = wf.entries().next().unwrap();
+    assert_eq!(e.version().unwrap().map(|p| p.to_string()).as_deref(), Some(policy), "{text:?}");
+    assert_eq!(e.script().as_deref(), script, "{text:?}");
+}
