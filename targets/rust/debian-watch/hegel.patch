+#[hegel::test]
+fn option_types_round_trip_through_display(tc: hegel::TestCase) {
+    macro_rules! rt {
+        ($t:ty, $vals:expr) => {{
+            let v = pick(&tc, $vals);
+            let parsed: $t = v.parse().unwrap_or_else(|e| panic!("{v:?}: {e}"));
+            let shown = parsed.to_string();
+            let again: $t = shown.parse().unwrap_or_else(|e| panic!("{shown:?} from {v:?}: {e}"));
+            assert_eq!(again, parsed, "{v:?} -> {shown:?}");
+        }};
+    }
+    rt!(Compression, &["xz", "gz", "gzip", "bzip2", "bz2", "lzma", "default"]);
+    rt!(Mode, &["git", "lwp", "svn"]);
+    rt!(PgpMode, &["auto", "default", "mangle", "next", "previous", "self", "gittag"]);
+    rt!(GitMode, &["shallow", "full"]);
+    rt!(GitExport, &["all", "default"]);
+    rt!(SearchMode, &["plain", "html"]);
+    rt!(ComponentType, &["perl", "nodejs"]);
+    rt!(VersionPolicy, &["debian", "same", "previous", "ignore", "group", "checksum", "version-1.2", "version-0.9~rc1"]);
+    for bad in ["", "GIT", "xz ", "version-", "version"] {
+        assert!(Mode::from_str(bad).is_err() || bad == "");
+        assert!(VersionPolicy::from_str(bad).is_err(), "{bad:?}");
+    }
+}
