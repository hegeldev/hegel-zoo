+/// debian-watch/4: the replacement is not processed like Perl's: `\.` is
+/// `.`, `\1` is a group reference, `$&` is the whole match and an escaped
+/// delimiter loses its backslash.
+#[hegel::test]
+fn replacement_escapes_work_like_perl(tc: hegel::TestCase) {
+    let (text, input) = pick(
+        &tc,
+        &[
+            ("s/(\\d+)-(\\d+)/$1\\.$2/", "1-2"),
+            ("s/(\\d+)/\\1x/", "12"),
+            ("s/\\d+/<$&>/", "a12b"),
+            ("s/a\\/b/x\\/y/", "a/b"),
+            ("s|(\\d)|\\$1|", "7"),
+            ("s/(\\d)/$1\\.tar\\.gz/", "3"),
+        ],
+    );
+    let theirs = uscan_mangle(text, input).unwrap();
+    assert_eq!(apply_mangle(text, input).map_err(|e| e.to_string()), Ok(theirs), "rule {text:?} on {input:?}");
+}
