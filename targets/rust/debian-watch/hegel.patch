+/// debian-watch/13: `set_opt` on a quoted option list appends the new
+/// option after the closing quote (`opts="a=1",b=2`), which does not parse.
+#[hegel::test]
+fn set_opt_on_a_quoted_option_list_stays_inside_the_quotes(tc: hegel::TestCase) {
+    let existing = pick(&tc, &["compression=xz", "repack,compression=xz", "mode=git, pgpmode=none"]);
+    let (k, vals) = pick(&tc, VALUE_KEYS);
+    let v = pick(&tc, vals);
+    let text = format!("version=4\nopts=\"{existing}\" https://h.example.org/releases/ .*/v?(\\d\\S+)\\.tar\\.gz\n");
+    let wf = WatchFile::from_str(&text).unwrap();
+    let mut e = wf.entries().next().unwrap();
+    e.set_opt(k, v);
+    let shown = wf.to_string();
+    let again = WatchFile::from_str(&shown).unwrap_or_else(|er| panic!("{shown:?} does not parse: {er}"));
+    let a = again.entries().next().unwrap();
+    assert_eq!(a.get_option(k).as_deref(), Some(v), "{shown:?}");
+    let py = py_watch(&shown).unwrap().unwrap();
+    assert!(py.entries[0].options.contains(&format!("{k}={v}")), "{shown:?}: {:?}", py.entries[0].options);
+}
