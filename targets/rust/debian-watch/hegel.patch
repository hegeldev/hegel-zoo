+#[hegel::test]
+fn built_entries_are_read_back(tc: hegel::TestCase) {
+    let n = tc.draw(int!(0, 3)) as usize;
+    let mut wf = WatchFile::new(Some(4));
+    let mut model: Vec<WEntry> = Vec::new();
+    for _ in 0..n {
+        let mut ge = tc.draw(arb_wentry().print_as_debug());
+        // The builder's options come from a HashMap; with a flag option the
+        // text would depend on the iteration order (debian-watch/7).
+        ge.options = valued_only(&ge.options);
+        let mut b = EntryBuilder::new(ge.url.clone());
+        if let Some(p) = &ge.pattern {
+            b = b.matching_pattern(p.clone());
+        }
+        if let Some(p) = &ge.policy {
+            b = b.version_policy(p.clone());
+        }
+        if let Some(s) = &ge.script {
+            b = b.script(s.clone());
+        }
+        for o in &ge.options {
+            b = match &o.value {
+                Some(v) => b.opt(o.key.clone(), v.clone()),
+                None => b.flag(o.key.clone()),
+            };
+        }
+        let added = wf.add_entry(b.build());
+        assert_eq!(added.url(), ge.url);
+        model.push(ge);
+    }
+    assert_eq!(wf.version(), 4);
+    assert_eq!(wf.entries().count(), n);
+    let text = wf.to_string();
+    assert!(text.starts_with("version=4\n"), "{text:?}");
+    let again = WatchFile::from_str(&text).unwrap_or_else(|e| panic!("built text {text:?} does not parse: {e}"));
+    let py = py_watch(&text).unwrap_or_else(|e| panic!("python-debian failed on built {text:?}: {e}")).unwrap();
+    assert_eq!(again.entries().count(), n);
+    for ((e, a), ge) in wf.entries().zip(again.entries()).zip(&model) {
+        for x in [&e, &a] {
+            assert_eq!(x.url(), ge.url, "in {text:?}");
+            assert_eq!(x.matching_pattern(), ge.pattern, "in {text:?}");
+            assert_eq!(x.version_policy_text(), ge.policy, "in {text:?}");
+            assert_eq!(x.script(), ge.script, "in {text:?}");
+            // Options come from a HashMap: compare as sets.
+            let got: BTreeSet<String> = entry_options(x).into_iter().collect();
+            let want: BTreeSet<String> = ge.option_texts().into_iter().collect();
+            assert_eq!(got, want, "in {text:?}");
+        }
+    }
+    let py_model: Vec<PyEntry> = model.iter().map(wentry_as_py).collect();
+    let py_sorted: Vec<PyEntry> = py.entries.into_iter().map(|mut e| { e.options.sort(); e }).collect();
+    let model_sorted: Vec<PyEntry> = py_model.into_iter().map(|mut e| { e.options.sort(); e }).collect();
+    assert_eq!(py_sorted, model_sorted, "python-debian on built {text:?}");
+}
