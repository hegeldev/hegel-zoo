+#[hegel::test]
+fn edits_are_read_back(tc: hegel::TestCase) {
+    let mut ge = tc.draw(arb_wentry().print_as_debug());
+    if ge.url_has_pattern() {
+        return;
+    }
+    // Deleting options could leave a flag last (debian-watch/7).
+    ge.options = valued_only(&ge.options);
+    let mut version = 4;
+    let text = format!("version=4\n{}\n", ge.text());
+    let mut wf = WatchFile::from_str(&text).unwrap();
+    let n = tc.draw(int!(1, 4));
+    for _ in 0..n {
+        let edit = tc.draw(arb_edit().print_as_debug());
+        let mut e = wf.entries().next().unwrap();
+        match &edit {
+            Edit::Url(u) => {
+                e.set_url(u);
+                ge.url = u.clone();
+            }
+            Edit::Pattern(p) => {
+                // Documented: the setters only replace an existing field.
+                if ge.pattern.is_none() {
+                    continue;
+                }
+                e.set_matching_pattern(p);
+                ge.pattern = Some(p.clone());
+            }
+            Edit::Policy(p) => {
+                if ge.policy.is_none() {
+                    continue;
+                }
+                e.set_version_policy(p);
+                ge.policy = Some(p.clone());
+            }
+            Edit::Script(s) => {
+                if ge.script.is_none() {
+                    continue;
+                }
+                e.set_script(s);
+                ge.script = Some(s.clone());
+            }
+            Edit::SetOpt(k, v) => {
+                // debian-watch/13: set_opt appends after the closing quote
+                // of a quoted list, so only unquoted lists here (pinned).
+                if ge.quoted && !ge.options.is_empty() {
+                    continue;
+                }
+                e.set_opt(k, v);
+                match ge.options.iter_mut().find(|o| &o.key == k) {
+                    Some(o) => o.value = Some(v.clone()),
+                    None => ge.options.push(WOption { key: k.clone(), value: Some(v.clone()) }),
+                }
+            }
+            Edit::DelOpt(k) => {
+                e.del_opt_str(k);
+                ge.options.retain(|o| &o.key != k);
+            }
+            Edit::Version(v) => {
+                wf.set_version(*v);
+                version = *v;
+            }
+        }
+        let shown = wf.to_string();
+        let again = WatchFile::from_str(&shown).unwrap_or_else(|er| panic!("after {edit:?}: {shown:?} does not parse: {er}"));
+        assert_eq!(again.version(), version, "after {edit:?}: {shown:?}");
+        assert_eq!(wf.version(), version);
+        assert_eq!(again.entries().count(), 1, "after {edit:?}: {shown:?}");
+        let live = wf.entries().next().unwrap();
+        for (what, x) in [("live", &live), ("re-parsed", &again.entries().next().unwrap())] {
+            assert_eq!(x.url(), ge.url, "{what} url after {edit:?}: {shown:?}");
+            assert_eq!(x.matching_pattern(), ge.pattern, "{what} pattern after {edit:?}: {shown:?}");
+            assert_eq!(x.version_policy_text(), ge.policy, "{what} policy after {edit:?}: {shown:?}");
+            assert_eq!(x.script(), ge.script, "{what} script after {edit:?}: {shown:?}");
+            let got: BTreeSet<String> = entry_options(x).into_iter().collect();
+            let want: BTreeSet<String> = ge.option_texts().into_iter().collect();
+            assert_eq!(got, want, "{what} options after {edit:?}: {shown:?}");
+        }
+        let py = py_watch(&shown).unwrap_or_else(|er| panic!("python-debian fails after {edit:?} on {shown:?}: {er}")).unwrap();
+        assert_eq!(py.version, version);
+        let mut pe = py.entries;
+        assert_eq!(pe.len(), 1, "python-debian after {edit:?}: {shown:?}");
+        pe[0].options.sort();
+        let mut want = wentry_as_py(&ge);
+        want.options.sort();
+        assert_eq!(pe[0], want, "python-debian after {edit:?}: {shown:?}");
+    }
+}
