+/// debian-watch/5: `tr` with a replacement shorter than the pattern (Perl
+/// repeats the last character; an empty replacement is the identity) is an
+/// error, and the `d`/`c`/`s` flags are ignored.
+#[hegel::test]
+fn translation_pads_and_flags_like_perl(tc: hegel::TestCase) {
+    let (text, input) = pick(
+        &tc,
+        &[
+            ("tr/a-c/x/", "abcd"),
+            ("tr/abc//", "abc"),
+            ("tr/a-c//d", "abcd"),
+            ("y/a-z/A-Z/", "hello"),
+            ("tr/a-c/x/d", "abcd"),
+            ("tr/a//s", "aaab"),
+            ("tr/a-c/x/c", "abcd"),
+        ],
+    );
+    let theirs = uscan_mangle(text, input).unwrap();
+    assert_eq!(apply_mangle(text, input).map_err(|e| e.to_string()), Ok(theirs), "rule {text:?} on {input:?}");
+}
