+        assert_eq!(e.searchmode().unwrap(), get("searchmode").map(|v| SearchMode::from_str(&v).unwrap()).unwrap_or_default());
+        assert_eq!(e.ctype().unwrap(), get("ctype").map(|v| ComponentType::from_str(&v).unwrap()));
+        if let Some(p) = get("pretty") {
