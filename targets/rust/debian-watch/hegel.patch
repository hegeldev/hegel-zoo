+//! Hegel property tests for debian-watch, checked against uscan itself
+//! (devscripts' `Devscripts::Uscan::Utils::safe_replace` for the mangling
+//! rules and the substitution constants of `Devscripts::Uscan::WatchFile`,
+//! driven as a persistent Perl child) and python-debian's `debian.watch`
+//! (`WatchFile.from_lines`, `expand`; a persistent Python child), plus the
+//! generators' own model of the line-based watch file grammar.
+#![allow(clippy::all, dead_code)]
+
+use debian_watch::linebased::{parse_watch_file, Entry, EntryBuilder, WatchFile};
+use debian_watch::mangle::{apply_mangle, parse_mangle_expr};
+use debian_watch::subst::subst;
+use debian_watch::{
+    ComponentType, Compression, GitExport, GitMode, Mode, PgpMode, SearchMode, VersionPolicy,
+};
+use hegel::generators::{self, Generator};
+use std::collections::BTreeSet;
+use std::fmt::Debug;
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::str::FromStr;
+use std::sync::{Mutex, OnceLock};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+// ---------------------------------------------------------------------------
+// Oracles
+// ---------------------------------------------------------------------------
+
+const PYTHON_SCRIPT: &str = r#"
+import sys, json, binascii
+from debian.watch import WatchFile, expand
+def h(x): return binascii.unhexlify(x).decode('utf-8')
+for line in sys.stdin:
+    parts = line.rstrip('\n').split(' ')
+    cmd = parts[0]
+    try:
+        if cmd == 'P':
+            text = h(parts[1])
+            wf = WatchFile.from_lines(text.splitlines(True), strict=True)
+            if wf is None:
+                out = {'empty': True}
+            else:
+                out = {'version': wf.version, 'options': wf.options,
+                       'entries': [{'url': e.url, 'matching_pattern': e.matching_pattern,
+                                    'version': e.version, 'script': e.script,
+                                    'options': list(e.options)} for e in wf.entries]}
+        elif cmd == 'E':
+            out = {'text': expand(h(parts[1]), h(parts[2]))}
+        else:
+            out = {'error': 'unknown command'}
+    except Exception as e:
+        out = {'error': repr(e)}
+    sys.stdout.write(json.dumps(out) + '\n')
+    sys.stdout.flush()
+"#;
+
+const PERL_SCRIPT: &str = r#"
+use strict; use warnings;
+use JSON::PP;
+use Devscripts::Uscan::Utils;
+use Devscripts::Uscan::Output;
+use Devscripts::Uscan::WatchFile;
+$Devscripts::Output::verbose = 0;
+$| = 1;
+my $json = JSON::PP->new->canonical->utf8;
+sub h { my $s = pack('H*', shift); utf8::decode($s); return $s; }
+while (my $line = <STDIN>) {
+    chomp $line;
+    my @p = split / /, $line;
+    my $cmd = shift @p;
+    my $out;
+    if ($cmd eq 'M') {
+        my ($rule, $in) = (h($p[0]), h($p[1]));
+        my $ok = eval { safe_replace(\$in, $rule) };
+        if ($@) { $out = { ok => 0, error => "$@" } }
+        else { $out = { ok => $ok ? 1 : 0, out => $in } }
+    } elsif ($cmd eq 'X') {
+        my ($tmpl, $in, $pkg) = (h($p[0]), h($p[1]), h($p[2]));
+        my $re = $tmpl;
+        $re =~ s/\@PACKAGE\@/$pkg/g;
+        $re =~ s/\@ANY_VERSION\@/Devscripts::Uscan::WatchFile::ANY_VERSION/ge;
+        $re =~ s/\@ARCHIVE_EXT\@/Devscripts::Uscan::WatchFile::ARCHIVE_EXT/ge;
+        $re =~ s/\@SIGNATURE_EXT\@/Devscripts::Uscan::WatchFile::SIGNATURE_EXT/ge;
+        $re =~ s/\@DEB_EXT\@/Devscripts::Uscan::WatchFile::DEB_EXT/ge;
+        my ($m, $cap) = eval { if ($in =~ /^$re$/) { (1, $1) } else { (0, undef) } };
+        if ($@) { $out = { error => "$@" } }
+        else { $out = { match => $m, cap => $cap, re => $re } }
+    } else {
+        $out = { error => 'unknown command' };
+    }
+    print $json->encode($out), "\n";
+}
+"#;
+
+struct Child2 {
+    _child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+fn spawn(program: &str, args: &[&str]) -> Child2 {
+    let mut child = Command::new(program)
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap_or_else(|e| panic!("cannot start {program}: {e}"));
+    let stdin = child.stdin.take().unwrap();
+    let stdout = BufReader::new(child.stdout.take().unwrap());
+    Child2 { _child: child, stdin, stdout }
+}
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|b| format!("{b:02x}")).collect()
+}
+
+fn ask(c: &mut Child2, cmd: &str, args: &[&str]) -> serde_json::Value {
+    let mut line = cmd.to_string();
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a));
+    }
+    writeln!(c.stdin, "{line}").unwrap();
+    c.stdin.flush().unwrap();
+    let mut reply = String::new();
+    c.stdout.read_line(&mut reply).unwrap();
+    assert!(!reply.is_empty(), "{cmd}: oracle child died");
+    serde_json::from_str(&reply).unwrap_or_else(|e| panic!("bad oracle reply {reply:?}: {e}"))
+}
+
+fn python() -> &'static Mutex<Child2> {
+    static P: OnceLock<Mutex<Child2>> = OnceLock::new();
+    P.get_or_init(|| Mutex::new(spawn("/usr/bin/python3", &["-c", PYTHON_SCRIPT])))
+}
+
+fn perl() -> &'static Mutex<Child2> {
+    static P: OnceLock<Mutex<Child2>> = OnceLock::new();
+    P.get_or_init(|| Mutex::new(spawn("perl", &["-e", PERL_SCRIPT])))
+}
+
+/// uscan's `safe_replace`: Ok(mangled) or Err(()) when uscan refuses the rule.
+fn uscan_mangle(rule: &str, input: &str) -> Result<String, String> {
+    let mut c = perl().lock().unwrap_or_else(|e| e.into_inner());
+    let v = ask(&mut c, "M", &[rule, input]);
+    if v["ok"].as_i64() == Some(1) {
+        Ok(v["out"].as_str().unwrap().to_string())
+    } else {
+        Err(v["error"].as_str().unwrap_or("refused").to_string())
+    }
+}
+
+/// uscan's expansion of a template and an anchored match against `input`:
+/// (matched, first capture, expanded regex).
+fn uscan_match(template: &str, input: &str, package: &str) -> (bool, Option<String>, String) {
+    let mut c = perl().lock().unwrap_or_else(|e| e.into_inner());
+    let v = ask(&mut c, "X", &[template, input, package]);
+    if let Some(e) = v.get("error") {
+        panic!("uscan regex error for {template:?}: {e}");
+    }
+    (
+        v["match"].as_i64() == Some(1),
+        v["cap"].as_str().map(|s| s.to_string()),
+        v["re"].as_str().unwrap().to_string(),
+    )
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct PyEntry {
+    url: String,
+    matching_pattern: Option<String>,
+    version: Option<String>,
+    script: Option<String>,
+    options: Vec<String>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct PyWatch {
+    version: u32,
+    options: Vec<String>,
+    entries: Vec<PyEntry>,
+}
+
+fn py_watch(text: &str) -> Result<Option<PyWatch>, String> {
+    let mut c = python().lock().unwrap_or_else(|e| e.into_inner());
+    let v = ask(&mut c, "P", &[text]);
+    if let Some(e) = v.get("error") {
+        return Err(e.to_string());
+    }
+    if v.get("empty").is_some() {
+        return Ok(None);
+    }
+    let strs = |a: &serde_json::Value| -> Vec<String> {
+        a.as_array().unwrap().iter().map(|s| s.as_str().unwrap().trim().to_string()).collect()
+    };
+    // python-debian leaves a leading space on the field after a quoted
+    // `opts="…" \` continuation; fields never start with whitespace.
+    let opt = |x: &serde_json::Value| x.as_str().map(|s| s.trim().to_string());
+    Ok(Some(PyWatch {
+        version: v["version"].as_u64().unwrap() as u32,
+        options: strs(&v["options"]),
+        entries: v["entries"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|e| PyEntry {
+                url: e["url"].as_str().unwrap().trim().to_string(),
+                matching_pattern: opt(&e["matching_pattern"]),
+                version: opt(&e["version"]),
+                script: opt(&e["script"]),
+                options: strs(&e["options"]),
+            })
+            .collect(),
+    }))
+}
+
+fn py_expand(text: &str, package: &str) -> String {
+    let mut c = python().lock().unwrap_or_else(|e| e.into_inner());
+    let v = ask(&mut c, "E", &[text, package]);
+    v["text"].as_str().unwrap_or_else(|| panic!("python expand failed: {v}")).to_string()
+}
+
+// ---------------------------------------------------------------------------
+// Generators
+// ---------------------------------------------------------------------------
+
+fn pick<T: Clone + Send + Sync + Debug + 'static>(tc: &hegel::TestCase, items: &[T]) -> T {
+    tc.draw(generators::sampled_from(items.to_vec()).print_as_debug())
+}
+
+fn subset<T: Clone + Send + Sync + Debug + 'static>(tc: &hegel::TestCase, items: &[T], max: usize) -> Vec<T> {
+    let n = tc.draw(int!(0, max.min(items.len()) as i64)) as usize;
+    let mut out: Vec<T> = Vec::new();
+    let mut idx: Vec<usize> = (0..items.len()).collect();
+    for _ in 0..n {
+        let i = tc.draw(int!(0, idx.len() as i64 - 1)) as usize;
+        out.push(items[idx.remove(i)].clone());
+    }
+    out
+}
+
+/// A regex in the dialect Perl and the regex crate share, with `groups`
+/// capturing groups.
+#[derive(Clone, Debug)]
+struct GenRegex {
+    text: String,
+    groups: usize,
+    /// Every atom is optional, so the regex matches the empty string.
+    nullable: bool,
+}
+
+const LITERALS: &[&str] = &["a", "b", "c", "x", "1", "2", "0", "-", "_", "~", "\\.", "\\+", "\\d", "\\w", "[0-9]", "[a-z]", "[.-]", "."];
+
+#[hegel::composite]
+fn arb_regex(tc: &hegel::TestCase, max_groups: usize) -> GenRegex {
+    let n = tc.draw(int!(1, 4)) as usize;
+    let mut text = String::new();
+    let mut groups = 0;
+    let mut nullable = true;
+    if tc.draw(int!(0, 4)) == 0 {
+        text.push('^');
+    }
+    for _ in 0..n {
+        let mut atom = pick(tc, LITERALS).to_string();
+        if let Some(q) = pick(tc, &[None, None, None, Some("+"), Some("*"), Some("?")]) {
+            atom.push_str(q);
+            if q == "+" {
+                nullable = false;
+            }
+        } else {
+            nullable = false;
+        }
+        if groups < max_groups && tc.draw(int!(0, 2)) == 0 {
+            atom = format!("({atom})");
+            groups += 1;
+        }
+        text.push_str(&atom);
+    }
+    if tc.draw(int!(0, 4)) == 0 {
+        text.push('$');
+    }
+    GenRegex { text, groups, nullable }
+}
+
+/// A replacement in the subset Perl and the regex crate agree on: literal
+/// characters and `${N}` group references (a bare `$N` only at the end).
+#[hegel::composite]
+fn arb_replacement(tc: &hegel::TestCase, groups: usize) -> String {
+    let n = tc.draw(int!(0, 3)) as usize;
+    let mut s = String::new();
+    for i in 0..n {
+        if groups > 0 && tc.draw(int!(0, 2)) == 0 {
+            let g = tc.draw(int!(1, groups as i64));
+            if i == n - 1 && tc.draw(generators::booleans()) {
+                s.push_str(&format!("${g}"));
+            } else {
+                s.push_str(&format!("${{{g}}}"));
+            }
+        } else {
+            s.push_str(pick(tc, &["A", "b", "-", ".", "0", "z", "_"]));
+        }
+    }
+    s
+}
+
+const DELIMS: &[char] = &['/', '|', '#', '!', '%', '@', ','];
+
+#[derive(Clone, Debug)]
+struct SubstRule {
+    delim: char,
+    pattern: GenRegex,
+    replacement: String,
+    flags: String,
+}
+
+impl SubstRule {
+    fn text(&self) -> String {
+        let d = self.delim;
+        format!("s{d}{}{d}{}{d}{}", self.pattern.text, self.replacement, self.flags)
+    }
+}
+
+#[hegel::composite]
+fn arb_subst_rule(tc: &hegel::TestCase, global_only: bool) -> SubstRule {
+    let delim = pick(tc, DELIMS);
+    let pattern = tc.draw(arb_regex(2).print_as_debug());
+    let replacement = tc.draw(arb_replacement(pattern.groups));
+    let flags = if global_only {
+        pick(tc, &["", "g"]).to_string()
+    } else {
+        pick(tc, &["", "g", "i", "gi", "x", "gx"]).to_string()
+    };
+    SubstRule { delim, pattern, replacement, flags }
+}
+
+/// Characters and ranges for `tr` lists.
+#[hegel::composite]
+fn arb_tr_list(tc: &hegel::TestCase) -> (String, usize) {
+    let n = tc.draw(int!(1, 3)) as usize;
+    let mut s = String::new();
+    let mut len = 0;
+    for _ in 0..n {
+        match tc.draw(int!(0, 3)) {
+            0 => {
+                s.push_str("a-c");
+                len += 3;
+            }
+            1 => {
+                s.push_str("0-2");
+                len += 3;
+            }
+            _ => {
+                s.push(pick(tc, &['x', 'y', 'z', '.', '_', 'q']));
+                len += 1;
+            }
+        }
+    }
+    (s, len)
+}
+
+/// Strings mangling rules are applied to.
+#[hegel::composite]
+fn arb_input(tc: &hegel::TestCase) -> String {
+    match tc.draw(int!(0, 2)) {
+        0 => pick(
+            tc,
+            &["1.2.3", "v1.2.3", "1.0+ds", "1.0+dfsg1", "foo-1.2.3.tar.gz", "https://x.org/archive/v0.9.4.tar.gz", "2.0~rc1", "1_2_3", "release-1.2", "0.0.1-beta.2", "abc", ""],
+        )
+        .to_string(),
+        _ => {
+            let n = tc.draw(int!(0, 8)) as usize;
+            (0..n).map(|_| pick(tc, &['a', 'b', 'c', 'x', '1', '2', '0', '.', '-', '_', '~', '+', '/'])).collect()
+        }
+    }
+}
+
+// Watch files ----------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+struct WOption {
+    key: String,
+    value: Option<String>,
+}
+
+impl WOption {
+    fn text(&self) -> String {
+        match &self.value {
+            Some(v) => format!("{}={v}", self.key),
+            None => self.key.clone(),
+        }
+    }
+}
+
+const FLAG_KEYS: &[&str] = &["bare", "repack", "decompress", "passive", "active"];
+const VALUE_KEYS: &[(&str, &[&str])] = &[
+    ("compression", &["xz", "gz", "gzip", "bzip2", "bz2", "lzma", "default"]),
+    ("mode", &["git", "lwp", "svn"]),
+    ("pretty", &["0.0~git%cd.%h", "describe"]),
+    ("component", &["foo", "js-lib"]),
+    ("searchmode", &["plain", "html"]),
+    ("pgpmode", &["auto", "default", "mangle", "next", "previous", "self", "gittag"]),
+    ("gitmode", &["shallow", "full"]),
+    ("gitexport", &["all", "default"]),
+    ("ctype", &["perl", "nodejs"]),
+    ("repacksuffix", &["+ds", "+dfsg"]),
+    ("date", &["%Y%m%d", "%Y-%m-%d"]),
+    ("pgpsigurlmangle", &["s/$/.asc/", "s/$/.sig/"]),
+    // debian-watch/12: a value with `=` is truncated, so none here (pinned).
+    ("filenamemangle", &["s/.+\\/v?(\\d\\S+)\\.tar\\.gz/foo-$1.tar.gz/", "s/.*\\/(\\d\\S+)\\.zip/foo-$1.zip/"]),
+    ("uversionmangle", &["s/\\+ds//", "s/-rc/~rc/", "s/_/./g"]),
+    ("dversionmangle", &["s/\\+ds//", "s/\\+dfsg\\d*$//"]),
+    ("versionmangle", &["s/-/./g"]),
+    ("dirversionmangle", &["s/v(\\d)/$1/"]),
+    ("unzipopt", &["-a"]),
+];
+
+#[hegel::composite]
+fn arb_options(tc: &hegel::TestCase) -> Vec<WOption> {
+    let flags = subset(tc, FLAG_KEYS, 2);
+    let valued = subset(tc, VALUE_KEYS, 3);
+    let mut out: Vec<WOption> = Vec::new();
+    for f in flags {
+        out.push(WOption { key: f.to_string(), value: None });
+    }
+    for (k, vals) in valued {
+        out.push(WOption { key: k.to_string(), value: Some(pick(tc, vals).to_string()) });
+    }
+    // debian-watch/7: a flag option ending the list is a parse error, so
+    // the general properties keep a valued option last (pinned separately).
+    if out.last().map_or(false, |o| o.value.is_none()) {
+        out.push(WOption { key: "compression".to_string(), value: Some("xz".to_string()) });
+    }
+    out
+}
+
+fn valued_only(options: &[WOption]) -> Vec<WOption> {
+    options.iter().filter(|o| o.value.is_some()).cloned().collect()
+}
+
+const URLS: &[&str] = &[
+    "https://h.example.org/releases/",
+    "https://github.com/@PACKAGE@/tags",
+    "https://pypi.debian.net/@PACKAGE@/@PACKAGE@-(.+)\\.tar\\.gz",
+    "ftp://ftp.example.org/pub/foo/",
+    "https://example.org/dl?per_page=100",
+    "https://example.org/dir/foo-(\\d[\\d.]*)\\.tar\\.gz",
+];
+const PATTERNS: &[&str] = &[
+    ".*/v?(\\d\\S+)\\.tar\\.gz",
+    "foo-(\\d[\\d.]*)@ARCHIVE_EXT@",
+    "(?:.*?/)?v?(\\d[\\d.]*)\\.tar\\.gz",
+    "@PACKAGE@-@ANY_VERSION@@ARCHIVE_EXT@",
+    ".*?v=(\\d+)",
+];
+const POLICIES: &[&str] = &["debian", "same", "previous", "ignore", "group", "checksum", "version-1.2"];
+const SCRIPTS: &[&str] = &["uupdate", "debian/orig-tar.sh"];
+
+#[derive(Clone, Debug)]
+struct WEntry {
+    options: Vec<WOption>,
+    quoted: bool,
+    /// Space after the comma inside quoted options.
+    quoted_spaces: bool,
+    /// Line continuation between the options and the URL.
+    cont_after_opts: bool,
+    url: String,
+    pattern: Option<String>,
+    policy: Option<String>,
+    script: Option<String>,
+    sep: String,
+}
+
+impl WEntry {
+    fn url_has_pattern(&self) -> bool {
+        py_split_url(&self.url).is_some()
+    }
+    fn opts_text(&self) -> Option<String> {
+        if self.options.is_empty() {
+            return None;
+        }
+        let joiner = if self.quoted && self.quoted_spaces { ", " } else { "," };
+        let inner = self.options.iter().map(|o| o.text()).collect::<Vec<_>>().join(joiner);
+        Some(if self.quoted { format!("opts=\"{inner}\"") } else { format!("opts={inner}") })
+    }
+    fn text(&self) -> String {
+        let mut s = String::new();
+        if let Some(o) = self.opts_text() {
+            s.push_str(&o);
+            if self.cont_after_opts {
+                s.push_str(" \\\n  ");
+            } else {
+                s.push_str(&self.sep);
+            }
+        }
+        s.push_str(&self.url);
+        for f in [&self.pattern, &self.policy, &self.script].into_iter().flatten() {
+            s.push_str(&self.sep);
+            s.push_str(f);
+        }
+        s
+    }
+    fn option_texts(&self) -> Vec<String> {
+        self.options.iter().map(|o| o.text()).collect()
+    }
+    fn get(&self, key: &str) -> Option<Option<String>> {
+        self.options.iter().find(|o| o.key == key).map(|o| o.value.clone())
+    }
+}
+
+/// python-debian splits a filename pattern off the URL when the last path
+/// component contains parentheses.
+fn py_split_url(url: &str) -> Option<(String, String)> {
+    let idx = url.rfind('/')?;
+    let comp = &url[idx + 1..];
+    let open = comp.find('(')?;
+    comp[open..].find(')')?;
+    Some((url[..idx].to_string(), comp.to_string()))
+}
+
+#[hegel::composite]
+fn arb_wentry(tc: &hegel::TestCase) -> WEntry {
+    let options = tc.draw(arb_options().print_as_debug());
+    let url = pick(tc, URLS).to_string();
+    let in_url = py_split_url(&url).is_some();
+    let pattern = if in_url || tc.draw(int!(0, 3)) == 0 { None } else { Some(pick(tc, PATTERNS).to_string()) };
+    // debian-watch/10: fields after a URL with an inline pattern are shifted,
+    // so the general properties give such URLs no policy (pinned separately).
+    let policy = if pattern.is_some() && tc.draw(generators::booleans()) {
+        Some(pick(tc, POLICIES).to_string())
+    } else {
+        None
+    };
+    let script = if policy.is_some() && tc.draw(generators::booleans()) { Some(pick(tc, SCRIPTS).to_string()) } else { None };
+    WEntry {
+        options,
+        quoted: tc.draw(generators::booleans()),
+        quoted_spaces: tc.draw(generators::booleans()),
+        cont_after_opts: tc.draw(int!(0, 2)) == 0,
+        url,
+        pattern,
+        policy,
+        script,
+        sep: pick(tc, &[" ", "  ", " \t", "\t"]).to_string(),
+    }
+}
+
+#[derive(Clone, Debug)]
+struct WFile {
+    version: u32,
+    /// Lines (comments, blanks) before the version line.
+    leading: Vec<String>,
+    entries: Vec<WEntry>,
+    /// Lines before entry i / after the last.
+    extra: Vec<Vec<String>>,
+    trailing_newline: bool,
+}
+
+impl WFile {
+    fn text(&self) -> String {
+        let mut lines: Vec<String> = self.leading.clone();
+        lines.push(format!("version={}", self.version));
+        for (i, e) in self.entries.iter().enumerate() {
+            lines.extend(self.extra[i].iter().cloned());
+            lines.push(e.text());
+        }
+        lines.extend(self.extra[self.entries.len()].iter().cloned());
+        let mut s = lines.join("\n");
+        if self.trailing_newline {
+            s.push('\n');
+        }
+        s
+    }
+}
+
+#[hegel::composite]
+fn arb_wfile(tc: &hegel::TestCase) -> WFile {
+    let version = pick(tc, &[4, 4, 4, 3]);
+    let n = tc.draw(int!(0, 3)) as usize;
+    let mut entries = Vec::new();
+    for _ in 0..n {
+        entries.push(tc.draw(arb_wentry().print_as_debug()));
+    }
+    let mut extra = Vec::new();
+    for _ in 0..=n {
+        let k = tc.draw(int!(0, 2));
+        let mut e = Vec::new();
+        for _ in 0..k {
+            // debian-watch/11: a comment without a space (`#`, `#foo`) is
+            // read as an entry, so only spaced comments here (pinned).
+            e.push(pick(tc, &["", "# a comment", "# x", "# opts=bare https://x/ .*"]).to_string());
+        }
+        extra.push(e);
+    }
+    let mut leading = Vec::new();
+    if tc.draw(int!(0, 3)) == 0 {
+        leading.push("# Watch file".to_string());
+    }
+    // debian-watch/8: a version line at end of file must have a newline, so
+    // files without entries always get one here (pinned separately).
+    let trailing_newline = tc.draw(int!(0, 4)) != 0 || (entries.is_empty() && extra[0].is_empty());
+    WFile { version, leading, entries, extra, trailing_newline }
+}
