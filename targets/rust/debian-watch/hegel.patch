+        assert_eq!(e.version().unwrap().map(|p| p.to_string()), policy, "policy for {text:?}");
+        // The mangling accessors delegate to apply_mangle.
+        for v in ["1.0+ds", "2.0-rc1", "v1.2"] {
+            let expect = |rule: Option<String>| rule.map(|r| apply_mangle(&r, v).map_err(|e| e.to_string())).unwrap_or(Ok(v.to_string()));
