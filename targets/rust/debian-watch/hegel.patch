+/// debian-watch/1: uscan supports bracketing delimiters (`s{a}{b}`,
+/// `s(a)(b)`, `s[a][b]`, `s<a><b>`); the crate splits on the opening bracket.
+#[hegel::test]
+fn bracket_delimiters_are_supported(tc: hegel::TestCase) {
+    let (open, close) = pick(&tc, &[('{', '}'), ('(', ')'), ('[', ']'), ('<', '>')]);
+    let from = pick(&tc, &["1", "a", "\\+ds", "-rc"]);
+    let to = pick(&tc, &["X", "", "~rc"]);
+    let text = format!("s{open}{from}{close}{open}{to}{close}");
+    let input = tc.draw(arb_input());
+    let theirs = uscan_mangle(&text, &input).unwrap();
+    assert_eq!(apply_mangle(&text, &input).map_err(|e| e.to_string()), Ok(theirs), "rule {text:?} on {input:?}");
+}
+
+/// debian-watch/2: the `i` flag (and `x`) is ignored; flags uscan rejects are
+/// accepted.
+#[hegel::test]
+fn the_case_insensitive_flag_is_honoured(tc: hegel::TestCase) {
+    let from = pick(&tc, &["A", "FOO", "X"]);
+    let text = format!("s/{from}/y/i");
+    let input = pick(&tc, &["a", "foo", "x", "aA", "xfoo"]).to_string();
+    let theirs = uscan_mangle(&text, &input).unwrap();
+    assert_eq!(apply_mangle(&text, &input).map_err(|e| e.to_string()), Ok(theirs), "rule {text:?} on {input:?}");
+}
+
+/// debian-watch/3: uscan refuses flags outside `gix`.
+#[hegel::test]
+fn unknown_flags_are_refused(tc: hegel::TestCase) {
+    let flag = pick(&tc, &["z", "e", "s", "m", "q"]);
+    let text = format!("s/a/b/{flag}");
+    assert!(uscan_mangle(&text, "a").is_err());
+    assert!(apply_mangle(&text, "a").is_err(), "accepted {text:?}");
+}
