diff --git a/iOverlay/tests/float_overlay_tests.rs b/iOverlay/tests/float_overlay_tests.rs
index 160af83..db6b53f 100644
--- a/iOverlay/tests/float_overlay_tests.rs
+++ b/iOverlay/tests/float_overlay_tests.rs
@@ -719,3 +719,121 @@ mod tests {
         assert_eq!(result_with_filter.len(), 2);
     }
 }
+
+// Hegel property-based tests for the float overlay API.
+#[cfg(test)]
+mod hegel_props {
+    use hegel::generators;
+    use hegel::Generator;
+    use i_overlay::core::fill_rule::FillRule;
+    use i_overlay::core::overlay_rule::OverlayRule;
+    use i_overlay::float::single::SingleFloatOverlay;
+
+    /// Draw a list of f64 contours with all coordinates bounded by `magnitude`.
+    fn draw_f64_contours(
+        tc: &hegel::TestCase,
+        max_contours: usize,
+        magnitude: f64,
+    ) -> Vec<Vec<[f64; 2]>> {
+        let n_contours = tc.draw(generators::integers::<usize>().max_value(max_contours));
+        let mut contours = Vec::with_capacity(n_contours);
+        for _ in 0..n_contours {
+            let n_points = tc.draw(generators::integers::<usize>().max_value(8));
+            let mut contour = Vec::with_capacity(n_points);
+            for _ in 0..n_points {
+                let x = tc.draw(
+                    generators::floats::<f64>()
+                        .min_value(-magnitude)
+                        .max_value(magnitude),
+                );
+                let y = tc.draw(
+                    generators::floats::<f64>()
+                        .min_value(-magnitude)
+                        .max_value(magnitude),
+                );
+                contour.push([x, y]);
+            }
+            contours.push(contour);
+        }
+        contours
+    }
+
+    // Property: the f64 overlay accepts any finite input — including
+    // large-but-finite magnitudes and wildly mismatched scales between subject
+    // and clip — without panicking, and every output coordinate is finite and
+    // stays inside the joint input bounding box (inflated by a small factor to
+    // absorb the float -> int -> float rounding grid).
+    #[hegel::test]
+    fn hegel_float_overlay_extremes_no_panic_finite_output(tc: hegel::TestCase) {
+        let magnitudes = vec![1.0, 1e-9, 1e9, 1e15, 1e100, 1e300];
+        let subj_mag: f64 = tc.draw(generators::sampled_from(magnitudes.clone()));
+        let clip_mag: f64 = tc.draw(generators::sampled_from(magnitudes));
+
+        let subj = draw_f64_contours(&tc, 2, subj_mag);
+        let clip = draw_f64_contours(&tc, 2, clip_mag);
+
+        let rule = tc.draw((generators::sampled_from(vec![
+            OverlayRule::Subject,
+            OverlayRule::Clip,
+            OverlayRule::Intersect,
+            OverlayRule::Union,
+            OverlayRule::Difference,
+            OverlayRule::InverseDifference,
+            OverlayRule::Xor,
+        ])).print_as_debug());
+        let fill = tc.draw((generators::sampled_from(vec![
+            FillRule::EvenOdd,
+            FillRule::NonZero,
+            FillRule::Positive,
+            FillRule::Negative,
+        ])).print_as_debug());
+
+        let result = subj.overlay(&clip, rule, fill);
+
+        // Joint input bounding box.
+        let mut lo = [f64::INFINITY; 2];
+        let mut hi = [f64::NEG_INFINITY; 2];
+        for contour in subj.iter().chain(clip.iter()) {
+            for p in contour {
+                for k in 0..2 {
+                    lo[k] = lo[k].min(p[k]);
+                    hi[k] = hi[k].max(p[k]);
+                }
+            }
+        }
+        let extent = (hi[0] - lo[0]).max(hi[1] - lo[1]).max(f64::MIN_POSITIVE);
+        // The float API routes through an integer grid of ~2^30 cells across the
+        // bounding rect; allow a few cells of slack.
+        let eps = extent * 1e-6;
+
+        for shape in &result {
+            for contour in shape {
+                for p in contour {
+                    assert!(
+                        p[0].is_finite() && p[1].is_finite(),
+                        "non-finite output point {:?}, subj={:?} clip={:?} rule={} fill={:?}",
+                        p,
+                        subj,
+                        clip,
+                        rule,
+                        fill
+                    );
+                    assert!(
+                        p[0] >= lo[0] - eps
+                            && p[0] <= hi[0] + eps
+                            && p[1] >= lo[1] - eps
+                            && p[1] <= hi[1] + eps,
+                        "output point {:?} outside joint input bounds lo={:?} hi={:?}, subj={:?} clip={:?} rule={} fill={:?}",
+                        p,
+                        lo,
+                        hi,
+                        subj,
+                        clip,
+                        rule,
+                        fill
+                    );
+                }
+            }
+        }
+    }
+}
diff --git a/iOverlay/tests/overlay_tests.rs b/iOverlay/tests/overlay_tests.rs
index 4f7f99d..954f17b 100644
--- a/iOverlay/tests/overlay_tests.rs
+++ b/iOverlay/tests/overlay_tests.rs
@@ -903,3 +903,867 @@ mod tests {
     // print_json(0, FillRule::NonZero)
     // }
 }
+
+// Hegel property-based tests for the integer boolean-overlay API.
+//
+// These properties are grounded in the documented contract of `Overlay::overlay`:
+// - the result is a set of shapes whose outer contours are CCW and holes CW
+//   (default `IntOverlayOptions`),
+// - the boolean rules have their usual set semantics with respect to the chosen
+//   `FillRule` (subject/clip regions defined by winding number),
+// - all four solver strategies compute the same result (the existing data-driven
+//   tests in this file already assert solver agreement on fixed fixtures).
+//
+// Because the API is integer-based, an exact shoelace-area / winding-number oracle
+// (computed here with i128 arithmetic) needs no tolerances.
+#[cfg(test)]
+mod hegel_props {
+    use hegel::generators;
+    use hegel::Generator;
+    use i_float::int::point::IntPoint;
+    use i_overlay::core::fill_rule::FillRule;
+    use i_overlay::core::overlay::Overlay;
+    use i_overlay::core::overlay_rule::OverlayRule;
+    use i_overlay::core::solver::{Precision, Solver, Strategy};
+    use i_shape::int::shape::{IntContour, IntShapes};
+
+    // ---------- input generators ----------
+
+    /// Draw a list of contours whose coordinates live in one of three regimes:
+    /// - a dense small grid (maximizes collinear / coincident / touching edges),
+    /// - a moderate range,
+    /// - large-but-finite magnitudes. |c| < 2^30 is the largest range on which the
+    ///   i32 engine's wide arithmetic cannot overflow: with |c| >= 2^30, cross
+    ///   products of coordinate-difference vectors overflow i64 — a real bug,
+    ///   pinned by `hegel_pin_i32_engine_cross_product_overflow` below, and
+    ///   excluded here so the sibling properties keep testing everything else.
+    ///   (Robustness reports against `geo`, which uses this crate as its boolean
+    ///   engine, involved large coordinates.)
+    fn draw_contours(tc: &hegel::TestCase, max_contours: usize) -> Vec<IntContour<i32>> {
+        const M: i32 = (1 << 30) - 1;
+        let regime = tc.draw(generators::integers::<u8>().max_value(2));
+        let (lo, hi) = match regime {
+            0 => (0, 6),
+            1 => (-1000, 1000),
+            _ => (-M, M),
+        };
+        draw_contours_in(tc, max_contours, lo, hi)
+    }
+
+    fn draw_contours_in(
+        tc: &hegel::TestCase,
+        max_contours: usize,
+        lo: i32,
+        hi: i32,
+    ) -> Vec<IntContour<i32>> {
+        let n_contours = tc.draw(generators::integers::<usize>().max_value(max_contours));
+        let mut contours = Vec::with_capacity(n_contours);
+        for _ in 0..n_contours {
+            // 0..=2 point contours are degenerate on purpose: the library is
+            // expected to drop them (see tests/empty_tests.rs).
+            let n_points = tc.draw(generators::integers::<usize>().max_value(8));
+            let mut contour = Vec::with_capacity(n_points);
+            for _ in 0..n_points {
+                let x = tc.draw(generators::integers::<i32>().min_value(lo).max_value(hi));
+                let y = tc.draw(generators::integers::<i32>().min_value(lo).max_value(hi));
+                contour.push(IntPoint::new(x, y));
+            }
+            contours.push(contour);
+        }
+        contours
+    }
+
+    fn draw_fill_rule(tc: &hegel::TestCase) -> FillRule {
+        tc.draw((generators::sampled_from(vec![
+            FillRule::EvenOdd,
+            FillRule::NonZero,
+            FillRule::Positive,
+            FillRule::Negative,
+        ])).print_as_debug())
+    }
+
+    fn draw_overlay_rule(tc: &hegel::TestCase) -> OverlayRule {
+        tc.draw((generators::sampled_from(vec![
+            OverlayRule::Subject,
+            OverlayRule::Clip,
+            OverlayRule::Intersect,
+            OverlayRule::Union,
+            OverlayRule::Difference,
+            OverlayRule::InverseDifference,
+            OverlayRule::Xor,
+        ])).print_as_debug())
+    }
+
+    fn draw_solver(tc: &hegel::TestCase) -> Solver {
+        let strategy = tc.draw((generators::sampled_from(vec![
+            Strategy::List,
+            Strategy::Tree,
+            Strategy::Frag,
+            Strategy::Auto,
+        ])).print_as_debug());
+        Solver::with_strategy_and_precision(strategy, Precision::HIGH)
+    }
+
+    // ---------- helpers / oracles ----------
+
+    fn run(
+        subj: &[IntContour<i32>],
+        clip: &[IntContour<i32>],
+        rule: OverlayRule,
+        fill: FillRule,
+        solver: Solver,
+    ) -> IntShapes<i32> {
+        Overlay::with_contours_custom(subj, clip, Default::default(), solver).overlay(rule, fill)
+    }
+
+    /// Twice the signed area of a contour (shoelace), exact in i128.
+    fn signed_area2(contour: &[IntPoint<i32>]) -> i128 {
+        let n = contour.len();
+        let mut s: i128 = 0;
+        for i in 0..n {
+            let a = contour[i];
+            let b = contour[(i + 1) % n];
+            s += a.x as i128 * b.y as i128 - a.y as i128 * b.x as i128;
+        }
+        s
+    }
+
+    /// Twice the net signed area of a result (outer CCW positive, holes CW negative).
+    fn shapes_area2(shapes: &IntShapes<i32>) -> i128 {
+        shapes
+            .iter()
+            .flat_map(|shape| shape.iter())
+            .map(|contour| signed_area2(contour))
+            .sum()
+    }
+
+    /// Exact orientation predicate: sign of cross(b - a, p - a).
+    fn orient(a: IntPoint<i32>, b: IntPoint<i32>, p: IntPoint<i32>) -> i128 {
+        (b.x as i128 - a.x as i128) * (p.y as i128 - a.y as i128)
+            - (b.y as i128 - a.y as i128) * (p.x as i128 - a.x as i128)
+    }
+
+    /// Winding number of `p` with respect to a set of contours (exact).
+    fn winding_number(contours: &[IntContour<i32>], p: IntPoint<i32>) -> i64 {
+        let mut wn: i64 = 0;
+        for contour in contours {
+            let n = contour.len();
+            for i in 0..n {
+                let a = contour[i];
+                let b = contour[(i + 1) % n];
+                if a.y <= p.y {
+                    if b.y > p.y && orient(a, b, p) > 0 {
+                        wn += 1;
+                    }
+                } else if b.y <= p.y && orient(a, b, p) < 0 {
+                    wn -= 1;
+                }
+            }
+        }
+        wn
+    }
+
+    fn filled(wn: i64, fill: FillRule) -> bool {
+        match fill {
+            FillRule::EvenOdd => wn & 1 != 0,
+            FillRule::NonZero => wn != 0,
+            FillRule::Positive => wn > 0,
+            FillRule::Negative => wn < 0,
+        }
+    }
+
+    fn expected_membership(rule: OverlayRule, subj_in: bool, clip_in: bool) -> bool {
+        match rule {
+            OverlayRule::Subject => subj_in,
+            OverlayRule::Clip => clip_in,
+            OverlayRule::Intersect => subj_in && clip_in,
+            OverlayRule::Union => subj_in || clip_in,
+            OverlayRule::Difference => subj_in && !clip_in,
+            OverlayRule::InverseDifference => clip_in && !subj_in,
+            OverlayRule::Xor => subj_in != clip_in,
+        }
+    }
+
+    /// Point membership in a result: even-odd parity over every contour of every
+    /// shape. For a well-formed result (disjoint shapes, holes inside outers) this
+    /// equals "inside some outer contour and not inside one of its holes".
+    fn result_contains(shapes: &IntShapes<i32>, p: IntPoint<i32>) -> bool {
+        let mut wn: i64 = 0;
+        for shape in shapes {
+            wn += winding_number(shape, p);
+        }
+        wn & 1 != 0
+    }
+
+    /// Conservative proximity check: true if `p` could be within `guard` of the
+    /// *line* through segment (a, b) (or of the points, for degenerate segments).
+    fn near_segment(a: IntPoint<i32>, b: IntPoint<i32>, p: IntPoint<i32>, guard: i128) -> bool {
+        let len2 = (a.x as i128 - b.x as i128).pow(2) + (a.y as i128 - b.y as i128).pow(2);
+        if len2 == 0 {
+            return (a.x as i128 - p.x as i128).pow(2) + (a.y as i128 - p.y as i128).pow(2)
+                < guard * guard;
+        }
+        let cross = orient(a, b, p);
+        cross * cross < guard * guard * len2
+    }
+
+    fn near_any_segment(contours: &[IntContour<i32>], p: IntPoint<i32>, guard: i128) -> bool {
+        contours.iter().any(|contour| {
+            let n = contour.len();
+            (0..n).any(|i| near_segment(contour[i], contour[(i + 1) % n], p, guard))
+        })
+    }
+
+    /// Canonical form for comparing results independent of contour start point,
+    /// hole order, and shape order (outer contour stays first within a shape).
+    fn canon(shapes: &IntShapes<i32>) -> IntShapes<i32> {
+        let mut out: IntShapes<i32> = shapes
+            .iter()
+            .map(|shape| {
+                let mut s: Vec<IntContour<i32>> =
+                    shape.iter().map(|c| rotate_to_min(c)).collect();
+                if s.len() > 2 {
+                    s[1..].sort();
+                }
+                s
+            })
+            .collect();
+        out.sort();
+        out
+    }
+
+    fn rotate_to_min(contour: &[IntPoint<i32>]) -> IntContour<i32> {
+        if contour.is_empty() {
+            return Vec::new();
+        }
+        let k = contour
+            .iter()
+            .enumerate()
+            .min_by_key(|(_, p)| **p)
+            .map(|(i, _)| i)
+            .unwrap();
+        contour[k..].iter().chain(contour[..k].iter()).copied().collect()
+    }
+
+    /// True if the open interiors of segments (p1, p2) and (q1, q2) cross at a
+    /// single point which is interior to both (a "proper" crossing). Touching at
+    /// endpoints and collinear overlaps are not flagged.
+    fn proper_cross(
+        p1: IntPoint<i32>,
+        p2: IntPoint<i32>,
+        q1: IntPoint<i32>,
+        q2: IntPoint<i32>,
+    ) -> bool {
+        let d1 = orient(q1, q2, p1);
+        let d2 = orient(q1, q2, p2);
+        let d3 = orient(p1, p2, q1);
+        let d4 = orient(p1, p2, q2);
+        d1 != 0
+            && d2 != 0
+            && d3 != 0
+            && d4 != 0
+            && (d1 > 0) != (d2 > 0)
+            && (d3 > 0) != (d4 > 0)
+    }
+
+    // ---------- properties ----------
+
+    // Property: area(Union) + area(Intersect) == area(Subject) + area(Clip),
+    // exactly, for every fill rule and solver. All four results are extracted from
+    // the same integer segment arrangement, and per region the rule algebra
+    // (union = subj | clip, intersect = subj & clip) makes this an identity.
+    #[hegel::test]
+    fn hegel_area_union_intersect_additivity(tc: hegel::TestCase) {
+        let subj = draw_contours(&tc, 3);
+        let clip = draw_contours(&tc, 3);
+        let fill = draw_fill_rule(&tc);
+        let solver = draw_solver(&tc);
+
+        let subj_a = shapes_area2(&run(&subj, &clip, OverlayRule::Subject, fill, solver));
+        let clip_a = shapes_area2(&run(&subj, &clip, OverlayRule::Clip, fill, solver));
+        let union_a = shapes_area2(&run(&subj, &clip, OverlayRule::Union, fill, solver));
+        let inter_a = shapes_area2(&run(&subj, &clip, OverlayRule::Intersect, fill, solver));
+
+        assert_eq!(
+            union_a + inter_a,
+            subj_a + clip_a,
+            "subj={:?} clip={:?} fill={:?}",
+            subj,
+            clip,
+            fill
+        );
+    }
+
+    // Property: Xor and the two differences decompose the union exactly:
+    // area(Xor) = area(Union) - area(Intersect),
+    // area(Difference) = area(Union) - area(Clip),
+    // area(InverseDifference) = area(Union) - area(Subject).
+    #[hegel::test]
+    fn hegel_area_xor_difference_decomposition(tc: hegel::TestCase) {
+        let subj = draw_contours(&tc, 3);
+        let clip = draw_contours(&tc, 3);
+        let fill = draw_fill_rule(&tc);
+        let solver = draw_solver(&tc);
+
+        let subj_a = shapes_area2(&run(&subj, &clip, OverlayRule::Subject, fill, solver));
+        let clip_a = shapes_area2(&run(&subj, &clip, OverlayRule::Clip, fill, solver));
+        let union_a = shapes_area2(&run(&subj, &clip, OverlayRule::Union, fill, solver));
+        let inter_a = shapes_area2(&run(&subj, &clip, OverlayRule::Intersect, fill, solver));
+        let xor_a = shapes_area2(&run(&subj, &clip, OverlayRule::Xor, fill, solver));
+        let diff_a = shapes_area2(&run(&subj, &clip, OverlayRule::Difference, fill, solver));
+        let inv_diff_a =
+            shapes_area2(&run(&subj, &clip, OverlayRule::InverseDifference, fill, solver));
+
+        assert_eq!(xor_a, union_a - inter_a, "xor, subj={:?} clip={:?}", subj, clip);
+        assert_eq!(diff_a, union_a - clip_a, "difference, subj={:?} clip={:?}", subj, clip);
+        assert_eq!(
+            inv_diff_a,
+            union_a - subj_a,
+            "inverse difference, subj={:?} clip={:?}",
+            subj,
+            clip
+        );
+    }
+
+    // Property: Union, Intersect and Xor are commutative, and
+    // Difference(A, B) == InverseDifference(B, A) (documented on `ShapeType`:
+    // "All operations except for `Difference` are commutative").
+    #[hegel::test]
+    fn hegel_commutativity(tc: hegel::TestCase) {
+        let subj = draw_contours(&tc, 3);
+        let clip = draw_contours(&tc, 3);
+        let fill = draw_fill_rule(&tc);
+        let solver = draw_solver(&tc);
+
+        for rule in [OverlayRule::Union, OverlayRule::Intersect, OverlayRule::Xor] {
+            let ab = run(&subj, &clip, rule, fill, solver);
+            let ba = run(&clip, &subj, rule, fill, solver);
+            assert_eq!(
+                canon(&ab),
+                canon(&ba),
+                "{} not commutative, subj={:?} clip={:?} fill={:?}",
+                rule,
+                subj,
+                clip,
+                fill
+            );
+        }
+
+        let diff = run(&subj, &clip, OverlayRule::Difference, fill, solver);
+        let inv = run(&clip, &subj, OverlayRule::InverseDifference, fill, solver);
+        assert_eq!(
+            canon(&diff),
+            canon(&inv),
+            "Difference(A,B) != InverseDifference(B,A), subj={:?} clip={:?} fill={:?}",
+            subj,
+            clip,
+            fill
+        );
+    }
+
+    // Property: point membership in the result matches an exact winding-number
+    // oracle on the *inputs*. Sample points that are far enough from every input
+    // segment that the library's integer rounding of intersection points cannot
+    // change their classification. Coordinates are multiples of 64 so degenerate
+    // (collinear / coincident / touching) inputs are still common while leaving
+    // room between features for the guard band.
+    #[hegel::test]
+    fn hegel_membership_matches_winding_oracle(tc: hegel::TestCase) {
+        const GUARD: i128 = 8;
+        let subj: Vec<IntContour<i32>> = draw_contours_in(&tc, 3, 0, 16)
+            .into_iter()
+            .map(|c| c.into_iter().map(|p| IntPoint::new(p.x * 64, p.y * 64)).collect())
+            .collect();
+        let clip: Vec<IntContour<i32>> = draw_contours_in(&tc, 3, 0, 16)
+            .into_iter()
+            .map(|c| c.into_iter().map(|p| IntPoint::new(p.x * 64, p.y * 64)).collect())
+            .collect();
+        let fill = draw_fill_rule(&tc);
+        let rule = draw_overlay_rule(&tc);
+        let solver = draw_solver(&tc);
+
+        let result = run(&subj, &clip, rule, fill, solver);
+
+        let n_samples = tc.draw(generators::integers::<usize>().min_value(10).max_value(30));
+        for _ in 0..n_samples {
+            let x = tc.draw(generators::integers::<i32>().min_value(-64).max_value(1088));
+            let y = tc.draw(generators::integers::<i32>().min_value(-64).max_value(1088));
+            let p = IntPoint::new(x, y);
+            if near_any_segment(&subj, p, GUARD) || near_any_segment(&clip, p, GUARD) {
+                continue;
+            }
+            let subj_in = filled(winding_number(&subj, p), fill);
+            let clip_in = filled(winding_number(&clip, p), fill);
+            let expected = expected_membership(rule, subj_in, clip_in);
+            let actual = result_contains(&result, p);
+            assert_eq!(
+                expected, actual,
+                "membership mismatch at {:?}, rule={} fill={:?} subj={:?} clip={:?} result={:?}",
+                p, rule, fill, subj, clip, result
+            );
+        }
+    }
+
+    // Property: output boundaries are clean. No output contour has fewer than 3
+    // points or a zero-length edge, and no two output segments (within or across
+    // contours) cross properly — self-intersecting output is exactly the class of
+    // robustness bug reported downstream in `geo`.
+    #[hegel::test]
+    fn hegel_output_boundary_has_no_proper_crossings(tc: hegel::TestCase) {
+        let subj = draw_contours(&tc, 3);
+        let clip = draw_contours(&tc, 3);
+        let fill = draw_fill_rule(&tc);
+        let rule = draw_overlay_rule(&tc);
+        let solver = draw_solver(&tc);
+
+        let result = run(&subj, &clip, rule, fill, solver);
+
+        let mut segments: Vec<(IntPoint<i32>, IntPoint<i32>)> = Vec::new();
+        for shape in &result {
+            for contour in shape {
+                assert!(
+                    contour.len() >= 3,
+                    "contour with fewer than 3 points: {:?}, subj={:?} clip={:?}",
+                    contour,
+                    subj,
+                    clip
+                );
+                let n = contour.len();
+                for i in 0..n {
+                    let a = contour[i];
+                    let b = contour[(i + 1) % n];
+                    assert_ne!(
+                        a, b,
+                        "zero-length output edge in {:?}, subj={:?} clip={:?}",
+                        contour, subj, clip
+                    );
+                    segments.push((a, b));
+                }
+            }
+        }
+
+        for i in 0..segments.len() {
+            for j in (i + 1)..segments.len() {
+                let (p1, p2) = segments[i];
+                let (q1, q2) = segments[j];
+                assert!(
+                    !proper_cross(p1, p2, q1, q2),
+                    "output segments properly cross: ({}, {}) x ({}, {}), rule={} fill={:?} subj={:?} clip={:?} result={:?}",
+                    p1, p2, q1, q2, rule, fill, subj, clip, result
+                );
+            }
+        }
+    }
+
+    // Property: with default options every outer contour is counterclockwise
+    // (positive signed area), every hole is clockwise (negative signed area), and
+    // no hole is larger than its outer contour (documented output contract).
+    #[hegel::test]
+    fn hegel_output_orientation(tc: hegel::TestCase) {
+        let subj = draw_contours(&tc, 3);
+        let clip = draw_contours(&tc, 3);
+        let fill = draw_fill_rule(&tc);
+        let rule = draw_overlay_rule(&tc);
+        let solver = draw_solver(&tc);
+
+        let result = run(&subj, &clip, rule, fill, solver);
+
+        for shape in &result {
+            assert!(!shape.is_empty(), "empty shape in result, subj={:?} clip={:?}", subj, clip);
+            let outer = signed_area2(&shape[0]);
+            assert!(
+                outer > 0,
+                "outer contour not CCW (area2={}): {:?}, subj={:?} clip={:?}",
+                outer,
+                shape[0],
+                subj,
+                clip
+            );
+            for hole in &shape[1..] {
+                let hole_a = signed_area2(hole);
+                assert!(
+                    hole_a < 0,
+                    "hole not CW (area2={}): {:?}, subj={:?} clip={:?}",
+                    hole_a,
+                    hole,
+                    subj,
+                    clip
+                );
+                assert!(
+                    -hole_a <= outer,
+                    "hole larger than outer contour, subj={:?} clip={:?}",
+                    subj,
+                    clip
+                );
+            }
+        }
+    }
+
+    // Property: a boolean-operation result is a fixed point — re-resolving it as
+    // a subject returns it unchanged, and Xor of the result with itself is empty.
+    #[hegel::test]
+    fn hegel_result_is_fixed_point(tc: hegel::TestCase) {
+        let subj = draw_contours(&tc, 3);
+        let clip = draw_contours(&tc, 3);
+        let fill = draw_fill_rule(&tc);
+        let rule = draw_overlay_rule(&tc);
+        let solver = draw_solver(&tc);
+
+        let result = run(&subj, &clip, rule, fill, solver);
+        let contours: Vec<IntContour<i32>> =
+            result.iter().flat_map(|s| s.iter().cloned()).collect();
+
+        // The result is oriented (outer CCW / holes CW), so EvenOdd reproduces
+        // the same regions regardless of which fill rule produced it.
+        let resolved = run(&contours, &[], OverlayRule::Subject, FillRule::EvenOdd, solver);
+        assert_eq!(
+            canon(&resolved),
+            canon(&result),
+            "result is not a fixed point, rule={} fill={:?} subj={:?} clip={:?}",
+            rule,
+            fill,
+            subj,
+            clip
+        );
+
+        let self_xor = run(&contours, &contours, OverlayRule::Xor, FillRule::EvenOdd, solver);
+        assert!(
+            self_xor.is_empty(),
+            "Xor(R, R) not empty: {:?}, R={:?}",
+            self_xor,
+            result
+        );
+    }
+
+    // Property: operations against an empty clip behave like set operations
+    // against the empty set: Union == Difference == Xor == Subject, and
+    // Intersect == InverseDifference == empty.
+    #[hegel::test]
+    fn hegel_empty_clip_identities(tc: hegel::TestCase) {
+        let subj = draw_contours(&tc, 3);
+        let fill = draw_fill_rule(&tc);
+        let solver = draw_solver(&tc);
+
+        let subject = run(&subj, &[], OverlayRule::Subject, fill, solver);
+        let subject_c = canon(&subject);
+
+        for rule in [OverlayRule::Union, OverlayRule::Difference, OverlayRule::Xor] {
+            let r = run(&subj, &[], rule, fill, solver);
+            assert_eq!(
+                canon(&r),
+                subject_c,
+                "{} with empty clip != Subject, subj={:?} fill={:?}",
+                rule,
+                subj,
+                fill
+            );
+        }
+        for rule in [OverlayRule::Intersect, OverlayRule::InverseDifference] {
+            let r = run(&subj, &[], rule, fill, solver);
+            assert!(
+                r.is_empty(),
+                "{} with empty clip not empty: {:?}, subj={:?} fill={:?}",
+                rule,
+                r,
+                subj,
+                fill
+            );
+        }
+    }
+
+    /// Exact test: is `p` on any boundary segment of `shapes`?
+    fn on_any_boundary(shapes: &IntShapes<i32>, p: IntPoint<i32>) -> bool {
+        shapes.iter().flat_map(|s| s.iter()).any(|contour| {
+            let n = contour.len();
+            (0..n).any(|i| {
+                let a = contour[i];
+                let b = contour[(i + 1) % n];
+                orient(a, b, p) == 0
+                    && p.x >= a.x.min(b.x)
+                    && p.x <= a.x.max(b.x)
+                    && p.y >= a.y.min(b.y)
+                    && p.y <= a.y.max(b.y)
+            })
+        })
+    }
+
+    // Property: the List, Tree and Auto solver strategies compute the same
+    // *region*: exactly equal net area, and identical membership for any point
+    // off both boundaries. The existing data-driven tests assert this on fixed
+    // fixtures (via `is_group_of_shapes_one_of`, because the solvers may
+    // legitimately represent a pinch point either as two touching shapes or as
+    // one self-touching contour — found by an earlier revision of this test that
+    // demanded identical contours); here the solvers act as oracles for each
+    // other on random input.
+    //
+    // The Frag solver is NOT included: it resolves genuinely different regions
+    // (different area) on some self-intersecting inputs — a real bug, pinned by
+    // `hegel_pin_frag_solver_region_disagreement` below and excluded here so
+    // this property keeps checking the remaining solvers against each other.
+    #[hegel::test]
+    fn hegel_solver_equivalence(tc: hegel::TestCase) {
+        let subj = draw_contours(&tc, 3);
+        let clip = draw_contours(&tc, 3);
+        let fill = draw_fill_rule(&tc);
+        let rule = draw_overlay_rule(&tc);
+
+        let reference = run(&subj, &clip, rule, fill, Solver::LIST);
+        let ref_area = shapes_area2(&reference);
+
+        // Sample box: joint input bounding box, slightly inflated.
+        let mut lo = IntPoint::new(i32::MAX, i32::MAX);
+        let mut hi = IntPoint::new(i32::MIN, i32::MIN);
+        for p in subj.iter().chain(clip.iter()).flat_map(|c| c.iter()) {
+            lo = IntPoint::new(lo.x.min(p.x), lo.y.min(p.y));
+            hi = IntPoint::new(hi.x.max(p.x), hi.y.max(p.y));
+        }
+
+        let mut samples: Vec<IntPoint<i32>> = Vec::new();
+        if lo.x <= hi.x {
+            let n_samples = tc.draw(generators::integers::<usize>().min_value(5).max_value(20));
+            for _ in 0..n_samples {
+                let x = tc.draw(
+                    generators::integers::<i32>()
+                        .min_value(lo.x.saturating_sub(1))
+                        .max_value(hi.x.saturating_add(1)),
+                );
+                let y = tc.draw(
+                    generators::integers::<i32>()
+                        .min_value(lo.y.saturating_sub(1))
+                        .max_value(hi.y.saturating_add(1)),
+                );
+                samples.push(IntPoint::new(x, y));
+            }
+        }
+
+        for solver in [Solver::TREE, Solver::AUTO] {
+            let r = run(&subj, &clip, rule, fill, solver);
+            assert_eq!(
+                shapes_area2(&r),
+                ref_area,
+                "solver area disagreement (vs LIST), rule={} fill={:?} subj={:?} clip={:?} r={:?} reference={:?}",
+                rule,
+                fill,
+                subj,
+                clip,
+                r,
+                reference
+            );
+            for &p in &samples {
+                if on_any_boundary(&reference, p) || on_any_boundary(&r, p) {
+                    continue;
+                }
+                assert_eq!(
+                    result_contains(&reference, p),
+                    result_contains(&r, p),
+                    "solver membership disagreement at {:?} (vs LIST), rule={} fill={:?} subj={:?} clip={:?} r={:?} reference={:?}",
+                    p,
+                    rule,
+                    fill,
+                    subj,
+                    clip,
+                    r,
+                    reference
+                );
+            }
+        }
+    }
+
+    // Property: the i16, i32 and i64 integer engines agree on inputs that fit in
+    // i16 coordinates — the narrower engines are specializations of the same
+    // algorithm and act as oracles for each other.
+    //
+    // Coordinates are limited to |c| <= 16383 (not the full i16 range) because
+    // beyond that the i16 engine hits two real overflow bugs, each pinned by a
+    // deterministic test below and excluded here so this property keeps testing
+    // engine agreement everywhere else:
+    // - |c| > 23169: cross products of coordinate-difference vectors overflow
+    //   i32 (`hegel_pin_i16_engine_cross_product_overflow`),
+    // - coordinate deltas > 32767: the FRAG solver's grid fragmenter wraps when
+    //   narrowing a fragment height back to i16
+    //   (`hegel_pin_i16_engine_frag_grid_overflow`).
+    // |c| <= 16383 keeps every delta within i16 and every delta product within
+    // i32.
+    #[hegel::test]
+    fn hegel_int_engine_equivalence(tc: hegel::TestCase) {
+        let subj = draw_contours_in(&tc, 2, -16_383, 16_383);
+        let clip = draw_contours_in(&tc, 2, -16_383, 16_383);
+        let fill = draw_fill_rule(&tc);
+        let rule = draw_overlay_rule(&tc);
+        let solver = draw_solver(&tc);
+
+        let r32 = run(&subj, &clip, rule, fill, solver);
+
+        let to_i16 = |cs: &[IntContour<i32>]| -> Vec<IntContour<i16>> {
+            cs.iter()
+                .map(|c| c.iter().map(|p| IntPoint::new(p.x as i16, p.y as i16)).collect())
+                .collect()
+        };
+        let to_i64 = |cs: &[IntContour<i32>]| -> Vec<IntContour<i64>> {
+            cs.iter()
+                .map(|c| c.iter().map(|p| IntPoint::new(p.x as i64, p.y as i64)).collect())
+                .collect()
+        };
+
+        let r16 = Overlay::with_contours_custom(
+            &to_i16(&subj),
+            &to_i16(&clip),
+            Default::default(),
+            solver,
+        )
+        .overlay(rule, fill);
+        let r64 = Overlay::with_contours_custom(
+            &to_i64(&subj),
+            &to_i64(&clip),
+            Default::default(),
+            solver,
+        )
+        .overlay(rule, fill);
+
+        let r16_as_i32: IntShapes<i32> = r16
+            .iter()
+            .map(|s| {
+                s.iter()
+                    .map(|c| c.iter().map(|p| IntPoint::new(p.x as i32, p.y as i32)).collect())
+                    .collect()
+            })
+            .collect();
+        let r64_as_i32: IntShapes<i32> = r64
+            .iter()
+            .map(|s| {
+                s.iter()
+                    .map(|c| {
+                        c.iter().map(|p| IntPoint::new(p.x as i32, p.y as i32)).collect()
+                    })
+                    .collect()
+            })
+            .collect();
+
+        let c32 = canon(&r32);
+        assert_eq!(
+            canon(&r16_as_i32),
+            c32,
+            "i16 engine disagrees with i32, rule={} fill={:?} subj={:?} clip={:?}",
+            rule,
+            fill,
+            subj,
+            clip
+        );
+        assert_eq!(
+            canon(&r64_as_i32),
+            c32,
+            "i64 engine disagrees with i32, rule={} fill={:?} subj={:?} clip={:?}",
+            rule,
+            fill,
+            subj,
+            clip
+        );
+    }
+
+    // ---------- pinned known failures ----------
+
+    // KNOWN FAILURE: the Frag solver resolves a *different region* (not just a
+    // different representation) than List/Tree/Auto on this self-intersecting
+    // subject under EvenOdd:
+    //
+    //   List/Tree/Auto: [(4,2), (0,0), (1,0), (4,1), (4,0), (5,1)]  (area2 = 7)
+    //   Frag:           [(4,2), (0,0), (1,0), (4,1), (5,1)]         (area2 = 6)
+    //
+    // The results differ by the sliver triangle (4,0), (4,1), (5,1). The
+    // intersection of edges (0,0)-(5,1) and (4,0)-(4,2) is (4, 0.8), which
+    // snaps to (4,1); with that snap the sliver has odd parity and should be
+    // filled (hand-checked winding parity of the snapped arrangement), so
+    // List/Tree/Auto appear correct and Frag drops the sliver. Found by
+    // `hegel_solver_equivalence`, which now compares List/Tree/Auto only.
+    #[test]
+    fn hegel_pin_frag_solver_region_disagreement() {
+        let subj: Vec<IntContour<i32>> = vec![
+            vec![
+                IntPoint::new(0, 0),
+                IntPoint::new(5, 1),
+                IntPoint::new(4, 0),
+                IntPoint::new(4, 2),
+            ],
+            vec![IntPoint::new(0, 0), IntPoint::new(1, 0), IntPoint::new(4, 1)],
+        ];
+        let list = run(&subj, &[], OverlayRule::Subject, FillRule::EvenOdd, Solver::LIST);
+        let frag = run(&subj, &[], OverlayRule::Subject, FillRule::EvenOdd, Solver::FRAG);
+        assert_eq!(
+            shapes_area2(&frag),
+            shapes_area2(&list),
+            "Frag region differs from List: frag={:?} list={:?}",
+            frag,
+            list
+        );
+    }
+
+    // KNOWN FAILURE: integer overflow in the i16 engine on legal i16 input.
+    //
+    // `IntPoint - IntPoint` correctly widens to `IntVector<T>` (components in
+    // `T::Wide`), but `IntVector::cross_product` / `dot_product` / `sqr_length`
+    // (i_float-3.0.0, src/int/vector.rs) multiply two `Wide` values *in* `Wide`.
+    // For the i16 engine (`Wide = i32`), coordinate-difference vectors reach
+    // magnitude 2^16, so their cross product needs up to 33 bits and overflows
+    // i32. Found by `hegel_int_engine_equivalence` (which now excludes
+    // |c| > 23169, the exact overflow threshold: 2 * 23169 = 46338 and
+    // 46338^2 < i32::MAX < 46339^2).
+    //
+    // Debug builds panic ("attempt to multiply with overflow") while merely
+    // *adding* the contour; release builds wrap silently, corrupting the
+    // collinearity test that decides which input points to keep.
+    //
+    // The shrunk counterexample is minimal: delta = (43196, 49715) and
+    // 43196 * 49715 = 2_147_489_140, just above i32::MAX = 2_147_483_647.
+    #[test]
+    fn hegel_pin_i16_engine_cross_product_overflow() {
+        let contour = [
+            IntPoint::<i16>::new(13196, 19715),
+            IntPoint::new(-30000, -30000),
+        ];
+        let result =
+            Overlay::<i16>::with_contour(&contour, &[]).overlay(OverlayRule::Subject, FillRule::NonZero);
+        assert!(result.is_empty()); // degenerate 2-point contour resolves to nothing
+    }
+
+    // KNOWN FAILURE: integer overflow in the FRAG solver's grid fragmenter on
+    // legal i16 input (src/split/grid_layout.rs:146,
+    // `let min_y = y0 - I::from_uint(h_max);`).
+    //
+    // Fragment heights are computed in `WideUInt` and can reach 2^16 for i16
+    // coordinates (any segment with |delta y| > i16::MAX), but `from_uint`
+    // narrows the height back to the coordinate type, wrapping it negative, and
+    // the subsequent subtraction overflows (debug panic; silent wraparound in
+    // release). Distinct root cause from the cross-product bug: this one is in
+    // i_overlay's own fragmenter. Found by `hegel_int_engine_equivalence`
+    // (which now limits coordinates to |c| <= 16383 so all deltas fit i16).
+    #[test]
+    fn hegel_pin_i16_engine_frag_grid_overflow() {
+        let clip: Vec<IntContour<i16>> = vec![vec![
+            IntPoint::new(0, 0),
+            IntPoint::new(0, 9854),
+            IntPoint::new(129, -23169),
+        ]];
+        let result =
+            Overlay::<i16>::with_contours_custom(&[], &clip, Default::default(), Solver::FRAG)
+                .overlay(OverlayRule::Subject, FillRule::EvenOdd);
+        assert!(result.is_empty()); // clip-only input resolves Subject to nothing
+    }
+
+    // KNOWN FAILURE: the same cross-product overflow in the *default* i32
+    // engine on legal i32 input (`Wide = i64`): coordinate differences reach
+    // 2^32, so cross products of difference vectors need up to 65 bits and
+    // overflow i64. This is the reason `draw_contours` caps its
+    // large-coordinate regime at |c| < 2^30. Same root cause as
+    // `hegel_pin_i16_engine_cross_product_overflow` (i_float-3.0.0,
+    // src/int/vector.rs).
+    #[test]
+    fn hegel_pin_i32_engine_cross_product_overflow() {
+        let contour = [
+            IntPoint::<i32>::new(i32::MIN, i32::MIN),
+            IntPoint::new(i32::MAX, i32::MAX),
+        ];
+        let result =
+            Overlay::<i32>::with_contour(&contour, &[]).overlay(OverlayRule::Subject, FillRule::NonZero);
+        assert!(result.is_empty()); // degenerate 2-point contour resolves to nothing
+    }
+}
