+
+// Hegel property-based tests for `Simplify`.
+#[cfg(test)]
+mod hegel_props {
+    use hegel::generators;
+    use hegel::Generator;
+    use i_float::int::point::IntPoint;
+    use i_overlay::core::fill_rule::FillRule;
+    use i_overlay::core::simplify::Simplify;
+    use i_shape::int::shape::{IntContour, IntShapes};
+
+    fn draw_contours(tc: &hegel::TestCase, max_contours: usize) -> Vec<IntContour<i32>> {
+        const M: i32 = (1 << 30) - 1;
+        let regime = tc.draw(generators::integers::<u8>().max_value(2));
+        let (lo, hi) = match regime {
+            0 => (0, 6),
+            1 => (-1000, 1000),
+            _ => (-M, M),
+        };
+        let n_contours = tc.draw(generators::integers::<usize>().max_value(max_contours));
+        let mut contours = Vec::with_capacity(n_contours);
+        for _ in 0..n_contours {
+            let n_points = tc.draw(generators::integers::<usize>().max_value(8));
+            let mut contour = Vec::with_capacity(n_points);
+            for _ in 0..n_points {
+                let x = tc.draw(generators::integers::<i32>().min_value(lo).max_value(hi));
+                let y = tc.draw(generators::integers::<i32>().min_value(lo).max_value(hi));
+                contour.push(IntPoint::new(x, y));
+            }
+            contours.push(contour);
+        }
+        contours
+    }
+
+    /// Canonical form for comparing results independent of contour start point,
+    /// hole order, and shape order (outer contour stays first within a shape).
+    fn canon(shapes: &IntShapes<i32>) -> IntShapes<i32> {
+        let mut out: IntShapes<i32> = shapes
+            .iter()
+            .map(|shape| {
+                let mut s: Vec<IntContour<i32>> = shape.iter().map(|c| rotate_to_min(c)).collect();
+                if s.len() > 2 {
+                    s[1..].sort();
+                }
+                s
+            })
+            .collect();
+        out.sort();
+        out
+    }
+
+    fn rotate_to_min(contour: &[IntPoint<i32>]) -> IntContour<i32> {
+        if contour.is_empty() {
+            return Vec::new();
+        }
+        let k = contour
+            .iter()
+            .enumerate()
+            .min_by_key(|(_, p)| **p)
+            .map(|(i, _)| i)
+            .unwrap();
+        contour[k..].iter().chain(contour[..k].iter()).copied().collect()
+    }
+
+    // KNOWN FAILURE (zoo, i_overlay/4): `simplify` with `FillRule::Negative` returns a single
+    // clockwise contour unreversed (contour_direction's Negative + clockwise fast path is
+    // `Correct`), although outputs are documented as outer = counterclockwise; a second pass
+    // under EvenOdd flips it. Deterministic pin of the counterexample the property found.
+    #[test]
+    fn hegel_pin_simplify_negative_returns_clockwise_outer() {
+        let contours: Vec<IntContour<i32>> =
+            vec![vec![IntPoint::new(0, 0), IntPoint::new(0, 1), IntPoint::new(1, 0)]];
+        let once: IntShapes<i32> = contours.as_slice().simplify(FillRule::Negative, Default::default());
+        let twice = once.as_slice().simplify(FillRule::EvenOdd, Default::default());
+        assert_eq!(canon(&twice), canon(&once), "once={once:?} twice={twice:?}");
+    }
+
+    // Property: an already-simplified result is a fixed point of `simplify`.
+    // The first pass may use any fill rule; its output is oriented (outer CCW /
+    // holes CW with default options), so re-simplifying under EvenOdd or NonZero
+    // must return it unchanged.
+    #[hegel::test]
+    fn hegel_simplify_is_idempotent(tc: hegel::TestCase) {
+        let contours = draw_contours(&tc, 4);
+        let fill = tc.draw((generators::sampled_from(vec![
+            FillRule::EvenOdd,
+            FillRule::NonZero,
+            FillRule::Positive,
+            FillRule::Negative,
+        ])).print_as_debug());
+
+        let once: IntShapes<i32> = contours.as_slice().simplify(fill, Default::default());
+        let once_c = canon(&once);
+
+        for second_fill in [FillRule::EvenOdd, FillRule::NonZero] {
+            let twice = once.as_slice().simplify(second_fill, Default::default());
+            assert_eq!(
+                canon(&twice),
+                once_c,
+                "simplify not idempotent, fill={:?} second_fill={:?} contours={:?} once={:?}",
+                fill,
+                second_fill,
+                contours,
+                once
+            );
+        }
+    }
+}
