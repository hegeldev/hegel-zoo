+#[test]
+fn overlapping_literal_parts_do_not_match_twice() {
+    for (glob, value) in [("ab*b", "ab"), ("a*a", "a"), ("*foo*foo", "xfoo"), ("*b*bc", "xbc"), ("a*bc*cd", "abcd")] {
+        assert!(!lintian_glob(glob, value));
+        assert!(!glob_model(glob, value));
+        assert!(!info_matches(glob, value), "info_matches({glob:?}, {value:?})");
+    }
+}
