+    let r = lintian_parse("foo", "binary", "[amd64] some-tag\n");
+    assert!(r.lines.is_empty());
+    assert_eq!(r.errors, vec![1]);
+    let parsed = LintianOverrides::parse("[amd64] some-tag\n");
