+#[test]
+fn a_colon_without_a_space_still_ends_the_package_spec() {
+    // lintian: `foo:tag` is package `foo`, tag `tag` (the colon may follow the
+    // name directly: `(?=\s|:)`).
+    let r = lintian_parse("foo", "binary", "foo:some-tag\n");
+    assert_eq!(r.lines.len(), 1);
+    assert_eq!(r.lines[0].tag, "some-tag");
+    let tree = LintianOverrides::parse("foo:some-tag\n").tree();
+    let line = tree.lines().next().unwrap();
+    assert_eq!(line.package(), Some("foo".to_string()));
+    assert_eq!(line.tag().unwrap().text(), "some-tag");
+}
