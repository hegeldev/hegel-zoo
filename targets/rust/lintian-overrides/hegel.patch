+#[hegel::test]
+fn map_overrides_writes_the_transformed_lines(tc: hegel::TestCase) {
+    let f = tc.draw(arb_file().print_as_debug());
+    let text = f.text();
+    let tree = LintianOverrides::parse(&text).tree();
+    let new_tag = pick(&tc, TAGS).to_string();
+    let new_info = if tc.draw(generators::booleans()) { Some(arb_info(&tc)) } else { None };
+    let new_pkg = if tc.draw(generators::booleans()) { Some(pick(&tc, NAMES).to_string()) } else { None };
+    // The general property keeps the package type with a package name and only
+    // maps lines without an architecture list (both pinned separately).
+    let new_type = if new_pkg.is_some() && tc.draw(generators::booleans()) { Some(pick(&tc, TYPES).to_string()) } else { None };
+    let mapped = map_overrides(&tree, |l| {
+        if l.tag().is_some() && !l.package_spec().map_or(false, |s| s.has_arch_list()) {
+            Some((new_pkg.clone(), new_type.clone(), new_tag.clone(), new_info.clone()))
+        } else {
+            None
+        }
+    });
+    let old: Vec<OverrideLine> = tree.lines().collect();
+    let new: Vec<OverrideLine> = mapped.lines().collect();
+    assert_eq!(old.len(), new.len());
+    for (o, n) in old.iter().zip(new.iter()) {
+        if o.tag().is_some() && !o.package_spec().map_or(false, |s| s.has_arch_list()) {
+            assert_eq!(n.tag().map(|t| t.text().to_string()), Some(new_tag.clone()));
+            assert_eq!(n.info(), new_info);
+            assert_eq!(n.package(), new_pkg);
+            assert_eq!(n.package_type(), new_type);
+        } else {
+            assert_eq!(n.text(), o.text(), "untransformed lines are verbatim");
+        }
+    }
+    let reparsed = LintianOverrides::parse(&mapped.text());
+    let tagless = f.lines.iter().filter(|l| matches!(l, Line::Tagless(_))).count();
+    assert_eq!(reparsed.errors().len(), tagless, "only the untransformed tagless lines are errors");
+    assert!(mapped.tree_eq(&reparsed.tree()), "the mapped tree is the parse of its text");
+}
