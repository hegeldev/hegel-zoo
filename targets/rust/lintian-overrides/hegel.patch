+#[test]
+fn whitespace_before_a_bare_type_colon_is_kept() {
+    // The lexer drops the whitespace between a bare type keyword and its colon,
+    // so the "format-preserving" tree renders differently from its source.
+    for text in ["source : some-tag\n", "binary\t: some-tag x\n", " udeb  :\n"] {
+        let tree = LintianOverrides::parse(text).tree();
+        assert_eq!(tree.text(), text);
+    }
+}
