+//! Hegel property tests for lintian-overrides, against lintian itself.
+//!
+//! The reference is lintian's own override parser and glob matcher —
+//! `Lintian::Processable::Overrides::parse_overrides` (applied to a fake
+//! processable with the generated package name and type) and
+//! `Lintian::Util::match_glob` (Regexp::Wildcards, "jokers") — driven as a
+//! persistent Perl child; plus the generators' own model of the line grammar
+//! from the lintian manual: `[[<package>][ <archlist>][ <type>]: ]<tag>[ <context>]`.
+
+use hegel::generators;
+use hegel::Generator;
+use lintian_overrides::*;
+use rowan::TextSize;
+use std::fmt::Debug;
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::sync::{Mutex, OnceLock};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+// ---------------------------------------------------------------------------
+// Oracle: lintian
+// ---------------------------------------------------------------------------
+
+const PERL_SCRIPT: &str = r#"
+use v5.20; use warnings;
+use lib '/usr/share/lintian/lib';
+package FakeFile { use Moo; sub pointer { my ($s, $p) = @_; return $p } }
+package Fake {
+    use Moo;
+    has name => (is => 'rw');
+    has type => (is => 'rw');
+    has override_file => (is => 'rw', default => sub { FakeFile->new });
+    with 'Lintian::Processable::Overrides';
+}
+package main;
+use JSON::PP;
+use Lintian::Util qw(match_glob);
+my $json = JSON::PP->new->canonical;
+$| = 1;
+while (my $line = <STDIN>) {
+    chomp $line;
+    my ($cmd, @args) = split / /, $line;
+    my @a = map { pack('H*', $_) } @args;
+    if ($cmd eq 'P') {
+        my ($name, $type, $text) = @a;
+        my $p = Fake->new(name => $name, type => $type);
+        my $r = $p->parse_overrides($text);
+        my @lines = map { { tag => $_->tag_name, arch => $_->architectures, pattern => $_->pattern,
+                            just => $_->justification, pos => $_->position } } @$r;
+        my @errors = map { { message => $_->{message}, pos => $_->{pointer} } } @{$p->override_errors};
+        print $json->encode({ lines => \@lines, errors => \@errors }), "\n";
+    } elsif ($cmd eq 'G') {
+        my ($glob, $value) = @a;
+        my @m = match_glob($glob, $value);
+        print $json->encode({ m => (@m ? 1 : 0) }), "\n";
+    } else {
+        print "{}\n";
+    }
+}
+"#;
+
+struct Child2 {
+    _child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+fn spawn(program: &str, args: &[&str]) -> Child2 {
+    let mut child = Command::new(program)
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap_or_else(|e| panic!("cannot start {program}: {e}"));
+    let stdin = child.stdin.take().unwrap();
+    let stdout = BufReader::new(child.stdout.take().unwrap());
+    Child2 { _child: child, stdin, stdout }
+}
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|b| format!("{b:02x}")).collect()
+}
+
+fn ask(c: &mut Child2, cmd: &str, args: &[&str]) -> serde_json::Value {
+    let mut line = cmd.to_string();
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a));
+    }
+    writeln!(c.stdin, "{line}").unwrap();
+    c.stdin.flush().unwrap();
+    let mut reply = String::new();
+    c.stdout.read_line(&mut reply).unwrap();
+    assert!(!reply.is_empty(), "{cmd}: oracle child died");
+    serde_json::from_str(&reply).unwrap_or_else(|e| panic!("bad oracle reply {reply:?}: {e}"))
+}
+
+fn perl() -> &'static Mutex<Child2> {
+    static P: OnceLock<Mutex<Child2>> = OnceLock::new();
+    P.get_or_init(|| Mutex::new(spawn("perl", &["-e", PERL_SCRIPT])))
+}
+
+#[derive(Debug, Clone, PartialEq)]
+struct LintianOverride {
+    tag: String,
+    arch: Vec<String>,
+    pattern: String,
+    justification: String,
+    position: usize,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+struct LintianParse {
+    lines: Vec<LintianOverride>,
+    /// 1-based line numbers of the malformed lines.
+    errors: Vec<usize>,
+}
+
+/// lintian's `parse_overrides` for a processable named `name` of type `ptype`.
+fn lintian_parse(name: &str, ptype: &str, text: &str) -> LintianParse {
+    let mut c = perl().lock().unwrap_or_else(|e| e.into_inner());
+    let v = ask(&mut c, "P", &[name, ptype, text]);
+    let lines = v["lines"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|l| LintianOverride {
+            tag: l["tag"].as_str().unwrap().to_string(),
+            arch: l["arch"].as_array().unwrap().iter().map(|a| a.as_str().unwrap().to_string()).collect(),
+            pattern: l["pattern"].as_str().unwrap().to_string(),
+            justification: l["just"].as_str().unwrap().to_string(),
+            position: l["pos"].as_u64().unwrap() as usize,
+        })
+        .collect();
+    let errors = v["errors"].as_array().unwrap().iter().map(|e| e["pos"].as_u64().unwrap() as usize).collect();
+    LintianParse { lines, errors }
+}
+
+/// lintian's `match_glob(glob, value)`.
+fn lintian_glob(glob: &str, value: &str) -> bool {
+    let mut c = perl().lock().unwrap_or_else(|e| e.into_inner());
+    ask(&mut c, "G", &[glob, value])["m"].as_u64().unwrap() == 1
+}
+
+// ---------------------------------------------------------------------------
+// Model and generators
+// ---------------------------------------------------------------------------
+
+fn pick<T: Clone + Send + Sync + Debug + 'static>(tc: &hegel::TestCase, items: &[T]) -> T {
+    tc.draw(generators::sampled_from(items.to_vec()).print_as_debug())
+}
+
+const NAMES: &[&str] = &["foo", "libfoo-dev", "bar1", "python3-baz", "a.b"];
+const TAGS: &[&str] = &["some-tag", "x-y", "tag2", "T", "source-is-missing", "unusual-interpreter"];
+const TYPES: &[&str] = &["source", "binary", "udeb"];
+const ARCHES: &[&str] = &["amd64", "!i386", "any-i386", "!linux-any", "all", "arm64"];
+const INFO_WORDS: &[&str] = &[
+    "a", "b:c", "[debian/rules:3]", "*.js", "x?y", "usr/share/doc", "51:", "*", "binary", "foo", "#", "(", "]", "\\*",
+];
+const COMMENTS: &[&str] = &["# a comment", "#", "#foo: bar", "# some-tag x"];
+
+fn ws(tc: &hegel::TestCase) -> String {
+    pick(tc, &[" ", "  ", "\t", " \t"]).to_string()
+}
+
+#[derive(Debug, Clone, PartialEq)]
+struct Spec {
+    name: bool,
+    arch: Option<Vec<String>>,
+    ptype: bool,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+enum Line {
+    Empty(String),
+    Comment(String, String),
+    /// A spec with nothing after the colon: malformed for both parsers.
+    Tagless(Spec),
+    Override { spec: Option<Spec>, tag: String, info: Option<String> },
+}
+
+#[derive(Debug, Clone)]
+struct GenFile {
+    name: String,
+    ptype: String,
+    lines: Vec<Line>,
+    /// Rendered text of each line (without the newline).
+    texts: Vec<String>,
+    trailing_newline: bool,
+}
+
+impl GenFile {
+    fn text(&self) -> String {
+        let mut s = self.texts.join("\n");
+        if self.trailing_newline {
+            s.push('\n');
+        }
+        s
+    }
+}
+
+#[hegel::composite]
+fn arb_spec(tc: &hegel::TestCase) -> Spec {
+    let name = tc.draw(generators::booleans());
+    let arch = if tc.draw(generators::booleans()) {
+        let n = tc.draw(int!(0, 3)) as usize;
+        Some((0..n).map(|_| pick(tc, ARCHES).to_string()).collect())
+    } else {
+        None
+    };
+    let ptype = tc.draw(generators::booleans());
+    Spec { name, arch, ptype }
+}
+
+fn render_spec(tc: &hegel::TestCase, spec: &Spec, name: &str, ptype: &str) -> String {
+    let mut parts: Vec<String> = Vec::new();
+    if spec.name {
+        parts.push(name.to_string());
+    }
+    if let Some(arch) = &spec.arch {
+        let inner = if arch.is_empty() {
+            String::new()
+        } else {
+            let mut s = String::new();
+            if tc.draw(generators::booleans()) {
+                s.push(' ');
+            }
+            s.push_str(&arch.join(&ws(tc)));
+            if tc.draw(generators::booleans()) {
+                s.push(' ');
+            }
+            s
+        };
+        parts.push(format!("[{inner}]"));
+    }
+    if spec.ptype {
+        parts.push(ptype.to_string());
+    }
+    let mut s = String::new();
+    for (i, p) in parts.iter().enumerate() {
+        if i > 0 {
+            s.push_str(&ws(tc));
+        }
+        s.push_str(p);
+    }
+    // Whitespace before the colon of a bare type keyword is pinned separately
+    // (`whitespace_before_a_bare_type_colon_is_kept`).
+    if (spec.name || spec.arch.is_some()) && tc.draw(int!(0, 3)) == 0 {
+        s.push_str(&ws(tc));
+    }
+    s.push(':');
+    s
+}
+
+fn arb_info(tc: &hegel::TestCase) -> String {
+    let n = tc.draw(int!(1, 3)) as usize;
+    (0..n).map(|_| pick(tc, INFO_WORDS).to_string()).collect::<Vec<_>>().join(" ")
+}
+
+#[hegel::composite]
+fn arb_file(tc: &hegel::TestCase) -> GenFile {
+    let name = pick(tc, NAMES).to_string();
+    let ptype = pick(tc, TYPES).to_string();
+    let n = tc.draw(int!(0, 6)) as usize;
+    let mut lines = Vec::new();
+    let mut texts = Vec::new();
+    for _ in 0..n {
+        let kind = tc.draw(int!(0, 9));
+        let lead = if tc.draw(int!(0, 3)) == 0 { ws(tc) } else { String::new() };
+        let (line, text) = match kind {
+            0 => (Line::Empty(lead.clone()), lead.clone()),
+            1 | 2 => {
+                let c = pick(tc, COMMENTS).to_string();
+                (Line::Comment(lead.clone(), c.clone()), format!("{lead}{c}"))
+            }
+            3 => {
+                // A spec must have at least one part to be a spec at all.
+                let mut spec = tc.draw(arb_spec().print_as_debug());
+                if !spec.name && spec.arch.is_none() && !spec.ptype {
+                    spec.name = true;
+                }
+                let s = render_spec(tc, &spec, &name, &ptype);
+                let tail = if tc.draw(generators::booleans()) { ws(tc) } else { String::new() };
+                (Line::Tagless(spec), format!("{lead}{s}{tail}"))
+            }
+            _ => {
+                let spec = if tc.draw(generators::booleans()) {
+                    let mut spec = tc.draw(arb_spec().print_as_debug());
+                    if !spec.name && spec.arch.is_none() && !spec.ptype {
+                        spec.name = true;
+                    }
+                    Some(spec)
+                } else {
+                    None
+                };
+                let tag = pick(tc, TAGS).to_string();
+                let info = if tc.draw(generators::booleans()) { Some(arb_info(tc)) } else { None };
+                let mut text = lead.clone();
+                if let Some(spec) = &spec {
+                    text.push_str(&render_spec(tc, spec, &name, &ptype));
+                    text.push_str(&ws(tc));
+                }
+                text.push_str(&tag);
+                if let Some(info) = &info {
+                    text.push_str(&ws(tc));
+                    text.push_str(info);
+                }
+                if tc.draw(int!(0, 3)) == 0 {
+                    text.push_str(&ws(tc));
+                }
+                (Line::Override { spec, tag, info }, text)
+            }
+        };
+        lines.push(line);
+        texts.push(text);
+    }
+    // A trailing empty line is only a line when a newline follows it.
+    let trailing_newline = !lines.is_empty()
+        && (tc.draw(generators::booleans()) || matches!(lines.last(), Some(Line::Empty(s)) if s.is_empty()));
+    GenFile { name, ptype, lines, texts, trailing_newline }
+}
+
+/// The common ground of the crate's raw info and lintian's pattern:
+/// trimmed, inner whitespace collapsed.
+fn norm(s: &str) -> String {
+    s.split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+// ---------------------------------------------------------------------------
+// Parsing against lintian and the model
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn files_are_read_like_lintian(tc: hegel::TestCase) {
+    let f = tc.draw(arb_file().print_as_debug());
+    let text = f.text();
+    let parsed = LintianOverrides::parse(&text);
+    let tree = parsed.tree();
+    let ours: Vec<OverrideLine> = tree.lines().collect();
+    assert_eq!(ours.len(), f.lines.len(), "one OVERRIDE_LINE node per line");
+
+    let ref_parse = lintian_parse(&f.name, &f.ptype, &text);
+
+    let mut ref_lines = ref_parse.lines.iter();
+    let mut expected_error_lines = Vec::new();
+    for (i, (line, model)) in ours.iter().zip(f.lines.iter()).enumerate() {
+        match model {
+            Line::Empty(_) => {
+                assert!(line.is_empty(), "line {i}: empty");
+                assert!(!line.is_comment());
+                assert!(line.tag().is_none());
+                assert!(line.package_spec().is_none());
+            }
+            Line::Comment(_, _) => {
+                assert!(line.is_comment(), "line {i}: comment");
+                assert!(!line.is_empty());
+                assert!(line.tag().is_none());
+                assert!(line.package_spec().is_none());
+            }
+            Line::Tagless(spec) => {
+                expected_error_lines.push(i + 1);
+                assert!(line.tag().is_none(), "line {i}: no tag on a tagless spec");
+                check_spec(line, spec, &f);
+            }
+            Line::Override { spec, tag, info } => {
+                let r = ref_lines.next().unwrap_or_else(|| panic!("line {i}: lintian has no override here"));
+                assert_eq!(r.position, i + 1, "lintian's line number");
+                assert_eq!(line.tag().map(|t| t.text().to_string()), Some(tag.clone()), "line {i}: tag");
+                assert_eq!(r.tag, *tag, "line {i}: lintian's tag");
+                assert_eq!(norm(&line.info().unwrap_or_default()), info.as_deref().map(norm).unwrap_or_default(), "line {i}: info");
+                assert_eq!(r.pattern, info.as_deref().map(norm).unwrap_or_default(), "line {i}: lintian's pattern");
+                assert_eq!(line.info().is_some(), info.is_some(), "line {i}: info presence");
+                match spec {
+                    Some(spec) => {
+                        check_spec(line, spec, &f);
+                        assert_eq!(r.arch, spec.arch.clone().unwrap_or_default(), "line {i}: lintian's architectures");
+                    }
+                    None => {
+                        assert!(line.package_spec().is_none(), "line {i}: no spec");
+                        assert!(!line.has_colon());
+                        assert!(r.arch.is_empty());
+                    }
+                }
+                assert!(!line.is_comment() && !line.is_empty());
+            }
+        }
+    }
+    assert!(ref_lines.next().is_none(), "lintian read more overrides than the model has");
+
+    // Errors: exactly the tagless lines, for both.
+    assert_eq!(ref_parse.errors, expected_error_lines, "lintian's malformed lines");
+    let line_starts: Vec<usize> = {
+        let mut v = Vec::new();
+        let mut off = 0;
+        for t in &f.texts {
+            v.push(off);
+            off += t.len() + 1;
+        }
+        v
+    };
+    let our_errors: Vec<usize> = parsed
+        .errors_with_offsets()
+        .map(|(_, off)| line_starts.iter().position(|&s| s == usize::from(off)).map(|p| p + 1).unwrap_or(0))
+        .collect();
+    assert_eq!(our_errors, expected_error_lines, "the crate's malformed lines (by offset)");
+    assert_eq!(parsed.errors().len(), expected_error_lines.len());
+    assert_eq!(parsed.clone().ok().is_ok(), expected_error_lines.is_empty(), "ok() iff no errors");
+}
+
+fn check_spec(line: &OverrideLine, spec: &Spec, f: &GenFile) {
+    let s = line.package_spec().expect("a package spec");
+    assert!(line.has_colon());
+    assert_eq!(s.package_name(), spec.name.then(|| f.name.clone()), "package name");
+    assert_eq!(line.package(), spec.name.then(|| f.name.clone()));
+    assert_eq!(s.package_type(), spec.ptype.then(|| f.ptype.clone()), "package type");
+    assert_eq!(line.package_type(), spec.ptype.then(|| f.ptype.clone()));
+    assert_eq!(s.has_arch_list(), spec.arch.is_some(), "arch list presence");
+    assert_eq!(s.arch_list(), spec.arch.clone().unwrap_or_default(), "arch list");
+}
+
+#[hegel::test]
+fn the_tree_is_lossless(tc: hegel::TestCase) {
+    let f = tc.draw(arb_file().print_as_debug());
+    let text = f.text();
+    let parsed = LintianOverrides::parse(&text);
+    let tree = parsed.tree();
+    assert_eq!(tree.text(), text);
+    assert_eq!(tree.to_string(), text);
+    assert_eq!(tree.syntax_node().text().to_string(), text);
+    for (line, t) in tree.lines().zip(f.texts.iter()) {
+        assert_eq!(line.text(), *t, "line text");
+        let r = line.text_range();
+        assert_eq!(&text[usize::from(r.start())..usize::from(r.end())], t, "line range");
+    }
+    // Snapshots are equal until the tree changes.
+    let snap = tree.snapshot();
+    assert!(tree.tree_eq(&snap));
+    assert!(snap.tree_eq(&tree));
+    assert_eq!(snap.text(), text);
+    let other = LintianOverrides::parse(&format!("{text}z-tag\n")).tree();
+    assert!(!tree.tree_eq(&other));
+}
+
+/// Any text at all round-trips, including CR, unterminated brackets and
+/// odd whitespace; `tree()` is always available.
+#[hegel::test]
+fn any_text_round_trips(tc: hegel::TestCase) {
+    let n = tc.draw(int!(0, 12)) as usize;
+    let pieces = [
+        "foo", " ", "\t", "\n", "\r\n", ":", "[", "]", "#", "*", "binary", "source", "some-tag", "[amd64", "]:", ": ", "é",
+    ];
+    let text: String = (0..n).map(|_| pick(&tc, &pieces)).collect();
+    if text.lines().any(bare_type_then_spaced_colon) {
+        return; // the pinned lossless bug (`whitespace_before_a_bare_type_colon_is_kept`)
+    }
+    let parsed = LintianOverrides::parse(&text);
+    let tree = parsed.tree();
+    assert_eq!(tree.text(), text);
+    let n_lines = text.split_inclusive('\n').count();
+    assert_eq!(tree.lines().count(), n_lines, "one line node per source line");
+    for (msg, off) in parsed.errors_with_offsets() {
+        assert!(!msg.is_empty());
+        assert!(usize::from(off) <= text.len());
+    }
+    assert_eq!(parsed.errors().len(), parsed.errors_with_offsets().count());
+}
+
+/// `source :` — a bare type keyword, whitespace, colon: the shape whose
+/// whitespace the lexer drops (pinned).
+fn bare_type_then_spaced_colon(line: &str) -> bool {
+    let t = line.trim_start();
+    PACKAGE_TYPES.iter().any(|k| {
+        t.strip_prefix(k).map_or(false, |r| {
+            let r2 = r.trim_start();
+            r2.len() < r.len() && r2.starts_with(':')
+        })
+    })
+}
+
+/// Whether the literal parts of a `*`-glob share no character (the shape the
+/// crate's matcher gets right; overlapping parts are pinned).
+fn disjoint_parts(glob: &str) -> bool {
+    let mut seen = std::collections::HashSet::new();
+    glob.split('*').all(|part| part.chars().all(|c| seen.insert(c)))
+}
+
+// ---------------------------------------------------------------------------
+// Offsets
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn offsets_follow_the_layout(tc: hegel::TestCase) {
+    let f = tc.draw(arb_file().print_as_debug());
+    let text = f.text();
+    let tree = LintianOverrides::parse(&text).tree();
+    let slice = |r: rowan::TextRange| &text[usize::from(r.start())..usize::from(r.end())];
+    let lines: Vec<OverrideLine> = tree.lines().collect();
+    for (i, line) in lines.iter().enumerate() {
+        let lr = line.text_range();
+        if let Some(t) = line.tag() {
+            assert_eq!(line.tag_range(), Some(t.text_range()));
+            assert_eq!(slice(t.text_range()), t.text(), "tag range");
+            assert!(lr.contains_range(t.text_range()));
+        } else {
+            assert_eq!(line.tag_range(), None);
+        }
+        match (line.info(), line.info_range()) {
+            (Some(info), Some(r)) => {
+                assert_eq!(slice(r), info, "info range");
+                assert!(lr.contains_range(r));
+            }
+            (None, None) => {}
+            (a, b) => panic!("info {a:?} vs info_range {b:?}"),
+        }
+        if let Some(spec) = line.package_spec() {
+            let sr = spec.syntax().text_range();
+            assert!(lr.contains_range(sr));
+            assert!(slice(sr).ends_with(':'), "spec ends with its colon");
+            match (spec.package_type(), spec.package_type_range()) {
+                (Some(t), Some(r)) => assert_eq!(slice(r), t),
+                (None, None) => {}
+                (a, b) => panic!("type {a:?} vs range {b:?}"),
+            }
+            let open = slice(sr).find('[').map(|p| usize::from(sr.start()) + p);
+            let close = slice(sr).find(']').map(|p| usize::from(sr.start()) + p);
+            assert_eq!(open.is_some(), spec.has_arch_list());
+            for o in usize::from(lr.start())..=usize::from(lr.end()) {
+                let off = TextSize::from(o as u32);
+                let inside = match (open, close) {
+                    (Some(op), Some(cl)) => o > op && o <= cl,
+                    _ => false,
+                };
+                assert_eq!(spec.arch_list_contains_offset(off), inside, "arch_list_contains_offset({o})");
+                assert_eq!(spec.contains_offset(off), sr.contains(off), "contains_offset({o})");
+                assert_eq!(
+                    tree.package_name_at_offset(off),
+                    if sr.contains(off) { spec.package_name() } else { None },
+                    "package_name_at_offset({o})"
+                );
+            }
+        } else {
+            for o in usize::from(lr.start())..=usize::from(lr.end()) {
+                assert_eq!(tree.package_name_at_offset(TextSize::from(o as u32)), None);
+            }
+        }
+        // line_at_offset: inclusive at both ends, the first line wins a tie.
+        for o in usize::from(lr.start())..=usize::from(lr.end()) {
+            let off = TextSize::from(o as u32);
+            let found = tree.line_at_offset(off).expect("a line at every offset of a line");
+            let fr = found.text_range();
+            assert!(fr.start() <= off && off <= fr.end());
+            let expect_prev = i > 0 && lines[i - 1].text_range().end() == off;
+            if expect_prev {
+                assert_eq!(found, lines[i - 1], "the previous line wins the shared boundary");
+            } else {
+                assert_eq!(found, *line, "line_at_offset({o})");
+            }
+        }
+    }
+    assert_eq!(tree.line_at_offset(TextSize::from(text.len() as u32 + 1)), None);
+}
