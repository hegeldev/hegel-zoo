+// ---------------------------------------------------------------------------
+// Builder and rewriters
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone)]
+enum Built {
+    Comment(String),
+    Override { pkg: Option<String>, tag: String, info: Option<String> },
+}
+
+#[hegel::composite]
+fn arb_built(tc: &hegel::TestCase) -> Vec<Built> {
+    let n = tc.draw(int!(0, 5)) as usize;
+    (0..n)
+        .map(|_| {
+            if tc.draw(int!(0, 3)) == 0 {
+                Built::Comment(pick(tc, COMMENTS).to_string())
+            } else {
+                Built::Override {
+                    pkg: if tc.draw(generators::booleans()) { Some(pick(tc, NAMES).to_string()) } else { None },
+                    tag: pick(tc, TAGS).to_string(),
+                    info: if tc.draw(generators::booleans()) { Some(arb_info(tc)) } else { None },
+                }
+            }
+        })
+        .collect()
+}
+
+#[hegel::test]
+fn built_files_are_read_back(tc: hegel::TestCase) {
+    let items = tc.draw(arb_built().print_as_debug());
+    let mut b = LintianOverridesBuilder::new();
+    for it in &items {
+        match it {
+            Built::Comment(c) => {
+                b.add_comment(c);
+            }
+            Built::Override { pkg, tag, info } => {
+                b.add_override(pkg.as_deref(), tag, info.as_deref());
+            }
+        }
+    }
+    let built = b.finish();
+    let text = built.text();
+    assert_eq!(text.lines().count(), items.len());
+    assert!(text.is_empty() || text.ends_with('\n'));
+    let parsed = LintianOverrides::parse(&text);
+    assert_eq!(parsed.errors(), &[] as &[String], "built text parses cleanly");
+    let reparsed = parsed.tree();
+    assert!(built.tree_eq(&reparsed), "the built tree is the parse of its text");
+    let live: Vec<OverrideLine> = built.lines().collect();
+    let again: Vec<OverrideLine> = reparsed.lines().collect();
+    assert_eq!(live.len(), items.len());
+    for ((it, l), r) in items.iter().zip(live.iter()).zip(again.iter()) {
+        for line in [l, r] {
+            match it {
+                Built::Comment(_) => {
+                    assert!(line.is_comment());
+                    assert!(line.tag().is_none());
+                }
+                Built::Override { pkg, tag, info } => {
+                    assert_eq!(line.tag().map(|t| t.text().to_string()), Some(tag.clone()));
+                    assert_eq!(line.package(), *pkg);
+                    assert_eq!(line.info(), *info);
+                    assert_eq!(line.package_type(), None);
+                }
+            }
+        }
+    }
+    // lintian reads the overrides the same way (for one package).
+    let overrides: Vec<&Built> = items.iter().filter(|i| matches!(i, Built::Override { .. })).collect();
+    if let Some(name) = overrides.iter().find_map(|i| match i {
+        Built::Override { pkg: Some(p), .. } => Some(p.clone()),
+        _ => None,
+    }) {
+        if overrides.iter().all(|i| matches!(i, Built::Override { pkg, .. } if pkg.as_deref().map_or(true, |p| p == name))) {
+            let r = lintian_parse(&name, "binary", &text);
+            assert!(r.errors.is_empty());
+            let tags: Vec<(String, String)> = r.lines.iter().map(|l| (l.tag.clone(), l.pattern.clone())).collect();
+            let expected: Vec<(String, String)> = overrides
+                .iter()
+                .map(|i| match i {
+                    Built::Override { tag, info, .. } => (tag.clone(), info.as_deref().map(norm).unwrap_or_default()),
+                    _ => unreachable!(),
+                })
+                .collect();
+            assert_eq!(tags, expected, "lintian reads the built file");
+        }
+    }
+}
