+// ---------------------------------------------------------------------------
+// Matching: `matches` and `info_matches` against lintian's glob
+// ---------------------------------------------------------------------------
+
+/// A glob whose literal parts share no character: the shape the crate's
+/// matcher gets right (overlapping parts are pinned separately).
+#[hegel::composite]
+fn arb_disjoint_glob(tc: &hegel::TestCase) -> String {
+    let alphabet = ['a', 'b', 'c', 'd', '/', '.', ':', '[', ']'];
+    let mut free: Vec<char> = alphabet.to_vec();
+    let n_parts = tc.draw(int!(1, 4)) as usize;
+    let mut s = String::new();
+    for i in 0..n_parts {
+        if i > 0 || tc.draw(generators::booleans()) {
+            let stars = tc.draw(int!(1, 2));
+            for _ in 0..stars {
+                s.push('*');
+            }
+        }
+        let len = tc.draw(int!(0, 2)) as usize;
+        for _ in 0..len {
+            if free.is_empty() {
+                break;
+            }
+            let k = tc.draw(int!(0, free.len() as i64 - 1)) as usize;
+            s.push(free.remove(k));
+        }
+    }
+    if tc.draw(generators::booleans()) {
+        s.push('*');
+    }
+    s
+}
+
+fn arb_value(tc: &hegel::TestCase) -> String {
+    let alphabet = ['a', 'b', 'c', 'd', '/', '.', ':', '[', ']', 'x'];
+    let n = tc.draw(int!(0, 6)) as usize;
+    (0..n).map(|_| pick(tc, &alphabet)).collect()
+}
+
+/// A model of lintian's `match_glob` for `*`-only globs.
+fn glob_model(pattern: &str, value: &str) -> bool {
+    fn go(p: &[char], v: &[char]) -> bool {
+        match p.split_first() {
+            None => v.is_empty(),
+            Some(('*', rest)) => (0..=v.len()).any(|k| go(rest, &v[k..])),
+            Some((c, rest)) => v.first() == Some(c) && go(rest, &v[1..]),
+        }
+    }
+    go(&pattern.chars().collect::<Vec<_>>(), &value.chars().collect::<Vec<_>>())
+}
+
+#[hegel::test]
+fn info_matches_is_lintians_glob(tc: hegel::TestCase) {
+    let glob = tc.draw(arb_disjoint_glob());
+    let value = if tc.draw(generators::booleans()) {
+        arb_value(&tc)
+    } else {
+        // A value built from the glob itself: replace each `*` by a short string.
+        let mut v = String::new();
+        for ch in glob.chars() {
+            if ch == '*' {
+                v.push_str(&arb_value(&tc));
+            } else {
+                v.push(ch);
+            }
+        }
+        v
+    };
+    let expected = lintian_glob(&glob, &value);
+    assert_eq!(glob_model(&glob, &value), expected, "the model agrees with lintian on {glob:?} ~ {value:?}");
+    assert_eq!(info_matches(&glob, &value), expected, "info_matches({glob:?}, {value:?})");
+}
