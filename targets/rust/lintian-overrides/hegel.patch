+#[hegel::test]
+fn matches_follows_lintian(tc: hegel::TestCase) {
+    let f = tc.draw(arb_file().print_as_debug());
+    let text = f.text();
+    let tree = LintianOverrides::parse(&text).tree();
+    // A hint for this processable.
+    let hint_tag = pick(&tc, TAGS).to_string();
+    let hint_info = if tc.draw(generators::booleans()) { Some(arb_info(&tc)) } else { None };
+    for (line, model) in tree.lines().zip(f.lines.iter()) {
+        let got = line.matches(Some(&hint_tag), Some(&f.name), Some(&f.ptype), hint_info.as_deref());
+        let expected = match model {
+            Line::Override { tag, info, .. } => {
+                *tag == hint_tag
+                    && match info {
+                        None => true,
+                        Some(pattern) => {
+                            let pattern = norm(pattern);
+                            // The general generator keeps `?` and `\` out of the
+                            // matched patterns (pinned separately).
+                            if pattern.contains('?') || pattern.contains('\\') || !disjoint_parts(&pattern) {
+                                continue;
+                            }
+                            if hint_info.is_none() {
+                                // Pinned: an override with a pattern against a hint without context.
+                                continue;
+                            }
+                            lintian_glob(&pattern, hint_info.as_deref().unwrap_or(""))
+                        }
+                    }
+            }
+            _ => false,
+        };
+        assert_eq!(got, expected, "matches on {:?} for hint {hint_tag} {hint_info:?}", line.text());
+        // A hint for another package or type never matches a spec that names them.
+        if let Line::Override { spec: Some(spec), tag, info: None } = model {
+            if *tag == hint_tag {
+                if spec.name {
+                    assert!(!line.matches(Some(&hint_tag), Some("other-pkg"), Some(&f.ptype), None));
+                }
+                if spec.ptype {
+                    let other = TYPES.iter().find(|t| **t != f.ptype).unwrap();
+                    assert!(!line.matches(Some(&hint_tag), Some(&f.name), Some(other), None));
+                }
+            }
+        }
+    }
+}
