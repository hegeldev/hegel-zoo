+#[hegel::test]
+fn filter_keeps_exactly_the_selected_lines(tc: hegel::TestCase) {
+    let f = tc.draw(arb_file().print_as_debug());
+    let text = f.text();
+    let tree = LintianOverrides::parse(&text).tree();
+    let keep_tag = pick(&tc, TAGS).to_string();
+    let keep_comments = tc.draw(generators::booleans());
+    let pred = |l: &OverrideLine| l.tag().map_or(keep_comments && (l.is_comment() || l.is_empty()), |t| t.text() == keep_tag);
+    let filtered = filter_overrides(&tree, pred);
+    let expected: Vec<String> = tree.lines().filter(|l| pred(l)).map(|l| l.text()).collect();
+    let got: Vec<String> = filtered.lines().map(|l| l.text()).collect();
+    assert_eq!(got, expected, "filtered lines");
+    let expected_text: String = expected.iter().map(|l| format!("{l}\n")).collect();
+    assert_eq!(filtered.text(), expected_text, "one newline per kept line");
+    let reparsed = LintianOverrides::parse(&filtered.text()).tree();
+    assert!(filtered.tree_eq(&reparsed), "the filtered tree is the parse of its text");
+}
