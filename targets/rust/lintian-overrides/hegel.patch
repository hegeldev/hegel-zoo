+#[hegel::test]
+fn rename_tags_changes_only_the_tags(tc: hegel::TestCase) {
+    let f = tc.draw(arb_file().print_as_debug());
+    let text = f.text();
+    let tree = LintianOverrides::parse(&text).tree();
+    let from = pick(&tc, TAGS).to_string();
+    let to = pick(&tc, TAGS).to_string();
+    let renamed = rename_tags(&tree, |t| (t == from).then(|| to.clone()));
+    let old: Vec<OverrideLine> = tree.lines().collect();
+    let new: Vec<OverrideLine> = renamed.lines().collect();
+    assert_eq!(old.len(), new.len());
+    let mut expected_text = String::new();
+    for (o, n) in old.iter().zip(new.iter()) {
+        let ot = o.tag().map(|t| t.text().to_string());
+        let nt = n.tag().map(|t| t.text().to_string());
+        assert_eq!(nt, ot.clone().map(|t| if t == from { to.clone() } else { t }), "tag after rename");
+        assert_eq!(n.info(), o.info());
+        assert_eq!(n.package(), o.package());
+        assert_eq!(n.package_type(), o.package_type());
+        assert_eq!(n.package_spec().map(|s| s.arch_list()), o.package_spec().map(|s| s.arch_list()));
+        assert_eq!(n.is_comment(), o.is_comment());
+        let ot_text = o.text();
+        let expect_line = match (&ot, o.tag_range()) {
+            (Some(t), Some(r)) if *t == from => {
+                let start = usize::from(r.start() - o.text_range().start());
+                format!("{}{}{}", &ot_text[..start], to, &ot_text[start + t.len()..])
+            }
+            _ => ot_text,
+        };
+        assert_eq!(n.text(), expect_line);
+        expected_text.push_str(&expect_line);
+        expected_text.push('\n');
+    }
+    if !f.trailing_newline && !f.texts.is_empty() {
+        expected_text.pop();
+    }
+    assert_eq!(renamed.text(), expected_text, "everything but the tags is verbatim");
+    let reparsed = LintianOverrides::parse(&renamed.text()).tree();
+    assert!(renamed.tree_eq(&reparsed), "the renamed tree is the parse of its text");
+}
