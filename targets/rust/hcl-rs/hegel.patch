+
+mod props {
+    use hcl::Template;
+    use hegel::generators::{self, Generator};
+    use std::str::FromStr;
+
+    /// The template sub-language parser must never panic: arbitrary text and
+    /// template-shaped text (interpolations, directives, strip markers, in
+    /// arbitrary order) either parse or return an error. The same input
+    /// embedded as a quoted attribute value must not panic the main parser
+    /// either.
+    #[hegel::test]
+    fn prop_template_parse_never_panics(tc: hegel::TestCase) {
+        const FRAGMENTS: &[&str] = &[
+            "${", "}", "%{", "~", " if ", " else ", " endif ", " for ", " in ", " endfor ", "x",
+            "a.b", "\"", "\\", "$", "%", "$${", "%%{", " ", "\n", "1", "!", "==", "?", ":", "🦀",
+        ];
+        let input = tc.draw(hegel::one_of!(
+            generators::text().max_size(100).boxed(),
+            generators::vecs(generators::sampled_from(
+                FRAGMENTS.iter().map(|s| (*s).to_string()).collect::<Vec<_>>(),
+            ))
+            .max_size(20)
+            .map(|parts| parts.concat())
+            .boxed(),
+        ));
+        drop(Template::from_str(&input));
+        // The same content as a quoted template expression inside a document
+        // (quotes/newlines in `input` make this invalid HCL — that must
+        // produce an Err, never a panic).
+        drop(hcl::parse(&format!("a = \"{input}\"")));
+    }
