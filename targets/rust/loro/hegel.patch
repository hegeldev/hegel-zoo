+    // ---------- Property 7: LoroMovableList behaves like a Vec (model test) ----------
+
+    struct MovableListVsVec {
+        _doc: LoroDoc,
+        list: LoroMovableList,
+        model: Vec<LoroValue>,
+    }
+
+    #[hegel::state_machine]
+    impl MovableListVsVec {
+        #[rule]
+        fn insert(&mut self, tc: TestCase) {
+            let pos = tc.draw(generators::integers::<usize>().max_value(self.model.len()));
+            let v = draw_value(&tc);
+            self.list.insert(pos, v.clone()).unwrap();
+            self.model.insert(pos, v);
+        }
+
+        #[rule]
+        fn delete(&mut self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let pos = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            let len = tc.draw(
+                generators::integers::<usize>()
+                    .min_value(1)
+                    .max_value(self.model.len() - pos),
+            );
+            self.list.delete(pos, len).unwrap();
+            self.model.drain(pos..pos + len);
+        }
+
+        #[rule]
+        fn set(&mut self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let pos = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            let v = draw_value(&tc);
+            self.list.set(pos, v.clone()).unwrap();
+            self.model[pos] = v;
+        }
+
+        #[rule]
+        fn mov(&mut self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let from = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            let to = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            self.list.mov(from, to).unwrap();
+            let v = self.model.remove(from);
+            self.model.insert(to, v);
+        }
+
+        #[rule]
+        fn push(&mut self, tc: TestCase) {
+            let v = draw_value(&tc);
+            self.list.push(v.clone()).unwrap();
+            self.model.push(v);
+        }
+
+        #[rule]
+        fn pop_agrees(&mut self, _tc: TestCase) {
+            assert_eq!(
+                self.model.pop(),
+                self.list.pop().unwrap().map(|v| v.get_deep_value())
+            );
+        }
+
+        #[rule]
+        fn get_agrees(&self, tc: TestCase) {
+            tc.assume(!self.model.is_empty());
+            let pos = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+            assert_eq!(
+                self.model[pos],
+                self.list.get(pos).unwrap().get_deep_value()
+            );
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _tc: TestCase) {
+            assert_eq!(self.model, self.list.to_vec());
+            assert_eq!(self.model.len(), self.list.len());
+        }
+    }
