+    // ---------- Property 8: LoroMap behaves like a HashMap (model test) ----------
+
+    struct MapVsHashMap {
+        _doc: LoroDoc,
+        map: LoroMap,
+        model: std::collections::HashMap<String, LoroValue>,
+    }
+
+    impl MapVsHashMap {
+        fn draw_existing_key(&self, tc: &TestCase) -> Option<String> {
+            if self.model.is_empty() {
+                return None;
+            }
+            let mut keys: Vec<&String> = self.model.keys().collect();
+            keys.sort();
+            let idx = tc.draw(generators::integers::<usize>().max_value(keys.len() - 1));
+            Some(keys[idx].clone())
+        }
+    }
+
+    #[hegel::state_machine]
+    impl MapVsHashMap {
+        #[rule]
+        fn insert(&mut self, tc: TestCase) {
+            let k = draw_key(&tc);
+            let v = draw_value(&tc);
+            self.map.insert(&k, v.clone()).unwrap();
+            self.model.insert(k, v);
+        }
+
+        #[rule]
+        fn delete_existing(&mut self, tc: TestCase) {
+            let Some(k) = self.draw_existing_key(&tc) else {
+                tc.reject()
+            };
+            self.map.delete(&k).unwrap();
+            self.model.remove(&k);
+        }
+
+        #[rule]
+        fn delete_arbitrary(&mut self, tc: TestCase) {
+            // deleting a key that may not exist must still be Ok and leave
+            // the visible state consistent with the model
+            let k = draw_key(&tc);
+            self.map.delete(&k).unwrap();
+            self.model.remove(&k);
+        }
+
+        #[rule]
+        fn get_agrees(&self, tc: TestCase) {
+            let k = if tc.draw(generators::booleans()) {
+                match self.draw_existing_key(&tc) {
+                    Some(k) => k,
+                    None => draw_key(&tc),
+                }
+            } else {
+                draw_key(&tc)
+            };
+            assert_eq!(
+                self.model.get(&k).cloned(),
+                self.map.get(&k).map(|v| v.get_deep_value())
+            );
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _tc: TestCase) {
+            let expected = serde_json::Value::Object(
+                self.model
+                    .iter()
+                    .map(|(k, v)| (k.clone(), v.to_json_value()))
+                    .collect(),
+            );
+            assert_eq!(expected, self.map.get_value().to_json_value());
+            assert_eq!(self.model.len(), self.map.len());
+            assert_eq!(self.model.is_empty(), self.map.is_empty());
+        }
+    }
+
+    #[hegel::test]
+    fn prop_map_matches_hashmap_model(tc: TestCase) {
+        let doc = LoroDoc::new();
+        let map = doc.get_map("map");
+        hegel::stateful::machine(MapVsHashMap {
+                _doc: doc,
+                map,
+                model: std::collections::HashMap::new(),
+            }).run(tc);
+    }
