+    // Reference semantics for a full-form comparator (explicit major, minor,
+    // and patch), written from the Op documentation in src/lib.rs:
+    //
+    // - `=`, `>`, `>=`, `<`, `<=` compare against I.J.K(-pre) by SemVer
+    //   precedence.
+    // - `~I.J.K` is `>=I.J.K, <I.(J+1).0`: same major and minor, and at
+    //   least I.J.K-pre by precedence.
+    // - `^I.J.K` allows only the parts right of the first nonzero part to
+    //   increase, and requires at least I.J.K-pre by precedence.
+    //
+    // plus the documented pre-release gate (see VersionReq::STAR docs): a
+    // version with a nonempty pre-release only matches if the comparator
+    // carries the identical major.minor.patch and a nonempty pre-release.
+    fn reference_matches(cmp: &Comparator, ver: &Version) -> bool {
+        let minor = cmp.minor.unwrap();
+        let patch = cmp.patch.unwrap();
+        let boundary = Version {
+            major: cmp.major,
+            minor,
+            patch,
+            pre: cmp.pre.clone(),
+            build: BuildMetadata::EMPTY,
+        };
+        let ord = ver.cmp_precedence(&boundary);
+        let op_matches = match cmp.op {
+            Op::Exact => ord == Ordering::Equal,
+            Op::Greater => ord == Ordering::Greater,
+            Op::GreaterEq => ord != Ordering::Less,
+            Op::Less => ord == Ordering::Less,
+            Op::LessEq => ord != Ordering::Greater,
+            Op::Tilde => ver.major == cmp.major && ver.minor == minor && ord != Ordering::Less,
+            Op::Caret => {
+                let compatible = if cmp.major > 0 {
+                    ver.major == cmp.major
+                } else if minor > 0 {
+                    ver.major == 0 && ver.minor == minor
+                } else {
+                    ver.major == 0 && ver.minor == 0 && ver.patch == patch
+                };
+                compatible && ord != Ordering::Less
+            }
+            _ => unreachable!("only the seven documented operators are generated"),
+        };
+        let pre_allowed = ver.pre.is_empty()
+            || (cmp.major == ver.major
+                && cmp.minor == Some(ver.minor)
+                && cmp.patch == Some(ver.patch)
+                && !cmp.pre.is_empty());
+        op_matches && pre_allowed
+    }
