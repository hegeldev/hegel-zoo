 #[test]
 fn test_leading_digit_in_pre_and_build() {
     for op in &["=", ">", ">=", "<", "<=", "~", "^"] {
diff --git a/tests/util/mod.rs b/tests/util/mod.rs
index 9bc1cd7..11a3a84 100644
--- a/tests/util/mod.rs
+++ b/tests/util/mod.rs
@@ -52,3 +52,213 @@ pub(super) fn build_metadata(text: &str) -> BuildMetadata {
 pub(super) fn assert_to_string(value: impl Display, expected: &str) {
     assert_eq!(value.to_string(), expected);
 }
+
+// ---------------------------------------------------------------------------
+// Hegel generator helpers for property-based tests.
+// ---------------------------------------------------------------------------
+
+use hegel::generators;
+
+fn pool(strings: &[&str]) -> Vec<String> {
+    strings.iter().map(|s| (*s).to_string()).collect()
+}
+
+/// A u64 version number: biased toward small values (so that independently
+/// drawn versions/comparators collide), but covering the full u64 range
+/// including 0 and u64::MAX.
+pub(super) fn draw_version_number(tc: &hegel::TestCase) -> u64 {
+    tc.draw(hegel::one_of!(
+        generators::integers::<u64>().max_value(3),
+        generators::integers::<u64>(),
+    ))
+}
+
+/// One valid dot-separated pre-release identifier segment: either a numeric
+/// identifier without leading zeros, or an alphanumeric/hyphen identifier
+/// containing at least one non-digit. A small pool of hand-picked segments is
+/// mixed in so that independently drawn pre-release strings collide and
+/// exercise ordering ties (numeric vs alphanumeric, differing lengths).
+pub(super) fn draw_pre_segment(tc: &hegel::TestCase) -> String {
+    tc.draw(hegel::one_of!(
+        // Numeric identifier: leading zeros are forbidden in pre-release.
+        generators::from_regex("0|[1-9][0-9]{0,30}"),
+        // Alphanumeric identifier: at least one non-digit anywhere.
+        generators::from_regex("[0-9A-Za-z-]{0,8}[A-Za-z-][0-9A-Za-z-]{0,8}"),
+        generators::sampled_from(pool(&[
+            "0", "1", "2", "9", "10", "11", "100", "alpha", "beta", "rc", "a", "b", "A", "-",
+            "a0", "0a", "-1", "1-",
+        ])),
+    ))
+}
+
+/// One valid build metadata segment: any nonempty run of alphanumerics and
+/// hyphens; leading zeros are allowed here, unlike pre-release.
+pub(super) fn draw_build_segment(tc: &hegel::TestCase) -> String {
+    tc.draw(hegel::one_of!(
+        generators::from_regex("[0-9A-Za-z-]{1,10}"),
+        generators::sampled_from(pool(&[
+            "0", "00", "000", "1", "01", "001", "2", "02", "10", "deadbeef", "-", "a", "0a",
+        ])),
+    ))
+}
+
+/// A nonempty dot-separated identifier string built from `segment`.
+pub(super) fn draw_identifier_string(
+    tc: &hegel::TestCase,
+    max_segments: usize,
+    segment: fn(&hegel::TestCase) -> String,
+) -> String {
+    let n = tc.draw(
+        generators::integers::<usize>()
+            .min_value(1)
+            .max_value(max_segments),
+    );
+    let mut segments = Vec::with_capacity(n);
+    for _ in 0..n {
+        segments.push(segment(tc));
+    }
+    segments.join(".")
+}
+
+/// Possibly-empty pre-release, valid by construction.
+pub(super) fn draw_prerelease(tc: &hegel::TestCase) -> Prerelease {
+    if tc.draw(generators::booleans()) {
+        prerelease(&draw_identifier_string(tc, 4, draw_pre_segment))
+    } else {
+        Prerelease::EMPTY
+    }
+}
+
+/// Possibly-empty build metadata, valid by construction.
+pub(super) fn draw_build_metadata(tc: &hegel::TestCase) -> BuildMetadata {
+    if tc.draw(generators::booleans()) {
+        build_metadata(&draw_identifier_string(tc, 4, draw_build_segment))
+    } else {
+        BuildMetadata::EMPTY
+    }
+}
+
+/// An arbitrary structurally-valid Version covering the full field ranges.
+pub(super) fn draw_version(tc: &hegel::TestCase) -> Version {
+    Version {
+        major: draw_version_number(tc),
+        minor: draw_version_number(tc),
+        patch: draw_version_number(tc),
+        pre: draw_prerelease(tc),
+        build: draw_build_metadata(tc),
+    }
+}
+
+/// A Version biased to sit on or near the boundary described by `cmp`, so
+/// that matching properties exercise both sides of every comparison. Also
+/// draws versions unrelated to `cmp`.
+pub(super) fn draw_version_near(tc: &hegel::TestCase, cmp: &Comparator) -> Version {
+    fn near(tc: &hegel::TestCase, n: u64) -> u64 {
+        match tc.draw(generators::integers::<u8>().max_value(4)) {
+            0 => n.saturating_sub(1),
+            1 => n,
+            2 => n.saturating_add(1),
+            _ => draw_version_number(tc),
+        }
+    }
+    let major = near(tc, cmp.major);
+    let minor = near(tc, cmp.minor.unwrap_or(0));
+    let patch = near(tc, cmp.patch.unwrap_or(0));
+    let pre = match tc.draw(generators::integers::<u8>().max_value(3)) {
+        0 => Prerelease::EMPTY,
+        1 => cmp.pre.clone(),
+        2 if !cmp.pre.is_empty() => prerelease(&format!("{}.{}", cmp.pre.as_str(), 0)),
+        _ => draw_prerelease(tc),
+    };
+    Version {
+        major,
+        minor,
+        patch,
+        pre,
+        build: draw_build_metadata(tc),
+    }
+}
+
+/// A single comparator in string form, valid by construction. Covers all
+/// operators (including the implicit default op), wildcard forms (`*`, `x`,
+/// `X`), optional whitespace after the operator, and pre-release/build
+/// metadata on full-form comparators.
+pub(super) fn draw_comparator_string(tc: &hegel::TestCase) -> String {
+    let op = tc.draw(generators::sampled_from(pool(&[
+        "", "=", ">", ">=", "<", "<=", "~", "^",
+    ])));
+    let ws = tc.draw(generators::sampled_from(pool(&["", " ", "  "])));
+    let major = draw_version_number(tc);
+    let mut text = format!("{}{}{}", op, ws, major);
+    let wildcard = |tc: &hegel::TestCase| tc.draw(generators::sampled_from(pool(&["*", "x", "X"])));
+    // Shapes: 0 = I, 1 = I.W, 2 = I.W.W, 3 = I.J, 4 = I.J.W, 5 = I.J.K[-pre][+build]
+    match tc.draw(generators::integers::<u8>().max_value(5)) {
+        0 => {}
+        1 => {
+            text.push('.');
+            text.push_str(&wildcard(tc));
+        }
+        2 => {
+            text.push('.');
+            text.push_str(&wildcard(tc));
+            text.push('.');
+            text.push_str(&wildcard(tc));
+        }
+        3 => {
+            text.push('.');
+            text.push_str(&draw_version_number(tc).to_string());
+        }
+        4 => {
+            text.push('.');
+            text.push_str(&draw_version_number(tc).to_string());
+            text.push('.');
+            text.push_str(&wildcard(tc));
+        }
+        _ => {
+            text.push('.');
+            text.push_str(&draw_version_number(tc).to_string());
+            text.push('.');
+            text.push_str(&draw_version_number(tc).to_string());
+            if tc.draw(generators::booleans()) {
+                text.push('-');
+                text.push_str(&draw_identifier_string(tc, 3, draw_pre_segment));
+            }
+            if tc.draw(generators::booleans()) {
+                text.push('+');
+                text.push_str(&draw_identifier_string(tc, 3, draw_build_segment));
+            }
+        }
+    }
+    text
+}
+
+/// 1..=32 comparators in string form (32 is the documented/enforced maximum
+/// per req), usually few, occasionally many.
+pub(super) fn draw_comparator_strings(tc: &hegel::TestCase) -> Vec<String> {
+    let n = tc.draw(hegel::one_of!(
+        generators::integers::<usize>().min_value(1).max_value(5),
+        generators::integers::<usize>().min_value(1).max_value(32),
+    ));
+    let mut comparators = Vec::with_capacity(n);
+    for _ in 0..n {
+        comparators.push(draw_comparator_string(tc));
+    }
+    comparators
+}
+
+/// A comma separator with optional surrounding whitespace.
+pub(super) fn draw_comma_separator(tc: &hegel::TestCase) -> String {
+    tc.draw(generators::sampled_from(pool(&[", ", ",", " , ", " ,"])))
+}
+
+/// A whole version requirement in string form, valid by construction: either
+/// a standalone wildcard or 1..=32 comma-separated comparators.
+pub(super) fn draw_req_string(tc: &hegel::TestCase) -> String {
+    if tc.draw(generators::integers::<u8>().max_value(9)) == 0 {
+        return tc.draw(generators::sampled_from(pool(&[
+            "*", "x", "X", " *", "* ", " * ",
+        ])));
+    }
+    let separator = draw_comma_separator(tc);
+    draw_comparator_strings(tc).join(&separator)
+}
