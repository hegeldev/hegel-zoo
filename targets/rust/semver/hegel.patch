+use std::cmp::Ordering;
+
+// Display then parse must reproduce the exact Version, for the full field
+// ranges: u64 boundaries in major/minor/patch, numeric and alphanumeric
+// pre-release identifiers, and build metadata (including leading zeros).
+#[hegel::test]
+fn hegel_version_display_parse_roundtrip(tc: hegel::TestCase) {
+    let original = draw_version(&tc);
+    let text = original.to_string();
+    let reparsed = Version::parse(&text)
+        .unwrap_or_else(|err| panic!("failed to re-parse displayed version {:?}: {}", text, err));
+    assert_eq!(original, reparsed);
+    assert_eq!(text, reparsed.to_string());
+}
+
+// Version::parse must never panic, no matter the input (parse robustness).
+#[hegel::test]
+fn hegel_version_parse_never_panics(tc: hegel::TestCase) {
+    let text = tc.draw(hegel::one_of!(
+        generators::text().max_size(30),
+        // Version-like garbage penetrates deeper into the parser than
+        // uniformly random text.
+        generators::from_regex("[0-9a-zA-Z.+*<>=^~ ,xX-]{0,20}"),
+    ));
+    drop(Version::parse(&text));
+}
+
+// Version's documented "total ordering" must actually be a total order:
+// reflexive, antisymmetric, transitive, and consistent with Eq. This
+// exercises the subtle Prerelease and BuildMetadata comparison logic
+// (numeric vs alphanumeric identifiers, differing segment counts, and
+// build metadata's leading-zero ordering like 1 vs 01 vs 001).
+#[hegel::test]
+fn hegel_version_ord_total_order_axioms(tc: hegel::TestCase) {
+    let a = draw_version(&tc);
+    let b = draw_version(&tc);
+    let c = draw_version(&tc);
+    let versions = [&a, &b, &c];
+    for x in versions {
+        assert_eq!(x.cmp(x), Ordering::Equal, "reflexivity: {:?}", x);
+        for y in versions {
+            assert_eq!(
+                x.cmp(y),
+                y.cmp(x).reverse(),
+                "antisymmetry: {:?} vs {:?}",
+                x,
+                y
+            );
+            assert_eq!(
+                *x == *y,
+                x.cmp(y) == Ordering::Equal,
+                "Eq/Ord consistency: {:?} vs {:?}",
+                x,
+                y
+            );
+            for z in versions {
+                if x.cmp(y) != Ordering::Greater && y.cmp(z) != Ordering::Greater {
+                    assert_ne!(
+                        x.cmp(z),
+                        Ordering::Greater,
+                        "transitivity: {:?} <= {:?} <= {:?}",
+                        x,
+                        y,
+                        z
+                    );
+                }
+            }
+        }
+    }
+}
+
+// Reference implementation of pre-release precedence, written directly from
+// the SemVer spec, item 11 (https://semver.org/#spec-item-11):
+// - a version without a pre-release outranks any pre-release;
+// - identifiers are compared left to right, dot-separated;
+// - identifiers consisting of only digits compare numerically (valid numeric
+//   identifiers have no leading zeros, so longer means larger);
+// - numeric identifiers always compare lower than non-numeric ones;
+// - non-numeric identifiers compare in ASCII sort order;
+// - if all shared identifiers are equal, the larger set outranks the smaller.
+fn spec_prerelease_cmp(lhs: &str, rhs: &str) -> Ordering {
+    match (lhs.is_empty(), rhs.is_empty()) {
+        (true, true) => return Ordering::Equal,
+        (true, false) => return Ordering::Greater,
+        (false, true) => return Ordering::Less,
+        (false, false) => {}
+    }
+    let mut lhs = lhs.split('.');
+    let mut rhs = rhs.split('.');
+    loop {
+        let ordering = match (lhs.next(), rhs.next()) {
+            (None, None) => return Ordering::Equal,
+            (None, Some(_)) => return Ordering::Less,
+            (Some(_), None) => return Ordering::Greater,
+            (Some(l), Some(r)) => {
+                let l_numeric = l.bytes().all(|b| b.is_ascii_digit());
+                let r_numeric = r.bytes().all(|b| b.is_ascii_digit());
+                match (l_numeric, r_numeric) {
+                    (true, true) => l.len().cmp(&r.len()).then_with(|| l.cmp(r)),
+                    (true, false) => Ordering::Less,
+                    (false, true) => Ordering::Greater,
+                    (false, false) => l.cmp(r),
+                }
+            }
+        };
+        if ordering != Ordering::Equal {
+            return ordering;
+        }
+    }
+}
+
+// Prerelease ordering must agree with the SemVer spec, item 11.
+#[hegel::test]
+fn hegel_prerelease_order_matches_spec(tc: hegel::TestCase) {
+    let draw_pre_string = |tc: &hegel::TestCase| {
+        if tc.draw(generators::booleans()) {
+            draw_identifier_string(tc, 4, draw_pre_segment)
+        } else {
+            String::new()
+        }
+    };
+    let a = draw_pre_string(&tc);
+    // Bias b toward sharing a prefix with a, so segment-by-segment
+    // comparison gets past the first segment.
+    let b = match tc.draw(generators::integers::<u8>().max_value(3)) {
+        0 => a.clone(),
+        1 if !a.is_empty() => format!("{}.{}", a, draw_pre_segment(&tc)),
+        _ => draw_pre_string(&tc),
+    };
+    let pre_a = prerelease(&a);
+    let pre_b = prerelease(&b);
+    assert_eq!(
+        pre_a.cmp(&pre_b),
+        spec_prerelease_cmp(&a, &b),
+        "prerelease order disagrees with SemVer spec for {:?} vs {:?}",
+        a,
+        b
+    );
+}
+
+// Formatting a Version with width/fill/alignment must behave exactly like
+// formatting its plain string rendering: `Display for Version` implements
+// padding by hand (including a handwritten digit-count calculation), and
+// `format!` on the equivalent &str is an independent oracle for it.
+#[hegel::test]
+fn hegel_version_display_honors_width_format(tc: hegel::TestCase) {
+    let version = draw_version(&tc);
+    let text = version.to_string();
+    let width = tc.draw(generators::integers::<usize>().max_value(50));
+    let kind = tc.draw(generators::integers::<u8>().max_value(6));
+    let (actual, expected) = match kind {
+        0 => (
+            format!("{:w$}", version, w = width),
+            format!("{:w$}", text, w = width),
+        ),
+        1 => (
+            format!("{:<w$}", version, w = width),
+            format!("{:<w$}", text, w = width),
+        ),
+        2 => (
+            format!("{:>w$}", version, w = width),
+            format!("{:>w$}", text, w = width),
+        ),
+        3 => (
+            format!("{:^w$}", version, w = width),
+            format!("{:^w$}", text, w = width),
+        ),
+        4 => (
+            format!("{:*<w$}", version, w = width),
+            format!("{:*<w$}", text, w = width),
+        ),
+        5 => (
+            format!("{:*>w$}", version, w = width),
+            format!("{:*>w$}", text, w = width),
+        ),
+        _ => (
+            format!("{:*^w$}", version, w = width),
+            format!("{:*^w$}", text, w = width),
+        ),
+    };
+    assert_eq!(
+        actual, expected,
+        "width-formatted version differs from width-formatted string, width {}",
+        width
+    );
+}
+
+// Corrupting a valid version string in a way the grammar forbids must make
+// Version::parse return an error: whitespace anywhere, characters outside
+// the identifier alphabet, leading zeros on numeric components (including
+// numeric pre-release identifiers), and empty identifier segments.
+#[hegel::test]
+fn hegel_version_parse_rejects_corruption(tc: hegel::TestCase) {
+    let version = draw_version(&tc);
+    let text = version.to_string();
+    // All generated version strings are ASCII, so any byte index is a char
+    // boundary.
+    let insert_at = |tc: &hegel::TestCase, ch: char| {
+        let mut corrupted = text.clone();
+        let at = tc.draw(generators::integers::<usize>().max_value(text.len()));
+        corrupted.insert(at, ch);
+        corrupted
+    };
+    let corrupted = match tc.draw(generators::integers::<u8>().max_value(4)) {
+        // Whitespace is not allowed anywhere in the version.
+        0 => insert_at(&tc, ' '),
+        // '_' is outside every allowed alphabet.
+        1 => insert_at(&tc, '_'),
+        // Leading zero on the major version number.
+        2 => format!("0{}", text),
+        // An empty identifier segment somewhere: every version string
+        // contains a '.', and ".." is invalid in the numeric core, the
+        // pre-release, and the build metadata alike.
+        3 => text.replacen('.', "..", 1),
+        // Leading zero on a numeric pre-release identifier. Only applicable
+        // if some pre-release segment is numeric; otherwise corrupt the
+        // patch number instead, which is always present.
+        _ => match version
+            .pre
+            .split('.')
+            .position(|segment| !segment.is_empty() && segment.bytes().all(|b| b.is_ascii_digit()))
+        {
+            Some(index) => {
+                let pre = version
+                    .pre
+                    .split('.')
+                    .enumerate()
+                    .map(|(i, segment)| {
+                        if i == index {
+                            format!("0{}", segment)
+                        } else {
+                            segment.to_string()
+                        }
+                    })
+                    .collect::<Vec<_>>()
+                    .join(".");
+                let mut corrupted = format!("{}.{}.{}-{}", version.major, version.minor, version.patch, pre);
+                if !version.build.is_empty() {
+                    corrupted.push('+');
+                    corrupted.push_str(version.build.as_str());
+                }
+                corrupted
+            }
+            None => format!(
+                "{}.{}.0{}",
+                version.major,
+                version.minor,
+                version.patch
+            ),
+        },
+    };
+    assert!(
+        Version::parse(&corrupted).is_err(),
+        "corrupted version string {:?} (from {:?}) unexpectedly parsed",
+        corrupted,
+        text
+    );
+}
+
+// cmp_precedence is documented as comparing major, minor, patch, and
+// pre-release while disregarding build metadata: it must equal Ord::cmp on
+// the build-stripped versions (and in particular report Equal for versions
+// differing only in build metadata).
+#[hegel::test]
+fn hegel_cmp_precedence_ignores_build(tc: hegel::TestCase) {
+    let a = draw_version(&tc);
+    // Bias toward versions that differ only in build metadata.
+    let b = if tc.draw(generators::booleans()) {
+        Version {
+            build: draw_build_metadata(&tc),
+            ..a.clone()
+        }
+    } else {
+        draw_version(&tc)
+    };
+    let strip = |v: &Version| Version {
+        build: BuildMetadata::EMPTY,
+        ..v.clone()
+    };
+    assert_eq!(
+        a.cmp_precedence(&b),
+        strip(&a).cmp(&strip(&b)),
+        "cmp_precedence differs from build-stripped Ord for {:?} vs {:?}",
+        a,
+        b
+    );
+}
