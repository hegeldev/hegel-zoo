+    #[hegel::test]
+    fn hegel_prerelease_match_requires_pre_comparator(tc: hegel::TestCase) {
+        let r = req(&draw_req_string(&tc));
+        let mut ver = if r.comparators.is_empty() {
+            draw_version(&tc)
+        } else {
+            let idx = tc.draw(
+                generators::integers::<usize>().max_value(r.comparators.len() - 1),
+            );
+            draw_version_near(&tc, &r.comparators[idx])
+        };
+        if ver.pre.is_empty() {
+            ver.pre = prerelease(&draw_identifier_string(&tc, 3, draw_pre_segment));
+        }
+        if r.matches(&ver) {
+            assert!(
+                r.comparators.iter().any(|c| c.major == ver.major
+                    && c.minor == Some(ver.minor)
+                    && c.patch == Some(ver.patch)
+                    && !c.pre.is_empty()),
+                "req {} matched pre-release version {} despite having no comparator with \
+                 that exact major.minor.patch and a nonempty pre-release",
+                r,
+                ver
+            );
+        }
+    }
+
+    // Build metadata is documented to play no role in whether a Version
+    // matches a VersionReq.
+    #[hegel::test]
+    fn hegel_matches_ignores_build_metadata(tc: hegel::TestCase) {
+        let r = req(&draw_req_string(&tc));
+        let ver = if r.comparators.is_empty() {
+            draw_version(&tc)
+        } else {
+            let idx = tc.draw(
+                generators::integers::<usize>().max_value(r.comparators.len() - 1),
+            );
+            draw_version_near(&tc, &r.comparators[idx])
+        };
+        let stripped = Version {
+            build: BuildMetadata::EMPTY,
+            ..ver.clone()
+        };
+        let with_other_build = Version {
+            build: draw_build_metadata(&tc),
+            ..ver.clone()
+        };
+        let matched = r.matches(&ver);
+        assert_eq!(matched, r.matches(&stripped), "req {} version {}", r, ver);
+        assert_eq!(
+            matched,
+            r.matches(&with_other_build),
+            "req {} version {} vs {}",
+            r,
+            ver,
+            with_other_build
+        );
+    }
+}
