diff --git a/tests/end_to_end.rs b/tests/end_to_end.rs
index 0848aa7..0ee8372 100644
--- a/tests/end_to_end.rs
+++ b/tests/end_to_end.rs
@@ -658,3 +658,282 @@ fn modify_in_place_with_data() {
         assert_eq!(date.timepart(), 44746);
     }
 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+//
+// These generalize the example-based end-to-end tests above: instead of a
+// fixed set of entries, they draw entry names (including paths, Unicode, and
+// awkward characters), contents, and compression methods, then assert the
+// write→read roundtrip preserves everything.
+// ---------------------------------------------------------------------------
+#[cfg(not(miri))]
+mod hegel_props {
+    use hegel::generators::{self, Generator};
+    use std::io::{Cursor, Read, Write};
+    use zip::write::SimpleFileOptions;
+    use zip::{CompressionMethod, ZipArchive, ZipWriter};
+
+    /// Compression methods that support a full write→read roundtrip with the
+    /// enabled feature set.
+    fn roundtrip_methods() -> Vec<CompressionMethod> {
+        #[allow(unused_mut)]
+        let mut methods = vec![CompressionMethod::Stored];
+        // DEFLATE decompression is unsupported when zopfli is the only backend.
+        #[cfg(all(
+            feature = "_deflate-any",
+            not(all(feature = "deflate-zopfli", not(feature = "deflate-flate2")))
+        ))]
+        methods.push(CompressionMethod::Deflated);
+        #[cfg(feature = "_bzip2_any")]
+        methods.push(CompressionMethod::Bzip2);
+        #[cfg(feature = "zstd")]
+        methods.push(CompressionMethod::Zstd);
+        methods
+    }
+
+    /// A drawn entry name: 1–3 components joined by '/', mixing arbitrary
+    /// Unicode text with hand-picked awkward components. A trailing '/' or
+    /// '\' marks a *directory* entry in the ZIP format (see
+    /// `spec::is_dir`), which is written via `add_directory` rather than
+    /// `start_file`, so those are stripped to stay in the file-entry domain.
+    #[hegel::composite]
+    fn entry_name(tc: &hegel::TestCase) -> String {
+        let awkward = vec![
+            "..", ".", "café", "☃", "🐢", "a b", "-", "#", "it's", "quote\"", "semi;colon",
+            "tab\t", "ẞ", "…", "ends.with.dot.", "\u{202E}rtl",
+        ];
+        let n_components = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+        let mut parts = Vec::with_capacity(n_components);
+        for _ in 0..n_components {
+            parts.push(tc.draw(hegel::one_of!(
+                generators::text().min_size(1).max_size(10).boxed(),
+                generators::sampled_from(awkward.clone())
+                    .map(String::from)
+                    .boxed(),
+            )));
+        }
+        let mut name = parts.join("/");
+        while name.ends_with('/') || name.ends_with('\\') {
+            name.pop();
+        }
+        if name.is_empty() {
+            // Names made only of separators collapse to nothing; substitute a
+            // placeholder so the entry stays a regular file.
+            name.push('_');
+        }
+        name
+    }
+
+    /// Draw a set of archive entries: unique names, 0–1024 bytes of content
+    /// each, and a compression method drawn per entry.
+    #[hegel::composite]
+    fn archive_entries(
+        tc: &hegel::TestCase,
+        min_entries: usize,
+    ) -> Vec<(String, Vec<u8>, CompressionMethod)> {
+        let names: Vec<String> = tc.draw(
+            generators::vecs(entry_name())
+                .min_size(min_entries)
+                .max_size(8)
+                .unique(true),
+        );
+        let methods = roundtrip_methods();
+        names
+            .into_iter()
+            .map(|name| {
+                let data: Vec<u8> = tc.draw(generators::binary().max_size(1024));
+                let method = tc.draw((generators::sampled_from(methods.clone())).print_as_debug());
+                (name, data, method)
+            })
+            .collect()
+    }
+
+    fn build_archive(entries: &[(String, Vec<u8>, CompressionMethod)]) -> Vec<u8> {
+        let mut writer = ZipWriter::new(Cursor::new(Vec::new()));
+        for (name, data, method) in entries {
+            let options = SimpleFileOptions::default().compression_method(*method);
+            writer.start_file(name, options).unwrap();
+            writer.write_all(data).unwrap();
+        }
+        writer.finish().unwrap().into_inner()
+    }
+
+    fn read_entry_by_index(archive: &mut ZipArchive<Cursor<Vec<u8>>>, i: usize) -> Vec<u8> {
+        let mut file = archive.by_index(i).unwrap();
+        let mut contents = Vec::new();
+        file.read_to_end(&mut contents).unwrap();
+        contents
+    }
+
+    /// Crown roundtrip: an archive written with `ZipWriter` reads back with
+    /// `ZipArchive` — the entry count is preserved, and every entry's name
+    /// and bytes are preserved both when iterating by index and when looking
+    /// up by name. Covers the empty archive (0 entries) and empty file
+    /// entries (0 bytes) since both generators go down to zero.
+    #[hegel::test]
+    fn prop_write_read_roundtrip(tc: hegel::TestCase) {
+        let entries = tc.draw((archive_entries(0)).print_as_debug());
+        let bytes = build_archive(&entries);
+        let mut archive =
+            ZipArchive::new(Cursor::new(bytes)).expect("freshly written archive failed to open");
+        assert_eq!(archive.len(), entries.len());
+        assert_eq!(archive.is_empty(), entries.is_empty());
+        // By index: central-directory order matches write order.
+        for (i, (name, data, _)) in entries.iter().enumerate() {
+            {
+                let file = archive.by_index(i).unwrap();
+                assert_eq!(file.name().unwrap().as_ref(), name.as_str());
+            }
+            let contents = read_entry_by_index(&mut archive, i);
+            assert_eq!(&contents, data, "byte mismatch for entry {name:?}");
+        }
+        // By name.
+        for (name, data, _) in &entries {
+            let mut file = archive.by_name(name).unwrap();
+            let mut contents = Vec::new();
+            file.read_to_end(&mut contents).unwrap();
+            assert_eq!(&contents, data, "byte mismatch for by_name({name:?})");
+        }
+    }
+
+    /// `index_for_name`, `name_for_index`, and `file_names` agree with each
+    /// other and with what was written, in write order.
+    #[hegel::test]
+    fn prop_name_lookup_consistency(tc: hegel::TestCase) {
+        let entries = tc.draw((archive_entries(0)).print_as_debug());
+        let bytes = build_archive(&entries);
+        let archive = ZipArchive::new(Cursor::new(bytes)).unwrap();
+        assert_eq!(archive.len(), entries.len());
+        for (i, (name, _, _)) in entries.iter().enumerate() {
+            assert_eq!(archive.index_for_name(name), Some(i), "index_for_name({name:?})");
+            assert_eq!(
+                archive.name_for_index(i).unwrap().unwrap().as_ref(),
+                name.as_str(),
+                "name_for_index({i})"
+            );
+        }
+        let listed: Vec<String> = archive
+            .file_names()
+            .map(|n| n.unwrap().into_owned())
+            .collect();
+        let written: Vec<String> = entries.iter().map(|(n, _, _)| n.clone()).collect();
+        assert_eq!(listed, written);
+    }
+
+    /// Entry metadata read back from the central directory is consistent
+    /// with what was written: uncompressed size, CRC-32 (checked against the
+    /// independent crc32fast oracle), compression method, and file/dir flags.
+    #[hegel::test]
+    fn prop_entry_metadata_consistency(tc: hegel::TestCase) {
+        let entries = tc.draw((archive_entries(0)).print_as_debug());
+        let bytes = build_archive(&entries);
+        let mut archive = ZipArchive::new(Cursor::new(bytes)).unwrap();
+        for (i, (name, data, method)) in entries.iter().enumerate() {
+            let file = archive.by_index(i).unwrap();
+            assert_eq!(file.size(), data.len() as u64, "size() for {name:?}");
+            assert_eq!(
+                file.crc32(),
+                crc32fast::hash(data),
+                "crc32() for {name:?}"
+            );
+            assert_eq!(file.compression(), *method, "compression() for {name:?}");
+            assert!(file.is_file(), "is_file() for {name:?}");
+            assert!(!file.is_dir(), "is_dir() for {name:?}");
+        }
+    }
+
+    /// An archive with zero entries and a drawn comment roundtrips: it
+    /// opens, reports itself empty, and preserves the comment bytes exactly.
+    /// One branch splices an EOCD magic into the comment, since the
+    /// end-of-central-directory record is located by scanning backwards
+    /// through the comment area.
+    #[hegel::test]
+    fn prop_empty_archive_with_comment_roundtrip(tc: hegel::TestCase) {
+        let mut comment: Vec<u8> = tc.draw(generators::binary().max_size(1000));
+        if tc.draw(generators::booleans()) && !comment.is_empty() {
+            // Splice an EOCD signature into the comment to stress the
+            // backwards magic search.
+            let pos = tc.draw(
+                generators::integers::<usize>().max_value(comment.len() - 1),
+            );
+            let magic = b"PK\x05\x06";
+            for (i, b) in magic.iter().enumerate() {
+                if pos + i < comment.len() {
+                    comment[pos + i] = *b;
+                }
+            }
+        }
+        let mut writer = ZipWriter::new(Cursor::new(Vec::new()));
+        writer
+            .set_raw_comment(comment.clone().into_boxed_slice())
+            .unwrap();
+        let bytes = writer.finish().unwrap().into_inner();
+        let archive = ZipArchive::new(Cursor::new(bytes)).unwrap();
+        assert_eq!(archive.len(), 0);
+        assert!(archive.is_empty());
+        assert_eq!(archive.comment(), comment.as_slice());
+    }
+
+    /// The writer rejects a duplicate file name (documented on
+    /// `start_file`: "The file must not have the same name as a file already
+    /// in the archive"), and the archive remains usable with the original
+    /// entry intact.
+    #[hegel::test]
+    fn prop_duplicate_name_rejected(tc: hegel::TestCase) {
+        let entries = tc.draw((archive_entries(1)).print_as_debug());
+        let dup_index =
+            tc.draw(generators::integers::<usize>().max_value(entries.len() - 1));
+        let mut writer = ZipWriter::new(Cursor::new(Vec::new()));
+        for (name, data, method) in &entries {
+            let options = SimpleFileOptions::default().compression_method(*method);
+            writer.start_file(name, options).unwrap();
+            writer.write_all(data).unwrap();
+        }
+        let (dup_name, dup_data, _) = &entries[dup_index];
+        let result = writer.start_file(dup_name, SimpleFileOptions::default());
+        assert!(
+            result.is_err(),
+            "duplicate name {dup_name:?} was accepted by start_file"
+        );
+        let bytes = writer.finish().unwrap().into_inner();
+        let mut archive = ZipArchive::new(Cursor::new(bytes)).unwrap();
+        assert_eq!(archive.len(), entries.len());
+        let mut contents = Vec::new();
+        archive
+            .by_name(dup_name)
+            .unwrap()
+            .read_to_end(&mut contents)
+            .unwrap();
+        assert_eq!(&contents, dup_data);
+    }
+
+    /// A few-hundred-KB entry (larger than any internal buffer) roundtrips
+    /// byte-for-byte under every enabled compression method.
+    #[hegel::test(test_cases = 15)]
+    fn prop_large_entry_roundtrip(tc: hegel::TestCase) {
+        let chunk: Vec<u8> = tc.draw(generators::binary().min_size(1).max_size(64));
+        let total: usize = tc.draw(
+            generators::integers::<usize>()
+                .min_value(200_000)
+                .max_value(400_000),
+        );
+        let mut data = Vec::with_capacity(total + chunk.len());
+        while data.len() < total {
+            data.extend_from_slice(&chunk);
+        }
+        data.truncate(total);
+        let entries: Vec<(String, Vec<u8>, CompressionMethod)> = roundtrip_methods()
+            .into_iter()
+            .enumerate()
+            .map(|(i, method)| (format!("large_{i}"), data.clone(), method))
+            .collect();
+        let bytes = build_archive(&entries);
+        let mut archive = ZipArchive::new(Cursor::new(bytes)).unwrap();
+        assert_eq!(archive.len(), entries.len());
+        for (i, (name, data, _)) in entries.iter().enumerate() {
+            let contents = read_entry_by_index(&mut archive, i);
+            assert_eq!(&contents, data, "byte mismatch for {name:?}");
+        }
+    }
+}
