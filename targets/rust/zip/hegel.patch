+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+//
+// Generalizes the example-based traversal tests above: entry names are drawn
+// from a hostile-name generator (traversal sequences, absolute paths, drive
+// prefixes, NUL bytes, mixed separators, arbitrary Unicode) and the sanitized
+// paths must never be able to escape an extraction root.
+// ---------------------------------------------------------------------------
+#[cfg(not(miri))]
+mod hegel_path_props {
+    use hegel::generators::{self, Generator};
+    use std::io::{Cursor, Write};
+    use std::path::Component;
+    use zip::write::SimpleFileOptions;
+    use zip::{CompressionMethod, ZipArchive, ZipWriter};
+
+    /// A hostile entry name: 1–6 components (biased toward traversal and
+    /// special components) joined by a drawn separator, optionally made
+    /// absolute. May end with a separator (directory entries are part of the
+    /// domain here — sanitization must be safe for them too).
+    #[hegel::composite]
+    fn hostile_name(tc: &hegel::TestCase) -> String {
+        let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(6));
+        let mut parts = Vec::with_capacity(n);
+        for _ in 0..n {
+            parts.push(tc.draw(hegel::one_of!(
+                generators::sampled_from(vec![
+                    "..", ".", "...", "etc", "passwd", "a", "b", "C:", "c:", "~", "$HOME",
+                    ".\u{0}.", "..\u{0}", " ", "..;",
+                ])
+                .map(String::from)
+                .boxed(),
+                generators::text().min_size(1).max_size(6).boxed(),
+            )));
+        }
+        let sep = tc.draw(generators::sampled_from(vec!["/", "\\"]));
+        let mut name = parts.join(sep);
+        if tc.draw(generators::booleans()) {
+            name.insert(0, '/'); // absolute path
+        }
+        name
+    }
+
+    /// Security contract of `ZipFile::enclosed_name` ("It can't resolve to a
+    /// path outside the current directory. It can't be an absolute path")
+    /// and `ZipFile::mangled_name` ("Absolute paths are made relative,
+    /// ParentDirs are ignored"): whatever hostile name is stored in the
+    /// archive, the sanitized path is relative and contains no `..`, root,
+    /// or prefix components, so joining it onto an extraction root can never
+    /// escape that root.
+    #[hegel::test]
+    fn prop_sanitized_names_never_escape(tc: hegel::TestCase) {
+        let names: Vec<String> = tc.draw(
+            generators::vecs(hostile_name())
+                .min_size(1)
+                .max_size(6)
+                .unique(true),
+        );
+        let mut writer = ZipWriter::new(Cursor::new(Vec::new()));
+        let options = SimpleFileOptions::default().compression_method(CompressionMethod::Stored);
+        let mut written = 0usize;
+        for name in &names {
+            // The writer accepts these names (archives found in the wild
+            // contain them); skip any it rejects — the reader-side guarantee
+            // is what's under test.
+            if writer.start_file(name, options).is_ok() {
+                writer.write_all(b"x").unwrap();
+                written += 1;
+            }
+        }
+        tc.assume(written > 0);
+        let bytes = writer.finish().unwrap().into_inner();
+        let mut archive = ZipArchive::new(Cursor::new(bytes)).unwrap();
+        for i in 0..archive.len() {
+            let file = archive.by_index(i).unwrap();
+            let name = file.name().unwrap().into_owned();
+            if let Some(p) = file.enclosed_name() {
+                assert!(
+                    !p.is_absolute(),
+                    "enclosed_name for {name:?} is absolute: {p:?}"
+                );
+                for c in p.components() {
+                    assert!(
+                        matches!(c, Component::Normal(_) | Component::CurDir),
+                        "enclosed_name for {name:?} contains escaping component {c:?}: {p:?}"
+                    );
+                }
+            }
+            let mangled = file.mangled_name().unwrap();
+            assert!(
+                !mangled.is_absolute(),
+                "mangled_name for {name:?} is absolute: {mangled:?}"
+            );
+            for c in mangled.components() {
+                assert!(
+                    matches!(c, Component::Normal(_)),
+                    "mangled_name for {name:?} contains escaping component {c:?}: {mangled:?}"
+                );
+            }
+        }
+    }
+}
