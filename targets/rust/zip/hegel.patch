 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+//
+// The reader's central-directory offsets, sizes, and counts are
+// attacker-controlled input. These properties feed `ZipArchive::new` (and
+// the streaming reader) arbitrary bytes, crafted end-of-central-directory
+// records, and corrupted-but-once-valid archives, asserting the reader
+// returns errors instead of panicking, and that reads stay bounded.
+// ---------------------------------------------------------------------------
+#[cfg(not(miri))]
+mod hegel_robustness_props {
+    use hegel::generators::{self, Generator};
+    use std::io::{self, Cursor, Read, Seek, SeekFrom, Write};
+    use zip::ZipWriter;
+    use zip::read::read_zipfile_from_stream;
+    use zip::write::SimpleFileOptions;
+
+    /// Cap on how many bytes we will decompress from any single entry of an
+    /// untrusted archive. This bound protects the *test's* resources (it
+    /// mirrors MAX_BYTES_TO_READ in fuzz/read); a corrupted length field
+    /// must not make the test itself OOM. It is not a contract of the
+    /// library, so no assertion fires when a (legitimately high-ratio)
+    /// stream reaches it.
+    const MAX_BYTES_TO_READ: u64 = 1 << 24;
+
+    /// Exercise every untrusted-input code path on `bytes`: seek-based
+    /// archive open, per-entry metadata and (capped) decompression, and the
+    /// streaming reader. Everything may fail; nothing may panic.
+    fn drain_untrusted(bytes: &[u8]) {
+        if let Ok(mut archive) = zip::ZipArchive::new(Cursor::new(bytes)) {
+            let _ = archive.comment();
+            let _ = archive.offset();
+            for i in 0..archive.len() {
+                if let Ok(file) = archive.by_index(i) {
+                    let _ = file.name().map(|n| n.into_owned());
+                    let _ = file.enclosed_name();
+                    let _ = file.mangled_name();
+                    let mut limited = file.take(MAX_BYTES_TO_READ);
+                    let _ = io::copy(&mut limited, &mut io::sink());
+                }
+            }
+        }
+        let mut reader = Cursor::new(bytes);
+        let _ = reader.seek(SeekFrom::Start(0));
+        while let Ok(Some(file)) = read_zipfile_from_stream(&mut reader) {
+            let mut limited = file.take(MAX_BYTES_TO_READ);
+            if io::copy(&mut limited, &mut io::sink()).is_err() {
+                break;
+            }
+        }
+    }
+
+    /// A syntactically plausible end-of-central-directory record with fully
+    /// drawn field values, preceded by drawn junk. The entry-count,
+    /// central-directory-size, and central-directory-offset fields are the
+    /// classic attacker-controlled inputs (huge counts, self-referential
+    /// offsets).
+    #[hegel::composite]
+    fn crafted_eocd(tc: &hegel::TestCase) -> Vec<u8> {
+        let mut bytes: Vec<u8> = tc.draw(generators::binary().max_size(256));
+        bytes.extend_from_slice(b"PK\x05\x06");
+        for _ in 0..4 {
+            // disk number, CD start disk, entries on this disk, total entries
+            let v: u16 = tc.draw(generators::integers::<u16>());
+            bytes.extend_from_slice(&v.to_le_bytes());
+        }
+        let cd_size: u32 = tc.draw(generators::integers::<u32>());
+        bytes.extend_from_slice(&cd_size.to_le_bytes());
+        let cd_offset: u32 = tc.draw(generators::integers::<u32>());
+        bytes.extend_from_slice(&cd_offset.to_le_bytes());
+        bytes.extend_from_slice(&0u16.to_le_bytes()); // comment length
+        bytes
+    }
+
+    /// A Zip64 EOCD locator with a drawn (possibly self-referential) u64
+    /// offset, followed by an EOCD full of Zip64 sentinel values so the
+    /// reader takes the Zip64 path.
+    #[hegel::composite]
+    fn crafted_zip64(tc: &hegel::TestCase) -> Vec<u8> {
+        let mut bytes: Vec<u8> = tc.draw(generators::binary().max_size(256));
+        bytes.extend_from_slice(b"PK\x06\x07");
+        bytes.extend_from_slice(&0u32.to_le_bytes()); // disk with zip64 EOCD
+        let offset: u64 = tc.draw(generators::integers::<u64>());
+        bytes.extend_from_slice(&offset.to_le_bytes());
+        bytes.extend_from_slice(&1u32.to_le_bytes()); // total disks
+        bytes.extend_from_slice(b"PK\x05\x06");
+        bytes.extend_from_slice(&[0xFF; 8]); // disks + entry counts: sentinels
+        bytes.extend_from_slice(&[0xFF; 8]); // CD size + offset: sentinels
+        bytes.extend_from_slice(&0u16.to_le_bytes()); // comment length
+        bytes
+    }
+
+    /// Opening and fully (but boundedly) reading ARBITRARY bytes never
+    /// panics, hangs, or reads without bound — errors are the only
+    /// acceptable failure mode.
+    #[hegel::test]
+    fn prop_arbitrary_bytes_never_panic(tc: hegel::TestCase) {
+        let bytes: Vec<u8> = tc.draw(hegel::one_of!(
+            generators::binary().max_size(512).boxed(),
+            crafted_eocd().boxed(),
+            crafted_zip64().boxed(),
+        ));
+        drain_untrusted(&bytes);
+    }
+
+    /// Build a small valid archive, then corrupt it with drawn byte
+    /// overwrites or a truncation. Opening and boundedly reading the result
+    /// may fail but must never panic. Overwrites are biased toward the tail
+    /// of the file, where the EOCD and central directory (the fields that
+    /// drive parsing) live.
+    #[hegel::test(test_cases = 200)]
+    fn prop_corrupted_archive_never_panics(tc: hegel::TestCase) {
+        let n_entries = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+        let mut writer = ZipWriter::new(Cursor::new(Vec::new()));
+        for i in 0..n_entries {
+            let data: Vec<u8> = tc.draw(generators::binary().max_size(256));
+            let method = tc.draw((generators::sampled_from(vec![
+                zip::CompressionMethod::Stored,
+                #[cfg(all(
+                    feature = "_deflate-any",
+                    not(all(feature = "deflate-zopfli", not(feature = "deflate-flate2")))
+                ))]
+                zip::CompressionMethod::Deflated,
+            ])).print_as_debug());
+            writer
+                .start_file(
+                    format!("entry_{i}"),
+                    SimpleFileOptions::default().compression_method(method),
+                )
+                .unwrap();
+            writer.write_all(&data).unwrap();
+        }
+        let mut bytes = writer.finish().unwrap().into_inner();
+
+        let kind: u8 = tc.draw(generators::integers::<u8>().max_value(2));
+        match kind {
+            0 => {
+                // Corrupt 1-8 drawn positions with drawn values, biased
+                // toward the tail (EOCD + central directory).
+                let n_corruptions =
+                    tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+                for _ in 0..n_corruptions {
+                    let tail_start = bytes.len().saturating_sub(128);
+                    let pos = tc.draw(hegel::one_of!(
+                        generators::integers::<usize>().max_value(bytes.len() - 1),
+                        generators::integers::<usize>()
+                            .min_value(tail_start)
+                            .max_value(bytes.len() - 1),
+                    ));
+                    let val: u8 = tc.draw(generators::integers::<u8>());
+                    bytes[pos] = val;
+                }
+            }
+            1 => {
+                // Truncate at a drawn position.
+                let keep = tc.draw(generators::integers::<usize>().max_value(bytes.len()));
+                bytes.truncate(keep);
+            }
+            _ => {
+                // Overwrite drawn EOCD fields with drawn values, keeping the
+                // rest of the archive valid: a plausible archive whose
+                // headers lie about entry counts, central-directory
+                // size/offset, or comment length. The writer emits no
+                // comment, so the EOCD record is the last 22 bytes.
+                let eocd = bytes.len() - 22;
+                assert_eq!(&bytes[eocd..eocd + 4], b"PK\x05\x06");
+                let n_fields = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+                for _ in 0..n_fields {
+                    // (field offset within EOCD, field width in bytes)
+                    let (off, width) = tc.draw(generators::sampled_from(vec![
+                        (4usize, 2usize), // disk number
+                        (6, 2),           // central directory start disk
+                        (8, 2),           // entries on this disk
+                        (10, 2),          // total entries
+                        (12, 4),          // central directory size
+                        (16, 4),          // central directory offset
+                        (20, 2),          // comment length
+                    ]));
+                    if width == 2 {
+                        let v: u16 = tc.draw(generators::integers::<u16>());
+                        bytes[eocd + off..eocd + off + 2].copy_from_slice(&v.to_le_bytes());
+                    } else {
+                        let v: u32 = tc.draw(generators::integers::<u32>());
+                        bytes[eocd + off..eocd + off + 4].copy_from_slice(&v.to_le_bytes());
+                    }
+                }
+            }
+        }
+        drain_untrusted(&bytes);
+    }
+
+    /// Generalization of `test_prepended_garbage` above: the reader
+    /// documents support for archives with prepended content
+    /// (self-extracting archives), so ANY drawn junk prefix must leave the
+    /// entry count, contents, and reported offset intact.
+    #[hegel::test]
+    fn prop_prepended_junk_preserves_contents(tc: hegel::TestCase) {
+        let junk: Vec<u8> = tc.draw(generators::binary().max_size(512));
+        let n_entries = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+        let entries: Vec<(String, Vec<u8>)> = (0..n_entries)
+            .map(|i| {
+                let data: Vec<u8> = tc.draw(generators::binary().max_size(256));
+                (format!("entry_{i}"), data)
+            })
+            .collect();
+        let mut writer = ZipWriter::new(Cursor::new(Vec::new()));
+        for (name, data) in &entries {
+            writer
+                .start_file(name, SimpleFileOptions::default())
+                .unwrap();
+            writer.write_all(data).unwrap();
+        }
+        let archive_bytes = writer.finish().unwrap().into_inner();
+
+        let mut bytes = junk.clone();
+        bytes.extend_from_slice(&archive_bytes);
+        let mut archive = zip::ZipArchive::new(Cursor::new(bytes))
+            .expect("archive with prepended junk failed to open");
+        assert_eq!(archive.len(), entries.len());
+        assert_eq!(archive.offset(), junk.len() as u64);
+        for (name, data) in &entries {
+            let mut file = archive.by_name(name).unwrap();
+            let mut contents = Vec::new();
+            file.read_to_end(&mut contents).unwrap();
+            assert_eq!(&contents, data, "byte mismatch for {name:?}");
+        }
+    }
+}
