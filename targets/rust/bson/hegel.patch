+/// Hegel generators for arbitrary BSON values and documents, used by the
+/// `hegel_*` property-based tests in `raw/test.rs`.
+pub(crate) mod hegel_props {
+    use hegel::generators::{self, BoxedGenerator, Generator};
+
+    use crate::{
+        Binary,
+        Bson,
+        DateTime,
+        DbPointer,
+        Decimal128,
+        Document,
+        JavaScriptCodeWithScope,
+        Regex,
+        Timestamp,
+        oid::ObjectId,
+        spec::BinarySubtype,
+    };
+
+    /// A string usable anywhere BSON requires a cstring (document keys, regex
+    /// patterns/options): arbitrary text with interior NULs mapped away.
+    #[hegel::composite]
+    pub(crate) fn cstring_text(tc: &hegel::TestCase) -> String {
+        // Replacing rather than filtering keeps the rejection rate at zero.
+        tc.draw(generators::text().max_size(12))
+            .replace('\0', "\u{1}")
+    }
+
+    /// Any f64 bit pattern: the usual float distribution plus raw bit patterns
+    /// (covers NaN payloads, -0.0, subnormals).
+    #[hegel::composite]
+    pub(crate) fn any_f64(tc: &hegel::TestCase) -> f64 {
+        tc.draw(hegel::one_of!(
+            generators::floats::<f64>(),
+            generators::integers::<u64>().map(f64::from_bits),
+        ))
+    }
+
+    /// An arbitrary `Binary` value covering every subtype byte (including
+    /// Reserved and UserDefined ranges).
+    #[hegel::composite]
+    pub(crate) fn arbitrary_binary(tc: &hegel::TestCase) -> Binary {
+        let subtype = BinarySubtype::from(tc.draw(generators::integers::<u8>()));
+        let bytes = tc.draw(generators::binary().max_size(24));
+        Binary { subtype, bytes }
+    }
+
+    /// An arbitrary non-container BSON value.
+    ///
+    /// When `allow_decimal128` is false, `Decimal128` values are never
+    /// produced. Extended-JSON round-trips a `Decimal128` through its decimal
+    /// *string* form, which is not a bijection over arbitrary 16-byte payloads
+    /// (non-canonical coefficients, NaN payloads), so the extJSON property
+    /// disables it. The BSON wire round-trip, which is bitwise, keeps it.
+    #[hegel::composite]
+    pub(crate) fn arbitrary_bson_leaf(tc: &hegel::TestCase, allow_decimal128: bool) -> Bson {
+        let choice = tc.draw(generators::integers::<u8>().max_value(15));
+        match choice {
+            0 => Bson::Null,
+            1 => Bson::Boolean(tc.draw(generators::booleans())),
+            2 => Bson::Int32(tc.draw(generators::integers::<i32>())),
+            3 => Bson::Int64(tc.draw(generators::integers::<i64>())),
+            4 => Bson::Double(tc.draw(any_f64())),
+            // BSON strings are length-prefixed, so NULs are legal in values.
+            5 => Bson::String(tc.draw(generators::text().max_size(16))),
+            6 => Bson::Symbol(tc.draw(generators::text().max_size(16))),
+            7 => Bson::JavaScriptCode(tc.draw(generators::text().max_size(16))),
+            8 => Bson::ObjectId(ObjectId::from_bytes(
+                tc.draw(generators::arrays(generators::integers::<u8>())),
+            )),
+            9 => Bson::DateTime(DateTime::from_millis(
+                tc.draw(generators::integers::<i64>()),
+            )),
+            10 => Bson::Timestamp(Timestamp {
+                time: tc.draw(generators::integers::<u32>()),
+                increment: tc.draw(generators::integers::<u32>()),
+            }),
+            11 => Bson::Binary(tc.draw((arbitrary_binary()).print_as_debug())),
+            12 => Bson::RegularExpression(
+                Regex::from_strings(tc.draw(cstring_text()), tc.draw(cstring_text()))
+                    .expect("cstring_text contains no NUL"),
+            ),
+            // Arbitrary 16-byte pattern; binary round-trips are bitwise.
+            13 if allow_decimal128 => Bson::Decimal128(Decimal128::from_bytes(
+                tc.draw(generators::arrays(generators::integers::<u8>())),
+            )),
+            13 => Bson::Null,
+            14 => Bson::DbPointer(DbPointer {
+                namespace: tc.draw(generators::text().max_size(16)),
+                id: ObjectId::from_bytes(tc.draw(generators::arrays(generators::integers::<u8>()))),
+            }),
+            _ => tc.draw((generators::sampled_from(vec![
+                Bson::Undefined,
+                Bson::MinKey,
+                Bson::MaxKey,
+            ])).print_as_debug()),
+        }
+    }
+
+    /// An arbitrary BSON value with containers nested up to `depth` levels.
+    ///
+    /// Recursive, so this returns a boxed generator rather than using
+    /// `#[hegel::composite]` (which cannot be self-referential).
+    pub(crate) fn arbitrary_bson(
+        depth: u32,
+        allow_decimal128: bool,
+    ) -> BoxedGenerator<'static, Bson> {
+        hegel::compose!(|tc| {
+            // Bias toward leaves so documents stay a manageable size.
+            if depth == 0 || tc.draw(generators::integers::<u8>().max_value(2)) > 0 {
+                tc.draw((arbitrary_bson_leaf(allow_decimal128)).print_as_debug())
+            } else {
+                match tc.draw(generators::integers::<u8>().max_value(2)) {
+                    0 => Bson::Document(tc.draw((arbitrary_document(depth - 1, allow_decimal128)).print_as_debug())),
+                    1 => Bson::Array(tc.draw(
+                        (generators::vecs(arbitrary_bson(depth - 1, allow_decimal128)).max_size(6)).print_as_debug(),
+                    )),
+                    _ => Bson::JavaScriptCodeWithScope(JavaScriptCodeWithScope {
+                        code: tc.draw(generators::text().max_size(16)),
+                        scope: tc.draw((arbitrary_document(depth - 1, allow_decimal128)).print_as_debug()),
+                    }),
+                }
+            }
+        })
+        .boxed()
+    }
+
+    /// An arbitrary `Document` with containers nested up to `depth` levels.
+    pub(crate) fn arbitrary_document(
+        depth: u32,
+        allow_decimal128: bool,
+    ) -> BoxedGenerator<'static, Document> {
+        hegel::compose!(|tc| {
+            let pairs: Vec<(String, Bson)> = tc.draw(
+                (generators::vecs(generators::tuples!(
+                    cstring_text(),
+                    arbitrary_bson(depth, allow_decimal128)
+                ))
+                .max_size(6)).print_as_debug(),
+            );
+            let mut doc = Document::new();
+            for (k, v) in pairs {
+                doc.insert(k, v);
+            }
+            doc
+        })
+        .boxed()
+    }
+
+    /// Structural equality on `Bson` that, unlike `PartialEq`, treats doubles
+    /// as equal iff their bit patterns are equal (so NaN == NaN, and NaN
+    /// payloads and the sign of zero must be preserved).
+    pub(crate) fn bson_eq_bitwise(a: &Bson, b: &Bson) -> bool {
+        match (a, b) {
+            (Bson::Double(x), Bson::Double(y)) => x.to_bits() == y.to_bits(),
+            (Bson::Array(x), Bson::Array(y)) => {
+                x.len() == y.len() && std::iter::zip(x, y).all(|(u, v)| bson_eq_bitwise(u, v))
+            }
+            (Bson::Document(x), Bson::Document(y)) => doc_eq_bitwise(x, y),
+            (Bson::JavaScriptCodeWithScope(x), Bson::JavaScriptCodeWithScope(y)) => {
+                x.code == y.code && doc_eq_bitwise(&x.scope, &y.scope)
+            }
+            (x, y) => x == y,
+        }
+    }
+
+    /// See [`bson_eq_bitwise`]. Key order matters.
+    pub(crate) fn doc_eq_bitwise(a: &Document, b: &Document) -> bool {
+        a.len() == b.len()
+            && std::iter::zip(a, b).all(|((ka, va), (kb, vb))| ka == kb && bson_eq_bitwise(va, vb))
+    }
+}
