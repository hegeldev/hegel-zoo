diff --git a/yrs/src/types/text.rs b/yrs/src/types/text.rs
index 5c1e6ee..a4d39d0 100644
--- a/yrs/src/types/text.rs
+++ b/yrs/src/types/text.rs
@@ -2923,4 +2923,145 @@ mod test {
         }
         assert_eq!(ltxt.get_string(&local.transact()), "aaaaaa");
     }
+
+    // === hegel property-based tests ===
+
+    /// Draws a byte index lying on a char boundary of `s` (including `s.len()`).
+    /// [Text] indexes are counted in bytes by default ([OffsetKind::Bytes]) and
+    /// must respect UTF-8 char boundaries, so valid positions are constructed
+    /// directly.
+    fn hegel_char_boundary(tc: &hegel::TestCase, s: &str) -> u32 {
+        use hegel::generators;
+        let mut bounds: Vec<u32> = s.char_indices().map(|(i, _)| i as u32).collect();
+        bounds.push(s.len() as u32);
+        let i = tc.draw(generators::integers::<usize>().max_value(bounds.len() - 1));
+        bounds[i]
+    }
+
+    /// Sends everything `to` hasn't seen yet from `from` (one-directional sync).
+    fn hegel_sync(from: &Doc, to: &Doc) {
+        let sv = to.transact().state_vector();
+        let bin = from.transact().encode_diff_v1(&sv);
+        to.transact_mut()
+            .apply_update(Update::decode_v1(&bin).unwrap())
+            .unwrap();
+    }
+
+    /// Property (CRDT convergence): concurrent insert/remove operations performed
+    /// on multiple replicas converge to the same text once every pair of peers has
+    /// exchanged updates, regardless of operation interleaving and exchange order.
+    /// Evidence: this is the core contract of the library (lib.rs quick start);
+    /// the existing seeded `fuzzy` test checks the same property via `run_scenario`.
+    #[hegel::test]
+    fn hegel_text_concurrent_convergence(tc: hegel::TestCase) {
+        use hegel::generators;
+        const PEERS: usize = 3;
+        let docs: Vec<Doc> = (1..=PEERS as u64).map(Doc::with_client_id).collect();
+        let texts: Vec<_> = docs.iter().map(|d| d.get_or_insert_text("text")).collect();
+
+        let ops = tc.draw(generators::integers::<usize>().max_value(30));
+        for _ in 0..ops {
+            let peer = tc.draw(generators::integers::<usize>().max_value(PEERS - 1));
+            {
+                let doc = &docs[peer];
+                let text = &texts[peer];
+                let mut txn = doc.transact_mut();
+                let s = text.get_string(&txn);
+                if tc.draw(generators::booleans()) || s.is_empty() {
+                    let pos = hegel_char_boundary(&tc, &s);
+                    let chunk: String = tc.draw(generators::text().max_size(8));
+                    text.insert(&mut txn, pos, &chunk);
+                } else {
+                    let a = hegel_char_boundary(&tc, &s);
+                    let b = hegel_char_boundary(&tc, &s);
+                    let (start, end) = (a.min(b), a.max(b));
+                    text.remove_range(&mut txn, start, end - start);
+                }
+            }
+            // occasionally sync a drawn pair mid-run to interleave histories
+            if tc.draw(generators::integers::<u8>().max_value(9)) == 0 {
+                let from = tc.draw(generators::integers::<usize>().max_value(PEERS - 1));
+                let to = tc.draw(generators::integers::<usize>().max_value(PEERS - 1));
+                if from != to {
+                    hegel_sync(&docs[from], &docs[to]);
+                }
+            }
+        }
+
+        // final full pairwise exchange, in a drawn order; every peer receives
+        // every other peer's operations directly, so this must converge
+        let mut pairs: Vec<(usize, usize)> = (0..PEERS)
+            .flat_map(|i| (0..PEERS).filter(move |j| *j != i).map(move |j| (i, j)))
+            .collect();
+        while !pairs.is_empty() {
+            let i = tc.draw(generators::integers::<usize>().max_value(pairs.len() - 1));
+            let (from, to) = pairs.remove(i);
+            hegel_sync(&docs[from], &docs[to]);
+        }
+
+        let reference = texts[0].get_string(&docs[0].transact());
+        let reference_sv = docs[0].transact().state_vector();
+        for i in 1..PEERS {
+            assert_eq!(
+                texts[i].get_string(&docs[i].transact()),
+                reference,
+                "peer {} text diverged",
+                i
+            );
+            assert_eq!(
+                docs[i].transact().state_vector(),
+                reference_sv,
+                "peer {} state vector diverged",
+                i
+            );
+        }
+    }
+
+    /// Stateful model test: a [TextRef] under sequential insert/remove operations
+    /// behaves exactly like a plain [String]. The `len` check is grounded in the
+    /// docs: with the default byte offsets, `len` is "The same as `String::len()`".
+    struct HegelTextModel {
+        doc: Doc,
+        model: String,
+    }
+
+    #[hegel::state_machine]
+    impl HegelTextModel {
+        #[rule]
+        fn insert(&mut self, tc: hegel::TestCase) {
+            use hegel::generators;
+            let pos = hegel_char_boundary(&tc, &self.model);
+            let chunk: String = tc.draw(generators::text().max_size(8));
+            let text = self.doc.get_or_insert_text("text");
+            text.insert(&mut self.doc.transact_mut(), pos, &chunk);
+            self.model.insert_str(pos as usize, &chunk);
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: hegel::TestCase) {
+            let a = hegel_char_boundary(&tc, &self.model);
+            let b = hegel_char_boundary(&tc, &self.model);
+            let (start, end) = (a.min(b), a.max(b));
+            let text = self.doc.get_or_insert_text("text");
+            text.remove_range(&mut self.doc.transact_mut(), start, end - start);
+            self.model.replace_range(start as usize..end as usize, "");
+        }
+
+        #[invariant]
+        fn matches_model(&self, _tc: hegel::TestCase) {
+            let text = self.doc.get_or_insert_text("text");
+            let txn = self.doc.transact();
+            assert_eq!(text.get_string(&txn), self.model);
+            assert_eq!(text.len(&txn) as usize, self.model.len());
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_text_matches_string_model(tc: hegel::TestCase) {
+        let machine = HegelTextModel {
+            doc: Doc::with_client_id(1),
+            model: String::new(),
+        };
+        hegel::stateful::machine(machine).run(tc);
+    }
 }
