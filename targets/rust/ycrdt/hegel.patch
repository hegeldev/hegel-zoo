+
+    // === hegel property-based tests ===
+
+    use crate::updates::decoder::Decode;
+    use crate::updates::encoder::Encode;
+    use crate::{Doc, GetString, ReadTxn, StateVector, Text, Transact, Update};
+
+    /// Performs a drawn sequence of insert/remove operations on `doc`'s "text" root.
+    /// Insert/remove indexes are drawn from valid char boundaries because [Text]
+    /// indexes are counted in bytes (default [crate::OffsetKind::Bytes]) and must
+    /// respect UTF-8 char boundaries.
+    fn hegel_random_text_ops(tc: &hegel::TestCase, doc: &Doc) {
+        use hegel::generators;
+        let text = doc.get_or_insert_text("text");
+        let ops = tc.draw(generators::integers::<usize>().max_value(10));
+        for _ in 0..ops {
+            let mut txn = doc.transact_mut();
+            let s = text.get_string(&txn);
+            let mut bounds: Vec<u32> = s.char_indices().map(|(i, _)| i as u32).collect();
+            bounds.push(s.len() as u32);
+            let bound = |tc: &hegel::TestCase| {
+                bounds[tc.draw(generators::integers::<usize>().max_value(bounds.len() - 1))]
+            };
+            if tc.draw(generators::booleans()) || s.is_empty() {
+                let pos = bound(tc);
+                let chunk: String = tc.draw(generators::text().max_size(8));
+                text.insert(&mut txn, pos, &chunk);
+            } else {
+                let a = bound(tc);
+                let b = bound(tc);
+                let (start, end) = (a.min(b), a.max(b));
+                text.remove_range(&mut txn, start, end - start);
+            }
+        }
+    }
+
+    fn hegel_text_state(doc: &Doc) -> (String, StateVector) {
+        let text = doc.get_or_insert_text("text");
+        let txn = doc.transact();
+        (text.get_string(&txn), txn.state_vector())
+    }
+
+    /// Property: applying the result of [merge_updates_v1] is equivalent to
+    /// applying the merged updates one after another. Evidence: docs say the
+    /// returned binary "is a combination of all input `updates`, compressed".
+    #[hegel::test]
+    fn hegel_merge_updates_v1_equivalent_to_sequential_apply(tc: hegel::TestCase) {
+        // two peers producing concurrent, independent updates
+        let d1 = Doc::with_client_id(1);
+        hegel_random_text_ops(&tc, &d1);
+        let d2 = Doc::with_client_id(2);
+        hegel_random_text_ops(&tc, &d2);
+        let u1 = d1
+            .transact()
+            .encode_state_as_update_v1(&StateVector::default());
+        let u2 = d2
+            .transact()
+            .encode_state_as_update_v1(&StateVector::default());
+
+        let merged = merge_updates_v1([u1.as_slice(), u2.as_slice()]).unwrap();
+
+        let sequential = Doc::with_client_id(3);
+        {
+            let mut txn = sequential.transact_mut();
+            txn.apply_update(Update::decode_v1(&u1).unwrap()).unwrap();
+            txn.apply_update(Update::decode_v1(&u2).unwrap()).unwrap();
+        }
+        let via_merge = Doc::with_client_id(4);
+        via_merge
+            .transact_mut()
+            .apply_update(Update::decode_v1(&merged).unwrap())
+            .unwrap();
+
+        assert_eq!(hegel_text_state(&via_merge), hegel_text_state(&sequential));
+    }
+
+    /// Property: the state vector extracted from a full-state update via
+    /// [encode_state_vector_from_update_v1] equals the state vector of the
+    /// document that produced the update.
+    #[hegel::test]
+    fn hegel_state_vector_from_update_matches_doc(tc: hegel::TestCase) {
+        let doc = Doc::with_client_id(1);
+        hegel_random_text_ops(&tc, &doc);
+        let update = doc
+            .transact()
+            .encode_state_as_update_v1(&StateVector::default());
+        let sv_bin = encode_state_vector_from_update_v1(&update).unwrap();
+        let extracted = StateVector::decode_v1(&sv_bin).unwrap();
+        assert_eq!(extracted, doc.transact().state_vector());
+    }
+
+    /// Property: for a document whose history is split at an arbitrary point,
+    /// applying the prefix update followed by [diff_updates_v1] of the full
+    /// update against the prefix state vector reproduces the full document.
+    /// Evidence: diff_updates_v1 docs - the result "contains all changes from A
+    /// which have not been observed by B (based on its state vector)".
+    #[hegel::test]
+    fn hegel_diff_updates_v1_completes_prefix(tc: hegel::TestCase) {
+        let doc = Doc::with_client_id(1);
+        // phase 1: some history
+        hegel_random_text_ops(&tc, &doc);
+        let prefix_update = doc
+            .transact()
+            .encode_state_as_update_v1(&StateVector::default());
+        let prefix_sv = doc.transact().state_vector().encode_v1();
+        // phase 2: more history on top
+        hegel_random_text_ops(&tc, &doc);
+        let full_update = doc
+            .transact()
+            .encode_state_as_update_v1(&StateVector::default());
+
+        let diff = diff_updates_v1(&full_update, &prefix_sv).unwrap();
+
+        let receiver = Doc::with_client_id(2);
+        {
+            let mut txn = receiver.transact_mut();
+            txn.apply_update(Update::decode_v1(&prefix_update).unwrap())
+                .unwrap();
+            txn.apply_update(Update::decode_v1(&diff).unwrap()).unwrap();
+        }
+        assert_eq!(hegel_text_state(&receiver), hegel_text_state(&doc));
+    }
 }
diff --git a/yrs/src/doc.rs b/yrs/src/doc.rs
index c2c5b5c..9521a24 100644
--- a/yrs/src/doc.rs
+++ b/yrs/src/doc.rs
@@ -2267,4 +2267,141 @@ mod test {
             "Pending delete should have been applied"
         );
     }
+
+    // === hegel property-based tests ===
+
+    /// Draws a byte index lying on a char boundary of `s` (including `s.len()`).
+    /// [Text] documents indexes in bytes (default [OffsetKind::Bytes]), and byte
+    /// indexes must respect UTF-8 char boundaries, so valid positions are
+    /// constructed directly instead of filtering.
+    fn hegel_char_boundary(tc: &hegel::TestCase, s: &str) -> u32 {
+        use hegel::generators;
+        let mut bounds: Vec<u32> = s.char_indices().map(|(i, _)| i as u32).collect();
+        bounds.push(s.len() as u32);
+        let i = tc.draw(generators::integers::<usize>().max_value(bounds.len() - 1));
+        bounds[i]
+    }
+
+    /// Performs a drawn sequence of text/array/map operations against `doc`'s
+    /// "text", "array" and "map" root types.
+    fn hegel_random_ops(tc: &hegel::TestCase, doc: &Doc) {
+        use hegel::generators;
+        let text = doc.get_or_insert_text("text");
+        let array = doc.get_or_insert_array("array");
+        let map = doc.get_or_insert_map("map");
+        let ops = tc.draw(generators::integers::<usize>().max_value(15));
+        for _ in 0..ops {
+            let mut txn = doc.transact_mut();
+            match tc.draw(generators::integers::<u8>().max_value(5)) {
+                0 => {
+                    let s = text.get_string(&txn);
+                    let pos = hegel_char_boundary(tc, &s);
+                    let chunk: String = tc.draw(generators::text().max_size(8));
+                    text.insert(&mut txn, pos, &chunk);
+                }
+                1 => {
+                    let s = text.get_string(&txn);
+                    let start = hegel_char_boundary(tc, &s);
+                    let end = hegel_char_boundary(tc, &s);
+                    let (start, end) = (start.min(end), start.max(end));
+                    text.remove_range(&mut txn, start, end - start);
+                }
+                2 => {
+                    let idx = tc.draw(generators::integers::<u32>().max_value(array.len(&txn)));
+                    let value = tc.draw(generators::integers::<i64>());
+                    array.insert(&mut txn, idx, value);
+                }
+                3 => {
+                    let len = array.len(&txn);
+                    if len > 0 {
+                        let idx = tc.draw(generators::integers::<u32>().max_value(len - 1));
+                        array.remove(&mut txn, idx);
+                    }
+                }
+                4 => {
+                    let key: String = tc.draw(generators::text().max_size(4));
+                    let value = tc.draw(generators::integers::<i64>());
+                    map.insert(&mut txn, key, value);
+                }
+                _ => {
+                    // `map.keys` iterates a HashMap, whose order is not deterministic
+                    // between documents; sort so the same choices always remove the same key.
+                    let mut keys: Vec<String> =
+                        map.keys(&txn).map(|k| k.to_string()).collect();
+                    keys.sort();
+                    if !keys.is_empty() {
+                        let i =
+                            tc.draw(generators::integers::<usize>().max_value(keys.len() - 1));
+                        map.remove(&mut txn, &keys[i]);
+                    }
+                }
+            }
+        }
+    }
+
+    /// Observable state of a document's "text", "array" and "map" roots plus its
+    /// state vector, for cross-document comparison.
+    fn hegel_doc_state(doc: &Doc) -> (String, Any, Any, StateVector) {
+        let text = doc.get_or_insert_text("text");
+        let array = doc.get_or_insert_array("array");
+        let map = doc.get_or_insert_map("map");
+        let txn = doc.transact();
+        (
+            text.get_string(&txn),
+            array.to_json(&txn),
+            map.to_json(&txn),
+            txn.state_vector(),
+        )
+    }
+
+    /// Property: a full-state update (v1 or v2) applied to a fresh document
+    /// reproduces the source document's state exactly. Evidence: the lib.rs
+    /// quick-start documents this encode-diff/apply-update synchronization flow.
+    #[hegel::test]
+    fn hegel_full_state_update_roundtrip(tc: hegel::TestCase) {
+        let source = Doc::with_client_id(1);
+        hegel_random_ops(&tc, &source);
+        let use_v2 = tc.draw(hegel::generators::booleans());
+        let receiver = Doc::with_client_id(2);
+        {
+            let mut txn = receiver.transact_mut();
+            if use_v2 {
+                let bin = source
+                    .transact()
+                    .encode_state_as_update_v2(&StateVector::default());
+                txn.apply_update(Update::decode_v2(&bin).unwrap()).unwrap();
+            } else {
+                let bin = source
+                    .transact()
+                    .encode_state_as_update_v1(&StateVector::default());
+                txn.apply_update(Update::decode_v1(&bin).unwrap()).unwrap();
+            }
+        }
+        assert_eq!(hegel_doc_state(&receiver), hegel_doc_state(&source));
+    }
+
+    /// Property: applying the same update twice is the same as applying it once.
+    /// Evidence: state vectors describe already-observed blocks precisely so that
+    /// redundant (re-delivered) updates are ignored - a core CRDT contract.
+    #[hegel::test]
+    fn hegel_apply_update_idempotent(tc: hegel::TestCase) {
+        let source = Doc::with_client_id(1);
+        hegel_random_ops(&tc, &source);
+        let bin = source
+            .transact()
+            .encode_state_as_update_v1(&StateVector::default());
+
+        let receiver = Doc::with_client_id(2);
+        receiver
+            .transact_mut()
+            .apply_update(Update::decode_v1(&bin).unwrap())
+            .unwrap();
+        let once = hegel_doc_state(&receiver);
+        receiver
+            .transact_mut()
+            .apply_update(Update::decode_v1(&bin).unwrap())
+            .unwrap();
+        let twice = hegel_doc_state(&receiver);
+        assert_eq!(once, twice);
+    }
 }
