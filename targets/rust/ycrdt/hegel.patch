+
+    /// Property (CRDT convergence): concurrent insert/remove operations on
+    /// [MapRef] replicas converge to the same entries once all peers exchanged
+    /// updates. Keys are drawn from a small set to force concurrent updates of
+    /// the same entry - lib.rs documents that such conflicts are resolved
+    /// deterministically (peer with the higher [crate::block::ClientID] wins).
+    #[hegel::test]
+    fn hegel_map_concurrent_convergence(tc: hegel::TestCase) {
