+
+    // === hegel property-based tests (ports of the proptest properties above) ===
+
+    /// Recursive generator for arbitrary [Any] values (hegel port of `arb_any`).
+    ///
+    /// NaN is excluded from the float leafs because `Any`'s derived `PartialEq`
+    /// (`f64` equality) can never consider NaN equal to itself - the exclusion
+    /// protects the equality comparison in the tests, not the encoder. The
+    /// original proptest generator (`any::<f64>()`) excludes NaN as well.
+    fn hegel_any(depth: u32) -> hegel::generators::BoxedGenerator<'static, Any> {
+        use hegel::generators::{self, Generator};
+        hegel::compose!(|tc| {
+            let make_leaf = depth == 0 || tc.draw(generators::integers::<u8>().max_value(3)) > 0;
+            if make_leaf {
+                tc.draw((hegel::one_of!(
+                    generators::just(Any::Null),
+                    generators::just(Any::Undefined),
+                    generators::booleans().map(Any::Bool),
+                    generators::floats::<f64>().allow_nan(false).map(Any::from),
+                    generators::integers::<i64>().map(Any::from),
+                    generators::text().map(Any::from),
+                    generators::binary().map(Any::from),
+                )).print_as_debug())
+            } else if tc.draw(generators::booleans()) {
+                let items: Vec<Any> = tc.draw((generators::vecs(hegel_any(depth - 1)).max_size(6)).print_as_debug());
+                Any::from(items)
+            } else {
+                let entries: std::collections::HashMap<String, Any> = tc.draw(
+                    (generators::hashmaps(generators::text().max_size(8), hegel_any(depth - 1))
+                        .max_size(6)).print_as_debug(),
+                );
+                Any::from(entries)
+            }
+        })
+        .boxed()
+    }
+
+    /// Property: any [Any] value round-trips through lib0 encoding
+    /// (`Any::encode` / `Any::decode`) unchanged.
+    #[hegel::test]
+    fn hegel_encoding_any_roundtrip(tc: hegel::TestCase) {
+        let any = tc.draw((hegel_any(4)).print_as_debug());
+        let mut encoder = Vec::with_capacity(1024);
+        any.encode(&mut encoder);
+        let mut decoder = Cursor::new(encoder.as_slice());
+        let copy = Any::decode(&mut decoder).unwrap();
+        assert_eq!(any, copy);
+    }
+
+    #[hegel::composite]
+    fn hegel_encoding_types(tc: &hegel::TestCase) -> EncodingTypes {
+        use hegel::generators;
+        match tc.draw(generators::integers::<u8>().max_value(17)) {
+            0 => EncodingTypes::Byte(tc.draw(generators::integers::<u8>())),
+            1 => EncodingTypes::Uint8(tc.draw(generators::integers::<u8>())),
+            2 => EncodingTypes::Uint16(tc.draw(generators::integers::<u16>())),
+            3 => EncodingTypes::Uint32(tc.draw(generators::integers::<u32>())),
+            4 => EncodingTypes::Uint32BigEndian(tc.draw(generators::integers::<u32>())),
+            5 => EncodingTypes::VarUint32(tc.draw(generators::integers::<u32>())),
+            6 => EncodingTypes::VarUint64(tc.draw(generators::integers::<u64>())),
+            7 => EncodingTypes::VarUint128(tc.draw(generators::integers::<u128>())),
+            8 => EncodingTypes::VarUintUsize(tc.draw(generators::integers::<usize>())),
+            9 => EncodingTypes::VarInt(tc.draw(generators::integers::<i64>())),
+            10 => EncodingTypes::Buffer(tc.draw(generators::binary())),
+            11 => EncodingTypes::VarBuffer(tc.draw(generators::binary())),
+            12 => EncodingTypes::VarString(tc.draw(generators::text())),
+            // NaN excluded: the roundtrip is asserted with `assert_eq!` on floats,
+            // and NaN != NaN. This protects the test comparison, not the codec.
+            13 => EncodingTypes::Float32(tc.draw(hegel::generators::floats::<f32>().allow_nan(false))),
+            14 => EncodingTypes::Float64(tc.draw(hegel::generators::floats::<f64>().allow_nan(false))),
+            15 => EncodingTypes::BigInt64(tc.draw(generators::integers::<i64>())),
+            16 => EncodingTypes::BigUInt64(tc.draw(generators::integers::<u64>())),
+            _ => EncodingTypes::Any(tc.draw((hegel_any(4)).print_as_debug())),
+        }
+    }
+
+    /// Property: every lib0 primitive write operation is read back unchanged by
+    /// the corresponding read operation (hegel port of `encoding_prop`).
+    #[hegel::test]
+    fn hegel_encoding_primitives_roundtrip(tc: hegel::TestCase) {
+        let val = tc.draw((hegel_encoding_types()).print_as_debug());
+        let mut encoder = Vec::new();
+        val.write(&mut encoder);
+        let mut decoder = Cursor::new(encoder.as_slice());
+        val.read(&mut decoder)
+    }
 }
