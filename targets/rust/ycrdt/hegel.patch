+
+    // === hegel property-based tests ===
+
+    /// Sends everything `to` hasn't seen yet from `from` (one-directional sync).
+    fn hegel_sync(from: &Doc, to: &Doc) {
+        let sv = to.transact().state_vector();
+        let bin = from.transact().encode_diff_v1(&sv);
+        to.transact_mut()
+            .apply_update(Update::decode_v1(&bin).unwrap())
+            .unwrap();
+    }
+
+    /// Property (CRDT convergence): concurrent insert/remove operations on
+    /// [ArrayRef] replicas converge to the same content once all peers exchanged
+    /// updates, regardless of operation interleaving and exchange order.
+    /// Evidence: lib.rs documents that concurrent inserts are ordered
+    /// deterministically by [ClientID]; the seeded `fuzzy` test checks the same
+    /// property via `run_scenario`.
+    #[hegel::test]
+    fn hegel_array_concurrent_convergence(tc: hegel::TestCase) {
+        use hegel::generators;
+        const PEERS: usize = 3;
+        let docs: Vec<Doc> = (1..=PEERS as u64).map(Doc::with_client_id).collect();
+        let arrays: Vec<_> = docs
+            .iter()
+            .map(|d| d.get_or_insert_array("array"))
+            .collect();
+
+        let ops = tc.draw(generators::integers::<usize>().max_value(30));
+        for _ in 0..ops {
+            let peer = tc.draw(generators::integers::<usize>().max_value(PEERS - 1));
+            {
+                let doc = &docs[peer];
+                let array = &arrays[peer];
+                let mut txn = doc.transact_mut();
+                let len = array.len(&txn);
+                if tc.draw(generators::booleans()) || len == 0 {
+                    let idx = tc.draw(generators::integers::<u32>().max_value(len));
+                    let value = tc.draw(generators::integers::<i64>());
+                    array.insert(&mut txn, idx, value);
+                } else {
+                    let idx = tc.draw(generators::integers::<u32>().max_value(len - 1));
+                    array.remove(&mut txn, idx);
+                }
+            }
+            if tc.draw(generators::integers::<u8>().max_value(9)) == 0 {
+                let from = tc.draw(generators::integers::<usize>().max_value(PEERS - 1));
+                let to = tc.draw(generators::integers::<usize>().max_value(PEERS - 1));
+                if from != to {
+                    hegel_sync(&docs[from], &docs[to]);
+                }
+            }
+        }
+
+        // final full pairwise exchange in a drawn order
+        let mut pairs: Vec<(usize, usize)> = (0..PEERS)
+            .flat_map(|i| (0..PEERS).filter(move |j| *j != i).map(move |j| (i, j)))
+            .collect();
+        while !pairs.is_empty() {
+            let i = tc.draw(generators::integers::<usize>().max_value(pairs.len() - 1));
+            let (from, to) = pairs.remove(i);
+            hegel_sync(&docs[from], &docs[to]);
+        }
+
+        let reference = arrays[0].to_json(&docs[0].transact());
+        for i in 1..PEERS {
+            assert_eq!(
+                arrays[i].to_json(&docs[i].transact()),
+                reference,
+                "peer {} array diverged",
+                i
+            );
+        }
+    }
+
+    /// Stateful model test: an [ArrayRef] under sequential insert/push/remove/get
+    /// operations behaves exactly like a plain `Vec`. Evidence: the Array trait
+    /// docs describe standard indexed-sequence semantics (insert-at, remove-at,
+    /// get returning None out of range).
+    struct HegelArrayModel {
+        doc: Doc,
+        model: Vec<i64>,
+    }
+
+    #[hegel::state_machine]
+    impl HegelArrayModel {
+        #[rule]
+        fn insert(&mut self, tc: hegel::TestCase) {
+            use hegel::generators;
+            let idx = tc.draw(generators::integers::<u32>().max_value(self.model.len() as u32));
+            let value = tc.draw(generators::integers::<i64>());
+            let array = self.doc.get_or_insert_array("array");
+            array.insert(&mut self.doc.transact_mut(), idx, value);
+            self.model.insert(idx as usize, value);
+        }
+
+        #[rule]
+        fn push_back(&mut self, tc: hegel::TestCase) {
+            use hegel::generators;
+            let value = tc.draw(generators::integers::<i64>());
+            let array = self.doc.get_or_insert_array("array");
+            array.push_back(&mut self.doc.transact_mut(), value);
+            self.model.push(value);
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: hegel::TestCase) {
+            use hegel::generators;
+            tc.assume(!self.model.is_empty());
+            let idx = tc
+                .draw(generators::integers::<u32>().max_value(self.model.len() as u32 - 1));
+            let array = self.doc.get_or_insert_array("array");
+            array.remove(&mut self.doc.transact_mut(), idx);
+            self.model.remove(idx as usize);
+        }
+
+        #[rule]
+        fn get(&mut self, tc: hegel::TestCase) {
+            use hegel::generators;
+            // deliberately draws one past the end: get out of range must be None
+            let idx = tc.draw(generators::integers::<u32>().max_value(self.model.len() as u32));
+            let array = self.doc.get_or_insert_array("array");
+            let actual = array.get(&self.doc.transact(), idx);
+            let expected = self.model.get(idx as usize).map(|v| Out::from(Any::from(*v)));
+            assert_eq!(actual, expected);
+        }
+
+        #[invariant]
+        fn matches_model(&self, _tc: hegel::TestCase) {
+            let array = self.doc.get_or_insert_array("array");
+            let txn = self.doc.transact();
+            assert_eq!(array.len(&txn) as usize, self.model.len());
+            let expected = Any::from(
+                self.model
+                    .iter()
+                    .map(|v| Any::from(*v))
+                    .collect::<Vec<Any>>(),
+            );
+            assert_eq!(array.to_json(&txn), expected);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_array_matches_vec_model(tc: hegel::TestCase) {
+        let machine = HegelArrayModel {
+            doc: Doc::with_client_id(1),
+            model: Vec::new(),
+        };
+        hegel::stateful::machine(machine).run(tc);
+    }
 }
