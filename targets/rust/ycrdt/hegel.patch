+
+#[cfg(test)]
+mod lib_test {
+    use super::uuid_v4_from;
+    use hegel::generators;
+
+    /// Property: [uuid_v4_from] produces a well-formed v4 UUID for any input.
+    /// Evidence: doc comment references RFC 4122 section 4.4 (random UUIDs have
+    /// the version nibble fixed to `4` and the variant nibble in `8..=b`).
+    #[hegel::test]
+    fn hegel_uuid_v4_format(tc: hegel::TestCase) {
+        let value = tc.draw(generators::integers::<u128>());
+        let uuid = uuid_v4_from(value);
+        assert_eq!(uuid.len(), 36);
+        for (i, c) in uuid.char_indices() {
+            match i {
+                8 | 13 | 18 | 23 => assert_eq!(c, '-', "expected hyphen at index {}", i),
+                14 => assert_eq!(c, '4', "version nibble must be 4"),
+                19 => assert!(
+                    matches!(c, '8' | '9' | 'a' | 'b'),
+                    "variant nibble must be one of 8/9/a/b, got {}",
+                    c
+                ),
+                _ => assert!(
+                    c.is_ascii_hexdigit() && !c.is_ascii_uppercase(),
+                    "expected lowercase hex digit at index {}, got {}",
+                    i,
+                    c
+                ),
+            }
+        }
+    }
+}
