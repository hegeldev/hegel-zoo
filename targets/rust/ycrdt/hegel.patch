+    // === hegel property-based tests ===
+
+    /// Sends everything `to` hasn't seen yet from `from` (one-directional sync).
+    fn hegel_sync(from: &Doc, to: &Doc) {
+        let sv = to.transact().state_vector();
+        let bin = from.transact().encode_diff_v1(&sv);
+        to.transact_mut()
+            .apply_update(Update::decode_v1(&bin).unwrap())
+            .unwrap();
