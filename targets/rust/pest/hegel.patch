+        fn pinned_consume_rules_panics_on_huge_peek_slice_integer() {
+            let grammar = "a = { PEEK[..99999999999999999999] }";
+            let pairs = parse(Rule::grammar_rules, grammar).expect("this grammar parses");
+            assert!(validator::validate_pairs(pairs.clone()).is_ok());
