@@ -1872,4 +1872,651 @@ mod tests {
         assert!(s5.is_err());
         assert_eq!(s5.unwrap_err().variant.message(), ERROR);
     }
+
+    mod pbt {
+        use super::*;
+        use hegel::generators::{self, Generator};
+
+        /// Mirror the upstream fuzz target (`meta/fuzz/fuzz_targets/parser.rs`):
+        /// a call limit is required because adversarial inputs otherwise take
+        /// effectively unbounded time (e.g. the nested block comments in
+        /// `resources/test/fuzzsample2.grammar`) or recurse very deeply. The
+        /// limit is a process-wide global that the `fuzzsamples` test above
+        /// also sets (and never resets), so tests in this binary can observe it
+        /// regardless of what they do; we always use the same value so that
+        /// test order does not matter.
+        fn fuzz_call_limit() {
+            pest::set_call_limit(Some(5_000usize.try_into().unwrap()));
+        }
+
+        /// The grammar parser must never panic, whatever the input — the same
+        /// property the upstream fuzz target checks.
+        #[hegel::test]
+        fn parse_never_panics_on_arbitrary_input(tc: hegel::TestCase) {
+            fuzz_call_limit();
+            let input: String = tc.draw(generators::text().max_size(200));
+            drop(parse(Rule::grammar_rules, &input));
+        }
+
+        /// Tokens of the pest meta-grammar, for "grammar-shaped soup" that
+        /// exercises the parser (and, when parsing succeeds, the validator and
+        /// AST construction) much deeper than uniform random text.
+        ///
+        /// Deliberate exclusions, pinned by failing tests below:
+        /// - no lone `\` token, so soup cannot assemble a `\u{...}` escape with
+        ///   an invalid scalar value
+        ///   (`pinned_consume_rules_panics_on_invalid_unicode_escape`);
+        /// - digit runs are additionally capped before calling `consume_rules`
+        ///   (`pinned_consume_rules_panics_on_huge_peek_slice_integer`).
+        const SOUP_TOKENS: &[&str] = &[
+            "a", "b", "r0", "_x", "PUSH", "PUSH_LITERAL", "PEEK", "POP", "DROP", "ANY", "SOI",
+            "EOI", "WHITESPACE", "COMMENT", "ASCII_DIGIT", "NEWLINE", "=", "{", "}", "(", ")",
+            "[", "]", "~", "|", "&", "!", "?", "*", "+", "^", "@", "$", "_", "..", ",", "#",
+            "-", "'", "\"", "\"x\"", "\"\"", "'a'", "'\\n'", "\"\\u{263A}\"", "^\"ab\"",
+            "'a'..'z'", "0", "1", "42", "007", "//c\n", "/*c*/", "//!d\n", "///d\n", " ", "\n",
+            "\t",
+        ];
+
+        /// Expression atoms for the rule-skeleton branch of the soup test.
+        /// `s0` makes self-references (left recursion) reachable; `nope` is
+        /// deliberately undefined.
+        const SOUP_ATOMS: &[&str] = &[
+            "\"x\"",
+            "\"\"",
+            "'a'",
+            "'a'..'z'",
+            "'z'..'a'",
+            "^\"ab\"",
+            "^\"\"",
+            "ANY",
+            "ASCII_DIGIT",
+            "NEWLINE",
+            "SOI",
+            "EOI",
+            "PEEK",
+            "PEEK_ALL",
+            "POP",
+            "POP_ALL",
+            "DROP",
+            "nope",
+            "WHITESPACE",
+            "COMMENT",
+            "PEEK[..2]",
+            "PEEK[-2..]",
+            "PUSH(\"x\")",
+            "PUSH(\"\")",
+            "s0",
+        ];
+
+        /// The full pipeline (parse, validate, consume to AST) must never panic
+        /// on grammar-shaped token soup: `parse` may reject it, and a
+        /// successfully parsed grammar may fail validation or AST construction,
+        /// but always via `Err`, never via panic.
+        #[hegel::test]
+        fn pipeline_never_panics_on_grammar_shaped_soup(tc: hegel::TestCase) {
+            fuzz_call_limit();
+            // Half the time build an expression-shaped body inside a valid
+            // rule skeleton (`s0 = { atom op atom ... }`): raw soup almost
+            // never forms a complete grammar, and the interesting validator
+            // and AST code only runs on input that parses. The atoms include
+            // semantically dubious shapes (inverted ranges, `{2,1}` repeats,
+            // empty strings, stack ops without PUSH, undefined and
+            // self-referencing idents) that must all be handled via `Err`,
+            // never via panic.
+            let soup: String = if tc.draw(generators::booleans()) {
+                let atoms = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+                let mut body = String::new();
+                for i in 0..atoms {
+                    if i > 0 {
+                        body.push_str(tc.draw(generators::sampled_from(vec![" ~ ", " | "])));
+                    }
+                    body.push_str(tc.draw(generators::sampled_from(vec!["", "", "&", "!"])));
+                    body.push_str(tc.draw(generators::sampled_from(SOUP_ATOMS.to_vec())));
+                    body.push_str(tc.draw(generators::sampled_from(vec![
+                        "", "", "?", "*", "+", "{0}", "{0,}", "{,0}", "{2}", "{2,1}",
+                    ])));
+                }
+                format!("s0 = {{ {} }}", body)
+            } else {
+                let tokens: Vec<&str> = tc.draw(
+                    generators::vecs(generators::sampled_from(SOUP_TOKENS.to_vec())).max_size(60),
+                );
+                tokens.concat()
+            };
+            tc.note(&soup);
+
+            if let Ok(pairs) = parse(Rule::grammar_rules, &soup) {
+                drop(validator::validate_pairs(pairs.clone()));
+                // KNOWN BUG exclusion: `consume_rules` panics on integers that
+                // overflow i32 (e.g. in `PEEK[..99999999999999999999]`), pinned
+                // by `pinned_consume_rules_panics_on_huge_peek_slice_integer`.
+                // Eight consecutive digits stay below i32::MAX.
+                let has_long_digit_run = soup
+                    .as_bytes()
+                    .split(|b| !b.is_ascii_digit())
+                    .any(|run| run.len() >= 8);
+                if !has_long_digit_run && !has_nested_leading_choice(&soup) {
+                    drop(consume_rules(pairs));
+                }
+            }
+        }
+
+        /// Conservatively detects a `(` followed — modulo whitespace and
+        /// comments — by `|`. KNOWN BUG exclusion for the soup pipeline test:
+        /// such input parses but panics in `consume_rules`, pinned by
+        /// `pinned_consume_rules_panics_on_nested_leading_choice`.
+        fn has_nested_leading_choice(input: &str) -> bool {
+            let bytes = input.as_bytes();
+            for open in 0..bytes.len() {
+                if bytes[open] != b'(' {
+                    continue;
+                }
+                let mut i = open + 1;
+                loop {
+                    while i < bytes.len() && bytes[i].is_ascii_whitespace() {
+                        i += 1;
+                    }
+                    if i + 1 < bytes.len() && bytes[i] == b'/' && bytes[i + 1] == b'/' {
+                        while i < bytes.len() && bytes[i] != b'\n' {
+                            i += 1;
+                        }
+                        continue;
+                    }
+                    if i + 1 < bytes.len() && bytes[i] == b'/' && bytes[i + 1] == b'*' {
+                        i += 2;
+                        while i + 1 < bytes.len() && !(bytes[i] == b'*' && bytes[i + 1] == b'/') {
+                            i += 1;
+                        }
+                        i = (i + 2).min(bytes.len());
+                        continue;
+                    }
+                    break;
+                }
+                if i < bytes.len() && bytes[i] == b'|' {
+                    return true;
+                }
+            }
+            false
+        }
+
+        /// Deeply nested expressions must not crash the parser or the AST
+        /// builder. The depth is capped at 150 because `consume_rules`
+        /// stack-overflows (aborting the process) at roughly depth 460+ in dev
+        /// builds — the cap protects the test process, not any documented
+        /// contract; see `pinned_stack_overflow_in_consume_rules_on_deep_nesting`.
+        ///
+        /// The global call limit is intentionally not touched here: if another
+        /// test has set it, deep inputs may parse to `Err("call limit
+        /// reached")`, which this property tolerates — it only demands "no
+        /// panic, no abort" for every nesting shape and depth.
+        #[hegel::test]
+        fn deeply_nested_expressions_never_panic(tc: hegel::TestCase) {
+            let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(150));
+            let shape = tc.draw(generators::sampled_from(vec![
+                "paren", "choice", "seq", "neg",
+            ]));
+            let body = match shape {
+                "paren" => format!("{}\"x\"{}", "(".repeat(depth), ")".repeat(depth)),
+                "choice" => format!("\"x\"{}", " | \"y\"".repeat(depth)),
+                "seq" => format!("\"x\"{}", " ~ \"y\"".repeat(depth)),
+                _ => format!("{}\"x\"", "!".repeat(depth)),
+            };
+            let grammar = format!("a = {{ {} }}", body);
+
+            if let Ok(pairs) = parse(Rule::grammar_rules, &grammar) {
+                drop(validator::validate_pairs(pairs.clone()));
+                drop(consume_rules(pairs));
+            }
+        }
+
+        // ------------------------------------------------------------------
+        // A generator for *valid* grammars, used to check the full pipeline.
+        // ------------------------------------------------------------------
+
+        /// Builtin rules that always consume input when they match; safe to
+        /// reference and to repeat.
+        const CONSUMING_BUILTINS: &[&str] = &[
+            "ANY",
+            "ASCII_DIGIT",
+            "ASCII_ALPHA",
+            "ASCII_ALPHANUMERIC",
+            "NEWLINE",
+        ];
+
+        /// A generated expression plus the two syntactic properties the
+        /// validator computes for it (`validator::is_non_failing` /
+        /// `is_non_progressing`). Tracking them during construction lets the
+        /// generator avoid the validator's rejections by construction:
+        /// unbounded repetitions (`*`, `+`, `{n,}`) only wrap expressions that
+        /// can fail and progress, and every non-last choice branch can fail.
+        struct GenExpr {
+            text: String,
+            non_failing: bool,
+            non_progressing: bool,
+        }
+
+        impl GenExpr {
+            /// Can fail and consumes input when it matches — safe everywhere,
+            /// including inside unbounded repetitions.
+            fn solid(&self) -> bool {
+                !self.non_failing && !self.non_progressing
+            }
+        }
+
+        /// A solid terminal, used as fallback where a sub-expression must be
+        /// able to fail and progress.
+        fn draw_solid_terminal(tc: &hegel::TestCase) -> GenExpr {
+            GenExpr {
+                text: draw_string_literal(tc),
+                non_failing: false,
+                non_progressing: false,
+            }
+        }
+
+        fn draw_ws(tc: &hegel::TestCase) -> &'static str {
+            tc.draw(generators::sampled_from(vec![" ", "", "  ", "\n  ", "\t"]))
+        }
+
+        /// A string literal with at least one character, mixing plain ASCII,
+        /// multi-byte characters and valid escapes.
+        ///
+        /// KNOWN BUG exclusion: only escapes denoting valid Unicode scalar
+        /// values are generated — `\u{D800}`-style surrogate escapes parse but
+        /// make `consume_rules` panic, pinned by
+        /// `pinned_consume_rules_panics_on_invalid_unicode_escape`.
+        fn draw_string_literal(tc: &hegel::TestCase) -> String {
+            let pieces = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+            let mut literal = String::from("\"");
+            for _ in 0..pieces {
+                let piece: String = tc.draw(hegel::one_of!(
+                    generators::from_regex("[a-zA-Z0-9 .,;:_-]").fullmatch(true),
+                    generators::sampled_from(vec![
+                        "é", "嗨", "𝄞", "\\n", "\\t", "\\r", "\\0", "\\\"", "\\\\", "\\'",
+                        "\\x41", "\\u{263A}", "\\u{10FFFF}",
+                    ])
+                    .map(|s| s.to_string()),
+                ));
+                literal.push_str(&piece);
+            }
+            literal.push('"');
+            literal
+        }
+
+        /// A character range `'lo'..'hi'` with `lo <= hi`.
+        fn draw_char_range(tc: &hegel::TestCase) -> String {
+            let a = tc.draw(generators::integers::<u8>().min_value(b'a').max_value(b'z')) as char;
+            let b = tc.draw(generators::integers::<u8>().min_value(b'a').max_value(b'z')) as char;
+            format!("'{}'..'{}'", a.min(b), a.max(b))
+        }
+
+        /// An expression of nesting depth at most `depth`. `later_rules` are
+        /// the rules defined *after* this one (name and flags) — referencing
+        /// only later rules keeps the rule graph acyclic, so the generated
+        /// grammar can never be left-recursive.
+        fn draw_expr(
+            tc: &hegel::TestCase,
+            depth: usize,
+            later_rules: &[(String, bool, bool)],
+        ) -> GenExpr {
+            let max_choice = if depth == 0 { 5 } else { 10 };
+            match tc.draw(generators::integers::<u8>().max_value(max_choice)) {
+                0 | 1 => draw_solid_terminal(tc),
+                2 => GenExpr {
+                    text: format!("^\"{}\"", {
+                        let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+                        "ab".repeat(n)
+                    }),
+                    non_failing: false,
+                    non_progressing: false,
+                },
+                3 => GenExpr {
+                    text: draw_char_range(tc),
+                    non_failing: false,
+                    non_progressing: false,
+                },
+                4 => {
+                    let name = tc.draw(generators::sampled_from(CONSUMING_BUILTINS.to_vec()));
+                    GenExpr {
+                        text: name.to_string(),
+                        non_failing: false,
+                        non_progressing: false,
+                    }
+                }
+                5 => {
+                    if later_rules.is_empty() {
+                        draw_solid_terminal(tc)
+                    } else {
+                        let idx = tc.draw(
+                            generators::integers::<usize>().max_value(later_rules.len() - 1),
+                        );
+                        let (name, non_failing, non_progressing) = &later_rules[idx];
+                        GenExpr {
+                            text: name.clone(),
+                            non_failing: *non_failing,
+                            non_progressing: *non_progressing,
+                        }
+                    }
+                }
+                6 => {
+                    // Parentheses (or PUSH) preserve both flags.
+                    let inner = draw_expr(tc, depth - 1, later_rules);
+                    if tc.draw(generators::booleans()) {
+                        GenExpr {
+                            text: format!("PUSH({})", inner.text),
+                            ..inner
+                        }
+                    } else {
+                        GenExpr {
+                            text: format!("({}{}{})", draw_ws(tc), inner.text, draw_ws(tc)),
+                            ..inner
+                        }
+                    }
+                }
+                7 => {
+                    // Sequence: non-failing/non-progressing iff all parts are.
+                    let n = tc.draw(generators::integers::<usize>().min_value(2).max_value(3));
+                    let mut parts = Vec::new();
+                    let mut non_failing = true;
+                    let mut non_progressing = true;
+                    for _ in 0..n {
+                        let part = draw_expr(tc, depth - 1, later_rules);
+                        non_failing &= part.non_failing;
+                        non_progressing &= part.non_progressing;
+                        parts.push(part.text);
+                    }
+                    GenExpr {
+                        text: parts.join(&format!("{}~{}", draw_ws(tc), draw_ws(tc))),
+                        non_failing,
+                        non_progressing,
+                    }
+                }
+                8 => {
+                    // Choice: every non-last branch must be able to fail, or
+                    // the validator rejects the grammar ("expression cannot
+                    // fail; following choices cannot be reached").
+                    let n = tc.draw(generators::integers::<usize>().min_value(2).max_value(3));
+                    let mut parts: Vec<GenExpr> = Vec::new();
+                    for _ in 0..n {
+                        parts.push(draw_expr(tc, depth - 1, later_rules));
+                    }
+                    let last = parts.len() - 1;
+                    for part in &mut parts[..last] {
+                        if part.non_failing {
+                            *part = draw_solid_terminal(tc);
+                        }
+                    }
+                    let non_failing = parts.iter().any(|p| p.non_failing);
+                    let non_progressing = parts.iter().any(|p| p.non_progressing);
+                    // A *leading* choice operator is only generated at the top
+                    // level of a rule body (see `draw_valid_grammar`): inside
+                    // any parenthesized context it panics in `consume_rules` —
+                    // KNOWN BUG, pinned by
+                    // `pinned_consume_rules_panics_on_nested_leading_choice`.
+                    let texts: Vec<String> = parts.into_iter().map(|p| p.text).collect();
+                    GenExpr {
+                        text: texts.join(&format!("{}|{}", draw_ws(tc), draw_ws(tc))),
+                        non_failing,
+                        non_progressing,
+                    }
+                }
+                9 => {
+                    // Predicates never progress; `&e` fails iff `e` fails.
+                    let inner = draw_expr(tc, depth - 1, later_rules);
+                    if tc.draw(generators::booleans()) {
+                        GenExpr {
+                            text: format!("&({})", inner.text),
+                            non_failing: inner.non_failing,
+                            non_progressing: true,
+                        }
+                    } else {
+                        GenExpr {
+                            text: format!("!({})", inner.text),
+                            non_failing: false,
+                            non_progressing: true,
+                        }
+                    }
+                }
+                _ => {
+                    // Postfix repetition. Unbounded repetitions (`*`, `+`,
+                    // `{n,}`) of expressions that cannot fail or cannot
+                    // progress are rejected by the validator, so repetitions
+                    // only wrap solid expressions here.
+                    let mut inner = draw_expr(tc, depth - 1, later_rules);
+                    if !inner.solid() {
+                        inner = draw_solid_terminal(tc);
+                    }
+                    let min = tc.draw(generators::integers::<u32>().min_value(1).max_value(3));
+                    let max = min + tc.draw(generators::integers::<u32>().max_value(2));
+                    // `e?`, `e*`, `e{,m}` cannot fail and do not have to
+                    // progress; repetitions with min >= 1 of a solid
+                    // expression can fail and progress.
+                    let (op, non_failing_and_non_progressing) =
+                        match tc.draw(generators::integers::<u8>().max_value(6)) {
+                            0 => ("?".to_string(), true),
+                            1 => ("*".to_string(), true),
+                            2 => ("+".to_string(), false),
+                            3 => (format!("{{{}}}", min), false),
+                            4 => (format!("{{{},}}", min), false),
+                            5 => (format!("{{,{}}}", max), true),
+                            _ => (format!("{{{},{}}}", min, max), false),
+                        };
+                    GenExpr {
+                        text: format!("({}){}", inner.text, op),
+                        non_failing: non_failing_and_non_progressing,
+                        non_progressing: non_failing_and_non_progressing,
+                    }
+                }
+            }
+        }
+
+        /// A whole valid grammar: doc comments, comments, and 1-4 rules with
+        /// distinct non-keyword names, arbitrary modifiers and expressions that
+        /// only reference later rules or consuming builtins. Returns the
+        /// grammar text and the rule names in definition order.
+        fn draw_valid_grammar(tc: &hegel::TestCase) -> (String, Vec<String>) {
+            let rule_count = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+            let names: Vec<String> = (0..rule_count).map(|i| format!("r{}", i)).collect();
+
+            // Generate bodies from the last rule backwards so that every rule
+            // only references rules defined after it (an acyclic rule graph).
+            let mut later_rules: Vec<(String, bool, bool)> = Vec::new();
+            let mut bodies_rev: Vec<String> = Vec::new();
+            for i in (0..rule_count).rev() {
+                let modifier = tc.draw(generators::sampled_from(vec!["", "_", "@", "$", "!"]));
+                let expr = draw_expr(tc, 3, &later_rules);
+                // A leading choice operator is valid (and handled) only at the
+                // top level of a rule body.
+                let leading = if tc.draw(generators::booleans()) { "| " } else { "" };
+                bodies_rev.push(format!(
+                    "{} = {}{{ {}{} }}",
+                    names[i], modifier, leading, expr.text
+                ));
+                later_rules.push((names[i].clone(), expr.non_failing, expr.non_progressing));
+            }
+
+            let mut grammar = String::new();
+            if tc.draw(generators::booleans()) {
+                grammar.push_str("//! grammar doc\n");
+            }
+            for body in bodies_rev.iter().rev() {
+                match tc.draw(generators::integers::<u8>().max_value(3)) {
+                    0 => grammar.push_str("/// rule doc\n"),
+                    1 => grammar.push_str("// comment\n"),
+                    2 => grammar.push_str("/* comment */\n"),
+                    _ => {}
+                }
+                grammar.push_str(body);
+                grammar.push('\n');
+            }
+            (grammar, names)
+        }
+
+        /// Every generated valid grammar must pass the whole pipeline — parse,
+        /// validate, AST construction, optimization — with the rule names
+        /// preserved in definition order at every stage.
+        ///
+        /// Generated grammars are small (a handful of rules, expression depth
+        /// <= 3), so they parse well within the 5000-call limit that other
+        /// tests in this binary set process-wide.
+        #[hegel::test]
+        fn generated_valid_grammars_pass_the_full_pipeline(tc: hegel::TestCase) {
+            let (grammar, names) = draw_valid_grammar(&tc);
+            tc.note(&grammar);
+
+            let pairs = match parse(Rule::grammar_rules, &grammar) {
+                Ok(pairs) => pairs,
+                Err(error) => panic!("generated grammar failed to parse: {}\n{}", error, grammar),
+            };
+            if let Err(errors) = validator::validate_pairs(pairs.clone()) {
+                panic!(
+                    "generated grammar failed validation: {:?}\n{}",
+                    errors, grammar
+                );
+            }
+            let ast = match consume_rules(pairs) {
+                Ok(ast) => ast,
+                Err(errors) => panic!(
+                    "generated grammar failed AST construction: {:?}\n{}",
+                    errors, grammar
+                ),
+            };
+            let ast_names: Vec<&str> = ast.iter().map(|rule| rule.name.as_str()).collect();
+            assert_eq!(ast_names, names, "AST rule names for:\n{}", grammar);
+
+            let optimized = crate::optimizer::optimize(ast);
+            let optimized_names: Vec<&str> =
+                optimized.iter().map(|rule| rule.name.as_str()).collect();
+            assert_eq!(optimized_names, names, "optimized rule names for:\n{}", grammar);
+        }
+
+        /// Rejection converse of the pipeline property: appending a token that
+        /// cannot start a new grammar rule to a valid grammar must produce a
+        /// parse error (not a panic, and not silent acceptance).
+        #[hegel::test]
+        fn stray_trailing_token_is_rejected(tc: hegel::TestCase) {
+            let (grammar, _names) = draw_valid_grammar(&tc);
+            let junk = tc.draw(generators::sampled_from(vec![
+                ";", ")", "}", "]", "%", "?", "=", "~", "|", "..",
+            ]));
+            let broken = format!("{}\n{}", grammar, junk);
+            assert!(
+                parse(Rule::grammar_rules, &broken).is_err(),
+                "stray token {:?} was not rejected:\n{}",
+                junk,
+                broken
+            );
+        }
+
+        // ------------------------------------------------------------------
+        // Pinned bugs found by the properties above. These tests fail (or are
+        // ignored because they abort the process) on purpose — do not "fix"
+        // the tests; the bugs are in the code under test.
+        // ------------------------------------------------------------------
+
+        /// KNOWN BUG (pinned, deterministic failure): a string literal whose
+        /// `\u{...}` escape is not a valid Unicode scalar value — a surrogate
