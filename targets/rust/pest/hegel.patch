+        fn pinned_stack_overflow_in_consume_rules_on_deep_nesting() {
+            pest::set_call_limit(None);
+            let depth = 5_000;
+            let grammar = format!("a = {{ {}\"x\"{} }}", "(".repeat(depth), ")".repeat(depth));
+            let pairs = parse(Rule::grammar_rules, &grammar).expect("this grammar parses");
+            // BUG: aborts with a stack overflow instead of returning (anything).
+            drop(consume_rules(pairs));
+        }
