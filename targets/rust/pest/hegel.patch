+        ///   empty state if no snapshot was taken, per the `restore` docs),
+        /// - `clear_snapshot` discards the most recent snapshot, keeping the
+        ///   current contents.
+        struct ModelledStack {
+            subject: Stack<i32>,
+            current: Vec<i32>,
+            snapshots: Vec<Vec<i32>>,
