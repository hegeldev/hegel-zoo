+        /// `pest_derive`) run without one.
+        ///
+        /// Run manually with:
+        ///   cargo test -p pest_meta pinned_unbounded_runtime -- --ignored
+        /// and expect the test to hang (kill it manually).
+        #[test]
+        #[ignore = "effectively hangs: catastrophic backtracking on nested block comments without a call limit"]
+        fn pinned_unbounded_runtime_on_nested_block_comments() {
+            pest::set_call_limit(None);
