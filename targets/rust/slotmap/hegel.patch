+        fn churned_map(tc: &hegel::TestCase) -> (SlotMap<DefaultKey, u32>, Vec<DefaultKey>, Vec<DefaultKey>) {
+            let mut sm = SlotMap::new();
+            let mut live = Vec::new();
+            let mut stale = Vec::new();
+            let ops = tc.draw(generators::integers::<usize>().min_value(1).max_value(60));
+            for i in 0..ops {
+                if !live.is_empty() && tc.draw(generators::booleans()) {
+                    let idx = tc.draw(generators::integers::<usize>().max_value(live.len() - 1));
+                    let k: DefaultKey = live.swap_remove(idx);
+                    sm.remove(k);
+                    stale.push(k);
+                } else {
+                    live.push(sm.insert(i as u32));
+                }
+            }
