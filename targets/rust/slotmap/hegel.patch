+        #[hegel::test]
+        fn hegel_from_ffi_arbitrary_u64_is_safe(tc: hegel::TestCase) {
+            let raw = tc.draw(generators::integers::<u64>());
+            let kd = KeyData::from_ffi(raw);
+            assert_eq!(KeyData::from_ffi(kd.as_ffi()), kd);
+
+            let k: DefaultKey = kd.into();
