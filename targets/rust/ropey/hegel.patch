+// ---------------------------------------------------------------------------------------------
+// Deterministic pins: one plain test per recorded bug, failing exactly while the bug exists.
+
+/// KNOWN FAILURE ropey/1. A `byte_slice` whose end splits a CRLF pair must count the lone CR as
+/// a line break, as the char-range `slice` of the same range does (`RopeSlice::new_with_range`
+/// adjusts for `is_crlf_split`; `new_with_byte_range` does not). The text spans several leaves.
+#[test]
+fn pin_byte_slice_ending_in_a_split_crlf_counts_the_cr() {
+    let text = format!("{}\r\n{}\r\nend", "a".repeat(1500), "b".repeat(1500));
+    let rope = Rope::from_str(&text);
+    assert_eq!(rope.slice(0..1501).len_lines(), 2, "char-range slice up to the CR");
+    let s = rope.byte_slice(0..1501);
+    assert_eq!(s.lines().count(), 2, "lines() of the byte slice up to the CR");
+    assert_eq!(s.len_lines(), 2, "len_lines() of the byte slice up to the CR");
+    assert_eq!(rope.byte_slice(1501..3003).len_lines(), 3, "byte slice from the LF to the next CR");
+}
