+/// The `str_utils` conversions on plain strings agree with the model, including their documented
+/// clamping of past-the-end indices.
+#[hegel::test]
+fn str_utils_agree_with_the_model(tc: hegel::TestCase) {
+    let text = tc.draw(arb_text());
+    let lines = model_lines(&text);
+    let n_chars = char_count(&text);
+    for (ci, (bi, _)) in text.char_indices().chain(std::iter::once((text.len(), '\0'))).enumerate() {
+        assert_eq!(str_utils::byte_to_char_idx(&text, bi), ci, "byte_to_char_idx({bi}) in {text:?}");
+        assert_eq!(str_utils::char_to_byte_idx(&text, ci), bi, "char_to_byte_idx({ci})");
+        assert_eq!(str_utils::byte_to_line_idx(&text, bi), line_of_byte(&text, bi), "byte_to_line_idx({bi}) in {text:?}");
+        assert_eq!(str_utils::char_to_line_idx(&text, ci), line_of_byte(&text, bi), "char_to_line_idx({ci}) in {text:?}");
+    }
+    for li in 0..lines.len() {
+        assert_eq!(str_utils::line_to_byte_idx(&text, li), byte_of_line(&text, li), "line_to_byte_idx({li}) in {text:?}");
+        assert_eq!(str_utils::line_to_char_idx(&text, li), char_of_byte(&text, byte_of_line(&text, li)), "line_to_char_idx({li}) in {text:?}");
+    }
+    // Past-the-end indices clamp as documented.
+    assert_eq!(str_utils::char_to_byte_idx(&text, n_chars + 5), text.len());
+    assert_eq!(str_utils::byte_to_char_idx(&text, text.len() + 5), n_chars);
+    assert_eq!(str_utils::char_to_line_idx(&text, n_chars + 5), lines.len() - 1, "char_to_line_idx past the end is the last line");
+    assert_eq!(str_utils::byte_to_line_idx(&text, text.len() + 5), lines.len() - 1);
+    assert_eq!(str_utils::line_to_char_idx(&text, lines.len() + 5), n_chars, "line_to_char_idx past the end is one past the end");
+    assert_eq!(str_utils::line_to_byte_idx(&text, lines.len() + 5), text.len());
+}
