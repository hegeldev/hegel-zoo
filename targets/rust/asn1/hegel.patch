diff --git a/tests/roundtrip_tests.rs b/tests/roundtrip_tests.rs
index 6cd4d11..34cf1e7 100644
--- a/tests/roundtrip_tests.rs
+++ b/tests/roundtrip_tests.rs
@@ -42,3 +42,357 @@ fn test_u64() {
         assert_roundtrips::<u64>(v);
     }
 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use hegel::generators;
+use hegel::Generator;
+
+/// Property: write→parse is the identity for `i64` over the full range.
+#[hegel::test]
+fn test_i64_roundtrip_property(tc: hegel::TestCase) {
+    let v = tc.draw(generators::integers::<i64>());
+    assert_roundtrips::<i64>(v);
+}
+
+/// Property: write→parse is the identity for `u64` over the full range
+/// (covers the 0x00 pad byte for values with the high bit set).
+#[hegel::test]
+fn test_u64_roundtrip_property(tc: hegel::TestCase) {
+    let v = tc.draw(generators::integers::<u64>());
+    assert_roundtrips::<u64>(v);
+}
+
+/// Independently computes the DER header (tag + length octets) for a
+/// primitive TLV, per X.690: short form for lengths < 128, otherwise
+/// 0x80|n followed by the minimal big-endian length bytes.
+fn expected_der_header(tag: u8, len: usize) -> Vec<u8> {
+    let mut header = vec![tag];
+    if len < 128 {
+        header.push(len as u8);
+    } else {
+        let be = len.to_be_bytes();
+        let start = be.iter().position(|&b| b != 0).unwrap();
+        header.push(0x80 | (be.len() - start) as u8);
+        header.extend_from_slice(&be[start..]);
+    }
+    header
+}
+
+/// Property: OCTET STRING write→parse is the identity for content lengths
+/// across the length-encoding boundaries (127/128/255/256/65535/65536/...),
+/// and the writer emits the spec-mandated minimal length encoding.
+#[hegel::test]
+fn test_octet_string_length_boundaries(tc: hegel::TestCase) {
+    let n: usize = tc.draw(hegel::one_of!(
+        generators::integers::<usize>().max_value(300),
+        generators::sampled_from(vec![
+            126usize, 127, 128, 129, 255, 256, 257, 65534, 65535, 65536, 65537, 16777215, 16777216,
+        ]),
+    ));
+    let byte = tc.draw(generators::integers::<u8>());
+    let data = vec![byte; n];
+
+    let encoded = asn1::write_single(&data.as_slice()).unwrap();
+
+    let header = expected_der_header(0x04, n);
+    assert_eq!(&encoded[..header.len()], &header);
+    assert_eq!(&encoded[header.len()..], &data);
+
+    let parsed = asn1::parse_single::<&[u8]>(&encoded).unwrap();
+    assert_eq!(parsed, &data);
+}
+
+/// Property (validation/rejection): an INTEGER whose contents are padded
+/// with a redundant leading 0x00/0xff byte is not minimally encoded and
+/// must be rejected by the parser.
+#[hegel::test]
+fn test_padded_integer_rejected(tc: hegel::TestCase) {
+    let v = tc.draw(generators::integers::<i64>());
+    let encoded = asn1::write_single(&v).unwrap();
+    // i64 contents are at most 8 bytes, so the length is always short form.
+    let contents = &encoded[2..];
+    let pad: u8 = if contents[0] & 0x80 == 0x80 { 0xff } else { 0x00 };
+
+    let mut bad = vec![0x02, (contents.len() + 1) as u8, pad];
+    bad.extend_from_slice(contents);
+
+    let err = asn1::parse_single::<i64>(&bad).unwrap_err();
+    assert_eq!(err.kind(), asn1::ParseErrorKind::InvalidValue);
+    // The same non-minimal contents must also be rejected by the bignum types.
+    let err = asn1::parse_single::<asn1::BigInt<'_>>(&bad).unwrap_err();
+    assert_eq!(err.kind(), asn1::ParseErrorKind::InvalidValue);
+}
+
+/// Property (validation/rejection): a negative INTEGER must be rejected when
+/// parsed as an unsigned type.
+#[hegel::test]
+fn test_negative_integer_rejected_for_unsigned(tc: hegel::TestCase) {
+    let v = tc.draw(generators::integers::<i64>().max_value(-1));
+    let encoded = asn1::write_single(&v).unwrap();
+    let err = asn1::parse_single::<u64>(&encoded).unwrap_err();
+    assert_eq!(err.kind(), asn1::ParseErrorKind::InvalidValue);
+    let err = asn1::parse_single::<asn1::BigUint<'_>>(&encoded).unwrap_err();
+    assert_eq!(err.kind(), asn1::ParseErrorKind::InvalidValue);
+}
+
+/// Property (validation/rejection): DER requires the definite length to be
+/// encoded in the minimal number of octets. Re-encoding a valid TLV's length
+/// with more octets than necessary must be rejected.
+#[hegel::test]
+fn test_non_minimal_length_rejected(tc: hegel::TestCase) {
+    let data: Vec<u8> = tc.draw(generators::binary().max_size(300));
+    let len = data.len();
+    // Number of length bytes in the *minimal* long-form encoding (0 means
+    // short form is required).
+    let min_bytes = if len < 128 {
+        0
+    } else {
+        (usize::BITS - len.leading_zeros()).div_ceil(8) as usize
+    };
+    let num_bytes = tc.draw(
+        generators::integers::<usize>()
+            .min_value(min_bytes + 1)
+            .max_value(4),
+    );
+
+    let mut bad = vec![0x04, 0x80 | num_bytes as u8];
+    for i in (0..num_bytes).rev() {
+        bad.push((len >> (i * 8)) as u8);
+    }
+    bad.extend_from_slice(&data);
+
+    let err = asn1::parse_single::<&[u8]>(&bad).unwrap_err();
+    assert_eq!(err.kind(), asn1::ParseErrorKind::InvalidLength);
+}
+
+/// Property: write→parse is the identity for BIT STRINGs over arbitrary
+/// contents and padding-bit counts.
+#[hegel::test]
+fn test_bit_string_roundtrip_property(tc: hegel::TestCase) {
+    let mut data: Vec<u8> = tc.draw(generators::binary().max_size(50));
+    let padding_bits = if data.is_empty() {
+        0
+    } else {
+        tc.draw(generators::integers::<u8>().max_value(7))
+    };
+    if padding_bits > 0 {
+        // Padding bits must be zero; this masks the generated value into the
+        // type's documented domain.
+        let last = data.len() - 1;
+        data[last] &= !((1u8 << padding_bits) - 1);
+    }
+    let bs = asn1::OwnedBitString::new(data, padding_bits).unwrap();
+    assert_roundtrips::<asn1::OwnedBitString>(bs);
+}
+
+/// Generates an arbitrary valid `DateTime` with the year in
+/// `[min_year, max_year]`.
+#[hegel::composite]
+fn datetimes(tc: &hegel::TestCase, min_year: u16, max_year: u16) -> asn1::DateTime {
+    let year = tc.draw(
+        generators::integers::<u16>()
+            .min_value(min_year)
+            .max_value(max_year),
+    );
+    let month = tc.draw(generators::integers::<u8>().min_value(1).max_value(12));
+    let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
+    let max_day = match month {
+        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,
+        4 | 6 | 9 | 11 => 30,
+        _ => {
+            if leap {
+                29
+            } else {
+                28
+            }
+        }
+    };
+    let day = tc.draw(generators::integers::<u8>().min_value(1).max_value(max_day));
+    let hour = tc.draw(generators::integers::<u8>().max_value(23));
+    let minute = tc.draw(generators::integers::<u8>().max_value(59));
+    let second = tc.draw(generators::integers::<u8>().max_value(59));
+    asn1::DateTime::new(year, month, day, hour, minute, second).unwrap()
+}
+
+/// Property: write→parse is the identity for `UtcTime` over its whole
