+}
+
+/// Independently computes the minimal DER INTEGER contents encoding of a
+/// signed value.
+fn minimal_signed_be(v: i128) -> Vec<u8> {
+    let mut out = v.to_be_bytes().to_vec();
+    while out.len() > 1
+        && ((out[0] == 0x00 && out[1] & 0x80 == 0) || (out[0] == 0xff && out[1] & 0x80 == 0x80))
+    {
+        out.remove(0);
+    }
+    out
+}
+
+/// Independently computes the minimal DER INTEGER contents encoding of an
+/// unsigned value (with the 0x00 disambiguation byte when needed).
+fn minimal_unsigned_be(v: u128) -> Vec<u8> {
+    let mut out = v.to_be_bytes().to_vec();
+    while out.len() > 1 && out[0] == 0x00 {
+        out.remove(0);
+    }
+    if out[0] & 0x80 == 0x80 {
+        out.insert(0, 0x00);
+    }
+    out
+}
+
+/// Property: write→parse is the identity for `OwnedBigInt` over values wider
+/// than any machine type the crate parses directly.
+#[hegel::test]
+fn test_owned_bigint_roundtrip_property(tc: hegel::TestCase) {
+    let v = tc.draw(generators::integers::<i128>());
+    let bi = asn1::OwnedBigInt::new(minimal_signed_be(v)).unwrap();
+    assert_roundtrips::<asn1::OwnedBigInt>(bi);
+}
+
+/// Property: write→parse is the identity for `OwnedBigUint`.
+#[hegel::test]
+fn test_owned_biguint_roundtrip_property(tc: hegel::TestCase) {
+    let v = tc.draw(generators::integers::<u128>());
+    let bu = asn1::OwnedBigUint::new(minimal_unsigned_be(v)).unwrap();
+    assert_roundtrips::<asn1::OwnedBigUint>(bu);
+}
+
+/// Property (oracle): `BigInt::bit_length` and `BigInt::is_negative` agree
+/// with values computed directly from an `i128` (bit length of the
+/// magnitude; 0 for 0), for the full `i128` range including MIN/MAX and
+/// powers of two.
+#[hegel::test]
+fn test_bigint_bit_length_oracle(tc: hegel::TestCase) {
+    // Mix uniform draws with exact powers of two (and neighbors): the
+    // negative power-of-two correction in `bigint_bit_length` is only
+    // exercised by such values.
+    let v: i128 = tc.draw(hegel::one_of!(
+        generators::integers::<i128>(),
+        hegel::compose!(|tc| {
+            let shift = tc.draw(generators::integers::<u32>().max_value(126));
+            let base = 1i128 << shift;
+            let offset = tc.draw(generators::integers::<i128>().min_value(-1).max_value(1));
+            let negate = tc.draw(generators::booleans());
+            let v = base.wrapping_add(offset);
+            if negate {
+                v.wrapping_neg()
+            } else {
+                v
+            }
+        }),
+    ));
+    let data = minimal_signed_be(v);
+    let expected_bits = (128 - v.unsigned_abs().leading_zeros()) as usize;
+
+    let bi = asn1::OwnedBigInt::new(data).unwrap();
+    assert_eq!(bi.bit_length(), expected_bits, "value: {v}");
+    assert_eq!(bi.is_negative(), v < 0, "value: {v}");
+}
+
+/// Property: `SetOfWriter` write→`SetOf` parse yields the same multiset of
+/// values, and the parsed iteration order is sorted by DER encoding
+/// (the SET OF canonical order).
+#[hegel::test]
+fn test_set_of_roundtrip_property(tc: hegel::TestCase) {
+    let vals: Vec<i64> = tc.draw(generators::vecs(generators::integers::<i64>()).max_size(50));
+    let encoded = asn1::write_single(&asn1::SetOfWriter::new(vals.as_slice())).unwrap();
+    let parsed: Vec<i64> = asn1::parse_single::<asn1::SetOf<'_, i64>>(&encoded)
+        .unwrap()
+        .collect();
+
+    let mut expected = vals.clone();
+    expected.sort_unstable();
+    let mut actual = parsed.clone();
+    actual.sort_unstable();
+    assert_eq!(actual, expected);
+
+    for pair in parsed.windows(2) {
+        let e0 = asn1::write_single(&pair[0]).unwrap();
+        let e1 = asn1::write_single(&pair[1]).unwrap();
+        assert!(e0 <= e1, "SET OF elements not in DER order: {pair:?}");
+    }
+}
+
+/// Property (validation/rejection): a SET OF whose elements are not in
+/// ascending DER-encoding order must be rejected by the parser.
+#[hegel::test]
+fn test_set_of_unordered_rejected(tc: hegel::TestCase) {
+    let a = tc.draw(generators::integers::<i64>());
+    let b = tc.draw(generators::integers::<i64>());
+    tc.assume(a != b);
+    let ea = asn1::write_single(&a).unwrap();
+    let eb = asn1::write_single(&b).unwrap();
+    // Order the two encodings descending: guaranteed invalid for a SET.
+    let (hi, lo) = if ea > eb { (ea, eb) } else { (eb, ea) };
+
+    let mut bad = vec![0x31, (hi.len() + lo.len()) as u8];
+    bad.extend_from_slice(&hi);
+    bad.extend_from_slice(&lo);
+
+    let err = match asn1::parse_single::<asn1::SetOf<'_, i64>>(&bad) {
+        Ok(_) => panic!("out-of-order SET OF was accepted"),
+        Err(e) => e,
+    };
+    assert_eq!(err.kind(), asn1::ParseErrorKind::InvalidSetOrdering);
+}
+
+/// Property (write-side ordering enforcement): `SetWriter`/`SetElementWriter`
+/// must refuse to write SET elements in descending DER-encoding order.
+#[hegel::test]
+fn test_set_writer_rejects_unordered_writes(tc: hegel::TestCase) {
+    let a = tc.draw(generators::integers::<i64>());
+    let b = tc.draw(generators::integers::<i64>());
+    tc.assume(a != b);
+    let ea = asn1::write_single(&a).unwrap();
+    let eb = asn1::write_single(&b).unwrap();
+    let (hi_val, lo_val) = if ea > eb { (a, b) } else { (b, a) };
+
+    let result = asn1::write_single(&asn1::SetWriter::<asn1::WriteError>::new(&|w| {
+        w.write_element(&hi_val)?;
+        w.write_element(&lo_val)?;
+        Ok(())
+    }));
+    assert_eq!(result, Err(asn1::WriteError::InvalidSetOrdering));
+
+    // And the ascending order must succeed.
+    let result = asn1::write_single(&asn1::SetWriter::<asn1::WriteError>::new(&|w| {
+        w.write_element(&lo_val)?;
+        w.write_element(&hi_val)?;
+        Ok(())
+    }));
+    assert!(result.is_ok());
+}
