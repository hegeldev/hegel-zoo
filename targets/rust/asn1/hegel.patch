+}
+
+/// Property: write→parse is the identity for `GeneralizedTime`, including
+/// arbitrary sub-second precision (nanoseconds in [1, 999_999_999]).
+#[hegel::test]
+fn test_generalized_time_roundtrip_property(tc: hegel::TestCase) {
+    let dt = tc.draw((datetimes(0, 9999)).print_as_debug());
+    let nanos = tc.draw(generators::optional(
