+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use hegel::generators;
+
+#[derive(asn1::Asn1Read, asn1::Asn1Write, PartialEq, Debug, hegel::PrettyPrintable)]
+struct AllFeatures {
+    a: u64,
+    b: Option<()>,
+    #[pretty(debug)]
+    c: asn1::Choice2<bool, i64>,
+    #[implicit(0)]
+    d: Option<u32>,
+    #[explicit(1)]
+    e: Option<i64>,
+    #[implicit(2)]
+    #[default(7)]
+    f: i32,
+    #[explicit(3)]
+    #[default(8)]
+    g: i32,
+    #[pretty(debug)]
+    h: asn1::Implicit<u32, 7>,
+    #[pretty(debug)]
+    i: asn1::Explicit<u32, 8>,
+}
+
+#[hegel::composite]
+fn all_features(tc: &hegel::TestCase) -> AllFeatures {
+    AllFeatures {
+        a: tc.draw(generators::integers::<u64>()),
+        b: tc.draw(generators::optional(generators::unit())),
+        c: if tc.draw(generators::booleans()) {
+            asn1::Choice2::ChoiceA(tc.draw(generators::booleans()))
+        } else {
+            asn1::Choice2::ChoiceB(tc.draw(generators::integers::<i64>()))
+        },
+        d: tc.draw(generators::optional(generators::integers::<u32>())),
+        e: tc.draw(generators::optional(generators::integers::<i64>())),
+        // Boost the DEFAULT values so the omitted-field encoding path is
+        // regularly exercised.
+        f: tc.draw(hegel::one_of!(
+            generators::just(7),
+            generators::integers::<i32>(),
+        )),
+        g: tc.draw(hegel::one_of!(
+            generators::just(8),
+            generators::integers::<i32>(),
+        )),
+        h: asn1::Implicit::new(tc.draw(generators::integers::<u32>())),
+        i: asn1::Explicit::new(tc.draw(generators::integers::<u32>())),
+    }
+}
+
+/// Property: write→parse is the identity for a derived SEQUENCE exercising
+/// OPTIONAL, CHOICE, IMPLICIT/EXPLICIT tagging, and OPTIONAL DEFAULT fields.
+#[hegel::test]
+fn test_derive_struct_roundtrip_property(tc: hegel::TestCase) {
+    let v = tc.draw(all_features());
+    let encoded = asn1::write_single(&v).unwrap();
+    let parsed = asn1::parse_single::<AllFeatures>(&encoded).unwrap();
+    assert_eq!(parsed, v);
+}
+
+// The following two types mirror the crate's own fuzz target
+// (fuzz/fuzz_targets/fuzz_asn1_parse.rs), which asserts that any bytes that
+// parse successfully re-serialize to exactly the same bytes (DER is
+// canonical).
+
+#[derive(asn1::Asn1Read, asn1::Asn1Write, PartialEq)]
+enum FuzzData<'a> {
+    Null(()),
+    Bool(bool),
+
+    OctetString(&'a [u8]),
+    PrintableString(asn1::PrintableString<'a>),
+    BMPString(asn1::BMPString<'a>),
+    UniversalString(asn1::UniversalString<'a>),
+    IA5String(asn1::IA5String<'a>),
+    Utf8String(asn1::Utf8String<'a>),
+    VisibleString(asn1::VisibleString<'a>),
+
+    ObjectIdentifier(asn1::ObjectIdentifier),
+
+    UtcTime(asn1::UtcTime),
+    X509GeneralizedTime(asn1::X509GeneralizedTime),
+
+    Enumerated(asn1::Enumerated),
+
+    SetOf(asn1::SetOf<'a, i64>),
+
+    #[explicit(0)]
+    I8(i8),
+    #[explicit(1)]
+    U8(u8),
+    #[explicit(2)]
+    I64(i64),
+    #[explicit(3)]
+    U64(u64),
+    #[explicit(4)]
+    BigInt(asn1::BigInt<'a>),
+    #[explicit(5)]
+    BigUint(asn1::BigUint<'a>),
+
+    #[explicit(6)]
+    BitString(asn1::BitString<'a>),
+    #[explicit(7)]
+    OwnedBitString(asn1::OwnedBitString),
+
+    #[explicit(8)]
+    Sequence(asn1::Sequence<'a>),
+    #[explicit(9)]
+    SequenceOf(asn1::SequenceOf<'a, i64>),
+    #[explicit(10)]
+    Struct(FuzzStructData<'a>),
+
+    #[explicit(11)]
+    GeneralizedTime(asn1::GeneralizedTime),
+}
+
+#[derive(asn1::Asn1Read, asn1::Asn1Write, PartialEq)]
+struct FuzzStructData<'a> {
+    f1: Option<()>,
+    f2: asn1::Choice2<bool, i64>,
+
+    #[implicit(3)]
+    f3: Option<u32>,
+    #[implicit(4)]
+    f4: Option<u32>,
+
+    #[implicit(5)]
+    #[default(7)]
+    f5: i32,
+    #[implicit(6)]
+    #[default(8)]
+    f6: i32,
+
+    f7: asn1::Implicit<u32, 7>,
+    f8: asn1::Explicit<u32, 8>,
+
+    #[explicit(9)]
+    f9: Option<asn1::Tlv<'a>>,
+}
+
+/// Generates byte strings likely to be interesting to a DER parser: either
+/// arbitrary bytes, or a valid encoding of one of the `FuzzData` shapes with
+/// a few random byte mutations applied.
+#[hegel::composite]
+fn der_like_bytes(tc: &hegel::TestCase) -> Vec<u8> {
+    let mut data: Vec<u8> = match tc.draw(generators::integers::<u8>().max_value(7)) {
+        0 => tc.draw(generators::binary().max_size(64)),
+        1 => asn1::write_single(&tc.draw(generators::booleans())).unwrap(),
+        2 => {
+            let contents = tc.draw(generators::binary().max_size(32));
+            asn1::write_single(&contents.as_slice()).unwrap()
+        }
+        3 => {
+            let v = tc.draw(generators::integers::<i64>());
+            asn1::write_single(&asn1::Explicit::<i64, 2>::new(v)).unwrap()
+        }
+        4 => {
+            let v = tc.draw(generators::integers::<u64>());
+            asn1::write_single(&asn1::Explicit::<u64, 3>::new(v)).unwrap()
+        }
+        5 => {
+            let a = tc.draw(generators::integers::<u64>().max_value(1000));
+            let b = tc.draw(generators::integers::<u64>().max_value(1000));
+            let oid = asn1::ObjectIdentifier::from_string(&format!("2.{a}.{b}")).unwrap();
+            asn1::write_single(&oid).unwrap()
+        }
+        6 => {
+            let vals: Vec<i64> =
+                tc.draw(generators::vecs(generators::integers::<i64>()).max_size(8));
+            asn1::write_single(&asn1::SetOfWriter::new(vals.as_slice())).unwrap()
+        }
+        _ => {
+            let vals: Vec<i64> =
+                tc.draw(generators::vecs(generators::integers::<i64>()).max_size(8));
+            asn1::write_single(&asn1::Explicit::<_, 9>::new(asn1::SequenceOfWriter::new(
+                vals.as_slice(),
+            )))
+            .unwrap()
+        }
+    };
+
+    let num_mutations = tc.draw(generators::integers::<u8>().max_value(3));
+    for _ in 0..num_mutations {
+        if data.is_empty() {
+            break;
+        }
+        let idx = tc.draw(generators::integers::<usize>().max_value(data.len() - 1));
+        data[idx] = tc.draw(generators::integers::<u8>());
+    }
+    data
+}
+
+/// Property (from the crate's own fuzz target): DER is canonical — any input
+/// that parses successfully must re-serialize to exactly the input bytes.
+#[hegel::test]
+fn test_parse_reserialize_identity_property(tc: hegel::TestCase) {
+    let data = tc.draw(der_like_bytes());
+    if let Ok(parsed) = asn1::parse_single::<FuzzData<'_>>(&data) {
+        let written = asn1::write_single(&parsed).unwrap();
+        assert_eq!(written, data);
+    }
+}
