+// ---------------------------------------------------------------------------
+// Property-based tests using hegel.
+// ---------------------------------------------------------------------------
+
+use hegel::generators::{self as gs, Generator};
+use miniz_oxide::deflate::core::create_comp_flags_from_zip_params;
+use miniz_oxide::deflate::stream::deflate;
+use miniz_oxide::inflate::{decompress_to_vec, decompress_to_vec_zlib};
+use miniz_oxide::{MZError, MZFlush, MZStatus};
+
+/// Payload mixing incompressible noise and byte runs, so drawn flush points
+/// land in both compressible and incompressible regions.
+#[hegel::composite]
+fn flush_payloads(tc: &hegel::TestCase) -> Vec<u8> {
+    let num_segments = tc.draw(gs::integers::<usize>().max_value(3));
+    let mut data = Vec::new();
+    for _ in 0..num_segments {
+        let segment: Vec<u8> = tc.draw(hegel::one_of!(
+            gs::binary().max_size(1024).boxed(),
+            gs::tuples!(
+                gs::integers::<u8>(),
+                gs::integers::<usize>().min_value(1).max_value(4096)
+            )
+            .map(|(b, n)| vec![b; n])
+            .boxed(),
+        ));
+        data.extend_from_slice(&segment);
+    }
+    data
+}
+
+/// Compressing via the streaming `deflate::stream::deflate` API with arbitrary
+/// chunk splits, a drawn flush type at every split, and a small output buffer
+/// must still produce a stream that decompresses back to the original data.
+#[hegel::test]
+fn hegel_streaming_deflate_flush_points_roundtrip(tc: hegel::TestCase) {
+    let payload = tc.draw(flush_payloads());
+    let level = tc.draw(gs::integers::<i32>().min_value(0).max_value(10));
+    let zlib = tc.draw(gs::booleans());
+    let out_buf_len = tc.draw(gs::integers::<usize>().min_value(1).max_value(257));
+
+    // Split the payload at drawn cut points.
+    let num_cuts = tc.draw(gs::integers::<usize>().max_value(3));
+    let mut cuts = Vec::with_capacity(num_cuts);
+    for _ in 0..num_cuts {
+        cuts.push(tc.draw(gs::integers::<usize>().max_value(payload.len())));
+    }
+    cuts.sort_unstable();
+    let mut chunk_ranges = Vec::new();
+    let mut prev = 0;
+    for &cut in &cuts {
+        chunk_ranges.push((prev, cut));
+        prev = cut;
+    }
+    chunk_ranges.push((prev, payload.len()));
+
+    let flags = create_comp_flags_from_zip_params(level, if zlib { 15 } else { -15 }, 0);
+    let mut compressor = Box::new(miniz_oxide::deflate::core::CompressorOxide::new(flags));
+    let mut buf = vec![0u8; out_buf_len];
+    let mut compressed = Vec::new();
+
+    for (start, end) in chunk_ranges {
+        let chunk = &payload[start..end];
+        let flush = tc.draw((gs::sampled_from(vec![
+            MZFlush::None,
+            MZFlush::Partial,
+            MZFlush::Sync,
+            MZFlush::Full,
+        ])).print_as_debug());
+
+        // Feed the chunk (with the drawn flush) until it is fully consumed.
+        let mut pos = 0;
+        loop {
+            if pos == chunk.len() && flush == MZFlush::None {
+                // Nothing to feed and nothing to flush.
+                break;
+            }
+            let res = deflate(&mut compressor, &chunk[pos..], &mut buf, flush);
+            pos += res.bytes_consumed;
+            compressed.extend_from_slice(&buf[..res.bytes_written]);
+            match res.status {
+                Ok(_) => {
+                    if pos == chunk.len() {
+                        break;
+                    }
+                    assert!(
+                        res.bytes_consumed > 0 || res.bytes_written > 0,
+                        "deflate made no progress"
+                    );
+                }
+                // No progress possible (e.g. flushing with nothing pending).
+                Err(MZError::Buf) if pos == chunk.len() => break,
+                Err(e) => panic!("deflate returned an error: {:?}", e),
+            }
+        }
+
+        // Drain any pending flush output without requesting another flush
+        // (calling with e.g. Sync again would emit additional sync blocks).
+        if flush != MZFlush::None {
+            loop {
+                let res = deflate(&mut compressor, &[], &mut buf, MZFlush::None);
+                match res.status {
+                    Ok(_) => {
+                        compressed.extend_from_slice(&buf[..res.bytes_written]);
+                        if res.bytes_written < buf.len() {
+                            break;
+                        }
+                    }
+                    Err(MZError::Buf) => break,
+                    Err(e) => panic!("deflate drain returned an error: {:?}", e),
+                }
+            }
+        }
+    }
+
+    // Finish the stream.
+    loop {
+        let res = deflate(&mut compressor, &[], &mut buf, MZFlush::Finish);
+        compressed.extend_from_slice(&buf[..res.bytes_written]);
+        match res.status.expect("deflate finish returned an error") {
+            MZStatus::StreamEnd => break,
+            MZStatus::Ok => (),
+            s => panic!("unexpected status while finishing: {:?}", s),
+        }
+    }
+
+    let decompressed = if zlib {
+        decompress_to_vec_zlib(&compressed)
+    } else {
+        decompress_to_vec(&compressed)
+    }
+    .expect("failed to decompress the streamed output");
+    assert_eq!(payload, decompressed);
+}
