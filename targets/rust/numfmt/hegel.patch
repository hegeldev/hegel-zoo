+//! Hegel properties for `numfmt` (the Hegel zoo).
+//!
+//! The reference is a small model of the crate's documented procedure — scale with the
+//! `Scales`, decide on scientific notation at the documented cut-offs, take the digits of the
+//! scaled value (the crate prints `dtoa`'s digits, so the model reads the same digits), group
+//! the integer part by threes with the separator, stop at the precision, decorate with prefix,
+//! unit and suffix — plus the crate's own `fmt_string`/`fmt_into` as oracles for `fmt2`, and
+//! the builder as the oracle for the format-string parser.
+
+use std::fmt::Debug;
+
+use hegel::{generators, TestCase};
+use numfmt::*;
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+fn n(tc: &TestCase, lo: usize, hi: usize) -> usize {
+    tc.draw(int!(lo as i64, hi as i64)) as usize
+}
+
+fn pick<T: Clone + Debug + Send + Sync + 'static>(tc: &TestCase, items: &[T]) -> T {
+    items[n(tc, 0, items.len() - 1)].clone()
+}
+
+/// True with probability `pct` percent.
+fn chance(tc: &TestCase, pct: usize) -> bool {
+    n(tc, 0, 99) < pct
+}
+
+// ---------------------------------------------------------------------------------------
+// Configurations
+// ---------------------------------------------------------------------------------------
+
+/// Units are at most 12 bytes long.
+const UNIT_POOL: &[&str] = &["", " a", "b", " kilo", " Mi", "-x", " Q", "u1234567890"];
+
+#[derive(Clone, Debug)]
+enum Scale {
+    None,
+    Short,
+    Metric,
+    Binary,
+    Custom(u16, Vec<&'static str>),
+}
+
+impl Scale {
+    fn scales(&self) -> Scales {
+        match self {
+            Scale::None => Scales::none(),
+            Scale::Short => Scales::short(),
+            Scale::Metric => Scales::metric(),
+            Scale::Binary => Scales::binary(),
+            Scale::Custom(base, units) => Scales::new(*base, units.clone()).unwrap(),
+        }
+    }
+
+    /// `(base, units)` as the model sees them; `Scales::none` never divides.
+    fn parts(&self) -> (f64, Vec<&'static str>) {
+        match self {
+            Scale::None => (f64::INFINITY, Vec::new()),
+            Scale::Short => (1000.0, vec!["", " K", " M", " B", " T", " P", " E", " Z", " Y"]),
+            Scale::Metric => (1000.0, vec![" ", " k", " M", " G", " T", " P", " E", " Z", " Y"]),
+            Scale::Binary => (
+                1024.0,
+                vec![" ", " ki", " Mi", " Gi", " Ti", " Pi", " Ei", " Zi", " Yi"],
+            ),
+            Scale::Custom(base, units) => (*base as f64, units.clone()),
+        }
+    }
+
+    /// The largest decade a number may start in and still be scaled below 10^12.
+    fn max_decade(&self) -> i32 {
+        let (base, units) = self.parts();
+        if units.len() <= 1 {
+            11
+        } else {
+            11 + (base.log10().floor() as i32) * (units.len() as i32 - 1)
+        }
+    }
+}
+
+fn arb_scale(tc: &TestCase) -> Scale {
+    match n(tc, 0, 4) {
+        0 => Scale::None,
+        1 => Scale::Short,
+        2 => Scale::Metric,
+        3 => Scale::Binary,
+        _ => {
+            let base = pick(tc, &[2u16, 7, 10, 60, 100, 1000, 1024, 4096, 65535]);
+            let count = n(tc, 0, 5);
+            let units = (0..count).map(|_| pick(tc, UNIT_POOL)).collect();
+            Scale::Custom(base, units)
+        }
+    }
+}
+
+/// Prefix/suffix pieces (the limits are 12 bytes).
+const DECOR_POOL: &[&str] = &["$", "AU$", "€", "£", "x", " ", "[", "]", "~", "%", "/", "1", "-"];
+
+fn arb_decor(tc: &TestCase, limit: usize) -> String {
+    let mut out = String::new();
+    for _ in 0..n(tc, 0, 3) {
+        let piece = pick(tc, DECOR_POOL);
+        if out.len() + piece.len() > limit {
+            break;
+        }
+        out.push_str(piece);
+    }
+    out
+}
+
+fn arb_precision(tc: &TestCase) -> Precision {
+    match n(tc, 0, 2) {
+        0 => Precision::Unspecified,
+        1 => Precision::Decimals(pick(tc, &[0u8, 1, 2, 3, 4, 5, 8, 17, 255])),
+        _ => Precision::Significance(pick(tc, &[0u8, 1, 2, 3, 4, 5, 8, 17, 255])),
+    }
+}
+
+#[derive(Clone, Debug)]
+struct Config {
+    prefix: String,
+    suffix: String,
+    /// Thousands separator (a single byte).
+    sep: Option<char>,
+    /// Comma as the decimal marker.
+    comma: bool,
+    precision: Precision,
+    scale: Scale,
+    /// `Formatter::percentage` — multiply by 100, suffix `%` unless another suffix is set.
+    percent: bool,
+}
+
+impl Config {
+    fn build(&self) -> Formatter {
+        let f = if self.percent { Formatter::percentage() } else { Formatter::new() };
+        // `comma` before `separator`: the two setters only keep the separator and the
+        // decimal marker apart in this order (numfmt/5 covers the others).
+        let mut f = f
+            .scales(self.scale.scales())
+            .precision(self.precision)
+            .comma(self.comma)
+            .separator(self.sep)
+            .unwrap();
+        if !self.prefix.is_empty() {
+            f = f.prefix(&self.prefix).unwrap();
+        }
+        if !self.suffix.is_empty() {
+            f = f.suffix(&self.suffix).unwrap();
+        }
+        f
+    }
+
+    fn marker(&self) -> char {
+        if self.comma {
+            ','
+        } else {
+            '.'
+        }
+    }
+
+    fn effective_suffix(&self) -> &str {
+        if self.suffix.is_empty() && self.percent {
+            "%"
+        } else {
+            &self.suffix
+        }
+    }
+}
+
+fn arb_config(tc: &TestCase) -> Config {
+    let comma = chance(tc, 30);
+    // The separator must differ from the decimal marker, and `.` as a separator switches the
+    // marker to a comma by itself — keep the general generator away from those shapes
+    // (numfmt/5 pins them).
+    let sep = loop {
+        let sep = pick(tc, &[None, Some(','), Some('.'), Some(' '), Some('_'), Some('\''), Some('/')]);
+        match sep {
+            Some(c) if c == '.' && !comma => continue,
+            Some(c) if c == ',' && comma => continue,
+            _ => break sep,
+        }
+    };
+    Config {
+        prefix: arb_decor(tc, 12),
+        suffix: arb_decor(tc, 12),
+        sep,
+        comma,
+        precision: arb_precision(tc),
+        scale: arb_scale(tc),
+        percent: chance(tc, 20),
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// Numbers
+// ---------------------------------------------------------------------------------------
+
+/// A finite, non-zero decimal number whose leading digit sits in decade `k` (10^k ≤ |x| <
+/// 10^(k+1)), with 1–17 significant digits.
+fn arb_decimal(tc: &TestCase, kmin: i32, kmax: i32) -> f64 {
+    let k = tc.draw(int!(kmin as i64, kmax as i64)) as i32;
+    let digits = n(tc, 1, 17);
+    let mut text = String::new();
+    if chance(tc, 30) {
+        text.push('-');
+    }
+    text.push(char::from(b'1' + n(tc, 0, 8) as u8));
+    text.push('.');
+    for _ in 1..digits {
+        text.push(char::from(b'0' + n(tc, 0, 9) as u8));
+    }
+    text.push('e');
+    text.push_str(&k.to_string());
+    text.parse().unwrap()
+}
+
+// ---------------------------------------------------------------------------------------
+// The model
+// ---------------------------------------------------------------------------------------
+
+/// `Scales::scale` as documented by its examples: divide by the base while the number is at
+/// least the base and units remain; the unit is the last one reached.
+fn model_scale(scale: &Scale, v: f64) -> (f64, &'static str) {
+    let (base, units) = scale.parts();
+    let mut num = v;
+    let mut unit = "";
+    let mut next = v;
+    for u in units {
+        num = next;
+        unit = u;
+        if num.abs() >= base {
+            next = num / base;
+        } else {
+            break;
+        }
+    }
+    (num, unit)
+}
+
+/// The lower cut-off for scientific notation: 10^-3, or 10^-d when the precision is 3 digits
+/// or fewer (the crate's adjustment "if decimals is low").
+fn small_cutoff(precision: Precision) -> f64 {
+    match precision {
+        Precision::Decimals(d) | Precision::Significance(d) if d <= 3 => 10f64.powi(-(d as i32)),
+        _ => 0.001,
+    }
+}
+
+/// Where the crate takes a number: the plain path (scaled value, unit) or scientific
+/// notation.
+enum Path {
+    Plain(f64, &'static str),
+    Scientific,
+}
+
+fn path(cfg: &Config, x: f64) -> Path {
+    let v = if cfg.percent { x * 100.0 } else { x };
+    let (scaled, unit) = model_scale(&cfg.scale, v);
+    let a = scaled.abs();
+    if a >= 1e12 || a < small_cutoff(cfg.precision) {
+        Path::Scientific
+    } else {
+        Path::Plain(scaled, unit)
+    }
+}
+
+fn group(int: &str, sep: Option<char>) -> String {
+    let Some(sep) = sep else { return int.to_string() };
+    let len = int.len();
+    let mut out = String::new();
+    for (i, ch) in int.chars().enumerate() {
+        out.push(ch);
+        let rest = len - 1 - i;
+        if rest > 0 && rest % 3 == 0 {
+            out.push(sep);
+        }
+    }
+    out
+}
+
+/// The fraction digits kept for `d` significant figures: leading zeros are not significant;
+/// once the integer digits alone reach `d`, no fraction is printed (the crate never rounds or
+/// drops integer digits).
+fn significant_fraction(int: &str, frac: &str, d: u8) -> String {
+    let d = d as usize;
+    let mut sig = if int == "0" { 0 } else { int.len() };
+    if sig >= d {
+        return String::new();
+    }
+    let mut out = String::new();
+    for c in frac.chars() {
+        out.push(c);
+        if sig > 0 || c != '0' {
+            sig += 1;
+        }
+        if sig >= d {
+            break;
+        }
+    }
+    out
+}
+
+/// The expected text on the plain path.
+fn model_plain(cfg: &Config, scaled: f64, unit: &str) -> String {
+    let mut buffer = dtoa::Buffer::new();
+    let text = buffer.format(scaled);
+    let (neg, text) = match text.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, text),
+    };
+    let (int, frac) = text
+        .split_once('.')
+        .unwrap_or_else(|| panic!("dtoa prints a decimal point in this range: {text}"));
+    let frac = match cfg.precision {
+        Precision::Unspecified => frac.to_string(),
+        Precision::Decimals(d) => frac.chars().take(d as usize).collect(),
+        Precision::Significance(d) => significant_fraction(int, frac, d),
+    };
+    let mut out = cfg.prefix.clone();
+    if neg {
+        out.push('-');
+    }
+    out.push_str(&group(int, cfg.sep));
+    if !frac.is_empty() {
+        out.push(cfg.marker());
+        out.push_str(&frac);
+    }
+    out.push_str(unit);
+    out.push_str(cfg.effective_suffix());
+    out
+}
+
+/// A number for `cfg` that the crate formats on the plain path (almost always): its leading
+/// decade is between the small cut-off and what the scales bring below 10^12.
+fn arb_plain_number(tc: &TestCase, cfg: &Config) -> f64 {
+    let shift = if cfg.percent { 2 } else { 0 };
+    let kmin = match cfg.precision {
+        // Leading zeros and significance: numfmt/2 — the general generator stays at |x| ≥ 1.
+        Precision::Significance(_) => 0,
+        Precision::Decimals(d) if d <= 3 => -(d as i32),
+        _ => -3,
+    } - shift;
+    let kmax = cfg.scale.max_decade() - shift;
+    arb_decimal(tc, kmin, kmax.max(kmin))
+}
+
+// ---------------------------------------------------------------------------------------
+// Properties: formatting
+// ---------------------------------------------------------------------------------------
+
+/// Plain-path formatting is the model: dtoa's digits of the scaled value, grouped by threes,
+/// truncated at the precision, decorated.
+#[hegel::test]
+fn plain_numbers_match_the_model(tc: TestCase) {
+    let cfg = arb_config(&tc);
+    let x = arb_plain_number(&tc, &cfg);
+    let Path::Plain(scaled, unit) = path(&cfg, x) else {
+        tc.assume(false);
+        return;
+    };
+    let expected = model_plain(&cfg, scaled, unit);
+    let mut f = cfg.build();
+    assert_eq!(f.fmt2(x), expected, "{cfg:?} formatting {x:e}");
+    assert_eq!(f.fmt_string(x), expected, "{cfg:?} fmt_string {x:e}");
+}
+
+/// The scaled value and unit are the documented ones.
+#[hegel::test]
+fn scaling_picks_the_largest_unit_reached(tc: TestCase) {
+    let scale = arb_scale(&tc);
+    let x = arb_decimal(&tc, -5, 40);
+    let (num, unit) = scale.scales().scale(x);
+    let (expected_num, expected_unit) = model_scale(&scale, x);
+    assert_eq!((num, unit), (expected_num, expected_unit), "{scale:?} scaling {x:e}");
+}
+
+/// Scientific notation: `<prefix>-?M e E<suffix>` with 1 ≤ |M| < 10, E the decimal exponent of
+/// the number, and M truncated at the precision (7 significant figures unless set).
+#[hegel::test]
+fn scientific_notation_is_normalised(tc: TestCase) {
+    let cfg = arb_config(&tc);
+    let shift = if cfg.percent { 2 } else { 0 };
+    // Subnormals are numfmt/7; stay at |x| ≥ 1e-300 (and below 1e300, where `x * 100`
+    // stays finite — numfmt/6).
+    let x = if chance(&tc, 50) {
+        arb_decimal(&tc, 12 - shift, 300 - shift)
+    } else {
+        arb_decimal(&tc, -300 - shift, -4 - shift)
+    };
+    let Path::Scientific = path(&cfg, x) else {
+        tc.assume(false);
+        return;
+    };
+    let v = if cfg.percent { x * 100.0 } else { x };
+    let mut f = cfg.build();
+    let out = f.fmt2(x).to_string();
+    let body = out
+        .strip_prefix(cfg.prefix.as_str())
+        .unwrap_or_else(|| panic!("{out:?} lacks the prefix {:?}", cfg.prefix));
+    let body = body
+        .strip_suffix(cfg.effective_suffix())
+        .unwrap_or_else(|| panic!("{out:?} lacks the suffix {:?}", cfg.effective_suffix()));
+    let (mantissa, exponent) = body
+        .split_once('e')
+        .unwrap_or_else(|| panic!("{out:?} is not scientific notation"));
+    let exponent: i32 = exponent.parse().unwrap_or_else(|_| panic!("{out:?}: bad exponent"));
+    // The mantissa uses the configured decimal marker.
+    let mantissa = mantissa.replace(cfg.marker(), ".");
+    let m: f64 = mantissa.parse().unwrap_or_else(|_| panic!("{out:?}: bad mantissa"));
+    let digits = mantissa.trim_start_matches('-');
+    let int = digits.split_once('.').map(|(i, _)| i).unwrap_or(digits);
+    assert!(
+        int.len() == 1 && int != "0",
+        "{out:?} for {x:e}: the mantissa {mantissa} is not in [1, 10)"
+    );
+    // The decimal exponent of v, from its shortest representation.
+    let true_exponent: i32 = format!("{v:e}").split_once('e').unwrap().1.parse().unwrap();
+    assert_eq!(exponent, true_exponent, "{out:?} for {x:e}: exponent");
+    let kept = match cfg.precision {
+        Precision::Unspecified => 6,
+        Precision::Decimals(d) => d as i32,
+        Precision::Significance(d) => d as i32 - 1,
+    };
+    let tolerance = 2.0 * 10f64.powi(-kept.max(0)) + 1e-12;
+    let value = m * 10f64.powi(exponent);
+    assert!(
+        ((value - v) / v).abs() <= tolerance,
+        "{out:?} for {x:e}: mantissa off by more than truncation allows"
+    );
+}
+
+/// Formatting has no state: `fmt2` on a reused formatter, `fmt_string`, `fmt_into` (appended
+/// after arbitrary text) and a fresh formatter all agree.
+#[hegel::test]
+fn formatting_is_stateless(tc: TestCase) {
+    let cfg = arb_config(&tc);
+    let mut f = cfg.build();
+    for _ in 0..n(&tc, 1, 6) {
+        // Zero, NaN and the infinities overwrite the prefix (numfmt/1): the general generator
+        // uses them only without a prefix.
+        let x = if cfg.prefix.is_empty() && chance(&tc, 20) {
+            pick(&tc, &[0.0, -0.0, f64::NAN, f64::INFINITY, f64::NEG_INFINITY])
+        } else if chance(&tc, 50) {
+            arb_plain_number(&tc, &cfg)
+        } else {
+            arb_decimal(&tc, -300, 300)
+        };
+        let fresh = cfg.build().fmt2(x).to_string();
+        assert_eq!(f.fmt2(x), fresh, "{cfg:?}: fmt2 after earlier calls, {x:e}");
+        assert_eq!(f.fmt_string(x), fresh, "{cfg:?}: fmt_string, {x:e}");
+        let lead = arb_decor(&tc, 12);
+        let mut buf = lead.clone();
+        f.fmt_into(&mut buf, x);
+        assert_eq!(buf, format!("{lead}{fresh}"), "{cfg:?}: fmt_into, {x:e}");
+    }
+}
+
+/// Integers format as their `f64` value.
+#[hegel::test]
+fn integers_format_as_their_float_value(tc: TestCase) {
+    let cfg = arb_config(&tc);
+    let f = cfg.build();
+    let i = tc.draw(int!(i64::MIN, i64::MAX));
+    // Zero over a multi-byte prefix is numfmt/1 (an invalid-UTF-8 `String`): with a prefix,
+    // none of the narrowed values may be zero.
+    tc.assume(cfg.prefix.is_empty() || (i as i8 != 0 && i as u16 != 0 && i as i32 != 0));
+    let u = i as u64;
+    assert_eq!(f.fmt_string(i), f.fmt_string(i as f64), "i64 {i}");
+    assert_eq!(f.fmt_string(u), f.fmt_string(u as f64), "u64 {u}");
+    assert_eq!(f.fmt_string(i as i32), f.fmt_string(i as i32 as f64), "i32");
+    assert_eq!(f.fmt_string(i as u16), f.fmt_string(i as u16 as f64), "u16");
+    assert_eq!(f.fmt_string(i as i8), f.fmt_string(i as i8 as f64), "i8");
+    assert_eq!(f.fmt_string(i as f32), f.fmt_string(i as f32 as f64), "f32");
+}
+
+/// After any sequence of `separator`/`comma` calls the thousands separator and the decimal
+/// marker differ.
+#[hegel::test]
+fn separator_never_doubles_as_decimal_marker(tc: TestCase) {
+    let mut f = Formatter::new();
+    let mut trace = Vec::new();
+    for _ in 0..n(&tc, 1, 4) {
+        if chance(&tc, 50) {
+            let sep = pick(&tc, &[None, Some(','), Some('.'), Some(' '), Some('_')]);
+            trace.push(format!("separator({sep:?})"));
+            f = f.separator(sep).unwrap();
+        } else {
+            let comma = chance(&tc, 50);
+            trace.push(format!("comma({comma})"));
+            f = f.comma(comma);
+        }
+    }
+    let out = f.fmt2(1234567.891).to_string();
+    let ok = [None, Some(','), Some('.'), Some(' '), Some('_')]
+        .iter()
+        .flat_map(|sep| [',', '.'].map(|marker| (*sep, marker)))
+        .filter(|(sep, marker)| *sep != Some(*marker))
+        .any(|(sep, marker)| {
+            let s = sep.map(String::from).unwrap_or_default();
+            out == format!("1{s}234{s}567{marker}891")
+        });
+    assert!(ok, "{}: {out:?} does not separate the fraction from the groups", trace.join("."));
+}
+
+// ---------------------------------------------------------------------------------------
+// Properties: the format-string parser
+// ---------------------------------------------------------------------------------------
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Scaler {
+    Percent,
+    Short,
+    Metric,
+    Binary,
+    No,
+}
+
+#[derive(Clone, Debug)]
+enum PrecisionSpec {
+    None,
+    Decimals(bool, u8),
+    Significance(u8),
+    Unspecified(bool),
+}
+
+#[derive(Clone, Debug)]
+struct Spec {
+    prefix: String,
+    suffix: String,
+    precision: PrecisionSpec,
+    scaler: Option<Scaler>,
+    /// `None`: not given (default `,`); `Some(None)`: `/]` (no separator); `Some(Some(c))`.
+    sep: Option<Option<char>>,
+    /// Render the whole string as a bare prefix (no brackets).
+    bare: bool,
+}
+
+const SPEC_DECOR_POOL: &[&str] = &["$", "AU$", "€", "x", " ", "[", "]", "~", "%", "/", "1", ".", ","];
+
+fn arb_spec_decor(tc: &TestCase, limit: usize) -> String {
+    let mut out = String::new();
+    let mut last_bracket: Option<&str> = None;
+    for _ in 0..n(tc, 0, 3) {
+        let piece = pick(tc, SPEC_DECOR_POOL);
+        let bracket = matches!(piece, "[" | "]");
+        // Two escaped brackets of the same kind in a row: numfmt/8.
+        if bracket && last_bracket == Some(piece) {
+            continue;
+        }
+        if out.len() + piece.len() > limit {
+            break;
+        }
+        out.push_str(piece);
+        last_bracket = if bracket { Some(piece) } else { None };
+    }
+    out
+}
+
+fn escape(s: &str) -> String {
+    s.replace('[', "[[").replace(']', "]]")
+}
+
+impl Spec {
+    fn comma(&self) -> bool {
+        matches!(self.precision, PrecisionSpec::Decimals(true, _) | PrecisionSpec::Unspecified(true))
+            || self.sep == Some(Some('.'))
+    }
+
+    fn render(&self, tc: &TestCase) -> String {
+        if self.bare {
+            return escape(&self.prefix);
+        }
+        let precision = match self.precision {
+            PrecisionSpec::None => String::new(),
+            PrecisionSpec::Decimals(comma, d) => format!("{}{d}", if comma { ',' } else { '.' }),
+            PrecisionSpec::Significance(d) => format!("~{d}"),
+            PrecisionSpec::Unspecified(comma) => format!("{}*", if comma { ',' } else { '.' }),
+        };
+        let scaler = match self.scaler {
+            None => "",
+            Some(Scaler::Percent) => "%",
+            Some(Scaler::Short) => "s",
+            Some(Scaler::Metric) => "m",
+            Some(Scaler::Binary) => "b",
+            Some(Scaler::No) => "n",
+        }
+        .to_string();
+        let sep = match self.sep {
+            None => String::new(),
+            Some(None) => "/".to_string(),
+            Some(Some(c)) => format!("/{c}"),
+        };
+        // The order inside the brackets is arbitrary, except that `/]` (no separator) must
+        // come last.
+        let mut parts = vec![precision, scaler];
+        let insert = if self.sep == Some(None) { parts.len() } else { n(tc, 0, parts.len()) };
+        parts.insert(insert, sep);
+        if chance(tc, 50) {
+            parts.swap(0, 1.min(insert.saturating_sub(1)));
+        }
+        format!("{}[{}]{}", escape(&self.prefix), parts.concat(), escape(&self.suffix))
+    }
+
+    /// The builder equivalent, as the module documentation describes each component.
+    fn expected(&self) -> Formatter {
+        if self.bare {
+            return Formatter::default().prefix(&self.prefix).unwrap();
+        }
+        let mut f = match self.scaler {
+            Some(Scaler::Percent) => Formatter::percentage().separator(',').unwrap(),
+            None | Some(Scaler::Short) => Formatter::default(),
+            Some(Scaler::Metric) => Formatter::default().scales(Scales::metric()),
+            Some(Scaler::Binary) => Formatter::default().scales(Scales::binary()),
+            Some(Scaler::No) => Formatter::default().scales(Scales::none()),
+        };
+        if let Some(sep) = self.sep {
+            f = f.separator(sep).unwrap();
+        }
+        f = f.prefix(&self.prefix).unwrap();
+        let suffix = if self.scaler == Some(Scaler::Percent) {
+            format!("%{}", self.suffix)
+        } else {
+            self.suffix.clone()
+        };
+        f = f.suffix(&suffix).unwrap();
+        f = f.comma(self.comma());
+        match self.precision {
+            PrecisionSpec::None => {}
+            PrecisionSpec::Decimals(_, d) => f = f.precision(Precision::Decimals(d)),
+            PrecisionSpec::Significance(d) => f = f.precision(Precision::Significance(d)),
+            PrecisionSpec::Unspecified(_) => f = f.precision(Precision::Unspecified),
+        }
+        f
+    }
+}
+
+fn arb_spec(tc: &TestCase) -> Spec {
+    let precision = match n(tc, 0, 3) {
+        0 => PrecisionSpec::None,
+        1 => PrecisionSpec::Decimals(chance(tc, 50), n(tc, 0, 255) as u8),
+        2 => PrecisionSpec::Significance(n(tc, 0, 255) as u8),
+        _ => PrecisionSpec::Unspecified(chance(tc, 50)),
+    };
+    let scaler = pick(
+        tc,
+        &[None, Some(Scaler::Percent), Some(Scaler::Short), Some(Scaler::Metric), Some(Scaler::Binary), Some(Scaler::No)],
+    );
+    let comma_precision =
+        matches!(precision, PrecisionSpec::Decimals(true, _) | PrecisionSpec::Unspecified(true));
+    let sep = loop {
+        let sep = pick(tc, &[None, Some(None), Some(Some(',')), Some(Some('.')), Some(Some(' ')), Some(Some('_')), Some(Some('/')), Some(Some('x')), Some(Some('%')), Some(Some('n')), Some(Some('~'))]);
+        // `,` as the separator with a comma decimal marker: numfmt/5.
+        if comma_precision && sep == Some(Some(',')) {
+            continue;
+        }
+        break sep;
+    };
+    let suffix_limit = if scaler == Some(Scaler::Percent) { 11 } else { 12 };
+    Spec {
+        prefix: arb_spec_decor(tc, 12),
+        suffix: arb_spec_decor(tc, suffix_limit),
+        precision,
+        scaler,
+        sep,
+        bare: chance(tc, 10),
+    }
+}
+
+const PARSE_SAMPLES: &[f64] = &[0.5, 1.0, 1234.5678, -9876543.21, 0.0001234, 1e15, 12.0, 1e-9];
+
+/// A format string parses to the formatter its components describe.
+#[hegel::test]
+fn format_strings_parse_to_their_builder_equivalent(tc: TestCase) {
+    let spec = arb_spec(&tc);
+    let text = spec.render(&tc);
+    let parsed: Formatter = text
+        .parse()
+        .unwrap_or_else(|e| panic!("{text:?} ({spec:?}) failed to parse: {e}"));
+    let expected = spec.expected();
+    assert_eq!(parsed, expected, "{text:?} ({spec:?})");
+    for &x in PARSE_SAMPLES {
+        assert_eq!(parsed.fmt_string(x), expected.fmt_string(x), "{text:?} ({spec:?}) formatting {x}");
+    }
+}
+
+/// Parsing any string returns `Ok` or a `ParseError`, and a parsed formatter formats.
+#[hegel::test]
+fn parsing_never_panics(tc: TestCase) {
+    const ALPHABET: &[char] = &['[', ']', '.', ',', '~', '/', '*', '%', 's', 'm', 'b', 'n', '0', '1', '5', '9', 'a', ' ', 'é'];
+    let text: String = (0..n(&tc, 0, 14)).map(|_| pick(&tc, ALPHABET)).collect();
+    match text.parse::<Formatter>() {
+        Ok(mut f) => {
+            f.fmt2(1234.5);
+            f.fmt2(-0.001);
+        }
+        Err(e) => {
+            let _ = e.to_string();
+        }
+    }
+}
