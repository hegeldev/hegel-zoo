+//! Hegel properties for `numfmt` (the Hegel zoo).
+//!
+//! The reference is a small model of the crate's documented procedure — scale with the
+//! `Scales`, decide on scientific notation at the documented cut-offs, take the digits of the
+//! scaled value (the crate prints `dtoa`'s digits, so the model reads the same digits), group
+//! the integer part by threes with the separator, stop at the precision, decorate with prefix,
+//! unit and suffix — plus the crate's own `fmt_string`/`fmt_into` as oracles for `fmt2`, and
+//! the builder as the oracle for the format-string parser.
+//!
+//! The generators are values: a property draws one `Config` (prefix, suffix, separator, marker,
+//! precision, scale, percentage) and, through `with_config`, the number or the steps whose
+//! range depends on it; the parser property draws one `Spec` and renders it with a pure
+//! function.  Everything is built from `tuples!`, `one_of!`, `sampled_from`, `vecs`, `text` and
+//! a `weighted` choice (one integer `flat_map`ped to the alternative it selects), the absent or
+//! plainest alternative first, so a shrunk case is a bare formatter and a one-digit number.
+//! Known-bug shapes stay out by construction: the separator pool depends on the marker
+//! (numfmt/5), the decades of a plain number on the precision (numfmt/2), a special value
+//! comes only without a prefix (numfmt/1), and a bracket never follows the same bracket in a
+//! format string's decoration (numfmt/8).
+
+use hegel::generators::{self, BoxedPrintableGenerator, Generator as _};
+use hegel::{PrintableGenerator, TestCase};
+use numfmt::*;
+
+// ---------------------------------------------------------------------------------------
+// Generator helpers
+// ---------------------------------------------------------------------------------------
+
+fn ints(lo: i64, hi: i64) -> generators::IntegerGenerator<i64> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// True `p` of the time; shrinks to false.
+fn chance(p: f64) -> generators::BoolGenerator {
+    generators::weighted_booleans(p)
+}
+
+/// A weight and an alternative for [`weighted`].
+fn w<T>(
+    weight: u32,
+    g: impl PrintableGenerator<T> + Send + Sync + 'static,
+) -> (u32, BoxedPrintableGenerator<'static, T>) {
+    (weight, g.boxed_printable())
+}
+
+/// One of the alternatives, each as often as its weight says: one integer draw `flat_map`ped to
+/// the alternative whose cumulative weight it falls under, so only the chosen one is drawn and
+/// the choice shrinks to the first alternative.  (Hegel has no weighted `one_of!`.)
+fn weighted<T: 'static>(
+    choices: Vec<(u32, BoxedPrintableGenerator<'static, T>)>,
+) -> impl PrintableGenerator<T> {
+    let total: u32 = choices.iter().map(|(weight, _)| weight).sum();
+    ints(0, i64::from(total) - 1).flat_map(move |x| {
+        let mut x = x as u32;
+        for (weight, g) in &choices {
+            if x < *weight {
+                return g.clone();
+            }
+            x -= weight;
+        }
+        unreachable!()
+    })
+}
+
+// ---------------------------------------------------------------------------------------
+// Configurations
+// ---------------------------------------------------------------------------------------
+
+/// Units are at most 12 bytes long.
+const UNIT_POOL: &[&str] = &["", " a", "b", " kilo", " Mi", "-x", " Q", "u1234567890"];
+
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Scale {
+    None,
+    Short,
+    Metric,
+    Binary,
+    Custom(u16, Vec<&'static str>),
+}
+
+impl Scale {
+    fn scales(&self) -> Scales {
+        match self {
+            Scale::None => Scales::none(),
+            Scale::Short => Scales::short(),
+            Scale::Metric => Scales::metric(),
+            Scale::Binary => Scales::binary(),
+            Scale::Custom(base, units) => Scales::new(*base, units.clone()).unwrap(),
+        }
+    }
+
+    /// `(base, units)` as the model sees them; `Scales::none` never divides.
+    fn parts(&self) -> (f64, Vec<&'static str>) {
+        match self {
+            Scale::None => (f64::INFINITY, Vec::new()),
+            Scale::Short => (1000.0, vec!["", " K", " M", " B", " T", " P", " E", " Z", " Y"]),
+            Scale::Metric => (1000.0, vec![" ", " k", " M", " G", " T", " P", " E", " Z", " Y"]),
+            Scale::Binary => (
+                1024.0,
+                vec![" ", " ki", " Mi", " Gi", " Ti", " Pi", " Ei", " Zi", " Yi"],
+            ),
+            Scale::Custom(base, units) => (*base as f64, units.clone()),
+        }
+    }
+
+    /// The largest decade a number may start in and still be scaled below 10^12.
+    fn max_decade(&self) -> i32 {
+        let (base, units) = self.parts();
+        if units.len() <= 1 {
+            11
+        } else {
+            11 + (base.log10().floor() as i32) * (units.len() as i32 - 1)
+        }
+    }
+}
+
+const BUILTIN_SCALES: &[Scale] = &[Scale::None, Scale::Short, Scale::Metric, Scale::Binary];
+const BASES: &[u16] = &[2, 7, 10, 60, 100, 1000, 1024, 4096, 65535];
+
+/// One of the four built-in scales, or one time in five a custom one: a base and up to five
+/// units.
+fn scale() -> impl PrintableGenerator<Scale> {
+    let custom = hegel::tuples!(
+        generators::sampled_from(BASES),
+        generators::vecs(generators::sampled_from(UNIT_POOL)).max_size(5)
+    )
+    .map(|(base, units)| Scale::Custom(base, units));
+    weighted(vec![w(4, generators::sampled_from(BUILTIN_SCALES)), w(1, custom)])
+}
+
+/// Prefix/suffix pieces: at most three bytes each, so three of them stay within the 12-byte
+/// limit.
+const DECOR_POOL: &[&str] = &["$", "AU$", "€", "£", "x", " ", "[", "]", "~", "%", "/", "1", "-"];
+
+/// Up to three pieces of the pool.
+fn decor() -> impl PrintableGenerator<String> {
+    generators::vecs(generators::sampled_from(DECOR_POOL))
+        .max_size(3)
+        .map(|pieces| pieces.concat())
+}
+
+const PRECISION_DIGITS: &[u8] = &[0, 1, 2, 3, 4, 5, 8, 17, 255];
+
+/// Unspecified, decimals or significant figures, equally often.
+fn precision() -> impl PrintableGenerator<Precision> {
+    hegel::one_of!(
+        generators::just(Precision::Unspecified),
+        generators::sampled_from(PRECISION_DIGITS).map(Precision::Decimals),
+        generators::sampled_from(PRECISION_DIGITS).map(Precision::Significance),
+    )
+    .print_as_debug()
+}
+
+/// The separators that go with a period as the decimal marker, and with a comma.  The
+/// separator must differ from the marker, and `.` as a separator switches the marker to a
+/// comma by itself — the general generator keeps away from those shapes (numfmt/5 pins them).
+const PERIOD_MARKER_SEPARATORS: &[Option<char>] =
+    &[None, Some(','), Some(' '), Some('_'), Some('\''), Some('/')];
+const COMMA_MARKER_SEPARATORS: &[Option<char>] =
+    &[None, Some('.'), Some(' '), Some('_'), Some('\''), Some('/')];
+
+/// The decimal marker (a comma three times in ten) and a separator that differs from it.
+fn marker_and_separator() -> impl PrintableGenerator<(bool, Option<char>)> {
+    chance(0.3).flat_map(|comma| {
+        let pool = if comma { COMMA_MARKER_SEPARATORS } else { PERIOD_MARKER_SEPARATORS };
+        generators::sampled_from(pool).map(move |sep| (comma, sep))
+    })
+}
+
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Config {
+    prefix: String,
+    suffix: String,
+    /// Thousands separator (a single byte).
+    sep: Option<char>,
+    /// Comma as the decimal marker.
+    comma: bool,
+    #[pretty(debug)]
+    precision: Precision,
+    scale: Scale,
+    /// `Formatter::percentage` — multiply by 100, suffix `%` unless another suffix is set.
+    percent: bool,
+}
+
+impl Config {
+    fn build(&self) -> Formatter {
+        let f = if self.percent { Formatter::percentage() } else { Formatter::new() };
+        // `comma` before `separator`: the two setters only keep the separator and the
+        // decimal marker apart in this order (numfmt/5 covers the others).
+        let mut f = f
+            .scales(self.scale.scales())
+            .precision(self.precision)
+            .comma(self.comma)
+            .separator(self.sep)
+            .unwrap();
+        if !self.prefix.is_empty() {
+            f = f.prefix(&self.prefix).unwrap();
+        }
+        if !self.suffix.is_empty() {
+            f = f.suffix(&self.suffix).unwrap();
+        }
+        f
+    }
+
+    fn marker(&self) -> char {
+        if self.comma {
+            ','
+        } else {
+            '.'
+        }
+    }
+
+    fn effective_suffix(&self) -> &str {
+        if self.suffix.is_empty() && self.percent {
+            "%"
+        } else {
+            &self.suffix
+        }
+    }
+}
+
+/// A prefix and a suffix, a marker with a separator that differs from it, a precision, a scale,
+/// and one time in five a percentage.
+fn config() -> impl PrintableGenerator<Config> {
+    hegel::tuples!(decor(), decor(), marker_and_separator(), precision(), scale(), chance(0.2)).map(
+        |(prefix, suffix, (comma, sep), precision, scale, percent)| Config {
+            prefix,
+            suffix,
+            sep,
+            comma,
+            precision,
+            scale,
+            percent,
+        },
+    )
+}
+
+/// A configuration and a value drawn for it (the value's range depends on the configuration).
+fn with_config<T, G>(
+    value: impl Fn(&Config) -> G + Send + Sync,
+) -> impl PrintableGenerator<(Config, T)>
+where
+    T: hegel::PrettyPrintable,
+    G: PrintableGenerator<T>,
+{
+    config().flat_map(move |cfg| hegel::tuples!(generators::just(cfg.clone()), value(&cfg)))
+}
+
+// ---------------------------------------------------------------------------------------
+// Numbers
+// ---------------------------------------------------------------------------------------
+
+const DIGITS: &str = "0123456789";
+
+/// A finite, non-zero decimal number whose leading digit sits in decade `k` (10^k ≤ |x| <
+/// 10^(k+1)), with 1–17 significant digits, negative three times in ten.
+fn decimal(kmin: i32, kmax: i32) -> impl PrintableGenerator<f64> {
+    hegel::tuples!(
+        ints(kmin as i64, kmax as i64),
+        chance(0.3),
+        ints(1, 9),
+        generators::text().alphabet(DIGITS).max_size(16)
+    )
+    .map(|(k, negative, lead, rest)| {
+        let sign = if negative { "-" } else { "" };
+        format!("{sign}{lead}.{rest}e{k}").parse().unwrap()
+    })
+}
+
+// ---------------------------------------------------------------------------------------
+// The model
+// ---------------------------------------------------------------------------------------
+
+/// `Scales::scale` as documented by its examples: divide by the base while the number is at
+/// least the base and units remain; the unit is the last one reached.
+fn model_scale(scale: &Scale, v: f64) -> (f64, &'static str) {
+    let (base, units) = scale.parts();
+    let mut num = v;
+    let mut unit = "";
+    let mut next = v;
+    for u in units {
+        num = next;
+        unit = u;
+        if num.abs() >= base {
+            next = num / base;
+        } else {
+            break;
+        }
+    }
+    (num, unit)
+}
+
+/// The lower cut-off for scientific notation: 10^-3, or 10^-d when the precision is 3 digits
+/// or fewer (the crate's adjustment "if decimals is low").
+fn small_cutoff(precision: Precision) -> f64 {
+    match precision {
+        Precision::Decimals(d) | Precision::Significance(d) if d <= 3 => 10f64.powi(-(d as i32)),
+        _ => 0.001,
+    }
+}
+
+/// Where the crate takes a number: the plain path (scaled value, unit) or scientific
+/// notation.
+enum Path {
+    Plain(f64, &'static str),
+    Scientific,
+}
+
+fn path(cfg: &Config, x: f64) -> Path {
+    let v = if cfg.percent { x * 100.0 } else { x };
+    let (scaled, unit) = model_scale(&cfg.scale, v);
+    let a = scaled.abs();
+    if a >= 1e12 || a < small_cutoff(cfg.precision) {
+        Path::Scientific
+    } else {
+        Path::Plain(scaled, unit)
+    }
+}
+
+fn group(int: &str, sep: Option<char>) -> String {
+    let Some(sep) = sep else { return int.to_string() };
+    let len = int.len();
+    let mut out = String::new();
+    for (i, ch) in int.chars().enumerate() {
+        out.push(ch);
+        let rest = len - 1 - i;
+        if rest > 0 && rest % 3 == 0 {
+            out.push(sep);
+        }
+    }
+    out
+}
+
+/// The fraction digits kept for `d` significant figures: leading zeros are not significant;
+/// once the integer digits alone reach `d`, no fraction is printed (the crate never rounds or
+/// drops integer digits).
+fn significant_fraction(int: &str, frac: &str, d: u8) -> String {
+    let d = d as usize;
+    let mut sig = if int == "0" { 0 } else { int.len() };
+    if sig >= d {
+        return String::new();
+    }
+    let mut out = String::new();
+    for c in frac.chars() {
+        out.push(c);
+        if sig > 0 || c != '0' {
+            sig += 1;
+        }
+        if sig >= d {
+            break;
+        }
+    }
+    out
+}
+
+/// The expected text on the plain path.
+fn model_plain(cfg: &Config, scaled: f64, unit: &str) -> String {
+    let mut buffer = dtoa::Buffer::new();
+    let text = buffer.format(scaled);
+    let (neg, text) = match text.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, text),
+    };
+    let (int, frac) = text
+        .split_once('.')
+        .unwrap_or_else(|| panic!("dtoa prints a decimal point in this range: {text}"));
+    let frac = match cfg.precision {
+        Precision::Unspecified => frac.to_string(),
+        Precision::Decimals(d) => frac.chars().take(d as usize).collect(),
+        Precision::Significance(d) => significant_fraction(int, frac, d),
+    };
+    let mut out = cfg.prefix.clone();
+    if neg {
+        out.push('-');
+    }
+    out.push_str(&group(int, cfg.sep));
+    if !frac.is_empty() {
+        out.push(cfg.marker());
+        out.push_str(&frac);
+    }
+    out.push_str(unit);
+    out.push_str(cfg.effective_suffix());
+    out
+}
+
+/// A number for `cfg` that the crate formats on the plain path (almost always): its leading
+/// decade is between the small cut-off and what the scales bring below 10^12.
+fn plain_number(cfg: &Config) -> impl PrintableGenerator<f64> {
+    let shift = if cfg.percent { 2 } else { 0 };
+    let kmin = match cfg.precision {
+        // Leading zeros and significance: numfmt/2 — the general generator stays at |x| ≥ 1.
+        Precision::Significance(_) => 0,
+        Precision::Decimals(d) if d <= 3 => -(d as i32),
+        _ => -3,
+    } - shift;
+    let kmax = cfg.scale.max_decade() - shift;
+    decimal(kmin, kmax.max(kmin))
+}
+
+/// numfmt/4: the crate places the separators from `log10().trunc()`, which rounds up to the
+/// next integer for a value within a few ulps below a power of ten (`999999.9999999999`, or
+/// `1e28` brought to `9999.999999999998` by the Short scale's eight divisions), so with a
+/// separator and three or more integer digits every separator lands one digit early.  The
+/// general property keeps away from that shape; the pin
+/// `grouping_is_by_three_digits_below_a_power_of_ten` has it.
+fn grouped_from_a_rounded_log10(cfg: &Config, x: f64) -> bool {
+    if cfg.sep.is_none() {
+        return false;
+    }
+    let Path::Plain(scaled, _) = path(cfg, x) else { return false };
+    let a = scaled.abs();
+    let mut buffer = dtoa::Buffer::new();
+    let text = buffer.format(a);
+    let int_digits = text.split_once('.').map_or(text.len(), |(int, _)| int.len());
+    a >= 1.0 && int_digits >= 3 && a.log10().trunc() as i32 != int_digits as i32 - 1
+}
+
+/// A number for `cfg` that the crate formats in scientific notation (almost always): its
+/// leading decade is above what the scales bring below 10^12 (and at most 300 — above 1e300,
+/// `x * 100` overflows, numfmt/6), or below the small cut-off (and at least -300 — subnormals
+/// are numfmt/7).
+fn scientific_number(cfg: &Config) -> impl PrintableGenerator<f64> {
+    let shift = if cfg.percent { 2 } else { 0 };
+    let large = cfg.scale.max_decade().max(11) + 1 - shift;
+    hegel::one_of!(decimal(large, 300 - shift), decimal(-300 - shift, -4 - shift))
+}
+
+// ---------------------------------------------------------------------------------------
+// Properties: formatting
+// ---------------------------------------------------------------------------------------
+
+/// Plain-path formatting is the model: dtoa's digits of the scaled value, grouped by threes,
+/// truncated at the precision, decorated.
+#[hegel::test]
+fn plain_numbers_match_the_model(tc: TestCase) {
+    let (cfg, x) =
+        tc.draw(with_config(plain_number).filter(|(cfg, x)| !grouped_from_a_rounded_log10(cfg, *x)));
+    let Path::Plain(scaled, unit) = path(&cfg, x) else {
+        tc.assume(false);
+        return;
+    };
+    let expected = model_plain(&cfg, scaled, unit);
+    let mut f = cfg.build();
+    assert_eq!(f.fmt2(x), expected, "{cfg:?} formatting {x:e}");
+    assert_eq!(f.fmt_string(x), expected, "{cfg:?} fmt_string {x:e}");
+}
+
+/// The scaled value and unit are the documented ones.
+#[hegel::test]
+fn scaling_picks_the_largest_unit_reached(tc: TestCase) {
+    let (scale, x) = tc.draw(hegel::tuples!(scale(), decimal(-5, 40)));
+    let (num, unit) = scale.scales().scale(x);
+    let (expected_num, expected_unit) = model_scale(&scale, x);
+    assert_eq!((num, unit), (expected_num, expected_unit), "{scale:?} scaling {x:e}");
+}
+
+/// Scientific notation: `<prefix>-?M e E<suffix>` with 1 ≤ |M| < 10, E the decimal exponent of
+/// the number, and M truncated at the precision (7 significant figures unless set).
+#[hegel::test]
+fn scientific_notation_is_normalised(tc: TestCase) {
+    let (cfg, x) = tc.draw(with_config(scientific_number));
+    tc.assume(matches!(path(&cfg, x), Path::Scientific));
+    let v = if cfg.percent { x * 100.0 } else { x };
+    let mut f = cfg.build();
+    let out = f.fmt2(x).to_string();
+    let body = out
+        .strip_prefix(cfg.prefix.as_str())
+        .unwrap_or_else(|| panic!("{out:?} lacks the prefix {:?}", cfg.prefix));
+    let body = body
+        .strip_suffix(cfg.effective_suffix())
+        .unwrap_or_else(|| panic!("{out:?} lacks the suffix {:?}", cfg.effective_suffix()));
+    let (mantissa, exponent) = body
+        .split_once('e')
+        .unwrap_or_else(|| panic!("{out:?} is not scientific notation"));
+    let exponent: i32 = exponent.parse().unwrap_or_else(|_| panic!("{out:?}: bad exponent"));
+    // The mantissa uses the configured decimal marker.
+    let mantissa = mantissa.replace(cfg.marker(), ".");
+    let m: f64 = mantissa.parse().unwrap_or_else(|_| panic!("{out:?}: bad mantissa"));
+    let digits = mantissa.trim_start_matches('-');
+    let int = digits.split_once('.').map(|(i, _)| i).unwrap_or(digits);
+    assert!(
+        int.len() == 1 && int != "0",
+        "{out:?} for {x:e}: the mantissa {mantissa} is not in [1, 10)"
+    );
+    // The decimal exponent of v, from its shortest representation.
+    let true_exponent: i32 = format!("{v:e}").split_once('e').unwrap().1.parse().unwrap();
+    assert_eq!(exponent, true_exponent, "{out:?} for {x:e}: exponent");
+    let kept = match cfg.precision {
+        Precision::Unspecified => 6,
+        Precision::Decimals(d) => d as i32,
+        Precision::Significance(d) => d as i32 - 1,
+    };
+    let tolerance = 2.0 * 10f64.powi(-kept.max(0)) + 1e-12;
+    let value = m * 10f64.powi(exponent);
+    assert!(
+        ((value - v) / v).abs() <= tolerance,
+        "{out:?} for {x:e}: mantissa off by more than truncation allows"
+    );
+}
+
+const SPECIAL_VALUES: &[f64] = &[0.0, -0.0, f64::NAN, f64::INFINITY, f64::NEG_INFINITY];
+
+/// A value to format with `cfg`: a plain-path number or any decimal between 1e-300 and 1e300,
+/// equally often; without a prefix, one time in five a zero, NaN or infinity (they overwrite a
+/// prefix, numfmt/1 — the general generator uses them only without one).
+fn value(cfg: &Config) -> impl PrintableGenerator<f64> {
+    let mut choices = vec![w(2, plain_number(cfg)), w(2, decimal(-300, 300))];
+    if cfg.prefix.is_empty() {
+        choices.push(w(1, generators::sampled_from(SPECIAL_VALUES)));
+    }
+    weighted(choices)
+}
+
+/// One formatting step: the value, and the text `fmt_into` appends to.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Step {
+    x: f64,
+    lead: String,
+}
+
+/// One to six steps.
+fn steps(cfg: &Config) -> impl PrintableGenerator<Vec<Step>> {
+    generators::vecs(hegel::tuples!(value(cfg), decor()).map(|(x, lead)| Step { x, lead }))
+        .min_size(1)
+        .max_size(6)
+}
+
+/// Formatting has no state: `fmt2` on a reused formatter, `fmt_string`, `fmt_into` (appended
+/// after arbitrary text) and a fresh formatter all agree.
+#[hegel::test]
+fn formatting_is_stateless(tc: TestCase) {
+    let (cfg, steps) = tc.draw(with_config(steps));
+    let mut f = cfg.build();
+    for Step { x, lead } in steps {
+        let fresh = cfg.build().fmt2(x).to_string();
+        assert_eq!(f.fmt2(x), fresh, "{cfg:?}: fmt2 after earlier calls, {x:e}");
+        assert_eq!(f.fmt_string(x), fresh, "{cfg:?}: fmt_string, {x:e}");
+        let mut buf = lead.clone();
+        f.fmt_into(&mut buf, x);
+        assert_eq!(buf, format!("{lead}{fresh}"), "{cfg:?}: fmt_into, {x:e}");
+    }
+}
+
+/// Any `i64`; with a prefix, none whose `i8`, `u16` or `i32` narrowing is zero (zero over a
+/// multi-byte prefix is numfmt/1, an invalid-UTF-8 `String`).
+fn integer(cfg: &Config) -> impl PrintableGenerator<i64> {
+    let with_prefix = !cfg.prefix.is_empty();
+    ints(i64::MIN, i64::MAX)
+        .filter(move |&i| !with_prefix || (i as i8 != 0 && i as u16 != 0 && i as i32 != 0))
+}
+
+/// Integers format as their `f64` value.
+#[hegel::test]
+fn integers_format_as_their_float_value(tc: TestCase) {
+    let (cfg, i) = tc.draw(with_config(integer));
+    let f = cfg.build();
+    let u = i as u64;
+    assert_eq!(f.fmt_string(i), f.fmt_string(i as f64), "i64 {i}");
+    assert_eq!(f.fmt_string(u), f.fmt_string(u as f64), "u64 {u}");
+    assert_eq!(f.fmt_string(i as i32), f.fmt_string(i as i32 as f64), "i32");
+    assert_eq!(f.fmt_string(i as u16), f.fmt_string(i as u16 as f64), "u16");
+    assert_eq!(f.fmt_string(i as i8), f.fmt_string(i as i8 as f64), "i8");
+    assert_eq!(f.fmt_string(i as f32), f.fmt_string(i as f32 as f64), "f32");
+}
+
+/// A `separator` or `comma` call on the builder.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Setting {
+    Separator(Option<char>),
+    Comma(bool),
+}
+
+const SETTING_SEPARATORS: &[Option<char>] = &[None, Some(','), Some('.'), Some(' '), Some('_')];
+
+fn setting() -> impl PrintableGenerator<Setting> {
+    hegel::one_of!(
+        generators::sampled_from(SETTING_SEPARATORS).map(Setting::Separator),
+        generators::booleans().map(Setting::Comma),
+    )
+}
+
+/// After any sequence of `separator`/`comma` calls the thousands separator and the decimal
+/// marker differ.
+#[hegel::test]
+fn separator_never_doubles_as_decimal_marker(tc: TestCase) {
+    let settings = tc.draw(generators::vecs(setting()).min_size(1).max_size(4));
+    let mut f = Formatter::new();
+    for setting in &settings {
+        f = match setting {
+            Setting::Separator(sep) => f.separator(*sep).unwrap(),
+            Setting::Comma(comma) => f.comma(*comma),
+        };
+    }
+    let out = f.fmt2(1234567.891).to_string();
+    let ok = SETTING_SEPARATORS
+        .iter()
+        .flat_map(|sep| [',', '.'].map(|marker| (*sep, marker)))
+        .filter(|(sep, marker)| *sep != Some(*marker))
+        .any(|(sep, marker)| {
+            let s = sep.map(String::from).unwrap_or_default();
+            out == format!("1{s}234{s}567{marker}891")
+        });
+    assert!(ok, "{settings:?}: {out:?} does not separate the fraction from the groups");
+}
+
+// ---------------------------------------------------------------------------------------
+// Properties: the format-string parser
+// ---------------------------------------------------------------------------------------
+
+#[derive(Clone, Copy, Debug, PartialEq, hegel::PrettyPrintable)]
+enum Scaler {
+    Percent,
+    Short,
+    Metric,
+    Binary,
+    No,
+}
+
+/// The precision component: nothing, `.d`/`,d`, `~d`, `.*`/`,*`.
+#[derive(Clone, Copy, Debug, hegel::PrettyPrintable)]
+enum PrecisionSpec {
+    None,
+    Decimals(bool, u8),
+    Significance(u8),
+    Unspecified(bool),
+}
+
+impl PrecisionSpec {
+    /// Whether the component spells a comma as the decimal marker.
+    fn comma(self) -> bool {
+        matches!(self, PrecisionSpec::Decimals(true, _) | PrecisionSpec::Unspecified(true))
+    }
+}
+
+/// The order of the components inside the brackets — arbitrary, except that `/]` (no
+/// separator) must come last.
+#[derive(Clone, Copy, Debug, PartialEq, hegel::PrettyPrintable)]
+enum Order {
+    PrecisionScalerSeparator,
+    SeparatorPrecisionScaler,
+    PrecisionSeparatorScaler,
+    ScalerPrecisionSeparator,
+}
+
+impl Order {
+    /// Whether the separator comes last.
+    fn separator_last(self) -> bool {
+        matches!(self, Order::PrecisionScalerSeparator | Order::ScalerPrecisionSeparator)
+    }
+}
+
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Spec {
+    prefix: String,
+    suffix: String,
+    precision: PrecisionSpec,
+    scaler: Option<Scaler>,
+    /// `None`: not given (default `,`); `Some(None)`: `/]` (no separator); `Some(Some(c))`.
+    sep: Option<Option<char>>,
+    order: Order,
+    /// Render the whole string as a bare prefix (no brackets).
+    bare: bool,
+}
+
+/// Pieces of a format string's prefix/suffix: at most three bytes each, so three of them stay
+/// within the 12-byte limit (11 beside a percentage's `%`).
+const SPEC_DECOR_POOL: &[&str] = &["$", "AU$", "€", "x", " ", "[", "]", "~", "%", "/", "1", ".", ","];
+
+/// Up to three pieces of the pool; a bracket directly after the same bracket is left out (two
+/// escaped brackets of a kind in a row: numfmt/8).
+fn spec_decor() -> impl PrintableGenerator<String> {
+    generators::vecs(generators::sampled_from(SPEC_DECOR_POOL))
+        .max_size(3)
+        .map(|pieces| {
+            let mut out = String::new();
+            let mut last_bracket: Option<&str> = None;
+            for piece in pieces {
+                let bracket = matches!(piece, "[" | "]");
+                if bracket && last_bracket == Some(piece) {
+                    continue;
+                }
+                out.push_str(piece);
+                last_bracket = if bracket { Some(piece) } else { None };
+            }
+            out
+        })
+}
+
+fn escape(s: &str) -> String {
+    s.replace('[', "[[").replace(']', "]]")
+}
+
+impl Spec {
+    fn comma(&self) -> bool {
+        self.precision.comma() || self.sep == Some(Some('.'))
+    }
+
+    fn render(&self) -> String {
+        if self.bare {
+            return escape(&self.prefix);
+        }
+        let precision = match self.precision {
+            PrecisionSpec::None => String::new(),
+            PrecisionSpec::Decimals(comma, d) => format!("{}{d}", if comma { ',' } else { '.' }),
+            PrecisionSpec::Significance(d) => format!("~{d}"),
+            PrecisionSpec::Unspecified(comma) => format!("{}*", if comma { ',' } else { '.' }),
+        };
+        let scaler = match self.scaler {
+            None => "",
+            Some(Scaler::Percent) => "%",
+            Some(Scaler::Short) => "s",
+            Some(Scaler::Metric) => "m",
+            Some(Scaler::Binary) => "b",
+            Some(Scaler::No) => "n",
+        }
+        .to_string();
+        let sep = match self.sep {
+            None => String::new(),
+            Some(None) => "/".to_string(),
+            Some(Some(c)) => format!("/{c}"),
+        };
+        // `/]` (no separator) must come last.
+        let order = if self.sep == Some(None) && !self.order.separator_last() {
+            Order::PrecisionScalerSeparator
+        } else {
+            self.order
+        };
+        let parts = match order {
+            Order::PrecisionScalerSeparator => [precision, scaler, sep],
+            Order::SeparatorPrecisionScaler => [sep, precision, scaler],
+            Order::PrecisionSeparatorScaler => [precision, sep, scaler],
+            Order::ScalerPrecisionSeparator => [scaler, precision, sep],
+        };
+        format!("{}[{}]{}", escape(&self.prefix), parts.concat(), escape(&self.suffix))
+    }
+
+    /// The builder equivalent, as the module documentation describes each component.
+    fn expected(&self) -> Formatter {
+        if self.bare {
+            return Formatter::default().prefix(&self.prefix).unwrap();
+        }
+        let mut f = match self.scaler {
+            Some(Scaler::Percent) => Formatter::percentage().separator(',').unwrap(),
+            None | Some(Scaler::Short) => Formatter::default(),
+            Some(Scaler::Metric) => Formatter::default().scales(Scales::metric()),
+            Some(Scaler::Binary) => Formatter::default().scales(Scales::binary()),
+            Some(Scaler::No) => Formatter::default().scales(Scales::none()),
+        };
+        if let Some(sep) = self.sep {
+            f = f.separator(sep).unwrap();
+        }
+        f = f.prefix(&self.prefix).unwrap();
+        let suffix = if self.scaler == Some(Scaler::Percent) {
+            format!("%{}", self.suffix)
+        } else {
+            self.suffix.clone()
+        };
+        f = f.suffix(&suffix).unwrap();
+        f = f.comma(self.comma());
+        match self.precision {
+            PrecisionSpec::None => {}
+            PrecisionSpec::Decimals(_, d) => f = f.precision(Precision::Decimals(d)),
+            PrecisionSpec::Significance(d) => f = f.precision(Precision::Significance(d)),
+            PrecisionSpec::Unspecified(_) => f = f.precision(Precision::Unspecified),
+        }
+        f
+    }
+}
+
+/// Nothing, `.d`/`,d`, `~d` or `.*`/`,*`, equally often; a comma marker half the time.
+fn precision_spec() -> impl PrintableGenerator<PrecisionSpec> {
+    hegel::one_of!(
+        generators::just(PrecisionSpec::None),
+        hegel::tuples!(generators::booleans(), ints(0, 255))
+            .map(|(comma, d)| PrecisionSpec::Decimals(comma, d as u8)),
+        ints(0, 255).map(|d| PrecisionSpec::Significance(d as u8)),
+        generators::booleans().map(PrecisionSpec::Unspecified),
+    )
+}
+
+/// The separator component: not given, `/` (none), or `/c`.  `,` as the separator with a
+/// comma decimal marker is numfmt/5, so the pool depends on the precision component.
+#[rustfmt::skip]
+const SPEC_SEPARATORS: &[Option<Option<char>>] = &[
+    None, Some(None), Some(Some(',')), Some(Some('.')), Some(Some(' ')), Some(Some('_')),
+    Some(Some('/')), Some(Some('x')), Some(Some('%')), Some(Some('n')), Some(Some('~')),
+];
+#[rustfmt::skip]
+const SPEC_SEPARATORS_WITH_COMMA_MARKER: &[Option<Option<char>>] = &[
+    None, Some(None), Some(Some('.')), Some(Some(' ')), Some(Some('_')),
+    Some(Some('/')), Some(Some('x')), Some(Some('%')), Some(Some('n')), Some(Some('~')),
+];
+
+/// The precision component and a separator component that does not collide with its marker.
+fn precision_and_separator() -> impl PrintableGenerator<(PrecisionSpec, Option<Option<char>>)> {
+    precision_spec().flat_map(|precision| {
+        let pool = if precision.comma() { SPEC_SEPARATORS_WITH_COMMA_MARKER } else { SPEC_SEPARATORS };
+        generators::sampled_from(pool).map(move |sep| (precision, sep))
+    })
+}
+
+const SCALERS: &[Option<Scaler>] = &[
+    None,
+    Some(Scaler::Percent),
+    Some(Scaler::Short),
+    Some(Scaler::Metric),
+    Some(Scaler::Binary),
+    Some(Scaler::No),
+];
+const ORDERS: &[Order] = &[
+    Order::PrecisionScalerSeparator,
+    Order::SeparatorPrecisionScaler,
+    Order::PrecisionSeparatorScaler,
+    Order::ScalerPrecisionSeparator,
+];
+
+/// A format string as data: decorations, the three components and their order; one time in
+/// ten a bare prefix.
+fn spec() -> impl PrintableGenerator<Spec> {
+    hegel::tuples!(
+        spec_decor(),
+        spec_decor(),
+        precision_and_separator(),
+        generators::sampled_from(SCALERS),
+        generators::sampled_from(ORDERS),
+        chance(0.1)
+    )
+    .map(|(prefix, suffix, (precision, sep), scaler, order, bare)| Spec {
+        prefix,
+        suffix,
+        precision,
+        scaler,
+        sep,
+        order,
+        bare,
+    })
+}
+
+const PARSE_SAMPLES: &[f64] = &[0.5, 1.0, 1234.5678, -9876543.21, 0.0001234, 1e15, 12.0, 1e-9];
+
+/// A format string parses to the formatter its components describe.
+#[hegel::test]
+fn format_strings_parse_to_their_builder_equivalent(tc: TestCase) {
+    let spec = tc.draw(spec());
+    let text = spec.render();
+    let parsed: Formatter = text
+        .parse()
+        .unwrap_or_else(|e| panic!("{text:?} ({spec:?}) failed to parse: {e}"));
+    let expected = spec.expected();
+    assert_eq!(parsed, expected, "{text:?} ({spec:?})");
+    for &x in PARSE_SAMPLES {
+        assert_eq!(parsed.fmt_string(x), expected.fmt_string(x), "{text:?} ({spec:?}) formatting {x}");
+    }
+}
+
+/// The grammar's alphabet: brackets, the precision and separator marks, the scalers, digits,
+/// a letter, a space and a two-byte character.
+const PARSE_ALPHABET: &str = "[].,~/*%smbn0159a é";
+
+/// Parsing any string returns `Ok` or a `ParseError`, and a parsed formatter formats.
+#[hegel::test]
+fn parsing_never_panics(tc: TestCase) {
+    let text = tc.draw(generators::text().alphabet(PARSE_ALPHABET).max_size(14));
+    match text.parse::<Formatter>() {
+        Ok(mut f) => {
+            f.fmt2(1234.5);
+            f.fmt2(-0.001);
+        }
+        Err(e) => {
+            let _ = e.to_string();
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// Pins
+// ---------------------------------------------------------------------------------------
+
+/// numfmt/1: zero, NaN and the infinities are written over the prefix bytes of the reused
+/// buffer (and over a multi-byte prefix they leave invalid UTF-8: a panic).
+#[test]
+fn special_values_leave_the_prefix_intact() {
+    let f = Formatter::currency("€").unwrap();
+    let _ = f.fmt_string(0.0); // panics: "0" over the first byte of "€"
+    let mut f = Formatter::currency("€").unwrap();
+    f.fmt2(0.0);
+    assert_eq!(f.fmt2(1.0), "€1.0"); // panics: "will be valid string"
+    let mut f = Formatter::currency("$").unwrap();
+    f.fmt2(0.0);
+    assert_eq!(f.fmt2(1.0), "$1.0");
+    let mut f = Formatter::currency("$").unwrap();
+    f.fmt2(f64::NAN);
+    assert_eq!(f.fmt2(1.0), "$1.0");
+    let mut f = Formatter::new().prefix("total ").unwrap();
+    f.fmt2(f64::INFINITY);
+    assert_eq!(f.fmt_string(2.5), "total 2.5");
+}
+
+/// numfmt/2: significant figures do not count leading zeros.
+#[test]
+fn significance_ignores_leading_zeros() {
+    let mut f = Formatter::new().precision(Precision::Significance(1));
+    assert_eq!(f.fmt2(0.5), "0.5");
+    let mut f = Formatter::new().precision(Precision::Significance(3));
+    assert_eq!(f.fmt2(0.001234), "0.00123");
+    assert_eq!(f.fmt2(0.01234), "0.0123");
+}
+
+/// numfmt/3: the mantissa of scientific notation is in [1, 10).
+#[test]
+fn scientific_mantissa_is_normalised_for_powers_of_ten() {
+    let mut f = Formatter::new();
+    assert_eq!(f.fmt2(1e-5), "1.0e-5");
+    assert_eq!(f.fmt2(1e-4), "1.0e-4");
+    assert_eq!(f.fmt2(1e21), "1.0e21");
+    assert_eq!(f.fmt2(1e300), "1.0e300");
+    assert_eq!(f.fmt2(9.999999999999998e12), "9.999999e12");
+}
+
+/// numfmt/4: grouping by threes for a number whose `log10` rounds up to the next integer.
+#[test]
+fn grouping_is_by_three_digits_below_a_power_of_ten() {
+    let mut f = Formatter::new().separator(',').unwrap();
+    assert_eq!(f.fmt2(999999.9999999999), "999,999.9999999999");
+    assert_eq!(f.fmt2(99999.99999999999), "99,999.99999999999");
+    assert_eq!(f.fmt2(999.9999999999999), "999.9999999999999");
+}
+
+/// numfmt/5: the separator and the decimal marker coincide after `separator('.')` then
+/// `separator(',')`, `comma(true)` then `separator(',')`, `comma(true)` then `comma(false)`,
+/// and for the format string `[,2n/,]`.
+#[test]
+fn builder_keeps_separator_and_marker_apart() {
+    let mut f = Formatter::new().separator('.').unwrap().separator(',').unwrap();
+    assert_eq!(f.fmt2(12345.67), "12,345.67");
+    let mut f = Formatter::new().comma(true).separator(',').unwrap();
+    assert_ne!(f.fmt2(12345.67), "12,345,67");
+    let mut f = Formatter::new().separator(',').unwrap().comma(true).comma(false);
+    assert_eq!(f.fmt2(12345.67), "12,345.67");
+    let mut f: Formatter = "[,2n/,]".parse().unwrap();
+    assert_ne!(f.fmt2(12345.67), "12,345,67");
+}
+
+/// numfmt/6: a percentage of a huge number is `NaNe2147483647%`.
+#[test]
+fn percentage_of_huge_numbers_is_not_nan() {
+    let mut f = Formatter::percentage();
+    let out = f.fmt2(f64::MAX).to_string();
+    assert!(!out.contains("NaN"), "{out:?}");
+    let out = f.fmt2(1e307).to_string();
+    assert!(!out.contains("NaN"), "{out:?}");
+}
+
+/// numfmt/7: subnormal numbers format as `infe-324`.
+#[test]
+fn subnormals_format_as_numbers() {
+    let mut f = Formatter::new();
+    let out = f.fmt2(5e-324).to_string();
+    assert!(out.starts_with("4.94") && out.ends_with("e-324"), "{out:?}");
+    let out = f.fmt2(2.5e-310).to_string();
+    assert!(out.starts_with("2.5") && out.ends_with("e-310"), "{out:?}");
+}
+
+/// numfmt/8: `]]]]` and `[[[[` in the suffix are two escaped brackets each.
+#[test]
+fn escaped_brackets_in_the_suffix_parse_pairwise() {
+    let mut f: Formatter = "[]x]]]]".parse().unwrap();
+    assert_eq!(f.fmt2(1.0), "1.0x]]");
+    let mut f: Formatter = "[]x[[[[".parse().unwrap();
+    assert_eq!(f.fmt2(1.0), "1.0x[[");
+}
+
+/// numfmt/9: `PartialEq` ignores the decimal-marker setting.
+#[test]
+fn equality_reflects_formatting_behaviour() {
+    let a = Formatter::new().comma(true);
+    let b = Formatter::new();
+    assert_ne!(a.fmt_string(1.5), b.fmt_string(1.5));
+    assert_ne!(a, b);
+}
