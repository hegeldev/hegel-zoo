+
+/// numfmt/1: zero, NaN and the infinities are written over the prefix bytes of the reused
+/// buffer (and over a multi-byte prefix they leave invalid UTF-8: a panic).
+#[test]
+fn special_values_leave_the_prefix_intact() {
+    let f = Formatter::currency("€").unwrap();
+    let _ = f.fmt_string(0.0); // panics: "0" over the first byte of "€"
+    let mut f = Formatter::currency("€").unwrap();
+    f.fmt2(0.0);
+    assert_eq!(f.fmt2(1.0), "€1.0"); // panics: "will be valid string"
+    let mut f = Formatter::currency("$").unwrap();
+    f.fmt2(0.0);
+    assert_eq!(f.fmt2(1.0), "$1.0");
+    let mut f = Formatter::currency("$").unwrap();
+    f.fmt2(f64::NAN);
+    assert_eq!(f.fmt2(1.0), "$1.0");
+    let mut f = Formatter::new().prefix("total ").unwrap();
+    f.fmt2(f64::INFINITY);
+    assert_eq!(f.fmt_string(2.5), "total 2.5");
+}
+
+/// numfmt/2: significant figures do not count leading zeros.
+#[test]
+fn significance_ignores_leading_zeros() {
+    let mut f = Formatter::new().precision(Precision::Significance(1));
+    assert_eq!(f.fmt2(0.5), "0.5");
+    let mut f = Formatter::new().precision(Precision::Significance(3));
+    assert_eq!(f.fmt2(0.001234), "0.00123");
+    assert_eq!(f.fmt2(0.01234), "0.0123");
+}
+
+/// numfmt/3: the mantissa of scientific notation is in [1, 10).
+#[test]
+fn scientific_mantissa_is_normalised_for_powers_of_ten() {
+    let mut f = Formatter::new();
+    assert_eq!(f.fmt2(1e-5), "1.0e-5");
+    assert_eq!(f.fmt2(1e-4), "1.0e-4");
+    assert_eq!(f.fmt2(1e21), "1.0e21");
+    assert_eq!(f.fmt2(1e300), "1.0e300");
+    assert_eq!(f.fmt2(9.999999999999998e12), "9.999999e12");
+}
+
+/// numfmt/4: grouping by threes for a number whose `log10` rounds up to the next integer.
+#[test]
+fn grouping_is_by_three_digits_below_a_power_of_ten() {
+    let mut f = Formatter::new().separator(',').unwrap();
+    assert_eq!(f.fmt2(999999.9999999999), "999,999.9999999999");
+    assert_eq!(f.fmt2(99999.99999999999), "99,999.99999999999");
+    assert_eq!(f.fmt2(999.9999999999999), "999.9999999999999");
+}
+
+/// numfmt/5: the separator and the decimal marker coincide after `separator('.')` then
+/// `separator(',')`, `comma(true)` then `separator(',')`, `comma(true)` then `comma(false)`,
+/// and for the format string `[,2n/,]`.
+#[test]
+fn builder_keeps_separator_and_marker_apart() {
+    let mut f = Formatter::new().separator('.').unwrap().separator(',').unwrap();
+    assert_eq!(f.fmt2(12345.67), "12,345.67");
+    let mut f = Formatter::new().comma(true).separator(',').unwrap();
+    assert_ne!(f.fmt2(12345.67), "12,345,67");
+    let mut f = Formatter::new().separator(',').unwrap().comma(true).comma(false);
+    assert_eq!(f.fmt2(12345.67), "12,345.67");
+    let mut f: Formatter = "[,2n/,]".parse().unwrap();
+    assert_ne!(f.fmt2(12345.67), "12,345,67");
+}
+
+/// numfmt/6: a percentage of a huge number is `NaNe2147483647%`.
+#[test]
+fn percentage_of_huge_numbers_is_not_nan() {
+    let mut f = Formatter::percentage();
+    let out = f.fmt2(f64::MAX).to_string();
+    assert!(!out.contains("NaN"), "{out:?}");
+    let out = f.fmt2(1e307).to_string();
+    assert!(!out.contains("NaN"), "{out:?}");
+}
+
+/// numfmt/7: subnormal numbers format as `infe-324`.
+#[test]
+fn subnormals_format_as_numbers() {
+    let mut f = Formatter::new();
+    let out = f.fmt2(5e-324).to_string();
+    assert!(out.starts_with("4.94") && out.ends_with("e-324"), "{out:?}");
+    let out = f.fmt2(2.5e-310).to_string();
+    assert!(out.starts_with("2.5") && out.ends_with("e-310"), "{out:?}");
+}
+
+/// numfmt/8: `]]]]` and `[[[[` in the suffix are two escaped brackets each.
+#[test]
+fn escaped_brackets_in_the_suffix_parse_pairwise() {
+    let mut f: Formatter = "[]x]]]]".parse().unwrap();
+    assert_eq!(f.fmt2(1.0), "1.0x]]");
+    let mut f: Formatter = "[]x[[[[".parse().unwrap();
+    assert_eq!(f.fmt2(1.0), "1.0x[[");
+}
+
+/// numfmt/9: `PartialEq` ignores the decimal-marker setting.
+#[test]
+fn equality_reflects_formatting_behaviour() {
+    let a = Formatter::new().comma(true);
+    let b = Formatter::new();
+    assert_ne!(a.fmt_string(1.5), b.fmt_string(1.5));
+    assert_ne!(a, b);
+}
