+/// Property: a variable stored in a context via the API is read back
+/// unchanged by evaluating the bare identifier.
+#[hegel::test]
+fn hegel_context_variable_read_returns_stored_value(tc: hegel::TestCase) {
+    let name = tc.draw(identifiers());
+    // NaN excluded from the drawn value: Value's PartialEq (used by the
+    // assertion) is false for NaN == NaN.
+    let value: Value = match tc.draw(generators::integers::<u8>().max_value(3)) {
+        0 => Value::Int(tc.draw(generators::integers::<i64>())),
+        1 => Value::Float(tc.draw(generators::floats::<f64>().allow_nan(false))),
+        2 => Value::Boolean(tc.draw(generators::booleans())),
+        _ => Value::String(tc.draw(generators::text().max_size(20))),
+    };
+    let mut context = HashMapContext::<DefaultNumericTypes>::new();
+    context.set_value(name.clone(), value.clone()).unwrap();
+    assert_eq!(
+        eval_with_context(&name, &context),
+        Ok(value),
+        "identifier: {name}"
+    );
+}
+
+/// Property: an assignment expression writes the value into the context, and
+/// a chained read returns it.
+#[hegel::test]
+fn hegel_assignment_roundtrip(tc: hegel::TestCase) {
+    let name = tc.draw(identifiers());
+    // i64::MIN excluded: pinned by known_failure_i64_min_literal_parses_as_float.
+    let n = tc.draw(generators::integers::<i64>().min_value(i64::MIN + 1));
+    let mut context = HashMapContext::<DefaultNumericTypes>::new();
+    let script = format!("{} = {}; {}", name, int_leaf(n), name);
+    assert_eq!(
+        eval_with_context_mut(&script, &mut context),
+        Ok(Value::Int(n)),
+        "script: {script}"
+    );
+    assert_eq!(context.get_value(&name), Some(&Value::Int(n)));
+}
