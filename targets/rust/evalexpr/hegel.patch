+/// overflows the stack in a debug build and ABORTS the whole test process
+/// (SIGABRT) — it cannot be caught, so this reproducer must stay ignored.
+///
+/// Run manually with:
+///   cargo test known_failure_deeply_nested_expression_overflows_stack -- --ignored
+#[test]
+#[ignore = "stack overflow aborts the process; run manually"]
+fn known_failure_deeply_nested_expression_overflows_stack() {
+    let depth = 10_000;
+    let expression = format!("{}1{}", "(".repeat(depth), ")".repeat(depth));
+    assert_eq!(eval(&expression), Ok(Value::Int(1)));
+}
