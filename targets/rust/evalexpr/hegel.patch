+        "str::from",
+        "str::to_uppercase",
+        "contains",
+        "bitnot",
+        "//",
+        "/*",
+        "*/",
+        "\"",
+        "\\",
+    ];
+    let tokens: Vec<&str> =
+        tc.draw(generators::vecs(generators::sampled_from(vocabulary)).max_size(25));
+    let mut expression = String::new();
+    for token in tokens {
+        expression.push_str(token);
+        if tc.draw(generators::booleans()) {
+            expression.push(' ');
+        }
+    }
+    tc.note(&expression);
+    drop(eval(&expression));
+}
