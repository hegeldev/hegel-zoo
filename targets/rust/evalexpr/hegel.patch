+/// Property: `str::substring` with byte indices on char boundaries returns
+/// exactly the Rust slice `&s[start..end]`.
+///
+/// Indices are restricted to char boundaries because non-boundary indices
+/// make the builtin panic — pinned by
+/// known_failure_substring_panics_inside_multibyte_char.
+#[hegel::test]
+fn hegel_substring_matches_rust_on_char_boundaries(tc: hegel::TestCase) {
+    let s: String = tc.draw(generators::text().max_size(30));
+    let mut boundaries: Vec<usize> = s.char_indices().map(|(i, _)| i).collect();
+    boundaries.push(s.len());
+    let a = tc.draw(generators::integers::<usize>().max_value(boundaries.len() - 1));
+    let b = tc.draw(generators::integers::<usize>().max_value(boundaries.len() - 1));
+    let (start, end) = (boundaries[a.min(b)], boundaries[a.max(b)]);
+    let expression = format!("str::substring({}, {}, {})", quote(&s), start, end);
+    assert_eq!(
+        eval(&expression),
+        Ok(Value::from(&s[start..end])),
+        "expression: {expression}"
+    );
+}
