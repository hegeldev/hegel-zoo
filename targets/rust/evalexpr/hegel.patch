+/// KNOWN FAILURE: the `shl`/`shr` builtins use Rust's unchecked shift
+/// operators (src/value/numeric_types/default_numeric_types.rs), which PANIC
+/// in debug builds for shift amounts >= 64 or negative (in release builds
+/// they silently mask the shift amount instead). Expected: an Err, like every
+/// other arithmetic overflow in this crate.
+#[test]
+fn known_failure_shift_panics_on_shift_overflow() {
+    let result = eval("shl(1, 64)");
+    assert!(result.is_err() || result.is_ok()); // never reached: eval panics
+    let result = eval("shr(1, 0-1)");
+    assert!(result.is_err() || result.is_ok()); // never reached: eval panics
+}
