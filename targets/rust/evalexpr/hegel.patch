+        "+",
+        "-",
+        "*",
+        "/",
+        "%",
+        "^",
+        "==",
+        "!=",
+        "<",
+        ">",
+        "<=",
+        ">=",
+        "&&",
+        "||",
+        "!",
+        "(",
+        ")",
+        ",",
+        ";",
+        "=",
+        "+=",
+        "-=",
+        "*=",
+        "/=",
+        "%=",
+        "^=",
+        "&&=",
+        "||=",
+        "0",
+        "1",
+        "42",
+        "3.5",
+        "1e3",
+        "1e-3",
+        "0x1f",
+        "0b101",
+        "0o17",
+        "9223372036854775807",
+        "true",
+        "false",
+        "inf",
+        "nan",
+        "\"\"",
+        "\"abc\"",
+        "\"\\\"\"",
+        "\"\u{e4}\u{1f600}\"",
+        "a",
+        "x",
+        "foo",
+        "min",
+        "max",
+        "len",
+        "if",
