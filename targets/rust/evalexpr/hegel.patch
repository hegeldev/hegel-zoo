+/// Property: arithmetic over int/float literals matches an independent
+/// reference interpreter implementing the documented semantics (checked i64
+/// arithmetic, float promotion, `^` always float).
+#[hegel::test]
+fn hegel_arithmetic_matches_reference_interpreter(tc: hegel::TestCase) {
+    let depth = tc.draw(generators::integers::<u32>().max_value(4));
+    let expr = tc.draw(arith_exprs(depth));
+    let rendered = render_arith(&expr);
+    tc.note(&rendered);
+    let actual = eval(&rendered);
+    match ref_eval(&expr) {
+        Ok(RefNum::I(expected)) => {
+            assert_eq!(actual, Ok(Value::Int(expected)), "expression: {rendered}");
+        },
+        Ok(RefNum::F(expected)) => match actual {
+            Ok(Value::Float(y)) => assert!(
+                (expected.is_nan() && y.is_nan()) || expected.to_bits() == y.to_bits(),
+                "expression: {rendered}: expected {expected:?}, got {y:?}"
+            ),
+            other => panic!("expression: {rendered}: expected Float({expected:?}), got {other:?}"),
+        },
+        Err(()) => assert!(
+            actual.is_err(),
+            "expression: {rendered}: expected an error, got {actual:?}"
+        ),
+    }
+}
+
+/// Property: an unparenthesized operator chain evaluates exactly like the
+/// explicitly parenthesized version dictated by the documented precedence
+/// table (^ 120 > * / % 100 > + - 95) with left-to-right associativity.
+#[hegel::test]
+fn hegel_precedence_matches_explicit_parenthesization(tc: hegel::TestCase) {
+    fn precedence(op: &str) -> u32 {
+        match op {
+            "^" => 120,
+            "*" | "/" | "%" => 100,
+            "+" | "-" => 95,
+            _ => unreachable!(),
+        }
+    }
+
+    let op_count = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+    let mut operands = Vec::new();
+    for _ in 0..=op_count {
+        // i64::MIN excluded: pinned by known_failure_i64_min_literal_parses_as_float.
+        operands.push(tc.draw(generators::integers::<i64>().min_value(i64::MIN + 1)));
+    }
+    let mut ops = Vec::new();
+    for _ in 0..op_count {
+        ops.push(tc.draw(generators::sampled_from(vec!["+", "-", "*", "/", "%", "^"])));
+    }
+
+    let mut flat = int_leaf(operands[0]);
+    for (op, operand) in ops.iter().zip(&operands[1..]) {
+        flat.push_str(&format!(" {} {}", op, int_leaf(*operand)));
+    }
+
+    // Shunting-yard construction of the fully parenthesized equivalent.
+    let mut out = vec![int_leaf(operands[0])];
+    let mut op_stack: Vec<&str> = Vec::new();
+    for (op, operand) in ops.iter().zip(&operands[1..]) {
+        while let Some(top) = op_stack.last() {
+            if precedence(top) >= precedence(op) {
+                let r = out.pop().unwrap();
+                let l = out.pop().unwrap();
+                out.push(format!("({} {} {})", l, top, r));
+                op_stack.pop();
+            } else {
+                break;
+            }
+        }
+        op_stack.push(op);
+        out.push(int_leaf(*operand));
+    }
+    while let Some(top) = op_stack.pop() {
+        let r = out.pop().unwrap();
+        let l = out.pop().unwrap();
+        out.push(format!("({} {} {})", l, top, r));
+    }
+    let grouped = out.pop().unwrap();
+
+    let flat_result = eval(&flat);
+    let grouped_result = eval(&grouped);
+    // Value's PartialEq is false for NaN == NaN, but two NaN results agree
+    // for the purposes of this property (e.g. `^` legitimately yields NaN).
+    let both_nan = matches!(
+        (&flat_result, &grouped_result),
+        // Fully qualified: EvalexprFloat also defines an `is_nan` method.
+        (Ok(Value::Float(x)), Ok(Value::Float(y))) if f64::is_nan(*x) && f64::is_nan(*y)
+    );
+    assert!(
+        both_nan || flat_result == grouped_result,
+        "flat: {flat} = {flat_result:?} | grouped: {grouped} = {grouped_result:?}"
+    );
+}
