+// ============================================================================
+// Property-based tests (hegel)
+//
+// These tests generate random inputs and check evalexpr against independent
+// oracles (a reference interpreter, Rust's own semantics, or the crate's
+// documented contracts).
+//
+// KNOWN FAILURES (real bugs, deliberately left failing; see the
+// `known_failure_*` tests below for deterministic pins):
+// 1. `str::substring` slices at raw byte indices and panics when an index
+//    falls inside a multi-byte UTF-8 character (src/function/builtin.rs:295).
+// 2. `shl`/`shr` use unchecked shifts and panic (in debug builds) when the
+//    shift amount is negative or >= 64 (src/value/numeric_types/default_numeric_types.rs).
+// 3. The literal `-9223372036854775808` (i64::MIN) silently parses as a
+//    Float instead of an Int, because the tokenizer parses the unsigned part
+//    `9223372036854775808` which overflows i64 and falls back to f64.
+// 4. `len` is documented to return the *character* length of a string but
+//    returns the byte length (src/function/builtin.rs:221).
+// 5. Parsing/evaluating/dropping deeply nested expressions recurses without a
+//    depth limit and overflows the stack, aborting the whole process (~4500
+//    nesting depth in a debug build). See
+//    `known_failure_deeply_nested_expression_overflows_stack` (kept #[ignore]d
+//    because a stack overflow aborts the test process, it cannot be caught).
+// ============================================================================
+
+use hegel::generators::{self, Generator};
+
+/// Renders an i64 as an expression literal. Negative values are wrapped in
+/// parentheses so they can be embedded after another operator unambiguously
+/// (the leading `-` is a unary negation operator token, not part of the
+/// literal).
+fn int_leaf(n: i64) -> String {
+    if n < 0 {
+        format!("({})", n)
+    } else {
+        n.to_string()
+    }
+}
+
+/// Renders a finite f64 as an expression literal (see `int_leaf` for why
+/// negative values are parenthesized). `{:?}` produces a shortest-roundtrip
+/// decimal or scientific form, both of which the tokenizer accepts.
+fn float_leaf(x: f64) -> String {
+    if x.is_sign_negative() {
+        format!("({:?})", x)
+    } else {
+        format!("{:?}", x)
+    }
+}
+
+/// Quotes a string as an expression string literal, escaping the two
+/// characters the grammar requires escaping (`\` and `"`).
+fn quote(s: &str) -> String {
+    format!("\"{}\"", s.replace('\\', "\\\\").replace('"', "\\\""))
+}
+
+/// Identifiers for variables: must not collide with literals the tokenizer
+/// recognizes. `true`/`false` parse as booleans, and `inf`/`nan`/`infinity`
+/// parse as f64 via Rust's `FromStr` fallback, so they can never be variables.
+#[hegel::composite]
+fn identifiers(tc: &hegel::TestCase) -> String {
+    tc.draw(
+        generators::from_regex(r"[a-z_][a-z0-9_]{0,8}")
+            .fullmatch(true)
+            .filter(|s| !matches!(s.as_str(), "true" | "false" | "inf" | "nan" | "infinity")),
+    )
+}
+
+/// A random arithmetic expression tree over int and float literals.
+#[derive(Debug, Clone, hegel::PrettyPrintable)]
+enum ArithExpr {
+    Int(i64),
+    Float(f64),
+    Neg(Box<ArithExpr>),
+    Bin(char, Box<ArithExpr>, Box<ArithExpr>),
+}
+
+fn arith_exprs(depth: u32) -> generators::BoxedGenerator<'static, ArithExpr> {
+    hegel::compose!(|tc| {
+        if depth == 0 || tc.draw(generators::booleans()) {
+            if tc.draw(generators::booleans()) {
+                // i64::MIN excluded: its literal form parses as a Float, which is
+                // pinned by known_failure_i64_min_literal_parses_as_float.
+                // Boundary values are boosted explicitly so that the oracle's
+                // error paths (overflow, division by zero) fire regularly —
+                // unboosted draws almost never produce those coincidences.
+                ArithExpr::Int(tc.draw(hegel::one_of!(
+                    generators::integers::<i64>().min_value(i64::MIN + 1),
+                    generators::sampled_from(vec![0, 1, -1, i64::MAX, i64::MIN + 1]),
+                )))
+            } else {
+                // NaN/infinity excluded: the literal grammar cannot express them
+                // (`inf`/`nan` parse only via the f64 FromStr fallback, and the
+                // oracle comparison below already tolerates NaN *results*).
+                ArithExpr::Float(
+                    tc.draw(
+                        generators::floats::<f64>()
+                            .allow_nan(false)
+                            .allow_infinity(false),
+                    ),
+                )
+            }
+        } else if tc.draw(generators::integers::<u8>().max_value(6)) == 0 {
+            ArithExpr::Neg(Box::new(tc.draw((arith_exprs(depth - 1)).print_as_debug())))
+        } else {
+            let op = tc.draw(generators::sampled_from(vec!['+', '-', '*', '/', '%', '^']));
+            let left = Box::new(tc.draw((arith_exprs(depth - 1)).print_as_debug()));
+            let right = Box::new(tc.draw((arith_exprs(depth - 1)).print_as_debug()));
+            ArithExpr::Bin(op, left, right)
+        }
+    })
+    .boxed()
+}
+
+fn render_arith(e: &ArithExpr) -> String {
+    match e {
+        ArithExpr::Int(n) => int_leaf(*n),
+        ArithExpr::Float(x) => float_leaf(*x),
+        ArithExpr::Neg(inner) => format!("(-{})", render_arith(inner)),
+        ArithExpr::Bin(op, l, r) => format!("({} {} {})", render_arith(l), op, render_arith(r)),
+    }
+}
+
+/// The result of the reference interpreter: an int, a float, or "evalexpr
+/// documents this as an error" (overflow, division by zero).
+#[derive(Debug, PartialEq, Clone, Copy)]
+enum RefNum {
+    I(i64),
+    F(f64),
+}
+
+fn ref_as_f64(n: RefNum) -> f64 {
+    match n {
+        RefNum::I(i) => i as f64,
+        RefNum::F(f) => f,
+    }
+}
+
+/// Reference interpreter implementing evalexpr's documented arithmetic
+/// semantics: int op int is checked i64 arithmetic (errors on overflow and
+/// division/remainder by zero), any float operand promotes the operation to
+/// f64, and `^` always computes in f64.
+fn ref_eval(e: &ArithExpr) -> Result<RefNum, ()> {
+    Ok(match e {
+        ArithExpr::Int(n) => RefNum::I(*n),
+        ArithExpr::Float(x) => RefNum::F(*x),
+        ArithExpr::Neg(inner) => match ref_eval(inner)? {
+            RefNum::I(n) => RefNum::I(n.checked_neg().ok_or(())?),
+            RefNum::F(x) => RefNum::F(-x),
+        },
+        ArithExpr::Bin(op, l, r) => {
+            let l = ref_eval(l)?;
+            let r = ref_eval(r)?;
+            if *op == '^' {
+                RefNum::F(ref_as_f64(l).powf(ref_as_f64(r)))
+            } else if let (RefNum::I(a), RefNum::I(b)) = (l, r) {
+                RefNum::I(
+                    match op {
+                        '+' => a.checked_add(b),
+                        '-' => a.checked_sub(b),
+                        '*' => a.checked_mul(b),
+                        '/' => a.checked_div(b),
+                        '%' => a.checked_rem(b),
+                        _ => unreachable!(),
+                    }
+                    .ok_or(())?,
+                )
+            } else {
+                let (a, b) = (ref_as_f64(l), ref_as_f64(r));
+                RefNum::F(match op {
+                    '+' => a + b,
+                    '-' => a - b,
+                    '*' => a * b,
+                    '/' => a / b,
+                    '%' => a % b,
+                    _ => unreachable!(),
+                })
+            }
+        },
+    })
+}
+
+/// Property: eval never panics on completely arbitrary text. Garbage must be
+/// rejected with an Err, not a crash.
+#[hegel::test]
+fn hegel_eval_never_panics_on_arbitrary_text(tc: hegel::TestCase) {
+    let s: String = tc.draw(generators::text());
+    drop(eval(&s));
+}
