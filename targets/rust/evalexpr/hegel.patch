+/// Property: eval never panics on "token soup" — sequences of valid lexical
+/// tokens in arbitrary order, which reach much deeper into the parser than
+/// plain garbage does.
+///
+/// `shl`, `shr` and `str::substring` are deliberately absent from the
+/// vocabulary: they can panic on inputs this test could assemble, which is
+/// pinned by known_failure_shift_panics_on_shift_overflow and
+/// known_failure_substring_panics_inside_multibyte_char.
+#[hegel::test]
+fn hegel_eval_never_panics_on_token_soup(tc: hegel::TestCase) {
