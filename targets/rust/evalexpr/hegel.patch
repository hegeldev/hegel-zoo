+/// KNOWN FAILURE: `str::substring` slices the string at raw byte indices
+/// without checking char boundaries (src/function/builtin.rs:295), so an
+/// index inside a multi-byte UTF-8 character makes `eval` PANIC instead of
+/// returning an error:
+///   byte index 1 is not a char boundary; it is inside 'ä' (bytes 0..2)
+#[test]
+fn known_failure_substring_panics_inside_multibyte_char() {
+    let result = eval("str::substring(\"\u{e4}\", 0, 1)");
+    // Any non-panicking result would be acceptable; today this line is never
+    // reached because eval panics.
+    assert!(result.is_err() || result.is_ok());
+}
