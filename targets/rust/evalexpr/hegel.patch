+/// Property: every i64 round-trips through its literal forms (decimal, and
+/// hex/octal/binary for the non-negative range those notations cover).
+#[hegel::test]
+fn hegel_int_literal_roundtrip(tc: hegel::TestCase) {
+    // i64::MIN excluded: pinned by known_failure_i64_min_literal_parses_as_float.
+    let n = tc.draw(generators::integers::<i64>().min_value(i64::MIN + 1));
+    assert_eq!(eval(&n.to_string()), Ok(Value::Int(n)));
+    if n >= 0 {
+        assert_eq!(eval(&format!("{:#x}", n)), Ok(Value::Int(n)));
+        assert_eq!(eval(&format!("{:#o}", n)), Ok(Value::Int(n)));
+        assert_eq!(eval(&format!("{:#b}", n)), Ok(Value::Int(n)));
+    }
+}
+
+/// Property: every finite f64 round-trips bit-exactly through its shortest
+/// decimal/scientific literal form.
+#[hegel::test]
+fn hegel_float_literal_roundtrip(tc: hegel::TestCase) {
+    let x = tc.draw(
+        generators::floats::<f64>()
+            .allow_nan(false)
+            .allow_infinity(false),
+    );
+    let rendered = format!("{:?}", x);
+    match eval(&rendered) {
+        Ok(Value::Float(y)) => assert_eq!(
+            x.to_bits(),
+            y.to_bits(),
+            "literal {rendered}: expected {x:?}, got {y:?}"
+        ),
+        other => panic!("literal {rendered}: expected Float, got {other:?}"),
+    }
+}
