+/// KNOWN FAILURE: the decimal literal for i64::MIN evaluates to
+/// Float(-9.223372036854776e18) instead of Int(i64::MIN). The tokenizer
+/// parses the unsigned digits `9223372036854775808`, which overflow i64, so
+/// it silently falls back to f64 before unary negation is applied. Every
+/// other i64 round-trips (see hegel_int_literal_roundtrip).
+#[test]
+fn known_failure_i64_min_literal_parses_as_float() {
+    assert_eq!(
+        eval("-9223372036854775808"),
+        Ok(Value::Int(i64::MIN)),
+        "i64::MIN literal should be an Int; it currently evaluates to a Float"
+    );
+}
