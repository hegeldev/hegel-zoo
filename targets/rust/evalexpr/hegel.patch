+/// Property: comparison operators on integer literals agree with Rust's i64
+/// comparisons.
+#[hegel::test]
+fn hegel_comparison_operators_match_rust_on_ints(tc: hegel::TestCase) {
+    // i64::MIN excluded: its literal parses as Float (pinned by
+    // known_failure_i64_min_literal_parses_as_float), which switches the
+    // comparison to lossy f64 semantics.
+    let a = tc.draw(generators::integers::<i64>().min_value(i64::MIN + 1));
+    let b = tc.draw(generators::integers::<i64>().min_value(i64::MIN + 1));
+    let op = tc.draw(generators::sampled_from(vec![
+        "<", ">", "<=", ">=", "==", "!=",
+    ]));
+    let expected = match op {
+        "<" => a < b,
+        ">" => a > b,
+        "<=" => a <= b,
+        ">=" => a >= b,
+        "==" => a == b,
+        "!=" => a != b,
+        _ => unreachable!(),
+    };
+    let expression = format!("{} {} {}", int_leaf(a), op, int_leaf(b));
+    assert_eq!(
+        eval(&expression),
+        Ok(Value::Boolean(expected)),
+        "expression: {expression}"
+    );
+}
+
+/// Property: `&&`, `||` and `!` on boolean literals agree with Rust's boolean
+/// operators. (evalexpr evaluates both operands eagerly — this asserts
+/// truth-table agreement, not short-circuiting.)
+#[hegel::test]
+fn hegel_boolean_operators_match_rust(tc: hegel::TestCase) {
+    let a = tc.draw(generators::booleans());
+    let b = tc.draw(generators::booleans());
+    let op = tc.draw(generators::sampled_from(vec!["&&", "||"]));
+    let expected = match op {
+        "&&" => a && !b,
+        "||" => a || !b,
+        _ => unreachable!(),
+    };
+    let expression = format!("{} {} !{}", a, op, b);
+    assert_eq!(
+        eval(&expression),
+        Ok(Value::Boolean(expected)),
+        "expression: {expression}"
+    );
+}
+
+/// Property: binary operators on string literals match Rust's String
+/// semantics: `+` concatenates, comparisons use lexicographic order.
+/// This exercises string-literal tokenization (including escapes) end-to-end.
+#[hegel::test]
+fn hegel_string_operators_match_rust(tc: hegel::TestCase) {
+    let a: String = tc.draw(generators::text().max_size(30));
+    let b: String = tc.draw(generators::text().max_size(30));
+    let op = tc.draw(generators::sampled_from(vec![
+        "+", "<", ">", "<=", ">=", "==", "!=",
+    ]));
+    let expected = match op {
+        "+" => Value::String(format!("{a}{b}")),
+        "<" => Value::Boolean(a < b),
+        ">" => Value::Boolean(a > b),
+        "<=" => Value::Boolean(a <= b),
+        ">=" => Value::Boolean(a >= b),
+        "==" => Value::Boolean(a == b),
+        "!=" => Value::Boolean(a != b),
+        _ => unreachable!(),
+    };
+    let expression = format!("{} {} {}", quote(&a), op, quote(&b));
+    assert_eq!(eval(&expression), Ok(expected), "expression: {expression}");
+}
