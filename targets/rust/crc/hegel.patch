+//! Hegel property tests for `crc`.
+//!
+//! The oracle is a bit-by-bit implementation of the Rocksoft / reveng parametrised CRC model
+//! (`Model`): the register is shifted one message bit at a time, which is the *definition* of the
+//! catalogue's fields (`width`, `poly`, `init`, `refin`, `refout`, `xorout`) and shares nothing
+//! with the crate's byte tables. The oracle itself is checked against every catalogue entry's
+//! `check` value (`reference_reproduces_every_catalogue_check_value`), and then every
+//! implementation of the crate (`NoTable`, `Table<1>`, `Table<16>`) is compared with it on
+//! catalogue algorithms and on random ones of every width from 1 to 128 bits, one-shot and
+//! chunked, with the algorithm's `init` and with a custom one.
+
+use crc::{Algorithm, Crc, NoTable, Table};
+use hegel::generators;
+use hegel::Generator as _;
+
+// ---------------------------------------------------------------------------------------------
+// The reference model
+// ---------------------------------------------------------------------------------------------
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Model {
+    width: u8,
+    poly: u128,
+    init: u128,
+    refin: bool,
+    refout: bool,
+    xorout: u128,
+}
+
+fn mask(width: u8) -> u128 {
+    if width == 128 {
+        u128::MAX
+    } else {
+        (1u128 << width) - 1
+    }
+}
+
+/// Reverse the low `width` bits.
+fn reflect(v: u128, width: u8) -> u128 {
+    v.reverse_bits() >> (128 - width as u32)
+}
+
+impl Model {
+    fn of<W: Word>(alg: &Algorithm<W>) -> Model {
+        Model {
+            width: alg.width,
+            poly: alg.poly.widen(),
+            init: alg.init.widen(),
+            refin: alg.refin,
+            refout: alg.refout,
+            xorout: alg.xorout.widen(),
+        }
+    }
+
+    /// The register after starting from `init` and reading `data`, bit by bit (MSB first, or LSB
+    /// first when `refin`).
+    fn register_after(&self, init: u128, data: &[u8]) -> u128 {
+        let m = mask(self.width);
+        let top = 1u128 << (self.width - 1);
+        let poly = self.poly & m;
+        let mut crc = init & m;
+        for &b in data {
+            let byte = if self.refin { b.reverse_bits() } else { b };
+            for i in (0..8).rev() {
+                let bit = (byte >> i) & 1 == 1;
+                let feedback = (crc & top != 0) ^ bit;
+                crc = (crc << 1) & m;
+                if feedback {
+                    crc ^= poly;
+                }
+            }
+        }
+        crc
+    }
+
+    /// The catalogue's "optionally reflected register" (before `xorout`).
+    fn oriented(&self, register: u128) -> u128 {
+        if self.refout {
+            reflect(register, self.width)
+        } else {
+            register
+        }
+    }
+
+    fn checksum_from(&self, init: u128, data: &[u8]) -> u128 {
+        self.oriented(self.register_after(init, data)) ^ self.xorout
+    }
+
+    fn checksum(&self, data: &[u8]) -> u128 {
+        self.checksum_from(self.init, data)
+    }
+}
+
+impl hegel::PrettyPrintable for Model {
+    fn pretty_print(&self, printer: &mut hegel::pretty::PrettyPrinter) {
+        hegel::pretty::print_debug_repr(&format!("{self:?}"), printer);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Running the crate's implementations, generically over the register type
+// ---------------------------------------------------------------------------------------------
+
+/// One result per implementation: name, one-shot `checksum`, chunked `Digest` result (the digest
+/// is also cloned half way and both halves must agree).
+type Runs = Vec<(&'static str, u128, u128)>;
+
+trait Word: crc::Width + Copy + std::fmt::Debug + PartialEq + Send + Sync + 'static {
+    const BITS: u8;
+    /// `Crc::<W>::new(alg).checksum(data)` with the default implementation.
+    fn checksum(alg: &'static Algorithm<Self>, data: &[u8]) -> u128;
+    fn widen(self) -> u128;
+    fn narrow(v: u128) -> Self;
+    /// Every implementation on `alg`, started from `alg.init` (or `initial`, through
+    /// `digest_with_initial`, in which case the one-shot column is the digest fed all at once).
+    fn runs(alg: &'static Algorithm<Self>, chunks: &[Vec<u8>], initial: Option<Self>) -> Runs;
+}
+
+macro_rules! word {
+    ($t:ty, $bits:expr) => {
+        impl Word for $t {
+            const BITS: u8 = $bits;
+            fn widen(self) -> u128 {
+                self as u128
+            }
+            fn narrow(v: u128) -> Self {
+                v as $t
+            }
+            fn checksum(alg: &'static Algorithm<Self>, data: &[u8]) -> u128 {
+                Crc::<$t>::new(alg).checksum(data).widen()
+            }
+            fn runs(alg: &'static Algorithm<Self>, chunks: &[Vec<u8>], initial: Option<Self>) -> Runs {
+                let all: Vec<u8> = chunks.concat();
+                macro_rules! run {
+                    ($name:expr, $imp:ty) => {{
+                        let crc = Crc::<$t, $imp>::new(alg);
+                        let one_shot = match initial {
+                            None => crc.checksum(&all),
+                            Some(init) => {
+                                let mut d = crc.digest_with_initial(init);
+                                d.update(&all);
+                                d.finalize()
+                            }
+                        };
+                        let mut d = match initial {
+                            None => crc.digest(),
+                            Some(init) => crc.digest_with_initial(init),
+                        };
+                        let half = chunks.len() / 2;
+                        for c in &chunks[..half] {
+                            d.update(c);
+                        }
+                        let mut twin = d.clone();
+                        for c in &chunks[half..] {
+                            d.update(c);
+                            twin.update(c);
+                        }
+                        let chunked = d.finalize();
+                        assert_eq!(twin.finalize(), chunked, "{}: a cloned Digest diverged", $name);
+                        ($name, one_shot.widen(), chunked.widen())
+                    }};
+                }
+                vec![
+                    run!("NoTable", NoTable),
+                    run!("Table<1>", Table<1>),
+                    run!("Table<16>", Table<16>),
+                ]
+            }
+        }
+    };
+}
+
+word!(u8, 8);
+word!(u16, 16);
+word!(u32, 32);
+word!(u64, 64);
+word!(u128, 128);
+
+fn check_runs<W: Word>(alg: &'static Algorithm<W>, chunks: &[Vec<u8>], initial: Option<W>, what: &str) {
+    let model = Model::of(alg);
+    let all: Vec<u8> = chunks.concat();
+    let expected = match initial {
+        None => model.checksum(&all),
+        Some(init) => model.checksum_from(init.widen(), &all),
+    };
+    for (name, one_shot, chunked) in W::runs(alg, chunks, initial) {
+        assert_eq!(
+            one_shot, expected,
+            "{what}: {name} one-shot checksum {one_shot:#x} != reference {expected:#x} for {model:?}, data {all:02x?}"
+        );
+        assert_eq!(
+            chunked, expected,
+            "{what}: {name} chunked digest {chunked:#x} != reference {expected:#x} for {model:?}, chunks {chunks:02x?}"
+        );
+    }
+}
+
+/// `residue`: the (optionally reflected) register after reading an error-free codeword — the
+/// message followed by its own CRC, transmitted MSB-first (`refout == false`) or LSB-first
+/// (`refout == true`). Only meaningful for whole-byte widths with `refin == refout`.
+fn check_residue<W: Word>(alg: &'static Algorithm<W>, data: &[u8]) {
+    if alg.width % 8 != 0 || alg.refin != alg.refout {
+        return;
+    }
+    let bytes = alg.width as usize / 8;
+    let sum = W::checksum(alg, data);
+    let mut codeword = data.to_vec();
+    if alg.refout {
+        codeword.extend_from_slice(&sum.to_le_bytes()[..bytes]);
+    } else {
+        codeword.extend_from_slice(&sum.to_be_bytes()[16 - bytes..]);
+    }
+    let register = W::checksum(alg, &codeword) ^ alg.xorout.widen();
+    assert_eq!(
+        register,
+        alg.residue.widen(),
+        "residue of a codeword under {:?} is {register:#x}, catalogue says {:#x}",
+        Model::of(alg),
+        alg.residue.widen()
+    );
+}
+
+// ---------------------------------------------------------------------------------------------
+// The catalogue (crc-catalog 2.5: every constant re-exported by `crc`)
+// ---------------------------------------------------------------------------------------------
+
+macro_rules! catalogue {
+    ($($name:ident),* $(,)?) => {
+        vec![$((stringify!($name), &crc::$name)),*]
+    };
+}
+
+fn catalogue_u8() -> Vec<(&'static str, &'static Algorithm<u8>)> {
+    catalogue![
+        CRC_3_GSM, CRC_3_ROHC, CRC_4_G_704, CRC_4_INTERLAKEN, CRC_5_EPC_C1G2, CRC_5_G_704,
+        CRC_5_USB, CRC_6_CDMA2000_A, CRC_6_CDMA2000_B, CRC_6_DARC, CRC_6_G_704, CRC_6_GSM,
+        CRC_7_MMC, CRC_7_ROHC, CRC_7_UMTS, CRC_8_AUTOSAR, CRC_8_BLUETOOTH, CRC_8_CDMA2000,
+        CRC_8_DARC, CRC_8_DVB_S2, CRC_8_GSM_A, CRC_8_GSM_B, CRC_8_HITAG, CRC_8_I_432_1,
+        CRC_8_I_CODE, CRC_8_LTE, CRC_8_MAXIM_DOW, CRC_8_MIFARE_MAD, CRC_8_NRSC_5,
+        CRC_8_OPENSAFETY, CRC_8_ROHC, CRC_8_SAE_J1850, CRC_8_SMBUS, CRC_8_TECH_3250, CRC_8_WCDMA,
+    ]
+}
+
+fn catalogue_u16() -> Vec<(&'static str, &'static Algorithm<u16>)> {
+    catalogue![
+        CRC_10_ATM, CRC_10_CDMA2000, CRC_10_GSM, CRC_11_FLEXRAY, CRC_11_UMTS, CRC_12_CDMA2000,
+        CRC_12_DECT, CRC_12_GSM, CRC_12_UMTS, CRC_13_BBC, CRC_14_DARC, CRC_14_GSM, CRC_15_CAN,
+        CRC_15_MPT1327, CRC_16_ARC, CRC_16_CDMA2000, CRC_16_CMS, CRC_16_DDS_110, CRC_16_DECT_R,
+        CRC_16_DECT_X, CRC_16_DNP, CRC_16_EN_13757, CRC_16_GENIBUS, CRC_16_GSM, CRC_16_IBM_3740,
+        CRC_16_IBM_SDLC, CRC_16_ISO_IEC_14443_3_A, CRC_16_KERMIT, CRC_16_LJ1200, CRC_16_M17,
+        CRC_16_MAXIM_DOW, CRC_16_MCRF4XX, CRC_16_MODBUS, CRC_16_NRSC_5, CRC_16_OPENSAFETY_A,
+        CRC_16_OPENSAFETY_B, CRC_16_PROFIBUS, CRC_16_RIELLO, CRC_16_SPI_FUJITSU, CRC_16_T10_DIF,
+        CRC_16_TELEDISK, CRC_16_TMS37157, CRC_16_UMTS, CRC_16_USB, CRC_16_XMODEM,
+    ]
+}
+
+fn catalogue_u32() -> Vec<(&'static str, &'static Algorithm<u32>)> {
+    catalogue![
+        CRC_17_CAN_FD, CRC_21_CAN_FD, CRC_24_BLE, CRC_24_FLEXRAY_A, CRC_24_FLEXRAY_B,
+        CRC_24_INTERLAKEN, CRC_24_LTE_A, CRC_24_LTE_B, CRC_24_OPENPGP, CRC_24_OS_9, CRC_30_CDMA,
+        CRC_31_PHILIPS, CRC_32_AIXM, CRC_32_AUTOSAR, CRC_32_BASE91_D, CRC_32_BZIP2,
+        CRC_32_CD_ROM_EDC, CRC_32_CKSUM, CRC_32_ISCSI, CRC_32_ISO_HDLC, CRC_32_JAMCRC, CRC_32_MEF,
+        CRC_32_MPEG_2, CRC_32_XFER,
+    ]
+}
+
+fn catalogue_u64() -> Vec<(&'static str, &'static Algorithm<u64>)> {
+    catalogue![
+        CRC_40_GSM, CRC_64_ECMA_182, CRC_64_GO_ISO, CRC_64_MS, CRC_64_NVME, CRC_64_REDIS,
+        CRC_64_WE, CRC_64_XZ,
+    ]
+}
+
+fn catalogue_u128() -> Vec<(&'static str, &'static Algorithm<u128>)> {
+    catalogue![CRC_82_DARC]
+}
+
+fn check_catalogue_entry<W: Word>(name: &str, alg: &'static Algorithm<W>) {
+    let model = Model::of(alg);
+    let reference = model.checksum(b"123456789");
+    assert_eq!(reference, alg.check.widen(), "reference model disagrees with {name}'s check value");
+    let sum = W::checksum(alg, b"123456789");
+    assert_eq!(sum, alg.check.widen(), "{name}: crate's checksum of \"123456789\" is not the catalogue's check value");
+    check_residue(alg, b"123456789");
+}
+
+/// The oracle is right: the bit-by-bit model reproduces the catalogue's `check` value (the CRC of
+/// `"123456789"`) for all 113 algorithms — and so does the crate, and its `residue` holds for
+/// every whole-byte, `refin == refout` algorithm.
+#[test]
+fn reference_reproduces_every_catalogue_check_value() {
+    for (n, a) in catalogue_u8() {
+        check_catalogue_entry(n, a);
+    }
+    for (n, a) in catalogue_u16() {
+        check_catalogue_entry(n, a);
+    }
+    for (n, a) in catalogue_u32() {
+        check_catalogue_entry(n, a);
+    }
+    for (n, a) in catalogue_u64() {
+        check_catalogue_entry(n, a);
+    }
+    for (n, a) in catalogue_u128() {
+        check_catalogue_entry(n, a);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Generators
+// ---------------------------------------------------------------------------------------------
+
+/// Chunks of input: short and long, so that `Table<16>` runs its 16-byte loop several times and
+/// also sees every residue of the length, and chunk boundaries fall anywhere.
+fn arb_chunks() -> impl hegel::PrintableGenerator<Vec<Vec<u8>>> {
+    generators::vecs(generators::binary().max_size(70)).max_size(5)
+}
+
+/// A random algorithm of the register type `W`: any width from 1 to `W::BITS`, any polynomial,
+/// init and xorout within the width, any reflection settings (the catalogue has all four
+/// combinations). `check`/`residue` are informational fields the crate does not read.
+#[hegel::composite]
+fn arb_algorithm(tc: &hegel::TestCase, bits: u8) -> Model {
+    let width = tc.draw(generators::integers::<u8>().min_value(1).max_value(bits));
+    let m = mask(width);
+    let poly = tc.draw(generators::integers::<u128>()) & m;
+    let init = tc.draw(generators::integers::<u128>()) & m;
+    let refin = tc.draw(generators::booleans());
+    let refout = tc.draw(generators::booleans());
+    let xorout = tc.draw(generators::integers::<u128>()) & m;
+    Model { width, poly, init, refin, refout, xorout }
+}
+
+/// `Crc::new` wants a `&'static Algorithm`; a test leaks a few dozen bytes per case.
+fn leak<W: Word>(model: Model) -> &'static Algorithm<W> {
+    Box::leak(Box::new(Algorithm {
+        width: model.width,
+        poly: W::narrow(model.poly),
+        init: W::narrow(model.init),
+        refin: model.refin,
+        refout: model.refout,
+        xorout: W::narrow(model.xorout),
+        check: W::narrow(0),
+        residue: W::narrow(0),
+    }))
+}
+
+// ---------------------------------------------------------------------------------------------
+// Properties, one pair per register type
+// ---------------------------------------------------------------------------------------------
+
+fn catalogue_property<W: Word>(tc: &hegel::TestCase, catalogue: Vec<(&'static str, &'static Algorithm<W>)>) {
+    let (name, alg) = tc.draw(generators::sampled_from(catalogue).print_as_debug());
+    let chunks = tc.draw(arb_chunks());
+    check_runs(alg, &chunks, None, name);
+    check_residue(alg, &chunks.concat());
+}
+
+fn custom_property<W: Word>(tc: &hegel::TestCase) {
+    let model = tc.draw(arb_algorithm(W::BITS));
+    let chunks = tc.draw(arb_chunks());
+    let initial = tc
+        .draw(generators::optional(generators::integers::<u128>()))
+        .map(|v| W::narrow(v & mask(model.width)));
+    let alg = leak::<W>(model);
+    check_runs(alg, &chunks, initial, "custom algorithm");
+}
+
+macro_rules! properties {
+    ($cat:ident, $custom:ident, $t:ty, $catalogue:ident) => {
+        /// Every catalogue algorithm of this register type, on arbitrary data split into arbitrary
+        /// chunks: `NoTable`, `Table<1>` and `Table<16>` all equal the bit-by-bit model, one-shot
+        /// and through a `Digest` (cloned half way), and the `residue` holds where defined.
+        #[hegel::test]
+        fn $cat(tc: hegel::TestCase) {
+            catalogue_property::<$t>(&tc, $catalogue());
+        }
+
+        /// A random algorithm of this register type — any width, polynomial, init, xorout and
+        /// reflection settings — with the algorithm's `init` or a custom one through
+        /// `digest_with_initial` ("the effects of `refin` and `width` are applied to the custom
+        /// initial value"): all three implementations equal the bit-by-bit model.
+        #[hegel::test]
+        fn $custom(tc: hegel::TestCase) {
+            custom_property::<$t>(&tc);
+        }
+    };
+}
+
+properties!(catalogue_u8_matches_the_bitwise_model, custom_u8_matches_the_bitwise_model, u8, catalogue_u8);
+properties!(catalogue_u16_matches_the_bitwise_model, custom_u16_matches_the_bitwise_model, u16, catalogue_u16);
+properties!(catalogue_u32_matches_the_bitwise_model, custom_u32_matches_the_bitwise_model, u32, catalogue_u32);
+properties!(catalogue_u64_matches_the_bitwise_model, custom_u64_matches_the_bitwise_model, u64, catalogue_u64);
+properties!(catalogue_u128_matches_the_bitwise_model, custom_u128_matches_the_bitwise_model, u128, catalogue_u128);
