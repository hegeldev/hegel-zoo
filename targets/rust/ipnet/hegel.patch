+    // KNOWN BUG (kept failing deliberately, see HEGEL_REPORT.md): aggregate()
+    // grows the address set for inputs whose broadcast is one below the top of
+    // the address space, e.g. aggregate([255.255.255.254/32]) ==
+    // [255.255.255.254/31], which adds 255.255.255.255. The half-open interval
+    // representation saturates at MAX, and `if end != MAX { end -= 1 }` then
+    // treats "ends at MAX - 1" as "ends at MAX". The elevated case count makes
+    // the failure reproduce reliably in a default run.
+    #[hegel::test(test_cases = 1000)]
+    fn hegel_aggregate_preserves_address_membership(tc: hegel::TestCase) {
+        let nets: Vec<IpNet> = tc.draw((generators::vecs(ip_nets()).max_size(8)).print_as_debug());
+        let aggs = IpNet::aggregate(&nets);
+        for a in &aggs {
+            assert_eq!(a.addr(), a.network(), "aggregate returned non-truncated net {}", a);
+        }
+        // Membership must be preserved exactly. Probe a few arbitrary
+        // addresses plus the boundaries (and one-past-boundaries) of every
+        // input net, where off-by-one bugs live.
+        let mut candidates: Vec<IpAddr> = Vec::new();
+        for _ in 0..4 {
+            candidates.push(if tc.draw(generators::booleans()) {
+                IpAddr::V4(Ipv4Addr::from(tc.draw(ipv4_addr_bits())))
+            } else {
+                IpAddr::V6(Ipv6Addr::from(tc.draw(ipv6_addr_bits())))
+            });
+        }
+        for n in &nets {
+            match n {
+                IpNet::V4(n) => {
+                    let lo = u32::from(n.network());
+                    let hi = u32::from(n.broadcast());
+                    for bits in [lo.wrapping_sub(1), lo, hi, hi.wrapping_add(1)] {
+                        candidates.push(IpAddr::V4(Ipv4Addr::from(bits)));
+                    }
+                }
+                IpNet::V6(n) => {
+                    let lo = u128::from(n.network());
+                    let hi = u128::from(n.broadcast());
+                    for bits in [lo.wrapping_sub(1), lo, hi, hi.wrapping_add(1)] {
+                        candidates.push(IpAddr::V6(Ipv6Addr::from(bits)));
+                    }
+                }
+            }
+        }
+        for addr in candidates {
+            let in_inputs = nets.iter().any(|n| n.contains(&addr));
+            let in_aggs = aggs.iter().any(|n| n.contains(&addr));
+            assert_eq!(
+                in_inputs, in_aggs,
+                "aggregate changed membership of {} (inputs {:?} -> aggregated {:?})",
+                addr, nets, aggs,
+            );
+        }
+    }
