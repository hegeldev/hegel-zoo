+    #[hegel::test]
+    fn hegel_ipv4_hosts_count_and_endpoints_match_docs(tc: hegel::TestCase) {
+        let net = tc.draw((ipv4_nets()).print_as_debug());
+        let p = net.prefix_len();
+        // Documented: network and broadcast are excluded unless prefix_len >= 31.
+        let expected: u64 = match p {
+            32 => 1,
+            31 => 2,
+            _ => (1u64 << (32 - p)) - 2,
+        };
+        assert_eq!(net.hosts().count() as u64, expected);
+        let first = net.hosts().next();
+        let last = net.hosts().last();
+        if p < 31 {
+            assert_eq!(first, Some(net.network().saturating_add(1)));
+            assert_eq!(last, Some(net.broadcast().saturating_sub(1)));
+        } else {
+            assert_eq!(first, Some(net.network()));
+            assert_eq!(last, Some(net.broadcast()));
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_ipv6_hosts_count_and_endpoints_match_docs(tc: hegel::TestCase) {
+        let net = tc.draw((ipv6_nets()).print_as_debug());
+        let p = net.prefix_len();
+        // Documented: hosts() spans every address in the network for IPv6.
+        assert_eq!(net.hosts().next(), Some(net.network()));
+        assert_eq!(net.hosts().last(), Some(net.broadcast()));
+        // count() is documented to overflow/panic for ranges larger than what
+        // fits; only assert the count where it fits in usize. This bound
+        // protects the test, not the library's contract.
+        if p >= 65 {
+            let expected: u128 = 1u128 << (128 - p);
+            assert_eq!(net.hosts().count() as u128, expected);
+        }
+    }
