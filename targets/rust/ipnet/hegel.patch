+        let expected = b4.prefix_len() >= a4.prefix_len() && v4_net_has_addr(&a4, b4.network());
+        assert_eq!(a4.contains(&b4), expected, "a {} b {}", a4, b4);
+
+        let a6 = tc.draw((ipv6_nets()).print_as_debug());
+        let b6 = if tc.draw(generators::booleans()) {
+            tc.draw((ipv6_nets()).print_as_debug())
+        } else {
