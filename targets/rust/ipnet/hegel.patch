+
+    // Reference implementation of "address is inside the network", used as an
+    // oracle: an address is in a network iff its first prefix_len bits agree
+    // with the network address' first prefix_len bits.
+    fn v4_net_has_addr(net: &Ipv4Net, addr: Ipv4Addr) -> bool {
+        let p = net.prefix_len();
+        p == 0 || (u32::from(addr) ^ u32::from(net.addr())) >> (32 - p as u32) == 0
+    }
+
+    fn v6_net_has_addr(net: &Ipv6Net, addr: Ipv6Addr) -> bool {
+        let p = net.prefix_len();
+        p == 0 || (u128::from(addr) ^ u128::from(net.addr())) >> (128 - p as u32) == 0
+    }
+
+    // Draw an Ipv4Net that is (by construction) a subset of `outer`.
+    fn draw_v4_net_inside(tc: &hegel::TestCase, outer: &Ipv4Net) -> Ipv4Net {
+        let bits = u32::from(outer.network())
+            | (tc.draw(ipv4_addr_bits()) & u32::from(outer.hostmask()));
+        let p = tc.draw(
+            generators::integers::<u8>()
+                .min_value(outer.prefix_len())
+                .max_value(32),
+        );
+        Ipv4Net::new(Ipv4Addr::from(bits), p).unwrap()
+    }
+
+    fn draw_v6_net_inside(tc: &hegel::TestCase, outer: &Ipv6Net) -> Ipv6Net {
+        let bits = u128::from(outer.network())
+            | (tc.draw(ipv6_addr_bits()) & u128::from(outer.hostmask()));
+        let p = tc.draw(
+            generators::integers::<u8>()
+                .min_value(outer.prefix_len())
+                .max_value(128),
+        );
+        Ipv6Net::new(Ipv6Addr::from(bits), p).unwrap()
+    }
