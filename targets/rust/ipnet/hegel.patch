+    #[hegel::test]
+    fn hegel_netmask_hostmask_are_complementary(tc: hegel::TestCase) {
+        let net = tc.draw((ip_nets()).print_as_debug());
+        match (net, net.netmask(), net.hostmask()) {
+            (IpNet::V4(n), IpAddr::V4(m), IpAddr::V4(h)) => {
+                let (m, h) = (u32::from(m), u32::from(h));
+                assert_eq!(m ^ h, u32::MAX);
+                assert_eq!(m.leading_ones(), n.prefix_len() as u32);
+                assert_eq!(m.count_ones(), n.prefix_len() as u32);
+            }
+            (IpNet::V6(n), IpAddr::V6(m), IpAddr::V6(h)) => {
+                let (m, h) = (u128::from(m), u128::from(h));
+                assert_eq!(m ^ h, u128::MAX);
+                assert_eq!(m.leading_ones(), n.prefix_len() as u32);
+                assert_eq!(m.count_ones(), n.prefix_len() as u32);
+            }
+            (net, m, h) => panic!("netmask/hostmask changed IP family: {} {} {}", net, m, h),
+        }
