+    /// Arbitrary IPv4 address bits, with boundary values boosted so that
+    /// conjunctions like "the range covers the whole address space" are
+    /// reachable within a default test run.
+    #[hegel::composite]
+    fn ipv4_addr_bits(tc: &hegel::TestCase) -> u32 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u32>(),
+            generators::sampled_from(vec![0u32, 1, u32::MAX - 1, u32::MAX]),
+        ))
