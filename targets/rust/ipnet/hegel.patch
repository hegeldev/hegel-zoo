+    #[hegel::test]
+    fn hegel_ord_consistent_with_contains(tc: hegel::TestCase) {
+        // For truncated networks, a strict superset must sort strictly before
+        // its subsets (Ord is derived on (addr, prefix_len)).
+        let a = tc.draw((ip_nets()).print_as_debug());
+        let b = if tc.draw(generators::booleans()) {
+            tc.draw((ip_nets()).print_as_debug())
+        } else {
+            // Boost the contained case, otherwise contains() is nearly always false.
+            match a {
+                IpNet::V4(n) => IpNet::V4(draw_v4_net_inside(&tc, &n)),
+                IpNet::V6(n) => IpNet::V6(draw_v6_net_inside(&tc, &n)),
+            }
+        };
+        let (a, b) = (a.trunc(), b.trunc());
+        if a != b {
+            if a.contains(&b) {
+                assert!(a < b, "{} contains {} but does not sort before it", a, b);
+            }
+            if b.contains(&a) {
+                assert!(b < a, "{} contains {} but does not sort before it", b, a);
+            }
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_trunc_preserves_range_and_is_idempotent(tc: hegel::TestCase) {
+        let net = tc.draw((ip_nets()).print_as_debug());
+        let t = net.trunc();
+        assert_eq!(t.prefix_len(), net.prefix_len());
+        assert_eq!(t.addr(), net.network());
+        assert_eq!(t.network(), net.network());
+        assert_eq!(t.broadcast(), net.broadcast());
+        assert_eq!(t.trunc(), t, "trunc must be idempotent");
+    }
 }
