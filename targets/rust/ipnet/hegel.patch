+    #[hegel::test]
+    fn hegel_contains_net_iff_longer_prefix_and_network_inside(tc: hegel::TestCase) {
+        // CIDR fact: b is a subset of a iff b's prefix is at least as long as
+        // a's and b's network address lies inside a.
+        let a4 = tc.draw((ipv4_nets()).print_as_debug());
+        let b4 = if tc.draw(generators::booleans()) {
+            tc.draw((ipv4_nets()).print_as_debug())
+        } else {
+            draw_v4_net_inside(&tc, &a4)
