+// ---------------------------------------------------------------------------
+// KNOWN FAILURE (real bug, process-aborting): stack overflow on deeply nested
+// source.
+//
+// #[ignore]d because a stack overflow aborts the whole process (SIGABRT) and
+// would take the entire test binary down with it - it cannot be a normal
+// failing test. Run explicitly with:
+//   cargo test --test scripts known_bug_deep_nesting_stack_overflow -- --ignored
+//
+// The parser installs a recursion guard (MAX_RECURSION = 200 in
+// src/compiler/parser.rs) whose stated purpose is to reject over-nested input
+// gracefully. For several very common constructs, though, the per-level stack
+// frames are large enough that ~150 levels of nesting overflow the stack
+// BEFORE the guard's limit of 200 is reached, so `Closure::load` aborts the
+// host process instead of returning Err. Confirmed to overflow between depth
+// 100 and 150 for:
+//   - nested table constructors:  {{{ ... }}}
+//   - nested if blocks:           if true then if true then ... end end
+//   - nested function bodies:     function() return function() ... end end
+//   - nested index expressions:   x[x[x[ ... ]]]
+// (Guarded constructs - parens, `not`, unary `-`, `~`, `..`, `do` blocks -
+// correctly return Err("recursion limit reached") even at depth 4000.)
+//
+// Untrusted Lua of a few hundred nesting levels can therefore crash any
+// piccolo embedding. Depth 1000 reproduces well within a standard 2 MiB test
+// thread stack; the exact threshold is stack-size dependent, but the guard
+// limit is simply set too high to bound these paths.
+//
+// Code path: piccolo::Closure::load -> compiler::parse_chunk ->
+// Parser::parse_table_constructor / parse_if_statement / parse_block ->
+// (recurses without the recursion_guard bounding it below the stack limit).
+// ---------------------------------------------------------------------------
+#[test]
+#[ignore = "aborts the process via stack overflow; documents a real bug"]
+fn known_bug_deep_nesting_stack_overflow() {
+    use piccolo::{Closure, Lua};
+    let depth = 1000;
+    let source = format!("return {}{}", "{".repeat(depth), "}".repeat(depth));
+    let mut lua = Lua::core();
+    let r = lua.try_enter(|ctx| {
+        Closure::load(ctx, None, source.as_bytes())?;
+        Ok(())
+    });
+    // If piccolo bounded recursion correctly this would be a graceful Err;
+    // instead the line above aborts the process before we get here.
+    assert!(
+        r.is_err(),
+        "expected a graceful recursion-limit error, not a stack overflow"
+    );
+}
