+//! Hegel property tests for `shell-words`.
+//!
+//! The crate documents `split` as giving "exactly the same" result as a Unix shell when the
+//! input has no operators, assignments or expansions, and `quote`/`join` as preserving a word's
+//! "literal meaning when used as a part of command in Unix shell".  So the oracles are the
+//! shells themselves, plus Python's `shlex`, which the doc names as "very close":
+//!
+//! - one `bash` child is held open for the whole run; a compound array assignment `x=( <text> )`
+//!   is bash's own word splitter, and it accepts newlines between words like the crate does;
+//! - `dash` and `busybox sh` run once per case (`set -- <quoted words>`);
+//! - one `python3` child answers `shlex.split`, `shlex.quote` and `shlex.join`.
+//!
+//! Strings travel as hex, so control characters go through unchanged.
+
+extern crate hegel;
+extern crate shell_words;
+
+use std::ffi::OsStr;
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::ffi::OsStrExt;
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::sync::{Mutex, OnceLock};
+
+use hegel::generators::Generator as _;
+use hegel::{generators, TestCase};
+use shell_words::{join, quote, split, ParseError};
+
+// ---------------------------------------------------------------- generators
+
+/// Units of a command line: letters, whitespace (newlines included), quotes, backslashes,
+/// comments, `!`, `^`, `\r`, punctuation bash leaves alone inside an array assignment, control
+/// characters and non-ASCII.  Nothing bash would expand (`$`, backquote, `~`, globs, braces) and
+/// no `=`/`[`/`(`/`)`: those mean something to an array assignment.  A unit listed twice is
+/// drawn twice as often.
+const SPLIT_UNITS: &[&str] = &[
+    "a", "b", "Z", "0", "9", " ", " ", " ", "\t", "\n", "\n", "'", "'", "\"", "\"", "\\", "\\",
+    "\\", "#", "!", "^", "\r", "-", ".", "/", "_", ",", "%", "+", ":", "@", "]", "\x02", "\x1f",
+    "\u{e9}", "\u{a0}", "🦉",
+];
+// Control characters: not `\x01` and `\x7f`, which are bash's internal CTLESC/CTLNUL markers and
+// which bash 5.2.21 itself mangles after a quote or a backslash (`x=( "'\x7f" )` gives
+// `'\x01\x7f`; dash and busybox ash are fine) — a bash bug, outside the crate.
+
+/// Units of a word to be quoted: everything, including what shells expand.
+const WORD_UNITS: &[&str] = &[
+    "a", "z", "A", "0", " ", "\t", "\n", "\r", "'", "'", "\"", "\"", "\\", "\\", "$", "`", "!",
+    "^", "#", "*", "?", "[", "]", "{", "}", "~", "=", "%", ",", ";", "|", "&", "(", ")", "<", ">",
+    "+", "-", ".", "/", ":", "@", "_", "\x02", "\x1b", "\x1f", "\u{e9}", "😀", "\u{a0}",
+];
+
+/// Up to `max` units of `pool`, concatenated.  (`text().alphabet()` would do, but it treats its
+/// alphabet as a set, and the pools weight quotes, backslashes and whitespace by repetition.)
+fn units(pool: &'static [&'static str], max: usize) -> impl hegel::PrintableGenerator<String> {
+    generators::vecs(generators::sampled_from(pool))
+        .max_size(max)
+        .map(|v| v.concat())
+}
+
+/// A command line for `split`.
+fn split_text() -> impl hegel::PrintableGenerator<String> {
+    units(SPLIT_UNITS, 14)
+}
+
+/// A word for `quote`.
+fn word() -> impl hegel::PrintableGenerator<String> {
+    units(WORD_UNITS, 8)
+}
+
+/// A command line's worth of words for `join`.
+fn words() -> impl hegel::PrintableGenerator<Vec<String>> {
+    generators::vecs(word()).max_size(4)
+}
+
+fn ints(lo: i64, hi: i64) -> generators::IntegerGenerator<i64> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// What bash brace-expands between `{` and `}`: a comma list, a numeric range or a letter range.
+fn brace_inner() -> impl hegel::PrintableGenerator<String> {
+    hegel::one_of!(
+        generators::vecs(generators::sampled_from(&["a", "b", "", "x.y"]))
+            .min_size(2)
+            .max_size(3)
+            .map(|v| v.join(",")),
+        hegel::tuples!(ints(0, 3), ints(0, 9)).map(|(lo, hi)| format!("{}..{}", lo, hi)),
+        hegel::tuples!(
+            generators::sampled_from(&["a", "c"]),
+            generators::sampled_from(&["d", "z"])
+        )
+        .map(|(lo, hi)| format!("{}..{}", lo, hi)),
+    )
+}
+
+/// A command and a word bash brace-expands: `rm {a,b}`, `echo pre{0..9}.txt`.
+fn brace_command() -> impl hegel::PrintableGenerator<Vec<String>> {
+    hegel::tuples!(
+        generators::sampled_from(&["rm", "echo"]),
+        generators::sampled_from(&["", "pre", "-"]),
+        brace_inner(),
+        generators::sampled_from(&["", ".txt", "/"]),
+    )
+    .map(|(cmd, pre, inner, post)| vec![cmd.to_string(), format!("{}{{{}}}{}", pre, inner, post)])
+}
+
+fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{:02x}", x)).collect()
+}
+
+fn unhex(s: &str) -> Vec<u8> {
+    (0..s.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap())
+        .collect()
+}
+
+/// NUL-separated words from a shell's `printf '%s\0'` loop.
+fn nul_words(out: &[u8]) -> Vec<String> {
+    let mut words: Vec<String> = out
+        .split(|&b| b == 0)
+        .map(|w| String::from_utf8_lossy(w).into_owned())
+        .collect();
+    words.pop(); // after the last `\0`
+    words
+}
+
+/// The crate's answer in the shells' shape.
+fn ours(text: &str) -> Option<Vec<String>> {
+    split(text).ok()
+}
+
+// ---------------------------------------------------------------- the shells
+
+struct Proc {
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+    _child: Child,
+}
+
+fn spawn(program: &str, args: &[&str]) -> Proc {
+    let mut child = Command::new(program)
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .spawn()
+        .unwrap_or_else(|e| panic!("{} is needed as an oracle: {}", program, e));
+    let stdin = child.stdin.take().unwrap();
+    let stdout = BufReader::new(child.stdout.take().unwrap());
+    Proc {
+        stdin,
+        stdout,
+        _child: child,
+    }
+}
+
+const END: &[u8] = b"\x01<<end-of-reply>>\x02\n";
+
+fn bash() -> &'static Mutex<Proc> {
+    static SH: OnceLock<Mutex<Proc>> = OnceLock::new();
+    SH.get_or_init(|| Mutex::new(spawn("bash", &["--norc", "--noprofile", "-s"])))
+}
+
+/// bash's word splitting of `text`: the elements of the array `x=( <text> )`, or `None` for a
+/// syntax error (an unterminated quote).  A newline is appended before the `)` so a trailing
+/// comment does not swallow it.
+fn bash_words(text: &str) -> Option<Vec<String>> {
+    let esc: String = text.bytes().map(|b| format!("\\x{:02x}", b)).collect();
+    let cmd = format!(
+        "printf -v t '{esc}'; x=(); if eval \"x=( $t \"$'\\n'\")\" 2>/dev/null; \
+         then for w in \"${{x[@]}}\"; do printf '%s\\0' \"$w\"; done; else printf '\\2'; fi; \
+         printf '\\1<<end-of-reply>>\\2\\n'\n"
+    );
+    let mut sh = bash().lock().unwrap();
+    sh.stdin.write_all(cmd.as_bytes()).unwrap();
+    let mut reply = Vec::new();
+    while !reply.ends_with(END) {
+        let got = sh.stdout.read_until(b'\n', &mut reply).unwrap();
+        assert!(got > 0, "bash died");
+    }
+    reply.truncate(reply.len() - END.len());
+    if reply == b"\x02" {
+        None
+    } else {
+        Some(nul_words(&reply))
+    }
+}
+
+/// `set -- <line>` in dash or busybox ash, one process per call.
+fn sh_words(shell: &[&str], line: &str) -> Option<Vec<String>> {
+    let mut script = b"set -- ".to_vec();
+    script.extend_from_slice(line.as_bytes());
+    script.extend_from_slice(b"\nfor w; do printf '%s\\0' \"$w\"; done");
+    let out = Command::new(shell[0])
+        .args(&shell[1..])
+        .arg("-c")
+        .arg(OsStr::from_bytes(&script))
+        .stderr(Stdio::null())
+        .output()
+        .unwrap_or_else(|e| panic!("{} is needed as an oracle: {}", shell[0], e));
+    if out.status.success() {
+        Some(nul_words(&out.stdout))
+    } else {
+        None
+    }
+}
+
+// ---------------------------------------------------------------- Python's shlex
+
+const PY_SERVER: &str = r#"
+import sys, shlex
+def dec(h): return bytes.fromhex(h).decode('utf-8', 'surrogateescape')
+def enc(s): return s.encode('utf-8', 'surrogateescape').hex()
+for line in sys.stdin:
+    parts = line.rstrip('\n').split(' ')
+    op, count = parts[0], int(parts[1])
+    args = [dec(h) for h in parts[2:2 + count]]
+    try:
+        if op == 'split':
+            r = shlex.split(args[0])
+        elif op == 'quote':
+            r = [shlex.quote(args[0])]
+        else:
+            r = [shlex.join(args)]
+        print('ok', len(r), *[enc(x) for x in r], flush=True)
+    except ValueError as e:
+        print('err', 1, enc(str(e)), flush=True)
+"#;
+
+fn py() -> &'static Mutex<Proc> {
+    static PY: OnceLock<Mutex<Proc>> = OnceLock::new();
+    PY.get_or_init(|| Mutex::new(spawn("python3", &["-u", "-c", PY_SERVER])))
+}
+
+/// `shlex.<op>(...)` in Python; `None` is a `ValueError`.
+fn python(op: &str, args: &[&str]) -> Option<Vec<String>> {
+    let mut line = format!("{} {}", op, args.len());
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a.as_bytes()));
+    }
+    line.push('\n');
+    let mut py = py().lock().unwrap();
+    py.stdin.write_all(line.as_bytes()).unwrap();
+    let mut reply = String::new();
+    py.stdout.read_line(&mut reply).unwrap();
+    let parts: Vec<&str> = reply.trim_end_matches('\n').split(' ').collect();
+    match parts[0] {
+        "ok" => Some(
+            parts[2..]
+                .iter()
+                .map(|h| String::from_utf8(unhex(h)).unwrap())
+                .collect(),
+        ),
+        _ => None,
+    }
+}
+
+fn python_split(text: &str) -> Option<Vec<String>> {
+    python("split", &[text])
+}
+
+fn python_quote(word: &str) -> String {
+    python("quote", &[word]).unwrap().remove(0)
+}
+
+fn python_join(words: &[String]) -> String {
+    let refs: Vec<&str> = words.iter().map(|w| w.as_str()).collect();
+    python("join", &refs).unwrap().remove(0)
+}
+
+// ---------------------------------------------------------------- properties: splitting
+
+/// `split` gives the words bash gives for the same text, and `Err(ParseError)` exactly where
+/// bash reports a syntax error.
+#[hegel::test]
+fn split_agrees_with_bash(tc: TestCase) {
+    let text = tc.draw(split_text());
+    // The array-assignment oracle cannot see a backslash that ends the input (it is followed by
+    // the closing parenthesis there); the shells' own answer for it is in `doc_examples`.
+    tc.assume(!text.ends_with('\\'));
+    let mine = ours(&text);
+    let theirs = bash_words(&text);
+    assert_eq!(
+        mine, theirs,
+        "text {:?}: crate {:?} bash {:?}",
+        text, mine, theirs
+    );
+}
+
+// ---------------------------------------------------------------- properties: quoting
+
+/// The pinned shape of shell-words/1: a word that bash brace-expands.
+fn has_brace_pair(word: &str) -> bool {
+    word.contains('{') && word.contains('}')
+}
+
+/// `join` produces a line that bash, dash, busybox ash, Python `shlex` and the crate's own
+/// `split` all split back into exactly the words; `quote` is the per-word piece of it.
+#[hegel::test]
+fn quoting_round_trips_through_every_shell(tc: TestCase) {
+    let words = tc.draw(words());
+    tc.assume(!words.iter().any(|w| has_brace_pair(w)));
+    let line = join(&words);
+    let pieces: Vec<String> = words.iter().map(|w| quote(w).into_owned()).collect();
+    assert_eq!(
+        line,
+        pieces.join(" "),
+        "join is the quoted words separated by single spaces"
+    );
+    let expected = Some(words.clone());
+    assert_eq!(ours(&line), expected, "own parser on {:?}", line);
+    let b = bash_words(&line);
+    assert_eq!(b, expected, "bash on {:?}: {:?}", line, b);
+    let d = sh_words(&["dash"], &line);
+    assert_eq!(d, expected, "dash on {:?}: {:?}", line, d);
+    let a = sh_words(&["busybox", "sh"], &line);
+    assert_eq!(a, expected, "busybox ash on {:?}: {:?}", line, a);
+    // Python's `shlex` treats `\r` as a delimiter — a divergence the crate documents — and
+    // `quote` leaves it bare, so Python is asked only when no word carries one.
+    if !words.iter().any(|w| w.contains('\r')) {
+        let p = python_split(&line);
+        assert_eq!(p, expected, "python shlex.split on {:?}: {:?}", line, p);
+    }
+}
+
+/// shell-words/1: `quote` leaves `{` and `}` unquoted, so a word with a brace pair is
+/// brace-expanded by bash (and zsh): `join(["{a,b}"])` is `{a,b}`, which bash splits into
+/// `a` and `b`; `{1..3}` becomes three words.
+#[hegel::test]
+fn brace_expansion_is_quoted(tc: TestCase) {
+    let words = tc.draw(brace_command());
+    let line = join(&words);
+    let b = bash_words(&line);
+    assert_eq!(
+        b,
+        Some(words.clone()),
+        "bash splits {:?} into {:?}",
+        line,
+        b
+    );
+}
+
+/// The other direction of Python compatibility: what Python's `shlex.quote`/`shlex.join`
+/// produce, the crate splits back into the words.
+#[hegel::test]
+fn python_quoting_is_understood(tc: TestCase) {
+    let words = tc.draw(words());
+    let line = python_join(&words);
+    assert_eq!(
+        ours(&line),
+        Some(words.clone()),
+        "shlex.join gave {:?}",
+        line
+    );
+    if let Some(w) = words.first() {
+        let q = python_quote(w);
+        assert_eq!(ours(&q), Some(vec![w.clone()]), "shlex.quote gave {:?}", q);
+    }
+}
+
+// ---------------------------------------------------------------- the documentation
+
+#[test]
+fn doc_examples() {
+    assert_eq!(split("").unwrap(), Vec::<String>::new());
+    assert_eq!(split("a\\\nb\\\nc").unwrap(), vec!["abc"]);
+    assert_eq!(split(" \\\n \n").unwrap(), Vec::<String>::new());
+    assert_eq!(split("\"\\$\"").unwrap(), vec!["$"]);
+    assert_eq!(split("c\ra\r'\r'\r").unwrap(), vec!["c\ra\r\r\r"]);
+    assert_eq!(split("'abc"), Err(ParseError));
+    assert_eq!(ParseError.to_string(), "missing closing quote");
+    // A backslash that ends the input is kept literally, as bash, dash and busybox ash keep it
+    // (`printf '%s' a\` prints `a\`).
+    assert_eq!(split("a\\").unwrap(), vec!["a\\"]);
+    assert_eq!(quote(""), "''");
+    assert_eq!(quote("'"), "''\\'''");
+    assert_eq!(quote("~root"), "'~root'");
+    assert_eq!(join(&[" ", "$", "\n"]), "' ' '$' '\n'");
+    let argv = ["python", "-c", "print('Hello world!')"];
+    assert_eq!(split(&join(&argv)).unwrap(), argv);
+}
