+    let extended = tc.draw(generators::booleans());
+    let mut boundaries: Vec<usize> = s.grapheme_indices(extended).map(|(i, _)| i).collect();
+    if boundaries.is_empty() {
+        boundaries.push(0);
+    }
+    boundaries.push(s.len());
+    boundaries.dedup();
+    let machine = CursorModel {
+        cursor: GraphemeCursor::new(0, s.len(), extended),
+        s,
+        boundaries,
+    };
+    hegel::stateful::machine(machine).run(tc);
+}
+
+/// Property: driving `GraphemeCursor::prev_boundary` backward over arbitrary
+/// chunk splits (answering `PrevChunk`/`PreContext` requests) visits exactly
+/// the boundaries reported by `grapheme_indices`, in reverse.
+#[hegel::test]
+fn hegel_cursor_prev_boundary_chunked_agrees_with_iterator(tc: hegel::TestCase) {
+    let s = tc.draw(segmentation_input());
+    let extended = tc.draw(generators::booleans());
+    let chunks = draw_chunks(&tc, &s);
+    tc.note(&format!("chunks: {chunks:?}"));
+
+    let expected: Vec<usize> = s
+        .grapheme_indices(extended)
+        .map(|(i, _)| i)
+        .rev()
+        .collect();
+
+    let mut cursor = GraphemeCursor::new(s.len(), s.len(), extended);
+    let mut found = Vec::new();
+    let mut idx = chunks.len() - 1;
+    let mut fuel = 4 * s.len() + 4 * chunks.len() + 16;
+    loop {
+        fuel -= 1;
+        assert!(
+            fuel > 0,
+            "cursor did not terminate on {:?} chunks {:?}",
+            s,
+            chunks
+        );
+        let (start, chunk) = chunks[idx];
+        match cursor.prev_boundary(chunk, start) {
+            Ok(Some(boundary)) => found.push(boundary),
+            Ok(None) => break,
+            Err(GraphemeIncomplete::PrevChunk) => {
+                idx = idx
+                    .checked_sub(1)
+                    .unwrap_or_else(|| panic!("PrevChunk before first chunk on {:?}", s));
+            }
+            Err(GraphemeIncomplete::PreContext(k)) => provide_pre_context(&mut cursor, &chunks, k),
+            Err(err) => panic!("unexpected error {:?} on {:?} chunks {:?}", err, s, chunks),
+        }
+    }
+    assert_eq!(
+        found, expected,
+        "prev_boundary over chunks {chunks:?} disagrees on {s:?} (extended={extended})"
+    );
+}
+
+/// Deterministic pin of the GB12/GB13 chunk-split bug found by
+/// `hegel_cursor_next_boundary_chunked_agrees_with_iterator` (the property needs the chunk split
+/// to fall between the two regional indicators, so it does not fail on every run). Offset 5 is
+/// inside the flag grapheme "\u{1f1e6}\u{1f1e6}": `grapheme_indices` reports 0, 1, 9 and a fresh
+/// cursor's `is_boundary(5)` returns false, but `next_boundary` driven across the chunks reports 5.
+/// KNOWN FAILURE: unicode-segmentation/1 in the zoo's bugs.toml. Added by the zoo (2026-09-12).
+#[test]
+fn known_failure_gb12_chunk_split_double_counts_regional_indicators() {
+    use unicode_segmentation::{GraphemeCursor, GraphemeIncomplete, UnicodeSegmentation};
+    let s = "0\u{1f1e6}\u{1f1e6}";
+    let chunks = [(0usize, &s[..5]), (5usize, &s[5..])];
+    let expected: Vec<usize> = s.grapheme_indices(true).map(|(i, _)| i).skip(1).chain([s.len()]).collect();
+    let mut cursor = GraphemeCursor::new(0, s.len(), true);
+    let mut found = Vec::new();
+    let mut idx = 0;
+    for _ in 0..64 {
+        let (start, chunk) = chunks[idx];
+        match cursor.next_boundary(chunk, start) {
+            Ok(Some(b)) => found.push(b),
+            Ok(None) => break,
+            Err(GraphemeIncomplete::NextChunk) => idx += 1,
+            Err(GraphemeIncomplete::PreContext(off)) => {
+                let (pstart, pchunk) = chunks.iter().rev().find(|(cs, _)| *cs < off).copied().unwrap();
+                cursor.provide_context(pchunk, pstart);
+            }
+            Err(e) => panic!("unexpected {e:?}"),
+        }
     }
+    assert_eq!(found, expected, "next_boundary across the chunk split must not break inside the flag");
 }
