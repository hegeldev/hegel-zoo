+/// Check that `(offset, segment)` pairs tile `s` from start to end: offsets
+/// are consecutive (hence strictly monotonic), every segment is non-empty and
+/// is exactly the slice of `s` at its reported offset.
+fn check_indices_tile(s: &str, segments: &[(usize, &str)]) {
+    let mut pos = 0;
+    for &(offset, segment) in segments {
+        assert_eq!(offset, pos, "offsets must be consecutive in {s:?}");
+        assert!(
+            !segment.is_empty(),
+            "empty segment at {} in {:?}",
+            offset,
+            s
+        );
+        assert_eq!(
+            s.get(offset..offset + segment.len()),
+            Some(segment),
+            "segment does not match slice at {offset} in {s:?}"
+        );
+        pos += segment.len();
     }
+    assert_eq!(pos, s.len(), "segments must cover all of {s:?}");
+}
