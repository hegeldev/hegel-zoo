+/// Split `s` into chunks at a drawn subset of its char boundaries.
+fn draw_chunks<'a>(tc: &hegel::TestCase, s: &'a str) -> Vec<(usize, &'a str)> {
+    if s.is_empty() {
+        return vec![(0, "")];
     }
+    let candidates: Vec<usize> = s.char_indices().map(|(i, _)| i).filter(|&i| i > 0).collect();
+    let mut splits: Vec<usize> = if candidates.is_empty() {
+        Vec::new()
+    } else {
+        tc.draw(
+            generators::vecs(generators::integers::<usize>().max_value(candidates.len() - 1))
+                .unique(true),
+        )
+        .into_iter()
+        .map(|i| candidates[i])
+        .collect()
+    };
+    splits.sort_unstable();
+    splits.push(s.len());
+    let mut chunks = Vec::new();
+    let mut prev = 0;
+    for split in splits {
+        chunks.push((prev, &s[prev..split]));
+        prev = split;
+    }
+    chunks
+}
 
