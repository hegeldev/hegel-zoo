+    // GB3/GB4/GB5 and the classic Unicode line-break zoo
+    "\r", "\n", "\r\n", "\u{b}", "\u{85}", "\u{2028}", "\u{2029}",
+    // GB9/GB11: ZWJ, Extended_Pictographic, variation selector, skin tone
+    "\u{200d}", "\u{1f468}", "\u{1f467}", "\u{1f466}", "\u{2764}", "\u{fe0f}", "\u{1f3fe}",
