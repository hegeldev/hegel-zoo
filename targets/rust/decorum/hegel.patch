+// ----------------------------------------------------------------------------------------------
+// constraints and divergences
+
+#[hegel::test]
+fn constraints_admit_exactly_their_subsets(tc: hegel::TestCase) {
+    let x = tc.draw(arb_f64());
+    let real = x.is_finite();
+    let extended = !x.is_nan();
+    // `Total` admits everything and preserves the bits
+    let t = Total::<f64>::new(x);
+    assert!(same_bits(t.into_inner(), x));
+    assert!(same_bits(Total::<f64>::try_new(x).unwrap().into_inner(), x));
+    assert!(same_bits(Total::<f64>::assert(x).into_inner(), x));
+    assert!(same_bits(f64::from(Total::from(x)), x));
+    assert!(same_bits(*Total::from(x).as_ref(), x));
+    // `IsExtendedReal` rejects NaN, `IsReal` rejects NaN and infinities
+    assert_eq!(E64::<OrPanic>::try_new(x).is_ok(), extended, "{x:?}");
+    assert_eq!(R64::<OrPanic>::try_new(x).is_ok(), real, "{x:?}");
+    assert_eq!(NotNanResult::new(x).is_ok(), extended);
+    assert_eq!(RealResult::new(x).is_ok(), real);
+    assert_eq!(RealOption::new(x).is_some(), real);
+    assert_eq!(RealExpr::new(x).is_defined(), real);
+    assert_eq!(RealExpr::new(x).is_undefined(), !real);
+    assert_eq!(NotNanExpr::new(x).is_defined(), extended);
+    assert_eq!(R64::<OrPanic>::try_from(x).is_ok(), real);
+    assert_eq!(E64::<OrPanic>::try_from(x).is_ok(), extended);
+    // `assert` and `OrPanic::new` panic exactly on violations
+    assert_eq!(panics(|| R64::<OrPanic>::assert(x)), !real, "{x:?}");
+    assert_eq!(panics(|| R64::<OrPanic>::new(x)), !real, "{x:?}");
+    assert_eq!(panics(|| E64::<OrPanic>::new(x)), !extended, "{x:?}");
+    assert_eq!(panics(|| RealResult::assert(x)), !real, "assert ignores the divergence");
+    // the accepted value is the given one
+    if real {
+        let r = R64::<OrPanic>::new(x);
+        assert!(same_bits(r.into_inner(), x));
+        assert!(same_bits(RealResult::new(x).unwrap().into_inner(), x));
+        assert!(same_bits(RealExpr::new(x).unwrap().into_inner(), x));
+        // subset / superset conversions keep the value
+        let e: E64 = r.into_superset();
+        assert!(same_bits(e.into_inner(), x));
+        assert!(same_bits(E64::from_subset(r).into_inner(), x));
+        let t: Total<f64> = r.into_superset();
+        assert!(same_bits(t.into_inner(), x));
+        assert!(same_bits(Total::from(r).into_inner(), x));
+        assert!(same_bits(E64::from(r).into_inner(), x));
+        assert!(same_bits(r.into_expression().unwrap().into_inner(), x));
+    }
+    if extended {
+        let e = E64::<OrPanic>::new(x);
+        assert!(same_bits(Total::from(e).into_inner(), x));
+        assert!(same_bits(Total::<f64>::from_subset(e).into_inner(), x));
+    }
+    // comparisons with primitives: a non-member is never equal or ordered
+    let r1 = R64::<OrPanic>::ONE;
+    assert_eq!(r1 == x, real && x == 1.0, "{x:?}");
+    assert_eq!(r1.partial_cmp(&x), if real { Some(model_cmp(1.0, x)) } else { None }, "{x:?}");
+    let t1 = Total::<f64>::ONE;
+    assert_eq!(t1 == x, x == 1.0);
+    assert_eq!(t1.partial_cmp(&x), Some(model_cmp(1.0, x)));
+    // slices are converted as a whole
+    let ys: Vec<f64> = tc.draw(generators::vecs(arb_f64()).max_size(6));
+    let all_real = ys.iter().all(|y| y.is_finite());
+    let all_extended = ys.iter().all(|y| !y.is_nan());
+    assert_eq!(R64::<OrPanic>::try_from_slice(&ys).is_ok(), all_real, "{ys:?}");
+    assert_eq!(E64::<OrPanic>::try_from_slice(&ys).is_ok(), all_extended, "{ys:?}");
+    if let Ok(rs) = R64::<OrPanic>::try_from_slice(&ys) {
+        assert!(rs.iter().zip(&ys).all(|(r, y)| same_bits(r.into_inner(), *y)));
+    }
+    let mut zs = ys.clone();
+    let ts = Total::from_mut_slice(&mut zs);
+    for t in ts.iter_mut() {
+        *t = -*t;
+    }
+    assert!(zs.iter().zip(&ys).all(|(z, y)| same_bits(*z, -*y)), "{ys:?}");
+}
+
+#[hegel::test]
+fn proxies_print_and_parse_like_primitives(tc: hegel::TestCase) {
+    let x = tc.draw(arb_f64());
+    let t = Total::from(x);
+    assert_eq!(t.to_string(), x.to_string());
+    assert_eq!(format!("{t:e}"), format!("{x:e}"));
+    assert_eq!(format!("{t:E}"), format!("{x:E}"));
+    assert_eq!(format!("{t:.3}"), format!("{x:.3}"));
+    let parsed: Total<f64> = x.to_string().parse().unwrap();
+    assert_eq!(parsed, t, "{x}");
+    if !x.is_nan() {
+        assert!(same_bits(parsed.into_inner(), x) || x == 0.0, "{x}");
+    }
+    assert!("nonsense".parse::<Total<f64>>().is_err());
+    if x.is_finite() {
+        let r: R64 = x.to_string().parse().unwrap();
+        assert_eq!(r.into_inner(), x);
+        assert_eq!(format!("{r:?}"), format!("Real({x:?})"), "{x:?}");
+    } else {
+        assert!(panics(|| x.to_string().parse::<R64>()), "{x}: parsing a non-real into `R64<OrPanic>` panics");
+    }
+    assert_eq!(format!("{t:?}"), format!("Total({x:?})"));
+    // `Default` is zero
+    assert!(Total::<f64>::default().into_inner() == 0.0 && R64::<OrPanic>::default().into_inner() == 0.0);
+}
