+/// decorum/3: functions whose result type is `Self` (`sin`, `cos`, `sin_cos`, `fract`, `sinh`,
+/// `cosh`, …) are applied without re-checking the constraint, so a `NotNan` infinity yields a
+/// proxy holding NaN and a `Real` near 710 yields a proxy holding an infinity.
+#[hegel::test]
+fn self_typed_functions_keep_the_constraint(tc: hegel::TestCase) {
+    let inf = if tc.draw(generators::booleans()) { f64::INFINITY } else { f64::NEG_INFINITY };
+    let e = E64::<OrPanic>::assert(inf);
+    for (name, value) in [("sin", e.sin()), ("cos", e.cos()), ("fract", e.fract()), ("sin_cos.0", e.sin_cos().0)] {
+        assert!(!value.into_inner().is_nan(), "E64({inf}).{name}() = {value:?} is NaN inside a `NotNan` proxy");
+    }
+    let x = tc.draw(int!(711i64, 100_000)) as f64 * if tc.draw(generators::booleans()) { 1.0 } else { -1.0 };
+    let r = R64::<OrPanic>::assert(x);
+    assert!(r.sinh().into_inner().is_finite(), "R64({x}).sinh() = {:?} inside a `Real` proxy", r.sinh());
+    assert!(r.cosh().into_inner().is_finite(), "R64({x}).cosh() = {:?} inside a `Real` proxy", r.cosh());
+    // the fallible variant must refuse rather than hold an infinity
+    let rr = RealResult::assert(x);
+    assert!(rr.sinh().into_inner().is_finite(), "RealResult({x}).sinh() = {:?}", rr.sinh());
+}
