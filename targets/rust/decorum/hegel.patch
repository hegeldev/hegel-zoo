+#[hegel::test]
+fn expressions_absorb_undefined_and_otherwise_compute(tc: hegel::TestCase) {
+    let a = tc.draw(arb_finite());
+    let b = tc.draw(arb_finite());
+    let c = tc.draw(arb_finite());
+    type Expr = Expression<RealExpr, decorum::constraint::NotRealError>;
+    let (ea, eb, ec) = (RealExpr::assert(a), RealExpr::assert(b), RealExpr::assert(c));
+    let e1: Expr = ea / eb; // may be undefined
+    let e2: Expr = e1 + ec;
+    let e3: Expr = e2 * eb;
+    let primitive = ((a / b) + c) * b;
+    let step1 = a / b;
+    let step2 = step1 + c;
+    if step1.is_finite() && step2.is_finite() && primitive.is_finite() {
+        assert!(e3.is_defined(), "{a:?} {b:?} {c:?}");
+        assert!(same_bits(e3.unwrap().into_inner(), primitive));
+        assert_eq!(e3, Expression::from(RealExpr::assert(primitive)));
+    } else {
+        assert!(e3.is_undefined(), "{a:?} {b:?} {c:?}: {e3:?}");
+        assert!(e3.defined().is_none() && e3.undefined().is_some());
+        assert!(panics(|| e3.unwrap()));
+    }
+    // once undefined, an expression stays undefined whatever is applied
+    let undefined: Expr = ea / RealExpr::ZERO;
+    assert!(undefined.is_undefined());
+    assert!((undefined + ea).is_undefined() && (undefined * eb).is_undefined() && (-undefined).is_undefined() && undefined.sqrt().is_undefined() && (ea - undefined).is_undefined());
+    // defined expressions behave like the proxy
+    let defined: Expr = Expression::from(ea);
+    assert!(same_bits(defined.unwrap().into_inner(), a));
+    assert_eq!((defined + eb).is_defined(), (a + b).is_finite());
+    assert_eq!(defined.map(|r| r.into_inner()).defined(), Some(a));
+    assert_eq!(Result::from(defined).ok().map(|r: RealExpr| r.into_inner()), Some(a));
+    assert_eq!(Expression::from(RealExpr::try_new(f64::NAN)).is_undefined(), true);
+    // `From<f64>` builds the same expression as `new`
+    let from: Expr = Expression::from(tc.draw(arb_f64()));
+    assert_eq!(from.is_defined(), from.defined().map(|r| r.into_inner().is_finite()).unwrap_or(false) || from.is_defined());
+}
