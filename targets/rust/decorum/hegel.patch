+// approximate equality (the `approx` integration) forwards to the primitives
+
+#[hegel::test]
+fn approx_comparisons_forward_to_the_primitives(tc: hegel::TestCase) {
+    use approx::{AbsDiffEq, RelativeEq, UlpsEq};
+    let a = tc.draw(arb_f64());
+    let b = tc.draw(arb_f64());
+    let (ta, tb) = (Total::from(a), Total::from(b));
+    let eps = tc.draw(generators::sampled_from(vec![0.0, 1e-12, 1e-6, 0.5, 100.0]));
+    let teps = Total::from(eps);
+    assert_eq!(ta.abs_diff_eq(&tb, teps), a.abs_diff_eq(&b, eps), "{a:?} {b:?} {eps}");
+    assert_eq!(ta.relative_eq(&tb, teps, teps), a.relative_eq(&b, eps, eps), "{a:?} {b:?} {eps}");
+    let ulps = tc.draw(int!(0u32, 8));
+    assert_eq!(ta.ulps_eq(&tb, teps, ulps), a.ulps_eq(&b, eps, ulps), "{a:?} {b:?} {eps} {ulps}");
+    assert_eq!(Total::<f64>::default_epsilon().into_inner(), f64::default_epsilon());
+}
