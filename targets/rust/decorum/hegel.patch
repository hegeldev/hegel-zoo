+/// decorum/2: `to_canonical` shifts the mantissa of an `f64` subnormal left by one bit (via
+/// `integer_decode`) and then masks it to 52 bits, so subnormals whose mantissa has bit 51 set
+/// share their canonical form with the subnormal without it: `Total` calls two different values
+/// equal (and hashes them alike) while `Ord` orders them.
+#[hegel::test]
+fn distinct_subnormals_are_not_equivalent(tc: hegel::TestCase) {
+    let m = tc.draw(int!(1u64, (1u64 << 51) - 1));
+    let s = if tc.draw(generators::booleans()) { 1u64 << 63 } else { 0 };
+    let small = f64::from_bits(m | s);
+    let large = f64::from_bits(m | (1u64 << 51) | s);
+    assert_ne!(small, large);
+    assert!(!small.eq_canonical(&large), "{small:e} vs {large:e} ({:#x} vs {:#x})", small.to_bits(), large.to_bits());
+    assert_ne!(small.to_canonical(), large.to_canonical());
+    assert_ne!(Total::from(small), Total::from(large));
+    assert_eq!(Total::from(small).cmp(&Total::from(large)), model_cmp(small, large));
+    assert_eq!(Total::from(small) == Total::from(large), Total::from(small).cmp(&Total::from(large)) == Ordering::Equal, "Eq and Ord agree");
+}
