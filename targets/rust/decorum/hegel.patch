+//! Hegel property tests for `decorum`: the canonical total ordering / equivalence / hashing of
+//! IEEE 754 values, the `Total`, `NotNan` (`E64`) and `Real` (`R64`) proxies with their
+//! constraints and divergences, `Expression`s, and the real-function traits, all checked against
+//! the primitive `f64`/`f32` operations and a small model of the documented relations:
+//!
+//! −∞ < … < 0 < … < ∞ < NaN, with −0 = +0 and every NaN equal to every other NaN.
+
+#![allow(clippy::float_cmp)]
+
+use std::cmp::Ordering;
+use std::collections::HashSet;
+use std::hash::{Hash, Hasher};
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+use decorum::cmp::{self, CanonicalEq, CanonicalOrd, EmptyOrd};
+use decorum::constraint::{IsExtendedReal, IsReal};
+use decorum::divergence::{AsExpression, AsOption, AsResult, OrError, OrPanic};
+use decorum::expression::Expression;
+use decorum::hash::CanonicalHash;
+use decorum::proxy::Constrained;
+use decorum::real::{BinaryRealFunction, Sign, UnaryRealFunction};
+use decorum::{InfinityEncoding, NanEncoding, ToCanonical, Total, E64, R64};
+use hegel::generators;
+use num_traits::{FromPrimitive, One, ToPrimitive, Zero};
+
+type RealResult = Constrained<f64, IsReal<OrError<AsResult>>>;
+type RealOption = Constrained<f64, IsReal<OrError<AsOption>>>;
+type RealExpr = Constrained<f64, IsReal<OrError<AsExpression>>>;
+type NotNanResult = Constrained<f64, IsExtendedReal<OrError<AsResult>>>;
+type NotNanExpr = Constrained<f64, IsExtendedReal<OrError<AsExpression>>>;
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+/// Any `f64` bit pattern, biased towards the interesting classes.
+#[hegel::composite]
+fn arb_f64(tc: &hegel::TestCase) -> f64 {
+    match tc.draw(int!(0u8, 7)) {
+        0 => f64::from_bits(tc.draw(generators::integers::<u64>())),
+        1 => tc.draw(int!(-1000i64, 1000)) as f64 / [1.0, 2.0, 4.0, 10.0][tc.draw(int!(0usize, 3))],
+        2 => tc.draw(generators::sampled_from(vec![
+            0.0,
+            -0.0,
+            f64::INFINITY,
+            f64::NEG_INFINITY,
+            f64::NAN,
+            -f64::NAN,
+            f64::MAX,
+            f64::MIN,
+            f64::MIN_POSITIVE,
+            -f64::MIN_POSITIVE,
+            f64::EPSILON,
+            1.0,
+            -1.0,
+            0.5,
+            710.0,
+            -710.0,
+            f64::from_bits(1),
+            f64::from_bits(0x0008_0000_0000_0000),
+        ])),
+        // subnormals, either sign
+        3 => {
+            let m = tc.draw(int!(1u64, (1u64 << 52) - 1));
+            let s = if tc.draw(generators::booleans()) { 1u64 << 63 } else { 0 };
+            f64::from_bits(m | s)
+        }
+        // NaNs with any payload, either sign, quiet or signalling
+        4 => {
+            let payload = tc.draw(int!(1u64, (1u64 << 52) - 1));
+            let s = if tc.draw(generators::booleans()) { 1u64 << 63 } else { 0 };
+            f64::from_bits(0x7ff0_0000_0000_0000 | payload | s)
+        }
+        5 => {
+            let x = tc.draw(generators::floats::<f64>());
+            if tc.draw(generators::booleans()) { x } else { -x }
+        }
+        6 => 2f64.powi(tc.draw(int!(-1074i32, 1023))) * if tc.draw(generators::booleans()) { 1.0 } else { -1.0 },
+        _ => tc.draw(generators::floats::<f64>()).fract() + tc.draw(int!(-3i64, 3)) as f64,
+    }
+}
+
+#[hegel::composite]
+fn arb_f32(tc: &hegel::TestCase) -> f32 {
+    match tc.draw(int!(0u8, 3)) {
+        0 => f32::from_bits(tc.draw(generators::integers::<u32>())),
+        1 => tc.draw(arb_f64()) as f32,
+        2 => {
+            let m = tc.draw(int!(1u32, (1u32 << 23) - 1));
+            let s = if tc.draw(generators::booleans()) { 1u32 << 31 } else { 0 };
+            f32::from_bits(m | s)
+        }
+        _ => tc.draw(generators::sampled_from(vec![0.0f32, -0.0, f32::INFINITY, f32::NEG_INFINITY, f32::NAN, f32::MAX, f32::MIN_POSITIVE, 1.0, -1.0])),
+    }
+}
+
+/// A finite `f64` (a member of `IsReal`).
+#[hegel::composite]
+fn arb_finite(tc: &hegel::TestCase) -> f64 {
+    loop {
+        let x = tc.draw(arb_f64());
+        if x.is_finite() {
+            return x;
+        }
+        // the generator above yields a finite value with high probability; retry on the rest
+        if tc.draw(generators::booleans()) {
+            return tc.draw(int!(-1_000_000i64, 1_000_000)) as f64 / 8.0;
+        }
+    }
+}
+
+// ----------------------------------------------------------------------------------------------
+// the model
+
+/// The documented total order: −∞ < … < 0 < … < ∞ < NaN, all zeros equal, all NaNs equal.
+fn model_cmp(a: f64, b: f64) -> Ordering {
+    match (a.is_nan(), b.is_nan()) {
+        (true, true) => Ordering::Equal,
+        (true, false) => Ordering::Greater,
+        (false, true) => Ordering::Less,
+        (false, false) => a.partial_cmp(&b).unwrap(),
+    }
+}
+
+fn model_cmp32(a: f32, b: f32) -> Ordering {
+    model_cmp(a as f64, b as f64)
+}
+
+fn hash_of<T: Hash>(x: &T) -> u64 {
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    x.hash(&mut h);
+    h.finish()
+}
+
+fn canonical_hash_of<T: CanonicalHash + ?Sized>(x: &T) -> u64 {
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    x.hash_canonical(&mut h);
+    h.finish()
+}
+
+fn same_bits(a: f64, b: f64) -> bool {
+    a.to_bits() == b.to_bits()
+}
+
+fn panics<F: FnOnce() -> R, R>(f: F) -> bool {
+    let prev = std::panic::take_hook();
+    std::panic::set_hook(Box::new(|_| {}));
+    let r = catch_unwind(AssertUnwindSafe(f)).is_err();
+    std::panic::set_hook(prev);
+    r
+}
+
+// ----------------------------------------------------------------------------------------------
+// canonical ordering, equivalence and hashing
+
+#[hegel::test]
+fn canonical_relations_follow_the_documented_total_order(tc: hegel::TestCase) {
+    let a = tc.draw(arb_f64());
+    let b = tc.draw(arb_f64());
+    let c = tc.draw(arb_f64());
+    let expected = model_cmp(a, b);
+    assert_eq!(a.cmp_canonical(&b), expected, "{a:?} vs {b:?}");
+    assert_eq!(b.cmp_canonical(&a), expected.reverse());
+    assert_eq!(a.eq_canonical(&b), expected == Ordering::Equal, "{a:?} vs {b:?}");
+    assert!(a.eq_canonical(&a));
+    assert_eq!(a.cmp_canonical(&a), Ordering::Equal);
+    // canonical forms are equal exactly when the values are equivalent
+    assert_eq!(a.to_canonical() == b.to_canonical(), expected == Ordering::Equal, "{a:?} ({:#x}) vs {b:?} ({:#x})", a.to_bits(), b.to_bits());
+    if expected == Ordering::Equal {
+        assert_eq!(canonical_hash_of(&a), canonical_hash_of(&b), "{a:?} vs {b:?}");
+    }
+    // transitivity
+    let ab = a.cmp_canonical(&b);
+    let bc = b.cmp_canonical(&c);
+    if ab != Ordering::Greater && bc != Ordering::Greater {
+        assert_ne!(a.cmp_canonical(&c), Ordering::Greater, "{a:?} ≤ {b:?} ≤ {c:?}");
+    }
+    // the proxy uses the same relations
+    let (ta, tb) = (Total::from(a), Total::from(b));
+    assert_eq!(ta.cmp(&tb), expected);
+    assert_eq!(ta.partial_cmp(&tb), Some(expected));
+    assert_eq!(ta == tb, expected == Ordering::Equal, "{ta:?} vs {tb:?}");
+    assert_eq!(ta.max(tb).into_inner().to_bits(), if expected == Ordering::Greater { a } else { b }.to_bits(), "Ord::max keeps the second on ties");
+    if expected == Ordering::Equal {
+        assert_eq!(hash_of(&ta), hash_of(&tb), "{a:?} vs {b:?} hash");
+    }
+    assert_eq!(hash_of(&ta), canonical_hash_of(&a));
+    // slices: lexicographic, then by length
+    let xs = [a, b];
+    let ys = [b, a];
+    assert_eq!(xs.cmp_canonical(&ys), expected.then(expected.reverse()));
+    assert_eq!(xs.eq_canonical(&ys), expected == Ordering::Equal);
+    assert_eq!(xs[..1].cmp_canonical(&xs[..]), Ordering::Less);
+    assert!(xs[..].eq_canonical(&[a, b][..]));
+    assert!(!xs[..1].eq_canonical(&xs[..]));
+    assert_eq!(canonical_hash_of(&xs[..]), canonical_hash_of(&[a, b][..]));
+    let total = Total::from_slice(&xs);
+    assert_eq!(total, &[ta, tb][..]);
+    assert_eq!(total.iter().map(|t| t.into_inner().to_bits()).collect::<Vec<_>>(), vec![a.to_bits(), b.to_bits()]);
+}
+
+#[hegel::test]
+fn canonical_relations_follow_the_documented_total_order_f32(tc: hegel::TestCase) {
+    let a = tc.draw(arb_f32());
+    let b = tc.draw(arb_f32());
+    let expected = model_cmp32(a, b);
+    assert_eq!(a.cmp_canonical(&b), expected, "{a:?} vs {b:?}");
+    assert_eq!(a.eq_canonical(&b), expected == Ordering::Equal, "{a:?} vs {b:?}");
+    assert_eq!(a.to_canonical() == b.to_canonical(), expected == Ordering::Equal, "{a:?} ({:#x}) vs {b:?} ({:#x})", a.to_bits(), b.to_bits());
+    let (ta, tb) = (Total::from(a), Total::from(b));
+    assert_eq!(ta.cmp(&tb), expected);
+    assert_eq!(ta == tb, expected == Ordering::Equal);
+    if expected == Ordering::Equal {
+        assert_eq!(hash_of(&ta), hash_of(&tb));
+    }
+}
