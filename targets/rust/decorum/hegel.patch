+#[hegel::test]
+fn sorting_and_hashing_totals_matches_the_model(tc: hegel::TestCase) {
+    let xs: Vec<f64> = tc.draw(generators::vecs(arb_f64()).max_size(24));
+    let mut totals: Vec<Total<f64>> = xs.iter().copied().map(Total::from).collect();
+    totals.sort();
+    for w in totals.windows(2) {
+        assert_ne!(model_cmp(w[0].into_inner(), w[1].into_inner()), Ordering::Greater, "{totals:?}");
+    }
+    let mut model = xs.clone();
+    model.sort_by(|a, b| model_cmp(*a, *b));
+    assert!(totals.iter().zip(&model).all(|(t, m)| model_cmp(t.into_inner(), *m) == Ordering::Equal), "{totals:?} vs {model:?}");
+    // a set holds one element per equivalence class
+    let set: HashSet<Total<f64>> = totals.iter().copied().collect();
+    let mut classes = model.clone();
+    classes.dedup_by(|a, b| model_cmp(*a, *b) == Ordering::Equal);
+    assert_eq!(set.len(), classes.len(), "{xs:?}");
+    // NaNs sort last and zeros of both signs are adjacent equals
+    let nans = xs.iter().filter(|x| x.is_nan()).count();
+    assert!(totals[totals.len() - nans..].iter().all(|t| t.into_inner().is_nan()));
+    // min/max through `Ord` agree with the model
+    if let (Some(lo), Some(hi)) = (totals.iter().min(), totals.iter().max()) {
+        assert_eq!(model_cmp(lo.into_inner(), model[0]), Ordering::Equal);
+        assert_eq!(model_cmp(hi.into_inner(), model[model.len() - 1]), Ordering::Equal);
+    }
+}
+
+#[hegel::test]
+fn empty_ordering_forwards_nans(tc: hegel::TestCase) {
+    let a = tc.draw(arb_f64());
+    let b = tc.draw(arb_f64());
+    let either_nan = a.is_nan() || b.is_nan();
+    assert_eq!(a.is_empty(), a.is_nan());
+    match a.cmp_empty(&b) {
+        Ok(ordering) => {
+            assert!(!either_nan, "{a:?} vs {b:?}");
+            assert_eq!(Some(ordering), a.partial_cmp(&b));
+        }
+        Err(empty) => {
+            assert!(either_nan, "{a:?} vs {b:?}");
+            assert!(empty.is_nan());
+        }
+    }
+    let min = cmp::min_or_empty(a, b);
+    let max = cmp::max_or_empty(a, b);
+    let (lo, hi) = cmp::min_max_or_empty(a, b);
+    if either_nan {
+        assert!(min.is_nan() && max.is_nan() && lo.is_nan() && hi.is_nan(), "{a:?} vs {b:?}");
+    } else {
+        assert_eq!(min, a.min(b));
+        assert_eq!(max, a.max(b));
+        assert_eq!((lo, hi), (a.min(b), a.max(b)));
+        // on ties the first argument is the minimum and the second the maximum
+        if a == b {
+            assert!(same_bits(min, a) && same_bits(max, b) && same_bits(lo, a) && same_bits(hi, b), "{a:?} vs {b:?}");
+        }
+    }
+    // the same through `Total`
+    let (ta, tb) = (Total::from(a), Total::from(b));
+    assert_eq!(ta.is_empty(), a.is_nan());
+    let tmin = cmp::min_or_empty(ta, tb);
+    assert_eq!(tmin.into_inner().is_nan(), either_nan);
+    if !either_nan {
+        assert_eq!(tmin.into_inner(), a.min(b));
+        assert_eq!(cmp::max_or_empty(ta, tb).into_inner(), a.max(b));
+    }
+    // `Option` and `Result`: `None`/`Err` are the empty inhabitants
+    let (oa, ob) = (Some(tc.draw(int!(-5i32, 5))), Some(tc.draw(int!(-5i32, 5))));
+    assert_eq!(cmp::min_or_empty(oa, ob), oa.min(ob));
+    assert_eq!(cmp::max_or_empty(oa, ob), oa.max(ob));
+    assert_eq!(cmp::min_or_empty(None, oa), None);
+    assert_eq!(cmp::max_or_empty(oa, None), None);
+    assert!(None::<i32>.is_empty() && !oa.is_empty());
+}
