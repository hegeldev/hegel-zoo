+#[hegel::test]
+fn constrained_arithmetic_diverges_exactly_when_the_primitive_result_leaves_the_set(tc: hegel::TestCase) {
+    let a = tc.draw(arb_finite());
+    let b = tc.draw(arb_finite());
+    let (ra, rb) = (RealResult::assert(a), RealResult::assert(b));
+    let check = |got: Result<RealResult, _>, expected: f64, what: &str| {
+        match got {
+            Ok(r) => assert!(expected.is_finite() && same_bits(r.into_inner(), expected), "{what}: {a:?} {b:?} → {r:?}, primitive {expected:?}"),
+            Err(_) => assert!(!expected.is_finite(), "{what}: {a:?} {b:?} refused but the primitive gives {expected:?}"),
+        }
+    };
+    check(ra + rb, a + b, "add");
+    check(ra - rb, a - b, "sub");
+    check(ra * rb, a * b, "mul");
+    check(ra / rb, a / b, "div");
+    check(ra % rb, a % b, "rem");
+    check(ra + b, a + b, "add primitive");
+    check(ra / b, a / b, "div primitive");
+    check(ra.recip(), a.recip(), "recip");
+    check(ra.sqrt(), a.sqrt(), "sqrt");
+    check(ra.ln(), a.ln(), "ln");
+    check(ra.log2(), a.log2(), "log2");
+    check(ra.exp(), a.exp(), "exp");
+    check(ra.exp2(), a.exp2(), "exp2");
+    let n = tc.draw(int!(-4i32, 4));
+    check(ra.powi(n), a.powi(n), "powi");
+    check(ra.tan(), a.tan(), "tan");
+    check(ra.asin(), a.asin(), "asin");
+    check(ra.acos(), a.acos(), "acos");
+    check(ra.acosh(), a.acosh(), "acosh");
+    check(ra.atanh(), a.atanh(), "atanh");
+    check(ra.to_degrees(), a.to_degrees(), "to_degrees");
+    check(BinaryRealFunction::pow(ra, rb), a.powf(b), "pow");
+    check(BinaryRealFunction::log(ra, rb), a.log(b), "log");
+    check(BinaryRealFunction::hypot(ra, rb), a.hypot(b), "hypot");
+    check(BinaryRealFunction::div_euclid(ra, rb), a.div_euclid(b), "div_euclid");
+    check(BinaryRealFunction::rem_euclid(ra, rb), a.rem_euclid(b), "rem_euclid");
+    check(BinaryRealFunction::atan2(ra, rb), a.atan2(b), "atan2");
+    // negation and the bounded functions always stay in the set
+    assert!(same_bits((-ra).into_inner(), -a));
+    assert!(same_bits(ra.abs().into_inner(), a.abs()));
+    assert!(same_bits(ra.floor().into_inner(), a.floor()));
+    assert!(same_bits(ra.cbrt().into_inner(), a.cbrt()));
+    assert!(same_bits(ra.atan().into_inner(), a.atan()));
+    assert!(same_bits(ra.tanh().into_inner(), a.tanh()));
+    // `Option` and `Expression` divergences agree with `Result`
+    let (oa, ob) = (RealOption::assert(a), RealOption::assert(b));
+    assert_eq!((oa / ob).map(|r| r.into_inner().to_bits()), (ra / rb).ok().map(|r| r.into_inner().to_bits()));
+    assert_eq!((oa * ob).is_some(), (a * b).is_finite());
+    let (ea, eb) = (RealExpr::assert(a), RealExpr::assert(b));
+    assert_eq!((ea / eb).is_defined(), (a / b).is_finite());
+    assert_eq!((ea / eb).defined().map(|r| r.into_inner().to_bits()), (ra / rb).ok().map(|r| r.into_inner().to_bits()));
+    // `OrPanic` panics on the same violations
+    assert_eq!(panics(|| R64::<OrPanic>::assert(a) / R64::<OrPanic>::assert(b)), !(a / b).is_finite(), "{a:?} / {b:?}");
+    assert_eq!(panics(|| R64::<OrPanic>::assert(a).sqrt()), a < 0.0, "{a:?}");
+    // extended reals: only NaN is refused
+    let (na, nb) = (NotNanResult::assert(a), NotNanResult::assert(b));
+    assert_eq!((na / nb).is_ok(), !(a / b).is_nan(), "{a:?} / {b:?}");
+    assert_eq!((na * nb).is_ok(), !(a * b).is_nan());
+    assert_eq!((na - nb).is_ok(), !(a - b).is_nan());
+    assert_eq!(na.sqrt().is_ok(), !a.sqrt().is_nan());
+    assert_eq!(na.ln().is_ok(), !a.ln().is_nan());
+    assert_eq!(NotNanResult::assert(f64::INFINITY).exp().is_ok(), true);
+    assert!((NotNanResult::assert(f64::INFINITY) - NotNanResult::assert(f64::INFINITY)).is_err());
+}
