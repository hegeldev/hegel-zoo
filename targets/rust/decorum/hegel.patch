+// ----------------------------------------------------------------------------------------------
+// arithmetic
+
+#[hegel::test]
+fn total_arithmetic_is_primitive_arithmetic(tc: hegel::TestCase) {
+    let a = tc.draw(arb_f64());
+    let b = tc.draw(arb_f64());
+    let (ta, tb) = (Total::from(a), Total::from(b));
+    let same = |t: Total<f64>, p: f64| same_bits(t.into_inner(), p) || (t.into_inner().is_nan() && p.is_nan());
+    assert!(same(ta + tb, a + b), "{a:?} + {b:?}");
+    assert!(same(ta - tb, a - b));
+    assert!(same(ta * tb, a * b));
+    assert!(same(ta / tb, a / b));
+    assert!(same(ta % tb, a % b));
+    assert!(same(-ta, -a));
+    assert!(same(ta + b, a + b));
+    assert!(same(ta * b, a * b));
+    let mut acc = ta;
+    acc += tb;
+    acc *= tb;
+    acc -= b;
+    acc /= b;
+    assert!(same(acc, ((a + b) * b - b) / b), "{a:?} {b:?}");
+    assert!(same(ta.abs(), a.abs()));
+    assert!(same(ta.recip(), a.recip()));
+    assert!(same(ta.sqrt(), a.sqrt()));
+    assert!(same(ta.exp(), a.exp()));
+    assert!(same(ta.ln(), a.ln()));
+    assert!(same(ta.floor(), a.floor()) && same(ta.ceil(), a.ceil()) && same(ta.round(), a.round()) && same(ta.trunc(), a.trunc()) && same(ta.fract(), a.fract()));
+    assert!(same(ta.sin(), a.sin()) && same(ta.cos(), a.cos()) && same(ta.tan(), a.tan()));
+    assert!(same(ta.powi(3), a.powi(3)));
+    assert!(same(BinaryRealFunction::pow(ta, tb), a.powf(b)));
+    assert!(same(BinaryRealFunction::hypot(ta, tb), a.hypot(b)));
+    assert!(same(BinaryRealFunction::atan2(ta, tb), a.atan2(b)));
+    assert!(same(BinaryRealFunction::log(ta, tb), a.log(b)));
+    assert!(same(BinaryRealFunction::div_euclid(ta, tb), a.div_euclid(b)));
+    assert!(same(BinaryRealFunction::rem_euclid(ta, tb), a.rem_euclid(b)));
+    // predicates and constants
+    assert_eq!(UnaryRealFunction::is_zero(ta), a == 0.0);
+    assert_eq!(Zero::is_zero(&ta), a == 0.0);
+    assert_eq!(One::is_one(&ta), a == 1.0, "{a:?}");
+    assert_eq!(ta.sign(), if a.is_nan() || a == 0.0 { Sign::Zero } else if a > 0.0 { Sign::Positive } else { Sign::Negative });
+    assert_eq!(ta.is_nan(), a.is_nan());
+    assert_eq!(InfinityEncoding::is_infinite(ta), a.is_infinite());
+    assert_eq!(InfinityEncoding::is_finite(ta), a.is_finite());
+    assert_eq!(num_traits::Float::classify(ta), a.classify());
+    assert_eq!(num_traits::Float::integer_decode(ta), num_traits::Float::integer_decode(a));
+    assert_eq!(num_traits::Float::is_sign_negative(ta), a.is_sign_negative());
+    assert!(same(num_traits::Float::signum(ta), a.signum()));
+    assert!(same(num_traits::Float::min(ta, tb), num_traits::Float::min(a, b)), "{a:?} min {b:?}");
+    assert!(same(num_traits::Float::max(ta, tb), num_traits::Float::max(a, b)));
+    assert!(same(num_traits::Float::mul_add(ta, tb, ta), a.mul_add(b, a)));
+    assert!(same(Total::<f64>::NAN, f64::NAN) && same(Total::<f64>::INFINITY, f64::INFINITY) && same(Total::<f64>::NEG_INFINITY, f64::NEG_INFINITY));
+    assert!(same(Total::<f64>::PI, std::f64::consts::PI) && same(Total::<f64>::E, std::f64::consts::E) && same(Total::<f64>::ZERO, 0.0) && same(Total::<f64>::ONE, 1.0));
+    assert!(same(<Total<f64> as num_traits::Float>::max_value(), f64::MAX) && same(<Total<f64> as num_traits::Float>::min_positive_value(), f64::MIN_POSITIVE) && same(<Total<f64> as num_traits::Float>::epsilon(), f64::EPSILON));
+    // iterator sums and products fold left like the primitives
+    let xs: Vec<f64> = tc.draw(generators::vecs(arb_f64()).max_size(8));
+    let sum: Total<f64> = xs.iter().copied().map(Total::from).sum();
+    let product: Total<f64> = xs.iter().copied().map(Total::from).product();
+    assert!(same(sum, xs.iter().fold(0.0, |s, x| s + x)), "{xs:?}");
+    assert!(same(product, xs.iter().fold(1.0, |p, x| p * x)), "{xs:?}");
+    // numeric casts
+    assert_eq!(ta.to_i64(), a.to_i64());
+    assert_eq!(ta.to_u8(), a.to_u8());
+    assert_eq!(ta.to_f32().map(|f| f.to_bits()), a.to_f32().map(|f| f.to_bits()));
+    let n = tc.draw(generators::integers::<i64>());
+    assert_eq!(Total::<f64>::from_i64(n).map(|t| t.into_inner()), f64::from_i64(n));
+    assert_eq!(<Total<f64> as num_traits::NumCast>::from(n).map(|t| t.into_inner()), f64::from_i64(n));
+}
