diff --git a/tests/core/matrix.rs b/tests/core/matrix.rs
index 06ef6b1c..b3d8cd22 100644
--- a/tests/core/matrix.rs
+++ b/tests/core/matrix.rs
@@ -1365,3 +1365,56 @@ fn abs_diff_eq_nonmatching_shapes() {
 
     a.abs_diff_eq(&b, 1e-6);
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// These supplement the proptest transposition tests above (which use fixed
+// 2x3 / 3x3 shapes) with drawn dimensions (1..=6). Entry magnitudes are
+// bounded to [-100, 100] by the shared helpers in `crate::utils`.
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use crate::utils::{draw_dim, draw_dmatrix, fro_norm_upper};
+
+    const EPS: f64 = f64::EPSILON;
+
+    // (A^T)^T == A, exactly: transposition only moves entries, so no
+    // tolerance is involved.
+    #[hegel::test]
+    fn transpose_involution_dyn(tc: hegel::TestCase) {
+        let rows = draw_dim(&tc);
+        let cols = draw_dim(&tc);
+        let a = draw_dmatrix(&tc, rows, cols);
+        assert_eq!(a.transpose().transpose(), a);
+    }
+
+    // (A * B)^T ≈ B^T * A^T.
+    //
+    // Mathematically exact; in floating point each side evaluates the same
+    // set of length-k dot products, but possibly accumulated in different
+    // orders (and, for larger dynamic matrices, through different gemm
+    // kernels). Reassociating a length-k sum perturbs it by at most
+    // (k-1) * eps * sum_j |a_ij b_jk| <= k * eps * ||A||_F * ||B||_F per
+    // entry, and the Frobenius norm over <= 6x6 entries adds a factor
+    // sqrt(rows*cols) <= 6; both are absorbed into c = 64:
+    // tol = 64 * k * eps * ||A|| * ||B||, floored at f64::MIN_POSITIVE.
+    #[hegel::test]
+    fn product_transpose_is_reversed_transpose_product(tc: hegel::TestCase) {
+        let rows = draw_dim(&tc);
+        let inner = draw_dim(&tc);
+        let cols = draw_dim(&tc);
+        let a = draw_dmatrix(&tc, rows, inner);
+        let b = draw_dmatrix(&tc, inner, cols);
+
+        let lhs = (&a * &b).transpose();
+        let rhs = b.transpose() * a.transpose();
+
+        let tol =
+            (64.0 * inner as f64 * EPS * fro_norm_upper(&a) * fro_norm_upper(&b)).max(f64::MIN_POSITIVE);
+        let resid = (&lhs - &rhs).norm();
+        assert!(
+            resid <= tol,
+            "||(AB)^T - B^T A^T|| = {resid:e} > tol = {tol:e} for A = {a}, B = {b}"
+        );
+    }
+}
diff --git a/tests/lib.rs b/tests/lib.rs
index 3816013b..63522fd4 100644
--- a/tests/lib.rs
+++ b/tests/lib.rs
@@ -40,4 +40,78 @@ mod utils {
     pub fn is_sorted_descending<T: PartialOrd>(slice: &[T]) -> bool {
         slice.windows(2).all(|elts| elts[0] >= elts[1])
     }
+
+    // ------------------------------------------------------------------
+    // Helpers for the hegel property-based tests.
+    //
+    // Dimensions are drawn from 1..=6 and entries from [-100, 100]. The
+    // moderate entry range keeps the matrices well-scaled (||A||_F <= 600
+    // for the largest draws) so the conditioning-based tolerance arguments
+    // used in the individual tests (of the form c * n * eps * ||A||) remain
+    // meaningful; huge or subnormal entries would make norm-scaled
+    // tolerances either overflow or underflow. This bound protects the
+    // tests' error analysis, not any contract of nalgebra.
+    // ------------------------------------------------------------------
+
+    /// Draws a matrix dimension in `1..=6`.
+    pub fn draw_dim(tc: &hegel::TestCase) -> usize {
+        tc.draw(hegel::generators::integers::<usize>().min_value(1).max_value(6))
+    }
+
+    /// Draws an `nrows x ncols` dynamically-sized `f64` matrix with entries
+    /// in `[-100, 100]` (column-major fill; the layout does not matter for
+    /// any of the properties tested).
+    pub fn draw_dmatrix(tc: &hegel::TestCase, nrows: usize, ncols: usize) -> na::DMatrix<f64> {
+        let data: Vec<f64> = tc.draw(
+            hegel::generators::vecs(
+                hegel::generators::floats::<f64>()
+                    .min_value(-100.0)
+                    .max_value(100.0),
+            )
+            .min_size(nrows * ncols)
+            .max_size(nrows * ncols),
+        );
+        na::DMatrix::from_vec(nrows, ncols, data)
+    }
+
+    /// Overflow/underflow-safe upper bound on the Frobenius norm:
+    /// `max|a_ij| * sqrt(nrows * ncols)`.
+    ///
+    /// Used for the norm factor in tolerance formulas instead of
+    /// `Matrix::norm()`, because `norm()` computes `sqrt(sum of squares)`
+    /// without scaling and underflows to 0 for entries below ~1e-154 — a
+    /// norm-scaled tolerance built from it collapses to its floor and
+    /// produces false failures on subnormal-scale draws. Being an *upper*
+    /// bound only loosens the tolerance, by at most sqrt(nrows * ncols)
+    /// <= 6 for the shapes drawn here. This protects the tests' own
+    /// arithmetic, not any nalgebra contract.
+    pub fn fro_norm_upper<R, C, S>(m: &na::Matrix<f64, R, C, S>) -> f64
+    where
+        R: na::Dim,
+        C: na::Dim,
+        S: na::base::storage::Storage<f64, R, C>,
+    {
+        let amax = m.iter().fold(0.0_f64, |acc, x| acc.max(x.abs()));
+        amax * ((m.nrows() * m.ncols()) as f64).sqrt()
+    }
+
+    /// Zeroes out entries with magnitude below 1e-100.
+    ///
+    /// This excludes two KNOWN BUGS pinned by deterministic failing tests,
+    /// both triggered by tiny/subnormal entries:
+    ///   * `qr_reconstruction_known_failure_tiny_negative_pivot`
+    ///     (tests/linalg/qr.rs): Householder pivot columns whose
+    ///     norm-squared underflows (entries ~< 1e-162) get an inconsistent
+    ///     sign between Q and R;
+    ///   * `lu_reconstruction_known_failure_subnormal_pivot`
+    ///     (tests/linalg/lu.rs): LU pivots with |pivot| < 1/f64::MAX
+    ///     (~5.6e-309) have their reciprocal overflow to inf, poisoning the
+    ///     factors with NaN.
+    /// The 1e-100 cutoff is decades away from both trigger zones, so
+    /// shrinking cannot walk back into them, and cancellation among the
+    /// surviving entries (all 0 or >= 1e-100 in magnitude, whose ulps are
+    /// >= ~1e-116) cannot re-enter them mid-factorization.
+    pub fn zero_tiny_entries(a: na::DMatrix<f64>) -> na::DMatrix<f64> {
+        a.map(|x| if x.abs() < 1.0e-100 { 0.0 } else { x })
+    }
 }
diff --git a/tests/linalg/cholesky.rs b/tests/linalg/cholesky.rs
index ac7100bb..b9857d25 100644
--- a/tests/linalg/cholesky.rs
+++ b/tests/linalg/cholesky.rs
@@ -216,3 +216,50 @@ fn cholesky_non_pd_complex_returns_none() {
     );
     assert!(na::Cholesky::new(m2).is_none());
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// These supplement the proptest suite above with drawn dimensions (1..=6),
+// an SPD input built by construction instead of `RandomSDP`, and an
+// explicitly conditioning-derived tolerance. Entry magnitudes are bounded
+// to [-100, 100] by the shared helpers in `crate::utils`.
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use crate::utils::{draw_dim, draw_dmatrix};
+    use na::DMatrix;
+
+    const EPS: f64 = f64::EPSILON;
+
+    // Oracle-independent reconstruction: for SPD A, the Cholesky factor
+    // satisfies L * L^T ≈ A.
+    //
+    // A = M^T M + n*I is symmetric positive definite by construction
+    // (lambda_min(A) >= n > 0), so `cholesky()` must succeed — the
+    // `expect` is part of the property, not a guard that can go vacuous.
+    //
+    // Tolerance: Cholesky on an SPD matrix is backward stable with no
+    // pivot-growth factor: ||L L^T - A|| <= c * n * eps * ||A|| (Higham
+    // ch. 10). c = 32 for headroom; floored at f64::MIN_POSITIVE (though
+    // here ||A|| >= n, so the floor is never active — kept for uniformity
+    // with the other linalg tolerance arguments).
+    #[hegel::test]
+    fn cholesky_reconstructs_spd_matrix(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        let m = draw_dmatrix(&tc, n, n);
+        let a = m.transpose() * &m + DMatrix::<f64>::identity(n, n) * (n as f64);
+
+        let l = a
+            .clone()
+            .cholesky()
+            .expect("A = M^T M + n*I is SPD by construction")
+            .unpack();
+
+        let tol = (32.0 * n as f64 * EPS * a.norm()).max(f64::MIN_POSITIVE);
+        let resid = (&l * l.transpose() - &a).norm();
+        assert!(
+            resid <= tol,
+            "||L L^T - A|| = {resid:e} > tol = {tol:e} for A = {a}"
+        );
+    }
+}
diff --git a/tests/linalg/eigen.rs b/tests/linalg/eigen.rs
index fc8385d0..fd9ce9b8 100644
--- a/tests/linalg/eigen.rs
+++ b/tests/linalg/eigen.rs
@@ -280,3 +280,50 @@ fn eigenvalues_search_should_not_hang_issue_611() {
 //
 //     relative_eq!(eig.eigenvectors, mv, epsilon = 1.0e-5)
 // }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// Dimensions are drawn from 1..=6 and entry magnitudes bounded to
+// [-100, 100] by the shared helpers in `crate::utils`.
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use crate::utils::{draw_dim, draw_dmatrix, fro_norm_upper};
+
+    const EPS: f64 = f64::EPSILON;
+
+    // Oracle-independent eigen-equation check: for every computed eigenpair
+    // (lambda_i, v_i) of a symmetric matrix, A * v_i ≈ lambda_i * v_i.
+    //
+    // The input is symmetrized as A = (M + M^T) / 2, which is exactly
+    // symmetric in floating point (addition is commutative entrywise and
+    // scaling by 0.5 is exact).
+    //
+    // Tolerance: the symmetric QR algorithm computes eigenpairs with
+    // residual ||A v - lambda v|| <= c * n * eps * ||A|| for unit-norm v
+    // (backward stability of tridiagonalization + implicit QL/QR sweeps).
+    // The algorithm is iterative, so we budget c = 128. Floored at
+    // f64::MIN_POSITIVE against subnormal-scale draws. The tolerance is
+    // absolute in ||A|| — no kappa term, because eigen *residuals* (unlike
+    // eigenvalue *accuracy* for clustered spectra) are governed by backward
+    // stability alone.
+    #[hegel::test]
+    fn symmetric_eigen_pairs_satisfy_eigen_equation(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        let m = draw_dmatrix(&tc, n, n);
+        let a = (&m + m.transpose()) * 0.5;
+
+        let se = a.clone().symmetric_eigen();
+        let tol = (128.0 * n as f64 * EPS * fro_norm_upper(&a)).max(f64::MIN_POSITIVE);
+        for i in 0..n {
+            let v = se.eigenvectors.column(i).clone_owned();
+            let lambda = se.eigenvalues[i];
+            let resid = (&a * &v - &v * lambda).norm();
+            assert!(
+                resid <= tol,
+                "||A v - lambda v|| = {resid:e} > tol = {tol:e} \
+                 for eigenpair {i} (lambda = {lambda:e}) of A = {a}"
+            );
+        }
+    }
+}
diff --git a/tests/linalg/inverse.rs b/tests/linalg/inverse.rs
index ab641a79..be01f818 100644
--- a/tests/linalg/inverse.rs
+++ b/tests/linalg/inverse.rs
@@ -140,3 +140,93 @@ fn matrix5_try_inverse_scaled_identity() {
 
     assert_relative_eq!(a_inv, expected_inverse);
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// These supplement the example-based tests above with drawn inputs.
+// Dimensions are drawn from 1..=6 and entry magnitudes bounded to
+// [-100, 100] by the shared helpers in `crate::utils`.
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use crate::utils::{draw_dim, draw_dmatrix, fro_norm_upper, zero_tiny_entries};
+    use na::{DMatrix, Matrix4};
+
+    const EPS: f64 = f64::EPSILON;
+
+    // A * A^{-1} ≈ I whenever `try_inverse` succeeds.
+    //
+    // Tolerance: for dynamic matrices the inverse is computed via LU, i.e.
+    // column j of X = A^{-1} is a backward-stable solve of A x = e_j, so
+    // ||A X - I|| <= c * n * g * eps * ||A|| * ||X||  (g <= 2^(n-1) is the
+    // partial-pivoting growth factor). Note ||A|| * ||X|| is (an upper
+    // bound on) the measured Frobenius condition number kappa_F(A), so the
+    // tolerance self-scales with the conditioning — kappa is in the
+    // formula, not just in a comment. We do still skip kappa_F > 1e12: in
+    // that tail the modest constant c is no longer trustworthy and the
+    // check would be vacuous anyway (tolerance near 1).
+    #[hegel::test]
+    fn inverse_composes_to_identity(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        // KNOWN BUG exclusion (`zero_tiny_entries`) — dynamic-size inversion
+        // goes through LU, where subnormal pivots poison the factors with
+        // NaN; pinned in `lu_reconstruction_known_failure_subnormal_pivot`
+        // (tests/linalg/lu.rs).
+        let a = zero_tiny_entries(draw_dmatrix(&tc, n, n));
+
+        if let Some(inv) = a.clone().try_inverse() {
+            let kappa_f = fro_norm_upper(&a) * fro_norm_upper(&inv);
+            if kappa_f > 1.0e12 {
+                return; // condition threshold: identity not checkable in f64
+            }
+            let tol = (64.0 * n as f64 * (1u64 << n) as f64 * EPS * kappa_f)
+                .max(f64::MIN_POSITIVE);
+            let resid = (&a * &inv - DMatrix::<f64>::identity(n, n)).norm();
+            assert!(
+                resid <= tol,
+                "||A A^-1 - I|| = {resid:e} > tol = {tol:e} for A = {a}"
+            );
+        }
+        // `try_inverse` returning None for a randomly drawn matrix is rare
+        // (it requires an exactly zero pivot); the guarded branch fires on
+        // essentially every case — verified during test bring-up.
+    }
+
+    // Statically-sized variant: Matrix4 inversion goes through the
+    // dedicated cofactor formula in `src/linalg/inverse.rs`, a different
+    // code path from the LU-based dynamic case above.
+    //
+    // Tolerance: each adjugate entry is a 3x3 determinant of entries of A,
+    // computed with absolute error <= c' * eps * ||A||^3; dividing by the
+    // computed det gives ||dX|| <= c * eps * (||A||^3 + ||adj(A)||) / |det|
+    // = c * eps * (||A||^3 / |det| + ||X||), hence
+    // ||A X - I|| <= c * eps * (||A||^4 / |det| + ||A|| * ||X||).
+    // We use c = 64 and skip when ||A||^4 / |det| > 1e14 (the cofactor
+    // formula's own condition threshold, beyond which the tolerance is
+    // meaninglessly large).
+    #[hegel::test]
+    fn inverse_composes_to_identity_static4(tc: hegel::TestCase) {
+        let a = Matrix4::<f64>::from_fn(|_, _| {
+            tc.draw(
+                hegel::generators::floats::<f64>()
+                    .min_value(-100.0)
+                    .max_value(100.0),
+            )
+        });
+
+        if let Some(inv) = a.try_inverse() {
+            let det = a.determinant().abs();
+            let norm4 = a.norm().powi(4);
+            if det == 0.0 || norm4 / det > 1.0e14 {
+                return; // condition threshold for the cofactor formula
+            }
+            let tol = (64.0 * EPS * (norm4 / det + a.norm() * inv.norm()))
+                .max(f64::MIN_POSITIVE);
+            let resid = (a * inv - Matrix4::<f64>::identity()).norm();
+            assert!(
+                resid <= tol,
+                "||A A^-1 - I|| = {resid:e} > tol = {tol:e} for A = {a}"
+            );
+        }
+    }
+}
diff --git a/tests/linalg/lu.rs b/tests/linalg/lu.rs
index 58a661c4..abbbec4b 100644
--- a/tests/linalg/lu.rs
+++ b/tests/linalg/lu.rs
@@ -156,3 +156,198 @@ mod proptest_tests {
     gen_tests!(complex, complex_f64(), RandComplex<f64>);
     gen_tests!(f64, PROPTEST_F64, RandScalar<f64>);
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// These supplement the proptest suite above with drawn dimensions (1..=6)
+// and explicitly conditioning-derived tolerances. Entry magnitudes are
+// bounded to [-100, 100] by the shared helpers in `crate::utils` (see the
+// comment there).
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use crate::utils::{draw_dim, draw_dmatrix, fro_norm_upper, zero_tiny_entries};
+
+    const EPS: f64 = f64::EPSILON;
+
+    // Backward-error tolerance for LU with partial pivoting on an n x n
+    // matrix: the computed factors satisfy L*U = P*(A + dA) with
+    // ||dA|| <= c * n * g * eps * ||A||, where the growth factor g is
+    // bounded by 2^(n-1) for partial pivoting (Higham ch. 9). With n <= 6
+    // we budget g = 2^n and c = 32 for headroom. Floored at
+    // f64::MIN_POSITIVE so subnormal-scale inputs don't underflow the
+    // tolerance to exactly zero.
+    fn lu_backward_tol(n: usize, scale: f64) -> f64 {
+        (32.0 * n as f64 * (1u64 << n) as f64 * EPS * scale).max(f64::MIN_POSITIVE)
+    }
+
+    // Oracle-independent reconstruction: P * A = L * U, checked as
+    // A = P^{-1} * (L * U) exactly like `lu_simple` above.
+    #[hegel::test]
+    fn lu_reconstructs_permuted_matrix(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        // KNOWN BUG exclusion (`zero_tiny_entries`) — subnormal pivots
+        // poison the factors with NaN; pinned deterministically in
+        // `lu_reconstruction_known_failure_subnormal_pivot` below.
+        let a = zero_tiny_entries(draw_dmatrix(&tc, n, n));
+
+        let (p, l, u) = a.clone().lu().unpack();
+        let mut lu = l * u;
+        p.inv_permute_rows(&mut lu);
+
+        let tol = lu_backward_tol(n, fro_norm_upper(&a));
+        let resid = (&lu - &a).norm();
+        assert!(
+            resid <= tol,
+            "||P^-1 L U - A|| = {resid:e} > tol = {tol:e} for A = {a}"
+        );
+    }
+
+    // Solve residual: for x = lu_solve(A, b), A * x ≈ b.
+    //
+    // Tolerance: a backward-stable solve returns x that exactly solves
+    // (A + dA) x = b with ||dA|| <= c * n * g * eps * ||A||, so the residual
+    // obeys ||A x - b|| <= c * n * g * eps * ||A|| * ||x||. Scaling the
+    // tolerance by ||x|| makes the property hold even for near-singular A
+    // (where ||x|| blows up), so no condition-number skip is needed here —
+    // we only skip when `solve` itself reports exact singularity (a pivot
+    // is exactly zero and no solution is produced). The + ||b|| term covers
+    // the representation error of b itself when x is tiny.
+    #[hegel::test]
+    fn lu_solve_residual_is_small(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        // KNOWN BUG exclusion (`zero_tiny_entries`) — subnormal pivots
+        // poison the factors with NaN; pinned deterministically in
+        // `lu_reconstruction_known_failure_subnormal_pivot` below.
+        let a = zero_tiny_entries(draw_dmatrix(&tc, n, n));
+        let b = draw_dmatrix(&tc, n, 1);
+
+        let lu = a.clone().lu();
+        if let Some(x) = lu.solve(&b) {
+            // If the true solution's magnitude exceeds f64::MAX the solver
+            // faithfully returns infinities and no finite-residual bound
+            // applies; skip. (Observed for 1x1 systems with a near-1e-308
+            // pivot and O(10) rhs. This protects the property's domain, not
+            // any nalgebra contract.)
+            if !x.iter().all(|v| v.is_finite()) {
+                return;
+            }
+            let tol = lu_backward_tol(n, fro_norm_upper(&a) * fro_norm_upper(&x) + fro_norm_upper(&b));
+            let resid = (&a * &x - &b).norm();
+            assert!(
+                resid <= tol,
+                "||A x - b|| = {resid:e} > tol = {tol:e} for A = {a}, b = {b}"
+            );
+        }
+    }
+
+    // det(A * B) = det(A) * det(B).
+    //
+    // Both sides are computed through LU (for n > 3), whose determinant has
+    // relative error ~ c * n * g * eps * kappa(A): to first order,
+    // |d det| <= ||adj(A)|| * ||dA|| = |det(A)| * ||A^{-1}|| * ||dA||, with
+    // ||dA|| <= c' * n * g * eps * ||A|| from backward stability, i.e. a
+    // relative error c' * n * g * eps * kappa(A). We measure
+    // kappa_2 = sigma_max / sigma_min from the SVD, combine
+    // kappa(A*B) <= kappa(A) * kappa(B), and skip pairs whose resulting
+    // relative tolerance exceeds 1e-3 — for those the identity is not
+    // checkable in f64 (this is the determinant/condition threshold skip;
+    // singular draws, e.g. matrices containing a zero column, are skipped
+    // the same way via sigma_min = 0).
+    #[hegel::test]
+    fn determinant_product_rule(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        // KNOWN BUG exclusion (`zero_tiny_entries`) — the determinant is
+        // computed through LU (n > 3), where subnormal pivots poison the
+        // factors with NaN; pinned in
+        // `lu_reconstruction_known_failure_subnormal_pivot` below.
+        let a = zero_tiny_entries(draw_dmatrix(&tc, n, n));
+        let b = zero_tiny_entries(draw_dmatrix(&tc, n, n));
+
+        let sa = a.singular_values();
+        let sb = b.singular_values();
+        if sa.min() <= 0.0 || sb.min() <= 0.0 {
+            return; // exactly singular: det = 0 has no relative accuracy
+        }
+        let kappa = (sa.max() / sa.min()) * (sb.max() / sb.min());
+        let rel_tol = 64.0 * n as f64 * (1u64 << n) as f64 * EPS * kappa;
+        if rel_tol > 1.0e-3 {
+            return; // too ill-conditioned for the identity to be checkable
+        }
+
+        let lhs = (&a * &b).determinant();
+        let rhs = a.determinant() * b.determinant();
+        let tol = (rel_tol * lhs.abs().max(rhs.abs())).max(f64::MIN_POSITIVE);
+        assert!(
+            (lhs - rhs).abs() <= tol,
+            "det(A*B) = {lhs:e} vs det(A)*det(B) = {rhs:e}, tol = {tol:e}, A = {a}, B = {b}"
+        );
+    }
+
+    // det(A^T) = det(A).
+    //
+    // The two determinants run LU on different pivot sequences (and, for
+    // n <= 3, evaluate the cofactor formula with different groupings), so
+    // they agree only up to the determinant's own conditioning — the same
+    // c * n * g * eps * kappa(A) relative-error argument as in
+    // `determinant_product_rule`, with the same skip threshold.
+    #[hegel::test]
+    fn determinant_of_transpose_matches(tc: hegel::TestCase) {
+        let n = draw_dim(&tc);
+        // KNOWN BUG exclusion (`zero_tiny_entries`) — see
+        // `determinant_product_rule` above.
+        let a = zero_tiny_entries(draw_dmatrix(&tc, n, n));
+
+        let s = a.singular_values();
+        if s.min() <= 0.0 {
+            return; // exactly singular: det = 0 has no relative accuracy
+        }
+        let kappa = s.max() / s.min();
+        let rel_tol = 64.0 * n as f64 * (1u64 << n) as f64 * EPS * kappa;
+        if rel_tol > 1.0e-3 {
+            return; // too ill-conditioned for the identity to be checkable
+        }
+
+        let lhs = a.transpose().determinant();
+        let rhs = a.determinant();
+        let tol = (rel_tol * lhs.abs().max(rhs.abs())).max(f64::MIN_POSITIVE);
+        assert!(
+            (lhs - rhs).abs() <= tol,
+            "det(A^T) = {lhs:e} vs det(A) = {rhs:e}, tol = {tol:e}, A = {a}"
+        );
+    }
+
+    // KNOWN FAILURE (real bug, deterministically pinned; found by
+    // `lu_reconstructs_permuted_matrix` at a raised case count, shrunk by
+    // hegel to this input).
+    //
+    // For A = [[0, 0], [5.562684646268003e-309, 0]] — a finite matrix with
+    // a subnormal entry — the unpacked LU factors contain NaN:
+    // L = [[1, 0], [NaN, 1]], U = [[5.56e-309, 0], [0, NaN]], so the
+    // reconstruction P^-1 * L * U is NaN instead of A.
+    //
+    // Root cause: `gauss_step` / `gauss_step_swap` in src/linalg/lu.rs
+    // divide by the pivot via `let inv_diag = T::one() / diag;
+    // coeffs *= inv_diag;`. When |pivot| < 1/f64::MAX (~5.6e-309) the
+    // reciprocal overflows to inf, and the zero entries below the pivot
+    // become 0 * inf = NaN, which then propagates through the elimination.
+    // (LAPACK's dgetrf guards exactly this with an `abs(pivot) >= sfmin`
+    // test, falling back to actual division.) The hegel properties above
+    // exclude the trigger zone via `zero_tiny_entries` and reference this
+    // test.
+    #[test]
+    fn lu_reconstruction_known_failure_subnormal_pivot() {
+        // Column-major: a11, a21, a12, a22.
+        let a = na::DMatrix::<f64>::from_vec(2, 2, vec![0.0, 5.562684646268003e-309, 0.0, 0.0]);
+        let (p, l, u) = a.clone().lu().unpack();
+        let mut lu = l * u;
+        p.inv_permute_rows(&mut lu);
+
+        let tol = lu_backward_tol(2, fro_norm_upper(&a));
+        let resid = (&lu - &a).norm();
+        assert!(
+            resid <= tol,
+            "||P^-1 L U - A|| = {resid:e} > tol = {tol:e} for A = {a}"
+        );
+    }
+}
diff --git a/tests/linalg/qr.rs b/tests/linalg/qr.rs
index f499b030..8e832439 100644
--- a/tests/linalg/qr.rs
+++ b/tests/linalg/qr.rs
@@ -116,3 +116,110 @@ macro_rules! gen_tests(
 
 gen_tests!(complex, complex_f64(), RandComplex<f64>);
 gen_tests!(f64, PROPTEST_F64, RandScalar<f64>);
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// These supplement the proptest suite above with drawn dimensions (1..=6)
+// and explicitly conditioning-derived tolerances instead of blanket 1e-7
+// epsilons. Entry magnitudes are bounded to [-100, 100] by the shared
+// helpers in `crate::utils` (see the comment there).
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use crate::utils::{draw_dim, draw_dmatrix, fro_norm_upper, zero_tiny_entries};
+
+    const EPS: f64 = f64::EPSILON;
+
+    // Oracle-independent reconstruction: Q * R must rebuild the input A.
+    //
+    // Tolerance: Householder QR is backward stable — the computed factors
+    // satisfy Q*R = A + dA with ||dA||_F <= c * n * eps * ||A||_F for a
+    // modest constant c (Higham, Accuracy and Stability, ch. 19). With
+    // n = max(rows, cols) <= 6 we take c = 32 for headroom. The floor at
+    // f64::MIN_POSITIVE keeps the tolerance from underflowing to exactly
+    // zero when all drawn entries are subnormal-scale.
+    #[hegel::test]
+    fn qr_reconstructs_matrix(tc: hegel::TestCase) {
+        let rows = draw_dim(&tc);
+        let cols = draw_dim(&tc);
+        // KNOWN BUG exclusion (`zero_tiny_entries`) — a Householder pivot
+        // column whose ||col||^2 underflows while its leading entry is a
+        // nonzero *negative* value gets an inconsistent sign between Q and
+        // R; pinned deterministically in
+        // `qr_reconstruction_known_failure_tiny_negative_pivot` below.
+        let a = zero_tiny_entries(draw_dmatrix(&tc, rows, cols));
+
+        let qr = a.clone().qr();
+        let reconstructed = qr.q() * qr.r();
+
+        let n = rows.max(cols) as f64;
+        let tol = (32.0 * n * EPS * fro_norm_upper(&a)).max(f64::MIN_POSITIVE);
+        let resid = (&reconstructed - &a).norm();
+        assert!(
+            resid <= tol,
+            "||Q*R - A|| = {resid:e} > tol = {tol:e} for A = {a}"
+        );
+    }
+
+    // Oracle-independent orthonormality: the columns of the computed Q are
+    // orthonormal, i.e. Q^T * Q ≈ I (Q is rows x min(rows, cols), so the
+    // Gram matrix is min x min).
+    //
+    // Tolerance: for Householder QR the computed Q satisfies
+    // ||Q^T Q - I||_2 <= c * n * eps regardless of A's conditioning (the
+    // Householder reflectors are orthogonal to working precision). In
+    // Frobenius norm this picks up at most a factor sqrt(min(rows, cols));
+    // c = 32 for headroom. No dependence on ||A|| — Q's entries are O(1).
+    #[hegel::test]
+    fn qr_q_is_orthonormal(tc: hegel::TestCase) {
+        let rows = draw_dim(&tc);
+        let cols = draw_dim(&tc);
+        let a = draw_dmatrix(&tc, rows, cols);
+
+        let q = a.clone().qr().q();
+        let k = rows.min(cols);
+        let gram = q.transpose() * &q;
+
+        let n = rows.max(cols) as f64;
+        let tol = 32.0 * n * EPS * (k as f64).sqrt();
+        let resid = (&gram - na::DMatrix::<f64>::identity(k, k)).norm();
+        assert!(
+            resid <= tol,
+            "||Q^T Q - I|| = {resid:e} > tol = {tol:e} for A = {a}"
+        );
+    }
+
+    // KNOWN FAILURE (real bug, deterministically pinned; found by
+    // `qr_reconstructs_matrix`, shrunk by hegel to this input).
+    //
+    // For A = [-1.2477e-162, 1.0] (1x2), Q*R = [-0.0, -1.0]: the residual is
+    // 2.0 instead of O(eps). Root cause, in `src/linalg/householder.rs
+    // reflection_axis_mut` + `src/linalg/qr.rs q()`:
+    //   * the pivot column [-1.2477e-162] has norm_squared() = 1.56e-324,
+    //     which underflows to 0.0, so reflection_norm = 0 and
+    //     factor = 0 -> "no reflection necessary" is reported and the
+    //     trailing columns of R are left untouched;
+    //   * the returned signed norm is sign(-) * 0.0 = -0.0, stored in
+    //     `diag`; `q()` later applies `reflect_with_sign(...,
+    //     diag.signum())` where signum(-0.0) = -1, so Q's column gets a
+    //     sign flip that the factorization never applied to R.
+    // Any pivot column with a tiny *negative* leading entry and
+    // ||col||^2 underflowing to zero triggers this (positive tiny entries
+    // and exact +/-0.0 are handled consistently). The general
+    // `qr_reconstructs_matrix` property above excludes the trigger zone and
+    // references this test.
+    #[test]
+    fn qr_reconstruction_known_failure_tiny_negative_pivot() {
+        let a = na::DMatrix::<f64>::from_vec(1, 2, vec![-1.2477274453361457e-162, 1.0]);
+        let qr = a.clone().qr();
+        let reconstructed = qr.q() * qr.r();
+        // Generous tolerance: the residual should be O(eps * ||A||) ~ 1e-16;
+        // the observed residual is 2.0.
+        let tol = 1.0e-8;
+        let resid = (&reconstructed - &a).norm();
+        assert!(
+            resid <= tol,
+            "||Q*R - A|| = {resid:e} > tol = {tol:e} for A = {a}"
+        );
+    }
+}
