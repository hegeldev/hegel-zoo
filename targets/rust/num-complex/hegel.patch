@@ -2948,4 +2948,621 @@ pub(crate) mod test {
         assert_eq!(C.re, 12.3);
         assert_eq!(C.im, -4.5);
     }
+
+    /// Property-based tests (hegel) over `Complex<f64>`.
+    ///
+    /// All drawn components are finite (no NaN/inf inputs); generators mix
+    /// moderate magnitudes with exact zeros (giving pure-real / pure-imaginary
+    /// probes) and large/small extremes. Every approximate comparison states
+    /// the conditioning argument its tolerance is derived from.
+    mod hegel_props {
+        use crate::{Complex, Complex64};
+        use core::str::FromStr;
+        use std::string::{String, ToString};
+
+        use hegel::generators;
+        use hegel::Generator;
+
+        const EPS: f64 = f64::EPSILON;
+        /// Smallest positive (subnormal) f64 — the quantization step at the
+        /// very bottom of the range.
+        const DENORM_MIN: f64 = 5e-324;
+
+        const ZERO: Complex64 = Complex::new(0.0, 0.0);
+        const ONE: Complex64 = Complex::new(1.0, 0.0);
+
+        /// Largest component magnitude: an overflow-safe scale for tolerances
+        /// (`norm()`/`norm_sqr()` of extreme inputs could overflow inside the
+        /// test's own arithmetic before the library misbehaves).
+        fn max_norm(z: Complex64) -> f64 {
+            z.re.abs().max(z.im.abs())
+        }
+
+        /// Componentwise `|actual - expected| <= tol`. The tolerance is
+        /// floored at `f64::MIN_POSITIVE` so a magnitude-scaled tolerance
+        /// cannot underflow to zero on subnormal-scale operands (which would
+        /// turn a legitimate one-quantum residual into a false failure).
+        /// Exactly equal components (including equal infinities) always pass.
+        fn approx_eq(actual: Complex64, expected: Complex64, tol: f64) -> bool {
+            let tol = tol.max(f64::MIN_POSITIVE);
+            let ok = |x: f64, y: f64| x == y || (x - y).abs() <= tol;
+            ok(actual.re, expected.re) && ok(actual.im, expected.im)
+        }
+
+        /// Exact componentwise equality that also treats two NaNs as equal:
+        /// with unrestricted finite draws a product can overflow and both
+        /// sides of an exact identity then compute the *same* `inf - inf`
+        /// = NaN expression.
+        fn identical(a: Complex64, b: Complex64) -> bool {
+            let same = |x: f64, y: f64| x == y || (x.is_nan() && y.is_nan());
+            same(a.re, b.re) && same(a.im, b.im)
+        }
+
+        /// Finite f64: mostly moderate magnitudes, with signed zeros and
+        /// large/small extremes mixed in. Bounded float draws never yield
+        /// NaN or infinity.
+        #[hegel::composite]
+        fn finite_f64(tc: &hegel::TestCase) -> f64 {
+            tc.draw(hegel::one_of!(
+                generators::floats::<f64>().min_value(-1e6).max_value(1e6),
+                generators::floats::<f64>().min_value(-1e300).max_value(1e300),
+                generators::floats::<f64>().min_value(-1e-300).max_value(1e-300),
+                generators::just(0.0f64),
+                generators::just(-0.0f64),
+            ))
+        }
+
+        /// Finite complex with components up to ~1e300 in magnitude. Zero,
+        /// pure-real, and pure-imaginary values arise from the zero branches
+        /// of `finite_f64`. Used for *exact* identities, which must hold at
+        /// any magnitude.
+        #[hegel::composite]
+        fn finite_complex(tc: &hegel::TestCase) -> Complex64 {
+            let re = tc.draw(finite_f64());
+            let im = tc.draw(finite_f64());
+            Complex::new(re, im)
+        }
+
+        /// Well-conditioned complex: component magnitudes <= 1e50, so that
+        /// `norm_sqr()` and pairwise products stay comfortably inside the
+        /// normal f64 range (<= ~1e100, no overflow; >= ~1e-100 for the
+        /// deliberately-small branch, no underflow). This bound protects the
+        /// conditioning argument of *approximate* identities — it is not a
+        /// contract of the library. Exact identities use `finite_complex`.
+        #[hegel::composite]
+        fn wellcond_complex(tc: &hegel::TestCase) -> Complex64 {
+            let component = || {
+                tc.draw(hegel::one_of!(
+                    generators::floats::<f64>().min_value(-1e6).max_value(1e6),
+                    generators::floats::<f64>().min_value(-1e50).max_value(1e50),
+                    generators::floats::<f64>().min_value(-1e-50).max_value(1e-50),
+                    generators::just(0.0f64),
+                ))
+            };
+            let re = component();
+            let im = component();
+            Complex::new(re, im)
+        }
+
+        // ------------------------------------------------------------------
+        // Arithmetic field identities (oracle-independent algebraic laws)
+        // ------------------------------------------------------------------
+
+        // Complex addition is componentwise IEEE addition, which commutes
+        // *exactly* (inputs are never NaN; equal overflow-infinities pass),
+        // so no tolerance is involved.
+        #[hegel::test]
+        fn prop_add_commutative(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            let b = tc.draw((finite_complex()).print_as_debug());
+            let lhs = a + b;
+            let rhs = b + a;
+            assert!(identical(lhs, rhs), "{:?} != {:?}", lhs, rhs);
+        }
+
+        // x + (-x) and x - x round to exactly +-0.0 in IEEE arithmetic for
+        // every finite x, so the additive-inverse identity is exact.
+        #[hegel::test]
+        fn prop_additive_inverse_exact(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            assert_eq!(a + (-a), ZERO);
+            assert_eq!(a - a, ZERO);
+        }
+
+        // Association order changes rounding: each componentwise addition
+        // rounds with error <= EPS/2 * |intermediate|, and every intermediate
+        // is bounded by max_norm(a)+max_norm(b)+max_norm(c), so the two
+        // orders differ by at most ~2*EPS*scale. Tolerance 4x that bound.
+        // Sums of components <= 3e300 cannot overflow with `finite_complex`.
+        #[hegel::test]
+        fn prop_add_associative(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            let b = tc.draw((finite_complex()).print_as_debug());
+            let c = tc.draw((finite_complex()).print_as_debug());
+            let scale = max_norm(a) + max_norm(b) + max_norm(c);
+            let tol = 4.0 * EPS * scale;
+            let lhs = (a + b) + c;
+            let rhs = a + (b + c);
+            assert!(
+                approx_eq(lhs, rhs, tol),
+                "{:?} != {:?} (tol {:e})",
+                lhs,
+                rhs,
+                tol
+            );
+        }
+
+        // Multiplication commutes *exactly*: the commuted form evaluates the
+        // same IEEE expressions (float multiply commutes, and the final
+        // add/sub sees identical operands). When a squaring overflows, both
+        // sides compute the same inf / (inf - inf = NaN), which `identical`
+        // accepts.
+        #[hegel::test]
+        fn prop_mul_commutative(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            let b = tc.draw((finite_complex()).print_as_debug());
+            let lhs = a * b;
+            let rhs = b * a;
+            assert!(identical(lhs, rhs), "{:?} != {:?}", lhs, rhs);
+        }
+
+        // Distributivity a*(b+c) ~= a*b + a*c holds up to rounding. Error
+        // budget: (b+c) carries <= EPS*(max_norm(b)+max_norm(c)) per
+        // component; each product component adds ~2 more roundings of
+        // magnitude <= 2*max_norm(a)*(max_norm(b)+max_norm(c)); the final sum
+        // one more. Total <= ~6*EPS*scale; tolerance 16x for margin.
+        // Well-conditioned draws keep all products (<= ~1e100) in the normal
+        // range, protecting this error analysis, not any library contract.
+        #[hegel::test]
+        fn prop_mul_distributive(tc: hegel::TestCase) {
+            let a = tc.draw((wellcond_complex()).print_as_debug());
+            let b = tc.draw((wellcond_complex()).print_as_debug());
+            let c = tc.draw((wellcond_complex()).print_as_debug());
+            let tol = 16.0 * EPS * max_norm(a) * (max_norm(b) + max_norm(c));
+            let lhs = a * (b + c);
+            let rhs = a * b + a * c;
+            assert!(
+                approx_eq(lhs, rhs, tol),
+                "{:?} != {:?} (tol {:e})",
+                lhs,
+                rhs,
+                tol
+            );
+        }
+
+        // ------------------------------------------------------------------
+        // Multiplicative inverses
+        // ------------------------------------------------------------------
+
+        // (a*b)/b recovers a. Division amplification is bounded: the
+        // numerator terms are <= 2*max_norm(a)*max_norm(b)^2 while
+        // norm_sqr(b) >= max_norm(b)^2, so every intermediate is
+        // <= 2*max_norm(a) and the ~6 roundings give componentwise error
+        // <= ~12*EPS*max_norm(a); tolerance 32x EPS for margin.
+        // norm_sqr(b) must be a *normal* float: Div<Complex> is the textbook
+        // (a * conj b) / norm_sqr(b) formula (see src/lib.rs Div impl) and
+        // degrades by design once norm_sqr over/underflows — `fdiv` is the
+        // crate's robust alternative. The assume protects this conditioning
+        // argument, not a library contract.
+        #[hegel::test]
+        fn prop_mul_div_roundtrip(tc: hegel::TestCase) {
+            let a = tc.draw((wellcond_complex()).print_as_debug());
+            let b = tc.draw((wellcond_complex()).print_as_debug());
+            tc.assume(b.norm_sqr().is_normal());
+            let got = (a * b) / b;
+            // Underflow term: the numerator products (scale
+            // max_norm(a)*max_norm(b)^2) and the a*b components (scale
+            // max_norm(a)*max_norm(b)) can underflow even while norm_sqr(b)
+            // is normal (e.g. a ~ 1e-168, b ~ 1e-137 makes a*b*b ~ 1e-441).
+            // Each underflowing rounding contributes <= DENORM_MIN absolute,
+            // which the final /norm_sqr(b) turns into DENORM_MIN/norm_sqr(b)
+            // (numerator term) resp. DENORM_MIN*max_norm(b)/norm_sqr(b)
+            // (product term). This protects the test's conditioning: the Div
+            // impl is the textbook single-pass formula and degrades there by
+            // design.
+            let tol = 32.0 * EPS * max_norm(a)
+                + 4.0 * DENORM_MIN * (1.0 + max_norm(b)) / b.norm_sqr();
+            assert!(
+                approx_eq(got, a, tol),
+                "(a*b)/b = {:?}, a = {:?} (tol {:e})",
+                got,
+                a,
+                tol
+            );
+        }
+
+        // a * a.inv() ~= 1. inv()'s components carry ~2*EPS relative error;
+        // the product's real part sums two ~0.5-magnitude terms to 1 and its
+        // imaginary part cancels two equal-magnitude terms, adding ~2 more
+        // roundings each: total well under 16*EPS absolute. As above, the
+        // naive re/norm_sqr formula requires norm_sqr(a) normal (finv() is
+        // the robust variant); the assume protects the analysis, not a
+        // library contract.
+        #[hegel::test]
+        fn prop_mul_inv_is_one(tc: hegel::TestCase) {
+            let a = tc.draw((wellcond_complex()).print_as_debug());
+            tc.assume(a.norm_sqr().is_normal());
+            let got = a * a.inv();
+            let tol = 16.0 * EPS;
+            assert!(
+                approx_eq(got, ONE, tol),
+                "a * a.inv() = {:?} (tol {:e})",
+                got,
+                tol
+            );
+        }
+
+        // ------------------------------------------------------------------
+        // Conjugation
+        // ------------------------------------------------------------------
+
+        // Negation is exact in IEEE arithmetic, so conjugation is an exact
+        // involution at any magnitude.
+        #[hegel::test]
+        fn prop_conj_involution_exact(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            assert_eq!(a.conj().conj(), a);
+        }
+
+        // (a*b).conj() == a.conj()*b.conj() *exactly*: negation is exact and
+        // round-to-nearest is sign-symmetric (RN(-x-y) = -RN(x+y)), so both
+        // sides round identically componentwise — including the shared
+        // inf - inf = NaN case on overflow, handled by `identical`.
+        #[hegel::test]
+        fn prop_conj_multiplicative_exact(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            let b = tc.draw((finite_complex()).print_as_debug());
+            let lhs = (a * b).conj();
+            let rhs = a.conj() * b.conj();
+            assert!(identical(lhs, rhs), "{:?} != {:?}", lhs, rhs);
+        }
+
+        // a * a.conj() == norm_sqr(a) + 0i *exactly*: the real parts round
+        // the same re^2 + im^2 expression identically, and the imaginary
+        // part is RN(p) - RN(p) = +0.0 for p = re*im. Requires norm_sqr
+        // finite (guaranteed by wellcond draws, <= ~2e100) — on overflow the
+        // imaginary part would be inf - inf = NaN by IEEE rules, which is
+        // about f64, not about this crate.
+        #[hegel::test]
+        fn prop_mul_conj_is_norm_sqr(tc: hegel::TestCase) {
+            let a = tc.draw((wellcond_complex()).print_as_debug());
+            let got = a * a.conj();
+            let expected = Complex::new(a.norm_sqr(), 0.0);
+            assert_eq!(got, expected);
+        }
+
+        // ------------------------------------------------------------------
+        // norm / norm_sqr
+        // ------------------------------------------------------------------
+
+        // norm() is hypot(re, im) and norm_sqr() is re^2 + im^2: when
+        // norm_sqr is a normal float, norm()^2 must agree with it. Error
+        // budget: hypot within ~2 ULP (4*EPS relative after squaring),
+        // squaring adds one rounding, norm_sqr carries ~2 roundings:
+        // <= ~8*EPS relative; tolerance 16x EPS for platform-libm margin.
+        #[hegel::test]
+        fn prop_norm_squared_matches_norm_sqr(tc: hegel::TestCase) {
+            let a = tc.draw((wellcond_complex()).print_as_debug());
+            let ns = a.norm_sqr();
+            tc.assume(ns.is_normal());
+            let n2 = a.norm() * a.norm();
+            assert!(
+                (n2 - ns).abs() <= 16.0 * EPS * ns,
+                "norm^2 = {:e}, norm_sqr = {:e}",
+                n2,
+                ns
+            );
+        }
+
+        // Oracle-independent bounds: max(|re|,|im|) <= |z| <= sqrt(2) *
+        // max(|re|,|im|), relaxed by 4*EPS for hypot's rounding. Checked on
+        // *unrestricted* finite draws because not overflowing where
+        // sqrt(norm_sqr) would (components up to 1e300) is exactly what
+        // hypot-based norm() buys; norm() must stay finite there.
+        #[hegel::test]
+        fn prop_norm_bounds(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            let n = a.norm();
+            let m = max_norm(a);
+            assert!(n.is_finite(), "norm overflowed: {:?} -> {:e}", a, n);
+            assert!(n >= m * (1.0 - 4.0 * EPS), "norm {:e} < max_norm {:e}", n, m);
+            assert!(
+                n <= core::f64::consts::SQRT_2 * m * (1.0 + 4.0 * EPS),
+                "norm {:e} > sqrt(2)*max_norm {:e}",
+                n,
+                m
+            );
+        }
+
+        // |a*b| = |a|*|b| exactly over the reals. Computed: the product's
+        // components carry ~2*EPS relative error (of scale
+        // max_norm(a)*max_norm(b)), hypot turns that into ~4*EPS relative,
+        // plus ~2*EPS from hypot itself and the norms' own product: <= ~8*EPS
+        // relative; tolerance 16x. Two subnormal effects are added
+        // explicitly: when a factor's norm is subnormal it is quantized in
+        // DENORM_MIN steps (hypot(5e-324, 5e-324) rounds a full quantum
+        // low), and the other factor's magnitude amplifies that error to
+        // DENORM_MIN * |other|; the MIN_POSITIVE floor covers quantization
+        // of the *result*. Both protect the test's conditioning at the
+        // bottom of the range, not any library contract.
+        #[hegel::test]
+        fn prop_norm_multiplicative(tc: hegel::TestCase) {
+            let a = tc.draw((wellcond_complex()).print_as_debug());
+            let b = tc.draw((wellcond_complex()).print_as_debug());
+            let lhs = (a * b).norm();
+            let rhs = a.norm() * b.norm();
+            let tol = (16.0 * EPS * rhs + 2.0 * DENORM_MIN * (a.norm() + b.norm()))
+                .max(f64::MIN_POSITIVE);
+            assert!(
+                (lhs - rhs).abs() <= tol,
+                "|a*b| = {:e}, |a|*|b| = {:e} (tol {:e})",
+                lhs,
+                rhs,
+                tol
+            );
+        }
+
+        // ------------------------------------------------------------------
+        // from_polar / to_polar (the crown roundtrip)
+        // ------------------------------------------------------------------
+
+        // from_polar(r, theta).to_polar() ~= (r, theta) for r > 0 and theta
+        // in [-pi, pi] (atan2's principal range; the f64 nearest to pi is
+        // strictly inside it, so the endpoints don't wrap). Conditioning:
+        //  - r' = hypot(r cos t, r sin t): each component carries ~2
+        //    roundings and hypot ~2 more -> 8*EPS relative, floored (via
+        //    max with MIN_POSITIVE) for subnormal r.
+        //  - theta': component *absolute* errors ~EPS*r map to an angle
+        //    error of ~EPS radians; when a component lands in the subnormal
+        //    range it is additionally quantized in steps of DENORM_MIN,
+        //    contributing up to ~2*DENORM_MIN/r radians. Tolerance
+        //    16*EPS*(1+|theta|) + 2*DENORM_MIN/r. The underflow term
+        //    protects the test's conditioning at the bottom of the range,
+        //    not any library contract.
+        #[hegel::test]
+        fn prop_polar_roundtrip(tc: hegel::TestCase) {
+            let r = tc.draw(hegel::one_of!(
+                generators::floats::<f64>().min_value(0.0).max_value(1e300),
+                generators::floats::<f64>().min_value(0.0).max_value(1e-300),
+                generators::just(0.0f64),
+            ));
+            let pi = core::f64::consts::PI;
+            let theta = tc.draw(hegel::one_of!(
+                generators::floats::<f64>().min_value(-pi).max_value(pi),
+                // probe the seams: near +-pi and near 0
+                generators::floats::<f64>().min_value(3.14).max_value(pi),
+                generators::floats::<f64>().min_value(-pi).max_value(-3.14),
+                generators::just(0.0f64),
+            ));
+
+            let z = Complex::from_polar(r, theta);
+            let (r2, theta2) = z.to_polar();
+
+            let tol_r = (8.0 * EPS * r).max(f64::MIN_POSITIVE);
+            assert!(
+                (r2 - r).abs() <= tol_r,
+                "r' = {:e}, r = {:e} (tol {:e})",
+                r2,
+                r,
+                tol_r
+            );
+            if r > 0.0 {
+                let tol_t = 16.0 * EPS * (1.0 + theta.abs()) + 2.0 * DENORM_MIN / r;
+                assert!(
+                    (theta2 - theta).abs() <= tol_t,
+                    "theta' = {:e}, theta = {:e} (tol {:e})",
+                    theta2,
+                    theta,
+                    tol_t
+                );
+            } else {
+                // the angle of the zero vector is unrecoverable; the radius
+                // must still round-trip exactly.
+                assert_eq!(r2, 0.0);
+            }
+        }
+
+        // ------------------------------------------------------------------
+        // exp / ln inverses (principal branch)
+        // ------------------------------------------------------------------
+
+        // a.exp().ln() ~= a on the strip re in [-700, 700] (keeps e^re
+        // inside the normal f64 range, |ln| <= ~708) and im in (-pi, pi)
+        // (principal branch; the f64 values nearest +-pi are strictly inside,
+        // so ln cannot wrap the angle). Error budget: e^re carries ~2*EPS
+        // relative; ln maps relative error to *absolute* error (~2*EPS) and
+        // its own ULP at the result adds ~EPS*|re|; the angle recovers as in
+        // the polar roundtrip with r = e^re >= ~1e-304, making the subnormal
+        // quantization term ~1e-19 at worst, absorbed by the margin.
+        // Tolerances: 16*EPS*(1+|re|) for re, 16*EPS*(1+|im|) for im.
+        #[hegel::test]
+        fn prop_exp_ln_roundtrip(tc: hegel::TestCase) {
+            let re = tc.draw(
+                generators::floats::<f64>()
+                    .min_value(-700.0)
+                    .max_value(700.0),
+            );
+            let pi = core::f64::consts::PI;
+            let im = tc.draw(hegel::one_of!(
+                generators::floats::<f64>().min_value(-pi).max_value(pi),
+                generators::floats::<f64>().min_value(3.14).max_value(pi),
+                generators::floats::<f64>().min_value(-pi).max_value(-3.14),
+                generators::just(0.0f64),
+            ));
+            let a = Complex::new(re, im);
+            let b = a.exp().ln();
+            let tol_re = 16.0 * EPS * (1.0 + re.abs());
+            let tol_im = 16.0 * EPS * (1.0 + im.abs());
+            assert!(
+                (b.re - re).abs() <= tol_re,
+                "exp.ln re: {:e} vs {:e} (tol {:e})",
+                b.re,
+                re,
+                tol_re
+            );
+            assert!(
+                (b.im - im).abs() <= tol_im,
+                "exp.ln im: {:e} vs {:e} (tol {:e})",
+                b.im,
+                im,
+                tol_im
+            );
+        }
+
+        // a.ln().exp() ~= a for a != 0 (any finite magnitude). exp amplifies
+        // the absolute error of ln(|a|) — itself ~EPS*(1+|ln |a||), with
+        // |ln |a|| <= ~745 — into *relative* error of the result, so the
+        // tolerance is 16*EPS*(1+|ln |a||)*max_norm(a). The approx_eq floor
+        // covers subnormal-scale outputs where the result is quantized in
+        // DENORM_MIN steps.
+        #[hegel::test]
+        fn prop_ln_exp_roundtrip(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            tc.assume(a != ZERO);
+            let b = a.ln().exp();
+            let log_scale = a.norm().ln().abs();
+            let tol = 16.0 * EPS * (1.0 + log_scale) * max_norm(a);
+            assert!(
+                approx_eq(b, a, tol),
+                "ln.exp: {:?} vs {:?} (tol {:e})",
+                b,
+                a,
+                tol
+            );
+        }
+
+        // ------------------------------------------------------------------
+        // sqrt / powers
+        // ------------------------------------------------------------------
+
+        // sqrt(a)^2 ~= a. sqrt's components carry ~3*EPS relative error at
+        // scale sqrt(|a|) (hypot, libm sqrt, sin/cos ~1 ULP each); squaring
+        // doubles the relative error and the final add/sub of products is
+        // bounded by |a| even under cancellation near the branch cut, giving
+        // componentwise error <= ~12*EPS*|a|; tolerance 32x EPS, floored for
+        // subnormal inputs. |a| <= ~1.5e300 cannot overflow the tolerance
+        // computation.
+        #[hegel::test]
+        fn prop_sqrt_squares_to_input(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            let s = a.sqrt();
+            let got = s * s;
+            let tol = 32.0 * EPS * a.norm();
+            assert!(
+                approx_eq(got, a, tol),
+                "sqrt^2: {:?} vs {:?} (tol {:e})",
+                got,
+                a,
+                tol
+            );
+        }
+
+        // KNOWN FAILURE — real bug (kept failing on purpose, do not "fix" the
+        // test): sqrt() maps a nonzero input to exactly zero. For
+        // z = 5e-324i, the pure-imaginary special case computes
+        // (im.abs()/2).sqrt(), and im/2 underflows to 0.0 *before* the square
+        // root, so sqrt(5e-324i) == 0 even though the true principal root
+        // ~1.5717e-162 * (1+i) is a perfectly representable *normal* float
+        // (real f64::sqrt never collapses nonzero to zero). Nearby subnormal
+        // inputs (e.g. 1.5e-323i) keep a nonzero but ~15%-wrong result for
+        // the same reason: halving before rooting discards the subnormal
+        // range that sqrt would have rescued. Oracle-independent invariant:
+        // sqrt(z) == 0 iff z == 0. Inputs are drawn from the exact failing
+        // set, so this fails deterministically on every run.
+        #[hegel::test]
+        fn prop_sqrt_of_nonzero_is_nonzero(tc: hegel::TestCase) {
+            let re = tc.draw(generators::sampled_from(vec![0.0f64, -0.0f64]));
+            let im = tc.draw(generators::sampled_from(vec![DENORM_MIN, -DENORM_MIN]));
+            let a = Complex::new(re, im);
+            let s = a.sqrt();
+            assert!(
+                s != ZERO,
+                "sqrt({:?}) == 0 for a nonzero input (true root ~1.57e-162*(1+-i))",
+                a
+            );
+        }
+
+        // Documented branch: -pi/2 <= arg(sqrt(z)) <= pi/2, i.e. the real
+        // part is never negative, and the imaginary part has the sign of
+        // z's imaginary part (the half-angle keeps the half-plane). Exact
+        // sign assertions, no tolerance.
+        #[hegel::test]
+        fn prop_sqrt_principal_branch(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            let s = a.sqrt();
+            assert!(s.re >= 0.0, "sqrt({:?}) = {:?} has negative re", a, s);
+            if a.im > 0.0 {
+                assert!(s.im >= 0.0, "sqrt({:?}) = {:?} left upper half", a, s);
+            } else if a.im < 0.0 {
+                assert!(s.im <= 0.0, "sqrt({:?}) = {:?} left lower half", a, s);
+            }
+        }
+
+        // powu(2) performs exactly one squaring — the identical `a * a`
+        // expression (see src/pow.rs) — so equality is exact; `identical`
+        // covers the shared inf - inf = NaN overflow case.
+        #[hegel::test]
+        fn prop_powu2_is_mul(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            let lhs = a.powu(2);
+            let rhs = a * a;
+            assert!(identical(lhs, rhs), "{:?} != {:?}", lhs, rhs);
+        }
+
+        // powf(0.5) and sqrt() both evaluate from_polar(sqrt(r), theta/2), up
+        // to (a) libm powf(r, 0.5) vs sqrt(r), within a couple ULP, and
+        // (b) sqrt's exact special cases on the axes, which powf approaches
+        // within ~EPS*sqrt(r) because cos(pi/2 rounded) ~= 6.1e-17.
+        // Tolerance 16*EPS*sqrt(|a|), floored for subnormal-scale results.
+        #[hegel::test]
+        fn prop_powf_half_matches_sqrt(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            // Subnormal-norm inputs excluded: sqrt()'s on-axis special cases
+            // halve the magnitude *before* rooting and lose relative accuracy
+            // (up to total collapse) in the subnormal range — see the pinned
+            // canonical failure `prop_sqrt_of_nonzero_is_nonzero` below.
+            tc.assume(a == ZERO || a.norm() >= f64::MIN_POSITIVE);
+            let tol = 16.0 * EPS * a.norm().sqrt();
+            let lhs = a.powf(0.5);
+            let rhs = a.sqrt();
+            assert!(
+                approx_eq(lhs, rhs, tol),
+                "powf(0.5) = {:?}, sqrt = {:?} (tol {:e})",
+                lhs,
+                rhs,
+                tol
+            );
+        }
+
+        // ------------------------------------------------------------------
+        // Display / FromStr
+        // ------------------------------------------------------------------
+
+        // Display prints "a+bi" with shortest-roundtrip f64 digits (a Rust
+        // guarantee since 1.0), and FromStr documents parsing exactly that
+        // grammar, so the roundtrip is *exact*. Comparison via == so that a
+        // -0.0 component may parse back as +0.0 (the value is preserved).
+        #[hegel::test]
+        #[allow(clippy::float_cmp)]
+        fn prop_display_fromstr_roundtrip(tc: hegel::TestCase) {
+            let a = tc.draw((finite_complex()).print_as_debug());
+            let s = a.to_string();
+            let b = Complex64::from_str(&s)
+                .unwrap_or_else(|e| panic!("failed to reparse {:?}: {:?}", s, e));
+            assert!(
+                a.re == b.re && a.im == b.im,
+                "{:?} -> {:?} -> {:?}",
+                a,
+                s,
+                b
+            );
+        }
+
+        // Parsing arbitrary text must return Err, never panic.
+        #[hegel::test]
+        fn prop_fromstr_never_panics(tc: hegel::TestCase) {
+            let s: String = tc.draw(generators::text());
+            let _ = Complex64::from_str(&s);
+        }
+    }
 }
