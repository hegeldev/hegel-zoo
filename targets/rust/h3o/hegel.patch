+/// Shared hegel generators for property-based tests.
+pub(crate) mod pbt {
+    use h3o::{CellIndex, LatLng, Resolution};
+    use hegel::generators;
+
+    /// Draw any of the 16 resolutions.
+    pub fn draw_resolution(tc: &hegel::TestCase) -> Resolution {
+        Resolution::try_from(
+            tc.draw(generators::integers::<u8>().max_value(15)),
+        )
+        .expect("resolution in [0; 15]")
+    }
+
+    /// Draw one of the 12 pentagons at the given resolution.
+    pub fn draw_pentagon(tc: &hegel::TestCase, res: Resolution) -> CellIndex {
+        let nth = tc.draw(generators::integers::<usize>().max_value(11));
+        res.pentagons().nth(nth).expect("12 pentagons per resolution")
+    }
+
+    /// Draw a valid cell index at the given resolution.
+    ///
+    /// Mixes geographic sampling (uniform lat/lng) with pentagons and
+    /// pentagon neighborhoods, because pentagons (and the distortion around
+    /// them) are the documented special case of the H3 grid and are almost
+    /// never hit by geographic sampling at fine resolutions.
+    pub fn draw_cell_at(tc: &hegel::TestCase, res: Resolution) -> CellIndex {
+        let choice = tc.draw(generators::integers::<u8>().max_value(9));
+        match choice {
+            // Pentagon.
+            0 => draw_pentagon(tc, res),
+            // Cell in the distorted region around a pentagon.
+            1 => {
+                let pentagon = draw_pentagon(tc, res);
+                let disk = pentagon.grid_disk::<Vec<_>>(2);
+                let i = tc.draw(
+                    generators::integers::<usize>().max_value(disk.len() - 1),
+                );
+                disk[i]
+            }
+            // Geographic sampling.
+            _ => {
+                let lat = tc.draw(
+                    generators::floats::<f64>().min_value(-90.).max_value(90.),
+                );
+                let lng = tc.draw(
+                    generators::floats::<f64>()
+                        .min_value(-180.)
+                        .max_value(180.),
+                );
+                LatLng::new(lat, lng)
+                    .expect("finite coordinate")
+                    .to_cell(res)
+            }
+        }
+    }
+
+    /// Draw a valid cell index (any resolution).
+    pub fn draw_cell(tc: &hegel::TestCase) -> CellIndex {
+        let res = draw_resolution(tc);
+        draw_cell_at(tc, res)
+    }
+}
