+// Parsing an arbitrary u64 as an index never panics, and a given bit
+// pattern is valid for at most one index type (the mode field is exclusive).
+#[hegel::test]
+fn pbt_try_from_u64_never_panics_and_modes_are_exclusive(
+    tc: hegel::TestCase,
+) {
+    let bits = tc.draw(hegel::generators::integers::<u64>());
+    let cell = h3o::CellIndex::try_from(bits).is_ok();
+    let edge = h3o::DirectedEdgeIndex::try_from(bits).is_ok();
+    let vertex = h3o::VertexIndex::try_from(bits).is_ok();
+    assert!(
+        u8::from(cell) + u8::from(edge) + u8::from(vertex) <= 1,
+        "{bits:#x} is valid for more than one index type"
+    );
+}
