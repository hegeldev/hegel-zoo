+use super::pbt::draw_cell;
+use hegel::generators;
+
+// A cell has 6 distinct vertexes (5 for pentagons), all surviving the
+// Display/FromStr and u64 roundtrips.
+#[hegel::test]
+fn pbt_vertexes_count_and_roundtrips(tc: hegel::TestCase) {
+    let cell = draw_cell(&tc);
+    let vertexes = cell.vertexes().collect::<Vec<_>>();
+    assert_eq!(vertexes.len(), if cell.is_pentagon() { 5 } else { 6 });
+
+    let unique = vertexes
+        .iter()
+        .copied()
+        .collect::<std::collections::HashSet<_>>();
+    assert_eq!(unique.len(), vertexes.len(), "duplicate vertexes");
+
+    let vertex = vertexes[tc
+        .draw(generators::integers::<usize>().max_value(vertexes.len() - 1))];
+    assert_eq!(vertex.to_string().parse::<VertexIndex>(), Ok(vertex));
+    assert_eq!(VertexIndex::try_from(u64::from(vertex)), Ok(vertex));
+    assert_eq!(vertex.owner().resolution(), cell.resolution());
+}
