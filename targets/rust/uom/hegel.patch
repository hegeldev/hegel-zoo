+#[cfg(all(feature = "f64", feature = "std"))]
+mod hegel_props {
+    use crate::tests::*;
+    use hegel::generators;
+    use hegel::TestCase;
+
+    mod m {
+        Q!(crate::tests, f64);
+    }
+
+    /// Property: quantity addition is a homomorphism over the underlying storage type —
+    /// wrapping two values in the same unit and adding the quantities gives exactly the same
+    /// result as adding the raw values first. Evidence: the `add` quickcheck test above.
+    #[hegel::test]
+    fn hegel_add_homomorphism(tc: TestCase) {
+        let a = tc.draw(generators::floats::<f64>());
+        let b = tc.draw(generators::floats::<f64>());
+
+        Test::assert_eq(
+            &m::Length::new::<meter>(a + b),
+            &(m::Length::new::<meter>(a) + m::Length::new::<meter>(b)),
+        );
+    }
+
+    /// Property: conversion through a unit with an affine (non-zero constant) conversion
+    /// round-trips: storing a temperature in degrees Fahrenheit and reading it back in degrees
+    /// Fahrenheit recovers the value up to floating point tolerance. Evidence: the
+    /// `from_base`/`to_base` quickcheck tests above exercise the kelvin <-> fahrenheit
+    /// conversions in each direction; this composes them.
+    ///
+    /// The tolerance is *absolute*, proportional to `epsilon * (|v| + constant)`: the
+    /// round-trip computes `((v + c) * k) / k - c`, so each rounding step contributes error
+    /// relative to `|v + c|`, not to `|v|`. Near `v = 0` the result is off by
+    /// ~`c * epsilon` (e.g. `-5.7e-14` for `v = 0`), which is inherent to the affine
+    /// conversion, not a `uom` bug — a ulps-relative comparison is an unsound property here
+    /// (the crate's own fahrenheit round-trip quickcheck cases are commented out).
+    #[hegel::test]
+    fn hegel_affine_unit_roundtrip(tc: TestCase) {
+        let v = tc.draw(generators::floats::<f64>());
+        let t = m::ThermodynamicTemperature::new::<degree_fahrenheit>(v);
+        let back = t.get::<degree_fahrenheit>();
+
+        if v.is_finite() {
+            let c: f64 = <degree_fahrenheit as Conversion<f64>>::constant(ConstantOp::Add).value();
+            let tolerance = 16.0 * f64::EPSILON * (v.abs() + c.abs());
+
+            assert!(
+                (back - v).abs() <= tolerance,
+                "round-trip {} -> {} exceeds tolerance {}",
+                v,
+                back,
+                tolerance
+            );
+        } else {
+            // NaN and infinities must round-trip exactly (NaN compares equal via `Test`).
+            assert!(Test::eq(&v, &back));
+        }
+    }
+
+    /// Stateful model test: a `Length` stored in base units must behave exactly like a plain
+    /// `f64` under the arithmetic-assignment operators and negation. Evidence: the
+    /// `add_assign`/`sub_assign`/`mul_assign`/`div_assign`/`rem_assign` quickcheck tests in
+    /// `tests/system.rs` (`non_big` module) and the `neg` quickcheck test (`signed` module)
+    /// each check a single operation; the model test checks arbitrary interleavings.
+    struct LengthModel {
+        subject: m::Length,
+        model: f64,
+    }
+
+    #[hegel::state_machine]
+    impl LengthModel {
+        #[rule]
+        fn add_assign(&mut self, tc: TestCase) {
+            let r = tc.draw(generators::floats::<f64>());
+            self.subject += m::Length::new::<meter>(r);
+            self.model += r;
+        }
+
+        #[rule]
+        fn sub_assign(&mut self, tc: TestCase) {
+            let r = tc.draw(generators::floats::<f64>());
+            self.subject -= m::Length::new::<meter>(r);
+            self.model -= r;
+        }
+
+        #[rule]
+        fn mul_assign(&mut self, tc: TestCase) {
+            let r = tc.draw(generators::floats::<f64>());
+            self.subject *= r;
+            self.model *= r;
+        }
+
+        #[rule]
+        fn div_assign(&mut self, tc: TestCase) {
+            // Division by zero is well-defined for `f64` (infinity/NaN), so zero is not
+            // excluded.
+            let r = tc.draw(generators::floats::<f64>());
+            self.subject /= r;
+            self.model /= r;
+        }
+
+        #[rule]
+        fn rem_assign(&mut self, tc: TestCase) {
+            let r = tc.draw(generators::floats::<f64>());
+            self.subject %= m::Length::new::<meter>(r);
+            self.model %= r;
+        }
+
+        #[rule]
+        fn neg(&mut self, _: TestCase) {
+            self.subject = -self.subject;
+            self.model = -self.model;
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: TestCase) {
+            assert!(
+                Test::eq(&self.model, &self.subject.get::<meter>()),
+                "quantity {:?} diverged from model {:?}",
+                self.subject.get::<meter>(),
+                self.model
+            );
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_length_behaves_like_f64_model(tc: TestCase) {
+        let machine = LengthModel {
+            subject: m::Length::new::<meter>(0.0),
+            model: 0.0,
+        };
+
+        hegel::stateful::machine(machine).run(tc);
+    }
+}
