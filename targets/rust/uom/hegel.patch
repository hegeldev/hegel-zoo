+#[cfg(all(feature = "f64", feature = "std"))]
+mod hegel_props {
+    use crate::tests::*;
+    use hegel::generators;
+
+    mod f {
+        Q!(crate::tests, f64);
+    }
+
+    /// Property: converting a value into a quantity and retrieving it in the same (non-base)
+    /// unit round-trips. Evidence: the `get` unit test above and the `from_base`/`change_base`
+    /// quickcheck tests in `tests/system.rs`. The `assume` mirrors the self-consistency guard
+    /// used by the `change_base` quickcheck test: it rejects values where the conversion
+    /// arithmetic itself overflows/loses precision in plain `f64`, which is a property of
+    /// floating point rather than of `uom`.
+    #[hegel::test]
+    fn hegel_new_get_same_unit_roundtrip(tc: hegel::TestCase) {
+        let v = tc.draw(generators::floats::<f64>());
+        let km: f64 = <kilometer as Conversion<f64>>::coefficient().value();
+
+        tc.assume(Test::approx_eq(&(v * km / km), &v));
+
+        let l = f::Length::new::<kilometer>(v);
+
+        Test::assert_approx_eq(&v, &l.get::<kilometer>());
+    }
+
+    /// Property: retrieving a quantity in the base unit scales the stored value by the unit's
+    /// conversion coefficient. Evidence: the `new`/`get` unit tests above and the `to_base`
+    /// quickcheck test in `tests/system.rs`.
+    #[hegel::test]
+    fn hegel_get_base_unit_scales_by_coefficient(tc: hegel::TestCase) {
+        let v = tc.draw(generators::floats::<f64>());
+        let km: f64 = <kilometer as Conversion<f64>>::coefficient().value();
+        let l = f::Length::new::<kilometer>(v);
+
+        Test::assert_approx_eq(&(v * km), &l.get::<meter>());
+    }
+
+    /// Property: `FromStr` handles arbitrary input without panicking; it must return `Ok` or
+    /// `Err`, never crash. Evidence: the `from_str` unit test above exercises the error
+    /// variants, and the `FromStr` implementation in `src/quantity.rs` documents the error
+    /// cases via `ParseQuantityError`.
+    #[hegel::test]
+    fn hegel_from_str_never_panics(tc: hegel::TestCase) {
+        let s: String = tc.draw(hegel::one_of!(
+            generators::text(),
+            // Strings that look like quantities to exercise the value/unit parsing paths.
+            generators::from_regex(
+                r"-?[0-9]{1,40}(\.[0-9]{1,20})?(E-?[0-9]{1,3})? {0,2}(m|km|meter|meters|kilometers|kg|K|°F)"
+            )
+            .fullmatch(true),
+        ));
+
+        let _ = s.parse::<f::Length>();
+        let _ = s.parse::<f::Mass>();
+    }
+
+    /// Property: formatting a quantity with `into_format_args` and parsing the result back
+    /// recovers the original quantity exactly (`f64`'s `Display` produces a shortest
+    /// round-trippable representation). Evidence: the `round_trip` unit test above, which
+    /// checks the single value `1.0`; this generalizes it to arbitrary values and both display
+    /// styles.
+    #[hegel::test]
+    fn hegel_display_parse_roundtrip(tc: hegel::TestCase) {
+        let v = tc.draw(generators::floats::<f64>());
+        let abbreviation = tc.draw(generators::booleans());
+        let style = if abbreviation {
+            DisplayStyle::Abbreviation
+        } else {
+            DisplayStyle::Description
+        };
+        let l = f::Length::new::<meter>(v);
+        let s = format!("{}", l.into_format_args(meter, style));
+        let parsed = s.parse::<f::Length>().expect("formatted quantity must parse");
+
+        Test::assert_eq(&l.get::<meter>(), &parsed.get::<meter>());
+    }
+
+    /// Property: `FromStr` accepts all three documented unit name forms (abbreviation,
+    /// singular and plural) for every unit, producing the quantity in that unit. Evidence: the
+    /// `FromStr` implementation in `src/quantity.rs` matches
+    /// `$abbreviation | $singular | $plural`, and the `from_str` unit test above checks a few
+    /// concrete instances.
+    #[hegel::test]
+    fn hegel_from_str_accepts_all_unit_name_forms(tc: hegel::TestCase) {
+        let v = tc.draw(generators::floats::<f64>());
+        let (name, is_km) = tc.draw(generators::sampled_from(vec![
+            ("m", false),
+            ("meter", false),
+            ("meters", false),
+            ("km", true),
+            ("kilometer", true),
+            ("kilometers", true),
+        ]));
+        let s = format!("{} {}", v, name);
+        let parsed = s.parse::<f::Length>().expect("quantity with known unit name must parse");
+        let expected = if is_km {
+            f::Length::new::<kilometer>(v)
+        } else {
+            f::Length::new::<meter>(v)
+        };
+
+        Test::assert_eq(&expected.get::<meter>(), &parsed.get::<meter>());
+    }
+}
