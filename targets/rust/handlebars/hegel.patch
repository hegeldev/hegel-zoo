 use handlebars::Handlebars;
 use handlebars::testing::TestHandlebars;
 
+use hegel::generators;
+use serde_json::json;
+
+/// Bodies that render identically whether invoked directly or through a
+/// partial: no surrounding whitespace (so standalone-partial trimming can't
+/// diverge the two), and only context-relative references.
+const PARTIAL_BODIES: &[&str] = &[
+    "{{a}}",
+    "{{b}}-{{a}}",
+    "{{#if a}}yes{{else}}no{{/if}}",
+    "static text",
+    "{{#each xs}}{{this}},{{/each}}",
+    "{{a}}{{b}}",
+];
+
+/// Including a registered partial with `{{> p}}` is transparent: rendering
+/// `{{> p}}` against some data equals rendering the partial's body directly
+/// against the same data. Oracle is the direct render of the same body.
+#[hegel::test]
+fn prop_partial_inline_equals_direct(tc: hegel::TestCase) {
+    let body = tc.draw(generators::sampled_from(PARTIAL_BODIES.to_vec()));
+    let a = tc.draw(generators::integers::<i64>());
+    let b = tc.draw(generators::integers::<i64>());
+    let data = json!({ "a": a, "b": b, "xs": [1, 2, 3] });
+
+    let mut hbs = Handlebars::new();
+    hbs.register("p", body);
+
+    let direct = hbs.render_template(body, &data);
+    let via_partial = hbs.render_template("{{> p}}", &data);
+
+    assert_eq!(
+        direct.is_ok(),
+        via_partial.is_ok(),
+        "ok/err diverged for body {body:?}"
+    );
+    if let (Ok(d), Ok(v)) = (&direct, &via_partial) {
+        assert_eq!(d, v, "partial inclusion diverged from direct render for {body:?}");
+    }
+}
