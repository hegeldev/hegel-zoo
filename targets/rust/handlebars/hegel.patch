+/// Bodies that render identically whether invoked directly or through a
+/// partial: no surrounding whitespace (so standalone-partial trimming can't
+/// diverge the two), and only context-relative references.
+const PARTIAL_BODIES: &[&str] = &[
+    "{{a}}",
