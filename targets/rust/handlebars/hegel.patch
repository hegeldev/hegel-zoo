+use hegel::generators;
+
+/// Handlebars-shaped token fragments: real tokens (`{{ }}`, `{{{ }}}`, blocks,
+/// comments, partials, subexpressions, paths, tildes) plus raw text. Joining a
+/// bounded random sequence of these produces "token soup" that stresses the
+/// pest parser and the renderer.
+const FRAGMENTS: &[&str] = &[
+    "{{", "}}", "{{{", "}}}", "{{#if x}}", "{{/if}}", "{{#each y}}", "{{/each}}",
+    "{{#with z}}", "{{/with}}", "{{#unless x}}", "{{/unless}}", "{{else}}",
+    "{{! comment }}", "{{!-- c --}}", "{{> p}}", "{{~", "~}}", "(not x)",
+    "(gt a b)", "a.b.c", "../x", "@index", "@root", "this", "x", "y", "z",
+    "&", "#", "/", "\\", " ", "\n", "\t", "\"", "'", "[", "]", "=", "|",
+];
+
+/// Draw a bounded token-soup template string. The fragment count is capped so
+/// nesting depth stays far below the stack-overflow threshold documented in the
+/// `#[ignore]`d reproducers below — this property is about *no panic on shallow
+/// garbage*, not about the deep-recursion abort.
+fn draw_token_soup(tc: &hegel::TestCase) -> String {
+    let n = tc.draw(generators::integers::<usize>().max_value(60));
+    let mut s = String::new();
+    for _ in 0..n {
+        let frag = tc.draw(generators::sampled_from(FRAGMENTS.to_vec()));
+        s.push_str(frag);
+    }
+    s
+}
+
+/// Template compilation / rendering must never panic on arbitrary
+/// Handlebars-shaped token soup: `render_template` returns `Ok` or `Err`, never
+/// aborts. Oracle-independent (a panic is self-evidently a bug).
+#[hegel::test]
+fn prop_compile_never_panics(tc: hegel::TestCase) {
+    let tpl = draw_token_soup(&tc);
+    let hbs = Handlebars::new();
+    // The value under test is that this call *returns* rather than panics.
+    let _ = hbs.render_template(&tpl, &json!({"x": 1, "y": [1, 2], "z": {"k": 1}, "a": 2, "b": 1}));
+}
+
+/// Rendering is deterministic: the same template + data + registry render to the
+/// same result (both the success value and the ok/err status), every time.
+#[hegel::test]
+fn prop_render_deterministic(tc: hegel::TestCase) {
+    let tpl = draw_token_soup(&tc);
+    let data = json!({"x": 1, "y": [1, 2, 3], "z": {"k": 1}, "a": 2, "b": 1});
+    let hbs = Handlebars::new();
+    let r1 = hbs.render_template(&tpl, &data);
+    let r2 = hbs.render_template(&tpl, &data);
+    assert_eq!(r1.is_ok(), r2.is_ok(), "ok/err status diverged for {tpl:?}");
+    if let (Ok(a), Ok(b)) = (&r1, &r2) {
+        assert_eq!(a, b, "rendering diverged for {tpl:?}");
+    }
+}
