--- a/tests/subexpression.rs
+++ b/tests/subexpression.rs
@@ -11,6 +11,155 @@ use handlebars::{
     ScopedJson,
 };
 
+
+use hegel::generators::{self, Generator};
+use hegel::{PrettyPrintable, PrintableGenerator};
+
+#[path = "util/nesting.rs"]
+mod nesting;
+
+/// Handlebars-shaped token fragments: real tokens (`{{ }}`, `{{{ }}}`, blocks,
+/// comments, partials, subexpressions, paths, tildes) plus raw text. A bounded
+/// sequence of these joined together is "token soup" that stresses the pest
+/// parser and the renderer at shallow nesting.
+const FRAGMENTS: &[&str] = &[
+    "{{", "}}", "{{{", "}}}", "{{#if x}}", "{{/if}}", "{{#each y}}", "{{/each}}",
+    "{{#with z}}", "{{/with}}", "{{#unless x}}", "{{/unless}}", "{{else}}",
+    "{{! comment }}", "{{!-- c --}}", "{{> p}}", "{{~", "~}}", "(not x)",
+    "(gt a b)", "a.b.c", "../x", "@index", "@root", "this", "x", "y", "z",
+    "&", "#", "/", "\\", " ", "\n", "\t", "\"", "'", "[", "]", "=", "|",
+];
+
+/// A bounded token-soup template: up to sixty fragments (first, the shrink
+/// target: the empty template) or short arbitrary text, concatenated. The
+/// fragment count keeps the nesting far below the stack-overflow threshold, so
+/// soup never aborts and renders in process.
+fn soup() -> impl PrintableGenerator<String> + Send + Sync + 'static {
+    generators::vecs(hegel::one_of!(
+        generators::sampled_from(FRAGMENTS).map(String::from),
+        generators::text().max_size(4),
+    ))
+    .max_size(60)
+    .map(|pieces: Vec<String>| pieces.concat())
+}
+
+/// The input to `prop_compile_never_panics`: shallow token soup (first, the
+/// shrink target, rendered in process) or a deeply nested template that may
+/// overflow the stack (rendered in a child process). The deep alternative is a
+/// few percent of cases, so the abort is intermittent.
+#[derive(Debug, Clone, PartialEq, PrettyPrintable)]
+enum CompileCase {
+    Soup(String),
+    Deep(nesting::Nesting),
+}
+
+fn compile_cases() -> impl PrintableGenerator<CompileCase> + Send + Sync + 'static {
+    nesting::either(
+        2,
+        soup().map(CompileCase::Soup).boxed_printable(),
+        nesting::wide_nestings().map(CompileCase::Deep).boxed_printable(),
+    )
+}
+
+/// Template compilation / rendering must never panic on arbitrary
+/// Handlebars-shaped input: `render_template` returns `Ok` or `Err`, never
+/// aborts. Oracle-independent (a panic or a process abort is self-evidently a
+/// bug). The deep-nesting alternative draws depths straddling the overflow
+/// threshold by default (handlebars/1), so this property reaches the abort and is
+/// a declared expected failure; the abort is a few percent of cases, so the
+/// property is intermittent. Under `HEGEL_NO_KNOWN=1` the depths stay below the
+/// threshold and every case returns.
+#[hegel::test]
+fn prop_compile_never_panics(tc: hegel::TestCase) {
+    let case = tc.draw(compile_cases());
+    let hbs = Handlebars::new();
+    let data = json!({"x": 1, "y": [1, 2], "z": {"k": 1}, "a": 2, "b": 1});
+    match case {
+        // shallow soup: the value under test is that this call returns rather
+        // than panics (a catchable panic fails the property in process)
+        CompileCase::Soup(tpl) => {
+            let _ = hbs.render_template(&tpl, &data);
+        }
+        // deep nesting: rendered in a child, since a stack overflow aborts the
+        // whole process and cannot be caught
+        CompileCase::Deep(n) => match nesting::render_in_child(&n) {
+            nesting::Rendered::Returned => {}
+            other => panic!("handlebars/1: deep nesting {n:?} did not return: {other:?}"),
+        },
+    }
+}
+
+/// Rendering is deterministic: the same template + data + registry render to the
+/// same result (both the success value and the ok/err status), every time. Drawn
+/// over shallow token soup, which never aborts.
+#[hegel::test]
+fn prop_render_deterministic(tc: hegel::TestCase) {
+    let tpl = tc.draw(soup());
+    let data = json!({"x": 1, "y": [1, 2, 3], "z": {"k": 1}, "a": 2, "b": 1});
+    let hbs = Handlebars::new();
+    let r1 = hbs.render_template(&tpl, &data);
+    let r2 = hbs.render_template(&tpl, &data);
+    assert_eq!(r1.is_ok(), r2.is_ok(), "ok/err status diverged for {tpl:?}");
+    if let (Ok(a), Ok(b)) = (&r1, &r2) {
+        assert_eq!(a, b, "rendering diverged for {tpl:?}");
+    }
+}
+
+
+
+// ---------------------------------------------------------------------------
+// KNOWN BUG (process-aborting): deeply nested templates overflow the stack.
+//
+// handlebars renders and parses recursively with no depth limit, so a template
+// nested past a few hundred levels overflows the thread stack and aborts the
+// whole process (SIGABRT, "thread has overflowed its stack") rather than
+// returning a RenderError/TemplateError. On the default 2 MiB libtest worker
+// stack the thresholds are roughly:
+//   * nested `{{#if}}` blocks   -> render-time overflow  around depth ~400
+//   * nested `(not ...)` subexprs -> compile-time overflow around depth ~400
+//   * nested `{{#if}}` opens (no closes) -> parse-time overflow around ~1600
+//
+// Because a stack overflow aborts the process, a normally-failing test would
+// take the whole suite down with it and leaves no hegel counterexample. These
+// reproducers are therefore #[ignore]d. Run one explicitly to observe the abort:
+//     cargo test --test subexpression -- --ignored deep_nested_if_render
+//
+// Code path: render.rs `Template::render` / helper `t.render(...)` recursion
+// (helpers/helper_if.rs), and template.rs `compile2` + pest grammar recursion
+// on `subexpression` / `helper_block`.
+// ---------------------------------------------------------------------------
+
+#[test]
+#[ignore = "known bug: stack overflow aborts the process on deep block nesting"]
+fn deep_nested_if_render() {
+    let depth = 5000;
+    let tpl = format!("{}y{}", "{{#if x}}".repeat(depth), "{{/if}}".repeat(depth));
+    let hbs = Handlebars::new();
+    // Aborts with a stack overflow instead of returning; must not reach here.
+    let _ = hbs.render_template(&tpl, &json!({"x": true}));
+}
+
+#[test]
+#[ignore = "known bug: stack overflow aborts the process on deep subexpression nesting"]
+fn deep_nested_subexpr_compile() {
+    let depth = 5000;
+    let mut hbs = Handlebars::new();
+    let tpl = format!("{{{{#if {}x{}}}}}y{{{{/if}}}}", "(not ".repeat(depth), ")".repeat(depth));
+    // Aborts during template compilation.
+    let _ = hbs.register_template_string("deep", &tpl);
+}
+
+#[test]
+#[ignore = "known bug: stack overflow aborts the process while parsing deeply nested opens"]
+fn deep_nested_open_parse() {
+    let depth = 50000;
+    let mut hbs = Handlebars::new();
+    let tpl = "{{#if x}}".repeat(depth);
+    // Even though this is ultimately a syntax error, the parser overflows the
+    // stack before it can return the TemplateError.
+    let _ = hbs.register_template_string("deep", &tpl);
+}
