+    let path = segments.join(".");
+    let tpl = format!("[{{{{{path}}}}}]");
+
+    let hbs = Handlebars::new();
+    let out = hbs
+        .render_template(&tpl, &json!({ "present": 1 }))
+        .expect("missing path should render empty in non-strict mode, not error");
+    assert_eq!(out, "[]", "missing path did not render empty for {tpl:?}");
+}
