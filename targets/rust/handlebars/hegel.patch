+/// Segment names that are absent from the property's data object `{present: 1}`.
+const MISSING_SEGMENTS: &[&str] = &["a", "b", "foo", "missing", "x", "deep", "bar", "qq"];
+
+/// Path resolution inside `{{#each}}`: `../b` climbs to the enclosing scope and
+/// `this` / the element render consistently. Checked against a hand model that
+/// resolves the paths the same way. `b` is drawn from `[A-Za-z0-9]*` so the
+/// model needn't reimplement HTML escaping (the point here is path resolution).
+#[hegel::test]
+fn prop_relative_path_resolution(tc: hegel::TestCase) {
+    let (items, b) = tc.draw(hegel::tuples!(
+        generators::vecs(generators::integers::<i64>()).max_size(20),
+        generators::from_regex("[A-Za-z0-9]*").fullmatch(true)
+    ));
+
+    let hbs = Handlebars::new();
+    let out = hbs
+        .render_template(
+            "{{#each a}}{{../b}}-{{this}}@{{@index}};{{/each}}",
+            &json!({ "a": items.clone(), "b": b }),
+        )
+        .expect("relative path render should not error");
+
+    let expected: String = items
+        .iter()
+        .enumerate()
+        .map(|(i, v)| format!("{b}-{v}@{i};"))
