@@ -0,0 +1,278 @@
+//! Shared generators and the child-process runner for the deep-nesting shape of
+//! handlebars/1, used by the wide property `prop_compile_never_panics` in
+//! `tests/subexpression.rs` and by the narrow property in `tests/hegel_shapes.rs`.
+//!
+//! handlebars parses, compiles and renders recursively with no depth limit, so a
+//! template nested past a few hundred levels overflows the thread stack and
+//! aborts the whole process (SIGABRT) rather than returning a
+//! TemplateError/RenderError. An abort cannot be caught, so a case that may
+//! reach the overflow is rendered in a *child process* (this test binary
+//! re-executed with `--exact <entry> --nocapture --test-threads=1` under
+//! `sh -c 'ulimit -v 2200000 && exec "$0" "$@"'`, the case passed in an
+//! environment variable, a deadline, and the verdict cached per case since the
+//! shrinker revisits the same few cases many times). The three entry points that
+//! overflow — nested `{{#if}}` blocks at render, nested `(not ...)`
+//! subexpressions at compile, unclosed `{{#if}}` opens at parse — are all reached
+//! through `render_template`, which parses, compiles and then renders.
+//!
+//! The shapes are drawn by default (known-bug gates off, 2026-09-24), so the
+//! properties reach the abort and are the declared expected failures;
+//! `HEGEL_NO_KNOWN=1` (read once, `known_shapes`) draws the neighbouring region
+//! below the overflow threshold instead, where every entry point returns.
+#![allow(dead_code)]
+
+use std::collections::HashMap;
+use std::process::{Command, Stdio};
+use std::sync::{LazyLock, Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+use hegel::generators::{self, BoxedPrintableGenerator, Generator};
+use hegel::{PrettyPrintable, PrintableGenerator};
+
+/// Whether the generators draw the abort shape (depths above the overflow
+/// threshold). On by default; `HEGEL_NO_KNOWN=1` draws the shallow region below
+/// the threshold instead, for a run that looks past handlebars/1.
+pub fn known_shapes() -> bool {
+    static KNOWN: OnceLock<bool> = OnceLock::new();
+    *KNOWN.get_or_init(|| std::env::var_os("HEGEL_NO_KNOWN").map_or(true, |v| v != "1"))
+}
+
+// ---------------------------------------------------------------------------
+// The nesting case, as data
+// ---------------------------------------------------------------------------
+
+/// Which of handlebars/1's three entry points a case overflows.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PrettyPrintable)]
+pub enum Shape {
+    /// `{{#if NAME}}`*d + filler + `{{/if}}`*d: closed nested blocks that
+    /// overflow at render (~300 deep on the 2 MiB test-thread stack).
+    IfRender,
+    /// `{{#if (not (not … NAME …))}}filler{{/if}}`: nested subexpressions that
+    /// overflow at compile (~300 deep).
+    NotCompile,
+    /// `{{#if NAME}}`*d with no closes: unclosed opens that overflow at parse
+    /// (~1150 deep) before the syntax error can be returned.
+    IfOpenParse,
+}
+
+const SHAPES: &[Shape] = &[Shape::IfRender, Shape::NotCompile, Shape::IfOpenParse];
+
+/// A deeply nested template: an entry point, a nesting depth, an element/variable
+/// name (which the child's data makes truthy so the render actually recurses),
+/// and a little filler text around the nesting.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, PrettyPrintable)]
+pub struct Nesting {
+    pub shape: Shape,
+    pub depth: usize,
+    pub name: String,
+    pub filler: String,
+}
+
+impl Nesting {
+    /// The template string this case renders.
+    pub fn template(&self) -> String {
+        let name = &self.name;
+        let filler = &self.filler;
+        let d = self.depth;
+        match self.shape {
+            Shape::IfRender => {
+                let open = format!("{{{{#if {name}}}}}"); // {{#if NAME}}
+                format!("{}{filler}{}", open.repeat(d), "{{/if}}".repeat(d))
+            }
+            Shape::NotCompile => {
+                let inner = format!("{}{name}{}", "(not ".repeat(d), ")".repeat(d));
+                let open = format!("{{{{#if {inner}}}}}"); // {{#if (not … NAME …)}}
+                format!("{open}{filler}{}", "{{/if}}")
+            }
+            Shape::IfOpenParse => {
+                let open = format!("{{{{#if {name}}}}}"); // {{#if NAME}}
+                format!("{}{filler}", open.repeat(d))
+            }
+        }
+    }
+
+    fn encode(&self) -> String {
+        format!("{};{};{};{}", self.shape as u8, self.depth, self.name, self.filler)
+    }
+
+    fn decode(text: &str) -> Nesting {
+        let f: Vec<&str> = text.splitn(4, ';').collect();
+        let shape = match f[0] {
+            "0" => Shape::IfRender,
+            "1" => Shape::NotCompile,
+            _ => Shape::IfOpenParse,
+        };
+        Nesting {
+            shape,
+            depth: f[1].parse().expect("a numeric depth"),
+            name: f[2].to_string(),
+            filler: f[3].to_string(),
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Generators
+// ---------------------------------------------------------------------------
+
+pub type Gen<T> = BoxedPrintableGenerator<'static, T>;
+
+/// `other` with probability `pct` percent, else `plain`, the shrink target
+/// (`weighted_booleans` shrinks to false).
+pub fn either<T>(pct: u32, plain: Gen<T>, other: Gen<T>) -> impl PrintableGenerator<T> + Send + Sync + 'static
+where
+    T: PrettyPrintable + Clone + Send + Sync + 'static,
+{
+    generators::weighted_booleans(pct as f64 / 100.0)
+        .flat_map(move |o| if o { other.clone() } else { plain.clone() })
+}
+
+/// A non-empty lowercase name, so `{{#if NAME}}` and `(not NAME)` parse.
+fn names() -> impl PrintableGenerator<String> + Send + Sync + 'static {
+    generators::text().min_size(1).max_size(6).alphabet("abcdefghijklmnopqrstuvwxyz")
+}
+
+/// Short filler text drawn around the nesting.
+fn fillers() -> impl PrintableGenerator<String> + Send + Sync + 'static {
+    generators::text().max_size(6).alphabet("abcdefghijklmnopqrstuvwxyz0123456789 ")
+}
+
+/// A nesting whose depth range is `band(shape)` per entry point.
+fn nesting_over(band: fn(Shape) -> (usize, usize)) -> impl PrintableGenerator<Nesting> + Send + Sync + 'static {
+    generators::sampled_from(SHAPES)
+        .flat_map(move |shape| {
+            let (lo, hi) = band(shape);
+            hegel::tuples!(
+                generators::just(shape),
+                generators::integers::<usize>().min_value(lo).max_value(hi),
+                names(),
+                fillers()
+            )
+        })
+        .map(|(shape, depth, name, filler)| Nesting { shape, depth, name, filler })
+}
+
+/// Depths guaranteed above the overflow threshold of each entry point (measured:
+/// render/compile abort by ~300, parse by ~1150).
+fn abort_band(shape: Shape) -> (usize, usize) {
+    match shape {
+        Shape::IfRender | Shape::NotCompile => (400, 2000),
+        Shape::IfOpenParse => (1300, 2000),
+    }
+}
+
+/// Depths comfortably below the overflow threshold: the neighbouring region that
+/// returns normally, drawn under `HEGEL_NO_KNOWN=1`.
+fn safe_band(shape: Shape) -> (usize, usize) {
+    match shape {
+        Shape::IfRender | Shape::NotCompile => (1, 200),
+        Shape::IfOpenParse => (1, 1000),
+    }
+}
+
+/// Depths straddling the threshold (1..2000): some cases overflow, some return —
+/// the intermittent shape the wide property draws.
+fn straddle_band(_shape: Shape) -> (usize, usize) {
+    (1, 2000)
+}
+
+/// The narrow property's cases: above the threshold by default (a deterministic
+/// abort), below it under `HEGEL_NO_KNOWN=1` (a normal return).
+pub fn deterministic_nestings() -> impl PrintableGenerator<Nesting> + Send + Sync + 'static {
+    nesting_over(if known_shapes() { abort_band } else { safe_band })
+}
+
+/// The wide property's deep alternative: depths straddling the threshold by
+/// default (an intermittent abort), below it under `HEGEL_NO_KNOWN=1`.
+pub fn wide_nestings() -> impl PrintableGenerator<Nesting> + Send + Sync + 'static {
+    nesting_over(if known_shapes() { straddle_band } else { safe_band })
+}
+
+// ---------------------------------------------------------------------------
+// Rendering in a child process
+// ---------------------------------------------------------------------------
+
+/// How a render that may overflow the stack ended.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Rendered {
+    /// `render_template` returned (Ok or Err) without overflowing.
+    Returned,
+    /// The child died of a signal (SIGABRT/SIGSEGV): the stack overflow of
+    /// handlebars/1.
+    Aborted,
+    /// The child did not finish within the deadline.
+    Hung,
+    /// The child exited non-zero without the done marker (a catchable panic):
+    /// its first `panicked at` line.
+    Panicked(String),
+}
+
+const CHILD_CASE: &str = "HANDLEBARS_NESTING_CASE";
+const CHILD_ENTRY: &str = "nesting::renders_the_nesting_case_named_in_the_environment";
+const DONE: &str = "@@NESTING_DONE@@";
+
+/// Renders `n` in a child process (this test binary re-executed under a capped
+/// address space, with the case in an environment variable and a deadline),
+/// because a stack overflow aborts the whole process and cannot be caught.
+/// Verdicts are cached: the shrinker revisits the same few cases many times.
+pub fn render_in_child(n: &Nesting) -> Rendered {
+    static VERDICTS: LazyLock<Mutex<HashMap<Nesting, Rendered>>> = LazyLock::new(|| Mutex::new(HashMap::new()));
+    if let Some(verdict) = VERDICTS.lock().unwrap().get(n) {
+        return verdict.clone();
+    }
+    let exe = std::env::current_exe().expect("the test binary's path");
+    let mut child = Command::new("sh")
+        .arg("-c")
+        .arg("ulimit -v 2200000 && exec \"$0\" \"$@\"")
+        .arg(&exe)
+        .args(["--exact", CHILD_ENTRY, "--nocapture", "--test-threads=1"])
+        .env(CHILD_CASE, n.encode())
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawning the test binary");
+    let deadline = Instant::now() + Duration::from_secs(20);
+    let mut hung = false;
+    loop {
+        match child.try_wait().expect("waiting for the child") {
+            Some(_) => break,
+            None if Instant::now() >= deadline => {
+                let _ = child.kill();
+                hung = true;
+                break;
+            }
+            None => std::thread::sleep(Duration::from_millis(5)),
+        }
+    }
+    let output = child.wait_with_output().expect("collecting the child's output");
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    let verdict = if hung {
+        Rendered::Hung
+    } else if stdout.contains(DONE) {
+        Rendered::Returned
+    } else if output.status.code().is_none() {
+        // terminated by a signal: the stack overflow's SIGABRT (or SIGSEGV)
+        Rendered::Aborted
+    } else {
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        let line = stderr.lines().find(|l| l.contains("panicked at")).unwrap_or("no done marker");
+        Rendered::Panicked(line.to_string())
+    };
+    VERDICTS.lock().unwrap().insert(n.clone(), verdict.clone());
+    verdict
+}
+
+/// The child side of `render_in_child`: with `HANDLEBARS_NESTING_CASE` set,
+/// renders that case (which may overflow the stack and abort) and prints the done
+/// marker if it returns; a plain pass otherwise (when run as an ordinary test).
+#[test]
+fn renders_the_nesting_case_named_in_the_environment() {
+    let Ok(case) = std::env::var(CHILD_CASE) else { return };
+    let n = Nesting::decode(&case);
+    let hbs = handlebars::Handlebars::new();
+    let mut data = serde_json::Map::new();
+    data.insert(n.name.clone(), serde_json::Value::Bool(true));
+    let _ = hbs.render_template(&n.template(), &serde_json::Value::Object(data));
+    println!("{DONE}");
+}
