+/// Characters at the HTML encode-set boundary (`< > & " ' ` =`) and adjacent
+/// punctuation, which the autoescape contract must map to entities.
+const SPECIALS: &[char] = &['<', '>', '&', '"', '\'', '`', '=', '/', '\\', '{', '}'];
+
+/// A character: an HTML-special (first, weighted in), printable ASCII, or an
+/// arbitrary non-ASCII scalar value.
+fn html_chars() -> impl PrintableGenerator<char> {
+    hegel::one_of!(
+        generators::sampled_from(SPECIALS),
+        generators::integers::<u32>().max_value(0x7F).map(|v| char::from_u32(v).unwrap_or('a')),
+        generators::integers::<u32>()
+            .min_value(0x80)
+            .max_value(0x10_FFFF)
+            .map(|v| char::from_u32(v).unwrap_or('\u{FFFD}')),
+    )
+}
+
+/// A string that heavily samples the HTML encode-set boundary, mixed with
+/// arbitrary ASCII and Unicode codepoints.
+fn html_strings() -> impl PrintableGenerator<String> {
+    generators::vecs(html_chars()).max_size(40).map(|cs: Vec<char>| cs.into_iter().collect())
+}
+
+/// Autoescape safety (XSS core contract): rendering an arbitrary string via a
+/// double-stache `{{ }}` expression must never emit a raw `< > " ' ` =` — the
+/// default HTML escape maps every one of them to an entity. Oracle-independent:
+/// the presence of any of those characters in the output is a self-evident
+/// violation.
+#[hegel::test]
+fn prop_autoescape_no_raw_specials(tc: hegel::TestCase) {
+    let s = tc.draw(html_strings());
+    let hbs = Handlebars::new();
+    let out = hbs
+        .render_template("{{this}}", &Json::String(s.clone()))
+        .expect("rendering a plain string should never error");
+    for bad in ['<', '>', '"', '\'', '`', '='] {
+        assert!(
+            !out.contains(bad),
+            "raw {bad:?} leaked into autoescaped output {out:?} from input {s:?}"
+        );
+    }
+}
+
+/// Triple-stache `{{{ }}}` is verbatim: rendering a string through it returns
+/// the string unchanged. Oracle-independent (we hold the input).
+#[hegel::test]
+fn prop_triple_stache_verbatim(tc: hegel::TestCase) {
+    let s = tc.draw(html_strings());
+    let hbs = Handlebars::new();
+    let out = hbs
+        .render_template("{{{this}}}", &Json::String(s.clone()))
+        .expect("rendering a plain string should never error");
+    assert_eq!(out, s, "triple-stache should reproduce the input verbatim");
+}
