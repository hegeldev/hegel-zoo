diff --git a/tests/hegel_shapes.rs b/tests/hegel_shapes.rs
new file mode 100644
index 0000000..266f5dd
--- /dev/null
+++ b/tests/hegel_shapes.rs
@@ -0,0 +1,32 @@
+//! Narrow property for handlebars/1: deeply nested templates overflow the stack
+//! and abort the process. Its region generator and the child-process runner are
+//! shared with the wide property in `tests/subexpression.rs` (see
+//! `tests/util/nesting.rs`).
+
+extern crate handlebars;
+
+#[path = "util/nesting.rs"]
+mod nesting;
+
+/// Deeply nested templates overflow the stack and abort the whole process
+/// (SIGABRT), there being no recursion-depth limit in handlebars' parse, compile
+/// or render (handlebars/1). The render runs in a child process, so the abort is
+/// observed as the child's death rather than taking the test binary down; the
+/// verdict is the child's fate. By default the depth is drawn above the overflow
+/// threshold for each of the three entry points (`{{#if}}` blocks at render,
+/// `(not …)` subexpressions at compile, unclosed `{{#if}}` opens at parse), with
+/// random names and filler, so every case aborts and this is a deterministic
+/// expected failure. Under `HEGEL_NO_KNOWN=1` the depth stays below the
+/// threshold and every case returns, so the property passes.
+#[hegel::test]
+fn deeply_nested_templates_abort_the_process(tc: hegel::TestCase) {
+    let n = tc.draw(nesting::deterministic_nestings());
+    match nesting::render_in_child(&n) {
+        // below the threshold (HEGEL_NO_KNOWN=1): no overflow, a normal return
+        nesting::Rendered::Returned => {}
+        nesting::Rendered::Aborted => {
+            panic!("handlebars/1: {n:?} overflowed the stack and aborted the process")
+        }
+        other => panic!("handlebars/1: {n:?} did not return: {other:?}"),
+    }
+}
