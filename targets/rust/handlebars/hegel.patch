 use handlebars::*;
 use serde_json::json;
 
+use hegel::generators::{self, Generator};
+use hegel::PrintableGenerator;
+use serde_json::Value as Json;
+
+/// A JSON value spanning every arm of handlebars' truthiness rule (null, bool,
+/// number, string, array, object), simplest first so shrinking lands on `null`.
+/// Numbers are integers so the `is_normal` truthiness edge (0 is falsy, non-zero
+/// truthy) is exercised without float subnormal ambiguity.
+fn json_values() -> impl PrintableGenerator<Json> {
+    hegel::one_of!(
+        generators::just(Json::Null),
+        generators::booleans().map(Json::Bool),
+        generators::integers::<i64>().map(Json::from),
+        generators::text().max_size(8).map(Json::String),
+        generators::vecs(generators::integers::<i64>()).max_size(4).map(Json::from),
+        generators::vecs(generators::text().min_size(1).max_size(4))
+            .max_size(3)
+            .unique(true)
+            .map(|keys: Vec<String>| Json::Object(keys.into_iter().map(|k| (k, Json::from(1))).collect())),
+    )
+    .print_as_debug()
+}
+
+/// Reference model of handlebars' truthiness (default `includeZero = false`),
+/// transcribed from `json::value::is_truthy`.
+fn model_truthy(v: &Json) -> bool {
+    match v {
+        Json::Bool(b) => *b,
+        Json::Number(n) => n.as_f64().is_some_and(f64::is_normal),
+        Json::Null => false,
+        Json::String(s) => !s.is_empty(),
+        Json::Array(a) => !a.is_empty(),
+        Json::Object(o) => !o.is_empty(),
+    }
+}
+
+/// `{{#if}}` selects its main block iff the parameter is truthy, matching the
+/// documented truthiness model.
+#[hegel::test]
+fn prop_if_matches_truthiness_model(tc: hegel::TestCase) {
+    let v = tc.draw(json_values());
+    let hbs = Handlebars::new();
+    let out = hbs
+        .render_template("{{#if x}}Y{{else}}N{{/if}}", &json!({ "x": v }))
+        .expect("if/else over a value should not error");
+    let expected = if model_truthy(&v) { "Y" } else { "N" };
+    assert_eq!(out, expected, "if mismatch for {v:?}");
+}
+
+/// `{{#unless}}` is the exact complement of `{{#if}}` for the same value:
+/// swapping the two branches under `if` must reproduce `unless`. Sibling-API
+/// consistency check.
+#[hegel::test]
+fn prop_unless_complements_if(tc: hegel::TestCase) {
+    let v = tc.draw(json_values());
+    let hbs = Handlebars::new();
+    let unless_out = hbs
+        .render_template("{{#unless x}}Y{{else}}N{{/unless}}", &json!({ "x": v.clone() }))
+        .expect("unless should not error");
+    // if with branches swapped
+    let if_out = hbs
+        .render_template("{{#if x}}N{{else}}Y{{/if}}", &json!({ "x": v }))
+        .expect("if should not error");
+    assert_eq!(unless_out, if_out, "unless is not the complement of if");
+}
+
+/// `{{#each}}` over an array visits every element in order, exposing `@index`
+/// and `this`. Checked against a hand-built model.
+#[hegel::test]
+fn prop_each_index_matches_model(tc: hegel::TestCase) {
+    let items = tc.draw(generators::vecs(generators::integers::<i64>()).max_size(30));
+    let hbs = Handlebars::new();
+    let out = hbs
+        .render_template(
+            "{{#each xs}}{{@index}}={{this}};{{/each}}",
+            &json!({ "xs": items.clone() }),
+        )
+        .expect("each over an array should not error");
+    let expected: String = items
+        .iter()
+        .enumerate()
+        .map(|(i, v)| format!("{i}={v};"))
+        .collect();
+    assert_eq!(out, expected, "each/@index mismatch for {items:?}");
+}
+
+/// `{{lookup arr i}}` indexes an array by a numeric literal, yielding the
+/// element (rendered) or empty when out of bounds in non-strict mode. Oracle is
+/// Rust slice indexing.
+#[hegel::test]
+fn prop_lookup_matches_model(tc: hegel::TestCase) {
+    let (items, i) = tc.draw(hegel::tuples!(
+        generators::vecs(generators::integers::<i64>()).max_size(20),
+        generators::integers::<usize>().max_value(25)
+    ));
+    let hbs = Handlebars::new();
+    let tpl = format!("{{{{lookup arr {i}}}}}");
+    let out = hbs
+        .render_template(&tpl, &json!({ "arr": items.clone() }))
+        .expect("lookup should not error in non-strict mode");
+    let expected = items.get(i).map(i64::to_string).unwrap_or_default();
+    assert_eq!(out, expected, "lookup mismatch for {items:?} index {i}");
+}
+
