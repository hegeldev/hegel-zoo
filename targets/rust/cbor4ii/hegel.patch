index a16d567..e82f6ad 100644
--- a/tests/serde_cbor.rs
+++ b/tests/serde_cbor.rs
@@ -230,3 +230,163 @@ fn serde() {
 
     assert_eq!(value, data_de_value);
 }
+
+// ===========================================================================
+// Property-based tests (hegel): differential against serde_cbor
+// ===========================================================================
+//
+// README: "This library is intended to be compatible with serde_cbor" --
+// serde_cbor is the compatibility oracle, in both directions, over data
+// shapes the README does not call out as intentionally different (the unit
+// type and packed mode are excluded).
+mod hegel_props {
+    use std::collections::BTreeMap;
+    use serde::{ Serialize, Deserialize };
+    use cbor4ii::serde::to_vec;
+    use hegel::generators;
+    use hegel::Generator;
+
+    #[derive(Serialize, Deserialize, Debug, PartialEq, Clone)]
+    enum CompatEnum {
+        Unit,
+        NewType(i64),
+        Tuple(String, bool),
+        Struct { x: i32, y: String },
+    }
+
+    #[derive(Serialize, Deserialize, Debug, PartialEq, Clone, hegel::PrettyPrintable)]
+    struct Compat {
+        u: u64,
+        i: i64,
+        b: bool,
+        ch: char,
+        s: String,
+        #[serde(with = "serde_bytes")]
+        bytes: Vec<u8>,
+        // NaN is excluded because the test's oracle (derived PartialEq) cannot
+        // compare it, not because of any library contract.
+        f: f64,
+        list: Vec<i32>,
+        map: BTreeMap<String, u32>,
+        opt: Option<String>,
+        #[pretty(debug)]
+        en: CompatEnum,
+        tup: (u8, String),
+    }
+
+    fn arb_char(tc: &hegel::TestCase) -> char {
+        let n = tc.draw(hegel::one_of!(
+            generators::integers::<u32>().max_value(0x7F),
+            generators::integers::<u32>().min_value(0x80).max_value(0xFFFF),
+            generators::integers::<u32>().min_value(0x1_0000).max_value(0x10_FFFF),
+        ));
+        char::from_u32(n).unwrap_or('\u{FFFD}')
+    }
+
+    /// True iff serde_cbor would encode this f64 in a narrower width (f16/f32).
+    fn narrowable(f: f64) -> bool {
+        (f as f32) as f64 == f
+    }
+
+    /// An f64 that serde_cbor will encode with the full F64 marker.
+    ///
+    /// KNOWN BUG EXCLUSION: serde_cbor encodes floats in the shortest lossless
+    /// width, and cbor4ii's typed `deserialize_f64` rejects F16/F32-encoded
+    /// floats; see `prop_cbor4ii_decodes_serde_cbor_float_known_bug` below.
+    fn arb_wide_f64(tc: &hegel::TestCase) -> f64 {
+        let f = tc.draw(generators::floats::<f64>().allow_nan(false));
+        let f = if narrowable(f) {
+            if f == 0.0 || !f.is_finite() {
+                1.0e-300 // below the f32 range: never narrowable
+            } else {
+                // perturb the low mantissa bits out of f32 precision
+                f * (1.0 + f64::EPSILON)
+            }
+        } else {
+            f
+        };
+        // the transform above must have produced a non-narrowable float,
+        // otherwise this test silently loses its float coverage
+        assert!(!narrowable(f), "de-narrowing failed for {:?}", f);
+        f
+    }
+
+    #[hegel::composite]
+    fn arb_compat(tc: &hegel::TestCase) -> Compat {
+        Compat {
+            u: tc.draw(generators::integers::<u64>()),
+            i: tc.draw(generators::integers::<i64>()),
+            b: tc.draw(generators::booleans()),
+            ch: arb_char(&tc),
+            s: tc.draw(generators::text().max_size(32)),
+            bytes: tc.draw(generators::binary().max_size(32)),
+            f: arb_wide_f64(&tc),
+            list: tc.draw(generators::vecs(generators::integers::<i32>()).max_size(8)),
+            map: tc.draw(generators::hashmaps(
+                    generators::text().max_size(8),
+                    generators::integers::<u32>(),
+                ).max_size(4))
+                .into_iter().collect(),
+            opt: tc.draw(generators::optional(generators::text().max_size(8))),
+            en: match tc.draw(generators::integers::<u8>().max_value(3)) {
+                0 => CompatEnum::Unit,
+                1 => CompatEnum::NewType(tc.draw(generators::integers::<i64>())),
+                2 => CompatEnum::Tuple(tc.draw(generators::text().max_size(8)),
+                                       tc.draw(generators::booleans())),
+                _ => CompatEnum::Struct {
+                    x: tc.draw(generators::integers::<i32>()),
+                    y: tc.draw(generators::text().max_size(8)),
+                },
+            },
+            tup: (
+                tc.draw(generators::integers::<u8>()),
+                tc.draw(generators::text().max_size(8)),
+            ),
+        }
+    }
+
+    /// serde_cbor decodes what cbor4ii encodes.
+    #[hegel::test]
+    fn prop_serde_cbor_decodes_cbor4ii_encoding(tc: hegel::TestCase) {
+        let value = tc.draw((arb_compat()).print_as_debug());
+
+        let buf = to_vec(Vec::new(), &value).unwrap();
+        let back: Compat = serde_cbor::from_slice(&buf).unwrap_or_else(|err| {
+            panic!("serde_cbor failed: {:?} value: {:?} buf: {:?}", err, value, buf)
+        });
+        assert_eq!(back, value, "buf: {:?}", buf);
+    }
+
+    /// KNOWN FAILURE (compatibility bug): serde_cbor encodes every f64 in the
+    /// shortest lossless float width (0.0 -> 0xf9 0x00 0x00, an f16), which RFC
+    /// 8949 treats as an equivalent representation. cbor4ii's typed
+    /// `deserialize_f64` (src/serde/de.rs -> f64::decode in src/core/dec.rs)
+    /// accepts only the F64 (0xfb) marker, so cbor4ii fails to decode most
+    /// serde_cbor-encoded floats with `Mismatch { name: "f64", found: 249 }`,
+    /// despite the README's serde_cbor-compatibility claim (float width is not
+    /// one of the documented intentional differences). Minimal reproducer:
+    /// `cbor4ii::serde::from_slice::<f64>(&serde_cbor::to_vec(&0.0f64)?)`.
+    #[hegel::test]
+    fn prop_cbor4ii_decodes_serde_cbor_float_known_bug(tc: hegel::TestCase) {
+        // deterministic: every f32-representable float is narrowed by serde_cbor
+        let value = f64::from(tc.draw(generators::floats::<f32>().allow_nan(false)));
+
+        let buf = serde_cbor::to_vec(&value).unwrap();
+        let back: f64 = cbor4ii::serde::from_slice(&buf).unwrap_or_else(|err| {
+            panic!("cbor4ii failed: {:?} value: {:?} buf: {:?}", err, value, buf)
+        });
+        assert_eq!(back, value, "buf: {:?}", buf);
+    }
+
+    /// cbor4ii decodes what serde_cbor encodes.
+    #[hegel::test]
+    fn prop_cbor4ii_decodes_serde_cbor_encoding(tc: hegel::TestCase) {
+        let value = tc.draw(arb_compat());
+
+        let buf = serde_cbor::to_vec(&value).unwrap();
+        let back: Compat = cbor4ii::serde::from_slice(&buf).unwrap_or_else(|err| {
+            panic!("cbor4ii failed: {:?} value: {:?} buf: {:?}", err, value, buf)
+        });
+        assert_eq!(back, value, "buf: {:?}", buf);
+    }
+}
