+// ===========================================================================
+// Property-based tests (hegel)
+// ===========================================================================
+mod hegel_props {
+    use cbor4ii::core::{ Value, RawValue };
+    use cbor4ii::core::enc::Encode;
+    use cbor4ii::core::dec::{ self, Decode };
+    use cbor4ii::core::types;
+    use cbor4ii::core::utils::{ BufWriter, SliceReader };
+    use hegel::generators::{ self, Generator };
+
+    type DecodeResult<T> = Result<T, dec::Error<std::convert::Infallible>>;
+
+    fn enc<T: Encode>(value: &T) -> Vec<u8> {
+        let mut writer = BufWriter::new(Vec::new());
+        value.encode(&mut writer).unwrap();
+        writer.into_inner()
+    }
+
+    fn dec<'a, T: Decode<'a>>(buf: &'a [u8]) -> DecodeResult<T> {
+        let mut reader = SliceReader::new(buf);
+        T::decode(&mut reader)
+    }
+
+    /// u64 with the CBOR length-encoding boundaries (23/24, u8/u16/u32/u64 edges) boosted.
+    fn arb_u64(tc: &hegel::TestCase) -> u64 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u64>(),
+            generators::sampled_from(vec![
+                0u64, 1, 23, 24, 25, 255, 256, 65535, 65536,
+                u32::MAX as u64, u32::MAX as u64 + 1, u64::MAX - 1, u64::MAX,
+            ]),
+        ))
+    }
+
+    /// An integer in CBOR's native (major type 0/1) range: [-2^64, 2^64 - 1].
+    fn arb_native_int(tc: &hegel::TestCase) -> i128 {
+        let mag = i128::from(arb_u64(tc));
+        if tc.draw(generators::booleans()) {
+            mag
+        } else {
+            -1 - mag
+        }
+    }
+
+    /// Any f64 bit pattern (including inf, subnormals and arbitrary NaN payloads).
+    fn arb_f64(tc: &hegel::TestCase) -> f64 {
+        tc.draw(hegel::one_of!(
+            generators::floats::<f64>(),
+            generators::integers::<u64>().map(f64::from_bits),
+        ))
+    }
+
+    /// Structural equality on `Value` that compares floats bit-exactly,
+    /// so NaN payloads round-tripping is asserted rather than rejected.
+    fn value_eq(a: &Value, b: &Value) -> bool {
+        match (a, b) {
+            (Value::Float(x), Value::Float(y)) => x.to_bits() == y.to_bits(),
+            (Value::Array(x), Value::Array(y)) =>
+                x.len() == y.len() && x.iter().zip(y.iter()).all(|(u, v)| value_eq(u, v)),
+            (Value::Map(x), Value::Map(y)) =>
+                x.len() == y.len() && x.iter().zip(y.iter()).all(
+                    |((ka, va), (kb, vb))| value_eq(ka, kb) && value_eq(va, vb)),
+            (Value::Tag(ta, va), Value::Tag(tb, vb)) => ta == tb && value_eq(va, vb),
+            _ => a == b
+        }
+    }
+
+    /// Arbitrary `Value` tree.
+    ///
+    /// Integers are restricted to CBOR's native range because the *core* codec
+    /// (by design, see `test_value_i128`) decodes bignum-encoded `Value::Integer`s
+    /// back as `Value::Tag(2/3, Bytes)` rather than folding them into `Integer`.
+    fn arb_value(depth: u32) -> generators::BoxedGenerator<'static, Value> {
+        hegel::compose!(|tc| {
+            let max_choice = if depth == 0 { 5u8 } else { 8u8 };
+            match tc.draw(generators::integers::<u8>().max_value(max_choice)) {
+                0 => Value::Null,
+                1 => Value::Bool(tc.draw(generators::booleans())),
+                2 => Value::Integer(arb_native_int(&tc)),
+                3 => Value::Float(arb_f64(&tc)),
+                4 => Value::Bytes(tc.draw(generators::binary().max_size(64))),
+                5 => Value::Text(tc.draw(generators::text().max_size(64))),
+                6 => Value::Array(tc.draw((generators::vecs(arb_value(depth - 1)).max_size(4)).print_as_debug())),
+                7 => Value::Map(tc.draw((generators::vecs(generators::tuples!(
+                        arb_value(depth - 1),
+                        arb_value(depth - 1),
+                    )).max_size(4)).print_as_debug())),
+                _ => Value::Tag(
+                    tc.draw(generators::integers::<u64>()),
+                    Box::new(tc.draw((arb_value(depth - 1)).print_as_debug()))
+                ),
+            }
+        })
+        .boxed()
+    }
+
+    /// Round-trip: decode(encode(v)) == v (bit-exact for floats), and re-encoding
+    /// the decoded value is a byte-for-byte fixpoint.
+    #[hegel::test]
+    fn prop_core_value_roundtrip(tc: hegel::TestCase) {
+        let value = tc.draw((arb_value(3)).print_as_debug());
+
+        let buf = enc(&value);
+        let decoded: Value = dec(&buf).unwrap_or_else(|err| {
+            panic!("decode failed: {:?} value: {:?} buf: {:?}", err, value, buf)
+        });
+        assert!(value_eq(&value, &decoded),
+            "value: {:?} decoded: {:?} buf: {:?}", value, decoded, buf);
+
+        let buf2 = enc(&decoded);
+        assert_eq!(buf, buf2, "re-encode is not a fixpoint: {:?}", value);
+    }
+
+    /// `RawValue` and `IgnoredAny` consume exactly one item, and `RawValue`
+    /// captures exactly the encoded bytes of that item.
+    #[hegel::test]
+    fn prop_raw_value_and_ignored_any_consume_exactly_one_item(tc: hegel::TestCase) {
+        let value = tc.draw((arb_value(3)).print_as_debug());
+        let sentinel = arb_u64(&tc);
+
+        let item = enc(&value);
+        let mut buf = item.clone();
+        buf.extend_from_slice(&enc(&sentinel));
+
+        // RawValue: exact byte identity + reader left at the next item
+        let mut reader = SliceReader::new(&buf);
+        let raw = RawValue::decode(&mut reader).unwrap();
+        assert_eq!(raw.as_bytes(), item.as_slice(), "value: {:?}", value);
+        assert_eq!(u64::decode(&mut reader).unwrap(), sentinel);
+
+        // IgnoredAny: skips exactly one item
+        let mut reader = SliceReader::new(&buf);
+        let _ignore = dec::IgnoredAny::decode(&mut reader).unwrap();
+        assert_eq!(u64::decode(&mut reader).unwrap(), sentinel);
+    }
+
+    /// Decoding arbitrary untrusted bytes as any type returns Ok/Err but never
+    /// panics, aborts, over-allocates or hangs. (Supplements fuzz_targets/decode.rs.)
+    #[hegel::test]
+    fn prop_core_decode_arbitrary_bytes_never_panics(tc: hegel::TestCase) {
+        let data: Vec<u8> = tc.draw(generators::binary().max_size(512));
+        let data = data.as_slice();
+
+        drop(dec::<Value>(data));
+        drop(dec::<RawValue>(data));
+        drop(dec::<dec::IgnoredAny>(data));
+        drop(dec::<u8>(data));
+        drop(dec::<u16>(data));
+        drop(dec::<u32>(data));
+        drop(dec::<u64>(data));
+        drop(dec::<u128>(data));
+        drop(dec::<i8>(data));
+        drop(dec::<i16>(data));
+        drop(dec::<i32>(data));
+        drop(dec::<i64>(data));
+        drop(dec::<i128>(data));
+        drop(dec::<bool>(data));
+        drop(dec::<f32>(data));
+        drop(dec::<f64>(data));
+        drop(dec::<types::F16>(data));
+        drop(dec::<types::Simple>(data));
+        drop(dec::<String>(data));
+        drop(dec::<&str>(data));
+        drop(dec::<types::Bytes<Vec<u8>>>(data));
+        drop(dec::<types::Bytes<&[u8]>>(data));
+        drop(dec::<Vec<Value>>(data));
+        drop(dec::<types::Map<Vec<(Value, Value)>>>(data));
+        drop(dec::<types::Tag<Value>>(data));
+        drop(dec::<Option<Value>>(data));
+        drop(dec::<types::Maybe<Option<Value>>>(data));
+    }
+
+    /// A definite-length header claiming a huge length (or an unterminated
+    /// indefinite-length item) must fail with a normal error -- quickly and
+    /// without pre-allocating the claimed length.
+    #[hegel::test]
+    fn prop_crafted_length_prefix_rejected_without_oom(tc: hegel::TestCase) {
+        // major types with a payload/element length: bytes, string, array, map
+        let major: u8 = tc.draw(generators::sampled_from(vec![2u8, 3, 4, 5]));
+        let indefinite = tc.draw(generators::booleans());
+
+        // garbage tail; 0xff-free so an indefinite item can never see its
+        // "break" marker and terminate successfully
+        let garbage: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>().max_value(0xfe)).max_size(16));
+
+        let mut data = Vec::new();
+        if indefinite {
+            data.push((major << 5) | 0x1f);
+        } else {
+            // claimed length always exceeds the available payload
+            let len: u64 = tc.draw(hegel::one_of!(
+                generators::integers::<u64>().min_value(17),
+                generators::sampled_from(vec![
+                    65536u64, u32::MAX as u64, u32::MAX as u64 + 1,
+                    1 << 48, u64::MAX - 1, u64::MAX,
+                ]),
+            ));
+            match tc.draw(generators::sampled_from(vec![1u8, 2, 4, 8])) {
+                1 if len <= u8::MAX as u64 => {
+                    data.push((major << 5) | 0x18);
+                    data.push(len as u8);
+                },
+                2 if len <= u16::MAX as u64 => {
+                    data.push((major << 5) | 0x19);
+                    data.extend_from_slice(&(len as u16).to_be_bytes());
+                },
+                4 if len <= u32::MAX as u64 => {
+                    data.push((major << 5) | 0x1a);
+                    data.extend_from_slice(&(len as u32).to_be_bytes());
+                },
+                _ => {
+                    data.push((major << 5) | 0x1b);
+                    data.extend_from_slice(&len.to_be_bytes());
+                }
+            }
+        }
+        data.extend_from_slice(&garbage);
+
+        let ret: DecodeResult<Value> = dec(&data);
+        assert!(ret.is_err(), "data: {:?} ret: {:?}", data, ret);
+        let ret: DecodeResult<dec::IgnoredAny> = dec(&data);
+        assert!(ret.is_err(), "data: {:?}", data);
+    }
+
+    /// Deeply nested input must either decode or fail with a depth error --
+    /// never overflow the stack. SliceReader's documented recursion limit is 256.
+    #[hegel::test]
+    fn prop_deeply_nested_input_no_stack_overflow(tc: hegel::TestCase) {
+        let depth: usize = tc.draw(hegel::one_of!(
+            generators::integers::<usize>().min_value(1).max_value(20_000),
+            generators::sampled_from(vec![100usize, 127, 128, 129, 255, 256, 257, 512, 20_000]),
+        ));
+        let kind: u8 = tc.draw(generators::integers::<u8>().max_value(3));
+
+        let mut data = Vec::new();
+        match kind {
+            0 => { // definite arrays: [[[...0...]]]
+                data.resize(depth, 0x81);
+                data.push(0x00);
+            },
+            1 => { // indefinite arrays: [_ [_ ... ]]
+                data.resize(depth, 0x9f);
+                data.resize(depth * 2, 0xff);
+            },
+            2 => { // maps: {0: {0: ...0...}}
+                for _ in 0..depth {
+                    data.push(0xa1);
+                    data.push(0x00);
+                }
+                data.push(0x00);
+            },
+            _ => { // tags: 1(1(...0...))
+                data.resize(depth, 0xc1);
+                data.push(0x00);
+            }
+        }
+
+        let value: DecodeResult<Value> = dec(&data);
+        let ignored: DecodeResult<dec::IgnoredAny> = dec(&data);
+        let raw: DecodeResult<RawValue> = dec(&data);
+
+        if depth > 256 {
+            // must be rejected by the depth limit, not crash the process
+            assert!(value.is_err(), "depth {} kind {}", depth, kind);
+            assert!(ignored.is_err(), "depth {} kind {}", depth, kind);
+            assert!(raw.is_err(), "depth {} kind {}", depth, kind);
+        }
+        if depth <= 100 {
+            // well-formed and comfortably inside the limit
+            assert!(value.is_ok(), "depth {} kind {}: {:?}", depth, kind, value);
+            assert!(ignored.is_ok(), "depth {} kind {}", depth, kind);
+            assert!(raw.is_ok(), "depth {} kind {}", depth, kind);
+        }
+    }
+
+    /// Corrupting a valid encoding (bit flip, truncation, insertion) never panics.
+    #[hegel::test]
+    fn prop_corrupted_encoding_never_panics(tc: hegel::TestCase) {
+        let value = tc.draw((arb_value(3)).print_as_debug());
+        let mut buf = enc(&value);
+
+        let pos = tc.draw(generators::integers::<usize>().max_value(buf.len() - 1));
+        match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => { // overwrite one byte
+                buf[pos] = tc.draw(generators::integers::<u8>());
+            },
+            1 => { // truncate
+                buf.truncate(pos);
+            },
+            _ => { // insert a byte
+                let byte = tc.draw(generators::integers::<u8>());
+                buf.insert(pos, byte);
+            }
+        }
+
+        drop(dec::<Value>(&buf));
+        drop(dec::<dec::IgnoredAny>(&buf));
+        drop(dec::<RawValue>(&buf));
+    }
+
+    /// Decoding a text string validates UTF-8: a definite-length string item
+    /// decodes to exactly its payload iff the payload is valid UTF-8, and is
+    /// rejected otherwise.
+    #[hegel::test]
+    fn prop_string_decode_validates_utf8(tc: hegel::TestCase) {
+        let payload: Vec<u8> = tc.draw(generators::binary().max_size(128));
+        let buf = enc(&types::UncheckedStr(payload.as_slice()));
+
+        let ret: DecodeResult<String> = dec(&buf);
+        match core::str::from_utf8(&payload) {
+            Ok(s) => assert_eq!(ret.unwrap(), s),
+            Err(_) => assert!(
+                matches!(ret, Err(cbor4ii::core::error::DecodeError::RequireUtf8 { .. })),
+                "payload: {:?} ret: {:?}", payload, ret
+            )
+        }
+    }
+
+    /// Spec (RFC 8949 4.2.1-style shortest form): the encoder emits the smallest
+    /// possible integer header, for both unsigned and negative integers.
+    #[hegel::test]
+    fn prop_int_header_shortest_form(tc: hegel::TestCase) {
+        let n = arb_u64(&tc);
+        let expected = match n {
+            0..=23 => 1,
+            24..=0xff => 2,
+            0x100..=0xffff => 3,
+            0x1_0000..=0xffff_ffff => 5,
+            _ => 9
+        };
+
+        let buf = enc(&n);
+        assert_eq!(buf.len(), expected, "n: {}", n);
+        assert_eq!(buf[0] >> 5, 0, "n: {}", n); // major type 0
+
+        // the corresponding negative integer -1 - n uses the same header size
+        let m: i128 = -1 - i128::from(n);
+        let buf = enc(&m);
+        assert_eq!(buf.len(), expected, "m: {}", m);
+        assert_eq!(buf[0] >> 5, 1, "m: {}", m); // major type 1
+    }
+
+    /// Narrowing decodes agree with `try_from`: bytes encoded from a wide
+    /// integer decode as a narrower type exactly when the value fits.
+    #[hegel::test]
+    fn prop_narrowing_decode_matches_try_from(tc: hegel::TestCase) {
+        use std::convert::TryFrom;
+
+        let n = arb_u64(&tc);
+        let buf = enc(&n);
+        assert_eq!(dec::<u8>(&buf).ok(), u8::try_from(n).ok(), "n: {}", n);
+        assert_eq!(dec::<u16>(&buf).ok(), u16::try_from(n).ok(), "n: {}", n);
+        assert_eq!(dec::<u32>(&buf).ok(), u32::try_from(n).ok(), "n: {}", n);
+        assert_eq!(dec::<u64>(&buf).ok(), Some(n));
+        assert_eq!(dec::<i64>(&buf).ok(), i64::try_from(n).ok(), "n: {}", n);
+        assert_eq!(dec::<u128>(&buf).ok(), Some(u128::from(n)));
+        assert_eq!(dec::<i128>(&buf).ok(), Some(i128::from(n)));
+
+        let i: i64 = tc.draw(hegel::one_of!(
+            generators::integers::<i64>(),
+            generators::sampled_from(vec![
+                i64::MIN, i64::MIN + 1, -1, 0, 1, i64::MAX - 1, i64::MAX,
+                i64::from(i8::MIN), i64::from(i8::MIN) - 1,
+                i64::from(i8::MAX), i64::from(i8::MAX) + 1,
+                i64::from(i16::MIN) - 1, i64::from(i16::MAX) + 1,
+                i64::from(i32::MIN) - 1, i64::from(i32::MAX) + 1,
+            ]),
+        ));
+        let buf = enc(&i);
+        assert_eq!(dec::<i8>(&buf).ok(), i8::try_from(i).ok(), "i: {}", i);
+        assert_eq!(dec::<i16>(&buf).ok(), i16::try_from(i).ok(), "i: {}", i);
+        assert_eq!(dec::<i32>(&buf).ok(), i32::try_from(i).ok(), "i: {}", i);
+        assert_eq!(dec::<i64>(&buf).ok(), Some(i));
+        assert_eq!(dec::<i128>(&buf).ok(), Some(i128::from(i)));
+        assert_eq!(dec::<u64>(&buf).ok(), u64::try_from(i).ok(), "i: {}", i);
+    }
+}
