+// ===========================================================================
+// Property-based tests (hegel)
+// ===========================================================================
+mod hegel_props {
+    use std::collections::BTreeMap;
+    use serde::{ Serialize, Deserialize };
+    use cbor4ii::core::Value;
+    use cbor4ii::serde::{ to_vec, from_slice, from_reader };
+    use hegel::generators::{ self, Generator };
+
+    /// f32 wrapper comparing bit patterns, so NaN payload round-tripping is
+    /// asserted rather than being unequal to itself.
+    #[derive(Serialize, Deserialize, Debug, Clone, Copy)]
+    struct BitsF32(f32);
+
+    impl PartialEq for BitsF32 {
+        fn eq(&self, other: &Self) -> bool {
+            self.0.to_bits() == other.0.to_bits()
+        }
+    }
+
+    /// f64 wrapper comparing bit patterns.
+    #[derive(Serialize, Deserialize, Debug, Clone, Copy)]
+    struct BitsF64(f64);
+
+    impl PartialEq for BitsF64 {
+        fn eq(&self, other: &Self) -> bool {
+            self.0.to_bits() == other.0.to_bits()
+        }
+    }
+
+    #[derive(Serialize, Deserialize, Debug, PartialEq)]
+    enum ModelEnum {
+        Unit,
+        NewType(i64),
+        Tuple(String, bool),
+        Struct { x: BitsF32, y: Vec<u8> },
+    }
+
+    /// A model exercising every serde data-model shape the crate supports:
+    /// all integer widths, floats, bool, char, unicode strings, byte strings,
+    /// options, sequences, maps, tuples, enums and nested structs.
+    #[derive(Serialize, Deserialize, Debug, PartialEq, hegel::PrettyPrintable)]
+    struct Model {
+        u8v: u8, u16v: u16, u32v: u32, u64v: u64, u128v: u128,
+        i8v: i8, i16v: i16, i32v: i32, i64v: i64, i128v: i128,
+        #[pretty(debug)]
+        f32v: BitsF32,
+        #[pretty(debug)]
+        f64v: BitsF64,
+        boolean: bool,
+        ch: char,
+        text: String,
+        #[serde(with = "serde_bytes")]
+        bytes: Vec<u8>,
+        opt: Option<i64>,
+        list: Vec<i32>,
+        map: BTreeMap<String, i64>,
+        tup: (bool, u8, String),
+        #[pretty(debug)]
+        en: ModelEnum,
+        nested: Option<Box<Model>>,
+    }
+
+    fn arb_u64(tc: &hegel::TestCase) -> u64 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u64>(),
+            generators::sampled_from(vec![
+                0u64, 1, 23, 24, 25, 255, 256, 65535, 65536,
+                u32::MAX as u64, u32::MAX as u64 + 1, u64::MAX - 1, u64::MAX,
+            ]),
+        ))
+    }
+
+    fn arb_i64(tc: &hegel::TestCase) -> i64 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<i64>(),
+            generators::sampled_from(vec![
+                i64::MIN, i64::MIN + 1, -1, 0, 1, 23, 24, i64::MAX - 1, i64::MAX,
+            ]),
+        ))
+    }
+
+    fn arb_u128(tc: &hegel::TestCase) -> u128 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u128>(),
+            generators::sampled_from(vec![
+                0u128, u64::MAX as u128 - 1, u64::MAX as u128, u64::MAX as u128 + 1,
+                u128::MAX - 1, u128::MAX,
+            ]),
+        ))
+    }
+
+    fn arb_i128(tc: &hegel::TestCase) -> i128 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<i128>(),
+            generators::sampled_from(vec![
+                i128::MIN, i128::MIN + 1, -(u64::MAX as i128) - 2, -(u64::MAX as i128) - 1,
+                -(u64::MAX as i128), i64::MIN as i128 - 1, i64::MIN as i128, -1, 0,
+                i64::MAX as i128, u64::MAX as i128, u64::MAX as i128 + 1,
+                i128::MAX - 1, i128::MAX,
+            ]),
+        ))
+    }
+
+    fn arb_f32(tc: &hegel::TestCase) -> f32 {
+        tc.draw(hegel::one_of!(
+            generators::floats::<f32>(),
+            generators::integers::<u32>().map(f32::from_bits),
+        ))
+    }
+
+    fn arb_f64(tc: &hegel::TestCase) -> f64 {
+        tc.draw(hegel::one_of!(
+            generators::floats::<f64>(),
+            generators::integers::<u64>().map(f64::from_bits),
+        ))
+    }
+
+    fn arb_char(tc: &hegel::TestCase) -> char {
+        let n = tc.draw(hegel::one_of!(
+            generators::integers::<u32>().max_value(0x7F),
+            generators::integers::<u32>().min_value(0x80).max_value(0xFFFF),
+            generators::integers::<u32>().min_value(0x1_0000).max_value(0x10_FFFF),
+        ));
+        char::from_u32(n).unwrap_or('\u{FFFD}')
+    }
+
+    fn arb_enum(tc: &hegel::TestCase) -> ModelEnum {
+        match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => ModelEnum::Unit,
+            1 => ModelEnum::NewType(arb_i64(tc)),
+            2 => ModelEnum::Tuple(tc.draw(generators::text().max_size(16)),
+                                  tc.draw(generators::booleans())),
+            _ => ModelEnum::Struct {
+                x: BitsF32(arb_f32(tc)),
+                y: tc.draw(generators::binary().max_size(16)),
+            },
+        }
+    }
+
+    fn arb_model(depth: u32) -> generators::BoxedGenerator<'static, Model> {
+        hegel::compose!(|tc| {
+            Model {
+                u8v: tc.draw(generators::integers::<u8>()),
+                u16v: tc.draw(generators::integers::<u16>()),
+                u32v: tc.draw(generators::integers::<u32>()),
+                u64v: arb_u64(&tc),
+                u128v: arb_u128(&tc),
+                i8v: tc.draw(generators::integers::<i8>()),
+                i16v: tc.draw(generators::integers::<i16>()),
+                i32v: tc.draw(generators::integers::<i32>()),
+                i64v: arb_i64(&tc),
+                i128v: arb_i128(&tc),
+                f32v: BitsF32(arb_f32(&tc)),
+                f64v: BitsF64(arb_f64(&tc)),
+                boolean: tc.draw(generators::booleans()),
+                ch: arb_char(&tc),
+                text: tc.draw(generators::text().max_size(32)),
+                bytes: tc.draw(generators::binary().max_size(32)),
+                opt: tc.draw(generators::optional(generators::integers::<i64>())),
+                list: tc.draw(generators::vecs(generators::integers::<i32>()).max_size(8)),
+                map: tc.draw(generators::hashmaps(
+                        generators::text().max_size(8),
+                        generators::integers::<i64>(),
+                    ).max_size(4))
+                    .into_iter().collect(),
+                tup: (
+                    tc.draw(generators::booleans()),
+                    tc.draw(generators::integers::<u8>()),
+                    tc.draw(generators::text().max_size(8)),
+                ),
+                en: arb_enum(&tc),
+                nested: if depth > 0 && tc.draw(generators::booleans()) {
+                    Some(Box::new(tc.draw((arb_model(depth - 1)).print_as_debug())))
+                } else {
+                    None
+                },
+            }
+        })
+        .boxed()
+    }
+
+    /// Bit-exact structural equality on `Value` (floats compared by bits).
+    fn value_eq(a: &Value, b: &Value) -> bool {
+        match (a, b) {
+            (Value::Float(x), Value::Float(y)) => x.to_bits() == y.to_bits(),
+            (Value::Array(x), Value::Array(y)) =>
+                x.len() == y.len() && x.iter().zip(y.iter()).all(|(u, v)| value_eq(u, v)),
+            (Value::Map(x), Value::Map(y)) =>
+                x.len() == y.len() && x.iter().zip(y.iter()).all(
+                    |((ka, va), (kb, vb))| value_eq(ka, kb) && value_eq(va, vb)),
+            (Value::Tag(ta, va), Value::Tag(tb, vb)) => ta == tb && value_eq(va, vb),
+            _ => a == b
+        }
+    }
+
+    /// Integers a serde-mod `Value` round-trip supports.
+    ///
+    /// KNOWN BUG EXCLUSION: the range [-2^64, i64::MIN - 1] is excluded here;
+    /// it is pinned by `prop_serde_value_roundtrip_big_negative_int_known_bug`
+    /// below. Everything else (full u64, i64, and bignum tails) is covered.
+    fn arb_serde_int(tc: &hegel::TestCase) -> i128 {
+        tc.draw(hegel::one_of!(
+            // native unsigned range [0, 2^64 - 1]
+            generators::integers::<u64>().map(i128::from),
+            // negative range representable as i64
+            generators::integers::<i64>().max_value(-1).map(i128::from),
+            // positive bignum (tag 2)
+            generators::integers::<i128>().min_value(i128::from(u64::MAX) + 1),
+            // negative bignum (tag 3), starts below -2^64
+            generators::integers::<i128>().max_value(-i128::from(u64::MAX) - 2),
+            generators::sampled_from(vec![
+                0i128, -1, 1, 23, 24, i64::MIN as i128, u64::MAX as i128,
+                u64::MAX as i128 + 1, -(u64::MAX as i128) - 2, i128::MIN, i128::MAX,
+            ]),
+        ))
+    }
+
+    /// Arbitrary `Value` tree for the serde mod (no `Tag`: serializing Tag via
+    /// serde is documented as unsupported).
+    fn arb_serde_value(depth: u32) -> generators::BoxedGenerator<'static, Value> {
+        hegel::compose!(|tc| {
+            let max_choice = if depth == 0 { 5u8 } else { 7u8 };
+            match tc.draw(generators::integers::<u8>().max_value(max_choice)) {
+                0 => Value::Null,
+                1 => Value::Bool(tc.draw(generators::booleans())),
+                2 => Value::Integer(arb_serde_int(&tc)),
+                3 => Value::Float(arb_f64(&tc)),
+                4 => Value::Bytes(tc.draw(generators::binary().max_size(64))),
+                5 => Value::Text(tc.draw(generators::text().max_size(64))),
+                6 => Value::Array(tc.draw((generators::vecs(arb_serde_value(depth - 1)).max_size(4)).print_as_debug())),
+                _ => Value::Map(tc.draw((generators::vecs(generators::tuples!(
+                        arb_serde_value(depth - 1),
+                        arb_serde_value(depth - 1),
+                    )).max_size(4)).print_as_debug())),
+            }
+        })
+        .boxed()
+    }
+
+    /// The crown: from_slice(to_vec(v)) == v over a rich serde model, through
+    /// both the zero-copy slice reader and the buffered io reader.
+    #[hegel::test]
+    fn prop_serde_roundtrip_rich_model(tc: hegel::TestCase) {
+        let model = tc.draw((arb_model(2)).print_as_debug());
+
+        let buf = to_vec(Vec::new(), &model).unwrap();
+        let decoded: Model = from_slice(&buf).unwrap_or_else(|err| {
+            panic!("from_slice failed: {:?} model: {:?} buf: {:?}", err, model, buf)
+        });
+        assert_eq!(decoded, model, "buf: {:?}", buf);
+
+        let decoded: Model = from_reader(buf.as_slice()).unwrap_or_else(|err| {
+            panic!("from_reader failed: {:?} model: {:?} buf: {:?}", err, model, buf)
+        });
+        assert_eq!(decoded, model, "buf: {:?}", buf);
+    }
+
+    /// Encoding is deterministic, and decode-then-encode is a byte fixpoint.
+    #[hegel::test]
+    fn prop_serde_encoding_deterministic_and_fixpoint(tc: hegel::TestCase) {
+        let model = tc.draw(arb_model(2));
+
+        let buf1 = to_vec(Vec::new(), &model).unwrap();
+        let buf2 = to_vec(Vec::new(), &model).unwrap();
+        assert_eq!(buf1, buf2, "encoding is not deterministic: {:?}", model);
+
+        let decoded: Model = from_slice(&buf1).unwrap();
+        let buf3 = to_vec(Vec::new(), &decoded).unwrap();
+        assert_eq!(buf1, buf3, "re-encode is not a fixpoint: {:?}", model);
+    }
+
+    /// Round-trip of dynamic `Value` trees through the serde mod, including
+    /// bignum (tag 2/3) integers beyond the u64 range.
+    #[hegel::test]
+    fn prop_serde_value_roundtrip(tc: hegel::TestCase) {
+        let value = tc.draw((arb_serde_value(3)).print_as_debug());
+
+        let buf = to_vec(Vec::new(), &value).unwrap();
+        let decoded: Value = from_slice(&buf).unwrap_or_else(|err| {
+            panic!("from_slice failed: {:?} value: {:?} buf: {:?}", err, value, buf)
+        });
+        assert!(value_eq(&value, &decoded),
+            "value: {:?} decoded: {:?} buf: {:?}", value, decoded, buf);
+    }
+
+    /// KNOWN FAILURE (real bug): CBOR negative integers in [-2^64, i64::MIN - 1]
+    /// -- valid RFC 8949 major type 1, and exactly what `to_vec` itself emits for
+    /// `Value::Integer` in that range -- fail to decode as `Value` with
+    /// `CastOverflow { name: "-i64" }`. `deserialize_any` routes all of major
+    /// type 1 to `deserialize_i64` (src/serde/de.rs) with no i128 fallback, so
+    /// the serde-mod Value round-trip is broken for these values. serde_cbor
+    /// decodes the same bytes successfully (`Integer(-9223372036854775809)`).
+    /// Minimal reproducer: to_vec(Value::Integer(i64::MIN as i128 - 1)).
+    #[hegel::test]
+    fn prop_serde_value_roundtrip_big_negative_int_known_bug(tc: hegel::TestCase) {
+        // deterministic: every value in this range fails
+        let n: i128 = tc.draw(generators::integers::<i128>()
+            .min_value(-i128::from(u64::MAX) - 1)
+            .max_value(i128::from(i64::MIN) - 1));
+        let value = Value::Integer(n);
+
+        let buf = to_vec(Vec::new(), &value).unwrap();
+        let decoded: Value = from_slice(&buf).unwrap_or_else(|err| {
+            panic!("from_slice failed: {:?} value: {:?} buf: {:?}", err, value, buf)
+        });
+        assert!(value_eq(&value, &decoded), "value: {:?} decoded: {:?}", value, decoded);
+    }
+
+    /// Decoding arbitrary untrusted bytes never panics, over-allocates or hangs.
+    /// (Supplements fuzz_targets/de.rs.)
+    #[hegel::test]
+    fn prop_from_slice_arbitrary_bytes_never_panics(tc: hegel::TestCase) {
+        let data: Vec<u8> = tc.draw(generators::binary().max_size(512));
+
+        drop(from_slice::<Value>(&data));
+        drop(from_slice::<Model>(&data));
+        drop(from_slice::<ModelEnum>(&data));
+        drop(from_reader::<Value, _>(data.as_slice()));
+        drop(from_reader::<Model, _>(data.as_slice()));
+    }
+
+    /// Bytes valid for one type decoded as any other type never panic.
+    #[hegel::test]
+    fn prop_from_slice_cross_type_never_panics(tc: hegel::TestCase) {
+        let value = tc.draw((arb_serde_value(2)).print_as_debug());
+        let buf = to_vec(Vec::new(), &value).unwrap();
+        let buf = buf.as_slice();
+
+        drop(from_slice::<()>(buf));
+        drop(from_slice::<bool>(buf));
+        drop(from_slice::<u8>(buf));
+        drop(from_slice::<u64>(buf));
+        drop(from_slice::<u128>(buf));
+        drop(from_slice::<i8>(buf));
+        drop(from_slice::<i64>(buf));
+        drop(from_slice::<i128>(buf));
+        drop(from_slice::<f32>(buf));
+        drop(from_slice::<f64>(buf));
+        drop(from_slice::<char>(buf));
+        drop(from_slice::<String>(buf));
+        drop(from_slice::<&str>(buf));
+        drop(from_slice::<serde_bytes::ByteBuf>(buf));
+        drop(from_slice::<Option<i64>>(buf));
+        drop(from_slice::<Vec<String>>(buf));
+        drop(from_slice::<BTreeMap<String, u64>>(buf));
+        drop(from_slice::<(f32, f64)>(buf));
+        drop(from_slice::<Model>(buf));
+        drop(from_slice::<ModelEnum>(buf));
+    }
+
+    /// Deeply nested input through the serde deserializer is depth-limited:
+    /// graceful error, never a stack overflow.
+    #[hegel::test]
+    fn prop_serde_deeply_nested_no_stack_overflow(tc: hegel::TestCase) {
+        let depth: usize = tc.draw(hegel::one_of!(
+            generators::integers::<usize>().min_value(1).max_value(20_000),
+            generators::sampled_from(vec![100usize, 127, 128, 129, 255, 256, 257, 512, 20_000]),
+        ));
+        let kind: u8 = tc.draw(generators::integers::<u8>().max_value(2));
+
+        let mut data = Vec::new();
+        match kind {
+            0 => { // definite arrays
+                data.resize(depth, 0x81);
+                data.push(0x00);
+            },
+            1 => { // indefinite arrays
+                data.resize(depth, 0x9f);
+                data.resize(depth * 2, 0xff);
+            },
+            _ => { // maps: {0: {0: ...}}
+                for _ in 0..depth {
+                    data.push(0xa1);
+                    data.push(0x00);
+                }
+                data.push(0x00);
+            }
+        }
+
+        let ret = from_slice::<Value>(&data);
+        if depth > 256 {
+            assert!(ret.is_err(), "depth {} kind {}", depth, kind);
+        }
+        if depth <= 100 {
+            assert!(ret.is_ok(), "depth {} kind {}: {:?}", depth, kind, ret);
+        }
+    }
+}
