+      allow_comments: tc.draw(generators::booleans()),
+      allow_loose_object_property_names: tc.draw(generators::booleans()),
+      allow_trailing_commas: tc.draw(generators::booleans()),
+      allow_missing_commas: tc.draw(generators::booleans()),
+      allow_single_quoted_strings: tc.draw(generators::booleans()),
+      allow_hexadecimal_numbers: tc.draw(generators::booleans()),
+      allow_unary_plus_numbers: tc.draw(generators::booleans()),
+    }
+  }
