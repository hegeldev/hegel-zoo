+  // ---------------------------------------------------------------------
+  // 9. String escape decoding, generated at the escape boundary with a
+  //    constructed expectation (plus serde_json as oracle when applicable).
+  // ---------------------------------------------------------------------
+
+  /// Builds a double-quoted JSON string literal from raw chars, simple
+  /// escapes, `\uXXXX` escapes, and surrogate pairs, together with the
+  /// expected decoded value. The bool reports whether the literal is also
+  /// valid strict JSON per serde_json (no raw control chars).
+  #[hegel::composite]
+  fn string_literal_and_expected(tc: &hegel::TestCase) -> (String, String, bool) {
+    let n = tc.draw(generators::integers::<usize>().max_value(12));
+    let mut lit = String::from("\"");
+    let mut expected = String::new();
+    let mut strict_json_safe = true;
+    for _ in 0..n {
+      match tc.draw(generators::integers::<u8>().max_value(3)) {
+        0 => {
+          // raw character (quote/backslash replaced to stay in-grammar)
+          let cp = tc.draw(hegel::one_of!(
+            generators::integers::<u32>().max_value(0x7F),
+            generators::integers::<u32>().min_value(0x80).max_value(0xFFFF),
+            generators::integers::<u32>().min_value(0x1_0000).max_value(0x10_FFFF),
+          ));
+          let mut c = char::from_u32(cp).unwrap_or('\u{FFFD}');
+          if c == '"' || c == '\\' {
+            c = 'x';
+          }
+          if c.is_control() {
+            strict_json_safe = false;
+          }
+          lit.push(c);
+          expected.push(c);
+        }
+        1 => {
+          // simple escape
+          let (esc, ch) = tc.draw(generators::sampled_from(vec![
+            ("\\\"", '"'),
+            ("\\\\", '\\'),
+            ("\\/", '/'),
+            ("\\b", '\u{8}'),
+            ("\\f", '\u{c}'),
+            ("\\n", '\n'),
+            ("\\r", '\r'),
+            ("\\t", '\t'),
+          ]));
+          lit.push_str(esc);
+          expected.push(ch);
+        }
+        2 => {
+          // \uXXXX escape for a BMP non-surrogate codepoint
+          let cp = tc.draw(hegel::one_of!(
+            generators::integers::<u32>().max_value(0xD7FF),
+            generators::integers::<u32>().min_value(0xE000).max_value(0xFFFF),
+          ));
+          if tc.draw(generators::booleans()) {
+            lit.push_str(&format!("\\u{:04X}", cp));
+          } else {
+            lit.push_str(&format!("\\u{:04x}", cp));
+          }
+          expected.push(char::from_u32(cp).unwrap());
+        }
+        3 => {
+          // supplementary-plane char as a surrogate pair
+          let cp = tc.draw(generators::integers::<u32>().min_value(0x1_0000).max_value(0x10_FFFF));
+          let v = cp - 0x1_0000;
+          let hi = 0xD800 + (v >> 10);
+          let lo = 0xDC00 + (v & 0x3FF);
+          lit.push_str(&format!("\\u{:04X}\\u{:04X}", hi, lo));
+          expected.push(char::from_u32(cp).unwrap());
+        }
+        _ => unreachable!(),
+      }
+    }
+    lit.push('"');
+    (lit, expected, strict_json_safe)
+  }
+
+  #[hegel::test]
+  fn pbt_string_escape_decoding(tc: hegel::TestCase) {
+    let (lit, expected, strict_json_safe) = tc.draw(string_literal_and_expected());
+    let parsed = parse_to_value(&lit, &ParseOptions::default())
+      .unwrap_or_else(|e| panic!("string literal {:?} must parse: {}", lit, e))
+      .expect("string literal must produce a value");
+    match &parsed {
+      JsonValue::String(s) => assert_eq!(s.as_ref(), expected, "escape decoding mismatch for {:?}", lit),
+      other => panic!("expected string for {:?}, got {:?}", lit, other),
+    }
+    // serde_json as an independent oracle whenever the literal is strict JSON
+    if strict_json_safe {
+      let oracle: serde_json::Value =
+        serde_json::from_str(&lit).unwrap_or_else(|e| panic!("oracle rejected strict-JSON string {:?}: {}", lit, e));
+      assert_eq!(
+        oracle,
+        serde_json::Value::String(expected),
+        "disagreement with serde_json for {:?}",
+        lit
+      );
+    }
+  }
+
+  // ---------------------------------------------------------------------
+  // 10. AST ranges and token streams are in-bounds, ordered, and each
+  //     token's range slices back to its own text (oracle-independent).
+  // ---------------------------------------------------------------------
+
+  fn check_leaf_range_slice(text: &str, v: &ast::Value) {
+    let r = v.range();
+    let slice = &text[r.start..r.end];
+    match v {
+      ast::Value::StringLit(_) => {
+        assert!(slice.len() >= 2, "string lit range too small: {:?}", slice);
+        let first = slice.chars().next().unwrap();
+        let last = slice.chars().last().unwrap();
+        assert!(
+          first == '"' || first == '\'',
+          "string lit must start with quote: {:?}",
+          slice
+        );
+        assert_eq!(first, last, "string lit quotes must match: {:?}", slice);
+      }
+      ast::Value::NumberLit(n) => assert_eq!(slice, n.value, "number lit range must slice to its lexeme"),
+      ast::Value::BooleanLit(b) => assert_eq!(slice, if b.value { "true" } else { "false" }),
+      ast::Value::NullKeyword(_) => assert_eq!(slice, "null"),
+      _ => {}
+    }
+  }
+
+  fn check_value_ranges(text: &str, v: &ast::Value, parent: Range) {
+    let r = v.range();
+    assert!(r.start <= r.end, "range reversed: {:?}", r);
+    assert!(r.end <= text.len(), "range {:?} out of bounds", r);
+    assert!(
+      text.is_char_boundary(r.start) && text.is_char_boundary(r.end),
+      "range {:?} not on char boundaries",
+      r
+    );
+    assert!(
+      parent.start <= r.start && r.end <= parent.end,
+      "child range {:?} escapes parent {:?}",
+      r,
+      parent
+    );
+    check_leaf_range_slice(text, v);
+    match v {
+      ast::Value::Object(o) => {
+        assert_eq!(&text[r.start..r.start + 1], "{", "object range must start at '{{'");
+        assert_eq!(&text[r.end - 1..r.end], "}", "object range must end at '}}'");
+        let mut last_end = r.start;
+        for prop in &o.properties {
+          let pr = prop.range;
+          assert!(pr.start >= last_end, "object props must be ordered and disjoint");
+          assert!(
+            pr.start <= pr.end && pr.end <= r.end,
+            "prop range {:?} escapes object {:?}",
+            pr,
+            r
+          );
+          let name_range = prop.name.range();
+          assert!(
+            pr.start <= name_range.start && name_range.end <= pr.end,
+            "prop name range {:?} escapes prop {:?}",
+            name_range,
+            pr
+          );
+          assert!(
+            name_range.end <= prop.value.range().start,
+            "prop name must precede prop value"
+          );
+          check_value_ranges(text, &prop.value, pr);
+          last_end = pr.end;
+        }
+      }
+      ast::Value::Array(a) => {
+        assert_eq!(&text[r.start..r.start + 1], "[", "array range must start at '['");
+        assert_eq!(&text[r.end - 1..r.end], "]", "array range must end at ']'");
+        let mut last_end = r.start;
+        for element in &a.elements {
+          let er = element.range();
+          assert!(er.start >= last_end, "array elements must be ordered and disjoint");
+          check_value_ranges(text, element, r);
+          last_end = er.end;
+        }
+      }
+      _ => {}
+    }
+  }
+
+  fn check_token_stream(text: &str, tokens: &[TokenAndRange]) {
+    let mut last_end = 0usize;
+    for t in tokens {
+      let r = t.range;
+      assert!(r.start <= r.end && r.end <= text.len(), "token range {:?} invalid", r);
+      assert!(
+        text.is_char_boundary(r.start) && text.is_char_boundary(r.end),
+        "token range {:?} not on char boundaries",
+        r
+      );
+      assert!(r.start >= last_end, "tokens must be ordered and disjoint: {:?}", r);
+      last_end = r.end;
+      let slice = &text[r.start..r.end];
+      match &t.token {
+        Token::OpenBrace => assert_eq!(slice, "{"),
+        Token::CloseBrace => assert_eq!(slice, "}"),
+        Token::OpenBracket => assert_eq!(slice, "["),
+        Token::CloseBracket => assert_eq!(slice, "]"),
+        Token::Comma => assert_eq!(slice, ","),
+        Token::Colon => assert_eq!(slice, ":"),
+        Token::Boolean(true) => assert_eq!(slice, "true"),
+        Token::Boolean(false) => assert_eq!(slice, "false"),
+        Token::Null => assert_eq!(slice, "null"),
+        Token::Number(n) => assert_eq!(&slice, n, "number token range must slice to its lexeme"),
+        Token::Word(w) => assert_eq!(&slice, w, "word token range must slice to its text"),
+        Token::String(_) => {
+          assert!(slice.len() >= 2, "string token range too small: {:?}", slice);
+          let first = slice.chars().next().unwrap();
+          assert!(first == '"' || first == '\'', "string token must start with quote");
+        }
+        Token::CommentLine(c) => assert_eq!(slice, format!("//{}", c)),
+        Token::CommentBlock(c) => assert_eq!(slice, format!("/*{}*/", c)),
+      }
+    }
+  }
+
+  #[hegel::test]
+  fn pbt_ast_ranges_well_formed(tc: hegel::TestCase) {
+    // JSONC text that always parses, so the checks below never go vacuous
+    let (_, text) = draw_value_and_jsonc_text(&tc);
+    let result = parse_to_ast(
+      &text,
+      &CollectOptions {
+        comments: CommentCollectionStrategy::Separate,
+        tokens: true,
+      },
+      &ParseOptions::default(),
+    )
+    .unwrap_or_else(|e| panic!("writer-generated JSONC must parse: {:?} -> {}", text, e));
+
+    if let Some(value) = &result.value {
+      check_value_ranges(&text, value, Range::new(0, text.len()));
+    }
+    check_token_stream(&text, result.tokens.as_ref().expect("tokens requested"));
+    for (pos, comments) in result.comments.as_ref().expect("comments requested") {
+      assert!(*pos <= text.len(), "comment map position {} out of bounds", pos);
+      for comment in comments.iter() {
+        let cr = comment.range();
+        assert!(
+          cr.start <= cr.end && cr.end <= text.len(),
+          "comment range {:?} invalid",
+          cr
+        );
+      }
+    }
+  }
