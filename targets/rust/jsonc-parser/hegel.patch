+
+  /// Checks the documented invariants of a `ParseError`: the range lies within
+  /// the input, is well ordered, falls on char boundaries, and the display
+  /// line/column are 1-indexed.
+  fn check_error_invariants(text: &str, err: &ParseError) {
+    let r = err.range();
+    assert!(r.start <= r.end, "error range reversed: {:?}", r);
+    assert!(
+      r.end <= text.len(),
+      "error range {:?} out of bounds (len {})",
+      r,
+      text.len()
+    );
+    assert!(
+      text.is_char_boundary(r.start) && text.is_char_boundary(r.end),
+      "error range {:?} not on char boundary in {:?}",
+      r,
+      text
+    );
+    assert!(err.line_display() >= 1, "line_display must be 1-indexed");
+    assert!(err.column_display() >= 1, "column_display must be 1-indexed");
+  }
+
+  /// Runs every parse entry point on `text` with drawn options. The property
+  /// is only "no panic / no crash" plus error-range invariants.
+  fn exercise_parsers(tc: &hegel::TestCase, text: &str) {
+    let parse_options = draw_parse_options(tc);
+    if let Err(err) = parse_to_value(text, &parse_options) {
+      check_error_invariants(text, &err);
+    }
+    let collect_options = draw_collect_options(tc);
+    if let Err(err) = parse_to_ast(text, &collect_options, &parse_options) {
+      check_error_invariants(text, &err);
+    }
+    #[cfg(feature = "serde")]
+    {
+      if let Err(err) = jsonc_parser::parse_to_serde_value::<serde_json::Value>(text, &parse_options) {
+        check_error_invariants(text, &err);
+      }
+    }
+    #[cfg(feature = "cst")]
+    {
+      if let Err(err) = jsonc_parser::cst::CstRootNode::parse(text, &parse_options) {
+        check_error_invariants(text, &err);
+      }
+    }
+  }
+
+  // ---------------------------------------------------------------------
+  // JSONC writer: serializes a serde_json::Value to JSONC text with random
+  // comments, whitespace, and trailing commas inserted at token boundaries.
+  // ---------------------------------------------------------------------
+
+  fn draw_comment_text(tc: &hegel::TestCase) -> String {
+    // no '*' or '/' (would close a block comment), no newlines (would end a
+    // line comment early)
+    tc.draw(generators::from_regex(r"[ a-zA-Z0-9_.,;:!?()-]{0,12}"))
+  }
+
+  /// Encodes a string as a single-quoted JSONC string literal.
+  fn encode_single_quoted(s: &str) -> String {
+    let mut out = String::from("'");
+    for c in s.chars() {
+      match c {
+        '\'' => out.push_str("\\'"),
+        '\\' => out.push_str("\\\\"),
+        '\u{8}' => out.push_str("\\b"),
+        '\u{c}' => out.push_str("\\f"),
+        '\n' => out.push_str("\\n"),
+        '\r' => out.push_str("\\r"),
+        '\t' => out.push_str("\\t"),
+        c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
+        c => out.push(c),
+      }
+    }
+    out.push('\'');
+    out
+  }
+
+  /// Whether a key can be written as an unquoted word without changing how
+  /// the scanner tokenizes it.
+  fn is_safe_bare_key(key: &str) -> bool {
+    let mut chars = key.chars();
+    let first_ok = matches!(chars.next(), Some(c) if c.is_ascii_alphabetic() || c == '_');
+    if !first_ok || !chars.all(|c| c.is_ascii_alphanumeric() || c == '_' || c == '-') {
+      return false;
+    }
+    // a keyword followed by a non-alphanumeric char ('-'/'_') tokenizes as the
+    // keyword plus a separate word, so those keys can't be written bare
+    for kw in ["true", "false", "null"] {
+      if key == kw || (key.starts_with(kw) && !key.as_bytes()[kw.len()].is_ascii_alphanumeric()) {
+        return false;
+      }
+    }
+    true
+  }
+
+  /// Appends drawn trivia (whitespace and/or comments) to `out`.
+  fn draw_trivia(tc: &hegel::TestCase, out: &mut String) {
+    let kind = tc.draw(generators::integers::<u8>().max_value(9));
+    match kind {
+      0..=4 => {} // usually nothing
+      5 => out.push(' '),
+      6 => out.push_str("\n  "),
+      7 => out.push('\t'),
+      8 => {
+        let c = draw_comment_text(tc);
+        out.push_str("/*");
+        out.push_str(&c);
+        out.push_str("*/");
+      }
+      9 => {
+        let c = draw_comment_text(tc);
+        out.push_str("//");
+        out.push_str(&c);
+        out.push('\n');
+      }
+      _ => unreachable!(),
+    }
+  }
+
+  /// Draws either a comma or a "missing comma" (a newline, which the default
+  /// options accept as an element/property separator).
+  fn draw_separator(tc: &hegel::TestCase, out: &mut String) {
+    if tc.draw(generators::booleans()) {
+      out.push(',');
+    } else {
+      out.push('\n');
+    }
+  }
+
+  fn write_jsonc(tc: &hegel::TestCase, value: &serde_json::Value, out: &mut String) {
+    match value {
+      serde_json::Value::Array(items) => {
+        out.push('[');
+        for (i, item) in items.iter().enumerate() {
+          draw_trivia(tc, out);
+          write_jsonc(tc, item, out);
+          if i + 1 < items.len() {
+            draw_trivia(tc, out);
+            draw_separator(tc, out);
+          }
+        }
+        if !items.is_empty() && tc.draw(generators::booleans()) {
+          draw_trivia(tc, out);
+          out.push(','); // trailing comma
+        }
+        draw_trivia(tc, out);
+        out.push(']');
+      }
+      serde_json::Value::Object(map) => {
+        out.push('{');
+        for (i, (key, item)) in map.iter().enumerate() {
+          draw_trivia(tc, out);
+          // key encoding: bare word / single-quoted / double-quoted
+          if is_safe_bare_key(key) && tc.draw(generators::booleans()) {
+            out.push_str(key);
+            // a bare word only terminates at whitespace or ':' (parse_word),
+            // so it must not butt directly against a comment
+            out.push(' ');
+          } else if tc.draw(generators::booleans()) {
+            out.push_str(&encode_single_quoted(key));
+          } else {
+            out.push_str(&serde_json::to_string(key).unwrap());
+          }
+          draw_trivia(tc, out);
+          out.push(':');
+          draw_trivia(tc, out);
+          write_jsonc(tc, item, out);
+          if i + 1 < map.len() {
+            draw_trivia(tc, out);
+            draw_separator(tc, out);
+          }
+        }
+        if !map.is_empty() && tc.draw(generators::booleans()) {
+          draw_trivia(tc, out);
+          out.push(','); // trailing comma
+        }
+        draw_trivia(tc, out);
+        out.push('}');
+      }
+      serde_json::Value::String(s) => {
+        if tc.draw(generators::booleans()) {
+          out.push_str(&encode_single_quoted(s));
+        } else {
+          out.push_str(&serde_json::to_string(value).unwrap());
+        }
+      }
+      serde_json::Value::Number(_) => {
+        let lit = serde_json::to_string(value).unwrap();
+        if !lit.starts_with('-') && tc.draw(generators::booleans()) {
+          out.push('+'); // unary plus
+        }
+        out.push_str(&lit);
+      }
+      other => out.push_str(&serde_json::to_string(other).unwrap()),
+    }
+  }
+
+  /// Draws a serde_json::Value and a JSONC rendering of it with random trivia.
+  fn draw_value_and_jsonc_text(tc: &hegel::TestCase) -> (serde_json::Value, String) {
+    let value: serde_json::Value = tc.draw(json_gs::values());
+    let mut text = String::new();
+    draw_trivia(tc, &mut text);
+    write_jsonc(tc, &value, &mut text);
+    draw_trivia(tc, &mut text);
+    (value, text)
+  }
+
+  // ---------------------------------------------------------------------
+  // 1. JSON-subset differential: any valid JSON document must parse to the
+  //    same value under jsonc-parser as under serde_json, for every option
+  //    combination (options only *add* extensions).
+  // ---------------------------------------------------------------------
+
+  #[cfg(feature = "serde")]
+  #[hegel::test]
+  fn pbt_valid_json_differential_vs_serde_json(tc: hegel::TestCase) {
+    let value: serde_json::Value = tc.draw(json_gs::values());
+    let pretty = tc.draw(generators::booleans());
+    let text = if pretty {
+      serde_json::to_string_pretty(&value).unwrap()
+    } else {
+      serde_json::to_string(&value).unwrap()
+    };
+
+    // oracle sanity check: serde_json round-trips its own output
+    let oracle: serde_json::Value = serde_json::from_str(&text).unwrap();
+    assert_eq!(oracle, value);
+
+    // strict JSON mode must accept valid JSON and agree with serde_json
+    let strict: serde_json::Value =
+      jsonc_parser::parse_to_serde_value(&text, &strict_options()).expect("strict mode must accept valid JSON");
+    assert_eq!(strict, value, "strict-mode value mismatch for {:?}", text);
+
+    // any option combination must accept valid JSON and agree with serde_json
+    let opts = draw_parse_options(&tc);
+    let loose: serde_json::Value =
+      jsonc_parser::parse_to_serde_value(&text, &opts).expect("every option combo must accept valid JSON");
+    assert_eq!(loose, value, "loose-mode value mismatch for {:?}", text);
+
+    // the JsonValue path must agree too, using serde_json::Number::from_str
+    // as the independent number oracle
+    let json_value = parse_to_value(&text, &strict_options())
+      .expect("parse_to_value must accept valid JSON")
+      .expect("non-empty input must produce a value");
+    assert_json_value_matches_serde(&json_value, &value);
+  }
+
+  /// Structural comparison between jsonc-parser's `JsonValue` and a
+  /// `serde_json::Value`, treating number literals via serde_json's own
+  /// number parser (an oracle independent of jsonc-parser).
+  fn assert_json_value_matches_serde(actual: &JsonValue, expected: &serde_json::Value) {
+    use std::str::FromStr;
+    match (actual, expected) {
+      (JsonValue::Null, serde_json::Value::Null) => {}
+      (JsonValue::Boolean(a), serde_json::Value::Bool(b)) => assert_eq!(a, b),
+      (JsonValue::String(a), serde_json::Value::String(b)) => assert_eq!(a.as_ref(), b.as_str()),
+      (JsonValue::Number(lit), serde_json::Value::Number(b)) => {
+        let parsed = serde_json::Number::from_str(lit)
+          .unwrap_or_else(|e| panic!("number literal {:?} not parseable by serde_json: {}", lit, e));
+        assert_eq!(&parsed, b, "number literal {:?} disagreement", lit);
+      }
+      (JsonValue::Array(a), serde_json::Value::Array(b)) => {
+        assert_eq!(a.len(), b.len(), "array length mismatch");
+        for (av, bv) in a.iter().zip(b.iter()) {
+          assert_json_value_matches_serde(av, bv);
+        }
+      }
+      (JsonValue::Object(a), serde_json::Value::Object(b)) => {
+        assert_eq!(a.len(), b.len(), "object size mismatch");
+        for (key, bv) in b.iter() {
+          let av = a
+            .get(key)
+            .unwrap_or_else(|| panic!("key {:?} missing from parsed object", key));
+          assert_json_value_matches_serde(av, bv);
+        }
+      }
+      (a, b) => panic!("value kind mismatch: {:?} vs {:?}", a, b),
+    }
+  }
+
