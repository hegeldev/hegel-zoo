+  // ---------------------------------------------------------------------
+  // JsonObject typed accessors: get_*/take_* return Some exactly when the
+  // stored value has that type, and a mismatched take must not remove the
+  // entry.
+  // ---------------------------------------------------------------------
+
+  #[hegel::test]
+  fn pbt_json_object_typed_accessors(tc: hegel::TestCase) {
+    let keys: Vec<String> = tc.draw(
+      generators::vecs(generators::text().max_size(8))
+        .max_size(8)
+        .unique(true),
+    );
+    let mut map = serde_json::Map::new();
+    for key in &keys {
+      let value: serde_json::Value = tc.draw(json_gs::values());
+      map.insert(key.clone(), value);
+    }
+    let text = serde_json::to_string(&serde_json::Value::Object(map.clone())).unwrap();
+    let parsed = parse_to_value(&text, &strict_options())
+      .expect("valid JSON object must parse")
+      .expect("non-empty input must produce a value");
+    let mut obj = match parsed {
+      JsonValue::Object(o) => o,
+      other => panic!("expected object, got {:?}", other),
+    };
+    assert_eq!(obj.len(), map.len());
+    for (key, expected) in &map {
+      // getters agree with the stored type
+      assert!(obj.get(key).is_some(), "get must find key {:?}", key);
+      assert_eq!(
+        obj.get_string(key).is_some(),
+        expected.is_string(),
+        "get_string type check for {:?}",
+        key
+      );
+      assert_eq!(
+        obj.get_number(key).is_some(),
+        expected.is_number(),
+        "get_number type check for {:?}",
+        key
+      );
+      assert_eq!(
+        obj.get_boolean(key).is_some(),
+        expected.is_boolean(),
+        "get_boolean type check for {:?}",
+        key
+      );
+      assert_eq!(
+        obj.get_object(key).is_some(),
+        expected.is_object(),
+        "get_object type check for {:?}",
+        key
+      );
+      assert_eq!(
+        obj.get_array(key).is_some(),
+        expected.is_array(),
+        "get_array type check for {:?}",
+        key
+      );
+
+      // a mismatched take must return None and leave the entry in place
+      let wrong_take_was_none = match expected {
+        serde_json::Value::String(_) => obj.take_number(key).is_none(),
+        serde_json::Value::Number(_) => obj.take_string(key).is_none(),
+        serde_json::Value::Bool(_) => obj.take_object(key).is_none(),
+        serde_json::Value::Object(_) => obj.take_array(key).is_none(),
+        serde_json::Value::Array(_) => obj.take_boolean(key).is_none(),
+        serde_json::Value::Null => obj.take_string(key).is_none(),
+      };
+      assert!(wrong_take_was_none, "mismatched take must return None for {:?}", key);
+      assert!(
+        obj.get(key).is_some(),
+        "mismatched take must not remove the entry for {:?}",
+        key
+      );
+
+      // the correctly-typed take must return the value
+      match expected {
+        serde_json::Value::String(s) => {
+          assert_eq!(obj.take_string(key).as_deref(), Some(s.as_str()));
+        }
+        serde_json::Value::Number(n) => {
+          use std::str::FromStr;
+          let lit = obj.take_number(key).expect("typed take must succeed");
+          assert_eq!(&serde_json::Number::from_str(lit).unwrap(), n);
+        }
+        serde_json::Value::Bool(b) => assert_eq!(obj.take_boolean(key), Some(*b)),
+        serde_json::Value::Object(o) => {
+          assert_eq!(obj.take_object(key).expect("typed take must succeed").len(), o.len());
+        }
+        serde_json::Value::Array(a) => {
+          assert_eq!(obj.take_array(key).expect("typed take must succeed").len(), a.len());
+        }
+        serde_json::Value::Null => assert_eq!(obj.take(key), Some(JsonValue::Null)),
+      }
+      assert!(obj.get(key).is_none(), "take must remove the entry for {:?}", key);
+    }
+    assert!(obj.is_empty(), "all entries must have been taken");
+  }
+
+  // ---------------------------------------------------------------------
+  // 13. Dual-parser differential: parse_to_ast and parse_to_value are two
+  //     separate parse loops over the same scanner; they must agree on
+  //     acceptance and on the resulting value.
+  // ---------------------------------------------------------------------
+
+  fn assert_ast_matches_json_value(ast_value: &ast::Value, value: &JsonValue) {
+    match (ast_value, value) {
+      (ast::Value::NullKeyword(_), JsonValue::Null) => {}
+      (ast::Value::BooleanLit(a), JsonValue::Boolean(b)) => assert_eq!(a.value, *b),
+      (ast::Value::StringLit(a), JsonValue::String(b)) => assert_eq!(a.value.as_ref(), b.as_ref()),
+      (ast::Value::NumberLit(a), JsonValue::Number(b)) => assert_eq!(&a.value, b),
+      (ast::Value::Array(a), JsonValue::Array(b)) => {
+        assert_eq!(a.elements.len(), b.len(), "array length disagreement");
+        for (av, bv) in a.elements.iter().zip(b.iter()) {
+          assert_ast_matches_json_value(av, bv);
+        }
+      }
+      (ast::Value::Object(a), JsonValue::Object(b)) => {
+        // for duplicate keys the map keeps the last value; mirror that
+        let mut props: HashMap<&str, &ast::Value> = HashMap::new();
+        for prop in &a.properties {
+          props.insert(prop.name.as_str(), &prop.value);
+        }
+        assert_eq!(props.len(), b.len(), "object size disagreement");
+        for (key, av) in props {
+          let bv = b
+            .get(key)
+            .unwrap_or_else(|| panic!("key {:?} missing from parse_to_value object", key));
+          assert_ast_matches_json_value(av, bv);
+        }
+      }
+      (a, b) => panic!("value kind disagreement: {:?} vs {:?}", a, b),
+    }
+  }
+
+  #[hegel::test]
+  fn pbt_parse_to_ast_agrees_with_parse_to_value(tc: hegel::TestCase) {
+    let text = if tc.draw(generators::booleans()) {
+      draw_value_and_jsonc_text(&tc).1
+    } else {
+      tc.draw(jsonc_soup())
+    };
+    let opts = draw_parse_options(&tc);
+    let value_result = parse_to_value(&text, &opts);
+    let ast_result = parse_to_ast(&text, &CollectOptions::default(), &opts);
+    assert_eq!(
+      value_result.is_ok(),
+      ast_result.is_ok(),
+      "acceptance disagreement on {:?}: value={:?} ast={:?}",
+      text,
+      value_result.as_ref().err().map(|e| e.to_string()),
+      ast_result.as_ref().err().map(|e| e.to_string()),
+    );
+    if let (Ok(value), Ok(ast)) = (value_result, ast_result) {
+      match (&value, &ast.value) {
+        (None, None) => {}
+        (Some(v), Some(a)) => assert_ast_matches_json_value(a, v),
+        (v, a) => panic!("presence disagreement on {:?}: value={:?} ast={:?}", text, v, a),
+      }
+    }
+  }
+}
