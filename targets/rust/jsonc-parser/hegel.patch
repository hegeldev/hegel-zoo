+  // ---------------------------------------------------------------------
+  // Strict mode ("Parse Strictly as JSON" per the crate docs): each JSONC
+  // extension, injected into otherwise-valid JSON, must be rejected when all
+  // options are false.
+  // ---------------------------------------------------------------------
+
+  #[hegel::test]
+  fn pbt_strict_mode_rejects_jsonc_extensions(tc: hegel::TestCase) {
+    let value: serde_json::Value = tc.draw(json_gs::values());
+    let json = serde_json::to_string(&value).unwrap();
+    let kind = tc.draw(generators::integers::<u8>().max_value(8));
+    let text = match kind {
+      0 => format!("{} // comment", json),
+      1 => format!("/* comment */ {}", json),
+      2 => format!("[{},]", json),                  // trailing comma in array
+      3 => format!("{{\"k\": {},}}", json),         // trailing comma in object
+      4 => format!("['s', {}]", json),              // single-quoted string
+      5 => format!("{{k: {}}}", json),              // word property name
+      6 => format!("{{\"a\": 1 \"b\": {}}}", json), // missing comma in object
+      7 => format!("[0xFF, {}]", json),             // hexadecimal number
+      8 => format!("[+1, {}]", json),               // unary plus number
+      _ => unreachable!(),
+    };
+    // sanity: the mutation really is invalid strict JSON
+    assert!(
+      serde_json::from_str::<serde_json::Value>(&text).is_err(),
+      "mutation {} produced valid JSON: {:?}",
+      kind,
+      text
+    );
+    let result = parse_to_value(&text, &strict_options());
+    assert!(
+      result.is_err(),
+      "strict mode must reject JSONC extension (kind {}): {:?}",
+      kind,
+      text
+    );
+    // NOTE: missing commas between ARRAY elements are deliberately absent from
+    // the kinds above: strict mode accepts them, which is a bug — see the
+    // pinned test pbt_strict_mode_rejects_missing_array_commas below.
+  }
+
+  // KNOWN FAILURE: strict mode (all ParseOptions false, documented as "Parse
+  // Strictly as JSON") accepts missing commas between ARRAY elements, e.g.
+  // `[1 2]`, even though `allow_missing_commas: false` rejects them between
+  // object properties. serde_json rejects these inputs. Code path:
+  // `JsoncParser::scan_array_comma` (src/parser.rs) returns any non-comma
+  // token as the next element without consulting `allow_missing_commas`,
+  // and `parse_array` in src/parse_to_ast.rs has the same gap (its
+  // missing-comma check exists only in `parse_object`). The same code ships
+  // in upstream jsonc-parser 0.33.0, so this is an inherited contract bug,
+  // not a local regression. This test is expected to FAIL until that is
+  // fixed; it fails deterministically on every case.
+  #[hegel::test]
+  fn pbt_strict_mode_rejects_missing_array_commas(tc: hegel::TestCase) {
+    let a: serde_json::Value = tc.draw(json_gs::values());
+    let b: serde_json::Value = tc.draw(json_gs::values());
+    let text = format!(
+      "[{} {}]",
+      serde_json::to_string(&a).unwrap(),
+      serde_json::to_string(&b).unwrap()
+    );
+    assert!(
+      serde_json::from_str::<serde_json::Value>(&text).is_err(),
+      "sanity: {:?} must not be valid JSON",
+      text
+    );
+    let result = parse_to_value(&text, &strict_options());
+    assert!(
+      result.is_err(),
+      "strict mode must reject missing commas between array elements: {:?}",
+      text
+    );
+  }
