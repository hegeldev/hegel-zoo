+  // ---------------------------------------------------------------------
+  // CST mutation API: replacing the root value through set_value must
+  // produce text that reparses to exactly the new value.
+  // ---------------------------------------------------------------------
+
+  #[cfg(feature = "cst")]
+  fn to_cst_input(v: &serde_json::Value) -> jsonc_parser::cst::CstInputValue {
+    use jsonc_parser::cst::CstInputValue;
+    match v {
+      serde_json::Value::Null => CstInputValue::Null,
+      serde_json::Value::Bool(b) => CstInputValue::Bool(*b),
+      serde_json::Value::Number(n) => CstInputValue::Number(n.to_string()),
+      serde_json::Value::String(s) => CstInputValue::String(s.clone()),
+      serde_json::Value::Array(items) => CstInputValue::Array(items.iter().map(to_cst_input).collect()),
+      serde_json::Value::Object(map) => {
+        CstInputValue::Object(map.iter().map(|(k, v)| (k.clone(), to_cst_input(v))).collect())
+      }
+    }
+  }
+
+  #[cfg(all(feature = "cst", feature = "serde"))]
+  #[hegel::test]
+  fn pbt_cst_set_value_roundtrip(tc: hegel::TestCase) {
+    let (_, text) = draw_value_and_jsonc_text(&tc);
+    let root = jsonc_parser::cst::CstRootNode::parse(&text, &ParseOptions::default())
+      .unwrap_or_else(|e| panic!("writer-generated JSONC must parse: {:?} -> {}", text, e));
+    let new_value: serde_json::Value = tc.draw(json_gs::values());
+    root.set_value(to_cst_input(&new_value));
+    let out = root.to_string();
+    let reparsed: serde_json::Value = jsonc_parser::parse_to_serde_value(&out, &ParseOptions::default())
+      .unwrap_or_else(|e| panic!("CST output must reparse: {:?} -> {}", out, e));
+    assert_eq!(
+      reparsed, new_value,
+      "set_value produced text {:?} that reparses to a different value",
+      out
+    );
+  }
