+  // ---------------------------------------------------------------------
+  // 4. Documented contract: empty or whitespace-only input parses to None.
+  // ---------------------------------------------------------------------
+
+  #[hegel::test]
+  fn pbt_whitespace_only_input_parses_to_none(tc: hegel::TestCase) {
+    let pieces: Vec<char> = tc.draw(generators::vecs(generators::sampled_from(vec![
+      ' ', '\t', '\n', '\r', '\u{0B}', '\u{0C}', '\u{A0}', '\u{1680}', '\u{2000}', '\u{2028}', '\u{2029}', '\u{3000}',
+    ])));
+    let text: String = pieces.into_iter().collect();
+    let result = parse_to_value(&text, &ParseOptions::default()).expect("whitespace-only input must parse");
+    assert!(result.is_none(), "whitespace-only input must produce None: {:?}", text);
+  }
+
+  // ---------------------------------------------------------------------
+  // 5. Deeply nested input must be rejected via the documented nesting-depth
+  //    limit, never by crashing the process (stack overflow).
+  // ---------------------------------------------------------------------
+
+  #[hegel::test]
+  fn pbt_deep_nesting_rejected_not_crashed(tc: hegel::TestCase) {
+    let depth = tc.draw(hegel::one_of!(
+      generators::integers::<usize>().min_value(1).max_value(600),
+      generators::sampled_from(vec![511usize, 512, 513, 514, 1000, 5000, 30_000]),
+    ));
+    let kind = tc.draw(generators::integers::<u8>().max_value(2));
+    let text = match kind {
+      0 => "[".repeat(depth) + &"]".repeat(depth),
+      1 => "{\"a\":".repeat(depth) + "1" + &"}".repeat(depth),
+      2 => "[".repeat(depth), // unterminated: error path at depth
+      _ => unreachable!(),
+    };
+
+    // parse_to_value: containers count 1 each; limit is 512
+    let result = parse_to_value(&text, &ParseOptions::default());
+    match kind {
+      0 | 1 => {
+        if depth <= 512 {
+          assert!(result.is_ok(), "depth {} should be accepted by parse_to_value", depth);
+        } else {
+          assert!(result.is_err(), "depth {} should be rejected by parse_to_value", depth);
+        }
+      }
+      _ => assert!(result.is_err(), "unterminated input must error"),
+    }
+
+    // parse_to_ast: its stack also counts object properties, so only assert
+    // loose bounds around its threshold, plus crash-freedom everywhere
+    let ast_result = parse_to_ast(&text, &CollectOptions::default(), &ParseOptions::default());
+    match kind {
+      0 | 1 => {
+        if depth <= 250 {
+          assert!(ast_result.is_ok(), "depth {} should be accepted by parse_to_ast", depth);
+        } else if depth >= 520 {
+          assert!(
+            ast_result.is_err(),
+            "depth {} should be rejected by parse_to_ast",
+            depth
+          );
+        }
+      }
+      _ => assert!(ast_result.is_err(), "unterminated input must error"),
+    }
+
+    #[cfg(feature = "cst")]
+    {
+      let cst_result = jsonc_parser::cst::CstRootNode::parse(&text, &ParseOptions::default());
+      match kind {
+        0 | 1 => {
+          if depth <= 250 {
+            let root = cst_result.expect("shallow input must build a CST");
+            assert_eq!(root.to_string(), text, "CST must round-trip deep input");
+          } else if depth >= 520 {
+            assert!(cst_result.is_err(), "depth {} should be rejected by CST parse", depth);
+          }
+        }
+        _ => assert!(cst_result.is_err(), "unterminated input must error"),
+      }
+    }
+  }
+
+  // ---------------------------------------------------------------------
+  // 6. Trivia insensitivity: inserting comments, whitespace, and trailing
+  //    commas at token boundaries must not change the parsed value.
+  // ---------------------------------------------------------------------
+
+  #[cfg(feature = "serde")]
+  #[hegel::test]
+  fn pbt_trivia_insensitivity(tc: hegel::TestCase) {
+    let (value, text) = draw_value_and_jsonc_text(&tc);
+    let parsed: serde_json::Value = jsonc_parser::parse_to_serde_value(&text, &ParseOptions::default())
+      .unwrap_or_else(|e| panic!("JSONC text must parse: {:?} -> {}", text, e));
+    assert_eq!(parsed, value, "trivia changed the parsed value of {:?}", text);
+  }
+
+  // ---------------------------------------------------------------------
+  // 7./8. Numbers: the scanner must return the exact lexeme, and the serde
+  //       path must agree with serde_json's number semantics.
+  // ---------------------------------------------------------------------
+
+  /// A syntactically valid JSON number literal, generated at the grammar.
+  /// The exponent is kept to <= 2 digits so the value stays finite in f64
+  /// (this protects the test's oracle, not the parser's contract).
+  #[hegel::composite]
+  fn json_number_literal(tc: &hegel::TestCase) -> String {
+    let mut s = String::new();
+    if tc.draw(generators::booleans()) {
+      s.push('-');
+    }
+    let int_digits: String = tc.draw(hegel::one_of!(
+      generators::just("0".to_string()),
+      generators::from_regex(r"[1-9][0-9]{0,24}"),
+    ));
+    s.push_str(&int_digits);
+    if tc.draw(generators::booleans()) {
+      s.push('.');
+      let frac: String = tc.draw(generators::from_regex(r"[0-9]{1,20}"));
+      s.push_str(&frac);
+    }
+    if tc.draw(generators::booleans()) {
+      s.push(tc.draw(generators::sampled_from(vec!['e', 'E'])));
+      match tc.draw(generators::integers::<u8>().max_value(2)) {
+        1 => s.push('+'),
+        2 => s.push('-'),
+        _ => {}
+      }
+      let exp: String = tc.draw(generators::from_regex(r"[0-9]{1,2}"));
+      s.push_str(&exp);
+    }
+    s
+  }
+
+  #[hegel::test]
+  fn pbt_number_lexeme_preserved(tc: hegel::TestCase) {
+    let lit = tc.draw(json_number_literal());
+    let parsed = parse_to_value(&lit, &strict_options())
+      .unwrap_or_else(|e| panic!("valid number literal {:?} must parse: {}", lit, e))
+      .expect("number literal must produce a value");
+    match parsed {
+      JsonValue::Number(n) => assert_eq!(n, lit, "scanner did not preserve the number lexeme"),
+      other => panic!("expected number for {:?}, got {:?}", lit, other),
+    }
+  }
+
+  #[cfg(feature = "serde")]
+  #[hegel::test]
+  fn pbt_number_differential_vs_serde_json(tc: hegel::TestCase) {
+    // mix grammar-generated literals with machine-integer boundary literals
+    let lit: String = tc.draw(hegel::one_of!(
+      json_number_literal(),
+      generators::integers::<i64>().map(|n| n.to_string()),
+      generators::integers::<u64>().map(|n| n.to_string()),
+    ));
+    // Known semantic divergence (matches upstream jsonc-parser 0.33.0, so not
+    // a local regression): the literal "-0" parses as integer 0 here, while
+    // serde_json deliberately keeps it as the float -0.0 to preserve the sign
+    // of zero. The crate documents no number-typing contract, so this is
+    // documented in HEGEL_REPORT.md rather than pinned as a failing test.
+    tc.assume(lit != "-0");
+    let expected: serde_json::Value =
+      serde_json::from_str(&lit).unwrap_or_else(|e| panic!("oracle rejected {:?}: {}", lit, e));
+    let actual: serde_json::Value = jsonc_parser::parse_to_serde_value(&lit, &strict_options())
+      .unwrap_or_else(|e| panic!("jsonc-parser rejected valid JSON number {:?}: {}", lit, e));
+    assert_eq!(actual, expected, "number semantics disagreement for literal {:?}", lit);
+  }
