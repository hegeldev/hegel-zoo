+/// Forward and reverse iteration over an arbitrary subslice agree with the
+/// `Vec<bool>` oracle.
+fn check_iteration<T, O>(bits: &[bool], start: usize, end: usize)
+where
+	T: BitStore,
+	O: BitOrder,
+{
+	let bv: BitVec<T, O> = bits.iter().copied().collect();
+	let slice = &bv[start .. end];
+	let model = &bits[start .. end];
+
+	let forward: Vec<bool> = slice.iter().by_vals().collect();
+	assert_eq!(forward, model);
+
+	let reverse: Vec<bool> = slice.iter().by_vals().rev().collect();
+	let mut expected = model.to_vec();
+	expected.reverse();
+	assert_eq!(reverse, expected);
+
+	assert_eq!(slice.iter().by_vals().len(), model.len());
+}
+
