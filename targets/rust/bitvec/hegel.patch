+/// Draws a `Vec<bool>` whose length is drawn separately so that multi-element
+/// spans (well past one storage element) are generated regularly.
+fn draw_bools(tc: &hegel::TestCase) -> Vec<bool> {
+	use hegel::generators;
+	let n = tc.draw(generators::integers::<usize>().max_value(200));
