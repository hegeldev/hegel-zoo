+/// The same logical bit sequence is `==` no matter which storage type and
+/// bit-ordering hold it, and flipping any single bit breaks the equality.
+#[hegel::test]
+#[cfg(feature = "alloc")]
+fn equality_is_logical_not_representational(tc: hegel::TestCase) {
+	use hegel::generators;
+	let bits = draw_bools(&tc);
+
+	let a: BitVec<u8, Lsb0> = bits.iter().copied().collect();
+	let b: BitVec<u16, Msb0> = bits.iter().copied().collect();
+	let c: BitVec<u32, Lsb0> = bits.iter().copied().collect();
+	let d: BitVec<usize, Msb0> = bits.iter().copied().collect();
+
+	assert_eq!(a, b);
+	assert_eq!(a, c);
+	assert_eq!(a, d);
+	assert_eq!(b, c);
+	assert_eq!(b, d);
+	assert_eq!(c, d);
+
+	if !bits.is_empty() {
+		let flip = tc
+			.draw(generators::integers::<usize>().max_value(bits.len() - 1));
+		let mut e = b.clone();
+		let bit = e[flip];
+		e.set(flip, !bit);
+		assert_ne!(a, e, "flipping bit {} must break equality", flip);
+	}
+}
