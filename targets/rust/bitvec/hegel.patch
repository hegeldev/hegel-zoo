+/// Stores a `u32` into an arbitrary bit-field region and loads it back: the
+/// loaded value must be the stored value truncated to the field width, and
+/// every bit outside the field must be untouched.
+fn check_store_load_roundtrip<O>(
+	data: &[u8],
+	start: usize,
+	width: usize,
+	value: u32,
+	big_endian: bool,
+) where
+	O: BitOrder,
+	BitSlice<u8, O>: BitField,
+{
+	let mask = if width == 32 {
+		u32::MAX
+	}
+	else {
+		(1u32 << width) - 1
+	};
+
+	let mut bv: BitVec<u8, O> = BitVec::from_slice(data);
+	let before: Vec<bool> = bv.iter().by_vals().collect();
+	let end = start + width;
+
+	let (loaded, restored) = if big_endian {
+		bv[start .. end].store_be::<u32>(value);
+		(bv[start .. end].load_be::<u32>(), {
+			let mut bv2 = bv.clone();
+			bv2[start .. end].store_be::<u32>(value & mask);
+			bv2[start .. end].load_be::<u32>()
+		})
+	}
+	else {
+		bv[start .. end].store_le::<u32>(value);
+		(bv[start .. end].load_le::<u32>(), {
+			let mut bv2 = bv.clone();
+			bv2[start .. end].store_le::<u32>(value & mask);
+			bv2[start .. end].load_le::<u32>()
+		})
+	};
+
+	//  The documented contract: excess high bits of `value` are truncated.
+	assert_eq!(
+		loaded,
+		value & mask,
+		"store/load roundtrip through [{}..{}] (be: {})",
+		start,
+		end,
+		big_endian,
+	);
+	//  Storing the pre-masked value must give the same result.
+	assert_eq!(restored, value & mask);
+
+	//  Every bit outside the stored field is untouched.
+	let after: Vec<bool> = bv.iter().by_vals().collect();
+	for (i, (&was, &is)) in before.iter().zip(after.iter()).enumerate() {
+		if !(start .. end).contains(&i) {
+			assert_eq!(was, is, "bit {} outside [{}..{}] changed", i, start, end);
+		}
+	}
+}
+
+/// `store_le`/`load_le` and `store_be`/`load_be` roundtrip any value through
+/// any legal field region, truncating to the field width and leaving all
+/// other bits alone, in both orderings.
+#[hegel::test]
+fn store_load_roundtrip(tc: hegel::TestCase) {
+	use hegel::generators;
+	//  At least 4 bytes so that every legal `u32` width fits somewhere.
+	let n = tc.draw(generators::integers::<usize>().min_value(4).max_value(16));
+	let data: Vec<u8> = tc.draw(
+		generators::vecs(generators::integers::<u8>())
+			.min_size(n)
+			.max_size(n),
+	);
+	let total_bits = data.len() * 8;
+	//  Field widths are legal in `1 ..= 32` for a `u32` transfer type.
+	let width = tc.draw(generators::integers::<usize>().min_value(1).max_value(32));
+	let start = tc.draw(
+		generators::integers::<usize>().max_value(total_bits - width),
+	);
+	let value = tc.draw(generators::integers::<u32>());
+	let big_endian = tc.draw(generators::booleans());
+
+	check_store_load_roundtrip::<Lsb0>(&data, start, width, value, big_endian);
+	check_store_load_roundtrip::<Msb0>(&data, start, width, value, big_endian);
+}
