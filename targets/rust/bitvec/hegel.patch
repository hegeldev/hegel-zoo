+/// Draws the operands for a bit-op property: an unaligned live region `a`
+/// surrounded by padding, and an independently-sized right-hand side `b`.
+fn draw_bitop_operands(
+	tc: &hegel::TestCase,
+) -> (Vec<bool>, Vec<bool>, Vec<bool>, Vec<bool>) {
+	use hegel::generators;
+	let short = generators::vecs(generators::booleans()).max_size(16);
+	let prefix: Vec<bool> = tc.draw(short);
+	let suffix: Vec<bool> =
+		tc.draw(generators::vecs(generators::booleans()).max_size(16));
+	//  Draw the live lengths separately so multi-element regions (and length
+	//  mismatches in both directions) occur regularly.
+	let a_len = tc.draw(generators::integers::<usize>().max_value(150));
+	let b_len = tc.draw(generators::integers::<usize>().max_value(150));
+	let a: Vec<bool> = tc.draw(
+		generators::vecs(generators::booleans())
+			.min_size(a_len)
+			.max_size(a_len),
+	);
+	let b: Vec<bool> = tc.draw(
+		generators::vecs(generators::booleans())
+			.min_size(b_len)
+			.max_size(b_len),
+	);
+	(prefix, a, suffix, b)
+}
