+/// A stateful model test: a `BitVec` must behave exactly like a `Vec<bool>`
+/// under every sequence of mutating operations.
+struct BvModel<T, O>
+where
+	T: BitStore,
+	O: BitOrder,
+{
+	bv: BitVec<T, O>,
+	model: Vec<bool>,
+}
+
+#[hegel::state_machine]
+impl<T, O> BvModel<T, O>
+where
+	T: BitStore,
+	O: BitOrder,
+{
+	#[rule]
+	fn push(&mut self, tc: hegel::TestCase) {
+		let bit = tc.draw(hegel::generators::booleans());
+		self.bv.push(bit);
+		self.model.push(bit);
+	}
+
+	#[rule]
+	fn pop(&mut self, _: hegel::TestCase) {
+		assert_eq!(self.bv.pop(), self.model.pop());
+	}
+
+	#[rule]
+	fn insert(&mut self, tc: hegel::TestCase) {
+		use hegel::generators;
+		let index = tc.draw(
+			generators::integers::<usize>().max_value(self.model.len()),
+		);
+		let bit = tc.draw(generators::booleans());
+		self.bv.insert(index, bit);
+		self.model.insert(index, bit);
+	}
+
+	#[rule]
+	fn remove(&mut self, tc: hegel::TestCase) {
+		tc.assume(!self.model.is_empty());
+		let index = tc.draw(
+			hegel::generators::integers::<usize>()
+				.max_value(self.model.len() - 1),
+		);
+		assert_eq!(self.bv.remove(index), self.model.remove(index));
+	}
+
+	#[rule]
+	fn swap_remove(&mut self, tc: hegel::TestCase) {
+		tc.assume(!self.model.is_empty());
+		let index = tc.draw(
+			hegel::generators::integers::<usize>()
+				.max_value(self.model.len() - 1),
+		);
+		assert_eq!(self.bv.swap_remove(index), self.model.swap_remove(index));
+	}
+
+	#[rule]
+	fn set(&mut self, tc: hegel::TestCase) {
+		use hegel::generators;
+		tc.assume(!self.model.is_empty());
+		let index = tc.draw(
+			generators::integers::<usize>().max_value(self.model.len() - 1),
+		);
+		let bit = tc.draw(generators::booleans());
+		self.bv.set(index, bit);
+		self.model[index] = bit;
+	}
+
+	#[rule]
+	fn get(&mut self, tc: hegel::TestCase) {
+		//  Deliberately allow out-of-range indices: `get` must return `None`
+		//  exactly when the model does.
+		let index = tc.draw(
+			hegel::generators::integers::<usize>()
+				.max_value(self.model.len() + 2),
+		);
+		assert_eq!(
+			self.bv.get(index).map(|bit| *bit),
+			self.model.get(index).copied(),
+		);
+	}
+
+	#[rule]
+	fn truncate(&mut self, tc: hegel::TestCase) {
+		//  Truncating past the length must be a no-op, so overshoot sometimes.
+		let new_len = tc.draw(
+			hegel::generators::integers::<usize>()
+				.max_value(self.model.len() + 8),
+		);
+		self.bv.truncate(new_len);
+		self.model.truncate(new_len);
+	}
+
+	#[rule]
+	fn extend(&mut self, tc: hegel::TestCase) {
+		let bits = draw_bools(&tc);
+		self.bv.extend(bits.iter().copied());
+		self.model.extend(bits.iter().copied());
+	}
+
+	#[rule]
+	fn extend_from_bitslice(&mut self, tc: hegel::TestCase) {
+		//  The source deliberately uses different type parameters, so this
+		//  exercises the cross-ordering/cross-storage extension path.
+		let bits = draw_bools(&tc);
+		let source: BitVec<u8, Msb0> = bits.iter().copied().collect();
+		self.bv.extend_from_bitslice(source.as_bitslice());
+		self.model.extend(bits.iter().copied());
+	}
+
+	#[rule]
+	fn split_off(&mut self, tc: hegel::TestCase) {
+		let at = tc.draw(
+			hegel::generators::integers::<usize>()
+				.max_value(self.model.len()),
+		);
+		let bv_tail = self.bv.split_off(at);
+		let model_tail = self.model.split_off(at);
+		assert_eq!(
+			bv_tail.iter().by_vals().collect::<Vec<bool>>(),
+			model_tail,
+		);
+	}
+
+	#[rule]
+	fn reserve(&mut self, tc: hegel::TestCase) {
+		let additional = tc
+			.draw(hegel::generators::integers::<usize>().max_value(500));
+		self.bv.reserve(additional);
+		assert!(self.bv.capacity() >= self.model.len() + additional);
+	}
+
+	#[rule]
+	fn shrink_and_realign(&mut self, tc: hegel::TestCase) {
+		//  None of these operations may change the logical contents.
+		let uninit = tc.draw(hegel::generators::booleans());
+		self.bv.set_uninitialized(uninit);
+		self.bv.force_align();
+		self.bv.shrink_to_fit();
+	}
+
+	#[invariant]
+	fn agrees_with_model(&self, _: hegel::TestCase) {
+		assert_eq!(self.bv.len(), self.model.len());
+		assert_eq!(self.bv.is_empty(), self.model.is_empty());
+		assert_eq!(
+			self.bv.iter().by_vals().collect::<Vec<bool>>(),
+			self.model,
+		);
+		assert_eq!(
+			self.bv.count_ones(),
+			self.model.iter().filter(|&&bit| bit).count(),
+		);
+	}
+}
+
