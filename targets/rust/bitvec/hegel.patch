+/// Applies `apply` to an unaligned subslice of a `BitVec<T1, O1>` and an
+/// entire `BitSlice<T2, O2>`, then checks every live bit against `oracle`
+/// (which receives `None` for positions past the end of `b`, since the
+/// documented behavior zero-extends a short right-hand side) and checks that
+/// the padding around the live region is untouched.
+fn check_bitop_assign<T1, O1, T2, O2>(
+	prefix: &[bool],
+	a: &[bool],
+	suffix: &[bool],
+	b: &[bool],
+	apply: impl Fn(&mut BitSlice<T1, O1>, &BitSlice<T2, O2>),
+	oracle: impl Fn(bool, Option<bool>) -> bool,
+) where
+	T1: BitStore,
+	O1: BitOrder,
+	T2: BitStore,
+	O2: BitOrder,
+{
+	let mut lhs: BitVec<T1, O1> = prefix
+		.iter()
+		.chain(a.iter())
+		.chain(suffix.iter())
+		.copied()
+		.collect();
+	let rhs: BitVec<T2, O2> = b.iter().copied().collect();
+	let start = prefix.len();
+	let end = start + a.len();
+
+	apply(&mut lhs[start .. end], rhs.as_bitslice());
+
+	for (i, &was) in a.iter().enumerate() {
+		assert_eq!(
+			lhs[start + i],
+			oracle(was, b.get(i).copied()),
+			"live bit {} disagrees with the oracle",
+			i,
+		);
+	}
+	for (i, &p) in prefix.iter().enumerate() {
+		assert_eq!(lhs[i], p, "prefix bit {} was modified", i);
+	}
+	for (i, &s) in suffix.iter().enumerate() {
+		assert_eq!(lhs[end + i], s, "suffix bit {} was modified", i);
+	}
+}
+
+/// `&=` ANDs against the zero-extended right-hand side: excess bits of `self`
+/// are cleared. Checked on both the specialized same-type/same-ordering paths
+/// and the bit-by-bit mixed paths.
+#[hegel::test]
+fn bitand_assign_matches_bool_oracle(tc: hegel::TestCase) {
+	let (prefix, a, suffix, b) = draw_bitop_operands(&tc);
+	let oracle = |l: bool, r: Option<bool>| l & r.unwrap_or(false);
+	check_bitop_assign::<u8, Lsb0, u8, Lsb0>(
+		&prefix,
+		&a,
+		&suffix,
+		&b,
+		|l, r| *l &= r,
+		oracle,
+	);
+	check_bitop_assign::<u8, Msb0, u8, Msb0>(
+		&prefix,
+		&a,
+		&suffix,
+		&b,
+		|l, r| *l &= r,
+		oracle,
+	);
+	check_bitop_assign::<u8, Lsb0, u16, Msb0>(
+		&prefix,
+		&a,
+		&suffix,
+		&b,
+		|l, r| *l &= r,
+		oracle,
+	);
+	check_bitop_assign::<u16, Msb0, u8, Lsb0>(
+		&prefix,
+		&a,
+		&suffix,
+		&b,
+		|l, r| *l &= r,
+		oracle,
