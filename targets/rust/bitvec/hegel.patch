+/// Checks every counting and searching query on a subslice against a
+/// `Vec<bool>` oracle.
+fn check_counting<T, O>(bits: &[bool], start: usize, end: usize)
+where
+	T: BitStore,
+	O: BitOrder,
+{
+	let bv: BitVec<T, O> = bits.iter().copied().collect();
+	let slice = &bv[start .. end];
+	let model = &bits[start .. end];
+
+	let ones = model.iter().filter(|&&bit| bit).count();
+	assert_eq!(slice.count_ones(), ones);
+	assert_eq!(slice.count_zeros(), model.len() - ones);
+
+	assert_eq!(slice.first_one(), model.iter().position(|&bit| bit));
+	assert_eq!(slice.first_zero(), model.iter().position(|&bit| !bit));
+	//  KNOWN FAILURE exclusion: `last_one` on a bit-slice with no `1` bits,
+	//  and `last_zero` on a bit-slice with no `0` bits, panic with a
+	//  subtraction overflow in the `Msb0` specialization. See the canonical
+	//  failing tests `msb0_last_one_underflow_known_failure` and
+	//  `msb0_last_zero_underflow_known_failure` below; the buggy inputs are
+	//  excluded here so this property keeps testing everything else.
+	if ones > 0 {
+		assert_eq!(slice.last_one(), model.iter().rposition(|&bit| bit));
+	}
+	if ones < model.len() {
+		assert_eq!(slice.last_zero(), model.iter().rposition(|&bit| !bit));
+	}
+
+	assert_eq!(
+		slice.leading_ones(),
+		model.iter().take_while(|&&bit| bit).count(),
+	);
+	assert_eq!(
+		slice.leading_zeros(),
+		model.iter().take_while(|&&bit| !bit).count(),
+	);
+	//  KNOWN FAILURE exclusion, same bug as above: `trailing_ones` is
+	//  implemented via `last_zero`, and `trailing_zeros` via `last_one`, so
+	//  they panic on the same inputs.
+	if ones < model.len() {
+		assert_eq!(
+			slice.trailing_ones(),
+			model.iter().rev().take_while(|&&bit| bit).count(),
+		);
+	}
+	if ones > 0 {
+		assert_eq!(
+			slice.trailing_zeros(),
+			model.iter().rev().take_while(|&&bit| !bit).count(),
+		);
+	}
+
+	assert_eq!(slice.any(), ones > 0);
+	assert_eq!(slice.all(), ones == model.len());
+	assert_eq!(slice.not_any(), ones == 0);
+	assert_eq!(slice.not_all(), ones < model.len());
+	assert_eq!(slice.some(), ones > 0 && ones < model.len());
+}
+
+/** KNOWN FAILURE: `BitSlice<T, Msb0>::last_one` panics with "attempt to
+subtract with overflow" (debug builds) whenever the bit-slice contains no `1`
+bits at all and its domain is `Domain::Region` (i.e. it is not a strict
+interior enclave). Found by `counting_and_searching_match_bool_oracle`;
+minimal shrunk counterexample: `bits![u8, Msb0; 0].last_one()`.
+
+Root cause: in `src/slice/specialization/msb0.rs`, `sp_last_one` subtracts the
+tail/body skip distance from `out` *before* checking `has_one`. `out` begins
+at `len - 1`, so once every element has been skipped the final subtraction
+underflows `usize`. The `Lsb0` twin (`lsb0.rs::sp_last_one`) starts `out` at
+`len` instead, and so escapes by exactly one. In release builds the value
+wraps and the function still happens to return `None`.
+
+The documented contract (`doc/slice/last_one.md`, and Issue #114 which this
+API was rebuilt to fix) is that an empty search returns `None`, not a panic.
+`trailing_zeros` (implemented via `last_one`) and `trailing_ones` (via
+`last_zero`) panic on the same inputs.
+
+Do not "fix" this test — it pins the bug until the library is repaired.
+**/
+#[test]
+fn msb0_last_one_underflow_known_failure() {
+	assert_eq!(bits![u8, Msb0; 0].last_one(), None);
+	//  Also panics via the body-element arm: an aligned all-zero element.
+	assert_eq!(bits![u8, Msb0; 0; 8].last_one(), None);
+	//  And for every other storage type.
+	assert_eq!(bits![usize, Msb0; 0].last_one(), None);
+}
+
+/** KNOWN FAILURE: the mirror image of `msb0_last_one_underflow_known_failure`
+— `BitSlice<T, Msb0>::last_zero` panics with "attempt to subtract with
+overflow" (debug builds) whenever the bit-slice contains no `0` bits, from the
+same pre-check subtraction pattern in `msb0.rs::sp_last_zero`.
+**/
+#[test]
+fn msb0_last_zero_underflow_known_failure() {
+	assert_eq!(bits![u8, Msb0; 1].last_zero(), None);
+	assert_eq!(bits![u8, Msb0; 1; 8].last_zero(), None);
+}
+
+/// Every counting/searching query on an arbitrary subslice must agree with
+/// the `Vec<bool>` oracle, under both orderings and several storage widths.
+#[hegel::test]
+fn counting_and_searching_match_bool_oracle(tc: hegel::TestCase) {
+	let (bits, start, end) = draw_bits_and_range(&tc);
+	check_counting::<u8, Lsb0>(&bits, start, end);
+	check_counting::<u8, Msb0>(&bits, start, end);
+	check_counting::<u32, Lsb0>(&bits, start, end);
+	check_counting::<u16, Msb0>(&bits, start, end);
+}
