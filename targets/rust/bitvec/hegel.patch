+/// Rotates a subslice and compares against `<[bool]>::rotate_{left,right}`,
+/// also checking that bits outside the subslice are untouched.
+fn check_rotate<T, O>(bits: &[bool], start: usize, end: usize, by: usize)
+where
+	T: BitStore,
+	O: BitOrder,
+{
+	let mut bv: BitVec<T, O> = bits.iter().copied().collect();
+	bv[start .. end].rotate_left(by);
+	let mut expected = bits.to_vec();
+	expected[start .. end].rotate_left(by);
+	assert_eq!(
+		bv.iter().by_vals().collect::<Vec<bool>>(),
+		expected,
+		"rotate_left({}) on [{}..{}]",
+		by,
+		start,
+		end,
+	);
+
+	let mut bv: BitVec<T, O> = bits.iter().copied().collect();
+	bv[start .. end].rotate_right(by);
+	let mut expected = bits.to_vec();
+	expected[start .. end].rotate_right(by);
+	assert_eq!(
+		bv.iter().by_vals().collect::<Vec<bool>>(),
+		expected,
+		"rotate_right({}) on [{}..{}]",
+		by,
+		start,
+		end,
+	);
+}
+
+/// `rotate_left`/`rotate_right` on an arbitrary subslice agree with the
+/// `Vec<bool>` oracle, under both orderings.
+#[hegel::test]
+fn rotate_matches_bool_oracle(tc: hegel::TestCase) {
+	use hegel::generators;
+	let (bits, start, end) = draw_bits_and_range(&tc);
+	//  `by == len` is documented as a no-op, so include it in the domain.
+	let by = tc.draw(
+		generators::integers::<usize>().max_value(end - start),
