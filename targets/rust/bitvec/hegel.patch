+/// `!BitVec` must invert every live bit and preserve the length.
+#[hegel::test]
+fn not_inverts_every_live_bit(tc: hegel::TestCase) {
+	let bits = draw_bools(&tc);
+	let bv: BitVec<u8, Msb0> = bits.iter().copied().collect();
+
+	let inverted = !bv;
+
+	assert_eq!(inverted.len(), bits.len());
+	for (idx, (actual, expected)) in
+		inverted.iter().by_vals().zip(bits.iter()).enumerate()
+	{
+		assert_eq!(actual, !expected, "bit {} not inverted", idx);
+	}
+}
