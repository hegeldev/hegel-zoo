+#[hegel::test]
+fn iteration_matches_bool_oracle(tc: hegel::TestCase) {
+	let (bits, start, end) = draw_bits_and_range(&tc);
+	check_iteration::<u8, Lsb0>(&bits, start, end);
+	check_iteration::<u8, Msb0>(&bits, start, end);
+	check_iteration::<u32, Lsb0>(&bits, start, end);
+}
