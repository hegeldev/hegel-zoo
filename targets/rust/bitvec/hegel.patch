+/// Applies `shift_start`/`shift_end` to a subslice and checks the documented
+/// result — the retained bits move toward (away from) index zero and the
+/// vacated bits are cleared — plus that bits outside the subslice survive.
+fn check_shift<T, O>(bits: &[bool], start: usize, end: usize, by: usize)
+where
+	T: BitStore,
+	O: BitOrder,
+{
+	let mut bv: BitVec<T, O> = bits.iter().copied().collect();
+	bv[start .. end].shift_start(by);
+	let mut expected: Vec<bool> = bits.to_vec();
+	expected.copy_within(start + by .. end, start);
+	expected[end - by .. end].fill(false);
+	assert_eq!(
+		bv.iter().by_vals().collect::<Vec<bool>>(),
+		expected,
+		"shift_start({}) on [{}..{}]",
+		by,
+		start,
+		end,
+	);
+
+	let mut bv: BitVec<T, O> = bits.iter().copied().collect();
+	bv[start .. end].shift_end(by);
+	let mut expected: Vec<bool> = bits.to_vec();
+	expected.copy_within(start .. end - by, start + by);
+	expected[start .. start + by].fill(false);
+	assert_eq!(
+		bv.iter().by_vals().collect::<Vec<bool>>(),
+		expected,
+		"shift_end({}) on [{}..{}]",
+		by,
+		start,
+		end,
+	);
+}
+
+/// `shift_start`/`shift_end` on an arbitrary subslice agree with the
+/// `Vec<bool>` oracle and do not disturb surrounding bits.
+#[hegel::test]
+fn shifts_match_bool_oracle(tc: hegel::TestCase) {
+	use hegel::generators;
+	let (bits, start, end) = draw_bits_and_range(&tc);
+	let by = tc.draw(
+		generators::integers::<usize>().max_value(end - start),
+	);
+	check_shift::<u8, Lsb0>(&bits, start, end, by);
+	check_shift::<u8, Msb0>(&bits, start, end, by);
+	check_shift::<u16, Lsb0>(&bits, start, end, by);
+}
