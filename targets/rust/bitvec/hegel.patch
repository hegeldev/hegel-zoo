+/// `chunks` and `rchunks` over an arbitrary subslice agree chunk-for-chunk
+/// with `<[bool]>::chunks`/`rchunks`.
+fn check_chunks<T, O>(bits: &[bool], start: usize, end: usize, width: usize)
+where
+	T: BitStore,
+	O: BitOrder,
+{
+	let bv: BitVec<T, O> = bits.iter().copied().collect();
+	let slice = &bv[start .. end];
+	let model = &bits[start .. end];
+
+	assert_eq!(slice.chunks(width).count(), model.chunks(width).count());
+	for (chunk, expected) in slice.chunks(width).zip(model.chunks(width)) {
+		assert_eq!(chunk.iter().by_vals().collect::<Vec<bool>>(), expected);
+	}
+
+	assert_eq!(slice.rchunks(width).count(), model.rchunks(width).count());
+	for (chunk, expected) in slice.rchunks(width).zip(model.rchunks(width)) {
+		assert_eq!(chunk.iter().by_vals().collect::<Vec<bool>>(), expected);
+	}
