+/// The buffer returned by `as_raw_slice` must match the documented in-memory
+/// encoding: under `Lsb0`, semantic bit `i` is bit `i % width` counting up
+/// from the least significant bit of element `i / width`; under `Msb0` it
+/// counts down from the most significant bit.
+#[hegel::test]
+fn raw_slice_layout_matches_documented_encoding(tc: hegel::TestCase) {
+	let bits = draw_bools(&tc);
+
+	let lsb0: BitVec<u8, Lsb0> = bits.iter().copied().collect();
+	let msb0: BitVec<u8, Msb0> = bits.iter().copied().collect();
+	let raw_lsb0 = lsb0.as_raw_slice();
+	let raw_msb0 = msb0.as_raw_slice();
+
+	for (i, &bit) in bits.iter().enumerate() {
+		assert_eq!(
+			raw_lsb0[i / 8] >> (i % 8) & 1 == 1,
+			bit,
+			"Lsb0 layout mismatch at bit {}",
+			i,
+		);
+		assert_eq!(
+			raw_msb0[i / 8] >> (7 - i % 8) & 1 == 1,
+			bit,
+			"Msb0 layout mismatch at bit {}",
+			i,
+		);
+	}
+}
