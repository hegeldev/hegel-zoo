index 0000000..c0a2434
--- /dev/null
+++ b/tests/util/pbt.rs
@@ -0,0 +1,422 @@
+//! Shared generators and helpers for the hegel property-based tests in
+//! `tests/event_reader.rs` and `tests/event_writer.rs`. Every generator is a
+//! value built from the binding's combinators; what a case needs is drawn as
+//! a small record or tree (`Element`) and rendered by a pure function
+//! (`write_document`), so a failing case prints as the tree rather than as a
+//! transcript of draws.
+#![allow(dead_code)]
+
+use std::sync::OnceLock;
+
+use hegel::generators::{self, Generator};
+use hegel::{PrettyPrintable, PrintableGenerator};
+use xml::common::{is_name_char, is_name_start_char};
+use xml::reader::{EventReader, ParserConfig, XmlEvent};
+use xml::writer::{EmitterConfig, EventWriter, XmlEvent as WriterEvent};
+
+// ---------------------------------------------------------------------------
+// Known bugs
+// ---------------------------------------------------------------------------
+
+/// Whether the generators draw the shapes of the recorded bug xml-rs/1: a
+/// `\r` in character data (the writer leaves it unescaped and the reader's
+/// end-of-line normalisation rewrites it to `\n`) and a `\t` in an attribute
+/// value (unescaped too, and attribute-value normalisation turns it into a
+/// space). On by default, so the write-read round-trip properties find the
+/// bug and are the declared expected failures; `HEGEL_NO_KNOWN=1` (read once)
+/// switches the shapes off for a run that looks past it.
+pub fn known_shapes() -> bool {
+    static KNOWN: OnceLock<bool> = OnceLock::new();
+    *KNOWN.get_or_init(|| std::env::var_os("HEGEL_NO_KNOWN").map_or(true, |v| v != "1"))
+}
+
+// ---------------------------------------------------------------------------
+// Characters
+// ---------------------------------------------------------------------------
+
+/// The characters `lo..=hi`; every range used here lies within the scalar
+/// values.
+fn chars_in(lo: u32, hi: u32) -> impl PrintableGenerator<char> + Send + Sync + 'static {
+    generators::integers::<u32>()
+        .min_value(lo)
+        .max_value(hi)
+        .map(|n| char::from_u32(n).expect("a range of scalar values"))
+}
+
+/// Characters at the writer's escape-set boundary and other syntax
+/// characters, weighted into the content alphabet.
+const SYNTAX_CHARS: &[char] = &['\t', '\n', '<', '>', '&', '"', '\'', ';', '[', ']', '=', '-', ' '];
+/// The same for attribute values, without `\t`: its loss is xml-rs/1, and
+/// `ATTR_KNOWN_PIECES` puts it back while the known shapes are drawn.
+const ATTR_SYNTAX_CHARS: &[char] = &['\n', '<', '>', '&', '"', '\'', ';', '[', ']', '=', '-', ' '];
+/// The same for comments, without `-`: `--` cannot appear inside a comment
+/// and the writer rewrites it, so it cannot round-trip by design.
+const COMMENT_SYNTAX_CHARS: &[char] = &['\t', '\n', '<', '>', '&', '"', '\'', ';', '[', ']', '=', ' '];
+
+/// The non-ASCII characters of XML 1.0 content (U+FFFE and U+FFFF are not
+/// characters; surrogates are no `char`).
+fn non_ascii_content_chars() -> impl PrintableGenerator<char> + Send + Sync + 'static {
+    hegel::one_of!(
+        chars_in(0x7F, 0xD7FF),
+        chars_in(0xE000, 0xFFFD),
+        chars_in(0x10000, 0x10FFFF),
+    )
+}
+
+/// A character valid in XML 1.0 content other than `\r`: a syntax character
+/// (first, weighted in), printable ASCII, or a non-ASCII character.
+pub fn content_chars() -> impl PrintableGenerator<char> + Send + Sync + 'static {
+    hegel::one_of!(
+        generators::sampled_from(SYNTAX_CHARS),
+        chars_in(0x20, 0x7E),
+        non_ascii_content_chars(),
+    )
+}
+
+/// A content character for an attribute value: as `content_chars`, without
+/// `\t` (see `ATTR_SYNTAX_CHARS`).
+fn attr_chars() -> impl PrintableGenerator<char> + Send + Sync + 'static {
+    hegel::one_of!(
+        generators::sampled_from(ATTR_SYNTAX_CHARS),
+        chars_in(0x20, 0x7E),
+        non_ascii_content_chars(),
+    )
+}
+
+/// A content character for a comment: as `content_chars`, without `-` (see
+/// `COMMENT_SYNTAX_CHARS`).
+fn comment_chars() -> impl PrintableGenerator<char> + Send + Sync + 'static {
+    hegel::one_of!(
+        generators::sampled_from(COMMENT_SYNTAX_CHARS),
+        chars_in(0x20, 0x2C),
+        chars_in(0x2E, 0x7E),
+        non_ascii_content_chars(),
+    )
+}
+
+// ---------------------------------------------------------------------------
+// Names and texts
+// ---------------------------------------------------------------------------
+
+/// Subranges of NameStartChar (XML 1.1 section 2.3), excluding `:` so that
+/// generated names never look namespace-qualified.
+fn name_start_chars() -> impl PrintableGenerator<char> + Send + Sync + 'static {
+    hegel::one_of!(
+        chars_in('a' as u32, 'z' as u32),
+        chars_in('A' as u32, 'Z' as u32),
+        generators::just('_'),
+        chars_in(0xC0, 0xD6),
+        chars_in(0x370, 0x37D),
+        chars_in(0x2070, 0x218F),
+        chars_in(0x3001, 0xD7FF),
+        chars_in(0x10000, 0xEFFFF),
+    )
+}
+
+/// The NameChars that are not NameStartChars, besides digits and the
+/// combining marks U+0300..U+036F.
+const NAME_PUNCTUATION: &[char] = &['-', '.', '\u{B7}'];
+
+/// A NameChar.
+fn name_rest_chars() -> impl PrintableGenerator<char> + Send + Sync + 'static {
+    hegel::one_of!(
+        name_start_chars(),
+        generators::sampled_from(NAME_PUNCTUATION),
+        chars_in('0' as u32, '9' as u32),
+        chars_in(0x300, 0x36F),
+    )
+}
+
+/// A valid XML name without a namespace prefix (no `:`): a NameStartChar
+/// followed by up to eight NameChars. The reserved namespace-declaration
+/// name `xmlns` (not an ordinary attribute) is rendered as `xmlns_`.
+pub fn xml_names() -> impl PrintableGenerator<String> + Send + Sync + 'static {
+    hegel::tuples!(
+        name_start_chars(),
+        generators::vecs(name_rest_chars()).max_size(8)
+    )
+    .map(|(first, rest)| {
+        let name: String = std::iter::once(first).chain(rest).collect();
+        debug_assert!(name
+            .chars()
+            .enumerate()
+            .all(|(i, c)| if i == 0 { is_name_start_char(c) } else { is_name_char(c) }));
+        if name == "xmlns" {
+            name + "_"
+        } else {
+            name
+        }
+    })
+}
+
+/// Pieces of character data at the writer's PCDATA encode-set boundary
+/// (`<`, `>`, `&`) plus strings that look like markup or entity references.
+const TEXT_PIECES: &[&str] = &[
+    "<", ">", "&", "\"", "'", ";", "]]>", "]]", "&amp;", "&lt;", "&#60;", "&#x3C;", "&#", "<!--",
+    "-->", "<![CDATA[", " ", "\n", "\t",
+];
+/// The xml-rs/1 shape in character data: a carriage return, alone or in a
+/// Windows line ending.
+const TEXT_KNOWN_PIECES: &[&str] = &["\r", "\r\n"];
+
+/// Pieces of an attribute value: the PCDATA pieces plus `\r` and `\n`, which
+/// the writer escapes as character references in attribute values (unlike in
+/// PCDATA) so that they survive attribute-value normalisation.
+const ATTR_PIECES: &[&str] = &[
+    "<", ">", "&", "\"", "'", ";", "\r", "\n", "\r\n", "&#xD;", "&#x9;", "&amp;", "]]>", " ",
+];
+/// The xml-rs/1 shape in an attribute value: a literal tab.
+const ATTR_KNOWN_PIECES: &[&str] = &["\t"];
+
+/// `table`, plus the known-bug pieces `known` while the known shapes are
+/// drawn.
+fn pieces(table: &'static [&'static str], known: &'static [&'static str]) -> Vec<&'static str> {
+    let mut pieces = table.to_vec();
+    if known_shapes() {
+        pieces.extend_from_slice(known);
+    }
+    pieces
+}
+
+/// Up to `max` pieces, each one of `table` (first) or a single character of
+/// `chars`, concatenated.
+fn pieced_text(
+    table: Vec<&'static str>,
+    chars: impl PrintableGenerator<char> + Send + Sync + 'static,
+    max: usize,
+) -> impl PrintableGenerator<String> + Send + Sync + 'static {
+    generators::vecs(hegel::one_of!(
+        generators::sampled_from(table).map(String::from),
+        chars.map(String::from),
+    ))
+    .max_size(max)
+    .map(|pieces: Vec<String>| pieces.concat())
+}
+
+/// Character data at the writer's PCDATA encode-set boundary, including (by
+/// default, see `known_shapes`) the `\r` the writer loses.
+pub fn xml_texts() -> impl PrintableGenerator<String> + Send + Sync + 'static {
+    pieced_text(pieces(TEXT_PIECES, TEXT_KNOWN_PIECES), content_chars(), 24)
+}
+
+/// An attribute value: like `xml_texts` with `\r` and `\n` in every form,
+/// and including (by default, see `known_shapes`) the `\t` the writer loses.
+pub fn attr_values() -> impl PrintableGenerator<String> + Send + Sync + 'static {
+    pieced_text(pieces(ATTR_PIECES, ATTR_KNOWN_PIECES), attr_chars(), 16)
+}
+
+/// Comment content: up to twelve content characters other than `-`.
+pub fn comment_texts() -> impl PrintableGenerator<String> + Send + Sync + 'static {
+    generators::vecs(comment_chars())
+        .max_size(12)
+        .map(|chars: Vec<char>| chars.into_iter().collect())
+}
+
+// ---------------------------------------------------------------------------
+// Documents as data
+// ---------------------------------------------------------------------------
+
+/// A model XML document tree.
+#[derive(Debug, Clone, PartialEq, PrettyPrintable)]
+pub enum Node {
+    Element(Element),
+    /// Text content; `cdata` selects whether it is written as a CDATA section
+    /// or as escaped PCDATA (both must read back as the same text).
+    Text { content: String, cdata: bool },
+    Comment(String),
+}
+
+#[derive(Debug, Clone, PartialEq, PrettyPrintable)]
+pub struct Element {
+    pub name: String,
+    pub attrs: Vec<(String, String)>,
+    pub children: Vec<Node>,
+}
+
+/// How many text and comment nodes each child of the root holds at most
+/// (the leaf budget of one `recursive()` draw; measured against the old
+/// generator, 6 gives the same sizes: 3.5 elements and 360 bytes per
+/// document on average, full nesting depth in a quarter of the documents).
+const LEAVES: usize = 6;
+
+/// Up to three attributes with distinct names (drawn first, as a unique
+/// list) and a value each.
+fn attributes() -> impl PrintableGenerator<Vec<(String, String)>> + Send + Sync + 'static {
+    generators::vecs(xml_names())
+        .max_size(3)
+        .unique(true)
+        .flat_map(|names| {
+            let n = names.len();
+            hegel::tuples!(
+                generators::just(names),
+                generators::vecs(attr_values()).min_size(n).max_size(n)
+            )
+        })
+        .map(|(names, values)| names.into_iter().zip(values).collect())
+}
+
+/// The nodes that hold no further nodes: text written as escaped PCDATA
+/// (first), text written as a CDATA section, or a comment.
+fn leaf_nodes() -> impl PrintableGenerator<Node> + Send + Sync + 'static {
+    hegel::one_of!(
+        xml_texts().map(|content| Node::Text { content, cdata: false }),
+        xml_texts().map(|content| Node::Text { content, cdata: true }),
+        comment_texts().map(Node::Comment),
+    )
+}
+
+/// An element: a name, attributes and up to four children from `nodes`.
+fn element_over(nodes: impl PrintableGenerator<Node> + 'static) -> impl PrintableGenerator<Element> + 'static {
+    hegel::tuples!(xml_names(), attributes(), generators::vecs(nodes).max_size(4)).map(
+        |(name, attrs, children)| Element {
+            name,
+            attrs,
+            children,
+        },
+    )
+}
+
+/// A well-formed document tree: a root element whose children are each a
+/// `recursive()` draw over nodes - a leaf node, or an element over such
+/// nodes - nesting elements up to `depth` levels below the root (the
+/// elements at that level hold leaf nodes only).
+pub fn elements(depth: usize) -> impl PrintableGenerator<Element> + 'static {
+    element_over(
+        generators::recursive(leaf_nodes(), |sub| element_over(sub).map(Node::Element))
+            .max_depth(depth)
+            .max_leaves(LEAVES),
+    )
+}
+
+fn write_element<W: std::io::Write>(w: &mut EventWriter<W>, e: &Element) {
+    let mut start = WriterEvent::start_element(e.name.as_str());
+    for (name, value) in &e.attrs {
+        start = start.attr(name.as_str(), value.as_str());
+    }
+    w.write(start).expect("writing start element");
+    for child in &e.children {
+        match child {
+            Node::Element(el) => write_element(w, el),
+            Node::Text { content, cdata } => {
+                if *cdata {
+                    w.write(WriterEvent::cdata(content)).expect("writing cdata");
+                } else {
+                    w.write(WriterEvent::characters(content)).expect("writing characters");
+                }
+            },
+            Node::Comment(content) => {
+                w.write(WriterEvent::comment(content)).expect("writing comment");
+            },
+        }
+    }
+    w.write(WriterEvent::end_element()).expect("writing end element");
+}
+
+/// Serializes a document tree with `EventWriter` under the default config.
+pub fn write_document(root: &Element) -> Vec<u8> {
+    let mut buf = Vec::new();
+    let mut w = EmitterConfig::new().create_writer(&mut buf);
+    write_element(&mut w, root);
+    drop(w);
+    buf
+}
+
+// ---------------------------------------------------------------------------
+// Canonical streams
+// ---------------------------------------------------------------------------
+
+/// One canonical item of a parsed event stream: element structure plus merged
+/// text content, with comments, PIs, and document events dropped.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Item {
+    Start(String, Vec<(String, String)>),
+    End(String),
+    Text(String),
+}
+
+/// Parses a document into its canonical stream: `Characters`, `CData`, and
+/// `Whitespace` all count as text, adjacent text is merged, comments/PIs/
+/// doctype/document events are dropped.
+pub fn parse_stream(bytes: &[u8], config: ParserConfig) -> Result<Vec<Item>, xml::reader::Error> {
+    let mut reader = EventReader::new_with_config(bytes, config);
+    let mut out = Vec::new();
+    loop {
+        match reader.next()? {
+            XmlEvent::StartDocument { .. }
+            | XmlEvent::ProcessingInstruction { .. }
+            | XmlEvent::Doctype { .. }
+            | XmlEvent::Comment(_) => {},
+            XmlEvent::EndDocument => return Ok(out),
+            XmlEvent::StartElement { name, attributes, .. } => out.push(Item::Start(
+                name.local_name,
+                attributes.into_iter().map(|a| (a.name.local_name, a.value)).collect(),
+            )),
+            XmlEvent::EndElement { name } => out.push(Item::End(name.local_name)),
+            XmlEvent::Characters(s) | XmlEvent::CData(s) | XmlEvent::Whitespace(s) => {
+                if !s.is_empty() {
+                    if let Some(Item::Text(t)) = out.last_mut() {
+                        t.push_str(&s);
+                    } else {
+                        out.push(Item::Text(s));
+                    }
+                }
+            },
+        }
+    }
+}
+
+/// The canonical stream a correct write-read round-trip of `root` must yield.
+pub fn expected_stream(root: &Element) -> Vec<Item> {
+    fn walk(e: &Element, out: &mut Vec<Item>) {
+        out.push(Item::Start(e.name.clone(), e.attrs.clone()));
+        let mut text = String::new();
+        for child in &e.children {
+            match child {
+                Node::Text { content, .. } => text.push_str(content),
+                // comments are dropped from the canonical stream, and the
+                // reader coalesces character data across ignored comments
+                Node::Comment(_) => {},
+                Node::Element(el) => {
+                    if !text.is_empty() {
+                        out.push(Item::Text(std::mem::take(&mut text)));
+                    }
+                    walk(el, out);
+                },
+            }
+        }
+        if !text.is_empty() {
+            out.push(Item::Text(text));
+        }
+        out.push(Item::End(e.name.clone()));
+    }
+    let mut out = Vec::new();
+    walk(root, &mut out);
+    out
+}
+
+// ---------------------------------------------------------------------------
+// Soup
+// ---------------------------------------------------------------------------
+
+/// Markup fragments, entity references, quotes and stray syntax.
+const SOUP_PIECES: &[&str] = &[
+    "<a>", "</a>", "<b x=\"1\">", "</b>", "<a/>", "<?xml version=\"1.0\"?>",
+    "<?xml encoding=\"bogus\"?>", "<?pi data?>", "<!--", "-->", "<!--c-->",
+    "<![CDATA[", "]]>", "<![CDATA[x]]>", "<!DOCTYPE a [", "]>",
+    "<!ENTITY x \"y\">", "<!ENTITY y \"&x;&x;\">", "&x;", "&y;", "&amp;",
+    "&#65;", "&#x41;", "&#xD800;", "&#0;", "\"", "'", "<", ">", "&", ";",
+    "=", " ", "\n", "\t", "<a:b>", "</a:b>", "<a xmlns=\"u\">",
+    "<a xmlns:p=\"u\">", "xmlns", "text", "\u{FFFD}", "/>", "<!",
+];
+
+/// XML-shaped "soup": up to forty pieces, each a markup fragment (first) or
+/// a short arbitrary text, concatenated. Most such inputs are ill-formed; the
+/// parser must reject them with `Err`, never panic.
+pub fn xml_soups() -> impl PrintableGenerator<Vec<u8>> + Send + Sync + 'static {
+    generators::vecs(hegel::one_of!(
+        generators::sampled_from(SOUP_PIECES).map(String::from),
+        generators::text().max_size(8),
+    ))
+    .max_size(40)
+    .map(|pieces: Vec<String>| pieces.concat().into_bytes())
+}
