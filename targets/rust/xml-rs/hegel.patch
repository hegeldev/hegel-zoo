+
+// ===========================================================================
+// Property-based tests (hegel)
+// ===========================================================================
+
+#[path = "util/pbt.rs"]
+mod pbt;
+
+mod pbt_reader {
+    use super::pbt;
+    use hegel::generators::{self, Generator};
+    use hegel::{PrettyPrintable, PrintableGenerator};
+    use xml::reader::{EventReader, ParserConfig, XmlEvent};
+
+    /// Drives a reader to its terminal event (EndDocument or Err), with a cap
+    /// on the number of events as a termination guard. Returns the terminal
+    /// event and the number of non-terminal events seen.
+    fn drive(mut reader: EventReader<&[u8]>, max_events: usize) -> (xml::reader::Result<XmlEvent>, usize) {
+        let mut n = 0;
+        loop {
+            match reader.next() {
+                Ok(XmlEvent::EndDocument) => return (Ok(XmlEvent::EndDocument), n),
+                Err(e) => return (Err(e), n),
+                Ok(_) => {
+                    n += 1;
+                    assert!(n <= max_events, "parser produced more than {max_events} events; possible non-termination");
+                },
+            }
+        }
+    }
+
+    // -----------------------------------------------------------------------
+    // Cases as data
+    // -----------------------------------------------------------------------
+
+    /// Input for the never-panics property: arbitrary bytes (first, the
+    /// shrink target), XML-shaped soup, or arbitrary text.
+    fn inputs() -> impl PrintableGenerator<Vec<u8>> {
+        hegel::one_of!(
+            generators::binary().max_size(2048),
+            pbt::xml_soups(),
+            generators::text().max_size(512).map(String::into_bytes),
+        )
+    }
+
+    /// The `ParserConfig` switches a property flips; `config()` builds the
+    /// configuration.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    struct Switches {
+        trim_whitespace: bool,
+        whitespace_to_characters: bool,
+        cdata_to_characters: bool,
+        ignore_comments: bool,
+        coalesce_characters: bool,
+        replace_unknown_entity_references: bool,
+        ignore_root_level_whitespace: bool,
+        allow_multiple_root_elements: bool,
+        ignore_invalid_encoding_declarations: bool,
+    }
+
+    impl Switches {
+        fn config(&self) -> ParserConfig {
+            ParserConfig::new()
+                .trim_whitespace(self.trim_whitespace)
+                .whitespace_to_characters(self.whitespace_to_characters)
+                .cdata_to_characters(self.cdata_to_characters)
+                .ignore_comments(self.ignore_comments)
+                .coalesce_characters(self.coalesce_characters)
+                .replace_unknown_entity_references(self.replace_unknown_entity_references)
+                .ignore_root_level_whitespace(self.ignore_root_level_whitespace)
+                .allow_multiple_root_elements(self.allow_multiple_root_elements)
+                .ignore_invalid_encoding_declarations(self.ignore_invalid_encoding_declarations)
+        }
+    }
+
+    /// Every switch drawn.
+    fn switches() -> impl PrintableGenerator<Switches> {
+        generators::arrays::<_, bool, 9>(generators::booleans()).map(
+            |[trim_whitespace, whitespace_to_characters, cdata_to_characters, ignore_comments, coalesce_characters, replace_unknown_entity_references, ignore_root_level_whitespace, allow_multiple_root_elements, ignore_invalid_encoding_declarations]| Switches {
+                trim_whitespace,
+                whitespace_to_characters,
+                cdata_to_characters,
+                ignore_comments,
+                coalesce_characters,
+                replace_unknown_entity_references,
+                ignore_root_level_whitespace,
+                allow_multiple_root_elements,
+                ignore_invalid_encoding_declarations,
+            },
+        )
+    }
+
+    /// The switches that only re-shape the event stream, drawn;
+    /// `trim_whitespace` (which deliberately changes text content) and
+    /// `ignore_invalid_encoding_declarations` stay off.
+    fn shaping_switches() -> impl PrintableGenerator<Switches> {
+        generators::arrays::<_, bool, 7>(generators::booleans()).map(
+            |[cdata_to_characters, whitespace_to_characters, ignore_comments, coalesce_characters, replace_unknown_entity_references, ignore_root_level_whitespace, allow_multiple_root_elements]| Switches {
+                trim_whitespace: false,
+                whitespace_to_characters,
+                cdata_to_characters,
+                ignore_comments,
+                coalesce_characters,
+                replace_unknown_entity_references,
+                ignore_root_level_whitespace,
+                allow_multiple_root_elements,
+                ignore_invalid_encoding_declarations: false,
+            },
+        )
+    }
+
+    /// Input for the well-nesting property: XML-shaped soup (first, the
+    /// shrink target) or a well-formed document tree written with
+    /// `EventWriter`.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    enum Document {
+        Soup(Vec<u8>),
+        Tree(pbt::Element),
+    }
+
+    impl Document {
+        fn bytes(&self) -> Vec<u8> {
+            match self {
+                Document::Soup(bytes) => bytes.clone(),
+                Document::Tree(root) => pbt::write_document(root),
+            }
+        }
+    }
+
+    fn documents() -> impl PrintableGenerator<Document> {
+        hegel::one_of!(
+            pbt::xml_soups().map(Document::Soup),
+            pbt::elements(3).map(Document::Tree),
+        )
+    }
+
+    /// `depth` nested `<name>` start tags, closed by as many end tags (a
+    /// well-formed document) or left open (a truncated one).
+    #[derive(Clone, Debug, PrettyPrintable)]
+    struct Nesting {
+        depth: usize,
+        closed: bool,
+        name: String,
+    }
+
+    impl Nesting {
+        fn document(&self) -> String {
+            let open = format!("<{}>", self.name).repeat(self.depth);
+            if self.closed {
+                open + &format!("</{}>", self.name).repeat(self.depth)
+            } else {
+                open
+            }
+        }
+    }
+
+    /// A nesting of depth 1 to 1200. The cap keeps the test's runtime sane:
+    /// parsing is O(depth^2) (see `known_issue_deep_nesting_quadratic_time`
+    /// below); it protects the test's runtime, not any library contract.
+    fn nestings() -> impl PrintableGenerator<Nesting> {
+        hegel::tuples!(
+            generators::integers::<usize>().min_value(1).max_value(1200),
+            generators::booleans(),
+            pbt::xml_names()
+        )
+        .map(|(depth, closed, name)| Nesting { depth, closed, name })
+    }
+
+    /// A "billion laughs" document: `lol0` is `lol`, each of the `levels`
+    /// further entities references the previous one `fanout` times, and the
+    /// root element references the last.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    struct Bomb {
+        fanout: u32,
+        levels: u32,
+    }
+
+    impl Bomb {
+        fn document(&self) -> String {
+            let mut doc = String::from("<?xml version=\"1.0\"?>\n<!DOCTYPE lolz [\n<!ENTITY lol0 \"lol\">\n");
+            for level in 1..=self.levels {
+                let reference = format!("&lol{};", level - 1);
+                doc.push_str(&format!("<!ENTITY lol{level} \"{}\">\n", reference.repeat(self.fanout as usize)));
+            }
+            doc.push_str(&format!("]>\n<lolz>&lol{};</lolz>", self.levels));
+            doc
+        }
+
+        /// The full expansion in chars: 3 * fanout^levels.
+        fn expansion(&self) -> u128 {
+            3u128.saturating_mul((self.fanout as u128).saturating_pow(self.levels))
+        }
+    }
+
+    fn bombs() -> impl PrintableGenerator<Bomb> {
+        hegel::tuples!(
+            generators::integers::<u32>().min_value(2).max_value(10),
+            generators::integers::<u32>().min_value(1).max_value(12)
+        )
+        .map(|(fanout, levels)| Bomb { fanout, levels })
+    }
+
+    /// How a document is ill-formed.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    enum Fault {
+        /// The close tag names another element.
+        MismatchedClose,
+        /// The same attribute twice.
+        DuplicateAttribute,
+        /// A name starting with a NameChar that is not a NameStartChar.
+        BadNameStart(char),
+        /// An unclosed root.
+        Truncated,
+        /// An end tag with no open element.
+        StrayEnd,
+        /// A control character forbidden by XML 1.0.
+        ControlChar,
+        /// An attribute without a value.
+        ValuelessAttribute,
+    }
+
+    /// NameChars that are not NameStartChars.
+    const BAD_NAME_STARTS: &[char] = &['-', '.', '0', '5', '9', '\u{B7}'];
+
+    fn faults() -> impl PrintableGenerator<Fault> {
+        hegel::one_of!(
+            generators::just(Fault::MismatchedClose),
+            generators::just(Fault::DuplicateAttribute),
+            generators::sampled_from(BAD_NAME_STARTS).map(Fault::BadNameStart),
+            generators::just(Fault::Truncated),
+            generators::just(Fault::StrayEnd),
+            generators::just(Fault::ControlChar),
+            generators::just(Fault::ValuelessAttribute),
+        )
+    }
+
+    /// An ill-formed document: two distinct element names, an attribute name
+    /// and the fault, rendered by `document()`.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    struct Malformed {
+        name: String,
+        other: String,
+        attr: String,
+        fault: Fault,
+    }
+
+    impl Malformed {
+        fn document(&self) -> String {
+            let Malformed { name, other, attr, fault } = self;
+            match fault {
+                Fault::MismatchedClose => format!("<{name}></{other}>"),
+                Fault::DuplicateAttribute => format!("<{name} {attr}=\"1\" {attr}=\"2\"/>"),
+                Fault::BadNameStart(bad) => format!("<{bad}{name}/>"),
+                Fault::Truncated => format!("<{name}><{other}></{other}>"),
+                Fault::StrayEnd => format!("</{name}>"),
+                Fault::ControlChar => format!("<{name}>\u{1}</{name}>"),
+                Fault::ValuelessAttribute => format!("<{name} {attr}></{name}>"),
+            }
+        }
+    }
+
+    fn malformed() -> impl PrintableGenerator<Malformed> {
+        hegel::tuples!(
+            generators::vecs(pbt::xml_names()).min_size(2).max_size(2).unique(true),
+            pbt::xml_names(),
+            faults()
+        )
+        .map(|(names, attr, fault)| {
+            let mut names = names.into_iter();
+            Malformed {
+                name: names.next().expect("two names"),
+                other: names.next().expect("two names"),
+                attr,
+                fault,
+            }
+        })
+    }
+
+    // -----------------------------------------------------------------------
+    // Properties
+    // -----------------------------------------------------------------------
+
+    /// Property: fully driving `EventReader` never panics and always
+    /// terminates with `EndDocument` or an error, on arbitrary bytes, text,
+    /// and XML-shaped soup, under arbitrary parser configurations. The
+    /// documented terminal-event contract also holds: after `Err` or
+    /// `EndDocument`, `next()` returns the same event again.
+    #[hegel::test]
+    fn parser_never_panics_on_arbitrary_input(tc: hegel::TestCase) {
+        let (input, switches) = tc.draw(hegel::tuples!(inputs(), switches()));
+
+        let mut reader = EventReader::new_with_config(&input[..], switches.config());
+        let terminal = loop {
+            match reader.next() {
+                Ok(XmlEvent::EndDocument) => break Ok(XmlEvent::EndDocument),
+                Err(e) => break Err(e),
+                Ok(_) => {},
+            }
+        };
+        // documented on EventReader::next(): "If this returns Err or
+        // XmlEvent::EndDocument then further calls to this method will return
+        // this event again."
+        match (terminal, reader.next()) {
+            (Ok(XmlEvent::EndDocument), Ok(XmlEvent::EndDocument)) => {},
+            (Err(first), Err(again)) => assert_eq!(first, again),
+            other => panic!("terminal event was not repeated: {other:?}"),
+        }
+    }
+
+    /// Property: the event stream is always well-nested - every `EndElement`
+    /// matches the most recent unclosed `StartElement` (same name, LIFO), and
+    /// `EndDocument` is only reached with no elements left open. This must
+    /// hold for every prefix of events the parser produces, even when it
+    /// later errors out.
+    #[hegel::test]
+    fn event_stream_is_well_nested(tc: hegel::TestCase) {
+        let input = tc.draw(documents()).bytes();
+        let mut reader = EventReader::new(&input[..]);
+        let mut stack: Vec<(Option<String>, String)> = Vec::new();
+        loop {
+            match reader.next() {
+                Ok(XmlEvent::StartElement { name, .. }) => {
+                    stack.push((name.prefix, name.local_name));
+                },
+                Ok(XmlEvent::EndElement { name }) => {
+                    let top = stack.pop().expect("EndElement without a matching StartElement");
+                    assert_eq!(top, (name.prefix, name.local_name), "EndElement does not match the innermost open StartElement");
+                },
+                Ok(XmlEvent::EndDocument) => {
+                    assert!(stack.is_empty(), "EndDocument emitted with unclosed elements: {stack:?}");
+                    break;
+                },
+                Ok(_) => {},
+                Err(_) => break,
+            }
+        }
+    }
+
+    /// Property: deeply nested documents (`<a><a>...</a></a>`) never crash
+    /// the process - the parser keeps its element stack on the heap. A
+    /// properly closed document of depth N produces exactly N starts and N
+    /// ends; a truncated one ends in an error, not a panic.
+    ///
+    /// The depth is capped at 1200 to keep the test's runtime sane: parsing
+    /// is O(depth^2) (see `known_issue_deep_nesting_quadratic_time` below).
+    /// The cap protects the test's runtime, not any library contract.
+    #[hegel::test]
+    fn deeply_nested_documents_never_crash(tc: hegel::TestCase) {
+        let nesting = tc.draw(nestings());
+        let doc = nesting.document();
+
+        let mut reader = EventReader::from_str(&doc);
+        let mut starts = 0usize;
+        let mut ends = 0usize;
+        let terminal_ok = loop {
+            match reader.next() {
+                Ok(XmlEvent::StartElement { .. }) => starts += 1,
+                Ok(XmlEvent::EndElement { .. }) => ends += 1,
+                Ok(XmlEvent::EndDocument) => break true,
+                Ok(_) => {},
+                Err(_) => break false,
+            }
+        };
+        if nesting.closed {
+            assert!(terminal_ok, "well-formed deeply nested document was rejected");
+            assert_eq!((starts, ends), (nesting.depth, nesting.depth));
+        } else {
+            assert!(!terminal_ok, "truncated document must end in an error");
+        }
+    }
+
+    // KNOWN ISSUE (performance, documented in HEGEL_REPORT.md): parse time
+    // grows quadratically with element nesting depth, because every
+    // StartElement event calls `NamespaceStack::squash()`
+    // (src/reader/parser.rs:714), which rebuilds the full flattened namespace
+    // mapping by walking the entire namespace stack - O(depth) work per
+    // element, O(depth^2) per document. Measured (debug build):
+    //   depth  1_000 =  27 ms
+    //   depth 10_000 = 2.5 s
+    //   depth 50_000 =  61 s
+    // A ~300 KB hostile document therefore costs a minute of CPU, and the
+    // input-size cap recommended in the README (`Read::take`) does not defend
+    // against it. #[ignore]d so the suite stays fast.
+    #[test]
+    #[ignore = "reproducer for quadratic parse time on deep nesting (takes ~10s in debug)"]
+    fn known_issue_deep_nesting_quadratic_time() {
+        fn time_depth(depth: usize) -> std::time::Duration {
+            let mut doc = String::with_capacity(depth * 8);
+            for _ in 0..depth { doc.push_str("<a>"); }
+            for _ in 0..depth { doc.push_str("</a>"); }
+            let start = std::time::Instant::now();
+            let mut reader = EventReader::from_str(&doc);
+            loop {
+                match reader.next() {
+                    Ok(XmlEvent::EndDocument) => break,
+                    Ok(_) => {},
+                    Err(e) => panic!("unexpected parse error: {e}"),
+                }
+            }
+            start.elapsed()
+        }
+        let t4k = time_depth(4_000);
+        let t8k = time_depth(8_000);
+        eprintln!("depth 4000: {t4k:?}, depth 8000: {t8k:?} (linear would be ~2x, quadratic ~4x)");
+    }
+
+    /// Property: "billion laughs" entity-expansion bombs are rejected with an
+    /// error (`EntityTooBig`), never a hang, OOM, or panic. Whenever the full
+    /// expansion would exceed the default `max_entity_expansion_length`, the
+    /// parser must return `Err`; whatever the outcome, it must not deliver
+    /// unbounded output. Small, benign expansions must still expand correctly.
+    #[hegel::test]
+    fn entity_expansion_bombs_are_rejected(tc: hegel::TestCase) {
+        let bomb = tc.draw(bombs());
+        let doc = bomb.document();
+        let expansion = bomb.expansion();
+        let default_limit = 1_000_000u128; // ParserConfig default max_entity_expansion_length
+
+        let mut reader = EventReader::from_str(&doc);
+        let mut text = String::new();
+        let result = loop {
+            match reader.next() {
+                Ok(XmlEvent::EndDocument) => break Ok(()),
+                Ok(XmlEvent::Characters(s)) => {
+                    text.push_str(&s);
+                    // termination/robustness guard: the parser must never
+                    // deliver more than a small multiple of its expansion limit
+                    assert!(text.len() as u128 <= 4 * default_limit, "parser delivered unbounded entity expansion");
+                },
+                Ok(_) => {},
+                Err(e) => break Err(e),
+            }
+        };
+
+        if expansion > default_limit {
+            assert!(result.is_err(), "expansion of {expansion} chars exceeds the {default_limit} limit but was not rejected");
+        }
+        if result.is_ok() {
+            // accepted expansions must be exact
+            assert_eq!(text, "lol".repeat((expansion / 3) as usize));
+        }
+    }
+
+    /// Property: ill-formed documents - mismatched tags, duplicate
+    /// attributes, invalid names, truncation, stray end tags, invalid
+    /// characters - are rejected with `Err`, never a panic and never a
+    /// successful parse.
+    #[hegel::test]
+    fn malformed_documents_are_rejected(tc: hegel::TestCase) {
+        let malformed = tc.draw(malformed());
+        let doc = malformed.document();
+
+        let (terminal, _) = drive(EventReader::from_str(&doc), 1_000);
+        assert!(terminal.is_err(), "ill-formed document was accepted ({:?}): {doc:?}", malformed.fault);
+    }
+
+    /// Property: parser configuration options that only re-shape the event
+    /// stream (CDATA to characters, whitespace to characters, comment
+    /// reporting, coalescing) never change the canonical document content:
+    /// element structure, attributes, and merged text are identical under
+    /// every such configuration. (`trim_whitespace` is excluded - it
+    /// deliberately changes text content.)
+    #[hegel::test]
+    fn config_variations_agree_on_canonical_stream(tc: hegel::TestCase) {
+        let (root, switches) = tc.draw(hegel::tuples!(pbt::elements(3), shaping_switches()));
+        let bytes = pbt::write_document(&root);
+
+        let base = pbt::parse_stream(&bytes, ParserConfig::new())
+            .expect("writer output must be well-formed");
+        let other = pbt::parse_stream(&bytes, switches.config())
+            .expect("event-shaping config options must not make a well-formed document unparseable");
+
+        assert_eq!(base, other);
+    }
+}
