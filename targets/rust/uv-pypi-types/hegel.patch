+// --------------------------------------------------------------------------- properties
+
+/// `Metadata23::parse` reads every core-metadata field exactly as `packaging.metadata.parse_email`
+/// does (strings, multi-use lists in order, keywords, project URLs, the description as header or
+/// body), leaves nothing unparsed, and `core_metadata_format` round-trips the value.
+#[hegel::test]
+fn metadata23_fields_match_packaging(tc: TestCase) {
+    let spec = tc.draw(spec());
+    let text = spec.render();
+    let parsed = Metadata23::parse(text.as_bytes()).unwrap_or_else(|e| panic!("{e}\n{text}"));
+    let ref_ = ask_json("E", &[&text]);
+    let raw = &ref_["raw"];
+    assert_eq!(ref_["unparsed"].as_object().map(|o| o.len()).unwrap_or(0), 0, "unparsed: {}\n{text}", ref_["unparsed"]);
+    assert_eq!(Some(parsed.metadata_version.clone()), opt_str(raw, "metadata_version"), "{text}");
+    assert_eq!(Some(parsed.name.clone()), opt_str(raw, "name"));
+    assert_eq!(Some(parsed.version.clone()), opt_str(raw, "version"));
+    assert_eq!(parsed.platforms, list(raw, "platforms"), "{text}");
+    assert_eq!(parsed.supported_platforms, list(raw, "supported_platforms"));
+    assert_eq!(parsed.summary, opt_str(raw, "summary"), "{text}");
+    assert_eq!(parsed.description, opt_str(raw, "description"), "{text}");
+    assert_eq!(parsed.description_content_type, opt_str(raw, "description_content_type"));
+    assert_eq!(parsed.keywords.as_ref().map(|k| k.as_metadata()), raw.get("keywords").map(|k| strs(k).join(",")), "{text}");
+    assert_eq!(parsed.home_page, opt_str(raw, "home_page"));
+    assert_eq!(parsed.download_url, opt_str(raw, "download_url"));
+    assert_eq!(parsed.author, opt_str(raw, "author"));
+    assert_eq!(parsed.author_email, opt_str(raw, "author_email"));
+    assert_eq!(parsed.maintainer, opt_str(raw, "maintainer"));
+    assert_eq!(parsed.maintainer_email, opt_str(raw, "maintainer_email"));
+    assert_eq!(parsed.license, opt_str(raw, "license"));
+    assert_eq!(parsed.license_expression, opt_str(raw, "license_expression"));
+    assert_eq!(parsed.license_files, list(raw, "license_files"));
+    assert_eq!(parsed.classifiers, list(raw, "classifiers"));
+    assert_eq!(parsed.requires_dist, list(raw, "requires_dist"), "{text}");
+    assert_eq!(parsed.provides_dist, list(raw, "provides_dist"));
+    assert_eq!(parsed.obsoletes_dist, list(raw, "obsoletes_dist"));
+    assert_eq!(parsed.requires_python, opt_str(raw, "requires_python"));
+    assert_eq!(parsed.requires_external, list(raw, "requires_external"));
+    let urls: BTreeMap<String, String> = parsed
+        .project_urls
+        .to_vec_str()
+        .iter()
+        .map(|s| {
+            let (l, u) = s.split_once(", ").unwrap();
+            (l.to_string(), u.to_string())
+        })
+        .collect();
+    let ref_urls: BTreeMap<String, String> = raw
+        .get("project_urls")
+        .and_then(|o| o.as_object())
+        .map(|o| o.iter().map(|(k, v)| (k.clone(), v.as_str().unwrap().to_string())).collect())
+        .unwrap_or_default();
+    assert_eq!(urls, ref_urls, "{text}");
+    assert_eq!(parsed.provides_extra, list(raw, "provides_extra"));
+    assert_eq!(parsed.import_names, list(raw, "import_names"));
+    assert_eq!(parsed.import_namespaces, list(raw, "import_namespaces"));
+    assert_eq!(parsed.dynamic, list(raw, "dynamic"));
+    // `FromStr` is `parse`.
+    assert_eq!(Metadata23::from_str(&text).unwrap(), parsed);
+    // Writer round trip.
+    let written = parsed.core_metadata_format();
+    let again = Metadata23::parse(written.as_bytes()).unwrap_or_else(|e| panic!("{e}\n{written}"));
+    assert_eq!(again, parsed, "round trip through\n{written}");
+}
