+/// Valid requirements and specifier sets pass through the lenient parsers unchanged.
+#[hegel::test]
+fn lenient_parsing_is_transparent_on_valid_input(tc: TestCase) {
+    let (text, specs) = tc.draw(hegel::tuples!(
+        generators::sampled_from(REQUIREMENTS),
+        generators::sampled_from(SPECIFIER_SETS)
+    ));
+    let strict = Requirement::<VerbatimParsedUrl>::from_str(text).unwrap();
+    let lenient: Requirement<VerbatimParsedUrl> = LenientRequirement::from_str(text).unwrap().into();
+    assert_eq!(lenient, strict);
+    assert_eq!(view_of_uv(&lenient), view_of_json(&ask_json("R", &[text])), "{text}");
+    let strict = VersionSpecifiers::from_str(specs).unwrap();
+    let lenient: VersionSpecifiers = LenientVersionSpecifiers::from_str(specs).unwrap().into();
+    assert_eq!(lenient, strict);
+    assert_eq!(specs_of_uv(&lenient), strs(&ask_json("S", &[specs])), "{specs}");
+}
+
+// --------------------------------------------------------------------------- lenient fix-ups
+
+/// A version of one to three components, each a digit up to `max_digit`.
+fn version(max_digit: i64) -> impl PrintableGenerator<String> {
+    generators::vecs(ints(0, max_digit))
+        .min_size(1)
+        .max_size(3)
+        .map(|parts| parts.iter().map(i64::to_string).collect::<Vec<_>>().join("."))
+}
+
+const COMPARISONS: &[&str] = &["<=", ">=", "<", ">"];
+const TAGS: &[&str] = &["a", "b", "rc", "post", "dev"];
+const QUOTES: &[&str] = &["'", "\""];
+
+/// A documented breakage of a valid specifier set; `texts` gives the broken text and the set the
+/// fix-up should recover.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Breakage {
+    /// `>dev`
+    Dev,
+    /// `>=V,` (a space after the comma or not)
+    TrailingComma { v: String, space: bool },
+    /// `>=V.*` (a space after the operator or not)
+    StarAfterComparison { op: &'static str, space: bool, v: String },
+    /// `!=~V,>=1`
+    InvalidTilde { v: String },
+    /// `>=2.7,!=V*` for a two-component `V`
+    MissingDot { v: String },
+    /// `>=V<tag><k>.0`
+    TrailingZero { v: String, tag: &'static str, k: i64 },
+    /// `<a>V<b>W` — no comma between two specifiers
+    MissingComma { a: &'static str, v: String, b: &'static str, w: String },
+    /// `>= 'V'`
+    QuotedVersion { q: &'static str, v: String },
+    /// `>=V'`
+    StrayQuote { q: &'static str, v: String },
+    /// `'>=V'`
+    QuotedSpecifier { q: &'static str, v: String },
+}
+
+impl Breakage {
+    fn texts(&self) -> (String, String) {
+        match self {
+            Breakage::Dev => (">dev".to_string(), ">0.0.0dev".to_string()),
+            Breakage::TrailingComma { v, space } => {
+                let space = if *space { " " } else { "" };
+                (format!(">={v},{space}"), format!(">={v}"))
+            }
+            Breakage::StarAfterComparison { op, space, v } => {
+                let space = if *space { " " } else { "" };
+                (format!("{op}{space}{v}.*"), format!("{op}{v}"))
+            }
+            Breakage::InvalidTilde { v } => (format!("!=~{v},>=1"), format!("!={v}.*,>=1")),
+            Breakage::MissingDot { v } => (format!(">=2.7,!={v}*"), format!(">=2.7,!={v}.*")),
+            Breakage::TrailingZero { v, tag, k } => (format!(">={v}{tag}{k}.0"), format!(">={v}{tag}{k}")),
+            Breakage::MissingComma { a, v, b, w } => (format!("{a}{v}{b}{w}"), format!("{a}{v},{b}{w}")),
+            Breakage::QuotedVersion { q, v } => (format!(">= {q}{v}{q}"), format!(">={v}")),
+            Breakage::StrayQuote { q, v } => (format!(">={v}{q}"), format!(">={v}")),
+            Breakage::QuotedSpecifier { q, v } => (format!("{q}>={v}{q}"), format!(">={v}")),
+        }
+    }
+
+    fn what(&self) -> &'static str {
+        match self {
+            Breakage::Dev => "dev",
+            Breakage::TrailingComma { .. } => "trailing comma",
+            Breakage::StarAfterComparison { .. } => "star after comparison",
+            Breakage::InvalidTilde { .. } => "invalid tilde",
+            Breakage::MissingDot { .. } => "missing dot",
+            Breakage::TrailingZero { .. } => "trailing zero",
+            Breakage::MissingComma { .. } => "missing comma",
+            Breakage::QuotedVersion { .. } => "quoted version",
+            Breakage::StrayQuote { .. } => "stray quote",
+            Breakage::QuotedSpecifier { .. } => "quoted specifier",
+        }
+    }
+}
+
+/// Every documented breakage, with versions of `max_digit`-bounded components; the draw-free
+/// `>dev` first.
+fn breakage(max_digit: i64) -> impl PrintableGenerator<Breakage> {
+    let v = move || version(max_digit);
+    let op = || generators::sampled_from(COMPARISONS);
+    let q = || generators::sampled_from(QUOTES);
+    hegel::one_of!(
+        generators::just(Breakage::Dev),
+        hegel::tuples!(v(), chance(0.5)).map(|(v, space)| Breakage::TrailingComma { v, space }),
+        hegel::tuples!(op(), chance(0.5), v())
+            .map(|(op, space, v)| Breakage::StarAfterComparison { op, space, v }),
+        v().map(|v| Breakage::InvalidTilde { v }),
+        hegel::tuples!(ints(0, max_digit), ints(0, max_digit))
+            .map(|(a, b)| Breakage::MissingDot { v: format!("{a}.{b}") }),
+        hegel::tuples!(v(), generators::sampled_from(TAGS), ints(0, max_digit))
+            .map(|(v, tag, k)| Breakage::TrailingZero { v, tag, k }),
+        hegel::tuples!(op(), v(), op(), v()).map(|(a, v, b, w)| Breakage::MissingComma { a, v, b, w }),
+        hegel::tuples!(q(), v()).map(|(q, v)| Breakage::QuotedVersion { q, v }),
+        hegel::tuples!(q(), v()).map(|(q, v)| Breakage::StrayQuote { q, v }),
+        hegel::tuples!(q(), v()).map(|(q, v)| Breakage::QuotedSpecifier { q, v }),
+    )
+}
+
+/// How a specifier set is wrapped into a requirement: a name, a marker three times in ten, the
+/// specifiers in parentheses two times in five.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Wrap {
+    name: &'static str,
+    marker: bool,
+    parens: bool,
+}
+
+impl Wrap {
+    fn requirement(&self, specs: &str) -> String {
+        let marker = if self.marker { " ; python_version >= '3.8'" } else { "" };
+        if self.parens {
+            format!("{} ({specs}){marker}", self.name)
+        } else {
+            format!("{} {specs}{marker}", self.name)
+        }
+    }
+}
+
+fn wrap() -> impl PrintableGenerator<Wrap> {
+    hegel::tuples!(generators::sampled_from(NAMES), chance(0.3), chance(0.4))
+        .map(|(name, marker, parens)| Wrap { name, marker, parens })
+}
+
+/// The fix-up repairs the breakage to the intended specifier set, alone and inside a requirement.
+fn check_breakage(breakage: &Breakage, wrap: &Wrap) {
+    let (broken, expected) = breakage.texts();
+    let what = breakage.what();
+    let expected_set = VersionSpecifiers::from_str(&expected).unwrap_or_else(|e| panic!("{expected}: {e}"));
+    let fixed: VersionSpecifiers = LenientVersionSpecifiers::from_str(&broken)
+        .unwrap_or_else(|e| panic!("{what}: {broken:?} not repaired: {e}"))
+        .into();
+    assert_eq!(fixed, expected_set, "{what}: {broken:?}");
+    let req_broken = wrap.requirement(&broken);
+    let req_expected = wrap.requirement(&expected);
+    let expected_req = Requirement::<VerbatimParsedUrl>::from_str(&req_expected).unwrap();
+    let fixed: Requirement<VerbatimParsedUrl> = LenientRequirement::from_str(&req_broken)
+        .unwrap_or_else(|e| panic!("{what}: {req_broken:?} not repaired: {e}"))
+        .into();
+    assert_eq!(fixed, expected_req, "{what}: {req_broken:?}");
+}
+
+/// Each documented fix-up repairs its breakage to the intended specifier set (and requirement),
+/// for versions with single-digit components.
+#[hegel::test]
+fn lenient_parsing_repairs_documented_breakages(tc: TestCase) {
+    let (breakage, wrap) = tc.draw(hegel::tuples!(breakage(9), wrap()));
+    check_breakage(&breakage, &wrap);
+}
+
+/// The "missing dot" and "invalid tilde" breakages with a two-digit minor component.
+fn multi_digit_breakage() -> impl PrintableGenerator<Breakage> {
+    let v = || hegel::tuples!(ints(0, 9), ints(10, 99)).map(|(major, minor)| format!("{major}.{minor}"));
+    hegel::one_of!(
+        v().map(|v| Breakage::MissingDot { v }),
+        v().map(|v| Breakage::InvalidTilde { v }),
+    )
+}
+
+/// Pinned: uv-pypi-types/2 — the "missing dot" and "invalid tilde" fix-ups match single digits
+/// only (`(\d\.\d)+\*`, `!=~((?:\d\.)*\d)`): `!=3.10*` and `!=~5.10` are not repaired.
+#[hegel::test]
+fn lenient_fixups_handle_multi_digit_components(tc: TestCase) {
+    let (breakage, wrap) = tc.draw(hegel::tuples!(multi_digit_breakage(), wrap()));
+    check_breakage(&breakage, &wrap);
+}
+
+// --------------------------------------------------------------------------- dynamic spellings
+
+/// The `Dynamic` values that block `parse_pkg_info`.
+const GATED_FIELDS: &[&str] = &["Requires-Dist", "Requires-Python", "Provides-Extra"];
+const VERSION_SPELLINGS: &[&str] = &["version", "VERSION"];
+
+/// A spelling of a field name other than the canonical `Word-Word` one.
+#[derive(Clone, Copy, Debug, hegel::PrettyPrintable)]
+enum Spelling {
+    Lower,
+    Upper,
+    LowerFirstWord,
+}
+
+const SPELLINGS: &[Spelling] = &[Spelling::Lower, Spelling::Upper, Spelling::LowerFirstWord];
+
+impl Spelling {
+    fn apply(self, field: &str) -> String {
+        match self {
+            Spelling::Lower => field.to_lowercase(),
+            Spelling::Upper => field.to_uppercase(),
+            Spelling::LowerFirstWord => {
+                let (a, b) = field.split_once('-').unwrap();
+                format!("{}-{}", a.to_lowercase(), b)
+            }
+        }
+    }
+}
+
+/// Pinned: uv-pypi-types/1 — `Dynamic` field names are matched case-sensitively
+/// (`field == "Requires-Dist"`), where core metadata field names are case-insensitive and
+/// `packaging` lowercases them: a `PKG-INFO` with `Dynamic: requires-dist` is trusted.
+#[hegel::test]
+fn dynamic_field_names_are_case_insensitive(tc: TestCase) {
+    let (field, spelling, version_spelling) = tc.draw(hegel::tuples!(
+        generators::sampled_from(GATED_FIELDS),
+        generators::sampled_from(SPELLINGS),
+        generators::sampled_from(VERSION_SPELLINGS)
+    ));
+    let spelling = spelling.apply(field);
+    let text = format!(
+        "Metadata-Version: 2.3\nName: x\nVersion: 1.0\nDynamic: {spelling}\nDynamic: {version_spelling}\n"
+    );
+    let ref_ = ask_json("E", &[&text]);
+    assert_eq!(list(&ref_["raw"], "dynamic"), vec![spelling.clone(), version_spelling.to_string()]);
+    let pkg_info = ResolutionMetadata::parse_pkg_info(text.as_bytes());
+    assert!(
+        matches!(pkg_info, Err(MetadataError::DynamicField(_))),
+        "Dynamic: {spelling} should block reading PKG-INFO, got {pkg_info:?}"
+    );
+    let meta = ResolutionMetadata::parse_metadata(text.as_bytes()).unwrap();
+    assert!(meta.dynamic, "Dynamic: {version_spelling} should mark the version dynamic");
+}
+
+// --------------------------------------------------------------------------- pyproject.toml
+
+const PYPROJECT_DYNAMIC: &[&str] = &["version", "dependencies", "optional-dependencies", "requires-python", "description"];
+
+/// A PEP 621 `[project]` table (plus, sometimes, a `[tool.poetry]` table).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Pyproject {
+    name: &'static str,
+    /// Given unless declared dynamic (PEP 621: one or the other).
+    version: Option<&'static str>,
+    requires_python: Option<&'static str>,
+    dependencies: Option<Vec<&'static str>>,
+    /// `optional-dependencies`: extras (distinct by construction) and their requirements.
+    optional: BTreeMap<&'static str, Vec<&'static str>>,
+    /// The `dynamic` list, in its written order.
+    dynamic: Vec<&'static str>,
+    poetry: bool,
+}
+
+fn toml_str(s: &str) -> String {
+    format!("\"{}\"", s.replace('\\', "\\\\").replace('"', "\\\""))
+}
+
+fn toml_list(items: &[&str]) -> String {
+    format!("[{}]", items.iter().map(|d| toml_str(d)).collect::<Vec<_>>().join(", "))
+}
+
+impl Pyproject {
+    fn has_dynamic(&self, field: &str) -> bool {
+        self.dynamic.contains(&field)
+    }
+
+    fn render(&self) -> String {
+        let mut toml = String::from("[project]\n");
+        toml.push_str(&format!("name = {}\n", toml_str(self.name)));
+        if let Some(v) = self.version {
+            toml.push_str(&format!("version = {}\n", toml_str(v)));
+        }
+        if let Some(rp) = self.requires_python {
+            toml.push_str(&format!("requires-python = {}\n", toml_str(rp)));
+        }
+        if let Some(deps) = &self.dependencies {
+            toml.push_str(&format!("dependencies = {}\n", toml_list(deps)));
+        }
+        if !self.dynamic.is_empty() {
+            toml.push_str(&format!("dynamic = {}\n", toml_list(&self.dynamic)));
+        }
+        if !self.optional.is_empty() {
+            toml.push_str("\n[project.optional-dependencies]\n");
+            for (extra, deps) in &self.optional {
+                toml.push_str(&format!("{} = {}\n", toml_str(extra), toml_list(deps)));
+            }
+        }
+        if self.poetry {
+            toml.push_str("\n[tool.poetry]\nname = \"poetic\"\n");
+        }
+        toml
+    }
+}
+
+/// The `dynamic` list: empty eleven times in twenty, else one or two distinct fields in any order.
+fn dynamic_fields() -> impl PrintableGenerator<Vec<&'static str>> {
+    maybe(
+        0.45,
+        generators::vecs(generators::sampled_from(PYPROJECT_DYNAMIC)).unique(true).min_size(1).max_size(2),
+    )
+    .map(Option::unwrap_or_default)
+}
+
+/// `g` unless `field` is declared dynamic, in which case the field is absent.
+fn unless_dynamic<T>(
+    dynamic: &[&'static str],
+    field: &str,
+    g: impl PrintableGenerator<Option<T>> + Send + Sync + 'static,
+) -> BoxedPrintableGenerator<'static, Option<T>>
+where
+    T: hegel::PrettyPrintable + Clone + Send + Sync + 'static,
+{
+    if dynamic.contains(&field) {
+        generators::just(None).boxed_printable()
+    } else {
+        g.boxed_printable()
+    }
+}
+
+/// A `dynamic` list and, for the fields it leaves static: the version, `requires-python` three
+/// times in five, `dependencies` (up to three) three times in four, `optional-dependencies` (one
+/// or two extras, up to two requirements each) half the time; a `[tool.poetry]` table three
+/// times in twenty.
+fn pyproject() -> impl PrintableGenerator<Pyproject> {
+    dynamic_fields().flat_map(|dynamic| {
+        let requirements = || generators::sampled_from(REQUIREMENTS);
+        hegel::tuples!(
+            generators::just(dynamic.clone()),
+            generators::sampled_from(NAMES),
+            unless_dynamic(&dynamic, "version", generators::sampled_from(VERSIONS).map(Some)),
+            unless_dynamic(&dynamic, "requires-python", maybe(0.6, generators::sampled_from(SPECIFIER_SETS))),
+            unless_dynamic(&dynamic, "dependencies", maybe(0.75, generators::vecs(requirements()).max_size(3))),
+            unless_dynamic(
+                &dynamic,
+                "optional-dependencies",
+                maybe(
+                    0.5,
+                    generators::btree_maps(
+                        generators::sampled_from(EXTRAS),
+                        generators::vecs(requirements()).max_size(2)
+                    )
+                    .min_size(1)
+                    .max_size(2)
+                ),
+            ),
+            chance(0.15),
+        )
+        .map(|(dynamic, name, version, requires_python, dependencies, optional, poetry)| Pyproject {
+            name,
+            version,
+            requires_python,
+            dependencies,
+            optional: optional.unwrap_or_default(),
+            dynamic,
+            poetry,
+        })
+    })
+}
+
+/// `ResolutionMetadata::parse_pyproject_toml`, `RequiresDist::from_pyproject_toml` and
+/// `PyProjectToml::requires_python` agree with `pyproject_metadata` on PEP 621 metadata:
+/// normalised name, version, requires-python, dependencies plus optional dependencies under
+/// `extra == …` markers, the extras, and the dynamic gates uv documents.
+#[hegel::test]
+fn pyproject_metadata_matches_the_reference(tc: TestCase) {
+    // The sdist version (known half the time) lets `parse_pyproject_toml` tolerate a dynamic version.
+    let (spec, sdist_version) = tc.draw(hegel::tuples!(pyproject(), maybe(0.5, generators::sampled_from(VERSIONS))));
+    let toml = spec.render();
+    let reference = ask_result("P", &[&toml]).unwrap_or_else(|e| panic!("reference: {e}\n{toml}"));
+    let pyproject = PyProjectToml::from_toml(&toml, "pyproject.toml").unwrap_or_else(|e| panic!("{e}\n{toml}"));
+    let sdist_version = sdist_version.map(|v| Version::from_str(v).unwrap());
+
+    // requires_python() only cares about its own field being dynamic.
+    let rp = pyproject.requires_python();
+    if spec.has_dynamic("requires-python") {
+        assert!(matches!(rp, Err(MetadataError::DynamicField("requires-python"))), "{rp:?}\n{toml}");
+    } else {
+        let expected = reference["requires_python"].as_str().map(|s| strs(&ask_json("S", &[s])));
+        assert_eq!(rp.unwrap().as_ref().map(specs_of_uv), expected, "{toml}");
+    }
+
+    // Expected requirements: dependencies, then each extra's, marked with the extra.
+    let mut expected: Vec<(ReqView, Option<String>)> = strs(&reference["dependencies"])
+        .iter()
+        .map(|d| (view_of_json(&ask_json("R", &[d])), None))
+        .collect();
+    let mut expected_extras: Vec<String> = Vec::new();
+    if let Some(optional) = reference["optional"].as_object() {
+        for (extra, deps) in optional {
+            let canonical = ask_ok("N", &[extra]);
+            for d in strs(deps) {
+                let mut view = view_of_json(&ask_json("R", &[&d]));
+                view.marker = true;
+                expected.push((view, Some(canonical.clone())));
+            }
+            expected_extras.push(canonical);
+        }
+    }
+    let check_requirements = |requires_dist: &[Requirement<VerbatimParsedUrl>], provides_extra: &[String]| {
+        // The reference's optional-dependency table arrives sorted by extra (JSON object), uv keeps
+        // the TOML order: compare as sorted lists.
+        let mut actual: Vec<(ReqView, Option<String>)> = requires_dist
+            .iter()
+            .map(|r| {
+                let marker = r.marker.contents().map(|c| c.to_string()).unwrap_or_default();
+                let extra = expected_extras.iter().find(|e| marker.contains(&format!("extra == '{e}'"))).cloned();
+                (view_of_uv(r), extra)
+            })
+            .collect();
+        actual.sort();
+        let mut expected = expected.clone();
+        expected.sort();
+        assert_eq!(actual, expected, "{toml}");
+        let mut provides_extra = provides_extra.to_vec();
+        provides_extra.sort();
+        let mut expected_extras = expected_extras.clone();
+        expected_extras.sort();
+        assert_eq!(provides_extra, expected_extras, "{toml}");
+    };
+
+    let meta = ResolutionMetadata::parse_pyproject_toml(pyproject.clone(), sdist_version.as_ref());
+    let requires = RequiresDist::from_pyproject_toml(pyproject.clone());
+    // The crate walks `dynamic` in order and stops at the first field it cannot tolerate.
+    let meta_block = spec.dynamic.iter().find(|d| {
+        matches!(**d, "dependencies" | "optional-dependencies" | "requires-python")
+            || (**d == "version" && sdist_version.is_none())
+    });
+    let requires_block = spec
+        .dynamic
+        .iter()
+        .find(|d| matches!(**d, "dependencies" | "optional-dependencies"));
+    let poetry_blocks = spec.poetry && spec.dependencies.is_none();
+    if let Some(field) = meta_block {
+        assert!(matches!(&meta, Err(MetadataError::DynamicField(f)) if f == field), "{meta:?}\n{toml}");
+    } else if poetry_blocks {
+        assert!(matches!(&meta, Err(MetadataError::PoetrySyntax)), "{meta:?}\n{toml}");
+    } else if spec.version.is_none() && sdist_version.is_none() {
+        assert!(matches!(&meta, Err(MetadataError::FieldNotFound("version"))), "{meta:?}\n{toml}");
+    } else {
+        let meta = meta.unwrap_or_else(|e| panic!("{e}\n{toml}"));
+        assert_eq!(meta.name.to_string(), reference["name"].as_str().unwrap(), "{toml}");
+        let expected_version = spec.version.map(|v| ask_ok("V", &[v])).or_else(|| sdist_version.as_ref().map(|v| v.to_string()));
+        assert_eq!(Some(meta.version.to_string()), expected_version, "{toml}");
+        let expected_python = reference["requires_python"].as_str().map(|s| strs(&ask_json("S", &[s])));
+        assert_eq!(meta.requires_python.as_ref().map(specs_of_uv), expected_python, "{toml}");
+        assert_eq!(meta.dynamic, spec.has_dynamic("version"), "{toml}");
+        let extras: Vec<String> = meta.provides_extra.iter().map(|e| e.to_string()).collect();
+        check_requirements(&meta.requires_dist, &extras);
+    }
+    // `RequiresDist` reads the same table without a version: the documented errors are its
+    // verdict, else the requirements agree.
+    if let Some(field) = requires_block {
+        assert!(matches!(&requires, Err(MetadataError::DynamicField(f)) if f == field), "{requires:?}\n{toml}");
+    } else if poetry_blocks {
+        assert!(matches!(&requires, Err(MetadataError::PoetrySyntax)), "{requires:?}\n{toml}");
+    } else {
+        let requires = requires.unwrap_or_else(|e| panic!("{e}\n{toml}"));
+        assert_eq!(requires.name.to_string(), reference["name"].as_str().unwrap());
+        assert_eq!(requires.dynamic, spec.has_dynamic("version"));
+        let extras: Vec<String> = requires.provides_extra.iter().map(|e| e.to_string()).collect();
+        check_requirements(&requires.requires_dist, &extras);
+    }
+}
