+//! Hegel properties for `uv-pypi-types`' metadata module — `Metadata23` (core metadata in the
+//! `METADATA`/`PKG-INFO` email format, and its `core_metadata_format` writer),
+//! `ResolutionMetadata` (`parse_metadata`, `parse_pkg_info`, `parse_pyproject_toml`),
+//! `Metadata10`, `RequiresDist`, `PyProjectToml::requires_python`, and the
+//! `LenientRequirement`/`LenientVersionSpecifiers` fix-ups — with PyPA's **`packaging.metadata`**
+//! (`parse_email`), **`packaging.requirements`/`specifiers`/`version`** and the PEP 621 reference
+//! **`pyproject_metadata`** (`StandardMetadata.from_pyproject`) as the oracles, driven as one
+//! persistent Python child.
+//!
+//! The generators are values: a property draws one record — a `Spec` (every core-metadata field
+//! and the order its headers are written in, a `permutations` draw), a `Breakage` with the `Wrap`
+//! that makes a requirement of it, a `Pyproject` — built from `tuples!`, `one_of!`,
+//! `sampled_from`, `vecs`, `btree_maps`, `permutations` and `maybe`/`chance` over
+//! `weighted_booleans`, and renders it with pure functions (`Spec::render`, `Breakage::texts`,
+//! `Pyproject::render`).  The absent or plainest alternative comes first in every choice, so a
+//! shrunk case is a three-header file, a `>dev` specifier or a `[project]` table with a name.
+//! Fields a `dynamic` list rules out are absent by construction (a `flat_map` from the list),
+//! and the extras of `optional-dependencies` are the keys of a map, distinct by construction.
+
+use std::collections::BTreeMap;
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::str::FromStr;
+use std::sync::{Mutex, OnceLock};
+
+use hegel::generators::{self, BoxedPrintableGenerator, Generator as _};
+use hegel::{PrintableGenerator, TestCase};
+use serde_json::Value;
+use uv_pep440::{Version, VersionSpecifiers};
+use uv_pep508::{Requirement, VersionOrUrl};
+use uv_pypi_types::{
+    LenientRequirement, LenientVersionSpecifiers, Metadata10, Metadata23, MetadataError,
+    PyProjectToml, RequiresDist, ResolutionMetadata, VerbatimParsedUrl,
+};
+
+// --------------------------------------------------------------------------- the Python oracle
+
+const ORACLE_SCRIPT: &str = r#"
+import json
+import sys
+import tomllib
+from packaging.metadata import parse_email
+from packaging.requirements import Requirement
+from packaging.specifiers import SpecifierSet
+from packaging.utils import canonicalize_name
+from packaging.version import Version
+from pyproject_metadata import StandardMetadata
+
+def dec(h):
+    return bytes.fromhex(h).decode('utf-8')
+
+def enc(s):
+    return s.encode('utf-8').hex()
+
+def requirement(text):
+    req = Requirement(text)
+    return {
+        'name': canonicalize_name(req.name),
+        'specs': sorted(str(s).replace(' ', '') for s in req.specifier),
+        'extras': sorted(canonicalize_name(e) for e in req.extras),
+        'marker': req.marker is not None,
+        'url': req.url,
+    }
+
+def pyproject(text):
+    data = tomllib.loads(text)
+    m = StandardMetadata.from_pyproject(data, allow_extra_keys=True)
+    return {
+        'name': str(m.canonical_name),
+        'version': str(m.version) if m.version is not None else None,
+        'requires_python': str(m.requires_python) if m.requires_python is not None else None,
+        'dependencies': [str(r) for r in m.dependencies],
+        'optional': {k: [str(r) for r in v] for k, v in m.optional_dependencies.items()},
+        'dynamic': list(m.dynamic),
+    }
+
+for line in sys.stdin:
+    parts = line.rstrip('\n').split(' ')
+    cmd, args = parts[0], [dec(p) for p in parts[1:]]
+    try:
+        if cmd == 'E':
+            raw, unparsed = parse_email(args[0])
+            out = ['ok', json.dumps({'raw': raw, 'unparsed': unparsed})]
+        elif cmd == 'R':
+            out = ['ok', json.dumps(requirement(args[0]))]
+        elif cmd == 'S':
+            out = ['ok', json.dumps(sorted(str(s).replace(' ', '') for s in SpecifierSet(args[0])))]
+        elif cmd == 'V':
+            out = ['ok', str(Version(args[0]))]
+        elif cmd == 'N':
+            out = ['ok', canonicalize_name(args[0], validate=True)]
+        elif cmd == 'P':
+            out = ['ok', json.dumps(pyproject(args[0]))]
+        else:
+            out = ['bad', cmd]
+    except Exception as e:
+        out = ['err', f"{type(e).__name__}: {e}"]
+    print(' '.join([out[0]] + [enc(x) for x in out[1:]]), flush=True)
+"#;
+
+struct Oracle {
+    child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+static ORACLE: OnceLock<Mutex<Oracle>> = OnceLock::new();
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|b| format!("{b:02x}")).collect()
+}
+
+fn unhex(h: &str) -> String {
+    let bytes: Vec<u8> = (0..h.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&h[i..i + 2], 16).unwrap())
+        .collect();
+    String::from_utf8(bytes).unwrap()
+}
+
+fn oracle() -> &'static Mutex<Oracle> {
+    ORACLE.get_or_init(|| {
+        let python = ["python3", "/usr/bin/python3"]
+            .into_iter()
+            .find(|py| {
+                Command::new(py)
+                    .args(["-c", "import packaging.metadata, pyproject_metadata"])
+                    .stdout(Stdio::null())
+                    .stderr(Stdio::null())
+                    .status()
+                    .is_ok_and(|s| s.success())
+            })
+            .expect("a python3 with `packaging` and `pyproject_metadata` is needed as the oracle");
+        let mut child = Command::new(python)
+            .arg("-u")
+            .arg("-c")
+            .arg(ORACLE_SCRIPT)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .expect("spawn the packaging oracle");
+        let stdin = child.stdin.take().unwrap();
+        let stdout = BufReader::new(child.stdout.take().unwrap());
+        Mutex::new(Oracle {
+            child,
+            stdin,
+            stdout,
+        })
+    })
+}
+
+/// Ask the oracle: the status (`ok` or `err`) and the decoded fields.
+fn ask(cmd: &str, args: &[&str]) -> (String, Vec<String>) {
+    let mut o = oracle().lock().unwrap();
+    let mut line = cmd.to_string();
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a));
+    }
+    line.push('\n');
+    o.stdin.write_all(line.as_bytes()).expect("oracle stdin");
+    let mut reply = String::new();
+    let n = o.stdout.read_line(&mut reply).expect("oracle stdout");
+    if n == 0 {
+        let status = o.child.try_wait().ok().flatten();
+        panic!("the Python oracle exited ({status:?})");
+    }
+    let mut it = reply.trim_end_matches(['\n', '\r']).split(' ');
+    let status = it.next().unwrap().to_string();
+    assert!(matches!(status.as_str(), "ok" | "err"), "oracle said {reply:?} to {line:?}");
+    (status, it.filter(|s| !s.is_empty()).map(unhex).collect())
+}
+
+fn ask_ok(cmd: &str, args: &[&str]) -> String {
+    let (status, fields) = ask(cmd, args);
+    assert_eq!(status, "ok", "{cmd} {args:?}: {fields:?}");
+    fields.into_iter().next().unwrap_or_default()
+}
+
+fn ask_json(cmd: &str, args: &[&str]) -> Value {
+    serde_json::from_str(&ask_ok(cmd, args)).expect("oracle JSON")
+}
+
+fn ask_result(cmd: &str, args: &[&str]) -> Result<Value, String> {
+    let (status, fields) = ask(cmd, args);
+    if status == "ok" {
+        Ok(serde_json::from_str(&fields[0]).expect("oracle JSON"))
+    } else {
+        Err(fields.join(" "))
+    }
+}
+
+// --------------------------------------------------------------------------- generator helpers
+
+fn ints(lo: i64, hi: i64) -> generators::IntegerGenerator<i64> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// True `p` of the time; shrinks to false.
+fn chance(p: f64) -> generators::BoolGenerator {
+    generators::weighted_booleans(p)
+}
+
+/// `Some` of `g` `p` of the time, else `None`; shrinks to `None`, and draws `g` only when present.
+fn maybe<T>(
+    p: f64,
+    g: impl PrintableGenerator<T> + Send + Sync + 'static,
+) -> impl PrintableGenerator<Option<T>>
+where
+    T: hegel::PrettyPrintable + Clone + Send + Sync + 'static,
+{
+    let present = g.map(Some).boxed_printable();
+    let absent: BoxedPrintableGenerator<'static, Option<T>> = generators::just(None).boxed_printable();
+    chance(p).flat_map(move |yes| if yes { present.clone() } else { absent.clone() })
+}
+
+/// Up to `max` entries of a pool (repeats allowed, as a multi-use field allows).
+fn some_of(pool: &'static [&'static str], max: usize) -> impl PrintableGenerator<Vec<&'static str>> {
+    generators::vecs(generators::sampled_from(pool)).max_size(max)
+}
+
+// --------------------------------------------------------------------------- oracle views
+
+fn strs(v: &Value) -> Vec<String> {
+    v.as_array()
+        .map(|a| a.iter().map(|s| s.as_str().unwrap().to_string()).collect())
+        .unwrap_or_default()
+}
+
+/// The reference's view of a requirement, for comparison with uv's parse.
+#[derive(Debug, PartialEq, Eq, PartialOrd, Ord, Clone)]
+struct ReqView {
+    name: String,
+    specs: Vec<String>,
+    extras: Vec<String>,
+    marker: bool,
+}
+
+fn view_of_json(v: &Value) -> ReqView {
+    ReqView {
+        name: v["name"].as_str().unwrap().to_string(),
+        specs: strs(&v["specs"]),
+        extras: strs(&v["extras"]),
+        marker: v["marker"].as_bool().unwrap(),
+    }
+}
+
+fn view_of_uv(r: &Requirement<VerbatimParsedUrl>) -> ReqView {
+    let mut specs = match &r.version_or_url {
+        Some(VersionOrUrl::VersionSpecifier(vs)) => {
+            vs.iter().map(|s| s.to_string().replace(' ', "")).collect::<Vec<_>>()
+        }
+        Some(VersionOrUrl::Url(_)) => vec!["<url>".to_string()],
+        None => Vec::new(),
+    };
+    specs.sort();
+    let mut extras: Vec<String> = r.extras.iter().map(|e| e.to_string()).collect();
+    extras.sort();
+    extras.dedup();
+    ReqView {
+        name: r.name.to_string(),
+        specs,
+        extras,
+        marker: r.marker.contents().is_some(),
+    }
+}
+
+fn specs_of_uv(vs: &VersionSpecifiers) -> Vec<String> {
+    let mut v: Vec<String> = vs.iter().map(|s| s.to_string().replace(' ', "")).collect();
+    v.sort();
+    v
+}
+
+fn opt_str(v: &Value, key: &str) -> Option<String> {
+    v.get(key).and_then(|x| x.as_str()).map(|s| s.to_string())
+}
+
+fn list(v: &Value, key: &str) -> Vec<String> {
+    v.get(key).map(strs).unwrap_or_default()
+}
+
+// --------------------------------------------------------------------------- pools
+
+const NAMES: &[&str] = &["requests", "Flask", "numpy", "a-b_c.d", "Zope.Interface", "x1"];
+const VERSIONS: &[&str] = &["1.0", "2.31.0", "0.1a1", "1.0.post1", "3.9.0rc2", "1.0+local.1", "10"];
+const REQUIREMENTS: &[&str] = &[
+    "requests",
+    "Flask>=2",
+    "numpy (>=1.19,<2)",
+    "a-b_c.d[Extra_1,x]==1.0.*",
+    "Zope.Interface ; python_version >= '3.8'",
+    "x1 ~=1.4 ; sys_platform == \"linux\"",
+    "requests[security] !=2.0.0 ; extra == 'sec'",
+];
+const SPECIFIER_SETS: &[&str] = &[">=3.8", ">=3.8,<4", "~=3.9", "!=3.0.*,>=2.7", ">3.6.0", "==3.12.*"];
+const EXTRAS: &[&str] = &["security", "Extra_1", "tests", "a.b", "x"];
+/// Free-text values: words, spaces, a URL, a two-byte character (`Zo\u{eb}`), punctuation.
+const WORDS: &[&str] = &[
+    "hello", "World", "a b c", "x/y", "https://example.com/p", "Zo\u{eb}", "v1.0", "(c) 2026", "a;b", "k=v",
+];
+const CLASSIFIERS: &[&str] = &[
+    "Programming Language :: Python :: 3",
+    "License :: OSI Approved :: MIT License",
+    "Operating System :: OS Independent",
+];
+const METADATA_VERSIONS: &[&str] = &["1.0", "1.2", "2.1", "2.2", "2.3", "2.4", "2.5"];
+const CONTENT_TYPES: &[&str] = &["text/markdown", "text/x-rst"];
+const KEYWORDS: &[&str] = &["dog", "puppy", "voting", "x-y"];
+const AUTHOR_EMAIL: &str = "Ann <ann@example.com>";
+const MAINTAINER_EMAIL: &str = "m@example.com";
+const LICENSE_EXPRESSIONS: &[&str] = &["MIT", "Apache-2.0 OR BSD-2-Clause"];
+const LICENSE_FILES: &[&str] = &["LICENSE", "LICENSES/MIT.txt"];
+/// `Project-URL` labels; the URL is derived from the label (distinct labels, since duplicate
+/// labels are a documented difference: uv keeps the last, packaging leaves them unparsed).
+const URL_LABELS: &[&str] = &["Homepage", "Bug Tracker", "Docs"];
+const IMPORT_NAMES: &[&str] = &["spam.foo", "spam.eggs; private", "ham"];
+const IMPORT_NAMESPACES: &[&str] = &["zope", "flask_ext"];
+const DYNAMIC_FIELDS: &[&str] = &[
+    "Version",
+    "Requires-Dist",
+    "Provides-Extra",
+    "Requires-Python",
+    "License-File",
+    "Summary",
+];
+
+fn word() -> generators::SampledFromGenerator<'static, &'static str> {
+    generators::sampled_from(WORDS)
+}
+
+// --------------------------------------------------------------------------- generated metadata
+
+/// The description: absent, a `Description` header, or the message body (one paragraph or two).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Description {
+    Absent,
+    Header(&'static str),
+    Body(&'static str),
+    Paragraphs(&'static str, &'static str),
+}
+
+impl Description {
+    fn header(&self) -> Option<String> {
+        match self {
+            Description::Header(text) => Some(text.to_string()),
+            _ => None,
+        }
+    }
+
+    fn body(&self) -> Option<String> {
+        match self {
+            Description::Body(text) => Some(text.to_string()),
+            Description::Paragraphs(a, b) => Some(format!("{a}\n\n{b}\n")),
+            _ => None,
+        }
+    }
+}
+
+fn description() -> impl PrintableGenerator<Description> {
+    hegel::one_of!(
+        generators::just(Description::Absent),
+        word().map(Description::Header),
+        word().map(Description::Body),
+        hegel::tuples!(word(), word()).map(|(a, b)| Description::Paragraphs(a, b)),
+    )
+}
+
+/// The optional header kinds; a file lists them in a drawn permutation of this order (the
+/// mandatory `Metadata-Version`, `Name` and `Version` always come first).
+#[rustfmt::skip]
+const HEADER_KINDS: &[&str] = &[
+    "Summary", "Description", "Description-Content-Type", "Keywords", "Home-page", "Download-URL",
+    "Author", "Author-email", "Maintainer", "Maintainer-email", "License", "License-Expression",
+    "Requires-Python", "Platform", "Supported-Platform", "License-File", "Classifier",
+    "Requires-Dist", "Provides-Dist", "Obsoletes-Dist", "Requires-External", "Project-URL",
+    "Provides-Extra", "Import-Name", "Import-Namespace", "Dynamic",
+];
+
+/// A generated `METADATA` file: the fields and the order of their headers.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Spec {
+    metadata_version: &'static str,
+    name: &'static str,
+    version: &'static str,
+    platforms: Vec<&'static str>,
+    supported_platforms: Vec<&'static str>,
+    summary: Option<&'static str>,
+    description: Description,
+    description_content_type: Option<&'static str>,
+    keywords: Option<Vec<&'static str>>,
+    home_page: Option<&'static str>,
+    download_url: Option<&'static str>,
+    author: Option<&'static str>,
+    author_email: Option<&'static str>,
+    maintainer: Option<&'static str>,
+    maintainer_email: Option<&'static str>,
+    license: Option<&'static str>,
+    license_expression: Option<&'static str>,
+    license_files: Vec<&'static str>,
+    classifiers: Vec<&'static str>,
+    requires_dist: Vec<&'static str>,
+    provides_dist: Vec<&'static str>,
+    obsoletes_dist: Vec<&'static str>,
+    requires_python: Option<&'static str>,
+    requires_external: Vec<&'static str>,
+    /// `Project-URL` labels (the URL is derived from the label).
+    project_urls: Vec<&'static str>,
+    provides_extra: Vec<&'static str>,
+    import_names: Vec<&'static str>,
+    import_namespaces: Vec<&'static str>,
+    dynamic: Vec<&'static str>,
+    /// The order of the optional headers: a permutation of `HEADER_KINDS`.
+    order: Vec<&'static str>,
+}
+
+impl Spec {
+    fn project_url(label: &str) -> String {
+        format!("https://example.com/{}", label.to_lowercase().replace(' ', "-"))
+    }
+
+    /// The values written for one header kind.
+    fn values(&self, kind: &str) -> Vec<String> {
+        let one = |v: &Option<&'static str>| -> Vec<String> { v.iter().map(|s| s.to_string()).collect() };
+        let many = |v: &[&'static str]| -> Vec<String> { v.iter().map(|s| s.to_string()).collect() };
+        match kind {
+            "Summary" => one(&self.summary),
+            "Description" => self.description.header().into_iter().collect(),
+            "Description-Content-Type" => one(&self.description_content_type),
+            "Keywords" => self.keywords.iter().map(|k| k.join(",")).collect(),
+            "Home-page" => one(&self.home_page),
+            "Download-URL" => one(&self.download_url),
+            "Author" => one(&self.author),
+            "Author-email" => one(&self.author_email),
+            "Maintainer" => one(&self.maintainer),
+            "Maintainer-email" => one(&self.maintainer_email),
+            "License" => one(&self.license),
+            "License-Expression" => one(&self.license_expression),
+            "Requires-Python" => one(&self.requires_python),
+            "Platform" => many(&self.platforms),
+            "Supported-Platform" => many(&self.supported_platforms),
+            "License-File" => many(&self.license_files),
+            "Classifier" => many(&self.classifiers),
+            "Requires-Dist" => many(&self.requires_dist),
+            "Provides-Dist" => many(&self.provides_dist),
+            "Obsoletes-Dist" => many(&self.obsoletes_dist),
+            "Requires-External" => many(&self.requires_external),
+            "Project-URL" => self
+                .project_urls
+                .iter()
+                .map(|label| format!("{label}, {}", Self::project_url(label)))
+                .collect(),
+            "Provides-Extra" => many(&self.provides_extra),
+            "Import-Name" => many(&self.import_names),
+            "Import-Namespace" => many(&self.import_namespaces),
+            "Dynamic" => many(&self.dynamic),
+            other => unreachable!("{other} is not a header kind"),
+        }
+    }
+
+    /// Render as email-style metadata: the mandatory three headers, the others in `order`, the
+    /// description body after a blank line.
+    fn render(&self) -> String {
+        let mut out = format!(
+            "Metadata-Version: {}\nName: {}\nVersion: {}\n",
+            self.metadata_version, self.name, self.version
+        );
+        for kind in &self.order {
+            for value in self.values(kind) {
+                out.push_str(&format!("{kind}: {value}\n"));
+            }
+        }
+        if let Some(body) = self.description.body() {
+            out.push('\n');
+            out.push_str(&body);
+        }
+        out
+    }
+}
+
+/// Every core-metadata field: the mandatory three from their pools, each single-use field
+/// present between one time in five and one in two, each multi-use field with up to a few
+/// values, distinct `Project-URL` labels, up to two `Dynamic` entries, and the header order.
+fn spec() -> impl PrintableGenerator<Spec> {
+    let text = hegel::tuples!(
+        generators::sampled_from(METADATA_VERSIONS),
+        generators::sampled_from(NAMES),
+        generators::sampled_from(VERSIONS),
+        some_of(WORDS, 2),
+        some_of(WORDS, 2),
+        maybe(0.5, word()),
+        description(),
+        maybe(0.3, generators::sampled_from(CONTENT_TYPES)),
+        maybe(0.4, generators::vecs(generators::sampled_from(KEYWORDS)).min_size(1).max_size(3)),
+        maybe(0.3, word()),
+    );
+    let people = hegel::tuples!(
+        maybe(0.2, word()),
+        maybe(0.4, word()),
+        maybe(0.3, generators::just(AUTHOR_EMAIL)),
+        maybe(0.2, word()),
+        maybe(0.2, generators::just(MAINTAINER_EMAIL)),
+        maybe(0.4, word()),
+        maybe(0.3, generators::sampled_from(LICENSE_EXPRESSIONS)),
+        some_of(LICENSE_FILES, 2),
+        some_of(CLASSIFIERS, 3),
+        some_of(REQUIREMENTS, 4),
+    );
+    let dist = hegel::tuples!(
+        some_of(NAMES, 1),
+        some_of(NAMES, 1),
+        maybe(0.5, generators::sampled_from(SPECIFIER_SETS)),
+        some_of(WORDS, 1),
+        generators::vecs(generators::sampled_from(URL_LABELS)).unique(true).max_size(3),
+        some_of(EXTRAS, 3),
+        some_of(IMPORT_NAMES, 2),
+        some_of(IMPORT_NAMESPACES, 1),
+        some_of(DYNAMIC_FIELDS, 2),
+        generators::permutations(HEADER_KINDS),
+    );
+    hegel::tuples!(text, people, dist).map(
+        |(
+            (
+                metadata_version,
+                name,
+                version,
+                platforms,
+                supported_platforms,
+                summary,
+                description,
+                description_content_type,
+                keywords,
+                home_page,
+            ),
+            (
+                download_url,
+                author,
+                author_email,
+                maintainer,
+                maintainer_email,
+                license,
+                license_expression,
+                license_files,
