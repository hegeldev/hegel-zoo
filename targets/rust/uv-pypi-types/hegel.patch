+/// `ResolutionMetadata::parse_metadata` agrees with packaging on the resolution fields (name
+/// normalised, version, `Requires-Dist`, `Requires-Python`, `Provides-Extra`, dynamic version);
+/// `parse_pkg_info` is the same read behind the Metadata-Version and `Dynamic` gates;
+/// `Metadata10` reads name and version.
+#[hegel::test]
+fn resolution_metadata_matches_packaging(tc: TestCase) {
+    let spec = tc.draw(spec());
+    let text = spec.render();
+    let raw = &ask_json("E", &[&text])["raw"];
+    let meta = ResolutionMetadata::parse_metadata(text.as_bytes()).unwrap_or_else(|e| panic!("{e}\n{text}"));
+    assert_eq!(meta.name.to_string(), ask_ok("N", &[spec.name]));
+    assert_eq!(meta.version.to_string(), ask_ok("V", &[spec.version]));
+    let expected: Vec<ReqView> = list(raw, "requires_dist").iter().map(|r| view_of_json(&ask_json("R", &[r]))).collect();
+    let actual: Vec<ReqView> = meta.requires_dist.iter().map(view_of_uv).collect();
+    assert_eq!(actual, expected, "{text}");
+    let expected_python = spec.requires_python.map(|s| strs(&ask_json("S", &[s])));
+    assert_eq!(meta.requires_python.as_ref().map(specs_of_uv), expected_python, "{text}");
+    let expected_extras: Vec<String> = spec.provides_extra.iter().map(|e| ask_ok("N", &[e])).collect();
+    let actual_extras: Vec<String> = meta.provides_extra.iter().map(|e| e.to_string()).collect();
+    assert_eq!(actual_extras, expected_extras);
+    assert_eq!(meta.dynamic, spec.dynamic.contains(&"Version"), "{text}");
+
+    let ten = Metadata10::parse_pkg_info(text.as_bytes()).unwrap();
+    assert_eq!(ten.name, meta.name);
+    assert_eq!(ten.version, spec.version);
+
+    let pkg_info = ResolutionMetadata::parse_pkg_info(text.as_bytes());
+    let (major, minor) = spec.metadata_version.split_once('.').unwrap();
+    let mv: (u8, u8) = (major.parse().unwrap(), minor.parse().unwrap());
+    let blocked = spec
+        .dynamic
+        .iter()
+        .find(|d| matches!(**d, "Requires-Dist" | "Requires-Python" | "Provides-Extra"));
+    if mv < (2, 2) {
+        assert!(matches!(pkg_info, Err(MetadataError::UnsupportedMetadataVersion(_))), "{pkg_info:?}\n{text}");
+    } else if let Some(field) = blocked {
+        match pkg_info {
+            Err(MetadataError::DynamicField(f)) => assert!(spec.dynamic.contains(&f), "{f} vs {field}"),
+            other => panic!("expected a DynamicField error for {field}, got {other:?}\n{text}"),
+        }
+    } else {
+        let pkg_info = pkg_info.unwrap_or_else(|e| panic!("{e}\n{text}"));
+        assert_eq!(serde_json::to_value(&pkg_info).unwrap(), serde_json::to_value(&meta).unwrap(), "{text}");
+    }
+}
