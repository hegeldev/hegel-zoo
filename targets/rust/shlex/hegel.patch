+//! Hegel property tests for `shlex`.
+//!
+//! The crate documents its parser as splitting "using the same syntax as the POSIX shell" and its
+//! quoting as compatible with "any POSIX-compatible shell" (bash, zsh, dash, busybox ash, mksh,
+//! fish) plus Python `shlex` and C `wordexp`.  So the oracles are the shells and Python
+//! themselves:
+//!
+//! - one `bash` child is held open for the whole run; a compound array assignment `x=( <text> )`
+//!   is bash's own word splitter, and it accepts newlines between words like the crate does;
+//! - `dash` and `busybox sh` run once per case (`set -- <quoted words>`);
+//! - one `python3` child answers `shlex.split`, `shlex.quote` and `shlex.join`.
+//!
+//! Byte strings travel as hex, so invalid UTF-8 and control characters go through unchanged.
+
+use std::ffi::OsStr;
+use std::io::{BufRead, BufReader, Write};
+use std::os::unix::ffi::OsStrExt;
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::sync::{Mutex, OnceLock};
+
+use hegel::generators::Generator as _;
+use hegel::{generators, TestCase};
+use shlex::{bytes, split, try_join, try_quote, QuoteError, Quoter, Shlex};
+
+// ---------------------------------------------------------------- generators
+
+/// Units of a shell command line: letters, whitespace (newlines included), quotes, backslashes,
+/// comments, the interactive-only `!`/`^`, `\r`, punctuation bash leaves alone inside an array
+/// assignment, a control character, and bytes outside ASCII (valid UTF-8 or not).  Nothing bash
+/// would expand (`$`, backquote, `~`, globs, braces) and no `=`/`[`/`(`/`)`: those mean something
+/// to an array assignment.
+#[rustfmt::skip]
+const SPLIT_UNITS: &[&[u8]] = &[
+    b"a", b"b", b"Z", b"0", b"9", b" ", b" ", b" ", b"\t", b"\n", b"\n", b"'", b"'", b"\"", b"\"",
+    b"\\", b"\\", b"\\", b"#", b"!", b"^", b"\r", b"-", b".", b"/", b"_", b",", b"%", b"+", b":",
+    b"@", b"]", b"\x02", b"\x1f", "\u{e9}".as_bytes(), b"\xa0", b"\xff",
+];
+// Control characters: not `\x01` and `\x7f`, which are bash's internal CTLESC/CTLNUL markers and
+// which bash 5.2.21 itself mangles after a quote or a backslash (`x=( "'\x7f" )` gives
+// `'\x01\x7f`; dash and busybox ash are fine) — a bash bug, outside the crate.
+
+/// Units of a word to be quoted: everything, including what shells expand.
+#[rustfmt::skip]
+const WORD_UNITS: &[&[u8]] = &[
+    b"a", b"z", b"A", b"0", b" ", b"\t", b"\n", b"\r", b"'", b"'", b"\"", b"\"", b"\\", b"\\",
+    b"$", b"`", b"!", b"^", b"^", b"#", b"*", b"?", b"[", b"]", b"{", b"}", b"~", b"=", b"%",
+    b",", b";", b"|", b"&", b"(", b")", b"<", b">", b"+", b"-", b".", b"/", b":", b"@", b"_",
+    b"\x02", b"\x1b", b"\x1f", "\u{e9}".as_bytes(), "\u{1f600}".as_bytes(), b"\xa0",
+    "\u{a0}".as_bytes(), b"\xff",
+];
+
+/// A byte string of `lo..=hi` units drawn from `units`.
+fn units(
+    units: &'static [&'static [u8]],
+    lo: usize,
+    hi: usize,
+) -> impl hegel::PrintableGenerator<Vec<u8>> {
+    generators::vecs(generators::sampled_from(units))
+        .min_size(lo)
+        .max_size(hi)
+        .map(|us| us.concat())
+}
+
+/// Up to `max_words` words to be quoted, each of up to eight units.
+fn words(max_words: usize) -> impl hegel::PrintableGenerator<Vec<Vec<u8>>> {
+    generators::vecs(units(WORD_UNITS, 0, 8)).max_size(max_words)
+}
+
+/// One draw from `a` followed by one from `b`.
+fn cat(
+    a: impl hegel::PrintableGenerator<Vec<u8>>,
+    b: impl hegel::PrintableGenerator<Vec<u8>>,
+) -> impl hegel::PrintableGenerator<Vec<u8>> {
+    hegel::tuples!(a, b).map(|(a, b)| [a, b].concat())
+}
+
+const FIRST_WORDS: &[&[u8]] = &[b"a", b"\"\"", b"'x y'", b"a\\ b"];
+const NEXT_WORDS: &[&[u8]] = &[b"b", b"\"\"", b"'c'"];
+const BLANKS: &[&[u8]] = &[b" ", b"\t", b"\n"];
+const CONTINUATION: &[&[u8]] = &[b"\\\n"];
+const COMMENT: &[&[u8]] = &[b"# comment"];
+
+/// A command line with one or two line continuations at the start of a word: after nothing or
+/// a first word and blanks; followed by nothing, blanks, blanks and a word, or a comment.
+fn continuation_text() -> impl hegel::PrintableGenerator<Vec<u8>> {
+    let lead = hegel::one_of!(
+        generators::just(Vec::new()),
+        cat(units(FIRST_WORDS, 1, 1), units(BLANKS, 1, 2)),
+        cat(units(FIRST_WORDS, 1, 1), units(BLANKS, 1, 2)),
+        cat(units(FIRST_WORDS, 1, 1), units(BLANKS, 1, 2)),
+    );
+    let tail = hegel::one_of!(
+        generators::just(Vec::new()),
+        units(BLANKS, 1, 2),
+        cat(units(BLANKS, 1, 2), units(NEXT_WORDS, 1, 1)),
+        cat(units(BLANKS, 1, 2), units(COMMENT, 1, 1)),
+    );
+    cat(cat(lead, units(CONTINUATION, 1, 2)), tail)
+}
+
+/// A word to quote, with a NUL byte inserted three times in ten, and whether one was.
+#[hegel::composite]
+fn word_maybe_nul(tc: &TestCase) -> (Vec<u8>, bool) {
+    let mut word = tc.draw(units(WORD_UNITS, 0, 8));
+    let with_nul = tc.draw(generators::weighted_booleans(0.3));
+    if with_nul {
+        let at = tc.draw(
+            generators::integers::<i64>()
+                .min_value(0)
+                .max_value(word.len() as i64),
+        );
+        word.insert(at as usize, 0);
+    }
+    (word, with_nul)
+}
+
+fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{:02x}", x)).collect()
+}
+
+fn unhex(s: &str) -> Vec<u8> {
+    (0..s.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap())
+        .collect()
+}
+
+/// NUL-separated words from a shell's `printf '%s\0'` loop.
+fn nul_words(out: &[u8]) -> Vec<Vec<u8>> {
+    let mut words: Vec<Vec<u8>> = out.split(|&b| b == 0).map(|w| w.to_vec()).collect();
+    words.pop(); // after the last `\0`
+    words
+}
+
+fn show(words: &Option<Vec<Vec<u8>>>) -> String {
+    match words {
+        None => "None".to_string(),
+        Some(ws) => format!(
+            "{:?}",
+            ws.iter()
+                .map(|w| String::from_utf8_lossy(w).into_owned())
+                .collect::<Vec<_>>()
+        ),
+    }
+}
+
+// ---------------------------------------------------------------- the shells
+
+struct Proc {
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+    _child: Child,
+}
+
+fn spawn(program: &str, args: &[&str]) -> Proc {
+    let mut child = Command::new(program)
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .spawn()
+        .unwrap_or_else(|e| panic!("{} is needed as an oracle: {}", program, e));
+    let stdin = child.stdin.take().unwrap();
+    let stdout = BufReader::new(child.stdout.take().unwrap());
+    Proc {
+        stdin,
+        stdout,
+        _child: child,
+    }
+}
+
+const END: &[u8] = b"\x01<<end-of-reply>>\x02\n";
+
+fn bash() -> &'static Mutex<Proc> {
+    static SH: OnceLock<Mutex<Proc>> = OnceLock::new();
+    SH.get_or_init(|| Mutex::new(spawn("bash", &["--norc", "--noprofile", "-s"])))
+}
+
+/// bash's word splitting of `text`: the elements of the array `x=( <text> )`, or `None` for a
+/// syntax error (an unterminated quote).  A newline is appended before the `)` so a trailing
+/// comment does not swallow it.
+fn bash_words(text: &[u8]) -> Option<Vec<Vec<u8>>> {
+    let esc: String = text.iter().map(|b| format!("\\x{:02x}", b)).collect();
+    let cmd = format!(
+        "printf -v t '{esc}'; x=(); if eval \"x=( $t \"$'\\n'\")\" 2>/dev/null; \
+         then for w in \"${{x[@]}}\"; do printf '%s\\0' \"$w\"; done; else printf '\\2'; fi; \
+         printf '\\1<<end-of-reply>>\\2\\n'\n"
+    );
+    let mut sh = bash().lock().unwrap();
+    sh.stdin.write_all(cmd.as_bytes()).unwrap();
+    let mut reply = Vec::new();
+    while !reply.ends_with(END) {
+        let got = sh.stdout.read_until(b'\n', &mut reply).unwrap();
+        assert!(got > 0, "bash died");
+    }
+    reply.truncate(reply.len() - END.len());
+    if reply == b"\x02" {
+        None
+    } else {
+        Some(nul_words(&reply))
+    }
+}
+
+/// `set -- <line>` in dash or busybox ash, one process per call.
+fn sh_words(shell: &[&str], line: &[u8]) -> Option<Vec<Vec<u8>>> {
+    let mut script = b"set -- ".to_vec();
+    script.extend_from_slice(line);
+    script.extend_from_slice(b"\nfor w; do printf '%s\\0' \"$w\"; done");
+    let out = Command::new(shell[0])
+        .args(&shell[1..])
+        .arg("-c")
+        .arg(OsStr::from_bytes(&script))
+        .stderr(Stdio::null())
+        .output()
+        .unwrap_or_else(|e| panic!("{} is needed as an oracle: {}", shell[0], e));
+    if out.status.success() {
+        Some(nul_words(&out.stdout))
+    } else {
+        None
+    }
+}
+
+// ---------------------------------------------------------------- Python's shlex
+
+const PY_SERVER: &str = r#"
+import sys, shlex
+def dec(h): return bytes.fromhex(h).decode('utf-8', 'surrogateescape')
+def enc(s): return s.encode('utf-8', 'surrogateescape').hex()
+for line in sys.stdin:
+    parts = line.rstrip('\n').split(' ')
+    op, count = parts[0], int(parts[1])
+    args = [dec(h) for h in parts[2:2 + count]]
+    try:
+        if op == 'split':
+            r = shlex.split(args[0])
+        elif op == 'quote':
+            r = [shlex.quote(args[0])]
+        else:
+            r = [shlex.join(args)]
+        print('ok', len(r), *[enc(x) for x in r], flush=True)
+    except ValueError as e:
+        print('err', 1, enc(str(e)), flush=True)
+"#;
+
+fn py() -> &'static Mutex<Proc> {
+    static PY: OnceLock<Mutex<Proc>> = OnceLock::new();
+    PY.get_or_init(|| Mutex::new(spawn("python3", &["-u", "-c", PY_SERVER])))
+}
+
+/// `shlex.<op>(...)` in Python; `None` is a `ValueError`.
+fn python(op: &str, args: &[&[u8]]) -> Option<Vec<Vec<u8>>> {
+    let mut line = format!("{} {}", op, args.len());
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a));
+    }
+    line.push('\n');
+    let mut py = py().lock().unwrap();
+    py.stdin.write_all(line.as_bytes()).unwrap();
+    let mut reply = String::new();
+    py.stdout.read_line(&mut reply).unwrap();
+    let parts: Vec<&str> = reply.trim_end_matches('\n').split(' ').collect();
+    match parts[0] {
+        "ok" => Some(parts[2..].iter().map(|h| unhex(h)).collect()),
+        _ => None,
+    }
+}
+
+fn python_split(text: &[u8]) -> Option<Vec<Vec<u8>>> {
+    python("split", &[text])
+}
+
+fn python_quote(word: &[u8]) -> Vec<u8> {
+    python("quote", &[word]).unwrap().remove(0)
+}
+
+fn python_join(words: &[Vec<u8>]) -> Vec<u8> {
+    let refs: Vec<&[u8]> = words.iter().map(|w| w.as_slice()).collect();
+    python("join", &refs).unwrap().remove(0)
+}
+
+// ---------------------------------------------------------------- properties: splitting
+
+/// The pinned shape of shlex/1: a `\`‑newline at the start of a word (preceded by whitespace or
+/// at the start of the text).
+fn continuation_at_word_start(text: &[u8]) -> bool {
+    text.windows(2)
+        .enumerate()
+        .any(|(i, w)| w == b"\\\n" && (i == 0 || matches!(text[i - 1], b' ' | b'\t' | b'\n')))
+}
+
+/// `bytes::split` gives the words bash gives for the same text (`None` where bash reports a
+/// syntax error); the `str` API and the iterator agree with it.
+#[hegel::test]
+fn split_agrees_with_bash(tc: TestCase) {
+    let text = tc.draw(units(SPLIT_UNITS, 0, 14));
+    tc.assume(!continuation_at_word_start(&text));
+    let ours = bytes::split(&text);
+    // Documented: input ending right after an unescaped backslash is an error for the crate.
+    tc.assume(!(ours.is_none() && text.ends_with(b"\\")));
+    let theirs = bash_words(&text);
+    assert_eq!(
+        ours,
+        theirs,
+        "text {:?}: crate {} bash {}",
+        String::from_utf8_lossy(&text),
+        show(&ours),
+        show(&theirs)
+    );
+}
+
+/// The `str` front end, the iterator, `had_error` and `line_no` are consistent with
+/// `bytes::split`.
+#[hegel::test]
+fn iterator_and_str_api_agree_with_bytes_split(tc: TestCase) {
+    let text = tc.draw(units(SPLIT_UNITS, 0, 14));
+    let by_bytes = bytes::split(&text);
+    let mut it = bytes::Shlex::new(&text);
+    let words: Vec<Vec<u8>> = it.by_ref().collect();
+    assert_eq!(it.had_error, by_bytes.is_none());
+    if let Some(ws) = &by_bytes {
+        assert_eq!(&words, ws);
+    }
+    let newlines = text.iter().filter(|&&b| b == b'\n').count();
+    assert_eq!(
+        it.line_no,
+        newlines + 1,
+        "line_no counts the newlines read so far, plus one"
+    );
+    if let Ok(s) = std::str::from_utf8(&text) {
+        let by_str = split(s);
+        assert_eq!(
+            by_str
+                .as_ref()
+                .map(|ws| ws.iter().map(|w| w.as_bytes().to_vec()).collect::<Vec<_>>()),
+            by_bytes
+        );
+        let mut sit = Shlex::new(s);
+        let swords: Vec<String> = sit.by_ref().collect();
+        assert_eq!(sit.had_error, by_str.is_none());
+        if let Some(ws) = &by_str {
+            assert_eq!(&swords, ws);
+        }
+        assert_eq!(sit.line_no, newlines + 1);
+    }
+}
+
+/// shlex/1: a line continuation at the start of a word yields an empty word.  bash (and POSIX:
+/// "the <backslash> and <newline> shall be removed") yield nothing.
+#[hegel::test]
+fn line_continuation_at_word_start_yields_no_word(tc: TestCase) {
+    let text = tc.draw(continuation_text());
+    let ours = bytes::split(&text);
+    let theirs = bash_words(&text);
+    assert_eq!(
+        ours,
+        theirs,
+        "text {:?}: crate {} bash {}",
+        String::from_utf8_lossy(&text),
+        show(&ours),
+        show(&theirs)
+    );
+}
+
+// ---------------------------------------------------------------- properties: quoting
+
+/// `try_join` produces a line that bash, dash, busybox ash, Python `shlex` and the crate's own
+/// parser all split back into exactly the words; `try_quote` is the per-word piece of it.
+#[hegel::test]
+fn quoting_round_trips_through_every_shell(tc: TestCase) {
+    let words = tc.draw(words(4));
+    let line = bytes::try_join(words.iter().map(|w| w.as_slice())).unwrap();
+    let pieces: Vec<Vec<u8>> = words
+        .iter()
+        .map(|w| bytes::try_quote(w).unwrap().into_owned())
+        .collect();
+    assert_eq!(
+        line,
+        pieces.join(&b' '),
+        "join is the quoted words separated by single spaces"
+    );
+    let expected = Some(words.clone());
+    let shown = String::from_utf8_lossy(&line).into_owned();
+    assert_eq!(bytes::split(&line), expected, "own parser on {:?}", shown);
+    let b = bash_words(&line);
+    assert_eq!(b, expected, "bash on {:?}: {}", shown, show(&b));
+    let d = sh_words(&["dash"], &line);
+    assert_eq!(d, expected, "dash on {:?}: {}", shown, show(&d));
+    let a = sh_words(&["busybox", "sh"], &line);
+    assert_eq!(a, expected, "busybox ash on {:?}: {}", shown, show(&a));
+    let p = python_split(&line);
+    assert_eq!(
+        p,
+        expected,
+        "python shlex.split on {:?}: {}",
+        shown,
+        show(&p)
+    );
+}
+
+/// The other direction of Python compatibility: what Python's `shlex.quote`/`shlex.join`
+/// produce, the crate splits back into the words.
+#[hegel::test]
+fn python_quoting_is_understood(tc: TestCase) {
+    let words = tc.draw(words(4));
+    let line = python_join(&words);
+    assert_eq!(
+        bytes::split(&line),
+        Some(words.clone()),
+        "shlex.join gave {:?}",
+        String::from_utf8_lossy(&line)
+    );
+    if let Some(w) = words.first() {
+        let q = python_quote(w);
+        assert_eq!(
+            bytes::split(&q),
+            Some(vec![w.clone()]),
+            "shlex.quote gave {:?}",
+            String::from_utf8_lossy(&q)
+        );
+    }
+}
+
+/// Contracts of the quoting API: nul bytes are refused unless allowed, the `str` and `bytes`
+/// front ends agree, valid UTF-8 in gives valid UTF-8 out, `Quoter::new()` is the default.
+#[hegel::test]
+fn quoting_contracts(tc: TestCase) {
+    let (word, with_nul) = tc.draw(word_maybe_nul());
+    let quoted = bytes::try_quote(&word);
+    let joined = bytes::try_join([word.as_slice(), b"x"]);
+    if with_nul {
+        assert_eq!(quoted, Err(QuoteError::Nul));
+        assert_eq!(joined, Err(QuoteError::Nul));
+        let allowed = bytes::Quoter::new().allow_nul(true).quote(&word).unwrap();
+        assert_eq!(
+            bytes::split(&allowed),
+            Some(vec![word.clone()]),
+            "nul bytes pass through as-is"
+        );
+    } else {
+        let quoted = quoted.unwrap();
+        let joined = joined.unwrap();
+        assert_eq!(quoted, bytes::Quoter::new().quote(&word).unwrap());
+        assert_eq!(joined, [quoted.to_vec(), b"x".to_vec()].join(&b' '));
+        if let Ok(s) = std::str::from_utf8(&word) {
+            let sq = try_quote(s).unwrap();
+            assert_eq!(sq.as_bytes(), &quoted[..]);
+            assert_eq!(Quoter::new().quote(s).unwrap(), sq);
+            assert_eq!(try_join([s, "x"]).unwrap().as_bytes(), &joined[..]);
+            assert!(std::str::from_utf8(&quoted).is_ok());
+        }
+    }
+}
+
+// ---------------------------------------------------------------- the documentation
+
+#[test]
+fn doc_examples() {
+    assert_eq!(split("foo$baz"), Some(vec!["foo$baz".to_string()]));
+    assert_eq!(
+        split("foo \"bar\"baz"),
+        Some(vec!["foo".to_string(), "barbaz".to_string()])
+    );
+    assert_eq!(
+        split("foo #bar\nbaz"),
+        Some(vec!["foo".to_string(), "baz".to_string()])
+    );
+    assert_eq!(split("'\\n'"), Some(vec!["\\n".to_string()]));
+    assert_eq!(split("'"), None);
+    assert_eq!(try_quote("foo bar").unwrap(), "'foo bar'");
+    assert_eq!(try_quote("\"^").unwrap(), "'\"''^'");
+    assert_eq!(try_quote("").unwrap(), "''");
+    assert_eq!(bytes::try_quote(b"a\x80b c").unwrap(), &b"'a\x80b c'"[..]);
+    assert_eq!(try_join(vec!["\0"]), Err(QuoteError::Nul));
+    assert_eq!(
+        QuoteError::Nul.to_string(),
+        "cannot shell-quote string containing nul byte"
+    );
+    let mut sh = Shlex::new("\nfoo\nbar");
+    while let Some(word) = sh.next() {
+        if word == "bar" {
+            assert_eq!(sh.line_no, 3);
+        }
+    }
+}
