+/// Property-based round-trip and transitivity tests for the crate's core
+/// conversions, using hegel.
+mod hegel_properties {
+    use approx::assert_relative_eq;
+
+    use hegel::generators;
+    use hegel::Generator;
+    use palette::convert::{FromColorUnclamped, IntoColorUnclamped};
+    use palette::white_point::D65;
+    use palette::{Hsl, Hsv, Lab, Srgb, Xyz, Yxy};
+
+    /// An in-gamut sRGB component in `[0.0, 1.0]`, boosted towards the
+    /// near-black and near-white extremes where transfer-function and
+    /// min/max-selection edge cases live.
+    #[hegel::composite]
+    fn srgb_component(tc: &hegel::TestCase) -> f64 {
+        tc.draw(hegel::one_of!(
+            generators::floats::<f64>().min_value(0.0).max_value(1.0),
+            generators::floats::<f64>().min_value(0.0).max_value(1e-6),
+            generators::floats::<f64>()
+                .min_value(1.0 - 1e-6)
+                .max_value(1.0),
+            generators::just(0.0),
+            generators::just(1.0),
+        ))
+    }
+
+    /// An in-gamut sRGB color, including exact black, exact white and
+    /// achromatic (all components equal) colors.
+    #[hegel::composite]
+    fn srgb_color(tc: &hegel::TestCase) -> Srgb<f64> {
+        let red = tc.draw(srgb_component());
+        // Draw achromatic colors ~1/8th of the time; greys are the
+        // degenerate case for hue-based spaces (hue and saturation collapse).
+        if tc.draw(generators::integers::<u8>().max_value(7)) == 0 {
+            Srgb::new(red, red, red)
+        } else {
+            let green = tc.draw(srgb_component());
+            let blue = tc.draw(srgb_component());
+            Srgb::new(red, green, blue)
+        }
+    }
+
+    /// Round-trip: Srgb -> Xyz -> Srgb returns the original color.
+    ///
+    /// Exercises the sRGB transfer function and the RGB<->XYZ matrices in
+    /// both directions. The tolerance is absolute on components in [0, 1].
+    /// It is bounded by the crate's baked-in conversion matrices, not by
+    /// f64 arithmetic: `Srgb::rgb_to_xyz_matrix`/`xyz_to_rgb_matrix` are
+    /// 7-decimal-digit constants (from Bruce Lindbloom's tables) that are
+    /// not exact inverses of each other, leaving a ~1e-7 residual in linear
+    /// space even for white (1, 1, 1). Near black, the transfer function's
+    /// linear segment multiplies that residual by 12.92 (observed: red
+    /// comes back as ~1.17e-6 for input (0, 1, 1)), hence 5e-6.
+    #[hegel::test]
+    fn srgb_xyz_srgb_roundtrip(tc: hegel::TestCase) {
+        let rgb = tc.draw((srgb_color()).print_as_debug());
+        let xyz: Xyz<D65, f64> = rgb.into_color_unclamped();
+        let back: Srgb<f64> = xyz.into_color_unclamped();
+        assert_relative_eq!(rgb, back, epsilon = 5e-6);
+    }
+
+    /// Round-trip: Srgb -> Lab -> Srgb returns the original color.
+    ///
+    /// Goes through XYZ and the CIE L*a*b* cube-root/linear-segment
+    /// functions in both directions. The tolerance is dominated by the same
+    /// 7-digit matrix constants and near-black 12.92x amplification as in
+    /// `srgb_xyz_srgb_roundtrip`.
+    #[hegel::test]
+    fn srgb_lab_srgb_roundtrip(tc: hegel::TestCase) {
+        let rgb = tc.draw((srgb_color()).print_as_debug());
+        let lab: Lab<D65, f64> = rgb.into_color_unclamped();
+        let back: Srgb<f64> = lab.into_color_unclamped();
+        assert_relative_eq!(rgb, back, epsilon = 5e-6);
+    }
+
+    /// Round-trip: Srgb -> Hsl -> Srgb returns the original color.
+    ///
+    /// Pure rational arithmetic in f64, so the tolerance can be tight.
+    /// Greys (drawn explicitly by the generator) exercise the max == min
+    /// branch where hue and saturation are defined as zero.
+    ///
+    /// Colors where the HSL saturation overflows to infinity are excluded;
+    /// that bug is pinned by `srgb_hsl_srgb_roundtrip_nan_known_failure`.
+    #[hegel::test]
+    fn srgb_hsl_srgb_roundtrip(tc: hegel::TestCase) {
+        let rgb = tc.draw((srgb_color()).print_as_debug());
+        let hsl: Hsl<_, f64> = rgb.into_color_unclamped();
+        if hsl.saturation.is_finite() {
+            let back: Srgb<f64> = hsl.into_color_unclamped();
+            assert_relative_eq!(rgb, back, epsilon = 1e-9);
+        }
+    }
+
+    /// KNOWN FAILURE: an in-gamut sRGB color a rounding error away from
+    /// white round-trips through HSL to NaN.
+    ///
+    /// In `Hsl: FromColorUnclamped<Rgb>`, light colors compute saturation
+    /// as `d / (2 - sum)` where `sum = max + min` has already been rounded;
+    /// for e.g. rgb(1.0, 1.0, 0.9999999999999999), `sum` rounds to exactly
+    /// 2.0, so saturation becomes `1.1e-16 / 0.0 = +inf` while lightness is
+    /// 1.0. Converting back multiplies `0 * inf = NaN`, poisoning every
+    /// component. The clamping `FromColor` path absorbs the infinity, but
+    /// the unclamped round-trip of a valid in-gamut color produces NaN.
+    /// Every input drawn here reproduces the failure deterministically.
+    #[hegel::test]
+    fn srgb_hsl_srgb_roundtrip_nan_known_failure(tc: hegel::TestCase) {
+        let below_one = 0.9999999999999999_f64;
+        let rgb = tc.draw((generators::sampled_from(vec![
+            Srgb::new(1.0, 1.0, below_one),
+            Srgb::new(1.0, below_one, 1.0),
+            Srgb::new(below_one, 1.0, 1.0),
+        ])).print_as_debug());
+        let hsl: Hsl<_, f64> = rgb.into_color_unclamped();
+        let back: Srgb<f64> = hsl.into_color_unclamped();
+        assert_relative_eq!(rgb, back, epsilon = 1e-9);
+    }
+
+    /// Transitivity: converting Srgb -> Hsv directly agrees with converting
+    /// via Hsl (Srgb -> Hsl -> Hsv).
+    ///
+    /// `Hsv: FromColorUnclamped<Rgb>` and `Hsv: FromColorUnclamped<Hsl>`
+    /// are independent implementations, so this checks two genuinely
+    /// different code paths against each other. Hue is compared as an
+    /// angular difference to avoid false failures at the 0/360 wrap.
+    #[hegel::test]
+    fn hsv_direct_vs_via_hsl(tc: hegel::TestCase) {
+        let rgb = tc.draw((srgb_color()).print_as_debug());
+        let direct = Hsv::from_color_unclamped(rgb);
+        let hsl = Hsl::from_color_unclamped(rgb);
+        // Near-white colors can overflow HSL saturation to infinity; that
+        // bug is pinned by `srgb_hsl_srgb_roundtrip_nan_known_failure`, so
+        // it is excluded here to keep testing everything else.
+        tc.assume(hsl.saturation.is_finite());
+        let via_hsl = Hsv::from_color_unclamped(hsl);
+
+        let hue_diff = (direct.hue - via_hsl.hue).into_degrees().abs();
+        assert!(
+            hue_diff <= 1e-9,
+            "hue differs: direct = {:?}, via hsl = {:?}",
+            direct,
+            via_hsl
+        );
+        // `Hsv: FromColorUnclamped<Hsl>` deliberately treats a subnormal
+        // value as an invalid divisor ("avoid divide by zero") and returns
+        // zero saturation, while the direct path computes `d / max` even
+        // for subnormal `max`. The paths only agree for colors of normal
+        // f64 magnitude, so subnormal-brightness colors (far below any
+        // physically meaningful intensity) skip the saturation comparison.
+        if direct.value >= f64::MIN_POSITIVE {
+            assert_relative_eq!(direct.saturation, via_hsl.saturation, epsilon = 1e-9);
+        }
+        assert_relative_eq!(direct.value, via_hsl.value, epsilon = 1e-9);
+    }
+
+    /// Round-trip: Xyz -> Yxy -> Xyz returns the original color.
+    ///
+    /// The chromaticity projection divides by x + y + z and multiplies back
+    /// out, so this checks that no information is lost while Y is nonzero.
+    #[hegel::test]
+    fn xyz_yxy_xyz_roundtrip(tc: hegel::TestCase) {
+        let x = tc.draw(generators::floats::<f64>().min_value(0.0).max_value(2.0));
+        // A zero Y legitimately collapses the chromaticity to (0, 0) (see the
+        // `FromColorUnclamped<Xyz> for Yxy` implementation), so Y is kept
+        // nonzero. The 1e-9 floor also keeps the division away from
+        // subnormals, protecting the test's own arithmetic rather than the
+        // library's contract.
+        let y = tc.draw(generators::floats::<f64>().min_value(1e-9).max_value(2.0));
+        let z = tc.draw(generators::floats::<f64>().min_value(0.0).max_value(2.0));
+        let xyz = Xyz::<D65, f64>::new(x, y, z);
+
+        let yxy: Yxy<D65, f64> = xyz.into_color_unclamped();
+        let back: Xyz<D65, f64> = yxy.into_color_unclamped();
+        assert_relative_eq!(xyz, back, epsilon = 1e-9, max_relative = 1e-9);
+    }
+}
