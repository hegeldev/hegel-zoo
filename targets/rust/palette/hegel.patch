+        /// Mix endpoints: `mix(a, b, 0.0) == a` and `mix(a, b, 1.0) == b`,
+        /// as documented on the `Mix` trait. Factor 0.0 is exact in float
+        /// arithmetic; factor 1.0 has one rounding step (`a + (b - a)`),
+        /// hence the 1e-9 absolute tolerance on components up to +/-128.
+        #[hegel::test]
+        fn mix_endpoints(tc: hegel::TestCase) {
+            let a = lab_color(&tc);
