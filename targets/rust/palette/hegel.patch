+/// Round-trip: Lab -> Lch -> Lab returns the original color.
+///
+/// The rectangular-to-polar conversion is hypot + atan2, and back is
+/// cos/sin, so the tolerance is absolute on components up to +/-128.
+#[hegel::test]
+fn lab_lch_lab_roundtrip(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    // Documented component ranges: l in [0, 100], a and b in [-128, 127].
+    let l = tc.draw(generators::floats::<f64>().min_value(0.0).max_value(100.0));
+    let a = tc.draw(
+        generators::floats::<f64>()
+            .min_value(-128.0)
+            .max_value(127.0),
+    );
+    let b = tc.draw(
+        generators::floats::<f64>()
+            .min_value(-128.0)
+            .max_value(127.0),
+    );
+    let lab = Lab::<D65, f64>::new(l, a, b);
+
+    let lch: Lch<D65, f64> = lab.into_color_unclamped();
+    let back: Lab<D65, f64> = lch.into_color_unclamped();
+    assert_relative_eq!(lab, back, epsilon = 1e-9);
+}
+
+/// Round-trip: Lch -> Lab -> Lch returns the original color.
+///
+/// Hue is only checked away from zero chroma: at chroma == 0 the hue is
+/// mathematically undefined (Lab's `get_hue` of a == b == 0 returns 0
+/// regardless of the input hue), so only l and chroma survive there.
+#[hegel::test]
+fn lch_lab_lch_roundtrip(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    // Documented ranges: l in [0, 100], chroma in [0, 128] with an
+    // "extended" maximum of sqrt(128^2 + 128^2) ~= 181 covering the whole
+    // space. Hue is any angle; values beyond one turn test normalization.
+    let l = tc.draw(generators::floats::<f64>().min_value(0.0).max_value(100.0));
+    let chroma = tc.draw(
+        generators::floats::<f64>()
+            .min_value(0.0)
+            .max_value(181.019335983756),
+    );
+    let hue_deg = tc.draw(
+        generators::floats::<f64>()
+            .min_value(-720.0)
+            .max_value(720.0),
+    );
+    let lch = Lch::<D65, f64>::new(l, chroma, hue_deg);
+
+    let lab: Lab<D65, f64> = lch.into_color_unclamped();
+    let back: Lch<D65, f64> = lab.into_color_unclamped();
+
+    assert_relative_eq!(back.l, lch.l, epsilon = 1e-9);
+    assert_relative_eq!(back.chroma, lch.chroma, epsilon = 1e-9, max_relative = 1e-9);
+    if lch.chroma > 1e-6 {
+        let hue_diff = (back.hue - lch.hue).into_degrees().abs();
+        assert!(
+            hue_diff <= 1e-9,
+            "hue not preserved: {:?} -> {:?}",
+            lch,
+            back
+        );
+    }
+}
