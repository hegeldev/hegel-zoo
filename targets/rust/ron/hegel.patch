+
+mod hegel_props {
+    use hegel::generators;
+    use ron::{de::from_str, ser::to_string};
+
+    /// Draw from the full range with the type's boundary values boosted,
+    /// since uniform draws rarely land exactly on MIN/MAX/0.
+    macro_rules! draw_boosted_int {
+        ($tc:expr, $ty:ty) => {
+            $tc.draw(hegel::one_of!(
+                generators::integers::<$ty>(),
+                generators::sampled_from(vec![<$ty>::MIN, <$ty>::MAX, 0, 1]),
+            ))
+        };
+    }
+
+    /// Typed integer roundtrip over every integer width, including MIN/MAX.
+    #[hegel::test]
+    fn prop_integer_roundtrip(tc: hegel::TestCase) {
+        macro_rules! check {
+            ($ty:ty) => {{
+                let x: $ty = draw_boosted_int!(tc, $ty);
+                let s = to_string(&x).unwrap();
+                assert_eq!(
+                    from_str::<$ty>(&s),
+                    Ok(x),
+                    concat!(stringify!($ty), " {} did not roundtrip via {:?}"),
+                    x,
+                    s
+                );
+            }};
+        }
+        check!(i8);
+        check!(i16);
+        check!(i32);
+        check!(i64);
+        check!(u8);
+        check!(u16);
+        check!(u32);
+        check!(u64);
+    }
+
+    fn draw_boundary_f64(tc: &hegel::TestCase) -> f64 {
+        tc.draw(hegel::one_of!(
+            generators::floats::<f64>(),
+            generators::sampled_from(vec![
+                f64::MIN,
+                f64::MAX,
+                f64::MIN_POSITIVE,
+                f64::EPSILON,
+                5e-324,           // smallest subnormal
+                2.225_073_858_507_201e-308, // largest subnormal
+                f64::INFINITY,
+                f64::NEG_INFINITY,
+                f64::NAN,
+                -f64::NAN,
+                0.0,
+                -0.0,
+                9_007_199_254_740_993.0, // 2^53 + 1 rounding boundary
+            ]),
+        ))
+    }
+
+    /// Typed f64 roundtrip: bit-exact for every value except NaN, where the
+    /// text form (`NaN`/`-NaN`) only preserves NaN-ness and the sign.
+    #[hegel::test]
+    fn prop_f64_roundtrip(tc: hegel::TestCase) {
+        let x = draw_boundary_f64(&tc);
+
+        let s = to_string(&x).unwrap();
+        let back: f64 = from_str(&s).unwrap_or_else(|e| panic!("failed to parse {s:?}: {e}"));
+
+        if x.is_nan() {
+            assert!(back.is_nan(), "NaN roundtripped to {back} via {s:?}");
+            assert_eq!(
+                back.is_sign_negative(),
+                x.is_sign_negative(),
+                "NaN sign lost via {s:?}"
+            );
+        } else {
+            assert_eq!(
+                back.to_bits(),
+                x.to_bits(),
+                "f64 {x:?} did not roundtrip via {s:?} (got {back:?})"
+            );
+        }
+    }
+
+    /// Typed f32 roundtrip, same contract as for f64.
+    #[hegel::test]
+    fn prop_f32_roundtrip(tc: hegel::TestCase) {
+        let x: f32 = tc.draw(hegel::one_of!(
+            generators::floats::<f32>(),
+            generators::sampled_from(vec![
+                f32::MIN,
+                f32::MAX,
+                f32::MIN_POSITIVE,
+                1e-45,  // smallest subnormal
+                f32::INFINITY,
+                f32::NEG_INFINITY,
+                f32::NAN,
+                -f32::NAN,
+                0.0,
+                -0.0,
+            ]),
+        ));
+
+        let s = to_string(&x).unwrap();
+        let back: f32 = from_str(&s).unwrap_or_else(|e| panic!("failed to parse {s:?}: {e}"));
+
+        if x.is_nan() {
+            assert!(back.is_nan(), "NaN roundtripped to {back} via {s:?}");
+            assert_eq!(
+                back.is_sign_negative(),
+                x.is_sign_negative(),
+                "NaN sign lost via {s:?}"
+            );
+        } else {
+            assert_eq!(
+                back.to_bits(),
+                x.to_bits(),
+                "f32 {x:?} did not roundtrip via {s:?} (got {back:?})"
+            );
+        }
+    }
+
+    /// The untyped parser must preserve the integer-vs-float distinction and
+    /// the numeric value of serialized integers.
+    #[hegel::test]
+    fn prop_untyped_integer_value_preserved(tc: hegel::TestCase) {
+        let x: i128 = i128::from(draw_boosted_int!(tc, i64));
+        let x = if tc.draw(generators::booleans()) {
+            i128::from(draw_boosted_int!(tc, u64))
+        } else {
+            x
+        };
+
+        let s = x.to_string();
+        let v: ron::Value = from_str(&s).unwrap();
+        let ron::Value::Number(n) = v else {
+            panic!("integer text {s:?} parsed as non-number {v:?}");
+        };
+
+        let back: i128 = match n {
+            ron::value::Number::I8(v) => v.into(),
+            ron::value::Number::I16(v) => v.into(),
+            ron::value::Number::I32(v) => v.into(),
+            ron::value::Number::I64(v) => v.into(),
+            ron::value::Number::U8(v) => v.into(),
+            ron::value::Number::U16(v) => v.into(),
+            ron::value::Number::U32(v) => v.into(),
+            ron::value::Number::U64(v) => v.into(),
+            other => panic!("integer text {s:?} parsed as float {other:?}"),
+        };
+        assert_eq!(back, x, "integer text {s:?} changed value");
+    }
+}
diff --git a/tests/value.rs b/tests/value.rs
index 11efeba..ed41fb4 100644
--- a/tests/value.rs
+++ b/tests/value.rs
@@ -226,3 +226,433 @@ fn map_roundtrip_338() {
 
     assert_eq!(v, roundtrip);
 }
+
+mod hegel_props {
+    use hegel::generators::{self, Generator};
+    use ron::value::{Map, Number, Value};
+
+    /// A canonical, type-erased form of a [`Value`] used to compare a value
+    /// before serialization with the value parsed back from its RON text.
+    ///
+    /// RON's untyped parser normalizes numbers to the "smallest" fitting
+    /// representation (`"42"` parses as `Number::U8`, and a float that is
+    /// exactly representable as `f32` parses as `Number::F32`, see
+    /// `ParsedFloat` selection in `src/parse.rs`), so `Value` equality on the
+    /// `Number` *variant* is not preserved by a serialize/parse roundtrip.
+    /// The numeric *value* and int-vs-float distinction must be preserved,
+    /// which is what this canonicalization compares. Serializing an `f64` NaN
+    /// only preserves NaN-ness and the sign (payload bits are not written),
+    /// so NaN canonicalizes to a sign-tagged marker.
+    #[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
+    enum Canon {
+        Bool(bool),
+        Char(char),
+        Int(i128),
+        Float(u64),
+        Nan(bool),
+        String(String),
+        Bytes(Vec<u8>),
+        Option(Option<Box<Canon>>),
+        Seq(Vec<Canon>),
+        Map(Vec<(Canon, Canon)>),
+        Unit,
+    }
+
+    fn canon_float(f: f64) -> Canon {
+        if f.is_nan() {
+            Canon::Nan(f.is_sign_negative())
+        } else {
+            Canon::Float(f.to_bits())
+        }
+    }
+
+    fn canon_number(n: &Number) -> Canon {
+        match *n {
+            Number::I8(v) => Canon::Int(i128::from(v)),
+            Number::I16(v) => Canon::Int(i128::from(v)),
+            Number::I32(v) => Canon::Int(i128::from(v)),
+            Number::I64(v) => Canon::Int(i128::from(v)),
+            Number::U8(v) => Canon::Int(i128::from(v)),
+            Number::U16(v) => Canon::Int(i128::from(v)),
+            Number::U32(v) => Canon::Int(i128::from(v)),
+            Number::U64(v) => Canon::Int(i128::from(v)),
+            // f32 -> f64 conversion is exact, so this canonicalization is
+            // lossless in both directions
+            Number::F32(v) => canon_float(f64::from(v.get())),
+            Number::F64(v) => canon_float(v.get()),
+            _ => panic!("unexpected Number variant"),
+        }
+    }
+
+    fn canon(v: &Value) -> Canon {
+        match v {
+            Value::Bool(b) => Canon::Bool(*b),
+            Value::Char(c) => Canon::Char(*c),
+            Value::Number(n) => canon_number(n),
+            Value::String(s) => Canon::String(s.clone()),
+            Value::Bytes(b) => Canon::Bytes(b.clone()),
+            Value::Option(o) => Canon::Option(o.as_ref().map(|v| Box::new(canon(v)))),
+            Value::Seq(s) => Canon::Seq(s.iter().map(canon).collect()),
+            Value::Map(m) => {
+                let mut entries: Vec<(Canon, Canon)> =
+                    m.iter().map(|(k, v)| (canon(k), canon(v))).collect();
+                // Value's Ord depends on the Number variant, so maps whose
+                // keys are numerically equal but differently typed would sort
+                // differently before and after a roundtrip; compare as a
+                // canonically sorted entry list instead.
+                entries.sort();
+                Canon::Map(entries)
+            }
+            Value::Unit => Canon::Unit,
+        }
+    }
+
+    fn draw_char(tc: &hegel::TestCase) -> char {
+        tc.draw(hegel::one_of!(
+            // boundary characters: quotes, escapes, controls, unicode
+            // whitespace/line separators, BOM, max codepoint
+            generators::sampled_from(vec![
+                '"', '\'', '\\', '\n', '\r', '\t', '\0', '\x07', '\x1b', '\x1f', '\x7f',
+                '\u{80}', '\u{85}', '\u{a0}', '\u{200e}', '\u{2028}', '\u{2029}', '\u{301}',
+                '\u{feff}', '\u{fffd}', '\u{10ffff}', '#', '/', '*', ' ',
+            ]),
+            generators::integers::<u32>()
+                .max_value(0x10_FFFF)
+                .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+        ))
+    }
+
+    fn draw_string(tc: &hegel::TestCase) -> String {
+        let n = tc.draw(generators::integers::<usize>().max_value(8));
+        (0..n).map(|_| draw_char(tc)).collect()
+    }
+
+    fn draw_number(tc: &hegel::TestCase) -> Number {
+        match tc.draw(generators::integers::<u8>().max_value(5)) {
+            0 => Number::new(tc.draw(generators::integers::<i64>())),
+            1 => Number::new(tc.draw(generators::integers::<u64>())),
+            2 => Number::new(tc.draw(generators::integers::<i8>())),
+            3 => Number::new(tc.draw(generators::integers::<u32>())),
+            4 => {
+                let x = tc.draw(generators::floats::<f32>());
+                // KNOWN BUG (see `known_bug_untyped_f32_value_roundtrip_changes_value`
+                // and `known_bug_f32_exact_f64_roundtrip_not_stable`): floats
+                // in this region do not survive an untyped roundtrip; exclude
+                // them here so this sibling generator keeps testing
+                // everything else.
+                tc.assume(f32_survives_untyped_roundtrip(x));
+                Number::new(x)
+            }
+            _ => {
+                let x = tc.draw(generators::floats::<f64>());
+                // KNOWN BUG: see the f32 branch above.
+                tc.assume(f64_untyped_roundtrip_is_stable(x));
+                Number::new(x)
+            }
+        }
+    }
+
+    /// Returns whether an `F64` value reaches a roundtrip fixpoint: the
+    /// untyped parser downgrades an exactly-`f32`-representable `f64` to
+    /// `F32`, whose subsequent serialization must re-read as the same `f64`.
+    fn f64_untyped_roundtrip_is_stable(x: f64) -> bool {
+        if x.is_nan() {
+            return true;
+        }
+        #[allow(clippy::cast_possible_truncation)]
+        let as_f32 = x as f32;
+        if f64::from(as_f32).total_cmp(&x).is_eq() {
+            f32_survives_untyped_roundtrip(as_f32)
+        } else {
+            true
+        }
+    }
+
+    /// Returns whether serializing `x` (as the shortest `f32` decimal form)
+    /// and re-reading that text as an `f64` — which is what the untyped
+    /// `Value` parser does — yields exactly `f64::from(x)`.
+    fn f32_survives_untyped_roundtrip(x: f32) -> bool {
+        if x.is_nan() || x.is_infinite() {
+            return true;
+        }
+        format!("{x}")
+            .parse::<f64>()
+            .map(|reparsed| reparsed.total_cmp(&f64::from(x)).is_eq())
+            .unwrap_or(false)
+    }
+
+    /// KNOWN FAILURE: pins a real roundtrip infidelity for untyped values.
+    ///
+    /// `Value::Number(Number::F32(0.1))` serializes as `"0.1"` (the shortest
+    /// decimal form that roundtrips *as `f32`*, from `f32`'s `Display`), but
+    /// the untyped `Value` parser reads the text back as `f64` and only
+    /// downgrades to `F32` when the `f64` is exactly `f32`-representable
+    /// (`src/parse.rs`, `ParsedFloat` selection). `0.1_f64` is not exactly
+    /// `f32`-representable, so the value comes back as
+    /// `F64(0.1000000000000000055...)`, while the original number was
+    /// `f64::from(0.1_f32) = 0.100000001490116...` — the numeric value
+    /// itself drifts, not just the type. Typed roundtrips
+    /// (`from_str::<f32>`) are unaffected. A fix would be to serialize `F32`
+    /// inside a `Value` using its exact `f64` value, which the parser would
+    /// then downgrade back to `F32` losslessly.
+    #[test]
+    fn known_bug_untyped_f32_value_roundtrip_changes_value() {
+        let v = Value::Number(Number::F32(0.1_f32.into()));
+
+        let s = ron::to_string(&v).unwrap();
+        assert_eq!(s, "0.1");
+
+        let v2: Value = ron::from_str(&s).unwrap();
+        let Value::Number(n) = v2 else {
+            panic!("expected a number, got {v2:?}");
+        };
+
+        assert!(
+            n.into_f64().total_cmp(&f64::from(0.1_f32)).is_eq(),
+            "untyped Value roundtrip changed the numeric value: \
+             {} != {}",
+            n.into_f64(),
+            f64::from(0.1_f32),
+        );
+    }
+
+    /// KNOWN FAILURE: pins the same serializer infidelity as
+    /// `known_bug_untyped_f32_value_roundtrip_changes_value`, but reachable
+    /// purely through ron's own parser — no user-constructed `F32` involved.
+    ///
+    /// `"33644952.0"` parses to `F32(33644952.0)` (the value is exactly
+    /// `f32`-representable, so the untyped parser downgrades it). `f32`'s
+    /// `Display` then prints the *shortest* decimal that rounds back to that
+    /// `f32`, which is `"33644950"` — so re-serializing yields
+    /// `"33644950.0"`, which re-parses as `F64(33644950.0)`: the numeric
+    /// value drifted by 2.0 across a parse → serialize → parse cycle, and
+    /// `from_str(to_string(from_str(s))) != from_str(s)`.
+    #[test]
+    fn known_bug_f32_exact_f64_roundtrip_not_stable() {
+        let v: Value = ron::from_str("33644952.0").unwrap();
+        assert_eq!(v, Value::Number(Number::F32(33_644_952.0_f32.into())));
+
+        let s = ron::to_string(&v).unwrap();
+        let v2: Value = ron::from_str(&s).unwrap();
+
+        assert_eq!(
+            v2,
+            v,
+            "parse -> serialize -> parse drifted from 33644952.0 via {s:?}"
+        );
+    }
+
+    /// Recursive generator for arbitrary RON [`Value`] trees, bounded to
+    /// `depth` levels of nesting (well below the default recursion limit of
+    /// 128, so serialization never legitimately fails).
+    pub(crate) fn arbitrary_value(depth: u32) -> generators::BoxedGenerator<'static, Value> {
+        hegel::compose!(|tc| {
+            let max_choice = if depth == 0 { 6 } else { 9 };
+            match tc.draw(generators::integers::<u8>().max_value(max_choice)) {
+                0 => Value::Bool(tc.draw(generators::booleans())),
+                1 => Value::Char(draw_char(&tc)),
+                2 => Value::Number(draw_number(&tc)),
+                3 => Value::String(draw_string(&tc)),
+                4 => Value::Bytes(tc.draw(generators::binary().max_size(6))),
+                5 => Value::Unit,
+                6 => Value::Option(None),
+                7 => Value::Option(Some(Box::new(tc.draw((arbitrary_value(depth - 1)).print_as_debug())))),
+                8 => Value::Seq(tc.draw((generators::vecs(arbitrary_value(depth - 1)).max_size(4)).print_as_debug())),
+                _ => {
+                    let pairs: Vec<(Value, Value)> = tc.draw(
+                        (generators::vecs(generators::tuples!(
+                            arbitrary_value(depth - 1),
+                            arbitrary_value(depth - 1),
+                        ))
+                        .max_size(4)).print_as_debug(),
+                    );
+                    let mut map = Map::new();
+                    let mut seen: Vec<Canon> = Vec::new();
+                    for (k, v) in pairs {
+                        // Skip keys that are equal *after* parse
+                        // normalization (e.g. `U8(1)` and `I64(1)` both
+                        // serialize as `1`): duplicate keys in the RON text
+                        // would collapse into one entry when parsed back.
+                        let ck = canon(&k);
+                        if !seen.contains(&ck) {
+                            seen.push(ck);
+                            map.insert(k, v);
+                        }
+                    }
+                    Value::Map(map)
+                }
+            }
+        })
+        .boxed()
+    }
+
+    /// The crown roundtrip property: any `Value` serialized to RON text
+    /// parses back to the same value (modulo parse normalization of number
+    /// types), and the roundtrip reaches a fixpoint after one pass.
+    #[hegel::test]
+    fn prop_value_roundtrip_compact(tc: hegel::TestCase) {
+        let v = tc.draw((arbitrary_value(4)).print_as_debug());
+
+        let s = ron::to_string(&v).unwrap();
+        let v2: Value = ron::from_str(&s)
+            .unwrap_or_else(|e| panic!("failed to re-parse {s:?}: {e}"));
+
+        assert_eq!(canon(&v), canon(&v2), "roundtrip changed the value of {s:?}");
+
+        // After one parse the value is fully normalized: the second roundtrip
+        // must be exactly the identity.
+        let s2 = ron::to_string(&v2).unwrap();
+        let v3: Value = ron::from_str(&s2)
+            .unwrap_or_else(|e| panic!("failed to re-parse {s2:?}: {e}"));
+        assert_eq!(v2, v3, "second roundtrip via {s2:?} was not the identity");
+    }
+
+    fn draw_pretty_config(tc: &hegel::TestCase) -> ron::ser::PrettyConfig {
+        let depth_limit = tc.draw(hegel::one_of!(
+            generators::just(usize::MAX),
+            generators::integers::<usize>().max_value(6),
+        ));
+        ron::ser::PrettyConfig::new()
+            .depth_limit(depth_limit)
+            .new_line(tc.draw(generators::sampled_from(vec!["\n", "\r\n", "\r"])))
+            .indentor(tc.draw(generators::sampled_from(vec![
+                "    ", "\t", " ", "", "\u{b}\u{c}",
+            ])))
+            .separator(tc.draw(generators::sampled_from(vec![" ", "", "\t", "\u{85}"])))
+            .struct_names(tc.draw(generators::booleans()))
+            .separate_tuple_members(tc.draw(generators::booleans()))
+            .enumerate_arrays(tc.draw(generators::booleans()))
+            .compact_arrays(tc.draw(generators::booleans()))
+            .escape_strings(tc.draw(generators::booleans()))
+            .compact_structs(tc.draw(generators::booleans()))
+            .compact_maps(tc.draw(generators::booleans()))
+            .number_suffixes(tc.draw(generators::booleans()))
+            .compact_ranges(tc.draw(generators::booleans()))
+    }
+
+    /// Pretty and compact serialization of the same `Value` must parse back
+    /// to the same value, for arbitrary `PrettyConfig` layout settings.
+    /// (Compared canonically: `number_suffixes` legitimately preserves the
+    /// original number type where compact serialization does not.)
+    #[hegel::test]
+    fn prop_pretty_and_compact_parse_to_same_value(tc: hegel::TestCase) {
+        let v = tc.draw((arbitrary_value(4)).print_as_debug());
+        let config = draw_pretty_config(&tc);
+
+        let compact = ron::to_string(&v).unwrap();
+        let v_compact: Value = ron::from_str(&compact)
+            .unwrap_or_else(|e| panic!("failed to re-parse {compact:?}: {e}"));
+
+        let pretty = ron::ser::to_string_pretty(&v, config.clone()).unwrap();
+        let v_pretty: Value = ron::from_str(&pretty)
+            .unwrap_or_else(|e| panic!("failed to re-parse (config {config:?}) {pretty:?}: {e}"));
+
+        assert_eq!(
+            canon(&v_compact),
+            canon(&v_pretty),
+            "pretty {pretty:?} and compact {compact:?} disagree"
+        );
+    }
+
+    /// Draw a run of inter-token whitespace and comments. Every element of
+    /// this vocabulary is skippable per `docs/grammar.md` (`ws` includes
+    /// nested block comments and line comments).
+    fn draw_soup_sep(tc: &hegel::TestCase) -> String {
+        let n = tc.draw(generators::integers::<usize>().max_value(2));
+        let mut sep = String::new();
+        for _ in 0..n {
+            sep.push_str(tc.draw(generators::sampled_from(vec![
+                " ",
+                "\t",
+                "\n",
+                "\r\n",
+                "\u{b}",
+                "\u{c}",
+                "\u{85}",
+                "\u{200e}",
+                "\u{200f}",
+                "\u{2028}",
+                "\u{2029}",
+                "// line comment\n",
+                "/* block */",
+                "/* nested /* block // */ */",
+            ])));
+        }
+        sep
+    }
+
+    /// Emit `v` as RON text with random whitespace/comments between all
+    /// tokens and randomly drawn optional trailing commas.
+    fn emit_soupy(v: &Value, tc: &hegel::TestCase, out: &mut String) {
+        match v {
+            Value::Bool(_) | Value::Char(_) | Value::Number(_) | Value::String(_)
+            | Value::Bytes(_) | Value::Unit => {
+                out.push_str(&ron::to_string(v).unwrap());
+            }
+            Value::Option(None) => out.push_str("None"),
+            Value::Option(Some(inner)) => {
+                out.push_str("Some");
+                out.push_str(&draw_soup_sep(tc));
+                out.push('(');
+                out.push_str(&draw_soup_sep(tc));
+                emit_soupy(inner, tc, out);
+                out.push_str(&draw_soup_sep(tc));
+                if tc.draw(generators::booleans()) {
+                    out.push(',');
+                    out.push_str(&draw_soup_sep(tc));
+                }
+                out.push(')');
+            }
+            Value::Seq(items) => {
+                out.push('[');
+                out.push_str(&draw_soup_sep(tc));
+                for (i, item) in items.iter().enumerate() {
+                    emit_soupy(item, tc, out);
+                    out.push_str(&draw_soup_sep(tc));
+                    if i + 1 < items.len() || tc.draw(generators::booleans()) {
+                        out.push(',');
+                        out.push_str(&draw_soup_sep(tc));
+                    }
+                }
+                out.push(']');
+            }
+            Value::Map(map) => {
+                out.push('{');
+                out.push_str(&draw_soup_sep(tc));
+                let len = map.len();
+                for (i, (k, v)) in map.iter().enumerate() {
+                    emit_soupy(k, tc, out);
+                    out.push_str(&draw_soup_sep(tc));
+                    out.push(':');
+                    out.push_str(&draw_soup_sep(tc));
+                    emit_soupy(v, tc, out);
+                    out.push_str(&draw_soup_sep(tc));
+                    if i + 1 < len || tc.draw(generators::booleans()) {
+                        out.push(',');
+                        out.push_str(&draw_soup_sep(tc));
+                    }
+                }
+                out.push('}');
+            }
+        }
+    }
+
+    /// Whitespace and comment insensitivity: inserting arbitrary whitespace
+    /// and (nested) comments between tokens must not change the parse.
+    #[hegel::test]
+    fn prop_whitespace_and_comments_do_not_change_parse(tc: hegel::TestCase) {
+        let v = tc.draw((arbitrary_value(3)).print_as_debug());
+
+        let compact = ron::to_string(&v).unwrap();
+        let expected: Value = ron::from_str(&compact)
+            .unwrap_or_else(|e| panic!("failed to re-parse {compact:?}: {e}"));
+
+        let mut soup = draw_soup_sep(&tc);
+        emit_soupy(&v, &tc, &mut soup);
+        soup.push_str(&draw_soup_sep(&tc));
+
+        let parsed: Value = ron::from_str(&soup)
+            .unwrap_or_else(|e| panic!("failed to parse soup {soup:?}: {e}"));
+        assert_eq!(expected, parsed, "soup {soup:?} parsed differently");
+    }
+}
