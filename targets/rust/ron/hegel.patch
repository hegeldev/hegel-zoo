diff --git a/tests/307_stack_overflow.rs b/tests/307_stack_overflow.rs
index 13fd3d6..4554914 100644
--- a/tests/307_stack_overflow.rs
+++ b/tests/307_stack_overflow.rs
@@ -58,3 +58,106 @@ fn test_fuzz_4740606375362560() {
 
     assert_eq!(err.code, ron::Error::ExceededRecursionLimit)
 }
+
+mod hegel_props {
+    use hegel::generators;
+
+    /// The parser must never panic on arbitrary text — it either parses or
+    /// returns an error.
+    #[hegel::test]
+    fn prop_from_str_never_panics_on_arbitrary_text(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::text().max_size(200));
+        drop(ron::from_str::<ron::Value>(&s));
+    }
+
+    /// The parser must never panic on RON-shaped token soup: syntactically
+    /// suggestive fragments glued together in arbitrary order.
+    #[hegel::test]
+    fn prop_from_str_never_panics_on_ron_token_soup(tc: hegel::TestCase) {
+        let tokens: Vec<&str> = tc.draw(
+            generators::vecs(generators::sampled_from(vec![
+                "[", "]", "(", ")", "{", "}", ",", ":", "Some", "None", "true", "false", "\"",
+                "\\", "'", "r\"", "r#\"", "\"#", "#", "b\"", "br#\"", "0x", "0b", "0o", "1",
+                "-", "+", ".", "e", "E", "_", "0", "9", "inf", "NaN", "f32", "u8", "i64",
+                "//", "/*", "*/", "\n", " ", "\t", "A", "r#", "\u{2028}", "'\\", "\\u{", "}",
+            ]))
+            .max_size(48),
+        );
+        let s: String = tokens.concat();
+        drop(ron::from_str::<ron::Value>(&s));
+    }
+
+    /// Deeply nested input must be rejected gracefully via the recursion
+    /// limit (default 128, `ron::Options::recursion_limit`) — never a stack
+    /// overflow. Probes depths well past the limit and mixes nesting kinds.
+    #[hegel::test]
+    fn prop_deeply_nested_input_errors_gracefully(tc: hegel::TestCase) {
+        let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(5_000));
+        let (open, close) = tc.draw(generators::sampled_from(vec![
+            ("[", "]"),
+            ("(", ",)"),
+            ("Some(", ")"),
+            ("{0:", "}"),
+        ]));
+
+        let mut s = open.repeat(depth);
+        s.push('1');
+        s.push_str(&close.repeat(depth));
+
+        let result = ron::from_str::<ron::Value>(&s);
+        // The recursion guard consumes more than one frame per nesting level
+        // (e.g. seq -> value), so the exact depth at which the default limit
+        // of 128 trips is an implementation detail. Assert the contract at a
+        // safe distance on both sides: shallow nesting parses, deep nesting
+        // is rejected by the limit (never a stack overflow), and in between
+        // the only permitted error is the recursion limit.
+        if depth > 128 {
+            assert_eq!(
+                result.map(|_| ()).unwrap_err().code,
+                ron::Error::ExceededRecursionLimit,
+                "depth {depth} was not rejected by the recursion limit"
+            );
+        } else if depth <= 30 {
+            assert!(
+                result.is_ok(),
+                "depth {depth} (well below the limit) failed: {result:?}"
+            );
+        } else if let Err(err) = result {
+            assert_eq!(
+                err.code,
+                ron::Error::ExceededRecursionLimit,
+                "depth {depth} failed with an unexpected error"
+            );
+        }
+    }
+
+    /// The serializer's recursion guard is the mirror image: serializing a
+    /// `Value` nested past the limit must return
+    /// `Error::ExceededRecursionLimit`, and one nested within it must
+    /// succeed.
+    #[hegel::test]
+    fn prop_deeply_nested_value_serialization_errors_gracefully(tc: hegel::TestCase) {
+        // boost the exact limit boundary alongside the full range
+        let depth = tc.draw(hegel::one_of!(
+            generators::integers::<usize>().min_value(1).max_value(2_000),
+            generators::sampled_from(vec![127, 128, 129]),
+        ));
+        let seq = tc.draw(generators::booleans());
+
+        let mut v = ron::Value::Unit;
+        for _ in 0..depth {
+            v = if seq {
+                ron::Value::Seq(vec![v])
+            } else {
+                ron::Value::Option(Some(Box::new(v)))
+            };
+        }
+
+        let result = ron::to_string(&v);
+        if depth > 128 {
+            assert_eq!(result.unwrap_err(), ron::Error::ExceededRecursionLimit);
+        } else {
+            assert!(result.is_ok(), "depth {depth} failed: {result:?}");
+        }
+    }
+}
diff --git a/tests/escape.rs b/tests/escape.rs
index 967f345..a817856 100644
--- a/tests/escape.rs
+++ b/tests/escape.rs
@@ -166,3 +166,83 @@ fn test_string_continuation_errors() {
         ron::Error::ExpectedStringEnd
     );
 }
+
+mod hegel_props {
+    use hegel::generators::{self, Generator};
+    use ron::{de::from_str, ser::to_string};
+
+    /// Characters at the boundary of the serializer's escape set:
+    /// `serialize_escaped_str` escapes via `char::escape_debug` (quotes,
+    /// backslashes, controls, and non-printable/grapheme-extending unicode),
+    /// and `serialize_char` escapes only `'` and `\`. Bugs live just inside
+    /// and just outside those sets.
+    fn draw_boundary_char(tc: &hegel::TestCase) -> char {
+        tc.draw(hegel::one_of!(
+            generators::sampled_from(vec![
+                '"', '\'', '\\', '\n', '\r', '\t', '\0', '\x07', '\x08', '\x0b', '\x0c',
+                '\x1b', '\x1f', ' ', '\x7f', '\u{80}', '\u{85}', '\u{a0}', '\u{ad}',
+                '\u{200e}', '\u{2028}', '\u{2029}', '\u{301}', '\u{feff}', '\u{fffd}',
+                '\u{e000}', '\u{d7ff}', '\u{10ffff}', '#', '/', '*', 'r', 'b',
+            ]),
+            generators::integers::<u32>()
+                .max_value(0x10_FFFF)
+                .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+        ))
+    }
+
+    /// Strings built from escape-set-boundary characters must roundtrip
+    /// through escaped serialization.
+    #[hegel::test]
+    fn prop_string_escape_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(12));
+        let s: String = (0..n).map(|_| draw_boundary_char(&tc)).collect();
+
+        let ron = to_string(&s).unwrap();
+        assert_eq!(
+            from_str::<String>(&ron).as_ref(),
+            Ok(&s),
+            "string {s:?} did not roundtrip via {ron:?}"
+        );
+    }
+
+    /// Every char must roundtrip through char-literal serialization.
+    #[hegel::test]
+    fn prop_char_escape_roundtrip(tc: hegel::TestCase) {
+        let c = draw_boundary_char(&tc);
+
+        let ron = to_string(&c).unwrap();
+        assert_eq!(
+            from_str::<char>(&ron),
+            Ok(c),
+            "char {c:?} did not roundtrip via {ron:?}"
+        );
+    }
+
+    /// With `escape_strings(false)` the serializer falls back to raw strings
+    /// (`r#"..."#`) whenever the string contains `"` or `\`, choosing the
+    /// number of hash marks from the longest `#` run in the content. Strings
+    /// made of quotes, hashes, backslashes, and line breaks target exactly
+    /// that delimiter-selection boundary.
+    #[hegel::test]
+    fn prop_unescaped_raw_string_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(12));
+        let s: String = (0..n)
+            .map(|_| {
+                tc.draw(hegel::one_of!(
+                    generators::sampled_from(vec!['"', '#', '\\', '\n', '\r', '\t', 'a', ' ']),
+                    generators::integers::<u32>()
+                        .max_value(0x10_FFFF)
+                        .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+                ))
+            })
+            .collect();
+
+        let config = ron::ser::PrettyConfig::new().escape_strings(false);
+        let ron = ron::ser::to_string_pretty(&s, config).unwrap();
+        assert_eq!(
+            from_str::<String>(&ron).as_ref(),
+            Ok(&s),
+            "string {s:?} did not roundtrip unescaped via {ron:?}"
+        );
+    }
+}
diff --git a/tests/extensions.rs b/tests/extensions.rs
index 6b3ade8..2bff36c 100644
--- a/tests/extensions.rs
+++ b/tests/extensions.rs
@@ -90,3 +90,75 @@ fn implicit_some() {
 
     println!("implicit_some: {:#?}", d);
 }
+
+mod hegel_props {
+    use hegel::generators::{self, Generator};
+    use ron::extensions::Extensions;
+    use std::collections::HashMap;
+
+    use super::{Enum, Key, NewType, Struct, TupleStruct, UnitStruct};
+
+    fn draw_struct(tc: &hegel::TestCase) -> Struct {
+        // NaN is excluded because the derived `PartialEq` on `Struct` (the
+        // test's oracle) cannot compare NaN — not because ron couldn't
+        // serialize it.
+        let f = tc.draw(generators::floats::<f32>().allow_nan(false));
+        let vec: Vec<Option<UnitStruct>> = tc
+            .draw(generators::vecs(generators::booleans()))
+            .into_iter()
+            .map(|some| some.then_some(UnitStruct))
+            .collect();
+        let entries: Vec<(u32, u8)> = tc.draw(generators::vecs(generators::tuples!(
+            generators::integers::<u32>(),
+            generators::integers::<u8>().max_value(3),
+        )));
+        let map: HashMap<Key, Enum> = entries
+            .into_iter()
+            .map(|(k, which)| {
+                let v = match which {
+                    0 => Enum::Unit,
+                    1 => Enum::Bool(tc.draw(generators::booleans())),
+                    _ => Enum::Chars(
+                        tc.draw(
+                            generators::integers::<u32>()
+                                .max_value(0x10_FFFF)
+                                .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+                        ),
+                        tc.draw(generators::text().max_size(6)),
+                    ),
+                };
+                (Key(k), v)
+            })
+            .collect();
+        Struct {
+            tuple: (
+                (),
+                NewType(f),
+                TupleStruct(UnitStruct, tc.draw(generators::integers::<i8>())),
+            ),
+            vec,
+            map,
+        }
+    }
+
+    /// Generated data must roundtrip under *every* combination of extensions
+    /// (the powerset of `unwrap_newtypes`, `implicit_some`,
+    /// `unwrap_variant_newtypes`, and `explicit_struct_names`): whatever the
+    /// serializer emits under a set of extensions, the deserializer must
+    /// accept back to an equal value.
+    #[hegel::test]
+    fn prop_roundtrip_under_all_extension_combinations(tc: hegel::TestCase) {
+        let value = draw_struct(&tc);
+        let bits = tc.draw(
+            generators::integers::<usize>().max_value(Extensions::all().bits()),
+        );
+        let extensions = Extensions::from_bits_retain(bits);
+
+        let pretty = ron::ser::PrettyConfig::default().extensions(extensions);
+        let s = ron::ser::to_string_pretty(&value, pretty).unwrap();
+        let back: Struct = ron::de::from_str(&s)
+            .unwrap_or_else(|e| panic!("{extensions:?}: failed to re-parse {s:?}: {e}"));
+
+        assert_eq!(back, value, "roundtrip under {extensions:?} via {s:?}");
+    }
+}
