+#[hegel::test]
+fn documented_ordering_rules_hold(tc: hegel::TestCase) {
+    // epochs take precedence: 2:1.0.0 > 1:9.9.9; no epoch means 0
+    let (e1, e2) = (tc.draw(int!(0u32, 5)), tc.draw(int!(0u32, 5)));
+    let body1 = tc.draw(arb_dotted(false, 4));
+    let body2 = tc.draw(arb_dotted(false, 4));
+    let t1 = if e1 == 0 && tc.draw(generators::booleans()) { body1.clone() } else { format!("{e1}:{body1}") };
+    let t2 = format!("{e2}:{body2}");
+    if let (Some(v1), Some(v2)) = (Version::new(&t1), Version::new(&t2)) {
+        if e1 != e2 {
+            assert_eq!(v1.cmp(&v2), e1.cmp(&e2), "{t1} vs {t2}");
+            assert_eq!(ver(&t1).cmp(&ver(&t2)), e1.cmp(&e2), "{t1} vs {t2}");
+        } else {
+            let (p1, p2) = (Version::new(&body1).unwrap(), Version::new(&body2).unwrap());
+            assert_eq!(v1.cmp(&v2), p1.cmp(&p2), "{t1} vs {t2}");
+        }
+    }
+    // purely numeric versions compare like sequences, a longer one winning on an equal prefix
+    let n1: Vec<u32> = (0..tc.draw(int!(1usize, 5))).map(|_| tc.draw(int!(0u32, 3))).collect();
+    let n2: Vec<u32> = (0..tc.draw(int!(1usize, 5))).map(|_| tc.draw(int!(0u32, 3))).collect();
+    let s1 = n1.iter().map(u32::to_string).collect::<Vec<_>>().join(".");
+    let s2 = n2.iter().map(u32::to_string).collect::<Vec<_>>().join(".");
+    let want = n1.iter().zip(&n2).map(|(a, b)| a.cmp(b)).find(|o| *o != Ordering::Equal).unwrap_or(n1.len().cmp(&n2.len()));
+    assert_eq!(Version::new(&s1).unwrap().cmp(&Version::new(&s2).unwrap()), want, "{s1} vs {s2}");
+    assert_eq!(ver(&s1).cmp(&ver(&s2)), want, "Versioning {s1} vs {s2}");
+    // RCs and post-letters are less than the plain number: 1.0rc1 < 1.0, 3.7b < 3.7 < 3.7.1
+    let base = format!("{}.{}", tc.draw(int!(0u32, 9)), tc.draw(int!(0u32, 9)));
+    let word = tc.draw(generators::sampled_from(vec!["rc", "b", "alpha", "p"]));
+    let rc = format!("{base}{word}{}", tc.draw(int!(0u32, 9)));
+    let post = format!("{base}{word}");
+    let plain = Version::new(&base).unwrap();
+    assert!(Version::new(&rc).unwrap() < plain, "{rc} < {base}");
+    assert!(Version::new(&post).unwrap() < plain, "{post} < {base}");
+    assert!(ver(&rc) < ver(&base), "{rc} < {base} as Versioning");
+    assert!(ver(&post) < ver(&base), "{post} < {base} as Versioning");
+    let (r1, r2) = (tc.draw(int!(0u32, 9)), tc.draw(int!(0u32, 9)));
+    assert_eq!(Version::new(&format!("{base}{word}{r1}")).unwrap().cmp(&Version::new(&format!("{base}{word}{r2}")).unwrap()), r1.cmp(&r2));
+    // a release number orders after the body: 1.2.3-1 < 1.2.3-2, and compares numerically
+    assert_eq!(ver(&format!("{base}.0-{r1}")).cmp(&ver(&format!("{base}.0-{r2}"))), r1.cmp(&r2));
+    assert_eq!(Version::new(&format!("{base}-{r1}")).unwrap().cmp(&Version::new(&format!("{base}-{r2}")).unwrap()), r1.cmp(&r2));
+    // a Mess keeps the digits' text but compares their value: 1.003.0 == 1.3.0
+    let zeros = "0".repeat(tc.draw(int!(1usize, 3)));
+    let (m1, m2) = (Mess::new(&format!("1.{zeros}{r1}.0")).unwrap(), Mess::new(&format!("1.{r1}.0")).unwrap());
+    assert_eq!(m1.cmp(&m2), Ordering::Equal);
+    assert_eq!(m1.to_string(), format!("1.{zeros}{r1}.0"));
+    assert_eq!(m1.nth(1), Some(r1));
+    // revisions: r8 < r23 inside a Version chunk and a Mess chunk, and a revision is below a number
+    let (x, y) = (tc.draw(int!(0u32, 999)), tc.draw(int!(0u32, 999)));
+    assert_eq!(Version::new(&format!("2.14.r{x}.g1-1")).unwrap().cmp(&Version::new(&format!("2.14.r{y}.g1-1")).unwrap()), x.cmp(&y));
+    assert_eq!(Mess::new(&format!("2.r{x}_1")).unwrap().cmp(&Mess::new(&format!("2.r{y}_1")).unwrap()), x.cmp(&y));
+    assert!(Mess::new(&format!("2.r{x}_1")).unwrap() < Mess::new(&format!("2.{y}_1")).unwrap());
+}
