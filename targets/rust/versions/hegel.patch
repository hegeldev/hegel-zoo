+/// A numeric base, or the base with an `rc`/post/alphanumeric last part or a release number.
+#[hegel::composite]
+fn arb_variant(tc: &hegel::TestCase, base: &Vec<u32>) -> String {
+    let mut parts: Vec<String> = base.iter().map(u32::to_string).collect();
+    let word = tc.draw(generators::sampled_from(vec!["rc", "b", "alpha", "r"]));
+    match tc.draw(int!(0u8, 5)) {
+        0 => {}
+        1 => *parts.last_mut().unwrap() += &format!("{word}{}", tc.draw(int!(0u32, 3))),
+        2 => *parts.last_mut().unwrap() += word,
+        3 => parts.push(format!("{}", tc.draw(int!(0u32, 3)))),
+        4 => parts.push(word.to_string()),
+        _ => {
+            let n = parts.len();
+            parts[n - 1] = format!("{}-{}", parts[n - 1], tc.draw(int!(0u32, 3)));
+        }
+    }
+    parts.join(".")
+}
