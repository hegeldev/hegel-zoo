+//! Hegel properties for `versions`.
+//!
+//! Oracles: (1) a second implementation of the three grammars (`SemVer`, `Version`, `Mess`)
+//! and of `Versioning::new`'s choice between them, building the expected values from the
+//! crate's public fields; (2) the `semver` crate for the ideal type's parsing and ordering;
+//! (3) the laws of `Ord`/`Eq`/`Hash` and the crate's documented ordering rules (epochs, RCs,
+//! `1.003.0`), conversions (`to_version`, `to_mess` are documented lossless) and
+//! `Requirement` semantics (`~`/`^` as cargo defines them, via `semver::VersionReq`, and the
+//! documented extension to general versions).
+#![allow(clippy::all, dead_code)]
+
+use hegel::generators;
+use std::cmp::Ordering;
+use std::hash::{DefaultHasher, Hash, Hasher};
+use std::str::FromStr;
+use versions::{Chunk, Chunks, Last, MChunk, Mess, Op, Release, Requirement, SemVer, Sep, Version, Versioning};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+// --------------------------------------------------------------------------- grammar model
+
+fn is_u32_text(s: &str) -> bool {
+    s == "0" || (!s.is_empty() && s.bytes().all(|b| b.is_ascii_digit()) && !s.starts_with('0') && s.parse::<u32>().is_ok())
+}
+
+fn has_alpha(s: &str) -> bool {
+    s.bytes().any(|b| b.is_ascii_alphabetic())
+}
+
+/// A pre-release identifier: letters, digits and hyphens, not purely numeric unless a `u32`.
+fn is_pre_piece(s: &str) -> bool {
+    !s.is_empty()
+        && s.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-')
+        && (has_alpha(s) || s.contains('-') || is_u32_text(s))
+}
+
+/// A main `Version` chunk: letters and digits only, not purely numeric unless a `u32`.
+fn is_main_piece(s: &str) -> bool {
+    !s.is_empty() && s.bytes().all(|b| b.is_ascii_alphanumeric()) && (has_alpha(s) || is_u32_text(s))
+}
+
+fn is_meta(s: &str) -> bool {
+    !s.is_empty() && s.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'.')
+}
+
+fn chunk_of(piece: &str) -> Chunk {
+    if has_alpha(piece) || piece.contains('-') {
+        Chunk::Alphanum(piece.to_string())
+    } else {
+        Chunk::Numeric(piece.parse().unwrap())
+    }
+}
+
+/// Split `text` into (core, pre-release, meta) at the first `-` and `+`.
+fn split_tail(text: &str) -> Option<(&str, Option<&str>, Option<&str>)> {
+    let (core, meta) = match text.find('+') {
+        Some(i) => (&text[..i], Some(&text[i + 1..])),
+        None => (text, None),
+    };
+    if let Some(m) = meta {
+        if !is_meta(m) {
+            return None;
+        }
+    }
+    let (main, pre) = match core.find('-') {
+        Some(i) => (&core[..i], Some(&core[i + 1..])),
+        None => (core, None),
+    };
+    Some((main, pre, meta))
+}
+
+fn model_release(pre: &str) -> Option<Release> {
+    let pieces: Vec<&str> = pre.split('.').collect();
+    if pieces.iter().all(|p| is_pre_piece(p)) {
+        Some(Release(pieces.iter().map(|p| chunk_of(p)).collect()))
+    } else {
+        None
+    }
+}
+
+fn model_semver(text: &str) -> Option<SemVer> {
+    let (mmp, pre, meta) = split_tail(text)?;
+    let parts: Vec<&str> = mmp.split('.').collect();
+    if parts.len() != 3 || !parts.iter().all(|p| is_u32_text(p)) {
+        return None;
+    }
+    let pre_rel = match pre {
+        Some(p) => Some(model_release(p)?),
+        None => None,
+    };
+    Some(SemVer {
+        major: parts[0].parse().unwrap(),
+        minor: parts[1].parse().unwrap(),
+        patch: parts[2].parse().unwrap(),
+        pre_rel,
+        meta: meta.map(str::to_string),
+    })
+}
+
+/// The documented `Last` patterns: `DIGITS LETTERS DIGITS` (rc), `DIGITS LETTERS` (post).
+fn model_last(piece: &str) -> Last {
+    if is_u32_text(piece) {
+        return Last::Numeric(piece.parse().unwrap());
+    }
+    let b = piece.as_bytes();
+    let d1 = b.iter().take_while(|c| c.is_ascii_digit()).count();
+    let l = b[d1..].iter().take_while(|c| c.is_ascii_alphabetic()).count();
+    let d2 = b[d1 + l..].iter().take_while(|c| c.is_ascii_digit()).count();
+    let (a, s, t) = (&piece[..d1], &piece[d1..d1 + l], &piece[d1 + l..]);
+    if d1 > 0 && l > 0 && d1 + l + d2 == piece.len() && is_u32_text(a) {
+        if d2 == 0 {
+            return Last::Post(a.parse().unwrap(), s.to_string());
+        }
+        if is_u32_text(t) {
+            return Last::Rc(a.parse().unwrap(), s.to_string(), t.parse().unwrap());
+        }
+    }
+    Last::Alphanum(piece.to_string())
+}
+
+fn model_version(text: &str) -> Option<Version> {
+    let (epoch, body) = match text.find(':') {
+        Some(i) => {
+            if !is_u32_text(&text[..i]) {
+                return None;
+            }
+            (Some(text[..i].parse::<u32>().unwrap()), &text[i + 1..])
+        }
+        None => (None, text),
+    };
+    if body.contains(':') {
+        return None;
+    }
+    let (main, pre, meta) = split_tail(body)?;
+    let pieces: Vec<&str> = main.split('.').collect();
+    if !pieces.iter().all(|p| is_main_piece(p)) {
+        return None;
+    }
+    let release = match pre {
+        Some(p) => Some(model_release(p)?),
+        None => None,
+    };
+    let last = model_last(pieces[pieces.len() - 1]);
+    let chunks = Chunks(pieces[..pieces.len() - 1].iter().map(|p| chunk_of(p)).collect());
+    Some(Version { epoch, chunks, last, release, meta: meta.map(str::to_string) })
+}
+
+fn sep_of(c: char) -> Option<Sep> {
+    Some(match c {
+        ':' => Sep::Colon,
+        '-' => Sep::Hyphen,
+        '+' => Sep::Plus,
+        '_' => Sep::Underscore,
+        '~' => Sep::Tilde,
+        _ => return None,
+    })
+}
+
+fn mchunk_of(g: &str) -> MChunk {
+    if g.bytes().all(|b| b.is_ascii_digit()) {
+        if let Ok(n) = g.parse::<u32>() {
+            return MChunk::Digits(n, g.to_string());
+        }
+    }
+    if let Some(rest) = g.strip_prefix('r') {
+        if !rest.is_empty() && rest.bytes().all(|b| b.is_ascii_digit()) {
+            if let Ok(n) = rest.parse::<u32>() {
+                return MChunk::Rev(n, g.to_string());
+            }
+        }
+    }
+    MChunk::Plain(g.to_string())
+}
+
+/// `Mess`: ASCII alphanumeric groups separated by single `.`, `:`, `-`, `+`, `_` or `~`.
+fn model_mess(text: &str) -> Option<Mess> {
+    let mut chunks = Vec::new();
+    let mut rest = text;
+    loop {
+        let n = rest.bytes().take_while(|b| b.is_ascii_alphanumeric()).count();
+        if n == 0 {
+            return None;
+        }
+        chunks.push(mchunk_of(&rest[..n]));
+        rest = &rest[n..];
+        let mut it = rest.chars();
+        match it.next() {
+            None => return Some(Mess { chunks, next: None }),
+            Some('.') => rest = &rest[1..],
+            Some(c) => {
+                let sep = sep_of(c)?;
+                let next = model_mess(&rest[1..])?;
+                return Some(Mess { chunks, next: Some((sep, Box::new(next))) });
+            }
+        }
+    }
+}
+
+fn model_versioning(text: &str) -> Option<Versioning> {
+    model_semver(text)
+        .map(Versioning::Ideal)
+        .or_else(|| model_version(text).map(Versioning::General))
+        .or_else(|| model_mess(text).map(Versioning::Complex))
+}
+
+fn dbg<T: std::fmt::Debug>(t: &T) -> String {
+    format!("{t:?}")
+}
+
+// --------------------------------------------------------------------------- generators
+
+const WORDS: [&str; 16] = ["a", "rc", "alpha", "beta", "r", "git", "el9", "ZS", "v", "pre", "u", "p", "b", "final", "g28399bf", "SNAPSHOT"];
+const JUNK: [&str; 9] = [" ", "..", "ä", "🙈", "/", "*", "=", "!", "\t"];
+
+#[hegel::composite]
+fn arb_number_text(tc: &hegel::TestCase) -> String {
+    match tc.draw(int!(0u8, 7)) {
+        0 => "0".to_string(),
+        1 => format!("0{}", tc.draw(int!(0u32, 99))), // leading zero
+        2 => u32::MAX.to_string(),
+        3 => (u32::MAX as u64 + 1).to_string(),
+        4 => "1730239248325".to_string(), // upstream #29
+        _ => tc.draw(int!(0u32, 300)).to_string(),
+    }
+}
+
+/// A word, a number, or a mixture such as `1rc2`, `7b`, `r23`, `00a`, `x-y`.
+#[hegel::composite]
+fn arb_piece(tc: &hegel::TestCase, hyphens: bool) -> String {
+    let word = |tc: &hegel::TestCase| WORDS[tc.draw(int!(0usize, WORDS.len() - 1))].to_string();
+    match tc.draw(int!(0u8, 7)) {
+        0 | 1 => tc.draw(arb_number_text()),
+        2 => word(tc),
+        3 => format!("{}{}", tc.draw(arb_number_text()), word(tc)),
+        4 => format!("{}{}{}", tc.draw(arb_number_text()), word(tc), tc.draw(arb_number_text())),
+        5 => format!("{}{}", word(tc), tc.draw(arb_number_text())),
+        6 if hyphens => format!("{}-{}", word(tc), tc.draw(arb_number_text())),
+        6 => format!("{}{}", word(tc), word(tc)),
+        _ => tc.draw(generators::sampled_from(vec!["", "-", "00a", "1-", "a-b-c"])).to_string(),
+    }
+}
+
+#[hegel::composite]
+fn arb_dotted(tc: &hegel::TestCase, hyphens: bool, max: usize) -> String {
+    let k = tc.draw(int!(1usize, max));
+    let pieces: Vec<String> = (0..k).map(|_| tc.draw(arb_piece(hyphens))).collect();
+    pieces.join(".")
+}
+
+/// A strict semver text with `u32` numbers, from a `semver::Version`.
+#[hegel::composite]
+fn arb_semver_text(tc: &hegel::TestCase) -> String {
+    let num = |tc: &hegel::TestCase| -> u64 {
+        match tc.draw(int!(0u8, 3)) {
+            0 => tc.draw(int!(0u64, u32::MAX as u64)),
+            _ => tc.draw(int!(0u64, 20)),
+        }
+    };
+    let mut v = semver::Version::new(num(tc), num(tc), num(tc));
+    let ident = |tc: &hegel::TestCase| -> String {
+        match tc.draw(int!(0u8, 3)) {
+            0 => tc.draw(int!(0u64, 99999)).to_string(),
+            1 => WORDS[tc.draw(int!(0usize, WORDS.len() - 1))].to_string(),
+            2 => format!("{}-{}", WORDS[tc.draw(int!(0usize, WORDS.len() - 1))], tc.draw(int!(0u32, 9))),
+            _ => format!("{}{}", WORDS[tc.draw(int!(0usize, WORDS.len() - 1))], tc.draw(int!(0u32, 9))),
+        }
+    };
+    if tc.draw(generators::booleans()) {
+        let k = tc.draw(int!(1usize, 3));
+        let pre: Vec<String> = (0..k).map(|_| ident(tc)).collect();
+        v.pre = semver::Prerelease::new(&pre.join(".")).unwrap();
+    }
+    if tc.draw(generators::booleans()) {
+        let k = tc.draw(int!(1usize, 3));
+        let build: Vec<String> = (0..k).map(|_| match tc.draw(int!(0u8, 2)) { 0 => format!("0{}", tc.draw(int!(0u32, 99))), _ => ident(tc) }).collect();
+        v.build = semver::BuildMetadata::new(&build.join(".")).unwrap();
+    }
+    v.to_string()
+}
+
+/// `[epoch:] chunks [-release] [+meta]` in the general shape.
+#[hegel::composite]
+fn arb_version_text(tc: &hegel::TestCase) -> String {
+    let mut s = String::new();
+    if tc.draw(int!(0u8, 3)) == 0 {
+        s.push_str(&format!("{}:", tc.draw(arb_number_text())));
+    }
+    s.push_str(&tc.draw(arb_dotted(false, 5)));
+    if tc.draw(int!(0u8, 2)) == 0 {
+        s.push('-');
+        s.push_str(&tc.draw(arb_dotted(true, 3)));
+    }
+    if tc.draw(int!(0u8, 3)) == 0 {
+        s.push('+');
+        s.push_str(&tc.draw(generators::sampled_from(vec!["git123", "20200830-1", "a.b", "0007", "-", "."])));
+    }
+    s
+}
+
+/// Alphanumeric groups joined by the `Mess` separators.
+#[hegel::composite]
+fn arb_mess_text(tc: &hegel::TestCase) -> String {
+    let k = tc.draw(int!(1usize, 7));
+    let mut s = String::new();
+    for i in 0..k {
+        if i > 0 {
+            s.push_str(tc.draw(generators::sampled_from(vec![".", ".", ".", ":", "-", "+", "_", "~"])));
+        }
+        let piece = tc.draw(arb_piece(false));
+        if piece.is_empty() || piece.contains('-') {
+            s.push_str(&format!("r{}", tc.draw(int!(0u32, 999))));
+        } else {
+            s.push_str(&piece);
+        }
+    }
+    s
+}
+
+/// Any of the three shapes, or a soup.
+#[hegel::composite]
+fn arb_text(tc: &hegel::TestCase) -> String {
+    match tc.draw(int!(0u8, 6)) {
+        0 | 1 => tc.draw(arb_semver_text()),
+        2 | 3 => tc.draw(arb_version_text()),
+        4 | 5 => tc.draw(arb_mess_text()),
+        _ => {
+            let k = tc.draw(int!(0usize, 6));
+            let mut s = String::new();
+            for _ in 0..k {
+                match tc.draw(int!(0u8, 4)) {
+                    0 => s.push_str(&tc.draw(arb_piece(true))),
+                    1 => s.push_str(tc.draw(generators::sampled_from(vec![".", ":", "-", "+", "_", "~"]))),
+                    2 => s.push_str(JUNK[tc.draw(int!(0usize, JUNK.len() - 1))]),
+                    _ => s.push_str(&tc.draw(arb_number_text())),
+                }
+            }
+            s
+        }
+    }
+}
+
+/// A text that `Versioning::new` accepts.
+#[hegel::composite]
+fn arb_versioning_text(tc: &hegel::TestCase) -> String {
+    for _ in 0..4 {
+        let t = tc.draw(arb_text());
+        if Versioning::new(&t).is_some() {
+            return t;
+        }
+    }
+    "1.0.0".to_string()
+}
+
+fn ver(text: &str) -> Versioning {
+    Versioning::new(text).unwrap_or_else(|| panic!("{text:?} does not parse"))
+}
+
+fn strict(text: &str) -> semver::Version {
+    semver::Version::parse(text).unwrap()
+}
+
+fn hash_of<T: Hash>(t: &T) -> u64 {
+    let mut h = DefaultHasher::new();
+    t.hash(&mut h);
+    h.finish()
+}
+
+// --------------------------------------------------------------------------- parsing
+
+#[hegel::test]
+fn parsing_agrees_with_the_grammar_model(tc: hegel::TestCase) {
+    let text = tc.draw(arb_text());
+    let sv = SemVer::new(&text);
+    let v = Version::new(&text);
+    let m = Mess::new(&text);
+    assert_eq!(dbg(&sv), dbg(&model_semver(&text)), "SemVer::new({text:?})");
+    assert_eq!(dbg(&v), dbg(&model_version(&text)), "Version::new({text:?})");
+    assert_eq!(dbg(&m), dbg(&model_mess(&text)), "Mess::new({text:?})");
+    let all = Versioning::new(&text);
+    assert_eq!(dbg(&all), dbg(&model_versioning(&text)), "Versioning::new({text:?})");
+    // every SemVer is a Version (a Version is not always a Mess: `0+-` has a meta a Mess rejects)
+    if sv.is_some() {
+        assert!(v.is_some(), "{text:?}");
+    }
+    // Display gives the text back for every type that accepts it
+    for shown in [sv.as_ref().map(|x| x.to_string()), v.as_ref().map(|x| x.to_string()), m.as_ref().map(|x| x.to_string()), all.as_ref().map(|x| x.to_string())].into_iter().flatten() {
+        assert_eq!(shown, text);
+    }
+    // FromStr / TryFrom report the text in the error
+    match (&sv, SemVer::from_str(&text)) {
+        (Some(a), Ok(b)) => assert_eq!(dbg(a), dbg(&b)),
+        (None, Err(e)) => assert_eq!(e.to_string(), format!("Illegal SemVer: {text}")),
+        (a, b) => panic!("{text:?}: {a:?} vs {b:?}"),
+    }
+    match (&v, Version::try_from(text.as_str())) {
+        (Some(a), Ok(b)) => assert_eq!(dbg(a), dbg(&b)),
+        (None, Err(e)) => assert_eq!(e.to_string(), format!("Illegal Version: {text}")),
+        (a, b) => panic!("{text:?}: {a:?} vs {b:?}"),
+    }
+    match (&m, Mess::from_str(&text)) {
+        (Some(a), Ok(b)) => assert_eq!(dbg(a), dbg(&b)),
+        (None, Err(e)) => assert_eq!(e.to_string(), format!("Illegal Mess: {text}")),
+        (a, b) => panic!("{text:?}: {a:?} vs {b:?}"),
+    }
+    match (&all, Versioning::from_str(&text)) {
+        (Some(a), Ok(b)) => {
+            assert_eq!(dbg(a), dbg(&b));
+            assert_eq!(a.is_ideal(), sv.is_some());
+            assert_eq!(a.is_general(), sv.is_none() && v.is_some());
+            assert_eq!(a.is_complex(), v.is_none() && m.is_some());
+        }
+        (None, Err(e)) => assert_eq!(e.to_string(), format!("Illegal Versioning: {text}")),
+        (a, b) => panic!("{text:?}: {a:?} vs {b:?}"),
+    }
+}
+
+#[hegel::test]
+fn strict_texts_parse_as_the_semver_crate_does(tc: hegel::TestCase) {
+    let text = tc.draw(arb_semver_text());
+    let s = strict(&text);
+    let sv = SemVer::new(&text).unwrap_or_else(|| panic!("{text:?}"));
+    assert_eq!((sv.major as u64, sv.minor as u64, sv.patch as u64), (s.major, s.minor, s.patch));
+    let pre: Vec<String> = sv.pre_rel.as_ref().map(|r| r.0.iter().map(|c| c.to_string()).collect()).unwrap_or_default();
+    let want: Vec<String> = if s.pre.is_empty() { vec![] } else { s.pre.as_str().split('.').map(str::to_string).collect() };
+    assert_eq!(pre, want, "{text:?}");
+    assert_eq!(sv.meta.as_deref().unwrap_or(""), s.build.as_str());
+    assert!(ver(&text).is_ideal());
+    // numeric pre-release identifiers are numbers, the rest text
+    for c in pre.iter().zip(sv.pre_rel.iter().flat_map(|r| r.0.iter())) {
+        match c.1 {
+            Chunk::Numeric(n) => assert_eq!(c.0, &n.to_string()),
+            Chunk::Alphanum(a) => assert!(a.bytes().any(|b| !b.is_ascii_digit()), "{a}"),
+        }
+    }
+    // the semver crate rejects nothing the model accepts here, and vice versa, on strict shapes
+    let other = tc.draw(arb_text());
+    if let (Some(a), Ok(b)) = (SemVer::new(&other), semver::Version::parse(&other)) {
+        assert_eq!((a.major as u64, a.minor as u64, a.patch as u64), (b.major, b.minor, b.patch));
+        assert_eq!(a.pre_rel.map(|r| r.to_string()).unwrap_or_default(), b.pre.as_str());
+    }
+}
+
+// --------------------------------------------------------------------------- ordering
+
+fn without_build(v: &semver::Version) -> semver::Version {
+    let mut v = v.clone();
+    v.build = semver::BuildMetadata::EMPTY;
+    v
+}
+
+#[hegel::test]
+fn semvers_order_like_the_semver_crate(tc: hegel::TestCase) {
+    let a = tc.draw(arb_semver_text());
+    let b = tc.draw(arb_semver_text());
+    let (sa, sb) = (SemVer::new(&a).unwrap(), SemVer::new(&b).unwrap());
+    let (ta, tb) = (without_build(&strict(&a)), without_build(&strict(&b)));
+    assert_eq!(sa.cmp(&sb), ta.cmp(&tb), "{a} vs {b}");
+    assert_eq!(sa == sb, ta == tb);
+    if sa == sb {
+        assert_eq!(hash_of(&sa), hash_of(&sb));
+        assert_eq!(hash_of(&ver(&a)), hash_of(&ver(&b)));
+    }
+    assert_eq!(ver(&a).cmp(&ver(&b)), ta.cmp(&tb));
+    assert_eq!(ver(&a) == ver(&b), ta == tb);
+    // metadata does not affect equality or order
+    let stripped = a.split('+').next().unwrap();
+    assert_eq!(SemVer::new(stripped).unwrap(), sa);
+    assert_eq!(SemVer::new(stripped).unwrap().cmp(&sa), Ordering::Equal);
+}
+
+#[hegel::test]
+fn versioning_comparison_is_a_total_order(tc: hegel::TestCase) {
+    let texts: Vec<String> = (0..3).map(|_| tc.draw(arb_versioning_text())).collect();
+    let vs: Vec<Versioning> = texts.iter().map(|t| ver(t)).collect();
+    for (i, a) in vs.iter().enumerate() {
+        assert_eq!(a.cmp(a), Ordering::Equal, "{}", texts[i]);
+        assert_eq!(a.partial_cmp(a), Some(Ordering::Equal));
+        for (j, b) in vs.iter().enumerate() {
+            assert_eq!(a.cmp(b), b.cmp(a).reverse(), "antisymmetry: {} vs {}", texts[i], texts[j]);
+            assert_eq!(a.partial_cmp(b), Some(a.cmp(b)));
+            assert_eq!(a == b, a.cmp(b) == Ordering::Equal, "Eq vs Ord: {} vs {}", texts[i], texts[j]);
+            if a == b {
+                assert_eq!(hash_of(a), hash_of(b), "{} vs {}", texts[i], texts[j]);
+            }
+            for (k, c) in vs.iter().enumerate() {
+                if a <= b && b <= c {
+                    assert!(a <= c, "transitivity: {} <= {} <= {} but {:?}", texts[i], texts[j], texts[k], a.cmp(c));
+                }
+                if a < b && b < c {
+                    assert!(a < c, "transitivity: {} < {} < {}", texts[i], texts[j], texts[k]);
+                }
+            }
+        }
+    }
+}
+
+fn order_laws<T: Ord + Hash + std::fmt::Debug>(vs: &[T], texts: &[String]) {
+    for (i, a) in vs.iter().enumerate() {
+        assert_eq!(a.cmp(a), Ordering::Equal);
+        for (j, b) in vs.iter().enumerate() {
+            assert_eq!(a.cmp(b), b.cmp(a).reverse(), "antisymmetry: {} vs {}", texts[i], texts[j]);
+            assert_eq!(a == b, a.cmp(b) == Ordering::Equal, "Eq vs Ord: {} vs {} ({a:?} / {b:?})", texts[i], texts[j]);
+            if a == b {
+                assert_eq!(hash_of(a), hash_of(b));
+            }
+            for (k, c) in vs.iter().enumerate() {
+                if a <= b && b <= c {
+                    assert!(a <= c, "transitivity: {} <= {} <= {} but {:?}", texts[i], texts[j], texts[k], a.cmp(c));
+                }
+            }
+        }
+    }
+}
