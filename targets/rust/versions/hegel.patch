+fn versioning_orders_version_texts_like_version_does(tc: hegel::TestCase) {
+    // `SemVer::to_version` is documented lossless, so two texts that both parse as `Version`
+    // must compare the same way whether or not one of them also happens to be a `SemVer` —
+    // checked where every leading chunk is a plain number (the cross-type comparison
+    // deliberately ranks a non-numeric chunk below any number, `e.2.3 < 1.2.3`)
+    let base: Vec<u32> = (0..tc.draw(int!(1usize, 4))).map(|_| tc.draw(int!(0u32, 3))).collect();
+    let a = tc.draw(arb_variant(&base));
+    let b = if tc.draw(generators::booleans()) { tc.draw(arb_variant(&base)) } else { tc.draw(arb_version_text()) };
+    if let (Some(va), Some(vb)) = (Version::new(&a), Version::new(&b)) {
+        let plain = |v: &Version| v.epoch.is_none() && v.chunks.0.iter().all(|c| c.single_digit().is_some());
+        if plain(&va) && plain(&vb) {
+            assert_eq!(ver(&a).cmp(&ver(&b)), va.cmp(&vb), "{a} vs {b} ({:?} / {:?})", ver(&a), ver(&b));
+            assert_eq!(ver(&a) == ver(&b), va == vb, "{a} vs {b}");
+        }
+    }
+}
