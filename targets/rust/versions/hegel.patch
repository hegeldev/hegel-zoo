+#[hegel::test]
+fn requirements_match_per_their_definitions(tc: hegel::TestCase) {
+    let a = tc.draw(arb_versioning_text());
+    let b = tc.draw(arb_versioning_text());
+    let (va, vb) = (ver(&a), ver(&b));
+    for (sym, op) in OPS {
+        let req = if op == Op::Wildcard { Requirement::new("*").unwrap() } else { Requirement::new(&format!("{sym}{a}")).unwrap_or_else(|| return Requirement { op, version: Some(va.clone()) }) };
+        let got = req.matches(&vb);
+        let want = match op {
+            Op::Exact => vb == va,
+            Op::Greater => vb > va,
+            Op::GreaterEq => vb >= va,
+            Op::Less => vb < va,
+            Op::LessEq => vb <= va,
+            Op::Wildcard => true,
+            Op::Tilde | Op::Caret => continue,
+        };
+        assert_eq!(got, want, "{sym}{a} matches {b}");
+    }
+    // tilde and caret: only same-shaped ideal or general versions can match
+    let tilde = Requirement { op: Op::Tilde, version: Some(va.clone()) };
+    let caret = Requirement { op: Op::Caret, version: Some(va.clone()) };
+    match (&va, &vb) {
+        (Versioning::Ideal(x), Versioning::Ideal(y)) => {
+            // cargo's rules, via semver::VersionReq, for versions without a pre-release
+            let (sx, sy) = (strict(&a), strict(&b));
+            if sx.pre.is_empty() && sy.pre.is_empty() {
+                let base = format!("{}.{}.{}", x.major, x.minor, x.patch);
+                assert_eq!(tilde.matches(&vb), semver::VersionReq::parse(&format!("~{base}")).unwrap().matches(&sy), "~{a} matches {b}");
+                assert_eq!(caret.matches(&vb), semver::VersionReq::parse(&format!("^{base}")).unwrap().matches(&sy), "^{a} matches {b}");
+            }
+            // the documented definitions, pre-release or not
+            assert_eq!(tilde.matches(&vb), x.major == y.major && x.minor == y.minor && y.patch >= x.patch, "~{a} matches {b}");
+        }
+        (Versioning::General(_), Versioning::General(_)) => {} // see general_tilde_and_caret_follow_the_documented_extension
+        _ => {
+            assert!(!tilde.matches(&vb), "~{a} matches {b}");
+            assert!(!caret.matches(&vb), "^{a} matches {b}");
+        }
+    }
+    // a version always satisfies its own tilde/caret/exact requirement
+    if va.is_ideal() {
+        assert!(tilde.matches(&va), "~{a} matches itself");
+        assert!(caret.matches(&va), "^{a} matches itself");
+    }
+    assert!(Requirement { op: Op::Exact, version: Some(va.clone()) }.matches(&va));
+}
