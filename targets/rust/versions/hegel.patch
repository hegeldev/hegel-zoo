+#[hegel::test]
+fn chunk_digit_helpers_follow_their_docs(tc: hegel::TestCase) {
+    let piece = tc.draw(arb_piece(true));
+    if !is_pre_piece(&piece) {
+        return; // not a chunk (empty, a leading zero, or beyond u32)
+    }
+    let chunk = chunk_of(&piece);
+    let leading: Option<u32> = {
+        let n = piece.bytes().take_while(|b| b.is_ascii_digit()).count();
+        if n == 0 { None } else { Some(if piece.starts_with('0') { 0 } else { piece[..n].parse().ok().unwrap_or(u32::MAX) }) }
+    };
+    match &chunk {
+        Chunk::Numeric(n) => {
+            assert_eq!(chunk.single_digit(), Some(*n));
+            assert_eq!(chunk.single_digit_lenient(), Some(*n));
+            assert_eq!(chunk.single_digit_lenient_post(), Some(*n));
+        }
+        Chunk::Alphanum(s) => {
+            assert_eq!(chunk.single_digit(), None);
+            // "will grab a leading u32 even if followed by letters"; `0`-led runs read as 0
+            let n = s.bytes().take_while(|b| b.is_ascii_digit()).count();
+            let want = if n == 0 { None } else if s.starts_with('0') { Some(0) } else { s[..n].parse::<u32>().ok() };
+            assert_eq!(chunk.single_digit_lenient(), want, "{s}");
+            let _ = leading;
+            // "will grab a trailing u32": r23 -> 23 (a single letter then digits)
+            if s.len() >= 2 && s.as_bytes()[0].is_ascii_alphabetic() && s[1..].bytes().all(|b| b.is_ascii_digit()) {
+                let want = if s[1..].starts_with('0') && s.len() > 2 { Some(0) } else { s[1..].parse::<u32>().ok() };
+                assert_eq!(chunk.single_digit_lenient_post(), want, "{s}");
+            }
+        }
+    }
+    // Last::from follows the RC / post patterns
+    assert_eq!(dbg(&Last::from(chunk.clone())), dbg(&model_last(&piece)), "Last::from({piece:?})");
+    assert_eq!(Last::from(chunk).to_string(), piece);
+}
