+fn general_tilde_and_caret_follow_the_documented_extension(tc: hegel::TestCase) {
+    // numeric general versions of the same length: "~" = all but the last part equal, the last
+    // part greater or equal; "^" = the first non-zero part equal, the remaining parts greater or
+    // equal (leading zeros staying zero, as for `SemVer`)
+    let n = tc.draw(int!(1usize, 5));
+    let px: Vec<u32> = (0..n).map(|_| tc.draw(int!(0u32, 3))).collect();
+    let py: Vec<u32> = (0..n).map(|_| tc.draw(int!(0u32, 3))).collect();
+    let join = |v: &[u32]| v.iter().map(u32::to_string).collect::<Vec<_>>().join(".");
+    let (a, b) = (join(&px), join(&py));
+    let (va, vb) = (ver(&a), ver(&b));
+    if !(va.is_general() && vb.is_general()) {
+        return; // three parts are SemVer, covered by the semver::VersionReq comparison
+    }
+    let tilde = Requirement::new(&format!("~{a}")).unwrap();
+    let caret = Requirement::new(&format!("^{a}")).unwrap();
+    let want_tilde = px[..n - 1] == py[..n - 1] && py[n - 1] >= px[n - 1];
+    assert_eq!(tilde.matches(&vb), want_tilde, "~{a} matches {b}");
+    let k = px.iter().position(|&p| p != 0).unwrap_or(n - 1);
+    let want_caret = py[..k].iter().all(|&p| p == 0) && px[k] == py[k] && (k + 1..n).all(|i| py[i] >= px[i]);
+    assert_eq!(caret.matches(&vb), want_caret, "^{a} matches {b}");
+    assert!(tilde.matches(&va), "~{a} matches itself");
+    assert!(caret.matches(&va), "^{a} matches itself");
+}
