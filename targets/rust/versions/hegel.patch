+#[hegel::test]
+fn conversions_are_lossless(tc: hegel::TestCase) {
+    let text = tc.draw(arb_versioning_text());
+    let v = ver(&text);
+    match &v {
+        Versioning::Ideal(s) => {
+            let as_version = s.to_version();
+            assert_eq!(as_version.to_string(), text);
+            assert_eq!(dbg(&as_version), dbg(&Version::new(&text).unwrap()), "to_version of {text}");
+            assert_eq!(v.nth(0), Some(s.major));
+            assert_eq!(v.nth(1), Some(s.minor));
+            assert_eq!(v.nth(2), Some(s.patch));
+            assert_eq!(v.nth(3), None);
+        }
+        Versioning::General(g) => {
+            // nth: numeric chunks, then the last's leading number
+            for n in 0..=g.chunks.0.len() + 1 {
+                let want = if n < g.chunks.0.len() {
+                    g.chunks.0[n].single_digit()
+                } else if n == g.chunks.0.len() {
+                    match &g.last {
+                        Last::Numeric(x) | Last::Rc(x, _, _) | Last::Post(x, _) => Some(*x),
+                        Last::Alphanum(_) => None,
+                    }
+                } else {
+                    None
+                };
+                assert_eq!(g.nth(n), want, "nth({n}) of {text}");
+                assert_eq!(v.nth(n), want);
+            }
+        }
+        Versioning::Complex(m) => {
+            // nth skips the epoch — every leading colon group — and reads the numeric chunks
+            let mut body = m;
+            while let Some((Sep::Colon, next)) = &body.next {
+                body = next.as_ref();
+            }
+            for n in 0..=body.chunks.len() {
+                let want = body.chunks.get(n).and_then(|c| match c {
+                    MChunk::Digits(d, _) => Some(*d),
+                    _ => None,
+                });
+                assert_eq!(m.nth(n), want, "nth({n}) of {text}");
+                assert_eq!(v.nth(n), want);
+            }
+            for c in &m.chunks {
+                assert_eq!(c.to_string(), c.text());
+            }
+        }
+    }
+    // Default values
+    assert_eq!(SemVer::default().to_string(), "0.0.0");
+    assert_eq!(Versioning::default(), Versioning::Ideal(SemVer::default()));
+    assert_eq!(Version::default().to_string(), "0");
+}
