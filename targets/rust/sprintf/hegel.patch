+//! Hegel properties for `sprintf`: the crate says it "follows the standard C semantics", so the
+//! oracle is glibc's `snprintf`, called through `libc` one conversion at a time (the crate's own
+//! test suite does the same for a list of examples). The general properties keep to the shapes
+//! that are not pinned as bugs below: a value of zero for `%e`/`%g` (sprintf/1, /2), a `%g`
+//! whose fraction strips away entirely (/3), exact decimal ties (/4), a `%.0e` carrying into the
+//! exponent (/5), more than 15 requested digits or an integer part above 2^53 (/6), subnormals
+//! (/7), a precision on an integer conversion (/8), `i64::MIN` (/9), `#` on a zero (/10) or on a
+//! float (/11), `%u` of a negative (/12), a negative `*` width (/13), a `.*` precision (/16),
+//! `+` together with the space flag on a float (/15). Length modifiers are
+//! documented as ignored by the crate, so `ll` is written for the C side where it needs it.
+
+use hegel::{generators, TestCase};
+use sprintf::{parser::parse_format_string, sprintf, vsprintf, Printf, PrintfError};
+use std::ffi::CString;
+use std::os::raw::c_char;
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo as i64).max_value($hi as i64)
+    };
+}
+
+fn n(tc: &mut TestCase, lo: i64, hi: i64) -> i64 {
+    tc.draw(int!(lo, hi))
+}
+
+fn pick<T: Copy>(tc: &mut TestCase, xs: &[T]) -> T {
+    xs[n(tc, 0, xs.len() as i64 - 1) as usize]
+}
+
+fn chance(tc: &mut TestCase, pct: i64) -> bool {
+    n(tc, 0, 99) < pct
+}
+
+// --------------------------------------------------------------------------- the libc oracle
+
+/// An argument as C sees it.
+#[derive(Clone, Debug)]
+enum CArg {
+    I(i64),
+    U(u64),
+    I32(i32),
+    F(f64),
+    S(String),
+}
+
+impl CArg {
+    fn as_printf(&self) -> Box<dyn Printf> {
+        match self {
+            CArg::I(v) => Box::new(*v),
+            CArg::U(v) => Box::new(*v),
+            CArg::I32(v) => Box::new(*v),
+            CArg::F(v) => Box::new(*v),
+            CArg::S(v) => Box::new(v.clone()),
+        }
+    }
+}
+
+/// glibc's `snprintf` of one conversion with up to two `*` arguments before the value.
+fn libc_format(fmt: &str, stars: &[i32], arg: &CArg) -> String {
+    let cfmt = CString::new(fmt).unwrap();
+    let mut buf = vec![0u8; 4096];
+    let (p, len) = (buf.as_mut_ptr() as *mut c_char, buf.len());
+    let s;
+    let written = unsafe {
+        match (stars, arg) {
+            ([], CArg::I(v)) => libc::snprintf(p, len, cfmt.as_ptr(), *v),
+            ([], CArg::U(v)) => libc::snprintf(p, len, cfmt.as_ptr(), *v),
+            ([], CArg::I32(v)) => libc::snprintf(p, len, cfmt.as_ptr(), *v),
+            ([], CArg::F(v)) => libc::snprintf(p, len, cfmt.as_ptr(), *v),
+            ([], CArg::S(v)) => {
+                s = CString::new(v.as_str()).unwrap();
+                libc::snprintf(p, len, cfmt.as_ptr(), s.as_ptr())
+            }
+            ([a], CArg::I(v)) => libc::snprintf(p, len, cfmt.as_ptr(), *a, *v),
+            ([a], CArg::U(v)) => libc::snprintf(p, len, cfmt.as_ptr(), *a, *v),
+            ([a], CArg::I32(v)) => libc::snprintf(p, len, cfmt.as_ptr(), *a, *v),
+            ([a], CArg::F(v)) => libc::snprintf(p, len, cfmt.as_ptr(), *a, *v),
+            ([a], CArg::S(v)) => {
+                s = CString::new(v.as_str()).unwrap();
+                libc::snprintf(p, len, cfmt.as_ptr(), *a, s.as_ptr())
+            }
+            ([a, b], CArg::I(v)) => libc::snprintf(p, len, cfmt.as_ptr(), *a, *b, *v),
+            ([a, b], CArg::U(v)) => libc::snprintf(p, len, cfmt.as_ptr(), *a, *b, *v),
+            ([a, b], CArg::I32(v)) => libc::snprintf(p, len, cfmt.as_ptr(), *a, *b, *v),
+            ([a, b], CArg::F(v)) => libc::snprintf(p, len, cfmt.as_ptr(), *a, *b, *v),
+            ([a, b], CArg::S(v)) => {
+                s = CString::new(v.as_str()).unwrap();
+                libc::snprintf(p, len, cfmt.as_ptr(), *a, *b, s.as_ptr())
+            }
+            _ => unreachable!(),
+        }
+    };
+    assert!(written >= 0 && (written as usize) < buf.len(), "snprintf({:?}) returned {}", fmt, written);
+    buf.truncate(written as usize);
+    String::from_utf8(buf).unwrap()
+}
+
+/// The crate's result for the same call.
+fn crate_format(fmt: &str, stars: &[i32], arg: &CArg) -> Result<String, PrintfError> {
+    let value = arg.as_printf();
+    let mut args: Vec<&dyn Printf> = stars.iter().map(|s| s as &dyn Printf).collect();
+    args.push(value.as_ref());
+    vsprintf(fmt, &args)
+}
+
+fn check(fmt: &str, stars: &[i32], arg: &CArg) {
+    let expected = libc_format(fmt, stars, arg);
+    let got = catch_unwind(AssertUnwindSafe(|| crate_format(fmt, stars, arg)));
+    match got {
+        Ok(Ok(s)) => assert_eq!(s, expected, "vsprintf({:?}, {:?}, {:?})", fmt, stars, arg),
+        Ok(Err(e)) => panic!("vsprintf({:?}, {:?}, {:?}) = Err({:?}); libc: {:?}", fmt, stars, arg, e, expected),
+        Err(_) => panic!("vsprintf({:?}, {:?}, {:?}) panicked; libc: {:?}", fmt, stars, arg, expected),
+    }
+}
+
+// --------------------------------------------------------------------------- generators
+
+#[derive(Clone, Debug, Default)]
+struct Spec {
+    alt: bool,
+    zero: bool,
+    left: bool,
+    space: bool,
+    plus: bool,
+    width: Option<i32>,
+    star_width: Option<i32>,
+    precision: Option<i32>,
+    star_precision: Option<i32>,
+    length: &'static str,
+    conv: char,
+}
+
+impl Spec {
+    fn render(&self) -> String {
+        let mut s = String::from("%");
+        for (flag, c) in [(self.alt, '#'), (self.zero, '0'), (self.left, '-'), (self.space, ' '), (self.plus, '+')] {
+            if flag {
+                s.push(c);
+            }
+        }
+        if self.star_width.is_some() {
+            s.push('*');
+        } else if let Some(w) = self.width {
+            s.push_str(&w.to_string());
+        }
+        if self.star_precision.is_some() {
+            s.push_str(".*");
+        } else if let Some(p) = self.precision {
+            s.push_str(&format!(".{}", p));
+        }
+        s.push_str(self.length);
+        s.push(self.conv);
+        s
+    }
+
+    fn stars(&self) -> Vec<i32> {
+        self.star_width.into_iter().chain(self.star_precision).collect()
+    }
+}
+
+/// Flags, width and (when allowed) precision for a conversion; `*` arguments are non-negative.
+fn arb_layout(tc: &mut TestCase, conv: char, precision: Option<(i64, i64)>, zero_flag: bool) -> Spec {
+    let mut spec = Spec { conv, ..Default::default() };
+    spec.alt = chance(tc, 20);
+    spec.zero = zero_flag && chance(tc, 30);
+    spec.left = chance(tc, 25);
+    spec.space = chance(tc, 20);
+    spec.plus = chance(tc, 20);
+    match n(tc, 0, 3) {
+        0 => {}
+        1 => spec.star_width = Some(n(tc, 0, 40) as i32),
+        _ => spec.width = Some(n(tc, 0, 40) as i32),
+    }
+    // `.*` never reaches the argument (sprintf/16), so the general layouts write the precision.
+    if let Some((lo, hi)) = precision {
+        if chance(tc, 70) {
+            spec.precision = Some(n(tc, lo, hi) as i32);
+        }
+    }
+    spec
+}
+
+/// A float with at most six significant digits: `m × 10^e`, returned with the normalised
+/// digits and exponent so a property can tell where its decimal expansion ends.
+fn arb_short_float(tc: &mut TestCase, lo_e: i64, hi_e: i64) -> (f64, u64, i64) {
+    let mut m = n(tc, 1, 999_999) as u64;
+    let mut e = n(tc, lo_e, hi_e);
+    while m % 10 == 0 {
+        m /= 10;
+        e += 1;
+    }
+    let v = if e >= 0 { m as f64 * 10f64.powi(e as i32) } else { m as f64 / 10f64.powi(-e as i32) };
+    (v, m, e)
+}
+
+fn digits(m: u64) -> i64 {
+    m.to_string().len() as i64
+}
+
+fn arb_i64(tc: &mut TestCase) -> i64 {
+    match n(tc, 0, 4) {
+        0 => n(tc, -1000, 1000),
+        1 => n(tc, i32::MIN as i64 - 5, i32::MIN as i64 + 5),
+        2 => n(tc, i32::MAX as i64 - 5, i32::MAX as i64 + 5),
+        3 => n(tc, i64::MIN + 1, i64::MIN + 1000),
+        _ => n(tc, i64::MIN + 1, i64::MAX),
+    }
+}
+
+fn arb_ascii_string(tc: &mut TestCase) -> String {
+    let len = n(tc, 0, 12);
+    (0..len).map(|_| n(tc, 0x20, 0x7e) as u8 as char).collect()
+}
+
+// --------------------------------------------------------------------------- properties
+
+/// `d`, `i`, `u`, `x`, `X`, `o` with every flag and width match glibc for `i64`, `u64` and `i32`
+/// arguments (no precision: sprintf/8; `#` only on a non-zero: sprintf/10; `u` of a
+/// non-negative: sprintf/12).
+#[hegel::test]
+fn integers_match_libc(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['d', 'i', 'u', 'x', 'X', 'o']);
+    let mut spec = arb_layout(&mut tc, conv, None, true);
+    let signed = conv == 'd' || conv == 'i';
+    let arg = if chance(&mut tc, 35) {
+        CArg::I32(n(&mut tc, i32::MIN as i64, i32::MAX as i64) as i32)
+    } else if signed {
+        CArg::I(arb_i64(&mut tc))
+    } else {
+        CArg::U(match n(&mut tc, 0, 2) {
+            0 => n(&mut tc, 0, 1000) as u64,
+            1 => n(&mut tc, 0, i64::MAX) as u64,
+            _ => u64::MAX - n(&mut tc, 0, 1000) as u64,
+        })
+    };
+    let (is_zero, negative) = match &arg {
+        CArg::I(v) => (*v == 0, *v < 0),
+        CArg::U(v) => (*v == 0, false),
+        CArg::I32(v) => (*v == 0, *v < 0),
+        _ => unreachable!(),
+    };
+    tc.assume(!(spec.alt && is_zero));
+    tc.assume(!(conv == 'u' && negative));
+    // `%u` of an `i32` goes through the signed path, where `+`/space apply (sprintf/12).
+    tc.assume(!(conv == 'u' && matches!(arg, CArg::I32(_)) && (spec.plus || spec.space)));
+    spec.length = match arg {
+        CArg::I32(_) => "",
+        _ => "ll",
+    };
+    // A negative i32 through `%x` is 32 bits wide in C and 32 bits wide in the crate (`as u32`).
+    check(&spec.render(), &spec.stars(), &arg);
+}
+
+/// `f`, `F`, `e`, `E`, `g`, `G` of a value with at most six significant digits and at most 14
+/// significant digits requested match glibc, away from the pinned shapes (zero, ties, `%.0e` carrying,
+/// `#`, a `%g` with nothing after the point).
+#[hegel::test]
+fn floats_match_libc(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['f', 'F', 'e', 'E', 'g', 'G']);
+    let mut spec = arb_layout(&mut tc, conv, Some((0, 13)), true);
+    spec.alt = false;
+    spec.space = spec.space && !spec.plus; // both at once is sprintf/15
+    let (mag, m, e) = arb_short_float(&mut tc, -12, 9);
+    let v = if chance(&mut tc, 40) { -mag } else { mag };
+    let arg = CArg::F(v);
+    let p = spec.star_precision.or(spec.precision).unwrap_or(6) as i64;
+    // Where the decimal expansion of the value ends exactly on a 5 at the rounding position,
+    // glibc rounds the exact value half to even and the crate half away (sprintf/4).
+    let tie = match conv {
+        'f' | 'F' => -e == p + 1 && m % 10 == 5,
+        'e' | 'E' => digits(m) == p + 2 && m % 10 == 5,
+        _ => digits(m) == p.max(1) + 1 && m % 10 == 5,
+    };
+    tc.assume(!tie);
+    // From the 15th significant digit the exact binary value shows through (sprintf/6): `%f`
+    // keeps the integer part below 2^53 and the digits printed to 14.
+    if conv == 'f' || conv == 'F' {
+        tc.assume(digits(m) + e <= 14 && (digits(m) + e).max(0) + p <= 14);
+    }
+    // `%.0e` of a leading 9 that rounds up carries into the exponent (sprintf/5).
+    tc.assume(!((conv == 'e' || conv == 'E') && p == 0 && m.to_string().starts_with('9')));
+    let expected = libc_format(&spec.render(), &spec.stars(), &arg);
+    // A `%g` whose fraction strips away entirely keeps a trailing point (sprintf/3).
+    if conv == 'g' || conv == 'G' {
+        let mantissa = expected.split(|c| c == 'e' || c == 'E').next().unwrap();
+        tc.assume(mantissa.contains('.'));
+    }
+    check(&spec.render(), &spec.stars(), &arg);
+}
+
+/// Infinities and NaNs with every flag and width match glibc.
+#[hegel::test]
+fn non_finite_floats_match_libc(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['f', 'F', 'e', 'E', 'g', 'G']);
+    let mut spec = arb_layout(&mut tc, conv, Some((0, 12)), true);
+    spec.alt = false;
+    spec.space = spec.space && !spec.plus; // sprintf/15
+    let v = pick(&mut tc, &[f64::INFINITY, f64::NEG_INFINITY, f64::NAN]);
+    check(&spec.render(), &spec.stars(), &CArg::F(v));
+}
+
+/// `s` (with precision) and `c` of ASCII arguments match glibc for every width and flag;
+/// multi-byte strings pad by bytes like glibc.
+#[hegel::test]
+fn strings_and_chars_match_libc(mut tc: TestCase) {
+    if chance(&mut tc, 60) {
+        let multibyte = chance(&mut tc, 30);
+        let spec = arb_layout(&mut tc, 's', if multibyte { None } else { Some((0, 15)) }, false);
+        let text = if multibyte {
+            let mut t = arb_ascii_string(&mut tc);
+            let wide = pick(&mut tc, &['é', '𒀀', '中']);
+            t.insert(n(&mut tc, 0, t.len() as i64) as usize, wide);
+            t
+        } else {
+            arb_ascii_string(&mut tc)
+        };
+        check(&spec.render(), &spec.stars(), &CArg::S(text));
+    } else {
+        let spec = arb_layout(&mut tc, 'c', None, false);
+        let c = n(&mut tc, 0x20, 0x7e) as u8 as char;
+        let expected = libc_format(&spec.render(), &spec.stars(), &CArg::I32(c as i32));
+        let stars = spec.stars();
+        let mut args: Vec<&dyn Printf> = stars.iter().map(|s| s as &dyn Printf).collect();
+        args.push(&c);
+        assert_eq!(vsprintf(&spec.render(), &args).unwrap(), expected, "{:?} of {:?}", spec.render(), c);
+    }
+}
+
+/// A format string with several conversions and verbatim text (including `%%`) is the
+/// concatenation of the pieces; the parser sees the same pieces.
+#[hegel::test]
+fn format_strings_compose(mut tc: TestCase) {
+    let count = n(&mut tc, 0, 4);
+    let mut fmt = String::new();
+    let mut expected = String::new();
+    let mut args: Vec<CArg> = Vec::new();
+    let mut stars: Vec<Vec<i32>> = Vec::new();
+    let mut pieces = 0;
+    for i in 0..=count {
+        let verbatim = arb_ascii_string(&mut tc).replace('%', "");
+        if chance(&mut tc, 30) {
+            fmt.push_str(&verbatim);
+            fmt.push_str("%%");
+            expected.push_str(&verbatim);
+            expected.push('%');
+            pieces += (!verbatim.is_empty()) as usize + 1;
+        } else {
+            fmt.push_str(&verbatim);
+            expected.push_str(&verbatim);
+            pieces += (!verbatim.is_empty()) as usize;
+        }
+        if i == count {
+            break;
+        }
+        let (spec, arg) = match n(&mut tc, 0, 3) {
+            0 => {
+                let conv = pick(&mut tc, &['d', 'i']);
+                let mut s = arb_layout(&mut tc, conv, None, true);
+                s.length = "ll";
+                (s, CArg::I(n(&mut tc, -1_000_000, 1_000_000)))
+            }
+            1 => {
+                let conv = pick(&mut tc, &['x', 'X', 'o', 'u']);
+                let mut s = arb_layout(&mut tc, conv, None, true);
+                s.length = "ll";
+                (s, CArg::U(n(&mut tc, 1, 1_000_000) as u64))
+            }
+            2 => {
+                let mut s = arb_layout(&mut tc, 'f', Some((1, 6)), true);
+                s.alt = false;
+                s.space = s.space && !s.plus; // sprintf/15
+                (s, CArg::F(n(&mut tc, 1, 999_999) as f64 / 1000.0 + 0.0001))
+            }
+            _ => (arb_layout(&mut tc, 's', Some((0, 10)), false), CArg::S(arb_ascii_string(&mut tc))),
+        };
+        expected.push_str(&libc_format(&spec.render(), &spec.stars(), &arg));
+        fmt.push_str(&spec.render());
+        stars.push(spec.stars());
+        args.push(arg);
+        pieces += 1;
+    }
+    let values: Vec<Box<dyn Printf>> = args.iter().map(|a| a.as_printf()).collect();
+    let mut dyn_args: Vec<&dyn Printf> = Vec::new();
+    for (i, v) in values.iter().enumerate() {
+        for s in &stars[i] {
+            dyn_args.push(s);
+        }
+        dyn_args.push(v.as_ref());
+    }
+    assert_eq!(vsprintf(&fmt, &dyn_args), Ok(expected.clone()), "vsprintf({:?}, {:?})", fmt, args);
+    let parsed = parse_format_string(&fmt).unwrap();
+    assert_eq!(parsed.len(), pieces, "parse_format_string({:?}) = {:?}", fmt, parsed);
+    // An argument too few or too many is an error, not a panic or a wrong string.
+    if !dyn_args.is_empty() {
+        assert_eq!(vsprintf(&fmt, &dyn_args[..dyn_args.len() - 1]), Err(PrintfError::NotEnoughArgs));
+    }
+    let one_more: Vec<&dyn Printf> = dyn_args.iter().cloned().chain(std::iter::once(&1_i32 as &dyn Printf)).collect();
+    assert_eq!(vsprintf(&fmt, &one_more), Err(PrintfError::TooManyArgs));
+}
+
+/// A conversion given the wrong kind of argument is `WrongType`, never a panic.
+#[hegel::test]
+fn wrong_types_are_errors(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['d', 'x', 'o', 'f', 'e', 'g', 's', 'c']);
+    let mut spec = arb_layout(&mut tc, conv, Some((0, 6)), true);
+    spec.star_width = None;
+    spec.star_precision = None;
+    let spec = spec.render();
+    let (text, float, int) = ("text".to_string(), 1.5_f64, 7_i64);
+    let arg: &dyn Printf = match conv {
+        'd' | 'x' | 'o' => {
+            if chance(&mut tc, 50) {
+                &text
+            } else {
+                &float
+            }
+        }
+        'f' | 'e' | 'g' => {
+            if chance(&mut tc, 50) {
+                &text
+            } else {
+                &int
+            }
+        }
+        _ => {
+            if chance(&mut tc, 50) {
+                &int
+            } else {
+                &float
+            }
+        }
+    };
+    let r = catch_unwind(AssertUnwindSafe(|| vsprintf(&spec, &[arg])));
+    assert!(matches!(r, Ok(Err(PrintfError::WrongType))), "vsprintf({:?}, wrong type) = {:?}", spec, r.ok());
+}
+
+/// sprintf/1: `%g` of zero does not panic and matches glibc.
+#[hegel::test]
+fn g_of_zero_matches_libc(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['g', 'G']);
+    let mut spec = arb_layout(&mut tc, conv, Some((0, 12)), true);
+    spec.alt = false;
+    let v = if chance(&mut tc, 30) { -0.0 } else { 0.0 };
+    check(&spec.render(), &spec.stars(), &CArg::F(v));
+}
+
+/// sprintf/2: `%e` of zero is `0.000000e+00`.
+#[hegel::test]
+fn e_of_zero_matches_libc(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['e', 'E']);
+    let mut spec = arb_layout(&mut tc, conv, Some((0, 12)), true);
+    spec.alt = false;
+    let v = if chance(&mut tc, 30) { -0.0 } else { 0.0 };
+    check(&spec.render(), &spec.stars(), &CArg::F(v));
+}
+
+/// sprintf/3: `%g` removes the decimal point along with the trailing zeros.
+#[hegel::test]
+fn g_strips_the_decimal_point_with_the_zeros(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['g', 'G']);
+    let mut spec = arb_layout(&mut tc, conv, Some((1, 12)), true);
+    spec.alt = false;
+    let p = spec.star_precision.or(spec.precision).unwrap_or(6) as i64;
+    // An integer with fewer digits than the precision, or a power of ten.
+    let v = if chance(&mut tc, 50) {
+        n(&mut tc, 1, 10i64.pow(p.min(9) as u32) - 1) as f64
+    } else {
+        10f64.powi(n(&mut tc, -12, 30) as i32)
+    };
+    let v = if chance(&mut tc, 30) { -v } else { v };
+    check(&spec.render(), &spec.stars(), &CArg::F(v));
+}
+
+/// sprintf/4: an exact decimal tie rounds like glibc (to even).
+#[hegel::test]
+fn ties_round_like_libc(mut tc: TestCase) {
+    let j = n(&mut tc, 1, 6) as u32;
+    let odd = 2 * n(&mut tc, 0, 1 << 20) + 1;
+    let v = n(&mut tc, 0, 1 << 30) as f64 + odd as f64 / (1u64 << j) as f64; // exactly j decimals, the last a 5
+    let v = if chance(&mut tc, 30) { -v } else { v };
+    let conv = pick(&mut tc, &['f', 'F']);
+    let mut spec = arb_layout(&mut tc, conv, None, true);
+    spec.alt = false;
+    spec.precision = Some(j as i32 - 1);
+    check(&spec.render(), &spec.stars(), &CArg::F(v));
+}
+
+/// sprintf/5: `%.0e` of a value that rounds up to the next power of ten carries into the
+/// exponent (`1e+01`, not `10e+00`).
+#[hegel::test]
+fn zero_precision_e_carries_into_the_exponent(mut tc: TestCase) {
+    let mantissa = n(&mut tc, 9_500_001, 9_999_999) as f64 / 1_000_000.0;
+    let v = mantissa * 10f64.powi(n(&mut tc, -10, 10) as i32);
+    let conv = pick(&mut tc, &['e', 'E']);
+    let mut spec = arb_layout(&mut tc, conv, None, true);
+    spec.alt = false;
+    spec.precision = Some(0);
+    check(&spec.render(), &spec.stars(), &CArg::F(v));
+}
+
+/// sprintf/6: the digits are those of the exact binary value: 16 to 25 requested digits, and
+/// `%.0f` of an integer part above 2^53.
+#[hegel::test]
+fn float_digits_are_exact(mut tc: TestCase) {
+    let (v, spec) = if chance(&mut tc, 30) {
+        let v = n(&mut tc, 1, 999_999) as f64 * 10f64.powi(n(&mut tc, 16, 30) as i32);
+        let mut spec = arb_layout(&mut tc, 'f', None, true);
+        spec.alt = false;
+        spec.precision = Some(0);
+        (v, spec)
+    } else {
+        let conv = pick(&mut tc, &['f', 'e', 'g']);
+        let (mag, _, _) = arb_short_float(&mut tc, -6, 3);
+        let v = mag + n(&mut tc, 1, 999) as f64 / 7.0e6; // a fraction with a long expansion
+        let mut spec = arb_layout(&mut tc, conv, None, true);
+        spec.alt = false;
+        spec.precision = Some(n(&mut tc, 16, 25) as i32);
+        (v, spec)
+    };
+    let v = if chance(&mut tc, 30) { -v } else { v };
+    check(&spec.render(), &spec.stars(), &CArg::F(v));
+}
+
+/// sprintf/7: subnormals below 1e-323 print their digits, not `inf`.
+#[hegel::test]
+fn subnormals_format(mut tc: TestCase) {
+    let v = f64::from_bits(n(&mut tc, 1, 2000) as u64);
+    let conv = pick(&mut tc, &['e', 'E', 'g']);
+    let mut spec = arb_layout(&mut tc, conv, Some((0, 12)), true);
+    spec.alt = false;
+    check(&spec.render(), &spec.stars(), &CArg::F(v));
+}
+
+/// sprintf/8: a precision on an integer conversion is the minimum number of digits.
+#[hegel::test]
+fn integer_precision_is_a_minimum_digit_count(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['d', 'i', 'u', 'x', 'X', 'o']);
+    let mut spec = arb_layout(&mut tc, conv, Some((0, 20)), true);
+    spec.length = "ll";
+    if spec.precision.is_none() && spec.star_precision.is_none() {
+        spec.precision = Some(n(&mut tc, 0, 20) as i32);
+    }
+    let arg = if conv == 'd' || conv == 'i' { CArg::I(n(&mut tc, -1_000_000, 1_000_000)) } else { CArg::U(n(&mut tc, 1, 1_000_000) as u64) };
+    check(&spec.render(), &spec.stars(), &arg);
+}
+
+/// sprintf/9: `i64::MIN` formats (no overflow on the absolute value).
+#[hegel::test]
+fn i64_min_formats(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['d', 'i']);
+    let mut spec = arb_layout(&mut tc, conv, None, true);
+    spec.length = "ll";
+    check(&spec.render(), &spec.stars(), &CArg::I(i64::MIN));
+}
+
+/// sprintf/10: the alternate form of zero has no `0x`/`0` prefix.
+#[hegel::test]
+fn alternate_form_of_zero_has_no_prefix(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['x', 'X', 'o']);
+    let mut spec = arb_layout(&mut tc, conv, None, true);
+    spec.alt = true;
+    spec.length = "ll";
+    check(&spec.render(), &spec.stars(), &CArg::U(0));
+}
+
+/// sprintf/11: `#` on a float keeps the decimal point and, for `%g`, the trailing zeros.
+#[hegel::test]
+fn alternate_form_applies_to_floats(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['f', 'e', 'g', 'G']);
+    let mut spec = arb_layout(&mut tc, conv, None, true);
+    spec.alt = true;
+    spec.precision = Some(if conv == 'g' || conv == 'G' { n(&mut tc, 1, 8) } else { 0 } as i32);
+    let v = n(&mut tc, 1, 999) as f64 / if chance(&mut tc, 50) { 1.0 } else { 8.0 };
+    check(&spec.render(), &spec.stars(), &CArg::F(v));
+}
+
+/// sprintf/12: `%u` is unsigned: a negative prints its reinterpretation and `+`/space do
+/// nothing, as in C.
+#[hegel::test]
+fn u_is_unsigned(mut tc: TestCase) {
+    let mut spec = arb_layout(&mut tc, 'u', None, true);
+    let arg = match n(&mut tc, 0, 2) {
+        0 => {
+            spec.length = "ll";
+            CArg::I(n(&mut tc, i64::MIN + 1, -1))
+        }
+        1 => CArg::I32(n(&mut tc, i32::MIN as i64, -1) as i32),
+        _ => {
+            spec.plus = true;
+            CArg::I32(n(&mut tc, 0, i32::MAX as i64) as i32)
+        }
+    };
+    check(&spec.render(), &spec.stars(), &arg);
+}
+
+/// sprintf/13: a negative `*` width means left adjustment with the absolute width.
+#[hegel::test]
+fn negative_star_width_means_left_adjustment(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['d', 'f', 's']);
+    let mut spec = arb_layout(&mut tc, conv, Some((0, 6)), true);
+    spec.zero = false;
+    spec.left = false;
+    spec.alt = false;
+    spec.length = if conv == 'd' { "ll" } else { "" };
+    spec.width = None;
+    spec.star_width = Some(-(n(&mut tc, 1, 30) as i32));
+    let arg = match conv {
+        'd' => CArg::I(n(&mut tc, -1000, 1000)),
+        'f' => CArg::F(n(&mut tc, 1, 999_999) as f64 / 1000.0),
+        _ => CArg::S(arb_ascii_string(&mut tc)),
+    };
+    check(&spec.render(), &spec.stars(), &arg);
+}
+
+/// sprintf/16: `.*` takes the precision from the argument list (`%.*f` with 2 and 3.14159 is
+/// `3.14`), instead of the default precision with the argument left over.
+#[hegel::test]
+fn precision_from_argument_is_consumed(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['f', 'e', 's']);
+    let mut spec = arb_layout(&mut tc, conv, None, true);
+    spec.alt = false;
+    spec.space = spec.space && !spec.plus;
+    spec.star_precision = Some(n(&mut tc, 0, 10) as i32);
+    let arg = if conv == 's' { CArg::S(arb_ascii_string(&mut tc)) } else { CArg::F(n(&mut tc, 1, 999_999) as f64 / 1000.0 + 0.0001) };
+    check(&spec.render(), &spec.stars(), &arg);
+}
+
+/// sprintf/14: a width or precision too large for an `i32` in the format string is a
+/// `ParseError`, not a panic.
+#[hegel::test]
+fn huge_widths_are_parse_errors(mut tc: TestCase) {
+    let digits = n(&mut tc, 11, 30);
+    let number: String = (0..digits).map(|i| if i == 0 { pick(&mut tc, &['1', '5', '9']) } else { n(&mut tc, 0, 9).to_string().chars().next().unwrap() }).collect();
+    let fmt = if chance(&mut tc, 50) { format!("%{}d", number) } else { format!("%.{}f", number) };
+    let r = catch_unwind(AssertUnwindSafe(|| parse_format_string(&fmt).map(|_| ())));
+    assert!(matches!(r, Ok(Err(PrintfError::ParseError))), "parse_format_string({:?}) = {:?}", fmt, r.ok());
+}
+
+/// sprintf/15: `+` overrides the space flag for floats as it does for integers and in C.
+#[hegel::test]
+fn plus_overrides_space_for_floats(mut tc: TestCase) {
+    let conv = pick(&mut tc, &['f', 'e', 'g', 'F', 'E', 'G']);
+    let mut spec = arb_layout(&mut tc, conv, Some((1, 6)), true);
+    spec.alt = false;
+    spec.space = true;
+    spec.plus = true;
+    let (mag, _, _) = arb_short_float(&mut tc, -3, 3);
+    let v = pick(&mut tc, &[mag, f64::INFINITY, f64::NAN]);
+    check(&spec.render(), &spec.stars(), &CArg::F(v));
+}
+
+/// The crate's documented examples, as a guard on the harness itself.
+#[test]
+fn doc_examples() {
+    assert_eq!(sprintf!("%d + %d = %d\n", 3, 9, 3 + 9).unwrap(), "3 + 9 = 12\n");
+    let nn = 16;
+    let args: Vec<&dyn Printf> = vec![&nn];
+    assert_eq!(vsprintf("%#06x", &args).unwrap(), "0x0010");
+    assert_eq!(sprintf!("%s = %*d", "forty-two", 4, 42).unwrap(), "forty-two =   42");
+    assert_eq!(libc_format("%#06x", &[], &CArg::I32(16)), "0x0010");
+    assert_eq!(libc_format("%*.*lld|", &[7, 3], &CArg::I(42)), "    042|");
+    assert_eq!(libc_format("%-*s|", &[4], &CArg::S("ab".into())), "ab  |");
+}
