 use rand::Rng;
 
 mod common;
@@ -425,3 +426,122 @@ fn fix_crlf_4() {
 
     assert_eq!(r, "\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n");
 }
+
+/// Stateful model test: a `Rope` undergoing arbitrary edit sequences must
+/// stay in sync with a plain `String` (the model), and all byte/line index
+/// conversions must agree with reference implementations computed from the
+/// model. This mirrors the crate's own fuzz target
+/// (`fuzz/fuzz_targets/editing.rs`), which checks a `Rope` against a
+/// `String` after every edit.
+struct RopeVsString {
+    rope: Rope,
+    model: String,
+}
+
+#[hegel::state_machine]
+impl RopeVsString {
+    #[rule]
+    fn insert(&mut self, tc: hegel::TestCase) {
+        let offset = common::draw_char_boundary(&tc, &self.model);
+        let text = tc.draw(common::text_with_line_breaks());
+        self.rope.insert(offset, &text);
+        self.model.insert_str(offset, &text);
+    }
+
+    #[rule]
+    fn delete(&mut self, tc: hegel::TestCase) {
+        let (start, end) = common::draw_char_range(&tc, &self.model);
+        self.rope.delete(start..end);
+        self.model.replace_range(start..end, "");
+    }
+
+    #[rule]
+    fn replace(&mut self, tc: hegel::TestCase) {
+        let (start, end) = common::draw_char_range(&tc, &self.model);
+        let text = tc.draw(common::text_with_line_breaks());
+        self.rope.replace(start..end, &text);
+        self.model.replace_range(start..end, &text);
+    }
+
+    #[rule]
+    fn check_byte(&mut self, tc: hegel::TestCase) {
+        tc.assume(!self.model.is_empty());
+        let index = tc.draw(
+            generators::integers::<usize>().max_value(self.model.len() - 1),
+        );
+        assert_eq!(self.rope.byte(index), self.model.as_bytes()[index]);
+    }
+
+    #[rule]
+    fn check_is_char_boundary(&mut self, tc: hegel::TestCase) {
+        let offset = tc
+            .draw(generators::integers::<usize>().max_value(self.model.len()));
+        assert_eq!(
+            self.rope.is_char_boundary(offset),
+            self.model.is_char_boundary(offset),
+        );
+    }
+
+    #[rule]
+    fn check_line_of_byte(&mut self, tc: hegel::TestCase) {
+        // Only char-boundary offsets are drawn here: `line_of_byte()` panics
+        // on non-boundary offsets even though its docs only document the
+        // out-of-bounds panic. That doc/behavior mismatch is pinned by the
+        // (failing) `line_of_byte_documented_panics` test in
+        // `tests/rope_indexing.rs`; constraining this rule lets the model
+        // test keep hunting for deeper bugs.
+        let offset = common::draw_char_boundary(&tc, &self.model);
+        let expected = self.model.as_bytes()[..offset]
+            .iter()
+            .filter(|&&byte| byte == b'\n')
+            .count();
+        assert_eq!(self.rope.line_of_byte(offset), expected);
+    }
+
+    #[rule]
+    fn check_byte_of_line(&mut self, tc: hegel::TestCase) {
+        let line_len = self.model.lines().count();
+        let line_offset =
+            tc.draw(generators::integers::<usize>().max_value(line_len));
+        assert_eq!(
+            self.rope.byte_of_line(line_offset),
+            common::str_byte_of_line(&self.model, line_offset),
+        );
+    }
+
+    #[rule]
+    fn check_line(&mut self, tc: hegel::TestCase) {
+        let line_len = self.model.lines().count();
+        tc.assume(line_len > 0);
+        let line_index = tc
+            .draw(generators::integers::<usize>().max_value(line_len - 1));
+        assert_eq!(
+            self.rope.line(line_index),
+            self.model.lines().nth(line_index).unwrap(),
+        );
+    }
+
+    #[rule]
+    fn check_byte_slice(&mut self, tc: hegel::TestCase) {
+        let (start, end) = common::draw_char_range(&tc, &self.model);
+        let slice = self.rope.byte_slice(start..end);
+        slice.assert_invariants();
+        assert_eq!(slice, &self.model[start..end]);
+    }
+
+    #[invariant]
+    fn agrees_with_model(&self, _: hegel::TestCase) {
+        self.rope.assert_invariants();
+        assert_eq!(self.rope.byte_len(), self.model.len());
+        assert_eq!(self.rope, self.model.as_str());
+        assert_eq!(self.rope.line_len(), self.model.lines().count());
+    }
+}
+
+#[hegel::test]
+fn rope_edits_match_string_model(tc: hegel::TestCase) {
+    let start = tc.draw(common::rope_text());
+    let machine =
+        RopeVsString { rope: Rope::from(start.as_str()), model: start };
+    hegel::stateful::machine(machine).run(tc);
+}
