+/// Generates a fragment to feed to `RopeBuilder::append()`. CR/LF-only
+/// fragments are boosted because a CRLF pair straddling two `append()`
+/// calls is the interesting case (see `builder_crlf_0`).
+#[hegel::composite]
+fn fragment(tc: &hegel::TestCase) -> String {
+    tc.draw(hegel::one_of!(
+        common::text_with_line_breaks(),
+        generators::sampled_from(
+            ["\r", "\n", "\r\n", "a\r", "\nb"]
+                .iter()
+                .map(|s| s.to_string())
+                .collect::<Vec<_>>(),
+        ),
+    ))
+}
+
+/// A `Rope` built by appending arbitrary fragments equals both the
+/// concatenated `String` and the `Rope` created directly from it.
+#[hegel::test]
+fn builder_matches_appended_text(tc: hegel::TestCase) {
+    let fragments: Vec<String> = tc.draw(generators::vecs(fragment()));
+
+    let mut builder = RopeBuilder::new();
+    let mut model = String::new();
+
+    for fragment in &fragments {
+        builder.append(fragment);
+        model.push_str(fragment);
+    }
+
+    let rope = builder.build();
+    rope.assert_invariants();
+
+    assert_eq!(rope, model.as_str());
+    assert_eq!(rope, Rope::from(model.as_str()));
+    assert_eq!(rope.line_len(), model.lines().count());
+}
+
+/// `String` -> `Rope` -> `String` is the identity, for the full Unicode
+/// domain.
+#[hegel::test]
+fn rope_from_str_to_string_roundtrip(tc: hegel::TestCase) {
+    let s = tc.draw(common::rope_text());
+    let r = Rope::from(s.as_str());
+    r.assert_invariants();
+    assert_eq!(r.to_string(), s);
+}
