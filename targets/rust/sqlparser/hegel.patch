diff --git a/src/tokenizer.rs b/src/tokenizer.rs
index 36a3abf..9c8e695 100644
--- a/src/tokenizer.rs
+++ b/src/tokenizer.rs
@@ -4552,4 +4552,150 @@ mod tests {
             ],
         );
     }
+
+    /// Property-based tests written with hegel (https://hegel.dev).
+    /// One property per test; see each test's doc comment for the evidence
+    /// the property is grounded in.
+    mod hegel_properties {
+        use super::*;
+        use hegel::generators::{self, Generator};
+
+        /// Arbitrary text mixed with SQL-ish fragments, to reach deeper
+        /// tokenizer states (quotes, comments, dollar-quoting, escapes)
+        /// than plain random text.
+        #[hegel::composite]
+        fn hostile_input(tc: &hegel::TestCase) -> String {
+            let n = tc.draw(generators::integers::<usize>().max_value(30));
+            let mut out = String::new();
+            for _ in 0..n {
+                let chunk: String = tc.draw(hegel::one_of!(
+                    generators::sampled_from(vec![
+                        "SELECT", "'", "''", "\"", "`", "[", "]", "--", "/*", "*/", "\\",
+                        "$$", "$tag$", "E'", "N'", "B'", "X'", "U&'", "0x", "1e", ".5",
+                        "1.5e-", "$", "@", "#", "->>", "::", "\n", "\r\n", "\t",
+                    ])
+                    .map(|s| s.to_string()),
+                    generators::text().max_size(6),
+                ));
+                out.push_str(&chunk);
+                if tc.draw(generators::booleans()) {
+                    out.push(' ');
+                }
+            }
+            out
+        }
+
+        /// Property: the tokenizer returns `Ok` or `Err` but never panics,
+        /// for any input, any dialect, and either unescape setting.
+        ///
+        /// Evidence: `tokenize` returns `Result<_, TokenizerError>` and the
+        /// crate's fuzz target feeds arbitrary strings through the parser
+        /// (which starts with the tokenizer) for every dialect.
+        #[hegel::test(test_cases = 300)]
+        fn hegel_tokenizer_never_panics(tc: hegel::TestCase) {
+            let input = tc.draw(hostile_input());
+            let unescape = tc.draw(generators::booleans());
+            let dialects: Vec<Box<dyn Dialect>> = vec![
+                Box::new(GenericDialect {}),
+                Box::new(BigQueryDialect {}),
+                Box::new(ClickHouseDialect {}),
+                Box::new(HiveDialect {}),
+                Box::new(MsSqlDialect {}),
+                Box::new(MySqlDialect {}),
+                Box::new(PostgreSqlDialect {}),
+                Box::new(SQLiteDialect {}),
+                Box::new(SnowflakeDialect {}),
+            ];
+            for dialect in &dialects {
+                let _ = Tokenizer::new(dialect.as_ref(), &input)
+                    .with_unescape(unescape)
+                    .tokenize_with_location();
+            }
+        }
+
+        /// Property: token spans are internally ordered (`start <= end`) and
+        /// consecutive tokens do not overlap and appear in source order.
+        ///
+        /// Evidence: `Span` is documented as "a linear portion of the input
+        /// string (start, end)" and `tokenize_with_location` is documented
+        /// to attach the location of each token in the input string.
+        #[hegel::test(test_cases = 300)]
+        fn hegel_token_spans_are_ordered_and_nonoverlapping(tc: hegel::TestCase) {
+            let input = tc.draw(hostile_input());
+            let dialect = GenericDialect {};
+            let Ok(tokens) = Tokenizer::new(&dialect, &input).tokenize_with_location() else {
+                tc.reject();
+            };
+            let mut prev_end: Option<Location> = None;
+            for t in &tokens {
+                assert!(
+                    t.span.start <= t.span.end,
+                    "token {t:?} has start > end (input: {input:?})"
+                );
+                if let Some(prev_end) = prev_end {
+                    assert!(
+                        prev_end <= t.span.start,
+                        "token {t:?} overlaps previous token ending at {prev_end:?} (input: {input:?})"
+                    );
+                }
+                prev_end = Some(t.span.end);
+            }
+        }
+
+        /// A `Span` whose start does not exceed its end, as produced by the
+        /// tokenizer. Coordinates are drawn from a small range (so overlaps
+        /// and ties actually occur) or the full `u64` range, and the
+        /// documented "unknown location" span (0,0)-(0,0) is generated too.
+        #[hegel::composite]
+        fn spans(tc: &hegel::TestCase) -> Span {
+            if tc.draw(generators::booleans()) {
+                return Span::empty();
+            }
+            let draw_coord = || {
+                tc.draw(hegel::one_of!(
+                    generators::integers::<u64>().max_value(3),
+                    generators::integers::<u64>(),
+                ))
+            };
+            let a = Location::new(draw_coord(), draw_coord());
+            let b = Location::new(draw_coord(), draw_coord());
+            if a <= b {
+                Span::new(a, b)
+            } else {
+                Span::new(b, a)
+            }
+        }
+
+        /// Property: `Span::union` is commutative.
+        ///
+        /// Evidence: `union` is documented as "the smallest Span that
+        /// contains both `self` and `other`", which is a symmetric
+        /// specification, and the empty-span rule ("If either span is
+        /// `Span::empty`, the other span is returned") is symmetric too.
+        #[hegel::test]
+        fn hegel_span_union_commutes(tc: hegel::TestCase) {
+            let a = tc.draw((spans()).print_as_debug());
+            let b = tc.draw((spans()).print_as_debug());
+            assert_eq!(a.union(&b), b.union(&a));
+        }
+
+        /// Property: for non-empty spans, `Span::union` contains both of its
+        /// operands.
+        ///
+        /// Evidence: `union` docs — "Returns the smallest Span that contains
+        /// both `self` and `other`".
+        #[hegel::test]
+        fn hegel_span_union_contains_operands(tc: hegel::TestCase) {
+            let a = tc.draw((spans()).print_as_debug());
+            let b = tc.draw((spans()).print_as_debug());
+            tc.assume(a != Span::empty() && b != Span::empty());
+            let u = a.union(&b);
+            for operand in [&a, &b] {
+                assert!(
+                    u.start <= operand.start && u.end >= operand.end,
+                    "union {u:?} of {a:?} and {b:?} does not contain {operand:?}"
+                );
+            }
+        }
+    }
 }
diff --git a/tests/sqlparser_common.rs b/tests/sqlparser_common.rs
index 2de6062..dd848e5 100644
--- a/tests/sqlparser_common.rs
+++ b/tests/sqlparser_common.rs
@@ -20060,3 +20060,554 @@ fn parse_insert_by_name() {
         _ => unreachable!(),
     }
 }
+
+/// Property-based tests written with hegel (https://hegel.dev).
+///
+/// Each test checks a single property of the parser that is grounded in the
+/// crate's documentation (`src/lib.rs` "Creating SQL text from AST" and
+/// "Pretty Printing"), the project's own fuzz target
+/// (`fuzz/fuzz_targets/fuzz_parse_sql.rs`), or the `verified_stmt` /
+/// `statements_parse_to` helpers in `src/test_utils.rs`, which encode the
+/// display/reparse round-trip contract for hand-picked examples.
+mod hegel_properties {
+    use super::*;
+    use hegel::compose;
+    use hegel::generators::{self, Generator};
+    // Explicit import to disambiguate from the std prelude (the outer file
+    // glob-imports `pretty_assertions::assert_eq`, which does not reach
+    // through `use super::*` unambiguously).
+    use pretty_assertions::assert_eq;
+    use sqlparser::dialect::{SparkSqlDialect, TeradataDialect};
+    use sqlparser::tokenizer::Token;
+
+    static GENERIC: GenericDialect = GenericDialect {};
+
+    /// The same dialect list the crate's fuzz target exercises (plus the
+    /// dialects added since the fuzz target was written).
+    fn all_dialect_impls() -> Vec<Box<dyn Dialect>> {
+        vec![
+            Box::new(AnsiDialect {}),
+            Box::new(BigQueryDialect {}),
+            Box::new(ClickHouseDialect {}),
+            Box::new(DatabricksDialect {}),
+            Box::new(DuckDbDialect {}),
+            Box::new(GenericDialect {}),
+            Box::new(HiveDialect {}),
+            Box::new(MsSqlDialect {}),
+            Box::new(MySqlDialect {}),
+            Box::new(OracleDialect {}),
+            Box::new(PostgreSqlDialect {}),
+            Box::new(RedshiftSqlDialect {}),
+            Box::new(SQLiteDialect {}),
+            Box::new(SnowflakeDialect {}),
+            Box::new(SparkSqlDialect {}),
+            Box::new(TeradataDialect {}),
+        ]
+    }
+
+    /// A lowercase identifier that is guaranteed not to collide with any SQL
+    /// keyword (keywords contain no digits, so appending `_1` is safe).
+    #[hegel::composite]
+    fn ident_name(tc: &hegel::TestCase) -> String {
+        let s: String = tc.draw(generators::from_regex(r"[a-z][a-z0-9_]{0,9}").fullmatch(true));
+        if ALL_KEYWORDS.contains(&s.to_uppercase().as_str()) {
+            format!("{s}_1")
+        } else {
+            s
+        }
+    }
+
+    /// A syntactically valid SQL scalar expression, as a string.
+    ///
+    /// Unary operator applications parenthesize their operand so that the
+    /// *generated text* can never accidentally contain `--` (a line comment);
+    /// what the parser's own Display does with nested negation is exactly
+    /// what the round-trip properties are checking.
+    // A recursive generator cannot be written with `#[hegel::composite]`
+    // (the opaque return type would refer to itself), so this returns a
+    // `BoxedGenerator` and recurses through the box.
+    fn sql_expr_string(depth: u32) -> generators::BoxedGenerator<'static, String> {
+        compose!(|tc| {
+        let max_choice: u32 = if depth == 0 { 2 } else { 4 };
+        match tc.draw(generators::integers::<u32>().max_value(max_choice)) {
+            0 => tc.draw(generators::integers::<u64>()).to_string(),
+            1 => {
+                let s: String = tc.draw(generators::text().max_size(8));
+                // Keep the literal's *content* inside the domain that the
+                // Display side documents as round-trippable (see
+                // strip_preescaped_sequences).
+                let s = strip_preescaped_sequences(&s, '\'');
+                format!("'{}'", s.replace('\'', "''"))
+            }
+            2 => tc.draw(ident_name()),
+            3 => {
+                let op = tc.draw(generators::sampled_from(vec![
+                    "+", "-", "*", "/", "%", "=", "<>", "<", ">", "<=", ">=", "AND", "OR",
+                ]));
+                let l = tc.draw(sql_expr_string(depth - 1));
+                let r = tc.draw(sql_expr_string(depth - 1));
+                format!("({l} {op} {r})")
+            }
+            _ => {
+                let op = tc.draw(generators::sampled_from(vec!["NOT", "-", "+"]));
+                let e = tc.draw(sql_expr_string(depth - 1));
+                format!("{op} ({e})")
+            }
+        }
+        })
+        .boxed()
+    }
+
+    /// A syntactically valid SELECT statement, as a string.
+    fn sql_select_string(depth: u32) -> generators::BoxedGenerator<'static, String> {
+        compose!(|tc| {
+        let nproj = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+        let mut projs = Vec::new();
+        for _ in 0..nproj {
+            let e = tc.draw(sql_expr_string(2));
+            if tc.draw(generators::booleans()) {
+                let alias = tc.draw(ident_name());
+                projs.push(format!("{e} AS {alias}"));
+            } else {
+                projs.push(e);
+            }
+        }
+        let mut sql = format!("SELECT {}", projs.join(", "));
+        if tc.draw(generators::booleans()) {
+            let table_src = if depth > 0 && tc.draw(generators::booleans()) {
+                let sub = tc.draw(sql_select_string(depth - 1));
+                let alias = tc.draw(ident_name());
+                format!("({sub}) AS {alias}")
+            } else {
+                tc.draw(ident_name())
+            };
+            sql.push_str(&format!(" FROM {table_src}"));
+            if tc.draw(generators::booleans()) {
+                sql.push_str(&format!(" WHERE {}", tc.draw(sql_expr_string(2))));
+            }
+        }
+        if tc.draw(generators::booleans()) {
+            sql.push_str(&format!(" ORDER BY {}", tc.draw(sql_expr_string(1))));
+        }
+        if tc.draw(generators::booleans()) {
+            sql.push_str(&format!(" LIMIT {}", tc.draw(generators::integers::<u64>())));
+        }
+        sql
+        })
+        .boxed()
+    }
+
+    /// A syntactically valid SQL statement (SELECT / INSERT / UPDATE /
+    /// DELETE), as a string.
+    #[hegel::composite]
+    fn sql_statement_string(tc: &hegel::TestCase) -> String {
+        match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => tc.draw(sql_select_string(2)),
+            1 => {
+                let table = tc.draw(ident_name());
+                let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+                let mut cols = Vec::new();
+                let mut vals = Vec::new();
+                for _ in 0..n {
+                    cols.push(tc.draw(ident_name()));
+                    vals.push(tc.draw(sql_expr_string(1)));
+                }
+                format!(
+                    "INSERT INTO {table} ({}) VALUES ({})",
+                    cols.join(", "),
+                    vals.join(", ")
+                )
+            }
+            2 => {
+                let table = tc.draw(ident_name());
+                let col = tc.draw(ident_name());
+                let val = tc.draw(sql_expr_string(1));
+                let mut sql = format!("UPDATE {table} SET {col} = {val}");
+                if tc.draw(generators::booleans()) {
+                    sql.push_str(&format!(" WHERE {}", tc.draw(sql_expr_string(2))));
+                }
+                sql
+            }
+            _ => {
+                let table = tc.draw(ident_name());
+                let mut sql = format!("DELETE FROM {table}");
+                if tc.draw(generators::booleans()) {
+                    sql.push_str(&format!(" WHERE {}", tc.draw(sql_expr_string(2))));
+                }
+                sql
+            }
+        }
+    }
+
+    /// Arbitrary "SQL soup": SQL-ish fragments and arbitrary text glued
+    /// together. Reaches much deeper into the parser than plain random text.
+    #[hegel::composite]
+    fn sql_soup(tc: &hegel::TestCase) -> String {
+        let n = tc.draw(generators::integers::<usize>().max_value(40));
+        let mut out = String::new();
+        for _ in 0..n {
+            let chunk: String = tc.draw(hegel::one_of!(
+                generators::sampled_from(vec![
+                    "SELECT", "FROM", "WHERE", "GROUP", "BY", "ORDER", "LIMIT", "INSERT",
+                    "INTO", "VALUES", "UPDATE", "SET", "DELETE", "CREATE", "TABLE", "JOIN",
+                    "ON", "AS", "AND", "OR", "NOT", "CAST", "CASE", "WHEN", "THEN", "ELSE",
+                    "END", "INTERVAL", "(", ")", ",", ";", ".", "*", "-", "+", "/", "%",
+                    "=", "<>", "<=", ">=", "||", "::", "?", "$1", "'", "\"", "`", "[", "]",
+                    "'a'", "\"b\"", "`c`", "0", "1", "1.5", ".5", "1e10", "0x1F", "E'x'",
+                    "N'x'", "B'01'", "X'ff'", "U&'x'", "$$x$$", "$tag$", "--", "/*", "*/",
+                    "\\",
+                ])
+                .map(|s| s.to_string()),
+                generators::text().max_size(6),
+            ));
+            out.push_str(&chunk);
+            if tc.draw(generators::booleans()) {
+                out.push(' ');
+            }
+        }
+        out
+    }
+
+    /// An input for robustness tests: either completely arbitrary text or
+    /// SQL soup.
+    #[hegel::composite]
+    fn hostile_input(tc: &hegel::TestCase) -> String {
+        tc.draw(hegel::one_of!(
+            generators::text().max_size(60).boxed(),
+            sql_soup().boxed(),
+        ))
+    }
+
+    /// Property: `Parser::parse_sql` returns `Ok` or `Err` but never panics,
+    /// for any input and any dialect.
+    ///
+    /// Evidence: this is exactly the property the crate's own fuzz target
+    /// (`fuzz/fuzz_targets/fuzz_parse_sql.rs`) checks.
+    #[hegel::test(test_cases = 300)]
+    fn hegel_parse_never_panics_on_arbitrary_input(tc: hegel::TestCase) {
+        let input = tc.draw(hostile_input());
+        for dialect in all_dialect_impls() {
+            let _ = Parser::parse_sql(dialect.as_ref(), &input);
+        }
+    }
+
+    /// Property: for any parseable statement, serializing the AST with
+    /// `Display` and reparsing yields the same AST.
+    ///
+    /// Evidence: `src/lib.rs` ("The original SQL text can be generated from
+    /// the AST") and `TestedDialects::one_statement_parses_to` in
+    /// `src/test_utils.rs`, which asserts this for every `verified_stmt`
+    /// call in the test suite.
+    #[hegel::test(test_cases = 500)]
+    fn hegel_parse_display_reparse_is_identity(tc: hegel::TestCase) {
+        let sql = tc.draw(sql_statement_string());
+        let stmts = Parser::parse_sql(&GENERIC, &sql)
+            .unwrap_or_else(|e| panic!("generated SQL {sql:?} failed to parse: {e}"));
+        assert_eq!(stmts.len(), 1, "generated SQL {sql:?} parsed to {stmts:?}");
+        let displayed = stmts[0].to_string();
+        let reparsed = Parser::parse_sql(&GENERIC, &displayed).unwrap_or_else(|e| {
+            panic!("display output {displayed:?} of {sql:?} failed to reparse: {e}")
+        });
+        assert_eq!(
+            stmts, reparsed,
+            "AST changed after display/reparse round-trip: input {sql:?}, displayed {displayed:?}"
+        );
+    }
+
+    /// Property: pretty-printed SQL (`{:#}`) parses back to the same AST as
+    /// the compact form.
+    ///
+    /// Evidence: `src/lib.rs` "Pretty Printing" section and
+    /// `tests/pretty_print.rs` (pretty output is shown as real SQL).
+    #[hegel::test(test_cases = 500)]
+    fn hegel_pretty_print_reparses_to_same_ast(tc: hegel::TestCase) {
+        let sql = tc.draw(sql_statement_string());
+        let stmts = Parser::parse_sql(&GENERIC, &sql)
+            .unwrap_or_else(|e| panic!("generated SQL {sql:?} failed to parse: {e}"));
+        let pretty = format!("{:#}", stmts[0]);
+        let reparsed = Parser::parse_sql(&GENERIC, &pretty).unwrap_or_else(|e| {
+            panic!("pretty output {pretty:?} of {sql:?} failed to reparse: {e}")
+        });
+        assert_eq!(reparsed.len(), 1);
+        assert_eq!(
+            stmts[0], reparsed[0],
+            "AST changed after pretty-print round-trip: input {sql:?}, pretty {pretty:?}"
+        );
+    }
+
+    /// Property: an integer literal round-trips through the parser with its
+    /// textual representation intact.
+    ///
+    /// Evidence: `Value::Number(String, bool)` stores the literal text
+    /// verbatim (src/ast/value.rs), so parsing `SELECT <n>` must preserve
+    /// `n.to_string()` exactly, for the full `u128` range.
+    #[hegel::test]
+    fn hegel_number_literal_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<u128>());
+        let sql = format!("SELECT {n}");
+        let stmts = Parser::parse_sql(&GENERIC, &sql).expect("integer literal must parse");
+        let query = match &stmts[0] {
+            Statement::Query(q) => q,
+            other => panic!("expected query, got {other:?}"),
+        };
+        let select = query.body.as_select().expect("expected SELECT");
+        match &select.projection[0] {
+            SelectItem::UnnamedExpr(Expr::Value(v)) => match &v.value {
+                Value::Number(repr, false) => assert_eq!(repr, &n.to_string()),
+                other => panic!("expected number, got {other:?}"),
+            },
+            other => panic!("expected unnamed expr, got {other:?}"),
+        }
+    }
+
+    /// Inserts `c` at a random char boundary of `value`.
+    ///
+    /// Used to boost boundary conjunctions: values containing the quote or
+    /// closing delimiter are exactly where escaping bugs live, and uniform
+    /// text generation rarely produces them together with the matching
+    /// dialect (see SKILL.md, "Boundary conjunctions need help").
+    fn insert_at_random_boundary(tc: &hegel::TestCase, value: &mut String, c: char) {
+        let boundaries: Vec<usize> = (0..=value.len())
+            .filter(|i| value.is_char_boundary(*i))
+            .collect();
+        let at = tc.draw(generators::sampled_from(boundaries));
+        value.insert(at, c);
+    }
+
+    /// Removes the two patterns that `EscapeQuotedString` (src/ast/value.rs)
+    /// deliberately does not round-trip: a doubled quote character and a
+    /// backslash followed by the quote character. Its Display impl documents
+    /// that such sequences are assumed to be *already escaped* and are
+    /// passed through verbatim (a trade-off to support the no-escape parser
+    /// mode), so AST values containing them are documented not to survive a
+    /// display/parse round-trip. This constraint encodes that documented
+    /// contract limit; it is not a convenience bound.
+    fn strip_preescaped_sequences(value: &str, quote: char) -> String {
+        let mut out = String::new();
+        for c in value.chars() {
+            if c == quote && matches!(out.chars().last(), Some(l) if l == quote || l == '\\') {
+                continue;
+            }
+            out.push(c);
+        }
+        out
+    }
+
+    /// Property: a quoted identifier constructed with `Ident::with_quote`
+    /// round-trips through Display + parse with its value and quote style
+    /// intact, for the quote styles that have an escape mechanism
+    /// (`"` and `` ` ``), over the domain `EscapeQuotedString` documents
+    /// as round-trippable.
+    ///
+    /// Evidence: `Ident::with_quote` documents valid quote characters,
+    /// `impl Display for Ident` escapes the quote character via
+    /// `escape_quoted_string` (src/ast/mod.rs), and the tokenizer folds
+    /// doubled quotes back.
+    #[hegel::test(test_cases = 500)]
+    fn hegel_quoted_identifier_roundtrip(tc: hegel::TestCase) {
+        let mut value: String = tc.draw(generators::text().min_size(1).max_size(20));
+        let (dialect, quote): (Box<dyn Dialect>, char) =
+            match tc.draw(generators::integers::<u8>().max_value(1)) {
+                0 => (Box::new(GenericDialect {}), '"'),
+                _ => (Box::new(MySqlDialect {}), '`'),
+            };
+        if tc.draw(generators::booleans()) {
+            insert_at_random_boundary(&tc, &mut value, quote);
+        }
+        let value = strip_preescaped_sequences(&value, quote);
+        tc.assume(!value.is_empty());
+        let ident = Ident::with_quote(quote, value.clone());
+        let sql = format!("SELECT {ident}");
+        let stmts = Parser::parse_sql(dialect.as_ref(), &sql)
+            .unwrap_or_else(|e| panic!("quoted identifier {sql:?} failed to parse: {e}"));
+        let query = match &stmts[0] {
+            Statement::Query(q) => q,
+            other => panic!("expected query, got {other:?}"),
+        };
+        let select = query.body.as_select().expect("expected SELECT");
+        match &select.projection[0] {
+            SelectItem::UnnamedExpr(Expr::Identifier(parsed)) => {
+                assert_eq!(parsed.value, value, "identifier value changed in {sql:?}");
+                assert_eq!(parsed.quote_style, Some(quote));
+            }
+            other => panic!("expected identifier, got {other:?} (sql: {sql:?})"),
+        }
+    }
+
+    /// Property: a bracket-quoted identifier (`Ident::with_quote('[', ..)`,
+    /// the MSSQL style) round-trips through Display + parse.
+    ///
+    /// Evidence: `Ident::with_quote` lists `[` as a valid quote character
+    /// and the crate documents that "the original SQL text can be generated
+    /// from the AST" (src/lib.rs).
+    ///
+    /// KNOWN FAILURE (suspected library bug, kept failing on purpose):
+    /// `impl Display for Ident` writes `[{value}]` without escaping `]`
+    /// (src/ast/mod.rs, `Some('[')` arm), so any value containing `]`
+    /// produces SQL that cannot be reparsed, e.g. value `]0` displays as
+    /// `SELECT []0]`. T-SQL escapes `]` by doubling it (QUOTENAME), and the
+    /// MsSql tokenizer has no `]]` unescaping either, so the round-trip is
+    /// broken in both directions.
+    #[hegel::test(test_cases = 500)]
+    fn hegel_bracket_quoted_identifier_roundtrip(tc: hegel::TestCase) {
+        let mut value: String = tc.draw(generators::text().min_size(1).max_size(20));
+        if tc.draw(generators::booleans()) {
+            insert_at_random_boundary(&tc, &mut value, ']');
+        }
+        let dialect = MsSqlDialect {};
+        let ident = Ident::with_quote('[', value.clone());
+        let sql = format!("SELECT {ident}");
+        let stmts = Parser::parse_sql(&dialect, &sql)
+            .unwrap_or_else(|e| panic!("quoted identifier {sql:?} failed to parse: {e}"));
+        let query = match &stmts[0] {
+            Statement::Query(q) => q,
+            other => panic!("expected query, got {other:?}"),
+        };
+        let select = query.body.as_select().expect("expected SELECT");
+        match &select.projection[0] {
+            SelectItem::UnnamedExpr(Expr::Identifier(parsed)) => {
+                assert_eq!(parsed.value, value, "identifier value changed in {sql:?}");
+                assert_eq!(parsed.quote_style, Some('['));
+            }
+            other => panic!("expected identifier, got {other:?} (sql: {sql:?})"),
+        }
+    }
+
+    /// Property: a single-quoted string literal round-trips through
+    /// Display + parse with its content intact (GenericDialect, which does
+    /// not treat backslash as an escape character), over the domain
+    /// `EscapeQuotedString` documents as round-trippable (see
+    /// `strip_preescaped_sequences`).
+    ///
+    /// Evidence: `Value::SingleQuotedString` Display escapes `'` by
+    /// doubling (src/ast/value.rs `escape_single_quote_string`) and the
+    /// tokenizer folds `''` back to `'`.
+    #[hegel::test(test_cases = 500)]
+    fn hegel_string_literal_roundtrip(tc: hegel::TestCase) {
+        let mut s: String = tc.draw(generators::text().max_size(30));
+        if tc.draw(generators::booleans()) {
+            insert_at_random_boundary(&tc, &mut s, '\'');
+        }
+        let s = strip_preescaped_sequences(&s, '\'');
+        let lit = Value::SingleQuotedString(s.clone());
+        let sql = format!("SELECT {lit}");
+        let stmts = Parser::parse_sql(&GENERIC, &sql)
+            .unwrap_or_else(|e| panic!("string literal {sql:?} failed to parse: {e}"));
+        let query = match &stmts[0] {
+            Statement::Query(q) => q,
+            other => panic!("expected query, got {other:?}"),
+        };
+        let select = query.body.as_select().expect("expected SELECT");
+        match &select.projection[0] {
+            SelectItem::UnnamedExpr(Expr::Value(v)) => match &v.value {
+                Value::SingleQuotedString(parsed) => {
+                    assert_eq!(parsed, &s, "string literal content changed in {sql:?}")
+                }
+                other => panic!("expected string, got {other:?} (sql: {sql:?})"),
+            },
+            other => panic!("expected unnamed expr, got {other:?} (sql: {sql:?})"),
+        }
+    }
+
+    /// Property: parsing `k` statements joined by `"; "` yields exactly the
+    /// concatenation of parsing each statement individually.
+    ///
+    /// Evidence: `Parser::parse_sql` docs ("Parse the specified tokens") and
+    /// `TestedDialects::statements_parse_to` in `src/test_utils.rs`, which
+    /// joins canonical statements with `"; "`.
+    #[hegel::test]
+    fn hegel_statement_sequences_parse_individually(tc: hegel::TestCase) {
+        let k = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+        let mut sqls = Vec::new();
+        for _ in 0..k {
+            sqls.push(tc.draw(sql_statement_string()));
+        }
+        let joined = sqls.join("; ");
+        let parsed = Parser::parse_sql(&GENERIC, &joined)
+            .unwrap_or_else(|e| panic!("joined statements {joined:?} failed to parse: {e}"));
+        let individually: Vec<Statement> = sqls
+            .iter()
+            .map(|s| {
+                let mut v = Parser::parse_sql(&GENERIC, s)
+                    .unwrap_or_else(|e| panic!("statement {s:?} failed to parse: {e}"));
+                assert_eq!(v.len(), 1);
+                v.pop().unwrap()
+            })
+            .collect();
+        assert_eq!(parsed, individually, "joined: {joined:?}");
+    }
+
+    /// Stateful model test for the parser's token navigation API
+    /// (`next_token` / `prev_token` / `peek_token` / `peek_nth_token`).
+    ///
+    /// The model is the tokenizer's own output with whitespace removed plus
+    /// a cursor; the parser documents that these methods return/skip
+    /// non-whitespace tokens and yield EOF past the end. `prev_token` is
+    /// only applied when at least one `next_token` is outstanding, matching
+    /// its documented precondition ("Must be called after `next_token()`,
+    /// otherwise might panic").
+    struct TokenCursor {
+        parser: Parser<'static>,
+        model: Vec<Token>,
+        cursor: usize,
+    }
+
+    #[hegel::state_machine]
+    impl TokenCursor {
+        #[rule]
+        fn next_token(&mut self, _tc: hegel::TestCase) {
+            let got = self.parser.next_token();
+            let expected = self.model.get(self.cursor).cloned().unwrap_or(Token::EOF);
+            assert_eq!(got.token, expected, "next_token at cursor {}", self.cursor);
+            self.cursor += 1;
+        }
+
+        #[rule]
+        fn prev_token(&mut self, tc: hegel::TestCase) {
+            tc.assume(self.cursor > 0);
+            self.parser.prev_token();
+            self.cursor -= 1;
+        }
+
+        #[rule]
+        fn peek_nth_token(&mut self, tc: hegel::TestCase) {
+            let n = tc.draw(generators::integers::<usize>().max_value(4));
+            let got = self.parser.peek_nth_token(n);
+            let expected = self
+                .model
+                .get(self.cursor + n)
+                .cloned()
+                .unwrap_or(Token::EOF);
+            assert_eq!(got.token, expected, "peek_nth_token({n}) at cursor {}", self.cursor);
+        }
+
+        #[invariant]
+        fn peek_matches_model(&self, _tc: hegel::TestCase) {
+            let got = self.parser.peek_token();
+            let expected = self.model.get(self.cursor).cloned().unwrap_or(Token::EOF);
+            assert_eq!(got.token, expected, "peek_token at cursor {}", self.cursor);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_parser_token_navigation_matches_model(tc: hegel::TestCase) {
+        let input = tc.draw(hostile_input());
+        let parser = match Parser::new(&GENERIC).try_with_sql(&input) {
+            Ok(p) => p,
+            Err(_) => tc.reject(), // input didn't tokenize; nothing to navigate
+        };
+        let tokens = Tokenizer::new(&GENERIC, &input)
+            .tokenize()
+            .expect("tokenized above");
+        let model: Vec<Token> = tokens
+            .into_iter()
+            .filter(|t| !matches!(t, Token::Whitespace(_)))
+            .collect();
+        let machine = TokenCursor {
+            parser,
+            model,
+            cursor: 0,
+        };
+        hegel::stateful::machine(machine).run(tc);
+    }
+}
