+            1 => Excluded(lo),
+            _ => Unbounded,
+        };
+        let mut end: Bound<i32> = match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => Included(hi),
+            1 => Excluded(hi),
+            _ => Unbounded,
+        };
+
+        // Both ends excluded on the same key is documented to panic (in rpds
+        // and in std alike), so construct a valid range instead.
+        if lo == hi && matches!((&start, &end), (Excluded(_), Excluded(_))) {
+            end = Included(hi);
+        }
+
+        let forward: Vec<(i32, usize)> =
+            map.range((start, end)).map(|(k, v)| (*k, *v)).collect();
+        let expected_forward: Vec<(i32, usize)> =
+            model.range((start, end)).map(|(k, v)| (*k, *v)).collect();
+        assert_eq!(forward, expected_forward);
+
+        let backward: Vec<(i32, usize)> =
+            map.range((start, end)).rev().map(|(k, v)| (*k, *v)).collect();
+        let expected_backward: Vec<(i32, usize)> =
+            model.range((start, end)).rev().map(|(k, v)| (*k, *v)).collect();
+        assert_eq!(backward, expected_backward);
+    }
+
+    // Persistence: every intermediate version of the map must stay intact
+    // when later versions are derived from it (by persistent inserts/removes
+    // and by copy-on-write `_mut` operations on clones).
+    #[hegel::test]
+    fn hegel_rbt_map_persistence(tc: TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let keys: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).min_size(n));
+
+        // versions[i] contains the first i insertions; snapshots[i] is the
+        // expected content of versions[i].
+        let mut versions: Vec<RedBlackTreeMap<i32, usize>> =
+            Vec::with_capacity(keys.len() + 1);
+        let mut snapshots: Vec<BTreeMap<i32, usize>> = Vec::with_capacity(keys.len() + 1);
+        versions.push(RedBlackTreeMap::new());
+        snapshots.push(BTreeMap::new());
+        for (i, k) in keys.iter().enumerate() {
+            versions.push(versions.last().unwrap().insert(*k, i));
+            let mut snapshot = snapshots.last().unwrap().clone();
+            snapshot.insert(*k, i);
+            snapshots.push(snapshot);
+        }
+
+        // Derive an emptied version from a randomly chosen version, and a
+        // heavily overwritten one from another.
+        let chosen = tc
+            .draw(generators::integers::<usize>().max_value(versions.len() - 1));
+        let mut emptied = versions[chosen].clone();
+        for k in &keys {
+            emptied.remove_mut(k);
+        }
+        assert!(emptied.is_empty());
+
+        let chosen2 = tc
+            .draw(generators::integers::<usize>().max_value(versions.len() - 1));
+        let mut overwritten = versions[chosen2].clone();
+        for k in &keys {
+            overwritten.insert_mut(*k, usize::MAX);
+        }
+
+        // No old version may have changed.
+        for (version, snapshot) in versions.iter().zip(snapshots.iter()) {
+            assert_eq!(version.size(), snapshot.len());
+            assert!(version.iter().eq(snapshot.iter()));
+        }
+    }
+}
diff --git a/src/queue/test.rs b/src/queue/test.rs
index 25406c0..a8b2380 100644
--- a/src/queue/test.rs
+++ b/src/queue/test.rs
@@ -427,3 +427,153 @@ fn test_serde() {
 
     assert_eq!(queue, decoded);
 }
+
+mod hegel_properties {
+    use super::*;
+    use hegel::TestCase;
+    use pretty_assertions::assert_eq;
+    use hegel::generators;
+    use std::collections::VecDeque;
+    use std::collections::hash_map::DefaultHasher;
+    use std::hash::{Hash, Hasher};
+
+    struct QueueMachine {
+        subject: Queue<i32>,
+        model: VecDeque<i32>,
+    }
+
+    #[hegel::state_machine]
+    impl QueueMachine {
+        #[rule]
+        fn enqueue_mut(&mut self, tc: TestCase) {
+            let v = tc.draw(generators::integers::<i32>());
+            self.subject.enqueue_mut(v);
+            self.model.push_back(v);
+        }
+
+        #[rule]
+        fn enqueue(&mut self, tc: TestCase) {
+            let v = tc.draw(generators::integers::<i32>());
+            self.subject = self.subject.enqueue(v);
+            self.model.push_back(v);
+        }
+
+        #[rule]
+        fn dequeue_mut(&mut self, _: TestCase) {
+            let dequeued = self.subject.dequeue_mut();
+            assert_eq!(dequeued, self.model.pop_front().is_some());
+        }
+
+        #[rule]
+        fn dequeue(&mut self, _: TestCase) {
+            match self.subject.dequeue() {
+                Some(shorter) => {
+                    assert!(self.model.pop_front().is_some());
+                    self.subject = shorter;
+                }
+                None => assert!(self.model.is_empty()),
+            }
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: TestCase) {
+            assert_eq!(self.subject.len(), self.model.len());
+            assert_eq!(self.subject.is_empty(), self.model.is_empty());
+            assert_eq!(self.subject.peek(), self.model.front());
+            assert!(self.subject.iter().eq(self.model.iter()));
+        }
+    }
+
+    // Model test: a `Queue` must behave like `VecDeque` under any sequence of
+    // enqueue/dequeue operations. The queue is implemented as an in-list and
+    // an out-list with lazy reversal, so the interesting states are the ones
+    // where elements sit in both lists.
+    #[hegel::test]
+    fn hegel_queue_model_matches_vec_deque(tc: TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let init: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).min_size(n));
+
+        let mut subject: Queue<i32> = Queue::new();
+        let mut model: VecDeque<i32> = VecDeque::new();
+        for v in init {
+            subject.enqueue_mut(v);
+            model.push_back(v);
+        }
+
+        hegel::stateful::machine(QueueMachine { subject, model }).run(tc);
+    }
+
+    // Persistence: dequeuing from a derived version must not change older
+    // versions, even though `dequeue_mut` internally swaps and reverses the
+    // shared in/out lists.
+    #[hegel::test]
+    fn hegel_queue_persistence(tc: TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let values: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).min_size(n));
+
+        // versions[i] contains values[..i]; interleave dequeues on the side to
+        // move elements between the internal in/out lists of later versions.
+        let mut versions: Vec<Queue<i32>> = Vec::with_capacity(values.len() + 1);
+        versions.push(Queue::new());
+        for v in &values {
+            versions.push(versions.last().unwrap().enqueue(*v));
+        }
+
+        // Derive a fully drained version from a randomly chosen version.
+        let chosen = tc
+            .draw(generators::integers::<usize>().max_value(versions.len() - 1));
+        let mut drained = versions[chosen].clone();
+        while drained.dequeue_mut() {}
+        assert!(drained.is_empty());
+
+        // No old version may have changed.
+        for (i, version) in versions.iter().enumerate() {
+            assert_eq!(version.len(), i);
+            assert!(version.iter().eq(values[..i].iter()));
+            assert_eq!(version.peek(), values[..i].first());
+        }
+    }
+
+    // Equality, ordering, and hashing must depend only on the queue's logical
+    // content, not on how the elements are split between the internal in/out
+    // lists (evidence: `PartialEq`/`Ord`/`Hash` impls all iterate logically).
+    #[hegel::test]
+    fn hegel_queue_eq_and_hash_ignore_internal_structure(tc: TestCase) {
+        fn hash_of(q: &Queue<i32>) -> u64 {
+            let mut hasher = DefaultHasher::new();
+            q.hash(&mut hasher);
+            hasher.finish()
+        }
+
+        let values: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()));
+        let junk: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).min_size(1));
+
+        // q1: enqueue the values directly (everything in the in-list).
+        let mut q1: Queue<i32> = Queue::new();
+        for v in &values {
+            q1.enqueue_mut(*v);
+        }
+
+        // q2: same logical content, but reached through extra enqueue/dequeue
+        // churn, so the elements are distributed differently internally.
+        let mut q2: Queue<i32> = Queue::new();
+        for j in &junk {
+            q2.enqueue_mut(*j);
+        }
+        for v in &values {
+            q2.enqueue_mut(*v);
+        }
+        for _ in &junk {
+            assert!(q2.dequeue_mut());
+        }
+
+        assert_eq!(q1, q2);
+        assert_eq!(q1.cmp(&q2), core::cmp::Ordering::Equal);
+        assert_eq!(q1.partial_cmp(&q2), Some(core::cmp::Ordering::Equal));
+        assert_eq!(hash_of(&q1), hash_of(&q2));
+    }
+}
