+
+mod hegel_properties {
+    use super::*;
+    use hegel::TestCase;
+    use pretty_assertions::assert_eq;
+    use hegel::generators;
+    use std::collections::HashSet;
+
+    // Oracle: `is_subset`/`is_superset`/`is_disjoint`/`==` must agree with
+    // `HashSet`. Elements come from a small domain so that subset/disjoint
+    // relations actually occur (with full-range i32 two random sets would
+    // almost never intersect).
+    #[hegel::test]
+    fn hegel_hash_trie_set_relations_match_hash_set(tc: TestCase) {
+        let a_vals: Vec<i8> =
+            tc.draw(generators::vecs(generators::integers::<i8>().min_value(0).max_value(15)));
+        // Sometimes build b on top of a's elements so subset relations occur.
+        let mut b_vals: Vec<i8> = if tc.draw(generators::booleans()) {
+            a_vals.clone()
+        } else {
+            Vec::new()
+        };
+        b_vals.extend(tc.draw(
+            generators::vecs(generators::integers::<i8>().min_value(0).max_value(15)),
+        ));
+
+        let mut a: HashTrieSet<i8> = HashTrieSet::new();
+        let mut model_a: HashSet<i8> = HashSet::new();
+        for v in &a_vals {
+            a.insert_mut(*v);
+            model_a.insert(*v);
+        }
+
+        let mut b: HashTrieSet<i8> = HashTrieSet::new();
+        let mut model_b: HashSet<i8> = HashSet::new();
+        for v in &b_vals {
+            b.insert_mut(*v);
+            model_b.insert(*v);
+        }
+
+        assert_eq!(a.size(), model_a.len());
+        assert_eq!(b.size(), model_b.len());
+
+        assert_eq!(a.is_subset(&b), model_a.is_subset(&model_b));
+        assert_eq!(b.is_subset(&a), model_b.is_subset(&model_a));
+        assert_eq!(a.is_superset(&b), model_a.is_superset(&model_b));
+        assert_eq!(b.is_superset(&a), model_b.is_superset(&model_a));
+        assert_eq!(a.is_disjoint(&b), model_a.is_disjoint(&model_b));
+        assert_eq!(b.is_disjoint(&a), model_b.is_disjoint(&model_a));
+        assert_eq!(a == b, model_a == model_b);
+
+        for v in 0..=15i8 {
+            assert_eq!(a.contains(&v), model_a.contains(&v));
+            assert_eq!(a.get(&v), model_a.get(&v));
+        }
+    }
+}
