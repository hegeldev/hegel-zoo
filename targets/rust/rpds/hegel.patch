+
+        // versions[i] contains values[..i].
+        let mut versions: Vec<Vector<i32>> = Vec::with_capacity(values.len() + 1);
+        versions.push(Vector::new_with_bits(bits));
+        for v in &values {
+            versions.push(versions.last().unwrap().push_back(*v));
+        }
+
+        // Derive heavily-mutated versions from a randomly chosen version.
+        let chosen = tc
+            .draw(generators::integers::<usize>().max_value(versions.len() - 1));
+        let mut drained = versions[chosen].clone();
+        while drained.drop_last_mut() {}
+
+        let mut overwritten = versions[chosen].clone();
+        for i in 0..overwritten.len() {
+            assert!(overwritten.set_mut(i, i32::MIN));
+        }
+        overwritten.push_back_mut(i32::MAX);
+
+        // No old version may have changed.
+        for (i, version) in versions.iter().enumerate() {
+            assert_eq!(version.len(), i);
+            assert!(version.iter().eq(values[..i].iter()));
+        }
+    }
+
+    // `new_with_bits` accepts any positive `bits` (that is the only
+    // documented/asserted requirement), so a vector created with any positive
+    // `bits` should support basic operations without panicking.
+    #[hegel::test]
+    fn hegel_vector_new_with_bits_no_panic(tc: TestCase) {
+        let bits = tc.draw(generators::integers::<u8>().min_value(1));
+        let values: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()));
+
+        let mut v: Vector<i32> = Vector::new_with_bits(bits);
+        for x in &values {
+            v.push_back_mut(*x);
+        }
+        assert_eq!(v.len(), values.len());
+        assert!(v.iter().eq(values.iter()));
+    }
+}
