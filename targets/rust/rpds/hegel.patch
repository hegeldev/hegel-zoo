+mod hegel_properties {
+    use super::*;
+    use core::hash::{BuildHasher, Hasher};
+    use pretty_assertions::assert_eq;
+    use hegel::TestCase;
+    use hegel::generators;
+    use std::collections::HashMap;
+    use std::collections::hash_map::DefaultHasher;
+
+    // A hasher that throws away all but the low 4 bits of the hash. This
+    // forces massive hash collisions, so the trie is driven into its
+    // hash-exhaustion/`Bucket::Collision` code paths (which an honest 64-bit
+    // hasher would essentially never reach).
+    #[derive(Clone, Default)]
+    struct LossyBuildHasher;
+
+    struct LossyHasher(DefaultHasher);
+
+    impl BuildHasher for LossyBuildHasher {
+        type Hasher = LossyHasher;
+
+        fn build_hasher(&self) -> LossyHasher {
+            LossyHasher(DefaultHasher::new())
+        }
+    }
+
+    impl Hasher for LossyHasher {
+        fn write(&mut self, bytes: &[u8]) {
+            self.0.write(bytes);
+        }
+
+        fn finish(&self) -> u64 {
+            self.0.finish() & 0xf
+        }
+    }
+
+    fn model_key_or_any(tc: &TestCase, model: &HashMap<i32, i64>) -> i32 {
+        if !model.is_empty() && tc.draw(generators::booleans()) {
+            let mut keys: Vec<i32> = model.keys().copied().collect();
+            keys.sort_unstable(); // HashMap iteration order varies per run; hegel needs deterministic generation
+            tc.draw(generators::sampled_from(keys))
+        } else {
+            tc.draw(generators::integers::<i32>())
+        }
+    }
+
+    fn check_against_model<H: BuildHasher + Clone>(
+        subject: &HashTrieMap<i32, i64, RcK, H>,
+        model: &HashMap<i32, i64>,
+    ) {
+        assert_eq!(subject.size(), model.len());
+        assert_eq!(subject.is_empty(), model.is_empty());
+        // Every entry the subject yields must be in the model, and the sizes
+        // agree, so the maps are equal as sets of entries.
+        let mut seen = 0;
+        for (k, v) in subject.iter() {
+            assert_eq!(model.get(k), Some(v));
+            seen += 1;
+        }
+        assert_eq!(seen, model.len());
+        assert_eq!(subject.keys().count(), model.len());
+        assert_eq!(subject.values().count(), model.len());
+    }
+
+    struct HtMapMachine<H: BuildHasher + Clone> {
+        subject: HashTrieMap<i32, i64, RcK, H>,
+        model: HashMap<i32, i64>,
+    }
+
+    #[hegel::state_machine]
+    impl<H: BuildHasher + Clone> HtMapMachine<H> {
+        #[rule]
+        fn insert_mut(&mut self, tc: TestCase) {
+            let k = model_key_or_any(&tc, &self.model);
+            let v = tc.draw(generators::integers::<i64>());
+            self.subject.insert_mut(k, v);
+            self.model.insert(k, v);
+        }
+
+        #[rule]
+        fn insert(&mut self, tc: TestCase) {
+            let k = model_key_or_any(&tc, &self.model);
+            let v = tc.draw(generators::integers::<i64>());
+            self.subject = self.subject.insert(k, v);
+            self.model.insert(k, v);
+        }
+
+        #[rule]
+        fn remove_mut(&mut self, tc: TestCase) {
+            let k = model_key_or_any(&tc, &self.model);
+            let removed = self.subject.remove_mut(&k);
+            assert_eq!(removed, self.model.remove(&k).is_some());
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: TestCase) {
+            let k = model_key_or_any(&tc, &self.model);
+            self.subject = self.subject.remove(&k);
+            self.model.remove(&k);
+        }
+
+        #[rule]
+        fn get(&mut self, tc: TestCase) {
+            let k = model_key_or_any(&tc, &self.model);
+            assert_eq!(self.subject.get(&k), self.model.get(&k));
+            assert_eq!(
+                self.subject.get_key_value(&k),
+                self.model.get_key_value(&k)
+            );
+            assert_eq!(self.subject.contains_key(&k), self.model.contains_key(&k));
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: TestCase) {
+            check_against_model(&self.subject, &self.model);
+        }
+    }
+
+    // Model test: a `HashTrieMap` must behave like `HashMap` under any
+    // sequence of operations. The trie's `degree` configuration is generated
+    // too (`new_with_degree` is public API): small degrees make deep tries.
+    #[hegel::test]
+    fn hegel_hash_trie_map_model_matches_hash_map(tc: TestCase) {
+        let degree = tc.draw(generators::sampled_from(vec![2u8, 4, 8, 16, 32, 64]));
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let init: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).min_size(n));
+
+        let mut subject: HashTrieMap<i32, i64> = HashTrieMap::new_with_degree(degree);
+        let mut model: HashMap<i32, i64> = HashMap::new();
+        for (i, k) in init.into_iter().enumerate() {
+            subject.insert_mut(k, i as i64);
+            model.insert(k, i as i64);
+        }
+
+        hegel::stateful::machine(HtMapMachine { subject, model }).run(tc);
+    }
+
+    // Same model property, but with a hasher that only produces 16 distinct
+    // hash values, so that collision buckets at the maximum trie depth are
+    // actually exercised.
+    #[hegel::test]
+    fn hegel_hash_trie_map_collisions_model_matches_hash_map(tc: TestCase) {
+        let degree = tc.draw(generators::sampled_from(vec![2u8, 4, 8, 16, 32, 64]));
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let init: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).min_size(n));
+
+        let mut subject: HashTrieMap<i32, i64, RcK, LossyBuildHasher> =
+            HashTrieMap::new_with_hasher_and_degree_and_ptr_kind(LossyBuildHasher, degree);
+        let mut model: HashMap<i32, i64> = HashMap::new();
+        for (i, k) in init.into_iter().enumerate() {
+            subject.insert_mut(k, i as i64);
+            model.insert(k, i as i64);
+        }
+
+        hegel::stateful::machine(HtMapMachine { subject, model }).run(tc);
+    }
+
+    // Persistence: every intermediate version must stay intact when later
+    // versions are derived from it. Run with both the honest and the lossy
+    // hasher so collision buckets are covered as well.
+    #[hegel::test]
+    fn hegel_hash_trie_map_persistence(tc: TestCase) {
+        fn run<H: BuildHasher + Clone>(
+            tc: &TestCase,
+            empty: HashTrieMap<i32, usize, RcK, H>,
+            keys: &[i32],
+        ) {
+            let mut versions: Vec<HashTrieMap<i32, usize, RcK, H>> =
+                Vec::with_capacity(keys.len() + 1);
+            let mut snapshots: Vec<HashMap<i32, usize>> = Vec::with_capacity(keys.len() + 1);
+            versions.push(empty);
+            snapshots.push(HashMap::new());
+            for (i, k) in keys.iter().enumerate() {
+                versions.push(versions.last().unwrap().insert(*k, i));
+                let mut snapshot = snapshots.last().unwrap().clone();
+                snapshot.insert(*k, i);
+                snapshots.push(snapshot);
+            }
+
+            // Derive an emptied version from a randomly chosen version.
+            let chosen = tc
+                .draw(generators::integers::<usize>().max_value(versions.len() - 1));
+            let mut emptied = versions[chosen].clone();
+            for k in keys {
+                emptied.remove_mut(k);
+            }
+            assert!(emptied.is_empty());
+
+            // No old version may have changed.
+            for (version, snapshot) in versions.iter().zip(snapshots.iter()) {
+                assert_eq!(version.size(), snapshot.len());
+                let mut seen = 0;
+                for (k, v) in version.iter() {
+                    assert_eq!(snapshot.get(k), Some(v));
+                    seen += 1;
+                }
+                assert_eq!(seen, snapshot.len());
+            }
+        }
+
+        let degree = tc.draw(generators::sampled_from(vec![2u8, 4, 8, 16, 32, 64]));
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let keys: Vec<i32> =
+            tc.draw(generators::vecs(generators::integers::<i32>()).min_size(n));
+
+        if tc.draw(generators::booleans()) {
+            run(&tc, HashTrieMap::new_with_degree(degree), &keys);
+        } else {
+            run(
+                &tc,
+                HashTrieMap::new_with_hasher_and_degree_and_ptr_kind(LossyBuildHasher, degree),
+                &keys,
+            );
+        }
+    }
+}
+
+// SUSPECTED BUG (found while writing the hegel model tests, see
+// HEGEL_REPORT.md): `new_with_degree(1)` passes the constructor's
+// validation (1 is a power of two and <= 64), but with degree 1
+// `node_utils::index_from_hash` never consumes any hash bits (a shift of
+// `depth * 0`), so inserting two distinct keys recurses forever and crashes
+// with a stack overflow (SIGABRT). Ignored by default because the abort
+// would kill the whole test binary; run explicitly with
+// `cargo test -- --ignored temp_probe_degree_one` to reproduce.
+#[test]
+#[ignore = "genuine bug: aborts the process with a stack overflow"]
+fn hegel_found_degree_one_stack_overflow() {
+    let mut m: HashTrieMap<i32, i32> = HashTrieMap::new_with_degree(1);
+    m.insert_mut(1, 1);
+    m.insert_mut(2, 2);
+    assert_eq!(m.size(), 2);
+}
