+//! Hegel properties for num-format.
+//!
+//! Oracle: a model that groups the decimal digits of `|n|` (from `to_string`) per the
+//! `Grouping` and prepends the format's minus sign — for every integer type, `Locale` and
+//! `CustomFormat`, through every writing API (`Buffer`, `ToFormattedString`, `WriteFormatted`
+//! on `String`/`Vec<u8>`/`io::Cursor`/`fmt::Formatter`) and the `num-bigint` path; parsing must
+//! invert formatting and reject what is not a number without panicking; the builder's capacity
+//! limits and the locale table are checked against the documented constants.
+#![allow(clippy::all, dead_code)]
+
+use std::fmt;
+use std::num::{NonZeroU128, NonZeroU16, NonZeroU32, NonZeroU64, NonZeroU8, NonZeroUsize};
+use std::str::FromStr;
+
+use hegel::generators;
+use num_bigint::{BigInt, BigUint};
+use num_format::parsing::ParseFormatted;
+use num_format::utils::{DecimalStr, InfinityStr, MinusSignStr, NanStr, PlusSignStr, SeparatorStr};
+use num_format::{
+    Buffer, CustomFormat, ErrorKind, Format, Grouping, Locale, ToFormattedString, WriteFormatted,
+};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+macro_rules! pp {
+    ($($t:ty),*) => {$(
+        impl hegel::PrettyPrintable for $t {
+            fn pretty_print(&self, printer: &mut hegel::pretty::PrettyPrinter) {
+                hegel::pretty::print_debug_repr(&format!("{self:?}"), printer);
+            }
+        }
+    )*};
+}
+
+/// Separators without numeric characters, at most 8 bytes (the crate's `MAX_SEP_LEN`).
+const SEPARATORS: [&str; 16] = [
+    "", ",", ".", " ", "\u{a0}", "\u{202f}", "'", "’", "_", "😀", "𠜱", ", ", "ab", "abcdefgh", "😀😀", "\u{202f}\u{202f}",
+];
+/// Minus signs, at most 8 bytes (`MAX_MIN_LEN`); the empty one only where noted.
+const MINUS_SIGNS: [&str; 7] = ["-", "\u{2212}", "\u{2010}", "🙌", "neg ", "--", "𠜱"];
+
+#[derive(Debug, Clone, PartialEq)]
+enum Spec {
+    Locale(&'static str),
+    Custom { grouping: u8, sep: usize, minus: Option<usize> },
+}
+pp!(Spec);
+
+/// One of the crate's two `Format` implementations, chosen at run time.
+#[derive(Debug, Clone)]
+enum Fmt {
+    L(Locale),
+    C(CustomFormat),
+}
+
+impl Format for Fmt {
+    fn decimal(&self) -> DecimalStr<'_> {
+        match self { Fmt::L(l) => Format::decimal(l), Fmt::C(c) => Format::decimal(c) }
+    }
+    fn grouping(&self) -> Grouping {
+        match self { Fmt::L(l) => Format::grouping(l), Fmt::C(c) => Format::grouping(c) }
+    }
+    fn infinity(&self) -> InfinityStr<'_> {
+        match self { Fmt::L(l) => Format::infinity(l), Fmt::C(c) => Format::infinity(c) }
+    }
+    fn minus_sign(&self) -> MinusSignStr<'_> {
+        match self { Fmt::L(l) => Format::minus_sign(l), Fmt::C(c) => Format::minus_sign(c) }
+    }
+    fn nan(&self) -> NanStr<'_> {
+        match self { Fmt::L(l) => Format::nan(l), Fmt::C(c) => Format::nan(c) }
+    }
+    fn plus_sign(&self) -> PlusSignStr<'_> {
+        match self { Fmt::L(l) => Format::plus_sign(l), Fmt::C(c) => Format::plus_sign(c) }
+    }
+    fn separator(&self) -> SeparatorStr<'_> {
+        match self { Fmt::L(l) => Format::separator(l), Fmt::C(c) => Format::separator(c) }
+    }
+}
+
+impl Spec {
+    fn format(&self) -> Fmt {
+        match self {
+            Spec::Locale(name) => Fmt::L(Locale::from_name(name).unwrap()),
+            Spec::Custom { grouping, sep, minus } => Fmt::C(
+                CustomFormat::builder()
+                    .grouping(match grouping { 0 => Grouping::Standard, 1 => Grouping::Indian, _ => Grouping::Posix })
+                    .separator(SEPARATORS[*sep])
+                    .minus_sign(minus.map(|i| MINUS_SIGNS[i]).unwrap_or(""))
+                    .build()
+                    .unwrap(),
+            ),
+        }
+    }
+}
+
+#[hegel::composite]
+fn arb_spec(tc: &hegel::TestCase) -> Spec {
+    if tc.draw(generators::booleans()) {
+        let names = Locale::available_names();
+        let i = tc.draw(int!(0usize, names.len() - 1));
+        Spec::Locale(names[i])
+    } else {
+        Spec::Custom {
+            grouping: tc.draw(int!(0u8, 2)),
+            sep: tc.draw(int!(0usize, SEPARATORS.len() - 1)),
+            minus: Some(tc.draw(int!(0usize, MINUS_SIGNS.len() - 1))),
+        }
+    }
+}
+
+/// An `i128` with a bias to the integer types' bounds, to powers of ten and to digit counts
+/// around the grouping boundaries.
+#[hegel::composite]
+fn arb_i128(tc: &hegel::TestCase) -> i128 {
+    let mag: i128 = match tc.draw(int!(0u8, 6)) {
+        0 => tc.draw(int!(0i128, i128::MAX)),
+        1 => tc.draw(int!(0i128, 20_000)),
+        2 => tc.draw(int!(0i128, u64::MAX as i128)),
+        3 => {
+            let e = tc.draw(int!(0u32, 38));
+            let d = tc.draw(int!(-2i128, 2));
+            (10i128.pow(e) + d).max(0)
+        }
+        4 => {
+            let e = tc.draw(int!(0u32, 35));
+            let m = tc.draw(int!(1i128, 999));
+            10i128.pow(e) * m
+        }
+        _ => tc.draw(generators::sampled_from(vec![
+            0, 1, 9, 10, 99, 100, 127, 128, 255, 256, 999, 1000, 1001, 9999, 10_000, 32_767, 32_768, 65_535, 65_536,
+            99_999, 100_000, 999_999, 1_000_000, i32::MAX as i128, i32::MAX as i128 + 1, u32::MAX as i128,
+            u32::MAX as i128 + 1, i64::MAX as i128, i64::MAX as i128 + 1, u64::MAX as i128, u64::MAX as i128 + 1,
+            i128::MAX,
+        ])),
+    };
+    if tc.draw(generators::booleans()) {
+        mag
+    } else if mag == i128::MAX && tc.draw(generators::booleans()) {
+        i128::MIN
+    } else {
+        -mag
+    }
+}
+
+/// The formatted text: the digits of `|n|` grouped and the minus sign prepended.
+fn model(digits: &str, grouping: Grouping, sep: &str, negative: bool, minus: &str) -> String {
+    let mut out = String::new();
+    if negative {
+        out.push_str(minus);
+    }
+    if sep.is_empty() || grouping == Grouping::Posix {
+        out.push_str(digits);
+        return out;
+    }
+    let n = digits.len();
+    for (i, c) in digits.chars().enumerate() {
+        let remaining = n - i;
+        let boundary = i > 0
+            && match grouping {
+                Grouping::Standard => remaining % 3 == 0,
+                Grouping::Indian => remaining == 3 || (remaining > 3 && (remaining - 3) % 2 == 0),
+                Grouping::Posix => false,
+            };
+        if boundary {
+            out.push_str(sep);
+        }
+        out.push(c);
+    }
+    out
+}
+
+fn expected_text(n: i128, f: &Fmt) -> String {
+    model(&n.unsigned_abs().to_string(), f.grouping(), f.separator().into_str(), n < 0, f.minus_sign().into_str())
+}
+
+/// `fmt::Write` sink to reach the `&mut fmt::Formatter` implementation of `WriteFormatted`.
+struct ViaFormatter<'a, N: ToFormattedString, F: Format>(&'a N, &'a F);
+impl<N: ToFormattedString, F: Format> fmt::Display for ViaFormatter<'_, N, F> {
+    fn fmt(&self, mut f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_formatted(self.0, self.1).map(|_| ()).map_err(|_| fmt::Error)
+    }
+}
+
+/// Every writing API for one number of one type.
+fn check_all_apis<N: num_format::ToFormattedStr + ToFormattedString>(n: &N, f: &Fmt, expected: &str) {
+    let mut buf = Buffer::new();
+    let c = buf.write_formatted(n, f);
+    assert_eq!(buf.as_str(), expected, "Buffer");
+    assert_eq!(c, expected.len(), "Buffer count for {expected:?}");
+    assert_eq!(buf.len(), expected.len());
+    assert_eq!(buf.is_empty(), expected.is_empty());
+    assert_eq!(buf.as_bytes(), expected.as_bytes());
+    assert_eq!(&*buf, expected, "Deref");
+    assert_eq!(format!("{buf}"), expected, "Display");
+    assert_eq!(format!("{buf:?}"), expected, "Debug");
+    assert_eq!(n.to_formatted_string(f), expected, "ToFormattedString");
+    let mut s = String::from("x");
+    assert_eq!(s.write_formatted(n, f).unwrap(), expected.len());
+    assert_eq!(&s[1..], expected, "String");
+    let mut v = vec![b'x'];
+    assert_eq!(v.write_formatted(n, f).unwrap(), expected.len());
+    assert_eq!(&v[1..], expected.as_bytes(), "Vec<u8>");
+    let mut cursor = std::io::Cursor::new(Vec::new());
+    assert_eq!(cursor.write_formatted(n, f).unwrap(), expected.len());
+    assert_eq!(cursor.into_inner(), expected.as_bytes(), "Cursor");
+    assert_eq!(ViaFormatter(n, f).to_string(), expected, "fmt::Formatter");
+}
+
+macro_rules! check_type {
+    ($n:expr, $f:expr, $expected:expr, $($t:ty),*) => {$(
+        if let Ok(v) = <$t>::try_from($n) {
+            check_all_apis(&v, $f, $expected);
+        }
+    )*};
+}
+macro_rules! check_non_zero {
+    ($n:expr, $f:expr, $expected:expr, $(($nz:ty, $t:ty)),*) => {$(
+        if let Ok(v) = <$t>::try_from($n) {
+            if let Some(v) = <$nz>::new(v) {
+                check_all_apis(&v, $f, $expected);
+            }
+        }
+    )*};
+}
+
+#[hegel::test]
+fn formatting_groups_the_digits_of_every_integer_type(tc: hegel::TestCase) {
+    let spec = tc.draw(arb_spec());
+    let f = spec.format();
+    let n = tc.draw(arb_i128());
+    let expected = expected_text(n, &f);
+    check_all_apis(&n, &f, &expected);
+    check_type!(n, &f, &expected, u8, u16, u32, u64, u128, usize, i8, i16, i32, i64, isize);
+    check_non_zero!(n, &f, &expected, (NonZeroU8, u8), (NonZeroU16, u16), (NonZeroU32, u32), (NonZeroU64, u64), (NonZeroU128, u128), (NonZeroUsize, usize));
+    // a Buffer is reusable: a second number replaces the first entirely
+    let other = tc.draw(arb_i128());
+    let mut buf = Buffer::default();
+    buf.write_formatted(&other, &f);
+    buf.write_formatted(&n, &f);
+    assert_eq!(buf.as_str(), expected);
+    buf.write_formatted(&other, &Locale::en);
+    assert_eq!(buf.as_str(), expected_text(other, &Fmt::L(Locale::en)));
+    // the text never starts with a separator and holds exactly the digits of |n|
+    let digits: String = expected.chars().filter(|c| c.is_ascii_digit()).collect();
+    if f.separator().into_str().chars().all(|c| !c.is_ascii_digit()) && f.minus_sign().into_str().chars().all(|c| !c.is_ascii_digit()) {
+        assert_eq!(digits, n.unsigned_abs().to_string());
+    }
+}
+
+#[hegel::test]
+fn bigints_format_like_the_machine_integers(tc: hegel::TestCase) {
+    let spec = tc.draw(arb_spec());
+    let f = spec.format();
+    let n = tc.draw(arb_i128());
+    let expected = expected_text(n, &f);
+    let big = BigInt::from(n);
+    assert_eq!(big.to_formatted_string(&f), expected);
+    let mut s = String::new();
+    assert_eq!(s.write_formatted(&big, &f).unwrap(), expected.len());
+    assert_eq!(s, expected);
+    let mut v = Vec::new();
+    assert_eq!(v.write_formatted(&big, &f).unwrap(), expected.len());
+    assert_eq!(v, expected.as_bytes());
+    if n >= 0 {
+        let big = BigUint::from(n as u128);
+        assert_eq!(big.to_formatted_string(&f), expected);
+        let mut v = Vec::new();
+        assert_eq!(v.write_formatted(&big, &f).unwrap(), expected.len());
+        assert_eq!(v, expected.as_bytes());
+    }
+    // a number wider than u128: digits drawn directly
+    let len = tc.draw(int!(1usize, 90));
+    let mut digits = String::new();
+    digits.push(char::from(b'1' + tc.draw(int!(0u8, 8))));
+    for _ in 1..len {
+        digits.push(char::from(b'0' + tc.draw(int!(0u8, 9))));
+    }
+    let negative = tc.draw(generators::booleans());
+    let big = BigInt::from_str(&format!("{}{digits}", if negative { "-" } else { "" })).unwrap();
+    let expected = model(&digits, f.grouping(), f.separator().into_str(), negative, f.minus_sign().into_str());
+    assert_eq!(big.to_formatted_string(&f), expected);
+    let mut s = String::new();
+    assert_eq!(s.write_formatted(&big, &f).unwrap(), expected.len());
+    let mut v = Vec::new();
+    assert_eq!(v.write_formatted(&big, &f).unwrap(), expected.len());
+    assert_eq!(s.as_bytes(), v.as_slice());
+    if !negative {
+        assert_eq!(BigUint::from_str(&digits).unwrap().to_formatted_string(&f), expected);
+    }
+}
+
+macro_rules! check_parse {
+    ($text:expr, $f:expr, $n:expr, $($t:ty),*) => {$(
+        match <$t>::try_from($n) {
+            Ok(v) => assert_eq!($text.parse_formatted::<_, $t>($f).unwrap(), v, "{} from {:?}", stringify!($t), $text),
+            Err(_) => {
+                // out of range for the type: an error, provided the digits fit the crate's buffer
+                // (longer texts are pinned, see `overlong_texts_are_rejected_without_panicking`)
+                let digits = $n.unsigned_abs().to_string().len() + usize::from($n < 0);
+                if digits <= max_len::<$t>() {
+                    assert!($text.parse_formatted::<_, $t>($f).is_err(), "{} from {:?}", stringify!($t), $text);
+                }
+            }
+        }
+    )*};
+}
+
+/// The crate's per-type parse buffer lengths (`constants.rs`).
+fn max_len<T: 'static>() -> usize {
+    use std::any::TypeId;
+    let id = TypeId::of::<T>();
+    if id == TypeId::of::<u8>() { 3 } else if id == TypeId::of::<u16>() { 5 } else if id == TypeId::of::<u32>() { 10 }
+    else if id == TypeId::of::<u64>() || id == TypeId::of::<usize>() { 20 } else if id == TypeId::of::<u128>() { 39 }
+    else if id == TypeId::of::<i8>() { 4 } else if id == TypeId::of::<i16>() { 6 } else if id == TypeId::of::<i32>() { 11 }
+    else if id == TypeId::of::<i64>() || id == TypeId::of::<isize>() { 20 } else if id == TypeId::of::<i128>() { 40 } else { unreachable!() }
+}
+
+#[hegel::test]
+fn parsing_inverts_formatting(tc: hegel::TestCase) {
+    let spec = tc.draw(arb_spec());
+    let f = spec.format();
+    let n = tc.draw(arb_i128());
+    let text = n.to_formatted_string(&f);
+    check_parse!(&text, &f, n, i128, u128, i64, u64, i32, u32, i16, u16, i8, u8, isize, usize);
+    if n > 0 {
+        if let Ok(v) = u8::try_from(n) { assert_eq!(text.parse_formatted::<_, NonZeroU8>(&f).unwrap().get(), v); }
+        if let Ok(v) = u32::try_from(n) { assert_eq!(text.parse_formatted::<_, NonZeroU32>(&f).unwrap().get(), v); }
+        if let Ok(v) = u64::try_from(n) { assert_eq!(text.parse_formatted::<_, NonZeroU64>(&f).unwrap().get(), v); }
+        assert_eq!(text.parse_formatted::<_, NonZeroU128>(&f).unwrap().get(), n as u128);
+    }
+    if n == 0 {
+        assert!(text.parse_formatted::<_, NonZeroU8>(&f).is_err());
+        assert!(text.parse_formatted::<_, NonZeroUsize>(&f).is_err());
+    }
+    // the BigInt / BigUint parsers agree
+    assert_eq!(text.parse_formatted::<_, BigInt>(&f).unwrap(), BigInt::from(n));
+    if n >= 0 {
+        assert_eq!(text.parse_formatted::<_, BigUint>(&f).unwrap(), BigUint::from(n as u128));
+    } else {
+        assert!(text.parse_formatted::<_, BigUint>(&f).is_err());
+    }
+    // String, &str and Buffer all parse
+    let mut buf = Buffer::new();
+    buf.write_formatted(&n, &f);
+    assert_eq!(buf.as_str().parse_formatted::<_, i128>(&f).unwrap(), n);
+    assert_eq!(text.as_str().parse_formatted::<_, i128>(&f).unwrap(), n);
+}
+
+#[hegel::test]
+fn texts_that_are_not_numbers_are_errors(tc: hegel::TestCase) {
+    let spec = tc.draw(arb_spec());
+    let f = spec.format();
+    let text: String = match tc.draw(int!(0u8, 4)) {
+        0 => String::new(),
+        1 => f.minus_sign().into_str().to_string(),
+        2 => f.separator().into_str().to_string(),
+        3 => tc.draw(generators::sampled_from(vec!["abc", " ", "-", "+", "one", "∞", "NaN", "x"])).to_string(),
+        _ => {
+            // an out-of-range value whose digits still fit the crate's buffer
+            let d = tc.draw(int!(0u8, 3));
+            match d { 0 => "256", 1 => "999", 2 => "128", _ => "-1" }.to_string()
+        }
+    };
+    let has_digit = text.chars().any(|c| c.is_ascii_digit());
+    if !has_digit {
+        assert!(text.parse_formatted::<_, i128>(&f).is_err(), "{text:?}");
+        assert!(text.parse_formatted::<_, u8>(&f).is_err(), "{text:?}");
+        assert!(text.parse_formatted::<_, BigInt>(&f).is_err(), "{text:?}");
+    } else if f.minus_sign().into_str() == "-" {
+        // 256 and 999 fit neither u8 nor i8; 128 fits u8 only; -1 fits i8 only
+        if text != "128" {
+            assert!(text.parse_formatted::<_, u8>(&f).is_err(), "{text:?} as u8");
+        } else {
+            assert_eq!(text.parse_formatted::<_, u8>(&f).unwrap(), 128);
+        }
+        if text != "-1" {
+            assert!(text.parse_formatted::<_, i8>(&f).is_err(), "{text:?} as i8");
+        } else {
+            assert_eq!(text.parse_formatted::<_, i8>(&f).unwrap(), -1);
+        }
+    }
+    // an error displays its kind's message
+    if let Err(e) = "".parse_formatted::<_, u32>(&f) {
+        assert!(matches!(e.kind(), ErrorKind::ParseNumber(_)), "{:?}", e.kind());
+        assert_eq!(e.to_string(), "Failed to parse  into a number.");
+    } else {
+        panic!("empty text parsed");
+    }
+}
+
+#[hegel::test]
+fn texts_with_a_decimal_or_letters_are_rejected(tc: hegel::TestCase) {
+    // an integer parse must not read `1.5` (en) as 15 or `0x10` as 10: the format knows its
+    // decimal separator, and letters are never part of a formatted integer
+    let spec = tc.draw(arb_spec());
+    let f = spec.format();
+    let a = tc.draw(int!(0u32, 999));
+    let b = tc.draw(int!(0u32, 999));
+    let text = match tc.draw(int!(0u8, 3)) {
+        0 => format!("{a}{}{b}", f.decimal().into_str()),
+        1 => format!("0x{a:x}"),
+        2 => format!("{a}e{b}"),
+        _ => format!("{a}{}{b}", tc.draw(generators::sampled_from(vec!["abc", "x", "kg", "px"]))),
+    };
+    assert!(text.parse_formatted::<_, u64>(&f).is_err(), "{text:?} parsed as {:?}", text.parse_formatted::<_, u64>(&f));
+    assert!(text.parse_formatted::<_, i128>(&f).is_err(), "{text:?}");
+    assert!(text.parse_formatted::<_, BigInt>(&f).is_err(), "{text:?}");
+}
+
+#[hegel::test]
+fn overlong_texts_are_rejected_without_panicking(tc: hegel::TestCase) {
+    // more digits than the type can ever have (e.g. `1,000` as u8) must be an error, not a panic
+    let spec = tc.draw(arb_spec());
+    let f = spec.format();
+    let n = tc.draw(arb_i128());
+    let text = n.to_formatted_string(&f);
+    macro_rules! overlong {
+        ($($t:ty),*) => {$(
+            let digits = n.unsigned_abs().to_string().len() + usize::from(n < 0);
+            if digits > max_len::<$t>() {
+                assert!(text.parse_formatted::<_, $t>(&f).is_err(), "{} from {:?}", stringify!($t), text);
+            }
+        )*};
+    }
+    overlong!(u8, u16, u32, u64, usize, u128, i8, i16, i32, i64, isize);
+    assert!("1,000".parse_formatted::<_, u8>(&Locale::en).is_err());
+    assert!("1234".parse_formatted::<_, i8>(&Locale::en).is_err());
+}
+
+#[hegel::test]
+fn out_of_range_texts_report_a_number_error(tc: hegel::TestCase) {
+    // `256` as u8 is a number that does not fit: `ErrorKind::ParseNumber`, not `ParseLocale`
+    let n = tc.draw(int!(256u32, 999));
+    let text = n.to_string();
+    let e = text.parse_formatted::<_, u8>(&Locale::en).unwrap_err();
+    assert!(matches!(e.kind(), ErrorKind::ParseNumber(_)), "{:?}: {}", e.kind(), e);
+    assert_eq!(e.to_string(), format!("Failed to parse {text} into a number."));
+}
