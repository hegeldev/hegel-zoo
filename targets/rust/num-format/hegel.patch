+#[hegel::test]
+fn custom_formats_enforce_the_documented_capacities(tc: hegel::TestCase) {
+    // separator, minus, plus and decimal: 8 bytes; nan: 64; infinity: 128
+    let len = tc.draw(int!(0usize, 140));
+    let unit = tc.draw(generators::sampled_from(vec!["a", "é", "😀", " "]));
+    let s: String = std::iter::repeat(unit).take(len).collect();
+    let s = s.as_str();
+    let bytes = s.len();
+    let field = tc.draw(int!(0u8, 5));
+    let cap = match field { 0 | 1 | 2 | 3 => 8, 4 => 64, _ => 128 };
+    let builder = CustomFormat::builder();
+    let builder = match field {
+        0 => builder.separator(s),
+        1 => builder.minus_sign(s),
+        2 => builder.plus_sign(s),
+        3 => builder.decimal(s),
+        4 => builder.nan(s),
+        _ => builder.infinity(s),
+    };
+    let str_result = match field {
+        0 => SeparatorStr::new(s).map(|x| x.into_str()),
+        1 => MinusSignStr::new(s).map(|x| x.into_str()),
+        2 => PlusSignStr::new(s).map(|x| x.into_str()),
+        3 => DecimalStr::new(s).map(|x| x.into_str()),
+        4 => NanStr::new(s).map(|x| x.into_str()),
+        _ => InfinityStr::new(s).map(|x| x.into_str()),
+    };
+    match builder.build() {
+        Ok(f) => {
+            assert!(bytes <= cap, "{bytes} bytes accepted for cap {cap}");
+            let got = match field { 0 => f.separator(), 1 => f.minus_sign(), 2 => f.plus_sign(), 3 => f.decimal(), 4 => f.nan(), _ => f.infinity() };
+            assert_eq!(got, s);
+            assert_eq!(str_result.unwrap(), s);
+            // the other fields are `en`'s
+            let en = CustomFormat::from(Locale::en);
+            if field != 0 { assert_eq!(f.separator(), en.separator()); }
+            if field != 1 { assert_eq!(f.minus_sign(), en.minus_sign()); }
+            assert_eq!(f.grouping(), Grouping::Standard);
+            // builder round trip and serde
+            assert_eq!(f.clone().into_builder().build().unwrap(), f);
+            let json = serde_json::to_string(&f).unwrap();
+            assert_eq!(serde_json::from_str::<CustomFormat>(&json).unwrap(), f);
+            // formatting with it obeys the model
+            let n = tc.draw(arb_i128());
+            let fm = Fmt::C(f);
+            assert_eq!(n.to_formatted_string(&fm), expected_text(n, &fm));
+        }
+        Err(e) => {
+            assert!(bytes > cap, "{bytes} bytes refused for cap {cap}: {e}");
+            assert_eq!(*e.kind(), ErrorKind::Capacity { len: bytes, cap });
+            assert_eq!(e.to_string(), format!("Attempted to write input of length {bytes} bytes into a buffer with capacity {cap} bytes."));
+            assert_eq!(*str_result.unwrap_err().kind(), ErrorKind::Capacity { len: bytes, cap });
+        }
+    }
+    assert_eq!(CustomFormat::default(), CustomFormat::from(Locale::en));
+}
