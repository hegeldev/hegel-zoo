+#[hegel::test]
+fn an_empty_minus_sign_does_not_negate(tc: hegel::TestCase) {
+    // a CustomFormat may have an empty minus sign; then a formatted non-negative number must
+    // parse back as itself (the crate treats every text as negative)
+    let sep = tc.draw(int!(0usize, SEPARATORS.len() - 1));
+    let f = CustomFormat::builder().minus_sign("").separator(SEPARATORS[sep]).build().unwrap();
+    let n = tc.draw(int!(0i128, i128::MAX));
+    let text = n.to_formatted_string(&f);
+    assert_eq!(text, model(&n.to_string(), Grouping::Standard, SEPARATORS[sep], false, ""));
+    assert_eq!(text.parse_formatted::<_, i128>(&f).unwrap(), n, "{text:?}");
+    assert_eq!(text.parse_formatted::<_, u128>(&f).unwrap(), n as u128, "{text:?}");
+    // a negative number formats as its magnitude — and so parses as it
+    let m = tc.draw(int!(1i128, 1_000_000));
+    let text = (-m).to_formatted_string(&f);
+    assert_eq!(text, m.to_formatted_string(&f));
+    assert_eq!(text.parse_formatted::<_, i64>(&f).unwrap(), m as i64);
+}
