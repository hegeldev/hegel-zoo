+#[hegel::test]
+fn the_locale_table_is_consistent(tc: hegel::TestCase) {
+    let names = Locale::available_names();
+    assert_eq!(names.len(), 542);
+    assert!(names.windows(2).all(|w| w[0] < w[1]), "names sorted and unique");
+    let name = names[tc.draw(int!(0usize, names.len() - 1))];
+    let l = Locale::from_name(name).unwrap();
+    assert_eq!(l.name(), name);
+    assert_eq!(Locale::from_str(name).unwrap(), l);
+    assert_eq!(Locale::from_name(name.to_string()).unwrap(), l);
+    // the strings fit their capacities and CustomFormat::from copies them
+    let c = CustomFormat::from(l);
+    assert_eq!(c.separator(), l.separator());
+    assert_eq!(c.minus_sign(), l.minus_sign());
+    assert_eq!(c.plus_sign(), l.plus_sign());
+    assert_eq!(c.decimal(), l.decimal());
+    assert_eq!(c.nan(), l.nan());
+    assert_eq!(c.infinity(), l.infinity());
+    assert_eq!(c.grouping(), l.grouping());
+    assert_eq!(Format::separator(&l).into_str(), l.separator());
+    assert_eq!(Format::minus_sign(&l).into_str(), l.minus_sign());
+    assert!(!l.minus_sign().is_empty() && !l.decimal().is_empty());
+    assert!(l.separator().chars().all(|ch| !ch.is_numeric()), "{name}: separator {:?}", l.separator());
+    assert!(l.minus_sign().chars().all(|ch| !ch.is_numeric()));
+    assert_ne!(l.separator(), l.decimal(), "{name}");
+    // both Format implementations render alike
+    let n = tc.draw(arb_i128());
+    assert_eq!(n.to_formatted_string(&l), n.to_formatted_string(&c));
+    // unknown names are ParseLocale errors
+    let bad = tc.draw(generators::sampled_from(vec!["", "xx-YY", "EN", "en_US", "en-", " en", "klingon"]));
+    let e = Locale::from_name(bad).unwrap_err();
+    assert!(matches!(e.kind(), ErrorKind::ParseLocale(_)), "{bad:?}: {:?}", e.kind());
+    assert_eq!(e.to_string(), format!("Failed to parse {bad} into a valid locale."));
+    // a few well-known locales
+    assert_eq!(1_234_567.to_formatted_string(&Locale::en), "1,234,567");
+    assert_eq!(1_234_567.to_formatted_string(&Locale::en_IN), "12,34,567");
+    assert_eq!(1_234_567.to_formatted_string(&Locale::de), "1.234.567");
+    assert_eq!(1_234_567.to_formatted_string(&Locale::de_CH), "1’234’567");
+    assert_eq!((-1_234_567).to_formatted_string(&Locale::fr), "-1\u{202f}234\u{202f}567");
+}
