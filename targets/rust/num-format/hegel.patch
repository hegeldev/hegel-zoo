+#[hegel::test]
+fn buffers_serialize_and_deserialize(tc: hegel::TestCase) {
+    let spec = tc.draw(arb_spec());
+    let f = spec.format();
+    let n = tc.draw(arb_i128());
+    let mut buf = Buffer::new();
+    buf.write_formatted(&n, &f);
+    // JSON: a byte array
+    let json = serde_json::to_string(&buf).unwrap();
+    assert_eq!(json, serde_json::to_string(&buf.as_bytes().to_vec()).unwrap());
+    let back: Buffer = serde_json::from_str(&json).unwrap();
+    assert_eq!(back.as_str(), buf.as_str());
+    assert_eq!(back.len(), buf.len());
+}
+
+#[hegel::test]
+fn buffers_round_trip_through_binary_formats(tc: hegel::TestCase) {
+    // `Buffer` serializes as bytes; a binary format hands bytes back with `visit_bytes`
+    let spec = tc.draw(arb_spec());
+    let f = spec.format();
+    let n = tc.draw(arb_i128());
+    let mut buf = Buffer::new();
+    buf.write_formatted(&n, &f);
+    let bytes = postcard::to_allocvec(&buf).unwrap();
+    let back: Buffer = postcard::from_bytes(&bytes).unwrap();
+    assert_eq!(back.as_str(), buf.as_str());
+}
