+/// Non-ASCII characters for which `char::is_numeric` holds, with the digit value when the
+/// character is a decimal digit (general category Nd) and `None` when it is not a digit at all.
+const NON_ASCII_NUMERICS: [(char, Option<u8>); 14] = [
+    ('\u{11136}', Some(0)), // CHAKMA DIGIT ZERO
+    ('\u{11137}', Some(1)), // CHAKMA DIGIT ONE
+    ('\u{11730}', Some(0)), // AHOM DIGIT ZERO
+    ('\u{11735}', Some(5)), // AHOM DIGIT FIVE
+    ('\u{661}', Some(1)),   // ARABIC-INDIC DIGIT ONE
+    ('\u{6f3}', Some(3)),   // EXTENDED ARABIC-INDIC DIGIT THREE
+    ('\u{ff11}', Some(1)),  // FULLWIDTH DIGIT ONE
+    ('\u{966}', Some(0)),   // DEVANAGARI DIGIT ZERO
+    ('\u{1d7d8}', Some(0)), // MATHEMATICAL DOUBLE-STRUCK DIGIT ZERO
+    ('\u{3038}', None),     // HANGZHOU NUMERAL TEN
+    ('\u{3039}', None),     // HANGZHOU NUMERAL TWENTY
+    ('\u{bd}', None),       // VULGAR FRACTION ONE HALF
+    ('\u{b2}', None),       // SUPERSCRIPT TWO
+    ('\u{2460}', None),     // CIRCLED DIGIT ONE
+];
+
+#[hegel::test]
+fn non_ascii_numerics_are_not_misread(tc: hegel::TestCase) {
+    // a text with a non-ASCII numeric character is either rejected or, when every such
+    // character is a decimal digit, parsed as the number those digits denote
+    let count = tc.draw(int!(1usize, 4));
+    let mut text = String::new();
+    let mut digits = String::new();
+    let mut all_digits = true;
+    for i in 0..count {
+        if i > 0 && tc.draw(generators::booleans()) {
+            let d = tc.draw(int!(0u8, 9));
+            text.push(char::from(b'0' + d));
+            digits.push(char::from(b'0' + d));
+        }
+        let (c, value) = NON_ASCII_NUMERICS[tc.draw(int!(0usize, NON_ASCII_NUMERICS.len() - 1))];
+        assert!(c.is_numeric());
+        text.push(c);
+        match value {
+            Some(v) => digits.push(char::from(b'0' + v)),
+            None => all_digits = false,
+        }
+    }
+    let f = Locale::en;
+    for result in [text.parse_formatted::<_, u128>(&f), text.parse_formatted::<_, u32>(&f).map(u128::from), text.parse_formatted::<_, u8>(&f).map(u128::from)] {
+        match result {
+            Err(_) => {}
+            Ok(v) => {
+                assert!(all_digits, "{text:?} parsed as {v} though it holds a non-digit numeral");
+                assert_eq!(v, digits.parse::<u128>().unwrap(), "{text:?}");
+            }
+        }
+    }
+}
