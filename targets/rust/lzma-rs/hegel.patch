+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+mod common;
+
+use hegel::generators;
+
+/// Compress followed by decompress (default options) is the identity.
+#[hegel::test]
+fn prop_lzma_round_trip_structured(tc: hegel::TestCase) {
+    let x = common::draw_payload(&tc);
+    let mut compressed = Vec::new();
+    lzma_rs::lzma_compress(&mut std::io::BufReader::new(x.as_slice()), &mut compressed).unwrap();
+    let mut decomp = Vec::new();
+    lzma_rs::lzma_decompress(&mut compressed.as_slice(), &mut decomp).unwrap();
+    assert_eq!(decomp, x);
+}
+
+/// liblzma (independent implementation, via the `lzma` crate) decodes our
+/// compressed output back to the original data.
+#[hegel::test]
+fn prop_lzma_compress_interops_with_liblzma(tc: hegel::TestCase) {
+    let x = common::draw_payload(&tc);
+    let mut compressed = Vec::new();
+    lzma_rs::lzma_compress(&mut std::io::BufReader::new(x.as_slice()), &mut compressed).unwrap();
+    let decomp = lzma::decompress(&compressed).unwrap();
+    assert_eq!(decomp, x);
+}
+
+/// Round-trip holds for every compatible (encode, decode) unpacked-size
+/// configuration pair, not just the default. The valid pairs follow the
+/// crate's own `unpacked_size_*` unit tests above.
+#[hegel::test]
+fn prop_lzma_round_trip_generated_unpacked_size_configs(tc: hegel::TestCase) {
+    use lzma_rs::compress::UnpackedSize as EncUS;
+    use lzma_rs::decompress::UnpackedSize as DecUS;
+
+    let x = common::draw_payload(&tc);
+    let len = x.len() as u64;
+
+    let combo = tc.draw(generators::integers::<u8>().max_value(5));
+    let (enc, dec) = match combo {
+        0 => (EncUS::WriteToHeader(Some(len)), DecUS::ReadFromHeader),
+        1 => (
+            EncUS::WriteToHeader(Some(len)),
+            DecUS::ReadHeaderButUseProvided(Some(len)),
+        ),
+        2 => (EncUS::WriteToHeader(None), DecUS::ReadFromHeader),
+        3 => (
+            EncUS::WriteToHeader(None),
+            DecUS::ReadHeaderButUseProvided(Some(len)),
+        ),
+        4 => (
+            EncUS::WriteToHeader(None),
+            DecUS::ReadHeaderButUseProvided(None),
+        ),
+        _ => (EncUS::SkipWritingToHeader, DecUS::UseProvided(Some(len))),
+    };
+    let encode_options = lzma_rs::compress::Options { unpacked_size: enc };
+    let decode_options = lzma_rs::decompress::Options {
+        unpacked_size: dec,
+        ..Default::default()
+    };
+
+    let mut compressed = Vec::new();
+    lzma_rs::lzma_compress_with_options(
+        &mut std::io::BufReader::new(x.as_slice()),
+        &mut compressed,
+        &encode_options,
+    )
+    .unwrap();
+    let mut decomp = Vec::new();
+    lzma_rs::lzma_decompress_with_options(&mut compressed.as_slice(), &mut decomp, &decode_options)
+        .unwrap();
+    assert_eq!(decomp, x);
+}
+
+/// Decompressing arbitrary bytes returns a Result; it never panics.
+#[hegel::test]
+fn prop_lzma_decompress_arbitrary_bytes_no_panic(tc: hegel::TestCase) {
+    let data: Vec<u8> = tc.draw(generators::binary().max_size(4096));
+    let mut decomp = Vec::new();
+    drop(lzma_rs::lzma_decompress(&mut data.as_slice(), &mut decomp));
+}
+
+/// Decompressing a corrupted (bit-flipped, truncated, or byte-overwritten)
+/// valid stream returns a Result; it never panics.
+#[hegel::test]
+fn prop_lzma_decompress_corrupted_stream_no_panic(tc: hegel::TestCase) {
+    let x = common::draw_payload(&tc);
+    let mut compressed = Vec::new();
+    lzma_rs::lzma_compress(&mut std::io::BufReader::new(x.as_slice()), &mut compressed).unwrap();
+    common::corrupt(&tc, &mut compressed);
+    let mut decomp = Vec::new();
+    drop(lzma_rs::lzma_decompress(&mut compressed.as_slice(), &mut decomp));
+}
+
+/// With `memlimit: Some(0)`, decompressing any stream that produces at least
+/// one output byte fails with a memory-limit error instead of allocating.
+#[hegel::test]
+fn prop_lzma_memlimit_zero_rejects_nonempty_output(tc: hegel::TestCase) {
+    let mut x = common::draw_payload(&tc);
+    // Guarantee at least one output byte, since an empty stream never
+    // touches the dictionary buffer and is allowed to succeed.
+    x.push(tc.draw(generators::integers::<u8>()));
+
+    let mut compressed = Vec::new();
+    lzma_rs::lzma_compress(&mut std::io::BufReader::new(x.as_slice()), &mut compressed).unwrap();
+
+    let decode_options = lzma_rs::decompress::Options {
+        memlimit: Some(0),
+        ..Default::default()
+    };
+    let mut decomp = Vec::new();
+    let error =
+        lzma_rs::lzma_decompress_with_options(&mut compressed.as_slice(), &mut decomp, &decode_options)
+            .unwrap_err();
+    assert!(
+        error.to_string().contains("exceeded memory limit of 0"),
+        "{}",
+        error
+    );
+}
+
+/// Streaming decompression fed in arbitrary chunk sizes produces the same
+/// output as one-shot decompression.
+#[cfg(feature = "stream")]
+#[hegel::test]
+fn prop_lzma_stream_chunked_matches_one_shot(tc: hegel::TestCase) {
+    let x = common::draw_payload(&tc);
+    let mut compressed = Vec::new();
+    lzma_rs::lzma_compress(&mut std::io::BufReader::new(x.as_slice()), &mut compressed).unwrap();
+
+    // One-shot reference.
+    let mut one_shot = Vec::new();
+    lzma_rs::lzma_decompress(&mut compressed.as_slice(), &mut one_shot).unwrap();
+
+    // Streaming, in drawn chunk sizes. The compressed stream is never empty
+    // (13-byte header at minimum).
+    let chunk_size = tc.draw(
+        generators::integers::<usize>()
+            .min_value(1)
+            .max_value(compressed.len()),
+    );
+    let mut stream = lzma_rs::decompress::Stream::new(Vec::new());
+    for chunk in compressed.chunks(chunk_size) {
+        stream.write_all(chunk).unwrap();
+    }
+    let decomp = stream.finish().unwrap();
+
+    assert_eq!(decomp, one_shot);
+    assert_eq!(decomp, x);
+}
+
+/// Feeding arbitrary bytes to the streaming decoder in arbitrary chunk sizes
+/// returns errors, never panics.
+#[cfg(feature = "stream")]
+#[hegel::test]
+fn prop_lzma_stream_arbitrary_bytes_no_panic(tc: hegel::TestCase) {
+    let data: Vec<u8> = tc.draw(generators::binary().min_size(1).max_size(2048));
+    let chunk_size = tc.draw(
+        generators::integers::<usize>()
+            .min_value(1)
+            .max_value(data.len()),
+    );
+    let mut stream = lzma_rs::decompress::Stream::new(Vec::new());
+    for chunk in data.chunks(chunk_size) {
+        if stream.write_all(chunk).is_err() {
+            break;
+        }
+    }
+    drop(stream.finish());
+}
+
+/// With `allow_incomplete: true`, a truncated (but otherwise valid)
+/// compressed stream can be finished without the end-of-stream check, and
+/// the bytes produced are a prefix of the original data.
+#[cfg(feature = "stream")]
+#[hegel::test]
+fn prop_lzma_stream_allow_incomplete_truncated_yields_prefix(tc: hegel::TestCase) {
+    let x = common::draw_payload(&tc);
+    let mut compressed = Vec::new();
+    lzma_rs::lzma_compress(&mut std::io::BufReader::new(x.as_slice()), &mut compressed).unwrap();
+
+    let trunc_len = tc.draw(generators::integers::<usize>().max_value(compressed.len()));
+    let options = lzma_rs::decompress::Options {
+        allow_incomplete: true,
+        ..Default::default()
+    };
+    let mut stream = lzma_rs::decompress::Stream::new_with_options(&options, Vec::new());
+    stream.write_all(&compressed[..trunc_len]).unwrap();
+    match stream.finish() {
+        Ok(output) => assert!(
+            x.starts_with(&output),
+            "output is not a prefix of the original: {:?} vs {:?}",
+            output,
+            x
+        ),
+        // The stream cannot be finished while the 13-byte header plus the
+        // 5 range-coder start bytes have not been fully received.
+        Err(e) => assert!(
+            trunc_len < 18,
+            "unexpected finish error at trunc_len {}: {}",
+            trunc_len,
+            e
+        ),
+    }
+}
+
+/// Decoding with `ReadHeaderButUseProvided(Some(m))`:
+/// - if `m` is at most the real unpacked length, decoding succeeds and yields
+///   exactly the first `m` bytes of the original data;
+/// - if `m` is larger, decoding fails with an error (never panics).
+///
+/// The encoder docs note that a provided size is written unchecked, so the
+/// decoder must cope with sizes that disagree with the stream.
+#[hegel::test]
+fn prop_lzma_provided_size_takes_prefix_or_errors(tc: hegel::TestCase) {
+    let x = common::draw_payload(&tc);
+    let len = x.len() as u64;
+
+    // Both header variants carry the 8-byte size field the decoder re-reads.
+    let write_actual_len = tc.draw(generators::booleans());
+    let enc = lzma_rs::compress::Options {
+        unpacked_size: lzma_rs::compress::UnpackedSize::WriteToHeader(if write_actual_len {
+            Some(len)
+        } else {
+            None
+        }),
+    };
+    let mut compressed = Vec::new();
+    lzma_rs::lzma_compress_with_options(&mut std::io::BufReader::new(x.as_slice()), &mut compressed, &enc)
+        .unwrap();
+
+    let provided = tc.draw(generators::integers::<u64>().max_value(len + 1000));
+    let dec = lzma_rs::decompress::Options {
+        unpacked_size: lzma_rs::decompress::UnpackedSize::ReadHeaderButUseProvided(Some(provided)),
+        ..Default::default()
+    };
+    let mut decomp = Vec::new();
+    let result = lzma_rs::lzma_decompress_with_options(&mut compressed.as_slice(), &mut decomp, &dec);
+    if provided <= len {
+        result.unwrap();
+        assert_eq!(decomp, &x[..provided as usize]);
+    } else {
+        assert!(result.is_err(), "expected error for provided {} > len {}", provided, len);
+    }
+}
