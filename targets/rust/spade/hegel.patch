index b75e014..ca9747a 100644
--- a/src/test_utilities.rs
+++ b/src/test_utilities.rs
@@ -25,3 +25,69 @@ pub fn random_points_in_range(range: f64, size: usize, seed: &[u8; 32]) -> Vec<P
 pub fn random_points_with_seed(size: usize, seed: &[u8; 32]) -> Vec<Point2<f64>> {
