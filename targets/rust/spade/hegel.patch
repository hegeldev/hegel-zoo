diff --git a/src/cdt.rs b/src/cdt.rs
index a2204e3..b782618 100644
--- a/src/cdt.rs
+++ b/src/cdt.rs
@@ -2663,4 +2663,67 @@ mod test {
 
         }
     }
+
+    // === Hegel property based tests ===
+
+    use crate::test_utilities::draw_valid_points;
+    use hegel::generators::{self as gens};
+    use std::{format, string::ToString};
+
+    /// `try_add_constraint` behaves as documented:
+    ///  - it returns an empty list exactly if `from == to` or the constraint would cross an
+    ///    existing constraint edge (which `can_add_constraint` reports),
+    ///  - otherwise it returns a chain of constraint edges leading from `from` to `to`,
+    ///  - `num_constraints` always equals the number of edges flagged as constraint edges,
+    ///  - the CDT stays structurally valid (`cdt_sanity_check`).
+    #[hegel::test]
+    fn hegel_cdt_try_add_constraint_chain(tc: hegel::TestCase) {
+        let points = draw_valid_points(&tc, 20);
+        let mut cdt = Cdt::new();
+        for point in points {
+            cdt.insert(point).unwrap();
+        }
+
+        let handles: Vec<FixedVertexHandle> = cdt.fixed_vertices().collect();
+        if !handles.is_empty() {
+            let num_attempts = tc.draw(gens::integers::<usize>().max_value(10));
+            for _ in 0..num_attempts {
+                let from = handles[tc.draw(gens::integers::<usize>().max_value(handles.len() - 1))];
+                let to = handles[tc.draw(gens::integers::<usize>().max_value(handles.len() - 1))];
+
+                if from == to {
+                    assert!(cdt.try_add_constraint(from, to).is_empty());
+                    continue;
+                }
+
+                let could_add = cdt.can_add_constraint(from, to);
+                let edges = cdt.try_add_constraint(from, to);
+                assert_eq!(edges.is_empty(), !could_add);
+
+                if !edges.is_empty() {
+                    // The returned edges form a connected chain of constraint edges
+                    // from `from` to `to`.
+                    assert_eq!(cdt.directed_edge(edges[0]).from().fix(), from);
+                    assert_eq!(cdt.directed_edge(*edges.last().unwrap()).to().fix(), to);
+                    for pair in edges.windows(2) {
+                        assert_eq!(
+                            cdt.directed_edge(pair[0]).to().fix(),
+                            cdt.directed_edge(pair[1]).from().fix()
+                        );
+                    }
+                    for &edge in &edges {
+                        assert!(cdt.is_constraint_edge(edge.as_undirected()));
+                    }
+                }
+            }
+        }
+
+        let num_flagged = cdt
+            .undirected_edges()
+            .filter(|edge| edge.is_constraint_edge())
+            .count();
+        assert_eq!(num_flagged, cdt.num_constraints());
+
+        cdt.cdt_sanity_check();
+    }
 }
diff --git a/src/delaunay_core/math.rs b/src/delaunay_core/math.rs
index 0f94302..8b8c261 100644
--- a/src/delaunay_core/math.rs
+++ b/src/delaunay_core/math.rs
@@ -638,4 +638,105 @@ mod test {
             Point2::new(0f64, -0.5f64)
         ));
     }
+
+    // === Hegel property based tests ===
+
+    use super::{mitigate_underflow, validate_vertex, MAX_ALLOWED_VALUE, MIN_ALLOWED_VALUE};
+    use crate::{DelaunayTriangulation, Triangulation};
+    use alloc::vec;
+    use hegel::generators::{self as gens, Generator as _};
+    use std::{format, string::ToString};
+
+    /// Draws a completely arbitrary `f64` coordinate: any float (including NaN and the
+    /// infinities), boosted with the exact documented boundary values of the coordinate
+    /// contract and their closest neighbors just outside the allowed range.
+    fn draw_any_coordinate(tc: &hegel::TestCase) -> f64 {
+        tc.draw(hegel::one_of!(
+            gens::floats::<f64>().boxed(),
+            gens::sampled_from(vec![
+                0.0,
+                -0.0,
+                // The documented boundary values are valid ...
+                MIN_ALLOWED_VALUE,
+                -MIN_ALLOWED_VALUE,
+                MAX_ALLOWED_VALUE,
+                -MAX_ALLOWED_VALUE,
+                // ... their closest neighbors towards zero/infinity are not.
+                MIN_ALLOWED_VALUE.next_down(),
+                -MIN_ALLOWED_VALUE.next_up(),
+                MAX_ALLOWED_VALUE.next_up(),
+                -MAX_ALLOWED_VALUE.next_down(),
+                // Other classic extreme values.
+                f64::MIN_POSITIVE,
+                5e-324,
+                f64::MAX,
+                f64::MIN,
+                f64::INFINITY,
+                f64::NEG_INFINITY,
+                f64::NAN,
+            ])
+            .boxed(),
+        ))
+    }
+
+    /// `Triangulation::insert` accepts a vertex exactly if `validate_vertex` does (documented
+    /// on `bulk_load`/`insert`), returns the same error, never panics - and leaves the
+    /// triangulation unchanged when it fails (documented on `insert`).
+    #[hegel::test]
+    fn hegel_insert_agrees_with_validate_vertex(tc: hegel::TestCase) {
+        let mut triangulation = DelaunayTriangulation::<Point2<f64>>::new();
+        for point in [
+            Point2::new(0.0, 0.0),
+            Point2::new(1.0, 0.0),
+            Point2::new(0.0, 1.0),
+        ] {
+            triangulation.insert(point).unwrap();
+        }
+
+        let point = Point2::new(draw_any_coordinate(&tc), draw_any_coordinate(&tc));
+        let expected = validate_vertex(&point);
+
+        let vertices_before = triangulation.num_vertices();
+        let edges_before = triangulation.num_undirected_edges();
+        let result = triangulation.insert(point);
+
+        match expected {
+            Ok(()) => {
+                let handle = result.unwrap();
+                assert_eq!(triangulation.vertex(handle).position(), point);
+            }
+            Err(error) => {
+                assert_eq!(result, Err(error));
+                assert_eq!(triangulation.num_vertices(), vertices_before);
+                assert_eq!(triangulation.num_undirected_edges(), edges_before);
+            }
+        }
+    }
+
+    /// A position returned by `mitigate_underflow` never causes `InsertionError::TooSmall`
+    /// (documented on `mitigate_underflow`), and the function only ever flushes
+    /// too-small coordinates to zero - all other coordinates pass through unchanged.
+    #[hegel::test]
+    fn hegel_mitigate_underflow_never_too_small(tc: hegel::TestCase) {
+        let point = Point2::new(draw_any_coordinate(&tc), draw_any_coordinate(&tc));
+        let mitigated = mitigate_underflow(point);
+
+        for (original, result) in [(point.x, mitigated.x), (point.y, mitigated.y)] {
+            if original.is_nan() {
+                assert!(result.is_nan());
+                continue;
+            }
+            assert_ne!(
+                validate_coordinate(result),
+                Err(InsertionError::TooSmall),
+                "mitigate_underflow left a too-small coordinate behind: \
+                 {original} became {result}"
+            );
+            if result != original {
+                // Rounds towards zero, and only for coordinates in the underflow band.
+                assert_eq!(result, 0.0);
+                assert!(original != 0.0 && original.abs() < MIN_ALLOWED_VALUE);
+            }
+        }
+    }
 }
diff --git a/src/delaunay_core/triangulation_ext.rs b/src/delaunay_core/triangulation_ext.rs
index 9994aa9..20d9bcb 100644
--- a/src/delaunay_core/triangulation_ext.rs
+++ b/src/delaunay_core/triangulation_ext.rs
@@ -1594,4 +1594,296 @@ mod test {
         triangulation.sanity_check();
         Ok(())
     }
+
+    // === Hegel property based tests ===
+
+    use crate::test_utilities::{draw_valid_point, draw_valid_points, position_key};
+    use hegel::generators::{self as gens};
+    use std::collections::HashSet;
+    use std::{format, string::ToString};
+
+    fn to_robust_coord(point: Point2<f64>) -> robust::Coord<f64> {
+        robust::Coord {
+            x: point.x,
+            y: point.y,
+        }
+    }
+
+    /// The defining global Delaunay property: no vertex lies strictly inside the circumcircle
+    /// of any inner face. Checked with the exact predicates of the `robust` crate as an oracle.
+    ///
+    /// `robust::incircle(a, b, c, q)` is positive exactly if `q` lies strictly inside the circle
+    /// through the counterclockwise-ordered points `a`, `b`, `c`. Spade stores all inner faces
+    /// in counterclockwise order.
+    #[hegel::test]
+    fn hegel_delaunay_empty_circumcircle(tc: hegel::TestCase) {
+        let points = draw_valid_points(&tc, 30);
+        let triangulation = DelaunayTriangulation::<Point2<f64>>::bulk_load(points).unwrap();
+
+        let vertices: Vec<Point2<f64>> = triangulation.vertices().map(|v| v.position()).collect();
+        for face in triangulation.inner_faces() {
+            let [a, b, c] = face.positions();
+            for &q in &vertices {
+                if q == a || q == b || q == c {
+                    continue;
+                }
+                let det = robust::incircle(
+                    to_robust_coord(a),
+                    to_robust_coord(b),
+                    to_robust_coord(c),
+                    to_robust_coord(q),
+                );
+                assert!(
+                    det <= 0.0,
+                    "vertex {q:?} lies strictly inside the circumcircle of \
+                     face ({a:?}, {b:?}, {c:?}), incircle determinant: {det}"
+                );
+            }
+        }
+    }
+
+    /// The triangulation of a point set does not depend on how it is built: `bulk_load` and
+    /// incremental insertion in an arbitrary drawn order must produce the same vertex set,
+    /// the same convex hull and the same number of edges and faces.
+    ///
+    /// (Edge *sets* can legitimately differ for cocircular point sets, but the counts are
+    /// uniquely determined by the number of vertices and the convex hull.)
+    #[hegel::test]
+    fn hegel_insertion_order_invariance(tc: hegel::TestCase) {
+        let points = draw_valid_points(&tc, 25);
+        let bulk = DelaunayTriangulation::<Point2<f64>>::bulk_load(points.clone()).unwrap();
+
+        let mut incremental = DelaunayTriangulation::<Point2<f64>>::new();
+        let mut remaining = points;
+        while !remaining.is_empty() {
+            let index = tc.draw(gens::integers::<usize>().max_value(remaining.len() - 1));
+            incremental.insert(remaining.swap_remove(index)).unwrap();
+        }
+
+        bulk.sanity_check();
+        incremental.sanity_check();
+
+        assert_eq!(bulk.num_vertices(), incremental.num_vertices());
+        assert_eq!(
+            bulk.num_undirected_edges(),
+            incremental.num_undirected_edges()
+        );
+        assert_eq!(bulk.num_inner_faces(), incremental.num_inner_faces());
+
+        let vertex_set = |t: &DelaunayTriangulation<Point2<f64>>| -> HashSet<(u64, u64)> {
+            t.vertices().map(|v| position_key(v.position())).collect()
+        };
+        assert_eq!(vertex_set(&bulk), vertex_set(&incremental));
+
+        type HullEdgeSet = HashSet<((u64, u64), (u64, u64))>;
+        let hull_edges = |t: &DelaunayTriangulation<Point2<f64>>| -> HullEdgeSet {
+            t.convex_hull()
+                .map(|edge| {
+                    (
+                        position_key(edge.from().position()),
+                        position_key(edge.to().position()),
+                    )
+                })
+                .collect()
+        };
+        assert_eq!(hull_edges(&bulk), hull_edges(&incremental));
+    }
+
+    /// Euler's formula `V - E + F = 2` (`F` including the outer face) holds after any sequence
+    /// of insertions and removals, as long as not all vertices lie on a single line.
+    /// For fully degenerate (collinear) triangulations the documented invariants are
+    /// `F = 1` and `E = V - 1` (or 0 for empty triangulations).
+    #[hegel::test]
+    fn hegel_euler_formula_after_insertions_and_removals(tc: hegel::TestCase) {
+        let mut triangulation = DelaunayTriangulation::<Point2<f64>>::new();
+        let num_operations = tc.draw(gens::integers::<usize>().max_value(40));
+        for _ in 0..num_operations {
+            let remove = triangulation.num_vertices() > 0
+                && tc.draw(gens::integers::<u8>().max_value(3)) == 0;
+            if remove {
+                let handles: Vec<FixedVertexHandle> = triangulation.fixed_vertices().collect();
+                let index = tc.draw(gens::integers::<usize>().max_value(handles.len() - 1));
+                triangulation.remove(handles[index]);
+            } else {
+                triangulation.insert(draw_valid_point(&tc)).unwrap();
+            }
+        }
+
+        let v = triangulation.num_vertices();
+        let e = triangulation.num_undirected_edges();
+        let f = triangulation.num_all_faces();
+        if triangulation.all_vertices_on_line() {
+            assert_eq!(f, 1);
+            assert_eq!(e, v.saturating_sub(1));
+        } else {
+            assert_eq!(
+                v + f,
+                e + 2,
+                "Euler's formula violated: V = {v}, E = {e}, F = {f}"
+            );
+        }
+    }
+
+    /// `locate` returns a position description that is consistent with exact geometric
+    /// predicates: `OnVertex` queries match the vertex position exactly, `OnEdge` queries lie
+    /// exactly on the edge's segment, `OnFace` queries lie strictly inside the face and
+    /// `OutsideOfConvexHull` queries are contained in no face at all.
+    #[hegel::test]
+    fn hegel_locate_agrees_with_exact_predicates(tc: hegel::TestCase) {
+        let points = draw_valid_points(&tc, 25);
+        let triangulation = DelaunayTriangulation::<Point2<f64>>::bulk_load(points.clone()).unwrap();
+
+        // Left-or-on-line query: `robust::orient2d(a, b, q) >= 0` iff `q` does not lie strictly
+        // to the right of the directed line a -> b.
+        let orient = |a: Point2<f64>, b: Point2<f64>, q: Point2<f64>| {
+            robust::orient2d(to_robust_coord(a), to_robust_coord(b), to_robust_coord(q))
+        };
+
+        let query = if points.is_empty() {
+            draw_valid_point(&tc)
+        } else {
+            match tc.draw(gens::integers::<u8>().max_value(3)) {
+                // Mostly arbitrary points ...
+                0 | 1 => draw_valid_point(&tc),
+                // ... but also exact vertex positions ...
+                2 => points[tc.draw(gens::integers::<usize>().max_value(points.len() - 1))],
+                // ... and midpoints of vertex pairs, which often lie exactly on edges.
+                _ => {
+                    let a = points[tc.draw(gens::integers::<usize>().max_value(points.len() - 1))];
+                    let b = points[tc.draw(gens::integers::<usize>().max_value(points.len() - 1))];
+                    let mid = |u: f64, v: f64| {
+                        // Cannot overflow: |u|, |v| <= MAX_ALLOWED_VALUE = 2^201.
+                        let m = (u + v) * 0.5;
+                        // Keep the query within the documented coordinate range (this protects
+                        // the test's assumptions, midpoints can end up in the underflow band).
+                        if m != 0.0 && m.abs() < crate::MIN_ALLOWED_VALUE {
+                            0.0
+                        } else {
+                            m
+                        }
+                    };
+                    Point2::new(mid(a.x, b.x), mid(a.y, b.y))
+                }
+            }
+        };
+
+        match triangulation.locate(query) {
+            PositionInTriangulation::OnVertex(vertex) => {
+                assert_eq!(triangulation.vertex(vertex).position(), query);
+            }
+            PositionInTriangulation::OnEdge(edge) => {
+                let [a, b] = triangulation.directed_edge(edge).positions();
+                assert_eq!(
+                    orient(a, b, query),
+                    0.0,
+                    "OnEdge result but query is not on the line through {a:?} and {b:?}"
+                );
+                assert!(
+                    a.x.min(b.x) <= query.x
+                        && query.x <= a.x.max(b.x)
+                        && a.y.min(b.y) <= query.y
+                        && query.y <= a.y.max(b.y),
+                    "OnEdge result but query {query:?} is outside the segment {a:?} - {b:?}"
+                );
+            }
+            PositionInTriangulation::OnFace(face) => {
+                let [a, b, c] = triangulation.face(face).positions();
+                assert!(
+                    orient(a, b, query) > 0.0
+                        && orient(b, c, query) > 0.0
+                        && orient(c, a, query) > 0.0,
+                    "OnFace result but query {query:?} is not strictly inside \
+                     the face ({a:?}, {b:?}, {c:?})"
+                );
+            }
+            PositionInTriangulation::OutsideOfConvexHull(edge) => {
+                // The returned edge must border the outer face and have the query point on its
+                // left side (documented on PositionInTriangulation::OutsideOfConvexHull).
+                let edge = triangulation.directed_edge(edge);
+                assert!(edge.face().is_outer());
+                let [a, b] = edge.positions();
+                assert!(orient(a, b, query) >= 0.0);
+                // And the point must really be outside: no inner face contains it.
+                for face in triangulation.inner_faces() {
+                    let [a, b, c] = face.positions();
+                    assert!(
+                        !(orient(a, b, query) >= 0.0
+                            && orient(b, c, query) >= 0.0
+                            && orient(c, a, query) >= 0.0),
+                        "OutsideOfConvexHull result but query {query:?} is contained in \
+                         the face ({a:?}, {b:?}, {c:?})"
+                    );
+                }
+            }
+            PositionInTriangulation::NoTriangulation => {
+                let num_vertices = triangulation.num_vertices();
+                assert!(
+                    num_vertices == 0
+                        || (num_vertices == 1
+                            && triangulation.vertices().next().unwrap().position() != query),
+                    "NoTriangulation result for a triangulation with {num_vertices} vertices"
+                );
+            }
+        }
+    }
+
+    /// Stateful model test: a `DelaunayTriangulation` behaves like a simple set of points under
+    /// `insert`, `locate_and_remove` and `locate_vertex`. Inserting an existing position
+    /// overwrites it (documented on `Triangulation::insert`), so a map keyed by exact position
+    /// is a valid model.
+    struct DelaunayVsPointSet {
+        triangulation: DelaunayTriangulation<Point2<f64>>,
+        model: std::collections::BTreeMap<(u64, u64), Point2<f64>>,
+    }
+
+    #[hegel::state_machine]
+    impl DelaunayVsPointSet {
+        #[rule]
+        fn insert(&mut self, tc: hegel::TestCase) {
+            let point = draw_valid_point(&tc);
+            let handle = self.triangulation.insert(point).unwrap();
+            assert_eq!(self.triangulation.vertex(handle).position(), point);
+            self.model.insert(position_key(point), point);
+        }
+
+        #[rule]
+        fn remove_existing(&mut self, tc: hegel::TestCase) {
+            tc.assume(!self.model.is_empty());
+            let index = tc.draw(gens::integers::<usize>().max_value(self.model.len() - 1));
+            let (&key, &point) = self.model.iter().nth(index).unwrap();
+            let removed = self.triangulation.locate_and_remove(point);
+            assert_eq!(removed, Some(point));
+            self.model.remove(&key);
+        }
+
+        #[rule]
+        fn locate_arbitrary(&mut self, tc: hegel::TestCase) {
+            let point = draw_valid_point(&tc);
+            let found = self
+                .triangulation
+                .locate_vertex(point)
+                .map(|vertex| vertex.position());
+            let expected = self.model.get(&position_key(point)).copied();
+            assert_eq!(found, expected);
+        }
+
+        #[rule]
+        fn check_structure(&mut self, _tc: hegel::TestCase) {
+            self.triangulation.sanity_check();
+        }
+
+        #[invariant]
+        fn vertex_count_agrees(&self, _tc: hegel::TestCase) {
+            assert_eq!(self.triangulation.num_vertices(), self.model.len());
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_delaunay_matches_point_set_model(tc: hegel::TestCase) {
+        let machine = DelaunayVsPointSet {
+            triangulation: DelaunayTriangulation::new(),
+            model: std::collections::BTreeMap::new(),
+        };
+        hegel::stateful::machine(machine).run(tc);
+    }
 }
diff --git a/src/flood_fill_iterator.rs b/src/flood_fill_iterator.rs
index 1b5291c..cf40479 100644
--- a/src/flood_fill_iterator.rs
+++ b/src/flood_fill_iterator.rs
@@ -823,4 +823,337 @@ mod test {
         check(Point2::new(-2.0, -1.0), Point2::new(-1.5, -1.0), false);
         check(Point2::new(1.5, -1.0), Point2::new(2.0, -1.0), false);
     }
+
+    // === Hegel property based tests ===
+
+    use crate::test_utilities::position_key;
+    use hegel::generators::{self as gens};
+    use std::collections::HashSet as StdHashSet;
+    use std::{format, string::ToString};
+
+    /// Draws one common power-of-two scale factor per test case for the shape-query tests.
+    ///
+    /// All coordinates of a test case are exact small-integer multiples of this scale. This
+    /// sweeps the entire documented coordinate magnitude range (2^-142 ..= 2^201) across test
+    /// cases while keeping each individual test case's coordinates on a single scale:
+    /// coordinate sets whose magnitudes span many orders of magnitude trigger the pinned
+    /// precision-loss bugs in the shape iterators - see the KNOWN FAILURE tests
+    /// `hegel_rectangle_query_includes_vertex_left_of_extreme_rectangle` and
+    /// `known_bug_circle_query_misses_boundary_vertex`. Those inputs are excluded here
+    /// (constructively, not by filtering) so these tests keep checking everything else.
+    fn draw_grid_scale(tc: &hegel::TestCase) -> f64 {
+        // 128 * 2^193 = 2^200 <= MAX_ALLOWED_VALUE = 2^201 and 2^-134 >= MIN_ALLOWED_VALUE
+        // = 2^-142, so every drawn grid coordinate is a valid spade coordinate.
+        let exponent = tc.draw(gens::integers::<i32>().min_value(-134).max_value(193));
+        2f64.powi(exponent)
+    }
+
+    /// Draws a coordinate that is an exact small-integer multiple of `scale`.
+    fn draw_grid_coordinate(tc: &hegel::TestCase, scale: f64) -> f64 {
+        // i8 -> f64 and the multiplication by a power of two are both exact.
+        f64::from(tc.draw(gens::integers::<i8>())) * scale
+    }
+
+    /// Draws up to `max_len` points on the integer grid scaled by `scale`.
+    fn draw_grid_points(tc: &hegel::TestCase, scale: f64, max_len: usize) -> Vec<Point2<f64>> {
+        let len = tc.draw(gens::integers::<usize>().max_value(max_len));
+        (0..len)
+            .map(|_| {
+                Point2::new(
+                    draw_grid_coordinate(tc, scale),
+                    draw_grid_coordinate(tc, scale),
+                )
+            })
+            .collect()
+    }
+
+    /// Draws a shape coordinate: either a grid coordinate or an exact coordinate of one of
+    /// the given points, so that vertices frequently lie exactly on the shape's boundary
+    /// (which the documentation promises are returned as well).
+    fn draw_shape_coordinate(
+        tc: &hegel::TestCase,
+        scale: f64,
+        points: &[Point2<f64>],
+        pick_x: bool,
+    ) -> f64 {
+        if !points.is_empty() && tc.draw(gens::integers::<u8>().max_value(2)) == 0 {
+            let point = points[tc.draw(gens::integers::<usize>().max_value(points.len() - 1))];
+            if pick_x {
+                point.x
+            } else {
+                point.y
+            }
+        } else {
+            draw_grid_coordinate(tc, scale)
+        }
+    }
+
+    /// Returns `true` if a shape query on `triangulation` with `metric` could run into the
+    /// known hull-walk hang (see `known_bug_hull_walk_hangs_on_distant_shapes`):
+    /// `FloodFillIterator::get_start_edges` walks the convex hull and only stops when the
+    /// distance to the shape *strictly* increases or an edge overlaps the shape. If every hull
+    /// vertex has the exact same rounded distance (which happens for shapes so far away that
+    /// the f64 squared distances quantize to a single value) and no hull edge overlaps the
+    /// shape, the walk cycles the hull forever.
+    ///
+    /// Used to exclude those inputs from the live property tests below - this protects the
+    /// tests from hanging the suite, it does not reflect a contract limit of the library.
+    fn hull_walk_may_hang<M: DistanceMetric<f64>>(
+        triangulation: &DelaunayTriangulation<Point2<f64>>,
+        metric: &M,
+    ) -> bool {
+        let mut distances = triangulation
+            .convex_hull()
+            .map(|edge| metric.distance_to_point(edge.from().position()));
+        let first = match distances.next() {
+            Some(first) => first,
+            None => return false,
+        };
+        if first <= 0.0 {
+            // The shape touches or contains a hull vertex - the walk terminates.
+            return false;
+        }
+        let all_equal = distances.all(|distance| distance == first);
+        let any_edge_overlaps = triangulation
+            .convex_hull()
+            .any(|edge| metric.is_handle_inside(edge.as_undirected()));
+        all_equal && !any_edge_overlaps
+    }
+
+    /// KNOWN FAILURE (process hang) - `#[ignore]`d because running it would hang the entire
+    /// test suite: there is no way to keep it failing without blocking every other test.
+    ///
+    /// `get_vertices_in_circle`/`get_vertices_in_rectangle` (and the corresponding edge
+    /// iterators) never terminate when the query shape lies so far outside the triangulation's
+    /// convex hull that all hull vertices have the same rounded squared distance to it.
+    /// `FloodFillIterator::get_start_edges` (the `OutsideOfConvexHull` arm) walks the hull and
+    /// only breaks when the distance strictly increases (`next_distance > min_distance`) or an
+    /// edge overlaps the shape - with all distances equal it cycles the hull forever.
+    ///
+    /// Found by hegel with points near the origin and a circle centered at
+    /// `y = MAX_ALLOWED_VALUE`: all squared distances round to `MAX_ALLOWED_VALUE^2`.
+    /// Both coordinates are well within the documented allowed coordinate range.
+    #[test]
+    #[ignore = "known bug: infinite loop in FloodFillIterator::get_start_edges for distant query shapes"]
+    fn known_bug_hull_walk_hangs_on_distant_shapes() {
+        let triangulation = DelaunayTriangulation::<Point2<f64>>::bulk_load(vec![
+            Point2::new(0.0, 0.0),
+            Point2::new(1.0, 0.0),
+            Point2::new(0.0, 1.0),
+        ])
+        .unwrap();
+        let center = Point2::new(0.5, crate::MAX_ALLOWED_VALUE);
+        // This call never returns.
+        let _ = triangulation.get_vertices_in_circle(center, 1.0).count();
+    }
+
+    /// `get_vertices_in_rectangle` returns exactly the vertices inside the rectangle,
+    /// boundary included, and yields the empty iterator for unordered corners
+    /// (all documented behavior). Oracle: brute force filtering of all vertices.
+    #[hegel::test]
+    fn hegel_vertices_in_rectangle_match_brute_force(tc: hegel::TestCase) {
+        let scale = draw_grid_scale(&tc);
+        let points = draw_grid_points(&tc, scale, 25);
+        let triangulation = DelaunayTriangulation::<Point2<f64>>::bulk_load(points.clone()).unwrap();
+
+        let mut lower = Point2::new(
+            draw_shape_coordinate(&tc, scale, &points, true),
+            draw_shape_coordinate(&tc, scale, &points, false),
+        );
+        let mut upper = Point2::new(
+            draw_shape_coordinate(&tc, scale, &points, true),
+            draw_shape_coordinate(&tc, scale, &points, false),
+        );
+        // Always order the corners properly. Unordered ("inverted") rectangles are documented
+        // to yield an empty iterator, but this is violated for vertices lying exactly on the
+        // inverted rectangle's frame - see the canonical KNOWN FAILURE test
+        // `hegel_inverted_rectangle_yields_empty_iterator` below. Excluded here so this test
+        // keeps checking everything else.
+        if lower.x > upper.x {
+            core::mem::swap(&mut lower.x, &mut upper.x);
+        }
+        if lower.y > upper.y {
+            core::mem::swap(&mut lower.y, &mut upper.y);
+        }
+
+        // Excludes the known hull-walk hang, see `known_bug_hull_walk_hangs_on_distant_shapes`.
+        tc.assume(!hull_walk_may_hang(
+            &triangulation,
+            &RectangleMetric::new(lower, upper),
+        ));
+
+        let result: Vec<(u64, u64)> = triangulation
+            .get_vertices_in_rectangle(lower, upper)
+            .map(|vertex| position_key(vertex.position()))
+            .collect();
+        let result_set: StdHashSet<(u64, u64)> = result.iter().copied().collect();
+        assert_eq!(result.len(), result_set.len(), "duplicate vertices returned");
+
+        let expected: StdHashSet<(u64, u64)> = triangulation
+            .vertices()
+            .map(|vertex| vertex.position())
+            .filter(|position| {
+                lower.x <= position.x
+                    && position.x <= upper.x
+                    && lower.y <= position.y
+                    && position.y <= upper.y
+            })
+            .map(position_key)
+            .collect();
+        assert_eq!(result_set, expected);
+    }
+
+    /// KNOWN FAILURE - this test pins a real bug and fails deterministically.
+    ///
+    /// `get_vertices_in_rectangle` documents: "Yields an empty iterator if
+    /// `lower.x > upper.x || lower.y > upper.y`". This is violated when a vertex lies exactly
+    /// on the inverted rectangle's edge frame. Root cause: `VerticesInShapeIterator` checks
+    /// containment through the `DistanceMetric` *trait's* default `is_point_inside`
+    /// (`distance_to_point(p) <= 0`), and `RectangleMetric::distance_to_point` returns the
+    /// distance to the rectangle's four frame edges - which is 0 for a point on the frame,
+    /// even when the rectangle is inverted and therefore empty. `RectangleMetric`'s *inherent*
+    /// `is_point_inside` (component-wise comparison) correctly reports "outside", but it does
+    /// not override the trait method and is not the one called here.
+    ///
+    /// Minimal counterexample found by hegel: a single vertex at (0, 0), queried with
+    /// `lower = (0, 0)`, `upper = (0, -1)` - returns the vertex instead of nothing.
+    #[hegel::test]
+    fn hegel_inverted_rectangle_yields_empty_iterator(tc: hegel::TestCase) {
+        // Draw from a small exact integer grid so that `y - 1.0` is always exact and the
+        // rectangle is always genuinely inverted - this makes the failure deterministic.
+        let x = f64::from(tc.draw(gens::integers::<i8>()));
+        let y = f64::from(tc.draw(gens::integers::<i8>()));
+        let triangulation =
+            DelaunayTriangulation::<Point2<f64>>::bulk_load(vec![Point2::new(x, y)]).unwrap();
+
+        // Inverted rectangle: lower.y > upper.y, must yield an empty iterator per the docs.
+        let lower = Point2::new(x, y);
+        let upper = Point2::new(x, y - 1.0);
+        assert_eq!(
+            triangulation
+                .get_vertices_in_rectangle(lower, upper)
+                .count(),
+            0,
+            "inverted rectangle must yield an empty iterator"
+        );
+    }
+
+    /// `get_vertices_in_circle` returns exactly the vertices whose squared distance to the
+    /// center is at most `radius_2`, boundary included (documented behavior).
+    /// Oracle: brute force filtering of all vertices.
+    #[hegel::test]
+    fn hegel_vertices_in_circle_match_brute_force(tc: hegel::TestCase) {
+        let scale = draw_grid_scale(&tc);
+        let points = draw_grid_points(&tc, scale, 25);
+        let triangulation = DelaunayTriangulation::<Point2<f64>>::bulk_load(points.clone()).unwrap();
+
+        let center = Point2::new(
+            draw_shape_coordinate(&tc, scale, &points, true),
+            draw_shape_coordinate(&tc, scale, &points, false),
+        );
+        let radius_2 = if !points.is_empty() && tc.draw(gens::integers::<u8>().max_value(2)) == 0 {
+            // The exact squared distance to an existing vertex: that vertex lies exactly
+            // on the circle's boundary and must be returned.
+            let point = points[tc.draw(gens::integers::<usize>().max_value(points.len() - 1))];
+            center.distance_2(point)
+        } else {
+            // An exact grid radius on the same scale as all other coordinates.
+            let radius = f64::from(tc.draw(gens::integers::<u8>())) * scale;
+            radius * radius
+        };
+        // Squared distances of valid coordinates stay finite, but guard the drawn combination
+        // anyway (this protects the test's oracle, not the library contract).
+        tc.assume(radius_2.is_finite());
+
+        // Excludes the known hull-walk hang, see `known_bug_hull_walk_hangs_on_distant_shapes`.
+        tc.assume(!hull_walk_may_hang(
+            &triangulation,
+            &CircleMetric::new(center, radius_2),
+        ));
+
+        let result: Vec<(u64, u64)> = triangulation
+            .get_vertices_in_circle(center, radius_2)
+            .map(|vertex| position_key(vertex.position()))
+            .collect();
+        let result_set: StdHashSet<(u64, u64)> = result.iter().copied().collect();
+        assert_eq!(result.len(), result_set.len(), "duplicate vertices returned");
+
+        let expected: StdHashSet<(u64, u64)> = triangulation
+            .vertices()
+            .map(|vertex| vertex.position())
+            .filter(|position| center.distance_2(*position) <= radius_2)
+            .map(position_key)
+            .collect();
+        assert_eq!(result_set, expected);
+    }
+
+    /// KNOWN FAILURE - this test pins a real bug and fails deterministically.
+    ///
+    /// `get_vertices_in_rectangle` returns a vertex lying strictly *outside* the rectangle
+    /// when the rectangle's coordinates are on a vastly larger scale than the vertex.
+    /// For a vertex at `(0, y)` and the rectangle `[1, 2^k] x {y}` (k >= 54), the vertex has
+    /// `x = 0 < 1` and must not be returned. But the trait-default
+    /// `DistanceMetric::is_point_inside` computes `distance_to_point(p) <= 0`, and computing
+    /// the distance to the frame edge from `(2^k, y)` to `(1, y)` suffers catastrophic
+    /// cancellation: `fl(1 - 2^k) = -2^k`, so the projection foot rounds to exactly `(0, y)`
+    /// - the query point itself - and the computed distance is 0 instead of 1.
+    ///
+    /// Same underlying weakness as `hegel_inverted_rectangle_yields_empty_iterator`
+    /// (distance-based instead of exact component-wise containment), but triggered by
+    /// precision loss instead of corner inversion, so it is pinned separately.
+    ///
+    /// Original hegel counterexample: vertex `(0, -15)`, `lower = (1, -15)`,
+    /// `upper = (2.9802323204351658e60, -15)`.
+    #[hegel::test]
+    fn hegel_rectangle_query_includes_vertex_left_of_extreme_rectangle(tc: hegel::TestCase) {
+        let y = f64::from(tc.draw(gens::integers::<i8>()));
+        // Any exponent in 54..=201 triggers the cancellation; all fail deterministically.
+        let exponent = tc.draw(gens::integers::<i32>().min_value(54).max_value(201));
+        let big = 2f64.powi(exponent);
+
+        let triangulation =
+            DelaunayTriangulation::<Point2<f64>>::bulk_load(vec![Point2::new(0.0, y)]).unwrap();
+
+        let outside_vertices = triangulation
+            .get_vertices_in_rectangle(Point2::new(1.0, y), Point2::new(big, y))
+            .count();
+        assert_eq!(
+            outside_vertices, 0,
+            "vertex (0, {y}) lies outside the rectangle [1, 2^{exponent}] x [{y}, {y}]"
+        );
+    }
+
+    /// KNOWN FAILURE - this test pins a real bug and fails deterministically.
+    ///
+    /// `get_vertices_in_circle` documents: "Any vertex on the circle's boundary is also
+    /// returned". A circle centered exactly on an existing vertex with `radius_2 = 0`
+    /// contains exactly that vertex - but the vertex is *not* returned when the
+    /// triangulation's coordinates span a large magnitude range. The flood fill only starts
+    /// from edges that overlap the shape (`CircleMetric::is_edge_inside`, which calls the
+    /// inexact `math::distance_2`): projecting the center `(0, -2^53)` onto the edge from
+    /// `(0, 1)` to `(0, -2^53)` absorbs the `+1` (`fl(-2^53 - 1) = -2^53`), the projection
+    /// foot rounds to `(0, 1 - 2^53)` instead of the center, the computed distance is 1
+    /// instead of 0, no start edge is found and the iterator yields nothing.
+    ///
+    /// Minimal input found by hegel, kept as an exact fixed reproducer because the failure
+    /// depends on the DCEL's (deterministic) edge orientation for this construction.
+    #[test]
+    fn known_bug_circle_query_misses_boundary_vertex() {
+        let vertex = Point2::new(0.0, -9_007_199_254_740_992.0); // (0, -2^53)
+        let triangulation = DelaunayTriangulation::<Point2<f64>>::bulk_load(vec![
+            Point2::new(0.0, 1.0),
+            vertex,
+        ])
+        .unwrap();
+
+        let found = triangulation
+            .get_vertices_in_circle(vertex, 0.0)
+            .map(|v| v.position())
+            .collect::<Vec<_>>();
+        assert_eq!(
+            found,
+            vec![vertex],
+            "the circle centered on a vertex with radius 0 contains exactly that vertex"
+        );
+    }
 }
