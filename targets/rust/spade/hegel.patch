 }
+
+// === Hegel helpers ===
+//
+// Shared draw helpers for the hegel property based tests. Coordinates are drawn from a mix of
+// regimes:
+//  - a small integer grid (likely to produce duplicate, collinear and cocircular points, which
+//    exercise the degenerate code paths),
+//  - moderate float ranges,
+//  - the full documented coordinate range (spade documents that all coordinates with an absolute
+//    value of either zero or within [MIN_ALLOWED_VALUE, MAX_ALLOWED_VALUE] are supported),
+//  - the exact documented boundary values themselves.
+
+use crate::{MAX_ALLOWED_VALUE, MIN_ALLOWED_VALUE};
+use alloc::vec;
+use hegel::generators::{self, Generator};
+
+/// Draws a single coordinate that is valid according to `spade::validate_coordinate`.
+pub fn draw_valid_coordinate(tc: &hegel::TestCase) -> f64 {
+    let value = tc.draw(hegel::one_of!(
+        // Small integer grid - degeneracy rich (duplicates, collinear, cocircular).
+        generators::integers::<i8>().map(f64::from).boxed(),
+        // Moderate magnitudes.
+        generators::floats::<f64>()
+            .min_value(-1000.0)
+            .max_value(1000.0)
+            .boxed(),
+        // The full documented coordinate range.
+        generators::floats::<f64>()
+            .min_value(-MAX_ALLOWED_VALUE)
+            .max_value(MAX_ALLOWED_VALUE)
+            .boxed(),
+        // The documented boundary values.
+        generators::sampled_from(vec![
+            0.0,
+            MIN_ALLOWED_VALUE,
+            -MIN_ALLOWED_VALUE,
+            MAX_ALLOWED_VALUE,
+            -MAX_ALLOWED_VALUE,
+        ])
+        .boxed(),
+    ));
+    // The full-range float branch can produce values inside the forbidden underflow band
+    // (0, MIN_ALLOWED_VALUE). Flush them to zero, exactly like `spade::mitigate_underflow`.
+    // Also normalizes -0.0 to 0.0 so that tests can key positions by their bit patterns.
+    if value == 0.0 || value.abs() < MIN_ALLOWED_VALUE {
+        0.0
+    } else {
+        value
+    }
+}
+
+/// Draws a point whose coordinates are valid according to `spade::validate_vertex`.
+pub fn draw_valid_point(tc: &hegel::TestCase) -> Point2<f64> {
+    Point2::new(draw_valid_coordinate(tc), draw_valid_coordinate(tc))
+}
+
+/// Draws up to `max_len` points with valid coordinates.
+pub fn draw_valid_points(tc: &hegel::TestCase, max_len: usize) -> Vec<Point2<f64>> {
+    let len = tc.draw(generators::integers::<usize>().max_value(max_len));
+    (0..len).map(|_| draw_valid_point(tc)).collect()
+}
+
+/// Keys a point by its bit pattern for exact set comparisons.
+pub fn position_key(point: Point2<f64>) -> (u64, u64) {
+    (point.x.to_bits(), point.y.to_bits())
+}
