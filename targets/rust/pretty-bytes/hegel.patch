+//! Hegel property tests for pretty-bytes: `convert(num) -> String` "converts bytes to a human
+//! readable string: 1337 → 1.34 kB", a port of sindresorhus/pretty-bytes (decimal units B, kB,
+//! MB, …, YB; two decimals, trailing zeros dropped; values below one byte verbatim).
+//!
+//! The oracle is arithmetic: the output is `<mantissa> <unit>`, and `mantissa × 1000^unit` must
+//! be `num` to within the two decimals shown, with the mantissa in [1, 1000) — a size that rounds
+//! up to 1000 belongs to the next unit.
+
+extern crate hegel;
+extern crate pretty_bytes;
+
+use hegel::generators::Generator as _;
+use hegel::{generators, TestCase};
+use pretty_bytes::converter::convert;
+
+const UNITS: [&str; 9] = ["B", "kB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB"];
+
+fn ints(lo: i64, hi: i64) -> generators::IntegerGenerator<i64> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// A mantissa in [1, 1000): a whole number, or one with up to nine decimals.
+#[hegel::composite]
+fn mantissa(tc: &TestCase) -> f64 {
+    tc.draw(hegel::one_of!(
+        ints(1, 999).map(|m| m as f64),
+        hegel::compose!(|tc| { tc.draw(ints(1_000, 999_999)) as f64 / 1000.0 + tc.draw(ints(0, 999_999)) as f64 / 1e9 }),
+    ))
+}
+
+/// A mantissa and the unit exponent it goes with, up to `max_exp`.
+#[hegel::composite]
+fn size(tc: &TestCase, max_exp: i64) -> (f64, i32) {
+    (tc.draw(mantissa()), tc.draw(ints(0, max_exp)) as i32)
+}
+
+/// A number in [0, 1) with six decimals: a fraction of a byte.
+fn fraction() -> impl hegel::PrintableGenerator<f64> {
+    ints(0, 999_999).map(|f| f as f64 / 1e6)
+}
+
+/// Split `"<mantissa> <unit>"`.
+fn parse(out: &str) -> (f64, usize) {
+    let mut it = out.split(' ');
+    let m: f64 = it.next().unwrap().parse().unwrap_or_else(|_| panic!("mantissa in {:?}", out));
+    let unit = it.next().unwrap_or_else(|| panic!("no unit in {:?}", out));
+    assert!(it.next().is_none(), "extra fields in {:?}", out);
+    let k = UNITS.iter().position(|u| *u == unit).unwrap_or_else(|| panic!("unit in {:?}", out));
+    (m, k)
+}
+
+// ---------------------------------------------------------------- general properties
+
+/// The output is `<mantissa> <unit>` with at most two decimals and no trailing zero, and
+/// `mantissa × 1000^unit` is `num` to within half of the last decimal shown.  Mantissas that
+/// round up to 1000 are pinned separately (pretty-bytes/1).
+#[hegel::test]
+fn output_is_num_to_two_decimals(tc: TestCase) {
+    let (m, e) = tc.draw(size(9));
+    tc.assume(m < 999.995);
+    let num = m * 1000f64.powi(e);
+    let out = convert(num);
+    let (got, k) = parse(&out);
+    let text = out.split(' ').next().unwrap();
+    assert!(
+        text.chars().all(|c| c.is_ascii_digit() || c == '.') && text.rsplit('.').next().unwrap().len() <= 2
+            || !text.contains('.'),
+        "{} -> {:?}: not a plain number with at most two decimals",
+        num,
+        out
+    );
+    assert!(!text.ends_with('0') || !text.contains('.'), "{} -> {:?}: trailing zero", num, out);
+    let scaled = num / 1000f64.powi(k as i32);
+    assert!(
+        (got - scaled).abs() <= 0.005 + scaled * 1e-12,
+        "{} -> {:?}: mantissa {} vs {} for unit {}",
+        num,
+        out,
+        got,
+        scaled,
+        UNITS[k]
+    );
+}
+
+/// The unit is the largest one whose mantissa is at least 1 (YB for anything beyond).
+#[hegel::test]
+fn unit_is_the_largest_that_fits(tc: TestCase) {
+    let (m, e) = tc.draw(size(9));
+    tc.assume(m < 999.995);
+    let num = m * 1000f64.powi(e);
+    let (got, k) = parse(&convert(num));
+    assert_eq!(k as i32, e.min(8), "{} -> {:?}", num, convert(num));
+    assert!(got >= 1.0, "{} -> {:?}", num, convert(num));
+}
+
+/// A larger size never reads as a smaller one.
+#[hegel::test]
+fn output_is_monotone(tc: TestCase) {
+    let (m1, e1) = tc.draw(size(8));
+    let (m2, e2) = tc.draw(size(8));
+    let (a, b) = (m1 * 1000f64.powi(e1), m2 * 1000f64.powi(e2));
+    let (lo, hi) = if a <= b { (a, b) } else { (b, a) };
+    let value = |s: &str| {
+        let (m, k) = parse(s);
+        m * 1000f64.powi(k as i32)
+    };
+    let (vl, vh) = (value(&convert(lo)), value(&convert(hi)));
+    assert!(vl <= vh * (1.0 + 1e-12), "{} -> {:?} but {} -> {:?}", lo, convert(lo), hi, convert(hi));
+}
+
+/// A negative size is the positive one with a `-` in front; zero is `0 B`; a fraction of a
+/// byte is printed as it is.
+#[hegel::test]
+fn sign_is_a_prefix_and_fractions_are_verbatim(tc: TestCase) {
+    let (m, e) = tc.draw(size(8));
+    let num = m * 1000f64.powi(e);
+    assert_eq!(convert(-num), format!("-{}", convert(num)));
+    assert_eq!(convert(0.0), "0 B");
+    let frac = tc.draw(fraction());
+    assert_eq!(convert(frac), format!("{} B", frac));
+    assert_eq!(convert(-frac), format!("-{} B", frac));
+}
+
+/// The README example and neighbours.
+#[hegel::test]
+fn doc_examples(_tc: TestCase) {
+    assert_eq!(convert(1337.0), "1.34 kB");
+    assert_eq!(convert(100.0), "100 B");
+    assert_eq!(convert(1000.0), "1 kB");
+    assert_eq!(convert(1e24), "1 YB");
+    assert_eq!(convert(1e27), "1000 YB");
+    assert_eq!(convert(-1337.0), "-1.34 kB");
+    assert_eq!(convert(0.5), "0.5 B");
+}
+
+// ---------------------------------------------------------------- pinned bugs
+
+/// pretty-bytes/1: a size whose mantissa rounds up to 1000.00 is printed with that mantissa —
+/// `999999` is `1000 kB`, `999.995` is `1000 B` — instead of moving to the next unit (`1 MB`,
+/// `1 kB`).  The mantissa of a human-readable size is below 1000 by definition of the unit.
+#[hegel::test]
+fn mantissa_stays_below_1000(tc: TestCase) {
+    let e = tc.draw(ints(0, 7)) as i32;
+    // half the time a mantissa in [999.995, 1000) that rounds up to 1000.00
+    let m = tc.draw(hegel::one_of!(ints(0, 4_999).map(|d| 999.995 + d as f64 / 1e6), mantissa()));
+    let num = m * 1000f64.powi(e);
+    let out = convert(num);
+    let (got, _) = parse(&out);
+    assert!(got < 1000.0, "{} -> {:?}", num, out);
+}
+
+/// pretty-bytes/2: `convert(-0.0)` is `-0 B`; a byte count of zero has no sign (the original
+/// pretty-bytes tests `num < 0` and prints `0 B`).
+#[hegel::test]
+fn negative_zero_is_zero(_tc: TestCase) {
+    assert_eq!(convert(-0.0), "0 B");
+}
