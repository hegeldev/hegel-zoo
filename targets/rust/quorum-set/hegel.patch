diff --git a/src/progress/vec_progress/vec_progress_test.rs b/src/progress/vec_progress/vec_progress_test.rs
index 4cc590f..3f92a63 100644
--- a/src/progress/vec_progress/vec_progress_test.rs
+++ b/src/progress/vec_progress/vec_progress_test.rs
@@ -1337,3 +1337,166 @@ fn vec_progress_update_entry_with_panics_on_id_change() {
 
     progress.update_entry_with(&0, |entry| entry.0 = 9);
 }
+
+// ---
+// Property-based tests (hegel).
+//
+// These supplement the seeded LCG model tests above: the operation
+// sequences and, unlike the tests above, the quorum configurations
+// themselves are generated, and failures shrink to minimal counterexamples.
+// The joint-config model test came to the zoo with openraft; the tree and
+// reset properties were written for this crate.
+// ---
+
+use hegel::generators;
+
+/// An arbitrary joint quorum set of 1 or 2 non-empty majority configs
+/// over ids `0..=9`.
+#[hegel::composite]
+fn arb_quorum_config(tc: &hegel::TestCase) -> Vec<BTreeSet<u64>> {
+    let config_count = tc.draw(generators::integers::<usize>().min_value(1).max_value(2));
+    (0..config_count)
+        .map(|_| {
+            tc.draw(generators::vecs(generators::integers::<u64>().max_value(9)).min_size(1).max_size(6))
+                .into_iter()
+                .collect::<BTreeSet<_>>()
+        })
+        .collect()
+}
+
+/// An arbitrary quorum tree over ids `0..=9`, 1 to 4 distinct children,
+/// nesting depth at most `depth`.
+#[hegel::composite]
+fn arb_quorum_tree(tc: &hegel::TestCase, depth: u8) -> QuorumTree<u64> {
+    let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+    let mut nodes = BTreeSet::new();
+    for _ in 0..n {
+        let node = if depth > 0 && tc.draw(generators::booleans()) {
+            Node::Subtree(tc.draw(arb_quorum_tree(depth - 1)))
+        } else {
+            Node::Id(tc.draw(generators::integers::<u64>().max_value(9)))
+        };
+        nodes.insert(node);
+    }
+    let quorum_size = tc.draw(generators::integers::<u64>().max_value(nodes.len() as u64));
+    QuorumTree::new(quorum_size, nodes).expect("distinct children with quorum_size <= len must build")
+}
+
+/// Run a generated sequence of `update_progress`, `increase_to` and
+/// `upgrade_quorum_set` operations against the reference model.
+fn check_against_model<QS>(tc: &hegel::TestCase, mut next_quorum_set: impl FnMut(&hegel::TestCase) -> QS)
+where QS: QuorumSet<Id = u64> {
+    let known_ids = (0..=9).collect::<Vec<u64>>();
+
+    let quorum_set = next_quorum_set(tc);
+    let learner_ids = learner_ids_for(&quorum_set, known_ids.clone());
+    let mut progress = VecProgress::<(u64, u64), _>::new(quorum_set, learner_ids, |id| (id, 0));
+
+    assert_matches_model(&progress, "initial");
+
+    let steps = tc.draw(generators::integers::<usize>().min_value(1).max_value(60));
+    for step in 0..steps {
+        let op = tc.draw(generators::integers::<u8>().max_value(9));
+        match op {
+            0..=5 => {
+                // Monotonic update; id 10 is never tracked and must be rejected.
+                let id = tc.draw(generators::integers::<u64>().max_value(10));
+                let delta = tc.draw(generators::integers::<u64>().max_value(7));
+                let current = progress.try_get(&id).map(|entry| entry.1);
+
+                let got = copy_option(progress.update_progress(&id, current.unwrap_or_default() + delta));
+
+                let want = model_quorum_accepted(&progress.quorum_set, &progress.entries);
+                let want_result = current.map(|_| want);
+                assert_eq!(want_result, got, "step {step}: update {id}");
+            }
+            6..=7 => {
+                // increase_to accepts non-monotonic input and clamps itself.
+                let id = tc.draw(generators::integers::<u64>().max_value(10));
+                let value = tc.draw(generators::integers::<u64>().max_value(100));
+                let got = copy_option(progress.increase_to(&id, value));
+                assert_eq!(progress.try_get(&id).map(|_| *progress.quorum_accepted()), got, "step {step}: increase_to {id}");
+            }
+            _ => {
+                let quorum_set = next_quorum_set(tc);
+                let learner_ids = learner_ids_for(&quorum_set, known_ids.clone());
+                let before = progress.iter().cloned().collect::<BTreeMap<_, _>>();
+                progress = progress.upgrade_quorum_set(quorum_set, learner_ids, |id| (id, 0));
+                // Every known id stays tracked and keeps its progress.
+                for id in &known_ids {
+                    assert_eq!(Some(&(*id, before[id])), progress.try_get(id), "step {step}: upgrade lost {id}");
+                }
+            }
+        }
+
+        assert_matches_model(&progress, &format!("step {step} op {op}"));
+        assert!(progress.validate().is_ok(), "step {step} op {op}: {:?}", progress.validate());
+    }
+}
+
+/// Model test over joint majority configs: a generated sequence of
+/// `update_progress`, `increase_to` and `upgrade_quorum_set` operations keeps
+/// `VecProgress` in agreement with the straightforward reference model
+/// (`model_quorum_accepted`) and preserves the internal voter ordering
+/// invariant.
+#[hegel::test]
+fn hegel_vec_progress_matches_reference_model(tc: hegel::TestCase) {
+    check_against_model(&tc, |tc| tc.draw(arb_quorum_config()));
+}
+
+/// The same model test with hierarchical `QuorumTree` quorum sets, including
+/// trees with `quorum_size` 0 (everything is a quorum) and deep nesting.
+#[hegel::test]
+fn hegel_vec_progress_matches_reference_model_with_trees(tc: hegel::TestCase) {
+    check_against_model(&tc, |tc| tc.draw(arb_quorum_tree(2)));
+}
+
+/// With `reset_entry_with` in the mix the documented contract is weaker: the
+/// quorum-accepted value never decreases (an accepted value is never
+/// withdrawn), it is never below what the current entries would justify, the
+/// ordering invariant still holds, and `upgrade_quorum_set` recomputes it
+/// exactly from the surviving entries.
+#[hegel::test]
+fn hegel_vec_progress_quorum_accepted_is_monotone_under_resets(tc: hegel::TestCase) {
+    let known_ids = (0..=9).collect::<Vec<u64>>();
+    let quorum_set = tc.draw(arb_quorum_config());
+    let learner_ids = learner_ids_for(&quorum_set, known_ids.clone());
+    let mut progress = VecProgress::<(u64, u64), _>::new(quorum_set, learner_ids, |id| (id, 0));
+
+    let steps = tc.draw(generators::integers::<usize>().min_value(1).max_value(60));
+    for step in 0..steps {
+        let before = *progress.quorum_accepted();
+        let op = tc.draw(generators::integers::<u8>().max_value(9));
+        match op {
+            0..=4 => {
+                let id = tc.draw(generators::integers::<u64>().max_value(9));
+                let delta = tc.draw(generators::integers::<u64>().max_value(7));
+                let current = progress.try_get(&id).map(|entry| entry.1).unwrap_or_default();
+                progress.update_progress(&id, current + delta);
+            }
+            5..=7 => {
+                // Reset one entry backward (or leave it, when the draw is above its value).
+                let id = tc.draw(generators::integers::<u64>().max_value(9));
+                let current = progress.try_get(&id).map(|entry| entry.1).unwrap_or_default();
+                let value = tc.draw(generators::integers::<u64>().max_value(current));
+                progress.reset_entry_with(&id, |entry| entry.1 = value);
+                assert_eq!(Some(&(id, value)), progress.try_get(&id), "step {step}: reset {id} to {value}");
+            }
+            _ => {
+                let quorum_set = tc.draw(arb_quorum_config());
+                let learner_ids = learner_ids_for(&quorum_set, known_ids.clone());
+                progress = progress.upgrade_quorum_set(quorum_set, learner_ids, |id| (id, 0));
+                // Recomputed from scratch: exact agreement with the model, no history.
+                assert_matches_model(&progress, &format!("step {step} upgrade"));
+                continue;
+            }
+        }
+
+        let after = *progress.quorum_accepted();
+        let model = model_quorum_accepted(&progress.quorum_set, &progress.entries);
+        assert!(after >= before, "step {step} op {op}: quorum_accepted fell {before} -> {after}: {:?}", progress.entries);
+        assert!(after >= model, "step {step} op {op}: quorum_accepted {after} below model {model}: {:?}", progress.entries);
+        assert!(progress.validate().is_ok(), "step {step} op {op}: {:?}", progress.validate());
+        assert_voter_prefix_is_sorted(&progress, &format!("step {step} op {op}"));
+    }
+}
diff --git a/src/quorum/quorum_intersection_test.rs b/src/quorum/quorum_intersection_test.rs
index be3b949..7645353 100644
--- a/src/quorum/quorum_intersection_test.rs
+++ b/src/quorum/quorum_intersection_test.rs
@@ -186,3 +186,188 @@ fn test_bridge_to_from_empty_joint_config() -> anyhow::Result<()> {
 
     Ok(())
 }
+
+// ---
+// Property-based tests (hegel).
+//
+// The bridge and soundness properties came to the zoo with openraft (where
+// the traits were called `Coherent::find_coherent` / `is_coherent_with`);
+// the `verify_intersection` properties were written for this crate.
+// ---
+
+use hegel::generators;
+
+use crate::quorum::QuorumSet;
+
+/// Number of node ids used for exhaustive quorum enumeration.
+///
+/// Kept small so that enumerating all `2^UNIVERSE` id subsets stays cheap.
+/// This bound protects the test's running time, not the library's contract.
+const UNIVERSE: u64 = 7;
+
+#[hegel::composite]
+fn small_config(tc: &hegel::TestCase) -> BTreeSet<u64> {
+    tc.draw(generators::vecs(generators::integers::<u64>().max_value(UNIVERSE - 1)).min_size(1).max_size(5))
+        .into_iter()
+        .collect()
+}
+
+/// A joint quorum set of 1 or 2 non-empty configs, as a Raft membership uses.
+///
+/// The empty joint (no config at all) accepts the empty set as a quorum, so by
+/// definition it has quorum intersection with nothing, itself included; it is
+/// covered by upstream's example tests and left out of the generated inputs.
+#[hegel::composite]
+fn small_joint(tc: &hegel::TestCase) -> Vec<BTreeSet<u64>> {
+    let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(2));
+    (0..n).map(|_| tc.draw(small_config())).collect()
+}
+
+/// A random quorum tree over the same universe, 1 to 4 distinct children,
+/// nesting depth at most `depth`.
+#[hegel::composite]
+fn small_tree(tc: &hegel::TestCase, depth: u8) -> QuorumTree<u64> {
+    let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+    let mut nodes = BTreeSet::new();
+    for _ in 0..n {
+        let node = if depth > 0 && tc.draw(generators::booleans()) {
+            Node::Subtree(tc.draw(small_tree(depth - 1)))
+        } else {
+            Node::Id(tc.draw(generators::integers::<u64>().max_value(UNIVERSE - 1)))
+        };
+        nodes.insert(node);
+    }
+    let quorum_size = tc.draw(generators::integers::<u64>().max_value(nodes.len() as u64));
+    QuorumTree::new(quorum_size, nodes).expect("distinct children with quorum_size <= len must build")
+}
+
+/// Enumerate every subset of `0..UNIVERSE` that `qs` accepts as a quorum,
+/// each represented as a bitmask over the ids.
+fn all_quorums<QS: QuorumSet<Id = u64>>(qs: &QS) -> Vec<u32> {
+    let mut quorums = Vec::new();
+    for mask in 0u32..(1 << UNIVERSE) {
+        let ids = (0..UNIVERSE).filter(|id| mask & (1 << id) != 0).collect::<Vec<_>>();
+        if qs.is_quorum(ids.iter()) {
+            quorums.push(mask);
+        }
+    }
+    quorums
+}
+
+/// Return true if every quorum in `a` intersects every quorum in `b`.
+fn quorums_pairwise_intersect(a: &[u32], b: &[u32]) -> bool {
+    a.iter().all(|qa| b.iter().all(|qb| qa & qb != 0))
+}
+
+/// The exact relation, by enumerating every quorum pair.
+fn exact_intersection<A, B>(a: &A, b: &B) -> bool
+where
+    A: QuorumSet<Id = u64>,
+    B: QuorumSet<Id = u64>,
+{
+    quorums_pairwise_intersect(&all_quorums(a), &all_quorums(b))
+}
+
+/// `bridge_to` must return an intermediate quorum set `X` with
+/// `self ~ X ~ other`: every quorum of `self` intersects every quorum of `X`,
+/// and every quorum of `X` intersects every quorum of `other`.
+///
+/// This is the safety property that makes joint-consensus membership change
+/// correct; it is checked against an exhaustive enumeration of all quorums.
+#[hegel::test]
+fn hegel_bridge_to_yields_pairwise_intersecting_quorums(tc: hegel::TestCase) {
+    let current: Vec<BTreeSet<u64>> = tc.draw(small_joint());
+    let goal: BTreeSet<u64> = tc.draw(small_config());
+
+    let intermediate = current.bridge_to(goal.clone());
+
+    assert!(
+        exact_intersection(&current, &intermediate),
+        "current {current:?} must have quorum intersection with intermediate {intermediate:?}"
+    );
+    assert!(
+        exact_intersection(&intermediate, &goal),
+        "intermediate {intermediate:?} must have quorum intersection with goal {goal:?}"
+    );
+}
+
+/// `intersects_with` may answer `None`, but a `Some` answer must be the exact
+/// relation: `Some(true)` only if every quorum pair intersects, `Some(false)`
+/// only if some pair is disjoint.
+#[hegel::test]
+fn hegel_intersects_with_is_sound(tc: hegel::TestCase) {
+    let a: Vec<BTreeSet<u64>> = tc.draw(small_joint());
+    let mut b: Vec<BTreeSet<u64>> = tc.draw(small_joint());
+
+    // Half of the time, force a shared config so that the `Some(true)` case is
+    // actually exercised; random independent draws rarely share a config.
+    if tc.draw(generators::booleans()) {
+        let from = tc.draw(generators::integers::<usize>().max_value(a.len() - 1));
+        let to = tc.draw(generators::integers::<usize>().max_value(b.len() - 1));
+        b[to] = a[from].clone();
+    }
+
+    if let Some(answer) = a.intersects_with(&b) {
+        assert_eq!(
+            exact_intersection(&a, &b),
+            answer,
+            "intersects_with({a:?}, {b:?}) answered Some({answer}) but the exact relation differs"
+        );
+    }
+}
+
+/// `verify_intersection` is documented as exact for any two `QuorumSet`
+/// implementations: it must agree with the pairwise enumeration for flat
+/// majorities, joints and trees, in every combination, and be symmetric.
+#[hegel::test]
+fn hegel_verify_intersection_is_exact_and_symmetric(tc: hegel::TestCase) {
+    let kind_a = tc.draw(generators::integers::<u8>().max_value(2));
+    let kind_b = tc.draw(generators::integers::<u8>().max_value(2));
+
+    let a = draw_quorum_set(&tc, kind_a);
+    let b = draw_quorum_set(&tc, kind_b);
+
+    let exact = quorums_pairwise_intersect(&a.quorums(), &b.quorums());
+    assert_eq!(exact, a.verify_with(&b), "verify_intersection({a:?}, {b:?})");
+    assert_eq!(exact, b.verify_with(&a), "verify_intersection must be symmetric: ({b:?}, {a:?})");
+}
+
+/// One of the crate's three `QuorumSet` implementations, drawn at random.
+#[derive(Debug)]
+enum AnyQuorumSet {
+    Flat(BTreeSet<u64>),
+    Joint(Vec<BTreeSet<u64>>),
+    Tree(QuorumTree<u64>),
+}
+
+fn draw_quorum_set(tc: &hegel::TestCase, kind: u8) -> AnyQuorumSet {
+    match kind {
+        0 => AnyQuorumSet::Flat(tc.draw(small_config())),
+        1 => AnyQuorumSet::Joint(tc.draw(small_joint())),
+        _ => AnyQuorumSet::Tree(tc.draw(small_tree(2))),
+    }
+}
+
+impl AnyQuorumSet {
+    fn quorums(&self) -> Vec<u32> {
+        match self {
+            AnyQuorumSet::Flat(q) => all_quorums(q),
+            AnyQuorumSet::Joint(q) => all_quorums(q),
+            AnyQuorumSet::Tree(q) => all_quorums(q),
+        }
+    }
+
+    fn verify_with(&self, other: &AnyQuorumSet) -> bool {
+        match (self, other) {
+            (AnyQuorumSet::Flat(a), AnyQuorumSet::Flat(b)) => verify_intersection(a, b),
+            (AnyQuorumSet::Flat(a), AnyQuorumSet::Joint(b)) => verify_intersection(a, b),
+            (AnyQuorumSet::Flat(a), AnyQuorumSet::Tree(b)) => verify_intersection(a, b),
+            (AnyQuorumSet::Joint(a), AnyQuorumSet::Flat(b)) => verify_intersection(a, b),
+            (AnyQuorumSet::Joint(a), AnyQuorumSet::Joint(b)) => verify_intersection(a, b),
+            (AnyQuorumSet::Joint(a), AnyQuorumSet::Tree(b)) => verify_intersection(a, b),
+            (AnyQuorumSet::Tree(a), AnyQuorumSet::Flat(b)) => verify_intersection(a, b),
+            (AnyQuorumSet::Tree(a), AnyQuorumSet::Joint(b)) => verify_intersection(a, b),
+            (AnyQuorumSet::Tree(a), AnyQuorumSet::Tree(b)) => verify_intersection(a, b),
+        }
+    }
+}
diff --git a/src/quorum/quorum_set_test.rs b/src/quorum/quorum_set_test.rs
index 721b526..6abe333 100644
--- a/src/quorum/quorum_set_test.rs
+++ b/src/quorum/quorum_set_test.rs
@@ -196,3 +196,259 @@ fn test_tree_dedupes_candidate_ids() -> anyhow::Result<()> {
 
     Ok(())
 }
+
+// ---
+// Property-based tests (hegel).
+//
+// The first three properties came to the zoo with openraft (which carried
+// this code before it was extracted into `quorum-set`); the `QuorumTree`
+// properties were written for this crate.
+// ---
+
+use hegel::generators;
+
+use crate::CanonicalId;
+use crate::QuorumTreeError;
+
+/// Independent oracle for the simple-majority rule: a set of granted ids is a
+/// quorum of `config` iff strictly more than half of the config members are
+/// granted.
+fn is_majority_oracle(config: &BTreeSet<u64>, granted: &BTreeSet<u64>) -> bool {
+    let overlap = config.intersection(granted).count();
+    overlap * 2 > config.len()
+}
+
+/// Node ids are mostly drawn from a small pool so that configs and granted
+/// sets collide often; occasionally full-range ids cover boundary values.
+#[hegel::composite]
+fn node_id(tc: &hegel::TestCase) -> u64 {
+    tc.draw(hegel::one_of!(
+        generators::integers::<u64>().max_value(9),
+        generators::integers::<u64>(),
+    ))
+}
+
+#[hegel::composite]
+fn id_set(tc: &hegel::TestCase, min_size: usize) -> BTreeSet<u64> {
+    tc.draw(generators::vecs(node_id()).min_size(min_size).max_size(9)).into_iter().collect()
+}
+
+/// A joint quorum set of 1 to 3 non-empty configs.
+#[hegel::composite]
+fn joint(tc: &hegel::TestCase) -> Vec<BTreeSet<u64>> {
+    let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+    (0..n).map(|_| tc.draw(id_set(1))).collect()
+}
+
+/// `BTreeSet::is_quorum` implements simple majority.
+#[hegel::test]
+fn hegel_majority_quorum_matches_counting_oracle(tc: hegel::TestCase) {
+    let config: BTreeSet<u64> = tc.draw(id_set(0));
+    let granted: BTreeSet<u64> = tc.draw(id_set(0));
+
+    let want = is_majority_oracle(&config, &granted);
+    assert_eq!(want, config.is_quorum(granted.iter()));
+}
+
+/// A joint quorum set grants iff the granted set is a majority in every config.
+#[hegel::test]
+fn hegel_joint_quorum_is_majority_in_every_config(tc: hegel::TestCase) {
+    let joint: Vec<BTreeSet<u64>> = tc.draw(joint());
+    let granted: BTreeSet<u64> = tc.draw(id_set(0));
+
+    let want = joint.iter().all(|config| is_majority_oracle(config, &granted));
+    assert_eq!(want, joint.is_quorum(granted.iter()));
+}
+
+/// The `QuorumSet` trait requires implementations to be upward-closed:
+/// adding more ids to a quorum must still be a quorum.
+#[hegel::test]
+fn hegel_quorum_is_upward_closed(tc: hegel::TestCase) {
+    let joint: Vec<BTreeSet<u64>> = tc.draw(joint());
+
+    // Draw the granted set mostly from the members so that quorums are common.
+    let members = joint.ids().collect::<Vec<_>>();
+    let mut granted = BTreeSet::new();
+    for id in members {
+        if tc.draw(generators::booleans()) {
+            granted.insert(id);
+        }
+    }
+    let extra: BTreeSet<u64> = tc.draw(id_set(0));
+    let bigger = granted.union(&extra).copied().collect::<BTreeSet<_>>();
+
+    if joint.is_quorum(granted.iter()) {
+        assert!(
+            joint.is_quorum(bigger.iter()),
+            "adding ids {extra:?} to quorum {granted:?} of {joint:?} must still be a quorum"
+        );
+    }
+}
+
+// --- QuorumTree ---
+
+/// Hegel prints drawn values; `QuorumTree` is this crate's own type, so give it
+/// a printed form (its human-readable `Display`) for counterexamples. The impl
+/// is crate-wide and serves the other test modules too.
+impl hegel::PrettyPrintable for QuorumTree<u64> {
+    fn pretty_print(&self, printer: &mut hegel::PrettyPrinter) {
+        hegel::pretty::print_debug_repr(&format!("{self}"), printer);
+    }
+}
+
+/// Leaf ids of generated trees live in `0..TREE_UNIVERSE`, so that granted
+/// sets drawn from the same range hit them often.
+const TREE_UNIVERSE: u64 = 7;
+
+/// A random quorum tree of the given maximum nesting depth with 1 to 4
+/// distinct children. Children are deduplicated (by `Node`'s ordering, which
+/// is the canonical id) and the quorum size is drawn in `0..=children`, so
+/// `QuorumTree::new` is required to succeed.
+#[hegel::composite]
+fn arb_tree(tc: &hegel::TestCase, depth: u8) -> QuorumTree<u64> {
+    let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+    let mut nodes = BTreeSet::new();
+    for _ in 0..n {
+        let node = if depth > 0 && tc.draw(generators::booleans()) {
+            Node::Subtree(tc.draw(arb_tree(depth - 1)))
+        } else {
+            Node::Id(tc.draw(generators::integers::<u64>().max_value(TREE_UNIVERSE - 1)))
+        };
+        nodes.insert(node);
+    }
+    let quorum_size = tc.draw(generators::integers::<u64>().max_value(nodes.len() as u64));
+    QuorumTree::new(quorum_size, nodes.clone())
+        .unwrap_or_else(|e| panic!("distinct children {nodes:?} with quorum_size {quorum_size} must build: {e}"))
+}
+
+/// Granted ids from the tree universe.
+#[hegel::composite]
+fn tree_granted(tc: &hegel::TestCase) -> BTreeSet<u64> {
+    tc.draw(generators::vecs(generators::integers::<u64>().max_value(TREE_UNIVERSE - 1)).max_size(8))
+        .into_iter()
+        .collect()
+}
+
+/// Independent model of the documented tree rule: a child counts when it is a
+/// granted leaf id or a satisfied subtree, and the tree is satisfied when at
+/// least `quorum_size` children count.
+fn tree_model(tree: &QuorumTree<u64>, granted: &BTreeSet<u64>) -> bool {
+    let selected = tree
+        .children()
+        .filter(|node| match node {
+            Node::Id(id) => granted.contains(id),
+            Node::Subtree(sub) => tree_model(sub, granted),
+        })
+        .count() as u64;
+    selected >= tree.quorum_size()
+}
+
+/// Every leaf id reachable in the tree, computed independently of `ids()`.
+fn tree_leaves(tree: &QuorumTree<u64>, out: &mut BTreeSet<u64>) {
+    for node in tree.children() {
+        match node {
+            Node::Id(id) => {
+                out.insert(*id);
+            }
+            Node::Subtree(sub) => tree_leaves(sub, out),
+        }
+    }
+}
+
+/// `QuorumTree::is_quorum` agrees with the documented counting rule, and
+/// `ids()` yields exactly the leaf ids, each once.
+#[hegel::test]
+fn hegel_tree_quorum_matches_counting_model(tc: hegel::TestCase) {
+    let tree: QuorumTree<u64> = tc.draw(arb_tree(2));
+    let granted: BTreeSet<u64> = tc.draw(tree_granted());
+
+    assert_eq!(tree_model(&tree, &granted), tree.is_quorum(granted.iter()), "tree {tree:?}");
+
+    let mut leaves = BTreeSet::new();
+    tree_leaves(&tree, &mut leaves);
+    let ids = tree.ids().collect::<Vec<_>>();
+    let id_set = ids.iter().copied().collect::<BTreeSet<_>>();
+    assert_eq!(ids.len(), id_set.len(), "ids() must yield each id once: {ids:?}");
+    assert_eq!(leaves, id_set, "ids() must be the leaf ids of {tree:?}");
+}
+
+/// The three `QuorumSet` rules hold for trees: upward-closed, closed over
+/// `ids()` (foreign ids never change the answer), duplicate-safe.
+#[hegel::test]
+fn hegel_tree_quorum_obeys_quorum_set_rules(tc: hegel::TestCase) {
+    let tree: QuorumTree<u64> = tc.draw(arb_tree(2));
+    let granted: BTreeSet<u64> = tc.draw(tree_granted());
+    let extra: BTreeSet<u64> = tc.draw(tree_granted());
+    let foreign: Vec<u64> =
+        tc.draw(generators::vecs(generators::integers::<u64>().min_value(TREE_UNIVERSE)).max_size(3));
+
+    let base = tree.is_quorum(granted.iter());
+
+    // Upward-closed.
+    if base {
+        let bigger = granted.union(&extra).copied().collect::<BTreeSet<_>>();
+        assert!(tree.is_quorum(bigger.iter()), "{tree:?}: {granted:?} is a quorum but {bigger:?} is not");
+    }
+
+    // Closed over ids(): ids the tree does not track never matter.
+    let with_foreign = granted.iter().copied().chain(foreign.iter().copied()).collect::<Vec<_>>();
+    assert_eq!(base, tree.is_quorum(with_foreign.iter()), "{tree:?}: foreign ids {foreign:?} changed the answer");
+
+    // Duplicate-safe.
+    let mut repeated = granted.iter().copied().collect::<Vec<_>>();
+    repeated.extend(granted.iter().copied());
+    repeated.extend(granted.iter().copied());
+    assert_eq!(base, tree.is_quorum(repeated.iter()), "{tree:?}: repeated ids changed the answer");
+}
+
+/// A tree's identity does not depend on the order its children were given in:
+/// building from a permutation of the same children gives an equal tree with
+/// the same canonical id and the same quorum decisions.
+#[hegel::test]
+fn hegel_tree_identity_is_independent_of_child_order(tc: hegel::TestCase) {
+    let tree: QuorumTree<u64> = tc.draw(arb_tree(2));
+    let granted: BTreeSet<u64> = tc.draw(tree_granted());
+
+    let mut children = tree.children().cloned().collect::<Vec<_>>();
+    let rotate = tc.draw(generators::integers::<usize>().max_value(children.len() - 1));
+    children.rotate_left(rotate);
+    if tc.draw(generators::booleans()) {
+        children.reverse();
+    }
+
+    let rebuilt = QuorumTree::new(tree.quorum_size(), children).expect("same children must build");
+
+    assert_eq!(tree, rebuilt);
+    assert_eq!(tree.canonical_id(), rebuilt.canonical_id());
+    assert_eq!(tree.is_quorum(granted.iter()), rebuilt.is_quorum(granted.iter()));
+    assert_eq!(tree.ids().collect::<Vec<_>>(), rebuilt.ids().collect::<Vec<_>>());
+}
+
+/// Construction rejects exactly the documented inputs: a repeated child is a
+/// `DuplicateChild` error naming that child, and a quorum size above the
+/// number of distinct children is `UnsatisfiableQuorum` with the right counts.
+#[hegel::test]
+fn hegel_tree_construction_errors_match_documentation(tc: hegel::TestCase) {
+    let tree: QuorumTree<u64> = tc.draw(arb_tree(1));
+    let children = tree.children().cloned().collect::<Vec<_>>();
+
+    // Duplicate a child: the error names it (the canonical id of the duplicate).
+    let dup = tc.draw(generators::integers::<usize>().max_value(children.len() - 1));
+    let mut with_dup = children.clone();
+    with_dup.push(children[dup].clone());
+    let err = QuorumTree::new(0, with_dup).expect_err("a repeated child must be rejected");
+    assert_eq!(
+        QuorumTreeError::DuplicateChild { canonical_id: children[dup].canonical_id() },
+        err,
+        "DuplicateChild must name the repeated child"
+    );
+
+    // Too large a quorum size: rejected with the exact counts.
+    let excess = tc.draw(generators::integers::<u64>().min_value(1).max_value(3));
+    let too_big = children.len() as u64 + excess;
+    let err = QuorumTree::new(too_big, children.clone()).expect_err("unsatisfiable size must be rejected");
+    assert_eq!(
+        QuorumTreeError::UnsatisfiableQuorum { quorum_size: too_big, num_children: children.len() },
+        err
+    );
+}
