+/// Run the given source in script mode, preserving the underlying build or VM
+/// error.
+///
+/// Unlike [`run`], this keeps the [`TestError`] intact so that property tests
+/// can match on the exact [`crate::runtime::VmErrorKind`].
+#[cfg(not(miri))]
+pub(crate) fn eval_result<T>(context: &Context, source: &str) -> Result<T, TestError>
+where
+    T: FromValue,
+{
+    let mut sources = sources(source);
+    let mut diagnostics = Diagnostics::default();
+    run_helper(context, &mut sources, &mut diagnostics, (), true)
+}
