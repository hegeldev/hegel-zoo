 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel).
+// ---------------------------------------------------------------------------
+
+use hegel::generators::{self, Generator};
+
+/// Property: rendering any `i64` as a decimal, hex, octal or binary literal
+/// (optionally with `_` digit separators and an optional `i64` suffix) and
+/// evaluating it yields the value back. Exercises the lexer's number handling
+/// and the negative-literal special case in HIR lowering, including
+/// `i64::MIN`.
+#[test]
+fn integer_literal_roundtrip_all_bases() {
+    let context = Context::with_default_modules().expect("failed to build context");
+
+    hegel::Hegel::new(|tc| {
+        let n: i64 = tc.draw(hegel::one_of!(
+            generators::integers::<i64>(),
+            generators::sampled_from(vec![i64::MIN, i64::MIN + 1, -1, 0, 1, i64::MAX]),
+        ));
+        let base: u8 = tc.draw(generators::integers::<u8>().max_value(3));
+        let separators = tc.draw(generators::booleans());
+        let suffix = tc.draw(generators::booleans());
+
+        let magnitude = n.unsigned_abs();
+
+        let mut digits = match base {
+            0 => format!("{magnitude}"),
+            1 => format!("{magnitude:x}"),
+            2 => format!("{magnitude:o}"),
+            _ => format!("{magnitude:b}"),
+        };
+
+        if separators {
+            let joined: Vec<String> = digits.chars().map(|c| c.to_string()).collect();
+            digits = joined.join("_");
+        }
+
+        let prefix = match base {
+            0 => "",
+            1 => "0x",
+            2 => "0o",
+            _ => "0b",
+        };
+
+        let sign = if n < 0 { "-" } else { "" };
+        let suffix = if suffix { "i64" } else { "" };
+        let src = format!("{sign}{prefix}{digits}{suffix}");
+
+        let out: i64 = match crate::tests::eval_result(&context, &src) {
+            Ok(out) => out,
+            Err(error) => panic!("failed to evaluate literal {src}: {error}"),
+        };
+
+        assert_eq!(out, n, "source: {src}");
+    })
+    .run();
+}
+
+/// Property: rendering any finite `f64` with Rust's shortest round-trip
+/// formatting and evaluating it as a Rune float literal yields the exact same
+/// bits back. Exercises the lexer's float handling including exponents,
+/// subnormals and negative zero.
+#[test]
+fn float_literal_roundtrip() {
+    let context = Context::with_default_modules().expect("failed to build context");
+
+    hegel::Hegel::new(|tc| {
+        let f: f64 = tc.draw(
+            generators::floats::<f64>()
+                .allow_nan(false)
+                .allow_infinity(false),
+        );
+
+        let src = format!("{f:?}");
+
+        let out: f64 = match crate::tests::eval_result(&context, &src) {
+            Ok(out) => out,
+            Err(error) => panic!("failed to evaluate float literal {src}: {error}"),
+        };
+
+        assert_eq!(
+            out.to_bits(),
+            f.to_bits(),
+            "expected {f:?}, got {out:?}\nsource: {src}"
+        );
+    })
+    .run();
+}
+
+/// Escape a string so it can be embedded in a double-quoted Rune string
+/// literal. When `force_unicode_escapes` is set every character is written as
+/// a `\u{..}` escape to exercise the escape parser; otherwise only characters
+/// that must be escaped are.
+fn escape_rune_string(s: &str, force_unicode_escapes: bool) -> String {
+    let mut out = String::new();
+
+    for c in s.chars() {
+        if force_unicode_escapes {
+            out.push_str(&format!("\\u{{{:x}}}", c as u32));
+            continue;
+        }
+
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{{{:x}}}", c as u32)),
+            c => out.push(c),
+        }
+    }
+
+    out
+}
+
+/// Property: any string, escaped and embedded as a Rune string literal,
+/// evaluates back to the original string. Exercises the lexer's string and
+/// unicode-escape handling on the full unicode range.
+#[test]
+fn string_literal_roundtrip() {
+    let context = Context::with_default_modules().expect("failed to build context");
+
+    hegel::Hegel::new(|tc| {
+        let s: String = tc.draw(generators::text());
+        let force_unicode_escapes = tc.draw(generators::booleans());
+
+        let src = format!("\"{}\"", escape_rune_string(&s, force_unicode_escapes));
+
+        let out: String = match crate::tests::eval_result(&context, &src) {
+            Ok(out) => out,
+            Err(error) => panic!("failed to evaluate string literal {src}: {error}"),
+        };
+
+        assert_eq!(out, s, "source: {src}");
+    })
+    .run();
+}
+
+/// Property: any char, escaped and embedded as a Rune char literal, evaluates
+/// back to the original char.
+#[test]
+fn char_literal_roundtrip() {
+    let context = Context::with_default_modules().expect("failed to build context");
+
+    hegel::Hegel::new(|tc| {
+        let c: char = tc.draw(
+            hegel::one_of!(
+                generators::integers::<u32>().max_value(0x7F),
+                generators::integers::<u32>().max_value(0x10_FFFF),
+            )
+            .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+        );
+
+        // The lexer rejects raw control characters (including DEL and the C1
+        // range) inside char literals, so those must use escapes.
+        let escaped = match c {
+            '\'' => "\\'".to_string(),
+            '\\' => "\\\\".to_string(),
+            c if c.is_control() => format!("\\u{{{:x}}}", c as u32),
+            c => c.to_string(),
+        };
+
+        let src = format!("'{escaped}'");
+
+        let out: char = match crate::tests::eval_result(&context, &src) {
+            Ok(out) => out,
+            Err(error) => panic!("failed to evaluate char literal {src}: {error}"),
+        };
+
+        assert_eq!(out, c, "source: {src}");
+    })
+    .run();
+}
diff --git a/crates/rune/src/tests/vm_arithmetic.rs b/crates/rune/src/tests/vm_arithmetic.rs
index 8ed642c..5d557be 100644
--- a/crates/rune/src/tests/vm_arithmetic.rs
+++ b/crates/rune/src/tests/vm_arithmetic.rs
@@ -295,3 +295,315 @@ fn pow_and_abs_report_an_overflow() {
     let out: Option<i64> = eval("(-9223372036854775808i64).checked_abs()");
     assert_eq!(out, None);
 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel).
+//
+// The VM implements integer arithmetic with checked operations
+// (`runtime/vm/ops.rs`): `+`/`*` raise `VmErrorKind::Overflow`, `-` raises
+// `Underflow`, and `/`/`%` raise `DivideByZero` when the checked operation
+// fails. These properties compare generated expressions against a Rust-side
+// checked `i64` reference implementation.
+// ---------------------------------------------------------------------------
+
+use hegel::generators;
+
+// The test prelude glob-imports `rune_alloc::Box`; the expression tree below
+// wants the infallible std `Box`.
+use rust_alloc::boxed::Box;
+
+/// Binary arithmetic operators covered by the checked reference.
+#[derive(Debug, Clone, Copy, hegel::PrettyPrintable)]
+pub(crate) enum ArithOp {
+    Add,
+    Sub,
+    Mul,
+    Div,
+    Rem,
+}
+
+impl ArithOp {
+    fn symbol(self) -> &'static str {
+        match self {
+            ArithOp::Add => "+",
+            ArithOp::Sub => "-",
+            ArithOp::Mul => "*",
+            ArithOp::Div => "/",
+            ArithOp::Rem => "%",
+        }
+    }
+
+    fn apply(self, a: i64, b: i64) -> Option<i64> {
+        match self {
+            ArithOp::Add => a.checked_add(b),
+            ArithOp::Sub => a.checked_sub(b),
+            ArithOp::Mul => a.checked_mul(b),
+            ArithOp::Div => a.checked_div(b),
+            ArithOp::Rem => a.checked_rem(b),
+        }
+    }
+}
+
+/// A generated arithmetic expression over `i64` literals.
+#[derive(Debug)]
+pub(crate) enum Expr {
+    Lit(i64),
+    Neg(Box<Expr>),
+    Bin(ArithOp, Box<Expr>, Box<Expr>),
+}
+
+/// Failure modes of the reference evaluator.
+#[derive(Debug, Clone, Copy)]
+pub(crate) enum RefError {
+    /// A checked binary operation failed; the VM reports this as an error
+    /// whose kind depends on the operator.
+    Arith(ArithOp),
+    /// `checked_div`/`checked_rem` failed with a non-zero divisor, i.e.
+    /// `i64::MIN / -1` (or `% -1`): an overflow, not a division by zero, and
+    /// the VM reports it as `Overflow` (found by a 10x hegel run).
+    DivOverflow,
+    /// `checked_neg` failed (negating `i64::MIN`).
+    NegOverflow,
+}
+
+/// Draw an `i64` literal, boosting boundary values where overflow bugs live.
+pub(crate) fn draw_literal(tc: &hegel::TestCase) -> i64 {
+    tc.draw(hegel::one_of!(
+        generators::integers::<i64>().min_value(-8).max_value(8),
+        generators::integers::<i64>(),
+        generators::sampled_from(vec![
+            i64::MIN,
+            i64::MIN + 1,
+            -1,
+            0,
+            1,
+            2,
+            i64::MAX - 1,
+            i64::MAX
+        ]),
+    ))
+}
+
+/// All binary operators the VM supports on `i64`.
+pub(crate) const ALL_OPS: [ArithOp; 5] = [
+    ArithOp::Add,
+    ArithOp::Sub,
+    ArithOp::Mul,
+    ArithOp::Div,
+    ArithOp::Rem,
+];
+
+/// Draw an expression tree of at most `depth` levels using the given binary
+/// operators.
+///
+/// `allow_neg` exists because unary expressions are not supported in const
+/// contexts, so the const-eval differential test excludes them (and passes a
+/// reduced operator set, since `%` is also unsupported there).
+pub(crate) fn draw_expr(tc: &hegel::TestCase, depth: u32, allow_neg: bool, ops: &[ArithOp]) -> Expr {
+    let max_choice = if depth == 0 { 1u8 } else { 4 };
+    let choice = tc.draw(generators::integers::<u8>().min_value(1).max_value(max_choice));
+
+    match choice {
+        1 => Expr::Lit(draw_literal(tc)),
+        2 if allow_neg => Expr::Neg(Box::new(draw_expr(tc, depth - 1, allow_neg, ops))),
+        _ => {
+            let op = tc.draw(generators::sampled_from(ops.to_vec()));
+            let lhs = Box::new(draw_expr(tc, depth - 1, allow_neg, ops));
+            let rhs = Box::new(draw_expr(tc, depth - 1, allow_neg, ops));
+            Expr::Bin(op, lhs, rhs)
+        }
+    }
+}
+
+/// Reference evaluation using Rust's checked `i64` arithmetic.
+pub(crate) fn eval_reference(expr: &Expr) -> Result<i64, RefError> {
+    match expr {
+        Expr::Lit(n) => Ok(*n),
+        Expr::Neg(inner) => eval_reference(inner)?
+            .checked_neg()
+            .ok_or(RefError::NegOverflow),
+        Expr::Bin(op, lhs, rhs) => {
+            let lhs = eval_reference(lhs)?;
+            let rhs = eval_reference(rhs)?;
+            op.apply(lhs, rhs).ok_or_else(|| match op {
+                ArithOp::Div | ArithOp::Rem if rhs != 0 => RefError::DivOverflow,
+                _ => RefError::Arith(*op),
+            })
+        }
+    }
+}
+
+/// Render the expression as fully parenthesized Rune source.
+pub(crate) fn render(expr: &Expr, out: &mut String) {
+    match expr {
+        Expr::Lit(n) => {
+            out.push('(');
+            out.push_str(&n.to_string());
+            out.push(')');
+        }
+        Expr::Neg(inner) => {
+            out.push_str("(-");
+            render(inner, out);
+            out.push(')');
+        }
+        Expr::Bin(op, lhs, rhs) => {
+            out.push('(');
+            render(lhs, out);
+            out.push(' ');
+            out.push_str(op.symbol());
+            out.push(' ');
+            render(rhs, out);
+            out.push(')');
+        }
+    }
+}
+
+/// Property: evaluating a generated arithmetic expression in the VM agrees
+/// with Rust's checked `i64` arithmetic, and checked failures surface as the
+/// documented `VmErrorKind`s instead of panicking.
+#[test]
+fn arithmetic_matches_checked_i64_reference() {
+    use crate::tests::TestError;
+
+    let context = Context::with_default_modules().expect("failed to build context");
+
+    hegel::Hegel::new(|tc| {
+        let depth = tc.draw(generators::integers::<u32>().max_value(4));
+        let expr = draw_expr(&tc, depth, true, &ALL_OPS);
+
+        let mut src = String::new();
+        render(&expr, &mut src);
+
+        let reference = match eval_reference(&expr) {
+            Err(RefError::NegOverflow) => {
+                // KNOWN BUG: negating `i64::MIN` is not checked in
+                // `Vm::op_neg` (runtime/vm.rs) — it panics in debug builds and
+                // wraps in release builds. Pinned by
+                // `negating_i64_min_is_not_checked` below; excluded here so
+                // the rest of the arithmetic surface stays covered.
+                tc.reject();
+            }
+            other => other,
+        };
+
+        let result = crate::tests::eval_result::<i64>(&context, &src);
+
+        match (reference, result) {
+            (Ok(expected), Ok(actual)) => {
+                assert_eq!(actual, expected, "source: {src}");
+            }
+            (Ok(expected), Err(error)) => {
+                panic!("expected {expected}, got error: {error}\nsource: {src}");
+            }
+            (Err(RefError::DivOverflow), Err(TestError::VmError(error))) => {
+                let kind = error.into_kind();
+                assert!(
+                    matches!(kind, Overflow),
+                    "unexpected error kind {kind:?} for i64::MIN / -1\nsource: {src}"
+                );
+            }
+            (Err(RefError::Arith(op)), Err(TestError::VmError(error))) => {
+                let kind = error.into_kind();
+                let ok = match op {
+                    ArithOp::Add | ArithOp::Mul => matches!(kind, Overflow),
+                    ArithOp::Sub => matches!(kind, Underflow),
+                    ArithOp::Div | ArithOp::Rem => matches!(kind, DivideByZero),
+                };
+                assert!(
+                    ok,
+                    "unexpected error kind {kind:?} for operator {op:?}\nsource: {src}"
+                );
+            }
+            (Err(reference), result) => {
+                panic!("expected VM error for {reference:?}, got {result:?}\nsource: {src}");
+            }
+        }
+    })
+    .run();
+}
+
+/// Property: shift operators agree with Rust's `checked_shl`/`checked_shr`
+/// combined with the `u32` conversion of the shift amount performed by
+/// `Vm::op_shift`.
+#[test]
+fn shift_ops_match_checked_reference() {
+    use crate::tests::TestError;
+
+    let context = Context::with_default_modules().expect("failed to build context");
+
+    hegel::Hegel::new(|tc| {
+        let value = draw_literal(&tc);
+        let shift: i64 = tc.draw(hegel::one_of!(
+            generators::integers::<i64>().min_value(0).max_value(70),
+            generators::integers::<i64>(),
+            generators::sampled_from(vec![-1, 63, 64, (u32::MAX as i64) + 1]),
+        ));
+        let shl = tc.draw(generators::booleans());
+
+        let symbol = if shl { "<<" } else { ">>" };
+        let src = format!("({value}) {symbol} ({shift})");
+
+        let expected = u32::try_from(shift).ok().and_then(|shift| {
+            if shl {
+                value.checked_shl(shift)
+            } else {
+                value.checked_shr(shift)
+            }
+        });
+
+        let result = crate::tests::eval_result::<i64>(&context, &src);
+
+        match (expected, result) {
+            (Some(expected), Ok(actual)) => {
+                assert_eq!(actual, expected, "source: {src}");
+            }
+            (Some(expected), Err(error)) => {
+                panic!("expected {expected}, got error: {error}\nsource: {src}");
+            }
+            (None, Err(TestError::VmError(_))) => {
+                // The exact error kind depends on the evaluation path: the
+                // `Shift` instruction reports `Overflow`/`Underflow` for
+                // in-range-but-too-large amounts, while amounts that don't
+                // fit in `u32` surface as `ValueToIntegerCoercionError`
+                // through the protocol-call path. Both are errors, which is
+                // the contract asserted here.
+            }
+            (None, result) => {
+                panic!("expected VM error, got {result:?}\nsource: {src}");
+            }
+        }
+    })
+    .run();
+}
+
+/// KNOWN FAILURE: `Vm::op_neg` (runtime/vm.rs) negates `Inline::Signed` with
+/// plain `-value` instead of `checked_neg`. Negating `i64::MIN` therefore
+/// panics with 'attempt to negate with overflow' in debug builds and silently
+/// wraps to `i64::MIN` in release builds, while every other arithmetic
+/// operator reports overflow as a `VmErrorKind`. The generator is pinned to
+/// the failing input so this reproduces deterministically.
+#[test]
+fn negating_i64_min_is_not_checked() {
+    use crate::tests::TestError;
+
+    let context = Context::with_default_modules().expect("failed to build context");
+
+    hegel::Hegel::new(|tc| {
+        let min = tc.draw(generators::just(i64::MIN));
+        let src = format!("let a = {min}; -a");
+
+        let result = crate::tests::eval_result::<i64>(&context, &src);
+
+        // The checked-arithmetic contract used by every other operator:
+        // negation overflow should surface as `VmErrorKind::Overflow`, not a
+        // panic (debug) or a silent wrap to `i64::MIN` (release).
+        assert!(
+            matches!(
+                &result,
+                Err(TestError::VmError(_))
+            ),
+            "expected a VM overflow error, got {result:?}\nsource: {src}"
+        );
+    })
+    .run();
+}
