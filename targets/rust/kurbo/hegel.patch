diff --git a/kurbo/src/affine.rs b/kurbo/src/affine.rs
index 80b2543..27f4bb7 100644
--- a/kurbo/src/affine.rs
+++ b/kurbo/src/affine.rs
@@ -862,4 +862,104 @@ mod tests {
             rotate_then_translate,
         );
     }
+
+    // ---- hegel property-based tests ----
+
+    use hegel::generators;
+
+    /// A matrix coefficient (or point coordinate) mixing everyday magnitudes
+    /// with large ones, bounded so the error analysis below stays meaningful.
+    fn draw_coeff(tc: &hegel::TestCase) -> f64 {
+        tc.draw(hegel::one_of!(
+            generators::floats::<f64>().min_value(-1.0).max_value(1.0),
+            generators::floats::<f64>().min_value(-1e3).max_value(1e3),
+            generators::floats::<f64>().min_value(-1e6).max_value(1e6),
+        ))
+    }
+
+    /// The doc comment on `Affine::new` promises `(A * B) * v == A * (B * v)`
+    /// — composition then application agrees with successive application.
+    /// Generalizes the three fixed points of the `affine_mul` unit test to
+    /// arbitrary matrices and points. The tolerance is scaled by the cube of
+    /// the largest input magnitude, matching the double matrix-vector
+    /// product's worst-case intermediate magnitude.
+    #[hegel::test]
+    fn affine_composition_associates_over_points(tc: hegel::TestCase) {
+        let a_coeffs = [
+            draw_coeff(&tc),
+            draw_coeff(&tc),
+            draw_coeff(&tc),
+            draw_coeff(&tc),
+            draw_coeff(&tc),
+            draw_coeff(&tc),
+        ];
+        let b_coeffs = [
+            draw_coeff(&tc),
+            draw_coeff(&tc),
+            draw_coeff(&tc),
+            draw_coeff(&tc),
+            draw_coeff(&tc),
+            draw_coeff(&tc),
+        ];
+        let p = Point::new(draw_coeff(&tc), draw_coeff(&tc));
+        let a = Affine::new(a_coeffs);
+        let b = Affine::new(b_coeffs);
+        let scale = a_coeffs
+            .iter()
+            .chain(b_coeffs.iter())
+            .chain([p.x, p.y].iter())
+            .fold(1.0_f64, |acc, c| acc.max(c.abs()));
+        let composed = (a * b) * p;
+        let successive = a * (b * p);
+        let eps = 1e-13 * scale.powi(3);
+        assert!(
+            (composed - successive).hypot() <= eps,
+            "(a*b)*p = {composed:?} != a*(b*p) = {successive:?} \
+             for a = {a:?}, b = {b:?}, p = {p:?}"
+        );
+    }
+
+    /// `inverse` documents NaN output only for zero determinant; for
+    /// well-conditioned invertible transforms (built here from rotations,
+    /// non-degenerate scales, and a translation) composing with the inverse
+    /// must give back the identity map, up to floating-point error.
+    /// Generalizes the single fixed matrix of the `affine_inv` unit test.
+    #[hegel::test]
+    fn affine_inverse_composes_to_identity(tc: hegel::TestCase) {
+        let th1 = tc.draw(generators::floats::<f64>().min_value(-10.0).max_value(10.0));
+        let th2 = tc.draw(generators::floats::<f64>().min_value(-10.0).max_value(10.0));
+        // Scales bounded away from 0 keep the condition number below ~400;
+        // negative values cover reflections.
+        let mut sx = tc.draw(generators::floats::<f64>().min_value(0.05).max_value(20.0));
+        let mut sy = tc.draw(generators::floats::<f64>().min_value(0.05).max_value(20.0));
+        if tc.draw(generators::booleans()) {
+            sx = -sx;
+        }
+        if tc.draw(generators::booleans()) {
+            sy = -sy;
+        }
+        let tvec = Vec2::new(
+            tc.draw(generators::floats::<f64>().min_value(-1e3).max_value(1e3)),
+            tc.draw(generators::floats::<f64>().min_value(-1e3).max_value(1e3)),
+        );
+        let a = Affine::translate(tvec)
+            * Affine::rotate(th1)
+            * Affine::scale_non_uniform(sx, sy)
+            * Affine::rotate(th2);
+        let p = Point::new(
+            tc.draw(generators::floats::<f64>().min_value(-1e3).max_value(1e3)),
+            tc.draw(generators::floats::<f64>().min_value(-1e3).max_value(1e3)),
+        );
+        let there_and_back = a.inverse() * (a * p);
+        let back_and_there = a * (a.inverse() * p);
+        let eps = 1e-8 * (1.0 + p.to_vec2().hypot() + tvec.hypot());
+        assert!(
+            (there_and_back - p).hypot() <= eps,
+            "a.inverse() * (a * {p:?}) = {there_and_back:?} for a = {a:?}"
+        );
+        assert!(
+            (back_and_there - p).hypot() <= eps,
+            "a * (a.inverse() * {p:?}) = {back_and_there:?} for a = {a:?}"
+        );
+    }
 }
diff --git a/kurbo/src/bezpath.rs b/kurbo/src/bezpath.rs
index a290df1..39d0830 100644
--- a/kurbo/src/bezpath.rs
+++ b/kurbo/src/bezpath.rs
@@ -2308,4 +2308,463 @@ mod tests {
             ]
         );
     }
+
+    // ---- hegel property-based tests ----
+
+    use hegel::generators;
+
+    /// A coordinate mixing everyday magnitudes with large ones, bounded at
+    /// ±1e9 so the tolerance-based properties below can scale their epsilon
+    /// by coordinate magnitude without becoming vacuous. The bound protects
+    /// the tests' floating-point oracles, not the library's contract; the
+    /// full finite range (where intermediate overflow produces NaN) is
+    /// exercised by `pathseg_eval_at_endpoints_matches_start_and_end`.
+    fn draw_coord(tc: &hegel::TestCase) -> f64 {
+        tc.draw(hegel::one_of!(
+            generators::floats::<f64>().min_value(-1.0).max_value(1.0),
+            generators::floats::<f64>().min_value(-1e3).max_value(1e3),
+            generators::floats::<f64>().min_value(-1e9).max_value(1e9),
+        ))
+    }
+
+    fn draw_pt(tc: &hegel::TestCase) -> Point {
+        Point::new(draw_coord(tc), draw_coord(tc))
+    }
+
+    fn draw_seg(tc: &hegel::TestCase) -> PathSeg {
+        match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => PathSeg::Line(Line::new(draw_pt(tc), draw_pt(tc))),
+            1 => PathSeg::Quad(QuadBez::new(draw_pt(tc), draw_pt(tc), draw_pt(tc))),
+            _ => PathSeg::Cubic(CubicBez::new(
+                draw_pt(tc),
+                draw_pt(tc),
+                draw_pt(tc),
+                draw_pt(tc),
+            )),
+        }
+    }
+
+    fn control_points(seg: &PathSeg) -> Vec<Point> {
+        match seg {
+            PathSeg::Line(l) => vec![l.p0, l.p1],
+            PathSeg::Quad(q) => vec![q.p0, q.p1, q.p2],
+            PathSeg::Cubic(c) => vec![c.p0, c.p1, c.p2, c.p3],
+        }
+    }
+
+    /// Largest control-point coordinate magnitude, floored at 1.0, used to
+    /// scale absolute tolerances.
+    fn seg_scale(seg: &PathSeg) -> f64 {
+        control_points(seg)
+            .iter()
+            .map(|p| p.x.abs().max(p.y.abs()))
+            .fold(1.0, f64::max)
+    }
+
+    /// `ParamCurve::start`/`end` document defaults of `eval(0.0)` and
+    /// `eval(1.0)`; the specialized overrides on `Line`, `QuadBez` and
+    /// `CubicBez` (which return the control points directly) must agree with
+    /// `eval` at the endpoints to within a few ULPs — and in particular
+    /// `eval` of an all-finite curve (`is_finite() == true`) at its
+    /// endpoints must not be NaN or infinite.
+    ///
+    /// KNOWN FAILURE — real bug, kept failing deliberately; do not "fix" the
+    /// test.
+    ///
+    /// Intermediate overflow makes `eval` return NaN or infinity at the
+    /// endpoints of finite curves with extreme (but finite, `is_finite() ==
+    /// true`) coordinates:
+    /// - `Line::eval` uses `lerp`, i.e. `p0 + t * (p1 - p0)`; when the
+    ///   endpoint coordinates have opposite signs and magnitude above
+    ///   ~9e307, `p1 - p0` overflows to infinity, so `eval(0.0)` is
+    ///   `0.0 * inf = NaN` and `eval(1.0)` is infinite. Example:
+    ///   `Line((0, -1.797e308), (0, 6.5e307))` has `eval(0.0) = (0, NaN)`.
+    /// - `QuadBez::eval`/`CubicBez::eval` multiply interior control points
+    ///   by 2 or 3 before scaling by `t`; for `|p1| > f64::MAX / 3`,
+    ///   `eval(0.0)` evaluates `(p1 * 3) * 0 = inf * 0 = NaN`.
+    ///
+    /// Coordinates cover the whole finite range; the `sampled_from` branch
+    /// boosts the extreme-magnitude region so the failure reproduces on
+    /// every run. Sibling tolerance-based properties cap coordinates at
+    /// ±1e9, which also keeps them clear of this bug.
+    #[hegel::test(test_cases = 300)]
+    fn pathseg_eval_at_endpoints_matches_start_and_end(tc: hegel::TestCase) {
+        fn coord(tc: &hegel::TestCase) -> f64 {
+            tc.draw(hegel::one_of!(
+                generators::floats::<f64>()
+                    .allow_nan(false)
+                    .allow_infinity(false),
+                generators::sampled_from(vec![f64::MAX, -f64::MAX, 1e308, -1e308, 6.5e307]),
+            ))
+        }
+        let seg = match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => PathSeg::Line(Line::new(
+                Point::new(coord(&tc), coord(&tc)),
+                Point::new(coord(&tc), coord(&tc)),
+            )),
+            1 => PathSeg::Quad(QuadBez::new(
+                Point::new(coord(&tc), coord(&tc)),
+                Point::new(coord(&tc), coord(&tc)),
+                Point::new(coord(&tc), coord(&tc)),
+            )),
+            _ => PathSeg::Cubic(CubicBez::new(
+                Point::new(coord(&tc), coord(&tc)),
+                Point::new(coord(&tc), coord(&tc)),
+                Point::new(coord(&tc), coord(&tc)),
+                Point::new(coord(&tc), coord(&tc)),
+            )),
+        };
+        let scale = seg_scale(&seg);
+        let eps = 1e-15 * scale;
+        let at0 = seg.eval(0.0);
+        let at1 = seg.eval(1.0);
+        // Componentwise max norm: the Euclidean norm of the difference can
+        // itself overflow for coordinate magnitudes above ~1e154, which
+        // would make the test's own oracle report spurious failures.
+        let d0 = at0 - seg.start();
+        let d1 = at1 - seg.end();
+        assert!(
+            d0.x.abs().max(d0.y.abs()) <= eps,
+            "eval(0.0) = {at0:?} differs from start() = {:?} for {seg:?}",
+            seg.start()
+        );
+        assert!(
+            d1.x.abs().max(d1.y.abs()) <= eps,
+            "eval(1.0) = {at1:?} differs from end() = {:?} for {seg:?}",
+            seg.end()
+        );
+    }
+
+    /// `subsegment(t0..t1)` is documented as "a subsegment of the curve for
+    /// the given parameter range": evaluating the subsegment at `s` must
+    /// match evaluating the original curve at `t0 + s * (t1 - t0)`.
+    /// Generalizes the fixed-value `quadbez_subsegment` unit test to all
+    /// three segment kinds and arbitrary ranges.
+    #[hegel::test]
+    fn pathseg_subsegment_matches_eval_reparameterization(tc: hegel::TestCase) {
+        let seg = draw_seg(&tc);
+        let mut t0 = tc.draw(generators::floats::<f64>().min_value(0.0).max_value(1.0));
+        let mut t1 = tc.draw(generators::floats::<f64>().min_value(0.0).max_value(1.0));
+        if t0 > t1 {
+            mem::swap(&mut t0, &mut t1);
+        }
+        let sub = seg.subsegment(t0..t1);
+        let eps = 1e-9 * seg_scale(&seg);
+        for i in 0..=16 {
+            let s = f64::from(i) / 16.0;
+            let expected = seg.eval(t0 + s * (t1 - t0));
+            let actual = sub.eval(s);
+            assert!(
+                (actual - expected).hypot() <= eps,
+                "subsegment({t0}..{t1}) of {seg:?} evaluated at {s}: {actual:?} != {expected:?}"
+            );
+        }
+    }
+
+    /// The arc length of a Bézier segment lies between the chord length and
+    /// the length of the control polygon (a standard consequence of the
+    /// convex hull property), so `arclen` — documented as "accurate to the
+    /// given accuracy" — must land between those bounds, give or take the
+    /// accuracy plus rounding slack.
+    #[hegel::test]
+    fn pathseg_arclen_between_chord_and_control_polygon(tc: hegel::TestCase) {
+        let seg = draw_seg(&tc);
+        // KNOWN BUG EXCLUSION: `QuadBez::arclen` returns NaN whenever its
+        // internal `a = d2.hypot2()` and `c = d1.hypot2()` both evaluate to
+        // 0 — point-degenerate quads (all three control points identical)
+        // and quads so small that the squared differences underflow (control
+        // point spread below ~1.5e-162): `a.powf(-0.5)` is infinite and
+        // `ba_c2` is `0 * inf = NaN`. Line and CubicBez return 0 for the
+        // analogous inputs. Pinned by `quadbez_arclen_of_point_quad_is_zero`
+        // in quadbez.rs; excluded here (by mirroring the internal condition)
+        // so this property keeps testing everything else.
+        if let PathSeg::Quad(q) = &seg {
+            let a = (q.p0.to_vec2() - 2.0 * q.p1.to_vec2() + q.p2.to_vec2()).hypot2();
+            let c = (q.p1 - q.p0).hypot2();
+            tc.assume(!(a == 0.0 && c == 0.0));
+        }
+        let scale = seg_scale(&seg);
+        // Accuracy is drawn relative to coordinate magnitude to keep the
+        // adaptive subdivision bounded for huge curves.
+        let rel_accuracy = tc.draw(generators::sampled_from(vec![1e-3, 1e-6, 1e-9]));
+        let accuracy = rel_accuracy * scale;
+        let len = seg.arclen(accuracy);
+        let pts = control_points(&seg);
+        let chord = (seg.end() - seg.start()).hypot();
+        let polygon: f64 = pts.windows(2).map(|w| (w[1] - w[0]).hypot()).sum();
+        let slack = accuracy + 1e-9 * scale;
+        assert!(
+            len >= chord - slack,
+            "arclen {len} shorter than chord {chord} (slack {slack}) for {seg:?}"
+        );
+        assert!(
+            len <= polygon + slack,
+            "arclen {len} longer than control polygon {polygon} (slack {slack}) for {seg:?}"
+        );
+    }
+
+    /// `ParamCurveExtrema::bounding_box` is documented as "the smallest
+    /// rectangle that encloses the curve in the range (0..1)". Check both
+    /// directions: every sampled curve point lies inside the box, and the
+    /// box lies inside the control-point bounding box (convex hull
+    /// property).
+    #[hegel::test]
+    fn pathseg_bounding_box_encloses_curve_within_control_box(tc: hegel::TestCase) {
+        let seg = draw_seg(&tc);
+        let bbox = ParamCurveExtrema::bounding_box(&seg);
+        let eps = 1e-9 * seg_scale(&seg);
+        for i in 0..=32 {
+            let t = f64::from(i) / 32.0;
+            let p = seg.eval(t);
+            assert!(
+                p.x >= bbox.x0 - eps
+                    && p.x <= bbox.x1 + eps
+                    && p.y >= bbox.y0 - eps
+                    && p.y <= bbox.y1 + eps,
+                "point {p:?} at t={t} outside bounding box {bbox:?} of {seg:?}"
+            );
+        }
+        let pts = control_points(&seg);
+        let mut cbox = Rect::from_points(pts[0], pts[1]);
+        for p in &pts[2..] {
+            cbox = cbox.union_pt(*p);
+        }
+        assert!(
+            bbox.x0 >= cbox.x0 - eps
+                && bbox.x1 <= cbox.x1 + eps
+                && bbox.y0 >= cbox.y0 - eps
+                && bbox.y1 <= cbox.y1 + eps,
+            "bounding box {bbox:?} exceeds control box {cbox:?} of {seg:?}"
+        );
+    }
+
+    /// `nearest` is documented as "the position on the curve that is nearest
+    /// to the given point". Check the returned `Nearest` is internally
+    /// consistent (`distance_sq` matches evaluating at `t`), that `t` lies
+    /// in [0, 1], and that no sampled point on the curve is closer than the
+    /// claimed nearest distance.
+    ///
+    /// The `accuracy` argument reaches polycool's `roots_between` as
+    /// `x_error`, i.e. it is a tolerance on `t`, not on distance, so the
+    /// distance slack is `accuracy` times a bound on the curve's speed
+    /// (`|B'(t)| <= 3 * max control leg length`).
+    #[hegel::test]
+    fn pathseg_nearest_is_at_least_as_close_as_sampled_points(tc: hegel::TestCase) {
+        let seg = draw_seg(&tc);
+        let p = draw_pt(&tc);
+        let scale = seg_scale(&seg).max(p.x.abs()).max(p.y.abs());
+        let accuracy = 1e-9;
+        let nearest = seg.nearest(p, accuracy);
+        assert!(
+            (0.0..=1.0).contains(&nearest.t),
+            "nearest t {} out of range for {seg:?}, query {p:?}",
+            nearest.t
+        );
+        let d_claimed = nearest.distance_sq.sqrt();
+        let d_at_t = (seg.eval(nearest.t) - p).hypot();
+        assert!(
+            (d_claimed - d_at_t).abs() <= 1e-9 * scale,
+            "distance_sq {} inconsistent with eval({}) for {seg:?}, query {p:?}",
+            nearest.distance_sq,
+            nearest.t
+        );
+        let pts = control_points(&seg);
+        let max_speed = 3.0
+            * pts
+                .windows(2)
+                .map(|w| (w[1] - w[0]).hypot())
+                .fold(0.0, f64::max);
+        let slack = accuracy * max_speed + 1e-9 * scale;
+        for i in 0..=32 {
+            let t = f64::from(i) / 32.0;
+            let d_sample = (seg.eval(t) - p).hypot();
+            assert!(
+                d_claimed <= d_sample + slack,
+                "nearest distance {d_claimed} beaten by sample at t={t} \
+                 (distance {d_sample}) for {seg:?}, query {p:?}"
+            );
+        }
+    }
+
+    /// `flatten` documents that the output is made of straight-line elements
+    /// only, and that the polyline approximates the curve to within
+    /// `tolerance` (Hausdorff distance). Sampling points on the source curve
+    /// and measuring their distance to the emitted polyline is a lower bound
+    /// on the Hausdorff distance, so it must stay within tolerance.
+    ///
+    /// The docs hedge that the bound is "not absolutely guaranteed", and
+    /// indeed hairpin quads (endpoints nearly mirrored across the apex, e.g.
+    /// `Q0,2 56.4,0 0,0` at tolerance 0.125) exceed it by ~7%, so this test
+    /// allows 2x tolerance; the *unbounded* violations from degenerate quads
+    /// are a separate pinned bug (see the exclusion below and
+    /// `flatten_collapses_exactly_degenerate_quads`).
+    #[hegel::test]
+    fn flatten_stays_within_tolerance(tc: hegel::TestCase) {
+        fn small_pt(tc: &hegel::TestCase) -> Point {
+            Point::new(
+                tc.draw(generators::floats::<f64>().min_value(-100.0).max_value(100.0)),
+                tc.draw(generators::floats::<f64>().min_value(-100.0).max_value(100.0)),
+            )
+        }
+        // Distance from `p` to the segment [a, b], written out here rather
+        // than borrowed from `Line::nearest` so the oracle is independent of
+        // the code under test.
+        fn dist_to_segment(p: Point, a: Point, b: Point) -> f64 {
+            let d = b - a;
+            let h2 = d.hypot2();
+            if h2 == 0.0 {
+                return (p - a).hypot();
+            }
+            let t = ((p - a).dot(d) / h2).clamp(0.0, 1.0);
+            (p - (a + d * t)).hypot()
+        }
+
+        let tolerance = tc.draw(generators::floats::<f64>().min_value(0.01).max_value(1.0));
+        let mut path = BezPath::new();
+        path.move_to(small_pt(&tc));
+        let n_segs = tc.draw(generators::integers::<u8>().min_value(1).max_value(3));
+        for _ in 0..n_segs {
+            match tc.draw(generators::integers::<u8>().max_value(2)) {
+                0 => path.line_to(small_pt(&tc)),
+                1 => path.quad_to(small_pt(&tc), small_pt(&tc)),
+                _ => path.curve_to(small_pt(&tc), small_pt(&tc), small_pt(&tc)),
+            }
+        }
+        // KNOWN BUG EXCLUSION: quads whose flattening parabola transform is
+        // degenerate — `cross == 0` exactly in `QuadBez::estimate_subdiv`
+        // (coincident endpoints or exactly collinear control points), or so
+        // close to it that the internally computed `scale` underflows to 0 —
+        // are collapsed to a single segment at any tolerance, losing the
+        // whole excursion. Pinned by
+        // `flatten_collapses_exactly_degenerate_quads` below; excluded here
+        // (including for the quads a cubic is subdivided into) so this
+        // property keeps testing everything else, near-degenerate cusps
+        // included.
+        fn quad_is_degenerate_for_flatten(q: &QuadBez) -> bool {
+            let dd = (q.p1 - q.p0) - (q.p2 - q.p1);
+            let cross = (q.p2 - q.p0).cross(dd);
+            cross.abs() <= 1e-150 * dd.hypot2()
+        }
+        for seg in path.segments() {
+            match seg {
+                PathSeg::Quad(q) => tc.assume(!quad_is_degenerate_for_flatten(&q)),
+                PathSeg::Cubic(c) => {
+                    for (_, _, q) in c.to_quads(tolerance * TO_QUAD_TOL) {
+                        tc.assume(!quad_is_degenerate_for_flatten(&q));
+                    }
+                }
+                PathSeg::Line(_) => {}
+            }
+        }
+
+        let mut polyline: Vec<Point> = Vec::new();
+        flatten(path.elements().iter().copied(), tolerance, |el| match el {
+            PathEl::MoveTo(p) | PathEl::LineTo(p) => {
+                // The segment count is documented to scale with the inverse
+                // square root of tolerance; for coordinates within ±100 and
+                // tolerance >= 0.01 a polyline of a million points is far
+                // beyond any plausible bound. Failing here keeps a
+                // subdivision-count blowup shrinkable instead of dying on
+                // out-of-memory.
+                assert!(
+                    polyline.len() < 1_000_000,
+                    "flatten emitted over a million elements for {:?} at tolerance {tolerance}",
+                    path.elements()
+                );
+                polyline.push(p);
+            }
+            other => panic!("flatten emitted a non-line element: {other:?}"),
+        });
+
+        for seg in path.segments() {
+            for i in 0..=32 {
+                let t = f64::from(i) / 32.0;
+                let p = seg.eval(t);
+                let dist = polyline
+                    .windows(2)
+                    .map(|w| dist_to_segment(p, w[0], w[1]))
+                    .fold(f64::INFINITY, f64::min);
+                assert!(
+                    dist <= tolerance * 2.0 + 1e-12,
+                    "curve point {p:?} at t={t} is {dist} from the polyline, \
+                     beyond 2x tolerance {tolerance}, for segment {seg:?}"
+                );
+            }
+        }
+    }
+
+    /// KNOWN FAILURE — real bug, kept failing deliberately; do not "fix" the
+    /// test.
+    ///
+    /// `flatten` collapses a quad whose parabola transform is exactly
+    /// degenerate to a single line segment between its endpoints, at *any*
+    /// tolerance, losing an arbitrarily large excursion. In
+    /// `QuadBez::estimate_subdiv`, `cross = (p2 - p0).cross(d01 - d12)` is
+    /// exactly 0 when the endpoints coincide (a "petal", regardless of where
+    /// the control point is) or when the control points are exactly
+    /// collinear and the curve retraces itself; `scale` is then NaN, `val`
+    /// becomes 0, and a single segment is emitted. Concretely, flattening
+    /// `M0,0 Q50,80 0,0` at tolerance 0.01 emits only
+    /// `[MoveTo((0,0)), LineTo((0,0))]` even though the curve extends to
+    /// (25, 40) — a Hausdorff error of ~47, unbounded in general (compare
+    /// the doc's "attempts to bound this distance"). Exactly collinear
+    /// retraced quads (e.g. `Q(0,3) 0,1` from the origin, apex error 0.75 at
+    /// any tolerance) collapse the same way, cubics reach the same code path
+    /// via `to_quads`, and there is an underflow variant: endpoints distinct
+    /// but so close relative to the control excursion (chord below ~1e-244)
+    /// that the internally computed `scale` underflows to 0.
+    ///
+    /// Every case generated here is an exact petal whose excursion exceeds
+    /// the tolerance several times over, so this test fails
+    /// deterministically on every run.
+    #[hegel::test]
+    fn flatten_collapses_exactly_degenerate_quads(tc: hegel::TestCase) {
+        fn dist_to_segment(p: Point, a: Point, b: Point) -> f64 {
+            let d = b - a;
+            let h2 = d.hypot2();
+            if h2 == 0.0 {
+                return (p - a).hypot();
+            }
+            let t = ((p - a).dot(d) / h2).clamp(0.0, 1.0);
+            (p - (a + d * t)).hypot()
+        }
+
+        let tolerance = tc.draw(generators::floats::<f64>().min_value(0.01).max_value(1.0));
+        let p0 = Point::new(
+            tc.draw(generators::floats::<f64>().min_value(-100.0).max_value(100.0)),
+            tc.draw(generators::floats::<f64>().min_value(-100.0).max_value(100.0)),
+        );
+        // An excursion well beyond the maximum tolerance of 1.0. Using an
+        // exact petal (p2 == p0) guarantees `cross` is exactly zero, so the
+        // collapse reproduces on every single case.
+        let offset = Vec2::new(
+            tc.draw(generators::floats::<f64>().min_value(10.0).max_value(100.0)),
+            tc.draw(generators::floats::<f64>().min_value(10.0).max_value(100.0)),
+        );
+        let (p1, p2) = (p0 + offset, p0);
+        let mut path = BezPath::new();
+        path.move_to(p0);
+        path.quad_to(p1, p2);
+
+        let mut polyline: Vec<Point> = Vec::new();
+        flatten(path.elements().iter().copied(), tolerance, |el| match el {
+            PathEl::MoveTo(p) | PathEl::LineTo(p) => polyline.push(p),
+            other => panic!("flatten emitted a non-line element: {other:?}"),
+        });
+
+        let quad = QuadBez::new(p0, p1, p2);
+        for i in 0..=32 {
+            let t = f64::from(i) / 32.0;
+            let p = quad.eval(t);
+            let dist = polyline
+                .windows(2)
+                .map(|w| dist_to_segment(p, w[0], w[1]))
+                .fold(f64::INFINITY, f64::min);
+            assert!(
+                dist <= tolerance * 1.001 + 1e-12,
+                "curve point {p:?} at t={t} is {dist} from the polyline, \
+                 beyond tolerance {tolerance}, for {quad:?}"
+            );
+        }
+    }
 }
diff --git a/kurbo/src/quadbez.rs b/kurbo/src/quadbez.rs
index 5a68283..2f1520b 100644
--- a/kurbo/src/quadbez.rs
+++ b/kurbo/src/quadbez.rs
@@ -591,4 +591,38 @@ mod tests {
