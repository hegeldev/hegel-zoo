         assert!(len.is_finite());
     }
+
+    // ---- hegel property-based tests ----
+
+    use hegel::generators;
+
+    /// KNOWN FAILURE — real bug, kept failing deliberately; do not "fix" the
+    /// test.
+    ///
+    /// `QuadBez::arclen` returns NaN for a point-degenerate quad (all three
+    /// control points identical), where the correct arc length is 0. In the
+    /// analytic formula both `a` (from `d2 == 0`) and `c` (from `d1 == 0`)
+    /// are zero, so the nearly-straight fallback check `a < 5e-4 * c` fails,
+    /// `a.powf(-0.5)` is infinite, and `ba_c2 = b * a2 + c2` is `0 * inf =
+    /// NaN`. `Line::arclen` and `CubicBez::arclen` both return 0 for the
+    /// analogous degenerate inputs, and `perimeter_not_nan` above (#477)
+    /// shows NaN-freedom is intended. Point-degenerate quads occur in
+    /// practice as the closing segment of paths whose pen position never
+    /// moves.
+    ///
+    /// The same NaN also arises for any quad small enough that both squared
+    /// control-point differences underflow to 0 (spread below ~1.5e-162),
+    /// e.g. `QuadBez((0,0), (0,4.4e-302), (0,5e-324))`.
+    ///
+    /// Fails deterministically: every generated case is a point quad.
+    #[hegel::test]
+    fn quadbez_arclen_of_point_quad_is_zero(tc: hegel::TestCase) {
+        let p = Point::new(
+            tc.draw(generators::floats::<f64>().min_value(-1e9).max_value(1e9)),
+            tc.draw(generators::floats::<f64>().min_value(-1e9).max_value(1e9)),
+        );
+        let q = QuadBez::new(p, p, p);
+        let len = q.arclen(1e-9);
+        assert_eq!(len, 0.0, "arclen of the point quad at {p:?} is {len}");
+    }
 }
diff --git a/kurbo/src/svg.rs b/kurbo/src/svg.rs
index 0935381..bd41f43 100644
--- a/kurbo/src/svg.rs
+++ b/kurbo/src/svg.rs
@@ -689,4 +689,166 @@ mod tests {
             assert_eq!(vec, deser_vec);
         }
     }
+
+    // ---- hegel property-based tests ----
+
+    use core::f64::consts::PI;
+
+    use crate::{Arc, Vec2};
+    use hegel::generators;
+
+    use super::SvgArc;
+
+    fn draw_finite_f64(tc: &hegel::TestCase) -> f64 {
+        tc.draw(
+            generators::floats::<f64>()
+                .allow_nan(false)
+                .allow_infinity(false),
+        )
+    }
+
+    fn draw_finite_point(tc: &hegel::TestCase) -> Point {
+        Point::new(draw_finite_f64(tc), draw_finite_f64(tc))
+    }
+
+    /// Round-trip property: writing a path with `to_svg` and parsing it back
+    /// with `from_svg` must preserve the path's segments exactly.
+    ///
+    /// This supplements `test_serialize_deserialize` above, which draws
+    /// coordinates only from `[0, 1)` and never generates `ClosePath` or
+    /// mid-path `MoveTo` elements. Coordinates here cover the whole finite
+    /// `f64` range (Rust's float `Display` output round-trips exactly, and
+    /// the SVG number lexer accepts plain decimal notation), and paths can
+    /// close and restart subpaths.
+    #[hegel::test]
+    fn svg_roundtrip_preserves_segments_full_float_range(tc: hegel::TestCase) {
+        let mut path = BezPath::new();
+        path.move_to(draw_finite_point(&tc));
+        let n_ops = tc.draw(generators::integers::<usize>().max_value(10));
+        for _ in 0..n_ops {
+            match tc.draw(generators::integers::<u8>().max_value(4)) {
+                0 => path.move_to(draw_finite_point(&tc)),
+                1 => path.line_to(draw_finite_point(&tc)),
+                2 => path.quad_to(draw_finite_point(&tc), draw_finite_point(&tc)),
+                3 => path.curve_to(
+                    draw_finite_point(&tc),
+                    draw_finite_point(&tc),
+                    draw_finite_point(&tc),
+                ),
+                _ => path.close_path(),
+            }
+        }
+        let svg = path.to_svg();
+        let reparsed = BezPath::from_svg(&svg)
+            .unwrap_or_else(|e| panic!("failed to re-parse {svg:?}: {e}"));
+        let original: Vec<PathSeg> = path.segments().collect();
+        let roundtripped: Vec<PathSeg> = reparsed.segments().collect();
+        assert_eq!(
+            original, roundtripped,
+            "segments changed through SVG round-trip of {svg:?}"
+        );
+    }
+
+    /// `from_svg` is documented as "try to parse", returning a `Result`; it
+    /// must never panic, even on garbage input. The second generator branch
+    /// draws from the SVG path character set so that near-miss inputs
+    /// (commands with too few arguments, stray signs and dots, etc.) are
+    /// actually reached rather than being rejected at the first byte.
+    #[hegel::test(test_cases = 250)]
+    fn from_svg_never_panics(tc: hegel::TestCase) {
+        let s: String = tc.draw(hegel::one_of!(
+            generators::text().max_size(64),
+            generators::from_regex(r"[MmLlHhVvQqTtCcSsAaZz0-9eE+., \-]{0,64}").fullmatch(true),
+        ));
+        drop(BezPath::from_svg(&s));
+    }
+
+    /// `Arc::from_svg_arc` accepts any `SvgArc` (in `from_svg` it is fed
+    /// directly from parsed path data, which can contain arbitrary numbers)
+    /// and must not panic; its only documented escape hatch is returning
+    /// `None` for straight lines.
+    ///
+    /// The magnitude tiers deliberately probe the underflow/overflow regions
+    /// where geometry code tends to collapse to 0 or NaN: nearly coincident
+    /// endpoints (products of tiny differences square to zero) as well as
+    /// the full finite range.
+    #[hegel::test(test_cases = 500)]
+    fn arc_from_svg_arc_never_panics(tc: hegel::TestCase) {
+        fn coord(tc: &hegel::TestCase) -> f64 {
+            tc.draw(hegel::one_of!(
+                generators::floats::<f64>().min_value(-1e3).max_value(1e3),
+                // Tiny magnitudes: differences below ~1.5e-162 square to 0.
+                generators::floats::<f64>().min_value(-1e-150).max_value(1e-150),
+                generators::floats::<f64>().min_value(-1e-160).max_value(1e-160),
+                generators::floats::<f64>().allow_nan(false).allow_infinity(false),
+            ))
+        }
+        let arc = SvgArc {
+            from: Point::new(coord(&tc), coord(&tc)),
+            to: Point::new(coord(&tc), coord(&tc)),
+            radii: Vec2::new(coord(&tc), coord(&tc)),
+            x_rotation: coord(&tc),
+            large_arc: tc.draw(generators::booleans()),
+            sweep: tc.draw(generators::booleans()),
+        };
+        // KNOWN BUG EXCLUSION: when the products of the radii with the
+        // rotated half-difference of the endpoints all underflow to zero,
+        // `from_svg_arc` hits `debug_assert!(sum_of_sq != 0.0)`. Pinned by
+        // `arc_from_svg_arc_underflow_breaks_internal_assertion` below;
+        // excluded here (by mirroring the underflow condition) so this test
+        // keeps probing the rest of the input space.
+        let (sin_phi, cos_phi) = (arc.x_rotation % (2.0 * PI)).sin_cos();
+        let hd_x = (arc.from.x - arc.to.x) * 0.5;
+        let hd_y = (arc.from.y - arc.to.y) * 0.5;
+        let px = cos_phi * hd_x + sin_phi * hd_y;
+        let py = -sin_phi * hd_x + cos_phi * hd_y;
+        let underflows = (arc.radii.x.abs() * py).powi(2) + (arc.radii.y.abs() * px).powi(2) == 0.0;
+        tc.assume(arc.is_straight_line() || !underflows);
+        let _ = Arc::from_svg_arc(&arc);
+    }
+
+    /// KNOWN FAILURE — real bug, kept failing deliberately; do not "fix" the
+    /// test.
+    ///
+    /// `Arc::from_svg_arc` guards only against `is_straight_line()` (radii
+    /// smaller than 1e-5 or exactly coincident endpoints) before asserting
+    /// `sum_of_sq != 0.0`. For endpoints that are distinct but closer than
+    /// roughly 3e-162 (relative to the radii), `rx * p.y` and `ry * p.x`
+    /// both underflow to zero when squared, so the assertion fails: a panic
+    /// in debug builds. In release builds the subsequent division by
+    /// `sum_of_sq == 0` produces an infinite/NaN arc center instead of a
+    /// finite arc. Example: `from = (1e-170, 0)`, `to = (0, 0)`,
+    /// `radii = (1, 1)`.
+    ///
+    /// Every case generated here is in the underflow family, so the test
+    /// fails deterministically on every run.
+    #[hegel::test]
+    fn arc_from_svg_arc_underflow_breaks_internal_assertion(tc: hegel::TestCase) {
+        fn tiny(tc: &hegel::TestCase) -> f64 {
+            tc.draw(generators::floats::<f64>().min_value(-1e-165).max_value(1e-165))
+        }
+        let from = Point::new(tiny(&tc), tiny(&tc));
+        tc.assume(from != Point::ORIGIN);
+        let arc = SvgArc {
+            from,
+            to: Point::ORIGIN,
+            radii: Vec2::new(
+                tc.draw(generators::floats::<f64>().min_value(1e-4).max_value(1e3)),
+                tc.draw(generators::floats::<f64>().min_value(1e-4).max_value(1e3)),
+            ),
+            x_rotation: tc.draw(generators::floats::<f64>().min_value(-10.0).max_value(10.0)),
+            large_arc: tc.draw(generators::booleans()),
+            sweep: tc.draw(generators::booleans()),
+        };
+        assert!(!arc.is_straight_line(), "generator bug: arc became a line");
+        // In debug builds the debug_assert panics before returning; in
+        // release builds the returned arc has a non-finite center.
+        if let Some(arc) = Arc::from_svg_arc(&arc) {
+            assert!(
+                arc.center.is_finite(),
+                "from_svg_arc returned non-finite center {:?}",
+                arc.center
+            );
+        }
+    }
 }
