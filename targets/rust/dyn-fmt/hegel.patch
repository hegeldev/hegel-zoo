+//! Hegel property tests for dyn-fmt, the run-time `{}` formatter.
+//!
+//! The contract (rustdoc): `"…".format(args)` "creates a String replacing the {}s within self
+//! using provided parameters in the order given", "extra arguments are ignored, missing
+//! arguments are replaced by empty string", `{{`/`}}` are literal braces — "a runtime analog of
+//! `format!`"; `Arguments::new` is the analog of `format_args!` and `dyn_write!` of `write!`.
+//! The oracle is that sentence: a format string is generated piece by piece (text, `{{`, `}}`,
+//! `{}`) alongside the text `format!` would produce for it.
+
+use dyn_fmt::{dyn_write, Arguments, AsStrFormatExt};
+use hegel::generators::Generator as _;
+use hegel::{generators, TestCase};
+use std::fmt::{self, Display, Write as _};
+use std::io::Write as _;
+
+// ---------------------------------------------------------------- generators
+
+fn ints(lo: i64, hi: i64) -> generators::IntegerGenerator<i64> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// Text characters: anything but a brace, with multi-byte and punctuation well represented.
+const TEXT: &str = "abcxyzAZ09 ,.;:-_/\\!#$%&*+=<>|~'\"@`\t\néßüЖ日本€😀\u{0}\u{7f}";
+
+/// Brace-free text of `lo..=hi` characters.
+fn plain_text(lo: usize, hi: usize) -> generators::TextGenerator {
+    generators::text().alphabet(TEXT).min_size(lo).max_size(hi)
+}
+
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Piece {
+    Text(String),
+    OpenEsc,
+    CloseEsc,
+    Hole,
+}
+
+/// One piece of a format string: text and holes most of the time, an escaped brace now and then.
+fn piece() -> impl hegel::PrintableGenerator<Piece> {
+    hegel::one_of!(
+        plain_text(1, 6).map(Piece::Text),
+        plain_text(1, 6).map(Piece::Text),
+        generators::just(Piece::Hole),
+        generators::just(Piece::Hole),
+        generators::sampled_from(&[Piece::OpenEsc, Piece::CloseEsc]),
+    )
+}
+
+fn pieces() -> generators::VecGenerator<impl hegel::PrintableGenerator<Piece>, Piece> {
+    generators::vecs(piece()).max_size(8)
+}
+
+fn fmt_string(pieces: &[Piece]) -> String {
+    let mut s = String::new();
+    for p in pieces {
+        match p {
+            Piece::Text(t) => s.push_str(t),
+            Piece::OpenEsc => s.push_str("{{"),
+            Piece::CloseEsc => s.push_str("}}"),
+            Piece::Hole => s.push_str("{}"),
+        }
+    }
+    s
+}
+
+fn holes(pieces: &[Piece]) -> usize {
+    pieces.iter().filter(|p| matches!(p, Piece::Hole)).count()
+}
+
+/// What `format!` would produce: the text with each `{}` replaced by the next argument's
+/// `Display`, missing arguments by nothing.
+fn expected<T: Display>(pieces: &[Piece], args: &[T]) -> String {
+    let mut out = String::new();
+    let mut args = args.iter();
+    for p in pieces {
+        match p {
+            Piece::Text(t) => out.push_str(t),
+            Piece::OpenEsc => out.push('{'),
+            Piece::CloseEsc => out.push('}'),
+            Piece::Hole => {
+                if let Some(a) = args.next() {
+                    write!(out, "{}", a).unwrap();
+                }
+            }
+        }
+    }
+    out
+}
+
+/// Arguments of mixed types; strings may themselves contain braces, which must stay literal.
+#[derive(Clone, Debug, PartialEq, hegel::PrettyPrintable)]
+enum Val {
+    Int(i64),
+    Float(f64),
+    Str(String),
+    Unit,
+}
+
+impl Display for Val {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Val::Int(i) => Display::fmt(i, f),
+            Val::Float(x) => Display::fmt(x, f),
+            Val::Str(s) => Display::fmt(s, f),
+            Val::Unit => Ok(()),
+        }
+    }
+}
+
+const BRACE_STRS: &[&str] = &["{}", "{{", "}}", "{", "}", "{{}}", "}{", "{x}"];
+
+fn val() -> impl hegel::PrintableGenerator<Val> {
+    hegel::one_of!(
+        generators::just(Val::Unit),
+        generators::integers::<i64>().map(Val::Int),
+        generators::integers::<i64>().map(Val::Int),
+        generators::sampled_from(&[0.0, -0.0, 1.5, -2.25, 1e300, 1e-7, f64::NAN, f64::INFINITY])
+            .map(Val::Float),
+        plain_text(1, 5).map(Val::Str),
+        generators::sampled_from(BRACE_STRS).map(|s| Val::Str(s.to_string())),
+    )
+}
+
+/// Arguments for a format string with `holes` holes: sometimes too few, sometimes too many.
+fn args_for(holes: usize) -> generators::VecGenerator<impl hegel::PrintableGenerator<Val>, Val> {
+    generators::vecs(val()).max_size(holes + 2)
+}
+
+/// The pieces of a format string and arguments for it.
+#[hegel::composite]
+fn pieces_and_args(tc: &TestCase) -> (Vec<Piece>, Vec<Val>) {
+    let pieces = tc.draw(pieces());
+    let args = tc.draw(args_for(holes(&pieces)));
+    (pieces, args)
+}
+
+// ---------------------------------------------------------------- general properties
+
+/// `str::format` replaces the `{}`s in order, keeps `{{`/`}}` as one brace, writes nothing for a
+/// missing argument and ignores extra ones — exactly the text `format!` builds.
+#[hegel::test]
+fn format_replaces_holes_like_format(tc: TestCase) {
+    let (pieces, args) = tc.draw(pieces_and_args());
+    let fmt = fmt_string(&pieces);
+    let want = expected(&pieces, &args);
+    assert_eq!(fmt.format(&args), want, "fmt {:?} args {:?}", fmt, args);
+    // A `String` format string and an owned iterator of references behave the same.
+    let owned: String = fmt.clone();
+    let refs: Vec<&Val> = args.iter().collect();
+    assert_eq!(owned.format(refs.iter().copied()), want);
+}
+
+/// `Arguments` displayed through `{}` and `dyn_write!` into a `fmt::Write` or an `io::Write`
+/// all give `str::format`'s text; displaying the same `Arguments` twice gives it twice.
+#[hegel::test]
+fn arguments_and_dyn_write_agree_with_format(tc: TestCase) {
+    let (pieces, args) = tc.draw(pieces_and_args());
+    let fmt = fmt_string(&pieces);
+    let want = fmt.format(&args);
+    let a = Arguments::new(fmt.as_str(), &args);
+    assert_eq!(a.to_string(), want);
+    assert_eq!(
+        format!("{}", a),
+        want,
+        "second Display of the same Arguments"
+    );
+    let mut s = String::new();
+    dyn_write!(s, fmt.as_str(), &args).unwrap();
+    assert_eq!(s, want);
+    let mut v: Vec<u8> = Vec::new();
+    dyn_write!(v, fmt.as_str(), &args).unwrap();
+    assert_eq!(String::from_utf8(v).unwrap(), want);
+    // Trait objects as arguments, as in the upstream tests.
+    let dyns: Vec<&dyn Display> = args.iter().map(|x| x as &dyn Display).collect();
+    assert_eq!(fmt.format(dyns.iter().copied()), want);
+}
+
+/// A format string without braces is copied verbatim, whatever its bytes, and a `{}` argument
+/// containing braces is copied verbatim too.
+#[hegel::test]
+fn text_and_arguments_pass_through_unchanged(tc: TestCase) {
+    let text = tc.draw(plain_text(0, 12));
+    let args = tc.draw(generators::vecs(val()).max_size(3));
+    assert_eq!(text.format(&args), text);
+    let brace_arg = Val::Str(
+        tc.draw(generators::sampled_from(&[
+            "{}", "{{}}", "}{", "{", "}", "{{", "}}",
+        ]))
+        .to_string(),
+    );
+    let fmt = format!("{}{{}}{}", text, text);
+    assert_eq!(
+        fmt.format(&[brace_arg.clone()]),
+        format!("{}{}{}", text, brace_arg, text)
+    );
+}
+
+/// Brace soup — unpaired `{`, `}`, `{x}`, braces at the ends — never panics, and every
+/// non-brace character of the format string reaches the output in order; the arguments are
+/// digits so they cannot be confused with the letters of the text.
+#[hegel::test]
+fn unmatched_braces_never_panic(tc: TestCase) {
+    let fmt = tc.draw(generators::text().alphabet("{}abé日 ").max_size(12));
+    let args = tc.draw(generators::vecs(ints(0, 99)).max_size(4));
+    let out = fmt.format(&args);
+    let letters = |s: &str| -> String {
+        s.chars()
+            .filter(|c| !matches!(c, '{' | '}' | '0'..='9'))
+            .collect()
+    };
+    assert_eq!(letters(&out), letters(&fmt), "fmt {:?} -> {:?}", fmt, out);
+    // Every `{}` pair in a string free of other braces is a hole.
+    let clean: String = fmt.chars().filter(|c| !matches!(c, '{' | '}')).collect();
+    let k = tc.draw(ints(0, 3)) as usize;
+    let fmt2 = format!("{}{}{}", clean, "{}".repeat(k), clean);
+    let want: String = format!(
+        "{}{}{}",
+        clean,
+        args.iter()
+            .take(k)
+            .map(|a| a.to_string())
+            .collect::<String>(),
+        clean
+    );
+    assert_eq!(fmt2.format(&args), want);
+}
+
+/// The rustdoc and README examples, and the upstream unit tests' brace cases.
+#[test]
+fn doc_examples() {
+    assert_eq!("{}a{}b{}c".format(&[1, 2, 3]), "1a2b3c");
+    assert_eq!("{}a{}b{}c".format(&[1, 2, 3, 4]), "1a2b3c");
+    assert_eq!("{}a{}b{}c".format(&[1, 2]), "1a2bc");
+    assert_eq!("{{}}{}".format(&[1, 2]), "{}1");
+    let mut buf = String::new();
+    dyn_write!(buf, "{}a{}b{}c", &[1, 2, 3]).unwrap();
+    assert_eq!(buf, "1a2b3c");
+    assert_eq!("abcd{}абвгд{}{}".format(&[1, 2, 3]), "abcd1абвгд23");
+    assert_eq!("{{}}x{{}{}}y{".format(&[1, 2, 3]), "{}x{{}y");
+    assert_eq!("{{{}}}x{y}".format(&[1, 2, 3]), "{1}xy");
+    assert_eq!("{{{}}}x{{}".format(&[1, 2, 3]), "{1}x{");
+}
+
+// ---------------------------------------------------------------- pinned bugs
+
+/// dyn-fmt/1: `Arguments` is "a runtime analog of `format_args!`", and `format_args!`'s
+/// `Display` ignores the outer width and precision (`format!("{:10}", format_args!("ab"))` is
+/// `ab`); a `String` would be padded or truncated as a whole.  dyn-fmt forwards the outer
+/// `Formatter` to every text piece and every argument separately, so `{:>10}` pads each of
+/// them to 10 and `{:.1}` truncates the text to one character.
+#[hegel::test]
+fn outer_format_spec_is_not_applied_piecewise(tc: TestCase) {
+    // A format string ending in a hole and some text, so both kinds of piece are padded.
+    let (pieces, args) = tc.draw(hegel::compose!(|tc| {
+        let mut pieces = tc.draw(pieces());
+        pieces.push(Piece::Hole);
+        pieces.push(Piece::Text(tc.draw(plain_text(1, 4))));
+        let args = tc.draw(args_for(holes(&pieces)));
+        (pieces, args)
+    }));
+    let fmt = fmt_string(&pieces);
+    let plain = fmt.format(&args);
+    let a = Arguments::new(fmt.as_str(), &args);
+    let w = tc.draw(ints(0, 40)) as usize;
+    let out = format!("{:>w$}", a);
+    assert!(
+        out == plain || out == format!("{:>w$}", plain),
+        "{{:>{}}} of {:?} with {:?}: {:?}",
+        w,
+        fmt,
+        args,
+        out
+    );
+    let p = tc.draw(ints(0, 6)) as usize;
+    let out = format!("{:.p$}", a);
+    assert!(
+        out == plain || out == format!("{:.p$}", plain),
+        "{{:.{}}} of {:?} with {:?}: {:?}",
+        p,
+        fmt,
+        args,
+        out
+    );
+}
+
+/// dyn-fmt/2: a `{}` immediately after an unpaired `}` is not replaced: `"a}{}b".format(&[1])`
+/// is `a{b` — the `}` is dropped, the `{` is taken as text and the following `}` is dropped
+/// too.  `format!` rejects the string; the crate's own lenient rule is that an unpaired brace is
+/// dropped, and either `a}1b` or `a1b` would follow it.
+#[hegel::test]
+fn hole_after_unpaired_close_brace_is_replaced(tc: TestCase) {
+    let before = tc.draw(plain_text(1, 4));
+    let after = tc.draw(plain_text(1, 4));
+    let arg = tc.draw(ints(0, 99));
+    let fmt = format!("{}}}{{}}{}", before, after);
+    let out = fmt.format(&[arg]);
+    assert!(
+        out == format!("{}}}{}{}", before, arg, after)
+            || out == format!("{}{}{}", before, arg, after),
+        "{:?} with {}: {:?}",
+        fmt,
+        arg,
+        out
+    );
+}
