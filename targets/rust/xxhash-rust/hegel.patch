+//Property-based tests (hegel).
+//
+//Oracle: the official C implementation (`xxhash-c-sys`), which the crate already
+//uses as its reference in the tests above. Differential properties:
+//  * one-shot Rust vs C reference, with *drawn* seeds/secrets (the tests above only use seeds 0/1)
+//  * streaming (chunked `update()` with drawn chunk boundaries) vs one-shot,
+//    including mid-stream `digest()` calls which must not perturb state
+//  * `const_*` implementations vs the runtime implementations
+//  * seed sensitivity (distinct seeds virtually never collide for 64/128-bit outputs)
+//Lengths are biased toward the algorithms' internal block/bucket boundaries.
+mod hegel_props {
+    #![allow(dead_code)] //helpers are unused when hash features are disabled
+
+    use hegel::generators::{self, Generator};
+
+    //xxh32 consumes 16-byte blocks.
+    const XXH32_LENS: &[usize] = &[0, 1, 2, 3, 4, 14, 15, 16, 17, 31, 32, 33, 47, 48, 49];
+    //xxh64 consumes 32-byte blocks (with 8/4/1-byte tail steps).
+    const XXH64_LENS: &[usize] = &[0, 1, 3, 4, 7, 8, 9, 15, 16, 31, 32, 33, 63, 64, 65, 95, 96, 97];
+    //xxh3 has distinct code paths per length bucket: 0, 1-3, 4-8, 9-16, 17-128,
+    //129-240 (MID_SIZE_MAX) and the "long" path (241+) with 64-byte stripes,
+    //a 256-byte streaming buffer and 1024-byte secret-consumption blocks.
+    const XXH3_LENS: &[usize] = &[
+        0, 1, 2, 3, 4, 5, 8, 9, 15, 16, 17, 63, 64, 65, 127, 128, 129, 160, 161,
+        239, 240, 241, 255, 256, 257, 319, 320, 511, 512, 513, 1023, 1024, 1025,
+        1088, 2047, 2048, 2049,
+    ];
+
+    //Draws a length either uniformly or from the boundary set.
+    fn draw_len(tc: &hegel::TestCase, boundaries: &'static [usize], uniform_max: usize) -> usize {
+        tc.draw(hegel::one_of!(
+            generators::integers::<usize>().max_value(uniform_max),
+            generators::sampled_from(boundaries.to_vec()),
+        ))
+    }
+
+    fn draw_bytes(tc: &hegel::TestCase, len: usize) -> Vec<u8> {
+        tc.draw(generators::binary().min_size(len).max_size(len))
+    }
+
+    //Draws sorted cut positions in 0..=len (always ending at len), biased toward
+    //boundary offsets. Adjacent duplicates yield empty chunks, which `update()`
+    //must treat as no-ops.
+    fn draw_cuts(tc: &hegel::TestCase, boundaries: &'static [usize], len: usize) -> Vec<usize> {
+        let mut cuts: Vec<usize> = tc.draw(generators::vecs(hegel::one_of!(
+            generators::integers::<usize>().max_value(len),
+            generators::sampled_from(boundaries.to_vec()).map(move |b| core::cmp::min(b, len)),
+        )).max_size(8));
+        cuts.push(len);
+        cuts.sort_unstable();
+        cuts
+    }
+
+    //Draws a seed, biased toward the documented default of 0.
+    fn draw_seed64(tc: &hegel::TestCase) -> u64 {
+        tc.draw(hegel::one_of!(
+            generators::just(0u64),
+            generators::integers::<u64>(),
+        ))
+    }
+
+    // ===== xxh32 =====
+
+    #[cfg(feature = "xxh32")]
+    #[hegel::test]
+    fn hegel_xxh32_oneshot_matches_c_reference(tc: hegel::TestCase) {
+        use xxhash_rust::xxh32::xxh32;
+
+        let seed = tc.draw(generators::integers::<u32>());
+        let len = draw_len(&tc, XXH32_LENS, 100);
+        let data = draw_bytes(&tc, len);
+
+        let expected = unsafe { xxhash_c_sys::XXH32(data.as_ptr() as _, data.len(), seed) };
+        assert_eq!(xxh32(&data, seed), expected, "xxh32 diverges from C reference (len={}, seed={})", len, seed);
+    }
+
+    #[cfg(feature = "xxh32")]
+    #[hegel::test]
+    fn hegel_xxh32_streaming_prefix_digests_match_oneshot(tc: hegel::TestCase) {
+        use xxhash_rust::xxh32::{xxh32, Xxh32};
+
+        let seed = tc.draw(generators::integers::<u32>());
+        let len = draw_len(&tc, XXH32_LENS, 100);
+        let data = draw_bytes(&tc, len);
+        let cuts = draw_cuts(&tc, XXH32_LENS, len);
+
+        let mut hasher = Xxh32::new(seed);
+        let mut prev = 0;
+        for cut in cuts {
+            hasher.update(&data[prev..cut]);
+            prev = cut;
+            //digest() must agree with the one-shot hash of the prefix fed so far,
+            //and calling it mid-stream must not perturb subsequent updates.
+            assert_eq!(hasher.digest(), xxh32(&data[..cut], seed),
+                "xxh32 streaming digest diverges from one-shot at prefix len {} of {} (seed={})", cut, len, seed);
+        }
+    }
+
+    #[cfg(all(feature = "xxh32", feature = "const_xxh32"))]
+    #[hegel::test]
+    fn hegel_const_xxh32_matches_runtime(tc: hegel::TestCase) {
+        let seed = tc.draw(generators::integers::<u32>());
+        let len = draw_len(&tc, XXH32_LENS, 100);
+        let data = draw_bytes(&tc, len);
+
+        assert_eq!(xxhash_rust::const_xxh32::xxh32(&data, seed), xxhash_rust::xxh32::xxh32(&data, seed),
+            "const_xxh32 diverges from runtime xxh32 (len={}, seed={})", len, seed);
+    }
+
+    // ===== xxh64 =====
+
+    #[cfg(feature = "xxh64")]
+    #[hegel::test]
+    fn hegel_xxh64_oneshot_matches_c_reference(tc: hegel::TestCase) {
+        use xxhash_rust::xxh64::xxh64;
+
+        let seed = tc.draw(generators::integers::<u64>());
+        let len = draw_len(&tc, XXH64_LENS, 200);
+        let data = draw_bytes(&tc, len);
+
+        let expected = unsafe { xxhash_c_sys::XXH64(data.as_ptr() as _, data.len(), seed) };
+        assert_eq!(xxh64(&data, seed), expected, "xxh64 diverges from C reference (len={}, seed={})", len, seed);
+    }
+
+    #[cfg(feature = "xxh64")]
+    #[hegel::test]
+    fn hegel_xxh64_streaming_prefix_digests_match_oneshot(tc: hegel::TestCase) {
+        use xxhash_rust::xxh64::{xxh64, Xxh64};
+
+        let seed = tc.draw(generators::integers::<u64>());
+        let len = draw_len(&tc, XXH64_LENS, 200);
+        let data = draw_bytes(&tc, len);
+        let cuts = draw_cuts(&tc, XXH64_LENS, len);
+
+        let mut hasher = Xxh64::new(seed);
+        let mut prev = 0;
+        for cut in cuts {
+            hasher.update(&data[prev..cut]);
+            prev = cut;
+            assert_eq!(hasher.digest(), xxh64(&data[..cut], seed),
+                "xxh64 streaming digest diverges from one-shot at prefix len {} of {} (seed={})", cut, len, seed);
+        }
+    }
+
+    #[cfg(all(feature = "xxh64", feature = "const_xxh64"))]
+    #[hegel::test]
+    fn hegel_const_xxh64_matches_runtime(tc: hegel::TestCase) {
+        let seed = tc.draw(generators::integers::<u64>());
+        let len = draw_len(&tc, XXH64_LENS, 200);
+        let data = draw_bytes(&tc, len);
+
+        assert_eq!(xxhash_rust::const_xxh64::xxh64(&data, seed), xxhash_rust::xxh64::xxh64(&data, seed),
+            "const_xxh64 diverges from runtime xxh64 (len={}, seed={})", len, seed);
+    }
+
+    #[cfg(feature = "xxh64")]
+    #[hegel::test]
+    fn hegel_xxh64_seed_affects_hash(tc: hegel::TestCase) {
+        use xxhash_rust::xxh64::xxh64;
+
+        let s1 = tc.draw(generators::integers::<u64>());
+        let s2 = tc.draw(generators::integers::<u64>());
+        tc.assume(s1 != s2);
+        let len = draw_len(&tc, XXH64_LENS, 200);
+        let data = draw_bytes(&tc, len);
+
+        //For a 64-bit hash, two distinct seeds colliding on the same input is a
+        //~2^-64 event; a hit here indicates the seed is not properly mixed in.
+        assert_ne!(xxh64(&data, s1), xxh64(&data, s2),
+            "xxh64 produced the same hash for distinct seeds {} and {} (len={})", s1, s2, len);
+    }
+
+    // ===== xxh3 =====
+
+    #[cfg(feature = "xxh3")]
+    #[hegel::test]
+    fn hegel_xxh3_oneshot_matches_c_reference(tc: hegel::TestCase) {
+        use xxhash_rust::xxh3::{xxh3_64, xxh3_64_with_seed, xxh3_128, xxh3_128_with_seed};
+
+        let seed = draw_seed64(&tc);
+        let len = draw_len(&tc, XXH3_LENS, 1600);
+        let data = draw_bytes(&tc, len);
+
+        let expected = unsafe { xxhash_c_sys::XXH3_64bits_withSeed(data.as_ptr() as _, data.len(), seed) };
+        assert_eq!(xxh3_64_with_seed(&data, seed), expected,
+            "xxh3_64_with_seed diverges from C reference (len={}, seed={})", len, seed);
+
+        let expected128 = unsafe { xxhash_c_sys::XXH3_128bits_withSeed(data.as_ptr() as _, data.len(), seed) };
+        let expected128 = expected128.low64 as u128 | ((expected128.high64 as u128) << 64);
+        assert_eq!(xxh3_128_with_seed(&data, seed), expected128,
+            "xxh3_128_with_seed diverges from C reference (len={}, seed={})", len, seed);
+
+        if seed == 0 {
+            //Seed 0 is the documented default: the unseeded entry points must agree.
+            assert_eq!(xxh3_64(&data), expected, "xxh3_64 differs from xxh3_64_with_seed(.., 0) (len={})", len);
+            assert_eq!(xxh3_128(&data), expected128, "xxh3_128 differs from xxh3_128_with_seed(.., 0) (len={})", len);
+        }
+    }
+
+    #[cfg(feature = "xxh3")]
+    #[hegel::test]
+    fn hegel_xxh3_streaming_prefix_digests_match_oneshot(tc: hegel::TestCase) {
+        use xxhash_rust::xxh3::{xxh3_64_with_seed, xxh3_128_with_seed, Xxh3};
+
+        let seed = draw_seed64(&tc);
+        let len = draw_len(&tc, XXH3_LENS, 2600);
+        let data = draw_bytes(&tc, len);
+        let cuts = draw_cuts(&tc, XXH3_LENS, len);
+
+        let mut hasher = Xxh3::with_seed(seed);
+        let mut prev = 0;
+        for cut in cuts {
+            hasher.update(&data[prev..cut]);
+            prev = cut;
+            //Both digest widths must agree with the one-shot hash of the prefix,
+            //and mid-stream digests must not perturb subsequent updates.
+            assert_eq!(hasher.digest(), xxh3_64_with_seed(&data[..cut], seed),
+                "xxh3 streaming digest diverges from one-shot at prefix len {} of {} (seed={})", cut, len, seed);
+            assert_eq!(hasher.digest128(), xxh3_128_with_seed(&data[..cut], seed),
+                "xxh3 streaming digest128 diverges from one-shot at prefix len {} of {} (seed={})", cut, len, seed);
+        }
+    }
+
+    #[cfg(feature = "xxh3")]
+    #[hegel::test]
+    fn hegel_xxh3_with_secret_oneshot_matches_c_reference(tc: hegel::TestCase) {
+        use xxhash_rust::xxh3::{xxh3_64_with_secret, xxh3_64_with_secret_input, xxh3_128_with_secret, xxh3_128_with_secret_input, SecretInput};
+
+        //SECRET_SIZE_MIN is 136; the long path consumes the secret at a rate
+        //derived from its length, so the length itself is worth varying.
+        let secret_len = tc.draw(generators::integers::<usize>().min_value(136).max_value(300));
+        let secret = draw_bytes(&tc, secret_len);
+        let len = draw_len(&tc, XXH3_LENS, 1600);
+        let data = draw_bytes(&tc, len);
+
+        let expected = unsafe {
+            xxhash_c_sys::XXH3_64bits_withSecret(data.as_ptr() as _, data.len(), secret.as_ptr() as _, secret.len())
+        };
+        assert_eq!(xxh3_64_with_secret(&data, &secret), expected,
+            "xxh3_64_with_secret diverges from C reference (len={}, secret_len={})", len, secret_len);
+
+        let expected128 = unsafe {
+            xxhash_c_sys::XXH3_128bits_withSecret(data.as_ptr() as _, data.len(), secret.as_ptr() as _, secret.len())
+        };
+        let expected128 = expected128.low64 as u128 | ((expected128.high64 as u128) << 64);
+        assert_eq!(xxh3_128_with_secret(&data, &secret), expected128,
+            "xxh3_128_with_secret diverges from C reference (len={}, secret_len={})", len, secret_len);
+
+        //The validated SecretInput entry points are siblings that must agree.
+        let input = SecretInput::try_new(secret.as_slice()).expect("secret is above SECRET_SIZE_MIN");
+        assert_eq!(xxh3_64_with_secret_input(&data, &input), expected);
+        assert_eq!(xxh3_128_with_secret_input(&data, &input), expected128);
+    }
+
+    #[cfg(feature = "xxh3")]
+    #[hegel::test]
+    fn hegel_xxh3_streaming_with_secret_matches_oneshot(tc: hegel::TestCase) {
+        use xxhash_rust::xxh3::{xxh3_64_with_secret, xxh3_128_with_secret, Xxh3};
+
+        let mut secret = [0u8; 192];
+        secret.copy_from_slice(&draw_bytes(&tc, 192));
+        let len = draw_len(&tc, XXH3_LENS, 2600);
+        let data = draw_bytes(&tc, len);
+        let cuts = draw_cuts(&tc, XXH3_LENS, len);
+
+        let mut hasher = Xxh3::with_secret(secret);
+        let mut prev = 0;
+        for cut in cuts {
+            hasher.update(&data[prev..cut]);
+            prev = cut;
+            assert_eq!(hasher.digest(), xxh3_64_with_secret(&data[..cut], &secret),
+                "xxh3 with-secret streaming digest diverges from one-shot at prefix len {} of {}", cut, len);
+            assert_eq!(hasher.digest128(), xxh3_128_with_secret(&data[..cut], &secret),
+                "xxh3 with-secret streaming digest128 diverges from one-shot at prefix len {} of {}", cut, len);
+        }
+    }
+
+    #[cfg(all(feature = "xxh3", feature = "const_xxh3"))]
+    #[hegel::test]
+    fn hegel_const_xxh3_matches_runtime(tc: hegel::TestCase) {
+        use xxhash_rust::{xxh3, const_xxh3};
+
+        let seed = draw_seed64(&tc);
+        let len = draw_len(&tc, XXH3_LENS, 1600);
+        let data = draw_bytes(&tc, len);
+        let mut secret = [0u8; 192];
+        secret.copy_from_slice(&draw_bytes(&tc, 192));
+
+        assert_eq!(const_xxh3::xxh3_64(&data), xxh3::xxh3_64(&data),
+            "const xxh3_64 diverges from runtime (len={})", len);
+        assert_eq!(const_xxh3::xxh3_64_with_seed(&data, seed), xxh3::xxh3_64_with_seed(&data, seed),
+            "const xxh3_64_with_seed diverges from runtime (len={}, seed={})", len, seed);
+        assert_eq!(const_xxh3::xxh3_64_with_secret(&data, &secret), xxh3::xxh3_64_with_secret(&data, &secret),
+            "const xxh3_64_with_secret diverges from runtime (len={})", len);
+        assert_eq!(const_xxh3::xxh3_128(&data), xxh3::xxh3_128(&data),
+            "const xxh3_128 diverges from runtime (len={})", len);
+        assert_eq!(const_xxh3::xxh3_128_with_seed(&data, seed), xxh3::xxh3_128_with_seed(&data, seed),
+            "const xxh3_128_with_seed diverges from runtime (len={}, seed={})", len, seed);
+        assert_eq!(const_xxh3::xxh3_128_with_secret(&data, &secret), xxh3::xxh3_128_with_secret(&data, &secret),
+            "const xxh3_128_with_secret diverges from runtime (len={})", len);
+    }
+
+    #[cfg(feature = "xxh3")]
+    #[hegel::test]
+    fn hegel_xxh3_seed_affects_hash(tc: hegel::TestCase) {
+        use xxhash_rust::xxh3::{xxh3_64_with_seed, xxh3_128_with_seed};
+
+        let s1 = tc.draw(generators::integers::<u64>());
+        let s2 = tc.draw(generators::integers::<u64>());
+        tc.assume(s1 != s2);
+        let len = draw_len(&tc, XXH3_LENS, 1600);
+        let data = draw_bytes(&tc, len);
+
+        //Collisions between distinct seeds on the same input are ~2^-64 / ~2^-128
+        //events; a hit here indicates the seed is not properly mixed in.
+        assert_ne!(xxh3_64_with_seed(&data, s1), xxh3_64_with_seed(&data, s2),
+            "xxh3_64 produced the same hash for distinct seeds {} and {} (len={})", s1, s2, len);
+        assert_ne!(xxh3_128_with_seed(&data, s1), xxh3_128_with_seed(&data, s2),
+            "xxh3_128 produced the same hash for distinct seeds {} and {} (len={})", s1, s2, len);
+    }
+}
+
 #[cfg(feature = "xxh3")]
 #[test]
 fn xxh3_builder_seed_and_secret_are_order_independent() {
