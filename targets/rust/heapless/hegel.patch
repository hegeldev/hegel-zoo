+// ---------------------------------------------------------------------
+// Hegel property-based tests
+//
+// Stateful model test: a `heapless::String<8>` is driven alongside a
+// `std::string::String` oracle. Contents must agree after every
+// operation; fallible operations must return `Err` exactly when the
+// *byte* capacity would be exceeded (in particular a multi-byte char
+// pushed when only fewer bytes remain), and an `Err` must leave the
+// string unchanged, never truncating a UTF-8 sequence.
+//
+// NOTE: this module deliberately lives *above* `macro_rules! format`
+// (see `hegel_tests_marker` below): from that point on the crate's own
+// `format!` textually shadows `std::format!`, which breaks the code
+// generated by `#[hegel::test]`.
+// ---------------------------------------------------------------------
+#[cfg(test)]
+mod hegel_tests {
+    use crate::{CapacityError, String};
+    use hegel::generators::{self, Generator};
+
+    const STRING_CAP: usize = 8;
+
+    /// A char from mixed Unicode planes so that 1-, 2-, 3- and 4-byte UTF-8
+    /// encodings all land on the capacity boundary.
+    fn draw_char(tc: &hegel::TestCase) -> char {
+        tc.draw(
+            hegel::one_of!(
+                generators::integers::<u32>().max_value(0x7F),
+                generators::integers::<u32>().min_value(0x80).max_value(0x7FF),
+                generators::integers::<u32>().min_value(0x800).max_value(0xFFFF),
+                generators::integers::<u32>()
+                    .min_value(0x1_0000)
+                    .max_value(0x10_FFFF),
+            )
+            .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+        )
+    }
+
+    /// Draw a byte index of `s` that lies on a char boundary (0..=len).
+    fn draw_boundary(tc: &hegel::TestCase, s: &str) -> usize {
+        let mut idx = tc.draw(generators::integers::<usize>().max_value(s.len()));
+        while !s.is_char_boundary(idx) {
+            idx -= 1;
+        }
+        idx
+    }
+
+    struct StringModel {
+        subject: String<STRING_CAP>,
+        model: std::string::String,
+    }
+
+    #[hegel::state_machine]
+    impl StringModel {
+        #[rule]
+        fn push(&mut self, tc: hegel::TestCase) {
+            let c = draw_char(&tc);
+            let before = self.model.clone();
+            match self.subject.push(c) {
+                Ok(()) => {
+                    assert!(
+                        before.len() + c.len_utf8() <= STRING_CAP,
+                        "push succeeded past byte capacity"
+                    );
+                    self.model.push(c);
+                }
+                Err(CapacityError) => {
+                    assert!(
+                        before.len() + c.len_utf8() > STRING_CAP,
+                        "push failed although the char fits"
+                    );
+                    // must not have written a partial UTF-8 sequence
+                    assert_eq!(self.subject.as_str(), before.as_str());
+                }
+            }
+        }
+
+        #[rule]
+        fn push_str(&mut self, tc: hegel::TestCase) {
+            let s: std::string::String = tc.draw(generators::text().max_size(6));
+            let before = self.model.clone();
+            match self.subject.push_str(&s) {
+                Ok(()) => {
+                    assert!(
+                        before.len() + s.len() <= STRING_CAP,
+                        "push_str succeeded past byte capacity"
+                    );
+                    self.model.push_str(&s);
+                }
+                Err(CapacityError) => {
+                    assert!(
+                        before.len() + s.len() > STRING_CAP,
+                        "push_str failed although the string fits"
+                    );
+                    assert_eq!(self.subject.as_str(), before.as_str());
+                }
+            }
+        }
+
+        #[rule]
+        fn pop(&mut self, _: hegel::TestCase) {
+            assert_eq!(self.subject.pop(), self.model.pop());
+        }
+
+        #[rule]
+        fn truncate(&mut self, tc: hegel::TestCase) {
+            let new_len = draw_boundary(&tc, &self.model);
+            self.subject.truncate(new_len);
+            self.model.truncate(new_len);
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: hegel::TestCase) {
+            tc.assume(!self.model.is_empty());
+            let mut idx = draw_boundary(&tc, &self.model);
+            if idx == self.model.len() {
+                // remove requires an index *below* len; snap to the last char
+                idx = self.model.char_indices().next_back().unwrap().0;
+            }
+            assert_eq!(self.subject.remove(idx), self.model.remove(idx));
+        }
+
+        #[rule]
+        fn insert(&mut self, tc: hegel::TestCase) {
+            let c = draw_char(&tc);
+            let idx = draw_boundary(&tc, &self.model);
+            let before = self.model.clone();
+            match self.subject.insert(idx, c) {
+                Ok(()) => {
+                    assert!(
+                        before.len() + c.len_utf8() <= STRING_CAP,
+                        "insert succeeded past byte capacity"
+                    );
+                    self.model.insert(idx, c);
+                }
+                Err(CapacityError) => {
+                    assert!(
+                        before.len() + c.len_utf8() > STRING_CAP,
+                        "insert failed although the char fits"
+                    );
+                    assert_eq!(self.subject.as_str(), before.as_str());
+                }
+            }
+        }
+
+        #[rule]
+        fn insert_str(&mut self, tc: hegel::TestCase) {
+            let s: std::string::String = tc.draw(generators::text().max_size(6));
+            let idx = draw_boundary(&tc, &self.model);
+            let before = self.model.clone();
+            match self.subject.insert_str(idx, &s) {
+                Ok(()) => {
+                    assert!(
+                        before.len() + s.len() <= STRING_CAP,
+                        "insert_str succeeded past byte capacity"
+                    );
+                    self.model.insert_str(idx, &s);
+                }
+                Err(CapacityError) => {
+                    assert!(
+                        before.len() + s.len() > STRING_CAP,
+                        "insert_str failed although the string fits"
+                    );
+                    assert_eq!(self.subject.as_str(), before.as_str());
+                }
+            }
+        }
+
+        #[rule]
+        fn clear(&mut self, _: hegel::TestCase) {
+            self.subject.clear();
+            self.model.clear();
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: hegel::TestCase) {
+            assert_eq!(self.subject.as_str(), self.model.as_str());
+            assert!(self.subject.len() <= STRING_CAP, "len exceeds capacity");
+            // the contents must always be valid UTF-8 of the expected length
+            assert_eq!(self.subject.chars().count(), self.model.chars().count());
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_string_model(tc: hegel::TestCase) {
+        hegel::stateful::machine(StringModel {
+                subject: String::new(),
+                model: std::string::String::new(),
+            }).run(tc);
+    }
+}
