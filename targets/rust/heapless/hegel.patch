+    // ---------------------------------------------------------------------
+    // Hegel property-based tests
+    // ---------------------------------------------------------------------
+
+    use std::collections::HashSet;
+    use std::vec::Vec;
+
+    use hegel::generators;
+
+    use super::FnvIndexSet;
+
+    const SET_CAP: usize = 8;
+
+    /// Builds an `FnvIndexSet<u8, 8>` from a drawn sequence of values while
+    /// checking capacity semantics against a `HashSet` oracle: `insert`
+    /// returns `Ok(false)` for duplicates, `Ok(true)` for new values with
+    /// room, and `Err(value)` for new values in a full set (leaving the set
+    /// unchanged). Values span a slightly larger range than the capacity so
+    /// the full/overflow boundary is actually reached.
+    fn build_checked(
+        tc: &hegel::TestCase,
+    ) -> (FnvIndexSet<u8, SET_CAP>, HashSet<u8>, Vec<u8>) {
+        let values: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>().max_value(11)).max_size(16),
+        );
+        let mut subject: FnvIndexSet<u8, SET_CAP> = FnvIndexSet::new();
+        let mut oracle: HashSet<u8> = HashSet::new();
+        // first-occurrence insertion order of the values that were accepted
+        let mut order: Vec<u8> = Vec::new();
+        for v in values {
+            match subject.insert(v) {
+                Ok(newly_inserted) => {
+                    assert_eq!(
+                        newly_inserted,
+                        oracle.insert(v),
+                        "insert disagreed with the oracle about novelty of {v}"
+                    );
+                    if newly_inserted {
+                        order.push(v);
+                    }
+                }
+                Err(rejected) => {
+                    assert_eq!(rejected, v);
+                    assert!(
+                        oracle.len() == SET_CAP && !oracle.contains(&v),
+                        "insert failed although the set was not full ({} elements) \
+                         or already contained {v}",
+                        oracle.len()
+                    );
+                }
+            }
+        }
+        (subject, oracle, order)
+    }
+
+    /// Insertion-order and membership property: iteration yields exactly the
+    /// first occurrences of accepted values, in order; membership and len
+    /// agree with a `HashSet` oracle; len never exceeds the capacity.
+    #[hegel::test]
+    fn hegel_index_set_insertion_order(tc: hegel::TestCase) {
+        let (subject, oracle, order) = build_checked(&tc);
+        assert!(subject.len() <= SET_CAP, "len exceeds capacity");
+        assert_eq!(subject.len(), oracle.len());
+        assert_eq!(subject.is_full(), oracle.len() == SET_CAP);
+        let iterated: Vec<u8> = subject.iter().copied().collect();
+        assert_eq!(iterated, order, "iteration is not in insertion order");
+        assert_eq!(subject.first().copied(), order.first().copied());
+        assert_eq!(subject.last().copied(), order.last().copied());
+        for v in 0u8..=12 {
+            assert_eq!(subject.contains(&v), oracle.contains(&v));
+        }
+    }
+
+    /// Set-algebra differential: `union`, `intersection`, `difference`,
+    /// `symmetric_difference`, `is_subset`, `is_superset` and `is_disjoint`
+    /// must agree with `std::collections::HashSet` on the same elements.
+    #[hegel::test]
+    fn hegel_index_set_algebra_matches_std(tc: hegel::TestCase) {
+        let (a, oracle_a, _) = build_checked(&tc);
+        let (b, oracle_b, _) = build_checked(&tc);
+
+        let collect = |it: &mut dyn Iterator<Item = &u8>| -> HashSet<u8> {
+            it.copied().collect()
+        };
+
+        assert_eq!(
+            collect(&mut a.union(&b)),
+            oracle_a.union(&oracle_b).copied().collect::<HashSet<u8>>()
+        );
+        assert_eq!(
+            collect(&mut a.intersection(&b)),
+            oracle_a
+                .intersection(&oracle_b)
+                .copied()
+                .collect::<HashSet<u8>>()
+        );
+        assert_eq!(
+            collect(&mut a.difference(&b)),
+            oracle_a
+                .difference(&oracle_b)
+                .copied()
+                .collect::<HashSet<u8>>()
+        );
+        assert_eq!(
+            collect(&mut a.symmetric_difference(&b)),
+            oracle_a
+                .symmetric_difference(&oracle_b)
+                .copied()
+                .collect::<HashSet<u8>>()
+        );
+        assert_eq!(a.is_subset(&b), oracle_a.is_subset(&oracle_b));
+        assert_eq!(a.is_superset(&b), oracle_a.is_superset(&oracle_b));
+        assert_eq!(a.is_disjoint(&b), oracle_a.is_disjoint(&oracle_b));
+    }
 }
