+    // ---------------------------------------------------------------------
+    // Hegel property-based tests
+    //
+    // Stateful model test: a `LinearMap<u8, i32, 4>` is driven alongside a
+    // `Vec<(u8, i32)>` oracle transcribing the documented semantics: insert
+    // updates an existing key in place (even when the map is full) and
+    // returns the old value, inserting a *new* key into a full map returns
+    // `Err((k, v))` and leaves the map unchanged, and `remove` swap-removes
+    // from the backing buffer.
+    // ---------------------------------------------------------------------
+
+    use std::vec::Vec;
+
+    use hegel::generators;
+
+    const LM_CAP: usize = 4;
+
+    struct LinearMapModel {
+        subject: LinearMap<u8, i32, LM_CAP>,
+        model: Vec<(u8, i32)>,
+    }
+
+    fn draw_key(tc: &hegel::TestCase) -> u8 {
+        // small key space => hits, updates and misses are all common
+        tc.draw(generators::integers::<u8>().max_value(7))
+    }
+
+    #[hegel::state_machine]
+    impl LinearMapModel {
+        #[rule]
+        fn insert(&mut self, tc: hegel::TestCase) {
+            let k = draw_key(&tc);
+            let v = tc.draw(generators::integers::<i32>());
+            let before = self.model.clone();
+            let existing = self.model.iter().position(|&(mk, _)| mk == k);
+            match self.subject.insert(k, v) {
+                Ok(old) => match existing {
+                    Some(pos) => {
+                        // updating an existing key must work even when full
+                        assert_eq!(old, Some(before[pos].1));
+                        self.model[pos].1 = v;
+                    }
+                    None => {
+                        assert_eq!(old, None);
+                        assert!(
+                            before.len() < LM_CAP,
+                            "insert of a new key succeeded at capacity"
+                        );
+                        self.model.push((k, v));
+                    }
+                },
+                Err((rk, rv)) => {
+                    assert_eq!((rk, rv), (k, v));
+                    assert!(existing.is_none(), "insert of an existing key failed");
+                    assert_eq!(before.len(), LM_CAP, "insert failed below capacity");
+                    let now: Vec<(u8, i32)> =
+                        self.subject.iter().map(|(&k, &v)| (k, v)).collect();
+                    assert_eq!(now, before, "failed insert modified the map");
+                }
+            }
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: hegel::TestCase) {
+            let k = draw_key(&tc);
+            let expected = self
+                .model
+                .iter()
+                .position(|&(mk, _)| mk == k)
+                .map(|pos| self.model.swap_remove(pos).1);
+            assert_eq!(self.subject.remove(&k), expected);
+        }
+
+        #[rule]
+        fn get(&mut self, tc: hegel::TestCase) {
+            let k = draw_key(&tc);
+            let expected = self
+                .model
+                .iter()
+                .find(|&&(mk, _)| mk == k)
+                .map(|&(_, v)| v);
+            assert_eq!(self.subject.get(&k).copied(), expected);
+            assert_eq!(self.subject.contains_key(&k), expected.is_some());
+        }
+
+        #[rule]
+        fn clear(&mut self, _: hegel::TestCase) {
+            self.subject.clear();
+            self.model.clear();
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: hegel::TestCase) {
+            assert!(self.subject.len() <= LM_CAP, "len exceeds capacity");
+            assert_eq!(self.subject.len(), self.model.len());
+            assert_eq!(self.subject.is_empty(), self.model.is_empty());
+            assert_eq!(self.subject.is_full(), self.model.len() == LM_CAP);
+            let entries: Vec<(u8, i32)> = self.subject.iter().map(|(&k, &v)| (k, v)).collect();
+            assert_eq!(entries, self.model);
+            assert!(self.subject.keys().eq(self.model.iter().map(|(k, _)| k)));
+            assert!(self.subject.values().eq(self.model.iter().map(|(_, v)| v)));
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_linear_map_model(tc: hegel::TestCase) {
+        hegel::stateful::machine(LinearMapModel {
+                subject: LinearMap::new(),
+                model: Vec::new(),
+            }).run(tc);
+    }
 }
