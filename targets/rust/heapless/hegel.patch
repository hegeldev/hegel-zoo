+    // ---------------------------------------------------------------------
+    // Hegel property-based tests
+    //
+    // Stateful model test: a `HistoryBuf<i32, 4>` ring buffer is driven
+    // alongside a `VecDeque<i32>` oracle capped at 4 elements (writes past
+    // capacity evict the oldest element). The recent-N semantics —
+    // `recent`, `oldest`, `oldest_ordered` and `as_slices` — must all agree
+    // with the oracle, especially once the write index has wrapped around.
+    // ---------------------------------------------------------------------
+
+    use std::collections::VecDeque;
+    use std::vec::Vec;
+
+    use hegel::generators;
+
+    const HB_CAP: usize = 4;
+
+    struct HistoryBufModel {
+        subject: HistoryBuf<i32, HB_CAP>,
+        model: VecDeque<i32>,
+    }
+
+    impl HistoryBufModel {
+        fn model_write(&mut self, x: i32) {
+            if self.model.len() == HB_CAP {
+                self.model.pop_front();
+            }
+            self.model.push_back(x);
+        }
+    }
+
+    #[hegel::state_machine]
+    impl HistoryBufModel {
+        #[rule]
+        fn write(&mut self, tc: hegel::TestCase) {
+            let x = tc.draw(generators::integers::<i32>());
+            self.subject.write(x);
+            self.model_write(x);
+        }
+
+        #[rule]
+        fn extend_from_slice(&mut self, tc: hegel::TestCase) {
+            // deliberately allow slices longer than the whole capacity: only
+            // the most recent HB_CAP elements may be kept
+            let elems: Vec<i32> = tc.draw(
+                generators::vecs(generators::integers::<i32>()).max_size(HB_CAP + 2),
+            );
+            self.subject.extend_from_slice(&elems);
+            for &x in &elems {
+                self.model_write(x);
+            }
+        }
+
+        #[rule]
+        fn clear(&mut self, _: hegel::TestCase) {
+            self.subject.clear();
+            self.model.clear();
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: hegel::TestCase) {
+            assert!(self.subject.len() <= HB_CAP, "len exceeds capacity");
+            assert_eq!(self.subject.len(), self.model.len());
+            assert_eq!(self.subject.is_empty(), self.model.is_empty());
+            assert_eq!(self.subject.is_full(), self.model.len() == HB_CAP);
+            // most recently written and oldest surviving element
+            assert_eq!(self.subject.recent(), self.model.back());
+            assert_eq!(self.subject.oldest(), self.model.front());
+            // oldest -> newest iteration must agree with the oracle, in both
+            // directions (the iterator is double-ended)
+            assert!(self.subject.oldest_ordered().eq(self.model.iter()));
+            assert!(self.subject.oldest_ordered().rev().eq(self.model.iter().rev()));
+            // as_slices must concatenate to oldest -> newest order
+            let (a, b) = self.subject.as_slices();
+            let concat: Vec<i32> = a.iter().chain(b.iter()).copied().collect();
+            let expected: Vec<i32> = self.model.iter().copied().collect();
+            assert_eq!(concat, expected);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_history_buf_model(tc: hegel::TestCase) {
+        hegel::stateful::machine(HistoryBufModel {
+                subject: HistoryBuf::new(),
+                model: VecDeque::new(),
+            }).run(tc);
+    }
 }
diff --git a/src/index_map.rs b/src/index_map.rs
index e8df5d45..a7ac8ad9 100644
--- a/src/index_map.rs
+++ b/src/index_map.rs
@@ -2106,4 +2106,141 @@ mod tests {
         history_buf.clear();
         assert_eq!(Dropper::count(), 0);
     }
+
+    // ---------------------------------------------------------------------
+    // Hegel property-based tests
+    //
+    // Stateful model test: a `FnvIndexMap<u8, u32, 4>` is driven alongside a
+    // `Vec<(u8, u32)>` oracle that transcribes the documented semantics:
+    // insertion order is preserved, updating an existing key keeps its
+    // position, `remove`/`swap_remove` swap the removed entry with the last
+    // one, and inserting a *new* key into a full map returns `Err((k, v))`
+    // and leaves the map unchanged. Keys are drawn from a small range so
+    // hash collisions and repeated keys are common.
+    // ---------------------------------------------------------------------
+
+    use hegel::generators;
+
+    const MAP_CAP: usize = 4;
+
+    struct IndexMapModel {
+        subject: FnvIndexMap<u8, u32, MAP_CAP>,
+        model: Vec<(u8, u32)>,
+    }
+
+    fn draw_key(tc: &hegel::TestCase) -> u8 {
+        // small key space => collisions, hits and repeats are common
+        tc.draw(generators::integers::<u8>().max_value(7))
+    }
+
+    #[hegel::state_machine]
+    impl IndexMapModel {
+        #[rule]
+        fn insert(&mut self, tc: hegel::TestCase) {
+            let k = draw_key(&tc);
+            let v = tc.draw(generators::integers::<u32>());
+            let before = self.model.clone();
+            let existing = self.model.iter().position(|&(mk, _)| mk == k);
+            match self.subject.insert(k, v) {
+                Ok(old) => match existing {
+                    Some(pos) => {
+                        // an existing key keeps its place in the order
+                        assert_eq!(old, Some(before[pos].1));
+                        self.model[pos].1 = v;
+                    }
+                    None => {
+                        assert_eq!(old, None);
+                        assert!(
+                            before.len() < MAP_CAP,
+                            "insert of a new key succeeded at capacity"
+                        );
+                        self.model.push((k, v));
+                    }
+                },
+                Err((rk, rv)) => {
+                    assert_eq!((rk, rv), (k, v));
+                    assert!(existing.is_none(), "insert of an existing key failed");
+                    assert_eq!(before.len(), MAP_CAP, "insert failed below capacity");
+                    let now: Vec<(u8, u32)> =
+                        self.subject.iter().map(|(&k, &v)| (k, v)).collect();
+                    assert_eq!(now, before, "failed insert modified the map");
+                }
+            }
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: hegel::TestCase) {
+            let k = draw_key(&tc);
+            let expected = self
+                .model
+                .iter()
+                .position(|&(mk, _)| mk == k)
+                .map(|pos| self.model.swap_remove(pos).1);
+            assert_eq!(self.subject.remove(&k), expected);
+        }
+
+        #[rule]
+        fn get(&mut self, tc: hegel::TestCase) {
+            let k = draw_key(&tc);
+            let expected = self
+                .model
+                .iter()
+                .find(|&&(mk, _)| mk == k)
+                .map(|&(_, v)| v);
+            assert_eq!(self.subject.get(&k).copied(), expected);
+            assert_eq!(self.subject.contains_key(&k), expected.is_some());
+        }
+
+        #[rule]
+        fn get_index_of(&mut self, tc: hegel::TestCase) {
+            let k = draw_key(&tc);
+            let expected = self.model.iter().position(|&(mk, _)| mk == k);
+            assert_eq!(self.subject.get_index_of(&k), expected);
+        }
+
+        #[rule]
+        fn get_index(&mut self, tc: hegel::TestCase) {
+            // one past the end included: both sides must return None
+            let index = tc.draw(generators::integers::<usize>().max_value(MAP_CAP + 1));
+            let expected = self.model.get(index).map(|&(ref k, ref v)| (k, v));
+            assert_eq!(self.subject.get_index(index), expected);
+        }
+
+        #[rule]
+        fn clear(&mut self, _: hegel::TestCase) {
+            self.subject.clear();
