+        }
+
+        #[rule]
+        fn clear(&mut self, _: hegel::TestCase) {
+            self.subject.clear();
+            self.model.clear();
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: hegel::TestCase) {
+            assert_eq!(self.subject.as_slice(), self.model.as_slice());
+            assert!(self.subject.len() <= MODEL_CAP, "len exceeds capacity");
+            assert_eq!(self.subject.is_empty(), self.model.is_empty());
+            assert_eq!(self.subject.is_full(), self.model.len() == MODEL_CAP);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_vec_model(tc: hegel::TestCase) {
+        hegel::stateful::machine(VecModel {
+                subject: Vec::new(),
+                model: std::vec::Vec::new(),
+            }).run(tc);
+    }
 }
