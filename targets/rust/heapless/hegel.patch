diff --git a/src/deque.rs b/src/deque.rs
index 3e90fb02..c662a4f4 100644
--- a/src/deque.rs
+++ b/src/deque.rs
@@ -2659,4 +2659,240 @@ mod tests {
         deque.clear();
         assert_eq!(Dropper::count(), 0);
     }
+
+    // ---------------------------------------------------------------------
+    // Hegel property-based tests
+    //
+    // Stateful model test: a `heapless::Deque<i32, 4>` is driven alongside a
+    // `std::collections::VecDeque<i32>` oracle. The small capacity means the
+    // ring buffer fills and wraps around constantly, which is where
+    // head/tail index bugs live. Pushes at capacity must return `Err` and
+    // leave the deque unchanged; iteration, `as_slices`, indexed access and
+    // `swap_remove_*` must all agree with the oracle.
+    // ---------------------------------------------------------------------
+
+    use std::collections::VecDeque;
+
+    use hegel::generators;
+
+    const DEQUE_CAP: usize = 4;
+
+    struct DequeModel {
+        subject: Deque<i32, DEQUE_CAP>,
+        model: VecDeque<i32>,
+    }
+
+    impl DequeModel {
+        fn model_snapshot(&self) -> Vec<i32> {
+            self.model.iter().copied().collect()
+        }
+
+        fn subject_snapshot(&self) -> Vec<i32> {
+            self.subject.iter().copied().collect()
+        }
+    }
+
+    #[hegel::state_machine]
+    impl DequeModel {
+        #[rule]
+        fn push_back(&mut self, tc: hegel::TestCase) {
+            let x = tc.draw(generators::integers::<i32>());
+            let before = self.model_snapshot();
+            match self.subject.push_back(x) {
+                Ok(()) => {
+                    assert!(before.len() < DEQUE_CAP, "push_back succeeded at capacity");
+                    self.model.push_back(x);
+                }
+                Err(rejected) => {
+                    assert_eq!(before.len(), DEQUE_CAP, "push_back failed below capacity");
+                    assert_eq!(rejected, x);
+                    assert_eq!(self.subject_snapshot(), before);
+                }
+            }
+        }
+
+        #[rule]
+        fn push_front(&mut self, tc: hegel::TestCase) {
+            let x = tc.draw(generators::integers::<i32>());
+            let before = self.model_snapshot();
+            match self.subject.push_front(x) {
+                Ok(()) => {
+                    assert!(before.len() < DEQUE_CAP, "push_front succeeded at capacity");
+                    self.model.push_front(x);
+                }
+                Err(rejected) => {
+                    assert_eq!(before.len(), DEQUE_CAP, "push_front failed below capacity");
+                    assert_eq!(rejected, x);
+                    assert_eq!(self.subject_snapshot(), before);
+                }
+            }
+        }
+
+        #[rule]
+        fn pop_back(&mut self, _: hegel::TestCase) {
+            assert_eq!(self.subject.pop_back(), self.model.pop_back());
+        }
+
+        #[rule]
+        fn pop_front(&mut self, _: hegel::TestCase) {
+            assert_eq!(self.subject.pop_front(), self.model.pop_front());
+        }
+
+        #[rule]
+        fn get(&mut self, tc: hegel::TestCase) {
+            // one past the end included: both sides must return None
+            let index = tc.draw(generators::integers::<usize>().max_value(DEQUE_CAP + 1));
+            assert_eq!(self.subject.get(index), self.model.get(index));
+        }
+
+        #[rule]
+        fn swap(&mut self, tc: hegel::TestCase) {
+            tc.assume(!self.model.is_empty());
+            let i = tc.draw(
+                generators::integers::<usize>().max_value(self.model.len() - 1),
+            );
+            let j = tc.draw(
+                generators::integers::<usize>().max_value(self.model.len() - 1),
+            );
+            self.subject.swap(i, j);
+            self.model.swap(i, j);
+        }
+
+        #[rule]
+        fn swap_remove_front(&mut self, tc: hegel::TestCase) {
+            let index = tc.draw(generators::integers::<usize>().max_value(DEQUE_CAP + 1));
+            assert_eq!(
+                self.subject.swap_remove_front(index),
+                self.model.swap_remove_front(index)
+            );
+        }
+
+        #[rule]
+        fn swap_remove_back(&mut self, tc: hegel::TestCase) {
+            let index = tc.draw(generators::integers::<usize>().max_value(DEQUE_CAP + 1));
+            assert_eq!(
+                self.subject.swap_remove_back(index),
+                self.model.swap_remove_back(index)
+            );
+        }
+
+        #[rule]
+        fn truncate(&mut self, tc: hegel::TestCase) {
+            let len = tc.draw(generators::integers::<usize>().max_value(DEQUE_CAP + 2));
+            self.subject.truncate(len);
+            self.model.truncate(len);
+        }
+
+        #[rule]
+        fn make_contiguous(&mut self, tc: hegel::TestCase) {
+            // KNOWN BUG (see `hegel_pinned_make_contiguous_full_bug` below):
+            // `make_contiguous` on a *full*, wrapped deque sets `back = N`
+            // (out of range), corrupting the internal state; a later
+            // `push_back` then writes out of bounds and aborts the whole
+            // process. Skip exactly that input here so this rule keeps
+            // testing every other `make_contiguous` case.
+            let (_, b) = self.subject.as_slices();
+            tc.assume(!(self.subject.is_full() && !b.is_empty()));
+            assert_eq!(self.subject.make_contiguous(), self.model.make_contiguous());
+        }
+
+        #[rule]
+        fn clear(&mut self, _: hegel::TestCase) {
+            self.subject.clear();
+            self.model.clear();
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: hegel::TestCase) {
+            assert!(self.subject.len() <= DEQUE_CAP, "len exceeds capacity");
+            assert_eq!(self.subject.len(), self.model.len());
+            assert_eq!(self.subject.is_empty(), self.model.is_empty());
+            assert_eq!(self.subject.is_full(), self.model.len() == DEQUE_CAP);
+            assert_eq!(self.subject.front(), self.model.front());
+            assert_eq!(self.subject.back(), self.model.back());
+            // iteration must agree in both directions
+            assert!(self.subject.iter().eq(self.model.iter()));
+            assert!(self.subject.iter().rev().eq(self.model.iter().rev()));
+            // as_slices must concatenate to the logical contents
+            let (a, b) = self.subject.as_slices();
+            let concat: Vec<i32> = a.iter().chain(b.iter()).copied().collect();
+            assert_eq!(concat, self.model_snapshot());
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_deque_model(tc: hegel::TestCase) {
+        hegel::stateful::machine(DequeModel {
+                subject: Deque::new(),
+                model: VecDeque::new(),
+            }).run(tc);
+    }
+
+    /// KNOWN FAILURE: real bug found by `hegel_deque_model`.
+    ///
+    /// `make_contiguous` on a *full*, wrapped deque takes the "head is
+    /// shorter" general branch and sets `self.back = len`, i.e. `back == N`,
+    /// which is out of range for the ring buffer (every other code path
+    /// keeps `back < N` and encodes fullness in the `full` flag).
+    ///
+    /// From that corrupted state, popping the front clears `full` and a
+    /// subsequent `push_front` cannot re-establish it (`front == 0` never
+    /// equals `back == N`), so `is_full()` reports `false` for a deque that
+    /// holds `N` elements. Worse, a `push_back` in this state writes through
+    /// `get_unchecked_mut(N)` — an out-of-bounds write (aborts under debug
+    /// preconditions; silent memory corruption in release). See the
+    /// `#[ignore]`d reproducer below for that manifestation.
+    ///
+    /// This test pins the bug deterministically and is expected to FAIL
+    /// until the bug is fixed.
+    #[test]
+    fn hegel_pinned_make_contiguous_full_bug() {
+        let mut q: Deque<i32, 4> = Deque::new();
+        // Fill, then rotate so the deque is full and wrapped with
+        // front = 3 (front slice shorter than back slice).
+        for i in 0..4 {
+            q.push_back(i).unwrap();
+        }
+        for i in 4..7 {
+            assert_eq!(q.pop_front(), Some(i - 4));
+            q.push_back(i).unwrap();
+        }
+        assert!(q.is_full());
+        assert_eq!(q.make_contiguous(), &[3, 4, 5, 6]);
+        // The deque still holds 4 elements; internally `back` is now N (4).
+        assert_eq!(q.pop_front(), Some(3));
+        q.push_front(3).unwrap();
+        // 4 elements in a capacity-4 deque must report full.
+        assert_eq!(q.len(), 4);
+        assert!(
+            q.is_full(),
+            "is_full() lies after make_contiguous on a full wrapped deque"
+        );
+    }
+
+    /// KNOWN FAILURE (process-aborting variant of
+    /// `hegel_pinned_make_contiguous_full_bug`): after `make_contiguous`
+    /// corrupts `back` to `N`, a pop + push_back pair makes `push_back`
+    /// write through `get_unchecked_mut(N)` — out of bounds. Under debug
+    /// unsafe-precondition checks this raises a non-unwinding panic and
+    /// SIGABRTs the whole test process (in release it is silent memory
+    /// corruption), so this reproducer is `#[ignore]`d to keep the rest of
+    /// the suite running. Run it explicitly with:
+    /// `cargo test hegel_pinned_make_contiguous_oob_abort -- --ignored`
+    #[test]
+    #[ignore = "aborts the process (out-of-bounds write) - run explicitly to reproduce"]
+    fn hegel_pinned_make_contiguous_oob_abort() {
+        let mut q: Deque<i32, 4> = Deque::new();
+        for i in 0..4 {
+            q.push_back(i).unwrap();
+        }
+        for i in 4..7 {
+            q.pop_front();
+            q.push_back(i).unwrap();
+        }
+        q.make_contiguous(); // corrupts back to N == 4
+        q.pop_front(); // clears `full`; back is still 4
+        // is_full() is false, so push_back proceeds and writes at index 4.
+        let _ = q.push_back(99);
+    }
 }
