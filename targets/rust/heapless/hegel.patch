diff --git a/src/binary_heap.rs b/src/binary_heap.rs
index 452b84a1..0e889498 100644
--- a/src/binary_heap.rs
+++ b/src/binary_heap.rs
@@ -916,4 +916,105 @@ mod tests {
     ) -> &'c BinaryHeapView<&'b (), Max> {
         x
     }
+
+    // ---------------------------------------------------------------------
+    // Hegel property-based tests
+    // ---------------------------------------------------------------------
+
+    use std::collections::BinaryHeap as StdBinaryHeap;
+    use std::vec::Vec;
+
+    use hegel::generators;
+
+    const HEAP_CAP: usize = 4;
+
+    /// Stateful model test: a `BinaryHeap<i32, Max, 4>` is driven alongside
+    /// `std::collections::BinaryHeap<i32>`. `pop`/`peek` must agree with the
+    /// oracle, `push` must return `Err(item)` exactly at capacity and leave
+    /// the heap unchanged, and the heap contents must stay multiset-equal to
+    /// the oracle.
+    struct MaxHeapModel {
+        subject: BinaryHeap<i32, Max, HEAP_CAP>,
+        model: StdBinaryHeap<i32>,
+    }
+
+    #[hegel::state_machine]
+    impl MaxHeapModel {
+        #[rule]
+        fn push(&mut self, tc: hegel::TestCase) {
+            let x = tc.draw(generators::integers::<i32>());
+            let mut before: Vec<i32> = self.subject.iter().copied().collect();
+            match self.subject.push(x) {
+                Ok(()) => {
+                    assert!(before.len() < HEAP_CAP, "push succeeded at capacity");
+                    self.model.push(x);
+                }
+                Err(rejected) => {
+                    assert_eq!(before.len(), HEAP_CAP, "push failed below capacity");
+                    assert_eq!(rejected, x);
+                    // a failed push must leave the heap unchanged
+                    let mut now: Vec<i32> = self.subject.iter().copied().collect();
+                    before.sort_unstable();
+                    now.sort_unstable();
+                    assert_eq!(now, before);
+                }
+            }
+        }
+
+        #[rule]
+        fn pop(&mut self, _: hegel::TestCase) {
+            assert_eq!(self.subject.pop(), self.model.pop());
+        }
+
+        #[rule]
+        fn clear(&mut self, _: hegel::TestCase) {
+            self.subject.clear();
+            self.model.clear();
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _: hegel::TestCase) {
+            assert!(self.subject.len() <= HEAP_CAP, "len exceeds capacity");
+            assert_eq!(self.subject.len(), self.model.len());
+            assert_eq!(self.subject.is_empty(), self.model.is_empty());
+            assert_eq!(self.subject.is_full(), self.model.len() == HEAP_CAP);
+            assert_eq!(self.subject.peek(), self.model.peek());
+            // multiset equality with the oracle
+            let mut ours: Vec<i32> = self.subject.iter().copied().collect();
+            let mut theirs: Vec<i32> = self.model.iter().copied().collect();
+            ours.sort_unstable();
+            theirs.sort_unstable();
+            assert_eq!(ours, theirs);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_binary_heap_max_model(tc: hegel::TestCase) {
+        hegel::stateful::machine(MaxHeapModel {
+                subject: BinaryHeap::new(),
+                model: StdBinaryHeap::new(),
+            }).run(tc);
+    }
+
+    /// Heap-sort differential: pushing arbitrary values into a `Min` heap and
+    /// popping them all must yield exactly the input sorted ascending
+    /// (`std`'s sort is the oracle).
+    #[hegel::test]
+    fn hegel_binary_heap_min_pop_order(tc: hegel::TestCase) {
+        let values: Vec<i32> = tc.draw(
+            generators::vecs(generators::integers::<i32>()).max_size(8),
+        );
+        let mut heap: BinaryHeap<i32, Min, 8> = BinaryHeap::new();
+        for &v in &values {
+            heap.push(v).unwrap();
+        }
+        let mut popped = Vec::new();
+        while let Some(v) = heap.pop() {
+            popped.push(v);
+        }
+        let mut expected = values.clone();
+        expected.sort_unstable();
+        assert_eq!(popped, expected);
+        assert!(heap.is_empty());
+    }
 }
