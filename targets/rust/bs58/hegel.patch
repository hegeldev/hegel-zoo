+
+/// Property-based tests (hegel).
+#[cfg(test)]
+mod hegel_tests {
+    // The crate is `no_std`; the tests themselves still run under std (and
+    // the `hegel::test` expansion wants `format!` and `ToString` in scope).
+    extern crate std;
+    use std::{format, string::ToString, vec::Vec};
+
+    use hegel::generators::{self, Generator};
+    use hegel::{PrettyPrintable, PrintableGenerator};
+
+    use super::{Alphabet, Error};
+
+    /// A candidate alphabet, as data: 58 unique ASCII bytes (valid), such an
+    /// alphabet with one byte copied over another (a planted duplicate) or
+    /// one byte replaced by a non-ASCII one, or 58 arbitrary bytes. `bytes()`
+    /// renders it.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    enum Candidate {
+        Valid([u8; 58]),
+        Duplicate { base: [u8; 58], from: usize, to: usize },
+        NonAscii { base: [u8; 58], at: usize, byte: u8 },
+        Arbitrary([u8; 58]),
+    }
+
+    impl Candidate {
+        fn bytes(&self) -> [u8; 58] {
+            match *self {
+                Candidate::Valid(base) | Candidate::Arbitrary(base) => base,
+                Candidate::Duplicate { mut base, from, to } => {
+                    base[to] = base[from];
+                    base
+                }
+                Candidate::NonAscii { mut base, at, byte } => {
+                    base[at] = byte;
+                    base
+                }
+            }
+        }
+    }
+
+    /// A position in an alphabet.
+    fn index() -> generators::IntegerGenerator<usize> {
+        generators::integers::<usize>().max_value(57)
+    }
+
+    /// 58 distinct ASCII bytes: a valid alphabet.
+    fn valid() -> impl PrintableGenerator<[u8; 58]> {
+        generators::vecs(generators::integers::<u8>().max_value(127))
+            .min_size(58)
+            .max_size(58)
+            .unique(true)
+            .map(|bytes: Vec<u8>| bytes.try_into().unwrap())
+    }
+
+    /// A candidate: valid first (the shrink target), then a valid alphabet
+    /// with a planted duplicate (`to` is drawn from the 57 positions other
+    /// than `from`, so the plant is never a no-op), a valid alphabet with a
+    /// planted non-ASCII byte, and 58 arbitrary bytes.
+    fn candidate() -> impl PrintableGenerator<Candidate> {
+        hegel::one_of!(
+            valid().map(Candidate::Valid),
+            hegel::tuples!(
+                valid(),
+                index(),
+                generators::integers::<usize>().max_value(56)
+            )
+            .map(|(base, from, other)| Candidate::Duplicate {
+                base,
+                from,
+                to: other + (other >= from) as usize,
+            }),
+            hegel::tuples!(valid(), index(), generators::integers::<u8>().min_value(128))
+                .map(|(base, at, byte)| Candidate::NonAscii { base, at, byte }),
+            generators::arrays::<_, u8, 58>(generators::integers::<u8>()).map(Candidate::Arbitrary),
+        )
+    }
+
+    /// Reference implementation of the documented validation rules: the first
+    /// offending index wins, non-ASCII is checked before duplicates at each
+    /// position.
+    fn expected_validation(base: &[u8; 58]) -> Result<(), Error> {
+        let mut seen: [Option<usize>; 128] = [None; 128];
+        for (i, &b) in base.iter().enumerate() {
+            if b >= 128 {
+                return Err(Error::NonAsciiCharacter { index: i });
+            }
+            if let Some(first) = seen[b as usize] {
+                return Err(Error::DuplicateCharacter {
+                    character: b as char,
+                    first,
+                    second: i,
+                });
+            }
+            seen[b as usize] = Some(i);
+        }
+        Ok(())
+    }
+
+    /// Property: `Alphabet::new` accepts exactly the arrays of 58 unique
+    /// ASCII bytes, and reports the correct error (kind, character, indexes)
+    /// for the first offending byte otherwise.
+    #[hegel::test]
+    fn hegel_new_validates_alphabets(tc: hegel::TestCase) {
+        let arr = tc.draw(candidate()).bytes();
+
+        match (Alphabet::new(&arr), expected_validation(&arr)) {
+            (Ok(_), Ok(())) => {}
+            (Err(actual), Err(expected)) => assert_eq!(expected, actual),
+            (actual, expected) => panic!(
+                "Alphabet::new disagrees with reference: {:?} vs {:?} for {:?}",
+                actual.map(|_| ()),
+                expected,
+                &arr[..],
+            ),
+        }
+    }
+}
