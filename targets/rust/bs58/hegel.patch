+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use arb::{alphabet, input_bytes, BITCOIN_CHARS};
+use hegel::generators::{self, Generator};
+use hegel::{PrettyPrintable, PrintableGenerator};
+
+/// Input of a drawn size up to 300 bytes behind up to four leading zero
+/// bytes: the size is drawn first so that multi-hundred-byte inputs are
+/// exercised too (`binary()` alone skews short).
+fn sized_input() -> impl PrintableGenerator<Vec<u8>> {
+    generators::integers::<usize>()
+        .max_value(300)
+        .flat_map(|n| {
+            hegel::tuples!(
+                generators::integers::<usize>().max_value(4),
+                generators::binary().min_size(n)
+            )
+        })
+        .map(|(leading_zeros, rest)| [vec![0u8; leading_zeros], rest].concat())
+}
+
+/// A single-character corruption of a Base58Check string: the character at
+/// position `at` (taken modulo the string's length) is replaced by the
+/// alphabet character `shift` (1..=57) places after it, cyclically, so the
+/// replacement always differs from the original.
+#[derive(Clone, Debug, PrettyPrintable)]
+struct Corruption {
+    at: usize,
+    shift: usize,
+}
+
+impl Corruption {
+    /// The corrupted bytes, with the index and the replacement used.
+    fn apply(&self, encoded: &[u8]) -> (Vec<u8>, usize, u8) {
+        let idx = self.at % encoded.len();
+        let original = BITCOIN_CHARS
+            .iter()
+            .position(|&c| c == encoded[idx])
+            .unwrap();
+        let replacement = BITCOIN_CHARS[(original + self.shift) % 58];
+        let mut corrupted = encoded.to_vec();
+        corrupted[idx] = replacement;
+        (corrupted, idx, replacement)
+    }
+}
+
+fn corruption() -> impl PrintableGenerator<Corruption> {
+    hegel::tuples!(
+        generators::integers::<usize>().max_value(999),
+        generators::integers::<usize>().min_value(1).max_value(57)
+    )
+    .map(|(at, shift)| Corruption { at, shift })
+}
+
+/// Property: decode(encode(x)) == x for arbitrary bytes and arbitrary valid
+/// alphabets.
+#[hegel::test]
+fn hegel_encode_decode_roundtrip(tc: hegel::TestCase) {
+    let (input, alpha) = tc.draw(hegel::tuples!(input_bytes(), alphabet()));
+    let alpha = alpha.alphabet();
+    let encoded = bs58::encode(&input).with_alphabet(&alpha).into_string();
+    let decoded = bs58::decode(&encoded)
+        .with_alphabet(&alpha)
+        .into_vec()
+        .unwrap();
+    assert_eq!(input, decoded);
+}
+
+/// Property: structural invariants of the encoded form — every character is
+/// from the alphabet, the number of leading "zero digit" characters equals
+/// the number of leading zero bytes, and the length is within the documented
+/// bounds (between input length and ~1.5x input length).
+#[hegel::test]
+fn hegel_encode_structure(tc: hegel::TestCase) {
+    let input = tc.draw(sized_input());
+
+    let encoded = bs58::encode(&input).into_string();
+
+    assert!(encoded.bytes().all(|b| BITCOIN_CHARS.contains(&b)));
+
+    let input_zeros = input.iter().take_while(|&&b| b == 0).count();
+    let encoded_ones = encoded.bytes().take_while(|&b| b == b'1').count();
+    assert_eq!(input_zeros, encoded_ones);
+
+    assert!(encoded.len() >= input.len());
+    assert!(encoded.len() <= input.len() + (input.len() + 1) / 2);
+}
+
+/// Property: encoding onto an exactly-sized buffer succeeds and matches
+/// `into_string`; onto a one-byte-undersized buffer it returns
+/// `BufferTooSmall` (and never panics).
+#[hegel::test]
+fn hegel_encode_onto_buffer_boundaries(tc: hegel::TestCase) {
+    let input = tc.draw(input_bytes());
+    let encoded = bs58::encode(&input).into_string();
+    let len = encoded.len();
+    let mut buf = vec![0xAAu8; len + 8];
+
+    if len > 0 {
+        assert_eq!(
+            Err(bs58::encode::Error::BufferTooSmall),
+            bs58::encode(&input).onto(&mut buf[..len - 1])
+        );
+    }
+
+    assert_eq!(Ok(len), bs58::encode(&input).onto(&mut buf[..len]));
+    assert_eq!(encoded.as_bytes(), &buf[..len]);
+    // bytes after the encoded output are untouched
+    assert!(buf[len..].iter().all(|&b| b == 0xAA));
+}
+
+/// Property: Base58Check round-trips for arbitrary payloads.
+#[cfg(feature = "check")]
+#[hegel::test]
+fn hegel_check_roundtrip(tc: hegel::TestCase) {
+    let input = tc.draw(input_bytes());
+    let encoded = bs58::encode(&input).with_check().into_string();
+    let decoded = bs58::decode(&encoded)
+        .with_check(None)
+        .into_vec()
+        .unwrap();
+    assert_eq!(input, decoded);
+}
+
+/// Property: Base58Check with a version byte round-trips; the decoded payload
+/// is the version byte followed by the original input.
+#[cfg(feature = "check")]
+#[hegel::test]
+fn hegel_check_version_roundtrip(tc: hegel::TestCase) {
+    let (input, version) = tc.draw(hegel::tuples!(input_bytes(), generators::integers::<u8>()));
+    let encoded = bs58::encode(&input)
+        .with_check_version(version)
+        .into_string();
+    let decoded = bs58::decode(&encoded)
+        .with_check(Some(version))
+        .into_vec()
+        .unwrap();
+    assert_eq!(version, decoded[0]);
+    assert_eq!(&input[..], &decoded[1..]);
+}
+
+/// Property: substituting any single character of a Base58Check string for a
+/// different alphabet character is detected as an error by checked decoding.
+/// (The 4-byte SHA-256 checksum makes a false accept a ~2^-32 event, far
+/// below what this test can hit.)
+#[cfg(feature = "check")]
+#[hegel::test]
+fn hegel_check_detects_single_char_corruption(tc: hegel::TestCase) {
+    let (input, corruption) = tc.draw(hegel::tuples!(input_bytes(), corruption()));
+    let encoded = bs58::encode(&input).with_check().into_string();
+    // checked encodings are never empty (>= 4 checksum bytes), so the
+    // corruption's position always finds a character
+    let (corrupted, idx, replacement) = corruption.apply(encoded.as_bytes());
+    let result = bs58::decode(&corrupted).with_check(None).into_vec();
+    assert!(
+        result.is_err(),
+        "corrupting {:?} at index {} to {:?} was not detected: {:?}",
+        encoded,
+        idx,
+        replacement as char,
+        result,
+    );
+}
+
+/// Property: CB58 round-trips for arbitrary payloads and optional versions.
+#[cfg(feature = "cb58")]
+#[hegel::test]
+fn hegel_cb58_roundtrip(tc: hegel::TestCase) {
+    let (input, version) = tc.draw(hegel::tuples!(
+        input_bytes(),
+        generators::optional(generators::integers::<u8>())
+    ));
+    let encoded = bs58::encode(&input).as_cb58(version).into_string();
+    let decoded = bs58::decode(&encoded)
+        .as_cb58(version)
+        .into_vec()
+        .unwrap();
+    match version {
+        Some(v) => {
+            assert_eq!(v, decoded[0]);
+            assert_eq!(&input[..], &decoded[1..]);
+        }
+        None => assert_eq!(input, decoded),
+    }
+}
+
 /// Stress test encoding by trying to encode increasingly long buffers.
 #[test]
 fn encode_stress_test() {
