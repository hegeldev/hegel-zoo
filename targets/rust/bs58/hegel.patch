+//! Generators shared by the hegel properties of `decode.rs` and `encode.rs`.
+//! Each is a value built from the binding's combinators; what a case needs is
+//! drawn as a small record and rendered by a pure function.
+#![allow(dead_code)]
+
+use hegel::generators::{self, Generator};
+use hegel::{PrettyPrintable, PrintableGenerator};
+
+pub const BITCOIN_CHARS: &[u8; 58] = b"123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
+const RIPPLE_CHARS: &[u8; 58] = b"rpshnaf39wBUDNEGHJKLM4PQRST7VWXYZ2bcdeCg65jkm8oFqi1tuvAxyz";
+const FLICKR_CHARS: &[u8; 58] = b"123456789abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ";
+
+/// A valid alphabet: one of the predefined ones, or a custom one of 58 unique
+/// ASCII bytes (the "generate configurations, not just payloads" pattern).
+#[derive(Clone, Debug, PrettyPrintable)]
+pub enum Alphabet {
+    Bitcoin,
+    Ripple,
+    Flickr,
+    Custom([u8; 58]),
+}
+
+const PREDEFINED: &[Alphabet] = &[Alphabet::Bitcoin, Alphabet::Ripple, Alphabet::Flickr];
+
+impl Alphabet {
+    pub fn bytes(&self) -> [u8; 58] {
+        match self {
+            Alphabet::Bitcoin => *BITCOIN_CHARS,
+            Alphabet::Ripple => *RIPPLE_CHARS,
+            Alphabet::Flickr => *FLICKR_CHARS,
+            Alphabet::Custom(bytes) => *bytes,
+        }
+    }
+
+    pub fn alphabet(&self) -> bs58::Alphabet {
+        bs58::Alphabet::new(&self.bytes()).unwrap()
+    }
+}
+
+/// A predefined alphabet (Bitcoin first, the shrink target) or a custom one.
+pub fn alphabet() -> impl PrintableGenerator<Alphabet> {
+    hegel::one_of!(
+        generators::sampled_from(PREDEFINED),
+        generators::vecs(generators::integers::<u8>().max_value(127))
+            .min_size(58)
+            .max_size(58)
+            .unique(true)
+            .map(|bytes: Vec<u8>| Alphabet::Custom(bytes.try_into().unwrap())),
+    )
+}
+
+/// Arbitrary input bytes behind up to eight leading zero bytes - the classic
+/// Base58 edge case (leading zero bytes map to leading "zero digit"
+/// characters instead of taking part in the big-integer conversion).
+pub fn input_bytes() -> impl PrintableGenerator<Vec<u8>> {
+    hegel::tuples!(
+        generators::integers::<usize>().max_value(8),
+        generators::binary()
+    )
+    .map(|(leading_zeros, rest)| [vec![0u8; leading_zeros], rest].concat())
+}
