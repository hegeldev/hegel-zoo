+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use arb::{alphabet, input_bytes, BITCOIN_CHARS};
+use hegel::generators::{self, Generator};
+use hegel::PrintableGenerator;
+
+/// Mostly-valid input: each byte is either a valid Base58 character (first,
+/// the shrink target) or fully arbitrary, so the first-invalid-byte boundary
+/// gets exercised at all positions. Returned as the concrete `VecGenerator`
+/// so that a property can bound its size.
+fn mostly_valid_input() -> generators::VecGenerator<impl PrintableGenerator<u8>, u8> {
+    generators::vecs(hegel::one_of!(
+        generators::sampled_from(&BITCOIN_CHARS[..]),
+        generators::integers::<u8>(),
+    ))
+}
+
+/// A digit string, as indexes into an alphabet, behind up to eight leading
+/// zero digits (the edge case).
+fn digits() -> impl PrintableGenerator<Vec<u8>> {
+    hegel::tuples!(
+        generators::integers::<usize>().max_value(8),
+        generators::vecs(generators::integers::<u8>().max_value(57))
+    )
+    .map(|(leading, rest)| [vec![0u8; leading], rest].concat())
+}
+
+/// Property: decode over arbitrary byte strings never panics and returns
+/// exactly the documented error for the *first* offending byte
+/// (`NonAsciiCharacter` for bytes > 127, `InvalidCharacter` for ASCII bytes
+/// outside the alphabet), and succeeds when every byte is valid.
+#[hegel::test]
+fn hegel_decode_error_characterization(tc: hegel::TestCase) {
+    let input = tc.draw(mostly_valid_input());
+    let result = bs58::decode(&input).into_vec();
+    let expected_err = input.iter().enumerate().find_map(|(i, &b)| {
+        if b > 127 {
+            Some(bs58::decode::Error::NonAsciiCharacter { index: i })
+        } else if !BITCOIN_CHARS.contains(&b) {
+            Some(bs58::decode::Error::InvalidCharacter {
+                character: b as char,
+                index: i,
+            })
+        } else {
+            None
+        }
+    });
+    match expected_err {
+        Some(err) => assert_eq!(Err(err), result),
+        None => assert!(result.is_ok(), "valid input failed: {:?}", result),
+    }
+}
+
+/// Property: decode (in all check modes) never panics on arbitrary Unicode
+/// strings — it returns an error or a value, but must not crash.
+#[hegel::test]
+fn hegel_decode_arbitrary_text_never_panics(tc: hegel::TestCase) {
+    let s: String = tc.draw(generators::text());
+    drop(bs58::decode(&s).into_vec());
+    #[cfg(feature = "check")]
+    drop(bs58::decode(&s).with_check(None).into_vec());
+    #[cfg(feature = "cb58")]
+    drop(bs58::decode(&s).as_cb58(None).into_vec());
+}
+
+/// Property: for any string over the alphabet (arbitrary alphabets included),
+/// decode succeeds and re-encoding reproduces the exact string — i.e. Base58
+/// is a bijection between byte strings and alphabet strings.
+#[hegel::test]
+fn hegel_decode_then_encode_identity(tc: hegel::TestCase) {
+    let (alpha, digits) = tc.draw(hegel::tuples!(alphabet(), digits()));
+    let alpha_bytes = alpha.bytes();
+    let alpha = alpha.alphabet();
+    let s: Vec<u8> = digits.iter().map(|&d| alpha_bytes[d as usize]).collect();
+
+    let decoded = bs58::decode(&s).with_alphabet(&alpha).into_vec().unwrap();
+    let reencoded = bs58::encode(&decoded).with_alphabet(&alpha).into_vec();
+    assert_eq!(s, reencoded);
+}
+
+/// Property: the `const` decoder (`into_array_const`) agrees with the runtime
+/// decoder (`into_vec`) — same bytes on success (zero-padded), same error on
+/// failure.
+#[hegel::test]
+fn hegel_decode_const_matches_runtime(tc: hegel::TestCase) {
+    // decoded length <= input length <= 64, so [u8; 64] can never be too small
+    let input = tc.draw(mostly_valid_input().max_size(64));
+    let runtime = bs58::decode(&input).into_vec();
+    let konst = bs58::decode(input.as_slice()).into_array_const::<64>();
+    match (runtime, konst) {
+        (Ok(v), Ok(arr)) => {
+            assert_eq!(v.as_slice(), &arr[..v.len()]);
+            assert!(arr[v.len()..].iter().all(|&b| b == 0));
+        }
+        (Err(r), Err(k)) => assert_eq!(r, k),
+        (r, k) => panic!("const/runtime decoders disagree: {:?} vs {:?}", r, k),
+    }
+}
+
+/// Property: decoding onto an exactly-sized buffer succeeds and yields the
+/// original bytes; onto a one-byte-undersized buffer it returns
+/// `BufferTooSmall` (and never panics).
+#[hegel::test]
+fn hegel_decode_onto_buffer_boundaries(tc: hegel::TestCase) {
+    let expected = tc.draw(input_bytes());
+    let encoded = bs58::encode(&expected).into_string();
+    let len = expected.len();
+    let mut buf = vec![0xAAu8; len + 8];
+
+    if len > 0 {
+        assert_eq!(
+            Err(bs58::decode::Error::BufferTooSmall),
+            bs58::decode(&encoded).onto(&mut buf[..len - 1])
+        );
+    }
+
+    assert_eq!(Ok(len), bs58::decode(&encoded).onto(&mut buf[..len]));
+    assert_eq!(&expected[..], &buf[..len]);
+    // bytes after the decoded output are untouched
+    assert!(buf[len..].iter().all(|&b| b == 0xAA));
+}
+
