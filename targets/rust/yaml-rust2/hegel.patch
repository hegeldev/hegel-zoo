diff --git a/tests/basic.rs b/tests/basic.rs
index d980bea..4ac0d98 100644
--- a/tests/basic.rs
+++ b/tests/basic.rs
@@ -525,3 +525,166 @@ fn test_nominal_float_parse() {
         assert!(it.as_str().is_some());
     }
 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use hegel::generators::{self, BoxedGenerator, Generator};
+
+/// Arbitrary text biased towards YAML syntax: either fully arbitrary Unicode
+/// text or a concatenation of YAML-significant fragments, so the scanner and
+/// parser see plenty of structurally interesting input.
+fn yamlish_text() -> BoxedGenerator<'static, String> {
+    const TOKENS: &[&str] = &[
+        "- ", "-", ": ", ":", "? ", "&a ", "*a", "!!int ", "!!str ", "!!float ", "!!bool ",
+        "!t ", "|", "|-", "|+", ">", ">-", "#c", "\n", "\n  ", "\n\t", " ", "'", "\"", "[",
+        "]", "{", "}", ",", "---", "...", "%YAML 1.2", "%TAG ! !e", "\t", "a", "b", "0", "1.5",
+        "null", "~", "true", "\\", "\"\\n\"", "''", "\u{feff}", "\r\n", "&", "*", "!", "@",
+        "`", "0o7", "+.inf", "e", ".",
+    ];
+    hegel::one_of!(
+        generators::text(),
+        generators::vecs(generators::sampled_from(
+            TOKENS.iter().map(|s| (*s).to_string()).collect::<Vec<_>>()
+        ))
+        .max_size(30)
+        .map(|v| v.concat()),
+    )
+    .boxed()
+}
+
+/// The loader must return `Ok` or `Err`, but never panic, whatever the input.
+#[hegel::test]
+fn pbt_load_arbitrary_text_never_panics(tc: hegel::TestCase) {
+    let s = tc.draw(yamlish_text());
+    drop(YamlLoader::load_from_str(&s));
+}
+
+/// Whether a loaded value is hit by a known emitter bug. Each class is
+/// pinned by a canonical failing `known_bug_*` test in
+/// `tests/test_round_trip.rs`; see there for details.
+fn hits_known_emitter_bug(doc: &Yaml) -> bool {
+    match doc {
+        // `known_bug_octal_like_string_changes_type` and
+        // `known_bug_plus_dot_inf_string_changes_type`.
+        Yaml::String(s) => {
+            s.strip_prefix("0o")
+                .map_or(false, |rest| i64::from_str_radix(rest, 8).is_ok())
+                || matches!(s.as_str(), "+.inf" | "+.Inf" | "+.INF")
+        }
+        // `!!float 5` loads as `Real("5")`, which is re-emitted as an
+        // integer: `known_bug_integer_looking_real_changes_type`.
+        Yaml::Real(s) => s.parse::<i64>().is_ok(),
+        Yaml::Array(v) => v.iter().any(hits_known_emitter_bug),
+        Yaml::Hash(h) => h
+            .iter()
+            .any(|(k, v)| hits_known_emitter_bug(k) || hits_known_emitter_bug(v)),
+        _ => false,
+    }
+}
+
+/// Whether a loaded value contains `BadValue` (empty documents, invalid
+/// tagged scalars, unresolved aliases). `BadValue` is not representable by
+/// the emitter (it is emitted as `~`), so roundtrip properties skip it.
+fn contains_badvalue(doc: &Yaml) -> bool {
+    match doc {
+        Yaml::BadValue => true,
+        Yaml::Array(v) => v.iter().any(contains_badvalue),
+        Yaml::Hash(h) => h
+            .iter()
+            .any(|(k, v)| contains_badvalue(k) || contains_badvalue(v)),
+        _ => false,
+    }
+}
+
+/// Any document the loader accepts must be re-emittable as valid YAML that
+/// parses back to the same value (load → emit → load is the identity on
+/// loaded values).
+#[hegel::test]
+fn pbt_emitted_documents_reparse_to_same_value(tc: hegel::TestCase) {
+    let s = tc.draw(yamlish_text());
+    let Ok(docs) = YamlLoader::load_from_str(&s) else {
+        tc.reject();
+    };
+    for doc in &docs {
+        if contains_badvalue(doc) || hits_known_emitter_bug(doc) {
+            continue;
+        }
+        let mut emitted = String::new();
+        YamlEmitter::new(&mut emitted).dump(doc).unwrap();
+        let reparsed = YamlLoader::load_from_str(&emitted).unwrap_or_else(|e| {
+            panic!("emitted YAML failed to reparse: {e}\ninput: {s:?}\nemitted: {emitted:?}")
+        });
+        assert_eq!(reparsed.len(), 1, "emitted: {emitted:?}");
+        assert_eq!(&reparsed[0], doc, "emitted: {emitted:?}");
+    }
+}
+
+/// An alias (`*a`) resolves to the same value as its anchor (`&a`).
+#[hegel::test]
+fn pbt_alias_resolves_to_anchored_value(tc: hegel::TestCase) {
+    let items: Vec<i64> = tc.draw(generators::vecs(generators::integers::<i64>()).max_size(5));
+    let body = items
+        .iter()
+        .map(ToString::to_string)
+        .collect::<Vec<_>>()
+        .join(", ");
+    let src = format!("- &a [{body}]\n- *a");
+    let docs = YamlLoader::load_from_str(&src).unwrap();
+    assert_eq!(docs.len(), 1);
+    let expected = Yaml::Array(items.into_iter().map(Yaml::Integer).collect());
+    assert_eq!(docs[0][0], expected);
+    assert_eq!(docs[0][1], expected);
+}
+
+/// The byte-stream decoder must never panic (or hang) on arbitrary bytes,
+/// whichever decoding trap is configured.
+#[cfg(feature = "encoding")]
+#[hegel::test]
+fn pbt_decoder_never_panics_on_arbitrary_bytes(tc: hegel::TestCase) {
+    use yaml_rust2::yaml::{YAMLDecodingTrap, YamlDecoder};
+    // KNOWN BUG exclusion: `decode_loop` (src/yaml.rs) grows the output by
+    // `input.len() / 10` bytes on `OutputFull`, and `String::reserve` only
+    // guarantees capacity >= len + additional. When `input.len() / 10` is
+    // smaller than the next character's UTF-8 width (up to 4 bytes), no
+    // progress is made and decoding spins forever, so inputs shorter than 40
+    // bytes can hang. `.min_size(40)` avoids the hang; the bug is pinned by
+    // the ignored `known_bug_decoder_hangs_on_short_expanding_input` test
+    // below.
+    let bytes: Vec<u8> = tc.draw(generators::binary().min_size(40));
+    let trap = match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => YAMLDecodingTrap::Ignore,
+        1 => YAMLDecodingTrap::Strict,
+        _ => YAMLDecodingTrap::Replace,
+    };
+    drop(YamlDecoder::read(bytes.as_slice()).encoding_trap(trap).decode());
+}
+
+/// KNOWN FAILURE (hang): `decode_loop` (src/yaml.rs) reserves `input.len()`
+/// output bytes up front and, whenever the output is full, grows it by
+/// `input.len() / 10` bytes. `String::reserve` only guarantees capacity >=
+/// len + additional, so whenever `input.len() / 10` is smaller than the next
+/// character's UTF-8 width the loop makes no progress and decoding hangs
+/// (inputs shorter than 40 bytes are affected; for inputs shorter than 10
+/// bytes the growth is exactly zero). Minimal reproducer: UTF-16LE BOM +
+/// `ሴሴሴ` (8 bytes in, 9 bytes of UTF-8 out).
+///
+/// Fixed upstream in v0.11.1 (issue #78): `decode_loop` now reserves
+/// `(input.len() / 10).max(4)` bytes, so every iteration makes progress.
+/// Kept `#[ignore]`d because a regression would hang the whole test suite
+/// rather than fail; run it manually with
+/// `cargo test -- --ignored known_bug_decoder` (with a timeout).
+#[cfg(feature = "encoding")]
+#[test]
+#[ignore = "a regression would hang the test suite; run manually with --ignored and a timeout"]
+fn known_bug_decoder_hangs_on_short_expanding_input() {
+    use yaml_rust2::yaml::{YAMLDecodingTrap, YamlDecoder};
+    let bytes: &[u8] = &[0xFF, 0xFE, 0x34, 0x12, 0x34, 0x12, 0x34, 0x12];
+    let docs = YamlDecoder::read(bytes)
+        .encoding_trap(YAMLDecodingTrap::Replace)
+        .decode()
+        .expect("UTF-16LE BOM + three U+1234 characters is a valid document");
+    assert_eq!(docs.len(), 1);
+    assert_eq!(docs[0].as_str(), Some("\u{1234}\u{1234}\u{1234}"));
+}
