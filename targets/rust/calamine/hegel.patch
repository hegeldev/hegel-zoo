+#[cfg(test)]
+mod hegel_tests {
+    //! Property-based tests (hegel) for the internal XLSX cell-reference and
+    //! dimension parsing helpers. These parse untrusted worksheet XML, so the
+    //! key properties are: never panic on arbitrary bytes, and round-trip
+    //! consistency between the index->name and name->index directions.
+    use super::{
+        column_number_to_name, get_dimension, get_row, get_row_column, Reference, MAX_COLUMNS,
+        MAX_ROWS,
+    };
+    use crate::utils::push_column;
+    use hegel::generators;
+
+    // A generator for byte strings biased toward the alphabet the cell-reference
+    // grammar actually uses (letters, digits, `$`, `:`) plus arbitrary bytes.
+    // Building from these characters reaches the interesting parser states far
+    // more often than uniform bytes, while still allowing garbage through.
+    fn ref_like_bytes(tc: &hegel::TestCase) -> Vec<u8> {
+        let n = tc.draw(generators::integers::<usize>().max_value(24));
+        let mut out = Vec::with_capacity(n);
+        for _ in 0..n {
+            let b = tc.draw(hegel::one_of!(
+                generators::sampled_from(b"ABCDEFGHIJKLMNOPQRSTUVWXYZ".to_vec()),
+                generators::sampled_from(b"abcdefghijklmnopqrstuvwxyz".to_vec()),
+                generators::sampled_from(b"0123456789".to_vec()),
+                generators::sampled_from(b"$:".to_vec()),
+                generators::integers::<u8>(),
+            ));
+            out.push(b);
+        }
+        out
+    }
+
+    // PROPERTY: `column_number_to_name` produces a name that parses back to the
+    // same column index, for every valid column (0..MAX_COLUMNS). This is the
+    // cell-reference index<->name round-trip; it should hold for the entire
+    // valid column range including the XFD (MAX_COLUMNS-1) boundary.
+    #[hegel::test]
+    fn column_name_roundtrips(tc: hegel::TestCase) {
+        let col = tc.draw(generators::integers::<u32>().max_value(MAX_COLUMNS - 1));
+        let mut buf = Vec::new();
+        column_number_to_name(col, &mut buf).expect("valid column must encode");
+        match Reference::parse(&buf) {
+            Ok(Reference::Column { col: c, absolute }) => {
+                assert_eq!(c, col, "column name {buf:?} parsed to wrong index");
+                assert!(!absolute);
+            }
+            other => panic!("column name {buf:?} did not parse as a column: {other:?}"),
+        }
+    }
+
+    // PROPERTY: a Reference (cell / column / row) formatted to text parses back
+    // to an equal Reference. Round-trip over the whole valid coordinate space,
+    // including absolute (`$`) markers and the MAX_ROWS / MAX_COLUMNS boundaries.
+    #[hegel::test]
+    fn reference_format_parse_roundtrip(tc: hegel::TestCase) {
+        let col = tc.draw(generators::integers::<u32>().max_value(MAX_COLUMNS - 1));
+        let row = tc.draw(generators::integers::<u32>().max_value(MAX_ROWS - 1));
+        let abs_col = tc.draw(generators::booleans());
+        let abs_row = tc.draw(generators::booleans());
+        let kind = tc.draw(generators::integers::<u8>().max_value(2));
+        let reference = match kind {
+            0 => Reference::Cell {
+                row,
+                col,
+                absolute_row: abs_row,
+                absolute_col: abs_col,
+            },
+            1 => Reference::Column {
+                col,
+                absolute: abs_col,
+            },
+            _ => Reference::Row {
+                row,
+                absolute: abs_row,
+            },
+        };
+        let mut buf = Vec::new();
+        reference.format(&mut buf).expect("valid reference formats");
+        let parsed = Reference::parse(&buf).expect("formatted reference re-parses");
+        // Reference doesn't derive PartialEq, so check the round-trip via a
+        // format fixpoint: re-formatting the parsed reference must reproduce the
+        // exact same text.
+        let mut buf2 = Vec::new();
+        parsed.format(&mut buf2).expect("parsed reference formats");
+        assert_eq!(buf, buf2, "roundtrip changed reference text");
+    }
+
+    // PROPERTY (parse robustness): `Reference::parse` must return Ok or Err on
+    // ANY byte string, never panic.
+    #[hegel::test]
+    fn reference_parse_never_panics(tc: hegel::TestCase) {
+        let bytes = ref_like_bytes(&tc);
+        let _ = Reference::parse(&bytes);
+    }
+
+    // PROPERTY (parse robustness): `get_row` / `get_row_column` (used on the
+    // untrusted worksheet cell `r="A1"` attribute and on dimension strings) must
+    // never panic on arbitrary bytes.
+    //
+    // KNOWN FAILURE — real bug. `get_row_and_optional_column` accumulates the
+    // column with unchecked `col = col * 26 + ...` and the row with unchecked
+    // `row = row * 10 + ...`, so an over-long reference such as the 7-letter
+    // column "MWLQKWV" (or a long digit run) overflows u32 and panics in a
+    // debug/overflow-checked build instead of returning an Err. The sibling
+    // parser `Reference::parse` deliberately uses `wrapping_mul`/`wrapping_add`
+    // to avoid exactly this, so `get_row_column` is the inconsistent, panicking
+    // path. Oracle-independent panic. Pinned by drawing long letter-only refs.
+    #[hegel::test(test_cases = 300)]
+    fn get_row_column_never_panics(tc: hegel::TestCase) {
+        // Draw a fairly long run of uppercase letters (a giant column ref); 6+
+        // letters overflow u32, so the panic reproduces on essentially every run.
+        let n = tc.draw(generators::integers::<usize>().min_value(6).max_value(12));
+        let mut bytes = Vec::with_capacity(n);
+        for _ in 0..n {
+            bytes.push(tc.draw(generators::sampled_from(
+                b"ABCDEFGHIJKLMNOPQRSTUVWXYZ".to_vec(),
+            )));
+        }
+        let s = std::str::from_utf8(&bytes).unwrap();
+        let _ = get_row(s);
+        let _ = get_row_column(s);
+    }
+
+    // PROPERTY: `column_number_to_name` never panics on any u32 and enforces its
+    // documented bound (rejects col >= MAX_COLUMNS, succeeds below it).
+    #[hegel::test]
+    fn column_number_to_name_bounds(tc: hegel::TestCase) {
+        let col = tc.draw(generators::integers::<u32>());
+        let mut buf = Vec::new();
+        let res = column_number_to_name(col, &mut buf);
+        if col >= MAX_COLUMNS {
+            assert!(res.is_err(), "col {col} >= MAX_COLUMNS must be rejected");
+        } else {
+            assert!(res.is_ok(), "col {col} < MAX_COLUMNS must encode");
+            assert!(!buf.is_empty());
+        }
+    }
+
+    // PROPERTY (parse robustness): `get_dimension` (called on the untrusted
+    // `<dimension ref="...">` string) must never panic on arbitrary bytes.
+    //
+    // KNOWN FAILURE — real bug. `get_dimension` computes `end - start` with
+    // unchecked subtraction, so a reversed dimension such as `A2:A1` (a corrupt
+    // but syntactically valid worksheet dimension) underflows and panics
+    // ("attempt to subtract with overflow") in a debug/overflow-checked build
+    // instead of returning an Err. This is an oracle-independent robustness bug
+    // reachable from a crafted xlsx. Deterministically pinned by boosting toward
+    // reversed two-cell dimensions.
+    #[hegel::test(test_cases = 400)]
+    fn get_dimension_never_panics(tc: hegel::TestCase) {
+        // Boost heavily toward well-formed but possibly-reversed `X:Y` dimensions
+        // so the underflow reproduces on every run.
+        let start_col = tc.draw(generators::integers::<u32>().max_value(50));
+        let start_row = tc.draw(generators::integers::<u32>().min_value(1).max_value(50));
+        let end_col = tc.draw(generators::integers::<u32>().max_value(50));
+        let end_row = tc.draw(generators::integers::<u32>().min_value(1).max_value(50));
+        let mut a = Vec::new();
+        column_number_to_name(start_col, &mut a).unwrap();
+        a.extend(start_row.to_string().into_bytes());
+        let mut b = Vec::new();
+        column_number_to_name(end_col, &mut b).unwrap();
+        b.extend(end_row.to_string().into_bytes());
+        let mut dim = a;
+        dim.push(b':');
+        dim.extend(b);
+        let _ = get_dimension(std::str::from_utf8(&dim).unwrap());
+    }
+
+    // PROPERTY: `push_column` (used to render column references in XLS/XLSB
+    // formulas) must agree with the crate's own `column_number_to_name` (used
+    // for XLSX and validated by unit tests to match Excel's A/Z/AA/XFD scheme).
+    //
+    // KNOWN FAILURE — real bug. `push_column` drops the high-order digit for
+    // columns >= 26: it renders column 26 as "A" (not "AA") and column 27 as
+    // "B" (not "AB"). It is therefore also NOT injective — push_column(0) and
+    // push_column(26) both yield "A" — so distinct columns collide to the same
+    // formula reference. Oracle-independent (non-injective index->name mapping).
+    // Deterministically pinned: any column >= 26 fails, which is almost the
+    // entire drawn range.
+    #[hegel::test(test_cases = 300)]
+    fn push_column_matches_column_number_to_name(tc: hegel::TestCase) {
+        let col = tc.draw(generators::integers::<u32>().max_value(MAX_COLUMNS - 1));
+        let mut expected = Vec::new();
+        column_number_to_name(col, &mut expected).unwrap();
+        let mut actual = String::new();
+        push_column(col, &mut actual);
+        assert_eq!(
+            actual.as_bytes(),
+            expected.as_slice(),
+            "push_column({col}) = {actual:?}, expected {:?}",
+            std::str::from_utf8(&expected).unwrap()
+        );
+    }
+}
