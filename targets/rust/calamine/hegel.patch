+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel).
+//
+// calamine reads spreadsheets from untrusted files, so the highest-value
+// properties are decoder-robustness ones: opening arbitrary / corrupted bytes
+// must return an Err (never panic, hang, or OOM), and the public numeric/date
+// value conversions must not panic on boundary values.
+// ---------------------------------------------------------------------------
+#[cfg(test)]
+mod hegel_props {
+    use calamine::{
+        expand_shared_formula, open_workbook_auto_from_rs, Data, DataType, ExcelDateTime,
+        ExcelDateTimeType, Ods, Reader, Xls, Xlsb, Xlsx,
+    };
+    use hegel::generators;
+    use std::io::Cursor;
+
+    // Arbitrary byte buffer, size-capped so the test's own resource use stays
+    // bounded (this cap protects the test, not calamine's contract; the reader
+    // is expected to handle inputs of any size gracefully).
+    fn arbitrary_bytes(tc: &hegel::TestCase) -> Vec<u8> {
+        tc.draw(generators::binary().max_size(4096))
+    }
+
+    fn cursor(bytes: Vec<u8>) -> Cursor<Vec<u8>> {
+        Cursor::new(bytes)
+    }
+
+    // PROPERTY (arbitrary-bytes robustness): every statically-typed reader
+    // constructor must return Ok or Err on arbitrary bytes, never panic/hang.
+    #[hegel::test]
+    fn readers_never_panic_on_arbitrary_bytes(tc: hegel::TestCase) {
+        let bytes = arbitrary_bytes(&tc);
+        let _ = <Xlsx<_> as Reader<_>>::new(cursor(bytes.clone()));
+        let _ = <Xlsb<_> as Reader<_>>::new(cursor(bytes.clone()));
+        let _ = <Xls<_> as Reader<_>>::new(cursor(bytes.clone()));
+        let _ = <Ods<_> as Reader<_>>::new(cursor(bytes));
+    }
+
+    // PROPERTY (arbitrary-bytes robustness): the format-sniffing entry point
+    // must not panic on arbitrary bytes; if it returns a workbook, iterating its
+    // sheets must also stay panic-free.
+    #[hegel::test]
+    fn auto_open_never_panics_on_arbitrary_bytes(tc: hegel::TestCase) {
+        let bytes = arbitrary_bytes(&tc);
+        if let Ok(mut wb) = open_workbook_auto_from_rs(cursor(bytes)) {
+            let names = wb.sheet_names().to_owned();
+            for name in names.iter().take(8) {
+                let _ = wb.worksheet_range(name);
+            }
+        }
+    }
+
+    // PROPERTY (arbitrary-bytes robustness): bytes that begin with the ZIP local
+    // file header magic reach deeper into the zip/xlsx and ods decoders. They
+    // must still never panic. A crafted ZIP with a huge declared size must not
+    // OOM (the 4 KiB input cap keeps the test bounded either way).
+    #[hegel::test]
+    fn zip_magic_prefixed_bytes_never_panic(tc: hegel::TestCase) {
+        let mut bytes = b"PK\x03\x04".to_vec();
+        bytes.extend(arbitrary_bytes(&tc));
+        let _ = <Xlsx<_> as Reader<_>>::new(cursor(bytes.clone()));
+        let _ = <Ods<_> as Reader<_>>::new(cursor(bytes));
+    }
+
+    // PROPERTY (valid-file-then-corrupt): start from a real, valid xlsx fixture,
+    // then flip bytes or truncate it. Opening the mutated file and reading every
+    // sheet must return Err gracefully, never panic.
+    #[hegel::test]
+    fn corrupted_valid_xlsx_never_panics(tc: hegel::TestCase) {
+        let original = std::fs::read("tests/minimal_package.xlsx")
+            .expect("fixture tests/minimal_package.xlsx must exist");
+        let mut bytes = original.clone();
+        // Apply between 1 and 8 mutations, each either a byte flip or a truncation.
+        let n_muts = tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+        for _ in 0..n_muts {
+            if bytes.is_empty() {
+                break;
+            }
+            if tc.draw(generators::booleans()) {
+                // Flip a byte.
+                let idx = tc.draw(
+                    generators::integers::<usize>()
+                        .min_value(0)
+                        .max_value(bytes.len() - 1),
+                );
+                let xor = tc.draw(generators::integers::<u8>().min_value(1));
+                bytes[idx] ^= xor;
+            } else {
+                // Truncate.
+                let new_len = tc.draw(
+                    generators::integers::<usize>()
+                        .min_value(0)
+                        .max_value(bytes.len()),
+                );
+                bytes.truncate(new_len);
+            }
+        }
+        if let Ok(mut wb) = <Xlsx<_> as Reader<_>>::new(cursor(bytes)) {
+            let names = wb.sheet_names().to_owned();
+            for name in &names {
+                let _ = wb.worksheet_range(name);
+                let _ = wb.worksheet_formula(name);
+            }
+        }
+    }
+
+    // PROPERTY (parse robustness): `expand_shared_formula` is public and parses
+    // an untrusted formula template plus arbitrary source/target positions. It
+    // must return Ok or Err on any input, never panic.
+    #[hegel::test]
+    fn expand_shared_formula_never_panics(tc: hegel::TestCase) {
+        // Bias toward formula-shaped strings (cell refs, `$`, operators) while
+        // still allowing arbitrary text through.
+        let n = tc.draw(generators::integers::<usize>().max_value(40));
+        let mut formula = String::new();
+        for _ in 0..n {
+            let piece: String = tc.draw(hegel::one_of!(
+                generators::sampled_from(
+                    ["A1", "$B$2", "ZZ99", "+", "-", "*", "(", ")", ":", ",", "SUM", "1", "AAA1000"]
+                        .iter()
+                        .map(|s| s.to_string())
+                        .collect::<Vec<_>>()
+                ),
+                generators::text().max_size(4)
+            ));
+            formula.push_str(&piece);
+        }
+        let start = (
+            tc.draw(generators::integers::<u32>().max_value(2_000_000)),
+            tc.draw(generators::integers::<u32>().max_value(40_000)),
+        );
+        let end = (
+            tc.draw(generators::integers::<u32>().max_value(2_000_000)),
+            tc.draw(generators::integers::<u32>().max_value(40_000)),
+        );
+        let _ = expand_shared_formula(&formula, start, end);
+    }
+
+    // PROPERTY (Data conversions): the accessor/predicate methods on `Data` must
+    // be internally consistent and never panic. If `is_int` holds then
+    // `get_int` is Some; likewise for float/bool/string; and `as_string` never
+    // panics on any variant.
+    #[hegel::test]
+    fn data_accessors_are_consistent(tc: hegel::TestCase) {
+        let value = tc.draw(generators::integers::<u8>().max_value(6));
+        let data = match value {
+            0 => Data::Int(tc.draw(generators::integers::<i64>())),
+            1 => Data::Float(tc.draw(generators::floats::<f64>())),
+            2 => Data::Bool(tc.draw(generators::booleans())),
+            3 => Data::String(tc.draw(generators::text().max_size(32))),
+            4 => Data::DateTime(ExcelDateTime::new(
+                tc.draw(generators::floats::<f64>().allow_nan(false).allow_infinity(false)),
+                ExcelDateTimeType::DateTime,
+                tc.draw(generators::booleans()),
+            )),
+            5 => Data::Empty,
+            _ => Data::Bool(tc.draw(generators::booleans())),
+        };
+        // Predicate implies accessor.
+        if data.is_int() {
+            assert!(data.get_int().is_some());
+        }
+        if data.is_float() {
+            assert!(data.get_float().is_some());
+        }
+        if data.is_bool() {
+            assert!(data.get_bool().is_some());
+        }
+        if data.is_string() {
+            assert!(data.get_string().is_some());
+        }
+        // These must never panic for any variant.
+        let _ = data.as_string();
+        let _ = data.as_i64();
+        let _ = data.as_f64();
+        let _ = data.is_empty();
+    }
+
+    // PROPERTY (boundary values): `ExcelDateTime::to_ymd_hms_milli` is documented
+    // to "always return a date, even if the serial value is outside Excel's
+    // range". It must therefore never panic on any finite or non-finite f64.
+    //
+    // KNOWN FAILURE — real bug. For very large or infinite serials the internal
+    // `excel_datetime.floor() as u64` saturates to u64::MAX, and the subsequent
+    // `days += 109_572` overflows and panics ("attempt to add with overflow") in
+    // a debug/overflow-checked build instead of returning a (garbage-but-valid)
+    // date as documented. Oracle-independent panic. Pinned by boosting toward
+    // infinity / f64::MAX.
+    #[hegel::test(test_cases = 300)]
+    fn exceldatetime_to_ymd_never_panics(tc: hegel::TestCase) {
+        let value = tc.draw(hegel::one_of!(
+            generators::sampled_from(vec![
+                f64::INFINITY,
+                f64::NEG_INFINITY,
+                f64::MAX,
+                f64::MIN,
+                1e19,
+                1e300,
+            ]),
+            generators::floats::<f64>(),
+            generators::floats::<f64>().min_value(0.0).max_value(2_958_465.0),
+        ));
+        let is_1904 = tc.draw(generators::booleans());
+        let dt = ExcelDateTime::new(value, ExcelDateTimeType::DateTime, is_1904);
+        let _ = dt.to_ymd_hms_milli();
+    }
+}
