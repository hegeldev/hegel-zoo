diff --git a/src/geodesic.rs b/src/geodesic.rs
index 6098f52..29a2114 100644
--- a/src/geodesic.rs
+++ b/src/geodesic.rs
@@ -2733,4 +2733,418 @@ mod tests {
         assert_relative_eq!(lat, start.0, epsilon = 1.0e-3);
         assert_relative_eq!(lon, start.1, epsilon = 1.0e-3);
     }
+
+    /// Property-based tests (hegel).
+    ///
+    /// Tolerance calibration: GeographicLib documents round-off errors of
+    /// about 15 nanometers for direct/inverse solutions on terrestrial
+    /// ellipsoids. `POS_TOL_M` (100 nm) gives ~6x headroom over that.
+    /// Azimuth tolerances are conditioned through the reduced length m12: a
+    /// perturbation of the azimuth at point 1 by da (radians) displaces point
+    /// 2 by about |m12| * da, so a positional agreement of POS_TOL_M pins the
+    /// azimuth only to about POS_TOL_M / |m12| radians.
+    mod hegel_props {
+        use super::*;
+        use hegel::generators;
+
+        /// Maximum possible shortest-path distance on WGS84: the distance
+        /// between antipodal points, which is half the meridian circumference,
+        /// ~20_003_931.4586 m (plus slack for round-off).
+        const MAX_SHORTEST_M: f64 = 20_003_932.0;
+
+        /// Below this length, a WGS84 geodesic segment is guaranteed to be a
+        /// *shortest* path regardless of azimuth. The tightest cut distance is
+        /// for equatorial geodesics, a*pi*(1-f) ~ 19_970_326 m; 19_900_000
+        /// leaves ~70 km margin while still probing deep near-antipodal cases.
+        const MINIMAL_CAP_M: f64 = 19_900_000.0;
+
+        /// Positional round-off tolerance (meters): 100 nm, ~6x the
+        /// documented ~15 nm accuracy of GeographicLib.
+        const POS_TOL_M: f64 = 1e-7;
+
+        #[hegel::composite]
+        fn latitudes(tc: &hegel::TestCase) -> f64 {
+            // Full domain [-90, 90] with the poles and equator boosted:
+            // they are the documented special cases (azimuth-at-pole
+            // convention, equatorial geodesics).
+            tc.draw(hegel::one_of!(
+                generators::floats::<f64>().min_value(-90.0).max_value(90.0),
+                generators::sampled_from(vec![-90.0, 0.0, 90.0]),
+            ))
+        }
+
+        #[hegel::composite]
+        fn longitudes(tc: &hegel::TestCase) -> f64 {
+            tc.draw(hegel::one_of!(
+                generators::floats::<f64>().min_value(-180.0).max_value(180.0),
+                generators::sampled_from(vec![-180.0, 0.0, 180.0]),
+            ))
+        }
+
+        /// Longitudes outside the conventional range; the library documents
+        /// that input longitudes are reduced internally.
+        #[hegel::composite]
+        fn wide_longitudes(tc: &hegel::TestCase) -> f64 {
+            tc.draw(hegel::one_of!(
+                generators::floats::<f64>().min_value(-180.0).max_value(180.0),
+                generators::floats::<f64>().min_value(-720.0).max_value(720.0),
+                generators::sampled_from(vec![-540.0, -360.0, -180.0, 0.0, 180.0, 360.0, 540.0]),
+            ))
+        }
+
+        #[hegel::composite]
+        fn azimuths(tc: &hegel::TestCase) -> f64 {
+            tc.draw(hegel::one_of!(
+                generators::floats::<f64>().min_value(-180.0).max_value(180.0),
+                generators::sampled_from(vec![-180.0, -90.0, 0.0, 90.0, 180.0]),
+            ))
+        }
+
+        /// Smallest absolute difference between two angles (degrees), mod 360.
+        fn ang_gap_deg(a: f64, b: f64) -> f64 {
+            let d = (a - b).rem_euclid(360.0);
+            d.min(360.0 - d)
+        }
+
+        /// Geodesic separation of two points, used as a "measuring tape" for
+        /// landing checks. The inverse solve for tiny separations is
+        /// well-conditioned, so this is a sound oracle for near-coincident
+        /// points even though it reuses the library.
+        fn gap_m(g: &Geodesic, lat_a: f64, lon_a: f64, lat_b: f64, lon_b: f64) -> f64 {
+            let s: f64 = g.inverse(lat_a, lon_a, lat_b, lon_b);
+            s
+        }
+
+        /// The crown roundtrip: direct(lat1, lon1, azi1, s12) -> (lat2, lon2),
+        /// then inverse(lat1, lon1, lat2, lon2) must recover s12 and azi1.
+        /// s12 is capped at MINIMAL_CAP_M so the direct segment is the unique
+        /// shortest path, which is what inverse returns.
+        #[hegel::test]
+        fn test_hegel_direct_inverse_roundtrip(tc: hegel::TestCase) {
+            let g = Geodesic::wgs84();
+            let lat1 = tc.draw(latitudes());
+            let lon1 = tc.draw(longitudes());
+            let azi1 = tc.draw(azimuths());
+            let s12 = tc.draw(
+                generators::floats::<f64>()
+                    .min_value(0.0)
+                    .max_value(MINIMAL_CAP_M),
+            );
+
+            let (lat2, lon2, _azi2, m12) = g.direct(lat1, lon1, azi1, s12);
+            let (s12_back, azi1_back, _azi2_back, _a12): (f64, f64, f64, f64) =
+                g.inverse(lat1, lon1, lat2, lon2);
+
+            assert!(
+                (s12_back - s12).abs() <= POS_TOL_M,
+                "distance not recovered: s12={s12}, s12_back={s12_back}, diff={}",
+                (s12_back - s12).abs()
+            );
+
+            // Azimuth recovery, conditioned on |m12| (see module docs). When
+            // |m12| < 1 m (s12 ~ 0, or within ~1 m of the conjugate point) the
+            // endpoint position no longer determines the azimuth to a useful
+            // precision, so the check is skipped; the distance assertion above
+            // still ran. The 1e-11 deg floor covers f64 quantization of the
+            // returned azimuths.
+            if m12.abs() >= 1.0 {
+                let azi_tol_deg = (POS_TOL_M / m12.abs()).to_degrees().max(1e-11);
+                assert!(
+                    ang_gap_deg(azi1_back, azi1) <= azi_tol_deg,
+                    "azimuth not recovered: azi1={azi1}, azi1_back={azi1_back}, \
+                     gap={}, tol={azi_tol_deg}, m12={m12}",
+                    ang_gap_deg(azi1_back, azi1)
+                );
+            }
+        }
+
+        /// Inverse-direct roundtrip: solving inverse(A, B) and then shooting
+        /// from A with the returned azi1 for the returned s12 must land on B.
+        #[hegel::test]
+        fn test_hegel_inverse_direct_lands_on_target(tc: hegel::TestCase) {
+            let g = Geodesic::wgs84();
+            let lat1 = tc.draw(latitudes());
+            let lon1 = tc.draw(longitudes());
+            let lat2 = tc.draw(latitudes());
+            let lon2 = tc.draw(longitudes());
+
+            let (s12, azi1, _azi2, _a12): (f64, f64, f64, f64) =
+                g.inverse(lat1, lon1, lat2, lon2);
+            let (lat2_d, lon2_d) = g.direct(lat1, lon1, azi1, s12);
+
+            let gap = gap_m(&g, lat2, lon2, lat2_d, lon2_d);
+            assert!(
+                gap <= POS_TOL_M,
+                "direct did not land on inverse's target: gap={gap} m, \
+                 target=({lat2}, {lon2}), landed=({lat2_d}, {lon2_d}), s12={s12}, azi1={azi1}",
+                azi1 = azi1, gap = gap, lat2 = lat2, lat2_d = lat2_d, lon2 = lon2, lon2_d = lon2_d, s12 = s12
+            );
+        }
+
+        /// Exchanging the two points must give the same distance, and the
+        /// azimuths of the reversed solution must be the originals rotated by
+        /// 180 degrees (the same path walked backwards).
+        #[hegel::test]
+        fn test_hegel_inverse_symmetry_under_point_exchange(tc: hegel::TestCase) {
+            let g = Geodesic::wgs84();
+            let lat1 = tc.draw(latitudes());
+            let lon1 = tc.draw(longitudes());
+            let lat2 = tc.draw(latitudes());
+            let lon2 = tc.draw(longitudes());
+
+            let (s12, azi1, azi2, m12, _m12g, _m21g, _a12): (f64, f64, f64, f64, f64, f64, f64) =
+                g.inverse(lat1, lon1, lat2, lon2);
+            let (s12_r, azi1_r, azi2_r, _a12_r): (f64, f64, f64, f64) =
+                g.inverse(lat2, lon2, lat1, lon1);
+
+            assert!(
+                (s12 - s12_r).abs() <= POS_TOL_M,
+                "distance not symmetric: s12={s12}, s12_r={s12_r}",
+                s12 = s12, s12_r = s12_r
+            );
+
+            // Azimuth reversal is only checked where the shortest path is
+            // unique (s12 below the cut distance) and the azimuths are
+            // recoverable from positions (|m12| >= 1 m; excludes coincident
+            // points and conjugate-point neighborhoods). Tolerance is
+            // conditioned on |m12| as in the roundtrip test; factor 2 because
+            // both solves contribute.
+            if s12 < MINIMAL_CAP_M && m12.abs() >= 1.0 {
+                let azi_tol_deg = (2.0 * POS_TOL_M / m12.abs()).to_degrees().max(1e-11);
+                assert!(
+                    ang_gap_deg(azi1, azi2_r + 180.0) <= azi_tol_deg,
+                    "azi1 vs reversed azi2_r: azi1={azi1}, azi2_r={azi2_r}, tol={azi_tol_deg}",
+                azi1 = azi1, azi2_r = azi2_r, azi_tol_deg = azi_tol_deg
+            );
+                assert!(
+                    ang_gap_deg(azi2, azi1_r + 180.0) <= azi_tol_deg,
+                    "azi2 vs reversed azi1_r: azi2={azi2}, azi1_r={azi1_r}, tol={azi_tol_deg}",
+                azi1_r = azi1_r, azi2 = azi2, azi_tol_deg = azi_tol_deg
+            );
+            }
+        }
+
+        /// The WGS84 ellipsoid is symmetric under reflection across the
+        /// equator and across any meridian, so both reflections are isometries:
+        /// they must preserve the geodesic distance.
+        #[hegel::test]
+        fn test_hegel_inverse_mirror_isometries(tc: hegel::TestCase) {
+            let g = Geodesic::wgs84();
+            let lat1 = tc.draw(latitudes());
+            let lon1 = tc.draw(longitudes());
+            let lat2 = tc.draw(latitudes());
+            let lon2 = tc.draw(longitudes());
+
+            let s12: f64 = g.inverse(lat1, lon1, lat2, lon2);
+            let s12_lat_mirror: f64 = g.inverse(-lat1, lon1, -lat2, lon2);
+            let s12_lon_mirror: f64 = g.inverse(lat1, -lon1, lat2, -lon2);
+
+            assert!(
+                (s12 - s12_lat_mirror).abs() <= POS_TOL_M,
+                "equator reflection changed distance: {s12} vs {s12_lat_mirror}",
+                s12 = s12, s12_lat_mirror = s12_lat_mirror
+            );
+            assert!(
+                (s12 - s12_lon_mirror).abs() <= POS_TOL_M,
+                "meridian reflection changed distance: {s12} vs {s12_lon_mirror}",
+                s12 = s12, s12_lon_mirror = s12_lon_mirror
+            );
+        }
+
+        /// The distance from a point to itself is zero.
+        #[hegel::test]
+        fn test_hegel_coincident_points_zero_distance(tc: hegel::TestCase) {
+            let g = Geodesic::wgs84();
+            let lat = tc.draw(latitudes());
+            let lon = tc.draw(wide_longitudes());
+
+            let s12: f64 = g.inverse(lat, lon, lat, lon);
+            assert!(
+                s12.abs() <= 1e-9,
+                "distance from ({lat}, {lon}) to itself is {s12}, not 0",
+                lat = lat, lon = lon, s12 = s12
+            );
+        }
+
+        /// Documented output contract of inverse(): s12 is a shortest-path
+        /// distance, so 0 <= s12 <= the antipodal distance; azimuths are
+        /// normalized to [-180, 180]; the arc length a12 is in [0, 180].
+        /// Input longitudes may be any finite value.
+        #[hegel::test]
+        fn test_hegel_inverse_output_ranges(tc: hegel::TestCase) {
+            let g = Geodesic::wgs84();
+            let lat1 = tc.draw(latitudes());
+            let lon1 = tc.draw(wide_longitudes());
+            let lat2 = tc.draw(latitudes());
+            let lon2 = tc.draw(wide_longitudes());
+
+            let (s12, azi1, azi2, a12): (f64, f64, f64, f64) =
+                g.inverse(lat1, lon1, lat2, lon2);
+
+            assert!(
+                s12 >= 0.0 && s12 <= MAX_SHORTEST_M,
+                "s12 out of range: {s12}",
+                s12 = s12
+            );
+            assert!(
+                azi1 >= -180.0 && azi1 <= 180.0,
+                "azi1 not normalized: {azi1}",
+                azi1 = azi1
+            );
+            assert!(
+                azi2 >= -180.0 && azi2 <= 180.0,
+                "azi2 not normalized: {azi2}",
+                azi2 = azi2
+            );
+            assert!(
+                a12 >= 0.0 && a12 <= 180.0 + 1e-9,
+                "a12 out of range: {a12}",
+                a12 = a12
+            );
+        }
+
+        /// Documented output contract of direct(): lat2 in [-90, 90], lon2 in
+        /// [-180, 180], azi2 in [-180, 180], for any finite s12 (including
+        /// negative distances and distances wrapping the ellipsoid many times).
+        #[hegel::test]
+        fn test_hegel_direct_output_ranges(tc: hegel::TestCase) {
+            let g = Geodesic::wgs84();
+            let lat1 = tc.draw(latitudes());
+            let lon1 = tc.draw(wide_longitudes());
+            let azi1 = tc.draw(azimuths());
+            let s12 = tc.draw(
+                generators::floats::<f64>()
+                    .min_value(-1e12)
+                    .max_value(1e12),
+            );
+
+            let (lat2, lon2, azi2) = g.direct(lat1, lon1, azi1, s12);
+
+            assert!(
+                lat2 >= -90.0 && lat2 <= 90.0,
+                "lat2 out of range: {lat2} (s12={s12})",
+                lat2 = lat2, s12 = s12
+            );
+            assert!(
+                lon2 >= -180.0 && lon2 <= 180.0,
+                "lon2 not normalized: {lon2} (s12={s12})",
+                lon2 = lon2, s12 = s12
+            );
+            assert!(
+                azi2 >= -180.0 && azi2 <= 180.0,
+                "azi2 not normalized: {azi2} (s12={s12})",
+                azi2 = azi2, s12 = s12
+            );
+        }
+
+        /// Closed-form oracle: the geodesic between two points on the equator
+        /// (with longitude difference below the equatorial cut at
+        /// ~179.397 deg) runs along the equator, so its length is exactly
+        /// a * |dlon in radians|.
+        #[hegel::test]
+        fn test_hegel_equatorial_distance_oracle(tc: hegel::TestCase) {
+            let g = Geodesic::wgs84();
+            let lon1 = tc.draw(longitudes());
+            let lon2 = tc.draw(longitudes());
+            let dlon = ang_gap_deg(lon1, lon2);
+            // Beyond ~179.397 deg the equatorial path stops being shortest.
+            tc.assume(dlon <= 179.0);
+
+            let s12: f64 = g.inverse(0.0, lon1, 0.0, lon2);
+            let expected = g.equatorial_radius() * dlon.to_radians();
+
+            // POS_TOL_M plus a relative term for the rounding of the oracle
+            // itself (expected can be ~2e7 m).
+            let tol = POS_TOL_M + 1e-14 * expected;
+            assert!(
+                (s12 - expected).abs() <= tol,
+                "equatorial distance: s12={s12}, expected={expected}, diff={}",
+                (s12 - expected).abs()
+            );
+        }
+
+        /// The documented hard case for the inverse solve: nearly antipodal
+        /// points. The solution must stay within global bounds and be
+        /// self-consistent: shooting from point 1 with the returned azimuth
+        /// and distance must land on point 2.
+        #[hegel::test]
+        fn test_hegel_near_antipodal_inverse_consistency(tc: hegel::TestCase) {
+            let g = Geodesic::wgs84();
+            let lat1 = tc.draw(latitudes());
+            let lon1 = tc.draw(longitudes());
+            // Offsets from the exact antipode: zero, tiny, and up to ~100 m.
+            let dlat = tc.draw(hegel::one_of!(
+                generators::just(0.0),
+                generators::floats::<f64>().min_value(-1e-3).max_value(1e-3),
+                generators::floats::<f64>().min_value(-1e-9).max_value(1e-9),
+            ));
+            let dlon = tc.draw(hegel::one_of!(
+                generators::just(0.0),
+                generators::floats::<f64>().min_value(-1e-3).max_value(1e-3),
+                generators::floats::<f64>().min_value(-1e-9).max_value(1e-9),
+            ));
+            let lat2 = (-lat1 + dlat).clamp(-90.0, 90.0);
+            let lon2 = lon1 + 180.0 + dlon; // inverse() reduces longitudes itself
+
+            let (s12, azi1, azi2, _a12): (f64, f64, f64, f64) =
+                g.inverse(lat1, lon1, lat2, lon2);
+
+            // All antipodal distances on WGS84 are ~20_003_931.46 m (half the
+            // meridian); our target is within ~250 m of the exact antipode.
+            assert!(
+                s12 >= 20_003_400.0 && s12 <= MAX_SHORTEST_M,
+                "near-antipodal distance out of range: {s12}",
+                s12 = s12
+            );
+            assert!(
+                azi1.is_finite() && azi2.is_finite(),
+                "non-finite azimuths: azi1={azi1}, azi2={azi2}",
+                azi1 = azi1, azi2 = azi2
+            );
+
+            let (lat2_d, lon2_d) = g.direct(lat1, lon1, azi1, s12);
+            let gap = gap_m(&g, lat2, lon2, lat2_d, lon2_d);
+            assert!(
+                gap <= POS_TOL_M,
+                "near-antipodal solution inconsistent: gap={gap} m \
+                 (p1=({lat1}, {lon1}), p2=({lat2}, {lon2}), s12={s12}, azi1={azi1})",
+                azi1 = azi1, gap = gap, lat1 = lat1, lat2 = lat2, lon1 = lon1, lon2 = lon2, s12 = s12
+            );
+        }
+
+        /// Direct is a flow along a geodesic line: walking s_a then continuing
+        /// (with the forward azimuth) for s_b lands at the same point as
+        /// walking s_a + s_b in one step.
+        #[hegel::test]
+        fn test_hegel_direct_additivity(tc: hegel::TestCase) {
+            let g = Geodesic::wgs84();
+            let lat1 = tc.draw(latitudes());
+            let lon1 = tc.draw(longitudes());
+            let azi1 = tc.draw(azimuths());
+            let s_a = tc.draw(
+                generators::floats::<f64>()
+                    .min_value(-2e7)
+                    .max_value(2e7),
+            );
+            let s_b = tc.draw(
+                generators::floats::<f64>()
+                    .min_value(-2e7)
+                    .max_value(2e7),
+            );
+
+            let (lat2, lon2, azi2) = g.direct(lat1, lon1, azi1, s_a);
+            let (lat3, lon3) = g.direct(lat2, lon2, azi2, s_b);
+            let (lat3_one, lon3_one) = g.direct(lat1, lon1, azi1, s_a + s_b);
+
+            // 2 * POS_TOL_M: three direct evaluations plus the f64
+            // quantization of the intermediate (lat2, lon2, azi2), whose
+            // azimuth error is amplified by up to |m12| ~ 6.4e6 m.
+            let gap = gap_m(&g, lat3, lon3, lat3_one, lon3_one);
+            assert!(
+                gap <= 2.0 * POS_TOL_M,
+                "additivity violated: gap={gap} m (s_a={s_a}, s_b={s_b}, azi1={azi1})",
+                azi1 = azi1, gap = gap, s_a = s_a, s_b = s_b
+            );
+        }
+    }
 }
diff --git a/src/polygon_area.rs b/src/polygon_area.rs
index c6452ec..ca1d411 100644
--- a/src/polygon_area.rs
+++ b/src/polygon_area.rs
@@ -643,4 +643,76 @@ mod tests {
         let (_, area, _) = pa.compute(true);
         assert_relative_eq!(area, 1000000.0, epsilon = 0.01);
     }
+
+    /// Property-based tests (hegel).
+    mod hegel_props {
+        use super::*;
+        use hegel::generators;
+
+        /// Reversing the vertex order of a polygon negates its signed area
+        /// (computed with sign=true) and preserves its perimeter.
+        #[hegel::test]
+        fn test_hegel_polygon_reversal_negates_signed_area(tc: hegel::TestCase) {
+            let g = Geodesic::wgs84();
+            let n = tc.draw(generators::integers::<usize>().min_value(3).max_value(10));
+            let mut vertices: Vec<(f64, f64)> = Vec::with_capacity(n);
+            for _ in 0..n {
+                let lat = tc.draw(
+                    generators::floats::<f64>()
+                        .min_value(-90.0)
+                        .max_value(90.0),
+                );
+                let lon = tc.draw(
+                    generators::floats::<f64>()
+                        .min_value(-180.0)
+                        .max_value(180.0),
+                );
+                vertices.push((lat, lon));
+            }
+
+            let mut pa = PolygonArea::new(&g, Winding::CounterClockwise);
+            for &(lat, lon) in &vertices {
+                pa.add_point(lat, lon);
+            }
+            let (perimeter, area, count) = pa.compute(true);
+
+            let mut pa_rev = PolygonArea::new(&g, Winding::CounterClockwise);
+            for &(lat, lon) in vertices.iter().rev() {
+                pa_rev.add_point(lat, lon);
+            }
+            let (perimeter_rev, area_rev, count_rev) = pa_rev.compute(true);
+
+            assert_eq!(count, count_rev);
+            // Perimeter: same edges in reverse order; per-edge distances are
+            // symmetric and the sum is compensated ("accurate" feature), so a
+            // micrometer-level absolute tolerance suffices.
+            assert!(
+                (perimeter - perimeter_rev).abs() <= 1e-6,
+                "perimeter changed under reversal: {perimeter} vs {perimeter_rev}",
+                perimeter = perimeter, perimeter_rev = perimeter_rev
+            );
+            // Signed area: per-edge S12 terms are antisymmetric, so reversal
+            // negates the area -- but only modulo the total ellipsoid area,
+            // because compute(true) canonicalizes results into (-A/2, A/2].
+            // A degenerate polygon tracing the full equator has signed area
+            // exactly A/2 in *both* directions (-A/2 is mapped to +A/2),
+            // which a plain `area_rev == -area` check misreads as a failure
+            // (found by a 10x hegel run). Tolerance: 0.01 m^2 absolute
+            // (matches the tightest existing planimeter test in this file)
+            // plus a relative term, because forward/reverse S12 edge terms
+            // can differ by a few ULP for near-antipodal edges and one ULP
+            // of an area ~1e14 m^2 is ~0.016 m^2 (also found by a 10x run;
+            // 1e-14 relative is a handful of ULPs of f64).
+            let total_area = g.area();
+            let residual = (area + area_rev).rem_euclid(total_area);
+            let modular_gap = residual.min(total_area - residual);
+            let tol = 0.01 + 1e-14 * area.abs().max(area_rev.abs());
+            assert!(
+                modular_gap <= tol,
+                "signed area not negated (mod ellipsoid area) under reversal: \
+                 {area} vs {area_rev}, modular gap {modular_gap}",
+                area = area, area_rev = area_rev, modular_gap = modular_gap
+            );
+        }
+    }
 }
