+/// printf-compat/11: a negative `*` precision is taken as if the precision were omitted, as
+/// in C, instead of panicking.
+#[hegel::test]
+fn negative_star_precision_means_omitted(tc: TestCase) {
+    let arg = hegel::one_of!(d_int(), f_double(), s_ascii(8));
+    let (magnitude, (conv, arg)) = tc.draw(hegel::tuples!(ints(1, 30), arg));
+    let spec = Spec { precision: Size::Star(-(magnitude as c_int)), conv, ..Spec::default() };
+    check(&spec.render(), &spec.stars(), &arg);
+}
+
+/// printf-compat/12: `%c` of a byte above 127 writes that one byte through `io_write` (which
+/// documents non-UTF-8 support), as C does, not two bytes of UTF-8.
+#[hegel::test]
+fn char_conversion_writes_one_byte(tc: TestCase) {
+    let (byte, left, width) = tc.draw(hegel::tuples!(ints(0x80, 0xff), chance(0.4), size(0, 6)));
+    let spec = Spec { flags: Flags { left, ..Flags::default() }, width, conv: 'c', ..Spec::default() };
+    let (c, r) = run(&spec.render(), &spec.stars(), &CArg::I(byte as c_int));
+    let expected = c.unwrap();
+    assert!(r.io.as_ref() == Ok(&expected), "%c of {byte:#x}: io_write {} but glibc {:?}", text(&r.io), expected);
+}
