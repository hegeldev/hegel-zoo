+//! Hegel properties for printf-compat: glibc's `snprintf` is the oracle.
+//!
+//! The crate is driven exactly as its own `tests/tests.rs` drives it — a variadic Rust function
+//! hands the `VaList` to `printf_compat::format`, once through `output::fmt_write` and once
+//! through `output::io_write` — and glibc's `snprintf` receives the very same arguments.  The
+//! two writers must agree with each other (the upstream tests assert that), the returned byte
+//! count must be the output's length, and the output must be glibc's, except for the deviations
+//! `output::fmt_write` documents: precision on integers (issue #50), `%g`/`%a` aliased to `%f`,
+//! `0x` before uppercase hex and `0o` before octal, UTF-8 only.  Everything else that differs is
+//! a bug (bugs.toml); the general generators avoid the pinned shapes and each pinned property
+//! names its bug.
+//!
+//! The generators are values: a property draws one `Case` — a `Spec` (the `Flags`, a `Size` for
+//! the width and one for the precision, each absent, a literal or `*` with the `int` it reads,
+//! the length modifier and the conversion) and its `CArg` — built from `tuples!`, `one_of!`,
+//! `sampled_from`, `vecs` and a `weighted` choice (one integer `flat_map`ped to the alternative
+//! it selects), and renders it with pure functions (`Spec::render`, `Spec::stars`, `compose`).
+//! The absent or plainest alternative comes first in every choice, so a shrunk case is the bare
+//! conversion.  A pinned shape is kept out of a general property by a `filter` on its case
+//! generator (a few percent of the cases) and steered into the pin's own generator.
+#![allow(improper_ctypes_definitions)]
+
+use core::ffi::{c_char, c_int};
+use hegel::generators::{self, BoxedPrintableGenerator, Generator as _};
+use hegel::{PrintableGenerator, TestCase};
+use std::ffi::CString;
+use std::fmt;
+use std::io;
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+// --------------------------------------------------------------------------- driving the crate
+
+/// Output longer than this is refused by the writers (a runaway padding loop becomes an error
+/// instead of an out-of-memory).
+const LIMIT: usize = 1 << 17;
+
+struct Bounded(String);
+impl fmt::Write for Bounded {
+    fn write_str(&mut self, s: &str) -> fmt::Result {
+        if self.0.len() + s.len() > LIMIT {
+            return Err(fmt::Error);
+        }
+        self.0.push_str(s);
+        Ok(())
+    }
+}
+
+struct BoundedIo(Vec<u8>);
+impl io::Write for BoundedIo {
+    fn write(&mut self, b: &[u8]) -> io::Result<usize> {
+        if self.0.len() + b.len() > LIMIT {
+            return Err(io::Error::other("bound"));
+        }
+        self.0.extend_from_slice(b);
+        Ok(b.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+/// What one call to the crate produced: the bytes, or why not.
+type Produced = Result<Vec<u8>, String>;
+
+#[derive(Debug)]
+struct Out {
+    fmt: Produced,
+    io: Produced,
+}
+
+fn judge(r: std::thread::Result<c_int>, bytes: Vec<u8>) -> Produced {
+    match r {
+        Ok(k) if k >= 0 && k as usize == bytes.len() => Ok(bytes),
+        Ok(k) if k >= 0 => Err(format!("returned {k} for {} bytes of output", bytes.len())),
+        Ok(k) => Err(format!("returned {k}")),
+        Err(_) => Err("panicked".into()),
+    }
+}
+
+/// The crate, through both writers.
+unsafe extern "C" fn crate_fmt(fmt: *const c_char, args: ...) -> Box<Out> {
+    let mut s = Bounded(String::new());
+    let a1 = args.clone();
+    let r1 = catch_unwind(AssertUnwindSafe(|| unsafe {
+        printf_compat::format(fmt, a1, printf_compat::output::fmt_write(&mut s))
+    }));
+    let mut v = BoundedIo(Vec::new());
+    let r2 = catch_unwind(AssertUnwindSafe(|| unsafe {
+        printf_compat::format(fmt, args, printf_compat::output::io_write(&mut v))
+    }));
+    Box::new(Out { fmt: judge(r1, s.0.into_bytes()), io: judge(r2, v.0) })
+}
+
+/// glibc and the crate, given the same variadic arguments.
+macro_rules! both {
+    ($fmt:expr $(, $a:expr)*) => {{
+        let cfmt = CString::new($fmt).unwrap();
+        let mut buf = vec![0u8; 2 * LIMIT];
+        let k = unsafe { libc::snprintf(buf.as_mut_ptr() as *mut c_char, buf.len(), cfmt.as_ptr() $(, $a)*) };
+        let c: Produced = if k >= 0 && (k as usize) < buf.len() {
+            buf.truncate(k as usize);
+            Ok(buf)
+        } else {
+            Err(format!("returned {k}"))
+        };
+        let r = unsafe { *crate_fmt(cfmt.as_ptr() $(, $a)*) };
+        (c, r)
+    }};
+}
+
+/// An argument as C sees it.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum CArg {
+    /// `int` (also what `hh` and `h` conversions read, and `%c`)
+    I(c_int),
+    /// `long` / `long long` / `ptrdiff_t`
+    L(i64),
+    /// `unsigned long` / `unsigned long long` / `size_t`
+    UL(u64),
+    /// `double`
+    F(f64),
+    /// `char *`
+    S(String),
+    /// a pointer value (`%s` of null prints `(null)`; `%p`)
+    P(usize),
+}
+
+/// Run one conversion with up to two `*` arguments before the value.
+fn run(fmt: &str, stars: &[c_int], arg: &CArg) -> (Produced, Out) {
+    let s;
+    let ptr = |a: &CArg| -> *const c_char {
+        match a {
+            CArg::P(p) => *p as *const c_char,
+            _ => unreachable!(),
+        }
+    };
+    match (stars, arg) {
+        ([], CArg::I(v)) => both!(fmt, *v),
+        ([], CArg::L(v)) => both!(fmt, *v),
+        ([], CArg::UL(v)) => both!(fmt, *v),
+        ([], CArg::F(v)) => both!(fmt, *v),
+        ([], CArg::S(v)) => {
+            s = CString::new(v.as_str()).unwrap();
+            both!(fmt, s.as_ptr())
+        }
+        ([], CArg::P(_)) => both!(fmt, ptr(arg)),
+        ([a], CArg::I(v)) => both!(fmt, *a, *v),
+        ([a], CArg::L(v)) => both!(fmt, *a, *v),
+        ([a], CArg::UL(v)) => both!(fmt, *a, *v),
+        ([a], CArg::F(v)) => both!(fmt, *a, *v),
+        ([a], CArg::S(v)) => {
+            s = CString::new(v.as_str()).unwrap();
+            both!(fmt, *a, s.as_ptr())
+        }
+        ([a], CArg::P(_)) => both!(fmt, *a, ptr(arg)),
+        ([a, b], CArg::I(v)) => both!(fmt, *a, *b, *v),
+        ([a, b], CArg::L(v)) => both!(fmt, *a, *b, *v),
+        ([a, b], CArg::UL(v)) => both!(fmt, *a, *b, *v),
+        ([a, b], CArg::F(v)) => both!(fmt, *a, *b, *v),
+        ([a, b], CArg::S(v)) => {
+            s = CString::new(v.as_str()).unwrap();
+            both!(fmt, *a, *b, s.as_ptr())
+        }
+        ([a, b], CArg::P(_)) => both!(fmt, *a, *b, ptr(arg)),
+        _ => unreachable!(),
+    }
+}
+
+/// Run a format string whose conversions all take `int` arguments.
+fn run_ints(fmt: &str, args: &[c_int]) -> (Produced, Out) {
+    match args {
+        [] => both!(fmt),
+        [a] => both!(fmt, *a),
+        [a, b] => both!(fmt, *a, *b),
+        [a, b, c] => both!(fmt, *a, *b, *c),
+        [a, b, c, d] => both!(fmt, *a, *b, *c, *d),
+        [a, b, c, d, e] => both!(fmt, *a, *b, *c, *d, *e),
+        _ => unreachable!(),
+    }
+}
+
+fn text(p: &Produced) -> String {
+    match p {
+        Ok(b) => format!("{:?}", String::from_utf8_lossy(b)),
+        Err(e) => e.clone(),
+    }
+}
+
+/// Both writers produce glibc's bytes and report their length.
+fn same_as_libc(what: &str, (c, r): (Produced, Out)) {
+    let expected = c.unwrap_or_else(|e| panic!("snprintf {what}: {e}"));
+    assert!(
+        r.fmt.as_ref() == Ok(&expected),
+        "{what}: fmt_write {} but glibc {}",
+        text(&r.fmt),
+        text(&Ok(expected.clone()))
+    );
+    assert!(
+        r.io.as_ref() == Ok(&expected),
+        "{what}: io_write {} but glibc {}",
+        text(&r.io),
+        text(&Ok(expected))
+    );
+}
+
+fn check(fmt: &str, stars: &[c_int], arg: &CArg) {
+    same_as_libc(&format!("{fmt:?} {stars:?} {arg:?}"), run(fmt, stars, arg));
+}
+
+fn check_case(case: &Case) {
+    check(&case.spec.render(), &case.spec.stars(), &case.arg);
+}
+
+// --------------------------------------------------------------------------- the case
+
+/// A width or a precision: absent, a literal, or `*` with the `int` it reads.
+#[derive(Clone, Copy, Debug, Default, PartialEq, hegel::PrettyPrintable)]
+enum Size {
+    #[default]
+    Absent,
+    Literal(i32),
+    Star(c_int),
+}
+
+impl Size {
+    /// The value that will apply.
+    fn value(self) -> Option<i32> {
+        match self {
+            Size::Absent => None,
+            Size::Literal(v) | Size::Star(v) => Some(v),
+        }
+    }
+
+    /// The `*` argument, if this is one.
+    fn star(self) -> Option<c_int> {
+        match self {
+            Size::Star(v) => Some(v),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default, hegel::PrettyPrintable)]
+struct Flags {
+    left: bool,
+    plus: bool,
+    space: bool,
+    zero: bool,
+    alt: bool,
+}
+
+/// One conversion specification.
+#[derive(Clone, Debug, Default, hegel::PrettyPrintable)]
+struct Spec {
+    flags: Flags,
+    width: Size,
+    precision: Size,
+    length: &'static str,
+    conv: char,
+}
+
+impl Spec {
+    fn render(&self) -> String {
+        let mut s = String::from("%");
+        if self.flags.left {
+            s.push('-');
+        }
+        if self.flags.plus {
+            s.push('+');
+        }
+        if self.flags.space {
+            s.push(' ');
+        }
+        if self.flags.zero {
+            s.push('0');
+        }
+        if self.flags.alt {
+            s.push('#');
+        }
+        match self.width {
+            Size::Literal(w) => s.push_str(&w.to_string()),
+            Size::Star(_) => s.push('*'),
+            Size::Absent => {}
+        }
+        match self.precision {
+            Size::Literal(p) => s.push_str(&format!(".{p}")),
+            Size::Star(_) => s.push_str(".*"),
+            Size::Absent => {}
+        }
+        s.push_str(self.length);
+        s.push(self.conv);
+        s
+    }
+
+    /// The `*` values, width first.
+    fn stars(&self) -> Vec<c_int> {
+        [self.width, self.precision].into_iter().filter_map(Size::star).collect()
+    }
+
+    /// The width that will apply (0 when none).
+    fn effective_width(&self) -> i32 {
+        self.width.value().unwrap_or(0)
+    }
+
+    /// The pinned shape of printf-compat/2: `-` with the space flag and no width.
+    fn is_left_space_without_width(&self) -> bool {
+        self.flags.left && self.flags.space && self.effective_width() == 0
+    }
+}
+
+/// A conversion and the argument it formats.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Case {
+    spec: Spec,
+    arg: CArg,
+}
+
+// --------------------------------------------------------------------------- generators
+
+fn ints(lo: i64, hi: i64) -> generators::IntegerGenerator<i64> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// True `p` of the time; shrinks to false.
+fn chance(p: f64) -> generators::BoolGenerator {
+    generators::weighted_booleans(p)
+}
+
+/// A weight and an alternative for [`weighted`].
+fn w<T>(weight: u32, g: impl PrintableGenerator<T> + Send + Sync + 'static) -> (u32, BoxedPrintableGenerator<'static, T>) {
+    (weight, g.boxed_printable())
+}
+
+/// One of the alternatives, each as often as its weight says: one integer draw `flat_map`ped to
+/// the alternative whose cumulative weight it falls under, so only the chosen one is drawn and
+/// the choice shrinks to the first alternative.  (Hegel has no weighted `one_of!`.)
+fn weighted<T: 'static>(choices: Vec<(u32, BoxedPrintableGenerator<'static, T>)>) -> impl PrintableGenerator<T> {
+    let total: u32 = choices.iter().map(|(weight, _)| weight).sum();
+    ints(0, i64::from(total) - 1).flat_map(move |x| {
+        let mut x = x as u32;
+        for (weight, g) in &choices {
+            if x < *weight {
+                return g.clone();
+            }
+            x -= weight;
+        }
+        unreachable!()
+    })
+}
+
+/// Absent, a literal of `lo..=hi`, or `*` reading `lo..=hi`; absent first, so shrinking drops it.
+fn size(lo: i64, hi: i64) -> impl PrintableGenerator<Size> {
+    hegel::one_of!(
+        generators::just(Size::Absent),
+        ints(lo, hi).map(|v| Size::Literal(v as i32)),
+        ints(lo, hi).map(|v| Size::Star(v as c_int)),
+    )
+}
+
+/// `-`, `+`, space and `0`, each three times in ten; `#` is each property's own choice.
+fn flags() -> impl PrintableGenerator<Flags> {
+    hegel::tuples!(chance(0.3), chance(0.3), chance(0.3), chance(0.3))
+        .map(|(left, plus, space, zero)| Flags { left, plus, space, zero, alt: false })
+}
+
+/// A specification from independent parts.
+fn spec(
+    conv: impl PrintableGenerator<char>,
+    length: impl PrintableGenerator<&'static str>,
+    flags: impl PrintableGenerator<Flags>,
+    width: impl PrintableGenerator<Size>,
+    precision: impl PrintableGenerator<Size>,
+) -> impl PrintableGenerator<Spec> {
+    hegel::tuples!(conv, length, flags, width, precision)
+        .map(|(conv, length, flags, width, precision)| Spec { flags, width, precision, length, conv })
+}
+
+/// A specification and an argument drawn independently.
+fn case(spec: impl PrintableGenerator<Spec>, arg: impl PrintableGenerator<CArg>) -> impl PrintableGenerator<Case> {
+    hegel::tuples!(spec, arg).map(|(spec, arg)| Case { spec, arg })
+}
+
+const EDGE_INTS: &[c_int] = &[0, 1, -1, 127, 128, 255, 256, 32767, 65535, 65536, c_int::MAX, c_int::MIN];
+const EDGE_I64S: &[i64] = &[0, 1, -1, i32::MAX as i64, i32::MIN as i64, i64::MAX, i64::MIN];
+const EDGE_U64S: &[u64] = &[0, 1, u32::MAX as u64, i64::MAX as u64, u64::MAX];
+
+/// A small `int`, an edge value, or any `int` (half the time).
+fn c_ints() -> impl PrintableGenerator<c_int> {
+    let any = || ints(c_int::MIN as i64, c_int::MAX as i64).map(|v| v as c_int);
+    hegel::one_of!(ints(-300, 300).map(|v| v as c_int), generators::sampled_from(EDGE_INTS), any(), any())
+}
+
+/// A small `long`, an edge value, or any `long` (half the time).
+fn i64s() -> impl PrintableGenerator<i64> {
+    let any = || ints(i64::MIN, i64::MAX);
+    hegel::one_of!(ints(-300, 300), generators::sampled_from(EDGE_I64S), any(), any())
+}
+
+/// A small `unsigned long`, an edge value, or any `unsigned long` (half the time).
+fn u64s() -> impl PrintableGenerator<u64> {
+    let any = || generators::integers::<u64>().min_value(0).max_value(u64::MAX);
+    hegel::one_of!(ints(0, 300).map(|v| v as u64), generators::sampled_from(EDGE_U64S), any(), any())
+}
+
+const ZEROS: &[f64] = &[0.0, -0.0];
+const EXTREMES: &[f64] = &[1e300, -1e300, 5e-324, f64::MAX, f64::MIN_POSITIVE, 1e-300];
+
+/// A finite double: a zero, one of a few extremes, or (eight times in ten) sign × m × 10^e with
+/// m up to 999 999 and e in -25..=25, negative two times in five.
+fn finite() -> impl PrintableGenerator<f64> {
+    let decimal = hegel::tuples!(ints(0, 999_999), ints(-25, 25), chance(0.4)).map(|(m, e, negative)| {
+        let v = m as f64 * 10f64.powi(e as i32);
+        if negative { -v } else { v }
+    });
+    weighted(vec![
+        w(1, generators::sampled_from(ZEROS)),
+        w(1, generators::sampled_from(EXTREMES)),
+        w(8, decimal),
+    ])
+}
+
+/// The printable ASCII characters, 0x20..=0x7e.
+const PRINTABLE: &str = r##" !"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~"##;
+/// The printable ASCII characters without `%`: verbatim text of a format string.
+const VERBATIM: &str = r##" !"#$&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_`abcdefghijklmnopqrstuvwxyz{|}~"##;
+
+/// Up to `max_len` printable ASCII characters.
+fn ascii(max_len: usize) -> generators::TextGenerator {
+    generators::text().alphabet(PRINTABLE).max_size(max_len)
+}
+
+/// `%d` of an `int`.
+fn d_int() -> impl PrintableGenerator<(char, CArg)> {
+    c_ints().map(|v| ('d', CArg::I(v)))
+}
+
+/// `%f` of a finite double.
+fn f_double() -> impl PrintableGenerator<(char, CArg)> {
+    finite().map(|v| ('f', CArg::F(v)))
+}
+
+/// `%s` of up to `max_len` ASCII characters.
+fn s_ascii(max_len: usize) -> impl PrintableGenerator<(char, CArg)> {
+    ascii(max_len).map(|s| ('s', CArg::S(s)))
+}
+
+/// `%c` of a non-NUL ASCII character.
+fn c_ascii() -> impl PrintableGenerator<(char, CArg)> {
+    ints(1, 127).map(|c| ('c', CArg::I(c as c_int)))
+}
+
+const INT_CONVS: &[char] = &['d', 'i', 'u', 'x', 'X', 'o'];
+const FLOAT_CONVS: &[char] = &['f', 'F'];
+const EXP_CONVS: &[char] = &['e', 'E'];
+const REAL_CONVS: &[char] = &['f', 'F', 'e', 'E'];
+/// The length modifiers, none of them twice as often as any other.
+const LENGTHS: &[&str] = &["", "", "hh", "h", "l", "ll", "z", "t"];
+const LONG_LENGTHS: &[&str] = &["l", "ll", "z"];
+
+/// The argument an integer conversion with `length` reads: an `int` for none, `hh` and `h`, a
+/// `long` for the signed conversions with the others, an `unsigned long` for the unsigned ones.
+fn int_arg(length: &'static str, signed: bool) -> BoxedPrintableGenerator<'static, CArg> {
+    match length {
+        "" | "hh" | "h" => c_ints().map(CArg::I).boxed_printable(),
+        _ if signed => i64s().map(CArg::L).boxed_printable(),
+        _ => u64s().map(CArg::UL).boxed_printable(),
+    }
+}
+
+/// Whether the integer argument, as the conversion's length truncates it, is zero.
+fn truncates_to_zero(arg: &CArg, length: &str) -> bool {
+    match (arg, length) {
+        (CArg::I(v), "hh") => *v as i8 == 0,
+        (CArg::I(v), "h") => *v as i16 == 0,
+        (CArg::I(v), _) => *v == 0,
+        (CArg::L(v), _) => *v == 0,
+        (CArg::UL(v), _) => *v == 0,
+        _ => false,
+    }
+}
+
+/// `d i u x X o` with a length modifier, the flags and a width; `#` three times in ten with `x`.
+fn int_case() -> impl PrintableGenerator<Case> {
+    hegel::tuples!(generators::sampled_from(INT_CONVS), generators::sampled_from(LENGTHS)).flat_map(|(conv, length)| {
+        let signed = matches!(conv, 'd' | 'i');
+        let alt = if conv == 'x' { chance(0.3).boxed_printable() } else { generators::just(false).boxed_printable() };
+        hegel::tuples!(flags(), alt, size(0, 30), int_arg(length, signed)).map(move |(flags, alt, width, arg)| Case {
+            spec: Spec { flags: Flags { alt, ..flags }, width, precision: Size::Absent, length, conv },
+            arg,
+        })
+    })
+}
+
+/// `%s` of an ASCII string with a precision, `%s` of null (`(null)`; only precisions of 6 and
+/// more: glibc prints nothing below 6 where musl and the crate truncate `(null)`, which is
+/// implementation-defined and not compared), `%c` of ASCII and `%p` of a non-null pointer.
+fn text_case() -> impl PrintableGenerator<Case> {
+    let string = hegel::tuples!(size(0, 15), ascii(12)).map(|(precision, s)| ('s', precision, CArg::S(s)));
+    let null = size(6, 15).map(|precision| ('s', precision, CArg::P(0)));
+    let character = ints(1, 127).map(|c| ('c', Size::Absent, CArg::I(c as c_int)));
+    let pointer = ints(1, i64::MAX).map(|p| ('p', Size::Absent, CArg::P(p as usize)));
+    let what = weighted(vec![w(43, string), w(7, null), w(25, character), w(25, pointer)]);
+    hegel::tuples!(chance(0.4), size(0, 20), what).map(|(left, width, (conv, precision, arg))| Case {
+        spec: Spec { flags: Flags { left, ..Flags::default() }, width, precision, length: "", conv },
+        arg,
+    })
+}
+
+/// A piece of a composed format string.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Piece {
+    /// `%%`
+    Percent,
+    /// verbatim text
+    Text(String),
+    /// an `int` conversion and its value
+    Conv(Spec, c_int),
+}
+
+/// An `int` conversion of a composed format: `d i u x X o` with the flags and a width (`-` with
+/// the space flag and no width, printf-compat/2, drops the space), or one time in seven `%c` of
+/// ASCII with `-` two times in five.
+fn conv_piece() -> impl PrintableGenerator<Piece> {
+    let number = hegel::tuples!(
+        spec(generators::sampled_from(INT_CONVS), generators::just(""), flags(), size(0, 12), generators::just(Size::Absent)),
+        c_ints()
+    )
+    .map(|(mut spec, v)| {
+        if spec.is_left_space_without_width() {
+            spec.flags.space = false;
+        }
+        Piece::Conv(spec, v)
+    });
+    let character = hegel::tuples!(chance(0.4), size(0, 12), ints(1, 127)).map(|(left, width, c)| {
+        Piece::Conv(Spec { flags: Flags { left, ..Flags::default() }, width, conv: 'c', ..Spec::default() }, c as c_int)
+    });
+    weighted(vec![w(6, number), w(1, character)])
+}
+
+/// `%%`, verbatim text, or (half the time) a conversion.
+fn piece() -> impl PrintableGenerator<Piece> {
+    weighted(vec![
+        w(1, generators::just(Piece::Percent)),
+        w(1, generators::text().alphabet(VERBATIM).max_size(6).map(Piece::Text)),
+        w(2, conv_piece()),
+    ])
+}
+
+/// The format string and `int` arguments of the pieces.  `run_ints` passes up to five
+/// arguments and a conversion takes one or two, so a conversion that arrives with four arguments
+/// already taken is left out (the step that does not fit is a no-op, so shrinking can still
+/// delete any piece).
+fn compose(pieces: &[Piece]) -> (String, Vec<c_int>) {
+    let mut fmt = String::new();
+    let mut args = Vec::new();
+    for piece in pieces {
+        match piece {
+            Piece::Percent => fmt.push_str("%%"),
+            Piece::Text(s) => fmt.push_str(s),
+            Piece::Conv(spec, v) => {
+                if args.len() >= 4 {
+                    continue;
+                }
+                fmt.push_str(&spec.render());
+                args.extend(spec.stars());
+                args.push(*v);
+            }
+        }
+    }
+    (fmt, args)
+}
+
+// --------------------------------------------------------------------------- general properties
+
+/// `d i u x X o` with every length modifier, every flag and any width print as glibc prints
+/// them.  Precision is left out (documented: ignored for integers, issue #50); `#` only goes
+/// with `x` of a value that is not zero once truncated to the length (`0X`/`0` prefixes are
+/// documented deviations, zero is pinned in `alternate_form_of_zero_has_no_prefix`), and `-`
+/// with the space flag and no width is pinned for the signed conversions
+/// (`left_adjust_with_space_and_no_width_formats`).
+#[hegel::test]
+fn integers_match_libc(tc: TestCase) {
+    let case = tc.draw(int_case().filter(|c| {
+        let signed = matches!(c.spec.conv, 'd' | 'i');
+        !(signed && c.spec.is_left_space_without_width()) && !(c.spec.flags.alt && truncates_to_zero(&c.arg, c.spec.length))
+    }));
+    check_case(&case);
+}
+
+/// `f`/`F` of finite doubles with every flag, width and precision print as glibc prints them
+/// (both round the exact binary value).  `#` is pinned (printf-compat/7); `e`/`E` are pinned
+/// (printf-compat/1); `g`/`a` are documented aliases of `f`; `-` with the space flag and no
+/// width is pinned (printf-compat/2).
+#[hegel::test]
+fn floats_match_libc(tc: TestCase) {
+    let floats = case(
+        spec(generators::sampled_from(FLOAT_CONVS), generators::just(""), flags(), size(0, 30), size(0, 20)),
+        finite().map(CArg::F),
+    );
+    let case = tc.draw(floats.filter(|c| !c.spec.is_left_space_without_width()));
+    check_case(&case);
+}
+
+/// `%s` of ASCII strings (and of a null pointer, `(null)`), `%c` of ASCII, and `%p` of non-null
+/// pointers, with width, precision and `-`, print as glibc prints them.
+#[hegel::test]
+fn strings_chars_and_pointers_match_libc(tc: TestCase) {
+    let case = tc.draw(text_case());
+    check_case(&case);
+}
+
+/// A format string of several `int` conversions, `*` widths, `%%` and verbatim text is the
+/// concatenation of its pieces, as glibc prints it, through both writers, with the byte count.
+#[hegel::test]
+fn format_strings_compose(tc: TestCase) {
+    let pieces = tc.draw(generators::vecs(piece()).max_size(6));
+    let (fmt, args) = compose(&pieces);
+    same_as_libc(&format!("{fmt:?} {args:?}"), run_ints(&fmt, &args));
+}
+
+/// The upstream examples (tests/tests.rs) still hold.
+#[hegel::test]
+fn doc_examples(_tc: TestCase) {
+    check("% 0*i", &[17], &CArg::I(23125));
+    check("%- 010i", &[], &CArg::I(23125));
+    check("%+ 4i", &[], &CArg::I(23125));
+    check("%#- 010x", &[], &CArg::I(23125));
+    check("%.*f", &[3], &CArg::F(1234.0));
+    check("%10.4s", &[], &CArg::S("world".into()));
+    check("%s", &[], &CArg::P(0));
+    check("%hhi", &[], &CArg::I(-125));
+    check("%zi", &[], &CArg::UL(211_126_823_125));
+    same_as_libc("%%%% def", run_ints("abc %%%% def", &[]));
+    same_as_libc("%d%%", run_ints("%d%%", &[5]));
+}
