+// --------------------------------------------------------------------------- pinned bugs
+
+/// printf-compat/1: `%e` prints the exponent as C does — a sign and at least two digits
+/// (`1.234000e+03`), not Rust's `1.234000e3`.  (`-` with the space flag and no width is
+/// printf-compat/2's.)
+#[hegel::test]
+fn e_exponent_has_a_sign_and_two_digits(tc: TestCase) {
+    let exponents = case(
+        spec(generators::sampled_from(EXP_CONVS), generators::just(""), flags(), size(0, 30), size(0, 15)),
+        finite().map(CArg::F),
+    );
+    let case = tc.draw(exponents.filter(|c| !c.spec.is_left_space_without_width()));
+    check_case(&case);
+}
+
+/// printf-compat/2: `-` together with the space flag and no width (`%- d`, `%- f`) formats
+/// the number instead of panicking.
+#[hegel::test]
+fn left_adjust_with_space_and_no_width_formats(tc: TestCase) {
+    // no width, or three times in ten a `*` width of 0
+    let width = weighted(vec![w(7, generators::just(Size::Absent)), w(3, generators::just(Size::Star(0)))]);
+    let arg = hegel::one_of!(
+        ints(0, 1000).map(|v| ('d', CArg::I(v as c_int))),
+        ints(0, 1000).map(|v| ('f', CArg::F(v as f64 / 8.0))),
+    );
+    let (zero, width, (conv, arg)) = tc.draw(hegel::tuples!(chance(0.3), width, arg));
+    let spec = Spec { flags: Flags { left: true, space: true, zero, ..Flags::default() }, width, conv, ..Spec::default() };
+    check(&spec.render(), &spec.stars(), &arg);
+}
+
+/// printf-compat/3: a negative `*` width means left adjustment with its magnitude, as in C.
+#[hegel::test]
+fn negative_star_width_means_left_adjustment(tc: TestCase) {
+    let arg = hegel::one_of!(d_int(), f_double(), s_ascii(8), c_ascii());
+    let (magnitude, zero, (conv, arg)) = tc.draw(hegel::tuples!(ints(1, 30), chance(0.3), arg));
+    let spec = Spec { flags: Flags { zero, ..Flags::default() }, width: Size::Star(-(magnitude as c_int)), conv, ..Spec::default() };
+    check(&spec.render(), &spec.stars(), &arg);
+}
+
+/// printf-compat/4: widths and precisions above 65535 pad, as in C, instead of panicking — a
+/// literal width of `%d`, a `*` width of `%d`, a precision of `%f`, a width of `%s`.
+#[hegel::test]
+fn widths_above_u16_format(tc: TestCase) {
+    let big_case = ints(65536, 100_000).flat_map(|big| {
+        let big = big as i32;
+        hegel::one_of!(
+            c_ints().map(move |v| Case { spec: Spec { width: Size::Literal(big), conv: 'd', ..Spec::default() }, arg: CArg::I(v) }),
+            c_ints().map(move |v| Case { spec: Spec { width: Size::Star(big), conv: 'd', ..Spec::default() }, arg: CArg::I(v) }),
+            ints(0, 1000).map(move |n| Case {
+                spec: Spec { precision: Size::Literal(big), conv: 'f', ..Spec::default() },
+                arg: CArg::F(n as f64 / 8.0),
+            }),
+            ascii(8).map(move |s| Case { spec: Spec { width: Size::Literal(big), conv: 's', ..Spec::default() }, arg: CArg::S(s) }),
+        )
+    });
+    let case = tc.draw(big_case);
+    check_case(&case);
+}
+
+const OVERFLOW_LEADS: &[char] = &['3', '5', '9'];
+
+/// printf-compat/5: a width whose digits overflow `int` is an error (glibc returns -1), not a
+/// panic.  Ten to fourteen digits, the first of them 3, 5 or 9.
+#[hegel::test]
+fn width_digits_overflow_is_an_error(tc: TestCase) {
+    let (lead, rest) = tc.draw(hegel::tuples!(
+        generators::sampled_from(OVERFLOW_LEADS),
+        generators::text().alphabet("0123456789").min_size(9).max_size(13)
+    ));
+    let fmt = format!("%{lead}{rest}d");
+    let (c, r) = run(&fmt, &[], &CArg::I(1));
+    assert!(c.is_err(), "glibc printed {fmt:?}");
+    assert_eq!(r.fmt, Err("returned -1".to_string()), "{fmt:?}: fmt_write");
+    assert_eq!(r.io, Err("returned -1".to_string()), "{fmt:?}: io_write");
+}
+
+const NON_FINITE: &[f64] = &[f64::INFINITY, f64::NEG_INFINITY, f64::NAN, -f64::NAN];
+
+/// printf-compat/6: infinities and NaNs print as glibc prints them — `nan`/`inf`, uppercase for
+/// `F`/`E`, the sign of a NaN, and space padding even with the `0` flag.  (`-` with the space
+/// flag and no width is printf-compat/2's.)
+#[hegel::test]
+fn non_finite_floats_match_libc(tc: TestCase) {
+    let non_finite = case(
+        spec(generators::sampled_from(REAL_CONVS), generators::just(""), flags(), size(0, 12), size(0, 6)),
+        generators::sampled_from(NON_FINITE).map(CArg::F),
+    );
+    let case = tc.draw(non_finite.filter(|c| !c.spec.is_left_space_without_width()));
+    check_case(&case);
+}
+
+const FRACTIONS: &[f64] = &[0.0, 0.25, 0.5];
+
+/// printf-compat/7: `#` keeps the decimal point of a float with precision 0 (`%#.0f` of 3 is
+/// `3.`), as the `Flags` documentation says.
+#[hegel::test]
+fn alternate_form_applies_to_floats(tc: TestCase) {
+    let value = hegel::tuples!(ints(-1000, 1000), generators::sampled_from(FRACTIONS)).map(|(n, f)| n as f64 + f);
+    let (conv, left, plus, width, v) =
+        tc.draw(hegel::tuples!(generators::sampled_from(FLOAT_CONVS), chance(0.3), chance(0.3), size(0, 12), value));
+    let spec = Spec { flags: Flags { left, plus, alt: true, ..Flags::default() }, width, precision: Size::Literal(0), length: "", conv };
+    check(&spec.render(), &spec.stars(), &CArg::F(v));
+}
+
+/// printf-compat/8: `#` prepends nothing to a zero (`%#x` of 0 is `0`, not `0x0`).
+#[hegel::test]
+fn alternate_form_of_zero_has_no_prefix(tc: TestCase) {
+    // an `int` zero, or a `long`/`long long`/`size_t` one
+    let zero_arg = hegel::one_of!(
+        generators::just(("", CArg::I(0))),
+        generators::sampled_from(LONG_LENGTHS).map(|length| (length, CArg::UL(0))),
+    );
+    let (left, zero, width, (length, arg)) = tc.draw(hegel::tuples!(chance(0.3), chance(0.3), size(0, 12), zero_arg));
+    let spec = Spec { flags: Flags { left, zero, alt: true, ..Flags::default() }, width, precision: Size::Absent, length, conv: 'x' };
+    check(&spec.render(), &spec.stars(), &arg);
+}
+
+/// Two-byte characters.
+const ACCENTED: &[char] = &['é', 'ü', 'ñ', 'ß', 'ø', 'æ'];
+
+/// printf-compat/9: the width and precision of `%s` count bytes, as in C (and as `io_write`
+/// already does), not characters — `%5s` of `é` is three spaces and `é`.
+#[hegel::test]
+fn string_width_counts_bytes(tc: TestCase) {
+    let word = generators::vecs(generators::sampled_from(ACCENTED)).min_size(1).max_size(5).map(|cs| cs.into_iter().collect::<String>());
+    // no precision, or two times in five one at a character boundary: every character here is two bytes
+    let precision = weighted(vec![w(6, generators::just(Size::Absent)), w(4, ints(0, 5).map(|n| Size::Literal(2 * n as i32)))]);
+    let (s, left, width, precision) = tc.draw(hegel::tuples!(word, chance(0.4), size(0, 14), precision));
+    let spec = Spec { flags: Flags { left, ..Flags::default() }, width, precision, length: "", conv: 's' };
+    check(&spec.render(), &spec.stars(), &CArg::S(s));
+}
+
+/// printf-compat/10: `%p` of a null pointer prints `(nil)`, as glibc does.
+#[hegel::test]
+fn null_pointer_prints_nil(tc: TestCase) {
+    let (left, width) = tc.draw(hegel::tuples!(chance(0.4), size(0, 12)));
+    let spec = Spec { flags: Flags { left, ..Flags::default() }, width, conv: 'p', ..Spec::default() };
+    check(&spec.render(), &spec.stars(), &CArg::P(0));
+}
