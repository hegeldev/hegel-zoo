+//! Hegel properties for `uv-requirements-txt` — uv's `requirements.txt` parser (`RequirementsTxt::
+//! parse`: requirements with `--hash` tails, `-r`/`-c` includes, `-e` editables, `--index-url`,
+//! `--extra-index-url`, `--find-links`, `--no-index`, `--require-hashes`, `--no-binary`,
+//! `--only-binary`, comments, line continuations, `${VAR}` expansion) — with **pip's own
+//! requirements-file parser** (`pip._internal.req.req_file`: `RequirementsFileParser`,
+//! `preprocess`, `get_line_parser`; the format's owner) as the oracle, driven as one persistent
+//! Python child over the same generated tree of files.
+//!
+//! The generators are values: a property draws one `Tree` — the root file's lines (each a
+//! `Trivia`, a `Req` or an `OptLine`), its line endings, and optionally a `Sub` (with its own
+//! lines and optionally an `Inner` file) and a `Constraints` file, each with the `Include` line
+//! that pulls it in — built from `tuples!`, `one_of!`, `sampled_from`, `vecs`, `text` and a
+//! `weighted` choice (one integer `flat_map`ped to the alternative it selects), and renders it to
+//! files with pure functions (`Tree::files`, `Req::render`, `Join::render`, ...).  The absent or
+//! plainest alternative comes first in every choice, so a shrunk tree is a root file of one plain
+//! requirement.  Include positions are indices taken modulo the live line count, and the options
+//! uv allows once per tree (`--index-url`, `--no-binary`/`--only-binary`, `-e`) are admitted by
+//! the renderer in file order — a second one renders as an empty line — so the shrinker can
+//! delete any line freely.
+
+use std::collections::BTreeSet;
+use std::io::{BufRead, BufReader, Write};
+use std::path::{Path, PathBuf};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::sync::{Mutex, OnceLock};
+
+use hegel::generators::{self, BoxedPrintableGenerator, Generator as _};
+use hegel::{PrintableGenerator, TestCase};
+use url::Url;
+use uv_configuration::{NoBinary, NoBuild};
+use uv_pep508::VersionOrUrl;
+use uv_requirements_txt::{RequirementsTxt, RequirementsTxtRequirement};
+
+/// The environment variable the generated files reference as `${HEGEL_ZOO_REQ_VAR}`.
+const ENV_VAR: &str = "HEGEL_ZOO_REQ_VAR";
+const ENV_VALUE: &str = "sub";
+
+// --------------------------------------------------------------------------- the Python oracle
+
+const ORACLE_SCRIPT: &str = r#"
+import json
+import sys
+from packaging.requirements import Requirement, InvalidRequirement
+from packaging.utils import canonicalize_name
+from pip._internal.req.req_file import RequirementsFileParser, get_line_parser
+from pip._internal.network.session import PipSession
+
+def dec(h):
+    return bytes.fromhex(h).decode('utf-8')
+
+def enc(s):
+    return s.encode('utf-8').hex()
+
+session = PipSession()
+
+def parse(root):
+    parser = RequirementsFileParser(session, get_line_parser(None))
+    records = []
+    for line in parser._parse_and_recurse(root, False):
+        opts = line.opts
+        rec = {'constraint': line.constraint, 'lineno': line.lineno, 'file': line.filename}
+        if line.is_requirement:
+            rec['kind'] = 'editable' if line.is_editable else 'req'
+            rec['text'] = line.requirement
+            if not line.is_editable:
+                try:
+                    req = Requirement(line.requirement)
+                except InvalidRequirement as e:
+                    raise ValueError(f"invalid requirement {line.requirement!r}: {e}")
+                rec['name'] = canonicalize_name(req.name)
+                rec['specs'] = sorted(str(s).replace(' ', '') for s in req.specifier)
+                rec['extras'] = sorted(canonicalize_name(e) for e in req.extras)
+                rec['marker'] = req.marker is not None
+                rec['url'] = req.url
+            hashes = opts.hashes or {}
+            rec['hashes'] = sorted(f"{algo}:{digest}" for algo, digests in hashes.items() for digest in digests)
+        else:
+            rec['kind'] = 'opt'
+            rec['index_url'] = opts.index_url
+            rec['extra_index_urls'] = list(opts.extra_index_urls or [])
+            rec['find_links'] = list(opts.find_links or [])
+            rec['no_index'] = bool(opts.no_index)
+            rec['require_hashes'] = bool(opts.require_hashes)
+            fc = opts.format_control
+            rec['no_binary'] = sorted(fc.no_binary)
+            rec['only_binary'] = sorted(fc.only_binary)
+            rec['pre'] = bool(opts.pre)
+            rec['trusted_hosts'] = list(opts.trusted_hosts or [])
+            rec['hashes'] = sorted(f"{a}:{d}" for a, ds in (opts.hashes or {}).items() for d in ds)
+        records.append(rec)
+    return records
+
+for line in sys.stdin:
+    parts = line.rstrip('\n').split(' ')
+    cmd, args = parts[0], [dec(p) for p in parts[1:]]
+    try:
+        if cmd == 'F':
+            out = ['ok', json.dumps(parse(args[0]))]
+        else:
+            out = ['bad', cmd]
+    except Exception as e:
+        out = ['err', f"{type(e).__name__}: {e}"]
+    print(' '.join([out[0]] + [enc(x) for x in out[1:]]), flush=True)
+"#;
+
+struct Oracle {
+    child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+static ORACLE: OnceLock<Mutex<Oracle>> = OnceLock::new();
+static ENV: OnceLock<()> = OnceLock::new();
+
+/// Set the environment variable the generated files reference, once, before any parse or the
+/// oracle's spawn (both read the process environment).
+fn setup_env() {
+    ENV.get_or_init(|| {
+        // SAFETY: called before any other thread of this test binary reads the environment
+        // (every property calls it first, and the oracle child is spawned afterwards).
+        #[allow(unsafe_code)]
+        unsafe {
+            std::env::set_var(ENV_VAR, ENV_VALUE);
+        }
+    });
+}
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|b| format!("{b:02x}")).collect()
+}
+
+fn unhex(h: &str) -> String {
+    let bytes: Vec<u8> = (0..h.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&h[i..i + 2], 16).unwrap())
+        .collect();
+    String::from_utf8(bytes).unwrap()
+}
+
+fn oracle() -> &'static Mutex<Oracle> {
+    ORACLE.get_or_init(|| {
+        setup_env();
+        let python = ["python3", "/usr/bin/python3"]
+            .into_iter()
+            .find(|py| {
+                Command::new(py)
+                    .args(["-c", "import pip._internal.req.req_file, packaging.requirements"])
+                    .stdout(Stdio::null())
+                    .stderr(Stdio::null())
+                    .status()
+                    .is_ok_and(|s| s.success())
+            })
+            .expect("a python3 with `pip` and `packaging` is needed as the oracle");
+        let mut child = Command::new(python)
+            .arg("-u")
+            .arg("-c")
+            .arg(ORACLE_SCRIPT)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            // Not inherited: a stray line from Python on the test binary's
+            // stderr can split libtest's own `test ... ok` line in two and
+            // make a result unreadable (seen on CI, 2026-09-17).
+            .stderr(Stdio::null())
+            .spawn()
+            .expect("spawn the pip oracle");
+        let stdin = child.stdin.take().unwrap();
+        let stdout = BufReader::new(child.stdout.take().unwrap());
+        Mutex::new(Oracle {
+            child,
+            stdin,
+            stdout,
+        })
+    })
+}
+
+/// Ask the oracle: the status (`ok` or `err`) and the decoded fields.
+fn ask(cmd: &str, args: &[&str]) -> (String, Vec<String>) {
+    let mut o = oracle().lock().unwrap();
+    let mut line = cmd.to_string();
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a));
+    }
+    line.push('\n');
+    o.stdin.write_all(line.as_bytes()).expect("oracle stdin");
+    let mut reply = String::new();
+    let n = o.stdout.read_line(&mut reply).expect("oracle stdout");
+    if n == 0 {
+        let status = o.child.try_wait().ok().flatten();
+        panic!("the Python oracle exited ({status:?})");
+    }
+    let mut it = reply.trim_end_matches(['\n', '\r']).split(' ');
+    let status = it.next().unwrap().to_string();
+    assert!(matches!(status.as_str(), "ok" | "err"), "oracle said {reply:?} to {line:?}");
+    (status, it.filter(|s| !s.is_empty()).map(unhex).collect())
+}
+
+/// pip's parse of the tree rooted at `root`: the yielded lines as JSON records, or the error.
+fn pip_parse(root: &Path) -> Result<Vec<serde_json::Value>, String> {
+    let (status, fields) = ask("F", &[root.to_str().unwrap()]);
+    if status == "ok" {
+        Ok(serde_json::from_str(&fields[0]).expect("oracle JSON"))
+    } else {
+        Err(fields.join(" "))
+    }
+}
+
+fn uv_parse(root: &Path, working_dir: &Path) -> Result<RequirementsTxt, String> {
+    setup_env();
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap();
+    runtime
+        .block_on(RequirementsTxt::parse(root, working_dir))
+        .map_err(|e| format!("{e}"))
+}
+
+// --------------------------------------------------------------------------- generator helpers
+
+fn ints(lo: i64, hi: i64) -> generators::IntegerGenerator<i64> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// True `p` of the time; shrinks to false.
+fn chance(p: f64) -> generators::BoolGenerator {
+    generators::weighted_booleans(p)
+}
+
+/// A weight and an alternative for [`weighted`].
+fn w<T>(
+    weight: u32,
+    g: impl PrintableGenerator<T> + Send + Sync + 'static,
+) -> (u32, BoxedPrintableGenerator<'static, T>) {
+    (weight, g.boxed_printable())
+}
+
+/// One of the alternatives, each as often as its weight says: one integer draw `flat_map`ped to
+/// the alternative whose cumulative weight it falls under, so only the chosen one is drawn and
+/// the choice shrinks to the first alternative.  (Hegel has no weighted `one_of!`.)
+fn weighted<T: 'static>(
+    choices: Vec<(u32, BoxedPrintableGenerator<'static, T>)>,
+) -> impl PrintableGenerator<T> {
+    let total: u32 = choices.iter().map(|(weight, _)| weight).sum();
+    ints(0, i64::from(total) - 1).flat_map(move |x| {
+        let mut x = x as u32;
+        for (weight, g) in &choices {
+            if x < *weight {
+                return g.clone();
+            }
+            x -= weight;
+        }
+        unreachable!()
+    })
+}
+
+/// `Some` of `g` `p` of the time, else `None`; shrinks to `None`, and draws `g` only when present.
+fn maybe<T>(
+    p: f64,
+    g: impl PrintableGenerator<T> + Send + Sync + 'static,
+) -> impl PrintableGenerator<Option<T>>
+where
+    T: hegel::PrettyPrintable + Clone + Send + Sync + 'static,
+{
+    let present = g.map(Some).boxed_printable();
+    let absent: BoxedPrintableGenerator<'static, Option<T>> = generators::just(None).boxed_printable();
+    chance(p).flat_map(move |yes| if yes { present.clone() } else { absent.clone() })
+}
+
+// --------------------------------------------------------------------------- the generated tree
+
+/// The files of a generated tree, relative to its root directory.
+struct World {
+    dir: tempfile::TempDir,
+    files: Vec<(PathBuf, String)>,
+}
+
+impl World {
+    /// Write `files` (and the fixed `nested/`, `pkg/` and `wheels/` directories) to a fresh
+    /// temporary directory.
+    fn write(files: Vec<(PathBuf, String)>) -> World {
+        let dir = tempfile::tempdir().unwrap();
+        let d = dir.path();
+        std::fs::create_dir_all(d.join("nested")).unwrap();
+        std::fs::create_dir_all(d.join("pkg")).unwrap();
+        std::fs::create_dir_all(d.join("wheels")).unwrap();
+        std::fs::write(
+            d.join("pkg/pyproject.toml"),
+            "[project]\nname = \"pkg\"\nversion = \"0.1\"\n",
+        )
+        .unwrap();
+        for (path, content) in &files {
+            std::fs::write(d.join(path), content).unwrap();
+        }
+        World { dir, files }
+    }
+
+    fn root(&self) -> PathBuf {
+        self.dir.path().join("requirements.txt")
+    }
+}
+
+const NAMES: &[&str] = &["requests", "Flask", "numpy", "a-b_c.d", "Zope.Interface", "x1"];
+const EXTRAS: &[&str] = &["security", "Extra_2", "tests", "a.b"];
+const SPECS: &[&str] = &[">=2", "==1.0.*", "~=1.4", "<3,>=2.1", "!=0.9", ">=1.0a1", "===1.0"];
+const MARKERS: &[&str] = &[
+    "python_version >= '3.8'",
+    "sys_platform == \"linux\"",
+    "python_version < '3.12' and os_name == 'posix'",
+    "extra == 'x'",
+];
+const URLS: &[&str] = &[
+    "https://example.com/simple",
+    "https://user:pw@idx.example/simple/",
+    "https://${HEGEL_ZOO_REQ_VAR}.example/simple",
+    "https://x.example/s?q=1",
+    "http://localhost:8080/simple",
+];
+const HOSTS: &[&str] = &["example.com", "idx.example:8080"];
+/// The characters of a hash digest.
+const HEX: &str = "019abf";
+const ALGORITHMS: &[&str] = &["sha256", "sha384", "sha512"];
+
+/// How an option and its value are joined: a space, two spaces, a tab, or (long options only;
+/// a short option renders `Equals` as a space) `key=value`.
+#[derive(Clone, Copy, Debug, PartialEq, hegel::PrettyPrintable)]
+enum Join {
+    Space,
+    Spaces,
+    Tab,
+    Equals,
+}
+
+impl Join {
+    fn render(self, key: &str, value: &str) -> String {
+        match self {
+            Join::Space => format!("{key} {value}"),
+            Join::Spaces => format!("{key}  {value}"),
+            Join::Tab => format!("{key}\t{value}"),
+            Join::Equals if key.starts_with("--") => format!("{key}={value}"),
+            Join::Equals => format!("{key} {value}"),
+        }
+    }
+}
+
+/// Whitespace (a space first), or `=` two times in five.
+const JOINS: &[Join] = &[Join::Space, Join::Spaces, Join::Tab, Join::Equals, Join::Equals];
+
+fn join() -> generators::SampledFromGenerator<'static, Join> {
+    generators::sampled_from(JOINS)
+}
+
+/// A shell-quoted spelling of a value (pip runs option strings through `shlex`; uv unquotes).
+#[derive(Clone, Copy, Debug, PartialEq, hegel::PrettyPrintable)]
+enum Quote {
+    None,
+    Single,
+    Double,
+}
+
+impl Quote {
+    fn wrap(self, value: &str) -> String {
+        match self {
+            Quote::None => value.to_string(),
+            Quote::Single => format!("'{value}'"),
+            Quote::Double => format!("\"{value}\""),
+        }
+    }
+}
+
+/// Unquoted four times in six.
+const QUOTES: &[Quote] = &[Quote::None, Quote::None, Quote::None, Quote::None, Quote::Single, Quote::Double];
+
+fn quote() -> generators::SampledFromGenerator<'static, Quote> {
+    generators::sampled_from(QUOTES)
+}
+
+/// A trailing comment: the whitespace before the `#` (a comment needs some) and its text.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Comment {
+    gap: &'static str,
+    text: &'static str,
+}
+
+const GAPS: &[&str] = &[" ", "\t", "   "];
+const COMMENTS: &[&str] = &["note", "pinned by x", "#!"];
+
+/// No comment, or one time in five a trailing ` # comment`.
+fn comment() -> impl PrintableGenerator<Option<Comment>> {
+    maybe(
+        0.2,
+        hegel::tuples!(generators::sampled_from(GAPS), generators::sampled_from(COMMENTS))
+            .map(|(gap, text)| Comment { gap, text }),
+    )
+}
+
+fn render_comment(comment: &Option<Comment>) -> String {
+    match comment {
+        Some(Comment { gap, text }) => format!("{gap}# {text}"),
+        None => String::new(),
+    }
+}
+
+/// A `--hash` value, `sha256:<digest>` style.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Hash {
+    algorithm: &'static str,
+    digest: String,
+}
+
+/// Four to twelve hex-ish characters.
+fn digest() -> generators::TextGenerator {
+    generators::text().alphabet(HEX).min_size(4).max_size(12)
+}
+
+fn hash() -> impl PrintableGenerator<Hash> {
+    hegel::tuples!(generators::sampled_from(ALGORITHMS), digest())
+        .map(|(algorithm, digest)| Hash { algorithm, digest })
+}
+
+/// One `--hash` of a requirement: on the same line, or half the time on a continuation line.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct HashTail {
+    continued: bool,
+    join: Join,
+    hash: Hash,
+}
+
+fn hash_tail() -> impl PrintableGenerator<HashTail> {
+    hegel::tuples!(chance(0.5), join(), hash())
+        .map(|(continued, join, hash)| HashTail { continued, join, hash })
+}
+
+/// A version specifier, three times in ten separated from the name by a space.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Spec {
+    spaced: bool,
+    text: &'static str,
+}
+
+/// A PEP 508 requirement line with an optional `--hash` tail.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Req {
+    name: &'static str,
+    extras: Vec<&'static str>,
+    spec: Option<Spec>,
+    marker: Option<&'static str>,
+    hashes: Vec<HashTail>,
+    comment: Option<Comment>,
+}
+
+impl Req {
+    fn render(&self) -> String {
+        let mut s = self.name.to_string();
+        if !self.extras.is_empty() {
+            s.push_str(&format!("[{}]", self.extras.join(",")));
+        }
+        if let Some(spec) = &self.spec {
+            if spec.spaced {
+                s.push(' ');
+            }
+            s.push_str(spec.text);
+        }
+        if let Some(marker) = self.marker {
+            s.push_str(&format!(" ; {marker}"));
+        }
+        for tail in &self.hashes {
+            s.push_str(if tail.continued { " \\\n    " } else { " " });
+            s.push_str(&tail.join.render("--hash", &format!("{}:{}", tail.hash.algorithm, tail.hash.digest)));
+        }
+        s.push_str(&render_comment(&self.comment));
+        s
+    }
+}
+
+/// A name; extras three times in ten (one or two); a specifier six times in ten; a marker three
+/// times in ten; with `with_hashes`, one to three `--hash` tails nine times in twenty; a comment.
+fn requirement(with_hashes: bool) -> impl PrintableGenerator<Req> {
+    let extras = maybe(0.3, generators::vecs(generators::sampled_from(EXTRAS)).min_size(1).max_size(2))
+        .map(Option::unwrap_or_default);
+    let spec = maybe(
+        0.6,
+        hegel::tuples!(chance(0.3), generators::sampled_from(SPECS)).map(|(spaced, text)| Spec { spaced, text }),
+    );
+    let hashes = if with_hashes {
+        maybe(0.45, generators::vecs(hash_tail()).min_size(1).max_size(3))
+            .map(Option::unwrap_or_default)
+            .boxed_printable()
+    } else {
+        generators::just(Vec::new()).boxed_printable()
+    };
+    hegel::tuples!(
+        generators::sampled_from(NAMES),
+        extras,
+        spec,
+        maybe(0.3, generators::sampled_from(MARKERS)),
+        hashes,
+        comment()
+    )
+    .map(|(name, extras, spec, marker, hashes, comment)| Req { name, extras, spec, marker, hashes, comment })
+}
+
+/// A line that is trivia to both parsers.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Trivia {
+    /// an empty line
+    Empty,
+    /// whitespace only
+    Blank(&'static str),
+    /// `# text`
+    Comment(&'static str),
+    /// `   # text`
+    Indented(&'static str),
+    /// a lone `#`
+    Hash,
+}
+
+impl Trivia {
+    fn render(&self) -> String {
+        match self {
+            Trivia::Empty => String::new(),
+            Trivia::Blank(ws) => ws.to_string(),
+            Trivia::Comment(text) => format!("# {text}"),
+            Trivia::Indented(text) => format!("   # {text}"),
+            Trivia::Hash => "#".to_string(),
+        }
+    }
+}
+
+const BLANKS: &[&str] = &[" ", "\t", "   "];
+const COMMENT_LINES: &[&str] = &["comment", "-r not-an-include.txt", "requests==1"];
+const INDENTED_COMMENTS: &[&str] = &["indented", "x"];
+
+fn trivia() -> impl PrintableGenerator<Trivia> {
+    hegel::one_of!(
+        generators::just(Trivia::Empty),
+        generators::sampled_from(BLANKS).map(Trivia::Blank),
+        generators::sampled_from(COMMENT_LINES).map(Trivia::Comment),
+        generators::sampled_from(INDENTED_COMMENTS).map(Trivia::Indented),
+        generators::just(Trivia::Hash),
+    )
+}
+
+/// An option line's flag, with the value it takes.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Flag {
+    NoIndex,
+    RequireHashes,
+    Pre,
+    TrustedHost(&'static str),
+    /// once per tree (a second one is an error in uv, where pip takes the last)
+    IndexUrl { key: &'static str, quote: Quote, url: &'static str },
+    ExtraIndexUrl { quote: Quote, url: &'static str },
+    /// a URL, or in the root file a local directory
+    FindLinks { key: &'static str, quote: Quote, target: &'static str },
+    /// `--no-binary`/`--only-binary`, once per tree
+    Binary { key: &'static str, quote: Quote, name: &'static str },
+    /// `-e ./pkg`, once per tree and in the root file only
+    Editable { key: &'static str, path: &'static str },
+}
+
+impl Flag {
+    fn render(&self, join: Join) -> String {
+        match self {
+            Flag::NoIndex => "--no-index".to_string(),
+            Flag::RequireHashes => "--require-hashes".to_string(),
+            Flag::Pre => "--pre".to_string(),
+            Flag::TrustedHost(host) => join.render("--trusted-host", host),
+            Flag::IndexUrl { key, quote, url } => join.render(key, &quote.wrap(url)),
+            Flag::ExtraIndexUrl { quote, url } => join.render("--extra-index-url", &quote.wrap(url)),
+            Flag::FindLinks { key, quote, target } => join.render(key, &quote.wrap(target)),
+            Flag::Binary { key, quote, name } => join.render(key, &quote.wrap(name)),
+            Flag::Editable { key, path } => join.render(key, path),
+        }
+    }
+}
+
+/// `--index-url` two times in three, `-i` otherwise.
+const INDEX_KEYS: &[&str] = &["--index-url", "-i", "--index-url"];
+const FIND_LINKS_KEYS: &[&str] = &["--find-links", "-f"];
+const WHEELS: &[&str] = &["./wheels", "wheels"];
+const BINARY_KEYS: &[&str] = &["--no-binary", "--only-binary"];
+const BINARY_NAMES: &[&str] = &[":all:", ":none:", "requests", "Flask", "a-b_c.d"];
+const EDITABLE_KEYS: &[&str] = &["-e", "--editable"];
+const PKG_PATHS: &[&str] = &["./pkg", "pkg"];
+
+/// Every flag equally often; `-e` only in the root file, and there `--find-links` names the
+/// local `wheels` directory half the time.
+fn flag(in_root: bool) -> impl PrintableGenerator<Flag> {
+    let url = || generators::sampled_from(URLS);
+    let find_links_target = if in_root {
+        hegel::one_of!(url(), generators::sampled_from(WHEELS)).boxed_printable()
+    } else {
+        url().boxed_printable()
+    };
+    let mut choices = vec![
+        w(1, generators::just(Flag::NoIndex)),
+        w(1, generators::just(Flag::RequireHashes)),
+        w(1, generators::just(Flag::Pre)),
+        w(1, generators::sampled_from(HOSTS).map(Flag::TrustedHost)),
+        w(
+            1,
+            hegel::tuples!(generators::sampled_from(INDEX_KEYS), quote(), url())
+                .map(|(key, quote, url)| Flag::IndexUrl { key, quote, url }),
+        ),
+        w(1, hegel::tuples!(quote(), url()).map(|(quote, url)| Flag::ExtraIndexUrl { quote, url })),
+        w(
+            1,
+            hegel::tuples!(generators::sampled_from(FIND_LINKS_KEYS), quote(), find_links_target)
+                .map(|(key, quote, target)| Flag::FindLinks { key, quote, target }),
+        ),
+        w(
+            1,
+            hegel::tuples!(generators::sampled_from(BINARY_KEYS), quote(), generators::sampled_from(BINARY_NAMES))
+                .map(|(key, quote, name)| Flag::Binary { key, quote, name }),
+        ),
+    ];
+    if in_root {
+        choices.push(w(
+            1,
+            hegel::tuples!(generators::sampled_from(EDITABLE_KEYS), generators::sampled_from(PKG_PATHS))
+                .map(|(key, path)| Flag::Editable { key, path }),
+        ));
+    }
+    weighted(choices)
+}
+
+/// An option line: the flag, how its value is joined, a comment.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct OptLine {
+    flag: Flag,
+    join: Join,
+    comment: Option<Comment>,
+}
+
+impl OptLine {
+    fn render(&self) -> String {
+        format!("{}{}", self.flag.render(self.join), render_comment(&self.comment))
+    }
+}
+
+fn option_line(in_root: bool) -> impl PrintableGenerator<OptLine> {
+    hegel::tuples!(flag(in_root), join(), comment())
+        .map(|(flag, join, comment)| OptLine { flag, join, comment })
+}
+
+/// The options uv accepts once per tree; the renderer admits the first of each, in file order,
+/// and renders a later one as an empty line.
+#[derive(Default)]
+struct Admitted {
+    index_url: bool,
+    binary: bool,
+    editable: bool,
+}
+
+impl Admitted {
+    fn admit(&mut self, flag: &Flag) -> bool {
+        let slot = match flag {
+            Flag::IndexUrl { .. } => &mut self.index_url,
+            Flag::Binary { .. } => &mut self.binary,
+            Flag::Editable { .. } => &mut self.editable,
+            _ => return true,
+        };
+        !std::mem::replace(slot, true)
+    }
+}
+
+/// A line of a requirements file.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Line {
+    Trivia(Trivia),
+    Req(Req),
+    Opt(OptLine),
+}
+
+impl Line {
+    fn render(&self, admitted: &mut Admitted) -> String {
+        match self {
+            Line::Trivia(t) => t.render(),
+            Line::Req(r) => r.render(),
+            Line::Opt(o) => {
+                if admitted.admit(&o.flag) {
+                    o.render()
+                } else {
+                    String::new()
+                }
+            }
+        }
+    }
+}
+
+/// Trivia, a requirement (twice as often in the root file) or an option line.
+fn line(in_root: bool) -> impl PrintableGenerator<Line> {
+    weighted(vec![
+        w(1, trivia().map(Line::Trivia)),
+        w(if in_root { 2 } else { 1 }, requirement(true).map(Line::Req)),
+        w(1, option_line(in_root).map(Line::Opt)),
+    ])
+}
+
+/// A constraints file's line: trivia, or twice as often a requirement without hashes.
+fn constraint_line() -> impl PrintableGenerator<Line> {
+    weighted(vec![
+        w(1, trivia().map(Line::Trivia)),
+        w(2, requirement(false).map(Line::Req)),
+    ])
+}
+
+fn render_lines(lines: &[Line], admitted: &mut Admitted) -> Vec<String> {
+    lines.iter().map(|line| line.render(admitted)).collect()
+}
+
+/// A line of the root file, three times in twenty indented.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Entry {
+    indent: &'static str,
+    line: Line,
+}
+
+const INDENTS: &[&str] = &[" ", "\t"];
+
+fn entry() -> impl PrintableGenerator<Entry> {
+    let indent = maybe(0.15, generators::sampled_from(INDENTS)).map(|indent| indent.unwrap_or(""));
+    hegel::tuples!(indent, line(true)).map(|(indent, line)| Entry { indent, line })
+}
+
+/// An `-r`/`-c` line, and where in the including file it goes (an index taken modulo the live
+/// line count).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Include {
+    key: &'static str,
+    join: Join,
+    quote: Quote,
+    name: &'static str,
+    at: usize,
+}
+
+impl Include {
+    fn insert_into(&self, lines: &mut Vec<String>) {
+        let at = self.at % (lines.len() + 1);
+        lines.insert(at, self.join.render(self.key, &self.quote.wrap(self.name)));
+    }
+}
+
+fn include(
+    keys: &'static [&'static str],
+    name: impl PrintableGenerator<(Quote, &'static str)> + Send + Sync + 'static,
+    max_at: i64,
+) -> impl PrintableGenerator<Include> {
+    hegel::tuples!(generators::sampled_from(keys), join(), name, ints(0, max_at))
+        .map(|(key, join, (quote, name), at)| Include { key, join, quote, name, at: at as usize })
+}
+
+const REQUIREMENT_KEYS: &[&str] = &["-r", "--requirement"];
+const CONSTRAINT_KEYS: &[&str] = &["-c", "--constraint"];
+const SUB_PATHS: &[&str] = &["sub.txt", "./sub.txt"];
+
+/// `sub.txt` or `./sub.txt` half the time, `sub.txt` possibly quoted a quarter, and a quarter
+/// `${HEGEL_ZOO_REQ_VAR}.txt` (which expands to `sub.txt`).
+fn sub_name() -> impl PrintableGenerator<(Quote, &'static str)> {
+    weighted(vec![
+        w(2, generators::sampled_from(SUB_PATHS).map(|name| (Quote::None, name))),
+        w(1, quote().map(|quote| (quote, "sub.txt"))),
+        w(1, generators::just((Quote::None, "${HEGEL_ZOO_REQ_VAR}.txt"))),
+    ])
+}
+
+/// `nested/inner.txt`, included from `sub.txt`; no includes of its own.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Inner {
+    include: Include,
+    lines: Vec<Line>,
+}
+
+fn inner() -> impl PrintableGenerator<Inner> {
+    hegel::tuples!(
+        include(REQUIREMENT_KEYS, generators::just((Quote::None, "nested/inner.txt")), 4),
+        generators::vecs(line(false)).max_size(3)
+    )
+    .map(|(include, lines)| Inner { include, lines })
+}
+
+/// `sub.txt`, included from the root file; two times in five it includes `nested/inner.txt`.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Sub {
+    include: Include,
+    lines: Vec<Line>,
+    crlf: bool,
+    inner: Option<Inner>,
+}
+
+fn sub() -> impl PrintableGenerator<Sub> {
+    hegel::tuples!(
+        include(REQUIREMENT_KEYS, sub_name(), 6),
+        generators::vecs(line(false)).max_size(4),
+        chance(0.2),
+        maybe(0.4, inner())
+    )
+    .map(|(include, lines, crlf, inner)| Sub { include, lines, crlf, inner })
+}
+
+/// `constraints.txt`, included from the root file with `-c`.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Constraints {
+    include: Include,
+    lines: Vec<Line>,
+}
+
+fn constraints() -> impl PrintableGenerator<Constraints> {
+    hegel::tuples!(
+        include(CONSTRAINT_KEYS, generators::just((Quote::None, "constraints.txt")), 7),
+        generators::vecs(constraint_line()).max_size(3)
+    )
+    .map(|(include, lines)| Constraints { include, lines })
+}
+
+/// A tree of requirements files: `requirements.txt` at the root, possibly including `sub.txt`
+/// (which may include `nested/inner.txt`) and a `constraints.txt`.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Tree {
+    lines: Vec<Entry>,
+    /// CRLF line endings in the root file
+    crlf: bool,
+    /// no newline after the root file's last line
+    unterminated: bool,
+    sub: Option<Sub>,
+    constraints: Option<Constraints>,
+}
+
+impl Tree {
+    /// The files, relative to the tree's directory.
+    fn files(&self) -> Vec<(PathBuf, String)> {
+        let mut admitted = Admitted::default();
+        let mut files = Vec::new();
+        if let Some(sub) = &self.sub {
+            if let Some(inner) = &sub.inner {
+                let lines = render_lines(&inner.lines, &mut admitted);
+                files.push((PathBuf::from("nested/inner.txt"), lines.join("\n") + "\n"));
+            }
+            let mut lines = render_lines(&sub.lines, &mut admitted);
+            if let Some(inner) = &sub.inner {
+                inner.include.insert_into(&mut lines);
+            }
+            let eol = if sub.crlf { "\r\n" } else { "\n" };
+            files.push((PathBuf::from("sub.txt"), lines.join(eol) + eol));
+        }
+        if let Some(constraints) = &self.constraints {
+            let lines = render_lines(&constraints.lines, &mut admitted);
+            files.push((PathBuf::from("constraints.txt"), lines.join("\n") + "\n"));
+        }
+        let mut lines: Vec<String> = self
+            .lines
+            .iter()
+            .map(|entry| format!("{}{}", entry.indent, entry.line.render(&mut admitted)))
+            .collect();
+        if let Some(sub) = &self.sub {
+            sub.include.insert_into(&mut lines);
+        }
+        if let Some(constraints) = &self.constraints {
+            constraints.include.insert_into(&mut lines);
+        }
+        let eol = if self.crlf { "\r\n" } else { "\n" };
+        let mut root = lines.join(eol);
+        if !self.unterminated {
+            root.push_str(eol);
+        }
+        files.push((PathBuf::from("requirements.txt"), root));
+        files
+    }
+}
+
+/// Up to six root lines, CRLF one time in five, unterminated one time in five, `sub.txt`
+/// eleven times in twenty, `constraints.txt` two times in five.
+fn tree() -> impl PrintableGenerator<Tree> {
+    hegel::tuples!(
+        generators::vecs(entry()).max_size(6),
+        chance(0.2),
+        chance(0.2),
+        maybe(0.55, sub()),
+        maybe(0.4, constraints())
+    )
+    .map(|(lines, crlf, unterminated, sub, constraints)| Tree { lines, crlf, unterminated, sub, constraints })
+}
+
+// --------------------------------------------------------------------------- the model
+
+#[derive(Debug, Default, PartialEq, Eq)]
+struct Model {
+    requirements: Vec<(String, Vec<String>, Vec<String>, bool, Vec<String>)>,
+    constraints: Vec<String>,
+    editables: Vec<String>,
+    index_url: Option<String>,
+    extra_index_urls: Vec<String>,
+    find_links: Vec<String>,
+    no_index: bool,
+    require_hashes: bool,
+    no_binary: BTreeSet<String>,
+    only_binary: BTreeSet<String>,
+}
+
+fn strs(v: &serde_json::Value) -> Vec<String> {
+    v.as_array()
+        .map(|a| a.iter().map(|s| s.as_str().unwrap().to_string()).collect())
+        .unwrap_or_default()
+}
+
+/// Normalise a URL-ish value the way uv stores it: an existing path relative to the file's
+/// directory becomes a `file://` URL, anything else is parsed as a URL and re-serialised.
+fn url_text(value: &str, file: &Path) -> String {
+    let expanded = value.replace(&format!("${{{ENV_VAR}}}"), ENV_VALUE);
+    if let Ok(url) = Url::parse(&expanded) {
+        if !url.cannot_be_a_base() {
+            return url.to_string();
+        }
+    }
+    let dir = file.parent().unwrap();
+    let path = std::path::absolute(dir.join(&expanded)).unwrap();
+    Url::from_file_path(path).unwrap().to_string()
+}
+
+/// pip's line records folded the way uv flattens a tree.
+fn model_from_pip(records: &[serde_json::Value]) -> Model {
+    let mut m = Model::default();
+    for r in records {
+        let constraint = r["constraint"].as_bool().unwrap();
+        let file = PathBuf::from(r["file"].as_str().unwrap());
+        match r["kind"].as_str().unwrap() {
+            "req" => {
+                if constraint {
+                    m.constraints.push(r["name"].as_str().unwrap().to_string());
+                } else {
+                    m.requirements.push((
+                        r["name"].as_str().unwrap().to_string(),
+                        strs(&r["specs"]),
+                        strs(&r["extras"]),
+                        r["marker"].as_bool().unwrap(),
+                        strs(&r["hashes"]),
+                    ));
+                }
+            }
+            "editable" => m.editables.push(r["text"].as_str().unwrap().to_string()),
+            _ => {
+                if let Some(u) = r["index_url"].as_str() {
+                    m.index_url = Some(url_text(u, &file));
+                }
+                m.extra_index_urls
+                    .extend(strs(&r["extra_index_urls"]).iter().map(|u| url_text(u, &file)));
+                m.find_links
+                    .extend(strs(&r["find_links"]).iter().map(|u| url_text(u, &file)));
+                m.no_index |= r["no_index"].as_bool().unwrap();
+                m.require_hashes |= r["require_hashes"].as_bool().unwrap();
+                m.no_binary.extend(strs(&r["no_binary"]));
+                m.only_binary.extend(strs(&r["only_binary"]));
+            }
+        }
+    }
+    m
+}
+
+fn binary_set(value: &NoBinary) -> BTreeSet<String> {
+    match value {
+        NoBinary::None => BTreeSet::new(),
+        NoBinary::All => BTreeSet::from([":all:".to_string()]),
+        NoBinary::Packages(names) => names.iter().map(|n| n.to_string()).collect(),
+    }
+}
+
+fn build_set(value: &NoBuild) -> BTreeSet<String> {
+    match value {
+        NoBuild::None => BTreeSet::new(),
+        NoBuild::All => BTreeSet::from([":all:".to_string()]),
+        NoBuild::Packages(names) => names.iter().map(|n| n.to_string()).collect(),
+    }
+}
+
+fn model_from_uv(parsed: &RequirementsTxt) -> Model {
+    let mut m = Model::default();
+    for entry in &parsed.requirements {
+        match &entry.requirement {
+            RequirementsTxtRequirement::Named(r) => {
+                let specs = match &r.version_or_url {
+                    Some(VersionOrUrl::VersionSpecifier(vs)) => {
+                        let mut v: Vec<String> =
+                            vs.iter().map(|s| s.to_string().replace(' ', "")).collect();
+                        v.sort();
+                        v
+                    }
+                    Some(VersionOrUrl::Url(_)) => vec!["<url>".to_string()],
+                    None => Vec::new(),
+                };
+                // Extras are a set: packaging de-duplicates `[a,a]`, uv keeps the list.
+                let mut extras: Vec<String> = r.extras.iter().map(|e| e.to_string()).collect();
+                extras.sort();
+                extras.dedup();
+                let mut hashes = entry.hashes.clone();
+                hashes.sort();
+                m.requirements.push((
+                    r.name.to_string(),
+                    specs,
+                    extras,
+                    r.marker.contents().is_some(),
+                    hashes,
+                ));
+            }
+            RequirementsTxtRequirement::Unnamed(u) => {
+                m.requirements.push((
+                    format!("<unnamed {}>", u.url.verbatim),
+                    Vec::new(),
+                    Vec::new(),
+                    false,
+                    entry.hashes.clone(),
+                ));
+            }
+        }
+    }
+    m.constraints = parsed.constraints.iter().map(|c| c.name.to_string()).collect();
+    m.editables = parsed
+        .editables
+        .iter()
+        .map(|e| match &e.requirement {
+            RequirementsTxtRequirement::Unnamed(u) => {
+                u.url.verbatim.given().unwrap_or("<no given>").to_string()
+            }
+            RequirementsTxtRequirement::Named(r) => format!("<named {}>", r.name),
+        })
+        .collect();
+    // `Display` of a `VerbatimUrl` masks credentials; compare the real URL.
+    let full = |u: &uv_pep508::VerbatimUrl| u.displayable_with_credentials().to_string();
+    m.index_url = parsed.index_url.as_ref().map(full);
+    m.extra_index_urls = parsed.extra_index_urls.iter().map(full).collect();
+    m.find_links = parsed.find_links.iter().map(full).collect();
+    m.no_index = parsed.no_index;
+    m.require_hashes = parsed.require_hashes;
+    m.no_binary = binary_set(&parsed.no_binary);
+    m.only_binary = build_set(&parsed.only_binary);
+    m
+}
+
+fn show(world: &World) -> String {
+    world
+        .files
+        .iter()
+        .map(|(p, c)| format!("--- {}\n{c:?}", p.display()))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+// --------------------------------------------------------------------------- properties
+
+/// A generated tree of requirements files parses to the same flattened content as pip's own
+/// parser yields for it: requirements (name, specifiers, extras, marker, hashes) in order,
+/// constraints, editables, index URLs, find-links, and the boolean and binary flags.
+#[hegel::test]
+fn trees_flatten_like_pip(tc: TestCase) {
+    let world = World::write(tc.draw(tree()).files());
+    let root = world.root();
+    let pip = pip_parse(&root);
+    let uv = uv_parse(&root, world.dir.path());
+    match (pip, uv) {
+        (Ok(records), Ok(parsed)) => {
+            let expected = model_from_pip(&records);
+            let actual = model_from_uv(&parsed);
+            assert_eq!(actual, expected, "\n{}", show(&world));
+        }
+        (Err(e), Ok(parsed)) => panic!("pip fails ({e}) but uv parses {parsed:#?}\n{}", show(&world)),
+        (Ok(records), Err(e)) => panic!("uv fails ({e}) but pip yields {records:#?}\n{}", show(&world)),
+        (Err(_), Err(_)) => {}
+    }
+}
+
+/// Reparsing the same tree twice gives the same result; a parse of `sub.txt` alone gives the
+/// sub-tree's part of the flattened result.
+#[hegel::test]
+fn parsing_is_deterministic_and_compositional(tc: TestCase) {
+    let world = World::write(tc.draw(tree()).files());
+    let root = world.root();
+    let first = uv_parse(&root, world.dir.path());
+    let second = uv_parse(&root, world.dir.path());
+    assert_eq!(first.is_ok(), second.is_ok(), "{}", show(&world));
+    if let (Ok(a), Ok(b)) = (&first, &second) {
+        assert_eq!(model_from_uv(a), model_from_uv(b), "{}", show(&world));
+    }
+    let sub = world.dir.path().join("sub.txt");
+    if sub.is_file() {
+        if let Ok(whole) = &first {
+            let part = uv_parse(&sub, world.dir.path()).unwrap_or_else(|e| panic!("{e}\n{}", show(&world)));
+            let whole = model_from_uv(whole);
+            let part = model_from_uv(&part);
+            for req in &part.requirements {
+                assert!(whole.requirements.contains(req), "{req:?} missing\n{}", show(&world));
+            }
+            for url in &part.extra_index_urls {
+                assert!(whole.extra_index_urls.contains(url), "{url} missing\n{}", show(&world));
+            }
+            assert!(!part.no_index || whole.no_index);
+            assert!(!part.require_hashes || whole.require_hashes);
+        }
+    }
+}
+
+// --------------------------------------------------------------------------- pinned bugs
+
+const FRAGMENTS: &[&str] = &["#frag", "#egg=x", "#1"];
+
+/// Pinned: uv-requirements-txt/1 — a `#` inside an option's value ends the value (`is_terminal`
+/// treats `#` like a newline), where pip only starts a comment at a `#` preceded by whitespace:
+/// `--index-url https://h/simple#frag` loses the fragment, `-r sub#1.txt` reads `sub`.
+#[hegel::test]
+fn hash_in_option_values_is_not_a_comment(tc: TestCase) {
+    let world = World::write(vec![
+        (PathBuf::from("sub#1.txt"), "flask\n".to_string()),
+        (PathBuf::from("sub.txt"), "requests\n".to_string()),
+    ]);
+    let d = world.dir.path();
+    let option = hegel::one_of!(
+        generators::sampled_from(FRAGMENTS).map(|frag| ("--index-url", format!("https://example.com/simple{frag}"))),
+        generators::sampled_from(FRAGMENTS).map(|frag| ("--find-links", format!("https://example.com/links{frag}"))),
+        generators::sampled_from(REQUIREMENT_KEYS).map(|key| (key, "sub#1.txt".to_string())),
+    );
+    let ((key, value), join) = tc.draw(hegel::tuples!(option, join()));
+    let line = join.render(key, &value);
+    let root = d.join("requirements.txt");
+    std::fs::write(&root, format!("{line}\n")).unwrap();
+    let pip = pip_parse(&root).unwrap_or_else(|e| panic!("pip: {e}"));
+    let uv = uv_parse(&root, d).unwrap_or_else(|e| panic!("uv: {e} for {line:?}"));
+    assert_eq!(model_from_uv(&uv), model_from_pip(&pip), "{line:?}");
+}
+
+const COMMA_ITEMS: &[&str] = &["requests", "Flask", "a-b_c.d", ":none:"];
+
+/// Pinned: uv-requirements-txt/2 — `--no-binary`/`--only-binary` take pip's comma-separated
+/// list (`--no-binary a,b`, `--only-binary :none:,a`); uv parses the whole value as one package
+/// name and fails.
+#[hegel::test]
+fn binary_options_take_comma_lists(tc: TestCase) {
+    let world = World::write(vec![]);
+    let d = world.dir.path();
+    let (key, items, join) = tc.draw(hegel::tuples!(
+        generators::sampled_from(BINARY_KEYS),
+        generators::vecs(generators::sampled_from(COMMA_ITEMS)).min_size(2).max_size(3),
+        join()
+    ));
+    let line = join.render(key, &items.join(","));
+    let root = d.join("requirements.txt");
+    std::fs::write(&root, format!("{line}\n")).unwrap();
+    let pip = pip_parse(&root).unwrap_or_else(|e| panic!("pip: {e}"));
+    let uv = uv_parse(&root, d).unwrap_or_else(|e| panic!("uv: {e} for {line:?}"));
+    assert_eq!(model_from_uv(&uv), model_from_pip(&pip), "{line:?}");
+}
+
+const CONTINUATION_INDENTS: &[&str] = &["", "  ", "\t"];
+const CONTINUED_OPTIONS: &[(&str, &str)] = &[
+    ("--index-url", "https://example.com/simple"),
+    ("--extra-index-url", "https://x.example/s"),
+    ("--find-links", "https://example.com/links"),
+    ("-r", "sub.txt"),
+];
+
+/// Pinned: uv-requirements-txt/3 — the documented grammar allows `wrappable_whitespaces`
+/// between an option and its value, and pip joins backslash-continued lines before parsing,
+/// but `parse_value` only eats plain whitespace: `--index-url \` + newline + URL fails.
+#[hegel::test]
+fn option_values_may_follow_a_line_continuation(tc: TestCase) {
+    let world = World::write(vec![(PathBuf::from("sub.txt"), "requests\n".to_string())]);
+    let d = world.dir.path();
+    let (indent, (key, value)) = tc.draw(hegel::tuples!(
+        generators::sampled_from(CONTINUATION_INDENTS),
+        generators::sampled_from(CONTINUED_OPTIONS)
+    ));
+    let line = format!("{key} \\\n{indent}{value}");
+    let root = d.join("requirements.txt");
+    std::fs::write(&root, format!("{line}\n")).unwrap();
+    let pip = pip_parse(&root).unwrap_or_else(|e| panic!("pip: {e}"));
+    let uv = uv_parse(&root, d).unwrap_or_else(|e| panic!("uv: {e} for {line:?}"));
+    assert_eq!(model_from_uv(&uv), model_from_pip(&pip), "{line:?}");
+}
+
+/// Pinned: uv-requirements-txt/4 — the grammar documents `--hash` values as `name:digest`, and
+/// pip refuses a value without the colon; uv keeps any non-whitespace text as a hash.
+#[hegel::test]
+fn hash_values_have_the_documented_shape(tc: TestCase) {
+    let world = World::write(vec![]);
+    let d = world.dir.path();
+    let (name, digest, join) = tc.draw(hegel::tuples!(generators::sampled_from(NAMES), digest(), join()));
+    let line = format!("{name} {}", join.render("--hash", &digest));
+    let root = d.join("requirements.txt");
+    std::fs::write(&root, format!("{line}\n")).unwrap();
+    let pip = pip_parse(&root);
+    let uv = uv_parse(&root, d);
+    assert!(pip.is_err(), "pip accepted {line:?}: {pip:?}");
+    assert!(uv.is_err(), "pip refuses {line:?} but uv gives {uv:#?}");
+}
