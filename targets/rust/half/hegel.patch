+//! Property tests for `half`'s `f16` and `bf16`.
+//!
+//! The crate documents its conversions as "rounded to the nearest representable value" (IEEE
+//! 754 round-to-nearest-even) and implements arithmetic, `mul_add` and friends by computing in
+//! `f32` and converting back. The oracle here is exact: every finite `f16`/`bf16`/`f32`/`f64` is
+//! an integer times a power of two, so sums, products, quotients and fused multiply-adds are
+//! evaluated exactly as `num / den · 2^exp` in `i128` and rounded to the target format once, by
+//! hand. Classification, sign handling, ordering and formatting are checked against the bit
+//! patterns directly.
+
+use half::slice::HalfFloatSliceExt;
+use half::{bf16, f16};
+use hegel::generators;
+use hegel::Generator as _;
+use num_traits::Float;
+use std::num::FpCategory;
+
+// ---------------------------------------------------------------------------
+// Exact oracle: round num/den · 2^exp2 (num, den > 0) to a binary format
+// ---------------------------------------------------------------------------
+
+/// A binary floating-point format: `prec` significand bits including the hidden bit, normal
+/// exponents `emin..=emax`, biased exponent field `exp + bias`.
+#[derive(Debug, Clone, Copy)]
+struct Format {
+    prec: u32,
+    emin: i32,
+    emax: i32,
+    bias: i32,
+}
+
+const F16: Format = Format { prec: 11, emin: -14, emax: 15, bias: 15 };
+const BF16: Format = Format { prec: 8, emin: -126, emax: 127, bias: 127 };
+
+fn bit_len(x: i128) -> i32 {
+    debug_assert!(x > 0);
+    128 - x.leading_zeros() as i32
+}
+
+/// The magnitude bits (no sign) of the value `num / den · 2^exp2`, `num, den > 0`, rounded to
+/// nearest, ties to even, in `fmt`; infinity when it overflows. Exact integer arithmetic.
+fn round_magnitude(num: i128, den: i128, exp2: i32, fmt: Format) -> u16 {
+    assert!(num > 0 && den > 0);
+    // floor(log2(num/den)):
+    let mut l = bit_len(num) - bit_len(den);
+    let smaller = if l >= 0 { num < (den << l) } else { (num << -l) < den };
+    if smaller {
+        l -= 1;
+    }
+    let e = l + exp2; // value in [2^e, 2^(e+1))
+    let stored = (fmt.prec - 1) as i32;
+    let inf = ((fmt.emax + fmt.bias + 1) as u16) << stored;
+    if e > fmt.emax {
+        return inf;
+    }
+    // Unit of the last place: normals have prec significant bits, subnormals share emin's ulp.
+    let u = if e < fmt.emin { fmt.emin - stored } else { e - stored };
+    if e < u - 1 {
+        return 0; // below half the smallest subnormal: rounds to zero (and keeps shifts small)
+    }
+    // s = round(value / 2^u) with ties to even.
+    let shift = exp2 - u;
+    let (n, d) = if shift >= 0 { (num << shift, den) } else { (num, den << -shift) };
+    let mut s = n / d;
+    let rem = n % d;
+    if 2 * rem > d || (2 * rem == d && s % 2 == 1) {
+        s += 1;
+    }
+    let hidden = 1i128 << stored;
+    if e < fmt.emin {
+        // Subnormal (or rounded up into the smallest normal, whose encoding is the same).
+        debug_assert!(s <= hidden);
+        return s as u16;
+    }
+    let mut e = e;
+    if s == 2 * hidden {
+        s = hidden;
+        e += 1;
+    }
+    if e > fmt.emax {
+        return inf;
+    }
+    (((e + fmt.bias) as u16) << stored) | (s - hidden) as u16
+}
+
+/// Decompose a finite, nonzero float into `(negative, mantissa, exp2)` with value
+/// `mantissa · 2^exp2`.
+fn decompose_f64(x: f64) -> (bool, i128, i32) {
+    assert!(x.is_finite() && x != 0.0);
+    let bits = x.to_bits();
+    let neg = bits >> 63 == 1;
+    let exp = ((bits >> 52) & 0x7FF) as i32;
+    let frac = (bits & ((1u64 << 52) - 1)) as i128;
+    if exp == 0 {
+        (neg, frac, -1074)
+    } else {
+        (neg, frac | (1 << 52), exp - 1075)
+    }
+}
+
+/// Decompose finite, nonzero `bits` of a 16-bit format into `(negative, mantissa, exp2)`.
+fn decompose_bits(bits: u16, fmt: Format) -> (bool, i128, i32) {
+    let stored = (fmt.prec - 1) as u32;
+    let neg = bits >> 15 == 1;
+    let exp = ((bits >> stored) & ((1 << (15 - stored)) - 1)) as i32;
+    let frac = (bits & ((1 << stored) - 1)) as i128;
+    assert!(exp != (1 << (15 - stored)) - 1 && bits & 0x7FFF != 0, "finite nonzero only: {bits:#06x}");
+    if exp == 0 {
+        (neg, frac, fmt.emin - stored as i32)
+    } else {
+        (neg, frac | (1 << stored), exp - fmt.bias - stored as i32)
+    }
+}
+
+fn sign_bit(neg: bool) -> u16 {
+    if neg { 0x8000 } else { 0 }
+}
+
+/// Correctly rounded conversion of an `f64` to `fmt` bits. NaN payloads are not modelled: a
+/// NaN input yields `None`.
+fn expected_from_f64(x: f64, fmt: Format) -> Option<u16> {
+    let stored = (fmt.prec - 1) as u16;
+    let inf = ((fmt.emax + fmt.bias + 1) as u16) << stored;
+    if x.is_nan() {
+        return None;
+    }
+    let neg = x.is_sign_negative();
+    if x.is_infinite() {
+        return Some(sign_bit(neg) | inf);
+    }
+    if x == 0.0 {
+        return Some(sign_bit(neg));
+    }
+    let (neg, m, e) = decompose_f64(x);
+    Some(sign_bit(neg) | round_magnitude(m, 1, e, fmt))
+}
+
+fn expected_from_f32(x: f32, fmt: Format) -> Option<u16> {
+    expected_from_f64(x as f64, fmt) // f32 → f64 is exact
+}
+
+/// The exact value of finite `bits` as an `f64` (exact for both formats).
+fn exact_value(bits: u16, fmt: Format) -> f64 {
+    let stored = (fmt.prec - 1) as u32;
+    let inf = ((fmt.emax + fmt.bias + 1) as u16) << stored;
+    if bits & 0x7FFF == 0 {
+        return if bits >> 15 == 1 { -0.0 } else { 0.0 };
+    }
+    if bits & 0x7FFF == inf {
+        return if bits >> 15 == 1 { f64::NEG_INFINITY } else { f64::INFINITY };
+    }
+    let (neg, m, e) = decompose_bits(bits, fmt);
+    let v = (m as f64) * 2f64.powi(e);
+    if neg { -v } else { v }
+}
+
+// ---------------------------------------------------------------------------
+// Generators
+// ---------------------------------------------------------------------------
+
+/// Any 16-bit pattern: all f16/bf16 values including both zeros, infinities, NaNs.
+fn bits16() -> impl hegel::PrintableGenerator<u16> {
+    generators::integers::<u16>()
+}
+
+/// A finite 16-bit pattern in `fmt`.
+#[hegel::composite]
+fn finite_bits(tc: &hegel::TestCase, fmt: Format) -> u16 {
+    let stored = (fmt.prec - 1) as u16;
+    let inf = ((fmt.emax + fmt.bias + 1) as u16) << stored;
+    let b = tc.draw(bits16());
+    tc.assume(b & 0x7FFF < inf);
+    b
+}
+
+impl hegel::PrettyPrintable for Format {
+    fn pretty_print(&self, printer: &mut hegel::PrettyPrinter) {
+        hegel::pretty::print_debug_repr(if self.prec == 11 { "F16" } else { "BF16" }, printer);
+    }
+}
+
+/// An `f64` that is hard to round: exactly between two adjacent finite `fmt` values, or a few
+/// `f64` ulps to either side of that midpoint (where a conversion that goes through `f32`, or
+/// truncates low mantissa bits first, rounds the wrong way), or an arbitrary `f64`.
+#[hegel::composite]
+fn hard_f64(tc: &hegel::TestCase, fmt: Format) -> f64 {
+    let kind = tc.draw(generators::integers::<u8>().max_value(3));
+    if kind == 0 {
+        return tc.draw(generators::floats::<f64>());
+    }
+    let stored = (fmt.prec - 1) as u16;
+    let inf = ((fmt.emax + fmt.bias + 1) as u16) << stored;
+    let lo = tc.draw(finite_bits(fmt));
+    tc.assume((lo & 0x7FFF) + 1 < inf); // has a finite successor of the same sign
+    let a = exact_value(lo, fmt);
+    let hi = (lo & 0x8000) | ((lo & 0x7FFF) + 1);
+    let b = exact_value(hi, fmt);
+    let mid = (a + b) / 2.0; // exact: one more bit than the format has
+    match kind {
+        1 => mid,
+        _ => {
+            let ulps = tc.draw(generators::integers::<i32>().min_value(-3).max_value(3));
+            let mut x = mid;
+            for _ in 0..ulps.abs() {
+                x = if (ulps > 0) == (mid > 0.0) { next_up(x) } else { next_down(x) };
+            }
+            x
+        }
+    }
+}
+
+fn next_up(x: f64) -> f64 {
+    if x == 0.0 {
+        return f64::from_bits(1);
+    }
+    let b = x.to_bits();
+    f64::from_bits(if x > 0.0 { b + 1 } else { b - 1 })
+}
+
+fn next_down(x: f64) -> f64 {
+    -next_up(-x)
+}
+
+/// An `f32` that is hard to round to `fmt`: a midpoint (or near one) between adjacent values,
+/// or any `f32`.
+#[hegel::composite]
+fn hard_f32(tc: &hegel::TestCase, fmt: Format) -> f32 {
+    let x = tc.draw(hard_f64(fmt));
+    // Midpoints and their neighbours in f32 (any f16/bf16 midpoint is exact in f32; a
+    // neighbour of it in f64 becomes the midpoint itself or a f32 neighbour).
+    let y = x as f32;
+    if !y.is_finite() || y == 0.0 {
+        return tc.draw(generators::floats::<f32>());
+    }
+    let ulps = tc.draw(generators::integers::<i32>().min_value(-1).max_value(1));
+    match ulps {
+        0 => y,
+        1 => f32::from_bits(if y > 0.0 { y.to_bits() + 1 } else { y.to_bits() - 1 }),
+        _ => f32::from_bits(if y > 0.0 { y.to_bits() - 1 } else { y.to_bits() + 1 }),
+    }
+}
+
+fn check_conversion(name: &str, input: impl std::fmt::Debug, got: u16, want: Option<u16>, fmt: Format) {
+    let stored = (fmt.prec - 1) as u16;
+    let inf = ((fmt.emax + fmt.bias + 1) as u16) << stored;
+    match want {
+        None => assert!(got & 0x7FFF > inf, "{name}({input:?}) = {got:#06x} is not NaN"),
+        Some(w) => assert_eq!(
+            got, w,
+            "{name}({input:?}) = {got:#06x} ({}) but correctly rounded is {w:#06x} ({})",
+            exact_value(got, fmt), exact_value(w, fmt)
+        ),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Conversions
+// ---------------------------------------------------------------------------
+
+/// `f16::from_f32` (and the software `from_f32_const`) round to nearest, ties to even, as
+/// documented ("rounded to the nearest representable value"), including into subnormals and
+/// to infinity on overflow; NaN stays NaN.
+#[hegel::test]
+fn f16_from_f32_is_correctly_rounded(tc: hegel::TestCase) {
+    let x = tc.draw(hard_f32(F16));
+    let want = expected_from_f32(x, F16);
+    check_conversion("f16::from_f32", x, f16::from_f32(x).to_bits(), want, F16);
+    check_conversion("f16::from_f32_const", x, f16::from_f32_const(x).to_bits(), want, F16);
+}
+
+/// `bf16::from_f32` (and `from_f32_const`) round to nearest even.
+#[hegel::test]
+fn bf16_from_f32_is_correctly_rounded(tc: hegel::TestCase) {
+    let x = tc.draw(hard_f32(BF16));
+    let want = expected_from_f32(x, BF16);
+    check_conversion("bf16::from_f32", x, bf16::from_f32(x).to_bits(), want, BF16);
+    check_conversion("bf16::from_f32_const", x, bf16::from_f32_const(x).to_bits(), want, BF16);
+}
+
+/// `f16::from_f64` rounds the `f64` to the nearest `f16` directly — the docs promise the
+/// nearest representable value, which rounding through `f32` first does not give near the
+/// midpoints (a value just above an `f16` midpoint that `f32` rounds *onto* the midpoint is then
+/// rounded to even, i.e. the wrong way).
+#[hegel::test]
+fn f16_from_f64_is_correctly_rounded(tc: hegel::TestCase) {
+    let x = tc.draw(hard_f64(F16));
+    check_conversion("f16::from_f64", x, f16::from_f64(x).to_bits(), expected_from_f64(x, F16), F16);
+}
+
+/// Same for the software (`const`) path, which must not truncate mantissa bits before deciding
+/// how to round.
+#[hegel::test]
+fn f16_from_f64_const_is_correctly_rounded(tc: hegel::TestCase) {
+    let x = tc.draw(hard_f64(F16));
+    check_conversion("f16::from_f64_const", x, f16::from_f64_const(x).to_bits(), expected_from_f64(x, F16), F16);
+}
+
+/// `bf16::from_f64` / `from_f64_const` round to nearest even directly from the `f64`.
+#[hegel::test]
+fn bf16_from_f64_is_correctly_rounded(tc: hegel::TestCase) {
+    let x = tc.draw(hard_f64(BF16));
+    let want = expected_from_f64(x, BF16);
+    check_conversion("bf16::from_f64", x, bf16::from_f64(x).to_bits(), want, BF16);
+    check_conversion("bf16::from_f64_const", x, bf16::from_f64_const(x).to_bits(), want, BF16);
+}
+
+/// Widening is exact: `to_f32`/`to_f64` (and the `const` variants) give the exact value of the
+/// bit pattern, so every finite `f16`/`bf16` round-trips through `f32` and `f64`; infinities and
+/// NaNs keep their kind and sign.
+#[hegel::test]
+fn widening_is_exact_and_round_trips(tc: hegel::TestCase) {
+    let b = tc.draw(bits16());
+    let h = f16::from_bits(b);
+    let g = bf16::from_bits(b);
+    if h.is_nan() {
+        assert!(h.to_f32().is_nan() && h.to_f64().is_nan() && h.to_f32_const().is_nan() && h.to_f64_const().is_nan());
+        assert_eq!(h.to_f32().is_sign_negative(), h.is_sign_negative(), "f16 NaN sign through to_f32");
+        assert!(f16::from_f32(h.to_f32()).is_nan() && f16::from_f64(h.to_f64()).is_nan());
+    } else {
+        let v = exact_value(b, F16);
+        assert_eq!(h.to_f64().to_bits(), v.to_bits(), "f16::to_f64({b:#06x})");
+        assert_eq!(h.to_f64_const().to_bits(), v.to_bits(), "f16::to_f64_const({b:#06x})");
+        assert_eq!(h.to_f32().to_bits(), (v as f32).to_bits(), "f16::to_f32({b:#06x})");
+        assert_eq!(h.to_f32_const().to_bits(), (v as f32).to_bits(), "f16::to_f32_const({b:#06x})");
+        assert_eq!(f16::from_f32(h.to_f32()).to_bits(), b, "f16 round trip through f32");
+        assert_eq!(f16::from_f64(h.to_f64()).to_bits(), b, "f16 round trip through f64");
+        assert_eq!(f16::from_f64_const(h.to_f64()).to_bits(), b, "f16 const round trip through f64");
+    }
+    if g.is_nan() {
+        assert!(g.to_f32().is_nan() && g.to_f64().is_nan() && g.to_f32_const().is_nan() && g.to_f64_const().is_nan());
+        assert!(bf16::from_f32(g.to_f32()).is_nan() && bf16::from_f64(g.to_f64()).is_nan());
+    } else {
+        let v = exact_value(b, BF16);
+        assert_eq!(g.to_f64().to_bits(), v.to_bits(), "bf16::to_f64({b:#06x})");
+        assert_eq!(g.to_f64_const().to_bits(), v.to_bits(), "bf16::to_f64_const({b:#06x})");
+        assert_eq!(g.to_f32().to_bits(), (v as f32).to_bits(), "bf16::to_f32({b:#06x})");
+        assert_eq!(g.to_f32_const().to_bits(), (v as f32).to_bits(), "bf16::to_f32_const({b:#06x})");
+        assert_eq!(bf16::from_f32(g.to_f32()).to_bits(), b, "bf16 round trip through f32");
+        assert_eq!(bf16::from_f64(g.to_f64()).to_bits(), b, "bf16 round trip through f64");
+    }
+}
+
+/// The slice conversions (vectorised in chunks, with a scalar tail) agree bit for bit with the
+/// element-wise conversions, for every length up to a few chunks, and `to_f32_vec`/`to_f64_vec`
+/// agree with `to_f32`/`to_f64`.
+#[hegel::test]
+fn slice_conversions_match_elementwise(tc: hegel::TestCase) {
+    let xs: Vec<f64> = tc.draw(generators::vecs(hard_f64(F16)).max_size(20));
+    let ys: Vec<f32> = xs.iter().map(|&x| x as f32).collect();
+    let n = xs.len();
+
+    let mut from64 = vec![f16::ZERO; n];
+    from64.convert_from_f64_slice(&xs);
+    for i in 0..n {
+        let want = f16::from_f64(xs[i]);
+        assert!(
+            from64[i].to_bits() == want.to_bits() || (from64[i].is_nan() && want.is_nan()),
+            "convert_from_f64_slice[{i}] of {n}: {:#06x} vs from_f64 {:#06x} for {:?}",
+            from64[i].to_bits(), want.to_bits(), xs[i]
+        );
+    }
+    let mut from32 = vec![f16::ZERO; n];
+    from32.convert_from_f32_slice(&ys);
+    for i in 0..n {
+        let want = f16::from_f32(ys[i]);
+        assert!(
+            from32[i].to_bits() == want.to_bits() || (from32[i].is_nan() && want.is_nan()),
+            "convert_from_f32_slice[{i}] of {n}: {:#06x} vs from_f32 {:#06x} for {:?}",
+            from32[i].to_bits(), want.to_bits(), ys[i]
+        );
+    }
+
+    let hs: Vec<f16> = tc.draw(generators::vecs(bits16()).max_size(20)).into_iter().map(f16::from_bits).collect();
+    let mut to32 = vec![0f32; hs.len()];
+    hs.convert_to_f32_slice(&mut to32);
+    let mut to64 = vec![0f64; hs.len()];
+    hs.convert_to_f64_slice(&mut to64);
+    let vec32 = hs.to_f32_vec();
+    let vec64 = hs.to_f64_vec();
+    for i in 0..hs.len() {
+        let (w32, w64) = (hs[i].to_f32(), hs[i].to_f64());
+        let same32 = |x: f32| x.to_bits() == w32.to_bits() || (x.is_nan() && w32.is_nan());
+        let same64 = |x: f64| x.to_bits() == w64.to_bits() || (x.is_nan() && w64.is_nan());
+        assert!(same32(to32[i]), "convert_to_f32_slice[{i}]: {:?} vs {w32:?}", to32[i]);
+        assert!(same64(to64[i]), "convert_to_f64_slice[{i}]: {:?} vs {w64:?}", to64[i]);
+        assert!(same32(vec32[i]), "to_f32_vec[{i}]: {:?} vs {w32:?}", vec32[i]);
+        assert!(same64(vec64[i]), "to_f64_vec[{i}]: {:?} vs {w64:?}", vec64[i]);
+    }
+
+    let mut gs = vec![bf16::ZERO; n];
+    gs.convert_from_f64_slice(&xs);
+    for i in 0..n {
+        let want = bf16::from_f64(xs[i]);
+        assert!(
+            gs[i].to_bits() == want.to_bits() || (gs[i].is_nan() && want.is_nan()),
+            "bf16 convert_from_f64_slice[{i}] of {n}: {:#06x} vs from_f64 {:#06x} for {:?}",
+            gs[i].to_bits(), want.to_bits(), xs[i]
+        );
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Arithmetic
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+enum Op {
+    Add,
+    Sub,
+    Mul,
+    Div,
+}
+
+/// The correctly rounded result of `a op b` for finite operands (`b != 0` for `Div`), as bits
+/// of `fmt`, following IEEE 754 for the sign of an exact zero.
+fn expected_arith(a: u16, b: u16, op: Op, fmt: Format) -> u16 {
+    let dec = |x: u16| -> (bool, i128, i32) {
+        if x & 0x7FFF == 0 { (x >> 15 == 1, 0, 0) } else { decompose_bits(x, fmt) }
+    };
+    let (na, ma, ea) = dec(a);
+    let (nb, mb, eb) = dec(b);
+    let sa = if na { -1i128 } else { 1 };
+    let sb = if nb { -1i128 } else { 1 };
+    match op {
+        Op::Add | Op::Sub => {
+            let sb = if op == Op::Sub { -sb } else { sb };
+            let nb_eff = sb < 0;
+            if ma == 0 && mb == 0 {
+                // IEEE 754: an exact zero sum is -0 only when both addends are -0.
+                return sign_bit(na && nb_eff);
+            }
+            if ma == 0 {
+                return sign_bit(nb_eff) | (b & 0x7FFF);
+            }
+            if mb == 0 {
+                return a;
+            }
+            let (ma, ea, mb, eb) = sticky_align(ma, ea, mb, eb);
+            let e = ea.min(eb);
+            let v = sa * (ma << (ea - e)) + sb * (mb << (eb - e));
+            if v == 0 {
+                return 0; // x + (-x) is +0 in round-to-nearest
+            }
+            sign_bit(v < 0) | round_magnitude(v.abs(), 1, e, fmt)
+        }
+        Op::Mul => {
+            let neg = na != nb;
+            if ma == 0 || mb == 0 {
+                return sign_bit(neg);
+            }
+            sign_bit(neg) | round_magnitude(ma * mb, 1, ea + eb, fmt)
+        }
+        Op::Div => {
+            let neg = na != nb;
+            assert!(mb != 0);
+            if ma == 0 {
+                return sign_bit(neg);
+            }
+            sign_bit(neg) | round_magnitude(ma, mb, ea - eb, fmt)
+        }
+    }
+}
+
+/// Bring two nonzero terms `ma·2^ea`, `mb·2^eb` to exponents at most 100 apart: a term more
+/// than 2^100 times smaller than the other cannot change how their sum rounds beyond being a
+/// nonzero "sticky" remainder, so it is replaced by `1·2^(e_big − 100)` of the same sign. Keeps
+/// the `i128` shifts in range for `bf16`'s exponent span.
+fn sticky_align(ma: i128, ea: i32, mb: i128, eb: i32) -> (i128, i32, i128, i32) {
+    debug_assert!(ma != 0 && mb != 0);
+    let (ta, tb) = (ea + bit_len(ma), eb + bit_len(mb)); // magnitudes in [2^(t-1), 2^t)
+    if ta - tb > 100 {
+        (ma, ea, 1, ea - 100)
+    } else if tb - ta > 100 {
+        (1, eb - 100, mb, eb)
+    } else {
+        (ma, ea, mb, eb)
+    }
+}
+
+fn arith_case(tc: &hegel::TestCase, fmt: Format) -> (u16, u16, Op) {
+    let a = tc.draw(finite_bits(fmt));
+    let b = tc.draw(finite_bits(fmt));
+    let op = tc.draw(generators::sampled_from(vec![Op::Add, Op::Sub, Op::Mul, Op::Div]).print_as_debug());
+    tc.assume(op != Op::Div || b & 0x7FFF != 0);
+    (a, b, op)
+}
+
+/// `+ - * /` on `f16` are correctly rounded (a single rounding of the exact result; computing in
+/// `f32` and rounding once more is fine here because `f32` carries more than 2·11+2 bits).
+#[hegel::test]
+fn f16_arithmetic_is_correctly_rounded(tc: hegel::TestCase) {
+    let (a, b, op) = arith_case(&tc, F16);
+    let (x, y) = (f16::from_bits(a), f16::from_bits(b));
+    let got = match op {
+        Op::Add => x + y,
+        Op::Sub => x - y,
+        Op::Mul => x * y,
+        Op::Div => x / y,
+    };
+    let want = expected_arith(a, b, op, F16);
+    assert_eq!(
+        got.to_bits(), want,
+        "{x} ({a:#06x}) {op:?} {y} ({b:#06x}) = {got} ({:#06x}); exact rounding gives {} ({want:#06x})",
+        got.to_bits(), f16::from_bits(want)
+    );
+}
+
+/// `+ - * /` on `bf16` are correctly rounded.
+#[hegel::test]
+fn bf16_arithmetic_is_correctly_rounded(tc: hegel::TestCase) {
+    let (a, b, op) = arith_case(&tc, BF16);
+    let (x, y) = (bf16::from_bits(a), bf16::from_bits(b));
+    let got = match op {
+        Op::Add => x + y,
+        Op::Sub => x - y,
+        Op::Mul => x * y,
+        Op::Div => x / y,
+    };
+    let want = expected_arith(a, b, op, BF16);
+    assert_eq!(
+        got.to_bits(), want,
+        "{x} ({a:#06x}) {op:?} {y} ({b:#06x}) = {got} ({:#06x}); exact rounding gives {} ({want:#06x})",
+        got.to_bits(), bf16::from_bits(want)
+    );
+}
