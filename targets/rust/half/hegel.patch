+// ---------------------------------------------------------------------------
+// Classification, sign, ordering, formatting
+// ---------------------------------------------------------------------------
+
+fn expected_category(bits: u16, fmt: Format) -> FpCategory {
+    let stored = (fmt.prec - 1) as u16;
+    let exp_mask = 0x7FFF & !((1 << stored) - 1);
+    let frac = bits & ((1 << stored) - 1);
+    match (bits & exp_mask, frac) {
+        (0, 0) => FpCategory::Zero,
+        (0, _) => FpCategory::Subnormal,
+        (e, 0) if e == exp_mask => FpCategory::Infinite,
+        (e, _) if e == exp_mask => FpCategory::Nan,
+        _ => FpCategory::Normal,
+    }
+}
+
+/// `classify`, `is_nan`, `is_infinite`, `is_finite`, `is_normal`, the sign predicates,
+/// `signum` and `copysign` follow the bit pattern (a subnormal `f16` is *subnormal*, even
+/// though it widens to a normal `f32`).
+#[hegel::test]
+fn classification_follows_the_bits(tc: hegel::TestCase) {
+    let b = tc.draw(bits16());
+    let neg = b >> 15 == 1;
+
+    let h = f16::from_bits(b);
+    let cat = expected_category(b, F16);
+    assert_eq!(h.classify(), cat, "f16::classify({b:#06x})");
+    assert_eq!(h.is_nan(), cat == FpCategory::Nan);
+    assert_eq!(h.is_infinite(), cat == FpCategory::Infinite);
+    assert_eq!(h.is_finite(), !matches!(cat, FpCategory::Nan | FpCategory::Infinite));
+    assert_eq!(h.is_normal(), cat == FpCategory::Normal, "f16::is_normal({b:#06x})");
+    assert_eq!(h.is_sign_negative(), neg);
+    assert_eq!(h.is_sign_positive(), !neg);
+    if cat == FpCategory::Nan {
+        assert!(h.signum().is_nan());
+    } else {
+        assert_eq!(h.signum().to_bits(), if neg { f16::NEG_ONE.to_bits() } else { f16::ONE.to_bits() }, "f16::signum({b:#06x})");
+    }
+    let s = tc.draw(bits16());
+    let cs = h.copysign(f16::from_bits(s));
+    assert_eq!(cs.to_bits(), (b & 0x7FFF) | (s & 0x8000), "f16::copysign");
+    assert_eq!((-h).to_bits(), b ^ 0x8000, "f16 negation flips only the sign");
+
+    let g = bf16::from_bits(b);
+    let cat = expected_category(b, BF16);
+    assert_eq!(g.classify(), cat, "bf16::classify({b:#06x})");
+    assert_eq!(g.is_nan(), cat == FpCategory::Nan);
+    assert_eq!(g.is_infinite(), cat == FpCategory::Infinite);
+    assert_eq!(g.is_finite(), !matches!(cat, FpCategory::Nan | FpCategory::Infinite));
+    assert_eq!(g.is_normal(), cat == FpCategory::Normal, "bf16::is_normal({b:#06x})");
+    assert_eq!(g.is_sign_negative(), neg);
+    if cat == FpCategory::Nan {
+        assert!(g.signum().is_nan());
+    } else {
+        assert_eq!(g.signum().to_bits(), if neg { bf16::NEG_ONE.to_bits() } else { bf16::ONE.to_bits() }, "bf16::signum({b:#06x})");
+    }
+    assert_eq!(g.copysign(bf16::from_bits(s)).to_bits(), (b & 0x7FFF) | (s & 0x8000), "bf16::copysign");
+}
+
+/// IEEE 754 totalOrder as an integer key on the bits.
+fn total_order_key(bits: u16) -> i32 {
+    let m = (bits & 0x7FFF) as i32;
+    if bits >> 15 == 1 { -m } else { m }
+}
+
+/// `total_cmp` is IEEE 754's totalOrder (−NaN < −∞ < … < −0 < +0 < … < +∞ < +NaN, NaNs by
+/// payload); `PartialOrd`/`PartialEq` agree with the exact values (NaN unordered, `-0 == +0`);
+/// `max`/`min`/`clamp` follow their documentation (NaN arguments are ignored).
+#[hegel::test]
+fn ordering_matches_values_and_total_order(tc: hegel::TestCase) {
+    let a = tc.draw(bits16());
+    let b = tc.draw(bits16());
+    let (x, y) = (f16::from_bits(a), f16::from_bits(b));
+    assert_eq!(x.total_cmp(&y), total_order_key(a).cmp(&total_order_key(b)), "f16::total_cmp({a:#06x}, {b:#06x})");
+    let (va, vb) = (x.to_f64(), y.to_f64());
+    assert_eq!(x.partial_cmp(&y), va.partial_cmp(&vb), "f16 partial_cmp({a:#06x}, {b:#06x})");
+    assert_eq!(x == y, va == vb, "f16 == ({a:#06x}, {b:#06x})");
+    match (x.is_nan(), y.is_nan()) {
+        (true, true) => assert!(x.max(y).is_nan() && x.min(y).is_nan()),
+        (true, false) => {
+            assert_eq!(x.max(y).to_bits(), b, "max(NaN, y) = y");
+            assert_eq!(x.min(y).to_bits(), b, "min(NaN, y) = y");
+        }
+        (false, true) => {
+            assert_eq!(x.max(y).to_bits(), a, "max(x, NaN) = x");
+            assert_eq!(x.min(y).to_bits(), a, "min(x, NaN) = x");
+        }
+        (false, false) => {
+            assert_eq!(x.max(y).to_f64(), va.max(vb), "f16::max");
+            assert_eq!(x.min(y).to_f64(), va.min(vb), "f16::min");
+            let (lo, hi) = if va <= vb { (x, y) } else { (y, x) };
+            let c = tc.draw(finite_bits(F16));
+            let z = f16::from_bits(c);
+            let clamped = z.clamp(lo, hi);
+            assert_eq!(clamped.to_f64(), z.to_f64().clamp(lo.to_f64(), hi.to_f64()), "f16::clamp");
+        }
+    }
+
+    let (x, y) = (bf16::from_bits(a), bf16::from_bits(b));
+    assert_eq!(x.total_cmp(&y), total_order_key(a).cmp(&total_order_key(b)), "bf16::total_cmp({a:#06x}, {b:#06x})");
+    assert_eq!(x.partial_cmp(&y), x.to_f64().partial_cmp(&y.to_f64()), "bf16 partial_cmp({a:#06x}, {b:#06x})");
+}
+
+/// `Display`, `Debug`, `LowerExp` and `UpperExp` print a decimal that parses back (via
+/// `FromStr`) to the same value, for every finite value and both infinities.
+#[hegel::test]
+fn formatting_round_trips_through_from_str(tc: hegel::TestCase) {
+    let b = tc.draw(bits16());
+    let h = f16::from_bits(b);
+    let g = bf16::from_bits(b);
+    let cmp16 = |name: &str, s: String| {
+        let back: f16 = s.parse().unwrap_or_else(|e| panic!("f16 {name} {s:?} of {b:#06x} does not parse: {e}"));
+        if h.is_nan() {
+            assert!(back.is_nan(), "f16 {name} {s:?} of NaN parses to {back}");
+        } else {
+            assert_eq!(back.to_bits(), b, "f16 {name} {s:?} of {b:#06x} parses back to {:#06x}", back.to_bits());
+        }
+    };
+    cmp16("Display", format!("{h}"));
+    cmp16("Debug", format!("{h:?}"));
+    cmp16("LowerExp", format!("{h:e}"));
+    cmp16("UpperExp", format!("{h:E}"));
+    let cmpb = |name: &str, s: String| {
+        let back: bf16 = s.parse().unwrap_or_else(|e| panic!("bf16 {name} {s:?} of {b:#06x} does not parse: {e}"));
+        if g.is_nan() {
+            assert!(back.is_nan(), "bf16 {name} {s:?} of NaN parses to {back}");
+        } else {
+            assert_eq!(back.to_bits(), b, "bf16 {name} {s:?} of {b:#06x} parses back to {:#06x}", back.to_bits());
+        }
+    };
+    cmpb("Display", format!("{g}"));
+    cmpb("Debug", format!("{g:?}"));
+    cmpb("LowerExp", format!("{g:e}"));
+    cmpb("UpperExp", format!("{g:E}"));
+}
+
+/// `FromStr` rounds a decimal to the nearest `f16`/`bf16`. Two kinds of input: a short random
+/// decimal, whose nearest value the oracle gets by parsing it as `f64` (exact enough: a decimal
+/// of ≤ 12 significant digits is never within an `f64` rounding error of an 11-bit midpoint
+/// without being that midpoint) and rounding once; and a *crafted* decimal — the exact decimal
+/// expansion of a midpoint between two adjacent values (a tie, rounds to even), that expansion
+/// with a `1` appended (just above: rounds up), or the 30-digit expansion of the `f64` just
+/// below it (rounds down) — whose answer is known by construction. Parsing via `f32` first
+/// loses the side information for the crafted inputs.
+#[hegel::test]
+fn from_str_rounds_to_nearest(tc: hegel::TestCase) {
+    let fmt = tc.draw(generators::sampled_from(vec![F16, BF16]));
+    let crafted = tc.draw(generators::booleans());
+    let (s, want): (String, u16) = if crafted {
+        let stored = (fmt.prec - 1) as u16;
+        let inf = ((fmt.emax + fmt.bias + 1) as u16) << stored;
+        let lo = tc.draw(finite_bits(fmt));
+        tc.assume((lo & 0x7FFF) + 1 < inf);
+        let hi = (lo & 0x8000) | ((lo & 0x7FFF) + 1);
+        let mid = (exact_value(lo, fmt) + exact_value(hi, fmt)) / 2.0;
+        // `{:.30}` prints an f64 exactly when it has at most 30 fraction bits… a midpoint of a
+        // normal or subnormal 16-bit value has at most 25 (f16) / 134 (bf16) fraction bits, so
+        // use the number of digits the exact expansion needs, capped for bf16 (any decimal
+        // rounded *towards zero* stays on the same side).
+        let exact = |x: f64| -> String {
+            let neg = x < 0.0;
+            let (_, m, e) = decompose_f64(x);
+            // x = m · 2^e; with e < 0 the exact decimal is m·5^(-e) / 10^(-e).
+            let (int, frac) = if e >= 0 {
+                ((m << e).to_string(), String::new())
+            } else {
+                let digits = (-e) as usize;
+                let mut n = m as u128 * 5u128.pow(digits as u32); // may overflow for tiny bf16
+                let mut f = String::new();
+                for _ in 0..digits {
+                    f.insert(0, char::from(b'0' + (n % 10) as u8));
+                    n /= 10;
+                }
+                (n.to_string(), f)
+            };
+            let mut s = String::new();
+            if neg {
+                s.push('-');
+            }
+            s.push_str(&int);
+            if !frac.is_empty() {
+                s.push('.');
+                s.push_str(&frac);
+            }
+            s
+        };
+        // u128 holds m·5^d only for d ≤ ~27 with m up to 2^53; restrict crafted inputs to that.
+        let (_, _, e) = decompose_f64(mid);
+        tc.assume(e >= -27);
+        let even = if lo & 1 == 0 { lo } else { hi };
+        match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => (exact(mid), even),
+            1 => {
+                let mut s = exact(mid);
+                if !s.contains('.') {
+                    s.push_str(".0");
+                }
+                s.push('1'); // just above the midpoint in magnitude
+                (s, if mid > 0.0 { hi } else { hi })
+            }
+            _ => {
+                let mut s = exact(mid);
+                if !s.contains('.') {
+                    s.push_str(".0");
+                }
+                // Just below the midpoint in magnitude: shave the last digit down by one after
+                // appending a 9: "…d" → "…(d-1)9…"; simpler: append nothing and replace the
+                // last digit d>0 by d-1 followed by "9".
+                let last = s.pop().unwrap();
+                let d = last.to_digit(10).unwrap();
+                if d == 0 {
+                    // ends in 0 (e.g. "2.0"): take one off the next digit is awkward; use the
+                    // tie instead, which also has a known answer.
+                    s.push(last);
+                    (s, even)
+                } else {
+                    s.push(char::from(b'0' + (d - 1) as u8));
+                    s.push('9');
+                    (s, lo)
+                }
+            }
+        }
+    } else {
+        let neg = tc.draw(generators::booleans());
+        let int: u32 = tc.draw(generators::integers::<u32>().max_value(99_999));
+        let frac: Option<u32> = tc.draw(generators::optional(generators::integers::<u32>().max_value(999_999)));
+        let exp: Option<i32> = tc.draw(generators::optional(generators::integers::<i32>().min_value(-9).max_value(6)));
+        let mut s = String::new();
+        if neg {
+            s.push('-');
+        }
+        s.push_str(&int.to_string());
+        if let Some(f) = frac {
+            s.push_str(&format!(".{f:06}"));
+        }
+        if let Some(e) = exp {
+            s.push_str(&format!("e{e}"));
+        }
+        let x: f64 = s.parse().unwrap();
+        (s.clone(), expected_from_f64(x, fmt).unwrap())
+    };
+    if fmt.prec == 11 {
+        let got: f16 = s.parse().unwrap_or_else(|e| panic!("f16::from_str({s:?}): {e}"));
+        assert_eq!(got.to_bits(), want, "f16::from_str({s:?}) = {got} ({:#06x}) but the nearest f16 is {} ({want:#06x})", got.to_bits(), f16::from_bits(want));
+    } else {
+        let got: bf16 = s.parse().unwrap_or_else(|e| panic!("bf16::from_str({s:?}): {e}"));
+        assert_eq!(got.to_bits(), want, "bf16::from_str({s:?}) = {got} ({:#06x}) but the nearest bf16 is {} ({want:#06x})", got.to_bits(), bf16::from_bits(want));
+    }
+}
