+/// The correctly rounded `a·b + c` for finite operands.
+fn expected_mul_add(a: u16, b: u16, c: u16, fmt: Format) -> u16 {
+    let dec = |x: u16| -> (bool, i128, i32) {
+        if x & 0x7FFF == 0 { (x >> 15 == 1, 0, 0) } else { decompose_bits(x, fmt) }
+    };
+    let (na, ma, ea) = dec(a);
+    let (nb, mb, eb) = dec(b);
+    let (nc, mc, ec) = dec(c);
+    let np = na != nb;
+    let sp = if np { -1i128 } else { 1 };
+    let sc = if nc { -1i128 } else { 1 };
+    let (mp, ep) = (ma * mb, ea + eb);
+    if mp == 0 && mc == 0 {
+        // IEEE 754: an exact zero is -0 only when the product and c are both -0.
+        return sign_bit(np && nc);
+    }
+    if mp == 0 {
+        return c;
+    }
+    if mc == 0 {
+        return sign_bit(np) | round_magnitude(mp, 1, ep, fmt);
+    }
+    let (mp, ep, mc, ec) = sticky_align(mp, ep, mc, ec);
+    let e = ep.min(ec);
+    let v = sp * (mp << (ep - e)) + sc * (mc << (ec - e));
+    if v == 0 {
+        return 0; // exact cancellation is +0 in round-to-nearest
+    }
+    sign_bit(v < 0) | round_magnitude(v.abs(), 1, e, fmt)
+}
+
+/// `num_traits::Float::mul_add` is documented as a *fused* multiply-add: "Computes
+/// `(self * a) + b` with only one rounding error". So the result must be the exact `a·b + c`
+/// rounded once to `f16`.
+#[hegel::test]
+fn f16_mul_add_is_fused(tc: hegel::TestCase) {
+    let a = tc.draw(finite_bits(F16));
+    let b = tc.draw(finite_bits(F16));
+    let c = tc.draw(finite_bits(F16));
+    let (x, y, z) = (f16::from_bits(a), f16::from_bits(b), f16::from_bits(c));
+    let got = Float::mul_add(x, y, z);
+    let want = expected_mul_add(a, b, c, F16);
+    assert_eq!(
+        got.to_bits(), want,
+        "({x}).mul_add({y}, {z}) = {got} ({:#06x}); exactly rounded: {} ({want:#06x})",
+        got.to_bits(), f16::from_bits(want)
+    );
+}
+
+/// Same for `bf16`.
+#[hegel::test]
+fn bf16_mul_add_is_fused(tc: hegel::TestCase) {
+    let a = tc.draw(finite_bits(BF16));
+    let b = tc.draw(finite_bits(BF16));
+    let c = tc.draw(finite_bits(BF16));
+    let (x, y, z) = (bf16::from_bits(a), bf16::from_bits(b), bf16::from_bits(c));
+    let got = Float::mul_add(x, y, z);
+    let want = expected_mul_add(a, b, c, BF16);
+    assert_eq!(
+        got.to_bits(), want,
+        "({x}).mul_add({y}, {z}) = {got} ({:#06x}); exactly rounded: {} ({want:#06x})",
+        got.to_bits(), bf16::from_bits(want)
+    );
+}
