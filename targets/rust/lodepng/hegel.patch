+/// `Decoder::inspect` reports the encoded width and height and exactly the
+/// colour type, bit depth and interlace method the encoder was configured
+/// with (evolved from the metadata assertions in test_low_bpp).
+#[hegel::test]
+fn inspect_reports_encoder_metadata(tc: hegel::TestCase) {
+    let (mode, picture, interlace) = tc.draw(tuples!(modes(), pictures(33), booleans()));
+    let png = mode.encoder(interlace).encode(&picture.raw(&mode), picture.width, picture.height).unwrap();
+
+    let mut dec = Decoder::new();
+    let (w, h) = dec.inspect(&png).unwrap();
+    assert_eq!((w, h), (picture.width, picture.height));
+    assert_eq!(dec.info_png().color.colortype(), mode.colortype);
+    assert_eq!(dec.info_png().color.bitdepth(), mode.bitdepth);
+    assert_eq!(dec.info_png().interlace_method, u8::from(interlace));
+}
