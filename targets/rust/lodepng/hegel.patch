+// Property: for every valid non-palette (colortype, bitdepth) combination —
+// including the 1/2/4-bit GREY depths the exhaustive tests above skip — with
+// generated dimensions, interlace mode and filter configuration, encode
+// followed by decode reproduces the raw pixel buffer exactly. Evidence:
+// roundtrip_color above and fuzz/fuzz_targets/reencode24.rs assert the same
+// for the 8/16-bit modes.
+#[hegel::test]
+fn roundtrip_generated_color_config(tc: hegel::TestCase) {
+    let (colortype, bitdepth) = tc.draw((generators::sampled_from(crate::color_configs())).print_as_debug());
+    let width = tc.draw(generators::integers::<usize>().min_value(1).max_value(33));
+    let height = tc.draw(generators::integers::<usize>().min_value(1).max_value(33));
+    let interlace: u8 = tc.draw(generators::integers::<u8>().max_value(1));
+    let raw = crate::draw_raw_pixels(&tc, width, height, colortype, bitdepth);
+
+    let mut enc = crate::configured_encoder(colortype, bitdepth, interlace);
+    crate::configure_filters(&tc, &mut enc, height);
+    let png = enc.encode(&raw, width, height).unwrap();
+
+    let img = lodepng::decode_memory(&png, colortype, bitdepth).unwrap();
+    assert_eq!(img.width(), width);
+    assert_eq!(img.height(), height);
+    assert_eq!(img.bytes(), &raw[..]);
+}
+
+// Property: palette images roundtrip exactly — the packed indices and the
+// palette itself survive encode + decode (color_convert(false)), and decoding
+// to RGBA maps every index through the palette (independent oracle for the
+// palette-expansion path).
+#[hegel::test]
+fn roundtrip_generated_palette(tc: hegel::TestCase) {
+    let bitdepth: u32 = tc.draw(generators::sampled_from(vec![1, 2, 4, 8]));
+    let max_len = 1usize << bitdepth; // 2, 4, 16, 256
+    let pal_len = tc.draw(generators::integers::<usize>().min_value(1).max_value(max_len));
+    let palette: Vec<RGBA> = crate::draw_pixel_bytes(&tc, pal_len * 4)
+        .chunks_exact(4)
+        .map(|c| RGBA::new(c[0], c[1], c[2], c[3]))
+        .collect();
+
+    let width = tc.draw(generators::integers::<usize>().min_value(1).max_value(33));
+    let height = tc.draw(generators::integers::<usize>().min_value(1).max_value(33));
+    let interlace: u8 = tc.draw(generators::integers::<u8>().max_value(1));
+    // indices must stay in range of the palette
+    let indices: Vec<u8> = crate::draw_pixel_bytes(&tc, width * height)
+        .iter()
+        .map(|&v| (v as usize % pal_len) as u8)
+        .collect();
+    let raw = crate::pack_bits(&indices, bitdepth);
+
+    let mut enc = Encoder::new();
+    enc.set_auto_convert(false);
+    enc.set_palette(&palette).unwrap();
+    enc.info_raw_mut().set_bitdepth(bitdepth);
+    enc.info_png_mut().color.set_bitdepth(bitdepth);
+    enc.info_png_mut().interlace_method = interlace;
+    let png = enc.encode(&raw, width, height).unwrap();
+
+    // decode without color conversion: exact index and palette roundtrip
+    let mut dec = Decoder::new();
+    dec.color_convert(false);
+    let img = dec.decode(&png).unwrap();
+    assert_eq!(img.width(), width);
+    assert_eq!(img.height(), height);
+    assert_eq!(img.bytes(), &raw[..]);
+    assert_eq!(dec.info_png().color.palette(), &palette[..]);
+
+    // decode to RGBA: every pixel must be the palette entry its index points to
+    let rgba = lodepng::decode32(&png).unwrap();
+    for (px, &idx) in rgba.buffer.iter().zip(&indices) {
+        assert_eq!(*px, palette[usize::from(idx)]);
+    }
+}
