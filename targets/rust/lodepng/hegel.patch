+use hegel::generators;
+
+use hegel::Generator;
+
+// ---------------------------------------------------------------------------
+// Shared helpers for the hegel property-based tests (also used by
+// roundtrip/roundtrip_test.rs via `crate::`).
+// ---------------------------------------------------------------------------
+
+/// All valid non-palette (colortype, bitdepth) combinations from the PNG spec.
+/// PALETTE is handled separately because decoding back to palette mode needs a
+/// palette in the target color mode.
+pub fn color_configs() -> Vec<(ColorType, u32)> {
+    let mut v = Vec::new();
+    for bd in [1, 2, 4, 8, 16] {
+        v.push((ColorType::GREY, bd));
+    }
+    for bd in [8, 16] {
+        v.push((ColorType::RGB, bd));
+        v.push((ColorType::GREY_ALPHA, bd));
+        v.push((ColorType::RGBA, bd));
+    }
+    v
+}
+
+/// Draw `n` bytes of structured pixel data. PNG filters exploit inter-pixel
+/// correlation, so constants, tiles, gradients and runs exercise the filter
+/// heuristics much harder than uniform noise (which the tiled-chunk mode still
+/// provides for small images).
+pub fn draw_pixel_bytes(tc: &hegel::TestCase, n: usize) -> Vec<u8> {
+    let mode = tc.draw(generators::integers::<u8>().max_value(3));
+    match mode {
+        0 => {
+            // constant image
+            let b = tc.draw(generators::integers::<u8>());
+            vec![b; n]
+        }
+        1 => {
+            // tiled chunk: covers stripes, periodic patterns, and raw noise
+            let chunk: Vec<u8> = tc.draw(
+                generators::vecs(generators::integers::<u8>())
+                    .min_size(1)
+                    .max_size(64),
+            );
+            (0..n).map(|i| chunk[i % chunk.len()]).collect()
+        }
+        2 => {
+            // wrapping gradient
+            let start = tc.draw(generators::integers::<u8>());
+            let step = tc.draw(generators::integers::<u8>());
+            (0..n)
+                .map(|i| start.wrapping_add((i as u8).wrapping_mul(step)))
+                .collect()
+        }
+        _ => {
+            // run-length structured data
+            let runs: Vec<(u8, usize)> = tc.draw(
+                generators::vecs(generators::tuples!(
+                    generators::integers::<u8>(),
+                    generators::integers::<usize>().min_value(1).max_value(32),
+                ))
+                .min_size(1)
+                .max_size(8),
+            );
+            let mut out = Vec::with_capacity(n);
+            'outer: loop {
+                for &(v, len) in &runs {
+                    for _ in 0..len {
+                        if out.len() == n {
+                            break 'outer;
+                        }
+                        out.push(v);
+                    }
+                }
+            }
+            out
+        }
+    }
+}
+
+/// Pack per-pixel sample values (already masked to `bits`) MSB-first into the
+/// continuous bitstream lodepng uses for raw buffers with bitdepth < 8
+/// (no per-scanline padding; only the final byte is zero-padded).
+pub fn pack_bits(values: &[u8], bits: u32) -> Vec<u8> {
+    assert!(matches!(bits, 1 | 2 | 4 | 8));
+    if bits == 8 {
+        return values.to_vec();
+    }
+    let bits = bits as usize;
+    let mut out = vec![0u8; (values.len() * bits + 7) / 8];
+    for (i, &v) in values.iter().enumerate() {
+        let bitpos = i * bits;
+        out[bitpos / 8] |= (v & ((1u16 << bits) - 1) as u8) << (8 - bits - bitpos % 8);
+    }
+    out
+}
+
+/// Draw a raw pixel buffer of exactly `ColorMode::raw_size` bytes for the
+/// given color mode. For bitdepth < 8, per-pixel values are drawn and packed
+/// so the final byte's padding bits stay zero (as the decoder produces them).
+pub fn draw_raw_pixels(tc: &hegel::TestCase, w: usize, h: usize, colortype: ColorType, bitdepth: u32) -> Vec<u8> {
+    let bpp = colortype.bpp(bitdepth) as usize;
+    if bpp >= 8 {
+        draw_pixel_bytes(tc, w * h * bpp / 8)
+    } else {
+        let mask = ((1u16 << bpp) - 1) as u8;
+        let vals: Vec<u8> = draw_pixel_bytes(tc, w * h).iter().map(|v| v & mask).collect();
+        pack_bits(&vals, bitdepth)
+    }
+}
+
+/// Encoder with auto_convert off and identical raw/png color modes.
+pub fn configured_encoder(colortype: ColorType, bitdepth: u32, interlace: u8) -> Encoder {
+    let mut enc = Encoder::new();
+    enc.set_auto_convert(false);
+    enc.info_raw_mut().set_colortype(colortype);
+    enc.info_raw_mut().set_bitdepth(bitdepth);
+    enc.info_png_mut().color.set_colortype(colortype);
+    enc.info_png_mut().color.set_bitdepth(bitdepth);
+    enc.info_png_mut().interlace_method = interlace;
+    enc
+}
+
+/// Draw either a filter strategy or explicit per-scanline predefined filters.
+pub fn configure_filters(tc: &hegel::TestCase, enc: &mut Encoder, height: usize) {
+    if tc.draw(generators::booleans()) {
+        let filters: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>().max_value(4))
+                .min_size(height)
+                .max_size(height),
+        );
+        enc.set_predefined_filters(filters);
+    } else {
+        let strategy = tc.draw((generators::sampled_from(vec![
+            FilterStrategy::ZERO,
+            FilterStrategy::MINSUM,
+            FilterStrategy::ENTROPY,
+            FilterStrategy::BRUTE_FORCE,
+        ])).print_as_debug());
+        let palette_filter_zero = tc.draw(generators::booleans());
+        enc.set_filter_strategy(strategy, palette_filter_zero);
+    }
+}
+
+fn draw_dimension(tc: &hegel::TestCase, max: usize) -> usize {
+    tc.draw(generators::integers::<usize>().min_value(1).max_value(max))
+}
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+
+// Property: decoding a low-bitdepth GREY png to RGBA scales every sample by
+// 255/(2^bd - 1) into all three channels with opaque alpha (independent oracle
+// for the sample-scaling conversion; evolved from test_low_bpp above).
+// For 16-bit input the 8-bit output is the most significant byte.
+#[hegel::test]
+fn grey_decode32_matches_sample_scaling(tc: hegel::TestCase) {
+    let bitdepth: u32 = tc.draw(generators::sampled_from(vec![1, 2, 4, 8, 16]));
+    let width = draw_dimension(&tc, 33);
+    let height = draw_dimension(&tc, 33);
+    let interlace: u8 = tc.draw(generators::integers::<u8>().max_value(1));
+    let n = width * height;
+
+    let (raw, expected): (Vec<u8>, Vec<u8>) = if bitdepth == 16 {
+        // big-endian 16-bit samples; 16->8 conversion keeps the MSB
+        let bytes = draw_pixel_bytes(&tc, n * 2);
+        let expected = bytes.iter().step_by(2).copied().collect();
+        (bytes, expected)
+    } else {
+        let mask = ((1u16 << bitdepth) - 1) as u8;
+        let factor = (255 / u16::from(mask)) as u8; // 255, 85, 17, 1
+        let vals: Vec<u8> = draw_pixel_bytes(&tc, n).iter().map(|v| v & mask).collect();
+        let expected = vals.iter().map(|&v| v * factor).collect();
+        (pack_bits(&vals, bitdepth), expected)
+    };
+
+    let enc = configured_encoder(ColorType::GREY, bitdepth, interlace);
+    let png = enc.encode(&raw, width, height).unwrap();
+    let img = decode32(&png).unwrap();
+    assert_eq!(img.width, width);
+    assert_eq!(img.height, height);
+    for (px, &e) in img.buffer.iter().zip(&expected) {
+        assert_eq!(*px, RGBA::new(e, e, e, 255));
+    }
+}
+
+// Property: encoding RGBA with auto_convert (the default) is lossless no
+// matter which output mode the encoder picks (grey / palette / color-key /
+// rgb / grey-alpha). Evidence: docs describe auto_convert as picking the
+// smallest mode that can represent the image exactly; bgr/low_bpp tests rely
+// on the same.
+#[hegel::test]
+fn auto_convert_encode_is_lossless(tc: hegel::TestCase) {
+    let width = draw_dimension(&tc, 32);
+    let height = draw_dimension(&tc, 32);
+    let n = width * height;
+    // Bias pixel shapes so different auto-chosen output modes are hit:
+    // arbitrary, opaque, greyscale, grey+alpha, binary transparency (color key).
+    let shape = tc.draw(generators::integers::<u8>().max_value(4));
+    let bytes = draw_pixel_bytes(&tc, n * 4);
+    let pixels: Vec<RGBA> = bytes
+        .chunks_exact(4)
+        .map(|c| match shape {
+            0 => RGBA::new(c[0], c[1], c[2], c[3]),
+            1 => RGBA::new(c[0], c[1], c[2], 255),
+            2 => RGBA::new(c[0], c[0], c[0], 255),
+            3 => RGBA::new(c[0], c[0], c[0], c[1]),
+            _ => RGBA::new(c[0], c[1], c[2], if c[3] & 1 == 0 { 0 } else { 255 }),
+        })
+        .collect();
+
+    let mut enc = Encoder::new();
+    enc.set_auto_convert(true);
+    enc.info_raw_mut().set_colortype(ColorType::RGBA);
+    enc.info_raw_mut().set_bitdepth(8);
+    let png = enc.encode(&pixels, width, height).unwrap();
+
+    let img = decode32(&png).unwrap();
+    assert_eq!(img.width, width);
+    assert_eq!(img.height, height);
+    assert_eq!(pixels, img.buffer);
+}
+
+// Property: the decoder returns an error (never panics, never aborts) on
+// arbitrary bytes, including inputs that start with a valid PNG signature or
+// a valid signature+IHDR. PNG decoders are a classic fuzz target and this
+// crate is a port of C code.
+#[hegel::test]
+fn decode_arbitrary_bytes_never_panics(tc: hegel::TestCase) {
+    let (colortype, bitdepth) = tc.draw((generators::sampled_from(color_configs())).print_as_debug());
+    let mut data = match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => Vec::new(),
+        1 => b"\x89PNG\r\n\x1a\n".to_vec(),
+        _ => {
+            // valid signature + IHDR of a real 1x1 png, then garbage
+            let valid = encode_memory(&[0u8], 1, 1, ColorType::GREY, 8).unwrap();
+            valid[..33].to_vec()
+        }
+    };
+    data.extend_from_slice(&tc.draw(generators::binary().max_size(300)));
+    drop(decode_memory(&data, colortype, bitdepth));
+}
+
+// Property: corrupting bytes of a valid PNG must never make the default
+// decoder panic or abort. The CRC check rejects a corrupt header before any
+// image-sized allocation, so this exercises the inflate/unfilter/conversion
+// code on damaged payloads and must always return an error, never crash.
+#[hegel::test]
+fn decode_corrupted_png_never_panics(tc: hegel::TestCase) {
+    let (colortype, bitdepth) = tc.draw((generators::sampled_from(color_configs())).print_as_debug());
+    let width = draw_dimension(&tc, 16);
+    let height = draw_dimension(&tc, 16);
+    let interlace: u8 = tc.draw(generators::integers::<u8>().max_value(1));
+    let raw = draw_raw_pixels(&tc, width, height, colortype, bitdepth);
+    let enc = configured_encoder(colortype, bitdepth, interlace);
+    let mut png = enc.encode(&raw, width, height).unwrap();
+
+    let mutations: Vec<(usize, u8)> = tc.draw(
+        generators::vecs(generators::tuples!(
+            generators::integers::<usize>(),
+            generators::integers::<u8>(),
+        ))
+        .min_size(1)
+        .max_size(8),
+    );
+    for &(pos, val) in &mutations {
+        let len = png.len();
+        png[pos % len] = val;
+    }
+
+    drop(decode_memory(&png, colortype, bitdepth));
+}
