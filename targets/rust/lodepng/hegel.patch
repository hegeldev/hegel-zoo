+/// Every strict prefix of a valid PNG is rejected with an error: the IEND
+/// chunk can never be complete in a strict prefix, and the decoder requires it
+/// (rustimpl.rs returns error 52 when IEND is missing). The cut is drawn as a
+/// position taken modulo the PNG's length.
+#[hegel::test]
+fn decode_truncated_png_errors(tc: hegel::TestCase) {
+    let (mode, picture, cut) = tc.draw(tuples!(modes(), pictures(16), integers::<usize>()));
+    let png = mode.encoder(false).encode(&picture.raw(&mode), picture.width, picture.height).unwrap();
+
+    let cut = cut % png.len();
+    let result = decode_memory(&png[..cut], mode.colortype, mode.bitdepth);
+    assert!(result.is_err(), "decoding a {}-byte prefix of a {}-byte png succeeded", cut, png.len());
+}
