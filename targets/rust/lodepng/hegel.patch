+use hegel::generators::{self, binary, booleans, integers, sampled_from, vecs, Generator, Integer, IntegerGenerator, SampledFromGenerator};
+use hegel::{one_of, tuples, PrettyPrintable, PrintableGenerator};
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests. Every generator is a value built from the
+// binding's combinators; what a case needs is drawn as a small record (a
+// colour mode, a picture, a filter choice, a list of corruptions) and rendered
+// by pure functions, so a failing case prints as the record rather than as a
+// transcript of draws. The records and generators are shared with
+// roundtrip/roundtrip_test.rs through `crate::`.
+// ---------------------------------------------------------------------------
+
+fn ints<T: Integer>(lo: T, hi: T) -> IntegerGenerator<T> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// A PNG colour mode: colour type and bit depth.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PrettyPrintable)]
+pub struct Mode {
+    #[pretty(debug)]
+    pub colortype: ColorType,
+    pub bitdepth: u32,
+}
+
+impl Mode {
+    pub const fn new(colortype: ColorType, bitdepth: u32) -> Mode {
+        Mode { colortype, bitdepth }
+    }
+
+    /// Bits per pixel.
+    pub fn bpp(&self) -> usize {
+        self.colortype.bpp(self.bitdepth) as usize
+    }
+
+    /// An encoder with auto_convert off and this mode on both the raw and the
+    /// PNG side.
+    pub fn encoder(&self, interlace: bool) -> Encoder {
+        let mut enc = Encoder::new();
+        enc.set_auto_convert(false);
+        enc.info_raw_mut().set_colortype(self.colortype);
+        enc.info_raw_mut().set_bitdepth(self.bitdepth);
+        enc.info_png_mut().color.set_colortype(self.colortype);
+        enc.info_png_mut().color.set_bitdepth(self.bitdepth);
+        enc.info_png_mut().interlace_method = u8::from(interlace);
+        enc
+    }
+}
+
+/// Every valid non-palette mode of the PNG spec, GREY 8 first (no bit
+/// packing: the plainest, so the shrink target). PALETTE is handled
+/// separately (`roundtrip_generated_palette`) because decoding back to
+/// palette mode needs a palette in the target colour mode.
+pub const MODES: &[Mode] = &[
+    Mode::new(ColorType::GREY, 8),
+    Mode::new(ColorType::GREY, 1),
+    Mode::new(ColorType::GREY, 2),
+    Mode::new(ColorType::GREY, 4),
+    Mode::new(ColorType::GREY, 16),
+    Mode::new(ColorType::RGB, 8),
+    Mode::new(ColorType::GREY_ALPHA, 8),
+    Mode::new(ColorType::RGBA, 8),
+    Mode::new(ColorType::RGB, 16),
+    Mode::new(ColorType::GREY_ALPHA, 16),
+    Mode::new(ColorType::RGBA, 16),
+];
+
+/// The modes the free `encode_*` functions (which always auto-convert) decode
+/// back to unconditionally: a grey mode with bitdepth != 8 is only supported
+/// when the PNG's mode matches exactly (the error 56 guard in rustimpl.rs
+/// `lodepng_decode`).
+pub const CONVERTIBLE_MODES: &[Mode] = &[
+    Mode::new(ColorType::GREY, 8),
+    Mode::new(ColorType::GREY_ALPHA, 8),
+    Mode::new(ColorType::RGB, 8),
+    Mode::new(ColorType::RGB, 16),
+    Mode::new(ColorType::RGBA, 8),
+    Mode::new(ColorType::RGBA, 16),
+];
+
+pub fn modes() -> SampledFromGenerator<'static, Mode> {
+    sampled_from(MODES)
+}
+
+/// A run of `len` bytes of `value`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PrettyPrintable)]
+pub struct Run {
+    pub value: u8,
+    pub len: usize,
+}
+
+/// The structure of a pixel buffer, rendered to any length by `bytes`. PNG
+/// filters exploit inter-pixel correlation, so constants, tiles, gradients
+/// and runs exercise the filter heuristics much harder than uniform noise
+/// (which a tile of up to 64 arbitrary bytes still provides for small
+/// images).
+#[derive(Debug, Clone, PartialEq, Eq, PrettyPrintable)]
+pub enum Pixels {
+    /// Every byte the same.
+    Constant(u8),
+    /// A chunk of one to 64 bytes repeated: stripes, periodic patterns, raw
+    /// noise.
+    Tiled(Vec<u8>),
+    /// A wrapping gradient, `start + i * step`.
+    Gradient { start: u8, step: u8 },
+    /// Runs of one to 32 bytes each, repeated in order.
+    Runs(Vec<Run>),
+}
+
+impl Pixels {
+    /// The first `n` bytes of the structure.
+    pub fn bytes(&self, n: usize) -> Vec<u8> {
+        match self {
+            Pixels::Constant(b) => vec![*b; n],
+            Pixels::Tiled(chunk) => (0..n).map(|i| chunk[i % chunk.len()]).collect(),
+            Pixels::Gradient { start, step } => (0..n).map(|i| start.wrapping_add((i as u8).wrapping_mul(*step))).collect(),
+            Pixels::Runs(runs) => runs.iter().cycle().flat_map(|run| std::iter::repeat(run.value).take(run.len)).take(n).collect(),
+        }
+    }
+}
+
+/// A pixel structure: a constant (first, the shrink target), a tile, a
+/// gradient or runs.
+pub fn pixels() -> impl PrintableGenerator<Pixels> {
+    one_of!(
+        integers::<u8>().map(Pixels::Constant),
+        vecs(integers::<u8>()).min_size(1).max_size(64).map(Pixels::Tiled),
+        tuples!(integers::<u8>(), integers::<u8>()).map(|(start, step)| Pixels::Gradient { start, step }),
+        vecs(tuples!(integers::<u8>(), ints(1usize, 32)).map(|(value, len)| Run { value, len }))
+            .min_size(1)
+            .max_size(8)
+            .map(Pixels::Runs),
+    )
+}
+
+/// Pack per-pixel sample values (already masked to `bits`) MSB-first into the
+/// continuous bitstream lodepng uses for raw buffers with bitdepth < 8
+/// (no per-scanline padding; only the final byte is zero-padded).
+pub fn pack_bits(values: &[u8], bits: u32) -> Vec<u8> {
+    assert!(matches!(bits, 1 | 2 | 4 | 8));
+    if bits == 8 {
+        return values.to_vec();
+    }
+    let bits = bits as usize;
+    let mut out = vec![0u8; (values.len() * bits + 7) / 8];
+    for (i, &v) in values.iter().enumerate() {
+        let bitpos = i * bits;
+        out[bitpos / 8] |= (v & ((1u16 << bits) - 1) as u8) << (8 - bits - bitpos % 8);
+    }
+    out
+}
+
+/// An image to encode: its dimensions and the structure of its pixels.
+#[derive(Debug, Clone, PartialEq, Eq, PrettyPrintable)]
+pub struct Picture {
+    pub width: usize,
+    pub height: usize,
+    pub pixels: Pixels,
+}
+
+impl Picture {
+    /// The number of pixels.
+    pub fn len(&self) -> usize {
+        self.width * self.height
+    }
+
+    /// The raw buffer of exactly `ColorMode::raw_size` bytes for `mode`. For
+    /// bitdepth < 8 the per-pixel values are masked and packed so the final
+    /// byte's padding bits stay zero (as the decoder produces them).
+    pub fn raw(&self, mode: &Mode) -> Vec<u8> {
+        let bpp = mode.bpp();
+        if bpp >= 8 {
+            self.pixels.bytes(self.len() * bpp / 8)
+        } else {
+            let mask = ((1u16 << bpp) - 1) as u8;
+            let values: Vec<u8> = self.pixels.bytes(self.len()).iter().map(|v| v & mask).collect();
+            pack_bits(&values, mode.bitdepth)
+        }
+    }
+}
+
+/// A picture of 1 to `max` pixels a side.
+pub fn pictures(max: usize) -> impl PrintableGenerator<Picture> {
+    tuples!(ints(1usize, max), ints(1usize, max), pixels()).map(|(width, height, pixels)| Picture { width, height, pixels })
+}
+
+/// How the encoder chooses its scanline filters: a strategy (first; ZERO the
+/// plainest) or a tape of predefined filter types recycled over the
+/// scanlines.
+#[derive(Debug, Clone, PartialEq, Eq, PrettyPrintable)]
+pub enum Filters {
+    Strategy {
+        #[pretty(debug)]
+        strategy: FilterStrategy,
+        palette_filter_zero: bool,
+    },
+    Predefined(Vec<u8>),
+}
+
+impl Filters {
+    /// Configures `enc` for an image of `height` scanlines.
+    pub fn configure(&self, enc: &mut Encoder, height: usize) {
+        match self {
+            Filters::Strategy { strategy, palette_filter_zero } => enc.set_filter_strategy(*strategy, *palette_filter_zero),
+            Filters::Predefined(tape) => enc.set_predefined_filters((0..height).map(|i| tape[i % tape.len()]).collect::<Vec<u8>>()),
+        }
+    }
+}
+
+const STRATEGIES: &[FilterStrategy] = &[FilterStrategy::ZERO, FilterStrategy::MINSUM, FilterStrategy::ENTROPY, FilterStrategy::BRUTE_FORCE];
+
+pub fn filters() -> impl PrintableGenerator<Filters> {
+    one_of!(
+        tuples!(sampled_from(STRATEGIES).print_as_debug(), booleans())
+            .map(|(strategy, palette_filter_zero)| Filters::Strategy { strategy, palette_filter_zero }),
+        vecs(ints(0u8, 4)).min_size(1).max_size(33).map(Filters::Predefined),
+    )
+}
+
+/// One byte of a PNG overwritten: `pos` is taken modulo the PNG's length.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PrettyPrintable)]
+pub struct Poke {
+    pub pos: usize,
+    pub val: u8,
+}
+
+/// One to eight overwritten bytes.
+fn pokes() -> impl PrintableGenerator<Vec<Poke>> {
+    vecs(tuples!(integers::<usize>(), integers::<u8>()).map(|(pos, val)| Poke { pos, val }))
+        .min_size(1)
+        .max_size(8)
+}
+
+/// `png` with every poke applied in order.
+fn corrupted(png: &[u8], pokes: &[Poke]) -> Vec<u8> {
+    let mut png = png.to_vec();
+    for poke in pokes {
+        let len = png.len();
+        png[poke.pos % len] = poke.val;
+    }
+    png
+}
+
+/// What arbitrary bytes start with: nothing (first), the PNG signature, or
+/// the signature and IHDR of a real 1x1 PNG.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PrettyPrintable)]
+pub enum Prefix {
+    Empty,
+    Signature,
+    SignatureAndIhdr,
+}
+
+const PREFIXES: &[Prefix] = &[Prefix::Empty, Prefix::Signature, Prefix::SignatureAndIhdr];
+
+/// Arbitrary bytes behind a PNG-shaped prefix.
+#[derive(Debug, Clone, PartialEq, Eq, PrettyPrintable)]
+pub struct Junk {
+    pub prefix: Prefix,
+    pub tail: Vec<u8>,
+}
+
+impl Junk {
+    pub fn bytes(&self) -> Vec<u8> {
+        let mut data = match self.prefix {
+            Prefix::Empty => Vec::new(),
+            Prefix::Signature => b"\x89PNG\r\n\x1a\n".to_vec(),
+            Prefix::SignatureAndIhdr => {
+                // signature + IHDR of a real 1x1 GREY-8 png: its first 33 bytes
+                let valid = encode_memory(&[0u8], 1, 1, ColorType::GREY, 8).unwrap();
+                valid[..33].to_vec()
+            }
+        };
+        data.extend_from_slice(&self.tail);
+        data
+    }
+}
+
+/// Up to 300 arbitrary bytes: the length is drawn first and the bytes filled
+/// to it, since `binary().max_size(300)` alone stays under 50 bytes in
+/// practically every case (measured: 100% of 2000).
+fn tails() -> impl PrintableGenerator<Vec<u8>> {
+    ints(0usize, 300).flat_map(|n| binary().min_size(n).max_size(n))
+}
+
+fn junk() -> impl PrintableGenerator<Junk> {
+    tuples!(sampled_from(PREFIXES), tails()).map(|(prefix, tail)| Junk { prefix, tail })
+}
+
+/// The colour shape of an RGBA picture, biased so that every output mode
+/// auto_convert can pick is hit: arbitrary pixels (first), opaque, greyscale,
+/// grey with alpha, binary transparency (a colour key).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PrettyPrintable)]
+pub enum Shape {
+    Any,
+    Opaque,
+    Grey,
+    GreyAlpha,
+    ColorKey,
+}
+
+const SHAPES: &[Shape] = &[Shape::Any, Shape::Opaque, Shape::Grey, Shape::GreyAlpha, Shape::ColorKey];
+
+impl Shape {
+    /// The RGBA pixel made of four structure bytes.
+    fn pixel(&self, c: &[u8]) -> RGBA {
+        match self {
+            Shape::Any => RGBA::new(c[0], c[1], c[2], c[3]),
+            Shape::Opaque => RGBA::new(c[0], c[1], c[2], 255),
+            Shape::Grey => RGBA::new(c[0], c[0], c[0], 255),
+            Shape::GreyAlpha => RGBA::new(c[0], c[0], c[0], c[1]),
+            Shape::ColorKey => RGBA::new(c[0], c[1], c[2], if c[3] & 1 == 0 { 0 } else { 255 }),
+        }
+    }
+
+    /// The RGBA pixels of `picture` in this shape.
+    fn pixels(&self, picture: &Picture) -> Vec<RGBA> {
+        picture.pixels.bytes(picture.len() * 4).chunks_exact(4).map(|c| self.pixel(c)).collect()
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Properties
+// ---------------------------------------------------------------------------
+
+/// The GREY bit depths, 8 first (no bit packing).
+const GREY_DEPTHS: &[u32] = &[8, 1, 2, 4, 16];
+
+/// Decoding a GREY PNG of any bit depth to RGBA puts every sample, scaled by
+/// 255/(2^depth - 1) (for 16-bit samples the most significant byte), into all
+/// three channels with opaque alpha - an independent oracle for the
+/// sample-scaling conversion (evolved from test_low_bpp).
+#[hegel::test]
+fn grey_decode32_matches_sample_scaling(tc: hegel::TestCase) {
+    let (bitdepth, picture, interlace) = tc.draw(tuples!(sampled_from(GREY_DEPTHS), pictures(33), booleans()));
+    let n = picture.len();
+
+    let (raw, expected): (Vec<u8>, Vec<u8>) = if bitdepth == 16 {
+        // big-endian 16-bit samples; 16->8 conversion keeps the MSB
+        let bytes = picture.pixels.bytes(n * 2);
+        let expected = bytes.iter().step_by(2).copied().collect();
+        (bytes, expected)
+    } else {
+        let mask = ((1u16 << bitdepth) - 1) as u8;
+        let factor = (255 / u16::from(mask)) as u8; // 255, 85, 17, 1
+        let vals: Vec<u8> = picture.pixels.bytes(n).iter().map(|v| v & mask).collect();
+        let expected = vals.iter().map(|&v| v * factor).collect();
+        (pack_bits(&vals, bitdepth), expected)
+    };
+
+    let enc = Mode::new(ColorType::GREY, bitdepth).encoder(interlace);
+    let png = enc.encode(&raw, picture.width, picture.height).unwrap();
+    let img = decode32(&png).unwrap();
+    assert_eq!(img.width, picture.width);
+    assert_eq!(img.height, picture.height);
+    for (px, &e) in img.buffer.iter().zip(&expected) {
+        assert_eq!(*px, RGBA::new(e, e, e, 255));
+    }
+}
+
+/// Encoding RGBA pixels with auto_convert (the default) is lossless whatever
+/// output mode the encoder picks (grey, palette, colour key, RGB, grey with
+/// alpha): the docs describe auto_convert as picking the smallest mode that
+/// represents the image exactly, and the bgr/low_bpp tests rely on the same.
+#[hegel::test]
+fn auto_convert_encode_is_lossless(tc: hegel::TestCase) {
+    let (shape, picture) = tc.draw(tuples!(sampled_from(SHAPES), pictures(32)));
+    let pixels = shape.pixels(&picture);
+
+    let mut enc = Encoder::new();
+    enc.set_auto_convert(true);
+    enc.info_raw_mut().set_colortype(ColorType::RGBA);
+    enc.info_raw_mut().set_bitdepth(8);
+    let png = enc.encode(&pixels, picture.width, picture.height).unwrap();
+
+    let img = decode32(&png).unwrap();
+    assert_eq!(img.width, picture.width);
+    assert_eq!(img.height, picture.height);
+    assert_eq!(pixels, img.buffer);
+}
+
+/// The decoder returns an error (never panics, never aborts) on arbitrary
+/// bytes, including inputs that start with a valid PNG signature or a valid
+/// signature and IHDR: PNG decoders are a classic fuzz target and this crate
+/// is a port of C code.
+#[hegel::test]
+fn decode_arbitrary_bytes_never_panics(tc: hegel::TestCase) {
+    let (mode, junk) = tc.draw(tuples!(modes(), junk()));
+    drop(decode_memory(&junk.bytes(), mode.colortype, mode.bitdepth));
+}
+
+/// Overwriting bytes of a valid PNG never makes the default decoder panic or
+/// abort: the CRC check rejects a corrupt header before any image-sized
+/// allocation, so this exercises the inflate/unfilter/conversion code on
+/// damaged payloads, which must return an error rather than crash.
+#[hegel::test]
+fn decode_corrupted_png_never_panics(tc: hegel::TestCase) {
+    let (mode, picture, interlace, pokes) = tc.draw(tuples!(modes(), pictures(16), booleans(), pokes()));
+    let png = mode.encoder(interlace).encode(&picture.raw(&mode), picture.width, picture.height).unwrap();
+    drop(decode_memory(&corrupted(&png, &pokes), mode.colortype, mode.bitdepth));
+}
+
+// KNOWN FAILURE (process abort — kept #[ignore]d so it never runs in the
+// suite; running it OOM-kills the whole test binary).
+//
+// A corrupt IHDR that declares huge dimensions makes the decoder attempt an
+// image-sized buffer allocation. On the CRC-checked default path this is
+// rejected at the IHDR checksum, but with `ignore_crc = true` the oversized
+// header reaches decode_generic. The crate deliberately uses
+// `try_reserve_exact` there to fail such allocations gracefully (and it DOES
+// return Error 83 when a hard limit is in force, e.g. `ulimit -v`), but under
+// Linux memory overcommit the reservation succeeds and the subsequent
+// zero-fill (`Vec::resize(size, 0)`) touches every page, so the process is
+// OOM-killed instead of returning an error.
+//
+// Reproducer: a valid 1x1 RGBA-16 PNG whose IHDR width/height are overwritten
+// with 0xFFFF each (~4.3e9 pixels x 8 bytes ~= 34 GiB) and decoded with CRC
+// checking disabled. Deterministic — no randomness. The assertion is what the
+// decoder *should* do (return an error); under overcommit it never gets there.
+#[test]
+#[ignore = "OOM-kills the process under Linux overcommit; see comment"]
+fn decode_ignore_crc_oversized_header_ooms() {
+    // Valid 1x1 RGBA 16-bit PNG.
