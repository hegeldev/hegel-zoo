+// KNOWN FAILURE (process abort — kept #[ignore]d so it never runs in the
+// suite; running it OOM-kills the whole test binary).
+//
+// A corrupt IHDR that declares huge dimensions makes the decoder attempt an
+// image-sized buffer allocation. On the CRC-checked default path this is
+// rejected at the IHDR checksum, but with `ignore_crc = true` the oversized
+// header reaches decode_generic. The crate deliberately uses
+// `try_reserve_exact` there to fail such allocations gracefully (and it DOES
+// return Error 83 when a hard limit is in force, e.g. `ulimit -v`), but under
+// Linux memory overcommit the reservation succeeds and the subsequent
+// zero-fill (`Vec::resize(size, 0)`) touches every page, so the process is
+// OOM-killed instead of returning an error.
+//
+// Reproducer: a valid 1x1 RGBA-16 PNG whose IHDR width/height are overwritten
+// with 0xFFFF each (~4.3e9 pixels x 8 bytes ~= 34 GiB) and decoded with CRC
+// checking disabled. Deterministic — no randomness. The assertion is what the
+// decoder *should* do (return an error); under overcommit it never gets there.
+#[test]
+#[ignore = "OOM-kills the process under Linux overcommit; see comment"]
+fn decode_ignore_crc_oversized_header_ooms() {
+    // Valid 1x1 RGBA 16-bit PNG.
+    let mut png = encode_memory(&[0u16, 0, 0, 0], 1, 1, ColorType::RGBA, 16).unwrap();
+    // Overwrite IHDR width (bytes 16..20) and height (bytes 20..24) with 0xFFFF.
+    png[16..24].copy_from_slice(&[0x00, 0x00, 0xFF, 0xFF, 0x00, 0x00, 0xFF, 0xFF]);
+
+    #[allow(deprecated)]
+    let mut state = lodepng::State::default();
+    state.decoder.ignore_crc = true;
+    #[allow(deprecated)]
+    let result = state.decode(&png);
+    // Correct behaviour would be a graceful error; the bug is that this line is
+    // never reached because the process is OOM-killed first.
+    assert!(result.is_err(), "expected an error for an oversized corrupt header");
+}
+
+// Property: any strict prefix of a valid PNG is rejected with an error (the
+// IEND chunk can never be complete in a strict prefix, and the decoder
+// requires it — rustimpl.rs returns error 52 when IEND is missing).
+#[hegel::test]
+fn decode_truncated_png_errors(tc: hegel::TestCase) {
+    let (colortype, bitdepth) = tc.draw((generators::sampled_from(color_configs())).print_as_debug());
+    let width = draw_dimension(&tc, 16);
+    let height = draw_dimension(&tc, 16);
+    let raw = draw_raw_pixels(&tc, width, height, colortype, bitdepth);
+    let enc = configured_encoder(colortype, bitdepth, 0);
+    let png = enc.encode(&raw, width, height).unwrap();
+
+    let cut = tc.draw(generators::integers::<usize>().max_value(png.len() - 1));
+    let result = decode_memory(&png[..cut], colortype, bitdepth);
+    assert!(result.is_err(), "decoding a {}-byte prefix of a {}-byte png succeeded", cut, png.len());
+}
