+use hegel::generators::{just, sampled_from, Generator};
+use hegel::{tuples, PrettyPrintable, PrintableGenerator};
+
+use crate::{filters, modes, pictures, pixels, Filters, Mode, Picture, Pixels};
+
+/// Encoding then decoding with auto_convert off, in every valid non-palette
+/// colour mode (the 1/2/4-bit GREY depths the exhaustive tests above skip
+/// included), with either interlacing and any filter choice, reproduces the
+/// raw pixel buffer exactly. Evidence: roundtrip_color above and
+/// fuzz/fuzz_targets/reencode24.rs assert the same for the 8/16-bit modes.
+#[hegel::test]
+fn roundtrip_generated_color_config(tc: hegel::TestCase) {
+    let (mode, picture, interlace, filters): (Mode, Picture, bool, Filters) =
+        tc.draw(tuples!(modes(), pictures(33), hegel::generators::booleans(), filters()));
+    let raw = picture.raw(&mode);
+
+    let mut enc = mode.encoder(interlace);
+    filters.configure(&mut enc, picture.height);
+    let png = enc.encode(&raw, picture.width, picture.height).unwrap();
+
+    let img = lodepng::decode_memory(&png, mode.colortype, mode.bitdepth).unwrap();
+    assert_eq!(img.width(), picture.width);
+    assert_eq!(img.height(), picture.height);
+    assert_eq!(img.bytes(), &raw[..]);
+}
+
+/// A palette image: the bit depth of its indices, one to 2^depth palette
+/// entries whose RGBA bytes come from a pixel structure (so duplicates are
+/// common), and a picture whose pixel bytes, taken modulo the number of
+/// entries, are the indices.
+#[derive(Debug, Clone, PartialEq, Eq, PrettyPrintable)]
+struct PaletteImage {
+    bitdepth: u32,
+    entries: usize,
+    palette: Pixels,
+    picture: Picture,
+    interlace: bool,
+}
+
+impl PaletteImage {
+    fn palette(&self) -> Vec<RGBA> {
+        self.palette.bytes(self.entries * 4).chunks_exact(4).map(|c| RGBA::new(c[0], c[1], c[2], c[3])).collect()
+    }
+
+    /// One index per pixel, in range of the palette.
+    fn indices(&self) -> Vec<u8> {
+        self.picture.pixels.bytes(self.picture.len()).iter().map(|&v| (v as usize % self.entries) as u8).collect()
+    }
+
+    /// The indices packed at the bit depth.
+    fn raw(&self) -> Vec<u8> {
+        crate::pack_bits(&self.indices(), self.bitdepth)
+    }
+}
+
+/// The palette bit depths, 8 first (no bit packing).
+const PALETTE_DEPTHS: &[u32] = &[8, 1, 2, 4];
+
+/// A palette image of 1 to 33 pixels a side; the number of entries depends on
+/// the depth, hence the `flat_map`.
+fn palette_images() -> impl PrintableGenerator<PaletteImage> {
+    sampled_from(PALETTE_DEPTHS)
+        .flat_map(|bitdepth| {
+            let max_entries = 1usize << bitdepth; // 2, 4, 16, 256
+            tuples!(
+                just(bitdepth),
+                hegel::generators::integers::<usize>().min_value(1).max_value(max_entries),
+                pixels(),
+                pictures(33),
+                hegel::generators::booleans()
+            )
+        })
+        .map(|(bitdepth, entries, palette, picture, interlace)| PaletteImage { bitdepth, entries, palette, picture, interlace })
+}
+
+/// Palette images round-trip exactly: the packed indices and the palette
+/// itself survive encode + decode with color_convert(false), and decoding to
+/// RGBA maps every index through the palette (an independent oracle for the
+/// palette-expansion path).
+#[hegel::test]
+fn roundtrip_generated_palette(tc: hegel::TestCase) {
+    let image = tc.draw(palette_images());
+    let palette = image.palette();
+    let indices = image.indices();
+    let raw = image.raw();
+    let (width, height) = (image.picture.width, image.picture.height);
+
+    let mut enc = Encoder::new();
+    enc.set_auto_convert(false);
+    enc.set_palette(&palette).unwrap();
+    enc.info_raw_mut().set_bitdepth(image.bitdepth);
+    enc.info_png_mut().color.set_bitdepth(image.bitdepth);
+    enc.info_png_mut().interlace_method = u8::from(image.interlace);
+    let png = enc.encode(&raw, width, height).unwrap();
+
+    // decode without color conversion: exact index and palette roundtrip
+    let mut dec = Decoder::new();
+    dec.color_convert(false);
+    let img = dec.decode(&png).unwrap();
+    assert_eq!(img.width(), width);
+    assert_eq!(img.height(), height);
+    assert_eq!(img.bytes(), &raw[..]);
+    assert_eq!(dec.info_png().color.palette(), &palette[..]);
+
+    // decode to RGBA: every pixel must be the palette entry its index points to
+    let rgba = lodepng::decode32(&png).unwrap();
+    for (px, &idx) in rgba.buffer.iter().zip(&indices) {
+        assert_eq!(*px, palette[usize::from(idx)]);
+    }
+}
