+// Property: the file-based convenience API agrees with the in-memory API:
+// encode_file + decode_file through a real file produce the same image as
+// encode_memory + decode_memory, and both reproduce the raw pixels.
+//
+// The free encode functions always auto-convert, so the PNG's color mode can
+// differ from the input mode. Decoding back to a grey mode with bitdepth != 8
+// is only supported when the modes match exactly (error 56 guard in
+// rustimpl.rs lodepng_decode), so this property draws only from the modes the
+// converter supports unconditionally.
+#[hegel::test]
+fn file_and_memory_apis_agree(tc: hegel::TestCase) {
+    let (colortype, bitdepth) = tc.draw((generators::sampled_from(vec![
+        (ColorType::GREY, 8),
+        (ColorType::GREY_ALPHA, 8),
+        (ColorType::RGB, 8),
+        (ColorType::RGB, 16),
+        (ColorType::RGBA, 8),
+        (ColorType::RGBA, 16),
+    ])).print_as_debug());
+    let width = draw_dimension(&tc, 24);
+    let height = draw_dimension(&tc, 24);
+    let raw = draw_raw_pixels(&tc, width, height, colortype, bitdepth);
+
+    let path = std::path::Path::new(env!("CARGO_TARGET_TMPDIR"))
+        .join(format!("hegel-file-vs-memory-{}.png", std::process::id()));
+
+    let png_mem = encode_memory(&raw, width, height, colortype, bitdepth).unwrap();
+    encode_file(&path, &raw, width, height, colortype, bitdepth).unwrap();
+
+    let img_mem = decode_memory(&png_mem, colortype, bitdepth).unwrap();
+    let img_file = decode_file(&path, colortype, bitdepth).unwrap();
+    std::fs::remove_file(&path).ok();
+
+    assert_eq!((img_mem.width(), img_mem.height()), (width, height));
+    assert_eq!((img_file.width(), img_file.height()), (width, height));
+    assert_eq!(img_mem.bytes(), img_file.bytes());
+    assert_eq!(img_mem.bytes(), &raw[..]);
+}
