+#[hegel::test]
+fn inspect_reports_encoder_metadata(tc: hegel::TestCase) {
+    let (colortype, bitdepth) = tc.draw((generators::sampled_from(color_configs())).print_as_debug());
+    let width = draw_dimension(&tc, 33);
+    let height = draw_dimension(&tc, 33);
+    let interlace: u8 = tc.draw(generators::integers::<u8>().max_value(1));
+    let raw = draw_raw_pixels(&tc, width, height, colortype, bitdepth);
