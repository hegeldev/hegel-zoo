+/// The file-based convenience API agrees with the in-memory API: encode_file
+/// + decode_file through a real file produce the same image as encode_memory
+/// + decode_memory, and both reproduce the raw pixels. The free encode
+/// functions always auto-convert, so only the modes the converter decodes
+/// back to unconditionally are drawn (`CONVERTIBLE_MODES`).
+#[hegel::test]
+fn file_and_memory_apis_agree(tc: hegel::TestCase) {
+    let (mode, picture) = tc.draw(tuples!(sampled_from(CONVERTIBLE_MODES), pictures(24)));
+    let raw = picture.raw(&mode);
+    let (width, height) = (picture.width, picture.height);
+
+    let path = std::path::Path::new(env!("CARGO_TARGET_TMPDIR"))
+        .join(format!("hegel-file-vs-memory-{}.png", std::process::id()));
+
+    let png_mem = encode_memory(&raw, width, height, mode.colortype, mode.bitdepth).unwrap();
+    encode_file(&path, &raw, width, height, mode.colortype, mode.bitdepth).unwrap();
+
+    let img_mem = decode_memory(&png_mem, mode.colortype, mode.bitdepth).unwrap();
+    let img_file = decode_file(&path, mode.colortype, mode.bitdepth).unwrap();
+    std::fs::remove_file(&path).ok();
+
+    assert_eq!((img_mem.width(), img_mem.height()), (width, height));
+    assert_eq!((img_file.width(), img_file.height()), (width, height));
+    assert_eq!(img_mem.bytes(), img_file.bytes());
+    assert_eq!(img_mem.bytes(), &raw[..]);
+}
