+/// What the `semver::Version` builder must produce from a call sequence: additional numbers
+/// become leading build identifiers; pre-release and build texts are sanitized the documented
+/// way (illegal characters to `-`, leading zeros of numeric pre-release identifiers dropped,
+/// empty identifiers dropped).
+fn semver_of(calls: &[Call]) -> semver::Version {
+    let mut v = semver::Version::new(0, 0, 0);
+    let mut build: Vec<String> = Vec::new();
+    for c in calls {
+        match c {
+            Call::Major(m) => v.major = *m,
+            Call::Minor(m) => v.minor = *m,
+            Call::Patch(m) => v.patch = *m,
+            Call::Add(n) => build.push(n.to_string()),
+            Call::Pre(p) => {
+                let mut idents: Vec<String> = p
+                    .split('.')
+                    .filter(|s| !s.is_empty())
+                    .map(|s| {
+                        if s.len() > 1 && s.starts_with('0') && s.bytes().all(|b| b.is_ascii_digit()) {
+                            let t = s.trim_start_matches('0');
+                            if t.is_empty() { "0".to_string() } else { t.to_string() }
+                        } else {
+                            s.to_string()
+                        }
+                    })
+                    .collect();
+                idents.retain(|s| !s.is_empty());
+                v.pre = semver::Prerelease::new(&idents.join(".")).unwrap();
+            }
+            Call::Build(b) => build.extend(b.split('.').filter(|s| !s.is_empty()).map(str::to_string)),
+        }
+    }
+    v.build = semver::BuildMetadata::new(&build.join(".")).unwrap();
+    v
+}
