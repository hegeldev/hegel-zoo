+#[hegel::test]
+fn release_identifiers_may_be_followed_by_build_metadata(tc: hegel::TestCase) {
+    // `1.2.3-Final` is documented to be `1.2.3+Final`; semver allows build metadata after any
+    // pre-release, so `1.2.3-Final+sha` (which `semver` accepts) should be `1.2.3+Final.sha`
+    let release = tc.draw(generators::sampled_from(vec!["Final", "final", "FINAL", "Release", "release", "RELEASE", "r", "fInAl"]));
+    let sep = tc.draw(generators::sampled_from(vec!["-", "."]));
+    let build = tc.draw(generators::sampled_from(vec!["sha", "1", "abc.5", "2022-11-30"]));
+    let text = format!("{}.{}.{}{sep}{release}+{build}", tc.draw(int!(0u64, 99)), tc.draw(int!(0u64, 99)), tc.draw(int!(0u64, 99)));
+    assert!(refuses_release_build(&text));
+    if sep == "-" {
+        assert!(semver::Version::parse(&text).is_ok(), "{text:?} is strict semver");
+    }
+    let expected = model(&text);
+    assert!(expected.is_ok());
+    let got = parser::parse::<Rec>(&text).map_err(|e| error_triple(&e));
+    assert_eq!(got, expected, "{text:?}");
+    let sv = lenient_semver::parse(&text).unwrap();
+    assert_eq!(sv.build.as_str(), format!("{release}.{build}"), "{text:?}");
+    let (partial, rest) = parser::parse_partial::<semver::Version>(&text).unwrap();
+    assert_eq!((partial, rest), (sv, ""));
+}
