+#[hegel::test]
+fn lenient_versions_order_like_semver_where_both_apply(tc: hegel::TestCase) {
+    // no additional numbers, pre-release identifiers without hyphens: the two orderings coincide
+    let mut versions = Vec::new();
+    for _ in 0..tc.draw(int!(2usize, 6)) {
+        let mut v = strict(&tc.draw(arb_semver()));
+        if v.pre.as_str().contains('-') {
+            v.pre = semver::Prerelease::new(&v.pre.as_str().replace('-', "")).unwrap();
+        }
+        versions.push(v);
+    }
+    let texts: Vec<String> = versions.iter().map(|v| v.to_string()).collect();
+    let lvs: Vec<LVersion> = texts.iter().map(|t| LVersion::parse(t).unwrap()).collect();
+    for i in 0..lvs.len() {
+        for j in 0..lvs.len() {
+            // semver 1.x compares build metadata too; lenient ignores it: compare without build
+            let mut a = versions[i].clone();
+            let mut b = versions[j].clone();
+            a.build = semver::BuildMetadata::EMPTY;
+            b.build = semver::BuildMetadata::EMPTY;
+            assert_eq!(lvs[i].cmp(&lvs[j]), a.cmp(&b), "{} vs {}", texts[i], texts[j]);
+            assert_eq!(lvs[i] == lvs[j], a == b);
+        }
+    }
+    // bumps
+    let mut lv = lvs[0].clone();
+    let (major, minor, patch) = (lv.major, lv.minor, lv.patch);
+    if major < u64::MAX {
+        lv.bump_major();
+        assert_eq!((lv.major, lv.minor, lv.patch), (major + 1, 0, 0));
+        assert!(!lv.is_pre_release() && lv.build.is_empty() && lv.pre.is_empty());
+    }
+    let mut lv = lvs[0].clone();
+    if minor < u64::MAX {
+        lv.bump_minor();
+        assert_eq!((lv.major, lv.minor, lv.patch), (major, minor + 1, 0));
+    }
+    let mut lv = lvs[0].clone();
+    if patch < u64::MAX {
+        lv.bump_patch();
+        assert_eq!((lv.major, lv.minor, lv.patch), (major, minor, patch + 1));
+        assert_eq!(lv, lvs[0].bumped_patch());
+    }
+}
