+#[hegel::test]
+fn strict_texts_parse_as_semver_does(tc: hegel::TestCase) {
+    let text = tc.draw(arb_semver());
+    let v = strict(&text);
+    assert_eq!(semver::Version::parse(&text).unwrap(), v);
+    assert_eq!(lenient_semver::parse(&text), Ok(v.clone()), "{text:?}");
+    // with the documented decorations
+    let decorated = format!("{}{}{}{}", WS[tc.draw(int!(0usize, WS.len() - 1))], if tc.draw(generators::booleans()) { "v" } else { "V" }, text, WS[tc.draw(int!(0usize, WS.len() - 1))]);
+    assert_eq!(lenient_semver::parse(&decorated), Ok(v.clone()), "{decorated:?}");
+    // the lenient version type reads and prints it back
+    let lv = LVersion::parse(&text).unwrap();
+    assert_eq!(lv.to_string(), text);
+    assert_eq!(semver::Version::from(lv.clone()), v);
+    assert_eq!(lv.is_pre_release(), !v.pre.is_empty());
+    assert_eq!(lv.major, v.major);
+    assert_eq!(lv.minor, v.minor);
+    assert_eq!(lv.patch, v.patch);
+    // strict texts without minor/patch are the documented shorthand
+    let short = format!("{}", v.major);
+    assert_eq!(lenient_semver::parse(&short), Ok(semver::Version::new(v.major, 0, 0)));
+    let short = format!("{}.{}", v.major, v.minor);
+    assert_eq!(lenient_semver::parse(&short), Ok(semver::Version::new(v.major, v.minor, 0)));
+}
