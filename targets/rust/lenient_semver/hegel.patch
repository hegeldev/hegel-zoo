+#[hegel::test]
+fn a_second_plus_in_the_build_metadata_is_an_error(tc: hegel::TestCase) {
+    // build metadata is dot-separated identifiers of letters, digits and `-`; a `+` inside it
+    // is unexpected input (as `semver` and the grammar say), not a reason to drop the build
+    let first = tc.draw(generators::sampled_from(vec!["build", "1", "sha.abc", "2022-11-30", "0"]));
+    let second = tc.draw(generators::sampled_from(vec!["rest", "2", "", "a.b", "+"]));
+    let tail = tc.draw(generators::sampled_from(vec!["", " ", " x"]));
+    let mut text = format!("{}.{}.{}", tc.draw(int!(0u64, 99)), tc.draw(int!(0u64, 99)), tc.draw(int!(0u64, 99)));
+    if tc.draw(generators::booleans()) {
+        text.push_str("-pre");
+    }
+    text.push_str(&format!("+{first}+{second}{tail}"));
+    assert!(drops_build_at_second_plus(&text));
+    let expected = model(&text);
+    let plus = text.find(&format!("+{first}+")).unwrap() + 1 + first.len();
+    assert_eq!(expected, Err((ErrorKind::UnexpectedInput, plus, plus + 1)));
+    let got = parser::parse::<Rec>(&text).map_err(|e| error_triple(&e));
+    assert_eq!(got, expected, "{text:?}: {:?}", lenient_semver::parse(&text).map(|v| v.to_string()));
+    // partial mode: the version with its build, then the rest from the second `+`
+    let got = parser::parse_partial::<Rec>(&text).map_err(|e| error_triple(&e));
+    assert_eq!(got, model_partial(&text), "{text:?}");
+}
