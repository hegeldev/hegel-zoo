+#[hegel::test]
+fn partial_parsing_walks_a_list_of_versions(tc: hegel::TestCase) {
+    let k = tc.draw(int!(1usize, 5));
+    let versions: Vec<semver::Version> = (0..k).map(|_| strict(&tc.draw(arb_semver()))).collect();
+    let mut text = String::new();
+    for (i, v) in versions.iter().enumerate() {
+        if i > 0 {
+            text.push_str(WS[tc.draw(int!(0usize, WS.len() - 1))]);
+        }
+        text.push_str(&v.to_string());
+    }
+    let tail = tc.draw(generators::sampled_from(vec!["", " // end", ", tail"]));
+    text.push_str(tail);
+    let mut rest: &str = &text;
+    for v in &versions {
+        let (parsed, remainder) = parser::parse_partial::<semver::Version>(rest).unwrap_or_else(|e| panic!("{rest:?}: {e}"));
+        assert_eq!(&parsed, v, "in {text:?}");
+        rest = remainder;
+    }
+    assert_eq!(rest, tail.trim_start(), "remainder of {text:?}");
+    if !rest.is_empty() {
+        let e = parser::parse_partial::<semver::Version>(rest).unwrap_err();
+        assert_eq!(e.error_kind(), ErrorKind::UnexpectedInput);
+    } else {
+        let e = parser::parse_partial::<semver::Version>(rest).unwrap_err();
+        assert_eq!(e.error_kind(), ErrorKind::MissingMajorNumber);
+    }
+}
