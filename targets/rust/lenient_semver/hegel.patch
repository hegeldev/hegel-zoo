+//! Hegel properties for lenient_semver.
+//!
+//! Oracles: (1) the `semver` crate's own parser for strict texts — a lenient parser must agree
+//! with the strict one wherever the strict one accepts; (2) a second implementation of the
+//! documented lenient grammar (the crate's DFA rewritten as plain recursive code, recording the
+//! `VersionBuilder` calls and the error kind/span), for arbitrary texts and for `parse_partial`;
+//! (3) `lenient_version::Version`'s own `Display`, ordering, serde and `semver` conversion
+//! checked for consistency with the parser and with `semver`.
+#![allow(clippy::all, dead_code)]
+
+use hegel::generators;
+use lenient_semver::parser::{self, ErrorKind, VersionBuilder};
+use lenient_semver::Version as LVersion;
+use semver_v100 as semver;
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+// --------------------------------------------------------------------------- recording builder
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Call {
+    Major(u64),
+    Minor(u64),
+    Patch(u64),
+    Add(u64),
+    Pre(String),
+    Build(String),
+}
+
+#[derive(Debug, Default)]
+struct Rec(Vec<Call>);
+
+impl<'input> VersionBuilder<'input> for Rec {
+    type Out = Vec<Call>;
+    fn new() -> Self {
+        Rec::default()
+    }
+    fn set_major(&mut self, major: u64) {
+        self.0.push(Call::Major(major));
+    }
+    fn set_minor(&mut self, minor: u64) {
+        self.0.push(Call::Minor(minor));
+    }
+    fn set_patch(&mut self, patch: u64) {
+        self.0.push(Call::Patch(patch));
+    }
+    fn add_additional(&mut self, num: u64) {
+        self.0.push(Call::Add(num));
+    }
+    fn add_pre_release(&mut self, pre_release: &'input str) {
+        self.0.push(Call::Pre(pre_release.to_string()));
+    }
+    fn add_build(&mut self, build: &'input str) {
+        self.0.push(Call::Build(build.to_string()));
+    }
+    fn build(self) -> Self::Out {
+        self.0
+    }
+}
+
+// --------------------------------------------------------------------------- the model
+
+type ModelError = (ErrorKind, usize, usize);
+
+/// Where the model is when an error happens: what `parse_partial` commits and how far the
+/// remainder is pushed back.
+#[derive(Debug, Clone, Copy, PartialEq)]
+enum Where {
+    /// before or inside the major number (errors are kept by `parse_partial`)
+    Major,
+    /// after a separator, expecting a segment (the separator is given back)
+    Expect,
+    /// inside a numeric segment for `slot` (1 minor, 2 patch, 3+ additional), from `start`
+    Number { slot: usize, start: usize },
+    /// inside a pre-release identifier from `start`
+    Pre { start: usize },
+    /// inside a build identifier from `start`
+    Build { start: usize },
+    /// after the version (trailing whitespace)
+    Done,
+}
+
+struct Model<'a> {
+    input: &'a str,
+    b: &'a [u8],
+    extra_alpha: bool,
+    calls: Vec<Call>,
+    /// a release identifier (`Final`, `r`, …) in pre-release position was followed by `+`
+    release_then_build: bool,
+    /// a second `+` inside the build metadata
+    plus_in_build: bool,
+}
+
+fn is_ws(c: u8) -> bool {
+    matches!(c, b'\t' | b'\n' | b'\x0C' | b'\r' | b' ')
+}
+
+fn is_release_identifier(v: &str) -> bool {
+    v == "r" || v.eq_ignore_ascii_case("final") || v.eq_ignore_ascii_case("release")
+}
+
+fn char_len(c: u8) -> usize {
+    if c < 0x80 { 1 } else if c >> 5 == 0b110 { 2 } else if c >> 4 == 0b1110 { 3 } else { 4 }
+}
+
+impl<'a> Model<'a> {
+    fn alpha(&self, c: u8) -> bool {
+        c.is_ascii_alphabetic() || (self.extra_alpha && (c == b'*' || c == b'?'))
+    }
+    fn ident_char(&self, c: u8) -> bool {
+        c.is_ascii_digit() || self.alpha(c) || c == b'.' || c == b'-'
+    }
+    fn unexpected(&self, i: usize) -> Result<(), (ModelError, Where)> {
+        Err(((ErrorKind::UnexpectedInput, i, i + char_len(self.b[i])), Where::Done))
+    }
+
+    /// Run the grammar; `Err` carries the error and where the parser was.
+    fn run(&mut self) -> Result<(), (ModelError, Where)> {
+        let n = self.b.len();
+        let mut i = 0;
+        while i < n && is_ws(self.b[i]) {
+            i += 1;
+        }
+        if i == n {
+            return Err(((ErrorKind::MissingMajorNumber, n, n), Where::Major));
+        }
+        if self.b[i] == b'v' || self.b[i] == b'V' {
+            i += 1;
+            if i == n {
+                return Err(((ErrorKind::MissingMajorNumber, n, n), Where::Major));
+            }
+        }
+        if !self.b[i].is_ascii_digit() {
+            return Err(((ErrorKind::UnexpectedInput, i, i + char_len(self.b[i])), Where::Major));
+        }
+        let start = i;
+        while i < n && self.b[i].is_ascii_digit() {
+            i += 1;
+        }
+        match self.input[start..i].parse::<u64>() {
+            Ok(m) => self.calls.push(Call::Major(m)),
+            Err(_) => return Err(((ErrorKind::NumberOverflow, start, i), Where::Major)),
+        }
+        if i < n && !(is_ws(self.b[i]) || matches!(self.b[i], b'.' | b'-' | b'+')) {
+            return self.unexpected(i);
+        }
+        let mut slot = 1usize;
+        loop {
+            if i == n || is_ws(self.b[i]) {
+                return self.trailing(i);
+            }
+            match self.b[i] {
+                b'.' => {
+                    i += 1;
+                    let missing = match slot { 1 => ErrorKind::MissingMinorNumber, 2 => ErrorKind::MissingPatchNumber, _ => ErrorKind::MissingPreRelease };
+                    if i == n {
+                        return Err(((missing, n, n), Where::Expect));
+                    }
+                    if !(self.b[i].is_ascii_digit() || self.alpha(self.b[i])) {
+                        return Err(((ErrorKind::UnexpectedInput, i, i + char_len(self.b[i])), Where::Expect));
+                    }
+                    let start = i;
+                    while i < n && self.b[i].is_ascii_digit() {
+                        i += 1;
+                    }
+                    if i < n && self.alpha(self.b[i]) {
+                        return self.pre(start, i);
+                    }
+                    if i < n && !(is_ws(self.b[i]) || matches!(self.b[i], b'.' | b'-' | b'+')) {
+                        return Err(((ErrorKind::UnexpectedInput, i, i + char_len(self.b[i])), Where::Number { slot, start }));
+                    }
+                    match self.input[start..i].parse::<u64>() {
+                        Ok(num) => {
+                            self.calls.push(match slot { 1 => Call::Minor(num), 2 => Call::Patch(num), _ => Call::Add(num) });
+                            slot += 1;
+                        }
+                        // the documented rule: a number that overflows u64 is a string, i.e. a
+                        // pre-release identifier running on from here
+                        Err(_) => return self.pre(start, i),
+                    }
+                }
+                b'-' => {
+                    i += 1;
+                    if i == n {
+                        return Err(((ErrorKind::MissingPreRelease, n, n), Where::Expect));
+                    }
+                    if !(self.b[i].is_ascii_digit() || self.alpha(self.b[i])) {
+                        return Err(((ErrorKind::UnexpectedInput, i, i + char_len(self.b[i])), Where::Expect));
+                    }
+                    return self.pre(i, i);
+                }
+                b'+' => {
+                    i += 1;
+                    return self.build(i);
+                }
+                _ => return self.unexpected(i),
+            }
+        }
+    }
+
+    /// A pre-release identifier from `start`, already scanned up to `i`.
+    fn pre(&mut self, start: usize, mut i: usize) -> Result<(), (ModelError, Where)> {
+        let n = self.b.len();
+        while i < n && self.ident_char(self.b[i]) {
+            i += 1;
+        }
+        if i < n && !(is_ws(self.b[i]) || self.b[i] == b'+') {
+            return Err(((ErrorKind::UnexpectedInput, i, i + char_len(self.b[i])), Where::Pre { start }));
+        }
+        let seg = &self.input[start..i];
+        if is_release_identifier(seg) {
+            if i < n && self.b[i] == b'+' {
+                // lenient_semver/2: the crate refuses the build that follows
+                self.release_then_build = true;
+            }
+            self.calls.push(Call::Build(seg.to_string()));
+        } else {
+            self.calls.push(Call::Pre(seg.to_string()));
+        }
+        if i < n && self.b[i] == b'+' {
+            return self.build(i + 1);
+        }
+        self.trailing(i)
+    }
+
+    /// A build identifier starting at `i` (just after the `+`).
+    fn build(&mut self, mut i: usize) -> Result<(), (ModelError, Where)> {
+        let n = self.b.len();
+        if i == n {
+            return Err(((ErrorKind::MissingBuild, n, n), Where::Expect));
+        }
+        if !(self.b[i].is_ascii_digit() || self.alpha(self.b[i])) {
+            return Err(((ErrorKind::UnexpectedInput, i, i + char_len(self.b[i])), Where::Expect));
+        }
+        let start = i;
+        while i < n && self.ident_char(self.b[i]) {
+            i += 1;
+        }
+        if i < n && !is_ws(self.b[i]) {
+            if self.b[i] == b'+' {
+                // lenient_semver/3: the crate drops the whole build instead
+                self.plus_in_build = true;
+            }
+            return Err(((ErrorKind::UnexpectedInput, i, i + char_len(self.b[i])), Where::Build { start }));
+        }
+        self.calls.push(Call::Build(self.input[start..i].to_string()));
+        self.trailing(i)
+    }
+
+    fn trailing(&mut self, mut i: usize) -> Result<(), (ModelError, Where)> {
+        let n = self.b.len();
+        while i < n && is_ws(self.b[i]) {
+            i += 1;
+        }
+        if i < n {
+            return self.unexpected(i);
+        }
+        Ok(())
+    }
+}
+
+fn new_model(input: &str, extra_alpha: bool) -> Model<'_> {
+    Model { input, b: input.as_bytes(), extra_alpha, calls: Vec::new(), release_then_build: false, plus_in_build: false }
+}
+
+fn model(input: &str) -> Result<Vec<Call>, ModelError> {
+    let mut m = new_model(input, false);
+    match m.run() {
+        Ok(()) => Ok(m.calls),
+        Err((e, _)) => Err(e),
+    }
+}
+
+/// lenient_semver/2: `1.2.3-Final+sha` (a valid semver text) is refused with "Unexpected `+`"
+/// by deliberate code, in both modes.
+fn refuses_release_build(input: &str) -> bool {
+    let mut m = new_model(input, true);
+    let _ = m.run();
+    m.release_then_build
+}
+
+/// lenient_semver/3: `1.2.3+build+rest` parses as `1.2.3` — a second `+` drops the build.
+fn drops_build_at_second_plus(input: &str) -> bool {
+    let mut m = new_model(input, true);
+    let _ = m.run();
+    m.plus_in_build
+}
+
+/// The general properties leave the inputs of the pinned bugs to their tests.
+fn hits_known_bug(input: &str) -> bool {
+    drops_overflow(input) || refuses_release_build(input) || drops_build_at_second_plus(input)
+}
+
+/// `parse_partial`: errors before or inside the major number are kept; any other error ends
+/// the version, the segment being read is committed, and the rest of the input (from the
+/// offending character, or from the separator when a segment was expected) is returned.
+fn model_partial(input: &str) -> Result<(Vec<Call>, &str), ModelError> {
+    let mut m = new_model(input, true);
+    match m.run() {
+        Ok(()) => Ok((m.calls, "")),
+        Err((e, Where::Major)) => Err(e),
+        Err(((_, start, _), at)) => {
+            match at {
+                Where::Number { slot, start: s } => {
+                    let seg = &input[s..start];
+                    match seg.parse::<u64>() {
+                        Ok(num) => m.calls.push(match slot { 1 => Call::Minor(num), 2 => Call::Patch(num), _ => Call::Add(num) }),
+                        Err(_) => m.calls.push(Call::Pre(seg.to_string())),
+                    }
+                }
+                Where::Pre { start: s } => {
+                    let seg = &input[s..start];
+                    if is_release_identifier(seg) { m.calls.push(Call::Build(seg.to_string())) } else { m.calls.push(Call::Pre(seg.to_string())) }
+                }
+                Where::Build { start: s } => m.calls.push(Call::Build(input[s..start].to_string())),
+                _ => {}
+            }
+            let rest = if at == Where::Expect { start - 1 } else { start };
+            Ok((m.calls, &input[rest..]))
+        }
+    }
+}
+
+/// lenient_semver/1: a numeric segment that overflows `u64` is documented to be kept as a
+/// string, and is — unless whitespace or `+` follows it, when it is silently dropped
+/// (`1.99999999999999999999 ` is `1.0.0`). The general properties leave those inputs to the
+/// pinned test.
+fn drops_overflow(text: &str) -> bool {
+    let b = text.as_bytes();
+    let mut i = 0;
+    while i < b.len() && (is_ws(b[i]) || b[i] == b'v' || b[i] == b'V') {
+        i += 1;
+    }
+    while i < b.len() && b[i].is_ascii_digit() {
+        i += 1;
+    }
+    while i < b.len() && b[i] == b'.' {
+        i += 1;
+        let start = i;
+        while i < b.len() && b[i].is_ascii_digit() {
+            i += 1;
+        }
+        if start == i || (i < b.len() && !(is_ws(b[i]) || matches!(b[i], b'.' | b'-' | b'+'))) {
+            return false;
+        }
+        if text[start..i].parse::<u64>().is_err() {
+            return i < b.len() && (is_ws(b[i]) || b[i] == b'+');
+        }
+    }
+    false
+}
+
+// --------------------------------------------------------------------------- generators
+
+const WORDS: [&str; 14] = ["a", "rc", "alpha", "beta", "M1", "x", "Final", "final", "FINAL", "Release", "RELEASE", "r", "R", "SNAPSHOT"];
+const JUNK: [&str; 10] = [",", "*", "?", "🙈", "/", "|", "=", "~", "^", "ä"];
+const WS: [&str; 5] = [" ", "  ", "\t", "\n", " \r\n "];
+
+#[hegel::composite]
+fn arb_number_text(tc: &hegel::TestCase) -> String {
+    match tc.draw(int!(0u8, 5)) {
+        0 => "0".to_string(),
+        1 => format!("0{}", tc.draw(int!(0u32, 99))),
+        2 => "99999999999999999999".to_string(), // > u64::MAX
+        3 => u64::MAX.to_string(),
+        _ => tc.draw(int!(0u64, 5000)).to_string(),
+    }
+}
+
+/// A token soup, a structured lenient version, or a strict semver text — with a `v` and
+/// whitespace sprinkled in.
+#[hegel::composite]
+fn arb_text(tc: &hegel::TestCase) -> String {
+    let mut s = String::new();
+    if tc.draw(int!(0u8, 3)) == 0 {
+        s.push_str(WS[tc.draw(int!(0usize, WS.len() - 1))]);
+    }
+    if tc.draw(int!(0u8, 3)) == 0 {
+        s.push(if tc.draw(generators::booleans()) { 'v' } else { 'V' });
+    }
+    match tc.draw(int!(0u8, 2)) {
+        0 => {
+            let k = tc.draw(int!(1usize, 8));
+            for _ in 0..k {
+                match tc.draw(int!(0u8, 9)) {
+                    0 | 1 | 2 => s.push_str(&tc.draw(arb_number_text())),
+                    3 | 4 => s.push_str(WORDS[tc.draw(int!(0usize, WORDS.len() - 1))]),
+                    5 => s.push('.'),
+                    6 => s.push('-'),
+                    7 => s.push('+'),
+                    8 => s.push_str(WS[tc.draw(int!(0usize, WS.len() - 1))]),
+                    _ => s.push_str(JUNK[tc.draw(int!(0usize, JUNK.len() - 1))]),
+                }
+            }
+        }
+        1 => {
+            s.push_str(&tc.draw(arb_number_text()));
+            let segs = tc.draw(int!(0usize, 4));
+            for _ in 0..segs {
+                s.push('.');
+                if tc.draw(int!(0u8, 3)) == 0 {
+                    s.push_str(WORDS[tc.draw(int!(0usize, WORDS.len() - 1))]);
+                } else {
+                    s.push_str(&tc.draw(arb_number_text()));
+                }
+            }
+            if tc.draw(generators::booleans()) {
+                s.push('-');
+                s.push_str(&tc.draw(arb_identifiers()));
+            }
+            if tc.draw(generators::booleans()) {
+                s.push('+');
+                s.push_str(&tc.draw(arb_identifiers()));
+            }
+        }
+        _ => s.push_str(&tc.draw(arb_semver())),
+    }
+    if tc.draw(int!(0u8, 3)) == 0 {
+        s.push_str(WS[tc.draw(int!(0usize, WS.len() - 1))]);
+    }
+    if tc.draw(int!(0u8, 7)) == 0 {
+        s.push_str(JUNK[tc.draw(int!(0usize, JUNK.len() - 1))]);
+    }
+    s
+}
+
+/// Dot/hyphen-joined identifiers (letters, digits, words), possibly empty pieces.
+#[hegel::composite]
+fn arb_identifiers(tc: &hegel::TestCase) -> String {
+    let k = tc.draw(int!(1usize, 3));
+    let mut s = String::new();
+    for j in 0..k {
+        if j > 0 {
+            s.push(if tc.draw(generators::booleans()) { '.' } else { '-' });
+        }
+        match tc.draw(int!(0u8, 3)) {
+            0 => s.push_str(WORDS[tc.draw(int!(0usize, WORDS.len() - 1))]),
+            1 => s.push_str(&tc.draw(arb_number_text())),
+            2 => s.push_str(&format!("{}{}", WORDS[tc.draw(int!(0usize, WORDS.len() - 1))], tc.draw(int!(0u32, 99)))),
+            _ => {}
+        }
+    }
+    s
+}
+
+/// A strict `semver::Version`, as its text (the type is foreign, so it is drawn as a string).
+#[hegel::composite]
+fn arb_semver(tc: &hegel::TestCase) -> String {
+    let num = |tc: &hegel::TestCase| -> u64 {
+        match tc.draw(int!(0u8, 3)) {
+            0 => tc.draw(int!(0u64, u64::MAX)),
+            _ => tc.draw(int!(0u64, 300)),
+        }
+    };
+    let mut v = semver::Version::new(num(tc), num(tc), num(tc));
+    let ident = |tc: &hegel::TestCase| -> String {
+        match tc.draw(int!(0u8, 3)) {
+            0 => tc.draw(int!(0u64, 99999)).to_string(),
+            1 => WORDS[tc.draw(int!(0usize, WORDS.len() - 1))].to_string(),
+            2 => format!("{}-{}", WORDS[tc.draw(int!(0usize, WORDS.len() - 1))], tc.draw(int!(0u32, 9))),
+            _ => format!("{}{}", WORDS[tc.draw(int!(0usize, WORDS.len() - 1))], tc.draw(int!(0u32, 9))),
+        }
+    };
+    if tc.draw(generators::booleans()) {
+        let k = tc.draw(int!(1usize, 3));
+        let mut pre: Vec<String> = (0..k).map(|_| ident(tc)).collect();
+        if is_release_identifier(&pre[0]) && k == 1 {
+            // documented: `1.2.3-Final` is `1.2.3+Final` for the lenient parser
+            pre.push("0".to_string());
+        }
+        v.pre = semver::Prerelease::new(&pre.join(".")).unwrap();
+    }
+    if tc.draw(generators::booleans()) {
+        let k = tc.draw(int!(1usize, 3));
+        let build: Vec<String> = (0..k).map(|_| match tc.draw(int!(0u8, 2)) { 0 => format!("0{}", tc.draw(int!(0u32, 99))), _ => ident(tc) }).collect();
+        v.build = semver::BuildMetadata::new(&build.join(".")).unwrap();
+    }
+    v.to_string()
+}
+
+fn strict(text: &str) -> semver::Version {
+    semver::Version::parse(text).unwrap()
+}
+
+// --------------------------------------------------------------------------- properties
+
+fn error_triple(e: &parser::Error<'_>) -> ModelError {
+    let span = e.error_span();
+    (e.error_kind(), span.start, span.end)
+}
+
+#[hegel::test]
+fn the_parser_agrees_with_the_model(tc: hegel::TestCase) {
+    let text = tc.draw(arb_text());
+    if hits_known_bug(&text) {
+        return; // lenient_semver/1–3
+    }
+    let got = parser::parse::<Rec>(&text).map_err(|e| error_triple(&e));
+    let expected = model(&text);
+    assert_eq!(got, expected, "parse of {text:?}");
+    // the facade forwards
+    assert_eq!(lenient_semver::parse_into::<Rec>(&text).map_err(|e| error_triple(&e)), expected);
+}
+
+#[hegel::test]
+fn partial_parsing_agrees_with_the_model(tc: hegel::TestCase) {
+    let text = tc.draw(arb_text());
+    if hits_known_bug(&text) {
+        return; // lenient_semver/1–3
+    }
+    let got = parser::parse_partial::<Rec>(&text).map_err(|e| error_triple(&e));
+    let expected = model_partial(&text);
+    assert_eq!(got, expected, "parse_partial of {text:?}");
+    // a complete parse is a partial parse with nothing left
+    if let Ok(calls) = model(&text) {
+        assert_eq!(got, Ok((calls, "")));
+    }
+}
+
+#[hegel::test]
+fn errors_describe_their_kind_and_position(tc: hegel::TestCase) {
+    let text = tc.draw(arb_text());
+    if let Err(e) = parser::parse::<Rec>(&text) {
+        let (kind, start, end) = error_triple(&e);
+        assert_eq!(e.input(), text);
+        assert_eq!(e.erroneous_input(), &text[start..end]);
+        let line = e.error_line();
+        let expected = match kind {
+            ErrorKind::MissingMajorNumber => "Could not parse the major identifier: No input".to_string(),
+            ErrorKind::MissingMinorNumber => "Could not parse the minor identifier: No input".to_string(),
+            ErrorKind::MissingPatchNumber => "Could not parse the patch identifier: No input".to_string(),
+            ErrorKind::MissingPreRelease => "Could not parse the pre-release identifier: No input".to_string(),
+            ErrorKind::MissingBuild => "Could not parse the build identifier: No input".to_string(),
+            ErrorKind::NumberOverflow => format!("The value `{}` overflows the range of an u64", &text[start..end]),
+            ErrorKind::UnexpectedInput => format!("Unexpected `{}`", &text[start..end]),
+        };
+        assert_eq!(line, expected, "{text:?}");
+        assert_eq!(e.to_string(), line);
+        let alt = format!("{e:#}");
+        assert!(alt.starts_with(&format!("{line}\n|    {text}\n|    ")), "{alt:?}");
+        let indicator = e.indicate_erroneous_input();
+        assert!(alt.ends_with(&format!("{indicator}\n")));
+        // the indicator: `~` under the consumed input, `^` under the erroneous part
+        let carets = indicator.matches('^').count();
+        let tildes = indicator.matches('~').count();
+        // (counted in bytes: a multi-byte character gets one caret per byte)
+        assert_eq!(carets, end - start, "carets in {indicator:?} for {text:?}");
+        assert_eq!(tildes, start, "tildes in {indicator:?} for {text:?}");
+        let owned = e.owned();
+        assert_eq!(owned.error_kind(), kind);
+        assert_eq!(owned.error_span(), start..end);
+        assert_eq!(owned.to_string(), line);
+        assert_eq!(owned.borrowed(), e);
+    }
+}
