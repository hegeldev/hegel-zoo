+#[hegel::test]
+fn overflowing_numbers_are_strings_whatever_follows(tc: hegel::TestCase) {
+    // documented: "Numbers that overflow an u64 are treated as strings" — the only cases the
+    // general properties skip are an overflowing segment followed by whitespace or `+`
+    let big = match tc.draw(int!(0u8, 2)) {
+        0 => "18446744073709551616".to_string(), // u64::MAX + 1
+        1 => "99999999999999999999".to_string(),
+        _ => {
+            let digits = tc.draw(int!(21usize, 30));
+            let mut s = tc.draw(int!(1u8, 9)).to_string();
+            for _ in 1..digits {
+                s.push_str(&tc.draw(int!(0u8, 9)).to_string());
+            }
+            s
+        }
+    };
+    let mut text = tc.draw(int!(0u64, 99)).to_string();
+    for _ in 0..tc.draw(int!(0usize, 3)) {
+        text.push_str(&format!(".{}", tc.draw(int!(0u64, 99))));
+    }
+    let prefix = text.clone();
+    text.push('.');
+    text.push_str(&big);
+    let follower = tc.draw(generators::sampled_from(vec![" ", "\t", "\n", "+b", "+1.2", "  +x"]));
+    text.push_str(follower);
+    assert!(drops_overflow(&text), "{text:?}");
+    // without the follower the number is a pre-release identifier, as documented
+    let bare = format!("{prefix}.{big}");
+    let expected_bare = lenient_semver::parse(&bare).unwrap();
+    assert_eq!(expected_bare.pre.as_str(), big, "{bare:?}");
+    // with it, the same version plus the build
+    let got = parser::parse::<Rec>(&text).map_err(|e| error_triple(&e));
+    assert_eq!(got, model(&text), "{text:?}");
+    let sv = lenient_semver::parse(&text).unwrap();
+    assert_eq!(sv.pre.as_str(), big, "{text:?} lost its pre-release (bare text gives {expected_bare})");
+}
