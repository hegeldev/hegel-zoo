+#[hegel::test]
+fn the_semver_and_lenient_version_builders_agree_with_the_calls(tc: hegel::TestCase) {
+    let text = tc.draw(arb_text());
+    if hits_known_bug(&text) {
+        return; // lenient_semver/1–3
+    }
+    let calls = match model(&text) {
+        Ok(calls) => calls,
+        Err(_) => {
+            assert!(lenient_semver::parse(&text).is_err());
+            assert!(LVersion::parse(&text).is_err());
+            return;
+        }
+    };
+    let expected = semver_of(&calls);
+    let sv = lenient_semver::parse(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    assert_eq!(sv, expected, "semver builder for {text:?} ({calls:?})");
+    // the lenient version type: fields are the calls, Display re-parses to an equal value
+    let lv = LVersion::parse(&text).unwrap();
+    let additional: Vec<u64> = lv.additional.iter().copied().collect();
+    let mut want_add = Vec::new();
+    let mut want_pre = None;
+    let mut want_build = None;
+    for c in &calls {
+        match c {
+            Call::Major(m) => assert_eq!(lv.major, *m),
+            Call::Minor(m) => assert_eq!(lv.minor, *m),
+            Call::Patch(m) => assert_eq!(lv.patch, *m),
+            Call::Add(n) => want_add.push(*n),
+            Call::Pre(p) => want_pre = Some(p.clone()),
+            Call::Build(b) => want_build = Some(b.clone()),
+        }
+    }
+    assert_eq!(additional, want_add);
+    assert_eq!(lv.pre.as_ref(), want_pre.as_deref().unwrap_or(""));
+    assert_eq!(*lv.build, want_build.as_deref(), "build of {text:?}");
+    assert_eq!(lv.is_pre_release(), want_pre.is_some());
+    let shown = lv.to_string();
+    let again = LVersion::parse(&shown).unwrap_or_else(|e| panic!("{shown:?} from {text:?}: {e}"));
+    assert_eq!(again, lv, "{shown:?} from {text:?}");
+    assert_eq!(again.to_string(), shown);
+    assert_eq!(*again.build, *lv.build);
+    // both roads to semver agree
+    assert_eq!(semver::Version::from(lv.clone()), sv, "From<Version> for {text:?}");
+    // serde: a JSON string, borrowed back
+    let json = serde_json::to_string(&lv).unwrap();
+    assert_eq!(json, serde_json::to_string(&shown).unwrap());
+    let back: LVersion = serde_json::from_str(&json).unwrap();
+    assert_eq!(back, lv);
+}
