+/// Pinned (python-pkginfo/4): a tab between the colon and the value is folding whitespace, not
+/// part of the value (`email.parser` and Python `pkginfo` give `y` for `Author:\ty`); the crate
+/// keeps it for every field but `Metadata-Version`, `Name` and `Version`.
+#[hegel::test]
+fn header_values_do_not_keep_the_tab_after_the_colon(tc: TestCase) {
+    let (header, get) = pick(&tc, &SINGLE);
+    let value = pick(&tc, &["y", "Lovely Spam", "中文"]);
+    let sep = pick(&tc, &["\t", " \t", "\t ", "\t\t"]);
+    let text = format!("Metadata-Version: 2.1\nName: x\nVersion: 1.0\n{header}:{sep}{value}\n");
+    let theirs = py_pkginfo(&text);
+    assert_eq!(theirs[raw_key(header).replace("provides_extra", "provides_extras")].as_str(), Some(value), "{text:?}: pkginfo");
+    let (raw, _) = py_packaging(&text);
+    assert_eq!(raw[raw_key(header)].as_str(), Some(value), "{text:?}: packaging");
+    let m = Metadata::parse(text.as_bytes()).unwrap();
+    assert_eq!(get(&m).map(String::as_str), Some(value), "{text:?}");
+}
+
+/// Pinned (python-pkginfo/5): the legacy header form of `Description` indents continuation
+/// lines by eight spaces (distutils' `rfc822_escape`), which readers strip — Python `pkginfo`
+/// returns `line1\nline2`; the crate returns the indented text verbatim.
+#[hegel::test]
+fn description_header_continuation_lines_are_dedented(tc: TestCase) {
+    let lines: Vec<&str> = (0..n(&tc, 2, 4)).map(|_| pick(&tc, &["Lovely Spam", "Wonderful Spam!", "中文", "x"])).collect();
+    let text = format!("Metadata-Version: 2.1\nName: x\nVersion: 1.0\nDescription: {}\n", lines.join("\n        "));
+    let theirs = py_pkginfo(&text);
+    assert_eq!(theirs["description"].as_str(), Some(lines.join("\n").as_str()), "{text:?}: pkginfo");
+    let m = Metadata::parse(text.as_bytes()).unwrap();
+    assert_eq!(m.description.as_deref(), Some(lines.join("\n").as_str()), "{text:?}");
+}
+
+/// Pinned (python-pkginfo/6): a folded header (`Summary: s\n  t`) is unfolded to `s t` in the
+/// multi-use fields (`Classifier`, via mailparse's `get_value`) but kept with its newline and
+/// indentation in the single-use ones (raw bytes through the RFC 2047 decoder); Python
+/// `pkginfo` unfolds both.
+#[hegel::test]
+fn folded_headers_unfold_alike_in_single_and_multi_use_fields(tc: TestCase) {
+    let (header, get) = pick(&tc, &SINGLE);
+    let (a, b) = (pick(&tc, &["s", "Lovely", "中文"]), pick(&tc, &["t", "Spam", "文"]));
+    let indent = pick(&tc, &[" ", "  ", "\t"]);
+    let text = format!("Metadata-Version: 2.1\nName: x\nVersion: 1.0\n{header}: {a}\n{indent}{b}\nClassifier: {a}\n{indent}{b}\n");
+    let theirs = py_pkginfo(&text);
+    let expected = format!("{a} {b}");
+    assert_eq!(theirs["classifiers"][0].as_str(), Some(expected.as_str()), "{text:?}: pkginfo classifier");
+    assert_eq!(theirs[raw_key(header)].as_str(), Some(expected.as_str()), "{text:?}: pkginfo {header}");
+    let m = Metadata::parse(text.as_bytes()).unwrap();
+    assert_eq!(m.classifiers, vec![expected.clone()], "{text:?}: classifier");
+    assert_eq!(get(&m).map(String::as_str), Some(expected.as_str()), "{text:?}: {header}");
+}
