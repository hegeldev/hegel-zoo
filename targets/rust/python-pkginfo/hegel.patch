+/// Pinned (python-pkginfo/3): the wheel filename is
+/// `{name}-{version}(-{build tag})?-{python tag}-{abi tag}-{platform tag}.whl`; with a build
+/// tag the crate reports `python_version()` as `any` instead of the Python tag.
+#[hegel::test]
+fn wheel_build_tags_do_not_hide_the_python_tag(tc: TestCase) {
+    let name = pick(&tc, &NAMES).to_string();
+    let py_tag = pick(&tc, &["py3", "py2.py3", "cp312"]);
+    let build = format!("{}{}", n(&tc, 1, 99), pick(&tc, &["", "abc", "_x"]));
+    let root = format!("{name}-1.0");
+    let files = vec![(format!("{root}.dist-info/METADATA"), metadata_text(&name, "1.0", "real")), (format!("{root}.dist-info/WHEEL"), "Wheel-Version: 1.0\n".into())];
+    let dir = scratch_dir();
+    let path = dir.join(format!("{root}-{build}-{py_tag}-none-any.whl"));
+    write_zip(&path, &files);
+    let ours = Distribution::new(&path).map(|d| d.python_version().to_string());
+    let _ = std::fs::remove_dir_all(&dir);
+    assert_eq!(ours.unwrap(), py_tag, "{path:?}");
+}
