+/// Pinned (python-pkginfo/1): a `.tar.gz` sdist whose archive lists a nested `PKG-INFO` (a
+/// vendored package's, or the `.egg-info` copy) before the top-level one yields the nested
+/// file's metadata; Python `pkginfo` reads the shallowest `PKG-INFO`.
+#[hegel::test]
+fn sdist_tars_read_the_top_level_pkg_info(tc: TestCase) {
+    let name = pick(&tc, &NAMES).to_string();
+    let root = format!("{name}-1.0");
+    let real = metadata_text(&name, "1.0", "real");
+    let decoy = metadata_text("vendored", "9.9", "decoy");
+    let nested = pick(&tc, &[format!("{root}/{name}.egg-info/PKG-INFO"), format!("{root}/{name}/_vendor/other/PKG-INFO"), format!("{root}/src/PKG-INFO")]);
+    let mut files = vec![(nested, decoy)];
+    if chance(&tc, 2) {
+        files.push((format!("{root}/setup.py"), String::new()));
+    }
+    files.push((format!("{root}/PKG-INFO"), real));
+    let dir = scratch_dir();
+    let path = dir.join(format!("{root}.tar.gz"));
+    write_tar_gz(&path, &files);
+    let theirs = py_distribution("sdist", &path).unwrap();
+    let ours = Distribution::new(&path).map(|d| d.metadata().name.clone());
+    let _ = std::fs::remove_dir_all(&dir);
+    assert_eq!(theirs["name"].as_str(), Some(name.as_str()), "pkginfo");
+    assert_eq!(ours.unwrap(), name, "{files:?}");
+}
