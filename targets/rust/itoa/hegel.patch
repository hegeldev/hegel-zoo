+//! Hegel property tests for `itoa`: `Buffer::format` prints exactly the decimal the standard
+//! library prints, for every integer type, within the advertised `MAX_STR_LEN`.
+//!
+//! Oracle: `ToString`/`Display` from `std` (`core::fmt::num`, the implementation itoa was
+//! derived from — but `std` formats through `Formatter` and the u128 path here is a rewrite with
+//! a Granlund–Montgomery division by 10^16), plus `str::parse` for the round trip.
+
+#![allow(unused_comparisons)] // `<$t>::MIN < 0` in the macro, for the unsigned types
+
+use hegel::generators;
+
+/// Integers of one type, biased to the places where a decimal printer's cases change: the
+/// digit-count boundaries (10^k − 1, 10^k, 10^k + 1), the powers of two, the type's limits, plus
+/// uniform bit patterns and small values.
+macro_rules! arb_int {
+    ($name:ident, $t:ty, $u:ty) => {
+        #[hegel::composite]
+        fn $name(tc: &hegel::TestCase) -> $t {
+            let kind = tc.draw(generators::integers::<u8>().min_value(0).max_value(5));
+            match kind {
+                0 | 1 => <$t>::from_le_bytes(tc.draw(generators::integers::<$u>()).to_le_bytes()),
+                2 => {
+                    // around a power of ten
+                    let max_pow = (<$u>::MAX).ilog10();
+                    let k = tc.draw(generators::integers::<u32>().min_value(0).max_value(max_pow));
+                    let delta = tc.draw(generators::integers::<i8>().min_value(-2).max_value(2));
+                    let p = (10 as $u).pow(k);
+                    let v = if delta < 0 { p.saturating_sub(delta.unsigned_abs() as $u) } else { p.saturating_add(delta as $u) };
+                    let neg = tc.draw(generators::booleans());
+                    let v = <$t>::from_le_bytes(v.to_le_bytes());
+                    if neg && <$t>::MIN < 0 { v.wrapping_neg() } else { v }
+                }
+                3 => {
+                    // around a power of two
+                    let k = tc.draw(generators::integers::<u32>().min_value(0).max_value(<$u>::BITS - 1));
+                    let delta = tc.draw(generators::integers::<i8>().min_value(-2).max_value(2));
+                    let p = (1 as $u) << k;
+                    let v = if delta < 0 { p.saturating_sub(delta.unsigned_abs() as $u) } else { p.saturating_add(delta as $u) };
+                    let neg = tc.draw(generators::booleans());
+                    let v = <$t>::from_le_bytes(v.to_le_bytes());
+                    if neg && <$t>::MIN < 0 { v.wrapping_neg() } else { v }
+                }
+                4 => tc.draw(generators::sampled_from(vec![<$t>::MIN, <$t>::MAX, 0, 1, 9, 10, 99, 100])),
+                _ => tc.draw(generators::integers::<$t>().min_value(0).max_value((999 as u32).min(<$t>::MAX as u32) as $t)),
+            }
+        }
+    };
+}
+
+arb_int!(arb_u8, u8, u8);
+arb_int!(arb_i8, i8, u8);
+arb_int!(arb_u16, u16, u16);
+arb_int!(arb_i16, i16, u16);
+arb_int!(arb_u32, u32, u32);
+arb_int!(arb_i32, i32, u32);
+arb_int!(arb_u64, u64, u64);
+arb_int!(arb_i64, i64, u64);
+arb_int!(arb_u128, u128, u128);
+arb_int!(arb_i128, i128, u128);
+
+/// Everything `Buffer::format` promises for one value: the text is `std`'s, it fits the type's
+/// `MAX_STR_LEN`, it reads back, and it has the shape of a canonical decimal.
+fn check<I>(v: I)
+where
+    I: itoa::Integer + std::fmt::Display + std::str::FromStr + PartialEq + std::fmt::Debug + Copy,
+    <I as std::str::FromStr>::Err: std::fmt::Debug,
+{
+    let expected = v.to_string();
+    let mut buffer = itoa::Buffer::new();
+    let printed = buffer.format(v);
+    assert_eq!(printed, expected, "{v:?}");
+    assert!(printed.len() <= I::MAX_STR_LEN, "{v:?}: {} > MAX_STR_LEN {}", printed.len(), I::MAX_STR_LEN);
+    assert_eq!(printed.parse::<I>().unwrap(), v, "{v:?}: round trip");
+    let digits = printed.strip_prefix('-').unwrap_or(printed);
+    assert!(!digits.is_empty() && digits.bytes().all(|b| b.is_ascii_digit()), "{printed:?}");
+    assert!(digits == "0" || !digits.starts_with('0'), "{printed:?}: leading zero");
+    assert_eq!(printed.starts_with('-'), expected.starts_with('-'), "{printed:?}: sign");
+    // a fresh buffer prints the same; formatting twice into the same buffer prints the same
+    assert_eq!(itoa::Buffer::new().format(v), expected);
+    assert_eq!(buffer.format(v), expected);
+}
+
+macro_rules! test_type {
+    ($test:ident, $gen:ident, $t:ty) => {
+        #[hegel::test]
+        fn $test(tc: hegel::TestCase) {
+            let v: $t = tc.draw($gen());
+            check(v);
+            // MAX_STR_LEN is exact: the longest value of the type fills it
+            let longest = if <$t>::MIN < 0 { <$t>::MIN.to_string() } else { <$t>::MAX.to_string() };
+            assert_eq!(longest.len(), <$t as itoa::Integer>::MAX_STR_LEN);
+        }
+    };
+}
+
+test_type!(u8_prints_like_std, arb_u8, u8);
+test_type!(i8_prints_like_std, arb_i8, i8);
+test_type!(u16_prints_like_std, arb_u16, u16);
+test_type!(i16_prints_like_std, arb_i16, i16);
+test_type!(u32_prints_like_std, arb_u32, u32);
+test_type!(i32_prints_like_std, arb_i32, i32);
+test_type!(u64_prints_like_std, arb_u64, u64);
+test_type!(i64_prints_like_std, arb_i64, i64);
+test_type!(u128_prints_like_std, arb_u128, u128);
+test_type!(i128_prints_like_std, arb_i128, i128);
+
+#[hegel::test]
+fn usize_and_isize_print_like_their_fixed_width_twins(tc: hegel::TestCase) {
+    let u = tc.draw(arb_u64()) as usize;
+    let i = tc.draw(arb_i64()) as isize;
+    check(u);
+    check(i);
+    assert_eq!(itoa::Buffer::new().format(u), itoa::Buffer::new().format(u as u64));
+    assert_eq!(itoa::Buffer::new().format(i), itoa::Buffer::new().format(i as i64));
+    assert_eq!(<usize as itoa::Integer>::MAX_STR_LEN, <u64 as itoa::Integer>::MAX_STR_LEN);
+    assert_eq!(<isize as itoa::Integer>::MAX_STR_LEN, <i64 as itoa::Integer>::MAX_STR_LEN);
+}
+
+/// The u128 printer takes 16 decimals at a time with a multiply-shift division by 10^16: the
+/// text of `hi × 10^16 + lo` is the text of `hi` followed by `lo` zero-padded to 16 digits, and
+/// widening a value never changes its text.
+#[hegel::test]
+fn wider_types_and_the_16_digit_split_agree(tc: hegel::TestCase) {
+    let v = tc.draw(arb_u128());
+    let mut buffer = itoa::Buffer::new();
+    let text = buffer.format(v).to_owned();
+    if v >= 10u128.pow(16) {
+        let hi = v / 10u128.pow(16);
+        let lo = (v % 10u128.pow(16)) as u64;
+        let mut b = itoa::Buffer::new();
+        let expected = format!("{}{:016}", b.format(hi), lo);
+        assert_eq!(text, expected);
+    }
+    if let Ok(x) = u8::try_from(v) {
+        assert_eq!(buffer.format(x), text);
+    }
+    if let Ok(x) = u16::try_from(v) {
+        assert_eq!(buffer.format(x), text);
+    }
+    if let Ok(x) = u32::try_from(v) {
+        assert_eq!(buffer.format(x), text);
+    }
+    if let Ok(x) = u64::try_from(v) {
+        assert_eq!(buffer.format(x), text);
+    }
+    if let Ok(x) = i128::try_from(v) {
+        assert_eq!(buffer.format(x), text);
+        assert_eq!(buffer.format(x.checked_neg().unwrap()), if x == 0 { text.clone() } else { format!("-{text}") });
+    }
+    if let Ok(x) = i64::try_from(v) {
+        assert_eq!(buffer.format(x), text);
+        assert_eq!(buffer.format(-x), if x == 0 { text.clone() } else { format!("-{text}") });
+    }
+}
+
+/// Within one type the text orders like the numbers once padded to the same width — a
+/// consequence of printing every digit and no leading zero.
+#[hegel::test]
+fn text_order_follows_numeric_order(tc: hegel::TestCase) {
+    let a = tc.draw(arb_u64());
+    let b = tc.draw(arb_u64());
+    let mut ba = itoa::Buffer::new();
+    let mut bb = itoa::Buffer::new();
+    let sa = ba.format(a);
+    let sb = bb.format(b);
+    assert_eq!(sa.len().cmp(&sb.len()).then_with(|| sa.cmp(sb)), a.cmp(&b), "{a} {b}");
+    let mut ia = itoa::Buffer::new();
+    let mut ib = itoa::Buffer::new();
+    let x = a as i64;
+    let y = b as i64;
+    let sx = ia.format(x);
+    let sy = ib.format(y);
+    if (x < 0) == (y < 0) {
+        let (dx, dy) = (sx.trim_start_matches('-'), sy.trim_start_matches('-'));
+        let mag = dx.len().cmp(&dy.len()).then_with(|| dx.cmp(dy));
+        assert_eq!(if x < 0 { mag.reverse() } else { mag }, x.cmp(&y), "{x} {y}");
+    } else {
+        assert_eq!(sx.starts_with('-'), x < y, "{x} {y}");
+    }
+}
+
+/// A `Buffer` is a plain stack allocation: reusable across types and values, `Copy`, `Clone`,
+/// `Default`, and the returned `&str` never outlives its use of the buffer.
+#[hegel::test]
+fn buffers_are_reusable_and_independent(tc: hegel::TestCase) {
+    let long = tc.draw(arb_i128());
+    let short = tc.draw(arb_u8());
+    let mut buffer = itoa::Buffer::default();
+    assert_eq!(buffer.format(long), long.to_string());
+    assert_eq!(buffer.format(short), short.to_string());
+    assert_eq!(buffer.format(long), long.to_string());
+    let mut copy = buffer;
+    let mut clone = buffer.clone();
+    assert_eq!(copy.format(short), short.to_string());
+    assert_eq!(clone.format(long), long.to_string());
+    assert_eq!(buffer.format(short as i16 - 200), (short as i16 - 200).to_string());
+    assert!(std::mem::size_of::<itoa::Buffer>() >= <i128 as itoa::Integer>::MAX_STR_LEN);
+}
