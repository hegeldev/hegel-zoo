+/// Property-based tests (hegel) for the expression-building algebra.
+#[cfg(not(target_arch = "wasm32"))]
+mod expression_properties {
+    use good_lp::{Expression, Variable, variables};
+    use hegel::generators;
+    use std::collections::HashMap;
+
+    /// Coefficients and evaluation points for the algebraic properties.
+    /// The bounds protect the floating-point oracle in the *test* (they keep
+    /// intermediate products far away from overflow so a scale-relative
+    /// tolerance stays meaningful); they are not a contract of the library.
+    fn coeff(tc: &hegel::TestCase) -> f64 {
+        tc.draw(generators::floats::<f64>().min_value(-1e6).max_value(1e6))
+    }
+
+    /// Draw a random affine expression over (a subset of) the given variables,
+    /// together with nothing else — the caller keeps its own bookkeeping.
+    fn draw_expr(tc: &hegel::TestCase, vars: &[Variable]) -> Expression {
+        let mut e = Expression::from(coeff(tc));
+        for &v in vars {
+            if tc.draw(generators::booleans()) {
+                e.add_mul(coeff(tc), v);
+            }
+        }
+        e
+    }
+
+    fn draw_point(tc: &hegel::TestCase, vars: &[Variable]) -> HashMap<Variable, f64> {
+        vars.iter().map(|&v| (v, coeff(tc))).collect()
+    }
+
+    /// Building an Expression through an arbitrary sequence of the public
+    /// mutation operators (`+= c*v`, `-= c*v`, `+= k`, `*= k`, unary `-`)
+    /// must agree with an independently tracked coefficient map + constant,
+    /// as observed through `eval_with` at a random point.
+    #[hegel::test]
+    fn expression_ops_match_coefficient_model(tc: hegel::TestCase) {
+        let mut problem = variables!();
+        let n: usize = tc.draw(generators::integers::<usize>().min_value(1).max_value(5));
+        let vs: Vec<Variable> = (0..n).map(|_| problem.add_variable()).collect();
+
+        let mut expr = Expression::default();
+        let mut model_coeffs = vec![0.0f64; n];
+        let mut model_constant = 0.0f64;
+
+        let n_ops: usize = tc.draw(generators::integers::<usize>().max_value(10));
+        for _ in 0..n_ops {
+            match tc.draw(generators::integers::<u8>().max_value(4)) {
+                0 => {
+                    let i = tc.draw(generators::integers::<usize>().max_value(n - 1));
+                    let c = coeff(&tc);
+                    expr += c * vs[i];
+                    model_coeffs[i] += c;
+                }
+                1 => {
+                    let i = tc.draw(generators::integers::<usize>().max_value(n - 1));
+                    let c = coeff(&tc);
+                    expr -= c * vs[i];
+                    model_coeffs[i] -= c;
+                }
+                2 => {
+                    let k = coeff(&tc);
+                    expr += k;
+                    model_constant += k;
+                }
+                3 => {
+                    let k = coeff(&tc);
+                    expr *= k;
+                    for c in &mut model_coeffs {
+                        *c *= k;
+                    }
+                    model_constant *= k;
+                }
+                _ => {
+                    expr = -expr;
+                    for c in &mut model_coeffs {
+                        *c = -*c;
+                    }
+                    model_constant = -model_constant;
+                }
+            }
+        }
+
+        let point = draw_point(&tc, &vs);
+        let expected: f64 = model_constant
+            + vs.iter()
+                .enumerate()
+                .map(|(i, v)| model_coeffs[i] * point[v])
+                .sum::<f64>();
+        let actual = expr.eval_with(&point);
+        // Scale-relative tolerance: summation order differs between the
+        // model and the expression's internal hash map.
+        let scale: f64 = model_constant.abs()
+            + vs.iter()
+                .enumerate()
+                .map(|(i, v)| (model_coeffs[i] * point[v]).abs())
+                .sum::<f64>();
+        assert!(
+            (actual - expected).abs() <= 1e-9 * (1.0 + scale),
+            "eval mismatch: got {actual}, expected {expected} (scale {scale})"
+        );
+    }
+
+    /// Addition of expressions is commutative. Per-variable coefficient
+    /// addition of two floats is exactly commutative, so this holds with
+    /// exact structural equality (`PartialEq` on the coefficient maps).
+    #[hegel::test]
+    fn expression_addition_commutes(tc: hegel::TestCase) {
+        let mut problem = variables!();
+        let n: usize = tc.draw(generators::integers::<usize>().min_value(1).max_value(6));
+        let vs: Vec<Variable> = (0..n).map(|_| problem.add_variable()).collect();
+        let e1 = draw_expr(&tc, &vs);
+        let e2 = draw_expr(&tc, &vs);
+        assert_eq!(e1.clone() + &e2, e2.clone() + &e1);
+    }
+
+    /// Multiplying by a scalar distributes over addition:
+    /// (e1 + e2) * k evaluates to e1 * k + e2 * k (up to fp rounding).
+    #[hegel::test]
+    fn scalar_multiplication_distributes_over_addition(tc: hegel::TestCase) {
+        let mut problem = variables!();
+        let n: usize = tc.draw(generators::integers::<usize>().min_value(1).max_value(6));
+        let vs: Vec<Variable> = (0..n).map(|_| problem.add_variable()).collect();
+        let e1 = draw_expr(&tc, &vs);
+        let e2 = draw_expr(&tc, &vs);
+        let k = coeff(&tc);
+        let point = draw_point(&tc, &vs);
+
+        let lhs = ((e1.clone() + &e2) * k).eval_with(&point);
+        let rhs = (e1 * k + e2 * k).eval_with(&point);
+        let scale = lhs.abs().max(rhs.abs());
+        assert!(
+            (lhs - rhs).abs() <= 1e-9 * (1.0 + scale),
+            "distributivity mismatch: lhs {lhs}, rhs {rhs}"
+        );
+    }
+}
