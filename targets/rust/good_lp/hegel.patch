+    /// KNOWN FAILURE — pins a real bug in the microlp backend (microlp 0.5.0).
+    ///
+    /// This MILP is feasible and bounded: the point x1 = x2 = x3 = 0
+    /// satisfies both equality constraints and all variable bounds. Yet
+    /// `solve()` returns `Err(ResolutionError::Str("exactly integral solution
+    /// failed feasibility validation after slack-basis retry"))` instead of a
+    /// solution.
+    ///
+    /// Found by the hegel property `properties::solved_lp_solution_is_feasible`
+    /// and minimized by hand. The trigger needs all of:
+    /// - at least one integer variable (here fixed to 0 by its bounds), i.e.
+    ///   the branch-and-bound code path,
+    /// - an equality constraint with a tiny non-zero coefficient
+    ///   (~1e-8; 1e-7 does not reproduce),
+    /// - the other (independent) equality constraint.
+    ///
+    /// The sibling hegel properties snap |constraint coefficients| < 1e-6 to
+    /// zero to keep testing everything else; see
+    /// `properties::constraint_coeff`.
+    #[test]
+    fn known_failure_microlp_tiny_equality_coefficient_milp() {
+        let mut pv = variables!();
+        let x1 = pv.add(variable().min(-28.0).max(0.0));
+        let x2 = pv.add(variable().min(0.0).max(4.7288778329638745));
+        pv.add(variable().integer().min(0).max(0)); // the MILP trigger
+        let mut objective = Expression::default();
+        objective.add_mul(-1.49702866545711, x1);
+        let mut c1 = Expression::default();
+        c1.add_mul(8.510167104926385, x2);
+        let mut c2 = Expression::default();
+        c2.add_mul(-6.231243773305585, x1);
+        c2.add_mul(-1.190834764418229e-8, x2);
+        let result = pv
+            .maximise(objective)
+            .using(microlp)
+            .with(c1.eq(0.0))
+            .with(c2.eq(0.0))
+            .solve();
+        assert!(
+            result.is_ok(),
+            "KNOWN BUG (microlp 0.5.0): feasible bounded MILP rejected with {:?}",
+            result.err()
+        );
+    }
+
+    mod properties {
+        //! Property-based tests (hegel) exercising the microlp backend with
+        //! generated LPs/MILPs that are feasible and bounded by construction.
+
+        use super::super::{MicroLpProblem, MicroLpSolution, microlp};
+        use crate::solvers::ObjectiveDirection;
+        use crate::{Expression, ResolutionError, Solution, SolverModel, Variable, variable, variables};
+        use hegel::generators;
+        use hegel::Generator;
+
+        #[derive(Debug, Clone)]
+        struct VarSpec {
+            lo: f64,
+            hi: f64,
+            integer: bool,
+            /// A point inside [lo, hi] (integral if `integer`), used as a
+            /// feasibility witness when generating constraints.
+            witness: f64,
+        }
+
+        #[derive(Debug, Clone)]
+        struct ConstraintSpec {
+            coeffs: Vec<f64>,
+            rhs: f64,
+            /// true: sum(coeffs * x) == rhs, false: sum(coeffs * x) <= rhs
+            equality: bool,
+        }
+
+        #[derive(Debug, Clone)]
+        struct LpSpec {
+            vars: Vec<VarSpec>,
+            constraints: Vec<ConstraintSpec>,
+            objective: Vec<f64>,
+            maximise: bool,
+        }
+
+        /// Draw a constraint coefficient in [-10, 10], snapping tiny non-zero
+        /// magnitudes to zero. Coefficients with 0 < |c| <~ 1e-8 trigger a
+        /// known microlp bug on feasible MILPs (internal error instead of a
+        /// solution), pinned by
+        /// `super::known_failure_microlp_tiny_equality_coefficient_milp`.
+        /// This exclusion (with a 100x safety margin) keeps the sibling
+        /// properties testing everything else.
+        fn constraint_coeff(tc: &hegel::TestCase) -> f64 {
+            let c = tc.draw(generators::floats::<f64>().min_value(-10.0).max_value(10.0));
+            if c != 0.0 && c.abs() < 1e-6 { 0.0 } else { c }
+        }
+
+        /// Generate a small LP/MILP that is feasible (every constraint is
+        /// satisfied by the per-variable witness point) and bounded (every
+        /// variable has finite bounds).
+        #[hegel::composite]
+        fn feasible_lps(tc: &hegel::TestCase) -> LpSpec {
+            let n: usize = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+            let mut vars = Vec::with_capacity(n);
+            for _ in 0..n {
+                let integer = tc.draw(generators::booleans());
+                let (lo, hi, witness) = if integer {
+                    let a = tc.draw(generators::integers::<i32>().min_value(-100).max_value(100));
+                    let b = tc.draw(generators::integers::<i32>().min_value(-100).max_value(100));
+                    let (lo, hi) = if a <= b { (a, b) } else { (b, a) };
+                    let w = tc.draw(generators::integers::<i32>().min_value(lo).max_value(hi));
+                    (f64::from(lo), f64::from(hi), f64::from(w))
+                } else {
+                    let a = tc.draw(generators::floats::<f64>().min_value(-100.0).max_value(100.0));
+                    let b = tc.draw(generators::floats::<f64>().min_value(-100.0).max_value(100.0));
+                    let (lo, hi) = if a <= b { (a, b) } else { (b, a) };
+                    let w = tc.draw(generators::floats::<f64>().min_value(lo).max_value(hi));
+                    (lo, hi, w)
+                };
+                vars.push(VarSpec {
+                    lo,
+                    hi,
+                    integer,
+                    witness,
+                });
+            }
+            let m: usize = tc.draw(generators::integers::<usize>().max_value(4));
+            let mut constraints = Vec::with_capacity(m);
+            for _ in 0..m {
+                let coeffs: Vec<f64> = (0..n).map(|_| constraint_coeff(&tc)).collect();
+                let at_witness: f64 = coeffs
+                    .iter()
+                    .zip(&vars)
+                    .map(|(c, v)| c * v.witness)
+                    .sum();
+                let equality = tc.draw(generators::booleans());
+                let rhs = if equality {
+                    at_witness
+                } else {
+                    at_witness + tc.draw(generators::floats::<f64>().min_value(0.0).max_value(50.0))
+                };
+                constraints.push(ConstraintSpec {
+                    coeffs,
+                    rhs,
+                    equality,
+                });
+            }
+            let objective: Vec<f64> = (0..n)
+                .map(|_| tc.draw(generators::floats::<f64>().min_value(-10.0).max_value(10.0)))
+                .collect();
+            let maximise = tc.draw(generators::booleans());
+            LpSpec {
+                vars,
+                constraints,
+                objective,
+                maximise,
+            }
+        }
+
+        /// Build a good_lp model (using the microlp backend) from a spec,
+        /// optionally with extra constraints and a scaled objective.
+        fn build_problem(
+            spec: &LpSpec,
+            extra_constraints: &[ConstraintSpec],
+            objective_scale: f64,
+        ) -> (MicroLpProblem, Vec<Variable>) {
+            let mut pv = variables!();
+            let handles: Vec<Variable> = spec
+                .vars
+                .iter()
+                .map(|v| {
+                    let mut def = variable().min(v.lo).max(v.hi);
+                    if v.integer {
+                        def = def.integer();
+                    }
+                    pv.add(def)
+                })
+                .collect();
+            let mut objective = Expression::with_capacity(handles.len());
+            for (c, &h) in spec.objective.iter().zip(&handles) {
+                objective.add_mul(c * objective_scale, h);
+            }
+            let direction = if spec.maximise {
+                ObjectiveDirection::Maximisation
+            } else {
+                ObjectiveDirection::Minimisation
+            };
+            let mut model = pv.optimise(direction, objective).using(microlp);
+            for c in spec.constraints.iter().chain(extra_constraints) {
+                let mut e = Expression::with_capacity(c.coeffs.len());
+                for (coef, &h) in c.coeffs.iter().zip(&handles) {
+                    e.add_mul(*coef, h);
+                }
+                model = model.with(if c.equality { e.eq(c.rhs) } else { e.leq(c.rhs) });
+            }
+            (model, handles)
+        }
+
+        fn objective_value(
+            spec: &LpSpec,
+            handles: &[Variable],
+            solution: &MicroLpSolution,
+            objective_scale: f64,
+        ) -> f64 {
+            spec.objective
+                .iter()
+                .zip(handles)
+                .map(|(c, &h)| c * objective_scale * solution.value(h))
+                .sum()
+        }
+
+        /// Absolute + scale-relative tolerance for solver results.
+        fn tol(scale: f64) -> f64 {
+            1e-6 + 1e-8 * scale.abs()
+        }
+
+        /// Upper bound of `sum(coeffs * x)` over the bounding box of the
+        /// variables (interval arithmetic).
+        fn box_upper_bound(coeffs: &[f64], vars: &[VarSpec]) -> f64 {
+            coeffs
+                .iter()
+                .zip(vars)
+                .map(|(&c, v)| if c >= 0.0 { c * v.hi } else { c * v.lo })
+                .sum()
+        }
+
+        /// The solution returned for a feasible, bounded problem satisfies
+        /// every constraint (within tolerance), respects the declared
+        /// variable bounds, and gives integral values to integer variables.
+        #[hegel::test]
+        fn solved_lp_solution_is_feasible(tc: hegel::TestCase) {
+            let spec = tc.draw((feasible_lps()).print_as_debug());
+            let (model, handles) = build_problem(&spec, &[], 1.0);
+            let solution = model
+                .solve()
+                .expect("the generated problem is feasible and bounded");
+            for (v, &h) in spec.vars.iter().zip(&handles) {
+                let x = solution.value(h);
+                let t = tol(v.lo.abs().max(v.hi.abs()));
+                assert!(
+                    x >= v.lo - t && x <= v.hi + t,
+                    "value {x} outside bounds [{}, {}]",
+                    v.lo,
+                    v.hi
+                );
+                if v.integer {
+                    assert!(
+                        (x - x.round()).abs() <= 1e-6,
+                        "integer variable took non-integral value {x}"
+                    );
+                }
+            }
+            for c in &spec.constraints {
+                let lhs: f64 = c
+                    .coeffs
+                    .iter()
+                    .zip(&handles)
+                    .map(|(coef, &h)| coef * solution.value(h))
+                    .sum();
+                let t = tol(lhs.abs().max(c.rhs.abs()));
+                if c.equality {
+                    assert!(
+                        (lhs - c.rhs).abs() <= t,
+                        "equality constraint violated: {lhs} != {}",
+                        c.rhs
+                    );
+                } else {
+                    assert!(lhs <= c.rhs + t, "constraint violated: {lhs} > {}", c.rhs);
+                }
+            }
+        }
+
+        /// The optimal objective value is at least as good as the objective
+        /// value at the known feasible witness point.
+        #[hegel::test]
+        fn solved_lp_objective_dominates_feasible_witness(tc: hegel::TestCase) {
+            let spec = tc.draw((feasible_lps()).print_as_debug());
+            let (model, handles) = build_problem(&spec, &[], 1.0);
+            let solution = model
+                .solve()
+                .expect("the generated problem is feasible and bounded");
+            let opt = objective_value(&spec, &handles, &solution, 1.0);
+            let at_witness: f64 = spec
+                .objective
+                .iter()
+                .zip(&spec.vars)
+                .map(|(c, v)| c * v.witness)
+                .sum();
+            let t = tol(opt.abs().max(at_witness.abs()));
+            if spec.maximise {
+                assert!(
+                    opt >= at_witness - t,
+                    "optimum {opt} is worse than feasible witness value {at_witness}"
+                );
+            } else {
+                assert!(
+                    opt <= at_witness + t,
+                    "optimum {opt} is worse than feasible witness value {at_witness}"
+                );
+            }
+        }
+
+        /// Adding a constraint that is redundant (implied by the variable
+        /// bounds) must not change the optimal objective value.
+        #[hegel::test]
+        fn redundant_constraint_preserves_optimal_value(tc: hegel::TestCase) {
+            let spec = tc.draw((feasible_lps()).print_as_debug());
+            let n = spec.vars.len();
+            let coeffs: Vec<f64> = (0..n).map(|_| constraint_coeff(&tc)).collect();
+            let ub = box_upper_bound(&coeffs, &spec.vars);
+            let slack = tc.draw(generators::floats::<f64>().min_value(0.0).max_value(50.0));
+            // The extra epsilon keeps the constraint strictly redundant in
+            // the face of floating-point rounding in `ub` itself.
+            let redundant = ConstraintSpec {
+                coeffs,
+                rhs: ub + slack + 1e-6 * (1.0 + ub.abs()),
+                equality: false,
+            };
+
+            let (base_model, base_handles) = build_problem(&spec, &[], 1.0);
+            let base_solution = base_model.solve().expect("base problem is feasible");
+            let base_value = objective_value(&spec, &base_handles, &base_solution, 1.0);
+
+            let (model, handles) = build_problem(&spec, &[redundant], 1.0);
+            let solution = model
+                .solve()
+                .expect("adding a redundant constraint keeps the problem feasible");
+            let value = objective_value(&spec, &handles, &solution, 1.0);
+
+            let t = tol(base_value.abs().max(value.abs()));
+            assert!(
+                (value - base_value).abs() <= t,
+                "optimum changed from {base_value} to {value} after adding a redundant constraint"
+            );
+        }
+
+        /// Scaling the objective by a positive constant k scales the optimal
+        /// objective value by k (the optimal set is unchanged).
+        #[hegel::test]
+        fn positive_scaling_of_objective_scales_optimal_value(tc: hegel::TestCase) {
+            let spec = tc.draw((feasible_lps()).print_as_debug());
+            let k = tc.draw(generators::floats::<f64>().min_value(0.1).max_value(10.0));
+
+            let (base_model, base_handles) = build_problem(&spec, &[], 1.0);
+            let base_solution = base_model.solve().expect("base problem is feasible");
+            let base_value = objective_value(&spec, &base_handles, &base_solution, 1.0);
+
+            let (scaled_model, scaled_handles) = build_problem(&spec, &[], k);
+            let scaled_solution = scaled_model
+                .solve()
+                .expect("scaling the objective keeps the problem feasible");
+            let scaled_value = objective_value(&spec, &scaled_handles, &scaled_solution, k);
+
+            let expected = k * base_value;
+            let t = tol(expected.abs().max(scaled_value.abs()));
+            assert!(
+                (scaled_value - expected).abs() <= t,
+                "scaling objective by {k}: expected optimum {expected}, got {scaled_value}"
+            );
+        }
+
+        /// A constraint that requires a linear expression to exceed its
+        /// maximum over the variables' bounding box makes the problem
+        /// infeasible, and the solver must report exactly that.
+        #[hegel::test]
+        fn impossible_constraint_reports_infeasible(tc: hegel::TestCase) {
+            let spec = tc.draw((feasible_lps()).print_as_debug());
+            let n = spec.vars.len();
+            let coeffs: Vec<f64> = (0..n).map(|_| constraint_coeff(&tc)).collect();
+            let ub = box_upper_bound(&coeffs, &spec.vars);
+            let gap = tc.draw(generators::floats::<f64>().min_value(1.0).max_value(100.0));
+            let target = ub + gap;
+            let equality = tc.draw(generators::booleans());
+            // sum(coeffs * x) >= target (or == target), both unattainable.
+            let impossible = if equality {
+                ConstraintSpec {
+                    coeffs,
+                    rhs: target,
+                    equality: true,
+                }
+            } else {
+                ConstraintSpec {
+                    coeffs: coeffs.iter().map(|c| -c).collect(),
+                    rhs: -target,
+                    equality: false,
+                }
+            };
+            let (model, _) = build_problem(&spec, &[impossible], 1.0);
+            let result = model.solve();
+            assert_eq!(
+                result.err(),
+                Some(ResolutionError::Infeasible),
+                "expected Infeasible for an unsatisfiable constraint"
+            );
+        }
+
+        /// Maximising a positive-coefficient objective over a continuous
+        /// variable with no upper bound (or minimising with no lower bound)
+        /// must report ResolutionError::Unbounded, not a wrong solution.
+        #[hegel::test]
+        fn unbounded_objective_reports_unbounded(tc: hegel::TestCase) {
+            let mut pv = variables!();
+            let mut objective = Expression::default();
+            let maximise = tc.draw(generators::booleans());
+            // A few bounded companion variables.
+            let n_extra: usize = tc.draw(generators::integers::<usize>().max_value(3));
+            for _ in 0..n_extra {
+                let a = tc.draw(generators::floats::<f64>().min_value(-100.0).max_value(100.0));
+                let b = tc.draw(generators::floats::<f64>().min_value(-100.0).max_value(100.0));
+                let (lo, hi) = if a <= b { (a, b) } else { (b, a) };
+                let h = pv.add(variable().min(lo).max(hi));
+                let c = tc.draw(generators::floats::<f64>().min_value(-10.0).max_value(10.0));
+                objective.add_mul(c, h);
+            }
+            // The variable that makes the problem unbounded.
+            let c = tc.draw(generators::floats::<f64>().min_value(0.1).max_value(10.0));
+            let finite_side = tc.draw(generators::optional(
+                generators::floats::<f64>().min_value(-100.0).max_value(100.0),
+            ));
+            let free = if maximise {
+                // no upper bound; possibly a finite lower bound
+                match finite_side {
+                    Some(lo) => pv.add(variable().min(lo)),
+                    None => pv.add(variable()),
+                }
+            } else {
+                match finite_side {
+                    Some(hi) => pv.add(variable().max(hi)),
+                    None => pv.add(variable()),
+                }
+            };
+            objective.add_mul(c, free);
+            let direction = if maximise {
+                ObjectiveDirection::Maximisation
+            } else {
+                ObjectiveDirection::Minimisation
+            };
+            let result = pv.optimise(direction, objective).using(microlp).solve();
+            assert_eq!(
+                result.err(),
+                Some(ResolutionError::Unbounded),
+                "expected Unbounded for an objective that can grow forever"
+            );
+        }
+    }
