+/// Property-based (hegel) tests for the canonical single-byte tags mandated
+/// by the BORSH spec: bool, Option and Result all use one byte that must be
+/// exactly 0 or 1; anything else must be rejected, never silently coerced.
+#[cfg(feature = "std")]
+mod hegel_tag_props {
+    use alloc::vec::Vec;
+    use borsh::{from_slice, to_vec};
+    use hegel::generators;
+
+    /// A bool byte deserializes to false/true for 0/1 and errors otherwise.
+    #[hegel::test]
+    fn prop_bool_byte_canonical(tc: hegel::TestCase) {
+        let b = tc.draw(generators::integers::<u8>());
+        let result = from_slice::<bool>(&[b]);
+        match b {
+            0 => assert_eq!(result.unwrap(), false),
+            1 => assert_eq!(result.unwrap(), true),
+            _ => assert!(result.is_err(), "bool byte {} accepted", b),
+        }
+    }
+
+    /// An Option tag other than 0/1 is rejected regardless of payload.
+    #[hegel::test]
+    fn prop_option_tag_canonical(tc: hegel::TestCase) {
+        let tag = tc.draw(generators::integers::<u8>());
+        let payload = tc.draw(generators::integers::<u32>());
+        let mut data: Vec<u8> = Vec::new();
+        data.push(tag);
+        data.extend_from_slice(&payload.to_le_bytes());
+        let result = from_slice::<Option<u32>>(&data);
+        match tag {
+            // tag 0 = None: the payload bytes are then trailing garbage,
+            // which `from_slice` must also reject ("Not all bytes read").
+            0 => assert!(result.is_err()),
+            1 => assert_eq!(result.unwrap(), Some(payload)),
+            _ => assert!(result.is_err(), "Option tag {} accepted", tag),
+        }
+        // and None itself round-trips
+        assert_eq!(
+            from_slice::<Option<u32>>(&to_vec(&None::<u32>).unwrap()).unwrap(),
+            None
+        );
+    }
+
+    /// A Result tag other than 0 (Err) / 1 (Ok) is rejected.
+    #[hegel::test]
+    fn prop_result_tag_canonical(tc: hegel::TestCase) {
+        let tag = tc.draw(generators::integers::<u8>());
+        let payload = tc.draw(generators::integers::<u16>());
+        let mut data: Vec<u8> = Vec::new();
+        data.push(tag);
+        data.extend_from_slice(&payload.to_le_bytes());
+        let result = from_slice::<core::result::Result<u16, u16>>(&data);
+        match tag {
+            0 => assert_eq!(result.unwrap(), Err(payload)),
+            1 => assert_eq!(result.unwrap(), Ok(payload)),
+            _ => assert!(result.is_err(), "Result tag {} accepted", tag),
+        }
+    }
+}
diff --git a/borsh/tests/roundtrip/requires_derive_category/test_combined_properties.rs b/borsh/tests/roundtrip/requires_derive_category/test_combined_properties.rs
new file mode 100644
index 00000000..99a3a483
--- /dev/null
+++ b/borsh/tests/roundtrip/requires_derive_category/test_combined_properties.rs
@@ -0,0 +1,399 @@
+//! Property-based (hegel) tests for a rich derived type combining nested
+//! structs/enums with explicit discriminants, all integer widths, floats,
+//! strings, options, tuples, arrays and the four collection types.
+//!
+//! The oracle for the wire format is an independent transcription of the
+//! BORSH specification (https://borsh.io / near/borsh#specification):
+//! - integers: little-endian, fixed width
+//! - f32/f64: IEEE-754 bits, little-endian; NaN is forbidden
+//! - bool: single byte 0 or 1
+//! - String: u32 length prefix + UTF-8 bytes
+//! - Option<T>: u8 tag 0 (None) / 1 (Some) + payload
+//! - Vec<T>: u32 length prefix + elements; fixed arrays: elements only
+//! - struct/tuple: fields in order, no framing
+//! - enum: u8 tag equal to the declared discriminant + variant fields
+//! - HashMap/HashSet/BTreeMap/BTreeSet: u32 length prefix + entries in
+//!   strictly ascending key order
+
+use alloc::{
+    boxed::Box,
+    collections::{BTreeMap, BTreeSet},
+    string::String,
+    vec::Vec,
+};
+use borsh::{from_slice, object_length, to_vec, BorshDeserialize, BorshSerialize};
+use std::collections::{HashMap, HashSet};
+
+use hegel::generators;
+
+#[derive(BorshSerialize, BorshDeserialize, Debug, Clone, PartialEq)]
+#[borsh(use_discriminant = true)]
+#[repr(u8)]
+enum Inner {
+    Unit = 2,
+    Pair(u8, i16) = 9,
+    Named { a: i64, b: Option<String> } = 17,
+}
+
+#[derive(BorshSerialize, BorshDeserialize, Debug, Clone, PartialEq)]
+struct Rich {
+    a_u8: u8,
+    a_u16: u16,
+    a_u32: u32,
+    a_u64: u64,
+    a_u128: u128,
+    b_i8: i8,
+    b_i16: i16,
+    b_i32: i32,
+    b_i64: i64,
+    b_i128: i128,
+    f_32: f32,
+    f_64: f64,
+    flag: bool,
+    text: String,
+    opt: Option<Box<Inner>>,
+    list: Vec<Inner>,
+    blob: Vec<u8>,
+    arr: [u16; 3],
+    tup: (i8, u64, String),
+    map: BTreeMap<String, Vec<u8>>,
+    set: BTreeSet<i32>,
+    hmap: HashMap<u8, u32>,
+    hset: HashSet<i64>,
+}
+
+#[hegel::composite]
+fn inners(tc: &hegel::TestCase) -> Inner {
+    let which = tc.draw(generators::integers::<u8>().max_value(2));
+    match which {
+        0 => Inner::Unit,
+        1 => Inner::Pair(
+            tc.draw(generators::integers::<u8>()),
+            tc.draw(generators::integers::<i16>()),
+        ),
+        _ => Inner::Named {
+            a: tc.draw(generators::integers::<i64>()),
+            b: tc.draw(generators::optional(generators::text())),
+        },
+    }
+}
+
+#[hegel::composite]
+fn riches(tc: &hegel::TestCase) -> Rich {
+    Rich {
+        a_u8: tc.draw(generators::integers::<u8>()),
+        a_u16: tc.draw(generators::integers::<u16>()),
+        a_u32: tc.draw(generators::integers::<u32>()),
+        a_u64: tc.draw(generators::integers::<u64>()),
+        a_u128: tc.draw(generators::integers::<u128>()),
+        b_i8: tc.draw(generators::integers::<i8>()),
+        b_i16: tc.draw(generators::integers::<i16>()),
+        b_i32: tc.draw(generators::integers::<i32>()),
+        b_i64: tc.draw(generators::integers::<i64>()),
+        b_i128: tc.draw(generators::integers::<i128>()),
+        // NaN is excluded because borsh documents (and implements) refusal to
+        // serialize NaN; infinities and signed zero remain in the domain.
+        f_32: tc.draw(generators::floats::<f32>().allow_nan(false)),
+        f_64: tc.draw(generators::floats::<f64>().allow_nan(false)),
+        flag: tc.draw(generators::booleans()),
+        text: tc.draw(generators::text()),
+        opt: tc
+            .draw(generators::optional(inners()))
+            .map(Box::new),
+        list: tc.draw(generators::vecs(inners())),
+        blob: tc.draw(generators::binary()),
+        arr: tc.draw(generators::arrays(generators::integers::<u16>())),
+        tup: (
+            tc.draw(generators::integers::<i8>()),
+            tc.draw(generators::integers::<u64>()),
+            tc.draw(generators::text()),
+        ),
+        map: tc
+            .draw(generators::vecs(generators::tuples!(
+                generators::text(),
+                generators::binary()
+            )))
+            .into_iter()
+            .collect(),
+        set: tc
+            .draw(generators::vecs(generators::integers::<i32>()))
+            .into_iter()
+            .collect(),
+        hmap: tc.draw(generators::hashmaps(
+            generators::integers::<u8>(),
+            generators::integers::<u32>(),
+        )),
+        hset: tc.draw(generators::hashsets(generators::integers::<i64>())),
+    }
+}
+
+/// Independent transcription of the BORSH spec used as the wire-format
+/// oracle. Deliberately does not call any borsh serialization code.
+mod spec {
+    use super::{BTreeMap, BTreeSet, HashMap, HashSet, Inner, Rich, String, Vec};
+    use core::convert::TryFrom;
+
+    fn len_prefix(n: usize, out: &mut Vec<u8>) {
+        out.extend_from_slice(&u32::try_from(n).unwrap().to_le_bytes());
+    }
+
+    fn string(s: &str, out: &mut Vec<u8>) {
+        len_prefix(s.len(), out);
+        out.extend_from_slice(s.as_bytes());
+    }
+
+    fn inner(v: &Inner, out: &mut Vec<u8>) {
+        match v {
+            Inner::Unit => out.push(2),
+            Inner::Pair(x, y) => {
+                out.push(9);
+                out.push(*x);
+                out.extend_from_slice(&y.to_le_bytes());
+            }
+            Inner::Named { a, b } => {
+                out.push(17);
+                out.extend_from_slice(&a.to_le_bytes());
+                match b {
+                    None => out.push(0),
+                    Some(s) => {
+                        out.push(1);
+                        string(s, out);
+                    }
+                }
+            }
+        }
+    }
+
+    pub(super) fn encode(r: &Rich) -> Vec<u8> {
+        let mut out = Vec::new();
+        out.push(r.a_u8);
+        out.extend_from_slice(&r.a_u16.to_le_bytes());
+        out.extend_from_slice(&r.a_u32.to_le_bytes());
+        out.extend_from_slice(&r.a_u64.to_le_bytes());
+        out.extend_from_slice(&r.a_u128.to_le_bytes());
+        out.extend_from_slice(&r.b_i8.to_le_bytes());
+        out.extend_from_slice(&r.b_i16.to_le_bytes());
+        out.extend_from_slice(&r.b_i32.to_le_bytes());
+        out.extend_from_slice(&r.b_i64.to_le_bytes());
+        out.extend_from_slice(&r.b_i128.to_le_bytes());
+        out.extend_from_slice(&r.f_32.to_bits().to_le_bytes());
+        out.extend_from_slice(&r.f_64.to_bits().to_le_bytes());
+        out.push(u8::from(r.flag));
+        string(&r.text, &mut out);
+        match &r.opt {
+            None => out.push(0),
+            Some(v) => {
+                out.push(1);
+                inner(v, &mut out);
+            }
+        }
+        len_prefix(r.list.len(), &mut out);
+        for v in &r.list {
+            inner(v, &mut out);
+        }
+        len_prefix(r.blob.len(), &mut out);
+        out.extend_from_slice(&r.blob);
+        for v in &r.arr {
+            out.extend_from_slice(&v.to_le_bytes());
+        }
+        out.extend_from_slice(&r.tup.0.to_le_bytes());
+        out.extend_from_slice(&r.tup.1.to_le_bytes());
+        string(&r.tup.2, &mut out);
+        encode_btreemap(&r.map, &mut out);
+        encode_btreeset(&r.set, &mut out);
+        encode_hashmap(&r.hmap, &mut out);
+        encode_hashset(&r.hset, &mut out);
+        out
+    }
+
+    fn encode_btreemap(m: &BTreeMap<String, Vec<u8>>, out: &mut Vec<u8>) {
+        // Spec: keys in strictly ascending order. Sort independently instead
+        // of trusting BTreeMap's iteration order.
+        let mut entries: Vec<(&String, &Vec<u8>)> = m.iter().collect();
+        entries.sort_unstable_by(|a, b| a.0.cmp(b.0));
+        len_prefix(entries.len(), out);
+        for (k, v) in entries {
+            string(k, out);
+            len_prefix(v.len(), out);
+            out.extend_from_slice(v);
+        }
+    }
+
+    fn encode_btreeset(s: &BTreeSet<i32>, out: &mut Vec<u8>) {
+        let mut items: Vec<i32> = s.iter().copied().collect();
+        items.sort_unstable();
+        len_prefix(items.len(), out);
+        for v in items {
+            out.extend_from_slice(&v.to_le_bytes());
+        }
+    }
+
+    fn encode_hashmap(m: &HashMap<u8, u32>, out: &mut Vec<u8>) {
+        let mut entries: Vec<(u8, u32)> = m.iter().map(|(k, v)| (*k, *v)).collect();
+        entries.sort_unstable_by_key(|(k, _)| *k);
+        len_prefix(entries.len(), out);
+        for (k, v) in entries {
+            out.push(k);
+            out.extend_from_slice(&v.to_le_bytes());
+        }
+    }
+
+    fn encode_hashset(s: &HashSet<i64>, out: &mut Vec<u8>) {
+        let mut items: Vec<i64> = s.iter().copied().collect();
+        items.sort_unstable();
+        len_prefix(items.len(), out);
+        for v in items {
+            out.extend_from_slice(&v.to_le_bytes());
+        }
+    }
+}
+
+/// serialize -> deserialize round-trip for the rich combined type.
+#[hegel::test]
+fn prop_rich_roundtrip(tc: hegel::TestCase) {
+    let value = tc.draw(riches());
+    let bytes = to_vec(&value).unwrap();
+    let decoded = from_slice::<Rich>(&bytes).unwrap();
+    assert_eq!(decoded, value);
+}
+
+/// The encoding matches an independent transcription of the BORSH spec.
+#[hegel::test]
+fn prop_rich_wire_format_matches_spec(tc: hegel::TestCase) {
+    let value = tc.draw(riches());
+    assert_eq!(to_vec(&value).unwrap(), spec::encode(&value));
+}
+
+/// `object_length` agrees with the length of the actual serialization.
+#[hegel::test]
+fn prop_rich_object_length_matches_serialized_len(tc: hegel::TestCase) {
+    let value = tc.draw(riches());
+    assert_eq!(object_length(&value).unwrap(), to_vec(&value).unwrap().len());
+}
+
+/// Canonicality, injectivity direction: distinct values have distinct
+/// encodings. Alongside independent pairs, single-field mutations of one
+/// value are generated to concentrate on near-collisions.
+#[hegel::test]
+fn prop_rich_encoding_is_injective(tc: hegel::TestCase) {
+    let x = tc.draw(riches());
+    let mode = tc.draw(generators::integers::<u8>().max_value(8));
+    let y = match mode {
+        0 => tc.draw(riches()),
+        1 => Rich {
+            a_u64: tc.draw(generators::integers::<u64>()),
+            ..x.clone()
+        },
+        2 => Rich {
+            flag: !x.flag,
+            ..x.clone()
+        },
+        3 => Rich {
+            text: tc.draw(generators::text()),
+            ..x.clone()
+        },
+        4 => Rich {
+            opt: tc.draw(generators::optional(inners())).map(Box::new),
+            ..x.clone()
+        },
+        5 => Rich {
+            list: tc.draw(generators::vecs(inners())),
+            ..x.clone()
+        },
+        6 => Rich {
+            map: tc
+                .draw(generators::vecs(generators::tuples!(
+                    generators::text(),
+                    generators::binary()
+                )))
+                .into_iter()
+                .collect(),
+            ..x.clone()
+        },
+        7 => Rich {
+            hmap: tc.draw(generators::hashmaps(
+                generators::integers::<u8>(),
+                generators::integers::<u32>(),
+            )),
+            ..x.clone()
+        },
+        _ => Rich {
+            f_64: tc.draw(generators::floats::<f64>().allow_nan(false)),
+            ..x.clone()
+        },
+    };
+    if x != y {
+        assert_ne!(to_vec(&x).unwrap(), to_vec(&y).unwrap());
+    }
+}
+
+/// Every strict prefix of a valid encoding must fail to deserialize:
+/// the format is deterministic, so a truncated buffer either hits EOF or
+/// (via `from_slice`'s full-consumption check) leaves the parse short.
+#[hegel::test]
+fn prop_rich_strict_prefix_rejected(tc: hegel::TestCase) {
+    let value = tc.draw(riches());
+    let bytes = to_vec(&value).unwrap();
+    // Rich always encodes to at least its fixed-width fields, so len > 0.
+    let cut = tc.draw(generators::integers::<usize>().max_value(bytes.len() - 1));
+    assert!(
+        from_slice::<Rich>(&bytes[..cut]).is_err(),
+        "prefix of length {} of a {}-byte encoding decoded successfully",
+        cut,
+        bytes.len()
+    );
+}
+
+/// A map-free rich type: for these, borsh's deserializer must accept only
+/// canonical encodings even under default features (map/set key ordering is
+/// the one place where rejection is gated behind `de_strict_order`).
+#[derive(BorshSerialize, BorshDeserialize, Debug, Clone, PartialEq)]
+struct Plain {
+    n: u32,
+    f: f32,
+    flag: bool,
+    text: String,
+    opt: Option<u16>,
+    inner: Inner,
+    bytes: Vec<u8>,
+}
+
+#[hegel::composite]
+fn plains(tc: &hegel::TestCase) -> Plain {
+    Plain {
+        n: tc.draw(generators::integers::<u32>()),
+        f: tc.draw(generators::floats::<f32>().allow_nan(false)),
+        flag: tc.draw(generators::booleans()),
+        text: tc.draw(generators::text()),
+        opt: tc.draw(generators::optional(generators::integers::<u16>())),
+        inner: tc.draw(inners()),
+        bytes: tc.draw(generators::binary()),
+    }
+}
+
+/// Canonical-acceptance property (validation/rejection pattern): any byte
+/// string the deserializer accepts must re-serialize to exactly the same
+/// bytes. Inputs are single-byte corruptions of valid encodings (to land
+/// near the accept/reject boundary) plus arbitrary byte strings.
+#[hegel::test(test_cases = 300)]
+fn prop_plain_accepted_bytes_are_canonical(tc: hegel::TestCase) {
+    let corrupt = tc.draw(generators::booleans());
+    let data: Vec<u8> = if corrupt {
+        let value = tc.draw(plains());
+        let mut bytes = to_vec(&value).unwrap();
+        let idx = tc.draw(generators::integers::<usize>().max_value(bytes.len() - 1));
+        let new_byte = tc.draw(generators::integers::<u8>());
+        bytes[idx] = new_byte;
+        bytes
+    } else {
+        tc.draw(generators::binary())
+    };
+    // Must never panic; if accepted, must be the canonical encoding.
+    if let Ok(decoded) = from_slice::<Plain>(&data) {
+        assert_eq!(
+            to_vec(&decoded).unwrap(),
+            data,
+            "deserializer accepted a non-canonical encoding"
+        );
+    }
+}
