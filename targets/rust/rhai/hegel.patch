+/// Property: with expression-depth limits configured anywhere up to the
+/// build's own defaults, compiling an arbitrarily deeply nested (but
+/// syntactically valid) expression never panics or overflows the stack — it
+/// either compiles or fails with `ParseErrorType::ExprTooDeep`.
+///
+/// Evidence: `set_max_expr_depths` exists to bound parser recursion, and
+/// `test_stack_overflow_parsing` above pins specific instances.
+///
+/// The drawn limits are capped at the build's *default* limits: an earlier
+/// version of this property drew limits up to 200 and found that e.g.
+/// `set_max_expr_depths(187, 187)` with a 185-term `1 + 1 + ...` chain
+/// overflows a standard 2 MiB test-thread stack in a debug build (see
+/// `test_expr_depth_reproducer_stack_overflow` below). That is not a
+/// violation of a documented contract — the safe limit is deliberately
+/// build-dependent (debug default 32 vs release 64, src/api/limits.rs), and
+/// matching the limit to the available stack is the caller's job — but it is
+/// why this generator does not exceed the defaults.
+#[hegel::test]
+fn test_expr_depth_limit_never_panics(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let default_engine = Engine::new();
+    let max_expr_depth = tc.draw(
+        generators::integers::<usize>()
+            .min_value(1)
+            .max_value(default_engine.max_expr_depth()),
+    );
+    #[cfg(not(feature = "no_function"))]
+    let max_fn_expr_depth = tc.draw(
+        generators::integers::<usize>()
+            .min_value(1)
+            .max_value(default_engine.max_function_expr_depth()),
+    );
+    let nesting = tc.draw(generators::integers::<usize>().max_value(400));
+
+    // Several shapes of deep nesting.
+    let script = match tc.draw(generators::integers::<u8>().max_value(3)) {
+        0 => format!("{}1{}", "(".repeat(nesting), ")".repeat(nesting)),
+        1 => format!("{}1", "1 + ".repeat(nesting)),
+        2 => format!("{}1", "- ".repeat(nesting)),
+        _ => format!("{}1{}", "!(".repeat(nesting), ")".repeat(nesting)),
+    };
+
+    let mut engine = Engine::new();
+    engine.set_max_expr_depths(
+        max_expr_depth,
+        #[cfg(not(feature = "no_function"))]
+        max_fn_expr_depth,
+    );
+
+    match engine.compile(&script) {
+        Ok(_) => (),
+        Err(err) => assert_eq!(
+            *err.err_type(),
+            ParseErrorType::ExprTooDeep,
+            "unexpected parse error for nesting {} with limit {}: {}",
+            nesting,
+            max_expr_depth,
+            err
+        ),
+    }
+}
+
+/// Minimal reproducer for a finding of the property test above when its
+/// limits generator went beyond the build's defaults: raising the expression
+/// depth limit to 187 and parsing a 185-term `+` chain overflows a 2 MiB
+/// thread stack in a debug build, aborting the whole process (which is why
+/// this cannot be left as a normally-failing test).
+///
+/// This is judged to be outside rhai's documented contract rather than a
+/// library bug — `set_max_expr_depths` makes no stack-safety promise (0 even
+/// means "unlimited"), and the deliberately smaller debug-build defaults
+/// (32/16 vs 64/32) plus the fuzz harnesses' choice of `(50, 5)` show the
+/// safe range is understood to depend on build and stack size. Kept ignored
+/// as documentation.
+#[test]
+#[ignore = "aborts the process by design of the experiment: stack overflow on a 2 MiB thread in debug builds"]
+fn test_expr_depth_reproducer_stack_overflow() {
+    std::thread::Builder::new()
+        .stack_size(2 * 1024 * 1024)
+        .spawn(|| {
+            let mut engine = Engine::new();
+            engine.set_max_expr_depths(
+                187,
+                #[cfg(not(feature = "no_function"))]
+                187,
+            );
+            let script = format!("{}1", "1 + ".repeat(185));
+            let _ = engine.compile(&script);
+        })
+        .unwrap()
+        .join()
+        .unwrap();
+}
