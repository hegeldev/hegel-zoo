+mod common;
+
+/// Property: `Engine::compile` never panics, whatever the input text —
+/// arbitrary Unicode or script-shaped token soup.
+///
+/// Evidence: `compile` returns `ParseResult` (it promises errors, not
+/// panics), and `fuzz/fuzz_targets/scripting.rs` feeds arbitrary strings to
+/// `compile` for exactly this reason.
+#[hegel::test]
+fn test_compile_never_panics_on_arbitrary_input(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let script = if tc.draw(generators::booleans()) {
+        tc.draw(generators::text())
+    } else {
+        common::token_soup(&tc)
+    };
+    let engine = Engine::new();
+    let _ = engine.compile(&script);
+}
+
+/// Property: `Engine::compact_script` output is semantically identical to
+/// its input, per its documentation ("The output script is semantically
+/// identical to the input script, except smaller in size.").
+///
+/// Evidence: doc-comment on `compact_script` (src/api/formatting.rs); commit
+/// fcb384fd fixed compact_script fusing adjacent operators (`< -` -> `<-`),
+/// which is exactly the bug class this property targets.
+#[hegel::test]
+fn test_compact_script_preserves_semantics(tc: hegel::TestCase) {
+    use std::mem::discriminant;
+
+    let script = common::arbitrary_script(&tc);
+    let engine = Engine::new();
+
+    let compacted = engine
+        .compact_script(&script)
+        .unwrap_or_else(|e| panic!("compact_script failed on well-formed script:\n{}\nerror: {}", script, e));
+
+    let original = engine.eval::<INT>(&script).map_err(|e| discriminant(&*e));
+    let compact = engine.eval::<INT>(&compacted).map_err(|e| discriminant(&*e));
+
+    assert_eq!(
+        original, compact,
+        "compacting changed semantics.\noriginal script:\n{}\ncompacted:\n{}",
+        script, compacted
+    );
+}
+
+/// Property: if a script compiles, then its compacted form also compiles.
+/// Runs on token soup with randomized whitespace, which explores exactly the
+/// token-adjacency space where compact_script previously produced invalid
+/// output (commit fcb384fd: `< -` fused into `<-`).
+#[hegel::test]
+fn test_compact_script_output_recompiles(tc: hegel::TestCase) {
+    let script = common::token_soup(&tc);
+    let engine = Engine::new();
+
+    if engine.compile(&script).is_ok() {
+        let compacted = engine
+            .compact_script(&script)
+            .unwrap_or_else(|e| panic!("compact_script failed on compilable script:\n{}\nerror: {}", script, e));
+        engine.compile(&compacted).unwrap_or_else(|e| {
+            panic!(
+                "compacted output no longer compiles.\noriginal:\n{}\ncompacted:\n{}\nerror: {}",
+                script, compacted, e
+            )
+        });
+    }
+}
