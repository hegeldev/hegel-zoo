+/// literal, so every `INT`, including `INT::MIN`, has a literal spelling.
+#[hegel::test]
+fn test_int_literal_display_roundtrip(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let n: INT = tc.draw(hegel::one_of!(
+        generators::integers::<INT>(),
+        generators::sampled_from(vec![INT::MIN, INT::MIN + 1, -1, 0, 1, INT::MAX - 1, INT::MAX]),
