+/// Pinned (uv-pep508/4, pep508_rs/8): on a pre-release interpreter (`python_full_version = 3.13.0rc1`,
+/// `python_version = 3.13`) the `python_version` markers must read the `X.Y` string — PEP 508
+/// defines `python_version` as `'.'.join(platform.python_version_tuple()[:2])`, and the crate's
+/// own algebra notes that "`python_version` cannot take on pre-release values". The crate
+/// lowers `python_version == '3.13'` to the release-only range `python_full_version == '3.13.*'`
+/// and then tests the environment's real `3.13.0rc1` against it — false; `python_version <
+/// '3.13'` is true. `packaging` agrees with the spec.
+#[hegel::test]
+fn python_version_markers_hold_on_pre_release_interpreters(tc: TestCase) {
+    let minor = n(&tc, 5, 14);
+    let suffix = pick(&tc, &["rc1", "a2", "b1", "rc3"]);
+    let python = format!("3.{minor}");
+    let env = env_with("6.12.93", &python, &format!("3.{minor}.0{suffix}"));
+    let cases = [
+        (format!("python_version == '{python}'"), true),
+        (format!("python_version >= '{python}'"), true),
+        (format!("python_version != '{python}'"), false),
+        (format!("python_version < '{python}'"), false),
+        (format!("python_version <= '3.{}'", minor - 1), false),
+        (format!("python_version > '3.{}'", minor - 1), true),
+    ];
+    for (text, expected) in cases {
+        assert_eq!(py_marker(&text, &env, None), Ok(Some(expected)), "{text:?} (packaging)");
+        let tree = MarkerTree::from_str(&text).unwrap();
+        assert_eq!(rs_marker(&tree, &env, &None), expected, "{text:?} in {env:?}");
+    }
+}
