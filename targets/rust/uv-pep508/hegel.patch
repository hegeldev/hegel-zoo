+/// Three-component versions without a wildcard compare with `python_version` under PEP 440
+/// (kept from `pep508_rs`, where it separated pep508_rs/4 and /6 from the plain operators).
+#[hegel::test]
+fn python_version_compares_with_three_component_versions(tc: TestCase) {
+    let minor = n(&tc, 5, 14);
+    let env = env_with("6.12.93", &format!("3.{minor}"), &format!("3.{minor}.{}", n(&tc, 0, 9)));
+    let op = pick(&tc, &["==", "!=", "<", "<=", ">", ">="]);
+    let text = format!("python_version {op} '3.{}.{}'", n(&tc, 5, 14), n(&tc, 0, 2));
+    let expected = py_marker(&text, &env, None).unwrap().unwrap();
+    let m = MarkerTree::from_str(&text).unwrap();
+    assert_eq!(rs_marker(&m, &env, &None), expected, "{text:?} for Python 3.{minor} (tree {:?})", m.try_to_string());
+}
+
+/// Holds in `uv-pep508` (pep508_rs/5 was fixed in the fork): `MarkerTree` is documented as
+/// canonical ("any two functionally equivalent markers will compare equally"), and the deprecated
+/// spellings (`os.name`, `sys.platform`, `platform.version`, `platform.machine`,
+/// `platform.python_implementation`, `python_implementation`) make the same trees as their
+/// current spellings, so `Display` re-parses to an equal tree.
+#[hegel::test]
+fn deprecated_marker_spellings_are_canonical(tc: TestCase) {
+    let old = MarkerTree::from_str("os.name == 'posix'").unwrap();
+    let new = MarkerTree::from_str("os_name == 'posix'").unwrap();
+    assert_eq!(old.try_to_string(), new.try_to_string());
+    assert_eq!(old, new, "os.name vs os_name");
+    let (dep, current) = pick(
+        &tc,
+        &[
+            ("os.name", "os_name"),
+            ("sys.platform", "sys_platform"),
+            ("platform.version", "platform_version"),
+            ("platform.machine", "platform_machine"),
+            ("platform.python_implementation", "platform_python_implementation"),
+            ("python_implementation", "platform_python_implementation"),
+        ],
+    );
+    let op = pick(&tc, &STRING_OPS);
+    let value = pick(&tc, &WORDS);
+    let a = MarkerTree::from_str(&format!("{dep} {op} '{value}'")).unwrap();
+    let b = MarkerTree::from_str(&format!("{current} {op} '{value}'")).unwrap();
+    assert_eq!(a, b, "{dep} vs {current}");
+    let shown = a.try_to_string().unwrap();
+    assert_eq!(MarkerTree::from_str(&shown).unwrap(), a, "Display {shown:?} of {dep} re-parses differently");
+}
+
+/// Holds in `uv-pep508` (pep508_rs/6 was fixed in the fork): `python_version ~= '3.5.0'` means
+/// `>= 3.5.0, == 3.5.*` (PEP 440), so it is false for Python 3.6; the fork's tree is
+/// `python_full_version == '3.5.*'`, where `pep508_rs`'s was `>= '3.5' and < '4'`.
+#[hegel::test]
+fn tilde_equal_on_python_version_keeps_its_last_component(tc: TestCase) {
+    let env = env_with("6.12.93", "3.6", "3.6.0");
+    let text = "python_version ~= '3.5.0'";
+    assert_eq!(py_marker(text, &env, None), Ok(Some(false)));
+    let m = MarkerTree::from_str(text).unwrap();
+    assert!(!rs_marker(&m, &env, &None), "{text:?} for Python 3.6 (tree {:?})", m.try_to_string());
+    let minor = n(&tc, 5, 14);
+    let env = env_with("6.12.93", &format!("3.{minor}"), &format!("3.{minor}.{}", n(&tc, 0, 9)));
+    let text = format!("python_version ~= '3.{}.{}'", n(&tc, 5, 14), n(&tc, 0, 2));
+    let expected = py_marker(&text, &env, None).unwrap().unwrap();
+    let m = MarkerTree::from_str(&text).unwrap();
+    assert_eq!(rs_marker(&m, &env, &None), expected, "{text:?} for Python 3.{minor} (tree {:?})", m.try_to_string());
+}
+
+/// Holds in `uv-pep508` (pep508_rs/7 was fixed in the fork): an extra ending in `-`, `_` or `.`
+/// (`a[b.]`) is invalid for PEP 508; `pep508_rs`'s extras parser accepted the characters and then
+/// `expect`ed the name to validate, so `Requirement::from_str` panicked — the fork checks the last
+/// character and returns "Extra name must end with an alphanumeric character". (`packaging`
+/// agrees for `-` and `.`; it accepts `a[b_]` through its `\b` tokenizer, see
+/// `packaging_underscore_leniency`.)
+#[hegel::test]
+fn extras_ending_in_a_separator_are_an_error_not_a_panic(tc: TestCase) {
+    assert!(py_requirement("a[b.]").is_none());
+    let parsed = std::panic::catch_unwind(|| Requirement::<VerbatimUrl>::from_str("a[b.]").is_err());
+    assert_eq!(parsed.ok(), Some(true), "`a[b.]`: panicked or accepted");
+    let sep = pick(&tc, &["-", "_", "."]);
+    let text = format!("{}[{}{}{sep}{}]", arb_name(&tc), ws(&tc), arb_name(&tc), ws(&tc));
+    if sep != "_" {
+        assert!(py_requirement(&text).is_none(), "{text:?} accepted by packaging");
+    }
+    let parsed = std::panic::catch_unwind(|| Requirement::<VerbatimUrl>::from_str(&text).is_err());
+    assert_eq!(parsed.ok(), Some(true), "{text:?}: panicked or accepted");
+}
