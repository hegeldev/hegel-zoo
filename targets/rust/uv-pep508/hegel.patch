+//! Hegel properties for `uv-pep508` — uv's fork of `pep508_rs` — with `packaging` (the PyPA
+//! reference implementation of dependency specifiers and environment markers) as the oracle,
+//! driven as one persistent `python3` child: `packaging.requirements.Requirement` for the
+//! grammar and the parsed parts, `packaging.markers.Marker.evaluate` for marker semantics on
+//! random environments. The marker algebra (`negate`, `and`, `or`, `is_true`, `is_false`,
+//! `is_disjoint`, `Display`) is checked against the crate's own `evaluate` on sampled
+//! environments.
+//!
+//! This is the zoo's `pep508_rs` test file ported to the fork (`MarkerTree` is `Copy` here and
+//! `and`/`or` return the combined tree; `ExtraName` lives in `uv-normalize`). Four of
+//! `pep508_rs`'s eight pinned bugs are fixed in the fork and hold here as regular properties;
+//! two bugs are new (uv-pep508/5, /6).
+//! The fork also reasons about the platform variables jointly: `platform_system == 'Linux'`
+//! is the node `sys_platform == 'linux'` (likewise Windows/win32, Darwin/darwin, AIX, Android,
+//! Emscripten) and known-incompatible pairs such as `os_name == 'nt' and sys_platform ==
+//! 'linux'` are `false` — so the generated environments keep `os_name`, `sys_platform` and
+//! `platform_system` consistent, as real interpreters do.
+
+use std::collections::BTreeSet;
+use std::fmt::Debug;
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::str::FromStr;
+use std::sync::{Mutex, OnceLock};
+
+use hegel::{generators, Generator, TestCase};
+use uv_normalize::ExtraName;
+use uv_pep508::{
+    MarkerEnvironment, MarkerEnvironmentBuilder, MarkerTree, Requirement, VerbatimUrl, VersionOrUrl,
+};
+
+// --------------------------------------------------------------------------- the Python oracle
+
+const ORACLE_SCRIPT: &str = r#"
+import sys
+from packaging.requirements import Requirement, InvalidRequirement
+from packaging.markers import Marker, InvalidMarker, UndefinedComparison, UndefinedEnvironmentName
+from packaging.utils import canonicalize_name
+
+KEYS = ['implementation_name', 'implementation_version', 'os_name', 'platform_machine',
+        'platform_python_implementation', 'platform_release', 'platform_system',
+        'platform_version', 'python_full_version', 'python_version', 'sys_platform']
+
+def dec(h):
+    return bytes.fromhex(h).decode('utf-8')
+
+def enc(s):
+    return s.encode('utf-8').hex()
+
+for line in sys.stdin:
+    parts = line.rstrip('\n').split(' ')
+    cmd, args = parts[0], [dec(p) for p in parts[1:]]
+    try:
+        if cmd == 'R':
+            r = Requirement(args[0])
+            extras = ','.join(sorted(canonicalize_name(e) for e in r.extras))
+            specs = ','.join(sorted(str(s) for s in r.specifier))
+            out = ['ok', canonicalize_name(r.name), extras, specs, r.url or '', str(r.marker) if r.marker is not None else '']
+        elif cmd == 'M':
+            env = dict(zip(KEYS, args[1:12]))
+            if len(args) > 12:
+                env['extra'] = args[12]
+            try:
+                out = ['ok', 'true' if Marker(args[0]).evaluate(env) else 'false']
+            except (UndefinedComparison, UndefinedEnvironmentName):
+                out = ['undef']
+        elif cmd == 'C':
+            out = ['ok', canonicalize_name(args[0])]
+        else:
+            out = ['bad', cmd]
+    except (InvalidRequirement, InvalidMarker):
+        out = ['err']
+    print(' '.join([out[0]] + [enc(x) for x in out[1:]]), flush=True)
+"#;
+
+struct Oracle {
+    child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+static ORACLE: OnceLock<Mutex<Oracle>> = OnceLock::new();
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|b| format!("{b:02x}")).collect()
+}
+
+fn unhex(h: &str) -> String {
+    let bytes: Vec<u8> = (0..h.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&h[i..i + 2], 16).unwrap())
+        .collect();
+    String::from_utf8(bytes).unwrap()
+}
+
+fn oracle() -> &'static Mutex<Oracle> {
+    ORACLE.get_or_init(|| {
+        let mut child = Command::new("python3")
+            .arg("-u")
+            .arg("-c")
+            .arg(ORACLE_SCRIPT)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .expect("python3 with the `packaging` module is needed as the PEP 508 oracle");
+        let stdin = child.stdin.take().unwrap();
+        let stdout = BufReader::new(child.stdout.take().unwrap());
+        Mutex::new(Oracle {
+            child,
+            stdin,
+            stdout,
+        })
+    })
+}
+
+/// Ask the oracle; returns the status (`ok`, `err`, `undef`) and the decoded fields.
+fn ask(cmd: &str, args: &[&str]) -> (String, Vec<String>) {
+    let mut o = oracle().lock().unwrap();
+    let mut line = cmd.to_string();
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a));
+    }
+    line.push('\n');
+    o.stdin.write_all(line.as_bytes()).expect("oracle stdin");
+    let mut reply = String::new();
+    let n = o.stdout.read_line(&mut reply).expect("oracle stdout");
+    if n == 0 {
+        let status = o.child.try_wait().ok().flatten();
+        panic!("the Python oracle exited ({status:?}); is `packaging` installed for python3?");
+    }
+    let mut it = reply.trim_end_matches(['\n', '\r']).split(' ');
+    let status = it.next().unwrap().to_string();
+    assert!(
+        matches!(status.as_str(), "ok" | "err" | "undef"),
+        "oracle said {reply:?} to {line:?}"
+    );
+    (status, it.map(unhex).collect())
+}
+
+/// A requirement as `packaging` sees it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct PyReq {
+    name: String,
+    extras: BTreeSet<String>,
+    specs: BTreeSet<String>,
+    url: String,
+    marker: String,
+}
+
+fn py_requirement(text: &str) -> Option<PyReq> {
+    let (status, f) = ask("R", &[text]);
+    if status != "ok" {
+        return None;
+    }
+    let set = |s: &str| -> BTreeSet<String> {
+        s.split(',')
+            .filter(|s| !s.is_empty())
+            .map(str::to_string)
+            .collect()
+    };
+    Some(PyReq {
+        name: f[0].clone(),
+        extras: set(&f[1]),
+        specs: set(&f[2]),
+        url: f[3].clone(),
+        marker: f[4].clone(),
+    })
+}
+
+/// `Marker(text).evaluate(env)`: `Ok(Some(b))`, `Ok(None)` when packaging raises an
+/// undefined-comparison error, `Err(())` when the marker does not parse.
+fn py_marker(text: &str, env: &Env, extra: Option<&str>) -> Result<Option<bool>, ()> {
+    let mut args: Vec<&str> = vec![text];
+    args.extend(env.values.iter().map(String::as_str));
+    if let Some(e) = extra {
+        args.push(e);
+    }
+    let (status, f) = ask("M", &args);
+    match status.as_str() {
+        "ok" => Ok(Some(f[0] == "true")),
+        "undef" => Ok(None),
+        _ => Err(()),
+    }
+}
+
+// --------------------------------------------------------------------------- helpers
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+fn n(tc: &TestCase, lo: usize, hi: usize) -> usize {
+    tc.draw(int!(lo as i64, hi as i64)) as usize
+}
+
+fn pick<T: Clone + Debug + Send + Sync + 'static>(tc: &TestCase, items: &[T]) -> T {
+    tc.draw(generators::sampled_from(items.to_vec()).print_as_debug())
+}
+
+fn chance(tc: &TestCase, k: usize) -> bool {
+    n(tc, 1, k) == 1
+}
+
+fn arb_chars(tc: &TestCase, alphabet: &str, lo: usize, hi: usize) -> String {
+    let chars: Vec<char> = alphabet.chars().collect();
+    (0..n(tc, lo, hi)).map(|_| pick(tc, &chars)).collect()
+}
+
+/// PEP 508 `wsp*`: spaces and tabs.
+fn ws(tc: &TestCase) -> String {
+    pick(tc, &["", "", " ", " ", "  ", "\t"]).to_string()
+}
+
+const ALNUM: &str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+
+/// A PEP 508 name: alphanumerics with inner `.`, `-`, `_`, not archive-like.
+fn arb_name(tc: &TestCase) -> String {
+    let mut s = arb_chars(tc, ALNUM, 1, 1);
+    let inner = n(tc, 0, 6);
+    for _ in 0..inner {
+        s.push_str(pick(tc, &["a", "b", "z", "Q", "0", "7", ".", "-", "_"]));
+    }
+    if inner > 0 {
+        s.push_str(&arb_chars(tc, ALNUM, 1, 1));
+    }
+    // `foo.tar`, `foo.zip`, … are refused by the crate as unnamed archive requirements.
+    for ext in [".whl", ".tbz", ".txz", ".tlz", ".zip", ".tgz", ".tar", ".bz2", ".xz", ".lz", ".lzma", ".gz"] {
+        if s.to_lowercase().ends_with(ext) {
+            s.push('x');
+        }
+    }
+    s
+}
+
+/// PEP 503 normalisation, what `packaging.utils.canonicalize_name` does.
+fn canonical(name: &str) -> String {
+    let mut out = String::new();
+    let mut sep = false;
+    for c in name.chars() {
+        if matches!(c, '-' | '_' | '.') {
+            sep = true;
+        } else {
+            if sep && !out.is_empty() {
+                out.push('-');
+            }
+            sep = false;
+            out.push(c.to_ascii_lowercase());
+        }
+    }
+    out
+}
+
+/// A canonical PEP 440 version for specifiers: `N(.N){0,3}` with an occasional epoch,
+/// pre-, post- or dev-release; never a local segment (`==` with locals is its own topic).
+fn arb_version(tc: &TestCase, min_components: usize) -> String {
+    let k = n(tc, min_components.max(1), 4);
+    let mut s = String::new();
+    if chance(tc, 12) {
+        s.push_str(&format!("{}!", n(tc, 1, 2)));
+    }
+    for i in 0..k {
+        if i > 0 {
+            s.push('.');
+        }
+        s.push_str(&pick(tc, &[0, 1, 2, 3, 8, 10, 12, 2024]).to_string());
+    }
+    if chance(tc, 8) {
+        s.push_str(pick(tc, &["a1", "b2", "rc1", "rc10"]));
+    }
+    if chance(tc, 10) {
+        s.push_str(pick(tc, &[".post1", ".post0"]));
+    }
+    if chance(tc, 10) {
+        s.push_str(pick(tc, &[".dev0", ".dev3"]));
+    }
+    s
+}
+
+// --------------------------------------------------------------------------- environments
+
+const OS_NAMES: [&str; 3] = ["posix", "nt", "java"];
+const SYS_PLATFORMS: [&str; 6] = ["linux", "darwin", "win32", "linux2", "cygwin", "emscripten"];
+const SYSTEMS: [&str; 4] = ["Linux", "Darwin", "Windows", "FreeBSD"];
+/// Consistent (`os_name`, `sys_platform`, `platform_system`) triples, as CPython reports them:
+/// the crate treats `platform_system` as a spelling of `sys_platform` for the well-known
+/// systems and knows which pairs never occur together (`src/marker/algebra.rs`), so an
+/// environment drawn field by field would be one no interpreter produces.
+const PLATFORMS: [(&str, &str, &str); 7] = [
+    ("posix", "linux", "Linux"),
+    ("posix", "darwin", "Darwin"),
+    ("nt", "win32", "Windows"),
+    ("posix", "freebsd14", "FreeBSD"),
+    ("posix", "cygwin", "CYGWIN_NT-10.0"),
+    ("posix", "emscripten", "Emscripten"),
+    ("java", "java1.8.0_301", "Java"),
+];
+const MACHINES: [&str; 6] = ["x86_64", "aarch64", "arm64", "AMD64", "i686", "ppc64le"];
+const IMPLEMENTATIONS: [&str; 3] = ["CPython", "PyPy", "Jython"];
+const IMPLEMENTATION_NAMES: [&str; 3] = ["cpython", "pypy", "ironpython"];
+const RELEASES: [&str; 6] = ["6.12.93", "5.15.0", "22.6.0", "10", "6.8.0", "24.1.0"];
+const PLATFORM_VERSIONS: [&str; 3] = ["#1 SMP", "Darwin Kernel Version 22.6.0", "10.0.19041"];
+
+/// A marker environment: the eleven values in `KEYS` order.
+#[derive(Clone, Debug)]
+struct Env {
+    values: Vec<String>,
+}
+
+impl Env {
+    fn marker_environment(&self) -> MarkerEnvironment {
+        MarkerEnvironment::try_from(MarkerEnvironmentBuilder {
+            implementation_name: &self.values[0],
+            implementation_version: &self.values[1],
+            os_name: &self.values[2],
+            platform_machine: &self.values[3],
+            platform_python_implementation: &self.values[4],
+            platform_release: &self.values[5],
+            platform_system: &self.values[6],
+            platform_version: &self.values[7],
+            python_full_version: &self.values[8],
+            python_version: &self.values[9],
+            sys_platform: &self.values[10],
+        })
+        .unwrap()
+    }
+}
+
+#[hegel::composite]
+fn arb_env(tc: &TestCase) -> Env {
+    // Final releases only: pre-release interpreters are pinned (pep508_rs/8).
+    let minor = n(tc, 6, 14);
+    let micro = n(tc, 0, 12);
+    let full = format!("3.{minor}.{micro}");
+    let (os_name, sys_platform, platform_system) = pick(tc, &PLATFORMS);
+    let values = vec![
+        pick(tc, &IMPLEMENTATION_NAMES).to_string(),
+        full.clone(),
+        os_name.to_string(),
+        pick(tc, &MACHINES).to_string(),
+        pick(tc, &IMPLEMENTATIONS).to_string(),
+        pick(tc, &RELEASES).to_string(),
+        platform_system.to_string(),
+        pick(tc, &PLATFORM_VERSIONS).to_string(),
+        full,
+        format!("3.{minor}"),
+        sys_platform.to_string(),
+    ];
+    Env { values }
+}
+
+const EXTRA_SPELLINGS: [&str; 8] = ["test", "Test", "dev", "all", "x_y", "x-y", "X.Y", "socks5"];
+
+fn arb_extra(tc: &TestCase) -> Option<String> {
+    if chance(tc, 3) {
+        None
+    } else {
+        Some(pick(tc, &EXTRA_SPELLINGS).to_string())
+    }
+}
+
+fn extras_of(extra: &Option<String>) -> Vec<ExtraName> {
+    extra
+        .iter()
+        .map(|e| ExtraName::from_str(e).unwrap())
+        .collect()
+}
+
+// --------------------------------------------------------------------------- markers
+
+const VERSION_KEYS: [&str; 3] = ["python_version", "python_full_version", "implementation_version"];
+const STRING_KEYS: [&str; 8] = [
+    "os_name",
+    "sys_platform",
+    "platform_system",
+    "platform_machine",
+    "platform_python_implementation",
+    "implementation_name",
+    "platform_version",
+    "platform_release",
+];
+const DEPRECATED_KEYS: [&str; 6] = [
+    "os.name",
+    "sys.platform",
+    "platform.version",
+    "platform.machine",
+    "platform.python_implementation",
+    "python_implementation",
+];
+const VERSION_OPS: [&str; 7] = ["==", "!=", "<", "<=", ">", ">=", "~="];
+const STRING_OPS: [&str; 4] = ["==", "!=", "in", "not in"];
+const ORDER_OPS: [&str; 4] = ["<", "<=", ">", ">="];
+const WORDS: [&str; 10] = ["linux", "lin", "win", "posix", "nt", "x86", "CPython", "Linux", "arm", "z"];
+
+fn quote(tc: &TestCase, s: &str) -> String {
+    let q = if chance(tc, 2) { '\'' } else { '"' };
+    format!("{q}{s}{q}")
+}
+
+/// A marker version literal: 2–3 components, occasionally a pre-release or `.*`.
+fn arb_marker_version(tc: &TestCase, allow_star: bool) -> String {
+    let mut s = format!("3.{}", n(tc, 5, 14));
+    if chance(tc, 3) {
+        s.push_str(&format!(".{}", n(tc, 0, 5)));
+    }
+    // No pre-, post- or dev-release segments: the crate documents dropping them from marker
+    // literals (`normalize_specifier` in `src/marker/algebra.rs`), a deliberate deviation.
+    if allow_star && chance(tc, 4) {
+        s.push_str(".*");
+    }
+    s
+}
+
+/// `X.Y.Z.*` with `Z != 0`: no `python_version` (an `X.Y` string) can match it.
+fn unsatisfiable_wildcard(version: &str) -> bool {
+    let parts: Vec<&str> = version.split('.').collect();
+    parts.len() == 4 && parts[3] == "*" && parts[2] != "0"
+}
+
+/// One well-formed marker expression, of a shape both implementations define alike.
+fn arb_marker_expr(tc: &TestCase) -> String {
+    let sp = |tc: &TestCase| pick(tc, &[" ", " ", " ", "  ", "\t"]).to_string();
+    match n(tc, 0, 9) {
+        0 | 1 | 2 => {
+            // version key <op> 'version'
+            let key = pick(tc, &VERSION_KEYS);
+            let op = pick(tc, &VERSION_OPS);
+            let star = matches!(op, "==" | "!=");
+            // (`~=` and wildcards with a third component on python_version were pep508_rs/6
+            // and pep508_rs/4; both are fixed in the fork, so every shape is generated —
+            // except `python_version != 'X.Y.Z.*'` with `Z != 0`, pinned as uv-pep508/5)
+            let mut version = arb_marker_version(tc, star);
+            if key == "python_version" && op == "!=" && unsatisfiable_wildcard(&version) {
+                version = format!("3.{}.*", n(tc, 5, 14));
+            }
+            format!("{key}{}{op}{}{}", sp(tc), sp(tc), quote(tc, &version))
+        }
+        3 => {
+            // 'version' <op> version key (inverted)
+            let key = pick(tc, &VERSION_KEYS);
+            let op = pick(tc, &VERSION_OPS[..6]);
+            let version = arb_marker_version(tc, false);
+            format!("{}{}{op}{}{key}", quote(tc, &version), sp(tc), sp(tc))
+        }
+        4 | 5 => {
+            // string key ==/!=/in/not in 'word'
+            let key = pick(tc, &STRING_KEYS);
+            let op = pick(tc, &STRING_OPS);
+            let pool: Vec<&str> = match key {
+                "os_name" => OS_NAMES.to_vec(),
+                "sys_platform" => SYS_PLATFORMS.to_vec(),
+                "platform_system" => SYSTEMS.to_vec(),
+                "platform_machine" => MACHINES.to_vec(),
+                "platform_python_implementation" => IMPLEMENTATIONS.to_vec(),
+                "implementation_name" => IMPLEMENTATION_NAMES.to_vec(),
+                "platform_version" => PLATFORM_VERSIONS.to_vec(),
+                _ => RELEASES.to_vec(),
+            };
+            let value = if chance(tc, 3) {
+                pick(tc, &WORDS).to_string()
+            } else if matches!(op, "in" | "not in") && chance(tc, 2) {
+                format!("{} {}", pick(tc, &pool), pick(tc, &pool))
+            } else {
+                pick(tc, &pool).to_string()
+            };
+            format!("{key}{}{op}{}{}", sp(tc), sp(tc), quote(tc, &value))
+        }
+        6 => {
+            // 'word' ==/!=/in/not in string key (inverted; `in` is a substring test)
+            let key = pick(tc, &STRING_KEYS[..6]);
+            let op = pick(tc, &STRING_OPS);
+            let value = pick(tc, &WORDS);
+            format!("{}{}{op}{}{key}", quote(tc, value), sp(tc), sp(tc))
+        }
+        7 => {
+            // string key ==/!= a version-looking literal (`platform_release == '6.12.93'`);
+            // ordering operators on string keys are left out: packaging 26 answers `false`
+            // where PEP 508 says Python string comparison, and the one spec-defined case
+            // (both sides valid versions) is pinned as pep508_rs/1.
+            let op = pick(tc, &["==", "!="]);
+            let value = pick(tc, &RELEASES);
+            format!("platform_release{}{op}{}{}", sp(tc), sp(tc), quote(tc, value))
+        }
+        8 => {
+            // extra ==/!= 'name'
+            let op = pick(tc, &["==", "!="]);
+            format!("extra{}{op}{}{}", sp(tc), sp(tc), quote(tc, pick(tc, &EXTRA_SPELLINGS)))
+        }
+        _ => {
+            // a deprecated spelling of a string key
+            let key = pick(tc, &DEPRECATED_KEYS);
+            let op = pick(tc, &["==", "!="]);
+            let value = pick(tc, &["posix", "linux", "x86_64", "CPython", "#1 SMP", "nt"]);
+            format!("{key}{}{op}{}{}", sp(tc), sp(tc), quote(tc, value))
+        }
+    }
+}
+
+/// A marker: expressions joined by `and`/`or`, with parentheses, nesting depth ≤ 2.
+fn arb_marker(tc: &TestCase, depth: usize) -> String {
+    let count = n(tc, 1, 3);
+    let mut out = String::new();
+    for i in 0..count {
+        if i > 0 {
+            out.push_str(pick(tc, &[" and ", " or ", " and ", " or ", "  and  ", "\tor "]));
+        }
+        if depth > 0 && chance(tc, 3) {
+            out.push('(');
+            out.push_str(&ws(tc));
+            out.push_str(&arb_marker(tc, depth - 1));
+            out.push_str(&ws(tc));
+            out.push(')');
+        } else {
+            out.push_str(&arb_marker_expr(tc));
+        }
+    }
+    out
+}
+
+/// Functionally equivalent under the crate's own algebra: each implies the other.
+fn equiv(a: MarkerTree, b: MarkerTree) -> bool {
+    a.and(b.negate()).is_false() && b.and(a.negate()).is_false()
+}
+
+/// Evaluate with the crate.
+fn rs_marker(m: &MarkerTree, env: &Env, extra: &Option<String>) -> bool {
+    m.evaluate(&env.marker_environment(), &extras_of(extra))
+}
+
+/// Markers parse alike, evaluate alike on random environments, and the crate's `Display`
+/// re-parses (by the crate and by `packaging`) to the same truth values.
+#[hegel::test]
+fn markers_evaluate_like_packaging(tc: TestCase) {
+    let text = arb_marker(&tc, 2);
+    let env = tc.draw(arb_env().print_as_debug());
+    let extra = arb_extra(&tc);
+    let theirs = py_marker(&text, &env, extra.as_deref());
+    let ours = MarkerTree::from_str(&text);
+    match (&ours, &theirs) {
+        (Ok(_), Err(())) => panic!("{text:?}: pep508_rs accepts, packaging rejects"),
+        (Err(e), Ok(_)) => panic!("{text:?}: pep508_rs rejects ({e}), packaging accepts"),
+        (Err(_), Err(())) => return,
+        _ => {}
+    }
+    let tree = ours.unwrap();
+    let Some(expected) = theirs.unwrap() else {
+        return; // packaging raised UndefinedComparison: no defined answer
+    };
+    let got = rs_marker(&tree, &env, &extra);
+    assert_eq!(got, expected, "{text:?} in {env:?} extra {extra:?}");
+
+    // Display round trip (the rendering of an unsatisfiable tree is pinned: pep508_rs/2).
+    if let Some(shown) = tree.try_to_string() {
+        let again = MarkerTree::from_str(&shown)
+            .unwrap_or_else(|e| panic!("{shown:?} (Display of {text:?}) does not re-parse: {e}"));
+        if !tree.is_false() {
+            // Equivalent under the algebra (each implies the other); structural equality —
+            // the documented canonicity — is pinned as uv-pep508/6. (Deprecated key
+            // spellings were pep508_rs/5, fixed in the fork: compared here too.)
+            assert!(equiv(again, tree), "{shown:?} re-parses to a different marker than {text:?}");
+        }
+        assert_eq!(rs_marker(&again, &env, &extra), expected, "{shown:?}");
+        match py_marker(&shown, &env, extra.as_deref()) {
+            Err(()) => panic!("packaging rejects the crate's Display {shown:?} of {text:?}"),
+            Ok(Some(py)) => assert_eq!(py, expected, "packaging on the crate's Display {shown:?} of {text:?}"),
+            Ok(None) => {}
+        }
+    } else {
+        assert!(tree.is_true(), "{text:?}: no contents but not TRUE");
+    }
+}
+
+/// The marker algebra agrees with evaluation: `negate`, `and`, `or`, `is_true`, `is_false`,
+/// `is_disjoint`, on sampled environments.
+#[hegel::test]
+fn marker_algebra_agrees_with_evaluation(tc: TestCase) {
+    let a_text = arb_marker(&tc, 1);
+    let b_text = arb_marker(&tc, 1);
+    let (Ok(a), Ok(b)) = (MarkerTree::from_str(&a_text), MarkerTree::from_str(&b_text)) else {
+        return;
+    };
+    // `MarkerTree` is `Copy` in the fork and `and`/`or` return the combined tree.
+    let and = a.and(b);
+    let or = a.or(b);
+    let not_a = a.negate();
+    let disjoint = a.is_disjoint(b);
+    for _ in 0..n(&tc, 1, 4) {
+        let env = tc.draw(arb_env().print_as_debug());
+        let extra = arb_extra(&tc);
+        let va = rs_marker(&a, &env, &extra);
+        let vb = rs_marker(&b, &env, &extra);
+        let ctx = format!("a = {a_text:?}, b = {b_text:?}, env {env:?}, extra {extra:?}");
+        assert_eq!(rs_marker(&not_a, &env, &extra), !va, "negate: {ctx}");
+        assert_eq!(rs_marker(&and, &env, &extra), va && vb, "and: {ctx}");
+        assert_eq!(rs_marker(&or, &env, &extra), va || vb, "or: {ctx}");
+        if a.is_true() {
+            assert!(va, "is_true but false: {ctx}");
+        }
+        if a.is_false() {
+            assert!(!va, "is_false but true: {ctx}");
+        }
+        if and.is_false() {
+            assert!(!(va && vb), "a.and(b).is_false() but both hold: {ctx}");
+        }
+        if disjoint {
+            assert!(!(va && vb), "is_disjoint but both hold: {ctx}");
+        }
+    }
+    // Idempotence and De Morgan on canonical trees.
+    assert_eq!(a.and(a), a, "a and a: {a_text:?}");
+    let not_a_or_not_b = a.negate().or(b.negate());
+    assert_eq!(not_a_or_not_b, and.negate(), "De Morgan: {a_text:?} / {b_text:?}");
+    assert_eq!(not_a.negate(), a, "double negation: {a_text:?}");
+}
