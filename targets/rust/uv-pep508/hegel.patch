+// --------------------------------------------------------------------------- requirements
+
+/// A specifier both implementations accept, canonical spelling.
+fn arb_specifier(tc: &TestCase) -> String {
+    let op = pick(tc, &["==", "!=", "<=", "<", ">=", ">", "~=", "==", ">=", "==="]);
+    match op {
+        // (`===` with an arbitrary string is pinned: pep508_rs/3)
+        "===" => format!("==={}", arb_version(tc, 1)),
+        "~=" => format!("~={}", arb_version(tc, 2)),
+        "==" | "!=" if chance(tc, 3) => {
+            // a wildcard: release segments only
+            let k = n(tc, 1, 3);
+            let release: Vec<String> = (0..k).map(|_| pick(tc, &[0, 1, 2, 10]).to_string()).collect();
+            format!("{op}{}.*", release.join("."))
+        }
+        _ => format!("{op}{}{}", ws(tc), arb_version(tc, 1)),
+    }
+}
+
+/// A requirement text from the PEP 508 grammar, with the parts it was built from.
+#[derive(Clone, Debug)]
+struct GenReq {
+    text: String,
+    name: String,
+    extras: Vec<String>,
+    specs: Vec<String>,
+    url: Option<String>,
+    marker: Option<String>,
+}
+
+#[hegel::composite]
+fn arb_requirement(tc: &TestCase) -> GenReq {
+    let name = arb_name(tc);
+    let mut text = format!("{}{name}", ws(tc));
+    let mut extras = vec![];
+    if chance(tc, 3) {
+        text.push_str(&ws(tc));
+        text.push('[');
+        text.push_str(&ws(tc));
+        for i in 0..n(tc, 0, 3) {
+            if i > 0 {
+                text.push_str(&ws(tc));
+                text.push(',');
+                text.push_str(&ws(tc));
+            }
+            let e = arb_name(tc);
+            text.push_str(&e);
+            extras.push(e);
+        }
+        text.push_str(&ws(tc));
+        text.push(']');
+    }
+    let mut specs = vec![];
+    let mut url = None;
+    match n(tc, 0, 3) {
+        0 => {}
+        1 => {
+            let u = format!(
+                "https://{}.org/{}{}",
+                arb_chars(tc, "abcdefghijklmnopqrstuvwxyz", 1, 6),
+                arb_chars(tc, "abcdefghijklmnopqrstuvwxyz0123456789/_-", 0, 10),
+                pick(tc, &["", "", ".whl", ".tar.gz", "#egg=x", "?x=1"])
+            );
+            text.push_str(&ws(tc));
+            text.push('@');
+            text.push_str(&ws(tc));
+            text.push_str(&u);
+            url = Some(u);
+        }
+        _ => {
+            let parens = chance(tc, 4);
+            text.push_str(&ws(tc));
+            if parens {
+                text.push('(');
+                text.push_str(&ws(tc));
+            }
+            for i in 0..n(tc, 1, 3) {
+                if i > 0 {
+                    text.push_str(&ws(tc));
+                    text.push(',');
+                    text.push_str(&ws(tc));
+                }
+                let mut s = arb_specifier(tc);
+                // packaging's tokenizer takes `===0,` as the arbitrary string: keep `===` alone.
+                if s.starts_with("===") && specs.len() + 1 < 3 {
+                    s = format!("=={}", &s[3..]);
+                }
+                text.push_str(&s);
+                specs.push(s);
+            }
+            if parens {
+                text.push_str(&ws(tc));
+                text.push(')');
+            }
+        }
+    }
+    let marker = if chance(tc, 2) {
+        // After a URL the semicolon needs whitespace before it.
+        let gap = if url.is_some() { " ".to_string() } else { ws(tc) };
+        text.push_str(&gap);
+        text.push(';');
+        text.push_str(&ws(tc));
+        let m = arb_marker(tc, 1);
+        text.push_str(&m);
+        Some(m)
+    } else {
+        None
+    };
+    text.push_str(&ws(tc));
+    GenReq {
+        text,
+        name,
+        extras,
+        specs,
+        url,
+        marker,
+    }
+}
+
+/// The crate's view of a requirement in `packaging`'s terms.
+fn rs_view(req: &Requirement) -> PyReq {
+    let specs = match &req.version_or_url {
+        Some(VersionOrUrl::VersionSpecifier(specs)) => specs
+            .iter()
+            .map(|s| s.to_string().replace([' ', '\t'], ""))
+            .collect(),
+        _ => BTreeSet::new(),
+    };
+    let url = match &req.version_or_url {
+        Some(VersionOrUrl::Url(u)) => u.to_string(),
+        _ => String::new(),
+    };
+    PyReq {
+        name: req.name.to_string(),
+        extras: req.extras.iter().map(ToString::to_string).collect(),
+        specs,
+        url,
+        marker: String::new(),
+    }
+}
+
+/// Requirements from the PEP 508 grammar parse alike: same canonical name, extras, specifier
+/// set and URL as `packaging`; the marker evaluates alike on random environments; the
+/// crate's `Display` re-parses to an equal requirement (for the crate and for `packaging`).
+#[hegel::test]
+fn requirements_parse_like_packaging(tc: TestCase) {
+    let g = tc.draw(arb_requirement().print_as_debug());
+    let text = &g.text;
+    let theirs = py_requirement(text);
+    let ours = Requirement::<VerbatimUrl>::from_str(text);
+    match (&ours, &theirs) {
+        (Ok(r), None) => panic!("{text:?}: pep508_rs accepts ({r}), packaging rejects"),
+        (Err(e), Some(_)) => panic!("{text:?}: pep508_rs rejects, packaging accepts:\n{e}"),
+        (Err(_), None) => return,
+        _ => {}
+    }
+    let req = ours.unwrap();
+    let py = theirs.unwrap();
+    let mut view = rs_view(&req);
+    view.marker = py.marker.clone();
+    assert_eq!(view, py, "{text:?}");
+    // Against the generator too.
+    assert_eq!(py.name, canonical(&g.name), "{text:?}: name");
+    assert_eq!(
+        py.extras,
+        g.extras.iter().map(|e| canonical(e)).collect::<BTreeSet<_>>(),
+        "{text:?}: extras"
+    );
+    assert_eq!(
+        py.specs,
+        g.specs.iter().map(|s| s.replace([' ', '\t'], "")).collect::<BTreeSet<_>>(),
+        "{text:?}: specifiers"
+    );
+    assert_eq!(py.url, g.url.clone().unwrap_or_default(), "{text:?}: url");
+    assert_eq!(py.marker.is_empty(), g.marker.is_none(), "{text:?}: marker presence");
+
+    // The marker means the same thing.
+    let env = tc.draw(arb_env().print_as_debug());
+    let extra = arb_extra(&tc);
+    if let Some(m) = &g.marker {
+        if let Ok(Some(expected)) = py_marker(m, &env, extra.as_deref()) {
+            assert_eq!(
+                req.evaluate_markers(&env.marker_environment(), &extras_of(&extra)),
+                expected,
+                "{text:?}: marker in {env:?} extra {extra:?}"
+            );
+        }
+    } else {
+        assert!(req.marker.is_true(), "{text:?}: no marker but not TRUE");
+    }
+
+    // Display round trip.
+    let shown = req.to_string();
+    let again = Requirement::<VerbatimUrl>::from_str(&shown)
+        .unwrap_or_else(|e| panic!("{shown:?} (Display of {text:?}) does not re-parse:\n{e}"));
+    // The parts compare structurally; the marker by equivalence (canonicity is pinned as
+    // uv-pep508/6) unless it is `false`, whose rendering does not re-parse (uv-pep508/2).
+    if !req.marker.is_false() {
+        assert!(equiv(again.marker, req.marker), "{shown:?}: marker re-parses differently from {text:?}");
+    }
+    let mut again = again.clone();
+    again.marker = MarkerTree::FALSE;
+    let mut req = req.clone();
+    req.marker = MarkerTree::FALSE;
+    assert_eq!(again, req, "{shown:?} re-parses differently from {text:?}");
+    let py_again = py_requirement(&shown)
+        .unwrap_or_else(|| panic!("packaging rejects the crate's Display {shown:?} of {text:?}"));
+    let mut view = rs_view(&req);
+    view.marker = py_again.marker.clone();
+    assert_eq!(view, py_again, "packaging on the crate's Display {shown:?} of {text:?}");
+    if let Ok(Some(expected)) = py_marker(&py.marker, &env, extra.as_deref()) {
+        if !py_again.marker.is_empty() {
+            assert_eq!(
+                py_marker(&py_again.marker, &env, extra.as_deref()),
+                Ok(Some(expected)),
+                "{shown:?}: the re-rendered marker means something else than {text:?}"
+            );
+        }
+    }
+}
+
+/// Syntax agreement on near-miss texts: random mutations of a valid requirement are accepted
+/// by both or rejected by both.
+#[hegel::test]
+fn requirement_syntax_agrees_with_packaging(tc: TestCase) {
+    let g = tc.draw(arb_requirement().print_as_debug());
+    let mut text = g.text.clone();
+    let junk = [
+        " ", ",", ";", "[", "]", "(", ")", "@", "'", "\"", "=", "<", ">", "~", "!", ".", "-", "_",
+        "*", "and", "or", "in", "not", "x", "1", "python_version", "extra",
+    ];
+    for _ in 0..n(&tc, 1, 2) {
+        let pos = n(&tc, 0, text.chars().count());
+        let byte = text.char_indices().nth(pos).map(|(i, _)| i).unwrap_or(text.len());
+        match n(&tc, 0, 2) {
+            0 => text.insert_str(byte, pick(&tc, &junk)),
+            1 => {
+                if byte < text.len() {
+                    let c = text[byte..].chars().next().unwrap();
+                    text.replace_range(byte..byte + c.len_utf8(), "");
+                }
+            }
+            _ => {
+                if byte < text.len() {
+                    let c = text[byte..].chars().next().unwrap();
+                    text.replace_range(byte..byte + c.len_utf8(), pick(&tc, &junk));
+                }
+            }
+        }
+    }
+    // Shapes where the reference is knowingly lenient or the crate knowingly stricter are
+    // outside the spec grammar; only compare texts the spec grammar clearly decides.
+    let theirs = py_requirement(&text);
+    let Ok(ours) = std::panic::catch_unwind(|| Requirement::<VerbatimUrl>::from_str(&text)) else {
+        // (an extra ending in a separator panicked pep508_rs — pep508_rs/7, fixed in the fork)
+        panic!("{text:?}: Requirement::from_str panicked");
+    };
+    match (&ours, &theirs) {
+        (Ok(r), None) => {
+            // The crate accepts something packaging rejects: report unless it is a URL
+            // requirement (packaging treats any non-space run as a URL and is stricter
+            // about what follows).
+            if !matches!(r.version_or_url, Some(VersionOrUrl::Url(_))) && r.marker.is_true() {
+                panic!("{text:?}: pep508_rs accepts ({r}), packaging rejects");
+            }
+        }
+        (Err(e), Some(py)) => {
+            // packaging accepts a trailing comma, arbitrary URL-ish text and lenient
+            // markers with bogus comparisons; the crate's marker warnings are its documented
+            // leniency. Report only plain name/extras/version specifier texts.
+            // `packaging`'s tokenizer ends identifiers on `\b`, and `_` is a word character,
+            // so it accepts a name or extra ending in `_` (`a_`, `a[b_]`) that PEP 508's
+            // `identifier_end` forbids; the crate follows the grammar.
+            let plain = py.url.is_empty()
+                && py.marker.is_empty()
+                && !text.contains(',')
+                && !packaging_underscore_leniency(&text);
+            if plain {
+                panic!("{text:?}: pep508_rs rejects, packaging accepts ({py:?}):\n{e}");
+            }
+        }
+        _ => {}
+    }
+}
+
+/// `packaging` reads `IDENTIFIER` with `\b[a-zA-Z0-9][a-zA-Z0-9._-]*\b`: a `_` followed by a
+/// non-word character or the end of the text closes an identifier, against PEP 508's grammar.
+fn packaging_underscore_leniency(text: &str) -> bool {
+    let chars: Vec<char> = text.chars().collect();
+    chars.iter().enumerate().any(|(i, &c)| {
+        c == '_' && chars.get(i + 1).is_none_or(|next| !(next.is_ascii_alphanumeric() || *next == '_'))
+    })
+}
+
+// --------------------------------------------------------------------------- pins
+
+fn env_with(release: &str, python: &str, full: &str) -> Env {
+    Env {
+        values: vec![
+            "cpython".into(),
+            full.into(),
+            "posix".into(),
+            "x86_64".into(),
+            "CPython".into(),
+            release.into(),
+            "Linux".into(),
+            "#1 SMP".into(),
+            full.into(),
+            python.into(),
+            "linux".into(),
+        ],
+    }
+}
+
+/// Pinned (uv-pep508/1, pep508_rs/1): PEP 508 — "the <version_cmp> operators use the PEP 440 version
+/// comparison rules when those are defined (that is when both sides have a valid version
+/// specifier)" — so `platform_release < '6'` is false for release `22.6.0`; the crate compares
+/// string-keyed markers lexicographically (`"22.6.0" < "6"`).
+#[hegel::test]
+fn string_markers_compare_versions_like_pep_440(tc: TestCase) {
+    let env = env_with("22.6.0", "3.12", "3.12.3");
+    let m = MarkerTree::from_str("platform_release < '6'").unwrap();
+    assert_eq!(py_marker("platform_release < '6'", &env, None), Ok(Some(false)));
+    assert!(!rs_marker(&m, &env, &None), "platform_release < '6' with release 22.6.0");
+    let release = pick(&tc, &RELEASES);
+    let op = pick(&tc, &ORDER_OPS);
+    let value = pick(&tc, &["6", "6.5", "6.12", "6.12.93", "10", "22", "5.15", "24.1.0", "22.6.0"]);
+    let text = format!("platform_release {op} '{value}'");
+    let env = env_with(release, "3.12", "3.12.3");
+    if let Ok(Some(expected)) = py_marker(&text, &env, None) {
+        let m = MarkerTree::from_str(&text).unwrap();
+        assert_eq!(rs_marker(&m, &env, &None), expected, "{text:?} with release {release}");
+    }
+}
+
+/// Pinned (uv-pep508/2, pep508_rs/2): an unsatisfiable marker displays as `python_version < '0'`,
+/// its own canonical spelling of `false`, but that text does not parse back to an unsatisfiable
+/// tree (`python_full_version < '0'`, `is_false()` false).
+#[test]
+fn false_markers_round_trip_through_display() {
+    let tree = MarkerTree::from_str("python_version < '3' and python_version >= '3'").unwrap();
+    assert!(tree.is_false(), "the conjunction should be recognised as false");
+    let shown = tree.try_to_string().unwrap();
+    assert_eq!(shown, "python_version < '0'");
+    let again = MarkerTree::from_str(&shown).unwrap();
+    assert!(again.is_false(), "{shown:?} re-parses to {:?}, not false", again.try_to_string());
+    assert_eq!(again, tree);
+}
+
+/// Holds in `uv-pep508` (pep508_rs/4 was fixed in the fork): `python_version == '3.5.0.*'` holds
+/// for Python 3.5 under PEP 440 (`3.5` zero-pads to `3.5.0`, and `packaging` agrees); the fork's
+/// tree is `python_full_version == '3.5.*'`, where `pep508_rs`'s was unsatisfiable.
+#[hegel::test]
+fn python_version_matches_three_component_wildcards(tc: TestCase) {
+    let env = env_with("6.12.93", "3.5", "3.5.2");
+    let text = "python_version == '3.5.0.*'";
+    assert_eq!(py_marker(text, &env, None), Ok(Some(true)));
+    let m = MarkerTree::from_str(text).unwrap();
+    assert!(!m.is_false(), "{text:?} is deemed unsatisfiable");
+    assert!(rs_marker(&m, &env, &None), "{text:?} for Python 3.5");
+    let minor = n(&tc, 5, 14);
+    let env = env_with("6.12.93", &format!("3.{minor}"), &format!("3.{minor}.{}", n(&tc, 0, 9)));
+    let op = pick(&tc, &["==", "!="]);
+    let text = format!("python_version {op} '3.{}.0.*'", n(&tc, 5, 14));
+    let expected = py_marker(&text, &env, None).unwrap().unwrap();
+    let m = MarkerTree::from_str(&text).unwrap();
+    assert_eq!(rs_marker(&m, &env, &None), expected, "{text:?} for Python 3.{minor} (tree {:?})", m.try_to_string());
+}
