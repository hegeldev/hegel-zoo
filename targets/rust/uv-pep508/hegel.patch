+/// Pinned (uv-pep508/3, pep508_rs/3): PEP 440 arbitrary equality takes any string (`===foobar`),
+/// and `a===a` is a valid dependency specifier for `packaging`; the crate (through `uv-pep440`,
+/// uv-pep440/5) insists on a version after `===`.
+#[hegel::test]
+fn arbitrary_equality_takes_any_string(tc: TestCase) {
+    assert!(py_requirement("a===a").is_some());
+    let req = Requirement::<VerbatimUrl>::from_str("a===a");
+    assert!(req.is_ok(), "`a===a` rejected:\n{}", req.unwrap_err());
+    let value = arb_chars(&tc, "abcdefghijklmnopqrstuvwxyz0123456789.-", 1, 6);
+    let text = format!("pkg==={value}");
+    if py_requirement(&text).is_some() {
+        let req = Requirement::<VerbatimUrl>::from_str(&text);
+        assert!(req.is_ok(), "{text:?} rejected:\n{}", req.unwrap_err());
+    }
+}
