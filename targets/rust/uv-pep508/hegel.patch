+/// Pinned (uv-pep508/6): `MarkerTree` is documented as canonical ("any two functionally
+/// equivalent markers will compare equally"), but `X and ((X and A) or B)` — `A`, `B`
+/// comparisons on one string key, `X` a variable the diagram orders after it — leaves adjacent
+/// edges with the same child unmerged (five `os_name` ranges where the re-parse has three), so
+/// the tree differs from the one its own `Display` parses to although the two are equivalent.
+#[hegel::test]
+fn marker_trees_are_canonical(tc: TestCase) {
+    let text = "python_full_version < '3.5' and ((python_full_version < '3.5' and os_name != 'lin') or os_name == 'linux')";
+    let tree = MarkerTree::from_str(text).unwrap();
+    let shown = tree.try_to_string().unwrap();
+    let again = MarkerTree::from_str(&shown).unwrap();
+    assert!(equiv(tree, again));
+    assert_eq!(again, tree, "{text:?} vs its Display {shown:?}");
+    let x = pick(
+        &tc,
+        &[
+            "platform_machine == 'x86_64'",
+            "extra == 'dev'",
+            "sys_platform != 'win32'",
+            "python_full_version < '3.9'",
+            "implementation_name == 'pypy'",
+        ],
+    );
+    let a = format!("os_name {} '{}'", pick(&tc, &["==", "!="]), pick(&tc, &["lin", "nt", "posix"]));
+    let b = format!("os_name == '{}'", pick(&tc, &["linux", "nt", "java"]));
+    let text = format!("{x} and (({x} and {a}) or {b})");
+    let tree = MarkerTree::from_str(&text).unwrap();
+    let Some(shown) = tree.try_to_string() else { return };
+    let again = MarkerTree::from_str(&shown).unwrap();
+    assert!(equiv(tree, again), "{text:?} vs {shown:?}");
+    assert_eq!(again, tree, "{text:?} vs its Display {shown:?}");
+}
+
+/// Pinned (uv-pep508/5): `python_version != '3.5.1.*'` is the tree `false`, like `python_version
+/// == '3.5.1.*'`. The `==` is rightly unsatisfiable (`python_version` is an `X.Y` string, `3.5`
+/// zero-pads to `3.5.0` under PEP 440 and never has the prefix `3.5.1`), so its complement must
+/// be `true` for every interpreter — as `python_version != '3.5.1'` is, and as `packaging` says.
+/// `pep508_rs` had every three-component wildcard unsatisfiable (pep508_rs/4); the fork fixed the
+/// `Z == 0` case and left `!=` with `Z != 0` false.
+#[hegel::test]
+fn not_equal_wildcards_with_a_third_component_are_satisfiable(tc: TestCase) {
+    let env = env_with("6.12.93", "3.6", "3.6.0");
+    let text = "python_version != '3.5.1.*'";
+    assert_eq!(py_marker(text, &env, None), Ok(Some(true)));
+    let m = MarkerTree::from_str(text).unwrap();
+    assert!(!m.is_false(), "{text:?} is deemed unsatisfiable");
+    assert!(rs_marker(&m, &env, &None), "{text:?} for Python 3.6 (tree {:?})", m.try_to_string());
+    let minor = n(&tc, 5, 14);
+    let env = env_with("6.12.93", &format!("3.{minor}"), &format!("3.{minor}.{}", n(&tc, 0, 9)));
+    let text = format!("python_version != '3.{}.{}.*'", n(&tc, 5, 14), n(&tc, 1, 9));
+    assert_eq!(py_marker(&text, &env, None), Ok(Some(true)));
+    let m = MarkerTree::from_str(&text).unwrap();
+    assert!(rs_marker(&m, &env, &None), "{text:?} for Python 3.{minor} (tree {:?})", m.try_to_string());
+    // The `==` twin is unsatisfiable for both, and its negation is the `!=`.
+    let eq = MarkerTree::from_str(&text.replace("!=", "==")).unwrap();
+    assert!(eq.is_false());
+    assert_eq!(eq.negate(), m, "negate(==) vs !=");
+}
