index 3345b89..7c2520f 100644
--- a/rumqttc/src/mqttbytes/mod.rs
+++ b/rumqttc/src/mqttbytes/mod.rs
@@ -338,3 +338,85 @@ fn read_u8(stream: &mut Bytes) -> Result<u8, Error> {
 
     Ok(stream.get_u8())
 }
+
+#[cfg(test)]
+mod test {
+    use super::*;
+    use hegel::generators;
+
+    // Maximum value encodable as an MQTT variable byte integer (4 bytes of 7 bits)
+    const MAX_REMAINING_LENGTH: usize = 268_435_455;
+
+    #[hegel::test]
+    fn remaining_length_encode_decode_roundtrip(tc: hegel::TestCase) {
+        // Boost the classic 1/2/3/4-byte encoding boundaries alongside the full range
+        let len: usize = tc.draw(hegel::one_of!(
+            generators::integers::<usize>().max_value(MAX_REMAINING_LENGTH),
+            generators::sampled_from(vec![
+                0usize,
+                1,
+                127,
+                128,
+                16_383,
+                16_384,
+                2_097_151,
+                2_097_152,
+                MAX_REMAINING_LENGTH,
+            ]),
+        ));
+
+        let mut buf = BytesMut::new();
+        let count = write_remaining_length(&mut buf, len).unwrap();
+
+        // Independent oracle: byte count per the MQTT-3.1.1 remaining length table
+        let expected_count = if len <= 127 {
+            1
+        } else if len <= 16_383 {
+            2
+        } else if len <= 2_097_151 {
+            3
+        } else {
+            4
+        };
+        assert_eq!(count, expected_count);
+        assert_eq!(buf.len(), count);
+
+        // Every byte except the last must have the continuation bit set
+        for (i, byte) in buf.iter().enumerate() {
+            assert_eq!((byte & 0x80) != 0, i + 1 < count, "byte {i} of {buf:?}");
+        }
+
+        // Decoding recovers both the value and the number of length bytes
+        let (decoded_len_len, decoded) = length(buf.iter()).unwrap();
+        assert_eq!(decoded_len_len, count);
+        assert_eq!(decoded, len);
+    }
+
+    #[hegel::test]
+    fn remaining_length_above_max_is_rejected(tc: hegel::TestCase) {
+        let len: usize = tc.draw(
+            generators::integers::<usize>().min_value(MAX_REMAINING_LENGTH + 1),
+        );
+        let mut buf = BytesMut::new();
+        match write_remaining_length(&mut buf, len) {
+            Err(Error::PayloadTooLong) => {}
+            other => panic!("expected PayloadTooLong, got {other:?}"),
+        }
+        // nothing must have been written for a rejected length
+        assert!(buf.is_empty());
+    }
+
+    #[hegel::test]
+    fn length_decode_never_panics_and_stays_in_range(tc: hegel::TestCase) {
+        let bytes: Vec<u8> = tc.draw(generators::binary().max_size(16));
+        match length(bytes.iter()) {
+            // A decoded variable byte integer can never exceed 4 * 7 bits
+            Ok((len_len, len)) => {
+                assert!(len_len <= 4);
+                assert!(len <= MAX_REMAINING_LENGTH);
+            }
+            Err(Error::InsufficientBytes(_) | Error::MalformedRemainingLength) => {}
+            Err(other) => panic!("unexpected error variant: {other:?}"),
+        }
+    }
+}
diff --git a/rumqttc/src/mqttbytes/topic.rs b/rumqttc/src/mqttbytes/topic.rs
index a66c35f..1bc2590 100644
--- a/rumqttc/src/mqttbytes/topic.rs
+++ b/rumqttc/src/mqttbytes/topic.rs
@@ -97,6 +97,92 @@ pub fn matches(topic: &str, filter: &str) -> bool {
 
 #[cfg(test)]
 mod test {
+    use hegel::generators::{self, Generator};
+
+    /// Generates a wildcard-free topic together with a filter derived from it:
+    /// levels are kept literal or replaced by '+', and the tail may be replaced
+    /// by a multi-level '#'. Per the spec such a filter always matches the topic.
+    #[hegel::composite]
+    fn topic_and_matching_filter(tc: &hegel::TestCase) -> (String, String) {
+        let n_levels = tc.draw(generators::integers::<usize>().min_value(1).max_value(6));
+        let mut levels: Vec<String> = Vec::with_capacity(n_levels);
+        for _ in 0..n_levels {
+            // levels can be empty or contain arbitrary text, minus the
+            // wildcard/separator characters that would make the topic invalid
+            let level: String = tc.draw(generators::text().max_size(8));
+            levels.push(level.replace(['/', '+', '#'], ""));
+        }
+        // matches() rejects topics starting with '$' for wildcard filters (spec
+        // behaviour for $SYS topics), and an all-empty topic would derive an
+        // empty (invalid) filter: pin the first level to a safe prefix.
+        levels[0] = format!("t{}", levels[0]);
+
+        let topic = levels.join("/");
+
+        // '#' may replace the tail starting at any level, including one past
+        // the end (filter "a/b/#" matches topic "a/b").
+        let hash_at = if tc.draw(generators::booleans()) {
+            Some(tc.draw(generators::integers::<usize>().max_value(n_levels)))
+        } else {
+            None
+        };
+
+        let mut filter_levels: Vec<String> = Vec::new();
+        for (i, level) in levels.iter().enumerate() {
+            if let Some(h) = hash_at {
+                if i >= h {
+                    break;
+                }
+            }
+            // each kept level may be replaced by the single-level wildcard '+'
+            if tc.draw(generators::booleans()) {
+                filter_levels.push("+".to_owned());
+            } else {
+                filter_levels.push(level.clone());
+            }
+        }
+        if hash_at.is_some() {
+            filter_levels.push("#".to_owned());
+        }
+
+        (topic, filter_levels.join("/"))
+    }
+
+    #[hegel::test]
+    fn derived_wildcard_filters_are_valid(tc: hegel::TestCase) {
+        let (_, filter) = tc.draw(topic_and_matching_filter());
+        assert!(super::valid_filter(&filter), "filter {filter:?} should be valid");
+    }
+
+    #[hegel::test]
+    fn topic_matches_filter_derived_from_it(tc: hegel::TestCase) {
+        let (topic, filter) = tc.draw(topic_and_matching_filter());
+        assert!(
+            super::matches(&topic, &filter),
+            "topic {topic:?} should match derived filter {filter:?}"
+        );
+    }
+
+    /// KNOWN FAILURE: `matches()` slices `topic[..1]` by *byte* index to test
+    /// for a leading '$'. If the topic starts with a multi-byte UTF-8
+    /// character (e.g. "über/temp"), this panics on a char boundary error
+    /// instead of matching. It should use `starts_with('$')`.
+    #[hegel::test]
+    fn known_failure_matches_never_panics_on_multibyte_topics(tc: hegel::TestCase) {
+        // Deterministically pinned: force the first character to be multi-byte
+        let first: char = tc.draw(
+            generators::integers::<u32>()
+                .min_value(0x80)
+                .max_value(0x10_FFFF)
+                .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+        );
+        let rest: String = tc.draw(generators::text().max_size(16));
+        let topic = format!("{first}{rest}");
+        let filter: String = tc.draw(generators::text().max_size(16));
+        // must not panic, whatever the result
+        let _ = super::matches(&topic, &filter);
+    }
+
     #[test]
     fn wildcards_are_detected_correctly() {
         assert!(!super::has_wildcards("a/b/c"));
diff --git a/rumqttc/src/mqttbytes/v4/mod.rs b/rumqttc/src/mqttbytes/v4/mod.rs
index 3621945..8151ff7 100644
--- a/rumqttc/src/mqttbytes/v4/mod.rs
+++ b/rumqttc/src/mqttbytes/v4/mod.rs
@@ -150,3 +150,366 @@ fn len_len(len: usize) -> usize {
         1
     }
 }
+
+#[cfg(test)]
+mod test {
+    use super::*;
+    use hegel::generators;
+    use hegel::Generator;
+
+    /// MQTT strings/binary fields are length-prefixed with a u16.
+    /// `write_mqtt_bytes` silently truncates the length prefix for data
+    /// >= 65536 bytes (see the KNOWN FAILURE test
+    /// `known_failure_v4_publish_topic_longer_than_u16_roundtrips`), so valid-packet
+    /// generators stay within the wire-representable domain.
+    #[hegel::composite]
+    fn mqtt_string(tc: &hegel::TestCase) -> String {
+        tc.draw(generators::text().max_size(65_535))
+    }
+
+    #[hegel::composite]
+    fn arbitrary_qos(tc: &hegel::TestCase) -> QoS {
+        tc.draw((generators::sampled_from(vec![
+            QoS::AtMostOnce,
+            QoS::AtLeastOnce,
+            QoS::ExactlyOnce,
+        ])).print_as_debug())
+    }
+
+    /// Payloads: mostly small (including empty), occasionally multi-KB
+    #[hegel::composite]
+    fn arbitrary_payload(tc: &hegel::TestCase) -> Bytes {
+        let bytes: Vec<u8> = tc.draw(hegel::one_of!(
+            generators::binary(),
+            generators::binary().min_size(1024).max_size(8192),
+        ));
+        Bytes::from(bytes)
+    }
+
+    #[hegel::composite]
+    fn arbitrary_publish(tc: &hegel::TestCase) -> Publish {
+        let qos = tc.draw((arbitrary_qos()).print_as_debug());
+        // pkid is only on the wire for QoS > 0, and zero is rejected there:
+        // generate only wire-representable combinations
+        let pkid = match qos {
+            QoS::AtMostOnce => 0,
+            _ => tc.draw(generators::integers::<u16>().min_value(1)),
+        };
+        Publish {
+            dup: tc.draw(generators::booleans()),
+            qos,
+            retain: tc.draw(generators::booleans()),
+            topic: tc.draw(mqtt_string()),
+            pkid,
+            payload: tc.draw((arbitrary_payload()).print_as_debug()),
+        }
+    }
+
+    #[hegel::composite]
+    fn arbitrary_connect(tc: &hegel::TestCase) -> Connect {
+        let last_will = if tc.draw(generators::booleans()) {
+            Some(LastWill {
+                topic: tc.draw(mqtt_string()),
+                message: tc.draw((arbitrary_payload()).print_as_debug()),
+                qos: tc.draw((arbitrary_qos()).print_as_debug()),
+                retain: tc.draw(generators::booleans()),
+            })
+        } else {
+            None
+        };
+        let login = if tc.draw(generators::booleans()) {
+            let username: String = tc.draw(mqtt_string());
+            let mut password: String = tc.draw(mqtt_string());
+            // A Login with both fields empty writes no flags and reads back as
+            // None, so it isn't wire-representable; keep one field non-empty.
+            if username.is_empty() && password.is_empty() {
+                password.push('p');
+            }
+            Some(Login { username, password })
+        } else {
+            None
+        };
+        Connect {
+            protocol: tc.draw((generators::sampled_from(vec![Protocol::V4, Protocol::V5])).print_as_debug()),
+            keep_alive: tc.draw(generators::integers::<u16>()),
+            client_id: tc.draw(mqtt_string()),
+            clean_session: tc.draw(generators::booleans()),
+            last_will,
+            login,
+        }
+    }
+
+    /// Generates any v4 packet type. `allow_connect: false` excludes Connect,
+    /// whose `write` corrupts non-empty buffers (see the KNOWN FAILURE test
+    /// `known_failure_v4_connect_written_after_another_packet_roundtrips`).
+    #[hegel::composite]
+    fn arbitrary_packet(tc: &hegel::TestCase, allow_connect: bool) -> Packet {
+        let min = if allow_connect { 0u8 } else { 1u8 };
+        match tc.draw(generators::integers::<u8>().min_value(min).max_value(13)) {
+            0 => Packet::Connect(tc.draw((arbitrary_connect()).print_as_debug())),
+            1 => Packet::ConnAck(ConnAck {
+                session_present: tc.draw(generators::booleans()),
+                code: tc.draw((generators::sampled_from(vec![
+                    ConnectReturnCode::Success,
+                    ConnectReturnCode::RefusedProtocolVersion,
+                    ConnectReturnCode::BadClientId,
+                    ConnectReturnCode::ServiceUnavailable,
+                    ConnectReturnCode::BadUserNamePassword,
+                    ConnectReturnCode::NotAuthorized,
+                ])).print_as_debug()),
+            }),
+            2 => Packet::Publish(tc.draw((arbitrary_publish()).print_as_debug())),
+            3 => Packet::PubAck(PubAck {
+                pkid: tc.draw(generators::integers::<u16>()),
+            }),
+            4 => Packet::PubRec(PubRec {
+                pkid: tc.draw(generators::integers::<u16>()),
+            }),
+            5 => Packet::PubRel(PubRel {
+                pkid: tc.draw(generators::integers::<u16>()),
+            }),
+            6 => Packet::PubComp(PubComp {
+                pkid: tc.draw(generators::integers::<u16>()),
+            }),
+            7 => {
+                // A Subscribe with no filters reads back as EmptySubscription;
+                // the codec never writes one, so generate at least one filter
+                let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+                let mut filters = Vec::with_capacity(n);
+                for _ in 0..n {
+                    filters.push(SubscribeFilter {
+                        path: tc.draw(mqtt_string()),
+                        qos: tc.draw((arbitrary_qos()).print_as_debug()),
+                    });
+                }
+                Packet::Subscribe(Subscribe {
+                    pkid: tc.draw(generators::integers::<u16>()),
+                    filters,
+                })
+            }
+            8 => {
+                // SubAck with no return codes reads back as MalformedPacket:
+                // not wire-representable, generate at least one code
+                let codes = tc.draw(
+                    (generators::vecs(generators::sampled_from(vec![
+                        SubscribeReasonCode::Success(QoS::AtMostOnce),
+                        SubscribeReasonCode::Success(QoS::AtLeastOnce),
+                        SubscribeReasonCode::Success(QoS::ExactlyOnce),
+                        SubscribeReasonCode::Failure,
+                    ]))
+                    .min_size(1)
+                    .max_size(16)).print_as_debug(),
+                );
+                Packet::SubAck(SubAck {
+                    pkid: tc.draw(generators::integers::<u16>()),
+                    return_codes: codes,
+                })
+            }
+            9 => {
+                let n = tc.draw(generators::integers::<usize>().max_value(8));
+                let mut topics = Vec::with_capacity(n);
+                for _ in 0..n {
+                    topics.push(tc.draw(mqtt_string()));
+                }
+                Packet::Unsubscribe(Unsubscribe {
+                    pkid: tc.draw(generators::integers::<u16>()),
+                    topics,
+                })
+            }
+            10 => Packet::UnsubAck(UnsubAck {
+                pkid: tc.draw(generators::integers::<u16>()),
+            }),
+            11 => Packet::PingReq,
+            12 => Packet::PingResp,
+            _ => Packet::Disconnect,
+        }
+    }
+
+    #[hegel::test]
+    fn v4_packet_write_read_roundtrip(tc: hegel::TestCase) {
+        let packet = tc.draw((arbitrary_packet(true)).print_as_debug());
+        let mut buf = BytesMut::new();
+        packet.write(&mut buf, usize::MAX).unwrap();
+
+        // Only the frame itself must be consumed: trailing bytes stay in the stream
+        let trailing: Vec<u8> = tc.draw(generators::binary().max_size(16));
+        buf.extend_from_slice(&trailing);
+
+        let decoded = Packet::read(&mut buf, usize::MAX).unwrap();
+        assert_eq!(decoded, packet);
+        assert_eq!(&buf[..], &trailing[..]);
+    }
+
+    #[hegel::test]
+    fn v4_size_agrees_with_write(tc: hegel::TestCase) {
+        let packet = tc.draw((arbitrary_packet(true)).print_as_debug());
+        let mut buf = BytesMut::new();
+        let written = packet.write(&mut buf, usize::MAX).unwrap();
+        assert_eq!(written, buf.len());
+        assert_eq!(packet.size(), buf.len());
+    }
+
+    #[hegel::test]
+    fn v4_read_never_panics_on_arbitrary_bytes(tc: hegel::TestCase) {
+        let bytes: Vec<u8> = tc.draw(generators::binary().max_size(1024));
+        let max_size = tc.draw(hegel::one_of!(
+            generators::just(usize::MAX),
+            generators::integers::<usize>().max_value(1024),
+        ));
+        let mut buf = BytesMut::from(&bytes[..]);
+        // Must return Ok or Err, never panic
+        drop(Packet::read(&mut buf, max_size));
+    }
+
+    #[hegel::test]
+    fn v4_truncated_packet_reports_insufficient_bytes(tc: hegel::TestCase) {
+        let packet = tc.draw((arbitrary_packet(true)).print_as_debug());
+        let mut full = BytesMut::new();
+        packet.write(&mut full, usize::MAX).unwrap();
+
+        let cut = tc.draw(generators::integers::<usize>().max_value(full.len() - 1));
+        let mut prefix = BytesMut::from(&full[..cut]);
+        match Packet::read(&mut prefix, usize::MAX) {
+            Err(Error::InsufficientBytes(more)) => {
+                // The codec relies on this being an honest lower bound
+                assert!(more >= 1);
+                assert!(more <= full.len() - cut, "asked for {more} bytes but only {} are missing", full.len() - cut);
+            }
+            other => panic!("expected InsufficientBytes, got {other:?}"),
+        }
+
+        // Once the rest of the frame arrives, the original packet is decoded
+        let mut complete = BytesMut::from(&full[..]);
+        assert_eq!(Packet::read(&mut complete, usize::MAX).unwrap(), packet);
+    }
+
+    #[hegel::test]
+    fn v4_incoming_max_packet_size_is_honored(tc: hegel::TestCase) {
+        let packet = tc.draw((arbitrary_packet(true)).print_as_debug());
+        let mut buf = BytesMut::new();
+        packet.write(&mut buf, usize::MAX).unwrap();
+        let remaining_len = parse_fixed_header(buf.iter()).unwrap().remaining_len;
+        // packets with no variable header/payload can't exceed any limit
+        tc.assume(remaining_len > 0);
+
+        // At exactly the limit the packet must still be accepted
+        let mut at_limit = buf.clone();
+        assert_eq!(
+            Packet::read(&mut at_limit, remaining_len).unwrap(),
+            packet
+        );
+
+        // Below the limit it must be rejected before being framed
+        let max = tc.draw(generators::integers::<usize>().max_value(remaining_len - 1));
+        match Packet::read(&mut buf, max) {
+            Err(Error::PayloadSizeLimitExceeded(size)) => assert_eq!(size, remaining_len),
+            other => panic!("expected PayloadSizeLimitExceeded, got {other:?}"),
+        }
+    }
+
+    #[hegel::test]
+    fn v4_outgoing_max_packet_size_is_honored(tc: hegel::TestCase) {
+        let packet = tc.draw((arbitrary_packet(true)).print_as_debug());
+        let size = packet.size();
+
+        let mut buf = BytesMut::new();
+        let max = tc.draw(generators::integers::<usize>().max_value(size - 1));
+        match packet.write(&mut buf, max) {
+            Err(Error::OutgoingPacketTooLarge { pkt_size, max: m }) => {
+                assert_eq!(pkt_size, size);
+                assert_eq!(m, max);
+            }
+            other => panic!("expected OutgoingPacketTooLarge, got {other:?}"),
+        }
+        // a rejected write must not have touched the buffer
+        assert!(buf.is_empty());
+
+        // at exactly the limit the write succeeds
+        assert_eq!(packet.write(&mut buf, size).unwrap(), size);
+    }
+
+    /// Writing several packets into one buffer and decoding them back
+    /// (the tokio codec usage pattern).
+    ///
+    /// Connect packets are only generated in first position here:
+    /// `Connect::write` corrupts the buffer when it doesn't start at offset 0,
+    /// see `known_failure_v4_connect_written_after_another_packet_roundtrips`.
+    #[hegel::test]
+    fn v4_packet_sequence_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(5));
+        let mut packets = Vec::with_capacity(n);
+        for i in 0..n {
+            packets.push(tc.draw((arbitrary_packet(i == 0)).print_as_debug()));
+        }
+
+        let mut buf = BytesMut::new();
+        for packet in &packets {
+            packet.write(&mut buf, usize::MAX).unwrap();
+        }
+
+        for packet in &packets {
+            assert_eq!(&Packet::read(&mut buf, usize::MAX).unwrap(), packet);
+        }
+        assert!(buf.is_empty());
+    }
+
+    /// KNOWN FAILURE: `write_mqtt_bytes` casts the data length to u16, so any
+    /// string/bytes field of 65536+ bytes gets a truncated length prefix while
+    /// the full data is still written. `Packet::write` reports success but the
+    /// produced frame decodes to a *different* packet (or garbage). It should
+    /// return an error for fields that don't fit in the u16 length prefix.
+    #[hegel::test]
+    fn known_failure_v4_publish_topic_longer_than_u16_roundtrips(tc: hegel::TestCase) {
+        // Deterministically pinned to the failing region: every topic of
+        // 65536+ bytes corrupts the frame.
+        let extra = tc.draw(generators::integers::<usize>().max_value(64));
+        let publish = Publish {
+            dup: false,
+            qos: QoS::AtMostOnce,
+            retain: false,
+            topic: "a".repeat(65_536 + extra),
+            pkid: 0,
+            payload: Bytes::new(),
+        };
+        let packet = Packet::Publish(publish);
+
+        let mut buf = BytesMut::new();
+        packet.write(&mut buf, usize::MAX).unwrap();
+        let decoded = Packet::read(&mut buf, usize::MAX);
+        assert_eq!(
+            decoded.unwrap(),
+            packet,
+            "u16 length prefix truncation corrupted the frame"
+        );
+    }
+
+    /// KNOWN FAILURE: `Connect::write` computes `flags_index` relative to the
+    /// start of the buffer instead of the start of the packet, so writing a
+    /// Connect into a buffer that already contains bytes patches the connect
+    /// flags into the wrong position, corrupting the stream. (The v5
+    /// `Connect::write` in src/v5/mqttbytes/v5/connect.rs has the same bug.)
+    #[hegel::test]
+    fn known_failure_v4_connect_written_after_another_packet_roundtrips(tc: hegel::TestCase) {
+        // Deterministically pinned: any Connect with non-zero connect flags
+        // (here: a last will) written at a non-zero offset loses its flags.
+        let mut connect = tc.draw((arbitrary_connect()).print_as_debug());
+        connect.last_will = Some(LastWill {
+            topic: tc.draw(mqtt_string()),
+            message: tc.draw((arbitrary_payload()).print_as_debug()),
+            qos: tc.draw((arbitrary_qos()).print_as_debug()),
+            retain: tc.draw(generators::booleans()),
+        });
+
+        let mut buf = BytesMut::new();
+        Packet::PingReq.write(&mut buf, usize::MAX).unwrap();
+        Packet::Connect(connect.clone())
+            .write(&mut buf, usize::MAX)
+            .unwrap();
+
+        assert_eq!(Packet::read(&mut buf, usize::MAX).unwrap(), Packet::PingReq);
+        assert_eq!(
+            Packet::read(&mut buf, usize::MAX).unwrap(),
+            Packet::Connect(connect)
+        );
+    }
