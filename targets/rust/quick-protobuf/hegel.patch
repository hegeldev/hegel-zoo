+    /// write_packed/read_packed round-trip for varint-coded elements; an empty
+    /// slice writes nothing at all (documented early-return).
+    #[hegel::test]
+    fn prop_packed_varint_roundtrip(tc: hegel::TestCase) {
+        let v: Vec<u32> = tc.draw(generators::vecs(generators::integers::<u32>()).max_size(100));
+        let mut buf = Vec::new();
+        Writer::new(&mut buf)
+            .write_packed(&v, |w, m| w.write_uint32(*m), &|m| sizeof_uint32(*m))
+            .unwrap();
