+// ---------------------------------------------------------------------------
+// Property-based tests (hegel): untrusted-decoder robustness.
+//
+// BytesReader is the entry point for attacker-controlled bytes, so the core
+// property is: reading arbitrary or crafted-hostile input returns Ok/Err but
+// never panics, never pre-allocates based on a claimed length, never hangs,
+// and never walks the cursor past the buffer.
+// ---------------------------------------------------------------------------
+#[cfg(test)]
+mod hegel_props {
+    use super::*;
+    use crate::sizeofs::{sizeof_len, sizeof_varint};
+    use crate::writer::Writer;
+    use hegel::generators;
+
+    /// Reading varints from arbitrary bytes never panics, consumes at most 10
+    /// bytes, and never moves the cursor past the buffer.
+    #[hegel::test]
+    fn prop_read_varint_arbitrary_bytes(tc: hegel::TestCase) {
+        let bytes: Vec<u8> = tc.draw(generators::binary().max_size(64));
+
+        let mut r = BytesReader::from_bytes(&bytes);
+        let res64 = r.read_varint64(&bytes);
+        let consumed = r.start;
+        assert!(consumed <= 10, "read_varint64 consumed {} > 10 bytes", consumed);
+        assert!(consumed <= bytes.len());
+        if let Ok(v) = res64 {
+            // consistency with the sizeof/writer pair: the canonical encoding
+            // of the decoded value can never be longer than what was consumed
+            // (it can be shorter: overlong/truncating encodings are accepted).
+            assert!(sizeof_varint(v) <= consumed);
+        }
+
+        let mut r = BytesReader::from_bytes(&bytes);
+        drop(r.read_varint32(&bytes));
+        assert!(r.start <= 10);
+        assert!(r.start <= bytes.len());
+    }
+
+    /// Over-long varints (10 continuation bytes with their high bit set,
+    /// i.e. >10 bytes total) are rejected with Error::Varint by both
+    /// read_varint32 and read_varint64 — no panic, no unbounded scan.
+    #[hegel::test]
+    fn prop_overlong_varint_errors(tc: hegel::TestCase) {
+        // 10 bytes that all claim continuation, then arbitrary junk.
+        let mut bytes: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>().min_value(0x80)) // MSB set
+                .min_size(10)
+                .max_size(10),
+        );
+        let junk: Vec<u8> = tc.draw(generators::binary().max_size(8));
+        bytes.extend_from_slice(&junk);
+
+        let mut r = BytesReader::from_bytes(&bytes);
+        assert!(matches!(r.read_varint64(&bytes), Err(Error::Varint)));
+        assert_eq!(r.start, 10, "must stop after exactly 10 bytes");
+
+        let mut r = BytesReader::from_bytes(&bytes);
+        assert!(matches!(r.read_varint32(&bytes), Err(Error::Varint)));
+        assert_eq!(r.start, 10, "must stop after exactly 10 bytes");
+
+        // Converse: exactly 10 bytes with the final continuation bit clear is
+        // the longest accepted varint.
+        let mut ok_bytes = bytes[..9].to_vec();
+        ok_bytes.push(tc.draw(generators::integers::<u8>().max_value(0x7F)));
+        let mut r = BytesReader::from_bytes(&ok_bytes);
+        assert!(r.read_varint64(&ok_bytes).is_ok());
+        assert_eq!(r.start, 10);
+        let mut r = BytesReader::from_bytes(&ok_bytes);
+        assert!(r.read_varint32(&ok_bytes).is_ok());
+        assert_eq!(r.start, 10);
+    }
+
+    /// A length-delimited field claiming a huge length backed by a short
+    /// buffer must fail with UnexpectedEndOfBuffer — quickly, without
+    /// allocating anything proportional to the claimed length.
+    #[hegel::test]
+    fn prop_huge_length_prefix_errors(tc: hegel::TestCase) {
+        let payload: Vec<u8> = tc.draw(generators::binary().max_size(32));
+        // Claimed length is always larger than what is available.
+        let claimed = tc.draw(
+            generators::integers::<u32>()
+                .min_value(payload.len() as u32 + 1)
+                .max_value(u32::MAX),
+        );
+        let mut bytes = Vec::new();
+        Writer::new(&mut bytes).write_varint(claimed as u64).unwrap();
+        bytes.extend_from_slice(&payload);
+
+        let mut r = BytesReader::from_bytes(&bytes);
+        assert!(matches!(r.read_bytes(&bytes), Err(Error::UnexpectedEndOfBuffer)));
+
+        let mut r = BytesReader::from_bytes(&bytes);
+        assert!(matches!(r.read_string(&bytes), Err(Error::UnexpectedEndOfBuffer)));
+
+        let mut r = BytesReader::from_bytes(&bytes);
+        assert!(matches!(
+            r.read_packed_fixed::<u64>(&bytes),
+            Err(Error::UnexpectedEndOfBuffer)
+        ));
+
+        let mut r = BytesReader::from_bytes(&bytes);
+        assert!(r.read_packed(&bytes, |r, b| r.read_uint64(b)).is_err());
+    }
+
+    /// Scanning arbitrary bytes as a stream of unknown fields (next_tag +
+    /// read_unknown, exactly what generated from_reader impls do for unknown
+    /// tags) terminates, never panics, and never moves the cursor past the
+    /// end of the buffer.
+    #[hegel::test]
+    fn prop_scan_unknown_fields_arbitrary_bytes(tc: hegel::TestCase) {
+        let bytes: Vec<u8> = tc.draw(generators::binary().max_size(128));
+        let mut r = BytesReader::from_bytes(&bytes);
+        let mut iterations = 0usize;
+        while !r.is_eof() {
+            let before = r.start;
+            let tag = match r.next_tag(&bytes) {
+                Ok(t) => t,
+                Err(_) => break,
+            };
+            if r.read_unknown(&bytes, tag).is_err() {
+                break;
+            }
+            assert!(r.start <= bytes.len(), "cursor moved past the buffer");
+            assert!(r.start > before, "no progress: potential infinite loop");
+            iterations += 1;
+            assert!(iterations <= bytes.len(), "more fields than bytes: infinite loop");
+        }
+        assert!(r.start <= bytes.len(), "cursor moved past the buffer");
+    }
+
+    /// Position accounting: a successful read_bytes advances the cursor by
+    /// exactly sizeof_len(returned.len()) — the length prefix plus the data —
+    /// and never past the buffer.
+    #[hegel::test]
+    fn prop_read_bytes_position_accounting(tc: hegel::TestCase) {
+        let bytes: Vec<u8> = tc.draw(generators::binary().max_size(128));
+        let mut r = BytesReader::from_bytes(&bytes);
+        if let Ok(s) = r.read_bytes(&bytes) {
+            assert_eq!(r.start, sizeof_len(s.len()));
+            assert!(r.start <= bytes.len());
+            assert_eq!(r.len(), bytes.len() - r.start);
+        }
+    }
+}
