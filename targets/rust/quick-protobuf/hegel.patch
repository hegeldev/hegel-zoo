+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+//
+// These generalize the example-based write/read tests above: every write_*/
+// read_* pair must round-trip across the full domain of its type, and the
+// sizeof_* helpers must agree with the number of bytes actually written
+// (the same property the quickcheck test `test_get_size` in
+// tests/rust_protobuf/v2/test_basic.rs checks for generated messages).
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use super::*;
+    use hegel::generators;
+    use hegel::Generator;
+    use std::panic::{self, AssertUnwindSafe};
+
+    /// Deserialize arbitrary bytes as a `TestMessage`, tolerating ONLY the
+    /// known scope-underflow panic pinned by
+    /// `known_failure_read_unknown_scope_underflow_panic` (see its doc comment).
+    /// Any other panic is a fresh bug and is re-raised so the property fails.
+    /// This is the sanctioned "exclude the known-buggy input from siblings"
+    /// pattern: it keeps these no-panic properties green and still exercising
+    /// every other input while the canonical pin documents the bug.
+    fn decode_tolerating_known_bug(bytes: &[u8]) {
+        let res = panic::catch_unwind(AssertUnwindSafe(|| {
+            drop(deserialize_from_slice::<TestMessage>(bytes));
+        }));
+        if let Err(payload) = res {
+            let msg = payload
+                .downcast_ref::<String>()
+                .map(|s| s.as_str())
+                .or_else(|| payload.downcast_ref::<&str>().copied())
+                .unwrap_or("");
+            assert!(
+                msg.contains("subtract with overflow"),
+                "unexpected panic (not the pinned scope-underflow bug): {msg}"
+            );
+        }
+    }
+
+    /// Draw a u64 from the full range, boosted toward varint length boundaries
+    /// (0x7F/0x80, 0x3FFF/0x4000, ... u64::MAX) where encoding bugs live.
+    #[hegel::composite]
+    fn varint_u64(tc: &hegel::TestCase) -> u64 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u64>(),
+            generators::sampled_from(vec![
+                0,
+                0x7F,
+                0x80,
+                0x3FFF,
+                0x4000,
+                0x1FFFFF,
+                0x200000,
+                0xFFFFFFF,
+                0x10000000,
+                u32::MAX as u64,
+                0x7FFFFFFFF,
+                0x800000000,
+                0x7FFFFFFFFFFFFFFF,
+                0x8000000000000000,
+                u64::MAX,
+            ]),
+        ))
+    }
+
+    /// Full-range i64 boosted toward MIN/MAX/0/±1.
+    #[hegel::composite]
+    fn boosted_i64(tc: &hegel::TestCase) -> i64 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<i64>(),
+            generators::sampled_from(vec![i64::MIN, -1, 0, 1, i64::MAX]),
+        ))
+    }
+
+    /// Full-range i32 boosted toward MIN/MAX/0/±1.
+    #[hegel::composite]
+    fn boosted_i32(tc: &hegel::TestCase) -> i32 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<i32>(),
+            generators::sampled_from(vec![i32::MIN, -1, 0, 1, i32::MAX]),
+        ))
+    }
+
+    /// write_varint/read_varint64 round-trip over the full u64 range, and the
+    /// encoded length matches sizeof_varint.
+    #[hegel::test]
+    fn prop_varint_u64_roundtrip(tc: hegel::TestCase) {
+        let v = tc.draw(varint_u64());
+        let mut buf = Vec::new();
+        Writer::new(&mut buf).write_varint(v).unwrap();
+        assert_eq!(buf.len(), sizeof_varint(v), "encoded length != sizeof_varint({})", v);
+        let mut r = BytesReader::from_bytes(&buf);
+        assert_eq!(v, r.read_varint64(&buf).unwrap());
+        assert!(r.is_eof(), "read_varint64 did not consume exactly the encoding");
+    }
+
+    /// The varint-coded scalar write/read pairs (int32/int64/uint32/uint64/
+    /// bool/enum) round-trip over their full ranges, consuming exactly the
+    /// bytes written (sizeof_* agreement included where a sizeof exists).
+    #[hegel::test]
+    fn prop_varint_scalar_roundtrip(tc: hegel::TestCase) {
+        let i32v = tc.draw(boosted_i32());
+        let i64v = tc.draw(boosted_i64());
+        let u32v = tc.draw(varint_u64()) as u32;
+        let u64v = tc.draw(varint_u64());
+        let boolv = tc.draw(generators::booleans());
+
+        let mut buf = Vec::new();
+        Writer::new(&mut buf).write_int32(i32v).unwrap();
+        assert_eq!(buf.len(), sizeof_int32(i32v));
+        let mut r = BytesReader::from_bytes(&buf);
+        assert_eq!(i32v, r.read_int32(&buf).unwrap());
+        assert!(r.is_eof());
+
+        let mut buf = Vec::new();
+        Writer::new(&mut buf).write_int64(i64v).unwrap();
+        assert_eq!(buf.len(), sizeof_int64(i64v));
+        let mut r = BytesReader::from_bytes(&buf);
+        assert_eq!(i64v, r.read_int64(&buf).unwrap());
+        assert!(r.is_eof());
+
+        let mut buf = Vec::new();
+        Writer::new(&mut buf).write_uint32(u32v).unwrap();
+        assert_eq!(buf.len(), sizeof_uint32(u32v));
+        let mut r = BytesReader::from_bytes(&buf);
+        assert_eq!(u32v, r.read_uint32(&buf).unwrap());
+        assert!(r.is_eof());
+
+        let mut buf = Vec::new();
+        Writer::new(&mut buf).write_uint64(u64v).unwrap();
+        assert_eq!(buf.len(), sizeof_uint64(u64v));
+        let mut r = BytesReader::from_bytes(&buf);
+        assert_eq!(u64v, r.read_uint64(&buf).unwrap());
+        assert!(r.is_eof());
+
+        let mut buf = Vec::new();
+        Writer::new(&mut buf).write_bool(boolv).unwrap();
+        assert_eq!(buf.len(), sizeof_bool(boolv));
+        let mut r = BytesReader::from_bytes(&buf);
+        assert_eq!(boolv, r.read_bool(&buf).unwrap());
+        assert!(r.is_eof());
+    }
