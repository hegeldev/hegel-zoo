+    /// Fixed-width scalars (fixed32/fixed64/sfixed32/sfixed64/float/double)
+    /// round-trip exactly. Floats are drawn as raw bit patterns so the whole
+    /// domain (NaNs, infinities, subnormals) is covered, and compared by bits.
+    #[hegel::test]
+    fn prop_fixed_width_roundtrip(tc: hegel::TestCase) {
+        let u32v = tc.draw(generators::integers::<u32>());
+        let u64v = tc.draw(generators::integers::<u64>());
+        let i32v = tc.draw(boosted_i32());
+        let i64v = tc.draw(boosted_i64());
+        let f32v = f32::from_bits(tc.draw(generators::integers::<u32>()));
+        let f64v = f64::from_bits(tc.draw(generators::integers::<u64>()));
+
+        let mut buf = Vec::new();
+        Writer::new(&mut buf).write_fixed32(u32v).unwrap();
+        assert_eq!(buf.len(), 4);
+        let mut r = BytesReader::from_bytes(&buf);
+        assert_eq!(u32v, r.read_fixed32(&buf).unwrap());
+        assert!(r.is_eof());
+
+        let mut buf = Vec::new();
+        Writer::new(&mut buf).write_fixed64(u64v).unwrap();
+        assert_eq!(buf.len(), 8);
+        let mut r = BytesReader::from_bytes(&buf);
+        assert_eq!(u64v, r.read_fixed64(&buf).unwrap());
+        assert!(r.is_eof());
+
+        let mut buf = Vec::new();
+        Writer::new(&mut buf).write_sfixed32(i32v).unwrap();
+        let mut r = BytesReader::from_bytes(&buf);
+        assert_eq!(i32v, r.read_sfixed32(&buf).unwrap());
+        assert!(r.is_eof());
+
+        let mut buf = Vec::new();
+        Writer::new(&mut buf).write_sfixed64(i64v).unwrap();
+        let mut r = BytesReader::from_bytes(&buf);
+        assert_eq!(i64v, r.read_sfixed64(&buf).unwrap());
+        assert!(r.is_eof());
