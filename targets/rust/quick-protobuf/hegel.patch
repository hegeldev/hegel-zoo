+    /// A message that contains an optional nested copy of itself (field 1,
+    /// wire type 2) — the shape pb-rs generates for recursive .proto messages.
+    #[derive(Debug, Default, PartialEq)]
+    struct Recursive {
+        child: Option<Box<Recursive>>,
+    }
+
+    impl Recursive {
+        fn depth(&self) -> usize {
+            let mut d = 0;
+            let mut cur = self;
+            while let Some(c) = &cur.child {
+                d += 1;
+                cur = c;
+            }
+            d
+        }
+    }
+
+    impl<'a> MessageRead<'a> for Recursive {
+        fn from_reader(r: &mut BytesReader, bytes: &'a [u8]) -> Result<Recursive> {
+            let mut msg = Recursive::default();
+            while !r.is_eof() {
+                match r.next_tag(bytes) {
+                    Ok(10) => msg.child = Some(Box::new(r.read_message(bytes)?)),
+                    Ok(t) => {
+                        r.read_unknown(bytes, t)?;
+                    }
+                    Err(e) => return Err(e),
+                }
+            }
+            Ok(msg)
+        }
+    }
+
+    /// Craft the body bytes of a `Recursive` message nested `depth` levels
+    /// deep, without O(depth^2) copying: compute each level's length first,
+    /// then emit tags and length prefixes front to back.
+    fn nested_message_bytes(depth: usize) -> Vec<u8> {
+        let mut lens = vec![0usize; depth + 1];
+        for k in 1..=depth {
+            lens[k] = 1 + sizeof_varint(lens[k - 1] as u64) + lens[k - 1];
+        }
+        let mut buf = Vec::with_capacity(lens[depth]);
+        {
+            let mut w = Writer::new(&mut buf);
+            for k in (0..depth).rev() {
+                w.write_tag(10).unwrap(); // field 1, wire type 2
+                w.write_varint(lens[k] as u64).unwrap();
+            }
+        }
+        buf
+    }
+
+    /// Nested length-delimited messages decode correctly at any moderate
+    /// depth: the recovered structure has exactly the crafted nesting depth.
+    #[hegel::test]
+    fn prop_nested_message_moderate_depth_roundtrip(tc: hegel::TestCase) {
+        // Depth is capped here only to keep this passing test off the stack
+        // overflow documented in nested_message_deep_recursion_stack_overflow
+        // below — read_message has no recursion depth limit.
+        let depth = tc.draw(generators::integers::<usize>().max_value(500));
+        let bytes = nested_message_bytes(depth);
+        let mut r = BytesReader::from_bytes(&bytes);
+        let msg = Recursive::from_reader(&mut r, &bytes).unwrap();
+        assert_eq!(depth, msg.depth());
+    }
+
+    /// KNOWN FAILURE (process abort): quick-protobuf has no recursion depth
+    /// limit on read_message, so a small crafted input (~4 bytes per level)
+    /// with deeply nested length-delimited messages overflows the stack and
+    /// aborts the whole process. Official protobuf implementations cap
+    /// recursion (e.g. at depth 100) and return an error instead. Kept
+    /// #[ignore]d because a stack overflow cannot be caught as a test
+    /// failure; run explicitly with:
+    ///   cargo test --test write_read nested_message_deep_recursion -- --ignored
+    #[test]
+    #[ignore = "aborts the process: stack overflow, no recursion depth limit in read_message"]
+    fn nested_message_deep_recursion_stack_overflow() {
+        let bytes = nested_message_bytes(200_000);
+        let mut r = BytesReader::from_bytes(&bytes);
+        // An untrusted-input-robust decoder must return Err (or Ok) here; the
+        // process instead dies with SIGSEGV / "thread ... has overflowed its
+        // stack".
+        drop(Recursive::from_reader(&mut r, &bytes));
+    }
+}
