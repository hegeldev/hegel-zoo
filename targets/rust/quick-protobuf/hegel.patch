+    /// write_packed_fixed/read_packed_fixed round-trip (including empty, which
+    /// unlike write_packed does write a zero length prefix).
+    #[hegel::test]
+    fn prop_packed_fixed_roundtrip(tc: hegel::TestCase) {
+        let v: Vec<i32> = tc.draw(generators::vecs(boosted_i32()).max_size(100));
+        let pf: PackedFixed<i32> = v.clone().into();
+        let mut buf = Vec::new();
+        Writer::new(&mut buf).write_packed_fixed(&pf).unwrap();
+        assert_eq!(buf.len(), sizeof_len(4 * v.len()));
+        let mut r = BytesReader::from_bytes(&buf);
