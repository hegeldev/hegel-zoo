+    /// One protobuf wire value, together with the tag wire-type bits it must
+    /// be written under.
+    #[derive(Debug, Clone, PartialEq, hegel::PrettyPrintable)]
+    enum WireValue {
+        Varint(u64),
+        Fixed64(u64),
+        LenDelim(Vec<u8>),
+        Fixed32(u32),
+    }
+
+    impl WireValue {
+        fn wire_type(&self) -> u32 {
+            match self {
+                WireValue::Varint(_) => 0,
+                WireValue::Fixed64(_) => 1,
+                WireValue::LenDelim(_) => 2,
+                WireValue::Fixed32(_) => 5,
+            }
+        }
+    }
+
+    #[hegel::composite]
+    fn wire_field(tc: &hegel::TestCase) -> (u32, WireValue) {
+        // Field numbers 1..=2^29-1 (the full protobuf range), boosted toward
+        // the extremes where tag varint encoding changes length.
+        let field_number = tc.draw(hegel::one_of!(
+            generators::integers::<u32>().min_value(1).max_value(0x1FFF_FFFF),
+            generators::sampled_from(vec![1u32, 15, 16, 2047, 2048, 0x1FFF_FFFF]),
+        ));
+        let value = match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => WireValue::Varint(tc.draw(varint_u64())),
+            1 => WireValue::Fixed64(tc.draw(generators::integers::<u64>())),
+            2 => WireValue::LenDelim(tc.draw(generators::binary().max_size(60))),
+            _ => WireValue::Fixed32(tc.draw(generators::integers::<u32>())),
+        };
+        (field_number, value)
+    }
+
+    /// The crown: any sequence of (field_number, wire value) written through
+    /// Writer (tag + value) is read back exactly by a BytesReader loop
+    /// dispatching on next_tag, covering wire types 0/1/2/5 and the full
+    /// field-number range.
+    #[hegel::test]
+    fn prop_wire_sequence_roundtrip(tc: hegel::TestCase) {
+        let fields: Vec<(u32, WireValue)> = tc.draw(generators::vecs(wire_field()).max_size(30));
+
+        let mut buf = Vec::new();
+        {
+            let mut w = Writer::new(&mut buf);
+            for (fnum, val) in &fields {
+                let tag = (fnum << 3) | val.wire_type();
+                w.write_tag(tag).unwrap();
+                match val {
+                    WireValue::Varint(v) => w.write_varint(*v).unwrap(),
+                    WireValue::Fixed64(v) => w.write_fixed64(*v).unwrap(),
+                    WireValue::LenDelim(v) => w.write_bytes(v).unwrap(),
+                    WireValue::Fixed32(v) => w.write_fixed32(*v).unwrap(),
+                }
+            }
+        }
+
+        let mut r = BytesReader::from_bytes(&buf);
+        let mut read_back = Vec::with_capacity(fields.len());
+        while !r.is_eof() {
+            let tag = r.next_tag(&buf).unwrap();
+            let fnum = tag >> 3;
+            let val = match tag & 0x7 {
+                0 => WireValue::Varint(r.read_varint64(&buf).unwrap()),
+                1 => WireValue::Fixed64(r.read_fixed64(&buf).unwrap()),
+                2 => WireValue::LenDelim(r.read_bytes(&buf).unwrap().to_vec()),
+                5 => WireValue::Fixed32(r.read_fixed32(&buf).unwrap()),
+                wt => panic!("read back impossible wire type {}", wt),
+            };
+            read_back.push((fnum, val));
+        }
+        assert_eq!(fields, read_back);
+    }
