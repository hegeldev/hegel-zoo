+
+// Generators shared with other test binaries
+mod helpers;
+
+/// Property-based tests (hegel): reading the same document with a non-default
+/// config option must relate to the default-config event stream in the way the
+/// option documents.
+mod props {
+    use super::helpers::gens;
+    use hegel::generators;
+    use pretty_assertions::assert_eq;
+    use quick_xml::events::{BytesEnd, Event};
+    use quick_xml::reader::{Config, Reader};
+
+    fn collect(doc: &str, config: Config) -> Vec<Event<'static>> {
+        let mut reader = Reader::from_str(doc);
+        *reader.config_mut() = config;
+        let mut out = Vec::new();
+        loop {
+            match reader.read_event() {
+                Ok(Event::Eof) => break,
+                Ok(e) => out.push(e.into_owned()),
+                Err(e) => panic!("reader rejected generated document {doc:?}: {e}"),
+            }
+        }
+        out
+    }
+
+    /// KNOWN FAILURE: with `trim_text_end = true`, a whitespace-only `Text`
+    /// event that is followed by more content (markup or a general reference)
+    /// is emitted as an *empty* `Text` event, although the documentation of
+    /// `trim_text_end` promises: "If after that the event is empty it will not
+    /// be pushed". Whitespace-only text at EOF and `trim_text_start` handle
+    /// this correctly. Found by `trim_text_equals_trimming_the_untrimmed_stream`
+    /// below (minimal shrunk counterexample: `" &lt;"`); related to the ignored
+    /// `trim_text_end::true_` test above ("currently it is hard to fix
+    /// incorrect behavior").
+    #[test]
+    fn trim_text_end_does_not_push_empty_text_events() {
+        let mut config = Config::default();
+        config.trim_text_end = true;
+        let events = collect(" <a/>", config);
+        assert!(
+            !events.contains(&Event::Text(quick_xml::events::BytesText::new(""))),
+            "empty Text event was pushed: {events:?}"
+        );
+    }
+
+    /// `trim_text_start`/`trim_text_end` must produce exactly the default
+    /// stream with `Text` events trimmed (via the crate's own public trimming
+    /// methods) and events that became empty dropped.
+    ///
+    /// Empty `Text` events are filtered out of both streams before comparison,
+    /// because of the known bug pinned by
+    /// `trim_text_end_does_not_push_empty_text_events` above (the reader pushes
+    /// empty `Text` events when `trim_text_end` trims a whitespace-only text
+    /// that is not at EOF); everything else about trimming remains asserted.
+    #[hegel::test]
+    fn trim_text_equals_trimming_the_untrimmed_stream(tc: hegel::TestCase) {
+        let doc = tc.draw(gens::document());
+        let trim_start = tc.draw(generators::booleans());
+        let trim_end = tc.draw(generators::booleans());
+
+        let mut config = Config::default();
+        config.trim_text_start = trim_start;
+        config.trim_text_end = trim_end;
+        let actual: Vec<Event> = collect(&doc, config)
+            .into_iter()
+            .filter(|e| *e != Event::Text(quick_xml::events::BytesText::new("")))
+            .collect();
+
+        let mut expected = Vec::new();
+        for e in collect(&doc, Config::default()) {
+            if let Event::Text(mut t) = e {
+                let mut empty = false;
+                if trim_start {
+                    empty = t.inplace_trim_start();
+                }
+                if !empty && trim_end {
+                    empty = t.inplace_trim_end();
+                }
+                if !empty {
+                    expected.push(Event::Text(t));
+                }
+            } else {
+                expected.push(e);
+            }
+        }
+        assert_eq!(actual, expected, "document: {doc:?}");
+    }
+
+    /// `expand_empty_elements` must produce exactly the default stream with
+    /// every `Empty` event replaced by the same `Start` event plus an `End`
+    /// event with the same name.
+    #[hegel::test]
+    fn expand_empty_elements_equals_rewriting_empty_as_start_end(tc: hegel::TestCase) {
+        let doc = tc.draw(gens::document());
+
+        let mut config = Config::default();
+        config.expand_empty_elements = true;
+        let actual = collect(&doc, config);
+
+        let mut expected = Vec::new();
+        for e in collect(&doc, Config::default()) {
+            match e {
+                Event::Empty(e) => {
+                    let name = String::from_utf8(e.name().as_ref().to_vec()).unwrap();
+                    expected.push(Event::Start(e));
+                    expected.push(Event::End(BytesEnd::new(name)));
+                }
+                e => expected.push(e),
+            }
+        }
+        assert_eq!(actual, expected, "document: {doc:?}");
+    }
+}
diff --git a/tests/reader.rs b/tests/reader.rs
index 52e2f36..0f42d86 100644
--- a/tests/reader.rs
+++ b/tests/reader.rs
@@ -369,3 +369,61 @@ mod read_text {
         assert_eq!(r.read_event().unwrap(), Eof);
     }
 }
+
+/// Property-based tests (hegel).
+mod props {
+    use super::helpers::gens;
+    use hegel::generators::{self, Generator};
+    use pretty_assertions::assert_eq;
+    use quick_xml::events::Event;
+    use quick_xml::reader::Reader;
+    use std::io::{BufReader, Cursor};
+
+    fn collect_events<R: std::io::BufRead>(mut reader: Reader<R>) -> Vec<String> {
+        let mut buf = Vec::new();
+        let mut out = Vec::new();
+        loop {
+            match reader.read_event_into(&mut buf) {
+                Ok(Event::Eof) => {
+                    out.push("Eof".into());
+                    break;
+                }
+                Ok(e) => out.push(format!("{e:?}")),
+                Err(e) => {
+                    out.push(format!("Err({e:?})"));
+                    break;
+                }
+            }
+            buf.clear();
+        }
+        out.push(format!(
+            "error_position: {}, buffer_position: {}",
+            reader.error_position(),
+            reader.buffer_position()
+        ));
+        out
+    }
+
+    /// The observable event stream (including any error and the reported
+    /// positions) must not depend on how the underlying `BufRead` chunks the
+    /// input. Regressions of this kind happened before (issues #950, #957),
+    /// where parser state was lost at `fill_buf` window boundaries.
+    #[hegel::test]
+    fn chunked_reads_equal_whole_input_reads(tc: hegel::TestCase) {
+        let data: Vec<u8> = tc.draw(hegel::one_of!(
+            gens::xml_soup().boxed(),
+            gens::document().map(String::into_bytes).boxed(),
+        ));
+        let capacity = tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+
+        let whole = collect_events(Reader::from_reader(data.as_slice()));
+        let chunked = collect_events(Reader::from_reader(BufReader::with_capacity(
+            capacity,
+            Cursor::new(&data),
+        )));
+        assert_eq!(
+            whole, chunked,
+            "BufReader capacity {capacity} changed observable behavior for input {data:?}"
+        );
+    }
+}
