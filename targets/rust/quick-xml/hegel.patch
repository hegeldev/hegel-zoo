+// Generators shared with other test binaries
+mod helpers;
+
+/// Property-based tests (hegel) — randomized versions of the fuzz findings above.
+mod props {
+    use super::helpers::gens;
+    use hegel::generators;
+    use quick_xml::events::Event;
+    use quick_xml::reader::{Config, Reader};
+    use quick_xml::XmlVersion;
+
+    fn arbitrary_config(tc: &hegel::TestCase) -> Config {
+        let mut config = Config::default();
+        config.allow_dangling_amp = tc.draw(generators::booleans());
+        config.allow_unmatched_ends = tc.draw(generators::booleans());
+        config.check_comments = tc.draw(generators::booleans());
+        config.check_end_names = tc.draw(generators::booleans());
+        config.expand_empty_elements = tc.draw(generators::booleans());
+        config.trim_markup_names_in_closing_tags = tc.draw(generators::booleans());
+        config.trim_text_start = tc.draw(generators::booleans());
+        config.trim_text_end = tc.draw(generators::booleans());
+        config
+    }
+
+    /// Whatever bytes and whatever `Config` the reader is given, it must not
+    /// panic, must not loop forever, and its event payloads must survive the
+    /// content accessors (mirrors `fuzz_53`/`fuzz_101` above, but generated).
+    #[hegel::test]
+    fn reader_never_panics_on_arbitrary_input_and_config(tc: hegel::TestCase) {
+        let data: Vec<u8> = tc.draw(hegel::one_of!(
+            gens::xml_soup(),
+            generators::binary().max_size(64),
+        ));
+        let config = arbitrary_config(&tc);
+
+        let mut reader = Reader::from_reader(data.as_slice());
+        *reader.config_mut() = config;
+        let mut buf = Vec::new();
+        // Every event except the final Eof consumes at least one input byte;
+        // treat gross violations as an endless loop.
+        let max_events = 2 * data.len() + 32;
+        let mut count = 0usize;
+        loop {
+            count += 1;
+            assert!(
+                count <= max_events,
+                "reader produced more than {max_events} events from {} bytes — endless loop?",
+                data.len()
+            );
+            match reader.read_event_into(&mut buf) {
+                Ok(Event::Start(e)) | Ok(Event::Empty(e)) => {
+                    for a in e.attributes() {
+                        if let Ok(a) = a {
+                            drop(a.decoded_and_normalized_value(
+                                XmlVersion::Implicit1_0,
+                                reader.decoder(),
+                            ));
+                        }
+                    }
+                }
+                Ok(Event::Text(e)) => {
+                    drop(e.xml10_content());
+                    drop(e.xml11_content());
+                }
+                Ok(Event::Comment(e)) | Ok(Event::DocType(e)) => drop(e.decode()),
+                Ok(Event::CData(e)) => drop(e.escape()),
+                Ok(Event::GeneralRef(e)) => drop(e.resolve_char_ref()),
+                Ok(Event::Eof) | Err(_) => break,
+                Ok(_) => {}
+            }
+            buf.clear();
+        }
+    }
+}
diff --git a/tests/helpers/gens.rs b/tests/helpers/gens.rs
new file mode 100644
index 0000000..155dadb
--- /dev/null
+++ b/tests/helpers/gens.rs
@@ -0,0 +1,267 @@
+//! Hegel generators shared between property-based tests in different test binaries.
+//!
+//! Different binaries use different subsets of these items, so the module is
+//! included with `#[allow(dead_code)]`.
+
+use hegel::generators::{self, Generator};
+use quick_xml::events::{BytesCData, BytesEnd, BytesPI, BytesStart, BytesText, Event};
+use quick_xml::writer::Writer;
+
+/// A node of a well-formed XML document fragment. Documents built from these
+/// nodes are always accepted by [`quick_xml::reader::Reader`], because all
+/// content is escaped/sanitized on conversion to events (see [`nodes_to_events`]).
+#[derive(Debug, Clone, hegel::PrettyPrintable)]
+pub enum Node {
+    Element {
+        name: String,
+        attrs: Vec<(String, String)>,
+        children: Vec<Node>,
+    },
+    Empty {
+        name: String,
+        attrs: Vec<(String, String)>,
+    },
+    Text(String),
+    CData(String),
+    Comment(String),
+    PI {
+        target: String,
+        content: String,
+    },
+}
+
+/// Strings sitting at parsing / escaping boundaries. Escape sets in
+/// `src/escape.rs` are `<`, `>`, `&`, `'`, `"`, entity references end with `;`
+/// and char references start with `#`/`#x` — uniform text generation almost
+/// never produces those, so they are boosted here.
+const SPECIAL_CHUNKS: &[&str] = &[
+    "<",
+    ">",
+    "&",
+    "'",
+    "\"",
+    ";",
+    "#",
+    "=",
+    "/",
+    "&amp;",
+    "&lt;",
+    "&#60;",
+    "&#x3C;",
+    "&bogus;",
+    "]]>",
+    "-->",
+    "?>",
+    "<!--",
+    "<![CDATA[",
+    " ",
+    "\t",
+    "\r",
+    "\n",
+    "\r\n",
+    "\u{85}",
+    "\u{2028}",
+    "\u{FFFD}",
+];
+
+/// Arbitrary textual content with XML-special characters boosted.
+#[hegel::composite]
+pub fn xml_text(tc: &hegel::TestCase) -> String {
+    let n = tc.draw(generators::integers::<usize>().max_value(6));
+    let mut s = String::new();
+    for _ in 0..n {
+        if tc.draw(generators::booleans()) {
+            s.push_str(tc.draw(generators::sampled_from(SPECIAL_CHUNKS.to_vec())));
+        } else {
+            s.push_str(&tc.draw(generators::text().max_size(8)));
+        }
+    }
+    s
+}
+
+/// A plausible XML element/attribute name, occasionally with a non-ASCII tail.
+#[hegel::composite]
+pub fn xml_name(tc: &hegel::TestCase) -> String {
+    let base = tc.draw(generators::from_regex(r"[A-Za-z_][A-Za-z0-9_.:-]{0,8}").fullmatch(true));
+    if tc.draw(generators::booleans()) {
+        let extra = tc.draw(generators::sampled_from(vec!["é", "λ", "中", "ф"]));
+        format!("{base}{extra}")
+    } else {
+        base
+    }
+}
+
+/// Attributes with unique names and arbitrary (boosted) values.
+#[hegel::composite]
+pub fn xml_attrs(tc: &hegel::TestCase) -> Vec<(String, String)> {
+    let names: Vec<String> = tc.draw(generators::vecs(xml_name()).max_size(3).unique(true));
+    names
+        .into_iter()
+        .map(|n| {
+            let value = tc.draw(xml_text());
+            (n, value)
+        })
+        .collect()
+}
+
+/// Generates a list of sibling XML nodes, nesting elements up to `depth` levels.
+pub fn nodes(depth: u32) -> generators::BoxedGenerator<'static, Vec<Node>> {
+    hegel::compose!(|tc| {
+        let n = tc.draw(generators::integers::<usize>().max_value(4));
+        (0..n).map(|_| draw_node(&tc, depth)).collect()
+    })
+    .boxed()
+}
+
+fn draw_node(tc: &hegel::TestCase, depth: u32) -> Node {
+    // Nested elements only allowed while depth > 0
+    let max_kind = if depth == 0 { 4 } else { 5 };
+    match tc.draw(generators::integers::<u8>().max_value(max_kind)) {
+        0 => Node::Text(tc.draw(xml_text())),
+        1 => Node::CData(tc.draw(xml_text())),
+        2 => {
+            // A comment must not contain its terminator, everything else round-trips
+            // (`check_comments` is disabled by default, so `--` is allowed)
+            let mut content = tc.draw(xml_text());
+            while content.contains("-->") {
+                content = content.replace("-->", "- ->");
+            }
+            Node::Comment(content)
+        }
+        3 => {
+            // PI content must not contain the `?>` terminator
+            let mut content = tc.draw(xml_text());
+            while content.contains("?>") {
+                content = content.replace("?>", "? >");
+            }
+            Node::PI {
+                target: tc.draw(xml_name()),
+                content,
+            }
+        }
+        4 => Node::Empty {
+            name: tc.draw(xml_name()),
+            attrs: tc.draw(xml_attrs()),
+        },
+        _ => Node::Element {
+            name: tc.draw(xml_name()),
+            attrs: tc.draw(xml_attrs()),
+            children: tc.draw((nodes(depth - 1)).print_as_debug()),
+        },
+    }
+}
+
+/// Converts generated nodes into writable events. Text and attribute values are
+/// escaped by the `quick-xml` event constructors; CDATA content is split into
+/// multiple sections when it contains `]]>`.
+pub fn nodes_to_events(nodes: &[Node], events: &mut Vec<Event<'static>>) {
+    for node in nodes {
+        match node {
+            Node::Element {
+                name,
+                attrs,
+                children,
+            } => {
+                let mut start = BytesStart::new(name.clone());
+                for (k, v) in attrs {
+                    start.push_attribute((k.as_str(), v.as_str()));
+                }
+                events.push(Event::Start(start.into_owned()));
+                nodes_to_events(children, events);
+                events.push(Event::End(BytesEnd::new(name.clone())));
+            }
+            Node::Empty { name, attrs } => {
+                let mut empty = BytesStart::new(name.clone());
+                for (k, v) in attrs {
+                    empty.push_attribute((k.as_str(), v.as_str()));
+                }
+                events.push(Event::Empty(empty.into_owned()));
+            }
+            Node::Text(s) => events.push(Event::Text(BytesText::new(s).into_owned())),
+            Node::CData(s) => {
+                for part in BytesCData::escaped(s) {
+                    events.push(Event::CData(part.into_owned()));
+                }
+            }
+            Node::Comment(s) => {
+                events.push(Event::Comment(BytesText::from_escaped(s.clone()).into_owned()))
+            }
+            Node::PI { target, content } => {
+                let pi = if content.is_empty() {
+                    target.clone()
+                } else {
+                    format!("{target} {content}")
+                };
+                events.push(Event::PI(BytesPI::new(pi).into_owned()));
+            }
+        }
+    }
+}
+
+/// Serializes events with [`Writer`] into a document string.
+pub fn events_to_doc(events: &[Event<'static>]) -> String {
+    let mut writer = Writer::new(Vec::new());
+    for e in events {
+        writer.write_event(e.borrow()).expect("writing to a Vec cannot fail");
+    }
+    String::from_utf8(writer.into_inner()).expect("writer output should be valid UTF-8")
+}
+
+/// A complete well-formed document produced by the crate's own [`Writer`].
+#[hegel::composite]
+pub fn document(tc: &hegel::TestCase) -> String {
+    let nodes = tc.draw(nodes(2));
+    let mut events = Vec::new();
+    nodes_to_events(&nodes, &mut events);
+    events_to_doc(&events)
+}
+
+/// Tokens that steer arbitrary byte soup towards XML syntax boundaries.
+const SOUP_TOKENS: &[&str] = &[
+    "<",
+    ">",
+    "</",
+    "/>",
+    "=",
+    "\"",
+    "'",
+    "&",
+    ";",
+    "&#",
+    "&#x",
+    "<!--",
+    "-->",
+    "<![CDATA[",
+    "]]>",
+    "<?",
+    "?>",
+    "<!DOCTYPE",
+    "<!ENTITY",
+    "[",
+    "]",
+    "xml",
+    "version",
+    "encoding",
+    " ",
+    "\t",
+    "\r\n",
+    "\n",
+];
+
+/// XML-ish byte soup: a mix of XML syntax fragments, names, text and raw bytes.
+#[hegel::composite]
+pub fn xml_soup(tc: &hegel::TestCase) -> Vec<u8> {
+    let n = tc.draw(generators::integers::<usize>().max_value(20));
+    let mut out = Vec::new();
+    for _ in 0..n {
+        match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => out.extend_from_slice(
+                tc.draw(generators::sampled_from(SOUP_TOKENS.to_vec())).as_bytes(),
+            ),
+            1 => out.extend_from_slice(tc.draw(xml_name()).as_bytes()),
+            2 => out.extend_from_slice(tc.draw(generators::text().max_size(6)).as_bytes()),
+            _ => out.extend_from_slice(&tc.draw(generators::binary().max_size(6))),
+        }
+    }
+    out
+}
