+// Generators shared with other test binaries
+mod helpers;
+
+/// Property-based tests (hegel).
+mod props {
+    use super::helpers::gens;
+    use hegel::generators;
+    use hegel::Generator;
+    use pretty_assertions::assert_eq;
+    use quick_xml::events::{BytesStart, Event};
+    use quick_xml::reader::Reader;
+    use quick_xml::writer::Writer;
+    use quick_xml::XmlVersion;
+
+    /// Reference implementation of the attribute-value normalization documented
+    /// on [`Attribute::normalized_value`]: the sequences `\r\n`, `\r`, `\n`,
+    /// `\t` (and for XML 1.1 also `\r\x85`, `\x85`, `\x2028`) are each replaced
+    /// by a single space. Values written by the writer contain no character
+    /// references, so no other transformation applies.
+    fn reference_normalize(value: &str, version: XmlVersion) -> String {
+        let xml11 = version == XmlVersion::Explicit1_1;
+        let mut out = String::with_capacity(value.len());
+        let mut iter = value.chars().peekable();
+        while let Some(c) = iter.next() {
+            match c {
+                '\r' => {
+                    if iter.peek() == Some(&'\n') || (xml11 && iter.peek() == Some(&'\u{85}')) {
+                        iter.next();
+                    }
+                    out.push(' ');
+                }
+                '\n' | '\t' => out.push(' '),
+                '\u{85}' | '\u{2028}' if xml11 => out.push(' '),
+                c => out.push(c),
+            }
+        }
+        out
+    }
+
+    /// Attribute values written through the writer (which escapes `<`, `>`,
+    /// `&`, `'`, `"`) must come back from `Attribute::normalized_value` equal
+    /// to the original value after the *documented* whitespace normalization —
+    /// quotes and entity-looking content must survive unchanged.
+    ///
+    /// Note: raw `\t`/`\r`/`\n` in attribute values do NOT roundtrip — the XML
+    /// specification requires parsers to normalize them to spaces, and the
+    /// writer does not escape them as `&#9;`/`&#13;`/`&#10;` (which would
+    /// preserve them).
+    #[hegel::test]
+    fn attribute_values_roundtrip_modulo_documented_normalization(tc: hegel::TestCase) {
+        let root = tc.draw(gens::xml_name());
+        let names: Vec<String> = tc.draw(generators::vecs(gens::xml_name()).max_size(4).unique(true));
+        let attrs: Vec<(String, String)> = names
+            .into_iter()
+            .map(|n| {
+                let value = tc.draw(gens::xml_text());
+                (n, value)
+            })
+            .collect();
+        let version = tc.draw((generators::sampled_from(vec![
+            XmlVersion::Implicit1_0,
+            XmlVersion::Explicit1_0,
+            XmlVersion::Explicit1_1,
+        ])).print_as_debug());
+
+        let mut start = BytesStart::new(root.as_str());
+        for (k, v) in &attrs {
+            start.push_attribute((k.as_str(), v.as_str()));
+        }
+        let mut writer = Writer::new(Vec::new());
+        writer.write_event(Event::Empty(start)).unwrap();
+        let doc = String::from_utf8(writer.into_inner()).unwrap();
+
+        let expected: Vec<(String, String)> = attrs
+            .iter()
+            .map(|(k, v)| (k.clone(), reference_normalize(v, version)))
+            .collect();
+
+        let mut reader = Reader::from_str(&doc);
+        match reader.read_event() {
+            Ok(Event::Empty(e)) => {
+                let parsed: Vec<(String, String)> = e
+                    .attributes()
+                    .map(|a| {
+                        let a = a.unwrap_or_else(|e| panic!("bad attribute in {doc:?}: {e}"));
+                        let key = String::from_utf8(a.key.as_ref().to_vec()).unwrap();
+                        let value = a
+                            .normalized_value(version)
+                            .unwrap_or_else(|e| panic!("bad value in {doc:?}: {e}"))
+                            .into_owned();
+                        (key, value)
+                    })
+                    .collect();
+                assert_eq!(parsed, expected, "document: {doc:?}");
+            }
+            x => panic!("expected `Empty` event for {doc:?}, got {x:?}"),
+        }
+    }
+}
