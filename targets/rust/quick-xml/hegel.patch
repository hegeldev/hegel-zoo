+
+/// Property-based tests (hegel).
+mod props {
+    use super::*;
+    use hegel::generators::{self, Generator};
+    use pretty_assertions::assert_eq;
+
+    /// Chunks at the boundary of the escape sets: characters that ARE escaped
+    /// (`<`, `>`, `&`, `'`, `"`), characters just outside every escape set
+    /// (`;`, `#`, whitespace, unicode line separators) and entity-looking text.
+    const BOUNDARY_CHUNKS: &[&str] = &[
+        "<", ">", "&", "'", "\"", ";", "#", "x", "=", "%", "]", "]]>",
+        "&amp;", "&lt;", "&gt;", "&apos;", "&quot;", "&bogus;", "&#60;", "&#x3C;", "&#;", "&;",
+        " ", "\t", "\r", "\n", "\r\n", "\u{85}", "\u{2028}", "\u{FFFD}", "ß",
+    ];
+
+    #[hegel::composite]
+    fn escapable_text(tc: &hegel::TestCase) -> String {
+        let n = tc.draw(generators::integers::<usize>().max_value(8));
+        let mut s = String::new();
+        for _ in 0..n {
+            if tc.draw(generators::booleans()) {
+                s.push_str(tc.draw(generators::sampled_from(BOUNDARY_CHUNKS.to_vec())));
+            } else {
+                s.push_str(&tc.draw(generators::text().max_size(6)));
+            }
+        }
+        s
+    }
+
+    /// `unescape` must be a left inverse of every escape function: whatever
+    /// characters an escape function decides to (not) escape, unescaping the
+    /// result must return the original string.
+    #[hegel::test]
+    fn escape_unescape_roundtrip(tc: hegel::TestCase) {
+        let s = tc.draw(escapable_text());
+        let escaped = match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => escape::escape(s.as_str()),
+            1 => escape::partial_escape(s.as_str()),
+            _ => escape::minimal_escape(s.as_str()),
+        };
+        let unescaped = escape::unescape(&escaped)
+            .unwrap_or_else(|e| panic!("failed to unescape {escaped:?}: {e}"));
+        assert_eq!(unescaped, s);
+    }
+
+    /// Each escape function documents an exact escape set. The output must not
+    /// contain any raw character of that set, and every `&` in the output must
+    /// begin one of the five predefined entities. (The roundtrip property alone
+    /// cannot detect an unescaped `<` because `unescape` passes it through.)
+    #[hegel::test]
+    fn escaped_text_contains_no_unescaped_specials(tc: hegel::TestCase) {
+        let s = tc.draw(escapable_text());
+        let (escaped, forbidden): (Cow<str>, &[char]) =
+            match tc.draw(generators::integers::<u8>().max_value(2)) {
+                0 => (escape::escape(s.as_str()), &['<', '>', '\'', '"']),
+                1 => (escape::partial_escape(s.as_str()), &['<', '>']),
+                _ => (escape::minimal_escape(s.as_str()), &['<']),
+            };
+        for c in forbidden {
+            assert!(
+                !escaped.contains(*c),
+                "escaped text {escaped:?} contains unescaped {c:?}"
+            );
+        }
+        for (i, _) in escaped.match_indices('&') {
+            let rest = &escaped[i..];
+            assert!(
+                ["&lt;", "&gt;", "&amp;", "&apos;", "&quot;"]
+                    .iter()
+                    .any(|entity| rest.starts_with(entity)),
+                "`&` at byte {i} of {escaped:?} does not start a predefined entity"
+            );
+        }
+    }
+
+    /// Any Unicode scalar value (except NUL, which the parser rejects) written
+    /// as a decimal or hexadecimal character reference must unescape to exactly
+    /// that character.
+    #[hegel::test]
+    fn char_ref_roundtrip(tc: hegel::TestCase) {
+        let c: char = tc.draw(
+            hegel::one_of!(
+                generators::integers::<u32>().min_value(1).max_value(0x7F),
+                generators::integers::<u32>().min_value(0x80).max_value(0xFFFF),
+                generators::integers::<u32>().min_value(0x1_0000).max_value(0x10_FFFF),
+            )
+            .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+        );
+        let zeros = "0".repeat(tc.draw(generators::integers::<usize>().max_value(3)));
+        let code = c as u32;
+        let reference = match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => format!("&#{zeros}{code};"),
+            1 => format!("&#x{zeros}{code:x};"),
+            _ => format!("&#x{zeros}{code:X};"),
+        };
+        let s = format!("a{reference}b");
+        assert_eq!(
+            escape::unescape(&s).unwrap_or_else(|e| panic!("failed to unescape {s:?}: {e}")),
+            format!("a{c}b")
+        );
+    }
+
+    /// Numeric character references over the full `u32` range must never panic,
+    /// must resolve exactly the codepoints that are Unicode scalar values
+    /// (except 0, documented by `ParseCharRefError::IllegalCharacter`), and
+    /// must reject everything else.
+    #[hegel::test]
+    fn numeric_char_ref_resolves_exactly_valid_codepoints(tc: hegel::TestCase) {
+        let n: u32 = tc.draw(hegel::one_of!(
+            generators::integers::<u32>(),
+            generators::sampled_from(vec![
+                0u32, 1, 0xD7FF, 0xD800, 0xDFFF, 0xE000, 0x10FFFF, 0x11_0000, u32::MAX
+            ]),
+        ));
+        let s = format!("&#{n};");
+        match escape::unescape(&s) {
+            Ok(unescaped) => {
+                let c = char::from_u32(n)
+                    .unwrap_or_else(|| panic!("resolved invalid codepoint {n:#x}"));
+                assert_ne!(n, 0, "NUL must be rejected");
+                assert_eq!(unescaped, c.to_string());
+            }
+            Err(_) => assert!(
+                n == 0 || char::from_u32(n).is_none(),
+                "valid codepoint {n:#x} was rejected"
+            ),
+        }
+    }
+
+    /// `unescape` must never panic, whatever `&`/`;`/`#` soup it is fed.
+    #[hegel::test]
+    fn unescape_never_panics(tc: hegel::TestCase) {
+        let s = tc.draw(escapable_text());
+        drop(escape::unescape(&s));
+    }
+}
