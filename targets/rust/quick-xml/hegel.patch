+/// Property-based tests (hegel) for the EOL normalization routines, which are
+/// exposed publicly through `BytesText::xml10_content` / `xml11_content` and
+/// the attribute normalization functions.
+#[cfg(test)]
+mod normalization_properties {
+    use super::*;
+    use hegel::generators;
+    use pretty_assertions::assert_eq;
+
+    /// Chunks around the EOL-normalization boundaries: the sequences that must
+    /// be normalized, their prefixes/suffixes, and characters sharing the first
+    /// UTF-8 byte with `\u{85}` (0xC2 xx) and `\u{2028}` (0xE2 xx xx) that must
+    /// pass through unchanged.
+    const EOL_CHUNKS: &[&str] = &[
+        "\r", "\n", "\r\n", "\n\r", "\r\r", "\u{85}", "\r\u{85}", "\u{2028}", "\r\u{2028}",
+        "\u{A0}", "\u{2029}", "€", "a", " ", "\t", "é",
+    ];
+
+    #[hegel::composite]
+    fn eol_text(tc: &hegel::TestCase) -> String {
+        let n = tc.draw(generators::integers::<usize>().max_value(8));
+        let mut s = String::new();
+        for _ in 0..n {
+            if tc.draw(generators::booleans()) {
+                s.push_str(tc.draw(generators::sampled_from(EOL_CHUNKS.to_vec())));
+            } else {
+                s.push_str(&tc.draw(generators::text().max_size(4)));
+            }
+        }
+        s
+    }
+
+    /// Straightforward reference implementation of the documented XML 1.0 EOL
+    /// normalization: `\r\n` -> `\n`, lone `\r` -> `\n`.
+    fn reference_xml10(s: &str) -> String {
+        let mut out = String::with_capacity(s.len());
+        let mut iter = s.chars().peekable();
+        while let Some(c) = iter.next() {
+            if c == '\r' {
+                if iter.peek() == Some(&'\n') {
+                    iter.next();
+                }
+                out.push('\n');
+            } else {
+                out.push(c);
+            }
+        }
+        out
+    }
+
+    /// Straightforward reference implementation of the documented XML 1.1 EOL
+    /// normalization: `\r\n`, `\r\u{85}`, `\r`, `\u{85}`, `\u{2028}` -> `\n`.
+    fn reference_xml11(s: &str) -> String {
+        let mut out = String::with_capacity(s.len());
+        let mut iter = s.chars().peekable();
+        while let Some(c) = iter.next() {
+            match c {
+                '\r' => {
+                    if matches!(iter.peek(), Some('\n') | Some('\u{85}')) {
+                        iter.next();
+                    }
+                    out.push('\n');
+                }
+                '\u{85}' | '\u{2028}' => out.push('\n'),
+                _ => out.push(c),
+            }
+        }
+        out
+    }
+
+    #[hegel::test]
+    fn normalize_xml10_eols_matches_reference(tc: hegel::TestCase) {
+        let s = tc.draw(eol_text());
+        assert_eq!(normalize_xml10_eols(&s), reference_xml10(&s), "input: {s:?}");
+    }
+
+    #[hegel::test]
+    fn normalize_xml11_eols_matches_reference(tc: hegel::TestCase) {
+        let s = tc.draw(eol_text());
+        assert_eq!(normalize_xml11_eols(&s), reference_xml11(&s), "input: {s:?}");
+    }
+}
