+//! Hegel properties for `uv-pep440`, uv's fork of `pep440_rs` (the zoo's `pep440_rs` properties,
+//! ported: four of its eleven pinned bugs are fixed here and hold as regular properties, five
+//! persist and are pinned as uv-pep440/1–5; two were about `u64::MAX`, which this fork rejects at
+//! parse time as a reserved sentinel).
+//!
+//! Oracle: Python's `packaging` (the PEP 440 reference implementation, `packaging.version` and
+//! `packaging.specifiers`), driven as one persistent `python3` child process: version parsing
+//! and normalisation, ordering, and specifier containment with `prereleases=True` (the crate
+//! implements the operator semantics and leaves the pre-release policy to the caller).
+//! Alongside: the crate's own invariants (Display round trips, `Ord`/`Eq`/`Hash`, the builders)
+//! and, with the `version-ranges` feature, agreement between `VersionSpecifier::contains` and
+//! the `Ranges<Version>` conversion.
+#![allow(clippy::all, dead_code)]
+
+use hegel::generators;
+use uv_pep440::{
+    LocalSegment, LocalVersionSlice, Operator, Prerelease, PrereleaseKind, Version, VersionPattern, VersionSpecifier, VersionSpecifiers, MIN_VERSION,
+};
+use std::cmp::Ordering;
+use std::hash::{DefaultHasher, Hash, Hasher};
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::str::FromStr;
+use std::sync::{Mutex, OnceLock};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+// --------------------------------------------------------------------------- the Python oracle
+
+const ORACLE_SCRIPT: &str = r#"
+import sys
+from packaging.version import Version, InvalidVersion
+from packaging.specifiers import Specifier, SpecifierSet, InvalidSpecifier
+
+def dec(h):
+    return bytes.fromhex(h).decode('utf-8')
+
+def enc(s):
+    return s.encode('utf-8').hex()
+
+def flag(b):
+    return 'true' if b else 'false'
+
+for line in sys.stdin:
+    parts = line.rstrip('\n').split(' ')
+    cmd, args = parts[0], [dec(p) for p in parts[1:]]
+    try:
+        if cmd == 'V':
+            v = Version(args[0])
+            pre = '' if v.pre is None else f'{v.pre[0]}{v.pre[1]}'
+            out = ['ok', str(v), str(v.epoch), '.'.join(map(str, v.release)), pre,
+                   '' if v.post is None else str(v.post), '' if v.dev is None else str(v.dev), v.local or '']
+        elif cmd == 'C':
+            a, b = Version(args[0]), Version(args[1])
+            out = ['ok', '-1' if a < b else ('1' if a > b else '0')]
+        elif cmd == 'S':
+            s = Specifier(args[0])
+            out = ['ok'] + [flag(s.contains(Version(a), prereleases=True)) for a in args[1:]]
+        elif cmd == 'SS':
+            s = SpecifierSet(args[0])
+            out = ['ok'] + [flag(s.contains(Version(a), prereleases=True)) for a in args[1:]]
+        elif cmd == 'P':
+            s = Specifier(args[0])
+            out = ['ok', s.operator, s.version]
+        else:
+            out = ['bad', cmd]
+    except (InvalidVersion, InvalidSpecifier):
+        out = ['err']
+    print(' '.join([out[0]] + [enc(x) for x in out[1:]]), flush=True)
+"#;
+
+struct Oracle {
+    child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+static ORACLE: OnceLock<Mutex<Oracle>> = OnceLock::new();
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|b| format!("{b:02x}")).collect()
+}
+
+fn unhex(h: &str) -> String {
+    let bytes: Vec<u8> = (0..h.len()).step_by(2).map(|i| u8::from_str_radix(&h[i..i + 2], 16).unwrap()).collect();
+    String::from_utf8(bytes).unwrap()
+}
+
+fn oracle() -> &'static Mutex<Oracle> {
+    ORACLE.get_or_init(|| {
+        let mut child = Command::new("python3")
+            .arg("-u")
+            .arg("-c")
+            .arg(ORACLE_SCRIPT)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .expect("python3 with the `packaging` module is needed as the PEP 440 oracle");
+        let stdin = child.stdin.take().unwrap();
+        let stdout = BufReader::new(child.stdout.take().unwrap());
+        Mutex::new(Oracle { child, stdin, stdout })
+    })
+}
+
+/// Ask the oracle; returns the status and the decoded fields.
+fn ask(cmd: &str, args: &[&str]) -> (String, Vec<String>) {
+    let mut o = oracle().lock().unwrap();
+    let mut line = cmd.to_string();
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a));
+    }
+    line.push('\n');
+    o.stdin.write_all(line.as_bytes()).expect("oracle stdin");
+    let mut reply = String::new();
+    let n = o.stdout.read_line(&mut reply).expect("oracle stdout");
+    if n == 0 {
+        let status = o.child.try_wait().ok().flatten();
+        panic!("the Python oracle exited ({status:?}); is `packaging` installed for python3?");
+    }
+    let mut it = reply.trim_end_matches(['\n', '\r']).split(' ');
+    let status = it.next().unwrap().to_string();
+    assert!(status == "ok" || status == "err", "oracle said {reply:?} to {line:?}");
+    (status, it.map(unhex).collect())
+}
+
+#[derive(Debug, Clone, PartialEq)]
+struct PyVersion {
+    normalized: String,
+    epoch: u64,
+    release: Vec<u64>,
+    pre: String,
+    post: Option<u64>,
+    dev: Option<u64>,
+    local: String,
+}
+
+fn py_version(text: &str) -> Option<PyVersion> {
+    let (status, f) = ask("V", &[text]);
+    if status == "err" {
+        return None;
+    }
+    let opt = |s: &str| if s.is_empty() { None } else { Some(s.parse::<u64>().unwrap()) };
+    Some(PyVersion {
+        normalized: f[0].clone(),
+        epoch: f[1].parse().unwrap(),
+        release: f[2].split('.').map(|n| n.parse().unwrap()).collect(),
+        pre: f[3].clone(),
+        post: opt(&f[4]),
+        dev: opt(&f[5]),
+        local: f[6].clone(),
+    })
+}
+
+fn py_cmp(a: &str, b: &str) -> Ordering {
+    let (status, f) = ask("C", &[a, b]);
+    assert_eq!(status, "ok", "{a} vs {b}");
+    match f[0].as_str() {
+        "-1" => Ordering::Less,
+        "0" => Ordering::Equal,
+        _ => Ordering::Greater,
+    }
+}
+
+/// `None` when the specifier is invalid for `packaging`; otherwise containment per candidate.
+fn py_contains(set: bool, spec: &str, candidates: &[String]) -> Option<Vec<bool>> {
+    let mut args: Vec<&str> = vec![spec];
+    args.extend(candidates.iter().map(String::as_str));
+    let (status, f) = ask(if set { "SS" } else { "S" }, &args);
+    if status == "err" {
+        return None;
+    }
+    Some(f.iter().map(|s| s == "true").collect())
+}
+
+/// `None` when the specifier is invalid for `packaging`; otherwise `(operator, version)`.
+fn py_specifier(spec: &str) -> Option<(String, String)> {
+    let (status, f) = ask("P", &[spec]);
+    if status == "err" {
+        return None;
+    }
+    Some((f[0].clone(), f[1].clone()))
+}
+
+
+// --------------------------------------------------------------------------- builders the fork keeps private
+// `uv-pep440` makes `with_epoch`, `with_dev` and `with_local` `pub(crate)`; the tests rebuild
+// the version through its PEP 440 text instead (a `Version` is its parts).
+
+fn rebuild(epoch: u64, release: &[u64], pre: Option<Prerelease>, post: Option<u64>, dev: Option<u64>, local: &[LocalSegment]) -> Version {
+    let mut s = String::new();
+    if epoch != 0 {
+        s.push_str(&format!("{epoch}!"));
+    }
+    s.push_str(&release.iter().map(ToString::to_string).collect::<Vec<_>>().join("."));
+    if let Some(p) = pre {
+        s.push_str(&format!("{}{}", p.kind, p.number));
+    }
+    if let Some(p) = post {
+        s.push_str(&format!(".post{p}"));
+    }
+    if let Some(d) = dev {
+        s.push_str(&format!(".dev{d}"));
+    }
+    if !local.is_empty() {
+        s.push('+');
+        s.push_str(&local.iter().map(ToString::to_string).collect::<Vec<_>>().join("."));
+    }
+    Version::from_str(&s).unwrap_or_else(|e| panic!("rebuilt {s}: {e}"))
+}
+
+trait VersionExt {
+    fn local_segments(&self) -> Vec<LocalSegment>;
+    fn with_dev(self, value: Option<u64>) -> Version;
+    fn with_epoch(self, value: u64) -> Version;
+    fn with_local(self, value: Vec<LocalSegment>) -> Version;
+}
+
+impl VersionExt for Version {
+    fn local_segments(&self) -> Vec<LocalSegment> {
+        match self.local() {
+            LocalVersionSlice::Segments(s) => s.to_vec(),
+            LocalVersionSlice::Max => Vec::new(),
+        }
+    }
+    fn with_dev(self, value: Option<u64>) -> Version {
+        rebuild(self.epoch(), &self.release(), self.pre(), self.post(), value, &self.local_segments())
+    }
+    fn with_epoch(self, value: u64) -> Version {
+        rebuild(value, &self.release(), self.pre(), self.post(), self.dev(), &self.local_segments())
+    }
+    fn with_local(self, value: Vec<LocalSegment>) -> Version {
+        rebuild(self.epoch(), &self.release(), self.pre(), self.post(), self.dev(), &value)
+    }
+}
+
+fn is_wildcard(pat: &VersionPattern) -> bool {
+    *pat != VersionPattern::verbatim(pat.version().clone())
+}
+
+// --------------------------------------------------------------------------- generators
+
+const WS: [&str; 6] = [" ", "  ", "\t", "\n", "\r", "\x0C"];
+const PRE_SPELLINGS: [&str; 14] = ["a", "b", "c", "rc", "alpha", "beta", "pre", "preview", "A", "B", "RC", "Alpha", "BETA", "Pre"];
+const POST_SPELLINGS: [&str; 6] = ["post", "rev", "r", "POST", "Rev", "R"];
+const DEV_SPELLINGS: [&str; 3] = ["dev", "DEV", "Dev"];
+const LOCAL_WORDS: [&str; 10] = ["local", "ubuntu", "abc", "ABC", "g1a2b3", "deadbeef", "x", "Z9", "cu118", "aBc"];
+const JUNK: [&str; 12] = ["x", "..", ".", "+", "-", "!", "*", "ä", "🙈", " 1", "1.0", "a1"];
+
+#[hegel::composite]
+fn arb_number(tc: &hegel::TestCase) -> String {
+    match tc.draw(int!(0u8, 11)) {
+        0 => "0".to_string(),
+        1 => "00".to_string(),
+        2 => format!("0{}", tc.draw(int!(0u32, 99))),
+        3 => "65535".to_string(),
+        4 => "65536".to_string(),
+        5 => "255".to_string(),
+        6 => "256".to_string(),
+        7 => u64::MAX.to_string(),
+        8 => "18446744073709551616".to_string(), // u64::MAX + 1
+        9 => "2097152".to_string(),               // 2^21, beyond the small suffix field
+        _ => tc.draw(int!(0u32, 30)).to_string(),
+    }
+}
+
+#[hegel::composite]
+fn arb_sep(tc: &hegel::TestCase) -> String {
+    tc.draw(generators::sampled_from(vec!["", ".", "-", "_"])).to_string()
+}
+
+/// Any spelling PEP 440's normalisation accepts, with a small dose of junk.
+#[hegel::composite]
+fn arb_version_text(tc: &hegel::TestCase) -> String {
+    let mut s = String::new();
+    if tc.draw(int!(0u8, 5)) == 0 {
+        s.push_str(WS[tc.draw(int!(0usize, WS.len() - 1))]);
+    }
+    if tc.draw(int!(0u8, 4)) == 0 {
+        s.push(if tc.draw(generators::booleans()) { 'v' } else { 'V' });
+    }
+    if tc.draw(int!(0u8, 5)) == 0 {
+        s.push_str(&tc.draw(arb_number()));
+        s.push('!');
+    }
+    let k = tc.draw(int!(1usize, 5));
+    for i in 0..k {
+        if i > 0 {
+            s.push('.');
+        }
+        s.push_str(&tc.draw(arb_number()));
+    }
+    if tc.draw(int!(0u8, 2)) == 0 {
+        s.push_str(&tc.draw(arb_sep()));
+        s.push_str(PRE_SPELLINGS[tc.draw(int!(0usize, PRE_SPELLINGS.len() - 1))]);
+        s.push_str(&tc.draw(arb_sep()));
+        if tc.draw(int!(0u8, 3)) != 0 {
+            s.push_str(&tc.draw(arb_number()));
+        }
+    }
+    if tc.draw(int!(0u8, 2)) == 0 {
+        if tc.draw(int!(0u8, 3)) == 0 {
+            s.push('-');
+            s.push_str(&tc.draw(arb_number()));
+        } else {
+            s.push_str(&tc.draw(arb_sep()));
+            s.push_str(POST_SPELLINGS[tc.draw(int!(0usize, POST_SPELLINGS.len() - 1))]);
+            s.push_str(&tc.draw(arb_sep()));
+            if tc.draw(int!(0u8, 3)) != 0 {
+                s.push_str(&tc.draw(arb_number()));
+            }
+        }
+    }
+    if tc.draw(int!(0u8, 2)) == 0 {
+        s.push_str(&tc.draw(arb_sep()));
+        s.push_str(DEV_SPELLINGS[tc.draw(int!(0usize, DEV_SPELLINGS.len() - 1))]);
+        s.push_str(&tc.draw(arb_sep()));
+        if tc.draw(int!(0u8, 3)) != 0 {
+            s.push_str(&tc.draw(arb_number()));
+        }
+    }
+    if tc.draw(int!(0u8, 3)) == 0 {
+        s.push('+');
+        let k = tc.draw(int!(1usize, 3));
+        for i in 0..k {
+            if i > 0 {
+                s.push_str(tc.draw(generators::sampled_from(vec![".", "-", "_"])));
+            }
+            if tc.draw(generators::booleans()) {
+                s.push_str(LOCAL_WORDS[tc.draw(int!(0usize, LOCAL_WORDS.len() - 1))]);
+            } else {
+                s.push_str(&tc.draw(arb_number()));
+            }
+        }
+    }
+    if tc.draw(int!(0u8, 5)) == 0 {
+        s.push_str(WS[tc.draw(int!(0usize, WS.len() - 1))]);
+    }
+    if tc.draw(int!(0u8, 7)) == 0 {
+        // junk somewhere
+        let junk = JUNK[tc.draw(int!(0usize, JUNK.len() - 1))];
+        let at = tc.draw(int!(0usize, s.len()));
+        let at = (at..=s.len()).find(|&i| s.is_char_boundary(i)).unwrap();
+        s.insert_str(at, junk);
+    }
+    s
+}
+
+/// True when a number before any local part does not fit a `u64` — the crate's documented
+/// limit (`packaging` uses Python integers), so such texts are checked separately.
+fn beyond_u64(text: &str) -> bool {
+    let public = text.split('+').next().unwrap();
+    let mut run = String::new();
+    for c in public.chars().chain(std::iter::once(' ')) {
+        if c.is_ascii_digit() {
+            run.push(c);
+        } else {
+            if !run.is_empty() && run.parse::<u64>().map_or(true, |n| n == u64::MAX) {
+                return true;
+            }
+            run.clear();
+        }
+    }
+    false
+}
+
+/// A text that both implementations parse (no junk, no oversize numbers; `uv-pep440` reserves
+/// `u64::MAX` as a sentinel and rejects it with "expected number less than or equal to
+/// 18446744073709551614", a documented limit).
+#[hegel::composite]
+fn arb_valid_version_text(tc: &hegel::TestCase) -> String {
+    for _ in 0..6 {
+        let t = tc.draw(arb_version_text());
+        if !beyond_u64(&t) && Version::from_str(&t).is_ok() {
+            return t;
+        }
+    }
+    "1.0".to_string()
+}
+
+/// A version near `base`: same release with the suffixes changed, a neighbouring number, an
+/// extra segment, another epoch, a local part.
+#[hegel::composite]
+fn arb_related(tc: &hegel::TestCase, base: &Version) -> String {
+    let mut release: Vec<u64> = base.release().to_vec();
+    match tc.draw(int!(0u8, 6)) {
+        0 => {
+            let i = tc.draw(int!(0usize, release.len() - 1));
+            release[i] = release[i].saturating_add(1);
+        }
+        1 => {
+            let i = tc.draw(int!(0usize, release.len() - 1));
+            release[i] = release[i].saturating_sub(1);
+        }
+        2 => release.push(tc.draw(int!(0u64, 2))),
+        3 => {
+            if release.len() > 1 {
+                release.pop();
+            }
+        }
+        _ => {}
+    }
+    let mut s = String::new();
+    let epoch = if tc.draw(int!(0u8, 5)) == 0 { tc.draw(int!(0u64, 2)) } else { base.epoch() };
+    if epoch != 0 {
+        s.push_str(&format!("{epoch}!"));
+    }
+    s.push_str(&release.iter().map(u64::to_string).collect::<Vec<_>>().join("."));
+    let keep = tc.draw(generators::booleans());
+    if keep {
+        if let Some(p) = base.pre() {
+            s.push_str(&format!("{p}"));
+        }
+        if let Some(p) = base.post() {
+            s.push_str(&format!(".post{p}"));
+        }
+        if let Some(d) = base.dev() {
+            s.push_str(&format!(".dev{d}"));
+        }
+    } else {
+        if tc.draw(int!(0u8, 2)) == 0 {
+            s.push_str(tc.draw(generators::sampled_from(vec!["a0", "a1", "b2", "rc1", "rc0", "a3"])));
+        }
+        if tc.draw(int!(0u8, 2)) == 0 {
+            s.push_str(tc.draw(generators::sampled_from(vec![".post0", ".post1", ".post2"])));
+        }
+        if tc.draw(int!(0u8, 2)) == 0 {
+            s.push_str(tc.draw(generators::sampled_from(vec![".dev0", ".dev1", ".dev5"])));
+        }
+    }
+    if tc.draw(int!(0u8, 3)) == 0 {
+        s.push_str(tc.draw(generators::sampled_from(vec!["+local", "+1", "+local.1", "+abc.def", "+0", "+z"])));
+    }
+    s
+}
+
+fn hash_of<T: Hash>(t: &T) -> u64 {
+    let mut h = DefaultHasher::new();
+    t.hash(&mut h);
+    h.finish()
+}
+
+/// Releases compare with zero padding.
+fn same_release(a: &Version, b: &Version) -> bool {
+    let n = a.release().len().max(b.release().len());
+    (0..n).all(|i| a.release().get(i).copied().unwrap_or(0) == b.release().get(i).copied().unwrap_or(0))
+}
+
+/// PEP 440 (and `packaging` 26): `<V` admits every version below `V` except the pre-releases
+/// of `V` itself when `V` is not one — those at or above `V.dev0`.
+fn should_be_less_than(spec_version: &Version, candidate: &Version) -> bool {
+    candidate < spec_version && !(!spec_version.any_prerelease() && candidate.any_prerelease() && *candidate >= spec_version.clone().with_dev(Some(0)))
+}
+
+/// PEP 440 (and `packaging` 26): `>V` admits every version above `V` except the post-releases
+/// of `V` itself when `V` is not one — same epoch, release and pre-release, `V` without dev.
+fn should_be_greater_than(spec_version: &Version, candidate: &Version) -> bool {
+    let post_of_v = !spec_version.is_post() && !spec_version.is_dev() && candidate.is_post() && candidate.epoch() == spec_version.epoch() && same_release(spec_version, candidate) && candidate.pre() == spec_version.pre();
+    candidate > spec_version && !post_of_v
+}
+
+/// pep440_rs/1: `<V` rejects every pre-release of the same release below `V` — `1.0a1` for
+/// `<1.0a2`, `1.0.dev1` for `<1.0.dev2`, `1.0a1` for `<1.0.post1`, `1.0a1` for `<1!1.0` —
+/// although only the pre-releases of `V` itself are to be excluded.
+fn hits_less_than_prerelease_bug(spec: &VersionSpecifier, candidate: &Version) -> bool {
+    let v = spec.version();
+    *spec.operator() == Operator::LessThan && candidate.any_prerelease() && same_release(v, candidate) && should_be_less_than(v, candidate)
+}
+
+/// pep440_rs/2, /3 and /10: the `Ranges` conversion of `<X.postN`, of `>X.postN` (its lower
+/// bound skips `X.postN+1.devM`), and of specifiers whose numbers are `u64::MAX` where the
+/// conversion adds one.
+fn hits_range_bug(spec: &VersionSpecifier) -> bool {
+    let v = spec.version();
+    let release = v.release();
+    match spec.operator() {
+        Operator::LessThan => v.is_post() && !v.any_prerelease(),
+        Operator::GreaterThan => v.dev() == Some(u64::MAX) || (v.dev().is_none() && v.is_post()),
+        Operator::EqualStar | Operator::NotEqualStar => release.last() == Some(&u64::MAX),
+        Operator::TildeEqual => release.len() >= 2 && release[release.len() - 2] == u64::MAX,
+        _ => false,
+    }
+}
+
+/// pep440_rs/6: `>V` rejects every post-release of the same release above `V` — `1.0.post1`
+/// and `1.0a2.post1` for `>1.0a1`, `1.0.post1.dev0` for `>1.0.dev1` — although only the
+/// post-releases of `V` itself are to be excluded.
+fn hits_greater_than_prerelease_bug(spec: &VersionSpecifier, candidate: &Version) -> bool {
+    let v = spec.version();
+    *spec.operator() == Operator::GreaterThan && candidate.is_post() && !v.is_post() && candidate.epoch() == v.epoch() && same_release(v, candidate) && should_be_greater_than(v, candidate)
+}
+
+/// pep440_rs/7: `0.devN` sorts below `MIN_VERSION` (`0a0.dev0`).
+fn below_min_version(v: &Version) -> bool {
+    v.epoch() == 0 && v.release().iter().all(|&n| n == 0) && v.is_dev() && !v.is_pre() && !v.is_post()
+}
+
+/// pep440_rs/8: `==X.Y.*` compares only as many release parts as the candidate has, so a
+/// shorter candidate is not zero-padded (`==1.2.*` matches `1`).
+fn hits_star_padding_bug(spec: &VersionSpecifier, candidate: &Version) -> bool {
+    let v = spec.version();
+    spec.operator().is_star()
+        && v.epoch() == candidate.epoch()
+        && candidate.release().len() < v.release().len()
+        && v.release()[..candidate.release().len()] == candidate.release()[..]
+        && v.release()[candidate.release().len()..].iter().any(|&n| n != 0)
+}
+
+/// pep440_rs/9: a dev number of `u64::MAX` on a pre- or post-release is the sort key's "no
+/// dev" sentinel, so `1.0.post2.dev18446744073709551615 == 1.0.post2`.
+fn has_max_dev(v: &Version) -> bool {
+    v.dev() == Some(u64::MAX) && (v.is_pre() || v.is_post())
+}
+
+/// pep440_rs/4: blank items in a comma list.
+fn has_blank_item(text: &str) -> bool {
+    !text.is_empty() && text.split(',').any(|i| i.trim().is_empty())
+}
+
+/// pep440_rs/5: an all-digit local segment beyond u64 becomes a string segment.
+fn has_oversize_local(text: &str) -> bool {
+    match text.split_once('+') {
+        Some((_, local)) => local.trim().split(['.', '-', '_']).any(|seg| !seg.is_empty() && seg.bytes().all(|b| b.is_ascii_digit()) && seg.parse::<u64>().is_err()),
+        None => false,
+    }
+}
+
+fn parts(v: &Version) -> (u64, Vec<u64>, String, Option<u64>, Option<u64>, String) {
+    (
+        v.epoch(),
+        v.release().to_vec(),
+        v.pre().map(|p| p.to_string()).unwrap_or_default(),
+        v.post(),
+        v.dev(),
+        v.local_segments().iter().map(ToString::to_string).collect::<Vec<_>>().join("."),
+    )
+}
+
+// --------------------------------------------------------------------------- parsing
+
+#[hegel::test]
+fn versions_parse_and_normalize_like_packaging(tc: hegel::TestCase) {
+    let text = tc.draw(arb_version_text());
+    let ours = Version::from_str(&text);
+    if beyond_u64(&text) {
+        // the crate's documented limit: numbers must fit a u64
+        if ask("V", &[&text]).0 == "ok" {
+            let err = ours.expect_err("a number beyond u64 must be an error");
+            assert!(err.to_string().contains("exceeds"), "{text:?}: {err}");
+        }
+        return;
+    }
+    let theirs = py_version(&text);
+    match (&ours, &theirs) {
+        (Ok(v), Some(py)) => {
+            assert_eq!(v.to_string(), py.normalized, "normalized form of {text:?}");
+            assert_eq!(parts(v), (py.epoch, py.release.clone(), py.pre.clone(), py.post, py.dev, py.local.clone()), "parts of {text:?}");
+            assert_eq!(v.is_local(), !py.local.is_empty());
+            assert_eq!(v.is_pre(), !py.pre.is_empty());
+            assert_eq!(v.is_post(), py.post.is_some());
+            assert_eq!(v.is_dev(), py.dev.is_some());
+            assert_eq!(v.any_prerelease(), v.is_pre() || v.is_dev());
+            assert_eq!(v.is_stable(), !v.any_prerelease());
+            // the normalized form parses back to the same version, and is a fixed point
+            let again = Version::from_str(&py.normalized).unwrap();
+            assert_eq!(again, *v);
+            assert_eq!(again.to_string(), py.normalized);
+            assert_eq!(hash_of(&again), hash_of(v));
+            // the pattern parser agrees on verbatim texts
+            let pat = VersionPattern::from_str(&text).unwrap();
+            assert!(!is_wildcard(&pat));
+            assert_eq!(pat.version(), v);
+            // the local segments are numbers when they are digits
+            for seg in v.local_segments() {
+                match seg {
+                    LocalSegment::Number(n) => assert!(n.to_string().len() <= 20),
+                    LocalSegment::String(s) => {
+                        assert!(s.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit()), "{s}");
+                        assert!(s.parse::<u64>().is_err(), "{s} is a number");
+                    }
+                }
+            }
+            if !below_min_version(v) {
+                assert!(*MIN_VERSION <= *v, "{text:?} below MIN_VERSION");
+            }
+        }
+        (Err(_), None) => {
+            // the error message names the problem
+            assert!(!ours.as_ref().unwrap_err().to_string().is_empty());
+            assert!(VersionPattern::from_str(&text).is_err() || text.trim().ends_with(".*"));
+        }
+        (Ok(v), None) => panic!("{text:?}: pep440_rs accepts ({v}), packaging rejects"),
+        (Err(e), Some(py)) => panic!("{text:?}: pep440_rs rejects ({e}), packaging accepts ({})", py.normalized),
+    }
+}
