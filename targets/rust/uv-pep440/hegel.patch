+/// Holds in `uv-pep440` (pep440_rs/1 was fixed in the fork): PEP 440, "the exclusive ordered comparison <V MUST NOT allow a pre-release of
+/// the specified version unless the specified version is itself a pre-release" — so `<1.0a2`
+/// admits `1.0a1`, `<1.0.dev2` admits `1.0.dev1`, `<1.0.post1` admits `1.0a1` and `1.0.dev0`,
+/// `<1!1.0` admits `1.0a1`; only `<1.0` excludes `1.0a1`, `1.0.dev0`, `1.0.post0.dev0`.
+#[hegel::test]
+fn less_than_admits_the_prereleases_of_other_versions(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap().without_local();
+    let spec = VersionSpecifier::less_than_version(v.clone());
+    let plain = v.clone().with_pre(None).with_dev(None).with_post(None);
+    let n = tc.draw(int!(0u64, 2));
+    let mut cands = vec![
+        plain.clone().with_dev(Some(n)),
+        plain.clone().with_pre(Some(Prerelease { kind: PrereleaseKind::Alpha, number: n })),
+        plain.clone().with_pre(Some(Prerelease { kind: PrereleaseKind::Rc, number: n })).with_dev(Some(0)),
+        plain.clone().with_post(Some(n)).with_dev(Some(0)),
+        v.clone().with_dev(Some(n)),
+        plain.clone().with_epoch(v.epoch().saturating_sub(1)).with_pre(Some(Prerelease { kind: PrereleaseKind::Beta, number: n })),
+    ];
+    if let Some(p) = v.pre() {
+        cands.push(v.clone().with_pre(Some(Prerelease { kind: p.kind, number: p.number.saturating_sub(1) })));
+    }
+    if let Some(d) = v.dev() {
+        cands.push(v.clone().with_dev(Some(d.saturating_sub(1))));
+    }
+    for c in cands {
+        let want = should_be_less_than(&v, &c);
+        let py = py_contains(false, &spec.to_string(), &[c.to_string()]).unwrap()[0];
+        assert_eq!(py, want, "packaging on {spec} / {c}");
+        assert_eq!(spec.contains(&c), want, "{spec} contains {c}");
+    }
+}
+
+/// Holds in `uv-pep440` (pep440_rs/2 was fixed in the fork): the range of `<X.postN` must keep `X` and the lower post-releases of `X`, as
+/// `VersionSpecifier::contains` does.
+#[cfg(feature = "version-ranges")]
+#[hegel::test]
+fn less_than_a_post_release_range_keeps_the_release(tc: hegel::TestCase) {
+    use version_ranges::Ranges;
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap().without_local().with_pre(None).with_dev(None).with_post(Some(tc.draw(int!(0u64, 3))));
+    let spec = VersionSpecifier::less_than_version(v.clone());
+    let range = Ranges::<Version>::from(spec.clone());
+    let cands = [v.clone().with_post(None), v.clone().with_post(v.post().map(|p| p.saturating_sub(1))), v.clone().with_post(None).with_pre(Some(Prerelease { kind: PrereleaseKind::Rc, number: 1 })), v.clone().with_post(None).with_dev(Some(0)), v.clone()];
+    for c in cands {
+        assert_eq!(range.contains(&c), spec.contains(&c), "{spec} as the range {range}, on {c}");
+    }
+}
