+// --------------------------------------------------------------------------- ordering
+
+#[hegel::test]
+fn versions_order_like_packaging(tc: hegel::TestCase) {
+    let a = tc.draw(arb_valid_version_text());
+    let va = Version::from_str(&a).unwrap();
+    let b = if tc.draw(generators::booleans()) { tc.draw(arb_related(&va)) } else { tc.draw(arb_valid_version_text()) };
+    let vb = Version::from_str(&b).unwrap_or_else(|e| panic!("{b:?}: {e}"));
+    if has_oversize_local(&a) || has_oversize_local(&b) {
+        return; // pep440_rs/5
+    }
+    if has_max_dev(&va) || has_max_dev(&vb) {
+        return; // pep440_rs/9
+    }
+    let want = py_cmp(&a, &b);
+    assert_eq!(va.cmp(&vb), want, "{a:?} vs {b:?} ({va} vs {vb})");
+    assert_eq!(vb.cmp(&va), want.reverse());
+    assert_eq!(va == vb, want == Ordering::Equal);
+    if va == vb {
+        assert_eq!(hash_of(&va), hash_of(&vb), "{a:?} vs {b:?}");
+    }
+    // the release compares with zero padding: trailing zeros never matter
+    let padded = Version::new(va.release().iter().copied().chain([0])).with_epoch(va.epoch());
+    let plain = va.only_release().with_epoch(va.epoch());
+    assert_eq!(padded, plain, "{padded} vs {plain}");
+    assert_eq!(hash_of(&padded), hash_of(&plain));
+    assert_eq!(padded.cmp(&va), plain.cmp(&va));
+    let _ = vb.cmp(&*MIN_VERSION);
+}
