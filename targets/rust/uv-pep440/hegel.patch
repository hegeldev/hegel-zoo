+// --------------------------------------------------------------------------- specifiers
+
+const OPS: [&str; 7] = ["==", "!=", "<=", ">=", "<", ">", "~="];
+
+#[hegel::composite]
+fn arb_specifier_text(tc: &hegel::TestCase) -> String {
+    let op = OPS[tc.draw(int!(0usize, OPS.len() - 1))];
+    let mut s = String::new();
+    if tc.draw(int!(0u8, 5)) == 0 {
+        s.push(' ');
+    }
+    s.push_str(op);
+    if tc.draw(int!(0u8, 3)) == 0 {
+        s.push_str(WS[tc.draw(int!(0usize, WS.len() - 1))]);
+    }
+    let version = if tc.draw(int!(0u8, 4)) == 0 { tc.draw(arb_version_text()) } else { tc.draw(arb_valid_version_text()) };
+    s.push_str(version.trim());
+    if tc.draw(int!(0u8, 4)) == 0 {
+        s.push_str(".*");
+    }
+    if tc.draw(int!(0u8, 5)) == 0 {
+        s.push_str(WS[tc.draw(int!(0usize, WS.len() - 1))]);
+    }
+    s
+}
+
+fn candidates(tc: &hegel::TestCase, around: &Version, n: usize) -> Vec<String> {
+    let mut out = Vec::new();
+    for _ in 0..n {
+        let t = if tc.draw(int!(0u8, 3)) == 0 { tc.draw(arb_valid_version_text()) } else { tc.draw(arb_related(around)) };
+        if let Ok(v) = Version::from_str(&t) {
+            out.push(v.to_string());
+        }
+    }
+    out
+}
+
+#[hegel::test]
+fn specifiers_parse_and_contain_like_packaging(tc: hegel::TestCase) {
+    let spec = tc.draw(arb_specifier_text());
+    if beyond_u64(&spec) {
+        return;
+    }
+    let ours = VersionSpecifier::from_str(&spec);
+    let theirs = py_contains(false, &spec, &[]);
+    let parsed = match (&ours, &theirs) {
+        (Ok(s), Some(_)) => s.clone(),
+        (Err(_), None) => {
+            assert!(!ours.as_ref().unwrap_err().to_string().is_empty());
+            return;
+        }
+        (Ok(s), None) => panic!("{spec:?}: pep440_rs accepts ({s}), packaging rejects"),
+        (Err(e), Some(_)) => panic!("{spec:?}: pep440_rs rejects ({e}), packaging accepts"),
+    };
+    // Display round trip
+    let shown = parsed.to_string();
+    assert_eq!(VersionSpecifier::from_str(&shown).unwrap(), parsed, "{spec:?} -> {shown:?}");
+    assert_eq!(py_contains(false, &shown, &[]).is_some(), true, "{shown:?} not accepted by packaging");
+    // containment, with the pre-release policy left to the caller (prereleases=True)
+    let cands = candidates(&tc, parsed.version(), 6);
+    if cands.is_empty() || has_max_dev(parsed.version()) {
+        return;
+    }
+    let want = py_contains(false, &spec, &cands).unwrap();
+    for (c, w) in cands.iter().zip(want) {
+        let v = Version::from_str(c).unwrap();
+        if has_max_dev(&v) || hits_less_than_prerelease_bug(&parsed, &v) || hits_greater_than_prerelease_bug(&parsed, &v) || hits_star_padding_bug(&parsed, &v) {
+            continue;
+        }
+        assert_eq!(parsed.contains(&v), w, "{spec:?} contains {c:?}");
+    }
+}
+
+#[hegel::test]
+fn specifier_sets_parse_and_contain_like_packaging(tc: hegel::TestCase) {
+    let k = tc.draw(int!(0usize, 4));
+    let mut items: Vec<String> = (0..k).map(|_| tc.draw(arb_specifier_text())).collect();
+    if tc.draw(int!(0u8, 5)) == 0 {
+        items.push(tc.draw(generators::sampled_from(vec!["", " ", "1.0", "=="])).to_string());
+    }
+    let text = items.join(",");
+    if text.split(',').any(beyond_u64) || has_blank_item(&text) {
+        return; // pep440_rs/4 for the blanks
+    }
+    let ours = VersionSpecifiers::from_str(&text);
+    let theirs = py_contains(true, &text, &[]);
+    let parsed = match (&ours, &theirs) {
+        (Ok(s), Some(_)) => s.clone(),
+        (Err(e), None) => {
+            assert!(e.to_string().starts_with("Failed to parse version:"), "{e}");
+            assert_eq!(e.line(), &text);
+            return;
+        }
+        (Ok(s), None) => panic!("{text:?}: pep440_rs accepts ({s}), packaging rejects"),
+        (Err(e), Some(_)) => panic!("{text:?}: pep440_rs rejects ({e}), packaging accepts"),
+    };
+    assert_eq!(parsed.len(), items.iter().filter(|i| !i.trim().is_empty()).count(), "{text:?}");
+    assert_eq!(parsed.is_empty(), parsed.len() == 0);
+    // sorted by version, Display / serde round trips
+    for w in parsed.windows(2) {
+        assert!(w[0].version() <= w[1].version(), "{text:?} -> {parsed}");
+    }
+    let shown = parsed.to_string();
+    assert_eq!(VersionSpecifiers::from_str(&shown).unwrap(), parsed, "{text:?} -> {shown:?}");
+    let json = serde_json::to_string(&parsed).unwrap();
+    let back: VersionSpecifiers = serde_json::from_str(&json).unwrap();
+    assert_eq!(back, parsed);
+    assert_eq!(json, serde_json::to_string(&parsed.iter().map(ToString::to_string).collect::<Vec<_>>().join(",")).unwrap());
+    // containment is the conjunction, and agrees with packaging
+    let around = parsed.first().map(|s| s.version().clone()).unwrap_or_else(|| Version::new([1u64]));
+    let cands = candidates(&tc, &around, 5);
+    if cands.is_empty() {
+        return;
+    }
+    let want = py_contains(true, &text, &cands).unwrap();
+    for (c, w) in cands.iter().zip(want) {
+        let v = Version::from_str(c).unwrap();
+        assert_eq!(parsed.contains(&v), parsed.iter().all(|s| s.contains(&v)));
+        if has_max_dev(&v) || parsed.iter().any(|s| has_max_dev(s.version()) || hits_less_than_prerelease_bug(s, &v) || hits_greater_than_prerelease_bug(s, &v) || hits_star_padding_bug(s, &v)) {
+            continue;
+        }
+        assert_eq!(parsed.contains(&v), w, "{text:?} contains {c:?}");
+    }
+}
