+/// uv-pep440/3 (pep440_rs/6): PEP 440, ">V MUST NOT allow a post-release of the given version unless V is
+/// itself a post release" — `1.0.post1` and `1.0a2.post1` are not post-releases of `1.0a1`, so
+/// `>1.0a1` admits them, and `>1.0.dev1` admits `1.0.post1.dev0` (`packaging` agrees, and so
+/// does the crate's range conversion); only `1.0a1.postN` is excluded by `>1.0a1`.
+#[hegel::test]
+fn greater_than_admits_the_post_releases_of_other_versions(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap().without_local().with_post(None);
+    let spec = VersionSpecifier::greater_than_version(v.clone());
+    let plain = v.clone().with_pre(None).with_dev(None);
+    let n = tc.draw(int!(0u64, 2));
+    let mut cands = vec![
+        v.clone().with_post(Some(n)),
+        v.clone().with_post(Some(n)).with_dev(Some(0)),
+        plain.clone().with_post(Some(n)),
+        plain.clone().with_post(Some(n)).with_dev(Some(0)),
+        plain.clone().with_pre(Some(Prerelease { kind: PrereleaseKind::Rc, number: n })).with_post(Some(n)),
+    ];
+    if let Some(p) = v.pre() {
+        cands.push(v.clone().with_pre(Some(Prerelease { kind: p.kind, number: p.number + 1 })).with_post(Some(n)));
+    }
+    for c in cands {
+        let want = should_be_greater_than(&v, &c);
+        let py = py_contains(false, &spec.to_string(), &[c.to_string()]).unwrap()[0];
+        assert_eq!(py, want, "packaging on {spec} / {c}");
+        assert_eq!(spec.contains(&c), want, "{spec} contains {c}");
+        #[cfg(feature = "version-ranges")]
+        if want {
+            assert!(version_ranges::Ranges::<Version>::from(spec.clone()).contains(&c), "{spec} as a range, on {c}");
+        }
+    }
+}
