+/// uv-pep440/5 (pep440_rs/11): PEP 440 — "arbitrary equality comparisons are simple string equality
+/// operations which do not take into account any of the semantic information such as zero
+/// padding or local versions … `===foobar`". The operand of `===` is any string without
+/// whitespace (`packaging`'s grammar: `===\s*[^\s;)]*`), so `===foobar`, `===1.0-custom`,
+/// `===1.0.*` and `===v1.0` are valid specifiers; the crate parses the operand as a PEP 440
+/// version and rejects them ("expected version to start with a number").
+#[hegel::test]
+fn arbitrary_equality_takes_any_string(tc: hegel::TestCase) {
+    const CHARS: [&str; 14] = ["a", "b", "z", "Z", "f", "o", "0", "1", "9", ".", "-", "_", "+", "*"];
+    let len = tc.draw(int!(1usize, 8));
+    let mut operand: String = (0..len).map(|_| CHARS[tc.draw(int!(0usize, CHARS.len() - 1))]).collect();
+    if Version::from_str(&operand).is_ok() {
+        operand.insert(0, 'v'); // a valid version is the case the crate gets right
+        if Version::from_str(&operand).is_ok() {
+            operand.insert(0, 'x');
+        }
+    }
+    let text = format!("==={operand}");
+    let theirs = py_specifier(&text);
+    assert_eq!(theirs, Some(("===".to_string(), operand.clone())), "{text:?}: packaging");
+    let ours = VersionSpecifier::from_str(&text);
+    assert!(ours.is_ok(), "{text:?}: rejected by the crate: {}", ours.unwrap_err());
+    let ours = VersionSpecifiers::from_str(&format!("{text}, >=1.0"));
+    assert!(ours.is_ok(), "{text:?}, >=1.0: rejected by the crate: {}", ours.unwrap_err());
+}
