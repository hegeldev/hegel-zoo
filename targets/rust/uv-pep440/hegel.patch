+/// uv-pep440/1 (pep440_rs/4, inherited from the fork's origin): `packaging` skips blank items in a comma list (`">=1.0,"`, `" "`); the crate
+/// only special-cases the empty string.
+#[hegel::test]
+fn blank_items_in_specifier_sets_are_skipped_like_packaging(tc: hegel::TestCase) {
+    let k = tc.draw(int!(0usize, 3));
+    let mut items: Vec<String> = Vec::new();
+    for _ in 0..k {
+        let s = tc.draw(arb_valid_version_text());
+        items.push(format!("{}{}", OPS[tc.draw(int!(0usize, 5))], s.trim()));
+    }
+    let blank = tc.draw(generators::sampled_from(vec!["", " ", "\t"])).to_string();
+    items.insert(tc.draw(int!(0usize, items.len())), blank);
+    let text = items.join(",");
+    if VersionSpecifiers::from_str(&items.iter().filter(|i| !i.trim().is_empty()).cloned().collect::<Vec<_>>().join(",")).is_err() {
+        return;
+    }
+    assert!(py_contains(true, &text, &[]).is_some(), "packaging rejects {text:?}");
+    let parsed = VersionSpecifiers::from_str(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    assert_eq!(parsed.len(), items.len() - 1);
+}
