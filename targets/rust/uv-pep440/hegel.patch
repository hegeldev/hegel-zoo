+#[cfg(feature = "version-ranges")]
+#[hegel::test]
+fn ranges_agree_with_contains(tc: hegel::TestCase) {
+    use version_ranges::Ranges;
+    let spec = tc.draw(arb_specifier_text());
+    let Ok(parsed) = VersionSpecifier::from_str(&spec) else {
+        return;
+    };
+    if *parsed.operator() == Operator::ExactEqual || parsed.version().is_local() || hits_range_bug(&parsed) || has_max_dev(parsed.version()) {
+        return;
+    }
+    let range = Ranges::<Version>::from(parsed.clone());
+    for c in candidates(&tc, parsed.version(), 6) {
+        let v = Version::from_str(&c).unwrap();
+        if v.is_local() || has_max_dev(&v) || hits_less_than_prerelease_bug(&parsed, &v) || hits_greater_than_prerelease_bug(&parsed, &v) || hits_star_padding_bug(&parsed, &v) {
+            // local versions sit above their public version in the total order, which a range
+            // over that order cannot fold back onto it (uv handles them before resolution)
+            continue;
+        }
+        assert_eq!(range.contains(&v), parsed.contains(&v), "{spec:?} as a range, on {c}: {range}");
+    }
+    // a set is the intersection
+    let k = tc.draw(int!(0usize, 3));
+    let specs: Vec<VersionSpecifier> = (0..k).filter_map(|_| VersionSpecifier::from_str(&tc.draw(arb_specifier_text())).ok()).filter(|s| *s.operator() != Operator::ExactEqual && !s.version().is_local() && !hits_range_bug(s) && !has_max_dev(s.version())).collect();
+    let set: VersionSpecifiers = specs.iter().cloned().collect();
+    let range = Ranges::<Version>::from(set.clone());
+    for c in candidates(&tc, parsed.version(), 4) {
+        let v = Version::from_str(&c).unwrap();
+        if v.is_local() || has_max_dev(&v) || specs.iter().any(|s| hits_less_than_prerelease_bug(s, &v) || hits_greater_than_prerelease_bug(s, &v) || hits_star_padding_bug(s, &v)) {
+            continue;
+        }
+        assert_eq!(range.contains(&v), set.contains(&v), "{set} as a range, on {c}");
+    }
+}
