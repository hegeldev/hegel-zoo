+/// Holds in `uv-pep440` (pep440_rs/8 was fixed in the fork): PEP 440 prefix matching pads the candidate's release with zeros to the length
+/// of the prefix, so `==1.2.*` does not match `1` (`packaging` agrees; the crate's range
+/// conversion agrees).
+#[hegel::test]
+fn star_prefix_matching_pads_the_candidate(tc: hegel::TestCase) {
+    let base = Version::from_str(&tc.draw(arb_valid_version_text())).unwrap();
+    let mut release = base.release().to_vec();
+    release.truncate(tc.draw(int!(1usize, release.len())));
+    release.push(tc.draw(int!(1u64, 3)));
+    if tc.draw(generators::booleans()) {
+        release.push(0);
+    }
+    let pattern = Version::new(release.iter().copied()).with_epoch(base.epoch());
+    let candidate = Version::new(base.release().iter().copied().take(release.len() - 1 - usize::from(*release.last().unwrap() == 0))).with_epoch(base.epoch());
+    for op in ["==", "!="] {
+        let spec = VersionSpecifier::from_str(&format!("{op}{pattern}.*")).unwrap();
+        let py = py_contains(false, &spec.to_string(), &[candidate.to_string()]).unwrap()[0];
+        assert_eq!(py, op == "!=", "packaging on {spec} / {candidate}");
+        assert_eq!(spec.contains(&candidate), py, "{spec} contains {candidate}");
+        #[cfg(feature = "version-ranges")]
+        assert_eq!(version_ranges::Ranges::<Version>::from(spec.clone()).contains(&candidate), py, "{spec} as a range, on {candidate}");
+    }
+}
