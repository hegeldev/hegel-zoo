+#[hegel::test]
+fn versions_built_from_parts_equal_parsed_ones(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    let built = Version::new(v.release().iter().copied())
+        .with_epoch(v.epoch())
+        .with_pre(v.pre())
+        .with_post(v.post())
+        .with_dev(v.dev())
+        .with_local(v.local_segments());
+    assert_eq!(built, v);
+    assert_eq!(built.to_string(), v.to_string());
+    assert_eq!(parts(&built), parts(&v));
+    // and in another order of setters
+    let built2 = Version::new([0u64]).with_local(v.local_segments()).with_dev(v.dev()).with_post(v.post()).with_pre(v.pre()).with_epoch(v.epoch()).with_release(v.release().iter().copied());
+    assert_eq!(built2.to_string(), v.to_string());
+    // stripping
+    let stripped = v.clone().without_local();
+    assert!(!stripped.is_local());
+    assert_eq!(stripped.to_string(), v.to_string().split('+').next().unwrap());
+    let only = v.only_release();
+    assert_eq!(&only.release()[..], &v.release()[..]);
+    assert!(only.is_stable() && !only.is_post() && !only.is_local() && only.epoch() == 0);
+    // the pre-release kinds order a < b < rc
+    let (pa, pb, prc) = (
+        Version::new([1u64]).with_pre(Some(Prerelease { kind: PrereleaseKind::Alpha, number: 9 })),
+        Version::new([1u64]).with_pre(Some(Prerelease { kind: PrereleaseKind::Beta, number: 0 })),
+        Version::new([1u64]).with_pre(Some(Prerelease { kind: PrereleaseKind::Rc, number: 0 })),
+    );
+    assert!(pa < pb && pb < prc && prc < Version::new([1u64]));
+    assert_eq!(pa.to_string(), "1a9");
+    // a small and a full representation of the same version agree
+    let base = v.clone().without_local();
+    let big = base.clone().with_local(vec![LocalSegment::Number(1)]).without_local();
+    assert_eq!(big, base);
+    assert_eq!(big.cmp(&base), Ordering::Equal);
+    assert_eq!(hash_of(&big), hash_of(&base));
+    let other = Version::from_str(&tc.draw(arb_valid_version_text())).unwrap();
+    assert_eq!(big.cmp(&other), base.cmp(&other));
+    assert_eq!(other.cmp(&big), other.cmp(&base));
+}
