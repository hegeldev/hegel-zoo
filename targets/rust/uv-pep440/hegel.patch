+#[cfg(feature = "version-ranges")]
+#[hegel::test]
+fn release_only_ranges_agree_with_contains_on_release_only_versions(tc: hegel::TestCase) {
+    use uv_pep440::{release_specifier_to_range, release_specifiers_to_ranges};
+    let spec = tc.draw(arb_specifier_text());
+    let Ok(parsed) = VersionSpecifier::from_str(&spec) else {
+        return;
+    };
+    // release-only semantics strip the specifier's version too; the documented contract is
+    // for specifiers and candidates made of release segments only
+    if !parsed.version().is_stable() || parsed.version().is_post() || parsed.version().is_local() || parsed.version().epoch() != 0 || hits_range_bug(&parsed) {
+        return;
+    }
+    let range = release_specifier_to_range(parsed.clone(), false);
+    let set_range = release_specifiers_to_ranges(VersionSpecifiers::from(parsed.clone()));
+    assert_eq!(range, set_range);
+    for c in candidates(&tc, parsed.version(), 6) {
+        let v = Version::from_str(&c).unwrap().only_release();
+        if hits_star_padding_bug(&parsed, &v) {
+            continue;
+        }
+        assert_eq!(range.contains(&v), parsed.contains(&v), "{spec:?} as a release-only range, on {v}: {range}");
+    }
+}
