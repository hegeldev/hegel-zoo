+/// Holds in `uv-pep440` (pep440_rs/10 was fixed in the fork): `>X.postN` admits `X.postN+1.devM` (`contains` does, and so does `packaging`),
+/// but the range conversion starts at `X.postN+1` and skips those dev releases.
+#[cfg(feature = "version-ranges")]
+#[hegel::test]
+fn greater_than_a_post_release_range_keeps_the_next_dev_releases(tc: hegel::TestCase) {
+    use version_ranges::Ranges;
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap().without_local().with_dev(None).with_post(Some(tc.draw(int!(0u64, 3))));
+    let spec = VersionSpecifier::greater_than_version(v.clone());
+    let range = Ranges::<Version>::from(spec.clone());
+    let c = v.clone().with_post(v.post().map(|p| p + 1)).with_dev(Some(tc.draw(int!(0u64, 3))));
+    let py = py_contains(false, &spec.to_string(), &[c.to_string()]).unwrap()[0];
+    assert!(py && spec.contains(&c), "{spec} contains {c}");
+    assert!(range.contains(&c), "{spec} as the range {range}, on {c}");
+}
