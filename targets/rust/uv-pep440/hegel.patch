+/// uv-pep440/4 (pep440_rs/7): `MIN_VERSION` is documented as the smallest version, but `0.dev0` sorts below
+/// `0a0.dev0` (a dev release of a final version precedes its pre-releases).
+#[hegel::test]
+fn min_version_is_below_every_version(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    let candidates = [v.clone(), v.only_release().with_dev(Some(0)), Version::new([0u64]).with_dev(Some(tc.draw(int!(0u64, 3))))];
+    for c in candidates {
+        assert!(*MIN_VERSION <= c, "{c} < MIN_VERSION {}", *MIN_VERSION);
+    }
+}
