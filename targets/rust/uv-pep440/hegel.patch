+/// uv-pep440/2 (pep440_rs/5): an all-digit local segment is a number, however large (`packaging` uses
+/// Python integers); the crate keeps segments beyond `u64` as strings, which sort below every
+/// number.
+#[hegel::test]
+fn oversize_local_numbers_order_as_numbers(tc: hegel::TestCase) {
+    let base = Version::from_str(&tc.draw(arb_valid_version_text())).unwrap().without_local();
+    let big = format!("{base}+{}", tc.draw(generators::sampled_from(vec!["18446744073709551616", "99999999999999999999", "184467440737095516150"])));
+    let small = format!("{base}+{}", tc.draw(int!(0u64, 5)));
+    let (vb, vs) = (Version::from_str(&big).unwrap(), Version::from_str(&small).unwrap());
+    assert_eq!(py_cmp(&big, &small), Ordering::Greater);
+    assert_eq!(vb.cmp(&vs), Ordering::Greater, "{big} vs {small}: {:?}", vb.local());
+}
