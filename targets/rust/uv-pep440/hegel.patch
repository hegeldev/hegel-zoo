+#[hegel::test]
+fn specifier_builders_validate_like_the_parser(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    if has_max_dev(&v) {
+        return; // pep440_rs/9
+    }
+    let ops = [Operator::Equal, Operator::NotEqual, Operator::LessThan, Operator::LessThanEqual, Operator::GreaterThan, Operator::GreaterThanEqual, Operator::TildeEqual, Operator::ExactEqual];
+    let cands = candidates(&tc, &v, 3);
+    for op in ops {
+        let built = VersionSpecifier::from_version(op, v.clone());
+        let parsed = VersionSpecifier::from_str(&format!("{op}{v}"));
+        match (&built, &parsed) {
+            (Ok(b), Ok(p)) => {
+                assert_eq!(b, p);
+                assert_eq!(b.operator(), &op);
+                assert_eq!(b.version(), &v);
+                assert_eq!((*b.operator(), b.version().clone()), (op, v.clone()));
+                assert_eq!(b.any_prerelease(), v.any_prerelease());
+                assert_eq!(b.has_lower_bound(), !matches!(op, Operator::LessThan | Operator::LessThanEqual | Operator::NotEqual));
+                assert!(b.contains(&v) || op == Operator::LessThan || op == Operator::GreaterThan || op == Operator::NotEqual, "{op}{v} does not contain {v}");
+                if op == Operator::ExactEqual {
+                    assert!(b.contains(&v));
+                    for c in &cands {
+                        let cv = Version::from_str(c).unwrap();
+                        if has_max_dev(&cv) {
+                            continue;
+                        }
+                        assert_eq!(b.contains(&cv), cv.to_string() == v.to_string(), "{b} on {c}");
+                    }
+                }
+            }
+            (Err(b), Err(p)) => assert_eq!(b.to_string(), p.to_string(), "{op}{v}"),
+            (b, p) => panic!("{op}{v}: from_version {b:?}, from_str {p:?}"),
+        }
+        // the documented constraints
+        let local_ok = matches!(op, Operator::Equal | Operator::NotEqual | Operator::ExactEqual);
+        if v.is_local() {
+            assert_eq!(built.is_ok(), local_ok, "{op}{v}");
+            if !local_ok {
+                assert!(built.as_ref().unwrap_err().to_string().contains("incompatible with versions containing non-empty local segments"));
+            }
+        } else if op == Operator::TildeEqual {
+            assert_eq!(built.is_ok(), v.release().len() >= 2, "{op}{v}");
+            if v.release().len() < 2 {
+                assert!(built.as_ref().unwrap_err().to_string().contains("requires at least two segments"));
+            }
+        } else {
+            assert!(built.is_ok(), "{op}{v}: {built:?}");
+        }
+        // stars
+        let star = VersionSpecifier::from_pattern(op, VersionPattern::wildcard(v.clone()));
+        let starop = match op {
+            Operator::Equal => Some(Operator::EqualStar),
+            Operator::NotEqual => Some(Operator::NotEqualStar),
+            _ => None,
+        };
+        match starop {
+            Some(starop) => {
+                if !v.is_local() {
+                    let s = star.unwrap();
+                    assert_eq!(*s.operator(), starop);
+                    assert!(starop.is_star());
+                    assert_eq!(s.to_string(), format!("{op}{v}.*"));
+                }
+            }
+            None => assert!(star.unwrap_err().to_string().contains("cannot be used with a wildcard"), "{op}"),
+        }
+        // negation
+        match op.negate() {
+            None => assert_eq!(op, Operator::TildeEqual),
+            Some(neg) => {
+                let n = VersionSpecifier::from_version(neg, v.clone());
+                if let (Ok(b), Ok(n)) = (&built, &n) {
+                    for c in &cands {
+                        let cv = Version::from_str(c).unwrap();
+                        // pre- and post-release exclusions make `<`/`>` and their negations
+                        // agree only across releases
+                        if op == Operator::ExactEqual || v.is_local() || cv.is_local() || same_release(&v, &cv) || has_max_dev(&cv) {
+                            continue;
+                        }
+                        assert_ne!(b.contains(&cv), n.contains(&cv), "{b} / {n} on {c}");
+                    }
+                }
+            }
+        }
+    }
+    assert_eq!(Operator::from_str("==="), Ok(Operator::ExactEqual));
+    assert!(Operator::from_str("=").unwrap_err().to_string().contains("no such comparison operator"));
+    assert!(Operator::from_str("~==").is_err());
+    for op in ops {
+        assert_eq!(Operator::from_str(&op.to_string()), Ok(op));
+    }
+}
