+#[hegel::test]
+fn wildcard_patterns_parse_like_packaging_specifiers(tc: hegel::TestCase) {
+    // a pattern is a version with a trailing `.*`; packaging has no such type, so `==<pattern>`
+    // as a specifier is the reference
+    let mut text = tc.draw(arb_version_text());
+    if tc.draw(generators::booleans()) {
+        text = text.trim().to_string();
+        text.push_str(".*");
+    }
+    if beyond_u64(&text) {
+        return;
+    }
+    let ours = VersionPattern::from_str(&text);
+    let theirs = py_contains(false, &format!("=={text}"), &[]);
+    match (&ours, &theirs) {
+        (Ok(pat), Some(_)) => {
+            assert_eq!(is_wildcard(&pat), text.trim().ends_with(".*"), "{text:?}");
+            if is_wildcard(&pat) {
+                let spec = VersionSpecifier::from_str(&format!("=={text}")).unwrap();
+                assert_eq!(*spec.operator(), Operator::EqualStar);
+                assert_eq!(spec.version(), pat.version());
+                assert!(Version::from_str(&text).unwrap_err().to_string().contains("wildcard"));
+            }
+        }
+        (Err(_), None) => {}
+        (Ok(pat), None) => panic!("{text:?}: pep440_rs accepts ({pat:?}), packaging rejects =={text}"),
+        (Err(e), Some(_)) => panic!("{text:?}: pep440_rs rejects ({e}), packaging accepts =={text}"),
+    }
+}
