+    // ----- Every arithmetic result keeps the reduced invariant -------------
+
+    #[hegel::test]
+    fn hegel_ops_preserve_reduced_invariant(tc: hegel::TestCase) {
+        let op = tc.draw(generators::sampled_from(vec![
+            "add", "sub", "mul", "div", "rem", "neg",
+        ]));
+        {
+            let a = tc.draw((gens::small_i64_ratios()).print_as_debug());
+            let b = tc.draw((gens::small_i64_ratios()).print_as_debug());
+            tc.assume(!(b.is_zero() && (op == "div" || op == "rem")));
+            let c = match op {
+                "add" => a + b,
+                "sub" => a - b,
+                "mul" => a * b,
+                "div" => a / b,
+                "rem" => a % b,
+                "neg" => -a,
+                _ => unreachable!(),
+            };
+            gens::assert_reduced(&c);
+        }
+        #[cfg(feature = "num-bigint")]
+        {
+            let a = tc.draw((gens::big_ratios()).print_as_debug());
+            let b = tc.draw((gens::big_ratios()).print_as_debug());
+            tc.assume(!(b.is_zero() && (op == "div" || op == "rem")));
+            let c = match op {
+                "add" => a + b,
+                "sub" => a - b,
+                "mul" => a * b,
+                "div" => a / b,
+                "rem" => a % b,
+                "neg" => -a,
+                _ => unreachable!(),
+            };
+            gens::assert_reduced(&c);
+        }
+    }
