+    // ----- op-assign forms agree with the binary operators ------------------
+
+    fn check_op_assign<T>(a: Ratio<T>, b: Ratio<T>, k: T, op: &str)
+    where
+        T: Clone + Integer + NumAssign + Debug,
+    {
+        let mut x = a.clone();
+        let mut y = a.clone();
+        match op {
+            "add" => {
+                x += b.clone();
+                assert_eq!(x, a.clone() + b);
+                y += k.clone();
+                assert_eq!(y, a + Ratio::from_integer(k));
+            }
+            "sub" => {
+                x -= b.clone();
+                assert_eq!(x, a.clone() - b);
+                y -= k.clone();
+                assert_eq!(y, a - Ratio::from_integer(k));
+            }
+            "mul" => {
+                x *= b.clone();
+                assert_eq!(x, a.clone() * b);
+                y *= k.clone();
+                assert_eq!(y, a * Ratio::from_integer(k));
+            }
+            "div" => {
+                x /= b.clone();
+                assert_eq!(x, a.clone() / b);
+                y /= k.clone();
+                assert_eq!(y, a / Ratio::from_integer(k));
+            }
+            "rem" => {
+                x %= b.clone();
+                assert_eq!(x, a.clone() % b);
+                y %= k.clone();
+                assert_eq!(y, a % Ratio::from_integer(k));
+            }
+            _ => unreachable!(),
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_op_assign_matches_binop(tc: hegel::TestCase) {
+        let op = tc.draw(generators::sampled_from(vec![
+            "add", "sub", "mul", "div", "rem",
+        ]));
+        {
+            let a = tc.draw((gens::small_i64_ratios()).print_as_debug());
+            let b = tc.draw((gens::small_i64_ratios()).print_as_debug());
+            let k = tc.draw(
+                generators::integers::<i64>()
+                    .min_value(-(1 << 12))
+                    .max_value(1 << 12),
+            );
+            tc.assume(!((b.is_zero() || k == 0) && (op == "div" || op == "rem")));
+            check_op_assign(a, b, k, op);
+        }
+        #[cfg(feature = "num-bigint")]
+        {
+            let a = tc.draw((gens::big_ratios()).print_as_debug());
+            let b = tc.draw((gens::big_ratios()).print_as_debug());
+            let k = tc.draw((gens::big_ints()).print_as_debug());
+            tc.assume(!((b.is_zero() || k.is_zero()) && (op == "div" || op == "rem")));
+            check_op_assign(a, b, k, op);
+        }
+    }
