+    fn check_additive_inverse<T: Clone + Integer + Signed + Debug>(a: Ratio<T>, b: Ratio<T>) {
+        assert!((a.clone() + (-a.clone())).is_zero());
+        assert!((a.clone() - a.clone()).is_zero());
+        assert_eq!(a.clone() - b.clone(), a + (-b));
+    }
