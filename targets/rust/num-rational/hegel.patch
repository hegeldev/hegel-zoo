+    // ----- Rem is consistent with div/trunc ---------------------------------
+
+    fn check_rem_identity<T: Clone + Integer + Debug>(a: Ratio<T>, b: Ratio<T>) {
+        // a % b == a - (a/b).trunc() * b, the usual truncated-division rem.
+        let q = (a.clone() / b.clone()).trunc();
+        assert_eq!(a.clone() % b.clone(), a - q * b);
+    }
+
+    #[hegel::test]
+    fn hegel_rem_is_truncated_division_remainder(tc: hegel::TestCase) {
+        let a = tc.draw((gens::small_i64_ratios()).print_as_debug());
+        let b = tc.draw((gens::small_i64_ratios()).print_as_debug());
+        tc.assume(!b.is_zero());
+        check_rem_identity(a, b);
+        #[cfg(feature = "num-bigint")]
+        {
+            let a = tc.draw((gens::big_ratios()).print_as_debug());
+            let b = tc.draw((gens::big_ratios()).print_as_debug());
+            tc.assume(!b.is_zero());
+            check_rem_identity(a, b);
+        }
+    }
