+    fn check_multiplicative_inverse<T: Clone + Integer + Debug>(a: Ratio<T>) {
+        // recip() docs: panics only if zero; the caller filters zero out.
+        let inv = a.recip();
+        gens::assert_reduced(&inv);
+        assert!((a.clone() * inv.clone()).is_one(), "{:?} * {:?}", a, inv);
+        assert_eq!(inv.recip(), a);
+    }
+
