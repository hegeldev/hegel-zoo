+
+    /// Asserts the core structural invariant of `Ratio`: lowest terms
+    /// (numerator and denominator coprime) with a positive denominator.
+    /// See `reduce()`'s doc comment: "Puts self into lowest terms, with
+    /// `denom` > 0."
+    pub fn assert_reduced<T: Clone + Integer + Debug>(r: &Ratio<T>) {
+        assert!(
+            r.denom() > &T::zero(),
+            "denominator is not positive: {:?}",
+            r
+        );
+        assert!(
+            r.numer().gcd(r.denom()).is_one(),
+            "not in lowest terms: {:?}",
+            r
+        );
+    }
+
+    /// Any `i64` numerator (boosted toward the boundary values where overflow
+    /// bugs live) over any *positive* denominator, reduced by `Ratio::new`.
+    /// The denominator is kept positive because `Ratio::new` with a negative
+    /// denominator can panic on `i64::MIN` components (see the pinned
+    /// `hegel_pin_new_negation_overflow` test); sign coverage comes from the
+    /// numerator, and negative-denominator construction is tested separately.
+    #[hegel::composite]
+    pub fn i64_ratios(tc: &hegel::TestCase) -> Rational64 {
+        let numer = tc.draw(hegel::one_of!(
+            generators::integers::<i64>(),
+            generators::sampled_from(vec![i64::MIN, i64::MIN + 1, -1, 0, 1, i64::MAX]),
+        ));
+        let denom = tc.draw(hegel::one_of!(
+            generators::integers::<i64>().min_value(1),
+            generators::sampled_from(vec![1i64, 2, 3, i64::MAX - 1, i64::MAX]),
+        ));
+        Ratio::new(numer, denom)
+    }
+
+    /// A `Ratio<i64>` whose components are small enough that chains of two or
+    /// three `+ - * / %` operations cannot overflow `i64` internally. The
+    /// bound protects against the *inherent* fixed-width overflow of
+    /// `Ratio<i64>` (for which the `checked_*` API exists), not any contract
+    /// of the code under test; full-range coverage of the same code comes
+    /// from the `BigRational` variants and the checked-op oracle test.
+    #[hegel::composite]
+    pub fn small_i64_ratios(tc: &hegel::TestCase) -> Rational64 {
+        const B: i64 = 1 << 12;
+        let numer = tc.draw(generators::integers::<i64>().min_value(-B).max_value(B));
+        let denom = tc.draw(generators::integers::<i64>().min_value(1).max_value(B));
+        Ratio::new(numer, denom)
+    }
+
+    /// Arbitrary-precision integers: machine-integer range (covering the
+    /// `MIN`/`MAX`/`0` boundaries) plus decimal strings wider than any
+    /// machine type.
+    #[cfg(feature = "num-bigint")]
+    #[hegel::composite]
+    pub fn big_ints(tc: &hegel::TestCase) -> BigInt {
+        tc.draw((hegel::one_of!(
+            generators::integers::<i128>().map(BigInt::from),
+            generators::from_regex(r"-?[1-9][0-9]{0,59}")
+                .fullmatch(true)
+                .map(|s: String| BigInt::from_str(&s).unwrap()),
+        )).print_as_debug())
+    }
+
+    /// A fully-reduced `BigRational` from arbitrary-precision components.
+    /// A drawn zero denominator is mapped to one (`Ratio::new` documents a
+    /// panic for zero denominators, so zero is outside the domain).
+    #[cfg(feature = "num-bigint")]
+    #[hegel::composite]
+    pub fn big_ratios(tc: &hegel::TestCase) -> BigRational {
+        let numer = tc.draw((big_ints()).print_as_debug());
+        let denom = tc.draw((big_ints()).print_as_debug());
+        let denom = if denom.is_zero() { BigInt::one() } else { denom };
+        Ratio::new(numer, denom)
+    }
+}
