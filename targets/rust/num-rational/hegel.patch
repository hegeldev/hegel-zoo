+    fn hegel_multiplicative_inverse(tc: hegel::TestCase) {
+        let a = tc.draw((gens::small_i64_ratios()).print_as_debug());
+        tc.assume(!a.is_zero());
+        check_multiplicative_inverse(a);
+        #[cfg(feature = "num-bigint")]
+        {
+            let b = tc.draw((gens::big_ratios()).print_as_debug());
+            tc.assume(!b.is_zero());
+            check_multiplicative_inverse(b);
+        }
+    }
