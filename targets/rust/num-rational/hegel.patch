+#[cfg(feature = "std")]
+mod hegel_props {
+    use super::gens;
+    use super::{Ratio, Rational64};
+    #[cfg(feature = "num-bigint")]
+    use super::{BigInt, BigRational};
+    use core::cmp::Ordering;
+    use core::hash::{Hash, Hasher};
+    use core::str::FromStr;
+    use hegel::generators::{self, Generator};
+    use num_integer::Integer;
+    use num_traits::{FromPrimitive, Num, Signed, ToPrimitive};
+    use std::collections::hash_map::DefaultHasher;
+    use std::string::{String, ToString};
+
+    /// Whether `Ratio::<i64>::new(numer, denom)` hits the known
+    /// negation-overflow panic in `reduce()` (pinned by
+    /// `hegel_pin_new_negation_overflow`): with a negative denominator,
+    /// `reduce()` negates both components after dividing by the gcd, and
+    /// negating `i64::MIN` overflows. Computed in `i128` so this helper
+    /// cannot itself overflow.
+    fn new_would_panic(numer: i64, denom: i64) -> bool {
+        if numer == 0 || numer == denom || denom >= 0 {
+            // zero numerator and `numer == denom` take early returns in
+            // `reduce()`; positive denominators are never negated.
+            return false;
+        }
+        let n = numer as i128;
+        let d = denom as i128;
+        let g = n.gcd(&d);
+        let min = i64::MIN as i128;
+        n / g == min || d / g == min
+    }
+
+    /// Whether `Ord::cmp` panics for the operand `numer/denom` when compared
+    /// against another fraction (pinned by
+    /// `hegel_pin_cmp_div_mod_floor_overflow`): `cmp` calls
+    /// `div_mod_floor(numer, denom)`, which overflows for `i64::MIN / -1`,
+    /// either directly or one recursion level down via the reciprocal
+    /// `(denom, numer mod denom)`.
+    fn cmp_would_panic(numer: i64, denom: i64) -> bool {
+        let min = i64::MIN as i128;
+        let (n, d) = (numer as i128, denom as i128);
+        (n == min && d == -1) || (d == min && n.mod_floor(&d) == -1)
+    }
+
+    // ----- Structural invariant: `new` produces lowest terms, denom > 0 ----
+
+    #[hegel::test]
+    fn hegel_new_produces_reduced_form(tc: hegel::TestCase) {
+        let numer = tc.draw(hegel::one_of!(
+            generators::integers::<i64>(),
+            generators::sampled_from(vec![i64::MIN, i64::MIN + 1, -1, 0, 1, i64::MAX]),
+        ));
+        let denom = tc.draw(hegel::one_of!(
+            generators::integers::<i64>(),
+            generators::sampled_from(vec![i64::MIN, -1, 1, 2, i64::MAX]),
+        ));
+        tc.assume(denom != 0);
+        // KNOWN BUG exclusion: see `hegel_pin_new_negation_overflow`.
+        tc.assume(!new_would_panic(numer, denom));
+
+        let r = Ratio::new(numer, denom);
+        gens::assert_reduced(&r);
+        // The reduced fraction must still represent the same value:
+        // r.numer/r.denom == numer/denom <=> r.numer*denom == numer*r.denom.
+        assert_eq!(
+            *r.numer() as i128 * denom as i128,
+            numer as i128 * *r.denom() as i128
+        );
+    }
+
+    // KNOWN FAILURE: `Ratio::<i64>::new(1, i64::MIN)` (and any input whose
+    // reduced denominator or numerator is `i64::MIN` alongside a negative
+    // denominator) panics with an `attempt to negate with overflow` inside
+    // `reduce()` (src/lib.rs, "keep denom positive!" branch), instead of
+    // constructing the representable value 1/i64::MIN reduced or documenting
+    // the panic. The generator is boosted toward the failing region so the
+    // failure reproduces deterministically.
+    #[hegel::test(test_cases = 300)]
+    fn hegel_pin_new_negation_overflow(tc: hegel::TestCase) {
+        let numer = tc.draw(hegel::one_of!(
+            generators::just(1i64),
+            generators::integers::<i64>(),
+        ));
+        let denom = tc.draw(hegel::one_of!(
+            generators::just(i64::MIN),
+            generators::integers::<i64>().max_value(-1),
+        ));
+        let r = Ratio::new(numer, denom);
+        gens::assert_reduced(&r);
+    }
+
+    // ----- Comparison agrees with exact cross-multiplication ---------------
+
+    #[hegel::test]
+    fn hegel_cmp_matches_i128_cross_multiplication(tc: hegel::TestCase) {
+        let draw_raw = |tc: &hegel::TestCase| -> (i64, i64) {
+            let n = tc.draw(hegel::one_of!(
+                generators::integers::<i64>(),
+                generators::sampled_from(vec![i64::MIN, i64::MIN + 1, -1, 0, 1, i64::MAX]),
+            ));
+            let d = tc.draw(hegel::one_of!(
+                generators::integers::<i64>(),
+                generators::sampled_from(vec![i64::MIN, -2, -1, 1, 2, i64::MAX]),
+            ));
+            tc.assume(d != 0);
+            (n, d)
+        };
+        let (a, b) = draw_raw(&tc);
+        let (c, d) = draw_raw(&tc);
+        // KNOWN BUG exclusion: see `hegel_pin_cmp_div_mod_floor_overflow`.
+        tc.assume(!cmp_would_panic(a, b) && !cmp_would_panic(c, d));
+        // KNOWN BUG exclusion: equal nonzero numerators over denominators of
+        // opposite signs order incorrectly; see
+        // `hegel_pin_cmp_equal_numerator_mixed_sign_denominators`.
+        tc.assume(!(a == c && a != 0 && (b < 0) != (d < 0)));
+
+        let x = Ratio::new_raw(a, b);
+        let y = Ratio::new_raw(c, d);
+        // a/b <=> c/d compares like a*d <=> c*b, flipped when b*d < 0.
+        // i64 products always fit in i128, so the oracle is exact.
+        let mut expected = (a as i128 * d as i128).cmp(&(c as i128 * b as i128));
+        if (b < 0) != (d < 0) {
+            expected = expected.reverse();
+        }
+        assert_eq!(x.cmp(&y), expected, "cmp({:?}, {:?})", x, y);
+        // PartialOrd/PartialEq must agree with Ord (total order consistency).
+        assert_eq!(x.partial_cmp(&y), Some(expected));
+        assert_eq!(x == y, expected == Ordering::Equal);
+    }
+
+    // KNOWN FAILURE: `Ord::cmp`'s equal-numerator fast path (src/cmp.rs,
+    // "With equal numerators, the denominators can be inversely compared")
+    // is wrong when the two denominators have *different signs*: it only
+    // inverts the denominator comparison based on the numerator's sign, so
+    // `cmp(1/-1, 1/1)` returns `Greater` even though -1 < 1. `cmp`
+    // explicitly supports negative denominators (both other paths handle
+    // them correctly), so this breaks the total order for `new_raw`
+    // fractions. Found by `hegel_cmp_matches_i128_cross_multiplication`;
+    // the generator here forces equal numerators over mixed-sign
+    // denominators, where every nonzero case fails.
+    #[hegel::test(test_cases = 300)]
+    fn hegel_pin_cmp_equal_numerator_mixed_sign_denominators(tc: hegel::TestCase) {
+        let n = tc.draw(hegel::one_of!(
+            generators::integers::<i64>().min_value(1),
+            generators::integers::<i64>().max_value(-1),
+        ));
+        let b = tc.draw(generators::integers::<i64>().max_value(-1).min_value(i64::MIN + 1));
+        let d = tc.draw(generators::integers::<i64>().min_value(1));
+        let x = Ratio::new_raw(n, b);
+        let y = Ratio::new_raw(n, d);
+        // Exact oracle: a/b <=> c/d compares like a*d <=> c*b, flipped
+        // because exactly one of b, d is negative here.
+        let expected = (n as i128 * d as i128)
+            .cmp(&(n as i128 * b as i128))
+            .reverse();
+        assert_eq!(x.cmp(&y), expected, "cmp({:?}, {:?})", x, y);
+    }
+
+    // KNOWN FAILURE: `Ord::cmp` panics with `attempt to divide with overflow`
+    // for fractions like `i64::MIN/-1` (directly) or `-1/i64::MIN` (one
+    // recursion level down), because `cmp` (src/cmp.rs) computes
+    // `div_mod_floor(numer, denom)` and `i64::MIN / -1` overflows. These are
+    // valid `new_raw` fractions, and `cmp` explicitly supports negative
+    // denominators (it reverses the ordering for them). The generator is
+    // boosted toward the failing region so the failure reproduces
+    // deterministically.
+    #[hegel::test(test_cases = 300)]
+    fn hegel_pin_cmp_div_mod_floor_overflow(tc: hegel::TestCase) {
+        let x = Ratio::new_raw(
+            tc.draw(hegel::one_of!(
+                generators::just(i64::MIN),
+                generators::integers::<i64>(),
+            )),
+            tc.draw(hegel::one_of!(
+                generators::just(-1i64),
+                generators::integers::<i64>().max_value(-1),
+            )),
+        );
+        let (c, d) = (
+            tc.draw(generators::integers::<i64>()),
+            tc.draw(generators::integers::<i64>().min_value(1)),
+        );
+        let y = Ratio::new_raw(c, d);
+        let mut expected = (*x.numer() as i128 * d as i128).cmp(&(c as i128 * *x.denom() as i128));
+        if *x.denom() < 0 {
+            expected = expected.reverse();
+        }
+        assert_eq!(x.cmp(&y), expected, "cmp({:?}, {:?})", x, y);
+    }
+
+    // ----- Hash agrees with Eq for equivalent (non-reduced) fractions ------
+
+    #[hegel::test]
+    fn hegel_hash_agrees_with_eq_for_unreduced_fractions(tc: hegel::TestCase) {
+        fn hash_of<T: Hash>(v: &T) -> u64 {
+            let mut h = DefaultHasher::new();
+            v.hash(&mut h);
+            h.finish()
+        }
+        let r = tc.draw((gens::small_i64_ratios()).print_as_debug());
+        let k = tc.draw(
+            generators::integers::<i64>()
+                .min_value(-1024)
+                .max_value(1024),
+        );
+        tc.assume(k != 0);
+        // numer*k/denom*k is the same rational number, unreduced (and with a
+        // negative denominator when k < 0).
+        let equiv = Ratio::new_raw(r.numer() * k, r.denom() * k);
+        assert_eq!(r, equiv);
+        assert_eq!(hash_of(&r), hash_of(&equiv), "{:?} vs {:?}", r, equiv);
+    }
+
+    // ----- Display/FromStr round-trip ---------------------------------------
+
+    #[hegel::test]
+    fn hegel_display_from_str_roundtrip_i64(tc: hegel::TestCase) {
+        let r = tc.draw((gens::i64_ratios()).print_as_debug());
+        let s = r.to_string();
+        let back = Rational64::from_str(&s).unwrap();
+        assert_eq!(back, r, "{:?} -> {:?} -> {:?}", r, s, back);
+    }
+
+    #[cfg(feature = "num-bigint")]
+    #[hegel::test]
+    fn hegel_display_from_str_roundtrip_big(tc: hegel::TestCase) {
+        let r = tc.draw((gens::big_ratios()).print_as_debug());
+        let s = r.to_string();
+        let back = BigRational::from_str(&s).unwrap();
+        assert_eq!(back, r, "{:?} -> {:?} -> {:?}", r, s, back);
+    }
+
+    // ----- Parse robustness -------------------------------------------------
+
+    /// Strings shaped like `numer` or `numer/denom`, boosted toward i64
+    /// boundary values, where parser bugs live.
+    #[hegel::composite]
+    fn ratio_like_strings(tc: &hegel::TestCase) -> String {
+        let part = |tc: &hegel::TestCase| -> String {
+            tc.draw(hegel::one_of!(
+                generators::from_regex(r"-?[0-9]{1,25}").fullmatch(true),
+                generators::sampled_from(vec![
+                    String::from("-9223372036854775809"),
+                    String::from("-9223372036854775808"),
+                    String::from("-9223372036854775807"),
+                    String::from("9223372036854775807"),
+                    String::from("9223372036854775808"),
+                    String::from("-0"),
+                    String::from("0"),
+                ]),
+            ))
+        };
+        let n = part(&tc);
+        if tc.draw(generators::booleans()) {
+            let d = part(&tc);
+            format!("{}/{}", n, d)
+        } else {
+            n
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_from_str_never_panics(tc: hegel::TestCase) {
+        let s = tc.draw(hegel::one_of!(
+            generators::text().boxed(),
+            ratio_like_strings().boxed(),
+        ));
+        let radix = tc.draw(generators::integers::<u32>().min_value(2).max_value(36));
+
+        // KNOWN BUG exclusion (see `hegel_pin_new_negation_overflow`): both
+        // parsers call `Ratio::new`, so strings that parse to a fraction in
+        // the reduce()-negation-overflow region panic. Skip exactly those.
+        let parses_to_panic = |num: Result<i64, _>, den: Result<i64, _>| -> bool {
+            match (num, den) {
+                (Ok(n), Ok(d)) => new_would_panic(n, d),
+                _ => false,
+            }
+        };
+        let mut parts = s.splitn(2, '/');
+        let np = parts.next().unwrap_or("");
+        let dp = parts.next();
+        if let Some(dp) = dp {
+            tc.assume(!parses_to_panic(i64::from_str(np), i64::from_str(dp)));
+            tc.assume(!parses_to_panic(
+                i64::from_str_radix(np, radix),
+                i64::from_str_radix(dp, radix),
+            ));
+        }
+
+        // Must return Ok or Err, never panic, on arbitrary input.
+        let _ = Rational64::from_str(&s);
+        let _ = <Rational64 as Num>::from_str_radix(&s, radix);
+    }
+
+    // ----- Float conversions ------------------------------------------------
+
+    #[cfg(feature = "num-bigint")]
+    #[hegel::test]
+    fn hegel_from_float_to_f64_roundtrip(tc: hegel::TestCase) {
+        // `from_float` is exact for every finite float (it decodes mantissa
+        // and exponent), so converting back must reproduce the float.
+        let f = tc.draw(
+            generators::floats::<f64>()
+                .allow_nan(false)
+                .allow_infinity(false),
+        );
+        let r = BigRational::from_float(f).unwrap();
+        gens::assert_reduced(&r);
+        assert_eq!(r.to_f64().unwrap(), f, "{:?}", r);
+    }
+
+    /// Asserts `f` is a nearest float to `exact`: no neighbouring float is
+    /// strictly closer. (`ratio_to_f64` implements round-to-nearest, ties to
+    /// even; ties make both neighbours equally close, which this accepts.)
+    #[cfg(feature = "num-bigint")]
+    fn assert_correctly_rounded(exact: &BigRational, f: f64) {
+        let err = (exact - BigRational::from_float(f).unwrap()).abs();
+        for g in [f.next_up(), f.next_down()] {
+            if g.is_finite() {
+                let alt_err = (exact - BigRational::from_float(g).unwrap()).abs();
+                assert!(
+                    err <= alt_err,
+                    "to_f64 gave {}, but {} is strictly closer to {}",
+                    f,
+                    g,
+                    exact
+                );
+            }
+        }
+    }
+
+    #[cfg(feature = "num-bigint")]
+    #[hegel::test]
+    fn hegel_i64_to_f64_is_correctly_rounded(tc: hegel::TestCase) {
+        let r = tc.draw((gens::i64_ratios()).print_as_debug());
+        let f = r.to_f64().unwrap();
+        // |r| <= 2^63, so the result is always finite.
+        assert!(f.is_finite(), "{:?} -> {}", r, f);
+        let exact = BigRational::new(BigInt::from(*r.numer()), BigInt::from(*r.denom()));
+        assert_correctly_rounded(&exact, f);
+    }
+
+    #[cfg(feature = "num-bigint")]
+    #[hegel::test]
+    fn hegel_big_to_f64_is_correctly_rounded(tc: hegel::TestCase) {
+        let r = tc.draw((gens::big_ratios()).print_as_debug());
+        let f = r.to_f64().unwrap();
+        if f.is_infinite() {
+            // Correct rounding to infinity requires a magnitude beyond MAX.
+            assert!(r.abs() > BigRational::from_float(f64::MAX).unwrap());
+            assert_eq!(f > 0.0, r.is_positive());
+        } else {
+            assert_correctly_rounded(&r, f);
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_approximate_float_never_panics_and_stays_close(tc: hegel::TestCase) {
+        // `from_f64` for machine-int ratios runs a continued-fraction
+        // approximation; it must never panic for any float, and when it
+        // produces a value for a representable float it must be close.
+        let f = tc.draw(generators::floats::<f64>());
+        let r = Rational64::from_f64(f);
+        if let Some(r) = r {
+            gens::assert_reduced(&r);
+            let approx = *r.numer() as f64 / *r.denom() as f64;
+            // Loose sanity bound: continued fractions converge fast; a
+            // relative error this large means the algorithm went wrong.
+            let tol = 1e-6 * f.abs().max(1.0);
+            assert!(
+                (approx - f).abs() <= tol,
+                "from_f64({}) = {:?} (~{}), off by {}",
+                f,
+                r,
+                approx,
+                (approx - f).abs()
+            );
+        }
+    }
+}
