+    // ----- Rounding families -------------------------------------------------
+
+    fn check_trunc_fract_identity<T: Clone + Integer + Signed + Debug>(r: Ratio<T>) {
+        // Documented on `fract()`: "Satisfies self == self.trunc() + self.fract()".
+        assert_eq!(r.trunc() + r.fract(), r);
+        assert!(r.trunc().is_integer());
+        // |fract| < 1 and fract has the sign of r (or is zero).
+        let f = r.fract();
+        assert!(f.abs() < Ratio::one(), "fract {:?} of {:?}", f, r);
+        assert!(f.is_zero() || (f.is_positive() == r.is_positive()));
+    }
+
+    #[hegel::test]
+    fn hegel_trunc_fract_identity(tc: hegel::TestCase) {
+        check_trunc_fract_identity(tc.draw((gens::small_i64_ratios()).print_as_debug()));
+        #[cfg(feature = "num-bigint")]
+        check_trunc_fract_identity(tc.draw((gens::big_ratios()).print_as_debug()));
+    }
+
+    fn check_floor_ceil_round<T: Clone + Integer + Signed + Debug>(r: Ratio<T>) {
+        let floor = r.floor();
+        let ceil = r.ceil();
+        let round = r.round();
+        assert!(floor.is_integer() && ceil.is_integer() && round.is_integer());
+        // floor <= r <= ceil, each within distance 1.
+        assert!(floor <= r && r <= ceil, "{:?} vs {:?}..{:?}", r, floor, ceil);
+        assert!(r.clone() - floor.clone() < Ratio::one());
+        assert!(ceil.clone() - r.clone() < Ratio::one());
+        // floor/ceil duality.
+        assert_eq!(-r.clone().floor(), (-r.clone()).ceil());
+        // round is a nearest integer: |r - round| <= 1/2 ...
+        let two = T::one() + T::one();
+        let half = Ratio::new(T::one(), two);
+        let dist = (r.clone() - round.clone()).abs();
+        assert!(dist <= half, "round({:?}) = {:?}", r, round);
+        // ... and half-way cases go away from zero (documented on `round()`).
+        if dist == half {
+            assert_eq!(round.abs(), r.trunc().abs() + Ratio::one());
+        }
+    }
+
+    #[hegel::test]
+    fn hegel_floor_ceil_round_bounds(tc: hegel::TestCase) {
+        check_floor_ceil_round(tc.draw((gens::small_i64_ratios()).print_as_debug()));
+        #[cfg(feature = "num-bigint")]
+        check_floor_ceil_round(tc.draw((gens::big_ratios()).print_as_debug()));
+    }
+
+    // ----- pow matches repeated multiplication -------------------------------
+
+    // `p` is `r.pow(e)`, computed at the call site with concrete types: the
+    // generic `for<'a> &'a T: Pow<u32>` bound sends rustc's trait solver
+    // into an E0275 recursion through Ratio's own blanket Pow impls.
+    fn check_pow<T>(r: Ratio<T>, e: i32, p: Ratio<T>)
+    where
+        T: Clone + Integer + Debug,
+    {
+        let mut expected: Ratio<T> = One::one();
+        for _ in 0..e.unsigned_abs() {
+            expected = expected * r.clone();
+        }
+        if e < 0 {
+            expected = expected.recip();
+        }
+        assert_eq!(p, expected, "{:?}.pow({})", r, e);
+        gens::assert_reduced(&p);
+    }
+
+    #[hegel::test]
+    fn hegel_pow_matches_repeated_multiplication(tc: hegel::TestCase) {
+        {
+            let r: crate::Rational64 = tc.draw((gens::small_i64_ratios()).print_as_debug());
+            let e = tc.draw(generators::integers::<i32>().min_value(-4).max_value(4));
+            tc.assume(!(r.is_zero() && e < 0));
+            let p = (&r).pow(e);
+            check_pow(r, e, p);
+        }
+        #[cfg(feature = "num-bigint")]
+        {
+            let r: crate::BigRational = tc.draw((gens::big_ratios()).print_as_debug());
+            let e = tc.draw(generators::integers::<i32>().min_value(-8).max_value(8));
+            tc.assume(!(r.is_zero() && e < 0));
+            let p = (&r).pow(e);
+            check_pow(r, e, p);
+        }
+    }
+
+    // ----- checked ops agree with exact BigInt arithmetic --------------------
+
+    #[cfg(feature = "num-bigint")]
+    #[hegel::test]
+    fn hegel_checked_ops_agree_with_bigint_oracle(tc: hegel::TestCase) {
+        // Full-range i64 fractions: the checked_* API is the documented
+        // overflow-safe interface, so it must never panic, and when it
+        // returns Some the value must be exactly right.
+        let a = tc.draw((gens::i64_ratios()).print_as_debug());
+        let b = tc.draw((gens::i64_ratios()).print_as_debug());
+        let op = tc.draw(generators::sampled_from(vec!["add", "sub", "mul", "div"]));
+        let result = match op {
+            "add" => a.checked_add(&b),
+            "sub" => a.checked_sub(&b),
+            "mul" => a.checked_mul(&b),
+            "div" => a.checked_div(&b),
+            _ => unreachable!(),
+        };
+        if op == "div" && b.is_zero() {
+            assert_eq!(result, None);
+            return;
+        }
+        if let Some(c) = result {
+            gens::assert_reduced(&c);
+            let (ba, bb) = (to_big(a), to_big(b));
+            let expected = match op {
+                "add" => ba + bb,
+                "sub" => ba - bb,
+                "mul" => ba * bb,
+                "div" => ba / bb,
+                _ => unreachable!(),
+            };
+            assert_eq!(
+                to_big(c),
+                expected,
+                "{:?} checked_{} {:?} = {:?}",
+                a,
+                op,
+                b,
+                c
+            );
+        }
+    }
