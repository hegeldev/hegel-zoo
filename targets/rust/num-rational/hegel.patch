+
+#[cfg(feature = "std")]
+pub(crate) mod gens {
+    use super::{Ratio, Rational64};
+    #[cfg(feature = "num-bigint")]
+    use super::{BigInt, BigRational};
+    use core::fmt::Debug;
+    #[cfg(feature = "num-bigint")]
