+#[hegel::test]
+fn doc_examples(_tc: TestCase) {
+    // crate docs / README
+    let mut conf = Ini::new();
+    conf.with_section(None::<String>).set("encoding", "utf-8");
+    conf.with_section(Some("User"))
+        .set("given_name", "Tommy")
+        .set("family_name", "Green")
+        .set("unicode", "Raspberry树莓");
+    conf.with_section(Some("Book")).set("name", "Rust cool");
+    let dir = std::env::temp_dir().join(format!("hegel-rust-ini-doc-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join("conf.ini");
+    conf.write_to_file(&path).unwrap();
+    let back = Ini::load_from_file(&path).unwrap();
+    let _ = std::fs::remove_dir_all(&dir);
+    let section = back.section(Some("User")).unwrap();
+    assert_eq!(section.get("given_name"), Some("Tommy"));
+    assert_eq!(section.get("family_name"), Some("Green"));
+    assert_eq!(section.get("unicode"), Some("Raspberry树莓"));
+    assert_eq!(back.get_from(None::<String>, "encoding"), Some("utf-8"));
+    assert_eq!(back.sections().collect::<Vec<_>>(), vec![None, Some("User"), Some("Book")]);
+    let mut out = Vec::new();
+    conf.write_to(&mut out).unwrap();
+    assert_eq!(
+        String::from_utf8(out).unwrap(),
+        "encoding=utf-8\n\n[User]\ngiven_name=Tommy\nfamily_name=Green\nunicode=Raspberry树莓\n\n[Book]\nname=Rust cool\n"
+    );
+    let mut out = Vec::new();
+    conf.write_to_policy(&mut out, EscapePolicy::BasicsUnicode).unwrap();
+    assert!(String::from_utf8(out).unwrap().contains("unicode=Raspberry\\x6811\\x8393\n"));
+
+    // get_from / get_from_or
+    let ini = Ini::load_from_str("[sec]\nabc = def\n").unwrap();
+    assert_eq!(ini.get_from(Some("sec"), "abc"), Some("def"));
+    let ini = Ini::load_from_str("[sec]\n").unwrap();
+    assert_eq!(ini.get_from_or(Some("sec"), "key", "default"), "default");
+
+    // ParseOption docs
+    let ini = Ini::load_from_str("[Section]\nKey1=\"Quoted value\"\nKey2='Single Quote' with extra value\n").unwrap();
+    assert_eq!(ini.get_from(Some("Section"), "Key1"), Some("Quoted value"));
+    assert_eq!(ini.get_from(Some("Section"), "Key2"), Some("Single Quote with extra value"));
+    let ini = Ini::load_from_str("[Section]\nKey1=C:\\Windows\n").unwrap();
+    assert_eq!(ini.get_from(Some("Section"), "Key1"), Some("C:Windows"));
+    let ini = Ini::load_from_str_noescape("[Section]\nKey1=C:\\Windows\n").unwrap();
+    assert_eq!(ini.get_from(Some("Section"), "Key1"), Some("C:\\Windows"));
+    let ini = Ini::load_from_str_opt(
+        "[Section]\nfoo=\n  b\n  c\n",
+        ParseOption { enabled_indented_multiline_value: true, ..Default::default() },
+    )
+    .unwrap();
+    assert_eq!(ini.get_from(Some("Section"), "foo"), Some("b\nc"));
+    let ini = Ini::load_from_str_opt(
+        "[services my-services]\ndynamodb=\n  endpoint_url=http://localhost:8000\n",
+        ParseOption { enabled_preserve_key_leading_whitespace: true, ..Default::default() },
+    )
+    .unwrap();
+    assert_eq!(ini.get_from(Some("services my-services"), "  endpoint_url"), Some("http://localhost:8000"));
+    assert_eq!(ini.get_from(Some("services my-services"), "dynamodb"), Some(""));
+
+    // Ini::default has a general section; Index panics on a missing one
+    let ini = Ini::default();
+    assert!(ini.general_section().is_empty());
+    assert_eq!(ini.len(), 1);
+    assert!(std::panic::catch_unwind(|| Ini::new()["nope"].len()).is_err());
+    let mut ini = Ini::new();
+    ini.with_section(Some("s")).set("k", "v");
+    assert_eq!(&ini["s"]["k"], "v");
+    assert_eq!(ini[Some("s")].get("k"), Some("v"));
+
+    // LineSeparator
+    assert_eq!(LineSeparator::CR.as_str(), "\n");
+    assert_eq!(LineSeparator::CRLF.as_str(), "\r\n");
+    assert_eq!(LineSeparator::SystemDefault.to_string(), "\n");
+}
