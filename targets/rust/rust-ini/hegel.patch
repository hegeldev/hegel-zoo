+// ---------------------------------------------------------------------------------------------
+// The maps against a model
+
+/// An operation on a `Properties`: the read first, `append` twice as often as `insert`.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum PropertiesOp {
+    Get(&'static str),
+    Insert(&'static str, &'static str),
+    Append(&'static str, &'static str),
+    RemoveAll(&'static str),
+}
+
+fn properties_op() -> impl PrintableGenerator<PropertiesOp> {
+    let key = || generators::sampled_from(KEYS);
+    let pair = || hegel::tuples!(key(), generators::sampled_from(VALUES));
+    hegel::one_of!(
+        key().map(PropertiesOp::Get),
+        pair().map(|(k, v)| PropertiesOp::Insert(k, v)),
+        pair().map(|(k, v)| PropertiesOp::Append(k, v)),
+        pair().map(|(k, v)| PropertiesOp::Append(k, v)),
+        key().map(PropertiesOp::RemoveAll),
+    )
+}
+
+#[hegel::test]
+fn properties_follow_a_model(tc: TestCase) {
+    let ops = tc.draw(generators::vecs(properties_op()).max_size(12));
+    let mut props = Properties::new();
+    let mut model: Vec<(String, String)> = Vec::new();
+    for op in ops {
+        match op {
+            PropertiesOp::Insert(k, v) => {
+                let (k, v) = (k.to_string(), v.to_string());
+                props.insert(k.clone(), v.clone());
+                // replace: the key keeps its place, all its values become this one
+                match model.iter().position(|(kk, _)| *kk == k) {
+                    Some(i) => {
+                        model.retain(|(kk, _)| *kk != k);
+                        let i = i.min(model.len());
+                        model.insert(i, (k, v));
+                    }
+                    None => model.push((k, v)),
+                }
+            }
+            PropertiesOp::Append(k, v) => {
+                props.append(k, v);
+                model.push((k.to_string(), v.to_string()));
+            }
+            PropertiesOp::RemoveAll(k) => {
+                let removed: Vec<String> = props.remove_all(k).collect();
+                let expected: Vec<String> = model.iter().filter(|(kk, _)| kk == k).map(|(_, v)| v.clone()).collect();
+                assert_eq!(removed, expected);
+                model.retain(|(kk, _)| kk != k);
+            }
+            PropertiesOp::Get(k) => {
+                let all: Vec<&str> = props.get_all(k).collect();
+                let expected: Vec<&str> = model.iter().filter(|(kk, _)| kk == k).map(|(_, v)| v.as_str()).collect();
+                assert_eq!(all, expected);
+                assert_eq!(props.get(k), expected.first().copied());
+                assert_eq!(props.contains_key(k), !expected.is_empty());
+            }
+        }
+        let mut keys: Vec<&str> = model.iter().map(|(k, _)| k.as_str()).collect();
+        keys.dedup();
+        keys.sort();
+        keys.dedup();
+        assert_eq!(props.len(), keys.len());
+        assert_eq!(props.is_empty(), model.is_empty());
+        let mut pairs: Vec<(String, String)> = props.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect();
+        pairs.sort();
+        let mut expected = model.clone();
+        expected.sort();
+        assert_eq!(pairs, expected);
+        for (k, _) in &model {
+            let all: Vec<&str> = props.get_all(k).collect();
+            let expected: Vec<&str> = model.iter().filter(|(kk, _)| kk == k).map(|(_, v)| v.as_str()).collect();
+            assert_eq!(all, expected);
+        }
+    }
+    let collected: Vec<(String, String)> = props.clone().into_iter().collect();
+    let borrowed: Vec<(String, String)> = (&props).into_iter().map(|(k, v)| (k.to_string(), v.to_string())).collect();
+    assert_eq!(collected, borrowed);
+    assert_eq!(collected.len(), model.len());
+}
+
+/// The three removals documented as taking the first entry.
+#[derive(Clone, Copy, Debug, hegel::PrettyPrintable)]
+enum Removal {
+    PropertiesRemove,
+    SectionDelete,
+    IniDelete,
+}
+
+const REMOVALS: &[Removal] = &[Removal::PropertiesRemove, Removal::SectionDelete, Removal::IniDelete];
+
+/// Pinned: rust-ini/8 — `Properties::remove`, `SectionSetter::delete` and `Ini::delete` are
+/// documented as removing the first value / entry / section with the name; they remove all of
+/// them (returning the first).
+#[hegel::test]
+fn remove_and_delete_take_only_the_first_entry(tc: TestCase) {
+    let (removal, key, values) = tc.draw(hegel::tuples!(
+        generators::sampled_from(REMOVALS),
+        generators::sampled_from(KEYS),
+        generators::vecs(generators::sampled_from(VALUES)).min_size(2).max_size(4)
+    ));
+    match removal {
+        Removal::PropertiesRemove => {
+            let mut props = Properties::new();
+            for v in &values {
+                props.append(key, *v);
+            }
+            assert_eq!(props.remove(key), Some(values[0].to_string()));
+            assert_eq!(props.get_all(key).collect::<Vec<_>>(), values[1..].to_vec());
+        }
+        Removal::SectionDelete => {
+            let mut ini = Ini::new();
+            for v in &values {
+                ini.with_section(Some("s")).add(key, *v);
+            }
+            ini.with_section(Some("s")).delete(&key);
+            assert_eq!(ini.section(Some("s")).unwrap().get_all(key).collect::<Vec<_>>(), values[1..].to_vec());
+        }
+        Removal::IniDelete => {
+            let mut ini = Ini::new();
+            for v in &values {
+                let mut props = Properties::new();
+                props.insert(key, *v);
+                match ini.entry(Some("s".to_string())) {
+                    ini::SectionEntry::Vacant(e) => {
+                        e.insert(props);
+                    }
+                    ini::SectionEntry::Occupied(mut e) => e.append(props),
+                }
+            }
+            let first = ini.delete(Some("s")).expect("a section");
+            assert_eq!(first.get(key), Some(values[0]));
+            assert_eq!(ini.section_all(Some("s")).count(), values.len() - 1);
+        }
+    }
+}
+
+type Model = Vec<(Option<String>, Vec<(String, String)>)>;
+
+fn model_section<'a>(model: &'a mut Model, name: &Option<String>) -> &'a mut Vec<(String, String)> {
+    if !model.iter().any(|(s, _)| s == name) {
+        model.push((name.clone(), Vec::new()));
+    }
+    &mut model.iter_mut().find(|(s, _)| s == name).unwrap().1
+}
+
+/// The model of a replace: the key keeps its place, all its values become this one.
+fn replace(props: &mut Vec<(String, String)>, key: String, value: String) {
+    match props.iter().position(|(k, _)| *k == key) {
+        Some(i) => {
+            props.retain(|(k, _)| *k != key);
+            let i = i.min(props.len());
+            props.insert(i, (key, value));
+        }
+        None => props.push((key, value)),
+    }
+}
+
+/// The `Ini` API under test, the reads first.
+#[derive(Clone, Copy, Debug, hegel::PrettyPrintable)]
+enum IniCall {
+    /// `get_from`, `get_from_or`, `SectionSetter::get`, `section`, `general_section`
+    Get,
+    /// `SectionSetter::set`
+    Set,
+    SetTo,
+    /// `SectionSetter::add`
+    Add,
+    /// `section_mut` and `Properties::insert`
+    Insert,
+    DeleteFrom,
+    Delete,
+    /// `get_from_mut`, upper-casing the value
+    Uppercase,
+}
+
+const INI_CALLS: &[IniCall] = &[
+    IniCall::Get,
+    IniCall::Set,
+    IniCall::SetTo,
+    IniCall::Add,
+    IniCall::Insert,
+    IniCall::DeleteFrom,
+    IniCall::Delete,
+    IniCall::Uppercase,
+];
+
+/// A call on a section (the general one a quarter of the time), a key and a value.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct IniOp {
+    call: IniCall,
+    section: Option<&'static str>,
+    key: &'static str,
+    value: &'static str,
+}
+
+fn ini_op() -> impl PrintableGenerator<IniOp> {
+    let named = || generators::sampled_from(SECTIONS).map(Some);
+    hegel::tuples!(
+        generators::sampled_from(INI_CALLS),
+        hegel::one_of!(generators::just(None::<&'static str>), named(), named(), named()),
+        generators::sampled_from(KEYS),
+        generators::sampled_from(VALUES)
+    )
+    .map(|(call, section, key, value)| IniOp {
+        call,
+        section,
+        key,
+        value,
+    })
+}
+
+#[hegel::test]
+fn ini_api_follows_a_model(tc: TestCase) {
+    let ops = tc.draw(generators::vecs(ini_op()).max_size(14));
+    let mut ini = Ini::new();
+    let mut model: Model = vec![(None, Vec::new())];
+    for op in ops {
+        let name: Option<String> = op.section.map(String::from);
+        let (key, value) = (op.key.to_string(), op.value.to_string());
+        match op.call {
+            IniCall::Set => {
+                ini.with_section(name.clone()).set(key.clone(), value.clone());
+                replace(model_section(&mut model, &name), key, value);
+            }
+            IniCall::SetTo => {
+                ini.set_to(name.clone(), key.clone(), value.clone());
+                replace(model_section(&mut model, &name), key, value);
+            }
+            IniCall::Add => {
+                ini.with_section(name.clone()).add(key.clone(), value.clone());
+                model_section(&mut model, &name).push((key, value));
+            }
+            IniCall::DeleteFrom => {
+                let expected = model
+                    .iter()
+                    .find(|(s, _)| *s == name)
+                    .and_then(|(_, p)| p.iter().find(|(k, _)| *k == key))
+                    .map(|(_, v)| v.clone());
+                let got = ini.delete_from(name.clone(), &key);
+                assert_eq!(got, expected);
+                if let Some((_, props)) = model.iter_mut().find(|(s, _)| *s == name) {
+                    props.retain(|(k, _)| *k != key);
+                }
+            }
+            IniCall::Delete => {
+                let expected = model.iter().find(|(s, _)| *s == name).map(|(_, p)| {
+                    let mut p = p.clone();
+                    p.sort();
+                    p
+                });
+                let got = ini.delete(name.clone()).map(|p| {
+                    let mut p: Vec<(String, String)> = p.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect();
+                    p.sort();
+                    p
+                });
+                // compared as multisets: a replace does not keep the key's place among values
+                assert_eq!(got, expected);
+                model.retain(|(s, _)| *s != name);
+            }
+            IniCall::Get => {
+                let expected = model
+                    .iter()
+                    .find(|(s, _)| *s == name)
+                    .and_then(|(_, p)| p.iter().find(|(k, _)| *k == key))
+                    .map(|(_, v)| v.as_str());
+                assert_eq!(ini.get_from(name.clone(), &key), expected);
+                assert_eq!(ini.get_from_or(name.clone(), &key, "dflt"), expected.unwrap_or("dflt"));
+                assert_eq!(ini.with_section(name.clone()).get(&key), expected);
+                assert_eq!(ini.section(name.clone()).is_some(), model.iter().any(|(s, _)| *s == name));
+                if name.is_none() && model.iter().any(|(s, _)| s.is_none()) {
+                    assert_eq!(ini.general_section().get(&key), expected);
+                }
+            }
+            IniCall::Uppercase => {
+                if let Some(v) = ini.get_from_mut(name.clone(), &key) {
+                    v.make_ascii_uppercase();
+                    let props = model_section(&mut model, &name);
+                    let (_, mv) = props.iter_mut().find(|(k, _)| *k == key).unwrap();
+                    mv.make_ascii_uppercase();
+                }
+            }
+            IniCall::Insert => {
+                if let Some(props) = ini.section_mut(name.clone()) {
+                    props.insert(key.clone(), value.clone());
+                    replace(model_section(&mut model, &name), key, value);
+                }
+            }
+        }
+        let names: Vec<Option<String>> = ini.sections().map(|s| s.map(String::from)).collect();
+        let expected: Vec<Option<String>> = model.iter().map(|(s, _)| s.clone()).collect();
+        assert_eq!(names, expected);
+        assert_eq!(ini.len(), model.len());
+        assert_eq!(ini.is_empty(), model.is_empty());
+        // sections and their contents, compared as multisets of pairs (a replace keeps the
+        // key's place among keys but not necessarily among values)
+        let got = shape(&ini);
+        for ((gs, gp), (ms, mp)) in got.iter().zip(model.iter()) {
+            assert_eq!(gs, ms);
+            let mut gp = gp.clone();
+            let mut mp = mp.clone();
+            gp.sort();
+            mp.sort();
+            assert_eq!(gp, mp, "section {gs:?}");
+        }
+        for (s, mp) in &model {
+            let props = ini.section(s.clone()).unwrap();
+            let mut keys: Vec<&str> = mp.iter().map(|(k, _)| k.as_str()).collect();
+            keys.sort();
+            keys.dedup();
+            assert_eq!(props.len(), keys.len());
+            for k in keys {
+                let all: Vec<&str> = props.get_all(k).collect();
+                let expected: Vec<&str> = mp.iter().filter(|(kk, _)| kk == k).map(|(_, v)| v.as_str()).collect();
+                assert_eq!(all, expected, "section {s:?} key {k:?}");
+            }
+        }
+    }
+    ini.clear();
+    assert!(ini.is_empty());
+    assert_eq!(ini.len(), 0);
+}
