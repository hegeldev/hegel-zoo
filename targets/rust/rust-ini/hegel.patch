+// ---------------------------------------------------------------------------------------------
+// The reader against its documentation
+
+const JUNK: &[&str] = &["junk", "no delimiter here", "x", "树"];
+
+/// Pinned: rust-ini/5 — a line without a delimiter (or text after a header's `]`) is not an
+/// error: it is glued, line feed included, to the next line's key.
+#[hegel::test]
+fn lines_without_a_delimiter_do_not_swallow_the_next_line(tc: TestCase) {
+    let (junk, sec, key, after_header) = tc.draw(hegel::tuples!(
+        generators::sampled_from(JUNK),
+        generators::sampled_from(SECTIONS),
+        generators::sampled_from(KEYS),
+        generators::booleans()
+    ));
+    let text = if after_header {
+        format!("[{sec}] {junk}\n{key}=v\n")
+    } else {
+        format!("[{sec}]\n{junk}\n{key}=v\n")
+    };
+    match Ini::load_from_str(&text) {
+        Err(_) => {}
+        Ok(ini) => {
+            assert_eq!(ini.get_from(Some(sec), key), Some("v"), "{text:?} -> {:?}", shape(&ini));
+            assert!(
+                shape(&ini).iter().all(|(_, p)| p.iter().all(|(k, _)| !k.contains('\n'))),
+                "{text:?} -> {:?}",
+                shape(&ini)
+            );
+        }
+    }
+}
