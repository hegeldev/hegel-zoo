+/// Pinned: rust-ini/6 — with `enabled_escape: false` a backslash at the end of a line still
+/// joins the next line onto the value (and a backslash before a delimiter in a key still hides
+/// the delimiter).
+#[hegel::test]
+fn escape_disabled_leaves_backslashes_alone(tc: TestCase) {
+    let chars = with(&only(PLAIN, |c| !QUOTES.contains(&c)), &['\\']);
+    let (stem, key, second) = tc.draw(hegel::tuples!(
+        text_from(&chars).max_size(6),
+        generators::sampled_from(KEYS),
+        generators::sampled_from(VALUES)
+    ));
+    let value = format!("{}\\", stem.trim());
+    let text = format!("[s]\n{key}={value}\nj={second}\n");
+    let ini = Ini::load_from_str_opt(&text, common_options(false))
+        .unwrap_or_else(|e| panic!("{}", format!("{text:?}: {e}")));
+    assert_eq!(ini.get_from(Some("s"), key), Some(value.as_str()), "{text:?}");
+    assert_eq!(ini.get_from(Some("s"), "j"), Some(second.trim()), "{text:?}");
+}
+
+#[hegel::test]
+fn quotes_and_escapes_follow_the_docs(tc: TestCase) {
+    let chars = only(PLAIN, |c| !QUOTES.contains(&c) && c != '\\');
+    // the characters with no escape of their own: `\W` is `W`
+    let letters = only(&chars, |c| !matches!(c, '0' | 'a' | 'b' | 't' | 'r' | 'n' | 'x' | 'f' | 'v'));
+    let (inner, tail, quote, c, code) = tc.draw(hegel::tuples!(
+        text_from(&chars).max_size(6),
+        text_from(&chars).max_size(4),
+        generators::sampled_from(QUOTES),
+        generators::sampled_from(letters),
+        generators::integers::<u32>().min_value(0x20).max_value(0xffff)
+    ));
+    let tail = tail.trim_end();
+    // `Key2='Single Quote' with extra value` is `Single Quote with extra value`
+    let text = format!("[s]\nk={quote}{inner}{quote}{tail}\n");
+    let ini = Ini::load_from_str(&text).unwrap();
+    assert_eq!(ini.get_from(Some("s"), "k"), Some(format!("{inner}{tail}").as_str()), "{text:?}");
+    // with quoting disabled the quotes are part of the (trimmed) value
+    let ini = Ini::load_from_str_opt(&text, ParseOption { enabled_quote: false, ..Default::default() }).unwrap();
+    assert_eq!(ini.get_from(Some("s"), "k"), Some(format!("{quote}{inner}{quote}{tail}").as_str()), "{text:?}");
+
+    // escapes: `\W` is `W`, the named escapes, `\xHHHH`
+    let ch = match char::from_u32(code) {
+        Some(ch) if !ch.is_whitespace() && !ch.is_control() && ch != '\\' => ch,
+        _ => 'A',
+    };
+    let text = format!("[s]\nk=a\\{c}b\\tc\\nd\\x{:04x}e\\\\f\n", ch as u32);
+    let ini = Ini::load_from_str(&text).unwrap_or_else(|e| panic!("{}", format!("{text:?}: {e}")));
+    assert_eq!(ini.get_from(Some("s"), "k"), Some(format!("a{c}b\tc\nd{ch}e\\f").as_str()), "{text:?}");
+    let ini = Ini::load_from_str_noescape(&text).unwrap();
+    assert_eq!(
+        ini.get_from(Some("s"), "k"),
+        Some(format!("a\\{c}b\\tc\\nd\\x{:04x}e\\\\f", ch as u32).as_str()),
+        "{text:?}"
+    );
+}
+
+/// The characters the policy docs name.
+const SPECIAL: &[char] = &['\\', ';', '#', '=', ':', '"', '\'', '[', ']', ' '];
+
+/// A character from each class of the policy docs: ASCII, the named specials, the two halves of
+/// the Basic Multilingual Plane, and above it.
+fn probe_char() -> impl PrintableGenerator<char> {
+    let range = |lo: u32, hi: u32| {
+        generators::integers::<u32>()
+            .min_value(lo)
+            .max_value(hi)
+            .map(|c| char::from_u32(c).unwrap())
+    };
+    hegel::one_of!(
+        range(0, 0x7f),
+        generators::sampled_from(SPECIAL),
+        range(0x80, 0xd7ff),
+        range(0xe000, 0xffff),
+        range(0x10000, 0x10ffff),
+    )
+}
+
+#[hegel::test]
+fn should_escape_follows_the_policy_docs(tc: TestCase) {
+    let (policy, c) = tc.draw(hegel::tuples!(
+        generators::sampled_from(POLICIES).print_as_debug(),
+        probe_char()
+    ));
+    let basics = c == '\\' || c.is_ascii_control();
+    let reserved = matches!(c, ';' | '#' | '=' | ':');
+    let bmp = ('\u{80}'..='\u{ffff}').contains(&c);
+    let astral = c > '\u{ffff}';
+    let expected = match policy {
+        EscapePolicy::Nothing => false,
+        EscapePolicy::Basics => basics,
+        EscapePolicy::BasicsUnicode => basics || bmp,
+        EscapePolicy::BasicsUnicodeExtended => basics || bmp || astral,
+        EscapePolicy::Reserved => basics || reserved,
+        EscapePolicy::ReservedUnicode => basics || reserved || bmp,
+        EscapePolicy::ReservedUnicodeExtended | EscapePolicy::Everything => basics || reserved || bmp || astral,
+    };
+    assert_eq!(policy.should_escape(c), expected, "{policy:?} {c:?}");
+}
