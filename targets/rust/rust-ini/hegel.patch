+//! Hegel properties for rust-ini (the `ini` crate), written in the zoo.
+//!
+//! Oracles: Python's own `configparser` (one child process, configured to the intersection of
+//! the two grammars: no interpolation, `strict=False`, `;`/`#` line comments only, no inline
+//! comments, values may not be missing, option names kept as written), the crate's own writer
+//! against its own reader (a written configuration must read back), the crate's rustdoc as the
+//! model for `EscapePolicy::should_escape`, `Properties` and `Ini`, and the documented
+//! examples.
+//!
+//! The generators are values. The text of the Python differential is a list of drawn lines
+//! (`Source`) that a pure renderer fits to the common grammar; a written configuration is a
+//! record (`Written`) of names and values drawn from the alphabets its policy leaves readable;
+//! the model tests draw their operations as a list of data and apply them in turn. The plainest
+//! alternative comes first in every choice, so a shrunk case is short and unadorned.
+//!
+//! Known bugs are pinned as expected failures in `target.toml`.
+
+use std::{
+    io::{BufRead, BufReader, Write},
+    process::{Child, ChildStdin, Command, Stdio},
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Mutex, OnceLock,
+    },
+};
+
+use hegel::{
+    generators::{self, BoxedPrintableGenerator, Generator},
+    PrintableGenerator, TestCase,
+};
+use ini::{EscapePolicy, Ini, LineSeparator, ParseOption, Properties, WriteOption};
+
+// ---------------------------------------------------------------------------------------------
+// Shapes
+
+/// Every section of an `Ini` in order, duplicates kept, with its properties in order.
+type Shape = Vec<(Option<String>, Vec<(String, String)>)>;
+
+fn shape(ini: &Ini) -> Shape {
+    ini.iter()
+        .map(|(s, p)| {
+            (
+                s.map(String::from),
+                p.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect(),
+            )
+        })
+        .collect()
+}
+
+/// Python's view: named sections in order of first appearance, keys in order of first
+/// appearance, the last value written wins (`strict=False`).
+type Doc = Vec<(String, Vec<(String, String)>)>;
+
+fn merge_into(doc: &mut Doc, sec: &str, k: &str, v: &str) {
+    let s = match doc.iter().position(|(s, _)| s == sec) {
+        Some(i) => i,
+        None => {
+            doc.push((sec.to_string(), Vec::new()));
+            doc.len() - 1
+        }
+    };
+    match doc[s].1.iter_mut().find(|(kk, _)| kk == k) {
+        Some(e) => e.1 = v.to_string(),
+        None => doc[s].1.push((k.to_string(), v.to_string())),
+    }
+}
+
+fn merged(ini: &Ini) -> Doc {
+    let mut doc = Doc::new();
+    for (s, p) in ini.iter() {
+        let Some(s) = s else { continue };
+        if !doc.iter().any(|(name, _)| name == s) {
+            doc.push((s.to_string(), Vec::new()));
+        }
+        for (k, v) in p.iter() {
+            merge_into(&mut doc, s, k, v);
+        }
+    }
+    doc
+}
+
+// ---------------------------------------------------------------------------------------------
+// Python's configparser, held open as a child
+
+const PY: &str = r#"
+import sys, configparser
+def run(t):
+    p = configparser.ConfigParser(interpolation=None, strict=False, comment_prefixes=(';', '#'),
+                                  inline_comment_prefixes=None, empty_lines_in_values=True,
+                                  allow_no_value=False, default_section='\0')
+    p.optionxform = str
+    p.read_string(t)
+    out = []
+    for s, d in p._sections.items():
+        out.append('s:' + s.encode().hex())
+        for k, v in d.items():
+            out.append('k:' + k.encode().hex() + '=' + v.encode().hex())
+    return 'ok ' + ' '.join(out)
+for line in sys.stdin:
+    try:
+        r = run(bytes.fromhex(line.strip()).decode())
+    except Exception as e:
+        r = 'err ' + type(e).__name__
+    print(r, flush=True)
+"#;
+
+struct Py {
+    _child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<std::process::ChildStdout>,
+}
+
+static PY_SERVER: OnceLock<Mutex<Py>> = OnceLock::new();
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|b| format!("{b:02x}")).collect()
+}
+
+fn unhex(h: &str) -> String {
+    let bytes: Vec<u8> = (0..h.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&h[i..i + 2], 16).unwrap())
+        .collect();
+    String::from_utf8(bytes).unwrap()
+}
+
+fn python(text: &str) -> Result<Doc, String> {
+    let server = PY_SERVER.get_or_init(|| {
+        let mut child = Command::new("python3")
+            .args(["-c", PY])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .spawn()
+            .expect("python3");
+        let stdin = child.stdin.take().unwrap();
+        let stdout = BufReader::new(child.stdout.take().unwrap());
+        Mutex::new(Py { _child: child, stdin, stdout })
+    });
+    let mut py = server.lock().unwrap();
+    writeln!(py.stdin, "{}", hex(text)).unwrap();
+    let mut line = String::new();
+    py.stdout.read_line(&mut line).unwrap();
+    let line = line.trim_end();
+    if let Some(rest) = line.strip_prefix("ok") {
+        let mut doc = Doc::new();
+        for tok in rest.split_whitespace() {
+            if let Some(s) = tok.strip_prefix("s:") {
+                doc.push((unhex(s), Vec::new()));
+            } else if let Some(kv) = tok.strip_prefix("k:") {
+                let (k, v) = kv.split_once('=').unwrap();
+                doc.last_mut().unwrap().1.push((unhex(k), unhex(v)));
+            } else {
+                panic!("{}", format!("bad token {tok:?} in {line:?}"));
+            }
+        }
+        Ok(doc)
+    } else {
+        Err(line.to_string())
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// The common grammar: text both parsers read the same way (each restriction is a documented
+// difference between the two, see README.md)
+
+// Section names: never `DEFAULT`, never containing `[`/`]` (Python takes the text up to the
+// last `]`, the crate up to the first), never padded (Python keeps the padding, the crate
+// trims), never followed by anything on the line (Python ignores it, the crate reads it as
+// the start of a key).
+const SECTIONS: &[&str] = &["s", "t", "Sec", "a b", "x.y", "1", "é", "a=b", "c;d", "k:v", "q\"q", "-", "树莓"];
+// Keys: never starting with `[`, `;`, `#` or whitespace; no delimiter, no backslash.
+const KEYS: &[&str] = &["k", "key", "Key", "a b", "k2", "x.y", "k-1", "树", "k;c", "k\"q", "k[1", "K"];
+// Values: anything but a trailing backslash (the crate joins the next line even with escapes
+// disabled — pinned separately).
+const VALUES: &[&str] = &[
+    "", "v", "hello world", "a=b", "x:y", ";c", "#c", "\"q\"", "'s' t", "[not a header]", "a\\tb", "C:\\dir",
+    "树莓", "1 2  3", "a]b", "=", "\\x41", "v;", "tab\tin",
+];
+// Continuation lines: never starting with a comment symbol (Python drops the line, the crate
+// keeps it), never ending with a backslash.
+const CONT: &[&str] = &["c", "more text", "x=y", "[t]", "a: b", "\"q\"", "树", "c]d", "k", "1 2"];
+const COMMENTS: &[&str] = &[";c", "# c", ";", "#", "; a = b", "#[s]"];
+const PAD: &[&str] = &["", " ", "  ", "\t"];
+const DELIMITERS: &[char] = &['=', ':'];
+/// Indentation characters, spaces twice as often as tabs.
+const INDENT: &[char] = &[' ', ' ', '\t'];
+
+/// One to four indentation characters.
+fn indentation() -> impl PrintableGenerator<String> {
+    generators::vecs(generators::sampled_from(INDENT))
+        .min_size(1)
+        .max_size(4)
+        .map(|chars| chars.into_iter().collect())
+}
+
+/// No indentation (first) or one to four characters of it.
+fn optional_indentation() -> impl PrintableGenerator<String> {
+    generators::optional(indentation()).map(Option::unwrap_or_default)
+}
+
+/// `key delimiter value`, padded after the key, after the delimiter and at the end.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct KeyLine {
+    key: &'static str,
+    delimiter: char,
+    pads: (&'static str, &'static str, &'static str),
+    value: &'static str,
+}
+
+impl KeyLine {
+    fn render(&self, lead: &str) -> String {
+        let (p1, p2, p3) = self.pads;
+        format!("{lead}{}{p1}{}{p2}{}{p3}", self.key, self.delimiter, self.value)
+    }
+}
+
+fn key_line() -> impl PrintableGenerator<KeyLine> {
+    let pad = || generators::sampled_from(PAD);
+    hegel::tuples!(
+        generators::sampled_from(KEYS),
+        generators::sampled_from(DELIMITERS),
+        pad(),
+        pad(),
+        pad(),
+        generators::sampled_from(VALUES)
+    )
+    .map(|(key, delimiter, p1, p2, p3, value)| KeyLine {
+        key,
+        delimiter,
+        pads: (p1, p2, p3),
+        value,
+    })
+}
+
+/// A comment line and the indentation it has where the text allows one.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Comment {
+    indent: String,
+    text: &'static str,
+}
+
+impl Comment {
+    fn render(&self, indented: bool) -> String {
+        let lead = if indented { self.indent.as_str() } else { "" };
+        format!("{lead}{}", self.text)
+    }
+}
+
+/// A comment with the given indentation.
+fn comment(indent: impl PrintableGenerator<String>) -> impl PrintableGenerator<Comment> {
+    hegel::tuples!(indent, generators::sampled_from(COMMENTS)).map(|(indent, text)| Comment { indent, text })
+}
+
+/// A line of the common grammar as drawn; `Source::lines` fits it to its place in the text.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Line {
+    /// Whitespace only.
+    Blank(&'static str),
+    /// A key line, indented where an indented line is a key for both parsers.
+    Key {
+        indent: String,
+        line: KeyLine,
+    },
+    /// A continuation line of the value before it.
+    Cont {
+        indent: String,
+        text: &'static str,
+        pad: &'static str,
+    },
+    Comment(Comment),
+}
+
+impl Line {
+    /// The line as drawn.
+    fn render(&self) -> String {
+        match self {
+            Line::Blank(pad) => pad.to_string(),
+            Line::Key { indent, line } => line.render(indent),
+            Line::Cont { indent, text, pad } => format!("{indent}{text}{pad}"),
+            Line::Comment(comment) => comment.render(true),
+        }
+    }
+}
+
+/// A blank line, or a comment line indented or not.
+fn filler() -> impl PrintableGenerator<Line> {
+    hegel::one_of!(
+        generators::sampled_from(PAD).map(Line::Blank),
+        comment(optional_indentation()).map(Line::Comment)
+    )
+}
+
+/// A line of a section's body: a blank line first, then a key line (twice as often), a
+/// continuation line, a comment.
+fn body_line() -> impl PrintableGenerator<Line> {
+    let key = || hegel::tuples!(optional_indentation(), key_line()).map(|(indent, line)| Line::Key { indent, line });
+    hegel::one_of!(
+        generators::sampled_from(PAD).map(Line::Blank),
+        key(),
+        key(),
+        hegel::tuples!(indentation(), generators::sampled_from(CONT), generators::sampled_from(PAD))
+            .map(|(indent, text, pad)| Line::Cont { indent, text, pad }),
+        comment(optional_indentation()).map(Line::Comment),
+    )
+}
+
+/// A header, padded or not, and up to five body lines.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Section {
+    name: &'static str,
+    pad: &'static str,
+    body: Vec<Line>,
+}
+
+fn section() -> impl PrintableGenerator<Section> {
+    hegel::tuples!(
+        generators::sampled_from(SECTIONS),
+        generators::sampled_from(PAD),
+        generators::vecs(body_line()).max_size(5)
+    )
+    .map(|(name, pad, body)| Section { name, pad, body })
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum St {
+    /// before the first header: Python needs one
+    Pre,
+    /// after a header (or a comment/blank after it): an indented line is a key for both
+    Header,
+    /// after a key or continuation line: an indented line continues the value in Python
+    /// (and in the crate when `enabled_indented_multiline_value` is on)
+    Key,
+    /// after a comment that follows a key: Python would still continue the value, the crate
+    /// has closed it — nothing indented but comments
+    Closed,
+}
+
+/// Up to two blank or comment lines before the first header, up to three sections, and whether
+/// the text ends in a line break.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Source {
+    preamble: Vec<Line>,
+    sections: Vec<Section>,
+    trailing: bool,
+}
+
+fn source() -> impl PrintableGenerator<Source> {
+    hegel::tuples!(
+        generators::vecs(filler()).max_size(2),
+        generators::vecs(section()).max_size(3),
+        generators::weighted_booleans(0.7)
+    )
+    .map(|(preamble, sections, trailing)| Source {
+        preamble,
+        sections,
+        trailing,
+    })
+}
+
+/// The lines of a `Source` as both parsers read them, fitted one by one. A drawn line that
+/// does not fit its place is left out: a continuation line anywhere but after a key, or when
+/// the crate does not read continuation lines; a blank line inside a multiline value.
+/// Indentation is kept only where both parsers read it alike.
+struct Fitted {
+    out: Vec<String>,
+    /// whether the crate reads continuation lines
+    multiline: bool,
+    st: St,
+    /// an indented comment right after a comment or blank line is rejected (pinned, rust-ini/9)
+    after_comment_or_blank: bool,
+    /// Python continues a value only on a line indented deeper than the key's line
+    key_indent: usize,
+    has_cont: bool,
+}
+
+impl Fitted {
+    fn header(&mut self, section: &Section) {
+        self.out.push(format!("[{}]{}", section.name, section.pad));
+        self.st = St::Header;
+        self.after_comment_or_blank = false;
+    }
+
+    fn line(&mut self, line: &Line) {
+        match line {
+            Line::Blank(_) => {
+                if self.st == St::Key && self.multiline {
+                    return;
+                }
+                self.out.push(line.render());
+                self.after_comment_or_blank = true;
+            }
+            Line::Key { indent, line } => {
+                // an indented line is a key for both parsers only right after a header
+                let lead = if self.st == St::Header { indent.as_str() } else { "" };
+                self.key_indent = lead.len();
+                self.out.push(line.render(lead));
+                self.st = St::Key;
+                self.after_comment_or_blank = false;
+            }
+            Line::Cont { indent, text, pad } => {
+                if self.st != St::Key || !self.multiline {
+                    return;
+                }
+                let mut lead = indent.clone();
+                while lead.len() <= self.key_indent {
+                    lead.push(' ');
+                }
+                self.out.push(format!("{lead}{text}{pad}"));
+                self.has_cont = true;
+                self.after_comment_or_blank = false;
+            }
+            Line::Comment(comment) => {
+                // after a key an indented comment would continue the value in Python and be
+                // text in the crate: unindented there and before the first header
+                let indented = matches!(self.st, St::Header | St::Closed) && !self.after_comment_or_blank;
+                self.out.push(comment.render(indented));
+                if self.st == St::Key {
+                    self.st = St::Closed;
+                }
+                self.after_comment_or_blank = true;
+            }
+        }
+    }
+}
+
+impl Source {
+    /// The lines both parsers read alike when the crate reads continuation lines iff
+    /// `multiline`, and whether one of them is a continuation line.
+    fn lines(&self, multiline: bool) -> (Vec<String>, bool) {
+        let mut fitted = Fitted {
+            out: Vec::new(),
+            multiline,
+            st: St::Pre,
+            after_comment_or_blank: true,
+            key_indent: 0,
+            has_cont: false,
+        };
+        for line in &self.preamble {
+            fitted.line(line);
+        }
+        for section in &self.sections {
+            fitted.header(section);
+            for line in &section.body {
+                fitted.line(line);
+            }
+        }
+        (fitted.out, fitted.has_cont)
+    }
+
+    /// The text: the lines joined by CRLF when `crlf` (but only without continuation lines,
+    /// pinned as rust-ini/4) or by LF, ending in a line break when `trailing`.
+    fn render(&self, multiline: bool, crlf: bool) -> String {
+        let (lines, has_cont) = self.lines(multiline);
+        let sep = if crlf && !has_cont { "\r\n" } else { "\n" };
+        let mut text = lines.join(sep);
+        if !lines.is_empty() && self.trailing {
+            text.push_str(sep);
+        }
+        text
+    }
+}
+
+fn common_options(multiline: bool) -> ParseOption {
+    ParseOption {
+        enabled_quote: false,
+        enabled_escape: false,
+        enabled_indented_multiline_value: multiline,
+        enabled_preserve_key_leading_whitespace: false,
+    }
+}
+
+/// The crate trims line feeds off both ends of a multiline value; Python keeps a leading one
+/// (`k=` followed by an indented line gives `"\nb"`). Documented by the crate's own example
+/// (`foo=` on the first line) — normalised here.
+fn normalise(mut doc: Doc) -> Doc {
+    for (_, props) in doc.iter_mut() {
+        for (_, v) in props.iter_mut() {
+            *v = v.trim_start_matches('\n').to_string();
+        }
+    }
+    doc
+}
+
+#[hegel::test]
+fn parsing_agrees_with_python(tc: TestCase) {
+    let (multiline, source, crlf) = tc.draw(hegel::tuples!(
+        generators::weighted_booleans(0.6),
+        source(),
+        generators::weighted_booleans(0.3)
+    ));
+    let text = source.render(multiline, crlf);
+    let expected = python(&text).unwrap_or_else(|e| panic!("{}", format!("Python rejects {text:?}: {e}")));
+    let ini = Ini::load_from_str_opt(&text, common_options(multiline))
+        .unwrap_or_else(|e| panic!("{}", format!("crate rejects {text:?}: {e}")));
+    assert!(ini.general_section().is_empty(), "{text:?}: general section {:?}", shape(&ini));
+    assert_eq!(merged(&ini), normalise(expected), "{text:?}");
+}
+
+#[hegel::test]
+fn every_entry_point_parses_alike(tc: TestCase) {
+    let (source, crlf) = tc.draw(hegel::tuples!(source(), generators::weighted_booleans(0.3)));
+    // no backslashes: the default options interpret escapes, and `\x41` at a line end is short
+    let text = source.render(false, crlf).replace('\\', "/");
+    let a = shape(&Ini::load_from_str(&text).unwrap());
+    let b = shape(&Ini::read_from(&mut text.as_bytes()).unwrap());
+    let c = shape(&Ini::load_from_str_opt(&text, ParseOption::default()).unwrap());
+    let d = shape(&Ini::read_from_opt(&mut text.as_bytes(), ParseOption::default()).unwrap());
+    assert_eq!(a, b, "{text:?}");
+    assert_eq!(a, c, "{text:?}");
+    assert_eq!(a, d, "{text:?}");
+    // a BOM is skipped
+    let e = shape(&Ini::load_from_str(&format!("\u{feff}{text}")).unwrap());
+    assert_eq!(a, e, "{text:?}");
+}
+
+#[hegel::test]
+fn crlf_and_lf_parse_alike(tc: TestCase) {
+    let lf = tc.draw(source()).render(false, false);
+    let crlf = lf.replace('\n', "\r\n");
+    let a = shape(&Ini::load_from_str_opt(&lf, common_options(false)).unwrap());
+    let b = shape(
+        &Ini::load_from_str_opt(&crlf, common_options(false))
+            .unwrap_or_else(|e| panic!("{}", format!("{crlf:?}: {e}"))),
+    );
+    assert_eq!(a, b, "{lf:?}");
+}
+
+/// The text of `indented_comment_lines_are_comments`: an optional header, an optional key line,
+/// two to four blank or comment lines (indented or not), then two indented comment lines.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct IndentedComments {
+    header: Option<&'static str>,
+    key: Option<KeyLine>,
+    middle: Vec<Line>,
+    tail: Vec<Comment>,
+    crlf: bool,
+    trailing: bool,
+}
+
+fn indented_comments() -> impl PrintableGenerator<IndentedComments> {
+    hegel::tuples!(
+        generators::optional(generators::sampled_from(SECTIONS)),
+        generators::optional(key_line()),
+        generators::vecs(filler()).min_size(2).max_size(4),
+        generators::vecs(comment(indentation())).min_size(2).max_size(2),
+        generators::weighted_booleans(0.4),
+        generators::weighted_booleans(0.7),
+    )
+    .map(|(header, key, middle, tail, crlf, trailing)| IndentedComments {
+        header,
+        key,
+        middle,
+        tail,
+        crlf,
+        trailing,
+    })
+}
+
+impl IndentedComments {
+    fn lines(&self) -> Vec<String> {
+        let mut lines = Vec::new();
+        lines.extend(self.header.map(|name| format!("[{name}]")));
+        lines.extend(self.key.as_ref().map(|key| key.render("")));
+        lines.extend(self.middle.iter().map(Line::render));
+        lines.extend(self.tail.iter().map(|comment| comment.render(true)));
+        lines
+    }
+
+    fn render(&self) -> String {
+        let sep = if self.crlf { "\r\n" } else { "\n" };
+        let mut text = self.lines().join(sep);
+        if self.trailing {
+            text.push_str(sep);
+        }
+        text
+    }
+}
+
+/// Pinned: rust-ini/9 — an indented comment line directly after another comment line (or,
+/// with CRLF line endings, after a whitespace-only line) is rejected as an inline comment.
+#[hegel::test]
+fn indented_comment_lines_are_comments(tc: TestCase) {
+    let case = tc.draw(indented_comments());
+    let (lines, text) = (case.lines(), case.render());
+    let ini = Ini::load_from_str(&text).unwrap_or_else(|e| panic!("{}", format!("{text:?}: {e}")));
+    let keys: usize = shape(&ini).iter().map(|(_, p)| p.len()).sum();
+    let expected = usize::from(
+        lines
+            .iter()
+            .any(|l| l.contains(['=', ':']) && !l.trim_start().starts_with([';', '#', '['])),
+    );
+    assert_eq!(keys, expected, "{text:?} -> {:?}", shape(&ini));
+}
+
+/// Pinned: rust-ini/4 — with `enabled_indented_multiline_value`, a CRLF file gets an extra
+/// line feed for every continuation line.
+#[hegel::test]
+fn crlf_and_lf_parse_alike_with_multiline_values(tc: TestCase) {
+    let lf = tc.draw(source()).render(true, false);
+    let crlf = lf.replace('\n', "\r\n");
+    let a = shape(&Ini::load_from_str_opt(&lf, common_options(true)).unwrap());
+    let b = shape(&Ini::load_from_str_opt(&crlf, common_options(true)).unwrap());
+    assert_eq!(a, b, "{lf:?}");
+}
+
+// ---------------------------------------------------------------------------------------------
+// The writer against the reader
+
+const PLAIN: &[char] = &['a', 'b', 'Z', '0', '9', ' ', '_', '-', '.', 'é', '树', '!', '/', '~', '"', '\'', '(', ')'];
+const RESERVED: &[char] = &['=', ':', ';', '#'];
+const STRUCTURAL: &[char] = &['[', ']'];
+const CONTROL: &[char] = &['\\', '\n', '\t', '\r', '\0', '\x01', '\x1f', '\x7f', '\u{80}', '\u{ffff}'];
+const ASTRAL: &[char] = &['🐱', '\u{100000}', '𝄞'];
+const QUOTES: &[char] = &['"', '\''];
+
+fn escapes_reserved(p: EscapePolicy) -> bool {
+    matches!(
+        p,
+        EscapePolicy::Reserved | EscapePolicy::ReservedUnicode | EscapePolicy::ReservedUnicodeExtended | EscapePolicy::Everything
+    )
+}
+
+fn escapes_astral(p: EscapePolicy) -> bool {
+    matches!(
+        p,
+        EscapePolicy::BasicsUnicodeExtended | EscapePolicy::ReservedUnicodeExtended | EscapePolicy::Everything
+    )
+}
+
+const POLICIES: &[EscapePolicy] = &[
+    EscapePolicy::Nothing,
+    EscapePolicy::Basics,
+    EscapePolicy::BasicsUnicode,
+    EscapePolicy::BasicsUnicodeExtended,
+    EscapePolicy::Reserved,
+    EscapePolicy::ReservedUnicode,
+    EscapePolicy::ReservedUnicodeExtended,
+    EscapePolicy::Everything,
+];
+/// The policies that escape characters above U+FFFF.
+const EXTENDED: &[EscapePolicy] = &[
+    EscapePolicy::BasicsUnicodeExtended,
+    EscapePolicy::ReservedUnicodeExtended,
+    EscapePolicy::Everything,
+];
+/// The line separators, CRLF last: it is left out with indented multiline values (pinned,
+/// rust-ini/4).
+const LINE_SEPARATORS: &[LineSeparator] = &[LineSeparator::SystemDefault, LineSeparator::CR, LineSeparator::CRLF];
+const KV_SEPARATORS: &[&str] = &["=", ":", " = ", " : ", "\t=\t"];
+
+/// The characters of `chars` that `keep` accepts.
+fn only(chars: &[char], keep: impl Fn(char) -> bool) -> Vec<char> {
+    chars.iter().copied().filter(|&c| keep(c)).collect()
+}
+
+/// `chars` followed by `more`.
+fn with(chars: &[char], more: &[char]) -> Vec<char> {
+    chars.iter().chain(more).copied().collect()
+}
+
+/// Text over the alphabet `chars`.
+fn text_from(chars: &[char]) -> generators::TextGenerator {
+    generators::text().alphabet(&chars.iter().collect::<String>())
+}
+
+/// `absent` (the shrink target), or `present` with probability `p`: a weighted two-way choice
+/// that draws only the alternative it takes.
+fn either<T: Clone + Send + Sync + 'static>(
+    p: f64,
+    absent: impl PrintableGenerator<T> + Send + Sync + 'static,
+    present: impl PrintableGenerator<T> + Send + Sync + 'static,
+) -> impl PrintableGenerator<T> {
+    let (absent, present) = (absent.boxed_printable(), present.boxed_printable());
+    generators::weighted_booleans(p).flat_map(move |yes| if yes { present.clone() } else { absent.clone() })
+}
+
+/// One to `max` characters: one of `first` and then, four times in five, characters of `inner`
+/// ending in one of `last`.
+fn word(first: &[char], inner: &[char], last: &[char], max: usize) -> impl PrintableGenerator<String> {
+    let rest = hegel::tuples!(text_from(inner).max_size(max - 2), generators::sampled_from(last.to_vec()))
+        .map(|(inner, last)| format!("{inner}{last}"));
+    hegel::tuples!(
+        generators::sampled_from(first.to_vec()),
+        either(0.8, generators::just(String::new()), rest)
+    )
+    .map(|(first, rest)| format!("{first}{rest}"))
+}
+
+/// The characters a policy writes so that they read back: the plain ones; the control
+/// characters unless the policy is `Nothing`, which writes them raw; the astral ones unless the
+/// policy escapes them (pinned, rust-ini/2).
+fn readable(policy: EscapePolicy) -> Vec<char> {
+    let mut chars = PLAIN.to_vec();
+    if policy != EscapePolicy::Nothing {
+        chars.extend_from_slice(CONTROL);
+    }
+    if !escapes_astral(policy) {
+        chars.extend_from_slice(ASTRAL);
+    }
+    chars
+}
+
+/// A section name: empty one time in seven, else up to six characters of `chars` with no
+/// whitespace at either end (trimmed on read).
+fn section_name(chars: &[char]) -> impl PrintableGenerator<String> {
+    let edge = only(chars, |c| !c.is_whitespace());
+    either(6.0 / 7.0, generators::just(String::new()), word(&edge, chars, &edge, 6))
+}
+
+/// A key of one to six characters of `chars`: no whitespace at either end, not starting with
+/// `[` (a header), nor with a comment symbol, which `chars` holds only under a `Reserved*`
+/// policy, the one that escapes it.
+fn key_name(chars: &[char]) -> impl PrintableGenerator<String> {
+    word(
+        &only(chars, |c| !c.is_whitespace() && c != '['),
+        chars,
+        &only(chars, |c| !c.is_whitespace()),
+        6,
+    )
+}
+
+/// A line of a value: one to eight characters of `chars`, no whitespace at either end (trimmed
+/// on read after unescaping — pinned, rust-ini/10), not starting with a quote (pinned,
+/// rust-ini/3).
+fn value_line(chars: &[char]) -> impl PrintableGenerator<String> {
+    word(
+        &only(chars, |c| !c.is_whitespace() && !QUOTES.contains(&c)),
+        chars,
+        &only(chars, |c| !c.is_whitespace()),
+        8,
+    )
+}
+
+/// A value written with `indent_multiline_value`: a line and up to two more, each read trimmed,
+/// and each preceded by a blank line one time in five.
+fn multiline_value(chars: &[char]) -> impl PrintableGenerator<String> {
+    let line_chars = only(chars, |c| c != '\n');
+    let more = hegel::tuples!(generators::weighted_booleans(0.2), value_line(&line_chars))
+        .map(|(blank_before, line)| format!("{}\n{line}", if blank_before { "\n" } else { "" }));
+    hegel::tuples!(value_line(&line_chars), generators::vecs(more).max_size(2))
+        .map(|(first, more)| format!("{first}{}", more.concat()))
+}
+
+/// A value: empty one time in seven, else a line — with `indent_multiline_value` a
+/// `multiline_value`.
+fn value(chars: &[char], indent: bool) -> impl PrintableGenerator<String> {
+    let line: BoxedPrintableGenerator<'static, String> = if indent {
+        multiline_value(chars).boxed_printable()
+    } else {
+        value_line(chars).boxed_printable()
+    };
+    either(6.0 / 7.0, generators::just(String::new()), line)
+}
+
+/// A configuration and the options it is written with. Names and values keep to what the
+/// documentation makes readable: no padding (trimmed on read), keys not empty and not starting
+/// with a comment symbol or `[`, delimiters in keys only under a `Reserved*` policy, no `[`/`]`
+/// in section names, values not starting with a quote (pinned, rust-ini/3), no `\f`/`\v`
+/// (pinned, rust-ini/1), astral characters only when the policy leaves them raw (pinned,
+/// rust-ini/2); with `indent_multiline_value` no line feeds in names (pinned, rust-ini/7), no
+/// whitespace or quotes around a value's line feeds and none at its ends, no CRLF (pinned,
+/// rust-ini/4).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Written {
+    #[pretty(debug)]
+    policy: EscapePolicy,
+    indent: bool,
+    general: Vec<(String, String)>,
+    sections: Vec<(String, Vec<(String, String)>)>,
+    #[pretty(debug)]
+    line_separator: LineSeparator,
+    kv_separator: &'static str,
+}
+
+impl Written {
+    fn ini(&self) -> Ini {
+        let mut ini = Ini::new();
+        for (k, v) in &self.general {
+            ini.with_general_section().add(k, v);
+        }
+        for (name, pairs) in &self.sections {
+            let mut props = Properties::new();
+            for (k, v) in pairs {
+                props.append(k, v);
+            }
+            match ini.entry(Some(name.clone())) {
+                ini::SectionEntry::Vacant(e) => {
+                    e.insert(props);
+                }
+                ini::SectionEntry::Occupied(mut e) => e.append(props),
+            }
+        }
+        ini
+    }
+
+    fn write_option(&self) -> WriteOption {
+        WriteOption {
+            escape_policy: self.policy,
+            line_separator: self.line_separator,
+            kv_separator: self.kv_separator,
+            indent_multiline_value: self.indent,
+        }
+    }
+
+    /// The reader options that match the writer's.
+    fn read_option(&self) -> ParseOption {
+        ParseOption {
+            enabled_indented_multiline_value: self.indent,
+            ..ParseOption::default()
+        }
+    }
+
+    fn text(&self) -> String {
+        let mut out = Vec::new();
+        self.ini().write_to_opt(&mut out, self.write_option()).unwrap();
+        String::from_utf8(out).unwrap()
+    }
+}
+
+/// A policy and whether multiline values are indented (30%), then everything that depends on
+/// them.
+fn written() -> impl PrintableGenerator<Written> {
+    hegel::tuples!(
+        generators::sampled_from(POLICIES).print_as_debug(),
+        generators::weighted_booleans(0.3)
+    )
+    .flat_map(|(policy, indent)| written_with(policy, indent))
+}
+
+/// Up to three general keys and four sections of up to four keys each over the alphabets the
+/// policy leaves readable, a line separator and a key-value separator.
+fn written_with(policy: EscapePolicy, indent: bool) -> impl PrintableGenerator<Written> {
+    // with `indent_multiline_value` a line feed in a name does not read back (pinned, rust-ini/7)
+    let names = only(&readable(policy), |c| !(indent && c == '\n'));
+    let section_chars = with(&names, RESERVED);
+    let key_chars = with(
+        &with(&names, STRUCTURAL),
+        if escapes_reserved(policy) { RESERVED } else { &[] },
+    );
+    let value_chars = with(&with(&readable(policy), RESERVED), STRUCTURAL);
+    let pair = || hegel::tuples!(key_name(&key_chars), value(&value_chars, indent));
+    let line_separators = if indent { &LINE_SEPARATORS[..2] } else { LINE_SEPARATORS };
+    hegel::tuples!(
+        generators::just(policy).print_as_debug(),
+        generators::just(indent),
+        generators::vecs(pair()).max_size(3),
+        generators::vecs(hegel::tuples!(
+            section_name(&section_chars),
+            generators::vecs(pair()).max_size(4)
+        ))
+        .max_size(4),
+        generators::sampled_from(line_separators).print_as_debug(),
+        generators::sampled_from(KV_SEPARATORS),
+    )
+    .map(|(policy, indent, general, sections, line_separator, kv_separator)| Written {
+        policy,
+        indent,
+        general,
+        sections,
+        line_separator,
+        kv_separator,
+    })
+}
+
+#[hegel::test]
+fn written_ini_reads_back(tc: TestCase) {
+    let written = tc.draw(written());
+    let (ini, text) = (written.ini(), written.text());
+    let back = Ini::load_from_str_opt(&text, written.read_option())
+        .unwrap_or_else(|e| panic!("{}", format!("{:?} -> {:?}: {e}", shape(&ini), text)));
+    assert_eq!(shape(&ini), shape(&back), "{:?}", text);
+}
+
+/// A counter for the temporary directories of `write_to_file_and_load_from_file_agree_with_the_writer`.
+static DIRS: AtomicU64 = AtomicU64::new(0);
+
+#[hegel::test]
+fn write_to_file_and_load_from_file_agree_with_the_writer(tc: TestCase) {
+    let written = tc.draw(written());
+    let (ini, text, read, opt) = (written.ini(), written.text(), written.read_option(), written.write_option());
+    let dir = std::env::temp_dir().join(format!(
+        "hegel-rust-ini-{}-{}",
+        std::process::id(),
+        DIRS.fetch_add(1, Ordering::Relaxed)
+    ));
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join("conf.ini");
+    ini.write_to_file_opt(&path, opt.clone()).unwrap();
+    assert_eq!(std::fs::read_to_string(&path).unwrap(), text);
+    let back = Ini::load_from_file_opt(&path, read).unwrap();
+    assert_eq!(shape(&ini), shape(&back), "{:?}", text);
+    // the policy-only and default entry points are the same writer and reader
+    ini.write_to_file_policy(&path, opt.escape_policy).unwrap();
+    let mut out = Vec::new();
+    ini.write_to_policy(&mut out, opt.escape_policy).unwrap();
+    assert_eq!(std::fs::read_to_string(&path).unwrap(), String::from_utf8(out).unwrap());
+    ini.write_to_file(&path).unwrap();
+    let mut out = Vec::new();
+    ini.write_to(&mut out).unwrap();
+    let default_text = String::from_utf8(out).unwrap();
+    assert_eq!(std::fs::read_to_string(&path).unwrap(), default_text);
+    let from_file = Ini::load_from_file(&path).map(|i| shape(&i)).map_err(|e| e.to_string());
+    let from_str = Ini::load_from_str(&default_text).map(|i| shape(&i)).map_err(|e| e.to_string());
+    assert_eq!(from_file, from_str);
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+/// The plain characters without the quotes and the space: what a pinned value is made of
+/// around the character under test.
+fn core_chars() -> Vec<char> {
+    only(PLAIN, |c| !QUOTES.contains(&c) && c != ' ')
+}
+
+/// The whitespace a value may be written with at its ends: escaped, or (U+00A0, U+2003) raw.
+const WHITESPACE: &[char] = &['\t', '\r', '\n', '\u{a0}', '\u{2003}'];
+
+/// Pinned: rust-ini/10 — the reader trims a value after unescaping it, so escaped whitespace
+/// at either end of a value (`\t`, `\r`, `\n`, `\x0020`) is written faithfully and lost on
+/// reading.
+#[hegel::test]
+fn escaped_whitespace_at_value_ends_reads_back(tc: TestCase) {
+    let (policy, core, ws, at_end) = tc.draw(hegel::tuples!(
+        generators::sampled_from(&POLICIES[1..]).print_as_debug(),
+        text_from(&core_chars()).min_size(1).max_size(4),
+        generators::sampled_from(WHITESPACE),
+        generators::booleans()
+    ));
+    let value = if at_end { format!("{core}{ws}") } else { format!("{ws}{core}") };
+    let mut ini = Ini::new();
+    ini.with_section(Some("s")).set("k", value.clone());
+    let mut out = Vec::new();
+    ini.write_to_policy(&mut out, policy).unwrap();
+    let text = String::from_utf8(out).unwrap();
+    let back = Ini::load_from_str(&text).unwrap_or_else(|e| panic!("{}", format!("{policy:?} wrote {text:?}: {e}")));
+    assert_eq!(back.get_from(Some("s"), "k"), Some(value.as_str()), "{policy:?} wrote {text:?}");
+}
+
+const FORM_FEED_AND_VERTICAL_TAB: &[char] = &['\x0c', '\x0b'];
+
+/// Pinned: rust-ini/1 — U+000C and U+000B are written as `\f` and `\v`, which the reader
+/// turns into the letters `f` and `v`.
+#[hegel::test]
+fn form_feed_and_vertical_tab_read_back(tc: TestCase) {
+    let chars = with(&core_chars(), FORM_FEED_AND_VERTICAL_TAB);
+    let (policy, before, c, after) = tc.draw(hegel::tuples!(
+        generators::sampled_from(&POLICIES[1..]).print_as_debug(),
+        text_from(&chars).max_size(3),
+        generators::sampled_from(FORM_FEED_AND_VERTICAL_TAB),
+        text_from(&chars).max_size(2)
+    ));
+    let value = format!("{before}{c}{after}");
+    let mut ini = Ini::new();
+    ini.with_section(Some("s")).set("k", value.clone());
+    let mut out = Vec::new();
+    ini.write_to_policy(&mut out, policy).unwrap();
+    let text = String::from_utf8(out).unwrap();
+    let back = Ini::load_from_str(&text).unwrap();
+    assert_eq!(back.get_from(Some("s"), "k"), Some(value.as_str()), "{policy:?} wrote {text:?}");
+}
+
+/// Pinned: rust-ini/2 — the `*Extended`/`Everything` policies write characters above U+FFFF
+/// as `\x` plus five or six hex digits; the reader takes exactly four.
+#[hegel::test]
+fn astral_characters_read_back_under_extended_policies(tc: TestCase) {
+    let (policy, prefix, astral) = tc.draw(hegel::tuples!(
+        generators::sampled_from(EXTENDED).print_as_debug(),
+        text_from(&with(&core_chars(), ASTRAL)).max_size(5),
+        generators::sampled_from(ASTRAL)
+    ));
+    let value = format!("{prefix}{astral}");
+    let mut ini = Ini::new();
+    ini.with_section(Some("s")).set("k", value.clone());
+    let mut out = Vec::new();
+    ini.write_to_policy(&mut out, policy).unwrap();
+    let text = String::from_utf8(out).unwrap();
+    let back = Ini::load_from_str(&text).unwrap_or_else(|e| panic!("{}", format!("{policy:?} wrote {text:?}: {e}")));
+    assert_eq!(back.get_from(Some("s"), "k"), Some(value.as_str()), "{policy:?} wrote {text:?}");
+}
+
+/// Pinned: rust-ini/3 — no policy escapes a quote, so a value starting with `"` or `'` is
+/// written bare and read back (with the default `enabled_quote`) as a quoted value: the quote
+/// is lost, or the file is rejected when the quote is not closed.
+#[hegel::test]
+fn values_starting_with_a_quote_read_back(tc: TestCase) {
+    let chars = only(PLAIN, |c| !QUOTES.contains(&c));
+    let (policy, quote, inner, closing) = tc.draw(hegel::tuples!(
+        generators::sampled_from(POLICIES).print_as_debug(),
+        generators::sampled_from(QUOTES),
+        text_from(&chars).max_size(5),
+        generators::optional(text_from(&chars).max_size(3))
+    ));
+    let mut value = format!("{quote}{}", inner.trim());
+    if let Some(tail) = closing {
+        value.push(quote);
+        value.push_str(tail.trim_end());
+    }
+    let mut ini = Ini::new();
+    ini.with_section(Some("s")).set("k", value.clone());
+    let mut out = Vec::new();
+    ini.write_to_policy(&mut out, policy).unwrap();
+    let text = String::from_utf8(out).unwrap();
+    let back = Ini::load_from_str(&text).unwrap_or_else(|e| panic!("{}", format!("{policy:?} wrote {text:?}: {e}")));
+    assert_eq!(back.get_from(Some("s"), "k"), Some(value.as_str()), "{policy:?} wrote {text:?}");
+}
+
+/// Pinned: rust-ini/7 — `indent_multiline_value` indents the line feeds of section names and
+/// keys too, and the reader does not undo that.
+#[hegel::test]
+fn indented_multiline_writer_keeps_keys_and_sections(tc: TestCase) {
+    let part = || text_from(&core_chars()).min_size(1).max_size(3);
+    let (head, tail, in_section) = tc.draw(hegel::tuples!(part(), part(), generators::booleans()));
+    let name = format!("{head}\n{tail}");
+    let mut ini = Ini::new();
+    if in_section {
+        ini.with_section(Some(name.clone())).set("k", "v");
+    } else {
+        ini.with_section(Some("s")).set(name.clone(), "v");
+    }
+    let opt = WriteOption {
+        indent_multiline_value: true,
+        ..Default::default()
+    };
+    let mut out = Vec::new();
+    ini.write_to_opt(&mut out, opt).unwrap();
+    let text = String::from_utf8(out).unwrap();
+    let back = Ini::load_from_str_opt(&text, ParseOption { enabled_indented_multiline_value: true, ..Default::default() })
+        .unwrap_or_else(|e| panic!("{}", format!("{text:?}: {e}")));
+    assert_eq!(shape(&ini), shape(&back), "{text:?}");
+}
