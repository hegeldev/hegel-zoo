+/// Pinned: rust-ini/8 — `Properties::remove`, `SectionSetter::delete` and `Ini::delete` are
+/// documented as removing the first value / entry / section with the name; they remove all of
+/// them (returning the first).
+#[hegel::test]
+fn remove_and_delete_take_only_the_first_entry(mut tc: TestCase) {
+    let count = n(&mut tc, 2, 4) as usize;
+    let key = pick(&mut tc, KEYS);
+    let values: Vec<String> = (0..count).map(|_| pick(&mut tc, VALUES).to_string()).collect();
+    match n(&mut tc, 0, 2) {
+        0 => {
+            let mut props = Properties::new();
+            for v in &values {
+                props.append(key, v.clone());
+            }
+            assert_eq!(props.remove(key), Some(values[0].clone()));
+            assert_eq!(props.get_all(key).collect::<Vec<_>>(), values[1..].iter().map(String::as_str).collect::<Vec<_>>());
+        }
+        1 => {
+            let mut ini = Ini::new();
+            for v in &values {
+                ini.with_section(Some("s")).add(key, v.clone());
+            }
+            ini.with_section(Some("s")).delete(&key);
+            assert_eq!(ini.section(Some("s")).unwrap().get_all(key).collect::<Vec<_>>(), values[1..].iter().map(String::as_str).collect::<Vec<_>>());
+        }
+        _ => {
+            let mut ini = Ini::new();
+            for v in &values {
+                let mut props = Properties::new();
+                props.insert(key, v.clone());
+                match ini.entry(Some("s".to_string())) {
+                    ini::SectionEntry::Vacant(e) => {
+                        e.insert(props);
+                    }
+                    ini::SectionEntry::Occupied(mut e) => e.append(props),
+                }
+            }
+            let first = ini.delete(Some("s")).expect("a section");
+            assert_eq!(first.get(key), Some(values[0].as_str()));
+            assert_eq!(ini.section_all(Some("s")).count(), count - 1);
+        }
+    }
+}
