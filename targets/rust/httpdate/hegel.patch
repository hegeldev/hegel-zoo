+//! Hegel property tests for `httpdate`: `HttpDate` ↔ `SystemTime` (the crate's own civil-calendar
+//! arithmetic, years 1970..=9999), `Display` (IMF-fixdate), and the three accepted HTTP date
+//! spellings (IMF-fixdate, RFC 850, asctime).
+//!
+//! Oracles: `jiff` renders the same instant with `strftime` (`%a, %d %b %Y %H:%M:%S GMT` and the
+//! two legacy layouts) and parses IMF-fixdate texts as RFC 2822; texts are otherwise generated
+//! from known components, so the accepted value is known exactly and every mutation of a valid
+//! text has a known verdict.
+
+use std::collections::HashSet;
+use std::str::FromStr;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use hegel::generators;
+use httpdate::{fmt_http_date, parse_http_date, HttpDate};
+use jiff::civil;
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+/// 10000-01-01T00:00:00Z: the first second the crate refuses.
+const END: u64 = 253_402_300_800;
+
+const WDAYS: [&str; 7] = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
+const WDAYS_LONG: [&str; 7] = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
+const MONTHS: [&str; 12] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+
+/// Seconds since the epoch, biased to the edges (1970, 9999, leap days, century boundaries).
+#[hegel::composite]
+fn arb_secs(tc: &hegel::TestCase) -> u64 {
+    match tc.draw(int!(0u8, 4)) {
+        0 => tc.draw(int!(0u64, END - 1)),
+        1 => tc.draw(int!(0u64, 4_102_444_800)), // ..2100-01-01
+        2 => tc.draw(int!(0u64, 86_400 * 366 * 2)),
+        3 => tc.draw(generators::sampled_from(vec![
+            0,
+            1,
+            86_399,
+            86_400,
+            951_782_400 - 1, // 2000-02-28T23:59:59
+            951_782_400,     // 2000-02-29
+            951_868_800,     // 2000-03-01
+            4_107_542_400,   // 2100-02-28
+            4_107_628_800,   // 2100-03-01
+            784_111_777,     // RFC 7231's example
+            END - 1,
+        ])),
+        _ => {
+            // a whole day boundary, ± a few seconds
+            let day = tc.draw(int!(0u64, END / 86_400 - 1));
+            let jitter = tc.draw(int!(-3i64, 3));
+            (day * 86_400).saturating_add_signed(jitter).min(END - 1)
+        }
+    }
+}
+
+const EPOCH: civil::DateTime = civil::DateTime::constant(1970, 1, 1, 0, 0, 0, 0);
+
+/// The UTC civil datetime of an instant, by jiff's civil arithmetic (jiff's `Timestamp` stops at
+/// 9999-12-30T22:00Z, two days short of the crate's range, so the civil type is used throughout).
+fn jiff_utc(secs: u64) -> civil::DateTime {
+    EPOCH.checked_add(jiff::Span::new().seconds(secs as i64)).unwrap()
+}
+
+/// Seconds since the epoch of a UTC civil datetime.
+fn secs_of(dt: civil::DateTime) -> u64 {
+    dt.duration_since(EPOCH).as_secs() as u64
+}
+
+fn strftime(fmt: &str, z: &civil::DateTime) -> String {
+    jiff::fmt::strtime::format(fmt, *z).unwrap()
+}
+
+/// The civil fields jiff gives for an instant.
+fn fields(z: &civil::DateTime) -> (u16, u8, u8, u8, u8, u8, u8) {
+    (
+        z.year() as u16,
+        z.month() as u8,
+        z.day() as u8,
+        z.hour() as u8,
+        z.minute() as u8,
+        z.second() as u8,
+        z.weekday().to_monday_one_offset() as u8,
+    )
+}
+
+/// Renders the three HTTP layouts from civil fields (weekday 1 = Monday).
+fn imf(y: u16, mo: u8, d: u8, h: u8, mi: u8, s: u8, wd: u8) -> String {
+    format!("{}, {d:02} {} {y:04} {h:02}:{mi:02}:{s:02} GMT", WDAYS[wd as usize - 1], MONTHS[mo as usize - 1])
+}
+fn rfc850(y: u16, mo: u8, d: u8, h: u8, mi: u8, s: u8, wd: u8) -> String {
+    format!("{}, {d:02}-{}-{:02} {h:02}:{mi:02}:{s:02} GMT", WDAYS_LONG[wd as usize - 1], MONTHS[mo as usize - 1], y % 100)
+}
+fn asctime(y: u16, mo: u8, d: u8, h: u8, mi: u8, s: u8, wd: u8) -> String {
+    format!("{} {} {d:>2} {h:02}:{mi:02}:{s:02} {y:04}", WDAYS[wd as usize - 1], MONTHS[mo as usize - 1])
+}
+
+// ----------------------------------------------------------------------------------------------
+
+/// `HttpDate::from(SystemTime)` prints the IMF-fixdate `jiff` prints for the instant (seconds
+/// floored), converts back to the floored instant, and each of the three spellings of that
+/// instant parses to it — the legacy two-digit year only for 1970..=2069.
+#[hegel::test]
+fn instants_print_and_parse_like_jiff(tc: hegel::TestCase) {
+    let secs = tc.draw(arb_secs());
+    let nanos = tc.draw(int!(0u32, 999_999_999));
+    let exact = UNIX_EPOCH + Duration::from_secs(secs);
+    let t = UNIX_EPOCH + Duration::new(secs, nanos);
+    let z = jiff_utc(secs);
+
+    let d = HttpDate::from(t);
+    let shown = d.to_string();
+    assert_eq!(shown, strftime("%a, %d %b %Y %H:%M:%S GMT", &z), "{secs}");
+    assert_eq!(shown.len(), 29);
+    assert_eq!(fmt_http_date(t), shown);
+    assert_eq!(SystemTime::from(d), exact, "floored to the second");
+    assert_eq!(HttpDate::from(exact), d);
+
+    let (y, mo, day, h, mi, s, wd) = fields(&z);
+    assert_eq!(shown, imf(y, mo, day, h, mi, s, wd));
+    assert_eq!(parse_http_date(&shown).unwrap(), exact, "{shown}");
+    assert_eq!(HttpDate::from_str(&shown).unwrap(), d);
+
+    let legacy = rfc850(y, mo, day, h, mi, s, wd);
+    assert_eq!(legacy, strftime("%A, %d-%b-%y %H:%M:%S GMT", &z));
+    let parsed = parse_http_date(&legacy);
+    if (1970..=2069).contains(&y) {
+        assert_eq!(parsed.unwrap(), exact, "{legacy}");
+    } else {
+        // the two-digit year names 1970 + (y % 100) or 2000 + (y % 100) instead
+        let named = if y % 100 < 70 { 2000 + y % 100 } else { 1900 + y % 100 };
+        let expected = jiff::civil::date(named as i16, mo as i8, day as i8).at(h as i8, mi as i8, s as i8, 0);
+        let same_weekday = expected.weekday().to_monday_one_offset() as u8 == wd;
+        let leap_ok = !(mo == 2 && day == 29) || jiff::civil::Date::new(named as i16, 1, 1).unwrap().in_leap_year();
+        match parsed {
+            Ok(v) => {
+                assert!(same_weekday && leap_ok, "{legacy} accepted as {}", fmt_http_date(v));
+                assert_eq!(v, UNIX_EPOCH + Duration::from_secs(secs_of(expected)));
+            }
+            Err(_) => assert!(!(same_weekday && leap_ok), "{legacy} rejected"),
+        }
+    }
+
+    let asc = asctime(y, mo, day, h, mi, s, wd);
+    assert_eq!(asc, strftime("%a %b %e %H:%M:%S %Y", &z));
+    assert_eq!(parse_http_date(&asc).unwrap(), exact, "{asc}");
+
+    // jiff reads the IMF-fixdate as RFC 2822 and lands on the same instant
+    if secs <= jiff::Timestamp::MAX.as_second() as u64 {
+        let rfc: jiff::Timestamp = jiff::fmt::rfc2822::parse(&shown).unwrap_or_else(|e| panic!("jiff rejects {shown}: {e}")).timestamp();
+        assert_eq!(rfc.as_second() as u64, secs);
+    }
+}
+
+/// Surrounding whitespace is trimmed; anything else — a changed byte, a missing or extra byte,
+/// a non-ASCII byte — either changes the value canonically or is refused: an IMF-fixdate text is
+/// accepted exactly when it is the canonical rendering of some instant in 1970..=9999.
+#[hegel::test]
+fn imf_fixdate_texts_are_accepted_exactly_when_canonical(tc: hegel::TestCase) {
+    let secs = tc.draw(arb_secs());
+    let shown = fmt_http_date(UNIX_EPOCH + Duration::from_secs(secs));
+    let bytes = shown.as_bytes();
+
+    let ws = tc.draw(generators::sampled_from(vec!["", " ", "  ", "\t", "\r\n", "\n "]));
+    let ws2 = tc.draw(generators::sampled_from(vec!["", " ", "\t", " \r\n"]));
+    let padded = format!("{ws}{shown}{ws2}");
+    assert_eq!(parse_http_date(&padded).unwrap(), UNIX_EPOCH + Duration::from_secs(secs), "{padded:?}");
+
+    let mutated: String = match tc.draw(int!(0u8, 4)) {
+        0 => {
+            let i = tc.draw(int!(0usize, bytes.len() - 1));
+            let c = tc.draw(generators::sampled_from(b"0123456789 ,:-GMTJanFebSunMonu\x7f\x00".to_vec()));
+            let mut b = bytes.to_vec();
+            b[i] = c;
+            String::from_utf8(b).unwrap()
+        }
+        1 => {
+            let i = tc.draw(int!(0usize, bytes.len() - 1));
+            let mut b = bytes.to_vec();
+            b.remove(i);
+            String::from_utf8(b).unwrap()
+        }
+        2 => {
+            let i = tc.draw(int!(0usize, bytes.len()));
+            let c = tc.draw(generators::sampled_from(b"0123456789 ,:GMT".to_vec()));
+            let mut b = bytes.to_vec();
+            b.insert(i, c);
+            String::from_utf8(b).unwrap()
+        }
+        3 => {
+            let i = tc.draw(int!(0usize, bytes.len() - 1));
+            let mut s: Vec<char> = shown.chars().collect();
+            s[i] = tc.draw(generators::sampled_from(vec!['é', '٠', '\u{a0}', 'Ｇ']));
+            s.into_iter().collect()
+        }
+        _ => {
+            // swap two positions
+            let i = tc.draw(int!(0usize, bytes.len() - 1));
+            let j = tc.draw(int!(0usize, bytes.len() - 1));
+            let mut b = bytes.to_vec();
+            b.swap(i, j);
+            String::from_utf8(b).unwrap()
+        }
+    };
+    match parse_http_date(&mutated) {
+        Ok(v) => {
+            let canonical = fmt_http_date(v);
+            assert_eq!(canonical, mutated.trim(), "{mutated:?} accepted but not canonical");
+            let z = jiff_utc(v.duration_since(UNIX_EPOCH).unwrap().as_secs());
+            assert_eq!(canonical, strftime("%a, %d %b %Y %H:%M:%S GMT", &z));
+        }
+        Err(e) => {
+            assert_eq!(e.to_string(), "string contains no or an invalid date");
+            let io: std::io::Error = e.into();
+            assert_eq!(io.kind(), std::io::ErrorKind::Other);
+            // a rejected text must not be a canonical rendering
+            if mutated.trim().len() == 29 {
+                if let Ok(ts) = jiff::fmt::rfc2822::parse(mutated.trim()) {
+                    let s = ts.timestamp().as_second();
+                    if (0..END as i64).contains(&s) {
+                        let canonical = fmt_http_date(UNIX_EPOCH + Duration::from_secs(s as u64));
+                        assert_ne!(canonical, mutated.trim(), "{mutated:?} is canonical yet rejected");
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Fields written from components: a wrong weekday, a day the month does not have, a year
+/// before 1970, or a field past its range is refused in every spelling; a right one is accepted
+/// and prints canonically.
+#[hegel::test]
+fn component_texts_are_validated(tc: hegel::TestCase) {
+    let y = match tc.draw(int!(0u8, 3)) {
+        0 => tc.draw(int!(1900u16, 2100)),
+        1 => tc.draw(int!(1970u16, 9999)),
+        2 => tc.draw(int!(0u16, 9999)),
+        _ => tc.draw(generators::sampled_from(vec![1969, 1970, 1999, 2000, 2069, 2070, 9999])),
+    };
+    let mo = tc.draw(int!(1u8, 12));
+    let d = tc.draw(int!(1u8, 31));
+    let (h, mi, s) = match tc.draw(int!(0u8, 3)) {
+        0 => (tc.draw(int!(0u8, 99)), tc.draw(int!(0u8, 99)), tc.draw(int!(0u8, 99))),
+        _ => (tc.draw(int!(0u8, 23)), tc.draw(int!(0u8, 59)), tc.draw(int!(0u8, 59))),
+    };
+    let real = jiff::civil::Date::new(y as i16, mo as i8, d as i8).ok();
+    let wd = match (real, tc.draw(int!(0u8, 3))) {
+        (Some(date), 0..=2) => date.weekday().to_monday_one_offset() as u8,
+        _ => tc.draw(int!(1u8, 7)),
+    };
+    let form = tc.draw(int!(0u8, 2));
+    let text = match form {
+        0 => imf(y, mo, d, h, mi, s, wd),
+        1 => rfc850(y, mo, d, h, mi, s, wd),
+        _ => asctime(y, mo, d, h, mi, s, wd),
+    };
+    // the year the text names (RFC 850 carries two digits)
+    let named = if form == 1 { if y % 100 < 70 { 2000 + y % 100 } else { 1900 + y % 100 } } else { y };
+    let named_date = jiff::civil::Date::new(named as i16, mo as i8, d as i8).ok();
+    let valid = named_date.is_some_and(|nd| nd.weekday().to_monday_one_offset() as u8 == wd)
+        && (1970..=9999).contains(&named)
+        && h < 24
+        && mi < 60
+        && s < 60;
+    let parsed = parse_http_date(&text);
+    assert_eq!(parsed.is_ok(), valid, "{text} -> {:?}", parsed.as_ref().map(|v| fmt_http_date(*v)));
+    if let Ok(v) = parsed {
+        let z = named_date.unwrap().at(h as i8, mi as i8, s as i8, 0);
+        assert_eq!(v, UNIX_EPOCH + Duration::from_secs(secs_of(z)), "{text}");
+        assert_eq!(fmt_http_date(v), strftime("%a, %d %b %Y %H:%M:%S GMT", &z));
+    }
+}
+
+/// `HttpDate` is ordered, equal and hashed exactly like the (floored) instant it names.
+#[hegel::test]
+fn ordering_equality_and_hashing_follow_the_instant(tc: hegel::TestCase) {
+    let n = tc.draw(int!(1usize, 8));
+    let secs: Vec<u64> = (0..n).map(|_| tc.draw(arb_secs())).collect();
+    let dates: Vec<HttpDate> = secs.iter().map(|&s| HttpDate::from(UNIX_EPOCH + Duration::new(s, tc.draw(int!(0u32, 999_999_999))))).collect();
+    for (i, a) in dates.iter().enumerate() {
+        for (j, b) in dates.iter().enumerate() {
+            assert_eq!(a.cmp(b), secs[i].cmp(&secs[j]), "{a} vs {b}");
+            assert_eq!(a.partial_cmp(b), Some(secs[i].cmp(&secs[j])));
+            assert_eq!(a == b, secs[i] == secs[j]);
+            assert_eq!(a.to_string() == b.to_string(), secs[i] == secs[j]);
+        }
+    }
+    let mut sorted = dates.clone();
+    sorted.sort();
+    let mut expected = secs.clone();
+    expected.sort();
+    assert_eq!(sorted.iter().map(|d| SystemTime::from(*d)).collect::<Vec<_>>(), expected.iter().map(|&s| UNIX_EPOCH + Duration::from_secs(s)).collect::<Vec<_>>());
+    let set: HashSet<HttpDate> = dates.iter().copied().collect();
+    assert_eq!(set.len(), secs.iter().collect::<HashSet<_>>().len());
+    // the textual order of IMF-fixdates is not chronological, but the parse of each is its value
+    for d in &dates {
+        assert_eq!(d.to_string().parse::<HttpDate>().unwrap(), *d);
+    }
+}
+
+/// Outside 1970..=9999 the conversion from `SystemTime` panics (documented range); the last
+/// second of 9999 is fine.
+#[hegel::test]
+fn the_documented_range_is_exact(tc: hegel::TestCase) {
+    let before = tc.draw(int!(1u64, 1u64 << 40));
+    let after = tc.draw(int!(0u64, 1u64 << 40));
+    std::panic::set_hook(Box::new(|_| {}));
+    let early = std::panic::catch_unwind(|| fmt_http_date(UNIX_EPOCH - Duration::from_secs(before)));
+    let late = std::panic::catch_unwind(|| fmt_http_date(UNIX_EPOCH + Duration::from_secs(END + after)));
+    let _ = std::panic::take_hook();
+    assert!(early.is_err(), "{before}s before the epoch formatted as {early:?}");
+    assert!(late.is_err(), "{after}s after 9999 formatted as {late:?}");
+    assert_eq!(fmt_http_date(UNIX_EPOCH + Duration::from_secs(END - 1)), "Fri, 31 Dec 9999 23:59:59 GMT");
+    assert!(parse_http_date("Sat, 01 Jan 10000 00:00:00 GMT").is_err());
+    assert!(parse_http_date("Wed, 31 Dec 1969 23:59:59 GMT").is_err());
+}
