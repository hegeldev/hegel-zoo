diff --git a/crates/proto/src/rr/serial_number.rs b/crates/proto/src/rr/serial_number.rs
index c4396ab..85c1632 100644
--- a/crates/proto/src/rr/serial_number.rs
+++ b/crates/proto/src/rr/serial_number.rs
@@ -119,3 +119,74 @@ mod tests {
         assert_eq!(a + b, SerialNumber(0));
     }
 }
+
+#[cfg(test)]
+mod hegel_tests {
+    // the code generated by #[hegel::test] calls .to_string() on the test name
+    use alloc::string::ToString;
+
+    use hegel::generators;
+
+    use super::*;
+
+    /// Property: RFC 1982 §3.1 — adding n with 0 < n < 2^31 to a serial number yields
+    /// a serial number greater than the original, across the u32 wrap-around.
+    ///
+    /// Evidence: the `Add` impl above cites "Serial Number Addition, see RFC 1982,
+    /// section 3.1" and `PartialOrd` cites section 3.2.
+    #[hegel::test]
+    fn hegel_serial_addition_orders_correctly(tc: hegel::TestCase) {
+        let s = SerialNumber::new(tc.draw(generators::integers::<u32>()));
+        let n = tc.draw(
+            generators::integers::<u32>()
+                .min_value(1)
+                .max_value((1u32 << 31) - 1),
+        );
+        let sum = s + SerialNumber::new(n);
+        assert_eq!(
+            s.partial_cmp(&sum),
+            Some(Ordering::Less),
+            "s={s:?} n={n} sum={sum:?}"
+        );
+        assert_eq!(
+            sum.partial_cmp(&s),
+            Some(Ordering::Greater),
+            "s={s:?} n={n} sum={sum:?}"
+        );
+    }
+
+    /// Property: RFC 1982 §3.2 comparison is antisymmetric, and is undefined exactly
+    /// when the two serial numbers are 2^31 apart.
+    ///
+    /// Evidence: RFC 1982 §3.2 ("the order of two numbers differing by 2^(SERIAL_BITS-1)
+    /// is undefined"), cited by the `PartialOrd` impl above.
+    #[hegel::test]
+    fn hegel_serial_cmp_antisymmetric(tc: hegel::TestCase) {
+        let a = SerialNumber::new(tc.draw(generators::integers::<u32>()));
+        // half the time, force the ambiguous distance of exactly 2^31
+        let b = if tc.draw(generators::booleans()) {
+            SerialNumber::new(a.get().wrapping_add(1 << 31))
+        } else {
+            SerialNumber::new(tc.draw(generators::integers::<u32>()))
+        };
+
+        let ab = a.partial_cmp(&b);
+        let ba = b.partial_cmp(&a);
+        match ab {
+            Some(Ordering::Less) => assert_eq!(ba, Some(Ordering::Greater), "a={a:?} b={b:?}"),
+            Some(Ordering::Greater) => assert_eq!(ba, Some(Ordering::Less), "a={a:?} b={b:?}"),
+            Some(Ordering::Equal) => {
+                assert_eq!(a, b);
+                assert_eq!(ba, Some(Ordering::Equal));
+            }
+            None => {
+                assert_eq!(
+                    b.get().wrapping_sub(a.get()),
+                    1 << 31,
+                    "None must only occur at distance 2^31: a={a:?} b={b:?}"
+                );
+                assert_eq!(ba, None, "a={a:?} b={b:?}");
+            }
+        }
+    }
+}
