diff --git a/crates/proto/src/rr/domain/name.rs b/crates/proto/src/rr/domain/name.rs
index cda3c7d..0890a79 100644
--- a/crates/proto/src/rr/domain/name.rs
+++ b/crates/proto/src/rr/domain/name.rs
@@ -2656,4 +2656,346 @@ mod tests {
         sorted.sort();
         assert_eq!(names, sorted);
     }
+
+    // ===== hegel property-based tests =====
+
+    use hegel::generators;
+    use hegel::Generator;
+
+    /// A single label: 1-63 arbitrary bytes (labels are 8-bit clean on the wire, see
+    /// `Label::from_raw_bytes`), biased toward ASCII letters so that the
+    /// case-insensitivity contracts get exercised too.
+    #[hegel::composite]
+    fn arbitrary_label(tc: &hegel::TestCase) -> Vec<u8> {
+        tc.draw(hegel::one_of!(
+            generators::vecs(generators::integers::<u8>())
+                .min_size(1)
+                .max_size(63),
+            generators::vecs(generators::integers::<u8>().min_value(b'A').max_value(b'z'))
+                .min_size(1)
+                .max_size(63),
+        ))
+    }
+
+    /// An arbitrary valid `Name`, built label-by-label. Appending stops when the
+    /// 255-octet name limit is reached, so maximal-length names are constructed
+    /// directly instead of being rejected.
+    #[hegel::composite]
+    fn arbitrary_name(tc: &hegel::TestCase) -> Name {
+        let labels: Vec<Vec<u8>> = tc.draw(generators::vecs(arbitrary_label()).max_size(60));
+        let mut name = Name::new();
+        for label in labels {
+            match name.clone().append_label(label.as_slice()) {
+                Ok(extended) => name = extended,
+                Err(_) => break, // reached Name::MAX_LENGTH
+            }
+        }
+        name.set_fqdn(tc.draw(generators::booleans()));
+        name
+    }
+
+    /// Rebuild `name` with the ASCII case of letters flipped according to drawn booleans.
+    fn draw_case_flipped(tc: &hegel::TestCase, name: &Name) -> Name {
+        let mut flipped = Name::new();
+        for label in name.iter() {
+            let mut label = label.to_vec();
+            for b in label.iter_mut() {
+                if b.is_ascii_alphabetic() && tc.draw(generators::booleans()) {
+                    *b ^= 0x20;
+                }
+            }
+            flipped = flipped
+                .append_label(label.as_slice())
+                .expect("flipped label has the same length as the original");
+        }
+        flipped.set_fqdn(name.is_fqdn());
+        flipped
+    }
+
+    /// Property: a Name emitted to wire format reads back as the same name.
+    ///
+    /// Evidence: `test_read`/`test_write_to` above check this for four fixed examples;
+    /// `Name::encoded_len` documents that `is_fqdn` is ignored on the wire (every wire
+    /// name is terminated by the root label), so the decoded name is always an FQDN.
+    #[hegel::test]
+    fn hegel_name_wire_roundtrip(tc: hegel::TestCase) {
+        let name = tc.draw((arbitrary_name()).print_as_debug());
+
+        let mut bytes = Vec::new();
+        let mut encoder = BinEncoder::new(&mut bytes);
+        name.emit(&mut encoder)
+            .expect("emitting a valid name should succeed");
+
+        let mut decoder = BinDecoder::new(&bytes);
+        let decoded = Name::read(&mut decoder).expect("reading back an emitted name");
+
+        let mut expected = name;
+        expected.set_fqdn(true);
+        assert!(
+            decoded.eq_case(&expected),
+            "decoded {decoded:?} != original {expected:?}"
+        );
+    }
+
+    /// Names drawn from a small shared label pool, so shared suffixes (and therefore
+    /// compression pointers) are common.
+    #[hegel::composite]
+    fn shared_suffix_names(tc: &hegel::TestCase) -> Vec<Name> {
+        let pool: Vec<Vec<u8>> =
+            tc.draw(generators::vecs(arbitrary_label()).min_size(1).max_size(6));
+        let count = tc.draw(generators::integers::<usize>().min_value(1).max_value(10));
+        let mut names = Vec::with_capacity(count);
+        for _ in 0..count {
+            let num_labels = tc.draw(generators::integers::<usize>().max_value(8));
+            let mut name = Name::new();
+            for _ in 0..num_labels {
+                let label = tc.draw(generators::sampled_from(pool.clone()));
+                match name.clone().append_label(label.as_slice()) {
+                    Ok(extended) => name = extended,
+                    Err(_) => break,
+                }
+            }
+            name.set_fqdn(true);
+            names.push(name);
+        }
+        names
+    }
+
+    /// Property: emitting many (frequently suffix-sharing) names through one encoder —
+    /// which exercises name compression, on by default — and decoding them in order
+    /// returns the original names, byte-for-byte including ASCII case.
+    ///
+    /// Evidence: `test_pointer` and `test_pointer_with_pointer_ending_labels` above;
+    /// `BinEncoder::get_label_pointer` matches candidate labels byte-exactly, so
+    /// compression must preserve case.
+    #[hegel::test]
+    fn hegel_name_compression_roundtrip(tc: hegel::TestCase) {
+        let names = tc.draw((shared_suffix_names()).print_as_debug());
+
+        let mut bytes = Vec::new();
+        let mut encoder = BinEncoder::new(&mut bytes);
+        for name in &names {
+            name.emit(&mut encoder)
+                .expect("emitting a valid name should succeed");
+        }
+
+        let mut decoder = BinDecoder::new(&bytes);
+        for name in &names {
+            let decoded = Name::read(&mut decoder).expect("reading back an emitted name");
+            assert!(
+                decoded.eq_case(name),
+                "decoded {decoded:?} != original {name:?}"
+            );
+        }
+    }
+
+    /// Property: `Name::read` never panics, whatever bytes it is fed.
+    ///
+    /// Evidence: the repository's fuzz targets decode messages from arbitrary bytes;
+    /// `test_recursive_pointer`/`test_bin_overlap_enforced` above show hostile inputs
+    /// are expected to produce `Err`, not panics.
+    #[hegel::test]
+    fn hegel_name_read_never_panics(tc: hegel::TestCase) {
+        // Arbitrary bytes, biased toward wire-format markers (pointers, label lengths).
+        let bytes: Vec<u8> = tc.draw(hegel::one_of!(
+            generators::binary(),
+            generators::vecs(generators::sampled_from(vec![
+                0x00u8, 0x01, 0x02, 0x3F, 0x40, 0x80, 0xC0, 0xC1, 0xFF, b'a',
+            ])),
+        ));
+        let mut decoder = BinDecoder::new(&bytes);
+        let _ = Name::read(&mut decoder); // must return Ok or Err, never panic
+    }
+
+    /// Property: `Name::from_ascii` parses `Name::to_ascii` output back to the same
+    /// name (case-sensitively, preserving the FQDN flag).
+    ///
+    /// Evidence: `to_ascii` escapes exactly so the name can be represented as a safe
+    /// string (`test_ascii_escape` above), `from_ascii`'s doc examples parse escaped
+    /// labels (`bad\056char`), and `to_utf8` documents that the output "could be used
+    /// with parse".
+    #[hegel::test]
+    fn hegel_name_to_ascii_from_ascii_roundtrip(tc: hegel::TestCase) {
+        let name = tc.draw((arbitrary_name()).print_as_debug());
+        let ascii = name.to_ascii();
+        let parsed = Name::from_ascii(&ascii).unwrap_or_else(|e| {
+            panic!("from_ascii failed on to_ascii output {ascii:?} of {name:?}: {e}")
+        });
+        assert!(
+            parsed.eq_case(&name),
+            "parsed {parsed:?} != original {name:?} (via {ascii:?})"
+        );
+        assert_eq!(parsed.is_fqdn(), name.is_fqdn());
+    }
+
+    /// Weaker version of the property above, restricted to labels made of characters
+    /// that `Label::from_ascii` accepts unescaped (`is_safe_ascii`), plus embedded
+    /// dots, which exercise the `\.` escape. This pins down the subset of the
+    /// presentation-format round-trip that does hold.
+    #[hegel::test]
+    fn hegel_name_to_ascii_from_ascii_roundtrip_safe_labels(tc: hegel::TestCase) {
+        let alphanumeric_or_underscore: Vec<u8> = (b'a'..=b'z')
+            .chain(b'A'..=b'Z')
+            .chain(b'0'..=b'9')
+            .chain([b'_'])
+            .collect();
+        let with_punctuation: Vec<u8> = alphanumeric_or_underscore
+            .iter()
+            .copied()
+            .chain([b'-', b'.'])
+            .collect();
+
+        let num_labels = tc.draw(generators::integers::<usize>().max_value(6));
+        let mut name = Name::new();
+        for _ in 0..num_labels {
+            // first char must not be '-' ('-' is only safe when not first)
+            let first = tc.draw(generators::sampled_from(
+                alphanumeric_or_underscore.clone(),
+            ));
+            let rest: Vec<u8> = tc.draw(
+                generators::vecs(generators::sampled_from(with_punctuation.clone()))
+                    .max_size(20),
+            );
+            let label: Vec<u8> = core::iter::once(first).chain(rest).collect();
+            match name.clone().append_label(label.as_slice()) {
+                Ok(extended) => name = extended,
+                Err(_) => break,
+            }
+        }
+        name.set_fqdn(tc.draw(generators::booleans()));
+
+        let ascii = name.to_ascii();
+        let parsed = Name::from_ascii(&ascii).unwrap_or_else(|e| {
+            panic!("from_ascii failed on to_ascii output {ascii:?} of {name:?}: {e}")
+        });
+        assert!(
+            parsed.eq_case(&name),
+            "parsed {parsed:?} != original {name:?} (via {ascii:?})"
+        );
+        assert_eq!(parsed.is_fqdn(), name.is_fqdn());
+    }
+
+    /// Independent implementation of RFC 4034 §6.1 canonical DNS name order (quoted in
+    /// the `Ord for Name` docs), plus the FQDN rule from `cmp_with_f` (a relative name
+    /// sorts before a fully-qualified one).
+    fn rfc4034_reference_cmp(a: &Name, b: &Name) -> Ordering {
+        match (a.is_fqdn(), b.is_fqdn()) {
+            (false, true) => Ordering::Less,
+            (true, false) => Ordering::Greater,
+            _ => {
+                let key = |n: &Name| -> Vec<Vec<u8>> {
+                    n.iter().rev().map(|l| l.to_ascii_lowercase()).collect()
+                };
+                key(a).cmp(&key(b))
+            }
+        }
+    }
+
+    /// Property: `Name::cmp` agrees with an independently written RFC 4034 §6.1
+    /// reference comparison.
+    ///
+    /// Evidence: the RFC text quoted on `Ord for Name`, and `test_partial_cmp` above.
+    #[hegel::test]
+    fn hegel_name_cmp_matches_rfc4034_reference(tc: hegel::TestCase) {
+        // Both names come from a small shared pool so equal labels and shared
+        // suffixes (the interesting comparisons) are common.
+        let pool: Vec<Vec<u8>> =
+            tc.draw(generators::vecs(arbitrary_label()).min_size(1).max_size(4));
+        let draw_name = |tc: &hegel::TestCase| -> Name {
+            let num_labels = tc.draw(generators::integers::<usize>().max_value(5));
+            let mut name = Name::new();
+            for _ in 0..num_labels {
+                let label = tc.draw(generators::sampled_from(pool.clone()));
+                match name.clone().append_label(label.as_slice()) {
+                    Ok(extended) => name = extended,
+                    Err(_) => break,
+                }
+            }
+            name.set_fqdn(tc.draw(generators::booleans()));
+            name
+        };
+        let a = draw_case_flipped(&tc, &draw_name(&tc));
+        let b = draw_case_flipped(&tc, &draw_name(&tc));
+
+        assert_eq!(
+            a.cmp(&b),
+            rfc4034_reference_cmp(&a, &b),
+            "a={a:?} b={b:?}"
+        );
+    }
+
+    /// Property: names that differ only in ASCII letter case are equal and hash
+    /// identically.
+    ///
+    /// Evidence: `PartialEq for Name` is case-insensitive, and `Hash for Name` says
+    /// "Note: case-insensitive like `PartialEq`" — Eq/Hash consistency is required
+    /// for use as `HashMap` keys.
+    #[cfg(feature = "std")]
+    #[hegel::test]
+    fn hegel_name_case_insensitive_eq_implies_hash_eq(tc: hegel::TestCase) {
+        let name = tc.draw((arbitrary_name()).print_as_debug());
+        let flipped = draw_case_flipped(&tc, &name);
+
+        assert_eq!(name, flipped);
+
+        let hash = |n: &Name| {
+            let mut hasher = DefaultHasher::new();
+            n.hash(&mut hasher);
+            hasher.finish()
+        };
+        assert_eq!(hash(&name), hash(&flipped), "{name:?} vs {flipped:?}");
+    }
+
+    /// Property: any trailing part of a name (as produced by `trim_to`) is a zone of
+    /// the name, even when its ASCII case differs.
+    ///
+    /// Evidence: `zone_of` docs ("returns true if the name components of self are all
+    /// present at the end of name") and its use of `eq_ignore_ascii_case`;
+    /// `trim_to` docs show it keeps the trailing labels.
+    #[hegel::test]
+    fn hegel_name_trim_to_is_zone_of(tc: hegel::TestCase) {
+        let name = tc.draw((arbitrary_name()).print_as_debug());
+        let num_labels = name.iter().count();
+        let k = tc.draw(generators::integers::<usize>().max_value(num_labels));
+        let zone = draw_case_flipped(&tc, &name.trim_to(k));
+        assert!(zone.zone_of(&name), "zone={zone:?} name={name:?} k={k}");
+    }
+
+    /// Property: converting an IP address to its reverse-DNS name parses back to the
+    /// same address with a full-length prefix.
+    ///
+    /// Evidence: `From<Ipv4Addr>/From<Ipv6Addr> for Name` and `parse_arpa_name` are
+    /// documented as a conversion pair; `test_from_ipv4`/`test_from_ipv6` and
+    /// `test_parse_arpa_name` above check fixed examples.
+    #[hegel::test]
+    fn hegel_ip_to_arpa_name_parses_back(tc: hegel::TestCase) {
+        let (ip, expected_prefix) = if tc.draw(generators::booleans()) {
+            (
+                IpAddr::V4(Ipv4Addr::from(tc.draw(generators::integers::<u32>()))),
+                32,
+            )
+        } else {
+            (
+                IpAddr::V6(Ipv6Addr::from(tc.draw(generators::integers::<u128>()))),
+                128,
+            )
+        };
+        let name = Name::from(ip);
+        let net = name
+            .parse_arpa_name()
+            .expect("arpa name built from an IP address should parse back");
+        assert_eq!(net.addr(), ip);
+        assert_eq!(net.prefix_len(), expected_prefix);
+    }
+
+    /// Property: `Name::from_str_relaxed` (the `FromStr` impl) never panics on
+    /// arbitrary text.
+    ///
+    /// Evidence: `FromStr` is the crate's user-facing string entry point (used by
+    /// `IntoName for &str`); parsers returning `Result` promise Err, not panics.
+    #[hegel::test]
+    fn hegel_name_from_str_relaxed_never_panics(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::text());
+        let _ = Name::from_str_relaxed(&s); // must return Ok or Err, never panic
+    }
 }
