+#[hegel::test]
+fn stream_id_roundtrip(tc: hegel::TestCase) {
+    use hegel::generators;
+    use hegel::Generator;
+    let side = tc.draw((generators::sampled_from(vec![Side::Client, Side::Server])).print_as_debug());
+    let dir = tc.draw((generators::sampled_from(vec![Dir::Bi, Dir::Uni])).print_as_debug());
