+// Stateful model test for the streaming Encoder: appending arbitrary fragments and
+// finalizing must produce exactly the same output as encoding the concatenation of all
+// fragments in one call. Evidence: Encoder docs ("It is equivalent to use an Encoder with
+// multiple calls to append() ... In particular, this function will not introduce padding or
+// wrapping between inputs") and the impl_new_encoder fuzz target.
+struct EncoderMachine<'a> {
+    encoder: data_encoding::Encoder<'a>,
+    full: &'a mut Vec<u8>,
+}
+
+#[hegel::state_machine]
+impl EncoderMachine<'_> {
+    #[rule]
+    fn append(&mut self, tc: hegel::TestCase) {
+        // Draw the size separately so fragments larger than the encoder's internal
+        // 255-byte buffer and block length are exercised.
+        let n = tc.draw(generators::integers::<usize>().max_value(600));
+        let chunk: Vec<u8> = tc.draw(generators::binary().min_size(n).max_size(n));
+        self.encoder.append(&chunk);
+        self.full.extend_from_slice(&chunk);
+    }
+
+    #[rule]
+    fn append_empty(&mut self, _: hegel::TestCase) {
+        self.encoder.append(b"");
+    }
+}
+
+#[hegel::test(test_cases = 500)]
+fn prop_encoder_stateful_matches_batch_encode(tc: hegel::TestCase) {
+    let spec = tc.draw((specs(false)).print_as_debug());
+    let encoding = spec.encoding().unwrap();
+    let mut output = String::new();
+    let mut full = Vec::new();
+    let machine =
+        EncoderMachine { encoder: encoding.new_encoder(&mut output), full: &mut full };
+    hegel::stateful::machine(machine).run(tc);
+    // Dropping the machine (inside run) finalizes the encoder.
+    assert_eq!(output, encoding.encode(&full), "spec = {:?}", spec);
+}
