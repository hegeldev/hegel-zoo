+/// Generates a *canonical* `Specification`: unique ASCII symbols for one of the given
+/// bit-widths, either bit-order, trailing bits checked (the default), and no padding, ignored
+/// characters, wrapping, or translation. `Encoding::is_canonical` holds for these.
+#[hegel::composite]
+fn canonical_specs(tc: &hegel::TestCase, bits: Vec<usize>) -> Specification {
+    let bit: usize = tc.draw(generators::sampled_from(bits.clone()));
+    let n = 1usize << bit;
+    let symbols: Vec<u8> = tc.draw(
+        generators::vecs(generators::integers::<u8>().max_value(127))
+            .min_size(n)
+            .max_size(n)
+            .unique(true),
+    );
+    let mut spec = Specification::new();
+    for &s in &symbols {
+        spec.symbols.push(s as char);
+    }
+    if tc.draw(generators::booleans()) {
+        spec.bit_order = data_encoding::BitOrder::LeastSignificantFirst;
+    }
+    spec
+}
+
+// Property: decode-then-encode roundtrip for canonical encodings. Encoded strings are drawn
+// directly from the symbol alphabet (not produced by encode) at a valid length; every string
+// the decoder accepts must re-encode to exactly itself (it is the canonical form), and the
+// only permissible rejection is Trailing at the last position (a valid-length pure-symbol
+// string cannot fail any other way). Evidence: crate docs "They are canonical (unless
+// is_canonical returns false): decoding followed by encoding gives the initial data", and
+// "the decoding function of canonical encodings rejects all inputs that are not a possible
+// output of the encoding function".
+#[hegel::test(test_cases = 1000)]
+fn prop_decode_encode_canonical_roundtrip(tc: hegel::TestCase) {
+    let spec = tc.draw((canonical_specs(vec![1, 2, 3, 4, 5, 6])).print_as_debug());
+    let e = spec.encoding().unwrap();
+    assert!(e.is_canonical());
+    let symbols: Vec<u8> = spec.symbols.bytes().collect();
+    let m = tc.draw(generators::integers::<usize>().max_value(64));
+    // Every valid input length is the encoded length of some data length, so sweeping over
+    // data lengths m covers exactly the valid lengths (including partial final groups).
+    let len = e.encode_len(m);
+    let input: Vec<u8> =
+        tc.draw(generators::vecs(generators::sampled_from(symbols)).min_size(len).max_size(len));
+    match e.decode(&input) {
+        Ok(data) => {
+            assert_eq!(e.encode(&data).as_bytes(), &input[..], "spec = {:?}", spec);
+        }
+        Err(err) => {
+            assert_eq!(err, DecodeError { position: len - 1, kind: Trailing }, "spec = {:?}", spec);
+        }
+    }
+}
+
+// Property: trailing-bits canonicality. For every non-canonical spelling of some data (same
+// significant bits, non-zero trailing bits in the last symbol — there are exactly 2^t - 1 of
+// them differing in the last symbol, where t is the number of trailing bits), a canonical
+// encoding rejects it with Trailing at the last position, while the identical encoding with
+// check_trailing_bits = false accepts it and decodes it to the same data. Accepting such
+// spellings is the classic base-N malleability bug the crate documents ("non-canonical
+// encodings may be an attack vector", Base64 Malleability in Practice). Evidence: the
+// check_trailing_bits docs, the trailing_bits unit test, and the doc table entry
+// `AAB=` -> `Trailing(2)`.
+#[hegel::test(test_cases = 500)]
+fn prop_trailing_bits_noncanonical_spellings_rejected(tc: hegel::TestCase) {
+    // Only bit-widths that do not divide 8 produce partial final groups.
+    let spec = tc.draw((canonical_specs(vec![3, 5, 6])).print_as_debug());
+    let strict = spec.encoding().unwrap();
+    let mut permissive_spec = spec.clone();
+    permissive_spec.check_trailing_bits = false;
+    let permissive = permissive_spec.encoding().unwrap();
+    let bit = spec.symbols.len().trailing_zeros() as usize;
+    // Pick a data length whose encoding ends in a partial group (has trailing bits).
+    let mut n = tc.draw(generators::integers::<usize>().min_value(1).max_value(64));
+    if 8 * n % bit == 0 {
+        n += 1;
+    }
+    assert_ne!(8 * n % bit, 0);
+    let data: Vec<u8> = tc.draw(generators::binary().min_size(n).max_size(n));
+    let encoded = strict.encode(&data).into_bytes();
+    let last = encoded.len() - 1;
+    let t = bit - 8 * n % bit; // number of trailing bits in the last symbol
+    let mut noncanonical = 0;
+    for &s in spec.symbols.as_bytes() {
+        if s == encoded[last] {
+            continue;
+        }
+        let mut candidate = encoded.clone();
+        candidate[last] = s;
+        if permissive.decode(&candidate).as_deref() == Ok(&data[..]) {
+            // Same data, different spelling: only the trailing bits differ.
+            noncanonical += 1;
+            assert_eq!(
+                strict.decode(&candidate),
+                Err(DecodeError { position: last, kind: Trailing }),
+                "spec = {:?} candidate = {:?}",
+                spec,
+                candidate
+            );
+        }
+    }
+    assert_eq!(noncanonical, (1 << t) - 1, "spec = {:?}", spec);
+}
+
+// Property (validation/rejection): overwriting one character of a valid encoding with a byte
+// the encoding does not assign (interpret_byte == Invalid) makes decode fail — it never
+// accepts and never panics — with an in-bounds error position. Without ignored characters
+// and padding, the error is Symbol at exactly the corrupted position; with padding it may
+// also be diagnosed as an invalid padding length. Evidence: DecodeKind::Symbol docs, the
+// decode_base/decode_pad unit tests, DecodeError::position docs ("always a valid input
+// position ... the first encountered error"), and the crate's decoding-differences table
+// (which shows ignored characters turning Symbol errors into Length errors).
+#[hegel::test(test_cases = 1000)]
+fn prop_corrupt_one_char_rejected(tc: hegel::TestCase) {
+    let e = tc.draw((any_encoding()).print_as_debug());
+    let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(64));
+    let data: Vec<u8> = tc.draw(generators::binary().min_size(n).max_size(n));
+    let mut encoded = e.encode(&data).into_bytes();
+    let pos = tc.draw(generators::integers::<usize>().max_value(encoded.len() - 1));
+    let junk: u8 =
+        tc.draw(generators::integers::<u8>().filter(|&b| e.interpret_byte(b).is_invalid()));
+    encoded[pos] = junk;
+    let spec = e.specification();
+    let err = e.decode(&encoded).expect_err("corrupted input accepted");
+    assert!(err.position < encoded.len(), "spec = {:?} err = {:?}", spec, err);
+    if spec.ignore.is_empty() && spec.wrap.separator.is_empty() {
+        if spec.padding.is_none() {
+            assert_eq!(err, DecodeError { position: pos, kind: Symbol }, "spec = {:?}", spec);
+        } else {
+            // With padding, a corrupted block may be diagnosed as an invalid padding length
+            // instead of an invalid symbol, at a position after the corrupted one: BASE32
+            // "AA\x00=====" reports Padding at 3, exactly like the base32_error unit test's
+            // "MAA=====". Both kinds are documented; the error kind priority is not.
+            assert!(
+                err.kind == Symbol || err.kind == Padding,
+                "spec = {:?} err = {:?} pos = {}",
+                spec,
+                err,
+                pos
+            );
+        }
+    }
+}
+
+// Property (validation/rejection): truncating between 1 and block-1 trailing characters from
+// a padded encoding's output yields a Length error whose position is the greatest valid
+// input length (the largest block multiple not exceeding the truncated length). Evidence:
+// decode docs ("Length if the input length is invalid", "the position is the greatest valid
+// input length") and the base32_error/base64_error unit tests (BASE64 "AAAAA" -> Length(4)).
+#[hegel::test(test_cases = 500)]
+fn prop_truncated_padded_rejected(tc: hegel::TestCase) {
+    // Padding requires a bit-width that does not divide 8. No ignore/wrap so that input
+    // positions and lengths coincide with symbol counts.
+    let mut spec = tc.draw((canonical_specs(vec![3, 5, 6])).print_as_debug());
+    let symbols: Vec<u8> = spec.symbols.bytes().collect();
+    let free: Vec<u8> = (0u8 .. 128).filter(|b| !symbols.contains(b)).collect();
+    let i = tc.draw(generators::integers::<usize>().max_value(free.len() - 1));
+    spec.padding = Some(free[i] as char);
+    let e = spec.encoding().unwrap();
+    let bit = symbols.len().trailing_zeros() as usize;
+    let block = match bit {
+        3 | 5 => 8,
+        6 => 4,
+        _ => unreachable!(),
+    };
+    let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(64));
+    let data: Vec<u8> = tc.draw(generators::binary().min_size(n).max_size(n));
+    let encoded = e.encode(&data).into_bytes();
+    assert_eq!(encoded.len() % block, 0, "spec = {:?}", spec);
+    let cut = tc.draw(generators::integers::<usize>().min_value(1).max_value(block - 1));
+    let truncated = &encoded[.. encoded.len() - cut];
+    let err = e.decode(truncated).expect_err("truncated padded input accepted");
+    assert_eq!(err.kind, Length, "spec = {:?} err = {:?}", spec, err);
+    assert_eq!(err.position, truncated.len() - truncated.len() % block, "spec = {:?}", spec);
+}
+
+// Property: padding correctness of encode output. Encodings without padding emit only symbol
+// characters (in particular the NOPAD predefined variants never emit '='); padded encodings
+// emit output whose (separator-stripped) length is a multiple of the block length, with
+// padding characters appearing only as a final run strictly shorter than one block.
+// Evidence: RFC 4648 section 3.2 padding rules (BASE32/BASE64 conform per the crate docs),
+// the encode_base/encode_pad unit tests, and the Specification::padding docs.
+#[hegel::test(test_cases = 500)]
+fn prop_encode_padding_shape(tc: hegel::TestCase) {
+    let e = tc.draw((any_encoding()).print_as_debug());
+    let spec = e.specification();
+    let symbols: Vec<u8> = spec.symbols.bytes().collect();
+    let x: Vec<u8> = tc.draw(sized_binary(256));
+    let encoded = e.encode(&x);
+    // Wrapping separator characters may appear anywhere the wrap column falls; strip them.
+    let sep: Vec<u8> = spec.wrap.separator.bytes().collect();
+    let stripped: Vec<u8> = encoded.bytes().filter(|b| !sep.contains(b)).collect();
+    match spec.padding {
+        None => {
+            assert!(
+                stripped.iter().all(|b| symbols.contains(b)),
+                "non-symbol in unpadded output: spec = {:?} encoded = {:?}",
+                spec,
+                encoded
+            );
+        }
+        Some(pad) => {
+            let pad = pad as u8;
+            let bit = symbols.len().trailing_zeros() as usize;
+            let block = match bit {
+                3 | 5 => 8,
+                6 => 4,
+                _ => unreachable!("padding is only valid when the bit-width does not divide 8"),
+            };
+            assert_eq!(stripped.len() % block, 0, "spec = {:?} encoded = {:?}", spec, encoded);
+            let run = stripped.iter().rev().take_while(|&&b| b == pad).count();
+            assert!(run < block, "spec = {:?} encoded = {:?}", spec, encoded);
+            assert!(
+                stripped[.. stripped.len() - run].iter().all(|b| symbols.contains(b)),
+                "padding before the final run: spec = {:?} encoded = {:?}",
+                spec,
+                encoded
+            );
+        }
+    }
+}
+
+// Property: the buffer-based encode_mut writes exactly the bytes of the allocating encode
+// (buffer-API differential; the decode-side differential is prop_decode_mut_partial_contract).
+// Evidence: encode_mut docs and example ("This is the most efficient encoding function"),
+// whose output is specified to equal encode's.
+#[hegel::test(test_cases = 500)]
+fn prop_encode_mut_matches_encode(tc: hegel::TestCase) {
+    let e = tc.draw((any_encoding()).print_as_debug());
+    let x: Vec<u8> = tc.draw(sized_binary(1024));
+    let mut out = vec![0u8; e.encode_len(x.len())];
+    e.encode_mut(&x, &mut out);
+    assert_eq!(out, e.encode(&x).into_bytes());
+}
