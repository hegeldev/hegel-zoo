+// Property: decode_mut() partial decoding contract. On error, `read <= error.position`, and
+// the `read` first input bytes decode successfully to exactly the `written` first output
+// bytes. Evidence: DecodePartial field docs and decode_mut docs ("The read first bytes of the
+// input have been successfully decoded to the written first bytes of the output"). Also
+// checks the decode_len error contract: the reported position is the greatest valid length.
+#[hegel::test(test_cases = 1000)]
+fn prop_decode_mut_partial_contract(tc: hegel::TestCase) {
+    let e = tc.draw((any_encoding()).print_as_debug());
+    let spec = e.specification();
+    let mut alphabet: Vec<u8> = spec.symbols.bytes().collect();
+    alphabet.extend(spec.padding.map(|c| c as u8));
+    alphabet.extend(spec.ignore.bytes());
+    alphabet.extend(spec.wrap.separator.bytes());
+    let n = tc.draw(generators::integers::<usize>().max_value(300));
+    let mut input: Vec<u8> = tc.draw(
+        generators::vecs(generators::sampled_from(alphabet.clone())).min_size(n).max_size(n),
+    );
+    if let Err(err) = e.decode_len(input.len()) {
+        assert_eq!(err.kind, Length);
+        assert!(err.position <= input.len());
+        // The position is documented to be the greatest valid input length.
+        input.truncate(err.position);
+    }
+    let olen = e.decode_len(input.len()).unwrap();
+    let mut out = vec![0; olen];
+    match e.decode_mut(&input, &mut out) {
+        Ok(written) => {
+            assert!(written <= olen);
+            assert_eq!(e.decode(&input).unwrap(), &out[.. written]);
+        }
+        Err(partial) => {
+            assert!(partial.read <= partial.error.position, "{:?}", partial);
+            assert!(partial.error.position < input.len(), "{:?}", partial);
+            let prefix = e.decode(&input[.. partial.read]).unwrap();
+            assert_eq!(&prefix[..], &out[.. partial.written], "{:?}", partial);
+        }
+    }
+}
