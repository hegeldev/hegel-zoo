+/// Generates an arbitrary valid `Specification` covering all bit-widths, both bit-orders,
+/// optional padding, ignored characters, wrapping, and character translation.
+///
+/// The construction mirrors the validity rules documented on `Specification`: symbols are
+/// unique ASCII, the padding character is ASCII and not a symbol, ignored/wrapping characters
+/// are ASCII and not symbols or padding, translation sources are unassigned ASCII characters
+/// and translation targets are assigned ones (symbols or padding).
+#[hegel::composite]
+fn specs(tc: &hegel::TestCase, force_padding: bool) -> Specification {
+    let bit: usize = if force_padding {
+        // Padding is only meaningful (and only valid) when the bit-width does not divide 8.
+        tc.draw(generators::sampled_from(vec![3usize, 5, 6]))
+    } else {
+        tc.draw(generators::sampled_from(vec![1usize, 2, 3, 4, 5, 6]))
+    };
+    let n = 1usize << bit;
+    let symbols: Vec<u8> = tc.draw(
+        generators::vecs(generators::integers::<u8>().max_value(127))
+            .min_size(n)
+            .max_size(n)
+            .unique(true),
+    );
+    let mut spec = Specification::new();
+    for &s in &symbols {
+        spec.symbols.push(s as char);
+    }
+    if tc.draw(generators::booleans()) {
+        spec.bit_order = data_encoding::BitOrder::LeastSignificantFirst;
+    }
+    spec.check_trailing_bits = tc.draw(generators::booleans());
+    // ASCII characters without an assigned semantics so far.
+    let mut free: Vec<u8> = (0u8 .. 128).filter(|b| !symbols.contains(b)).collect();
+    if force_padding || (8 % bit != 0 && tc.draw(generators::booleans())) {
+        let i = tc.draw(generators::integers::<usize>().max_value(free.len() - 1));
+        spec.padding = Some(free.remove(i) as char);
+    }
+    if tc.draw(generators::booleans()) {
+        let count = tc.draw(generators::integers::<usize>().max_value(3));
+        for _ in 0 .. count {
+            let i = tc.draw(generators::integers::<usize>().max_value(free.len() - 1));
+            spec.ignore.push(free.remove(i) as char);
+        }
+    }
+    if tc.draw(generators::booleans()) {
+        // The wrap width must be a positive multiple of the decoded block length and < 256.
+        let dec = match bit {
+            1 | 3 | 5 => 8,
+            2 | 6 => 4,
+            4 => 2,
+            _ => unreachable!(),
+        };
+        let width = dec * tc.draw(generators::integers::<usize>().min_value(1).max_value(255 / dec));
+        let sep_len = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+        spec.wrap.width = width;
+        for _ in 0 .. sep_len {
+            let i = tc.draw(generators::integers::<usize>().max_value(free.len() - 1));
+            spec.wrap.separator.push(free.remove(i) as char);
+        }
+    }
+    if tc.draw(generators::booleans()) {
+        // Translation targets may be any character with an assigned semantics: a symbol, the
+        // padding character, or an ignored character (including wrapping separator characters).
+        let mut targets: Vec<u8> = symbols.clone();
+        if let Some(pad) = spec.padding {
+            targets.push(pad as u8);
+        }
+        targets.extend(spec.ignore.bytes());
+        targets.extend(spec.wrap.separator.bytes());
+        let count = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+        for _ in 0 .. count {
+            let i = tc.draw(generators::integers::<usize>().max_value(free.len() - 1));
+            let from = free.remove(i);
+            let to = tc.draw(generators::sampled_from(targets.clone()));
+            spec.translate.from.push(from as char);
+            spec.translate.to.push(to as char);
+        }
+    }
+    spec
+}
