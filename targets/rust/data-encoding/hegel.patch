+// Property: decode() never panics on arbitrary input, and on failure the error position is a
+// valid input position. Evidence: DecodeError docs "This position is always a valid input
+// position and represents the first encountered error". The input mixes raw garbage with
+// bytes from the encoding's own alphabet to reach deep decoding paths.
+#[hegel::test(test_cases = 1000)]
+fn prop_decode_arbitrary_input_error_position(tc: hegel::TestCase) {
+    let e = tc.draw((any_encoding()).print_as_debug());
+    let spec = e.specification();
+    let mut alphabet: Vec<u8> = spec.symbols.bytes().collect();
+    alphabet.extend(spec.padding.map(|c| c as u8));
+    alphabet.extend(spec.ignore.bytes());
+    alphabet.extend(spec.wrap.separator.bytes());
+    let n = tc.draw(generators::integers::<usize>().max_value(300));
+    let input: Vec<u8> = tc.draw(
+        generators::vecs(hegel::one_of!(
+            generators::sampled_from(alphabet.clone()),
+            generators::integers::<u8>(),
+        ))
+        .min_size(n)
+        .max_size(n),
+    );
+    match e.decode(&input) {
+        Ok(_) => (),
+        Err(err) => {
+            assert!(
+                err.position < input.len(),
+                "error {:?} out of bounds for input of length {}",
+                err,
+                input.len()
+            );
+        }
+    }
+}
