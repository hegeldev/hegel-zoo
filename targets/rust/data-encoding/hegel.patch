+/// Draws either a predefined encoding or an arbitrary custom one.
+#[hegel::composite]
+fn any_encoding(tc: &hegel::TestCase) -> Encoding {
+    if tc.draw(generators::booleans()) {
+        tc.draw((generators::sampled_from(predefined_encodings())).print_as_debug())
+    } else {
+        tc.draw((specs(false)).print_as_debug()).encoding().unwrap()
+    }
+}
+
+/// Draws a byte string of size up to `max` with a uniformly drawn target size, so that large
+/// inputs (crossing wrapping columns and internal block boundaries) are actually exercised.
+#[hegel::composite]
+fn sized_binary(tc: &hegel::TestCase, max: usize) -> Vec<u8> {
+    let n = tc.draw(generators::integers::<usize>().max_value(max));
+    tc.draw(generators::binary().min_size(n).max_size(n))
+}
