+// Property: interpret_byte classifies every byte consistently with the specification the
+// encoding was built from: symbols map to their value, the padding character to Padding,
+// ignored and wrapping characters to Ignored, translated characters to the same
+// interpretation as their target, and all non-ASCII bytes to Invalid. Evidence:
+// interpret_byte/Character docs and the Specification field docs.
+#[hegel::test(test_cases = 500)]
+fn prop_interpret_byte_consistent_with_specification(tc: hegel::TestCase) {
+    let spec = tc.draw((specs(false)).print_as_debug());
+    let e = spec.encoding().unwrap();
+    for (i, s) in spec.symbols.bytes().enumerate() {
+        assert_eq!(e.interpret_byte(s).is_symbol(), Some(i), "symbol {:?}", s as char);
+    }
+    if let Some(pad) = spec.padding {
+        assert!(e.interpret_byte(pad as u8).is_padding());
+    }
+    for c in spec.ignore.bytes() {
+        assert!(e.interpret_byte(c).is_ignored(), "ignore {:?}", c as char);
+    }
+    for c in spec.wrap.separator.bytes() {
+        assert!(e.interpret_byte(c).is_ignored(), "separator {:?}", c as char);
+    }
+    for (from, to) in spec.translate.from.bytes().zip(spec.translate.to.bytes()) {
+        assert_eq!(e.interpret_byte(from), e.interpret_byte(to), "translate {:?}", from as char);
+    }
+    for b in 128 ..= 255u8 {
+        assert!(e.interpret_byte(b).is_invalid(), "byte {}", b);
+    }
+}
