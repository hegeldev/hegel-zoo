+        let lines = wrap_first_fit(&fragments, &line_widths);
+
+        // The lines partition the fragments in order.
+        let flattened: Vec<Frag> = lines.iter().flat_map(|line| line.iter().copied()).collect();
+        assert_eq!(flattened, fragments);
+
+        // Every line fits, except that a lone (first) fragment may
+        // overflow its line.
+        let default_line_width = line_widths.last().copied().unwrap_or(0.0);
+        for (i, line) in lines.iter().enumerate() {
+            let target = line_widths.get(i).copied().unwrap_or(default_line_width);
+            if line.len() < 2 {
+                continue;
+            }
+            let mut acc = 0.0;
+            for (k, frag) in line.iter().enumerate() {
+                if k + 1 == line.len() {
+                    assert!(
+                        acc + frag.width + frag.penalty_width <= target,
+                        "line {} does not fit target {}: {:?}",
+                        i,
+                        target,
+                        line
+                    );
+                } else {
+                    acc += frag.width + frag.whitespace_width;
+                }
+            }
+        }
+    }
