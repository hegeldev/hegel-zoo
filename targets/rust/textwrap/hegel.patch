+        if tc.draw(generators::booleans()) {
+            text.push('\n');
+        }
+
+        let indented = indent(&text, &prefix);
+        assert_eq!(
+            dedent(&indented),
+            text,
+            "prefix: {:?}, indented: {:?}",
+            prefix,
+            indented
+        );
+    }
