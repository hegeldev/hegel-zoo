+        let word = Word::from(&s);
+        let line_width = tc.draw(generators::integers::<usize>().max_value(10));
+
+        let pieces: Vec<Word<'_>> = word.break_apart(line_width).collect();
+        let mut content = String::new();
+        for (i, piece) in pieces.iter().enumerate() {
+            content.push_str(piece.word);
+            assert_eq!(
+                piece.width,
+                display_width(piece.word),
+                "cached width is wrong for piece {:?}",
+                piece
+            );
+            assert!(
+                piece.width <= line_width.max(2),
+                "piece {:?} is wider than {}",
+                piece,
