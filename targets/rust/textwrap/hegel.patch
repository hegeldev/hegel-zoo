+/// Shared generators for the hegel property-based tests in this crate.
+#[cfg(test)]
+pub(crate) mod hegel_helpers {
+    use crate::{LineEnding, Options, WordSeparator, WordSplitter, WrapAlgorithm};
+    use hegel::generators;
+    use hegel::Generator;
+
+    /// A piece of text mixing ASCII words, hyphenated words, runs of
+    /// spaces, newlines, CJK, emoji, fullwidth chars, combining marks,
+    /// ANSI escape sequences and arbitrary Unicode from `text()`.
+    #[hegel::composite]
+    pub(crate) fn wrappable_text(tc: &hegel::TestCase) -> String {
+        let n = tc.draw(generators::integers::<usize>().max_value(12));
+        let mut s = String::new();
+        for _ in 0..n {
+            let token: String = tc.draw(hegel::one_of!(
+                generators::from_regex(r"[a-zA-Z0-9]{1,8}").fullmatch(true),
+                generators::from_regex(r"[a-z]{1,4}(-[a-z]{1,4}){1,2}").fullmatch(true),
+                generators::from_regex(r" {1,3}").fullmatch(true),
+                generators::sampled_from(vec![
+                    "\n".to_string(),
+                    "你好世界".to_string(),
+                    "こんにちは".to_string(),
+                    "😂😭🥺".to_string(),
+                    "Ｈｅｌｌｏ".to_string(),
+                    "e\u{301}\u{301}".to_string(), // combining acute accents
+                    "\u{1b}[32m".to_string(),      // ANSI color on
+                    "\u{1b}[0m".to_string(),       // ANSI reset
+                ]),
+                generators::text().max_size(8),
+            ));
+            s.push_str(&token);
+        }
+        s
+    }
+
+    /// Line-wrapping width: mostly small (where the interesting
+    /// interactions are), occasionally any `usize`.
+    #[hegel::composite]
+    pub(crate) fn widths(tc: &hegel::TestCase) -> usize {
+        tc.draw(hegel::one_of!(
+            generators::integers::<usize>().max_value(20),
+            generators::integers::<usize>(),
+        ))
+    }
+
+    pub(crate) fn separator_choices() -> Vec<WordSeparator> {
+        let mut separators = vec![WordSeparator::AsciiSpace];
+        #[cfg(feature = "unicode-linebreak")]
+        separators.push(WordSeparator::UnicodeBreakProperties);
+        separators
+    }
+
+    pub(crate) fn algorithm_choices() -> Vec<WrapAlgorithm> {
+        let mut algorithms = vec![WrapAlgorithm::FirstFit];
+        #[cfg(feature = "smawk")]
+        algorithms.push(WrapAlgorithm::new_optimal_fit());
+        algorithms
+    }
+
+    /// Indentation strings, weighted towards empty since several
+    /// properties only hold without indentation.
+    const INDENTS: &[&str] = &["", "", "  ", "* ", "> ", "-->", "👉", "\t"];
+
+    /// Generate an arbitrary valid [`Options`] configuration.
+    #[hegel::composite]
+    pub(crate) fn arbitrary_options(tc: &hegel::TestCase) -> Options<'static> {
+        let mut options = Options::new(tc.draw(widths()))
+            .break_words(tc.draw(generators::booleans()))
+            .preserve_trailing_space(tc.draw(generators::booleans()))
+            .initial_indent(tc.draw(generators::sampled_from(INDENTS.to_vec())))
+            .subsequent_indent(tc.draw(generators::sampled_from(INDENTS.to_vec())))
+            .word_separator(tc.draw((generators::sampled_from(separator_choices())).print_as_debug()))
