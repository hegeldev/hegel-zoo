+        let prefix: String = tc.draw(generators::from_regex(r"[ \t]{1,6}").fullmatch(true));
+        let line_gen = || generators::from_regex(r"[!-~][ -~]{0,10}").fullmatch(true);
+
+        let n = tc.draw(generators::integers::<usize>().max_value(6));
+        let mut lines: Vec<String> = Vec::new();
+        for _ in 0..n {
+            if tc.draw(generators::booleans()) {
+                lines.push(String::new());
+            } else {
+                lines.push(tc.draw(line_gen()));
+            }
+        }
+        if !lines.iter().any(|line| !line.is_empty()) {
+            // Ensure at least one non-blank line at column zero, so
+            // that dedent's common prefix is pinned to `prefix`.
+            lines.push(tc.draw(line_gen()));
+        }
