+#[hegel::test]
+fn legacy_to_deb822_and_back_is_the_identity(tc: hegel::TestCase) {
+    let line = tc.draw(arb_leg_line(0, LegOpts { flat: true, targets: true, ..Default::default() }).print_as_debug());
+    let l = line.expected();
+    let r: Repository = (&l).into();
+    assert_eq!(r.enabled, Some(true));
+    assert_eq!(type_names(&r.types), [l.typ.to_string()].into_iter().collect());
+    assert_eq!(r.uris, vec![l.uri.clone()]);
+    assert_eq!(r.suites, vec![l.suite.clone()]);
+    assert_eq!(r.components.clone().unwrap_or_default(), l.components);
+    assert_eq!(r.architectures.clone().unwrap_or_default(), l.architectures);
+    assert_eq!(r.languages.clone().unwrap_or_default(), l.languages);
+    assert_eq!(r.targets.clone().unwrap_or_default(), l.targets);
+    assert_eq!(r.pdiffs, l.pdiffs);
+    assert_eq!(r.by_hash, l.by_hash);
+    assert_eq!(r.allow_insecure.unwrap_or(false), l.allow_insecure);
+    assert_eq!(r.allow_weak.unwrap_or(false), l.allow_weak);
+    assert_eq!(r.allow_downgrade_to_insecure.unwrap_or(false), l.allow_downgrade_to_insecure);
+    assert_eq!(r.trusted, l.trusted);
+    assert_eq!(r.signature, l.signature);
+    assert_eq!(repo_targets(&r), legacy_targets(&l));
+    let by_value: Repository = l.clone().into();
+    assert_eq!(by_value, r);
+    let back = LegacyRepositories::from(&r);
+    assert_eq!(back.iter().cloned().collect::<Vec<_>>(), vec![l.clone()], "via {r:?}");
+}
