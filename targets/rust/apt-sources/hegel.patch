+/// apt-sources/5: `Display` writes the `pdiffs` option as `pdiff`, which
+/// the parser (and APT) do not know.
+#[hegel::test]
+fn the_pdiffs_option_round_trips_through_display(tc: hegel::TestCase) {
+    let mut line = tc.draw(arb_leg_line(0, LegOpts::default()).print_as_debug());
+    let v = tc.draw(generators::booleans());
+    line.options.pdiffs = Some(v);
+    line.options.order.retain(|k| k != "pdiffs");
+    line.options.order.push("pdiffs".to_string());
+    let text = format!("{}\n", line.render());
+    let parsed = LegacyRepositories::from_str(&text).unwrap();
+    assert_eq!(parsed.len(), 1);
+    let shown = format!("{parsed}\n");
+    let again = LegacyRepositories::from_str(&shown).map_err(|e| e.to_string());
+    assert_eq!(again.map(|a| a.iter().cloned().collect::<Vec<_>>()), Ok(vec![line.expected()]), "display {shown:?}");
+    apt_targets(&shown, "").unwrap_or_else(|e| panic!("apt rejected display {shown:?}: {e}"));
+}
