+
+fn type_names(types: &HashSet<RepositoryType>) -> BTreeSet<String> {
+    types.iter().map(|t| t.to_string()).collect()
+}
+
+fn repo_targets(r: &Repository) -> BTreeSet<Target> {
+    model_targets(
+        r.enabled.unwrap_or(true),
+        &type_names(&r.types),
+        &r.uris,
+        &r.suites,
+        r.components.as_deref().unwrap_or(&[]),
+        r.architectures.as_deref().unwrap_or(&[]),
+        r.languages.as_deref().unwrap_or(&[]),
+    )
+}
+
+fn legacy_targets(r: &LegacyRepository) -> BTreeSet<Target> {
+    let types: BTreeSet<String> = [r.typ.to_string()].into_iter().collect();
+    model_targets(true, &types, &[r.uri.clone()], &[r.suite.clone()], &r.components, &r.architectures, &r.languages)
+}
