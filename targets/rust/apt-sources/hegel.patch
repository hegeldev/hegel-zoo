+/// apt-sources/9: the regex spans lines, so `deb http://a/ s` followed by a
+/// line `main` (two malformed lines for APT) is read as one entry.
+#[hegel::test]
+fn entries_do_not_span_lines(tc: hegel::TestCase) {
+    let mut line = tc.draw(arb_leg_line(0, LegOpts::default()).print_as_debug());
+    line.comps = vec!["main".to_string()];
+    let one = line.render();
+    let (head, _) = one.rsplit_once(&line.sep).unwrap();
+    let text = format!("{head}\nmain\n");
+    assert!(apt_targets(&text, "").is_err(), "apt accepted {text:?}");
+    let parsed = LegacyRepositories::from_str(&text).unwrap();
+    assert!(parsed.is_empty(), "read {parsed:?} from {text:?}");
+}
