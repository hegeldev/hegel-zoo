+/// apt-sources/8: an embedded `Signed-By` key block does not round-trip
+/// through `Display` (an extra empty line is added on every pass).
+#[hegel::test]
+fn an_embedded_key_block_round_trips_through_display(tc: hegel::TestCase) {
+    let stanza = tc.draw(arb_stanza(0, StanzaOpts::default()).print_as_debug());
+    let mut text = stanza.text();
+    if stanza.signed_by.is_some() {
+        text = text.lines().filter(|l| !l.starts_with("Signed-By")).map(|l| format!("{l}\n")).collect();
+    }
+    let n = tc.draw(int!(1, 3));
+    let body: Vec<String> = (0..n).map(|i| format!(" line{i}")).collect();
+    text.push_str(&format!("Signed-By:\n -----BEGIN PGP PUBLIC KEY BLOCK-----\n{}\n -----END PGP PUBLIC KEY BLOCK-----\n", body.join("\n")));
+    let parsed = Repositories::from_str(&text).unwrap();
+    let shown = parsed.to_string();
+    let again = Repositories::from_str(&shown).unwrap_or_else(|e| panic!("{shown:?}: {e}"));
+    assert_eq!(again, parsed, "display {shown:?} of {text:?}");
+}
