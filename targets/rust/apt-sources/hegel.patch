+#[hegel::test]
+fn legacy_display_round_trips(tc: hegel::TestCase) {
+    let file = tc.draw(arb_leg_file(LegOpts { targets: true, ..Default::default() }).print_as_debug());
+    // apt-sources/5: `pdiffs` is written as `pdiff`.
+    if file.lines.iter().any(|l| l.options.pdiffs.is_some()) {
+        return;
+    }
+    let text = file.text();
+    let parsed = LegacyRepositories::from_str(&text).unwrap();
+    if parsed.is_empty() {
+        assert_eq!(parsed.to_string(), "");
+        return;
+    }
+    let shown = format!("{parsed}\n");
+    let again = LegacyRepositories::from_str(&shown).unwrap_or_else(|e| panic!("{shown:?}: {e}"));
+    assert_eq!(again, parsed, "display {shown:?} of {text:?}");
+    // The display is one line per repository, and each line alone parses.
+    assert_eq!(shown.lines().count(), parsed.len());
+    for (line, r) in shown.lines().zip(parsed.iter()) {
+        assert_eq!(r.to_string(), line);
+        let one = LegacyRepositories::from_str(line).unwrap();
+        assert_eq!(one.iter().collect::<Vec<_>>(), vec![r]);
+    }
+    // APT reads the display the same way (a `target=` option changes the
+    // indexes, so only lines without one are compared).
+    if !parsed.is_empty() && parsed.iter().all(|r| r.targets.is_empty()) {
+        let apt = apt_targets(&shown, "").unwrap_or_else(|e| panic!("apt rejected display {shown:?}: {e}"));
+        assert_eq!(apt, parsed.iter().flat_map(legacy_targets).collect::<BTreeSet<_>>());
+    }
+}
