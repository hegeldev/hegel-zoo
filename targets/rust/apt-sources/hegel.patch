+/// apt-sources/11: two or more spaces (or a space and a tab) between two
+/// components make the line disappear (APT accepts any whitespace).
+#[hegel::test]
+fn components_separated_by_several_spaces_are_read(tc: hegel::TestCase) {
+    let mut line = tc.draw(arb_leg_line(0, LegOpts::default()).print_as_debug());
+    line.sep = pick(&tc, &["  ", " \t", "\t ", "   "]).to_string();
+    if line.comps.len() < 2 {
+        line.comps = vec!["main".to_string(), "contrib".to_string()];
+    }
+    let text = format!("{}\n", line.render());
+    let apt = apt_targets(&text, "").unwrap();
+    assert_eq!(apt, line.targets());
+    let parsed = LegacyRepositories::from_str(&text).unwrap();
+    assert_eq!(parsed.iter().cloned().collect::<Vec<_>>(), vec![line.expected()], "for {text:?}");
+}
