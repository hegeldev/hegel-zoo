+#[hegel::test]
+fn legacy_lines_are_read_like_python_apt(tc: hegel::TestCase) {
+    let file = tc.draw(arb_leg_file(LegOpts::default()).print_as_debug());
+    let text = file.text();
+    let parsed = LegacyRepositories::from_str(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    let py = python_apt(&text);
+    let py_valid: Vec<&PyEntry> = py.iter().filter(|e| !e.invalid && !e.disabled).collect();
+    // python-apt marks entries with options other than arch/trusted invalid.
+    let comparable = file.lines.iter().filter(|l| l.options.python_compatible()).count();
+    assert_eq!(py_valid.len(), comparable, "python-apt on {text:?}: {py:?}");
+    let ours: Vec<&LegacyRepository> = parsed
+        .iter()
+        .zip(&file.lines)
+        .filter(|(_, l)| l.options.python_compatible())
+        .map(|(r, _)| r)
+        .collect();
+    for (r, e) in ours.iter().zip(&py_valid) {
+        assert_eq!(r.typ.to_string(), e.typ, "type for {text:?}");
+        assert_eq!(r.uri, Url::parse(&e.uri).unwrap(), "uri for {text:?}");
+        assert_eq!(r.suite, e.dist, "suite for {text:?}");
+        assert_eq!(r.components, e.comps, "components for {text:?}");
+        assert_eq!(r.architectures, e.arch, "architectures for {text:?}");
+        assert_eq!(r.trusted, e.trusted, "trusted for {text:?}");
+    }
+}
