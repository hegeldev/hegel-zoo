+/// apt-sources/4: a commented-out entry (`# deb …`) is documented as a
+/// disabled repository but is not read at all.
+#[hegel::test]
+fn disabled_entries_are_read_as_disabled(tc: hegel::TestCase) {
+    let mut line = tc.draw(arb_leg_line(0, LegOpts::default()).print_as_debug());
+    line.disabled = true;
+    let text = format!("{}\n", line.render());
+    let py = python_apt(&text);
+    assert!(py[0].disabled && (!py[0].invalid || !line.options.python_compatible()));
+    let parsed = LegacyRepositories::from_str(&text).unwrap();
+    assert_eq!(parsed.len(), 1, "for {text:?}: {parsed:?}");
+    let r: Repository = parsed.iter().next().unwrap().into();
+    assert_eq!(r.enabled, Some(false));
+}
