+/// Plain files: LF, http(s) URIs, no flat repositories, no dashed components,
+/// no comments after an entry, no disabled entries.
+#[hegel::test]
+fn legacy_lines_are_read_as_the_model_says(tc: hegel::TestCase) {
+    let file = tc.draw(arb_leg_file(LegOpts { targets: true, ..Default::default() }).print_as_debug());
+    let text = file.text();
+    let parsed = LegacyRepositories::from_str(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    let expected: Vec<LegacyRepository> = file.lines.iter().map(|l| l.expected()).collect();
+    assert_eq!(parsed.iter().cloned().collect::<Vec<_>>(), expected, "for {text:?}");
+    assert_eq!(parsed.len(), file.lines.len());
+    assert_eq!(parsed.is_empty(), file.lines.is_empty());
+    assert_eq!(parsed.repositories().count(), file.lines.len());
+}
