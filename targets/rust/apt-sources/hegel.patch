+/// apt-sources/10: `arch+=`/`arch-=` (sources.list(5)) are rejected as an
+/// unrecognised option.
+#[hegel::test]
+fn arch_add_and_remove_options_are_accepted(tc: hegel::TestCase) {
+    let mut line = tc.draw(arb_leg_line(0, LegOpts::default()).print_as_debug());
+    line.options = Options::default();
+    let op = pick(&tc, &["+", "-"]);
+    let text = format!("deb [arch{op}=i386] {} {} main\n", line.uri, line.suite);
+    apt_targets(&text, "").unwrap();
+    let parsed = LegacyRepositories::from_str(&text).map_err(|e| e.to_string());
+    assert!(parsed.is_ok(), "{parsed:?} for {text:?}");
+}
