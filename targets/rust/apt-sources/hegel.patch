+/// apt-sources/6: the yes/no fields `Allow-Insecure`, `Allow-Weak`,
+/// `Allow-Downgrade-To-Insecure` and `Trusted` are read with `bool::from_str`
+/// (`true`/`false`), so the values sources.list(5) specifies are rejected.
+#[hegel::test]
+fn yes_no_fields_are_read(tc: hegel::TestCase) {
+    let mut stanza = tc.draw(arb_stanza(0, StanzaOpts::default()).print_as_debug());
+    let field = pick(&tc, &["Allow-Insecure", "Allow-Weak", "Allow-Downgrade-To-Insecure", "Trusted"]);
+    let v = tc.draw(generators::booleans());
+    match field {
+        "Allow-Insecure" => stanza.allow_insecure = Some(v),
+        "Allow-Weak" => stanza.allow_weak = Some(v),
+        "Allow-Downgrade-To-Insecure" => stanza.allow_downgrade_to_insecure = Some(v),
+        _ => stanza.trusted = Some(v),
+    }
+    stanza.order.push(field.to_string());
+    let text = stanza.text();
+    apt_targets("", &text).unwrap_or_else(|e| panic!("apt rejected {text:?}: {e}"));
+    let parsed = Repositories::from_str(&text).map_err(|e| e.to_string());
+    assert_eq!(parsed.map(|p| p.iter().cloned().collect::<Vec<_>>()), Ok(vec![stanza.expected()]), "for {text:?}");
+}
