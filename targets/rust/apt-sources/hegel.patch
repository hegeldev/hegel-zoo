+/// apt-sources/7: `PDiffs: yes` is displayed as `PDiffs: true`, which the
+/// parser rejects.
+#[hegel::test]
+fn the_pdiffs_field_round_trips_through_display(tc: hegel::TestCase) {
+    let mut stanza = tc.draw(arb_stanza(0, StanzaOpts::default()).print_as_debug());
+    stanza.pdiffs = Some(tc.draw(generators::booleans()));
+    stanza.order.push("PDiffs".to_string());
+    let text = stanza.text();
+    let parsed = Repositories::from_str(&text).unwrap();
+    let shown = parsed.to_string();
+    let again = Repositories::from_str(&shown).map_err(|e| e.to_string());
+    assert_eq!(again.map(|a| a.iter().cloned().collect::<Vec<_>>()), Ok(vec![stanza.expected()]), "display {shown:?}");
+}
