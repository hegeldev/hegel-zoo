+#[hegel::test]
+fn deb822_to_legacy_lines_keeps_the_indexes(tc: hegel::TestCase) {
+    let stanza = tc.draw(arb_stanza(0, StanzaOpts { flat: true, pdiffs: true, targets: true, ..Default::default() }).print_as_debug());
+    let r = stanza.expected();
+    let lines = LegacyRepositories::from(&r);
+    assert_eq!(lines.len(), r.types.len() * r.uris.len() * r.suites.len());
+    let mut seen = BTreeSet::new();
+    for l in lines.iter() {
+        assert!(seen.insert((l.typ.to_string(), l.uri.to_string(), l.suite.clone())), "duplicate line");
+        assert_eq!(l.components, r.components.clone().unwrap_or_default());
+        assert_eq!(l.architectures, r.architectures.clone().unwrap_or_default());
+        assert_eq!(l.pdiffs, r.pdiffs);
+        assert_eq!(l.trusted, r.trusted);
+        assert_eq!(l.signature, r.signature);
+    }
+    if r.enabled != Some(false) {
+        let from_lines: BTreeSet<Target> = lines.iter().flat_map(legacy_targets).collect();
+        assert_eq!(from_lines, repo_targets(&r));
+    }
+    // And back again, as one repository per line.
+    let again: Repositories = lines.into();
+    assert_eq!(again.len(), r.types.len() * r.uris.len() * r.suites.len());
+    let merged: BTreeSet<Target> = again.iter().flat_map(repo_targets).collect();
+    if r.enabled != Some(false) {
+        assert_eq!(merged, repo_targets(&r));
+    }
+}
