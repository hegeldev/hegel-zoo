+
+/// Hegel property-based tests for `Duration`.
+///
+/// The existing kani harnesses (src/duration/kani_verif.rs) prove structural
+/// postconditions (results are normalized, saturate at MIN/MAX) but not
+/// value-level semantics. The properties below check the value semantics
+/// against an independent i128 total-nanoseconds oracle, plus the
+/// Display <-> FromStr round-trip which the serde impls rely on.
+mod hegel_props {
+    use hegel::generators::{self, Generator};
+    use hifitime::{Duration, NANOSECONDS_PER_CENTURY};
+    use std::str::FromStr;
+
+    /// Total-nanosecond bounds of the representable range: Duration is
+    /// (centuries: i16, nanoseconds in century: u64), and per the Duration
+    /// docs MIN is (i16::MIN, 0) and MAX is (i16::MAX, NANOSECONDS_PER_CENTURY).
+    const MIN_TOTAL_NS: i128 = (i16::MIN as i128) * (NANOSECONDS_PER_CENTURY as i128);
+    const MAX_TOTAL_NS: i128 = -MIN_TOTAL_NS;
+
+    /// Draws an arbitrary in-range Duration, boosting boundary values.
+    #[hegel::composite]
+    fn arb_duration(tc: &hegel::TestCase) -> Duration {
+        let total = tc.draw(hegel::one_of!(
+            generators::integers::<i128>()
+                .min_value(MIN_TOTAL_NS)
+                .max_value(MAX_TOTAL_NS),
+            generators::sampled_from(vec![
+                MIN_TOTAL_NS,
+                MAX_TOTAL_NS,
+                0,
+                1,
+                -1,
+                i64::MIN as i128,
+                i64::MAX as i128,
+                NANOSECONDS_PER_CENTURY as i128,
+                -(NANOSECONDS_PER_CENTURY as i128),
+                NANOSECONDS_PER_CENTURY as i128 - 1,
+            ]),
+        ));
+        Duration::from_total_nanoseconds(total)
+    }
+
+    /// from_total_nanoseconds is the inverse of total_nanoseconds for in-range
+    /// values and saturates to MIN/MAX outside the range (per its rustdoc).
+    #[hegel::test]
+    fn prop_duration_total_nanoseconds_roundtrip(tc: hegel::TestCase) {
+        let nanos = tc.draw(hegel::one_of!(
+            generators::integers::<i128>(),
+            generators::integers::<i128>()
+                .min_value(MIN_TOTAL_NS)
+                .max_value(MAX_TOTAL_NS),
+            generators::sampled_from(vec![
+                MIN_TOTAL_NS,
+                MAX_TOTAL_NS,
+                MIN_TOTAL_NS - 1,
+                MAX_TOTAL_NS + 1,
+                0,
+            ]),
+        ));
+        let dur = Duration::from_total_nanoseconds(nanos);
+        let expected = nanos.clamp(MIN_TOTAL_NS, MAX_TOTAL_NS);
+        assert_eq!(
+            dur.total_nanoseconds(),
+            expected,
+            "roundtrip failed for {nanos} ns"
+        );
+    }
+
+    /// Duration addition agrees with saturating i128 addition of the total
+    /// nanoseconds (evidence: Add docs + "Duration::MIN - 1 ns == MIN" bound tests).
+    #[hegel::test]
+    fn prop_duration_add_matches_i128_oracle(tc: hegel::TestCase) {
+        let a = tc.draw((arb_duration()).print_as_debug());
+        let b = tc.draw((arb_duration()).print_as_debug());
+        let expected = (a.total_nanoseconds() + b.total_nanoseconds())
+            .clamp(MIN_TOTAL_NS, MAX_TOTAL_NS);
+        let sum = a + b;
+        assert_eq!(
+            sum.total_nanoseconds(),
+            expected,
+            "{a} + {b} gave {sum}"
+        );
+    }
+
+    /// Duration subtraction agrees with saturating i128 subtraction.
+    ///
+    /// KNOWN FAILURE: when `a.centuries - b.centuries` overflows an i16 on the
+    /// *positive* side (a large positive minus a large negative duration),
+    /// `Sub for Duration` (src/duration/ops.rs) treats the `checked_sub`
+    /// overflow as an underflow and saturates to `Duration::MIN` instead of
+    /// `Duration::MAX`. Minimal counterexample (pinned by the `just` branch
+    /// below so the failure reproduces on every run):
+    /// `Duration::ZERO - Duration::MIN == Duration::MIN` but must be
+    /// `Duration::MAX`.
+    #[hegel::test(test_cases = 200)]
+    fn prop_duration_sub_matches_i128_oracle(tc: hegel::TestCase) {
+        let a = tc.draw((arb_duration()).print_as_debug());
+        let b = tc.draw((hegel::one_of!(
+            arb_duration(),
+            // Deterministic pin of the known counterexample region.
+            generators::just(Duration::MIN),
+        )).print_as_debug());
+        let expected = (a.total_nanoseconds() - b.total_nanoseconds())
+            .clamp(MIN_TOTAL_NS, MAX_TOTAL_NS);
+        let diff = a - b;
+        assert_eq!(
+            diff.total_nanoseconds(),
+            expected,
+            "{a} - {b} gave {diff}"
+        );
+    }
+
+    /// Sibling of prop_duration_sub_matches_i128_oracle (KNOWN FAILURE): the
+    /// same oracle restricted to pairs whose century difference fits in an
+    /// i16, i.e. excluding the known wrong-saturation bug, so the rest of the
+    /// subtraction logic keeps being exercised.
+    #[hegel::test]
+    fn prop_duration_sub_matches_i128_oracle_no_century_overflow(tc: hegel::TestCase) {
+        let a = tc.draw((arb_duration()).print_as_debug());
+        let mut b = tc.draw((arb_duration()).print_as_debug());
+        // Construct a non-overflowing pair instead of rejecting: if the century
+        // difference overflows i16, flipping b's sign brings it back in range.
+        let centuries_diff =
+            i32::from(a.to_parts().0) - i32::from(b.to_parts().0);
+        if centuries_diff > i32::from(i16::MAX) || centuries_diff < i32::from(i16::MIN) {
+            b = -b;
+        }
+        let expected = (a.total_nanoseconds() - b.total_nanoseconds())
+            .clamp(MIN_TOTAL_NS, MAX_TOTAL_NS);
+        let diff = a - b;
+        assert_eq!(
+            diff.total_nanoseconds(),
+            expected,
+            "{a} - {b} gave {diff}"
+        );
+    }
+
+    /// Negation matches i128 negation (the range is symmetric: -MIN == MAX),
+    /// and is therefore an involution.
+    #[hegel::test]
+    fn prop_duration_neg_matches_i128_oracle(tc: hegel::TestCase) {
+        let d = tc.draw((arb_duration()).print_as_debug());
+        let neg = -d;
+        assert_eq!(
+            neg.total_nanoseconds(),
+            -d.total_nanoseconds(),
+            "-({d}) gave {neg}"
+        );
+        assert_eq!(-neg, d, "double negation of {d} gave {}", -neg);
+    }
+
+    /// The derived lexicographic Ord on (centuries, nanoseconds) must order
+    /// durations by their actual value (evidence: representation convention
+    /// documented on the Duration struct).
+    #[hegel::test]
+    fn prop_duration_ordering_matches_total_nanoseconds(tc: hegel::TestCase) {
+        let a = tc.draw((arb_duration()).print_as_debug());
+        let b = tc.draw((arb_duration()).print_as_debug());
+        assert_eq!(
+            a.cmp(&b),
+            a.total_nanoseconds().cmp(&b.total_nanoseconds()),
+            "ordering of {a} vs {b} disagrees with total nanoseconds"
+        );
+    }
+
+    /// Display -> FromStr round-trips exactly. Evidence: the serde
+    /// Serialize/Deserialize impls for Duration serialize via to_string and
+    /// deserialize via from_str, so this round-trip must be lossless.
+    ///
+    /// KNOWN FAILURE: `Duration::decompose()` computes each component with f64
+    /// unit conversions (`to_unit(...).floor()`). For large durations the f64
+    /// rounds up across a component boundary, so `Display` prints a value that
+    /// differs from the stored duration and the serde round-trip corrupts the
+    /// value. Minimal counterexample (pinned by the `just` branch below so the
+    /// failure reproduces on every run):
+    /// `Duration::from_total_nanoseconds(NANOSECONDS_PER_CENTURY as i128 - 1)`
+    /// (one nanosecond less than a century) displays as
+    /// "36525 days 59 min 59 s 999 ms 999 μs 999 ns" — 36525 days is already
+    /// the *full* century, its `decompose()` is (0, 36525, 0, 59, 59, 999,
+    /// 999, 999) (note the missing 23 h), and parsing the display back yields
+    /// a value ~1 h larger than the original. The failure region starts as low
+    /// as ~105 days: e.g. 250 days - 1 ns displays as
+    /// "250 days 59 min 59 s 999 ms 999 μs 999 ns" and round-trips off by 1 h.
+    #[hegel::test(test_cases = 200)]
+    fn prop_duration_display_fromstr_roundtrip(tc: hegel::TestCase) {
+        let d = tc.draw((hegel::one_of!(
+            arb_duration(),
+            // Deterministic pin of the known counterexample region.
+            generators::just(Duration::from_total_nanoseconds(
+                NANOSECONDS_PER_CENTURY as i128 - 1
+            )),
+        )).print_as_debug());
+        let repr = format!("{d}");
+        match Duration::from_str(&repr) {
+            Ok(parsed) => assert_eq!(parsed, d, "{repr} parsed back as {parsed}"),
+            Err(err) => panic!("failed to parse the display of {d} ({repr}): {err:?}"),
+        }
+    }
+
+    /// Sibling of prop_duration_display_fromstr_roundtrip (KNOWN FAILURE):
+    /// restricted to sub-day durations, where the largest component value is
+    /// 23 hours and the f64 conversions in decompose() are exact (the 1 ns
+    /// resolution is orders of magnitude above the f64 ulp of every
+    /// component), so the round-trip must hold.
+    #[hegel::test]
+    fn prop_duration_display_fromstr_roundtrip_subday(tc: hegel::TestCase) {
+        const DAY_NS: i128 = 86_400 * 1_000_000_000;
+        let nanos = tc.draw(
+            generators::integers::<i128>()
+                .min_value(-(DAY_NS - 1))
+                .max_value(DAY_NS - 1),
+        );
+        let d = Duration::from_total_nanoseconds(nanos);
+        let repr = format!("{d}");
+        match Duration::from_str(&repr) {
+            Ok(parsed) => assert_eq!(parsed, d, "{repr} parsed back as {parsed}"),
+            Err(err) => panic!("failed to parse the display of {d} ({repr}): {err:?}"),
+        }
+    }
+
+    /// Duration::from_str must never panic, whatever the input.
+    #[hegel::test]
+    fn prop_duration_from_str_never_panics(tc: hegel::TestCase) {
+        let s = tc.draw(hegel::one_of!(
+            generators::text(),
+            generators::from_regex(r"[+-]?[0-9]{0,10}\.?[0-9]{0,6} ?(d|days|h|min|s|ms|us|ns|nanoseconds)?")
+                .fullmatch(true),
+        ));
+        drop(Duration::from_str(&s));
+    }
+}
