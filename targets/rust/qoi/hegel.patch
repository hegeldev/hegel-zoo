+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+mod hegel_props {
+    use super::common::{draw_dims, draw_pixels};
+    use hegel::generators::{self, Generator};
+    use qoi::consts::{QOI_HEADER_SIZE, QOI_PIXELS_MAX};
+    use qoi::{
+        decode_to_vec, encode_max_len, Channels, ColorSpace, Decoder, Encoder, Error, Header,
+    };
+    use std::io::Cursor;
+
+    fn channels_gen() -> impl Generator<Channels> {
+        generators::sampled_from(vec![Channels::Rgb, Channels::Rgba])
+    }
+
+    fn colorspace_gen() -> impl Generator<ColorSpace> {
+        generators::sampled_from(vec![ColorSpace::Srgb, ColorSpace::Linear])
+    }
+
+    /// Draw a structured image plus a colorspace and return
+    /// `(pixels, width, height, channels, colorspace)`.
+    fn draw_image(tc: &hegel::TestCase) -> (Vec<u8>, u32, u32, Channels, ColorSpace) {
+        let channels = tc.draw((channels_gen()).print_as_debug());
+        let colorspace = tc.draw((colorspace_gen()).print_as_debug());
+        let (width, height) = draw_dims(tc, 2048);
+        let pixels = draw_pixels(tc, (width * height) as usize, channels.as_u8() as usize);
+        (pixels, width, height, channels, colorspace)
+    }
+
+    /// Header::decode is the inverse of Header::encode over the full domain of
+    /// valid headers (dimensions up to the documented 400Mp limit, both channel
+    /// counts, both colorspaces).
+    #[hegel::test]
+    fn prop_header_encode_decode_roundtrip(tc: hegel::TestCase) {
+        let width =
+            tc.draw(generators::integers::<u32>().min_value(1).max_value(QOI_PIXELS_MAX as u32));
+        let height = tc.draw(
+            generators::integers::<u32>()
+                .min_value(1)
+                .max_value((QOI_PIXELS_MAX / width as usize) as u32),
+        );
+        let channels = tc.draw((channels_gen()).print_as_debug());
+        let colorspace = tc.draw((colorspace_gen()).print_as_debug());
+        let header = Header::try_new(width, height, channels, colorspace).unwrap();
+        let decoded = Header::decode(header.encode()).unwrap();
+        assert_eq!(decoded, header);
+    }
+
+    /// Corrupting any single semantic field of a valid header makes
+    /// Header::decode return the matching error (validation/rejection check).
+    #[hegel::test]
+    fn prop_header_decode_rejects_corrupt_fields(tc: hegel::TestCase) {
+        let width = tc.draw(generators::integers::<u32>().min_value(1).max_value(20_000));
+        let height = tc.draw(generators::integers::<u32>().min_value(1).max_value(20_000));
+        let channels = tc.draw((channels_gen()).print_as_debug());
+        let colorspace = tc.draw((colorspace_gen()).print_as_debug());
+        let header = Header::try_new(width, height, channels, colorspace).unwrap();
+        let mut bytes = header.encode();
+
+        match tc.draw(generators::integers::<u8>().max_value(4)) {
+            0 => {
+                // corrupt magic
+                let i = tc.draw(generators::integers::<usize>().max_value(3));
+                let mask = tc.draw(generators::integers::<u8>().min_value(1));
+                bytes[i] ^= mask;
+                assert!(matches!(Header::decode(bytes), Err(Error::InvalidMagic { .. })));
+            }
+            1 => {
+                // invalid channels byte
+                let c = tc.draw(generators::integers::<u8>().filter(|&c| c != 3 && c != 4));
+                bytes[12] = c;
+                assert!(matches!(Header::decode(bytes), Err(Error::InvalidChannels { .. })));
+            }
+            2 => {
+                // invalid colorspace byte
+                let c = tc.draw(generators::integers::<u8>().min_value(2));
+                bytes[13] = c;
+                assert!(matches!(Header::decode(bytes), Err(Error::InvalidColorSpace { .. })));
+            }
+            3 => {
+                // zero dimension
+                if tc.draw(generators::booleans()) {
+                    bytes[4..8].copy_from_slice(&[0; 4]);
+                } else {
+                    bytes[8..12].copy_from_slice(&[0; 4]);
+                }
+                assert!(matches!(Header::decode(bytes), Err(Error::InvalidImageDimensions { .. })));
+            }
+            _ => {
+                // pixel count above the 400Mp limit
+                let w = tc.draw(
+                    generators::integers::<u32>().min_value(QOI_PIXELS_MAX as u32 + 1),
+                );
+                let h = tc.draw(generators::integers::<u32>().min_value(1));
+                bytes[4..8].copy_from_slice(&w.to_be_bytes());
+                bytes[8..12].copy_from_slice(&h.to_be_bytes());
+                assert!(matches!(Header::decode(bytes), Err(Error::InvalidImageDimensions { .. })));
+            }
+        }
+    }
+
+    /// Decoding a valid (bounded-size) header followed by arbitrary garbage
+    /// never panics; when it succeeds, the output length matches the header.
+    #[hegel::test]
+    fn prop_decode_garbage_body_never_panics(tc: hegel::TestCase) {
+        let (width, height) = draw_dims(&tc, 4096);
+        let channels = tc.draw((channels_gen()).print_as_debug());
+        let colorspace = tc.draw((colorspace_gen()).print_as_debug());
+        let header = Header::try_new(width, height, channels, colorspace).unwrap();
+        let mut data = header.encode().to_vec();
+        let body: Vec<u8> = tc.draw(generators::binary().max_size(512));
+        data.extend_from_slice(&body);
+
+        if let Ok((hdr, out)) = decode_to_vec(&data) {
+            assert_eq!(hdr, header);
+            assert_eq!(out.len(), header.n_bytes());
+        }
+        // the independent stream-decoder implementation must not panic either
+        if let Ok(mut dec) = Decoder::from_stream(Cursor::new(&data)) {
+            let _ = dec.decode_to_vec();
+        }
+    }
+
+    /// A truncated valid encoding (any strict prefix) always errors and never
+    /// panics: the declared pixel count can no longer be satisfied.
+    #[hegel::test]
+    fn prop_decode_truncated_encoding_errors(tc: hegel::TestCase) {
+        let (pixels, width, height, _, _) = draw_image(&tc);
+        let encoded = encode_to_vec_checked(&pixels, width, height);
+        let cut = tc.draw(generators::integers::<usize>().max_value(encoded.len() - 1));
+        assert!(decode_to_vec(&encoded[..cut]).is_err());
+    }
+
+    /// Inflating the declared dimensions of a valid encoding (header promises
+    /// more pixels than the chunk stream provides) makes decoding error.
+    #[hegel::test]
+    fn prop_decode_rejects_header_larger_than_data(tc: hegel::TestCase) {
+        let (pixels, width, height, channels, colorspace) = draw_image(&tc);
+        let mut encoded = encode_to_vec_checked(&pixels, width, height);
+        // strictly increase the pixel count, staying within valid header bounds
+        let extra = tc.draw(generators::integers::<u32>().min_value(1).max_value(4096));
+        let inflated = Header::try_new(width, height + extra, channels, colorspace).unwrap();
+        encoded[..QOI_HEADER_SIZE].copy_from_slice(&inflated.encode());
+        assert!(decode_to_vec(&encoded).is_err());
+    }
+
+    /// Flipping any single bit of a valid encoding past the dimension fields
+    /// never panics the decoder. (Bytes 4..12 are skipped only to keep the
+    /// test from allocating multi-hundred-MB buffers for legally-huge
+    /// dimensions -- this protects the test's memory, not the library's
+    /// contract; header-field corruption is covered by
+    /// prop_header_decode_rejects_corrupt_fields.)
+    #[hegel::test]
+    fn prop_decode_bit_flipped_encoding_never_panics(tc: hegel::TestCase) {
+        let (pixels, width, height, _, _) = draw_image(&tc);
+        let mut encoded = encode_to_vec_checked(&pixels, width, height);
+        let idx = tc.draw(hegel::one_of!(
+            generators::integers::<usize>().max_value(3),
+            generators::integers::<usize>().min_value(12).max_value(encoded.len() - 1),
+        ));
+        let bit = tc.draw(generators::integers::<u8>().max_value(7));
+        encoded[idx] ^= 1 << bit;
+
+        if let Ok((hdr, out)) = decode_to_vec(&encoded) {
+            assert_eq!(out.len(), hdr.n_bytes());
+        }
+        if let Ok(mut dec) = Decoder::from_stream(Cursor::new(&encoded)) {
+            let _ = dec.decode_to_vec();
+        }
+    }
+
+    /// The three encoding APIs (to_vec, to_buf, to_stream) produce identical
+    /// bytes, and the result never exceeds encode_max_len.
+    #[hegel::test]
+    fn prop_encode_vec_buf_stream_agree(tc: hegel::TestCase) {
+        let (pixels, width, height, channels, colorspace) = draw_image(&tc);
+        let encoder = Encoder::new(&pixels, width, height).unwrap().with_colorspace(colorspace);
+        assert_eq!(encoder.channels(), channels);
+
+        let vec_out = encoder.encode_to_vec().unwrap();
+        assert!(vec_out.len() <= encode_max_len(width, height, channels));
+
+        let mut buf = vec![0_u8; encoder.required_buf_len()];
+        let n_buf = encoder.encode_to_buf(&mut buf).unwrap();
+        assert_eq!(&buf[..n_buf], vec_out.as_slice());
+
+        let mut stream_out = Vec::new();
+        let n_stream = encoder.encode_to_stream(&mut stream_out).unwrap();
+        assert_eq!(n_stream, stream_out.len());
+        assert_eq!(stream_out, vec_out);
+    }
+
+    /// The slice decoder and the (independently implemented) stream decoder
+    /// agree, for every (source channels, requested channels) combination.
+    ///
+    /// For the (Rgba -> Rgb) combination, alpha values are restricted to the
+    /// hash-preserving set {63, 127, 191, 255}: outside it the two decoders
+    /// genuinely disagree -- pinned as a known bug by
+    /// `test_decode_slice_vs_stream_divergence` below.
+    #[hegel::test]
+    fn prop_decode_slice_vs_stream_agree(tc: hegel::TestCase) {
+        let source = tc.draw((channels_gen()).print_as_debug());
+        let target = tc.draw((channels_gen()).print_as_debug());
+        let (width, height) = draw_dims(&tc, 2048);
+        let mut pixels =
+            draw_pixels(&tc, (width * height) as usize, source.as_u8() as usize);
+        if source == Channels::Rgba && target == Channels::Rgb {
+            for px in pixels.chunks_exact_mut(4) {
+                px[3] = [63, 127, 191, 255][(px[3] >> 6) as usize];
+            }
+        }
+        let encoded = encode_to_vec_checked(&pixels, width, height);
+
+        let mut slice_dec = Decoder::new(&encoded).unwrap().with_channels(target);
+        let mut stream_dec =
+            Decoder::from_stream(Cursor::new(&encoded)).unwrap().with_channels(target);
+        assert_eq!(slice_dec.header(), stream_dec.header());
+
+        let out_slice = slice_dec.decode_to_vec().unwrap();
+        let out_stream = stream_dec.decode_to_vec().unwrap();
+        assert_eq!(out_slice, out_stream);
+    }
+
+    /// KNOWN FAILURE (real bug, do not "fix" the test): the two public
+    /// decoders disagree with each other when decoding a valid, qoi-rust
+    /// encoded RGBA image with `with_channels(Rgb)`.
+    ///
+    /// Mechanism (found by prop_decode_slice_vs_stream_agree, minimized
+    /// separately): both 3-channel decode paths lose alpha state (see
+    /// prop_decode_rgba_as_rgb_drops_alpha above), so a QOI_OP_INDEX chunk can
+    /// pull in a zero pixel from an uninitialized slot -- a pixel that is
+    /// *not* stored at its own hash position. A subsequent QOI_OP_RUN then
+    /// behaves differently in the two implementations:
+    /// `decode_impl_stream` writes `index[hash(px)] = px` in its RUN arm,
+    /// clobbering slot hash3(0,0,0) = 53, while `decode_impl_slice` performs
+    /// no index writes on runs. The next QOI_OP_INDEX(53) reads different
+    /// values.
+    ///
+    /// In the 9-pixel image below (encoder ops annotated), the final pixel
+    /// decodes as (3,1,254) via the slice decoder but (0,0,0) via the stream
+    /// decoder.
+    ///
+    /// Note: reproduces with default features. Under `--features reference`
+    /// the encoder emits RUN instead of INDEX for the length-1 run at pixel 2
+    /// and this particular stream no longer triggers the divergence (the
+    /// decoder flaw itself is feature-independent).
+    #[test]
+    fn test_decode_slice_vs_stream_divergence() {
+        #[rustfmt::skip]
+        let pixels: [[u8; 4]; 9] = [
+            [0, 2, 3, 2], // RGBA     -> index slot hash4 = 53 (encoder), 20 (decoders)
+            [0, 2, 3, 2], // RUN(1), encoded as INDEX(53); decoders read uninit slot -> (0,0,0)
+            [3, 3, 1, 2], // LUMA; decoders apply it to (0,0,0) -> (3,1,254), stored at slot 53
+            [1, 0, 0, 3], // RGBA
+            [2, 2, 0, 0], // RGBA
+            [1, 0, 0, 3], // INDEX(36); uninit in decoders -> px = (0,0,0), not at its hash slot
+            [1, 0, 0, 3], // RUN(2)... stream decoder RUN arm writes (0,0,0) into slot 53,
+            [1, 0, 0, 3], //           slice decoder writes nothing
+            [3, 3, 1, 2], // INDEX(53): slice reads (3,1,254), stream reads (0,0,0)
+        ];
+        let pixels: Vec<u8> = pixels.concat();
+        let encoded = qoi::encode_to_vec(&pixels, 9, 1).unwrap();
+
+        let out_slice = Decoder::new(&encoded)
+            .unwrap()
+            .with_channels(Channels::Rgb)
+            .decode_to_vec()
+            .unwrap();
+        let out_stream = Decoder::from_stream(Cursor::new(&encoded))
+            .unwrap()
+            .with_channels(Channels::Rgb)
+            .decode_to_vec()
+            .unwrap();
+        assert_eq!(out_slice, out_stream);
+    }
+
+    /// Decoding an RGB image with `with_channels(Rgba)` equals the native RGB
+    /// decode with an opaque alpha byte appended to each pixel (documented:
+    /// "the alpha channel will be set to 255").
+    #[hegel::test]
+    fn prop_decode_rgb_as_rgba_adds_opaque_alpha(tc: hegel::TestCase) {
+        let colorspace = tc.draw((colorspace_gen()).print_as_debug());
+        let (width, height) = draw_dims(&tc, 2048);
+        let pixels = draw_pixels(&tc, (width * height) as usize, 3);
+        let encoded = Encoder::new(&pixels, width, height)
+            .unwrap()
+            .with_colorspace(colorspace)
+            .encode_to_vec()
+            .unwrap();
+
+        let converted =
+            Decoder::new(&encoded).unwrap().with_channels(Channels::Rgba).decode_to_vec().unwrap();
+        let expected: Vec<u8> =
+            pixels.chunks_exact(3).flat_map(|px| [px[0], px[1], px[2], 0xff]).collect();
+        assert_eq!(converted, expected);
+    }
+
+    /// KNOWN FAILURE (real bug, do not "fix" the test): decoding an RGBA image
+    /// with `with_channels(Rgb)` does NOT equal the native RGBA decode with the
+    /// alpha byte dropped, contradicting the documented behavior ("the alpha
+    /// channel will be ignored").
+    ///
+    /// Root cause: `decode_impl_slice::<3, true>` (src/decode.rs) tracks pixels
+    /// as `Pixel<3>` and rebuilds the color index via `px.as_rgba(0xff)`, i.e.
+    /// it hashes with alpha=255. The encoder indexed the same pixels with their
+    /// *true* alpha, so a `QOI_OP_INDEX` chunk referencing a pixel whose alpha
+    /// is not hash-equivalent to 255 (alpha not in {63, 127, 191, 255}, since
+    /// the hash is 3r+5g+7b+11a mod 64) looks up a slot the decoder never
+    /// wrote, producing wrong RGB values. The stream decoder
+    /// (`decode_impl_stream::<_, 3, true>`) has the same flaw (index of
+    /// `Pixel<3>`), and on top of it diverges from the slice decoder -- see
+    /// `test_decode_slice_vs_stream_divergence` below.
+    ///
+    /// The generator below constructs the counterexample family [A, B, A]
+    /// directly so the test fails deterministically on every case:
+    /// the encoder emits QOI_OP_INDEX for the third pixel, and the decoder's
+    /// alpha-255 index cannot resolve it to A's RGB values.
+    #[hegel::test]
+    fn prop_decode_rgba_as_rgb_drops_alpha(tc: hegel::TestCase) {
+        // alpha of A must not be hash-equivalent to 255 (11*(255-a) % 64 != 0)
+        let alpha = tc
+            .draw(generators::integers::<u8>().filter(|&a| ![63, 127, 191, 255].contains(&a)));
+        let r = tc.draw(generators::integers::<u8>());
+        let g = tc.draw(generators::integers::<u8>());
+        let b = tc.draw(generators::integers::<u8>());
+        // A's RGB must differ from the zero-initialized index entries
+        tc.assume(!(r == 0 && g == 0 && b == 0));
+        // B differs from A in red only; dr in 1..=63 keeps hash(B) != hash(A)
+        let dr = tc.draw(generators::integers::<u8>().min_value(1).max_value(63));
+        let a_px = [r, g, b, alpha];
+        let b_px = [r.wrapping_add(dr), g, b, alpha];
+        let pixels: Vec<u8> = [a_px, b_px, a_px].concat();
+
+        let encoded = qoi::encode_to_vec(&pixels, 3, 1).unwrap();
+        let converted =
+            Decoder::new(&encoded).unwrap().with_channels(Channels::Rgb).decode_to_vec().unwrap();
+        let expected: Vec<u8> =
+            pixels.chunks_exact(4).flat_map(|px| [px[0], px[1], px[2]]).collect();
+        assert_eq!(converted, expected);
+    }
+
+    /// Green sibling of prop_decode_rgba_as_rgb_drops_alpha (see the KNOWN
+    /// FAILURE comment there): the RGBA -> RGB conversion property does hold
+    /// when every alpha value is hash-equivalent to 255 (a in {63, 127, 191,
+    /// 255}), because then the decoder's alpha-255 index lands on the same
+    /// slots the encoder used. Restricting alpha this way keeps QOI_OP_RGBA
+    /// chunks and index reuse in play while excluding the known-buggy inputs.
+    #[hegel::test]
+    fn prop_decode_rgba_as_rgb_drops_alpha_hash_preserving(tc: hegel::TestCase) {
+        let colorspace = tc.draw((colorspace_gen()).print_as_debug());
+        let (width, height) = draw_dims(&tc, 2048);
+        let mut pixels = draw_pixels(&tc, (width * height) as usize, 4);
+        for px in pixels.chunks_exact_mut(4) {
+            px[3] = [63, 127, 191, 255][(px[3] >> 6) as usize];
+        }
+        let encoded = Encoder::new(&pixels, width, height)
+            .unwrap()
+            .with_colorspace(colorspace)
+            .encode_to_vec()
+            .unwrap();
+
+        let converted =
+            Decoder::new(&encoded).unwrap().with_channels(Channels::Rgb).decode_to_vec().unwrap();
+        let expected: Vec<u8> =
+            pixels.chunks_exact(4).flat_map(|px| [px[0], px[1], px[2]]).collect();
+        assert_eq!(converted, expected);
+    }
+
+    fn encode_to_vec_checked(pixels: &[u8], width: u32, height: u32) -> Vec<u8> {
+        qoi::encode_to_vec(pixels, width, height).unwrap()
+    }
+}
