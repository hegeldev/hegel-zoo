new file mode 100644
index 0000000..35f37d8
--- /dev/null
+++ b/varisat/src/test_helpers.rs
@@ -0,0 +1,166 @@
+//! Shared helpers for hegel property-based tests.
+//!
+//! This module is only compiled for tests. It contains hegel generators for CNF formulas and a
+//! brute-force satisfiability oracle used to cross-check the solver on small instances.
+use hegel::generators;
+use hegel::Generator;
+
+use varisat_formula::{CnfFormula, Lit};
+
+/// Generate an arbitrary literal over the variables `0..var_count`.
+#[hegel::composite]
+pub fn arb_lit(tc: &hegel::TestCase, var_count: usize) -> Lit {
+    let index = tc.draw(generators::integers::<usize>().max_value(var_count - 1));
+    let polarity = tc.draw(generators::booleans());
+    Lit::from_index(index, polarity)
+}
+
+/// Generate an arbitrary clause list over a small number of variables.
+///
+/// The variable count is bounded so that the brute-force oracle
+/// ([`brute_force_is_sat`]) stays cheap — this bound protects the test's resources, not the
+/// solver's contract. Clauses may be empty and may contain duplicate or contradicting literals.
+#[hegel::composite]
+pub fn small_clause_list(
+    tc: &hegel::TestCase,
+    max_vars: usize,
+    max_clauses: usize,
+) -> Vec<Vec<Lit>> {
+    let var_count = tc.draw(
+        generators::integers::<usize>()
+            .min_value(1)
+            .max_value(max_vars),
+    );
+    tc.draw(
+        (generators::vecs(generators::vecs(arb_lit(var_count)).max_size(5)).max_size(max_clauses)).print_as_debug(),
+    )
+}
+
+/// Brute-force satisfiability check over all `2^var_count` assignments.
+///
+/// Returns `true` iff some assignment satisfies every clause. Only usable for small `var_count`.
+pub fn brute_force_is_sat(var_count: usize, clauses: &[Vec<Lit>]) -> bool {
+    assert!(var_count <= 16, "brute force oracle limited to 16 variables");
+    (0u32..(1u32 << var_count)).any(|bits| {
+        clauses.iter().all(|clause| {
+            clause
+                .iter()
+                .any(|lit| (((bits >> lit.index()) & 1) == 1) == lit.is_positive())
+        })
+    })
+}
+
+/// Check that a model (as returned by `Solver::model`) satisfies every clause.
+pub fn model_satisfies(model: &[Lit], clauses: impl IntoIterator<Item = impl AsRef<[Lit]>>) -> bool {
+    clauses
+        .into_iter()
+        .all(|clause| clause.as_ref().iter().any(|lit| model.contains(lit)))
+}
+
+/// Shuffle a slice using hegel-drawn indices (Fisher-Yates).
+pub fn hegel_shuffle<T>(tc: &hegel::TestCase, items: &mut [T]) {
+    for i in (1..items.len()).rev() {
+        let j = tc.draw_silent(generators::integers::<usize>().max_value(i));
+        items.swap(i, j);
+    }
+}
+
+/// Generate small hard unsat instances.
+///
+/// Hegel port of the sgen construction in `varisat_formula::test::sgen_unsat_formula`
+/// (http://www.cs.qub.ac.uk/~i.spence/sgen/ with random partitions). The formula is
+/// unsatisfiable by a counting argument, independent of the random choices.
+#[hegel::composite]
+pub fn sgen_unsat_formula(tc: &hegel::TestCase, max_blocks: usize) -> CnfFormula {
+    let blocks = tc.draw(
+        generators::integers::<usize>()
+            .min_value(1)
+            .max_value(max_blocks),
+    );
+    let mut lits: Vec<Lit> = (0..blocks * 4 + 1)
+        .map(|index| {
+            let polarity = tc.draw_silent(generators::booleans());
+            Lit::from_index(index, polarity)
+        })
+        .collect();
+
+    let mut clauses: Vec<Vec<Lit>> = vec![];
+
+    for &invert in [false, true].iter() {
+        hegel_shuffle(&tc, &mut lits);
+        for block in lits.chunks_exact(4) {
+            for a in 0..4 {
+                for b in 0..a {
+                    for c in 0..b {
+                        let mut clause =
+                            vec![block[a] ^ invert, block[b] ^ invert, block[c] ^ invert];
+                        hegel_shuffle(&tc, &mut clause);
+                        clauses.push(clause);
+                    }
+                }
+            }
+        }
+        let &lit_a = lits.last().unwrap();
+        for b in 0..4 {
+            for c in 0..b {
+                let mut clause = vec![lit_a ^ invert, lits[b] ^ invert, lits[c] ^ invert];
+                hegel_shuffle(&tc, &mut clause);
+                clauses.push(clause);
+            }
+        }
+    }
+
+    hegel_shuffle(&tc, &mut clauses);
+    CnfFormula::from(clauses)
+}
+
+/// Generate a satisfiable instance together with clauses that are satisfied by a hidden
+/// assignment.
+///
+/// Hegel port of `varisat_formula::test::sat_formula`: draw a full assignment, then emit only
+/// clauses containing at least one literal that is true under that assignment.
+#[hegel::composite]
+pub fn sat_formula(tc: &hegel::TestCase) -> CnfFormula {
+    let vars = tc.draw(
+        generators::integers::<usize>()
+            .min_value(4)
+            .max_value(20),
+    );
+    let clause_count = tc.draw(
+        generators::integers::<usize>()
+            .min_value(10)
+            .max_value(100),
+    );
+    // Percentage chance for any given other literal to be included in a clause.
+    let density_pct = tc.draw(generators::integers::<u8>().min_value(5).max_value(20));
+    // Percentage chance for an included literal to be negated wrt the satisfying assignment.
+    let flip_pct = tc.draw(generators::integers::<u8>().min_value(90).max_value(100));
+
+    // The hidden satisfying assignment: lits[i] is true under it.
+    let lits: Vec<Lit> = (0..vars)
+        .map(|index| {
+            let polarity = tc.draw_silent(generators::booleans());
+            Lit::from_index(index, polarity)
+        })
+        .collect();
+
+    let mut clauses: Vec<Vec<Lit>> = vec![];
+    for _ in 0..clause_count {
+        let fixed = tc.draw_silent(generators::integers::<usize>().max_value(vars - 1));
+        let mut clause = vec![lits[fixed]];
+        for (i, &lit) in lits.iter().enumerate() {
+            if i != fixed
+                && tc.draw_silent(generators::integers::<u8>().max_value(99)) < density_pct
+            {
+                let flip =
+                    tc.draw_silent(generators::integers::<u8>().max_value(99)) < flip_pct;
+                clause.push(lit ^ flip);
+            }
+        }
+        hegel_shuffle(&tc, &mut clause);
+        clauses.push(clause);
+    }
+
+    hegel_shuffle(&tc, &mut clauses);
+    CnfFormula::from(clauses)
+}
