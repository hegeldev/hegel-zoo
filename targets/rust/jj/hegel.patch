+/// Hegel translation of [`arb_expression`] above: draws an arbitrary resolved
+/// revset expression. Recursion is bounded by `depth`.
+fn draw_expression(
+    tc: &hegel::TestCase,
+    known_commits: &[CommitId],
+    visible_heads: &[Vec<CommitId>],
+    depth: u64,
+) -> Arc<ResolvedRevsetExpression> {
+    use hegel::generators;
+    let draw_index = |max: u8| tc.draw(generators::integers::<u8>().max_value(max));
+    let draw_small = || tc.draw(generators::integers::<u64>().max_value(4));
+    // Weight toward compound expressions until the depth budget runs out.
+    if depth == 0 || draw_index(3) == 0 {
+        match draw_index(6) {
+            0 => RevsetExpression::none(),
+            1 => RevsetExpression::all(),
+            2 => RevsetExpression::visible_heads(),
+            3 => RevsetExpression::root(),
+            4 => RevsetExpression::forks(),
+            5 => {
+                let indexes: Vec<usize> = tc.draw(
+                    generators::vecs(
+                        generators::integers::<usize>().max_value(known_commits.len() - 1),
+                    )
+                    .min_size(1)
+                    .max_size(5)
+                    .unique(true),
+                );
+                RevsetExpression::commits(
+                    indexes
+                        .iter()
+                        .sorted()
+                        .map(|&i| known_commits[i].clone())
+                        .collect(),
+                )
+            }
+            // Use merges() as a filter that isn't constant, like the proptest
+            // version above.
+            _ => RevsetExpression::filter(RevsetFilterPredicate::ParentCount(2..u32::MAX)),
+        }
+    } else {
+        let sub = || draw_expression(tc, known_commits, visible_heads, depth - 1);
+        match draw_index(23) {
+            // Ancestors
+            0 => sub().parents(),
+            1 => sub().ancestors(),
+            2 => sub().ancestors_range(0..draw_small()),
+            // Descendants
+            3 => sub().children(),
+            4 => sub().descendants(),
+            5 => sub().descendants_range(0..draw_small()),
+            // First ancestors
+            6 => sub().first_ancestors_at(1),
+            7 => sub().first_ancestors(),
+            8 => sub().first_ancestors_range(0..draw_small()),
+            // Range
+            9 => sub().range(&sub()),
+            // DagRange
+            10 => sub().dag_range_to(&sub()),
+            11 => sub().connected(),
+            // Reachable
+            12 => sub().reachable(&sub()),
+            // Heads
+            13 => sub().heads(),
+            // Roots
+            14 => sub().roots(),
+            // ForkPoint
+            15 => sub().fork_point(),
+            // MergePoint
+            16 => sub().merge_point(),
+            // Latest
+            17 => sub().latest(draw_small() as usize),
+            // AtOperation (or WithinVisibility)
+            18 => {
+                let index =
+                    tc.draw(generators::integers::<usize>().max_value(visible_heads.len() - 1));
+                Arc::new(RevsetExpression::WithinVisibility {
+                    candidates: sub(),
+                    visible_heads: visible_heads[index].clone(),
+                })
+            }
+            // Coalesce (in binary form)
+            19 => RevsetExpression::coalesce(&[sub(), sub()]),
+            // General set operations
+            20 => sub().negated(),
+            21 => sub().union(&sub()),
+            22 => sub().intersection(&sub()),
+            _ => sub().minus(&sub()),
+        }
+    }
+}
+
+fn assert_optimized_matches_unoptimized(
+    repo: &dyn Repo,
+    expression: &Arc<ResolvedRevsetExpression>,
+) {
+    let optimized_revset = expression.clone().evaluate(repo).unwrap();
+    let unoptimized_revset = expression.clone().evaluate_unoptimized(repo).unwrap();
+    let optimized_ids: Vec<_> = optimized_revset.stream().try_collect().block_on().unwrap();
+    let unoptimized_ids: Vec<_> = unoptimized_revset
+        .stream()
+        .try_collect()
+        .block_on()
+        .unwrap();
+    assert_eq!(
+        optimized_ids, unoptimized_ids,
+        "expression: {expression:#?}"
+    );
+}
+
+/// Property: an optimized revset evaluates to the same commits as the
+/// original expression (same property as the proptest tests above), but on a
+/// freshly generated commit graph per test case rather than a fixed one.
+#[test]
+fn test_optimize_equivalence_generated_graphs() -> TestResult {
+    use hegel::generators;
+
+    let settings = stable_settings();
+    let test_repo = TestRepo::init_with_settings(&settings);
+    let repo = test_repo.repo;
+
+    hegel::Hegel::new(|tc| {
+        // Build an arbitrary commit graph in a transaction that is discarded
+        // at the end of the test case.
+        let mut tx = repo.start_transaction();
+        let root = repo.store().root_commit();
+        let root_id = root.id().clone();
+        let mut commits = vec![root];
+        let num_commits = tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+        for i in 0..num_commits {
+            let max_parents = 3.min(commits.len());
+            let num_parents = tc.draw(
+                generators::integers::<usize>()
+                    .min_value(1)
+                    .max_value(max_parents),
+            );
+            let parent_indexes: Vec<usize> = if num_parents == 1 {
+                vec![tc.draw(generators::integers::<usize>().max_value(commits.len() - 1))]
+            } else {
+                // The root commit (index 0) cannot be merged with other
+                // commits, so exclude it from multi-parent draws.
+                tc.draw(
+                    generators::vecs(
+                        generators::integers::<usize>()
+                            .min_value(1)
+                            .max_value(commits.len() - 1),
+                    )
+                    .min_size(num_parents)
+                    .max_size(num_parents)
+                    .unique(true),
+                )
+            };
+            let parents = parent_indexes
+                .iter()
+                .sorted()
+                .map(|&index| commits[index].clone())
+                .collect_vec();
+            let commit = write_new_commit(tx.repo_mut(), &format!("c{i}"), &parents);
+            commits.push(commit);
+        }
+
+        let commit_ids = commits.iter().map(|c| c.id().clone()).collect_vec();
+        let current_heads = tx
+            .repo()
+            .view()
+            .heads()
+            .iter()
+            .cloned()
+            .sorted()
+            .collect_vec();
+        let visible_heads = vec![vec![root_id], current_heads];
+
+        let expression = draw_expression(&tc, &commit_ids, &visible_heads, 4);
+        tc.note(&format!("expression: {expression:#?}"));
+        assert_optimized_matches_unoptimized(tx.repo(), &expression);
+    })
+    // Match the case count the proptest tests above run with by default.
+    .settings(hegel::Settings::new().test_cases(256))
+    .run();
+    Ok(())
+}
