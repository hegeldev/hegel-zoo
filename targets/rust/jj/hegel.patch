+/// Formerly a KNOWN FAILURE (jj/1): pinned a real bug in the materialize/parse
+/// round trip, fixed upstream (jj-vcs/jj#9868); kept as a regression test.
+///
+/// If a conflict term's content ended with a lone CR (a `\r` not followed by
+/// `\n`), the term did not end with an EOL, so
+/// `materialize_conflict_hunks()` "spreads" the detected EOL (`\n`) to every
+/// side as a separator. When `parse_conflict()` removes the separator again,
+/// it pops the `\n` *and* a preceding `\r` (assuming a CRLF separator), which
+/// eats the `\r` that was real content. The parsed hunks then differ from the
+/// materialized ones, so `update_from_content()` considers an *unmodified*
+/// working-copy file changed and silently rewrites the conflict, dropping the
+/// `\r` from the base/side contents.
+///
+/// Minimal counterexample: contents `["", "\r", ""]` with `SameChange::Keep`
+/// materialize to a conflict whose parse yields `["", "", ""]`.
+///
+/// Code path: `conflicts::materialize_conflict_hunks()` (EOL spreading) +
+/// `conflicts::parse_conflict()` (`term.pop_if(.. b'\n')` followed by
+/// `term.pop_if(.. b'\r')`).
+#[hegel::test]
+fn test_materialize_parse_roundtrip_lone_cr(tc: hegel::TestCase) {
+    // Generator boosted to the buggy region so the failure reproduces on
+    // every run: the base term always ends with a lone CR.
+    let base: BString = {
+        let mut term = tc.draw((generators::from_regex(r"(\n|[ab]){0,8}").map(BString::from)).print_as_debug());
+        term.push(b'\r');
+        term
+    };
+    let contents = Merge::from_vec(vec![BString::from(""), base, BString::from("")]);
+    let marker_style = tc.draw((generators::sampled_from(vec![
+        ConflictMarkerStyle::Diff,
+        ConflictMarkerStyle::DiffExperimental,
+        ConflictMarkerStyle::Snapshot,
+        ConflictMarkerStyle::Git,
+    ])).print_as_debug());
+    let options = ConflictMaterializeOptions {
+        marker_style,
+        marker_len: None,
+        merge: MergeOptions {
+            hunk_level: FileMergeHunkLevel::Line,
+            // Keep, so that the two identical empty sides don't resolve
+            // trivially.
+            same_change: SameChange::Keep,
+        },
+    };
+
+    let materialized =
+        materialize_merge_result_to_bytes(&contents, &ConflictLabels::unlabeled(), &options);
+    match merge_hunks(&contents, &options.merge) {
+        MergeResult::Resolved(resolved) => assert_eq!(materialized, resolved),
+        MergeResult::Conflict(expected_hunks) => {
+            let marker_len = choose_materialized_conflict_marker_len(&contents);
+            let parsed = parse_conflict(&materialized, contents.num_sides(), marker_len);
+            assert_eq!(
+                parsed,
+                Some(expected_hunks),
+                "materialized content:\n{materialized}"
+            );
+        }
+    }
