+/// Property-based tests (hegel) for the `Vote` ordering semantics.
+#[cfg(test)]
+mod hegel_props {
+    use std::cmp::Ordering;
+
+    use hegel::generators;
+    use hegel::Generator;
+
+    use crate::Vote;
+    use crate::vote::leader_id_std;
+
+    type StdLeaderId = leader_id_std::LeaderId<u64, u64>;
+    type AdvLeaderId = crate::impls::leader_id_adv::LeaderId<u64, u64>;
+
+    /// Terms and node ids are mostly small so that equal-term and equal-node
+    /// collisions (where the interesting comparison rules live) are common;
+    /// occasionally full-range values cover boundaries.
+    #[hegel::composite]
+    fn small_or_any_u64(tc: &hegel::TestCase) -> u64 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u64>().max_value(2),
+            generators::integers::<u64>(),
+        ))
+    }
+
+    /// A `Vote` as constructible through the public constructors
+    /// (`voted_for` is always `Some`).
+    #[hegel::composite]
+    fn arb_std_vote(tc: &hegel::TestCase) -> Vote<StdLeaderId> {
+        let term = tc.draw(small_or_any_u64());
+        let node_id = tc.draw(small_or_any_u64());
+        if tc.draw(generators::booleans()) {
+            Vote::new_committed(term, node_id)
+        } else {
+            Vote::new(term, node_id)
+        }
+    }
+
+    /// A `Vote` over the full public field space: `LeaderId.voted_for` is
+    /// `pub` and `Option`, so `None` is publicly constructible (and reachable
+    /// through serde).
+    #[hegel::composite]
+    fn arb_std_vote_full(tc: &hegel::TestCase) -> Vote<StdLeaderId> {
+        let term = tc.draw(small_or_any_u64());
+        let voted_for = tc.draw(generators::optional(small_or_any_u64()));
+        Vote {
+            leader_id: StdLeaderId { term, voted_for },
+            committed: tc.draw(generators::booleans()),
+        }
+    }
+
+    #[hegel::composite]
+    fn arb_adv_vote(tc: &hegel::TestCase) -> Vote<AdvLeaderId> {
+        let term = tc.draw(small_or_any_u64());
+        let node_id = tc.draw(small_or_any_u64());
+        if tc.draw(generators::booleans()) {
+            Vote::new_committed(term, node_id)
+        } else {
+            Vote::new(term, node_id)
+        }
+    }
+
+    /// `Vote<leader_id_adv>` is documented as totally ordered: term first,
+    /// then node id, and a committed vote is greater than a non-committed one.
+    /// Check against a lexicographic tuple oracle.
+    #[hegel::test]
+    fn hegel_adv_vote_order_matches_tuple_oracle(tc: hegel::TestCase) {
+        let a = tc.draw((arb_adv_vote()).print_as_debug());
+        let b = tc.draw((arb_adv_vote()).print_as_debug());
+
+        let key = |v: &Vote<AdvLeaderId>| (v.leader_id.term, v.leader_id.node_id, v.committed);
+
+        assert_eq!(Some(key(&a).cmp(&key(&b))), a.partial_cmp(&b));
+    }
+
+    /// `partial_cmp` must be a dual: comparing `(b, a)` yields the reverse of
+    /// comparing `(a, b)`, and `Some(Equal)` must coincide with `==`.
+    #[hegel::test]
+    fn hegel_std_vote_partial_cmp_duality(tc: hegel::TestCase) {
+        let a = tc.draw((arb_std_vote()).print_as_debug());
+        let b = tc.draw((arb_std_vote()).print_as_debug());
+
+        assert_eq!(a.partial_cmp(&b), b.partial_cmp(&a).map(Ordering::reverse));
+        assert_eq!(a == b, a.partial_cmp(&b) == Some(Ordering::Equal));
+    }
+
+    /// `partial_cmp` must be transitive: `a <= b` and `b <= c` imply `a <= c`.
+    /// This is required for `PartialOrd` and is what lets vote-granting
+    /// decisions chain safely.
+    #[hegel::test]
+    fn hegel_std_vote_partial_cmp_transitive(tc: hegel::TestCase) {
+        let a = tc.draw((arb_std_vote()).print_as_debug());
+        let b = tc.draw((arb_std_vote()).print_as_debug());
+        let c = tc.draw((arb_std_vote()).print_as_debug());
+
+        if a <= b && b <= c {
+            assert!(a <= c, "transitivity violated: {a} <= {b} <= {c} but not {a} <= {c}");
+        }
+        if a >= b && b >= c {
+            assert!(a >= c, "transitivity violated: {a} >= {b} >= {c} but not {a} >= {c}");
+        }
+    }
+
+    /// Comparing any two publicly-constructible votes must not panic, even
+    /// when `voted_for` is `None` (all `Vote` and `LeaderId` fields are `pub`,
+    /// and serde accepts `"voted_for": null`).
+    #[hegel::test]
+    fn hegel_std_vote_partial_cmp_no_panic_on_full_domain(tc: hegel::TestCase) {
+        let a = tc.draw((arb_std_vote_full()).print_as_debug());
+        let b = tc.draw((arb_std_vote_full()).print_as_debug());
+
+        // KNOWN FAILURE exclusion: equal-term comparisons involving
+        // `voted_for: None` panic; that bug is pinned by
+        // `hegel_std_vote_partial_cmp_none_voted_for_panics` below. Skip the
+        // known-buggy input class so this property keeps checking the rest.
+        if a.leader_id.term == b.leader_id.term && (a.leader_id.voted_for.is_none() || b.leader_id.voted_for.is_none())
+        {
+            return;
+        }
+
+        let _ = a.partial_cmp(&b);
+    }
+
+    /// KNOWN FAILURE: comparing two `Vote<leader_id_std::LeaderId>` with equal
+    /// terms panics when either side has `voted_for: None`, because
+    /// `LeaderIdCompare::std` calls `RaftLeaderId::node_id()`, which is
+    /// `self.voted_for.as_ref().unwrap()` (leader_id_std.rs).
+    ///
+    /// `voted_for` is a `pub` field of type `Option<NID>`, `Display` renders
+    /// the `None` case, and the serde format accepts `"voted_for": null`, so
+    /// such votes are publicly constructible; `PartialOrd` must not panic on
+    /// them. Minimal counterexample: both sides
+    /// `Vote { leader_id: LeaderId { term: 0, voted_for: None }, committed: false }`.
+    ///
+    /// This test fails deterministically (every generated case hits the bug)
+    /// until the comparison handles `voted_for: None`.
+    #[hegel::test]
+    fn hegel_std_vote_partial_cmp_none_voted_for_panics(tc: hegel::TestCase) {
+        let term = tc.draw(small_or_any_u64());
+
+        // At least one side has `voted_for: None`; terms are equal so the
+        // node-id comparison is reached.
+        let voted_for_a = tc.draw(generators::optional(small_or_any_u64()));
+        let voted_for_b = if voted_for_a.is_some() {
+            None
+        } else {
+            tc.draw(generators::optional(small_or_any_u64()))
+        };
+
+        let a = Vote {
+            leader_id: StdLeaderId {
+                term,
+                voted_for: voted_for_a,
+            },
+            committed: tc.draw(generators::booleans()),
+        };
+        let b = Vote {
+            leader_id: StdLeaderId {
+                term,
+                voted_for: voted_for_b,
+            },
+            committed: tc.draw(generators::booleans()),
+        };
+
+        let _ = a.partial_cmp(&b);
+    }
+
+    /// Serde round-trip for both leader-id flavors of `Vote`.
+    #[cfg(feature = "serde")]
+    #[hegel::test]
+    fn hegel_vote_serde_roundtrip(tc: hegel::TestCase) {
+        let std_vote = tc.draw(arb_std_vote_full());
+        let s = serde_json::to_string(&std_vote).unwrap();
+        let back: Vote<StdLeaderId> = serde_json::from_str(&s).unwrap();
+        assert_eq!(std_vote, back);
+
+        let adv_vote = tc.draw(arb_adv_vote());
+        let s = serde_json::to_string(&adv_vote).unwrap();
+        let back: Vote<AdvLeaderId> = serde_json::from_str(&s).unwrap();
+        assert_eq!(adv_vote, back);
+    }
+}
