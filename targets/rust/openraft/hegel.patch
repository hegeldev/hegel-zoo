diff --git a/openraft/src/log_id/mod.rs b/openraft/src/log_id/mod.rs
index 2a2fdf4..5078fc4 100644
--- a/openraft/src/log_id/mod.rs
+++ b/openraft/src/log_id/mod.rs
@@ -196,3 +196,52 @@ mod tests {
         assert_eq!(100, index);
     }
 }
+
+/// Property-based tests (hegel) for `LogId` ordering.
+#[cfg(test)]
+mod hegel_props {
+    use hegel::generators;
+
+    use super::LogId;
+    use crate::vote::leader_id_std;
+
+    /// Terms, node ids and indexes are mostly small so that ties on each
+    /// component are common; occasionally full-range values cover boundaries.
+    #[hegel::composite]
+    fn small_or_any_u64(tc: &hegel::TestCase) -> u64 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u64>().max_value(2),
+            generators::integers::<u64>(),
+        ))
+    }
+
+    /// The module docs promise: log ids are ordered by leader id
+    /// (term, then node id), then by index. Check both leader-id flavors
+    /// against lexicographic tuple oracles.
+    #[hegel::test]
+    fn hegel_log_id_order_matches_tuple_oracle(tc: hegel::TestCase) {
+        // Multi-leader-per-term (adv) log ids order by (term, node_id, index).
+        let a = (
+            tc.draw(small_or_any_u64()),
+            tc.draw(small_or_any_u64()),
+            tc.draw(small_or_any_u64()),
+        );
+        let b = (
+            tc.draw(small_or_any_u64()),
+            tc.draw(small_or_any_u64()),
+            tc.draw(small_or_any_u64()),
+        );
+
+        let adv = |(term, node_id, index): (u64, u64, u64)| crate::engine::testing::log_id(term, node_id, index);
+        assert_eq!(a.cmp(&b), adv(a).cmp(&adv(b)));
+        assert_eq!(Some(a.cmp(&b)), adv(a).partial_cmp(&adv(b)));
+
+        // Standard-raft (std) log ids order by (term, index).
+        let x = (tc.draw(small_or_any_u64()), tc.draw(small_or_any_u64()));
+        let y = (tc.draw(small_or_any_u64()), tc.draw(small_or_any_u64()));
+
+        let std_lid =
+            |(term, index): (u64, u64)| LogId::<leader_id_std::CommittedLeaderId<u64>>::new_term_index(term, index);
+        assert_eq!(x.cmp(&y), std_lid(x).cmp(&std_lid(y)));
+    }
+}
diff --git a/openraft/src/membership/membership_test.rs b/openraft/src/membership/membership_test.rs
index 13a989e..51085d4 100644
--- a/openraft/src/membership/membership_test.rs
+++ b/openraft/src/membership/membership_test.rs
@@ -551,3 +551,145 @@ fn test_is_direct_append_compatible_implies_intersecting_quorums() {
         }
     }
 }
+
+// ---
+// Property-based tests (hegel).
+// ---
+
+use hegel::generators;
+use hegel::Generator;
+
+use crate::quorum::QuorumIntersection;
+
+/// Node ids come from a small pool so that voters, learners and change
+/// requests overlap often.
+#[hegel::composite]
+fn node_id(tc: &hegel::TestCase) -> u64 {
+    tc.draw(generators::integers::<u64>().max_value(6))
+}
+
+#[hegel::composite]
+fn id_set(tc: &hegel::TestCase, min_size: usize) -> BTreeSet<u64> {
+    tc.draw(generators::vecs(node_id()).min_size(min_size).max_size(5)).into_iter().collect()
+}
+
+/// A valid `Membership`: a joint of 1 or 2 non-empty configs, plus a few
+/// learners; every voter has a node entry.
+#[hegel::composite]
+fn arb_membership(tc: &hegel::TestCase) -> Membership<u64, ()> {
+    let config_count = tc.draw(generators::integers::<usize>().min_value(1).max_value(2));
+    let configs: Vec<BTreeSet<u64>> = (0..config_count).map(|_| tc.draw(id_set(1))).collect();
+
+    let learners: BTreeSet<u64> = tc.draw(id_set(0));
+
+    let mut nodes = BTreeMap::new();
+    for id in configs.iter().flatten().chain(learners.iter()) {
+        nodes.insert(*id, ());
+    }
+
+    let m = Membership::new_unchecked(configs, nodes);
+    m.ensure_valid().unwrap();
+    m
+}
+
+/// A single (non-batch) membership change request.
+#[hegel::composite]
+fn simple_change(tc: &hegel::TestCase) -> ChangeMembers<u64, ()> {
+    let ids = |tc: &hegel::TestCase| tc.draw(id_set(0));
+    let nodes = |tc: &hegel::TestCase| tc.draw(id_set(0)).into_iter().map(|id| (id, ())).collect::<BTreeMap<u64, ()>>();
+
+    match tc.draw(generators::integers::<u8>().max_value(7)) {
+        0 => ChangeMembers::AddVoterIds(ids(&tc)),
+        1 => ChangeMembers::AddVoters(nodes(&tc)),
+        2 => ChangeMembers::RemoveVoters(ids(&tc)),
+        3 => ChangeMembers::ReplaceAllVoters(ids(&tc)),
+        4 => ChangeMembers::AddNodes(nodes(&tc)),
+        5 => ChangeMembers::SetNodes(nodes(&tc)),
+        6 => ChangeMembers::RemoveNodes(ids(&tc)),
+        _ => ChangeMembers::ReplaceAllNodes(nodes(&tc)),
+    }
+}
+
+#[hegel::composite]
+fn arb_change(tc: &hegel::TestCase) -> ChangeMembers<u64, ()> {
+    if tc.draw(generators::booleans()) {
+        let n = tc.draw(generators::integers::<usize>().max_value(3));
+        ChangeMembers::Batch((0..n).map(|_| tc.draw((simple_change()).print_as_debug())).collect())
+    } else {
+        tc.draw((simple_change()).print_as_debug())
+    }
+}
+
+/// Documented contract of `next_coherent`: repeatedly stepping toward a goal
+/// config reaches the uniform goal config within two steps, and each step is
+/// coherent with the previous one (shares a config with it, which is what
+/// `QuorumIntersection::intersects_with` answers `Some(true)` for; the
+/// `Coherent` trait this used to call moved out with the `quorum-set` crate).
+#[hegel::test]
+fn hegel_next_coherent_reaches_goal_within_two_steps(tc: hegel::TestCase) {
+    let m = tc.draw((arb_membership()).print_as_debug());
+    let goal: BTreeSet<u64> = tc.draw(id_set(1));
+    let retain = tc.draw(generators::booleans());
+
+    let step1 = m.next_coherent(goal.clone(), retain);
+    let step2 = step1.next_coherent(goal.clone(), retain);
+
+    assert!(
+        m.get_joint_config().intersects_with(step1.get_joint_config()) == Some(true),
+        "{m} must be coherent with next step {step1}"
+    );
+    assert!(
+        step1.get_joint_config().intersects_with(step2.get_joint_config()) == Some(true),
+        "{step1} must be coherent with next step {step2}"
+    );
+    assert_eq!(
+        &vec![goal.clone()],
+        step2.get_joint_config(),
+        "two steps from {m} must reach the uniform goal config"
+    );
+}
+
+/// A successful `Membership::change()` must yield a valid membership whose
+/// config is coherent with the previous config, and whose voters and learners
+/// partition the node set.
+#[hegel::test]
+fn hegel_membership_change_yields_valid_coherent_membership(tc: hegel::TestCase) {
+    let m = tc.draw((arb_membership()).print_as_debug());
+    let change = tc.draw((arb_change()).print_as_debug());
+    let retain = tc.draw(generators::booleans());
+
+    let old_configs = m.get_joint_config().clone();
+
+    let Ok(new) = m.change(change, retain) else {
+        // Rejected changes are outside this property; validity of the error
+        // itself is covered by unit tests above.
+        return;
+    };
+
+    new.ensure_valid().unwrap();
+
+    assert!(
+        old_configs.intersects_with(new.get_joint_config()) == Some(true),
+        "old configs {old_configs:?} must be coherent with new configs {:?}",
+        new.get_joint_config()
+    );
+
+    let voters = new.voter_ids().collect::<BTreeSet<_>>();
+    let learners = new.learner_ids().collect::<BTreeSet<_>>();
+    let all_nodes = new.nodes().map(|(id, _)| *id).collect::<BTreeSet<_>>();
+
+    assert!(voters.is_disjoint(&learners));
+    assert_eq!(all_nodes, voters.union(&learners).copied().collect::<BTreeSet<_>>());
+}
+
+/// Serde round-trip: a valid `Membership` survives serialization to JSON.
+#[cfg(feature = "serde")]
+#[hegel::test]
+fn hegel_membership_serde_roundtrip(tc: hegel::TestCase) {
+    let m = tc.draw((arb_membership()).print_as_debug());
+
+    let s = serde_json::to_string(&m).unwrap();
+    let m2: Membership<u64, ()> = serde_json::from_str(&s).unwrap();
+
+    assert_eq!(m, m2);
+}
diff --git a/openraft/src/vote/vote.rs b/openraft/src/vote/vote.rs
index fdbcb16..b7e20fd 100644
--- a/openraft/src/vote/vote.rs
+++ b/openraft/src/vote/vote.rs
@@ -258,3 +258,139 @@ mod tests {
         }
     }
 }
+
+/// Property-based tests (hegel) for the `Vote` ordering semantics.
+#[cfg(test)]
+mod hegel_props {
+    use std::cmp::Ordering;
+
+    use hegel::generators;
+    use hegel::Generator;
+
+    use crate::Vote;
+    use crate::vote::leader_id_std;
+
+    type StdLeaderId = leader_id_std::LeaderId<u64, u64>;
+    type AdvLeaderId = crate::impls::leader_id_adv::LeaderId<u64, u64>;
+
+    /// Terms and node ids are mostly small so that equal-term and equal-node
+    /// collisions (where the interesting comparison rules live) are common;
+    /// occasionally full-range values cover boundaries.
+    #[hegel::composite]
+    fn small_or_any_u64(tc: &hegel::TestCase) -> u64 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u64>().max_value(2),
+            generators::integers::<u64>(),
+        ))
+    }
+
+    /// A `Vote` as constructible through the public constructors
+    /// (`voted_for` is always `Some`).
+    #[hegel::composite]
+    fn arb_std_vote(tc: &hegel::TestCase) -> Vote<StdLeaderId> {
+        let term = tc.draw(small_or_any_u64());
+        let node_id = tc.draw(small_or_any_u64());
+        if tc.draw(generators::booleans()) {
+            Vote::new_committed(term, node_id)
+        } else {
+            Vote::new(term, node_id)
+        }
+    }
+
+    /// A `Vote` over the full public field space (`Vote` and `LeaderId` fields
+    /// are `pub`). `voted_for` used to be `Option<NID>`, and `None` — publicly
+    /// constructible and reachable through serde — made equal-term comparisons
+    /// panic (openraft/1); upstream removed the `Option`, so the field is now a
+    /// plain node id and that state no longer exists.
+    #[hegel::composite]
+    fn arb_std_vote_full(tc: &hegel::TestCase) -> Vote<StdLeaderId> {
+        let term = tc.draw(small_or_any_u64());
+        let voted_for = tc.draw(small_or_any_u64());
+        Vote {
+            leader_id: StdLeaderId { term, voted_for },
+            committed: tc.draw(generators::booleans()),
+        }
+    }
+
+    #[hegel::composite]
+    fn arb_adv_vote(tc: &hegel::TestCase) -> Vote<AdvLeaderId> {
+        let term = tc.draw(small_or_any_u64());
+        let node_id = tc.draw(small_or_any_u64());
+        if tc.draw(generators::booleans()) {
+            Vote::new_committed(term, node_id)
+        } else {
+            Vote::new(term, node_id)
+        }
+    }
+
+    /// `Vote<leader_id_adv>` is documented as totally ordered: term first,
+    /// then node id, and a committed vote is greater than a non-committed one.
+    /// Check against a lexicographic tuple oracle.
+    #[hegel::test]
+    fn hegel_adv_vote_order_matches_tuple_oracle(tc: hegel::TestCase) {
+        let a = tc.draw((arb_adv_vote()).print_as_debug());
+        let b = tc.draw((arb_adv_vote()).print_as_debug());
+
+        let key = |v: &Vote<AdvLeaderId>| (v.leader_id.term, v.leader_id.node_id, v.committed);
+
+        assert_eq!(Some(key(&a).cmp(&key(&b))), a.partial_cmp(&b));
+    }
+
+    /// `partial_cmp` must be a dual: comparing `(b, a)` yields the reverse of
+    /// comparing `(a, b)`, and `Some(Equal)` must coincide with `==`.
+    #[hegel::test]
+    fn hegel_std_vote_partial_cmp_duality(tc: hegel::TestCase) {
+        let a = tc.draw((arb_std_vote()).print_as_debug());
+        let b = tc.draw((arb_std_vote()).print_as_debug());
+
+        assert_eq!(a.partial_cmp(&b), b.partial_cmp(&a).map(Ordering::reverse));
+        assert_eq!(a == b, a.partial_cmp(&b) == Some(Ordering::Equal));
+    }
+
+    /// `partial_cmp` must be transitive: `a <= b` and `b <= c` imply `a <= c`.
+    /// This is required for `PartialOrd` and is what lets vote-granting
+    /// decisions chain safely.
+    #[hegel::test]
+    fn hegel_std_vote_partial_cmp_transitive(tc: hegel::TestCase) {
+        let a = tc.draw((arb_std_vote()).print_as_debug());
+        let b = tc.draw((arb_std_vote()).print_as_debug());
+        let c = tc.draw((arb_std_vote()).print_as_debug());
+
+        if a <= b && b <= c {
+            assert!(a <= c, "transitivity violated: {a} <= {b} <= {c} but not {a} <= {c}");
+        }
+        if a >= b && b >= c {
+            assert!(a >= c, "transitivity violated: {a} >= {b} >= {c} but not {a} >= {c}");
+        }
+    }
+
+    /// Comparing any two publicly-constructible votes must not panic (all
+    /// `Vote` and `LeaderId` fields are `pub`).
+    ///
+    /// Until upstream made `voted_for` a plain node id, this had to skip
+    /// equal-term pairs with `voted_for: None`, whose comparison panicked
+    /// (openraft/1, pinned by the now-removed
+    /// `hegel_std_vote_partial_cmp_none_voted_for_panics`: `LeaderIdCompare::std`
+    /// unwrapped `voted_for`). That input class is no longer expressible.
+    #[hegel::test]
+    fn hegel_std_vote_partial_cmp_no_panic_on_full_domain(tc: hegel::TestCase) {
+        let a = tc.draw((arb_std_vote_full()).print_as_debug());
+        let b = tc.draw((arb_std_vote_full()).print_as_debug());
+        let _ = a.partial_cmp(&b);
+    }
+
+    /// Serde round-trip for both leader-id flavors of `Vote`.
+    #[cfg(feature = "serde")]
+    #[hegel::test]
+    fn hegel_vote_serde_roundtrip(tc: hegel::TestCase) {
+        let std_vote = tc.draw((arb_std_vote_full()).print_as_debug());
+        let s = serde_json::to_string(&std_vote).unwrap();
+        let back: Vote<StdLeaderId> = serde_json::from_str(&s).unwrap();
+        assert_eq!(std_vote, back);
+
+        let adv_vote = tc.draw((arb_adv_vote()).print_as_debug());
+        let s = serde_json::to_string(&adv_vote).unwrap();
+        let back: Vote<AdvLeaderId> = serde_json::from_str(&s).unwrap();
+        assert_eq!(adv_vote, back);
+    }
+}
