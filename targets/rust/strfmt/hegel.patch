+// --------------------------------------------------------------------------- pinned bugs
+
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct NumCase {
+    key: String,
+    spec: Spec,
+    value: Number,
+}
+
+/// A key for the given spec and number.
+fn with_key(case: impl PrintableGenerator<(Spec, Number)>) -> impl PrintableGenerator<NumCase> {
+    hegel::tuples!(key(), case).map(|(key, (spec, value))| NumCase { key, spec, value })
+}
+
+const SIGNED_INT_TYPES: &[Option<char>] = &[None, Some('x'), Some('b'), Some('o'), Some('X')];
+const SIGNED_FLOAT_TYPES: &[Option<char>] = &[None, Some('e')];
+
+/// An integer in 0..=1000 with a width of 3..=12 and `+` (always without a type, half the
+/// time with one) or `#` (with a type, otherwise).
+fn signed_int() -> impl PrintableGenerator<(Spec, Number)> {
+    hegel::tuples!(wide_layout(3, 12), generators::sampled_from(SIGNED_INT_TYPES), generators::weighted_booleans(0.5), ints(0, 1000))
+        .map(|(layout, ty, signed, v)| {
+            let plus = ty.is_none() || signed;
+            (Spec { ty, plus, alt: ty.is_some() && !plus, ..layout }, Number::Int(v))
+        })
+}
+
+/// A float in eighths up to 125 with a width of 3..=12, `+`, the `e` type half the time and a
+/// precision up to 4 half the time.
+fn signed_float() -> impl PrintableGenerator<(Spec, Number)> {
+    hegel::tuples!(wide_layout(3, 12), generators::sampled_from(SIGNED_FLOAT_TYPES), maybe(0.5, size(0, 4)), ints(0, 1000))
+        .map(|(layout, ty, precision, v)| (Spec { ty, plus: true, precision, ..layout }, Number::Float(v as f64 / 8.0)))
+}
+
+/// strfmt/1: a `+` sign or `#` prefix is part of the padded field (`{x:>+7}` of 42 is
+/// `    +42`), not written before it.
+#[hegel::test]
+fn sign_and_prefix_are_inside_the_width(tc: TestCase) {
+    let NumCase { key, spec, value } = tc.draw(with_key(either(0.4, signed_float(), signed_int())));
+    value.check(&key, &spec);
+}
+
+/// strfmt/2: an explicit zero fill with right alignment (`{x:0>5}`) pads a number with zeros,
+/// as it pads a string and as `format!` does; it is not the `0` flag.
+#[hegel::test]
+fn explicit_zero_fill_right_aligns_numbers(tc: TestCase) {
+    let zero_filled = hegel::tuples!(size(0, 10), number(-1000, 1000))
+        .map(|(width, value)| (Spec { fill: Some('0'), align: Some('>'), width: Some(width), ..Spec::default() }, value));
+    let NumCase { key, spec, value } = tc.draw(with_key(zero_filled));
+    value.check(&key, &spec);
+}
+
+const EXP_TYPES: &[Option<char>] = &[None, Some('e'), Some('E')];
+
+/// strfmt/3: `{x:+}` of a negative zero is `-0`, not `+-0`.
+#[hegel::test]
+fn plus_sign_of_negative_zero(tc: TestCase) {
+    let (key, ty, precision, value) = tc.draw(hegel::tuples!(
+        key(),
+        generators::sampled_from(EXP_TYPES),
+        maybe(0.5, size(0, 3)),
+        hegel::one_of!(generators::just(FloatVal::F64(-0.0)), generators::just(FloatVal::F32(-0.0))),
+    ));
+    value.check(&key, &Spec { plus: true, ty, precision, ..Spec::default() });
+}
+
+const RADIX_TYPES: &[char] = &['b', 'o', 'x', 'X'];
+
+/// strfmt/4: `+` with a radix type prints the sign of the two's-complement form of a negative
+/// integer, as `format!` does (`{:+x}` of -1i32 is `+ffffffff`).
+#[hegel::test]
+fn plus_sign_applies_to_radix_forms_of_negatives(tc: TestCase) {
+    let (key, ty, alt, value) = tc.draw(hegel::tuples!(
+        key(),
+        generators::sampled_from(RADIX_TYPES),
+        generators::weighted_booleans(0.4),
+        negative_int(),
+    ));
+    value.check(&key, &Spec { plus: true, alt, ty: Some(ty), ..Spec::default() });
+}
+
+/// strfmt/5: `Sign::is_unspecified` is true for `Sign::Unspecified` and false for the rest.
+#[test]
+fn sign_is_unspecified_is_not_inverted() {
+    assert!(Sign::Unspecified.is_unspecified(), "Sign::Unspecified.is_unspecified() is false");
+    for s in [Sign::Plus, Sign::Minus, Sign::Space] {
+        assert!(!s.is_unspecified(), "{:?}.is_unspecified() is true", s);
+    }
+}
+
+/// One of the `std::fmt` integer specs strfmt refuses: `#`, `e`, `E` or `?`.
+fn std_spec() -> impl PrintableGenerator<Spec> {
+    hegel::one_of!(
+        generators::just(Spec { alt: true, ..Spec::default() }),
+        generators::just(Spec { ty: Some('e'), ..Spec::default() }),
+        generators::just(Spec { ty: Some('E'), ..Spec::default() }),
+        generators::just(Spec { ty: Some('?'), ..Spec::default() }),
+    )
+}
+
+/// strfmt/6: the `std::fmt` integer specs `{:#}`, `{:e}`, `{:E}` and `{:?}` are accepted and
+/// give `format!`'s output.
+#[hegel::test]
+fn std_fmt_integer_specs_are_accepted(tc: TestCase) {
+    let IntCase { key, spec, value } = tc
+        .draw(hegel::tuples!(key(), numeric_layout(10), std_spec(), int_value()).map(|(key, layout, spec, value)| IntCase {
+            key,
+            spec: Spec { fill: layout.fill, align: layout.align, width: layout.width, ..spec },
+            value,
+        }));
+    value.check(&key, &spec);
+}
+
+/// strfmt/7: a space sign (`{x: }`, `{x: 5}`) is not a `std::fmt` option and strfmt does not
+/// implement it either (`Sign::Space` is never applied): it is an error, like the other
+/// unsupported options, not silently dropped.
+#[hegel::test]
+fn space_sign_is_rejected(tc: TestCase) {
+    let (key, width, value) = tc.draw(hegel::tuples!(key(), maybe(0.5, ints(1, 9)), number(0, 100)));
+    let fmt = match width {
+        Some(w) => format!("{{{}: {}}}", key, w),
+        None => format!("{{{}: }}", key),
+    };
+    let got = value.strfmt(&fmt, &key);
+    assert!(got.is_err(), "strfmt({:?}) = {:?}; a space sign should be an error", fmt, got);
+}
