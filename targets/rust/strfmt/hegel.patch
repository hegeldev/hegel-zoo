+//! Hegel properties for strfmt: Rust's own `format!` is the oracle.
+//!
+//! strfmt "aims to support all of the formatting options defined in std::fmt" for format
+//! strings known only at run time: `{key:spec}` with `std::fmt`'s `[[fill]align][sign]['#']
+//! [width]['.' precision][type]`.  Rust cannot format a dynamic string, but every spec the
+//! generators draw is one of a finite family, so the oracle builds the same text in two stages
+//! with literal format strings: the core (`{:+#x}`, `{:.prec$e}`) and then the padding
+//! (`{:fill<width$}`), which is exactly what `std::fmt` does for every spec without the `0`
+//! flag (sign-aware zero padding, which strfmt documents as unsupported and refuses).
+//! Deviations strfmt pins in its own tests — a sign, `#` or `,` on a string is a `TypeError`,
+//! `,` and the `0` flag are `Invalid("not yet supported")`, `s` is a string type — are kept out
+//! of the comparison; everything else that differs is a bug (bugs.toml).
+//!
+//! The generators are values: a `Spec` is drawn as a record — its layout (fill, alignment,
+//! width) from `layout`, the flags, precision and type from the property's own generator — and
+//! rendered by `Spec::render`; a case is one record (`IntCase`, `FloatCase`, `StrCase`) or a
+//! list of `Piece`s, and the known-bug shapes are kept out by the generators, not by rejecting
+//! cases after the draw.
+extern crate hegel;
+extern crate strfmt;
+
+use hegel::generators::Generator as _;
+use hegel::{generators, PrintableGenerator, TestCase};
+use std::collections::HashMap;
+use std::fmt::{Binary, Display, LowerHex, Octal, UpperHex};
+use strfmt::{strfmt, strfmt_map, DisplayStr, FmtError, Formatter, Sign};
+
+fn ints(lo: i64, hi: i64) -> generators::IntegerGenerator<i64> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// A width or precision in `lo..=hi`.
+fn size(lo: usize, hi: usize) -> generators::IntegerGenerator<usize> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// `Some` of a draw from `g` with probability `p`, `None` otherwise; shrinks to `None`.
+fn maybe<T: hegel::PrettyPrintable>(
+    p: f64,
+    g: impl PrintableGenerator<T>,
+) -> impl PrintableGenerator<Option<T>> {
+    hegel::tuples!(generators::weighted_booleans(p), g).map(|(present, v)| present.then_some(v))
+}
+
+/// A draw from `a` with probability `p`, from `b` otherwise; only the chosen one is drawn, and
+/// it shrinks to `b`.  (Hegel has no weighted `one_of!`.)
+fn either<T: 'static>(
+    p: f64,
+    a: impl PrintableGenerator<T> + Send + Sync + 'static,
+    b: impl PrintableGenerator<T> + Send + Sync + 'static,
+) -> impl PrintableGenerator<T> {
+    let (a, b) = (a.boxed_printable(), b.boxed_printable());
+    generators::weighted_booleans(p).flat_map(move |first| if first { a.clone() } else { b.clone() })
+}
+
+// --------------------------------------------------------------------------- the spec
+
+#[derive(Clone, Debug, Default, hegel::PrettyPrintable)]
+struct Spec {
+    /// a fill is only ever written together with an alignment
+    fill: Option<char>,
+    align: Option<char>,
+    plus: bool,
+    alt: bool,
+    width: Option<usize>,
+    precision: Option<usize>,
+    ty: Option<char>,
+}
+
+impl Spec {
+    fn render(&self) -> String {
+        let mut s = String::new();
+        if let Some(f) = self.fill {
+            s.push(f);
+            s.push(self.align.unwrap());
+        } else if let Some(a) = self.align {
+            s.push(a);
+        }
+        if self.plus {
+            s.push('+');
+        }
+        if self.alt {
+            s.push('#');
+        }
+        if let Some(w) = self.width {
+            s.push_str(&w.to_string());
+        }
+        if let Some(p) = self.precision {
+            s.push_str(&format!(".{}", p));
+        }
+        if let Some(t) = self.ty {
+            s.push(t);
+        }
+        s
+    }
+
+    /// `{key:spec}` (`{key}` when the spec is empty).
+    fn field(&self, key: &str) -> String {
+        let spec = self.render();
+        if spec.is_empty() { format!("{{{}}}", key) } else { format!("{{{}:{}}}", key, spec) }
+    }
+
+    /// The `0>` shape of strfmt/2.
+    fn zero_fill_right(&self) -> bool {
+        self.fill == Some('0') && self.align == Some('>')
+    }
+}
+
+const FILLS: &[char] = &[' ', '*', '0', 'ಠ', '-', '+', '<', 'x'];
+const ALIGNS: &[char] = &['<', '^', '>'];
+
+/// Fill and alignment: neither, an alignment alone, or (twice as often) a fill with an
+/// alignment.
+fn alignment() -> impl PrintableGenerator<Spec> {
+    let filled = || {
+        hegel::tuples!(generators::sampled_from(FILLS), generators::sampled_from(ALIGNS))
+            .map(|(f, a)| Spec { fill: Some(f), align: Some(a), ..Spec::default() })
+    };
+    hegel::one_of!(
+        generators::just(Spec::default()),
+        generators::sampled_from(ALIGNS).map(|a| Spec { align: Some(a), ..Spec::default() }),
+        filled(),
+        filled(),
+    )
+}
+
+/// An `alignment` with the given width: a `Spec` with only fill, alignment and width set.
+fn layout(width: impl PrintableGenerator<Option<usize>>) -> impl PrintableGenerator<Spec> {
+    hegel::tuples!(alignment(), width).map(|(spec, width)| Spec { width, ..spec })
+}
+
+/// A string's layout: fill, alignment and, seven times in ten, a width up to `max_width`.
+fn any_layout(max_width: usize) -> impl PrintableGenerator<Spec> {
+    layout(maybe(0.7, size(0, max_width)))
+}
+
+/// A number's layout: `any_layout` without the `0>` shape strfmt refuses (strfmt/2).
+fn numeric_layout(max_width: usize) -> impl PrintableGenerator<Spec> {
+    any_layout(max_width).filter(|spec| !spec.zero_fill_right())
+}
+
+/// A number's layout with a width of `lo..=hi`, without `0>` (strfmt/2).
+fn wide_layout(lo: usize, hi: usize) -> impl PrintableGenerator<Spec> {
+    layout(size(lo, hi).map(Some)).filter(|spec| !spec.zero_fill_right())
+}
+
+const KEY_CHARS: &str = "abxyZ_19k";
+const TEXT_CHARS: &str = "ab Z_ಠé9-.:";
+
+/// A key of one to six characters.
+fn key() -> impl PrintableGenerator<String> {
+    generators::text().alphabet(KEY_CHARS).min_size(1).max_size(6)
+}
+
+/// Up to `max` characters of literal text (none of them a brace).
+fn text(max: usize) -> impl PrintableGenerator<String> {
+    generators::text().alphabet(TEXT_CHARS).max_size(max)
+}
+
+// --------------------------------------------------------------------------- the oracle
+
+/// Rust's padding of an already formatted core: `{:fill align width$}`.
+fn rust_pad(core: &str, fill: Option<char>, align: char, width: Option<usize>) -> String {
+    let width = match width {
+        Some(w) => w,
+        None => return core.to_string(),
+    };
+    macro_rules! arms {
+        ($($f:literal)*) => {
+            match (fill.unwrap_or(' '), align) {
+                $(
+                    ($f, '<') => format!(concat!("{:", $f, "<width$}"), core, width = width),
+                    ($f, '^') => format!(concat!("{:", $f, "^width$}"), core, width = width),
+                    ($f, '>') => format!(concat!("{:", $f, ">width$}"), core, width = width),
+                )*
+                _ => unreachable!(),
+            }
+        };
+    }
+    arms!(' ' '*' '0' 'ಠ' '-' '+' '<' 'x')
+}
+
+macro_rules! flagged {
+    ($v:expr, $plus:expr, $alt:expr, $t:literal) => {
+        match ($plus, $alt) {
+            (false, false) => format!(concat!("{:", $t, "}"), $v),
+            (true, false) => format!(concat!("{:+", $t, "}"), $v),
+            (false, true) => format!(concat!("{:#", $t, "}"), $v),
+            (true, true) => format!(concat!("{:+#", $t, "}"), $v),
+        }
+    };
+}
+
+fn rust_int<T: Copy + Display + Binary + Octal + LowerHex + UpperHex + std::fmt::LowerExp + std::fmt::UpperExp + std::fmt::Debug>(v: T, spec: &Spec) -> String {
+    let core = match spec.ty {
+        None => flagged!(v, spec.plus, spec.alt, ""),
+        Some('b') => flagged!(v, spec.plus, spec.alt, "b"),
+        Some('o') => flagged!(v, spec.plus, spec.alt, "o"),
+        Some('x') => flagged!(v, spec.plus, spec.alt, "x"),
+        Some('X') => flagged!(v, spec.plus, spec.alt, "X"),
+        Some('e') => flagged!(v, spec.plus, false, "e"),
+        Some('E') => flagged!(v, spec.plus, false, "E"),
+        Some('?') => flagged!(v, spec.plus, spec.alt, "?"),
+        t => panic!("no integer type {:?}", t),
+    };
+    rust_pad(&core, spec.fill, spec.align.unwrap_or('>'), spec.width)
+}
+
+macro_rules! float_core {
+    ($v:expr, $plus:expr, $prec:expr, $t:literal) => {
+        match ($plus, $prec) {
+            (false, None) => format!(concat!("{:", $t, "}"), $v),
+            (true, None) => format!(concat!("{:+", $t, "}"), $v),
+            (false, Some(p)) => format!(concat!("{:.prec$", $t, "}"), $v, prec = p),
+            (true, Some(p)) => format!(concat!("{:+.prec$", $t, "}"), $v, prec = p),
+        }
+    };
+}
+
+fn rust_float<T: Copy + Display + std::fmt::LowerExp + std::fmt::UpperExp>(v: T, spec: &Spec) -> String {
+    let core = match spec.ty {
+        None | Some('f') => float_core!(v, spec.plus, spec.precision, ""),
+        Some('e') => float_core!(v, spec.plus, spec.precision, "e"),
+        Some('E') => float_core!(v, spec.plus, spec.precision, "E"),
+        t => panic!("no float type {:?}", t),
+    };
+    rust_pad(&core, spec.fill, spec.align.unwrap_or('>'), spec.width)
+}
+
+fn rust_str(s: &str, spec: &Spec) -> String {
+    let core = match spec.precision {
+        Some(p) => format!("{:.prec$}", s, prec = p),
+        None => s.to_string(),
+    };
+    rust_pad(&core, spec.fill, spec.align.unwrap_or('<'), spec.width)
+}
+
+// --------------------------------------------------------------------------- driving strfmt
+
+fn format_one<T: DisplayStr>(key: &str, spec: &Spec, value: T) -> Result<String, FmtError> {
+    let mut vars: HashMap<String, T> = HashMap::new();
+    vars.insert(key.to_string(), value);
+    strfmt(&spec.field(key), &vars)
+}
+
+fn expect<T: DisplayStr + std::fmt::Debug + Copy>(key: &str, spec: &Spec, value: T, rust: &str) {
+    let got = format_one(key, spec, value);
+    assert!(
+        got.as_ref().ok() == Some(&rust.to_string()),
+        "strfmt({:?}, {:?}) = {:?}; format! gives {:?}",
+        spec.field(key),
+        value,
+        got,
+        rust
+    );
+}
+
+// --------------------------------------------------------------------------- values
+
+#[derive(Clone, Copy, Debug, hegel::PrettyPrintable)]
+enum IntVal {
+    I8(i8),
+    I32(i32),
+    I64(i64),
+    U8(u8),
+    U64(u64),
+}
+
+impl IntVal {
+    fn is_negative(&self) -> bool {
+        match *self {
+            IntVal::I8(v) => v < 0,
+            IntVal::I32(v) => v < 0,
+            IntVal::I64(v) => v < 0,
+            _ => false,
+        }
+    }
+
+    fn check(&self, key: &str, spec: &Spec) {
+        match *self {
+            IntVal::I8(v) => expect(key, spec, v, &rust_int(v, spec)),
+            IntVal::I32(v) => expect(key, spec, v, &rust_int(v, spec)),
+            IntVal::I64(v) => expect(key, spec, v, &rust_int(v, spec)),
+            IntVal::U8(v) => expect(key, spec, v, &rust_int(v, spec)),
+            IntVal::U64(v) => expect(key, spec, v, &rust_int(v, spec)),
+        }
+    }
+}
+
+/// An integer of one of five types: any i8 or u8; for i32, i64 and u64 a small value
+/// (-130..=300, non-negative for u64) or any value of the type.
+fn int_value() -> impl PrintableGenerator<IntVal> {
+    hegel::one_of!(
+        generators::integers::<i8>().map(IntVal::I8),
+        hegel::one_of!(ints(-130, 300).map(|v| v as i32), generators::integers::<i32>()).map(IntVal::I32),
+        hegel::one_of!(ints(-130, 300), generators::integers::<i64>()).map(IntVal::I64),
+        generators::integers::<u8>().map(IntVal::U8),
+        hegel::one_of!(ints(0, 300).map(|v| v as u64), generators::integers::<u64>()).map(IntVal::U64),
+    )
+}
+
+/// A negative i8, i32 or i64.
+fn negative_int() -> impl PrintableGenerator<IntVal> {
+    hegel::one_of!(
+        ints(-128, -1).map(|v| IntVal::I8(v as i8)),
+        generators::integers::<i32>().max_value(-1).map(IntVal::I32),
+        generators::integers::<i64>().max_value(-1).map(IntVal::I64),
+    )
+}
+
+const SPECIAL_FLOATS: &[f64] = &[0.0, -0.0, f64::NAN, f64::INFINITY, f64::NEG_INFINITY, f64::MAX, f64::MIN_POSITIVE, 1e21, 1e-7];
+
+/// A float: `m × 10^e` with `m` up to six digits and `e` in -12..=12, negative two times in
+/// five; one time in ten a zero, a non-finite value or an edge of the type.
+fn f64_value() -> impl PrintableGenerator<f64> {
+    let regular = hegel::tuples!(ints(0, 999_999), ints(-12, 12), generators::weighted_booleans(0.4)).map(
+        |(m, e, negative)| {
+            let v = m as f64 * 10f64.powi(e as i32);
+            if negative { -v } else { v }
+        },
+    );
+    either(0.1, generators::sampled_from(SPECIAL_FLOATS), regular)
+}
+
+#[derive(Clone, Copy, Debug, hegel::PrettyPrintable)]
+enum FloatVal {
+    F64(f64),
+    F32(f32),
+}
+
+impl FloatVal {
+    /// The -0.0 shape of strfmt/3.
+    fn is_negative_zero(&self) -> bool {
+        match *self {
+            FloatVal::F64(v) => v == 0.0 && v.is_sign_negative(),
+            FloatVal::F32(v) => v == 0.0 && v.is_sign_negative(),
+        }
+    }
+
+    fn check(&self, key: &str, spec: &Spec) {
+        match *self {
+            FloatVal::F64(v) => expect(key, spec, v, &rust_float(v, spec)),
+            FloatVal::F32(v) => expect(key, spec, v, &rust_float(v, spec)),
+        }
+    }
+}
+
+/// An f64, or three times in ten the same value narrowed to f32.
+fn float_value() -> impl PrintableGenerator<FloatVal> {
+    either(0.3, f64_value().map(|v| FloatVal::F32(v as f32)), f64_value().map(FloatVal::F64))
+}
+
+/// An integer or a float (a quarter-step) of the pins that take either.
+#[derive(Clone, Copy, Debug, hegel::PrettyPrintable)]
+enum Number {
+    Int(i64),
+    Float(f64),
+}
+
+impl Number {
+    fn check(&self, key: &str, spec: &Spec) {
+        match *self {
+            Number::Int(v) => expect(key, spec, v, &rust_int(v, spec)),
+            Number::Float(v) => expect(key, spec, v, &rust_float(v, spec)),
+        }
+    }
+
+    /// `strfmt(fmt, {key: self})`.
+    fn strfmt(&self, fmt: &str, key: &str) -> Result<String, FmtError> {
+        match *self {
+            Number::Int(v) => strfmt(fmt, &HashMap::from([(key.to_string(), v)])),
+            Number::Float(v) => strfmt(fmt, &HashMap::from([(key.to_string(), v)])),
+        }
+    }
+}
+
+/// An integer in `lo..=hi`, or the same range in quarter steps as a float.
+fn number(lo: i64, hi: i64) -> impl PrintableGenerator<Number> {
+    hegel::one_of!(ints(lo, hi).map(Number::Int), ints(lo, hi).map(|n| Number::Float(n as f64 / 4.0)))
+}
+
+// --------------------------------------------------------------------------- cases
+
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct StrCase {
+    key: String,
+    spec: Spec,
+    value: String,
+}
+
+/// A string field: any layout up to width 12, a precision up to 8 two times in five, the `s`
+/// type one time in five, and up to eight characters of text.
+fn str_case() -> impl PrintableGenerator<StrCase> {
+    hegel::tuples!(any_layout(12), maybe(0.4, size(0, 8)), generators::weighted_booleans(0.2), key(), text(8)).map(
+        |(layout, precision, typed, key, value)| StrCase {
+            key,
+            spec: Spec { precision, ty: typed.then_some('s'), ..layout },
+            value,
+        },
+    )
+}
+
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct IntCase {
+    key: String,
+    spec: Spec,
+    value: IntVal,
+}
+
+const INT_TYPES: &[Option<char>] = &[None, None, Some('b'), Some('o'), Some('x'), Some('X')];
+
+/// An integer field: a numeric layout up to width 12, one of the `b o x X` types half the
+/// time, and — only without a width (strfmt/1) — `+` three times in ten and, with a type, `#`
+/// three times in ten (`#` without a type is strfmt/6).  With `+` and a type the value is
+/// non-negative (strfmt/4).
+#[hegel::composite]
+fn int_case(tc: &TestCase) -> IntCase {
+    let layout = tc.draw(numeric_layout(12));
+    let ty = tc.draw(generators::sampled_from(INT_TYPES));
+    let (plus, alt) = match layout.width {
+        Some(_) => (false, false),
+        None => tc.draw(hegel::tuples!(generators::weighted_booleans(0.3), generators::weighted_booleans(0.3))),
+    };
+    let spec = Spec { ty, plus, alt: alt && ty.is_some(), ..layout };
+    let value = if spec.plus && spec.ty.is_some() {
+        tc.draw(int_value().filter(|v| !v.is_negative()))
+    } else {
+        tc.draw(int_value())
+    };
+    let key = tc.draw(key());
+    IntCase { key, spec, value }
+}
+
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct FloatCase {
+    key: String,
+    spec: Spec,
+    value: FloatVal,
+}
+
+const FLOAT_TYPES: &[Option<char>] = &[None, None, Some('f'), Some('e'), Some('E')];
+
+/// A float field: a numeric layout up to width 14, one of the `f e E` types three times in
+/// five, a precision up to 10 half the time, and — only without a width (strfmt/1) — `+` three
+/// times in ten, then on a value that is not a negative zero (strfmt/3).
+#[hegel::composite]
+fn float_case(tc: &TestCase) -> FloatCase {
+    let layout = tc.draw(numeric_layout(14));
+    let ty = tc.draw(generators::sampled_from(FLOAT_TYPES));
+    let precision = tc.draw(maybe(0.5, size(0, 10)));
+    let plus = layout.width.is_none() && tc.draw(generators::weighted_booleans(0.3));
+    let spec = Spec { ty, plus, precision, ..layout };
+    let value = if plus {
+        tc.draw(float_value().filter(|v| !v.is_negative_zero()))
+    } else {
+        tc.draw(float_value())
+    };
+    let key = tc.draw(key());
+    FloatCase { key, spec, value }
+}
+
+const BRACES: &[char] = &['{', '}'];
+
+/// One piece of a composed format string: literal text, a doubled brace, or (twice as often) a
+/// string field with any layout up to width 8 and a precision up to 5 three times in ten; the
+/// field's key is its position (`k0`, `k1`, ...).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Piece {
+    Text(String),
+    Escape(char),
+    Field { spec: Spec, value: String },
+}
+
+fn piece() -> impl PrintableGenerator<Piece> {
+    let field = || {
+        hegel::tuples!(any_layout(8), maybe(0.3, size(0, 5)), text(5))
+            .map(|(layout, precision, value)| Piece::Field { spec: Spec { precision, ..layout }, value })
+    };
+    hegel::one_of!(
+        text(5).map(Piece::Text),
+        generators::sampled_from(BRACES).map(Piece::Escape),
+        field(),
+        field(),
+    )
+}
+
+/// The format string of the pieces, its variables and the expected output.
+fn compose(pieces: &[Piece]) -> (String, HashMap<String, String>, String) {
+    let mut fmt = String::new();
+    let mut vars = HashMap::new();
+    let mut expected = String::new();
+    for (i, piece) in pieces.iter().enumerate() {
+        match piece {
+            Piece::Text(t) => {
+                fmt.push_str(t);
+                expected.push_str(t);
+            }
+            Piece::Escape(b) => {
+                fmt.push(*b);
+                fmt.push(*b);
+                expected.push(*b);
+            }
+            Piece::Field { spec, value } => {
+                let key = format!("k{}", i);
+                fmt.push_str(&spec.field(&key));
+                expected.push_str(&rust_str(value, spec));
+                vars.insert(key, value.clone());
+            }
+        }
+    }
+    (fmt, vars, expected)
+}
+
+const SKIP_TYPES: &[Option<char>] = &[None, Some('x'), Some('e'), Some('s')];
+
+/// One piece of a format string every field of which is skipped: literal text, a doubled
+/// brace, or a field with any layout up to width 8, `+` one time in five and one of the
+/// `x e s` types three times in four.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Skipped {
+    Text(String),
+    Escape(char),
+    Field { key: String, spec: Spec },
+}
+
+fn skipped() -> impl PrintableGenerator<Skipped> {
+    hegel::one_of!(
+        text(5).map(Skipped::Text),
+        generators::sampled_from(BRACES).map(Skipped::Escape),
+        hegel::tuples!(key(), any_layout(8), generators::weighted_booleans(0.2), generators::sampled_from(SKIP_TYPES))
+            .map(|(key, layout, plus, ty)| Skipped::Field { key, spec: Spec { plus, ty, ..layout } }),
+    )
+}
+
+/// The format string of the pieces and what `skip` must return: the escapes reduced, the
+/// fields verbatim.
+fn verbatim(pieces: &[Skipped]) -> (String, String) {
+    let mut fmt = String::new();
+    let mut expected = String::new();
+    for piece in pieces {
+        match piece {
+            Skipped::Text(t) => {
+                fmt.push_str(t);
+                expected.push_str(t);
+            }
+            Skipped::Escape(b) => {
+                fmt.push(*b);
+                fmt.push(*b);
+                expected.push(*b);
+            }
+            Skipped::Field { key, spec } => {
+                let field = spec.field(key);
+                fmt.push_str(&field);
+                expected.push_str(&field);
+            }
+        }
+    }
+    (fmt, expected)
+}
+
+const UNKNOWN_TYPES: &[char] = &['q', 'n', 'd', 'g', 'c', '!'];
+
+/// A malformed format string, written after some literal text.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Malformed {
+    /// `{}`
+    EmptyField,
+    /// `{:3}`
+    IndexedField(i64),
+    /// a single `}` between two copies of the text
+    StrayBrace,
+    /// `{key` with no closing brace
+    UnterminatedField(String),
+    /// `{x:q}`
+    UnknownType(char),
+    /// `{key}` for a key that is not in the map
+    MissingKey(String),
+}
+
+impl Malformed {
+    /// The format string, and the kind of error it must give.
+    fn render(&self, text: &str) -> (String, &'static str) {
+        match self {
+            Malformed::EmptyField => (format!("{}{{}}", text), "Invalid"),
+            Malformed::IndexedField(n) => (format!("{}{{:{}}}", text, n), "Invalid"),
+            Malformed::StrayBrace => (format!("{}}}{}", text, text), "Invalid"),
+            Malformed::UnterminatedField(key) => (format!("{}{{{}", text, key), "Invalid"),
+            Malformed::UnknownType(c) => (format!("{}{{x:{}}}", text, c), "TypeError"),
+            Malformed::MissingKey(key) => (format!("{}{{{}}}", text, key), "KeyError"),
+        }
+    }
+}
+
+fn malformed() -> impl PrintableGenerator<Malformed> {
+    hegel::one_of!(
+        generators::just(Malformed::EmptyField),
+        ints(0, 9).map(Malformed::IndexedField),
+        generators::just(Malformed::StrayBrace),
+        key().map(Malformed::UnterminatedField),
+        generators::sampled_from(UNKNOWN_TYPES).map(Malformed::UnknownType),
+        key().filter(|key| key != "x").map(Malformed::MissingKey),
+    )
+}
+
+// --------------------------------------------------------------------------- general properties
+
+/// A string with fill, alignment, width, precision and the `s` type formats as `format!` does
+/// (the default alignment is left, precision truncates by character, width counts characters).
+#[hegel::test]
+fn strings_format_like_rust(tc: TestCase) {
+    let StrCase { key, spec, value } = tc.draw(str_case());
+    let rust = rust_str(&value, &Spec { ty: None, ..spec.clone() });
+    let got = format_one(&key, &spec, value.as_str());
+    assert!(got.as_ref().ok() == Some(&rust), "strfmt({:?}, {:?}) = {:?}; format! gives {:?}", spec.field(&key), value, got, rust);
+}
+
+/// Integers of every width and signedness with fill, alignment, width, `+`, `#` and the
+/// `b o x X` types format as `format!` does.  Kept out: `+` or `#` together with a width
+/// (strfmt/1), `0>` (strfmt/2), `+` with a radix type of a negative value (strfmt/4), `#`
+/// without a type (strfmt/6), and the `0` flag and `,` strfmt documents as unsupported.
+#[hegel::test]
+fn integers_format_like_rust(tc: TestCase) {
+    let IntCase { key, spec, value } = tc.draw(int_case());
+    value.check(&key, &spec);
+}
+
+/// Floats with fill, alignment, width, `+`, precision and the `e E` types (and strfmt's `f`,
+/// which is Rust's `{}`) format as `format!` does.  Kept out: `+` with a width (strfmt/1),
+/// `0>` (strfmt/2), `+` on a negative zero (strfmt/3).
+#[hegel::test]
+fn floats_format_like_rust(tc: TestCase) {
+    let FloatCase { key, spec, value } = tc.draw(float_case());
+    value.check(&key, &spec);
+}
+
+/// A format string of literal text, `{{`/`}}` escapes and several string fields is the
+/// concatenation of the unescaped text and the `format!`-formatted values.
+#[hegel::test]
+fn format_strings_compose(tc: TestCase) {
+    let pieces = tc.draw(generators::vecs(piece()).max_size(6));
+    let (fmt, vars, expected) = compose(&pieces);
+    let got = strfmt(&fmt, &vars);
+    assert!(got.as_ref().ok() == Some(&expected), "strfmt({:?}, {:?}) = {:?}; expected {:?}", fmt, vars, got, expected);
+}
+
+/// `Formatter::skip` writes every field back verbatim: a `strfmt_map` that skips all fields
+/// returns the format string with only its escapes reduced.
+#[hegel::test]
+fn skipped_fields_are_verbatim(tc: TestCase) {
+    let pieces = tc.draw(generators::vecs(skipped()).max_size(6));
+    let (fmt, expected) = verbatim(&pieces);
+    let got = strfmt_map(&fmt, |f: Formatter| f.skip());
+    assert!(got.as_ref().ok() == Some(&expected), "strfmt_map({:?}, skip) = {:?}; expected {:?}", fmt, got, expected);
+}
+
+/// The documented errors: an empty identifier, a single brace, an unterminated field and an
+/// unknown type are `Invalid`/`TypeError`; a key that is not in the map is a `KeyError`.
+#[hegel::test]
+fn malformed_format_strings_are_errors(tc: TestCase) {
+    let mut vars: HashMap<String, String> = HashMap::new();
+    vars.insert("x".to_string(), "X".to_string());
+    let (text, shape) = tc.draw(hegel::tuples!(text(4), malformed()));
+    let (fmt, kind) = shape.render(&text);
+    let got = strfmt(&fmt, &vars);
+    let ok = match (&got, kind) {
+        (Err(FmtError::Invalid(_)), "Invalid") => true,
+        (Err(FmtError::TypeError(_)), "TypeError") => true,
+        (Err(FmtError::KeyError(_)), "KeyError") => true,
+        _ => false,
+    };
+    assert!(ok, "strfmt({:?}) = {:?}; expected {}", fmt, got, kind);
+}
+
+/// The README and rustdoc examples.
+#[test]
+fn doc_examples() {
+    let mut vars: HashMap<String, &str> = HashMap::new();
+    vars.insert("name".to_string(), "bob");
+    vars.insert("job".to_string(), "python developer");
+    assert_eq!(strfmt("hi, my name is {name} and I am a {job}!", &vars).unwrap(), "hi, my name is bob and I am a python developer!");
+    let mut vars: HashMap<String, f64> = HashMap::new();
+    vars.insert("x".to_string(), 42.4242);
+    vars.insert("y".to_string(), -100.11111);
+    vars.insert("z".to_string(), 0.);
+    let f = |mut fmt: Formatter| fmt.f64(*vars.get(fmt.key).unwrap());
+    assert_eq!(strfmt_map("{x:<7.2}", &f).unwrap(), "42.42  ");
+    assert_eq!(strfmt_map("{y:+.2E}", &f).unwrap(), "-1.00E2");
+    assert_eq!(strfmt_map("{z:+.2E}", &f).unwrap(), "+0.00E0");
+    assert_eq!(strfmt!("{first}{second:7.2}", first => "test", second => 77.6543210).unwrap(), "test  77.65");
+}
