+//! Hegel properties for strfmt: Rust's own `format!` is the oracle.
+//!
+//! strfmt "aims to support all of the formatting options defined in std::fmt" for format
+//! strings known only at run time: `{key:spec}` with `std::fmt`'s `[[fill]align][sign]['#']
+//! [width]['.' precision][type]`.  Rust cannot format a dynamic string, but every spec the
+//! generators draw is one of a finite family, so the oracle builds the same text in two stages
+//! with literal format strings: the core (`{:+#x}`, `{:.prec$e}`) and then the padding
+//! (`{:fill<width$}`), which is exactly what `std::fmt` does for every spec without the `0`
+//! flag (sign-aware zero padding, which strfmt documents as unsupported and refuses).
+//! Deviations strfmt pins in its own tests — a sign, `#` or `,` on a string is a `TypeError`,
+//! `,` and the `0` flag are `Invalid("not yet supported")`, `s` is a string type — are kept out
+//! of the comparison; everything else that differs is a bug (bugs.toml).
+extern crate hegel;
+extern crate strfmt;
+
+use hegel::{generators, TestCase};
+use std::collections::HashMap;
+use std::fmt::{Binary, Display, LowerHex, Octal, UpperHex};
+use strfmt::{strfmt, strfmt_map, DisplayStr, FmtError, Formatter, Sign};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo as i64).max_value($hi as i64)
+    };
+}
+
+fn n(tc: &mut TestCase, lo: i64, hi: i64) -> i64 {
+    tc.draw(int!(lo, hi))
+}
+
+fn pick<T: Copy>(tc: &mut TestCase, xs: &[T]) -> T {
+    xs[n(tc, 0, xs.len() as i64 - 1) as usize]
+}
+
+fn chance(tc: &mut TestCase, pct: i64) -> bool {
+    n(tc, 0, 99) < pct
+}
+
+// --------------------------------------------------------------------------- the spec
+
+#[derive(Clone, Debug, Default)]
+struct Spec {
+    /// a fill is only ever written together with an alignment
+    fill: Option<char>,
+    align: Option<char>,
+    plus: bool,
+    alt: bool,
+    width: Option<usize>,
+    precision: Option<usize>,
+    ty: Option<char>,
+}
+
+impl Spec {
+    fn render(&self) -> String {
+        let mut s = String::new();
+        if let Some(f) = self.fill {
+            s.push(f);
+            s.push(self.align.unwrap());
+        } else if let Some(a) = self.align {
+            s.push(a);
+        }
+        if self.plus {
+            s.push('+');
+        }
+        if self.alt {
+            s.push('#');
+        }
+        if let Some(w) = self.width {
+            s.push_str(&w.to_string());
+        }
+        if let Some(p) = self.precision {
+            s.push_str(&format!(".{}", p));
+        }
+        if let Some(t) = self.ty {
+            s.push(t);
+        }
+        s
+    }
+
+    /// `{key:spec}` (`{key}` when the spec is empty).
+    fn field(&self, key: &str) -> String {
+        let spec = self.render();
+        if spec.is_empty() { format!("{{{}}}", key) } else { format!("{{{}:{}}}", key, spec) }
+    }
+
+    /// The `0>` shape of strfmt/2.
+    fn zero_fill_right(&self) -> bool {
+        self.fill == Some('0') && self.align == Some('>')
+    }
+}
+
+const FILLS: [char; 8] = [' ', '*', '0', 'ಠ', '-', '+', '<', 'x'];
+
+fn arb_layout(tc: &mut TestCase, spec: &mut Spec, max_width: i64) {
+    match n(tc, 0, 3) {
+        0 => {}
+        1 => spec.align = Some(pick(tc, &['<', '^', '>'])),
+        _ => {
+            spec.fill = Some(pick(tc, &FILLS));
+            spec.align = Some(pick(tc, &['<', '^', '>']));
+        }
+    }
+    if chance(tc, 70) {
+        spec.width = Some(n(tc, 0, max_width) as usize);
+    }
+}
+
+fn arb_key(tc: &mut TestCase) -> String {
+    let len = n(tc, 1, 6);
+    (0..len)
+        .map(|_| pick(tc, &['a', 'b', 'x', 'y', 'Z', '_', '1', '9', 'k']))
+        .collect()
+}
+
+// --------------------------------------------------------------------------- the oracle
+
+/// Rust's padding of an already formatted core: `{:fill align width$}`.
+fn rust_pad(core: &str, fill: Option<char>, align: char, width: Option<usize>) -> String {
+    let width = match width {
+        Some(w) => w,
+        None => return core.to_string(),
+    };
+    macro_rules! arms {
+        ($($f:literal)*) => {
+            match (fill.unwrap_or(' '), align) {
+                $(
+                    ($f, '<') => format!(concat!("{:", $f, "<width$}"), core, width = width),
+                    ($f, '^') => format!(concat!("{:", $f, "^width$}"), core, width = width),
+                    ($f, '>') => format!(concat!("{:", $f, ">width$}"), core, width = width),
+                )*
+                _ => unreachable!(),
+            }
+        };
+    }
+    arms!(' ' '*' '0' 'ಠ' '-' '+' '<' 'x')
+}
+
+macro_rules! flagged {
+    ($v:expr, $plus:expr, $alt:expr, $t:literal) => {
+        match ($plus, $alt) {
+            (false, false) => format!(concat!("{:", $t, "}"), $v),
+            (true, false) => format!(concat!("{:+", $t, "}"), $v),
+            (false, true) => format!(concat!("{:#", $t, "}"), $v),
+            (true, true) => format!(concat!("{:+#", $t, "}"), $v),
+        }
+    };
+}
+
+fn rust_int<T: Copy + Display + Binary + Octal + LowerHex + UpperHex + std::fmt::LowerExp + std::fmt::UpperExp + std::fmt::Debug>(v: T, spec: &Spec) -> String {
+    let core = match spec.ty {
+        None => flagged!(v, spec.plus, spec.alt, ""),
+        Some('b') => flagged!(v, spec.plus, spec.alt, "b"),
+        Some('o') => flagged!(v, spec.plus, spec.alt, "o"),
+        Some('x') => flagged!(v, spec.plus, spec.alt, "x"),
+        Some('X') => flagged!(v, spec.plus, spec.alt, "X"),
+        Some('e') => flagged!(v, spec.plus, false, "e"),
+        Some('E') => flagged!(v, spec.plus, false, "E"),
+        Some('?') => flagged!(v, spec.plus, spec.alt, "?"),
+        t => panic!("no integer type {:?}", t),
+    };
+    rust_pad(&core, spec.fill, spec.align.unwrap_or('>'), spec.width)
+}
+
+macro_rules! float_core {
+    ($v:expr, $plus:expr, $prec:expr, $t:literal) => {
+        match ($plus, $prec) {
+            (false, None) => format!(concat!("{:", $t, "}"), $v),
+            (true, None) => format!(concat!("{:+", $t, "}"), $v),
+            (false, Some(p)) => format!(concat!("{:.prec$", $t, "}"), $v, prec = p),
+            (true, Some(p)) => format!(concat!("{:+.prec$", $t, "}"), $v, prec = p),
+        }
+    };
+}
+
+fn rust_float<T: Copy + Display + std::fmt::LowerExp + std::fmt::UpperExp>(v: T, spec: &Spec) -> String {
+    let core = match spec.ty {
+        None | Some('f') => float_core!(v, spec.plus, spec.precision, ""),
+        Some('e') => float_core!(v, spec.plus, spec.precision, "e"),
+        Some('E') => float_core!(v, spec.plus, spec.precision, "E"),
+        t => panic!("no float type {:?}", t),
+    };
+    rust_pad(&core, spec.fill, spec.align.unwrap_or('>'), spec.width)
+}
+
+fn rust_str(s: &str, spec: &Spec) -> String {
+    let core = match spec.precision {
+        Some(p) => format!("{:.prec$}", s, prec = p),
+        None => s.to_string(),
+    };
+    rust_pad(&core, spec.fill, spec.align.unwrap_or('<'), spec.width)
+}
+
+// --------------------------------------------------------------------------- driving strfmt
+
+fn format_one<T: DisplayStr>(key: &str, spec: &Spec, value: T) -> Result<String, FmtError> {
+    let mut vars: HashMap<String, T> = HashMap::new();
+    vars.insert(key.to_string(), value);
+    strfmt(&spec.field(key), &vars)
+}
+
+fn expect<T: DisplayStr + std::fmt::Debug + Copy>(key: &str, spec: &Spec, value: T, rust: &str) {
+    let got = format_one(key, spec, value);
+    assert!(
+        got.as_ref().ok() == Some(&rust.to_string()),
+        "strfmt({:?}, {:?}) = {:?}; format! gives {:?}",
+        spec.field(key),
+        value,
+        got,
+        rust
+    );
+}
+
+#[derive(Clone, Copy, Debug)]
+enum IntVal {
+    I8(i8),
+    I32(i32),
+    I64(i64),
+    U8(u8),
+    U64(u64),
+}
+
+impl IntVal {
+    fn is_negative(&self) -> bool {
+        match *self {
+            IntVal::I8(v) => v < 0,
+            IntVal::I32(v) => v < 0,
+            IntVal::I64(v) => v < 0,
+            _ => false,
+        }
+    }
+
+    fn check(&self, key: &str, spec: &Spec) {
+        match *self {
+            IntVal::I8(v) => expect(key, spec, v, &rust_int(v, spec)),
+            IntVal::I32(v) => expect(key, spec, v, &rust_int(v, spec)),
+            IntVal::I64(v) => expect(key, spec, v, &rust_int(v, spec)),
+            IntVal::U8(v) => expect(key, spec, v, &rust_int(v, spec)),
+            IntVal::U64(v) => expect(key, spec, v, &rust_int(v, spec)),
+        }
+    }
+}
+
+fn arb_int(tc: &mut TestCase) -> IntVal {
+    let small = n(tc, -130, 300);
+    match n(tc, 0, 4) {
+        0 => IntVal::I8(small as i8),
+        1 => IntVal::I32(if chance(tc, 50) { small as i32 } else { n(tc, i32::MIN as i64, i32::MAX as i64) as i32 }),
+        2 => IntVal::I64(if chance(tc, 50) { small } else { n(tc, i64::MIN, i64::MAX) }),
+        3 => IntVal::U8(small as u8),
+        _ => IntVal::U64(if chance(tc, 50) { small as u64 } else { n(tc, i64::MIN, i64::MAX) as u64 }),
+    }
+}
+
+fn arb_f64(tc: &mut TestCase) -> f64 {
+    match n(tc, 0, 9) {
+        0 => pick(tc, &[0.0, -0.0, f64::NAN, f64::INFINITY, f64::NEG_INFINITY, f64::MAX, f64::MIN_POSITIVE, 1e21, 1e-7]),
+        _ => {
+            let m = n(tc, 0, 999_999) as f64;
+            let e = n(tc, -12, 12) as i32;
+            let v = m * 10f64.powi(e);
+            if chance(tc, 40) { -v } else { v }
+        }
+    }
+}
+
+fn arb_text(tc: &mut TestCase, max_len: i64) -> String {
+    let len = n(tc, 0, max_len);
+    (0..len).map(|_| pick(tc, &['a', 'b', ' ', 'Z', '_', 'ಠ', 'é', '9', '-', '.', ':'])).collect()
+}
+
+// --------------------------------------------------------------------------- general properties
+
+/// A string with fill, alignment, width, precision and the `s` type formats as `format!` does
+/// (the default alignment is left, precision truncates by character, width counts characters).
+#[hegel::test]
+fn strings_format_like_rust(mut tc: TestCase) {
+    let mut spec = Spec::default();
+    arb_layout(&mut tc, &mut spec, 12);
+    if chance(&mut tc, 40) {
+        spec.precision = Some(n(&mut tc, 0, 8) as usize);
+    }
+    if chance(&mut tc, 20) {
+        spec.ty = Some('s');
+    }
+    let key = arb_key(&mut tc);
+    let s = arb_text(&mut tc, 8);
+    let rust = rust_str(&s, &Spec { ty: None, ..spec.clone() });
+    let got = format_one(&key, &spec, s.as_str());
+    assert!(got.as_ref().ok() == Some(&rust), "strfmt({:?}, {:?}) = {:?}; format! gives {:?}", spec.field(&key), s, got, rust);
+}
+
+/// Integers of every width and signedness with fill, alignment, width, `+`, `#` and the
+/// `b o x X` types format as `format!` does.  Kept out: `+` or `#` together with a width
+/// (strfmt/1), `0>` (strfmt/2), `+` with a radix type of a negative value (strfmt/4), `#`
+/// without a type (strfmt/6), and the `0` flag and `,` strfmt documents as unsupported.
+#[hegel::test]
+fn integers_format_like_rust(mut tc: TestCase) {
+    let mut spec = Spec::default();
+    arb_layout(&mut tc, &mut spec, 12);
+    spec.ty = pick(&mut tc, &[None, None, Some('b'), Some('o'), Some('x'), Some('X')]);
+    spec.plus = chance(&mut tc, 30);
+    spec.alt = spec.ty.is_some() && chance(&mut tc, 30);
+    let v = arb_int(&mut tc);
+    tc.assume(!((spec.plus || spec.alt) && spec.width.is_some()));
+    tc.assume(!spec.zero_fill_right());
+    tc.assume(!(spec.plus && spec.ty.is_some() && v.is_negative()));
+    v.check(&arb_key(&mut tc), &spec);
+}
+
+/// Floats with fill, alignment, width, `+`, precision and the `e E` types (and strfmt's `f`,
+/// which is Rust's `{}`) format as `format!` does.  Kept out: `+` with a width (strfmt/1),
+/// `0>` (strfmt/2), `+` on a negative zero (strfmt/3).
+#[hegel::test]
+fn floats_format_like_rust(mut tc: TestCase) {
+    let mut spec = Spec::default();
+    arb_layout(&mut tc, &mut spec, 14);
+    spec.ty = pick(&mut tc, &[None, None, Some('f'), Some('e'), Some('E')]);
+    spec.plus = chance(&mut tc, 30);
+    if chance(&mut tc, 50) {
+        spec.precision = Some(n(&mut tc, 0, 10) as usize);
+    }
+    let v = arb_f64(&mut tc);
+    tc.assume(!(spec.plus && spec.width.is_some()));
+    tc.assume(!spec.zero_fill_right());
+    tc.assume(!(spec.plus && v == 0.0 && v.is_sign_negative()));
+    let key = arb_key(&mut tc);
+    if chance(&mut tc, 30) {
+        let v = v as f32;
+        expect(&key, &spec, v, &rust_float(v, &spec));
+    } else {
+        expect(&key, &spec, v, &rust_float(v, &spec));
+    }
+}
+
+/// A format string of literal text, `{{`/`}}` escapes and several string fields is the
+/// concatenation of the unescaped text and the `format!`-formatted values.
+#[hegel::test]
+fn format_strings_compose(mut tc: TestCase) {
+    let mut vars: HashMap<String, String> = HashMap::new();
+    let mut fmt = String::new();
+    let mut expected = String::new();
+    let pieces = n(&mut tc, 0, 6);
+    for i in 0..pieces {
+        match n(&mut tc, 0, 3) {
+            0 => {
+                let t = arb_text(&mut tc, 5);
+                fmt.push_str(&t);
+                expected.push_str(&t);
+            }
+            1 => {
+                let b = pick(&mut tc, &['{', '}']);
+                fmt.push(b);
+                fmt.push(b);
+                expected.push(b);
+            }
+            _ => {
+                let mut spec = Spec::default();
+                arb_layout(&mut tc, &mut spec, 8);
+                if chance(&mut tc, 30) {
+                    spec.precision = Some(n(&mut tc, 0, 5) as usize);
+                }
+                let key = format!("k{}", i);
+                let s = arb_text(&mut tc, 5);
+                fmt.push_str(&spec.field(&key));
+                expected.push_str(&rust_str(&s, &spec));
+                vars.insert(key, s);
+            }
+        }
+    }
+    let got = strfmt(&fmt, &vars);
+    assert!(got.as_ref().ok() == Some(&expected), "strfmt({:?}, {:?}) = {:?}; expected {:?}", fmt, vars, got, expected);
+}
+
+/// `Formatter::skip` writes every field back verbatim: a `strfmt_map` that skips all fields
+/// returns the format string with only its escapes reduced.
+#[hegel::test]
+fn skipped_fields_are_verbatim(mut tc: TestCase) {
+    let mut fmt = String::new();
+    let mut expected = String::new();
+    let pieces = n(&mut tc, 0, 6);
+    for _ in 0..pieces {
+        match n(&mut tc, 0, 2) {
+            0 => {
+                let t = arb_text(&mut tc, 5);
+                fmt.push_str(&t);
+                expected.push_str(&t);
+            }
+            1 => {
+                let b = pick(&mut tc, &['{', '}']);
+                fmt.push(b);
+                fmt.push(b);
+                expected.push(b);
+            }
+            _ => {
+                let mut spec = Spec::default();
+                arb_layout(&mut tc, &mut spec, 8);
+                spec.plus = chance(&mut tc, 20);
+                spec.ty = pick(&mut tc, &[None, Some('x'), Some('e'), Some('s')]);
+                let field = spec.field(&arb_key(&mut tc));
+                fmt.push_str(&field);
+                expected.push_str(&field);
+            }
+        }
+    }
+    let got = strfmt_map(&fmt, |f: Formatter| f.skip());
+    assert!(got.as_ref().ok() == Some(&expected), "strfmt_map({:?}, skip) = {:?}; expected {:?}", fmt, got, expected);
+}
+
+/// The documented errors: an empty identifier, a single brace, an unterminated field and an
+/// unknown type are `Invalid`/`TypeError`; a key that is not in the map is a `KeyError`.
+#[hegel::test]
+fn malformed_format_strings_are_errors(mut tc: TestCase) {
+    let mut vars: HashMap<String, String> = HashMap::new();
+    vars.insert("x".to_string(), "X".to_string());
+    let text = arb_text(&mut tc, 4).replace(|c| c == '{' || c == '}', "");
+    let key = arb_key(&mut tc);
+    let (fmt, kind) = match n(&mut tc, 0, 5) {
+        0 => (format!("{}{{}}", text), "Invalid"),
+        1 => (format!("{}{{:{}}}", text, n(&mut tc, 0, 9)), "Invalid"),
+        2 => (format!("{}}}{}", text, text), "Invalid"),
+        3 => (format!("{}{{{}", text, key), "Invalid"),
+        4 => (format!("{}{{x:{}}}", text, pick(&mut tc, &['q', 'n', 'd', 'g', 'c', '!'])), "TypeError"),
+        _ => {
+            tc.assume(key != "x");
+            (format!("{}{{{}}}", text, key), "KeyError")
+        }
+    };
+    let got = strfmt(&fmt, &vars);
+    let ok = match (&got, kind) {
+        (Err(FmtError::Invalid(_)), "Invalid") => true,
+        (Err(FmtError::TypeError(_)), "TypeError") => true,
+        (Err(FmtError::KeyError(_)), "KeyError") => true,
+        _ => false,
+    };
+    assert!(ok, "strfmt({:?}) = {:?}; expected {}", fmt, got, kind);
+}
+
+/// The README and rustdoc examples.
+#[hegel::test]
+fn doc_examples(_tc: TestCase) {
+    let mut vars: HashMap<String, &str> = HashMap::new();
+    vars.insert("name".to_string(), "bob");
+    vars.insert("job".to_string(), "python developer");
+    assert_eq!(strfmt("hi, my name is {name} and I am a {job}!", &vars).unwrap(), "hi, my name is bob and I am a python developer!");
+    let mut vars: HashMap<String, f64> = HashMap::new();
+    vars.insert("x".to_string(), 42.4242);
+    vars.insert("y".to_string(), -100.11111);
+    vars.insert("z".to_string(), 0.);
+    let f = |mut fmt: Formatter| fmt.f64(*vars.get(fmt.key).unwrap());
+    assert_eq!(strfmt_map("{x:<7.2}", &f).unwrap(), "42.42  ");
+    assert_eq!(strfmt_map("{y:+.2E}", &f).unwrap(), "-1.00E2");
+    assert_eq!(strfmt_map("{z:+.2E}", &f).unwrap(), "+0.00E0");
+    assert_eq!(strfmt!("{first}{second:7.2}", first => "test", second => 77.6543210).unwrap(), "test  77.65");
+}
+
+// --------------------------------------------------------------------------- pinned bugs
+
+/// strfmt/1: a `+` sign or `#` prefix is part of the padded field (`{x:>+7}` of 42 is
+/// `    +42`), not written before it.
+#[hegel::test]
+fn sign_and_prefix_are_inside_the_width(mut tc: TestCase) {
+    let mut spec = Spec::default();
+    arb_layout(&mut tc, &mut spec, 12);
+    spec.width = Some(n(&mut tc, 3, 12) as usize);
+    tc.assume(!spec.zero_fill_right());
+    let key = arb_key(&mut tc);
+    if chance(&mut tc, 60) {
+        spec.ty = pick(&mut tc, &[None, Some('x'), Some('b'), Some('o'), Some('X')]);
+        spec.plus = spec.ty.is_none() || chance(&mut tc, 50);
+        spec.alt = spec.ty.is_some() && !spec.plus;
+        let v = n(&mut tc, 0, 1000);
+        expect(&key, &spec, v, &rust_int(v, &spec));
+    } else {
+        spec.plus = true;
+        spec.ty = pick(&mut tc, &[None, Some('e')]);
+        if chance(&mut tc, 50) {
+            spec.precision = Some(n(&mut tc, 0, 4) as usize);
+        }
+        let v = n(&mut tc, 0, 1000) as f64 / 8.0;
+        expect(&key, &spec, v, &rust_float(v, &spec));
+    }
+}
+
+/// strfmt/2: an explicit zero fill with right alignment (`{x:0>5}`) pads a number with zeros,
+/// as it pads a string and as `format!` does; it is not the `0` flag.
+#[hegel::test]
+fn explicit_zero_fill_right_aligns_numbers(mut tc: TestCase) {
+    let spec = Spec { fill: Some('0'), align: Some('>'), width: Some(n(&mut tc, 0, 10) as usize), ..Spec::default() };
+    let key = arb_key(&mut tc);
+    if chance(&mut tc, 50) {
+        let v = n(&mut tc, -1000, 1000);
+        expect(&key, &spec, v, &rust_int(v, &spec));
+    } else {
+        let v = n(&mut tc, -1000, 1000) as f64 / 4.0;
+        expect(&key, &spec, v, &rust_float(v, &spec));
+    }
+}
+
+/// strfmt/3: `{x:+}` of a negative zero is `-0`, not `+-0`.
+#[hegel::test]
+fn plus_sign_of_negative_zero(mut tc: TestCase) {
+    let mut spec = Spec { plus: true, ..Spec::default() };
+    spec.ty = pick(&mut tc, &[None, Some('e'), Some('E')]);
+    if chance(&mut tc, 50) {
+        spec.precision = Some(n(&mut tc, 0, 3) as usize);
+    }
+    let key = arb_key(&mut tc);
+    if chance(&mut tc, 50) {
+        expect(&key, &spec, -0.0f64, &rust_float(-0.0f64, &spec));
+    } else {
+        expect(&key, &spec, -0.0f32, &rust_float(-0.0f32, &spec));
+    }
+}
+
+/// strfmt/4: `+` with a radix type prints the sign of the two's-complement form of a negative
+/// integer, as `format!` does (`{:+x}` of -1i32 is `+ffffffff`).
+#[hegel::test]
+fn plus_sign_applies_to_radix_forms_of_negatives(mut tc: TestCase) {
+    let mut spec = Spec { plus: true, ..Spec::default() };
+    spec.ty = Some(pick(&mut tc, &['b', 'o', 'x', 'X']));
+    spec.alt = chance(&mut tc, 40);
+    let v = match n(&mut tc, 0, 2) {
+        0 => IntVal::I8(n(&mut tc, -128, -1) as i8),
+        1 => IntVal::I32(n(&mut tc, i32::MIN as i64, -1) as i32),
+        _ => IntVal::I64(n(&mut tc, i64::MIN, -1)),
+    };
+    v.check(&arb_key(&mut tc), &spec);
+}
+
+/// strfmt/5: `Sign::is_unspecified` is true for `Sign::Unspecified` and false for the rest.
+#[hegel::test]
+fn sign_is_unspecified_is_not_inverted(_tc: TestCase) {
+    assert!(Sign::Unspecified.is_unspecified(), "Sign::Unspecified.is_unspecified() is false");
+    for s in [Sign::Plus, Sign::Minus, Sign::Space] {
+        assert!(!s.is_unspecified(), "{:?}.is_unspecified() is true", s);
+    }
+}
+
+/// strfmt/6: the `std::fmt` integer specs `{:#}`, `{:e}`, `{:E}` and `{:?}` are accepted and
+/// give `format!`'s output.
+#[hegel::test]
+fn std_fmt_integer_specs_are_accepted(mut tc: TestCase) {
+    let mut spec = Spec::default();
+    arb_layout(&mut tc, &mut spec, 10);
+    tc.assume(!spec.zero_fill_right());
+    match n(&mut tc, 0, 3) {
+        0 => spec.alt = true,
+        1 => spec.ty = Some('e'),
+        2 => spec.ty = Some('E'),
+        _ => spec.ty = Some('?'),
+    }
+    let v = arb_int(&mut tc);
+    v.check(&arb_key(&mut tc), &spec);
+}
+
+/// strfmt/7: a space sign (`{x: }`, `{x: 5}`) is not a `std::fmt` option and strfmt does not
+/// implement it either (`Sign::Space` is never applied): it is an error, like the other
+/// unsupported options, not silently dropped.
+#[hegel::test]
+fn space_sign_is_rejected(mut tc: TestCase) {
+    let key = arb_key(&mut tc);
+    let mut fmt = format!("{{{}: ", key);
+    if chance(&mut tc, 50) {
+        fmt.push_str(&n(&mut tc, 1, 9).to_string());
+    }
+    fmt.push('}');
+    let got = if chance(&mut tc, 50) {
+        let mut vars: HashMap<String, i64> = HashMap::new();
+        vars.insert(key.clone(), n(&mut tc, 0, 100));
+        strfmt(&fmt, &vars)
+    } else {
+        let mut vars: HashMap<String, f64> = HashMap::new();
+        vars.insert(key.clone(), n(&mut tc, 0, 100) as f64 / 4.0);
+        strfmt(&fmt, &vars)
+    };
+    assert!(got.is_err(), "strfmt({:?}) = {:?}; a space sign should be an error", fmt, got);
+}
