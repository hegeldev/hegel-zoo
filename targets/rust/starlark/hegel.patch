+// ---------------------------------------------------------------------------
+// Property-based tests (hegel) for the parser, continuing the fuzzer tests
+// above.
+// ---------------------------------------------------------------------------
+
+mod parse_prop {
+    use hegel::generators;
+
+    use crate::syntax::AstModule;
+    use crate::syntax::Dialect;
+
+    fn dialects() -> Vec<Dialect> {
+        vec![
+            Dialect::Standard,
+            Dialect::Extended,
+            Dialect::AllOptionsInternal,
+        ]
+    }
+
+    /// Starlark-shaped token soup: random tokens with random separators.
+    /// Much better than uniform text at reaching the parser (not just the
+    /// lexer error paths).
+    #[hegel::composite]
+    fn token_soup(tc: &hegel::TestCase) -> String {
+        const TOKENS: &[&str] = &[
+            "def", "lambda", "load", "if", "elif", "else", "for", "in", "not", "or", "and",
+            "return", "break", "continue", "pass", "None", "True", "False", "(", ")", "[", "]",
+            "{", "}", ":", ",", ";", "=", "==", "!=", "<", "<=", "+", "-", "*", "**", "/", "//",
+            "%", "&", "|", "^", "<<", ">>", "~", ".", "...", "->", "+=", "\"abc\"", "'x'", "\"\"",
+            "\"unterminated", "\"\\x", "\"\\u{7}\"", "\"\"\"doc\"\"\"", "r\"raw\"", "b\"\\xff\"",
+            "f\"{x}\"", "f\"{", "0", "1", "0x1f", "0o17", "0b101", "1.5e10", "1e-3", ".5", "5.",
+            "123456789012345678901234567890", "x", "_y", "ident", "\n", "\t", "    ", "#comment",
+            "\\\n", "\u{2028}", "\u{85}", "\0",
+        ];
+        let parts: Vec<&str> = tc.draw(
+            generators::vecs(generators::sampled_from(TOKENS.to_vec())).max_size(30),
+        );
+        let mut s = String::new();
+        for p in parts {
+            s.push_str(p);
+            match tc.draw(generators::integers::<u8>().max_value(3)) {
+                0 => s.push(' '),
+                1 => s.push('\n'),
+                _ => {}
+            }
+        }
+        s
+    }
+
+    /// `AstModule::parse` returns `Err` rather than panicking on arbitrary
+    /// input, and the returned error can be Debug-formatted.
+    ///
+    /// Evidence: parse returns `crate::Result`; the `test_fuzzer_*` tests
+    /// above pin past oss-fuzz panics of exactly this shape (including
+    /// panics that only fired when formatting the error).
+    #[hegel::test]
+    fn test_prop_parse_never_panics(tc: hegel::TestCase) {
+        let src: String = tc.draw(hegel::one_of!(
+            generators::text().max_size(200),
+            token_soup(),
+        ));
+        for dialect in dialects() {
+            let res: Result<AstModule, crate::Error> =
+                AstModule::parse("test.star", src.clone(), &dialect);
+            let _unused = format!("{res:?}");
+        }
+    }
+}
+// ---------------------------------------------------------------------------
+// Formerly KNOWN FAILURES (starlark/1..3, fixed upstream): `Display` for the
+// AST produced text that did not re-parse. These bugs were found by
+// `test_prop_parse_print_reparse_roundtrip` below; each test pins one minimal
+// counterexample deterministically and stays as a regression test. The
+// generator for the property covers these constructs again.
+// ---------------------------------------------------------------------------
+
+/// Re-parse the `Display` form of a program, panicking (with context) if the
+/// printed text is no longer valid Starlark.
+fn reprint(src: &str) -> String {
+    let ast = AstModule::parse("orig.star", src.to_owned(), &Dialect::AllOptionsInternal)
+        .expect("original program must parse");
+    let printed = ast.statement().to_string();
+    match AstModule::parse("printed.star", printed.clone(), &Dialect::AllOptionsInternal) {
+        Ok(ast2) => {
+            let printed2 = ast2.statement().to_string();
+            assert_eq!(
+                printed, printed2,
+                "print->parse->print not idempotent for {src:?}"
+            );
+            printed
+        }
+        Err(e) => panic!(
+            "printed AST failed to re-parse: {e}\noriginal: {src:?}\nprinted: {printed:?}"
+        ),
+    }
+}
+
+/// Formerly a KNOWN FAILURE (starlark/1): `Display` for `Expr::Slice` printed `x[1:2]` as `x[]1:2`
+/// (the brackets are emitted before the indices; see
+/// `starlark_syntax/src/syntax/ast.rs`, `impl Display for Expr`, the
+/// `Expr::Slice` arm), which is not valid Starlark.
+#[test]
+fn test_slice_display_reparses() {
+    reprint("x[1:2]");
+}
+
+/// Formerly a KNOWN FAILURE (starlark/3): `Display` for `Expr::Dot` did not parenthesize an integer
+/// literal base: `(1).imag` printed as `1.imag`, which does not parse
+/// (`1.` lexes as a float).
+#[test]
+fn test_dot_on_int_literal_display_reparses() {
+    reprint("(1).imag");
+}
+
+/// Formerly a KNOWN FAILURE (starlark/2): `Display` for `Expr::FString` printed the desugared format
+/// string without quoting it: `f"a{x}b"` printed as `a{}b.format(x)` instead
+/// of `"a{}b".format(x)`, which does not parse.
+#[test]
+fn test_fstring_display_reparses() {
+    reprint("f\"a{x}b\"");
+}
+
+// ---------------------------------------------------------------------------
+// Property-based test: pretty-print -> re-parse round trip.
+// ---------------------------------------------------------------------------
+
+mod print_prop {
+    use hegel::generators::{self, Generator};
+
+    use crate::syntax::AstModule;
+    use crate::syntax::Dialect;
+    use crate::values::types::string::StarlarkStr;
+
+    /// A random well-formed Starlark expression, as program text.
+    ///
+    /// Everything possibly ambiguous is parenthesized, so the result always
+    /// parses. Slices, attribute access (including on integer literals) and
+    /// f-strings were excluded while starlark/1..3 were open (pinned by the
+    /// `*_display_reparses` tests above) and are generated again.
+    fn expr_texts(depth: u32) -> generators::BoxedGenerator<'static, String> {
+        hegel::compose!(|tc| {
+            let leaf = depth == 0 || tc.draw(generators::integers::<u8>().max_value(2)) == 0;
+            if leaf {
+                match tc.draw(generators::integers::<u8>().max_value(4)) {
+                    0 => tc
+                        .draw(generators::sampled_from(vec!["x", "y", "foo", "_z"]))
+                        .to_owned(),
+                    1 => tc.draw(hegel::one_of!(
+                        generators::integers::<u64>().map(|n| n.to_string()),
+                        generators::from_regex(r"[1-9][0-9]{0,40}"),
+                    )),
+                    2 => tc
+                        .draw(generators::sampled_from(vec!["None", "True", "False"]))
+                        .to_owned(),
+                    3 => {
+                        let s: String = tc.draw(generators::text().max_size(6));
+                        StarlarkStr::repr(&s)
+                    }
+                    _ => {
+                        let n = tc.draw(generators::integers::<i8>());
+                        // Integral floats print as ints (e.g. `1.0` -> `1`);
+                        // that is print-idempotent, so still fine here.
+                        if tc.draw(generators::booleans()) {
+                            format!("({n}.5)")
+                        } else {
+                            format!("({n}.0)")
+                        }
+                    }
+                }
+            } else {
+                let sub = || expr_texts(depth - 1);
+                match tc.draw(generators::integers::<u8>().max_value(11)) {
+                    0 => {
+                        let op = tc.draw(generators::sampled_from(vec![
+                            " or ", " and ", " == ", " != ", " < ", " > ", " <= ", " >= ",
+                            " in ", " not in ", " - ", " + ", " * ", " % ", " / ", " // ",
+                            " & ", " | ", " ^ ", " << ", " >> ",
+                        ]));
+                        let l = tc.draw(sub());
+                        let r = tc.draw(sub());
+                        format!("({l}{op}{r})")
+                    }
+                    1 => {
+                        let op = tc.draw(generators::sampled_from(vec!["not ", "-", "+", "~"]));
+                        let e = tc.draw(sub());
+                        format!("({op}{e})")
+                    }
+                    2 => {
+                        let elems: Vec<String> =
+                            tc.draw(generators::vecs(sub()).max_size(3));
+                        format!("[{}]", elems.join(", "))
+                    }
+                    3 => {
+                        let elems: Vec<String> =
+                            tc.draw(generators::vecs(sub()).max_size(3));
+                        match elems.len() {
+                            1 => format!("({},)", elems[0]),
+                            _ => format!("({})", elems.join(", ")),
+                        }
+                    }
+                    4 => {
+                        let k = tc.draw(sub());
+                        let v = tc.draw(sub());
+                        format!("{{{k}: {v}}}")
+                    }
+                    5 => {
+                        let c = tc.draw(sub());
+                        let a = tc.draw(sub());
+                        let b = tc.draw(sub());
+                        format!("({a} if {c} else {b})")
+                    }
+                    6 => {
+                        // Call with positional, named, *args, **kwargs.
+                        let mut args: Vec<String> =
+                            tc.draw(generators::vecs(sub()).max_size(2));
+                        for (i, named) in tc
+                            .draw(generators::vecs(sub()).max_size(2))
+                            .into_iter()
+                            .enumerate()
+                        {
+                            args.push(format!("k{i} = {named}"));
+                        }
+                        if tc.draw(generators::booleans()) {
+                            let e = tc.draw(sub());
+                            args.push(format!("*{e}"));
+                        }
+                        if tc.draw(generators::booleans()) {
+                            let e = tc.draw(sub());
+                            args.push(format!("**{e}"));
+                        }
+                        format!("foo({})", args.join(", "))
+                    }
+                    7 => {
+                        let base = tc.draw(sub());
+                        let i = tc.draw(sub());
+                        if tc.draw(generators::booleans()) {
+                            format!("({base})[{i}]")
+                        } else {
+                            let j = tc.draw(sub());
+                            format!("({base})[{i}, {j}]")
+                        }
+                    }
+                    8 => {
+                        // Slices, with every subset of the three parts.
+                        let base = tc.draw(sub());
+                        let part = |tc: &hegel::TestCase| -> String {
+                            if tc.draw(generators::booleans()) {
+                                tc.draw(sub())
+                            } else {
+                                String::new()
+                            }
+                        };
+                        let (i, j) = (part(tc), part(tc));
+                        if tc.draw(generators::booleans()) {
+                            format!("({base})[{i}:{j}]")
+                        } else {
+                            let k = part(tc);
+                            format!("({base})[{i}:{j}:{k}]")
+                        }
+                    }
+                    9 => {
+                        // Attribute access, including on integer literals.
+                        let base = if tc.draw(generators::booleans()) {
+                            tc.draw(generators::integers::<u64>()).to_string()
+                        } else {
+                            tc.draw(sub())
+                        };
+                        let attr = tc.draw(generators::sampled_from(vec!["imag", "real", "foo"]));
+                        format!("({base}).{attr}")
+                    }
+                    10 => {
+                        // f-strings: ASCII letters around 0-2 placeholders. Placeholder
+                        // expressions are kept quote- and brace-free (identifiers and
+                        // integers) so the literal itself stays well-formed.
+                        let word = || generators::from_regex(r"[a-z]{0,3}");
+                        let simple = || {
+                            hegel::one_of!(
+                                generators::sampled_from(vec!["x", "y", "foo"]).map(str::to_owned),
+                                generators::integers::<u64>().map(|n| n.to_string()),
+                            )
+                        };
+                        let mut text = tc.draw(word());
+                        for e in tc.draw(generators::vecs(simple()).max_size(2)) {
+                            text.push_str(&format!("{{{e}}}"));
+                            text.push_str(&tc.draw(word()));
+                        }
+                        format!("f\"{text}\"")
+                    }
+                    _ => {
+                        // Comprehensions and lambdas.
+                        let e = tc.draw(sub());
+                        let over = tc.draw(sub());
+                        match tc.draw(generators::integers::<u8>().max_value(2)) {
+                            0 => format!("[{e} for x in {over}]"),
+                            1 => {
+                                let cond = tc.draw(sub());
+                                format!("{{{e}: {cond} for x in {over}}}")
+                            }
+                            _ => {
+                                let d = tc.draw(sub());
+                                format!("(lambda a, b = {d}: {e})")
+                            }
+                        }
+                    }
+                }
+            }
+        })
+        .boxed()
+    }
+
+    /// A suite of 1-2 statements, each line prefixed with `indent`.
+    fn stmt_texts(
+        depth: u32,
+        indent: String,
+        in_def: bool,
+        in_loop: bool,
+    ) -> generators::BoxedGenerator<'static, String> {
+        hegel::compose!(|tc| {
+            let simple = depth == 0 || tc.draw(generators::booleans());
+            if simple {
+                match tc.draw(generators::integers::<u8>().max_value(4)) {
+                    0 => format!("{indent}{}\n", tc.draw(expr_texts(2))),
+                    1 => {
+                        let e = tc.draw(expr_texts(2));
+                        if tc.draw(generators::booleans()) {
+                            format!("{indent}x = {e}\n")
+                        } else {
+                            format!("{indent}x : int = {e}\n")
+                        }
+                    }
+                    2 => {
+                        let op = tc.draw(generators::sampled_from(vec![
+                            "+=", "-=", "*=", "/=", "//=", "%=", "&=", "|=", "^=", "<<=", ">>=",
+                        ]));
+                        let e = tc.draw(expr_texts(1));
+                        format!("{indent}x {op} {e}\n")
+                    }
+                    3 => {
+                        if in_def && tc.draw(generators::booleans()) {
+                            let e = tc.draw(expr_texts(1));
+                            format!("{indent}return {e}\n")
+                        } else if in_loop && tc.draw(generators::booleans()) {
+                            let s =
+                                tc.draw(generators::sampled_from(vec!["break", "continue"]));
+                            format!("{indent}{s}\n")
+                        } else {
+                            format!("{indent}pass\n")
+                        }
+                    }
+                    _ => format!("{indent}pass\n"),
+                }
+            } else {
+                let sub_indent = format!("{indent}    ");
+                match tc.draw(generators::integers::<u8>().max_value(2)) {
+                    0 => {
+                        let cond = tc.draw(expr_texts(2));
+                        let body =
+                            tc.draw(stmt_texts(depth - 1, sub_indent.clone(), in_def, in_loop));
+                        if tc.draw(generators::booleans()) {
+                            let els =
+                                tc.draw(stmt_texts(depth - 1, sub_indent, in_def, in_loop));
+                            format!("{indent}if {cond}:\n{body}{indent}else:\n{els}")
+                        } else {
+                            format!("{indent}if {cond}:\n{body}")
+                        }
+                    }
+                    1 => {
+                        let over = tc.draw(expr_texts(2));
+                        let body = tc.draw(stmt_texts(depth - 1, sub_indent, in_def, true));
+                        format!("{indent}for x in {over}:\n{body}")
+                    }
+                    _ => {
+                        let params = tc.draw(generators::sampled_from(vec![
+                            "",
+                            "a",
+                            "a, b",
+                            "a, *args, **kw",
+                            "a, *, c",
+                            "a, /, b",
+                        ]))
+                        .to_owned();
+                        // Adding a defaulted parameter is only valid when the
+                        // template has no `*`/`**` (no parameter may follow
+                        // `**kwargs`).
+                        let params = if tc.draw(generators::booleans())
+                            && !params.is_empty()
+                            && !params.contains('*')
+                        {
+                            let d = tc.draw(expr_texts(1));
+                            format!("{params}, zz = {d}")
+                        } else {
+                            params
+                        };
+                        let ret = if tc.draw(generators::booleans()) {
+                            " -> int"
+                        } else {
+                            ""
+                        };
+                        let body = tc.draw(stmt_texts(depth - 1, sub_indent, true, false));
+                        format!("{indent}def f({params}){ret}:\n{body}")
+                    }
+                }
+            }
+        })
+        .boxed()
+    }
+
+    /// A random well-formed module.
+    #[hegel::composite]
+    fn programs(tc: &hegel::TestCase) -> String {
+        let mut prog = String::new();
+        if tc.draw(generators::booleans()) {
+            prog.push_str("load(\"mod.star\", \"sym\", renamed = \"orig\")\n");
+        }
+        let n = tc.draw(generators::integers::<u8>().min_value(1).max_value(3));
+        for _ in 0..n {
+            prog.push_str(&tc.draw(stmt_texts(2, String::new(), false, false)));
+        }
+        prog
+    }
+
+    /// Pretty-printing a parsed module yields text that (a) is valid
+    /// Starlark, and (b) pretty-prints to itself after re-parsing.
+    ///
+    /// Evidence: `Display for Stmt`/`Expr` in `starlark_syntax/src/syntax/ast.rs`
+    /// prints programs in concrete syntax; the pinned `test_*_display_reparses`
+    /// tests above show maintainer-visible cases where this is violated.
+    #[hegel::test]
+    fn test_prop_parse_print_reparse_roundtrip(tc: hegel::TestCase) {
+        let prog = tc.draw(programs());
+        let ast = AstModule::parse("orig.star", prog.clone(), &Dialect::AllOptionsInternal)
+            .unwrap_or_else(|e| panic!("generated program failed to parse: {e}\n{prog}"));
+        let printed = ast.statement().to_string();
+        let ast2 = match AstModule::parse(
+            "printed.star",
+            printed.clone(),
+            &Dialect::AllOptionsInternal,
+        ) {
+            Ok(ast2) => ast2,
+            Err(e) => panic!(
+                "printed AST failed to re-parse: {e}\noriginal:\n{prog}\nprinted:\n{printed}"
+            ),
+        };
+        let printed2 = ast2.statement().to_string();
+        assert_eq!(
+            printed, printed2,
+            "print->parse->print not idempotent\noriginal:\n{prog}"
+        );
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Deeply nested source text: process-aborting stack overflows.
+//
+// Found by probing while writing the hegel property tests below. Two
+// distinct native stack overflows, both aborting the whole process (SIGABRT,
+// "fatal runtime error: stack overflow"), so per the property-testing policy
+// the reproducers are kept `#[ignore]`d rather than left failing (a
+// permanently aborting test would take the entire suite down with it).
+//
+// Measured thresholds (debug build, default test-thread stack):
+// - `(((...0...)))`  crashes inside `AstModule::parse` at depth ~200.
+// - `----...-0` (and `[[[...0...]]]`) *parse fine* at depth 1000+, then
+//   crash inside compilation/evaluation at depth ~100.
+//
+// Note the second overflow is not guarded by the interpreter's own
+// "Starlark call stack overflow" limit (`Evaluator::set_max_callstack_size`),
+// which only counts Starlark function frames, not AST/compiler recursion.
+// ---------------------------------------------------------------------------
+
+/// KNOWN BUG (process-aborting): the recursive-descent parser
+/// (`starlark_syntax/src/syntax/parser_rd.rs`) has no recursion-depth guard,
+/// so deeply nested parentheses overflow the native stack and abort the
+/// process instead of returning a parse error.
+#[test]
+#[ignore = "aborts the process: native stack overflow in AstModule::parse"]
+fn test_parser_stack_overflow_on_deeply_nested_parens() {
+    let src = format!("{}0{}", "(".repeat(1000), ")".repeat(1000));
+    let res = AstModule::parse("deep.star", src, &Dialect::AllOptionsInternal);
+    let _unused = format!("{res:?}");
+}
+
+/// KNOWN BUG (process-aborting): an expression of ~100+ nested unary minus
+/// operators parses successfully, then compilation/evaluation of the AST
+/// recurses without a depth guard and overflows the native stack, aborting
+/// the process.
+#[test]
+#[ignore = "aborts the process: native stack overflow in compile/eval of a successfully parsed AST"]
+fn test_eval_stack_overflow_on_deeply_nested_unary() {
+    let src = format!("{}0", "-".repeat(1000));
+    let ast = AstModule::parse("deep.star", src, &Dialect::AllOptionsInternal).unwrap();
+    let globals = Globals::standard();
+    Module::with_temp_heap(|module| {
+        let mut eval = Evaluator::new(&module);
+        let res = eval.eval_module(ast, &globals);
+        let _unused = format!("{:?}", res.map(|v| v.to_string()));
+        crate::Result::Ok(())
+    })
+    .unwrap();
+}
+
+mod nesting_prop {
+    use hegel::generators;
+
+    use crate::environment::Globals;
+    use crate::environment::Module;
+    use crate::eval::Evaluator;
+    use crate::syntax::AstModule;
+    use crate::syntax::Dialect;
+
+    /// Nested expressions of any shape parse and evaluate correctly up to a
+    /// conservative depth (well below the crash thresholds measured above).
+    ///
+    /// The depth bound protects the test process from the KNOWN BUG pinned
+    /// by `test_parser_stack_overflow_on_deeply_nested_parens` and
+    /// `test_eval_stack_overflow_on_deeply_nested_unary` above — it is not a
+    /// documented library limit.
+    #[hegel::test]
+    fn test_prop_moderately_nested_expressions_evaluate(tc: hegel::TestCase) {
+        let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(40));
+        let kind = tc.draw(generators::sampled_from(vec![
+            "paren", "list", "unary", "binop",
+        ]));
+        let (src, expected) = match kind {
+            "paren" => (format!("{}0{}", "(".repeat(depth), ")".repeat(depth)), "0".to_owned()),
+            "list" => (
+                format!("{}0{}", "[".repeat(depth), "]".repeat(depth)),
+                format!("{}0{}", "[".repeat(depth), "]".repeat(depth)),
+            ),
+            "unary" => (format!("{}0", "-".repeat(depth)), "0".to_owned()),
+            _ => (
+                {
+                    let mut s = String::from("(0");
+                    for _ in 0..depth {
+                        s.push_str(" + 0");
+                    }
+                    s.push(')');
+                    s
+                },
+                "0".to_owned(),
+            ),
+        };
+        let ast = AstModule::parse("deep.star", src.clone(), &Dialect::AllOptionsInternal)
+            .unwrap_or_else(|e| panic!("failed to parse at depth {depth}: {e}\n{src}"));
+        let globals = Globals::standard();
+        Module::with_temp_heap(|module| {
+            let mut eval = Evaluator::new(&module);
+            let v = eval
+                .eval_module(ast, &globals)
+                .unwrap_or_else(|e| panic!("failed to eval at depth {depth}: {e}\n{src}"));
+            assert_eq!(v.to_string(), expected);
+            crate::Result::Ok(())
+        })
+        .unwrap();
+    }
+}
