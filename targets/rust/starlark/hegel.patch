+// ---------------------------------------------------------------------------
+// Property-based tests (hegel).
+// ---------------------------------------------------------------------------
+
+mod prop {
+    use hegel::generators;
+
+    use crate::assert::Assert;
+
+    /// Unbounded Starlark recursion always fails with the documented
+    /// "Starlark call stack overflow" error (a graceful `Err`, not a native
+    /// stack overflow aborting the process), whatever the shape of the call
+    /// cycle and whatever (documented-valid) callstack limit is configured.
+    ///
+    /// Evidence: `funcall_test` above checks the `rec1`/`rec2` cases;
+    /// `Evaluator::set_max_callstack_size` documents the configurable limit;
+    /// the error text is from `cheap_call_stack.rs`.
+    #[hegel::test]
+    fn test_prop_unbounded_recursion_errors_gracefully(tc: hegel::TestCase) {
+        // A cycle of n functions, each passing through the next.
+        let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(20));
+        let mut program = String::new();
+        for i in 0..n {
+            let next = (i + 1) % n;
+            // Vary the call shape: plain call, call inside arithmetic,
+            // call via list comprehension.
+            match i % 3 {
+                0 => program.push_str(&format!("def f{i}(): return f{next}()\n")),
+                1 => program.push_str(&format!("def f{i}(): return [f{next}() for _ in [0]][0]\n")),
+                _ => program.push_str(&format!("def f{i}(): return 0 + f{next}()\n")),
+            }
+        }
+        program.push_str("f0()\n");
+
+        let mut a = Assert::new();
+        if tc.draw(generators::booleans()) {
+            let limit = tc.draw(generators::integers::<usize>().min_value(1).max_value(200));
+            a.setup_eval(move |eval| eval.set_max_callstack_size(limit).unwrap());
+        }
+        a.fail(&program, "Starlark call stack overflow");
+    }
+}
