+#[hegel::test]
+fn field_types_round_trip_through_display(tc: hegel::TestCase) {
+    let fw = arb_forwarded(&tc);
+    assert_eq!(Forwarded::from_str(&fw.to_string()), Ok(fw.clone()));
+    let (c, o) = arb_origin(&tc);
+    assert_eq!(Origin::from_str(&o.to_string()), Ok(o.clone()));
+    if let Some(c) = c {
+        assert_eq!(OriginCategory::from_str(&c.to_string()), Ok(c));
+    }
+    let a = arb_applied(&tc);
+    assert_eq!(AppliedUpstream::from_str(&a.to_string()), Ok(a));
+    // An Origin with a category reads back through the header.
+    let mut p = lossless::PatchHeader::new();
+    p.set_origin(c, o.clone());
+    let again = lossless::PatchHeader::from_str(&p.to_string()).unwrap();
+    assert_eq!(again.origin(), Some((c, o)));
+    // Bug ids.
+    let n = tc.draw(int!(0, 9_999_999)) as u32;
+    for form in [format!("{n}"), format!("#{n}"), format!("https://bugs.debian.org/{n}"), format!("http://bugs.debian.org/{n}"), format!("  {n} ")] {
+        assert_eq!(dep3::parse_debian_bug_id(&form), Some(n), "{form:?}");
+    }
+}
