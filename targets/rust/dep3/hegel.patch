+// ---------------------------------------------------------------------------
+// Building and editing
+// ---------------------------------------------------------------------------
+
+/// Build a header from scratch with the setters; every getter and the re-parse
+/// of the text agree with the model. Setters on fields that already exist are
+/// pinned separately.
+#[hegel::test]
+fn built_headers_are_read_back(tc: hegel::TestCase) {
+    let h = tc.draw(arb_header().print_as_debug());
+    let mut p = lossless::PatchHeader::new();
+    // Blank lines in the long description are pinned (`set_description` marker).
+    let long: Vec<String> = h.long.iter().filter(|l| !l.is_empty()).cloned().collect();
+    let with_long = !long.is_empty() && tc.draw(generators::booleans());
+    if with_long {
+        p.set_description(&format!("{}\n{}", h.synopsis, long.join("\n")));
+    } else {
+        p.set_description(&h.synopsis);
+    }
+    if let Some((c, o)) = &h.origin {
+        p.set_origin(*c, o.clone());
+    }
+    if let Some(f) = &h.forwarded {
+        p.set_forwarded(f.clone());
+    }
+    if let Some(a) = h.authors.first() {
+        p.set_author(a);
+    }
+    if let Some(d) = h.last_update {
+        p.set_last_update(d);
+    }
+    if let Some(a) = &h.applied_upstream {
+        p.set_applied_upstream(a.clone());
+    }
+    // One bug per key (setters on an existing key are pinned).
+    let mut seen = std::collections::HashSet::new();
+    let mut bugs = Vec::new();
+    for (v, u) in &h.bugs {
+        if seen.insert(v.clone()) {
+            match v {
+                Some(v) => p.set_vendor_bug(v, u),
+                None => p.set_upstream_bug(u),
+            }
+            bugs.push((v.clone(), u.clone()));
+        }
+    }
+    let text = p.to_string();
+    let again = lossless::PatchHeader::from_str(&text).expect("built text parses");
+    for q in [&p, &again] {
+        assert_eq!(q.description(), Some(h.synopsis.clone()), "description");
+        if with_long {
+            assert_eq!(q.long_description(), Some(long.join("\n")), "long_description");
+        }
+        assert_eq!(q.origin(), h.origin, "origin");
+        assert_eq!(q.forwarded(), h.forwarded, "forwarded");
+        assert_eq!(q.author(), h.authors.first().cloned(), "author");
+        assert_eq!(q.last_update(), h.last_update, "last_update");
+        assert_eq!(q.applied_upstream(), h.applied_upstream, "applied_upstream");
+        let mut got: Vec<(Option<String>, String)> = q.bugs().collect();
+        let mut want = bugs.clone();
+        got.sort();
+        want.sort();
+        assert_eq!(got, want, "bugs");
+    }
+    // dpkg reads the built text.
+    let d = dpkg_read(&text).expect("dpkg reads the built header");
+    assert_eq!(d.len(), 1);
+    // The lossy layer reads it too and agrees on the typed fields.
+    let l = lossy::PatchHeader::from_str(&text).expect("lossy reads the built header");
+    assert_eq!(l.synopsis(), Some(h.synopsis.as_str()));
+    assert_eq!(l.origin, h.origin);
+    assert_eq!(l.forwarded, h.forwarded);
+    assert_eq!(l.author, h.authors.first().cloned());
+    assert_eq!(l.last_update, h.last_update);
+    assert_eq!(l.applied_upstream, h.applied_upstream);
+}
+
+fn set_or_insert(p: &mut lossless::PatchHeader, key: &str, value: &str) {
+    if p.as_deb822().contains_key(key) {
+        p.as_deb822_mut().set(key, value);
+    } else {
+        p.as_deb822_mut().insert(key, value);
+    }
+}
+
+/// Editing a parsed header through the deb822 paragraph keeps the getters and
+/// the text in step.
+#[hegel::test]
+fn paragraph_edits_are_seen_by_the_getters(tc: hegel::TestCase) {
+    let h = tc.draw(arb_header().print_as_debug());
+    if h.body.is_none() && !h.trailing_newline {
+        // Inserting after an unterminated last line glues the lines:
+        // deb822-lossless/9, inherited and not re-recorded.
+        return;
+    }
+    let (mut p, _) = lossless::PatchHeader::parse_relaxed(&h.text()).unwrap();
+    let fw = arb_forwarded(&tc);
+    set_or_insert(&mut p, "Forwarded", &fw.to_string());
+    assert_eq!(p.forwarded(), Some(fw.clone()));
+    let d = arb_date(&tc);
+    set_or_insert(&mut p, "Last-Update", &d.format("%Y-%m-%d").to_string());
+    assert_eq!(p.last_update(), Some(d));
+    p.as_deb822_mut().remove("Origin");
+    assert_eq!(p.origin(), None);
+    let again = lossless::PatchHeader::from_str(&p.to_string()).unwrap();
+    assert_eq!(again.forwarded(), Some(fw));
+    assert_eq!(again.last_update(), Some(d));
+    assert_eq!(again.origin(), None);
+    assert_eq!(again.description(), Some(h.synopsis.clone()));
+    assert_eq!(again.to_string(), p.to_string());
+}
