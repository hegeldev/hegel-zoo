+#[test]
+fn the_lossy_header_keeps_repeated_and_vendor_bug_fields() {
+    let text = "Description: fix\nBug-Debian: https://bugs.debian.org/1\nBug-Debian: https://bugs.debian.org/2\nBug-Ubuntu: https://launchpad.net/bugs/3\nReviewed-by: R <r@x>\nReviewed-by: S <s@x>\n";
+    let l = lossy::PatchHeader::from_str(text).unwrap();
+    let shown = l.to_string();
+    let p = lossless::PatchHeader::from_str(&shown).unwrap();
+    assert_eq!(p.bugs().count(), 3, "{shown:?}");
+    assert_eq!(p.reviewed_by().len(), 2, "{shown:?}");
