+/// DEP-3's first sample: a `git format-patch` file. The header ends at the
+/// first empty line, the commit body follows, then the pseudo-header, then `---`.
+const GIT_SAMPLE: &str = "From d33286c75b623cfb249c627b0c348be62e6377c9 Mon Sep 17 00:00:00 2001
+From: Jaap Karssenberg <jaap.karssenberg@gmail.com>
+Date: Tue, 11 Feb 2025 21:28:17 +0100
+Subject: [PATCH] Fixup focus of quicknote plugin
+
+Fixes #2764
+
+Origin: upstream, https://github.com/zim-desktop-wiki/zim-desktop-wiki/commit/d33286c75b623cfb249c627b0c348be62e6377c9.patch
+Bug: https://github.com/zim-desktop-wiki/zim-desktop-wiki/issues/2764
+Bug-Debian: https://bugs.debian.org/1110423
+----
+ zim/plugins/quicknote.py | 4 ++++
+ 1 file changed, 4 insertions(+)
+";
+
+#[test]
+fn a_git_format_patch_header_is_read() {
+    let (p, _) = lossless::PatchHeader::parse_relaxed(GIT_SAMPLE).expect("DEP-3's own sample parses");
+    assert_eq!(p.description(), Some("[PATCH] Fixup focus of quicknote plugin".to_string()));
+    assert_eq!(p.author(), Some("Jaap Karssenberg <jaap.karssenberg@gmail.com>".to_string()));
+    assert_eq!(p.vendor_bugs("Debian").collect::<Vec<_>>(), vec!["https://bugs.debian.org/1110423".to_string()]);
+}
+
+#[test]
+fn a_pseudo_header_after_the_body_is_read() {
+    // Without the mbox `From ` line: the commit body and the pseudo-header.
+    let text = "From: A <a@example.com>\nSubject: fix\n\nSome explanation.\n\nOrigin: vendor, https://bugs.debian.org/1\nForwarded: not-needed\n---\n a | 1\n";
+    let (p, _) = lossless::PatchHeader::parse_relaxed(text).expect("parses");
+    assert_eq!(p.forwarded(), Some(Forwarded::NotNeeded), "the pseudo-header's fields are read: {}", p.to_string());
+    assert!(p.origin().is_some());
+    let end = dep3::header_end(text);
+    let l = lossy::PatchHeader::from_str(&text[..end]).expect("lossy parses");
+    assert_eq!(l.forwarded, Some(Forwarded::NotNeeded));
+}
+
+#[test]
+fn a_second_paragraph_is_not_silently_dropped() {
+    // Even in deb822 form: a blank line followed by more fields.
+    let text = "Description: fix\n\nForwarded: no\n";
+    let (p, _) = lossless::PatchHeader::parse_relaxed(text).unwrap();
+    assert_eq!(p.forwarded(), Some(Forwarded::No), "{}", p.to_string());
+}
+
+#[test]
+fn setters_replace_an_existing_field() {
+    let mut p = lossless::PatchHeader::from_str("From: A <a@x>\nSubject: s\nForwarded: no\nLast-Update: 2020-01-01\n").unwrap();
+    p.set_author("B <b@x>");
+    assert_eq!(p.author(), Some("B <b@x>".to_string()), "{}", p.to_string());
+    p.set_forwarded(Forwarded::NotNeeded);
+    assert_eq!(p.forwarded(), Some(Forwarded::NotNeeded), "{}", p.to_string());
+    let d = chrono::NaiveDate::from_ymd_opt(2021, 2, 3).unwrap();
+    p.set_last_update(d);
+    assert_eq!(p.last_update(), Some(d), "{}", p.to_string());
+    assert_eq!(p.as_deb822().get_all("Forwarded").count(), 1, "one Forwarded field: {}", p.to_string());
+}
+
+#[test]
+fn set_description_works_without_a_long_description() {
+    for text in ["Subject: old\nFrom: A <a@x>\n", "Description: old\n"] {
+        let mut p = lossless::PatchHeader::from_str(text).unwrap();
+        p.set_description("new");
+        assert_eq!(p.description(), Some("new".to_string()));
+        let again = lossless::PatchHeader::from_str(&p.to_string()).unwrap();
+        assert_eq!(again.description(), Some("new".to_string()));
+    }
+}
+
+#[test]
+fn a_set_description_reads_the_same_live_and_after_a_reparse() {
+    // The encoded ` .` marker is indented once more by `insert`, so the live
+    // tree reads ` .` where the re-parsed text reads `.`.
+    let mut p = lossless::PatchHeader::new();
+    p.set_description("Fix frobnication\n\nDetails follow.");
+    let text = p.to_string();
+    let again = lossless::PatchHeader::from_str(&text).unwrap();
+    assert_eq!(p.long_description(), again.long_description(), "{text:?}");
+    assert_eq!(p.as_deb822().get("Description"), again.as_deb822().get("Description"), "{text:?}");
+}
+
+#[test]
+fn the_layers_agree_on_the_long_description() {
+    for (text, want) in [
+        ("Description: fix\n", None),
+        ("Description: fix\n long\n .\n more\n", Some("long\n\nmore".to_string())),
+    ] {
+        let p = lossless::PatchHeader::from_str(text).unwrap();
+        let l = lossy::PatchHeader::from_str(text).unwrap();
+        assert_eq!(l.long_description(), want);
+        assert_eq!(p.long_description(), want, "{text:?}");
+    }
+}
