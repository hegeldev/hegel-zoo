+#[test]
+fn acked_by_counts_as_a_review() {
+    let text = "Description: fix\nAcked-by: T <t@x>\n";
+    let p = lossless::PatchHeader::from_str(text).unwrap();
+    assert_eq!(p.reviewed_by(), vec!["T <t@x>".to_string()]);
+    let l = lossy::PatchHeader::from_str(text).unwrap();
