+// --------------------------------------------------------------------------- properties: eggs
+
+/// `.egg-info` filenames (`name[-version[-pyX.Y[-platform]]]`) give the normalised name and the
+/// normalised version.
+#[hegel::test]
+fn egg_info_filenames_give_name_and_version(tc: TestCase) {
+    let name = tc.draw(arb_name().print_as_debug());
+    let version = chance(&tc, 4).then(|| tc.draw(arb_version().print_as_debug()));
+    let mut stem = name.clone();
+    if let Some(v) = &version {
+        stem.push('-');
+        stem.push_str(v);
+        if chance(&tc, 2) {
+            stem.push_str(pick(&tc, &["-py3.12", "-py2.7", "-py3.9"]));
+            if chance(&tc, 2) {
+                stem.push_str(pick(&tc, &["-linux-x86_64", "-darwin", "-win32", "-macosx-10.9-x86_64"]));
+            }
+        }
+    }
+    let filename = format!("{stem}.egg-info");
+    let egg = EggInfoFilename::from_str(&filename).unwrap_or_else(|e| panic!("uv rejected {filename}: {e}"));
+    assert_eq!(egg.name.to_string(), py_canonical(&name));
+    assert_eq!(egg.version.map(|v| v.to_string()), version.as_deref().map(|v| py_version(v).unwrap()));
+    assert!(EggInfoFilename::from_str(&stem).is_err(), "{stem} has no .egg-info suffix");
+}
+
+// --------------------------------------------------------------------------- pins
+
+/// Bug 1: the single-tag fast path parses the numbers of a tag with `str::parse`, which takes a
+/// leading `+`, and never checks the characters the compressed-tag path rejects: `py3+9`,
+/// `cp3+9`, `manylinux_+2_17_x86_64` are accepted (and displayed as `py39`, `cp39`,
+/// `manylinux_2_17_x86_64`). `packaging` rejects `py3+9` (not an identifier); the crate rejects
+/// the same atoms as soon as a second atom is present.
+#[hegel::test]
+fn fast_path_tags_take_no_plus_sign(tc: TestCase) {
+    let minor = n(&tc, 0, 15);
+    let tagged = match n(&tc, 0, 3) {
+        0 => format!("foo-1.0-py3+{minor}-none-any.whl"),
+        1 => format!("foo-1.0-cp3+{minor}-none-any.whl"),
+        2 => format!("foo-1.0-py3-none-manylinux_+2_{minor}_x86_64.whl"),
+        _ => format!("foo-1.0-py3-none-macosx_10_+{minor}_x86_64.whl"),
+    };
+    let compressed = tagged.replace("-none-any", ".py2-none-any").replace("-py3-none-m", "-py3.py2-none-m");
+    assert!(WheelFilename::from_str(&compressed).is_err(), "{compressed} is rejected on the compressed-tag path");
+    assert!(
+        WheelFilename::from_str(&tagged).is_err(),
+        "{tagged} is accepted on the single-tag path, as {}",
+        WheelFilename::from_str(&tagged).unwrap()
+    );
+}
+
+/// Bug 2: a trailing `.` in a tag component is ignored (`py3.`, `none.`): the splitter yields no
+/// empty atom at the end, while `..` and a leading `.` are rejected as empty atoms and `packaging`
+/// rejects all of them ("has an empty component").
+#[hegel::test(suppress_health_check = [HealthCheck::LargeInitialTestCase])]
+fn trailing_dot_in_a_tag_component_is_an_empty_atom(tc: TestCase) {
+    let w = tc.draw(arb_wheel().print_as_debug());
+    let mut w = w;
+    w.build = None;
+    match n(&tc, 0, 2) {
+        0 => w.python.last_mut().unwrap().push('.'),
+        1 => w.abi.last_mut().unwrap().push('.'),
+        _ => w.platform.last_mut().unwrap().push('.'),
+    }
+    let filename = w.filename();
+    assert!(py_wheel(&filename).is_err());
+    assert!(WheelFilename::from_str(&filename).is_err(), "{filename} is accepted");
+}
+
+/// Bug 3: leading zeros in the numbers of a single tag are dropped by `Display`: `py307`
+/// becomes `py37`, `cp309` becomes `cp39`, `manylinux_02_17_x86_64` becomes
+/// `manylinux_2_17_x86_64` — the parsed filename is displayed as a different filename
+/// (`packaging` keeps the tag text).
+#[hegel::test]
+fn tag_numbers_keep_their_spelling(tc: TestCase) {
+    let tags = match n(&tc, 0, 2) {
+        0 => format!("py30{}-none-any", n(&tc, 0, 9)),
+        1 => format!("cp30{0}-cp30{0}-linux_x86_64", n(&tc, 0, 9)),
+        _ => format!("py3-none-manylinux_0{}_17_x86_64", n(&tc, 1, 9)),
+    };
+    let filename = format!("foo-1.0-{tags}.whl");
+    let py = py_wheel(&filename).unwrap();
+    assert_eq!(py.tags.len(), 1);
+    let uv = WheelFilename::from_str(&filename).unwrap();
+    assert_eq!(uv.to_string(), filename);
+}
+
+/// Bug 4: a build tag whose leading digits do not fit a `u64` is rejected ("number too large to
+/// fit in target type"); the specification sorts the digits "as an int" and `packaging` takes
+/// them unbounded.
+#[hegel::test]
+fn build_tag_digits_are_unbounded(tc: TestCase) {
+    let digits: String = (0..n(&tc, 20, 30)).map(|i| if i == 0 { '9' } else { pick(&tc, &['0', '5', '9']) }).collect();
+    let filename = format!("foo-1.0-{digits}-py3-none-any.whl");
+    let py = py_wheel(&filename).unwrap();
+    assert_eq!(py.build.as_ref().unwrap().0, digits);
+    let uv = WheelFilename::from_str(&filename).unwrap_or_else(|e| panic!("{filename}: {e}"));
+    assert_eq!(uv.build_tag().unwrap().to_string(), digits);
+}
+
+/// Bug 5: with a package-name hint, an sdist whose name has a run of separators
+/// (`foo__bar-1.0.tar.gz`, `foo..bar-1.0.tar.gz` for `foo-bar`) is rejected ("Name doesn't
+/// start with package name"): the hint is matched byte by byte at the hint's length. The parser
+/// without a hint, the wheel parser with the same hint, and `packaging` all read `foo-bar`.
+#[hegel::test]
+fn hinted_sdist_names_match_by_normalisation(tc: TestCase) {
+    let run: String = (0..n(&tc, 2, 3)).map(|_| pick(&tc, &['_', '.', '-'])).collect();
+    let (ext, _) = pick(&tc, &EXTENSIONS);
+    let version = tc.draw(arb_version().print_as_debug());
+    let filename = format!("foo{run}bar-{version}.{ext}");
+    let package = PackageName::from_str("foo-bar").unwrap();
+    let plain = SourceDistFilename::parsed_normalized_filename(&filename).unwrap();
+    assert_eq!(plain.name, package);
+    if ext == "tar.gz" || ext == "zip" {
+        assert_eq!(py_sdist(&filename).unwrap().0, "foo-bar");
+    }
+    assert!(DistFilename::try_from_filename_with_reason(&format!("foo{run}bar-{version}-py3-none-any.whl"), &package).is_ok());
+    let hinted = DistFilename::try_from_filename_with_reason(&filename, &package);
+    assert_eq!(hinted.map_err(|e| e.to_string()), Ok(DistFilename::SourceDistFilename(plain)));
+}
+
+/// Bug 6: extension matching is case-insensitive for the `tar` of `.tar.gz` and case-sensitive
+/// for everything else: `a-1.0.TAR.gz` is an sdist (displayed as `a-1.0.tar.gz`), `a-1.0.tar.GZ`
+/// and `a-1.0.Zip` are not. The conventions and `packaging` are case-sensitive throughout.
+#[hegel::test]
+fn extension_case_is_treated_alike(tc: TestCase) {
+    let name = tc.draw(arb_name().print_as_debug());
+    let version = tc.draw(arb_version().print_as_debug());
+    let tar = pick(&tc, &["TAR", "Tar", "tAr"]);
+    let ext = pick(&tc, &["gz", "bz2", "xz", "zst", "lz", "lzma"]);
+    let upper = format!("{name}-{version}.{tar}.{ext}");
+    let mixed = format!("{name}-{version}.tar.{}", ext.to_uppercase());
+    assert!(SourceDistExtension::from_path(&mixed).is_err());
+    assert!(py_sdist(&upper).is_err());
+    assert!(
+        SourceDistExtension::from_path(&upper).is_err(),
+        "{upper} is read as {:?}",
+        SourceDistExtension::from_path(&upper).unwrap()
+    );
+}
