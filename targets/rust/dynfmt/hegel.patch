+//! Hegel property tests for dynfmt's `PythonFormat` and `SimpleCurlyFormat`.
+//!
+//! `PythonFormat` is documented as "the `printf`-like format that python 2 used for formatting
+//! strings" — key, flags, width, precision, length modifier, conversion type, "for the full
+//! specification, please refer to the Python string formatting docs".  The oracle is Python
+//! itself: a `python3` child process held open for the whole test run answers `fmt % args` for
+//! the same format string and the same arguments (integers, strings, a list or a mapping).  Where
+//! the crate documents a Rust choice instead (`%s` is `Display`, `%r` is JSON, arguments are Rust
+//! values), the differential keeps to what both define.  `SimpleCurlyFormat` is checked against
+//! the three-line contract in its rustdoc.
+
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::sync::{Mutex, OnceLock};
+
+use dynfmt::{Error, Format, Position, PythonFormat, SimpleCurlyFormat};
+use hegel::generators::Generator as _;
+use hegel::{generators, TestCase};
+use serde::ser::{Serialize, SerializeMap, Serializer};
+
+// ---------------------------------------------------------------- generators
+
+/// Text characters: anything but `%` (and braces, for the curly format).  The space is in
+/// twice: the pool weights, so it is drawn with `vecs(sampled_from)`, not `text().alphabet()`.
+#[rustfmt::skip]
+const TEXT: &[char] = &[
+    'a', 'b', 'z', 'A', 'Z', '0', '9', ' ', ' ', ',', '.', ':', '-', '_', '/', '\\', '!', '#',
+    '$', '&', '*', '+', '=', '<', '>', '|', '~', '\'', '"', '@', '(', ')', '\t', '\n', 'é', 'ß',
+    'Ж', '日', '€', '😀', '\u{0}',
+];
+const KEY_FIRST: &[char] = &['a', 'k', 'x', '_', 'é'];
+const KEY_REST: &[char] = &['a', 'b', '1', '_', '9', 'ü'];
+/// Integers of note: the small ones and the edges of the fixed-size types.
+#[rustfmt::skip]
+const EDGE_INTS: &[i64] = &[
+    0, 1, -1, 255, 256, 65535, 1 << 31, i64::MAX, i64::MIN, -(1 << 40),
+];
+/// String arguments that look like specs themselves.
+const SPEC_LIKE: &[&str] = &["%", "%s", "%%", "%d", "{}", "{0}", ""];
+
+fn ints(lo: i64, hi: i64) -> generators::IntegerGenerator<i64> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// An index into a list of `len` elements.
+fn index(len: usize) -> generators::IntegerGenerator<usize> {
+    generators::integers().min_value(0).max_value(len - 1)
+}
+
+/// One of the given strings.
+fn sampled(pool: &'static [&'static str]) -> impl hegel::PrintableGenerator<&'static str> {
+    generators::sampled_from(pool)
+}
+
+/// Up to `max` text characters.
+fn text(max: usize) -> impl hegel::PrintableGenerator<String> {
+    generators::vecs(generators::sampled_from(TEXT))
+        .max_size(max)
+        .map(|chars| chars.into_iter().collect())
+}
+
+/// A `%(key)` or `{key}` name: a letter, `_` or `é`, then up to four more characters.
+fn key() -> impl hegel::PrintableGenerator<String> {
+    hegel::tuples!(
+        generators::sampled_from(KEY_FIRST),
+        generators::vecs(generators::sampled_from(KEY_REST)).max_size(4)
+    )
+    .map(|(first, rest)| std::iter::once(first).chain(rest).collect())
+}
+
+/// `n` distinct keys.
+fn distinct_keys(n: usize) -> impl hegel::PrintableGenerator<Vec<String>> {
+    generators::btree_sets(key())
+        .min_size(n)
+        .max_size(n)
+        .map(|keys| keys.into_iter().collect())
+}
+
+/// `Some` of a draw from `g` with probability `p`, `None` otherwise; shrinks to `None`.
+fn maybe<T: hegel::PrettyPrintable>(
+    p: f64,
+    g: impl hegel::PrintableGenerator<T>,
+) -> impl hegel::PrintableGenerator<Option<T>> {
+    hegel::tuples!(generators::weighted_booleans(p), g).map(|(present, v)| present.then_some(v))
+}
+
+/// A draw from `a` with probability `p`, from `b` otherwise; both are drawn, and it shrinks to
+/// `b`.  (Hegel has no weighted `one_of!`.)
+fn either<T: hegel::PrettyPrintable>(
+    p: f64,
+    a: impl hegel::PrintableGenerator<T>,
+    b: impl hegel::PrintableGenerator<T>,
+) -> impl hegel::PrintableGenerator<T> {
+    hegel::tuples!(generators::weighted_booleans(p), a, b)
+        .map(|(first, a, b)| if first { a } else { b })
+}
+
+/// An argument value: a Rust value that is also a Python value with the same `%d`/`%s` text.
+#[derive(Clone, Debug, PartialEq, hegel::PrettyPrintable)]
+enum Val {
+    Int(i64),
+    Float(f64),
+    Str(String),
+}
+
+impl Val {
+    /// What `SimpleCurlyFormat` prints: display mode.
+    fn display(&self) -> String {
+        match self {
+            Val::Int(i) => i.to_string(),
+            Val::Float(x) => x.to_string(),
+            Val::Str(s) => s.clone(),
+        }
+    }
+}
+
+impl Serialize for Val {
+    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+        match self {
+            Val::Int(i) => s.serialize_i64(*i),
+            Val::Float(x) => s.serialize_f64(*x),
+            Val::Str(t) => s.serialize_str(t),
+        }
+    }
+}
+
+/// Positional or named arguments, as Python sees them (a tuple or a dict).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Args {
+    List(Vec<Val>),
+    Map(Vec<(String, Val)>),
+}
+
+impl Serialize for Args {
+    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+        match self {
+            Args::List(v) => v.serialize(s),
+            Args::Map(m) => {
+                let mut map = s.serialize_map(Some(m.len()))?;
+                for (k, v) in m {
+                    map.serialize_entry(k, v)?;
+                }
+                map.end()
+            }
+        }
+    }
+}
+
+/// An integer: a digit, a small one, an edge of some fixed-size type, or any at all.
+fn int() -> impl hegel::PrintableGenerator<i64> {
+    hegel::one_of!(
+        ints(0, 9),
+        ints(-1000, 1000),
+        generators::sampled_from(EDGE_INTS),
+        ints(i64::MIN, i64::MAX),
+    )
+}
+
+/// A string argument: text, or one time in five something that looks like a spec.
+fn string() -> impl hegel::PrintableGenerator<String> {
+    hegel::one_of!(
+        text(6),
+        text(6),
+        text(6),
+        text(6),
+        sampled(SPEC_LIKE).map(str::to_string),
+    )
+}
+
+/// A conversion character and a value it accepts.
+fn conv(
+    ty: &'static str,
+    value: impl hegel::PrintableGenerator<Val>,
+) -> impl hegel::PrintableGenerator<(&'static str, Val)> {
+    hegel::tuples!(generators::just(ty), value)
+}
+
+const MODIFIERS: &[&str] = &["h", "l", "L"];
+
+/// One `%` spec of the general property, and the text after it.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Spec {
+    ty: &'static str,
+    value: Val,
+    alternate: bool,
+    left: bool,
+    modifier: Option<&'static str>,
+    text: String,
+}
+
+impl Spec {
+    /// The spec as text, with `%(key)` if a key is given.  Python 3 refuses flags and modifiers
+    /// on `%%`, and `#` with `X` is pinned (dynfmt/10), so neither is written.
+    fn render(&self, key: Option<&str>) -> String {
+        let mut s = String::from("%");
+        if let Some(key) = key {
+            s.push_str(&format!("({key})"));
+        }
+        if self.ty != "%" {
+            if self.alternate && self.ty != "X" {
+                s.push('#');
+            }
+            if self.left {
+                s.push('-');
+            }
+            if let Some(modifier) = self.modifier {
+                s.push_str(modifier);
+            }
+        }
+        s.push_str(self.ty);
+        // Text starting with a digit right after a spec is the pinned dynfmt/4 shape.
+        s.push_str(
+            self.text
+                .trim_start_matches(|c: char| c.is_ascii_digit() || c == '*'),
+        );
+        s
+    }
+}
+
+/// `%(d|i|u|o|x|X|s|c|%)` (`s` twice) with a value both sides define — any integer for the
+/// decimal forms, a non-negative one for the radix forms, a string or (three times in ten) an
+/// integer for `s`, one character for `c` — each of `#` and `-` one time in five, a modifier
+/// three times in twenty, and up to five characters of text after it.
+fn spec() -> impl hegel::PrintableGenerator<Spec> {
+    let int_val = || int().map(Val::Int);
+    let radix_val = || ints(0, i64::MAX).map(Val::Int);
+    let s_val = || either(0.3, int().map(Val::Int), string().map(Val::Str));
+    let conversion = hegel::one_of!(
+        conv("d", int_val()),
+        conv("i", int_val()),
+        conv("u", int_val()),
+        conv("o", radix_val()),
+        conv("x", radix_val()),
+        conv("X", radix_val()),
+        conv("s", s_val()),
+        conv("s", s_val()),
+        conv(
+            "c",
+            generators::sampled_from(TEXT).map(|c| Val::Str(c.to_string()))
+        ),
+        conv("%", generators::just(Val::Int(0))),
+    );
+    hegel::tuples!(
+        conversion,
+        generators::weighted_booleans(0.2),
+        generators::weighted_booleans(0.2),
+        maybe(0.15, sampled(MODIFIERS)),
+        text(5)
+    )
+    .map(|((ty, value), alternate, left, modifier, text)| Spec {
+        ty,
+        value,
+        alternate,
+        left,
+        modifier,
+        text,
+    })
+}
+
+/// A format string of text and one to five specs, with its arguments: positional, or three
+/// times in ten named under distinct keys.
+#[hegel::composite]
+fn python_call(tc: &TestCase) -> (String, Args) {
+    let named = tc.draw(generators::weighted_booleans(0.3));
+    let lead = tc.draw(text(5));
+    let specs = tc.draw(generators::vecs(spec()).min_size(1).max_size(5));
+    let with_args: Vec<&Spec> = specs.iter().filter(|s| s.ty != "%").collect();
+    if named {
+        let mut keys = tc.draw(distinct_keys(with_args.len())).into_iter();
+        let mut fmt = lead;
+        let mut map = Vec::new();
+        for spec in &specs {
+            let key = (spec.ty != "%").then(|| keys.next().unwrap());
+            if let Some(key) = &key {
+                map.push((key.clone(), spec.value.clone()));
+            }
+            fmt.push_str(&spec.render(key.as_deref()));
+        }
+        (fmt, Args::Map(map))
+    } else {
+        let fmt = lead + &specs.iter().map(|s| s.render(None)).collect::<String>();
+        let list = with_args.iter().map(|s| s.value.clone()).collect();
+        (fmt, Args::List(list))
+    }
+}
+
+// ---------------------------------------------------------------- the Python oracle
+
+struct Py {
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+    _child: Child,
+}
+
+const PY_SERVER: &str = r#"
+import sys, json
+for line in sys.stdin:
+    fmt, args = json.loads(line)
+    try:
+        out = fmt % (tuple(args) if isinstance(args, list) else args)
+        r = ["ok", out]
+    except Exception as e:
+        r = ["err", type(e).__name__ + ": " + str(e)]
+    print(json.dumps(r), flush=True)
+"#;
+
+fn py() -> &'static Mutex<Py> {
+    static PY: OnceLock<Mutex<Py>> = OnceLock::new();
+    PY.get_or_init(|| {
+        let mut child = Command::new("python3")
+            .args(["-u", "-c", PY_SERVER])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .spawn()
+            .expect("python3 is needed as the oracle");
+        let stdin = child.stdin.take().unwrap();
+        let stdout = BufReader::new(child.stdout.take().unwrap());
+        Mutex::new(Py {
+            stdin,
+            stdout,
+            _child: child,
+        })
+    })
+}
+
+/// `fmt % args` in Python: the text, or the exception.
+fn python(fmt: &str, args: &Args) -> Result<String, String> {
+    let mut py = py().lock().unwrap();
+    let mut line = serde_json::to_string(&(fmt, args)).unwrap();
+    line.push('\n');
+    py.stdin.write_all(line.as_bytes()).unwrap();
+    let mut reply = String::new();
+    py.stdout.read_line(&mut reply).unwrap();
+    let (tag, text): (String, String) = serde_json::from_str(&reply).expect("python reply");
+    if tag == "ok" {
+        Ok(text)
+    } else {
+        Err(text)
+    }
+}
+
+/// dynfmt's answer for the same call.
+fn dyn_python(fmt: &str, args: &Args) -> Result<String, String> {
+    let r = match args {
+        Args::List(v) => PythonFormat.format(fmt, v),
+        Args::Map(m) => {
+            let map: HashMap<String, Val> = m.iter().cloned().collect();
+            PythonFormat.format(fmt, map).map(|s| s.into_owned().into())
+        }
+    };
+    r.map(|s| s.into_owned()).map_err(|e| e.to_string())
+}
+
+/// Both sides must agree: the same text, or both an error.
+fn same_as_python(fmt: &str, args: &Args) {
+    let want = python(fmt, args);
+    let got = dyn_python(fmt, args);
+    match (&want, &got) {
+        (Ok(a), Ok(b)) if a == b => {}
+        (Err(_), Err(_)) => {}
+        _ => panic!(
+            "{:?} % {:?}\n python: {:?}\n dynfmt: {:?}",
+            fmt, args, want, got
+        ),
+    }
+}
+
+// ---------------------------------------------------------------- general properties
+
+/// One or more `%` specs whose meaning both sides define — `%[#][-][key](d|i|u|o|x|X|s|c|%)`
+/// with an optional `h`/`l`/`L` modifier, integers (non-negative for the radix forms) and
+/// strings, positional or named — print as Python prints them, with the text around them
+/// copied verbatim.  Widths, precisions, `+`/` `/`0` flags and floats are pinned separately.
+#[hegel::test]
+fn specs_format_like_python(tc: TestCase) {
+    let (fmt, args) = tc.draw(python_call());
+    same_as_python(&fmt, &args);
+}
+
+/// One to four strings, and a shorter list of integers.
+#[hegel::composite]
+fn full_and_short_args(tc: &TestCase) -> (Vec<Val>, Vec<Val>) {
+    let full = tc.draw(
+        generators::vecs(string().map(Val::Str))
+            .min_size(1)
+            .max_size(4),
+    );
+    let short = tc.draw(generators::vecs(int().map(Val::Int)).max_size(full.len() - 1));
+    (full, short)
+}
+
+/// The argument protocol: too few positional arguments is `MissingArg` at the first index
+/// beyond the list, a key on a list is `MapRequired`, `%s` on a map is `ListRequired`, and
+/// `format_into` writes the same bytes as `format`.  A string without specs is returned
+/// borrowed.
+#[hegel::test]
+fn argument_errors_and_format_into(tc: TestCase) {
+    let (full, short) = tc.draw(full_and_short_args());
+    let key = tc.draw(key());
+    let plain = tc.draw(text(8));
+    let fmt = "%s,".repeat(full.len());
+    let have = short.len();
+    match PythonFormat.format(&fmt, &short) {
+        Err(Error::MissingArg(Position::Index(i))) => assert_eq!(i, have),
+        other => panic!("{:?} with {} args: {:?}", fmt, have, other),
+    }
+    assert!(matches!(
+        PythonFormat.format(&format!("%({})s", key), &short),
+        Err(Error::MapRequired)
+    ));
+    let map: HashMap<String, Val> = [(key.clone(), Val::Int(1))].into_iter().collect();
+    assert!(matches!(
+        PythonFormat.format("%s", &map),
+        Err(Error::ListRequired)
+    ));
+    assert!(matches!(
+        PythonFormat.format(&format!("%(nope_{})s", key), &map),
+        Err(Error::MissingArg(Position::Key(_)))
+    ));
+
+    let text = PythonFormat.format(&fmt, &full).unwrap();
+    let mut buf = Vec::new();
+    PythonFormat.format_into(&mut buf, &fmt, &full).unwrap();
+    assert_eq!(buf, text.as_bytes());
+
+    let out = PythonFormat.format(&plain, &full).unwrap();
+    assert!(matches!(out, std::borrow::Cow::Borrowed(_)), "{:?}", plain);
+    assert_eq!(out, plain);
+}
+
+/// A `{...}` placeholder of the curly format and the text after it: `{}` (the next positional
+/// argument, while there is one) unless `explicit`, else `{index}` or `{key_index}`.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Hole {
+    explicit: bool,
+    index: usize,
+    text: String,
+}
+
+/// A curly format string of one to six placeholders over one to five values, positional or
+/// (three times in ten) named under distinct keys.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct CurlyCall {
+    values: Vec<Val>,
+    keys: Option<Vec<String>>,
+    lead: String,
+    holes: Vec<Hole>,
+}
+
+impl CurlyCall {
+    /// The format string and, from the three documented rules, what it must print.
+    fn render(&self) -> (String, String) {
+        let mut fmt = self.lead.clone();
+        let mut want = fmt.clone();
+        let mut auto = 0;
+        for hole in &self.holes {
+            let index = match &self.keys {
+                Some(keys) => {
+                    fmt.push_str(&format!("{{{}}}", keys[hole.index]));
+                    hole.index
+                }
+                None if !hole.explicit && auto < self.values.len() => {
+                    fmt.push_str("{}");
+                    auto += 1;
+                    auto - 1
+                }
+                None => {
+                    fmt.push_str(&format!("{{{}}}", hole.index));
+                    hole.index
+                }
+            };
+            want.push_str(&self.values[index].display());
+            fmt.push_str(&hole.text);
+            want.push_str(&hole.text);
+        }
+        (fmt, want)
+    }
+}
+
+#[hegel::composite]
+fn curly_call(tc: &TestCase) -> CurlyCall {
+    let named = tc.draw(generators::weighted_booleans(0.3));
+    let values = tc.draw(
+        generators::vecs(hegel::one_of!(int().map(Val::Int), string().map(Val::Str)))
+            .min_size(1)
+            .max_size(5),
+    );
+    let count = values.len();
+    // TEXT has no braces, so the text between placeholders is plain text.
+    let lead = tc.draw(text(5));
+    let holes = if named {
+        tc.draw(
+            generators::vecs(hegel::tuples!(index(count), text(5)))
+                .min_size(1)
+                .max_size(6),
+        )
+        .into_iter()
+        .map(|(index, text)| Hole {
+            explicit: true,
+            index,
+            text,
+        })
+        .collect()
+    } else {
+        tc.draw(
+            generators::vecs(
+                hegel::tuples!(generators::booleans(), index(count), text(5)).map(
+                    |(explicit, index, text)| Hole {
+                        explicit,
+                        index,
+                        text,
+                    },
+                ),
+            )
+            .min_size(1)
+            .max_size(6),
+        )
+    };
+    let keys = if named {
+        Some(tc.draw(distinct_keys(count)))
+    } else {
+        None
+    };
+    CurlyCall {
+        values,
+        keys,
+        lead,
+        holes,
+    }
+}
+
+/// `SimpleCurlyFormat`: `{}` is the next positional argument, `{0}` the argument at that index,
+/// `{name}` the named one; each argument is formatted in display mode; the auto counter goes
+/// on after an explicit index.
+#[hegel::test]
+fn curly_format_follows_its_contract(tc: TestCase) {
+    let call = tc.draw(curly_call());
+    let (fmt, want) = call.render();
+    match &call.keys {
+        Some(keys) => {
+            let map: HashMap<String, Val> = keys
+                .iter()
+                .cloned()
+                .zip(call.values.iter().cloned())
+                .collect();
+            assert_eq!(
+                SimpleCurlyFormat.format(&fmt, &map).unwrap(),
+                want,
+                "{:?}",
+                fmt
+            );
+        }
+        None => assert_eq!(
+            SimpleCurlyFormat.format(&fmt, &call.values).unwrap(),
+            want,
+            "{:?}",
+            fmt
+        ),
+    }
+}
+
+/// The rustdoc examples of both formats.
+#[test]
+fn doc_examples() {
+    assert_eq!(
+        PythonFormat.format("hello, %s", &["world"]).unwrap(),
+        "hello, world"
+    );
+    assert_eq!(
+        SimpleCurlyFormat.format("hello, {}", &["world"]).unwrap(),
+        "hello, world"
+    );
+    assert_eq!(
+        PythonFormat.format("hello, %#x!", &[42]).unwrap(),
+        "hello, 0x2a!"
+    );
+    let mut buffer = Vec::new();
+    dynfmt::NoopFormat
+        .format_into(&mut buffer, "hello, world", &["unused"])
+        .unwrap();
+    assert_eq!(b"hello, world", buffer.as_slice());
+}
+
+// ---------------------------------------------------------------- pinned bugs
+
+/// The `-`, `0` and `+` flags, each present two times in five.
+fn width_flags() -> impl hegel::PrintableGenerator<String> {
+    hegel::tuples!(
+        generators::weighted_booleans(0.4),
+        generators::weighted_booleans(0.4),
+        generators::weighted_booleans(0.4)
+    )
+    .map(|(left, zero, plus)| {
+        ["-", "0", "+"]
+            .into_iter()
+            .zip([left, zero, plus])
+            .filter_map(|(flag, on)| on.then_some(flag))
+            .collect()
+    })
+}
+
+/// dynfmt/1: the minimum field width and the `-`, `0` and `+` flags are parsed into the
+/// `ArgumentSpec` and never applied: `%5d` of 3 is `3`, `%-5s`, `%05d`, `%+d` likewise.
+#[hegel::test]
+fn width_and_flags_are_applied(tc: TestCase) {
+    let (ty, val) = tc.draw(hegel::one_of!(
+        conv("d", ints(-999, 999).map(Val::Int)),
+        conv("s", text(4).map(Val::Str)),
+        conv("x", ints(0, 9999).map(Val::Int)),
+        conv("o", ints(0, 9999).map(Val::Int)),
+    ));
+    let flags = tc.draw(width_flags());
+    let width = tc.draw(ints(1, 12));
+    let fmt = format!("%{flags}{width}{ty}");
+    same_as_python(&fmt, &Args::List(vec![val]));
+}
+
+const FLOAT_WIDTHS: &[&str] = &["", "", "+", "-9", "012"];
+const FLOAT_CONVS: &[&str] = &["f", "F", "g", "G"];
+const FLOATS: &[f64] = &[1.0, 0.5, -2.25, 1e20, 1e-7, 123456789.0, 0.1 + 0.2];
+
+/// A spec with a precision and its value: `%.Nd`, `%.Ns`, `%[width].Nf`, or a bare float
+/// conversion.
+fn precise_call() -> impl hegel::PrintableGenerator<(String, Val)> {
+    hegel::one_of!(
+        hegel::tuples!(ints(0, 8), ints(-999, 9999)).map(|(p, v)| (format!("%.{p}d"), Val::Int(v))),
+        hegel::tuples!(ints(0, 6), text(8)).map(|(p, s)| (format!("%.{p}s"), Val::Str(s))),
+        hegel::tuples!(sampled(FLOAT_WIDTHS), ints(0, 6), ints(-99999, 99999))
+            .map(|(w, p, v)| (format!("%{w}.{p}f"), Val::Float(v as f64 / 100.0))),
+        hegel::tuples!(sampled(FLOAT_CONVS), generators::sampled_from(FLOATS))
+            .map(|(c, x)| (format!("%{c}"), Val::Float(x))),
+    )
+}
+
+/// dynfmt/2: the precision is parsed and never applied — `%.3d` of 5 is `5` (Python `005`),
+/// `%.2s` of `hello` is `hello`, `%.2f` of 3.14159 is `3.14159`; and the float conversions
+/// have no default precision either: `%f` of 1.0 is `1` (Python `1.000000`), `%g` of 1e20 is
+/// the 21-digit integer (Python `1e+20`).
+#[hegel::test]
+fn precision_is_applied(tc: TestCase) {
+    let (fmt, val) = tc.draw(precise_call());
+    same_as_python(&fmt, &Args::List(vec![val]));
+}
+
+/// dynfmt/3: `*` as width or precision must take the size from the next argument and format
+/// the one after it; dynfmt ignores the size and formats the size argument itself — `%*d`
+/// with (5, 42) is `5`, and every later argument is shifted by one.
+#[hegel::test]
+fn star_consumes_an_argument(tc: TestCase) {
+    let (fmt, args) = tc.draw(hegel::one_of!(
+        hegel::tuples!(ints(0, 9), int())
+            .map(|(w, v)| ("%*d|%d", vec![Val::Int(w), Val::Int(v), Val::Int(7)])),
+        hegel::tuples!(ints(0, 9), text(8)).map(|(w, s)| (
+            "%.*s|%s",
+            vec![Val::Int(w), Val::Str(s), Val::Str("end".into())]
+        )),
+    ));
+    same_as_python(fmt, &Args::List(args));
+}
+
+/// What follows the conversion in the dynfmt/4 shape: a character that is not a dot ...
+const SEPARATORS: &[&str] = &["d", "x", "s", "a", "z", "_", "-", "#", "*"];
+/// ... then a size, then this.
+const TAILS: &[&str] = &["d", "s", "%%"];
+const PERCENT_TAILS: &[&str] = &["d", "s"];
+
+/// A width or precision: up to two digits, or `*` one time in five.
+fn size() -> impl hegel::PrintableGenerator<String> {
+    let digits = || ints(0, 99).map(|n| n.to_string());
+    hegel::one_of!(
+        digits(),
+        digits(),
+        digits(),
+        digits(),
+        generators::just("*".to_string()),
+    )
+}
+
+/// `%<ty><sep><size><tail>`: one spec for Python, the rest is text (`%d` + `d5d`).
+fn dotless(
+    ty: &'static str,
+    value: impl hegel::PrintableGenerator<Val>,
+) -> impl hegel::PrintableGenerator<(String, Val)> {
+    hegel::tuples!(value, sampled(SEPARATORS), size(), sampled(TAILS))
+        .map(move |(v, sep, size, tail)| (format!("%{ty}{sep}{size}{tail}"), v))
+}
+
+/// dynfmt/4: the precision is matched by `.(?P<precision>\*|\d+)` with an unescaped `.`, so any
+/// character followed by digits and a conversion is swallowed into the spec: `%d5d` of 3 is
+/// `3` where Python prints `35d`, `%5x3d` of 255 is `255` where Python prints `   ff3d`, and
+/// `%%0%%` is `%%` where Python prints `%0%` (`%%5d` even consumes an argument).
+#[hegel::test]
+fn precision_needs_a_dot(tc: TestCase) {
+    let (fmt, v) = tc.draw(hegel::one_of!(
+        dotless("d", ints(0, 999).map(Val::Int)),
+        dotless("s", text(3).map(Val::Str)),
+        dotless("x", ints(0, 999).map(Val::Int)),
+        // `%%` + `%5d`: two specs for Python
+        hegel::tuples!(ints(0, 999), ints(0, 99), sampled(PERCENT_TAILS))
+            .map(|(v, size, tail)| (format!("%%%{size}{tail}"), Val::Int(v))),
+    ));
+    same_as_python(&fmt, &Args::List(vec![v]));
+}
+
+const BEFORE_SPACE: &[&str] = &["", "-", "#"];
+const AFTER_SPACE: &[&str] = &["", "5", "+"];
+
+/// dynfmt/5: the space flag is not recognised — in the `(?x)` regex the space in `[\#0\- +]`
+/// is insignificant whitespace — so `% d` does not parse as a spec at all and is printed
+/// literally: `% d` of 3 is `% d` (Python ` 3`).
+#[hegel::test]
+fn space_flag_is_recognised(tc: TestCase) {
+    let before = tc.draw(sampled(BEFORE_SPACE));
+    let after = tc.draw(sampled(AFTER_SPACE));
+    let v = tc.draw(ints(-99, 999));
+    let fmt = format!("%{before} {after}d");
+    same_as_python(&fmt, &Args::List(vec![Val::Int(v)]));
+}
+
+const ALTERNATE: &[&str] = &["", "#"];
+const RADIX_CONVS: &[&str] = &["x", "o"];
+
+/// dynfmt/6: `%x`, `%X` and `%o` of a negative integer print Rust's two's complement of the
+/// concrete integer type (`ffffffffffffff01` for -255i64) where Python prints `-ff`.
+#[hegel::test]
+fn negative_radix_forms_have_a_sign(tc: TestCase) {
+    let alternate = tc.draw(sampled(ALTERNATE));
+    let ty = tc.draw(sampled(RADIX_CONVS));
+    let v = tc.draw(ints(i64::MIN, -1));
+    let fmt = format!("%{alternate}{ty}");
+    same_as_python(&fmt, &Args::List(vec![Val::Int(v)]));
+}
+
+/// dynfmt/7: `%c` of an integer prints the number, not the character with that code point.
+#[hegel::test]
+fn char_conversion_of_an_integer(tc: TestCase) {
+    // printable ASCII seven times in ten, a code point beyond Latin-1 controls otherwise
+    let code = tc.draw(either(0.3, ints(160, 0xD7FF), ints(32, 126)));
+    same_as_python("%c", &Args::List(vec![Val::Int(code)]));
+}
+
+const INT_CONVS: &[&str] = &["d", "i", "u", "x"];
+const DECIMAL_CONVS: &[&str] = &["d", "i", "u"];
+
+/// dynfmt/8: `%d`/`%i`/`%u` print any argument's `Display`: a float keeps its fraction (`%d` of
+/// 3.7 is `3.7`, Python `3`), a string is printed as it is where Python raises `TypeError`.
+#[hegel::test]
+fn integer_conversions_take_integers(tc: TestCase) {
+    // a float under the decimal forms only: both sides refuse a float for `%x`
+    let (ty, val) = tc.draw(hegel::one_of!(
+        hegel::tuples!(
+            sampled(DECIMAL_CONVS),
+            ints(-9999, 9999).map(|n| Val::Float(n as f64 / 10.0))
+        ),
+        hegel::tuples!(sampled(INT_CONVS), text(4).map(Val::Str)),
+    ));
+    same_as_python(&format!("%{}", ty), &Args::List(vec![val]));
+}
+
+const UNKNOWN_CONVS: &[char] = &['z', 'q', 'y', 'é', 'D', 'S', '!'];
+const INCOMPLETE_SPECS: &[&str] = &["5.", ".", "-."];
+
+/// dynfmt/9: an unknown conversion character or an incomplete spec (`%z`, a trailing `%`) is
+/// copied to the output as text; Python raises `ValueError`, and the crate's own
+/// `Error::BadFormat` is never produced.
+#[hegel::test]
+fn unknown_conversions_are_errors(tc: TestCase) {
+    let fmt = tc.draw(hegel::one_of!(
+        generators::sampled_from(UNKNOWN_CONVS).map(|c| format!("%{c}")),
+        text(4).map(|t| format!("{t}%")),
+        sampled(INCOMPLETE_SPECS).map(|p| format!("%{p}%s")),
+    ));
+    same_as_python(&fmt, &Args::List(vec![Val::Int(1)]));
+}
+
+/// dynfmt/10: `%#X` prints the prefix in lower case, `0xFF`; Python (and C) print `0XFF`.
+#[hegel::test]
+fn alternate_upper_hex_prefix_is_upper(tc: TestCase) {
+    let v = tc.draw(ints(0, i64::MAX));
+    same_as_python("%#X", &Args::List(vec![Val::Int(v)]));
+}
