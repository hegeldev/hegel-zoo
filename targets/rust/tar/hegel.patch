+// ===========================================================================
+// Property-based tests (hegel) for Header field encoding/decoding.
+// ===========================================================================
+
+use crate::hegel_props::draw_rel_path;
+use hegel::generators;
+
+/// Draw one of the three header flavors this crate can construct.
+fn draw_header(tc: &hegel::TestCase) -> Header {
+    match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => Header::new_gnu(),
+        1 => Header::new_ustar(),
+        _ => Header::new_old(),
+    }
+}
+
+/// Draw a u64 with the octal/base-256 encoding boundaries boosted: 2^21 and
+/// 2^33 are where `num_field_wrapper_into` switches representations for
+/// 8- and 12-byte fields respectively.
+fn draw_boundary_boosted_u64(tc: &hegel::TestCase) -> u64 {
+    tc.draw(hegel::one_of!(
+        generators::integers::<u64>(),
+        generators::sampled_from(vec![
+            0,
+            1,
+            0o7777777,          // 2^21 - 1: largest 7-digit octal (8-byte field)
+            0o7777777 + 1,      // first value forcing base-256 in 8-byte fields
+            0o77777777777,      // 2^33 - 1: largest 11-digit octal (12-byte field)
+            0o77777777777 + 1,  // first value forcing base-256 in 12-byte fields
+            i64::MAX as u64,
+            u64::MAX,
+        ]),
+    ))
+}
+
+/// size and mtime (12-byte numeric fields) round-trip over the full u64
+/// range, across the octal/base-256 representation boundary.
+#[hegel::test]
+fn prop_header_size_mtime_roundtrip(tc: hegel::TestCase) {
+    let mut h = draw_header(&tc);
+    let size = draw_boundary_boosted_u64(&tc);
+    let mtime = draw_boundary_boosted_u64(&tc);
+    h.set_size(size);
+    h.set_mtime(mtime);
+    assert_eq!(h.entry_size().unwrap(), size);
+    assert_eq!(h.mtime().unwrap(), mtime);
+}
+
+/// uid and gid (8-byte numeric fields) round-trip for all values that fit in
+/// 63 bits. Values with bit 63 set are excluded: the base-256 marker bit
+/// collides with the data (see the pinned known failure below).
+#[hegel::test]
+fn prop_header_uid_gid_roundtrip(tc: hegel::TestCase) {
+    let mut h = draw_header(&tc);
+    let uid = draw_boundary_boosted_u64(&tc) & (i64::MAX as u64);
+    let gid = draw_boundary_boosted_u64(&tc) & (i64::MAX as u64);
+    h.set_uid(uid);
+    h.set_gid(gid);
+    assert_eq!(h.uid().unwrap(), uid);
+    assert_eq!(h.gid().unwrap(), gid);
+}
+
+/// KNOWN FAILURE: `set_uid` silently corrupts values >= 2^63.
+///
+/// An 8-byte base-256 numeric field stores the extension marker in bit 63 of
+/// the field, which is also bit 63 of the value: `numeric_extended_into`
+/// does `dst[0] |= 0x80`, so `set_uid(u64::MAX ^ (1 << 63))` and
+/// `set_uid(u64::MAX)` produce identical bytes and `uid()` returns the
+/// bit-63-set reading for both. There is no error; the value is silently
+/// changed. `set_gid` shares the code path. The generator pins the failing
+/// region deterministically.
+#[hegel::test]
+fn prop_header_uid_roundtrip_full_range(tc: hegel::TestCase) {
+    let mut h = draw_header(&tc);
+    let uid = tc.draw(
+        generators::integers::<u64>().min_value(1 << 63),
+    );
+    h.set_uid(uid);
+    assert_eq!(h.uid().unwrap(), uid);
+}
+
+/// mode round-trips for values up to 7 octal digits (the field is 8 bytes of
+/// octal text; larger values are a pinned known failure below).
+#[hegel::test]
+fn prop_header_mode_roundtrip(tc: hegel::TestCase) {
+    let mut h = draw_header(&tc);
+    let mode = tc.draw(generators::integers::<u32>().max_value(0o7777777));
+    h.set_mode(mode);
+    assert_eq!(h.mode().unwrap(), mode);
+}
+
+/// KNOWN FAILURE: `set_mode` silently truncates values >= 2^21 (0o10000000).
+///
+/// The mode field is 8 bytes of octal text (7 digits + NUL). `octal_into`
+/// zips the digits against the field and silently drops the most significant
+/// digits that do not fit, so e.g. `set_mode(0o10000000)` stores 0 and
+/// `mode()` returns 0 with no error. Unlike uid/gid/size/mtime, `set_mode`
+/// never falls back to the base-256 extension. `set_device_major` and
+/// `set_device_minor` (also 8-byte octal, u32-valued) share this defect.
+/// The generator pins the failing region deterministically.
+#[hegel::test]
+fn prop_header_mode_roundtrip_full_range(tc: hegel::TestCase) {
+    let mut h = draw_header(&tc);
+    let mode = tc.draw(generators::integers::<u32>().min_value(0o7777777 + 1));
+    h.set_mode(mode);
+    assert_eq!(h.mode().unwrap(), mode);
+}
+
+/// If `set_path` accepts a path, `path_bytes` returns exactly the same
+/// bytes — for all three header flavors, including the ustar prefix/name
+/// split for paths over 100 bytes.
+#[hegel::test]
+fn prop_header_set_path_roundtrip(tc: hegel::TestCase) {
+    let mut h = draw_header(&tc);
+    let path = draw_rel_path(&tc, true);
+    match h.set_path(&path) {
+        Ok(()) => assert_eq!(h.path_bytes().as_ref(), path.as_bytes()),
+        Err(_) => {
+            // Too long for this header flavor. Anything that fits in the
+            // plain name field must be accepted, so an error there would
+            // mean the property fails vacuously.
+            assert!(path.len() > 100, "short path {:?} rejected", path);
+        }
+    }
+}
+
+/// `set_path` rejects absolute paths and any path containing a `..`
+/// component, for every header flavor.
+#[hegel::test]
+fn prop_header_set_path_rejects_traversal(tc: hegel::TestCase) {
+    let mut h = draw_header(&tc);
+    let a = draw_rel_path(&tc, false);
+    let b = draw_rel_path(&tc, false);
+    let evil = match tc.draw(generators::integers::<u8>().max_value(3)) {
+        0 => format!("../{}", a),
+        1 => format!("/{}", a),
+        2 => format!("{}/../{}", a, b),
+        _ => format!("{}/..", a),
+    };
+    assert!(
+        h.set_path(&evil).is_err(),
+        "unsafe path accepted: {:?}",
+        evil
+    );
+}
+
+/// `set_cksum` writes the checksum the tar spec defines: the unsigned sum of
+/// all 512 header bytes with the checksum field counted as eight spaces.
+#[hegel::test]
+fn prop_header_set_cksum_matches_spec(tc: hegel::TestCase) {
+    let mut h = draw_header(&tc);
+    h.set_size(draw_boundary_boosted_u64(&tc));
+    h.set_mtime(draw_boundary_boosted_u64(&tc));
+    h.set_uid(draw_boundary_boosted_u64(&tc) & (i64::MAX as u64));
+    h.set_gid(draw_boundary_boosted_u64(&tc) & (i64::MAX as u64));
+    h.set_mode(tc.draw(generators::integers::<u32>().max_value(0o7777777)));
+    h.set_entry_type(tar::EntryType::new(tc.draw(generators::integers::<u8>())));
+    let path = draw_rel_path(&tc, false);
+    if path.len() <= 100 {
+        let _ = h.set_path(&path);
+    }
+    h.set_cksum();
+
+    let bytes = h.as_bytes();
+    let spec_sum: u32 = bytes[..148]
+        .iter()
+        .chain(&bytes[156..])
+        .map(|&b| b as u32)
+        .sum::<u32>()
+        + 8 * b' ' as u32;
+    assert_eq!(h.cksum().unwrap(), spec_sum);
+}
