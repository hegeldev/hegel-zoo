diff --git a/tests/connected-components.rs b/tests/connected-components.rs
index d230b02..5e7a997 100644
--- a/tests/connected-components.rs
+++ b/tests/connected-components.rs
@@ -155,3 +155,65 @@ fn larger_separate_components() {
     out_groups.sort_by_key(|c| c[0]);
     assert_eq!(out_groups, components);
 }
+
+// Property-based tests (hegel).
+mod hegel_props {
+    use hegel::generators;
+    use pathfinding::undirected::connected_components::components;
+    use std::collections::{BTreeSet, HashMap};
+
+    fn root(parent: &mut HashMap<u8, u8>, x: u8) -> u8 {
+        let p = *parent.entry(x).or_insert(x);
+        if p == x {
+            x
+        } else {
+            let r = root(parent, p);
+            parent.insert(x, r);
+            r
+        }
+    }
+
+    // Property: `components` merges the input groups into exactly the same
+    // partition as a hand-written union-find oracle.
+    #[hegel::test]
+    fn components_agree_with_union_find(tc: hegel::TestCase) {
+        // Mix a tiny value range (frequent collisions between groups, so
+        // merging actually happens) with the full u8 range.
+        let groups: Vec<Vec<u8>> = tc.draw(
+            generators::vecs(
+                generators::vecs(hegel::one_of!(
+                    generators::integers::<u8>().max_value(7),
+                    generators::integers::<u8>(),
+                ))
+                .max_size(6),
+            )
+            .max_size(8),
+        );
+
+        let result = components(&groups);
+
+        // Union-find oracle: union all elements of each group.
+        let mut parent: HashMap<u8, u8> = HashMap::new();
+        for group in &groups {
+            if let Some((&first, rest)) = group.split_first() {
+                for &x in rest {
+                    let (a, b) = (root(&mut parent, first), root(&mut parent, x));
+                    if a != b {
+                        parent.insert(a, b);
+                    }
+                }
+            }
+        }
+        let mut expected_sets: HashMap<u8, BTreeSet<u8>> = HashMap::new();
+        for x in groups.iter().flatten().copied().collect::<BTreeSet<u8>>() {
+            let r = root(&mut parent, x);
+            expected_sets.entry(r).or_default().insert(x);
+        }
+        let expected: BTreeSet<BTreeSet<u8>> = expected_sets.into_values().collect();
+        let actual: BTreeSet<BTreeSet<u8>> = result
+            .into_iter()
+            .map(|set| set.into_iter().collect())
+            .collect();
+        assert_eq!(actual, expected);
+    }
+}
diff --git a/tests/kuhn_munkres.rs b/tests/kuhn_munkres.rs
index e5ee273..50720e1 100644
--- a/tests/kuhn_munkres.rs
+++ b/tests/kuhn_munkres.rs
@@ -87,7 +87,7 @@ fn non_square() {
 fn empty() {
     let (total, assignments) = kuhn_munkres(&Matrix::<i32>::new_empty(0));
     assert_eq!(total, 0);
-    assert_eq!(assignments, vec![]);
+    assert!(assignments.is_empty());
 }
 
 #[test]
@@ -95,3 +95,76 @@ fn empty() {
 fn unbalanced() {
     kuhn_munkres(&Matrix::new(3, 2, 0));
 }
+
+// Property-based tests (hegel).
+mod hegel_props {
+    use hegel::generators;
+    use itertools::Itertools;
+    use pathfinding::kuhn_munkres::{kuhn_munkres, kuhn_munkres_min};
+    use pathfinding::matrix::Matrix;
+
+    /// Generate a rows x columns weight matrix with rows <= columns (a
+    /// documented requirement). Weights are bounded so that assignment sums
+    /// cannot overflow: overflow is documented to panic and is outside the
+    /// tested domain.
+    #[hegel::composite]
+    fn weight_rows(tc: &hegel::TestCase) -> Vec<Vec<i32>> {
+        let rows = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+        let columns = tc.draw(generators::integers::<usize>().min_value(rows).max_value(5));
+        let mut data = Vec::with_capacity(rows);
+        for _ in 0..rows {
+            data.push(tc.draw(
+                generators::vecs(
+                    generators::integers::<i32>()
+                        .min_value(-1_000_000)
+                        .max_value(1_000_000),
+                )
+                .min_size(columns)
+                .max_size(columns),
+            ));
+        }
+        data
+    }
+
+    fn check_assignment(m: &Matrix<i32>, total: i32, assignment: &[usize]) {
+        assert_eq!(assignment.len(), m.rows, "one column per row");
+        let mut seen = vec![false; m.columns];
+        let mut sum = 0i32;
+        for (r, &c) in assignment.iter().enumerate() {
+            assert!(c < m.columns, "column index out of range");
+            assert!(!seen[c], "column {c} assigned twice");
+            seen[c] = true;
+            sum += m[(r, c)];
+        }
+        assert_eq!(
+            sum, total,
+            "the assignment weights must add up to the returned total"
+        );
+    }
+
+    fn all_assignment_totals(m: &Matrix<i32>) -> impl Iterator<Item = i32> {
+        (0..m.columns)
+            .permutations(m.rows)
+            .map(|cols| cols.iter().enumerate().map(|(r, &c)| m[(r, c)]).sum())
+    }
+
+    // Property: kuhn_munkres returns a valid assignment whose total equals
+    // the brute-force maximum over all assignments.
+    #[hegel::test]
+    fn kuhn_munkres_matches_brute_force_maximum(tc: hegel::TestCase) {
+        let m = Matrix::from_rows(tc.draw(weight_rows())).unwrap();
+        let (total, assignment) = kuhn_munkres(&m);
+        check_assignment(&m, total, &assignment);
+        assert_eq!(total, all_assignment_totals(&m).max().unwrap());
+    }
+
+    // Property: kuhn_munkres_min returns a valid assignment whose total
+    // equals the brute-force minimum over all assignments.
+    #[hegel::test]
+    fn kuhn_munkres_min_matches_brute_force_minimum(tc: hegel::TestCase) {
+        let m = Matrix::from_rows(tc.draw(weight_rows())).unwrap();
+        let (total, assignment) = kuhn_munkres_min(&m);
+        check_assignment(&m, total, &assignment);
+        assert_eq!(total, all_assignment_totals(&m).min().unwrap());
+    }
+}
diff --git a/tests/pathfinding.rs b/tests/pathfinding.rs
index e76f391..203c101 100644
--- a/tests/pathfinding.rs
+++ b/tests/pathfinding.rs
@@ -521,3 +521,253 @@ mod ex2 {
         );
     }
 }
+
+// Property-based tests (hegel) cross-validating the shortest-path algorithms
+// against each other and against hand-written oracles on small random
+// weighted directed graphs.
+mod hegel_props {
+    use hegel::generators;
+    use pathfinding::prelude::*;
+
+    /// Directed graph as adjacency lists: `adj[u]` contains `(v, cost)` edges
+    /// (duplicate edges allowed). Costs are non-negative, as required by
+    /// `dijkstra`/`astar`/`fringe`/`idastar`.
+    type Graph = Vec<Vec<(usize, u64)>>;
+
+    /// Generate a small random weighted directed graph. Weights mix tiny
+    /// values (producing ties and zero-cost edges) with values up to
+    /// `max_weight`.
+    #[hegel::composite]
+    fn weighted_graph(tc: &hegel::TestCase, max_nodes: usize, max_weight: u64) -> Graph {
+        let n = tc.draw(
+            generators::integers::<usize>()
+                .min_value(1)
+                .max_value(max_nodes),
+        );
+        let mut adj = Vec::with_capacity(n);
+        for _ in 0..n {
+            let edges: Vec<(usize, u64)> = tc.draw(
+                generators::vecs(generators::tuples!(
+                    generators::integers::<usize>().max_value(n - 1),
+                    hegel::one_of!(
+                        generators::integers::<u64>().max_value(3),
+                        generators::integers::<u64>().max_value(max_weight),
+                    ),
+                ))
+                .max_size(2 * n),
+            );
+            adj.push(edges);
+        }
+        adj
+    }
+
+    fn draw_endpoints(tc: &hegel::TestCase, n: usize) -> (usize, usize) {
+        let start = tc.draw(generators::integers::<usize>().max_value(n - 1));
+        let goal = tc.draw(generators::integers::<usize>().max_value(n - 1));
+        (start, goal)
+    }
+
+    /// Bellman-Ford-style relaxation: the independent shortest-distance
+    /// oracle. Returns `None` for unreachable nodes.
+    fn oracle_dists(adj: &Graph, start: usize) -> Vec<Option<u64>> {
+        let n = adj.len();
+        let mut dist = vec![None; n];
+        dist[start] = Some(0);
+        for _ in 0..n {
+            let mut changed = false;
+            for u in 0..n {
+                if let Some(du) = dist[u] {
+                    for &(v, w) in &adj[u] {
+                        let nd = du + w;
+                        if dist[v].is_none_or(|dv| nd < dv) {
+                            dist[v] = Some(nd);
+                            changed = true;
+                        }
+                    }
+                }
+            }
+            if !changed {
+                break;
+            }
+        }
+        dist
+    }
+
+    // Property: dijkstra, astar (with the always-admissible zero heuristic)
+    // and fringe must all return the optimal cost computed by an independent
+    // Bellman-Ford oracle, and must all return `None` exactly when the goal
+    // is unreachable.
+    #[hegel::test]
+    fn dijkstra_astar_fringe_agree_with_bellman_ford_oracle(tc: hegel::TestCase) {
+        let adj = tc.draw(weighted_graph(10, u64::from(u32::MAX)));
+        let (start, goal) = draw_endpoints(&tc, adj.len());
+        let successors = |u: &usize| adj[*u].clone();
+        let expected = oracle_dists(&adj, start)[goal];
+        assert_eq!(
+            dijkstra(&start, successors, |&u| u == goal).map(|(_, c)| c),
+            expected,
+            "dijkstra disagrees with the oracle"
+        );
+        assert_eq!(
+            astar(&start, successors, |_| 0, |&u| u == goal).map(|(_, c)| c),
+            expected,
+            "astar disagrees with the oracle"
+        );
+        assert_eq!(
+            fringe(&start, successors, |_| 0, |&u| u == goal).map(|(_, c)| c),
+            expected,
+            "fringe disagrees with the oracle"
+        );
+    }
+
+    // Property: idastar returns the same optimal cost as dijkstra (including
+    // agreeing on unreachability). IDA* re-explores simple paths once per
+    // cost bound, which is exponential on dense cyclic graphs with many
+    // distinct path costs, so the node count and weight range here bound the
+    // *test's* runtime; they are not a contract limit of the library.
+    #[hegel::test]
+    fn idastar_agrees_with_dijkstra(tc: hegel::TestCase) {
+        let adj = tc.draw(weighted_graph(6, 8));
+        let (start, goal) = draw_endpoints(&tc, adj.len());
+        let successors = |u: &usize| adj[*u].clone();
+        let via_dijkstra = dijkstra(&start, successors, |&u| u == goal).map(|(_, c)| c);
+        let via_idastar = idastar(&start, successors, |_| 0, |&u| u == goal).map(|(_, c)| c);
+        assert_eq!(via_idastar, via_dijkstra);
+    }
+
+    // Property: the path returned by dijkstra is a real witness — it starts
+    // at `start`, ends at `goal`, every consecutive pair is joined by an
+    // edge, and the edge costs add up to the returned cost.
+    #[hegel::test]
+    fn dijkstra_path_is_a_valid_witness(tc: hegel::TestCase) {
+        let adj = tc.draw(weighted_graph(10, u64::from(u32::MAX)));
+        let (start, goal) = draw_endpoints(&tc, adj.len());
+        let successors = |u: &usize| adj[*u].clone();
+        let Some((path, cost)) = dijkstra(&start, successors, |&u| u == goal) else {
+            // Unreachable goals are cross-checked against the oracle in
+            // dijkstra_astar_fringe_agree_with_bellman_ford_oracle.
+            return;
+        };
+        assert_eq!(*path.first().unwrap(), start, "path must start at start");
+        assert_eq!(*path.last().unwrap(), goal, "path must end at goal");
+        let mut total: u64 = 0;
+        for pair in path.windows(2) {
+            let cheapest = adj[pair[0]]
+                .iter()
+                .filter(|&&(v, _)| v == pair[1])
+                .map(|&(_, w)| w)
+                .min()
+                .expect("consecutive path nodes must be joined by an edge");
+            total += cheapest;
+        }
+        assert_eq!(
+            total, cost,
+            "the path's edge costs must add up to the returned cost"
+        );
+    }
+
+    // Property: astar with a *consistent* heuristic (the exact
+    // distance-to-goal, computed on the reversed graph by the oracle) still
+    // returns the optimal cost.
+    #[hegel::test]
+    fn astar_with_consistent_heuristic_finds_optimal_cost(tc: hegel::TestCase) {
+        let adj = tc.draw(weighted_graph(10, u64::from(u32::MAX)));
+        let (start, goal) = draw_endpoints(&tc, adj.len());
+        let mut reversed: Graph = vec![Vec::new(); adj.len()];
+        for (u, edges) in adj.iter().enumerate() {
+            for &(v, w) in edges {
+                reversed[v].push((u, w));
+            }
+        }
+        let to_goal = oracle_dists(&reversed, goal);
+        // Stand-in for "infinity" on nodes that cannot reach the goal: large
+        // enough to dominate any path cost, small enough that `cost + h`
+        // cannot overflow u64 inside astar.
+        const FAR: u64 = 1 << 60;
+        let successors = |u: &usize| adj[*u].clone();
+        let heuristic = |u: &usize| to_goal[*u].unwrap_or(FAR);
+        let expected = oracle_dists(&adj, start)[goal];
+        let result = astar(&start, successors, heuristic, |&u| u == goal).map(|(_, c)| c);
+        assert_eq!(result, expected);
+    }
+
+    /// Hand-written breadth-first search: the hop-count oracle.
+    fn oracle_hops(adj: &Graph, start: usize) -> Vec<Option<usize>> {
+        let mut dist = vec![None; adj.len()];
+        dist[start] = Some(0);
+        let mut queue = std::collections::VecDeque::from([start]);
+        while let Some(u) = queue.pop_front() {
+            let du = dist[u].unwrap();
+            for &(v, _) in &adj[u] {
+                if dist[v].is_none() {
+                    dist[v] = Some(du + 1);
+                    queue.push_back(v);
+                }
+            }
+        }
+        dist
+    }
+
+    // Property: bfs returns a valid path using the minimum number of hops
+    // (checked against a hand-written BFS oracle), and returns `None` exactly
+    // when the goal is unreachable.
+    #[hegel::test]
+    fn bfs_returns_a_valid_minimum_hop_path(tc: hegel::TestCase) {
+        let adj = tc.draw(weighted_graph(10, 1));
+        let (start, goal) = draw_endpoints(&tc, adj.len());
+        let successors = |u: &usize| adj[*u].iter().map(|&(v, _)| v).collect::<Vec<_>>();
+        let hops = oracle_hops(&adj, start)[goal];
+        match bfs(&start, successors, |&u| u == goal) {
+            None => assert_eq!(hops, None, "bfs found no path but the goal is reachable"),
+            Some(path) => {
+                assert_eq!(*path.first().unwrap(), start, "path must start at start");
+                assert_eq!(*path.last().unwrap(), goal, "path must end at goal");
+                for pair in path.windows(2) {
+                    assert!(
+                        adj[pair[0]].iter().any(|&(v, _)| v == pair[1]),
+                        "consecutive path nodes must be joined by an edge"
+                    );
+                }
+                assert_eq!(
+                    Some(path.len() - 1),
+                    hops,
+                    "bfs path must use the fewest possible hops"
+                );
+            }
+        }
+    }
+
+    // Property: dijkstra_all returns exactly the reachable nodes (except
+    // `start`, which is documented as excluded), each with the optimal cost
+    // computed by the oracle, and each parent is joined to its child by a
+    // real edge.
+    #[hegel::test]
+    fn dijkstra_all_matches_oracle_distances(tc: hegel::TestCase) {
+        let adj = tc.draw(weighted_graph(10, u64::from(u32::MAX)));
+        let n = adj.len();
+        let start = tc.draw(generators::integers::<usize>().max_value(n - 1));
+        let successors = |u: &usize| adj[*u].clone();
+        let all = dijkstra_all(&start, successors);
+        let expected = oracle_dists(&adj, start);
+        for v in 0..n {
+            if v == start {
+                assert!(
+                    !all.contains_key(&v),
+                    "start must not be part of the result"
+                );
+                continue;
+            }
+            assert_eq!(
+                all.get(&v).map(|&(_, c)| c),
+                expected[v],
+                "wrong distance (or wrong reachability) for node {v}"
+            );
+        }
+        for (&v, &(p, _)) in &all {
+            assert!(
+                adj[p].iter().any(|&(x, _)| x == v),
+                "parent {p} of node {v} is not joined to it by an edge"
+            );
+        }
+    }
+}
diff --git a/tests/strongly_connected_components.rs b/tests/strongly_connected_components.rs
index 326414e..025f1b7 100644
--- a/tests/strongly_connected_components.rs
+++ b/tests/strongly_connected_components.rs
@@ -137,3 +137,73 @@ fn deep_graph_does_not_exhaust_the_stack() {
         .join()
         .expect("traversal exhausted the stack");
 }
+
+// Property-based tests (hegel).
+mod hegel_props {
+    use hegel::generators;
+    use pathfinding::directed::strongly_connected_components::strongly_connected_components;
+
+    // Property: the strongly connected components form a partition of the
+    // nodes in which two nodes share a component if and only if they are
+    // mutually reachable (oracle: Floyd-Warshall reachability closure).
+    #[hegel::test]
+    fn sccs_partition_nodes_by_mutual_reachability(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+        let edges: Vec<(usize, usize)> = tc.draw(
+            generators::vecs(generators::tuples!(
+                generators::integers::<usize>().max_value(n - 1),
+                generators::integers::<usize>().max_value(n - 1),
+            ))
+            .max_size(3 * n),
+        );
+        let mut adj = vec![Vec::new(); n];
+        for (u, v) in edges {
+            adj[u].push(v);
+        }
+        let nodes: Vec<usize> = (0..n).collect();
+        let sccs = strongly_connected_components(&nodes, |&u| adj[u].clone());
+
+        // Oracle: boolean reachability closure.
+        let mut reach = vec![vec![false; n]; n];
+        for (u, succs) in adj.iter().enumerate() {
+            reach[u][u] = true;
+            for &v in succs {
+                reach[u][v] = true;
+            }
+        }
+        for k in 0..n {
+            for i in 0..n {
+                for j in 0..n {
+                    if reach[i][k] && reach[k][j] {
+                        reach[i][j] = true;
+                    }
+                }
+            }
+        }
+
+        // The result must be a partition of the nodes...
+        let mut component = vec![None; n];
+        for (id, scc) in sccs.iter().enumerate() {
+            assert!(!scc.is_empty(), "empty component returned");
+            for &u in scc {
+                assert!(component[u].is_none(), "node {u} is in two components");
+                component[u] = Some(id);
+            }
+        }
+        assert!(
+            component.iter().all(Option::is_some),
+            "some node is missing from the components"
+        );
+
+        // ...grouping exactly the mutually reachable nodes.
+        for u in 0..n {
+            for v in 0..n {
+                assert_eq!(
+                    component[u] == component[v],
+                    reach[u][v] && reach[v][u],
+                    "wrong grouping for nodes {u} and {v}"
+                );
+            }
+        }
+    }
+}
diff --git a/tests/topological_sort.rs b/tests/topological_sort.rs
index 76acd97..ce8f4f8 100644
--- a/tests/topological_sort.rs
+++ b/tests/topological_sort.rs
@@ -131,3 +131,102 @@ fn deep_graph_does_not_exhaust_the_stack() {
         .join()
         .expect("traversal exhausted the stack");
 }
+
+// Property-based tests (hegel).
+mod hegel_props {
+    use hegel::generators;
+    use pathfinding::directed::topological_sort::topological_sort;
+
+    type Adj = Vec<Vec<usize>>;
+
+    /// Generate a small random directed graph. Half the time the edges are
+    /// oriented along a random permutation, guaranteeing a DAG so that the
+    /// `Ok` branch of the property is exercised reliably; otherwise edges
+    /// (including self-loops) are arbitrary and cycles are common.
+    #[hegel::composite]
+    fn digraph(tc: &hegel::TestCase) -> Adj {
+        let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+        let edges: Vec<(usize, usize)> = tc.draw(
+            generators::vecs(generators::tuples!(
+                generators::integers::<usize>().max_value(n - 1),
+                generators::integers::<usize>().max_value(n - 1),
+            ))
+            .max_size(3 * n),
+        );
+        let force_dag = tc.draw(generators::booleans());
+        let priority: Vec<u32> = if force_dag {
+            tc.draw(
+                generators::vecs(generators::integers::<u32>())
+                    .min_size(n)
+                    .max_size(n)
+                    .unique(true),
+            )
+        } else {
+            Vec::new()
+        };
+        let mut adj = vec![Vec::new(); n];
+        for (u, v) in edges {
+            if force_dag {
+                if priority[u] < priority[v] {
+                    adj[u].push(v);
+                } else if priority[v] < priority[u] {
+                    adj[v].push(u);
+                }
+                // u == v: drop self-loops in the DAG case.
+            } else {
+                adj[u].push(v);
+            }
+        }
+        adj
+    }
+
+    /// Is `node` part of a cycle, i.e. reachable from its own successors?
+    fn on_cycle(adj: &Adj, node: usize) -> bool {
+        let mut seen = vec![false; adj.len()];
+        let mut stack: Vec<usize> = adj[node].clone();
+        while let Some(u) = stack.pop() {
+            if u == node {
+                return true;
+            }
+            if !seen[u] {
+                seen[u] = true;
+                stack.extend(&adj[u]);
+            }
+        }
+        false
+    }
+
+    // Property: on success, topological_sort returns every node exactly once
+    // with every edge going from an earlier to a later position; on failure,
+    // the reported node really lies on a cycle.
+    #[hegel::test]
+    fn topological_sort_orders_edges_or_reports_a_cycle_node(tc: hegel::TestCase) {
+        let adj = tc.draw(digraph());
+        let n = adj.len();
+        let nodes: Vec<usize> = (0..n).collect();
+        match topological_sort(&nodes, |&u| adj[u].clone()) {
+            Ok(order) => {
+                let mut position = vec![None; n];
+                for (i, &u) in order.iter().enumerate() {
+                    assert!(position[u].is_none(), "node {u} appears twice");
+                    position[u] = Some(i);
+                }
+                assert_eq!(order.len(), n, "every node must appear in the order");
+                for (u, succs) in adj.iter().enumerate() {
+                    for &v in succs {
+                        assert!(
+                            position[u].unwrap() < position[v].unwrap(),
+                            "edge {u} -> {v} does not respect the returned order"
+                        );
+                    }
+                }
+            }
+            Err(node) => {
+                assert!(
+                    on_cycle(&adj, node),
+                    "{node} was reported as cyclic but lies on no cycle"
+                );
+            }
+        }
+    }
+}
