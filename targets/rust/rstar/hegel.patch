+/// Checks the structural invariants required for query correctness: every
+/// parent's envelope exactly covers its children, and all leaves sit at the
+/// same depth.
+///
+/// Unlike `ParentNode::sanity_check`, node fill degrees are *not* checked
+/// here: bulk loading (for awkward element counts, e.g. 7 elements with
+/// `MAX_SIZE` 6) and removals (which drop emptied nodes but never rebalance)
+/// legitimately produce nodes with fewer than `MIN_SIZE` children.
+pub fn assert_envelopes_and_leaf_height<T>(root: &crate::node::ParentNode<T>)
+where
+    T: RTreeObject,
+{
+    recurse_structure(root, 1, &mut None, true);
+}
+
+/// Like [assert_envelopes_and_leaf_height], but only checks envelope
+/// consistency.
+///
+/// KNOWN BUG EXCLUSION: bulk loading can produce leaves at different depths
+/// (e.g. for 25 elements with the default parameters), which is pinned by the
+/// failing test `rtree::test::hegel_bulk_load_produces_uniform_leaf_depth`.
+/// Use this check for bulk-loaded trees so other properties stay green.
+pub fn assert_consistent_envelopes<T>(root: &crate::node::ParentNode<T>)
+where
+    T: RTreeObject,
+{
+    recurse_structure(root, 1, &mut None, false);
+}
+
+fn recurse_structure<T: RTreeObject>(
+    node: &crate::node::ParentNode<T>,
+    height: usize,
+    leaf_height: &mut Option<usize>,
+    check_leaf_height: bool,
+) {
+    use crate::node::RTreeNode;
+    use crate::Envelope;
+
+    let mut expected = T::Envelope::new_empty();
+    for child in &node.children {
+        expected.merge(&child.envelope());
+        match child {
+            RTreeNode::Leaf(_) => {
+                if let Some(leaf_height) = *leaf_height {
+                    if check_leaf_height {
+                        assert_eq!(height, leaf_height, "leaves at different depths");
+                    }
+                } else {
+                    *leaf_height = Some(height);
+                }
+            }
+            RTreeNode::Parent(parent) => {
+                recurse_structure(parent, height + 1, leaf_height, check_leaf_height)
+            }
+        }
+    }
+    if !node.children.is_empty() {
+        assert_eq!(
+            node.envelope(),
+            expected,
+            "parent envelope does not match its children"
+        );
+    }
+}
