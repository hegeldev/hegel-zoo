+/// Hegel generator for a single finite `f64` coordinate.
+///
+/// Mixes a small integer grid (which makes duplicate points and exact distance
+/// ties likely), the full finite `f64` range, and exact boundary magnitudes.
+/// NaN and infinity are excluded: the tree orders coordinates via
+/// `partial_cmp(..).unwrap()` (e.g. in bulk loading), so non-finite
+/// coordinates are outside the supported domain.
+#[hegel::composite]
+pub fn coordinates(tc: &hegel::TestCase) -> f64 {
+    tc.draw(hegel::one_of!(
+        generators::integers::<i8>()
+            .min_value(-4)
+            .max_value(4)
+            .map(f64::from),
+        generators::floats::<f64>()
+            .allow_nan(false)
+            .allow_infinity(false),
+        generators::sampled_from(vec![
+            0.0,
+            -0.0,
+            1.0,
+            -1.0,
+            f64::MAX,
+            -f64::MAX,
+            f64::MIN_POSITIVE,
+            1e300,
+            -1e300,
+        ]),
+    ))
+}
+
+/// Hegel generator for a 2D point with [coordinates] components.
+#[hegel::composite]
+pub fn points_2d(tc: &hegel::TestCase) -> [f64; 2] {
+    [tc.draw(coordinates()), tc.draw(coordinates())]
+}
+
+/// Draws a `Vec` of at least `min_len` [points_2d] points. The target length is
+/// drawn separately (up to 300) so that trees grow several levels deep -
+/// hegel's default collection sizes would rarely exceed a single root node.
+#[hegel::composite]
+pub fn point_vecs(tc: &hegel::TestCase, min_len: usize) -> Vec<[f64; 2]> {
+    let n = tc.draw(
+        generators::integers::<usize>()
+            .min_value(min_len)
+            .max_value(300),
+    );
+    tc.draw(generators::vecs(points_2d()).min_size(n))
+}
+
+/// Like [coordinates], but with magnitudes at most `f64::MAX / 2`.
+///
+/// KNOWN BUG EXCLUSION: `RTree::insert` panics when node envelope corners
+/// exceed `f64::MAX / 2` in magnitude - the envelope center computation
+/// `(lower + upper) / 2` overflows to infinity and the reinsertion sort hits
+/// `partial_cmp(..).unwrap()` on NaN. The bug is pinned by the failing test
+/// `rtree::test::hegel_insert_supports_full_finite_coordinate_range`; this
+/// generator excludes that region so properties exercising `insert` can keep
+/// testing everything else.
+#[hegel::composite]
+pub fn insertable_coordinates(tc: &hegel::TestCase) -> f64 {
+    tc.draw(hegel::one_of!(
+        generators::integers::<i8>()
+            .min_value(-4)
+            .max_value(4)
+            .map(f64::from),
+        generators::floats::<f64>()
+            .min_value(-f64::MAX / 2.0)
+            .max_value(f64::MAX / 2.0),
+        generators::sampled_from(vec![
+            0.0,
+            -0.0,
+            1.0,
+            -1.0,
+            f64::MAX / 2.0,
+            -f64::MAX / 2.0,
+            f64::MIN_POSITIVE,
+            1e300,
+            -1e300,
+        ]),
+    ))
+}
+
+/// A 2D point with [insertable_coordinates] components. Use for properties
+/// that call `RTree::insert`; see [insertable_coordinates] for why.
+#[hegel::composite]
+pub fn insertable_points_2d(tc: &hegel::TestCase) -> [f64; 2] {
+    [
+        tc.draw(insertable_coordinates()),
+        tc.draw(insertable_coordinates()),
+    ]
+}
+
+/// Like [point_vecs], but with [insertable_points_2d] elements.
+#[hegel::composite]
+pub fn insertable_point_vecs(tc: &hegel::TestCase, min_len: usize) -> Vec<[f64; 2]> {
+    let n = tc.draw(
+        generators::integers::<usize>()
+            .min_value(min_len)
+            .max_value(300),
+    );
+    tc.draw(generators::vecs(insertable_points_2d()).min_size(n))
+}
+
+/// Sorts points into a canonical order so multisets of points can be compared
+/// with `assert_eq`. Uses `total_cmp`, which is a total order on the finite
+/// values generated by [points_2d].
+pub fn sorted_points(mut points: Vec<[f64; 2]>) -> Vec<[f64; 2]> {
+    points.sort_by(|a, b| a[0].total_cmp(&b[0]).then(a[1].total_cmp(&b[1])));
+    points
+}
