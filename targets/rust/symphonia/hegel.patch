+        assert_eq!(u8::from_sample(i24::from_sample(s)), s);
+        assert_eq!(u8::from_sample(i32::from_sample(s)), s);
+        assert_eq!(u8::from_sample(u16::from_sample(s)), s);
+        assert_eq!(u8::from_sample(u24::from_sample(s)), s);
+        assert_eq!(u8::from_sample(u32::from_sample(s)), s);
+        assert_eq!(u8::from_sample(f32::from_sample(s)), s);
+        assert_eq!(u8::from_sample(f64::from_sample(s)), s);
+
+        let s = tc.draw(generators::integers::<i16>());
+        assert_eq!(i16::from_sample(i24::from_sample(s)), s);
+        assert_eq!(i16::from_sample(i32::from_sample(s)), s);
+        assert_eq!(i16::from_sample(u24::from_sample(s)), s);
+        assert_eq!(i16::from_sample(u32::from_sample(s)), s);
+        assert_eq!(i16::from_sample(f32::from_sample(s)), s);
+        assert_eq!(i16::from_sample(f64::from_sample(s)), s);
+
+        let s = tc.draw(generators::integers::<u16>());
+        assert_eq!(u16::from_sample(i24::from_sample(s)), s);
+        assert_eq!(u16::from_sample(i32::from_sample(s)), s);
+        assert_eq!(u16::from_sample(u24::from_sample(s)), s);
+        assert_eq!(u16::from_sample(u32::from_sample(s)), s);
+        assert_eq!(u16::from_sample(f32::from_sample(s)), s);
+        assert_eq!(u16::from_sample(f64::from_sample(s)), s);
