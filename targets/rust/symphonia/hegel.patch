+
+            let v = tc.draw(generators::integers::<u64>());
+            assert_eq!(contains_ones_byte_u64(v), v.to_le_bytes().contains(&0xff), "{v:#x}");
+
+            // A random value rarely contains an all-ones byte, so also force one in by
+            // construction to exercise the true branch every run.
+            let v = tc.draw(generators::integers::<u16>());
+            let pos = tc.draw(generators::integers::<u32>().max_value(1));
+            assert!(contains_ones_byte_u16(v | (0xffu16 << (8 * pos))));
