+        assert_eq!(i8::from_sample(u16::from_sample(s)), s);
+        assert_eq!(i8::from_sample(u24::from_sample(s)), s);
+        assert_eq!(i8::from_sample(u32::from_sample(s)), s);
+        assert_eq!(i8::from_sample(f32::from_sample(s)), s);
