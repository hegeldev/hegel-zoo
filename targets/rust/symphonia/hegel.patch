+    #[hegel::test]
+    fn hegel_signed_unsigned_same_width_roundtrip(tc: hegel::TestCase) {
+        // At the same width, the signed <-> unsigned (offset-binary) mapping is a bijection.
+        let s = tc.draw(generators::integers::<i8>());
+        assert_eq!(i8::from_sample(u8::from_sample(s)), s);
+        let s = tc.draw(generators::integers::<u8>());
