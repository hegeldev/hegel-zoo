+    #[hegel::test]
+    fn hegel_float_conversion_is_path_independent(tc: hegel::TestCase) {
+        // Converting to float directly and converting via a lossless widening to an intermediate
+        // integer format must produce the exact same float. All the involved conversions are
+        // exact powers-of-two scalings.
