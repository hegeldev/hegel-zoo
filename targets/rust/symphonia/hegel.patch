+    #[hegel::test]
+    fn hegel_widening_roundtrip_is_identity(tc: hegel::TestCase) {
+        // Converting a sample to any strictly wider (lossless) format and back must be the
+        // identity. All the conversions below are exact: integer widths only grow, and the float
+        // formats have enough mantissa bits for the integer format being routed through them.
+        let s = tc.draw(generators::integers::<i8>());
