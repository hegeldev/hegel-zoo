+        #[hegel::test]
+        fn hegel_sign_extend_matches_arithmetic_oracle(tc: hegel::TestCase) {
+            // Sign extending a value holding a width-bit two's complement integer must equal
+            // interpreting the low `width` bits arithmetically. Bits above `width` are ignored.
+            fn oracle(masked: u128, width: u32) -> i128 {
+                if (masked >> (width - 1)) & 1 == 1 {
+                    masked as i128 - (1i128 << width)
+                }
+                else {
+                    masked as i128
+                }
+            }
+
+            let v = tc.draw(generators::integers::<u8>());
+            let w = tc.draw(generators::integers::<u32>().min_value(1).max_value(8));
+            let masked = u128::from(v) & ((1u128 << w) - 1);
+            assert_eq!(i128::from(sign_extend_leq8_to_i8(v, w)), oracle(masked, w));
+
+            let v = tc.draw(generators::integers::<u16>());
+            let w = tc.draw(generators::integers::<u32>().min_value(1).max_value(16));
+            let masked = u128::from(v) & ((1u128 << w) - 1);
+            assert_eq!(i128::from(sign_extend_leq16_to_i16(v, w)), oracle(masked, w));
+
+            let v = tc.draw(generators::integers::<u32>());
+            let w = tc.draw(generators::integers::<u32>().min_value(1).max_value(32));
+            let masked = u128::from(v) & ((1u128 << w) - 1);
+            assert_eq!(i128::from(sign_extend_leq32_to_i32(v, w)), oracle(masked, w));
+
+            let v = tc.draw(generators::integers::<u64>());
+            let w = tc.draw(generators::integers::<u32>().min_value(1).max_value(64));
+            let masked = u128::from(v) & ((1u128 << w) - 1);
+            assert_eq!(i128::from(sign_extend_leq64_to_i64(v, w)), oracle(masked, w));
+        }
+
+        #[hegel::test]
+        fn hegel_masks_match_bit_loop_oracle(tc: hegel::TestCase) {
+            // Every mask function must equal a mask built bit-by-bit from its documented
+            // predicate.
+            fn build(pred: impl Fn(u32) -> bool) -> u8 {
+                (0..8).filter(|&bit| pred(bit)).fold(0u8, |acc, bit| acc | (1 << bit))
+            }
+
+            let idx = tc.draw(generators::integers::<u32>().max_value(7));
+
+            assert_eq!(mask_at(idx), build(|bit| bit == idx));
+            assert_eq!(mask_upper_eq(idx), build(|bit| bit >= idx));
+            assert_eq!(mask_upper(idx), build(|bit| bit > idx));
+            assert_eq!(mask_lower_eq(idx), build(|bit| bit <= idx));
+            assert_eq!(mask_lower(idx), build(|bit| bit < idx));
+
+            // mask_range masks bits in [lower, upper).
+            let a = tc.draw(generators::integers::<u32>().max_value(8));
+            let b = tc.draw(generators::integers::<u32>().max_value(8));
+            let (lower, upper) = if a <= b { (a, b) } else { (b, a) };
+
+            assert_eq!(mask_range(upper, lower), build(|bit| bit >= lower && bit < upper));
+        }
+
+        #[hegel::test]
+        fn hegel_contains_ones_byte_matches_oracle(tc: hegel::TestCase) {
+            // The SWAR trick must agree with simply inspecting each byte.
+            let v = tc.draw(generators::integers::<u16>());
+            assert_eq!(contains_ones_byte_u16(v), v.to_le_bytes().contains(&0xff), "{v:#x}");
