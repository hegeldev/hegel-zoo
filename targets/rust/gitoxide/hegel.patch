+/// Property-based tests (hegel).
+///
+/// The generalized version of the `assert_url_roundtrip()` checks above: instead of a fixed list
+/// of example URLs, generate both arbitrary bytes and structured URL-ish inputs.
+mod properties {
+    use bstr::{BString, ByteSlice};
+    use gix_url::Scheme;
+    use hegel::generators::{self, Generator};
+
+    /// A host that stays within what the serializer writes verbatim (it does not percent-encode hosts).
+    #[hegel::composite]
+    fn host_ish(tc: &hegel::TestCase) -> String {
+        tc.draw(hegel::one_of!(
+            generators::from_regex(r"[a-zA-Z0-9][a-zA-Z0-9.-]{0,20}").fullmatch(true),
+            generators::just("127.0.0.1".to_string()),
+            generators::just("::1".to_string()),
+            generators::just("2606:50c0:8000::153".to_string()),
+        ))
+    }
+
+    /// URL-ish input: arbitrary bytes, canonical `scheme://` URLs, SCP-like targets, and local paths.
+    #[hegel::composite]
+    fn url_ish(tc: &hegel::TestCase) -> Vec<u8> {
+        let structured = |tc: &hegel::TestCase| -> Vec<u8> {
+            let mut out: Vec<u8> = Vec::new();
+            let scheme: String = tc.draw(generators::sampled_from(vec![
+                "ssh".into(),
+                "git".into(),
+                "http".into(),
+                "https".into(),
+                "file".into(),
+                "abc".into(),
+            ]));
+            out.extend_from_slice(scheme.as_bytes());
+            out.extend_from_slice(b"://");
+            if tc.draw(generators::booleans()) {
+                // Deliberately includes valid and invalid percent-escapes to exercise decode/re-encode.
+                let user: String =
+                    tc.draw(generators::from_regex(r"([a-zA-Z0-9._+-]|%[0-9a-fA-F]{2}|%){0,6}").fullmatch(true));
+                out.extend_from_slice(user.as_bytes());
+                if tc.draw(generators::booleans()) {
+                    let pass: String =
+                        tc.draw(generators::from_regex(r"([a-zA-Z0-9._+-]|%[0-9a-fA-F]{2}|%){0,6}").fullmatch(true));
+                    out.push(b':');
+                    out.extend_from_slice(pass.as_bytes());
+                }
+                out.push(b'@');
+            }
+            let host = tc.draw(host_ish());
+            if host.contains(':') {
+                out.push(b'[');
+                out.extend_from_slice(host.as_bytes());
+                out.push(b']');
+            } else {
+                out.extend_from_slice(host.as_bytes());
+            }
+            if tc.draw(generators::booleans()) {
+                let port: u16 = tc.draw(generators::integers::<u16>());
+                out.extend_from_slice(format!(":{port}").as_bytes());
+            }
+            let path: String = tc.draw(generators::from_regex(r"(/[a-zA-Z0-9~._-]{0,8}){0,4}").fullmatch(true));
+            out.extend_from_slice(path.as_bytes());
+            out
+        };
+        let scp_like = |tc: &hegel::TestCase| -> Vec<u8> {
+            let mut out: Vec<u8> = Vec::new();
+            if tc.draw(generators::booleans()) {
+                let user: String = tc.draw(generators::from_regex(r"[a-zA-Z0-9._-]{1,10}").fullmatch(true));
+                out.extend_from_slice(user.as_bytes());
+                out.push(b'@');
+            }
+            let host = tc.draw(host_ish());
+            if host.contains(':') {
+                out.push(b'[');
+                out.extend_from_slice(host.as_bytes());
+                out.push(b']');
+            } else {
+                out.extend_from_slice(host.as_bytes());
+            }
+            out.push(b':');
+            let path: String = tc.draw(generators::from_regex(r"[a-zA-Z0-9~/._-]{0,20}").fullmatch(true));
+            out.extend_from_slice(path.as_bytes());
+            out
+        };
+        match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => tc.draw(generators::binary().max_size(100)),
+            1 => structured(&tc),
+            2 => scp_like(&tc),
+            _ => tc.draw(generators::text().max_size(50)).into_bytes(),
+        }
+    }
+
+    /// Property: `Url::to_bstring()` is documented to serialize "losslessly, ready to be parsed again"
+    /// (see `Url::write_to()`), so any successfully parsed URL must reparse from its own serialization
+    /// to an equal `Url`. This is `assert_url_roundtrip()` generalized over generated inputs.
+    #[hegel::test]
+    fn parsed_urls_roundtrip_through_to_bstring(tc: hegel::TestCase) {
+        let input = tc.draw(url_ish());
+        let Ok(url) = gix_url::parse(input.as_bstr()) else {
+            tc.reject()
+        };
+        // KNOWN BUG exclusion (gitoxide/3): a host containing both `:` and `%` (a file:// host,
+        // which the lenient file-URL parser takes verbatim) is bracketed and `%`-escaped as if it
+        // were an IPv6 address with a zone id, and does not reparse; see
+        // `file_hosts_with_colon_and_percent_roundtrip_through_to_bstring`.
+        tc.assume(!url.host().is_some_and(|host| host.contains(':') && host.contains('%') && !host.starts_with('[')));
+        let serialized: BString = url.to_bstring();
+        let reparsed = gix_url::parse(serialized.as_bstr()).unwrap_or_else(|err| {
+            panic!("serialization {serialized:?} of a parsed URL must be parseable, but failed with: {err}")
+        });
+        assert_eq!(
+            reparsed, url,
+            "reparsing the serialization {serialized:?} must reproduce the original URL"
+        );
+    }
+
+    /// KNOWN FAILURE (gitoxide/3): `Url::write_to()` brackets a host that contains `:` (its IPv6
+    /// heuristic) whenever the URL has a port or the host contains `%`, and rewrites `%` as `%25`
+    /// inside the brackets (IPv6 zone-id support). The file-URL parser keeps the authority verbatim
+    /// as the host, so `file://a%:0/` parses with host `a%:0`, serializes to `file://[a%25:0]/`, and
+    /// reparses with host `[a%25:0]`: `to_bstring()` is not lossless. Introduced between
+    /// 2315ede714da (brackets only with a port) and 19beb949b897. Found by
+    /// `parsed_urls_roundtrip_through_to_bstring` with `file://%00@127.0.0.1:0/`.
+    #[test]
+    fn file_hosts_with_colon_and_percent_roundtrip_through_to_bstring() {
+        for input in ["file://a%:0/", "file://%00@127.0.0.1:0/"] {
+            let url = gix_url::parse(input.as_bytes().as_bstr()).expect("parses today");
+            let serialized: BString = url.to_bstring();
+            let reparsed = gix_url::parse(serialized.as_bstr())
+                .unwrap_or_else(|err| panic!("serialization {serialized:?} of {input:?} must be parseable: {err}"));
+            assert_eq!(
+                reparsed, url,
+                "reparsing the serialization {serialized:?} of {input:?} must reproduce the original URL"
+            );
+        }
+    }
+
+    /// Property: the field docs on `Url` state that `user`, `password` and `path` are stored in decoded
+    /// form and re-encoded during canonical serialization, and `Url::from_parts()` validates by
+    /// parsing the serialized form back. Therefore constructing a URL from valid parts must preserve
+    /// each component (modulo the documented `/~` path normalization for ssh/git).
+    #[hegel::test]
+    fn from_parts_preserves_components(tc: hegel::TestCase) {
+        let scheme: Scheme = tc.draw((generators::sampled_from(vec![
+            Scheme::Http,
+            Scheme::Https,
+            Scheme::Ssh,
+            Scheme::Git,
+        ])).print_as_debug());
+        // Documented storage form: "IPv6 addresses are stored *without* brackets for SSH schemes,
+        // but *with* brackets for other schemes." Supply the documented form as input.
+        let host: String = {
+            let host = tc.draw(host_ish());
+            if host.contains(':') && !matches!(scheme, Scheme::Ssh) {
+                format!("[{host}]")
+            } else {
+                host
+            }
+        };
+        // An empty user (`Some("")`) serializes as `@host` which parses back as "no user" —
+        // a degenerate value outside the intent of "the user to impersonate on the remote".
+        // KNOWN BUG exclusion: users containing `:` are serialized without percent-encoding the
+        // colon and thus reparse as user + password, see `users_with_colons_roundtrip_through_to_bstring`.
+        let user: Option<String> = tc.draw(generators::optional(
+            generators::text()
+                .min_size(1)
+                .max_size(10)
+                .map(|s: String| s.replace(':', "_")),
+        ));
+        // Like an empty user, an empty password (`user:@host`) parses back as "no password".
+        let password: Option<String> = if user.is_some() {
+            tc.draw(generators::optional(generators::text().min_size(1).max_size(10)))
+        } else {
+            None
+        };
+        // Port 0 is explicitly outside the domain: "invalid port number - must be between 1-65535"
+        // (see `invalid::port_zero_is_invalid`).
+        let port: Option<u16> = tc.draw(generators::optional(generators::integers::<u16>().min_value(1)));
+        let path: String = {
+            let tail: String = tc.draw(generators::from_regex(r"[a-zA-Z0-9~/._-]{0,20}").fullmatch(true));
+            format!("/{tail}")
+        };
+
+        let url = gix_url::Url::from_parts(
+            scheme.clone(),
+            user.clone(),
+            password.clone(),
+            Some(host.clone()),
+            port,
+            path.clone().into(),
+            false,
+        )
+        .unwrap_or_else(|err| panic!("valid parts must produce a valid URL, but failed with: {err}"));
+
+        let expected_path: BString = if matches!(scheme, Scheme::Ssh | Scheme::Git) && path.starts_with("/~") {
+            // Documented normalization: ssh/git strip the leading `/` of `/~` paths.
+            path[1..].into()
+        } else {
+            path.clone().into()
+        };
+        assert_eq!(url.scheme, scheme, "scheme must be preserved");
+        assert_eq!(url.user(), user.as_deref(), "user must be preserved");
+        assert_eq!(url.password(), password.as_deref(), "password must be preserved");
+        // Hosts are case-insensitive and normalized to lowercase during parsing.
+        assert_eq!(
+            url.host(),
+            Some(host.to_ascii_lowercase().as_str()),
+            "host must be preserved (modulo lowercase normalization)"
+        );
+        assert_eq!(url.port, port, "port must be preserved");
+        assert_eq!(url.path, expected_path, "path must be preserved");
+    }
+
+    /// Formerly a KNOWN FAILURE (gitoxide/1, fixed upstream: `write_to()` now encodes the user with
+    /// `USERNAME_ENCODE_SET`, which adds `:`): `Url::to_bstring()` was not lossless for users
+    /// containing `:`. `parse("http://a%3Ab@host/")` percent-decodes the user to `a:b` (as documented
+    /// on `Url::user`), but `USERINFO_ENCODE_SET` in `write_canonical_form_to()` (src/lib.rs) did not
+    /// include `:`, so `to_bstring()` yielded `http://a:b@host/` which reparsed as user `a` with password `b`.
+    /// This violates the documented contract of `write_to()`: "Write this URL losslessly to `out`,
+    /// ready to be parsed again". A colon inside the user component must be percent-encoded because
+    /// the first unencoded `:` in userinfo delimits user from password.
+    #[hegel::test]
+    fn users_with_colons_roundtrip_through_to_bstring(tc: hegel::TestCase) {
+        let head: String = tc.draw(generators::from_regex(r"[a-z]{0,4}").fullmatch(true));
+        let tail: String = tc.draw(generators::from_regex(r"[a-z]{0,4}").fullmatch(true));
+        let input = format!("http://{head}%3A{tail}@host/");
+        let url = gix_url::parse(input.as_str()).expect("a percent-encoded user is a valid URL");
+        assert_eq!(url.user(), Some(format!("{head}:{tail}").as_str()), "documented decoding");
+        let serialized = url.to_bstring();
+        let reparsed = gix_url::parse(&serialized).unwrap_or_else(|err| {
+            panic!("serialization {serialized:?} of a parsed URL must be parseable, but failed with: {err}")
+        });
+        assert_eq!(
+            reparsed, url,
+            "user with colon must survive the documented lossless roundtrip, serialized form was {serialized:?}"
+        );
+    }
+}
