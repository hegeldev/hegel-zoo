 }
+
+/// Property-based tests (hegel) — the generalization of `assert_set_value()` above:
+/// instead of hand-picked values, draw arbitrary byte values.
+mod properties {
+    use bstr::{BStr, ByteSlice};
+    use hegel::generators::{self, Generator};
+
+    /// Property: `set_raw_value()` documents that the assigned value is returned by
+    /// `raw_value()` afterwards, and values are escaped on write (`escape_value()`) and
+    /// normalized on read, so the value must also survive a serialize/parse cycle.
+    #[hegel::test]
+    fn set_value_can_be_read_back_after_serialization(tc: hegel::TestCase) {
+        let section: String = tc.draw(generators::from_regex(r"[a-zA-Z0-9-]{1,8}").fullmatch(true));
+        let key: String = tc.draw(generators::from_regex(r"[a-zA-Z][a-zA-Z0-9-]{0,7}").fullmatch(true));
+        let value: Vec<u8> = tc.draw(hegel::one_of!(
+            generators::binary().max_size(20),
+            generators::text().max_size(20).map(String::into_bytes),
+        ));
+
+        let mut file = gix_config::File::default();
+        file.set_raw_value_by(&section, None::<&BStr>, &key, value.as_bstr())
+            .expect("setting a value in a fresh file always succeeds");
+        assert_eq!(
+            file.raw_value_by(&section, None::<&BStr>, &key)
+                .expect("the just-set value exists"),
+            value.as_bstr(),
+            "raw_value must return exactly what was set"
+        );
+
+        let serialized = file.to_bstring();
+        let reparsed = gix_config::File::from_bytes_no_includes(
+            &serialized,
+            gix_config::file::Metadata::api(),
+            gix_config::file::init::Options::default(),
+        )
+        .unwrap_or_else(|err| {
+            panic!(
+                "serialization {:?} after set_raw_value must be parseable, but failed with: {err}",
+                serialized.as_bstr()
+            )
+        });
+        assert_eq!(
+            reparsed
+                .raw_value_by(&section, None::<&BStr>, &key)
+                .expect("the value exists after reparsing"),
+            value.as_bstr(),
+            "the set value must survive a serialize/parse cycle (serialized: {:?})",
+            serialized.as_bstr()
+        );
+    }
+}
diff --git a/gix-config/tests/config/file/write.rs b/gix-config/tests/config/file/write.rs
index 223ce10..1a0ffaa 100644
--- a/gix-config/tests/config/file/write.rs
+++ b/gix-config/tests/config/file/write.rs
@@ -195,3 +195,211 @@ mod to_filter {
         Ok(())
     }
 }
+
+/// Property-based tests (hegel).
+mod properties {
+    use bstr::{BString, ByteSlice};
+    use gix_config::file::{Metadata, init::Options};
+    use hegel::generators::{self, Generator};
+
+    fn parse(input: &[u8]) -> Result<gix_config::File, gix_config::file::init::Error> {
+        gix_config::File::from_bytes_no_includes(input, Metadata::api(), Options::default())
+    }
+
+    /// A quoted subsection name with `"` and `\` escaped as the parser requires.
+    fn escape_subsection(name: &str) -> String {
+        name.replace('\\', r"\\").replace('"', r#"\""#)
+    }
+
+    /// git-config-ish input: mostly well-formed sections/values/comments, plus raw text and bytes.
+    #[hegel::composite]
+    pub(crate) fn config_ish(tc: &hegel::TestCase) -> Vec<u8> {
+        match tc.draw(generators::integers::<u8>().max_value(7)) {
+            0 => return tc.draw(generators::binary().max_size(60)),
+            1 => return tc.draw(generators::text().max_size(60)).into_bytes(),
+            _ => {}
+        }
+        let newline = tc.draw(generators::sampled_from(vec!["\n", "\r\n"]));
+        let ws = |tc: &hegel::TestCase| -> String { tc.draw(generators::from_regex(r"[ \t]{0,3}").fullmatch(true)) };
+        let mut out = String::new();
+        let line_count: usize = tc.draw(generators::integers::<usize>().max_value(8));
+        for _ in 0..line_count {
+            match tc.draw(generators::integers::<u8>().max_value(5)) {
+                // comment line
+                0 => {
+                    out.push_str(&ws(&tc));
+                    out.push_str(tc.draw(generators::sampled_from(vec![";", "#"])));
+                    let comment: String = tc.draw(generators::from_regex(r"[^\r\n\x00]{0,10}").fullmatch(true));
+                    out.push_str(&comment);
+                }
+                // blank line
+                1 => out.push_str(&ws(&tc)),
+                // section header
+                2 | 3 => {
+                    out.push_str(&ws(&tc));
+                    out.push('[');
+                    let name: String = tc.draw(generators::from_regex(r"[a-zA-Z0-9-]{1,8}").fullmatch(true));
+                    out.push_str(&name);
+                    match tc.draw(generators::integers::<u8>().max_value(2)) {
+                        0 => {}
+                        1 => {
+                            let sub: String = tc.draw(generators::from_regex(r"[^\r\n\x00]{0,8}").fullmatch(true));
+                            out.push_str(" \"");
+                            out.push_str(&escape_subsection(&sub));
+                            out.push('"');
+                        }
+                        _ => {
+                            let sub: String = tc.draw(generators::from_regex(r"[a-zA-Z0-9.-]{1,8}").fullmatch(true));
+                            out.push('.');
+                            out.push_str(&sub);
+                        }
+                    }
+                    out.push(']');
+                    out.push_str(&ws(&tc));
+                }
+                // key-value line
+                _ => {
+                    out.push_str(&ws(&tc));
+                    let key: String = tc.draw(generators::from_regex(r"[a-zA-Z][a-zA-Z0-9-]{0,6}").fullmatch(true));
+                    out.push_str(&key);
+                    if tc.draw(generators::booleans()) {
+                        out.push_str(&ws(&tc));
+                        out.push('=');
+                        out.push_str(&ws(&tc));
+                        let pieces: usize = tc.draw(generators::integers::<usize>().max_value(3));
+                        for _ in 0..pieces {
+                            let piece: String = tc.draw(hegel::one_of!(
+                                // plain value text
+                                generators::from_regex(r"[a-zA-Z0-9 ._${}<>@()/-]{0,8}").fullmatch(true),
+                                // supported escape sequences
+                                generators::sampled_from(vec![
+                                    r"\n".to_string(),
+                                    r"\t".to_string(),
+                                    r"\b".to_string(),
+                                    r#"\""#.to_string(),
+                                    r"\\".to_string(),
+                                ]),
+                                // quoted stretch
+                                generators::from_regex(r#""[a-zA-Z0-9 ;#\t._-]{0,6}""#).fullmatch(true),
+                            ));
+                            out.push_str(&piece);
+                        }
+                        // line continuation followed by more value content
+                        if tc.draw(generators::booleans()) {
+                            out.push('\\');
+                            out.push_str(newline);
+                            let cont: String = tc.draw(generators::from_regex(r"[a-zA-Z0-9 \t._-]{0,8}").fullmatch(true));
+                            out.push_str(&cont);
+                        }
+                        // trailing comment
+                        if tc.draw(generators::booleans()) {
+                            let comment: String = tc.draw(generators::from_regex(r"[;#][^\r\n\x00]{0,8}").fullmatch(true));
+                            out.push_str(&comment);
+                        }
+                    }
+                }
+            }
+            out.push_str(newline);
+        }
+        out.into_bytes()
+    }
+
+    /// Property: serialization is a fixed point after one parse/serialize cycle.
+    ///
+    /// `File::write_to()` documents that it "reproduce[s] this file mostly losslessly as it was
+    /// parsed" (the "mostly" covers normalizations like inserting a newline after a header, see
+    /// `inserted_newlines_use_each_sections_newline_style`). Therefore serializing a parseable
+    /// file must yield bytes that parse again, and a second serialization must be byte-identical
+    /// to the first — otherwise output would drift on every load/store cycle.
+    #[hegel::test]
+    fn serialization_is_a_fixed_point(tc: hegel::TestCase) {
+        let input = tc.draw(config_ish());
+        let Ok(file) = parse(&input) else { tc.reject() };
+        let first: BString = file.to_bstring();
+        let reparsed = parse(&first).unwrap_or_else(|err| {
+            panic!(
+                "serialization {:?} of a parsed file must be parseable, but failed with: {err}",
+                first.as_bstr()
+            )
+        });
+        let second: BString = reparsed.to_bstring();
+        assert_eq!(
+            second,
+            first,
+            "serialization must be stable after the first parse/serialize cycle (input was {:?})",
+            input.as_bstr()
+        );
+    }
+
+    /// Property: a parse/serialize cycle preserves the semantic content of the file:
+    /// every section (name, subsection) and its values, in order. This is the generalization of
+    /// `complex_lossless_roundtrip` and what the crate's own fuzz target implies by reparsing
+    /// the serialization of a mutated file.
+    #[hegel::test]
+    fn roundtrip_preserves_sections_and_values(tc: hegel::TestCase) {
+        fn snapshot(file: &gix_config::File) -> Vec<(String, Option<BString>, Vec<(String, BString)>)> {
+            file.sections()
+                .map(|section| {
+                    let header = section.header();
+                    (
+                        header.name().to_string(),
+                        header.subsection_name().map(ToOwned::to_owned),
+                        section.body().into_iter().collect(),
+                    )
+                })
+                .collect()
+        }
+
+        let input = tc.draw(config_ish());
+        let Ok(file) = parse(&input) else { tc.reject() };
+        let serialized: BString = file.to_bstring();
+        let reparsed = parse(&serialized).unwrap_or_else(|err| {
+            panic!(
+                "serialization {:?} of a parsed file must be parseable, but failed with: {err}",
+                serialized.as_bstr()
+            )
+        });
+        assert_eq!(
+            snapshot(&reparsed),
+            snapshot(&file),
+            "sections and values must survive a parse/serialize cycle (serialized form was {:?})",
+            serialized.as_bstr()
+        );
+    }
+
+    /// Property: subsection names may contain anything but `\n` and `\0`
+    /// (see `gix_config::parse::section::header::is_valid_subsection`), are escaped on write and
+    /// decoded on parse (see `decoded_subsection_names_keep_their_raw_spelling`), so a value
+    /// stored under an arbitrary valid subsection must be retrievable under the same name after
+    /// a serialize/parse cycle.
+    #[hegel::test]
+    fn subsection_names_roundtrip_through_serialization(tc: hegel::TestCase) {
+        let subsection: String = tc.draw(
+            hegel::one_of!(
+                generators::text().max_size(15),
+                // boost characters with special meaning in headers
+                generators::from_regex(r#"[\\" \t.\[\]]{1,6}"#).fullmatch(true),
+            )
+            .map(|s: String| s.replace(['\n', '\0'], "_")),
+        );
+        let mut file = gix_config::File::new(Metadata::api());
+        file.set_raw_value_by("section", Some(subsection.as_str().into()), "key", "value")
+            .expect("subsection without newline/NUL is valid");
+        let serialized = file.to_bstring();
+        let reparsed = parse(&serialized).unwrap_or_else(|err| {
+            panic!(
+                "serialization {:?} with escaped subsection must be parseable, but failed with: {err}",
+                serialized.as_bstr()
+            )
+        });
+        let value = reparsed
+            .raw_value_by("section", Some(subsection.as_str().into()), "key")
+            .unwrap_or_else(|err| {
+                panic!(
+                    "value must be found under subsection {subsection:?} after roundtrip (serialized: {:?}): {err}",
+                    serialized.as_bstr()
+                )
+            });
+        assert_eq!(value, "value");
+    }
+}
