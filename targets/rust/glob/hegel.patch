+    // -----------------------------------------------------------------------
+    // Property-based tests (hegel)
+    // -----------------------------------------------------------------------
+
+    use hegel::generators::{self, Generator};
+
+    /// Characters used for generated pattern literals. Deliberately small so
+    /// patterns and subject strings collide often. Includes `/` and `.`
+    /// because the matcher branches on separators and leading dots, and `-`
+    /// and `!` because they are special only inside brackets.
+    const LIT_CHARS: [char; 7] = ['a', 'b', 'c', '.', '/', '-', '!'];
+    /// Characters allowed inside generated `[...]` classes. Excludes `-`,
+    /// `]` and `!` so the rendered class parses back to exactly the
+    /// structural items we generated (no accidental ranges/negations).
+    const CLASS_CHARS: [char; 5] = ['a', 'b', 'c', '.', '/'];
+    /// Characters used for generated subject strings: the pattern alphabet
+    /// plus a couple of characters no pattern literal ever uses.
+    const STR_CHARS: [char; 9] = ['a', 'b', 'c', '.', '/', '-', '!', 'A', 'z'];
+
+    #[derive(Debug, Clone)]
+    enum ClassItem {
+        Single(char),
+        Range(char, char),
+    }
+
+    /// Structural representation of a (non-recursive) pattern, used both to
+    /// render a pattern string and as input to the naive reference matcher.
+    #[derive(Debug, Clone)]
+    enum RefTok {
+        Lit(char),
+        AnyChar,
+        AnySeq,
+        Class { negated: bool, items: Vec<ClassItem> },
+    }
+
+    #[hegel::composite]
+    fn class_item(tc: &hegel::TestCase) -> ClassItem {
+        let lo = tc.draw(generators::sampled_from(CLASS_CHARS.to_vec()));
+        if tc.draw(generators::booleans()) {
+            // Possibly-empty ranges like `[c-a]` are legal and match nothing
+            // (see test_range_pattern's `[2-1]` case), so hi is unconstrained.
+            let hi = tc.draw(generators::sampled_from(CLASS_CHARS.to_vec()));
+            ClassItem::Range(lo, hi)
+        } else {
+            ClassItem::Single(lo)
+        }
+    }
+
+    #[hegel::composite]
+    fn ref_tok(tc: &hegel::TestCase, allow_negated: bool) -> RefTok {
+        let kind = tc.draw(generators::integers::<u8>().max_value(3));
+        match kind {
+            0 => RefTok::Lit(tc.draw(generators::sampled_from(LIT_CHARS.to_vec()))),
+            1 => RefTok::AnyChar,
+            2 => RefTok::AnySeq,
+            _ => RefTok::Class {
+                negated: allow_negated && tc.draw(generators::booleans()),
+                items: tc.draw((generators::vecs(class_item()).min_size(1).max_size(3)).print_as_debug()),
+            },
+        }
+    }
+
+    /// Generate a token sequence that renders to a *valid* non-recursive
+    /// pattern: adjacent `*`s would form the recursive wildcard `**` (or a
+    /// PatternError), so consecutive AnySeq tokens are collapsed.
+    #[hegel::composite]
+    fn pattern_tokens(tc: &hegel::TestCase, allow_negated: bool) -> Vec<RefTok> {
+        let raw: Vec<RefTok> = tc.draw((generators::vecs(ref_tok(allow_negated)).max_size(8)).print_as_debug());
+        let mut toks: Vec<RefTok> = Vec::new();
+        for t in raw {
+            if matches!(t, RefTok::AnySeq) && matches!(toks.last(), Some(RefTok::AnySeq)) {
+                continue;
+            }
+            toks.push(t);
+        }
+        toks
+    }
+
+    fn render_tokens(tokens: &[RefTok]) -> String {
+        let mut s = String::new();
+        for t in tokens {
+            match t {
+                RefTok::Lit(c) => s.push(*c),
+                RefTok::AnyChar => s.push('?'),
+                RefTok::AnySeq => s.push('*'),
+                RefTok::Class { negated, items } => {
+                    s.push('[');
+                    if *negated {
+                        s.push('!');
+                    }
+                    for item in items {
+                        match item {
+                            ClassItem::Single(c) => s.push(*c),
+                            ClassItem::Range(lo, hi) => {
+                                s.push(*lo);
+                                s.push('-');
+                                s.push(*hi);
+                            }
+                        }
+                    }
+                    s.push(']');
+                }
+            }
+        }
+        s
+    }
+
+    fn class_contains(items: &[ClassItem], c: char) -> bool {
+        items.iter().any(|item| match *item {
+            ClassItem::Single(s) => s == c,
+            ClassItem::Range(lo, hi) => lo <= c && c <= hi,
+        })
+    }
+
+    /// Naive backtracking reference matcher for non-recursive patterns with
+    /// `case_sensitive: true`, implementing the documented semantics of
+    /// `Pattern` (`?`, `*`, `[...]`, `[!...]`, literals) and of
+    /// `MatchOptions::require_literal_separator` / `require_literal_leading_dot`
+    /// ("must be matched by a literal `/`, rather than by `*` or `?` or
+    /// `[...]`" / "`*`, `?`, `**`, or `[...]` will not match").
+    /// `at_start` is true at the start of the string and right after a `/`.
+    fn ref_matches(pat: &[RefTok], s: &[char], at_start: bool, opts: MatchOptions) -> bool {
+        let (tok, rest) = match pat.split_first() {
+            None => return s.is_empty(),
+            Some(x) => x,
+        };
+        match tok {
+            RefTok::AnySeq => {
+                // `*` matches any (possibly empty) sequence of characters.
+                if ref_matches(rest, s, at_start, opts) {
+                    return true;
+                }
+                match s.split_first() {
+                    None => false,
+                    Some((&c, srest)) => {
+                        if at_start && opts.require_literal_leading_dot && c == '.' {
+                            return false;
+                        }
+                        if opts.require_literal_separator && c == '/' {
+                            return false;
+                        }
+                        ref_matches(pat, srest, c == '/', opts)
+                    }
+                }
+            }
+            _ => match s.split_first() {
+                None => false,
+                Some((&c, srest)) => {
+                    let wildcard_blocked = (opts.require_literal_separator && c == '/')
+                        || (at_start && opts.require_literal_leading_dot && c == '.');
+                    let ok = match tok {
+                        RefTok::Lit(l) => *l == c,
+                        RefTok::AnyChar => !wildcard_blocked,
+                        RefTok::Class { negated, items } => {
+                            !wildcard_blocked && (class_contains(items, c) != *negated)
+                        }
+                        RefTok::AnySeq => unreachable!(),
+                    };
+                    ok && ref_matches(rest, srest, c == '/', opts)
+                }
+            },
+        }
+    }
+
+    #[hegel::composite]
+    fn subject_string(tc: &hegel::TestCase) -> String {
+        let chars: Vec<char> =
+            tc.draw(generators::vecs(generators::sampled_from(STR_CHARS.to_vec())).max_size(12));
+        chars.into_iter().collect()
+    }
+
+    /// Arbitrary Unicode scalar value, weighted across ASCII / BMP /
+    /// supplementary planes (surrogate codepoints map to U+FFFD).
+    #[hegel::composite]
+    fn any_char(tc: &hegel::TestCase) -> char {
+        tc.draw(
+            hegel::one_of!(
+                generators::integers::<u32>().max_value(0x7F),
+                generators::integers::<u32>().min_value(0x80).max_value(0xFFFF),
+                generators::integers::<u32>()
+                    .min_value(0x1_0000)
+                    .max_value(0x10_FFFF),
+            )
+            .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+        )
+    }
+
+    /// Property: `Pattern::new` returns `Ok` or `PatternError` for arbitrary
+    /// input; it never panics (parse robustness).
+    #[hegel::test]
+    fn prop_pattern_new_never_panics(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::text());
+        let _ = Pattern::new(&s);
+    }
+
+    /// Property (from `Pattern::escape`'s docs): "The resulting string will,
+    /// when compiled into a `Pattern`, match the input string".
+    #[hegel::test]
+    fn prop_escape_roundtrip_matches_original(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::text());
+        let escaped = Pattern::escape(&s);
+        let pat = Pattern::new(&escaped)
+            .unwrap_or_else(|e| panic!("escape({:?}) = {:?} failed to compile: {}", s, escaped, e));
+        assert!(
+            pat.matches(&s),
+            "escape({:?}) = {:?} does not match the original string",
+            s,
+            escaped
+        );
+    }
+
+    /// Property (from `Pattern::escape`'s docs): the escaped pattern matches
+    /// the input string "and nothing else" — in particular not a string one
+    /// edit (insert/remove/replace a char) away from the original.
+    #[hegel::test]
+    fn prop_escape_matches_nothing_else(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::text());
+        let mut chars: Vec<char> = s.chars().collect();
+        let kind = if chars.is_empty() {
+            1u8 // only insertion is possible on an empty string
+        } else {
+            tc.draw(generators::integers::<u8>().max_value(2))
+        };
+        match kind {
+            0 => {
+                let idx = tc.draw(generators::integers::<usize>().max_value(chars.len() - 1));
+                chars.remove(idx);
+            }
+            1 => {
+                let idx = tc.draw(generators::integers::<usize>().max_value(chars.len()));
+                chars.insert(idx, tc.draw(any_char()));
+            }
+            _ => {
+                let idx = tc.draw(generators::integers::<usize>().max_value(chars.len() - 1));
+                let replacement = tc.draw(any_char());
+                tc.assume(replacement != chars[idx]);
+                chars[idx] = replacement;
+            }
+        }
+        let near_miss: String = chars.into_iter().collect();
+        assert_ne!(near_miss, s);
+        let pat = Pattern::new(&Pattern::escape(&s)).unwrap();
+        assert!(
+            !pat.matches(&near_miss),
+            "escape({:?}) unexpectedly matches near-miss {:?}",
+            s,
+            near_miss
+        );
+    }
+
+    /// Property: a pattern containing no metacharacters consists solely of
+    /// `Char` tokens (see the debug_assert in `fill_todo`), and literal
+    /// matching under default options on unix is exact character equality,
+    /// so such a pattern matches a string iff it equals the pattern.
+    #[hegel::test]
+    fn prop_literal_pattern_matches_exactly_itself(tc: hegel::TestCase) {
+        fn strip_meta(s: String) -> String {
+            s.chars().filter(|c| !"?*[]".contains(*c)).collect()
+        }
+        let s: String = tc.draw(generators::text().map(strip_meta));
+        let pat = Pattern::new(&s).unwrap();
+        assert!(pat.matches(&s), "literal pattern {:?} must match itself", s);
+        let other: String = tc.draw(generators::text().map(strip_meta));
+        assert_eq!(
+            pat.matches(&other),
+            other == s,
+            "literal pattern {:?} vs string {:?}",
+            s,
+            other
+        );
+    }
+
+    /// Property (from `Pattern::matches`'s docs): `matches` uses the default
+    /// match options, i.e. it agrees with `matches_with(_, MatchOptions::new())`.
+    #[hegel::test]
+    fn prop_matches_agrees_with_matches_with_default_options(tc: hegel::TestCase) {
+        let tokens = tc.draw((pattern_tokens(true)).print_as_debug());
+        let pattern = render_tokens(&tokens);
+        let pat = Pattern::new(&pattern).unwrap();
+        let s = tc.draw(subject_string());
+        assert_eq!(
+            pat.matches(&s),
+            pat.matches_with(&s, MatchOptions::new()),
+            "pattern {:?} vs string {:?}",
+            pattern,
+            s
+        );
+    }
+
+    /// Property: `?`, `*`, `[...]`, `[!...]` and literal semantics (from the
+    /// `Pattern` docs), including `require_literal_separator` and
+    /// `require_literal_leading_dot` (from the `MatchOptions` docs), agree
+    /// with a naive backtracking reference matcher over a small alphabet.
+    /// Case sensitivity is exercised by separate properties.
+    #[hegel::test]
+    fn prop_matcher_agrees_with_naive_reference(tc: hegel::TestCase) {
+        let tokens = tc.draw((pattern_tokens(true)).print_as_debug());
+        let pattern = render_tokens(&tokens);
+        let pat = Pattern::new(&pattern)
+            .unwrap_or_else(|e| panic!("generated pattern {:?} failed to compile: {}", pattern, e));
+        let s = tc.draw(subject_string());
+        let opts = MatchOptions {
+            case_sensitive: true,
+            require_literal_separator: tc.draw(generators::booleans()),
+            require_literal_leading_dot: tc.draw(generators::booleans()),
+        };
+        let chars: Vec<char> = s.chars().collect();
+        assert_eq!(
+            pat.matches_with(&s, opts),
+            ref_matches(&tokens, &chars, true, opts),
+            "pattern {:?} vs string {:?} with {:?}",
+            pattern,
+            s,
+            opts
+        );
+    }
+
+    /// Property (from `MatchOptions::case_sensitive`'s docs: upper/lower case
+    /// relationships between ASCII characters are ignored when false): an
+    /// escaped ASCII literal matches any per-character re-casing of itself
+    /// under case-insensitive options.
+    #[hegel::test]
+    fn prop_case_insensitive_literal_matches_any_casing(tc: hegel::TestCase) {
+        let alphabet: Vec<char> = ('a'..='z')
+            .chain('A'..='Z')
+            .chain('0'..='9')
+            .chain("._/-?*[]".chars())
+            .collect();
+        let chars: Vec<char> =
+            tc.draw(generators::vecs(generators::sampled_from(alphabet)).max_size(12));
+        let s: String = chars.iter().collect();
+        let mut flipped = String::new();
+        for &c in &chars {
+            if tc.draw(generators::booleans()) {
+                if c.is_ascii_lowercase() {
+                    flipped.push(c.to_ascii_uppercase());
+                } else {
+                    flipped.push(c.to_ascii_lowercase());
+                }
+            } else {
+                flipped.push(c);
+            }
+        }
+        let pat = Pattern::new(&Pattern::escape(&s)).unwrap();
+        let ci = MatchOptions {
+            case_sensitive: false,
+            ..MatchOptions::new()
+        };
+        assert!(
+            pat.matches_with(&flipped, ci),
+            "escape({:?}) should case-insensitively match {:?}",
+            s,
+            flipped
+        );
+    }
+
+    /// Property: for patterns without negated classes, turning off
+    /// `case_sensitive` only widens per-character acceptance (`chars_eq` and
+    /// `in_char_specifiers` add ASCII-case matches, never remove any), so a
+    /// case-sensitive match implies a case-insensitive match. Negated classes
+    /// are excluded because they invert acceptance: `[!a]` matches "A"
+    /// case-sensitively but not case-insensitively (see
+    /// test_pattern_matches_case_insensitive_range).
+    #[hegel::test]
+    fn prop_case_sensitive_match_implies_case_insensitive_match(tc: hegel::TestCase) {
+        let tokens = tc.draw((pattern_tokens(false)).print_as_debug());
+        let pattern = render_tokens(&tokens);
+        let pat = Pattern::new(&pattern).unwrap();
+        let s = tc.draw(subject_string());
+        let rls = tc.draw(generators::booleans());
+        let rld = tc.draw(generators::booleans());
+        let cs_opts = MatchOptions {
+            case_sensitive: true,
+            require_literal_separator: rls,
+            require_literal_leading_dot: rld,
+        };
+        let ci_opts = MatchOptions {
+            case_sensitive: false,
+            ..cs_opts
+        };
+        if pat.matches_with(&s, cs_opts) {
+            assert!(
+                pat.matches_with(&s, ci_opts),
+                "pattern {:?} matches {:?} case-sensitively but not case-insensitively ({:?})",
+                pattern,
+                s,
+                cs_opts
+            );
+        }
+    }
+
+    /// Property (from the `Pattern` docs: `**` "matches the current directory
+    /// and arbitrary subdirectories", and test_recursive_wildcards: `**/test`
+    /// matches "test", "one/test", "one/two/test"): a pattern `**/<name>`
+    /// matches `<name>` prefixed by any sequence of directory components.
+    #[hegel::test]
+    fn prop_recursive_wildcard_matches_any_directory_prefix(tc: hegel::TestCase) {
+        #[hegel::composite]
+        fn component(tc: &hegel::TestCase) -> String {
+            let chars: Vec<char> = tc.draw(
+                generators::vecs(generators::sampled_from(vec!['a', 'b', 'c', '.', 'x', '-']))
+                    .min_size(1)
+                    .max_size(4),
+            );
+            chars.into_iter().collect()
+        }
+        let dirs: Vec<String> = tc.draw(generators::vecs(component()).max_size(5));
+        let name = tc.draw(component());
+        let pattern = format!("**/{}", Pattern::escape(&name));
+        let pat = Pattern::new(&pattern).unwrap();
+        let mut parts = dirs;
+        parts.push(name);
+        let path = parts.join("/");
+        assert!(
+            pat.matches(&path),
+            "pattern {:?} should match {:?}",
+            pattern,
+            path
+        );
+    }
 }
