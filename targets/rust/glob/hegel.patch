+// ----------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ----------------------------------------------------------------------------
+
+use hegel::generators;
+
+/// Characters used for generated file names. No `/` (not allowed in file
+/// names) and no glob metacharacters are needed because the pattern side is
+/// generated separately.
+const FS_NAME_CHARS: [char; 7] = ['a', 'b', 'c', 'A', '.', '_', '-'];
+/// Characters allowed inside generated `[...]` classes: excludes `-`, `]`
+/// and `!` so the rendered class is unambiguous.
+const FS_CLASS_CHARS: [char; 6] = ['a', 'b', 'c', 'A', '.', '_'];
+
+#[hegel::composite]
+fn file_name(tc: &hegel::TestCase) -> String {
+    let chars: Vec<char> = tc.draw(
+        generators::vecs(generators::sampled_from(FS_NAME_CHARS.to_vec()))
+            .min_size(1)
+            .max_size(6),
+    );
+    chars.into_iter().collect()
+}
+
+/// Draw a single-component glob pattern (no `/`). Constraints, each of which
+/// keeps the pattern inside the property's domain:
+/// - no adjacent `*`s (would be the recursive wildcard `**`, or an error);
+/// - no *leading* literal `.`: patterns starting with a literal dot
+///   additionally match the special entries `.` and `..` (see the special
+///   case in `fill_todo`), which are outside the "entries created in this
+///   directory" model used below.
+fn draw_component_pattern(tc: &hegel::TestCase) -> String {
+    let len = tc.draw(generators::integers::<usize>().min_value(1).max_value(6));
+    let mut pat = String::new();
+    let mut prev_star = false;
+    for i in 0..len {
+        let kind = tc.draw(generators::integers::<u8>().max_value(3));
+        match kind {
+            0 => {
+                let mut c = tc.draw(generators::sampled_from(FS_NAME_CHARS.to_vec()));
+                if i == 0 && c == '.' {
+                    c = 'a';
+                }
+                pat.push(c);
+                prev_star = false;
+            }
+            1 => {
+                pat.push('?');
+                prev_star = false;
+            }
+            2 => {
+                if prev_star {
+                    pat.push('?');
+                    prev_star = false;
+                } else {
+                    pat.push('*');
+                    prev_star = true;
+                }
+            }
+            _ => {
+                pat.push('[');
+                if tc.draw(generators::booleans()) {
+                    pat.push('!');
+                }
+                if tc.draw(generators::booleans()) {
+                    // a (possibly empty) range like [a-c] or [c-a]
+                    let lo = tc.draw(generators::sampled_from(FS_CLASS_CHARS.to_vec()));
+                    let hi = tc.draw(generators::sampled_from(FS_CLASS_CHARS.to_vec()));
+                    pat.push(lo);
+                    pat.push('-');
+                    pat.push(hi);
+                } else {
+                    let cs: Vec<char> = tc.draw(
+                        generators::vecs(generators::sampled_from(FS_CLASS_CHARS.to_vec()))
+                            .min_size(1)
+                            .max_size(3),
+                    );
+                    for c in cs {
+                        pat.push(c);
+                    }
+                }
+                pat.push(']');
+                prev_star = false;
+            }
+        }
+    }
+    pat
+}
+
+/// Property (from `glob()`'s docs: returns "all the `Path`s that match the
+/// given pattern", "Paths are yielded in alphabetical order"): for a fresh
+/// directory with a known set of entries, `glob(<dir>/<component>)` yields
+/// exactly the entries whose file name satisfies
+/// `Pattern::new(<component>).matches(name)`, sorted.
+#[hegel::test]
+fn prop_glob_returns_exactly_the_matching_directory_entries(tc: hegel::TestCase) {
+    let mut names: Vec<String> =
+        tc.draw(generators::vecs(file_name()).max_size(8).unique(true));
+    // `.` and `..` cannot be created as directory entries.
+    names.retain(|n| n != "." && n != "..");
+
+    let component = draw_component_pattern(&tc);
+    let pat = glob::Pattern::new(&component)
+        .unwrap_or_else(|e| panic!("generated component {:?} failed to compile: {}", component, e));
+
+    let root = tempfile::tempdir().unwrap();
+    for name in &names {
+        let p = root.path().join(name);
+        if tc.draw(generators::booleans()) {
+            fs::create_dir(&p).unwrap();
+        } else {
+            fs::File::create(&p).unwrap();
+        }
+    }
+
+    let mut expected: Vec<PathBuf> = names
+        .iter()
+        .filter(|n| pat.matches(n))
+        .map(|n| root.path().join(n))
+        .collect();
+    expected.sort();
+
+    let glob_pattern = format!(
+        "{}/{}",
+        glob::Pattern::escape(root.path().to_str().unwrap()),
+        component
+    );
+    let actual: Vec<PathBuf> = glob(&glob_pattern).unwrap().map(|r| r.unwrap()).collect();
+
+    assert_eq!(
+        actual, expected,
+        "glob({:?}) disagrees with Pattern::matches over entries {:?}",
+        glob_pattern, names
+    );
+}
