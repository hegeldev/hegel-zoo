 }
+
+/// Hegel property-based tests for `Area`.
+#[cfg(test)]
+mod hegel_props {
+    use crate::algorithm::Translate;
+    use crate::utils::pbt_gens::star_polygon;
+    use crate::{Area, Polygon};
+    use hegel::generators;
+    use hegel::Generator;
+
+    // Planar area is invariant under translation. The implementation shifts
+    // each ring by its first coordinate before summing determinants (see
+    // `sum_line_determinants`), precisely so that this holds far from the
+    // origin — c.f. the `area_polygon_numerical_stability` unit test above.
+    #[hegel::test]
+    fn pbt_signed_area_translation_invariant(tc: hegel::TestCase) {
+        let poly = tc.draw((star_polygon()).print_as_debug());
+        let dx = tc.draw(generators::floats::<f64>().min_value(-1e6).max_value(1e6));
+        let dy = tc.draw(generators::floats::<f64>().min_value(-1e6).max_value(1e6));
+        let area = poly.signed_area();
+        let translated_area = poly.translate(dx, dy).signed_area();
+        // Error budget (protects the test's float tolerance, not a library
+        // contract): shifting coordinates by up to 1e6 perturbs each local
+        // coordinate by ~ulp(1e6), amplified by the polygon extent (<= 4e3)
+        // across <= 24 vertices => well under 1e-9 * (1 + |dx| + |dy|).
+        let tol = 1e-9 * (1.0 + dx.abs() + dy.abs()) + 1e-9 * area.abs();
+        assert!(
+            (translated_area - area).abs() <= tol,
+            "area changed under translation by ({dx}, {dy}): {area} -> {translated_area}"
+        );
+    }
+
+    // Reversing a ring negates its signed area — documented in the `Area`
+    // trait example, which shows `signed_area` flipping from 30. to -30.
+    // after reversing the exterior.
+    #[hegel::test]
+    fn pbt_signed_area_negates_when_ring_reversed(tc: hegel::TestCase) {
+        let poly = tc.draw((star_polygon()).print_as_debug());
+        let area = poly.signed_area();
+        let reversed = Polygon::new(
+            crate::LineString::new(poly.exterior().0.iter().rev().copied().collect()),
+            vec![],
+        );
+        // epsilon covers reordering of the floating-point summation only.
+        assert_relative_eq!(
+            reversed.signed_area(),
+            -area,
+            max_relative = 1e-9,
+            epsilon = 1e-6
+        );
+    }
+}
diff --git a/geo/src/algorithm/bool_ops/tests.rs b/geo/src/algorithm/bool_ops/tests.rs
index 6a4817d..6ca8207 100644
--- a/geo/src/algorithm/bool_ops/tests.rs
+++ b/geo/src/algorithm/bool_ops/tests.rs
@@ -483,3 +483,98 @@ mod ogc_compliance {
         );
     }
 }
+
+/// Hegel property-based tests for `BooleanOps`.
+///
+/// The BooleanOps docs promise well-defined set operations for valid input
+/// geometries, so set-algebra identities on areas must hold up to floating
+/// point tolerance. Inputs are simple star-shaped polygons (see
+/// `crate::utils::pbt_gens::star_polygon`), which satisfy the documented
+/// validity requirement.
+mod hegel_props {
+    use hegel::Generator;
+    use super::BooleanOps;
+    use crate::utils::pbt_gens::star_polygon;
+    use crate::{Area, BoundingRect, Euclidean, Length, Polygon};
+
+    /// The i_overlay backend snaps input coordinates onto an internal integer
+    /// grid scaled to the combined bounding box, so areas derived from op
+    /// outputs differ from areas of the inputs by up to roughly
+    /// `grid_step * perimeter`. Measured: a thin triangle of extent ~23.5
+    /// moved area by ~3.4e-7 under union-with-self, consistent with a grid
+    /// step of about `extent * 2^-25`. The tolerance below uses
+    /// `extent * 2^-25 * total_perimeter * 4` (4x safety margin); it reflects
+    /// the backend's documented-in-code snapping design, not slack for logic
+    /// bugs — those produce errors on the scale of whole areas.
+    fn snap_tolerance(polys: &[&Polygon<f64>]) -> f64 {
+        let mut extent = 0.0_f64;
+        let mut perimeter = 0.0_f64;
+        for poly in polys {
+            if let Some(rect) = poly.bounding_rect() {
+                extent = extent
+                    .max(rect.min().x.abs())
+                    .max(rect.max().x.abs())
+                    .max(rect.min().y.abs())
+                    .max(rect.max().y.abs());
+            }
+            perimeter += Euclidean.length(poly.exterior());
+        }
+        2.0 * extent * 2.0_f64.powi(-25) * perimeter * 4.0 + 1e-12
+    }
+
+    fn assert_area_close(lhs: f64, rhs: f64, tol: f64, context: &str) {
+        assert!(
+            (lhs - rhs).abs() <= tol,
+            "{context}: |{lhs} - {rhs}| = {} > tolerance {tol}",
+            (lhs - rhs).abs()
+        );
+    }
+
+    // A ∪ A = A: union is idempotent, so the area must be unchanged.
+    #[hegel::test]
+    fn pbt_union_with_self_preserves_area(tc: hegel::TestCase) {
+        let a = tc.draw((star_polygon()).print_as_debug());
+        let area = a.unsigned_area();
+        let union_area = a.union(&a).unsigned_area();
+        assert_area_close(
+            union_area,
+            area,
+            snap_tolerance(&[&a, &a]),
+            "area(A ∪ A) vs area(A)",
+        );
+    }
+
+    // Inclusion-exclusion: area(A ∪ B) + area(A ∩ B) = area(A) + area(B).
+    #[hegel::test]
+    fn pbt_union_intersection_inclusion_exclusion(tc: hegel::TestCase) {
+        let a = tc.draw((star_polygon()).print_as_debug());
+        let b = tc.draw((star_polygon()).print_as_debug());
+        let inputs = a.unsigned_area() + b.unsigned_area();
+        let outputs = a.union(&b).unsigned_area() + a.intersection(&b).unsigned_area();
+        assert_area_close(
+            outputs,
+            inputs,
+            snap_tolerance(&[&a, &b]),
+            "area(A∪B) + area(A∩B) vs area(A) + area(B)",
+        );
+    }
+
+    // A ∪ B is partitioned by A ∩ B, A \ B and B \ A. All four quantities are
+    // computed from op *outputs*, so grid snapping of the inputs affects both
+    // sides identically.
+    #[hegel::test]
+    fn pbt_difference_and_intersection_partition_union(tc: hegel::TestCase) {
+        let a = tc.draw((star_polygon()).print_as_debug());
+        let b = tc.draw((star_polygon()).print_as_debug());
+        let union_area = a.union(&b).unsigned_area();
+        let parts = a.intersection(&b).unsigned_area()
+            + a.difference(&b).unsigned_area()
+            + b.difference(&a).unsigned_area();
+        assert_area_close(
+            parts,
+            union_area,
+            snap_tolerance(&[&a, &b]),
+            "area(A∩B) + area(A\\B) + area(B\\A) vs area(A∪B)",
+        );
+    }
+}
diff --git a/geo/src/algorithm/centroid.rs b/geo/src/algorithm/centroid.rs
