+
+/// Hegel property-based tests for `Contains`.
+#[cfg(test)]
+mod hegel_props {
+    use crate::utils::pbt_gens::star_polygon;
+    use crate::{Contains, Intersects, Point};
+    use hegel::generators;
+    use hegel::Generator;
+
+    // Containment implies intersection: `Contains` requires the interior of
+    // `self` to include `rhs` (see the trait docs above), while `Intersects`
+    // is true whenever the geometries share any point — a strictly weaker
+    // condition. Points are drawn from a box covering the polygon (extent
+    // <= ±2e3) and its surroundings, so both containment and
+    // non-containment cases are exercised.
+    #[hegel::test]
+    fn pbt_contains_implies_intersects(tc: hegel::TestCase) {
+        let poly = tc.draw((star_polygon()).print_as_debug());
+        let x = tc.draw(generators::floats::<f64>().min_value(-2e3).max_value(2e3));
+        let y = tc.draw(generators::floats::<f64>().min_value(-2e3).max_value(2e3));
+        let point = Point::new(x, y);
+        if poly.contains(&point) {
+            assert!(
+                poly.intersects(&point),
+                "polygon contains {point:?} but does not intersect it"
+            );
+        }
+    }
+}
diff --git a/geo/src/algorithm/convex_hull/test.rs b/geo/src/algorithm/convex_hull/test.rs
index 6b46cc3..eacf85b 100644
--- a/geo/src/algorithm/convex_hull/test.rs
+++ b/geo/src/algorithm/convex_hull/test.rs
@@ -311,3 +311,169 @@ fn convex_hull_with_nan_does_not_panic() {
     ]);
     let _ = pts.convex_hull();
 }
+
+/// Hegel property-based tests for `ConvexHull`.
+///
+/// The trait docs promise: "Returns the convex hull of a geometry. The hull is
+/// always oriented counter-clockwise." A CCW convex hull must (a) keep every
+/// input point on or to the left of each directed hull edge, and (b) never
+/// make a clockwise turn between consecutive edges. Both checks use the
+/// `robust` crate's exact `orient2d` predicate as an independent oracle
+/// (the same predicate geo's `RobustKernel` wraps, but applied directly to
+/// the raw output rather than through the code under test).
+mod hegel_props {
+    use crate::ConvexHull;
+    use crate::geometry::{Coord, MultiPoint, Point};
+    use hegel::generators::{self, Generator};
+
+    fn orient(a: Coord<f64>, b: Coord<f64>, c: Coord<f64>) -> f64 {
+        robust::orient2d(
+            robust::Coord { x: a.x, y: a.y },
+            robust::Coord { x: b.x, y: b.y },
+            robust::Coord { x: c.x, y: c.y },
+        )
+    }
+
+    /// Input point sets. When `grid_only` is false, half the draws use a
+    /// small integer grid, which makes duplicate and exactly-collinear points
+    /// (the hard cases for hull algorithms) common; the other half are
+    /// arbitrary floats. Coordinates must be finite (`Validation` deems
+    /// non-finite coords invalid) and are bounded to ±1e150 so that
+    /// `orient2d`'s internal products of coordinate differences cannot
+    /// overflow f64 — beyond that the robust predicate returns NaN (observed
+    /// for coords near ±1.8e308) and is useless as an oracle. The bound
+    /// protects the test's oracle, not a library contract;
+    /// `pbt_convex_hull_no_panic_on_any_finite_coords` below keeps exercising
+    /// the full finite range.
+    ///
+    /// With `grid_only = true` every coordinate is an i8-sized integer, a
+    /// domain on which all of quick_hull's arithmetic (including its
+    /// non-robust farthest-point dot product) is exactly representable in
+    /// f64.
+    #[hegel::composite]
+    fn point_sets(tc: &hegel::TestCase, grid_only: bool) -> Vec<Coord<f64>> {
+        let coord_gen = if grid_only || tc.draw(generators::booleans()) {
+            generators::integers::<i8>().map(|v| v as f64).boxed()
+        } else {
+            generators::floats::<f64>()
+                .min_value(-1e150)
+                .max_value(1e150)
+                .boxed()
+        };
+        let n = tc.draw(generators::integers::<usize>().max_value(100));
+        tc.draw(
+            (generators::vecs(
+                generators::tuples!(coord_gen.clone(), coord_gen).map(|(x, y)| Coord { x, y }),
+            )
+            .min_size(n)).print_as_debug(),
+        )
+    }
+
+    // Every input point lies on or to the left of every directed hull edge
+    // (for a CCW hull this is exactly "the hull contains all input points").
+    //
+    // KNOWN FAILURE — suspected library bug (kept failing on purpose; this is
+    // the canonical witness). `hull_set` in qhull.rs selects its pivot with a
+    // naive (non-robust) dot product; when coordinates are large enough that
+    // the candidates' scores collide after rounding (~1e15 and up alongside
+    // unit-scale points), an interior point can be picked as pivot and the
+    // returned ring is not a convex hull at all. Minimal shrunk
+    // counterexample:
+    //   points [(0, 0), (-1, 9150170671525436), (63, 0), (0, 1)]
+    //   => hull ring contains edge (0,0)->(0,1) with input point (63, 0)
+    //      strictly to its right.
+    // A related input, [(0,1), (0,0), (0,2), (-1.23e16, 1.23e16), (1,0)],
+    // returns a self-intersecting ring that visits (0,2) twice. Verified with
+    // exact predicates; the oracle is sound on this bounded domain.
+    #[hegel::test]
+    fn pbt_convex_hull_contains_all_input_points(tc: hegel::TestCase) {
+        let coords = tc.draw((point_sets(false)).print_as_debug());
+        let points: Vec<Point<f64>> = coords.iter().copied().map(Point::from).collect();
+        let hull = MultiPoint::new(points).convex_hull();
+        for edge in hull.exterior().lines() {
+            for &c in &coords {
+                assert!(
+                    orient(edge.start, edge.end, c) >= 0.0,
+                    "input point {c:?} lies strictly right of hull edge {edge:?}"
+                );
+            }
+        }
+    }
+
+    // Consecutive hull vertices never make a clockwise turn: the hull ring is
+    // convex and counter-clockwise, as documented.
+    //
+    // Restricted to the exact integer grid (`grid_only = true`): on
+    // unrestricted floats this fails from the same pivot-selection bug pinned
+    // by `pbt_convex_hull_contains_all_input_points` above (e.g. a clockwise
+    // turn at (0,0) for points including (1,0), (-4.67e68, 4.8e15),
+    // (2.5e16, -1.7e149), (-1.8e149, -0)). Keeping this sibling on the exact
+    // domain lets it keep testing convexity of the combinatorial cases while
+    // that bug is open.
+    #[hegel::test]
+    fn pbt_convex_hull_is_convex_and_ccw(tc: hegel::TestCase) {
+        let coords = tc.draw((point_sets(true)).print_as_debug());
+        let points: Vec<Point<f64>> = coords.iter().copied().map(Point::from).collect();
+        let hull = MultiPoint::new(points).convex_hull();
+        let ring = &hull.exterior().0;
+        if ring.is_empty() {
+            return;
+        }
+        // The ring is closed (first == last); iterate the open ring cyclically.
+        let open = &ring[..ring.len() - 1];
+        for i in 0..open.len() {
+            let a = open[i];
+            let b = open[(i + 1) % open.len()];
+            let c = open[(i + 2) % open.len()];
+            assert!(
+                orient(a, b, c) >= 0.0,
+                "hull makes a clockwise turn at {b:?} (prev {a:?}, next {c:?})"
+            );
+        }
+    }
+}
+
+/// Unbounded-magnitude robustness test, split out of `hegel_props` because the
+/// exact-predicate oracle used there is only trustworthy up to ±1e150.
+mod hegel_props_unbounded {
+    use crate::ConvexHull;
+    use crate::geometry::{Coord, MultiPoint, Point};
+    use hegel::generators::{self, Generator};
+
+    // The hull computation must not panic for any finite input coordinates,
+    // and the resulting exterior ring must be closed (first == last) whenever
+    // it is non-empty.
+    //
+    // KNOWN FAILURE — suspected library bug (kept failing on purpose; this is
+    // the canonical witness). `hull_set`'s farthest-point fold ranks
+    // candidates with `partial_cmp(..).unwrap()` (qhull.rs:156); for finite
+    // coordinates around ±1e206 and beyond, the naive dot-product score
+    // overflows to infinity and `inf - inf` produces NaN, so `partial_cmp`
+    // returns `None` and `convex_hull` panics (release builds included).
+    // Minimal counterexample:
+    //   points [(0, 0), (0, 0), (1, 0), (-7.076196536963262e206, -8.648940011347372e215)]
+    #[hegel::test]
+    fn pbt_convex_hull_no_panic_on_any_finite_coords(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(100));
+        let coords: Vec<Coord<f64>> = tc.draw(
+            (generators::vecs(
+                generators::tuples!(
+                    generators::floats::<f64>().allow_nan(false).allow_infinity(false),
+                    generators::floats::<f64>().allow_nan(false).allow_infinity(false),
+                )
+                .map(|(x, y)| Coord { x, y }),
+            )
+            .min_size(n)).print_as_debug(),
+        );
+        let points: Vec<Point<f64>> = coords.iter().copied().map(Point::from).collect();
+        let hull = MultiPoint::new(points).convex_hull();
+        let ring = &hull.exterior().0;
+        if !ring.is_empty() {
+            assert_eq!(
+                ring.first(),
+                ring.last(),
+                "hull exterior ring is not closed"
+            );
+        }
+    }
+}
diff --git a/geo/src/algorithm/simplify.rs b/geo/src/algorithm/simplify.rs
index 19a73b8..e4b42de 100644
--- a/geo/src/algorithm/simplify.rs
+++ b/geo/src/algorithm/simplify.rs
@@ -624,3 +624,98 @@ mod test {
         assert_eq!(actual, expected);
     }
 }
+
+/// Hegel property-based tests for `Simplify`.
+#[cfg(test)]
+mod hegel_props {
+    use super::*;
+    use crate::algorithm::Length;
+    use hegel::generators::{self, Generator};
+
+    /// Arbitrary line strings with finite coordinates. Non-finite coords are
+    /// excluded because `Validation` deems them invalid geometry. Magnitude is
+    /// bounded by `max_coord` — see the callers for why.
+    #[hegel::composite]
+    fn line_strings(tc: &hegel::TestCase, max_coord: f64) -> LineString<f64> {
+        let coords: Vec<Coord<f64>> = tc.draw((generators::vecs(
+            generators::tuples!(
+                generators::floats::<f64>()
+                    .min_value(-max_coord)
+                    .max_value(max_coord),
+                generators::floats::<f64>()
+                    .min_value(-max_coord)
+                    .max_value(max_coord),
+            )
+            .map(|(x, y)| Coord { x, y }),
+        )).print_as_debug());
+        LineString::from(coords)
+    }
+
+    // `simplify` and `simplify_idx` are documented to describe the same
+    // result: "Returns the indices of the points retained by
+    // `Simplify::simplify`, relative to the input geometry". So the indices
+    // must be strictly increasing, in-bounds, and map input coords exactly
+    // onto the simplified output. Epsilon is entirely unconstrained
+    // (negative, NaN, infinite): whatever the two entry points do, they must
+    // agree.
+    //
+    // KNOWN FAILURE — suspected library bug (kept failing on purpose; this is
+    // the canonical witness). For finite coordinates large enough that the
+    // cross product inside `Euclidean.distance(coord, &Line)` overflows f64,
+    // the distance becomes NaN, so `compute_rdp`'s farthest-point fold never
+    // advances past its `(0, 0.0)` seed and the library's own
+    // `debug_assert_ne!(farthest_index, 0)` (simplify.rs:108) panics in debug
+    // builds. Minimal counterexample:
+    //   LINESTRING(0 -8.988465674311469e307, 0 0, 3 -0), epsilon = 2.0
+    // In release builds there is no panic, but the middle point — at true
+    // perpendicular distance ~3.0 > epsilon — is silently discarded,
+    // violating the documented contract that only "points closer than
+    // `epsilon` distance from the simplified output may be discarded".
+    #[hegel::test]
+    fn pbt_simplify_matches_simplify_idx(tc: hegel::TestCase) {
+        let ls = tc.draw((line_strings(f64::MAX)).print_as_debug());
+        let epsilon = tc.draw(generators::floats::<f64>());
+        let simplified = ls.simplify(epsilon);
+        // Qualified call: the deprecated `SimplifyIdx` trait also has a
+        // `simplify_idx` method.
+        let indices = Simplify::simplify_idx(&ls, epsilon);
+        assert_eq!(
+            simplified.0.len(),
+            indices.len(),
+            "simplify and simplify_idx retained different numbers of points"
+        );
+        assert!(
+            indices.windows(2).all(|w| w[0] < w[1]),
+            "simplify_idx indices are not strictly increasing: {indices:?}"
+        );
+        for (coord, &index) in simplified.0.iter().zip(&indices) {
+            assert_eq!(
+                *coord, ls.0[index],
+                "simplified coord does not match input coord at index {index}"
+            );
+        }
+    }
+
+    // RDP retains a subsequence of the input vertices, and a polyline through
+    // a subsequence of vertices is never longer than the original (triangle
+    // inequality) — the same property the repo's `fuzz/fuzz_targets/simplify.rs`
+    // checks for polygons.
+    // Coordinates are capped at ±1e150 to stay clear of the overflow-to-NaN
+    // distance bug pinned by `pbt_simplify_matches_simplify_idx` above, so
+    // this property keeps testing everything else while that bug is open.
+    #[hegel::test]
+    fn pbt_simplify_never_increases_length(tc: hegel::TestCase) {
+        let ls = tc.draw((line_strings(1e150)).print_as_debug());
+        let epsilon = tc.draw(generators::floats::<f64>());
+        let simplified = ls.simplify(epsilon);
+        let original_length = Euclidean.length(&ls);
+        let simplified_length = Euclidean.length(&simplified);
+        // Relative slack covers float rounding only: removing exactly
+        // collinear vertices keeps the true length equal, but the two
+        // summations may round in opposite directions.
+        assert!(
+            simplified_length <= original_length * (1.0 + 1e-9) + 1e-9,
+            "simplification increased length: {original_length} -> {simplified_length}"
+        );
+    }
+}
