+/// Hegel property-based tests for `Validation`.
+mod hegel_props {
+    use hegel::Generator;
+    use crate::algorithm::validation::Validation;
+    use crate::utils::pbt_gens::star_polygon;
+
+    // The star-shaped polygons used as inputs across the hegel property tests
+    // are simple by construction (vertices at strictly increasing angles
+    // around a kernel point, every angular gap < pi), so `Validation` must
+    // accept them. This both tests the validator on a large family of valid
+    // polygons and guards the generator all the other properties rely on.
+    #[hegel::test]
+    fn pbt_star_polygons_are_valid(tc: hegel::TestCase) {
+        let poly = tc.draw((star_polygon()).print_as_debug());
+        assert!(
+            poly.is_valid(),
+            "star polygon reported invalid: {:?}\n{poly:?}",
+            poly.validation_errors()
+        );
+    }
+}
