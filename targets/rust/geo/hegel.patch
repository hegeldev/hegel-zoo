 }
+
+/// Shared generators for hegel property-based tests.
+#[cfg(test)]
+pub(crate) mod pbt_gens {
+    use geo_types::{Coord, LineString, Polygon, coord};
+    use hegel::generators;
+
+    /// Generates a simple (non-self-intersecting) star-shaped polygon.
+    ///
+    /// Vertices are placed counter-clockwise around a centre point at strictly
+    /// increasing angles. Each raw angular gap is drawn from `[0.5, 0.99]`, so
+    /// after normalising the gaps to sum to `2*pi` every gap is strictly less
+    /// than `pi` (with `n >= 3` gaps, the other gaps sum to at least `1.0`,
+    /// which exceeds any single gap). That makes the polygon star-shaped with
+    /// respect to its centre and therefore simple, i.e. a valid input for
+    /// algorithms (like `BooleanOps`) that are only well-defined on valid
+    /// geometries. `pbt_star_polygons_are_valid` in
+    /// `algorithm::validation::tests` cross-checks this construction against
+    /// the `Validation` trait.
+    ///
+    /// The bounds on the centre (`±1e3`) and radii (`0.5..=1e3`) keep polygon
+    /// areas comfortably above f64 rounding noise; they protect the float
+    /// tolerances used by area-comparison properties, not any contract of the
+    /// library under test.
+    #[hegel::composite]
+    pub(crate) fn star_polygon(tc: &hegel::TestCase) -> Polygon<f64> {
+        let n = tc.draw(generators::integers::<usize>().min_value(3).max_value(24));
+        let cx = tc.draw(generators::floats::<f64>().min_value(-1e3).max_value(1e3));
+        let cy = tc.draw(generators::floats::<f64>().min_value(-1e3).max_value(1e3));
+        let gaps: Vec<f64> = tc.draw(
+            generators::vecs(generators::floats::<f64>().min_value(0.5).max_value(0.99))
+                .min_size(n)
+                .max_size(n),
+        );
+        let radii: Vec<f64> = tc.draw(
+            generators::vecs(generators::floats::<f64>().min_value(0.5).max_value(1e3))
+                .min_size(n)
+                .max_size(n),
+        );
+        let total: f64 = gaps.iter().sum();
+        let mut angle = 0.0_f64;
+        let coords: Vec<Coord<f64>> = gaps
+            .iter()
+            .zip(&radii)
+            .map(|(gap, r)| {
+                angle += gap / total * std::f64::consts::TAU;
+                coord! { x: cx + r * angle.cos(), y: cy + r * angle.sin() }
+            })
+            .collect();
+        // `Polygon::new` closes the exterior ring.
+        Polygon::new(LineString::from(coords), vec![])
+    }
+}
