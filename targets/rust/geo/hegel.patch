diff --git a/geo/src/algorithm/area.rs b/geo/src/algorithm/area.rs
index e8e6b88..a2e5c6e 100644
--- a/geo/src/algorithm/area.rs
+++ b/geo/src/algorithm/area.rs
@@ -571,3 +571,55 @@ mod test {
