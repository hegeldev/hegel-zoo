+        '\0', '\u{7f}', '\u{80}', '\u{85}',
+        '\u{301}', '\u{200d}', '\u{2028}', '\u{2029}',
+        'ß', 'ẞ', '\u{fdd0}', '\u{fffd}', '\u{ffff}',
+        '\u{d7ff}', '\u{e000}', '😀', '\u{10190}', '\u{e0001}',
+        '\u{10fffe}', '\u{10ffff}',
+    ];
+
+    /// Draw a single char, weighted towards unicode boundary cases but covering the whole
+    /// codepoint space.
+    pub(crate) fn draw_char(tc: &hegel::TestCase) -> char {
+        tc.draw(hegel::one_of!(
+            generators::sampled_from(BOUNDARY_CHARS.to_vec()),
+            // Printable ASCII, so counterexamples stay readable when the bug isn't
+            // unicode-related.
+            generators::integers::<u32>().min_value(0x20).max_value(0x7e)
+                .map(|n| char::from_u32(n).unwrap()),
+            // The full codepoint space. Surrogates (0xd800..=0xdfff) aren't chars; map them to
+            // the replacement character.
+            generators::integers::<u32>().max_value(0x10ffff)
+                .map(|n| char::from_u32(n).unwrap_or('\u{fffd}')),
+        ))
+    }
+
+    /// Draw a string of `min_len..=max_len` chars (not bytes).
+    pub(crate) fn draw_content(tc: &hegel::TestCase, min_len: usize, max_len: usize) -> String {
+        let len = tc.draw(generators::integers::<usize>().min_value(min_len).max_value(max_len));
+        (0..len).map(|_| draw_char(tc)).collect()
+    }
+
+    /// Hegel equivalent of `old_make_random_change_raw`: append one random insert or delete
+    /// (forwards, or backwards one character at a time - like backspacing) to the oplog at the
+    /// branch's version. Returns the LV of the last appended operation.
+    pub(crate) fn hegel_make_random_change_raw(tc: &hegel::TestCase, oplog: &mut ListOpLog,
+                                               branch: &ListBranch, agent: AgentId) -> LV {
+        let doc_len = branch.len();
+        if doc_len == 0 || tc.draw(generators::booleans()) {
+            // Insert something.
+            let pos = tc.draw(generators::integers::<usize>().max_value(doc_len));
+            let content = draw_content(tc, 1, 3);
+            let fwd = content.chars().count() == 1 || tc.draw(generators::booleans());
+
+            if fwd {
+                oplog.add_insert_at(agent, branch.local_frontier_ref(), pos, &content)
+            } else {
+                // Type the string in reverse, one character at a time.
+                let mut frontier = branch.local_frontier();
+                for c in content.chars().rev() {
+                    let mut buf = [0u8; 4];
+                    let str = c.encode_utf8(&mut buf);
+                    let v = oplog.add_insert_at(agent, frontier.as_ref(), pos, str);
+                    frontier.replace_with_1(v);
+                }
+                frontier[0]
+            }
+        } else {
+            // Delete something.
+            let pos = tc.draw(generators::integers::<usize>().max_value(doc_len - 1));
+            let span = tc.draw(generators::integers::<usize>()
+                .min_value(1)
+                .max_value(usize::min(10, doc_len - pos)));
+            let fwd = span == 1 || tc.draw(generators::booleans());
+
+            if fwd {
+                // Using make_delete_op (rather than add_delete_without_content) preserves the
+                // deleted content, which the encoding tests need.
+                let op = branch.make_delete_op(pos..pos + span);
+                oplog.add_operations_at(agent, branch.local_frontier_ref(), &[op])
+            } else {
+                // Backspace each character individually.
+                let mut frontier = branch.local_frontier();
+                for i in (pos..pos + span).rev() {
+                    let op = branch.make_delete_op(i..i + 1);
+                    let v = oplog.add_operations_at(agent, frontier.as_ref(), &[op]);
+                    frontier.replace_with_1(v);
+                }
+                frontier[0]
+            }
+        }
+    }
+
+    /// Hegel equivalent of `old_make_random_change`: apply one random change to a ListCRDT.
+    pub(crate) fn hegel_make_random_change(tc: &hegel::TestCase, doc: &mut ListCRDT, agent: AgentId) {
+        let v = hegel_make_random_change_raw(tc, &mut doc.oplog, &doc.branch, agent);
+        doc.branch.merge(&doc.oplog, &[v]);
+    }
+}
