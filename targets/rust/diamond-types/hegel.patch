+/// Merging the same remote operations a second time (or merging an oplog into itself) is a
+/// no-op: add_missing_operations_from must be idempotent.
+#[hegel::test]
+fn hegel_oplog_merge_idempotent(tc: hegel::TestCase) {
+    let mut docs = make_docs::<2>();
+
+    // Give both replicas some (possibly overlapping, possibly concurrent) history.
+    let shared = tc.draw(generators::integers::<usize>().max_value(4));
+    for _ in 0..shared {
+        hegel_make_random_change(&tc, &mut docs[0], 0);
+    }
+    let d0 = docs[0].oplog.clone();
+    docs[1].oplog.add_missing_operations_from(&d0);
+    docs[1].branch.merge(&docs[1].oplog, docs[1].oplog.cg.version.as_ref());
+
+    for i in 0..docs.len() {
+        let n = tc.draw(generators::integers::<usize>().max_value(4));
+        for _ in 0..n {
+            hegel_make_random_change(&tc, &mut docs[i], i as AgentId);
+        }
+    }
+
+    let mut once = docs[0].oplog.clone();
+    once.add_missing_operations_from(&docs[1].oplog);
+    once.dbg_check(true);
+
+    // Merging the same ops again changes nothing.
+    let mut twice = once.clone();
+    twice.add_missing_operations_from(&docs[1].oplog);
+    assert_eq!(once, twice);
+
+    // Merging an oplog with itself changes nothing.
+    let mut self_merged = once.clone();
+    let once_snapshot = once.clone();
+    self_merged.add_missing_operations_from(&once_snapshot);
+    assert_eq!(once, self_merged);
+}
