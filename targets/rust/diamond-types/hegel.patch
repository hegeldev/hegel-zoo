+    // ---- Hegel property-based tests ----
+    //
+    // Each property draws its whole edit script as a `Vec<ScriptOp>` and applies it step by
+    // step, fitting each step to the live document (`fit`), so a failing case is a short
+    // script and the shrinker can delete any step.
+
+    use hegel::generators::{self, Generator};
+    use hegel::{PrettyPrintable, PrintableGenerator};
+    use crate::list_fuzzer_tools::hegel_tools::content;
+
+    /// One step of an edit script: an insert of `content`, or a delete of some chars, with or
+    /// without keeping the deleted content. Positions and lengths are in chars and taken
+    /// modulo the live document when the step is fitted (`fit`), so a delete of an empty
+    /// document is a no-op.
+    #[derive(Debug, Clone, PrettyPrintable)]
+    enum ScriptOp {
+        Ins { at: u32, content: String },
+        Del { at: u32, len: u32, keep_content: bool },
+    }
+
+    /// A step: an insert of one to eight chars, or a delete.
+    fn script_op() -> impl PrintableGenerator<ScriptOp> {
+        let at = || generators::integers::<u32>().max_value(999);
+        hegel::one_of!(
+            hegel::tuples!(at(), content(1, 8)).map(|(at, content)| ScriptOp::Ins { at, content }),
+            hegel::tuples!(at(), at(), generators::booleans())
+                .map(|(at, len, keep_content)| ScriptOp::Del { at, len, keep_content }),
+        )
+    }
+
+    /// An edit script of up to `max` steps.
+    fn script(max: usize) -> impl PrintableGenerator<Vec<ScriptOp>> {
+        generators::vecs(script_op()).max_size(max)
+    }
+
+    /// The step with its position and length fitted to a document of `len` chars: the
+    /// position modulo the length (the end included for an insert), the deleted span one to
+    /// the rest of the document. None when the step does not fit (a delete of an empty
+    /// document).
+    fn fit(op: &ScriptOp, len: usize) -> Option<ScriptOp> {
+        match op {
+            ScriptOp::Ins { at, content } => Some(ScriptOp::Ins {
+                at: (*at as usize % (len + 1)) as u32,
+                content: content.clone(),
+            }),
+            ScriptOp::Del { .. } if len == 0 => None,
+            ScriptOp::Del { at, len: span, keep_content } => {
+                let pos = *at as usize % len;
+                Some(ScriptOp::Del {
+                    at: pos as u32,
+                    len: (1 + *span as usize % (len - pos)) as u32,
+                    keep_content: *keep_content,
+                })
+            }
+        }
+    }
+
+    /// Apply a fitted step to the naive Vec<char> reference document.
+    fn apply_to_model(model: &mut Vec<char>, op: &ScriptOp) {
+        match op {
+            ScriptOp::Ins { at, content } => {
+                let pos = *at as usize;
+                model.splice(pos..pos, content.chars());
+            }
+            ScriptOp::Del { at, len, .. } => {
+                let pos = *at as usize;
+                model.drain(pos..pos + *len as usize);
+            }
+        }
+    }
+
+    /// Apply a fitted step to the CRDT.
+    fn apply_script_op(doc: &mut ListCRDT, agent: AgentId, op: &ScriptOp) -> LV {
+        match op {
+            ScriptOp::Ins { at, content } => doc.insert(agent, *at as usize, content),
+            ScriptOp::Del { at, len, keep_content: true } =>
+                doc.delete(agent, *at as usize..*at as usize + *len as usize),
+            ScriptOp::Del { at, len, keep_content: false } =>
+                doc.delete_without_content(agent, *at as usize..*at as usize + *len as usize),
+        }
+    }
+
+    /// Local edits applied through the CRDT must behave exactly like the same edits applied to
+    /// a naive Vec<char>: same text and same (char) length after every operation.
+    #[hegel::test]
+    fn hegel_local_edits_match_string_model(tc: hegel::TestCase) {
+        let ops = tc.draw(script(30));
+        let mut doc = ListCRDT::new();
+        let agent = doc.get_or_create_agent_id("test");
+        let mut model: Vec<char> = Vec::new();
+
+        for op in &ops {
+            let Some(op) = fit(op, model.len()) else { continue };
+            apply_to_model(&mut model, &op);
+            apply_script_op(&mut doc, agent, &op);
+
+            let expected: String = model.iter().collect();
+            assert_eq!(doc.branch.content.to_string(), expected);
+            assert_eq!(doc.len(), model.len());
+        }
+        doc.dbg_check(true);
+    }
+
+    /// Time travel: checking out the version recorded after each edit must reproduce the
+    /// document text as it was at that moment.
+    #[hegel::test]
+    fn hegel_checkout_reproduces_history(tc: hegel::TestCase) {
+        let ops = tc.draw(script(20));
+        let mut doc = ListCRDT::new();
+        let agent = doc.get_or_create_agent_id("test");
+        let mut model: Vec<char> = Vec::new();
+        let mut snapshots: Vec<(LV, String)> = Vec::new();
+
+        for op in &ops {
+            let Some(op) = fit(op, model.len()) else { continue };
+            apply_to_model(&mut model, &op);
+            let v = apply_script_op(&mut doc, agent, &op);
+            snapshots.push((v, model.iter().collect()));
+        }
+
+        // The root version is always the empty document.
+        assert_eq!(doc.oplog.checkout(&[]).content, "");
+
+        for (v, expected) in &snapshots {
+            let branch = doc.oplog.checkout(&[*v]);
+            assert_eq!(branch.content.to_string(), *expected);
+        }
+    }
+
+    /// Which agent (or how many agents) performed a linear sequence of edits must not affect
+    /// the resulting document content.
+    #[hegel::test]
+    fn hegel_agent_assignment_doesnt_affect_content(tc: hegel::TestCase) {
+        // Each step with the index of the agent who performs it on the multi-agent document.
+        let ops = tc.draw(generators::vecs(hegel::tuples!(
+            script_op(),
+            generators::integers::<usize>().max_value(2)
+        )).max_size(20));
+
+        let mut doc_single = ListCRDT::new();
+        let single_agent = doc_single.get_or_create_agent_id("solo");
+
+        let mut doc_multi = ListCRDT::new();
+        let multi_agents: Vec<AgentId> = ["alice", "bob", "čarol 😀"].iter()
+            .map(|name| doc_multi.get_or_create_agent_id(name))
+            .collect();
+
+        let mut model: Vec<char> = Vec::new();
+
+        for (op, which) in &ops {
+            let Some(op) = fit(op, model.len()) else { continue };
+            apply_to_model(&mut model, &op);
+            apply_script_op(&mut doc_single, single_agent, &op);
+            apply_script_op(&mut doc_multi, multi_agents[*which], &op);
+
+            assert_eq!(doc_single.branch.content, doc_multi.branch.content);
+        }
+
+        let expected: String = model.iter().collect();
+        assert_eq!(doc_single.branch.content.to_string(), expected);
+        assert_eq!(doc_multi.branch.content.to_string(), expected);
+        doc_single.dbg_check(true);
+        doc_multi.dbg_check(true);
