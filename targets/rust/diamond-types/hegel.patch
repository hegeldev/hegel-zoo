+// ---- Hegel property-based tests ----
+//
+// Each property draws its case as data - scripts of `Change` records for the history, a record
+// for the encoding options, a list of `Mutation` records for the corruption - and builds the
+// document and the bytes with pure functions, so a failing case prints as a small script rather
+// than a transcript of draws.
+
+use hegel::generators::{self, Generator};
+use hegel::{PrettyPrintable, PrintableGenerator};
+use crate::list_fuzzer_tools::hegel_tools::{apply_changes, changes, Change};
+
+/// The history of a document: a shared prefix of edits by agent 0, then edits made
+/// concurrently on two replicas (agent 0 on the first, agent 1 on the second) and merged back
+/// into the first.
+#[derive(Clone, Debug, PrettyPrintable)]
+struct History {
+    shared: Vec<Change>,
+    a: Vec<Change>,
+    b: Vec<Change>,
+}
+
+impl History {
+    /// Build the ListCRDT holding this history.
+    fn build(&self) -> ListCRDT {
+        let mut a = ListCRDT::new();
+        a.get_or_create_agent_id("agent 0"); // 0
+        a.get_or_create_agent_id("agent 1"); // 1
+
+        let mut b = ListCRDT::new();
+        b.get_or_create_agent_id("agent 0");
+        b.get_or_create_agent_id("agent 1");
+
+        // Shared prefix of history.
+        apply_changes(&mut a, 0, &self.shared);
+        b.oplog.add_missing_operations_from(&a.oplog);
+        b.branch.merge(&b.oplog, b.oplog.cg.version.as_ref());
+
+        // Concurrent edits on both replicas.
+        apply_changes(&mut a, 0, &self.a);
+        apply_changes(&mut b, 1, &self.b);
+
+        a.oplog.add_missing_operations_from(&b.oplog);
+        a.branch.merge(&a.oplog, a.oplog.cg.version.as_ref());
+        a
+    }
+}
+
+/// Up to four changes in each of the shared prefix and the two concurrent forks.
+fn history() -> impl PrintableGenerator<History> {
+    hegel::tuples!(changes(0, 4), changes(0, 4), changes(0, 4))
+        .map(|(shared, a, b)| History { shared, a, b })
+}
+
+/// Encode -> decode round trip: an oplog with arbitrary (possibly concurrent) history, encoded
+/// with full fidelity, must decode to an equivalent oplog with identical checkout text.
+#[hegel::test]
+fn hegel_encode_decode_roundtrip(tc: hegel::TestCase) {
+    let doc = tc.draw(history()).build();
+
+    let data = doc.oplog.encode(&EncodeOptions::full()
+        .store_deleted_content(true));
+    let decoded = ListOpLog::load_from(&data).unwrap();
+    decoded.dbg_check(true);
+
+    assert_eq!(decoded, doc.oplog);
+    assert_eq!(decoded.checkout_tip().content, doc.branch.content);
+}
+
+/// The EncodeOptions flags, and user data half the time.
+#[derive(Clone, Debug, PrettyPrintable)]
+struct Options {
+    store_start_branch_content: bool,
+    store_inserted_content: bool,
+    store_deleted_content: bool,
+    compress_content: bool,
+    user_data: Option<Vec<u8>>,
+}
+
+impl Options {
+    fn encode_options(&self) -> EncodeOptions<'_> {
+        let opts = EncodeOptions::full()
+            .store_start_branch_content(self.store_start_branch_content)
+            .store_inserted_content(self.store_inserted_content)
+            .store_deleted_content(self.store_deleted_content)
+            .compress_content(self.compress_content);
+        match &self.user_data {
+            Some(data) => opts.user_data(data),
+            None => opts,
+        }
+    }
+}
+
+fn options() -> impl PrintableGenerator<Options> {
+    hegel::tuples!(
+        generators::booleans(),
+        generators::booleans(),
+        generators::booleans(),
+        generators::booleans(),
+        generators::optional(generators::binary().max_size(64))
+    )
+    .map(|(store_start_branch_content, store_inserted_content, store_deleted_content,
+           compress_content, user_data)| Options {
+        store_start_branch_content,
+        store_inserted_content,
+        store_deleted_content,
+        compress_content,
+        user_data,
+    })
+}
+
+/// Generate the encoding *configuration* too, not just the payload: any combination of the
+/// EncodeOptions flags must produce bytes which decode without error, and which reproduce the
+/// document text whenever the inserted content was stored.
+#[hegel::test]
+fn hegel_encode_options_roundtrip(tc: hegel::TestCase) {
+    let (history, options) = tc.draw(hegel::tuples!(history(), options()));
+    let doc = history.build();
+
+    let bytes = doc.oplog.encode(&options.encode_options());
+    let decoded = ListOpLog::load_from(&bytes).unwrap();
+    decoded.dbg_check(true);
+
+    // The causal graph always round trips, whatever the options.
+    assert_eq!(decoded.cg.version, doc.oplog.cg.version);
+    assert_eq!(decoded.len(), doc.oplog.len());
+
+    if options.store_inserted_content {
+        // With inserted content stored, the checkout must reproduce the document text.
+        assert_eq!(decoded.checkout_tip().content, doc.branch.content);
+    }
+    if options.store_inserted_content && options.store_deleted_content {
+        // With everything stored, the whole oplog round trips.
+        assert_eq!(decoded, doc.oplog);
+    }
+}
+
+/// Incremental save/load: a snapshot plus a patch (encode_from the snapshot's version) must
+/// recompose, via decode_and_add, into the full oplog.
+#[hegel::test]
+fn hegel_encode_patch_composes(tc: hegel::TestCase) {
+    // The edits before the snapshot, and the edits the patch carries.
+    let (before, after) = tc.draw(hegel::tuples!(changes(0, 6), changes(0, 6)));
+    let mut doc = ListCRDT::new();
+    let agent = doc.get_or_create_agent_id("agent 0");
+
+    let opts = || EncodeOptions::full().store_deleted_content(true);
+
+    apply_changes(&mut doc, agent, &before);
+    let snapshot_bytes = doc.oplog.encode(&opts());
+    let snapshot_version = doc.oplog.cg.version.clone();
+
+    apply_changes(&mut doc, agent, &after);
+    let patch_bytes = doc.oplog.encode_from(&opts(), snapshot_version.as_ref());
+
+    let mut reassembled = ListOpLog::load_from(&snapshot_bytes).unwrap();
+    reassembled.decode_and_add(&patch_bytes).unwrap();
+    reassembled.dbg_check(true);
+
+    assert_eq!(reassembled, doc.oplog);
+    assert_eq!(reassembled.checkout_tip().content, doc.branch.content);
+}
