+// ---- Hegel property-based tests ----
+//
+// These mirror the seeded fuzzer above, but route all randomness through hegel so failing runs
+// shrink to a minimal sequence of operations.
+
+use hegel::generators::{self, Generator};
+use crate::AgentId;
+use crate::list_fuzzer_tools::hegel_tools::hegel_make_random_change;
+
+fn agent_name(i: usize) -> String {
+    format!("agent {}", i)
+}
+
+/// Set up `N` ListCRDT replicas which share an agent table (agent id == replica index), so
+/// concurrent edits from different replicas never reuse an (agent, seq) pair.
+fn make_docs<const N: usize>() -> [ListCRDT; N] {
+    let mut docs: [ListCRDT; N] = std::array::from_fn(|_| ListCRDT::new());
+    for doc in docs.iter_mut() {
+        for a in 0..N {
+            doc.get_or_create_agent_id(agent_name(a).as_str());
+        }
+    }
+    docs
+}
+
+/// Sync a pair of replicas by exchanging their oplogs both ways, then check they converged.
+fn sync_and_check(a: &mut ListCRDT, b: &mut ListCRDT) {
+    // Cloning sidesteps borrowing two array elements mutably at once. It doesn't affect the
+    // property: add_missing_operations_from only reads its argument.
+    let b_ops = b.oplog.clone();
+    a.oplog.add_missing_operations_from(&b_ops);
+    b.oplog.add_missing_operations_from(&a.oplog);
+
+    // Property (1): after exchanging ops, the oplogs are equivalent...
+    assert_eq!(a.oplog, b.oplog);
+
+    a.branch.merge(&a.oplog, a.oplog.cg.version.as_ref());
+    b.branch.merge(&b.oplog, b.oplog.cg.version.as_ref());
+
+    // Property (2): ...and merging them into each replica's branch yields identical text.
+    assert_eq!(a.branch.content, b.branch.content);
+}
+
+/// CRDT convergence: any interleaving of concurrent inserts/deletes on 3 replicas, synced
+/// pairwise in any order, must converge to identical oplogs and identical document text.
+#[hegel::test]
+fn hegel_concurrent_merge_converges(tc: hegel::TestCase) {
+    let mut docs = make_docs::<3>();
+
+    let rounds = tc.draw(generators::integers::<usize>().min_value(1).max_value(25));
+    for _ in 0..rounds {
+        // Generate some concurrent operations.
+        let num_changes = tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+        for _ in 0..num_changes {
+            let idx = tc.draw(generators::integers::<usize>().max_value(2));
+            hegel_make_random_change(&tc, &mut docs[idx], idx as AgentId);
+        }
+
+        // Sometimes sync a (drawn) pair of replicas. Skipping rounds lets the replicas diverge
+        // more deeply before merging.
+        if tc.draw(generators::booleans()) {
+            let a_idx = tc.draw(generators::integers::<usize>().max_value(2));
+            let b_idx = (a_idx + tc.draw(generators::integers::<usize>().min_value(1).max_value(2))) % 3;
+            let (a, b) = index_pair_mut(&mut docs, a_idx, b_idx);
+            sync_and_check(a, b);
+        }
+    }
+
+    // Finally sync everyone with everyone and check total convergence.
+    for i in 1..docs.len() {
+        let (a, b) = index_pair_mut(&mut docs, 0, i);
+        sync_and_check(a, b);
+    }
+    for i in 1..docs.len() {
+        let (a, b) = index_pair_mut(&mut docs, 0, i);
+        sync_and_check(a, b);
+        assert_eq!(a.oplog, b.oplog);
+        assert_eq!(a.branch.content, b.branch.content);
+    }
+
+    for doc in &docs {
+        doc.dbg_check(true);
+    }
+}
+
+fn index_pair_mut<T>(arr: &mut [T], i: usize, j: usize) -> (&mut T, &mut T) {
+    assert!(i != j);
+    if i < j {
+        let (lo, hi) = arr.split_at_mut(j);
+        (&mut lo[i], &mut hi[0])
+    } else {
+        let (lo, hi) = arr.split_at_mut(i);
+        (&mut hi[0], &mut lo[j])
+    }
+}
