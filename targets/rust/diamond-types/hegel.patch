+/// Helpers for the hegel property-based tests. These mirror `random_str` /
+/// `old_make_random_change` above, but the randomness is drawn as data - a `Change` record per
+/// edit, a `Vec<Change>` per script - and applied by pure functions with positions and lengths
+/// taken modulo the live document, so failures shrink to a minimal script instead of an opaque
+/// seed.
+#[cfg(test)]
+pub(crate) mod hegel_tools {
+    use hegel::generators::{self, Generator};
+    use hegel::{PrettyPrintable, PrintableGenerator};
+    use crate::list::{ListBranch, ListCRDT, ListOpLog};
+    use crate::{AgentId, LV};
+
+    /// Characters picked to sit on unicode boundaries: NUL, ASCII/latin-1 edges, the NEL / LS /
+    /// PS line separators, combining marks, ZWJ, noncharacters, the surrogate-range edges,
+    /// case-folding trouble (ß), and astral-plane characters up to char::MAX.
+    const BOUNDARY_CHARS: [char; 20] = [
+        '\0', '\u{7f}', '\u{80}', '\u{85}',
+        '\u{301}', '\u{200d}', '\u{2028}', '\u{2029}',
+        'ß', 'ẞ', '\u{fdd0}', '\u{fffd}', '\u{ffff}',
+        '\u{d7ff}', '\u{e000}', '😀', '\u{10190}', '\u{e0001}',
+        '\u{10fffe}', '\u{10ffff}',
+    ];
+
+    /// A single char: printable ASCII first (so counterexamples stay readable when the bug
+    /// isn't unicode-related), a unicode boundary case, or any codepoint at all. Surrogates
+    /// (0xd800..=0xdfff) aren't chars; they map to the replacement character.
+    pub(crate) fn chars() -> impl PrintableGenerator<char> + Send + Sync + 'static {
+        hegel::one_of!(
+            generators::integers::<u32>().min_value(0x20).max_value(0x7e)
+                .map(|n| char::from_u32(n).unwrap()),
+            generators::sampled_from(BOUNDARY_CHARS.to_vec()),
+            generators::integers::<u32>().max_value(0x10ffff)
+                .map(|n| char::from_u32(n).unwrap_or('\u{fffd}')),
+        )
+    }
+
+    /// A string of `min_len..=max_len` chars (not bytes).
+    pub(crate) fn content(min_len: usize, max_len: usize)
+                          -> impl PrintableGenerator<String> + Send + Sync + 'static {
+        generators::vecs(chars()).min_size(min_len).max_size(max_len)
+            .map(|chars: Vec<char>| chars.into_iter().collect::<String>())
+    }
+
+    /// One edit of a document: an insert of `content` at a position, or a delete of some chars
+    /// from a position. Positions and lengths are taken modulo the live document when the
+    /// change is applied (`apply_change_raw`), so any change fits any document (a delete of an
+    /// empty document is a no-op) and the shrinker can delete steps freely. `backwards` types
+    /// the insert in reverse one char at a time (like typing before the cursor) or backspaces
+    /// the deletion one char at a time, each op parented on the previous one.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    pub(crate) enum Change {
+        Insert { at: u32, content: String, backwards: bool },
+        Delete { at: u32, len: u32, backwards: bool },
+    }
+
+    /// A change: an insert of one to three chars (twice in three, so that documents have
+    /// content to delete more often than not - with an even split a quarter of the steps were
+    /// deletes of an empty document), or a delete of up to ten.
+    pub(crate) fn change() -> impl PrintableGenerator<Change> + Send + Sync + 'static {
+        let at = || generators::integers::<u32>().max_value(999);
+        let insert = || hegel::tuples!(at(), content(1, 3), generators::booleans())
+            .map(|(at, content, backwards)| Change::Insert { at, content, backwards });
+        hegel::one_of!(
+            insert(),
+            insert(),
+            hegel::tuples!(at(), generators::integers::<u32>().max_value(9), generators::booleans())
+                .map(|(at, len, backwards)| Change::Delete { at, len, backwards }),
+        )
+    }
+
+    /// A script of `min..=max` changes.
+    pub(crate) fn changes(min: usize, max: usize)
+                          -> impl PrintableGenerator<Vec<Change>> + Send + Sync + 'static {
+        generators::vecs(change()).min_size(min).max_size(max)
+    }
+
+    /// Hegel equivalent of `old_make_random_change_raw`: append `change` (its position and
+    /// length fitted to the document) to the oplog at the branch's version. Returns the LV of
+    /// the last appended operation, or None for a delete of an empty document.
+    pub(crate) fn apply_change_raw(change: &Change, oplog: &mut ListOpLog, branch: &ListBranch,
+                                   agent: AgentId) -> Option<LV> {
+        let doc_len = branch.len();
+        match change {
+            Change::Insert { at, content, backwards } => {
+                let pos = *at as usize % (doc_len + 1);
+                if !*backwards || content.chars().count() == 1 {
+                    Some(oplog.add_insert_at(agent, branch.local_frontier_ref(), pos, content))
+                } else {
+                    // Type the string in reverse, one character at a time.
+                    let mut frontier = branch.local_frontier();
+                    for c in content.chars().rev() {
+                        let mut buf = [0u8; 4];
+                        let str = c.encode_utf8(&mut buf);
+                        let v = oplog.add_insert_at(agent, frontier.as_ref(), pos, str);
+                        frontier.replace_with_1(v);
+                    }
+                    Some(frontier[0])
+                }
+            }
+            Change::Delete { .. } if doc_len == 0 => None,
+            Change::Delete { at, len, backwards } => {
+                let pos = *at as usize % doc_len;
+                let span = 1 + *len as usize % usize::min(10, doc_len - pos);
+                if !*backwards || span == 1 {
+                    // Using make_delete_op (rather than add_delete_without_content) preserves the
+                    // deleted content, which the encoding tests need.
+                    let op = branch.make_delete_op(pos..pos + span);
+                    Some(oplog.add_operations_at(agent, branch.local_frontier_ref(), &[op]))
+                } else {
+                    // Backspace each character individually.
+                    let mut frontier = branch.local_frontier();
+                    for i in (pos..pos + span).rev() {
+                        let op = branch.make_delete_op(i..i + 1);
+                        let v = oplog.add_operations_at(agent, frontier.as_ref(), &[op]);
+                        frontier.replace_with_1(v);
+                    }
+                    Some(frontier[0])
+                }
+            }
+        }
+    }
+
+    /// Hegel equivalent of `old_make_random_change`: apply one change to a ListCRDT.
+    pub(crate) fn apply_change(doc: &mut ListCRDT, agent: AgentId, change: &Change) {
+        if let Some(v) = apply_change_raw(change, &mut doc.oplog, &doc.branch, agent) {
+            doc.branch.merge(&doc.oplog, &[v]);
+        }
+    }
+
+    /// Apply a script of changes in turn.
+    pub(crate) fn apply_changes(doc: &mut ListCRDT, agent: AgentId, changes: &[Change]) {
+        for change in changes {
+            apply_change(doc, agent, change);
+        }
+    }
+}
