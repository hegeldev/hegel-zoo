+/// Decoding arbitrary garbage must return an error, never panic. (Parse robustness for
+/// `ListOpLog::load_from`.)
+#[hegel::test]
+fn hegel_load_from_garbage_never_panics(tc: hegel::TestCase) {
+    // The file magic ("DMNDTYPS" + protocol version 0), so a good share of inputs get past the
+    // header check into the chunk parser.
+    const MAGIC: &[u8] = &[68, 77, 78, 68, 84, 89, 80, 83, 0];
+
+    let (magic, garbage) = tc.draw(hegel::tuples!(
+        generators::booleans(),
+        generators::binary().max_size(256)
+    ));
+    let bytes: Vec<u8> = if magic { [MAGIC, &garbage].concat() } else { garbage };
+
+    // Must not panic. (Garbage this random should rarely parse, but if it does, the accepted
+    // oplog must at least be internally consistent.)
+    //
+    // KNOWN BUG (diamond-types/1): the decoder can panic on malformed input (see
+    // hegel_pinned_decode_corrupted_bytes_panics). Such an input is the known bug and nothing
+    // else can be checked on it, so it is rejected (none in a 3000-case probe).
+    // KNOWN BUG (diamond-types/3): a huge uncompressed length in the compressed-fields chunk
+    // aborts the process; rejected up front like the panic.
+    if declares_huge_uncompressed_len(&bytes) {
+        tc.reject();
+    }
+    let bytes_ref = &bytes;
+    match std::panic::catch_unwind(move || ListOpLog::load_from(bytes_ref)) {
+        Ok(Ok(decoded)) => decoded.dbg_check(true),
+        Ok(Err(_)) => {} // Rejecting garbage is the expected outcome.
+        Err(_) => tc.reject(),
+    }
+}
