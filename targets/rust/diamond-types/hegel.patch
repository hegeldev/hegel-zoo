+/// A corruption of the encoded bytes, its position taken modulo the live length when applied:
+/// a byte flipped (a no-op on empty bytes), a truncation, garbage spliced in.
+#[derive(Clone, Debug, PrettyPrintable)]
+enum Mutation {
+    Flip { at: u32 },
+    Truncate { keep: u32 },
+    Splice { at: u32, garbage: Vec<u8> },
+}
+
+impl Mutation {
+    fn apply(&self, bytes: &mut Vec<u8>) {
+        match self {
+            Mutation::Flip { .. } if bytes.is_empty() => {}
+            Mutation::Flip { at } => {
+                let i = *at as usize % bytes.len();
+                bytes[i] = !bytes[i];
+            }
+            Mutation::Truncate { keep } => bytes.truncate(*keep as usize % (bytes.len() + 1)),
+            Mutation::Splice { at, garbage } => {
+                let i = *at as usize % (bytes.len() + 1);
+                bytes.splice(i..i, garbage.iter().copied());
+            }
+        }
+    }
+}
+
+fn mutation() -> impl PrintableGenerator<Mutation> {
+    let at = || generators::integers::<u32>().max_value(9999);
+    hegel::one_of!(
+        at().map(|at| Mutation::Flip { at }),
+        at().map(|keep| Mutation::Truncate { keep }),
+        hegel::tuples!(at(), generators::binary().min_size(1).max_size(8))
+            .map(|(at, garbage)| Mutation::Splice { at, garbage }),
+    )
+}
+
+/// Corrupt an encoded document arbitrarily. Decoding the corrupted bytes must never panic, and
+/// when it errors, it must leave the target oplog untouched (matching `error_unrolling` above).
+#[hegel::test]
+fn hegel_corrupt_decode_errors_or_unrolls(tc: hegel::TestCase) {
+    let (known, newer, mutations) = tc.draw(hegel::tuples!(
+        changes(0, 4),
+        changes(0, 4),
+        generators::vecs(mutation()).min_size(1).max_size(4)
+    ));
+    let mut doc = ListCRDT::new();
+    let agent = doc.get_or_create_agent_id("agent 0");
+
+    // Some history the decode target already knows about...
+    apply_changes(&mut doc, agent, &known);
+    let base_oplog = doc.oplog.clone();
+
+    // ...and some newer history which (only) the encoded bytes carry.
+    apply_changes(&mut doc, agent, &newer);
+    let bytes = doc.oplog.encode(&EncodeOptions::full().store_deleted_content(true));
+
+    // Corrupt the bytes: byte flips, truncation, and/or splicing in garbage.
+    let mut corrupted = bytes.clone();
+    for mutation in &mutations {
+        mutation.apply(&mut corrupted);
+    }
+
+    // KNOWN BUG (diamond-types/3): a corrupted uncompressed length in the compressed-fields
+    // chunk makes the decoder allocate that many bytes and abort the whole process (see
+    // hegel_pinned_huge_compressed_length_aborts below); an abort cannot be caught, so the
+    // shape is recognised up front and rejected (about one case in ten thousand).
+    if declares_huge_uncompressed_len(&corrupted) {
+        tc.reject();
+    }
+
+    let mut target = base_oplog.clone();
+    let result = {
+        // KNOWN BUG (diamond-types/1): decoding corrupted data can panic instead of returning
+        // ParseError (see hegel_pinned_decode_corrupted_bytes_panics below). Such an input has
+        // no verdict on the unrolling contract, so it is rejected here (0.3% of cases in a
+        // 3000-case probe) and this property keeps checking the contract on everything else.
+        let mut target_ref = std::panic::AssertUnwindSafe(&mut target);
+        let corrupted_ref = &corrupted;
+        match std::panic::catch_unwind(move || {
+            target_ref.decode_and_add_opts(corrupted_ref, DecodeOptions { ignore_crc: false, verbose: false })
+        }) {
+            Ok(result) => result,
+            Err(_) => tc.reject(),
+        }
+    };
+    match result {
+        Err(_) => {
+            // A failed decode must unroll. The strict form of this (target == base_oplog) is
+            // violated by a KNOWN BUG pinned in hegel_pinned_failed_decode_must_unroll below
+            // (the unwind leaks agent assignment state), so here we only assert that the
+            // user-visible state didn't change.
+            assert_eq!(target.cg.version, base_oplog.cg.version);
+            assert_eq!(target.len(), base_oplog.len());
+        }
+        Ok(_) => {
+            // The corruption survived the checksum (eg it only hit the CRC chunk itself, or the
+            // mutations cancelled out). The result must still be internally consistent.
+            target.dbg_check(true);
+        }
+    }
+}
+
+/// KNOWN FAILURE: this test pins a real bug and fails deterministically. Do not "fix" the test.
+///
+/// Decoding malformed data panics instead of returning `ParseError`. Splicing a single byte
+/// into a valid encoding desynchronizes the history chunk from the version map built while
+/// reading the patches chunk, and `history_entry_map_and_truncate`
+/// (src/list/encoding/decode_oplog.rs:242) hits `RleVec::find_packed_with_offset` ->
+/// `Option::unwrap()` on None (src/rle/rle_vec.rs:191).
+///
+/// The file CRC cannot save us: it is only verified at the *end* of `decode_internal`
+/// (src/list/encoding/decode_oplog.rs:949), after all the chunks have already been parsed, so
+/// any panic reachable during parsing is reachable from corrupted / untrusted input.
+///
+/// Found by hegel via hegel_corrupt_decode_errors_or_unrolls; this deterministic version
+/// exhaustively splices one byte at every position so it fails on every run.
+#[test]
+fn hegel_pinned_decode_corrupted_bytes_panics() {
+    let mut doc = ListCRDT::new();
+    let agent = doc.get_or_create_agent_id("agent 0");
+    doc.insert(agent, 0, "\0");
+    let bytes = doc.oplog.encode(&EncodeOptions::full().store_deleted_content(true));
+
+    // Splice a single byte at every position, and try to load each corrupted file.
+    let mut panics = Vec::new();
+    let prev_hook = std::panic::take_hook();
+    std::panic::set_hook(Box::new(|_| {})); // Quiet the expected panic spam.
+    for i in 0..=bytes.len() {
+        for b in [0u8, 2, 0xff] {
+            let mut corrupted = bytes.clone();
+            corrupted.splice(i..i, [b]);
+            if std::panic::catch_unwind(|| {
+                drop(ListOpLog::load_from(&corrupted));
+            }).is_err() {
+                panics.push((i, b));
+            }
+        }
+    }
+    std::panic::set_hook(prev_hook);
+
+    assert!(panics.is_empty(),
+        "ListOpLog::load_from panicked (instead of returning ParseError) for {} corrupted \
+         inputs, eg (splice position, byte value) = {:?}",
+        panics.len(), &panics[..panics.len().min(5)]);
+}
+
+/// diamond-types/3 helper: does this encoding declare an uncompressed length for its
+/// CompressedFieldsLZ4 chunk far beyond anything these tests encode (a few kilobytes)?
+/// Walks only the header and the first chunk, like decode_internal does before decompressing.
+fn declares_huge_uncompressed_len(data: &[u8]) -> bool {
+    const HUGE: usize = 1 << 26;
+    let mut reader = decode_tools::BufReader(data);
+    if reader.read_magic().is_err() || reader.next_usize().is_err() {
+        return false;
+    }
+    let mut chunks = reader.chunks();
+    match chunks.read_chunk_if_eq(ListChunkType::CompressedFieldsLZ4) {
+        Ok(Some(mut chunk)) => chunk.next_usize().map_or(false, |n| n > HUGE),
+        _ => false,
+    }
+}
+
+/// diamond-types/3: decode_and_add_opts on a 45-byte corrupted encoding (a valid header, a
+/// CompressedFieldsLZ4 chunk whose uncompressed length varint reads as about 2.4e14) asks
+/// lz4_flex::decompress for a buffer of that size and the process aborts with "memory
+/// allocation of ... bytes failed" instead of returning ParseError. The abort cannot be caught,
+/// so the decode runs in a child process (this test binary, re-run on this test with
+/// DIAMOND_TYPES_ZOO_CHILD set) and the parent asserts the child exited normally.
+///
+/// Found by hegel via hegel_corrupt_decode_errors_or_unrolls (a 3000-case run, byte flips on
+/// the chunk's length varint).
+#[test]
+fn hegel_pinned_huge_compressed_length_aborts() {
+    const CHILD: &str = "DIAMOND_TYPES_ZOO_CHILD";
+    const HEX: &str = "444d4e445459505300051ce4e0f48fbfbe36f0a89f8b76de30d1b30e0090e1ba9ef48fbfbfc29e010a03080761";
+    let bytes: Vec<u8> = (0..HEX.len()).step_by(2).map(|i| u8::from_str_radix(&HEX[i..i + 2], 16).unwrap()).collect();
+    if std::env::var_os(CHILD).is_some() {
+        let mut oplog = ListOpLog::new();
+        let _ = oplog.decode_and_add_opts(&bytes, DecodeOptions { ignore_crc: false, verbose: false });
+        return;
+    }
+    let status = std::process::Command::new(std::env::current_exe().unwrap())
+        .args(["--exact", "list::encoding::tests::hegel_pinned_huge_compressed_length_aborts", "--test-threads=1"])
+        .env(CHILD, "1")
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .status()
+        .unwrap();
+    assert!(status.success(), "decoding the corrupted bytes killed the child process ({status}); a ParseError was expected");
+}
+
+/// KNOWN FAILURE: this test pins a real bug and fails deterministically. Do not "fix" the test.
+///
+/// When `decode_and_add` fails, it must leave the oplog exactly as it was.
+/// `decode_and_add_opts` says so itself: "when an error happens we need to unwind all the
+/// merged operations before returning. Otherwise self is in an invalid state"
+/// (src/list/encoding/decode_oplog.rs:476), and the existing `error_unrolling` test asserts
+/// exactly this for a fresh (empty) target oplog.
+///
+/// But when the target *already knows a prefix* of the encoded operations, the unwind is
+/// incomplete: `client_data[agent].lv_for_seq` keeps the seq -> LV mappings assigned during the
+/// failed decode (the unwind loop in decode_and_add_opts, src/list/encoding/decode_oplog.rs:500,
+/// removes the wrong / no seq range from lv_for_seq). The oplog is left claiming seqs map to
+/// local versions which don't exist, so later edits by that agent can silently collide.
+///
+/// Repro: an oplog A with one op; encode an extension of A (one more op); flip one byte so the
+/// decode fails on the CRC check; decode_and_add into A errors but leaves lv_for_seq covering
+/// both ops while A.len() == 1.
+///
+/// Found by hegel via hegel_corrupt_decode_errors_or_unrolls; this deterministic version flips
+/// every byte in turn so it fails on every run.
+#[test]
+fn hegel_pinned_failed_decode_must_unroll() {
+    let mut doc = ListCRDT::new();
+    let agent = doc.get_or_create_agent_id("agent 0");
+    doc.insert(agent, 0, "\0");
+    let base = doc.oplog.clone(); // The decode target already knows this operation...
+    doc.delete(agent, 0..1);      // ...but not this one.
+    let bytes = doc.oplog.encode(&EncodeOptions::full().store_deleted_content(true));
+
+    let mut violations = Vec::new();
+    let prev_hook = std::panic::take_hook();
+    std::panic::set_hook(Box::new(|_| {})); // Quiet panics from the separately-pinned panic bug.
+    for i in 0..bytes.len() {
+        let mut corrupted = bytes.clone();
+        corrupted[i] = !corrupted[i];
+
+        let mut target = base.clone();
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            target.decode_and_add_opts(&corrupted, DecodeOptions { ignore_crc: false, verbose: false })
+        }));
+        match result {
+            // Decoder panic: a different bug, pinned in hegel_pinned_decode_corrupted_bytes_panics.
+            Err(_) => continue,
+            Ok(Err(_)) => {
+                if target != base { violations.push(i); }
+            }
+            Ok(Ok(_)) => {} // Corruption survived (eg it hit the optional CRC chunk). Fine here.
+        }
+    }
+    std::panic::set_hook(prev_hook);
+
+    assert!(violations.is_empty(),
+        "decode_and_add errored but left the oplog modified for {} corrupted inputs \
+         (byte-flip positions {:?})",
+        violations.len(), &violations[..violations.len().min(5)]);
+}
