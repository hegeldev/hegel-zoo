+// Hegel property-based tests for the tokenizer.
+//
+// (cfg(test) is required — unlike `mod tests` above — because hegel is a
+// dev-dependency and is not available in normal builds.)
+//
+// The generators are values: a text comes from `one_of!` over whole tokens
+// and a syntax-alphabet regex, paired with a version by `tuples!` and kept by
+// a `filter` when it lexes cleanly; a symbol case is one `tuples!` draw.
+#[cfg(test)]
+mod property_tests {
+    use crate::{
+        ast::LuaVersion,
+        tokenizer::{Lexer, LexerResult, Token, TokenKind, TokenReference},
+    };
+    use hegel::generators::{self, Generator};
+    use hegel::PrintableGenerator;
+
+    /// An arbitrary LuaVersion built from whatever version features this
+    /// build enables: one flag per feature, Lua 5.1 alone when none is set.
+    /// (Duplicates tests/common/mod.rs's lua_gen helper — the
+    /// integration-test module is not visible from unit tests. Without the
+    /// optional features the flags are unused.)
+    fn lua_version() -> impl PrintableGenerator<LuaVersion> {
+        let flag = generators::booleans;
+        hegel::tuples!(flag(), flag(), flag(), flag(), flag(), flag())
+            .map(|(luau, lua52, lua53, lua54, luajit, cfxlua)| {
+                let _ = (luau, lua52, lua53, lua54, luajit, cfxlua);
+                #[allow(unused_mut)] // `mut` is only needed when version features are enabled
+                let mut version = LuaVersion::lua51();
+
+                #[cfg(feature = "luau")]
+                if luau {
+                    version = version.with_luau();
+                }
+
+                #[cfg(feature = "lua52")]
+                if lua52 {
+                    version = version.with_lua52();
+                }
+
+                #[cfg(feature = "lua53")]
+                if lua53 {
+                    version = version.with_lua53();
+                }
+
+                #[cfg(feature = "lua54")]
+                if lua54 {
+                    version = version.with_lua54();
+                }
+
+                #[cfg(feature = "luajit")]
+                if luajit {
+                    version = version.with_luajit();
+                }
+
+                #[cfg(feature = "cfxlua")]
+                if cfxlua {
+                    version = version.with_cfxlua();
+                }
+
+                version
+            })
+            .print_as_debug()
+    }
+
+    /// KNOWN FAILURE (real bug): lexing a backtick must return a tokenizer
+    /// error for versions where backtick strings are not a feature — but it
+    /// does not:
+    ///
+    /// - Without the `cfxlua` feature, `Lexer::process_next` (lexer.rs, the
+    ///   `'"' | '\'' | '`'` quote arm) sends `` ` `` into `read_string`,
+    ///   whose quote-type match only covers `` ` `` under
+    ///   `#[cfg(feature = "cfxlua")]` — so it panics with "internal error:
+    ///   entered unreachable code" (lexer.rs:1210). `full_moon::parse("`")`
+    ///   panics instead of returning Err, violating the documented contract.
+    /// - With the `cfxlua` feature, the quote arm never checks
+    ///   `lua_version.has_cfxlua()` (unlike the interpolated-string path,
+    ///   which checks `has_luau()`), so `LuaVersion::lua51()` silently
+    ///   accepts backtick strings as valid.
+    ///
+    /// Sibling properties exclude backticks from their inputs and reference
+    /// this test. The input is a *closed* backtick string so the test fails
+    /// deterministically under every feature configuration (panic without
+    /// cfxlua, wrongly-accepted with cfxlua).
+    #[test]
+    fn lexing_backtick_returns_error_for_lua51() {
+        let result = Lexer::new("local x = `a`", LuaVersion::lua51()).collect();
+        assert!(
+            !matches!(result, LexerResult::Ok(_)),
+            "backtick strings are not Lua 5.1, so lexing should report an error"
+        );
+    }
+
+    /// Whole tokens of Lua's lexical grammar: trivia (a space first, so a
+    /// shrunk input is blank), names, numbers, strings (one with an e-acute,
+    /// two with escaped quotes, two long ones), comments (one with a
+    /// snowman), symbols and keywords. Text made of them lexes cleanly in
+    /// nearly every order.
+    #[rustfmt::skip]
+    const PIECES: &[&str] = &[
+        " ", "\t", "\n", "\r\n",
+        "x", "foo", "_v",
+        "42", "3.14", "0xAB", "1e5", "0.5",
+        "\"s\"", "'a'", "\"h\u{e9}llo\"", "\"a\\\"b\"", "'it\\'s'", "[[long\nstring]]", "[==[ ]] ]==]",
+        "-- c\n", "--[[ b\n \u{2603} ]]", "--",
+        "+", "-", "*", "/", "%", "^", "#", "==", "~=", "<=", ">=", "<", ">", "=",
+        "(", ")", "{", "}", "[", "]", ";", ":", ",", ".", "..", "...",
+        "local", "end", "if", "then", "and", "not", "or", "return", "function",
+    ];
+
+    /// Text biased toward the characters Lua source is made of, so that
+    /// inputs lex cleanly (LexerResult::Ok) and exercise the roundtrip and
+    /// tiling assertions rather than the error path: up to twelve whole
+    /// tokens, or up to forty characters of Lua's syntax alphabet (without
+    /// quotes, which would leave half the strings unterminated; the token
+    /// pool supplies the strings).
+    fn lexable_text() -> impl PrintableGenerator<String> {
+        hegel::one_of!(
+            generators::vecs(generators::sampled_from(PIECES))
+                .max_size(12)
+                .map(|pieces| pieces.concat()),
+            generators::from_regex(r#"[a-zA-Z0-9_ \t\n+*/%^#=<>(){};:,.\[\]-]{0,40}"#)
+                .fullmatch(true),
+        )
+    }
+
+    /// A text and a version under which it lexes cleanly. The filter keeps
+    /// about 98% of the drawn pairs (a probe of 3000 draws rejected 1.7% of
+    /// the token texts and 1.9% of the alphabet texts: a `[[` left open, a
+    /// malformed number such as `0E<`), so the properties below run on clean
+    /// lexes and their guard never fires.
+    fn lexable_case() -> impl PrintableGenerator<(String, LuaVersion)> {
+        hegel::tuples!(lexable_text(), lua_version()).filter(|(source, version)| {
+            matches!(Lexer::new(source, *version).collect(), LexerResult::Ok(_))
+        })
+    }
+
+    /// The lexer must handle any input text without panicking, whatever the
+    /// LuaVersion — bad input is reported through LexerResult, never a crash.
+    ///
+    /// Backticks are excluded from the input: they DO panic the lexer — see
+    /// the canonical KNOWN FAILURE test
+    /// `lexing_backtick_returns_error_for_lua51`.
+    #[hegel::test]
+    fn lexer_never_panics_on_arbitrary_text(tc: hegel::TestCase) {
+        let (source, version) = tc.draw(hegel::tuples!(
+            generators::text().exclude_characters("`"),
+            lua_version()
+        ));
+        drop(Lexer::new(&source, version).collect());
+    }
+
+    /// Losslessness at the token level: when the lexer tokenizes a string
+    /// cleanly, reprinting every token in order must reproduce the input
+    /// byte-for-byte.
+    #[hegel::test]
+    fn lexer_tokens_reprint_to_source(tc: hegel::TestCase) {
+        let (source, version) = tc.draw(lexable_case());
+        let LexerResult::Ok(tokens) = Lexer::new(&source, version).collect() else {
+            // The generator keeps only text that lexes cleanly; this guard never fires.
+            tc.reject()
+        };
+        let reprinted: String = tokens.iter().map(Token::to_string).collect();
+        assert_eq!(reprinted, source);
+    }
+
+    /// Token positions from a clean lex must tile the source exactly: the
+    /// first token starts at byte 0, every token starts where the previous
+    /// one ended, each token's byte range slices the source to that token's
+    /// own text, and the trailing Eof ends at source.len().
+    #[hegel::test]
+    fn lexer_token_positions_tile_the_source(tc: hegel::TestCase) {
+        let (source, version) = tc.draw(lexable_case());
+        let LexerResult::Ok(tokens) = Lexer::new(&source, version).collect() else {
+            // The generator keeps only text that lexes cleanly; this guard never fires.
+            tc.reject()
+        };
+
+        let mut offset = 0;
+        for token in &tokens {
+            assert_eq!(
+                token.start_position().bytes(),
+                offset,
+                "token {token:?} does not start where the previous token ended"
+            );
+            let end = token.end_position().bytes();
+            assert_eq!(
+                &source[offset..end],
+                token.to_string(),
+                "token {token:?}'s byte range does not slice to its own text"
+            );
+            offset = end;
+        }
+
+        let eof = tokens.last().expect("lexer always produces at least Eof");
+        assert_eq!(eof.token_kind(), TokenKind::Eof);
+        assert_eq!(offset, source.len());
+    }
+
+    /// Symbols valid in all versions (the Lua 5.1 set).
+    const SYMBOLS: &[&str] = &[
+        "and", "break", "do", "else", "elseif", "end", "false", "for", "function", "if", "in",
+        "local", "nil", "not", "or", "repeat", "return", "then", "true", "until", "while", "^",
+        ":", ",", ".", "..", "...", "=", "==", ">", ">=", "#", "{", "[", "(", "<", "<=", "-", "%",
+        "+", "}", "]", ")", ";", "/", "*", "~=",
+    ];
+
+    /// Up to four spaces, tabs and newlines.
+    fn whitespace() -> impl PrintableGenerator<String> {
+        generators::text().alphabet(" \t\n").max_size(4)
+    }
+
+    /// TokenReference::symbol_specific_lua_version documents that it accepts
+    /// a symbol surrounded by whitespace, storing the whitespace as trivia —
+    /// so the constructed TokenReference must display as the exact input.
+    #[hegel::test]
+    fn symbol_with_whitespace_roundtrips(tc: hegel::TestCase) {
+        let (leading, symbol, trailing) = tc.draw(hegel::tuples!(
+            whitespace(),
+            generators::sampled_from(SYMBOLS),
+            whitespace()
+        ));
+
+        let text = format!("{leading}{symbol}{trailing}");
+        let token_reference =
+            TokenReference::symbol_specific_lua_version(&text, LuaVersion::lua51())
+                .unwrap_or_else(|error| panic!("symbol {text:?} was rejected: {error}"));
+
+        assert_eq!(token_reference.to_string(), text);
+    }
+}
