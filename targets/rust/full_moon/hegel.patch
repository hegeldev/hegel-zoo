+
+/// Property-test generators for structurally valid Lua source and for
+/// `LuaVersion` configurations. Used by the hegel property-based tests in
+/// pass_cases.rs, fail_cases.rs, and visitors.rs.
+///
+/// The generated code is deliberately conservative: it sticks to the Lua 5.1
+/// core grammar (which every version full-moon supports is a superset of), so
+/// that the same generated chunk can be parsed under any `LuaVersion`
+/// configuration.
+///
+/// The generators are values. A chunk is drawn as a syntax tree (`Chunk`,
+/// `Block`, `Stmt`, `Expr`, ...): expressions come from `recursive()` over
+/// the scalar leaves, blocks from `recursive()` over the statements without a
+/// body of their own. Beside the tree the chunk carries two tapes of
+/// inter-token trivia, and a pure writer renders the tree taking the trivia
+/// of each gap from the tapes in turn (recycled when exhausted, a single
+/// space when empty), so the source is a function of the drawn data. The
+/// plainest alternative comes first in every choice, so a shrunk chunk is
+/// `local x` with single spaces.
+pub mod lua_gen {
+    use full_moon::ast::LuaVersion;
+    use hegel::generators::{
+        self, BoxedPrintableGenerator, Generator, PrintableGenerator, SubtreeGenerator,
+    };
+
+    // ------------------------------------------------------------------ pools
+
+    /// Identifiers that are safe as plain names in every Lua version
+    /// full-moon supports: no keywords, no contextual keywords (`type`,
+    /// `continue`, `export`, `goto`), and none start with `v_` (the rename
+    /// involution test in tests/visitors.rs relies on that).
+    pub const IDENTIFIERS: &[&str] = &[
+        "x", "y", "foo", "bar", "baz", "qux", "abc", "res", "tbl", "num",
+    ];
+
+    /// Inter-token trivia: whitespace and comments. Never empty, so adjacent
+    /// tokens can never fuse (`- -`, `1 ..`, `and y`, ...); a single space
+    /// comes first (the shrink target) and most often.
+    const TRIVIA: &[&str] = &[
+        " ",
+        " ",
+        " ",
+        " ",
+        " ",
+        "  ",
+        "\t",
+        "\n",
+        "\n",
+        "\r\n",
+        " -- comment\n",
+        " --[[ block comment ]] ",
+        " --[==[ level two ]==] ",
+    ];
+
+    /// Trivia guaranteed to contain no newline (possibly empty). Used before
+    /// call arguments, where Lua treats `(` at the start of a new line as
+    /// ambiguous syntax.
+    const INLINE_TRIVIA: &[&str] = &["", "", "", " ", " ", "\t", " --[[ c ]] "];
+
+    const NUMBERS: &[&str] = &["0", "1", "42", "3.14", "0.5", "1e5", "2E-1", "0xAB"];
+
+    const STRINGS: &[&str] = &[
+        "\"hello\"",
+        "''",
+        "'a'",
+        "\"\"",
+        "[[long string]]",
+        "\"a\\nb\"",
+        "'it\\'s'",
+        "[==[ nested ]] here ]==]",
+    ];
+
+    const CONSTANTS: &[&str] = &["true", "false", "nil"];
+    const UNARY_OPS: &[&str] = &["-", "not", "#"];
+    const BINARY_OPS: &[&str] = &[
+        "+", "-", "*", "/", "%", "^", "..", "==", "~=", "<", "<=", ">", ">=", "and", "or",
+    ];
+    /// Table field separators.
+    const SEPARATORS: &[&str] = &[",", ";"];
+
+    fn ident() -> generators::SampledFromGenerator<'static, &'static str> {
+        generators::sampled_from(IDENTIFIERS)
+    }
+
+    // ------------------------------------------------------------------ the tree
+
+    /// An expression of core Lua 5.1.
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub enum Expr {
+        Number(&'static str),
+        Str(&'static str),
+        /// `true`, `false` or `nil`.
+        Constant(&'static str),
+        Name(&'static str),
+        Unary {
+            op: &'static str,
+            operand: Box<Expr>,
+        },
+        Binary {
+            lhs: Box<Expr>,
+            op: &'static str,
+            rhs: Box<Expr>,
+        },
+        Parens(Box<Expr>),
+        Prefix(Prefix),
+        Table(Table),
+        /// An anonymous function.
+        Function(FuncBody),
+    }
+
+    /// A prefix expression: an identifier followed by index and call
+    /// suffixes (`x`, `x.y`, `x[1]`, `x(1)`, `x:m "s"`).
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub struct Prefix {
+        name: &'static str,
+        suffixes: Vec<Suffix>,
+    }
+
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub enum Suffix {
+        Index(Index),
+        Call(Call),
+    }
+
+    /// `.name` or `[expr]`.
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub enum Index {
+        Dot(&'static str),
+        Bracket(Expr),
+    }
+
+    /// Call arguments, or a method call `:name args`.
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub struct Call {
+        method: Option<&'static str>,
+        args: Args,
+    }
+
+    /// `(a, b)`, a string literal, or a table constructor.
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub enum Args {
+        Parens(Vec<Expr>),
+        Str(&'static str),
+        Table(Table),
+    }
+
+    /// A table constructor: fields with the separator before each (unused
+    /// for the first) and an optional trailing separator (rendered only when
+    /// there are fields).
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub struct Table {
+        fields: Vec<TableField>,
+        trailing: Option<&'static str>,
+    }
+
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub struct TableField {
+        sep: &'static str,
+        field: Field,
+    }
+
+    /// `expr`, `name = expr` or `[expr] = expr`.
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub enum Field {
+        Positional(Expr),
+        Named { name: &'static str, value: Expr },
+        Keyed { key: Expr, value: Expr },
+    }
+
+    /// `(params) block end`: distinct parameter names, `...` last if set.
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub struct FuncBody {
+        params: Vec<&'static str>,
+        varargs: bool,
+        body: Block,
+    }
+
+    /// Statements, each with an optional `;`, and an optional `return`.
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub struct Block {
+        stmts: Vec<StmtLine>,
+        ret: Option<Return>,
+    }
+
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub struct StmtLine {
+        stmt: Stmt,
+        semicolon: bool,
+    }
+
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub struct Return {
+        values: Vec<Expr>,
+        semicolon: bool,
+    }
+
+    /// An assignable: `x`, `x.y` or `x[expr]`.
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub enum Var {
+        Name(&'static str),
+        Dot(&'static str, &'static str),
+        Bracket(&'static str, Expr),
+    }
+
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub struct ElseIf {
+        cond: Expr,
+        body: Block,
+    }
+
+    /// A statement of core Lua 5.1.
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub enum Stmt {
+        /// `local a, b` or `local a, b = 1, 2` (no `=` when `values` is empty).
+        Local {
+            names: Vec<&'static str>,
+            values: Vec<Expr>,
+        },
+        Assign {
+            vars: Vec<Var>,
+            values: Vec<Expr>,
+        },
+        /// A prefix expression ending in a call.
+        Call {
+            prefix: Prefix,
+            call: Call,
+        },
+        Do(Block),
+        While {
+            cond: Expr,
+            body: Block,
+        },
+        Repeat {
+            body: Block,
+            cond: Expr,
+        },
+        If {
+            cond: Expr,
+            then: Block,
+            elseifs: Vec<ElseIf>,
+            otherwise: Option<Block>,
+        },
+        NumericFor {
+            var: &'static str,
+            start: Expr,
+            limit: Expr,
+            step: Option<Expr>,
+            body: Block,
+        },
+        GenericFor {
+            names: Vec<&'static str>,
+            iterators: Vec<Expr>,
+            body: Block,
+        },
+        LocalFunction {
+            name: &'static str,
+            body: FuncBody,
+        },
+        /// `function name[.field][:method] body`.
+        Function {
+            name: &'static str,
+            field: Option<&'static str>,
+            method: Option<&'static str>,
+            body: FuncBody,
+        },
+    }
+
+    /// A structurally valid Lua 5.1 chunk: a block, with trivia before and
+    /// after it when the flags are set, and the two trivia tapes the writer
+    /// reads the gaps between tokens from.
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub struct Chunk {
+        lead: bool,
+        block: Block,
+        trail: bool,
+        trivia: Vec<&'static str>,
+        inline: Vec<&'static str>,
+    }
+
+    // ------------------------------------------------------------------ the writer
+
+    /// The source so far and the two trivia tapes, each read in turn and
+    /// recycled; an empty tape gives a single space (or nothing before call
+    /// arguments).
+    struct Pen<'a> {
+        out: String,
+        trivia: &'a [&'static str],
+        inline: &'a [&'static str],
+        gaps: usize,
+        inline_gaps: usize,
+    }
+
+    impl Pen<'_> {
+        fn tok(&mut self, text: &str) {
+            self.out.push_str(text);
+        }
+
+        /// The trivia of the next gap between tokens.
+        fn ws(&mut self) {
+            let text = self
+                .trivia
+                .get(self.gaps % self.trivia.len().max(1))
+                .copied()
+                .unwrap_or(" ");
+            self.gaps += 1;
+            self.out.push_str(text);
+        }
+
+        /// The newline-free trivia of the next gap before call arguments.
+        fn inline(&mut self) {
+            let text = self
+                .inline
+                .get(self.inline_gaps % self.inline.len().max(1))
+                .copied()
+                .unwrap_or("");
+            self.inline_gaps += 1;
+            self.out.push_str(text);
+        }
+
+        /// `ws item (, ws item)*`: the shape of every list in the grammar but
+        /// the targets of an assignment.
+        fn list<T>(&mut self, items: &[T], write: impl Fn(&T, &mut Self)) {
+            for (i, item) in items.iter().enumerate() {
+                if i > 0 {
+                    self.tok(",");
+                }
+                self.ws();
+                write(item, self);
+            }
+        }
+
+        fn name(name: &&'static str, pen: &mut Self) {
+            pen.tok(name);
+        }
+    }
+
+    impl Expr {
+        fn write(&self, pen: &mut Pen) {
+            match self {
+                Expr::Number(s) | Expr::Str(s) | Expr::Constant(s) | Expr::Name(s) => pen.tok(s),
+                Expr::Unary { op, operand } => {
+                    pen.tok(op);
+                    pen.ws();
+                    operand.write(pen);
+                }
+                Expr::Binary { lhs, op, rhs } => {
+                    lhs.write(pen);
+                    pen.ws();
+                    pen.tok(op);
+                    pen.ws();
+                    rhs.write(pen);
+                }
+                Expr::Parens(inner) => {
+                    pen.tok("(");
+                    pen.ws();
+                    inner.write(pen);
+                    pen.ws();
+                    pen.tok(")");
+                }
+                Expr::Prefix(prefix) => prefix.write(pen),
+                Expr::Table(table) => table.write(pen),
+                Expr::Function(body) => {
+                    pen.tok("function");
+                    pen.ws();
+                    body.write(pen);
+                }
+            }
+        }
+    }
+
+    impl Prefix {
+        fn write(&self, pen: &mut Pen) {
+            pen.tok(self.name);
+            for suffix in &self.suffixes {
+                suffix.write(pen);
+            }
+        }
+    }
+
+    impl Suffix {
+        fn write(&self, pen: &mut Pen) {
+            match self {
+                Suffix::Index(Index::Dot(name)) => {
+                    pen.ws();
+                    pen.tok(".");
+                    pen.ws();
+                    pen.tok(name);
+                }
+                Suffix::Index(Index::Bracket(key)) => {
+                    pen.ws();
+                    pen.tok("[");
+                    pen.ws();
+                    key.write(pen);
+                    pen.ws();
+                    pen.tok("]");
+                }
+                Suffix::Call(call) => call.write(pen),
+            }
+        }
+    }
+
+    impl Call {
+        fn write(&self, pen: &mut Pen) {
+            if let Some(method) = self.method {
+                pen.ws();
+                pen.tok(":");
+                pen.ws();
+                pen.tok(method);
+            }
+            pen.inline();
+            self.args.write(pen);
+        }
+    }
+
+    impl Args {
+        fn write(&self, pen: &mut Pen) {
+            match self {
+                Args::Parens(values) => {
+                    pen.tok("(");
+                    pen.list(values, Expr::write);
+                    pen.ws();
+                    pen.tok(")");
+                }
+                Args::Str(s) => pen.tok(s),
+                Args::Table(table) => table.write(pen),
+            }
+        }
+    }
+
+    impl Table {
+        fn write(&self, pen: &mut Pen) {
+            pen.tok("{");
+            for (i, field) in self.fields.iter().enumerate() {
+                if i > 0 {
+                    pen.tok(field.sep);
+                }
+                pen.ws();
+                field.field.write(pen);
+            }
+            if let (false, Some(sep)) = (self.fields.is_empty(), self.trailing) {
+                pen.tok(sep);
+            }
+            pen.ws();
+            pen.tok("}");
+        }
+    }
+
+    impl Field {
+        fn write(&self, pen: &mut Pen) {
+            match self {
+                Field::Positional(value) => value.write(pen),
+                Field::Named { name, value } => {
+                    pen.tok(name);
+                    pen.ws();
+                    pen.tok("=");
+                    pen.ws();
+                    value.write(pen);
+                }
+                Field::Keyed { key, value } => {
+                    pen.tok("[");
+                    pen.ws();
+                    key.write(pen);
+                    pen.ws();
+                    pen.tok("]");
+                    pen.ws();
+                    pen.tok("=");
+                    pen.ws();
+                    value.write(pen);
+                }
+            }
+        }
+    }
+
+    impl FuncBody {
+        fn write(&self, pen: &mut Pen) {
+            let params: Vec<&'static str> = self
+                .params
+                .iter()
+                .copied()
+                .chain(self.varargs.then_some("..."))
+                .collect();
+            pen.tok("(");
+            pen.list(&params, Pen::name);
+            pen.ws();
+            pen.tok(")");
+            pen.ws();
+            self.body.write(pen);
+            pen.ws();
+            pen.tok("end");
+        }
+    }
+
+    impl Var {
+        fn write(&self, pen: &mut Pen) {
+            match self {
+                Var::Name(name) => pen.tok(name),
+                Var::Dot(table, field) => {
+                    pen.tok(table);
+                    pen.ws();
+                    pen.tok(".");
+                    pen.ws();
+                    pen.tok(field);
+                }
+                Var::Bracket(table, key) => {
+                    pen.tok(table);
+                    pen.ws();
+                    pen.tok("[");
+                    pen.ws();
+                    key.write(pen);
+                    pen.ws();
+                    pen.tok("]");
+                }
+            }
+        }
+    }
+
+    impl Block {
+        fn write(&self, pen: &mut Pen) {
+            for (i, line) in self.stmts.iter().enumerate() {
+                if i > 0 {
+                    pen.ws();
+                }
+                line.stmt.write(pen);
+                if line.semicolon {
+                    pen.tok(";");
+                }
+            }
+            if let Some(ret) = &self.ret {
+                if !self.stmts.is_empty() {
+                    pen.ws();
+                }
+                pen.tok("return");
+                pen.list(&ret.values, Expr::write);
+                if ret.semicolon {
+                    pen.tok(";");
+                }
+            }
+        }
+    }
+
+    /// `ws body ws end` after a statement's opening keywords.
+    fn write_body(body: &Block, pen: &mut Pen) {
+        pen.ws();
+        body.write(pen);
+        pen.ws();
+        pen.tok("end");
+    }
+
+    impl Stmt {
+        fn write(&self, pen: &mut Pen) {
+            match self {
+                Stmt::Local { names, values } => {
+                    pen.tok("local");
+                    pen.list(names, Pen::name);
+                    if !values.is_empty() {
+                        pen.ws();
+                        pen.tok("=");
+                        pen.list(values, Expr::write);
+                    }
+                }
+                Stmt::Assign { vars, values } => {
+                    for (i, var) in vars.iter().enumerate() {
+                        if i > 0 {
+                            pen.tok(",");
+                            pen.ws();
+                        }
+                        var.write(pen);
+                    }
+                    pen.ws();
+                    pen.tok("=");
+                    pen.list(values, Expr::write);
+                }
+                Stmt::Call { prefix, call } => {
+                    prefix.write(pen);
+                    call.write(pen);
+                }
+                Stmt::Do(body) => {
+                    pen.tok("do");
+                    write_body(body, pen);
+                }
+                Stmt::While { cond, body } => {
+                    pen.tok("while");
+                    pen.ws();
+                    cond.write(pen);
+                    pen.ws();
+                    pen.tok("do");
+                    write_body(body, pen);
+                }
+                Stmt::Repeat { body, cond } => {
+                    pen.tok("repeat");
+                    pen.ws();
+                    body.write(pen);
+                    pen.ws();
+                    pen.tok("until");
+                    pen.ws();
+                    cond.write(pen);
+                }
+                Stmt::If {
+                    cond,
+                    then,
+                    elseifs,
+                    otherwise,
+                } => {
+                    pen.tok("if");
+                    pen.ws();
+                    cond.write(pen);
+                    pen.ws();
+                    pen.tok("then");
+                    pen.ws();
+                    then.write(pen);
+                    for elseif in elseifs {
+                        pen.ws();
+                        pen.tok("elseif");
+                        pen.ws();
+                        elseif.cond.write(pen);
+                        pen.ws();
+                        pen.tok("then");
+                        pen.ws();
+                        elseif.body.write(pen);
+                    }
+                    if let Some(body) = otherwise {
+                        pen.ws();
+                        pen.tok("else");
+                        pen.ws();
+                        body.write(pen);
+                    }
+                    pen.ws();
+                    pen.tok("end");
+                }
+                Stmt::NumericFor {
+                    var,
+                    start,
+                    limit,
+                    step,
+                    body,
+                } => {
+                    pen.tok("for");
+                    pen.ws();
+                    pen.tok(var);
+                    pen.ws();
+                    pen.tok("=");
+                    pen.ws();
+                    start.write(pen);
+                    pen.tok(",");
+                    pen.ws();
+                    limit.write(pen);
+                    if let Some(step) = step {
+                        pen.tok(",");
+                        pen.ws();
+                        step.write(pen);
+                    }
+                    pen.ws();
+                    pen.tok("do");
+                    write_body(body, pen);
+                }
+                Stmt::GenericFor {
+                    names,
+                    iterators,
+                    body,
+                } => {
+                    pen.tok("for");
+                    pen.list(names, Pen::name);
+                    pen.ws();
+                    pen.tok("in");
+                    pen.list(iterators, Expr::write);
+                    pen.ws();
+                    pen.tok("do");
+                    write_body(body, pen);
+                }
+                Stmt::LocalFunction { name, body } => {
+                    pen.tok("local");
+                    pen.ws();
+                    pen.tok("function");
+                    pen.ws();
+                    pen.tok(name);
+                    pen.ws();
+                    body.write(pen);
+                }
+                Stmt::Function {
+                    name,
+                    field,
+                    method,
+                    body,
+                } => {
+                    pen.tok("function");
+                    pen.ws();
+                    pen.tok(name);
+                    if let Some(field) = field {
+                        pen.ws();
+                        pen.tok(".");
+                        pen.ws();
+                        pen.tok(field);
+                    }
+                    if let Some(method) = method {
+                        pen.ws();
+                        pen.tok(":");
+                        pen.ws();
+                        pen.tok(method);
+                    }
+                    pen.ws();
+                    body.write(pen);
+                }
+            }
+        }
+    }
+
+    impl Chunk {
+        /// The chunk's source text.
+        pub fn render(&self) -> String {
+            let mut pen = Pen {
+                out: String::new(),
+                trivia: &self.trivia,
+                inline: &self.inline,
+                gaps: 0,
+                inline_gaps: 0,
+            };
+            if self.lead {
+                pen.ws();
+            }
+            self.block.write(&mut pen);
+            if self.trail {
+                pen.ws();
+            }
+            pen.out
+        }
+    }
+
+    // ------------------------------------------------------------------ generators
+
+    /// The expression generator the statement generators draw from: the
+    /// whole `expr()` at the top level, the sub-expression generator of the
+    /// enclosing `recursive()` inside a function expression.
+    type Exprs = BoxedPrintableGenerator<'static, Expr>;
+
+    /// `min` to `max` expressions.
+    fn exprs(e: &Exprs, min: usize, max: usize) -> impl PrintableGenerator<Vec<Expr>> {
+        generators::vecs(e.clone()).min_size(min).max_size(max)
+    }
+
+    /// One to `max` identifiers.
+    fn names(max: usize) -> impl PrintableGenerator<Vec<&'static str>> {
+        generators::vecs(ident()).min_size(1).max_size(max)
+    }
+
+    /// A scalar expression: a number, a string, a constant, or (twice as
+    /// often) a name.
+    fn leaf() -> impl PrintableGenerator<Expr> {
+        let name = || ident().map(Expr::Name);
+        hegel::one_of!(
+            generators::sampled_from(NUMBERS).map(Expr::Number),
+            generators::sampled_from(STRINGS).map(Expr::Str),
+            generators::sampled_from(CONSTANTS).map(Expr::Constant),
+            name(),
+            name(),
+        )
+    }
+
+    /// Call arguments: parentheses (twice as often), a string, a table.
+    fn args(e: &Exprs) -> impl PrintableGenerator<Args> {
+        let parens = || exprs(e, 0, 2).map(Args::Parens);
+        hegel::one_of!(
+            parens(),
+            parens(),
+            generators::sampled_from(STRINGS).map(Args::Str),
+            table(e).map(Args::Table),
+        )
+    }
+
+    fn call(e: &Exprs) -> impl PrintableGenerator<Call> {
+        hegel::tuples!(generators::optional(ident()), args(e))
+            .map(|(method, args)| Call { method, args })
+    }
+
+    fn suffix(e: &Exprs) -> impl PrintableGenerator<Suffix> {
+        hegel::one_of!(
+            ident().map(|name| Suffix::Index(Index::Dot(name))),
+            e.clone().map(|key| Suffix::Index(Index::Bracket(key))),
+            call(e).map(Suffix::Call),
+        )
+    }
+
+    /// An identifier with up to two suffixes.
+    fn prefix(e: &Exprs) -> impl PrintableGenerator<Prefix> {
+        hegel::tuples!(ident(), generators::vecs(suffix(e)).max_size(2))
+            .map(|(name, suffixes)| Prefix { name, suffixes })
+    }
+
+    fn field(e: &Exprs) -> impl PrintableGenerator<Field> {
+        hegel::one_of!(
+            e.clone().map(Field::Positional),
+            hegel::tuples!(ident(), e.clone()).map(|(name, value)| Field::Named { name, value }),
+            hegel::tuples!(e.clone(), e.clone()).map(|(key, value)| Field::Keyed { key, value }),
+        )
+    }
+
+    /// Up to three fields.
+    fn table(e: &Exprs) -> impl PrintableGenerator<Table> {
+        hegel::tuples!(
+            generators::vecs(
+                hegel::tuples!(generators::sampled_from(SEPARATORS), field(e))
+                    .map(|(sep, field)| TableField { sep, field })
+            )
+            .max_size(3),
+            generators::optional(generators::sampled_from(SEPARATORS)),
+        )
+        .map(|(fields, trailing)| Table { fields, trailing })
+    }
+
+    /// Up to three distinct parameters, `...` half the time, and `body`.
+    fn func_body(body: impl PrintableGenerator<Block>) -> impl PrintableGenerator<FuncBody> {
+        hegel::tuples!(
+            generators::vecs(ident()).unique(true).max_size(3),
+            generators::booleans(),
+            body,
+        )
+        .map(|(params, varargs, body)| FuncBody {
+            params,
+            varargs,
+            body,
+        })
+    }
+
+    fn var(e: &Exprs) -> impl PrintableGenerator<Var> {
+        hegel::one_of!(
+            ident().map(Var::Name),
+            hegel::tuples!(ident(), ident()).map(|(table, field)| Var::Dot(table, field)),
+            hegel::tuples!(ident(), e.clone()).map(|(table, key)| Var::Bracket(table, key)),
+        )
+    }
+
+    /// `local a, b[, c] [= e1[, e2]]`.
+    fn local_stmt(e: &Exprs) -> impl PrintableGenerator<Stmt> {
+        hegel::tuples!(names(3), exprs(e, 0, 2))
+            .map(|(names, values)| Stmt::Local { names, values })
+    }
+
+    /// `v1[, v2] = e1[, e2]`.
+    fn assign_stmt(e: &Exprs) -> impl PrintableGenerator<Stmt> {
+        hegel::tuples!(
+            generators::vecs(var(e)).min_size(1).max_size(2),
+            exprs(e, 1, 2)
+        )
+        .map(|(vars, values)| Stmt::Assign { vars, values })
+    }
+
+    /// A prefix expression ending in a call.
+    fn call_stmt(e: &Exprs) -> impl PrintableGenerator<Stmt> {
+        hegel::tuples!(prefix(e), call(e)).map(|(prefix, call)| Stmt::Call { prefix, call })
+    }
+
+    /// The statements without a body of their own: the leaves of the block
+    /// recursion.
+    fn simple_stmt(e: &Exprs) -> impl PrintableGenerator<Stmt> {
+        hegel::one_of!(local_stmt(e), assign_stmt(e), call_stmt(e))
+    }
+
+    /// Every statement: the three simple ones, then those whose blocks come
+    /// from `inner` (`do`, `while`, `repeat`, `if`, the two `for`s and the
+    /// two function declarations).
+    fn stmt(e: &Exprs, inner: SubtreeGenerator<Block>) -> impl PrintableGenerator<Stmt> {
+        let b = || inner.clone();
+        let x = || e.clone();
+        hegel::one_of!(
+            local_stmt(e),
+            assign_stmt(e),
+            call_stmt(e),
+            b().map(Stmt::Do),
+            hegel::tuples!(x(), b()).map(|(cond, body)| Stmt::While { cond, body }),
+            hegel::tuples!(b(), x()).map(|(body, cond)| Stmt::Repeat { body, cond }),
+            hegel::tuples!(
+                x(),
+                b(),
+                generators::vecs(
+                    hegel::tuples!(x(), b()).map(|(cond, body)| ElseIf { cond, body })
+                )
+                .max_size(1),
+                generators::optional(b()),
+            )
+            .map(|(cond, then, elseifs, otherwise)| Stmt::If {
+                cond,
+                then,
+                elseifs,
+                otherwise,
+            }),
+            hegel::tuples!(ident(), x(), x(), generators::optional(x()), b()).map(
+                |(var, start, limit, step, body)| Stmt::NumericFor {
+                    var,
+                    start,
+                    limit,
+                    step,
+                    body,
+                }
+            ),
+            hegel::tuples!(names(2), exprs(e, 1, 2), b()).map(|(names, iterators, body)| {
+                Stmt::GenericFor {
+                    names,
+                    iterators,
+                    body,
+                }
+            }),
+            hegel::tuples!(ident(), func_body(b()))
+                .map(|(name, body)| Stmt::LocalFunction { name, body }),
+            hegel::tuples!(
+                ident(),
+                generators::optional(ident()),
+                generators::optional(ident()),
+                func_body(b())
+            )
+            .map(|(name, field, method, body)| Stmt::Function {
+                name,
+                field,
+                method,
+                body,
+            }),
+        )
+    }
+
+    /// Up to `max` statements (each with `;` half the time) and, half the
+    /// time, a `return` of up to two values.
+    fn block_of(
+        e: &Exprs,
+        stmts: impl PrintableGenerator<Stmt>,
+        max: usize,
+    ) -> impl PrintableGenerator<Block> {
+        hegel::tuples!(
+            generators::vecs(
+                hegel::tuples!(stmts, generators::booleans())
+                    .map(|(stmt, semicolon)| StmtLine { stmt, semicolon })
+            )
+            .max_size(max),
+            generators::optional(
+                hegel::tuples!(exprs(e, 0, 2), generators::booleans())
+                    .map(|(values, semicolon)| Return { values, semicolon })
+            ),
+        )
+        .map(|(stmts, ret)| Block { stmts, ret })
+    }
+
+    /// A block whose expressions come from `e`: the leaves hold one simple
+    /// statement at most, the branches up to two statements of any kind with
+    /// their bodies drawn from the recursion, nested up to two levels and
+    /// `leaves` leaf blocks (the default budget of a hundred made a typical
+    /// chunk five hundred characters long).
+    fn block(e: &Exprs, leaves: usize) -> impl PrintableGenerator<Block> {
+        let e = e.clone();
+        generators::recursive(block_of(&e, simple_stmt(&e), 1), move |inner| {
+            block_of(&e, stmt(&e, inner), 2)
+        })
+        .max_depth(2)
+        .max_leaves(leaves)
+    }
+
+    /// One level of compound expression over `inner` sub-expressions: unary,
+    /// binary, parenthesised, prefix (indexes and calls), table, function.
+    fn compound(inner: SubtreeGenerator<Expr>) -> impl PrintableGenerator<Expr> {
+        let e: Exprs = inner.boxed_printable();
+        let x = || e.clone();
+        hegel::one_of!(
+            hegel::tuples!(generators::sampled_from(UNARY_OPS), x()).map(|(op, operand)| {
+                Expr::Unary {
+                    op,
+                    operand: Box::new(operand),
+                }
+            }),
+            hegel::tuples!(x(), generators::sampled_from(BINARY_OPS), x()).map(|(lhs, op, rhs)| {
+                Expr::Binary {
+                    lhs: Box::new(lhs),
+                    op,
+                    rhs: Box::new(rhs),
+                }
+            }),
+            x().map(|inner| Expr::Parens(Box::new(inner))),
+            prefix(&e).map(Expr::Prefix),
+            table(&e).map(Expr::Table),
+            func_body(block(&e, 2)).map(Expr::Function),
+        )
+    }
+
+    /// An expression: a scalar, or a compound of expressions nested up to
+    /// two levels and eight scalars (a function expression's body is a
+    /// `block` over the sub-expressions of its level, so its statements'
+    /// expressions count against the same budget).
+    pub fn expr() -> impl PrintableGenerator<Expr> {
+        generators::recursive(leaf(), compound)
+            .max_depth(2)
+            .max_leaves(8)
+    }
+
+    /// A structurally valid Lua 5.1 chunk with its trivia tapes: up to twelve
+    /// gaps' worth of whitespace and comments, up to six of the newline-free
+    /// kind, recycled by the writer.
+    pub fn chunk() -> impl PrintableGenerator<Chunk> {
+        let e: Exprs = expr().boxed_printable();
+        hegel::tuples!(
+            generators::booleans(),
+            block(&e, 4),
+            generators::booleans(),
+            generators::vecs(generators::sampled_from(TRIVIA)).max_size(12),
+            generators::vecs(generators::sampled_from(INLINE_TRIVIA)).max_size(6),
+        )
+        .map(|(lead, block, trail, trivia, inline)| Chunk {
+            lead,
+            block,
+            trail,
+            trivia,
+            inline,
+        })
+    }
+
+    // ------------------------------------------------------------------ near-Lua text
+
+    /// An edit of a chunk's text: delete the character at a position, or
+    /// splice a fragment of Lua's syntax alphabet in there (positions are
+    /// taken modulo the live length when applied). The alphabet has no
+    /// backtick and no `@`: lexing a backtick panics (full_moon/1) and `@`
+    /// before a lexer error panics in luau builds (full_moon/2).
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub enum Edit {
+        Delete { at: u16 },
+        Splice { at: u16, text: String },
+    }
+
+    fn edit() -> impl PrintableGenerator<Edit> {
+        let at = generators::integers::<u16>;
+        hegel::one_of!(
+            at().map(|at| Edit::Delete { at }),
+            hegel::tuples!(
+                at(),
+                generators::from_regex(r#"[a-z0-9=,.;:()\[\]{}"' \n#-]{0,6}"#).fullmatch(true)
+            )
+            .map(|(at, text)| Edit::Splice { at, text }),
+        )
+    }
+
+    /// Lua-ish text: a valid chunk with up to three edits, kept when the
+    /// result still parses, so the property sees text at the boundary of the
+    /// grammar rather than blank text. (Arbitrary text, the previous shape,
+    /// parsed one time in twenty, and almost all of those were blank.)
+    #[derive(Clone, Debug, hegel::PrettyPrintable)]
+    pub struct LuaIsh {
+        chunk: Chunk,
+        edits: Vec<Edit>,
+    }
+
+    impl LuaIsh {
+        pub fn render(&self) -> String {
+            let mut chars: Vec<char> = self.chunk.render().chars().collect();
+            for edit in &self.edits {
+                match edit {
+                    Edit::Delete { at } => {
+                        if !chars.is_empty() {
+                            chars.remove(*at as usize % chars.len());
+                        }
+                    }
+                    Edit::Splice { at, text } => {
+                        let i = *at as usize % (chars.len() + 1);
+                        chars.splice(i..i, text.chars());
+                    }
+                }
+            }
+            chars.into_iter().collect()
+        }
+    }
+
+    /// A chunk and its edits, filtered to the texts `full_moon::parse`
+    /// accepts.
+    pub fn lua_ish() -> impl PrintableGenerator<LuaIsh> {
+        hegel::tuples!(chunk(), generators::vecs(edit()).max_size(3))
+            .map(|(chunk, edits)| LuaIsh { chunk, edits })
+            .filter(|case| full_moon::parse(&case.render()).is_ok())
+    }
+
+    // ------------------------------------------------------------------ versions
+
+    /// An arbitrary `LuaVersion` configuration from whatever version features
+    /// are enabled in this build: one flag per feature, Lua 5.1 alone when
+    /// none is set. (Without the optional features the flags are unused.)
+    pub fn lua_version() -> impl PrintableGenerator<LuaVersion> {
+        let flag = generators::booleans;
+        hegel::tuples!(flag(), flag(), flag(), flag(), flag(), flag())
+            .map(|(luau, lua52, lua53, lua54, luajit, cfxlua)| {
+                let _ = (luau, lua52, lua53, lua54, luajit, cfxlua);
+                #[allow(unused_mut)] // `mut` is only needed when version features are enabled
+                let mut version = LuaVersion::lua51();
+
+                #[cfg(feature = "luau")]
+                if luau {
+                    version = version.with_luau();
+                }
+
+                #[cfg(feature = "lua52")]
+                if lua52 {
+                    version = version.with_lua52();
+                }
+
+                #[cfg(feature = "lua53")]
+                if lua53 {
+                    version = version.with_lua53();
+                }
+
+                #[cfg(feature = "lua54")]
+                if lua54 {
+                    version = version.with_lua54();
+                }
+
+                #[cfg(feature = "luajit")]
+                if luajit {
+                    version = version.with_luajit();
+                }
+
+                #[cfg(feature = "cfxlua")]
+                if cfxlua {
+                    version = version.with_cfxlua();
+                }
+
+                version
+            })
+            .print_as_debug()
+    }
+}
diff --git a/full-moon/tests/fail_cases.rs b/full-moon/tests/fail_cases.rs
index 797ef51..47ab556 100644
--- a/full-moon/tests/fail_cases.rs
+++ b/full-moon/tests/fail_cases.rs
@@ -157,3 +157,77 @@ fn test_cfxlua_tokenizer_fail_cases() {
         process_fail_case(path, &source, LuaVersion::cfxlua());
     })
 }
+
+// Hegel property-based tests.
+
+/// parse_fallible documents that it "always produces some Ast, regardless of
+/// errors" — so it must never panic, whatever the input text and whatever the
+/// LuaVersion configuration, and the partial Ast it produces must be
+/// printable.
+///
+/// (Deeply *nested* input is excluded from this guarantee in practice: see
+/// the KNOWN FAILURE reproducer `parse_deeply_nested_parens_overflows_stack`
+/// below. Uniform random text has no realistic chance of producing hundreds
+/// of consecutive `(`s, so no generator constraint is needed here.)
+#[hegel::test]
+fn parse_fallible_never_panics_on_arbitrary_input(tc: hegel::TestCase) {
+    // Backticks are excluded: lexing them panics in non-cfxlua builds — a
+    // real bug pinned by the canonical KNOWN FAILURE test
+    // tokenizer::structs::property_tests::lexing_backtick_returns_error_for_lua51.
+    // `@` is excluded too: in luau-feature builds, `@` + a lexer-error token
+    // panics in parse_attributes — pinned by
+    // parse_attribute_followed_by_garbage_returns_error below.
+    let (source, version) = tc.draw(hegel::tuples!(
+        hegel::generators::text().exclude_characters("`@"),
+        common::lua_gen::lua_version()
+    ));
+
+    let result = full_moon::parse_fallible(&source, version);
+
+    // Printing the (possibly partial) Ast must not panic either.
+    drop(result.ast().to_string());
+}
+
+/// KNOWN FAILURE (real bug, luau-feature builds): parse must return Err on
+/// unparseable input, never panic — but with the `luau` feature enabled,
+/// `@` followed by a token the lexer rejects panics:
+///
+///   called `Result::unwrap()` on an `Err` value: ()
+///   at src/ast/parsers.rs:3709 (parse_attributes)
+///
+/// Code path: parse_attributes consumes the `@`, parse_name returns NotFound
+/// because the next token is a lexer error, and the error-reporting arm calls
+/// `state.current().unwrap()` — but current() is Err for lexer-error tokens.
+/// Found by parse_fallible_never_panics_on_arbitrary_input (shrunk
+/// counterexample: "@$"); sibling properties exclude `@` from their inputs and
+/// reference this test.
+///
+/// Without the luau feature this passes ("@" never begins an attribute).
+#[test]
+fn parse_attribute_followed_by_garbage_returns_error() {
+    assert!(full_moon::parse("@$").is_err());
+}
+
+/// KNOWN FAILURE (real bug, process-aborting): full-moon's recursive-descent
+/// parser has no recursion depth limit, so deeply nested expressions overflow
+/// the stack and abort the whole process (observed at 500 nested parentheses
+/// on an 8 MiB main-thread stack in a debug build; test threads default to
+/// 2 MiB, failing even earlier).
+///
+/// This cannot be kept as a normally-failing test because a stack overflow
+/// aborts the entire test binary, so it is #[ignore]d. Reproduce with:
+///
+///   cargo test -p full_moon parse_deeply_nested_parens_overflows_stack -- --ignored
+///
+/// Minimal counterexample shape: "return" + "("*N + "1" + ")"*N for N >= ~500.
+/// Code path: ast::parsers parse_expression -> parse_primary_expression ->
+/// (parenthese branch) -> parse_expression recursion, one native stack frame
+/// per nesting level, with no depth budget.
+#[test]
+#[ignore = "real bug: aborts the process with a stack overflow (SIGABRT)"]
+fn parse_deeply_nested_parens_overflows_stack() {
+    let depth = 5000;
+    let source = format!("return {}1{}", "(".repeat(depth), ")".repeat(depth));
+    let result = full_moon::parse_fallible(&source, LuaVersion::new());
+    drop(result.ast().to_string());
+}
diff --git a/full-moon/tests/pass_cases.rs b/full-moon/tests/pass_cases.rs
index f9b4dbe..a2ec0a6 100644
--- a/full-moon/tests/pass_cases.rs
+++ b/full-moon/tests/pass_cases.rs
@@ -118,3 +118,99 @@ fn test_cfxlua_pass_cases() {
         test_pass_case(path, LuaVersion::cfxlua())
     });
 }
+
+// Hegel property-based tests.
+//
+// full-moon's headline feature is that it is *lossless*: parsing and then
+// printing an Ast must reproduce the original source byte-for-byte (the
+// existing pass cases assert exactly this for the checked-in sources; these
+// properties assert it for generated inputs).
+//
+// The generators are values in `common::lua_gen`: a chunk is drawn as a
+// syntax tree with its trivia tapes and rendered by a pure writer, so a
+// failing case is a small tree; the rendered source is noted.
+
+/// Crown property: any structurally valid Lua chunk parses successfully, and
+/// printing the resulting Ast reproduces the source byte-for-byte, including
+/// all whitespace and comment trivia.
+#[hegel::test]
+fn generated_lua_roundtrips_byte_identical(tc: hegel::TestCase) {
+    let source = tc.draw(common::lua_gen::chunk()).render();
+    tc.note(&format!("source: {source:?}"));
+
+    let ast = full_moon::parse(&source)
+        .unwrap_or_else(|errors| panic!("generated Lua failed to parse: {errors:#?}\n{source}"));
+
+    assert_eq!(PrettyString(&ast.to_string()), PrettyString(&source));
+}
+
+/// Losslessness is not limited to code our generator produces: for *any*
+/// string that full_moon::parse accepts, printing the Ast must reproduce it.
+///
+/// The text is a generated chunk with up to three edits (a deleted character
+/// or a spliced fragment of Lua's syntax alphabet), kept when it still
+/// parses: text at the boundary of the grammar rather than the blank text
+/// that arbitrary strings reduce to. Backticks and `@` are absent by
+/// construction (the alphabet has neither): lexing a backtick panics in
+/// non-cfxlua builds — a real bug pinned by the canonical KNOWN FAILURE test
+/// tokenizer::structs::property_tests::lexing_backtick_returns_error_for_lua51
+/// — and in luau-feature builds `@` + a lexer-error token panics in
+/// parse_attributes — pinned by
+/// fail_cases::parse_attribute_followed_by_garbage_returns_error.
+#[hegel::test]
+fn arbitrary_text_roundtrips_when_parse_succeeds(tc: hegel::TestCase) {
+    let source = tc.draw(common::lua_gen::lua_ish()).render();
+    tc.note(&format!("source: {source:?}"));
+
+    let Ok(ast) = full_moon::parse(&source) else {
+        // The generator keeps only text that parses; this guard never fires.
+        tc.reject()
+    };
+    assert_eq!(PrettyString(&ast.to_string()), PrettyString(&source));
+}
+
+/// The generator only emits core Lua 5.1 syntax, which every supported
+/// version is a superset of — so the same chunk must parse cleanly (and
+/// roundtrip) under every LuaVersion configuration this build supports.
+#[hegel::test]
+fn generated_lua_parses_under_every_version_config(tc: hegel::TestCase) {
+    let (chunk, version) = tc.draw(hegel::tuples!(
+        common::lua_gen::chunk(),
+        common::lua_gen::lua_version()
+    ));
+    let source = chunk.render();
+    tc.note(&format!("source: {source:?}"));
+
+    let result = full_moon::parse_fallible(&source, version);
+    assert!(
+        result.errors().is_empty(),
+        "generated Lua failed to parse under {version:?}: {:#?}\n{source}",
+        result.errors(),
+    );
+    assert_eq!(
+        PrettyString(&result.ast().to_string()),
+        PrettyString(&source)
+    );
+}
+
+/// Ast::update_positions recomputes positions from scratch. For an Ast that
+/// came straight from the parser the positions are already correct, so
+/// updating them must be a no-op (same check the pass cases make).
+#[hegel::test]
+fn generated_lua_update_positions_is_noop_on_fresh_parse(tc: hegel::TestCase) {
+    let source = tc.draw(common::lua_gen::chunk()).render();
+    tc.note(&format!("source: {source:?}"));
+
+    let ast = full_moon::parse(&source)
+        .unwrap_or_else(|errors| panic!("generated Lua failed to parse: {errors:#?}\n{source}"));
+
+    let old_positions: Vec<_> = ast.tokens().flat_map(unpack_token_reference).collect();
+    let ast = ast.update_positions();
+
+    assert_eq!(
+        old_positions,
+        ast.tokens()
+            .flat_map(unpack_token_reference)
+            .collect::<Vec<_>>(),
+    );
+}
diff --git a/full-moon/tests/visitors.rs b/full-moon/tests/visitors.rs
index acfbf47..cb6417d 100644
--- a/full-moon/tests/visitors.rs
+++ b/full-moon/tests/visitors.rs
@@ -170,3 +170,80 @@ fn test_unary_visitor_regression() {
     visitor.visit_ast(&parse("local x = #{}").unwrap());
     assert!(visitor.0, "Unary operation was not visited");
 }
+
+// Hegel property-based tests.
+
+mod common;
+
+/// A VisitorMut that overrides nothing must pass the Ast through unchanged:
+/// visit_mut rebuilds every node, so this checks that the plumbing preserves
+/// every token and every piece of trivia byte-for-byte.
+#[hegel::test]
+fn default_visitor_mut_is_identity(tc: hegel::TestCase) {
+    struct IdentityVisitor;
+    impl VisitorMut for IdentityVisitor {}
+
+    let source = tc.draw(common::lua_gen::chunk()).render();
+    tc.note(&format!("source: {source:?}"));
+
+    let ast = parse(&source)
+        .unwrap_or_else(|errors| panic!("generated Lua failed to parse: {errors:#?}\n{source}"));
+    let ast = IdentityVisitor.visit_ast(ast);
+
+    assert_eq!(ast.to_string(), source);
+}
+
+/// Mutating one kind of node through the visitor API must leave everything
+/// else — including whitespace and comment trivia — intact.
+///
+/// PrefixRenamer prepends `v_` to every local-assignment name (and strips it
+/// if present), replacing the token via TokenReference::with_token. Since no
+/// generated identifier starts with `v_` (see lua_gen::IDENTIFIERS), applying
+/// the visitor twice is an involution: print -> reparse -> rename again must
+/// reproduce the original source byte-for-byte, comments and all.
+#[hegel::test]
+fn rename_visitor_preserves_unrelated_trivia(tc: hegel::TestCase) {
+    struct PrefixRenamer;
+
+    impl VisitorMut for PrefixRenamer {
+        fn visit_local_assignment(
+            &mut self,
+            assignment: ast::LocalAssignment,
+        ) -> ast::LocalAssignment {
+            let name_list = assignment
+                .names()
+                .pairs()
+                .map(|name| {
+                    name.to_owned().map(|value| {
+                        let text = value.token().to_string();
+                        let renamed = match text.strip_prefix("v_") {
+                            Some(stripped) => stripped.to_string(),
+                            None => format!("v_{text}"),
+                        };
+                        value.with_token(Token::new(TokenType::Identifier {
+                            identifier: renamed.into(),
+                        }))
+                    })
+                })
+                .collect();
+
+            assignment.with_names(name_list)
+        }
+    }
+
+    let source = tc.draw(common::lua_gen::chunk()).render();
+    tc.note(&format!("source: {source:?}"));
+
+    let ast = parse(&source)
+        .unwrap_or_else(|errors| panic!("generated Lua failed to parse: {errors:#?}\n{source}"));
+
+    let renamed_source = PrefixRenamer.visit_ast(ast).to_string();
+
+    // The renamed program must still be valid Lua...
+    let renamed_ast = parse(&renamed_source).unwrap_or_else(|errors| {
+        panic!("renamed Lua failed to parse: {errors:#?}\n{renamed_source}")
+    });
+
+    // ...and renaming again must restore the original source exactly.
+    assert_eq!(PrefixRenamer.visit_ast(renamed_ast).to_string(), source);
+}
