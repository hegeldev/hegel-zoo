 }
+
+/// Property-test generators for structurally valid Lua source and for
+/// `LuaVersion` configurations. Used by the hegel property-based tests in
+/// pass_cases.rs, fail_cases.rs, and visitors.rs.
+///
+/// The generated code is deliberately conservative: it sticks to the Lua 5.1
+/// core grammar (which every version full-moon supports is a superset of), so
+/// that the same generated chunk can be parsed under any `LuaVersion`
+/// configuration.
+pub mod lua_gen {
+    use full_moon::ast::LuaVersion;
+    use hegel::generators;
+    use hegel::TestCase;
+
+    /// Identifiers that are safe as plain names in every Lua version
+    /// full-moon supports: no keywords, no contextual keywords (`type`,
+    /// `continue`, `export`, `goto`), and none start with `v_` (the rename
+    /// involution test in tests/visitors.rs relies on that).
+    pub const IDENTIFIERS: &[&str] = &[
+        "x", "y", "foo", "bar", "baz", "qux", "abc", "res", "tbl", "num",
+    ];
+
+    fn upto(tc: &TestCase, max: u8) -> u8 {
+        tc.draw_silent(generators::integers::<u8>().max_value(max))
+    }
+
+    fn ident(tc: &TestCase) -> String {
+        tc.draw_silent(generators::sampled_from(IDENTIFIERS.to_vec()))
+            .to_string()
+    }
+
+    /// Inter-token trivia: whitespace and comments. Always non-empty so
+    /// adjacent tokens can never fuse (`- -`, `1 ..`, `and y`, ...).
+    fn ws(tc: &TestCase) -> String {
+        tc.draw_silent(generators::sampled_from(vec![
+            " ",
+            " ",
+            " ",
+            " ",
+            " ",
+            "  ",
+            "\t",
+            "\n",
+            "\n",
+            "\r\n",
+            " -- comment\n",
+            " --[[ block comment ]] ",
+            " --[==[ level two ]==] ",
+        ]))
+        .to_string()
+    }
+
+    /// Trivia guaranteed to contain no newline (possibly empty). Used before
+    /// call arguments, where Lua treats `(` at the start of a new line as
+    /// ambiguous syntax.
+    fn ws_inline(tc: &TestCase) -> String {
+        tc.draw_silent(generators::sampled_from(vec![
+            "", "", "", " ", " ", "\t", " --[[ c ]] ",
+        ]))
+        .to_string()
+    }
+
+    fn number(tc: &TestCase) -> String {
+        tc.draw_silent(generators::sampled_from(vec![
+            "0", "1", "42", "3.14", "0.5", "1e5", "2E-1", "0xAB",
+        ]))
+        .to_string()
+    }
+
+    fn string_lit(tc: &TestCase) -> String {
+        tc.draw_silent(generators::sampled_from(vec![
+            "\"hello\"",
+            "''",
+            "'a'",
+            "\"\"",
+            "[[long string]]",
+            "\"a\\nb\"",
+            "'it\\'s'",
+            "[==[ nested ]] here ]==]",
+        ]))
+        .to_string()
+    }
+
+    fn expr(tc: &TestCase, depth: u8) -> String {
+        let choice = if depth == 0 {
+            upto(tc, 4)
+        } else {
+            upto(tc, 10)
+        };
+
+        match choice {
+            0 => number(tc),
+            1 => string_lit(tc),
+            2 => tc
+                .draw_silent(generators::sampled_from(vec!["true", "false", "nil"]))
+                .to_string(),
+            3 | 4 => ident(tc),
+            5 => {
+                let op = tc.draw_silent(generators::sampled_from(vec!["-", "not", "#"]));
+                format!("{}{}{}", op, ws(tc), expr(tc, depth - 1))
+            }
+            6 => {
+                let op = tc.draw_silent(generators::sampled_from(vec![
+                    "+", "-", "*", "/", "%", "^", "..", "==", "~=", "<", "<=", ">", ">=", "and",
+                    "or",
+                ]));
+                format!(
+                    "{}{}{}{}{}",
+                    expr(tc, depth - 1),
+                    ws(tc),
+                    op,
+                    ws(tc),
+                    expr(tc, depth - 1)
+                )
+            }
+            7 => format!("({}{}{})", ws(tc), expr(tc, depth - 1), ws(tc)),
+            8 => prefix_expr(tc, depth - 1, false),
+            9 => table(tc, depth - 1),
+            _ => format!("function{}{}", ws(tc), func_body(tc, depth - 1)),
+        }
+    }
+
+    fn call_args(tc: &TestCase, depth: u8) -> String {
+        match upto(tc, 3) {
+            0 => string_lit(tc),
+            1 => table(tc, depth),
+            _ => {
+                let n = upto(tc, 2);
+                let mut s = String::from("(");
+                for i in 0..n {
+                    if i > 0 {
+                        s.push(',');
+                    }
+                    s.push_str(&ws(tc));
+                    s.push_str(&expr(tc, depth));
+                }
+                s.push_str(&ws(tc));
+                s.push(')');
+                s
+            }
+        }
+    }
+
+    fn call_suffix(tc: &TestCase, depth: u8) -> String {
+        if tc.draw_silent(generators::booleans()) {
+            // method call: `:name(args)`
+            format!(
+                "{}:{}{}{}{}",
+                ws(tc),
+                ws(tc),
+                ident(tc),
+                ws_inline(tc),
+                call_args(tc, depth)
+            )
+        } else {
+            format!("{}{}", ws_inline(tc), call_args(tc, depth))
+        }
+    }
+
+    fn index_suffix(tc: &TestCase, depth: u8) -> String {
+        if tc.draw_silent(generators::booleans()) {
+            format!("{}.{}{}", ws(tc), ws(tc), ident(tc))
+        } else {
+            format!("{}[{}{}{}]", ws(tc), ws(tc), expr(tc, depth), ws(tc))
+        }
+    }
+
+    /// A prefix expression: an identifier followed by index/call suffixes.
+    /// If `must_call` is set, the expression is guaranteed to end in a call
+    /// suffix (making it a valid statement).
+    fn prefix_expr(tc: &TestCase, depth: u8, must_call: bool) -> String {
+        let mut s = ident(tc);
+        for _ in 0..upto(tc, 2) {
+            if tc.draw_silent(generators::booleans()) {
+                s.push_str(&call_suffix(tc, depth));
+            } else {
+                s.push_str(&index_suffix(tc, depth));
+            }
+        }
+        if must_call {
+            s.push_str(&call_suffix(tc, depth));
+        }
+        s
+    }
+
+    fn field(tc: &TestCase, depth: u8) -> String {
+        match upto(tc, 2) {
+            0 => expr(tc, depth),
+            1 => format!("{}{}={}{}", ident(tc), ws(tc), ws(tc), expr(tc, depth)),
+            _ => format!(
+                "[{}{}{}]{}={}{}",
+                ws(tc),
+                expr(tc, depth),
+                ws(tc),
+                ws(tc),
+                ws(tc),
+                expr(tc, depth)
+            ),
+        }
+    }
+
+    fn table(tc: &TestCase, depth: u8) -> String {
+        let n = upto(tc, 3);
+        let mut s = String::from("{");
+        for i in 0..n {
+            if i > 0 {
+                s.push_str(tc.draw_silent(generators::sampled_from(vec![",", ";"])));
+            }
+            s.push_str(&ws(tc));
+            s.push_str(&field(tc, depth));
+        }
+        if n > 0 && tc.draw_silent(generators::booleans()) {
+            s.push_str(tc.draw_silent(generators::sampled_from(vec![",", ";"])));
+        }
+        s.push_str(&ws(tc));
+        s.push('}');
+        s
+    }
+
+    fn func_body(tc: &TestCase, depth: u8) -> String {
+        let idxs: Vec<usize> = tc.draw_silent(
+            generators::vecs(generators::integers::<usize>().max_value(IDENTIFIERS.len() - 1))
+                .max_size(3)
+                .unique(true),
+        );
+        let mut params: Vec<String> = idxs.iter().map(|&i| IDENTIFIERS[i].to_string()).collect();
+        if tc.draw_silent(generators::booleans()) {
+            params.push("...".to_string());
+        }
+
+        let mut s = String::from("(");
+        for (i, param) in params.iter().enumerate() {
+            if i > 0 {
+                s.push(',');
+            }
+            s.push_str(&ws(tc));
+            s.push_str(param);
+        }
+        s.push_str(&ws(tc));
+        s.push(')');
+        s.push_str(&ws(tc));
+        s.push_str(&block(tc, depth));
+        s.push_str(&ws(tc));
+        s.push_str("end");
+        s
+    }
+
+    fn var(tc: &TestCase, depth: u8) -> String {
+        match upto(tc, 2) {
+            0 => ident(tc),
+            1 => format!("{}{}.{}{}", ident(tc), ws(tc), ws(tc), ident(tc)),
+            _ => format!(
+                "{}{}[{}{}{}]",
+                ident(tc),
+                ws(tc),
+                ws(tc),
+                expr(tc, depth),
+                ws(tc)
+            ),
+        }
+    }
+
+    fn stmt(tc: &TestCase, depth: u8) -> String {
+        let choice = if depth == 0 {
+            upto(tc, 2)
+        } else {
+            upto(tc, 9)
+        };
+
+        match choice {
+            0 => {
+                // local assignment
+                let mut s = String::from("local");
+                let n_names = 1 + upto(tc, 2);
+                for i in 0..n_names {
+                    if i > 0 {
+                        s.push(',');
+                    }
+                    s.push_str(&ws(tc));
+                    s.push_str(&ident(tc));
+                }
+                if tc.draw_silent(generators::booleans()) {
+                    s.push_str(&ws(tc));
+                    s.push('=');
+                    let n_exprs = 1 + upto(tc, 1);
+                    for i in 0..n_exprs {
+                        if i > 0 {
+                            s.push(',');
+                        }
+                        s.push_str(&ws(tc));
+                        s.push_str(&expr(tc, depth));
+                    }
+                }
+                s
+            }
+            1 => {
+                // assignment
+                let mut s = String::new();
+                let n_vars = 1 + upto(tc, 1);
+                for i in 0..n_vars {
+                    if i > 0 {
+                        s.push(',');
+                        s.push_str(&ws(tc));
+                    }
+                    s.push_str(&var(tc, depth));
+                }
+                s.push_str(&ws(tc));
+                s.push('=');
+                let n_exprs = 1 + upto(tc, 1);
+                for i in 0..n_exprs {
+                    if i > 0 {
+                        s.push(',');
+                    }
+                    s.push_str(&ws(tc));
+                    s.push_str(&expr(tc, depth));
+                }
+                s
+            }
+            2 => prefix_expr(tc, depth, true),
+            3 => format!("do{}{}{}end", ws(tc), block(tc, depth - 1), ws(tc)),
+            4 => format!(
+                "while{}{}{}do{}{}{}end",
+                ws(tc),
+                expr(tc, depth),
+                ws(tc),
+                ws(tc),
+                block(tc, depth - 1),
+                ws(tc)
+            ),
+            5 => format!(
+                "repeat{}{}{}until{}{}",
+                ws(tc),
+                block(tc, depth - 1),
+                ws(tc),
+                ws(tc),
+                expr(tc, depth)
+            ),
+            6 => {
+                // if / elseif / else
+                let mut s = format!(
+                    "if{}{}{}then{}{}",
+                    ws(tc),
+                    expr(tc, depth),
+                    ws(tc),
+                    ws(tc),
+                    block(tc, depth - 1)
+                );
+                for _ in 0..upto(tc, 1) {
+                    s.push_str(&format!(
+                        "{}elseif{}{}{}then{}{}",
+                        ws(tc),
+                        ws(tc),
+                        expr(tc, depth),
+                        ws(tc),
+                        ws(tc),
+                        block(tc, depth - 1)
+                    ));
+                }
+                if tc.draw_silent(generators::booleans()) {
+                    s.push_str(&format!("{}else{}{}", ws(tc), ws(tc), block(tc, depth - 1)));
+                }
+                s.push_str(&ws(tc));
+                s.push_str("end");
+                s
+            }
+            7 => {
+                // numeric for
+                let mut s = format!(
+                    "for{}{}{}={}{},{}{}",
+                    ws(tc),
+                    ident(tc),
+                    ws(tc),
+                    ws(tc),
+                    expr(tc, depth),
+                    ws(tc),
+                    expr(tc, depth)
+                );
+                if tc.draw_silent(generators::booleans()) {
+                    s.push_str(&format!(",{}{}", ws(tc), expr(tc, depth)));
+                }
+                s.push_str(&format!(
+                    "{}do{}{}{}end",
+                    ws(tc),
+                    ws(tc),
+                    block(tc, depth - 1),
+                    ws(tc)
+                ));
+                s
+            }
+            8 => {
+                // generic for
+                let mut s = String::from("for");
+                let n_names = 1 + upto(tc, 1);
+                for i in 0..n_names {
+                    if i > 0 {
+                        s.push(',');
+                    }
+                    s.push_str(&ws(tc));
+                    s.push_str(&ident(tc));
+                }
+                s.push_str(&ws(tc));
+                s.push_str("in");
+                let n_exprs = 1 + upto(tc, 1);
+                for i in 0..n_exprs {
+                    if i > 0 {
+                        s.push(',');
+                    }
+                    s.push_str(&ws(tc));
+                    s.push_str(&expr(tc, depth));
+                }
+                s.push_str(&format!(
+                    "{}do{}{}{}end",
+                    ws(tc),
+                    ws(tc),
+                    block(tc, depth - 1),
+                    ws(tc)
+                ));
+                s
+            }
+            _ => {
+                if tc.draw_silent(generators::booleans()) {
+                    format!(
+                        "local{}function{}{}{}{}",
+                        ws(tc),
+                        ws(tc),
+                        ident(tc),
+                        ws(tc),
+                        func_body(tc, depth - 1)
+                    )
+                } else {
+                    let mut name = ident(tc);
+                    if tc.draw_silent(generators::booleans()) {
+                        name.push_str(&format!("{}.{}{}", ws(tc), ws(tc), ident(tc)));
+                    }
+                    if tc.draw_silent(generators::booleans()) {
+                        name.push_str(&format!("{}:{}{}", ws(tc), ws(tc), ident(tc)));
+                    }
+                    format!(
+                        "function{}{}{}{}",
+                        ws(tc),
+                        name,
+                        ws(tc),
+                        func_body(tc, depth - 1)
+                    )
+                }
+            }
+        }
+    }
+
+    fn block(tc: &TestCase, depth: u8) -> String {
+        let n = upto(tc, if depth == 0 { 1 } else { 2 });
+        let mut s = String::new();
+        for i in 0..n {
+            if i > 0 {
+                s.push_str(&ws(tc));
+            }
+            s.push_str(&stmt(tc, depth));
+            if tc.draw_silent(generators::booleans()) {
+                s.push(';');
+            }
+        }
+        if tc.draw_silent(generators::booleans()) {
+            if n > 0 {
+                s.push_str(&ws(tc));
+            }
+            s.push_str("return");
+            let n_exprs = upto(tc, 2);
+            for i in 0..n_exprs {
+                if i > 0 {
+                    s.push(',');
+                }
+                s.push_str(&ws(tc));
+                s.push_str(&expr(tc, depth));
+            }
+            if tc.draw_silent(generators::booleans()) {
+                s.push(';');
+            }
+        }
+        s
+    }
+
+    /// Generates a structurally valid Lua 5.1 chunk, with randomized
+    /// whitespace and comment trivia between all tokens.
+    pub fn chunk(tc: &TestCase) -> String {
+        let mut s = String::new();
+        if tc.draw_silent(generators::booleans()) {
+            s.push_str(&ws(tc));
+        }
+        s.push_str(&block(tc, 2));
+        if tc.draw_silent(generators::booleans()) {
+            s.push_str(&ws(tc));
+        }
+        s
+    }
+
+    /// Generates an arbitrary `LuaVersion` configuration from whatever
+    /// version features are enabled in this build.
+    pub fn arbitrary_lua_version(tc: &TestCase) -> LuaVersion {
+        // With no optional version features enabled, `tc` is otherwise unused.
+        let _ = tc;
+        #[allow(unused_mut)] // `mut` is only needed when version features are enabled
+        let mut version = LuaVersion::lua51();
+
+        #[cfg(feature = "luau")]
+        if tc.draw_silent(generators::booleans()) {
+            version = version.with_luau();
+        }
+
+        #[cfg(feature = "lua52")]
+        if tc.draw_silent(generators::booleans()) {
+            version = version.with_lua52();
+        }
+
+        #[cfg(feature = "lua53")]
+        if tc.draw_silent(generators::booleans()) {
+            version = version.with_lua53();
+        }
+
+        #[cfg(feature = "lua54")]
+        if tc.draw_silent(generators::booleans()) {
+            version = version.with_lua54();
+        }
+
+        #[cfg(feature = "luajit")]
+        if tc.draw_silent(generators::booleans()) {
+            version = version.with_luajit();
+        }
+
+        #[cfg(feature = "cfxlua")]
+        if tc.draw_silent(generators::booleans()) {
+            version = version.with_cfxlua();
+        }
+
+        version
+    }
+}
diff --git a/full-moon/tests/fail_cases.rs b/full-moon/tests/fail_cases.rs
index 797ef51..cc56c45 100644
--- a/full-moon/tests/fail_cases.rs
+++ b/full-moon/tests/fail_cases.rs
@@ -157,3 +157,77 @@ fn test_cfxlua_tokenizer_fail_cases() {
         process_fail_case(path, &source, LuaVersion::cfxlua());
     })
 }
+
+// Hegel property-based tests.
+
+/// parse_fallible documents that it "always produces some Ast, regardless of
+/// errors" — so it must never panic, whatever the input text and whatever the
+/// LuaVersion configuration, and the partial Ast it produces must be
+/// printable.
+///
+/// (Deeply *nested* input is excluded from this guarantee in practice: see
+/// the KNOWN FAILURE reproducer `parse_deeply_nested_parens_overflows_stack`
+/// below. Uniform random text has no realistic chance of producing hundreds
+/// of consecutive `(`s, so no generator constraint is needed here.)
+#[hegel::test]
+fn parse_fallible_never_panics_on_arbitrary_input(tc: hegel::TestCase) {
+    // Backticks are stripped: lexing them panics in non-cfxlua builds — a
+    // real bug pinned by the canonical KNOWN FAILURE test
+    // tokenizer::structs::property_tests::lexing_backtick_returns_error_for_lua51.
+    // `@` is stripped too: in luau-feature builds, `@` + a lexer-error token
+    // panics in parse_attributes — pinned by
+    // parse_attribute_followed_by_garbage_returns_error below.
+    let source: String = tc
+        .draw(hegel::generators::text())
+        .replace(['`', '@'], "");
+    let version = common::lua_gen::arbitrary_lua_version(&tc);
+
+    let result = full_moon::parse_fallible(&source, version);
+
+    // Printing the (possibly partial) Ast must not panic either.
+    drop(result.ast().to_string());
+}
+
+/// KNOWN FAILURE (real bug, luau-feature builds): parse must return Err on
+/// unparseable input, never panic — but with the `luau` feature enabled,
+/// `@` followed by a token the lexer rejects panics:
+///
+///   called `Result::unwrap()` on an `Err` value: ()
+///   at src/ast/parsers.rs:3709 (parse_attributes)
+///
+/// Code path: parse_attributes consumes the `@`, parse_name returns NotFound
+/// because the next token is a lexer error, and the error-reporting arm calls
+/// `state.current().unwrap()` — but current() is Err for lexer-error tokens.
+/// Found by parse_fallible_never_panics_on_arbitrary_input (shrunk
+/// counterexample: "@$"); sibling properties strip `@` from their inputs and
+/// reference this test.
+///
+/// Without the luau feature this passes ("@" never begins an attribute).
+#[test]
+fn parse_attribute_followed_by_garbage_returns_error() {
+    assert!(full_moon::parse("@$").is_err());
+}
+
+/// KNOWN FAILURE (real bug, process-aborting): full-moon's recursive-descent
+/// parser has no recursion depth limit, so deeply nested expressions overflow
+/// the stack and abort the whole process (observed at 500 nested parentheses
+/// on an 8 MiB main-thread stack in a debug build; test threads default to
+/// 2 MiB, failing even earlier).
+///
+/// This cannot be kept as a normally-failing test because a stack overflow
+/// aborts the entire test binary, so it is #[ignore]d. Reproduce with:
+///
+///   cargo test -p full_moon parse_deeply_nested_parens_overflows_stack -- --ignored
+///
+/// Minimal counterexample shape: "return" + "("*N + "1" + ")"*N for N >= ~500.
+/// Code path: ast::parsers parse_expression -> parse_primary_expression ->
+/// (parenthese branch) -> parse_expression recursion, one native stack frame
+/// per nesting level, with no depth budget.
+#[test]
+#[ignore = "real bug: aborts the process with a stack overflow (SIGABRT)"]
+fn parse_deeply_nested_parens_overflows_stack() {
+    let depth = 5000;
+    let source = format!("return {}1{}", "(".repeat(depth), ")".repeat(depth));
+    let result = full_moon::parse_fallible(&source, LuaVersion::new());
+    drop(result.ast().to_string());
+}
diff --git a/full-moon/tests/pass_cases.rs b/full-moon/tests/pass_cases.rs
index f9b4dbe..a6925ac 100644
--- a/full-moon/tests/pass_cases.rs
+++ b/full-moon/tests/pass_cases.rs
@@ -118,3 +118,83 @@ fn test_cfxlua_pass_cases() {
         test_pass_case(path, LuaVersion::cfxlua())
     });
 }
+
+// Hegel property-based tests.
+//
+// full-moon's headline feature is that it is *lossless*: parsing and then
+// printing an Ast must reproduce the original source byte-for-byte (the
+// existing pass cases assert exactly this for the checked-in sources; these
+// properties assert it for generated inputs).
+
+/// Crown property: any structurally valid Lua chunk parses successfully, and
+/// printing the resulting Ast reproduces the source byte-for-byte, including
+/// all whitespace and comment trivia.
+#[hegel::test]
+fn generated_lua_roundtrips_byte_identical(tc: hegel::TestCase) {
+    let source = common::lua_gen::chunk(&tc);
+    tc.note(&format!("source: {source:?}"));
+
+    let ast = full_moon::parse(&source)
+        .unwrap_or_else(|errors| panic!("generated Lua failed to parse: {errors:#?}\n{source}"));
+
+    assert_eq!(PrettyString(&ast.to_string()), PrettyString(&source));
+}
+
+/// Losslessness is not limited to code our generator produces: for *any*
+/// string that full_moon::parse accepts, printing the Ast must reproduce it.
+#[hegel::test]
+fn arbitrary_text_roundtrips_when_parse_succeeds(tc: hegel::TestCase) {
+    // Backticks are stripped: lexing them panics in non-cfxlua builds — a
+    // real bug pinned by the canonical KNOWN FAILURE test
+    // tokenizer::structs::property_tests::lexing_backtick_returns_error_for_lua51.
+    // `@` is stripped too: in luau-feature builds, `@` + a lexer-error token
+    // panics in parse_attributes — pinned by
+    // fail_cases::parse_attribute_followed_by_garbage_returns_error.
+    let source: String = tc
+        .draw(hegel::generators::text())
+        .replace(['`', '@'], "");
+
+    if let Ok(ast) = full_moon::parse(&source) {
+        assert_eq!(PrettyString(&ast.to_string()), PrettyString(&source));
+    }
+}
+
+/// The generator only emits core Lua 5.1 syntax, which every supported
+/// version is a superset of — so the same chunk must parse cleanly (and
+/// roundtrip) under every LuaVersion configuration this build supports.
+#[hegel::test]
+fn generated_lua_parses_under_every_version_config(tc: hegel::TestCase) {
+    let source = common::lua_gen::chunk(&tc);
+    let version = common::lua_gen::arbitrary_lua_version(&tc);
+    tc.note(&format!("version: {version:?}, source: {source:?}"));
+
+    let result = full_moon::parse_fallible(&source, version);
+    assert!(
+        result.errors().is_empty(),
+        "generated Lua failed to parse under {version:?}: {:#?}\n{source}",
+        result.errors(),
+    );
+    assert_eq!(PrettyString(&result.ast().to_string()), PrettyString(&source));
+}
+
+/// Ast::update_positions recomputes positions from scratch. For an Ast that
+/// came straight from the parser the positions are already correct, so
+/// updating them must be a no-op (same check the pass cases make).
+#[hegel::test]
+fn generated_lua_update_positions_is_noop_on_fresh_parse(tc: hegel::TestCase) {
+    let source = common::lua_gen::chunk(&tc);
+    tc.note(&format!("source: {source:?}"));
+
+    let ast = full_moon::parse(&source)
+        .unwrap_or_else(|errors| panic!("generated Lua failed to parse: {errors:#?}\n{source}"));
+
+    let old_positions: Vec<_> = ast.tokens().flat_map(unpack_token_reference).collect();
+    let ast = ast.update_positions();
+
+    assert_eq!(
+        old_positions,
+        ast.tokens()
+            .flat_map(unpack_token_reference)
+            .collect::<Vec<_>>(),
+    );
+}
diff --git a/full-moon/tests/visitors.rs b/full-moon/tests/visitors.rs
index acfbf47..2042c3b 100644
--- a/full-moon/tests/visitors.rs
+++ b/full-moon/tests/visitors.rs
@@ -170,3 +170,80 @@ fn test_unary_visitor_regression() {
     visitor.visit_ast(&parse("local x = #{}").unwrap());
     assert!(visitor.0, "Unary operation was not visited");
 }
+
+// Hegel property-based tests.
+
+mod common;
+
+/// A VisitorMut that overrides nothing must pass the Ast through unchanged:
+/// visit_mut rebuilds every node, so this checks that the plumbing preserves
+/// every token and every piece of trivia byte-for-byte.
+#[hegel::test]
+fn default_visitor_mut_is_identity(tc: hegel::TestCase) {
+    struct IdentityVisitor;
+    impl VisitorMut for IdentityVisitor {}
+
+    let source = common::lua_gen::chunk(&tc);
+    tc.note(&format!("source: {source:?}"));
+
+    let ast = parse(&source)
+        .unwrap_or_else(|errors| panic!("generated Lua failed to parse: {errors:#?}\n{source}"));
+    let ast = IdentityVisitor.visit_ast(ast);
+
+    assert_eq!(ast.to_string(), source);
+}
+
+/// Mutating one kind of node through the visitor API must leave everything
+/// else — including whitespace and comment trivia — intact.
+///
+/// PrefixRenamer prepends `v_` to every local-assignment name (and strips it
+/// if present), replacing the token via TokenReference::with_token. Since no
+/// generated identifier starts with `v_` (see lua_gen::IDENTIFIERS), applying
+/// the visitor twice is an involution: print -> reparse -> rename again must
+/// reproduce the original source byte-for-byte, comments and all.
+#[hegel::test]
+fn rename_visitor_preserves_unrelated_trivia(tc: hegel::TestCase) {
+    struct PrefixRenamer;
+
+    impl VisitorMut for PrefixRenamer {
+        fn visit_local_assignment(
+            &mut self,
+            assignment: ast::LocalAssignment,
+        ) -> ast::LocalAssignment {
+            let name_list = assignment
+                .names()
+                .pairs()
+                .map(|name| {
+                    name.to_owned().map(|value| {
+                        let text = value.token().to_string();
+                        let renamed = match text.strip_prefix("v_") {
+                            Some(stripped) => stripped.to_string(),
+                            None => format!("v_{text}"),
+                        };
+                        value.with_token(Token::new(TokenType::Identifier {
+                            identifier: renamed.into(),
+                        }))
+                    })
+                })
+                .collect();
+
+            assignment.with_names(name_list)
+        }
+    }
+
+    let source = common::lua_gen::chunk(&tc);
+    tc.note(&format!("source: {source:?}"));
+
+    let ast = parse(&source)
+        .unwrap_or_else(|errors| panic!("generated Lua failed to parse: {errors:#?}\n{source}"));
+
+    let renamed_source = PrefixRenamer.visit_ast(ast).to_string();
+
+    // The renamed program must still be valid Lua...
+    let renamed_ast = parse(&renamed_source).unwrap_or_else(|errors| {
+        panic!("renamed Lua failed to parse: {errors:#?}\n{renamed_source}")
+    });
+
+    // ...and renaming again must restore the original source exactly.
+    assert_eq!(PrefixRenamer.visit_ast(renamed_ast).to_string(), source);
+}
