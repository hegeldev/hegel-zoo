+    // a negative value renders as the positive one with a sign, up to pluralisation (the
+    // structural property judges that); with a separator this reaches humansize/2, whose shape
+    // is compared on the plain options under HEGEL_NO_KNOWN=1
+    if let Ok(v) = i64::try_from(mag) {
