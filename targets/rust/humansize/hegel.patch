+#[hegel::test]
+fn long_binary_bit_table_is_capitalised(tc: hegel::TestCase) {
+    // the long binary bit scale spells its first entry `bits` while the decimal one and every
+    // other long unit are capitalised (`Bits`, `Kibibits`)
+    let mag = tc.draw(int!(2u64, 127));
+    let o = FormatSizeOptions::from(BINARY).base_unit(BaseUnit::Bit).long_units(true);
+    assert_eq!(format_size(mag, o), format!("{mag} Bits"));
+    let o = FormatSizeOptions::from(DECIMAL).base_unit(BaseUnit::Bit).long_units(true);
+    assert_eq!(format_size(mag, o), format!("{mag} Bits"));
+}
