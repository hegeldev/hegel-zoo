+#[hegel::test]
+fn every_entry_point_renders_alike(tc: hegel::TestCase) {
+    let opts = tc.draw(arb_opts());
+    let mag = tc.draw(arb_mag());
+    let o = opts.options();
+    let reference = format_size(mag, o);
+    // the allocating, non-allocating and impl-style APIs, by value and by reference
+    assert_eq!(format_size(mag, &o), reference);
+    assert_eq!(format_size_i(mag, o), reference);
+    assert_eq!(format!("{}", SizeFormatter::new(mag, o)), reference);
+    assert_eq!(format!("{}", SizeFormatter::new(mag, &o)), reference);
+    assert_eq!(format!("{}", ISizeFormatter::new(mag, o)), reference);
+    assert_eq!(make_format(o)(mag), reference);
+    assert_eq!(make_format_i(&o)(mag), reference);
+    assert_eq!(mag.format_size(o), reference);
+    // every integer type that holds the value renders as u64 does
+    if let Ok(v) = u8::try_from(mag) { assert_eq!(format_size(v, o), reference); assert_eq!(v.format_size(o), reference); }
+    if let Ok(v) = u16::try_from(mag) { assert_eq!(format_size(v, o), reference); }
+    if let Ok(v) = u32::try_from(mag) { assert_eq!(format_size(v, o), reference); }
+    if let Ok(v) = usize::try_from(mag) { assert_eq!(format_size(v, o), reference); }
+    assert_eq!(format_size(mag as u128, o), reference);
+    if let Ok(v) = i8::try_from(mag) { assert_eq!(format_size_i(v, o), reference); assert_eq!(v.format_size_i(o), reference); }
+    if let Ok(v) = i16::try_from(mag) { assert_eq!(format_size_i(v, o), reference); }
+    if let Ok(v) = i32::try_from(mag) { assert_eq!(format_size_i(v, o), reference); }
+    if let Ok(v) = i64::try_from(mag) {
+        assert_eq!(format_size_i(v, o), reference);
+        assert_eq!(v.format_size_i(o), reference);
+        assert_eq!(format!("{}", ISizeFormatter::new(v, &o)), reference);
+        assert_eq!(make_format_i(o)(v), reference);
+    }
+    assert_eq!(format_size_i(mag as i128, o), reference);
+    // a float holding the same integer renders the same
+    if mag < 1 << 53 {
+        assert_eq!(format_size_i(mag as f64, o), reference);
+    }
+    if mag < 1 << 24 {
+        assert_eq!(format_size_i(mag as f32, o), reference);
+    }
+    // a negative value renders as the positive one with a sign, up to pluralisation
+    if let Ok(v) = i64::try_from(mag) {
+        if v > 0 {
+            let neg = format_size_i(-v, o);
+            let neg_plain = format_size_i(-v, opts.plain().options());
+            let pos_plain = format_size_i(v, opts.plain().options());
+            let strip = |s: &str| s.replace("Bytes", "Byte").replace("bytes", "byte").replace("bits", "bit").replace("Bits", "Bit");
+            assert_eq!(strip(&neg_plain), format!("-{}", strip(&pos_plain)), "sign symmetry");
+            // (the separator path is pinned: humansize/2 loses the decimals of negative values)
+            assert!(neg.starts_with('-'), "{neg:?}");
+        }
+    }
+}
+
+#[hegel::test]
+fn pluralisation_follows_the_printed_value(tc: hegel::TestCase) {
+    // long units (and the bare `bits`) are singular exactly when the printed number is 1.xx
+    let mut opts = tc.draw(arb_opts()).plain();
+    opts.long = true;
+    let mag = tc.draw(arb_mag());
+    let negative = tc.draw(generators::booleans());
+    let value: i64 = if negative { -(mag.min(i64::MAX as u64) as i64) } else { mag.min(i64::MAX as u64) as i64 };
+    let text = format_size_i(value, opts.options());
+    let (mantissa, rest) = split_mantissa(&text);
+    let int_text = mantissa.trim_start_matches('-').split('.').next().unwrap();
+    let k = {
+        let d = opts.divider() as u128;
+        let mag = (value as f64).abs() as u128;
+        match opts.fixed {
+            Some(k) => k,
+            None => { let mut k = 0; while k < 8 && mag >= d.pow(k as u32 + 1) { k += 1; } k }
+        }
+    };
+    let unit = opts.table()[k];
+    let expected = if int_text == "1" { &unit[..unit.len() - 1] } else { unit };
+    assert!(rest.starts_with(if opts.space { " " } else { "" }));
+    assert_eq!(rest.trim_start(), format!("{expected}{}", SUFFIXES[opts.suffix]), "unit of {text:?} for {value}");
+}
