+#[hegel::test]
+fn wide_values_render_to_the_capped_scale(tc: hegel::TestCase) {
+    // u128 / i128 inputs: the scale stops at the yotta entry and the mantissa follows the f64 value
+    let opts = tc.draw(arb_opts());
+    let value: u128 = match tc.draw(int!(0u8, 2)) {
+        0 => tc.draw(int!(0u128, u128::MAX)),
+        1 => {
+            let d: u128 = if opts.kilo_binary { 1024 } else { 1000 };
+            let e = tc.draw(int!(6u32, 12));
+            let m = tc.draw(int!(1u128, 2048));
+            d.pow(e).saturating_mul(m).saturating_add(tc.draw(int!(0u128, 3)))
+        }
+        _ => tc.draw(generators::sampled_from(vec![u128::MAX, u64::MAX as u128 + 1, 1u128 << 100, 10u128.pow(24), 10u128.pow(24) - 1, 10u128.pow(27), 1u128 << 80])),
+    };
+    let text = format_size(value, opts.options());
+    let plain = format_size(value, opts.plain().options());
+    assert!(!text.is_empty());
+    let (mantissa, rest) = split_mantissa(&plain);
+    let fv = value as f64;
+    let d = opts.divider() as f64;
+    let k = match opts.fixed {
+        Some(k) => k,
+        None => { let mut k = 0; while k < 8 && fv >= d.powi(k as i32 + 1) { k += 1; } k }
+    };
+    let unit = opts.table()[k];
+    let tail = rest.trim_start();
+    assert!(tail == format!("{unit}{}", SUFFIXES[opts.suffix]) || tail == format!("{}{}", &unit[..unit.len() - 1], SUFFIXES[opts.suffix]), "unit of {plain:?} for {value}");
+    let m: f64 = mantissa.parse().unwrap();
+    let expected = fv / d.powi(k as i32);
+    let p = mantissa.find('.').map(|i| mantissa.len() - i - 1).unwrap_or(0);
+    let tolerance = 0.5 * 10f64.powi(-(p as i32)) + expected * 1e-13;
+    assert!((m - expected).abs() <= tolerance, "{plain:?} for {value}: mantissa {m} vs {expected}");
+}
+
+#[hegel::test]
+fn float_inputs_render_without_panicking_and_group_alike(tc: hegel::TestCase) {
+    let opts = tc.draw(arb_opts());
+    let value: f64 = match tc.draw(int!(0u8, 3)) {
+        0 => tc.draw(generators::floats().min_value(-1e30).max_value(1e30)),
+        1 => tc.draw(generators::floats().min_value(-2000.0).max_value(2000.0)),
+        2 => tc.draw(generators::floats()),
+        _ => tc.draw(generators::sampled_from(vec![0.0, -0.0, 0.5, 1.5, 999.5, 1023.5, 1e300, -1e300, f64::MIN_POSITIVE])),
+    };
+    let opts = opts.plain();
+    let plain = format_size_i(value, opts.options());
+    if value.is_finite() {
+        let (mantissa, _) = split_mantissa(&plain);
+        let m: f64 = mantissa.parse().unwrap();
+        let d = opts.divider() as f64;
+        let k = match opts.fixed {
+            Some(k) => k,
+            None => { let mut k = 0; while k < 8 && value.abs() >= d.powi(k as i32 + 1) { k += 1; } k }
+        };
+        let expected = value / d.powi(k as i32);
+        let p = mantissa.find('.').map(|i| mantissa.len() - i - 1).unwrap_or(0);
+        let tolerance = 0.5 * 10f64.powi(-(p as i32)) + expected.abs() * 1e-13;
+        assert!((m - expected).abs() <= tolerance, "{plain:?} for {value:e}: mantissa {m} vs {expected}");
+    }
+}
