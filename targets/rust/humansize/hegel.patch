+#[hegel::test]
+fn non_finite_inputs_render_their_float_spelling(tc: hegel::TestCase) {
+    // `NaN B`, `inf YB`: whatever the option set, a Display impl must not panic — with a
+    // thousands separator too
+    let opts = tc.draw(arb_grouping_opts());
+    let value = tc.draw(generators::sampled_from(vec![f64::NAN, f64::INFINITY, f64::NEG_INFINITY]));
+    let plain = format_size_i(value, opts.plain().options());
+    assert!(plain.contains("NaN") || plain.contains("inf"), "{plain:?}");
+    let text = format_size_i(value, opts.options());
+    assert_eq!(text.replace(|c: char| SEPARATORS.contains(&c), ""), plain.replace(|c: char| SEPARATORS.contains(&c), ""), "{text:?} vs {plain:?}");
+}
+
+#[hegel::test]
+fn non_ascii_separators_are_inserted_as_characters(tc: hegel::TestCase) {
+    // `thousands_separator` is an `Option<char>`: a non-ASCII separator (narrow no-break space,
+    // apostrophe-quote) must appear as itself
+    let mut opts = tc.draw(arb_opts()).plain();
+    let sep = tc.draw(generators::sampled_from(vec!['\u{a0}', '\u{202f}', '\u{2019}', '\u{2009}', 'é', '，']));
+    let mag = tc.draw(arb_mag());
+    let value = mag.min(i64::MAX as u64) as i64;
+    let plain = format_size_i(value, opts.options());
+    opts.sep = Some(0);
+    let text = format_size_i(value, opts.options().thousands_separator(Some(sep)));
+    assert_eq!(text, with_separators(&plain, sep), "value {value}");
+}
