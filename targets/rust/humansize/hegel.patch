+        assert_eq!(make_format_i(o)(v), reference);
+    }
+    assert_eq!(format_size_i(mag as i128, o), reference);
+    // a float holding the same integer renders the same
+    if mag < EXACT {
+        assert_eq!(format_size_i(mag as f64, o), reference);
+    }
+    if mag < 1 << 24 {
+        assert_eq!(format_size_i(mag as f32, o), reference);
