+// ---------------------------------------------------------------------------------------------
+// One narrow property per recorded bug: its shape region with random contents, judged by the
+// same oracles; under HEGEL_NO_KNOWN=1 the neighbouring region
+// ---------------------------------------------------------------------------------------------
+
+/// How many bytes short of a whole `unit` a value may be for its fraction to round up to the
+/// next unit at `places` decimals (half away from zero, as the separator path rounds): at least
+/// one, so that a unit too small for the decimals still draws a value.
+fn carry_band(unit: u64, places: usize) -> u64 {
+    ((unit as f64) * 0.5 * 10f64.powi(-(places as i32))).max(1.0) as u64
+}
+
+/// Values a hair short of `m` units — `m * unit - d`, the unit being the fixed one or the value's
+/// own (`kilo^exp`, `m` at least 2 so that the value keeps that unit), `d` within the band whose
+/// fraction rounds up to the next unit at the drawn decimals — humansize/1's region, where the
+/// separator path loses the carry; under HEGEL_NO_KNOWN=1 `d` lies beyond the band (the
+/// fraction rounds down). Below 2^53, so humansize/3 stays out.
+fn carrying_values(opts: &Opts) -> impl PrintableGenerator<u64> {
+    let kilo = opts.kilo();
+    let places = opts.places;
+    let (exps, m_min, m_cap) = match opts.fixed {
+        Some(k) => (ints(k as u32, k as u32), 1, u64::MAX),
+        None => (ints(1u32, 4), 2, kilo - 1),
+    };
+    tuples!(exps, ints(0u64, 2047), ints(0u64, u32::MAX as u64)).map(move |(exp, m_raw, d_raw)| {
+        let unit = kilo.pow(exp);
+        let m_max = ((EXACT - 1) / unit).min(m_cap).max(m_min);
+        let m = m_min + m_raw % (m_max - m_min + 1);
+        let band = carry_band(unit, places);
+        let d = if known_shapes() { 1 + d_raw % band } else { (band + 1 + d_raw % (unit - band).max(1)).min(unit) };
+        m * unit - d
+    })
+}
+
+/// The thousands-separator path must print the plain rendering with the integer part grouped.
+/// Non-negative values below 2^53 whose fraction rounds up to the next unit, with an ASCII
+/// separator: humansize/1's region, the carry lost; under HEGEL_NO_KNOWN=1 the fractions that
+/// round down, less the few whose tie the two paths break differently.
+#[hegel::test]
+fn grouped_renderings_are_the_plain_rendering_with_separators(tc: hegel::TestCase) {
+    let cases = Fields { fixed: optional(ints(0usize, 5)).boxed_printable(), ..Fields::grouped() }
+        .opts()
+        .flat_map(|opts| tuples!(carrying_values(&opts), just(opts)))
+        .filter(|(value, opts)| known_shapes() || number_bug(*value as f64, opts).is_none());
+    let (value, opts) = tc.draw(cases);
+    let plain = format_size(value, opts.plain().options());
+    let grouped = format_size(value, opts.options());
+    assert_eq!(grouped, with_separators(&plain, opts.sep.unwrap()), "value {value}");
+}
+
+/// Whole multiples `m * kilo^exp` (`m` below the kilo) of a unit at or above the fixed one, so
+/// that the quotient printed is whole and below 2^53.
+fn whole_multiples(opts: &Opts) -> impl PrintableGenerator<u64> {
+    let kilo = opts.kilo();
+    tuples!(ints(opts.fixed.unwrap_or(0) as u32, 4), ints(1u64, kilo - 1)).map(move |(exp, m)| m * kilo.pow(exp))
+}
+
+/// Negative values below 2^53 in magnitude with an ASCII separator: humansize/2's region, the
+/// decimals lost; under HEGEL_NO_KNOWN=1 the neighbouring region of whole quotients, whose
+/// decimals are all zeros.
+fn negative_grouped_cases() -> Gen<(i64, Opts)> {
+    if known_shapes() {
+        tuples!(exact_magnitudes(), Fields::grouped().opts()).map(|(m, opts)| (-(m as i64), opts)).boxed_printable()
+    } else {
+        Fields { fixed: optional(ints(0usize, 4)).boxed_printable(), ..Fields::grouped() }
+            .opts()
+            .flat_map(|opts| tuples!(whole_multiples(&opts), just(opts)))
+            .map(|(m, opts)| (-(m as i64), opts))
+            .boxed_printable()
+    }
+}
+
+#[hegel::test]
+fn grouped_negative_renderings_keep_their_decimals(tc: hegel::TestCase) {
+    let (value, opts) = tc.draw(negative_grouped_cases());
+    let plain = format_size_i(value, opts.plain().options());
+    let grouped = format_size_i(value, opts.options());
+    assert_eq!(grouped, with_separators(&plain, opts.sep.unwrap()), "value {value}");
+}
+
+const BEYOND_EXACT: &[u128] = &[EXACT as u128 + 2, u64::MAX as u128, 1 << 64, 22518100859373886, 10u128.pow(20)];
+
+/// Integer parts at or beyond 2^53: humansize/3's region, the drifting digits; under
+/// HEGEL_NO_KNOWN=1 the integer parts below it.
+fn integer_parts() -> Gen<u128> {
+    if known_shapes() {
+        one_of!(ints(EXACT as u128, u64::MAX as u128), ints(EXACT as u128, u128::MAX), sampled_from(BEYOND_EXACT)).boxed_printable()
+    } else {
+        ints(0u128, EXACT as u128 - 1).boxed_printable()
+    }
+}
+
+#[hegel::test]
+fn grouped_integer_parts_beyond_2_53_are_the_f64_digits(tc: hegel::TestCase) {
+    // fixed at the base unit so that the number printed is a whole f64: the digits must be that
+    // f64's decimal expansion, as the plain path prints it
+    let (value, opts) = tc.draw(tuples!(integer_parts(), Fields { fixed: only(Some(0)), ..Fields::grouped() }.opts()));
+    let plain = format_size(value, opts.plain().options());
+    let grouped = format_size(value, opts.options());
+    assert_eq!(grouped, with_separators(&plain, opts.sep.unwrap()), "value {value}");
+}
+
+/// Values with an integer part of four digits or more in the fixed unit — `q * unit + r`, `q` at
+/// least 1000 and `r` below the band that rounds up (humansize/1 is a neighbour, not this
+/// property's) — the region where a separator is written. Below 2^53, so the fixed level is at
+/// most 4 and humansize/3 stays out.
+fn separated_values(opts: &Opts) -> impl PrintableGenerator<u64> {
+    let unit = opts.kilo().pow(opts.fixed.expect("a fixed unit") as u32);
+    let band = carry_band(unit, opts.places);
+    tuples!(ints(1000u64, (EXACT - 1) / unit - 1), ints(0u64, u32::MAX as u64))
+        .map(move |(q, r_raw)| q * unit + r_raw % (unit - band).max(1))
+}
+
+#[hegel::test]
+fn non_ascii_separators_are_inserted_as_characters(tc: hegel::TestCase) {
+    // `thousands_separator` is an `Option<char>`: a non-ASCII separator (no-break space,
+    // apostrophe-quote, ...) must appear as itself — humansize/4's region, with a separator
+    // written; under HEGEL_NO_KNOWN=1 the ASCII separators
+    let sep = if known_shapes() { non_ascii_grouping() } else { ascii_grouping() };
+    let cases = Fields { fixed: ints(0usize, 4).map(Some).boxed_printable(), sep, ..Fields::any() }
+        .opts()
+        .flat_map(|opts| tuples!(separated_values(&opts), just(opts)))
+        .filter(|(value, opts)| number_bug(*value as f64, opts).is_none());
+    let (value, opts) = tc.draw(cases);
+    let plain = format_size(value, opts.plain().options());
+    let grouped = format_size(value, opts.options());
+    assert_eq!(grouped, with_separators(&plain, opts.sep.unwrap()), "value {value}");
+}
+
+#[hegel::test]
+fn non_finite_inputs_render_their_float_spelling(tc: hegel::TestCase) {
+    // `NaN B`, `inf YB`: whatever the option set, a Display impl must not panic or spin — with a
+    // thousands separator too (humansize/5's region, rendered in a child process); under
+    // HEGEL_NO_KNOWN=1 the non-finite values render without a separator
+    let sep = if known_shapes() { ascii_grouping() } else { only(None) };
+    let (value, opts) = tc.draw(tuples!(sampled_from(NON_FINITE), Fields { sep, ..Fields::any() }.opts()));
+    let plain = format_size_i(value, opts.plain().options());
+    assert!(plain.contains("NaN") || plain.contains("inf"), "{plain:?}");
+    if let Some(sep) = opts.sep {
+        match render_in_child(value, &opts) {
+            Rendered::Text(text) => assert_eq!(text, with_separators(&plain, sep), "{value} with the separator {sep:?}"),
+            failed => panic!("rendering {value} with the separator {sep:?}: {failed:?}"),
+        }
+    }
+}
+
+/// Quotients of 1.x — `unit + r`, `r` below the unit, the unit being the fixed one or the
+/// value's own (`kilo^exp`) — where the singular applies: negated half the time (a negative value
+/// is never singular, half of humansize/6) and, half the time, with `r` in the band that rounds
+/// the printed number up to 2 (the crate still singularises, the other half). Under
+/// HEGEL_NO_KNOWN=1 positive and below the band.
+fn singular_values(opts: &Opts) -> impl PrintableGenerator<i128> {
+    let kilo = opts.kilo();
+    let places = opts.places;
+    let exps = match opts.fixed {
+        Some(k) => ints(k as u32, k as u32),
+        None => ints(0u32, 5),
+    };
+    let shapes: Gen<(bool, bool)> = if known_shapes() { tuples!(booleans(), booleans()).boxed_printable() } else { only((false, false)) };
+    tuples!(exps, ints(0u64, EXACT), shapes).map(move |(exp, r_raw, (crossing, negative))| {
+        let unit = kilo.pow(exp);
+        let band = carry_band(unit, places);
+        let r = if crossing { unit - 1 - r_raw % band } else if known_shapes() { r_raw % unit } else { r_raw % (unit - band).max(1) };
+        let value = (unit + r) as i128;
+        if negative { -value } else { value }
+    })
+}
+
+#[hegel::test]
+fn pluralisation_follows_the_printed_value(tc: hegel::TestCase) {
+    // long units (and the bare `bits`) are singular exactly when the printed number is 1.xx:
+    // humansize/6's region; under HEGEL_NO_KNOWN=1 the few values whose rounding still crosses
+    // 2 are left out too
+    let cases = Fields { long: only(true), sep: only(None), fixed: optional(ints(0usize, 5)).boxed_printable(), ..Fields::any() }
+        .opts()
+        .flat_map(|opts| tuples!(singular_values(&opts), just(opts)))
+        .filter(|(value, opts)| known_shapes() || !mis_singularised(*value as f64, opts));
+    let (value, opts) = tc.draw(cases);
+    let text = format_size_i(value, opts.options());
+    let k = {
+        let d = opts.divider() as u128;
+        let mag = (value as f64).abs() as u128;
+        match opts.fixed {
+            Some(k) => k,
+            None => { let mut k = 0; while k < 8 && mag >= d.pow(k as u32 + 1) { k += 1; } k }
+        }
+    };
+    check_unit(&text, &opts, k, false);
+}
+
+#[hegel::test]
+fn long_binary_bit_table_is_capitalised(tc: hegel::TestCase) {
+    // the long binary bit scale spells its first entry `bits` while the decimal one and every
+    // other long unit are capitalised (`Bits`, `Kibibits`): whole counts of 2 to 999 bits in long
+    // units under either table (humansize/7's region); under HEGEL_NO_KNOWN=1 the decimal table
+    let units_binary = if known_shapes() { booleans().boxed_printable() } else { only(false) };
+    let fields = Fields { bits: only(true), long: only(true), units_binary, fixed: only(None), sep: only(None), ..Fields::any() };
+    let (mag, opts) = tc.draw(tuples!(ints(2u64, 999), fields.opts()));
+    let text = format_size(mag, opts.options());
+    check_unit(&text, &opts, 0, true);
+}
+
+/// Finite floats whose integer part in the yotta unit runs to 75 digits and more (|value| from
+/// 1e99 to `f64::MAX`, log-uniform): humansize/8's region, where the separator path's 100-byte
+/// buffer overflows; under HEGEL_NO_KNOWN=1 1e30 to 1e85, which fit with any decimals.
+fn huge_floats() -> impl PrintableGenerator<f64> {
+    let exps = if known_shapes() { ints(99i32, 308) } else { ints(30i32, 85) };
+    tuples!(exps, ints(100u32, 999), booleans()).map(|(exp, m, negative)| {
+        let value = (m as f64 / 100.0) * 10f64.powi(exp);
+        if negative { -value } else { value }
+    })
+}
+
+#[hegel::test]
+fn grouped_huge_floats_render_without_panicking(tc: hegel::TestCase) {
+    // a thousands separator on a value of a hundred-odd digits: `Display` must render it (the
+    // digits beyond 2^53 are humansize/3's, not judged here) with the plain rendering's unit and
+    // suffix - humansize/8's region
+    let (value, opts) = tc.draw(tuples!(huge_floats(), Fields { sep: ascii_grouping(), ..Fields::any() }.opts()));
+    let plain = format_size_i(value, opts.plain().options());
+    let grouped = format_size_i(value, opts.options());
+    let (mantissa, rest) = split_mantissa(&grouped);
+    assert_eq!(rest, split_mantissa(&plain).1, "unit of {value:e}: {grouped:?} against {plain:?}");
+    assert!(mantissa.trim_start_matches('-').chars().all(|c| c.is_ascii_digit() || c == '.' || Some(c) == opts.sep), "mantissa of {value:e}: {grouped:?}");
+}
