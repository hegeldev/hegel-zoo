+//! Hegel properties for humansize.
+//!
+//! Oracles: exact integer arithmetic (`i128`) for the unit choice and the mantissa — the unit is
+//! the largest power of the kilo that fits the value (or the fixed one), the mantissa has exactly
+//! the requested decimals and sits within half a last digit of the exact quotient — the crate's
+//! documented tables of unit spellings, and the plain rendering as the oracle for the
+//! thousands-separator path (which must be the plain text with separators inserted into the
+//! integer part).
+#![allow(clippy::all, dead_code)]
+
+use hegel::generators;
+use humansize::{
+    format_size, format_size_i, make_format, make_format_i, BaseUnit, FixedAt, FormatSize,
+    FormatSizeI, FormatSizeOptions, ISizeFormatter, Kilo, SizeFormatter, BINARY, DECIMAL, WINDOWS,
+};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+macro_rules! pp {
+    ($($t:ty),*) => {$(
+        impl hegel::PrettyPrintable for $t {
+            fn pretty_print(&self, printer: &mut hegel::pretty::PrettyPrinter) {
+                hegel::pretty::print_debug_repr(&format!("{self:?}"), printer);
+            }
+        }
+    )*};
+}
+
+const DEC: [&str; 9] = ["B", "kB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB"];
+const DEC_LONG: [&str; 9] = ["Bytes", "Kilobytes", "Megabytes", "Gigabytes", "Terabytes", "Petabytes", "Exabytes", "Zettabytes", "Yottabytes"];
+const BIN: [&str; 9] = ["B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB", "ZiB", "YiB"];
+const BIN_LONG: [&str; 9] = ["Bytes", "Kibibytes", "Mebibytes", "Gibibytes", "Tebibytes", "Pebibytes", "Exbibytes", "Zebibytes", "Yobibytes"];
+const DEC_BIT: [&str; 9] = ["bits", "kbit", "Mbit", "Gbit", "Tbit", "Pbit", "Ebit", "Zbit", "Ybit"];
+const DEC_BIT_LONG: [&str; 9] = ["Bits", "Kilobits", "Megabits", "Gigabits", "Terabits", "Petabits", "Exabits", "Zettabits", "Yottabits"];
+const BIN_BIT: [&str; 9] = ["bits", "Kibit", "Mibit", "Gibit", "Tibit", "Pibit", "Eibit", "Zibit", "Yibit"];
+/// The crate spells the first entry `bits` (lower case) while every other long unit and the
+/// decimal table's `Bits` are capitalised; the general properties use the crate's spelling and
+/// `long_binary_bit_table_is_capitalised` pins the slip.
+const BIN_BIT_LONG: [&str; 9] = ["bits", "Kibibits", "Mebibits", "Gibibits", "Tebibits", "Pebibits", "Exbibits", "Zebibits", "Yobibits"];
+
+const FIXED: [FixedAt; 9] = [FixedAt::Base, FixedAt::Kilo, FixedAt::Mega, FixedAt::Giga, FixedAt::Tera, FixedAt::Peta, FixedAt::Exa, FixedAt::Zetta, FixedAt::Yotta];
+const SUFFIXES: [&str; 5] = ["", "/s", "/day", " total", "ps"];
+const SEPARATORS: [char; 5] = [',', ' ', '_', '\'', '.'];
+
+/// The option set under test, in plain data; `options()` builds the crate's struct.
+#[derive(Debug, Clone, Copy, PartialEq)]
+struct Opts {
+    bits: bool,
+    kilo_binary: bool,
+    units_binary: bool,
+    places: usize,
+    zeroes: usize,
+    fixed: Option<usize>,
+    long: bool,
+    space: bool,
+    suffix: usize,
+    sep: Option<usize>,
+}
+pp!(Opts);
+
+impl Opts {
+    fn options(&self) -> FormatSizeOptions {
+        let base = if self.kilo_binary { BINARY } else { DECIMAL };
+        FormatSizeOptions::from(base)
+            .base_unit(if self.bits { BaseUnit::Bit } else { BaseUnit::Byte })
+            .kilo(if self.kilo_binary { Kilo::Binary } else { Kilo::Decimal })
+            .units(if self.units_binary { Kilo::Binary } else { Kilo::Decimal })
+            .decimal_places(self.places)
+            .decimal_zeroes(self.zeroes)
+            .fixed_at(self.fixed.map(|i| FIXED[i]))
+            .long_units(self.long)
+            .space_after_value(self.space)
+            .suffix(SUFFIXES[self.suffix])
+            .thousands_separator(self.sep.map(|i| SEPARATORS[i]))
+    }
+    fn plain(&self) -> Opts {
+        Opts { sep: None, ..*self }
+    }
+    fn divider(&self) -> i128 {
+        if self.kilo_binary { 1024 } else { 1000 }
+    }
+    fn table(&self) -> [&'static str; 9] {
+        match (self.units_binary, self.long, self.bits) {
+            (false, false, false) => DEC,
+            (false, true, false) => DEC_LONG,
+            (true, false, false) => BIN,
+            (true, true, false) => BIN_LONG,
+            (false, false, true) => DEC_BIT,
+            (false, true, true) => DEC_BIT_LONG,
+            (true, false, true) => BIN_BIT,
+            (true, true, true) => BIN_BIT_LONG,
+        }
+    }
+    /// Whether the unit at `k` is pluralised (and so has a singular form).
+    fn pluralised(&self, k: usize) -> bool {
+        self.long || (self.bits && k == 0)
+    }
+    fn separator(&self) -> Option<char> {
+        self.sep.map(|i| SEPARATORS[i])
+    }
+}
+
+#[hegel::composite]
+fn arb_opts(tc: &hegel::TestCase) -> Opts {
+    let preset = tc.draw(int!(0u8, 3));
+    let (kilo_binary, units_binary) = match preset {
+        0 => (false, false),
+        1 => (true, true),
+        2 => (true, false),
+        _ => (tc.draw(generators::booleans()), tc.draw(generators::booleans())),
+    };
+    Opts {
+        bits: tc.draw(generators::booleans()),
+        kilo_binary,
+        units_binary,
+        places: tc.draw(int!(0usize, 10)),
+        zeroes: tc.draw(int!(0usize, 5)),
+        fixed: if tc.draw(generators::booleans()) { None } else { Some(tc.draw(int!(0usize, 8))) },
+        long: tc.draw(generators::booleans()),
+        space: tc.draw(generators::booleans()),
+        suffix: tc.draw(int!(0usize, SUFFIXES.len() - 1)),
+        sep: if tc.draw(generators::booleans()) { None } else { Some(tc.draw(int!(0usize, SEPARATORS.len() - 1))) },
+    }
+}
+
+/// A byte count over the whole `u64` range with a bias to the unit boundaries, to rounding ties
+/// and to the 2⁵³ edge of exact `f64` integers.
+#[hegel::composite]
+fn arb_mag(tc: &hegel::TestCase) -> u64 {
+    match tc.draw(int!(0u8, 7)) {
+        0 => tc.draw(int!(0u64, u64::MAX)),
+        1 => tc.draw(int!(0u64, 2100)),
+        2 => tc.draw(int!(0u64, 1 << 53)),
+        3 | 4 => {
+            let d: u64 = if tc.draw(generators::booleans()) { 1000 } else { 1024 };
+            let e = tc.draw(int!(1u32, 6));
+            let delta = tc.draw(int!(-3i64, 3));
+            let mult = tc.draw(generators::sampled_from(vec![1u64, 1, 1, 2, 7, 999, 1023, 1024, 125, 128, 1999, 2048]));
+            d.pow(e).saturating_mul(mult).saturating_add_signed(delta)
+        }
+        5 => {
+            // a mantissa with a rounding tie or a near-carry (x.995, x.9995) in the decimals
+            let d: u64 = if tc.draw(generators::booleans()) { 1000 } else { 1024 };
+            let e = tc.draw(int!(1u32, 5));
+            let m = tc.draw(generators::sampled_from(vec![1005u64, 1015, 1995, 1999, 9995, 9999, 10005, 19995, 1000005, 999995]));
+            let scale = tc.draw(generators::sampled_from(vec![1000u64, 10_000, 1_000_000]));
+            ((d.pow(e) as u128 * m as u128) / scale as u128).min(u64::MAX as u128) as u64
+        }
+        6 => {
+            // 1.x and 0.99x of a unit: pluralisation and carries
+            let d: u64 = if tc.draw(generators::booleans()) { 1000 } else { 1024 };
+            let e = tc.draw(int!(1u32, 5));
+            let permille = tc.draw(int!(900u64, 2100));
+            ((d.pow(e) as u128 * permille as u128) / 1000).min(u64::MAX as u128) as u64
+        }
+        _ => tc.draw(generators::sampled_from(vec![0, 1, 2, 999, 1000, 1001, 1023, 1024, 1025, 1500, 1999, 2000, u64::MAX, u64::MAX - 1, 1 << 63, (1 << 53) - 1, 1 << 53, (1 << 53) + 1])),
+    }
+}
+
+/// Insert `sep` every three digits into the integer part of a plain rendering.
+fn with_separators(plain: &str, sep: char) -> String {
+    let (mantissa, rest) = split_mantissa(plain);
+    let (sign, digits) = if let Some(d) = mantissa.strip_prefix('-') { ("-", d) } else { ("", mantissa) };
+    let (int_part, frac) = match digits.find('.') {
+        Some(i) => (&digits[..i], &digits[i..]),
+        None => (digits, ""),
+    };
+    let mut grouped = String::new();
+    for (i, c) in int_part.chars().enumerate() {
+        if i > 0 && (int_part.len() - i) % 3 == 0 {
+            grouped.push(sep);
+        }
+        grouped.push(c);
+    }
+    format!("{sign}{grouped}{frac}{rest}")
+}
+
+/// Split a rendering into its leading number (`-?[0-9.]+`) and the rest.
+fn split_mantissa(text: &str) -> (&str, &str) {
+    let end = text
+        .char_indices()
+        .find(|&(i, c)| !(c.is_ascii_digit() || c == '.' || (c == '-' && i == 0)))
+        .map(|(i, _)| i)
+        .unwrap_or(text.len());
+    text.split_at(end)
+}
+
+/// What the plain rendering of `value` must look like, checked structurally.
+fn check_rendering(value: i128, opts: &Opts, text: &str) {
+    assert!(opts.sep.is_none());
+    let d = opts.divider();
+    // the crate converts to f64 first; the value it renders is that f64
+    let fv = value as f64;
+    let vr = fv as i128;
+    let mag = vr.unsigned_abs();
+    let k = match opts.fixed {
+        Some(k) => k,
+        None => {
+            let mut k = 0;
+            while k < 8 && mag as u128 >= (d as u128).pow(k as u32 + 1) {
+                k += 1;
+            }
+            k
+        }
+    };
+    let dk = (d as u128).pow(k as u32);
+    let (mantissa, rest) = split_mantissa(text);
+    // the tail: space, unit (plural or singular), suffix
+    let table = opts.table();
+    let suffix = SUFFIXES[opts.suffix];
+    let space = if opts.space { " " } else { "" };
+    let plural = format!("{space}{}{suffix}", table[k]);
+    let singular = format!("{space}{}{suffix}", &table[k][..table[k].len() - 1]);
+    let int_text = mantissa.trim_start_matches('-').split('.').next().unwrap();
+    if opts.pluralised(k) {
+        assert!(
+            rest == plural || rest == singular,
+            "tail {rest:?} of {text:?} is neither {plural:?} nor {singular:?}"
+        );
+        if value >= 0 {
+            // pinned separately for the rounding cases: the plain rule (`1.x` → singular) holds
+            // whenever the printed integer part and the truncated quotient agree
+            let trunc_is_one = mag / dk == 1;
+            let printed_is_one = int_text == "1";
+            if trunc_is_one == printed_is_one {
+                assert_eq!(rest == singular, printed_is_one, "pluralisation of {text:?}");
+            }
+        }
+    } else {
+        assert_eq!(rest, plural, "tail of {text:?}");
+    }
+    // the mantissa: sign, digits, decimals
+    assert_eq!(mantissa.starts_with('-'), value < 0 && text != "0", "sign of {text:?} for {value}");
+    let digits = mantissa.trim_start_matches('-');
+    let (int_text, frac_text) = match digits.find('.') {
+        Some(i) => (&digits[..i], &digits[i + 1..]),
+        None => (digits, ""),
+    };
+    assert!(!int_text.is_empty() && int_text.bytes().all(|b| b.is_ascii_digit()), "integer part of {text:?}");
+    assert!(frac_text.bytes().all(|b| b.is_ascii_digit()), "fraction of {text:?}");
+    assert!(int_text == "0" || !int_text.starts_with('0'), "leading zero in {text:?}");
+    // how many decimals: `decimal_zeroes` for a whole quotient, `decimal_places` otherwise; a
+    // quotient within a couple of f64 ulps of a whole number may go either way
+    let rem = mag as u128 % dk;
+    let whole = rem == 0;
+    let s_mag = (mag as u128).max(dk) as f64 / dk as f64;
+    let frac = rem as f64 / dk as f64;
+    let near_whole = frac < s_mag * 2f64.powi(-50) || 1.0 - frac < s_mag * 2f64.powi(-50);
+    let p = frac_text.len();
+    if whole {
+        assert_eq!(p, opts.zeroes, "decimals of the whole quotient {text:?}");
+    } else if near_whole {
+        assert!(p == opts.zeroes || p == opts.places, "decimals of {text:?}");
+    } else {
+        assert_eq!(p, opts.places, "decimals of {text:?}");
+    }
+    // the printed mantissa M/10^p is within half a last digit (plus the f64 error) of mag/d^k:
+    // |M·d^k − mag·10^p| ≤ d^k/2 + slack
+    let m: u128 = format!("{int_text}{frac_text}").parse().unwrap_or(u128::MAX);
+    let ten_p = 10u128.pow(p as u32);
+    let lhs = m.checked_mul(dk).expect("mantissa far too large");
+    let rhs = mag as u128 * ten_p;
+    let diff = lhs.abs_diff(rhs);
+    let slack = dk / 2 + (rhs >> 47) + 1;
+    assert!(diff <= slack, "{text:?} for {value}: |{m}·{dk} − {mag}·10^{p}| = {diff} > {slack}");
+}
+
+#[hegel::test]
+fn renderings_have_the_right_unit_and_a_correctly_rounded_mantissa(tc: hegel::TestCase) {
+    let opts = tc.draw(arb_opts()).plain();
+    let mag = tc.draw(arb_mag());
+    let negative = tc.draw(generators::booleans());
+    let value: i128 = if negative { -(mag.min(i64::MAX as u64) as i128) } else { mag as i128 };
+    let text = if value >= 0 {
+        format_size(mag, opts.options())
+    } else {
+        format_size_i(value as i64, opts.options())
+    };
+    check_rendering(value, &opts, &text);
+    // the three presets are what their names say
+    if opts.fixed.is_none() && !opts.bits && !opts.long && opts.places == 2 && opts.zeroes == 0 && opts.space && opts.suffix == 0 {
+        let preset = match (opts.kilo_binary, opts.units_binary) {
+            (false, false) => Some(DECIMAL),
+            (true, true) => Some(BINARY),
+            (true, false) => Some(WINDOWS),
+            _ => None,
+        };
+        if let Some(preset) = preset {
+            assert_eq!(format_size_i(value as i64, preset), text);
+        }
+    }
+}
+
+#[hegel::composite]
+fn arb_grouping_opts(tc: &hegel::TestCase) -> Opts {
+    let mut opts = tc.draw(arb_opts());
+    if opts.sep.is_none() {
+        opts.sep = Some(tc.draw(int!(0usize, SEPARATORS.len() - 1)));
+    }
+    opts
+}
+
+/// The thousands-separator path must print the plain rendering with the integer part grouped.
+/// Split by domain because each part fails for its own reason (humansize/1–3).
+#[hegel::test]
+fn grouped_renderings_are_the_plain_rendering_with_separators(tc: hegel::TestCase) {
+    // non-negative values below 2^53
+    let opts = tc.draw(arb_grouping_opts());
+    let value = tc.draw(arb_mag()).min((1 << 53) - 1);
+    let plain = format_size(value, opts.plain().options());
+    let grouped = format_size(value, opts.options());
+    assert_eq!(grouped, with_separators(&plain, opts.separator().unwrap()), "value {value}, options {opts:?}");
+}
+
+#[hegel::test]
+fn grouped_negative_renderings_keep_their_decimals(tc: hegel::TestCase) {
+    let opts = tc.draw(arb_grouping_opts());
+    let value = -(tc.draw(arb_mag()).min((1 << 53) - 1) as i64);
+    let plain = format_size_i(value, opts.plain().options());
+    let grouped = format_size_i(value, opts.options());
+    assert_eq!(grouped, with_separators(&plain, opts.separator().unwrap()), "value {value}, options {opts:?}");
+}
+
+#[hegel::test]
+fn grouped_integer_parts_beyond_2_53_are_the_f64_digits(tc: hegel::TestCase) {
+    // fixed at the base unit so that the number printed is a whole f64: the digits must be that
+    // f64's decimal expansion, as the plain path prints it
+    let mut opts = tc.draw(arb_grouping_opts());
+    opts.fixed = Some(0);
+    let value: u128 = match tc.draw(int!(0u8, 2)) {
+        0 => tc.draw(int!(1u128 << 53, u64::MAX as u128)),
+        1 => tc.draw(int!(1u128 << 53, u128::MAX)),
+        _ => tc.draw(generators::sampled_from(vec![(1u128 << 53) + 2, u64::MAX as u128, 1u128 << 64, 22518100859373886, 10u128.pow(20)])),
+    };
+    let plain = format_size(value, opts.plain().options());
+    let grouped = format_size(value, opts.options());
+    assert_eq!(grouped, with_separators(&plain, opts.separator().unwrap()), "value {value}, options {opts:?}");
+}
