+//! Hegel properties for humansize.
+//!
+//! Oracles: exact integer arithmetic (`u128`) for the unit choice and the mantissa — the unit is
+//! the largest power of the kilo that fits the value (or the fixed one), the mantissa has exactly
+//! the requested decimals and sits within half a last digit of the exact quotient — the crate's
+//! documented tables of unit spellings, and the plain rendering as the oracle for the
+//! thousands-separator path (which must be the plain text with separators inserted into the
+//! integer part).
+//!
+//! Generators are values built from the binding's combinators: a case is a small record (the
+//! option set `Opts`, drawn field by field through `Fields`, and a value) rendered by pure
+//! functions. The shapes of the recorded bugs are drawn by default, so the properties that reach
+//! them are the declared expected failures; `HEGEL_NO_KNOWN=1` (read once, `known_shapes`)
+//! switches the shapes off: non-ASCII separators are not drawn, a negative or non-finite value
+//! draws no separator, and the cases the shape predicates (`grouping_bug`, `mis_singularised`,
+//! `lowercase_bits`) recognise as a recorded shape are filtered out or left unjudged.
+#![allow(clippy::all, dead_code)]
+
+use std::collections::HashMap;
+use std::process::{Command, Stdio};
+use std::sync::{LazyLock, Mutex};
+use std::time::{Duration, Instant};
+
+use hegel::generators::{
+    self, booleans, floats, just, optional, sampled_from, BoxedPrintableGenerator, Generator,
+    Integer, IntegerGenerator, SampledFromGenerator,
+};
+use hegel::{one_of, tuples, PrettyPrintable, PrintableGenerator};
+use humansize::{
+    format_size, format_size_i, make_format, make_format_i, BaseUnit, FixedAt, FormatSize,
+    FormatSizeI, FormatSizeOptions, ISizeFormatter, Kilo, SizeFormatter, BINARY, DECIMAL, WINDOWS,
+};
+use libm::{fabs, modf, pow, round};
+
+// ---------------------------------------------------------------------------------------------
+// Known shapes
+// ---------------------------------------------------------------------------------------------
+
+/// Whether the generators draw the shapes of the recorded bugs (humansize/1-7). On by default,
+/// so the properties find the bugs and are the declared expected failures; `HEGEL_NO_KNOWN=1`
+/// switches the shapes off for a run that looks past them.
+static KNOWN_SHAPES: LazyLock<bool> =
+    LazyLock::new(|| std::env::var("HEGEL_NO_KNOWN").map_or(true, |v| v != "1"));
+
+fn known_shapes() -> bool {
+    *KNOWN_SHAPES
+}
+
+// ---------------------------------------------------------------------------------------------
+// Tables
+// ---------------------------------------------------------------------------------------------
+
+const DEC: [&str; 9] = ["B", "kB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB"];
+const DEC_LONG: [&str; 9] = ["Bytes", "Kilobytes", "Megabytes", "Gigabytes", "Terabytes", "Petabytes", "Exabytes", "Zettabytes", "Yottabytes"];
+const BIN: [&str; 9] = ["B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB", "ZiB", "YiB"];
+const BIN_LONG: [&str; 9] = ["Bytes", "Kibibytes", "Mebibytes", "Gibibytes", "Tebibytes", "Pebibytes", "Exbibytes", "Zebibytes", "Yobibytes"];
+const DEC_BIT: [&str; 9] = ["bits", "kbit", "Mbit", "Gbit", "Tbit", "Pbit", "Ebit", "Zbit", "Ybit"];
+const DEC_BIT_LONG: [&str; 9] = ["Bits", "Kilobits", "Megabits", "Gigabits", "Terabits", "Petabits", "Exabits", "Zettabits", "Yottabits"];
+const BIN_BIT: [&str; 9] = ["bits", "Kibit", "Mibit", "Gibit", "Tibit", "Pibit", "Eibit", "Zibit", "Yibit"];
+/// Every long unit is capitalised, the decimal table's `Bits` included; the crate spells this
+/// table's first entry `bits` (humansize/7), which `long_binary_bit_table_is_capitalised` and
+/// the tail checks of the wide properties find.
+const BIN_BIT_LONG: [&str; 9] = ["Bits", "Kibibits", "Mebibits", "Gibibits", "Tebibits", "Pebibits", "Exbibits", "Zebibits", "Yobibits"];
+
+const FIXED: [FixedAt; 9] = [FixedAt::Base, FixedAt::Kilo, FixedAt::Mega, FixedAt::Giga, FixedAt::Tera, FixedAt::Peta, FixedAt::Exa, FixedAt::Zetta, FixedAt::Yotta];
+const SUFFIXES: &[&str] = &["", "/s", "/day", " total", "ps"];
+const ASCII_SEPARATORS: &[char] = &[',', ' ', '_', '\'', '.'];
+/// No-break space, narrow no-break space, right single quotation mark (the Swiss grouping
+/// character), thin space, e with acute, fullwidth comma: the separators humansize/4 mangles.
+const NON_ASCII_SEPARATORS: &[char] = &['\u{a0}', '\u{202f}', '\u{2019}', '\u{2009}', '\u{e9}', '\u{ff0c}'];
+
+/// 2^53: the integers above it are not all `f64`s.
+const EXACT: u64 = 1 << 53;
+
+// ---------------------------------------------------------------------------------------------
+// The option set, as data
+// ---------------------------------------------------------------------------------------------
+
+/// The option set under test, in plain data; `options()` builds the crate's struct.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PrettyPrintable)]
+struct Opts {
+    bits: bool,
+    kilo_binary: bool,
+    units_binary: bool,
+    places: usize,
+    zeroes: usize,
+    fixed: Option<usize>,
+    long: bool,
+    space: bool,
+    suffix: &'static str,
+    sep: Option<char>,
+}
+
+impl Opts {
+    fn options(&self) -> FormatSizeOptions {
+        let base = if self.kilo_binary { BINARY } else { DECIMAL };
+        FormatSizeOptions::from(base)
+            .base_unit(if self.bits { BaseUnit::Bit } else { BaseUnit::Byte })
+            .kilo(if self.kilo_binary { Kilo::Binary } else { Kilo::Decimal })
+            .units(if self.units_binary { Kilo::Binary } else { Kilo::Decimal })
+            .decimal_places(self.places)
+            .decimal_zeroes(self.zeroes)
+            .fixed_at(self.fixed.map(|i| FIXED[i]))
+            .long_units(self.long)
+            .space_after_value(self.space)
+            .suffix(self.suffix)
+            .thousands_separator(self.sep)
+    }
+    fn plain(&self) -> Opts {
+        Opts { sep: None, ..*self }
+    }
+    fn kilo(&self) -> u64 {
+        if self.kilo_binary { 1024 } else { 1000 }
+    }
+    fn divider(&self) -> i128 {
+        self.kilo() as i128
+    }
+    fn table(&self) -> [&'static str; 9] {
+        match (self.units_binary, self.long, self.bits) {
+            (false, false, false) => DEC,
+            (false, true, false) => DEC_LONG,
+            (true, false, false) => BIN,
+            (true, true, false) => BIN_LONG,
+            (false, false, true) => DEC_BIT,
+            (false, true, true) => DEC_BIT_LONG,
+            (true, false, true) => BIN_BIT,
+            (true, true, true) => BIN_BIT_LONG,
+        }
+    }
+    /// Whether the unit at `k` is pluralised (and so has a singular form).
+    fn pluralised(&self, k: usize) -> bool {
+        self.long || (self.bits && k == 0)
+    }
+    /// The record as one line, for the child process (`decode` reads it back).
+    fn encode(&self) -> String {
+        format!(
+            "{};{};{};{};{};{};{};{};{};{}",
+            self.bits as u8,
+            self.kilo_binary as u8,
+            self.units_binary as u8,
+            self.places,
+            self.zeroes,
+            self.fixed.map_or(9, |k| k),
+            self.long as u8,
+            self.space as u8,
+            self.sep.map_or(0, |c| c as u32),
+            self.suffix,
+        )
+    }
+    fn decode(text: &str) -> Opts {
+        let fields: Vec<&str> = text.splitn(10, ';').collect();
+        let flag = |i: usize| fields[i] == "1";
+        let num = |i: usize| fields[i].parse::<usize>().expect("a numeric field of the case");
+        Opts {
+            bits: flag(0),
+            kilo_binary: flag(1),
+            units_binary: flag(2),
+            places: num(3),
+            zeroes: num(4),
+            fixed: Some(num(5)).filter(|&k| k < 9),
+            long: flag(6),
+            space: flag(7),
+            suffix: SUFFIXES.iter().copied().find(|s| *s == fields[9]).expect("a suffix of the table"),
+            sep: char::from_u32(num(8) as u32).filter(|c| *c != '\0'),
+        }
+    }
+}
+
+/// The crate's three presets.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PrettyPrintable)]
+enum Preset {
+    Decimal,
+    Binary,
+    Windows,
+}
+
+const PRESETS: &[Preset] = &[Preset::Decimal, Preset::Binary, Preset::Windows];
+
+impl Preset {
+    fn constant(self) -> FormatSizeOptions {
+        match self {
+            Preset::Decimal => DECIMAL,
+            Preset::Binary => BINARY,
+            Preset::Windows => WINDOWS,
+        }
+    }
+    /// What the preset's name says: kilo 1000 and SI units, 1024 and IEC units, 1024 and SI
+    /// units; two decimals, none for a whole quotient, a space, no suffix.
+    fn opts(self) -> Opts {
+        Opts {
+            bits: false,
+            kilo_binary: self != Preset::Decimal,
+            units_binary: self == Preset::Binary,
+            places: 2,
+            zeroes: 0,
+            fixed: None,
+            long: false,
+            space: true,
+            suffix: "",
+            sep: None,
+        }
+    }
+}
+
+/// An option set: a custom record or one of the presets.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, PrettyPrintable)]
+enum Options {
+    Custom(Opts),
+    Preset(Preset),
+}
+
+impl Options {
+    fn opts(self) -> Opts {
+        match self {
+            Options::Custom(opts) => opts,
+            Options::Preset(preset) => preset.opts(),
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Generators
+// ---------------------------------------------------------------------------------------------
+
+type Gen<T> = BoxedPrintableGenerator<'static, T>;
+
+fn ints<T: Integer>(lo: T, hi: T) -> IntegerGenerator<T> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// A field pinned to one value.
+fn only<T: PrettyPrintable + Clone + Send + Sync + 'static>(value: T) -> Gen<T> {
+    just(value).boxed_printable()
+}
+
+/// `other` with probability `pct` percent, else `plain`, the shrink target (`weighted_booleans`
+/// shrinks to false).
+fn either<T: PrettyPrintable + Clone + Send + Sync + 'static>(pct: u32, plain: Gen<T>, other: Gen<T>) -> impl PrintableGenerator<T> + Send + Sync + 'static {
+    generators::weighted_booleans(pct as f64 / 100.0).flat_map(move |o| if o { other.clone() } else { plain.clone() })
+}
+
+fn ascii_separators() -> SampledFromGenerator<'static, char> {
+    sampled_from(ASCII_SEPARATORS)
+}
+
+/// A thousands separator: one of the five ASCII grouping characters (first) or, while the known
+/// shapes are drawn, one time in four a non-ASCII one (humansize/4).
+fn separators() -> Gen<char> {
+    let ascii = ascii_separators().boxed_printable();
+    if known_shapes() {
+        either(25, ascii, sampled_from(NON_ASCII_SEPARATORS).boxed_printable()).boxed_printable()
+    } else {
+        ascii
+    }
+}
+
+/// The separator field of the wide properties: absent (first) or a separator — or never one
+/// when `allowed` is false, which is how a negative or non-finite value is kept off the
+/// separator path under `HEGEL_NO_KNOWN=1` (humansize/2, /5 live there).
+fn grouping(allowed: bool) -> Gen<Option<char>> {
+    if allowed { optional(separators()).boxed_printable() } else { only(None) }
+}
+
+/// Always an ASCII separator: the narrow grouping properties' region.
+fn ascii_grouping() -> Gen<Option<char>> {
+    ascii_separators().map(Some).boxed_printable()
+}
+
+/// Always a non-ASCII separator: humansize/4's region.
+fn non_ascii_grouping() -> Gen<Option<char>> {
+    sampled_from(NON_ASCII_SEPARATORS).map(Some).boxed_printable()
+}
+
+/// One generator per field of `Opts`. `Fields::any()` draws every field over its whole range
+/// and a property narrows the fields of its shape: `Fields { long: only(true), ..Fields::any() }`.
+struct Fields {
+    bits: Gen<bool>,
+    kilo_binary: Gen<bool>,
+    units_binary: Gen<bool>,
+    places: Gen<usize>,
+    zeroes: Gen<usize>,
+    fixed: Gen<Option<usize>>,
+    long: Gen<bool>,
+    space: Gen<bool>,
+    suffix: Gen<&'static str>,
+    sep: Gen<Option<char>>,
+}
+
+impl Fields {
+    fn any() -> Fields {
+        Fields {
+            bits: booleans().boxed_printable(),
+            kilo_binary: booleans().boxed_printable(),
+            units_binary: booleans().boxed_printable(),
+            places: ints(0usize, 10).boxed_printable(),
+            zeroes: ints(0usize, 5).boxed_printable(),
+            fixed: optional(ints(0usize, 8)).boxed_printable(),
+            long: booleans().boxed_printable(),
+            space: booleans().boxed_printable(),
+            suffix: sampled_from(SUFFIXES).boxed_printable(),
+            sep: grouping(true),
+        }
+    }
+    /// The grouping properties' options: an ASCII separator, every other field free.
+    fn grouped() -> Fields {
+        Fields { sep: ascii_grouping(), ..Fields::any() }
+    }
+    fn opts(self) -> impl PrintableGenerator<Opts> + Send + Sync + 'static {
+        tuples!(self.bits, self.kilo_binary, self.units_binary, self.places, self.zeroes, self.fixed, self.long, self.space, self.suffix, self.sep).map(
+            |(bits, kilo_binary, units_binary, places, zeroes, fixed, long, space, suffix, sep)| Opts {
+                bits,
+                kilo_binary,
+                units_binary,
+                places,
+                zeroes,
+                fixed,
+                long,
+                space,
+                suffix,
+                sep,
+            },
+        )
+    }
+}
+
+/// An option set with the given separator field: a custom record (the shrink target) or, one
+/// time in ten, a preset, so that "the presets are what their names say" is checked on drawn
+/// values.
+fn options_with(sep: Gen<Option<char>>) -> impl PrintableGenerator<Options> + Send + Sync + 'static {
+    either(
+        10,
+        Fields { sep, ..Fields::any() }.opts().map(Options::Custom).boxed_printable(),
+        sampled_from(PRESETS).map(Options::Preset).boxed_printable(),
+    )
+}
+
+fn options() -> impl PrintableGenerator<Options> + Send + Sync + 'static {
+    options_with(grouping(true))
+}
+
+const KILOS: &[u64] = &[1000, 1024];
+const MULTIPLIERS: &[u64] = &[1, 1, 1, 2, 7, 999, 1023, 1024, 125, 128, 1999, 2048];
+const TIE_MANTISSAS: &[u64] = &[1005, 1015, 1995, 1999, 9995, 9999, 10005, 19995, 1000005, 999995];
+const TIE_SCALES: &[u64] = &[1000, 10_000, 1_000_000];
+const EDGES: &[u64] = &[0, 1, 2, 999, 1000, 1001, 1023, 1024, 1025, 1500, 1999, 2000, u64::MAX, u64::MAX - 1, 1 << 63, EXACT - 1, EXACT, EXACT + 1];
+
+fn kilos() -> SampledFromGenerator<'static, u64> {
+    sampled_from(KILOS)
+}
+
+/// `mult` units of `kilo^exp`, `delta` bytes off: the 1000^n / 1024^n boundaries.
+fn unit_neighbours() -> impl PrintableGenerator<u64> {
+    tuples!(kilos(), ints(1u32, 6), sampled_from(MULTIPLIERS), ints(-3i64, 3))
+        .map(|(kilo, exp, mult, delta)| kilo.pow(exp).saturating_mul(mult).saturating_add_signed(delta))
+}
+
+/// A mantissa with a rounding tie or a near-carry (x.995, x.9995) in its decimals.
+fn rounding_ties() -> impl PrintableGenerator<u64> {
+    tuples!(kilos(), ints(1u32, 5), sampled_from(TIE_MANTISSAS), sampled_from(TIE_SCALES))
+        .map(|(kilo, exp, m, scale)| ((kilo.pow(exp) as u128 * m as u128) / scale as u128).min(u64::MAX as u128) as u64)
+}
+
+/// 0.9 to 2.1 units: pluralisation and carries.
+fn permilles() -> impl PrintableGenerator<u64> {
+    tuples!(kilos(), ints(1u32, 5), ints(900u64, 2100))
+        .map(|(kilo, exp, permille)| ((kilo.pow(exp) as u128 * permille as u128) / 1000).min(u64::MAX as u128) as u64)
+}
+
+/// A byte count over the whole `u64` range: small counts first (the shrink target), the edges,
+/// the exact-`f64` range, the whole range, and the unit-boundary (twice), rounding-tie and
+/// near-unit shapes.
+fn magnitudes() -> impl PrintableGenerator<u64> + Send + Sync + 'static {
+    one_of!(
+        ints(0u64, 2100),
+        sampled_from(EDGES),
+        ints(0u64, EXACT),
+        ints(0u64, u64::MAX),
+        unit_neighbours(),
+        unit_neighbours(),
+        rounding_ties(),
+        permilles(),
+    )
+}
+
+/// A byte count below 2^53, an exact `f64`: the grouping properties' domain, where humansize/3
+/// (integer parts beyond 2^53) does not reach.
+fn exact_magnitudes() -> impl PrintableGenerator<u64> + Send + Sync + 'static {
+    magnitudes().map(|m| m.min(EXACT - 1))
+}
+
+/// A signed byte count.
+fn signed_values() -> impl PrintableGenerator<i128> + Send + Sync + 'static {
+    tuples!(booleans(), magnitudes()).map(|(negative, m)| if negative { -(m as i128) } else { m as i128 })
+}
+
+const WIDE_EDGES: &[u128] = &[u128::MAX, u64::MAX as u128 + 1, 1 << 100, 10u128.pow(24), 10u128.pow(24) - 1, 10u128.pow(27), 1 << 80];
+
+/// A `u128` count: the whole range (first), `m` units of `kilo^exp` a few bytes off (the yotta
+/// entry and beyond), the edges.
+fn wide_values(kilo: u128) -> impl PrintableGenerator<u128> {
+    one_of!(
+        ints(0u128, u128::MAX),
+        tuples!(ints(6u32, 12), ints(1u128, 2048), ints(0u128, 3))
+            .map(move |(exp, m, delta)| kilo.pow(exp).saturating_mul(m).saturating_add(delta)),
+        sampled_from(WIDE_EDGES),
+    )
+}
+
+const SPECIAL_FLOATS: &[f64] = &[0.0, -0.0, 0.5, 1.5, 999.5, 1023.5, 1e300, -1e300, f64::MIN_POSITIVE, f64::NAN, f64::INFINITY, f64::NEG_INFINITY];
+const NON_FINITE: &[f64] = &[f64::NAN, f64::INFINITY, f64::NEG_INFINITY];
+
+/// An `f64` input: a couple of thousand bytes either way (first), up to 1e30, the whole range
+/// (NaN and the infinities included), and the special values.
+fn float_values() -> impl PrintableGenerator<f64> + Send + Sync + 'static {
+    one_of!(
+        floats::<f64>().min_value(-2000.0).max_value(2000.0),
+        floats::<f64>().min_value(-1e30).max_value(1e30),
+        floats::<f64>(),
+        sampled_from(SPECIAL_FLOATS),
+    )
+}
+
+// ---------------------------------------------------------------------------------------------
+// The crate's arithmetic, replicated: which recorded shape a case has
+// ---------------------------------------------------------------------------------------------
+
+fn f64_eq(left: f64, right: f64) -> bool {
+    left == right || fabs(left - right) <= f64::EPSILON
+}
+
+/// The `f64` the crate prints and the scale index it lands on, computed as the crate does
+/// (repeated division by the kilo, capped at the yotta entry).
+fn scaled(value: f64, opts: &Opts) -> (f64, usize) {
+    let divider = opts.kilo() as f64;
+    let mut size = value;
+    let mut k = 0;
+    match opts.fixed {
+        Some(fixed) => {
+            while k != fixed {
+                size /= divider;
+                k += 1;
+            }
+        }
+        None => {
+            while fabs(size) >= divider {
+                size /= divider;
+                k += 1;
+                if k == 8 {
+                    break;
+                }
+            }
+        }
+    }
+    (size, k)
+}
+
+/// The decimals the crate prints for the scaled `size`: `zeroes` for a whole quotient.
+fn places_for(size: f64, opts: &Opts) -> usize {
+    let (fpart, _) = modf(size);
+    if f64_eq(fpart, 0.0) { opts.zeroes } else { opts.places }
+}
+
+/// The number the thousands-separator path prints for `size` (its digits without the
+/// separators): the fraction is `round(fpart * 10^places) as u64` cut to `places` digits — a
+/// carry into the integer part is lost (humansize/1), a negative fraction saturates to 0
+/// (humansize/2) — and the integer part is the truncated `f64` (its digits drift beyond 2^53,
+/// humansize/3, which `number_bug` reports before calling this).
+fn grouped_number(size: f64, places: usize) -> String {
+    let (fpart, ipart) = modf(size);
+    let fraction = (round(fpart * pow(10.0, places as f64)) as u64) % 10u64.pow(places as u32);
+    let sign = if size.is_sign_negative() { "-" } else { "" };
+    let decimals = if places > 0 { format!(".{fraction:0>places$}") } else { String::new() };
+    format!("{sign}{}{decimals}", fabs(ipart) as u64)
+}
+
+/// Which recorded bug of the separator path's digits a finite `value` rendered with `opts` and
+/// a separator reaches: humansize/3 (an integer part beyond 2^53), /2 (a negative value whose
+/// fraction the separator path gets wrong), /1 (a fraction the separator path rounds
+/// differently from the plain path).
+fn number_bug(value: f64, opts: &Opts) -> Option<u8> {
+    let (size, _) = scaled(value, opts);
+    let (_, ipart) = modf(size);
+    if fabs(ipart) >= EXACT as f64 {
+        return Some(3);
+    }
+    let places = places_for(size, opts);
+    if grouped_number(size, places) != format!("{:.*}", places, size) {
+        return Some(if size.is_sign_negative() { 2 } else { 1 });
+    }
+    None
+}
+
+/// Which recorded bug of the thousands-separator path `value` rendered with `opts` reaches, if
+/// any: humansize/5 (a non-finite value), /4 (a non-ASCII separator), else `number_bug`.
+fn grouping_bug(value: f64, opts: &Opts) -> Option<u8> {
+    let sep = opts.sep?;
+    if !value.is_finite() {
+        return Some(5);
+    }
+    if !sep.is_ascii() {
+        return Some(4);
+    }
+    if !fits_the_separator_buffer(value, opts) {
+        return Some(8);
+    }
+    number_bug(value, opts)
+}
+
+/// Whether `value` rendered with `opts` has humansize/6's shape: the crate singularises a
+/// pluralised unit when the truncated quotient is 1 (never for a negative value), not when the
+/// printed number is.
+fn mis_singularised(value: f64, opts: &Opts) -> bool {
+    let (size, k) = scaled(value, opts);
+    if !opts.pluralised(k) {
+        return false;
+    }
+    let (_, ipart) = modf(size);
+    let printed = format!("{:.*}", places_for(size, opts), fabs(size));
+    f64_eq(ipart, 1.0) != (printed.split('.').next() == Some("1"))
+}
+
+/// Whether `value` rendered with `opts` has humansize/7's shape: the long binary bit table's
+/// first entry, `bits` where every other long unit is capitalised.
+fn lowercase_bits(value: f64, opts: &Opts) -> bool {
+    opts.bits && opts.long && opts.units_binary && scaled(value, opts).1 == 0
+}
+
+/// Whether a case of a wide property is clear of the recorded shapes it would fail on
+/// (humansize/6 is judged check by check, see `check_rendering`): the filter under
+/// `HEGEL_NO_KNOWN=1`.
+fn clear_of_known_shapes(value: f64, opts: &Opts) -> bool {
+    known_shapes() || (grouping_bug(value, opts).is_none() && !lowercase_bits(value, opts))
+}
+
+/// Whether the separator path's fixed 100-byte buffer holds the number: the decimals, the
+/// point, the integer digits with a separator every three, the sign. A finite `f64` whose scaled
+/// integer part has 67 to 76 digits or more (depending on the decimals; |value| above ~1e91 to
+/// ~1e99 under the yotta cap, `1e100` with `DECIMAL.thousands_separator(Some(','))` for one)
+/// panics with `attempt to subtract with overflow` or `Buffer too small!`: humansize/8's shape.
+fn fits_the_separator_buffer(value: f64, opts: &Opts) -> bool {
+    let (size, _) = scaled(value, opts);
+    let (_, ipart) = modf(size);
+    let places = places_for(size, opts);
+    let mut digits = 0;
+    let mut integer_part = fabs(ipart);
+    loop {
+        digits += 1;
+        integer_part /= 10.0;
+        if integer_part < 1.0 {
+            break;
+        }
+    }
+    places + (places > 0) as usize + digits + (digits - 1) / 3 + size.is_sign_negative() as usize <= 100
+}
+
+// ---------------------------------------------------------------------------------------------
+// Cases
+// ---------------------------------------------------------------------------------------------
+
+/// A signed value and an option set; under `HEGEL_NO_KNOWN=1` a negative value draws no
+/// separator (humansize/2's region) and the cases on a recorded shape are filtered out.
+fn signed_cases() -> impl PrintableGenerator<(i128, Options)> {
+    signed_values()
+        .flat_map(|value| tuples!(just(value), options_with(grouping(known_shapes() || value >= 0))))
+        .filter(|(value, options)| clear_of_known_shapes(*value as f64, &options.opts()))
+}
+
+/// The largest `u128` the wide property renders with `opts`: everything, except that under
+/// `HEGEL_NO_KNOWN=1` a value grouped and fixed at a unit stays below 2^52 of that unit, since
+/// nearly every wider one has an integer part beyond 2^53 (humansize/3's region).
+fn wide_cap(opts: &Opts) -> u128 {
+    match opts.fixed {
+        Some(k) if opts.sep.is_some() && !known_shapes() => (EXACT as u128 / 2).saturating_mul((opts.kilo() as u128).pow(k as u32)),
+        _ => u128::MAX,
+    }
+}
+
+/// A `u128` value near the boundaries of the drawn kilo and its option set.
+fn wide_cases() -> impl PrintableGenerator<(u128, Options)> {
+    options()
+        .flat_map(|options| {
+            let opts = options.opts();
+            let cap = wide_cap(&opts);
+            tuples!(wide_values(opts.kilo() as u128).map(move |value| value.min(cap)), just(options))
+        })
+        .filter(|(value, options)| clear_of_known_shapes(*value as f64, &options.opts()))
+}
+
+/// An `f64` value and an option set; under `HEGEL_NO_KNOWN=1` a negative or non-finite value
+/// draws no separator (humansize/2, /5) and the cases on a recorded shape are filtered out.
+fn float_cases() -> impl PrintableGenerator<(f64, Options)> {
+    float_values()
+        .flat_map(|value| tuples!(just(value), options_with(grouping(known_shapes() || (value.is_finite() && value >= 0.0)))))
+        .filter(|(value, options)| clear_of_known_shapes(*value, &options.opts()))
+}
+
+// ---------------------------------------------------------------------------------------------
+// Oracles
+// ---------------------------------------------------------------------------------------------
+
+/// Insert `sep` every three digits into the integer part of a plain rendering.
+fn with_separators(plain: &str, sep: char) -> String {
+    let (mantissa, rest) = split_mantissa(plain);
+    let (sign, digits) = if let Some(d) = mantissa.strip_prefix('-') { ("-", d) } else { ("", mantissa) };
+    let (int_part, frac) = match digits.find('.') {
+        Some(i) => (&digits[..i], &digits[i..]),
+        None => (digits, ""),
+    };
+    let mut grouped = String::new();
+    for (i, c) in int_part.chars().enumerate() {
+        if i > 0 && (int_part.len() - i) % 3 == 0 {
+            grouped.push(sep);
+        }
+        grouped.push(c);
+    }
+    format!("{sign}{grouped}{frac}{rest}")
+}
+
+/// Split a rendering into its leading number (`-?[0-9.]+`) and the rest.
+fn split_mantissa(text: &str) -> (&str, &str) {
+    let end = text
+        .char_indices()
+        .find(|&(i, c)| !(c.is_ascii_digit() || c == '.' || (c == '-' && i == 0)))
+        .map(|(i, _)| i)
+        .unwrap_or(text.len());
+    text.split_at(end)
+}
+
+/// What the plain rendering of `value` must look like, checked structurally.
+fn check_rendering(value: i128, opts: &Opts, text: &str) {
+    assert!(opts.sep.is_none());
+    let d = opts.divider();
+    // the crate converts to f64 first; the value it renders is that f64
+    let fv = value as f64;
+    let vr = fv as i128;
+    let mag = vr.unsigned_abs();
+    let k = match opts.fixed {
+        Some(k) => k,
+        None => {
+            let mut k = 0;
+            while k < 8 && mag as u128 >= (d as u128).pow(k as u32 + 1) {
+                k += 1;
+            }
+            k
+        }
+    };
+    let dk = (d as u128).pow(k as u32);
+    let (mantissa, rest) = split_mantissa(text);
+    // the tail: space, unit (plural or singular), suffix
+    let table = opts.table();
+    let suffix = opts.suffix;
+    let space = if opts.space { " " } else { "" };
+    let plural = format!("{space}{}{suffix}", table[k]);
+    let singular = format!("{space}{}{suffix}", &table[k][..table[k].len() - 1]);
+    let int_text = mantissa.trim_start_matches('-').split('.').next().unwrap();
+    if opts.pluralised(k) {
+        assert!(
+            rest == plural || rest == singular,
+            "tail {rest:?} of {text:?} is neither {plural:?} nor {singular:?}"
+        );
+        // singular exactly when the printed integer part is 1 (the crate's own `1.50 Kilobyte`),
+        // whatever the sign; humansize/6 follows the truncated quotient instead and is never
+        // singular for a negative value — that shape is left unjudged under HEGEL_NO_KNOWN=1
+        if known_shapes() || !mis_singularised(fv, opts) {
+            assert_eq!(rest == singular, int_text == "1", "pluralisation of {text:?}");
+        }
+    } else {
+        assert_eq!(rest, plural, "tail of {text:?}");
+    }
+    // the mantissa: sign, digits, decimals
+    assert_eq!(mantissa.starts_with('-'), value < 0 && text != "0", "sign of {text:?} for {value}");
+    let digits = mantissa.trim_start_matches('-');
+    let (int_text, frac_text) = match digits.find('.') {
+        Some(i) => (&digits[..i], &digits[i + 1..]),
+        None => (digits, ""),
+    };
+    assert!(!int_text.is_empty() && int_text.bytes().all(|b| b.is_ascii_digit()), "integer part of {text:?}");
+    assert!(frac_text.bytes().all(|b| b.is_ascii_digit()), "fraction of {text:?}");
+    assert!(int_text == "0" || !int_text.starts_with('0'), "leading zero in {text:?}");
+    // how many decimals: `decimal_zeroes` for a whole quotient, `decimal_places` otherwise; a
+    // quotient within a couple of f64 ulps of a whole number may go either way
+    let rem = mag as u128 % dk;
+    let whole = rem == 0;
+    let s_mag = (mag as u128).max(dk) as f64 / dk as f64;
+    let frac = rem as f64 / dk as f64;
+    let near_whole = frac < s_mag * 2f64.powi(-50) || 1.0 - frac < s_mag * 2f64.powi(-50);
+    let p = frac_text.len();
+    if whole {
+        assert_eq!(p, opts.zeroes, "decimals of the whole quotient {text:?}");
+    } else if near_whole {
+        assert!(p == opts.zeroes || p == opts.places, "decimals of {text:?}");
+    } else {
+        assert_eq!(p, opts.places, "decimals of {text:?}");
+    }
+    // the printed mantissa M/10^p is within half a last digit (plus the f64 error) of mag/d^k:
+    // |M·d^k − mag·10^p| ≤ d^k/2 + slack
+    let m: u128 = format!("{int_text}{frac_text}").parse().unwrap_or(u128::MAX);
+    let ten_p = 10u128.pow(p as u32);
+    let lhs = m.checked_mul(dk).expect("mantissa far too large");
+    let rhs = mag as u128 * ten_p;
+    let diff = lhs.abs_diff(rhs);
+    let slack = dk / 2 + (rhs >> 47) + 1;
+    assert!(diff <= slack, "{text:?} for {value}: |{m}·{dk} − {mag}·10^{p}| = {diff} > {slack}");
+}
+
+/// The tail of a rendering must be the space, the unit of `opts` at scale `k` — singular exactly
+/// when the printed integer part is 1 — and the suffix; `exact_case` off compares the unit
+/// case-insensitively (the capitalisation of the long binary bit table's first entry is
+/// humansize/7's, judged by `long_binary_bit_table_is_capitalised`).
+fn check_unit(text: &str, opts: &Opts, k: usize, exact_case: bool) {
+    let (mantissa, rest) = split_mantissa(text);
+    let int_text = mantissa.trim_start_matches('-').split('.').next().unwrap();
+    let unit = opts.table()[k];
+    let expected = if int_text == "1" && opts.pluralised(k) { &unit[..unit.len() - 1] } else { unit };
+    let tail = format!("{}{expected}{}", if opts.space { " " } else { "" }, opts.suffix);
+    assert!(
+        if exact_case { rest == tail } else { rest.eq_ignore_ascii_case(&tail) },
+        "unit of {text:?}: expected the tail {tail:?}"
+    );
+}
+
+// ---------------------------------------------------------------------------------------------
+// Rendering in a child process
+// ---------------------------------------------------------------------------------------------
+
+/// How a rendering that may not return ended.
+#[derive(Debug, Clone, PartialEq)]
+enum Rendered {
+    Text(String),
+    Panicked(String),
+    Hung,
+}
+
+const CHILD_CASE: &str = "HUMANSIZE_RENDER_CASE";
+const CHILD_ENTRY: &str = "renders_the_case_named_in_the_environment";
+const BEGIN: &str = "@@RENDERED[";
+const END: &str = "]RENDERED@@";
+
+/// Renders `value` with `opts` in a child process — this test binary running `CHILD_ENTRY` with
+/// the case in `HUMANSIZE_RENDER_CASE`, under `ulimit -v 2200000` and a ten-second deadline —
+/// because the separator path's digit loop does not end for NaN or an infinity (humansize/5; the
+/// published 2.1.3's scale loop spins on an infinity too, upstream #39). For a finite value every
+/// loop of `Display` ends (each division by ten shrinks the integer part), so those render in
+/// process. Verdicts are cached: the shrinker revisits the same few cases many times.
+fn render_in_child(value: f64, opts: &Opts) -> Rendered {
+    static VERDICTS: LazyLock<Mutex<HashMap<(u64, Opts), Rendered>>> = LazyLock::new(|| Mutex::new(HashMap::new()));
+    let key = (value.to_bits(), *opts);
+    if let Some(verdict) = VERDICTS.lock().unwrap().get(&key) {
+        return verdict.clone();
+    }
+    let exe = std::env::current_exe().expect("the test binary's path");
+    let mut child = Command::new("sh")
+        .arg("-c")
+        .arg("ulimit -v 2200000 && exec \"$0\" \"$@\"")
+        .arg(&exe)
+        .args(["--exact", CHILD_ENTRY, "--nocapture", "--test-threads=1"])
+        .env(CHILD_CASE, format!("{:016x};{}", value.to_bits(), opts.encode()))
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawning the test binary");
+    let deadline = Instant::now() + Duration::from_secs(10);
+    let mut hung = false;
+    loop {
+        match child.try_wait().expect("waiting for the child") {
+            Some(_) => break,
+            None if Instant::now() >= deadline => {
+                let _ = child.kill();
+                hung = true;
+                break;
+            }
+            None => std::thread::sleep(Duration::from_millis(5)),
+        }
+    }
+    let output = child.wait_with_output().expect("collecting the child's output");
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    let verdict = if hung {
+        Rendered::Hung
+    } else if let Some(text) = stdout.split(BEGIN).nth(1).and_then(|s| s.split(END).next()) {
+        Rendered::Text(text.to_string())
+    } else {
+        let panic: Vec<&str> = stderr.lines().skip_while(|l| !l.contains("panicked at")).take(2).collect();
+        Rendered::Panicked(if panic.is_empty() { format!("exit status {}", output.status) } else { panic.join(" ") })
+    };
+    VERDICTS.lock().unwrap().insert(key, verdict.clone());
+    verdict
+}
+
+/// The child side of `render_in_child`: with `HUMANSIZE_RENDER_CASE` set, renders that case and
+/// prints it between markers; a plain pass otherwise.
+#[test]
+fn renders_the_case_named_in_the_environment() {
+    let Ok(case) = std::env::var(CHILD_CASE) else { return };
+    let (bits, opts) = case.split_once(';').expect("value;options");
+    let value = f64::from_bits(u64::from_str_radix(bits, 16).expect("the value's bits"));
+    let text = format_size_i(value, Opts::decode(opts).options());
+    println!("{BEGIN}{text}{END}");
+}
+
