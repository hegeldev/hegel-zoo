+/// rt-format/3: the debug-hex formats `{:x?}` and `{:X?}` of `format!` are accepted.
+#[hegel::test]
+fn debug_hex_formats(mut tc: TestCase) {
+    let v = Variant::Int(n(&mut tc, -300, 300));
+    let mut spec = arb_spec(&mut tc, &v, 10);
+    spec.zero = false;
+    spec.precision = None;
+    spec.ty = pick(&mut tc, &["x?", "X?"]);
+    let expected = rust(&v, &spec);
+    expect(&spec.field(""), &[v], &Named::new(), &expected);
+}
