+/// rt-format/5: `parse_specifier` rejects a spec followed by anything else (`5xjunk`).
+#[hegel::test]
+fn parse_specifier_rejects_trailing_text(mut tc: TestCase) {
+    let v = Variant::Int(1);
+    let spec = arb_spec(&mut tc, &v, 10);
+    let junk: String = pick(&mut tc, &["junk", "}", " ", "x", "5", "$", "."]).to_string();
+    let text = format!("{}{}", spec.render(), junk);
+    let mut src = Parser::<Variant, _, _>::new("", &NoPositionalArguments, &NoNamedArguments);
+    let got = parse_specifier(&text, &mut src);
+    assert!(got.is_err(), "parse_specifier({:?}) = {:?}", text, got);
+}
