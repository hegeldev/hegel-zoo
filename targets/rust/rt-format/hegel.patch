+/// rt-format/1: a `$` width or precision may name any argument — `{:my_width$}`, `{:_w$}`,
+/// `{:.größe$}` — as `format!` allows and as the value names already do.
+#[hegel::test]
+fn dollar_names_are_identifiers(mut tc: TestCase) {
+    let name: String = pick(&mut tc, &["my_width", "_w", "größe", "ünï", "a_1", "__"]).to_string();
+    let v = Variant::Int(n(&mut tc, 0, 1000));
+    let size = n(&mut tc, 0, 12) as usize;
+    let mut named = Named::new();
+    named.insert(name.clone(), Variant::Int(size as i64));
+    let (fmt, spec) = if chance(&mut tc, 50) {
+        (format!("{{:{}$}}", name), Spec { width: Some(size), ..Spec::default() })
+    } else {
+        (format!("{{:.{}$e}}", name), Spec { precision: Some(size), ty: "e", ..Spec::default() })
+    };
+    let expected = rust(&v, &spec);
+    expect(&fmt, &[v], &named, &expected);
+}
+
+/// rt-format/2: a width or precision above 65535 in a run-time format string does not panic
+/// when the `ParsedFormat` is displayed — it is either refused by `parse` or formatted.
+#[hegel::test]
+fn huge_widths_do_not_panic(mut tc: TestCase) {
+    let big = n(&mut tc, 65536, 100_000);
+    let v = Variant::Int(n(&mut tc, 0, 1000));
+    let (fmt, positional) = match n(&mut tc, 0, 2) {
+        0 => (format!("{{:{}}}", big), vec![v]),
+        1 => (format!("{{:.{}}}", big), vec![Variant::Float(1.5)]),
+        _ => ("{:1$}".to_string(), vec![v, Variant::Int(big)]),
+    };
+    let named = Named::new();
+    let parsed = match ParsedFormat::parse(&fmt, &positional, &named) {
+        Ok(p) => p,
+        Err(_) => return,
+    };
+    let shown = catch_unwind(AssertUnwindSafe(|| format!("{}", parsed)));
+    match shown {
+        Ok(s) => assert!(s.len() >= big as usize, "rt-format({:?}) is {} bytes long", fmt, s.len()),
+        Err(_) => panic!("rt-format({:?}, {:?}) parsed and then panicked when displayed", fmt, positional),
+    }
+}
