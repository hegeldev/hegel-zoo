+/// rt-format/4: the `-` flag of `format!` (accepted and currently unused) is accepted.
+#[hegel::test]
+fn minus_flag_is_accepted(mut tc: TestCase) {
+    let v = arb_value(&mut tc);
+    let mut spec = arb_spec(&mut tc, &v, 10);
+    spec.plus = false;
+    let expected = rust(&v, &spec);
+    let mut text = spec.render();
+    let at = spec.align.map(|_| 1).unwrap_or(0);
+    text.insert(at, '-');
+    expect(&format!("{{:{}}}", text), &[v], &Named::new(), &expected);
+}
