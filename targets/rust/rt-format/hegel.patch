+//! Hegel properties for rt-format: Rust's own `format!` is the oracle.
+//!
+//! rt-format promises "all the formatting features of the `format!` macro, except for the
+//! fill character", for format strings and arguments supplied at run time.  Its `format_value`
+//! is a generated tree of `write!` calls with literal specs, so the text of one substitution is
+//! Rust's by construction; what the crate adds — the regex parser, the routing of implicit,
+//! indexed and named arguments, `$` widths and precisions, `.*`, the error position — is what
+//! these properties exercise.  The expected text is built the way `std::fmt` composes it: the
+//! core (`{:+#x}`, `{:.prec$e}`) then space padding to the width (`{:>width$}`); sign-aware zero
+//! padding, which does not compose, has its own family of literal specs.
+
+use hegel::{generators, TestCase};
+use rt_format::argument::{NoNamedArguments, NoPositionalArguments};
+use rt_format::parser::{parse_specifier, Parser};
+use rt_format::{Align, Format, FormatArgument, Pad, ParsedFormat, Precision, Repr, Sign, Specifier, Width};
+use std::collections::HashMap;
+use std::fmt;
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo as i64).max_value($hi as i64)
+    };
+}
+
+fn n(tc: &mut TestCase, lo: i64, hi: i64) -> i64 {
+    tc.draw(int!(lo, hi))
+}
+
+fn pick<T: Clone>(tc: &mut TestCase, xs: &[T]) -> T {
+    xs[n(tc, 0, xs.len() as i64 - 1) as usize].clone()
+}
+
+fn chance(tc: &mut TestCase, pct: i64) -> bool {
+    n(tc, 0, 99) < pct
+}
+
+// --------------------------------------------------------------------------- the arguments
+
+/// A run-time value, as a user of the crate would define one.
+#[derive(Clone, Debug, PartialEq)]
+enum Variant {
+    Int(i64),
+    Float(f64),
+    Str(String),
+}
+
+impl FormatArgument for Variant {
+    fn supports_format(&self, spec: &Specifier) -> bool {
+        match self {
+            Variant::Int(_) => true,
+            Variant::Float(_) => matches!(spec.format, Format::Display | Format::Debug | Format::LowerExp | Format::UpperExp),
+            Variant::Str(_) => matches!(spec.format, Format::Display | Format::Debug),
+        }
+    }
+    fn fmt_display(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        match self {
+            Variant::Int(v) => fmt::Display::fmt(v, f),
+            Variant::Float(v) => fmt::Display::fmt(v, f),
+            Variant::Str(s) => fmt::Display::fmt(s.as_str(), f),
+        }
+    }
+    fn fmt_debug(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        match self {
+            Variant::Int(v) => fmt::Debug::fmt(v, f),
+            Variant::Float(v) => fmt::Debug::fmt(v, f),
+            Variant::Str(s) => fmt::Debug::fmt(s.as_str(), f),
+        }
+    }
+    fn fmt_octal(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        match self {
+            Variant::Int(v) => fmt::Octal::fmt(v, f),
+            _ => Err(fmt::Error),
+        }
+    }
+    fn fmt_lower_hex(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        match self {
+            Variant::Int(v) => fmt::LowerHex::fmt(v, f),
+            _ => Err(fmt::Error),
+        }
+    }
+    fn fmt_upper_hex(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        match self {
+            Variant::Int(v) => fmt::UpperHex::fmt(v, f),
+            _ => Err(fmt::Error),
+        }
+    }
+    fn fmt_binary(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        match self {
+            Variant::Int(v) => fmt::Binary::fmt(v, f),
+            _ => Err(fmt::Error),
+        }
+    }
+    fn fmt_lower_exp(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        match self {
+            Variant::Int(v) => fmt::LowerExp::fmt(v, f),
+            Variant::Float(v) => fmt::LowerExp::fmt(v, f),
+            _ => Err(fmt::Error),
+        }
+    }
+    fn fmt_upper_exp(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        match self {
+            Variant::Int(v) => fmt::UpperExp::fmt(v, f),
+            Variant::Float(v) => fmt::UpperExp::fmt(v, f),
+            _ => Err(fmt::Error),
+        }
+    }
+    fn to_usize(&self) -> Result<usize, ()> {
+        match self {
+            Variant::Int(v) if *v >= 0 => Ok(*v as usize),
+            _ => Err(()),
+        }
+    }
+}
+
+type Named = HashMap<String, Variant>;
+
+fn rt(fmt: &str, positional: &[Variant], named: &Named) -> Result<String, usize> {
+    let parsed = ParsedFormat::parse(fmt, positional, named)?;
+    Ok(format!("{}", parsed))
+}
+
+// --------------------------------------------------------------------------- the spec
+
+/// A spec with the width and precision already resolved to numbers.
+#[derive(Clone, Debug, Default)]
+struct Spec {
+    align: Option<char>,
+    plus: bool,
+    alt: bool,
+    zero: bool,
+    width: Option<usize>,
+    precision: Option<usize>,
+    /// "", "?", "o", "x", "X", "b", "e", "E" (and "x?", "X?" for the pinned property)
+    ty: &'static str,
+}
+
+impl Spec {
+    /// The spec text with literal width and precision.
+    fn render(&self) -> String {
+        let mut s = String::new();
+        if let Some(a) = self.align {
+            s.push(a);
+        }
+        if self.plus {
+            s.push('+');
+        }
+        if self.alt {
+            s.push('#');
+        }
+        if self.zero {
+            s.push('0');
+        }
+        if let Some(w) = self.width {
+            s.push_str(&w.to_string());
+        }
+        if let Some(p) = self.precision {
+            s.push_str(&format!(".{}", p));
+        }
+        s.push_str(self.ty);
+        s
+    }
+
+    fn field(&self, arg: &str) -> String {
+        let spec = self.render();
+        if spec.is_empty() { format!("{{{}}}", arg) } else { format!("{{{}:{}}}", arg, spec) }
+    }
+}
+
+/// The formats a value accepts (rt-format asks `supports_format`; these mirror `Variant`).
+fn types_for(v: &Variant) -> &'static [&'static str] {
+    match v {
+        Variant::Int(_) => &["", "", "?", "o", "x", "X", "b", "e", "E"],
+        Variant::Float(_) => &["", "", "?", "e", "E"],
+        Variant::Str(_) => &["", "", "?"],
+    }
+}
+
+fn arb_spec(tc: &mut TestCase, v: &Variant, max_width: i64) -> Spec {
+    let mut spec = Spec::default();
+    spec.ty = pick(tc, types_for(v));
+    spec.align = pick(tc, &[None, Some('<'), Some('^'), Some('>')]);
+    spec.plus = chance(tc, 25);
+    spec.alt = chance(tc, 25);
+    if chance(tc, 60) {
+        spec.width = Some(n(tc, 0, max_width) as usize);
+    }
+    if chance(tc, 40) {
+        spec.precision = Some(n(tc, 0, 8) as usize);
+    }
+    if let Variant::Str(_) = v {
+        // `Debug` for `str` writes the quoted text directly: it honours neither width nor
+        // precision, and no two-stage model reproduces that — Display only for padded strings
+        if spec.ty == "?" && (spec.width.is_some() || spec.precision.is_some()) {
+            spec.ty = "";
+        }
+    }
+    spec
+}
+
+fn arb_value(tc: &mut TestCase) -> Variant {
+    match n(tc, 0, 2) {
+        0 => Variant::Int(match n(tc, 0, 2) {
+            0 => n(tc, -300, 300),
+            1 => pick(tc, &[0, 1, -1, i64::MIN, i64::MAX, 255, 65535]),
+            _ => n(tc, i64::MIN, i64::MAX),
+        }),
+        1 => Variant::Float(match n(tc, 0, 4) {
+            0 => pick(tc, &[0.0, -0.0, f64::NAN, f64::INFINITY, f64::NEG_INFINITY, 1e21, 1e-7]),
+            _ => {
+                let m = n(tc, 0, 999_999) as f64 * 10f64.powi(n(tc, -12, 12) as i32);
+                if chance(tc, 40) { -m } else { m }
+            }
+        }),
+        _ => Variant::Str(arb_text(tc, 8)),
+    }
+}
+
+fn arb_text(tc: &mut TestCase, max_len: i64) -> String {
+    let len = n(tc, 0, max_len);
+    (0..len).map(|_| pick(tc, &['a', 'b', ' ', 'Z', '_', 'ಠ', 'é', '9', '-', '.', ':', '$'])).collect()
+}
+
+/// An argument name rt-format's `$` syntax accepts (ASCII letter, then letters and digits).
+fn arb_name(tc: &mut TestCase) -> String {
+    let mut s = String::new();
+    s.push(pick(tc, &['a', 'b', 'w', 'p', 'Z']));
+    for _ in 0..n(tc, 0, 3) {
+        s.push(pick(tc, &['a', 'r', 'g', '1', '9', 'Q']));
+    }
+    s
+}
+
+// --------------------------------------------------------------------------- the oracle
+
+/// `{:[+][#][.prec$]ty}` of a value, for every type literal rt-format knows.
+macro_rules! core {
+    ($v:expr, $plus:expr, $alt:expr, $prec:expr, $t:literal) => {
+        match ($plus, $alt, $prec) {
+            (false, false, None) => format!(concat!("{:", $t, "}"), $v),
+            (true, false, None) => format!(concat!("{:+", $t, "}"), $v),
+            (false, true, None) => format!(concat!("{:#", $t, "}"), $v),
+            (true, true, None) => format!(concat!("{:+#", $t, "}"), $v),
+            (false, false, Some(p)) => format!(concat!("{:.prec$", $t, "}"), $v, prec = p),
+            (true, false, Some(p)) => format!(concat!("{:+.prec$", $t, "}"), $v, prec = p),
+            (false, true, Some(p)) => format!(concat!("{:#.prec$", $t, "}"), $v, prec = p),
+            (true, true, Some(p)) => format!(concat!("{:+#.prec$", $t, "}"), $v, prec = p),
+        }
+    };
+}
+
+/// `{:[+][#]0width$[.prec$]ty}`: sign-aware zero padding, which does not split into core and
+/// padding (the zeros go between the sign or prefix and the digits, and alignment is ignored).
+macro_rules! zero {
+    ($v:expr, $plus:expr, $alt:expr, $w:expr, $prec:expr, $t:literal) => {
+        match ($plus, $alt, $prec) {
+            (false, false, None) => format!(concat!("{:0width$", $t, "}"), $v, width = $w),
+            (true, false, None) => format!(concat!("{:+0width$", $t, "}"), $v, width = $w),
+            (false, true, None) => format!(concat!("{:#0width$", $t, "}"), $v, width = $w),
+            (true, true, None) => format!(concat!("{:+#0width$", $t, "}"), $v, width = $w),
+            (false, false, Some(p)) => format!(concat!("{:0width$.prec$", $t, "}"), $v, width = $w, prec = p),
+            (true, false, Some(p)) => format!(concat!("{:+0width$.prec$", $t, "}"), $v, width = $w, prec = p),
+            (false, true, Some(p)) => format!(concat!("{:#0width$.prec$", $t, "}"), $v, width = $w, prec = p),
+            (true, true, Some(p)) => format!(concat!("{:+#0width$.prec$", $t, "}"), $v, width = $w, prec = p),
+        }
+    };
+}
+
+fn rust_core<T>(v: T, spec: &Spec) -> String
+where
+    T: Copy + fmt::Display + fmt::Debug + fmt::Octal + fmt::LowerHex + fmt::UpperHex + fmt::Binary + fmt::LowerExp + fmt::UpperExp,
+{
+    let (plus, alt, prec) = (spec.plus, spec.alt, spec.precision);
+    match (spec.zero, spec.width) {
+        (true, Some(w)) => match spec.ty {
+            "" => zero!(v, plus, alt, w, prec, ""),
+            "?" => zero!(v, plus, alt, w, prec, "?"),
+            "o" => zero!(v, plus, alt, w, prec, "o"),
+            "x" => zero!(v, plus, alt, w, prec, "x"),
+            "X" => zero!(v, plus, alt, w, prec, "X"),
+            "b" => zero!(v, plus, alt, w, prec, "b"),
+            "e" => zero!(v, plus, alt, w, prec, "e"),
+            "E" => zero!(v, plus, alt, w, prec, "E"),
+            t => panic!("no type {:?}", t),
+        },
+        _ => match spec.ty {
+            "" => core!(v, plus, alt, prec, ""),
+            "?" => core!(v, plus, alt, prec, "?"),
+            "o" => core!(v, plus, alt, prec, "o"),
+            "x" => core!(v, plus, alt, prec, "x"),
+            "X" => core!(v, plus, alt, prec, "X"),
+            "b" => core!(v, plus, alt, prec, "b"),
+            "e" => core!(v, plus, alt, prec, "e"),
+            "E" => core!(v, plus, alt, prec, "E"),
+            "x?" => core!(v, plus, alt, prec, "x?"),
+            "X?" => core!(v, plus, alt, prec, "X?"),
+            t => panic!("no type {:?}", t),
+        },
+    }
+}
+
+/// A float or string stands in for the traits it lacks: those formats are never drawn for it.
+macro_rules! unreachable_fmt {
+    ($ty:ty, $($tr:ident),*) => {
+        $(impl fmt::$tr for $ty {
+            fn fmt(&self, _: &mut fmt::Formatter) -> fmt::Result {
+                unreachable!()
+            }
+        })*
+    };
+}
+
+#[derive(Copy, Clone)]
+struct F(f64);
+impl fmt::Display for F {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        fmt::Display::fmt(&self.0, f)
+    }
+}
+impl fmt::Debug for F {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        fmt::Debug::fmt(&self.0, f)
+    }
+}
+impl fmt::LowerExp for F {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        fmt::LowerExp::fmt(&self.0, f)
+    }
+}
+impl fmt::UpperExp for F {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        fmt::UpperExp::fmt(&self.0, f)
+    }
+}
+unreachable_fmt!(F, Octal, LowerHex, UpperHex, Binary);
+
+#[derive(Copy, Clone)]
+struct S<'a>(&'a str);
+impl fmt::Display for S<'_> {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        fmt::Display::fmt(self.0, f)
+    }
+}
+impl fmt::Debug for S<'_> {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        fmt::Debug::fmt(self.0, f)
+    }
+}
+unreachable_fmt!(S<'_>, Octal, LowerHex, UpperHex, Binary, LowerExp, UpperExp);
+
+/// Rust's text for one substitution: the core, then space padding to the width.
+fn rust(v: &Variant, spec: &Spec) -> String {
+    let (core, default_align) = match v {
+        Variant::Int(i) => (rust_core(*i, spec), '>'),
+        Variant::Float(x) => (rust_core(F(*x), spec), '>'),
+        Variant::Str(s) => (rust_core(S(s), spec), '<'),
+    };
+    if spec.zero {
+        return core;
+    }
+    let width = match spec.width {
+        Some(w) => w,
+        None => return core,
+    };
+    match spec.align.unwrap_or(default_align) {
+        '<' => format!("{:<width$}", core, width = width),
+        '^' => format!("{:^width$}", core, width = width),
+        _ => format!("{:>width$}", core, width = width),
+    }
+}
+
+fn expect(fmt: &str, positional: &[Variant], named: &Named, expected: &str) {
+    let got = rt(fmt, positional, named);
+    assert!(
+        got.as_ref().ok() == Some(&expected.to_string()),
+        "rt-format({:?}, {:?}, {:?}) = {:?}; format! gives {:?}",
+        fmt,
+        positional,
+        named,
+        got,
+        expected
+    );
+}
+
+// --------------------------------------------------------------------------- general properties
+
+/// One substitution `{:spec}` with every alignment, sign, `#`, width, precision and type the
+/// value supports formats as `format!` does.
+#[hegel::test]
+fn substitutions_format_like_rust(mut tc: TestCase) {
+    let v = arb_value(&mut tc);
+    let spec = arb_spec(&mut tc, &v, 14);
+    let expected = rust(&v, &spec);
+    expect(&spec.field(""), &[v], &Named::new(), &expected);
+}
+
+/// Sign-aware zero padding (`{:08.3}`, `{:+#010x}`) formats as `format!` does, and ignores an
+/// explicit alignment as `format!` does.
+#[hegel::test]
+fn zero_padding_formats_like_rust(mut tc: TestCase) {
+    let v = if chance(&mut tc, 50) { arb_value(&mut tc) } else { Variant::Int(n(&mut tc, -1000, 1000)) };
+    tc.assume(!matches!(v, Variant::Str(_)));
+    let mut spec = arb_spec(&mut tc, &v, 14);
+    spec.zero = true;
+    if spec.width.is_none() {
+        spec.width = Some(n(&mut tc, 0, 14) as usize);
+    }
+    let expected = rust(&v, &spec);
+    expect(&spec.field(""), &[v], &Named::new(), &expected);
+}
+
+/// A run-time format string of text, `{{`/`}}` escapes and substitutions with implicit,
+/// indexed and named arguments, `N$`/`name$` widths and precisions and `.*` is the
+/// concatenation of the unescaped text and the `format!`-formatted values, routed as `format!`
+/// routes them (implicit arguments count from zero; `.*` takes the precision first).
+#[hegel::test]
+fn format_strings_compose(mut tc: TestCase) {
+    let mut positional: Vec<Variant> = Vec::new();
+    // sizes referred to by index are appended after every value once the fields are known,
+    // so that implicit arguments are consumed in the order the values were pushed
+    let mut sizes: Vec<Variant> = Vec::new();
+    let mut named = Named::new();
+    let mut fmt = String::new();
+    let mut expected = String::new();
+    let pieces = n(&mut tc, 0, 6);
+    for _ in 0..pieces {
+        match n(&mut tc, 0, 3) {
+            0 => {
+                let t = arb_text(&mut tc, 5).replace(|c| c == '{' || c == '}', "");
+                fmt.push_str(&t);
+                expected.push_str(&t);
+            }
+            1 => {
+                let b = pick(&mut tc, &['{', '}']);
+                fmt.push(b);
+                fmt.push(b);
+                expected.push(b);
+            }
+            _ => {
+                let v = arb_value(&mut tc);
+                let mut spec = arb_spec(&mut tc, &v, 10);
+                let mut spec_text = String::new();
+                // precision by `*`: the next implicit argument is the precision, the value follows
+                let star = spec.precision.is_some() && chance(&mut tc, 30);
+                // where the value comes from
+                let arg = match n(&mut tc, 0, 3) {
+                    0 if !positional.is_empty() && !star => {
+                        let idx = n(&mut tc, 0, positional.len() as i64 - 1) as usize;
+                        let existing = positional[idx].clone();
+                        spec = arb_spec(&mut tc, &existing, 10);
+                        (idx.to_string(), existing)
+                    }
+                    1 if !star => {
+                        let name = arb_name(&mut tc);
+                        named.insert(name.clone(), v.clone());
+                        (name, v)
+                    }
+                    _ => {
+                        if star {
+                            positional.push(Variant::Int(spec.precision.unwrap() as i64));
+                        }
+                        positional.push(v.clone());
+                        (String::new(), v)
+                    }
+                };
+                let (arg_text, value) = arg;
+                if let Some(a) = spec.align {
+                    spec_text.push(a);
+                }
+                if spec.plus {
+                    spec_text.push('+');
+                }
+                if spec.alt {
+                    spec_text.push('#');
+                }
+                if let Some(w) = spec.width {
+                    // a width by index or by name refers to an Int argument holding it
+                    match n(&mut tc, 0, 2) {
+                        0 => spec_text.push_str(&w.to_string()),
+                        1 => {
+                            sizes.push(Variant::Int(w as i64));
+                            spec_text.push_str(&format!("\u{1}{}\u{1}$", sizes.len() - 1));
+                        }
+                        _ => {
+                            let name = format!("w{}", arb_name(&mut tc));
+                            named.insert(name.clone(), Variant::Int(w as i64));
+                            spec_text.push_str(&format!("{}$", name));
+                        }
+                    }
+                }
+                if let Some(p) = spec.precision {
+                    if star {
+                        spec_text.push_str(".*");
+                    } else {
+                        match n(&mut tc, 0, 2) {
+                            0 => spec_text.push_str(&format!(".{}", p)),
+                            1 => {
+                                sizes.push(Variant::Int(p as i64));
+                                spec_text.push_str(&format!(".\u{1}{}\u{1}$", sizes.len() - 1));
+                            }
+                            _ => {
+                                let name = format!("p{}", arb_name(&mut tc));
+                                named.insert(name.clone(), Variant::Int(p as i64));
+                                spec_text.push_str(&format!(".{}$", name));
+                            }
+                        }
+                    }
+                }
+                spec_text.push_str(spec.ty);
+                if spec_text.is_empty() {
+                    fmt.push_str(&format!("{{{}}}", arg_text));
+                } else {
+                    fmt.push_str(&format!("{{{}:{}}}", arg_text, spec_text));
+                }
+                expected.push_str(&rust(&value, &spec));
+            }
+        }
+    }
+    let values = positional.len();
+    for (k, size) in sizes.into_iter().enumerate() {
+        fmt = fmt.replace(&format!("\u{1}{}\u{1}", k), &(values + k).to_string());
+        positional.push(size);
+    }
+    expect(&fmt, &positional, &named, &expected);
+}
+
+/// `Specifier`'s `Display` is parsed back by `parse_specifier` to the same `Specifier`.
+#[hegel::test]
+fn specifiers_round_trip(mut tc: TestCase) {
+    let spec = Specifier {
+        align: pick(&mut tc, &[Align::None, Align::Left, Align::Center, Align::Right]),
+        sign: pick(&mut tc, &[Sign::Default, Sign::Always]),
+        repr: pick(&mut tc, &[Repr::Default, Repr::Alt]),
+        pad: pick(&mut tc, &[Pad::Space, Pad::Zero]),
+        width: if chance(&mut tc, 60) { Width::AtLeast { width: n(&mut tc, 1, 99) as usize } } else { Width::Auto },
+        precision: if chance(&mut tc, 50) { Precision::Exactly { precision: n(&mut tc, 0, 99) as usize } } else { Precision::Auto },
+        format: pick(
+            &mut tc,
+            &[Format::Display, Format::Debug, Format::Octal, Format::LowerHex, Format::UpperHex, Format::Binary, Format::LowerExp, Format::UpperExp],
+        ),
+    };
+    let text = spec.to_string();
+    let mut src = Parser::<Variant, _, _>::new("", &NoPositionalArguments, &NoNamedArguments);
+    let back = parse_specifier(&text, &mut src);
+    assert_eq!(back, Ok(spec), "parse_specifier({:?})", text);
+}
+
+/// A malformed format string is an `Err` carrying the byte offset of the offending `{` or `}`:
+/// a lone brace, an unknown name, an index out of range, a format the value does not support,
+/// an unknown spec, a `$` size that is not a non-negative integer, `.*` without arguments.
+#[hegel::test]
+fn malformed_format_strings_fail_at_the_brace(mut tc: TestCase) {
+    let mut named = Named::new();
+    named.insert("f".to_string(), Variant::Float(1.5));
+    let positional = [Variant::Float(2.5), Variant::Str("s".to_string()), Variant::Float(1.5)];
+    let prefix = {
+        let mut p = arb_text(&mut tc, 4).replace(|c| c == '{' || c == '}', "");
+        if chance(&mut tc, 40) {
+            p.push_str(pick(&mut tc, &["{{", "}}", "{}", "{0}"]));
+        }
+        p
+    };
+    let bad = pick(
+        &mut tc,
+        &["}", "{", "{nope}", "{9}", "{1:x}", "{1:e}", "{2:b}", "{:q}", "{:1$}", "{:f$}", "{:.1$}", "{:.*}", "{ }", "{0 }", "{:5 }"],
+    );
+    let fmt = format!("{}{}", prefix, bad);
+    let got = rt(&fmt, &positional, &named);
+    assert_eq!(got, Err(prefix.len()), "rt-format({:?})", fmt);
+}
