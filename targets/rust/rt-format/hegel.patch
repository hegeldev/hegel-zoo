+/// The rustdoc example and the upstream smoke test.
+#[hegel::test]
+fn doc_examples(_tc: TestCase) {
+    let pos_args = [Variant::Int(42), Variant::Int(5)];
+    let mut named_args = Named::new();
+    named_args.insert("foo".to_string(), Variant::Float(42.042));
+    expect("{:#x} [{0:<5}] {foo:.1$}", &pos_args, &named_args, "0x2a [42   ] 42.04200");
+    let mut named = Named::new();
+    named.insert("arglebargle".to_string(), Variant::Int(-42));
+    expect(
+        "foo {:+o} #{arglebargle:^5}# {2:#X} {} {{{0:b}}} {:} bar",
+        &[Variant::Int(17), Variant::Int(386), Variant::Int(42)],
+        &named,
+        "foo +21 # -42 # 0x2A 386 {10001} 42 bar",
+    );
+    expect("#{:.*}#", &[Variant::Int(5), Variant::Float(42.042)], &Named::new(), "#42.04200#");
+}
