diff --git a/tests/captures.rs b/tests/captures.rs
index 3ee273f..82663c8 100644
--- a/tests/captures.rs
+++ b/tests/captures.rs
@@ -954,3 +954,228 @@ fn capture_names_with_unrestricted_group_names() {
     assert!(names.contains(&Some("foo-bar")));
     assert!(names.contains(&Some("baz-qux")));
 }
+
+// ===================================================================
+// Hegel property-based tests
+// ===================================================================
+
+use hegel::generators;
+
+/// On the plain-regex subset, fancy-regex's `captures` must agree with the
+/// `regex` crate on the presence of a match, the number of groups, and the
+/// exact span of every group — including with the backtracking VM forced
+/// via a no-op lookahead prefix (which adds no groups).
+#[hegel::test]
+fn prop_plain_subset_captures_agree_with_regex_crate(tc: hegel::TestCase) {
+    let (tree, hay) = tc.draw(hegel::tuples!(
+        common::gen::plain_pattern(true),
+        common::gen::haystack()
+    ));
+    let pattern = tree.render();
+    tc.note(&format!("pattern={:?}", pattern));
+
+    let Ok(oracle) = regex::Regex::new(&pattern) else {
+        // e.g. compiled-size limit exceeded — rare, and not this property.
+        tc.reject()
+    };
+    let fancy = fancy_regex::Regex::new(&pattern)
+        .unwrap_or_else(|e| panic!("fancy-regex rejected plain pattern {:?}: {:?}", pattern, e));
+
+    let expected: Option<Vec<Option<(usize, usize)>>> = oracle.captures(&hay).map(|caps| {
+        (0..caps.len())
+            .map(|i| caps.get(i).map(|m| (m.start(), m.end())))
+            .collect()
+    });
+
+    let collect_fancy = |caps: Option<fancy_regex::Captures<str>>| {
+        caps.map(|caps| {
+            (0..caps.len())
+                .map(|i| caps.get(i).map(|m| (m.start(), m.end())))
+                .collect::<Vec<_>>()
+        })
+    };
+
+    // regex-syntax *elides* a capturing group repeated `{0}` (`(a){0}` has
+    // one group for the regex crate, two for fancy-regex's own parser and
+    // for Python), so on a pattern with such a group fancy-regex may report
+    // more groups than the oracle: always on the VM path, and on the
+    // delegation path when a `\b`/`\B` (always "hard", src/analyze.rs)
+    // sends the pattern to the VM anyway. The extra groups must be unset;
+    // everywhere else the groups must agree exactly. (This same elision
+    // caused the capture_names panic of
+    // prop_capture_names_never_panics_known_failure.)
+    // bug fancy-regex/2: a capturing group whose body is one lazy unbounded
+    // repeat, itself repeated `*`, is rewritten `(X*?)*` -> `(X*?)?` before
+    // delegation (optimize_nested_repeats, src/optimize.rs), and the regex
+    // crate's captures of the two differ.
+    if tree.lazy_repeat_group_starred() {
+        tc.reject()
+    }
+    // A repeated group holding `\b`/`\B` runs on the VM, whose capture of a
+    // final empty iteration follows Perl where the regex crate differs (see
+    // Alt::word_boundary_in_repeated_group): only presence, group count and
+    // group 0 are compared for such a pattern.
+    let empty_iteration = tree.word_boundary_in_repeated_group();
+    let elided = tree.zero_repeated_capture();
+    let check = |got: Option<Vec<Option<(usize, usize)>>>, path: &str| {
+        if empty_iteration {
+            assert_eq!(
+                got.as_ref().map(|g| (g.len(), g[0])),
+                expected.as_ref().map(|e| (e.len(), e[0])),
+                "{path}captures presence, group count or group 0 disagree with regex crate for {:?} on {:?}",
+                pattern,
+                hay
+            );
+            return;
+        }
+        if !elided {
+            assert_eq!(
+                got, expected,
+                "{path}captures disagree with regex crate for {:?} on {:?}",
+                pattern, hay
+            );
+            return;
+        }
+        assert_eq!(
+            got.is_some(),
+            expected.is_some(),
+            "{path}captures presence disagrees with regex crate for {:?} on {:?}",
+            pattern,
+            hay
+        );
+        if let (Some(got), Some(expected)) = (got, &expected) {
+            assert!(
+                got.len() >= expected.len(),
+                "{path}captures dropped groups for {:?} on {:?}: {:?} vs {:?}",
+                pattern,
+                hay,
+                got,
+                expected
+            );
+            for (i, want) in expected.iter().enumerate() {
+                assert_eq!(
+                    got[i], *want,
+                    "{path}capture group {} disagrees with regex crate for {:?} on {:?}",
+                    i, pattern, hay
+                );
+            }
+            for (i, extra) in got.iter().enumerate().skip(expected.len()) {
+                assert_eq!(
+                    *extra, None,
+                    "{path}extra capture group {} is set for {:?} on {:?}",
+                    i, pattern, hay
+                );
+            }
+        }
+    };
+
+    check(collect_fancy(fancy.captures(hay.as_str()).unwrap()), "");
+
+    let vm = fancy_regex::Regex::new(&format!(r"(?=[\s\S]?){}", pattern)).unwrap();
+    match vm.captures(hay.as_str()) {
+        Ok(caps) => check(collect_fancy(caps), "VM-path "),
+        Err(Error::RuntimeError(fancy_regex::RuntimeError::BacktrackLimitExceeded)) => {}
+        Err(e) => panic!("unexpected error for {:?} on {:?}: {:?}", pattern, hay, e),
+    }
+}
+
+/// bug fancy-regex/2: a capturing group whose body is one lazy unbounded
+/// repeat, itself repeated `*`, is rewritten `(X*?)*` -> `(X*?)?` before
+/// delegation (optimize_nested_repeats, src/optimize.rs, which takes the
+/// languages' equality for the captures'), and the regex crate's captures of
+/// the two differ: group 1 of `((?:[b]|)*?)*a` on `bba` is (1, 2) for regex
+/// and (0, 2) for fancy-regex, the match (0, 3) agreeing.
+#[test]
+fn starred_group_of_a_lazy_repeat_captures_like_regex() {
+    let pattern = "((?:[b]|)*?)*a";
+    let hay = "bba";
+    let spans = |caps: Option<Vec<Option<(usize, usize)>>>| caps;
+    let want = spans(regex::Regex::new(pattern).unwrap().captures(hay).map(|c| {
+        (0..c.len())
+            .map(|i| c.get(i).map(|m| (m.start(), m.end())))
+            .collect()
+    }));
+    let got = spans(
+        fancy_regex::Regex::new(pattern)
+            .unwrap()
+            .captures(hay)
+            .unwrap()
+            .map(|c| {
+                (0..c.len())
+                    .map(|i| c.get(i).map(|m| (m.start(), m.end())))
+                    .collect()
+            }),
+    );
+    assert_eq!(got, want, "captures of {pattern:?} on {hay:?}");
+}
+
+/// KNOWN FAILURE — pins a real bug in fancy-regex; deliberately left failing.
+///
+/// `Regex::capture_names()` panics with an index-out-of-bounds for any
+/// *delegated* pattern in which a named group is repeated `{0}` times.
+/// Root cause: the delegated `regex` program elides `(?<n>a){0}` entirely,
+/// so `captures_len()` is 1, but fancy-regex's own parse recorded
+/// `named_groups["n"] == 1`, and `capture_names()` writes `names[1]` into a
+/// `Vec` of length 1 (src/lib.rs:1643).
+///
+/// Minimal reproducer:
+///     fancy_regex::Regex::new("(?<n>a){0}").unwrap().capture_names();
+///
+/// The generator below constructs the failing shape directly so the test
+/// fails deterministically on every run.
+#[hegel::test]
+fn prop_capture_names_never_panics_known_failure(tc: hegel::TestCase) {
+    let (name, body) = tc.draw(hegel::tuples!(
+        generators::from_regex("[a-z][a-z0-9]{0,5}"),
+        generators::from_regex("[a-z]{1,3}")
+    ));
+    let pattern = format!("(?<{}>{}){{0}}", name, body);
+    let re = fancy_regex::Regex::new(&pattern)
+        .unwrap_or_else(|e| panic!("pattern {:?} failed to compile: {:?}", pattern, e));
+    // BUG: this panics (index out of bounds) instead of returning the names.
+    let _names: Vec<Option<&str>> = re.capture_names().collect();
+}
+
+/// For arbitrary fancy patterns, group 0 of `captures` must have exactly the
+/// span reported by `find`.
+#[hegel::test]
+fn prop_captures_group0_equals_find(tc: hegel::TestCase) {
+    let (tree, hay) = tc.draw(hegel::tuples!(
+        common::gen::fancy_pattern(),
+        common::gen::haystack()
+    ));
+    let pattern = tree.render();
+    tc.note(&format!("pattern={:?}", pattern));
+    let re = match fancy_regex::Regex::new(&pattern) {
+        Ok(re) => re,
+        // Not yet supported by fancy-regex (a documented CompileError): a
+        // lookbehind of variable width whose body holds a group that a
+        // backreference names.
+        Err(Error::CompileError(e))
+            if matches!(*e, CompileError::FeatureNotYetSupported(_))
+                && tree.backreference_into_lookbehind() =>
+        {
+            tc.reject()
+        }
+        Err(e) => panic!(
+            "generated fancy pattern must compile: {:?}: {:?}",
+            pattern, e
+        ),
+    };
+
+    let find = match re.find(hay.as_str()) {
+        Ok(m) => m.map(|m| (m.start(), m.end())),
+        Err(Error::RuntimeError(fancy_regex::RuntimeError::BacktrackLimitExceeded)) => tc.reject(),
+        Err(e) => panic!("unexpected error for {:?} on {:?}: {:?}", pattern, hay, e),
+    };
+    let group0 = match re.captures(hay.as_str()) {
+        Ok(caps) => caps.and_then(|c| c.get(0)).map(|m| (m.start(), m.end())),
+        Err(Error::RuntimeError(fancy_regex::RuntimeError::BacktrackLimitExceeded)) => tc.reject(),
+        Err(e) => panic!("unexpected error for {:?} on {:?}: {:?}", pattern, hay, e),
+    };
+    assert_eq!(
+        group0, find,
+        "captures group 0 != find for {:?} on {:?}",
+        pattern, hay
+    );
+}
diff --git a/tests/common/mod.rs b/tests/common/mod.rs
index 22e5f23..274c5a2 100644
--- a/tests/common/mod.rs
+++ b/tests/common/mod.rs
@@ -329,3 +329,698 @@ pub fn assert_seek_same(re: &str, text: &str) -> Option<(usize, usize)> {
     );
     str_result.map(|m| (m.start(), m.end()))
 }
+
+// ===================================================================
+// Generators for hegel property-based tests.
+//
+// A pattern is drawn as a syntax tree and rendered by a pure function,
+// so a failing case prints as a small tree rather than as a transcript
+// of draws. `plain_pattern` is restricted to the subset supported by the
+// `regex` crate (no lookaround, no backreferences), so the `regex` crate
+// can be used as a differential oracle: fancy-regex delegates such
+// patterns, and (when forced onto the backtracking VM) must still agree
+// with `regex` about what matches. `fancy_pattern` is a sequence of items
+// layering fancy features (lookaround, atomic groups, numbered and named
+// backreferences) over plain pieces; its renderer numbers the groups, so
+// a backreference only ever names a group that is already closed.
+// ===================================================================
+
+pub mod gen {
+    #![allow(dead_code)]
+
+    use hegel::generators::{self, Generator as _};
+    use hegel::{PrettyPrintable, PrintableGenerator};
+
+    /// Characters used for haystack content; overlaps with the pattern literal
+    /// alphabet so that generated patterns match generated haystacks often.
+    pub const HAYSTACK_CHARS: &[char] = &[
+        'a', 'b', 'c', 'd', 'x', 'A', 'B', '0', '1', '9', ' ', '.', '+', 'é', '\n',
+    ];
+
+    const LITERAL_CHARS: &[char] = &[
+        'a', 'b', 'c', 'd', 'x', 'A', '0', '1', ' ', '.', '+', 'é', '\n',
+    ];
+
+    /// The characters a bracket class may list.
+    const SET_CHARS: &[char] = &['a', 'b', 'c', 'd', 'e', 'x', 'y', 'z', 'A', 'B', '0', '5'];
+    const CLASSES: &[&str] = &[r"\d", r"\D", r"\w", r"\W", r"\s", r"\S", "."];
+    const ANCHORS: &[&str] = &["^", "$", r"\b", r"\B"];
+    /// Group openers, the non-capturing one first; only `(` captures.
+    const WRAPPERS: &[&str] = &["(?:", "(", "(?i:", "(?s:", "(?m:"];
+    const LOOKAROUNDS: &[&str] = &["?=", "?!", "?<=", "?<!"];
+    /// The plain atoms one top-level atom may expand to through its groups.
+    const LEAVES: usize = 4;
+
+    fn ints(lo: u32, hi: u32) -> generators::IntegerGenerator<u32> {
+        generators::integers::<u32>().min_value(lo).max_value(hi)
+    }
+
+    /// `absent` (the shrink target), or `present` with probability `p`: a
+    /// weighted two-way choice that draws only the alternative it takes.
+    fn either<T: Clone + Send + Sync + 'static>(
+        p: f64,
+        absent: impl PrintableGenerator<T> + Send + Sync + 'static,
+        present: impl PrintableGenerator<T> + Send + Sync + 'static,
+    ) -> impl PrintableGenerator<T> + Send + Sync + 'static {
+        let (absent, present) = (absent.boxed_printable(), present.boxed_printable());
+        generators::weighted_booleans(p).flat_map(move |yes| {
+            if yes {
+                present.clone()
+            } else {
+                absent.clone()
+            }
+        })
+    }
+
+    /// `None` (the shrink target), or `Some` of `present` with probability `p`.
+    fn maybe<T: PrettyPrintable + Clone + Send + Sync + 'static>(
+        p: f64,
+        present: impl PrintableGenerator<T> + Send + Sync + 'static,
+    ) -> impl PrintableGenerator<Option<T>> + Send + Sync + 'static {
+        either(p, generators::just(None::<T>), present.map(Some))
+    }
+
+    // ----------------------------------------------------------------- the plain subset
+
+    /// A repetition count valid in both engines. Counts are kept small so
+    /// patterns stay cheap to compile; this bounds the *pattern*, not the
+    /// code under test.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    pub enum Count {
+        Optional,
+        Star,
+        Plus,
+        Exactly(u32),
+        Between(u32, u32),
+        AtLeast(u32),
+    }
+
+    /// A quantifier, lazy (`?`-suffixed) half the time.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    pub struct Quantifier {
+        count: Count,
+        lazy: bool,
+    }
+
+    impl Quantifier {
+        fn render(&self, out: &mut String) {
+            match self.count {
+                Count::Optional => out.push('?'),
+                Count::Star => out.push('*'),
+                Count::Plus => out.push('+'),
+                Count::Exactly(n) => out.push_str(&format!("{{{n}}}")),
+                Count::Between(lo, hi) => out.push_str(&format!("{{{lo},{hi}}}")),
+                Count::AtLeast(lo) => out.push_str(&format!("{{{lo},}}")),
+            }
+            if self.lazy {
+                out.push('?');
+            }
+        }
+    }
+
+    fn quantifier() -> impl PrintableGenerator<Quantifier> + Send + Sync + 'static {
+        hegel::tuples!(
+            hegel::one_of!(
+                generators::just(Count::Optional),
+                generators::just(Count::Star),
+                generators::just(Count::Plus),
+                ints(0, 3).map(Count::Exactly),
+                hegel::tuples!(ints(0, 3), ints(0, 3))
+                    .map(|(lo, extra)| Count::Between(lo, lo + extra)),
+                ints(0, 3).map(Count::AtLeast),
+            ),
+            generators::weighted_booleans(0.5)
+        )
+        .map(|(count, lazy)| Quantifier { count, lazy })
+    }
+
+    /// One member of a bracket class: a character, or a range of lowercase
+    /// letters or of digits.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    pub enum ClassItem {
+        Char(char),
+        Range(char, char),
+    }
+
+    /// `[...]` or `[^...]` of one to three members.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    pub struct CharClass {
+        negated: bool,
+        items: Vec<ClassItem>,
+    }
+
+    impl CharClass {
+        fn render(&self, out: &mut String) {
+            out.push('[');
+            if self.negated {
+                out.push('^');
+            }
+            for item in &self.items {
+                match item {
+                    ClassItem::Char(c) => out.push(*c),
+                    ClassItem::Range(lo, hi) => {
+                        out.push(*lo);
+                        out.push('-');
+                        out.push(*hi);
+                    }
+                }
+            }
+            out.push(']');
+        }
+    }
+
+    /// A range `lo-hi` with `lo` in the first `starts` characters after
+    /// `first` and `hi` up to `last`, drawn as a start and a span clamped at
+    /// `last` (so it shrinks to `lo-lo`).
+    fn range(
+        first: char,
+        starts: u32,
+        last: char,
+    ) -> impl PrintableGenerator<ClassItem> + Send + Sync + 'static {
+        hegel::tuples!(ints(0, starts), ints(0, last as u32 - first as u32)).map(
+            move |(start, span)| {
+                let lo = first as u32 + start;
+                let hi = (lo + span).min(last as u32);
+                ClassItem::Range(char::from_u32(lo).unwrap(), char::from_u32(hi).unwrap())
+            },
+        )
+    }
+
+    fn class_item() -> impl PrintableGenerator<ClassItem> + Send + Sync + 'static {
+        hegel::one_of!(
+            generators::sampled_from(SET_CHARS).map(ClassItem::Char),
+            range('a', 12, 'z'),
+            range('0', 5, '9'),
+        )
+    }
+
+    fn char_class() -> impl PrintableGenerator<CharClass> + Send + Sync + 'static {
+        hegel::tuples!(
+            generators::weighted_booleans(0.5),
+            generators::vecs(class_item()).min_size(1).max_size(3)
+        )
+        .map(|(negated, items)| CharClass { negated, items })
+    }
+
+    /// An atom of the plain subset; a `Group` holds a nested alternation.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    pub enum Atom {
+        Literal(char),
+        Class(&'static str),
+        Set(CharClass),
+        Anchor(&'static str),
+        Group { wrapper: &'static str, inner: Alt },
+    }
+
+    impl Atom {
+        fn render(&self, out: &mut String) {
+            match self {
+                Atom::Literal(c) => out.push_str(&regex::escape(&c.to_string())),
+                Atom::Class(text) | Atom::Anchor(text) => out.push_str(text),
+                Atom::Set(class) => class.render(out),
+                Atom::Group { wrapper, inner } => {
+                    out.push_str(wrapper);
+                    inner.render_into(out);
+                    out.push(')');
+                }
+            }
+        }
+
+        /// Whether a quantifier may follow. Anchors take none, and
+        /// fancy-regex parses a non-capturing or flag group around an empty
+        /// expression to `Expr::Empty`, which it deliberately rejects as a
+        /// repetition target outside Oniguruma mode (`(?:)*` is
+        /// TargetNotRepeatable, while the regex crate accepts it - see
+        /// is_repeatable() in src/parse.rs).
+        fn repeatable(&self) -> bool {
+            match self {
+                Atom::Anchor(_) => false,
+                Atom::Group { .. } => !self.is_empty_expr(),
+                _ => true,
+            }
+        }
+
+        /// Whether fancy-regex parses the rendering to `Expr::Empty`.
+        fn is_empty_expr(&self) -> bool {
+            matches!(self, Atom::Group { wrapper, inner } if *wrapper != "(" && inner.is_empty_expr())
+        }
+    }
+
+    /// An atom with an optional quantifier, rendered only where the atom is
+    /// repeatable (a quantifier that does not fit is a no-op).
+    #[derive(Clone, Debug, PrettyPrintable)]
+    pub struct Piece {
+        atom: Atom,
+        quantifier: Option<Quantifier>,
+    }
+
+    impl Piece {
+        fn render(&self, out: &mut String) {
+            self.atom.render(out);
+            if self.atom.repeatable() {
+                push_quantifier(out, &self.quantifier);
+            }
+        }
+    }
+
+    fn push_quantifier(out: &mut String, quantifier: &Option<Quantifier>) {
+        if let Some(quantifier) = quantifier {
+            quantifier.render(out);
+        }
+    }
+
+    /// An alternation of one to three branches of up to three pieces each.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    pub struct Alt {
+        branches: Vec<Vec<Piece>>,
+    }
+
+    impl Alt {
+        pub fn render(&self) -> String {
+            let mut out = String::new();
+            self.render_into(&mut out);
+            out
+        }
+
+        fn render_into(&self, out: &mut String) {
+            for (i, branch) in self.branches.iter().enumerate() {
+                if i > 0 {
+                    out.push('|');
+                }
+                for piece in branch {
+                    piece.render(out);
+                }
+            }
+        }
+
+        /// Whether fancy-regex parses the rendering to `Expr::Empty`: a
+        /// single branch whose pieces all do (`parse_branch` drops `Empty`
+        /// children, so `(?:)(?:)` and `(?:(?:))` are `Empty` too).
+        fn is_empty_expr(&self) -> bool {
+            self.branches.len() == 1
+                && self.branches[0]
+                    .iter()
+                    .all(|piece| piece.atom.is_empty_expr())
+        }
+
+        /// Whether a `\b` or `\B` occurs anywhere in the alternation.
+        fn has_word_boundary(&self) -> bool {
+            self.branches
+                .iter()
+                .flatten()
+                .any(|piece| match &piece.atom {
+                    Atom::Anchor(text) => *text == r"\b" || *text == r"\B",
+                    Atom::Group { inner, .. } => inner.has_word_boundary(),
+                    _ => false,
+                })
+        }
+
+        /// Whether a group that may run more than once holds a word boundary
+        /// (`(a|\b)*`): `\b` and `\B` are always hard, so such a pattern runs
+        /// on fancy-regex's VM, which keeps the capture of a final empty
+        /// iteration as Perl and Python do (`(a|\b)*` on `a` gives group 1
+        /// `(1, 1)`) where the `regex` crate reports the last non-empty one
+        /// (`(0, 1)`; it gives `(1, 1)` itself for `(a|\b){0,3}`). Engines
+        /// do not agree on the capture of an empty iteration, so the group
+        /// spans of such a pattern are not compared.
+        pub fn word_boundary_in_repeated_group(&self) -> bool {
+            self.branches
+                .iter()
+                .flatten()
+                .any(|piece| match &piece.atom {
+                    Atom::Group { inner, .. } => {
+                        let repeated = matches!(
+                            piece.quantifier,
+                            Some(Quantifier {
+                                count: Count::Star
+                                    | Count::Plus
+                                    | Count::AtLeast(_)
+                                    | Count::Exactly(2..)
+                                    | Count::Between(_, 2..),
+                                ..
+                            })
+                        ) && piece.atom.repeatable();
+                        (repeated && inner.has_word_boundary())
+                            || inner.word_boundary_in_repeated_group()
+                    }
+                    _ => false,
+                })
+        }
+
+        /// Whether a capturing group whose body is one lazy unbounded repeat
+        /// is itself repeated zero or more times (`((?:b|)*?)*`): bug
+        /// fancy-regex/2, `optimize_nested_repeats` (src/optimize.rs) rewrites
+        /// the outer `*` to `?` as if the inner repeat were greedy, and the
+        /// delegated `regex` program then reports a different span for the
+        /// group.
+        pub fn lazy_repeat_group_starred(&self) -> bool {
+            self.branches
+                .iter()
+                .flatten()
+                .any(|piece| match &piece.atom {
+                    Atom::Group { wrapper, inner } => {
+                        let starred = matches!(
+                            piece.quantifier,
+                            Some(Quantifier {
+                                count: Count::Star | Count::AtLeast(0),
+                                ..
+                            })
+                        );
+                        let lazy_body = inner.branches.len() == 1
+                            && inner.branches[0].len() == 1
+                            && matches!(
+                                &inner.branches[0][0],
+                                Piece {
+                                    atom,
+                                    quantifier: Some(Quantifier {
+                                        count: Count::Star | Count::Plus | Count::AtLeast(_),
+                                        lazy: true,
+                                    }),
+                                } if atom.repeatable()
+                            );
+                        (*wrapper == "(" && starred && lazy_body)
+                            || inner.lazy_repeat_group_starred()
+                    }
+                    _ => false,
+                })
+        }
+
+        /// Whether a capturing group occurs anywhere in the alternation.
+        fn captures(&self) -> bool {
+            self.branches
+                .iter()
+                .flatten()
+                .any(|piece| match &piece.atom {
+                    Atom::Group { wrapper, inner } => *wrapper == "(" || inner.captures(),
+                    _ => false,
+                })
+        }
+
+        /// Whether a capturing group is repeated zero times (`(a){0}`,
+        /// `(?:(a)){0,0}`): regex-syntax elides such a group, so the `regex`
+        /// crate counts one group fewer than fancy-regex's own parser (and
+        /// Python) do for the same pattern.
+        pub fn zero_repeated_capture(&self) -> bool {
+            self.branches
+                .iter()
+                .flatten()
+                .any(|piece| match &piece.atom {
+                    Atom::Group { wrapper, inner } => {
+                        let zero = matches!(
+                            piece.quantifier,
+                            Some(Quantifier {
+                                count: Count::Exactly(0) | Count::Between(0, 0),
+                                ..
+                            })
+                        );
+                        (zero && piece.atom.repeatable() && (*wrapper == "(" || inner.captures()))
+                            || inner.zero_repeated_capture()
+                    }
+                    _ => false,
+                })
+        }
+    }
+
+    /// A plain atom: a literal three times in seven, a class escape or `.`,
+    /// a bracket class twice, and an anchor (or, without anchors, one more
+    /// literal).
+    fn plain_atom(anchors: bool) -> impl PrintableGenerator<Atom> + Send + Sync + 'static {
+        let literal = || generators::sampled_from(LITERAL_CHARS).map(Atom::Literal);
+        let seventh = if anchors {
+            generators::sampled_from(ANCHORS)
+                .map(Atom::Anchor)
+                .boxed_printable()
+        } else {
+            literal().boxed_printable()
+        };
+        hegel::one_of!(
+            literal(),
+            literal(),
+            literal(),
+            generators::sampled_from(CLASSES).map(Atom::Class),
+            char_class().map(Atom::Set),
+            char_class().map(Atom::Set),
+            seventh,
+        )
+    }
+
+    /// An atom whose groups nest up to `depth` deep: a plain atom, or a
+    /// group around an alternation of such atoms.
+    fn atom(anchors: bool, depth: usize) -> impl PrintableGenerator<Atom> + Send + Sync + 'static {
+        generators::recursive(plain_atom(anchors), |sub| {
+            hegel::tuples!(generators::sampled_from(WRAPPERS), alt_of(sub))
+                .map(|(wrapper, inner)| Atom::Group { wrapper, inner })
+        })
+        .max_depth(depth)
+        .max_leaves(LEAVES)
+    }
+
+    /// An atom, quantified one time in four.
+    fn piece_of(
+        atom: impl PrintableGenerator<Atom> + Send + Sync + 'static,
+    ) -> impl PrintableGenerator<Piece> + Send + Sync + 'static {
+        hegel::tuples!(atom, maybe(0.25, quantifier()))
+            .map(|(atom, quantifier)| Piece { atom, quantifier })
+    }
+
+    fn alt_of(
+        atom: impl PrintableGenerator<Atom> + Send + Sync + 'static,
+    ) -> impl PrintableGenerator<Alt> + Send + Sync + 'static {
+        generators::vecs(generators::vecs(piece_of(atom)).max_size(3))
+            .min_size(1)
+            .max_size(3)
+            .map(|branches| Alt { branches })
+    }
+
+    /// A pattern of the plain subset (valid for both the `regex` crate and
+    /// fancy-regex), its groups nested up to two deep. With `anchors` false
+    /// it contains no `^`/`$`/`\b`/`\B` either, so any matched substring
+    /// must re-match the pattern in isolation.
+    pub fn plain_pattern(anchors: bool) -> impl PrintableGenerator<Alt> + Send + Sync + 'static {
+        alt_of(atom(anchors, 2))
+    }
+
+    // ----------------------------------------------------------------- fancy features
+
+    /// One item of a fancy pattern. The renderer numbers the items that open
+    /// a group in order; a backreference names the `at`-th (modulo the groups
+    /// closed so far) of them, or nothing before the first group.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    pub enum Item {
+        Plain(Piece),
+        Group {
+            inner: Alt,
+            quantifier: Option<Quantifier>,
+        },
+        Named {
+            inner: Alt,
+            quantifier: Option<Quantifier>,
+        },
+        Look {
+            kind: &'static str,
+            inner: Alt,
+        },
+        Atomic {
+            inner: Alt,
+            quantifier: Option<Quantifier>,
+        },
+        Backref {
+            at: u32,
+            quantifier: Option<Quantifier>,
+        },
+        NamedBackref {
+            at: u32,
+            quantifier: Option<Quantifier>,
+        },
+    }
+
+    /// A pattern that may use fancy features (lookaround, atomic groups,
+    /// numbered and named backreferences), valid for fancy-regex by
+    /// construction. Backreferences only ever refer to groups that are
+    /// already closed, and are wrapped in `(?:...)` so a following literal
+    /// digit cannot extend the number.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    pub struct Fancy {
+        items: Vec<Item>,
+    }
+
+    impl Fancy {
+        /// Whether fancy-regex may refuse the pattern as "Variable length
+        /// lookbehinds with fancy features" (`compile_lookaround_inner` in
+        /// src/compile.rs): the renderer numbers the top-level groups only,
+        /// so a numbered backreference can name a capturing group inside an
+        /// earlier lookbehind's body, which makes that group `hard`
+        /// (src/analyze.rs), and a lookbehind whose body is hard and not of
+        /// constant width is not compiled.
+        pub fn backreference_into_lookbehind(&self) -> bool {
+            self.items
+                .iter()
+                .any(|item| matches!(item, Item::Backref { .. }))
+                && self.items.iter().any(|item| {
+                    matches!(item, Item::Look { kind, inner } if kind.starts_with("?<") && inner.captures())
+                })
+        }
+
+        pub fn render(&self) -> String {
+            let mut out = String::new();
+            let mut groups: u32 = 0;
+            let mut named: Vec<String> = Vec::new();
+            for item in &self.items {
+                match item {
+                    Item::Plain(piece) => piece.render(&mut out),
+                    Item::Group { inner, quantifier } => {
+                        groups += 1;
+                        out.push('(');
+                        inner.render_into(&mut out);
+                        out.push(')');
+                        push_quantifier(&mut out, quantifier);
+                    }
+                    Item::Named { inner, quantifier } => {
+                        groups += 1;
+                        let name = format!("g{groups}");
+                        out.push_str(&format!("(?<{name}>"));
+                        inner.render_into(&mut out);
+                        out.push(')');
+                        push_quantifier(&mut out, quantifier);
+                        named.push(name);
+                    }
+                    Item::Look { kind, inner } => {
+                        out.push('(');
+                        out.push_str(kind);
+                        inner.render_into(&mut out);
+                        out.push(')');
+                    }
+                    Item::Atomic { inner, quantifier } => {
+                        out.push_str("(?>");
+                        inner.render_into(&mut out);
+                        out.push(')');
+                        push_quantifier(&mut out, quantifier);
+                    }
+                    Item::Backref { at, quantifier } if groups > 0 => {
+                        out.push_str(&format!(r"(?:\{})", 1 + at % groups));
+                        push_quantifier(&mut out, quantifier);
+                    }
+                    Item::NamedBackref { at, quantifier } if !named.is_empty() => {
+                        out.push_str(&format!(r"(?:\k<{}>)", named[*at as usize % named.len()]));
+                        push_quantifier(&mut out, quantifier);
+                    }
+                    // A backreference before any group is closed names nothing: a no-op item.
+                    Item::Backref { .. } | Item::NamedBackref { .. } => {}
+                }
+            }
+            out
+        }
+    }
+
+    /// One to five items: a plain piece (anchors allowed, groups one deep)
+    /// four times in ten, then a capturing group, a named group, a
+    /// lookaround, an atomic group, a numbered and a named backreference.
+    /// Group bodies are plain alternations without anchors, one group deep.
+    pub fn fancy_pattern() -> impl PrintableGenerator<Fancy> + Send + Sync + 'static {
+        let plain = || piece_of(atom(true, 1)).map(Item::Plain);
+        let body = || alt_of(atom(false, 1));
+        let optional_quantifier = || maybe(0.25, quantifier());
+        let item = hegel::one_of!(
+            plain(),
+            plain(),
+            plain(),
+            plain(),
+            hegel::tuples!(body(), optional_quantifier())
+                .map(|(inner, quantifier)| Item::Group { inner, quantifier }),
+            hegel::tuples!(body(), optional_quantifier())
+                .map(|(inner, quantifier)| Item::Named { inner, quantifier }),
+            hegel::tuples!(generators::sampled_from(LOOKAROUNDS), body())
+                .map(|(kind, inner)| Item::Look { kind, inner }),
+            hegel::tuples!(body(), optional_quantifier())
+                .map(|(inner, quantifier)| Item::Atomic { inner, quantifier }),
+            hegel::tuples!(ints(0, 99), optional_quantifier())
+                .map(|(at, quantifier)| Item::Backref { at, quantifier }),
+            hegel::tuples!(ints(0, 99), optional_quantifier())
+                .map(|(at, quantifier)| Item::NamedBackref { at, quantifier }),
+        );
+        generators::vecs(item)
+            .min_size(1)
+            .max_size(5)
+            .map(|items| Fancy { items })
+    }
+
+    // ----------------------------------------------------------------- haystacks
+
+    /// A haystack of up to thirty characters: mostly the shared alphabet (so
+    /// patterns hit), one character in ten arbitrary Unicode.
+    pub fn haystack() -> impl PrintableGenerator<String> + Send + Sync + 'static {
+        generators::vecs(either(
+            0.1,
+            generators::sampled_from(HAYSTACK_CHARS),
+            generators::characters(),
+        ))
+        .max_size(30)
+        .map(|chars: Vec<char>| chars.into_iter().collect::<String>())
+    }
+
+    /// A text the pattern matches: its first branch, each piece at its
+    /// smallest count (`?`, `*` and `+` once), a member of each class and a
+    /// space outside a negated bracket class (no class lists one). Anchors
+    /// contribute nothing, so this is exact only for patterns without them.
+    pub fn witness(alt: &Alt) -> String {
+        let mut out = String::new();
+        witness_into(alt, &mut out);
+        out
+    }
+
+    fn witness_into(alt: &Alt, out: &mut String) {
+        for piece in &alt.branches[0] {
+            let reps = match &piece.quantifier {
+                Some(quantifier) if piece.atom.repeatable() => match quantifier.count {
+                    Count::Optional | Count::Star | Count::Plus => 1,
+                    Count::Exactly(n) | Count::Between(n, _) | Count::AtLeast(n) => n,
+                },
+                _ => 1,
+            };
+            for _ in 0..reps {
+                match &piece.atom {
+                    Atom::Literal(c) => out.push(*c),
+                    Atom::Class(class) => out.push(match *class {
+                        r"\d" => '0',
+                        r"\W" | r"\s" => ' ',
+                        _ => 'a',
+                    }),
+                    Atom::Set(class) => out.push(match (class.negated, &class.items[0]) {
+                        (true, _) => ' ',
+                        (false, ClassItem::Char(c)) => *c,
+                        (false, ClassItem::Range(lo, _)) => *lo,
+                    }),
+                    Atom::Anchor(_) => {}
+                    Atom::Group { inner, .. } => witness_into(inner, out),
+                }
+            }
+        }
+    }
+
+    /// A plain pattern without anchors and a haystack holding a text it
+    /// matches (`witness`) between two arbitrary haystacks, for the property
+    /// that a matched text re-matches anchored. Drawn independently, a
+    /// haystack missed the pattern one time in three.
+    #[derive(Clone, Debug, PrettyPrintable)]
+    pub struct Hit {
+        pub pattern: Alt,
+        before: String,
+        after: String,
+    }
+
+    impl Hit {
+        pub fn haystack(&self) -> String {
+            format!("{}{}{}", self.before, witness(&self.pattern), self.after)
+        }
+    }
+
+    pub fn hit() -> impl PrintableGenerator<Hit> + Send + Sync + 'static {
+        hegel::tuples!(plain_pattern(false), haystack(), haystack()).map(
+            |(pattern, before, after)| Hit {
+                pattern,
+                before,
+                after,
+            },
+        )
+    }
+}
