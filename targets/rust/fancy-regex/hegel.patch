+/// `escape` round-trip: escaping arbitrary text yields a pattern that
+/// compiles and matches exactly that text, in full, at position 0.
+#[hegel::test]
+fn prop_escape_then_match_roundtrip(tc: hegel::TestCase) {
+    use hegel::generators;
+    let text: String = tc.draw(generators::text().max_size(30));
+    let pattern = fancy_regex::escape(&text);
+    let re = fancy_regex::Regex::new(&pattern).unwrap_or_else(|e| {
+        panic!("escape({:?}) produced invalid pattern {:?}: {:?}", text, pattern, e)
+    });
+    let m = re
+        .find(text.as_str())
+        .unwrap()
+        .unwrap_or_else(|| panic!("escape({:?}) = {:?} failed to match", text, pattern));
+    assert_eq!((m.start(), m.end()), (0, text.len()));
+}
