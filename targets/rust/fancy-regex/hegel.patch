--- a/tests/common/mod.rs
+++ b/tests/common/mod.rs
@@ -310,3 +310,256 @@ pub fn assert_captures<'t>(re: &str, text: &'t str) -> Option<Captures<'t, str>>
     }
     str_result
 }
+
+// ===================================================================
+// Generators for hegel property-based tests.
+//
+// These build syntactically valid regex patterns *by construction*.
+// `draw_plain_pattern` is restricted to the subset supported by the
+// `regex` crate (no lookaround, no backreferences), so the `regex`
+// crate can be used as a differential oracle: fancy-regex delegates
+// such patterns, and (when forced onto the backtracking VM) must still
+// agree with `regex` about what matches. `draw_fancy_pattern` layers
+// fancy features (lookaround, atomic groups, backreferences) on top.
+// ===================================================================
+
+#[allow(unused_imports)]
+use hegel::generators::{self, Generator as _};
+
+/// Characters used for haystack content; overlaps with the pattern literal
+/// alphabet so that generated patterns match generated haystacks often.
+#[allow(dead_code)]
+const HAYSTACK_CHARS: &[char] = &[
+    'a', 'b', 'c', 'd', 'x', 'A', 'B', '0', '1', '9', ' ', '.', '+', 'é', '\n',
+];
+
+#[allow(dead_code)]
+const LITERAL_CHARS: &[char] = &['a', 'b', 'c', 'd', 'x', 'A', '0', '1', ' ', '.', '+', 'é', '\n'];
+
+/// Draw an integer in `0..=max` without recording it individually (the
+/// assembled pattern/haystack is what matters in counterexample output).
+#[allow(dead_code)]
+fn choice(tc: &hegel::TestCase, max: u32) -> u32 {
+    tc.draw_silent(generators::integers::<u32>().max_value(max))
+}
+
+#[allow(dead_code)]
+fn coin(tc: &hegel::TestCase) -> bool {
+    tc.draw_silent(generators::booleans())
+}
+
+#[allow(dead_code)]
+fn sample_char(tc: &hegel::TestCase, chars: &[char]) -> char {
+    chars[choice(tc, (chars.len() - 1) as u32) as usize]
+}
+
+#[allow(dead_code)]
+fn sample_str(tc: &hegel::TestCase, options: &[&str]) -> String {
+    options[choice(tc, (options.len() - 1) as u32) as usize].to_string()
+}
+
+/// A quantifier valid in both engines. Counts kept small so patterns stay
+/// cheap to compile; this bounds the *pattern*, not the code under test.
+#[allow(dead_code)]
+fn draw_quantifier(tc: &hegel::TestCase) -> String {
+    let mut q = match choice(tc, 5) {
+        0 => "*".to_string(),
+        1 => "+".to_string(),
+        2 => "?".to_string(),
+        3 => format!("{{{}}}", choice(tc, 3)),
+        4 => {
+            let m = choice(tc, 3);
+            format!("{{{},{}}}", m, m + choice(tc, 3))
+        }
+        _ => format!("{{{},}}", choice(tc, 3)),
+    };
+    if coin(tc) {
+        q.push('?'); // lazy variant
+    }
+    q
+}
+
+#[allow(dead_code)]
+fn draw_char_class(tc: &hegel::TestCase) -> String {
+    let mut s = String::from("[");
+    if coin(tc) {
+        s.push('^');
+    }
+    let n = 1 + choice(tc, 2);
+    for _ in 0..n {
+        match choice(tc, 2) {
+            0 => s.push(sample_char(
+                tc,
+                &['a', 'b', 'c', 'd', 'e', 'x', 'y', 'z', 'A', 'B', '0', '5'],
+            )),
+            1 => {
+                let lo = b'a' + choice(tc, 12) as u8;
+                let hi = lo + choice(tc, (b'z' - lo) as u32) as u8;
+                s.push(lo as char);
+                s.push('-');
+                s.push(hi as char);
+            }
+            _ => {
+                let lo = b'0' + choice(tc, 5) as u8;
+                let hi = lo + choice(tc, (b'9' - lo) as u32) as u8;
+                s.push(lo as char);
+                s.push('-');
+                s.push(hi as char);
+            }
+        }
+    }
+    s.push(']');
+    s
+}
+
+/// Returns (atom, quantifiable).
+#[allow(dead_code)]
+fn draw_plain_atom(tc: &hegel::TestCase, depth: u32, anchors: bool) -> (String, bool) {
+    let max = if depth > 0 { 9 } else { 6 };
+    match choice(tc, max) {
+        0 | 1 | 2 => (
+            regex::escape(&sample_char(tc, LITERAL_CHARS).to_string()),
+            true,
+        ),
+        3 => (
+            sample_str(tc, &[r"\d", r"\D", r"\w", r"\W", r"\s", r"\S", "."]),
+            true,
+        ),
+        4 | 5 => (draw_char_class(tc), true),
+        6 => {
+            if anchors {
+                (sample_str(tc, &["^", "$", r"\b", r"\B"]), false)
+            } else {
+                (
+                    regex::escape(&sample_char(tc, LITERAL_CHARS).to_string()),
+                    true,
+                )
+            }
+        }
+        // Grouped subexpression (only reachable when depth > 0).
+        _ => {
+            let inner = draw_plain_alt(tc, depth - 1, anchors);
+            let wrapper = sample_str(tc, &["(?:", "(", "(?i:", "(?s:", "(?m:"]);
+            // fancy-regex parses an *empty* non-capturing/flag group to
+            // Expr::Empty, which it deliberately rejects as a repetition
+            // target outside Oniguruma mode (`(?:)*` is TargetNotRepeatable,
+            // while the regex crate accepts it — see is_repeatable() in
+            // src/parse.rs and HEGEL_REPORT.md). Don't quantify those.
+            let quantifiable = wrapper == "(" || !inner.is_empty();
+            (format!("{}{})", wrapper, inner), quantifiable)
+        }
+    }
+}
+
+#[allow(dead_code)]
+fn draw_plain_quantified(tc: &hegel::TestCase, depth: u32, anchors: bool) -> String {
+    let (mut s, quantifiable) = draw_plain_atom(tc, depth, anchors);
+    if quantifiable && choice(tc, 3) == 0 {
+        s.push_str(&draw_quantifier(tc));
+    }
+    s
+}
+
+#[allow(dead_code)]
+fn draw_plain_concat(tc: &hegel::TestCase, depth: u32, anchors: bool) -> String {
+    let n = choice(tc, 3);
+    let mut s = String::new();
+    for _ in 0..n {
+        s.push_str(&draw_plain_quantified(tc, depth, anchors));
+    }
+    s
+}
+
+#[allow(dead_code)]
+fn draw_plain_alt(tc: &hegel::TestCase, depth: u32, anchors: bool) -> String {
+    let n = choice(tc, 2);
+    let mut s = draw_plain_concat(tc, depth, anchors);
+    for _ in 0..n {
+        s.push('|');
+        s.push_str(&draw_plain_concat(tc, depth, anchors));
+    }
+    s
+}
+
+/// Draw a pattern restricted to the plain-regex subset (valid for both the
+/// `regex` crate and fancy-regex). With `allow_anchors` false, the pattern
+/// also contains no `^`/`$`/`\b`/`\B`, so any matched substring must
+/// re-match the pattern in isolation.
+#[allow(dead_code)]
+pub fn draw_plain_pattern(tc: &hegel::TestCase, allow_anchors: bool) -> String {
+    let depth = choice(tc, 2);
+    draw_plain_alt(tc, depth, allow_anchors)
+}
+
+#[allow(dead_code)]
+fn maybe_quantifier(tc: &hegel::TestCase, out: &mut String) {
+    if choice(tc, 3) == 0 {
+        out.push_str(&draw_quantifier(tc));
+    }
+}
+
+/// Draw a pattern that may use fancy features (lookaround, atomic groups,
+/// numbered and named backreferences), valid for fancy-regex by construction.
+/// Backreferences only ever refer to groups that are already closed, and are
+/// wrapped in `(?:...)` so a following literal digit can't extend the number.
+#[allow(dead_code)]
+pub fn draw_fancy_pattern(tc: &hegel::TestCase) -> String {
+    let mut out = String::new();
+    let mut groups: u32 = 0;
+    let mut named: Vec<String> = Vec::new();
+    let n = 1 + choice(tc, 4);
+    for _ in 0..n {
+        match choice(tc, 9) {
+            0 | 1 | 2 | 3 => out.push_str(&draw_plain_quantified(tc, 1, true)),
+            4 => {
+                groups += 1;
+                out.push_str(&format!("({})", draw_plain_alt(tc, 1, false)));
+                maybe_quantifier(tc, &mut out);
+            }
+            5 => {
+                groups += 1;
+                let name = format!("g{}", groups);
+                out.push_str(&format!("(?<{}>{})", name, draw_plain_alt(tc, 1, false)));
+                named.push(name);
+                maybe_quantifier(tc, &mut out);
+            }
+            6 => {
+                let op = sample_str(tc, &["?=", "?!", "?<=", "?<!"]);
+                out.push_str(&format!("({}{})", op, draw_plain_alt(tc, 1, false)));
+            }
+            7 => {
+                out.push_str(&format!("(?>{})", draw_plain_alt(tc, 1, false)));
+                maybe_quantifier(tc, &mut out);
+            }
+            8 if groups > 0 => {
+                let g = 1 + choice(tc, groups - 1);
+                out.push_str(&format!(r"(?:\{})", g));
+                maybe_quantifier(tc, &mut out);
+            }
+            9 if !named.is_empty() => {
+                let name = &named[choice(tc, (named.len() - 1) as u32) as usize];
+                out.push_str(&format!(r"(?:\k<{}>)", name));
+                maybe_quantifier(tc, &mut out);
+            }
+            _ => out.push_str(&draw_plain_quantified(tc, 1, true)),
+        }
+    }
+    out
+}
+
+/// Draw a haystack: mostly characters from the shared alphabet (so patterns
+/// hit), occasionally arbitrary Unicode.
+#[allow(dead_code)]
+pub fn draw_haystack(tc: &hegel::TestCase) -> String {
+    let len = choice(tc, 30);
+    let mut s = String::new();
+    for _ in 0..len {
+        if choice(tc, 9) == 0 {
+            let cp = tc.draw_silent(generators::integers::<u32>().max_value(0x10FFFF));
+            s.push(char::from_u32(cp).unwrap_or('\u{FFFD}'));
+        } else {
+            s.push(sample_char(tc, HAYSTACK_CHARS));
+        }
+    }
+    s
+}
