+/// For plain patterns with no anchors or word boundaries, matching is
+/// context-free: the matched substring, taken alone, must re-match the
+/// pattern anchored at both ends.
+#[hegel::test]
+fn prop_matched_text_rematches_anchored(tc: hegel::TestCase) {
+    let pattern = common::draw_plain_pattern(&tc, false);
+    let hay = common::draw_haystack(&tc);
+    tc.note(&format!("pattern={:?} hay={:?}", pattern, hay));
+    let re = match fancy_regex::Regex::new(&pattern) {
+        Ok(r) => r,
+        Err(_) => tc.reject(), // e.g. size limit — rare
+    };
+    let m = match re.find(hay.as_str()).unwrap() {
+        Some(m) => m,
+        None => return,
+    };
+    let anchored = fancy_regex::Regex::new(&format!("^(?:{})$", pattern)).unwrap();
+    assert!(
+        anchored.is_match(m.as_str()).unwrap(),
+        "matched text {:?} does not re-match {:?} anchored (full match of {:?})",
+        m.as_str(),
+        pattern,
+        hay
+    );
+}
