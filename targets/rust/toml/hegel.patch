+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+//
+// The generators are values.  Constructed documents come from `recursive()`
+// over the scalar generators (`value_tree`, `table_tree`); a datetime is a
+// `one_of!` over its four forms with the day drawn for its month; and the
+// valid-TOML-text properties draw a document as data — a `Doc` of sections,
+// key/value lines, values (`Val`), strings (`Str`) with a spelling per
+// character, numbers with their underscore positions — rendered by pure
+// functions that also number the keys (`k{n}_`), so every key of a document is
+// distinct by construction.  The absent or plainest alternative comes first in
+// every choice, so a shrunk case is an empty document, a `0`, a `""`.
+// ---------------------------------------------------------------------------
+
+use hegel::PrintableGenerator;
+use hegel::generators::{self, Generator, SubtreeGenerator};
+use toml_edit::{Array, ArrayOfTables, Date, Datetime, InlineTable, Offset, Time};
+
+// --------------------------------------------------------------------------- datetimes
+
+/// The last day of `month` in `year`.
+fn days_in_month(year: u16, month: u8) -> u8 {
+    let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
+    match month {
+        2 if leap => 29,
+        2 => 28,
+        4 | 6 | 9 | 11 => 30,
+        _ => 31,
+    }
+}
+
+/// A calendar date: the day is drawn for its month.
+fn date() -> impl PrintableGenerator<Date> {
+    hegel::tuples!(
+        generators::integers::<u16>().max_value(9999),
+        generators::integers::<u8>().min_value(1).max_value(12),
+    )
+    .flat_map(|(year, month)| {
+        generators::integers::<u8>()
+            .min_value(1)
+            .max_value(days_in_month(year, month))
+            .map(move |day| Date { year, month, day })
+    })
+    .print_as_debug()
+}
+
+/// The seconds of a time: absent (TOML 1.1: `Time::second` is an `Option`),
+/// whole, or with a fraction (a fraction needs a seconds part; `60` is only
+/// valid by leap-second rules, which cannot be modelled here, so 0..=59).
+fn seconds() -> impl PrintableGenerator<(Option<u8>, Option<u32>)> {
+    let second = || generators::integers::<u8>().max_value(59);
+    hegel::one_of!(
+        generators::just((None, None)),
+        second().map(|s| (Some(s), None)),
+        hegel::tuples!(
+            second(),
+            generators::integers::<u32>().max_value(999_999_999)
+        )
+        .map(|(s, n)| (Some(s), Some(n))),
+    )
+}
+
+fn time() -> impl PrintableGenerator<Time> {
+    hegel::tuples!(
+        generators::integers::<u8>().max_value(23),
+        generators::integers::<u8>().max_value(59),
+        seconds(),
+    )
+    .map(|(hour, minute, (second, nanosecond))| Time {
+        hour,
+        minute,
+        second,
+        nanosecond,
+    })
+    .print_as_debug()
+}
+
+/// `Z`, or an offset within +/-23:59 (RFC 3339's limit; the doc comment on
+/// `Offset::Custom` says `-1_440..1_440`, but -24:00 is not representable in
+/// the TOML grammar).
+fn offset() -> impl PrintableGenerator<Offset> {
+    hegel::one_of!(
+        generators::just(Offset::Z),
+        generators::integers::<i16>()
+            .min_value(-1439)
+            .max_value(1439)
+            .map(|minutes| Offset::Custom { minutes }),
+    )
+    .print_as_debug()
+}
+
+/// A valid TOML datetime in one of the four documented forms, the plain local
+/// date first: local date, local time, local datetime, offset datetime.
+fn datetime() -> impl PrintableGenerator<Datetime> {
+    hegel::one_of!(
+        date().map(|d| Datetime {
+            date: Some(d),
+            time: None,
+            offset: None,
+        }),
+        time().map(|t| Datetime {
+            date: None,
+            time: Some(t),
+            offset: None,
+        }),
+        hegel::tuples!(date(), time()).map(|(d, t)| Datetime {
+            date: Some(d),
+            time: Some(t),
+            offset: None,
+        }),
+        hegel::tuples!(date(), time(), offset()).map(|(d, t, o)| Datetime {
+            date: Some(d),
+            time: Some(t),
+            offset: Some(o),
+        }),
+    )
+    .print_as_debug()
+}
+
+// --------------------------------------------------------------------------- constructed values
+
+/// Any scalar value.
+fn scalar() -> impl Generator<Value> {
+    hegel::one_of!(
+        generators::integers::<i64>().map(Value::from),
+        generators::floats::<f64>().map(Value::from),
+        generators::booleans().map(Value::from),
+        generators::text().map(Value::from),
+        datetime().map(Value::from),
+    )
+}
+
+/// Any value, with arrays and inline tables of up to four entries (keys
+/// arbitrary text; a repeated key keeps its last value) nested up to `depth`
+/// levels.
+fn value_tree(depth: usize) -> impl Generator<Value> {
+    generators::recursive(scalar(), |inner| {
+        hegel::one_of!(
+            generators::vecs(inner.clone())
+                .max_size(4)
+                .map(|items| Value::Array(items.into_iter().collect())),
+            generators::vecs(hegel::tuples!(generators::text(), inner))
+                .max_size(4)
+                .map(|pairs| Value::InlineTable(pairs.into_iter().collect::<InlineTable>())),
+        )
+    })
+    .max_depth(depth)
+}
+
+/// Up to four entries with arbitrary (including non-bare) keys.
+fn entries(items: impl Generator<Item> + Send + Sync + 'static) -> impl Generator<Table> {
+    generators::vecs(hegel::tuples!(generators::text(), items))
+        .max_size(4)
+        .map(|pairs| pairs.into_iter().collect::<Table>())
+}
+
+/// A table of values, sub-tables and arrays of tables (up to two), nested up
+/// to `depth` levels, its values nested as deep again.
+fn table_tree(depth: usize) -> impl Generator<Table> {
+    generators::recursive(entries(value_tree(depth).map(Item::Value)), move |inner| {
+        entries(hegel::one_of!(
+            value_tree(depth).map(Item::Value),
+            inner.clone().map(Item::Table),
+            generators::vecs(inner)
+                .max_size(2)
+                .map(|tables| Item::ArrayOfTables(tables.into_iter().collect::<ArrayOfTables>())),
+        ))
+    })
+    .max_depth(depth)
+}
+
+/// Round-trip: encoding an integer `Value` and parsing it back yields the
+/// same integer, across the full `i64` range (including `MIN`/`MAX`).
+#[hegel::test]
+fn integer_value_roundtrip(tc: hegel::TestCase) {
+    let i: i64 = tc.draw(generators::integers::<i64>());
+    let encoded = Value::from(i).to_string();
+    let parsed: Value = encoded
+        .parse()
+        .unwrap_or_else(|err| panic!("error: {err}\nencoded: {encoded:?}"));
+    assert_eq!(parsed.as_integer(), Some(i), "encoded: {encoded:?}");
+}
+
+/// Round-trip: encoding a float `Value` and parsing it back yields the same
+/// float, including NaN, infinities, and signed zero.
+#[hegel::test]
+fn float_value_roundtrip(tc: hegel::TestCase) {
+    let f: f64 = tc.draw(generators::floats::<f64>());
+    let encoded = Value::from(f).to_string();
+    let parsed: Value = encoded
+        .parse()
+        .unwrap_or_else(|err| panic!("error: {err}\nencoded: {encoded:?}"));
+    let p = parsed.as_float().unwrap_or_else(|| {
+        panic!("not parsed back as float\nencoded: {encoded:?}\nparsed: {parsed:?}")
+    });
+    if f.is_nan() {
+        assert!(p.is_nan(), "expected NaN, got {p}\nencoded: {encoded:?}");
+    } else {
+        assert_eq!(p.to_bits(), f.to_bits(), "{f} != {p}\nencoded: {encoded:?}");
+    }
+}
