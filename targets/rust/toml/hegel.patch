+// ---------------------------------------------------------------------------
+// Generators for *valid TOML text*, used to test toml_edit's core promise:
+// parsing and re-displaying a document preserves it byte-for-byte (lib.rs:
+// "parse and modify toml documents, while preserving comments, spaces *and
+// relative order* of items"; the lib.rs example asserts
+// `doc.to_string() == toml`). Validity rules are transcribed from the TOML
+// ABNF, so these generators double as a spec oracle for string decoding.
+//
+// A document is drawn as data (`Doc`) and rendered by pure functions; the
+// renderer numbers the keys, so every simple key is globally unique and no
+// construct can collide with another.
+// ---------------------------------------------------------------------------
+
+/// A TOML newline.
+///
+/// CRLF is equally valid TOML, but display strips the `\r` from all decor
+/// (`RawString::encode`, src/raw_string.rs:88), so generating it here would
+/// fail byte-identity for the known reason pinned by
+/// `crlf_line_endings_are_preserved` below (toml/1). LF-only keeps the sibling
+/// properties green while still testing everything else.
+const NEWLINE: &str = "\n";
+
+/// Horizontal whitespace (`ws` in the TOML ABNF): up to two spaces and tabs.
+fn ws() -> impl PrintableGenerator<String> {
+    generators::text().alphabet(" \t").max_size(2)
+}
+
+/// A comment, without the trailing newline. TOML 1.1 forbids control
+/// characters other than tab in comments, so the alphabet stays printable
+/// (plus tab and non-ASCII: a snowman and an e-acute).
+fn comment() -> impl PrintableGenerator<String> {
+    generators::from_regex("[ \\ta-zA-Z0-9=\\[\\]'\",.#!\u{2603}\u{e9}-]{0,10}")
+        .fullmatch(true)
+        .map(|body| format!("#{body}"))
+}
+
+/// A blank or comment line (`ws [comment] newline`).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct TriviaLine {
+    ws: String,
+    comment: Option<String>,
+}
+
+impl TriviaLine {
+    fn render(&self, out: &mut String) {
+        out.push_str(&self.ws);
+        if let Some(comment) = &self.comment {
+            out.push_str(comment);
+        }
+        out.push_str(NEWLINE);
+    }
+}
+
+fn render_trivia(lines: &[TriviaLine], out: &mut String) {
+    for line in lines {
+        line.render(out);
+    }
+}
+
+/// Zero to two blank/comment lines.
+fn trivia() -> impl PrintableGenerator<Vec<TriviaLine>> {
+    generators::vecs(
+        hegel::tuples!(ws(), generators::optional(comment()))
+            .map(|(ws, comment)| TriviaLine { ws, comment }),
+    )
+    .max_size(2)
+}
+
+/// `ws-comment-newline` in the array ABNF: whitespace in which comments and
+/// newlines may freely appear (trivia lines, then whitespace).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Gap {
+    lines: Vec<TriviaLine>,
+    ws: String,
+}
+
+impl Gap {
+    fn render(&self, out: &mut String) {
+        render_trivia(&self.lines, out);
+        out.push_str(&self.ws);
+    }
+}
+
+fn gap() -> impl PrintableGenerator<Gap> {
+    hegel::tuples!(trivia(), ws()).map(|(lines, ws)| Gap { lines, ws })
+}
+
+/// The non-ASCII characters of literal strings and keys: e-acute, a snowman,
+/// a grinning face.
+const LITERAL_NON_ASCII: &[char] = &['\u{e9}', '\u{2603}', '\u{1f600}'];
+
+/// A printable ASCII character.
+fn printable_ascii() -> impl PrintableGenerator<char> {
+    generators::integers::<u32>()
+        .min_value(0x20)
+        .max_value(0x7E)
+        .map(|n| char::from_u32(n).unwrap())
+}
+
+/// A character allowed *literally* in literal strings and literal keys:
+/// anything printable except the apostrophe (literal-char ABNF:
+/// `%x09 / %x20-26 / %x28-7E / non-ascii`); an apostrophe is written as `x`.
+fn literal_char() -> impl PrintableGenerator<char> {
+    hegel::one_of!(
+        printable_ascii(),
+        generators::just('\t'),
+        generators::sampled_from(LITERAL_NON_ASCII),
+    )
+    .map(|c| if c == '\'' { 'x' } else { c })
+}
+
+/// The escape boundary of basic strings: quotes, backslashes, control
+/// characters, DEL.
+const BOUNDARY_CHARS: &[char] = &[
+    '"', '\\', '\'', '\n', '\t', '\r', '\u{0}', '\u{8}', '\u{c}', '\u{1f}', '\u{7f}',
+];
+/// Non-ASCII content of basic strings: e-acute, a snowman, a grinning face,
+/// the replacement character.
+const BASIC_NON_ASCII: &[char] = &['\u{e9}', '\u{2603}', '\u{1f600}', '\u{fffd}'];
+
+/// A character of a basic string's content, biased toward the escape boundary.
+fn content_char() -> impl PrintableGenerator<char> {
+    hegel::one_of!(
+        printable_ascii(),
+        generators::sampled_from(BOUNDARY_CHARS),
+        generators::sampled_from(BASIC_NON_ASCII),
+    )
+}
+
+/// How a character of a basic string is spelled where the grammar gives a
+/// choice: literally, by its shorthand escape, or as `\uXXXX` / `\UXXXXXXXX`.
+/// The renderer falls back to a valid spelling where the drawn one is not
+/// allowed (a control character is always `\uXXXX`, a backslash always `\\`).
+#[derive(Clone, Copy, Debug, PartialEq, hegel::PrettyPrintable)]
+enum Spelling {
+    Plain,
+    Escape,
+    Unicode4,
+    Unicode8,
+}
+
+/// Plain half the time (and the shrink target), the shorthand escape three
+/// times in ten, `\u`/`\U` one time in ten each.
+const SPELLINGS: &[Spelling] = &[
+    Spelling::Plain,
+    Spelling::Plain,
+    Spelling::Plain,
+    Spelling::Plain,
+    Spelling::Plain,
+    Spelling::Escape,
+    Spelling::Escape,
+    Spelling::Escape,
+    Spelling::Unicode4,
+    Spelling::Unicode8,
+];
+
+/// A character of a basic string with its spelling.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Piece {
+    c: char,
+    spelling: Spelling,
+}
+
+fn piece() -> impl PrintableGenerator<Piece> {
+    hegel::tuples!(content_char(), generators::sampled_from(SPELLINGS))
+        .map(|(c, spelling)| Piece { c, spelling })
+}
+
+/// Up to six characters of basic-string content.
+fn pieces() -> impl PrintableGenerator<Vec<Piece>> {
+    generators::vecs(piece()).max_size(6)
+}
+
+/// Encode `pieces` as the body of a TOML basic string (`"..."` or
+/// `"""..."""`), each character in its drawn spelling where that is one of
+/// the *valid* representations (literal, shorthand escape,
+/// `\uXXXX`/`\UXXXXXXXX`) — the escape-boundary choices where writer/parser
+/// bugs live — and in a valid one otherwise. Transcribed from the TOML ABNF.
+fn encode_basic(pieces: &[Piece], multiline: bool, out: &mut String) {
+    let mut quote_run = 0_usize;
+    for (i, Piece { c, spelling }) in pieces.iter().enumerate() {
+        let plain = *spelling == Spelling::Plain;
+        let mut literal_quote = false;
+        match *c {
+            '\\' => out.push_str("\\\\"),
+            '"' => {
+                // Runs of one or two literal quotes are allowed anywhere in a
+                // multiline body (`mlb-quotes` in the ABNF), including
+                // immediately before the closing delimiter.
+                if multiline && quote_run < 2 && plain {
+                    out.push('"');
+                    literal_quote = true;
+                } else {
+                    out.push_str("\\\"");
+                }
+            }
+            '\n' => {
+                // Literal newlines are only allowed in multiline strings; as
+                // the first content character one would be trimmed, so it
+                // must be escaped there.
+                if multiline && i != 0 && plain {
+                    out.push('\n');
+                } else {
+                    out.push_str("\\n");
+                }
+            }
+            '\t' => {
+                if plain {
+                    out.push('\t');
+                } else {
+                    out.push_str("\\t");
+                }
+            }
+            '\u{8}' => out.push_str("\\b"),
+            '\u{c}' => out.push_str("\\f"),
+            '\r' => out.push_str("\\r"),
+            c if (c as u32) < 0x20 || c == '\u{7f}' => {
+                out.push_str(&format!("\\u{:04X}", c as u32));
+            }
+            c => match spelling {
+                Spelling::Unicode4 if (c as u32) <= 0xFFFF => {
+                    out.push_str(&format!("\\u{:04X}", c as u32));
+                }
+                Spelling::Unicode8 => out.push_str(&format!("\\U{:08X}", c as u32)),
+                _ => out.push(c),
+            },
+        }
+        quote_run = if literal_quote { quote_run + 1 } else { 0 };
+    }
+}
+
+/// A piece of multiline-literal content: a character, a newline, or a run of
+/// one or two apostrophes followed by a character (`mll-quotes` must be
+/// followed by content; a trailing run is the string's `trailing_quotes`).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum LiteralPiece {
+    Char(char),
+    Newline,
+    Quotes(u8, char),
+}
+
+impl LiteralPiece {
+    fn render(&self, out: &mut String) {
+        match self {
+            LiteralPiece::Char(c) => out.push(*c),
+            LiteralPiece::Newline => out.push('\n'),
+            LiteralPiece::Quotes(n, c) => {
+                for _ in 0..*n {
+                    out.push('\'');
+                }
+                out.push(*c);
+            }
+        }
+    }
+}
+
+fn literal_piece() -> impl PrintableGenerator<LiteralPiece> {
+    hegel::one_of!(
+        literal_char().map(LiteralPiece::Char),
+        generators::just(LiteralPiece::Newline),
+        hegel::tuples!(
+            generators::integers::<u8>().min_value(1).max_value(2),
+            literal_char()
+        )
+        .map(|(n, c)| LiteralPiece::Quotes(n, c)),
+    )
+}
+
+/// A TOML string in any of the four forms, as data: `repr()` is its valid
+/// TOML representation, `decoded()` the value it encodes.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Str {
+    /// `"..."`
+    Basic(Vec<Piece>),
+    /// `"""..."""`; a newline right after the opening delimiter is trimmed,
+    /// so `lead_newline` is purely cosmetic and must be preserved but not
+    /// decoded.
+    MultilineBasic {
+        lead_newline: bool,
+        pieces: Vec<Piece>,
+    },
+    /// `'...'`
+    Literal(Vec<char>),
+    /// `'''...'''` with up to two trailing apostrophes (the `[ mll-quotes ]`
+    /// tail); a newline right after the opening delimiter is trimmed, so one
+    /// is emitted when the content itself starts with a newline (mandatory,
+    /// no escapes exist to protect it) or cosmetically.
+    MultilineLiteral {
+        lead_newline: bool,
+        pieces: Vec<LiteralPiece>,
+        trailing_quotes: u8,
+    },
+}
+
+impl Str {
+    fn repr(&self) -> String {
+        let mut out = String::new();
+        match self {
+            Str::Basic(pieces) => {
+                out.push('"');
+                encode_basic(pieces, false, &mut out);
+                out.push('"');
+            }
+            Str::MultilineBasic {
+                lead_newline,
+                pieces,
+            } => {
+                out.push_str("\"\"\"");
+                if *lead_newline {
+                    out.push('\n');
+                }
+                encode_basic(pieces, true, &mut out);
+                out.push_str("\"\"\"");
+            }
+            Str::Literal(chars) => {
+                out.push('\'');
+                out.extend(chars);
+                out.push('\'');
+            }
+            Str::MultilineLiteral { lead_newline, .. } => {
+                let content = self.decoded();
+                out.push_str("'''");
+                if content.starts_with('\n') || *lead_newline {
+                    out.push('\n');
+                }
+                out.push_str(&content);
+                out.push_str("'''");
+            }
+        }
+        out
+    }
+
+    fn decoded(&self) -> String {
+        match self {
+            Str::Basic(pieces) | Str::MultilineBasic { pieces, .. } => {
+                pieces.iter().map(|p| p.c).collect()
+            }
+            Str::Literal(chars) => chars.iter().collect(),
+            Str::MultilineLiteral {
+                pieces,
+                trailing_quotes,
+                ..
+            } => {
+                let mut out = String::new();
+                for piece in pieces {
+                    piece.render(&mut out);
+                }
+                for _ in 0..*trailing_quotes {
+                    out.push('\'');
+                }
+                out
+            }
+        }
+    }
+}
+
+/// The four string forms: basic, multiline basic, literal, multiline literal.
+fn string() -> impl PrintableGenerator<Str> {
+    hegel::one_of!(
+        pieces().map(Str::Basic),
+        hegel::tuples!(generators::booleans(), pieces()).map(|(lead_newline, pieces)| {
+            Str::MultilineBasic {
+                lead_newline,
+                pieces,
+            }
+        }),
+        generators::vecs(literal_char())
+            .max_size(6)
+            .map(Str::Literal),
+        hegel::tuples!(
+            generators::booleans(),
+            generators::vecs(literal_piece()).max_size(5),
+            generators::integers::<u8>().max_value(2)
+        )
+        .map(
+            |(lead_newline, pieces, trailing_quotes)| Str::MultilineLiteral {
+                lead_newline,
+                pieces,
+                trailing_quotes,
+            }
+        ),
+    )
+}
+
+/// `digits` with TOML-valid underscore separators: each of `gaps` names the
+/// gap between two digits (taken modulo the number of gaps) that gets one.
+fn underscored(digits: &str, gaps: &[u8]) -> String {
+    let chars: Vec<char> = digits.chars().collect();
+    let n_gaps = chars.len().saturating_sub(1);
+    let mut out = String::new();
+    for (i, c) in chars.iter().enumerate() {
+        out.push(*c);
+        if i < n_gaps && gaps.iter().any(|g| *g as usize % n_gaps == i) {
+            out.push('_');
+        }
+    }
+    out
+}
+
+/// Up to two underscore positions (none, the shrink target, most of the time).
+fn gaps() -> impl PrintableGenerator<Vec<u8>> {
+    generators::vecs(generators::integers::<u8>().max_value(63)).max_size(2)
+}
+
+/// A valid TOML integer literal: decimal (full `i64` range, optional `+`,
+/// underscores) or hex/octal/binary (non-negative, so they fit in `i64`).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Int {
+    Decimal { v: i64, plus: bool, gaps: Vec<u8> },
+    Hex { v: i64, upper: bool, gaps: Vec<u8> },
+    Octal { v: i64, gaps: Vec<u8> },
+    Binary { v: i64, gaps: Vec<u8> },
+}
+
+impl Int {
+    fn render(&self) -> String {
+        match self {
+            Int::Decimal { v, plus, gaps } => {
+                let sign = if *v < 0 {
+                    "-"
+                } else if *plus {
+                    "+"
+                } else {
+                    ""
+                };
+                format!("{sign}{}", underscored(&v.unsigned_abs().to_string(), gaps))
+            }
+            Int::Hex {
+                v,
+                upper: true,
+                gaps,
+            } => format!("0x{}", underscored(&format!("{v:X}"), gaps)),
+            Int::Hex {
+                v,
+                upper: false,
+                gaps,
+            } => format!("0x{}", underscored(&format!("{v:x}"), gaps)),
+            Int::Octal { v, gaps } => format!("0o{}", underscored(&format!("{v:o}"), gaps)),
+            Int::Binary { v, gaps } => format!("0b{}", underscored(&format!("{v:b}"), gaps)),
+        }
+    }
+}
+
+/// Decimal two times in five, then the prefixed forms.
+fn int() -> impl PrintableGenerator<Int> {
+    let decimal = || {
+        hegel::tuples!(
+            generators::integers::<i64>(),
+            generators::booleans(),
+            gaps()
+        )
+        .map(|(v, plus, gaps)| Int::Decimal { v, plus, gaps })
+    };
+    let non_negative = || generators::integers::<i64>().min_value(0);
+    hegel::one_of!(
+        decimal(),
+        decimal(),
+        hegel::tuples!(non_negative(), generators::booleans(), gaps())
+            .map(|(v, upper, gaps)| Int::Hex { v, upper, gaps }),
+        hegel::tuples!(non_negative(), gaps()).map(|(v, gaps)| Int::Octal { v, gaps }),
+        hegel::tuples!(non_negative(), gaps()).map(|(v, gaps)| Int::Binary { v, gaps }),
+    )
+}
+
+#[derive(Clone, Copy, Debug, hegel::PrettyPrintable)]
+enum Sign {
+    None,
+    Plus,
+    Minus,
+}
+
+const SIGNS: &[Sign] = &[Sign::None, Sign::Plus, Sign::Minus];
+
+impl Sign {
+    fn render(self) -> &'static str {
+        match self {
+            Sign::None => "",
+            Sign::Plus => "+",
+            Sign::Minus => "-",
+        }
+    }
+}
+
+/// A digit string and its underscore positions.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Digits {
+    text: String,
+    gaps: Vec<u8>,
+}
+
+impl Digits {
+    fn render(&self) -> String {
+        underscored(&self.text, &self.gaps)
+    }
+}
+
+fn digits(text: impl PrintableGenerator<String>) -> impl PrintableGenerator<Digits> {
+    hegel::tuples!(text, gaps()).map(|(text, gaps)| Digits { text, gaps })
+}
+
+/// An exponent: `e`/`E`, a sign, one or two digits (zero-prefixable per the
+/// ABNF; at most two digits because the parser rejects floats that overflow
+/// f64 — "floating-point number overflowed", e.g. `1E310` — so larger
+/// exponents would leave the parser's accepted domain).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Exp {
+    upper: bool,
+    sign: Sign,
+    digits: Digits,
+}
+
+impl Exp {
+    fn render(&self) -> String {
+        format!(
+            "{}{}{}",
+            if self.upper { "E" } else { "e" },
+            self.sign.render(),
+            self.digits.render()
+        )
+    }
+}
+
+fn exp() -> impl PrintableGenerator<Exp> {
+    hegel::tuples!(
+        generators::booleans(),
+        generators::sampled_from(SIGNS),
+        digits(generators::from_regex("[0-9]{1,2}").fullmatch(true)),
+    )
+    .map(|(upper, sign, digits)| Exp {
+        upper,
+        sign,
+        digits,
+    })
+}
+
+/// What makes a number a float: a fraction, an exponent, or both.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum FloatPart {
+    Frac(Digits),
+    Exp(Exp),
+    Both(Digits, Exp),
+}
+
+/// A valid TOML float literal: the inf/nan specials, or an integer part with
+/// a fraction and/or an exponent, underscores throughout.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum FloatBody {
+    Inf,
+    Nan,
+    Number { int: Digits, part: FloatPart },
+}
+
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct FloatText {
+    sign: Sign,
+    body: FloatBody,
+}
+
+impl FloatText {
+    fn render(&self) -> String {
+        let mut s = self.sign.render().to_owned();
+        match &self.body {
+            FloatBody::Inf => s.push_str("inf"),
+            FloatBody::Nan => s.push_str("nan"),
+            FloatBody::Number { int, part } => {
+                s.push_str(&int.render());
+                let (frac, exp) = match part {
+                    FloatPart::Frac(frac) => (Some(frac), None),
+                    FloatPart::Exp(exp) => (None, Some(exp)),
+                    FloatPart::Both(frac, exp) => (Some(frac), Some(exp)),
+                };
+                if let Some(frac) = frac {
+                    s.push('.');
+                    s.push_str(&frac.render());
+                }
+                if let Some(exp) = exp {
+                    s.push_str(&exp.render());
+                }
+            }
+        }
+        s
+    }
+}
+
+fn float() -> impl PrintableGenerator<FloatText> {
+    let frac = || digits(generators::from_regex("[0-9]{1,6}").fullmatch(true));
+    let part = hegel::one_of!(
+        frac().map(FloatPart::Frac),
+        exp().map(FloatPart::Exp),
+        hegel::tuples!(frac(), exp()).map(|(f, e)| FloatPart::Both(f, e)),
+    );
+    let number = hegel::tuples!(
+        digits(generators::integers::<u32>().map(|n| n.to_string())),
+        part
+    )
+    .map(|(int, part)| FloatBody::Number { int, part });
+    hegel::tuples!(
+        generators::sampled_from(SIGNS),
+        hegel::one_of!(
+            generators::just(FloatBody::Inf),
+            generators::just(FloatBody::Nan),
+            number,
+        )
+    )
+    .map(|(sign, body)| FloatText { sign, body })
+}
+
+/// The separator between date and time: `T`, or the `t` and space spellings
+/// the grammar allows.
+#[derive(Clone, Copy, Debug, hegel::PrettyPrintable)]
+enum Separator {
+    T,
+    LowerT,
+    Space,
+}
+
+const SEPARATORS: &[Separator] = &[Separator::T, Separator::LowerT, Separator::Space];
+
+/// A valid TOML datetime literal in any of the four forms, with its spelling
+/// (the separator when both date and time are present, `z` for `Z`).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct DatetimeText {
+    #[pretty(debug)]
+    dt: Datetime,
+    separator: Separator,
+    lower_z: bool,
+}
+
+impl DatetimeText {
+    fn render(&self) -> String {
+        let mut s = self.dt.to_string();
+        if self.dt.date.is_some() && self.dt.time.is_some() {
+            match self.separator {
+                Separator::T => {}
+                Separator::LowerT => s = s.replacen('T', "t", 1),
+                Separator::Space => s = s.replacen('T', " ", 1),
+            }
+        }
+        if s.ends_with('Z') && self.lower_z {
+            s.pop();
+            s.push('z');
+        }
+        s
+    }
+}
+
+fn datetime_text() -> impl PrintableGenerator<DatetimeText> {
+    hegel::tuples!(
+        datetime(),
+        generators::sampled_from(SEPARATORS),
+        generators::booleans()
+    )
+    .map(|(dt, separator, lower_z)| DatetimeText {
+        dt,
+        separator,
+        lower_z,
+    })
+}
+
+/// A simple key without its unique prefix: bare, literal-quoted or
+/// basic-quoted. The renderer prefixes the decoded form with `k{n}_` for the
+/// key's number `n`, so every key in a document is unique and generated table
+/// paths can never conflict.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum KeyStyle {
+    /// `k{n}_{extra}`
+    Bare(String),
+    /// `'k{n}_{extra}'`
+    Literal(Vec<char>),
+    /// `"k{n}_{extra}"`, the prefix's characters all in one spelling.
+    Basic { prefix: Spelling, extra: Vec<Piece> },
+}
+
+impl KeyStyle {
+    fn render(&self, n: u32) -> String {
+        match self {
+            KeyStyle::Bare(extra) => format!("k{n}_{extra}"),
+            KeyStyle::Literal(extra) => {
+                format!("'k{n}_{}'", extra.iter().collect::<String>())
+            }
+            KeyStyle::Basic { prefix, extra } => {
+                let pieces: Vec<Piece> = format!("k{n}_")
+                    .chars()
+                    .map(|c| Piece {
+                        c,
+                        spelling: *prefix,
+                    })
+                    .chain(extra.iter().cloned())
+                    .collect();
+                let mut out = String::from("\"");
+                encode_basic(&pieces, false, &mut out);
+                out.push('"');
+                out
+            }
+        }
+    }
+}
+
+/// Bare half the time, then literal and basic.
+fn key_style() -> impl PrintableGenerator<KeyStyle> {
+    let bare = || {
+        generators::from_regex("[A-Za-z0-9_-]{0,5}")
+            .fullmatch(true)
+            .map(KeyStyle::Bare)
+    };
+    hegel::one_of!(
+        bare(),
+        bare(),
+        generators::vecs(literal_char())
+            .max_size(4)
+            .map(KeyStyle::Literal),
+        hegel::tuples!(generators::sampled_from(SPELLINGS), pieces())
+            .map(|(prefix, extra)| KeyStyle::Basic { prefix, extra }),
+    )
+}
+
+/// `ws . ws key` in a dotted key.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Dot {
+    before: String,
+    after: String,
+    key: KeyStyle,
+}
+
+/// A (possibly dotted) key, with whitespace around the dots.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct DottedKey {
+    first: KeyStyle,
+    dots: Vec<Dot>,
+}
+
+/// Take the next key number.
+fn next(counter: &mut u32) -> u32 {
+    let n = *counter;
+    *counter += 1;
+    n
+}
+
+impl DottedKey {
+    fn render(&self, counter: &mut u32, out: &mut String) {
+        out.push_str(&self.first.render(next(counter)));
+        for dot in &self.dots {
+            out.push_str(&dot.before);
+            out.push('.');
+            out.push_str(&dot.after);
+            out.push_str(&dot.key.render(next(counter)));
+        }
+    }
+}
+
+fn dotted_key() -> impl PrintableGenerator<DottedKey> {
+    hegel::tuples!(
+        key_style(),
+        generators::vecs(
+            hegel::tuples!(ws(), ws(), key_style()).map(|(before, after, key)| Dot {
+                before,
+                after,
+                key
+            })
+        )
+        .max_size(2)
+    )
+    .map(|(first, dots)| DottedKey { first, dots })
+}
+
+/// A value literal as data: a scalar, or an array or inline table of values.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Val {
+    Int(Int),
+    Float(FloatText),
+    Bool(bool),
+    Datetime(DatetimeText),
+    Str(Str),
+    Array(ArrayText),
+    InlineTable(InlineTableText),
+}
+
+/// An array element with the `ws-comment-newline` around it.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct ArrayItem {
+    before: Gap,
+    value: Val,
+    after: Gap,
+}
+
+/// An array literal, with comments, newlines, and an optional trailing comma.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct ArrayText {
+    items: Vec<ArrayItem>,
+    trailing_comma: bool,
+    end: Gap,
+}
+
+/// `ws key ws = ws value` in an inline table, and the whitespace before the
+/// comma that follows it (unless it is the last).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct InlineItem {
+    before_key: String,
+    key: KeyStyle,
+    before_eq: String,
+    after_eq: String,
+    value: Val,
+    before_comma: String,
+}
+
+/// An inline table literal (TOML 1.0 form: single line, no trailing comma).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct InlineTableText {
+    items: Vec<InlineItem>,
+    end: String,
+}
+
+impl Val {
+    fn render(&self, counter: &mut u32, out: &mut String) {
+        match self {
+            Val::Int(i) => out.push_str(&i.render()),
+            Val::Float(f) => out.push_str(&f.render()),
+            Val::Bool(b) => out.push_str(if *b { "true" } else { "false" }),
+            Val::Datetime(dt) => out.push_str(&dt.render()),
+            Val::Str(s) => out.push_str(&s.repr()),
+            Val::Array(array) => {
+                out.push('[');
+                let n = array.items.len();
+                for (i, item) in array.items.iter().enumerate() {
+                    item.before.render(out);
+                    item.value.render(counter, out);
+                    item.after.render(out);
+                    if i + 1 < n || array.trailing_comma {
+                        out.push(',');
+                    }
+                }
+                array.end.render(out);
+                out.push(']');
+            }
+            Val::InlineTable(table) => {
+                out.push('{');
+                let n = table.items.len();
+                for (i, item) in table.items.iter().enumerate() {
+                    out.push_str(&item.before_key);
+                    out.push_str(&item.key.render(next(counter)));
+                    out.push_str(&item.before_eq);
+                    out.push('=');
+                    out.push_str(&item.after_eq);
+                    item.value.render(counter, out);
+                    if i + 1 < n {
+                        out.push_str(&item.before_comma);
+                        out.push(',');
+                    }
+                }
+                out.push_str(&table.end);
+                out.push('}');
+            }
+        }
+    }
+}
+
+/// A scalar value: integer, float, boolean, datetime, or (twice as often) a
+/// string.
+fn scalar_text() -> impl PrintableGenerator<Val> {
+    hegel::one_of!(
+        int().map(Val::Int),
+        float().map(Val::Float),
+        generators::booleans().map(Val::Bool),
+        datetime_text().map(Val::Datetime),
+        string().map(Val::Str),
+        string().map(Val::Str),
+    )
+}
+
+/// Up to three elements.
+fn array_text(inner: SubtreeGenerator<Val>) -> impl PrintableGenerator<ArrayText> {
+    hegel::tuples!(
+        generators::vecs(
+            hegel::tuples!(gap(), inner, gap()).map(|(before, value, after)| ArrayItem {
+                before,
+                value,
+                after
+            })
+        )
+        .max_size(3),
+        generators::booleans(),
+        gap(),
+    )
+    .map(|(items, trailing_comma, end)| ArrayText {
+        items,
+        trailing_comma,
+        end,
+    })
+}
+
+/// Up to two entries.
+fn inline_table_text(inner: SubtreeGenerator<Val>) -> impl PrintableGenerator<InlineTableText> {
+    hegel::tuples!(
+        generators::vecs(
+            hegel::tuples!(ws(), key_style(), ws(), ws(), inner, ws()).map(
+                |(before_key, key, before_eq, after_eq, value, before_comma)| InlineItem {
+                    before_key,
+                    key,
+                    before_eq,
+                    after_eq,
+                    value,
+                    before_comma,
+                }
+            )
+        )
+        .max_size(2),
+        ws(),
+    )
+    .map(|(items, end)| InlineTableText { items, end })
+}
+
+/// A valid TOML value literal, recursing into arrays and inline tables up to
+/// `depth` levels.
+fn val(depth: usize) -> impl PrintableGenerator<Val> {
+    generators::recursive(scalar_text(), |inner| {
+        hegel::one_of!(
+            array_text(inner.clone()).map(Val::Array),
+            inline_table_text(inner).map(Val::InlineTable),
+        )
+    })
+    .max_depth(depth)
+}
+
+/// A full `key = value` line with decor and an optional trailing comment.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct KeyVal {
+    lead: String,
+    key: DottedKey,
+    before_eq: String,
+    after_eq: String,
+    value: Val,
+    trail: String,
+    comment: Option<String>,
+}
+
+impl KeyVal {
+    fn render(&self, counter: &mut u32, out: &mut String) {
+        out.push_str(&self.lead);
+        self.key.render(counter, out);
+        out.push_str(&self.before_eq);
+        out.push('=');
+        out.push_str(&self.after_eq);
+        self.value.render(counter, out);
+        out.push_str(&self.trail);
+        if let Some(comment) = &self.comment {
+            out.push_str(comment);
+        }
+        out.push_str(NEWLINE);
+    }
+}
+
+fn keyval() -> impl PrintableGenerator<KeyVal> {
+    hegel::tuples!(
+        ws(),
+        dotted_key(),
+        ws(),
+        ws(),
+        val(2),
+        ws(),
+        generators::optional(comment()),
+    )
+    .map(
+        |(lead, key, before_eq, after_eq, value, trail, comment)| KeyVal {
+            lead,
+            key,
+            before_eq,
+            after_eq,
+            value,
+            trail,
+            comment,
+        },
+    )
+}
+
+/// A key/value line and the trivia lines after it.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Entry {
+    keyval: KeyVal,
+    trivia: Vec<TriviaLine>,
+}
+
+impl Entry {
+    fn render(&self, counter: &mut u32, out: &mut String) {
+        self.keyval.render(counter, out);
+        render_trivia(&self.trivia, out);
+    }
+}
+
+fn entry() -> impl PrintableGenerator<Entry> {
+    hegel::tuples!(keyval(), trivia()).map(|(keyval, trivia)| Entry { keyval, trivia })
+}
+
+/// The core of a table header: whitespace before the brackets, inside them,
+/// and the key path.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Header {
+    lead: String,
+    inner_before: String,
+    path: DottedKey,
+    inner_after: String,
+}
+
+impl Header {
+    fn render(&self, aot: bool, counter: &mut u32) -> String {
+        let (open, close) = if aot { ("[[", "]]") } else { ("[", "]") };
+        let mut out = String::new();
+        out.push_str(&self.lead);
+        out.push_str(open);
+        out.push_str(&self.inner_before);
+        self.path.render(counter, &mut out);
+        out.push_str(&self.inner_after);
+        out.push_str(close);
+        out
+    }
+}
+
+fn header() -> impl PrintableGenerator<Header> {
+    hegel::tuples!(ws(), ws(), dotted_key(), ws()).map(|(lead, inner_before, path, inner_after)| {
+        Header {
+            lead,
+            inner_before,
+            path,
+            inner_after,
+        }
+    })
+}
+
+/// What follows a header: whitespace, an optional comment, the newline,
+/// trivia lines, then up to two key/value entries.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Body {
+    ws: String,
+    comment: Option<String>,
+    trivia: Vec<TriviaLine>,
+    entries: Vec<Entry>,
+}
+
+impl Body {
+    fn render(&self, counter: &mut u32, out: &mut String) {
+        out.push_str(&self.ws);
+        if let Some(comment) = &self.comment {
+            out.push_str(comment);
+        }
+        out.push_str(NEWLINE);
+        render_trivia(&self.trivia, out);
+        for entry in &self.entries {
+            entry.render(counter, out);
+        }
+    }
+}
+
+fn body() -> impl PrintableGenerator<Body> {
+    hegel::tuples!(
+        ws(),
+        generators::optional(comment()),
+        trivia(),
+        generators::vecs(entry()).max_size(2),
+    )
+    .map(|(ws, comment, trivia, entries)| Body {
+        ws,
+        comment,
+        trivia,
+        entries,
+    })
+}
+
+/// A standard table, or an array of tables with one or two `[[...]]`
+/// repetitions. The header core (brackets, internal whitespace, key path) is
+/// rendered once and reused for every repetition: toml_edit stores the key
+/// repr of an array of tables once, so differing whitespace in later headers
+/// is normalized to the first occurrence's (toml/3).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Section {
+    Table { header: Header, body: Body },
+    ArrayOfTables { header: Header, bodies: Vec<Body> },
+}
+
+impl Section {
+    fn render(&self, counter: &mut u32, out: &mut String) {
+        match self {
+            Section::Table { header, body } => {
+                out.push_str(&header.render(false, counter));
+                body.render(counter, out);
+            }
+            Section::ArrayOfTables { header, bodies } => {
+                let header = header.render(true, counter);
+                for body in bodies {
+                    out.push_str(&header);
+                    body.render(counter, out);
+                }
+            }
+        }
+    }
+}
+
+fn section() -> impl PrintableGenerator<Section> {
+    hegel::one_of!(
+        hegel::tuples!(header(), body()).map(|(header, body)| Section::Table { header, body }),
+        hegel::tuples!(header(), generators::vecs(body()).min_size(1).max_size(2))
+            .map(|(header, bodies)| Section::ArrayOfTables { header, bodies }),
+    )
+}
+
+/// A complete, valid TOML document: leading trivia, up to three root
+/// key/values (each followed by trivia), and up to three sections.
+///
+/// A document may validly end without a trailing newline, but display appends
+/// one (e.g. "[t]" displays as "[t]\n"), so that final byte is not preserved
+/// (toml/2). The generated document therefore always ends with a newline.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Doc {
+    head: Vec<TriviaLine>,
+    root: Vec<Entry>,
+    sections: Vec<Section>,
+}
+
+impl Doc {
+    fn render(&self) -> String {
+        let mut counter = 0_u32;
+        let mut out = String::new();
+        render_trivia(&self.head, &mut out);
+        for entry in &self.root {
+            entry.render(&mut counter, &mut out);
+        }
+        for section in &self.sections {
+            section.render(&mut counter, &mut out);
+        }
+        out
+    }
+}
+
+fn document() -> impl PrintableGenerator<Doc> {
+    hegel::tuples!(
+        trivia(),
+        generators::vecs(entry()).max_size(3),
+        generators::vecs(section()).max_size(3),
+    )
+    .map(|(head, root, sections)| Doc {
+        head,
+        root,
+        sections,
+    })
+}
+
+/// Core promise: parsing a valid document and re-displaying it is
+/// byte-for-byte identical (format preservation), and hence a fixpoint.
+#[hegel::test]
+fn valid_document_display_is_byte_identical(tc: hegel::TestCase) {
+    let src = tc.draw(document()).render();
+    let doc: DocumentMut = src
+        .parse()
+        .unwrap_or_else(|err| panic!("generated document did not parse: {err}\n```\n{src}\n```"));
+    let out = doc.to_string();
+    assert_eq!(
+        out, src,
+        "display is not byte-identical to the parsed input"
+    );
+    // Fixpoint: re-parsing the display and displaying again is stable.
+    let redoc: DocumentMut = out
+        .parse()
+        .unwrap_or_else(|err| panic!("display did not re-parse: {err}\n```\n{out}\n```"));
+    assert_eq!(redoc.to_string(), out);
+}
+
+/// String forms at the escape boundary: every generated representation
+/// (basic, literal, and their multiline forms, with escapes chosen at the
+/// boundary) must decode to exactly the content it encodes (oracle:
+/// the TOML ABNF, transcribed into the generator) and be preserved verbatim.
+#[hegel::test]
+fn string_reprs_decode_correctly_and_are_preserved(tc: hegel::TestCase) {
+    let string = tc.draw(string());
+    let (repr, expected) = (string.repr(), string.decoded());
+    let src = format!("k = {repr}\n");
+    let doc: DocumentMut = src
+        .parse()
+        .unwrap_or_else(|err| panic!("string repr did not parse: {err}\nrepr: {repr:?}"));
+    assert_eq!(
+        doc["k"].as_str(),
+        Some(expected.as_str()),
+        "string decoded incorrectly\nrepr: {repr:?}"
+    );
+    assert_eq!(doc.to_string(), src, "string repr was not preserved");
+}
+
+/// The shapes of deeply nested input.
+#[derive(Clone, Copy, Debug, hegel::PrettyPrintable)]
+enum Nesting {
+    /// `a = [[[...]]]`
+    Arrays,
+    /// `a = {a = {a = ... 1}}`
+    InlineTables,
+    /// `a.a.a... = 1`
+    DottedKey,
+    /// `[a.a.a...]`
+    DottedHeader,
+    /// `[[[[` — never valid, but must not crash either.
+    Unclosed,
+}
+
+const NESTINGS: &[Nesting] = &[
+    Nesting::Arrays,
+    Nesting::InlineTables,
+    Nesting::DottedKey,
+    Nesting::DottedHeader,
+    Nesting::Unclosed,
+];
+
+impl Nesting {
+    /// The input at `depth`, and whether it is valid TOML (the recursion
+    /// guard admits 80 levels).
+    fn input(self, depth: usize) -> (String, bool) {
+        match self {
+            Nesting::Arrays => (
+                format!("a = {}{}", "[".repeat(depth), "]".repeat(depth)),
+                depth <= 80,
+            ),
+            Nesting::InlineTables => (
+                format!("a = {}1{}", "{a = ".repeat(depth), "}".repeat(depth)),
+                depth <= 80,
+            ),
+            Nesting::DottedKey => {
+                let mut s = String::from("a");
+                for _ in 1..depth {
+                    s.push_str(".a");
+                }
+                s.push_str(" = 1");
+                (s, depth <= 80)
+            }
+            Nesting::DottedHeader => {
+                let mut s = String::from("[a");
+                for _ in 1..depth {
+                    s.push_str(".a");
+                }
+                s.push(']');
+                (s, depth <= 80)
+            }
+            Nesting::Unclosed => ("[".repeat(depth), false),
+        }
+    }
+}
+
+/// Depths past the guard: 1 to 200, or one of the boundary and extreme values.
+const DEPTHS: &[usize] = &[79, 80, 81, 1000, 4096];
+
+fn depth() -> impl PrintableGenerator<usize> {
+    hegel::one_of!(
+        generators::integers::<usize>().min_value(1).max_value(200),
+        generators::sampled_from(DEPTHS),
+    )
+}
+
+/// Deeply nested input must never crash the parser: the recursion guard
+/// (`LIMIT = 80` in `src/parser/mod.rs`) turns it into a clean parse error.
+/// Sweeps depth well past the guard, pinning the exact boundary.
+#[hegel::test(test_cases = 75)]
+fn deeply_nested_input_errors_gracefully(tc: hegel::TestCase) {
+    let (depth, kind) = tc.draw(hegel::tuples!(depth(), generators::sampled_from(NESTINGS)));
+    let (input, expect_ok) = kind.input(depth);
+    let result = input.parse::<DocumentMut>();
+    assert_eq!(
+        result.is_ok(),
+        expect_ok,
+        "depth {depth}, kind {kind:?}: expected ok={expect_ok}"
+    );
+    if let Ok(doc) = result {
+        // Displaying and re-parsing a maximally nested document must also
+        // not crash.
+        let out = doc.to_string();
+        assert_eq!(out.parse::<DocumentMut>().unwrap().to_string(), out);
+    }
+}
+
+/// A `key = value` line of the edit property; its key is the bare `k{n}_`.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct EditLine {
+    lead: String,
+    before_eq: String,
+    after_eq: String,
+    value: Val,
+    trail: String,
+    comment: Option<String>,
+    trivia: Vec<TriviaLine>,
+}
+
+fn edit_line() -> impl PrintableGenerator<EditLine> {
+    hegel::tuples!(
+        ws(),
+        ws(),
+        ws(),
+        val(2),
+        ws(),
+        generators::optional(comment()),
+        trivia(),
+    )
+    .map(
+        |(lead, before_eq, after_eq, value, trail, comment, trivia)| EditLine {
+            lead,
+            before_eq,
+            after_eq,
+            value,
+            trail,
+            comment,
+            trivia,
+        },
+    )
+}
+
+/// A document of one to five bare-keyed lines with trivia between them, the
+/// line to edit (a position taken modulo the number of lines) and its new
+/// value.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct EditCase {
+    head: Vec<TriviaLine>,
+    lines: Vec<EditLine>,
+    pick: usize,
+    new_v: i64,
+}
+
+/// The rendered document as segments: the head trivia, then per line the
+/// `key = value` line and its trivia; plus, per line, its segment index, key
+/// and the decor the edit must keep (`lead`, `before_eq`).
+struct Segments {
+    segments: Vec<String>,
+    editable: Vec<(usize, String, String, String)>,
+}
+
+impl EditCase {
+    fn render(&self) -> Segments {
+        let mut counter = 0_u32;
+        let mut head = String::new();
+        render_trivia(&self.head, &mut head);
+        let mut segments = vec![head];
+        let mut editable = Vec::new();
+        for line in &self.lines {
+            let key = format!("k{}_", next(&mut counter));
+            editable.push((
+                segments.len(),
+                key.clone(),
+                line.lead.clone(),
+                line.before_eq.clone(),
+            ));
+            let mut s = format!("{}{key}{}={}", line.lead, line.before_eq, line.after_eq);
+            line.value.render(&mut counter, &mut s);
+            s.push_str(&line.trail);
+            if let Some(comment) = &line.comment {
+                s.push_str(comment);
+            }
+            s.push_str(NEWLINE);
+            segments.push(s);
+            let mut trivia = String::new();
+            render_trivia(&line.trivia, &mut trivia);
+            segments.push(trivia);
+        }
+        Segments { segments, editable }
+    }
+}
+
+fn edit_case() -> impl PrintableGenerator<EditCase> {
+    hegel::tuples!(
+        trivia(),
+        generators::vecs(edit_line()).min_size(1).max_size(5),
+        generators::integers::<usize>().max_value(4),
+        generators::integers::<i64>(),
+    )
+    .map(|(head, lines, pick, new_v)| EditCase {
+        head,
+        lines,
+        pick,
+        new_v,
+    })
+}
+
+/// Editing one value leaves every other byte of the document untouched, and
+/// rewrites only the edited line (key and its decor preserved, value decor
+/// reset to the default single space).
+#[hegel::test]
+fn editing_one_value_preserves_all_other_bytes(tc: hegel::TestCase) {
+    let case = tc.draw(edit_case());
+    let Segments { segments, editable } = case.render();
+    let src: String = segments.concat();
+    let mut doc: DocumentMut = src
+        .parse()
+        .unwrap_or_else(|err| panic!("generated document did not parse: {err}\n```\n{src}\n```"));
+    let (seg_idx, key, lead, ws1) = &editable[case.pick % editable.len()];
+    let new_v = case.new_v;
+    doc[key.as_str()] = value(new_v);
+    let out = doc.to_string();
+    let prefix: String = segments[..*seg_idx].concat();
+    let suffix: String = segments[seg_idx + 1..].concat();
+    let expected = format!("{prefix}{lead}{key}{ws1}= {new_v}\n{suffix}");
+    assert_eq!(
+        out, expected,
+        "edit of {key:?} disturbed unrelated bytes\noriginal:\n```\n{src}\n```"
+    );
+}
+
+/// KNOWN FAILURE: display normalizes CRLF line endings in decor to LF.
+///
+/// `RawString::encode` (src/raw_string.rs:88) writes raw decor spans via
+/// `raw.split('\r')`, silently dropping every `\r`. Parsing a valid document
+/// with CRLF line endings and calling `to_string()` therefore rewrites every
+/// line ending (`"a = 1\r\n"` -> `"a = 1\n"`), contradicting the crate
+/// promise of "preserving comments, spaces *and* relative order of items"
+/// (lib.rs), whose example asserts `doc.to_string() == toml`. CRLF inside
+/// *string values* is preserved; only decor (whitespace, comments, line
+/// ends) is affected. This test fails deterministically on every case.
+#[hegel::test]
+fn crlf_line_endings_are_preserved(tc: hegel::TestCase) {
+    let (extra, v) = tc.draw(hegel::tuples!(
+        generators::from_regex("[A-Za-z0-9_-]{0,5}").fullmatch(true),
+        generators::integers::<i64>(),
+    ));
+    let src = format!("# header\r\nk_{extra} = {v}\r\n");
+    let doc: DocumentMut = src
+        .parse()
+        .unwrap_or_else(|err| panic!("valid CRLF document did not parse: {err}"));
+    assert_eq!(doc.to_string(), src, "CRLF line endings were not preserved");
+}
