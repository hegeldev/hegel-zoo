+/// Distinct keys (arbitrary text, in any order), each with an integer value.
+fn pairs() -> impl PrintableGenerator<Vec<(String, i64)>> {
+    generators::vecs(generators::text())
+        .unique(true)
+        .flat_map(|keys| {
+            let n = keys.len();
+            generators::vecs(generators::integers::<i64>())
+                .min_size(n)
+                .max_size(n)
+                .map(move |values| keys.iter().cloned().zip(values).collect())
+        })
+}
