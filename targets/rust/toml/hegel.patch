+/// An edit of a document's text: delete the character at a position, or
+/// splice a fragment of TOML's syntax alphabet in there (positions are taken
+/// modulo the live length when applied).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Edit {
+    Delete { at: u16 },
+    Splice { at: u16, text: String },
+}
+
+fn edit() -> impl PrintableGenerator<Edit> {
+    let at = || generators::integers::<u16>();
+    hegel::one_of!(
+        at().map(|at| Edit::Delete { at }),
+        hegel::tuples!(
+            at(),
+            generators::from_regex(r#"[a-z0-9=\[\]{}.,#'"\\ \n\t-]{0,6}"#).fullmatch(true)
+        )
+        .map(|(at, text)| Edit::Splice { at, text }),
+    )
+}
+
+/// TOML-ish input: a valid document with up to three edits, kept when the
+/// result still parses — about half of the edited texts do, and the filter's
+/// retries keep the rejection rate to a few percent — so the property sees
+/// documents at the boundary of the grammar rather than blank ones.
+/// (Arbitrary text and syntax-alphabet soup, the previous shape, parsed one
+/// time in eight, and nineteen of twenty of those were blank.)
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct TomlIsh {
+    doc: Doc,
+    edits: Vec<Edit>,
+}
+
+impl TomlIsh {
+    fn render(&self) -> String {
+        let mut chars: Vec<char> = self.doc.render().chars().collect();
+        for edit in &self.edits {
+            match edit {
+                Edit::Delete { at } => {
+                    if !chars.is_empty() {
+                        chars.remove(*at as usize % chars.len());
+                    }
+                }
+                Edit::Splice { at, text } => {
+                    let i = *at as usize % (chars.len() + 1);
+                    chars.splice(i..i, text.chars());
+                }
+            }
+        }
+        chars.into_iter().collect()
+    }
+}
+
+fn toml_ish() -> impl PrintableGenerator<TomlIsh> {
+    hegel::tuples!(document(), generators::vecs(edit()).max_size(3))
+        .map(|(doc, edits)| TomlIsh { doc, edits })
+        .filter(|case| case.render().parse::<DocumentMut>().is_ok())
+}
+
+/// Port of the `parse_document` fuzz target's property: if input parses, the
+/// displayed document must re-parse, and its display must be a fixed point.
+#[hegel::test(test_cases = 500)]
+fn parsed_document_display_roundtrip_is_stable(tc: hegel::TestCase) {
+    let s = tc.draw(toml_ish()).render();
+    let parsed = s.parse::<DocumentMut>();
+    // The generator keeps only text that parses; this guard never fires.
+    tc.assume(parsed.is_ok());
+    let doc = parsed.unwrap();
+    let encoded = doc.to_string();
+    let reparsed: DocumentMut = encoded
+        .parse()
+        .unwrap_or_else(|err| panic!("error: {err}\ninput: {s:?}\nencoded: {encoded:?}"));
+    assert_eq!(reparsed.to_string(), encoded, "input: {s:?}");
+}
