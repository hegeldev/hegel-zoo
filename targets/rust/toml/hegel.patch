+/// Keys drawn from a small pool (to get collisions) plus arbitrary text.
+const KEY_POOL: &[&str] = &["a", "b", "c", "d"];
+
+fn model_key() -> impl PrintableGenerator<String> {
+    hegel::one_of!(
+        generators::sampled_from(KEY_POOL).map(str::to_owned),
+        generators::text(),
+    )
+}
