diff --git a/crates/toml/tests/testsuite/value.rs b/crates/toml/tests/testsuite/value.rs
index 46513da..926375b 100644
--- a/crates/toml/tests/testsuite/value.rs
+++ b/crates/toml/tests/testsuite/value.rs
@@ -25,3 +25,254 @@ fn display() {
         str!["{ test = 2, test2 = 3 }"].raw()
     );
 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+//
+// The generators are values: a `Value` tree comes from `recursive()` over the
+// scalar generators, a datetime from `one_of!` over its four forms (the day
+// drawn for its month), and the nesting probe draws a `(depth, Nesting)` pair
+// rendered by a pure function.
+// ---------------------------------------------------------------------------
+
+use hegel::PrintableGenerator;
+use hegel::generators::{self, Generator};
+use toml::value::{Date, Datetime, Offset, Time};
+
+/// The last day of `month` in `year`.
+fn days_in_month(year: u16, month: u8) -> u8 {
+    let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
+    match month {
+        2 if leap => 29,
+        2 => 28,
+        4 | 6 | 9 | 11 => 30,
+        _ => 31,
+    }
+}
+
+/// A calendar date: the day is drawn for its month.
+fn date() -> impl PrintableGenerator<Date> {
+    hegel::tuples!(
+        generators::integers::<u16>().max_value(9999),
+        generators::integers::<u8>().min_value(1).max_value(12),
+    )
+    .flat_map(|(year, month)| {
+        generators::integers::<u8>()
+            .min_value(1)
+            .max_value(days_in_month(year, month))
+            .map(move |day| Date { year, month, day })
+    })
+    .print_as_debug()
+}
+
+/// The seconds of a time: absent, whole, or with a fraction (a fraction needs
+/// a seconds part; `60` is only valid by leap-second rules, so 0..=59).
+fn seconds() -> impl PrintableGenerator<(Option<u8>, Option<u32>)> {
+    let second = || generators::integers::<u8>().max_value(59);
+    hegel::one_of!(
+        generators::just((None, None)),
+        second().map(|s| (Some(s), None)),
+        hegel::tuples!(
+            second(),
+            generators::integers::<u32>().max_value(999_999_999)
+        )
+        .map(|(s, n)| (Some(s), Some(n))),
+    )
+}
+
+fn time() -> impl PrintableGenerator<Time> {
+    hegel::tuples!(
+        generators::integers::<u8>().max_value(23),
+        generators::integers::<u8>().max_value(59),
+        seconds(),
+    )
+    .map(|(hour, minute, (second, nanosecond))| Time {
+        hour,
+        minute,
+        second,
+        nanosecond,
+    })
+    .print_as_debug()
+}
+
+/// `Z`, or an offset within +/-23:59 (the RFC 3339 grammar limit; the doc
+/// comment on `Offset::Custom` says `-1_440..1_440`, but -24:00 is not
+/// representable in the TOML grammar).
+fn offset() -> impl PrintableGenerator<Offset> {
+    hegel::one_of!(
+        generators::just(Offset::Z),
+        generators::integers::<i16>()
+            .min_value(-1439)
+            .max_value(1439)
+            .map(|minutes| Offset::Custom { minutes }),
+    )
+    .print_as_debug()
+}
+
+/// A valid TOML datetime in one of the four documented forms, the plain local
+/// date first: local date, local time, local datetime, offset datetime.
+fn datetime() -> impl PrintableGenerator<Datetime> {
+    hegel::one_of!(
+        date().map(|d| Datetime {
+            date: Some(d),
+            time: None,
+            offset: None,
+        }),
+        time().map(|t| Datetime {
+            date: None,
+            time: Some(t),
+            offset: None,
+        }),
+        hegel::tuples!(date(), time()).map(|(d, t)| Datetime {
+            date: Some(d),
+            time: Some(t),
+            offset: None,
+        }),
+        hegel::tuples!(date(), time(), offset()).map(|(d, t, o)| Datetime {
+            date: Some(d),
+            time: Some(t),
+            offset: Some(o),
+        }),
+    )
+    .print_as_debug()
+}
+
+/// Any scalar `toml::Value`.
+fn scalar() -> impl Generator<toml::Value> {
+    hegel::one_of!(
+        generators::integers::<i64>().map(Integer),
+        generators::floats::<f64>().map(Float),
+        generators::booleans().map(Boolean),
+        generators::text().map(String),
+        datetime().map(toml::Value::Datetime),
+    )
+}
+
+/// Up to three `key = value` entries with arbitrary (including empty and
+/// non-ASCII) keys; a repeated key keeps its last value, as `insert` does.
+fn table_of(
+    values: impl Generator<toml::Value> + Send + Sync + 'static,
+) -> impl Generator<Map<std::string::String, toml::Value>> {
+    generators::vecs(hegel::tuples!(generators::text(), values))
+        .max_size(3)
+        .map(|pairs| pairs.into_iter().collect())
+}
+
+/// Any `toml::Value`: a scalar, or an array (up to three) or table (up to
+/// three) of values, nested up to three levels deep.
+fn value() -> impl Generator<toml::Value> {
+    generators::recursive(scalar(), |inner| {
+        hegel::one_of!(
+            generators::vecs(inner.clone()).max_size(3).map(Array),
+            table_of(inner).map(Table),
+        )
+    })
+    .max_depth(3)
+}
+
+/// A document: a table of values.
+fn document() -> impl PrintableGenerator<toml::Value> {
+    table_of(value()).map(Table).print_as_debug()
+}
+
+/// Structural equality that treats any two NaN floats as equal: TOML's
+/// `nan` does not carry sign or payload, and `Value: PartialEq` is `false`
+/// for NaN == NaN. All other floats compare bit-exactly.
+fn values_eq(a: &toml::Value, b: &toml::Value) -> bool {
+    match (a, b) {
+        (Float(x), Float(y)) => (x.is_nan() && y.is_nan()) || x.to_bits() == y.to_bits(),
+        (Array(x), Array(y)) => x.len() == y.len() && x.iter().zip(y).all(|(a, b)| values_eq(a, b)),
+        (Table(x), Table(y)) => {
+            x.len() == y.len()
+                && x.iter()
+                    .all(|(k, v)| y.get(k).is_some_and(|w| values_eq(v, w)))
+        }
+        _ => a == b,
+    }
+}
+
+/// Round-trip: `toml::to_string` then `toml::from_str` recovers an equal
+/// `Value` for arbitrary documents (nested tables, arrays, strings, i64
+/// boundaries, floats including inf/nan/-0.0, bools, datetimes, keys that
+/// need quoting) — and re-serializing the reparsed value is a fixpoint.
+#[hegel::test]
+fn value_serialization_roundtrips_and_is_fixpoint(tc: hegel::TestCase) {
+    let v = tc.draw(document());
+    let s1 =
+        toml::to_string(&v).unwrap_or_else(|err| panic!("serialize error: {err}\nvalue: {v:?}"));
+    let v2: toml::Value = toml::from_str(&s1)
+        .unwrap_or_else(|err| panic!("reparse error: {err}\nserialized:\n```\n{s1}\n```"));
+    assert!(
+        values_eq(&v, &v2),
+        "value changed through roundtrip\noriginal: {v:?}\nreparsed: {v2:?}\nserialized:\n```\n{s1}\n```"
+    );
+    let s2 = toml::to_string(&v2).unwrap_or_else(|err| panic!("re-serialize error: {err}"));
+    assert_eq!(s2, s1, "serialization is not a fixpoint");
+}
+
+/// Parse robustness: `toml::from_str::<Value>` must return `Err` rather
+/// than panic, on arbitrary text and on TOML-shaped soup.
+#[hegel::test]
+fn from_str_value_never_panics(tc: hegel::TestCase) {
+    let s: std::string::String = tc.draw(hegel::one_of!(
+        generators::text(),
+        generators::from_regex(r#"[a-z0-9=\[\]{}.,#'"\\ \n\t-]{0,60}"#).fullmatch(true),
+    ));
+    let _ = toml::from_str::<toml::Value>(&s);
+}
+
+/// The shapes of deeply nested input.
+#[derive(Clone, Copy, Debug, hegel::PrettyPrintable)]
+enum Nesting {
+    /// `a = [[[...]]]`
+    Arrays,
+    /// `a.a.a... = 1`
+    DottedKey,
+    /// `[[[[` — never valid, but must not crash either.
+    Unclosed,
+}
+
+const NESTINGS: &[Nesting] = &[Nesting::Arrays, Nesting::DottedKey, Nesting::Unclosed];
+
+impl Nesting {
+    /// The input at `depth`, and whether it is valid TOML (the recursion
+    /// guard admits 80 levels).
+    fn input(self, depth: usize) -> (std::string::String, bool) {
+        match self {
+            Nesting::Arrays => (
+                format!("a = {}{}", "[".repeat(depth), "]".repeat(depth)),
+                depth <= 80,
+            ),
+            Nesting::DottedKey => {
+                let mut s = std::string::String::from("a");
+                for _ in 1..depth {
+                    s.push_str(".a");
+                }
+                s.push_str(" = 1");
+                (s, depth <= 80)
+            }
+            Nesting::Unclosed => ("[".repeat(depth), false),
+        }
+    }
+}
+
+/// Depths past the guard: 1 to 200, or one of the boundary and extreme values.
+const DEPTHS: &[usize] = &[79, 80, 81, 1000, 4096];
+
+fn depth() -> impl PrintableGenerator<usize> {
+    hegel::one_of!(
+        generators::integers::<usize>().min_value(1).max_value(200),
+        generators::sampled_from(DEPTHS),
+    )
+}
+
+/// Deeply nested input must never crash the deserializer: the recursion
+/// guard (`LIMIT = 80` in `src/de/parser/mod.rs`) turns it into a clean
+/// error. Sweeps depth well past the guard, pinning the exact boundary.
+#[hegel::test(test_cases = 50)]
+fn deeply_nested_documents_error_gracefully(tc: hegel::TestCase) {
+    let (depth, kind) = tc.draw(hegel::tuples!(depth(), generators::sampled_from(NESTINGS)));
+    let (input, expect_ok) = kind.input(depth);
+    let result = toml::from_str::<toml::Value>(&input);
+    assert_eq!(result.is_ok(), expect_ok, "depth {depth}, kind {kind:?}");
+}
