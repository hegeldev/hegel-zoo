 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use hegel::generators::{self, Generator};
+
+/// A valid TOML datetime in one of the four documented forms (offset
+/// datetime, local datetime, local date, local time), with field ranges
+/// taken from the `toml_datetime` docs (offset bounded to ±23:59, the RFC
+/// 3339 grammar limit; leap seconds and fractions-without-seconds excluded
+/// as unrepresentable).
+#[hegel::composite]
+fn arbitrary_datetime(tc: &hegel::TestCase) -> toml::value::Datetime {
+    use toml::value::{Date, Datetime, Offset, Time};
+    // 0 = offset datetime, 1 = local datetime, 2 = local date, 3 = local time
+    let kind: u8 = tc.draw(generators::integers::<u8>().max_value(3));
+    let date = (kind != 3).then(|| {
+        let year: u16 = tc.draw(generators::integers::<u16>().max_value(9999));
+        let month: u8 = tc.draw(generators::integers::<u8>().min_value(1).max_value(12));
+        let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
+        let max_day: u8 = match month {
+            2 => {
+                if leap {
+                    29
+                } else {
+                    28
+                }
+            }
+            4 | 6 | 9 | 11 => 30,
+            _ => 31,
+        };
+        let day: u8 = tc.draw(generators::integers::<u8>().min_value(1).max_value(max_day));
+        Date { year, month, day }
+    });
+    let time = (kind != 2).then(|| {
+        let hour: u8 = tc.draw(generators::integers::<u8>().max_value(23));
+        let minute: u8 = tc.draw(generators::integers::<u8>().max_value(59));
+        let second: Option<u8> =
+            tc.draw(generators::optional(generators::integers::<u8>().max_value(59)));
+        let nanosecond: Option<u32> = if second.is_some() {
+            tc.draw(generators::optional(
+                generators::integers::<u32>().max_value(999_999_999),
+            ))
+        } else {
+            None
+        };
+        Time {
+            hour,
+            minute,
+            second,
+            nanosecond,
+        }
+    });
+    let offset = (kind == 0).then(|| {
+        tc.draw((hegel::one_of!(
+            generators::just(Offset::Z),
+            generators::integers::<i16>()
+                .min_value(-1439)
+                .max_value(1439)
+                .map(|minutes| Offset::Custom { minutes }),
+        )).print_as_debug())
+    });
+    Datetime { date, time, offset }
+}
+
+/// Any `toml::Value`, nested up to `depth` levels. Plain helper rather than
+/// a `#[hegel::composite]` because a composite cannot recursively draw from
+/// itself (E0283).
+fn arbitrary_value(tc: &hegel::TestCase, depth: u8) -> toml::Value {
+    let choice: u8 = if depth == 0 {
+        tc.draw(generators::integers::<u8>().max_value(4))
+    } else {
+        tc.draw(generators::integers::<u8>().max_value(6))
+    };
+    match choice {
+        0 => Integer(tc.draw(generators::integers::<i64>())),
+        1 => Float(tc.draw(generators::floats::<f64>())),
+        2 => Boolean(tc.draw(generators::booleans())),
+        3 => String(tc.draw(generators::text())),
+        4 => toml::Value::Datetime(tc.draw((arbitrary_datetime()).print_as_debug())),
+        5 => {
+            let n: usize = tc.draw(generators::integers::<usize>().max_value(3));
+            Array((0..n).map(|_| arbitrary_value(tc, depth - 1)).collect())
+        }
+        _ => Table(arbitrary_table(tc, depth - 1)),
+    }
+}
+
+/// An arbitrary table with arbitrary (including empty/unicode) keys.
+fn arbitrary_table(
+    tc: &hegel::TestCase,
+    depth: u8,
+) -> Map<std::string::String, toml::Value> {
+    let n: usize = tc.draw(generators::integers::<usize>().max_value(3));
+    let mut m = Map::new();
+    for _ in 0..n {
+        let k: std::string::String = tc.draw(generators::text());
+        m.insert(k, arbitrary_value(tc, depth));
+    }
+    m
+}
+
+/// Structural equality that treats any two NaN floats as equal: TOML's
+/// `nan` does not carry sign or payload, and `Value: PartialEq` is `false`
+/// for NaN == NaN. All other floats compare bit-exactly.
+fn values_eq(a: &toml::Value, b: &toml::Value) -> bool {
+    match (a, b) {
+        (Float(x), Float(y)) => {
+            (x.is_nan() && y.is_nan()) || x.to_bits() == y.to_bits()
+        }
+        (Array(x), Array(y)) => {
+            x.len() == y.len() && x.iter().zip(y).all(|(a, b)| values_eq(a, b))
+        }
+        (Table(x), Table(y)) => {
+            x.len() == y.len()
+                && x.iter()
+                    .all(|(k, v)| y.get(k).is_some_and(|w| values_eq(v, w)))
+        }
+        _ => a == b,
+    }
+}
+
+/// Round-trip: `toml::to_string` then `toml::from_str` recovers an equal
+/// `Value` for arbitrary documents (nested tables, arrays, strings, i64
+/// boundaries, floats including inf/nan/-0.0, bools, datetimes, keys that
+/// need quoting) — and re-serializing the reparsed value is a fixpoint.
+#[hegel::test]
+fn value_serialization_roundtrips_and_is_fixpoint(tc: hegel::TestCase) {
+    let v = Table(arbitrary_table(&tc, 3));
+    let s1 = toml::to_string(&v).unwrap_or_else(|err| panic!("serialize error: {err}\nvalue: {v:?}"));
+    let v2: toml::Value = toml::from_str(&s1)
+        .unwrap_or_else(|err| panic!("reparse error: {err}\nserialized:\n```\n{s1}\n```"));
+    assert!(
+        values_eq(&v, &v2),
+        "value changed through roundtrip\noriginal: {v:?}\nreparsed: {v2:?}\nserialized:\n```\n{s1}\n```"
+    );
+    let s2 = toml::to_string(&v2).unwrap_or_else(|err| panic!("re-serialize error: {err}"));
+    assert_eq!(s2, s1, "serialization is not a fixpoint");
+}
+
+/// Parse robustness: `toml::from_str::<Value>` must return `Err` rather
+/// than panic, on arbitrary text and on TOML-shaped soup.
+#[hegel::test]
+fn from_str_value_never_panics(tc: hegel::TestCase) {
+    let s: std::string::String = tc.draw(hegel::one_of!(
+        generators::text(),
+        generators::from_regex(r#"[a-z0-9=\[\]{}.,#'"\\ \n\t-]{0,60}"#).fullmatch(true),
+    ));
+    let _ = toml::from_str::<toml::Value>(&s);
+}
+
+/// Deeply nested input must never crash the deserializer: the recursion
+/// guard (`LIMIT = 80` in `src/de/parser/mod.rs`) turns it into a clean
+/// error. Sweeps depth well past the guard, pinning the exact boundary.
+#[hegel::test(test_cases = 50)]
+fn deeply_nested_documents_error_gracefully(tc: hegel::TestCase) {
+    let depth: usize = tc.draw(hegel::one_of!(
+        generators::integers::<usize>().min_value(1).max_value(200),
+        generators::sampled_from(vec![79_usize, 80, 81, 1000, 4096]),
+    ));
+    let kind: u8 = tc.draw(generators::integers::<u8>().max_value(2));
+    let (input, expect_ok) = match kind {
+        0 => (
+            format!("a = {}{}", "[".repeat(depth), "]".repeat(depth)),
+            depth <= 80,
+        ),
+        1 => {
+            let mut s = std::string::String::from("a");
+            for _ in 1..depth {
+                s.push_str(".a");
+            }
+            s.push_str(" = 1");
+            (s, depth <= 80)
+        }
+        // Unclosed bracket soup is never valid, but must not crash either.
+        _ => ("[".repeat(depth), false),
+    };
+    let result = toml::from_str::<toml::Value>(&input);
+    assert_eq!(result.is_ok(), expect_ok, "depth {depth}, kind {kind}");
+}
