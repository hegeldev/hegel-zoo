+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+//
+// Properties below are grounded in:
+//  * the crate's own fuzz target (fuzz/fuzz_targets/earcut.rs): `earcut` must
+//    tolerate arbitrary finite vertices, arbitrary hole indices and arbitrary
+//    dims without panicking;
+//  * the `deviation` helper (src/legacy.rs), documented as "used to verify
+//    correctness of triangulation": the triangulation must cover the same
+//    area as the polygon itself (this is what every `area_test` above checks
+//    for fixture files);
+//  * the classic earcut invariant that a simple polygon with V vertices and
+//    H holes triangulates into exactly V + 2H - 2 triangles (bridging each
+//    hole into the outer ring duplicates 2 vertices; a ring of k vertices
+//    yields k - 2 triangles).
+mod hegel_properties {
+    use hegel::generators;
+
+    /// Twice the signed area of a ring given as a flat [x0, y0, x1, y1, ...]
+    /// slice (shoelace formula) — independent oracle, not the crate's code.
+    fn ring_double_area(v: &[f64]) -> f64 {
+        let n = v.len() / 2;
+        let mut sum = 0.0;
+        for i in 0..n {
+            let j = (i + 1) % n;
+            sum += v[2 * i] * v[2 * j + 1] - v[2 * j] * v[2 * i + 1];
+        }
+        sum
+    }
+
+    /// Twice the total absolute area of the triangles emitted by earcut.
+    fn triangles_double_area(v: &[f64], tris: &[usize]) -> f64 {
+        tris.chunks(3)
+            .map(|t| {
+                let (ax, ay) = (v[2 * t[0]], v[2 * t[0] + 1]);
+                let (bx, by) = (v[2 * t[1]], v[2 * t[1] + 1]);
+                let (cx, cy) = (v[2 * t[2]], v[2 * t[2] + 1]);
+                ((bx - ax) * (cy - ay) - (by - ay) * (cx - ax)).abs()
+            })
+            .sum()
+    }
+
+    /// Assert that the triangles' total (double) area equals the polygon's
+    /// (double) area within a floating-point rounding bound.
+    ///
+    /// The bound is absolute and of shoelace shape, k * n * scale^2 * eps:
+    /// each of the ~n cross products above carries an absolute rounding error
+    /// of a few ULPs of scale^2 (coordinates bounded by `scale`). It protects
+    /// against fp noise only — for the polygons generated below, a genuinely
+    /// missing or overlapping triangle changes the sum by many orders of
+    /// magnitude more than this.
+    fn assert_area_partition(v: &[f64], tris: &[usize], expected_double_area: f64) {
+        let actual = triangles_double_area(v, tris);
+        let scale = v.iter().fold(1.0f64, |m, &c| m.max(c.abs()));
+        let bound = 32.0 * (v.len() as f64) * scale * scale * f64::EPSILON;
+        assert!(
+            (actual - expected_double_area).abs() <= bound,
+            "triangle double-area {} != polygon double-area {} (allowed fp noise {})",
+            actual,
+            expected_double_area,
+            bound
+        );
+    }
+
+    /// Sorted, distinct angles on a 0.1-degree grid. Adjacent vertices are
+    /// separated by at least ~1.7e-3 rad, so no three generated circle points
+    /// round to exactly-collinear f64 coordinates. That keeps earcut's
+    /// zero-area vertex filter (`filter_points`) from removing vertices,
+    /// which would legitimately change the triangle count.
+    fn draw_angles(tc: &hegel::TestCase, n: usize) -> Vec<f64> {
+        let mut ticks: Vec<u32> = tc.draw(
+            generators::vecs(generators::integers::<u32>().max_value(3599))
+                .min_size(n)
+                .max_size(n)
+                .unique(true),
+        );
+        ticks.sort_unstable();
+        ticks
+            .iter()
+            .map(|&t| f64::from(t) * (std::f64::consts::PI * 2.0) / 3600.0)
+            .collect()
+    }
+
+    fn draw_center(tc: &hegel::TestCase) -> (f64, f64) {
+        (
+            tc.draw(generators::floats::<f64>().min_value(-1000.0).max_value(1000.0)),
+            tc.draw(generators::floats::<f64>().min_value(-1000.0).max_value(1000.0)),
+        )
+    }
+
+    /// A strictly convex polygon: distinct grid angles on a circle.
+    /// n ranges over 3..=100 so vertices.len() crosses the crate's
+    /// hashed/unhashed dispatch threshold (`vertices.len() < 80`).
+    fn draw_convex_polygon(tc: &hegel::TestCase) -> Vec<f64> {
+        let n = tc.draw(generators::integers::<usize>().min_value(3).max_value(100));
+        let angles = draw_angles(tc, n);
+        let r = tc.draw(generators::floats::<f64>().min_value(1.0).max_value(1000.0));
+        let (cx, cy) = draw_center(tc);
+        let mut v = Vec::with_capacity(2 * n);
+        for a in angles {
+            v.push(cx + r * a.cos());
+            v.push(cy + r * a.sin());
+        }
+        v
+    }
+
+    /// A simple (star-shaped, generally concave) polygon: distinct sorted
+    /// angles around a centre with an independent radius per vertex.
+    ///
+    /// Sorted angles alone do NOT make the ring simple: if all vertices fall
+    /// inside one half-plane cone, the closing edge cuts back through the
+    /// polygon (found by an earlier version of this generator — earcut's
+    /// output on such self-intersecting input is out of its domain). One
+    /// anchor tick per quadrant keeps every angular gap, wraparound
+    /// included, below pi, so each edge chord stays inside its own convex
+    /// angular sector and the ring is genuinely simple.
+    fn draw_star_polygon(tc: &hegel::TestCase) -> Vec<f64> {
+        let mut ticks: std::collections::BTreeSet<u32> = (0..4)
+            .map(|q| q * 900 + tc.draw(generators::integers::<u32>().max_value(899)))
+            .collect();
+        let extras: Vec<u32> = tc.draw(
+            generators::vecs(generators::integers::<u32>().max_value(3599)).max_size(96),
+        );
+        ticks.extend(extras);
+        let angles: Vec<f64> = ticks
+            .iter()
+            .map(|&t| f64::from(t) * (std::f64::consts::PI * 2.0) / 3600.0)
+            .collect();
+        let (cx, cy) = draw_center(tc);
+        let mut v = Vec::with_capacity(2 * angles.len());
+        for a in angles {
+            let r = tc.draw(generators::floats::<f64>().min_value(1.0).max_value(1000.0));
+            v.push(cx + r * a.cos());
+            v.push(cy + r * a.sin());
+        }
+        v
+    }
+
+    struct HoledPolygon {
+        vertices: Vec<f64>,
+        hole_indices: Vec<usize>,
+        num_holes: usize,
+        /// exact double area (outer minus holes)
+        double_area: f64,
+    }
+
+    /// An axis-aligned rectangle with `h` disjoint rectangular holes, one per
+    /// 10x10 cell, all strictly inside the outer ring. Every coordinate is a
+    /// small integer, so all shoelace terms below are exact in f64 and area
+    /// assertions can be exact equalities.
+    fn draw_rect_with_holes(tc: &hegel::TestCase, max_holes: usize) -> HoledPolygon {
+        let h = tc.draw(
+            generators::integers::<usize>()
+                .min_value(1)
+                .max_value(max_holes),
+        );
+        let ox = tc.draw(generators::integers::<i64>().min_value(-1000).max_value(1000));
+        let oy = tc.draw(generators::integers::<i64>().min_value(-1000).max_value(1000));
+        let w = 10 * h as i64;
+
+        let mut vertices: Vec<f64> = Vec::new();
+        for (x, y) in [(0, 0), (w, 0), (w, 10), (0, 10)] {
+            vertices.push((ox + x) as f64);
+            vertices.push((oy + y) as f64);
+        }
+
+        // Distinct y coordinates across ALL hole corners: if two hole corners
+        // share a y, the hole-elimination bridge can be exactly horizontal
+        // and collinear with hole edges, and earcut's `filter_points`
+        // legitimately removes the collinear vertices — same area, fewer
+        // triangles. The V + 2H - 2 count only holds in general position
+        // (verified: on aligned holes the count drops while the exact-area
+        // property still passes).
+        let mut ys: Vec<i64> = tc.draw(
+            generators::vecs(generators::integers::<i64>().min_value(1).max_value(9))
+                .min_size(2 * h)
+                .max_size(2 * h)
+                .unique(true),
+        );
+        ys.sort_unstable();
+
+        let mut hole_indices = Vec::new();
+        let mut holes_double_area = 0i64;
+        for i in 0..h {
+            let x1 = tc.draw(generators::integers::<i64>().min_value(1).max_value(8));
+            let x2 = tc.draw(generators::integers::<i64>().min_value(x1 + 1).max_value(9));
+            let y1 = ys[2 * i];
+            let y2 = ys[2 * i + 1];
+            let base = 10 * i as i64;
+            hole_indices.push(vertices.len() / 2);
+            let mut ring = vec![
+                (base + x1, y1),
+                (base + x2, y1),
+                (base + x2, y2),
+                (base + x1, y2),
+            ];
+            // earcut documents that it normalizes ring winding itself, so
+            // holes may be given in either orientation.
+            if tc.draw(generators::booleans()) {
+                ring.reverse();
+            }
+            for (x, y) in ring {
+                vertices.push((ox + x) as f64);
+                vertices.push((oy + y) as f64);
+            }
+            holes_double_area += 2 * (x2 - x1) * (y2 - y1);
+        }
+
+        HoledPolygon {
+            vertices,
+            hole_indices,
+            num_holes: h,
+            double_area: (2 * w * 10 - holes_double_area) as f64,
+        }
+    }
+
+    /// Property 1 (robustness, mirrors and broadens the crate's fuzz target):
+    /// `earcut` never panics on arbitrary finite input — odd vertex counts,
+    /// garbage hole indices (full-range usize exercises the checked_mul
+    /// overflow guard in `eliminate_holes`), arbitrary dims — and whenever it
+    /// returns Ok, the output is well-formed: a multiple of 3 indices, all in
+    /// range for the vertex slice.
+    fn check_arbitrary<T: earcutr::Float + std::fmt::Debug>(
+        vertices: &[T],
+        holes: &[usize],
+        dims: usize,
+    ) {
+        if let Ok(tris) = earcutr::earcut(vertices, holes, dims) {
+            assert_eq!(tris.len() % 3, 0, "triangle index count not a multiple of 3");
+            let num_vertices = vertices.len() / 2;
+            for &i in &tris {
+                assert!(
+                    i < num_vertices,
+                    "emitted index {} out of range for {} vertices",
+                    i,
+                    num_vertices
+                );
+            }
+        }
+    }
+
+    /// Replicates earcut's contour slicing just enough to detect the one
+    /// known panic trigger (see `known_failure_earcut_panics_when_contour_x_all_type_max`):
+    /// a contour that earcut would actually process (it error-checks earlier
+    /// contours first) whose x coordinates are ALL exactly `T::max_value()`.
+    fn hits_known_all_max_x_contour<T: earcutr::Float>(vertices: &[T], holes: &[usize]) -> bool {
+        if vertices.is_empty() || vertices.len() % 2 == 1 {
+            return false;
+        }
+        let maxv = T::max_value();
+        let mut bounds: Vec<usize> = vec![0];
+        for &h in holes {
+            match h.checked_mul(2) {
+                Some(x) => bounds.push(x),
+                None => break, // earcut returns Err on overflow before adding this contour
+            }
+        }
+        bounds.push(vertices.len());
+        for w in bounds.windows(2) {
+            let (s, e) = (w[0], w[1]);
+            // mirrors add_contour's validation: earcut returns Err at the
+            // first invalid contour, so later contours can't panic
+            if s > vertices.len() || e > vertices.len() || e < 2 || e - 2 < s {
+                return false;
+            }
+            if vertices[s..e].iter().step_by(2).all(|&x| x == maxv) {
+                return true;
+            }
+        }
+        false
+    }
+
+    /// KNOWN FAILURE — real bug in `earcut`, deliberately left failing.
+    ///
+    /// `earcut` panics (`Option::unwrap()` on `None` in `add_contour`,
+    /// src/lib.rs) whenever the x coordinates of a contour are all exactly
+    /// `T::max_value()`: `contour_minx` starts at `T::max_value()` and is
+    /// only updated on a strict `>` comparison, so `leftmost_idx` is never
+    /// assigned. Found by hegel via
+    /// `earcut_arbitrary_input_no_panic_and_output_well_formed` (shrunk
+    /// input: `[1.7976931348623157e308, 0.0]`). It reproduces identically
+    /// with `f32::MAX`, and with a perfectly normal outer polygon whose
+    /// *hole* ring has all x = MAX, e.g.
+    /// `earcut(&[0., 0., 10., 0., 10., 10., 0., 10., MAX, 1., MAX, 2., MAX, 3.], &[4], 2)`.
+    /// Finite coordinates are inside the domain of the crate's own fuzz
+    /// target (fuzz/fuzz_targets/earcut.rs), and `earcut` returns `Result`,
+    /// so this input should produce an `Err` (like other unrepresentable
+    /// inputs do via `Error::Unknown`), not a panic.
+    #[test]
+    fn known_failure_earcut_panics_when_contour_x_all_type_max() {
+        // Property: earcut never panics on finite input. This call panics.
+        drop(earcutr::earcut::<f64>(&[f64::MAX, 0.0], &[], 2));
+    }
+
+    #[hegel::test]
+    fn earcut_arbitrary_input_no_panic_and_output_well_formed(tc: hegel::TestCase) {
+        // The fuzz target only feeds finite coordinates, which is the
+        // documented domain; NaN/inf are excluded here for the same reason.
+        let holes: Vec<usize> = tc.draw(generators::vecs(hegel::one_of!(
+            generators::integers::<usize>().max_value(32),
+            generators::integers::<usize>(),
+        )));
+        let dims: usize = tc.draw(hegel::one_of!(
+            generators::just(2usize),
+            generators::integers::<usize>().max_value(8),
+        ));
+        if tc.draw(generators::booleans()) {
+            let vertices: Vec<f64> = tc.draw(generators::vecs(
+                generators::floats::<f64>()
+                    .allow_nan(false)
+                    .allow_infinity(false),
+            )
+            .max_size(64));
+            // Known bug, pinned by known_failure_earcut_panics_when_contour_x_all_type_max:
+            // an all-x-equal-to-MAX contour panics. Excluded here so this
+            // property keeps testing everything else.
+            tc.assume(!hits_known_all_max_x_contour(&vertices, &holes));
+            check_arbitrary(&vertices, &holes, dims);
+        } else {
+            // f32 variant — the type the fuzz target uses.
+            let vertices: Vec<f32> = tc.draw(generators::vecs(
+                generators::floats::<f32>()
+                    .allow_nan(false)
+                    .allow_infinity(false),
+            )
+            .max_size(64));
+            // same known-bug exclusion as the f64 branch above
+            tc.assume(!hits_known_all_max_x_contour(&vertices, &holes));
+            check_arbitrary(&vertices, &holes, dims);
+        }
+    }
+
+    /// Property 2: a strictly convex polygon with n vertices triangulates
+    /// into exactly n - 2 triangles.
+    #[hegel::test]
+    fn convex_polygon_triangle_count_is_n_minus_2(tc: hegel::TestCase) {
+        let v = draw_convex_polygon(&tc);
+        let n = v.len() / 2;
+        let tris = earcutr::earcut(&v, &[], 2).unwrap();
+        assert_eq!(
+            tris.len(),
+            3 * (n - 2),
+            "expected {} triangles for a convex {}-gon, got {}",
+            n - 2,
+            n,
+            tris.len() / 3
+        );
+    }
+
+    /// Property 3: the triangles of a convex polygon partition it — their
+    /// total area equals the polygon's shoelace area.
+    #[hegel::test]
+    fn convex_polygon_triangle_areas_sum_to_polygon_area(tc: hegel::TestCase) {
+        let v = draw_convex_polygon(&tc);
+        let tris = earcutr::earcut(&v, &[], 2).unwrap();
+        assert_area_partition(&v, &tris, ring_double_area(&v).abs());
+    }
+
+    /// Property 4: same area-partition oracle for concave simple polygons.
+    #[hegel::test]
+    fn star_polygon_triangle_areas_sum_to_polygon_area(tc: hegel::TestCase) {
+        let v = draw_star_polygon(&tc);
+        let tris = earcutr::earcut(&v, &[], 2).unwrap();
+        assert_area_partition(&v, &tris, ring_double_area(&v).abs());
+    }
+
+    /// Property 5: a polygon with V total vertices and one hole in general
+    /// position triangulates into exactly V + 2*1 - 2 triangles (the hole
+    /// bridge duplicates two vertices; a ring of k vertices yields k - 2
+    /// triangles).
+    ///
+    /// Restricted to a single hole: with several holes, a later hole's
+    /// bridge can route through an earlier bridge's zero-width channel, and
+    /// `filter_points` then removes an immediately-degenerate duplicate
+    /// node — a correct triangulation (the exact-area property 6 and
+    /// deviation property 7 still pass on such inputs, with up to 4 holes)
+    /// with fewer than V + 2H - 2 triangles. Verified against a concrete
+    /// 3-hole counterexample producing 19 instead of 20 triangles with all
+    /// 16 vertices used and deviation exactly 0.
+    #[hegel::test]
+    fn holed_polygon_triangle_count_is_v_plus_2h_minus_2(tc: hegel::TestCase) {
+        let p = draw_rect_with_holes(&tc, 1);
+        let tris = earcutr::earcut(&p.vertices, &p.hole_indices, 2).unwrap();
+        let v = p.vertices.len() / 2;
+        assert_eq!(
+            tris.len() / 3,
+            v + 2 * p.num_holes - 2,
+            "V={} H={} produced {} triangles",
+            v,
+            p.num_holes,
+            tris.len() / 3
+        );
+    }
+
+    /// Property 6: the triangulation of a holed polygon covers exactly the
+    /// outer area minus the hole areas. Integer coordinates make every
+    /// shoelace term exact in f64, so this equality is exact.
+    #[hegel::test]
+    fn holed_polygon_triangle_areas_sum_exactly(tc: hegel::TestCase) {
+        let p = draw_rect_with_holes(&tc, 4);
+        let tris = earcutr::earcut(&p.vertices, &p.hole_indices, 2).unwrap();
+        assert_eq!(
+            triangles_double_area(&p.vertices, &tris),
+            p.double_area,
+            "triangle area sum differs from outer-minus-holes area"
+        );
+    }
+
+    /// Property 7: the crate's own `deviation` helper (documented: "used to
+    /// verify correctness of triangulation") reports ~0 for the triangulation
+    /// of a valid holed polygon — this also exercises deviation's own
+    /// hole-subtraction logic.
+    #[hegel::test]
+    fn deviation_is_zero_for_valid_triangulation(tc: hegel::TestCase) {
+        let p = draw_rect_with_holes(&tc, 4);
+        let tris = earcutr::earcut(&p.vertices, &p.hole_indices, 2).unwrap();
+        let dev = earcutr::deviation(&p.vertices, &p.hole_indices, 2, &tris);
+        assert!(dev.abs() < 1e-12, "deviation {} for a valid polygon", dev);
+    }
+
+    /// Property 8: earcut is invariant under ring re-representation — the
+    /// same polygon given with reversed winding, or as a GeoJSON-style
+    /// closed ring (first vertex repeated at the end), triangulates to the
+    /// same triangle count and the same total area. Evidence: `add_contour`
+    /// normalizes winding and drops a duplicated final vertex.
+    #[hegel::test]
+    fn earcut_invariant_under_ring_representation(tc: hegel::TestCase) {
+        let v = draw_star_polygon(&tc);
+        let tris = earcutr::earcut(&v, &[], 2).unwrap();
+
+        let variant: Vec<f64> = if tc.draw(generators::booleans()) {
+            // reversed winding: same polygon, opposite orientation
+            v.chunks(2).rev().flatten().copied().collect()
+        } else {
+            // closed ring: first vertex repeated at the end
+            let mut w = v.clone();
+            w.extend_from_slice(&v[..2]);
+            w
+        };
+        let tris_variant = earcutr::earcut(&variant, &[], 2).unwrap();
+
+        assert_eq!(
+            tris.len(),
+            tris_variant.len(),
+            "triangle count changed under re-representation"
+        );
+        let a = triangles_double_area(&v, &tris);
+        let b = triangles_double_area(&variant, &tris_variant);
+        let scale = v.iter().fold(1.0f64, |m, &c| m.max(c.abs()));
+        let bound = 64.0 * (v.len() as f64) * scale * scale * f64::EPSILON;
+        assert!(
+            (a - b).abs() <= bound,
+            "areas diverged under re-representation: {} vs {} (allowed fp noise {})",
+            a,
+            b,
+            bound
+        );
+    }
+
+    /// Property 9 (degenerate edge case, evidence: the `degenerate` fixture
+    /// expects 0 triangles): a "polygon" whose vertices are all exactly
+    /// collinear (constructed on an integer lattice, so collinearity is exact
+    /// in f64) triangulates to nothing.
+    #[hegel::test]
+    fn collinear_polygon_yields_no_triangles(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().min_value(3).max_value(50));
+        let ts: Vec<i64> = tc.draw(
+            generators::vecs(generators::integers::<i64>().min_value(-1000).max_value(1000))
+                .min_size(n)
+                .max_size(n)
+                .unique(true),
+        );
+        let dx = tc.draw(generators::integers::<i64>().min_value(-50).max_value(50));
+        let dy = tc.draw(generators::integers::<i64>().min_value(-50).max_value(50));
+        // construct a nonzero direction rather than filtering
+        let (dx, dy) = if dx == 0 && dy == 0 { (1, 0) } else { (dx, dy) };
+        let px = tc.draw(generators::integers::<i64>().min_value(-1000).max_value(1000));
+        let py = tc.draw(generators::integers::<i64>().min_value(-1000).max_value(1000));
+
+        let mut v = Vec::with_capacity(2 * n);
+        for &t in &ts {
+            v.push((px + t * dx) as f64);
+            v.push((py + t * dy) as f64);
+        }
+
+        let tris = earcutr::earcut(&v, &[], 2).unwrap();
+        assert!(
+            tris.is_empty(),
+            "collinear input produced {} triangle indices: {:?}",
+            tris.len(),
+            tris
+        );
+    }
+}
