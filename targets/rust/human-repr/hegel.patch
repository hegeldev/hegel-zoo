+//! Hegel properties for `human-repr` 1.1.0: every representation is parsed back and checked
+//! against the documented structure (prefix table, decimal budget, range of the printed number,
+//! `M:SS.s` / `H:MM:SS` forms) and against the input value to within half a unit of the last
+//! printed decimal; negatives mirror positives; `PartialEq<&str>`, `Debug` and serde agree with
+//! `Display`.
+
+use hegel::{generators, TestCase};
+use human_repr::{
+    HumanCount, HumanCountData, HumanDuration, HumanDurationData, HumanThroughput,
+    HumanThroughputData,
+};
+use std::time::Duration;
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo as i64).max_value($hi as i64)
+    };
+}
+
+fn n(tc: &mut TestCase, lo: i64, hi: i64) -> i64 {
+    tc.draw(int!(lo, hi))
+}
+
+fn pick<T: Clone>(tc: &mut TestCase, items: &[T]) -> T {
+    let i = n(tc, 0, items.len() as i64 - 1) as usize;
+    items[i].clone()
+}
+
+fn chance(tc: &mut TestCase, pct: i64) -> bool {
+    n(tc, 0, 99) < pct
+}
+
+/// A positive magnitude, log-uniform between 10^lo and 10^(hi+1), sometimes a whole number.
+fn arb_mag(tc: &mut TestCase, lo: i32, hi: i32) -> f64 {
+    let exp = n(tc, lo as i64, hi as i64) as i32;
+    let mantissa = n(tc, 100_000, 999_999) as f64 / 100_000.0;
+    let v = mantissa * 10f64.powi(exp);
+    if exp >= 0 && chance(tc, 30) { v.round().max(1.0) } else { v }
+}
+
+const UNITS: [&str; 8] = ["", "B", "Crabs", "°C", "🦀", "packets", "Tasks", "it"];
+const PREFIXES: [(&str, i32); 9] = [
+    ("", 0),
+    ("k", 1),
+    ("M", 2),
+    ("G", 3),
+    ("T", 4),
+    ("P", 5),
+    ("E", 6),
+    ("Z", 7),
+    ("Y", 8),
+];
+/// Decimals allowed per prefix (README: "the number of decimals also increase the larger the
+/// prefix gets"; the crate's table is 1, 1, 1, then 2).
+const COUNT_DECIMALS: [usize; 9] = [1, 1, 1, 2, 2, 2, 2, 2, 2];
+
+fn decimals_of(num: &str) -> usize {
+    num.split_once('.').map_or(0, |(_, frac)| frac.len())
+}
+
+/// Checks the printed number: parseable, no trailing zero decimals, at most `max_dec` decimals.
+fn check_number(text: &str, num: &str, max_dec: usize) -> f64 {
+    let v: f64 = num.parse().unwrap_or_else(|_| panic!("{text:?}: bad number {num:?}"));
+    assert!(v.is_finite(), "{text:?}");
+    let d = decimals_of(num);
+    assert!(d <= max_dec, "{text:?}: {d} decimals, at most {max_dec}");
+    if d > 0 {
+        assert!(!num.ends_with('0'), "{text:?}: trailing zero decimal");
+    }
+    v
+}
+
+/// Splits `<num><prefix>` (unit already removed) into the number text and the prefix index.
+fn split_prefix(text: &str, body: &str) -> (String, usize) {
+    for (i, (p, _)) in PREFIXES.iter().enumerate().skip(1) {
+        if let Some(num) = body.strip_suffix(p) {
+            return (num.to_string(), i);
+        }
+    }
+    assert!(
+        body.bytes().all(|b| b.is_ascii_digit() || b == b'.' || b == b'-'),
+        "{text:?}: unknown prefix in {body:?}"
+    );
+    (body.to_string(), 0)
+}
+
+/// The count structure: `<num><prefix><unit>`, |num| < 1000, |num| ≥ 1 unless bare, the
+/// decimal budget of the prefix, and `num × 1000^k` within half a unit of the last allowed
+/// decimal of `val`. Returns the value read back.
+fn check_count(text: &str, unit: &str, val: f64) -> f64 {
+    let body = text
+        .strip_suffix(unit)
+        .unwrap_or_else(|| panic!("{text:?} does not end with unit {unit:?}"));
+    let (num, k) = split_prefix(text, body);
+    let v = check_number(text, &num, COUNT_DECIMALS[k]);
+    assert!(v.abs() < 1000.0, "{text:?}: number reaches the next prefix");
+    if k > 0 {
+        assert!(v.abs() >= 1.0, "{text:?}: a smaller prefix would do");
+    }
+    let mult = 1000f64.powi(k as i32);
+    let read = v * mult;
+    let tolerance = 0.5 * 10f64.powi(-(COUNT_DECIMALS[k] as i32)) * mult * (1.0 + 1e-9)
+        + val.abs() * 1e-12;
+    assert!(
+        (read - val).abs() <= tolerance,
+        "{text:?} reads {read}, value {val} (tolerance {tolerance})"
+    );
+    read
+}
+
+// ---------------------------------------------------------------- counts
+
+#[hegel::test]
+fn counts_read_back(mut tc: TestCase) {
+    let unit = pick(&mut tc, &UNITS);
+    // below 10^26: from 999.995 Y the documented `+` overflow form takes over
+    let mag = arb_mag(&mut tc, -3, 25);
+    let val = if chance(&mut tc, 30) { -mag } else { mag };
+    let h = val.human_count(unit);
+    let text = h.to_string();
+    let read = check_count(&text, unit, val);
+    // the sign is the value's (a zero's sign is human-repr/3, pinned separately)
+    if read != 0.0 {
+        assert_eq!(text.starts_with('-'), read < 0.0, "{text:?}");
+    }
+    // the three faces of the representation agree
+    assert!(text.as_str() == h, "PartialEq<&str> disagrees with Display for {text:?}");
+    assert!(h == text.as_str());
+    assert!(format!("{text}x").as_str() != h, "{text:?}x compares equal");
+    assert!(text[..text.len() - text.chars().last().unwrap().len_utf8()].to_string().as_str() != h);
+    assert_eq!(format!("{h:?}"), format!("HumanCount {{ val: {val:?}, unit: {unit:?} }} -> {text}"));
+    // (serde_json needs its `float_roundtrip` feature to read its own floats back exactly)
+    let json = serde_json::to_string(&h).unwrap();
+    let back: HumanCountData = serde_json::from_str(&json).unwrap();
+    assert!(back == h, "{json}");
+    assert_eq!(back.to_string(), text, "{json}");
+    // the convenience forms
+    if unit.is_empty() {
+        assert_eq!(val.human_count_bare().to_string(), text);
+    }
+    if unit == "B" {
+        assert_eq!(val.human_count_bytes().to_string(), text);
+    }
+    // integer inputs are their float value
+    if val.fract() == 0.0 && val.abs() < 1e15 {
+        assert_eq!((val as i64).human_count(unit).to_string(), text);
+        if val >= 0.0 {
+            assert_eq!((val as u64).human_count(unit).to_string(), text);
+        }
+    }
+}
+
+/// `-x` prints as `-` followed by the text of `x` (for values that do not round to zero —
+/// human-repr/3 is pinned separately).
+#[hegel::test]
+fn negative_counts_mirror_positive_ones(mut tc: TestCase) {
+    let unit = pick(&mut tc, &UNITS);
+    let mag = arb_mag(&mut tc, -3, 25);
+    let pos = mag.human_count(unit).to_string();
+    tc.assume(!pos.starts_with('0'));
+    assert_eq!((-mag).human_count(unit).to_string(), format!("-{pos}"));
+}
+
+// ---------------------------------------------------------------- durations
+
+/// The duration forms: `<num>ns|µs|ms|s`, `M:SS[.s]`, `H:MM:SS`. Returns the seconds read
+/// back and the half-unit tolerance of the form.
+fn parse_duration(text: &str) -> (f64, f64) {
+    if let Some((left, right)) = text.split_once(':') {
+        match right.split_once(':') {
+            None => {
+                // M:SS or M:SS.s
+                let m: f64 = left.parse().unwrap_or_else(|_| panic!("{text:?}: minutes"));
+                assert!(m >= 1.0 && m < 60.0 && m.fract() == 0.0, "{text:?}: minutes {m}");
+                assert!(right.len() == 2 || (right.len() == 4 && &right[2..3] == "."), "{text:?}");
+                let s: f64 = right.parse().unwrap_or_else(|_| panic!("{text:?}: seconds"));
+                assert!((0.0..60.0).contains(&s), "{text:?}: seconds {s}");
+                if right.len() == 4 {
+                    assert!(!right.ends_with('0'), "{text:?}: trailing zero decimal");
+                }
+                (60.0 * m + s, 0.05)
+            }
+            Some((mm, ss)) => {
+                let h: f64 = left.parse().unwrap_or_else(|_| panic!("{text:?}: hours"));
+                assert!(h >= 1.0 && h.fract() == 0.0, "{text:?}: hours {h}");
+                assert!(mm.len() == 2 && ss.len() == 2, "{text:?}");
+                let m: f64 = mm.parse().unwrap_or_else(|_| panic!("{text:?}: minutes"));
+                let s: f64 = ss.parse().unwrap_or_else(|_| panic!("{text:?}: seconds"));
+                assert!(m < 60.0 && s < 60.0, "{text:?}");
+                (3600.0 * h + 60.0 * m + s, 0.5)
+            }
+        }
+    } else {
+        // <num><scale>
+        let (num, mult, dec, lo, hi) = if let Some(num) = text.strip_suffix("ns") {
+            (num, 1e-9, 1, 0.0, 1000.0)
+        } else if let Some(num) = text.strip_suffix("µs") {
+            (num, 1e-6, 1, 1.0, 1000.0)
+        } else if let Some(num) = text.strip_suffix("ms") {
+            (num, 1e-3, 1, 1.0, 1000.0)
+        } else if let Some(num) = text.strip_suffix('s') {
+            (num, 1.0, 2, 1.0, 60.0)
+        } else {
+            panic!("{text:?}: unknown duration form");
+        };
+        let v = check_number(text, num, dec);
+        assert!(v.abs() < hi, "{text:?}: number reaches the next scale");
+        assert!(v.abs() >= lo || v == 0.0, "{text:?}: a smaller scale would do");
+        (v * mult, 0.5 * 10f64.powi(-(dec as i32)) * mult)
+    }
+}
+
+fn check_duration(text: &str, secs: f64) -> f64 {
+    let (read, tolerance) = parse_duration(text);
+    let tolerance = tolerance * (1.0 + 1e-9) + secs.abs() * 1e-12;
+    assert!(
+        (read - secs).abs() <= tolerance,
+        "{text:?} reads {read}, value {secs} (tolerance {tolerance})"
+    );
+    // the form matches the value shown: seconds below a minute, M:SS below an hour
+    let has_colon = text.matches(':').count();
+    let expected_colons = if read < 60.0 { 0 } else if read < 3600.0 { 1 } else { 2 };
+    assert_eq!(has_colon, expected_colons, "{text:?}: wrong form for {read} s");
+    read
+}
+
+/// Durations below an hour read back to half a unit of the last printed decimal; `Duration`
+/// inputs give the same text as their `f64` seconds. (The hours form is human-repr/2.)
+#[hegel::test]
+fn durations_read_back(mut tc: TestCase) {
+    let secs = if chance(&mut tc, 20) {
+        // whole and half seconds around the boundaries
+        n(&mut tc, 0, 7200) as f64 / 2.0
+    } else {
+        arb_mag(&mut tc, -10, 3)
+    };
+    tc.assume(secs < 3600.0);
+    let h = secs.human_duration();
+    let text = h.to_string();
+    let read = check_duration(&text, secs);
+    assert!(read >= 0.0 && !text.starts_with('-'), "{text:?}");
+    assert!(text.as_str() == h && h == text.as_str());
+    assert!(format!("{text}x").as_str() != h);
+    assert_eq!(format!("{h:?}"), format!("HumanDuration {{ val: {secs:?} }} -> {text}"));
+    let back: HumanDurationData = serde_json::from_str(&serde_json::to_string(&h).unwrap()).unwrap();
+    assert!(back == h);
+    assert_eq!(back.to_string(), text);
+    // std::time::Duration
+    let d = Duration::from_secs_f64(secs);
+    assert_eq!(d.human_duration().to_string(), d.as_secs_f64().human_duration().to_string());
+    let exact = d.as_secs() as f64 + d.subsec_nanos() as f64 * 1e-9;
+    check_duration(&d.human_duration().to_string(), exact);
+    if secs.fract() == 0.0 {
+        assert_eq!((secs as u32).human_duration().to_string(), text);
+    }
+}
+
+/// `H:MM:SS` is well-formed (minutes and seconds below 60) and within a second of the value.
+#[hegel::test]
+fn hours_form_is_well_formed(mut tc: TestCase) {
+    let secs = if chance(&mut tc, 50) {
+        3600.0 + n(&mut tc, 0, 200_000) as f64 / 10.0
+    } else {
+        arb_mag(&mut tc, 4, 9)
+    };
+    let text = secs.human_duration().to_string();
+    let (read, _) = parse_duration(&text);
+    assert!((read - secs).abs() < 1.0 + secs * 1e-12, "{text:?} reads {read} for {secs}");
+    assert_eq!(text.matches(':').count(), 2, "{text:?}");
+    assert_eq!(Duration::from_secs_f64(secs).human_duration().to_string(), text);
+}
+
+/// `H:MM:SS` shows the value rounded to the second, as the other forms round to their last
+/// digit: 1:00:00.9 is `1:00:01`. Expected failure: human-repr/2.
+#[hegel::test]
+fn hours_form_rounds_to_the_second(mut tc: TestCase) {
+    let secs = 3600.0 + n(&mut tc, 0, 20_000) as f64 + n(&mut tc, 0, 99) as f64 / 100.0;
+    let text = secs.human_duration().to_string();
+    let (read, _) = parse_duration(&text);
+    assert!(
+        (read - secs).abs() <= 0.5 + 1e-9,
+        "{text:?} reads {read} for {secs}: off by {}",
+        read - secs
+    );
+}
+
+/// `-x` prints as `-` followed by the text of `x`: `-1:01`, `-1:00:00`. Expected failure:
+/// human-repr/1.
+#[hegel::test]
+fn negative_durations_mirror_positive_ones(mut tc: TestCase) {
+    let secs = if chance(&mut tc, 50) {
+        60.0 + n(&mut tc, 0, 100_000) as f64 / 10.0
+    } else {
+        arb_mag(&mut tc, -10, 6)
+    };
+    let pos = secs.human_duration().to_string();
+    tc.assume(!pos.starts_with('0'));
+    assert_eq!((-secs).human_duration().to_string(), format!("-{pos}"));
+    assert_eq!((-secs).human_duration().to_string(), format!("-{pos}"));
+}
+
+// ---------------------------------------------------------------- throughputs
+
+/// `<num><unit>/d|/h|/min` or `<num><prefix><unit>/s`; returns the per-second value read back.
+fn check_throughput(text: &str, unit: &str, val: f64) -> f64 {
+    let (body, secs, dec, lo, hi, per_second) = if let Some(b) = text.strip_suffix("/d") {
+        (b, 86400.0, 2, 0.0, 24.0, false)
+    } else if let Some(b) = text.strip_suffix("/h") {
+        (b, 3600.0, 1, 1.0, 60.0, false)
+    } else if let Some(b) = text.strip_suffix("/min") {
+        (b, 60.0, 1, 1.0, 60.0, false)
+    } else if let Some(b) = text.strip_suffix("/s") {
+        (b, 1.0, 0, 1.0, 1000.0, true)
+    } else {
+        panic!("{text:?}: unknown throughput scale");
+    };
+    let body = body
+        .strip_suffix(unit)
+        .unwrap_or_else(|| panic!("{text:?} does not end with unit {unit:?}"));
+    let (num, k) = if per_second { split_prefix(text, body) } else { (body.to_string(), 0) };
+    assert!(per_second || k == 0);
+    let dec = if per_second { COUNT_DECIMALS[k] } else { dec };
+    let v = check_number(text, &num, dec);
+    assert!(v.abs() < hi, "{text:?}: number reaches the next scale");
+    assert!(v.abs() >= lo || v == 0.0, "{text:?}: a smaller scale would do");
+    let mult = 1000f64.powi(k as i32) / secs;
+    let read = v * mult;
+    let tolerance = 0.5 * 10f64.powi(-(dec as i32)) * mult * (1.0 + 1e-9) + val.abs() * 1e-12;
+    assert!(
+        (read - val).abs() <= tolerance,
+        "{text:?} reads {read}, value {val} (tolerance {tolerance})"
+    );
+    read
+}
+
+#[hegel::test]
+fn throughputs_read_back(mut tc: TestCase) {
+    let unit = pick(&mut tc, &UNITS);
+    let mag = arb_mag(&mut tc, -7, 25);
+    let val = if chance(&mut tc, 30) { -mag } else { mag };
+    let h = val.human_throughput(unit);
+    let text = h.to_string();
+    let read = check_throughput(&text, unit, val);
+    assert_eq!(text.starts_with('-'), read < 0.0, "{text:?}");
+    assert!(text.as_str() == h && h == text.as_str());
+    assert!(format!("{text}x").as_str() != h);
+    assert_eq!(
+        format!("{h:?}"),
+        format!("HumanThroughput {{ val: {val:?}, unit: {unit:?} }} -> {text}")
+    );
+    let back: HumanThroughputData =
+        serde_json::from_str(&serde_json::to_string(&h).unwrap()).unwrap();
+    assert!(back == h);
+    assert_eq!(back.to_string(), text);
+    if unit.is_empty() {
+        assert_eq!(val.human_throughput_bare().to_string(), text);
+    }
+    if unit == "B" {
+        assert_eq!(val.human_throughput_bytes().to_string(), text);
+    }
+    // a per-second rate is the count of the same value, per second (the crate reaches it
+    // through ×86400/24/60/60, so an exact decimal tie may round differently: compared to
+    // within the last decimal)
+    if text.ends_with("/s") {
+        let count = format!("{}/s", val.human_count(unit));
+        if count != text {
+            let a = check_throughput(&count, unit, val);
+            assert!((a - read).abs() <= (a.abs() + read.abs()) * 1e-3, "{text:?} vs {count:?}");
+        }
+    }
+}
+
+#[hegel::test]
+fn negative_throughputs_mirror_positive_ones(mut tc: TestCase) {
+    let unit = pick(&mut tc, &UNITS);
+    let mag = arb_mag(&mut tc, -7, 25);
+    let pos = mag.human_throughput(unit).to_string();
+    tc.assume(!pos.starts_with('0'));
+    assert_eq!((-mag).human_throughput(unit).to_string(), format!("-{pos}"));
+}
+
+// ---------------------------------------------------------------- pins
+
+/// A value that rounds to zero prints as the zero of the positive side, whatever its sign.
+/// Expected failure: human-repr/3.
+#[hegel::test]
+fn values_rounding_to_zero_have_no_sign(mut tc: TestCase) {
+    let tiny = n(&mut tc, 1, 49) as f64 / 1000.0; // 0.001 ..= 0.049 rounds to 0 at one decimal
+    match n(&mut tc, 0, 2) {
+        0 => assert_eq!((-tiny).human_count_bytes().to_string(), "0B"),
+        1 => assert_eq!((-tiny * 1e-9).human_duration().to_string(), "0ns"),
+        _ => assert_eq!((-tiny / 86400.0).human_throughput_bytes().to_string(), "0B/d"),
+    }
+}
+
+/// A non-finite duration is not a clock time: it prints the non-finite token (with or without
+/// a unit) and nothing else. Expected failure: human-repr/4.
+#[hegel::test]
+fn non_finite_durations_are_not_clock_times(mut tc: TestCase) {
+    let v = pick(&mut tc, &[f64::INFINITY, f64::NEG_INFINITY, f64::NAN, 1e300, -1e300]);
+    let text = v.human_duration().to_string();
+    let token = if v.is_nan() { "NaN" } else if v > 0.0 { "inf" } else { "-inf" };
+    assert!(
+        text.starts_with(token) && !text.contains(':') && !text[token.len()..].contains(|c: char| c.is_ascii_digit()),
+        "{v:?} -> {text:?}"
+    );
+}
+
+#[test]
+fn readme_examples() {
+    assert_eq!("43.21GB", 43214321123_u64.human_count_bytes());
+    assert_eq!("74.9M", 74893200.human_count_bare());
+    assert_eq!("540.5kPackets", 540464_u32.human_count("Packets"));
+    assert_eq!("48.1°C", 48.132323432.human_count("°C"));
+    assert_eq!("1.8ns", 0.0000000018.human_duration());
+    assert_eq!("19:20.4", 1160.36.human_duration());
+    assert_eq!("1:14:48", 4488u16.human_duration());
+    assert_eq!("1:14:48", Duration::new(4488, 395_000_000).human_duration());
+    assert_eq!("9/d", 0.000104166666667.human_throughput_bare());
+    assert_eq!("6.1tests/min", 0.101265.human_throughput("tests"));
+    assert_eq!("1ms", 0.000999999.human_duration());
+    assert_eq!("1:00", 59.995.human_duration());
+    // documented overflow form beyond yotta
+    assert_eq!("340282366920.94+B", u128::MAX.human_count_bytes());
+    // human-repr/1: negative durations from a minute up
+    assert_eq!("-1:-1", (-61).human_duration()); // -1:01
+    assert_eq!("-2:-5.8", (-125.825).human_duration()); // -2:05.8
+    assert_eq!("-61:-1", (-3661).human_duration()); // -1:01:01
+    assert_eq!("-1666:-40", (-100000).human_duration()); // -27:46:40
+    // human-repr/2: the hours form truncates the seconds
+    assert_eq!("1:00:00", 3600.9.human_duration()); // 1:00:01
+    assert_eq!("1:00:59", 3659.94.human_duration()); // 1:01:00
+    assert_eq!("1:01:00", 3659.95.human_duration());
+    // human-repr/3: signed zeros
+    assert_eq!("-0B", (-0.04).human_count_bytes());
+    assert_eq!("-0ns", (-0.0).human_duration());
+    assert_eq!("-0B/d", (-0.00000001).human_throughput_bytes());
+    // human-repr/4: infinite durations
+    assert_eq!("inf:NaN:NaN", f64::INFINITY.human_duration());
+    assert_eq!("-inf:0NaN", f64::NEG_INFINITY.human_duration());
+    assert_eq!("inf:NaN:NaN", 1e300.human_duration()); // × 1e9 overflows
+    assert_eq!("NaNns", f64::NAN.human_duration());
+    // accepted non-finite forms elsewhere
+    assert_eq!("NaNB", f64::NAN.human_count_bytes());
+    assert_eq!("inf+B", f64::INFINITY.human_count_bytes());
+    assert_eq!("NaNB/d", f64::NAN.human_throughput_bytes());
+}
