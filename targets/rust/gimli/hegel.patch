+// Property: corrupting (byte-flip) or truncating a validly-written DWARF unit
+// must degrade gracefully: the reader returns errors or different data, but
+// never panics and never iterates unboundedly.
+#[hegel::test]
+fn hegel_corrupted_written_dwarf_parses_gracefully(tc: hegel::TestCase) {
+    let encoding = draw_encoding(&tc);
+
+    // A small fixed line program, so that `.debug_line` corruption exercises
+    // the row-execution paths on near-valid input.
+    let mut program = write::LineProgram::new(
+        encoding,
+        gimli::LineEncoding::default(),
+        write::LineString::String(b"/comp/dir".to_vec()),
+        None,
+        write::LineString::String(b"primary.c".to_vec()),
+        None,
+    );
+    let dir_id = program.default_directory();
+    let file_id = program.add_file(write::LineString::String(b"f0.c".to_vec()), dir_id, None);
+    program.begin_sequence(Some(Address::Constant(0x1000)));
+    for i in 0..3u64 {
+        let row = program.row();
+        row.address_offset = i * 4;
+        row.file = file_id;
+        row.line = i + 1;
+        row.column = i;
+        program.generate_row();
+    }
+    program.end_sequence(12);
+
+    // A small fixed DIE tree with string/udata/sdata/address attributes.
+    let mut unit = write::Unit::new(encoding, program);
+    let root = unit.root();
+    unit.get_mut(root).set(
+        constants::DW_AT_name,
+        write::AttributeValue::String(b"unit".to_vec()),
+    );
+    let child = unit.add(root, constants::DW_TAG_subprogram);
+    let entry = unit.get_mut(child);
+    entry.set(
+        constants::DW_AT_name,
+        write::AttributeValue::String(b"a_function".to_vec()),
+    );
+    entry.set(constants::DW_AT_byte_size, write::AttributeValue::Udata(u64::MAX));
+    entry.set(
+        constants::DW_AT_low_pc,
+        write::AttributeValue::Address(Address::Constant(0x1234)),
+    );
+    let grandchild = unit.add(child, constants::DW_TAG_variable);
+    unit.get_mut(grandchild).set(
+        constants::DW_AT_const_value,
+        write::AttributeValue::Sdata(i64::MIN),
+    );
+
+    let mut dwarf_w = write::Dwarf::new();
+    dwarf_w.units.add(unit);
+    let mut sections = write::Sections::new(EndianVec::new(LittleEndian));
+    dwarf_w.write(&mut sections).expect("write should succeed");
+
+    let mut debug_info = sections.debug_info.slice().to_vec();
+    let mut debug_abbrev = sections.debug_abbrev.slice().to_vec();
+    let mut debug_line = sections.debug_line.slice().to_vec();
+
+    // Corrupt one of the three sections: flip a byte or truncate.
+    let which = tc.draw(generators::integers::<u8>().max_value(2));
+    let target: &mut Vec<u8> = match which {
+        0 => &mut debug_info,
+        1 => &mut debug_abbrev,
+        _ => &mut debug_line,
+    };
+    assert!(!target.is_empty());
+    if tc.draw(generators::booleans()) {
+        // Byte flip.
+        let index = tc.draw(generators::integers::<usize>().max_value(target.len() - 1));
+        let mask = tc.draw(generators::integers::<u8>().min_value(1));
+        target[index] ^= mask;
+    } else {
+        // Truncation.
+        let len = tc.draw(generators::integers::<usize>().max_value(target.len() - 1));
+        target.truncate(len);
+    }
+
+    let dwarf_r = read::Dwarf {
+        debug_info: read::DebugInfo::new(&debug_info, LittleEndian),
+        debug_abbrev: read::DebugAbbrev::new(&debug_abbrev, LittleEndian),
+        debug_line: read::DebugLine::new(&debug_line, LittleEndian),
+        ..Default::default()
+    };
+
+    // Walk everything reachable; errors are fine, panics and unbounded
+    // iteration are not. Every step consumes input, so the step count is
+    // bounded by the (tiny) section sizes.
+    let mut steps = 0usize;
+    let mut units = dwarf_r.units();
+    while let Ok(Some(header)) = units.next() {
+        steps += 1;
+        let Ok(runit) = dwarf_r.unit(header) else {
+            continue;
+        };
+        let runit = runit.unit_ref(&dwarf_r);
+        let mut entries = runit.entries();
+        while let Ok(Some(entry)) = entries.next_dfs() {
+            steps += 1;
+            for attr in entry.attrs() {
+                steps += 1;
+                let _ = attr.udata_value();
+                let _ = attr.sdata_value();
+                let _ = runit.attr_string(attr.value());
+                assert!(
+                    steps < 1_000_000,
+                    "iteration exceeded input-size bound on corrupted input"
+                );
+            }
+            assert!(steps < 1_000_000);
+        }
+        if let Some(read_program) = runit.line_program.clone() {
+            let mut rows = read_program.rows();
+            while let Ok(Some(_)) = rows.next_row() {
+                steps += 1;
+                assert!(
+                    steps < 1_000_000,
+                    "row iteration exceeded input-size bound on corrupted input"
+                );
+            }
+        }
+        assert!(steps < 1_000_000);
+    }
+}
