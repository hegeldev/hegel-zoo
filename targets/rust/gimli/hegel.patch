+/// Draw bytes for a `.debug_abbrev` section: either pure garbage, or a
+/// sequence of plausible abbreviation declarations (real attribute/form
+/// codes mixed with garbage codes).
+fn draw_debug_abbrev_bytes(tc: &hegel::TestCase) -> Vec<u8> {
+    use hegel::generators;
+
+    if tc.draw(generators::booleans()) {
+        return tc.draw(generators::binary().max_size(120));
+    }
+
+    // Real DWARF form codes, plus a couple of invalid ones.
+    let forms: Vec<u8> = vec![
+        0x01, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
+        0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x17, 0x18, 0x19, 0x20, 0x00, 0x7e,
+    ];
+    let tags: Vec<u8> = vec![0x11, 0x2e, 0x34, 0x24, 0x13, 0x0d, 0x0b, 0x39, 0x00, 0x7f];
+    let attrs: Vec<u8> = vec![0x03, 0x0b, 0x1c, 0x11, 0x12, 0x3e, 0x00, 0x7d];
+
+    let mut section = Vec::new();
+    let num_decls = tc.draw(generators::integers::<u8>().min_value(1).max_value(4));
+    for code in 1..=num_decls {
+        section.push(code); // abbreviation code (single-byte ULEB128)
+        section.push(tc.draw(generators::sampled_from(tags.clone())));
+        section.push(if tc.draw(generators::booleans()) { 1 } else { 0 }); // has_children
+        let num_specs = tc.draw(generators::integers::<u8>().max_value(4));
+        for _ in 0..num_specs {
+            section.push(tc.draw(generators::sampled_from(attrs.clone())));
+            section.push(tc.draw(generators::sampled_from(forms.clone())));
+        }
+        section.push(0); // attribute list terminator
+        section.push(0);
+    }
+    if tc.draw(generators::booleans()) {
+        section.push(0); // abbreviation list terminator
+    }
+    section
+}
