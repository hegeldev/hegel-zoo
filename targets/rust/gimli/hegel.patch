+    /// Property-based tests (hegel) for the LEB128 encoder/decoder pair.
+    mod hegel_props {
+        use super::super::CONTINUATION_BIT;
+        use super::{read, write};
+        use crate::endianity::NativeEndian;
+        use crate::read::{EndianSlice, Reader};
