+// Property: a generated line program written via `gimli::write` reads back
+// with the read API to exactly the same row sequence: same addresses, lines,
+// columns, flags, and file names, across encodings and line encodings.
+#[hegel::test]
+fn hegel_write_read_line_program_rows_roundtrip(tc: hegel::TestCase) {
+    let encoding = draw_encoding(&tc);
+    let minimum_instruction_length: u8 =
+        tc.draw(generators::sampled_from(vec![1u8, 2, 4]));
+    let line_base: i8 = tc.draw(generators::integers::<i8>().min_value(-5).max_value(0));
+    let line_range: u8 = tc.draw(
+        generators::integers::<u8>()
+            .min_value((1 - i16::from(line_base)) as u8)
+            .max_value(20),
+    );
+    let line_encoding = gimli::LineEncoding {
+        minimum_instruction_length,
+        // VLIW op-index encoding is not exercised here; keep one op per
+        // instruction so that write-side and read-side address arithmetic
+        // agree without op_index bookkeeping.
+        maximum_operations_per_instruction: 1,
+        default_is_stmt: tc.draw(generators::booleans()),
+        line_base,
+        line_range,
+    };
+
+    let mut program = write::LineProgram::new(
+        encoding,
+        line_encoding,
+        write::LineString::String(b"/comp/dir".to_vec()),
+        None,
+        write::LineString::String(b"primary.c".to_vec()),
+        None,
+    );
+    let dir_id = program.default_directory();
+    let file_names: Vec<Vec<u8>> = vec![b"f0.c".to_vec(), b"f1.c".to_vec(), b"f2.c".to_vec()];
+    let num_files = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+    let file_ids: Vec<_> = file_names[..num_files]
+        .iter()
+        .map(|name| program.add_file(write::LineString::String(name.clone()), dir_id, None))
+        .collect();
+
+    // Keep the base address small enough that no advance can overflow the
+    // unit's address size (protects the test's arithmetic; overflow behavior
+    // is not part of the roundtrip contract under test).
+    let base_address =
+        mask_address(tc.draw(generators::integers::<u64>()), encoding.address_size) >> 8;
+
+    let num_rows = tc.draw(generators::integers::<usize>().min_value(1).max_value(12));
+    program.begin_sequence(Some(Address::Constant(base_address)));
+    let mut expected_rows = Vec::new();
+    let mut address_offset = 0u64;
+    for _ in 0..num_rows {
+        let advance_units = tc.draw(generators::integers::<u64>().max_value(0xFFFF));
+        address_offset += advance_units * u64::from(minimum_instruction_length);
+        let file_index = tc.draw(generators::integers::<usize>().max_value(num_files - 1));
+        // The writer encodes line deltas as i64, so u64-wide line jumps are
+        // outside its domain; 32 bits still exceeds any real source file.
+        let line = tc.draw(generators::integers::<u64>().max_value(u64::from(u32::MAX)));
+        let column = tc.draw(generators::integers::<u64>());
+        let is_stmt = tc.draw(generators::booleans());
+        let basic_block = tc.draw(generators::booleans());
+        let prologue_end = tc.draw(generators::booleans());
+        let epilogue_begin = tc.draw(generators::booleans());
+        // DW_LNE_set_discriminator only exists in DWARF 4+.
+        let discriminator = if encoding.version >= 4 {
+            tc.draw(generators::integers::<u64>())
+        } else {
+            0
+        };
+
+        let row = program.row();
+        row.address_offset = address_offset;
+        row.file = file_ids[file_index];
+        row.line = line;
+        row.column = column;
+        row.is_statement = is_stmt;
+        row.basic_block = basic_block;
+        row.prologue_end = prologue_end;
+        row.epilogue_begin = epilogue_begin;
+        row.discriminator = discriminator;
+        program.generate_row();
+
+        expected_rows.push(ExpectedRow {
+            address: base_address + address_offset,
+            line,
+            column,
+            is_stmt,
+            basic_block,
+            prologue_end,
+            epilogue_begin,
+            discriminator,
+            file_name: file_names[file_index].clone(),
+        });
+    }
+    let end_offset = address_offset + u64::from(minimum_instruction_length);
+    program.end_sequence(end_offset);
+
+    let mut unit = write::Unit::new(encoding, program);
+    // DW_AT_stmt_list is set automatically when the unit has a line program.
+    let root = unit.root();
+    unit.get_mut(root).set(
+        constants::DW_AT_name,
+        write::AttributeValue::String(b"primary.c".to_vec()),
+    );
+
+    let mut dwarf_w = write::Dwarf::new();
+    dwarf_w.units.add(unit);
+    let mut sections = write::Sections::new(EndianVec::new(LittleEndian));
+    dwarf_w.write(&mut sections).expect("write should succeed");
+
+    let dwarf_r = read_written_sections(&sections);
+    let header = dwarf_r
+        .units()
+        .next()
+        .expect("should parse unit header")
+        .expect("should have one unit");
+    let runit = dwarf_r.unit(header).expect("should parse unit");
+    let read_program = runit
+        .line_program
+        .clone()
+        .expect("unit should have a line program");
+    let mut rows = read_program.rows();
+
+    for exp in &expected_rows {
+        let (header, row) = rows
+            .next_row()
+            .expect("should parse row")
+            .expect("should have as many rows as were written");
+        assert!(!row.end_sequence(), "row must not be an end-sequence row");
+        assert_eq!(row.address(), exp.address, "address must roundtrip");
+        assert_eq!(
+            row.line().map(|l| l.get()).unwrap_or(0),
+            exp.line,
+            "line must roundtrip"
+        );
+        let column = match row.column() {
+            gimli::ColumnType::LeftEdge => 0,
+            gimli::ColumnType::Column(c) => c.get(),
+        };
+        assert_eq!(column, exp.column, "column must roundtrip");
+        assert_eq!(row.is_stmt(), exp.is_stmt, "is_stmt must roundtrip");
+        assert_eq!(
+            row.basic_block(),
+            exp.basic_block,
+            "basic_block must roundtrip"
+        );
+        assert_eq!(
+            row.prologue_end(),
+            exp.prologue_end,
+            "prologue_end must roundtrip"
+        );
+        assert_eq!(
+            row.epilogue_begin(),
+            exp.epilogue_begin,
+            "epilogue_begin must roundtrip"
+        );
+        assert_eq!(
+            row.discriminator(),
+            exp.discriminator,
+            "discriminator must roundtrip"
+        );
+        let file = row.file(header).expect("row file index should be valid");
+        match file.path_name() {
+            gimli::AttributeValue::String(name) => {
+                assert_eq!(
+                    name.slice(),
+                    &exp.file_name[..],
+                    "file name must roundtrip"
+                );
+            }
+            other => panic!("expected string file path, got {:?}", other),
+        }
+    }
+
+    let (_, end_row) = rows
+        .next_row()
+        .expect("should parse end-sequence row")
+        .expect("should have an end-sequence row");
+    assert!(end_row.end_sequence(), "final row must be end-sequence");
+    assert_eq!(
+        end_row.address(),
+        base_address + end_offset,
+        "end-sequence address must roundtrip"
+    );
+    assert!(
+        rows.next_row().expect("should parse end of rows").is_none(),
+        "read back exactly as many rows as were written"
+    );
+}
