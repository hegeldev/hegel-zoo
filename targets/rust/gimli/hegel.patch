+/// Draw bytes for a `.debug_line` section: either pure garbage, or a
+/// plausible DWARF 2-4 line program header followed by garbage opcodes.
+fn draw_debug_line_bytes(tc: &hegel::TestCase, big_endian: bool) -> Vec<u8> {
