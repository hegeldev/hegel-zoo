+// ---------------------------------------------------------------------------
+// Property-based tests (hegel): write -> read roundtrips for generated DWARF.
+//
+// The existing tests above roundtrip one fixed fixture; these generate the
+// DWARF content (DIE trees, attribute values, encodings, line programs) so
+// that the roundtrip is exercised across Dwarf32/Dwarf64, versions 2-5, and
+// address sizes 4/8, with boundary attribute values.
+// ---------------------------------------------------------------------------
+
+use gimli::constants;
+use gimli::{Encoding, Format};
+use hegel::generators;
+use hegel::Generator;
+
+fn draw_encoding(tc: &hegel::TestCase) -> Encoding {
+    Encoding {
+        format: if tc.draw(generators::booleans()) {
+            Format::Dwarf64
+        } else {
+            Format::Dwarf32
+        },
+        version: tc.draw(generators::integers::<u16>().min_value(2).max_value(5)),
+        address_size: if tc.draw(generators::booleans()) { 8 } else { 4 },
+    }
+}
+
+/// Mask an address value so that it fits in the unit's address size.
+/// This protects the writer's contract (an `Address::Constant` must fit in
+/// `address_size` bytes), not the test's resources.
+fn mask_address(addr: u64, address_size: u8) -> u64 {
+    if address_size >= 8 {
+        addr
+    } else {
+        addr & ((1 << (u64::from(address_size) * 8)) - 1)
+    }
+}
+
+#[derive(Debug, Clone)]
+struct ExpectedDie {
+    depth: usize,
+    tag: constants::DwTag,
+    name: Vec<u8>,
+    byte_size: u64,
+    const_value: i64,
+    low_pc: u64,
+}
+
+fn draw_die_attrs(
+    tc: &hegel::TestCase,
+    encoding: Encoding,
+    entry: &mut write::DebuggingInformationEntry,
+    depth: usize,
+    tag: constants::DwTag,
+) -> ExpectedDie {
+    // DW_FORM_string is a NUL-terminated C string, so interior NUL bytes are
+    // outside the writer's domain; replace them rather than reject.
+    let mut name: Vec<u8> = tc.draw(hegel::generators::binary().max_size(20));
+    for b in &mut name {
+        if *b == 0 {
+            *b = 1;
+        }
+    }
+    let byte_size = tc.draw(generators::integers::<u64>());
+    let const_value = tc.draw(generators::integers::<i64>());
+    let low_pc = mask_address(tc.draw(generators::integers::<u64>()), encoding.address_size);
+
+    entry.set(
+        constants::DW_AT_name,
+        write::AttributeValue::String(name.clone()),
+    );
+    entry.set(
+        constants::DW_AT_byte_size,
+        write::AttributeValue::Udata(byte_size),
+    );
+    entry.set(
+        constants::DW_AT_const_value,
+        write::AttributeValue::Sdata(const_value),
+    );
+    entry.set(
+        constants::DW_AT_low_pc,
+        write::AttributeValue::Address(Address::Constant(low_pc)),
+    );
+
+    ExpectedDie {
+        depth,
+        tag,
+        name,
+        byte_size,
+        const_value,
+        low_pc,
+    }
+}
+
+/// Build a `read::Dwarf` over the written section bytes.
+fn read_written_sections(
+    sections: &write::Sections<EndianVec<LittleEndian>>,
+) -> read::Dwarf<gimli::EndianSlice<'_, LittleEndian>> {
+    read::Dwarf {
+        debug_info: read::DebugInfo::new(sections.debug_info.slice(), LittleEndian),
+        debug_abbrev: read::DebugAbbrev::new(sections.debug_abbrev.slice(), LittleEndian),
+        debug_str: read::DebugStr::new(sections.debug_str.slice(), LittleEndian),
+        debug_line: read::DebugLine::new(sections.debug_line.slice(), LittleEndian),
+        debug_line_str: read::DebugLineStr::new(sections.debug_line_str.slice(), LittleEndian),
+        ..Default::default()
+    }
+}
+
+// Property: a generated DIE tree written via `gimli::write` reads back with
+// the read API to exactly the same tree: same unit encoding, same DFS order
+// of tags and depths, and the same attribute values (string, udata, sdata,
+// and address forms) on every DIE.
+#[hegel::test]
+fn hegel_write_read_die_tree_roundtrip(tc: hegel::TestCase) {
+    let encoding = draw_encoding(&tc);
+    let tags = vec![
+        constants::DW_TAG_subprogram,
+        constants::DW_TAG_variable,
+        constants::DW_TAG_base_type,
+        constants::DW_TAG_structure_type,
+        constants::DW_TAG_member,
+        constants::DW_TAG_lexical_block,
+        constants::DW_TAG_namespace,
+    ];
+
+    let mut unit = write::Unit::new(encoding, write::LineProgram::none());
+
+    // The expected tree, recorded as (parent index, die) so that we can
+    // flatten it to DFS preorder below.
+    let mut nodes: Vec<(Option<usize>, ExpectedDie)> = Vec::new();
+
+    let root = unit.root();
+    nodes.push((
+        None,
+        draw_die_attrs(
+            &tc,
+            encoding,
+            unit.get_mut(root),
+            0,
+            constants::DW_TAG_compile_unit,
+        ),
+    ));
+
+    // Build a random tree with a stack discipline: children are only ever
+    // added at the top of the stack.
+    let num_dies = tc.draw(generators::integers::<usize>().max_value(25));
+    let mut stack = vec![(root, 0usize)];
+    for _ in 0..num_dies {
+        let tag = tc.draw((generators::sampled_from(tags.clone())).print_as_debug());
+        let (parent, parent_index) = *stack.last().unwrap();
+        let id = unit.add(parent, tag);
+        let node_index = nodes.len();
+        nodes.push((
+            Some(parent_index),
+            draw_die_attrs(&tc, encoding, unit.get_mut(id), stack.len(), tag),
+        ));
+        if tc.draw(generators::booleans()) {
+            stack.push((id, node_index));
+        } else {
+            let pops = tc.draw(generators::integers::<usize>().max_value(stack.len() - 1));
+            stack.truncate(stack.len() - pops);
+        }
+    }
+
+    // Compute each node's children (in insertion order, which the writer
+    // preserves) and flatten to the DFS preorder the reader will produce.
+    // One documented exception: `write::Unit` reorders the *root's* direct
+    // children so that DW_TAG_base_type entries come first (see
+    // `reorder_base_types` in src/write/unit.rs); model that here.
+    let mut children: Vec<Vec<usize>> = vec![Vec::new(); nodes.len()];
+    for (index, (parent, _)) in nodes.iter().enumerate() {
+        if let Some(parent) = *parent {
+            children[parent].push(index);
+        }
+    }
+    let (base_types, others): (Vec<usize>, Vec<usize>) = children[0]
+        .iter()
+        .partition(|&&child| nodes[child].1.tag == constants::DW_TAG_base_type);
+    children[0] = base_types.into_iter().chain(others).collect();
+
+    let mut expected: Vec<ExpectedDie> = Vec::new();
+    let mut to_visit = vec![0usize];
+    while let Some(index) = to_visit.pop() {
+        expected.push(nodes[index].1.clone());
+        // Push children in reverse so they pop in order.
+        to_visit.extend(children[index].iter().rev());
+    }
+
+    let mut dwarf_w = write::Dwarf::new();
+    dwarf_w.units.add(unit);
+    let mut sections = write::Sections::new(EndianVec::new(LittleEndian));
+    dwarf_w.write(&mut sections).expect("write should succeed");
+
+    let dwarf_r = read_written_sections(&sections);
+    let mut units_iter = dwarf_r.units();
+    let header = units_iter
+        .next()
+        .expect("should parse written unit header")
+        .expect("should have one unit");
+    assert_eq!(header.version(), encoding.version);
+    assert_eq!(header.address_size(), encoding.address_size);
+    assert_eq!(header.format(), encoding.format);
+    assert!(
+        units_iter.next().expect("should parse end of units").is_none(),
+        "wrote exactly one unit"
+    );
+
+    let runit = dwarf_r.unit(header).expect("should parse unit");
+    let runit = runit.unit_ref(&dwarf_r);
+    let mut entries = runit.entries();
+    for exp in &expected {
+        let entry = entries
+            .next_dfs()
+            .expect("should parse next DIE")
+            .expect("should have as many DIEs as were written")
+            .clone();
+        assert_eq!(
+            entries.depth(),
+            exp.depth as isize,
+            "DIE depth must roundtrip"
+        );
+        let entry = &entry;
+        assert_eq!(entry.tag(), exp.tag, "DIE tag must roundtrip");
+
+        let name = entry
+            .attr_value(constants::DW_AT_name)
+            .expect("DW_AT_name should be present");
+        let name = runit.attr_string(name).expect("should read string value");
+        assert_eq!(name.slice(), &exp.name[..], "DW_AT_name must roundtrip");
+
+        let byte_size = entry
+            .attr_value(constants::DW_AT_byte_size)
+            .expect("DW_AT_byte_size should be present");
+        assert_eq!(
+            byte_size.udata_value(),
+            Some(exp.byte_size),
+            "DW_AT_byte_size must roundtrip"
+        );
+
+        let const_value = entry
+            .attr_value(constants::DW_AT_const_value)
+            .expect("DW_AT_const_value should be present");
+        assert_eq!(
+            const_value.sdata_value(),
+            Some(exp.const_value),
+            "DW_AT_const_value must roundtrip"
+        );
+
+        let low_pc = entry
+            .attr_value(constants::DW_AT_low_pc)
+            .expect("DW_AT_low_pc should be present");
+        match low_pc {
+            gimli::AttributeValue::Addr(addr) => {
+                assert_eq!(addr, exp.low_pc, "DW_AT_low_pc must roundtrip");
+            }
+            other => panic!("expected address form for DW_AT_low_pc, got {:?}", other),
+        }
+    }
+    assert!(
+        entries.next_dfs().expect("should parse DIE").is_none(),
+        "read back exactly as many DIEs as were written"
+    );
+}
+
+#[derive(Debug, Clone)]
+struct ExpectedRow {
+    address: u64,
+    line: u64,
+    column: u64,
+    is_stmt: bool,
+    basic_block: bool,
+    prologue_end: bool,
+    epilogue_begin: bool,
+    discriminator: u64,
+    file_name: Vec<u8>,
+}
