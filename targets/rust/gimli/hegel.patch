+        // Property: the canonical unsigned encoding roundtrips through the reader,
+        // consumes exactly its own bytes (trailing garbage untouched), and its
+        // length agrees with `uleb128_size`.
+        #[hegel::test]
+        fn hegel_unsigned_roundtrip(tc: hegel::TestCase) {
+            let val = tc.draw(generators::integers::<u64>());
+            let encoded = write::Leb128::unsigned(val);
+            assert_eq!(encoded.len(), write::uleb128_size(val));
+            let mut buf = encoded.bytes().to_vec();
+            // Trailing garbage after the terminating byte must not be consumed.
+            buf.extend_from_slice(&[0xAA, 0x55]);
+            let mut readable = EndianSlice::new(&buf, NativeEndian);
+            let result =
+                read::unsigned(&mut readable).expect("canonical encoding must read back");
+            assert_eq!(val, result);
+            assert_eq!(
+                readable.len(),
+                2,
+                "reader must consume exactly the encoded bytes"
+            );
+        }
+
+        // Property: the canonical signed encoding roundtrips through the reader,
+        // consumes exactly its own bytes, and its length agrees with `sleb128_size`.
+        #[hegel::test]
+        fn hegel_signed_roundtrip(tc: hegel::TestCase) {
+            let val = tc.draw(generators::integers::<i64>());
+            let encoded = write::Leb128::signed(val);
+            assert_eq!(encoded.len(), write::sleb128_size(val));
+            let mut buf = encoded.bytes().to_vec();
+            buf.extend_from_slice(&[0xAA, 0x55]);
+            let mut readable = EndianSlice::new(&buf, NativeEndian);
+            let result = read::signed(&mut readable).expect("canonical encoding must read back");
+            assert_eq!(val, result);
+            assert_eq!(
+                readable.len(),
+                2,
+                "reader must consume exactly the encoded bytes"
+            );
+        }
+
+        /// Pad a canonical LEB128 encoding with `pad` redundant bytes.
+        /// `fill` is the redundant continuation byte (0x80 for unsigned and
+        /// non-negative signed values, 0xFF for negative signed values), and
+        /// `last` is the redundant terminating byte (0x00 or 0x7F).
+        fn pad_encoding(canonical: &[u8], pad: usize, fill: u8, last: u8) -> Vec<u8> {
+            let mut buf = canonical.to_vec();
+            if pad > 0 {
+                *buf.last_mut().unwrap() |= CONTINUATION_BIT;
+                for _ in 1..pad {
+                    buf.push(fill);
+                }
+                buf.push(last);
+            }
+            buf
+        }
+
+        // Property: non-canonical (redundantly padded) LEB128 encodings up to the
+        // reader's 10-byte limit decode to the same value. The DWARF spec (7.6)
+        // permits redundant encodings, e.g. 0x80 0x00 for zero.
+        #[hegel::test]
+        fn hegel_padded_encoding_reads_same_value(tc: hegel::TestCase) {
+            let uval = tc.draw(generators::integers::<u64>());
+            let canonical = write::Leb128::unsigned(uval);
+            let pad = tc.draw(generators::integers::<usize>().max_value(10 - canonical.len()));
+            let buf = pad_encoding(canonical.bytes(), pad, CONTINUATION_BIT, 0x00);
+            let mut readable = EndianSlice::new(&buf, NativeEndian);
+            assert_eq!(read::unsigned(&mut readable), Ok(uval));
+
+            let ival = tc.draw(generators::integers::<i64>());
+            let canonical = write::Leb128::signed(ival);
+            let pad = tc.draw(generators::integers::<usize>().max_value(10 - canonical.len()));
+            let (fill, last) = if ival < 0 {
+                (0x7F | CONTINUATION_BIT, 0x7F)
+            } else {
+                (CONTINUATION_BIT, 0x00)
+            };
+            let buf = pad_encoding(canonical.bytes(), pad, fill, last);
+            let mut readable = EndianSlice::new(&buf, NativeEndian);
+            assert_eq!(read::signed(&mut readable), Ok(ival));
+        }
+
+        // Property: any strict prefix of a canonical encoding fails cleanly with
+        // an error (all non-final bytes carry the continuation bit, so a
+        // truncated value must hit unexpected-EOF, never return a value).
+        #[hegel::test]
+        fn hegel_truncated_encoding_errors(tc: hegel::TestCase) {
+            let uval = tc.draw(generators::integers::<u64>());
+            let encoded = write::Leb128::unsigned(uval);
+            let keep = tc.draw(generators::integers::<usize>().max_value(encoded.len() - 1));
+            let mut readable = EndianSlice::new(&encoded.bytes()[..keep], NativeEndian);
+            assert!(read::unsigned(&mut readable).is_err());
+
+            let ival = tc.draw(generators::integers::<i64>());
+            let encoded = write::Leb128::signed(ival);
+            let keep = tc.draw(generators::integers::<usize>().max_value(encoded.len() - 1));
+            let mut readable = EndianSlice::new(&encoded.bytes()[..keep], NativeEndian);
+            assert!(read::signed(&mut readable).is_err());
+        }
+
+        // Property: on arbitrary bytes the decoders never panic and never
+        // over-read: a u64 value occupies at most 10 bytes, a u16 at most 3.
+        // A decoder that kept consuming continuation bytes without bound would
+        // violate this (attacker-controlled ULEB128 fields must not over-read).
+        #[hegel::test]
+        fn hegel_arbitrary_bytes_bounded_consumption(tc: hegel::TestCase) {
+            let buf: Vec<u8> = tc.draw(generators::binary().max_size(64));
+
+            let mut readable = EndianSlice::new(&buf, NativeEndian);
+            let _ = read::unsigned(&mut readable);
+            assert!(buf.len() - readable.len() <= 10);
+
+            let mut readable = EndianSlice::new(&buf, NativeEndian);
+            let _ = read::signed(&mut readable);
+            assert!(buf.len() - readable.len() <= 10);
+
+            let mut readable = EndianSlice::new(&buf, NativeEndian);
+            let _ = read::u16(&mut readable);
+            assert!(buf.len() - readable.len() <= 3);
+        }
+    }
