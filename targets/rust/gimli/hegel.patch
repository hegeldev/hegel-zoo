+        header.push(tc.draw(generators::sampled_from(vec![1u8, 3, 0]))); // max_ops
+    }
+    header.push(if tc.draw(generators::booleans()) { 1 } else { 0 }); // default_is_stmt
+    header.push(tc.draw(generators::integers::<u8>()) as u8); // line_base (i8)
+    header.push(tc.draw(generators::integers::<u8>())); // line_range
