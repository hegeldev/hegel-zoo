+// ===========================================================================
+// KNOWN FAILURE — pins a real, oracle-independent bug found by the hegel
+// property `hegel_arbitrary_debug_line_never_panics_or_overruns`.
+//
+// `gimli`'s documented contract (CONTRIBUTING.md) is that it never panics on
+// malformed input — parse failures must be returned as `Err`. But executing a
+// line-number program whose address size is outside 1..=8 bytes panics with
+// "attempt to shift right with overflow".
+//
+// Code path:
+//   read::DebugLine::program(offset, address_size, ..)  // address_size = 0
+//     -> LineRows::next_row -> LineRow::exec_special_opcode
+//       -> LineRow::apply_operation_advance
+//         -> u64::add_sized(length, size)          (src/read/reader.rs)
+//           -> u64::ones_sized(size)               (src/read/reader.rs:256)
+//              !0u64 >> (64 - size * 8)   // size == 0  =>  !0 >> 64  =>  PANIC
+//
+// `address_size` is attacker-controlled: callers pass it directly (as here),
+// and for DWARF version >= 5 it is read straight out of the line-program
+// header bytes, so crafted `.debug_line` data can reach the panic with no
+// caller cooperation. For `size >= 9` the `size * 8` multiply itself overflows
+// `u8` and panics for the same reason. The fuzz target `debug_line.rs` never
+// found this because it hardcodes `address_size = 8`.
+//
+// Marked `#[ignore]` so the committed suite stays green; run with
+// `cargo test --test parse_self -- --ignored known_bug` to reproduce. It is a
+// catchable panic (not a process abort), so removing `#[ignore]` would fail
+// only this test, but we keep the whole suite green per the task's pinning
+// convention and document the bug here and in HEGEL_REPORT.md.
+// ===========================================================================
+#[test]
+fn known_bug_debug_line_address_size_zero_panics() {
+    use gimli::{DebugLine, DebugLineOffset, LittleEndian};
+
+    // A minimal, well-formed DWARF v2 `.debug_line` program: a header with no
+    // directories, no files, and opcode_base = 1, followed by a single special
+    // opcode that advances the address (which is what forces the masked add).
+    let mut header = Vec::new();
+    header.push(1u8); // minimum_instruction_length
+    header.push(1u8); // default_is_stmt
+    header.push(0u8); // line_base = 0
+    header.push(1u8); // line_range = 1
+    header.push(1u8); // opcode_base = 1 (no standard opcode length entries)
+    header.push(0u8); // include_directories terminator
+    header.push(0u8); // file_names terminator
+
+    let mut rest = Vec::new();
+    rest.extend_from_slice(&2u16.to_le_bytes()); // version 2
