+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+//
+// CSRs are submitted by untrusted enrollment clients. Supplements
+// fuzz/fuzz_targets/certreq.rs.
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use hegel::generators;
+    use x509_parser::prelude::*;
+
+    /// DER seed CSRs (the PEM fixtures are decoded first).
+    fn seed_csrs() -> Vec<Vec<u8>> {
+        let mut seeds = vec![super::CSR_DATA_EMPTY_ATTRIB.to_vec()];
+        for pem_data in [
+            super::CSR_DATA,
+            super::CSR_CHALLENGE_PASSWORD,
+            super::CSR_CUSTOM_EXTENSION,
+        ] {
+            let der = pem::parse_x509_pem(pem_data).expect("seed PEM must parse").1;
+            seeds.push(der.contents);
+        }
+        seeds
+    }
+
+    /// Property: CSR parsing of arbitrary bytes, and of real CSRs with a few
+    /// corrupted bytes, never panics. On success, the attribute and
+    /// requested-extensions accessors must not panic either.
+    #[hegel::test]
+    fn prop_csr_arbitrary_and_corrupted_never_panic(tc: hegel::TestCase) {
+        // arbitrary bytes (also with a DER SEQUENCE magic prefix)
+        let bytes: Vec<u8> = tc.draw(generators::binary().max_size(1024));
+        drop(X509CertificationRequest::from_der(&bytes));
+        let mut prefixed = vec![0x30, 0x82];
+        prefixed.extend_from_slice(&bytes);
+        drop(X509CertificationRequest::from_der(&prefixed));
+
+        // valid-then-corrupt
+        let seeds = seed_csrs();
+        let idx = tc.draw(generators::integers::<usize>().max_value(seeds.len() - 1));
+        let mut data = seeds[idx].clone();
+        // 0 => unmutated seed: guarantees the accepted-input branch below is
+        // exercised; small counts are biased so "corrupted but still accepted"
+        // inputs (e.g. a flipped signature byte) occur often
+        let n_mut = tc.draw(hegel::one_of!(
+            generators::integers::<usize>().max_value(2),
+            generators::integers::<usize>().max_value(8),
+        ));
+        for _ in 0..n_mut {
+            let pos = tc.draw(generators::integers::<usize>().max_value(data.len() - 1));
+            data[pos] = tc.draw(generators::integers::<u8>());
+        }
+        if let Ok((_rem, csr)) = X509CertificationRequest::from_der(&data) {
+            let cri = &csr.certification_request_info;
+            for attr in cri.attributes() {
+                let _ = attr.parsed_attributes();
+            }
+            let _ = csr.requested_extensions().count();
+        }
+    }
+
+    /// Property (truncation): every strict prefix of a valid CSR returns Err,
+    /// never panics.
+    #[hegel::test]
+    fn prop_csr_strict_prefix_errs(tc: hegel::TestCase) {
+        let seeds = seed_csrs();
+        let idx = tc.draw(generators::integers::<usize>().max_value(seeds.len() - 1));
+        let seed = &seeds[idx];
+        let cut = tc.draw(generators::integers::<usize>().max_value(seed.len() - 1));
+        assert!(
+            X509CertificationRequest::from_der(&seed[..cut]).is_err(),
+            "prefix of len {} unexpectedly parsed",
+            cut
+        );
+    }
+}
