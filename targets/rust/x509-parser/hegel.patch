index eb97ff2..918d33b 100644
--- a/tests/pem.rs
+++ b/tests/pem.rs
@@ -47,3 +47,68 @@ fn test_pem_no_end() {
     let res = Pem::read(reader);
     assert!(res.is_err());
 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+//
+// PEM is the usual on-disk container for certificates and is read from
+// untrusted files; parsing must never panic and the buffer iterator must
+// always terminate.
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use hegel::generators;
+    use x509_parser::pem::{parse_x509_pem, Pem};
+
+    /// Property: PEM parsing of arbitrary bytes — raw, and wrapped in
+    /// BEGIN/END markers around arbitrary body bytes (so the base64 decoder
+    /// and the inner DER parser are reached) — never panics, and
+    /// `Pem::iter_from_buffer` always terminates.
+    #[hegel::test]
+    fn prop_pem_arbitrary_input_never_panics(tc: hegel::TestCase) {
+        // raw arbitrary bytes
+        let bytes: Vec<u8> = tc.draw(generators::binary().max_size(1024));
+        drop(parse_x509_pem(&bytes));
+
+        // arbitrary body between PEM markers
+        let label: String = tc.draw(generators::from_regex(r"[A-Z ]{0,20}").fullmatch(true));
+        let body: Vec<u8> = tc.draw(generators::binary().max_size(256));
+        let mut pem_like = Vec::new();
+        pem_like.extend_from_slice(format!("-----BEGIN {}-----\n", label).as_bytes());
+        pem_like.extend_from_slice(&body);
+        pem_like.extend_from_slice(format!("\n-----END {}-----\n", label).as_bytes());
+        if let Ok((_rem, pem)) = parse_x509_pem(&pem_like) {
+            // decoded contents reach the X.509 parser without panicking
+            drop(pem.parse_x509());
+        }
+
+        // the iterator over a bounded buffer must terminate (cap converts a
+        // potential infinite loop into a test failure)
+        let mut count = 0usize;
+        for _entry in Pem::iter_from_buffer(&pem_like) {
+            count += 1;
+            assert!(count <= 10_000, "Pem::iter_from_buffer did not terminate");
+        }
+    }
+
+    /// Property (valid-then-corrupt): a real PEM certificate with a few
+    /// mutated bytes parses to Ok or Err, never panics — including the inner
+    /// DER parse of the (possibly corrupted) base64 payload.
+    #[hegel::test]
+    fn prop_pem_corrupted_seed_never_panics(tc: hegel::TestCase) {
+        let mut data = super::IGCA_PEM.to_vec();
+        // 0 => unmutated seed: guarantees the accepted-input branch below is
+        // exercised; small counts are biased so "corrupted but still accepted"
+        // inputs (e.g. a flipped signature byte) occur often
+        let n_mut = tc.draw(hegel::one_of!(
+            generators::integers::<usize>().max_value(2),
+            generators::integers::<usize>().max_value(8),
+        ));
+        for _ in 0..n_mut {
+            let idx = tc.draw(generators::integers::<usize>().max_value(data.len() - 1));
+            data[idx] = tc.draw(generators::integers::<u8>());
+        }
+        if let Ok((_rem, pem)) = parse_x509_pem(&data) {
+            drop(pem.parse_x509());
+        }
+    }
+}
diff --git a/tests/readcert.rs b/tests/readcert.rs
index c27c5c9..96f9384 100644
--- a/tests/readcert.rs
+++ b/tests/readcert.rs
@@ -482,3 +482,220 @@ fn rsa_key_size_4096_extension1() {
         .expect("could not parse public key");
     assert_eq!(pkey.key_size(), 4096);
 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+//
+// X.509 certificates are parsed from untrusted input (TLS handshakes, etc.),
+// and the crate documents itself as panic-free with defensive parsing
+// (recursion limits, no unchecked allocation from attacker-controlled DER
+// length fields). The properties below check that contract directly; they
+// supplement the libfuzzer targets in fuzz/fuzz_targets.
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use asn1_rs::{DerParser, Input};
+    use hegel::generators;
+    use x509_parser::prelude::*;
+
+    static CERTIFICATE_DER: &[u8] = include_bytes!("../assets/certificate.der");
+    static LETS_ENCRYPT_X3: &[u8] = include_bytes!("../assets/lets-encrypt-x3-cross-signed.der");
+    static ED25519_DER: &[u8] = include_bytes!("../assets/ed25519.der");
+    static P521_DER: &[u8] = include_bytes!("../assets/p521-selfsigned.der");
+    static RSA_PSS_SHA256: &[u8] = include_bytes!("../assets/rsa-pss/self_signed_sha256.der");
+
+    /// All valid DER certificate fixtures shipped in assets/, used as seeds.
+    fn seed_certs() -> Vec<&'static [u8]> {
+        vec![
+            super::IGCA_DER,
+            super::NO_EXTENSIONS_DER,
+            super::V1,
+            super::UNIQUE_IDS_DER,
+            super::DUPLICATE_VALUE_IN_AIA,
+            CERTIFICATE_DER,
+            LETS_ENCRYPT_X3,
+            ED25519_DER,
+            P521_DER,
+            RSA_PSS_SHA256,
+        ]
+    }
+
+    /// Assert that `inner` is a subslice (by pointer) of `outer`.
+    fn assert_within(inner: &[u8], outer: &[u8], what: &str) {
+        let o_start = outer.as_ptr() as usize;
+        let o_end = o_start + outer.len();
+        let i_start = inner.as_ptr() as usize;
+        let i_end = i_start + inner.len();
+        assert!(
+            i_start >= o_start && i_end <= o_end,
+            "{}: slice {:#x}..{:#x} escapes input {:#x}..{:#x}",
+            what, i_start, i_end, o_start, o_end
+        );
+    }
+
+    /// Property: parsing arbitrary bytes never panics (Err is fine, panic is
+    /// not). Also exercised with a DER SEQUENCE magic prefix (0x30 0x82) so
+    /// generated inputs get past the first tag check more often.
+    #[hegel::test]
+    fn prop_cert_arbitrary_bytes_never_panic(tc: hegel::TestCase) {
+        let bytes: Vec<u8> = tc.draw(generators::binary().max_size(2048));
+        drop(parse_x509_certificate(&bytes));
+        drop(X509Certificate::from_der(&bytes));
+        drop(X509Certificate::parse_der(Input::from(bytes.as_slice())));
+
+        let mut prefixed = Vec::with_capacity(bytes.len() + 2);
+        prefixed.extend_from_slice(&[0x30, 0x82]);
+        prefixed.extend_from_slice(&bytes);
+        drop(parse_x509_certificate(&prefixed));
+    }
+
+    /// Property: a crafted long-form DER length header claiming more content
+    /// than the input holds must return Err — quickly, and without
+    /// pre-allocating attacker-controlled amounts of memory (a huge claimed
+    /// length that triggered an allocation would OOM-abort this test).
+    #[hegel::test]
+    fn prop_cert_crafted_length_header_errs(tc: hegel::TestCase) {
+        // long-form length: 0x80 | n, followed by n length octets (attacker-controlled)
+        let n = tc.draw(generators::integers::<u8>().min_value(1).max_value(8)) as usize;
+        let len_bytes: Vec<u8> = tc.draw(generators::binary().min_size(n).max_size(n));
+        let body: Vec<u8> = tc.draw(generators::binary().max_size(64));
+
+        let mut data = vec![0x30u8, 0x80 | n as u8];
+        data.extend_from_slice(&len_bytes);
+        data.extend_from_slice(&body);
+
+        let claimed = len_bytes.iter().fold(0u128, |acc, b| (acc << 8) | u128::from(*b));
+        let res = parse_x509_certificate(&data);
+        if claimed > body.len() as u128 {
+            assert!(
+                res.is_err(),
+                "header claims {} content bytes but only {} available",
+                claimed,
+                body.len()
+            );
+        } else {
+            drop(res);
+        }
+    }
+
+    /// Property (valid-then-corrupt): take a real certificate and corrupt a
+    /// few bytes — anywhere, with a bias towards the leading tag/length
+    /// bytes. Parsing must return Ok or Err, never panic; on Ok, all
+    /// zero-copy field slices must still point inside the input.
+    #[hegel::test]
+    fn prop_cert_corrupted_seed_never_panics(tc: hegel::TestCase) {
+        let seed: &[u8] = tc.draw(generators::sampled_from(seed_certs()));
+        let mut data = seed.to_vec();
+        // 0 => unmutated seed: guarantees the accepted-input branch below is
+        // exercised; small counts are biased so "corrupted but still accepted"
+        // inputs (e.g. a flipped signature byte) occur often
+        let n_mut = tc.draw(hegel::one_of!(
+            generators::integers::<usize>().max_value(2),
+            generators::integers::<usize>().max_value(8),
+        ));
+        for _ in 0..n_mut {
+            // bias half the mutations into the first 16 bytes, where the
+            // outer tag/length and TBS tag/length fields live
+            let idx = tc.draw(hegel::one_of!(
+                generators::integers::<usize>().max_value(data.len() - 1),
+                generators::integers::<usize>().max_value(15),
+            ));
+            data[idx] = tc.draw(generators::integers::<u8>());
+        }
+        if let Ok((rem, cert)) = parse_x509_certificate(&data) {
+            // corrupted-but-accepted input: zero-copy invariants must hold
+            assert_within(rem, &data, "remainder");
+            assert_within(cert.as_raw(), &data, "cert as_raw");
+        }
+    }
+
+    /// Property (truncation): every strict prefix of a valid certificate
+    /// fails to parse — the outer SEQUENCE length always covers the whole
+    /// certificate, so a prefix can never be a complete object — and it must
+    /// fail with Err, not a panic or an out-of-bounds read.
+    #[hegel::test]
+    fn prop_cert_strict_prefix_errs(tc: hegel::TestCase) {
+        let seed: &[u8] = tc.draw(generators::sampled_from(seed_certs()));
+        let cut = tc.draw(generators::integers::<usize>().max_value(seed.len() - 1));
+        let res = parse_x509_certificate(&seed[..cut]);
+        assert!(res.is_err(), "prefix of len {} unexpectedly parsed", cut);
+    }
+
+    /// Property (parsed-field bounds, oracle-independent): every zero-copy
+    /// slice exposed by a successfully parsed certificate (serial, issuer,
+    /// subject, extension values, remainder) lies within the input buffer.
+    #[hegel::test]
+    fn prop_parsed_cert_slices_within_input(tc: hegel::TestCase) {
+        let seed: &[u8] = tc.draw(generators::sampled_from(seed_certs()));
+        // copy to a fresh allocation so "within the input" is a strict check
+        let data = seed.to_vec();
+        let (rem, cert) = parse_x509_certificate(&data).expect("seed certificate must parse");
+        assert_within(rem, &data, "remainder");
+        let tbs = &cert.tbs_certificate;
+        assert_within(cert.as_raw(), &data, "cert as_raw");
+        assert_within(tbs.as_ref(), &data, "tbs as_ref");
+        assert_within(tbs.raw_serial(), &data, "raw serial");
+        assert_within(tbs.issuer.as_raw(), &data, "issuer");
+        assert_within(tbs.subject.as_raw(), &data, "subject");
+        for ext in cert.extensions() {
+            assert_within(ext.value.as_bytes2(), &data, "extension value");
+        }
+        // accessors over parsed data must not panic either
+        drop(tbs.raw_serial_as_string());
+        let _ = cert.validity().is_valid();
+        for _ in cert.iter_extensions() {}
+    }
+
+    /// Property (re-parse): re-parsing exactly the bytes consumed by a
+    /// successful parse yields an equal structure with no remainder.
+    #[hegel::test]
+    fn prop_cert_reparse_equal(tc: hegel::TestCase) {
+        let seed: &[u8] = tc.draw(generators::sampled_from(seed_certs()));
+        let (rem, cert1) = parse_x509_certificate(seed).expect("seed certificate must parse");
+        let consumed = &seed[..seed.len() - rem.len()];
+        let (rem2, cert2) =
+            parse_x509_certificate(consumed).expect("consumed bytes must re-parse");
+        assert!(rem2.is_empty());
+        assert_eq!(cert1, cert2);
+    }
+
+    /// Property (deeply nested DER): SEQUENCEs/SETs nested thousands deep
+    /// must be rejected gracefully — no stack overflow, no hang. DER length
+    /// fields are attacker-controlled, so this is the classic
+    /// "decompression bomb" shape for recursive-descent parsers.
+    #[hegel::test]
+    fn prop_deeply_nested_der_no_stack_overflow(tc: hegel::TestCase) {
+        // sweep the depth up to 50k, boosting the deep end (uniform draws
+        // rarely land there)
+        let depth = tc.draw(hegel::one_of!(
+            generators::integers::<usize>().min_value(2).max_value(50_000),
+            generators::sampled_from(vec![1_000usize, 5_000, 20_000, 50_000]),
+        ));
+        // innermost payload, then wrap `depth` times in SEQUENCE (or SET)
+        let use_set = tc.draw(generators::booleans());
+        let mut data: Vec<u8> = Vec::new();
+        for level in 0..depth {
+            let tag: u8 = if use_set && level % 2 == 0 { 0x31 } else { 0x30 };
+            let mut wrapped = Vec::with_capacity(data.len() + 6);
+            wrapped.push(tag);
+            let len = data.len();
+            if len < 0x80 {
+                wrapped.push(len as u8);
+            } else if len <= 0xFFFF {
+                wrapped.push(0x82);
+                wrapped.extend_from_slice(&(len as u16).to_be_bytes());
+            } else {
+                wrapped.push(0x84);
+                wrapped.extend_from_slice(&(len as u32).to_be_bytes());
+            }
+            wrapped.extend_from_slice(&data);
+            data = wrapped;
+        }
+        // nested empty containers are never a valid certificate / CRL / CSR
+        assert!(parse_x509_certificate(&data).is_err());
+        assert!(parse_x509_crl(&data).is_err());
+        assert!(X509CertificationRequest::from_der(&data).is_err());
+        // X509Name is SEQUENCE OF, so deep nesting probes its element loop;
+        // depth >= 2 puts a non-SET inside, which is never a valid RDN
+        drop(X509Name::parse_der(Input::from(data.as_slice())));
+    }
+}
diff --git a/tests/readcrl.rs b/tests/readcrl.rs
index 206d60d..f344006 100644
--- a/tests/readcrl.rs
+++ b/tests/readcrl.rs
@@ -113,3 +113,75 @@ fn test_only_attribute_cers_crl_idp() {
     assert!(crl_idp.only_some_reasons.is_none());
     assert!(crl_idp.only_contains_attribute_certs);
 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+//
+// CRLs are fetched from untrusted distribution points, so the parser must be
+// robust against arbitrary/corrupted/truncated input. Supplements
+// fuzz/fuzz_targets/crl.rs.
+// ---------------------------------------------------------------------------
+mod hegel_props {
+    use hegel::generators;
+    use x509_parser::prelude::*;
+
+    fn seed_crls() -> Vec<&'static [u8]> {
+        vec![
+            include_bytes!("../assets/example.crl"),
+            include_bytes!("../assets/empty.crl"),
+            include_bytes!("../assets/minimal.crl"),
+            include_bytes!("../assets/crl-ext/crl-complex.der"),
+            include_bytes!("../assets/crl-ext/crl-simple.der"),
+            include_bytes!("../assets/crl-idp/indirect.der"),
+            include_bytes!("../assets/crl-idp/minimal.der"),
+            include_bytes!("../assets/crl-idp/only_some_reasons.der"),
+        ]
+    }
+
+    /// Property: CRL parsing of arbitrary bytes, and of real CRLs with a few
+    /// corrupted bytes, never panics. On success, the revoked-certificates
+    /// iterator and its accessors must not panic either.
+    #[hegel::test]
+    fn prop_crl_arbitrary_and_corrupted_never_panic(tc: hegel::TestCase) {
+        // arbitrary bytes
+        let bytes: Vec<u8> = tc.draw(generators::binary().max_size(1024));
+        drop(parse_x509_crl(&bytes));
+        drop(CertificateRevocationList::from_der(&bytes));
+
+        // valid-then-corrupt
+        let seed: &[u8] = tc.draw(generators::sampled_from(seed_crls()));
+        let mut data = seed.to_vec();
+        // 0 => unmutated seed: guarantees the accepted-input branch below is
+        // exercised; small counts are biased so "corrupted but still accepted"
+        // inputs (e.g. a flipped signature byte) occur often
+        let n_mut = tc.draw(hegel::one_of!(
+            generators::integers::<usize>().max_value(2),
+            generators::integers::<usize>().max_value(8),
+        ));
+        for _ in 0..n_mut {
+            let idx = tc.draw(generators::integers::<usize>().max_value(data.len() - 1));
+            data[idx] = tc.draw(generators::integers::<u8>());
+        }
+        if let Ok((_rem, crl)) = parse_x509_crl(&data) {
+            for revoked in crl.iter_revoked_certificates() {
+                drop(revoked.raw_serial_as_string());
+                let _ = revoked.reason_code();
+                let _ = revoked.invalidity_date();
+            }
+            let _ = crl.crl_number();
+        }
+    }
+
+    /// Property (truncation): every strict prefix of a valid CRL returns Err,
+    /// never panics.
+    #[hegel::test]
+    fn prop_crl_strict_prefix_errs(tc: hegel::TestCase) {
+        let seed: &[u8] = tc.draw(generators::sampled_from(seed_crls()));
+        let cut = tc.draw(generators::integers::<usize>().max_value(seed.len() - 1));
+        assert!(
+            parse_x509_crl(&seed[..cut]).is_err(),
+            "prefix of len {} unexpectedly parsed",
+            cut
+        );
+    }
+}
