diff --git a/percent_encoding/src/ascii_set.rs b/percent_encoding/src/ascii_set.rs
index 26c66dd..49969d7 100644
--- a/percent_encoding/src/ascii_set.rs
+++ b/percent_encoding/src/ascii_set.rs
@@ -210,4 +210,113 @@ mod tests {
         assert!(!COMPLEMENT.contains(b'B'));
         assert!(COMPLEMENT.contains(b'C'));
     }
+
+    // ---------------------------------------------------------------------
+    // Property-based tests (hegel)
+    // ---------------------------------------------------------------------
+
+    // The crate is `#![no_std]` (root does `extern crate std as _`), but
+    // hegel's generated code assumes the std prelude.
+    extern crate std;
+    use std::{collections::HashSet, format, string::ToString, vec::Vec};
+
+    use hegel::generators;
+    use hegel::Generator;
+    use hegel::TestCase;
+
+    /// Model-based test: `AsciiSet` under `add`/`remove`/`union`/`complement`
+    /// (including the `+` and `!` operator forms) behaves like a `HashSet<u8>`
+    /// over the ASCII range, as observed through `contains` and
+    /// `should_percent_encode`.
+    ///
+    /// Drawn bytes are restricted to `0x00..=0x7F`: `AsciiSet` is documented
+    /// as "a set of characters or bytes in the ASCII range", and `add` indexes
+    /// out of bounds for larger bytes.
+    struct AsciiSetModel {
+        subject: AsciiSet,
+        model: HashSet<u8>,
+    }
+
+    fn ascii_bytes() -> impl hegel::generators::Generator<u8> {
+        generators::integers::<u8>().max_value(0x7F)
+    }
+
+    #[hegel::state_machine]
+    impl AsciiSetModel {
+        #[rule]
+        fn add(&mut self, tc: TestCase) {
+            let b = tc.draw((ascii_bytes()).print_as_debug());
+            self.subject = self.subject.add(b);
+            self.model.insert(b);
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: TestCase) {
+            let b = tc.draw((ascii_bytes()).print_as_debug());
+            self.subject = self.subject.remove(b);
+            self.model.remove(&b);
+        }
+
+        #[rule]
+        fn union(&mut self, tc: TestCase) {
+            let bytes: Vec<u8> = tc.draw((generators::vecs(ascii_bytes())).print_as_debug());
+            let mut other = AsciiSet::EMPTY;
+            for &b in &bytes {
+                other = other.add(b);
+            }
+            let old = mem::replace(&mut self.subject, AsciiSet::EMPTY);
+            // `+` is documented (via `impl ops::Add`) to be the union.
+            self.subject = if tc.draw(generators::booleans()) {
+                old + other
+            } else {
+                old.union(other)
+            };
+            self.model.extend(bytes);
+        }
+
+        #[rule]
+        fn complement(&mut self, tc: TestCase) {
+            let old = mem::replace(&mut self.subject, AsciiSet::EMPTY);
+            // `!` is documented (via `impl ops::Not`) to be the complement.
+            self.subject = if tc.draw(generators::booleans()) {
+                !old
+            } else {
+                old.complement()
+            };
+            self.model = (0..0x80u8).filter(|b| !self.model.contains(b)).collect();
+        }
+
+        #[invariant]
+        fn contains_agrees_with_model(&self, _: TestCase) {
+            for b in 0..0x80u8 {
+                assert_eq!(
+                    self.subject.contains(b),
+                    self.model.contains(&b),
+                    "contains({:#04x}) disagrees with model",
+                    b
+                );
+            }
+        }
+
+        #[invariant]
+        fn should_percent_encode_agrees_with_model(&self, _: TestCase) {
+            for b in 0..=0xFFu8 {
+                assert_eq!(
+                    self.subject.should_percent_encode(b),
+                    !b.is_ascii() || self.model.contains(&b),
+                    "should_percent_encode({:#04x}) disagrees with model",
+                    b
+                );
+            }
+        }
+    }
+
+    #[hegel::test]
+    fn prop_ascii_set_behaves_like_hashset_model(tc: TestCase) {
+        let machine = AsciiSetModel {
+            subject: AsciiSet::EMPTY,
+            model: HashSet::new(),
+        };
+        hegel::stateful::machine(machine).run(tc);
+    }
 }
