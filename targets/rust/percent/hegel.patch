--- a/percent_encoding/src/lib.rs
+++ b/percent_encoding/src/lib.rs
@@ -42,6 +42,11 @@
 #[cfg(feature = "std")]
 extern crate std as _;
 
+// Hegel's macro-generated test code refers to `::std`, which the aliased
+// import above does not provide in this `no_std` crate.
+#[cfg(test)]
+extern crate std;
+
 #[cfg(feature = "alloc")]
 extern crate alloc;
 
@@ -478,4 +483,236 @@ mod tests {
             "\u{0}���"
         );
     }
+
+    // ---------------------------------------------------------------------
+    // Property-based tests (hegel)
+    // ---------------------------------------------------------------------
+
+    // The crate is `#![no_std]` (root does `extern crate std as _`), but
+    // `#[hegel::test]`'s generated code assumes the std prelude.
+    extern crate std;
+    use std::{boxed::Box, format, string::ToString};
+
+    use hegel::generators;
+    use hegel::Generator;
+
+    /// Generate an arbitrary `AsciiSet` (the "configuration" of this crate):
+    /// start from `CONTROLS` and add/remove drawn bytes.
+    ///
+    /// Drawn bytes are restricted to `0x00..=0x7F` because `AsciiSet` is
+    /// documented as "a set of characters or bytes in the ASCII range"
+    /// (`add`/`remove` index out of bounds for non-ASCII bytes, which is
+    /// outside the documented domain).
+    ///
+    /// `percent_encode` demands `&'static AsciiSet`, so the set is leaked;
+    /// a few bytes per test case is negligible.
+    #[hegel::composite]
+    fn generated_sets(tc: &hegel::TestCase) -> &'static AsciiSet {
+        let ascii = || generators::integers::<u8>().max_value(0x7F);
+        let added: Vec<u8> = tc.draw(generators::vecs(ascii()));
+        let removed: Vec<u8> = tc.draw(generators::vecs(ascii()));
+        let mut set = CONTROLS.union(AsciiSet::EMPTY);
+        for &b in &added {
+            set = set.add(b);
+        }
+        for &b in &removed {
+            set = set.remove(b);
+        }
+        let leaked: &'static AsciiSet = Box::leak(Box::new(set));
+        leaked
+    }
+
+    /// Byte strings biased toward percent-decoding edge cases: lone `%`,
+    /// truncated `%X`, non-hex `%XY`, and valid upper/lowercase escapes.
+    /// Uniform `binary()` almost never produces a valid `%XX` triple.
+    #[hegel::composite]
+    fn percenty_bytes(tc: &hegel::TestCase) -> Vec<u8> {
+        let n = tc.draw(generators::integers::<usize>().max_value(20));
+        let mut out = Vec::new();
+        for _ in 0..n {
+            match tc.draw(generators::integers::<u8>().max_value(3)) {
+                0 => out.extend(tc.draw(generators::binary().max_size(3))),
+                1 => out.push(b'%'),
+                2 => {
+                    // '%' followed by 0-2 arbitrary bytes: hits truncated and
+                    // non-hex escapes, and (rarely) valid ones.
+                    out.push(b'%');
+                    out.extend(tc.draw(generators::binary().max_size(2)));
+                }
+                _ => {
+                    // A guaranteed-valid escape, upper- or lowercase hex.
+                    let b = tc.draw(generators::integers::<u8>());
+                    let escape = if tc.draw(generators::booleans()) {
+                        format!("%{:02X}", b)
+                    } else {
+                        format!("%{:02x}", b)
+                    };
+                    out.extend(escape.bytes());
+                }
+            }
+        }
+        out
+    }
+
+    /// Reference decoder, written directly from the documentation of
+    /// `percent_decode`: "Any sequence of `%` followed by two hexadecimal
+    /// digits is decoded", everything else is passed through unchanged.
+    fn reference_decode(input: &[u8]) -> Vec<u8> {
+        fn hex_value(b: u8) -> Option<u8> {
+            match b {
+                b'0'..=b'9' => Some(b - b'0'),
+                b'a'..=b'f' => Some(b - b'a' + 10),
+                b'A'..=b'F' => Some(b - b'A' + 10),
+                _ => None,
+            }
+        }
+        let mut out = Vec::new();
+        let mut i = 0;
+        while i < input.len() {
+            if input[i] == b'%' && i + 2 < input.len() {
+                if let (Some(h), Some(l)) = (hex_value(input[i + 1]), hex_value(input[i + 2])) {
+                    out.push(h * 0x10 + l);
+                    i += 3;
+                    continue;
+                }
+            }
+            out.push(input[i]);
+            i += 1;
+        }
+        out
+    }
+
+    /// Round-trip: decoding inverts encoding for arbitrary bytes, as long as
+    /// the set contains `%` (otherwise a literal `%XX` in the input is left
+    /// unescaped and decodes to a different byte string — see the
+    /// percent-free-input property below for that case).
+    ///
+    /// The set is either an arbitrary generated set with `%` forced in, or
+    /// the public `NON_ALPHANUMERIC` (which contains `%`).
+    #[hegel::test]
+    fn prop_decode_inverts_encode_when_set_has_percent(tc: hegel::TestCase) {
+        let set: &'static AsciiSet = if tc.draw(generators::booleans()) {
+            NON_ALPHANUMERIC
+        } else {
+            Box::leak(Box::new(tc.draw((generated_sets()).print_as_debug()).add(b'%')))
+        };
+        // Draw the size separately so long runs of unencoded bytes exercise
+        // the encoder's slice-chunking path.
+        let n = tc.draw(generators::integers::<usize>().max_value(200));
+        let input: Vec<u8> = tc.draw(generators::binary().min_size(n));
+        let encoded: String = percent_encode(&input, set).collect();
+        let decoded: Vec<u8> = super::percent_decode(encoded.as_bytes()).collect();
+        assert_eq!(decoded, input, "encoded form was {:?}", encoded);
+    }
+
+    /// Round-trip for *any* generated set (with or without `%`), for inputs
+    /// containing no literal `%`. This includes inputs full of bytes that ARE
+    /// in the set and non-ASCII bytes.
+    #[hegel::test]
+    fn prop_decode_inverts_encode_for_percent_free_input(tc: hegel::TestCase) {
+        let set = tc.draw((generated_sets()).print_as_debug());
+        let mut input: Vec<u8> = tc.draw(generators::binary());
+        // A literal '%' under a set lacking '%' may form an unintended escape
+        // with following bytes; the docs promise nothing for that case.
+        input.retain(|&b| b != b'%');
+        let encoded: String = percent_encode(&input, set).collect();
+        let decoded: Vec<u8> = super::percent_decode(encoded.as_bytes()).collect();
+        assert_eq!(decoded, input, "encoded form was {:?}", encoded);
+    }
+
+    /// The decoder agrees with a reference decoder written from its docs, on
+    /// inputs biased toward malformed escapes (lone `%`, `%X`, `%` + non-hex).
+    /// In particular it never panics on arbitrary input.
+    #[hegel::test]
+    fn prop_decode_matches_reference_decoder(tc: hegel::TestCase) {
+        let input = tc.draw(percenty_bytes());
+        let decoded: Vec<u8> = super::percent_decode(&input).collect();
+        assert_eq!(decoded, reference_decode(&input));
+    }
+
+    /// All documented views of `PercentDecode` agree with the iterator:
+    /// `Cow::from` yields the same bytes (and borrows when nothing decodes,
+    /// as documented), `decode_utf8` agrees with `str::from_utf8` on the
+    /// decoded bytes, and `decode_utf8_lossy` agrees with
+    /// `String::from_utf8_lossy`.
+    #[hegel::test]
+    fn prop_decode_views_agree(tc: hegel::TestCase) {
+        let input = tc.draw(percenty_bytes());
+        let decoded: Vec<u8> = super::percent_decode(&input).collect();
+
+        let cow: Cow<'_, [u8]> = super::percent_decode(&input).into();
+        assert_eq!(*cow, *decoded);
+        if decoded == input {
+            // Documented: borrows the input when it contains no
+            // percent-encoded sequence.
+            assert!(matches!(cow, Cow::Borrowed(_)));
+        }
+
+        match super::percent_decode(&input).decode_utf8() {
+            Ok(s) => assert_eq!(s.as_bytes(), &decoded[..]),
+            Err(_) => assert!(str::from_utf8(&decoded).is_err()),
+        }
+
+        let lossy = super::percent_decode(&input).decode_utf8_lossy();
+        assert_eq!(lossy, String::from_utf8_lossy(&decoded));
+    }
+
+    /// The encoder agrees with a per-byte oracle built from the documented
+    /// rule "Non-ASCII bytes and bytes in `ascii_set` are encoded" and from
+    /// `percent_encode_byte` (itself pinned by an exhaustive unit test above).
+    #[hegel::test]
+    fn prop_encode_matches_per_byte_oracle(tc: hegel::TestCase) {
+        let set: &'static AsciiSet = if tc.draw(generators::booleans()) {
+            tc.draw((generators::sampled_from(std::vec![CONTROLS, NON_ALPHANUMERIC])).print_as_debug())
+        } else {
+            tc.draw((generated_sets()).print_as_debug())
+        };
+        let input: Vec<u8> = tc.draw(generators::binary());
+        let mut expected = String::new();
+        for &b in &input {
+            if !b.is_ascii() || set.contains(b) {
+                expected.push_str(super::percent_encode_byte(b));
+            } else {
+                expected.push(b as char);
+            }
+        }
+        let encoded: String = percent_encode(&input, set).collect();
+        assert_eq!(encoded, expected);
+        assert!(encoded.is_ascii());
+    }
+
+    /// All documented views of `PercentEncode` agree: `Display` and
+    /// `Cow::from` match `collect::<String>()`, and the `Cow` borrows the
+    /// input when none of its bytes are encoded, as documented.
+    #[hegel::test]
+    fn prop_encode_views_agree(tc: hegel::TestCase) {
+        let set = tc.draw((generated_sets()).print_as_debug());
+        let input: Vec<u8> = tc.draw(generators::binary());
+        let collected: String = percent_encode(&input, set).collect();
+        assert_eq!(percent_encode(&input, set).to_string(), collected);
+        let cow: Cow<'_, str> = percent_encode(&input, set).into();
+        assert_eq!(cow, collected);
+        if collected.as_bytes() == &input[..] {
+            // Documented: borrows the input when none of its bytes are
+            // encoded. (The converse is not promised: a single encoded byte
+            // yields a Cow borrowing the static escape table.)
+            assert!(matches!(cow, Cow::Borrowed(_)));
+        }
+    }
+
+    /// `utf8_percent_encode` round-trips arbitrary Unicode strings through
+    /// `percent_decode_str` + `decode_utf8`, for any generated set containing
+    /// `%`, and the lossy decode agrees since the bytes are valid UTF-8.
+    #[hegel::test]
+    fn prop_utf8_encode_decode_roundtrip(tc: hegel::TestCase) {
+        let set: &'static AsciiSet =
+            Box::leak(Box::new(tc.draw((generated_sets()).print_as_debug()).add(b'%')));
+        let input: String = tc.draw(generators::text());
+        let encoded = super::utf8_percent_encode(&input, set).to_string();
+        let decoded = super::percent_decode_str(&encoded)
+            .decode_utf8()
+            .expect("decoded bytes of an encoded str must be valid UTF-8");
+        assert_eq!(decoded, input);
+        assert_eq!(super::percent_decode_str(&encoded).decode_utf8_lossy(), input);
+    }
 }
