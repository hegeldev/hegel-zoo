+
+    fn draw_finite_f32(tc: &hegel::TestCase) -> f32 {
+        // NaN/infinity are excluded because JSON has no representation for
+        // them: serde_json serializes non-finite numbers as `null`, which is
+        // a serde_json limitation rather than a gltf-json roundtrip bug (and
+        // the glTF spec forbids non-finite values anyway).
+        tc.draw(
+            generators::floats::<f32>()
+                .allow_nan(false)
+                .allow_infinity(false),
+        )
+    }
+
+    fn draw_finite_vec3(tc: &hegel::TestCase) -> [f32; 3] {
+        [
+            draw_finite_f32(tc),
+            draw_finite_f32(tc),
+            draw_finite_f32(tc),
+        ]
+    }
+
+    fn draw_opt_string(tc: &hegel::TestCase) -> Option<String> {
+        tc.draw(generators::optional(generators::text()))
+    }
+
+    /// Draws an in-bounds `Index` into a collection of length `len > 0`.
+    fn draw_index<T>(tc: &hegel::TestCase, len: usize) -> Index<T> {
+        Index::new(tc.draw(generators::integers::<u32>().max_value(len as u32 - 1)))
+    }
+
+    fn draw_buffer(tc: &hegel::TestCase) -> Buffer {
+        Buffer {
+            byte_length: USize64(tc.draw(generators::integers::<u64>())),
+            #[cfg(feature = "names")]
+            name: draw_opt_string(tc),
+            uri: draw_opt_string(tc),
+            extensions: None,
+            extras: Default::default(),
+        }
+    }
+
+    fn draw_buffer_view(tc: &hegel::TestCase, buffer_count: usize) -> buffer::View {
+        buffer::View {
+            buffer: draw_index(tc, buffer_count),
+            byte_length: USize64(tc.draw(generators::integers::<u64>())),
+            byte_offset: tc
+                .draw(generators::booleans())
+                .then(|| USize64(tc.draw(generators::integers::<u64>()))),
+            // Stride outside 4..=252 is a validation error by definition, so
+            // valid documents stay in range.
+            byte_stride: tc.draw(generators::booleans()).then(|| {
+                buffer::Stride(
+                    tc.draw(
+                        generators::integers::<usize>()
+                            .min_value(buffer::MIN_BYTE_STRIDE)
+                            .max_value(buffer::MAX_BYTE_STRIDE),
+                    ),
+                )
+            }),
+            #[cfg(feature = "names")]
+            name: draw_opt_string(tc),
+            target: tc.draw(generators::booleans()).then(|| {
+                Checked::Valid(tc.draw((generators::sampled_from(vec![
+                    buffer::Target::ArrayBuffer,
+                    buffer::Target::ElementArrayBuffer,
+                ])).print_as_debug()))
+            }),
+            extensions: None,
+            extras: Default::default(),
+        }
+    }
+
+    /// Draws an accessor. When `with_min_max` is set, the accessor gets
+    /// `[f32; 3]` `min`/`max` values and is therefore usable as a `POSITION`
+    /// attribute (whose validation hook demands exactly that shape).
+    fn draw_accessor(tc: &hegel::TestCase, view_count: usize, with_min_max: bool) -> Accessor {
+        use accessor::{ComponentType, GenericComponentType, Type};
+        let min_max = |tc: &hegel::TestCase| {
+            let [x, y, z] = draw_finite_vec3(tc);
+            serde_json::json!([x, y, z])
+        };
+        Accessor {
+            buffer_view: (view_count > 0 && tc.draw(generators::booleans()))
+                .then(|| draw_index(tc, view_count)),
+            byte_offset: tc
+                .draw(generators::booleans())
+                .then(|| USize64(tc.draw(generators::integers::<u64>()))),
+            count: USize64(tc.draw(generators::integers::<u64>())),
+            component_type: Checked::Valid(GenericComponentType(tc.draw(
+                (generators::sampled_from(vec![
+                    ComponentType::I8,
+                    ComponentType::U8,
+                    ComponentType::I16,
+                    ComponentType::U16,
+                    ComponentType::U32,
+                    ComponentType::F32,
+                ])).print_as_debug(),
+            ))),
+            extensions: None,
+            extras: Default::default(),
+            type_: Checked::Valid(tc.draw((generators::sampled_from(vec![
+                Type::Scalar,
+                Type::Vec2,
+                Type::Vec3,
+                Type::Vec4,
+                Type::Mat2,
+                Type::Mat3,
+                Type::Mat4,
+            ])).print_as_debug())),
+            min: with_min_max.then(|| min_max(tc)),
+            max: with_min_max.then(|| min_max(tc)),
+            #[cfg(feature = "names")]
+            name: draw_opt_string(tc),
+            normalized: tc.draw(generators::booleans()),
+            sparse: None,
+        }
+    }
+
+    fn draw_material(tc: &hegel::TestCase) -> Material {
+        use crate::material::{
+            AlphaCutoff, AlphaMode, EmissiveFactor, PbrBaseColorFactor, StrengthFactor,
+        };
+        let mut material = Material::default();
+        material.alpha_cutoff = tc
+            .draw(generators::booleans())
+            .then(|| AlphaCutoff(draw_finite_f32(tc)));
+        material.alpha_mode = Checked::Valid(tc.draw((generators::sampled_from(vec![
+            AlphaMode::Opaque,
+            AlphaMode::Mask,
+            AlphaMode::Blend,
+        ])).print_as_debug()));
+        material.double_sided = tc.draw(generators::booleans());
+        material.emissive_factor = EmissiveFactor(draw_finite_vec3(tc));
+        material.pbr_metallic_roughness.base_color_factor = PbrBaseColorFactor([
+            draw_finite_f32(tc),
+            draw_finite_f32(tc),
+            draw_finite_f32(tc),
+            draw_finite_f32(tc),
+        ]);
+        material.pbr_metallic_roughness.metallic_factor = StrengthFactor(draw_finite_f32(tc));
+        material.pbr_metallic_roughness.roughness_factor = StrengthFactor(draw_finite_f32(tc));
+        #[cfg(feature = "names")]
+        {
+            material.name = draw_opt_string(tc);
+        }
+        material
+    }
+
+    fn draw_primitive(
+        tc: &hegel::TestCase,
+        accessor_count: usize,
+        position_capable: &[u32],
+        material_count: usize,
+    ) -> mesh::Primitive {
+        use mesh::{Mode, MorphTarget, Semantic};
+        let mut attributes = BTreeMap::new();
+        // POSITION is effectively mandatory: its absence is a validation
+        // error, and it must reference an accessor with [f32; 3] min/max.
+        attributes.insert(
+            Checked::Valid(Semantic::Positions),
+            Index::<Accessor>::new(tc.draw(generators::sampled_from(position_capable.to_vec()))),
+        );
+        for semantic in [
+            Semantic::Normals,
+            Semantic::Tangents,
+            Semantic::Colors(tc.draw(generators::integers::<u32>())),
+            Semantic::TexCoords(tc.draw(generators::integers::<u32>())),
+            Semantic::Joints(tc.draw(generators::integers::<u32>())),
+            Semantic::Weights(tc.draw(generators::integers::<u32>())),
+        ] {
+            if tc.draw(generators::booleans()) {
+                attributes.insert(Checked::Valid(semantic), draw_index(tc, accessor_count));
+            }
+        }
+        let draw_morph_target = |tc: &hegel::TestCase| MorphTarget {
+            positions: tc
+                .draw(generators::booleans())
+                .then(|| draw_index(tc, accessor_count)),
+            normals: tc
+                .draw(generators::booleans())
+                .then(|| draw_index(tc, accessor_count)),
+            tangents: tc
+                .draw(generators::booleans())
+                .then(|| draw_index(tc, accessor_count)),
+        };
+        mesh::Primitive {
+            attributes,
+            extensions: None,
+            extras: Default::default(),
+            indices: tc
+                .draw(generators::booleans())
+                .then(|| draw_index(tc, accessor_count)),
+            material: (material_count > 0 && tc.draw(generators::booleans()))
+                .then(|| draw_index(tc, material_count)),
+            mode: Checked::Valid(tc.draw((generators::sampled_from(vec![
+                Mode::Points,
+                Mode::Lines,
+                Mode::LineLoop,
+                Mode::LineStrip,
+                Mode::Triangles,
+                Mode::TriangleStrip,
+                Mode::TriangleFan,
+            ])).print_as_debug())),
+            targets: tc.draw(generators::booleans()).then(|| {
+                let n = tc.draw(generators::integers::<usize>().max_value(2));
+                (0..n).map(|_| draw_morph_target(tc)).collect()
+            }),
+        }
+    }
+
+    fn draw_node(tc: &hegel::TestCase, node_count: usize, mesh_count: usize) -> Node {
+        let matrix = tc.draw(generators::booleans()).then(|| {
+            let mut m = [0f32; 16];
+            for value in m.iter_mut() {
+                *value = draw_finite_f32(tc);
+            }
+            m
+        });
+        Node {
+            camera: None,
+            children: (node_count > 0 && tc.draw(generators::booleans())).then(|| {
+                let n = tc.draw(generators::integers::<usize>().max_value(node_count));
+                (0..n).map(|_| draw_index(tc, node_count)).collect()
+            }),
+            matrix,
+            mesh: (mesh_count > 0 && tc.draw(generators::booleans()))
+                .then(|| draw_index(tc, mesh_count)),
+            rotation: tc.draw(generators::booleans()).then(|| {
+                crate::scene::UnitQuaternion([
+                    draw_finite_f32(tc),
+                    draw_finite_f32(tc),
+                    draw_finite_f32(tc),
+                    draw_finite_f32(tc),
+                ])
+            }),
+            scale: tc
+                .draw(generators::booleans())
+                .then(|| draw_finite_vec3(tc)),
+            translation: tc
+                .draw(generators::booleans())
+                .then(|| draw_finite_vec3(tc)),
+            skin: None,
+            weights: tc.draw(generators::booleans()).then(|| {
+                let n = tc.draw(generators::integers::<usize>().max_value(4));
+                (0..n).map(|_| draw_finite_f32(tc)).collect()
+            }),
+            ..Default::default()
+        }
+    }
+
+    fn draw_scene(tc: &hegel::TestCase, node_count: usize) -> Scene {
+        Scene {
+            extensions: None,
+            extras: Default::default(),
+            #[cfg(feature = "names")]
+            name: draw_opt_string(tc),
+            nodes: if node_count > 0 {
+                let n = tc.draw(generators::integers::<usize>().max_value(node_count));
+                (0..n).map(|_| draw_index(tc, node_count)).collect()
+            } else {
+                Vec::new()
+            },
+        }
+    }
+
+    /// Draws a structurally valid glTF document: every index is in bounds
+    /// and every `Checked` value is `Valid`.
+    fn draw_arbitrary_root(tc: &hegel::TestCase) -> Root {
+        let buffers: Vec<Buffer> = {
+            let n = tc.draw(generators::integers::<usize>().max_value(3));
+            (0..n).map(|_| draw_buffer(tc)).collect()
+        };
+        let buffer_views: Vec<buffer::View> = if buffers.is_empty() {
+            Vec::new()
+        } else {
+            let n = tc.draw(generators::integers::<usize>().max_value(3));
+            (0..n).map(|_| draw_buffer_view(tc, buffers.len())).collect()
+        };
+        let mut position_capable = Vec::new();
+        let accessors: Vec<Accessor> = {
+            let n = tc.draw(generators::integers::<usize>().max_value(4));
+            (0..n)
+                .map(|i| {
+                    let with_min_max = tc.draw(generators::booleans());
+                    if with_min_max {
+                        position_capable.push(i as u32);
+                    }
+                    draw_accessor(tc, buffer_views.len(), with_min_max)
+                })
+                .collect()
+        };
+        let materials: Vec<Material> = {
+            let n = tc.draw(generators::integers::<usize>().max_value(2));
+            (0..n).map(|_| draw_material(tc)).collect()
+        };
+        let meshes: Vec<Mesh> = if position_capable.is_empty() {
+            Vec::new()
+        } else {
+            let n = tc.draw(generators::integers::<usize>().max_value(2));
+            (0..n)
+                .map(|_| {
+                    let primitives = {
+                        let n = tc.draw(generators::integers::<usize>().max_value(2));
+                        (0..n)
+                            .map(|_| {
+                                draw_primitive(
+                                    tc,
+                                    accessors.len(),
+                                    &position_capable,
+                                    materials.len(),
+                                )
+                            })
+                            .collect()
+                    };
+                    Mesh {
+                        extensions: None,
+                        extras: Default::default(),
+                        #[cfg(feature = "names")]
+                        name: draw_opt_string(tc),
+                        primitives,
+                        weights: tc.draw(generators::booleans()).then(|| {
+                            let n = tc.draw(generators::integers::<usize>().max_value(4));
+                            (0..n).map(|_| draw_finite_f32(tc)).collect()
+                        }),
+                    }
+                })
+                .collect()
+        };
+        let nodes: Vec<Node> = {
+            let n = tc.draw(generators::integers::<usize>().max_value(4));
+            (0..n).map(|_| draw_node(tc, n, meshes.len())).collect()
+        };
+        let scenes: Vec<Scene> = {
+            let n = tc.draw(generators::integers::<usize>().max_value(2));
+            (0..n).map(|_| draw_scene(tc, nodes.len())).collect()
+        };
+        let scene = (!scenes.is_empty() && tc.draw(generators::booleans()))
+            .then(|| draw_index(tc, scenes.len()));
+        let asset = Asset {
+            copyright: draw_opt_string(tc),
+            generator: draw_opt_string(tc),
+            ..Default::default()
+        };
+        Root {
+            accessors,
+            asset,
+            buffers,
+            buffer_views,
+            scene,
+            materials,
+            meshes,
+            nodes,
+            scenes,
+            ..Default::default()
+        }
+    }
+
+    /// Serializing a document to JSON text and deserializing it back yields
+    /// a structurally identical document.
+    ///
+    /// Note: this relies on the `float_roundtrip` feature of serde_json
+    /// (enabled in dev-dependencies). serde_json's default float parser is
+    /// documented to be up to 1 ULP off, which shows up here as e.g.
+    /// `1.1254340850495887e+27` reparsing as `...888e+27` in accessor
+    /// `min`/`max` values — a serde_json artifact, not a gltf-json bug.
+    #[hegel::test]
+    fn root_json_roundtrip(tc: hegel::TestCase) {
+        let root = draw_arbitrary_root(&tc);
+        let json_string = root.to_string().expect("serialization failed");
+        let back = Root::from_str(&json_string).expect("deserialization failed");
+        let original = serde_json::to_value(&root).expect("to_value failed");
+        let reparsed = serde_json::to_value(&back).expect("to_value failed");
+        assert_eq!(
+            original, reparsed,
+            "roundtrip mismatch for JSON: {json_string}"
+        );
+    }
+
+    /// A document whose indices are all in bounds and whose enumerated
+    /// values are all valid must pass validation with no errors.
+    #[hegel::test]
+    fn structurally_valid_root_passes_validation(tc: hegel::TestCase) {
+        let root = draw_arbitrary_root(&tc);
+        let mut errors = Vec::new();
+        root.validate(&root, Path::new, &mut |path, error| {
+            errors.push((path(), error));
+        });
+        assert!(
+            errors.is_empty(),
+            "expected no validation errors, got {:?} for JSON: {}",
+            errors,
+            root.to_string().unwrap_or_default(),
+        );
+    }
+
+    /// Injecting a single out-of-bounds index anywhere in an otherwise valid
+    /// document is reported as `IndexOutOfBounds` (and never panics).
+    #[hegel::test]
+    fn out_of_bounds_index_is_reported(tc: hegel::TestCase) {
+        let mut root = draw_arbitrary_root(&tc);
+        let extra = tc.draw(generators::integers::<u32>());
+        // Any value >= len is out of bounds; saturation keeps it so.
+        let oob = |len: usize| (len as u32).saturating_add(extra).max(len as u32);
+        match tc.draw(generators::integers::<u8>().max_value(4)) {
+            0 => {
+                root.scene = Some(Index::new(oob(root.scenes.len())));
+            }
+            1 => {
+                let index = oob(root.meshes.len());
+                root.nodes.push(Node {
+                    mesh: Some(Index::new(index)),
+                    ..Default::default()
+                });
+            }
+            2 => {
+                let index = oob(root.cameras.len());
+                root.nodes.push(Node {
+                    camera: Some(Index::new(index)),
+                    ..Default::default()
+                });
+            }
+            3 => {
+                let index = oob(root.nodes.len());
+                root.scenes.push(Scene {
+                    extensions: None,
+                    extras: Default::default(),
+                    #[cfg(feature = "names")]
+                    name: None,
+                    nodes: vec![Index::new(index)],
+                });
+            }
+            _ => {
+                let index = oob(root.buffers.len());
+                root.buffer_views.push(buffer::View {
+                    buffer: Index::new(index),
+                    byte_length: USize64(4),
+                    byte_offset: None,
+                    byte_stride: None,
+                    #[cfg(feature = "names")]
+                    name: None,
+                    target: None,
+                    extensions: None,
+                    extras: Default::default(),
+                });
+            }
+        }
+        let mut errors = Vec::new();
+        root.validate(&root, Path::new, &mut |path, error| {
+            errors.push((path(), error));
+        });
+        assert!(
+            errors
+                .iter()
+                .any(|(_, error)| *error == validation::Error::IndexOutOfBounds),
+            "expected IndexOutOfBounds, got {errors:?}",
+        );
+    }
 }
