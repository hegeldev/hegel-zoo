+use gltf::json;
+use hegel::generators;
+use json::validation::{Checked, USize64};
+
+/// RFC 4648 section 4 base64 encoding (standard alphabet, with padding),
+/// transcribed from the spec to serve as an independent oracle for the
+/// crate's base64 data-URI decoding.
+fn base64_encode_oracle(data: &[u8]) -> String {
+    const ALPHABET: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut out = String::new();
+    for chunk in data.chunks(3) {
+        let b0 = chunk[0] as u32;
+        let b1 = chunk.get(1).copied().unwrap_or(0) as u32;
+        let b2 = chunk.get(2).copied().unwrap_or(0) as u32;
+        let group = (b0 << 16) | (b1 << 8) | b2;
+        out.push(ALPHABET[(group >> 18) as usize & 0x3f] as char);
+        out.push(ALPHABET[(group >> 12) as usize & 0x3f] as char);
+        if chunk.len() > 1 {
+            out.push(ALPHABET[(group >> 6) as usize & 0x3f] as char);
+        } else {
+            out.push('=');
+        }
+        if chunk.len() > 2 {
+            out.push(ALPHABET[group as usize & 0x3f] as char);
+        } else {
+            out.push('=');
+        }
+    }
+    out
+}
+
+/// Builds a data URI for the given bytes, drawing one of the URI shapes
+/// `Scheme::parse` supports.
+fn draw_data_uri(tc: &hegel::TestCase, data: &[u8]) -> String {
+    let encoded = base64_encode_oracle(data);
+    match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => format!("data:application/octet-stream;base64,{encoded}"),
+        1 => format!("data:application/gltf-buffer;base64,{encoded}"),
+        _ => format!("data:{encoded}"),
+    }
+}
+
+/// A minimal document containing a single buffer with the given data URI
+/// and declared length.
+fn buffer_only_root(uri: String, byte_length: u64) -> json::Root {
+    json::Root {
+        buffers: vec![json::Buffer {
+            byte_length: USize64(byte_length),
+            #[cfg(feature = "names")]
+            name: None,
+            uri: Some(uri),
+            extensions: None,
+            extras: Default::default(),
+        }],
+        ..Default::default()
+    }
+}
+
+#[hegel::test]
+fn gltf_from_slice_never_panics_on_arbitrary_bytes(tc: hegel::TestCase) {
+    // The whole untrusted-input pipeline (GLB framing, JSON deserialization,
+    // validation) must return errors, never panic.
+    let bytes: Vec<u8> = tc.draw(hegel::one_of!(
+        // Arbitrary bytes.
+        generators::binary(),
+        // Arbitrary text, which reaches deeper into the JSON parser.
+        hegel::compose!(|tc| {
+            let text: String = tc.draw(generators::text());
+            text.into_bytes()
+        }),
+        // GLB-magic-prefixed bytes, which reach the binary parser.
+        hegel::compose!(|tc| {
+            let mut v = b"glTF".to_vec();
+            let body: Vec<u8> = tc.draw(generators::binary());
+            v.extend_from_slice(&body);
+            v
+        }),
+    ));
+    drop(gltf::Gltf::from_slice(&bytes));
+    drop(gltf::Gltf::from_reader(std::io::Cursor::new(&bytes[..])));
+}
+
+#[hegel::test]
+fn import_buffers_decodes_base64_data_uri(tc: hegel::TestCase) {
+    let data: Vec<u8> = tc.draw(generators::binary());
+    let uri = draw_data_uri(&tc, &data);
+    let root = buffer_only_root(uri, data.len() as u64);
+    let document = gltf::Document::from_json(root).expect("document must validate");
+    let buffers =
+        gltf::import_buffers(&document, None, None).expect("data URI buffer must import");
+    assert_eq!(buffers.len(), 1);
+    // The imported buffer is the decoded payload zero-padded to a multiple
+    // of four bytes.
+    let imported = &buffers[0].0;
+    assert_eq!(imported.len(), (data.len() + 3) & !3);
+    assert_eq!(&imported[..data.len()], &data[..]);
+    assert!(imported[data.len()..].iter().all(|&b| b == 0));
+}
+
+#[hegel::test]
+fn import_buffers_rejects_undersized_buffer(tc: hegel::TestCase) {
+    // Contract: `import_buffers` errors when the source provides fewer
+    // bytes than `byteLength` declares.
+    let data: Vec<u8> = tc.draw(generators::binary());
+    let uri = draw_data_uri(&tc, &data);
+    // Data is padded to a multiple of four before the length check, so any
+    // declared length beyond the padded size must be rejected.
+    let padded_len = ((data.len() + 3) & !3) as u64;
+    let excess = tc.draw(generators::integers::<u64>().min_value(1));
+    let declared = padded_len.saturating_add(excess);
+    let root = buffer_only_root(uri, declared);
+    let document = gltf::Document::from_json(root).expect("document must validate");
+    match gltf::import_buffers(&document, None, None) {
+        Err(gltf::Error::BufferLength { buffer: 0, .. }) => {}
+        otherwise => panic!("expected BufferLength error, got {otherwise:?}"),
+    }
+}
