+    // ------------------------------------------------------------------
+    // Property-based tests (hegel)
+    // ------------------------------------------------------------------
+
+    use crate::validation::{Checked, USize64};
+    use crate::{accessor, mesh, Accessor, Asset, Material, Mesh, Node, Path, Scene};
+    use hegel::generators;
