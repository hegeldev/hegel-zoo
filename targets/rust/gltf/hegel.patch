+    // Leading junk inside the buffer (skipped by the view offset) and inside
+    // the view (skipped by the accessor offset), in whole words to satisfy
+    // the spec's 4-byte alignment requirement for F32 data.
+    let buffer_junk: Vec<u32> = tc.draw(generators::vecs(generators::integers::<u32>()).max_size(4));
+    let view_junk: Vec<u32> = tc.draw(generators::vecs(generators::integers::<u32>()).max_size(4));
