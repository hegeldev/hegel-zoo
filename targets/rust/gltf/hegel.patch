+    }
+
+    #[hegel::test]
+    fn glb_write_then_read_roundtrips(tc: hegel::TestCase) {
+        let glb = tc.draw((arbitrary_glb()).print_as_debug());
+        let bytes = glb.to_vec().expect("to_vec failed");
+
+        // The writer promises a file whose total length is 4-aligned and
+        // recorded in the header.
+        assert_eq!(bytes.len() % 4, 0);
+
