+
+[dev-dependencies]
+hegeltest = "0.44.1"
+# `float_roundtrip` makes serde_json's float *parsing* exactly correctly
+# rounded. Without it, serde_json's default parser is documented to be up to
+# 1 ULP off, which makes the serialize -> deserialize property tests fail on
+# `min`/`max` values stored as `serde_json::Value` (an artifact of the
+# parser, not a gltf-json bug). Dev-only: feature unification applies this to
+# gltf-json's own test builds without changing what dependents get.
+serde_json = { features = ["float_roundtrip", "raw_value"], version = "1.0" }
