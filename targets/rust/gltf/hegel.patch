+    /// Rounds up to the next multiple of four, like the writer does.
+    fn align4(n: usize) -> usize {
+        (n + 3) & !3
+    }
+
+    /// Generates arbitrary bytes, biased toward inputs that get past the
+    /// early magic/header checks so the chunk parsing code is exercised too.
+    #[hegel::composite]
+    fn glb_like_bytes(tc: &hegel::TestCase) -> Vec<u8> {
+        let body: Vec<u8> = tc.draw(generators::binary());
+        match tc.draw(generators::integers::<u8>().max_value(2)) {
+            // Raw arbitrary bytes.
+            0 => body,
+            // Correct magic, then arbitrary bytes.
+            1 => {
+                let mut v = b"glTF".to_vec();
+                v.extend_from_slice(&body);
+                v
+            }
+            // Full 12-byte header (usually version 2), then arbitrary bytes.
+            _ => {
+                let version: u32 = tc.draw(hegel::one_of!(
+                    generators::just(2u32),
+                    generators::integers::<u32>(),
+                ));
+                let length: u32 = tc.draw(hegel::one_of!(
+                    // In-range lengths reach the chunk parser.
+                    generators::integers::<u32>().max_value(12 + body.len() as u32),
+                    generators::integers::<u32>(),
+                ));
+                let mut v = b"glTF".to_vec();
+                v.extend_from_slice(&version.to_le_bytes());
+                v.extend_from_slice(&length.to_le_bytes());
+                v.extend_from_slice(&body);
+                v
+            }
+        }
+    }
+
+    /// Generates a `Glb` with arbitrary JSON and BIN payload bytes.
+    ///
+    /// `to_writer` ignores `header` (it recomputes magic, version, and
+    /// length), so a placeholder header is fine.
+    #[hegel::composite]
+    fn arbitrary_glb(tc: &hegel::TestCase) -> Glb<'static> {
+        let json: Vec<u8> = tc.draw(generators::binary());
+        let bin: Option<Vec<u8>> = tc.draw(generators::optional(generators::binary()));
+        Glb {
+            header: Header {
+                magic: *b"glTF",
+                version: 2,
+                length: 0,
+            },
+            json: json.into(),
+            bin: bin.map(Into::into),
+        }
+    }
+
+    /// Serialized bytes of an arbitrary valid GLB.
+    #[hegel::composite]
+    fn valid_glb_bytes(tc: &hegel::TestCase) -> Vec<u8> {
+        tc.draw((arbitrary_glb()).print_as_debug()).to_vec().expect("to_vec failed")
+    }
+
+    #[hegel::test]
+    fn glb_from_slice_never_panics_on_arbitrary_bytes(tc: hegel::TestCase) {
+        let bytes = tc.draw(glb_like_bytes());
+        // Property: parsing untrusted bytes returns a Result, never panics.
+        drop(Glb::from_slice(&bytes));
