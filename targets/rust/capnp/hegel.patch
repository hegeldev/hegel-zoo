+    /// A `BufRead` that hands out at most `chunk` bytes at a time, to
+    /// exercise the buffer-refresh paths in `PackedRead::read`.
+    struct Chunked<'a> {
+        data: &'a [u8],
+        chunk: usize,
+    }
+
+    impl<'a> std::io::Read for Chunked<'a> {
+        fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+            let n = buf.len().min(self.chunk).min(self.data.len());
+            buf[..n].copy_from_slice(&self.data[..n]);
+            self.data = &self.data[n..];
+            Ok(n)
+        }
+    }
+
+    impl<'a> std::io::BufRead for Chunked<'a> {
+        fn fill_buf(&mut self) -> std::io::Result<&[u8]> {
+            Ok(&self.data[..self.chunk.min(self.data.len())])
+        }
+        fn consume(&mut self, amt: usize) {
+            self.data = &self.data[amt..];
+        }
+    }
+
+    /// Word-aligned byte strings biased toward the packing format's
+    /// interesting shapes: long runs of zero words (tag 0x00 + run count),
+    /// long runs of all-nonzero words (tag 0xff + uncompressed run), and
+    /// arbitrary words. Run lengths above 255 words exercise run splitting.
+    #[hegel::composite]
+    fn unpacked_words_bytes(tc: &hegel::TestCase) -> alloc::vec::Vec<u8> {
+        use hegel::generators;
+        let n_blocks = tc.draw(generators::integers::<usize>().max_value(6));
+        let mut out = alloc::vec::Vec::new();
+        for _ in 0..n_blocks {
+            match tc.draw(generators::integers::<u8>().max_value(2)) {
+                0 => {
+                    // Run of zero words.
+                    let n = tc.draw(generators::integers::<usize>().max_value(600));
+                    out.extend(core::iter::repeat(0u8).take(n * 8));
+                }
+                1 => {
+                    // Run of all-nonzero words (a drawn seed word, repeated).
+                    let n = tc.draw(generators::integers::<usize>().max_value(600));
+                    let mut seed = [0u8; 8];
+                    for b in &mut seed {
+                        *b = tc.draw(generators::integers::<u8>().min_value(1));
+                    }
+                    for _ in 0..n {
+                        out.extend(seed);
+                    }
+                }
+                _ => {
+                    // Arbitrary words.
+                    let n = tc.draw(generators::integers::<usize>().max_value(32));
+                    let bytes: alloc::vec::Vec<u8> =
+                        tc.draw(generators::binary().min_size(n * 8).max_size(n * 8));
+                    out.extend(bytes);
+                }
+            }
+        }
+        out
+    }
+
+    /// Property: packing is a pure, invertible byte transform — packing any
+    /// word-aligned byte string and then unpacking it (through a reader that
+    /// delivers arbitrarily small chunks) restores the input exactly and
+    /// consumes the entire packed stream.
+    #[cfg_attr(miri, ignore)] // miri is slow with property tests
+    #[hegel::test]
+    fn hegel_pack_unpack_roundtrip(tc: hegel::TestCase) {
+        use hegel::generators;
+        let unpacked = tc.draw(unpacked_words_bytes());
+        let mut packed: alloc::vec::Vec<u8> = alloc::vec::Vec::new();
+        PackedWrite { inner: &mut packed }
+            .write_all(&unpacked)
+            .unwrap();
+
+        let chunk = tc.draw(generators::integers::<usize>().min_value(1).max_value(20));
+        let mut out = vec![0u8; unpacked.len()];
+        let mut packed_read = PackedRead {
+            inner: Chunked {
+                data: &packed,
+                chunk,
+            },
+        };
+        packed_read.read_exact(&mut out).unwrap();
+        assert_eq!(out, unpacked, "pack/unpack roundtrip mismatch");
+        assert!(
+            packed_read.inner.data.is_empty(),
+            "unpacking did not consume the entire packed stream"
+        );
+    }
+
+    /// Property: `serialize_packed::read_message` on arbitrary untrusted
+    /// bytes — including corrupted or truncated versions of valid packed
+    /// messages — must never panic, and on success must respect the default
+    /// traversal limit.
+    #[cfg_attr(miri, ignore)]
+    #[hegel::test]
+    fn hegel_packed_read_arbitrary_bytes_robust(tc: hegel::TestCase) {
+        use hegel::generators::{self, Generator};
+        let data: alloc::vec::Vec<u8> = if tc.draw(generators::booleans()) {
+            // Completely arbitrary bytes.
+            tc.draw(generators::binary().max_size(256))
+        } else {
+            // A valid packed message, then corrupted and/or truncated.
+            let segments: alloc::vec::Vec<alloc::vec::Vec<crate::Word>> = tc.draw(
+                (generators::vecs(
+                    generators::vecs(generators::integers::<u64>())
+                        .max_size(6)
+                        .map(|ws: alloc::vec::Vec<u64>| {
+                            ws.iter()
+                                .map(|w| {
+                                    let b = w.to_le_bytes();
+                                    crate::word(b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7])
+                                })
+                                .collect()
+                        }),
+                )
+                .min_size(1)
+                .max_size(4)).print_as_debug(),
+            );
+            let mut buf: alloc::vec::Vec<u8> = alloc::vec::Vec::new();
+            write_message_segments(&mut PackedWrite { inner: &mut buf }, &segments);
+            if !buf.is_empty() {
+                // Corrupt one byte.
+                let idx = tc.draw(generators::integers::<usize>().max_value(buf.len() - 1));
+                buf[idx] = tc.draw(generators::integers::<u8>());
+                // Sometimes also truncate.
+                if tc.draw(generators::booleans()) {
+                    let keep = tc.draw(generators::integers::<usize>().max_value(buf.len()));
+                    buf.truncate(keep);
+                }
+            }
+            buf
+        };
+
+        let chunk = tc.draw(generators::integers::<usize>().min_value(1).max_value(16));
+        match read_message(
+            Chunked {
+                data: &data,
+                chunk,
+            },
+            ReaderOptions::new(),
+        ) {
+            Err(_) => {}
+            Ok(msg) => {
+                let limit = crate::message::DEFAULT_READER_OPTIONS
+                    .traversal_limit_in_words
+                    .expect("default options have a traversal limit");
+                assert!(
+                    msg.size_in_words() <= limit,
+                    "message larger than the default traversal limit was accepted"
+                );
+            }
+        }
+    }
