+    /// Bytes that look vaguely like a serialized message: either completely
+    /// arbitrary bytes, or a syntactically valid segment table followed by an
+    /// arbitrary (possibly truncated, possibly over-long) body.
+    #[hegel::composite]
+    fn message_like_bytes(tc: &hegel::TestCase) -> alloc::vec::Vec<u8> {
+        use hegel::generators;
+        if tc.draw(generators::booleans()) {
+            // Completely arbitrary bytes.
+            tc.draw(generators::binary().max_size(512))
+        } else {
+            // Plausible framing: a well-formed segment table with small
+            // segment sizes, followed by a drawn amount of body bytes.
+            let count = tc.draw(generators::integers::<u32>().min_value(1).max_value(4)) as usize;
+            let mut sizes = alloc::vec::Vec::with_capacity(count);
+            for _ in 0..count {
+                sizes.push(tc.draw(generators::integers::<u32>().max_value(6)));
+            }
+            let mut bytes = alloc::vec::Vec::new();
+            bytes.extend(((count - 1) as u32).to_le_bytes());
+            for s in &sizes {
+                bytes.extend(s.to_le_bytes());
+            }
+            if count % 2 == 0 {
+                bytes.extend([0u8; 4]);
+            }
+            let total_body_bytes = sizes.iter().map(|&s| s as usize).sum::<usize>() * 8;
+            // Sometimes complete, sometimes truncated, sometimes with trailing bytes.
+            let body_len = tc.draw(
+                generators::integers::<usize>().max_value(total_body_bytes + 16),
+            );
+            let body: alloc::vec::Vec<u8> = tc.draw(
+                generators::binary().min_size(body_len).max_size(body_len),
+            );
+            bytes.extend(body);
+            bytes
+        }
+    }
+
+    /// Property: `serialize::read_message` on arbitrary untrusted bytes must
+    /// never panic, and on success must never have allocated more message
+    /// space than the default traversal limit allows (the segment table is
+    /// attacker-controlled, so a huge declared size must be rejected up
+    /// front, not allocated).
+    #[cfg_attr(miri, ignore)] // miri is slow with property tests
+    #[hegel::test]
+    fn hegel_read_message_arbitrary_bytes_robust(tc: hegel::TestCase) {
+        let bytes = tc.draw(message_like_bytes());
+        let mut slice = &bytes[..];
+        match read_message(&mut slice, message::ReaderOptions::new()) {
+            Err(_) => {}
+            Ok(msg) => {
+                let limit = message::DEFAULT_READER_OPTIONS
+                    .traversal_limit_in_words
+                    .expect("default options have a traversal limit");
+                assert!(
+                    msg.size_in_words() <= limit,
+                    "message larger than the default traversal limit was accepted"
+                );
+                // Traversing the (arbitrary) root must not panic either.
+                if let Ok(root) = msg.get_root::<crate::any_pointer::Reader>() {
+                    let _ = root.target_size();
+                }
+            }
+        }
+    }
+
+    /// Property: the segment-table security limits are enforced. A message
+    /// declaring too many segments, or segments whose total size exceeds the
+    /// traversal limit, must be rejected with an error (before any large
+    /// allocation happens). Conversely, a well-formed table with a complete
+    /// body must be accepted.
+    #[cfg_attr(miri, ignore)]
+    #[hegel::test]
+    fn hegel_segment_table_limits_enforced(tc: hegel::TestCase) {
+        use hegel::generators;
+        // Raw count field; actual segment count = raw + 1 (may wrap to 0).
+        let raw_count: u32 = tc.draw(hegel::one_of!(
+            generators::integers::<u32>().max_value(600),
+            generators::integers::<u32>(),
+        ));
+        let count = (raw_count.wrapping_add(1)) as usize;
+        let mut bytes = raw_count.to_le_bytes().to_vec();
+
+        let mut declared_total_words: u64 = 0;
+        let mut body_complete = false;
+        if (1..super::SEGMENTS_COUNT_LIMIT).contains(&count) {
+            let mut sizes = alloc::vec::Vec::with_capacity(count);
+            for _ in 0..count {
+                // Attacker-controlled sizes: mostly small, sometimes huge.
+                sizes.push(tc.draw(hegel::one_of!(
+                    generators::integers::<u32>().max_value(8),
+                    generators::integers::<u32>(),
+                )));
+            }
+            for s in &sizes {
+                bytes.extend(s.to_le_bytes());
+            }
+            if count % 2 == 0 {
+                bytes.extend([0u8; 4]);
+            }
+            declared_total_words = sizes.iter().map(|&s| s as u64).sum();
+            // Supply the body only when it is small enough for the test to
+            // materialize (this bound protects the test's memory, not the
+            // library's contract).
+            if declared_total_words <= 64 {
+                body_complete = tc.draw(generators::booleans());
+                let full_len = declared_total_words as usize * 8;
+                let body_len = if body_complete {
+                    full_len
+                } else {
+                    // Truncated body (or exactly full for zero-length bodies,
+                    // in which case it is complete after all).
+                    let l = tc.draw(generators::integers::<usize>().max_value(full_len));
+                    if l == full_len {
+                        body_complete = true;
+                    }
+                    l
+                };
+                bytes.extend(core::iter::repeat(0u8).take(body_len));
+            }
+        } else {
+            // Count is invalid; the reader must reject after the first word,
+            // so the rest of the input shouldn't matter.
+            let junk: alloc::vec::Vec<u8> = tc.draw(generators::binary().max_size(64));
+            bytes.extend(junk);
+        }
+
+        let result = read_message(&mut &bytes[..], message::ReaderOptions::new());
+        let default_limit = message::DEFAULT_READER_OPTIONS
+            .traversal_limit_in_words
+            .expect("default options have a traversal limit") as u64;
+        if count == 0 || count >= super::SEGMENTS_COUNT_LIMIT {
+            assert!(result.is_err(), "invalid segment count {count} was accepted");
+        } else if declared_total_words > default_limit {
+            assert!(
+                result.is_err(),
+                "declared total of {declared_total_words} words exceeds the default \
+                 traversal limit but was not rejected"
+            );
+        } else if body_complete {
+            assert!(
+                result.is_ok(),
+                "well-formed message ({count} segments, {declared_total_words} words) \
+                 was rejected: {:?}",
+                result.err()
+            );
+        } else {
+            assert!(result.is_err(), "message with truncated body was accepted");
+        }
+    }
