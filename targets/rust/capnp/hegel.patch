+    /// Property: the allocating and non-allocating flat-slice readers agree.
+    /// For the same (aligned) input bytes they must either both fail or both
+    /// succeed, and on success must produce identical segments and consume
+    /// the same number of bytes.
+    #[cfg_attr(miri, ignore)]
+    #[hegel::test]
+    fn hegel_flat_slice_alloc_and_no_alloc_agree(tc: hegel::TestCase) {
+        let bytes = tc.draw(message_like_bytes());
+        // Copy into 8-byte-aligned storage.
+        let mut words = crate::Word::allocate_zeroed_vec(bytes.len().div_ceil(8));
+        crate::Word::words_to_bytes_mut(&mut words)[..bytes.len()].copy_from_slice(&bytes);
+        let buf = &crate::Word::words_to_bytes(&words)[..bytes.len()];
+
+        let mut s1 = buf;
+        let r1 = read_message_from_flat_slice(&mut s1, message::ReaderOptions::new());
+        let mut s2 = buf;
+        let r2 =
+            super::read_message_from_flat_slice_no_alloc(&mut s2, message::ReaderOptions::new());
+        match (r1, r2) {
+            (Ok(m1), Ok(m2)) => {
+                assert_eq!(s1, s2, "readers consumed different numbers of bytes");
+                let seg1 = m1.into_segments();
+                let seg2 = m2.into_segments();
+                assert_eq!(seg1.len(), seg2.len(), "different segment counts");
+                for i in 0..seg1.len() {
+                    assert_eq!(
+                        seg1.get_segment(i as u32),
+                        seg2.get_segment(i as u32),
+                        "segment {i} differs"
+                    );
+                }
+            }
+            (Err(_), Err(_)) => {}
+            (r1, r2) => panic!(
+                "alloc and no_alloc flat-slice readers disagree: alloc ok = {}, no_alloc ok = {}",
+                r1.is_ok(),
+                r2.is_ok()
+            ),
+        }
+    }
+
+    /// Property: writing arbitrary segments and reading them back from a flat
+    /// slice recovers exactly the original segments, and consumes exactly the
+    /// message's bytes — trailing bytes are left untouched (no over-read, no
+    /// under-read).
+    #[cfg_attr(miri, ignore)]
+    #[hegel::test]
+    fn hegel_write_read_roundtrip_consumes_exactly(tc: hegel::TestCase) {
+        use hegel::generators;
+        let n_segments = tc.draw(generators::integers::<usize>().min_value(1).max_value(7));
+        let mut segments: alloc::vec::Vec<alloc::vec::Vec<crate::Word>> =
+            alloc::vec::Vec::new();
+        for _ in 0..n_segments {
+            let raw: alloc::vec::Vec<u64> =
+                tc.draw(generators::vecs(generators::integers::<u64>()).max_size(20));
+            segments.push(
+                raw.iter()
+                    .map(|w| {
+                        let b = w.to_le_bytes();
+                        crate::word(b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7])
+                    })
+                    .collect(),
+            );
+        }
+        let mut bytes: alloc::vec::Vec<u8> = alloc::vec::Vec::new();
+        write_message_segments(&mut bytes, &segments);
+        let junk: alloc::vec::Vec<u8> = tc.draw(generators::binary().max_size(32));
+        bytes.extend_from_slice(&junk);
+
+        // Copy into 8-byte-aligned storage.
+        let mut words = crate::Word::allocate_zeroed_vec(bytes.len().div_ceil(8));
+        crate::Word::words_to_bytes_mut(&mut words)[..bytes.len()].copy_from_slice(&bytes);
+        let buf = &crate::Word::words_to_bytes(&words)[..bytes.len()];
+
+        let mut slice = buf;
+        let msg = read_message_from_flat_slice(&mut slice, message::ReaderOptions::new())
+            .expect("reading back a just-written message should succeed");
+        assert_eq!(slice, &junk[..], "reader did not consume exactly the message");
+        let result_segments = msg.into_segments();
+        assert_eq!(result_segments.len(), n_segments);
+        for (i, segment) in segments.iter().enumerate() {
+            assert_eq!(
+                crate::Word::words_to_bytes(&segment[..]),
+                result_segments
