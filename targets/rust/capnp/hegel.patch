+/// A message word biased toward valid-looking pointers: null words, struct
+/// pointers, list pointers, and fully arbitrary words. Small offsets and
+/// sizes keep a useful fraction of the generated messages traversable, which
+/// is what the canonicalization property below needs.
+#[cfg(feature = "alloc")]
+fn draw_plausible_word(tc: &hegel::TestCase) -> capnp::Word {
+    use hegel::generators;
+    match tc.draw(generators::integers::<u8>().max_value(3)) {
+        0 => {
+            // Null word.
+            capnp::word(0, 0, 0, 0, 0, 0, 0, 0)
+        }
+        1 => {
+            // Struct pointer: kind 0, small signed offset, small sections.
+            let offset = tc.draw(generators::integers::<i32>().min_value(-4).max_value(4));
+            let data_words = tc.draw(generators::integers::<u16>().max_value(3));
+            let pointer_words = tc.draw(generators::integers::<u16>().max_value(3));
+            let low = (offset as u32) << 2; // kind bits 00 = struct
+            let high = (data_words as u32) | ((pointer_words as u32) << 16);
+            let l = low.to_le_bytes();
+            let h = high.to_le_bytes();
+            capnp::word(l[0], l[1], l[2], l[3], h[0], h[1], h[2], h[3])
+        }
+        2 => {
+            // List pointer: kind 1, small offset, any element size, small count.
+            let offset = tc.draw(generators::integers::<i32>().min_value(-4).max_value(4));
+            let elem_size = tc.draw(generators::integers::<u32>().max_value(7));
+            let count = tc.draw(generators::integers::<u32>().max_value(24));
+            let low = ((offset as u32) << 2) | 1;
+            let high = (count << 3) | elem_size;
+            let l = low.to_le_bytes();
+            let h = high.to_le_bytes();
+            capnp::word(l[0], l[1], l[2], l[3], h[0], h[1], h[2], h[3])
+        }
+        _ => {
+            // Fully arbitrary word.
+            let b = tc.draw(generators::integers::<u64>()).to_le_bytes();
+            capnp::word(b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7])
+        }
+    }
+}
