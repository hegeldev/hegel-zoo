+/// Property: canonicalization is a fixpoint. For any message that
+/// canonicalizes successfully, the canonical form must (a) report itself as
+/// canonical, (b) re-canonicalize to exactly the same words, and (c) if the
+/// original message was already canonical, equal the original words.
+#[cfg(feature = "alloc")]
+#[hegel::test]
+fn hegel_canonicalize_is_fixpoint(tc: hegel::TestCase) {
+    use hegel::generators;
+    let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(12));
+    let words: Vec<capnp::Word> = (0..n).map(|_| draw_plausible_word(&tc)).collect();
+
+    let segments = &[capnp::Word::words_to_bytes(&words)];
+    let segment_array = message::SegmentArray::new(segments);
+    let msg = message::Reader::new(segment_array, Default::default());
+
+    let maybe_is_canonical = msg.is_canonical();
+
+    // Guard: arbitrary pointer soup often fails to traverse; that is fine.
+    // (Null roots and small in-bounds struct roots keep this branch live.)
+    let Ok(canonical_words) = msg.canonicalize() else {
+        return;
+    };
+
+    let canonical_segments = &[capnp::Word::words_to_bytes(&canonical_words)];
+    let canonical_segment_array = message::SegmentArray::new(canonical_segments);
+    let canonical_msg = message::Reader::new(canonical_segment_array, Default::default());
+
+    assert!(
+        canonical_msg.is_canonical().unwrap(),
+        "canonicalize() produced a non-canonical message"
+    );
+    let canonical_again = canonical_msg.canonicalize().unwrap();
+    assert_eq!(
+        canonical_words, canonical_again,
+        "canonicalize() is not a fixpoint"
+    );
+
+    if let Ok(true) = maybe_is_canonical {
+        assert_eq!(
+            &canonical_words[..],
+            &words[..],
+            "message reported canonical but canonicalize() changed it"
+        );
+    }
+}
