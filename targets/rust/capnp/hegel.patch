+        }
+    }
+
+    /// Property: data written through the low-level builder API (a primitive
+    /// list and a text root) survives serialization and is recovered exactly
+    /// by the reader.
+    #[cfg_attr(miri, ignore)]
+    #[hegel::test]
+    fn hegel_builder_write_read_roundtrip(tc: hegel::TestCase) {
+        use hegel::generators;
+        // Primitive list root. Draw the length separately so that large,
