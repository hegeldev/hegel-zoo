+/// Property: a message crafted as a deep chain of struct pointers is handled
+/// by the default `ReaderOptions::nesting_limit` (64): traversal returns an
+/// error for chains deeper than the limit instead of overflowing the stack,
+/// and succeeds for chains within the limit.
+#[hegel::test]
+fn hegel_deep_pointer_chain_hits_nesting_limit(tc: hegel::TestCase) {
+    use hegel::generators;
+    // Sweep the boundary region densely and go far past it. Depths in the
+    // thousands are exactly where an unenforced limit would abort the process
+    // with a stack overflow, so they must be drawn deliberately.
+    let depth: usize = tc.draw(hegel::one_of!(
+        generators::integers::<usize>().min_value(1).max_value(130),
+        generators::integers::<usize>().min_value(131).max_value(20_000),
+    ));
+
+    // Each word is a struct pointer with offset 0 (body immediately follows),
+    // no data words, and one pointer field -- so word N's pointer section is
+    // word N+1, forming a chain. The final word is a null pointer.
+    let mut words: Vec<capnp::Word> = Vec::with_capacity(depth + 1);
+    for _ in 0..depth {
+        words.push(capnp::word(0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00));
+    }
+    words.push(capnp::word(0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00));
+
+    let segments = &[capnp::Word::words_to_bytes(&words)];
+    let segment_array = capnp::message::SegmentArray::new(segments);
+    let message = capnp::message::Reader::new(segment_array, Default::default());
+    let root: capnp::any_pointer::Reader = message.get_root().unwrap();
+
+    // Must return (Ok or Err) rather than crash, at any depth.
+    let result = root.target_size();
+
+    // A chain of depth == nesting_limit is still accepted (the limit counts
+    // pointer follows); the first rejected depth is nesting_limit + 1.
+    let nesting_limit = capnp::message::DEFAULT_READER_OPTIONS.nesting_limit as usize;
+    if depth <= nesting_limit {
+        assert!(
+            result.is_ok(),
+            "chain of depth {depth} (<= nesting limit {nesting_limit}) was rejected: {:?}",
+            result.err()
+        );
+    } else {
+        assert!(
+            result.is_err(),
+            "chain of depth {depth} (> nesting limit {nesting_limit}) was accepted"
+        );
+    }
