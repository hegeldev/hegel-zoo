+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use hegel::generators::{self, Generator};
+
+use crate::{Config, Matcher, Utf32Str};
+
+/// Pattern strings biased toward the special syntax (`!`, `^`, `'`, `$`,
+/// escapes, whitespace of several kinds) mixed with matchable content.
+#[hegel::composite]
+fn pattern_string(tc: &hegel::TestCase) -> String {
+    tc.draw(hegel::one_of!(
+        generators::text().max_size(12).boxed(),
+        generators::vecs(generators::sampled_from(vec![
+            'a', 'b', 'A', '1', '!', '^', '\'', '$', '\\', ' ', '\t', '\n', '\u{3000}', 'ä',
+            'Ä', '你', '/',
+        ]))
+        .max_size(12)
+        .map(|v| v.into_iter().collect::<String>())
+        .boxed(),
+    ))
+}
+
+#[hegel::composite]
+fn haystack_item(tc: &hegel::TestCase) -> String {
+    tc.draw(
+        generators::vecs(generators::sampled_from(vec![
+            'a', 'b', 'A', 'B', '1', ' ', '/', '!', '^', '$', '\'', 'ä', '你',
+        ]))
+        .max_size(12),
+    )
+    .into_iter()
+    .collect()
+}
+
+/// `Pattern::parse` accepts arbitrary input without panicking, and
+/// `match_list` is consistent with `Pattern::score`: it returns exactly the
+/// items that score `Some`, with their scores, sorted in descending order.
+#[hegel::test]
+fn prop_pattern_parse_and_match_list_consistent(tc: hegel::TestCase) {
+    let pattern_str = tc.draw(pattern_string());
+    let case = tc.draw((generators::sampled_from(vec![
+        CaseMatching::Respect,
+        CaseMatching::Ignore,
+        CaseMatching::Smart,
+    ])).print_as_debug());
+    let norm = tc.draw((generators::sampled_from(vec![
+        Normalization::Never,
+        Normalization::Smart,
+    ])).print_as_debug());
+    let pattern = Pattern::parse(&pattern_str, case, norm);
+    let items: Vec<String> = tc.draw(generators::vecs(haystack_item()).max_size(6));
+    let mut matcher = Matcher::new(Config::DEFAULT);
+    let matches = pattern.match_list(items.iter().map(|s| s.as_str()), &mut matcher);
+    // sorted by score, descending
+    assert!(
+        matches.windows(2).all(|w| w[0].1 >= w[1].1),
+        "match_list result not sorted by descending score: {matches:?}"
+    );
+    // scores agree with Pattern::score, and left-out items really don't match
+    let mut buf = Vec::new();
+    for &(item, score) in &matches {
+        assert_eq!(
+            pattern.score(Utf32Str::new(item, &mut buf), &mut matcher),
+            Some(score),
+            "match_list score for {item:?} disagrees with Pattern::score"
+        );
+    }
+    for item in &items {
+        if !matches.iter().any(|(m, _)| *m == item.as_str()) {
+            assert_eq!(
+                pattern.score(Utf32Str::new(item, &mut buf), &mut matcher),
+                None,
+                "{item:?} was omitted by match_list but scores Some"
+            );
+        }
+    }
+}
+
+/// `Pattern::score` of a multi-atom pattern is the sum of its atoms' scores
+/// (and `None` as soon as one atom fails) -- this is how the docs describe
+/// multi-word matching.
+#[hegel::test]
+fn prop_pattern_score_is_sum_of_atom_scores(tc: hegel::TestCase) {
+    let pattern_str = tc.draw(pattern_string());
+    let pattern = Pattern::parse(&pattern_str, CaseMatching::Smart, Normalization::Smart);
+    let item = tc.draw(haystack_item());
+    let mut matcher = Matcher::new(Config::DEFAULT);
+    let mut buf = Vec::new();
+    let total = pattern.score(Utf32Str::new(&item, &mut buf), &mut matcher);
+    let mut sum: Option<u32> = Some(0);
+    for atom in &pattern.atoms {
+        let mut buf = Vec::new();
+        match (sum, atom.score(Utf32Str::new(&item, &mut buf), &mut matcher)) {
+            (Some(s), Some(a)) => sum = Some(s + a as u32),
+            _ => sum = None,
+        }
+        if sum.is_none() {
+            break;
+        }
+    }
+    assert_eq!(total, sum, "pattern score != sum of atom scores for {item:?}");
+}
