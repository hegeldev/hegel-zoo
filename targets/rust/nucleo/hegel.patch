+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+/// Strings mixing plain ASCII, windows newlines, combining marks and
+/// multi-codepoint graphemes (the cases the `Utf32Str` docs call out).
+#[hegel::composite]
+fn tricky_string(tc: &hegel::TestCase) -> String {
+    use hegel::generators::{self, Generator};
+    tc.draw(hegel::one_of!(
+        generators::text().max_size(30).boxed(),
+        generators::vecs(generators::sampled_from(vec![
+            'a', 'b', 'A', ' ', '\t', '\n', '\r', 'ä', 'u', '\u{308}', '\u{301}', '你', '🇩',
+            '🇪', '\u{200d}',
+        ]))
+        .max_size(30)
+        .map(|v| v.into_iter().collect::<String>())
+        .boxed(),
+    ))
+}
+
+/// Documented guarantee 3 of `Utf32Str`: the length of a `Utf32Str(ing)`
+/// constructed from a string is exactly the number of graphemes in it.
+#[cfg(feature = "unicode-segmentation")]
+#[hegel::test]
+fn prop_utf32_len_is_grapheme_count(tc: hegel::TestCase) {
+    use unicode_segmentation::UnicodeSegmentation;
+    let s = tc.draw(tricky_string());
+    let expected = s.graphemes(true).count();
+    assert_eq!(
+        Utf32String::from(s.as_str()).len(),
+        expected,
+        "Utf32String::from({s:?}) length != grapheme count"
+    );
+    let mut buf = Vec::new();
+    assert_eq!(
+        Utf32Str::new(&s, &mut buf).len(),
+        expected,
+        "Utf32Str::new({s:?}) length != grapheme count"
+    );
+}
+
+/// Documented guarantees 1 and 2 of `Utf32Str`: a string of ASCII graphemes
+/// (ASCII without "\r\n") produces the `Ascii` variant holding exactly the
+/// original string; everything else produces the `Unicode` variant.
+#[hegel::test]
+fn prop_utf32_ascii_variant_iff_ascii_graphemes(tc: hegel::TestCase) {
+    let s = tc.draw(tricky_string());
+    let ascii_graphemes = s.is_ascii() && !s.contains("\r\n");
+    let utf32 = Utf32String::from(s.as_str());
+    assert_eq!(
+        utf32.slice(..).is_ascii(),
+        ascii_graphemes,
+        "wrong variant for {s:?}"
+    );
+    if ascii_graphemes {
+        assert_eq!(utf32.to_string(), s, "Ascii variant must roundtrip");
+    }
+}
