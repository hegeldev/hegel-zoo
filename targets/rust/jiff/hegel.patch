+# Make hegeltest's `jiff` integration generate types from this workspace's
+# `jiff` rather than a second copy from crates.io. Without this, hegel's
+# typed jiff generators would produce values of a *different* crate instance
+# than the one under test, and nothing would type-check.
+[patch.crates-io]
+jiff = { path = "crates/jiff" }
+
 [workspace.package]
 authors = ["Andrew Gallant <jamslam@gmail.com>"]
 edition = "2021"
