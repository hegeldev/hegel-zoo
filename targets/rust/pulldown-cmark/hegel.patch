+    /// Hegel property-based tests. See also tests/errors.rs for the
+    /// robustness properties (no-panic, offsets, tag balance, nesting DoS).
+    mod hegel_props {
+        use alloc::{format, string::String, vec::Vec};
+
+        use hegel::generators::{self};
+
+        use super::*;
+
+        /// Property: for paragraphs of plain text (no markdown-significant
+        /// characters, no leading/trailing spaces per line), the parser
+        /// preserves the text exactly: concatenating `Text` events with a
+        /// newline at each `SoftBreak` reconstructs the input.
+        #[hegel::test]
+        fn plain_text_paragraph_content_is_preserved(tc: hegel::TestCase) {
+            // Lines of [A-Za-z0-9 ] that start and end with an alphanumeric:
+            // no construct in CommonMark (or any extension enabled below) can
+            // trigger on this alphabet, so the input must parse as a single
+            // paragraph whose text is preserved verbatim.
+            let lines: Vec<String> = tc.draw(
+                generators::vecs(
+                    generators::from_regex(r"[A-Za-z0-9]([A-Za-z0-9 ]{0,18}[A-Za-z0-9])?")
+                        .fullmatch(true),
+                )
+                .min_size(1)
+                .max_size(6),
+            );
+            let input = lines.join("\n");
+            let mut reconstructed = String::new();
+            for event in Parser::new(&input) {
+                match event {
+                    Event::Start(Tag::Paragraph) | Event::End(TagEnd::Paragraph) => {}
+                    Event::Text(t) => reconstructed.push_str(&t),
+                    Event::SoftBreak => reconstructed.push('\n'),
+                    other => panic!("unexpected event {other:?} for plain text {input:?}"),
+                }
+            }
+            assert_eq!(reconstructed, input);
+        }
+
+        /// Property: `#` runs of length 1..=6 followed by a space produce an
+        /// ATX heading of exactly that level (spec: ATX headings); longer
+        /// runs are not headings at all.
+        #[hegel::test]
+        fn atx_heading_level_matches_hash_count(tc: hegel::TestCase) {
+            let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(12));
+            let word: String =
+                tc.draw(generators::from_regex(r"[A-Za-z0-9]{1,8}").fullmatch(true));
+            let input = format!("{} {}", "#".repeat(n), word);
+            let events: Vec<_> = Parser::new(&input).collect();
+            if n <= 6 {
+                match &events[..] {
+                    [Event::Start(Tag::Heading { level, .. }), Event::Text(text), Event::End(TagEnd::Heading(end_level))] =>
+                    {
+                        assert_eq!(*level as usize, n);
+                        assert_eq!(*end_level, *level);
+                        assert_eq!(text.as_ref(), word);
+                    }
+                    other => panic!("expected heading events for {input:?}, got {other:?}"),
+                }
+            } else {
+                assert!(
+                    events
+                        .iter()
+                        .all(|e| !matches!(e, Event::Start(Tag::Heading { .. }))),
+                    "{n} hashes must not create a heading: {events:?}",
+                );
+            }
+        }
+    }
 }
diff --git a/pulldown-cmark/src/utils.rs b/pulldown-cmark/src/utils.rs
index 829813e..fed36ff 100644
--- a/pulldown-cmark/src/utils.rs
+++ b/pulldown-cmark/src/utils.rs
@@ -182,4 +182,64 @@ mod test {
         let result: Vec<_> = TextMergeStream::new(events.into_iter()).collect();
         assert_eq!(result, [Event::Rule, Event::Rule]);
     }
+
+    /// Hegel property: `TextMergeStream` agrees with a straightforward
+    /// reference model of its documented behavior — runs of two or more
+    /// consecutive `Text` events are merged into one (and dropped entirely if
+    /// the merged text is empty), everything else passes through unchanged.
+    /// In particular the merged stream never contains two adjacent `Text`
+    /// events.
+    #[hegel::test]
+    fn text_merge_stream_matches_reference_model(tc: hegel::TestCase) {
+        use alloc::string::String;
+
+        use hegel::generators::{self};
+
+        use crate::{Options, Parser};
+
+        let input: String = tc.draw(generators::text().max_size(300));
+        let options = Options::from_bits_truncate(tc.draw(generators::integers::<u32>()));
+
+        let raw: Vec<Event<'_>> = Parser::new_ext(&input, options).collect();
+        let merged: Vec<Event<'_>> =
+            TextMergeStream::new(Parser::new_ext(&input, options)).collect();
+
+        // Reference model: fold runs of consecutive Text events.
+        let mut expected: Vec<Event<'_>> = Vec::new();
+        let mut i = 0;
+        while i < raw.len() {
+            if matches!(raw[i], Event::Text(_)) {
+                let mut j = i + 1;
+                while j < raw.len() && matches!(raw[j], Event::Text(_)) {
+                    j += 1;
+                }
+                if j - i == 1 {
+                    // A lone Text event passes through unchanged, even if empty.
+                    expected.push(raw[i].clone());
+                } else {
+                    let mut s = String::new();
+                    for event in &raw[i..j] {
+                        if let Event::Text(t) = event {
+                            s.push_str(t);
+                        }
+                    }
+                    if !s.is_empty() {
+                        expected.push(Event::Text(CowStr::Boxed(s.into_boxed_str())));
+                    }
+                }
+                i = j;
+            } else {
+                expected.push(raw[i].clone());
+                i += 1;
+            }
+        }
+
+        assert_eq!(merged, expected, "input: {input:?}, options: {options:?}");
+        for pair in merged.windows(2) {
+            assert!(
+                !(matches!(pair[0], Event::Text(_)) && matches!(pair[1], Event::Text(_))),
+                "adjacent Text events survived merging: {pair:?}",
+            );
+        }
+    }
 }
diff --git a/pulldown-cmark/tests/errors.rs b/pulldown-cmark/tests/errors.rs
index c5055f5..f4a913a 100644
--- a/pulldown-cmark/tests/errors.rs
+++ b/pulldown-cmark/tests/errors.rs
@@ -143,3 +143,536 @@ fn test_bad_slice_unicode() {
 fn test_simd_wrapping_shr_issue_651() {
     parse("`````````````````````````````````x`");
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+//
+// These generalize the hand-written "dont crash" regressions above: instead of
+// pinning single fuzzer-found inputs, they draw arbitrary and markdown-shaped
+// inputs (together with arbitrary `Options` combinations, mirroring
+// fuzz/fuzz_targets/parse.rs) and assert the parser's basic robustness
+// contracts: no panics, valid offsets, balanced tags, and bounded parse time
+// on deeply nested input.
+// ---------------------------------------------------------------------------
+
+use hegel::generators::{self, Generator};
+use pulldown_cmark::{Event, TagEnd};
+use std::ops::Range;
+use std::time::{Duration, Instant};
+
+/// Draw an arbitrary set of parser options, including combinations that no
+/// canned test uses. Mirrors the `from_bits_truncate` trick used by the
+/// libfuzzer target in fuzz/fuzz_targets/parse.rs.
+fn draw_arbitrary_options(tc: &hegel::TestCase) -> Options {
+    Options::from_bits_truncate(tc.draw(generators::integers::<u32>()))
+}
+
+/// A "markdown soup": concatenation of markdown-significant tokens and short
+/// text runs. Unlike fully arbitrary text, nearly every draw exercises block
+/// and inline structure; unlike the structured document generator below, it
+/// also produces *malformed* structure (unclosed fences, stray delimiters).
+fn draw_markdown_soup(tc: &hegel::TestCase) -> String {
+    let tokens: Vec<&str> = tc.draw(
+        generators::vecs(generators::sampled_from(vec![
+            "#", "######", ">", "- ", "+ ", "1.", "7)", "*", "**", "_", "__", "`", "``", "```",
+            "~~~", "[", "]", "(", ")", "![", "|", "---", "***", "___", "===", "+++", ":::", ":",
+            "~~", "==", "^", "~", "$", "$$", "[^a]", "[^a]:", "[x]", "[ ]", "[[", "]]",
+            "<div>", "</div>", "<br/>", "<!--", "-->", "<?php", "<a href=\"", "\">",
+            "&amp;", "&#x41;", "&#0;", "\\", "\\*", "  \n", "\n", "\n\n", "\r\n", " ", "\t",
+            "a", "foo", "{#id}", "{.class}", "www.example.com", "http://a.b", "user@example.com",
+            "\u{0}", "\u{c}", "\u{feff}", "é", "日本語", "\u{2028}",
+        ]))
+        .max_size(40),
+    );
+    tokens.concat()
+}
+
+/// Structured, mostly well-formed markdown documents covering the block and
+/// inline constructs of CommonMark plus every extension this crate ships.
+fn draw_inline(tc: &hegel::TestCase) -> String {
+    let mut s: String = tc.draw(hegel::one_of!(
+        generators::from_regex(r"[A-Za-z0-9]{1,8}").fullmatch(true),
+        generators::text().max_size(6),
+    ));
+    let wraps = tc.draw(generators::integers::<u8>().max_value(3));
+    for _ in 0..wraps {
+        let kind = tc.draw(generators::integers::<u8>().max_value(16));
+        s = match kind {
+            0 => format!("*{s}*"),
+            1 => format!("**{s}**"),
+            2 => format!("_{s}_"),
+            3 => format!("`{s}`"),
+            4 => format!("~~{s}~~"),
+            5 => format!("=={s}=="),
+            6 => format!("^{s}^"),
+            7 => format!("~{s}~"),
+            8 => format!("[{s}](https://example.com \"title\")"),
+            9 => format!("[{s}][ref]"),
+            10 => format!("![{s}](img.png)"),
+            11 => format!("[[{s}]]"),
+            12 => format!("${s}$"),
+            13 => format!("$${s}$$"),
+            14 => format!("<span>{s}</span>"),
+            15 => format!("{s}[^fn1]"),
+            _ => format!("{s} &amp; \\* <https://example.com>"),
+        };
+    }
+    s
+}
+
+fn draw_block(tc: &hegel::TestCase) -> String {
+    let kind = tc.draw(generators::integers::<u8>().max_value(14));
+    match kind {
+        0 => {
+            // ATX heading, possibly with heading attributes; level 7 is
+            // deliberately included (not a heading per spec).
+            let level = tc.draw(generators::integers::<usize>().min_value(1).max_value(7));
+            let attrs = if tc.draw(generators::booleans()) {
+                " {#id .class1 .class2 key=value}"
+            } else {
+                ""
+            };
+            format!("{} {}{}", "#".repeat(level), draw_inline(tc), attrs)
+        }
+        1 => {
+            // Setext heading.
+            let underline = if tc.draw(generators::booleans()) { "=" } else { "-" };
+            let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+            format!("{}\n{}", draw_inline(tc), underline.repeat(n))
+        }
+        2 => {
+            // Paragraph of 1-3 lines.
+            let nlines = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+            let mut lines = Vec::new();
+            for _ in 0..nlines {
+                lines.push(draw_inline(tc));
+            }
+            lines.join("\n")
+        }
+        3 => {
+            // Fenced code block (sometimes unclosed, sometimes with info string).
+            let fence = if tc.draw(generators::booleans()) { "```" } else { "~~~" };
+            let info = if tc.draw(generators::booleans()) { "rust" } else { "" };
+            let close = if tc.draw(generators::booleans()) {
+                format!("\n{fence}")
+            } else {
+                String::new()
+            };
+            format!("{fence}{info}\nfn main() {{}}{close}")
+        }
+        4 => {
+            // Indented code block.
+            format!("    {}\n    {}", draw_inline(tc), draw_inline(tc))
+        }
+        5 => {
+            // Blockquote, possibly a GFM alert, possibly nested.
+            let tag = tc.draw(generators::sampled_from(vec![
+                "", "[!NOTE]\n> ", "[!TIP]\n> ", "[!IMPORTANT]\n> ", "[!WARNING]\n> ", "[!CAUTION]\n> ",
+            ]));
+            let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+            format!("{}{}{}", "> ".repeat(depth), tag, draw_inline(tc))
+        }
+        6 => {
+            // List (bullet or ordered), task-list markers, one nesting level.
+            let marker = tc.draw(generators::sampled_from(vec!["- ", "* ", "+ ", "1. ", "7) "]));
+            let task = tc.draw(generators::sampled_from(vec!["", "[ ] ", "[x] "]));
+            let nitems = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+            let mut items = Vec::new();
+            for _ in 0..nitems {
+                items.push(format!("{marker}{task}{}", draw_inline(tc)));
+                if tc.draw(generators::booleans()) {
+                    items.push(format!("  {marker}{}", draw_inline(tc)));
+                }
+            }
+            items.join("\n")
+        }
+        7 => {
+            // Table with drawn alignments.
+            let ncols = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+            let mut header = String::from("|");
+            let mut delim = String::from("|");
+            let mut row = String::from("|");
+            for _ in 0..ncols {
+                header.push_str(&format!("{}|", draw_inline(tc)));
+                let align = tc.draw(generators::sampled_from(vec!["---", ":--", "--:", ":-:"]));
+                delim.push_str(&format!("{align}|"));
+                row.push_str(&format!("{}|", draw_inline(tc)));
+            }
+            format!("{header}\n{delim}\n{row}")
+        }
+        8 => {
+            // Thematic break.
+            tc.draw(generators::sampled_from(vec!["---", "***", "___", " - - -"]))
+                .to_string()
+        }
+        9 => {
+            // HTML block.
+            format!("<div class=\"x\">\n{}\n</div>", draw_inline(tc))
+        }
+        10 => {
+            // Footnote definition plus a referencing paragraph.
+            format!("here[^fn1] and there\n\n[^fn1]: {}", draw_inline(tc))
+        }
+        11 => {
+            // Link reference definition (used by the `[..][ref]` inline).
+            "[ref]: https://example.com \"a title\"".to_string()
+        }
+        12 => {
+            // Definition list.
+            format!("{}\n: {}\n: {}", draw_inline(tc), draw_inline(tc), draw_inline(tc))
+        }
+        13 => {
+            // Container extension block (sometimes unclosed).
+            let close = if tc.draw(generators::booleans()) { "\n:::" } else { "" };
+            format!(":::spoiler\n{}{close}", draw_inline(tc))
+        }
+        _ => {
+            // Display math block.
+            format!("$$\n{}\n$$", draw_inline(tc))
+        }
+    }
+}
+
+fn draw_markdown_document(tc: &hegel::TestCase) -> String {
+    let mut doc = String::new();
+    // Metadata block (only meaningful at the very start of the document).
+    match tc.draw(generators::integers::<u8>().max_value(3)) {
+        0 => doc.push_str("---\ntitle: test\n---\n\n"),
+        1 => doc.push_str("+++\ntitle = \"test\"\n+++\n\n"),
+        _ => {}
+    }
+    let nblocks = tc.draw(generators::integers::<usize>().min_value(1).max_value(6));
+    let mut blocks = Vec::new();
+    for _ in 0..nblocks {
+        blocks.push(draw_block(tc));
+    }
+    // Single newline separation creates lazy continuations and interrupted
+    // blocks; double newline creates well-separated blocks.
+    let sep = if tc.draw(generators::booleans()) { "\n\n" } else { "\n" };
+    doc.push_str(&blocks.join(sep));
+    if tc.draw(generators::booleans()) {
+        doc.push('\n');
+    }
+    doc
+}
+
+/// Property: fully consuming `Parser::new_ext` never panics, for arbitrary
+/// Unicode text and arbitrary option combinations.
+#[hegel::test(test_cases = 200)]
+fn parse_never_panics_on_arbitrary_input(tc: hegel::TestCase) {
+    let text: String = tc.draw(hegel::one_of!(
+        generators::text().max_size(400).boxed(),
+        hegel::compose!(|tc| { draw_markdown_soup(&tc) }).boxed(),
+    ));
+    let opts = draw_arbitrary_options(&tc);
+    for _ in Parser::new_ext(&text, opts) {}
+}
+
+/// Property: fully consuming `Parser::new_ext` never panics on structured,
+/// mostly well-formed markdown documents exercising all extensions.
+#[hegel::test(test_cases = 200)]
+fn parse_never_panics_on_markdown_shaped_input(tc: hegel::TestCase) {
+    let doc = draw_markdown_document(&tc);
+    let opts = draw_arbitrary_options(&tc);
+    for _ in Parser::new_ext(&doc, opts) {}
+}
+
+/// Property: every event's source range is in-bounds and lies on UTF-8
+/// character boundaries, so `&text[range]` is always a valid slice. This is
+/// the general form of the `test_bad_slice_*` regressions above (issue #521).
+#[hegel::test(test_cases = 200)]
+fn offset_iter_ranges_are_valid_slices(tc: hegel::TestCase) {
+    let text: String = tc.draw(hegel::one_of!(
+        generators::text().max_size(300).boxed(),
+        hegel::compose!(|tc| { draw_markdown_soup(&tc) }).boxed(),
+        hegel::compose!(|tc| { draw_markdown_document(&tc) }).boxed(),
+    ));
+    let opts = draw_arbitrary_options(&tc);
+    for (event, range) in Parser::new_ext(&text, opts).into_offset_iter() {
+        assert!(
+            range.start <= range.end && range.end <= text.len(),
+            "out-of-bounds range {range:?} (len {}) for event {event:?}",
+            text.len(),
+        );
+        assert!(
+            text.get(range.clone()).is_some(),
+            "range {range:?} not on char boundaries for event {event:?}",
+        );
+    }
+}
+
+/// Property: Start/End events are properly balanced (LIFO, matching kinds,
+/// nothing left open at EOF), every event is contained in the source range of
+/// its enclosing Start tag, and an End event carries the same range as its
+/// matching Start.
+#[hegel::test(test_cases = 200)]
+fn start_end_events_are_balanced_and_nested(tc: hegel::TestCase) {
+    let text: String = tc.draw(hegel::one_of!(
+        generators::text().max_size(300).boxed(),
+        hegel::compose!(|tc| { draw_markdown_soup(&tc) }).boxed(),
+        hegel::compose!(|tc| { draw_markdown_document(&tc) }).boxed(),
+    ));
+    let opts = draw_arbitrary_options(&tc);
+    let mut stack: Vec<(TagEnd, Range<usize>)> = Vec::new();
+    for (event, range) in Parser::new_ext(&text, opts).into_offset_iter() {
+        match event {
+            Event::Start(tag) => {
+                if let Some((_, enclosing)) = stack.last() {
+                    assert!(
+                        enclosing.start <= range.start && range.end <= enclosing.end,
+                        "Start range {range:?} escapes enclosing {enclosing:?} in {text:?}",
+                    );
+                }
+                stack.push((tag.to_end(), range));
+            }
+            Event::End(end) => {
+                let (expected, start_range) = stack
+                    .pop()
+                    .unwrap_or_else(|| panic!("End({end:?}) without matching Start in {text:?}"));
+                assert_eq!(
+                    end, expected,
+                    "End kind does not match innermost Start in {text:?}",
+                );
+                assert_eq!(
+                    range, start_range,
+                    "End range differs from matching Start range in {text:?}",
+                );
+            }
+            // KNOWN BUG exclusion: TaskListMarker ranges can escape their
+            // enclosing tag when the item's paragraph is re-interpreted as a
+            // setext heading. Pinned by
+            // known_bug_task_list_marker_escapes_setext_heading_range below.
+            Event::TaskListMarker(_) => {}
+            _ => {
+                if let Some((_, enclosing)) = stack.last() {
+                    assert!(
+                        enclosing.start <= range.start && range.end <= enclosing.end,
+                        "event range {range:?} escapes enclosing {enclosing:?} in {text:?}",
+                    );
+                }
+            }
+        }
+    }
+    assert!(
+        stack.is_empty(),
+        "unclosed tags at EOF: {stack:?} in {text:?}",
+    );
+}
+
+/// KNOWN FAILURE — real bug found by `start_end_events_are_balanced_and_nested`.
+///
+/// When the paragraph starting a task-list item is re-interpreted as a setext
+/// heading by its continuation line (here `  - `, which is both a nested list
+/// marker and a setext underline; `  ===` behaves the same), the parser still
+/// emits a `TaskListMarker` event, and emits it *between* the heading's Start
+/// and End even though the marker's source range (2..5, the `[ ]`) lies
+/// entirely before the heading's own range (6..12, the `a\n  - `). Sourcemap
+/// consumers see a child event whose range escapes its enclosing tag.
+///
+/// Semantically it is also questionable: per the GFM spec a task-list item
+/// marker only exists "if the first block in the item is a paragraph", so no
+/// marker should be emitted here at all; the rendered HTML ends up with an
+/// `<input type="checkbox">` inside `<h2>`.
+///
+/// This test pins the offset invariant violation deterministically and is
+/// EXPECTED TO FAIL until the bug is fixed. Do not "fix" the test.
+#[test]
+fn known_bug_task_list_marker_escapes_setext_heading_range() {
+    let text = "- [ ] a\n  - ";
+    let mut stack: Vec<Range<usize>> = Vec::new();
+    for (event, range) in
+        Parser::new_ext(text, Options::ENABLE_TASKLISTS).into_offset_iter()
+    {
+        if let Some(enclosing) = stack.last() {
+            assert!(
+                enclosing.start <= range.start && range.end <= enclosing.end,
+                "event {event:?} range {range:?} escapes enclosing tag range {enclosing:?}",
+            );
+        }
+        match event {
+            Event::Start(_) => stack.push(range),
+            Event::End(_) => {
+                stack.pop();
+            }
+            _ => {}
+        }
+    }
+}
+
+/// Property: parsing deeply nested single-line constructs (blockquotes,
+/// lists, emphasis, link/image/wikilink brackets, code/math delimiters, ...)
+/// terminates in bounded time with a linearly bounded number of events, and
+/// does not overflow the stack. Untrusted-markdown DoS is the classic bug
+/// class here; the dos-fuzzer/ directory exists because of it.
+#[hegel::test(test_cases = 40)]
+fn deeply_nested_input_parses_in_bounded_time(tc: hegel::TestCase) {
+    // (opening unit, closing unit, max repetition count). Multi-byte units get
+    // a lower cap so input size stays comparable (~30KiB max).
+    let constructs: Vec<(&str, &str, usize)> = vec![
+        (">", "", 30_000),   // nested blockquotes
+        ("- ", "", 15_000),  // nested lists on a single line
+        ("*", "*", 15_000),  // nested emphasis
+        ("_", "_", 15_000),
+        ("[", "]", 15_000),  // nested links
+        ("![", "]", 10_000), // nested images
+        ("[[", "]]", 7_500), // nested wikilinks (cf. issue #1111)
+        ("[^", "]", 10_000), // nested footnote references
+        ("`", "", 30_000),   // backtick runs
+        ("<", "", 30_000),   // HTML/autolink open brackets
+        ("~~", "~~", 7_500), // strikethrough
+        ("==", "==", 7_500), // highlight
+        ("^", "", 30_000),   // superscript
+        ("$", "$", 15_000),  // math delimiters
+        ("|", "", 30_000),   // table-ish pipes
+        ("(", ")", 15_000),  // parens (LINK_MAX_NESTED_PARENS guards link dests)
+    ];
+    let idx = tc.draw(generators::integers::<usize>().max_value(constructs.len() - 1));
+    let (open, close, max_depth) = constructs[idx];
+    let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(max_depth));
+    let mut input = open.repeat(depth);
+    input.push('a');
+    input.push_str(&close.repeat(depth));
+
+    let opts = if tc.draw(generators::booleans()) {
+        Options::all()
+    } else {
+        draw_arbitrary_options(&tc)
+    };
+
+    let start = Instant::now();
+    let mut events = 0usize;
+    for _ in Parser::new_ext(&input, opts) {
+        events += 1;
+    }
+    let elapsed = start.elapsed();
+    // Guide generation toward slower inputs.
+    tc.target(elapsed.as_secs_f64());
+    assert!(
+        events <= 16 * input.len() + 64,
+        "superlinear event count: {events} events for {} bytes ({open:?} x {depth})",
+        input.len(),
+    );
+    // Generous cap: a linear parse of <=30KiB takes milliseconds even in
+    // debug builds, so hitting 5s means superlinear blowup (DoS).
+    assert!(
+        elapsed < Duration::from_secs(5),
+        "parse took {elapsed:?} for {} bytes of {open:?} x {depth} (options {opts:?})",
+        input.len(),
+    );
+}
+
+/// Property: same as above, for constructs that nest across *lines*
+/// (indentation-nested lists, increasing blockquote chains, containers,
+/// nested GFM alerts) where input size grows with nesting depth.
+#[hegel::test(test_cases = 25)]
+fn deeply_nested_multiline_input_parses_in_bounded_time(tc: hegel::TestCase) {
+    let kind = tc.draw(generators::integers::<u8>().max_value(3));
+    let input: String = match kind {
+        0 => {
+            // Lists nested by two-space indentation; O(depth^2) input size.
+            let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(250));
+            (0..depth)
+                .map(|i| format!("{}- a\n", "  ".repeat(i)))
+                .collect()
+        }
+        1 => {
+            // Blockquote chain of increasing depth; O(depth^2) input size.
+            let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(250));
+            (1..=depth)
+                .map(|i| format!("{}a\n", "> ".repeat(i)))
+                .collect()
+        }
+        2 => {
+            // Unclosed container extension blocks.
+            let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(6_000));
+            ":::a\n".repeat(depth)
+        }
+        _ => {
+            // Nested GFM alert blockquotes.
+            let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(3_000));
+            let mut s: String = (1..=depth).map(|i| format!("{}[!NOTE]\n", ">".repeat(i))).collect();
+            s.push('a');
+            s
+        }
+    };
+    let opts = Options::all();
+
+    let start = Instant::now();
+    let mut events = 0usize;
+    for _ in Parser::new_ext(&input, opts) {
+        events += 1;
+    }
+    let elapsed = start.elapsed();
+    tc.target(elapsed.as_secs_f64());
+    assert!(
+        events <= 16 * input.len() + 64,
+        "superlinear event count: {events} events for {} bytes (kind {kind})",
+        input.len(),
+    );
+    assert!(
+        elapsed < Duration::from_secs(5),
+        "parse took {elapsed:?} for {} bytes of nesting kind {kind}",
+        input.len(),
+    );
+}
+
+/// Property: repeating a short adversarial pattern many times (the axis the
+/// dos-fuzzer/ tool explores, and the shape of the wikilink event blowup
+/// fixed in #1111) keeps the event count linear in input size and parse time
+/// bounded.
+#[hegel::test(test_cases = 40)]
+fn repeated_pattern_has_linear_event_count_and_bounded_time(tc: hegel::TestCase) {
+    let pattern: String = tc.draw(hegel::one_of!(
+        generators::sampled_from(vec![
+            "[[|]]".to_string(),
+            "[[[[^(\n|]]]]=]]]]]]]]\n".to_string(),
+            "[]([](".to_string(),
+            "*a**".to_string(),
+            "`a``".to_string(),
+            "[^a]:\n".to_string(),
+            "|a|\n".to_string(),
+            "> [!NOTE]\n".to_string(),
+            "$`$$`".to_string(),
+            "a  \n".to_string(),
+        ])
+        .boxed(),
+        hegel::compose!(|tc| {
+            let mut p = draw_markdown_soup(&tc);
+            // Truncate to <=12 bytes on a char boundary (protects the test
+            // code from a mid-char String::truncate panic, not the library).
+            let mut cut = p.len().min(12);
+            while !p.is_char_boundary(cut) {
+                cut -= 1;
+            }
+            p.truncate(cut);
+            p
+        })
+        .boxed(),
+    ));
+    tc.assume(!pattern.is_empty());
+    let reps = tc.draw(generators::integers::<usize>().min_value(1).max_value(2_000));
+    let input = pattern.repeat(reps);
+    let opts = if tc.draw(generators::booleans()) {
+        Options::all()
+    } else {
+        draw_arbitrary_options(&tc)
+    };
+
+    let start = Instant::now();
+    let mut events = 0usize;
+    for _ in Parser::new_ext(&input, opts) {
+        events += 1;
+    }
+    let elapsed = start.elapsed();
+    tc.target(elapsed.as_secs_f64());
+    assert!(
+        events <= 16 * input.len() + 64,
+        "superlinear event count: {events} events for {} bytes ({pattern:?} x {reps})",
+        input.len(),
+    );
+    assert!(
+        elapsed < Duration::from_secs(5),
+        "parse took {elapsed:?} for {} bytes of {pattern:?} x {reps} (options {opts:?})",
+        input.len(),
+    );
+}
