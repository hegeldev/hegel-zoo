+// ---------------------------------------------------------------------------
+// Hegel property-based tests for the HTML renderer.
+// ---------------------------------------------------------------------------
+
+use hegel::generators::{self, Generator};
+
+/// Markdown-significant token soup (see tests/errors.rs for the rationale):
+/// most draws contain structure, including malformed structure.
+fn draw_markdown_soup(tc: &hegel::TestCase) -> String {
+    let tokens: Vec<&str> = tc.draw(
+        generators::vecs(generators::sampled_from(vec![
+            "#", "######", ">", "- ", "1.", "*", "**", "_", "`", "```", "~~~", "[", "]", "(",
+            ")", "![", "|", "---", "===", "+++", ":::", ":", "~~", "==", "^", "~", "$", "$$",
+            "[^a]", "[^a]:", "[x]", "[[", "]]", "<div>", "</div>", "<br/>", "<!--", "-->",
+            "&amp;", "&#x41;", "\\", "  \n", "\n", "\n\n", "\r\n", " ", "\t", "a", "foo",
+            "{#id}", "http://a.b", "\u{0}", "é", "日本語", "\"", "'", "<", ">", "&",
+        ]))
+        .max_size(40),
+    );
+    tokens.concat()
+}
+
+/// Property: `html::push_html` never panics and is deterministic — rendering
+/// the same input with the same options twice yields byte-identical HTML.
+#[hegel::test(test_cases = 200)]
+fn push_html_never_panics_and_is_deterministic(tc: hegel::TestCase) {
+    let text: String = tc.draw(hegel::one_of!(
+        generators::text().max_size(300).boxed(),
+        hegel::compose!(|tc| { draw_markdown_soup(&tc) }).boxed(),
+    ));
+    let options = Options::from_bits_truncate(tc.draw(generators::integers::<u32>()));
+
+    let mut first = String::new();
+    html::push_html(&mut first, Parser::new_ext(&text, options));
+    let mut second = String::new();
+    html::push_html(&mut second, Parser::new_ext(&text, options));
+
+    assert_eq!(first, second, "non-deterministic HTML for {text:?}");
+}
+
+/// Property: `push_html` appends to the provided buffer without disturbing
+/// its existing contents, and `write_html_fmt` produces the same HTML.
+#[hegel::test]
+fn push_html_appends_and_matches_write_html_fmt(tc: hegel::TestCase) {
+    let text: String = tc.draw(hegel::one_of!(
+        generators::text().max_size(300).boxed(),
+        hegel::compose!(|tc| { draw_markdown_soup(&tc) }).boxed(),
+    ));
+    let options = Options::from_bits_truncate(tc.draw(generators::integers::<u32>()));
+    let prefix: String = tc.draw(generators::text().max_size(20));
+
+    let mut pushed = prefix.clone();
+    html::push_html(&mut pushed, Parser::new_ext(&text, options));
+    assert!(
+        pushed.starts_with(&prefix),
+        "push_html disturbed existing buffer contents",
+    );
+
+    let mut written = String::new();
+    html::write_html_fmt(&mut written, Parser::new_ext(&text, options)).unwrap();
+    assert_eq!(
+        pushed[prefix.len()..],
+        written,
+        "push_html and write_html_fmt disagree for {text:?}",
+    );
+}
