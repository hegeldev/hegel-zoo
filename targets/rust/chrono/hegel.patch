+#[hegel::test]
+fn times_match_the_model(tc: hegel::TestCase) {
+    let T(t) = tc.draw(arb_time_maybe_leap(true));
+    let T(u) = tc.draw(arb_time_maybe_leap(true));
+    let (h, m, s, n) = (t.hour(), t.minute(), t.second(), t.nanosecond());
+    assert_eq!(t.num_seconds_from_midnight(), h * 3600 + m * 60 + s);
+    assert_eq!(NaiveTime::from_num_seconds_from_midnight_opt(t.num_seconds_from_midnight(), n), Some(t));
+    assert_eq!(NaiveTime::from_hms_nano_opt(h, m, s, n), Some(t));
+    assert_eq!(NaiveTime::from_hms_micro_opt(h, m, s, n / 1000).map(|x| x.nanosecond()), Some(n / 1000 * 1000));
+    assert_eq!(NaiveTime::from_hms_milli_opt(h, m, s, n / 1_000_000).map(|x| x.nanosecond()), Some(n / 1_000_000 * 1_000_000));
+    assert_eq!(NaiveTime::from_hms_opt(h, m, s), Some(t.with_nanosecond(0).unwrap()));
+    // the validity rules
+    assert_eq!(NaiveTime::from_hms_nano_opt(24, m, s, n), None);
+    assert_eq!(NaiveTime::from_hms_nano_opt(h, 60, s, n), None);
+    assert_eq!(NaiveTime::from_hms_nano_opt(h, m, 60, n), None);
+    assert_eq!(NaiveTime::from_hms_nano_opt(h, m, s, 2_000_000_000), None);
+    assert_eq!(NaiveTime::from_hms_nano_opt(h, m, s, 1_000_000_000).is_some(), s == 59, "leap only after :59");
+    // (`with_nanosecond` documents that a leap second "can theoretically follow any whole second")
+    assert!(t.with_nanosecond(1_500_000_000).is_some());
+    assert_eq!(t.with_nanosecond(2_000_000_000), None);
+    assert_eq!(t.with_second(60), None);
+    assert_eq!(t.with_minute(60), None);
+    assert_eq!(t.with_hour(24), None);
+    // the nominal position in the day, in nanoseconds; a leap second is `:59` plus a second
+    let pos = |x: NaiveTime| x.num_seconds_from_midnight() as i64 * 1_000_000_000 + x.nanosecond() as i64;
+    let is_leap = |x: NaiveTime| x.nanosecond() >= 1_000_000_000;
+    assert_eq!(t.cmp(&u), (t.num_seconds_from_midnight(), t.nanosecond()).cmp(&(u.num_seconds_from_midnight(), u.nanosecond())), "{t:?} vs {u:?}");
+    // differences assume the leap second seen is the only one in the day: everything after it is
+    // a second later than its nominal position (two leap seconds are outside the contract)
+    if !(is_leap(t) && is_leap(u)) {
+        let since = t.signed_duration_since(u);
+        let mut expected = (pos(t) - pos(u)) as i128;
+        if is_leap(t) && u.num_seconds_from_midnight() > t.num_seconds_from_midnight() {
+            expected -= 1_000_000_000;
+        }
+        if is_leap(u) && t.num_seconds_from_midnight() > u.num_seconds_from_midnight() {
+            expected += 1_000_000_000;
+        }
+        assert_eq!(delta_nanos(since), expected, "{t:?} - {u:?}");
+        assert_eq!(t - u, since);
+        assert_eq!(delta_nanos(u.signed_duration_since(t)), -expected, "{u:?} - {t:?}");
+    }
+    let Delta(delta) = tc.draw(arb_delta());
+    let (sum, wrapped_secs) = t.overflowing_add_signed(delta);
+    // without leap seconds the sum is the plain wrap-around; with one, the leap nanos count
+    if n < 1_000_000_000 {
+        let total = pos(t) as i128 + delta_nanos(delta);
+        let day = 86_400i128 * 1_000_000_000;
+        let expect = total.rem_euclid(day);
+        assert_eq!(pos(sum) as i128, expect, "{t:?} + {delta:?}");
+        assert_eq!(wrapped_secs, total.div_euclid(day) as i64 * 86_400, "{t:?} + {delta:?}: seconds in the days wrapped");
+        assert_eq!(t.overflowing_sub_signed(delta).1, -(pos(t) as i128 - delta_nanos(delta)).div_euclid(day) as i64 * 86_400, "{t:?} - {delta:?}");
+        assert_eq!(t + delta, sum);
+        assert_eq!(sum - delta, t, "{t:?} + {delta:?} - {delta:?}");
+    }
+    // formatting: `:60` for a leap second, and every precision reads back
+    let text = t.format("%H:%M:%S%.f").to_string();
+    let expected_secs = if n >= 1_000_000_000 { 60 } else { s };
+    let frac = n % 1_000_000_000;
+    let expected_frac = if frac == 0 {
+        String::new()
+    } else if frac % 1_000_000 == 0 {
+        format!(".{:03}", frac / 1_000_000)
+    } else if frac % 1_000 == 0 {
+        format!(".{:06}", frac / 1_000)
+    } else {
+        format!(".{frac:09}")
+    };
+    assert_eq!(text, format!("{h:02}:{m:02}:{expected_secs:02}{expected_frac}"), "{t:?}");
+    assert_eq!(NaiveTime::parse_from_str(&text, "%H:%M:%S%.f"), Ok(t), "{text}");
+    assert_eq!(t.to_string(), text);
+    assert_eq!(text.parse::<NaiveTime>(), Ok(t));
+    assert_eq!(t.format("%T").to_string(), format!("{h:02}:{m:02}:{expected_secs:02}"));
+    assert_eq!(t.format("%.3f").to_string(), format!(".{:03}", frac / 1_000_000));
+    assert_eq!(t.format("%.6f").to_string(), format!(".{:06}", frac / 1_000));
+    assert_eq!(t.format("%.9f").to_string(), format!(".{frac:09}"));
+    assert_eq!(t.format("%3f%6f%9f").to_string(), format!("{:03}{:06}{:09}", frac / 1_000_000, frac / 1_000, frac));
+    assert_eq!(NaiveTime::parse_from_str(&t.format("%H:%M:%S%.9f").to_string(), "%H:%M:%S%.9f"), Ok(t));
+    assert_eq!(NaiveTime::parse_from_str(&t.format("%T.%9f").to_string(), "%T.%f"), Ok(t), "{t:?}");
+    let trunc_ms = t.with_nanosecond(n / 1_000_000 * 1_000_000).unwrap();
+    assert_eq!(NaiveTime::parse_from_str(&t.format("%T%.3f").to_string(), "%T%.3f"), Ok(trunc_ms), "{t:?}");
+    // 12-hour clock
+    let text12 = t.format("%I:%M:%S %p").to_string();
+    let hour12 = if h % 12 == 0 { 12 } else { h % 12 };
+    assert_eq!(text12, format!("{hour12:02}:{m:02}:{expected_secs:02} {}", if h < 12 { "AM" } else { "PM" }));
+    assert_eq!(NaiveTime::parse_from_str(&text12, "%I:%M:%S %p"), Ok(t.with_nanosecond(n / 1_000_000_000 * 1_000_000_000).unwrap()), "{text12}");
+    assert_eq!(t.hour12(), (h >= 12, hour12));
+    assert_eq!(t.format("%l:%M %P").to_string(), format!("{hour12:>2}:{m:02} {}", if h < 12 { "am" } else { "pm" }));
+    assert_eq!(t.format("%k").to_string(), format!("{h:>2}"));
+    assert_eq!(t.format("%-H %-M %-S").to_string(), format!("{h} {m} {expected_secs}"));
+    assert_eq!(NaiveTime::parse_from_str(&t.format("%R").to_string(), "%R"), Ok(NaiveTime::from_hms_opt(h, m, 0).unwrap()));
+}
