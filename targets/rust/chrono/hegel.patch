+// TimeDelta
+
+/// A `TimeDelta` holds ±i64::MAX milliseconds (`MIN`..=`MAX`); `checked_mul` "returns `None` if
+/// overflow occurred", but only checks that the seconds fit an `i64`, so it hands out values
+/// beyond `MAX` on which the other methods overflow. KNOWN FAILURE chrono/6.
+#[hegel::test]
+fn multiplication_beyond_the_range_is_none(tc: hegel::TestCase) {
+    let Delta(a) = tc.draw(arb_delta());
+    let k = tc.draw(int!(-1000i32, 1000));
+    let na = delta_nanos(a);
+    let product = na * k as i128;
+    let in_range = product >= delta_nanos(TimeDelta::MIN) && product <= delta_nanos(TimeDelta::MAX);
+    match a.checked_mul(k) {
+        Some(m) => {
+            assert!(in_range, "{a:?} × {k} = {m:?} is beyond MIN..=MAX");
+            assert!(m >= TimeDelta::MIN && m <= TimeDelta::MAX);
+        }
+        None => assert!(!in_range, "{a:?} × {k} fits but is None"),
+    }
+}
+
+/// Dividing a positive `TimeDelta` by `k` is the truncated quotient of its nanoseconds: in
+/// particular exact when `k` divides them. KNOWN FAILURE chrono/5.
+#[hegel::test]
+fn division_is_exact_to_the_nanosecond(tc: hegel::TestCase) {
+    let Delta(a) = tc.draw(arb_delta());
+    let k = tc.draw(int!(1i32, 1000));
+    let a = a.abs();
+    let na = delta_nanos(a);
+    let expected = TimeDelta::nanoseconds(0).checked_add(&TimeDelta::new((na / k as i128).div_euclid(1_000_000_000) as i64, (na / k as i128).rem_euclid(1_000_000_000) as u32).unwrap()).unwrap();
+    assert_eq!(a.checked_div(k), Some(expected), "{a:?} / {k}");
+    let exact = a.checked_mul(k).filter(|m| delta_nanos(*m) == na * k as i128);
+    if let Some(m) = exact {
+        assert_eq!(m.checked_div(k), Some(a), "({a:?} × {k}) / {k}");
+    }
+}
