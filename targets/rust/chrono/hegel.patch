+#[hegel::test]
+fn timestamps_agree_with_jiff_and_the_model(tc: hegel::TestCase) {
+    let Dt(dt) = tc.draw(arb_jiff_datetime());
+    let Off(off) = tc.draw(arb_offset());
+    if !jiff_instant_ok(dt, FixedOffset::east_opt(0).unwrap()) {
+        return;
+    }
+    let nanos = nanos_of(dt);
+    let secs = nanos.div_euclid(1_000_000_000) as i64;
+    let sub = nanos.rem_euclid(1_000_000_000) as u32;
+    // UTC timestamps
+    let utc = dt.and_utc();
+    assert_eq!(utc.timestamp(), secs, "{dt:?}");
+    assert_eq!(utc.timestamp_subsec_nanos(), sub);
+    assert_eq!(utc.timestamp_millis() as i128, nanos.div_euclid(1_000_000));
+    assert_eq!(utc.timestamp_micros() as i128, nanos.div_euclid(1_000));
+    assert_eq!(utc.timestamp_nanos_opt().map(i128::from), i64::try_from(nanos).ok().map(i128::from), "{dt:?}");
+    assert_eq!(DateTime::<Utc>::from_timestamp(secs, sub), Some(utc));
+    assert_eq!(DateTime::<Utc>::from_timestamp_millis(utc.timestamp_millis()), Some(utc.with_nanosecond(sub / 1_000_000 * 1_000_000).unwrap()));
+    assert_eq!(DateTime::<Utc>::from_timestamp_micros(utc.timestamp_micros()), Some(utc.with_nanosecond(sub / 1_000 * 1_000).unwrap()));
+    if let Some(ns) = utc.timestamp_nanos_opt() {
+        assert_eq!(DateTime::<Utc>::from_timestamp_nanos(ns), utc);
+    }
+    assert_eq!(DateTime::<Utc>::from_timestamp(secs, 1_000_000_000).is_some(), dt.second() == 59, "leap nanos in from_timestamp");
+    assert_eq!(DateTime::<Utc>::from_timestamp(secs, 2_000_000_000), None);
+    // jiff: the same instant has the same civil fields
+    let ts = jiff::Timestamp::new(secs, sub as i32).unwrap();
+    let jdt = ts.to_zoned(jiff::tz::TimeZone::UTC).datetime();
+    assert_eq!(jdt, jiff_datetime(dt), "{dt:?}");
+    assert_eq!(jiff_datetime(dt).to_zoned(jiff::tz::TimeZone::UTC).unwrap().timestamp(), ts);
+    // in a fixed offset: local = utc + offset
+    let local = utc.with_timezone(&off);
+    assert_eq!(local.timestamp(), secs, "the instant is the same");
+    assert_eq!(local, utc);
+    assert_eq!(local.naive_utc(), dt);
+    assert_eq!(nanos_of(local.naive_local()) - nanos, off.local_minus_utc() as i128 * 1_000_000_000, "{dt:?} in {off:?}");
+    assert_eq!(local.offset().local_minus_utc(), off.local_minus_utc());
+    assert_eq!(local.to_utc(), utc);
+    assert_eq!(local.fixed_offset(), local);
+    let jz = ts.to_zoned(jiff::tz::TimeZone::fixed(jiff::tz::Offset::from_seconds(off.local_minus_utc()).unwrap()));
+    assert_eq!(jz.datetime(), jiff_datetime(local.naive_local()), "{dt:?} in {off:?}");
+    // building from the local side
+    let back = off.from_local_datetime(&local.naive_local()).single().expect("fixed offsets are unambiguous");
+    assert_eq!(back, local);
+    assert_eq!(local.naive_local().and_local_timezone(off).unwrap(), local);
+    assert_eq!(off.from_utc_datetime(&dt), local);
+    // offsets
+    assert_eq!(FixedOffset::east_opt(off.local_minus_utc()), Some(off));
+    assert_eq!(FixedOffset::west_opt(-off.local_minus_utc()), Some(off));
+    assert_eq!(FixedOffset::east_opt(86_400), None);
+    assert_eq!(FixedOffset::east_opt(-86_400), None);
+    assert_eq!(off.utc_minus_local(), -off.local_minus_utc());
+    let o = off.local_minus_utc();
+    let sign = if o < 0 { '-' } else { '+' };
+    let (oh, om, os) = (o.abs() / 3600, o.abs() % 3600 / 60, o.abs() % 60);
+    let shown = if os == 0 { format!("{sign}{oh:02}:{om:02}") } else { format!("{sign}{oh:02}:{om:02}:{os:02}") };
+    assert_eq!(off.to_string(), shown, "Display of an offset");
+    assert_eq!(format!("{off:?}"), shown);
+    // `%z`/`%:z` round the seconds to the nearest minute (never to 24:00), `%:::z` truncates to
+    // hours, `%::z` prints the seconds
+    let rounded = ((o.abs() + 30) / 60).min(24 * 60 - 1);
+    let (rh, rm) = (rounded / 60, rounded % 60);
+    assert_eq!(local.format("%z").to_string(), format!("{sign}{rh:02}{rm:02}"), "{off:?}");
+    assert_eq!(local.format("%:z").to_string(), format!("{sign}{rh:02}:{rm:02}"), "{off:?}");
+    assert_eq!(local.format("%::z").to_string(), format!("{sign}{oh:02}:{om:02}:{os:02}"), "{off:?}");
+    assert_eq!(local.format("%:::z").to_string(), format!("{sign}{oh:02}"), "{off:?}");
+    assert_eq!(local.format("%s").to_string(), secs.to_string());
+    // Display / Debug / FromStr of a DateTime<FixedOffset> and <Utc>
+    let text = local.to_string();
+    assert_eq!(text, format!("{} {}", local.naive_local(), off), "Display is the local time and the offset");
+    if off.local_minus_utc() % 60 == 0 {
+        // (an offset with seconds prints as `+hh:mm:ss`, which the RFC 3339-like `FromStr` does not read)
+        assert_eq!(text.parse::<DateTime<FixedOffset>>(), Ok(local), "{text}");
+        assert_eq!(format!("{local:?}").parse::<DateTime<FixedOffset>>(), Ok(local), "{local:?}");
+    }
+    assert_eq!(utc.to_string().parse::<DateTime<Utc>>(), Ok(utc));
+    assert_eq!(format!("{utc:?}").parse::<DateTime<Utc>>(), Ok(utc));
+    assert_eq!(format!("{dt:?}").parse::<NaiveDateTime>(), Ok(dt));
+    // (`Display` of a NaiveDateTime uses a space, `FromStr` is documented as the `Debug` format
+    // with the `T`; the two are not a round trip)
+    assert_eq!(NaiveDateTime::parse_from_str(&dt.to_string(), "%Y-%m-%d %H:%M:%S%.f"), Ok(dt));
+    // ordering across offsets follows the instant
+    let Off(off2) = tc.draw(arb_offset());
+    let other = utc.with_timezone(&off2);
+    assert_eq!(local.cmp(&other), std::cmp::Ordering::Equal);
+    let later = utc + TimeDelta::nanoseconds(1);
+    assert!(later.with_timezone(&off2) > local);
+}
