+/// Formats that pin down a whole `NaiveDateTime` (to the second), and their round trip in both
+/// libraries from chrono's text.
+const COMPLETE_FORMATS: &[&str] = &[
+    "%Y-%m-%d %H:%M:%S",
+    "%Y-%m-%dT%H:%M:%S",
+    "%F %T",
+    "%Y-%j %T",
+    "%G-W%V-%u %T",
+    "%Y %m %d %I:%M:%S %p",
+    "%Y %m %d %I:%M:%S %P",
+    "%a, %d %b %Y %T",
+    "%A %B %e %Y %k:%M:%S",
+    "%d/%m/%Y %H:%M:%S",
+    "%Y%m%d%H%M%S",
+    "%e %h %Y %l:%M:%S %p",
+    "%Y-%m-%d %H:%M:%S %j %u",
+    "%s",
+];
+
+#[hegel::test]
+fn strftime_round_trips(tc: hegel::TestCase) {
+    let Dt(dt) = tc.draw(arb_jiff_datetime());
+    let Off(off) = tc.draw(arb_offset());
+    if dt.year() < 1 {
+        return;
+    }
+    let whole = dt.with_nanosecond(0).unwrap();
+    let fmt = tc.draw(generators::sampled_from(COMPLETE_FORMATS.to_vec()));
+    if fmt == "%s" && whole.and_utc().timestamp() < 0 {
+        return; // KNOWN FAILURE chrono/2, `negative_unix_timestamps_parse`
+    }
+    let text = whole.format(fmt).to_string();
+    assert_eq!(NaiveDateTime::parse_from_str(&text, fmt), Ok(whole), "{fmt:?} → {text:?}");
+    let parsed = jiff::fmt::strtime::parse(fmt, &text).unwrap_or_else(|e| panic!("jiff can't parse {text:?} with {fmt:?}: {e}"));
+    let jdt = if fmt == "%s" { parsed.to_timestamp().unwrap().to_zoned(jiff::tz::TimeZone::UTC).datetime() } else { parsed.to_datetime().unwrap() };
+    assert_eq!(jdt, jiff_datetime(whole), "{fmt:?} → {text:?} in jiff");
+    // with fractions
+    let text = dt.format("%Y-%m-%d %H:%M:%S%.f").to_string();
+    assert_eq!(NaiveDateTime::parse_from_str(&text, "%Y-%m-%d %H:%M:%S%.f"), Ok(dt), "{text}");
+    assert_eq!(jiff::fmt::strtime::parse("%Y-%m-%d %H:%M:%S%.f", &text).unwrap().to_datetime().unwrap(), jiff_datetime(dt), "{text} in jiff");
+    let text = dt.format("%Y-%m-%d %H:%M:%S.%f").to_string();
+    assert_eq!(NaiveDateTime::parse_from_str(&text, "%Y-%m-%d %H:%M:%S.%f"), Ok(dt), "{text}");
+    // with an offset
+    let local = dt.and_local_timezone(off).unwrap();
+    for fmt in ["%Y-%m-%d %H:%M:%S%.f %z", "%Y-%m-%d %H:%M:%S%.f %:z", "%s%.f %z", "%+"] {
+        if fmt.contains("%s") && local.timestamp() < 0 {
+            continue; // KNOWN FAILURE chrono/2
+        }
+        let text = local.format(fmt).to_string();
+        let back = DateTime::<FixedOffset>::parse_from_str(&text, fmt);
+        if off.local_minus_utc() % 60 == 0 {
+            assert_eq!(back, Ok(local), "{fmt:?} → {text:?}");
+            assert_eq!(back.unwrap().offset(), local.offset(), "{fmt:?} → {text:?}: offset");
+        } else {
+            // `%z`/`%:z` round the offset to the nearest minute: the instant shifts by the difference
+            let back = back.unwrap();
+            let o = off.local_minus_utc();
+            let rounded = ((o.abs() + 30) / 60).min(24 * 60 - 1) * 60 * o.signum();
+            if fmt.contains("%s") {
+                assert_eq!(back.timestamp(), local.timestamp(), "{fmt:?} → {text:?}: instant");
+            } else {
+                assert_eq!(back.naive_local(), local.naive_local(), "{fmt:?} → {text:?}: local time");
+            }
+            assert_eq!(back.offset().local_minus_utc(), rounded, "{fmt:?} → {text:?}: offset");
+        }
+    }
+    // the `Z` and `UTC` spellings and case-insensitivity of `%+`
+    let utc = dt.and_utc();
+    for s in [format!("{}Z", dt.format("%Y-%m-%dT%H:%M:%S%.f")), format!("{}z", dt.format("%Y-%m-%dt%H:%M:%S%.f")), format!("{}UTC", dt.format("%Y-%m-%dT%H:%M:%S%.f")), format!("{}+00:00", dt.format("%Y-%m-%dT%H:%M:%S%.f"))] {
+        assert_eq!(DateTime::<FixedOffset>::parse_from_str(&s, "%+").map(|x| x.to_utc()), Ok(utc), "{s}");
+    }
+    // parse_and_remainder
+    let text = format!("{} trailing", whole.format("%F %T"));
+    assert_eq!(NaiveDateTime::parse_and_remainder(&text, "%F %T"), Ok((whole, " trailing")));
+    assert!(NaiveDateTime::parse_from_str(&text, "%F %T").is_err(), "trailing input is an error");
+}
