+#[hegel::test]
+fn rfc3339_and_rfc2822_agree_with_jiff(tc: hegel::TestCase) {
+    let Dt(dt) = tc.draw(arb_jiff_datetime());
+    let Off(off) = tc.draw(arb_offset());
+    if !jiff_instant_ok(dt, off) {
+        return;
+    }
+    let local = dt.and_local_timezone(off).unwrap();
+    let jz = jiff_datetime(dt).to_zoned(jiff::tz::TimeZone::fixed(jiff::tz::Offset::from_seconds(off.local_minus_utc()).unwrap())).unwrap();
+    if (0..=9999).contains(&dt.year()) && off.local_minus_utc() % 60 == 0 {
+        // RFC 3339 (`%+`): 0/3/6/9 fractional digits, colon offset; the same instant in jiff
+        let text = local.to_rfc3339();
+        assert_eq!(DateTime::parse_from_rfc3339(&text), Ok(local), "{text}");
+        assert_eq!(text, local.format("%+").to_string());
+        let ts: jiff::Timestamp = text.parse().unwrap_or_else(|e| panic!("jiff rejects {text}: {e}"));
+        assert_eq!(jiff_nanos(ts), nanos_of(local.naive_utc()), "{text}");
+        // jiff's RFC 3339 text is parsed back by chrono to the same instant and offset
+        let jtext = jz.timestamp().display_with_offset(jz.offset()).to_string();
+        let back = DateTime::parse_from_rfc3339(&jtext).unwrap_or_else(|e| panic!("chrono rejects jiff's {jtext}: {e}"));
+        assert_eq!(back, local, "{jtext}");
+        assert_eq!(back.offset(), local.offset(), "{jtext}");
+        // SecondsFormat variants read back to the truncated value
+        use chrono::SecondsFormat::*;
+        for (fmt, unit) in [(Secs, 1_000_000_000u32), (Millis, 1_000_000), (Micros, 1_000), (Nanos, 1)] {
+            for use_z in [false, true] {
+                let text = local.to_rfc3339_opts(fmt, use_z);
+                let expected = local.with_nanosecond(dt.nanosecond() / unit * unit).unwrap();
+                assert_eq!(DateTime::parse_from_rfc3339(&text), Ok(expected), "{text}");
+                assert_eq!(text.ends_with('Z'), use_z && off.local_minus_utc() == 0, "{text}");
+                let ts: jiff::Timestamp = text.parse().unwrap_or_else(|e| panic!("jiff rejects {text}: {e}"));
+                assert_eq!(jiff_nanos(ts), nanos_of(expected.naive_utc()), "{text}");
+            }
+        }
+        let auto = local.to_rfc3339_opts(chrono::SecondsFormat::AutoSi, false);
+        assert_eq!(auto, text);
+    }
+    if (1..=9999).contains(&dt.year()) && off.local_minus_utc() % 60 == 0 {
+        // RFC 2822: seconds precision, `+hhmm` offset
+        let whole = local.with_nanosecond(0).unwrap();
+        let text = whole.to_rfc2822();
+        assert_eq!(DateTime::parse_from_rfc2822(&text), Ok(whole), "{text}");
+        assert_eq!(local.to_rfc2822(), text, "fractions are dropped");
+        let jparsed = jiff::fmt::rfc2822::parse(&text).unwrap_or_else(|e| panic!("jiff rejects {text}: {e}"));
+        assert_eq!(jparsed.timestamp().as_second(), whole.timestamp(), "{text}");
+        assert_eq!(jparsed.offset().seconds(), off.local_minus_utc(), "{text}");
+        let jtext = jiff::fmt::rfc2822::to_string(&jz.with().subsec_nanosecond(0).build().unwrap()).unwrap();
+        let back = DateTime::parse_from_rfc2822(&jtext).unwrap_or_else(|e| panic!("chrono rejects jiff's {jtext}: {e}"));
+        assert_eq!(back, whole, "{jtext}");
+        assert_eq!(back.offset(), whole.offset(), "{jtext}");
+    }
+}
