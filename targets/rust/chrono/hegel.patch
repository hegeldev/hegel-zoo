+/// `%s` "is not padded and can be negative" — and it formats so — but no negative timestamp parses
+/// back (`ParseError(Invalid)`), whatever the surrounding format. KNOWN FAILURE chrono/2.
+#[hegel::test]
+fn negative_unix_timestamps_parse(tc: hegel::TestCase) {
+    let Dt(dt) = tc.draw(arb_jiff_datetime());
+    let Off(off) = tc.draw(arb_offset());
+    let whole = dt.with_nanosecond(0).unwrap();
+    let text = whole.format("%s").to_string();
+    assert_eq!(text, whole.and_utc().timestamp().to_string());
+    assert_eq!(NaiveDateTime::parse_from_str(&text, "%s"), Ok(whole), "{text:?}");
+    let local = dt.and_local_timezone(FixedOffset::east_opt(off.local_minus_utc() / 60 * 60).unwrap()).unwrap();
+    let text = local.format("%s%.f %z").to_string();
+    assert_eq!(DateTime::<FixedOffset>::parse_from_str(&text, "%s%.f %z"), Ok(local), "{text:?}");
+}
