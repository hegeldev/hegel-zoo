+#[hegel::test]
+fn time_delta_matches_i128_nanoseconds(tc: hegel::TestCase) {
+    let Delta(a) = tc.draw(arb_delta());
+    let Delta(b) = tc.draw(arb_delta());
+    let k = tc.draw(int!(-1000i32, 1000));
+    let lo = delta_nanos(TimeDelta::MIN);
+    let hi = delta_nanos(TimeDelta::MAX);
+    let make = |n: i128| -> Option<TimeDelta> {
+        if n < lo || n > hi {
+            return None;
+        }
+        TimeDelta::new(n.div_euclid(1_000_000_000) as i64, n.rem_euclid(1_000_000_000) as u32)
+    };
+    let (na, nb) = (delta_nanos(a), delta_nanos(b));
+    assert_eq!(make(na), Some(a), "{a:?} rebuilt from its nanoseconds");
+    // whole units truncate toward zero; the sub-second part carries the sign
+    assert_eq!(a.num_seconds() as i128, na / 1_000_000_000, "{a:?}");
+    assert_eq!(a.subsec_nanos() as i128, na % 1_000_000_000, "{a:?}");
+    assert_eq!(a.num_nanoseconds().map(i128::from), i64::try_from(na).ok().map(i128::from), "{a:?}");
+    assert_eq!(a.num_microseconds().map(i128::from), i64::try_from(na / 1_000).ok().map(i128::from), "{a:?}");
+    assert_eq!(a.num_milliseconds() as i128, na / 1_000_000, "{a:?}");
+    assert_eq!(a.num_minutes() as i128, (na / 1_000_000_000) / 60, "{a:?}: truncation toward zero");
+    assert_eq!(a.num_hours() as i128, (na / 1_000_000_000) / 3600);
+    assert_eq!(a.num_days() as i128, (na / 1_000_000_000) / 86_400);
+    assert_eq!(a.num_weeks() as i128, (na / 1_000_000_000) / 604_800);
+    // arithmetic
+    assert_eq!(a.checked_add(&b), make(na + nb), "{a:?} + {b:?}");
+    assert_eq!(a.checked_sub(&b), make(na - nb), "{a:?} - {b:?}");
+    // (a product beyond `MIN`/`MAX` is `multiplication_beyond_the_range_is_none`, KNOWN FAILURE
+    // chrono/6: `checked_mul` only checks that the seconds fit an i64)
+    if let Some(expected) = make(na * k as i128) {
+        assert_eq!(a.checked_mul(k), Some(expected), "{a:?} × {k}");
+    } else if let Some(product) = a.checked_mul(k) {
+        assert_eq!(delta_nanos(product), na * k as i128, "{a:?} × {k}: at least the right value");
+    }
+    if k != 0 {
+        // (exactness is `division_is_exact_to_the_nanosecond`, KNOWN FAILURE chrono/5: the
+        // quotient is computed part by part and can be 1 ns off)
+        let q = a.checked_div(k).unwrap();
+        assert!((delta_nanos(q) - na / k as i128).abs() <= 1, "{a:?} / {k} = {q:?}");
+        assert_eq!(a / k, q);
+    } else {
+        assert_eq!(a.checked_div(0), None);
+    }
+    assert_eq!(a.abs(), make(na.abs()).unwrap_or(TimeDelta::MAX), "{a:?}");
+    if na != lo {
+        assert_eq!(-a, make(-na).unwrap());
+    }
+    assert_eq!(a.is_zero(), na == 0);
+    assert_eq!(a.cmp(&b), na.cmp(&nb));
+    assert_eq!(a == b, na == nb);
+    // constructors
+    assert_eq!(TimeDelta::try_seconds(a.num_seconds()).map(delta_nanos), Some(a.num_seconds() as i128 * 1_000_000_000));
+    assert_eq!(TimeDelta::try_milliseconds(a.num_milliseconds()).map(delta_nanos), Some(a.num_milliseconds() as i128 * 1_000_000));
+    if let Some(us) = a.num_microseconds() {
+        assert_eq!(delta_nanos(TimeDelta::microseconds(us)), us as i128 * 1_000);
+    }
+    if let Some(ns) = a.num_nanoseconds() {
+        assert_eq!(TimeDelta::nanoseconds(ns), a);
+    }
+    assert_eq!(TimeDelta::new(a.num_seconds(), a.subsec_nanos().rem_euclid(1_000_000_000) as u32).map(delta_nanos), Some(a.num_seconds() as i128 * 1_000_000_000 + a.subsec_nanos().rem_euclid(1_000_000_000) as i128).filter(|n| *n <= hi));
+    assert_eq!(TimeDelta::new(0, 1_000_000_000), None);
+    assert_eq!(TimeDelta::new(TimeDelta::MAX.num_seconds() + 1, 0), None);
+    assert_eq!(TimeDelta::new(TimeDelta::MIN.num_seconds() - 1, 0), None);
+    // std conversions
+    let std = a.to_std();
+    if na >= 0 {
+        let std = std.unwrap();
+        assert_eq!(std.as_nanos(), na as u128, "{a:?}");
+        assert_eq!(TimeDelta::from_std(std), Ok(a));
+    } else {
+        assert!(std.is_err(), "{a:?}: negative to std");
+    }
+    assert!(TimeDelta::from_std(std::time::Duration::MAX).is_err());
+    // Display is an ISO 8601 duration: `P0D`, else `[-]PT<seconds>[.<fraction>]S` with the
+    // fraction's trailing zeros trimmed; jiff's `Span` reads it back when the seconds fit its range
+    let text = a.to_string();
+    let (abs_secs, abs_nanos) = (na.abs() / 1_000_000_000, na.abs() % 1_000_000_000);
+    let expected = if na == 0 {
+        "P0D".to_string()
+    } else {
+        let frac = if abs_nanos == 0 { String::new() } else { format!(".{}", format!("{abs_nanos:09}").trim_end_matches('0')) };
+        format!("{}PT{abs_secs}{frac}S", if na < 0 { "-" } else { "" })
+    };
+    assert_eq!(text, expected, "{a:?}");
+    if abs_secs <= 631_107_417_600 {
+        let span: jiff::Span = text.parse().unwrap_or_else(|e| panic!("jiff can't parse {text}: {e}"));
+        let total = span.get_days() as i128 * 86_400_000_000_000
+            + span.get_hours() as i128 * 3_600_000_000_000
+            + span.get_minutes() as i128 * 60_000_000_000
+            + span.get_seconds() as i128 * 1_000_000_000
+            + span.get_milliseconds() as i128 * 1_000_000
+            + span.get_microseconds() as i128 * 1_000
+            + span.get_nanoseconds() as i128;
+        assert_eq!(total, na, "{a:?} → {text} in jiff");
+    }
+}
