+//! Hegel property tests for `chrono`: the proleptic Gregorian calendar, ISO weeks, timestamps,
+//! `strftime` formatting/parsing, RFC 3339/2822, rounding and `TimeDelta`.
+//!
+//! Oracles: a small calendar model (Howard Hinnant's `days_from_civil`/`civil_from_days`, the ISO
+//! week rules, i128 nanosecond arithmetic) for chrono's whole ±262 143-year range, and the `jiff`
+//! crate — an independent date-time library with its own `strftime`, RFC 2822/3339 codecs and
+//! calendar arithmetic — for years −9999..=9999.
+
+use chrono::{
+    DateTime, Datelike, Days, DurationRound, FixedOffset, Months, NaiveDate, NaiveDateTime,
+    NaiveTime, RoundingError, SubsecRound, TimeDelta, TimeZone, Timelike, Utc, Weekday,
+};
+use hegel::generators;
+use jiff::civil;
+
+// ----------------------------------------------------------------------------------------------
+// the calendar model
+
+/// Days since 1970-01-01 of a proleptic Gregorian date (Hinnant's algorithm).
+fn days_from_civil(y: i64, m: i64, d: i64) -> i64 {
+    let y = if m <= 2 { y - 1 } else { y };
+    let era = y.div_euclid(400);
+    let yoe = y - era * 400;
+    let mp = (m + 9) % 12;
+    let doy = (153 * mp + 2) / 5 + d - 1;
+    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    era * 146_097 + doe - 719_468
+}
+
+/// The inverse of `days_from_civil`.
+fn civil_from_days(z: i64) -> (i64, i64, i64) {
+    let z = z + 719_468;
+    let era = z.div_euclid(146_097);
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let y = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    (if m <= 2 { y + 1 } else { y }, m, d)
+}
+
+fn is_leap(y: i64) -> bool {
+    (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
+}
+
+fn days_in_month(y: i64, m: i64) -> i64 {
+    match m {
+        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,
+        4 | 6 | 9 | 11 => 30,
+        2 if is_leap(y) => 29,
+        2 => 28,
+        _ => unreachable!(),
+    }
+}
+
+/// ISO weekday, Monday = 1 … Sunday = 7, of a day count since 1970-01-01 (a Thursday).
+fn iso_weekday(days: i64) -> i64 {
+    (days + 3).rem_euclid(7) + 1
+}
+
+fn ordinal(y: i64, m: i64, d: i64) -> i64 {
+    days_from_civil(y, m, d) - days_from_civil(y, 1, 1) + 1
+}
+
+/// Number of ISO weeks in a year: 53 when the year starts on a Thursday, or on a Wednesday and is
+/// leap; 52 otherwise.
+fn iso_weeks_in_year(y: i64) -> i64 {
+    let jan1 = iso_weekday(days_from_civil(y, 1, 1));
+    if jan1 == 4 || (jan1 == 3 && is_leap(y)) { 53 } else { 52 }
+}
+
+/// ISO week-based year and week number.
+fn iso_week(y: i64, m: i64, d: i64) -> (i64, i64) {
+    let wd = iso_weekday(days_from_civil(y, m, d));
+    let week = (ordinal(y, m, d) - wd + 10) / 7;
+    if week < 1 {
+        (y - 1, iso_weeks_in_year(y - 1))
+    } else if week > iso_weeks_in_year(y) {
+        (y + 1, 1)
+    } else {
+        (y, week)
+    }
+}
+
+/// chrono's `%U` (weeks starting Sunday) and `%W` (weeks starting Monday): the number of the
+/// first day of the week on or before the date, counting from the first such day of the year.
+fn week_number(y: i64, m: i64, d: i64, week_starts_sunday: bool) -> i64 {
+    let days = days_from_civil(y, m, d);
+    let wd = iso_weekday(days); // Mon = 1 … Sun = 7
+    let offset = if week_starts_sunday { wd % 7 } else { wd - 1 }; // days since week start
+    (ordinal(y, m, d) - 1 - offset + 7) / 7
+}
+
+// ----------------------------------------------------------------------------------------------
+// generators
+
+macro_rules! printable {
+    ($($t:ident($inner:ty)),*) => {$(
+        #[derive(Clone, Copy, PartialEq, Eq)]
+        struct $t($inner);
+        impl std::fmt::Debug for $t {
+            fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                write!(f, "{:?}", self.0)
+            }
+        }
+        impl hegel::PrettyPrintable for $t {
+            fn pretty_print(&self, printer: &mut hegel::pretty::PrettyPrinter) {
+                hegel::pretty::print_debug_repr(&format!("{self:?}"), printer);
+            }
+        }
+    )*};
+}
+
+printable!(D(NaiveDate), T(NaiveTime), Dt(NaiveDateTime), Off(FixedOffset), Delta(TimeDelta));
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+/// A date anywhere in chrono's range, biased to the recent centuries and to year/month edges.
+#[hegel::composite]
+fn arb_date(tc: &hegel::TestCase) -> D {
+    let d = match tc.draw(int!(0u8, 4)) {
+        0 => {
+            let lo = NaiveDate::MIN.num_days_from_ce();
+            let hi = NaiveDate::MAX.num_days_from_ce();
+            NaiveDate::from_num_days_from_ce_opt(tc.draw(int!(lo, hi))).unwrap()
+        }
+        1 => {
+            let y = tc.draw(int!(-9999i32, 9999));
+            let m = tc.draw(int!(1u32, 12));
+            let d = tc.draw(int!(1u32, days_in_month(y as i64, m as i64) as u32));
+            NaiveDate::from_ymd_opt(y, m, d).unwrap()
+        }
+        2 => {
+            let y = tc.draw(int!(1890i32, 2110));
+            let m = tc.draw(int!(1u32, 12));
+            let d = tc.draw(int!(1u32, days_in_month(y as i64, m as i64) as u32));
+            NaiveDate::from_ymd_opt(y, m, d).unwrap()
+        }
+        3 => {
+            // the first or last days of a year
+            let y = tc.draw(int!(-9999i32, 9999));
+            let o = tc.draw(int!(1u32, 4));
+            let n = if is_leap(y as i64) { 366 } else { 365 };
+            let o = if tc.draw(generators::booleans()) { o } else { n + 1 - o };
+            NaiveDate::from_yo_opt(y, o).unwrap()
+        }
+        _ => tc.draw(generators::sampled_from(vec![
+            D(NaiveDate::MIN),
+            D(NaiveDate::MAX),
+            D(NaiveDate::from_ymd_opt(1970, 1, 1).unwrap()),
+            D(NaiveDate::from_ymd_opt(0, 1, 1).unwrap()),
+            D(NaiveDate::from_ymd_opt(0, 12, 31).unwrap()),
+            D(NaiveDate::from_ymd_opt(1, 1, 1).unwrap()),
+            D(NaiveDate::from_ymd_opt(-1, 12, 31).unwrap()),
+            D(NaiveDate::from_ymd_opt(2000, 2, 29).unwrap()),
+            D(NaiveDate::from_ymd_opt(1900, 2, 28).unwrap()),
+            D(NaiveDate::from_ymd_opt(9999, 12, 31).unwrap()),
+            D(NaiveDate::from_ymd_opt(10000, 1, 1).unwrap()),
+            D(NaiveDate::from_ymd_opt(-10000, 1, 1).unwrap()),
+        ])).0,
+    };
+    D(d)
+}
+
+/// A date in jiff's range, −9999..=9999.
+#[hegel::composite]
+fn arb_jiff_date(tc: &hegel::TestCase) -> D {
+    let y = match tc.draw(int!(0u8, 2)) {
+        0 => tc.draw(int!(-9999i32, 9999)),
+        1 => tc.draw(int!(1890i32, 2110)),
+        _ => tc.draw(int!(1i32, 9999)),
+    };
+    let m = tc.draw(int!(1u32, 12));
+    let d = tc.draw(int!(1u32, days_in_month(y as i64, m as i64) as u32));
+    D(NaiveDate::from_ymd_opt(y, m, d).unwrap())
+}
+
+/// A time of day; sometimes a leap second (`nanosecond ≥ 1e9` after second 59) when allowed.
+#[hegel::composite]
+fn arb_time_maybe_leap(tc: &hegel::TestCase, leap: bool) -> T {
+    let h = tc.draw(int!(0u32, 23));
+    let m = tc.draw(int!(0u32, 59));
+    let (s, n) = if leap && tc.draw(generators::weighted_booleans(0.15)) {
+        (59, tc.draw(int!(1_000_000_000u32, 1_999_999_999)))
+    } else {
+        let s = tc.draw(int!(0u32, 59));
+        let n = match tc.draw(int!(0u8, 3)) {
+            0 => 0,
+            1 => tc.draw(int!(0u32, 999)) * 1_000_000,
+            2 => tc.draw(int!(0u32, 999_999)) * 1_000,
+            _ => tc.draw(int!(0u32, 999_999_999)),
+        };
+        (s, n)
+    };
+    T(NaiveTime::from_hms_nano_opt(h, m, s, n).unwrap())
+}
+
+fn arb_time() -> impl hegel::PrintableGenerator<T> {
+    arb_time_maybe_leap(false)
+}
+
+#[hegel::composite]
+fn arb_jiff_datetime(tc: &hegel::TestCase) -> Dt {
+    let D(d) = tc.draw(arb_jiff_date());
+    let T(t) = tc.draw(arb_time());
+    Dt(d.and_time(t))
+}
+
+/// A fixed offset; whole hours, half hours, or any number of seconds below a day.
+#[hegel::composite]
+fn arb_offset(tc: &hegel::TestCase) -> Off {
+    let secs = match tc.draw(int!(0u8, 3)) {
+        0 => 0,
+        1 => tc.draw(int!(-14i32, 14)) * 3600,
+        2 => tc.draw(int!(-27i32, 27)) * 1800,
+        _ => tc.draw(int!(-86399i32, 86399)),
+    };
+    Off(FixedOffset::east_opt(secs).unwrap())
+}
+
+#[hegel::composite]
+fn arb_delta(tc: &hegel::TestCase) -> Delta {
+    let d = match tc.draw(int!(0u8, 4)) {
+        0 => TimeDelta::nanoseconds(tc.draw(int!(-1_000_000_000_000i64, 1_000_000_000_000))),
+        1 => TimeDelta::try_seconds(tc.draw(int!(-100_000_000i64, 100_000_000))).unwrap(),
+        2 => TimeDelta::try_milliseconds(tc.draw(int!(-i64::MAX, i64::MAX))).unwrap(),
+        3 => TimeDelta::new(tc.draw(int!(-10_000_000i64, 10_000_000)), tc.draw(int!(0u32, 999_999_999))).unwrap(),
+        _ => tc.draw(generators::sampled_from(vec![
+            Delta(TimeDelta::zero()),
+            Delta(TimeDelta::MIN),
+            Delta(TimeDelta::MAX),
+            Delta(TimeDelta::nanoseconds(1)),
+            Delta(TimeDelta::nanoseconds(-1)),
+            Delta(TimeDelta::try_days(1).unwrap()),
+            Delta(TimeDelta::try_days(-1).unwrap()),
+            Delta(TimeDelta::nanoseconds(i64::MAX)),
+            Delta(TimeDelta::nanoseconds(i64::MIN)),
+        ])).0,
+    };
+    Delta(d)
+}
+
+fn jiff_date(d: NaiveDate) -> civil::Date {
+    civil::Date::new(d.year() as i16, d.month() as i8, d.day() as i8).unwrap()
+}
+
+fn jiff_datetime(dt: NaiveDateTime) -> civil::DateTime {
+    jiff_date(dt.date()).at(dt.hour() as i8, dt.minute() as i8, dt.second() as i8, dt.nanosecond() as i32)
+}
+
+fn jiff_weekday(w: Weekday) -> civil::Weekday {
+    civil::Weekday::from_monday_one_offset(w.number_from_monday() as i8).unwrap()
+}
+
+fn nanos_of(dt: NaiveDateTime) -> i128 {
+    let days = days_from_civil(dt.year() as i64, dt.month() as i64, dt.day() as i64) as i128;
+    let secs = days * 86_400 + dt.num_seconds_from_midnight() as i128;
+    secs * 1_000_000_000 + dt.nanosecond() as i128
+}
+
+/// jiff's `Timestamp` range is narrower than its civil range (−9999-01-02T01:59:59Z ..=
+/// 9999-12-30T22:00:00Z): whether the instant of `dt` at `off` fits it.
+fn jiff_instant_ok(dt: NaiveDateTime, off: FixedOffset) -> bool {
+    let secs = (nanos_of(dt) - off.local_minus_utc() as i128 * 1_000_000_000).div_euclid(1_000_000_000);
+    (-377_705_023_201..=253_402_207_200).contains(&secs)
+}
+
+/// A jiff timestamp as nanoseconds since the epoch (its second/fraction split truncates toward zero).
+fn jiff_nanos(ts: jiff::Timestamp) -> i128 {
+    ts.as_second() as i128 * 1_000_000_000 + ts.subsec_nanosecond() as i128
+}
+
+fn delta_nanos(d: TimeDelta) -> i128 {
+    d.num_seconds() as i128 * 1_000_000_000 + d.subsec_nanos() as i128
+}
+
+// ----------------------------------------------------------------------------------------------
+// dates
+
+#[hegel::test]
+fn dates_match_the_calendar_model(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_date());
+    let (y, m, day) = (d.year() as i64, d.month() as i64, d.day() as i64);
+    let days = days_from_civil(y, m, day);
+    // the day count, both ways
+    assert_eq!(d.num_days_from_ce() as i64, days + 719_163, "{d:?}");
+    assert_eq!(NaiveDate::from_num_days_from_ce_opt(d.num_days_from_ce()), Some(d));
+    assert_eq!(civil_from_days(days), (y, m, day));
+    // components
+    assert_eq!(d.ordinal() as i64, ordinal(y, m, day), "{d:?}");
+    assert_eq!(d.ordinal0() + 1, d.ordinal());
+    assert_eq!(d.month0() + 1, d.month());
+    assert_eq!(d.day0() + 1, d.day());
+    assert_eq!(d.leap_year(), is_leap(y), "{d:?}");
+    assert_eq!(d.weekday().number_from_monday() as i64, iso_weekday(days), "{d:?}");
+    assert_eq!(d.weekday().num_days_from_monday() + 1, d.weekday().number_from_monday());
+    assert_eq!(d.weekday().number_from_sunday() as i64, iso_weekday(days) % 7 + 1, "{d:?}");
+    assert_eq!(d.quarter(), (d.month() - 1) / 3 + 1);
+    let (iy, iw) = iso_week(y, m, day);
+    assert_eq!((d.iso_week().year() as i64, d.iso_week().week() as i64), (iy, iw), "{d:?}");
+    assert_eq!(d.iso_week().week0() + 1, d.iso_week().week());
+    // constructors agree
+    assert_eq!(NaiveDate::from_ymd_opt(d.year(), d.month(), d.day()), Some(d));
+    assert_eq!(NaiveDate::from_yo_opt(d.year(), d.ordinal()), Some(d));
+    assert_eq!(NaiveDate::from_isoywd_opt(d.iso_week().year(), d.iso_week().week(), d.weekday()), Some(d), "{d:?}");
+    assert_eq!(NaiveDate::from_ymd_opt(d.year(), d.month(), days_in_month(y, m) as u32 + 1), None, "{d:?}");
+    assert_eq!(NaiveDate::from_yo_opt(d.year(), if is_leap(y) { 367 } else { 366 }), None);
+    assert_eq!(NaiveDate::from_yo_opt(d.year(), 0), None);
+    assert_eq!(NaiveDate::from_ymd_opt(d.year(), 13, 1), None);
+    assert_eq!(NaiveDate::from_ymd_opt(d.year(), d.month(), 0), None);
+    // the nth weekday of the month
+    let nth = (d.day() - 1) / 7 + 1;
+    assert_eq!(NaiveDate::from_weekday_of_month_opt(d.year(), d.month(), d.weekday(), nth as u8), Some(d), "{d:?}");
+    let last_such = day + 7 * ((days_in_month(y, m) - day) / 7);
+    assert_eq!(
+        NaiveDate::from_weekday_of_month_opt(d.year(), d.month(), d.weekday(), nth as u8 + ((last_such - day) / 7) as u8 + 1),
+        None,
+        "{d:?}: no weekday of the month after the last"
+    );
+    // neighbours
+    assert_eq!(d.succ_opt().map(|n| n.num_days_from_ce()), if d == NaiveDate::MAX { None } else { Some(d.num_days_from_ce() + 1) });
+    assert_eq!(d.pred_opt().map(|n| n.num_days_from_ce()), if d == NaiveDate::MIN { None } else { Some(d.num_days_from_ce() - 1) });
+    // setters: `with_*` behaves like the constructor with one component replaced
+    for ny in [d.year() - 1, d.year() + 1, 2000, 1900, 2024] {
+        assert_eq!(d.with_year(ny), NaiveDate::from_ymd_opt(ny, d.month(), d.day()), "{d:?} with_year {ny}");
+    }
+    for nm in 1..=12u32 {
+        assert_eq!(d.with_month(nm), NaiveDate::from_ymd_opt(d.year(), nm, d.day()), "{d:?} with_month {nm}");
+    }
+    for nd in [1u32, 28, 29, 30, 31, 32] {
+        assert_eq!(d.with_day(nd), NaiveDate::from_ymd_opt(d.year(), d.month(), nd), "{d:?} with_day {nd}");
+    }
+    for no in [1u32, 59, 60, 365, 366, 367] {
+        assert_eq!(d.with_ordinal(no), NaiveDate::from_yo_opt(d.year(), no), "{d:?} with_ordinal {no}");
+    }
+    assert_eq!(d.with_month0(d.month0()), Some(d));
+    assert_eq!(d.with_day0(d.day0()), Some(d));
+    assert_eq!(d.with_ordinal0(d.ordinal0()), Some(d));
+    // formatting: the ISO date, sign-prefixed outside 0..=9999, round-trips through `FromStr`
+    let text = d.to_string();
+    assert_eq!(text.parse::<NaiveDate>(), Ok(d), "{text}");
+    assert_eq!(format!("{d:?}"), text);
+    let expected = if (0..=9999).contains(&d.year()) {
+        format!("{:04}-{:02}-{:02}", d.year(), d.month(), d.day())
+    } else {
+        format!("{:+05}-{:02}-{:02}", d.year(), d.month(), d.day())
+    };
+    assert_eq!(text, expected);
+    assert_eq!(d.format("%Y-%m-%d").to_string(), expected);
+    assert_eq!(d.format("%F").to_string(), expected);
+    assert_eq!(NaiveDate::parse_from_str(&text, "%Y-%m-%d"), Ok(d));
+    // week numbers
+    assert_eq!(d.format("%U").to_string(), format!("{:02}", week_number(y, m, day, true)), "{d:?}");
+    assert_eq!(d.format("%W").to_string(), format!("{:02}", week_number(y, m, day, false)), "{d:?}");
+    assert_eq!(d.format("%j").to_string(), format!("{:03}", d.ordinal()));
+    assert_eq!(d.format("%u %w").to_string(), format!("{} {}", d.weekday().number_from_monday(), d.weekday().num_days_from_sunday()));
+    assert_eq!(d.format("%V").to_string(), format!("{iw:02}"));
+    if (0..=9999).contains(&iy) {
+        assert_eq!(d.format("%G").to_string(), format!("{iy:04}"));
+        assert_eq!(NaiveDate::parse_from_str(&d.format("%G-W%V-%u").to_string(), "%G-W%V-%u"), Ok(d), "{d:?}");
+    }
+    if (0..=9999).contains(&d.year()) {
+        assert_eq!(d.format("%C%y").to_string(), format!("{:04}", d.year()));
+        assert_eq!(NaiveDate::parse_from_str(&d.format("%Y-%j").to_string(), "%Y-%j"), Ok(d));
+        assert_eq!(NaiveDate::parse_from_str(&d.format("%A, %B %e, %Y").to_string(), "%A, %B %e, %Y"), Ok(d), "{d:?}");
+        assert_eq!(NaiveDate::parse_from_str(&d.format("%a %b %d %Y").to_string(), "%a %b %d %Y"), Ok(d), "{d:?}");
+        assert_eq!(NaiveDate::parse_from_str(&d.format("%v").to_string(), "%v"), Ok(d), "{d:?}");
+        assert_eq!(NaiveDate::parse_from_str(&d.format("%Y%m%d").to_string(), "%Y%m%d"), Ok(d), "{d:?}");
+        // a wrong weekday is rejected
+        let other = d.succ_opt().unwrap_or(d.pred_opt().unwrap());
+        let wrong = format!("{} {}", other.format("%a"), d.format("%F"));
+        assert!(NaiveDate::parse_from_str(&wrong, "%a %F").is_err(), "{wrong}");
+    }
+}
+
+/// `iter_days`/`iter_weeks` "step across all representable dates" starting from `self`: from
+/// `k` days before `NaiveDate::MAX` that is `k + 1` days and `k / 7 + 1` weeks. The day iterator
+/// stops before `MAX`, the week iterator before the last representable week. KNOWN FAILURE
+/// chrono/4.
+#[hegel::test]
+fn iterators_start_from_the_date_itself(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_date());
+    let k = tc.draw(int!(0u64, 60));
+    assert_eq!(d.iter_days().next(), Some(d), "{d:?}");
+    assert_eq!(d.iter_weeks().next(), Some(d), "{d:?}");
+    let near = NaiveDate::MAX.checked_sub_days(Days::new(k)).unwrap();
+    assert_eq!(near.iter_days().count() as u64, k + 1, "{near:?}: days up to MAX");
+    assert_eq!(near.iter_weeks().count() as u64, k / 7 + 1, "{near:?}: weeks up to MAX");
+    assert_eq!(near.iter_weeks().last(), near.checked_add_days(Days::new(k / 7 * 7)), "{near:?}: the last week");
+}
+
+#[hegel::test]
+fn date_arithmetic_matches_the_model(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_date());
+    let D(e) = tc.draw(arb_date());
+    let n = match tc.draw(int!(0u8, 2)) {
+        0 => tc.draw(int!(0u64, 100)),
+        1 => tc.draw(int!(0u64, 200_000_000)),
+        _ => tc.draw(generators::integers::<u64>()),
+    };
+    let months = tc.draw(int!(0u32, 4_000_000));
+    let days = days_from_civil(d.year() as i64, d.month() as i64, d.day() as i64);
+    let lo = NaiveDate::MIN.num_days_from_ce() as i64 - 719_163;
+    let hi = NaiveDate::MAX.num_days_from_ce() as i64 - 719_163;
+    // days
+    let expect = |target: i128| -> Option<NaiveDate> {
+        if target < lo as i128 || target > hi as i128 {
+            None
+        } else {
+            let (y, m, dd) = civil_from_days(target as i64);
+            Some(NaiveDate::from_ymd_opt(y as i32, m as u32, dd as u32).unwrap())
+        }
+    };
+    assert_eq!(d.checked_add_days(Days::new(n)), expect(days as i128 + n as i128), "{d:?} + {n} days");
+    assert_eq!(d.checked_sub_days(Days::new(n)), expect(days as i128 - n as i128), "{d:?} - {n} days");
+    if let Ok(signed) = i64::try_from(n) {
+        assert_eq!(d.checked_add_signed(TimeDelta::try_days(signed).unwrap_or(TimeDelta::MAX)), if TimeDelta::try_days(signed).is_some() { expect(days as i128 + n as i128) } else { None });
+        assert_eq!(d.checked_sub_signed(TimeDelta::try_days(signed).unwrap_or(TimeDelta::MAX)), if TimeDelta::try_days(signed).is_some() { expect(days as i128 - n as i128) } else { None });
+    }
+    // differences
+    let edays = days_from_civil(e.year() as i64, e.month() as i64, e.day() as i64);
+    assert_eq!(d.signed_duration_since(e), TimeDelta::try_days(days - edays).unwrap(), "{d:?} - {e:?}");
+    assert_eq!(d - e, TimeDelta::try_days(days - edays).unwrap());
+    assert_eq!(e + (d - e), d);
+    assert_eq!(d.cmp(&e), days.cmp(&edays));
+    // months: the month index moves, the day is clamped to the target month
+    let expect_months = |delta: i64| -> Option<NaiveDate> {
+        let index = d.year() as i64 * 12 + (d.month() as i64 - 1) + delta;
+        let (y, m) = (index.div_euclid(12), index.rem_euclid(12) + 1);
+        if y < NaiveDate::MIN.year() as i64 || y > NaiveDate::MAX.year() as i64 {
+            return None;
+        }
+        let dd = (d.day() as i64).min(days_in_month(y, m));
+        NaiveDate::from_ymd_opt(y as i32, m as u32, dd as u32)
+    };
+    assert_eq!(d.checked_add_months(Months::new(months)), expect_months(months as i64), "{d:?} + {months} months");
+    assert_eq!(d.checked_sub_months(Months::new(months)), expect_months(-(months as i64)), "{d:?} - {months} months");
+    // iterators (near MAX: `iterators_start_from_the_date_itself`)
+    let step = (n % 5) as usize;
+    if (hi - days) as usize >= 7 * step {
+        let by_days: Vec<NaiveDate> = d.iter_days().take(step).collect();
+        assert_eq!(by_days, (0..step as i128).filter_map(|i| expect(days as i128 + i)).collect::<Vec<_>>(), "{d:?} days");
+        let by_weeks: Vec<NaiveDate> = d.iter_weeks().take(step).collect();
+        assert_eq!(by_weeks, (0..step as i128).filter_map(|i| expect(days as i128 + 7 * i)).collect::<Vec<_>>(), "{d:?} weeks");
+        let back: Vec<NaiveDate> = d.iter_days().take(step).rev().collect();
+        assert_eq!(back, by_days.iter().rev().copied().collect::<Vec<_>>(), "{d:?} reversed");
+    }
+    // the day count checks the same range
+    assert_eq!(NaiveDate::from_num_days_from_ce_opt(NaiveDate::MAX.num_days_from_ce()).is_some(), true);
+    assert_eq!(NaiveDate::from_num_days_from_ce_opt(NaiveDate::MAX.num_days_from_ce().checked_add(1).unwrap()), None);
+    assert_eq!(NaiveDate::from_num_days_from_ce_opt(NaiveDate::MIN.num_days_from_ce() - 1), None);
+}
