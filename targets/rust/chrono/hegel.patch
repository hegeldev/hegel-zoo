+#[hegel::test]
+fn dates_agree_with_jiff(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_jiff_date());
+    let D(e) = tc.draw(arb_jiff_date());
+    let n = tc.draw(int!(-4_000_000i64, 4_000_000));
+    let months = tc.draw(int!(-120_000i32, 120_000));
+    let j = jiff_date(d);
+    assert_eq!(d.weekday().number_from_monday() as i8, j.weekday().to_monday_one_offset(), "{d:?}");
+    assert_eq!(d.ordinal() as i16, j.day_of_year(), "{d:?}");
+    assert_eq!(d.leap_year(), j.in_leap_year());
+    let iso = j.iso_week_date();
+    assert_eq!((d.iso_week().year() as i16, d.iso_week().week() as i8), (iso.year(), iso.week()), "{d:?}");
+    assert_eq!(jiff_weekday(d.weekday()), iso.weekday());
+    assert_eq!(
+        d.with_day(1).map(jiff_date),
+        Some(j.first_of_month()),
+    );
+    assert_eq!(
+        d.checked_add_months(Months::new(1)).and_then(|x| x.with_day(1)).and_then(|x| x.pred_opt()).map(jiff_date),
+        Some(j.last_of_month()),
+        "{d:?}: last of month"
+    );
+    let in_jiff = |x: &NaiveDate| (-9999..=9999).contains(&x.year());
+    assert_eq!(d.succ_opt().filter(in_jiff).map(jiff_date), j.tomorrow().ok(), "{d:?}");
+    assert_eq!(d.pred_opt().filter(in_jiff).map(jiff_date), j.yesterday().ok(), "{d:?}");
+    // day arithmetic, within jiff's range
+    let plus = d.checked_add_signed(TimeDelta::try_days(n).unwrap()).filter(|x| (-9999..=9999).contains(&x.year()));
+    assert_eq!(plus.map(jiff_date), j.checked_add(jiff::Span::new().try_days(n).unwrap()).ok(), "{d:?} + {n} days");
+    // month arithmetic: both clamp the day to the target month
+    let plus = if months >= 0 { d.checked_add_months(Months::new(months as u32)) } else { d.checked_sub_months(Months::new(months.unsigned_abs())) };
+    let plus = plus.filter(|x| (-9999..=9999).contains(&x.year()));
+    assert_eq!(plus.map(jiff_date), j.checked_add(jiff::Span::new().try_months(months).unwrap()).ok(), "{d:?} + {months} months");
+    // differences in days
+    let je = jiff_date(e);
+    assert_eq!(d.signed_duration_since(e).num_days(), i64::from(j.since(je).unwrap().get_days()), "{d:?} - {e:?}");
+    // the nth weekday of the month
+    let nth = ((d.day() - 1) / 7 + 1) as i8;
+    assert_eq!(j.nth_weekday_of_month(nth, jiff_weekday(d.weekday())).unwrap(), j);
+    for k in 1..=5u8 {
+        let c = NaiveDate::from_weekday_of_month_opt(d.year(), d.month(), d.weekday(), k);
+        let jj = j.nth_weekday_of_month(k as i8, jiff_weekday(d.weekday())).ok();
+        assert_eq!(c.map(jiff_date), jj, "{d:?}: weekday {k}");
+    }
+    // ISO week date round trip in jiff's terms
+    let from_iso = civil::Date::from_iso_week_date(civil::ISOWeekDate::new(d.iso_week().year() as i16, d.iso_week().week() as i8, jiff_weekday(d.weekday())).unwrap());
+    assert_eq!(from_iso, j);
+}
