+// ----------------------------------------------------------------------------------------------
+// rounding
+
+#[hegel::test]
+fn rounding_matches_the_model(tc: hegel::TestCase) {
+    let Dt(dt) = tc.draw(arb_jiff_datetime());
+    let Off(off) = tc.draw(arb_offset());
+    let digits = tc.draw(int!(0u16, 12));
+    let span = match tc.draw(int!(0u8, 4)) {
+        0 => TimeDelta::nanoseconds(tc.draw(int!(1i64, 1_000_000_000))),
+        1 => TimeDelta::try_seconds(tc.draw(int!(1i64, 100_000))).unwrap(),
+        2 => TimeDelta::try_minutes(tc.draw(generators::sampled_from(vec![1i64, 5, 10, 15, 30, 60, 90, 1440]))).unwrap(),
+        3 => TimeDelta::try_days(tc.draw(int!(1i64, 400))).unwrap(),
+        _ => tc.draw(generators::sampled_from(vec![
+            Delta(TimeDelta::zero()),
+            Delta(TimeDelta::nanoseconds(-1)),
+            Delta(TimeDelta::try_days(-1).unwrap()),
+            Delta(TimeDelta::MAX),
+            Delta(TimeDelta::MIN),
+            Delta(TimeDelta::nanoseconds(i64::MAX)),
+            Delta(TimeDelta::try_milliseconds(i64::MAX / 1_000_000).unwrap()),
+        ])).0,
+    };
+    let local = dt.and_local_timezone(off).unwrap();
+    let utc = dt.and_utc();
+    // subsecond rounding: halfway rounds up, digits ≥ 9 leave it alone
+    let n = dt.nanosecond() as i128;
+    let unit = 10i128.pow(9 - digits.min(9) as u32);
+    let down = n / unit * unit;
+    let up = down + unit;
+    let rounded = if n - down >= up - n && n != down { up } else { down };
+    let with = |target: i128| -> NaiveDateTime { dt.with_nanosecond(0).unwrap() + TimeDelta::nanoseconds(target as i64) };
+    assert_eq!(dt.trunc_subsecs(digits), with(down), "{dt:?} trunc {digits}");
+    assert_eq!(dt.round_subsecs(digits), with(rounded), "{dt:?} round {digits}");
+    assert_eq!(utc.round_subsecs(digits).naive_utc(), with(rounded));
+    assert_eq!(local.round_subsecs(digits).naive_local(), with(rounded) + (local.naive_local() - dt));
+    assert_eq!(dt.time().trunc_subsecs(digits), with(down).time());
+    // rounding by a duration: on the *local* wall clock nanoseconds since the epoch
+    let model = |value: NaiveDateTime| -> Result<(i128, i128, i128), RoundingError> {
+        let span_nanos = i64::try_from(delta_nanos(span)).map_err(|_| RoundingError::DurationExceedsLimit)?;
+        if span_nanos <= 0 {
+            return Err(RoundingError::DurationExceedsLimit);
+        }
+        let stamp = i64::try_from(nanos_of(value)).map_err(|_| RoundingError::TimestampExceedsLimit)? as i128;
+        let span_nanos = span_nanos as i128;
+        let floor = stamp.div_euclid(span_nanos) * span_nanos;
+        let rem = stamp.rem_euclid(span_nanos);
+        let ceil = if rem == 0 { floor } else { floor + span_nanos };
+        let round = if rem == 0 { floor } else if rem * 2 >= span_nanos { ceil } else { floor };
+        Ok((floor, round, ceil))
+    };
+    for (name, value, result_nanos) in [
+        ("naive", dt, dt.duration_trunc(span).map(nanos_of).and_then(|f| Ok((f, nanos_of(dt.duration_round(span)?), nanos_of(dt.duration_round_up(span)?))))),
+        ("utc", dt, utc.duration_trunc(span).map(|x| nanos_of(x.naive_utc())).and_then(|f| Ok((f, nanos_of(utc.duration_round(span)?.naive_utc()), nanos_of(utc.duration_round_up(span)?.naive_utc()))))),
+        ("local", local.naive_local(), local.duration_trunc(span).map(|x| nanos_of(x.naive_local())).and_then(|f| Ok((f, nanos_of(local.duration_round(span)?.naive_local()), nanos_of(local.duration_round_up(span)?.naive_local()))))),
+    ] {
+        let expected = model(value);
+        // the result must exist as a NaiveDateTime; the model only knows nanoseconds
+        match (&expected, &result_nanos) {
+            (Ok(e), Ok(r)) => assert_eq!(r, e, "{name}: {value:?} by {span:?}"),
+            (Err(e), Err(r)) => assert_eq!(r, e, "{name}: {value:?} by {span:?}"),
+            _ => panic!("{name}: {value:?} by {span:?}: model {expected:?}, chrono {result_nanos:?}"),
+        }
+    }
+    // a rounded value is a multiple of the span and within a span of the input (naive)
+    if let Ok(r) = dt.duration_round(span) {
+        let s = delta_nanos(span);
+        assert_eq!(nanos_of(r).rem_euclid(s), 0);
+        assert!((nanos_of(r) - nanos_of(dt)).abs() * 2 <= s, "{dt:?} by {span:?} → {r:?}");
+        assert!(nanos_of(dt.duration_trunc(span).unwrap()) <= nanos_of(dt));
+        assert!(nanos_of(dt.duration_round_up(span).unwrap()) >= nanos_of(dt));
+        assert_eq!(dt.duration_trunc(span).unwrap().duration_trunc(span), dt.duration_trunc(span), "idempotent");
+        assert_eq!(r.duration_round(span), Ok(r), "idempotent");
+    }
+}
