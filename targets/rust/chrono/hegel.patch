+#[hegel::test]
+fn datetime_arithmetic_matches_the_model(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_date());
+    let T(t) = tc.draw(arb_time());
+    let dt = d.and_time(t);
+    let Delta(delta) = tc.draw(arb_delta());
+    let Dt(other) = tc.draw(arb_jiff_datetime());
+    let nanos = nanos_of(dt);
+    let lo = nanos_of(NaiveDateTime::MIN);
+    let hi = nanos_of(NaiveDateTime::MAX);
+    let expect = |target: i128| -> Option<NaiveDateTime> {
+        if target < lo || target > hi {
+            return None;
+        }
+        let days = target.div_euclid(86_400 * 1_000_000_000);
+        let rest = target.rem_euclid(86_400 * 1_000_000_000);
+        let (y, m, dd) = civil_from_days(days as i64);
+        let date = NaiveDate::from_ymd_opt(y as i32, m as u32, dd as u32)?;
+        Some(date.and_time(NaiveTime::from_num_seconds_from_midnight_opt((rest / 1_000_000_000) as u32, (rest % 1_000_000_000) as u32).unwrap()))
+    };
+    let sum = dt.checked_add_signed(delta);
+    assert_eq!(sum, expect(nanos + delta_nanos(delta)), "{dt:?} + {delta:?}");
+    assert_eq!(dt.checked_sub_signed(delta), expect(nanos - delta_nanos(delta)), "{dt:?} - {delta:?}");
+    if let Some(sum) = sum {
+        assert_eq!(dt + delta, sum);
+        assert_eq!(sum - delta, dt);
+        assert_eq!(sum.signed_duration_since(dt), delta);
+        assert_eq!(sum - dt, delta);
+        assert_eq!(dt.and_utc() + delta, sum.and_utc());
+        assert_eq!((sum.and_utc() - dt.and_utc()), delta);
+    }
+    assert_eq!(delta_nanos(dt.signed_duration_since(other)), nanos - nanos_of(other), "{dt:?} - {other:?}");
+    assert_eq!(dt.cmp(&other), nanos.cmp(&nanos_of(other)));
+    // whole days and months go through the date
+    let n = tc.draw(int!(0u64, 1_000_000_000));
+    assert_eq!(dt.checked_add_days(Days::new(n)), d.checked_add_days(Days::new(n)).map(|x| x.and_time(t)));
+    assert_eq!(dt.checked_sub_days(Days::new(n)), d.checked_sub_days(Days::new(n)).map(|x| x.and_time(t)));
+    let months = tc.draw(int!(0u32, 10_000_000));
+    assert_eq!(dt.checked_add_months(Months::new(months)), d.checked_add_months(Months::new(months)).map(|x| x.and_time(t)));
+    assert_eq!(dt.checked_sub_months(Months::new(months)), d.checked_sub_months(Months::new(months)).map(|x| x.and_time(t)));
+    // std::time::Duration too
+    let std_dur = std::time::Duration::new(n, (n % 1_000_000_000) as u32);
+    let via_std = dt.checked_add_signed(TimeDelta::from_std(std_dur).unwrap_or(TimeDelta::MAX)).filter(|_| TimeDelta::from_std(std_dur).is_ok());
+    assert_eq!(dt.and_utc().checked_add_signed(TimeDelta::from_std(std_dur).unwrap_or(TimeDelta::MAX)).filter(|_| TimeDelta::from_std(std_dur).is_ok()).map(|x| x.naive_utc()), via_std);
+    assert_eq!(dt.date(), d);
+    assert_eq!(dt.time(), t);
+    assert_eq!(NaiveDateTime::new(d, t), dt);
+    assert_eq!(d.and_hms_nano_opt(t.hour(), t.minute(), t.second(), t.nanosecond()), Some(dt));
+}
