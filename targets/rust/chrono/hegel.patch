+// ----------------------------------------------------------------------------------------------
+// strftime, differential against jiff and round trips
+
+/// Specifiers whose formatting both libraries define the same way (no locale, no `%.f` family,
+/// no `%Z`/`%+`/`%v`; `%C` is zero-padded to two digits by chrono and not padded by jiff; `%:::z`
+/// drops the minutes in chrono and prints them when non-zero in jiff; `%s` of a time before the epoch
+/// with a fraction is the floor in chrono and truncated toward zero in jiff).
+const SHARED_SPECIFIERS: &[&str] = &[
+    "%Y", "%y", "%m", "%b", "%B", "%h", "%d", "%e", "%a", "%A", "%w", "%u", "%U", "%W", "%G", "%g",
+    "%V", "%j", "%D", "%F", "%H", "%k", "%I", "%l", "%P", "%p", "%M", "%S", "%R", "%T", "%z", "%:z", "%::z",
+    "%q", "%t", "%n", "%%", "%-d", "%_d", "%0e", "%-m", "%_m", "%-j", "%_j", "%-H", "%_H",
+    "%_I", "%-S", "%-y", "%-e", "%0k", "%0l", "%_j",
+];
+
+#[hegel::composite]
+fn arb_format(tc: &hegel::TestCase) -> String {
+    let n = tc.draw(int!(1u8, 8));
+    let mut f = String::new();
+    for i in 0..n {
+        if i > 0 {
+            f.push_str(tc.draw(generators::sampled_from(vec![" ", "-", ":", "/", "T", ", ", "|", "", "  ", "x"])));
+        }
+        f.push_str(tc.draw(generators::sampled_from(SHARED_SPECIFIERS.to_vec())));
+    }
+    f
+}
+
+#[hegel::test]
+fn strftime_agrees_with_jiff(tc: hegel::TestCase) {
+    let Dt(dt) = tc.draw(arb_jiff_datetime());
+    let Off(off) = tc.draw(arb_offset());
+    if dt.year() < 1 {
+        // both libraries print years below 1 differently (`-0001` vs `-000001`); keep to CE years
+        return;
+    }
+    // chrono's `%z` family drops the seconds of an offset, jiff prints them: whole minutes only
+    let off = FixedOffset::east_opt(off.local_minus_utc() / 60 * 60).unwrap();
+    if !jiff_instant_ok(dt, off) {
+        return;
+    }
+    let local = dt.and_local_timezone(off).unwrap();
+    let jz = jiff_datetime(dt).to_zoned(jiff::tz::TimeZone::fixed(jiff::tz::Offset::from_seconds(off.local_minus_utc()).unwrap())).unwrap();
+    for spec in SHARED_SPECIFIERS {
+        let c = local.format(spec).to_string();
+        let j = jiff::fmt::strtime::format(spec, &jz).unwrap_or_else(|e| panic!("jiff can't format {spec}: {e}"));
+        assert_eq!(c, j, "{spec} of {local:?}");
+    }
+    let fmt = tc.draw(arb_format());
+    let c = local.format(&fmt).to_string();
+    let j = jiff::fmt::strtime::format(&fmt, &jz).unwrap();
+    assert_eq!(c, j, "{fmt:?} of {local:?}");
+    // the naive value formats the same for everything but the offset specifiers
+    if !fmt.contains('z') {
+        assert_eq!(dt.format(&fmt).to_string(), c);
+        assert_eq!(jiff::fmt::strtime::format(&fmt, jiff_datetime(dt)).unwrap(), c);
+    }
+}
