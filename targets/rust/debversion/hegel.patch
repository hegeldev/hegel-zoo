+#[hegel::composite]
+fn arb_snapshot(tc: &hegel::TestCase) -> VcsSnapshot {
+    match tc.draw(int!(0u8, 2)) {
+        0 => {
+            let date = if tc.draw(int!(0u8, 3)) == 0 { None } else { chrono::NaiveDate::from_ymd_opt(tc.draw(int!(2000i32, 2030)), tc.draw(int!(1u32, 12)), tc.draw(int!(1u32, 28))) };
+            let sha = if tc.draw(int!(0u8, 3)) == 0 {
+                None
+            } else {
+                let n = tc.draw(int!(7usize, 12));
+                Some((0..n).map(|_| b"0123456789abcdef"[tc.draw(int!(0usize, 15))] as char).collect())
+            };
+            let snapshot = if tc.draw(generators::booleans()) { None } else { Some(tc.draw(int!(1usize, 9))) };
+            VcsSnapshot::Git { date, sha, snapshot }
+        }
+        1 => VcsSnapshot::Bzr { revno: if tc.draw(int!(0u8, 3)) == 0 { format!("{}.{}.{}", tc.draw(int!(1u32, 9)), tc.draw(int!(1u32, 9)), tc.draw(int!(1u32, 9))) } else { tc.draw(int!(1u32, 9999)).to_string() } },
+        _ => VcsSnapshot::Svn { revno: tc.draw(int!(1usize, 99999)) },
+    }
+}
+
+/// The suffix `upstream_version_add_revision` writes (the crate's `to_suffix` is private).
+fn suffix_of(s: &VcsSnapshot) -> String {
+    match s {
+        VcsSnapshot::Git { date, sha, snapshot } => {
+            let gitid = sha.as_deref().map(|s| &s[..s.len().min(7)]);
+            match (gitid, snapshot, date) {
+                (Some(id), Some(n), Some(d)) => format!("git{}.{n}.{id}", d.format("%Y%m%d")),
+                (Some(id), None, Some(d)) => format!("git{}.{id}", d.format("%Y%m%d")),
+                (Some(id), _, None) => format!("git{id}"),
+                (None, _, Some(d)) => format!("git{}", d.format("%Y%m%d")),
+                (None, _, None) => "git".to_string(),
+            }
+        }
+        VcsSnapshot::Bzr { revno } => format!("bzr{revno}"),
+        VcsSnapshot::Svn { revno } => format!("svn{revno}"),
+    }
+}
+
+/// What `get_revision` should read back: the sha cut to 7 characters.
+fn normalized(s: &VcsSnapshot) -> VcsSnapshot {
+    match s {
+        VcsSnapshot::Git { date, sha, snapshot } => VcsSnapshot::Git { date: *date, sha: sha.as_deref().map(|s| s[..s.len().min(7)].to_string()), snapshot: *snapshot },
+        other => other.clone(),
+    }
+}
+
+/// debversion/7: `get_revision` only reads back `git<date>.<sha>`, `git<date>.<n>.<sha>`,
+/// `bzr<digits>` and `svn<digits>` — not the date-only, sha-only or bare `git` suffixes that
+/// `upstream_version_add_revision` writes, nor a dotted bzr revno.
+fn hits_unreadable_suffix_bug(s: &VcsSnapshot) -> bool {
+    match s {
+        VcsSnapshot::Git { date, sha, .. } => date.is_none() || sha.is_none(),
+        VcsSnapshot::Bzr { revno } => !revno.bytes().all(|b| b.is_ascii_digit()),
+        VcsSnapshot::Svn { .. } => false,
+    }
+}
+
+#[hegel::test]
+fn vcs_snapshot_suffixes_are_written_and_read_consistently(tc: hegel::TestCase) {
+    let base = tc.draw(arb_base_upstream());
+    let snap = tc.draw(arb_snapshot().print_as_debug());
+    let dir = if tc.draw(generators::booleans()) { Direction::After } else { Direction::Before };
+    assert_eq!(get_revision(&base), (base.as_str(), None), "a plain version has no snapshot");
+    let written = upstream_version_add_revision(&base, snap.clone(), Some(dir.clone()));
+    assert_eq!(written, format!("{base}{}{}", dir.as_str(), suffix_of(&snap)));
+    assert!(Version::from_str(&written).is_ok(), "{written}");
+    assert!(Version::from_str(&written).unwrap() > Version::from_str(&base).unwrap() || dir == Direction::Before);
+    assert!(Version::from_str(&written).unwrap() < Version::from_str(&base).unwrap() || dir == Direction::After);
+    if hits_unreadable_suffix_bug(&snap) {
+        return; // debversion/7
+    }
+    let (read_base, read) = get_revision(&written);
+    assert_eq!(read_base, base, "{written}");
+    assert_eq!(read, Some((dir.clone(), normalized(&snap))), "{written}");
+    // updating replaces the suffix instead of stacking a second one
+    let snap2 = tc.draw(arb_snapshot().print_as_debug());
+    let updated = upstream_version_add_revision(&written, snap2.clone(), None);
+    assert!(updated.starts_with(&format!("{base}{}", dir.as_str())), "{written} -> {updated}");
+    let rest = &updated[base.len() + 1..];
+    assert_eq!(rest.matches("git").count() + rest.matches("bzr").count() + rest.matches("svn").count(), 1, "{written} -> {updated}");
+    // an explicit direction wins, a default keeps the current one
+    let redirected = upstream_version_add_revision(&written, snap2, Some(Direction::After));
+    assert!(redirected.starts_with(&format!("{base}+")), "{redirected}");
+}
+
+/// debversion/7 pinned: every suffix `upstream_version_add_revision` writes is read back by
+/// `get_revision`, so a second update replaces it rather than appending another.
+#[hegel::test]
+fn every_written_snapshot_suffix_is_read_back(tc: hegel::TestCase) {
+    let base = tc.draw(arb_base_upstream());
+    let snap = tc.draw(arb_snapshot().print_as_debug());
+    if matches!(snap, VcsSnapshot::Git { sha: None, date: None, .. }) {
+        return; // a bare `git` carries no information to read back
+    }
+    let written = upstream_version_add_revision(&base, snap.clone(), None);
+    let (read_base, read) = get_revision(&written);
+    assert_eq!((read_base, read), (base.as_str(), Some((Direction::After, normalized(&snap)))), "{written}");
+    let again = upstream_version_add_revision(&written, snap.clone(), None);
+    assert_eq!(again.matches("git").count() + again.matches("bzr").count() + again.matches("svn").count(), 1, "{written} -> {again}");
+}
