+/// `Eq` is by comparison (`1.0 == 1.0-0 == 0:1.0`); `Hash` must follow.
+#[hegel::test]
+fn equal_versions_hash_equally(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    let mut twins = vec![
+        Version { epoch: Some(v.epoch.unwrap_or(0)), ..v.clone() },
+        Version { debian_revision: Some(v.debian_revision.clone().unwrap_or("0".to_string())), ..v.clone() },
+        Version { upstream_version: format!("0{}", v.upstream_version), ..v.clone() },
+    ];
+    if v.debian_revision.is_none() || v.debian_revision.as_deref() == Some("0") {
+        twins.push(Version { debian_revision: Some("00".to_string()), ..v.clone() });
+    }
+    for t in twins {
+        if t.upstream_version.starts_with("00") && !v.upstream_version.starts_with(|c: char| c.is_ascii_digit()) {
+            continue;
+        }
+        assert_eq!(t, v, "{t} vs {v}");
+        assert_eq!(hash_of(&t), hash_of(&v), "{t} == {v} but the hashes differ");
+    }
+}
