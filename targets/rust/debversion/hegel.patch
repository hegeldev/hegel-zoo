+    }
+    assert!(Version::from_str(&with).is_ok());
+    assert!(Version::from_str(&with).unwrap() > Version::from_str(&base).unwrap() || with.contains('~'));
+}
+
+#[hegel::test]
+fn vendors_round_trip(tc: hegel::TestCase) {
+    let vendor = tc.draw(generators::sampled_from(vec![Vendor::Debian, Vendor::Ubuntu, Vendor::Kali]).print_as_debug());
+    let shown = vendor.to_string();
+    assert_eq!(Vendor::from_str(&shown), Ok(vendor));
+    assert_eq!(Vendor::from_str(&shown.to_lowercase()), Ok(vendor));
+    assert_eq!(Vendor::from_str(&shown.to_uppercase()), Ok(vendor));
+    let junk = tc.draw(arb_word());
+    if Vendor::from_str(&junk).is_ok() {
+        assert!(junk.eq_ignore_ascii_case("debian") || junk.eq_ignore_ascii_case("ubuntu") || junk.eq_ignore_ascii_case("kali"));
+    } else {
+        assert_eq!(Vendor::from_str(&junk).unwrap_err().to_string(), format!("Unknown vendor: {junk}"));
+    }
+    let rev = initial_debian_revision(vendor);
+    let base = tc.draw(arb_base_upstream());
+    let v = Version::from_str(&format!("{base}-{rev}")).unwrap();
+    assert_eq!(v.debian_revision.as_deref(), Some(rev));
+    assert!(v > Version::from_str(&base).unwrap());
+    let mut w = v.clone();
+    w.increment_debian();
+    assert!(w > v);
+    assert_eq!(Direction::from("~"), Direction::Before);
+    assert_eq!(Direction::from("+"), Direction::After);
+    assert_eq!(<&str>::from(Direction::Before), "~");
+}
+
+/// debversion/1 pinned: dpkg skips leading zeros before comparing digit runs, so a missing run
+/// equals a run of zeros — `1.` == `1.0`, `1.0a` == `1.0a0`, `1.0-1` == `1.0-1.00`.
+#[hegel::test]
+fn empty_digit_runs_compare_equal_to_zeros(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    let zeros = "0".repeat(tc.draw(int!(1usize, 3)));
+    let (short, long) = match tc.draw(int!(0u8, 2)) {
+        0 => (format!("{}.", v.upstream_version), format!("{}.{zeros}", v.upstream_version)),
+        1 => (format!("{}a", v.upstream_version), format!("{}a{zeros}", v.upstream_version)),
+        _ => (format!("{}~", v.upstream_version), format!("{}~{zeros}", v.upstream_version)),
+    };
+    let (a, b) = (Version { upstream_version: short, ..v.clone() }, Version { upstream_version: long, ..v.clone() });
+    assert_eq!(oracle_cmp(&a.to_string(), &b.to_string()), Ordering::Equal, "dpkg on {a} vs {b}");
+    assert_eq!(a.cmp(&b), Ordering::Equal, "{a} vs {b}");
+    assert_eq!(a, b);
+}
+
+/// debversion/2 pinned: the strict parser (`FromStr`, "enforces strict Debian Policy
+/// compliance") accepts texts dpkg refuses: a colon without a numeric epoch, an empty
+/// revision, an empty upstream version, an epoch beyond `INT_MAX`.
+#[hegel::test]
+fn strict_parser_rejects_what_dpkg_rejects(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    let bad = match tc.draw(int!(0u8, 4)) {
+        0 => format!("{}:{}", v.upstream_version, tc.draw(int!(0u8, 9))),
+        1 => format!("{text}-"),
+        2 => format!("{}:-{}", v.epoch.unwrap_or(1), v.upstream_version),
+        3 => format!("{text}-:{}", tc.draw(int!(0u8, 9))),
+        _ => format!("{}:{}", tc.draw(generators::sampled_from(vec!["2147483648", "4294967295"])), v.upstream_version.split(':').next_back().unwrap()),
+    };
+    let Some(false) = dpkg_valid(&bad) else {
+        return; // dpkg accepts (e.g. the upstream part already carried an epoch's colon)
+    };
+    assert!(Version::from_str(&bad).is_err(), "{bad:?} parses as {:?}", Version::from_str(&bad).map(|v| (v.epoch, v.upstream_version, v.debian_revision)));
+}
+
+/// debversion/9: `canonicalize` drops an explicit `0:` epoch and a `-0` revision even when the
+/// upstream part contains a colon or a hyphen and so needs them: `0:1.0:2` -> `1.0:2` (dpkg:
+/// "epoch in version is not number"), `1.0--0` -> `1.0-` ("revision number is empty"),
+/// `1.0-1-0` -> `1.0-1`, a different version.
+#[hegel::test]
+fn canonicalize_keeps_the_separators_the_upstream_needs(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    let plain = v.upstream_version.split([':', '-']).next().unwrap().to_string();
+    let w = match tc.draw(int!(0u8, 2)) {
+        0 => Version { epoch: Some(0), upstream_version: format!("{plain}:{}", tc.draw(int!(0u8, 9))), debian_revision: v.debian_revision.clone() },
+        1 => Version { epoch: v.epoch, upstream_version: format!("{plain}-"), debian_revision: Some("0".repeat(tc.draw(int!(1usize, 2)))) },
+        _ => Version { epoch: v.epoch, upstream_version: format!("{plain}-{}", tc.draw(int!(0u8, 9))), debian_revision: Some("0".to_string()) },
+    };
+    let shown = w.to_string();
+    assert_eq!(dpkg_valid(&shown), Some(true), "{shown}");
+    let c = w.canonicalize();
+    assert_eq!(dpkg_valid(&c.to_string()), Some(true), "{shown} canonicalized to {c}, which dpkg refuses");
+    assert_eq!(oracle_cmp(&c.to_string(), &shown), Ordering::Equal, "{c} vs {shown}");
+    assert_eq!(Version::from_str(&c.to_string()).map(|x| parts(&x)), Ok(parts(&c)), "{c} does not read back");
+}
