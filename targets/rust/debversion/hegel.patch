+/// debversion/5: a binNMU of a sourceful NMU (`1.0-1+nmu1+b1`) is still an NMU.
+#[hegel::test]
+fn nmu_count_survives_a_bin_nmu(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    let part = v.debian_revision.clone().unwrap_or_else(|| v.upstream_version.clone());
+    if part.contains("+b") || part.contains("+nmu") {
+        return;
+    }
+    let n = tc.draw(int!(1i32, 3));
+    let nmu = if v.debian_revision.is_some() { Version { debian_revision: Some(format!("{part}+nmu{n}")), ..v.clone() } } else { Version { upstream_version: format!("{part}+nmu{n}"), ..v.clone() } };
+    assert_eq!(nmu.nmu_count(), Some(n), "{nmu}");
+    assert!(nmu.is_nmu());
+    let bin = nmu.clone().increment_bin_nmu();
+    assert_eq!(bin.to_string(), format!("{nmu}+b1"));
+    assert_eq!(bin.bin_nmu_count(), Some(1), "{bin}");
+    assert_eq!(bin.nmu_count(), Some(n), "{bin} is still NMU {n}");
+    assert!(bin.is_nmu(), "{bin}");
