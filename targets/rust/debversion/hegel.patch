+fn trailing_number(s: &str) -> Option<(&str, &str)> {
+    let i = s.rfind(|c: char| !c.is_ascii_digit()).map_or(0, |i| i + 1);
+    if i < s.len() {
+        Some((&s[..i], &s[i..]))
+    } else {
+        None
+    }
+}
