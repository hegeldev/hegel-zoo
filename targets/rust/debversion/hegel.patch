+// --------------------------------------------------------------------------- DEP-14 git tags
+
+#[hegel::test]
+fn mangled_versions_are_valid_git_tags(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    if !text.starts_with(|c: char| c.is_ascii_digit()) {
+        return; // not a policy version; DEP-14 does not say
+    }
+    let tag = mangle_version_for_git(&v);
+    let text = v.to_string();
+    assert!(!tag.contains('~') && !tag.contains(':'), "{tag}");
+    assert_eq!(tag.matches('%').count(), text.matches(':').count());
+    assert_eq!(tag.matches('_').count(), text.matches('~').count());
+    // DEP-14 mangling is reversible on the simple substitutions
+    let back = tag.replace('_', "~").replace('%', ":");
+    if !text.contains("..") && !text.ends_with('.') && !text.ends_with(".lock") {
+        assert_eq!(back, text);
+    }
+    if text.contains("...") {
+        return; // debversion/6
+    }
+    assert!(git_ref_ok(&tag), "{text} -> {tag} is not a valid git tag name");
+}
