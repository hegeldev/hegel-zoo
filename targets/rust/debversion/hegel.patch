+    let style = old.and_then(|o| o.find(['+', '~']).map(|i| &o[i..])).filter(|s| s.starts_with("+dfsg") || s.starts_with("+ds") || s.starts_with("~ds") || s.starts_with("~dfsg"));
+    match style {
