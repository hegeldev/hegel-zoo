+#[hegel::composite]
+fn arb_base_upstream(tc: &hegel::TestCase) -> String {
+    let mut s = tc.draw(int!(0u32, 20)).to_string();
+    for _ in 0..tc.draw(int!(0usize, 3)) {
+        s.push('.');
+        s.push_str(&tc.draw(int!(0u32, 20)).to_string());
+    }
+    match tc.draw(int!(0u8, 4)) {
+        0 => s.push_str("~rc1"),
+        1 => s.push_str("+really1.0"),
+        2 => s.push_str("~beta2"),
+        _ => {}
+    }
+    s
+}
