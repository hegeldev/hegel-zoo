+//! Hegel properties for `debversion`.
+//!
+//! Oracles: `dpkg` itself (`--validate-version` for what is a version, `--compare-versions` as
+//! the fallback comparator), `apt_pkg.version_compare` from python3-apt (libapt's comparator, the
+//! same algorithm as dpkg, driven as a persistent `/usr/bin/python3` child) and python-debian's
+//! `Version` for the epoch/upstream/revision split. `git check-ref-format` judges the DEP-14
+//! tag mangling. Alongside: `Ord`/`Eq`/`Hash` laws, `canonicalize`, the increment helpers, the
+//! binNMU/NMU suffix helpers and the VCS snapshot suffixes of `debversion::upstream`.
+#![allow(clippy::all, dead_code)]
+
+use debversion::upstream::{add_dfsg_suffix, get_revision, strip_dfsg_suffix, upstream_version_add_revision, Direction, VcsSnapshot};
+use debversion::vcs::mangle_version_for_git;
+use debversion::vendor::{initial_debian_revision, Vendor};
+use debversion::{AsVersion, Version};
+use hegel::generators;
+use hegel::generators::Generator;
+use std::cmp::Ordering;
+use std::hash::{DefaultHasher, Hash, Hasher};
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::str::FromStr;
+use std::sync::{Mutex, OnceLock};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+// --------------------------------------------------------------------------- oracles
+
+const ORACLE_SCRIPT: &str = r#"
+import sys
+try:
+    import apt_pkg
+    apt_pkg.init()
+    have_apt = True
+except Exception:
+    have_apt = False
+try:
+    from debian.debian_support import Version as DV
+    have_deb = True
+except Exception:
+    have_deb = False
+
+def dec(h):
+    return bytes.fromhex(h).decode('utf-8')
+
+def enc(s):
+    return s.encode('utf-8').hex()
+
+for line in sys.stdin:
+    parts = line.rstrip('\n').split(' ')
+    cmd, args = parts[0], [dec(p) for p in parts[1:]]
+    if cmd == 'C':
+        if not have_apt:
+            out = ['na']
+        else:
+            r = apt_pkg.version_compare(args[0], args[1])
+            out = ['ok', '-1' if r < 0 else ('1' if r > 0 else '0')]
+    elif cmd == 'P':
+        if not have_deb:
+            out = ['na']
+        else:
+            try:
+                v = DV(args[0])
+                out = ['ok', v.epoch or '', v.upstream_version or '', v.debian_revision or '']
+            except Exception:
+                out = ['err']
+    else:
+        out = ['bad']
+    print(' '.join([out[0]] + [enc(x) for x in out[1:]]), flush=True)
+"#;
+
+struct Oracle {
+    child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+static ORACLE: OnceLock<Mutex<Oracle>> = OnceLock::new();
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|b| format!("{b:02x}")).collect()
+}
+
+fn unhex(h: &str) -> String {
+    let bytes: Vec<u8> = (0..h.len()).step_by(2).map(|i| u8::from_str_radix(&h[i..i + 2], 16).unwrap()).collect();
+    String::from_utf8(bytes).unwrap()
+}
+
+fn oracle() -> &'static Mutex<Oracle> {
+    ORACLE.get_or_init(|| {
+        let python = if std::path::Path::new("/usr/bin/python3").exists() { "/usr/bin/python3" } else { "python3" };
+        let mut child = Command::new(python)
+            .arg("-u")
+            .arg("-c")
+            .arg(ORACLE_SCRIPT)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .expect("python3 is needed for the apt_pkg / python-debian oracles");
+        let stdin = child.stdin.take().unwrap();
+        let stdout = BufReader::new(child.stdout.take().unwrap());
+        Mutex::new(Oracle { child, stdin, stdout })
+    })
+}
+
+/// Ask the oracle; returns the status (`ok`, `err`, `na`) and the decoded fields.
+fn ask(cmd: &str, args: &[&str]) -> (String, Vec<String>) {
+    let mut o = oracle().lock().unwrap();
+    let mut line = cmd.to_string();
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a));
+    }
+    line.push('\n');
+    o.stdin.write_all(line.as_bytes()).expect("oracle stdin");
+    let mut reply = String::new();
+    let n = o.stdout.read_line(&mut reply).expect("oracle stdout");
+    if n == 0 {
+        let status = o.child.try_wait().ok().flatten();
+        panic!("the Python oracle exited ({status:?})");
+    }
+    let mut it = reply.trim_end_matches(['\n', '\r']).split(' ');
+    let status = it.next().unwrap().to_string();
+    (status, it.map(unhex).collect())
+}
+
+fn dpkg_compare(a: &str, b: &str, op: &str) -> bool {
+    Command::new("dpkg").args(["--compare-versions", a, op, b]).stderr(Stdio::null()).status().expect("dpkg").success()
+}
+
+/// The reference comparison: libapt's `version_compare`, or `dpkg --compare-versions`.
+fn oracle_cmp(a: &str, b: &str) -> Ordering {
+    let (status, f) = ask("C", &[a, b]);
+    if status == "ok" {
+        return match f[0].as_str() {
+            "-1" => Ordering::Less,
+            "0" => Ordering::Equal,
+            _ => Ordering::Greater,
+        };
+    }
+    if dpkg_compare(a, b, "lt") {
+        Ordering::Less
+    } else if dpkg_compare(a, b, "gt") {
+        Ordering::Greater
+    } else {
+        Ordering::Equal
+    }
+}
+
+/// `dpkg --validate-version`: 0 clean, 1 a warning (a policy "should", e.g. "version number
+/// does not start with digit", or an `_`), 2 an error; `None` when dpkg cannot be asked (a
+/// text starting with `-` is taken as an option).
+fn dpkg_check(text: &str) -> Option<u8> {
+    if text.starts_with('-') {
+        return None;
+    }
+    let out = Command::new("dpkg").args(["--validate-version", text]).stderr(Stdio::piped()).stdout(Stdio::null()).output().expect("dpkg");
+    let err = String::from_utf8_lossy(&out.stderr);
+    Some(if err.contains("error:") { 2 } else if err.contains("warning:") { 1 } else { 0 })
+}
+
+/// `Some(false)` when dpkg reports an error.
+fn dpkg_valid(text: &str) -> Option<bool> {
+    dpkg_check(text).map(|level| level < 2)
+}
+
+/// python-debian's split, `None` if it rejects the text, `Err` when python-debian is missing.
+fn python_debian_parse(text: &str) -> Result<Option<(String, String, String)>, ()> {
+    let (status, f) = ask("P", &[text]);
+    match status.as_str() {
+        "ok" => Ok(Some((f[0].clone(), f[1].clone(), f[2].clone()))),
+        "err" => Ok(None),
+        _ => Err(()),
+    }
+}
+
+fn git_ref_ok(tag: &str) -> bool {
+    Command::new("git").args(["check-ref-format", &format!("refs/tags/{tag}")]).stderr(Stdio::null()).status().expect("git").success()
+}
+
+// --------------------------------------------------------------------------- generators
+
+const LETTERS: &str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
+
+#[hegel::composite]
+fn arb_digits(tc: &hegel::TestCase) -> String {
+    match tc.draw(int!(0u8, 9)) {
+        0 => "0".to_string(),
+        1 => format!("0{}", tc.draw(int!(0u32, 99))),
+        2 => "00".to_string(),
+        3 => "2147483647".to_string(),
+        4 => "2147483648".to_string(),
+        5 => "18446744073709551616".to_string(),
+        6 => "123456789012345678901234567890".to_string(),
+        _ => tc.draw(int!(0u32, 30)).to_string(),
+    }
+}
+
+#[hegel::composite]
+fn arb_word(tc: &hegel::TestCase) -> String {
+    match tc.draw(int!(0u8, 9)) {
+        0 => "rc".to_string(),
+        1 => "ubuntu".to_string(),
+        2 => "dfsg".to_string(),
+        3 => "really".to_string(),
+        4 => "b".to_string(),
+        5 => "nmu".to_string(),
+        6 => "beta".to_string(),
+        7 => "bpo".to_string(),
+        _ => {
+            let n = tc.draw(int!(1usize, 3));
+            (0..n).map(|_| LETTERS.as_bytes()[tc.draw(int!(0usize, LETTERS.len() - 1))] as char).collect()
+        }
+    }
+}
+
+/// An upstream version: policy says it should start with a digit and contain `A-Za-z0-9.+~`,
+/// with `-` allowed when there is a revision and `:` when there is an epoch.
+#[hegel::composite]
+fn arb_upstream(tc: &hegel::TestCase, allow_hyphen: bool, allow_colon: bool) -> String {
+    let mut s = tc.draw(arb_digits());
+    let n = tc.draw(int!(0usize, 5));
+    for _ in 0..n {
+        match tc.draw(int!(0u8, 11)) {
+            0..=3 => {
+                s.push('.');
+                s.push_str(&tc.draw(arb_digits()));
+            }
+            4 => s.push('~'),
+            5 => s.push('+'),
+            6 => s.push_str(&tc.draw(arb_word())),
+            7 => s.push_str(&tc.draw(arb_digits())),
+            8 => s.push('.'),
+            9 if allow_hyphen => s.push('-'),
+            10 if allow_colon => s.push(':'),
+            _ => {
+                s.push_str(tc.draw(generators::sampled_from(vec!["~rc", "+dfsg", "+really", "~bpo12", "+git", ".0", "..", "..."])));
+                s.push_str(&tc.draw(arb_digits()));
+            }
+        }
+    }
+    s
+}
+
+#[hegel::composite]
+fn arb_revision(tc: &hegel::TestCase) -> String {
+    match tc.draw(int!(0u8, 7)) {
+        0 => tc.draw(arb_digits()),
+        1 => format!("0ubuntu{}", tc.draw(arb_digits())),
+        2 => format!("{}+b{}", tc.draw(arb_digits()), tc.draw(arb_digits())),
+        3 => format!("{}+nmu{}", tc.draw(arb_digits()), tc.draw(arb_digits())),
+        4 => format!("{}~bpo12+{}", tc.draw(arb_digits()), tc.draw(arb_digits())),
+        5 => format!("{}.{}", tc.draw(arb_digits()), tc.draw(arb_digits())),
+        6 => format!("{}{}", tc.draw(arb_word()), tc.draw(arb_digits())),
+        _ => {
+            let mut s = tc.draw(arb_digits());
+            for _ in 0..tc.draw(int!(0usize, 3)) {
+                s.push_str(tc.draw(generators::sampled_from(vec!["+", "~", ".", "a", "b", "0", "1"])));
+            }
+            s
+        }
+    }
+}
+
+#[hegel::composite]
+fn arb_epoch(tc: &hegel::TestCase) -> Option<String> {
+    match tc.draw(int!(0u8, 9)) {
+        0 => Some("0".to_string()),
+        1 => Some("1".to_string()),
+        2 => Some(tc.draw(int!(0u32, 20)).to_string()),
+        3 => Some("2147483647".to_string()),
+        4 => Some("2147483648".to_string()),
+        5 => Some("4294967295".to_string()),
+        6 => Some("4294967296".to_string()),
+        _ => None,
+    }
+}
+
+/// A well-formed version text (epoch, upstream, revision), with occasional junk.
+#[hegel::composite]
+fn arb_version_text(tc: &hegel::TestCase) -> String {
+    let epoch = tc.draw(arb_epoch());
+    let revision = if tc.draw(int!(0u8, 2)) == 0 { None } else { Some(tc.draw(arb_revision())) };
+    let upstream = tc.draw(arb_upstream(revision.is_some() && tc.draw(int!(0u8, 3)) == 0, epoch.is_some() && tc.draw(int!(0u8, 3)) == 0));
+    let mut s = String::new();
+    if let Some(e) = &epoch {
+        s.push_str(e);
+        s.push(':');
+    }
+    s.push_str(&upstream);
+    if let Some(r) = &revision {
+        s.push('-');
+        s.push_str(r);
+    }
+    if tc.draw(int!(0u8, 7)) == 0 {
+        let junk = tc.draw(generators::sampled_from(vec![" ", "_", ":", "-", "a", ".", "1.0:2", "1:", "-1", "", "~", "ä"]));
+        let at = tc.draw(int!(0usize, s.len()));
+        let at = (at..=s.len()).find(|&i| s.is_char_boundary(i)).unwrap();
+        s.insert_str(at, junk);
+    }
+    s
+}
+
+/// A text the crate parses and dpkg accepts (no `-` start, so dpkg can be asked).
+#[hegel::composite]
+fn arb_valid_version_text(tc: &hegel::TestCase) -> String {
+    for _ in 0..8 {
+        let t = tc.draw(arb_version_text());
+        if !t.starts_with('-') && !hits_lenient_parser_bug(&t) && Version::from_str(&t).is_ok() {
+            return t;
+        }
+    }
+    "1.0-1".to_string()
+}
+
+/// A version near `base`: digits padded or bumped, suffixes appended, the revision or epoch
+/// changed — the pairs where the comparison algorithm has to work.
+#[hegel::composite]
+fn arb_variant(tc: &hegel::TestCase, base: &Version) -> String {
+    let mut upstream = base.upstream_version.clone();
+    let mut revision = base.debian_revision.clone();
+    let mut epoch = base.epoch;
+    match tc.draw(int!(0u8, 12)) {
+        0 => upstream.push('0'),
+        1 => upstream.push('.'),
+        2 => upstream.push('~'),
+        3 => upstream.push_str(tc.draw(generators::sampled_from(vec!["+", "a", "~rc1", "+b1", ".0", "0", "Z", "+dfsg1"]))),
+        4 => {
+            // pad a digit run with leading zeros
+            if let Some(i) = upstream.bytes().position(|b| b.is_ascii_digit()) {
+                upstream.insert_str(i, "00");
+            }
+        }
+        5 => {
+            // bump the last digit run
+            if let Some(i) = upstream.bytes().rposition(|b| b.is_ascii_digit()) {
+                let d = upstream.as_bytes()[i];
+                let bumped = if d == b'9' { "10".to_string() } else { ((d - b'0' + 1) as u32).to_string() };
+                upstream.replace_range(i..i + 1, &bumped);
+            }
+        }
+        6 => revision = None,
+        7 => revision = Some(tc.draw(generators::sampled_from(vec!["0", "00", "1", "0ubuntu1", "1~bpo12+1", "1+b1", "1.", "1.0"])).to_string()),
+        8 => revision = revision.map(|r| format!("{r}0")).or(Some("0".to_string())),
+        9 => epoch = Some(epoch.unwrap_or(0)),
+        10 => epoch = Some(epoch.unwrap_or(0) + 1),
+        11 => upstream = upstream.replace('~', "+"),
+        _ => {}
+    }
+    let mut s = String::new();
+    if let Some(e) = epoch {
+        s.push_str(&format!("{e}:"));
+    }
+    s.push_str(&upstream);
+    if let Some(r) = revision {
+        s.push('-');
+        s.push_str(&r);
+    }
+    s
+}
+
+fn hash_of<T: Hash>(t: &T) -> u64 {
+    let mut h = DefaultHasher::new();
+    t.hash(&mut h);
+    h.finish()
+}
+
+// --------------------------------------------------------------------------- a model of dpkg's verrevcmp, used only to locate bug 1
+
+/// dpkg's `verrevcmp` on one part, returning the order and whether the comparison met a digit
+/// run that is empty on one side and all zeros on the other (dpkg: equal; the crate: less).
+fn verrevcmp(a: &str, b: &str) -> (Ordering, bool) {
+    fn order(c: u8) -> i32 {
+        match c {
+            b'~' => -1,
+            b'0'..=b'9' => 0,
+            c if c.is_ascii_alphabetic() => c as i32,
+            c => c as i32 + 256,
+        }
+    }
+    let (a, b) = (a.as_bytes(), b.as_bytes());
+    let (mut i, mut j) = (0, 0);
+    let mut empty_vs_zeros = false;
+    while i < a.len() || j < b.len() {
+        while (i < a.len() && !a[i].is_ascii_digit()) || (j < b.len() && !b[j].is_ascii_digit()) {
+            let ac = if i < a.len() { order(a[i]) } else { 0 };
+            let bc = if j < b.len() { order(b[j]) } else { 0 };
+            if ac != bc {
+                return (ac.cmp(&bc), empty_vs_zeros);
+            }
+            i += 1;
+            j += 1;
+        }
+        let (ra, rb) = (i, j);
+        while i < a.len() && a[i] == b'0' {
+            i += 1;
+        }
+        while j < b.len() && b[j] == b'0' {
+            j += 1;
+        }
+        let a_has = i < a.len() && a[i].is_ascii_digit();
+        let b_has = j < b.len() && b[j].is_ascii_digit();
+        if !a_has && !b_has && ((ra == i) != (rb == j)) {
+            empty_vs_zeros = true;
+        }
+        let mut first_diff = Ordering::Equal;
+        while i < a.len() && j < b.len() && a[i].is_ascii_digit() && b[j].is_ascii_digit() {
+            if first_diff == Ordering::Equal {
+                first_diff = a[i].cmp(&b[j]);
+            }
+            i += 1;
+            j += 1;
+        }
+        if i < a.len() && a[i].is_ascii_digit() {
+            return (Ordering::Greater, empty_vs_zeros);
+        }
+        if j < b.len() && b[j].is_ascii_digit() {
+            return (Ordering::Less, empty_vs_zeros);
+        }
+        if first_diff != Ordering::Equal {
+            return (first_diff, empty_vs_zeros);
+        }
+    }
+    (Ordering::Equal, empty_vs_zeros)
+}
+
+/// debversion/1: an empty digit run against a run of zeros (`1.` vs `1.0`, `1.0a` vs `1.0a0`).
+fn hits_empty_vs_zeros_bug(a: &Version, b: &Version) -> bool {
+    if a.epoch.unwrap_or(0) != b.epoch.unwrap_or(0) {
+        return false;
+    }
+    let (up, hit_up) = verrevcmp(&a.upstream_version, &b.upstream_version);
+    if up != Ordering::Equal || hit_up {
+        return hit_up;
+    }
+    verrevcmp(a.debian_revision.as_deref().unwrap_or("0"), b.debian_revision.as_deref().unwrap_or("0")).1
+}
+
+/// debversion/2: texts the strict parser accepts although dpkg refuses them — a colon without
+/// a numeric epoch, an empty revision (`1.0-`), an empty upstream (`1:-1`), an epoch beyond
+/// `INT_MAX`.
+fn hits_lenient_parser_bug(text: &str) -> bool {
+    let (epoch, rest) = match text.split_once(':') {
+        Some((e, r)) if !e.is_empty() && e.bytes().all(|b| b.is_ascii_digit()) => (Some(e), r),
+        Some(_) => return true,
+        None => (None, text),
+    };
+    if let Some(e) = epoch {
+        if e.parse::<u64>().map_or(true, |n| n > i32::MAX as u64) {
+            return true;
+        }
+    }
+    rest.ends_with('-') || rest.starts_with('-') || rest.is_empty() || rest.rsplit_once('-').map_or(false, |(_, r)| r.contains(':'))
+}
+
+fn parts(v: &Version) -> (String, String, String) {
+    (v.epoch.map(|e| e.to_string()).unwrap_or_default(), v.upstream_version.clone(), v.debian_revision.clone().unwrap_or_default())
+}
+
+// --------------------------------------------------------------------------- parsing
+
+#[hegel::test]
+fn parsing_agrees_with_dpkg_and_python_debian(tc: hegel::TestCase) {
+    let text = tc.draw(arb_version_text());
+    let ours = Version::from_str(&text);
+    // the split: epoch before the first colon, revision after the last hyphen, verbatim Display
+    if let Ok(v) = &ours {
+        // Display is verbatim (the epoch is a number: `01:` prints as `1:`)
+        let epoch_text = text.split_once(':').filter(|(e, _)| e.bytes().all(|b| b.is_ascii_digit())).map(|(e, _)| e);
+        if epoch_text.map_or(true, |e| !e.starts_with('0') || e == "0") {
+            assert_eq!(v.to_string(), text, "Display is verbatim");
+        }
+        assert_eq!(Version::from_str(&v.to_string()).map(|w| parts(&w)), Ok(parts(v)), "Display round trip of {text:?}");
+        if let Some(e) = v.epoch {
+            assert!(text.starts_with(&format!("{e}:")) || text.starts_with(&format!("{:0>width$}:", e, width = text.find(':').unwrap())), "{text}");
+        } else {
+            assert!(!text.starts_with(|c: char| c.is_ascii_digit()) || !text[..text.find(|c: char| !c.is_ascii_digit()).unwrap_or(text.len())].ends_with(':'), "{text}");
+        }
+        match &v.debian_revision {
+            Some(r) => {
+                assert!(!r.is_empty() && !r.contains('-'));
+                assert_eq!(text.rsplit_once('-').unwrap().1, r, "{text}");
+            }
+            None => assert!(v.is_native()),
+        }
+        assert!(!v.upstream_version.is_empty());
+        assert!(v.upstream_version.bytes().all(|b| b.is_ascii_alphanumeric() || b".+:~-".contains(&b)), "{text}");
+        assert_eq!(Version::parse_lenient(&text).unwrap().to_string(), v.to_string());
+        assert_eq!(text.as_str().into_version().unwrap(), *v);
+        assert_eq!(text.clone().into_version().unwrap(), *v);
+        if let Ok(Some((e, u, r))) = python_debian_parse(&text) {
+            // python-debian keeps the epoch as text (`01`), the crate as a number
+            assert_eq!((v.epoch, v.upstream_version.clone(), v.debian_revision.clone().unwrap_or_default()), (if e.is_empty() { None } else { Some(e.parse::<u32>().unwrap()) }, u, r), "python-debian split of {text:?}");
+        }
+    } else {
+        assert!(ours.as_ref().unwrap_err().to_string().starts_with("Invalid version string: ") || ours.as_ref().unwrap_err().to_string().starts_with("Error parsing epoch: "), "{text:?}");
+        assert!(text.contains('_') || Version::parse_lenient(&text).is_err(), "lenient parse of {text:?}");
+    }
+    // validity against dpkg, policy's "should start with a digit" being a warning there; dpkg
+    // trims surrounding whitespace, which is not a version's business
+    if hits_lenient_parser_bug(&text) || text.contains(char::is_whitespace) {
+        return;
+    }
+    if let Some(level) = dpkg_check(&text) {
+        // the strict parser may refuse what dpkg only warns about, never what dpkg accepts
+        // cleanly, and must refuse what dpkg refuses
+        match (&ours, level) {
+            (Ok(_), 2) => panic!("{text:?}: debversion accepts, dpkg refuses"),
+            (Err(e), 0) => panic!("{text:?}: debversion refuses ({e}), dpkg accepts"),
+            _ => {}
+        }
+    }
+}
