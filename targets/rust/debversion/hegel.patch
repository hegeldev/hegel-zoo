+// --------------------------------------------------------------------------- binNMU / NMU helpers
+
+#[hegel::test]
+fn bin_nmu_suffixes_round_trip(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    let part = v.debian_revision.clone().unwrap_or_else(|| v.upstream_version.clone());
+    if part.contains("+b") || part.contains("+nmu") {
+        return; // debversion/4, /5
+    }
+    assert!(!v.is_bin_nmu() && v.bin_nmu_count().is_none(), "{text}");
+    assert!(!v.is_nmu() && v.nmu_count().is_none(), "{text}");
+    let w = v.clone().increment_bin_nmu();
+    assert_eq!(w.to_string(), format!("{v}+b1"));
+    assert!(w.is_bin_nmu() && w.bin_nmu_count() == Some(1), "{w}");
+    assert!(!w.is_nmu(), "{w}");
+    assert!(w > v);
+    assert_eq!(oracle_cmp(&w.to_string(), &text), Ordering::Greater);
+    let k = tc.draw(int!(1u32, 4));
+    let mut x = w.clone();
+    for _ in 0..k {
+        let y = x.clone().increment_bin_nmu();
+        assert!(y > x);
+        x = y;
+    }
+    assert_eq!(x.bin_nmu_count(), Some(1 + k as i32), "{x}");
+    assert_eq!(x.to_string(), format!("{v}+b{}", 1 + k));
+    assert_eq!(x.epoch, v.epoch);
+    assert_eq!(x.is_native(), v.is_native());
+}
