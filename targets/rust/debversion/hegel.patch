+// --------------------------------------------------------------------------- ordering
+
+#[hegel::test]
+fn ordering_agrees_with_dpkg(tc: hegel::TestCase) {
+    let a = tc.draw(arb_valid_version_text());
+    let va = Version::from_str(&a).unwrap();
+    let b = if tc.draw(generators::booleans()) { tc.draw(arb_variant(&va)) } else { tc.draw(arb_valid_version_text()) };
+    let Ok(vb) = Version::from_str(&b) else {
+        return;
+    };
+    if b.starts_with('-') || hits_lenient_parser_bug(&b) || va.epoch.map_or(false, |e| e > i32::MAX as u32) || vb.epoch.map_or(false, |e| e > i32::MAX as u32) {
+        return;
+    }
+    let want = oracle_cmp(&a, &b);
+    if hits_empty_vs_zeros_bug(&va, &vb) {
+        return; // debversion/1
+    }
+    assert_eq!(va.cmp(&vb), want, "{a:?} vs {b:?}");
+    assert_eq!(vb.cmp(&va), want.reverse());
+    assert_eq!(va == vb, want == Ordering::Equal);
+    assert_eq!(va.partial_cmp(&vb), Some(want));
+    // a third version for transitivity
+    let c = tc.draw(arb_variant(&vb));
+    if let Ok(vc) = Version::from_str(&c) {
+        if !hits_lenient_parser_bug(&c) && !c.starts_with('-') && !hits_empty_vs_zeros_bug(&va, &vc) && !hits_empty_vs_zeros_bug(&vb, &vc) {
+            let (ab, bc, ac) = (va.cmp(&vb), vb.cmp(&vc), va.cmp(&vc));
+            if ab != Ordering::Greater && bc != Ordering::Greater {
+                assert_ne!(ac, Ordering::Greater, "{a} <= {b} <= {c}");
+            }
+            if ab == Ordering::Equal && bc == Ordering::Equal {
+                assert_eq!(ac, Ordering::Equal);
+            }
+        }
+    }
+}
