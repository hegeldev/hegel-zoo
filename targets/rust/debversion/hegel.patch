+#[hegel::test]
+fn increment_debian_gives_the_next_revision(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    let part = v.debian_revision.clone().unwrap_or_else(|| v.upstream_version.clone());
+    let Some((prefix, digits)) = trailing_number(&part) else {
+        return; // nothing to increment
+    };
+    let Ok(n) = digits.parse::<u64>() else {
+        return; // debversion/3
+    };
+    if n >= i32::MAX as u64 {
+        return; // debversion/3
+    }
+    let mut w = v.clone();
+    w.increment_debian();
+    let expected = format!("{prefix}{}", n + 1);
+    if v.debian_revision.is_some() {
+        assert_eq!(w.debian_revision.as_deref(), Some(expected.as_str()), "{text}");
+        assert_eq!(w.upstream_version, v.upstream_version);
+    } else {
+        assert_eq!(w.upstream_version, expected, "{text}");
+        assert!(w.is_native());
+    }
+    assert_eq!(w.epoch, v.epoch);
+    assert!(w > v, "{w} > {v}");
+    assert_eq!(oracle_cmp(&w.to_string(), &text), Ordering::Greater);
+}
