+// --------------------------------------------------------------------------- canonicalize, increments
+
+#[hegel::test]
+fn canonicalize_keeps_the_version_and_is_idempotent(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    let c = v.canonicalize();
+    if !hits_empty_vs_zeros_bug(&v, &c) {
+        assert_eq!(c, v, "{c} vs {v}");
+    }
+    let zero_revision = v.debian_revision.as_deref().map_or(false, |r| r.bytes().all(|b| b == b'0'));
+    if (v.epoch == Some(0) && v.upstream_version.contains(':')) || (zero_revision && v.upstream_version.contains('-')) {
+        return; // debversion/9
+    }
+    if !hits_empty_vs_zeros_bug(&v, &c) {
+        assert_eq!(oracle_cmp(&c.to_string(), &text), Ordering::Equal, "{c} vs {text}");
+    }
+    assert_eq!(c.canonicalize(), c);
+    assert_eq!(c.canonicalize().to_string(), c.to_string(), "canonicalize is idempotent on {text}");
+    assert_ne!(c.epoch, Some(0));
+    assert!(c.debian_revision.as_deref().map_or(true, |r| !r.bytes().all(|b| b == b'0')), "{c}");
+    for part in [Some(c.upstream_version.as_str()), c.debian_revision.as_deref()].into_iter().flatten() {
+        let b = part.as_bytes();
+        assert!(!(b.len() >= 2 && b[0] == b'0' && b[1].is_ascii_digit()), "{c}: leading zero in {part}");
+    }
+    assert_eq!(Version::from_str(&c.to_string()).unwrap(), c);
+    assert_eq!(c.is_native(), v.is_native() || v.debian_revision.as_deref().map_or(false, |r| r.bytes().all(|b| b == b'0')));
+}
