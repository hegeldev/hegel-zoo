+/// debversion/3: `increment_debian` parses the trailing number as `i32` and unwraps.
+#[hegel::test]
+fn increment_debian_handles_large_trailing_numbers(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    let big = tc.draw(generators::sampled_from(vec!["2147483647", "2147483648", "4294967296", "18446744073709551616"]));
+    let mut w = Version { debian_revision: Some(format!("{big}")), ..v.clone() };
+    let before = w.to_string();
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        w.increment_debian();
+        w
+    }));
+    let w = result.unwrap_or_else(|_| panic!("increment_debian on {before} panicked"));
+    assert!(w > Version::from_str(&before).unwrap(), "{w} after {before}");
+    assert_eq!(oracle_cmp(&w.to_string(), &before), Ordering::Greater);
+}
