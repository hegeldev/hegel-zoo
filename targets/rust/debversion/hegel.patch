+/// debversion/4: the binNMU suffix is the *last* `+bN`; `split_once("+b")` finds the first `+b`
+/// (`1.0+beta1+b1` is a binNMU, and `increment_bin_nmu` produced it).
+#[hegel::test]
+fn bin_nmu_count_reads_the_last_suffix(tc: hegel::TestCase) {
+    let text = tc.draw(arb_valid_version_text());
+    let v = Version::from_str(&text).unwrap();
+    let infix = tc.draw(generators::sampled_from(vec!["+beta1", "+build2", "+b", "+bzr123", "+b1a"]));
+    let n = tc.draw(int!(1i32, 5));
+    let part = format!("{}{infix}", v.debian_revision.clone().unwrap_or_else(|| v.upstream_version.clone()));
+    if part.contains("+nmu") {
+        return;
+    }
+    let with = if v.debian_revision.is_some() { Version { debian_revision: Some(part.clone()), ..v.clone() } } else { Version { upstream_version: part.clone(), ..v.clone() } };
+    let w = with.clone().increment_bin_nmu();
+    assert_eq!(w.to_string(), format!("{with}+b1"), "increment appends the suffix");
+    assert_eq!(w.bin_nmu_count(), Some(1), "{w} is the binNMU increment_bin_nmu just made");
+    let mut y = w;
+    for _ in 1..n {
+        y = y.increment_bin_nmu();
+    }
+    assert_eq!(y.to_string(), format!("{with}+b{n}"), "{n} increments");
+    assert_eq!(y.bin_nmu_count(), Some(n), "{y}");
+}
