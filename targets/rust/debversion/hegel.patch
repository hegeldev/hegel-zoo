+#[hegel::test]
+fn dfsg_suffixes_round_trip(tc: hegel::TestCase) {
+    let base = tc.draw(arb_base_upstream());
+    let old = tc.draw(generators::sampled_from(vec![None, Some("1.0+dfsg1"), Some("1.0+dfsg"), Some("1.0+ds1"), Some("1.0~ds3"), Some("1.0+ds"), Some("1.0"), Some("1.0+dfsg12")]));
