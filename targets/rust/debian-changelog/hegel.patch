+/// The high-volume version of the bug-list comparison: python-debian's regexes (identical to
+/// dpkg's) on single lines, plus the consistency of the `bugs` module with itself.
+#[hegel::test]
+fn bug_references_agree_with_the_reference_regexes(tc: hegel::TestCase) {
+    let line = tc.draw(arb_detail(true));
+    let Some((deb, lp)) = oracle_bugs(&line) else { return };
+    if hits_closes_bug(&[line.clone()]) || marker_inside_a_word(&line) || hits_hash_space_bug(&line) || hits_offset_bug(&line) {
+        return;
+    }
+    let deb_set: BTreeSet<u32> = deb.iter().copied().collect();
+    let lp_set: BTreeSet<u32> = lp.iter().copied().collect();
+    let refs = iter_bug_refs(&line);
+    // every reference found sits on digits, and bug_at_offset agrees on each of its offsets
+    for r in &refs {
+        assert_eq!(&line[r.start..r.end], r.bug.id().to_string(), "BugRef range for {line:?}");
+        for off in r.start..=r.end {
+            assert_eq!(bug_at_offset(&line, 0, off), Some(r.bug), "bug_at_offset({off}) in {line:?}");
+        }
+        let spans = bug_ref_spans(&line, false);
+        assert!(spans.iter().any(|s| s.start <= r.start && r.end <= s.end), "no span covers {r:?} in {line:?}: {spans:?}");
+    }
+    let refs_deb: BTreeSet<u32> = refs.iter().filter_map(|r| match r.bug { Bug::Debian(n) => Some(n), _ => None }).collect();
+    let refs_lp: BTreeSet<u32> = refs.iter().filter_map(|r| match r.bug { Bug::Launchpad(n) => Some(n), _ => None }).collect();
+    assert_eq!(refs_deb, deb_set, "iter_bug_refs (Debian) vs dpkg's regex on {line:?}");
+    assert_eq!(refs_lp, lp_set, "iter_bug_refs (Launchpad) vs dpkg's regex on {line:?}");
+}
