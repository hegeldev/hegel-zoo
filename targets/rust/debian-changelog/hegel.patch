+/// Pin for bug 2: `+` is a package-name character for dpkg (`g++`, `libsigc++-2.0`).
+#[hegel::test]
+fn package_names_with_plus_are_parsed(tc: hegel::TestCase) {
+    let package = pick(&tc, &["g++", "libsigc++-2.0", "libxml++2.6", "a+b", "c++-annotations", "gcc-snapshot+"]);
+    let text = format!("{package} (1.0-1) unstable; urgency=low\n\n  * x\n\n -- Jane Doe <jane@example.com>  Mon, 01 Jan 2024 10:00:00 +0000\n");
+    let d = dpkg(&text);
+    assert!(!d.fatal && d.warnings.is_empty(), "dpkg should read {package}: {:?}", d.warnings);
+    assert_eq!(d.entries[0]["Source"], package);
+    let cl = ChangeLog::from_str(&text).unwrap_or_else(|e| panic!("the strict parser refuses the package name {package}: {e}"));
+    assert_eq!(cl.iter().next().unwrap().package(), Some(package.to_string()));
