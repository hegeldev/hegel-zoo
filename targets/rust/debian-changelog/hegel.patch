+/// Header and trailer lines split like python-debian's (= dpkg's) regexes.
+#[hegel::test]
+fn header_and_trailer_lines_split_like_dpkg(tc: hegel::TestCase) {
+    let e = tc.draw(arb_entry().print_as_debug());
+    if e.malformed.is_some() || e.urgency_comment || hits_plus_bug(&e) {
+        return;
+    }
+    let header = e.text.lines().next().unwrap().to_string();
+    let (status, f) = ask("H", &[&header]);
+    if status == "na" {
+        return;
