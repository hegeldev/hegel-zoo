+/// Pin for bug 9: `prepend_change_line` puts the line before the first change line, also when
+/// the header is directly followed by the changes (which dpkg allows).
+#[hegel::test]
+fn prepend_change_line_puts_the_line_first(tc: hegel::TestCase) {
+    let g = tc.draw(arb_changelog(false).print_as_debug());
+    let e = &g.entries[0];
+    if !is_clean_shape(e) || hits_plus_bug(e) || !hits_prepend_bug(&e.text) {
+        return;
+    }
+    let Ok(cl) = ChangeLog::from_str(&g.text) else { return };
+    let entry = cl.iter().next().unwrap();
+    let before: Vec<String> = entry.change_lines().collect();
+    let line = format!("* {}", tc.draw(arb_detail(false)).trim());
+    entry.prepend_change_line(&line);
+    let mut expected = vec![line];
+    expected.extend(before);
+    assert_eq!(entry.change_lines().collect::<Vec<_>>(), expected, "prepend_change_line on:\n{}", g.text);
+}
