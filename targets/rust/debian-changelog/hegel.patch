+    assert_eq!(entry.version(), Some(expected_version.clone()));
+    assert_eq!(entry.is_unreleased(), Some(true));
+    assert_eq!(entry.distributions(), Some(vec!["UNRELEASED".to_string()]));
+    let text = cl.to_string();
+    let reread: ChangeLog = text.parse().unwrap_or_else(|e| panic!("new_entry wrote something the strict parser refuses ({e}):\n{text}"));
+    assert_eq!(reread.iter().count(), g.entries.len() + 1);
+    let top = reread.iter().next().unwrap();
+    assert_eq!(top.version(), Some(expected_version));
+    assert_eq!(top.package(), first.package());
+    assert_eq!(top.change_lines().collect::<Vec<_>>(), vec![line]);
+    let d = dpkg(&text);
+    assert!(!d.fatal && d.warnings.is_empty(), "dpkg is unhappy with the new entry ({:?}):\n{text}", d.warnings);
+    assert_eq!(d.entries.len(), g.entries.len() + 1);
+    assert_eq!(d.entries[0]["Distribution"], "UNRELEASED");
+    assert_eq!(&d.entries[1..], &d0.entries[..], "the older entries changed for dpkg");
+}
