+/// Pin for bug 11: the footer setters are visible through the accessors without re-parsing.
+#[hegel::test]
+fn footer_setters_are_visible_in_memory(tc: hegel::TestCase) {
+    let g = tc.draw(arb_changelog(false).print_as_debug());
+    let e = &g.entries[0];
+    if !is_clean_shape(e) || hits_plus_bug(e) || e.name.is_empty() {
+        return;
+    }
+    let Ok(cl) = ChangeLog::from_str(&g.text) else { return };
+    let mut entry = cl.iter().next().unwrap();
+    match tc.draw(int!(0u8, 1)) {
+        0 => {
+            let date = tc.draw(arb_date());
+            entry.set_timestamp(date.clone());
+            assert_eq!(cl.iter().next().unwrap().timestamp(), Some(date.clone()), "timestamp() through the changelog after set_timestamp");
+            assert_eq!(entry.timestamp(), Some(date), "timestamp() after set_timestamp");
+        }
+        _ => {
+            let name = tc.draw(arb_name());
+            if name.is_empty() {
+                return;
+            }
+            let email = pick(&tc, EMAILS).to_string();
+            entry.set_maintainer((name.clone(), email.clone()));
+            assert_eq!(entry.email(), Some(email), "email() after set_maintainer");
+            assert_eq!(entry.maintainer(), Some(name), "maintainer() after set_maintainer");
+        }
+    }
+}
