+            assert_eq!(got, Some(v.clone()), "metadata {k} of {header:?}");
+        }
+    }
+    let footer = e.text.lines().last().unwrap().to_string();
+    let (status, f) = ask("T", &[&footer]);
+    if status == "ok" {
+        assert_eq!(entry.maintainer().unwrap_or_default(), f[0], "maintainer of {footer:?}");
+        assert_eq!(entry.email(), Some(f[1].clone()), "email of {footer:?}");
+        assert_eq!(entry.timestamp().map(|t| t.trim().to_string()), Some(f[3].clone()), "timestamp of {footer:?}");
