+/// Adding changes for another author opens a section for them, in both spellings of the API.
+#[hegel::test]
+fn changes_for_another_author_get_a_section(tc: hegel::TestCase) {
+    let g = tc.draw(arb_changelog(false).print_as_debug());
+    if !g.entries.iter().all(is_clean_shape) || g.entries[0].name.is_empty() || g.entries.iter().any(hits_plus_bug) {
+        return;
+    }
+    let cl_a: ChangeLog = match g.text.parse() {
+        Ok(cl) => cl,
+        Err(_) => return,
+    };
+    let cl_b: ChangeLog = g.text.parse().unwrap();
+    let entry_a = cl_a.iter().next().unwrap();
+    let entry_b = cl_b.iter().next().unwrap();
+    let maintainer = entry_a.maintainer().unwrap();
+    let author = if tc.draw(int!(0u8, 3)) == 0 { maintainer.clone() } else { tc.draw(arb_name()) };
+    if author.is_empty() {
+        return;
+    }
+    let line = format!("* {}", tc.draw(arb_detail(false)).trim());
+    let before: Vec<String> = entry_a.change_lines().collect();
+    if before.iter().any(|l| l.trim().is_empty()) || before.iter().any(|l| l.contains('[')) || before.iter().any(|l| !l.starts_with("* ")) {
+        return; // keep to the plain-bullet shape
+    }
+    if before.is_empty() && author != maintainer {
+        return; // bug 7
+    }
+    if hits_prepend_bug(&g.entries[0].text) && author != maintainer {
+        return; // bug 9
+    }
+    entry_a.try_add_changes_for_author(&author, vec![line.as_str()]).unwrap();
+    entry_b.try_add_change_for_author(&[line.as_str()], (author.clone(), "x@y.z".to_string())).unwrap();
+    let after_a: Vec<String> = entry_a.change_lines().collect();
+    let after_b: Vec<String> = entry_b.change_lines().collect();
+    assert_eq!(after_a, after_b, "try_add_changes_for_author vs try_add_change_for_author for author {author:?} on {before:?}");
+    assert!(after_a.contains(&line) || after_a.iter().any(|l| l.starts_with("* ") && line.starts_with(l.trim_end())), "the new line is missing: {after_a:?}");
+    let sections = entry_a.iter_changes_by_author();
+    let last = sections.last().unwrap();
+    if author != maintainer {
+        assert_eq!(last.0.as_deref(), Some(author.as_str()), "last section author in {after_a:?}");
+        assert!(entry_a.get_authors().contains(&author), "get_authors() lacks {author:?}: {after_a:?}");
+        if !before.is_empty() {
+            assert_eq!(sections[0].0.as_deref(), Some(maintainer.as_str()), "the maintainer's own section in {after_a:?}");
+        }
+    } else {
+        assert!(last.0.is_none() || last.0.as_deref() == Some(author.as_str()), "a section for the maintainer themself: {after_a:?}");
+    }
+    let text = cl_a.to_string();
+    let reread: ChangeLog = text.parse().unwrap_or_else(|e| panic!("author sections wrote something the strict parser refuses ({e}):\n{text}"));
+    assert_eq!(reread.iter().next().unwrap().change_lines().collect::<Vec<_>>(), after_a);
+    let d = dpkg(&text);
+    assert!(!d.fatal, "dpkg refuses the text after adding a section:\n{text}");
+}
