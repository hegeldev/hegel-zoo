+    let text = words.join(" ");
+    let mut cl = ChangeLog::new();
+    let entry = cl.new_empty_entry().package("foo".into()).version("1.0-1".parse().unwrap()).distribution("unstable".into()).urgency(Urgency::Medium).maintainer(("A B".into(), "a@b.c".into())).datetime("Mon, 01 Jan 2024 10:00:00 +0000").change_line("* first".into()).finish();
+    entry.add_bullet(&text);
+    for l in entry.change_lines().skip(1) {
+        let width = l.chars().count();
+        let longest_word = l[2..].split_whitespace().map(|w| w.chars().count()).max().unwrap_or(0);
+        assert!(width <= 78 || longest_word + 2 >= width, "line wider than 78 without an over-long word: {l:?} (from {text:?})");
+    }
+}
