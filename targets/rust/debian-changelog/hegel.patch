+/// A second entry via `new_entry()` goes on top, unreleased, with the incremented version.
+#[hegel::test]
+fn new_entry_goes_on_top_as_unreleased(tc: hegel::TestCase) {
+    let g = tc.draw(arb_changelog(false).print_as_debug());
+    if !g.entries.iter().all(is_clean_shape) || g.entries[0].name.is_empty() || g.entries.iter().any(hits_plus_bug) {
+        return;
+    }
+    let d0 = dpkg(&g.text);
+    if d0.fatal || !d0.warnings.is_empty() {
+        return;
+    }
+    let mut cl: ChangeLog = g.text.parse().unwrap();
+    let first = cl.iter().next().unwrap();
+    let Some(mut expected_version) = first.version() else { return };
+    if expected_version.debian_revision.as_deref().map(|r| r.len() > 6).unwrap_or(false) {
+        return; // debversion/3: increment_debian overflows i32
+    }
+    expected_version.increment_debian();
