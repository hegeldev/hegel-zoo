+/// `Urgency` round-trips through `Display`/`FromStr` regardless of case.
+#[hegel::test]
+fn urgency_round_trips(tc: hegel::TestCase) {
+    let u = tc.draw(arb_urgency().print_as_debug());
+    let s = u.to_string();
+    let text = match tc.draw(int!(0u8, 2)) {
+        0 => s.to_uppercase(),
+        1 => s.clone(),
+        _ => {
+            let mut c = s.chars();
+            c.next().unwrap().to_uppercase().collect::<String>() + c.as_str()
+        }
+    };
+    assert_eq!(Urgency::from_str(&text).ok(), Some(u));
+}
