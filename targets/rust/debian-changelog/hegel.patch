+// --------------------------------------------------------------------------- properties: CST
+
+#[hegel::composite]
+fn arb_text(tc: &hegel::TestCase) -> String {
+    match tc.draw(int!(0u8, 3)) {
+        0 => tc.draw(arb_changelog(true).print_as_debug()).text,
+        1 => {
+            let mut t = tc.draw(arb_changelog(true).print_as_debug()).text;
+            let junk = pick(tc, &["\n", " ", "  ", " -- ", "(", ")", ";", "=", "<", ">", "#", "\t", "\r\n", "x", "1.0", "ä", "\u{2028}", "*"]);
+            let at = tc.draw(int!(0usize, t.chars().count()));
+            let byte = t.char_indices().nth(at).map(|(i, _)| i).unwrap_or(t.len());
+            t.insert_str(byte, junk);
+            t
+        }
+        2 => {
