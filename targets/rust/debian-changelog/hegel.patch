+//! Hegel properties for `debian-changelog`.
+//!
+//! Oracles: `dpkg-parsechangelog` (dpkg's own `Dpkg::Changelog::Debian`, run per generated
+//! changelog with `--all --format rfc822`; its warnings and fatal errors say what is a
+//! changelog) and python-debian's `debian.changelog` (a line-for-line port of dpkg's regexes,
+//! driven as a persistent `/usr/bin/python3` child for the high-volume properties: the
+//! `Closes:` / `LP:` bug-list regexes and header/trailer field splitting). Alongside: the
+//! lossless round trip of the CST, the entry builder and setters read back by dpkg, offset
+//! lookups, `from_iter`/`pop_first`, `add_bullet` wrapping and the author-section helpers.
+#![allow(clippy::all, dead_code)]
+
+use debian_changelog::bugs::{bug_at_offset, bug_ref_spans, iter_bug_refs, Bug};
+use debian_changelog::changes::{find_closed_debian_bugs, find_closed_launchpad_bugs, find_extra_authors};
+use debian_changelog::{ChangeLog, Entry, Urgency};
+use hegel::generators;
+use hegel::generators::Generator;
+use rowan::ast::AstNode;
+use std::collections::{BTreeMap, BTreeSet};
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::str::FromStr;
+use std::sync::atomic::{AtomicUsize, Ordering as AtomicOrdering};
+use std::sync::{Mutex, OnceLock};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+// --------------------------------------------------------------------------- python oracle
+
+const ORACLE_SCRIPT: &str = r#"
+import sys, re
+try:
+    import debian.changelog as C
+    have = True
+except Exception:
+    have = False
+
+def dec(h):
+    return bytes.fromhex(h).decode('utf-8')
+
+def enc(s):
+    return s.encode('utf-8').hex()
+
+def nums(rx, text):
+    out = []
+    for m in rx.finditer(text):
+        out.extend(int(d) for d in re.findall(r'\d+', m.group(0)))
+    return ','.join(str(x) for x in out)
+
+for line in sys.stdin:
+    parts = line.rstrip('\n').split(' ')
+    cmd, args = parts[0], [dec(p) for p in parts[1:]]
+    if not have:
+        out = ['na']
+    elif cmd == 'B':
+        out = ['ok', nums(C.closes, args[0]), nums(C.closeslp, args[0])]
+    elif cmd == 'H':
+        m = C.topline.match(args[0])
+        if m is None:
+            out = ['err']
+        else:
+            out = ['ok', m.group(1), m.group(2), ' '.join(m.group(3).split())]
+    elif cmd == 'T':
+        m = C.endline.match(args[0])
+        if m is None:
+            out = ['err']
+        else:
+            out = ['ok', m.group(1), m.group(2), m.group(3), m.group(4).strip()]
+    else:
+        out = ['bad']
+    print(' '.join([out[0]] + [enc(x) for x in out[1:]]), flush=True)
+"#;
+
+struct Oracle {
+    child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+static ORACLE: OnceLock<Mutex<Oracle>> = OnceLock::new();
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|b| format!("{b:02x}")).collect()
+}
+
+fn unhex(h: &str) -> String {
+    let bytes: Vec<u8> = (0..h.len()).step_by(2).map(|i| u8::from_str_radix(&h[i..i + 2], 16).unwrap()).collect();
+    String::from_utf8(bytes).unwrap()
+}
+
+fn oracle() -> &'static Mutex<Oracle> {
+    ORACLE.get_or_init(|| {
+        let python = if std::path::Path::new("/usr/bin/python3").exists() { "/usr/bin/python3" } else { "python3" };
+        let mut child = Command::new(python)
+            .arg("-u")
+            .arg("-c")
+            .arg(ORACLE_SCRIPT)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .expect("python3 is needed for the python-debian oracle");
+        let stdin = child.stdin.take().unwrap();
+        let stdout = BufReader::new(child.stdout.take().unwrap());
+        Mutex::new(Oracle { child, stdin, stdout })
+    })
+}
+
+fn ask(cmd: &str, args: &[&str]) -> (String, Vec<String>) {
+    let mut o = oracle().lock().unwrap();
+    let mut line = cmd.to_string();
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a));
+    }
+    line.push('\n');
+    o.stdin.write_all(line.as_bytes()).expect("oracle stdin");
+    let mut reply = String::new();
+    let n = o.stdout.read_line(&mut reply).expect("oracle stdout");
+    if n == 0 {
+        let status = o.child.try_wait().ok().flatten();
+        panic!("the Python oracle exited ({status:?})");
+    }
+    let mut it = reply.trim_end_matches(['\n', '\r']).split(' ');
+    let status = it.next().unwrap().to_string();
+    (status, it.map(unhex).collect())
+}
+
+fn parse_list(s: &str) -> Vec<u32> {
+    s.split(',').filter(|p| !p.is_empty()).map(|p| p.parse().unwrap()).collect()
+}
+
+/// dpkg's / python-debian's `Closes:` and `LP:` bug lists over a changes text.
+fn oracle_bugs(text: &str) -> Option<(Vec<u32>, Vec<u32>)> {
+    let (status, f) = ask("B", &[text]);
+    if status != "ok" {
+        return None;
+    }
+    Some((parse_list(&f[0]), parse_list(&f[1])))
+}
+
+// --------------------------------------------------------------------------- dpkg oracle
+
+#[derive(Debug, Default)]
+struct Dpkg {
+    entries: Vec<BTreeMap<String, String>>,
+    warnings: Vec<String>,
+    fatal: bool,
+}
+
+static TMP_COUNTER: AtomicUsize = AtomicUsize::new(0);
+
+/// Run `dpkg-parsechangelog --all --format rfc822` on the text.
+fn dpkg(text: &str) -> Dpkg {
+    let n = TMP_COUNTER.fetch_add(1, AtomicOrdering::Relaxed);
+    let path = std::env::temp_dir().join(format!("hegel-debian-changelog-{}-{n}", std::process::id()));
+    std::fs::write(&path, text).unwrap();
+    let out = Command::new("dpkg-parsechangelog")
+        .arg("-l")
+        .arg(&path)
+        .args(["--all", "--format", "rfc822"])
+        .env("LC_ALL", "C.UTF-8")
+        .output()
+        .expect("dpkg-parsechangelog is needed as the oracle");
+    let _ = std::fs::remove_file(&path);
+    let stderr = String::from_utf8_lossy(&out.stderr).to_string();
+    let mut r = Dpkg::default();
+    r.fatal = !out.status.success();
+    r.warnings = stderr
+        .lines()
+        .filter(|l| l.contains("warning:"))
+        .map(|l| l.split("warning:").nth(1).unwrap_or(l).trim().to_string())
+        .collect();
+    if r.fatal {
+        return r;
+    }
+    let stdout = String::from_utf8_lossy(&out.stdout).to_string();
+    for stanza in stdout.split("\n\n") {
+        if stanza.trim().is_empty() {
+            continue;
+        }
+        let mut fields: BTreeMap<String, String> = BTreeMap::new();
+        let mut last: Option<String> = None;
+        for line in stanza.lines() {
+            if let Some(cont) = line.strip_prefix(' ') {
+                if let Some(k) = &last {
+                    let v = fields.get_mut(k).unwrap();
+                    v.push('\n');
+                    v.push_str(cont);
+                }
+            } else if let Some((k, v)) = line.split_once(':') {
+                fields.insert(k.to_string(), v.trim_start().to_string());
+                last = Some(k.to_string());
+            }
+        }
+        r.entries.push(fields);
+    }
+    r
+}
+
+/// The change lines dpkg keeps for an entry: the `Changes:` field without the header line and
+/// the ` .` separator, with the field's own one-space indent removed and `.` blank lines emptied.
+fn dpkg_change_lines(fields: &BTreeMap<String, String>) -> Vec<String> {
+    let changes = fields.get("Changes").cloned().unwrap_or_default();
+    let changes = changes.trim_start_matches('\n');
+    let mut lines: Vec<String> = changes.lines().skip(1).map(|l| if l == "." { String::new() } else { l.trim_end().to_string() }).collect();
+    if lines.first().map(|l| l.is_empty()) == Some(true) {
+        lines.remove(0);
+    }
+    lines
+}
+
+fn dpkg_list(fields: &BTreeMap<String, String>, key: &str) -> Vec<u32> {
+    let mut v: Vec<u32> = fields.get(key).map(|s| s.split_whitespace().map(|x| x.parse().unwrap()).collect()).unwrap_or_default();
+    v.sort();
+    v.dedup();
+    v
+}
+
+// --------------------------------------------------------------------------- generators
+
+const WORDS: &[&str] = &[
+    "Fix", "the", "build", "on", "arm64", "New", "upstream", "release", "Team", "upload", "Thanks", "to", "A.", "Hacker",
+    "Drop", "dependency", "python3-six", "Standards-Version", "4.7.0", "debhelper-compat", "13", "Closes", "closes:", "LP",
+    "Update", "d/copyright", "Bump", "(no", "changes)", "Vernooĳ", "Simó", "ü", "foo,", "bar.", "#", "Closes:", "->", "%s",
+];
+
+const NAMES: &[&str] = &["Jelmer", "Vernooĳ", "Jane", "Doe", "Adeodato", "Simó", "O'Brien", "Jean-Paul", "Dr.", "van", "der", "Berg", "李", "Guillem", "Jover"];
+
+const EMAILS: &[&str] = &["jelmer@debian.org", "jane@example.com", "bob@x.org", "team+pkg@tracker.debian.org", "a.b-c_d@sub.example.co.uk", "root@localhost"];
+
+const MONTHS: &[&str] = &["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+const WEEKDAYS: &[&str] = &["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
+
+const VERSIONS: &[&str] = &[
+    "1.0-1", "0.1", "2:3.4~rc1-2ubuntu1", "1.0+dfsg-1~bpo12+1", "1:1.0-1+deb12u1", "3.3.4-1", "0.0.1-0ubuntu1", "1.2.3+really1.2.2-1",
+    "20240101-1", "1.0-1+b1", "1.0-1+nmu1", "9", "1:0", "0.99.1~beta2+git20230101.abcdef-3",
+];
+
+const DISTS: &[&str] = &[
+    "unstable", "experimental", "UNRELEASED", "bookworm-backports", "stable-security", "UNRELEASED-1", "trixie", "noble", "focal-proposed",
+    "stable", "oldstable", "bookworm", "sid", "unstable-debug", "jammy",
+];
+
+fn pick<'a>(tc: &hegel::TestCase, items: &[&'a str]) -> &'a str {
+    items[tc.draw(int!(0usize, items.len() - 1))]
+}
+
+fn chars_from(tc: &hegel::TestCase, alphabet: &str, n: usize) -> String {
+    let a: Vec<char> = alphabet.chars().collect();
+    (0..n).map(|_| a[tc.draw(int!(0usize, a.len() - 1))]).collect()
+}
+
+#[hegel::composite]
+fn arb_package(tc: &hegel::TestCase) -> String {
+    match tc.draw(int!(0u8, 9)) {
+        0 => pick(tc, &["g++", "libsigc++-2.0", "gtkmm3.0", "libxml++2.6", "dpkg", "breezy", "0ad", "a", "python3-defaults", "Foo"]).to_string(),
+        _ => {
+            let first = chars_from(tc, "abcdefgxyz", 1);
+            let rest = chars_from(tc, "abcdefghijklmnopqrstuvwxyz0123456789.+-", tc.draw(int!(0usize, 8)));
+            format!("{first}{rest}")
+        }
+    }
+}
+
+#[hegel::composite]
+fn arb_version(tc: &hegel::TestCase) -> String {
+    match tc.draw(int!(0u8, 3)) {
+        0..=1 => pick(tc, VERSIONS).to_string(),
+        _ => {
+            let mut s = String::new();
+            if tc.draw(int!(0u8, 3)) == 0 {
+                s.push_str(&format!("{}:", tc.draw(int!(1u32, 9))));
+            }
+            s.push_str(&tc.draw(int!(0u32, 99)).to_string());
+            for _ in 0..tc.draw(int!(0usize, 3)) {
+                s.push('.');
+                s.push_str(&tc.draw(int!(0u32, 99)).to_string());
+            }
+            if tc.draw(int!(0u8, 3)) == 0 {
+                s.push_str(pick(tc, &["~rc1", "+dfsg", "+git20240101", "~beta", "a", "+really1.0"]));
+            }
+            if tc.draw(int!(0u8, 2)) != 0 {
+                s.push('-');
+                s.push_str(pick(tc, &["1", "0ubuntu1", "2+b1", "1~bpo12+1", "3+nmu1", "0", "1+deb12u2"]));
+            }
+            s
+        }
+    }
+}
+
+#[hegel::composite]
+fn arb_distributions(tc: &hegel::TestCase) -> Vec<String> {
+    let n = tc.draw(int!(1usize, 3));
+    (0..n)
+        .map(|_| match tc.draw(int!(0u8, 4)) {
+            0 => chars_from(tc, "abcdefghijklmnopqrstuvwxyz0123456789.+-", tc.draw(int!(1usize, 10))),
+            _ => pick(tc, DISTS).to_string(),
+        })
+        .collect()
+}
+
+/// A metadata key=value pair as written after the `;`.
+#[hegel::composite]
+fn arb_metadata_item(tc: &hegel::TestCase) -> (String, String) {
+    match tc.draw(int!(0u8, 9)) {
+        0..=5 => {
+            let mut u = pick(tc, &["low", "medium", "high", "emergency", "critical"]).to_string();
+            if tc.draw(int!(0u8, 5)) == 0 {
+                u = match tc.draw(int!(0u8, 2)) {
+                    0 => u.to_uppercase(),
+                    1 => {
+                        let mut c = u.chars();
+                        c.next().unwrap().to_uppercase().collect::<String>() + c.as_str()
+                    }
+                    _ => u,
+                };
+            }
+            ("urgency".to_string(), u)
+        }
+        6..=7 => ("binary-only".to_string(), "yes".to_string()),
+        _ => (
+            pick(tc, &["XS-Foo", "xbs-bar", "XC-Vcs-Git", "xs-a"]).to_string(),
+            chars_from(tc, "abcdefghijklmnopqrstuvwxyz0123456789.-", tc.draw(int!(1usize, 6))),
+        ),
+    }
+}
+
+#[hegel::composite]
+fn arb_bug_list(tc: &hegel::TestCase) -> String {
+    let n = tc.draw(int!(1usize, 3));
+    let mut s = String::new();
+    for i in 0..n {
+        if i > 0 {
+            s.push_str(pick(tc, &[", ", ",", " , ", ",  ", " ", ",, "]));
+        }
+        s.push_str(pick(tc, &["#", "#", "#", "", "# ", "bug#", "Bug #", "bug "]));
+        s.push_str(&tc.draw(int!(1u32, 9_999_999)).to_string());
+    }
+    s
+}
+
+/// One change line (what follows the two-space indent), possibly carrying bug references.
+#[hegel::composite]
+fn arb_detail(tc: &hegel::TestCase, bullet: bool) -> String {
+    let mut s = String::new();
+    if bullet {
+        s.push_str(pick(tc, &["* ", "* ", "* ", "+ ", "- ", "  + ", "*"]));
+    } else if tc.draw(int!(0u8, 2)) == 0 {
+        s.push_str("  ");
+    }
+    let n = tc.draw(int!(0usize, 6));
+    for i in 0..n {
+        if i > 0 {
+            s.push(' ');
+        }
+        s.push_str(pick(tc, WORDS));
+    }
+    match tc.draw(int!(0u8, 9)) {
+        0..=2 => {
+            let marker = pick(tc, &["Closes: ", "Closes:", "closes: ", "CLOSES: ", "(Closes: ", "Closes:  ", "LP: ", "lp: ", "LP:", "LP: #", "(LP: "]);
+            let list = tc.draw(arb_bug_list());
+            s.push_str(&format!(" {marker}{list}"));
+            if marker.starts_with('(') {
+                s.push(')');
+            }
+            if tc.draw(int!(0u8, 3)) == 0 {
+                s.push(',');
+            }
+        }
+        3 => s.push_str(pick(tc, &[" Closes: #", " Closes:", " LP:", " Fixes: #123", " closes bug 5", " Encloses: #7", " lp:#12", " lp: 34"])),
+        _ => {}
+    }
+    s
+}
+
+#[hegel::composite]
+fn arb_body(tc: &hegel::TestCase) -> Vec<String> {
+    let n = tc.draw(int!(0usize, 6));
+    let mut lines = Vec::new();
+    for i in 0..n {
+        match tc.draw(int!(0u8, 9)) {
+            0 if i > 0 => lines.push(String::new()),
+            1 => {
+                let name: Vec<&str> = (0..tc.draw(int!(1usize, 2))).map(|_| pick(tc, NAMES)).collect();
+                lines.push(format!("  [ {} ]", name.join(" ")));
+            }
+            2 if i > 0 => lines.push(format!("    {}", tc.draw(arb_detail(false)))),
+            _ => lines.push(format!("  {}", tc.draw(arb_detail(true)))),
+        }
+    }
+    lines
+}
+
+#[derive(Debug, Clone)]
+struct GenDate {
+    weekday: Option<String>,
+    day: u32,
+    month: usize,
+    year: i32,
+    hour: u32,
+    minute: u32,
+    second: u32,
+    tz_sign: char,
+    tz: u32,
+    pad_day: bool,
+}
+
+impl GenDate {
+    fn text(&self) -> String {
+        let day = if self.pad_day { format!("{:02}", self.day) } else { self.day.to_string() };
+        let mut s = String::new();
+        if let Some(w) = &self.weekday {
+            s.push_str(w);
+            s.push_str(", ");
+        }
+        s.push_str(&format!(
+            "{day} {} {} {:02}:{:02}:{:02} {}{:04}",
+            MONTHS[self.month], self.year, self.hour, self.minute, self.second, self.tz_sign, self.tz
+        ));
+        s
+    }
+}
+
+#[hegel::composite]
+fn arb_date(tc: &hegel::TestCase) -> String {
+    let year = tc.draw(int!(1998i32, 2030));
+    let month = tc.draw(int!(0usize, 11));
+    let day = tc.draw(int!(1u32, 28));
+    let dt = chrono::NaiveDate::from_ymd_opt(year, month as u32 + 1, day).unwrap();
+    let true_weekday = dt.format("%a").to_string();
+    let weekday = match tc.draw(int!(0u8, 9)) {
+        0 => None,
+        1 => Some(pick(tc, WEEKDAYS).to_string()),
+        _ => Some(true_weekday),
+    };
+    let d = GenDate {
+        weekday,
+        day,
+        month,
+        year,
+        hour: tc.draw(int!(0u32, 23)),
+        minute: tc.draw(int!(0u32, 59)),
+        second: tc.draw(int!(0u32, 59)),
+        tz_sign: if tc.draw(generators::booleans()) { '+' } else { '-' },
+        tz: *pick_owned(tc, &[0, 0, 100, 530, 1200, 45, 1400, 930]),
+        pad_day: tc.draw(int!(0u8, 4)) != 0,
+    };
+    d.text()
+}
+
+fn pick_owned<'a, T>(tc: &hegel::TestCase, items: &'a [T]) -> &'a T {
+    &items[tc.draw(int!(0usize, items.len() - 1))]
+}
+
+#[hegel::composite]
+fn arb_name(tc: &hegel::TestCase) -> String {
+    let n = tc.draw(int!(0usize, 3));
+    (0..n).map(|_| pick(tc, NAMES)).collect::<Vec<_>>().join(" ")
+}
+
+/// A generated entry: its text and the shape choices that matter for the properties.
+#[derive(Debug, Clone)]
+struct GenEntry {
+    text: String,
+    package: String,
+    version: String,
+    dists: Vec<String>,
+    metadata: Vec<(String, String)>,
+    urgency_comment: bool,
+    body: Vec<String>,
+    name: String,
+    email: String,
+    date: String,
+    malformed: Option<&'static str>,
+}
+
+#[hegel::composite]
+fn arb_entry(tc: &hegel::TestCase) -> GenEntry {
+    let package = tc.draw(arb_package());
+    let version = tc.draw(arb_version());
+    let dists = tc.draw(arb_distributions());
+    let nmeta = tc.draw(int!(0usize, 3));
+    let mut metadata: Vec<(String, String)> = Vec::new();
+    for _ in 0..nmeta {
+        let item = tc.draw(arb_metadata_item());
+        if !metadata.iter().any(|(k, _)| k.eq_ignore_ascii_case(&item.0)) {
+            metadata.push(item);
+        }
+    }
+    let urgency_comment = metadata.iter().any(|(k, _)| k == "urgency") && tc.draw(int!(0u8, 14)) == 0;
+    let body = tc.draw(arb_body());
+    let name = tc.draw(arb_name());
+    let email = pick(tc, EMAILS).to_string();
+    let date = tc.draw(arb_date());
+    let malformed = match tc.draw(int!(0u8, 24)) {
+        0 => Some("no-distribution"),
+        1 => Some("no-semicolon"),
+        2 => Some("no-version"),
+        3 => Some("one-space-before-date"),
+        4 => Some("no-footer"),
+        _ => None,
+    };
+
+    let mut text = String::new();
+    // header
+    text.push_str(&package);
+    if malformed != Some("no-version") {
+        text.push_str(&format!(" ({version})"));
+    }
+    if malformed != Some("no-distribution") {
+        for d in &dists {
+            text.push(' ');
+            text.push_str(d);
+        }
+    }
+    if malformed != Some("no-semicolon") {
+        text.push(';');
+        for (i, (k, v)) in metadata.iter().enumerate() {
+            if i > 0 {
+                text.push_str(pick(tc, &[", ", ",", " , "]));
+            } else {
+                text.push_str(pick(tc, &[" ", " ", ""]));
+            }
+            text.push_str(&format!("{k}={v}"));
+            if k == "urgency" && urgency_comment {
+                text.push_str(" (HIGH for security)");
+            }
+        }
+    }
+    text.push('\n');
+    // body
+    for _ in 0..tc.draw(int!(0usize, 2)) {
+        text.push('\n');
+    }
+    for l in &body {
+        text.push_str(l);
+        text.push('\n');
+    }
+    for _ in 0..tc.draw(int!(0usize, 2)) {
+        text.push('\n');
+    }
+    // footer
+    if malformed != Some("no-footer") {
+        text.push_str(" -- ");
+        text.push_str(&name);
+        text.push_str(&format!(" <{email}>"));
+        text.push_str(if malformed == Some("one-space-before-date") { " " } else { "  " });
+        text.push_str(&date);
+        if tc.draw(int!(0u8, 9)) == 0 {
+            text.push(' ');
+        }
+        text.push('\n');
+    }
+    GenEntry { text, package, version, dists, metadata, urgency_comment, body, name, email, date, malformed }
+}
+
+#[derive(Debug, Clone)]
+struct GenChangelog {
+    text: String,
+    entries: Vec<GenEntry>,
+}
+
+#[hegel::composite]
+fn arb_changelog(tc: &hegel::TestCase, with_comments: bool) -> GenChangelog {
+    let n = tc.draw(int!(1usize, 3));
+    let mut text = String::new();
+    let mut entries = Vec::new();
+    for i in 0..n {
+        if i > 0 {
+            for _ in 0..tc.draw(int!(0usize, 2)) {
+                text.push('\n');
+            }
+            if with_comments && tc.draw(int!(0u8, 5)) == 0 {
+                text.push_str(pick(tc, &["# a comment\n", "# Oh, and here is a comment\n\n"]));
+            }
+        }
+        let e = tc.draw(arb_entry().print_as_debug());
+        text.push_str(&e.text);
+        entries.push(e);
+    }
+    if with_comments && tc.draw(int!(0u8, 5)) == 0 {
+        text.push_str(pick(tc, &["\n# trailing comment\n", "# trailing comment"]));
+    }
+    if tc.draw(int!(0u8, 9)) == 0 {
+        text.push('\n');
+    }
+    GenChangelog { text, entries }
+}
+
+/// Entries whose header dpkg cannot read at all, which the crate reads anyway (bug 1).
+fn hits_lenient_header_bug(e: &GenEntry) -> bool {
+    matches!(e.malformed, Some("no-distribution") | Some("no-semicolon"))
+}
+
+fn is_clean_shape(e: &GenEntry) -> bool {
+    e.malformed.is_none() && !e.urgency_comment
+}
+
+fn crate_fields(entry: &Entry) -> BTreeMap<&'static str, String> {
+    let mut m = BTreeMap::new();
+    m.insert("Source", entry.package().unwrap_or_default());
+    m.insert("Version", entry.version().map(|v| v.to_string()).unwrap_or_default());
+    m.insert("Distribution", entry.distributions().unwrap_or_default().join(" "));
+    m.insert("Urgency", entry.urgency().map(|u| u.to_string()).unwrap_or_default());
+    m.insert(
+        "Maintainer",
+        match (entry.maintainer(), entry.email()) {
+            (None, None) => String::new(),
+            (name, email) => format!("{} <{}>", name.unwrap_or_default(), email.unwrap_or_default()),
+        },
+    );
+    m.insert("Date", entry.timestamp().unwrap_or_default().trim().to_string());
+    m
+}
+
+fn dpkg_field(fields: &BTreeMap<String, String>, key: &str) -> String {
+    fields.get(key).cloned().unwrap_or_default()
+}
+
+/// Compare one crate entry with dpkg's stanza for it.
+fn assert_entry_matches_dpkg(entry: &Entry, fields: &BTreeMap<String, String>, text: &str, skip: &[&str]) {
+    let cf = crate_fields(entry);
+    for key in ["Source", "Version", "Distribution", "Urgency", "Maintainer", "Date"] {
+        if skip.contains(&key) {
+            continue;
+        }
+        let mut want = dpkg_field(fields, key);
+        if key == "Urgency" && want == "unknown" {
+            want.clear(); // dpkg prints `unknown` for an absent urgency
+        }
+        assert_eq!(cf[key].trim(), want.trim(), "field {key} differs from dpkg for:\n{text}");
+    }
+    if !skip.contains(&"Timestamp") {
+        let dpkg_ts: Option<i64> = fields.get("Timestamp").map(|s| s.parse().unwrap());
+        let crate_ts = entry.datetime().map(|d| d.timestamp());
+        assert_eq!(crate_ts, dpkg_ts, "datetime() differs from dpkg's Timestamp for:\n{text}");
+    }
+    let mut lines: Vec<String> = entry.change_lines().map(|l| l.trim_end().to_string()).collect();
+    // a whitespace-only line is a blank line for dpkg; the crate keeps it as a change line
+    while lines.last().map(|l| l.is_empty()) == Some(true) {
+        lines.pop();
+    }
+    while lines.first().map(|l| l.is_empty()) == Some(true) {
+        lines.remove(0);
+    }
+    let expected: Vec<String> = dpkg_change_lines(fields)
+        .into_iter()
+        .map(|l| l.strip_prefix("  ").map(|s| s.to_string()).unwrap_or(l))
+        .collect();
+    if !skip.contains(&"Changes") {
+        assert_eq!(lines, expected, "change_lines() differ from dpkg's Changes for:\n{text}");
+    }
+    if !skip.contains(&"Closes") {
+        let refs: Vec<&str> = lines.iter().map(|s| s.as_str()).collect();
+        let mut closes: Vec<u32> = find_closed_debian_bugs(&refs).into_iter().collect();
+        closes.sort();
+        assert_eq!(closes, dpkg_list(fields, "Closes"), "find_closed_debian_bugs differs from dpkg's Closes for:\n{text}");
+        let mut lp: Vec<u32> = find_closed_launchpad_bugs(&refs).into_iter().collect();
+        lp.sort();
+        assert_eq!(lp, dpkg_list(fields, "Launchpad-Bugs-Fixed"), "find_closed_launchpad_bugs differs from dpkg's Launchpad-Bugs-Fixed for:\n{text}");
+    }
+}
+
+/// The bug-list shapes on which the crate's `Closes:`/`LP:` scanning is known to differ from dpkg.
+fn hits_closes_bug(lines: &[String]) -> bool {
+    let joined = lines.join("\n");
+    // bug 5: the marker is matched case-sensitively (`CLOSES:` is missed) and `bug` prefixes are not read
+    let odd_case = regex::Regex::new(r"(?i)closes:").unwrap().find_iter(&joined).any(|m| m.as_str() != "Closes:" && m.as_str() != "closes:");
+    let bug_prefix = regex::Regex::new(r"(?i)(closes|lp):[#\d\s,]*(bug|,\s*\d)").unwrap().is_match(&joined);
+    // bug 4: the list is read greedily: numbers separated by whitespace only, doubled commas,
+    // two spaces after `#`, and `lp:` without ` #`
+    let greedy = regex::Regex::new(r"(?i)(closes|lp):\s*[#\d\s,]*(\d\s+#?\d|,\s*,|#\s\s+\d|#\s*#|\d\s+,)").unwrap().is_match(&joined);
+    let lp_loose = regex::Regex::new(r"(?i)lp:").unwrap().find_iter(&joined).any(|m| !regex::Regex::new(r"^\s+#\d").unwrap().is_match(&joined[m.end()..]));
+    let lp_bare_item = regex::Regex::new(r"(?i)lp:[#\d\s,]*(,\s*\d|#\s+\d)").unwrap().is_match(&joined);
+    odd_case || bug_prefix || greedy || lp_loose || lp_bare_item
+}
+
+/// Package and distribution names with `+` (`g++`, `libsigc++-2.0`) are not read by the crate (bug 2).
+fn hits_package_chars_bug(package: &str) -> bool {
+    package.contains('+')
+}
+
+fn hits_plus_bug(e: &GenEntry) -> bool {
+    hits_package_chars_bug(&e.package) || e.dists.iter().any(|d| d.contains('+'))
+}
+
+/// Trailer dates dpkg reads but `datetime()` does not (bug 3): no weekday, a one-digit day, or
+/// trailing whitespace on the line.
+fn hits_datetime_bug(timestamp: &str) -> bool {
+    let t = timestamp.trim();
+    t != timestamp || !t.contains(", ") || regex::Regex::new(r"^(\w+,\s*)?\d\s").unwrap().is_match(t)
+}
+
+/// `prepend_change_line` inserts after the first blank line of the entry, which is only the
+/// right place when exactly one blank line separates the header from the changes (bug 9).
+fn hits_prepend_bug(entry_text: &str) -> bool {
+    let blanks = entry_text.lines().skip(1).take_while(|l| l.trim().is_empty()).count();
+    let has_body = entry_text.lines().skip(1).any(|l| l.starts_with("  ") && !l.trim().is_empty());
+    has_body && blanks != 1
+}
+
+fn is_footer_setter(s: &Setter) -> bool {
+    matches!(s, Setter::Maintainer(..) | Setter::Timestamp(..) | Setter::Datetime(..))
+}
+
+/// `bug_at_offset` attributes the cursor to the leading number of a comma-delimited fragment
+/// even when other text and another reference follow in the same fragment (bug 13).
+fn hits_offset_bug(line: &str) -> bool {
+    regex::Regex::new(r"(?i)(closes|lp):[^,]*[^#\d\s,:][^,]*\d").unwrap().is_match(line)
+}
+
+/// `Closes: # 123` (one space after the `#`) is read by dpkg and by `find_closed_debian_bugs`,
+/// but not by the `bugs` module (bug 8).
+fn hits_hash_space_bug(line: &str) -> bool {
+    regex::Regex::new(r"(?i)(closes|lp):[#\d\s,]*#\s+\d").unwrap().is_match(line)
+}
+
+/// dpkg's `closes:` regex has no word boundary, so `Encloses: #7` closes #7 for dpkg; the
+/// crate's `bugs` module deliberately requires one. Not counted as a divergence.
+fn marker_inside_a_word(text: &str) -> bool {
+    regex::Regex::new(r"(?i)[a-z0-9_-](closes|lp):").unwrap().is_match(text)
+}
