+/// Entries made with the builder are read back by dpkg and by the crate with the given fields.
+#[hegel::test]
+fn built_entries_are_read_back_by_dpkg(tc: hegel::TestCase) {
+    let package = tc.draw(arb_package());
+    let version = tc.draw(arb_version());
+    let dists = tc.draw(arb_distributions());
+    let urgency = if tc.draw(generators::booleans()) { Some(tc.draw(arb_urgency().print_as_debug())) } else { None };
+    let name = tc.draw(arb_name());
+    let email = pick(&tc, EMAILS).to_string();
+    let date = tc.draw(arb_date());
+    let n = tc.draw(int!(1usize, 4));
+    let lines: Vec<String> = (0..n).map(|_| tc.draw(arb_detail(true))).collect();
+    let Ok(version_parsed) = debversion::Version::from_str(&version) else { return };
+    if name.is_empty() || hits_package_chars_bug(&package) || dists.iter().any(|d| d.contains('+')) || urgency.is_none() {
+        return;
+    }
+    let mut cl = ChangeLog::new();
+    let mut b = cl.new_empty_entry().package(package.clone()).version(version_parsed.clone()).distributions(dists.clone()).maintainer((name.clone(), email.clone())).datetime(date.as_str());
+    if let Some(u) = &urgency {
+        b = b.urgency(u.clone());
+    }
+    for l in &lines {
+        b = b.change_line(l.clone());
+    }
+    b.verify().unwrap();
+    let entry = b.finish();
+    // the in-memory entry
+    assert_eq!(entry.package(), Some(package.clone()));
+    assert_eq!(entry.version(), Some(version_parsed.clone()));
+    assert_eq!(entry.distributions(), Some(dists.clone()));
+    assert_eq!(entry.urgency(), urgency.clone(), "urgency() of a built entry");
+    assert_eq!(entry.maintainer(), Some(name.clone()));
+    assert_eq!(entry.email(), Some(email.clone()));
+    assert_eq!(entry.timestamp(), Some(date.clone()));
+    assert_eq!(entry.change_lines().collect::<Vec<_>>(), lines);
+    // the text, re-read by the crate and by dpkg
+    let text = cl.to_string();
+    let reread: ChangeLog = text.parse().unwrap_or_else(|e| panic!("the builder wrote something the strict parser refuses ({e}):\n{text}"));
+    let re = reread.iter().next().unwrap();
+    assert_eq!(crate_fields(&re), crate_fields(&entry), "re-read fields differ from the built entry:\n{text}");
+    let d = dpkg(&text);
+    assert!(!d.fatal, "dpkg refuses the built entry ({:?}):\n{text}", d.warnings);
+    assert!(d.warnings.is_empty(), "dpkg warns about the built entry ({:?}):\n{text}", d.warnings);
+    assert_eq!(d.entries.len(), 1);
+    let mut skip = vec![];
+    if hits_datetime_bug(&date) {
+        skip.push("Timestamp");
+    }
+    let body: Vec<String> = re.change_lines().collect();
+    if hits_closes_bug(&body) || marker_inside_a_word(&body.join("\n")) {
+        skip.push("Closes");
+    }
+    assert_entry_matches_dpkg(&re, &d.entries[0], &text, &skip);
+}
