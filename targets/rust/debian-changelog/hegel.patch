+/// `entry_at_offset` finds the entry containing every offset in it.
+#[hegel::test]
+fn entry_at_offset_finds_the_entry(tc: hegel::TestCase) {
+    let g = tc.draw(arb_changelog(true).print_as_debug());
+    let Ok(cl) = ChangeLog::from_str(&g.text) else { return };
+    let entries: Vec<Entry> = cl.iter().collect();
+    for entry in &entries {
+        let range = entry.syntax().text_range();
+        let start: u32 = range.start().into();
+        let end: u32 = range.end().into();
+        if end <= start {
+            continue;
+        }
+        let off = tc.draw(int!(start, end - 1));
+        let found = cl.entry_at_offset(off.into()).unwrap_or_else(|| panic!("no entry at offset {off} (entry range {range:?}) in:\n{}", g.text));
+        assert_eq!(found.syntax().text_range(), range, "entry_at_offset({off}) in:\n{}", g.text);
+        let sub = rowan::TextRange::new(off.into(), (off + 1).into());
+        let in_range: Vec<Entry> = cl.entries_in_range(sub).collect();
+        assert_eq!(in_range.len(), 1, "entries_in_range({sub:?}) in:\n{}", g.text);
+        assert_eq!(in_range[0].syntax().text_range(), range);
+    }
+}
