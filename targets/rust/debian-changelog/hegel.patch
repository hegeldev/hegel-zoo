+/// Pin for bug 12: `set_metadata` adding a second key writes `; a=b c=d`, which dpkg reads as one
+/// option `a` with the value `b c=d`.
+#[hegel::test]
+fn set_metadata_separates_options_with_a_comma(tc: hegel::TestCase) {
+    let (k1, v1) = tc.draw(arb_metadata_item());
+    let (k2, v2) = tc.draw(arb_metadata_item());
+    if k1.eq_ignore_ascii_case(&k2) || (k1 != "urgency" && k2 != "urgency") {
+        return;
+    }
+    let text = format!("foo (1.0-1) unstable; {k1}={v1}\n\n  * x\n\n -- Jane Doe <jane@example.com>  Mon, 01 Jan 2024 10:00:00 +0000\n");
+    let cl: ChangeLog = text.parse().unwrap();
+    let mut entry = cl.iter().next().unwrap();
+    entry.set_metadata(&k2, &v2);
+    let out = cl.to_string();
+    let d = dpkg(&out);
+    assert!(!d.fatal, "dpkg refuses:\n{out}");
+    let urgency = if k1 == "urgency" { &v1 } else { &v2 };
+    assert_eq!(d.entries[0].get("Urgency").map(|s| s.to_lowercase()), Some(urgency.to_lowercase()), "dpkg's urgency after set_metadata({k2}):\n{out}");
+}
