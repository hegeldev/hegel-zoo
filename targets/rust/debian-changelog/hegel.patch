+        assert_eq!(entry.version().map(|v| v.to_string()), Some(f[1].clone()), "version of {header:?}");
+        assert_eq!(entry.distributions().map(|d| d.join(" ")), Some(f[2].clone()), "distributions of {header:?}");
+        for (k, v) in &e.metadata {
