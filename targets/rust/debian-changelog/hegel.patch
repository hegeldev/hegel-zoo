+/// `from_iter` keeps the entries' text; `pop_first` removes exactly the first entry.
+#[hegel::test]
+fn from_iter_and_pop_first_keep_entry_texts(tc: hegel::TestCase) {
+    let g = tc.draw(arb_changelog(false).print_as_debug());
+    let Ok(cl) = ChangeLog::from_str(&g.text) else { return };
+    let texts: Vec<String> = cl.iter().map(|e| e.to_string()).collect();
+    let rebuilt: ChangeLog = cl.iter().collect();
+    assert_eq!(rebuilt.to_string(), texts.concat(), "from_iter text");
+    let again: Vec<String> = rebuilt.iter().map(|e| e.to_string()).collect();
+    assert_eq!(again, texts, "from_iter entries");
+    // dpkg reads the rebuilt file with the same fields, when it read the original cleanly
+    let d0 = dpkg(&g.text);
+    if !d0.fatal && d0.warnings.is_empty() {
+        let d1 = dpkg(&rebuilt.to_string());
+        assert!(!d1.fatal, "dpkg refuses the from_iter text:\n{rebuilt}");
+        let keep = |m: &BTreeMap<String, String>| -> Vec<(String, String)> {
+            m.iter().filter(|(k, _)| k.as_str() != "Changes").map(|(k, v)| (k.clone(), v.clone())).collect()
+        };
+        assert_eq!(d1.entries.iter().map(keep).collect::<Vec<_>>(), d0.entries.iter().map(keep).collect::<Vec<_>>(), "dpkg fields after from_iter");
+    }
+    let mut cl = cl;
+    let n = texts.len();
+    let popped = cl.pop_first().unwrap();
+    assert_eq!(popped.to_string(), texts[0], "pop_first text");
+    let rest: Vec<String> = cl.iter().map(|e| e.to_string()).collect();
+    assert_eq!(rest, texts[1..].to_vec(), "entries after pop_first");
+    assert_eq!(cl.iter().count(), n - 1);
+    assert!(g.text.ends_with(&cl.to_string()) || cl.to_string().is_empty(), "text after pop_first is not a suffix of the input:\n{cl}");
+}
