+/// Pin for bug 3: dpkg reads a trailer date without the optional weekday, with a one-digit
+/// day, or with trailing whitespace on the line; `datetime()` does not.
+#[hegel::test]
+fn dates_dpkg_reads_are_read(tc: hegel::TestCase) {
