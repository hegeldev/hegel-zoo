+    let text = format!(
+        "foo (1.0-1) unstable; urgency=low\n\n{}\n -- Jane Doe <jane@example.com>  Mon, 01 Jan 2024 10:00:00 +0000\n",
+        body.iter().map(|l| format!("{l}\n")).collect::<String>()
+    );
