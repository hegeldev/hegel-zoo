+// --------------------------------------------------------------------------- properties: parsing
+
+/// Everything dpkg reads cleanly, the strict parser reads, with the same fields.
+#[hegel::test]
+fn changelogs_parse_like_dpkg(tc: hegel::TestCase) {
+    let g = tc.draw(arb_changelog(true).print_as_debug());
+    let d = dpkg(&g.text);
+    let parsed = ChangeLog::from_str(&g.text);
+    let all_clean = g.entries.iter().all(is_clean_shape);
+    if d.fatal {
+        if g.entries.iter().any(hits_lenient_header_bug) {
+            return;
+        }
+        assert!(parsed.is_err(), "dpkg refuses ({:?}) but the strict parser accepts:\n{}", d.warnings, g.text);
+        return;
+    }
+    if g.entries.iter().any(hits_plus_bug) && parsed.is_err() {
+        return;
+    }
+    if d.warnings.is_empty() && all_clean {
+        assert!(parsed.is_ok(), "dpkg reads this cleanly but the strict parser says {:?}:\n{}", parsed.as_ref().err().map(|e| e.to_string()), g.text);
+    }
+    let Ok(cl) = parsed else { return };
+    assert_eq!(cl.to_string(), g.text, "the CST is not lossless");
+    if g.entries.iter().any(|e| e.malformed.is_some()) {
+        return; // bug 1, and dpkg's `unknown (unknown1) unknown` entries: the entries do not line up
+    }
+    let entries: Vec<Entry> = cl.iter().collect();
+    assert_eq!(entries.len(), d.entries.len(), "entry count differs from dpkg for:\n{}", g.text);
+    for (entry, fields) in entries.iter().zip(&d.entries) {
+        if dpkg_field(fields, "Source") == "unknown" || entry.is_old_style() {
+            continue; // dpkg could not read the header (it invents `unknown (unknown1) unknown`)
+        }
+        let lines: Vec<String> = entry.change_lines().collect();
+        let mut skip: Vec<&str> = vec![];
+        if hits_closes_bug(&lines) || marker_inside_a_word(&lines.join("\n")) {
+            skip.push("Closes");
+        }
+        if entry.timestamp().map(|t| hits_datetime_bug(&t)).unwrap_or(false) {
+            skip.push("Timestamp"); // bug 3
+        }
+        assert_entry_matches_dpkg(entry, fields, &g.text, &skip);
+    }
+}
