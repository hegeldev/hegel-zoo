+            let n = tc.draw(int!(0usize, 12));
+            (0..n).map(|_| pick(tc, &["foo (1.0) unstable; urgency=low\n", "\n", "  * x\n", " -- A <a@b>  Mon, 01 Jan 2024 10:00:00 +0000\n", "1.9.16alpha10-1:\n", "Old Changelog:\n", "# c\n", " x\n", "\t\n", "foo\n", "(1.0)\n", "; urgency=low\n", " --\n", " -- \n", "  \n", "a=b\n"])).collect()
