+#[derive(Debug, Clone)]
+enum Setter {
+    Package(String),
+    Version(String),
+    Distributions(Vec<String>),
+    Urgency(Urgency),
+    Metadata(String, String),
+    Maintainer(String, String),
+    Timestamp(String),
+    Datetime(i64, i32),
+    Append(String),
+    Prepend(String),
+    Bullet(String),
+}
+
+#[hegel::composite]
+fn arb_setter(tc: &hegel::TestCase) -> Setter {
+    match tc.draw(int!(0u8, 10)) {
+        0 => Setter::Package(tc.draw(arb_package())),
+        1 => Setter::Version(tc.draw(arb_version())),
+        2 => Setter::Distributions(tc.draw(arb_distributions())),
+        3 => Setter::Urgency(tc.draw(arb_urgency().print_as_debug())),
+        4 => {
+            let (k, v) = tc.draw(arb_metadata_item());
+            Setter::Metadata(k, v)
+        }
+        5 => Setter::Maintainer(tc.draw(arb_name()), pick(tc, EMAILS).to_string()),
+        6 => Setter::Timestamp(tc.draw(arb_date())),
+        7 => Setter::Datetime(tc.draw(int!(0i64, 2_000_000_000)), tc.draw(int!(-14i32, 14)) * 3600 + tc.draw(int!(0i32, 1)) * 1800),
+        8 => Setter::Append(tc.draw(arb_detail(true))),
+        9 => Setter::Prepend(tc.draw(arb_detail(true))),
+        _ => Setter::Bullet(tc.draw(arb_detail(false)).trim().to_string()),
+    }
+}
+
+/// Setters change the in-memory entry and the text alike, and dpkg reads the new values.
+#[hegel::test]
+fn setters_are_read_back_by_dpkg(tc: hegel::TestCase) {
+    let g = tc.draw(arb_changelog(false).print_as_debug());
+    if !g.entries.iter().all(is_clean_shape) || g.entries[0].name.is_empty() || g.entries.iter().any(hits_plus_bug) {
+        return;
+    }
+    let d0 = dpkg(&g.text);
+    if d0.fatal || !d0.warnings.is_empty() {
+        return;
+    }
+    let cl: ChangeLog = g.text.parse().unwrap();
+    let mut entry = cl.iter().next().unwrap();
+    let n = tc.draw(int!(1usize, 3));
+    let setters: Vec<Setter> = (0..n).map(|_| tc.draw(arb_setter().print_as_debug())).collect();
+    let mut expected = crate_fields(&entry);
+    let mut expected_lines: Vec<String> = entry.change_lines().collect();
+    let mut expected_meta: Vec<(String, String)> = entry.header().unwrap().metadata().collect();
+    let set_meta = |k: &str, v: &str, expected_meta: &mut Vec<(String, String)>| {
+        if let Some(e) = expected_meta.iter_mut().find(|(kk, _)| kk == k) {
+            e.1 = v.to_string();
+        } else {
+            expected_meta.push((k.to_string(), v.to_string()));
+        }
+    };
+    for s in &setters {
+        match s {
+            Setter::Package(p) => {
+                if hits_package_chars_bug(p) {
+                    continue;
+                }
+                entry.set_package(p.clone());
+                expected.insert("Source", p.clone());
+            }
+            Setter::Version(v) => {
+                let Ok(v) = debversion::Version::from_str(v) else { continue };
+                entry.set_version(&v);
+                expected.insert("Version", v.to_string());
+            }
+            Setter::Distributions(ds) => {
+                if ds.iter().any(|d| d.contains('+')) {
+                    continue;
+                }
+                entry.set_distributions(ds.clone());
+                expected.insert("Distribution", ds.join(" "));
+            }
+            Setter::Urgency(u) => {
+                if !expected_meta.is_empty() && !expected_meta.iter().any(|(k, _)| k == "urgency") {
+                    continue; // bug 12
+                }
+                entry.set_urgency(u.clone());
+                expected.insert("Urgency", u.to_string());
+                set_meta("urgency", &u.to_string(), &mut expected_meta);
+            }
+            Setter::Metadata(k, v) => {
+                if k == "urgency" {
+                    continue;
+                }
+                if !expected_meta.is_empty() && !expected_meta.iter().any(|(kk, _)| kk == k) {
+                    continue; // bug 12
+                }
+                entry.set_metadata(k, v);
+                set_meta(k, v, &mut expected_meta);
+            }
+            Setter::Maintainer(name, email) => {
+                if name.is_empty() {
+                    continue;
+                }
+                entry.set_maintainer((name.clone(), email.clone()));
+                expected.insert("Maintainer", format!("{name} <{email}>"));
+            }
+            Setter::Timestamp(t) => {
+                entry.set_timestamp(t.clone());
+                expected.insert("Date", t.clone());
+            }
+            Setter::Datetime(secs, offset) => {
+                let tz = chrono::FixedOffset::east_opt(*offset).unwrap();
+                let dt = chrono::DateTime::from_timestamp(*secs, 0).unwrap().with_timezone(&tz);
+                entry.set_datetime(dt);
+                expected.insert("Date", dt.format("%a, %d %b %Y %H:%M:%S %z").to_string());
+            }
+            Setter::Append(l) => {
+                entry.append_change_line(l);
+                expected_lines.push(l.clone());
+            }
+            Setter::Prepend(l) => {
+                if hits_prepend_bug(&g.entries[0].text) {
+                    continue; // bug 9
+                }
+                entry.prepend_change_line(l);
+                expected_lines.insert(0, l.clone());
+            }
+            Setter::Bullet(t) => {
+                if t.is_empty() {
+                    continue;
+                }
+                entry.add_bullet(t);
+                let before = expected_lines.len();
+                let now: Vec<String> = entry.change_lines().collect();
+                expected_lines.extend(now[before.min(now.len())..].iter().cloned());
+            }
+        }
+    }
+    // the in-memory entry
+    if !setters.iter().any(is_footer_setter) {
+        let got = crate_fields(&entry);
+        assert_eq!(got, expected, "in-memory fields after {setters:?}:\n{cl}");
+    }
+    assert_eq!(entry.change_lines().collect::<Vec<_>>(), expected_lines, "in-memory change lines after {setters:?}:\n{cl}");
+    let got_meta: Vec<(String, String)> = entry.header().unwrap().metadata().collect();
+    assert_eq!(got_meta, expected_meta, "in-memory metadata after {setters:?}:\n{cl}");
+    // the text, re-read
+    let text = cl.to_string();
+    let reread: ChangeLog = text.parse().unwrap_or_else(|e| panic!("the setters {setters:?} wrote something the strict parser refuses ({e}):\n{text}"));
+    let re = reread.iter().next().unwrap();
+    assert_eq!(crate_fields(&re), expected, "re-read fields after {setters:?}:\n{text}");
+    assert_eq!(re.change_lines().collect::<Vec<_>>(), expected_lines, "re-read change lines after {setters:?}:\n{text}");
+    assert_eq!(re.header().unwrap().metadata().collect::<Vec<_>>(), expected_meta, "re-read metadata after {setters:?}:\n{text}");
+    // dpkg
+    let d = dpkg(&text);
+    assert!(!d.fatal, "dpkg refuses the text after {setters:?} ({:?}):\n{text}", d.warnings);
+    let mut skip = vec!["Closes"];
+    if re.timestamp().map(|t| hits_datetime_bug(&t)).unwrap_or(false) {
+        skip.push("Timestamp");
+    }
+    if expected_meta.len() > 1 && d.warnings.iter().any(|w| w.contains("unknown key-value")) {
+        skip.push("Urgency");
+    }
+    assert_entry_matches_dpkg(&re, &d.entries[0], &text, &skip);
+    for (k, v) in &expected_meta {
+        if k.eq_ignore_ascii_case("binary-only") {
+            assert_eq!(d.entries[0].get("Binary-Only"), Some(v), "dpkg's Binary-Only after {setters:?}:\n{text}");
+        }
+    }
+}
