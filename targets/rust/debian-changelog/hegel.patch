+/// Pin for bug 7: adding a change for another author to an entry without changes must not open
+/// an empty section for the maintainer (the `changes::` function does not).
+#[hegel::test]
+fn adding_for_another_author_to_an_empty_entry_opens_one_section(tc: hegel::TestCase) {
+    let maintainer = tc.draw(arb_name());
+    let author = tc.draw(arb_name());
+    if maintainer.is_empty() || author.is_empty() || author == maintainer {
+        return;
+    }
+    let text = format!("foo (1.0-1) unstable; urgency=low\n\n -- {maintainer} <m@example.com>  Mon, 01 Jan 2024 10:00:00 +0000\n");
+    let cl: ChangeLog = text.parse().unwrap();
+    let entry = cl.iter().next().unwrap();
+    assert_eq!(entry.change_lines().count(), 0);
+    let line = format!("* {}", tc.draw(arb_detail(false)).trim());
+    entry.try_add_change_for_author(&[line.as_str()], (author.clone(), "a@example.com".into())).unwrap();
+    let mut model: Vec<String> = vec![];
+    debian_changelog::changes::try_add_change_for_author(&mut model, &author, vec![line.as_str()], Some((maintainer.clone(), "m@example.com".into()))).unwrap();
+    assert_eq!(entry.change_lines().collect::<Vec<_>>(), model, "Entry::try_add_change_for_author vs changes::try_add_change_for_author on an empty entry");
+}
