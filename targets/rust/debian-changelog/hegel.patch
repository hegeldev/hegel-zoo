+/// The CST is lossless for any text, strict or relaxed, and the accessors never panic.
+#[hegel::test]
+fn the_tree_is_lossless_for_any_text(tc: hegel::TestCase) {
+    let text = tc.draw(arb_text());
+    let parsed = ChangeLog::parse(&text);
+    assert_eq!(parsed.tree().to_string(), text, "Parse::tree() text");
+    let relaxed = ChangeLog::parse_relaxed(&text);
+    assert_eq!(relaxed.to_string(), text, "parse_relaxed text");
+    let n_lines = text.lines().count();
+    let mut concat = String::new();
+    for entry in relaxed.iter() {
+        let _ = (entry.package(), entry.try_version(), entry.distributions(), entry.try_urgency(), entry.maintainer(), entry.email(), entry.timestamp(), entry.datetime());
+        let _ = (entry.is_unreleased(), entry.is_team_upload(), entry.get_authors(), entry.iter_changes_by_author(), entry.is_old_style());
+        let lines: Vec<String> = entry.change_lines().collect();
+        let refs: Vec<&str> = lines.iter().map(|s| s.as_str()).collect();
+        let _ = (find_closed_debian_bugs(&refs), find_closed_launchpad_bugs(&refs), find_extra_authors(&refs));
+        assert!(entry.line() <= n_lines, "entry.line() {} beyond the {n_lines} lines", entry.line());
+        concat.push_str(&entry.to_string());
+    }
+    assert!(text.contains(&concat) || concat.is_empty() || relaxed.iter().count() > 1, "entry text is not a substring of the input");
+    if let Ok(cl) = ChangeLog::from_str(&text) {
+        assert_eq!(cl.to_string(), text, "strict parse text");
+        assert!(parsed.ok(), "from_str succeeded but Parse::ok() is false");
+    } else {
+        assert!(!parsed.ok(), "from_str failed but Parse::ok() is true");
+    }
+    // the entries in the full range are all the entries
+    let full = rowan::TextRange::new(0.into(), rowan::TextSize::of(text.as_str()));
+    assert_eq!(relaxed.entries_in_range(full).count(), relaxed.iter().count(), "entries_in_range(full)");
+}
