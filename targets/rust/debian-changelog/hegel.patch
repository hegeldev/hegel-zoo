+/// `add_bullet` wraps to 78 columns, keeps every word, and keeps `Closes: #N` together.
+#[hegel::test]
+fn add_bullet_wraps_and_keeps_the_words(tc: hegel::TestCase) {
+    let n = tc.draw(int!(1usize, 40));
+    let words: Vec<String> = (0..n)
+        .map(|_| match tc.draw(int!(0u8, 9)) {
+            0 => format!("Closes: #{}", tc.draw(int!(1u32, 9_999_999))),
+            1 => chars_from(&tc, "abcdefghijklmnopqrstuvwxyz-", tc.draw(int!(1usize, 90))),
+            _ => pick(&tc, WORDS).to_string(),
+        })
+        .collect();
+    let text = words.join(" ");
+    let mut cl = ChangeLog::new();
+    let entry = cl.new_empty_entry().package("foo".into()).version("1.0-1".parse().unwrap()).distribution("unstable".into()).urgency(Urgency::Medium).maintainer(("A B".into(), "a@b.c".into())).datetime("Mon, 01 Jan 2024 10:00:00 +0000").change_line("* first".into()).finish();
+    entry.add_bullet(&text);
+    let lines: Vec<String> = entry.change_lines().collect();
+    assert_eq!(lines[0], "* first");
+    let new = &lines[1..];
+    assert!(!new.is_empty(), "add_bullet added nothing for {text:?}");
+    assert!(new[0].starts_with("* "), "first wrapped line {:?}", new[0]);
+    for l in &new[1..] {
+        assert!(l.starts_with("  ") && !l.starts_with("   "), "continuation line {l:?}");
+    }
+    let mut joined = String::new();
+    for (i, l) in new.iter().enumerate() {
+        let body = if i == 0 { &l[2..] } else { &l[2..] };
+        assert_eq!(body.trim(), body, "line {l:?} has surrounding whitespace");
+        if i > 0 {
+            joined.push(' ');
+        }
+        joined.push_str(body);
+    }
+    assert_eq!(joined.split_whitespace().collect::<Vec<_>>(), text.split_whitespace().collect::<Vec<_>>(), "words changed for {text:?}: {new:?}");
+    for pair in new.windows(2) {
+        assert!(!(pair[0].ends_with("Closes:") && pair[1][2..].starts_with('#')), "Closes: separated from its number: {pair:?}");
+    }
+    let t = cl.to_string();
+    let d = dpkg(&t);
+    assert!(!d.fatal && d.warnings.is_empty(), "dpkg after add_bullet: {:?}\n{t}", d.warnings);
+}
