+/// The edit used by the arbitrary-text reparse properties.
+fn arb_reparse_edit(tc: &hegel::TestCase, text: &str) -> (String, rowan::TextRange) {
+    let chars: Vec<char> = text.chars().collect();
+    let a = tc.draw(int!(0, chars.len() as i64)) as usize;
+    let b = tc.draw(int!(a as i64, chars.len() as i64)) as usize;
+    let n = tc.draw(int!(0, 3));
+    let insert: String = (0..n)
+        .map(|_| pick(tc, &[':', '#', '\n', ' ', '\t', 'x', 'K', '-', '\r']))
+        .collect();
+    let start: usize = chars[..a].iter().map(|c| c.len_utf8()).sum();
+    let end: usize = chars[..b].iter().map(|c| c.len_utf8()).sum();
+    let new_text = format!("{}{}{}", &text[..start], insert, &text[end..]);
+    // The edited range in the coordinates of the new text.
+    let range = rowan::TextRange::new((start as u32).into(), ((start + insert.len()) as u32).into());
+    (new_text, range)
+}
