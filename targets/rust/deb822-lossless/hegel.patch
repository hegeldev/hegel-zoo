+/// deb822-lossless/8
+#[test]
+fn set_writes_the_value_after_a_bare_colon() {
+    for input in ["A:\nB: 1\n", "A: \nB: 1\n"] {
+        let d = Deb822::from_str(input).unwrap();
+        let mut p = d.paragraphs().next().unwrap();
+        p.set("A", "a");
+        let text = d.to_string();
+        let re = Deb822::from_str(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+        assert_eq!(re.paragraphs().next().unwrap().get("A").as_deref(), Some("a"), "{text:?}");
+    }
+    let d = Deb822::from_str("A:\nB: 1\n").unwrap();
+    let mut p = d.paragraphs().next().unwrap();
+    p.change_field_indent("A", &IndentPattern::Fixed(1)).unwrap();
+    let text = d.to_string();
+    assert_eq!(Deb822::from_str(&text).unwrap().paragraphs().count(), 1, "{text:?}");
+}
