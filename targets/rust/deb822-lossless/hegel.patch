+fn compare_paras(what: &str, text: &str, ours: &Paras, theirs: &Paras, dpkg_style: bool) {
+    let n = |v: &str| if dpkg_style { norm_dpkg(v) } else { norm(v) };
+    assert_eq!(
+        ours.len(),
+        theirs.len(),
+        "{what}: paragraph count differs for {text:?}\nours: {ours:?}\ntheirs: {theirs:?}"
+    );
+    for (o, t) in ours.iter().zip(theirs) {
+        assert_eq!(
+            keys_ci(o),
+            keys_ci(t),
+            "{what}: keys differ for {text:?}\nours: {o:?}\ntheirs: {t:?}"
+        );
+        for ((k, ov), (_, tv)) in o.iter().zip(t) {
+            assert_eq!(
+                norm(ov),
+                n(tv),
+                "{what}: value of {k} differs for {text:?}\nours: {ov:?}\ntheirs: {tv:?}"
+            );
+        }
+    }
+}
