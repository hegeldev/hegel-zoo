+#[hegel::test]
+fn normalize_field_spacing_keeps_the_values(tc: hegel::TestCase) {
+    let mut opts = tc.draw(arb_opts().print_as_debug());
+    opts.crlf = false;
+    let gen = tc.draw(arb_doc(opts).print_as_debug());
+    let text = gen.text();
+    let mut doc = match Deb822::from_str(&text) {
+        Ok(d) => d,
+        Err(_) => return,
+    };
+    let before = crate_paras(&doc);
+    let _changed = doc.normalize_field_spacing();
+    let after_text = doc.to_string();
+    let after = crate_paras(&doc);
+    let n = |ps: &Paras| -> Vec<Vec<(String, Vec<String>)>> {
+        ps.iter().map(|p| p.iter().map(|(k, v)| (k.clone(), norm(v))).collect()).collect()
+    };
+    assert_eq!(n(&after), n(&before), "normalize_field_spacing changed values of {text:?} -> {after_text:?}");
+    let reparsed = Deb822::from_str(&after_text).unwrap_or_else(|e| panic!("{after_text:?}: {e}"));
+    assert_eq!(n(&crate_paras(&reparsed)), n(&before));
+    // Every first line now has exactly `Key: value` (or `Key:` for an empty first line).
+    for p in reparsed.paragraphs() {
+        for e in p.entries() {
+            let s = e.to_string();
+            let k = e.key().unwrap();
+            let rest = &s[k.len()..];
+            assert!(
+                rest.starts_with(": ") || rest.starts_with(":\n") || rest == ":",
+                "entry {s:?} not normalised in {after_text:?}"
+            );
+        }
+    }
+    // Idempotent.
+    let mut again = reparsed;
+    let changed_again = again.normalize_field_spacing();
+    assert!(!changed_again, "normalize_field_spacing not idempotent on {after_text:?}");
+    assert_eq!(again.to_string(), after_text);
+}
