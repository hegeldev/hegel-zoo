+/// deb822-lossless/9
+#[test]
+fn inserting_after_an_unterminated_last_line_starts_a_new_line() {
+    let d = Deb822::from_str("A: 1").unwrap();
+    let mut p = d.paragraphs().next().unwrap();
+    p.insert("B", "2");
+    let text = d.to_string();
+    let re = Deb822::from_str(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    let p = re.paragraphs().next().unwrap();
+    assert_eq!(p.get("A").as_deref(), Some("1"), "{text:?}");
+    assert_eq!(p.get("B").as_deref(), Some("2"), "{text:?}");
+    let mut d = Deb822::from_str("A: 1\n\nB: 2").unwrap();
+    d.swap_paragraphs(0, 1);
+    let text = d.to_string();
+    assert_eq!(Deb822::from_str(&text).unwrap().paragraphs().count(), 2, "{text:?}");
+}
