+        })
+        .collect();
+    if candidates.is_empty() {
+        return;
+    }
+    let li = pick(&tc, &candidates);
+    let start: usize = lines[..li].iter().map(|l| l.len()).sum();
+    let end = start + lines[li].len();
+    let replacement = if lines[li].starts_with([' ', '\t']) {
+        format!(" {}\n", tc.draw(arb_line(false)))
+    } else {
+        format!("{}: {}\n", tc.draw(arb_key()), tc.draw(arb_line(true)))
+    };
