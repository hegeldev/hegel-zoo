+#[hegel::test]
+fn entries_with_formatting_are_read_back(tc: hegel::TestCase) {
+    let key = tc.draw(arb_key());
+    let lines = tc.draw(arb_value_lines().print_as_debug());
+    let value = lines.join("\n");
+    let post_colon = tc.draw(arb_hws(true));
+    let indent = tc.draw(arb_hws(false));
+    let entry = match Entry::try_with_formatting(&key, &value, &post_colon, &indent) {
+        Ok(e) => e,
+        Err(e) => panic!("try_with_formatting({key:?}, {value:?}, {post_colon:?}, {indent:?}): {e}"),
+    };
+    assert_eq!(entry.key().as_deref(), Some(key.as_str()));
+    assert_eq!(norm(&entry.value()), lines);
+    let text = entry.to_string();
+    let p = Paragraph::from_str(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    let items: Vec<(String, String)> = p.items().collect();
+    assert_eq!(items.len(), 1, "{text:?}");
+    assert_eq!(items[0].0, key);
+    assert_eq!(norm(&items[0].1), lines, "{text:?}");
+    let plain = Entry::new(&key, &value);
+    assert_eq!(norm(&plain.value()), lines);
+    let with_indent = Entry::with_indentation(&key, &value, &indent);
+    assert_eq!(norm(&with_indent.value()), lines);
+    let py = pydebian(&text).unwrap();
+    assert_eq!(py.len(), 1, "{text:?}");
+    assert_eq!(norm(&py[0][0].1), lines, "{text:?}");
+}
