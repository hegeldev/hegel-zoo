+/// deb822-lossless/5
+#[test]
+fn reparse_matches_a_full_parse() {
+    // Filling the blank line before a comment joins two paragraphs; the
+    // incremental reparse keeps them apart.
+    let re = Deb822::parse("\n#\nA:\n").reparse("A: \n#\nA:\n", rowan::TextRange::new(0.into(), 4.into()));
+    let full = Deb822::parse("A: \n#\nA:\n");
+    assert_eq!(re.tree().to_string(), "A: \n#\nA:\n");
+    assert_eq!(crate_paras(&re.tree()), crate_paras(&full.tree()));
+    assert!(re.tree().tree_eq(&full.tree()));
+    // Errors outside the reparsed region are dropped, even for a no-op edit.
+    let re = Deb822::parse(":\r\n").reparse(":\r\n", rowan::TextRange::new(2.into(), 2.into()));
+    assert_eq!(re.errors(), Deb822::parse(":\r\n").errors());
+}
