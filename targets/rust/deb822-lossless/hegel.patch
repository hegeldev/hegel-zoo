+/// deb822-lossless/11
+#[test]
+fn moving_a_paragraph_forward_keeps_the_other_paragraphs_apart() {
+    let mut d = Deb822::from_str("A: 1\n\nB: 2\n\nC: 3\n").unwrap();
+    d.move_paragraph(1, 2);
+    let text = d.to_string();
+    let keys: Vec<String> = Deb822::from_str(&text)
+        .unwrap()
+        .paragraphs()
+        .map(|p| p.keys().next().unwrap())
+        .collect();
+    assert_eq!(keys, ["A", "C", "B"], "{text:?}");
+}
