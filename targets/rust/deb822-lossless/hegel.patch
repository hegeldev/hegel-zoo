+type Model = Vec<Vec<(String, Vec<String>)>>;
+
+#[derive(Clone, Debug)]
+enum Edit {
+    Set { para: usize, key: String, lines: Vec<String> },
+    Insert { para: usize, key: String, lines: Vec<String> },
+    Remove { para: usize, key: String },
+    Rename { para: usize, key: String, new_key: String },
+    SetMultiline { para: usize, key: String, lines: Vec<String> },
+    ChangeIndent { para: usize, key: String, indent: u32 },
+    NormalizeSpacing { para: usize },
+    InsertComment { para: usize, text: String },
+    WrapAndSortParagraph { para: usize, indent: u32, sort: bool },
+    WrapAndSortDocument { sort: bool },
+    InsertParagraph { index: usize, fields: Vec<(String, Vec<String>)> },
+    AddParagraph { fields: Vec<(String, Vec<String>)> },
+    RemoveParagraph { index: usize },
+    MoveParagraph { from: usize, to: usize },
+    SwapParagraphs { a: usize, b: usize },
+}
+
+#[hegel::composite]
+fn arb_value_lines(tc: &hegel::TestCase) -> Vec<String> {
+    let n = tc.draw(int!(1, 3));
+    // An empty first line with continuation lines hits deb822-lossless/2 and a
+    // continuation line starting with `#` hits deb822-lossless/4.
+    let mut lines = vec![tc.draw(arb_line(n == 1))];
+    for _ in 1..n {
+        let mut l = no_dot_run(tc.draw(arb_line(false)));
+        if l.starts_with('#') {
+            l.insert(0, 'x');
+        }
+        lines.push(l);
+    }
+    lines
+}
+
+fn fresh_key(tc: &hegel::TestCase, model: &Model, para: usize) -> String {
+    let mut k = tc.draw(arb_key());
+    if model[para].iter().any(|(kk, _)| kk.eq_ignore_ascii_case(&k)) {
+        k.push_str("new");
+    }
+    if model[para].iter().any(|(kk, _)| kk.eq_ignore_ascii_case(&k)) {
+        k.push_str("er");
+    }
+    k
+}
+
+fn existing_or_fresh_key(tc: &hegel::TestCase, model: &Model, para: usize) -> String {
+    if !model[para].is_empty() && tc.draw(int!(0, 3)) != 0 {
+        let (k, _) = pick(tc, &model[para]);
+        match tc.draw(int!(0, 2)) {
+            0 => k.to_ascii_uppercase(),
+            1 => k.to_ascii_lowercase(),
+            _ => k,
+        }
+    } else {
+        fresh_key(tc, model, para)
+    }
+}
+
+#[hegel::composite]
+fn arb_fields(tc: &hegel::TestCase) -> Vec<(String, Vec<String>)> {
+    let n = tc.draw(int!(1, 3)) as usize;
+    let keys = tc.draw(arb_keys(n).print_as_debug());
+    let mut fields = Vec::new();
+    for k in keys {
+        fields.push((k, tc.draw(arb_value_lines().print_as_debug())));
+    }
+    fields
+}
+
+fn arb_edit(tc: &hegel::TestCase, model: &Model, allow_wrap: bool) -> Edit {
+    let n = model.len();
+    let kind = if n == 0 {
+        tc.draw(int!(9, 10))
+    } else if allow_wrap {
+        tc.draw(int!(0, 14))
+    } else {
+        let k = tc.draw(int!(0, 12));
+        if k >= 8 { k + 1 } else { k }
+    };
+    let para = if n == 0 { 0 } else { tc.draw(int!(0, n as i64 - 1)) as usize };
+    match kind {
+        0 => Edit::Set {
+            para,
+            key: existing_or_fresh_key(tc, model, para),
+            lines: tc.draw(arb_value_lines().print_as_debug()),
+        },
+        1 => Edit::Insert { para, key: fresh_key(tc, model, para), lines: tc.draw(arb_value_lines().print_as_debug()) },
+        2 => Edit::Remove { para, key: existing_or_fresh_key(tc, model, para) },
+        3 => Edit::Rename {
+            para,
+            key: existing_or_fresh_key(tc, model, para),
+            new_key: fresh_key(tc, model, para),
+        },
+        4 => Edit::SetMultiline {
+            para,
+            key: existing_or_fresh_key(tc, model, para),
+            lines: tc.draw(arb_value_lines().print_as_debug()),
+        },
+        5 => Edit::ChangeIndent {
+            para,
+            key: existing_or_fresh_key(tc, model, para),
+            indent: tc.draw(int!(1, 4)) as u32,
+        },
+        6 => Edit::NormalizeSpacing { para },
+        7 => Edit::InsertComment { para, text: tc.draw(arb_line(true)) },
+        8 => Edit::WrapAndSortParagraph {
+            para,
+            indent: tc.draw(int!(1, 4)) as u32,
+            sort: tc.draw(generators::booleans()),
+        },
+        9 => Edit::InsertParagraph {
+            index: tc.draw(int!(0, n as i64)) as usize,
+            fields: tc.draw(arb_fields().print_as_debug()),
+        },
+        10 => Edit::AddParagraph { fields: tc.draw(arb_fields().print_as_debug()) },
+        11 => Edit::RemoveParagraph { index: para },
+        12 => Edit::MoveParagraph { from: para, to: tc.draw(int!(0, n as i64 - 1)) as usize },
+        13 => Edit::SwapParagraphs { a: para, b: tc.draw(int!(0, n as i64 - 1)) as usize },
+        _ => Edit::WrapAndSortDocument { sort: tc.draw(generators::booleans()) },
+    }
+}
+
+fn model_set(p: &mut Vec<(String, Vec<String>)>, key: &str, lines: &[String]) {
+    if let Some(e) = p.iter_mut().find(|(k, _)| k.eq_ignore_ascii_case(key)) {
+        e.1 = lines.to_vec();
+    } else {
+        p.push((key.to_string(), lines.to_vec()));
+    }
+}
+
+fn sort_model_para(p: &mut Vec<(String, Vec<String>)>) {
+    p.sort_by(|a, b| a.0.cmp(&b.0));
+}
+
+fn nth_para(doc: &Deb822, i: usize) -> Paragraph {
+    doc.paragraphs().nth(i).unwrap_or_else(|| panic!("no paragraph {i} in {:?}", doc.to_string()))
+}
+
+/// Apply an edit to the live tree and to the model.
+fn apply(doc: &mut Deb822, model: &mut Model, edit: &Edit) {
+    match edit {
+        Edit::Set { para, key, lines } => {
+            let mut p = nth_para(doc, *para);
+            p.set(key, &lines.join("\n"));
+            model_set(&mut model[*para], key, lines);
+        }
+        Edit::Insert { para, key, lines } => {
+            let mut p = nth_para(doc, *para);
+            p.insert(key, &lines.join("\n"));
+            model[*para].push((key.clone(), lines.clone()));
+        }
+        Edit::Remove { para, key } => {
+            let mut p = nth_para(doc, *para);
+            p.remove(key);
+            model[*para].retain(|(k, _)| !k.eq_ignore_ascii_case(key));
+        }
+        Edit::Rename { para, key, new_key } => {
+            let mut p = nth_para(doc, *para);
+            let existed = model[*para].iter().any(|(k, _)| k.eq_ignore_ascii_case(key));
+            let renamed = p.rename(key, new_key);
+            assert_eq!(renamed, existed, "rename({key:?}, {new_key:?}) return value");
+            if let Some(e) = model[*para].iter_mut().find(|(k, _)| k.eq_ignore_ascii_case(key)) {
+                e.0 = new_key.clone();
+            }
+        }
+        Edit::SetMultiline { para, key, lines } => {
+            let mut p = nth_para(doc, *para);
+            p.set_multiline(key, &lines.join("\n"), None)
+                .unwrap_or_else(|e| panic!("set_multiline({key:?}, {lines:?}): {e}"));
+            model_set(&mut model[*para], key, lines);
+        }
+        Edit::ChangeIndent { para, key, indent } => {
+            let mut p = nth_para(doc, *para);
+            let existed = model[*para].iter().any(|(k, _)| k.eq_ignore_ascii_case(key));
+            let changed = p
+                .change_field_indent(key, &IndentPattern::Fixed(*indent as usize))
+                .unwrap_or_else(|e| panic!("change_field_indent({key:?}, {indent}): {e}"));
+            assert_eq!(changed, existed, "change_field_indent({key:?}) return value");
+        }
+        Edit::NormalizeSpacing { para } => {
+            let mut p = nth_para(doc, *para);
+            let _ = p.normalize_field_spacing();
+        }
+        Edit::InsertComment { para, text } => {
+            let mut p = nth_para(doc, *para);
+            p.insert_comment_before(text);
+        }
+        Edit::WrapAndSortParagraph { para, indent, sort } => {
+            let p = nth_para(doc, *para);
+            let cmp = |a: &Entry, b: &Entry| a.key().cmp(&b.key());
+            let sorter: Option<&dyn Fn(&Entry, &Entry) -> std::cmp::Ordering> =
+                if *sort { Some(&cmp) } else { None };
+            let new_p = p.wrap_and_sort(Indentation::Spaces(*indent), false, None, sorter, None);
+            // Put the rewritten paragraph in place of the old one.
+            let idx = p.syntax_index();
+            doc.replace_paragraph(idx, new_p);
+            if *sort {
+                sort_model_para(&mut model[*para]);
+            }
+        }
+        Edit::WrapAndSortDocument { sort } => {
+            let cmp = |a: &Entry, b: &Entry| a.key().cmp(&b.key());
+            let sorter: Option<&dyn Fn(&Entry, &Entry) -> std::cmp::Ordering> =
+                if *sort { Some(&cmp) } else { None };
+            let wrap = |p: &Paragraph| p.wrap_and_sort(Indentation::Spaces(1), false, None, sorter, None);
+            *doc = doc.wrap_and_sort(None, Some(&wrap));
+            if *sort {
+                for p in model.iter_mut() {
+                    sort_model_para(p);
+                }
+            }
+        }
+        Edit::InsertParagraph { index, fields } => {
+            let mut p = doc.insert_paragraph(*index);
+            for (k, lines) in fields {
+                p.set(k, &lines.join("\n"));
+            }
+            model.insert(*index, fields.clone());
+        }
+        Edit::AddParagraph { fields } => {
+            let mut p = doc.add_paragraph();
+            for (k, lines) in fields {
+                p.set(k, &lines.join("\n"));
+            }
+            model.push(fields.clone());
+        }
+        Edit::RemoveParagraph { index } => {
+            doc.remove_paragraph(*index);
+            model.remove(*index);
+        }
+        Edit::MoveParagraph { from, to } => {
+            doc.move_paragraph(*from, *to);
+            let p = model.remove(*from);
+            model.insert(*to, p);
+        }
+        Edit::SwapParagraphs { a, b } => {
+            doc.swap_paragraphs(*a, *b);
+            model.swap(*a, *b);
+        }
+    }
+}
+
+trait ParagraphIndex {
+    fn syntax_index(&self) -> usize;
+}
+impl ParagraphIndex for Paragraph {
+    fn syntax_index(&self) -> usize {
+        use rowan::ast::AstNode;
+        self.syntax().index()
+    }
+}
+
+trait ReplaceParagraph {
+    fn replace_paragraph(&mut self, syntax_index: usize, new_p: Paragraph);
+}
+impl ReplaceParagraph for Deb822 {
+    fn replace_paragraph(&mut self, syntax_index: usize, new_p: Paragraph) {
+        use rowan::ast::AstNode;
+        let root = self.syntax();
+        root.splice_children(syntax_index..syntax_index + 1, vec![new_p.syntax().clone().into()]);
+    }
+}
+
+fn check_model(what: &str, doc: &Deb822, model: &Model, trail: &[Edit]) {
+    let text = doc.to_string();
+    // A paragraph whose last field was removed has no text; nobody can read it back.
+    let live: Paras = crate_paras(doc).into_iter().filter(|p| !p.is_empty()).collect();
+    let model: Model = model.iter().filter(|p| !p.is_empty()).cloned().collect();
+    let model = &model;
+    let expect: Paras = model
+        .iter()
+        .map(|p| p.iter().map(|(k, v)| (k.clone(), v.join("\n"))).collect())
+        .collect();
+    let normalise = |ps: &Paras| -> Vec<Vec<(String, Vec<String>)>> {
+        ps.iter()
+            .map(|p| p.iter().map(|(k, v)| (k.clone(), norm(v))).collect())
+            .collect()
+    };
+    assert_eq!(
+        normalise(&live),
+        normalise(&expect),
+        "{what}: live tree differs from the model after {trail:?}\ntext: {text:?}"
+    );
+    let reparsed = Deb822::from_str(&text)
+        .unwrap_or_else(|e| panic!("{what}: text does not re-parse after {trail:?}: {e}\ntext: {text:?}"));
+    assert_eq!(
+        normalise(&crate_paras(&reparsed)),
+        normalise(&expect),
+        "{what}: re-parse differs from the model after {trail:?}\ntext: {text:?}"
+    );
+    let py = pydebian(&text).unwrap();
+    compare_paras(&format!("{what}: python-debian after {trail:?}"), &text, &expect, &py, false);
+    let dp = dpkg(&text).unwrap_or_else(|e| panic!("{what}: dpkg rejects {text:?} after {trail:?}: {e}"));
+    compare_paras(&format!("{what}: dpkg after {trail:?}"), &text, &expect, &dp, true);
+}
+
+#[hegel::test]
+fn edits_are_read_back(tc: hegel::TestCase) {
+    let mut opts = tc.draw(arb_opts().print_as_debug());
+    opts.crlf = false;
+    opts.trailing_ws = false;
+    opts.empty_first_line = false;
+    let gen = tc.draw(arb_doc(opts).print_as_debug());
+    if hits_any_parse_bug(&gen) {
+        return;
+    }
+    let text = gen.text();
+    let mut doc = match Deb822::from_str(&text) {
+        Ok(d) => d,
+        Err(_) => return,
+    };
+    let mut model: Model = gen.model();
+    let n = tc.draw(int!(1, 4));
+    let mut trail = Vec::new();
+    let allow_wrap = !hits_wrap_comment_bug(&gen);
+    for _ in 0..n {
+        let edit = arb_edit(&tc, &model, allow_wrap);
+        if hits_index_bug(&doc, &edit)
+            || hits_set_bare_colon_bug(&doc, &edit)
+            || hits_missing_newline_bug(&doc, &edit)
+            || hits_flattened_comment_bug(&doc, &edit)
+        {
+            continue;
+        }
+        trail.push(edit.clone());
+        apply(&mut doc, &mut model, &edit);
+        check_model("edit", &doc, &model, &trail);
+    }
+}
