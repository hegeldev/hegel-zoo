+#[hegel::test]
+fn position_queries_agree_with_ranges(tc: hegel::TestCase) {
+    let mut opts = tc.draw(arb_opts().print_as_debug());
+    opts.crlf = false;
+    let doc = tc.draw(arb_doc(opts).print_as_debug());
+    let text = doc.text();
+    let tree = match Deb822::from_str(&text) {
+        Ok(t) => t,
+        Err(_) => return,
+    };
+    let line_of = |off: usize| text[..off].matches('\n').count();
+    let col_of = |off: usize| off - text[..off].rfind('\n').map(|i| i + 1).unwrap_or(0);
+    for p in tree.paragraphs() {
+        let r = p.text_range();
+        let start: usize = r.start().into();
+        let end: usize = r.end().into();
+        assert_eq!(p.line_col(), (line_of(start), col_of(start)), "{text:?}");
+        let found = tree.paragraph_at_position(r.start()).expect("paragraph at its own start");
+        assert_eq!(found.text_range(), r, "{text:?}");
+        if end > start {
+            let found = tree.paragraph_at_position((end as u32 - 1).into()).unwrap();
+            assert_eq!(found.text_range(), r, "{text:?}");
+        }
+        let found = tree.paragraph_at_line(p.line()).expect("paragraph at its own line");
+        assert_eq!(found.text_range(), r, "paragraph_at_line({}) for {text:?}", p.line());
+        for e in p.entries() {
+            let er = e.text_range();
+            let es: usize = er.start().into();
+            let (l, c) = e.line_col();
+            assert_eq!((l, c), (line_of(es), col_of(es)), "{text:?}");
+            let found = tree.entry_at_line_col(l, c).expect("entry at its own start");
+            assert_eq!(found.text_range(), er, "entry_at_line_col({l},{c}) for {text:?}");
+            if let Some(kr) = e.key_range() {
+                assert_eq!(&text[usize::from(kr.start())..usize::from(kr.end())], e.key().unwrap());
+            }
+            if let Some(cr) = e.colon_range() {
+                assert_eq!(&text[usize::from(cr.start())..usize::from(cr.end())], ":");
+            }
+            for lr in e.value_line_ranges() {
+                assert!(er.contains_range(lr), "value line range {lr:?} outside entry {er:?} in {text:?}");
+            }
+            if let Some(vr) = e.value_range() {
+                assert!(er.contains_range(vr), "{text:?}");
+            }
+        }
+        // Entries in the paragraph are found by position too.
+        for e in p.entries() {
+            let er = e.text_range();
+            let found = p.entry_at_position(er.start()).unwrap();
+            assert_eq!(found.text_range(), er);
+        }
+    }
+}
