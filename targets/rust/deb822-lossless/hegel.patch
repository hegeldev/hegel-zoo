+//! Hegel property tests for deb822-lossless, checked against the two reference
+//! implementations installed on the system: dpkg's `Dpkg::Control::HashCore`
+//! (Perl) and python-debian's `Deb822` (Python).
+#![allow(clippy::all, dead_code)]
+
+use deb822_lossless::{Deb822, Entry, IndentPattern, Indentation, Paragraph};
+use hegel::generators::{self, Generator};
+use std::collections::BTreeSet;
+use std::fmt::Debug;
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::str::FromStr;
+use std::sync::{Mutex, OnceLock};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+// ---------------------------------------------------------------------------
+// Oracles
+// ---------------------------------------------------------------------------
+
+const PYTHON_SCRIPT: &str = r#"
+import sys, json, binascii
+from debian.deb822 import Deb822
+for line in sys.stdin:
+    cmd, _, arg = line.rstrip('\n').partition(' ')
+    text = binascii.unhexlify(arg).decode('utf-8')
+    try:
+        if cmd == 'P':
+            paras = []
+            for p in Deb822.iter_paragraphs(text):
+                paras.append([[k, v] for k, v in p.items()])
+            out = {'paras': paras}
+        elif cmd == 'D':
+            out = {'dump': ''.join(p.dump() for p in Deb822.iter_paragraphs(text))}
+        else:
+            out = {'error': 'unknown command'}
+    except Exception as e:
+        out = {'error': repr(e)}
+    sys.stdout.write(json.dumps(out) + '\n')
+    sys.stdout.flush()
+"#;
+
+const PERL_SCRIPT: &str = r#"
+use strict; use warnings;
+use JSON::PP;
+use Dpkg::Control::HashCore;
+$| = 1;
+my $json = JSON::PP->new->canonical->utf8;
+while (my $line = <STDIN>) {
+    chomp $line;
+    my ($cmd, $arg) = split / /, $line, 2;
+    my $text = pack('H*', $arg);
+    my $out;
+    if ($cmd eq 'P') {
+        open(my $fh, '<', \$text) or die;
+        my @paras;
+        my $ok = eval {
+            while (1) {
+                my $h = Dpkg::Control::HashCore->new(allow_pgp => 0, allow_duplicate => 0);
+                my $n = $h->parse($fh, 'zoo');
+                last unless $n;
+                my @f;
+                for my $k (keys %$h) {
+                    my ($kk, $vv) = ($k, $h->{$k});
+                    utf8::decode($kk);
+                    utf8::decode($vv) if defined $vv;
+                    push @f, [$kk, $vv];
+                }
+                push @paras, \@f;
+            }
+            1;
+        };
+        if ($ok) { $out = { paras => \@paras } }
+        else { my $e = "$@"; $e =~ s/\s+/ /g; $out = { error => $e } }
+    } else {
+        $out = { error => 'unknown command' };
+    }
+    print $json->encode($out), "\n";
+}
+"#;
+
+struct Child2 {
+    _child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+fn spawn(program: &str, args: &[&str]) -> Child2 {
+    let mut child = Command::new(program)
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap_or_else(|e| panic!("cannot start {program}: {e}"));
+    let stdin = child.stdin.take().unwrap();
+    let stdout = BufReader::new(child.stdout.take().unwrap());
+    Child2 { _child: child, stdin, stdout }
+}
+
+fn ask(c: &mut Child2, cmd: &str, text: &str) -> serde_json::Value {
+    let hex: String = text.bytes().map(|b| format!("{b:02x}")).collect();
+    writeln!(c.stdin, "{cmd} {hex}").unwrap();
+    c.stdin.flush().unwrap();
+    let mut line = String::new();
+    c.stdout.read_line(&mut line).unwrap();
+    assert!(!line.is_empty(), "{cmd}: oracle child died");
+    serde_json::from_str(&line).unwrap_or_else(|e| panic!("bad oracle reply {line:?}: {e}"))
+}
+
+fn python() -> &'static Mutex<Child2> {
+    static P: OnceLock<Mutex<Child2>> = OnceLock::new();
+    P.get_or_init(|| Mutex::new(spawn("/usr/bin/python3", &["-c", PYTHON_SCRIPT])))
+}
+
+fn perl() -> &'static Mutex<Child2> {
+    static P: OnceLock<Mutex<Child2>> = OnceLock::new();
+    P.get_or_init(|| Mutex::new(spawn("perl", &["-e", PERL_SCRIPT])))
+}
+
+/// Paragraphs as the oracle reads them: key, value.
+type Paras = Vec<Vec<(String, String)>>;
+
+fn paras_of(v: &serde_json::Value) -> Result<Paras, String> {
+    if let Some(e) = v.get("error") {
+        return Err(e.to_string());
+    }
+    Ok(v["paras"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|p| {
+            p.as_array()
+                .unwrap()
+                .iter()
+                .map(|kv| {
+                    let k = kv[0].as_str().unwrap().to_string();
+                    let v = kv[1].as_str().unwrap_or("").to_string();
+                    (k, v)
+                })
+                .collect()
+        })
+        .collect())
+}
+
+fn pydebian(text: &str) -> Result<Paras, String> {
+    let mut c = python().lock().unwrap_or_else(|e| e.into_inner());
+    paras_of(&ask(&mut c, "P", text))
+}
+
+fn pydebian_dump(text: &str) -> String {
+    let mut c = python().lock().unwrap_or_else(|e| e.into_inner());
+    let v = ask(&mut c, "D", text);
+    v["dump"].as_str().unwrap_or("").to_string()
+}
+
+fn dpkg(text: &str) -> Result<Paras, String> {
+    let mut c = perl().lock().unwrap_or_else(|e| e.into_inner());
+    paras_of(&ask(&mut c, "P", text))
+}
+
+// ---------------------------------------------------------------------------
+// Normalisation
+// ---------------------------------------------------------------------------
+
+/// A value as a list of lines with the surrounding whitespace of each line
+/// removed: the common ground of the crate (which drops continuation
+/// indents), python-debian (which keeps continuation lines verbatim) and dpkg
+/// (which strips one indent character and trailing whitespace).
+fn norm(value: &str) -> Vec<String> {
+    value.split('\n').map(|l| l.trim().to_string()).collect()
+}
+
+/// dpkg unescapes a continuation line consisting of a single `.` into an
+/// empty line; undo that so dpkg's values compare with the others.
+fn norm_dpkg(value: &str) -> Vec<String> {
+    let mut lines = norm(value);
+    for l in lines.iter_mut().skip(1) {
+        if l.is_empty() {
+            *l = ".".to_string();
+        }
+    }
+    lines
+}
+
+fn crate_paras(doc: &Deb822) -> Paras {
+    doc.paragraphs().map(|p| p.items().collect()).collect()
+}
+
+fn keys_ci(p: &[(String, String)]) -> Vec<String> {
+    p.iter().map(|(k, _)| k.to_ascii_lowercase()).collect()
+}
+
+// ---------------------------------------------------------------------------
+// Generators
+// ---------------------------------------------------------------------------
+
+fn pick<T: Clone + Send + Sync + Debug + 'static>(tc: &hegel::TestCase, items: &[T]) -> T {
+    tc.draw(generators::sampled_from(items.to_vec()).print_as_debug())
+}
+
+const KEY_FIRST: &[char] = &[
+    'A', 'B', 'C', 'D', 'P', 'S', 'V', 'X', 'a', 'b', 'd', 'k', 'm', 'p', 's', 'x',
+];
+const KEY_REST: &[char] = &[
+    'a', 'b', 'c', 'd', 'e', 'r', 's', 't', 'A', 'B', 'D', 'S', '0', '1', '9', '-', '_', '.', '+',
+    '~',
+];
+const WORD_CHARS: &[char] = &[
+    'a', 'b', 'c', 'x', 'y', 'z', 'A', 'M', '0', '1', '9', '.', ',', ';', '(', ')', '<', '>', '=',
+    '|', '/', '@', '+', '-', '_', '~', ':', '#', '!', '"', '\'', 'é', 'ĳ',
+];
+
+#[hegel::composite]
+fn arb_key(tc: &hegel::TestCase) -> String {
+    let n = tc.draw(int!(0, 7));
+    let mut s = String::new();
+    s.push(pick(tc, KEY_FIRST));
+    for _ in 0..n {
+        s.push(pick(tc, KEY_REST));
+    }
+    // dpkg silently drops a field whose name ends in `-`.
+    if s.ends_with('-') {
+        s.push('x');
+    }
+    s
+}
+
+#[hegel::composite]
+fn arb_word(tc: &hegel::TestCase) -> String {
+    let n = tc.draw(int!(1, 6));
+    (0..n).map(|_| pick(tc, WORD_CHARS)).collect()
+}
+
+/// A line of value text without leading or trailing whitespace.
+#[hegel::composite]
+fn arb_line(tc: &hegel::TestCase, allow_empty: bool) -> String {
+    let n = tc.draw(int!(if allow_empty { 0 } else { 1 }, 3));
+    let mut words: Vec<String> = Vec::new();
+    for _ in 0..n {
+        words.push(tc.draw(arb_word()));
+    }
+    let sep = pick(tc, &[" ", "  ", " \t"]);
+    words.join(sep)
+}
+
+/// dpkg unescapes a continuation line of two or more dots (` ..` reads as
+/// `.`); keep such lines out of the generated documents.
+fn no_dot_run(mut line: String) -> String {
+    if line.len() > 1 && line.chars().all(|c| c == '.') {
+        line.insert(0, 'x');
+    }
+    line
+}
+
+#[hegel::composite]
+fn arb_hws(tc: &hegel::TestCase, allow_empty: bool) -> String {
+    let opts: &[&str] = if allow_empty {
+        &["", " ", "  ", "\t", " \t ", "    "]
+    } else {
+        &[" ", "  ", "\t", " \t ", "    "]
+    };
+    pick(tc, opts).to_string()
+}
+
+#[derive(Clone, Debug, Default)]
+struct Opts {
+    crlf: bool,
+    trailing_ws: bool,
+    comments: bool,
+    empty_first_line: bool,
+    no_final_newline: bool,
+    ws_separator: bool,
+}
+
+#[hegel::composite]
+fn arb_opts(tc: &hegel::TestCase) -> Opts {
+    Opts {
+        crlf: tc.draw(generators::booleans()),
+        trailing_ws: tc.draw(generators::booleans()),
+        comments: tc.draw(generators::booleans()),
+        empty_first_line: tc.draw(generators::booleans()),
+        no_final_newline: tc.draw(generators::booleans()),
+        ws_separator: tc.draw(generators::booleans()),
+    }
+}
+
+#[derive(Clone, Debug)]
+struct ContLine {
+    comment_before: Option<String>,
+    indent: String,
+    text: String,
+    trail: String,
+}
+
+#[derive(Clone, Debug)]
+struct GenEntry {
+    comments_before: Vec<String>,
+    key: String,
+    post_colon: String,
+    first: String,
+    first_trail: String,
+    cont: Vec<ContLine>,
+}
+
+impl GenEntry {
+    fn value_lines(&self) -> Vec<String> {
+        let mut v = vec![self.first.clone()];
+        v.extend(self.cont.iter().map(|c| c.text.clone()));
+        v
+    }
+    fn render(&self, out: &mut Vec<String>) {
+        for c in &self.comments_before {
+            out.push(c.clone());
+        }
+        out.push(format!(
+            "{}:{}{}{}",
+            self.key, self.post_colon, self.first, self.first_trail
+        ));
+        for c in &self.cont {
+            if let Some(cm) = &c.comment_before {
+                out.push(cm.clone());
+            }
+            out.push(format!("{}{}{}", c.indent, c.text, c.trail));
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+struct GenPara {
+    entries: Vec<GenEntry>,
+}
+
+#[derive(Clone, Debug)]
+struct GenDoc {
+    leading: Vec<String>,
+    paras: Vec<GenPara>,
+    /// Separator lines between paragraphs (paras.len() - 1 of them).
+    seps: Vec<Vec<String>>,
+    trailing_newline: bool,
+    crlf: bool,
+    opts: Opts,
+}
+
+impl GenDoc {
+    fn text(&self) -> String {
+        let mut lines: Vec<String> = self.leading.clone();
+        for (i, p) in self.paras.iter().enumerate() {
+            if i > 0 {
+                lines.extend(self.seps[i - 1].iter().cloned());
+            }
+            for e in &p.entries {
+                e.render(&mut lines);
+            }
+        }
+        let nl = if self.crlf { "\r\n" } else { "\n" };
+        let mut s = lines.join(nl);
+        if self.trailing_newline && !lines.is_empty() {
+            s.push_str(nl);
+        }
+        s
+    }
+    /// What every reader should see: paragraphs of (key, value lines).
+    fn model(&self) -> Vec<Vec<(String, Vec<String>)>> {
+        self.paras
+            .iter()
+            .map(|p| {
+                p.entries
+                    .iter()
+                    .map(|e| (e.key.clone(), e.value_lines()))
+                    .collect()
+            })
+            .collect()
+    }
+}
+
+#[hegel::composite]
+fn arb_comment(tc: &hegel::TestCase) -> String {
+    let body = tc.draw(arb_line(true));
+    let sep = pick(tc, &["", " "]);
+    format!("#{sep}{body}")
+}
+
+#[hegel::composite]
+fn arb_entry(tc: &hegel::TestCase, key: String, opts: Opts) -> GenEntry {
+    let n_comments = if opts.comments { tc.draw(int!(0, 1)) } else { 0 };
+    let mut comments_before = Vec::new();
+    for _ in 0..n_comments {
+        comments_before.push(tc.draw(arb_comment()));
+    }
+    let post_colon = tc.draw(arb_hws(true));
+    let first = if opts.empty_first_line && tc.draw(generators::booleans()) {
+        String::new()
+    } else {
+        tc.draw(arb_line(true))
+    };
+    let first_trail = if opts.trailing_ws {
+        tc.draw(arb_hws(true))
+    } else {
+        String::new()
+    };
+    let n_cont = tc.draw(int!(0, 3));
+    let mut cont = Vec::new();
+    for _ in 0..n_cont {
+        let comment_before = if opts.comments && tc.draw(generators::booleans()) {
+            Some(tc.draw(arb_comment()))
+        } else {
+            None
+        };
+        let dot = tc.draw(int!(0, 5)) == 0;
+        let indent = if dot {
+            " ".to_string()
+        } else {
+            tc.draw(arb_hws(false))
+        };
+        let text = if dot { ".".to_string() } else { no_dot_run(tc.draw(arb_line(false))) };
+        let trail = if opts.trailing_ws {
+            tc.draw(arb_hws(true))
+        } else {
+            String::new()
+        };
+        cont.push(ContLine { comment_before, indent, text, trail });
+    }
+    let first = if first.is_empty() && !cont.is_empty() && !opts.empty_first_line {
+        "x".to_string()
+    } else {
+        first
+    };
+    GenEntry { comments_before, key, post_colon, first, first_trail, cont }
+}
+
+/// Distinct keys (case-insensitively).
+#[hegel::composite]
+fn arb_keys(tc: &hegel::TestCase, n: usize) -> Vec<String> {
+    let mut seen: BTreeSet<String> = BTreeSet::new();
+    let mut keys = Vec::new();
+    for i in 0..n {
+        let mut k = tc.draw(arb_key());
+        if !seen.insert(k.to_ascii_lowercase()) {
+            k = format!("{k}{i}");
+            if !seen.insert(k.to_ascii_lowercase()) {
+                continue;
+            }
+        }
+        keys.push(k);
+    }
+    keys
+}
+
+#[hegel::composite]
+fn arb_para(tc: &hegel::TestCase, opts: Opts) -> GenPara {
+    let n = tc.draw(int!(1, 4)) as usize;
+    let keys = tc.draw(arb_keys(n).print_as_debug());
+    let mut entries = Vec::new();
+    for k in keys {
+        entries.push(tc.draw(arb_entry(k, opts.clone()).print_as_debug()));
+    }
+    GenPara { entries }
+}
+
+#[hegel::composite]
+fn arb_doc(tc: &hegel::TestCase, opts: Opts) -> GenDoc {
+    let n = tc.draw(int!(0, 3));
+    let mut paras = Vec::new();
+    for _ in 0..n {
+        paras.push(tc.draw(arb_para(opts.clone()).print_as_debug()));
+    }
+    let mut seps = Vec::new();
+    for _ in 1..paras.len().max(1) {
+        let k = tc.draw(int!(1, 2));
+        let mut sep = Vec::new();
+        for _ in 0..k {
+            let line = if opts.ws_separator && tc.draw(int!(0, 3)) == 0 {
+                tc.draw(arb_hws(false))
+            } else {
+                String::new()
+            };
+            sep.push(line);
+        }
+        if opts.comments && tc.draw(int!(0, 3)) == 0 {
+            sep.push(tc.draw(arb_comment()));
+        }
+        seps.push(sep);
+    }
+    let mut leading = Vec::new();
+    if opts.comments && tc.draw(int!(0, 3)) == 0 {
+        leading.push(tc.draw(arb_comment()));
+    }
+    if tc.draw(int!(0, 5)) == 0 {
+        leading.push(String::new());
+    }
+    let trailing_newline = !(opts.no_final_newline && tc.draw(generators::booleans()));
+    GenDoc { leading, paras, seps, trailing_newline, crlf: opts.crlf, opts }
+}
+
+/// A document with default options (LF, no trailing whitespace, no comments).
+#[hegel::composite]
+fn arb_plain_doc(tc: &hegel::TestCase) -> GenDoc {
+    tc.draw(arb_doc(Opts::default()).print_as_debug())
+}
+
+/// Arbitrary text: a generated document with a few random mutations.
+#[hegel::composite]
+fn arb_text(tc: &hegel::TestCase) -> String {
+    let opts = tc.draw(arb_opts().print_as_debug());
+    let doc = tc.draw(arb_doc(opts).print_as_debug());
+    let mut chars: Vec<char> = doc.text().chars().collect();
+    let n = tc.draw(int!(0, 4));
+    for _ in 0..n {
+        let c = pick(tc, &[':', '#', '\n', '\r', ' ', '\t', 'x', '-', '\u{a0}']);
+        let pos = tc.draw(int!(0, chars.len() as i64)) as usize;
+        if tc.draw(generators::booleans()) || pos == chars.len() {
+            chars.insert(pos, c);
+        } else {
+            chars[pos] = c;
+        }
+    }
+    chars.into_iter().collect()
+}
+
+// ---------------------------------------------------------------------------
+// Known-bug detectors (the general properties skip exactly these inputs; each
+// bug has its own pinned test below)
+// ---------------------------------------------------------------------------
+
+/// deb822-lossless/1: trailing whitespace on a value line is part of `value()`.
+fn hits_trailing_ws_bug(doc: &GenDoc) -> bool {
+    doc.paras.iter().flat_map(|p| &p.entries).any(|e| {
+        (!e.first.is_empty() && !e.first_trail.is_empty())
+            || e.cont.iter().any(|c| !c.trail.is_empty())
+    })
+}
+
+/// deb822-lossless/2: an empty first line (`Key:\n value`) is dropped from
+/// `value()`, shifting the continuation lines up.
+fn hits_empty_first_line_bug(doc: &GenDoc) -> bool {
+    doc.paras
+        .iter()
+        .flat_map(|p| &p.entries)
+        .any(|e| e.first.is_empty() && !e.cont.is_empty())
+}
+
+/// deb822-lossless/3: `\r` is a newline of its own, so CRLF files fall apart
+/// (one paragraph per line, continuation lines orphaned).
+fn hits_crlf_bug(doc: &GenDoc) -> bool {
+    doc.crlf && !doc.paras.is_empty()
+}
+
+/// deb822-lossless/4: a continuation line whose text starts with `#` is
+/// lexed as a comment and the field is rejected as an empty continuation.
+fn hits_indented_hash_bug(doc: &GenDoc) -> bool {
+    doc.paras
+        .iter()
+        .flat_map(|p| &p.entries)
+        .any(|e| e.cont.iter().any(|c| c.text.starts_with('#')))
+}
+
+/// Whitespace-only separator lines are legal for dpkg and python-debian but
+/// rejected by the strict parser (Policy lets parsers choose).
+fn has_ws_separator(doc: &GenDoc) -> bool {
+    doc.seps.iter().flatten().any(|l| !l.is_empty() && l.trim().is_empty())
+}
+
+/// deb822-lossless/6: `wrap_and_sort` turns a comment line inside a
+/// paragraph into value text (`A:\n#c` -> `A: #c`, `A: x\n#c` -> `A: x\n #c`).
+fn hits_wrap_comment_bug(doc: &GenDoc) -> bool {
+    doc.paras.iter().any(|p| {
+        p.entries.iter().skip(1).any(|e| !e.comments_before.is_empty())
+            || p.entries.iter().any(|e| e.cont.iter().any(|c| c.comment_before.is_some()))
+    })
+}
+
+/// deb822-lossless/4 again: with `immediate_empty_line`, `wrap_and_sort` moves
+/// a first line starting with `#` onto a continuation line, where it lexes as
+/// a comment.
+fn hits_immediate_hash_bug(doc: &GenDoc) -> bool {
+    doc.paras
+        .iter()
+        .flat_map(|p| &p.entries)
+        .any(|e| e.first.starts_with('#') && !e.cont.is_empty())
+}
+
+/// deb822-lossless/7: `convert_index(0)` is root child 0 whatever it is, so
+/// `remove_paragraph(0)` / `move_paragraph` act on a leading blank line or a
+/// comment instead of the paragraph.
+fn hits_index_bug(doc: &Deb822, edit: &Edit) -> bool {
+    use rowan::ast::AstNode;
+    let kinds: Vec<(deb822_lossless::SyntaxKind, String)> = doc
+        .syntax()
+        .children_with_tokens()
+        .map(|c| (c.kind(), c.to_string()))
+        .collect();
+    let leading_non_paragraph = kinds
+        .first()
+        .map(|(k, _)| *k != deb822_lossless::SyntaxKind::PARAGRAPH)
+        .unwrap_or(false);
+    // Paragraphs separated by exactly one blank line and nothing else: the
+    // only layout in which `move_paragraph`'s index arithmetic holds
+    // (comments and repeated blank lines are root children it miscounts).
+    let canonical_layout = kinds.iter().enumerate().all(|(i, (k, text))| {
+        if i % 2 == 0 {
+            *k == deb822_lossless::SyntaxKind::PARAGRAPH
+        } else {
+            *k == deb822_lossless::SyntaxKind::EMPTY_LINE && text == "\n"
+        }
+    });
+    match edit {
+        Edit::RemoveParagraph { index: 0 } => leading_non_paragraph,
+        Edit::MoveParagraph { .. } => {
+            // deb822-lossless/11: with three or more paragraphs the move eats
+            // the blank line the next paragraph needs.
+            !canonical_layout || doc.paragraphs().count() != 2
+        }
+        _ => false,
+    }
+}
+
+/// deb822-lossless/8: rewriting a field whose first line is empty (`Key:` or
+/// `Key: ` followed by a newline) breaks the line structure: `set` writes the
+/// new value on the next line unindented, `change_field_indent` adds a blank
+/// line that splits the paragraph.
+fn hits_set_bare_colon_bug(doc: &Deb822, edit: &Edit) -> bool {
+    match edit {
+        Edit::Set { para, key, .. }
+        | Edit::SetMultiline { para, key, .. }
+        | Edit::ChangeIndent { para, key, .. } => nth_para(doc, *para)
+            .get_entry(key)
+            .map(|e| {
+                let text = e.to_string();
+                let first = text.split('\n').next().unwrap_or("");
+                let after_colon = first.split_once(':').map(|(_, v)| v).unwrap_or("");
+                after_colon.trim().is_empty()
+            })
+            .unwrap_or(false),
+        _ => false,
+    }
+}
+
+/// deb822-lossless/9: edits after a last line without a trailing newline
+/// glue lines together (`A: 1` + insert -> `A: 1B: 2`; swapping or moving the
+/// last paragraph merges it with its new neighbour).
+fn hits_missing_newline_bug(doc: &Deb822, edit: &Edit) -> bool {
+    let text = doc.to_string();
+    if text.is_empty() || text.ends_with('\n') {
+        return false;
+    }
+    matches!(
+        edit,
+        Edit::Insert { .. }
+            | Edit::Set { .. }
+            | Edit::SetMultiline { .. }
+            | Edit::AddParagraph { .. }
+            | Edit::InsertParagraph { .. }
+            | Edit::SwapParagraphs { .. }
+            | Edit::MoveParagraph { .. }
+    )
+}
+
+/// deb822-lossless/10: `Deb822::wrap_and_sort` flattens the comment lines
+/// before a paragraph into bare root tokens; a second pass keeps the COMMENT
+/// tokens and drops their newlines (`# c\nA: 1\n` -> `# cA: 1\n`), and the
+/// paragraph operations, which count node children, insert at the wrong place.
+fn hits_flattened_comment_bug(doc: &Deb822, edit: &Edit) -> bool {
+    use rowan::ast::AstNode;
+    matches!(
+        edit,
+        Edit::WrapAndSortDocument { .. }
+            | Edit::AddParagraph { .. }
+            | Edit::InsertParagraph { .. }
+            | Edit::RemoveParagraph { .. }
+            | Edit::MoveParagraph { .. }
+            | Edit::SwapParagraphs { .. }
+    ) && doc
+        .syntax()
+        .children_with_tokens()
+        .any(|c| c.as_token().is_some() && c.kind() == deb822_lossless::SyntaxKind::COMMENT)
+}
+
+fn hits_any_parse_bug(doc: &GenDoc) -> bool {
+    hits_trailing_ws_bug(doc)
+        || hits_empty_first_line_bug(doc)
+        || hits_crlf_bug(doc)
+        || hits_indented_hash_bug(doc)
+}
+
+fn skip_for_oracles(doc: &GenDoc) -> bool {
+    hits_any_parse_bug(doc) || has_ws_separator(doc)
+}
