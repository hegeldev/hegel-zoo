+#[hegel::test]
+fn the_tree_is_lossless_for_any_text(tc: hegel::TestCase) {
+    let text = tc.draw(arb_text());
+    let parse = Deb822::parse(&text);
+    let tree = parse.tree();
+    assert_eq!(tree.to_string(), text, "relaxed tree text");
+    let strict = Deb822::from_str(&text);
+    assert_eq!(
+        strict.is_ok(),
+        parse.errors().is_empty(),
+        "strict {:?} vs errors {:?} for {text:?}",
+        strict.as_ref().map(|_| ()),
+        parse.errors()
+    );
+    let (relaxed, errors) = Deb822::from_str_relaxed(&text);
+    assert_eq!(relaxed.to_string(), text);
+    assert_eq!(errors, parse.errors().to_vec());
+    assert_eq!(parse.positioned_errors().len(), parse.errors().len());
+    for e in parse.positioned_errors() {
+        assert!(usize::from(e.range.end()) <= text.len(), "error range {e:?} outside {text:?}");
+    }
+    // Accessors never panic on any tree.
+    for p in tree.paragraphs() {
+        let _ = p.text_range();
+        let _ = p.line_col();
+        for e in p.entries() {
+            let _ = e.key();
+            let _ = e.value();
+            let _ = e.value_with_comments();
+            let _ = e.key_range();
+            let _ = e.colon_range();
+            let _ = e.value_range();
+            let _ = e.value_line_ranges();
+            let _ = e.value_token_range();
+            let _ = e.line_col();
+        }
+        for k in p.keys() {
+            let _ = p.get(&k);
+            let _ = p.get_with_comments(&k);
+            let _ = p.get_multiline(&k);
+            let _ = p.get_entry(&k);
+        }
+    }
+    let lines = text.lines().count();
+    for l in 0..=lines {
+        let _ = tree.paragraph_at_line(l);
+        let _ = tree.entry_at_line_col(l, 0);
+    }
+    for off in 0..=text.len() as u32 {
+        let _ = tree.paragraph_at_position(off.into());
+    }
+    // Paragraph texts concatenate to the document text in order.
+    let joined: String = tree.paragraphs().map(|p| p.to_string()).collect();
+    for p in tree.paragraphs() {
+        assert!(text.contains(&p.to_string()));
+    }
+    assert!(joined.len() <= text.len());
+}
