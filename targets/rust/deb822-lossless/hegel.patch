+/// deb822-lossless/7
+#[test]
+fn remove_paragraph_removes_the_paragraph_after_a_blank_line() {
+    let mut d = Deb822::from_str("\nA: 1\n").unwrap();
+    d.remove_paragraph(0);
+    assert_eq!(d.paragraphs().count(), 0, "{:?}", d.to_string());
+    let mut d = Deb822::from_str("A: 1\n\n# about B\nB: 2\n").unwrap();
+    d.move_paragraph(0, 1);
+    let keys: Vec<String> = d.paragraphs().map(|p| p.keys().next().unwrap()).collect();
+    assert_eq!(keys, ["B", "A"], "{:?}", d.to_string());
+    let mut d = Deb822::from_str("A: 1\n\n\nB: 2\n").unwrap();
+    d.move_paragraph(0, 1);
+    let text = d.to_string();
+    let keys: Vec<String> = Deb822::from_str(&text).unwrap().paragraphs().map(|p| p.keys().next().unwrap()).collect();
+    assert_eq!(keys, ["B", "A"], "{text:?}");
+}
