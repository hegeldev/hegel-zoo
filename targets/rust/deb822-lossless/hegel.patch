+/// deb822-lossless/10
+#[test]
+fn wrap_and_sort_twice_keeps_the_comment_lines() {
+    let wrap = |p: &Paragraph| p.wrap_and_sort(Indentation::Spaces(1), false, None, None, None);
+    let d = Deb822::from_str("# c\nA: 1\n").unwrap();
+    let twice = d.wrap_and_sort(None, Some(&wrap)).wrap_and_sort(None, Some(&wrap));
+    let text = twice.to_string();
+    assert_eq!(text, "# c\nA: 1\n");
+    let mut once = Deb822::from_str("# c\nA: 1\n").unwrap().wrap_and_sort(None, Some(&wrap));
+    let mut p = once.add_paragraph();
+    p.set("B", "2");
+    let keys: Vec<String> = once.paragraphs().map(|p| p.keys().next().unwrap()).collect();
+    assert_eq!(keys, ["A", "B"], "{:?}", once.to_string());
+}
