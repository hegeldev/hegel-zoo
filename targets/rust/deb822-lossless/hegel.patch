+#[hegel::test]
+fn wrap_and_sort_is_canonical(tc: hegel::TestCase) {
+    let mut opts = tc.draw(arb_opts().print_as_debug());
+    opts.crlf = false;
+    let gen = tc.draw(arb_doc(opts).print_as_debug());
+    let text = gen.text();
+    let doc = match Deb822::from_str(&text) {
+        Ok(d) => d,
+        Err(_) => return,
+    };
+    if hits_wrap_comment_bug(&gen) {
+        return;
+    }
+    let indent = tc.draw(int!(1, 4)) as u32;
+    let immediate = tc.draw(generators::booleans());
+    if immediate && hits_immediate_hash_bug(&gen) {
+        return;
+    }
+    let max_len = if tc.draw(generators::booleans()) { Some(tc.draw(int!(10, 80)) as usize) } else { None };
+    let cmp = |a: &Entry, b: &Entry| a.key().cmp(&b.key());
+    let wrap = |p: &Paragraph| p.wrap_and_sort(Indentation::Spaces(indent), immediate, max_len, Some(&cmp), None);
+    let once = doc.wrap_and_sort(None, Some(&wrap));
+    let once_text = once.to_string();
+    let reparsed = Deb822::from_str(&once_text)
+        .unwrap_or_else(|e| panic!("wrap_and_sort output does not parse: {e}\nfrom {text:?}\nto {once_text:?}"));
+    let mut model = gen.model();
+    for p in model.iter_mut() {
+        sort_model_para(p);
+    }
+    let normalise = |ps: Paras| -> Vec<Vec<(String, Vec<String>)>> {
+        ps.iter().map(|p| p.iter().map(|(k, v)| (k.clone(), norm(v))).collect()).collect()
+    };
+    if !skip_for_oracles(&gen) {
+        assert_eq!(normalise(crate_paras(&once)), model, "wrap_and_sort of {text:?} -> {once_text:?}");
+        assert_eq!(normalise(crate_paras(&reparsed)), model, "re-parse of {once_text:?}");
+    }
+    let twice = reparsed.wrap_and_sort(None, Some(&wrap));
+    assert_eq!(twice.to_string(), once_text, "wrap_and_sort is not idempotent on {text:?}");
+    // Directly on its own tree too (with comments this hits deb822-lossless/10).
+    if !text.lines().any(|l| l.starts_with('#')) {
+        let again = once.wrap_and_sort(None, Some(&wrap));
+        assert_eq!(again.to_string(), once_text, "wrap_and_sort on its own output of {text:?}");
+    }
+    // Comments survive.
+    for line in text.lines() {
+        if line.starts_with('#') {
+            assert!(once_text.contains(line), "comment {line:?} lost by wrap_and_sort of {text:?}");
+        }
+    }
+}
