+#[hegel::test]
+fn built_documents_are_read_back(tc: hegel::TestCase) {
+    let n = tc.draw(int!(0, 3));
+    let mut fields_per_para = Vec::new();
+    for _ in 0..n {
+        fields_per_para.push(tc.draw(arb_fields().print_as_debug()));
+    }
+    let doc: Deb822 = fields_per_para
+        .iter()
+        .map(|fields| {
+            let v: Vec<(String, String)> =
+                fields.iter().map(|(k, l)| (k.clone(), l.join("\n"))).collect();
+            Paragraph::from(v)
+        })
+        .collect();
+    let model: Model = fields_per_para.clone();
+    check_model("builder", &doc, &model, &[]);
+    // The `&str` builder and `FromIterator<(String, String)>` agree with `From<Vec>`.
+    for fields in &fields_per_para {
+        let v: Vec<(&str, &str)> = Vec::new();
+        let _ = Paragraph::from(v);
+        let joined: Vec<(String, String)> =
+            fields.iter().map(|(k, l)| (k.clone(), l.join("\n"))).collect();
+        let a = Paragraph::from(joined.clone());
+        let b: Paragraph = joined.iter().map(|(k, v)| (k.as_str(), v.as_str())).collect();
+        assert_eq!(a.to_string(), b.to_string());
+    }
+}
