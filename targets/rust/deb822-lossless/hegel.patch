+fn wrap_and_sort_keeps_comments_out_of_the_values() {
+    let wrap = |p: &Paragraph| p.wrap_and_sort(Indentation::Spaces(1), false, None, None, None);
+    let d = Deb822::from_str("A: x\n#c\nB: y\n").unwrap();
+    let w = d.wrap_and_sort(None, Some(&wrap)).to_string();
+    let re = Deb822::from_str(&w).unwrap_or_else(|e| panic!("{w:?}: {e}"));
+    assert_eq!(re.paragraphs().next().unwrap().get("A").as_deref(), Some("x"), "{w:?}");
+    let d = Deb822::from_str("A:\n#c\nB: y\n").unwrap();
+    let w = d.wrap_and_sort(None, Some(&wrap)).to_string();
+    let re = Deb822::from_str(&w).unwrap_or_else(|e| panic!("{w:?}: {e}"));
+    assert_eq!(re.paragraphs().next().unwrap().get("A").as_deref(), Some(""), "{w:?}");
+}
