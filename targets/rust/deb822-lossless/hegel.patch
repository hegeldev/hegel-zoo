+#[hegel::test]
+fn strict_documents_are_accepted_by_the_oracles(tc: hegel::TestCase) {
+    // Whatever the strict parser accepts, dpkg reads without complaint.
+    let text = tc.draw(arb_text());
+    if text.contains('\r') {
+        return;
+    }
+    let doc = match Deb822::from_str(&text) {
+        Ok(d) => d,
+        Err(_) => return,
+    };
+    // dpkg rejects duplicate fields; the crate (like python-debian) reads them.
+    for p in doc.paragraphs() {
+        let keys: Vec<String> = p.keys().map(|k| k.to_ascii_lowercase()).collect();
+        let set: BTreeSet<&String> = keys.iter().collect();
+        if set.len() != keys.len() {
+            return;
+        }
+    }
+    if let Err(e) = dpkg(&text) {
+        panic!("strict parse accepts {text:?} but dpkg says: {e}");
+    }
+}
