+#[hegel::test]
+fn lookups_are_case_insensitive_first_matches(tc: hegel::TestCase) {
+    let doc = tc.draw(arb_plain_doc().print_as_debug());
+    if hits_indented_hash_bug(&doc) {
+        return;
+    }
+    let text = doc.text();
+    let tree = Deb822::from_str(&text).unwrap();
+    for p in tree.paragraphs() {
+        let items: Vec<(String, String)> = p.items().collect();
+        let keys: Vec<String> = p.keys().collect();
+        assert_eq!(keys, items.iter().map(|(k, _)| k.clone()).collect::<Vec<_>>());
+        for (k, v) in &items {
+            for probe in [k.clone(), k.to_ascii_uppercase(), k.to_ascii_lowercase()] {
+                let expected = items
+                    .iter()
+                    .find(|(kk, _)| kk.eq_ignore_ascii_case(&probe))
+                    .map(|(_, v)| v.clone());
+                assert_eq!(p.get(&probe), expected, "get({probe:?}) in {text:?}");
+                assert!(p.contains_key(&probe));
+                assert_eq!(p.get_entry(&probe).map(|e| e.value()), expected);
+                assert_eq!(
+                    p.get_all(&probe).collect::<Vec<_>>(),
+                    items
+                        .iter()
+                        .filter(|(kk, _)| kk.eq_ignore_ascii_case(&probe))
+                        .map(|(_, v)| v.clone())
+                        .collect::<Vec<_>>()
+                );
+            }
+            let _ = v;
+        }
+        let missing = format!("{}zz", keys.first().cloned().unwrap_or_default());
+        assert_eq!(p.get(&missing), None);
+        assert!(!p.contains_key(&missing));
+    }
+    // `Paragraph::from_str` is the first-paragraph view.
+    if let Some(first) = tree.paragraphs().next() {
+        let single = Paragraph::from_str(&text).unwrap();
+        assert_eq!(single.items().collect::<Vec<_>>(), first.items().collect::<Vec<_>>());
+    }
+}
