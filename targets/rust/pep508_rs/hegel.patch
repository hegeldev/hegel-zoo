+/// The `X` of the pep508_rs/9 pin: a variable the diagram orders after `os_name`, or not.
+const CANONICITY_X: &[&str] = &[
+    "platform_machine == 'x86_64'",
+    "extra == 'dev'",
+    "sys_platform != 'win32'",
+    "python_full_version < '3.9'",
+    "implementation_name == 'pypy'",
+];
+const CANONICITY_A_VALUES: &[&str] = &["lin", "nt", "posix"];
+const CANONICITY_B_VALUES: &[&str] = &["linux", "nt", "java"];
+
+/// Pinned (pep508_rs/9): `MarkerTree` is documented as canonical ("any two functionally
+/// equivalent markers will compare equally"), but `X and ((X and A) or B)` — `A`, `B`
+/// comparisons on one string key, `X` a variable the diagram orders after it — leaves adjacent
+/// edges with the same child unmerged, so the tree differs from the one its own `Display`
+/// parses to although the two are equivalent.
+#[hegel::test]
+fn marker_trees_are_canonical(tc: TestCase) {
+    let text = "platform_machine == 'x' and ((platform_machine == 'x' and os_name != 'lin') or os_name == 'linux')";
+    let tree = MarkerTree::from_str(text).unwrap();
+    let shown = tree.try_to_string().unwrap();
+    let again = MarkerTree::from_str(&shown).unwrap();
+    assert!(equiv(&tree, &again));
+    assert_eq!(again, tree, "{text:?} vs its Display {shown:?}");
+    let (x, a_op, a_value, b_value) = tc.draw(hegel::tuples!(
+        generators::sampled_from(CANONICITY_X),
+        generators::sampled_from(EQUALITY_OPS),
+        generators::sampled_from(CANONICITY_A_VALUES),
+        generators::sampled_from(CANONICITY_B_VALUES)
+    ));
+    let a = format!("os_name {a_op} '{a_value}'");
+    let b = format!("os_name == '{b_value}'");
+    let text = format!("{x} and (({x} and {a}) or {b})");
+    let tree = MarkerTree::from_str(&text).unwrap();
+    let Some(shown) = tree.try_to_string() else { tc.reject() };
+    let again = MarkerTree::from_str(&shown).unwrap();
+    assert!(equiv(&tree, &again), "{text:?} vs {shown:?}");
+    assert_eq!(again, tree, "{text:?} vs its Display {shown:?}");
+}
