+/// The literals `platform_release` is compared with in the pep508_rs/1 pin.
+const RELEASE_LITERALS: &[&str] = &["6", "6.5", "6.12", "6.12.93", "10", "22", "5.15", "24.1.0", "22.6.0"];
+
+/// Pinned (pep508_rs/1): PEP 508 — "the <version_cmp> operators use the PEP 440 version
+/// comparison rules when those are defined (that is when both sides have a valid version
+/// specifier)" — so `platform_release < '6'` is false for release `22.6.0`; the crate compares
+/// string-keyed markers lexicographically (`"22.6.0" < "6"`).
+#[hegel::test]
+fn string_markers_compare_versions_like_pep_440(tc: TestCase) {
+    let env = env_with("22.6.0", "3.12", "3.12.3");
+    let m = MarkerTree::from_str("platform_release < '6'").unwrap();
+    assert_eq!(py_marker("platform_release < '6'", &env, None), Ok(Some(false)));
+    assert!(!rs_marker(&m, &env, None), "platform_release < '6' with release 22.6.0");
+    let (release, op, value) = tc.draw(hegel::tuples!(
+        generators::sampled_from(RELEASES),
+        generators::sampled_from(ORDER_OPS),
+        generators::sampled_from(RELEASE_LITERALS)
+    ));
+    let text = format!("platform_release {op} '{value}'");
+    let env = env_with(release, "3.12", "3.12.3");
+    if let Ok(Some(expected)) = py_marker(&text, &env, None) {
+        let m = MarkerTree::from_str(&text).unwrap();
+        assert_eq!(rs_marker(&m, &env, None), expected, "{text:?} with release {release}");
+    }
+}
