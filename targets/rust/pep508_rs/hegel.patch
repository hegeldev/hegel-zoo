+/// Pinned (pep508_rs/2): an unsatisfiable marker displays as `python_version < '0'`, its own
+/// canonical spelling of `false`, but that text does not parse back to an unsatisfiable tree.
+#[test]
+fn false_markers_round_trip_through_display() {
+    let tree = MarkerTree::from_str("python_version < '3' and python_version >= '3'").unwrap();
+    assert!(tree.is_false(), "the conjunction should be recognised as false");
+    let shown = tree.try_to_string().unwrap();
