+/// Pinned (pep508_rs/5): `MarkerTree` is documented as canonical ("any two functionally
+/// equivalent markers will compare equally"), but the deprecated spellings (`os.name`,
+/// `sys.platform`, `platform.version`, `platform.machine`, `platform.python_implementation`,
+/// `python_implementation`) make distinct trees from their current spellings — and the
+/// crate's own `Display` of such a tree re-parses to a tree that is not equal to it.
+#[hegel::test]
+fn deprecated_marker_spellings_are_canonical(tc: TestCase) {
+    let old = MarkerTree::from_str("os.name == 'posix'").unwrap();
+    let new = MarkerTree::from_str("os_name == 'posix'").unwrap();
+    assert_eq!(old.try_to_string(), new.try_to_string());
+    assert_eq!(old, new, "os.name vs os_name");
+    let ((dep, current), op, value) = tc.draw(hegel::tuples!(
+        generators::sampled_from(DEPRECATED_SPELLINGS),
+        generators::sampled_from(STRING_OPS),
+        generators::sampled_from(WORDS)
+    ));
+    let a = MarkerTree::from_str(&format!("{dep} {op} '{value}'")).unwrap();
+    let b = MarkerTree::from_str(&format!("{current} {op} '{value}'")).unwrap();
+    assert_eq!(a, b, "{dep} vs {current}");
+    let shown = a.try_to_string().unwrap();
+    assert_eq!(MarkerTree::from_str(&shown).unwrap(), a, "Display {shown:?} of {dep} re-parses differently");
+}
