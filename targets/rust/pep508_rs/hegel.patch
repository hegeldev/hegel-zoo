+/// Each deprecated key spelling with its current one.
+const DEPRECATED_SPELLINGS: &[(&str, &str)] = &[
+    ("os.name", "os_name"),
+    ("sys.platform", "sys_platform"),
+    ("platform.version", "platform_version"),
