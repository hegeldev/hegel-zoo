+/// What an edit puts into the text.
+const JUNK: &[&str] = &[
+    " ", ",", ";", "[", "]", "(", ")", "@", "'", "\"", "=", "<", ">", "~", "!", ".", "-", "_",
+    "*", "and", "or", "in", "not", "x", "1", "python_version", "extra",
+];
+
+/// An edit of the text at a character position (taken modulo the live length, the end
+/// included): a deletion first, an insertion, a replacement.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Edit {
+    Delete { at: u32 },
+    Insert { at: u32, junk: &'static str },
+    Replace { at: u32, junk: &'static str },
+}
+
+impl Edit {
+    /// Applies the edit; a deletion or replacement at the end is a no-op.
+    fn apply(&self, text: &mut String) {
+        let at = match self {
+            Edit::Delete { at } | Edit::Insert { at, .. } | Edit::Replace { at, .. } => *at as usize,
+        };
+        let pos = at % (text.chars().count() + 1);
+        let byte = text.char_indices().nth(pos).map(|(i, _)| i).unwrap_or(text.len());
+        let end = text[byte..].chars().next().map_or(byte, |c| byte + c.len_utf8());
+        match self {
+            Edit::Insert { junk, .. } => text.insert_str(byte, junk),
+            _ if end == byte => {}
+            Edit::Delete { .. } => text.replace_range(byte..end, ""),
+            Edit::Replace { junk, .. } => text.replace_range(byte..end, junk),
+        }
+    }
+}
+
+fn edit() -> impl PrintableGenerator<Edit> + Send + Sync + 'static {
+    let at = || ints(0, 199);
+    hegel::one_of!(
+        at().map(|at| Edit::Delete { at }),
+        hegel::tuples!(at(), generators::sampled_from(JUNK)).map(|(at, junk)| Edit::Insert { at, junk }),
+        hegel::tuples!(at(), generators::sampled_from(JUNK)).map(|(at, junk)| Edit::Replace { at, junk }),
+    )
+}
+
+/// Syntax agreement on near-miss texts: one or two edits of a valid requirement are accepted
+/// by both or rejected by both.
+#[hegel::test]
+fn requirement_syntax_agrees_with_packaging(tc: TestCase) {
+    let (case, edits) = tc.draw(hegel::tuples!(
+        requirement(),
+        generators::vecs(edit()).min_size(1).max_size(2)
+    ));
+    let mut text = case.text();
+    for edit in &edits {
+        edit.apply(&mut text);
+    }
+    // Shapes where the reference is knowingly lenient or the crate knowingly stricter are
+    // outside the spec grammar; only compare texts the spec grammar clearly decides.
+    let theirs = py_requirement(&text);
+    let Ok(ours) = std::panic::catch_unwind(|| Requirement::<VerbatimUrl>::from_str(&text)) else {
+        // (an extra ending in `-`, `_` or `.` panics the parser: pinned as pep508_rs/7)
+        assert!(text.contains('['), "{text:?}: Requirement::from_str panicked");
+        return;
+    };
+    match (&ours, &theirs) {
+        (Ok(r), None) => {
+            // The crate accepts something packaging rejects: report unless it is a URL
+            // requirement (packaging treats any non-space run as a URL and is stricter
+            // about what follows).
+            if !matches!(r.version_or_url, Some(VersionOrUrl::Url(_))) && r.marker.is_true() {
+                panic!("{text:?}: pep508_rs accepts ({r}), packaging rejects");
+            }
+        }
+        (Err(e), Some(py)) => {
+            // packaging accepts a trailing comma, arbitrary URL-ish text and lenient
+            // markers with bogus comparisons; the crate's marker warnings are its documented
+            // leniency. Report only plain name/extras/version specifier texts. packaging's
+            // IDENTIFIER token ends at a `\b`, so a name ending in `_` (`aa_`) passes it
+            // although the spec's name grammar ends in an alphanumeric: its canonical form
+            // then ends in `-`, which no valid name's does. `===` with an operand that is not
+            // a version (`a===0.*`, reached by an edit of `a==0.*`) is pinned as pep508_rs/3:
+            // packaging takes any string after `===`, the crate parses a version.
+            let arbitrary_non_version = py.specs.iter().any(|s| {
+                s.strip_prefix("===")
+                    .is_some_and(|operand| pep508_rs::pep440_rs::Version::from_str(operand).is_err())
+            });
+            let plain = py.url.is_empty()
+                && py.marker.is_empty()
+                && !text.contains(',')
+                && !arbitrary_non_version
+                && py.name.chars().last().is_some_and(|c| c.is_ascii_alphanumeric());
+            if plain {
+                panic!("{text:?}: pep508_rs rejects, packaging accepts ({py:?}):\n{e}");
+            }
+        }
+        _ => {}
+    }
+}
