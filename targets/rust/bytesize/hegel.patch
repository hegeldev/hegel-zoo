+//! Hegel property tests for `bytesize`: `Display` in its six styles (unit choice, mantissa
+//! rounding, precision, width/alignment), `FromStr` for `ByteSize` and `Unit`, arithmetic and
+//! ordering, and the serde forms.
+//!
+//! Oracles: exact integer arithmetic (u128) — the largest unit power that fits, the decimal the
+//! printed mantissa must be within half a digit of, the byte count a `<decimal> <unit>` text
+//! denotes — plus the crate's documented tables of constants and unit spellings.
+
+use std::collections::HashSet;
+use std::fmt::Write as _;
+use std::str::FromStr;
+
+use bytesize::{ByteSize, Unit};
+use hegel::generators;
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+const SI: [u64; 7] = [1, bytesize::KB, bytesize::MB, bytesize::GB, bytesize::TB, bytesize::PB, bytesize::EB];
+const IEC: [u64; 7] = [1, bytesize::KIB, bytesize::MIB, bytesize::GIB, bytesize::TIB, bytesize::PIB, bytesize::EIB];
+
+/// The accepted unit spellings (lower-case canonical) and their factors.
+const UNITS: [(&str, &str, u64); 13] = [
+    ("b", "b", 1),
+    ("k", "kb", bytesize::KB),
+    ("m", "mb", bytesize::MB),
+    ("g", "gb", bytesize::GB),
+    ("t", "tb", bytesize::TB),
+    ("p", "pb", bytesize::PB),
+    ("e", "eb", bytesize::EB),
+    ("ki", "kib", bytesize::KIB),
+    ("mi", "mib", bytesize::MIB),
+    ("gi", "gib", bytesize::GIB),
+    ("ti", "tib", bytesize::TIB),
+    ("pi", "pib", bytesize::PIB),
+    ("ei", "eib", bytesize::EIB),
+];
+
+fn unit_of(factor: u64) -> Unit {
+    match factor {
+        1 => Unit::Byte,
+        bytesize::KB => Unit::KiloByte,
+        bytesize::MB => Unit::MegaByte,
+        bytesize::GB => Unit::GigaByte,
+        bytesize::TB => Unit::TeraByte,
+        bytesize::PB => Unit::PetaByte,
+        bytesize::EB => Unit::ExaByte,
+        bytesize::KIB => Unit::KibiByte,
+        bytesize::MIB => Unit::MebiByte,
+        bytesize::GIB => Unit::GibiByte,
+        bytesize::TIB => Unit::TebiByte,
+        bytesize::PIB => Unit::PebiByte,
+        bytesize::EIB => Unit::ExbiByte,
+        _ => unreachable!(),
+    }
+}
+
+/// A byte count biased to the unit boundaries of both bases and to the f64 precision edge.
+#[hegel::composite]
+fn arb_bytes(tc: &hegel::TestCase) -> u64 {
+    match tc.draw(int!(0u8, 6)) {
+        0 => tc.draw(int!(0u64, u64::MAX)),
+        1 => tc.draw(int!(0u64, 2000)),
+        2 => tc.draw(int!(0u64, 1 << 53)),
+        3 | 4 => {
+            let table = if tc.draw(generators::booleans()) { SI } else { IEC };
+            let e = tc.draw(int!(1usize, 6));
+            let d = tc.draw(int!(-3i64, 3));
+            let mult = tc.draw(generators::sampled_from(vec![1u64, 1, 1, 2, 7, 999, 1023, 1024, 125, 128]));
+            table[e].saturating_mul(mult).saturating_add_signed(d)
+        }
+        5 => {
+            let table = if tc.draw(generators::booleans()) { SI } else { IEC };
+            let e = tc.draw(int!(1usize, 6));
+            // a mantissa with a rounding tie in the first decimal: x.x5 × unit
+            let m = tc.draw(int!(10u64, 10_239));
+            (table[e] as u128 * m as u128 / 100).min(u64::MAX as u128) as u64
+        }
+        _ => tc.draw(generators::sampled_from(vec![0, 1, 124, 125, 127, 128, 999, 1000, 1023, 1024, 1025, u64::MAX, u64::MAX - 1, 1 << 63, (1 << 53) - 1, (1 << 53) + 1])),
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+enum Style {
+    Iec,
+    IecShort,
+    Si,
+    SiShort,
+    IecBits,
+    SiBits,
+}
+
+impl Style {
+    const ALL: [Style; 6] = [Style::Iec, Style::IecShort, Style::Si, Style::SiShort, Style::IecBits, Style::SiBits];
+    fn apply(self, d: bytesize::Display) -> bytesize::Display {
+        match self {
+            Style::Iec => d.iec(),
+            Style::IecShort => d.iec_short(),
+            Style::Si => d.si(),
+            Style::SiShort => d.si_short(),
+            Style::IecBits => d.iec_bits(),
+            Style::SiBits => d.si_bits(),
+        }
+    }
+    fn unit(self) -> u64 {
+        match self {
+            Style::Iec | Style::IecShort | Style::IecBits => 1024,
+            _ => 1000,
+        }
+    }
+    fn prefixes(self) -> &'static str {
+        match self {
+            Style::Iec | Style::IecShort | Style::IecBits => "KMGTPE",
+            _ => "kMGTPE",
+        }
+    }
+    fn sep(self) -> &'static str {
+        match self {
+            Style::IecShort | Style::SiShort => "",
+            _ => " ",
+        }
+    }
+    fn suffix(self) -> &'static str {
+        match self {
+            Style::Iec => "iB",
+            Style::Si => "B",
+            Style::IecShort | Style::SiShort => "",
+            Style::IecBits => "ib",
+            Style::SiBits => "b",
+        }
+    }
+    fn bits(self) -> bool {
+        matches!(self, Style::IecBits | Style::SiBits)
+    }
+}
+
+/// What the crate must print for `bytes` in `style` at `precision`, checked structurally: the
+/// unit is the largest power that fits the (f64-rounded) value, the mantissa has exactly
+/// `precision` decimals and is within half a last digit of the exact quotient (plus f64 slack).
+fn check_rendering(text: &str, bytes: u64, style: Style, precision: usize) {
+    let value: u128 = if style.bits() { bytes as u128 * 8 } else { bytes as u128 };
+    let unit = style.unit();
+    let threshold = if style.bits() { unit.div_ceil(8) } else { unit };
+    if bytes < threshold {
+        let b = if style.bits() { "b" } else { "B" };
+        assert_eq!(text, format!("{value}{}{b}", style.sep()), "{bytes} {style:?}");
+        return;
+    }
+    let size = bytes as f64 * if style.bits() { 8.0 } else { 1.0 };
+    let mut exp = 1usize;
+    while exp < 6 && size >= (unit.pow(exp as u32 + 1)) as f64 {
+        exp += 1;
+    }
+    let tail = format!("{}{}{}", style.sep(), style.prefixes().as_bytes()[exp - 1] as char, style.suffix());
+    let mantissa = text.strip_suffix(&tail).unwrap_or_else(|| panic!("{text:?} for {bytes} ({style:?}) does not end in {tail:?}"));
+    let (int_part, frac_part) = match mantissa.split_once('.') {
+        Some((i, f)) => (i, f),
+        None => (mantissa, ""),
+    };
+    assert_eq!(frac_part.len(), precision, "{text:?}: {precision} decimals expected");
+    assert!(!int_part.is_empty() && int_part.bytes().all(|b| b.is_ascii_digit()) && frac_part.bytes().all(|b| b.is_ascii_digit()), "{text:?}");
+    let scaled: u128 = format!("{int_part}{frac_part}").parse().unwrap();
+    // |scaled × unit^exp − value × 10^p| ≤ unit^exp / 2 (+ f64 slack of a few ulps of the value)
+    let pow = 10u128.pow(precision as u32);
+    let lhs = scaled * unit.pow(exp as u32) as u128;
+    let rhs = value * pow;
+    let diff = lhs.abs_diff(rhs);
+    let slack = (unit.pow(exp as u32) as u128).div_ceil(2) + rhs / (1u128 << 50) + 1;
+    assert!(diff <= slack, "{text:?} for {bytes} ({style:?}, .{precision}): off by {diff} > {slack}");
+}
+
+/// Every style prints the unit the value fits, a mantissa rounded to the requested precision
+/// (1 by default), `to_string`/`{}`/`{:.p}` agree with the IEC style, `Debug` appends the byte
+/// count, and width/fill/alignment pad the rendering without truncating it.
+#[hegel::test]
+fn display_styles_pick_the_unit_and_round_the_mantissa(tc: hegel::TestCase) {
+    let bytes = tc.draw(arb_bytes());
+    let bs = ByteSize(bytes);
+    let precision = tc.draw(int!(0usize, 6));
+    for style in Style::ALL {
+        let d = style.apply(bs.display());
+        check_rendering(&d.to_string(), bytes, style, 1);
+        check_rendering(&format!("{d:.precision$}"), bytes, style, precision);
+    }
+    assert_eq!(bs.to_string(), bs.display().iec().to_string());
+    assert_eq!(format!("{bs:.precision$}"), format!("{:.precision$}", bs.display().iec()));
+    assert_eq!(format!("{bs:?}"), format!("{bs} ({bytes} bytes)"));
+    assert!(bs.to_string().len() < 11, "{bs}");
+
+    let width = tc.draw(int!(0usize, 16));
+    let content = format!("{bs:.precision$}");
+    let n = content.chars().count();
+    let pad = width.saturating_sub(n);
+    assert_eq!(format!("{bs:width$.precision$}"), format!("{content}{}", " ".repeat(pad)));
+    assert_eq!(format!("{bs:<width$.precision$}"), format!("{content}{}", " ".repeat(pad)));
+    assert_eq!(format!("{bs:>width$.precision$}"), format!("{}{content}", " ".repeat(pad)));
+    assert_eq!(format!("{bs:*^width$.precision$}"), format!("{}{content}{}", "*".repeat(pad / 2), "*".repeat(pad - pad / 2)));
+    let plain = bs.to_string();
+    let pad = width.saturating_sub(plain.chars().count());
+    assert_eq!(format!("{bs:-<width$}"), format!("{plain}{}", "-".repeat(pad)));
+    let mut buf = String::new();
+    write!(buf, "{bs}").unwrap();
+    assert_eq!(buf, plain);
+}
+
+/// A `<integer>[.<fraction>][whitespace]<unit>` text denotes ⌊N × factor / 10^k⌋ bytes: exact for
+/// integers (the crate promises no f64 rounding there) and, for fractions, the floor of the exact
+/// product — a decimal such as `1.1 GB` is a whole number of bytes and must parse to it.
+#[hegel::test]
+fn decimal_and_unit_texts_parse_to_the_bytes_they_denote(tc: hegel::TestCase) {
+    let (short, long, factor) = tc.draw(generators::sampled_from(UNITS.to_vec()));
+    let spelling: String = {
+        let base = if tc.draw(generators::booleans()) { short } else { long };
+        base.chars().map(|c| if tc.draw(generators::booleans()) { c.to_ascii_uppercase() } else { c }).collect()
+    };
+    let int_part: u64 = match tc.draw(int!(0u8, 3)) {
+        0 => tc.draw(int!(0u64, 9)),
+        1 => tc.draw(int!(0u64, 9_999)),
+        2 => tc.draw(int!(0u64, u64::MAX / factor.max(1))),
+        _ => tc.draw(int!(0u64, 1 << 53)),
+    };
+    let k = tc.draw(int!(0usize, 6));
+    let frac: String = (0..k).map(|_| char::from(b'0' + tc.draw(int!(0u8, 9)))).collect();
+    let ws = tc.draw(generators::sampled_from(vec!["", " ", "  ", "\t", " \t "]));
+    let text = if k == 0 { format!("{int_part}{ws}{spelling}") } else { format!("{int_part}.{frac}{ws}{spelling}") };
+
+    let n: u128 = format!("{int_part}{frac}").parse().unwrap();
+    let scale = 10u128.pow(k as u32);
+    let (exact, rem) = (n * factor as u128 / scale, n * factor as u128 % scale);
+    let parsed = text.parse::<ByteSize>();
+    if exact > u64::MAX as u128 {
+        // beyond u64 — the result is unspecified (the crate saturates); it must not panic
+        let _ = parsed;
+        return;
+    }
+    let got = parsed.as_ref().map(|b| b.0 as u128).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    assert_eq!(bytesize::ByteSize::from_str(&text).unwrap().0 as u128, got);
+    if k == 0 {
+        // an integer text: exact (the crate promises no f64 rounding here)
+        assert_eq!(got, exact, "{text:?}");
+    } else {
+        // a decimal text: the f64 product truncated, so within a couple of ulps — and possibly one
+        // byte short of a whole-byte value (bytesize/1, pinned in
+        // `decimal_texts_denoting_whole_bytes_parse_exactly`)
+        let budget = (exact >> 51) + 1;
+        assert!(got.abs_diff(exact) <= budget, "{text:?}: got {got}, exact {exact}.{rem:0k$} (÷{scale}), budget {budget}", k = k);
+    }
+    assert_eq!(spelling.parse::<Unit>().unwrap(), unit_of(factor), "{spelling}");
+    assert_eq!(unit_of(factor) * 1u64, factor);
+    assert_eq!(3u64 * unit_of(factor), 3 * factor);
+    assert_eq!(unit_of(factor) + 1u64, factor + 1);
+    assert_eq!(1u64 + unit_of(factor), factor + 1);
+    assert_eq!(unit_of(factor) * 1.5, factor as f64 * 1.5);
+    assert_eq!(0.5 * unit_of(factor), factor as f64 * 0.5);
+    assert_eq!(unit_of(factor) + 0.5, factor as f64 + 0.5);
+    assert_eq!(0.5 + unit_of(factor), factor as f64 + 0.5);
+}
+
+/// A decimal text with an SI unit that denotes a whole number of bytes an f64 can hold —
+/// `8192.3 kB` is 8 192 300 bytes, `2.01 GB` is 2 010 000 000 — parses to exactly that number.
+#[hegel::test]
+fn decimal_texts_denoting_whole_bytes_parse_exactly(tc: hegel::TestCase) {
+    let (short, long, factor) = tc.draw(generators::sampled_from(UNITS[1..7].to_vec()));
+    let spelling = if tc.draw(generators::booleans()) { short } else { long };
+    let k = tc.draw(int!(1usize, 3)); // 10^k divides every SI factor
+    let int_part: u64 = match tc.draw(int!(0u8, 2)) {
+        0 => tc.draw(int!(0u64, 9_999)),
+        1 => tc.draw(int!(0u64, 99)),
+        _ => tc.draw(int!(0u64, ((1u64 << 53) / factor).max(1) - 1)),
+    };
+    let frac: String = (0..k).map(|_| char::from(b'0' + tc.draw(int!(0u8, 9)))).collect();
+    let text = format!("{int_part}.{frac} {spelling}");
+    let n: u128 = format!("{int_part}{frac}").parse().unwrap();
+    let scale = 10u128.pow(k as u32);
+    assert_eq!(n * factor as u128 % scale, 0, "the model must pick whole-byte texts");
+    let exact = n * factor as u128 / scale;
+    if exact >= 1 << 53 {
+        return;
+    }
+    assert_eq!(text.parse::<ByteSize>().map(|b| b.0 as u128), Ok(exact), "{text:?}");
+}
+
+/// Bare integers parse as bytes; malformed texts (empty, a bare fraction, two dots, a digit
+/// group separated by spaces, a leading unit, an unknown unit) are refused with the documented
+/// messages; the unit error truncates long spellings to three characters.
+#[hegel::test]
+fn malformed_texts_are_refused(tc: hegel::TestCase) {
+    let n = tc.draw(arb_bytes());
+    assert_eq!(n.to_string().parse::<ByteSize>(), Ok(ByteSize(n)));
+    assert_eq!(serde_json::from_str::<ByteSize>(&n.to_string()).unwrap(), ByteSize(n));
+
+    let bad = match tc.draw(int!(0u8, 6)) {
+        0 => String::new(),
+        1 => format!(".{n}"),
+        2 => format!("{n}.{}.5 KB", tc.draw(int!(0u8, 9))),
+        3 => format!("{} {n} B", tc.draw(int!(1u16, 999))),
+        4 => format!("KB{n}"),
+        5 => format!("{n} {}", tc.draw(generators::sampled_from(vec!["x", "bytes", "kilobyte", "KiBB", "B B", "1", "µ", "Kí", "ki b", "k i"]))),
+        _ => format!("{n}e3"),
+    };
+    let err = bad.parse::<ByteSize>().unwrap_err();
+    if let Some(unit) = bad.strip_prefix(&format!("{n} ")) {
+        let shown = if unit.len() > 3 {
+            let cut = (3..=6).find(|&i| unit.is_char_boundary(i)).unwrap();
+            format!("{}...", &unit[..cut])
+        } else {
+            unit.to_string()
+        };
+        assert_eq!(err, format!("couldn't parse {unit:?} into a known SI unit, Failed to parse unit \"{shown}\""), "{bad:?}");
+        let unit_err = unit.parse::<Unit>().unwrap_err();
+        assert_eq!(unit_err.to_string(), format!("Failed to parse unit \"{shown}\""));
+        assert!(std::error::Error::source(&unit_err).is_none());
+    }
+    assert!(serde_json::from_str::<ByteSize>(&format!("{bad:?}")).is_err(), "{bad:?}");
+}
+
+/// Constructors, module-level helpers and `as_*` accessors are the documented multiples;
+/// `+`, `-`, `*` (with `ByteSize`, `u64`/`u32`/`u16`/`u8`, in both orders where defined) and
+/// their assigning forms are the byte-count operations; `Sum`; `Ord`/`Eq`/`Hash` are the byte
+/// count's.
+#[hegel::test]
+fn arithmetic_and_ordering_follow_the_byte_count(tc: hegel::TestCase) {
+    let n = tc.draw(int!(0u64, 15));
+    let table = [
+        (ByteSize::b(n), bytesize::kb(0u8) + n, 1),
+        (ByteSize::kb(n), bytesize::kb(n), bytesize::KB),
+        (ByteSize::kib(n), bytesize::kib(n), bytesize::KIB),
+        (ByteSize::mb(n), bytesize::mb(n), bytesize::MB),
+        (ByteSize::mib(n), bytesize::mib(n), bytesize::MIB),
+        (ByteSize::gb(n), bytesize::gb(n), bytesize::GB),
+        (ByteSize::gib(n), bytesize::gib(n), bytesize::GIB),
+        (ByteSize::tb(n), bytesize::tb(n), bytesize::TB),
+        (ByteSize::tib(n), bytesize::tib(n), bytesize::TIB),
+        (ByteSize::pb(n), bytesize::pb(n), bytesize::PB),
+        (ByteSize::pib(n), bytesize::pib(n), bytesize::PIB),
+        (ByteSize::eb(n), bytesize::eb(n), bytesize::EB),
+        (ByteSize::eib(n), bytesize::eib(n), bytesize::EIB),
+    ];
+    for (bs, raw, factor) in table {
+        assert_eq!(bs.0, n * factor);
+        assert_eq!(bs.as_u64(), n * factor);
+        assert_eq!(raw, n * factor);
+    }
+    let x = tc.draw(arb_bytes());
+    let bs = ByteSize(x);
+    let f = x as f64;
+    assert_eq!(bs.as_kb(), f / 1e3);
+    assert_eq!(bs.as_mb(), f / 1e6);
+    assert_eq!(bs.as_gb(), f / 1e9);
+    assert_eq!(bs.as_tb(), f / 1e12);
+    assert_eq!(bs.as_pb(), f / 1e15);
+    assert_eq!(bs.as_eb(), f / 1e18);
+    assert_eq!(bs.as_kib(), f / 1024f64.powi(1));
+    assert_eq!(bs.as_mib(), f / 1024f64.powi(2));
+    assert_eq!(bs.as_gib(), f / 1024f64.powi(3));
+    assert_eq!(bs.as_tib(), f / 1024f64.powi(4));
+    assert_eq!(bs.as_pib(), f / 1024f64.powi(5));
+    assert_eq!(bs.as_eib(), f / 1024f64.powi(6));
+
+    let a = tc.draw(int!(0u64, u64::MAX / 2));
+    let b = tc.draw(int!(0u64, u64::MAX / 2));
+    let (a, b) = (a.max(b), a.min(b));
+    let (ab, bb) = (ByteSize(a), ByteSize(b));
+    assert_eq!((ab + bb).0, a + b);
+    assert_eq!((ab + b).0, a + b);
+    assert_eq!((ab - bb).0, a - b);
+    assert_eq!((ab - b).0, a - b);
+    let small = tc.draw(int!(0u8, 255));
+    assert_eq!((ab + small).0, a + small as u64);
+    assert_eq!((small + ab).0, a + small as u64);
+    assert_eq!((ab + small as u16).0, a + small as u64);
+    assert_eq!((small as u16 + ab).0, a + small as u64);
+    assert_eq!((ab + small as u32).0, a + small as u64);
+    assert_eq!((small as u32 + ab).0, a + small as u64);
+    assert_eq!((small as u64 + ab).0, a + small as u64);
+    if a >= small as u64 {
+        assert_eq!((ab - small as u32).0, a - small as u64);
+        assert_eq!((ab - small).0, a - small as u64);
+    }
+    let k = tc.draw(int!(0u8, 3));
+    let c = tc.draw(int!(0u64, u64::MAX >> 2));
+    assert_eq!((ByteSize(c) * k).0, c * k as u64);
+    assert_eq!((k * ByteSize(c)).0, c * k as u64);
+    assert_eq!((ByteSize(c) * k as u64).0, c * k as u64);
+    assert_eq!((k as u32 * ByteSize(c)).0, c * k as u64);
+    let mut m = ab;
+    m += bb;
+    m -= b;
+    m += small;
+    m -= small as u64;
+    m *= 2u8;
+    assert_eq!(m.0, a * 2);
+    let items: Vec<ByteSize> = (0..tc.draw(int!(0usize, 5))).map(|_| ByteSize(tc.draw(int!(0u64, u64::MAX / 8)))).collect();
+    let total: u64 = items.iter().map(|b| b.0).sum();
+    assert_eq!(items.iter().copied().sum::<ByteSize>().0, total);
+    assert_eq!(items.iter().sum::<ByteSize>().0, total);
+
+    assert_eq!(ab.cmp(&bb), a.cmp(&b));
+    assert_eq!(ab.partial_cmp(&bb), Some(a.cmp(&b)));
+    assert_eq!(ab == bb, a == b);
+    assert_eq!(ab.max(bb).0, a);
+    assert_eq!(ab.min(bb).0, b);
+    let set: HashSet<ByteSize> = [ab, bb, ByteSize(a)].into_iter().collect();
+    assert_eq!(set.len(), if a == b { 1 } else { 2 });
+    assert_eq!(ByteSize::default(), ByteSize(0));
+}
+
+/// Serde: a JSON number is the byte count, a JSON string is parsed like `FromStr`, negative
+/// numbers and floats are refused; serializing to JSON gives the `Display` string (the
+/// documented human-readable form) and TOML strings parse the same way.
+#[hegel::test]
+fn serde_forms(tc: hegel::TestCase) {
+    let n = tc.draw(arb_bytes());
+    let bs = ByteSize(n);
+    assert_eq!(serde_json::from_str::<ByteSize>(&format!("{n}")).unwrap(), bs);
+    assert_eq!(serde_json::from_str::<ByteSize>(&format!("\"{n}\"")).unwrap(), bs);
+    assert_eq!(serde_json::from_str::<ByteSize>(&format!("\"{n} B\"")).unwrap(), bs);
+    assert_eq!(serde_json::from_str::<ByteSize>(&format!("\"{n}B\"")).unwrap(), bs);
+    let json = serde_json::to_string(&bs).unwrap();
+    assert_eq!(json, format!("\"{bs}\""));
+    let back = serde_json::from_str::<ByteSize>(&json).unwrap();
+    assert_eq!(back, bs.to_string().parse::<ByteSize>().unwrap());
+    if n <= 1_000_000 && (n < 1024 || n % 1024 == 0) {
+        // small and exact multiples print exactly, so these round-trip
+        assert_eq!(back, bs, "{json}");
+    }
+    let (short, long, factor) = tc.draw(generators::sampled_from(UNITS.to_vec()));
+    let m = tc.draw(int!(0u64, (u64::MAX / factor).min(1000)));
+    let text = format!("{m} {}", if tc.draw(generators::booleans()) { short } else { long });
+    assert_eq!(serde_json::from_str::<ByteSize>(&format!("\"{text}\"")).unwrap(), ByteSize(m * factor));
+    #[derive(serde::Deserialize)]
+    struct S {
+        x: ByteSize,
+    }
+    let s: S = toml::from_str(&format!("x = \"{text}\"")).unwrap();
+    assert_eq!(s.x, ByteSize(m * factor));
+    let s: S = toml::from_str(&format!("x = {}", n.min(i64::MAX as u64))).unwrap();
+    assert_eq!(s.x, ByteSize(n.min(i64::MAX as u64)));
+
+    let neg = tc.draw(int!(i64::MIN, -1));
+    assert!(serde_json::from_str::<ByteSize>(&neg.to_string()).is_err());
+    assert!(serde_json::from_str::<ByteSize>(&format!("{n}.5")).is_err());
+    assert!(serde_json::from_str::<ByteSize>("null").is_err());
+    assert!(serde_json::from_str::<ByteSize>("\"\"").is_err());
+}
