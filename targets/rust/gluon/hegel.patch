+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel) for front-end robustness and evaluation.
+//
+// Themes:
+//   * parse / typecheck / run never *panic* on arbitrary source (they return Err)
+//   * the parser survives deeply-nested source without aborting the process
+//   * Int arithmetic matches a Rust i64 checked-arithmetic oracle
+//   * evaluation is deterministic
+//   * primitive / record / string literals round-trip through evaluation
+//
+// See HEGEL_REPORT.md for the two bugs these surfaced.
+// ---------------------------------------------------------------------------
+#[cfg(test)]
+mod hegel_tests {
+    use gluon::base::types::TypeCache;
+    use gluon::{ThreadExt, new_vm};
+    use hegel::generators;
+    use std::panic::{self, AssertUnwindSafe};
+
+    /// Parse only (no typecheck / compile). Returns Ok/Err; may *panic* on the
+    /// known invalid-escape bug (see `parse_invalid_string_escape_is_err`).
+    fn try_parse(src: &str) -> Result<(), String> {
+        let vm = new_vm();
+        vm.get_database_mut().implicit_prelude(false);
+        match vm.parse_expr(&TypeCache::default(), "prop", src) {
+            Ok(_) => Ok(()),
+            Err(e) => Err(e.to_string()),
+        }
+    }
+
+    fn eval_int(src: &str) -> Result<i64, String> {
+        let vm = new_vm();
+        vm.get_database_mut().implicit_prelude(false);
+        let r: Result<(i64, _), _> = vm.run_expr("prop", src);
+        r.map(|x| x.0).map_err(|e| e.to_string())
+    }
+
+    fn eval_f64(src: &str) -> Result<f64, String> {
+        let vm = new_vm();
+        vm.get_database_mut().implicit_prelude(false);
+        let r: Result<(f64, _), _> = vm.run_expr("prop", src);
+        r.map(|x| x.0).map_err(|e| e.to_string())
+    }
+
+    fn eval_string(src: &str) -> Result<String, String> {
+        let vm = new_vm();
+        vm.get_database_mut().implicit_prelude(false);
+        let r: Result<(String, _), _> = vm.run_expr("prop", src);
+        r.map(|x| x.0).map_err(|e| e.to_string())
+    }
+
+    // A vocabulary of gluon-shaped tokens for building "token soup" that stresses
+    // the parser/typechecker structurally far more than uniform-random text.
+    const TOKENS: &[&str] = &[
+        "let", "in", "type", "if", "then", "else", "match", "with", "do", "rec",
+        "\\", "->", "=", "=>", "|", ".", ",", ":", "@", "?",
+        "(", ")", "{", "}", "[", "]",
+        "x", "y", "f", "foo", "Bar", "True", "False",
+        "1", "0", "-1", "42", "1.5", "\"s\"",
+        "#Int+", "#Int-", "#Int*", "#Int/", "+", "*", "&&", "||", "==",
+        " ", "\n",
+    ];
+
+    // Property 1: the parser must never panic on gluon-shaped token soup — only
+    // return Ok or Err. Highest structural coverage of the grammar.
+    #[hegel::test]
+    fn parse_token_soup_never_panics(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(60));
+        let mut src = String::new();
+        for _ in 0..n {
+            let tok = tc.draw(generators::sampled_from(TOKENS.to_vec()));
+            src.push_str(tok);
+        }
+        // Must return without panicking.
+        let _ = try_parse(&src);
+    }
+
+    // Property 2: the parser must never panic on *arbitrary* text either. This is
+    // the true robustness net. It tolerates exactly one known panic — the invalid
+    // string-escape bug pinned by `parse_invalid_string_escape_is_err` — and fails
+    // on any other panic.
+    #[hegel::test]
+    fn parse_arbitrary_text_never_panics(tc: hegel::TestCase) {
+        let src = tc.draw(generators::text().max_size(200));
+        let prev = panic::take_hook();
+        panic::set_hook(Box::new(|_| {})); // silence expected known-bug panics
+        let result = panic::catch_unwind(AssertUnwindSafe(|| try_parse(&src)));
+        panic::set_hook(prev);
+        if let Err(payload) = result {
+            let msg = payload
+                .downcast_ref::<&str>()
+                .map(|s| s.to_string())
+                .or_else(|| payload.downcast_ref::<String>().cloned())
+                .unwrap_or_default();
+            // TWO KNOWN BUGS are tolerated here (each pinned by its own canonical
+            // failing test); any *other* panic is a new bug and fails this test:
+            //   1. "Invalid escape" — invalid string escapes panic in the lexer's
+            //      `unescape_string_literal` (parser/src/token.rs). Pinned by
+            //      `parse_invalid_string_escape_is_err`.
+            //   2. "UTF-8 string" — a non-ASCII char in an unexpected position
+            //      panics in `restore_char` (parser/src/str_suffix.rs). Pinned by
+            //      `parse_non_ascii_char_is_err`.
+            let known = msg.contains("Invalid escape") || msg.contains("UTF-8 string");
+            assert!(known, "parser panicked on {src:?}: {msg}");
+        }
+    }
+
+    // Property 3: the parser survives deeply-nested parentheses without aborting
+    // the process (it returns Ok/Err). The typechecker does NOT — see the
+    // `#[ignore]`d reproducer `typecheck_deep_nesting_stack_overflows` below.
+    #[hegel::test]
+    fn parse_deep_parens_never_aborts(tc: hegel::TestCase) {
+        let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(20_000));
+        let src = format!("{}0{}", "(".repeat(depth), ")".repeat(depth));
+        // Should return a result, never abort/panic.
+        let _ = try_parse(&src);
+    }
+
+    // Property 4: Int `+ - * /` match a Rust i64 checked-arithmetic oracle. gluon
+    // uses checked_{add,sub,mul,div}; overflow and division-by-zero (including
+    // MIN / -1) surface as an "Arithmetic overflow" error rather than Ok.
+    #[hegel::test]
+    fn int_arithmetic_matches_checked_i64_oracle(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<i64>());
+        let b = tc.draw(generators::integers::<i64>());
+        let op = tc.draw(generators::sampled_from(vec!['+', '-', '*', '/']));
+        let expected = match op {
+            '+' => a.checked_add(b),
+            '-' => a.checked_sub(b),
+            '*' => a.checked_mul(b),
+            '/' => a.checked_div(b),
+            _ => unreachable!(),
+        };
+        let src = format!("{a} #Int{op} {b}");
+        let got = eval_int(&src);
+        match expected {
+            Some(v) => assert_eq!(got, Ok(v), "expr `{src}`"),
+            None => assert!(got.is_err(), "expr `{src}` expected overflow error, got {got:?}"),
+        }
+    }
+
+    // Property 5: evaluation is deterministic — the same source evaluated twice
+    // yields the same result.
+    #[hegel::test]
+    fn evaluation_is_deterministic(tc: hegel::TestCase) {
+        // Build a small chain of Int operations that always typechecks.
+        let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+        let mut src = tc.draw(generators::integers::<i32>()).to_string();
+        for _ in 0..n {
+            let op = tc.draw(generators::sampled_from(vec!['+', '-', '*']));
+            let v = tc.draw(generators::integers::<i32>());
+            src = format!("({src}) #Int{op} {v}");
+        }
+        let first = eval_int(&src);
+        let second = eval_int(&src);
+        assert_eq!(first, second, "non-deterministic eval of `{src}`");
+    }
+
+    // Property 6: Int literal round-trip — `parse(show(n)) == n` through the full
+    // evaluator, including i64::MIN and MAX.
+    #[hegel::test]
+    fn int_literal_roundtrips_through_eval(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<i64>());
+        let src = n.to_string();
+        assert_eq!(eval_int(&src), Ok(n), "int literal `{src}`");
+    }
+
+    // Property 7: Float literal round-trip. gluon has no exponent syntax, so we
+    // stay in a magnitude range where Rust's shortest-round-trip `{:?}` never
+    // emits an exponent; parsing then goes through the same f64 parser, exactly.
+    #[hegel::test]
+    fn float_literal_roundtrips_through_eval(tc: hegel::TestCase) {
+        let f = tc.draw(
+            generators::floats::<f64>()
+                .min_value(-1.0e15)
+                .max_value(1.0e15)
+                .allow_nan(false)
+                .allow_infinity(false),
+        );
+        let src = format!("{f:?}");
+        // Skip the rare case where the shortest form still uses exponent notation
+        // (gluon's lexer has no exponent literals — an unsupported-syntax input,
+        // not a round-trip failure).
+        tc.assume(!src.contains('e') && !src.contains('E'));
+        assert_eq!(eval_f64(&src), Ok(f), "float literal `{src}`");
+    }
+
+    // Property 8: record construction + field projection round-trip. Each drawn
+    // field value must come back unchanged when projected.
+    #[hegel::test]
+    fn record_field_roundtrips_through_eval(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<i32>()) as i64;
+        let b = tc.draw(generators::integers::<i32>()) as i64;
+        let c = tc.draw(generators::integers::<i32>()) as i64;
+        let field = tc.draw(generators::sampled_from(vec!["a", "b", "c"]));
+        let src = format!("let r = {{ a = {a}, b = {b}, c = {c} }} in r.{field}");
+        let expected = match field {
+            "a" => a,
+            "b" => b,
+            _ => c,
+        };
+        assert_eq!(eval_int(&src), Ok(expected), "record projection `{src}`");
+    }
+
+    // Property 9: String literal round-trip. A string built from "safe" chars
+    // (no quote/backslash/control) must evaluate back to itself.
+    #[hegel::test]
+    fn string_literal_roundtrips_through_eval(tc: hegel::TestCase) {
+        // Draw codepoints avoiding `"` `\` and controls, which need escaping.
+        let n = tc.draw(generators::integers::<usize>().max_value(40));
+        let mut s = String::new();
+        for _ in 0..n {
+            let cp = tc.draw(hegel::one_of!(
+                generators::integers::<u32>().min_value(0x20).max_value(0x7E),
+                generators::integers::<u32>().min_value(0xA0).max_value(0xFFFF),
+            ));
+            if let Some(ch) = char::from_u32(cp) {
+                if ch != '"' && ch != '\\' && !ch.is_control() {
+                    s.push(ch);
+                }
+            }
+        }
+        let src = format!("{s:?}"); // Rust debug quoting matches gluon's for this safe subset
+        // Only proceed if the debug form introduced no escapes beyond the quotes.
+        tc.assume(!src[1..src.len() - 1].contains('\\'));
+        assert_eq!(eval_string(&src), Ok(s), "string literal `{src}`");
+    }
+
+    // ---- Pinned regression for a REAL bug (KNOWN FAILURE) -------------------
+    // Invalid string escape codes panic the parser instead of returning Err.
+    // `unescape_string_literal` (parser/src/token.rs) hits `panic!("Invalid
+    // escape")` on any escape the match arm doesn't cover, even though the lexer's
+    // `escape_code` recovers the same case gracefully. A parser MUST return Err on
+    // bad source, never panic. This test asserts the contract and therefore FAILS
+    // (panics) until the bug is fixed.
+    #[test]
+    fn parse_invalid_string_escape_is_err() {
+        // `\q` is not a valid escape; parsing must return Err, not panic.
+        assert!(
+            try_parse(r#" "\q" "#).is_err(),
+            "expected a parse error for an invalid string escape"
+        );
+    }
+
+    // Pinned regression for a second REAL bug (KNOWN FAILURE): any non-ASCII
+    // character (codepoint >= U+0080) in an unexpected position panics the parser.
+    // The "unexpected character" recovery path calls `restore_char`
+    // (parser/src/str_suffix.rs), whose `str::from_utf8(&buf).expect("UTF-8
+    // string")` panics on the reconstructed byte buffer. A bare identifier-invalid
+    // non-ASCII char such as `é` reproduces it. The parser MUST return Err, not
+    // panic, so this test FAILS (panics) until the bug is fixed.
+    #[test]
+    fn parse_non_ascii_char_is_err() {
+        assert!(
+            try_parse("é").is_err(),
+            "expected a parse error for a stray non-ASCII character"
+        );
+    }
+
+    // ---- Process-aborting bug: documented, IGNORED reproducer --------------
+    // The typechecker/compiler recurses per syntactic nesting level and overflows
+    // the stack (SIGABRT — NOT a catchable panic) on deeply-nested source at depth
+    // ~1000. Reproduces with nested parens, operator chains, lambdas and let
+    // bindings. Because it aborts the whole process it cannot be an ordinary
+    // failing test — it would take the entire suite down. Kept `#[ignore]`d.
+    // The *parser* alone handles depth 50_000 fine (see property 3); the abort is
+    // in the typecheck/compile stage. This is the classic high-value
+    // untrusted-source stack-overflow bug.
+    #[test]
+    #[ignore = "KNOWN BUG: typecheck/compile stack-overflows (SIGABRT) on deeply nested source (~depth 1000)"]
+    fn typecheck_deep_nesting_stack_overflows() {
+        let vm = new_vm();
+        vm.get_database_mut().implicit_prelude(false);
+        let depth = 5000;
+        let src = format!("{}0{}", "(".repeat(depth), ")".repeat(depth));
+        // This aborts the process with a stack overflow.
+        let _ = vm.typecheck_str("prop", &src, None);
+    }
+}
