+// ---------------------------------------------------------------------------
+// Pinned bugs
+// ---------------------------------------------------------------------------
+
+/// The C tools treat a milestone date as exclusive: on its EOL day a release is unsupported
+/// (`filter_supported = created && !eol`, `eol = date >= eol`), on its eol-lts day it leaves
+/// `--lts` for `--elts`. The crate uses `date <= eol` everywhere.
+#[hegel::test]
+fn eol_days_are_exclusive_like_the_c_tools(tc: hegel::TestCase) {
+    same_output(Distro::Ubuntu, &strings(&["--date=2006-04-30", "--supported"]));
+    same_output(Distro::Debian, &strings(&["--date=1997-06-05", "--supported"]));
+    let distro = pick(&tc, DISTROS);
+    let d = arb_boundary_date(&tc, distro, EOL_COLUMNS);
+    let ds = format!("--date={}", ymd(d));
+    for sel in ["--supported", "--unsupported"] {
+        same_output(distro, &strings(&[&ds, sel]));
+    }
+    if distro == Distro::Debian {
+        for sel in ["--lts", "--elts"] {
+            let c = run(distro.c_tool(), &strings(&[&ds, sel]));
+            if !(c.code == 0 && c.stdout.is_empty()) {
+                same_output(distro, &strings(&[&ds, sel]));
+            }
+        }
+    }
+    // The library's `supported_at` on the same day, for the release whose milestone it is.
+    let (h, rows) = csv_rows(distro);
+    for r in &rows {
+        for flag in EOL_COLUMNS {
+            if distro.milestones().contains(flag) && field(&h, r, flag).map(|x| date(x) == d).unwrap_or(false) {
+                check_milestone(distro, field(&h, r, "series").unwrap(), flag, d);
+            }
+        }
+    }
+}
+
+/// `--days` of a milestone a release does not have prints `(unknown)` in the C tools (their
+/// own test suite: `--devel --days=eol` → `Debian  "Sid" (unknown)`); the Rust binaries abort
+/// with an error for `release`/`created` and print nothing for `eol-lts`/`eol-elts`/`eol-esm`.
+#[hegel::test]
+fn days_until_missing_milestones_print_unknown(tc: hegel::TestCase) {
+    same_output(Distro::Debian, &strings(&["--date=2010-06-01", "--all", "-y"]));
+    same_output(Distro::Debian, &strings(&["--date=2010-06-01", "--supported", "--days=eol-lts"]));
+    same_output(Distro::Ubuntu, &strings(&["--date=2020-06-01", "--supported", "--days=eol-esm"]));
+    let distro = pick(&tc, DISTROS);
+    let mut args = vec![format!("--date={}", ymd(arb_date(&tc, distro))), pick(&tc, &["--all", "--supported", "--devel"]).to_string()];
+    args.extend(arb_output_flag(&tc));
+    args.push(match tc.draw(int!(0, 2)) {
+        0 => "-y".to_string(),
+        1 => "--days".to_string(),
+        _ => format!("--days={}", pick(&tc, distro.milestones())),
+    });
+    let c = run(distro.c_tool(), &args);
+    if c.code == 0 && c.stdout.is_empty() {
+        return;
+    }
+    same_output(distro, &args);
+}
+
+/// A list selector with no matches (`--lts` when no release is in LTS, `--supported` before
+/// the first release) prints nothing and exits 0 in the C tools; the Rust binaries exit 1
+/// with "Distribution data outdated".
+#[hegel::test]
+fn empty_lists_exit_zero_like_the_c_tools(tc: hegel::TestCase) {
+    same_output(Distro::Debian, &strings(&["--date=2010-06-01", "--lts"]));
+    same_output(Distro::Ubuntu, &strings(&["--date=2000-01-01", "--supported"]));
+    let distro = pick(&tc, DISTROS);
+    let sel = match distro {
+        Distro::Debian => pick(&tc, &["--lts", "--elts", "--supported", "--unsupported"]),
+        Distro::Ubuntu => pick(&tc, &["--supported", "--unsupported"]),
+    };
+    let ds = format!("--date={}", ymd(arb_date(&tc, distro)));
+    let args = strings(&[&ds, sel]);
+    let c = run(distro.c_tool(), &args);
+    if c.code == 0 && c.stdout.is_empty() {
+        same_output(distro, &args);
+    }
+}
