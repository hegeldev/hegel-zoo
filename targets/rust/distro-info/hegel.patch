+//! Hegel property tests for distro-info (the Rust port of Debian's distro-info: the
+//! `distro-info` library and its `debian-distro-info`/`ubuntu-distro-info` binaries).
+//!
+//! Reference: the C **`debian-distro-info` and `ubuntu-distro-info`** of the `distro-info`
+//! package (1.7 here), which read the same `/usr/share/distro-info/*.csv` files; upstream's
+//! own test suite for those tools is what the crate vendors as its acceptance tests. The CLI
+//! property runs the Rust binaries and the C ones with the same arguments and compares exit
+//! status and stdout; the library properties compare the `DistroInfo` selectors and
+//! `milestone_date` with the C tool's `--date` queries; the CSV property checks
+//! `from_csv_reader` against the fields it was given.
+//!
+//! In the C tools a milestone date is exclusive (`eol(date) = date >= eol`, so a release is
+//! unsupported *on* its EOL day) and every "days until" of a missing milestone prints
+//! `(unknown)`; the general properties keep away from the dates in the data files and from
+//! `--days` of milestones a release may lack, and those shapes are pinned separately.
+//!
+//! The generators are values: each property draws one small record (`CliCase`, `MilestoneCase`,
+//! `Csv`, ...) built from `sampled_from`/`tuples!`/`one_of!`/`vecs`, with a `flat_map` over the
+//! distro where the rest of the record depends on it, and renders it with pure functions
+//! (`CliCase::args`, `Csv::text`). A shape a pin owns (Debian's `--testing`, Ubuntu's `--lts`,
+//! a milestone the distro lacks, the empty lists of `empty_lists_exit_zero_like_the_c_tools`)
+//! is kept out of, or steered into, the generator rather than rejected after the draw.
+
+use chrono::{Duration, NaiveDate};
+use distro_info::{DebianDistroInfo, DistroInfo, DistroRelease, Milestone, UbuntuDistroInfo};
+use hegel::generators::Generator as _;
+use hegel::{generators, PrintableGenerator, TestCase};
+use std::collections::{BTreeSet, HashMap};
+use std::process::Command;
+use std::sync::OnceLock;
+
+fn ints(lo: i64, hi: i64) -> generators::IntegerGenerator<i64> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// `Some` of a draw from `g` with probability `p`, `None` otherwise; shrinks to `None`.
+fn maybe<T: hegel::PrettyPrintable>(
+    p: f64,
+    g: impl PrintableGenerator<T>,
+) -> impl PrintableGenerator<Option<T>> {
+    hegel::tuples!(generators::weighted_booleans(p), g).map(|(present, v)| present.then_some(v))
+}
+
+/// A draw from `a` with probability `p`, from `b` otherwise; only the chosen one is drawn, and
+/// it shrinks to `b`.  (Hegel has no weighted `one_of!`.)
+fn either<T: 'static>(
+    p: f64,
+    a: impl PrintableGenerator<T> + Send + Sync + 'static,
+    b: impl PrintableGenerator<T> + Send + Sync + 'static,
+) -> impl PrintableGenerator<T> {
+    let (a, b) = (a.boxed_printable(), b.boxed_printable());
+    generators::weighted_booleans(p).flat_map(move |first| if first { a.clone() } else { b.clone() })
+}
+
+// ---------------------------------------------------------------------------
+// The data and the C tools
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, hegel::PrettyPrintable)]
+enum Distro {
+    Debian,
+    Ubuntu,
+}
+
+const DISTROS: &[Distro] = &[Distro::Debian, Distro::Ubuntu];
+
+impl Distro {
+    fn csv(self) -> &'static str {
+        match self {
+            Distro::Debian => "/usr/share/distro-info/debian.csv",
+            Distro::Ubuntu => "/usr/share/distro-info/ubuntu.csv",
+        }
+    }
+    fn c_tool(self) -> &'static str {
+        match self {
+            Distro::Debian => "debian-distro-info",
+            Distro::Ubuntu => "ubuntu-distro-info",
+        }
+    }
+    fn rust_tool(self) -> &'static str {
+        match self {
+            Distro::Debian => env!("CARGO_BIN_EXE_debian-distro-info"),
+            Distro::Ubuntu => env!("CARGO_BIN_EXE_ubuntu-distro-info"),
+        }
+    }
+    /// The milestones the C tool's `--days` accepts for this distro.
+    fn milestones(self) -> &'static [&'static str] {
+        match self {
+            Distro::Debian => &["created", "release", "eol", "eol-lts", "eol-elts"],
+            Distro::Ubuntu => &["created", "release", "eol", "eol-server", "eol-esm"],
+        }
+    }
+    /// The end-of-life milestones among them (the ones `Milestone` names).
+    fn eol_milestones(self) -> &'static [&'static str] {
+        &self.milestones()[2..]
+    }
+    /// The plain selectors of the general CLI property. Debian's `--testing`/`-t`/`--alias`
+    /// are pinned (`testing_without_a_release_date_is_found`: the binary cannot find a testing
+    /// without a release date), Ubuntu's `--lts` too (`lts_is_the_latest_released_lts`).
+    fn selectors(self) -> &'static [&'static str] {
+        match self {
+            Distro::Debian => &["--all", "-a", "--devel", "-d", "--stable", "-s", "--oldstable", "-o", "--supported", "--lts", "-l", "--elts", "-e", "--unsupported"],
+            Distro::Ubuntu => &["--all", "-a", "--devel", "-d", "--stable", "-s", "--latest", "-l", "--supported", "--unsupported"],
+        }
+    }
+    /// The list selectors, which may select nothing at all.
+    fn list_selectors(self) -> &'static [&'static str] {
+        match self {
+            Distro::Debian => &["--lts", "--elts", "--supported", "--unsupported"],
+            Distro::Ubuntu => &["--supported", "--unsupported"],
+        }
+    }
+}
+
+/// The CSV as (header, rows), split on commas (the data has no quoted fields).
+fn csv_rows(distro: Distro) -> (Vec<String>, Vec<Vec<String>>) {
+    let text = std::fs::read_to_string(distro.csv()).unwrap();
+    let mut lines = text.lines();
+    let header: Vec<String> = lines.next().unwrap().split(',').map(|s| s.to_string()).collect();
+    let rows = lines.filter(|l| !l.is_empty()).map(|l| l.split(',').map(|s| s.to_string()).collect()).collect();
+    (header, rows)
+}
+
+fn field<'a>(header: &[String], row: &'a [String], name: &str) -> Option<&'a str> {
+    header.iter().position(|h| h == name).and_then(|i| row.get(i)).map(|s| s.as_str()).filter(|s| !s.is_empty())
+}
+
+fn date(s: &str) -> NaiveDate {
+    NaiveDate::parse_from_str(s, "%Y-%m-%d").unwrap_or_else(|e| panic!("date {s:?}: {e}"))
+}
+
+fn series_of(distro: Distro) -> Vec<String> {
+    let (h, rows) = csv_rows(distro);
+    rows.iter().map(|r| field(&h, r, "series").unwrap().to_string()).collect()
+}
+
+/// Every date in the data file under the given columns (the boundaries the selectors turn on).
+fn dates_of(distro: Distro, columns: &[&str]) -> Vec<NaiveDate> {
+    let (h, rows) = csv_rows(distro);
+    let mut out = BTreeSet::new();
+    for r in &rows {
+        for c in columns {
+            if let Some(d) = field(&h, r, c) {
+                out.insert(date(d));
+            }
+        }
+    }
+    out.into_iter().collect()
+}
+
+const ALL_COLUMNS: &[&str] = &["created", "release", "eol", "eol-lts", "eol-elts", "eol-esm", "eol-server", "eol-legacy"];
+const EOL_COLUMNS: &[&str] = &["eol", "eol-lts", "eol-elts", "eol-esm", "eol-server"];
+
+/// The tested range of dates, 1997 to mid-2028 (the data's horizon: after the last known
+/// release goes EOL nothing is "stable" and the tools disagree on what to answer).
+fn range() -> (NaiveDate, NaiveDate) {
+    (NaiveDate::from_ymd_opt(1997, 1, 1).unwrap(), NaiveDate::from_ymd_opt(2028, 6, 1).unwrap())
+}
+
+#[derive(Debug, Clone, PartialEq)]
+struct Run {
+    code: i32,
+    stdout: String,
+}
+
+fn run(bin: &str, args: &[String]) -> Run {
+    let out = Command::new(bin).args(args).output().unwrap_or_else(|e| panic!("{bin}: {e}"));
+    Run { code: out.status.code().unwrap_or(-1), stdout: String::from_utf8_lossy(&out.stdout).to_string() }
+}
+
+fn strings(args: &[&str]) -> Vec<String> {
+    args.iter().map(|s| s.to_string()).collect()
+}
+
+/// The C tool's stdout lines for `args` (it must succeed).
+fn c_lines(distro: Distro, args: &[&str]) -> Vec<String> {
+    let r = run(distro.c_tool(), &strings(args));
+    assert_eq!(r.code, 0, "{} {args:?}: {}", distro.c_tool(), r.stdout);
+    r.stdout.lines().map(|l| l.to_string()).collect()
+}
+
+/// The C tool's answer to a single-release selector: `None` when it says the data is outdated.
+fn c_single(distro: Distro, args: &[&str]) -> Option<String> {
+    let r = run(distro.c_tool(), &strings(args));
+    if r.code == 1 && r.stdout.is_empty() {
+        None
+    } else {
+        assert_eq!(r.code, 0, "{} {args:?}", distro.c_tool());
+        Some(r.stdout.trim_end().to_string())
+    }
+}
+
+/// An empty list: the C tool's answer when a list selector selects nothing.
+fn is_empty_list(r: &Run) -> bool {
+    r.code == 0 && r.stdout.is_empty()
+}
+
+fn ymd(d: NaiveDate) -> String {
+    d.format("%Y-%m-%d").to_string()
+}
+
+fn series(rs: &[&DistroRelease]) -> Vec<String> {
+    rs.iter().map(|r| r.series().to_string()).collect()
+}
+
+/// Both binaries on the same arguments must agree on exit status and stdout.
+fn same_output(distro: Distro, args: &[String]) {
+    let c = run(distro.c_tool(), args);
+    let rust = run(distro.rust_tool(), args);
+    assert_eq!(rust, c, "{} {}", distro.c_tool(), args.join(" "));
+}
+
+// ---------------------------------------------------------------------------
+// Generators
+// ---------------------------------------------------------------------------
+
+fn distro() -> generators::SampledFromGenerator<'static, Distro> {
+    generators::sampled_from(DISTROS)
+}
+
+/// A day of the tested range that is not a date of the data file (the boundary days are
+/// pinned separately: the C tools treat milestone dates as exclusive, the crate as inclusive).
+fn day(distro: Distro) -> impl PrintableGenerator<NaiveDate> {
+    let (lo, hi) = range();
+    let boundaries: BTreeSet<NaiveDate> = dates_of(distro, ALL_COLUMNS).into_iter().collect();
+    ints(0, (hi - lo).num_days())
+        .map(move |n| lo + Duration::days(n))
+        .filter(move |d| !boundaries.contains(d))
+        .print_as_debug()
+}
+
+/// A milestone date of the data file, from the given columns.
+fn boundary_day(distro: Distro, columns: &'static [&'static str]) -> impl PrintableGenerator<NaiveDate> {
+    generators::sampled_from(dates_of(distro, columns)).print_as_debug()
+}
+
+/// A distro and a milestone date of its data file.
+#[derive(Clone, Copy, Debug, hegel::PrettyPrintable)]
+struct At {
+    distro: Distro,
+    #[pretty(debug)]
+    date: NaiveDate,
+}
+
+fn at_boundary(columns: &'static [&'static str]) -> impl PrintableGenerator<At> {
+    distro().flat_map(move |distro| boundary_day(distro, columns).map(move |date| At { distro, date }))
+}
+
+const OUTPUT_FLAGS: &[&str] = &["-c", "--codename", "-f", "--fullname", "-r", "--release"];
+
+/// An output flag three times in four.
+fn output_flag() -> impl PrintableGenerator<Option<&'static str>> {
+    maybe(0.75, generators::sampled_from(OUTPUT_FLAGS))
+}
+
+const DAYS_FLAGS: &[&str] = &["--days=created", "--days=eol", "-yeol"];
+
+/// Half the time, `--days` of a milestone every release has or that both tools print as
+/// `(unknown)` (created, eol).
+fn days_flag() -> impl PrintableGenerator<Option<&'static str>> {
+    maybe(0.5, generators::sampled_from(DAYS_FLAGS))
+}
+
+fn capitalised(s: String) -> String {
+    let mut c = s.chars();
+    c.next().map(|f| f.to_uppercase().collect::<String>() + c.as_str()).unwrap_or_default()
+}
+
+/// The name after `--series=`: a series of the distro four times in five, otherwise an
+/// unknown name or a series capitalised.
+fn needle(distro: Distro) -> impl PrintableGenerator<String> {
+    let known = || generators::sampled_from(series_of(distro));
+    either(0.2, hegel::one_of!(generators::just("nope".to_string()), known().map(capitalised)), known())
+}
+
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Selector {
+    Plain(&'static str),
+    Series(String),
+}
+
+impl Selector {
+    fn render(&self) -> String {
+        match self {
+            Selector::Plain(s) => s.to_string(),
+            Selector::Series(needle) => format!("--series={needle}"),
+        }
+    }
+}
+
+/// A selector of the distro: one of its plain selectors, or `--series=<needle>` three times
+/// in twenty.
+fn selector(distro: Distro) -> impl PrintableGenerator<Selector> {
+    either(0.15, needle(distro).map(Selector::Series), generators::sampled_from(distro.selectors()).map(Selector::Plain))
+}
+
+/// The arguments of the general CLI property: a non-boundary date, a selector, an output flag
+/// and a `--days`, in either order.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct CliCase {
+    distro: Distro,
+    #[pretty(debug)]
+    date: NaiveDate,
+    selector: Selector,
+    output: Option<&'static str>,
+    days: Option<&'static str>,
+    reversed: bool,
+}
+
+impl CliCase {
+    fn args(&self) -> Vec<String> {
+        let mut args = vec![format!("--date={}", ymd(self.date)), self.selector.render()];
+        args.extend(self.output.map(str::to_string));
+        args.extend(self.days.map(str::to_string));
+        // The order of the options does not matter to either tool.
+        if self.reversed {
+            args.reverse();
+        }
+        args
+    }
+}
+
+fn cli_case() -> impl PrintableGenerator<CliCase> {
+    distro().flat_map(|distro| {
+        hegel::tuples!(day(distro), selector(distro), output_flag(), days_flag(), generators::booleans())
+            .map(move |(date, selector, output, days, reversed)| CliCase { distro, date, selector, output, days, reversed })
+    })
+}
+
+/// A release of a distro, one of the distro's end-of-life milestones and a non-boundary date.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct MilestoneCase {
+    distro: Distro,
+    #[pretty(debug)]
+    date: NaiveDate,
+    series: String,
+    flag: &'static str,
+}
+
+fn milestone_case() -> impl PrintableGenerator<MilestoneCase> {
+    distro().flat_map(|distro| {
+        hegel::tuples!(day(distro), generators::sampled_from(series_of(distro)), generators::sampled_from(distro.eol_milestones()))
+            .map(move |(date, series, flag)| MilestoneCase { distro, date, series, flag })
+    })
+}
+
+const DAYS_SELECTORS: &[&str] = &["--all", "--supported", "--devel"];
+
+/// `--all`, `--supported` or `--devel` at a non-boundary date, with an output flag and `-y`,
+/// `--days` or `--days=<any milestone of the distro>`.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct DaysCase {
+    distro: Distro,
+    #[pretty(debug)]
+    date: NaiveDate,
+    selector: &'static str,
+    output: Option<&'static str>,
+    days: String,
+}
+
+impl DaysCase {
+    fn args(&self) -> Vec<String> {
+        let mut args = vec![format!("--date={}", ymd(self.date)), self.selector.to_string()];
+        args.extend(self.output.map(str::to_string));
+        args.push(self.days.clone());
+        args
+    }
+}
+
+fn days_case() -> impl PrintableGenerator<DaysCase> {
+    distro().flat_map(|distro| {
+        let days = hegel::one_of!(
+            generators::just("-y".to_string()),
+            generators::just("--days".to_string()),
+            generators::sampled_from(distro.milestones()).map(|m| format!("--days={m}")),
+        );
+        hegel::tuples!(day(distro), generators::sampled_from(DAYS_SELECTORS), output_flag(), days)
+            .map(move |(date, selector, output, days)| DaysCase { distro, date, selector, output, days })
+    })
+}
+
+/// Every non-boundary day of the tested range at which the C tool's list for `sel` is empty.
+/// The dates of the data file cut the range into windows on which every list is constant
+/// (each of the C rules is a `date >= <date of the file>`), so the tool is asked once per
+/// window; computed on first use for every list selector of both distros.
+fn empty_days(distro: Distro, sel: &'static str) -> &'static [NaiveDate] {
+    static EMPTY: OnceLock<HashMap<(Distro, &'static str), Vec<NaiveDate>>> = OnceLock::new();
+    &EMPTY.get_or_init(|| {
+        let mut out = HashMap::new();
+        for &distro in DISTROS {
+            let (lo, hi) = range();
+            let mut edges = vec![lo - Duration::days(1)];
+            edges.extend(dates_of(distro, ALL_COLUMNS).into_iter().filter(|d| (lo..=hi).contains(d)));
+            edges.push(hi + Duration::days(1));
+            for &sel in distro.list_selectors() {
+                let mut days = Vec::new();
+                for window in edges.windows(2) {
+                    let (first, last) = (window[0] + Duration::days(1), window[1] - Duration::days(1));
+                    if first > last {
+                        continue;
+                    }
+                    if is_empty_list(&run(distro.c_tool(), &strings(&[&format!("--date={}", ymd(first)), sel]))) {
+                        days.extend((0..=(last - first).num_days()).map(|n| first + Duration::days(n)));
+                    }
+                }
+                out.insert((distro, sel), days);
+            }
+        }
+        out
+    })[&(distro, sel)]
+}
+
+/// A list selector of a distro and a non-boundary date at which the C tool's list is empty
+/// (a selector whose list is never empty in the range, Debian's `--supported`, is left out).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct EmptyListCase {
+    distro: Distro,
+    selector: &'static str,
+    #[pretty(debug)]
+    date: NaiveDate,
+}
+
+fn empty_list_case() -> impl PrintableGenerator<EmptyListCase> {
+    distro().flat_map(|distro| {
+        let selectors: Vec<&'static str> =
+            distro.list_selectors().iter().copied().filter(|sel| !empty_days(distro, sel).is_empty()).collect();
+        generators::sampled_from(selectors).flat_map(move |selector| {
+            generators::sampled_from(empty_days(distro, selector))
+                .print_as_debug()
+                .map(move |date| EmptyListCase { distro, selector, date })
+        })
+    })
+}
+
+// ---------------------------------------------------------------------------
+// The binaries against the C tools
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn binaries_agree_with_the_c_tools(tc: TestCase) {
+    let case = tc.draw(cli_case());
+    let args = case.args();
+    let c = run(case.distro.c_tool(), &args);
+    // An empty list (nothing supported/LTS/… at that date) is pinned in
+    // `empty_lists_exit_zero_like_the_c_tools`.
+    tc.assume(!is_empty_list(&c));
+    let rust = run(case.distro.rust_tool(), &args);
+    assert_eq!(rust, c, "{} {}", case.distro.c_tool(), args.join(" "));
+}
+
+// ---------------------------------------------------------------------------
+// The library selectors against the C tool
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn debian_selectors_agree_with_the_c_tool(tc: TestCase) {
+    let distro = Distro::Debian;
+    let info = DebianDistroInfo::new().unwrap();
+    let d = tc.draw(day(distro));
+    let ds = format!("--date={}", ymd(d));
+    assert_eq!(series(&info.supported(d, Milestone::Eol)), c_lines(distro, &[&ds, "--supported"]), "supported at {ds}");
+    assert_eq!(series(&info.unsupported(d, Milestone::Eol)), c_lines(distro, &[&ds, "--unsupported"]), "unsupported at {ds}");
+    assert_eq!(series(&info.debian_devel(d)), c_single(distro, &[&ds, "--devel"]).into_iter().collect::<Vec<_>>(), "devel at {ds}");
+    assert_eq!(info.stable(d).map(|r| r.series().to_string()), c_single(distro, &[&ds, "--stable"]), "stable at {ds}");
+    assert_eq!(info.latest(d).map(|r| r.series().to_string()), c_single(distro, &[&ds, "--stable"]), "latest at {ds}");
+    assert_eq!(DebianDistroInfo::oldstable(&info, d).map(|r| r.series().to_string()), c_single(distro, &[&ds, "--oldstable"]), "oldstable at {ds}");
+    assert_eq!(DistroInfo::oldstable(&info, d).map(|r| r.series().to_string()), c_single(distro, &[&ds, "--oldstable"]), "trait oldstable at {ds}");
+    let (h, rows) = csv_rows(distro);
+    // Beyond the data's horizon two unreleased releases can coexist (forky without a release
+    // date, duke created 2027-08-01); the C tool then takes the latest created, the crate the
+    // first. Real data never has two, so `testing` is only compared while there is one.
+    let unreleased = rows.iter().filter(|r| field(&h, r, "release").is_none() && field(&h, r, "created").map(|c| date(c) <= d).unwrap_or(false) && !matches!(field(&h, r, "series"), Some("sid" | "experimental"))).count();
+    if unreleased <= 1 {
+        assert_eq!(info.testing(d).map(|r| r.series().to_string()), c_single(distro, &[&ds, "--testing"]), "testing at {ds}");
+    }
+    assert_eq!(info.unstable().series(), "sid");
+    assert_eq!(info.experimental().series(), "experimental");
+    // `all_at`/`released`: every release created/released by the date, in file order.
+    let created: Vec<String> = rows.iter().filter(|r| field(&h, r, "created").map(|c| date(c) <= d).unwrap_or(false)).map(|r| field(&h, r, "series").unwrap().to_string()).collect();
+    assert_eq!(series(&info.all_at(d)), created, "all_at {ds}");
+    let released: Vec<String> = rows.iter().filter(|r| field(&h, r, "release").map(|c| date(c) <= d).unwrap_or(false)).map(|r| field(&h, r, "series").unwrap().to_string()).collect();
+    assert_eq!(series(&info.released(d)), released, "released {ds}");
+}
+
+#[hegel::test]
+fn ubuntu_selectors_agree_with_the_c_tool(tc: TestCase) {
+    let distro = Distro::Ubuntu;
+    let info = UbuntuDistroInfo::new().unwrap();
+    let d = tc.draw(day(distro));
+    let ds = format!("--date={}", ymd(d));
+    assert_eq!(series(&info.ubuntu_supported(d)), c_lines(distro, &[&ds, "--supported"]), "supported at {ds}");
+    assert_eq!(series(&info.ubuntu_unsupported(d)), c_lines(distro, &[&ds, "--unsupported"]), "unsupported at {ds}");
+    assert_eq!(series(&info.ubuntu_devel(d)), c_single(distro, &[&ds, "--devel"]).into_iter().collect::<Vec<_>>(), "devel at {ds}");
+    assert_eq!(info.latest(d).map(|r| r.series().to_string()), c_single(distro, &[&ds, "--stable"]), "latest at {ds}");
+    // The C tool's `--lts`: the latest *released*, not yet EOL LTS (filter_lts +
+    // select_latest_release; EOL is `date >= eol` and, when set, `date >= eol-server`).
+    let eol = |r: &DistroRelease| r.eol().map(|e| d >= e).unwrap_or(false) && r.eol_server().map(|s| d >= s).unwrap_or(true);
+    let lts: Vec<String> = info.released(d).into_iter().filter(|r| r.ubuntu_is_lts() && !eol(r)).map(|r| r.series().to_string()).collect();
+    assert_eq!(lts.last().cloned(), c_single(distro, &[&ds, "--lts"]), "lts at {ds}");
+}
+
+/// `ubuntu-distro-info --lts` is the latest released LTS in the C tool; the Rust binary takes
+/// the latest *created* LTS, so for the six months between an LTS's creation and its release
+/// it names the one still in development (trusty on 2013-10-18, where C says precise).
+#[hegel::test]
+fn lts_is_the_latest_released_lts(tc: TestCase) {
+    same_output(Distro::Ubuntu, &strings(&["--date=2013-10-18", "--lts"]));
+    let (d, output) = tc.draw(hegel::tuples!(day(Distro::Ubuntu), output_flag()));
+    let mut args = vec![format!("--date={}", ymd(d)), "--lts".to_string()];
+    args.extend(output.map(str::to_string));
+    same_output(Distro::Ubuntu, &args);
+}
+
+fn milestone_of(flag: &str) -> Milestone {
+    match flag {
+        "eol" => Milestone::Eol,
+        "eol-lts" => Milestone::EolLTS,
+        "eol-elts" => Milestone::EolELTS,
+        "eol-server" => Milestone::EolServer,
+        "eol-esm" => Milestone::EolESM,
+        f => panic!("no milestone {f}"),
+    }
+}
+
+fn releases_of(distro: Distro) -> Vec<DistroRelease> {
+    match distro {
+        Distro::Debian => DebianDistroInfo::new().unwrap().into_iter().collect(),
+        Distro::Ubuntu => UbuntuDistroInfo::new().unwrap().into_iter().collect(),
+    }
+}
+
+/// `milestone_date`, `supported_at`, `created_at`, `released_at` of one release at one
+/// date, against the C tool's `--series=X --days=<milestone>` (days from the date to the
+/// milestone; `(unknown)` when there is none) and its rule "created <= date < milestone".
+fn check_milestone(distro: Distro, name: &str, flag: &str, d: NaiveDate) {
+    let ds = format!("--date={}", ymd(d));
+    let milestone = milestone_of(flag);
+    let releases = releases_of(distro);
+    let release = releases.iter().find(|r| r.series() == name).unwrap();
+    let c = c_lines(distro, &[&ds, &format!("--series={name}"), &format!("--days={flag}")]);
+    assert_eq!(c.len(), 1, "one line from the C tool");
+    let expected = if c[0] == "(unknown)" { None } else { Some(d + chrono::Duration::days(c[0].parse::<i64>().unwrap())) };
+    assert_eq!(release.milestone_date(&milestone), expected, "{name} {flag} at {ds}");
+    let supported = release.created_at(d)
+        && match expected {
+            Some(m) => d < m,
+            None => milestone == Milestone::Eol,
+        };
+    assert_eq!(release.supported_at(d, &milestone), supported, "{name} supported ({flag}) at {ds}");
+    assert_eq!(release.created_at(d), release.created().map(|c| d >= c).unwrap_or(false));
+    assert_eq!(release.released_at(d), release.release().map(|c| d >= c).unwrap_or(false));
+}
+
+#[hegel::test]
+fn milestones_agree_with_the_c_tool(tc: TestCase) {
+    let MilestoneCase { distro, date, series, flag } = tc.draw(milestone_case());
+    check_milestone(distro, &series, flag, date);
+}
+
+// ---------------------------------------------------------------------------
+// CSV parsing against the fields written
+// ---------------------------------------------------------------------------
+
+const COLUMNS: &[&str] = &["version", "codename", "series", "created", "release", "eol", "eol-lts", "eol-elts", "eol-esm", "eol-server"];
+const NAME_COLUMNS: &[&str] = &["version", "codename", "series"];
+const DATE_COLUMNS: &[&str] = &["created", "release", "eol", "eol-lts", "eol-elts", "eol-esm", "eol-server"];
+
+/// A version (may be empty) and a codename or series (never empty).
+const VERSIONS: &[&str] = &["", "x", "12", "1.1", "26.04 LTS", "sid", "Trusty Tahr"];
+const NAMES: &[&str] = &["x", "z", "12", "1.1", "sid", "Trusty Tahr", "26.04 LTS"];
+
+/// A row: the three names, then a date cell per date column up to a cut (the shape of the
+/// real files, which stop a row after its last known date); a cell is written empty only when
+/// the CSV is drawn with `empties`.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Row {
+    version: &'static str,
+    codename: &'static str,
+    series: &'static str,
+    dates: Vec<Option<String>>,
+}
+
+/// A CSV: the three name columns first, as in the real files, then 0-7 date columns in any
+/// order, and 0-4 rows.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Csv {
+    columns: Vec<&'static str>,
+    rows: Vec<Row>,
+}
+
+impl Csv {
+    fn text(&self) -> String {
+        let header: Vec<&str> = NAME_COLUMNS.iter().chain(&self.columns).copied().collect();
+        let mut text = header.join(",") + "\n";
+        for row in &self.rows {
+            let cells: Vec<&str> = [row.version, row.codename, row.series]
+                .into_iter()
+                .chain(row.dates.iter().map(|d| d.as_deref().unwrap_or("")))
+                .collect();
+            text.push_str(&cells.join(","));
+            text.push('\n');
+        }
+        text
+    }
+
+    /// Per row, the expected value of every column of `COLUMNS` (`None` when the column is
+    /// absent from the header, cut off, or written empty).
+    fn expected(&self) -> Vec<Vec<Option<String>>> {
+        self.rows
+            .iter()
+            .map(|row| {
+                let mut out = vec![None; COLUMNS.len()];
+                out[0] = Some(row.version.to_string()).filter(|s| !s.is_empty());
+                out[1] = Some(row.codename.to_string());
+                out[2] = Some(row.series.to_string());
+                for (name, cell) in self.columns.iter().zip(&row.dates) {
+                    out[COLUMNS.iter().position(|c| c == name).unwrap()] = cell.clone();
+                }
+                out
+            })
+            .collect()
+    }
+}
+
+fn csv_date() -> impl PrintableGenerator<String> {
+    let epoch = NaiveDate::from_ymd_opt(1993, 1, 1).unwrap();
+    ints(0, 20000).map(move |n| ymd(epoch + Duration::days(n)))
+}
+
+/// A date cell: a date, or - with `empties` - one time in three written empty.
+fn cell(empties: bool) -> generators::BoxedPrintableGenerator<'static, Option<String>> {
+    if empties {
+        hegel::one_of!(generators::just(None::<String>), csv_date().map(Some), csv_date().map(Some)).boxed_printable()
+    } else {
+        csv_date().map(Some).boxed_printable()
+    }
+}
+
+fn row(ndates: usize, empties: bool) -> impl PrintableGenerator<Row> {
+    hegel::tuples!(
+        generators::sampled_from(VERSIONS),
+        generators::sampled_from(NAMES),
+        generators::sampled_from(NAMES),
+        generators::vecs(cell(empties)).max_size(ndates)
+    )
+    .map(|(version, codename, series, dates)| Row { version, codename, series, dates })
+}
+
+fn csv(empties: bool) -> impl PrintableGenerator<Csv> {
+    ints(0, DATE_COLUMNS.len() as i64).flat_map(move |n| {
+        let n = n as usize;
+        hegel::tuples!(generators::permutations(&DATE_COLUMNS[..n]), generators::vecs(row(n, empties)).max_size(4))
+            .map(|(columns, rows)| Csv { columns, rows })
+    })
+}
+
+fn check_csv(text: &str, expected: &[Vec<Option<String>>]) {
+    let reader = csv::ReaderBuilder::new().flexible(true).has_headers(true).from_reader(text.as_bytes());
+    let info = DebianDistroInfo::from_csv_reader(reader).unwrap_or_else(|e| panic!("parse of {text:?}: {e}"));
+    let parsed: Vec<&DistroRelease> = info.releases().iter().collect();
+    assert_eq!(parsed.len(), expected.len(), "row count for {text:?}");
+    for (p, row) in parsed.iter().zip(expected) {
+        let f = |name: &str| -> Option<String> { row[COLUMNS.iter().position(|c| *c == name).unwrap()].clone() };
+        let fd = |name: &str| f(name).map(|s| date(&s));
+        assert_eq!(p.version(), &f("version"), "version in {text:?}");
+        assert_eq!(p.codename(), &f("codename").unwrap(), "codename in {text:?}");
+        assert_eq!(p.series(), &f("series").unwrap(), "series in {text:?}");
+        assert_eq!(p.created(), &fd("created"), "created in {text:?}");
+        assert_eq!(p.release(), &fd("release"), "release in {text:?}");
+        assert_eq!(p.eol(), &fd("eol"), "eol in {text:?}");
+        assert_eq!(p.eol_lts(), &fd("eol-lts"), "eol-lts in {text:?}");
+        assert_eq!(p.eol_elts(), &fd("eol-elts"), "eol-elts in {text:?}");
+        assert_eq!(p.eol_esm(), &fd("eol-esm"), "eol-esm in {text:?}");
+        assert_eq!(p.eol_server(), &fd("eol-server"), "eol-server in {text:?}");
+        assert_eq!(p.ubuntu_is_lts(), f("version").map(|v| v.contains("LTS")).unwrap_or(false));
+    }
+}
+
+/// Rows cut after their last date (the shape of the real files); written-empty date fields
+/// are pinned in `empty_date_fields_parse_as_none`.
+#[hegel::test]
+fn csv_files_parse_like_their_fields(tc: TestCase) {
+    let csv = tc.draw(csv(false));
+    check_csv(&csv.text(), &csv.expected());
+}
+
+// ---------------------------------------------------------------------------
+// Pinned bugs
+// ---------------------------------------------------------------------------
+
+/// The C tools treat a milestone date as exclusive: on its EOL day a release is unsupported
+/// (`filter_supported = created && !eol`, `eol = date >= eol`), on its eol-lts day it leaves
+/// `--lts` for `--elts`. The crate uses `date <= eol` everywhere.
+#[hegel::test]
+fn eol_days_are_exclusive_like_the_c_tools(tc: TestCase) {
+    same_output(Distro::Ubuntu, &strings(&["--date=2006-04-30", "--supported"]));
+    same_output(Distro::Debian, &strings(&["--date=1997-06-05", "--supported"]));
+    let At { distro, date: d } = tc.draw(at_boundary(EOL_COLUMNS));
+    let ds = format!("--date={}", ymd(d));
+    for sel in ["--supported", "--unsupported"] {
+        same_output(distro, &strings(&[&ds, sel]));
+    }
+    if distro == Distro::Debian {
+        for sel in ["--lts", "--elts"] {
+            let c = run(distro.c_tool(), &strings(&[&ds, sel]));
+            if !is_empty_list(&c) {
+                same_output(distro, &strings(&[&ds, sel]));
+            }
+        }
+    }
+    // The library's `supported_at` on the same day, for the release whose milestone it is.
+    let (h, rows) = csv_rows(distro);
+    for r in &rows {
+        for flag in EOL_COLUMNS {
+            if distro.milestones().contains(flag) && field(&h, r, flag).map(|x| date(x) == d).unwrap_or(false) {
+                check_milestone(distro, field(&h, r, "series").unwrap(), flag, d);
+            }
+        }
+    }
+}
+
+/// `--days` of a milestone a release does not have prints `(unknown)` in the C tools (their
+/// own test suite: `--devel --days=eol` → `Debian  "Sid" (unknown)`); the Rust binaries abort
+/// with an error for `release`/`created` and print nothing for `eol-lts`/`eol-elts`/`eol-esm`.
+#[hegel::test]
+fn days_until_missing_milestones_print_unknown(tc: TestCase) {
+    same_output(Distro::Debian, &strings(&["--date=2010-06-01", "--all", "-y"]));
+    same_output(Distro::Debian, &strings(&["--date=2010-06-01", "--supported", "--days=eol-lts"]));
+    same_output(Distro::Ubuntu, &strings(&["--date=2020-06-01", "--supported", "--days=eol-esm"]));
+    let case = tc.draw(days_case());
+    let args = case.args();
+    // An empty list is `empty_lists_exit_zero_like_the_c_tools`'s business.
+    tc.assume(!is_empty_list(&run(case.distro.c_tool(), &args)));
+    same_output(case.distro, &args);
+}
+
+/// A list selector with no matches (`--lts` when no release is in LTS, `--supported` before
+/// the first release) prints nothing and exits 0 in the C tools; the Rust binaries exit 1
+/// with "Distribution data outdated".
+#[hegel::test]
+fn empty_lists_exit_zero_like_the_c_tools(tc: TestCase) {
+    same_output(Distro::Debian, &strings(&["--date=2010-06-01", "--lts"]));
+    same_output(Distro::Ubuntu, &strings(&["--date=2000-01-01", "--supported"]));
+    let EmptyListCase { distro, selector, date } = tc.draw(empty_list_case());
+    same_output(distro, &strings(&[&format!("--date={}", ymd(date)), selector]));
+}
+
+/// Debian's testing has no release date until it is released; the C tool finds it (created,
+/// not released), the Rust binary's `--testing` and `--alias` use `ubuntu_devel`, which needs
+/// a release date, and report the data as outdated / the codename as its own alias.
+#[hegel::test]
+fn testing_without_a_release_date_is_found(tc: TestCase) {
+    same_output(Distro::Debian, &strings(&["--date=2026-01-01", "--testing"]));
+    same_output(Distro::Debian, &strings(&["--date=2026-01-01", "--alias=forky"]));
+    let (d, series) = tc.draw(hegel::tuples!(day(Distro::Debian), generators::sampled_from(series_of(Distro::Debian))));
+    let ds = format!("--date={}", ymd(d));
+    same_output(Distro::Debian, &strings(&[&ds, "--testing"]));
+    same_output(Distro::Debian, &strings(&[&ds, &format!("--alias={series}")]));
+}
+
+/// The library's `DebianDistroInfo::testing` uses `date > created` where the C tool (and
+/// every other selector of the crate) uses `>=`: on the day a new testing is created it
+/// finds none.
+#[test]
+fn testing_on_its_creation_day() {
+    let info = DebianDistroInfo::new().unwrap();
+    let d = date("2025-08-09"); // trixie released, forky created
+    assert_eq!(c_single(Distro::Debian, &["--date=2025-08-09", "--testing"]), Some("forky".to_string()));
+    assert_eq!(info.testing(d).map(|r| r.series().to_string()), Some("forky".to_string()));
+}
+
+/// An empty date field (`eol` unknown while a later column is set) fails the whole parse
+/// with "premature end of input"; the C tool reads it as no date.
+#[hegel::test]
+fn empty_date_fields_parse_as_none(tc: TestCase) {
+    check_csv("version,codename,series,created,release,eol,eol-lts\n14,Forky,forky,2025-08-09,,,\n", &[vec![Some("14".into()), Some("Forky".into()), Some("forky".into()), Some("2025-08-09".into()), None, None, None, None, None, None]]);
+    let csv = tc.draw(csv(true));
+    check_csv(&csv.text(), &csv.expected());
+}
