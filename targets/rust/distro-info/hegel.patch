+/// The library's `DebianDistroInfo::testing` uses `date > created` where the C tool (and
+/// every other selector of the crate) uses `>=`: on the day a new testing is created it
+/// finds none.
+#[test]
+fn testing_on_its_creation_day() {
+    let info = DebianDistroInfo::new().unwrap();
+    let d = date("2025-08-09"); // trixie released, forky created
+    assert_eq!(c_single(Distro::Debian, &["--date=2025-08-09", "--testing"]), Some("forky".to_string()));
+    assert_eq!(info.testing(d).map(|r| r.series().to_string()), Some("forky".to_string()));
+}
