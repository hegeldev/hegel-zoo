+/// Debian's testing has no release date until it is released; the C tool finds it (created,
+/// not released), the Rust binary's `--testing` and `--alias` use `ubuntu_devel`, which needs
+/// a release date, and report the data as outdated / the codename as its own alias.
+#[hegel::test]
+fn testing_without_a_release_date_is_found(tc: hegel::TestCase) {
+    same_output(Distro::Debian, &strings(&["--date=2026-01-01", "--testing"]));
+    same_output(Distro::Debian, &strings(&["--date=2026-01-01", "--alias=forky"]));
+    let d = arb_date(&tc, Distro::Debian);
+    let ds = format!("--date={}", ymd(d));
+    same_output(Distro::Debian, &strings(&[&ds, "--testing"]));
+    same_output(Distro::Debian, &strings(&[&ds, &format!("--alias={}", pick(&tc, &series_of(Distro::Debian)))]));
+}
