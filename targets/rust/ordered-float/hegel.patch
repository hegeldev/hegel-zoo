+//! Hegel property tests for `ordered-float`.
+//!
+//! `OrderedFloat<T>` promises a total order (`Ord`, `Eq`, `Hash`) on floats in which NaN is
+//! greater than everything and equal to itself, `-0.0 == +0.0`, and all NaNs are equal;
+//! `NotNan<T>` promises never to hold a NaN: construction rejects one, and "arithmetic on NotNan
+//! values will panic if it produces a NaN value". Everything else is a transparent wrapper whose
+//! results must be the float's own. The oracles are the primitive float operations, the `Ord`
+//! laws, and `Hash`/`Eq` consistency; every `NotNan` operation is run under `catch_unwind` and
+//! must either panic (exactly when the float result is NaN) or return the float result.
+
+use std::cmp::Ordering;
+use std::collections::{BTreeSet, HashSet};
+use std::hash::{DefaultHasher, Hash, Hasher};
+use std::panic::{catch_unwind, AssertUnwindSafe};
+use std::sync::Once;
+
+use hegel::generators;
+use hegel::Generator as _;
+use num_traits::real::Real;
+use num_traits::{Bounded, FromPrimitive, NumCast, One, Signed, ToPrimitive, Zero};
+use ordered_float::{FloatCore, FloatIsNan, NotNan, OrderedFloat, ParseNotNanError, Pow};
+
+/// Expected panics (NaN results) are part of the contract; keep them off stderr.
+fn quiet_panics() {
+    static ONCE: Once = Once::new();
+    ONCE.call_once(|| std::panic::set_hook(Box::new(|_| {})));
+}
+
+fn hash_of<H: Hash>(h: &H) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    h.hash(&mut hasher);
+    hasher.finish()
+}
+
+/// The documented order: NaNs equal to each other and above everything; otherwise the float's
+/// own order (so `-0.0 == +0.0`).
+fn model_cmp<T: FloatCore>(a: T, b: T) -> Ordering {
+    match (a.is_nan(), b.is_nan()) {
+        (true, true) => Ordering::Equal,
+        (true, false) => Ordering::Greater,
+        (false, true) => Ordering::Less,
+        (false, false) => a.partial_cmp(&b).unwrap(),
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Generators: ordinary floats plus the corners the wrappers are about
+// ---------------------------------------------------------------------------------------------
+
+macro_rules! float_generator {
+    ($name:ident, $t:ty, $bits:ty, $exp_mask:expr) => {
+        #[hegel::composite]
+        fn $name(tc: &hegel::TestCase) -> $t {
+            let special = tc.draw(generators::weighted_booleans(0.4));
+            if special {
+                let which = tc.draw(generators::integers::<u8>().max_value(15));
+                match which {
+                    0 => 0.0,
+                    1 => -0.0,
+                    2 => <$t>::INFINITY,
+                    3 => <$t>::NEG_INFINITY,
+                    4 | 5 => {
+                        // A NaN with arbitrary sign and payload (quiet or signalling).
+                        let payload = tc.draw(generators::integers::<$bits>());
+                        let nan = <$t>::from_bits(payload | $exp_mask);
+                        if nan.is_nan() { nan } else { <$t>::NAN }
+                    }
+                    6 => <$t>::MAX,
+                    7 => <$t>::MIN,
+                    8 => <$t>::MIN_POSITIVE,
+                    9 => <$t>::EPSILON,
+                    10 => 1.0,
+                    11 => -1.0,
+                    12 => 0.5,
+                    13 => 2.0,
+                    14 => 1e-45 as $t,
+                    _ => tc.draw(generators::integers::<i16>()) as $t,
+                }
+            } else {
+                tc.draw(generators::floats::<$t>())
+            }
+        }
+    };
+}
+
+float_generator!(arb_f64, f64, u64, 0x7ff0_0000_0000_0000u64);
+float_generator!(arb_f32, f32, u32, 0x7f80_0000u32);
+
+// ---------------------------------------------------------------------------------------------
+// Properties, instantiated for f32 and f64
+// ---------------------------------------------------------------------------------------------
+
+macro_rules! properties {
+    ($t:ty, $arb:ident) => {
+        fn ordered(x: $t) -> OrderedFloat<$t> {
+            OrderedFloat(x)
+        }
+
+        /// `OrderedFloat`'s `Ord`/`PartialOrd`/`Eq` follow the documented order exactly and obey
+        /// the `Ord` laws (antisymmetry, transitivity, agreement between `cmp`, `partial_cmp`,
+        /// `==` and the four comparison operators); `NotNan` orders like the float itself.
+        #[hegel::test]
+        fn ordering_is_total_and_as_documented(tc: hegel::TestCase) {
+            let a = tc.draw($arb());
+            let b = tc.draw($arb());
+            let c = tc.draw($arb());
+            let (oa, ob, oc) = (ordered(a), ordered(b), ordered(c));
+            let ab = oa.cmp(&ob);
+            assert_eq!(ab, model_cmp(a, b), "cmp({a:?}, {b:?})");
+            assert_eq!(ob.cmp(&oa), ab.reverse(), "antisymmetry for {a:?}, {b:?}");
+            assert_eq!(oa.partial_cmp(&ob), Some(ab));
+            assert_eq!(oa == ob, ab == Ordering::Equal, "== vs cmp for {a:?}, {b:?}");
+            assert_eq!(oa != ob, ab != Ordering::Equal);
+            assert_eq!(oa < ob, ab == Ordering::Less, "< for {a:?}, {b:?}");
+            assert_eq!(oa <= ob, ab != Ordering::Greater, "<= for {a:?}, {b:?}");
+            assert_eq!(oa > ob, ab == Ordering::Greater, "> for {a:?}, {b:?}");
+            assert_eq!(oa >= ob, ab != Ordering::Less, ">= for {a:?}, {b:?}");
+            assert_eq!(oa.cmp(&oa), Ordering::Equal, "reflexivity for {a:?}");
+            // Transitivity through c.
+            let bc = ob.cmp(&oc);
+            let ac = oa.cmp(&oc);
+            if ab != Ordering::Greater && bc != Ordering::Greater {
+                assert_ne!(ac, Ordering::Greater, "transitivity: {a:?} <= {b:?} <= {c:?}");
+            }
+            if ab == Ordering::Equal && bc == Ordering::Equal {
+                assert_eq!(ac, Ordering::Equal);
+            }
+            // `PartialEq<T>` compares with the raw float (so NaN != NaN there).
+            assert_eq!(oa == a, a == a, "OrderedFloat == T for {a:?}");
+            assert_eq!(oa == b, a == b);
+            // `Ord::max/min/clamp` follow `cmp`.
+            assert_eq!(Ord::max(oa, ob), if ab == Ordering::Greater { oa } else { ob });
+            assert_eq!(Ord::min(oa, ob), if ab == Ordering::Greater { ob } else { oa });
+            // NotNan: the float's own order, and the two wrappers agree.
+            if let (Ok(na), Ok(nb)) = (NotNan::new(a), NotNan::new(b)) {
+                assert_eq!(na.cmp(&nb), a.partial_cmp(&b).unwrap(), "NotNan cmp for {a:?}, {b:?}");
+                assert_eq!(na.partial_cmp(&nb), Some(na.cmp(&nb)));
+                assert_eq!(na == nb, a == b);
+                assert_eq!(na.cmp(&nb), ab, "NotNan and OrderedFloat disagree for {a:?}, {b:?}");
+                assert_eq!(na == b, a == b, "NotNan == T");
+            } else {
+                assert!(a.is_nan() || b.is_nan());
+            }
+        }
+
+        /// Sorting a vector of `OrderedFloat`s gives the documented order (NaNs last, all equal),
+        /// and `BTreeSet`/`HashSet` agree on which values are distinct.
+        #[hegel::test]
+        fn sorting_and_sets_agree(tc: hegel::TestCase) {
+            let xs: Vec<$t> = tc.draw(generators::vecs($arb()).max_size(12));
+            let mut sorted: Vec<OrderedFloat<$t>> = xs.iter().copied().map(ordered).collect();
+            sorted.sort();
+            for w in sorted.windows(2) {
+                assert_ne!(model_cmp(w[0].0, w[1].0), Ordering::Greater, "sorted {sorted:?} from {xs:?}");
+            }
+            let first_nan = sorted.iter().position(|x| x.is_nan());
+            if let Some(i) = first_nan {
+                assert!(sorted[i..].iter().all(|x| x.is_nan()), "NaNs are not all at the end: {sorted:?}");
+            }
+            let btree: BTreeSet<OrderedFloat<$t>> = sorted.iter().copied().collect();
+            let hash: HashSet<OrderedFloat<$t>> = sorted.iter().copied().collect();
+            // Distinct classes under the model: dedup the sorted list.
+            let mut classes = sorted.clone();
+            classes.dedup_by(|x, y| model_cmp(x.0, y.0) == Ordering::Equal);
+            assert_eq!(btree.len(), classes.len(), "BTreeSet of {xs:?}");
+            assert_eq!(hash.len(), classes.len(), "HashSet of {xs:?}");
+            for x in &sorted {
+                assert!(btree.contains(x) && hash.contains(x), "{x:?} missing from a set built from {xs:?}");
+                // Lookups with an equal-but-different value (the other zero, another NaN).
+                let twin = if x.is_nan() { ordered(-<$t>::NAN) } else if x.0 == 0.0 { ordered(-x.0) } else { *x };
+                assert!(hash.contains(&twin), "HashSet lookup of {twin:?} (equal to {x:?}) failed");
+            }
+            // NotNan sets, when there is no NaN.
+            if first_nan.is_none() {
+                let nn: Vec<NotNan<$t>> = xs.iter().map(|&x| NotNan::new(x).unwrap()).collect();
+                let hash: HashSet<NotNan<$t>> = nn.iter().copied().collect();
+                let btree: BTreeSet<NotNan<$t>> = nn.iter().copied().collect();
+                assert_eq!(hash.len(), btree.len());
+                assert_eq!(btree.len(), classes.len());
+            }
+        }
+
+        /// `Hash` is consistent with `Eq` for both wrappers: equal values (including `-0.0`/`+0.0`
+        /// and NaNs of any sign or payload) hash alike, and — as far as `DefaultHasher` on the
+        /// bits can tell — unequal values hash differently.
+        #[hegel::test]
+        fn hash_is_consistent_with_eq(tc: hegel::TestCase) {
+            let a = tc.draw($arb());
+            let b = tc.draw($arb());
+            let (oa, ob) = (ordered(a), ordered(b));
+            if oa == ob {
+                assert_eq!(hash_of(&oa), hash_of(&ob), "equal OrderedFloats {a:?} and {b:?} hash differently");
+            } else {
+                assert_ne!(hash_of(&oa), hash_of(&ob), "unequal OrderedFloats {a:?} and {b:?} collide");
+            }
+            if let (Ok(na), Ok(nb)) = (NotNan::new(a), NotNan::new(b)) {
+                assert_eq!(hash_of(&na) == hash_of(&nb), na == nb, "NotNan hash/eq for {a:?}, {b:?}");
+                assert_eq!(hash_of(&na), hash_of(&oa), "NotNan and OrderedFloat of {a:?} hash differently");
+            }
+        }
+
+        /// Operators on `NotNan`: `+ - * / %` (by value, by reference, assigning, and with a bare
+        /// float on the right), `Neg`, `Sum`, `Product` and `Pow` equal the float operation when
+        /// that is not NaN, and panic exactly when it is.
+        #[hegel::test]
+        fn not_nan_arithmetic_equals_the_float_or_panics(tc: hegel::TestCase) {
+            quiet_panics();
+            let a = tc.draw($arb());
+            let b = tc.draw($arb());
+            tc.assume(!a.is_nan() && !b.is_nan());
+            let (na, nb) = (NotNan::new(a).unwrap(), NotNan::new(b).unwrap());
+            let ops: [(&str, fn($t, $t) -> $t, fn(NotNan<$t>, NotNan<$t>) -> [NotNan<$t>; 5], fn(NotNan<$t>, $t) -> [$t; 2]); 5] = [
+                ("+", |x, y| x + y,
+                 |x, y| { let mut z = x; z += y; let mut w = x; w += &y; [x + y, &x + &y, x + &y, z, w] },
+                 |x, y| [x + y, &x + y]),
+                ("-", |x, y| x - y,
+                 |x, y| { let mut z = x; z -= y; let mut w = x; w -= &y; [x - y, &x - &y, x - &y, z, w] },
+                 |x, y| [x - y, &x - y]),
+                ("*", |x, y| x * y,
+                 |x, y| { let mut z = x; z *= y; let mut w = x; w *= &y; [x * y, &x * &y, x * &y, z, w] },
+                 |x, y| [x * y, &x * y]),
+                ("/", |x, y| x / y,
+                 |x, y| { let mut z = x; z /= y; let mut w = x; w /= &y; [x / y, &x / &y, x / &y, z, w] },
+                 |x, y| [x / y, &x / y]),
+                ("%", |x, y| x % y,
+                 |x, y| { let mut z = x; z %= y; let mut w = x; w %= &y; [x % y, &x % &y, x % &y, z, w] },
+                 |x, y| [x % y, &x % y]),
+            ];
+            for (name, raw, wrapped, mixed) in ops {
+                let expected = raw(a, b);
+                let got = catch_unwind(AssertUnwindSafe(|| wrapped(na, nb)));
+                if expected.is_nan() {
+                    assert!(got.is_err(), "NotNan {a:?} {name} {b:?} is NaN but did not panic: {got:?}");
+                } else {
+                    let got = got.unwrap_or_else(|_| panic!("NotNan {a:?} {name} {b:?} panicked although {expected:?} is not NaN"));
+                    for g in got {
+                        assert_eq!(g.into_inner().to_bits(), expected.to_bits(), "NotNan {a:?} {name} {b:?}");
+                    }
+                }
+                // With a bare float on the right the result is a bare float: never panics.
+                for g in mixed(na, b) {
+                    assert!(g.to_bits() == expected.to_bits() || (g.is_nan() && expected.is_nan()), "NotNan {a:?} {name} {b:?} (bare rhs)");
+                }
+            }
+            assert_eq!((-na).into_inner().to_bits(), (-a).to_bits());
+            assert_eq!((-&na).into_inner().to_bits(), (-a).to_bits());
+            // Sum and Product over a short list.
+            let xs: Vec<$t> = tc.draw(generators::vecs($arb().filter(|x: &$t| !x.is_nan())).max_size(5));
+            let nn: Vec<NotNan<$t>> = xs.iter().map(|&x| NotNan::new(x).unwrap()).collect();
+            let raw_sum: $t = xs.iter().copied().sum();
+            let raw_product: $t = xs.iter().copied().product();
+            let sum = catch_unwind(AssertUnwindSafe(|| (nn.iter().copied().sum::<NotNan<$t>>(), nn.iter().sum::<NotNan<$t>>())));
+            let product = catch_unwind(AssertUnwindSafe(|| (nn.iter().copied().product::<NotNan<$t>>(), nn.iter().product::<NotNan<$t>>())));
+            match sum {
+                Err(_) => assert!(raw_sum.is_nan(), "sum of {xs:?} panicked, float sum is {raw_sum:?}"),
+                Ok((s, s2)) => { assert!(!raw_sum.is_nan(), "sum of {xs:?} is NaN but did not panic"); assert_eq!(s.into_inner().to_bits(), raw_sum.to_bits()); assert_eq!(s2, s); }
+            }
+            match product {
+                Err(_) => assert!(raw_product.is_nan(), "product of {xs:?} panicked, float product is {raw_product:?}"),
+                Ok((p, p2)) => { assert!(!raw_product.is_nan(), "product of {xs:?} is NaN but did not panic"); assert_eq!(p.into_inner().to_bits(), raw_product.to_bits()); assert_eq!(p2, p); }
+            }
+            // Pow with an integer and with a float exponent.
+            let n = tc.draw(generators::integers::<i8>());
+            let expected = <$t>::pow(a, n);
+            match catch_unwind(AssertUnwindSafe(|| (na.pow(n), (&na).pow(&n)))) {
+                Err(_) => assert!(expected.is_nan(), "{a:?}.pow({n}) panicked, float gives {expected:?}"),
+                Ok((p, q)) => { assert!(!expected.is_nan()); assert_eq!(p.into_inner().to_bits(), expected.to_bits()); assert_eq!(q, p); }
+            }
+            let expected = <$t>::pow(a, b);
+            match catch_unwind(AssertUnwindSafe(|| (na.pow(b), na.pow(nb)))) {
+                Err(_) => assert!(expected.is_nan(), "{a:?}.pow({b:?}) panicked, float gives {expected:?}"),
+                Ok((p, q)) => { assert!(!expected.is_nan(), "{a:?}.pow({b:?}) is NaN but did not panic"); assert_eq!(p.into_inner().to_bits(), expected.to_bits()); assert_eq!(q, p); }
+            }
+            // OrderedFloat arithmetic is the plain float's, NaN and all.
+            let (oa, ob) = (ordered(a), ordered(b));
+            assert_eq!((oa + ob).0.to_bits(), (a + b).to_bits());
+            assert_eq!((oa - ob).0.to_bits(), (a - b).to_bits());
+            assert_eq!((oa * ob).0.to_bits(), (a * b).to_bits());
+            assert_eq!((oa / ob).0.to_bits(), (a / b).to_bits());
+            assert_eq!((oa % ob).0.to_bits(), (a % b).to_bits());
+            assert_eq!((oa + b).0.to_bits(), (a + b).to_bits());
+            assert_eq!(oa.pow(n).0.to_bits(), <$t>::pow(a, n).to_bits());
+            assert_eq!(oa.pow(ob).0.to_bits(), <$t>::pow(a, b).to_bits());
+        }
+
+        /// The `Real` and `Signed` methods of `NotNan` (all but `fract` and `mul_add`, which have
+        /// their own test) never produce a `NotNan` holding a NaN: each equals the float's result
+        /// when that is not NaN and panics when it is.
+        #[hegel::test]
+        fn not_nan_real_methods_equal_the_float_or_panic(tc: hegel::TestCase) {
+            quiet_panics();
+            let a = tc.draw($arb());
+            let b = tc.draw($arb());
+            let c = tc.draw($arb());
+            tc.assume(!a.is_nan() && !b.is_nan() && !c.is_nan());
+            let (na, nb, nc) = (NotNan::new(a).unwrap(), NotNan::new(b).unwrap(), NotNan::new(c).unwrap());
+            let n = tc.draw(generators::integers::<i32>().min_value(-40).max_value(40));
+            let unary: Vec<(&str, fn($t) -> $t, fn(NotNan<$t>) -> NotNan<$t>)> = vec![
+                ("floor", |x| Real::floor(x), |x| Real::floor(x)),
+                ("ceil", |x| Real::ceil(x), |x| Real::ceil(x)),
+                ("round", |x| Real::round(x), |x| Real::round(x)),
+                ("trunc", |x| Real::trunc(x), |x| Real::trunc(x)),
+                ("abs", |x| Real::abs(x), |x| Real::abs(x)),
+                ("signum", |x| Real::signum(x), |x| Real::signum(x)),
+                ("recip", |x| Real::recip(x), |x| Real::recip(x)),
+                ("sqrt", |x| Real::sqrt(x), |x| Real::sqrt(x)),
+                ("exp", |x| Real::exp(x), |x| Real::exp(x)),
+                ("exp2", |x| Real::exp2(x), |x| Real::exp2(x)),
+                ("ln", |x| Real::ln(x), |x| Real::ln(x)),
+                ("log2", |x| Real::log2(x), |x| Real::log2(x)),
+                ("log10", |x| Real::log10(x), |x| Real::log10(x)),
+                ("to_degrees", |x| Real::to_degrees(x), |x| Real::to_degrees(x)),
+                ("to_radians", |x| Real::to_radians(x), |x| Real::to_radians(x)),
+                ("cbrt", |x| Real::cbrt(x), |x| Real::cbrt(x)),
+                ("sin", |x| Real::sin(x), |x| Real::sin(x)),
+                ("cos", |x| Real::cos(x), |x| Real::cos(x)),
+                ("tan", |x| Real::tan(x), |x| Real::tan(x)),
+                ("asin", |x| Real::asin(x), |x| Real::asin(x)),
+                ("acos", |x| Real::acos(x), |x| Real::acos(x)),
+                ("atan", |x| Real::atan(x), |x| Real::atan(x)),
+                ("exp_m1", |x| Real::exp_m1(x), |x| Real::exp_m1(x)),
+                ("ln_1p", |x| Real::ln_1p(x), |x| Real::ln_1p(x)),
+                ("sinh", |x| Real::sinh(x), |x| Real::sinh(x)),
+                ("cosh", |x| Real::cosh(x), |x| Real::cosh(x)),
+                ("tanh", |x| Real::tanh(x), |x| Real::tanh(x)),
+                ("asinh", |x| Real::asinh(x), |x| Real::asinh(x)),
+                ("acosh", |x| Real::acosh(x), |x| Real::acosh(x)),
+                ("atanh", |x| Real::atanh(x), |x| Real::atanh(x)),
+                ("Signed::abs", |x| Signed::abs(&x), |x| Signed::abs(&x)),
+                ("Signed::signum", |x| Signed::signum(&x), |x| Signed::signum(&x)),
+            ];
+            for (name, raw, wrapped) in unary {
+                check_not_nan(&format!("{name}({a:?})"), raw(a), catch_unwind(AssertUnwindSafe(|| wrapped(na))));
+            }
+            let binary: Vec<(&str, fn($t, $t) -> $t, fn(NotNan<$t>, NotNan<$t>) -> NotNan<$t>)> = vec![
+                ("powf", |x, y| Real::powf(x, y), |x, y| Real::powf(x, y)),
+                ("log", |x, y| Real::log(x, y), |x, y| Real::log(x, y)),
+                ("max", |x, y| Real::max(x, y), |x, y| Real::max(x, y)),
+                ("min", |x, y| Real::min(x, y), |x, y| Real::min(x, y)),
+                ("abs_sub", |x, y| Real::abs_sub(x, y), |x, y| Real::abs_sub(x, y)),
+                ("hypot", |x, y| Real::hypot(x, y), |x, y| Real::hypot(x, y)),
+                ("atan2", |x, y| Real::atan2(x, y), |x, y| Real::atan2(x, y)),
+                ("Signed::abs_sub", |x, y| Signed::abs_sub(&x, &y), |x, y| Signed::abs_sub(&x, &y)),
+            ];
+            for (name, raw, wrapped) in binary {
+                check_not_nan(&format!("{name}({a:?}, {b:?})"), raw(a, b), catch_unwind(AssertUnwindSafe(|| wrapped(na, nb))));
+            }
+            check_not_nan(&format!("powi({a:?}, {n})"), Real::powi(a, n), catch_unwind(AssertUnwindSafe(|| Real::powi(na, n))));
+            let (s, co) = Real::sin_cos(a);
+            match catch_unwind(AssertUnwindSafe(|| Real::sin_cos(na))) {
+                Err(_) => assert!(s.is_nan() || co.is_nan(), "sin_cos({a:?}) panicked, float gives ({s:?}, {co:?})"),
+                Ok((ns, nco)) => { assert_eq!(ns.into_inner().to_bits(), s.to_bits()); assert_eq!(nco.into_inner().to_bits(), co.to_bits()); }
+            }
+            // The predicates are the float's.
+            assert_eq!(Real::is_sign_positive(na), a.is_sign_positive());
+            assert_eq!(Real::is_sign_negative(na), a.is_sign_negative());
+            assert_eq!(Signed::is_positive(&na), Signed::is_positive(&a));
+            assert_eq!(Signed::is_negative(&na), Signed::is_negative(&a));
+        }
+
+        /// `Real::fract` and `Real::mul_add` on `NotNan`, like the other `Real` methods, must
+        /// equal the float's result or panic when it is NaN — never return a `NotNan` holding
+        /// NaN (`fract(±inf)` and `mul_add` with a `0 · inf` product are NaN). KNOWN FAILURE
+        /// ordered-float/1.
+        #[hegel::test]
+        fn not_nan_fract_and_mul_add_never_hold_nan(tc: hegel::TestCase) {
+            quiet_panics();
+            let a = tc.draw($arb());
+            let b = tc.draw($arb());
+            let c = tc.draw($arb());
+            tc.assume(!a.is_nan() && !b.is_nan() && !c.is_nan());
+            let (na, nb, nc) = (NotNan::new(a).unwrap(), NotNan::new(b).unwrap(), NotNan::new(c).unwrap());
+            check_not_nan(&format!("fract({a:?})"), Real::fract(a), catch_unwind(AssertUnwindSafe(|| Real::fract(na))));
+            check_not_nan(&format!("mul_add({a:?}, {b:?}, {c:?})"), Real::mul_add(a, b, c), catch_unwind(AssertUnwindSafe(|| Real::mul_add(na, nb, nc))));
+        }
+
+        /// Constructors, conversions, parsing and formatting are transparent: `NotNan::new`,
+        /// `TryFrom`, `FromStr`, `from_str_radix`, `NumCast`, `FromPrimitive` reject exactly NaN
+        /// (with the documented error), `ToPrimitive`/`Display`/`Debug`/`LowerExp`/`UpperExp`/
+        /// `Deref`/`AsRef`/`into_inner` give the float's own answers, `Bounded`/`Zero`/`One` are
+        /// the float's, and every `FloatCore` method of `OrderedFloat` is the float's.
+        #[hegel::test]
+        fn conversions_parsing_and_formatting_are_transparent(tc: hegel::TestCase) {
+            let a = tc.draw($arb());
+            let oa = ordered(a);
+            // Construction.
+            assert_eq!(NotNan::new(a).is_ok(), !a.is_nan());
+            assert_eq!(NotNan::new(a).err(), if a.is_nan() { Some(FloatIsNan) } else { None });
+            assert_eq!(NotNan::<$t>::try_from(a).is_ok(), !a.is_nan());
+            assert_eq!(<NotNan<$t> as NumCast>::from(a).is_some(), !a.is_nan());
+            assert_eq!(NotNan::<$t>::from_f64(a as f64).is_some(), !a.is_nan());
+            assert_eq!(<OrderedFloat<$t> as From<$t>>::from(a), oa);
+            assert_eq!(<OrderedFloat<$t> as NumCast>::from(a).unwrap().is_nan(), a.is_nan());
+            // Accessors.
+            assert_eq!(oa.into_inner().to_bits(), a.to_bits());
+            assert_eq!((*oa).to_bits(), a.to_bits());
+            assert_eq!(oa.as_ref().to_bits(), a.to_bits());
+            assert_eq!(<$t as From<OrderedFloat<$t>>>::from(oa).to_bits(), a.to_bits());
+            if let Ok(na) = NotNan::new(a) {
+                assert_eq!(na.into_inner().to_bits(), a.to_bits());
+                assert_eq!((*na).to_bits(), a.to_bits());
+                assert_eq!(na.as_ref().to_bits(), a.to_bits());
+                assert_eq!(<$t as From<NotNan<$t>>>::from(na).to_bits(), a.to_bits());
+                assert_eq!(na.to_i64(), a.to_i64());
+                assert_eq!(na.to_u8(), a.to_u8());
+                assert_eq!(na.to_f32().map(f32::to_bits), a.to_f32().map(f32::to_bits));
+                assert_eq!(na.to_f64().map(f64::to_bits), a.to_f64().map(f64::to_bits));
+                assert_eq!(<NotNan<$t> as NumCast>::from(a).unwrap(), na);
+                // Formatting round-trips through both parsers.
+                for s in [format!("{na}"), format!("{na:?}")] {
+                    let back: NotNan<$t> = s.parse().unwrap_or_else(|e| panic!("{s:?} (from {a:?}) does not parse back: {e:?}"));
+                    assert_eq!(back, na, "{s:?} parsed back to {back:?}, not {a:?}");
+                    assert_eq!(<NotNan<$t> as num_traits::Num>::from_str_radix(&s, 10).ok(), Some(na), "from_str_radix({s:?})");
+                }
+                assert_eq!(format!("{na}"), format!("{a}"));
+                assert_eq!(format!("{na:?}"), format!("{a:?}"));
+            }
+            assert_eq!(oa.to_i64(), a.to_i64());
+            assert_eq!(oa.to_u64(), a.to_u64());
+            assert_eq!(oa.to_f64().map(f64::to_bits), a.to_f64().map(f64::to_bits));
+            for s in [format!("{oa}"), format!("{oa:?}"), format!("{oa:e}"), format!("{oa:E}")] {
+                let back: OrderedFloat<$t> = s.parse().unwrap_or_else(|e| panic!("{s:?} (from {a:?}) does not parse back: {e:?}"));
+                assert_eq!(back, oa, "{s:?} parsed back to {back:?}, not {a:?}");
+            }
+            assert_eq!(format!("{oa}"), format!("{a}"));
+            assert_eq!(format!("{oa:?}"), format!("{a:?}"));
+            assert_eq!(format!("{oa:e}"), format!("{a:e}"));
+            assert_eq!(format!("{oa:E}"), format!("{a:E}"));
+            // Parsing NaN spellings: OrderedFloat takes them, NotNan reports IsNaN, garbage is a
+            // parse error for both.
+            for s in ["NaN", "nan", "-NaN"] {
+                assert!(s.parse::<OrderedFloat<$t>>().unwrap().is_nan());
+                assert!(matches!(s.parse::<NotNan<$t>>(), Err(ParseNotNanError::IsNaN)), "{s:?} as NotNan");
+            }
+            let garbage = format!("{a}x");
+            assert!(garbage.parse::<OrderedFloat<$t>>().is_err());
+            assert!(matches!(garbage.parse::<NotNan<$t>>(), Err(ParseNotNanError::ParseFloatError(_))));
+            // Constants.
+            assert_eq!(<OrderedFloat<$t> as Bounded>::min_value().0, <$t>::MIN);
+            assert_eq!(<OrderedFloat<$t> as Bounded>::max_value().0, <$t>::MAX);
+            assert_eq!(<NotNan<$t> as Bounded>::min_value().into_inner(), <$t>::MIN);
+            assert_eq!(<NotNan<$t> as Bounded>::max_value().into_inner(), <$t>::MAX);
+            assert_eq!(<OrderedFloat<$t> as Zero>::zero().0.to_bits(), (0.0 as $t).to_bits());
+            assert_eq!(<NotNan<$t> as One>::one().into_inner(), 1.0);
+            assert_eq!(oa.is_zero(), a == 0.0);
+            assert_eq!(oa.is_one(), a == 1.0);
+            // FloatCore on OrderedFloat is the float's.
+            assert_eq!(FloatCore::classify(oa), FloatCore::classify(a));
+            assert_eq!(FloatCore::is_nan(oa), a.is_nan());
+            assert_eq!(FloatCore::is_finite(oa), a.is_finite());
+            assert_eq!(FloatCore::is_normal(oa), a.is_normal());
+            assert_eq!(FloatCore::is_sign_negative(oa), a.is_sign_negative());
+            assert_eq!(FloatCore::integer_decode(oa), FloatCore::integer_decode(a));
+            for (name, raw, wrapped) in [
+                ("floor", FloatCore::floor as fn($t) -> $t, FloatCore::floor as fn(OrderedFloat<$t>) -> OrderedFloat<$t>),
+                ("ceil", FloatCore::ceil, FloatCore::ceil),
+                ("round", FloatCore::round, FloatCore::round),
+                ("trunc", FloatCore::trunc, FloatCore::trunc),
+                ("fract", FloatCore::fract, FloatCore::fract),
+                ("abs", FloatCore::abs, FloatCore::abs),
+                ("signum", FloatCore::signum, FloatCore::signum),
+                ("recip", FloatCore::recip, FloatCore::recip),
+                ("to_degrees", FloatCore::to_degrees, FloatCore::to_degrees),
+                ("to_radians", FloatCore::to_radians, FloatCore::to_radians),
+            ] {
+                assert_eq!(wrapped(oa).0.to_bits(), raw(a).to_bits(), "FloatCore::{name}({a:?}) on OrderedFloat");
+            }
+            assert_eq!((-oa).0.to_bits(), (-a).to_bits());
+            assert_eq!(Signed::abs(&oa).0.to_bits(), a.abs().to_bits());
+            assert_eq!(<OrderedFloat<$t> as FloatCore>::nan().is_nan(), true);
+        }
+    };
+}
+
+/// `got` is the `NotNan` result of an operation whose float result is `expected`: it must panic
+/// exactly when `expected` is NaN, and otherwise hold `expected`. A `NotNan` holding a NaN is the
+/// worst outcome (`Ord::cmp` on it panics, `Hash`/`Eq` are no longer consistent).
+fn check_not_nan<T: FloatCore + std::fmt::Debug + Copy>(what: &str, expected: T, got: std::thread::Result<NotNan<T>>)
+where
+    NotNan<T>: std::fmt::Debug,
+{
+    match got {
+        Err(_) => assert!(expected.is_nan(), "{what} panicked although the float result is {expected:?}"),
+        Ok(v) => {
+            assert!(
+                !v.into_inner().is_nan(),
+                "{what} returned a NotNan holding NaN (the float result is {expected:?})"
+            );
+            assert!(!expected.is_nan(), "{what}: float result is NaN but NotNan returned {v:?} instead of panicking");
+            assert_eq!(v.into_inner().partial_cmp(&expected), Some(Ordering::Equal), "{what}: NotNan gives {v:?}, float gives {expected:?}");
+        }
+    }
+}
+
+mod f64_ {
+    use super::*;
+    properties!(f64, arb_f64);
+}
+
+mod f32_ {
+    use super::*;
+    properties!(f32, arb_f32);
+}
+
+/// Conversions between the two widths: `From<NotNan<f32>>`/`From<OrderedFloat<f32>>` are exact,
+/// `NotNan<f64>::as_f32` rounds like `as f32` (documented: ties to even, infinity on overflow)
+/// and never produces NaN from a non-NaN, and the integer `From` impls are exact.
+#[hegel::test]
+fn widening_and_narrowing(tc: hegel::TestCase) {
+    let x = tc.draw(arb_f32());
+    let y = tc.draw(arb_f64());
+    assert_eq!(<OrderedFloat<f64> as From<OrderedFloat<f32>>>::from(OrderedFloat(x)).0.to_bits(), (x as f64).to_bits());
+    if let Ok(nx) = NotNan::new(x) {
+        assert_eq!(<NotNan<f64> as From<NotNan<f32>>>::from(nx).into_inner().to_bits(), (x as f64).to_bits());
+    }
+    if let Ok(ny) = NotNan::new(y) {
+        let narrow = ny.as_f32();
+        assert!(!narrow.into_inner().is_nan(), "as_f32 of {y:?} gave NaN");
+        assert_eq!(narrow.into_inner().to_bits(), (y as f32).to_bits(), "as_f32 of {y:?}");
+    }
+    let i = tc.draw(generators::integers::<i32>());
+    assert_eq!(<OrderedFloat<f64> as From<i32>>::from(i).0, i as f64);
+    assert_eq!(<NotNan<f64> as From<i32>>::from(i).into_inner(), i as f64);
+    assert_eq!(<OrderedFloat<f32> as From<i16>>::from(i as i16).0, (i as i16) as f32);
+    assert_eq!(<NotNan<f32> as From<u16>>::from(i as u16).into_inner(), (i as u16) as f32);
+    assert_eq!(<OrderedFloat<f64> as From<u32>>::from(i as u32).0, (i as u32) as f64);
+    assert_eq!(NotNan::<f64>::from_i64(i as i64).unwrap().into_inner(), i as f64);
+    assert_eq!(<OrderedFloat<f32> as From<bool>>::from(i % 2 == 0).0, if i % 2 == 0 { 1.0 } else { 0.0 });
+}
