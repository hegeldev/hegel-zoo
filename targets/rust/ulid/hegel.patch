+    // -----------------------------------------------------------------
+    // Property-based tests (hegel)
+    // -----------------------------------------------------------------
+
+    use hegel::generators;
+
+    /// For any representable millisecond instant (48 bits), a Ulid created
+    /// at that instant reports exactly that instant back through both
+    /// timestamp_ms() and datetime(), regardless of the random bits.
+    #[hegel::test]
+    fn prop_datetime_roundtrip(tc: hegel::TestCase) {
+        let ts = tc.draw(generators::integers::<u64>().max_value(bitmask!(Ulid::TIME_BITS)));
+        // StepRng is a counter: the drawn value is the random bits, shrinkable
+        let value = tc.draw(generators::integers::<u64>());
+        let mut source = crate::StepRng::new(value, 1);
+        let dt = SystemTime::UNIX_EPOCH + Duration::from_millis(ts);
+        let ulid = Ulid::from_datetime_with_source(dt, &mut source);
+        assert_eq!(ulid.timestamp_ms(), ts);
+        assert_eq!(ulid.datetime(), dt);
+    }
+
     #[test]
