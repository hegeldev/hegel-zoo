--- a/src/impl_cmp.rs
+++ b/src/impl_cmp.rs
@@ -552,4 +552,79 @@ mod test {
             }
         }
     }
+
+    // Property-based tests (hegel)
+    mod hegel_props {
+        use super::*;
+        use hegel::generators::{self, Generator};
+        use num_rational::BigRational;
+
+        /// Exact value of a BigDecimal as a rational number (independent oracle).
+        fn rational_of(d: &BigDecimal) -> BigRational {
+            let (int_val, scale) = d.as_bigint_and_exponent();
+            if scale >= 0 {
+                BigRational::new(int_val, Pow::pow(BigInt::from(10), scale as u64))
+            } else {
+                let numer = int_val * Pow::pow(BigInt::from(10), scale.unsigned_abs());
+                BigRational::new(numer, BigInt::one())
+            }
+        }
+
+        /// Arbitrary BigDecimal. Scale is bounded to ±5000 so the exact
+        /// rational oracle (denominator 10^scale) stays cheap to build;
+        /// the ordering code itself is exercised with large scale
+        /// differences within that range.
+        #[hegel::composite]
+        fn bigdecimals(tc: &hegel::TestCase) -> BigDecimal {
+            let int_val = tc.draw(generators::integers::<i128>());
+            let scale = tc.draw(generators::integers::<i64>().min_value(-5000).max_value(5000));
+            BigDecimal::new(int_val.into(), scale)
+        }
+
+        /// Property: `Ord::cmp` orders decimals the same way exact
+        /// rational arithmetic does.
+        /// Evidence: Ord doc-comment example ("Complete ordering
+        /// implementation for BigDecimal") — comparisons are by numeric
+        /// value, independent of representation.
+        #[hegel::test]
+        fn cmp_agrees_with_rational_oracle(tc: hegel::TestCase) {
+            let a = tc.draw((bigdecimals()).print_as_debug());
+            let b = tc.draw((bigdecimals()).print_as_debug());
+            assert_eq!(a.cmp(&b), rational_of(&a).cmp(&rational_of(&b)));
+        }
+
+        /// Property: `PartialEq` (a separate implementation from Ord)
+        /// agrees with exact rational equality.
+        /// Evidence: unit tests `test_eq` / `test_hash_equal` compare
+        /// different representations of the same value as equal.
+        /// Half of the generated pairs are made value-equal (scale
+        /// padding) so equality is exercised, not just inequality.
+        #[hegel::test]
+        fn eq_agrees_with_rational_oracle(tc: hegel::TestCase) {
+            let a = tc.draw((bigdecimals()).print_as_debug());
+            let b = if tc.draw(generators::booleans()) {
+                let extra = tc.draw(generators::integers::<i64>().min_value(0).max_value(100));
+                a.with_scale(a.fractional_digit_count() + extra)
+            } else {
+                tc.draw((bigdecimals()).print_as_debug())
+            };
+            assert_eq!(a == b, rational_of(&a) == rational_of(&b));
+        }
+
+        /// Property: comparison of float-derived decimals matches f64's
+        /// own ordering (floats convert exactly via from_f64).
+        /// Ported from the (property_tests-gated) proptest `cmp_matches_f64`.
+        #[hegel::test(test_cases = 500)]
+        fn cmp_matches_f64(tc: hegel::TestCase) {
+            let float_gen = || generators::floats::<f64>().allow_nan(false).allow_infinity(false);
+            let f = tc.draw(float_gen());
+            let g = tc.draw(float_gen());
+
+            let a = BigDecimal::from_f64(f).unwrap();
+            let b = BigDecimal::from_f64(g).unwrap();
+
+            let expected = PartialOrd::partial_cmp(&f, &g).unwrap();
+            assert_eq!(expected, a.cmp(&b));
+        }
+    }
 }
