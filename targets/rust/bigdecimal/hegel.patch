diff --git a/src/lib.tests.rs b/src/lib.tests.rs
index 24a633e..b19c03a 100644
--- a/src/lib.tests.rs
+++ b/src/lib.tests.rs
@@ -137,3 +137,500 @@ mod order_of_magnitude {
     impl_case!(case_n100d0012e1: "-100.0012e1" => 3);
     impl_case!(case_16651567373773d553089: "16651567373773.553089" => 13);
 }
+
+// Property-based tests (hegel)
+mod hegel_props {
+    use super::*;
+    use hegel::generators::{self, Generator};
+    use num_rational::BigRational;
+    use stdlib::DefaultHasher;
+
+    /// Generate an arbitrary BigDecimal with full-range i128 coefficient
+    /// and scale bounded by `max_scale_mag`.
+    ///
+    /// Scale is bounded because several operations (addition, subtraction,
+    /// comparison against an exact rational, `is_integer`) must materialize
+    /// roughly `|scale|` decimal digits to align values; unbounded i64
+    /// scales make the *test* run out of memory, not the library.
+    #[hegel::composite]
+    fn bigdecimals(tc: &hegel::TestCase, max_scale_mag: i64) -> BigDecimal {
+        let int_val = tc.draw(generators::integers::<i128>());
+        let scale = tc.draw(
+            generators::integers::<i64>()
+                .min_value(-max_scale_mag)
+                .max_value(max_scale_mag),
+        );
+        BigDecimal::new(int_val.into(), scale)
+    }
+
+    /// Exact value of a BigDecimal as a rational number (independent oracle).
+    fn rational_of(d: &BigDecimal) -> BigRational {
+        let (int_val, scale) = d.as_bigint_and_exponent();
+        if scale >= 0 {
+            BigRational::new(int_val, Pow::pow(BigInt::from(10), scale as u64))
+        } else {
+            let numer = int_val * Pow::pow(BigInt::from(10), scale.unsigned_abs());
+            BigRational::new(numer, BigInt::one())
+        }
+    }
+
+    /// Property: `normalized()` does not change the value of the decimal.
+    /// Evidence: doc-comment on `normalized` ("Return a new BigDecimal after
+    /// removing trailing zeros") and the `normalize` unit tests, all of which
+    /// preserve the numeric value.
+    ///
+    /// The generator deliberately emphasizes the two ingredients of the
+    /// boundary case: coefficients with trailing zeros (multiply by a
+    /// small power of ten) and scales at/near i64::MIN (normalizing
+    /// *subtracts* the trailing-zero count from the scale).
+    #[hegel::test]
+    fn normalized_preserves_value(tc: hegel::TestCase) {
+        let coefficient = tc.draw(generators::integers::<i128>());
+        let trailing_zeros = tc.draw(generators::integers::<u32>().max_value(3));
+        let scale = tc.draw(hegel::one_of!(
+            generators::integers::<i64>(),
+            generators::integers::<i64>().max_value(i64::MIN.wrapping_add(4)),
+        ));
+        let int_val = BigInt::from(coefficient) * Pow::pow(BigInt::from(10), trailing_zeros as u64);
+        let n = BigDecimal::new(int_val, scale);
+        assert_eq!(n.normalized(), n);
+    }
+
+    /// Property: `normalized()` produces the canonical representation:
+    /// no trailing zeros in the coefficient (zero becomes 0e0), so
+    /// normalizing twice gives the identical representation.
+    /// Evidence: `normalize` unit tests assert exact (int_val, scale) pairs
+    /// with trailing zeros stripped, e.g. (10, 2) => (1, 1), (0, -3) => (0, 0).
+    #[hegel::test]
+    fn normalized_is_canonical(tc: hegel::TestCase) {
+        let int_val = tc.draw(generators::integers::<i128>());
+        let scale = tc.draw(generators::integers::<i64>());
+        let n = BigDecimal::new(int_val.into(), scale).normalized();
+
+        if n.is_zero() {
+            assert_eq!(n.as_bigint_and_exponent(), (BigInt::zero(), 0));
+        } else {
+            let (int_val, _) = n.as_bigint_and_exponent();
+            assert!(!(int_val % BigInt::from(10)).is_zero(), "trailing zero left by normalized()");
+            assert_eq!(n.normalized().as_bigint_and_exponent(), n.as_bigint_and_exponent());
+        }
+    }
+
+    /// Property: addition is commutative: a + b == b + a.
+    /// Evidence: BigDecimal models exact decimal arithmetic (README:
+    /// "Allows storing any real number to arbitrary precision; avoids
+    /// storing errors of binary floating-point").
+    #[hegel::test]
+    fn addition_commutes(tc: hegel::TestCase) {
+        let a = tc.draw((bigdecimals(1000)).print_as_debug());
+        let b = tc.draw((bigdecimals(1000)).print_as_debug());
+        assert_eq!(&a + &b, &b + &a);
+    }
+
+    /// Property: subtraction undoes addition exactly: (a + b) - b == a.
+    /// Evidence: addition/subtraction of decimals is exact (no rounding
+    /// occurs in add/sub; scales are aligned), see impl_ops_add/impl_ops_sub.
+    #[hegel::test]
+    fn add_then_sub_roundtrips(tc: hegel::TestCase) {
+        let a = tc.draw((bigdecimals(1000)).print_as_debug());
+        let b = tc.draw((bigdecimals(1000)).print_as_debug());
+        assert_eq!((&a + &b) - &b, a);
+    }
+
+    /// Property: multiplication agrees with exact rational arithmetic.
+    /// Evidence: multiplication is documented/implemented as exact
+    /// (scales add, coefficients multiply — impl_ops_mul.rs).
+    #[hegel::test]
+    fn multiplication_agrees_with_rational_oracle(tc: hegel::TestCase) {
+        let a = tc.draw((bigdecimals(1000)).print_as_debug());
+        let b = tc.draw((bigdecimals(1000)).print_as_debug());
+        let product = &a * &b;
+        assert_eq!(rational_of(&product), rational_of(&a) * rational_of(&b));
+    }
+
+    /// Property: `square()` equals multiplying the value by itself.
+    /// Evidence: doc-comment on `square`: "No rounding or truncating of
+    /// digits; this is the full result of the squaring operation", plus the
+    /// existing proptest `square` (which only exercised f32-derived values).
+    /// Scale is limited to i64::MAX/2 because the result's scale (2×scale)
+    /// must itself fit in an i64.
+    #[hegel::test]
+    fn square_equals_self_times_self(tc: hegel::TestCase) {
+        let int_val = tc.draw(generators::integers::<i128>());
+        let scale = tc.draw(
+            generators::integers::<i64>()
+                .min_value(i64::MIN / 2)
+                .max_value(i64::MAX / 2),
+        );
+        let n = BigDecimal::new(int_val.into(), scale);
+        assert_eq!(n.square(), &n * &n);
+    }
+
+    /// Property: `cube()` equals multiplying the value by itself twice.
+    /// Evidence: doc-comment on `cube` ("full result of the cubing
+    /// operation") and the `test_cube` unit tests.
+    /// Scale is limited to i64::MAX/3 because the result's scale (3×scale)
+    /// must itself fit in an i64.
+    #[hegel::test]
+    fn cube_equals_self_times_self_times_self(tc: hegel::TestCase) {
+        let int_val = tc.draw(generators::integers::<i128>());
+        let scale = tc.draw(
+            generators::integers::<i64>()
+                .min_value(i64::MIN / 3)
+                .max_value(i64::MAX / 3),
+        );
+        let n = BigDecimal::new(int_val.into(), scale);
+        assert_eq!(n.cube(), &n * &n * &n);
+    }
+
+    /// Property: `half()` is the inverse of `double()` (and vice versa).
+    /// Evidence: doc-comments "Multiply decimal by 2 (efficiently)" /
+    /// "Divide decimal by 2 (efficiently)". Scale is kept below i64::MAX
+    /// because halving an odd coefficient increases the scale by one
+    /// (documented in `half`), which must not overflow.
+    #[hegel::test]
+    fn double_and_half_are_inverses(tc: hegel::TestCase) {
+        let int_val = tc.draw(generators::integers::<i128>());
+        let scale = tc.draw(generators::integers::<i64>().max_value(i64::MAX - 1));
+        let n = BigDecimal::new(int_val.into(), scale);
+        assert_eq!(n.double().half(), n);
+        assert_eq!(n.half().double(), n);
+    }
+
+    /// Property: `is_integer()` is true exactly when truncating all
+    /// fractional digits does not change the value.
+    /// Evidence: doc-comment "Return true if this number has zero
+    /// fractional part (is equal to an integer)"; RoundingMode::Down
+    /// is documented as truncation ("Always round towards zero").
+    #[hegel::test]
+    fn is_integer_agrees_with_truncation(tc: hegel::TestCase) {
+        let n = tc.draw((bigdecimals(10_000)).print_as_debug());
+        let truncated = n.with_scale_round(0, RoundingMode::Down);
+        assert_eq!(n.is_integer(), truncated == n);
+    }
+
+    /// Property: sqrt of a negative number is None.
+    /// Evidence: doc-comment on `sqrt`: "If the value is < 0, None is returned".
+    #[hegel::test]
+    fn sqrt_of_negative_is_none(tc: hegel::TestCase) {
+        let int_val = tc.draw(generators::integers::<i128>().max_value(-1));
+        let scale = tc.draw(generators::integers::<i64>());
+        let n = BigDecimal::new(int_val.into(), scale);
+        assert_eq!(n.sqrt(), None);
+    }
+
+    /// Property: sqrt(x)² is within the documented precision of x.
+    /// Evidence: `sqrt` docs say it computes with default precision
+    /// (100 significant digits). A half-ulp error on the 100-digit root
+    /// yields a relative error in the square well below 1e-95.
+    #[hegel::test]
+    fn sqrt_squared_is_close_to_original(tc: hegel::TestCase) {
+        let int_val = tc.draw(generators::integers::<u128>());
+        let scale = tc.draw(generators::integers::<i64>().min_value(-1000).max_value(1000));
+        let n = BigDecimal::from_biguint(int_val.into(), scale);
+
+        let root = n.sqrt().expect("sqrt of non-negative value");
+        let diff = (root.square() - &n).abs();
+        let tolerance = &n * BigDecimal::new(1.into(), 95); // n * 1e-95
+        assert!(diff <= tolerance, "sqrt({})² = off by {}", n, diff);
+    }
+
+    /// Property: values that are equal must have equal hashes.
+    /// Evidence: the Hash impl (lib.rs) canonicalizes trailing zeros, and
+    /// unit tests test_hash_equal/test_hash_equal_scale check specific
+    /// pairs; padding the scale with `with_scale` preserves the value.
+    #[hegel::test]
+    fn equal_values_have_equal_hashes(tc: hegel::TestCase) {
+        use stdlib::hash::{Hash, Hasher};
+
+        fn hash_of(obj: &BigDecimal) -> u64 {
+            let mut hasher = DefaultHasher::new();
+            obj.hash(&mut hasher);
+            hasher.finish()
+        }
+
+        let n = tc.draw((bigdecimals(1000)).print_as_debug());
+        let extra_scale = tc.draw(generators::integers::<i64>().min_value(0).max_value(100));
+        let padded = n.with_scale(n.fractional_digit_count() + extra_scale);
+
+        assert_eq!(padded, n);
+        assert_eq!(hash_of(&padded), hash_of(&n), "{} vs {}", n, padded);
+    }
+
+    // The four tests below are hegel ports of the proptest suite in
+    // lib.tests.property-tests.rs (gated behind `--cfg property_tests`).
+    // The original tests are macro-instantiated for every primitive
+    // type; i128 subsumes the smaller signed/unsigned integers, and f64
+    // covers the float variant.
+
+    /// Property: all `+` overloads (val/ref/assign, either side) agree.
+    /// Ported from proptest `add_ref_*`.
+    #[hegel::test]
+    fn add_overloads_agree(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<i128>());
+        let m = tc.draw(generators::integers::<i128>());
+        let e = tc.draw(generators::integers::<i8>());
+        let d = BigDecimal::new(m.into(), e as i64);
+
+        let sum = n + &d;
+        assert_eq!(sum, &d + n);
+        assert_eq!(sum, d.clone() + n);
+
+        let mut s = d;
+        s += n;
+        assert_eq!(sum, s);
+    }
+
+    /// Property: subtraction overloads are consistent and anti-commute:
+    /// n - d == -(d - n). Ported from proptest `sub_*`.
+    #[hegel::test]
+    fn sub_overloads_agree(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<i128>());
+        let m = tc.draw(generators::integers::<i128>());
+        let e = tc.draw(generators::integers::<i8>());
+        let d = BigDecimal::new(m.into(), e as i64);
+
+        let diff_n_d = n - &d;
+        let diff_d_n = d.clone() - n;
+        assert_eq!(&diff_n_d, &diff_d_n.neg());
+
+        let mut a = d.clone();
+        a -= n;
+        assert_eq!(&a, &diff_n_d.neg());
+    }
+
+    /// Property: all `*` overloads agree and multiplication commutes
+    /// with negation. Ported from proptest `mul_*`.
+    #[hegel::test]
+    fn mul_overloads_agree(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<i128>());
+        let m = tc.draw(generators::integers::<i128>());
+        let e = tc.draw(generators::integers::<i8>());
+        let d = BigDecimal::new(m.into(), e as i64);
+
+        let prod_n_d = n * &d;
+        let prod_d_n = d.clone() * n;
+        assert_eq!(&prod_n_d, &prod_d_n);
+
+        let mut r = d.clone();
+        r *= n;
+        assert_eq!(&prod_n_d, &r);
+
+        let r = d.neg() * n;
+        assert_eq!(prod_n_d.neg(), r);
+    }
+
+    /// Property: integer / decimal division overloads agree, and the
+    /// quotient multiplied back differs from the numerator by less than
+    /// 1e-60 (the quotient carries 100 significant digits and
+    /// |n| < 2^127 ≈ 1.7e38, so the error is bounded by ~1.7e-62).
+    /// The decimal divisor is non-zero because `Div` explicitly panics
+    /// with "Division by zero". Ported from proptest `div_*`.
+    #[hegel::test]
+    fn div_overloads_agree_and_multiply_back(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<i128>());
+        let m = tc.draw(generators::integers::<i128>());
+        tc.assume(m != 0);
+        let e = tc.draw(generators::integers::<i8>());
+        let d = BigDecimal::new(m.into(), e as i64);
+
+        let quotient_n_ref_d = n / &d;
+        let quotient_n_d = n / d.clone();
+        assert_eq!(&quotient_n_ref_d, &quotient_n_d);
+
+        let prod = quotient_n_d * &d;
+        let diff = n - &prod;
+        assert!(diff.abs() < BigDecimal::new(1.into(), 60));
+    }
+
+    /// Property: `d /= n` behaves exactly like `d = d / n` for *every*
+    /// integer divisor, including zero — same value, or both panic.
+    /// Evidence: Rust's operator convention (`DivAssign` is "the division
+    /// assignment operator /=") and the crate's own gated proptests, which
+    /// assert Div/DivAssign agreement for the other operators without
+    /// excluding any divisor.
+    #[hegel::test]
+    fn div_assign_agrees_with_div_for_any_divisor(tc: hegel::TestCase) {
+        use std::panic::{catch_unwind, AssertUnwindSafe};
+
+        let m = tc.draw(generators::integers::<i128>());
+        let e = tc.draw(generators::integers::<i8>());
+        let d = BigDecimal::new(m.into(), e as i64);
+        let n = tc.draw(generators::integers::<i128>());
+
+        let div_result = catch_unwind(AssertUnwindSafe(|| &d / n));
+        let assign_result = catch_unwind(AssertUnwindSafe(|| {
+            let mut a = d.clone();
+            a /= n;
+            a
+        }));
+
+        match (div_result, assign_result) {
+            (Ok(a), Ok(b)) => assert_eq!(a, b),
+            (Err(_), Err(_)) => {} // both panicked: consistent
+            (Ok(q), Err(_)) => panic!("{} / {} = {} but the /= overload panicked", d, n, q),
+            (Err(_), Ok(q)) => panic!("{} / {} panicked but the /= overload gave {}", d, n, q),
+        }
+    }
+
+    /// Property: float / decimal division overloads agree (including
+    /// non-normal floats, which the impl short-circuits to zero for all
+    /// overloads alike). Ported from proptest `div_f64`.
+    #[hegel::test]
+    fn float_div_overloads_agree(tc: hegel::TestCase) {
+        let n = tc.draw(generators::floats::<f64>());
+        let m = tc.draw(generators::integers::<i128>());
+        tc.assume(m != 0);
+        let e = tc.draw(generators::integers::<i8>());
+        let d = BigDecimal::new(m.into(), e as i64);
+
+        let quotient_n_ref_d = n / &d;
+        let quotient_n_d = n / d.clone();
+        assert_eq!(&quotient_n_ref_d, &quotient_n_d);
+
+        let quotient_ref_d_n = &d / n;
+        let quotient_d_n = d.clone() / n;
+        assert_eq!(&quotient_ref_d_n, &quotient_d_n);
+
+        let mut q = d.clone();
+        q /= n;
+        assert_eq!(&q, &quotient_d_n);
+    }
+}
+
+// Stateful model test (hegel): run random sequences of BigDecimal
+// operations, mirroring each exact operation on a BigRational model,
+// and check the two agree after every step.
+mod hegel_model {
+    use super::*;
+    use hegel::TestCase;
+    use hegel::generators::{self, Generator};
+    use num_rational::BigRational;
+
+    fn rational_of(d: &BigDecimal) -> BigRational {
+        let (int_val, scale) = d.as_bigint_and_exponent();
+        if scale >= 0 {
+            BigRational::new(int_val, Pow::pow(BigInt::from(10), scale as u64))
+        } else {
+            let numer = int_val * Pow::pow(BigInt::from(10), scale.unsigned_abs());
+            BigRational::new(numer, BigInt::one())
+        }
+    }
+
+    struct DecimalVsRational {
+        subject: BigDecimal,
+        model: BigRational,
+    }
+
+    impl DecimalVsRational {
+        /// keep coefficient growth bounded so mul/square rules can't
+        /// explode the test's memory; this limits how big the numbers
+        /// get, not which values the library must accept
+        fn digits_are_small(&self) -> bool {
+            self.subject.digits() < 1000
+        }
+    }
+
+    #[hegel::composite]
+    fn small_decimals(tc: &hegel::TestCase) -> BigDecimal {
+        let int_val = tc.draw(generators::integers::<i64>());
+        let scale = tc.draw(generators::integers::<i8>());
+        BigDecimal::new(int_val.into(), scale as i64)
+    }
+
+    #[hegel::state_machine]
+    impl DecimalVsRational {
+        #[rule]
+        fn add(&mut self, tc: TestCase) {
+            let d = tc.draw((small_decimals()).print_as_debug());
+            self.model += rational_of(&d);
+            self.subject += d;
+        }
+
+        #[rule]
+        fn sub(&mut self, tc: TestCase) {
+            let d = tc.draw((small_decimals()).print_as_debug());
+            self.model -= rational_of(&d);
+            self.subject -= d;
+        }
+
+        #[rule]
+        fn mul(&mut self, tc: TestCase) {
+            tc.assume(self.digits_are_small());
+            let d = tc.draw((small_decimals()).print_as_debug());
+            self.model *= rational_of(&d);
+            self.subject *= d;
+        }
+
+        #[rule]
+        fn square(&mut self, tc: TestCase) {
+            tc.assume(self.digits_are_small());
+            self.model = &self.model * &self.model;
+            self.subject = self.subject.square();
+        }
+
+        #[rule]
+        fn neg(&mut self, _: TestCase) {
+            self.model = -self.model.clone();
+            self.subject = -self.subject.clone();
+        }
+
+        #[rule]
+        fn abs(&mut self, _: TestCase) {
+            self.model = self.model.abs();
+            self.subject = self.subject.abs();
+        }
+
+        #[rule]
+        fn double(&mut self, _: TestCase) {
+            self.model *= BigRational::from_integer(2.into());
+            self.subject = self.subject.double();
+        }
+
+        #[rule]
+        fn half(&mut self, _: TestCase) {
+            self.model /= BigRational::from_integer(2.into());
+            self.subject = self.subject.half();
+        }
+
+        #[rule]
+        fn normalize(&mut self, _: TestCase) {
+            // value-preserving; model unchanged
+            self.subject = self.subject.normalized();
+        }
+
+        #[rule]
+        fn extend_scale(&mut self, tc: TestCase) {
+            // padding with zeros is value-preserving; model unchanged
+            let extra = tc.draw(generators::integers::<i64>().min_value(0).max_value(50));
+            self.subject = self.subject.with_scale(self.subject.fractional_digit_count() + extra);
+        }
+
+        #[rule]
+        fn roundtrip_through_scientific_notation(&mut self, _: TestCase) {
+            // formatting and re-parsing is value-preserving; model unchanged
+            let repr = self.subject.to_scientific_notation();
+            self.subject = repr.parse().expect("scientific notation must re-parse");
+        }
+
+        #[invariant]
+        fn value_matches_model(&self, _: TestCase) {
+            assert_eq!(rational_of(&self.subject), self.model);
+        }
+
+        #[invariant]
+        fn is_integer_matches_model(&self, _: TestCase) {
+            assert_eq!(self.subject.is_integer(), self.model.is_integer());
+        }
+    }
+
+    #[hegel::test]
+    fn bigdecimal_agrees_with_rational_model(tc: TestCase) {
+        let initial = tc.draw((small_decimals()).print_as_debug());
+        let machine = DecimalVsRational {
+            model: rational_of(&initial),
+            subject: initial,
+        };
+        hegel::stateful::machine(machine).run(tc);
+    }
+}
