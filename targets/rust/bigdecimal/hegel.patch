+
+    // Property-based tests (hegel)
+    mod hegel_props {
+        use super::*;
+
+        /// Property: parsing never panics — bad input must produce an
+        /// `Err`, never a crash.
+        /// Evidence: `FromStr::from_str` returns
+        /// `Result<BigDecimal, ParseBigDecimalError>`, and the unit tests
+        /// above expect specific errors for malformed strings.
+        /// Inputs mix arbitrary unicode with "almost numeric" strings that
