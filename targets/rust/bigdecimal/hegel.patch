+// Property-based tests (hegel)
+mod hegel_props {
+    use super::*;
+    use hegel::generators::{self, Generator};
+
+    /// Arbitrary BigDecimal with scale bounded to ±300 — rounding to a
+    /// new scale materializes ~|scale| digits, and the assertions below
+    /// subtract values at aligned scales, so the bound keeps the *test*
+    /// memory-sane while still covering scales far beyond the digit count.
+    #[hegel::composite]
+    fn bigdecimals(tc: &hegel::TestCase) -> BigDecimal {
+        let int_val = tc.draw(generators::integers::<i128>());
+        let scale = tc.draw(generators::integers::<i64>().min_value(-300).max_value(300));
+        BigDecimal::new(int_val.into(), scale)
+    }
+
+    /// Property: Floor and Ceiling rounding bracket the original value,
+    /// and differ by at most one unit in the last place of the new scale.
+    /// Evidence: RoundingMode doc-comments — Ceiling "Towards +∞",
+    /// Floor "Towards -∞".
+    #[hegel::test]
+    fn floor_and_ceiling_bracket_the_value(tc: hegel::TestCase) {
+        let n = tc.draw((bigdecimals()).print_as_debug());
+        let new_scale = tc.draw(generators::integers::<i64>().min_value(-300).max_value(300));
+
+        let floor = n.with_scale_round(new_scale, RoundingMode::Floor);
+        let ceiling = n.with_scale_round(new_scale, RoundingMode::Ceiling);
+
+        assert!(floor <= n, "floor {} > n {}", floor, n);
+        assert!(n <= ceiling, "n {} > ceiling {}", n, ceiling);
+
+        let ulp = BigDecimal::new(1.into(), new_scale);
+        assert!(ceiling - floor <= ulp);
+    }
+
+    /// Property: for every rounding mode, `with_scale_round` returns a
+    /// value with exactly the requested scale, and the rounding error is
+    /// strictly less than one unit in the last place of that scale.
+    /// Evidence: with_scale_round doc-comment ("Return a new BigDecimal
+    /// after shortening the digits and rounding") and its doc examples;
+    /// all seven RoundingMode variants round to a neighboring multiple
+    /// of 10^-new_scale (rounding.rs doc-comments).
+    #[hegel::test]
+    fn rounding_error_is_less_than_one_ulp(tc: hegel::TestCase) {
+        use crate::rounding::RoundingMode::*;
+
+        let n = tc.draw((bigdecimals()).print_as_debug());
+        let new_scale = tc.draw(generators::integers::<i64>().min_value(-300).max_value(300));
+        let mode = tc.draw((generators::sampled_from(vec![
+            Up, Down, Ceiling, Floor, HalfUp, HalfDown, HalfEven,
+        ])).print_as_debug());
+
+        let rounded = n.with_scale_round(new_scale, mode);
+        assert_eq!(rounded.fractional_digit_count(), new_scale);
+
+        let ulp = BigDecimal::new(1.into(), new_scale);
+        let error = (&n - &rounded).abs();
+        assert!(error < ulp, "rounding {} to scale {} with {:?} gave {} (error {})",
+                n, new_scale, mode, rounded, error);
+    }
+
+    /// Property: rounding to a larger scale (more fractional digits) is
+    /// exact — it never changes the value, whatever the rounding mode.
+    /// Evidence: with_scale doc-comment ("If the new_scale is lower than
+    /// the current value ... digits will be dropped" — implying higher
+    /// scale only pads) and the Ordering::Greater branch of
+    /// with_scale_round, which only multiplies by a power of ten.
+    #[hegel::test]
+    fn rounding_to_larger_scale_is_exact(tc: hegel::TestCase) {
+        use crate::rounding::RoundingMode::*;
+
+        let n = tc.draw((bigdecimals()).print_as_debug());
+        let extra = tc.draw(generators::integers::<i64>().min_value(0).max_value(300));
+        let mode = tc.draw((generators::sampled_from(vec![
+            Up, Down, Ceiling, Floor, HalfUp, HalfDown, HalfEven,
+        ])).print_as_debug());
+
+        let new_scale = n.fractional_digit_count() + extra;
+        let rescaled = n.with_scale_round(new_scale, mode);
+        assert_eq!(rescaled, n);
+        assert_eq!(rescaled.fractional_digit_count(), new_scale);
+    }
+}
