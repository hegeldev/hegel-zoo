+        tc.draw((hegel::one_of!(
+            generators::integers::<u128>().map(BigUint::from),
+            generators::from_regex(r"[1-9][0-9]{0,80}")
+                .map(|s: String| BigUint::from_str(&s).unwrap()),
+        )).print_as_debug())
+    }
+
+    // Truncation contract for the principal nth root of a non-negative value:
+    // root^n <= x < (root+1)^n, and sqrt/cbrt agree with nth_root at n=2,3.
+    #[hegel::test]
+    fn hegel_biguint_nth_root_contract(tc: hegel::TestCase) {
+        let x = tc.draw((big_uints()).print_as_debug());
+        let n = tc.draw(generators::integers::<u32>().min_value(1).max_value(40));
+        let root = x.nth_root(n);
+        assert!(root.pow(n) <= x);
+        assert!((&root + 1u32).pow(n) > x);
+        if n == 2 {
+            assert_eq!(root, x.sqrt());
+        }
+        if n == 3 {
+            assert_eq!(root, x.cbrt());
+        }
+    }
+
+    // For negative x and odd n the root is truncated toward zero:
+    // root^n >= x > (root-1)^n, and the root is never positive.
+    #[hegel::test]
+    fn hegel_bigint_negative_nth_root_contract(tc: hegel::TestCase) {
+        let x = -BigInt::from(tc.draw((big_uints()).print_as_debug()));
+        let k = tc.draw(generators::integers::<u32>().max_value(20));
+        let n = 2 * k + 1; // odd: even roots of negatives are undefined
+        let root = x.nth_root(n);
+        assert!(!num_traits::Signed::is_positive(&root));
+        assert!(root.pow(n) >= x);
+        assert!((&root - 1u32).pow(n) < x);
+    }
+}
