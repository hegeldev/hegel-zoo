+    use num_bigint::BigUint;
+
+    // bits(), count_ones() and trailing_zeros() must agree with the u128
+    // primitives for every value that fits in u128.
+    #[hegel::test]
+    fn hegel_biguint_bit_queries_match_u128(tc: hegel::TestCase) {
+        let v = tc.draw(generators::integers::<u128>());
