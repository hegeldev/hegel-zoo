diff --git a/tests/bigint.rs b/tests/bigint.rs
index fea5232..a983a7e 100644
--- a/tests/bigint.rs
+++ b/tests/bigint.rs
@@ -1473,3 +1473,222 @@ fn test_set_bit() {
     x.set_bit(0, false);
     assert_eq!(x, BigInt::from_biguint(Minus, BigUint::one() << 200));
 }
+
+/// Property-based tests (hegel).
+mod hegel_props {
+    use super::*;
+    use hegel::generators::{self, Generator};
+    use std::str::FromStr;
+
+    /// Mix of machine-word-range values (hits `MIN`/`MAX`/`0` boundaries) and
+    /// decimal strings much wider than any machine type.
+    #[hegel::composite]
+    fn big_ints(tc: &hegel::TestCase) -> BigInt {
+        tc.draw((hegel::one_of!(
+            generators::integers::<i128>().map(BigInt::from),
+            generators::from_regex(r"-?[1-9][0-9]{0,80}")
+                .map(|s: String| BigInt::from_str(&s).unwrap()),
+        )).print_as_debug())
+    }
+
+    // Differential oracle: for operands that fit in i64, BigInt +, -, *, neg and
+    // abs must agree exactly with the i128 computation (widening i64 -> i128
+    // means none of these can overflow on the oracle side).
+    #[hegel::test]
+    fn hegel_add_sub_mul_neg_match_i128(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<i64>()) as i128;
+        let b = tc.draw(generators::integers::<i64>()) as i128;
+        let (ba, bb) = (BigInt::from(a), BigInt::from(b));
+        assert_eq!(&ba + &bb, BigInt::from(a + b));
+        assert_eq!(&ba - &bb, BigInt::from(a - b));
+        assert_eq!(&ba * &bb, BigInt::from(a * b));
+        assert_eq!(-&ba, BigInt::from(-a));
+        assert_eq!(ba.abs(), BigInt::from(a.abs()));
+    }
+
+    // Differential oracle: /, %, div_mod_floor and Euclidean division on
+    // full-range i128 operands must agree with the primitive computation.
+    // checked_* is None only for division by zero (excluded) and
+    // (i128::MIN, -1); we skip the comparison there.
+    #[hegel::test]
+    fn hegel_div_rem_match_i128(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<i128>());
+        let b = tc.draw(generators::integers::<i128>());
+        tc.assume(b != 0);
+        let (ba, bb) = (BigInt::from(a), BigInt::from(b));
+        if let (Some(q), Some(r)) = (a.checked_div(b), a.checked_rem(b)) {
+            assert_eq!(&ba / &bb, BigInt::from(q));
+            assert_eq!(&ba % &bb, BigInt::from(r));
+            // num-integer's primitive impl is an independent oracle for floored division
+            let (fq, fr) = a.div_mod_floor(&b);
+            let (bfq, bfr) = ba.div_mod_floor(&bb);
+            assert_eq!(bfq, BigInt::from(fq));
+            assert_eq!(bfr, BigInt::from(fr));
+            // Euclidean division from num-traits
+            let (eq, er) = (a.div_euclid(b), a.rem_euclid(b));
+            assert_eq!(Euclid::div_euclid(&ba, &bb), BigInt::from(eq));
+            assert_eq!(Euclid::rem_euclid(&ba, &bb), BigInt::from(er));
+        }
+    }
+
+    // Ord on BigInt must agree with Ord on i128.
+    #[hegel::test]
+    fn hegel_cmp_matches_i128(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<i128>());
+        let b = tc.draw(generators::integers::<i128>());
+        assert_eq!(BigInt::from(a).cmp(&BigInt::from(b)), a.cmp(&b));
+    }
+
+    // to_str_radix / from_str_radix round-trip for every radix 2..=36,
+    // including negative values, zero, and values far wider than u128.
+    #[hegel::test]
+    fn hegel_to_str_radix_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw((big_ints()).print_as_debug());
+        let radix = tc.draw(generators::integers::<u32>().min_value(2).max_value(36));
+        let s = n.to_str_radix(radix);
+        assert_eq!(BigInt::from_str_radix(&s, radix).unwrap(), n);
+    }
+
+    // Display / FromStr round-trip (the radix-10 fast path).
+    #[hegel::test]
+    fn hegel_display_parse_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw((big_ints()).print_as_debug());
+        assert_eq!(n.to_string().parse::<BigInt>().unwrap(), n);
+    }
+
+    // The fmt impls (Binary, Octal, LowerHex, UpperHex, Display) must agree
+    // with to_str_radix at the corresponding radix.
+    #[hegel::test]
+    fn hegel_format_impls_match_to_str_radix(tc: hegel::TestCase) {
+        let n = tc.draw((big_ints()).print_as_debug());
+        assert_eq!(format!("{}", n), n.to_str_radix(10));
+        assert_eq!(format!("{:b}", n), n.to_str_radix(2));
+        assert_eq!(format!("{:o}", n), n.to_str_radix(8));
+        assert_eq!(format!("{:x}", n), n.to_str_radix(16));
+        assert_eq!(format!("{:X}", n), n.to_str_radix(16).to_uppercase());
+    }
+
+    // to_signed_bytes_{le,be} / from_signed_bytes_{le,be} round-trip.
+    #[hegel::test]
+    fn hegel_signed_bytes_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw((big_ints()).print_as_debug());
+        assert_eq!(BigInt::from_signed_bytes_le(&n.to_signed_bytes_le()), n);
+        assert_eq!(BigInt::from_signed_bytes_be(&n.to_signed_bytes_be()), n);
+    }
+
+    // to_bytes_{le,be} / from_bytes_{le,be} (sign + magnitude) round-trip,
+    // and the two byte orders must be reverses of each other.
+    #[hegel::test]
+    fn hegel_bytes_sign_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw((big_ints()).print_as_debug());
+        let (sign_le, le) = n.to_bytes_le();
+        assert_eq!(BigInt::from_bytes_le(sign_le, &le), n);
+        let (sign_be, be) = n.to_bytes_be();
+        assert_eq!(BigInt::from_bytes_be(sign_be, &be), n);
+        assert_eq!(sign_le, sign_be);
+        let mut rev = be;
+        rev.reverse();
+        assert_eq!(rev, le);
+    }
+
+    // to_radix_{le,be} / from_radix_{le,be} round-trip for radix 2..=256,
+    // and every emitted digit must be smaller than the radix.
+    #[hegel::test]
+    fn hegel_radix_digits_roundtrip(tc: hegel::TestCase) {
+        let n = tc.draw((big_ints()).print_as_debug());
+        let radix = tc.draw(generators::integers::<u32>().min_value(2).max_value(256));
+        let (sign, digits) = n.to_radix_le(radix);
+        assert!(digits.iter().all(|&d| u32::from(d) < radix));
+        assert_eq!(BigInt::from_radix_le(sign, &digits, radix).unwrap(), n);
+        let (sign_be, digits_be) = n.to_radix_be(radix);
+        assert_eq!(BigInt::from_radix_be(sign_be, &digits_be, radix).unwrap(), n);
+    }
+
+    // Truncated division contract on arbitrarily wide values:
+    // a == q*b + r, |r| < |b|, and a non-zero remainder takes the dividend's
+    // sign (`div_rem` is truncated division, matching primitive `/` and `%`).
+    #[hegel::test]
+    fn hegel_div_rem_contract(tc: hegel::TestCase) {
+        let a = tc.draw((big_ints()).print_as_debug());
+        let b = tc.draw((big_ints()).print_as_debug());
+        tc.assume(!b.is_zero());
+        let (q, r) = a.div_rem(&b);
+        assert_eq!(&q * &b + &r, a);
+        assert!(r.abs() < b.abs());
+        if !r.is_zero() {
+            assert_eq!(r.sign(), a.sign());
+        }
+        assert_eq!(q, &a / &b);
+        assert_eq!(r, &a % &b);
+    }
+
+    // Floored division contract on arbitrarily wide values:
+    // a == q*b + r, |r| < |b|, and a non-zero remainder takes the divisor's sign.
+    #[hegel::test]
+    fn hegel_div_mod_floor_contract(tc: hegel::TestCase) {
+        let a = tc.draw((big_ints()).print_as_debug());
+        let b = tc.draw((big_ints()).print_as_debug());
+        tc.assume(!b.is_zero());
+        let (q, r) = a.div_mod_floor(&b);
+        assert_eq!(&q * &b + &r, a);
+        assert!(r.abs() < b.abs());
+        if !r.is_zero() {
+            assert_eq!(r.sign(), b.sign());
+        }
+        assert_eq!(q, a.div_floor(&b));
+        assert_eq!(r, a.mod_floor(&b));
+    }
+
+    // gcd is non-negative, divides both operands, gcd(a, 0) == |a|,
+    // and gcd(a, b) * lcm(a, b) == |a * b|.
+    #[hegel::test]
+    fn hegel_gcd_lcm_contract(tc: hegel::TestCase) {
+        let a = tc.draw((big_ints()).print_as_debug());
+        let b = tc.draw((big_ints()).print_as_debug());
+        let g = a.gcd(&b);
+        assert!(!g.is_negative());
+        assert_eq!(a.gcd(&BigInt::zero()), a.abs());
+        if g.is_zero() {
+            assert!(a.is_zero() && b.is_zero());
+        } else {
+            assert!(a.is_multiple_of(&g));
+            assert!(b.is_multiple_of(&g));
+        }
+        assert_eq!(&g * a.lcm(&b), (&a * &b).abs());
+    }
+
+    // pow must match repeated multiplication (including sign alternation for
+    // negative bases, and the 0^0 == 1 convention).
+    #[hegel::test]
+    fn hegel_pow_matches_repeated_mul(tc: hegel::TestCase) {
+        let n = tc.draw((big_ints()).print_as_debug());
+        let e = tc.draw(generators::integers::<u32>().max_value(16));
+        let mut expected = BigInt::one();
+        for _ in 0..e {
+            expected *= &n;
+        }
+        assert_eq!(n.pow(e), expected);
+    }
+
+    // Rejection: corrupting a valid radix-string with a character that is a
+    // digit in no radix must make from_str_radix fail (not silently parse).
+    #[hegel::test]
+    fn hegel_parse_rejects_invalid_char(tc: hegel::TestCase) {
+        let n = tc.draw((big_ints()).print_as_debug());
+        let radix = tc.draw(generators::integers::<u32>().min_value(2).max_value(36));
+        let mut s = n.to_str_radix(radix);
+        let pos = tc.draw(generators::integers::<usize>().max_value(s.len()));
+        s.insert(pos, '#');
+        assert!(BigInt::from_str_radix(&s, radix).is_err());
+    }
+
+    // Robustness: parsing arbitrary text must return an error, never panic.
+    #[hegel::test]
+    fn hegel_parse_never_panics(tc: hegel::TestCase) {
+        let s = tc.draw(generators::text());
+        let radix = tc.draw(generators::integers::<u32>().min_value(2).max_value(36));
+        drop(BigInt::from_str_radix(&s, radix));
+        drop(BigInt::parse_bytes(s.as_bytes(), radix));
+        drop(s.parse::<BigInt>());
+    }
+}
diff --git a/tests/bigint_bitwise.rs b/tests/bigint_bitwise.rs
index 94d92e1..a9b903d 100644
--- a/tests/bigint_bitwise.rs
+++ b/tests/bigint_bitwise.rs
@@ -175,3 +175,110 @@ fn test_bitwise_i64() {
         }
     }
 }
+
+/// Property-based tests (hegel).
+mod hegel_props {
+    use hegel::generators::{self, Generator};
+    use num_bigint::BigInt;
+    use num_traits::{One, Zero};
+    use std::str::FromStr;
+
+    /// Mix of machine-word-range values (hits `MIN`/`MAX`/`0` boundaries) and
+    /// decimal strings much wider than any machine type.
+    #[hegel::composite]
+    fn big_ints(tc: &hegel::TestCase) -> BigInt {
+        tc.draw((hegel::one_of!(
+            generators::integers::<i128>().map(BigInt::from),
+            generators::from_regex(r"-?[1-9][0-9]{0,80}")
+                .map(|s: String| BigInt::from_str(&s).unwrap()),
+        )).print_as_debug())
+    }
+
+    // Differential oracle: &, |, ^ and ! on full-range i128 operands must
+    // agree with the primitive two's-complement computation.
+    #[hegel::test]
+    fn hegel_bitwise_ops_match_i128(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<i128>());
+        let b = tc.draw(generators::integers::<i128>());
+        let (ba, bb) = (BigInt::from(a), BigInt::from(b));
+        assert_eq!(&ba & &bb, BigInt::from(a & b));
+        assert_eq!(&ba | &bb, BigInt::from(a | b));
+        assert_eq!(&ba ^ &bb, BigInt::from(a ^ b));
+        assert_eq!(!&ba, BigInt::from(!a));
+    }
+
+    // Differential oracle: << and >> must agree with i128 shifts.
+    // BigInt's >> is arithmetic (rounds toward negative infinity), exactly
+    // like a primitive signed shift; for shift counts >= 127 the i128 oracle
+    // saturates to the sign bit.
+    #[hegel::test]
+    fn hegel_shifts_match_i128(tc: hegel::TestCase) {
+        let v = tc.draw(generators::integers::<i64>());
+        let k = tc.draw(generators::integers::<u32>().max_value(60));
+        // i64 << 60 always fits in i128, so the oracle cannot overflow
+        assert_eq!(BigInt::from(v) << k, BigInt::from(i128::from(v) << k));
+
+        let w = tc.draw(generators::integers::<i128>());
+        let j = tc.draw(generators::integers::<u32>().max_value(300));
+        assert_eq!(BigInt::from(w) >> j, BigInt::from(w >> j.min(127)));
+    }
+
+    // bit() must agree with the i128 two's-complement bit at every index;
+    // past bit 127 the i128 sign bit repeats.
+    #[hegel::test]
+    fn hegel_bit_matches_i128(tc: hegel::TestCase) {
+        let v = tc.draw(generators::integers::<i128>());
+        let i = tc.draw(generators::integers::<u64>().max_value(300));
+        let expected = if i >= 127 {
+            v < 0
+        } else {
+            (v >> i) & 1 == 1
+        };
+        assert_eq!(BigInt::from(v).bit(i), expected);
+    }
+
+    // set_bit / bit consistency on arbitrarily wide values: after
+    // set_bit(i, val), bit(i) reads back val, every other bit is unchanged,
+    // and the arithmetic difference is exactly 0 or +/- 2^i.
+    #[hegel::test]
+    fn hegel_set_bit_bit_consistency(tc: hegel::TestCase) {
+        let n = tc.draw((big_ints()).print_as_debug());
+        let i = tc.draw(generators::integers::<u64>().max_value(300));
+        let val = tc.draw(generators::booleans());
+        let mut m = n.clone();
+        m.set_bit(i, val);
+        assert_eq!(m.bit(i), val);
+        let j = tc.draw(generators::integers::<u64>().max_value(300));
+        if j != i {
+            assert_eq!(m.bit(j), n.bit(j));
+        }
+        let delta = &m - &n;
+        if n.bit(i) == val {
+            assert!(delta.is_zero());
+        } else if val {
+            assert_eq!(delta, BigInt::one() << i);
+        } else {
+            assert_eq!(delta, -(BigInt::one() << i));
+        }
+    }
+
+    // trailing_zeros is None exactly for zero; otherwise every bit below it
+    // is clear, the bit at that index is set, and shifting it away leaves an
+    // odd number. Holds for negatives too (two's complement preserves
+    // trailing zeros).
+    #[hegel::test]
+    fn hegel_trailing_zeros_contract(tc: hegel::TestCase) {
+        let n = tc.draw((big_ints()).print_as_debug());
+        match n.trailing_zeros() {
+            None => assert!(n.is_zero()),
+            Some(tz) => {
+                assert!(!n.is_zero());
+                assert!(n.bit(tz));
+                for j in 0..tz {
+                    assert!(!n.bit(j));
+                }
+                assert!((&n >> tz).bit(0));
+            }
+        }
+    }
+}
