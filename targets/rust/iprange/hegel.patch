+    // ---------------------------------------------------------------------
+    // Property: supernet agrees with ipnet's containment oracle (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn supernet_agrees_with_ipnet_contains(tc: hegel::TestCase) {
+        let nets = draw_v4_net_vec(&tc);
+        let range = collect_v4(&nets);
+        let query = tc.draw((v4_nets()).print_as_debug()).trunc();
+        let members: Vec<Ipv4Net> = range.iter().collect();
+        match range.supernet(&query) {
+            Some(s) => {
+                assert!(
+                    s.contains(&query),
+                    "supernet {} does not contain query {}",
+                    s,
+                    query
+                );
+                assert!(
+                    members.contains(&s),
+                    "supernet {} is not a member network of {:?}",
+                    s,
+                    members
+                );
+            }
+            None => {
+                for m in &members {
+                    assert!(
+                        !m.contains(&query),
+                        "supernet returned None but member {} contains query {}",
+                        m,
+                        query
+                    );
+                }
+            }
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: stateful model — IpRange agrees with an exact membership
+    // set over a 256-address window (192.168.5.0/24), with boundary octets
+    // 0 and 255 reachable and supernet-removal exercised.
+    // ---------------------------------------------------------------------
+
+    const WINDOW_BASE: u32 = 0xC0A8_0500; // 192.168.5.0
+
+    struct WindowMachine {
+        range: IpRange<Ipv4Net>,
+        model: BTreeSet<u8>,
+    }
+
+    /// Draw a subnet of 192.168.5.0/24 and the inclusive last-octet span
+    /// it covers.
+    fn draw_window_net(tc: &hegel::TestCase) -> (Ipv4Net, u8, u8) {
+        let len = tc.draw(generators::integers::<u8>().min_value(24).max_value(32));
+        let octet = tc.draw(generators::integers::<u8>()) as u32;
+        let host_bits = 32 - len as u32;
+        let lo = octet & (0xFFu32 << host_bits) & 0xFF;
+        let hi = lo + (1u32 << host_bits) - 1;
+        let net = Ipv4Net::new((WINDOW_BASE | lo).into(), len).unwrap();
+        (net, lo as u8, hi as u8)
+    }
+
+    #[hegel::state_machine]
+    impl WindowMachine {
+        #[rule]
+        fn add(&mut self, tc: hegel::TestCase) {
+            let (net, lo, hi) = draw_window_net(&tc);
+            self.range.add(net);
+            self.model.extend(lo..=hi);
+        }
+
+        #[rule]
+        fn remove(&mut self, tc: hegel::TestCase) {
+            let (net, lo, hi) = draw_window_net(&tc);
+            self.range.remove(net);
+            for octet in lo..=hi {
+                self.model.remove(&octet);
+            }
+        }
+
+        #[rule]
+        fn remove_supernet(&mut self, tc: hegel::TestCase) {
+            // Remove a strict supernet of the window (including 0.0.0.0/0):
+            // this must clear the whole window.
+            let len = tc.draw(generators::integers::<u8>().max_value(23));
+            let net = Ipv4Net::new(WINDOW_BASE.into(), len).unwrap();
+            self.range.remove(net);
+            self.model.clear();
+        }
+
+        #[rule]
+        fn simplify(&mut self, _tc: hegel::TestCase) {
+            self.range.simplify();
+        }
+
+        #[invariant]
+        fn agrees_with_model(&self, _tc: hegel::TestCase) {
+            // contains() agrees with the model for every window address.
+            for octet in 0u32..=255 {
+                assert_eq!(
+                    self.range.contains(&(WINDOW_BASE | octet)),
+                    self.model.contains(&(octet as u8)),
+                    "contains disagrees with model at octet {}",
+                    octet
+                );
+            }
+            // is_empty agrees (the range only ever holds window subnets).
+            assert_eq!(self.range.is_empty(), self.model.is_empty());
+            // The iterator yields only window subnets, and expanding them
+            // reproduces the model exactly.
+            let mut expanded = BTreeSet::new();
+            for net in &self.range {
+                let lo: u32 = net.network().into();
+                let hi: u32 = net.broadcast().into();
+                assert!(
+                    net.prefix_len() >= 24 && lo >= WINDOW_BASE && hi <= WINDOW_BASE + 255,
+                    "iterated network {} escaped the window",
+                    net
+                );
+                expanded.extend((lo - WINDOW_BASE..=hi - WINDOW_BASE).map(|o| o as u8));
+            }
+            assert_eq!(expanded, self.model, "iterated networks != model");
+        }
+    }
+
+    #[hegel::test]
+    fn window_model_agrees(tc: hegel::TestCase) {
+        let machine = WindowMachine {
+            range: IpRange::new(),
+            model: BTreeSet::new(),
+        };
+        hegel::stateful::machine(machine).run(tc);
+    }
