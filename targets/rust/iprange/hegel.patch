+#[cfg(test)]
+mod hegel_tests {
+    use crate::IpRange;
+    use hegel::generators;
+    use hegel::Generator;
+    use ipnet::{Ipv4Net, Ipv6Net};
+    use std::collections::BTreeSet;
+
+    // ---------------------------------------------------------------------
+    // Generators
+    // ---------------------------------------------------------------------
+
+    /// IPv4 addresses as u32, with the top/bottom of the address space
+    /// boosted (the sibling crate `ipnet` had saturation bugs at
+    /// 0.0.0.0/0 and 255.255.255.255/32, so those boundaries get extra
+    /// weight here).
+    #[hegel::composite]
+    fn v4_addrs(tc: &hegel::TestCase) -> u32 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u32>(),
+            generators::sampled_from(vec![0u32, 1, u32::MAX, u32::MAX - 1, 1u32 << 31]),
+        ))
+    }
+
+    /// Arbitrary IPv4 networks over the full address space, all prefix
+    /// lengths 0..=32. Deliberately not truncated: `IpRange` documents that
+    /// it only looks at the prefix bits, so host bits should not matter.
+    #[hegel::composite]
+    fn v4_nets(tc: &hegel::TestCase) -> Ipv4Net {
+        let addr = tc.draw(v4_addrs());
+        let len = tc.draw(generators::integers::<u8>().max_value(32));
+        Ipv4Net::new(addr.into(), len).unwrap()
+    }
+
+    #[hegel::composite]
+    fn v6_addrs(tc: &hegel::TestCase) -> u128 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u128>(),
+            generators::sampled_from(vec![0u128, 1, u128::MAX, u128::MAX - 1, 1u128 << 127]),
+        ))
+    }
+
+    #[hegel::composite]
+    fn v6_nets(tc: &hegel::TestCase) -> Ipv6Net {
+        let addr = tc.draw(v6_addrs());
+        let len = tc.draw(generators::integers::<u8>().max_value(128));
+        Ipv6Net::new(addr.into(), len).unwrap()
+    }
+
+    fn draw_v4_net_vec(tc: &hegel::TestCase) -> Vec<Ipv4Net> {
+        tc.draw((generators::vecs(v4_nets()).max_size(16)).print_as_debug())
+    }
+
+    fn draw_v6_net_vec(tc: &hegel::TestCase) -> Vec<Ipv6Net> {
+        tc.draw((generators::vecs(v6_nets()).max_size(16)).print_as_debug())
+    }
+
+    /// Membership probes: drawn addresses plus the boundary addresses of
+    /// every involved network (network address, broadcast address, and the
+    /// addresses just outside them), plus the extremes of the space.
+    fn v4_probes(tc: &hegel::TestCase, nets: &[&[Ipv4Net]]) -> Vec<u32> {
+        let mut probes: Vec<u32> =
+            tc.draw(generators::vecs(generators::integers::<u32>()).max_size(8));
+        probes.push(0);
+        probes.push(u32::MAX);
+        for net in nets.iter().copied().flatten() {
+            let lo: u32 = net.network().into();
+            let hi: u32 = net.broadcast().into();
+            probes.extend([lo, hi, lo.wrapping_sub(1), hi.wrapping_add(1)]);
+        }
+        probes
+    }
+
+    fn v6_probes(tc: &hegel::TestCase, nets: &[&[Ipv6Net]]) -> Vec<u128> {
+        let mut probes: Vec<u128> =
+            tc.draw(generators::vecs(generators::integers::<u128>()).max_size(8));
+        probes.push(0);
+        probes.push(u128::MAX);
+        for net in nets.iter().copied().flatten() {
+            let lo: u128 = net.network().into();
+            let hi: u128 = net.broadcast().into();
+            probes.extend([lo, hi, lo.wrapping_sub(1), hi.wrapping_add(1)]);
+        }
+        probes
+    }
+
+    fn collect_v4(nets: &[Ipv4Net]) -> IpRange<Ipv4Net> {
+        nets.iter().cloned().collect()
+    }
+
+    fn collect_v6(nets: &[Ipv6Net]) -> IpRange<Ipv6Net> {
+        nets.iter().cloned().collect()
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: merge is membership-wise union (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn merge_matches_membership_union(tc: hegel::TestCase) {
+        let nets_a = draw_v4_net_vec(&tc);
+        let nets_b = draw_v4_net_vec(&tc);
+        let ra = collect_v4(&nets_a);
+        let rb = collect_v4(&nets_b);
+        let merged = ra.merge(&rb);
+        for addr in v4_probes(&tc, &[&nets_a, &nets_b]) {
+            assert_eq!(
+                merged.contains(&addr),
+                ra.contains(&addr) || rb.contains(&addr),
+                "merge disagrees with union at {}",
+                std::net::Ipv4Addr::from(addr)
+            );
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: intersect is membership-wise intersection (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn intersect_matches_membership_intersection(tc: hegel::TestCase) {
+        let nets_a = draw_v4_net_vec(&tc);
+        let nets_b = draw_v4_net_vec(&tc);
+        let ra = collect_v4(&nets_a);
+        let rb = collect_v4(&nets_b);
+        let intersection = ra.intersect(&rb);
+        for addr in v4_probes(&tc, &[&nets_a, &nets_b]) {
+            assert_eq!(
+                intersection.contains(&addr),
+                ra.contains(&addr) && rb.contains(&addr),
+                "intersect disagrees with intersection at {}",
+                std::net::Ipv4Addr::from(addr)
+            );
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: intersect commutes (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn intersect_commutes(tc: hegel::TestCase) {
+        let ra = collect_v4(&draw_v4_net_vec(&tc));
+        let rb = collect_v4(&draw_v4_net_vec(&tc));
+        assert_eq!(ra.intersect(&rb), rb.intersect(&ra));
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: exclude is membership-wise set difference (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn exclude_matches_membership_difference(tc: hegel::TestCase) {
+        let nets_a = draw_v4_net_vec(&tc);
+        let nets_b = draw_v4_net_vec(&tc);
+        let ra = collect_v4(&nets_a);
+        let rb = collect_v4(&nets_b);
+        let diff = ra.exclude(&rb);
+        for addr in v4_probes(&tc, &[&nets_a, &nets_b]) {
+            assert_eq!(
+                diff.contains(&addr),
+                ra.contains(&addr) && !rb.contains(&addr),
+                "exclude disagrees with set difference at {}",
+                std::net::Ipv4Addr::from(addr)
+            );
+        }
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: (universe \ B) union B == universe (IPv4 top-of-space)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn exclude_then_merge_restores_universe_v4(tc: hegel::TestCase) {
+        let nets_b = draw_v4_net_vec(&tc);
+        let rb = collect_v4(&nets_b);
+        let universe: IpRange<Ipv4Net> =
+            std::iter::once("0.0.0.0/0".parse::<Ipv4Net>().unwrap()).collect();
+        let complement = universe.exclude(&rb);
+        let restored = complement.merge(&rb);
+        assert_eq!(restored, universe);
+    }
