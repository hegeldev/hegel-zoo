+    // ---------------------------------------------------------------------
+    // Property: exclude with self is empty (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn exclude_self_is_empty(tc: hegel::TestCase) {
+        let r = collect_v4(&draw_v4_net_vec(&tc));
