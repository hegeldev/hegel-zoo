+
+    // ---------------------------------------------------------------------
+    // Property: simplify preserves membership (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn simplify_preserves_membership(tc: hegel::TestCase) {
+        let nets = draw_v4_net_vec(&tc);
+        let mut range: IpRange<Ipv4Net> = IpRange::new();
+        for net in &nets {
+            range.add(*net);
+        }
+        let probes = v4_probes(&tc, &[&nets]);
+        let before: Vec<bool> = probes.iter().map(|a| range.contains(a)).collect();
+        range.simplify();
+        let after: Vec<bool> = probes.iter().map(|a| range.contains(a)).collect();
+        assert_eq!(before, after, "simplify changed membership");
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: simplify is idempotent (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn simplify_is_idempotent(tc: hegel::TestCase) {
+        let nets = draw_v4_net_vec(&tc);
+        let mut range: IpRange<Ipv4Net> = IpRange::new();
+        for net in &nets {
+            range.add(*net);
+        }
+        range.simplify();
+        let once = range.clone();
+        range.simplify();
+        assert_eq!(once, range);
+    }
+
+    // ---------------------------------------------------------------------
+    // Property: iteration yields a disjoint, minimal, exact cover (IPv4)
+    // ---------------------------------------------------------------------
+
+    #[hegel::test]
+    fn iter_yields_disjoint_minimal_exact_cover(tc: hegel::TestCase) {
+        let nets = draw_v4_net_vec(&tc);
+        let range = collect_v4(&nets);
+        let yielded: Vec<Ipv4Net> = range.iter().collect();
+
+        // Every input network is covered.
+        for net in &nets {
+            assert!(range.contains(net), "input {} not covered", net);
+        }
+        // Every yielded network is contained in the range and is truncated.
+        for net in &yielded {
+            assert!(range.contains(net), "yielded {} not contained", net);
+            assert_eq!(*net, net.trunc(), "yielded {} not truncated", net);
+        }
+        // Yielded networks are pairwise disjoint (for CIDR networks,
+        // overlap implies one contains the other; use ipnet as the oracle).
+        for (i, a) in yielded.iter().enumerate() {
+            for b in yielded.iter().skip(i + 1) {
+                assert!(
+                    !a.contains(b) && !b.contains(a),
+                    "yielded networks overlap: {} and {}",
+                    a,
+                    b
+                );
+            }
+        }
+        // Minimality: the sibling of a yielded network must not be fully
+        // contained, otherwise simplify should have merged the pair.
+        for net in &yielded {
+            let len = net.prefix_len();
+            if len >= 1 {
+                let sibling_addr = u32::from(net.network()) ^ (1u32 << (32 - len));
+                let sibling = Ipv4Net::new(sibling_addr.into(), len).unwrap();
+                assert!(
+                    !range.contains(&sibling),
+                    "yielded {} but sibling {} also contained: not minimal",
+                    net,
+                    sibling
+                );
+            }
+        }
+        // Round-trip: collecting the yielded networks gives back the range.
+        let recollected: IpRange<Ipv4Net> = yielded.into_iter().collect();
+        assert_eq!(recollected, range);
+    }
