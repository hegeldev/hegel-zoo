+
+// Hegel property-based tests (require `std` for the hegel engine).
+#[cfg(all(test, feature = "std"))]
+mod hegel_tests {
+    use hegel::generators::{self, Generator};
+
+    use crate::api::test::{deserialize, roundtrip, to_archived};
+
+    // Property: `f32` round-trips bit-exactly through archive and
+    // deserialize. Drawing the raw bit pattern covers every value including
+    // all NaN payloads (quiet and signaling), infinities, and both zeros,
+    // which `PartialEq`-based round-trip tests cannot check.
+    #[hegel::test]
+    fn roundtrip_f32_bit_exact(tc: hegel::TestCase) {
+        let bits = tc.draw(generators::integers::<u32>());
+        let value = f32::from_bits(bits);
+        to_archived(&value, |archived| {
+            assert_eq!(archived.to_native().to_bits(), bits);
+            let deserialized: f32 = deserialize(&*archived);
+            assert_eq!(deserialized.to_bits(), bits);
+        });
+    }
+
+    // Property: `f64` round-trips bit-exactly (see `roundtrip_f32_bit_exact`).
+    #[hegel::test]
+    fn roundtrip_f64_bit_exact(tc: hegel::TestCase) {
+        let bits = tc.draw(generators::integers::<u64>());
+        let value = f64::from_bits(bits);
+        to_archived(&value, |archived| {
+            assert_eq!(archived.to_native().to_bits(), bits);
+            let deserialized: f64 = deserialize(&*archived);
+            assert_eq!(deserialized.to_bits(), bits);
+        });
+    }
+
+    // Property: every `char` (the full Unicode scalar value domain, including
+    // surrogates-adjacent boundaries and the maximum code point) round-trips.
+    #[hegel::test]
+    fn roundtrip_char_full_domain(tc: hegel::TestCase) {
+        let c = tc.draw(
+            generators::integers::<u32>()
+                .max_value(char::MAX as u32)
+                .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+        );
+        roundtrip(&c);
+    }
+}
diff --git a/rkyv/src/impls/mod.rs b/rkyv/src/impls/mod.rs
index 0e14364..22e1964 100644
--- a/rkyv/src/impls/mod.rs
+++ b/rkyv/src/impls/mod.rs
@@ -805,3 +805,234 @@ mod alloc_tests {
