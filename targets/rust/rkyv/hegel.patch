 }
+
+// Hegel property-based tests. These generate random values and check the
+// serialize -> access (validated) -> deserialize pipeline against the
+// original value. They require `std` because the hegel engine does.
+#[cfg(all(test, feature = "std"))]
+mod hegel_tests {
+    use core::num::NonZeroU32;
+    use std::collections::{BTreeMap, HashMap};
+
+    use hegel::generators::{self, Generator};
+    use rancor::Source;
+
+    use crate::{
+        api::test::roundtrip, ser::Writer, Archive, Deserialize, Serialize,
+    };
+
+    #[derive(Archive, Serialize, Deserialize, Debug, PartialEq)]
+    #[rkyv(crate, compare(PartialEq), derive(Debug))]
+    struct AllScalars {
+        b: bool,
+        c: char,
+        i1: i8,
+        i2: i16,
+        i3: i32,
+        i4: i64,
+        i5: i128,
+        u1: u8,
+        u2: u16,
+        u3: u32,
+        u4: u64,
+        u5: u128,
+        // Non-NaN floats: `compare(PartialEq)` can't hold for NaN. Bit-exact
+        // float round-tripping (including NaN payloads) is covered by
+        // `roundtrip_f32_bit_exact`/`roundtrip_f64_bit_exact` in
+        // `impls::core::primitive`.
+        f1: f32,
+        f2: f64,
+        // Note: no `usize`/`isize` fields here. Their archived forms
+        // (`FixedUsize`/`FixedIsize`) don't implement `PartialEq` against the
+        // native types, so `compare(PartialEq)` can't be derived with them.
+        nz: Option<NonZeroU32>,
+    }
+
+    #[derive(Archive, Serialize, Deserialize, Debug, PartialEq)]
+    #[rkyv(crate, compare(PartialEq), derive(Debug))]
+    enum Kind {
+        Unit,
+        Int(i64),
+        Text { s: String, n: u32 },
+        Many(Vec<AllScalars>),
+    }
+
+    #[derive(Archive, Serialize, Deserialize, Debug, PartialEq)]
+    #[rkyv(crate, compare(PartialEq), derive(Debug))]
+    struct Inner {
+        scalars: AllScalars,
+        items: Vec<String>,
+        opt: Option<u64>,
+        tup: (u8, i32, String),
+        arr: [u16; 3],
+    }
+
+    #[derive(Archive, Serialize, Deserialize, Debug, PartialEq)]
+    #[rkyv(crate, compare(PartialEq), derive(Debug))]
+    struct Rich {
+        kind: Kind,
+        kinds: Vec<Kind>,
+        boxed: Box<Inner>,
+        maybe: Option<Box<Kind>>,
+        bytes: Vec<u8>,
+        btree: BTreeMap<String, Inner>,
+        // `u8` keys: `ArchivedHashMap<AK, _>: PartialEq<HashMap<K, _>>`
+        // requires `K: Borrow<AK>`, which `String`/`ArchivedString` don't
+        // satisfy. String-keyed maps are covered by the hegel test in
+        // `impls::std::collections::hash_map`.
+        hmap: HashMap<u8, i64>,
+        pairs: Vec<(String, Option<i32>)>,
+    }
+
+    #[hegel::composite]
+    fn chars(tc: &hegel::TestCase) -> char {
+        tc.draw(
+            hegel::one_of!(
+                generators::integers::<u32>().max_value(0x7F),
+                generators::integers::<u32>().max_value(0x10_FFFF),
+            )
+            .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')),
+        )
+    }
+
+    #[hegel::composite]
+    fn all_scalars(tc: &hegel::TestCase) -> AllScalars {
+        AllScalars {
+            b: tc.draw(generators::booleans()),
+            c: tc.draw(chars()),
+            i1: tc.draw(generators::integers::<i8>()),
+            i2: tc.draw(generators::integers::<i16>()),
+            i3: tc.draw(generators::integers::<i32>()),
+            i4: tc.draw(generators::integers::<i64>()),
+            i5: tc.draw(generators::integers::<i128>()),
+            u1: tc.draw(generators::integers::<u8>()),
+            u2: tc.draw(generators::integers::<u16>()),
+            u3: tc.draw(generators::integers::<u32>()),
+            u4: tc.draw(generators::integers::<u64>()),
+            u5: tc.draw(generators::integers::<u128>()),
+            f1: tc.draw(generators::floats::<f32>().allow_nan(false)),
+            f2: tc.draw(generators::floats::<f64>().allow_nan(false)),
+            nz: tc
+                .draw(generators::optional(
+                    generators::integers::<u32>().min_value(1),
+                ))
+                .map(|n| NonZeroU32::new(n).unwrap()),
+        }
+    }
+
+    #[hegel::composite]
+    fn kinds(tc: &hegel::TestCase) -> Kind {
+        match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => Kind::Unit,
+            1 => Kind::Int(tc.draw(generators::integers::<i64>())),
+            2 => Kind::Text {
+                s: tc.draw(generators::text().max_size(24)),
+                n: tc.draw(generators::integers::<u32>()),
+            },
+            _ => Kind::Many(tc.draw((generators::vecs(all_scalars()).max_size(4)).print_as_debug())),
+        }
+    }
+
+    #[hegel::composite]
+    fn inners(tc: &hegel::TestCase) -> Inner {
+        Inner {
+            scalars: tc.draw((all_scalars()).print_as_debug()),
+            items: tc.draw(
+                generators::vecs(generators::text().max_size(16)).max_size(4),
+            ),
+            opt: tc.draw(generators::optional(generators::integers::<u64>())),
+            tup: tc.draw(generators::tuples!(
+                generators::integers::<u8>(),
+                generators::integers::<i32>(),
+                generators::text().max_size(12),
+            )),
+            arr: tc.draw(generators::arrays(generators::integers::<u16>())),
+        }
+    }
+
+    #[hegel::composite]
+    fn riches(tc: &hegel::TestCase) -> Rich {
+        Rich {
+            kind: tc.draw((kinds()).print_as_debug()),
+            kinds: tc.draw((generators::vecs(kinds()).max_size(4)).print_as_debug()),
+            boxed: Box::new(tc.draw((inners()).print_as_debug())),
+            maybe: tc
+                .draw((generators::optional(kinds())).print_as_debug())
+                .map(Box::new),
+            bytes: tc.draw(generators::binary().max_size(64)),
+            btree: tc
+                .draw(
+                    (generators::vecs(generators::tuples!(
+                        generators::text().max_size(12),
+                        inners(),
+                    ))
+                    .max_size(4)).print_as_debug(),
+                )
+                .into_iter()
+                .collect(),
+            hmap: tc.draw(
+                generators::hashmaps(
+                    generators::integers::<u8>(),
+                    generators::integers::<i64>(),
+                )
+                .max_size(8),
+            ),
+            pairs: tc.draw(
+                generators::vecs(generators::tuples!(
+                    generators::text().max_size(12),
+                    generators::optional(generators::integers::<i32>()),
+                ))
+                .max_size(6),
+            ),
+        }
+    }
+
+    // Property: a rich derived type (nested structs/enums, containers,
+    // tuples, arrays, all scalar types) survives
+    // serialize -> validated access -> deserialize, and the archived value
+    // compares equal to the original (`compare(PartialEq)`).
+    #[hegel::test]
+    fn roundtrip_rich_derived_type(tc: hegel::TestCase) {
+        let value = tc.draw((riches()).print_as_debug());
+        roundtrip(&value);
+    }
+
+    #[derive(Archive, Serialize, Deserialize, Debug, PartialEq)]
+    #[rkyv(
+        crate,
+        bytecheck(bounds(__C: crate::validation::ArchiveContext)),
+        serialize_bounds(__S: Writer),
+        deserialize_bounds(__D::Error: Source),
+        compare(PartialEq),
+        derive(Debug),
+    )]
+    enum Chain {
+        End,
+        Link {
+            val: u32,
+            #[rkyv(omit_bounds)]
+            next: Box<Chain>,
+        },
+    }
+
+    // Property: recursive types round-trip at nesting depths well past what
+    // the hand-written `recursive_structures` test covers. Depth is drawn
+    // explicitly so deep structure paths are actually exercised.
+    #[hegel::test]
+    fn roundtrip_recursive_type_at_depth(tc: hegel::TestCase) {
+        let depth = tc.draw(generators::integers::<usize>().max_value(150));
+        let vals: Vec<u32> = tc.draw(
+            generators::vecs(generators::integers::<u32>())
+                .min_size(depth)
+                .max_size(depth),
+        );
+        let mut chain = Chain::End;
+        for val in vals {
+            chain = Chain::Link {
+                val,
+                next: Box::new(chain),
+            };
+        }
+        roundtrip(&chain);
+    }
+}
