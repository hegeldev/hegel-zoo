--- a/src/bytes.rs
+++ b/src/bytes.rs
@@ -146,4 +146,28 @@ mod tests {
             .gen(StdGen::new(::rand::thread_rng(), 257)) // pick byte boundary
             .quickcheck(p as fn(u64) -> bool);
     }
+
+    // Hegel port of prop_pack_in_out. Unlike the quickcheck version (which
+    // capped values at 257 to hit the one/two-byte boundary), this covers the
+    // full u64 range and explicitly boosts every pack_size byte boundary,
+    // since boundary conjunctions are where pack/unpack bugs would hide.
+    #[hegel::test]
+    fn prop_pack_in_out_hegel(tc: hegel::TestCase) {
+        use hegel::generators::{self, Generator};
+
+        let boundaries: Vec<u64> = (1..8u32)
+            .map(|i| 1u64 << (8 * i))
+            .flat_map(|b| vec![b - 1, b, b + 1])
+            .chain(vec![0, u64::MAX])
+            .collect();
+        let num: u64 = tc.draw(hegel::one_of!(
+            generators::integers::<u64>().boxed(),
+            generators::sampled_from(boundaries).boxed(),
+        ));
+
+        let mut buf = io::Cursor::new(vec![]);
+        let size = pack_uint(&mut buf, num).unwrap();
+        buf.set_position(0);
+        assert_eq!(num, unpack_uint(buf.get_ref(), size));
+    }
 }
