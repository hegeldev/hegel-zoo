+// Property: committing a batch of inserts/removes spanning several keyspaces
+// leaves each keyspace in exactly the state obtained by applying the operations
+// in order to a per-keyspace BTreeMap (later ops on the same key win, as
+// evidenced by `batch_multi_keys` below).
+#[hegel::test]
+fn batch_commit_matches_sequential_model(tc: hegel::TestCase) {
+    let folder = tempfile::tempdir().expect("tempdir should be created");
+    let db = Database::builder(&folder).open().expect("db should open");
+
+    let keyspace_count = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+    let keyspaces: Vec<_> = (0..keyspace_count)
+        .map(|i| {
+            db.keyspace(&format!("ks{i}"), KeyspaceCreateOptions::default)
+                .expect("keyspace creation should work")
+        })
+        .collect();
+    let mut models: Vec<BTreeMap<Vec<u8>, Vec<u8>>> = vec![BTreeMap::new(); keyspace_count];
+
+    let op_count = tc.draw(generators::integers::<usize>().max_value(20));
+    let mut batch = db.batch();
+
+    for _ in 0..op_count {
+        let i = tc.draw(generators::integers::<usize>().max_value(keyspace_count - 1));
+        // Tiny key space on purpose: duplicate keys within one batch exercise
+        // the last-write-wins behavior.
+        let key: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>().max_value(3))
+                .min_size(1)
+                .max_size(2),
+        );
+
+        if tc.draw(generators::booleans()) {
+            let value: Vec<u8> = tc.draw(generators::binary().max_size(8));
+            batch.insert(&keyspaces[i], key.as_slice(), value.as_slice());
+            models[i].insert(key, value);
+        } else {
+            batch.remove(&keyspaces[i], key.as_slice());
+            models[i].remove(&key);
+        }
+    }
+
+    // Nothing must be visible before the commit...
+    for keyspace in &keyspaces {
+        assert_eq!(0, keyspace.len().expect("len should work"));
+    }
+
+    batch.commit().expect("batch commit should work");
+
+    // ...and exactly the model state after it.
+    for (keyspace, model) in keyspaces.iter().zip(&models) {
+        let got: Vec<(Vec<u8>, Vec<u8>)> = keyspace
+            .iter()
+            .map(|guard| {
+                let (k, v) = guard.into_inner().expect("read kv");
+                (k.to_vec(), v.to_vec())
+            })
+            .collect();
+        let expected: Vec<(Vec<u8>, Vec<u8>)> = model
+            .iter()
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect();
+        assert_eq!(got, expected);
+    }
+}
