+// Property: `keyspace.prefix(p)` returns exactly the model entries whose key
+// starts with `p`, in ascending key order (evidence: `Keyspace::prefix` docs
+// and `keyspace_prefix_carl` below).
+#[hegel::test]
+fn prefix_matches_model(tc: TestCase) {
+    let folder = tempfile::tempdir().expect("tempdir should be created");
+    let db = Database::builder(&folder).open().expect("db should open");
+    let (keyspace, model) = setup_filled_keyspace(&tc, &db);
+
+    // Either an arbitrary prefix (often empty/unrelated) or a prefix of an
+    // existing key, so that non-empty results are common.
+    let prefix: Vec<u8> = if !model.is_empty() && tc.draw(generators::booleans()) {
+        let ki = tc.draw(generators::integers::<usize>().max_value(model.len() - 1));
+        let key = model.keys().nth(ki).expect("index is in range");
+        let len = tc.draw(generators::integers::<usize>().max_value(key.len()));
+        key[..len].to_vec()
+    } else {
+        tc.draw(generators::binary().max_size(5))
+    };
+
+    let got = collect(keyspace.prefix(prefix.as_slice()));
+    let expected: Vec<(Vec<u8>, Vec<u8>)> = model
+        .iter()
+        .filter(|(k, _)| k.starts_with(&prefix))
+        .map(|(k, v)| (k.clone(), v.clone()))
+        .collect();
+
+    assert_eq!(got, expected, "prefix({prefix:?}) disagrees with model");
