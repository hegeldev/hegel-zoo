 // Regression test for https://github.com/fjall-rs/fjall/issues/68
 
 use fjall::{Database, KeyspaceCreateOptions, KvSeparationOptions};
+use hegel::generators;
+
+// Property: inserting a key within the documented size limit never panics.
+// The crate docs (src/lib.rs and `Keyspace::insert`) say "Keys are limited to
+// 65536 bytes" / "Keys may be up to 65536 bytes long" and document no panic,
+// so any key of length 0..=65536 should either be stored or produce an `Err`.
+//
+// Key sizes are boosted towards the boundaries, per the boundary-value
+// pattern: uniform sizes would practically never hit 0 or 65535/65536.
+//
+// KNOWN FAILURE (suspected library bug, intentionally left failing — see
+// HEGEL_REPORT.md): the empty key panics ("key may not be empty",
+// lsm-tree/src/value.rs:45) and a 65536-byte key panics ("keys can be 65535
+// bytes in length", lsm-tree/src/key.rs:43) even though fjall's docs allow up
+// to 65536 bytes. Both panics happen *after* the journal record was written
+// (with the key length truncated `as u16`) and leave the whole Database
+// poisoned: every following operation returns `Err(Poisoned)`.
+#[hegel::test]
+fn insert_within_documented_key_limit_does_not_panic(tc: hegel::TestCase) {
+    let folder = tempfile::tempdir().expect("tempdir should be created");
+    let db = Database::builder(&folder).open().expect("db should open");
+    let tree = db
+        .keyspace("default", KeyspaceCreateOptions::default)
+        .expect("keyspace creation should work");
+
+    let size: usize = tc.draw(hegel::one_of!(
+        generators::integers::<usize>().max_value(64),
+        generators::sampled_from(vec![0, 1, 65_534, 65_535, 65_536]),
+    ));
+    let key: Vec<u8> = tc.draw(generators::binary().min_size(size).max_size(size));
+
+    // Must not panic; both Ok and Err are acceptable outcomes.
+    let _ = tree.insert(key.as_slice(), "v");
+}
 
