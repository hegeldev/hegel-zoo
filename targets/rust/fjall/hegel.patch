 use fjall::{Database, KeyspaceCreateOptions, Readable};
+use hegel::generators;
+use std::collections::BTreeMap;
 use test_log::test;
 
+// Property: a snapshot keeps showing exactly the database state from the
+// moment it was taken (per keyspace), no matter which writes, removes, clears
+// or flushes happen afterwards. Evidence: `Readable` docs ("Repeatable read"),
+// `clear_dirty_read` and `keyspace_snapshot_read` tests.
+#[hegel::test]
+fn snapshot_repeatable_read_matches_model(tc: hegel::TestCase) {
+    let folder = tempfile::tempdir().expect("tempdir should be created");
+    let db = Database::builder(&folder).open().expect("db should open");
+
+    let keyspace_count = tc.draw(generators::integers::<usize>().min_value(1).max_value(2));
+    let keyspaces: Vec<_> = (0..keyspace_count)
+        .map(|i| {
+            db.keyspace(&format!("ks{i}"), KeyspaceCreateOptions::default)
+                .expect("keyspace creation should work")
+        })
+        .collect();
+    let mut models: Vec<BTreeMap<Vec<u8>, Vec<u8>>> = vec![BTreeMap::new(); keyspace_count];
+
+    // Phase 1: build up some state.
+    let op_count = tc.draw(generators::integers::<usize>().max_value(20));
+    for _ in 0..op_count {
+        let i = tc.draw(generators::integers::<usize>().max_value(keyspace_count - 1));
+        let key: Vec<u8> = tc.draw(generators::binary().min_size(1).max_size(4));
+        let value: Vec<u8> = tc.draw(generators::binary().max_size(8));
+        keyspaces[i]
+            .insert(key.as_slice(), value.as_slice())
+            .expect("insert should work");
+        models[i].insert(key, value);
+    }
+
+    // Freeze: snapshot + copy of the model at this instant.
+    let snapshot = db.snapshot();
+    let frozen = models.clone();
+
+    // Phase 2: mutate the live database.
+    let op_count = tc.draw(generators::integers::<usize>().max_value(20));
+    for _ in 0..op_count {
+        let i = tc.draw(generators::integers::<usize>().max_value(keyspace_count - 1));
+        match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 | 1 => {
+                let key: Vec<u8> = tc.draw(generators::binary().min_size(1).max_size(4));
+                let value: Vec<u8> = tc.draw(generators::binary().max_size(8));
+                keyspaces[i]
+                    .insert(key.as_slice(), value.as_slice())
+                    .expect("insert should work");
+            }
+            2 => {
+                let key: Vec<u8> = tc.draw(generators::binary().min_size(1).max_size(4));
+                keyspaces[i]
+                    .remove(key.as_slice())
+                    .expect("remove should work");
+            }
+            3 => {
+                if tc.draw(generators::booleans()) {
+                    keyspaces[i].clear().expect("clear should work");
+                } else {
+                    keyspaces[i]
+                        .rotate_memtable_and_wait()
+                        .expect("rotation should work");
+                }
+            }
+            _ => unreachable!(),
+        }
+    }
+
+    // The snapshot must still see exactly the frozen state.
+    for (i, keyspace) in keyspaces.iter().enumerate() {
+        let got: Vec<(Vec<u8>, Vec<u8>)> = snapshot
+            .iter(keyspace)
+            .map(|guard| {
+                let (k, v) = guard.into_inner().expect("read kv");
+                (k.to_vec(), v.to_vec())
+            })
+            .collect();
+        let expected: Vec<(Vec<u8>, Vec<u8>)> = frozen[i]
+            .iter()
+            .map(|(k, v)| (k.clone(), v.clone()))
+            .collect();
+        assert_eq!(got, expected, "snapshot of ks{i} is not repeatable");
+
+        // Point reads through the snapshot must agree as well.
+        let probe: Vec<u8> = tc.draw(generators::binary().min_size(1).max_size(4));
+        assert_eq!(
+            snapshot
+                .get(keyspace, probe.as_slice())
+                .expect("get should work")
+                .as_deref(),
+            frozen[i].get(&probe).map(Vec::as_slice),
+        );
+    }
+}
