+// Property: `keyspace.range(r)` returns exactly the model entries within the
+// bounds, in ascending key order, for arbitrary Included/Excluded/Unbounded
+// bound combinations (evidence: `Keyspace::range` docs, BTreeMap-like API).
+#[hegel::test]
+fn range_matches_model(tc: TestCase) {
+    let folder = tempfile::tempdir().expect("tempdir should be created");
+    let db = Database::builder(&folder).open().expect("db should open");
+    let (keyspace, model) = setup_filled_keyspace(&tc, &db);
+
+    let draw_bound = || -> Bound<Vec<u8>> {
+        match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => Bound::Unbounded,
+            1 => Bound::Included(tc.draw(generators::binary().min_size(1).max_size(5))),
+            2 => Bound::Excluded(tc.draw(generators::binary().min_size(1).max_size(5))),
+            _ => unreachable!(),
+        }
+    };
+
+    let mut start = draw_bound();
+    let mut end = draw_bound();
+
+    // Keep the range well-formed (start <= end), like std ranges require.
+    if let (
+        Bound::Included(s) | Bound::Excluded(s),
+        Bound::Included(e) | Bound::Excluded(e),
+    ) = (&start, &end)
+    {
+        if s > e {
+            std::mem::swap(&mut start, &mut end);
+        }
+    }
+
+    let in_range = |k: &Vec<u8>| {
+        let lower_ok = match &start {
+            Bound::Unbounded => true,
+            Bound::Included(s) => k >= s,
+            Bound::Excluded(s) => k > s,
+        };
+        let upper_ok = match &end {
+            Bound::Unbounded => true,
+            Bound::Included(e) => k <= e,
+            Bound::Excluded(e) => k < e,
+        };
+        lower_ok && upper_ok
+    };
+
+    let got = collect(keyspace.range::<Vec<u8>, _>((start.clone(), end.clone())));
+    let expected: Vec<(Vec<u8>, Vec<u8>)> = model
+        .iter()
+        .filter(|(k, _)| in_range(k))
+        .map(|(k, v)| (k.clone(), v.clone()))
+        .collect();
+
+    assert_eq!(
+        got, expected,
+        "range({start:?}..{end:?}) disagrees with model",
+    );
+}
