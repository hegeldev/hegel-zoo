+//! Hegel properties for `human_format` (the Hegel zoo).
+//!
+//! The reference is a model of the documented behaviour written here: the scale tables of
+//! `Scales::SI/Binary/Time` and of a custom `with_base`/`with_suffixes` scale, the unit a
+//! value should be shown in (the largest whose scaled value is at least one), `{:.d}` of the
+//! scaled value, then separator, suffix and units. `try_parse` is `format`'s inverse up to the
+//! printed precision, and reads `number × multiplier` for any known suffix.
+//!
+//! The generators are values: a `Config` (scale kind, decimals, separator, units, micro sign)
+//! and a value in the scale's range, drawn as one case; the parsing property draws its numeral,
+//! known suffix and unknown suffix as one `Parsing` record.
+
+use hegel::generators::Generator as _;
+use hegel::{generators, TestCase};
+use human_format::{Formatter, ParseError, Scales};
+
+fn ints(lo: i64, hi: i64) -> generators::IntegerGenerator<i64> {
+    generators::integers().min_value(lo).max_value(hi)
+}
+
+/// `0..=hi` decimals.
+fn decimals(hi: usize) -> generators::IntegerGenerator<usize> {
+    generators::integers().min_value(0).max_value(hi)
+}
+
+/// `Some` of a draw from `g` with probability `p`, `None` otherwise; shrinks to `None`.
+fn maybe<T: hegel::PrettyPrintable>(
+    p: f64,
+    g: impl hegel::PrintableGenerator<T>,
+) -> impl hegel::PrintableGenerator<Option<T>> {
+    hegel::tuples!(generators::weighted_booleans(p), g).map(|(present, v)| present.then_some(v))
+}
+
+// ---------------------------------------------------------------------------------------
+// Scales
+// ---------------------------------------------------------------------------------------
+
+const SI_POS: &[&str] = &["", "k", "M", "G", "T", "P", "E", "Z", "Y", "R", "Q"];
+const SI_NEG: &[&str] = &["", "m", "u", "n", "p", "f", "a", "z", "y", "r", "q"];
+const BIN_POS: &[&str] = &["", "Ki", "Mi", "Gi", "Ti", "Pi", "Ei", "Zi", "Yi", "Ri", "Qi"];
+/// Custom suffixes: none of them is an SI fraction suffix (those stay in force for values
+/// below one), and none is a tail of another.
+const CUSTOM_POOL: &[&str] = &["K", "Mi", "X", "Big", "th", "°", "kk", "Gig"];
+const CUSTOM_BASES: &[u32] = &[2, 10, 60, 1000, 1024, 4096];
+
+const YEAR: f64 = 365.2425 * 86400.0;
+const MONTH: f64 = YEAR / 12.0;
+
+/// `Scales::Time()`'s table (seconds per unit), as the documentation describes it.
+const TIME_TABLE: &[(&str, f64)] = &[
+    ("ns", 1e-9),
+    ("us", 1e-6),
+    ("ms", 1e-3),
+    ("s", 1.0),
+    ("m", 60.0),
+    ("h", 3600.0),
+    ("d", 86400.0),
+    ("w", 604800.0),
+    ("mo", MONTH),
+    ("month", MONTH),
+    ("qtr", 3.0 * MONTH),
+    ("y", YEAR),
+    ("yr", YEAR),
+    ("year", YEAR),
+    ("dec", 10.0 * YEAR),
+    ("decade", 10.0 * YEAR),
+    ("c", 100.0 * YEAR),
+    ("century", 100.0 * YEAR),
+    ("kyr", 1000.0 * YEAR),
+    ("millennium", 1000.0 * YEAR),
+    ("Myr", 1.0e6 * YEAR),
+    ("Gyr", 1.0e9 * YEAR),
+];
+
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Kind {
+    Si,
+    Binary,
+    Time,
+    Custom { base: u32, suffixes: Vec<&'static str> },
+}
+
+impl Kind {
+    fn scales(&self) -> Scales {
+        match self {
+            Kind::Si => Scales::SI(),
+            Kind::Binary => Scales::Binary(),
+            Kind::Custom { base, suffixes } => {
+                let mut s = Scales::new();
+                s.with_base(*base).with_suffixes(suffixes.clone());
+                s
+            }
+            Kind::Time => Scales::Time(),
+        }
+    }
+
+    fn base(&self) -> f64 {
+        match self {
+            Kind::Si => 1000.0,
+            Kind::Binary => 1024.0,
+            Kind::Custom { base, .. } => *base as f64,
+            Kind::Time => 1.0,
+        }
+    }
+
+    fn pos(&self) -> Vec<&'static str> {
+        match self {
+            Kind::Si => SI_POS.to_vec(),
+            Kind::Binary => BIN_POS.to_vec(),
+            Kind::Custom { suffixes, .. } => suffixes.clone(),
+            Kind::Time => Vec::new(),
+        }
+    }
+
+    fn neg(&self) -> Vec<&'static str> {
+        match self {
+            Kind::Si | Kind::Custom { .. } => SI_NEG.to_vec(),
+            Kind::Binary => vec![""],
+            Kind::Time => Vec::new(),
+        }
+    }
+
+    /// Every suffix `try_parse` knows, with its multiplier (`µ` is read as `u`).
+    fn known(&self) -> Vec<(String, f64)> {
+        let mut out = Vec::new();
+        if let Kind::Time = self {
+            return TIME_TABLE.iter().map(|(s, m)| (s.to_string(), *m)).collect();
+        }
+        let base = self.base();
+        for (i, s) in self.pos().iter().enumerate() {
+            out.push((s.to_string(), base.powi(i as i32)));
+        }
+        for (i, s) in self.neg().iter().enumerate() {
+            if !out.iter().any(|(k, _)| k == s) {
+                out.push((s.to_string(), base.powi(-(i as i32))));
+            }
+            if *s == "u" {
+                out.push(("µ".to_string(), base.powi(-(i as i32))));
+            }
+        }
+        out
+    }
+
+    /// The largest multiplier `parse_or_clamp(_, true)` falls back to.
+    fn clamp_multiplier(&self) -> f64 {
+        match self {
+            Kind::Time => TIME_TABLE.iter().map(|(_, m)| *m).fold(f64::NEG_INFINITY, f64::max),
+            _ => self.base().powi(self.pos().len() as i32 - 1),
+        }
+    }
+
+    /// `try_parse` strips the units with `trim_end_matches`, which also eats a suffix ending
+    /// in the units (human_format/4): whether these units end one of this scale's suffixes.
+    fn units_collide(&self, units: &str) -> bool {
+        !units.is_empty()
+            && self
+                .known()
+                .iter()
+                .any(|(s, _)| format!("{s}{units}").trim_end_matches(units) != s.as_str())
+    }
+
+    /// The decades a value of this scale should span.
+    fn decades(&self) -> (i32, i32) {
+        match self {
+            Kind::Si => (-36, 36),
+            Kind::Binary => (-4, 40),
+            Kind::Custom { base, suffixes } => {
+                let span = ((*base as f64).log10().ceil() as i32) * suffixes.len() as i32;
+                (-36, span + 4)
+            }
+            Kind::Time => (-12, 20),
+        }
+    }
+}
+
+/// A custom scale: a base from the table and one to five distinct suffixes, the first of them
+/// empty two times in three (values below the base then print without a suffix, as with SI).
+fn custom_kind() -> impl hegel::PrintableGenerator<Kind> {
+    let first = hegel::one_of!(
+        generators::just(""),
+        generators::just(""),
+        generators::sampled_from(CUSTOM_POOL),
+    );
+    let rest = generators::vecs(generators::sampled_from(CUSTOM_POOL))
+        .max_size(4)
+        .unique(true);
+    hegel::tuples!(generators::sampled_from(CUSTOM_BASES), first, rest).map(
+        |(base, first, rest)| {
+            let mut suffixes = vec![first];
+            suffixes.extend(rest.into_iter().filter(|s| *s != first));
+            Kind::Custom { base, suffixes }
+        },
+    )
+}
+
+/// One of the four scale kinds, SI first.
+fn kind() -> impl hegel::PrintableGenerator<Kind> {
+    hegel::one_of!(
+        generators::just(Kind::Si),
+        generators::just(Kind::Binary),
+        generators::just(Kind::Time),
+        custom_kind(),
+    )
+}
+
+// ---------------------------------------------------------------------------------------
+// Formatter configurations
+// ---------------------------------------------------------------------------------------
+
+const UNITS_POOL: &[&str] = &["", "B", "B/s", "bytes", "°C", "m", "s", "i", "Crabs"];
+const SEPARATOR_POOL: &[&str] = &[" ", "", "_", "  ", " | "];
+/// `try_parse` trims the text before removing the separator, so a separator with trailing
+/// whitespace after other characters (` | `) is not recognised when the suffix is empty
+/// (human_format/6): the separators the parsing properties use.
+const PARSEABLE_SEPARATORS: &[&str] = &[" ", "", "_", "  "];
+
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Config {
+    kind: Kind,
+    decimals: usize,
+    separator: &'static str,
+    units: &'static str,
+    micro: bool,
+}
+
+impl Config {
+    fn formatter(&self) -> Formatter {
+        let mut f = Formatter::new();
+        f.with_decimals(self.decimals)
+            .with_separator(self.separator)
+            .with_scales(self.kind.scales())
+            .with_units(self.units)
+            .with_micro_sign(self.micro);
+        f
+    }
+}
+
+/// A configuration: the given scale, 0–4 decimals, a separator from `separators`, the given
+/// units, the micro sign three times in ten.
+fn configured(
+    kind: impl hegel::PrintableGenerator<Kind>,
+    separators: &'static [&'static str],
+    units: impl hegel::PrintableGenerator<&'static str>,
+) -> impl hegel::PrintableGenerator<Config> {
+    hegel::tuples!(
+        kind,
+        decimals(4),
+        generators::sampled_from(separators),
+        units,
+        generators::weighted_booleans(0.3)
+    )
+    .map(|(kind, decimals, separator, units, micro)| Config {
+        kind,
+        decimals,
+        separator,
+        units,
+        micro,
+    })
+}
+
+/// Any configuration: every scale kind, separator and units string.
+fn config() -> impl hegel::PrintableGenerator<Config> {
+    configured(kind(), SEPARATOR_POOL, generators::sampled_from(UNITS_POOL))
+}
+
+/// A configuration whose `format` output `try_parse` reads back: no dangling separator
+/// (human_format/6) and units that do not end one of the scale's suffixes (human_format/4).
+#[hegel::composite]
+fn parseable_config(tc: &TestCase) -> Config {
+    let kind = tc.draw(kind());
+    let scale = kind.clone();
+    tc.draw(configured(
+        generators::just(kind),
+        PARSEABLE_SEPARATORS,
+        generators::sampled_from(UNITS_POOL).filter(move |units| !scale.units_collide(units)),
+    ))
+}
+
+// ---------------------------------------------------------------------------------------
+// The model
+// ---------------------------------------------------------------------------------------
+
+fn rounded(v: f64, decimals: usize) -> f64 {
+    format!("{v:.decimals$}").parse().unwrap()
+}
+
+/// The unit a positive finite value is shown in.
+struct Choice {
+    /// The scaled value, computed with the same divisions the crate makes.
+    scaled: f64,
+    /// Its multiplier (for the round trip's tolerance).
+    mult: f64,
+    /// The suffixes that denote the unit (synonyms in the time table).
+    suffixes: Vec<String>,
+    /// Whether the value printed at this precision still reads below the next unit — the
+    /// crate picks the unit before rounding (human_format/2), so the general property keeps
+    /// to values where that makes no difference.
+    stable: bool,
+}
+
+fn choose(kind: &Kind, x: f64, decimals: usize) -> Choice {
+    if let Kind::Time = kind {
+        let mut table = TIME_TABLE.to_vec();
+        table.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap());
+        let mult = table
+            .iter()
+            .find(|(_, m)| x >= *m)
+            .map(|(_, m)| *m)
+            .unwrap_or(table.last().unwrap().1);
+        let suffixes = table.iter().filter(|(_, m)| *m == mult).map(|(s, _)| s.to_string()).collect();
+        let scaled = x / mult;
+        let next = table.iter().rev().find(|(_, m)| *m > mult).map(|(_, m)| *m);
+        let stable = next.is_none_or(|next| rounded(scaled, decimals) * mult < next);
+        return Choice { scaled, mult, suffixes, stable };
+    }
+    let base = kind.base();
+    let pos = kind.pos();
+    let neg = kind.neg();
+    let last = pos.len() - 1;
+    let last_neg = neg.len() - 1;
+    if x >= base {
+        let mut v = x;
+        let mut k = 0;
+        while v >= base && k < last {
+            v /= base;
+            k += 1;
+        }
+        let stable = !(k < last && rounded(v, decimals) >= base);
+        Choice { scaled: v, mult: base.powi(k as i32), suffixes: vec![pos[k].to_string()], stable }
+    } else if x > 0.0 && x < 1.0 {
+        let mut v = x;
+        let mut j = 0;
+        while v < 1.0 && j < last_neg {
+            v *= base;
+            j += 1;
+        }
+        let stable = !(j >= 1 && rounded(v, decimals) >= base);
+        Choice { scaled: v, mult: base.powi(-(j as i32)), suffixes: vec![neg[j].to_string()], stable }
+    } else {
+        let stable = !(last >= 1 && rounded(x, decimals) >= base);
+        Choice { scaled: x, mult: 1.0, suffixes: vec![pos[0].to_string()], stable }
+    }
+}
+
+/// The texts `format(x)` may produce (several only for time synonyms), or `None` when the
+/// value is one where the crate's pre-rounding unit choice differs from the model's.
+fn expected(cfg: &Config, x: f64) -> Option<Vec<String>> {
+    if x.is_nan() {
+        return Some(vec!["NaN".to_string()]);
+    }
+    if x < 0.0 {
+        return expected(cfg, -x).map(|v| v.into_iter().map(|s| format!("-{s}")).collect());
+    }
+    if x.is_infinite() {
+        return Some(vec!["inf".to_string()]);
+    }
+    let d = cfg.decimals;
+    if x == 0.0 {
+        // Below one with nothing to scale: the first suffix (the time table has none —
+        // human_format/1).
+        let suffix = cfg.kind.pos().first().copied().unwrap_or("");
+        return Some(vec![format!("{x:.d$}{}{suffix}{}", cfg.separator, cfg.units)]);
+    }
+    let choice = choose(&cfg.kind, x, d);
+    if !choice.stable {
+        return None;
+    }
+    Some(
+        choice
+            .suffixes
+            .iter()
+            .map(|s| {
+                let s = if cfg.micro && s == "u" { "µ" } else { s.as_str() };
+                format!("{:.d$}{}{s}{}", choice.scaled, cfg.separator, cfg.units)
+            })
+            .collect(),
+    )
+}
+
+// ---------------------------------------------------------------------------------------
+// Numbers
+// ---------------------------------------------------------------------------------------
+
+const DIGITS: &str = "0123456789";
+
+/// A finite, non-zero decimal number with its leading digit in decade `lo..=hi` and 1–12
+/// significant digits, negative one time in four.
+fn decimal(lo: i32, hi: i32) -> impl hegel::PrintableGenerator<f64> {
+    hegel::tuples!(
+        ints(lo as i64, hi as i64),
+        generators::weighted_booleans(0.25),
+        ints(1, 9),
+        generators::text().alphabet(DIGITS).max_size(11)
+    )
+    .map(|(exp, negative, lead, rest)| {
+        let sign = if negative { "-" } else { "" };
+        format!("{sign}{lead}.{rest}e{exp}").parse().unwrap()
+    })
+}
+
+/// A value in the range the scale is meant for.
+fn value(kind: &Kind) -> impl hegel::PrintableGenerator<f64> {
+    let (lo, hi) = kind.decades();
+    decimal(lo, hi)
+}
+
+/// Zero and the non-finite values ...
+const SPECIAL: &[f64] = &[0.0, f64::NAN, f64::INFINITY, f64::NEG_INFINITY];
+/// ... without zero, which `Scales::Time()` cannot format (human_format/1).
+const NON_FINITE: &[f64] = &[f64::NAN, f64::INFINITY, f64::NEG_INFINITY];
+
+/// A configuration and a value to format: one in the scale's range four times in five, zero
+/// or a non-finite value otherwise.
+#[hegel::composite]
+fn formatting_case(tc: &TestCase) -> (Config, f64) {
+    let cfg = tc.draw(config());
+    let special = if matches!(cfg.kind, Kind::Time) { NON_FINITE } else { SPECIAL };
+    let x = tc.draw(hegel::one_of!(
+        value(&cfg.kind),
+        value(&cfg.kind),
+        value(&cfg.kind),
+        value(&cfg.kind),
+        generators::sampled_from(special),
+    ));
+    (cfg, x)
+}
+
+/// A parseable configuration and a value in its scale's range.
+#[hegel::composite]
+fn round_trip_case(tc: &TestCase) -> (Config, f64) {
+    let cfg = tc.draw(parseable_config());
+    let x = tc.draw(value(&cfg.kind));
+    (cfg, x)
+}
+
+/// A decimal numeral as `try_parse` reads it: one to six integer digits, followed three times
+/// in five by a point and up to four more digits; or a point and one to four digits; a leading
+/// `-` three times in ten.
+fn numeral() -> impl hegel::PrintableGenerator<String> {
+    let digits = |lo: usize, hi: usize| {
+        generators::text()
+            .alphabet(DIGITS)
+            .min_size(lo)
+            .max_size(hi)
+    };
+    let unsigned = hegel::one_of!(
+        hegel::tuples!(digits(1, 6), maybe(0.6, digits(0, 4))).map(|(int, frac)| match frac {
+            Some(frac) => format!("{int}.{frac}"),
+            None => int,
+        }),
+        digits(1, 4).map(|frac| format!(".{frac}")),
+    );
+    hegel::tuples!(generators::weighted_booleans(0.3), unsigned)
+        .map(|(negative, n)| if negative { format!("-{n}") } else { n })
+}
+
+/// Suffix candidates no scale in the zoo's tables should know — each is checked against the
+/// drawn scale (`K`, `Ki`, `Q` and `mm` are known to some).
+const UNKNOWN_POOL: &[&str] = &["ZZ", "kB", "Ki", "K", "Q", "mm", "yy", "x"];
+
+/// One parsing case: a parseable configuration, a numeral, a suffix the scale knows with its
+/// multiplier, and a suffix it does not know (and the units do not end).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Parsing {
+    cfg: Config,
+    numeral: String,
+    suffix: String,
+    mult: f64,
+    unknown: &'static str,
+}
+
+#[hegel::composite]
+fn parsing_case(tc: &TestCase) -> Parsing {
+    let cfg = tc.draw(parseable_config());
+    let numeral = tc.draw(numeral());
+    let known = cfg.kind.known();
+    let (suffix, mult) = tc.draw(generators::sampled_from(known.clone()));
+    let unknown: Vec<&'static str> = UNKNOWN_POOL
+        .iter()
+        .copied()
+        .filter(|u| !known.iter().any(|(s, _)| s == u) && u.trim_end_matches(cfg.units) == *u)
+        .collect();
+    let unknown = tc.draw(generators::sampled_from(unknown));
+    Parsing { cfg, numeral, suffix, mult, unknown }
+}
+
+/// A time value: a multiplier of the time table times 1.00–2.90.
+fn time_value() -> impl hegel::PrintableGenerator<f64> {
+    hegel::tuples!(generators::sampled_from(TIME_TABLE), ints(0, 190))
+        .map(|((_, mult), hundredths)| mult * (1.0 + hundredths as f64 / 100.0))
+}
+
+// ---------------------------------------------------------------------------------------
+// Properties
+// ---------------------------------------------------------------------------------------
+
+/// `format` is the model: the largest unit the value reaches, `{:.d}` of the scaled value,
+/// separator, suffix, units; `NaN`, `inf`, and a leading `-` for negatives.
+#[hegel::test]
+fn formatting_matches_the_model(tc: TestCase) {
+    let (cfg, x) = tc.draw(formatting_case());
+    let expected = expected(&cfg, x);
+    // the crate picks the unit before rounding (human_format/2): no verdict where that shows
+    tc.assume(expected.is_some());
+    let expected = expected.unwrap();
+    let out = cfg.formatter().format(x);
+    assert!(expected.contains(&out), "{cfg:?} formatting {x:e}: {out:?}, expected one of {expected:?}");
+}
+
+/// `try_parse(format(x))` is `x` up to half a unit in the last printed decimal of the scaled
+/// value.
+#[hegel::test]
+fn formatting_and_parsing_round_trip(tc: TestCase) {
+    let (cfg, x) = tc.draw(round_trip_case());
+    let f = cfg.formatter();
+    let text = f.format(x);
+    let parsed = f
+        .try_parse(&text)
+        .unwrap_or_else(|e| panic!("{cfg:?}: {text:?} (from {x:e}) failed to parse: {e}"));
+    let choice = choose(&cfg.kind, x.abs(), cfg.decimals);
+    let tolerance = 0.5 * 10f64.powi(-(cfg.decimals as i32)) * choice.mult * (1.0 + 1e-9) + x.abs() * 1e-12;
+    assert!(
+        (parsed - x).abs() <= tolerance,
+        "{cfg:?}: {x:e} -> {text:?} -> {parsed:e} (tolerance {tolerance:e})"
+    );
+}
+
+/// A number followed by a known suffix (and the units) parses to `number × multiplier`; an
+/// unknown suffix is `UnknownSuffix`, and `parse_or_clamp` reads it as the largest one.
+#[hegel::test]
+fn parsing_reads_number_times_multiplier(tc: TestCase) {
+    let Parsing { cfg, numeral, suffix, mult, unknown } = tc.draw(parsing_case());
+    let f = cfg.formatter();
+    let value: f64 = numeral.parse().unwrap();
+    let text = format!("{numeral}{}{suffix}{}", cfg.separator, cfg.units);
+    let expected = value * mult;
+    match f.try_parse(&text) {
+        Ok(p) => assert_eq!(p, expected, "{cfg:?}: {text:?}"),
+        Err(e) => panic!("{cfg:?}: {text:?} failed to parse: {e}"),
+    }
+    assert_eq!(f.parse_or_clamp(&text, false).unwrap(), expected, "{cfg:?}: clamp=false {text:?}");
+    assert_eq!(f.parse_or_clamp(&text, true).unwrap(), expected, "{cfg:?}: clamp=true {text:?}");
+
+    let text = format!("{numeral}{}{unknown}{}", cfg.separator, cfg.units);
+    assert!(
+        matches!(f.try_parse(&text), Err(ParseError::UnknownSuffix(_))),
+        "{cfg:?}: {text:?} should be an unknown suffix"
+    );
+    assert!(matches!(f.parse_or_clamp(&text, false), Err(ParseError::UnknownSuffix(_))));
+    assert_eq!(
+        f.parse_or_clamp(&text, true).unwrap(),
+        value * cfg.kind.clamp_multiplier(),
+        "{cfg:?}: clamped {text:?}"
+    );
+}
+
+/// Formatting with `Scales::Time()` gives the same text from every `Formatter`.
+#[hegel::test]
+fn time_formatting_is_deterministic(tc: TestCase) {
+    let x = tc.draw(time_value());
+    let decimals = tc.draw(decimals(3));
+    let texts: Vec<String> = (0..8)
+        .map(|_| {
+            let mut f = Formatter::new();
+            f.with_scales(Scales::Time()).with_decimals(decimals);
+            f.format(x)
+        })
+        .collect();
+    assert!(texts.iter().all(|t| t == &texts[0]), "{x:e}: {texts:?}");
+}
+
+// ---------------------------------------------------------------------------------------
+// Pins
+// ---------------------------------------------------------------------------------------
+
+/// human_format/1: `Scales::Time()` has no positional suffixes, and zero indexes them.
+#[test]
+fn time_scale_formats_zero() {
+    let mut f = Formatter::new();
+    f.with_scales(Scales::Time());
+    let out = f.format(0.0);
+    assert!(out.starts_with("0.00"), "{out:?}");
+}
+
+/// human_format/2: the unit is chosen before rounding, so the printed value reaches the base.
+#[test]
+fn scaled_values_stay_below_the_base() {
+    assert_eq!(Formatter::new().format(999_999.0), "1.00 M");
+    assert_eq!(Formatter::new().format(0.999_999_9), "1.00 ");
+    assert_eq!(Formatter::new().format(999.999), "1.00 k");
+    let mut f = Formatter::new();
+    f.with_scales(Scales::Time());
+    assert_eq!(f.format(59.999), "1.00 m");
+}
+
+/// human_format/3: synonyms in the time table are picked in `HashMap` order.
+#[test]
+fn time_synonyms_format_consistently() {
+    let texts: Vec<String> = (0..32)
+        .map(|_| {
+            let mut f = Formatter::new();
+            f.with_scales(Scales::Time());
+            f.format(YEAR)
+        })
+        .collect();
+    assert!(texts.iter().all(|t| t == &texts[0]), "{texts:?}");
+}
+
+/// human_format/4: the units are stripped with `trim_end_matches`, repeatedly.
+#[test]
+fn units_are_stripped_once_when_parsing() {
+    let mut metres = Formatter::new();
+    metres.with_units("m");
+    assert_eq!(metres.format(0.001), "1.00 mm");
+    assert_eq!(metres.try_parse("1.00 mm").unwrap(), 0.001);
+    let mut bytes = Formatter::new();
+    bytes.with_units("B");
+    assert!(bytes.try_parse("1.50 kBB").is_err(), "kBB is not a suffix");
+}
+
+/// human_format/6: the input is trimmed before the separator is removed, so the formatter's
+/// own `1.00 | ` (separator ` | `, no suffix) does not parse.
+#[test]
+fn separator_survives_trimming_when_the_suffix_is_empty() {
+    let mut f = Formatter::new();
+    f.with_separator(" | ");
+    assert_eq!(f.format(1500.0), "1.50 | k");
+    assert_eq!(f.try_parse("1.50 | k").unwrap(), 1500.0);
+    let text = f.format(1.0);
+    assert_eq!(text, "1.00 | ");
+    assert_eq!(f.try_parse(&text).unwrap(), 1.0);
+}
+
+/// human_format/5: `format` writes `inf`/`-inf`/`NaN`, which `try_parse` rejects.
+#[test]
+fn formatter_output_for_infinities_parses() {
+    let f = Formatter::new();
+    assert_eq!(f.try_parse(&f.format(f64::INFINITY)).unwrap(), f64::INFINITY);
+    assert_eq!(f.try_parse(&f.format(f64::NEG_INFINITY)).unwrap(), f64::NEG_INFINITY);
+}
