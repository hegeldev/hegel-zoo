+//! Hegel properties for `human_format` (the Hegel zoo).
+//!
+//! The reference is a model of the documented behaviour written here: the scale tables of
+//! `Scales::SI/Binary/Time` and of a custom `with_base`/`with_suffixes` scale, the unit a
+//! value should be shown in (the largest whose scaled value is at least one), `{:.d}` of the
+//! scaled value, then separator, suffix and units. `try_parse` is `format`'s inverse up to the
+//! printed precision, and reads `number × multiplier` for any known suffix.
+
+use std::fmt::Debug;
+
+use hegel::{generators, TestCase};
+use human_format::{Formatter, ParseError, Scales};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+fn n(tc: &TestCase, lo: usize, hi: usize) -> usize {
+    tc.draw(int!(lo as i64, hi as i64)) as usize
+}
+
+fn pick<T: Clone + Debug + Send + Sync + 'static>(tc: &TestCase, items: &[T]) -> T {
+    items[n(tc, 0, items.len() - 1)].clone()
+}
+
+/// True with probability `pct` percent.
+fn chance(tc: &TestCase, pct: usize) -> bool {
+    n(tc, 0, 99) < pct
+}
+
+// ---------------------------------------------------------------------------------------
+// Scales
+// ---------------------------------------------------------------------------------------
+
+const SI_POS: &[&str] = &["", "k", "M", "G", "T", "P", "E", "Z", "Y", "R", "Q"];
+const SI_NEG: &[&str] = &["", "m", "u", "n", "p", "f", "a", "z", "y", "r", "q"];
+const BIN_POS: &[&str] = &["", "Ki", "Mi", "Gi", "Ti", "Pi", "Ei", "Zi", "Yi", "Ri", "Qi"];
+/// Custom suffixes: none of them is an SI fraction suffix (those stay in force for values
+/// below one), and none is a tail of another.
+const CUSTOM_POOL: &[&str] = &["K", "Mi", "X", "Big", "th", "°", "kk", "Gig"];
+
+/// `Scales::Time()`'s table (seconds per unit), as the documentation describes it.
+fn time_table() -> Vec<(&'static str, f64)> {
+    let year = 365.2425 * 86400.0;
+    let month = year / 12.0;
+    vec![
+        ("ns", 1e-9),
+        ("us", 1e-6),
+        ("ms", 1e-3),
+        ("s", 1.0),
+        ("m", 60.0),
+        ("h", 3600.0),
+        ("d", 86400.0),
+        ("w", 604800.0),
+        ("mo", month),
+        ("month", month),
+        ("qtr", 3.0 * month),
+        ("y", year),
+        ("yr", year),
+        ("year", year),
+        ("dec", 10.0 * year),
+        ("decade", 10.0 * year),
+        ("c", 100.0 * year),
+        ("century", 100.0 * year),
+        ("kyr", 1000.0 * year),
+        ("millennium", 1000.0 * year),
+        ("Myr", 1.0e6 * year),
+        ("Gyr", 1.0e9 * year),
+    ]
+}
+
+#[derive(Clone, Debug)]
+enum Kind {
+    Si,
+    Binary,
+    Custom { base: u32, suffixes: Vec<&'static str> },
+    Time,
+}
+
+impl Kind {
+    fn scales(&self) -> Scales {
+        match self {
+            Kind::Si => Scales::SI(),
+            Kind::Binary => Scales::Binary(),
+            Kind::Custom { base, suffixes } => {
+                let mut s = Scales::new();
+                s.with_base(*base).with_suffixes(suffixes.clone());
+                s
+            }
+            Kind::Time => Scales::Time(),
+        }
+    }
+
+    fn base(&self) -> f64 {
+        match self {
+            Kind::Si => 1000.0,
+            Kind::Binary => 1024.0,
+            Kind::Custom { base, .. } => *base as f64,
+            Kind::Time => 1.0,
+        }
+    }
+
+    fn pos(&self) -> Vec<&'static str> {
+        match self {
+            Kind::Si => SI_POS.to_vec(),
+            Kind::Binary => BIN_POS.to_vec(),
+            Kind::Custom { suffixes, .. } => suffixes.clone(),
+            Kind::Time => Vec::new(),
+        }
+    }
+
+    fn neg(&self) -> Vec<&'static str> {
+        match self {
+            Kind::Si | Kind::Custom { .. } => SI_NEG.to_vec(),
+            Kind::Binary => vec![""],
+            Kind::Time => Vec::new(),
+        }
+    }
+
+    /// Every suffix `try_parse` knows, with its multiplier (`µ` is read as `u`).
+    fn known(&self) -> Vec<(String, f64)> {
+        let mut out = Vec::new();
+        if let Kind::Time = self {
+            for (s, m) in time_table() {
+                out.push((s.to_string(), m));
+            }
+            return out;
+        }
+        let base = self.base();
+        for (i, s) in self.pos().iter().enumerate() {
+            out.push((s.to_string(), base.powi(i as i32)));
+        }
+        for (i, s) in self.neg().iter().enumerate() {
+            if !out.iter().any(|(k, _)| k == s) {
+                out.push((s.to_string(), base.powi(-(i as i32))));
+            }
+            if *s == "u" {
+                out.push(("µ".to_string(), base.powi(-(i as i32))));
+            }
+        }
+        out
+    }
+
+    /// The largest multiplier `parse_or_clamp(_, true)` falls back to.
+    fn clamp_multiplier(&self) -> f64 {
+        match self {
+            Kind::Time => time_table().iter().map(|(_, m)| *m).fold(f64::NEG_INFINITY, f64::max),
+            _ => self.base().powi(self.pos().len() as i32 - 1),
+        }
+    }
+}
+
+fn arb_kind(tc: &TestCase) -> Kind {
+    match n(tc, 0, 3) {
+        0 => Kind::Si,
+        1 => Kind::Binary,
+        2 => Kind::Time,
+        _ => {
+            let base = pick(tc, &[2u32, 10, 60, 1000, 1024, 4096]);
+            let count = n(tc, 1, 5);
+            let mut suffixes: Vec<&'static str> = Vec::new();
+            for i in 0..count {
+                let s = if i == 0 && chance(tc, 70) { "" } else { pick(tc, CUSTOM_POOL) };
+                if !suffixes.contains(&s) {
+                    suffixes.push(s);
+                }
+            }
+            Kind::Custom { base, suffixes }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// Formatter configurations
+// ---------------------------------------------------------------------------------------
+
+const UNITS_POOL: &[&str] = &["", "B", "B/s", "bytes", "°C", "m", "s", "i", "Crabs"];
+const SEPARATOR_POOL: &[&str] = &[" ", "", "_", "  ", " | "];
+
+#[derive(Clone, Debug)]
+struct Config {
+    kind: Kind,
+    decimals: usize,
+    separator: &'static str,
+    units: &'static str,
+    micro: bool,
+}
+
+impl Config {
+    fn formatter(&self) -> Formatter {
+        let mut f = Formatter::new();
+        f.with_decimals(self.decimals)
+            .with_separator(self.separator)
+            .with_scales(self.kind.scales())
+            .with_units(self.units)
+            .with_micro_sign(self.micro);
+        f
+    }
+
+    /// `try_parse` trims the text before removing the separator, so a separator with
+    /// trailing whitespace after other characters (` | `) is not recognised when the suffix
+    /// is empty (human_format/6) — the parsing properties avoid that shape.
+    fn separator_dangles(&self) -> bool {
+        let sep = self.separator;
+        !sep.trim().is_empty() && sep.trim_end() != sep
+    }
+
+    /// `try_parse` strips the units with `trim_end_matches`, which also eats a suffix ending
+    /// in the units (human_format/4) — the general generators avoid that shape.
+    fn units_collide(&self) -> bool {
+        if self.units.is_empty() {
+            return false;
+        }
+        let mut suffixes: Vec<String> = self.kind.known().into_iter().map(|(s, _)| s).collect();
+        suffixes.push("µ".to_string());
+        suffixes.iter().any(|s| {
+            let text = format!("{s}{}", self.units);
+            text.trim_end_matches(self.units) != s.as_str()
+        })
+    }
+}
+
+fn arb_config(tc: &TestCase) -> Config {
+    Config {
+        kind: arb_kind(tc),
+        decimals: n(tc, 0, 4),
+        separator: pick(tc, SEPARATOR_POOL),
+        units: pick(tc, UNITS_POOL),
+        micro: chance(tc, 30),
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// The model
+// ---------------------------------------------------------------------------------------
+
+fn rounded(v: f64, decimals: usize) -> f64 {
+    format!("{v:.decimals$}").parse().unwrap()
+}
+
+/// The unit a positive finite value is shown in.
+struct Choice {
+    /// The scaled value, computed with the same divisions the crate makes.
+    scaled: f64,
+    /// Its multiplier (for the round trip's tolerance).
+    mult: f64,
+    /// The suffixes that denote the unit (synonyms in the time table).
+    suffixes: Vec<String>,
+    /// Whether the value printed at this precision still reads below the next unit — the
+    /// crate picks the unit before rounding (human_format/2), so the general property keeps
+    /// to values where that makes no difference.
+    stable: bool,
+}
+
+fn choose(kind: &Kind, x: f64, decimals: usize) -> Choice {
+    if let Kind::Time = kind {
+        let mut table = time_table();
+        table.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap());
+        let mult = table
+            .iter()
+            .find(|(_, m)| x >= *m)
+            .map(|(_, m)| *m)
+            .unwrap_or(table.last().unwrap().1);
+        let suffixes = table.iter().filter(|(_, m)| *m == mult).map(|(s, _)| s.to_string()).collect();
+        let scaled = x / mult;
+        let next = table.iter().rev().find(|(_, m)| *m > mult).map(|(_, m)| *m);
+        let stable = next.is_none_or(|next| rounded(scaled, decimals) * mult < next);
+        return Choice { scaled, mult, suffixes, stable };
+    }
+    let base = kind.base();
+    let pos = kind.pos();
+    let neg = kind.neg();
+    let last = pos.len() - 1;
+    let last_neg = neg.len() - 1;
+    if x >= base {
+        let mut v = x;
+        let mut k = 0;
+        while v >= base && k < last {
+            v /= base;
+            k += 1;
+        }
+        let stable = !(k < last && rounded(v, decimals) >= base);
+        Choice { scaled: v, mult: base.powi(k as i32), suffixes: vec![pos[k].to_string()], stable }
+    } else if x > 0.0 && x < 1.0 {
+        let mut v = x;
+        let mut j = 0;
+        while v < 1.0 && j < last_neg {
+            v *= base;
+            j += 1;
+        }
+        let stable = !(j >= 1 && rounded(v, decimals) >= base);
+        Choice { scaled: v, mult: base.powi(-(j as i32)), suffixes: vec![neg[j].to_string()], stable }
+    } else {
+        let stable = !(last >= 1 && rounded(x, decimals) >= base);
+        Choice { scaled: x, mult: 1.0, suffixes: vec![pos[0].to_string()], stable }
+    }
+}
+
+/// The texts `format(x)` may produce (several only for time synonyms), or `None` when the
+/// value is one where the crate's pre-rounding unit choice differs from the model's.
+fn expected(cfg: &Config, x: f64) -> Option<Vec<String>> {
+    if x.is_nan() {
+        return Some(vec!["NaN".to_string()]);
+    }
+    if x < 0.0 {
+        return expected(cfg, -x).map(|v| v.into_iter().map(|s| format!("-{s}")).collect());
+    }
+    if x.is_infinite() {
+        return Some(vec!["inf".to_string()]);
+    }
+    let d = cfg.decimals;
+    if x == 0.0 {
+        // Below one with nothing to scale: the first suffix (the time table has none —
+        // human_format/1).
+        let suffix = cfg.kind.pos().first().copied().unwrap_or("");
+        return Some(vec![format!("{x:.d$}{}{suffix}{}", cfg.separator, cfg.units)]);
+    }
+    let choice = choose(&cfg.kind, x, d);
+    if !choice.stable {
+        return None;
+    }
+    Some(
+        choice
+            .suffixes
+            .iter()
+            .map(|s| {
+                let s = if cfg.micro && s == "u" { "µ" } else { s.as_str() };
+                format!("{:.d$}{}{s}{}", choice.scaled, cfg.separator, cfg.units)
+            })
+            .collect(),
+    )
+}
+
+// ---------------------------------------------------------------------------------------
+// Numbers
+// ---------------------------------------------------------------------------------------
+
+/// A finite, non-zero decimal number with its leading digit in decade `k`, 1–12 digits.
+fn arb_decimal(tc: &TestCase, kmin: i32, kmax: i32) -> f64 {
+    let k = tc.draw(int!(kmin as i64, kmax as i64)) as i32;
+    let digits = n(tc, 1, 12);
+    let mut text = String::new();
+    if chance(tc, 25) {
+        text.push('-');
+    }
+    text.push(char::from(b'1' + n(tc, 0, 8) as u8));
+    text.push('.');
+    for _ in 1..digits {
+        text.push(char::from(b'0' + n(tc, 0, 9) as u8));
+    }
+    text.push('e');
+    text.push_str(&k.to_string());
+    text.parse().unwrap()
+}
+
+/// A value in the range the scale is meant for.
+fn arb_value(tc: &TestCase, kind: &Kind) -> f64 {
+    match kind {
+        Kind::Si => arb_decimal(tc, -36, 36),
+        Kind::Binary => arb_decimal(tc, -4, 40),
+        Kind::Custom { base, suffixes } => {
+            let span = ((*base as f64).log10().ceil() as i32) * suffixes.len() as i32;
+            arb_decimal(tc, -36, span + 4)
+        }
+        Kind::Time => arb_decimal(tc, -12, 20),
+    }
+}
+
+// ---------------------------------------------------------------------------------------
+// Properties
+// ---------------------------------------------------------------------------------------
+
+/// `format` is the model: the largest unit the value reaches, `{:.d}` of the scaled value,
+/// separator, suffix, units; `NaN`, `inf`, and a leading `-` for negatives.
+#[hegel::test]
+fn formatting_matches_the_model(tc: TestCase) {
+    let cfg = arb_config(&tc);
+    let zero_ok = !matches!(cfg.kind, Kind::Time); // human_format/1
+    let x = match n(&tc, 0, 19) {
+        0 if zero_ok => 0.0,
+        1 => f64::NAN,
+        2 => f64::INFINITY,
+        3 => f64::NEG_INFINITY,
+        _ => arb_value(&tc, &cfg.kind),
+    };
+    let Some(expected) = expected(&cfg, x) else {
+        tc.assume(false);
+        return;
+    };
+    let out = cfg.formatter().format(x);
+    assert!(expected.contains(&out), "{cfg:?} formatting {x:e}: {out:?}, expected one of {expected:?}");
+}
+
+/// `try_parse(format(x))` is `x` up to half a unit in the last printed decimal of the scaled
+/// value.
+#[hegel::test]
+fn formatting_and_parsing_round_trip(tc: TestCase) {
+    let cfg = arb_config(&tc);
+    tc.assume(!cfg.units_collide() && !cfg.separator_dangles());
+    let x = arb_value(&tc, &cfg.kind);
+    let f = cfg.formatter();
+    let text = f.format(x);
+    let parsed = f
+        .try_parse(&text)
+        .unwrap_or_else(|e| panic!("{cfg:?}: {text:?} (from {x:e}) failed to parse: {e}"));
+    let choice = choose(&cfg.kind, x.abs(), cfg.decimals);
+    let tolerance = 0.5 * 10f64.powi(-(cfg.decimals as i32)) * choice.mult * (1.0 + 1e-9) + x.abs() * 1e-12;
+    assert!(
+        (parsed - x).abs() <= tolerance,
+        "{cfg:?}: {x:e} -> {text:?} -> {parsed:e} (tolerance {tolerance:e})"
+    );
+}
+
+/// A number followed by a known suffix (and the units) parses to `number × multiplier`; an
+/// unknown suffix is `UnknownSuffix`, and `parse_or_clamp` reads it as the largest one.
+#[hegel::test]
+fn parsing_reads_number_times_multiplier(tc: TestCase) {
+    let cfg = arb_config(&tc);
+    tc.assume(!cfg.units_collide() && !cfg.separator_dangles());
+    let f = cfg.formatter();
+    let mut number = String::new();
+    if chance(&tc, 30) {
+        number.push('-');
+    }
+    let int_digits = n(&tc, 0, 6);
+    for _ in 0..int_digits {
+        number.push(char::from(b'0' + n(&tc, 0, 9) as u8));
+    }
+    if int_digits == 0 || chance(&tc, 60) {
+        number.push('.');
+        for _ in 0..n(&tc, if int_digits == 0 { 1 } else { 0 }, 4) {
+            number.push(char::from(b'0' + n(&tc, 0, 9) as u8));
+        }
+    }
+    let value: f64 = number.parse().unwrap();
+    let known = cfg.kind.known();
+    let (suffix, mult) = pick(&tc, &known);
+    let text = format!("{number}{}{suffix}{}", cfg.separator, cfg.units);
+    let expected = value * mult;
+    match f.try_parse(&text) {
+        Ok(p) => assert_eq!(p, expected, "{cfg:?}: {text:?}"),
+        Err(e) => panic!("{cfg:?}: {text:?} failed to parse: {e}"),
+    }
+    assert_eq!(f.parse_or_clamp(&text, false).unwrap(), expected, "{cfg:?}: clamp=false {text:?}");
+    assert_eq!(f.parse_or_clamp(&text, true).unwrap(), expected, "{cfg:?}: clamp=true {text:?}");
+
+    let unknown = pick(&tc, &["ZZ", "kB", "Ki", "K", "Q", "mm", "yy", "x"]);
+    if known.iter().any(|(s, _)| s == unknown) || unknown.trim_end_matches(cfg.units) != unknown {
+        return;
+    }
+    let text = format!("{number}{}{unknown}{}", cfg.separator, cfg.units);
+    assert!(
+        matches!(f.try_parse(&text), Err(ParseError::UnknownSuffix(_))),
+        "{cfg:?}: {text:?} should be an unknown suffix"
+    );
+    assert!(matches!(f.parse_or_clamp(&text, false), Err(ParseError::UnknownSuffix(_))));
+    assert_eq!(
+        f.parse_or_clamp(&text, true).unwrap(),
+        value * cfg.kind.clamp_multiplier(),
+        "{cfg:?}: clamped {text:?}"
+    );
+}
+
+/// Formatting with `Scales::Time()` gives the same text from every `Formatter`.
+#[hegel::test]
+fn time_formatting_is_deterministic(tc: TestCase) {
+    let (_, mult) = pick(&tc, &time_table());
+    let factor = 1.0 + n(&tc, 0, 190) as f64 / 100.0;
+    let x = mult * factor;
+    let decimals = n(&tc, 0, 3);
+    let texts: Vec<String> = (0..8)
+        .map(|_| {
+            let mut f = Formatter::new();
+            f.with_scales(Scales::Time()).with_decimals(decimals);
+            f.format(x)
+        })
+        .collect();
+    assert!(texts.iter().all(|t| t == &texts[0]), "{x:e}: {texts:?}");
+}
+
+// ---------------------------------------------------------------------------------------
+// Pins
+// ---------------------------------------------------------------------------------------
+
+/// human_format/1: `Scales::Time()` has no positional suffixes, and zero indexes them.
+#[test]
+fn time_scale_formats_zero() {
+    let mut f = Formatter::new();
+    f.with_scales(Scales::Time());
+    let out = f.format(0.0);
+    assert!(out.starts_with("0.00"), "{out:?}");
+}
+
+/// human_format/2: the unit is chosen before rounding, so the printed value reaches the base.
+#[test]
+fn scaled_values_stay_below_the_base() {
+    assert_eq!(Formatter::new().format(999_999.0), "1.00 M");
+    assert_eq!(Formatter::new().format(0.999_999_9), "1.00 ");
+    assert_eq!(Formatter::new().format(999.999), "1.00 k");
+    let mut f = Formatter::new();
+    f.with_scales(Scales::Time());
+    assert_eq!(f.format(59.999), "1.00 m");
+}
+
+/// human_format/3: synonyms in the time table are picked in `HashMap` order.
+#[test]
+fn time_synonyms_format_consistently() {
+    let year = 365.2425 * 86400.0;
+    let texts: Vec<String> = (0..32)
+        .map(|_| {
+            let mut f = Formatter::new();
+            f.with_scales(Scales::Time());
+            f.format(year)
+        })
+        .collect();
+    assert!(texts.iter().all(|t| t == &texts[0]), "{texts:?}");
+}
+
+/// human_format/4: the units are stripped with `trim_end_matches`, repeatedly.
+#[test]
+fn units_are_stripped_once_when_parsing() {
+    let mut metres = Formatter::new();
+    metres.with_units("m");
+    assert_eq!(metres.format(0.001), "1.00 mm");
+    assert_eq!(metres.try_parse("1.00 mm").unwrap(), 0.001);
+    let mut bytes = Formatter::new();
+    bytes.with_units("B");
+    assert!(bytes.try_parse("1.50 kBB").is_err(), "kBB is not a suffix");
+}
+
+/// human_format/6: the input is trimmed before the separator is removed, so the formatter's
+/// own `1.00 | ` (separator ` | `, no suffix) does not parse.
+#[test]
+fn separator_survives_trimming_when_the_suffix_is_empty() {
+    let mut f = Formatter::new();
+    f.with_separator(" | ");
+    assert_eq!(f.format(1500.0), "1.50 | k");
+    assert_eq!(f.try_parse("1.50 | k").unwrap(), 1500.0);
+    let text = f.format(1.0);
+    assert_eq!(text, "1.00 | ");
+    assert_eq!(f.try_parse(&text).unwrap(), 1.0);
+}
+
+/// human_format/5: `format` writes `inf`/`-inf`/`NaN`, which `try_parse` rejects.
+#[test]
+fn formatter_output_for_infinities_parses() {
+    let f = Formatter::new();
+    assert_eq!(f.try_parse(&f.format(f64::INFINITY)).unwrap(), f64::INFINITY);
+    assert_eq!(f.try_parse(&f.format(f64::NEG_INFINITY)).unwrap(), f64::NEG_INFINITY);
+}
