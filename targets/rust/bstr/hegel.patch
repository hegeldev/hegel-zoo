diff --git a/src/ext_slice.rs b/src/ext_slice.rs
index 504f824..fd62e9a 100644
--- a/src/ext_slice.rs
+++ b/src/ext_slice.rs
@@ -3873,4 +3873,356 @@ mod tests {
         t!(Lines::new(b"\n\n\n"), [B(""), B(""), B("")]);
         t!(LinesWithTerminator::new(b"\n\n\n"), [B("\n"), B("\n"), B("\n")]);
     }
+
+    /// Property-based tests (hegel) for the `ByteSlice` extension methods,
+    /// mostly comparing against `std` analogues or naive reference
+    /// implementations.
+    mod props {
+        use alloc::{
+            borrow::ToOwned,
+            format,
+            string::{String, ToString},
+            vec,
+            vec::Vec,
+        };
+
+        use hegel::generators;
+
+        use crate::{
+            ext_slice::{ByteSlice, Finder, FinderReverse},
+            ext_vec::join,
+            tests::props::{arb_bytes, arb_needle, arb_string},
+        };
+
+        /// `to_str_lossy` (and `to_str_lossy_into`) agree with
+        /// `String::from_utf8_lossy`, which documents the same "substitution
+        /// of maximal subparts" strategy.
+        #[hegel::test]
+        fn prop_to_str_lossy_agrees_with_std(tc: hegel::TestCase) {
+            let bytes = arb_bytes(&tc);
+            let expected = String::from_utf8_lossy(&bytes);
+            assert_eq!(bytes.to_str_lossy(), expected);
+            let mut into = String::new();
+            bytes.to_str_lossy_into(&mut into);
+            assert_eq!(into, expected);
+        }
+
+        /// `char_indices` tiles the input exactly, agrees with `chars`, and
+        /// their concatenation is the lossy decoding of the input.
+        #[hegel::test]
+        fn prop_char_decoding_apis_agree(tc: hegel::TestCase) {
+            let bytes = arb_bytes(&tc);
+            let indices: Vec<(usize, usize, char)> =
+                bytes.char_indices().collect();
+            let mut pos = 0;
+            for &(start, end, ch) in indices.iter() {
+                assert_eq!(start, pos, "char_indices must tile the input");
+                assert!(end > start);
+                if ch != '\u{FFFD}' {
+                    // A non-replacement char must be the exact decoding of
+                    // the bytes it spans.
+                    assert_eq!(
+                        core::str::from_utf8(&bytes[start..end]).unwrap(),
+                        ch.to_string(),
+                    );
+                }
+                pos = end;
+            }
+            assert_eq!(pos, bytes.len());
+
+            let chars: Vec<char> = bytes.chars().collect();
+            let index_chars: Vec<char> =
+                indices.iter().map(|&(_, _, ch)| ch).collect();
+            assert_eq!(chars, index_chars);
+
+            let concat: String = chars.iter().collect();
+            assert_eq!(concat, String::from_utf8_lossy(&bytes));
+        }
+
+        /// Reverse iteration (which uses the separate `decode_last` code
+        /// path) yields exactly the reverse of forward iteration.
+        #[hegel::test]
+        fn prop_char_iteration_reverses(tc: hegel::TestCase) {
+            let bytes = arb_bytes(&tc);
+            let forward: Vec<(usize, usize, char)> =
+                bytes.char_indices().collect();
+            let mut backward: Vec<(usize, usize, char)> =
+                bytes.char_indices().rev().collect();
+            backward.reverse();
+            assert_eq!(forward, backward);
+
+            let fchars: Vec<char> = bytes.chars().collect();
+            let mut bchars: Vec<char> = bytes.chars().rev().collect();
+            bchars.reverse();
+            assert_eq!(fchars, bchars);
+        }
+
+        /// Documented guarantee: concatenating everything yielded by
+        /// `lines_with_terminator` reproduces the original byte string.
+        #[hegel::test]
+        fn prop_lines_with_terminator_concat_is_identity(tc: hegel::TestCase) {
+            let bytes = arb_bytes(&tc);
+            let concat: Vec<u8> = bytes
+                .lines_with_terminator()
+                .flat_map(|line| line.iter().copied())
+                .collect();
+            assert_eq!(concat, bytes);
+        }
+
+        /// On valid UTF-8, `lines` agrees with `str::lines` from std.
+        #[hegel::test]
+        fn prop_lines_agree_with_std(tc: hegel::TestCase) {
+            let s = arb_string(&tc);
+            let got: Vec<&[u8]> = s.as_bytes().lines().collect();
+            let expected: Vec<&[u8]> =
+                s.lines().map(str::as_bytes).collect();
+            assert_eq!(got, expected);
+        }
+
+        /// On valid UTF-8, `fields` agrees with `str::split_whitespace`
+        /// (both are documented in terms of the `White_Space` property).
+        #[cfg(feature = "unicode")]
+        #[hegel::test]
+        fn prop_fields_agrees_with_std_split_whitespace(tc: hegel::TestCase) {
+            let s = arb_string(&tc);
+            let got: Vec<&[u8]> = s.as_bytes().fields().collect();
+            let expected: Vec<&[u8]> =
+                s.split_whitespace().map(str::as_bytes).collect();
+            assert_eq!(got, expected);
+        }
+
+        /// The DFA-based `trim*` methods agree with the char-predicate based
+        /// `trim*_with(char::is_whitespace)` methods (`char::is_whitespace`
+        /// is also defined by the `White_Space` property), and trimming is
+        /// idempotent.
+        #[cfg(feature = "unicode")]
+        #[hegel::test]
+        fn prop_trim_agrees_with_char_predicate(tc: hegel::TestCase) {
+            let bytes = arb_bytes(&tc);
+            assert_eq!(
+                bytes.trim_start(),
+                bytes.trim_start_with(|c| c.is_whitespace()),
+            );
+            assert_eq!(
+                bytes.trim_end(),
+                bytes.trim_end_with(|c| c.is_whitespace()),
+            );
+            assert_eq!(bytes.trim(), bytes.trim_with(|c| c.is_whitespace()));
+            assert_eq!(bytes.trim().trim(), bytes.trim());
+        }
+
+        /// `join` is the inverse of both `split_str` and `rsplit_str`, and
+        /// no yielded element contains the (non-empty) splitter.
+        ///
+        /// Note that `rsplit_str` is *not* asserted to be the exact reverse
+        /// of `split_str`: for self-overlapping separators the two
+        /// directions legitimately pick different non-overlapping match
+        /// sets (e.g. `b"\xC2\x80\xC2\x80\xC2\x80".split_str(b"\xC2\x80\xC2")`),
+        /// just like `str::split` vs `str::rsplit` in std.
+        #[hegel::test]
+        fn prop_split_join_roundtrip(tc: hegel::TestCase) {
+            let haystack = arb_bytes(&tc);
+            let sep = arb_needle(&tc, &haystack);
+            let parts: Vec<&[u8]> = haystack.split_str(&sep).collect();
+            if !sep.is_empty() {
+                for part in parts.iter() {
+                    assert!(!part.contains_str(&sep));
+                }
+            }
+            assert_eq!(join(&sep[..], parts.iter().copied()), haystack);
+
+            let mut rparts: Vec<&[u8]> = haystack.rsplit_str(&sep).collect();
+            rparts.reverse();
+            if !sep.is_empty() {
+                for part in rparts.iter() {
+                    assert!(!part.contains_str(&sep));
+                }
+            }
+            assert_eq!(join(&sep[..], rparts.iter().copied()), haystack);
+        }
+
+        /// `splitn_str`/`rsplitn_str` are consistent with `split_str`/
+        /// `rsplit_str`: the first `n - 1` pieces match and the last piece
+        /// is the joined remainder.
+        #[hegel::test]
+        fn prop_splitn_consistent_with_split(tc: hegel::TestCase) {
+            let haystack = arb_bytes(&tc);
+            let sep = arb_needle(&tc, &haystack);
+            let n = tc.draw(generators::integers::<usize>().max_value(6));
+
+            let all: Vec<&[u8]> = haystack.split_str(&sep).collect();
+            let got: Vec<Vec<u8>> =
+                haystack.splitn_str(n, &sep).map(|p| p.to_vec()).collect();
+            let expected: Vec<Vec<u8>> = if n == 0 {
+                Vec::new()
+            } else if all.len() <= n {
+                all.iter().map(|p| p.to_vec()).collect()
+            } else {
+                let mut e: Vec<Vec<u8>> =
+                    all[..n - 1].iter().map(|p| p.to_vec()).collect();
+                e.push(join(&sep[..], all[n - 1..].iter().copied()));
+                e
+            };
+            assert_eq!(got, expected);
+
+            let rall: Vec<&[u8]> = haystack.rsplit_str(&sep).collect();
+            let rgot: Vec<Vec<u8>> =
+                haystack.rsplitn_str(n, &sep).map(|p| p.to_vec()).collect();
+            let rexpected: Vec<Vec<u8>> = if n == 0 {
+                Vec::new()
+            } else if rall.len() <= n {
+                rall.iter().map(|p| p.to_vec()).collect()
+            } else {
+                let mut e: Vec<Vec<u8>> =
+                    rall[..n - 1].iter().map(|p| p.to_vec()).collect();
+                let mut rest: Vec<&[u8]> = rall[n - 1..].to_vec();
+                rest.reverse();
+                e.push(join(&sep[..], rest.iter().copied()));
+                e
+            };
+            assert_eq!(rgot, rexpected);
+        }
+
+        fn naive_find(h: &[u8], n: &[u8]) -> Option<usize> {
+            if n.len() > h.len() {
+                return None;
+            }
+            (0..=h.len() - n.len()).find(|&i| &h[i..i + n.len()] == n)
+        }
+
+        fn naive_rfind(h: &[u8], n: &[u8]) -> Option<usize> {
+            if n.len() > h.len() {
+                return None;
+            }
+            (0..=h.len() - n.len()).rev().find(|&i| &h[i..i + n.len()] == n)
+        }
+
+        /// `find`/`rfind` (and the `Finder`/`FinderReverse` types) agree
+        /// with a naive scan.
+        #[hegel::test]
+        fn prop_find_rfind_agree_with_naive_scan(tc: hegel::TestCase) {
+            let haystack = arb_bytes(&tc);
+            let needle = arb_needle(&tc, &haystack);
+            let expected_fwd = naive_find(&haystack, &needle);
+            let expected_rev = naive_rfind(&haystack, &needle);
+            assert_eq!(haystack.find(&needle), expected_fwd);
+            assert_eq!(haystack.rfind(&needle), expected_rev);
+            assert_eq!(Finder::new(&needle).find(&haystack), expected_fwd);
+            assert_eq!(
+                FinderReverse::new(&needle).rfind(&haystack),
+                expected_rev,
+            );
+        }
+
+        fn naive_find_iter(h: &[u8], n: &[u8]) -> Vec<usize> {
+            if n.is_empty() {
+                return (0..=h.len()).collect();
+            }
+            let mut out = vec![];
+            let mut i = 0;
+            while i + n.len() <= h.len() {
+                if &h[i..i + n.len()] == n {
+                    out.push(i);
+                    i += n.len();
+                } else {
+                    i += 1;
+                }
+            }
+            out
+        }
+
+        fn naive_rfind_iter(h: &[u8], n: &[u8]) -> Vec<usize> {
+            if n.is_empty() {
+                return (0..=h.len()).rev().collect();
+            }
+            let mut out = vec![];
+            let mut pos = h.len() as isize - n.len() as isize;
+            while pos >= 0 {
+                let i = pos as usize;
+                if &h[i..i + n.len()] == n {
+                    out.push(i);
+                    pos -= n.len() as isize;
+                } else {
+                    pos -= 1;
+                }
+            }
+            out
+        }
+
+        /// `find_iter`/`rfind_iter` yield exactly the greedy non-overlapping
+        /// matches computed by a naive scan.
+        #[hegel::test]
+        fn prop_find_iter_matches_naive_scan(tc: hegel::TestCase) {
+            let haystack = arb_bytes(&tc);
+            let needle = arb_needle(&tc, &haystack);
+            let got: Vec<usize> = haystack.find_iter(&needle).collect();
+            assert_eq!(got, naive_find_iter(&haystack, &needle));
+            let rgot: Vec<usize> = haystack.rfind_iter(&needle).collect();
+            assert_eq!(rgot, naive_rfind_iter(&haystack, &needle));
+        }
+
+        /// On valid UTF-8 with a non-empty needle, `replace`/`replacen`
+        /// agree with `str::replace`/`str::replacen`. (Empty needles are
+        /// excluded: bstr documents byte-oriented empty-needle splitting,
+        /// while std is char-oriented.)
+        #[hegel::test]
+        fn prop_replace_agrees_with_std(tc: hegel::TestCase) {
+            let s = arb_string(&tc);
+            let from_haystack = tc.draw(generators::booleans());
+            let needle: String = if from_haystack && !s.is_empty() {
+                // A substring of `s` on char boundaries, so matches occur.
+                let mut bounds: Vec<usize> =
+                    s.char_indices().map(|(i, _)| i).collect();
+                bounds.push(s.len());
+                let bi = tc.draw(
+                    generators::integers::<usize>()
+                        .max_value(bounds.len() - 2),
+                );
+                let bj = tc.draw(
+                    generators::integers::<usize>()
+                        .min_value(bi + 1)
+                        .max_value(bounds.len() - 1),
+                );
+                s[bounds[bi]..bounds[bj]].to_owned()
+            } else {
+                tc.draw(generators::text().min_size(1).max_size(4))
+            };
+            let replacement = arb_string(&tc);
+
+            let got = s.as_bytes().replace(&needle, &replacement);
+            assert_eq!(got, s.replace(&needle, &replacement).into_bytes());
+
+            let limit = tc.draw(generators::integers::<usize>().max_value(4));
+            let gotn = s.as_bytes().replacen(&needle, &replacement, limit);
+            assert_eq!(
+                gotn,
+                s.replacen(&needle, &replacement, limit).into_bytes(),
+            );
+        }
+
+        /// On ASCII-only input, the Unicode-aware case conversions agree
+        /// with `str::to_lowercase`/`str::to_uppercase` from std.
+        #[cfg(feature = "unicode")]
+        #[hegel::test]
+        fn prop_ascii_case_conversion_agrees_with_std(tc: hegel::TestCase) {
+            let bytes: Vec<u8> = tc.draw(generators::vecs(
+                generators::integers::<u8>().max_value(0x7F),
+            ));
+            let s = core::str::from_utf8(&bytes).unwrap();
+            assert_eq!(bytes.to_lowercase(), s.to_lowercase().into_bytes());
+            assert_eq!(bytes.to_uppercase(), s.to_uppercase().into_bytes());
+        }
+
+        /// Case conversion is idempotent, including on invalid UTF-8 (which
+        /// is documented to pass through unchanged).
+        #[cfg(feature = "unicode")]
+        #[hegel::test]
+        fn prop_case_conversion_idempotent(tc: hegel::TestCase) {
+            let bytes = arb_bytes(&tc);
+            let lower = bytes.to_lowercase();
+            assert_eq!(lower.to_lowercase(), lower);
+            let upper = bytes.to_uppercase();
+            assert_eq!(upper.to_uppercase(), upper);
+        }
+    }
 }
diff --git a/src/tests.rs b/src/tests.rs
index 03a4461..615220e 100644
--- a/src/tests.rs
+++ b/src/tests.rs
@@ -30,3 +30,129 @@ pub(crate) const LOSSY_TESTS: &[(&str, &[u8])] = &[
     ("☃βツ\u{FFFD}", b"\xe2\x98\x83\xce\xb2\xe3\x83\x84\xFF"),
     ("a\u{FFFD}\u{FFFD}\u{FFFD}b", b"\x61\xF1\x80\x80\xE1\x80\xC2\x62"),
 ];
+
+/// Shared input generation helpers for the hegel property-based tests spread
+/// across this crate's test modules.
+///
+/// The generators here deliberately boost "boundary" content: invalid UTF-8
+/// (truncated sequences, lone continuation bytes, surrogates, overlong
+/// encodings), embedded NUL, CRLF, Unicode whitespace, combining marks and
+/// regional indicators. Uniform random bytes rarely produce these shapes, and
+/// they are exactly where byte-string handling bugs hide.
+pub(crate) mod props {
+    use std::{
+        string::{String, ToString},
+        vec,
+        vec::Vec,
+    };
+
+    use hegel::generators::{self, Generator};
+
+    /// Byte fragments that stress UTF-8 and line/whitespace boundary
+    /// handling.
+    const BOUNDARY_BYTES: &[&[u8]] = &[
+        b"\xFF",             // invalid byte
+        b"\x80",             // lone continuation byte
+        b"\xCE",             // truncated 2-byte sequence
+        b"\xCE\xB2",         // valid 2-byte sequence (beta)
+        b"\xE2\x98",         // truncated 3-byte sequence
+        b"\xE2\x98\x83",     // valid 3-byte sequence (snowman)
+        b"\xF0\x9D\x9D",     // truncated 4-byte sequence
+        b"\xED\xA0\x80",     // surrogate codepoint encoding
+        b"\xC0\x80",         // overlong encoding of NUL
+        b"\xF4\x90\x80\x80", // beyond U+10FFFF
+        b"\x00",             // embedded NUL
+        b"\r\n",
+        b"\n",
+        b"\r",
+        b" ",
+        b"\t",
+        "\u{85}".as_bytes(),   // NEL
+        "\u{2028}".as_bytes(), // LINE SEPARATOR
+        "\u{2003}".as_bytes(), // EM SPACE (White_Space)
+        "\u{FFFD}".as_bytes(), // genuine replacement codepoint in the input
+        "a\u{300}\u{316}".as_bytes(), // combining marks
+        "\u{1F1FA}\u{1F1F8}".as_bytes(), // regional indicator pair (flag)
+        "\u{1F1E6}".as_bytes(),          // lone regional indicator
+    ];
+
+    /// String fragments (valid UTF-8) that stress segmentation, casing,
+    /// whitespace and line handling.
+    const BOUNDARY_STRS: &[&str] = &[
+        "\r\n",
+        "\n",
+        "\r",
+        "\u{85}",
+        "\u{2028}",
+        "\u{2029}",
+        " ",
+        "\t",
+        "\u{2003}",
+        "\u{a0}",
+        "\0",
+        "a\u{300}\u{316}",
+        "\u{1F1FA}\u{1F1F8}",
+        "\u{1F1E6}",
+        "\u{FFFD}",
+        "ßΣςσİı",
+        "👩\u{200D}🚀",
+        "can't",
+        "32.3",
+    ];
+
+    /// Draw a byte string mixing arbitrary binary, valid UTF-8 text and
+    /// boundary fragments (including invalid UTF-8).
+    pub(crate) fn arb_bytes(tc: &hegel::TestCase) -> Vec<u8> {
+        let nfrags = tc.draw(generators::integers::<usize>().max_value(8));
+        let mut out = Vec::new();
+        for _ in 0..nfrags {
+            let frag: Vec<u8> = tc.draw(hegel::one_of!(
+                generators::binary().max_size(8),
+                generators::text().max_size(8).map(String::into_bytes),
+                generators::sampled_from(BOUNDARY_BYTES.to_vec())
+                    .map(|f: &[u8]| f.to_vec()),
+            ));
+            out.extend_from_slice(&frag);
+        }
+        out
+    }
+
+    /// Draw a valid UTF-8 string mixing arbitrary text and boundary
+    /// fragments.
+    pub(crate) fn arb_string(tc: &hegel::TestCase) -> String {
+        let nfrags = tc.draw(generators::integers::<usize>().max_value(8));
+        let mut out = String::new();
+        for _ in 0..nfrags {
+            let frag: String = tc.draw(hegel::one_of!(
+                generators::text().max_size(8),
+                generators::sampled_from(BOUNDARY_STRS.to_vec())
+                    .map(|f: &str| f.to_string()),
+            ));
+            out.push_str(&frag);
+        }
+        out
+    }
+
+    /// Draw a needle/separator: either arbitrary bytes or a substring of the
+    /// haystack (so that matches actually occur).
+    pub(crate) fn arb_needle(
+        tc: &hegel::TestCase,
+        haystack: &[u8],
+    ) -> Vec<u8> {
+        let from_haystack = tc.draw(generators::booleans());
+        if from_haystack && !haystack.is_empty() {
+            let start = tc.draw(
+                generators::integers::<usize>()
+                    .max_value(haystack.len() - 1),
+            );
+            let end = tc.draw(
+                generators::integers::<usize>()
+                    .min_value(start + 1)
+                    .max_value(haystack.len()),
+            );
+            haystack[start..end].to_vec()
+        } else {
+            tc.draw(generators::binary().max_size(4))
+        }
+    }
+}
diff --git a/src/unicode/grapheme.rs b/src/unicode/grapheme.rs
index ca1d35d..faac06f 100644
--- a/src/unicode/grapheme.rs
+++ b/src/unicode/grapheme.rs
@@ -392,4 +392,46 @@ mod tests {
         }
         tests
     }
+
+    /// Property-based tests (hegel).
+    mod props {
+        use alloc::{format, string::{String, ToString}, vec::Vec};
+
+        use crate::{ext_slice::ByteSlice, tests::props::arb_bytes};
+
+        /// `grapheme_indices` tiles the input exactly, each grapheme not
+        /// containing a replacement codepoint is the exact decoding of the
+        /// bytes it spans, and the concatenation of all graphemes is the
+        /// lossy decoding of the input.
+        #[hegel::test]
+        fn prop_grapheme_indices_tile_input(tc: hegel::TestCase) {
+            let bytes = arb_bytes(&tc);
+            let mut pos = 0;
+            let mut concat = String::new();
+            for (start, end, grapheme) in bytes.grapheme_indices() {
+                assert_eq!(start, pos, "grapheme_indices must tile input");
+                assert!(end > start);
+                if !grapheme.contains('\u{FFFD}') {
+                    assert_eq!(&bytes[start..end], grapheme.as_bytes());
+                }
+                concat.push_str(grapheme);
+                pos = end;
+            }
+            assert_eq!(pos, bytes.len());
+            assert_eq!(concat, String::from_utf8_lossy(&bytes));
+        }
+
+        /// Documented guarantee: reverse iteration yields exactly the same
+        /// grapheme clusters, in reverse order.
+        #[hegel::test]
+        fn prop_grapheme_iteration_reverses(tc: hegel::TestCase) {
+            let bytes = arb_bytes(&tc);
+            let forward: Vec<(usize, usize, &str)> =
+                bytes.grapheme_indices().collect();
+            let mut backward: Vec<(usize, usize, &str)> =
+                bytes.grapheme_indices().rev().collect();
+            backward.reverse();
+            assert_eq!(forward, backward);
+        }
+    }
 }
diff --git a/src/unicode/sentence.rs b/src/unicode/sentence.rs
index b23c8dc..213aff8 100644
--- a/src/unicode/sentence.rs
+++ b/src/unicode/sentence.rs
@@ -226,4 +226,70 @@ mod tests {
         }
         tests
     }
+
+    /// Property-based tests (hegel).
+    mod props {
+        use alloc::{format, string::{String, ToString}};
+
+        use crate::{ext_slice::ByteSlice, tests::props::arb_string};
+
+        /// KNOWN FAILURE: `sentences`/`sentence_indices` silently drop all
+        /// input from the first invalid UTF-8 byte onwards, instead of
+        /// substituting Unicode replacement codepoints as documented
+        /// ("Concatenating all elements yielded by the iterator results in
+        /// the original string (modulo Unicode replacement codepoint
+        /// substitutions if invalid UTF-8 is encountered)").
+        ///
+        /// Cause: the sentence regex in scripts/regex/sentence.sh is
+        /// entirely optional (`(...)* (...)* (...)?`), so it matches the
+        /// empty string. When `decode_sentence` runs the anchored
+        /// `SENTENCE_BREAK_FWD` DFA on bytes starting with invalid UTF-8,
+        /// the search reports a zero-width match instead of failing, so the
+        /// `else` branch that substitutes a replacement codepoint via
+        /// `utf8::decode_lossy` is never reached and the iterator terminates
+        /// with `size == 0`. The grapheme and word regexes cannot match the
+        /// empty string, so `graphemes` and `words_with_breaks` handle
+        /// invalid UTF-8 correctly.
+        ///
+        /// Found by an earlier version of `prop_sentences_tile_input` below
+        /// (hegel shrank the counterexample to the single byte `\xC0`).
+        /// This test deterministically pins the documented behavior and is
+        /// expected to fail until the bug is fixed.
+        #[test]
+        fn known_failure_sentences_drop_input_after_invalid_utf8() {
+            // Everything is dropped, even the valid `a` after the invalid
+            // byte. Expected (per docs): "\u{FFFD}a".
+            let bytes = b"\xC0a";
+            let got: String = bytes.sentences().collect();
+            assert_eq!(got, String::from_utf8_lossy(bytes));
+        }
+
+        /// Documented guarantee: concatenating everything yielded by
+        /// `sentences` results in the original string. The ranges yielded
+        /// by `sentence_indices` must tile the input.
+        ///
+        /// Restricted to valid UTF-8 because invalid UTF-8 trips the bug
+        /// pinned by `known_failure_sentences_drop_input_after_invalid_utf8`
+        /// above.
+        #[hegel::test]
+        fn prop_sentences_tile_input(tc: hegel::TestCase) {
+            let s = arb_string(&tc);
+            let bytes = s.as_bytes();
+            let mut pos = 0;
+            let mut concat = String::new();
+            for (start, end, sentence) in bytes.sentence_indices() {
+                assert_eq!(start, pos, "sentence ranges must tile input");
+                assert!(end > start);
+                assert_eq!(&bytes[start..end], sentence.as_bytes());
+                concat.push_str(sentence);
+                pos = end;
+            }
+            assert_eq!(pos, bytes.len());
+            assert_eq!(concat, s);
+
+            // `sentences` agrees with `sentence_indices`.
+            let flat: String = bytes.sentences().collect();
+            assert_eq!(flat, concat);
+        }
+    }
 }
