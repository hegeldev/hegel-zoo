+
+    /// Property-based tests (hegel).
+    mod props {
+        use alloc::{
+            format,
+            string::{String, ToString},
+            vec::Vec,
+        };
+
+        use crate::tests::props::arb_bytes;
+
+        use super::super::{EscapeBytes, UnescapeBytes};
+
+        /// `unescape_bytes` is documented as the dual of `escape_bytes`:
+        /// unescaping an escaped byte string reproduces the original bytes,
+        /// for arbitrary (including invalid UTF-8) input.
+        #[hegel::test]
+        fn prop_escape_unescape_roundtrip(tc: hegel::TestCase) {
+            let bytes = arb_bytes(&tc);
+            let escaped: String =
+                EscapeBytes::new(&bytes).to_string();
+            let unescaped: Vec<u8> =
+                UnescapeBytes::new(escaped.chars()).collect();
+            assert_eq!(unescaped, bytes);
+        }
+    }
