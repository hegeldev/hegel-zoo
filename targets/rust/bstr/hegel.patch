+
+    /// Property-based tests (hegel).
+    mod props {
+        use alloc::{format, string::{String, ToString}, vec::Vec};
+
+        use crate::{ext_slice::ByteSlice, tests::props::arb_bytes};
+
+        /// Documented guarantee: concatenating everything yielded by
+        /// `words_with_break_indices` results in the original string,
+        /// modulo replacement codepoint substitutions (i.e. the lossy
+        /// decoding of the input). The yielded ranges must tile the input.
+        #[hegel::test]
+        fn prop_words_with_breaks_tile_input(tc: hegel::TestCase) {
+            let bytes = arb_bytes(&tc);
+            let mut pos = 0;
+            let mut concat = String::new();
+            for (start, end, word) in bytes.words_with_break_indices() {
+                assert_eq!(start, pos, "word ranges must tile input");
+                assert!(end > start);
+                if !word.contains('\u{FFFD}') {
+                    assert_eq!(&bytes[start..end], word.as_bytes());
+                }
+                concat.push_str(word);
+                pos = end;
+            }
+            assert_eq!(pos, bytes.len());
+            assert_eq!(concat, String::from_utf8_lossy(&bytes));
+
+            // `words_with_breaks` agrees with the indices variant.
+            let with_breaks: Vec<&str> = bytes.words_with_breaks().collect();
+            let from_indices: Vec<&str> = bytes
+                .words_with_break_indices()
+                .map(|(_, _, word)| word)
+                .collect();
+            assert_eq!(with_breaks, from_indices);
+        }
+    }
 }
