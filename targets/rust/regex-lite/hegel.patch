+/// `escape` agrees with the `regex` crate, and the escaped text compiles to a
+/// regex that finds exactly the leftmost non-overlapping literal occurrences.
+#[hegel::test]
+fn escape_is_literal(tc: hegel::TestCase) {
+    let text = tc.draw(
+        generators::text()
+            .alphabet("ab1 ()[]{}*+?|^$.\\-:<>#&~_,\n\r\t☃💩")
+            .max_size(4),
+    );
+    let hay = tc.draw(
+        generators::text()
+            .alphabet("ab1 ()[]{}*+?|^$.\\-:<>#&~_,\n\r\t☃💩")
+            .max_size(12),
+    );
+    let escaped = regex_lite::escape(&text);
+    assert_eq!(escaped, regex::escape(&text), "escape({text:?})");
+
+    let re = regex_lite::Regex::new(&escaped)
+        .unwrap_or_else(|e| panic!("escape({text:?}) = /{escaped}/ does not compile: {e}"));
+    let got = lite_ranges(&re, &hay);
+
+    // Leftmost, non-overlapping occurrences; the empty literal matches at
+    // every char boundary, as the empty regex is documented to.
+    let mut want = Vec::new();
+    let mut i = 0;
+    loop {
+        if hay[i..].starts_with(&text) {
+            want.push(i..i + text.len());
+            if !text.is_empty() {
+                i += text.len();
+                continue;
+            }
+        }
+        match hay[i..].chars().next() {
+            Some(c) => i += c.len_utf8(),
+            None => break,
+        }
+    }
+    assert_eq!(got, want, "/{escaped}/ on {hay:?}");
+}
