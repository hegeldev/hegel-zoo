+// ---------------------------------------------------------------------------
+// Known bugs, pinned to their failing region
+// ---------------------------------------------------------------------------
+
+/// KNOWN FAILURE (regex-lite/1). A bracket range spanning both letter cases
+/// is only half folded under `(?i)`: `ClassRange::ascii_case_fold` folds the
+/// `a-z` part of the range and returns, so the `A-Z` part of `[A-a]` is never
+/// lower-cased. `(?i)[A-a]` contains `B`..`Z`, so case-insensitively it must
+/// match every lowercase letter (`B` ∈ `[A-a]`, and the `regex` crate agrees);
+/// regex-lite matches none of `b`..`z`, and the negated class `(?i)[^A-a]`
+/// matches all of them.
+#[hegel::test]
+fn known_bug_case_insensitive_range_spanning_cases(tc: hegel::TestCase) {
+    let letter = tc.draw(generators::characters().min_codepoint('b' as u32).max_codepoint('z' as u32));
+    let hay = letter.to_string();
+    let lite = regex_lite::Regex::new("(?i)[A-a]").unwrap();
+    let reference = regex::Regex::new("(?i)[A-a]").unwrap();
+    assert!(reference.is_match(&hay), "oracle: {hay:?} must match (?i)[A-a]");
+    assert!(lite.is_match(&hay), "(?i)[A-a] does not match {hay:?} case-insensitively");
+    let negated = regex_lite::Regex::new("(?i)[^A-a]").unwrap();
+    assert!(!negated.is_match(&hay), "(?i)[^A-a] matches {hay:?} case-insensitively");
+}
+
+/// KNOWN FAILURE (regex-lite/2). A negated POSIX class is negated *before*
+/// case folding: `maybe_parse_posix_class` negates `[:^lower:]` to "anything
+/// but `a-z`" and only then does `(?i)` fold the class, which adds `a-z` back,
+/// so `(?i)[[:^lower:]]` matches every character. The crate documents
+/// `[[:^lower:]]` as `[^a-z]`, and its own `(?i)[^a-z]` folds before negating
+/// (the parser comments on why) and matches no letter at all — as does the
+/// `regex` crate for both spellings. Same for `[[:^upper:]]`.
+#[hegel::test]
+fn known_bug_case_insensitive_negated_posix_class(tc: hegel::TestCase) {
+    let letter = tc.draw(generators::characters().min_codepoint('a' as u32).max_codepoint('z' as u32));
+    let upper = tc.draw(generators::booleans());
+    let hay = if upper { letter.to_ascii_uppercase().to_string() } else { letter.to_string() };
+    let (posix, bracket) = if upper { ("(?i)[[:^upper:]]", "(?i)[^A-Z]") } else { ("(?i)[[:^lower:]]", "(?i)[^a-z]") };
+    let via_bracket = regex_lite::Regex::new(bracket).unwrap().is_match(&hay);
+    let via_posix = regex_lite::Regex::new(posix).unwrap().is_match(&hay);
+    let reference = regex::Regex::new(posix).unwrap().is_match(&hay);
+    assert!(!via_bracket, "{bracket} matches {hay:?}");
+    assert_eq!(via_posix, reference, "{posix} on {hay:?}: regex-lite {via_posix}, regex {reference}");
+    assert_eq!(via_posix, via_bracket, "{posix} and {bracket} disagree on {hay:?}");
+}
