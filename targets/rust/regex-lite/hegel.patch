+/// `shortest_match` is documented to return *an* end offset of the leftmost
+/// match, possibly before `find`'s end; so it must exist exactly when `find`
+/// finds something, and lie within that match. Its existence must also agree
+/// with the `regex` crate.
+#[hegel::test]
+fn shortest_match_is_consistent(tc: hegel::TestCase) {
+    let setup = tc.draw(arb_setup());
+    let hay = tc.draw(haystacks());
+    let (lite, reference) = compile(&setup);
+
+    let found = lite.find(&hay).map(|m| m.range());
+    let shortest = lite.shortest_match(&hay);
+    assert_eq!(shortest.is_some(), found.is_some(), "shortest_match vs find on {hay:?}");
+    assert_eq!(shortest.is_some(), reference.shortest_match(&hay).is_some(), "shortest_match vs regex on {hay:?}");
+    if let (Some(end), Some(range)) = (shortest, &found) {
+        assert!(range.start <= end && end <= range.end, "shortest_match end {end} outside find's {range:?} on {hay:?}");
+    }
+
+    let start = char_boundary(&tc, &hay);
+    assert_eq!(
+        lite.shortest_match_at(&hay, start).is_some(),
+        lite.find_at(&hay, start).is_some(),
+        "shortest_match_at({start}) vs find_at on {hay:?}"
+    );
+}
