+/// `replace`, `replace_all` and `replacen` with a `&str` replacement (capture
+/// interpolation included) produce the same string as the `regex` crate.
+#[hegel::test]
+fn replacements_agree_with_regex(tc: hegel::TestCase) {
+    let setup = tc.draw(arb_setup());
+    let hay = tc.draw(haystacks());
+    let rep = arb_replacement(&tc);
+    let (lite, reference) = compile(&setup);
+
+    assert_eq!(
+        lite.replace_all(&hay, rep.as_str()).into_owned(),
+        reference.replace_all(&hay, rep.as_str()).into_owned(),
+        "replace_all({hay:?}, {rep:?})"
+    );
+    assert_eq!(
+        lite.replace(&hay, rep.as_str()).into_owned(),
+        reference.replace(&hay, rep.as_str()).into_owned(),
+        "replace({hay:?}, {rep:?})"
+    );
+    let limit = tc.draw(generators::integers::<usize>().max_value(3));
+    assert_eq!(
+        lite.replacen(&hay, limit, rep.as_str()).into_owned(),
+        reference.replacen(&hay, limit, rep.as_str()).into_owned(),
+        "replacen({hay:?}, {limit}, {rep:?})"
+    );
+
+    // `Captures::expand` is the same interpolation, exposed directly.
+    if let (Some(l), Some(r)) = (lite.captures(&hay), reference.captures(&hay)) {
+        let (mut dl, mut dr) = (String::new(), String::new());
+        l.expand(&rep, &mut dl);
+        r.expand(&rep, &mut dr);
+        assert_eq!(dl, dr, "expand({rep:?}) on {hay:?}");
+    }
+}
