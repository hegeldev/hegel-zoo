+/// `split` and `splitn` agree with the `regex` crate.
+#[hegel::test]
+fn split_agrees_with_regex(tc: hegel::TestCase) {
+    let setup = tc.draw(arb_setup());
+    let hay = tc.draw(haystacks());
+    let (lite, reference) = compile(&setup);
+
+    let got: Vec<&str> = lite.split(&hay).collect();
+    let want: Vec<&str> = reference.split(&hay).collect();
+    assert_eq!(got, want, "split on {hay:?}");
+
+    let limit = tc.draw(generators::integers::<usize>().max_value(4));
+    let got: Vec<&str> = lite.splitn(&hay, limit).collect();
+    let want: Vec<&str> = reference.splitn(&hay, limit).collect();
+    assert_eq!(got, want, "splitn({limit}) on {hay:?}");
+}
