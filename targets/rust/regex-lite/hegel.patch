+/// Random *strings* as patterns: both crates accept or reject the same
+/// pattern (the documented differences — `\p{..}`, class set operations,
+/// the `u` flag, octal — are kept out of the alphabet or assumed away), and
+/// when both accept it, they find the same matches. This covers syntax the
+/// structured generator never writes (odd escapes, `{,n}`, empty groups,
+/// nested repetitions, ...).
+#[hegel::test]
+fn random_pattern_acceptance_agrees_with_regex(tc: hegel::TestCase) {
+    let pat = tc.draw(
+        generators::text()
+            .alphabet("ab1 ()[]{}*+?|^$.\\-:<>#&~_,dswDSWAzBbimsURxnrt0123")
+            .max_size(8),
+    );
+    // Documented differences: no class set operations in regex-lite. (`\p`,
+    // `\P` and the `u` flag cannot be spelled with this alphabet; octal
+    // escapes are rejected by both crates by default.)
+    tc.assume(!pat.contains("&&") && !pat.contains("--") && !pat.contains("~~"));
+
+    let lite = regex_lite::Regex::new(&pat);
+    let reference = regex::Regex::new(&pat);
+    assert_eq!(
+        lite.is_ok(),
+        reference.is_ok(),
+        "acceptance of /{pat}/: regex-lite {:?}, regex {:?}",
+        lite.as_ref().map(|_| ()).map_err(|e| e.to_string()),
+        reference.as_ref().map(|_| ()).map_err(|e| e.to_string())
+    );
+    if let (Ok(lite), Ok(reference)) = (lite, reference) {
+        // The alphabet has no ASCII letters that Unicode-fold to non-ASCII
+        // ones, but `\d\s\w` and `\b` in a random pattern do differ by
+        // design (ASCII vs Unicode) when the haystack has non-ASCII digits,
+        // spaces or letters; the haystack alphabet has none.
+        let hay = tc.draw(haystacks());
+        assert_eq!(lite_ranges(&lite, &hay), ref_ranges(&reference, &hay), "find_iter of /{pat}/ on {hay:?}");
+    }
+}
