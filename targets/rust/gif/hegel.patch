+/// Property-based tests (hegel). Roundtrip / dimension-consistency family.
+///
+/// These exercise the encode->decode round trip and structural invariants of
+/// decoded frames. The decode-robustness / memory-limit family lives in
+/// `tests/decode.rs`.
+#[cfg(test)]
+mod hegel_props {
+    use gif::{
+        AnyExtension, ColorOutput, DecodeOptions, Decoder, DisposalMethod, Encoder, Extension,
+        Frame, Repeat,
+    };
+    use hegel::generators;
+    use hegel::Generator;
+    use std::borrow::Cow;
+
+    /// A drawn paletted image: canvas dims, a palette (2..=256 colours) and
+    /// exactly width*height index bytes. Indices are full-range `u8` on purpose
+    /// — the indexed decode path returns raw LZW output verbatim, so the round
+    /// trip must hold regardless of whether an index is within the palette.
+    struct DrawnImage {
+        width: u16,
+        height: u16,
+        palette: Vec<u8>,
+        pixels: Vec<u8>,
+    }
+
+    fn draw_image(tc: &hegel::TestCase, max_side: u16) -> DrawnImage {
+        let width = tc.draw(generators::integers::<u16>().min_value(1).max_value(max_side));
+        let height = tc.draw(generators::integers::<u16>().min_value(1).max_value(max_side));
+        let num_colors = tc.draw(generators::integers::<usize>().min_value(1).max_value(256));
+        let palette = tc.draw(
+            generators::vecs(generators::integers::<u8>())
+                .min_size(num_colors * 3)
+                .max_size(num_colors * 3),
+        );
+        let count = usize::from(width) * usize::from(height);
+        let pixels = tc.draw(
+            generators::vecs(generators::integers::<u8>())
+                .min_size(count)
+                .max_size(count),
+        );
+        DrawnImage {
+            width,
+            height,
+            palette,
+            pixels,
+        }
+    }
+
+    /// Encode a drawn frame with a global palette, decode it back in Indexed
+    /// mode, and assert the index buffer and dimensions recover exactly. LZW is
+    /// lossless, so this is an oracle-independent round trip.
+    #[hegel::test]
+    fn encode_decode_indexed_roundtrip(tc: hegel::TestCase) {
+        let img = draw_image(&tc, 64);
+        let mut buf = Vec::new();
+        {
+            let mut encoder =
+                Encoder::new(&mut buf, img.width, img.height, &img.palette).unwrap();
+            let frame = Frame::from_indexed_pixels(img.width, img.height, img.pixels.clone(), None);
+            encoder.write_frame(&frame).unwrap();
+        }
+
+        let mut decoder = Decoder::new(&buf[..]).expect("decoder init");
+        let frame = decoder
+            .read_next_frame()
+            .expect("decode frame")
+            .expect("one frame");
+        assert_eq!(frame.width, img.width);
+        assert_eq!(frame.height, img.height);
+        assert_eq!(&*frame.buffer, &img.pixels[..], "indices must round-trip");
+        assert!(decoder.read_next_frame().unwrap().is_none(), "exactly one frame");
+    }
+
+    /// A decoded frame's buffer length must equal width*height (Indexed) or
+    /// width*height*4 (RGBA). This holds for any encodable image and needs no
+    /// external oracle.
+    #[hegel::test]
+    fn decoded_buffer_length_matches_dimensions(tc: hegel::TestCase) {
+        let img = draw_image(&tc, 64);
+        let rgba = tc.draw(generators::booleans());
+        let mut buf = Vec::new();
+        {
+            let mut encoder =
+                Encoder::new(&mut buf, img.width, img.height, &img.palette).unwrap();
+            let frame = Frame::from_indexed_pixels(img.width, img.height, img.pixels.clone(), None);
+            encoder.write_frame(&frame).unwrap();
+        }
+
+        let mut opts = DecodeOptions::new();
+        opts.set_color_output(if rgba {
+            ColorOutput::RGBA
+        } else {
+            ColorOutput::Indexed
+        });
+        let mut decoder = opts.read_info(&buf[..]).expect("decoder init");
+        let (fw, fh, blen) = {
+            let frame = decoder
+                .read_next_frame()
+                .expect("decode frame")
+                .expect("one frame");
+            (frame.width, frame.height, frame.buffer.len())
+        };
+        let expected = usize::from(fw) * usize::from(fh) * if rgba { 4 } else { 1 };
+        assert_eq!(blen, expected);
+        // buffer_size() must agree with line_length()*height (both oracle-free).
+        assert_eq!(decoder.buffer_size(), decoder.line_length() * usize::from(fh));
+    }
+
+    /// Compressing a frame with `make_lzw_pre_encoded` and writing it via
+    /// `write_lzw_pre_encoded_frame` must round-trip back to the original
+    /// indices when decoded normally. Exercises the parallel-compression LZW
+    /// path (crate `lzw_encode` -> weezl decode).
+    #[hegel::test]
+    fn lzw_pre_encoded_roundtrip(tc: hegel::TestCase) {
+        let img = draw_image(&tc, 64);
+        let mut frame = Frame::from_indexed_pixels(img.width, img.height, img.pixels.clone(), None);
+        frame.make_lzw_pre_encoded();
+
+        let mut buf = Vec::new();
+        {
+            let mut encoder =
+                Encoder::new(&mut buf, img.width, img.height, &img.palette).unwrap();
+            encoder.write_lzw_pre_encoded_frame(&frame).unwrap();
+        }
+
+        let mut decoder = Decoder::new(&buf[..]).expect("decoder init");
+        let decoded = decoder
+            .read_next_frame()
+            .expect("decode frame")
+            .expect("one frame");
+        assert_eq!(decoded.width, img.width);
+        assert_eq!(decoded.height, img.height);
+        assert_eq!(&*decoded.buffer, &img.pixels[..]);
+    }
+
+    /// A drawn frame with graphic-control metadata (delay/dispose/transparent),
+    /// used to check that the control-extension fields round-trip.
+    struct DrawnFrame {
+        width: u16,
+        height: u16,
+        pixels: Vec<u8>,
+        delay: u16,
+        dispose: DisposalMethod,
+        transparent: Option<u8>,
+        needs_user_input: bool,
+    }
+
+    fn draw_frame(tc: &hegel::TestCase, width: u16, height: u16) -> DrawnFrame {
+        let count = usize::from(width) * usize::from(height);
+        let pixels = tc.draw(
+            generators::vecs(generators::integers::<u8>())
+                .min_size(count)
+                .max_size(count),
+        );
+        let delay = tc.draw(generators::integers::<u16>());
+        let dispose = tc.draw((generators::sampled_from(vec![
+            DisposalMethod::Any,
+            DisposalMethod::Keep,
+            DisposalMethod::Background,
+            DisposalMethod::Previous,
+        ])).print_as_debug());
+        let transparent = tc.draw(generators::optional(generators::integers::<u8>()));
+        let needs_user_input = tc.draw(generators::booleans());
+        DrawnFrame {
+            width,
+            height,
+            pixels,
+            delay,
+            dispose,
+            transparent,
+            needs_user_input,
+        }
+    }
+
+    /// Encode a multi-frame animation with a NETSCAPE repeat extension and a
+    /// comment extension, then decode it. Frame count, per-frame control
+    /// metadata, buffers and the repeat count must all round-trip, and the
+    /// extension blocks must be handled without panicking.
+    #[hegel::test]
+    fn multi_frame_with_extensions_roundtrip(tc: hegel::TestCase) {
+        let width = tc.draw(generators::integers::<u16>().min_value(1).max_value(24));
+        let height = tc.draw(generators::integers::<u16>().min_value(1).max_value(24));
+        let num_colors = tc.draw(generators::integers::<usize>().min_value(1).max_value(256));
+        let palette = tc.draw(
+            generators::vecs(generators::integers::<u8>())
+                .min_size(num_colors * 3)
+                .max_size(num_colors * 3),
+        );
+        let num_frames = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+        let repeat = if tc.draw(generators::booleans()) {
+            Repeat::Infinite
+        } else {
+            // Finite(0) is not written by the encoder, so it can't round-trip;
+            // draw a non-zero finite count.
+            Repeat::Finite(tc.draw(generators::integers::<u16>().min_value(1)))
+        };
+
+        let frames: Vec<DrawnFrame> = (0..num_frames)
+            .map(|_| draw_frame(&tc, width, height))
+            .collect();
+
+        let mut buf = Vec::new();
+        {
+            let mut encoder = Encoder::new(&mut buf, width, height, &palette).unwrap();
+            encoder.set_repeat(repeat).unwrap();
+            encoder
+                .write_raw_extension(AnyExtension(Extension::Comment as u8), &[b"hegel"])
+                .unwrap();
+            for df in &frames {
+                let frame = Frame {
+                    width: df.width,
+                    height: df.height,
+                    buffer: Cow::Owned(df.pixels.clone()),
+                    delay: df.delay,
+                    dispose: df.dispose,
+                    transparent: df.transparent,
+                    needs_user_input: df.needs_user_input,
+                    ..Frame::default()
+                };
+                encoder.write_frame(&frame).unwrap();
+            }
+        }
+
+        let mut decoder = Decoder::new(&buf[..]).expect("decoder init");
+        assert_eq!(decoder.repeat(), repeat);
+        let mut decoded = Vec::new();
+        while let Some(f) = decoder.read_next_frame().expect("decode frame") {
+            decoded.push(f.clone());
+        }
+        assert_eq!(decoded.len(), frames.len(), "frame count must round-trip");
+        for (dec, df) in decoded.iter().zip(&frames) {
+            assert_eq!(dec.width, df.width);
+            assert_eq!(dec.height, df.height);
+            assert_eq!(dec.delay, df.delay);
+            assert_eq!(dec.dispose, df.dispose);
+            assert_eq!(dec.transparent, df.transparent);
+            assert_eq!(dec.needs_user_input, df.needs_user_input);
+            assert_eq!(&*dec.buffer, &df.pixels[..]);
+        }
+    }
+}
