+//! Hegel property tests for `crc32fast`.
+//!
+//! The crate computes CRC-32/ISO-HDLC (the IEEE 802.3 CRC used by zlib, PNG, gzip …) with a
+//! slicing-by-16 baseline and a `pclmulqdq`/`vpclmulqdq` implementation chosen at runtime. The
+//! oracle is the bit-by-bit definition of that CRC (reflected polynomial `0xEDB88320`, init and
+//! xorout `0xFFFFFFFF`), plus the crate's own stated identities: `new_with_initial(crc(a))` then
+//! `update(b)` is `crc(a ‖ b)`, and `combine` computes `crc(a ‖ b)` from `crc(a)`, `crc(b)` and
+//! `len(b)`. Both the runtime-selected and the baseline implementation are exercised.
+
+use std::hash::Hasher as _;
+
+use crc32fast::Hasher;
+use hegel::generators;
+
+/// CRC-32/ISO-HDLC, one message bit at a time.
+fn reference(data: &[u8]) -> u32 {
+    let mut crc = 0xFFFF_FFFFu32;
+    for &b in data {
+        crc ^= b as u32;
+        for _ in 0..8 {
+            let lsb = crc & 1;
+            crc >>= 1;
+            if lsb == 1 {
+                crc ^= 0xEDB8_8320;
+            }
+        }
+    }
+    !crc
+}
+
+/// Chunks of input: enough bytes for several 64-byte (or 256/512-bit) SIMD blocks with every
+/// tail length, split at arbitrary points.
+fn arb_chunks() -> impl hegel::PrintableGenerator<Vec<Vec<u8>>> {
+    generators::vecs(generators::binary().max_size(300)).max_size(6)
+}
+
+/// The two ways of making a hasher: the runtime-selected implementation (`Hasher::new` and
+/// friends) and the baseline the crate falls back to (reachable through the `#[doc(hidden)]`
+/// constructor its own tests use).
+#[derive(Clone, Copy, Debug)]
+enum Impl {
+    Selected,
+    Baseline,
+}
+
+impl Impl {
+    fn new(self) -> Hasher {
+        self.with_initial_len(0, 0)
+    }
+    fn with_initial(self, init: u32) -> Hasher {
+        self.with_initial_len(init, 0)
+    }
+    fn with_initial_len(self, init: u32, amount: u64) -> Hasher {
+        match self {
+            Impl::Selected => Hasher::new_with_initial_len(init, amount),
+            Impl::Baseline => Hasher::internal_new_baseline(init, amount),
+        }
+    }
+}
+
+impl hegel::PrettyPrintable for Impl {
+    fn pretty_print(&self, printer: &mut hegel::pretty::PrettyPrinter) {
+        hegel::pretty::print_debug_repr(&format!("{self:?}"), printer);
+    }
+}
+
+fn arb_impl() -> impl hegel::PrintableGenerator<Impl> {
+    generators::sampled_from(vec![Impl::Selected, Impl::Baseline])
+}
+
+/// `hash`, a fresh `Hasher` fed all at once, a `Hasher` fed in arbitrary chunks (cloned half way,
+/// both continuations agreeing), `Default`, and `std::hash::Hasher::write`/`finish` all give the
+/// bit-by-bit CRC-32/ISO-HDLC of the concatenation; `finish` does not consume the state.
+#[hegel::test]
+fn checksum_matches_the_bitwise_definition(tc: hegel::TestCase) {
+    let imp = tc.draw(arb_impl());
+    let chunks = tc.draw(arb_chunks());
+    let all: Vec<u8> = chunks.concat();
+    let expected = reference(&all);
+    if matches!(imp, Impl::Selected) {
+        assert_eq!(crc32fast::hash(&all), expected, "hash of {} bytes", all.len());
+        let mut d = Hasher::default();
+        d.update(&all);
+        assert_eq!(d.finalize(), expected, "Default hasher");
+    }
+    let mut one = imp.new();
+    one.update(&all);
+    assert_eq!(one.finalize(), expected, "{imp:?} one-shot over {} bytes", all.len());
+    let mut h = imp.new();
+    let half = chunks.len() / 2;
+    for c in &chunks[..half] {
+        h.update(c);
+    }
+    let mut twin = h.clone();
+    for c in &chunks[half..] {
+        h.update(c);
+        twin.write(c);
+    }
+    assert_eq!(h.finish(), u64::from(expected), "{imp:?} finish() after chunks {:?}", chunks.iter().map(Vec::len).collect::<Vec<_>>());
+    assert_eq!(h.finalize(), expected, "{imp:?} chunked");
+    assert_eq!(twin.finalize(), expected, "{imp:?} cloned hasher, fed through std::hash::Hasher::write");
+}
+
+/// `new_with_initial(crc(a))` continued with `b` gives `crc(a ‖ b)` — the documented meaning of
+/// the initial state — for both implementations, and `reset` gives a fresh hasher.
+#[hegel::test]
+fn initial_state_continues_a_checksum(tc: hegel::TestCase) {
+    let imp = tc.draw(arb_impl());
+    let a = tc.draw(generators::binary().max_size(300));
+    let b = tc.draw(generators::binary().max_size(300));
+    let ab = [a.as_slice(), b.as_slice()].concat();
+    let mut h = imp.with_initial(reference(&a));
+    h.update(&b);
+    assert_eq!(h.finalize(), reference(&ab), "{imp:?}: new_with_initial(crc(a)) + b, |a| = {}, |b| = {}", a.len(), b.len());
+    // The initial state of a fresh hasher is the CRC of the empty message.
+    assert_eq!(imp.new().finalize(), reference(&[]), "{imp:?}: empty");
+    assert_eq!(imp.with_initial(reference(&[])).finalize(), reference(&[]));
+    // reset: back to a fresh hasher whatever was fed or configured.
+    let mut r = imp.with_initial_len(reference(&a), a.len() as u64);
+    r.update(&b);
+    r.reset();
+    r.update(&b);
+    assert_eq!(r.finalize(), reference(&b), "{imp:?}: reset then b");
+    let mut r = imp.with_initial(reference(&a));
+    r.reset();
+    let mut other = imp.new();
+    other.update(&b);
+    let mut fresh = imp.new();
+    fresh.combine(&other);
+    r.combine(&other);
+    assert_eq!(r.finalize(), fresh.finalize(), "{imp:?}: reset clears the byte count used by combine");
+}
+
+/// `combine`: `crc(a ‖ b)` from a hasher over `a` (or `new_with_initial_len(crc(a), len(a))`)
+/// and a hasher over `b`, for any split, including empty parts; chained over three pieces, with
+/// the combined hasher used both as receiver and as argument, so the byte counts must be kept
+/// right; and the argument is not consumed or changed.
+#[hegel::test]
+fn combine_concatenates_checksums(tc: hegel::TestCase) {
+    let imp = tc.draw(arb_impl());
+    let a = tc.draw(generators::binary().max_size(300));
+    let b = tc.draw(generators::binary().max_size(300));
+    let c = tc.draw(generators::binary().max_size(300));
+    let abc = [a.as_slice(), b.as_slice(), c.as_slice()].concat();
+    let ab = &abc[..a.len() + b.len()];
+    let bc = &abc[a.len()..];
+    let over = |bytes: &[u8]| {
+        let mut h = imp.new();
+        h.update(bytes);
+        h
+    };
+    let (ha, hb, hc) = (over(&a), over(&b), over(&c));
+    // Basic: crc(a) ⊕ hasher(b).
+    let mut h = ha.clone();
+    h.combine(&hb);
+    assert_eq!(h.finalize(), reference(ab), "{imp:?}: combine(a, b), |a| = {}, |b| = {}", a.len(), b.len());
+    assert_eq!(hb.clone().finalize(), reference(&b), "{imp:?}: the argument of combine changed");
+    // From a checksum and a length only.
+    let mut h = imp.with_initial_len(reference(&a), a.len() as u64);
+    h.combine(&hb);
+    assert_eq!(h.finalize(), reference(ab), "{imp:?}: new_with_initial_len(crc(a), |a|).combine(b)");
+    // (a ‖ b) ‖ c: the combined hasher as receiver …
+    let mut h = ha.clone();
+    h.combine(&hb);
+    h.combine(&hc);
+    assert_eq!(h.finalize(), reference(&abc), "{imp:?}: (a+b)+c");
+    // … and as argument: a ‖ (b ‖ c) needs the byte count of the combined hasher to be |b| + |c|.
+    let mut h_bc = hb.clone();
+    h_bc.combine(&hc);
+    let mut h = ha.clone();
+    h.combine(&h_bc);
+    assert_eq!(h.finalize(), reference(&abc), "{imp:?}: a+(b+c)");
+    // A combined hasher can keep being updated, and one built from a length can be an argument.
+    let mut h = ha.clone();
+    h.combine(&hb);
+    h.update(&c);
+    assert_eq!(h.finalize(), reference(&abc), "{imp:?}: (a+b) then update(c)");
+    let from_len = imp.with_initial_len(reference(bc), bc.len() as u64);
+    let mut h = ha.clone();
+    h.combine(&from_len);
+    assert_eq!(h.finalize(), reference(&abc), "{imp:?}: a + new_with_initial_len(crc(bc), |bc|)");
+    // Combining with an empty hasher is the identity; combining into an empty one gives the argument.
+    let mut h = ha.clone();
+    h.combine(&imp.new());
+    assert_eq!(h.finalize(), reference(&a), "{imp:?}: a + empty");
+    let mut h = imp.new();
+    h.combine(&ha);
+    assert_eq!(h.finalize(), reference(&a), "{imp:?}: empty + a");
+}
