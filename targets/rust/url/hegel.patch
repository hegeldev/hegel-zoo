+
+/// Property-based tests using hegel.
+///
+/// These are all oracle-independent invariants: we only compare the parsed
+/// `Url` against itself (re-parse fixed points, the crate's own
+/// `check_invariants`, getter/serialization consistency), never against an
+/// external re-implementation of the WHATWG spec.
+///
+/// hegeltest requires `std`, so the whole module is gated on the `std`
+/// feature (the default).
+#[cfg(feature = "std")]
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+mod hegel_props {
+    use alloc::string::{String, ToString};
+    use alloc::vec::Vec;
+    use hegel::generators::{self, Generator};
+    use url::{Origin, Url};
+
+    /// A plausible `scheme://user:pass@host:port/path?query#frag` URL string,
+    /// built from conservative character sets so that `Url::parse` accepts it.
+    /// Character sets deliberately avoid anything the parser percent-encodes
+    /// or normalizes (uppercase in schemes/hosts, dot path segments, "%", ...)
+    /// so that tests can also compare getters against the generated parts.
+    #[hegel::composite]
+    fn plausible_url(tc: &hegel::TestCase) -> String {
+        let scheme: String = tc.draw(hegel::one_of!(
+            generators::sampled_from(vec![
+                "http".to_string(),
+                "https".to_string(),
+                "ws".to_string(),
+                "wss".to_string(),
+                "ftp".to_string(),
+                "file".to_string(),
+            ])
+            .boxed(),
+            generators::from_regex(r"[a-z][a-z0-9+.-]{0,8}")
+                .fullmatch(true)
+                .boxed(),
+        ));
+        let is_file = scheme == "file";
+        let mut s = format!("{}://", scheme);
+        // file: URLs cannot have credentials or a port.
+        if !is_file && tc.draw(generators::booleans()) {
+            let user: String =
+                tc.draw(generators::from_regex(r"[a-zA-Z0-9._~-]{1,8}").fullmatch(true));
+            s.push_str(&user);
+            if tc.draw(generators::booleans()) {
+                let pass: String =
+                    tc.draw(generators::from_regex(r"[a-zA-Z0-9._~-]{1,8}").fullmatch(true));
+                s.push(':');
+                s.push_str(&pass);
+            }
+            s.push('@');
+        }
+        // The last domain label always starts with a letter so that the host
+        // is never parsed as an (invalid) IPv4 address.
+        let host: String = tc.draw(hegel::one_of!(
+            generators::from_regex(r"([a-z0-9]{1,8}\.){0,2}[a-z][a-z0-9]{0,7}")
+                .fullmatch(true)
+                .boxed(),
+            generators::ip_addresses()
+                .v4()
+                .map(|ip| ip.to_string())
+                .boxed(),
+            generators::ip_addresses()
+                .v6()
+                .map(|ip| format!("[{}]", ip))
+                .boxed(),
+        ));
+        s.push_str(&host);
+        if !is_file && tc.draw(generators::booleans()) {
+            let port: u16 = tc.draw(generators::integers::<u16>());
+            s.push_str(&format!(":{}", port));
+        }
+        // Segments never equal "." or ".." (first char is alphanumeric), so
+        // no dot-segment normalization applies.
+        let segments: Vec<String> = tc.draw(
+            generators::vecs(
+                generators::from_regex(r"[a-zA-Z0-9][a-zA-Z0-9_~-]{0,7}").fullmatch(true),
+            )
+            .max_size(4),
+        );
+        for segment in &segments {
+            s.push('/');
+            s.push_str(segment);
+        }
+        if tc.draw(generators::booleans()) {
+            let query: String =
+                tc.draw(generators::from_regex(r"[a-zA-Z0-9=&._~-]{0,12}").fullmatch(true));
+            s.push('?');
+            s.push_str(&query);
+        }
+        if tc.draw(generators::booleans()) {
+            let fragment: String =
+                tc.draw(generators::from_regex(r"[a-zA-Z0-9._~-]{0,12}").fullmatch(true));
+            s.push('#');
+            s.push_str(&fragment);
+        }
+        s
+    }
+
+    /// Strings that parse as URLs often enough to exercise success paths,
+    /// while still covering arbitrary garbage: raw unicode text, text behind
+    /// a scheme prefix, and fully plausible URLs.
+    #[hegel::composite]
+    fn url_ish(tc: &hegel::TestCase) -> String {
+        tc.draw(hegel::one_of!(
+            generators::text().boxed(),
+            hegel::compose!(|tc| {
+                let scheme: String = tc
+                    .draw(generators::from_regex(r"[a-z][a-z0-9+.-]{0,5}:(//)?").fullmatch(true));
+                let rest: String = tc.draw(generators::text().max_size(40));
+                format!("{}{}", scheme, rest)
+            })
+            .boxed(),
+            plausible_url().boxed(),
+        ))
+    }
+
+    fn assert_components_eq(a: &Url, b: &Url) {
+        assert_eq!(a.scheme(), b.scheme());
+        assert_eq!(a.username(), b.username());
+        assert_eq!(a.password(), b.password());
+        assert_eq!(a.host_str(), b.host_str());
+        assert_eq!(a.host(), b.host());
+        assert_eq!(a.port(), b.port());
+        assert_eq!(a.path(), b.path());
+        assert_eq!(a.query(), b.query());
+        assert_eq!(a.fragment(), b.fragment());
+        assert_eq!(a.cannot_be_a_base(), b.cannot_be_a_base());
+    }
+
+    /// Parsing arbitrary text must never panic (parse robustness).
+    #[hegel::test]
+    fn hegel_parse_never_panics(tc: hegel::TestCase) {
+        let s: String = tc.draw(hegel::one_of!(
+            generators::text().boxed(),
+            url_ish().boxed()
+        ));
+        drop(Url::parse(&s));
+    }
+
+    /// Any successfully parsed URL must satisfy the crate's own internal
+    /// invariant checker (`Url::check_invariants`).
+    #[hegel::test]
+    fn hegel_parsed_url_upholds_check_invariants(tc: hegel::TestCase) {
+        let s: String = tc.draw(url_ish());
+        if let Ok(url) = Url::parse(&s) {
+            url.check_invariants().unwrap();
+        }
+    }
+
+    /// The crown stability property: serializing a parsed URL and re-parsing
+    /// it is a fixed point. (This mirrors the crate's own fuzz target
+    /// `fuzz/fuzz_targets/parse.rs`.)
+    #[hegel::test]
+    fn hegel_parse_serialize_parse_is_fixed_point(tc: hegel::TestCase) {
+        let s: String = tc.draw(url_ish());
+        if let Ok(url) = Url::parse(&s) {
+            let reparsed = Url::parse(url.as_str()).unwrap_or_else(|e| {
+                panic!(
+                    "serialization of parsed URL failed to re-parse: {:?} from input {:?}: {}",
+                    url.as_str(),
+                    s,
+                    e
+                )
+            });
+            assert_eq!(url, reparsed);
+            assert_eq!(url.as_str(), reparsed.as_str());
+            assert_components_eq(&url, &reparsed);
+            reparsed.check_invariants().unwrap();
+        }
+    }
+
+    /// Same fixed-point property, but on generated plausible URLs where the
+    /// parse is required to succeed (no vacuous guard).
+    #[hegel::test]
+    fn hegel_plausible_url_parse_serialize_parse_is_fixed_point(tc: hegel::TestCase) {
+        let s: String = tc.draw(plausible_url());
+        let url =
+            Url::parse(&s).unwrap_or_else(|e| panic!("plausible URL {:?} failed to parse: {}", s, e));
+        url.check_invariants().unwrap();
+        let reparsed = Url::parse(url.as_str()).unwrap();
+        assert_eq!(url, reparsed);
+        assert_eq!(url.as_str(), reparsed.as_str());
+        assert_components_eq(&url, &reparsed);
+    }
+
+    /// `as_str()` is exactly the concatenation of the component getters:
+    /// scheme ":" ["//" authority] path ["?" query] ["#" fragment].
+    #[hegel::test]
+    fn hegel_as_str_is_concatenation_of_components(tc: hegel::TestCase) {
+        let s: String = tc.draw(url_ish());
+        if let Ok(url) = Url::parse(&s) {
+            let mut expected = String::new();
+            expected.push_str(url.scheme());
+            expected.push(':');
+            if url.has_authority() {
+                expected.push_str("//");
+                expected.push_str(url.authority());
+            }
+            expected.push_str(url.path());
+            if let Some(query) = url.query() {
+                expected.push('?');
+                expected.push_str(query);
+            }
+            if let Some(fragment) = url.fragment() {
+                expected.push('#');
+                expected.push_str(fragment);
+            }
+            assert_eq!(
+                expected,
+                url.as_str(),
+                "components do not concatenate to as_str() for input {:?}",
+                s
+            );
+        }
+    }
+
+    /// `authority()` is exactly the concatenation of
+    /// [username [":" password] "@"] host [":" port].
+    #[hegel::test]
+    fn hegel_authority_is_concatenation_of_credentials_host_port(tc: hegel::TestCase) {
+        let s: String = tc.draw(url_ish());
+        if let Ok(url) = Url::parse(&s) {
+            if !url.has_authority() {
+                assert_eq!(url.authority(), "");
+                return;
+            }
+            let mut expected = String::new();
+            if !url.username().is_empty() || url.password().is_some() {
+                expected.push_str(url.username());
+                if let Some(password) = url.password() {
+                    expected.push(':');
+                    expected.push_str(password);
+                }
+                expected.push('@');
+            }
+            if let Some(host) = url.host_str() {
+                expected.push_str(host);
+            }
+            if let Some(port) = url.port() {
+                expected.push_str(&format!(":{}", port));
+            }
+            assert_eq!(
+                expected,
+                url.authority(),
+                "authority mismatch for input {:?}",
+                s
+            );
+        }
+    }
+
+    /// Setting fragment / query / path to values made only of characters that
+    /// the parser neither encodes nor normalizes must round-trip exactly
+    /// through the getters, and the URL must still re-parse to itself.
+    #[hegel::test]
+    fn hegel_safe_setter_values_roundtrip_through_getters(tc: hegel::TestCase) {
+        let s: String = tc.draw(plausible_url());
+        let mut url = Url::parse(&s).unwrap();
+
+        let fragment: String =
+            tc.draw(generators::from_regex(r"[a-zA-Z0-9._~-]{0,12}").fullmatch(true));
+        url.set_fragment(Some(&fragment));
+        assert_eq!(url.fragment(), Some(fragment.as_str()));
+
+        let query: String =
+            tc.draw(generators::from_regex(r"[a-zA-Z0-9=&._~-]{0,12}").fullmatch(true));
+        url.set_query(Some(&query));
+        assert_eq!(url.query(), Some(query.as_str()));
+        // set_query must preserve the fragment
+        assert_eq!(url.fragment(), Some(fragment.as_str()));
+
+        let segments: Vec<String> = tc.draw(
+            generators::vecs(
+                generators::from_regex(r"[a-zA-Z0-9][a-zA-Z0-9_~-]{0,7}").fullmatch(true),
+            )
+            .max_size(4),
+        );
+        let mut path = String::new();
+        for segment in &segments {
+            path.push('/');
+            path.push_str(segment);
+        }
+        if path.is_empty() {
+            path.push('/');
+        }
+        url.set_path(&path);
+        assert_eq!(url.path(), path);
+        // set_path must preserve query and fragment
+        assert_eq!(url.query(), Some(query.as_str()));
+        assert_eq!(url.fragment(), Some(fragment.as_str()));
+
+        url.check_invariants().unwrap();
+        let reparsed = Url::parse(url.as_str()).unwrap();
+        assert_eq!(url, reparsed);
+        assert_components_eq(&url, &reparsed);
+
+        url.set_fragment(None);
+        assert_eq!(url.fragment(), None);
+        url.set_query(None);
+        assert_eq!(url.query(), None);
+        url.check_invariants().unwrap();
+    }
+
+    /// After hitting a parsed URL with setters fed *arbitrary* text, the URL
+    /// must still satisfy the internal invariants and re-parse to itself
+    /// (i.e. setters can never produce an invalid serialization).
+    #[hegel::test]
+    fn hegel_arbitrary_setter_values_keep_url_reparseable(tc: hegel::TestCase) {
+        let s: String = tc.draw(url_ish());
+        let mut url = match Url::parse(&s) {
+            Ok(url) => url,
+            Err(_) => return,
+        };
+        // A drawn sequence of setter calls with arbitrary payloads.
+        let n_ops = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+        for _ in 0..n_ops {
+            let op = tc.draw(generators::integers::<u8>().max_value(7));
+            let value: String = tc.draw(generators::text().max_size(30));
+            // KNOWN BUG exclusion: `set_path` on a cannot-be-a-base URL
+            // embeds raw '?' / '#' into the serialization without updating
+            // query_start/fragment_start, breaking Url's internal invariants.
+            // Pinned by hegel_set_path_on_cannot_be_a_base_url_upholds_invariants
+            // below; skipped here so this property keeps testing everything else.
+            let skip_set_path_bug =
+                url.cannot_be_a_base() && (value.contains('?') || value.contains('#'));
+            // KNOWN BUG exclusion: `set_host(Some(""))` on a non-special URL
+            // that has credentials or a port returns Ok but leaves a
+            // serialization like "a://user@" or "a://:1" that Url::parse
+            // rejects with EmptyHost. Pinned by
+            // hegel_set_empty_host_with_credentials_or_port below.
+            let skip_set_host_bug = value.is_empty()
+                && (!url.username().is_empty()
+                    || url.password().is_some()
+                    || url.port().is_some());
+            match op {
+                0 => url.set_fragment(Some(&value)),
+                1 => url.set_query(Some(&value)),
+                2 => {
+                    if !skip_set_path_bug {
+                        url.set_path(&value)
+                    }
+                }
+                3 => drop(url.set_username(&value)),
+                4 => drop(url.set_password(Some(&value))),
+                5 => {
+                    if !skip_set_host_bug {
+                        drop(url.set_host(Some(&value)))
+                    }
+                }
+                6 => drop(url.set_scheme(&value)),
+                _ => drop(url.set_port(Some(tc.draw(generators::integers::<u16>())))),
+            }
+            url.check_invariants().unwrap_or_else(|e| {
+                panic!(
+                    "invariants broken after setter {} with value {:?}: {}",
+                    op, value, e
+                )
+            });
+        }
+        let reparsed = Url::parse(url.as_str())
+            .unwrap_or_else(|e| panic!("mutated URL {:?} failed to re-parse: {}", url.as_str(), e));
+        assert_eq!(url, reparsed);
+        assert_components_eq(&url, &reparsed);
+    }
+
+    /// Setting a special scheme's default port normalizes to `port() == None`,
+    /// and `port_or_known_default()` always reports the effective port.
+    #[hegel::test]
+    fn hegel_set_port_default_port_normalization(tc: hegel::TestCase) {
+        let (scheme, default_port): (&str, u16) = tc.draw(generators::sampled_from(vec![
+            ("http", 80u16),
+            ("https", 443),
+            ("ws", 80),
+            ("wss", 443),
+            ("ftp", 21),
+        ]));
+        let host: String = tc.draw(generators::from_regex(r"[a-z][a-z0-9]{0,7}").fullmatch(true));
+        let mut url = Url::parse(&format!("{}://{}/", scheme, host)).unwrap();
+        assert_eq!(url.port(), None);
+        assert_eq!(url.port_or_known_default(), Some(default_port));
+
+        // Setting the scheme's default port must normalize to None.
+        url.set_port(Some(default_port)).unwrap();
+        assert_eq!(url.port(), None);
+
+        // Setting any port makes port_or_known_default report exactly it.
+        let port: u16 = tc.draw(generators::integers::<u16>());
+        url.set_port(Some(port)).unwrap();
+        if port == default_port {
+            assert_eq!(url.port(), None);
+        } else {
+            assert_eq!(url.port(), Some(port));
+        }
+        assert_eq!(url.port_or_known_default(), Some(port));
+        url.check_invariants().unwrap();
+        assert_eq!(url, Url::parse(url.as_str()).unwrap());
+
+        url.set_port(None).unwrap();
+        assert_eq!(url.port(), None);
+        assert_eq!(url.port_or_known_default(), Some(default_port));
+        url.check_invariants().unwrap();
+    }
+
+    /// Joining an absolute URL's serialization against any base returns that
+    /// URL again (the base is ignored).
+    #[hegel::test]
+    fn hegel_join_absolute_url_is_that_url(tc: hegel::TestCase) {
+        let base = Url::parse(&tc.draw(plausible_url())).unwrap();
+        let absolute = Url::parse(&tc.draw(plausible_url())).unwrap();
+        let joined = base.join(absolute.as_str()).unwrap_or_else(|e| {
+            panic!(
+                "join of absolute {:?} on base {:?} failed: {}",
+                absolute.as_str(),
+                base.as_str(),
+                e
+            )
+        });
+        assert_eq!(joined, absolute);
+        assert_eq!(joined.as_str(), absolute.as_str());
+        joined.check_invariants().unwrap();
+    }
+
+    /// Per the WHATWG spec, `base.join("")` returns the base URL without its
+    /// fragment.
+    #[hegel::test]
+    fn hegel_join_empty_string_is_base_without_fragment(tc: hegel::TestCase) {
+        let base = Url::parse(&tc.draw(plausible_url())).unwrap();
+        let joined = base.join("").unwrap();
+        let mut expected = base.clone();
+        expected.set_fragment(None);
+        assert_eq!(joined, expected);
+        assert_eq!(joined.as_str(), expected.as_str());
+        joined.check_invariants().unwrap();
+    }
+
+    /// A tuple origin depends only on scheme, host and port: it is stable
+    /// under re-parsing and unchanged by path/query/fragment mutation.
+    #[hegel::test]
+    fn hegel_origin_ignores_path_query_fragment(tc: hegel::TestCase) {
+        let scheme: &str = tc.draw(generators::sampled_from(vec![
+            "http", "https", "ws", "wss", "ftp",
+        ]));
+        let host: String = tc.draw(
+            generators::from_regex(r"([a-z0-9]{1,8}\.){0,2}[a-z][a-z0-9]{0,7}").fullmatch(true),
+        );
+        let mut url = Url::parse(&format!("{}://{}/", scheme, host)).unwrap();
+        let origin = url.origin();
+        assert!(origin.is_tuple());
+        // Origin equals itself when recomputed (unlike opaque origins).
+        assert_eq!(origin, url.origin());
+
+        let path: String =
+            tc.draw(generators::from_regex(r"(/[a-zA-Z0-9._~-]{1,8}){0,3}").fullmatch(true));
+        url.set_path(&path);
+        let query: Option<String> = tc.draw(generators::optional(
+            generators::from_regex(r"[a-zA-Z0-9=&._~-]{0,12}").fullmatch(true),
+        ));
+        url.set_query(query.as_deref());
+        let fragment: Option<String> = tc.draw(generators::optional(
+            generators::from_regex(r"[a-zA-Z0-9._~-]{0,12}").fullmatch(true),
+        ));
+        url.set_fragment(fragment.as_deref());
+        assert_eq!(url.origin(), origin);
+
+        // Stable under re-parse.
+        let reparsed = Url::parse(url.as_str()).unwrap();
+        assert_eq!(reparsed.origin(), origin);
+
+        // And matches Origin's own serialization contract.
+        match origin {
+            Origin::Tuple(ref s, _, p) => {
+                assert_eq!(s, url.scheme());
+                assert_eq!(Some(p), url.port_or_known_default());
+            }
+            Origin::Opaque(_) => unreachable!(),
+        }
+    }
+    /// KNOWN FAILURE — pins a real bug in `Url::set_path`.
+    ///
+    /// For cannot-be-a-base (opaque-path) URLs, `set_path` routes the value
+    /// through `Parser::parse_cannot_be_a_base_path` in setter context
+    /// (url/src/parser.rs, `Context::Setter`), where the `'?' | '#'`
+    /// early-return guard only applies to `Context::UrlParser`. The characters
+    /// are therefore written *raw* into the serialization (the CONTROLS
+    /// percent-encode set does not cover them) without setting
+    /// `query_start`/`fragment_start`.
+    ///
+    /// Result: the crate's own `Url::check_invariants()` fails, and the URL's
+    /// getters disagree with a re-parse of its own serialization, e.g.:
+    ///   Url::parse("a:").set_path("?")  =>  as_str() == "a:?" with
+    ///   query() == None, while Url::parse("a:?").query() == Some("").
+    /// By contrast, non-opaque paths correctly encode to %3F / %23.
+    ///
+    /// Every generated case triggers the bug, so this test fails
+    /// deterministically. Do not "fix" the test — fix `set_path`.
+    #[hegel::test]
+    fn hegel_set_path_on_cannot_be_a_base_url_upholds_invariants(tc: hegel::TestCase) {
+        // A cannot-be-a-base URL: scheme + non-empty opaque path, no "//".
+        let scheme: String =
+            tc.draw(generators::from_regex(r"[a-z][a-z0-9+.-]{0,5}").fullmatch(true));
+        let opaque: String =
+            tc.draw(generators::from_regex(r"[a-zA-Z0-9._~-]{0,6}").fullmatch(true));
+        let url_str = format!("{}:{}", scheme, opaque);
+        let mut url = Url::parse(&url_str).unwrap();
+        tc.assume(url.cannot_be_a_base());
+
+        // A new path value that always contains '?' or '#'.
+        let prefix: String =
+            tc.draw(generators::from_regex(r"[a-zA-Z0-9._~-]{0,6}").fullmatch(true));
+        let special: &str = tc.draw(generators::sampled_from(vec!["?", "#"]));
+        let suffix: String =
+            tc.draw(generators::from_regex(r"[a-zA-Z0-9._~-]{0,6}").fullmatch(true));
+        let new_path = format!("{}{}{}", prefix, special, suffix);
+
+        url.set_path(&new_path);
+        url.check_invariants().unwrap_or_else(|e| {
+            panic!(
+                "set_path({:?}) on {:?} broke Url's internal invariants: {}",
+                new_path, url_str, e
+            )
+        });
+        let reparsed = Url::parse(url.as_str()).unwrap();
+        assert_components_eq(&url, &reparsed);
+    }
+    /// KNOWN FAILURE — pins a real bug in `Url::set_host`.
+    ///
+    /// The WHATWG hostname setter fails when the new host is the empty string
+    /// and the URL includes credentials or a port ("host state" with state
+    /// override: <https://url.spec.whatwg.org/#host-state>). `Url::set_host`
+    /// only enforces the empty-host rejection for special schemes
+    /// (url/src/lib.rs, `set_host`), so on a non-special URL with credentials
+    /// or a port it returns Ok(()) and produces a serialization such as
+    /// "a://user@" or "a://:1" that `Url::parse` itself rejects with
+    /// `ParseError::EmptyHost` — `check_invariants()` panics with
+    /// "Failed to parse myself?".
+    ///
+    /// The converse direction is guarded correctly: `set_username`/`set_port`
+    /// on an empty-host URL return Err.
+    ///
+    /// Every generated case triggers the bug, so this test fails
+    /// deterministically. Do not "fix" the test — fix `set_host`.
+    #[hegel::test]
+    fn hegel_set_empty_host_with_credentials_or_port(tc: hegel::TestCase) {
+        let scheme: String =
+            tc.draw(generators::from_regex(r"[a-z][a-z0-9+.-]{0,5}").fullmatch(true));
+        // Non-special scheme only: special schemes correctly reject "".
+        tc.assume(!matches!(
+            scheme.as_str(),
+            "http" | "https" | "ws" | "wss" | "ftp" | "file"
+        ));
+        let host: String = tc.draw(generators::from_regex(r"[a-z][a-z0-9]{0,7}").fullmatch(true));
+        // Give the URL credentials, a port, or both.
+        let user: Option<String> = tc.draw(generators::optional(
+            generators::from_regex(r"[a-zA-Z0-9._~-]{1,8}").fullmatch(true),
+        ));
+        let port: Option<u16> = tc.draw(generators::optional(generators::integers::<u16>()));
+        tc.assume(user.is_some() || port.is_some());
+        let mut url_str = format!("{}://", scheme);
+        if let Some(ref user) = user {
+            url_str.push_str(user);
+            url_str.push('@');
+        }
+        url_str.push_str(&host);
+        if let Some(port) = port {
+            url_str.push_str(&format!(":{}", port));
+        }
+        let mut url = Url::parse(&url_str).unwrap();
+
+        if url.set_host(Some("")).is_ok() {
+            // If the setter accepted the empty host, the URL must still
+            // re-parse to itself.
+            let reparsed = Url::parse(url.as_str()).unwrap_or_else(|e| {
+                panic!(
+                    "set_host(Some(\"\")) on {:?} produced unparseable URL {:?}: {}",
+                    url_str,
+                    url.as_str(),
+                    e
+                )
+            });
+            assert_components_eq(&url, &reparsed);
+        }
+    }
+}
