+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel).
+//
+// See HEGEL_REPORT.md at the repository root for a summary of the properties
+// and of the real bugs pinned by the `known_bug_*` tests below.
+// ---------------------------------------------------------------------------
+#[cfg(test)]
+mod hegel_properties {
+    use std::collections::BTreeMap;
+    #[cfg(feature = "sets")]
+    use std::collections::BTreeSet;
+    use std::str::FromStr;
+
+    #[cfg(feature = "sets")]
+    use edn_rs::Set;
+    use edn_rs::{Edn, List, Map, Vector};
+    use hegel::generators::{self, Generator};
+
+    // ------------------------------------------------------------------
+    // Generators
+    // ------------------------------------------------------------------
+
+    const RESERVED: [&str; 3] = ["true", "false", "nil"];
+
+    /// Any Unicode scalar value, weighted across ASCII / BMP / supplementary planes.
+    fn any_char() -> impl Generator<char> {
+        hegel::one_of!(
+            generators::integers::<u32>().max_value(0x7F),
+            generators::integers::<u32>()
+                .min_value(0x80)
+                .max_value(0xFFFF),
+            generators::integers::<u32>()
+                .min_value(0x1_0000)
+                .max_value(0x10_FFFF),
+        )
+        .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}'))
+    }
+
+    /// Characters that survive `Edn::Str`'s `{:?}` (Rust `Debug`) serialization:
+    /// the escapes the EDN parser understands (\t \r \n \\ \") plus any char
+    /// that `Debug` prints verbatim. Everything else is Debug-escaped as
+    /// `\u{..}`, which the parser rejects — see
+    /// `known_bug_control_char_in_string_does_not_reparse`.
+    fn str_safe(c: char) -> bool {
+        matches!(c, '\t' | '\n' | '\r' | '\\' | '"' | '\'') || c.escape_debug().count() == 1
+    }
+
+    fn draw_string(tc: &hegel::TestCase) -> String {
+        let chars: Vec<char> = tc.draw((generators::vecs(any_char()).max_size(12)).print_as_debug());
+        chars
+            .into_iter()
+            .map(|c| if str_safe(c) { c } else { '\u{FFFD}' })
+            .collect()
+    }
+
+    fn draw_char(tc: &hegel::TestCase) -> char {
+        let c = tc.draw(hegel::one_of!(
+            any_char().boxed(),
+            generators::sampled_from(vec![
+                '\n', '\r', '\t', ' ', '\\', '"', ',', ']', ')', '}', '(', 'n', 't', 's', 'r', 'u',
+            ])
+            .boxed(),
+        ));
+        // KNOWN BUG exclusion: non-ASCII whitespace (U+00A0, U+2028, ...) serializes
+        // as `\<char>` which the parser rejects — see
+        // `known_bug_unicode_whitespace_char_does_not_reparse`.
+        if c.is_whitespace() && !matches!(c, ' ' | '\t' | '\n' | '\r') {
+            ' '
+        } else {
+            c
+        }
+    }
+
+    /// A plain (non-namespaced) EDN symbol/keyword name.
+    fn draw_name(tc: &hegel::TestCase) -> String {
+        let base: String = tc
+            .draw(generators::from_regex(r"[A-Za-z][A-Za-z0-9_.*+!?$%&=<>-]{0,8}").fullmatch(true));
+        if RESERVED.contains(&base.as_str()) {
+            format!("{base}x")
+        } else {
+            base
+        }
+    }
+
+    /// A symbol name, optionally namespaced (`foo/bar`).
+    fn draw_symbol_name(tc: &hegel::TestCase) -> String {
+        let name = draw_name(tc);
+        if tc.draw(generators::booleans()) {
+            format!("{}/{name}", draw_name(tc))
+        } else {
+            name
+        }
+    }
+
+    fn draw_double(tc: &hegel::TestCase) -> f64 {
+        // NaN/infinity are excluded because the crate cannot emit them as valid
+        // EDN at all (`NaN`/`inf` are parsed back as symbols) — part of the
+        // Double serialization bug pinned by
+        // `known_bug_whole_double_reparses_as_integer`.
+        let d = tc.draw(
+            generators::floats::<f64>()
+                .allow_nan(false)
+                .allow_infinity(false),
+        );
+        if d.fract() == 0.0 {
+            // KNOWN BUG exclusion: integral doubles display without ".0" and
+            // reparse as UInt/Int — see
+            // `known_bug_whole_double_reparses_as_integer`. Replace with a
+            // guaranteed-fractional value.
+            f64::from(tc.draw(generators::integers::<i32>())) + 0.5
+        } else {
+            d
+        }
+    }
+
+    fn draw_rational(tc: &hegel::TestCase) -> String {
+        let num = tc.draw(generators::integers::<i64>());
+        let den = tc.draw(generators::integers::<u64>());
+        format!("{num}/{den}")
+    }
+
+    /// A map key in its serialized form (`Edn::Map` stores keys as `String`,
+    /// holding the serialized form of the key element).
+    fn draw_map_key(tc: &hegel::TestCase) -> String {
+        match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => format!(":{}", draw_symbol_name(tc)),
+            1 => tc.draw(generators::integers::<u64>()).to_string(),
+            _ => format!("{:?}", draw_string(tc)),
+        }
+    }
+
+    /// Recursive generator over parser-canonical `Edn` values.
+    ///
+    /// "Parser-canonical" means values `Edn::from_str` can actually produce:
+    /// non-negative integers are always `UInt` (the parser tries `u64` first),
+    /// doubles are non-integral, strings/chars avoid the pinned known-bug
+    /// regions (each exclusion is commented at its generator above).
+    fn edn_values(depth: u32) -> generators::BoxedGenerator<'static, Edn> {
+        hegel::compose!(|tc| {
+            let max_kind: u8 = if depth == 0 {
+                9
+            } else if cfg!(feature = "sets") {
+                14
+            } else {
+                13
+            };
+            let kind = tc.draw(generators::integers::<u8>().max_value(max_kind));
+            match kind {
+                0 => Edn::Nil,
+                1 => Edn::Bool(tc.draw(generators::booleans())),
+                // Only negative: the parser canonicalizes non-negative integers
+                // to UInt (see prop_integer_decimal_roundtrip).
+                2 => Edn::Int(tc.draw(generators::integers::<i64>().max_value(-1))),
+                3 => Edn::UInt(tc.draw(generators::integers::<u64>())),
+                4 => Edn::Double(draw_double(&tc).into()),
+                5 => Edn::Rational(draw_rational(&tc)),
+                6 => Edn::Str(draw_string(&tc)),
+                7 => Edn::Char(draw_char(&tc)),
+                8 => Edn::Key(format!(":{}", draw_symbol_name(&tc))),
+                9 => Edn::Symbol(draw_symbol_name(&tc)),
+                10 => Edn::Vector(Vector::new(
+                    tc.draw((generators::vecs(edn_values(depth - 1)).max_size(4)).print_as_debug()),
+                )),
+                11 => Edn::List(List::new(
+                    tc.draw((generators::vecs(edn_values(depth - 1)).max_size(4)).print_as_debug()),
+                )),
+                12 => {
+                    let n = tc.draw(generators::integers::<usize>().max_value(3));
+                    let mut m = BTreeMap::new();
+                    for _ in 0..n {
+                        let k = draw_map_key(&tc);
+                        let v = tc.draw((edn_values(depth - 1)).print_as_debug());
+                        m.insert(k, v);
+                    }
+                    Edn::Map(Map::new(m))
+                }
+                13 => Edn::Tagged(
+                    tc.draw(generators::from_regex(r"[A-Za-z][A-Za-z0-9._-]{0,8}").fullmatch(true)),
+                    Box::new(tc.draw((edn_values(depth - 1)).print_as_debug())),
+                ),
+                #[cfg(feature = "sets")]
+                14 => {
+                    let n = tc.draw(generators::integers::<usize>().max_value(3));
+                    let mut s = BTreeSet::new();
+                    for _ in 0..n {
+                        s.insert(tc.draw((edn_values(depth - 1)).print_as_debug()));
+                    }
+                    Edn::Set(Set::new(s))
+                }
+                _ => unreachable!(),
+            }
+        })
+        .boxed()
+    }
+
+    /// True when the serialized document would *end* with a single-character
+    /// symbol at EOF: a bare 1-char symbol, or a `Tagged` chain whose final
+    /// value is one (a tagged value has no closing delimiter after it).
+    /// KNOWN BUG exclusion — see `known_bug_single_char_symbol_at_eof_fails`.
+    fn ends_with_single_char_symbol(v: &Edn) -> bool {
+        match v {
+            Edn::Symbol(s) => s.len() == 1,
+            Edn::Tagged(_, inner) => ends_with_single_char_symbol(inner),
+            _ => false,
+        }
+    }
+
+    // ------------------------------------------------------------------
+    // Property 1: serialize -> parse is the identity on parser-canonical
+    // values, and serialization is a fixpoint.
+    // ------------------------------------------------------------------
+    #[hegel::test]
+    fn prop_serialize_parse_fixpoint(tc: hegel::TestCase) {
+        let v = tc.draw((edn_values(3)).print_as_debug());
+        // KNOWN BUG exclusion: a document ending in a single-char symbol
+        // (bare, or as the final value of a tagged element, e.g. "#A A")
+        // fails to parse; inside bracketed containers it is fine — see
+        // `known_bug_single_char_symbol_at_eof_fails`.
+        tc.assume(!ends_with_single_char_symbol(&v));
+        let s = v.to_string();
+        let parsed = Edn::from_str(&s)
+            .unwrap_or_else(|e| panic!("failed to reparse {s:?} (from {v:?}): {e:?}"));
+        assert_eq!(parsed, v, "roundtrip changed value, serialized: {s:?}");
+        let s2 = parsed.to_string();
+        assert_eq!(s2, s, "serialize -> parse -> serialize is not a fixpoint");
+    }
+
