+
+    #[hegel::test]
+    fn prop_parse_never_panics(tc: hegel::TestCase) {
+        let s: String = tc.draw(hegel::one_of!(
+            generators::text().boxed(),
+            edn_soup().boxed(),
+        ));
+        drop(Edn::from_str(&s));
+    }
+
+    // ------------------------------------------------------------------
+    // Property 3: deeply nested balanced collections parse successfully.
+    //
+    // Depth is capped at 300 because the parser recurses once per nesting
+    // level and overflows the 2 MiB test-thread stack at roughly depth 1000
+    // (a real bug). The cap protects the test process, not the library's
+    // contract — see `known_bug_deep_nesting_stack_overflow` below.
+    // ------------------------------------------------------------------
+    #[hegel::test]
+    fn prop_deeply_nested_collections_parse(tc: hegel::TestCase) {
+        let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(300));
+        let max_kind: u8 = if cfg!(feature = "sets") { 3 } else { 2 };
+        let kinds: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>().max_value(max_kind))
+                .min_size(depth)
+                .max_size(depth),
+        );
+        let mut s = String::new();
+        for k in &kinds {
+            s.push_str(match k {
+                0 => "[",
+                1 => "(",
+                2 => "{:k ",
+                _ => "#{",
+            });
+        }
+        s.push('1');
+        for k in kinds.iter().rev() {
+            s.push_str(match k {
+                0 => "]",
+                1 => ")",
+                _ => "}",
+            });
+        }
+        let r = Edn::from_str(&s);
+        assert!(r.is_ok(), "depth {depth} failed: {r:?}");
+    }
+
+    // ------------------------------------------------------------------
+    // Property 4: decimal integers parse to the correct value across the
+    // full i64/u64 range (boundaries included). The parser's canonical form
+    // is UInt for non-negative values and Int for negatives; a redundant
+    // leading '+' is allowed by the EDN spec.
+    // ------------------------------------------------------------------
+    #[hegel::test]
+    fn prop_integer_decimal_roundtrip(tc: hegel::TestCase) {
+        let n: i64 = tc.draw(hegel::one_of!(
+            generators::integers::<i64>().boxed(),
+            generators::sampled_from(vec![i64::MIN, i64::MAX, 0, -1, 1]).boxed(),
+        ));
+        let expected = if n >= 0 {
+            Edn::UInt(u64::try_from(n).unwrap())
+        } else {
+            Edn::Int(n)
+        };
+        assert_eq!(Edn::from_str(&n.to_string()), Ok(expected));
+
+        let u: u64 = tc.draw(hegel::one_of!(
+            generators::integers::<u64>().boxed(),
+            generators::sampled_from(vec![u64::MAX, 1 << 63, 0, 1]).boxed(),
+        ));
+        assert_eq!(Edn::from_str(&u.to_string()), Ok(Edn::UInt(u)));
+        assert_eq!(Edn::from_str(&format!("+{u}")), Ok(Edn::UInt(u)));
+    }
+
+    // ------------------------------------------------------------------
+    // Property 5: radix integer literals (NrDIGITS and 0x hex) parse to the
+    // value computed by an independent base-conversion oracle.
+    // ------------------------------------------------------------------
+    fn to_radix_string(mut v: u64, radix: u32) -> String {
+        const DIGITS: &[u8] = b"0123456789abcdefghijklmnopqrstuvwxyz";
+        if v == 0 {
+            return "0".to_string();
+        }
+        let mut out = Vec::new();
+        while v > 0 {
+            out.push(DIGITS[usize::try_from(v % u64::from(radix)).unwrap()]);
+            v /= u64::from(radix);
+        }
+        out.reverse();
+        String::from_utf8(out).unwrap()
+    }
+
+    /// KNOWN BUG exclusion: digit strings like "5e5" hit the parser's float
+    /// notation arm and are misparsed as doubles — see
+    /// `known_bug_radix_digits_with_e_misparse_as_double`.
+    fn hits_float_notation_bug(digits: &str) -> bool {
+        (digits.contains('e') || digits.contains('E')) && digits.parse::<f64>().is_ok()
+    }
+
+    #[hegel::test]
+    fn prop_radix_integer_parse(tc: hegel::TestCase) {
+        let v: u64 = tc.draw(hegel::one_of!(
+            generators::integers::<u64>().boxed(),
+            generators::sampled_from(vec![0, 1, u64::MAX, i64::MAX as u64]).boxed(),
+        ));
+        let radix = tc.draw(generators::integers::<u32>().min_value(2).max_value(36));
+        let mut digits = to_radix_string(v, radix);
+        if tc.draw(generators::booleans()) {
+            digits = digits.to_uppercase();
+        }
+        tc.assume(!hits_float_notation_bug(&digits));
+        assert_eq!(
+            Edn::from_str(&format!("{radix}r{digits}")),
+            Ok(Edn::UInt(v)),
+            "radix {radix}, digits {digits}"
+        );
+        if let Ok(iv) = i64::try_from(v)
+            && iv > 0
+        {
+            assert_eq!(
+                Edn::from_str(&format!("-{radix}r{digits}")),
+                Ok(Edn::Int(-iv)),
+                "radix {radix}, digits {digits}"
+            );
+        }
+
+        let hex = format!("{v:x}");
+        tc.assume(!hits_float_notation_bug(&hex));
+        assert_eq!(Edn::from_str(&format!("0x{hex}")), Ok(Edn::UInt(v)));
+    }
+
+    // ------------------------------------------------------------------
+    // Property 6: strings round-trip through serialization, generated at the
+    // escape-set boundary (quotes, backslashes, \n \r \t, delimiters,
+    // comment characters, full Unicode).
+    // ------------------------------------------------------------------
+    #[hegel::test]
+    fn prop_string_escape_roundtrip(tc: hegel::TestCase) {
+        let chars: Vec<char> = tc.draw(
+            generators::vecs(hegel::one_of!(
+                generators::sampled_from(vec![
+                    '"', '\\', '\n', '\t', '\r', '\'', '/', ';', '#', '{', '}', '[', ']', '(', ')',
+                    ' ', ',', ':', 'n', 't', 'u',
+                ])
+                .boxed(),
+                any_char().boxed(),
+            ))
+            .max_size(24),
+        );
+        // Control chars and other Debug-\u{..}-escaped chars excluded — see
+        // known_bug_control_char_in_string_does_not_reparse.
+        let s: String = chars
+            .into_iter()
+            .map(|c| if str_safe(c) { c } else { '\u{FFFD}' })
+            .collect();
+        let edn = Edn::Str(s);
+        let serialized = edn.to_string();
+        assert_eq!(
+            Edn::from_str(&serialized),
+            Ok(edn),
+            "serialized: {serialized:?}"
+        );
+    }
+
+    // ------------------------------------------------------------------
+    // Property 7: char literals round-trip through serialization, including
+    // the named literals (\newline \return \tab \space) and delimiters.
+    // ------------------------------------------------------------------
+    #[hegel::test]
+    fn prop_char_roundtrip(tc: hegel::TestCase) {
+        let c = draw_char(&tc);
+        let edn = Edn::Char(c);
+        let serialized = edn.to_string();
+        assert_eq!(
+            Edn::from_str(&serialized),
+            Ok(edn),
+            "serialized: {serialized:?}"
+        );
+    }
+
+    // ------------------------------------------------------------------
+    // Property 8: keywords (including namespaced ones) parse to Edn::Key and
+    // serialize back to the same text.
+    // ------------------------------------------------------------------
+    #[hegel::test]
+    fn prop_keyword_roundtrip(tc: hegel::TestCase) {
+        let k = format!(":{}", draw_symbol_name(&tc));
+        let parsed = Edn::from_str(&k);
+        assert_eq!(parsed, Ok(Edn::Key(k.clone())));
+        assert_eq!(parsed.unwrap().to_string(), k);
+    }
+
+    // ------------------------------------------------------------------
+    // Property 9: symbols (including namespaced ones) parse to Edn::Symbol
+    // and serialize back to the same text.
+    // ------------------------------------------------------------------
+    #[hegel::test]
+    fn prop_symbol_roundtrip(tc: hegel::TestCase) {
+        let mut name = draw_symbol_name(&tc);
+        // KNOWN BUG exclusion: a single-char symbol at end of input fails to
+        // parse — see `known_bug_single_char_symbol_at_eof_fails`.
+        if name.len() == 1 {
+            name.push('x');
+        }
+        let parsed = Edn::from_str(&name);
+        assert_eq!(parsed, Ok(Edn::Symbol(name.clone())));
+        assert_eq!(parsed.unwrap().to_string(), name);
+    }
+
+    // ------------------------------------------------------------------
+    // Property 10: parsing is insensitive to whitespace variants, commas,
+    // line comments (;) and #_ discard forms inserted between tokens.
+    // ------------------------------------------------------------------
+    fn sep(tc: &hegel::TestCase, out: &mut String) {
+        out.push_str(tc.draw(generators::sampled_from(vec![
+            " ",
+            ",",
+            "\n",
+            "\t",
+            "\r\n",
+            " ; comment with delimiters ]})\" \n",
+            ",, ",
+        ])));
+        if tc.draw(generators::booleans()) {
+            out.push_str(tc.draw(generators::sampled_from(vec![" ", ",", "\n", " ;;\n"])));
+        }
+    }
+
+    fn maybe_noise(tc: &hegel::TestCase, out: &mut String) {
+        if tc.draw(generators::booleans()) {
+            sep(tc, out);
+        }
+    }
+
+    /// With small probability, emit a `#_ <element>` discard form.
+    fn maybe_discard(tc: &hegel::TestCase, out: &mut String) {
+        if tc.draw(generators::integers::<u8>().max_value(9)) == 0 {
+            out.push_str("#_");
+            sep(tc, out);
+            out.push_str(tc.draw(generators::sampled_from(vec![
+                "0",
+                "nil",
+                ":discarded",
+                "[1 2]",
+                "\"gone\"",
+            ])));
+            sep(tc, out);
+        }
+    }
+
+    fn emit_noisy(tc: &hegel::TestCase, edn: &Edn, out: &mut String) {
+        match edn {
+            Edn::Vector(_) | Edn::List(_) => {
+                let (open, close) = if matches!(edn, Edn::Vector(_)) {
+                    ('[', ']')
+                } else {
+                    ('(', ')')
+                };
+                out.push(open);
+                for e in edn.iter_some().unwrap() {
+                    maybe_noise(tc, out);
+                    maybe_discard(tc, out);
+                    emit_noisy(tc, e, out);
+                    sep(tc, out);
+                }
+                maybe_noise(tc, out);
+                out.push(close);
+            }
+            Edn::Map(_) => {
+                out.push('{');
+                for (k, v) in edn.map_iter().unwrap() {
+                    maybe_noise(tc, out);
+                    out.push_str(k);
+                    sep(tc, out);
+                    emit_noisy(tc, v, out);
+                    sep(tc, out);
+                }
+                maybe_noise(tc, out);
+                out.push('}');
+            }
+            #[cfg(feature = "sets")]
+            Edn::Set(_) => {
+                out.push_str("#{");
+                for e in edn.set_iter().unwrap() {
+                    maybe_noise(tc, out);
+                    emit_noisy(tc, e, out);
+                    sep(tc, out);
+                }
+                maybe_noise(tc, out);
+                out.push('}');
+            }
+            Edn::Tagged(tag, inner) => {
+                out.push('#');
+                out.push_str(tag);
+                sep(tc, out);
+                emit_noisy(tc, inner, out);
+            }
+            _ => out.push_str(&edn.to_string()),
+        }
+    }
+
+    #[hegel::test]
+    fn prop_whitespace_comment_discard_insensitivity(tc: hegel::TestCase) {
+        let v = tc.draw((edn_values(2)).print_as_debug());
+        // KNOWN BUG exclusion: a document ending in a single-char symbol
+        // fails to parse — see `known_bug_single_char_symbol_at_eof_fails`.
+        tc.assume(!ends_with_single_char_symbol(&v));
+        let mut s = String::new();
+        maybe_noise(&tc, &mut s);
+        maybe_discard(&tc, &mut s);
+        emit_noisy(&tc, &v, &mut s);
+        assert_eq!(Edn::from_str(&s).as_ref(), Ok(&v), "noisy input: {s:?}");
+    }
+
+    // ------------------------------------------------------------------
+    // KNOWN FAILURES — real bugs, deterministically pinned.
+    // Do not "fix" these tests; fix the library.
+    // ------------------------------------------------------------------
+
+    /// KNOWN FAILURE — real bug: `Edn::Double` of a whole number serializes
+    /// without a ".0" suffix (`Edn::Double(3.0).to_string() == "3"`), so it
+    /// reparses as `Edn::UInt(3)`/`Edn::Int(-3)`. EDN distinguishes `3` from
+    /// `3.0`; the emitted text silently changes the value's type. (Related:
+    /// `Double(f64::NAN)`/`Double(f64::INFINITY)` serialize as `NaN`/`inf`,
+    /// which are not valid EDN and reparse as symbols.)
+    #[hegel::test]
+    fn known_bug_whole_double_reparses_as_integer(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<i32>());
+        let edn = Edn::Double(f64::from(n).into());
+        let s = edn.to_string();
+        let reparsed = Edn::from_str(&s);
+        assert_eq!(
+            reparsed.as_ref(),
+            Ok(&edn),
+            "Double({n}.0) serialized as {s:?} and reparsed as {reparsed:?}"
+        );
+    }
+
+    /// KNOWN FAILURE — real bug: `Edn::Str` serializes via Rust's `{:?}`
+    /// formatting, which escapes control characters as `\u{7f}` etc. The
+    /// parser only understands \t \r \n \\ \" and rejects `\u`, so any string
+    /// containing a control character serializes to unparseable EDN.
+    #[hegel::test]
+    fn known_bug_control_char_in_string_does_not_reparse(tc: hegel::TestCase) {
+        let cp: u32 = tc.draw(hegel::one_of!(
+            generators::integers::<u32>().max_value(0x08),
+            generators::integers::<u32>()
+                .min_value(0x0b)
+                .max_value(0x0c),
+            generators::integers::<u32>()
+                .min_value(0x0e)
+                .max_value(0x1f),
+            generators::just(0x7f_u32),
+        ));
+        let c = char::from_u32(cp).unwrap();
+        let edn = Edn::Str(format!("a{c}b"));
+        let s = edn.to_string();
+        let reparsed = Edn::from_str(&s);
+        assert_eq!(
+            reparsed.as_ref(),
+            Ok(&edn),
+            "Str with control char U+{cp:04X} serialized as {s:?} and reparsed as {reparsed:?}"
+        );
+    }
+
+    /// KNOWN FAILURE — real bug: `Edn::Char` of a non-ASCII whitespace
+    /// character (U+00A0 NBSP, U+2028 LINE SEPARATOR, ...) serializes as
+    /// `\<char>`, but the parser reads char literals with
+    /// `take_while(!is_whitespace)`, sees an empty element, and errors.
+    #[hegel::test]
+    fn known_bug_unicode_whitespace_char_does_not_reparse(tc: hegel::TestCase) {
+        let c = tc.draw(generators::sampled_from(vec![
+            '\u{85}', '\u{a0}', '\u{1680}', '\u{2000}', '\u{2003}', '\u{2028}', '\u{2029}',
+            '\u{202f}', '\u{3000}',
+        ]));
+        let edn = Edn::Char(c);
+        let s = edn.to_string();
+        let reparsed = Edn::from_str(&s);
+        assert_eq!(
+            reparsed.as_ref(),
+            Ok(&edn),
+            "Char(U+{:04X}) serialized as {s:?} and reparsed as {reparsed:?}",
+            c as u32
+        );
+    }
+
+    /// KNOWN FAILURE — real bug: after stripping a `0x`/`NNr` radix prefix,
+    /// the parser checks the remaining digits against float notation *first*,
+    /// so hex/radix digit strings that happen to look like `<digits>e<digits>`
+    /// are misparsed as doubles: `0x5e5` parses as `Double(500000.0)` instead
+    /// of `UInt(0x5e5) == UInt(1509)`.
+    #[hegel::test]
+    fn known_bug_radix_digits_with_e_misparse_as_double(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<u32>().max_value(9));
+        let b = tc.draw(generators::integers::<u32>().max_value(9));
+        let digits = format!("{a}e{b}");
+        let expected = u64::from_str_radix(&digits, 16).unwrap();
+        let parsed = Edn::from_str(&format!("0x{digits}"));
+        assert_eq!(
+            parsed.as_ref(),
+            Ok(&Edn::UInt(expected)),
+            "0x{digits} parsed as {parsed:?}"
+        );
+    }
+
+    /// KNOWN FAILURE — real bug: a single-character symbol at the end of the
+    /// input fails to parse: `Edn::from_str("a")` returns
+    /// `Err(ParseEdn("Could not identify symbol index"))`. `read_symbol` (and
+    /// `read_bool_or_nil`) unconditionally require a lookahead character to
+    /// compute an error-message index, so a symbol whose last char is the last
+    /// char of the document errors out. `"a "` (trailing space) parses fine.
+    /// Also reproduces nested at end-of-document, e.g. `"#A A"` (a tagged
+    /// element whose value is a single-char symbol).
+    #[hegel::test]
+    fn known_bug_single_char_symbol_at_eof_fails(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::from_regex(r"[A-Za-z*!?$%&=<>]").fullmatch(true));
+        let parsed = Edn::from_str(&s);
+        assert_eq!(
+            parsed.as_ref(),
+            Ok(&Edn::Symbol(s.clone())),
+            "input {s:?} parsed as {parsed:?}"
+        );
+    }
+
+    /// KNOWN FAILURE (process-aborting) — real bug: the parser recurses once
+    /// per nesting level with no depth limit, so deeply nested input from an
+    /// untrusted source overflows the stack and aborts the whole process
+    /// (observed at depth ~1000 on a 2 MiB test-thread stack; also reproduces
+    /// with `{:a {:a ...}}` and `#{#{...}}` nesting).
+    ///
+    /// Kept `#[ignore]`d because a stack overflow cannot be caught: running it
+    /// takes down the entire test binary. Run explicitly with:
+    ///   cargo test --test parse `known_bug_deep_nesting_stack_overflow` -- --ignored
+    #[test]
+    #[ignore = "stack overflow: aborts the process; see comment"]
+    fn known_bug_deep_nesting_stack_overflow() {
+        let depth = 10_000;
+        let s = "[".repeat(depth) + &"]".repeat(depth);
+        drop(Edn::from_str(&s));
+    }
+}
