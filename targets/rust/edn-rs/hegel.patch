+                "}",
+                "#{",
+                "#_",
+                "#",
+                "\"",
+                "\\",
+                "\\\\",
+                ":",
+                "::",
+                ";",
+                ";;\n",
+                "nil",
+                "true",
+                "false",
+                "t",
+                "f",
+                "n",
+                "1",
+                "-1",
+                "+1",
+                "0x",
+                "0xff",
+                "-0x",
+                "2r",
+                "2r101",
+                "36rZZ",
+                "37r1",
+                "1e5",
+                "1e5e5",
+                "0x5e5",
+                "1.5",
+                "3/4",
+                "-",
+                "+",
+                "e",
+                "E",
+                "r",
+                "R",
+                ".",
+                "/",
