+/// The fallible constructors' contract for a capacity no allocator can provide: `ReserveError`,
+/// never a panic; the infallible ones panic with that error.
+fn check_huge_capacity(c: &mut CompactString, m: &str, n: usize) {
+    assert!(
+        CompactString::try_with_capacity(n).is_err(),
+        "try_with_capacity({n:#x}) is an error, not a panic (compact_str/1)"
+    );
+    assert!(c.try_reserve(n).is_err(), "try_reserve({n:#x}) is an error, not a panic (compact_str/1)");
+    check(c, m);
+    assert!(panics(|| CompactString::with_capacity(n)), "with_capacity({n:#x}) panics");
+    assert!(panics(|| c.reserve(n)), "reserve({n:#x}) panics");
+    check(c, m);
+    if !m.is_empty() {
+        assert!(panics(|| c.repeat(n)), "repeat({n:#x}) panics");
+    }
+    check(c, m);
+}
