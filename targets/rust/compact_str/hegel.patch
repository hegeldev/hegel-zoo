+#[hegel::test]
+fn comparisons_and_hash_match_str(tc: hegel::TestCase) {
+    let a = tc.draw(arb_text());
+    let b = if tc.draw(generators::booleans()) { a.clone() } else { tc.draw(arb_text()) };
+    let ca = build(&tc.draw(arb_start_owned()), &a);
+    let cb = build(&tc.draw(arb_start_owned()), &b);
+    assert_eq!(ca == cb, a == b);
+    assert_eq!(ca.cmp(&cb), a.cmp(&b));
+    assert_eq!(ca.partial_cmp(&cb), a.partial_cmp(&b));
+    assert_eq!(ca < cb, a < b);
+    // every PartialEq impl, both directions
+    assert_eq!(ca == b.as_str(), a == b);
+    assert_eq!(ca == b, a == b);
+    assert_eq!(ca == &b, a == b);
+    assert_eq!(ca == Cow::Borrowed(b.as_str()), a == b);
+    assert_eq!(&ca == cb, a == b);
+    assert_eq!(&ca == b, a == b);
+    assert_eq!(&ca == Cow::Borrowed(b.as_str()), a == b);
+    assert_eq!(b == ca, a == b);
+    assert_eq!(b == &ca, a == b);
+    assert_eq!(&b == ca, a == b);
+    assert_eq!(*b.as_str() == ca, a == b);
+    assert_eq!(*b.as_str() == &ca, a == b);
+    assert_eq!(b.as_str() == ca, a == b);
+    assert_eq!(&b.as_str() == ca, a == b);
+    assert_eq!(Cow::Borrowed(b.as_str()) == ca, a == b);
+    assert_eq!(&Cow::Borrowed(b.as_str()) == ca, a == b);
+    // Hash agrees with str (the Borrow<str> contract HashMap lookups rely on)
+    fn hash_of<T: Hash + ?Sized>(t: &T) -> u64 {
+        let mut h = std::collections::hash_map::DefaultHasher::new();
+        t.hash(&mut h);
+        h.finish()
+    }
+    assert_eq!(hash_of(&ca), hash_of(a.as_str()));
+    let mut map: HashMap<CompactString, usize> = HashMap::new();
+    map.insert(ca.clone(), 1);
+    map.insert(cb.clone(), 2);
+    assert_eq!(map.get(a.as_str()).is_some(), true);
+    assert_eq!(map.get(b.as_str()), Some(&2));
+    assert_eq!(map.len(), if a == b { 1 } else { 2 });
+    // ordering agrees with String's in a set
+    let set: BTreeSet<CompactString> = [ca.clone(), cb.clone()].into_iter().collect();
+    let mset: BTreeSet<String> = [a.clone(), b.clone()].into_iter().collect();
+    assert!(set.iter().map(|s| s.as_str()).eq(mset.iter().map(|s| s.as_str())));
+    // AsRef / Borrow views
+    assert_eq!(AsRef::<str>::as_ref(&ca), a);
+    assert_eq!(AsRef::<[u8]>::as_ref(&ca), a.as_bytes());
+    assert_eq!(AsRef::<std::ffi::OsStr>::as_ref(&ca), std::ffi::OsStr::new(&a));
+    assert_eq!(AsRef::<std::path::Path>::as_ref(&ca), std::path::Path::new(&a));
+    assert_eq!(std::borrow::Borrow::<str>::borrow(&ca), a);
+}
