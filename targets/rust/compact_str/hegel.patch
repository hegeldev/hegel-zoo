+#[hegel::test]
+fn to_compact_string_matches_display(tc: hegel::TestCase) {
+    macro_rules! ints {
+        ($($t:ty => $nz:ty),*) => {$(
+            let v = tc.draw(generators::integers::<$t>());
+            let c = v.to_compact_string();
+            assert_eq!(c, v.to_string(), stringify!($t));
+            inlined_if_short(&c, stringify!($t));
+            assert_eq!(v.try_to_compact_string().unwrap(), v.to_string());
+            if let Some(nz) = <$nz>::new(v) {
+                assert_eq!(nz.to_compact_string(), nz.to_string(), stringify!($nz));
+            }
+            for v in [<$t>::MIN, <$t>::MAX, 0] {
+                assert_eq!(v.to_compact_string(), v.to_string());
+            }
+        )*};
+    }
+    ints!(
+        u8 => std::num::NonZeroU8, i8 => std::num::NonZeroI8,
+        u16 => std::num::NonZeroU16, i16 => std::num::NonZeroI16,
+        u32 => std::num::NonZeroU32, i32 => std::num::NonZeroI32,
+        u64 => std::num::NonZeroU64, i64 => std::num::NonZeroI64,
+        u128 => std::num::NonZeroU128, i128 => std::num::NonZeroI128,
+        usize => std::num::NonZeroUsize, isize => std::num::NonZeroIsize
+    );
+    let b = tc.draw(generators::booleans());
+    assert_eq!(b.to_compact_string(), b.to_string());
+    let ch = tc.draw(arb_char());
+    assert_eq!(ch.to_compact_string(), ch.to_string());
+    // floats: zmij's shortest representation must at least round-trip and keep the sign
+    let f = tc.draw(generators::floats::<f64>());
+    let s = f.to_compact_string();
+    assert!(!s.is_heap_allocated(), "an f64 is always inline: {s:?} ({} bytes)", s.len());
+    let back: f64 = s.parse().unwrap_or_else(|e| panic!("{f:?} printed as {s:?}: {e}"));
+    if f.is_nan() {
+        assert!(back.is_nan());
+    } else {
+        assert_eq!(back.to_bits(), f.to_bits(), "{f:?} printed as {s:?} reads back as {back:?}");
+    }
+    let g = tc.draw(generators::floats::<f32>());
+    let s = g.to_compact_string();
+    let back: f32 = s.parse().unwrap_or_else(|e| panic!("{g:?} printed as {s:?}: {e}"));
+    if g.is_nan() {
+        assert!(back.is_nan());
+    } else {
+        assert_eq!(back.to_bits(), g.to_bits(), "{g:?} printed as {s:?} reads back as {back:?}");
+    }
+    // the generic Display path, and a Display that fails
+    struct Shown(String);
+    impl Display for Shown {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            write!(f, "<{}>", self.0)
+        }
+    }
+    let text = tc.draw(arb_text());
+    let c = Shown(text.clone()).to_compact_string();
+    assert_eq!(c, format!("<{text}>"));
+    inlined_if_short(&c, "to_compact_string");
+    struct Bad;
+    impl Display for Bad {
+        fn fmt(&self, _: &mut fmt::Formatter<'_>) -> fmt::Result {
+            Err(fmt::Error)
+        }
+    }
+    assert_eq!(Bad.try_to_compact_string(), Err(ToCompactStringError::Fmt(fmt::Error)));
+    assert!(panics(|| Bad.to_compact_string()), "a failing Display panics to_compact_string");
+    struct Partial;
+    impl Display for Partial {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            f.write_str("some output before the error, more than 24 bytes")?;
+            Err(fmt::Error)
+        }
+    }
+    assert!(matches!(Partial.try_to_compact_string(), Err(ToCompactStringError::Fmt(_))));
+}
