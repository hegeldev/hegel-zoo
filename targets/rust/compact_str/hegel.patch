+    assert_eq!(CompactString::from_str_to_uppercase(&text), text.to_uppercase());
+    assert_eq!(c.to_ascii_lowercase(), text.to_ascii_lowercase());
+    assert_eq!(c.to_ascii_uppercase(), text.to_ascii_uppercase());
+    check(&c.to_lowercase(), &text.to_lowercase());
+    check(&c.to_uppercase(), &text.to_uppercase());
+    // Not asserted: that a short result is inline. The result is sized from the input, so a
+    // 25-byte "…ﬀ" uppercased to 24 bytes stays on the heap; nothing documents otherwise.
+    inlined_if_short(&c.to_ascii_lowercase(), "to_ascii_lowercase");
+    inlined_if_short(&c.to_ascii_uppercase(), "to_ascii_uppercase");
+    assert_eq!(c, text, "the original is untouched");
+}
