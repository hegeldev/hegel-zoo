+#[hegel::test]
+fn conversions_round_trip(tc: hegel::TestCase) {
+    let text = tc.draw(arb_text());
+    let c = build(&tc.draw(arb_start_owned()), &text);
+    assert_eq!(String::from(c.clone()), text);
+    assert_eq!(c.clone().into_string(), text);
+    assert_eq!(Cow::<str>::from(c.clone()), text);
+    assert_eq!(Cow::<str>::from(&c), text);
+    assert!(matches!(Cow::<str>::from(&c), Cow::Borrowed(_)), "a borrowed Cow from a reference");
+    assert_eq!(&*std::sync::Arc::<str>::from(c.clone()), text);
+    assert_eq!(&*std::rc::Rc::<str>::from(c.clone()), text);
+    assert_eq!(&*Box::<str>::from(c.clone()), text);
+    assert_eq!(Vec::<u8>::from(c.clone()), text.as_bytes());
+    assert_eq!(std::ffi::OsString::from(c.clone()), std::ffi::OsString::from(&text));
+    assert_eq!(std::path::PathBuf::from(c.clone()), std::path::PathBuf::from(&text));
+    let e: Box<dyn std::error::Error + Send + Sync> = c.clone().into();
+    assert_eq!(e.to_string(), text);
+    assert_eq!(format!("{e:?}"), format!("{text:?}"));
+    let e: Box<dyn std::error::Error> = c.clone().into();
+    assert_eq!(e.to_string(), text);
+    // FromIterator / Extend in every form
+    let pieces = tc.draw(generators::vecs(arb_text_max(10)).max_size(6));
+    let joined: String = pieces.concat();
+    let from_strs: CompactString = pieces.iter().map(String::as_str).collect();
+    let from_strings: CompactString = pieces.iter().cloned().collect();
+    let from_boxes: CompactString = pieces.iter().map(|s| Box::<str>::from(s.as_str())).collect();
+    let from_cows: CompactString = pieces.iter().map(|s| Cow::Borrowed(s.as_str())).collect();
+    let from_compacts: CompactString = pieces.iter().map(CompactString::new).collect();
+    let from_chars: CompactString = joined.chars().collect();
+    let from_char_refs: CompactString = joined.chars().collect::<Vec<_>>().iter().collect();
+    for (what, got) in [
+        ("&str", &from_strs),
+        ("String", &from_strings),
+        ("Box<str>", &from_boxes),
+        ("Cow", &from_cows),
+        ("CompactString", &from_compacts),
+        ("char", &from_chars),
+        ("&char", &from_char_refs),
+    ] {
+        check(got, &joined);
+        inlined_if_short(got, what);
+    }
+    let s: String = pieces.iter().map(CompactString::new).collect();
+    assert_eq!(s, joined);
+    let cow: Cow<str> = pieces.iter().map(CompactString::new).collect();
+    assert_eq!(cow, joined);
+    let mut s = text.clone();
+    s.extend(pieces.iter().map(CompactString::new));
+    assert_eq!(s, format!("{text}{joined}"));
+    let mut cow: Cow<str> = Cow::Borrowed(text.as_str());
+    cow.extend(pieces.iter().map(CompactString::new));
+    assert_eq!(cow, format!("{text}{joined}"));
+    // concat / join
+    let sep = tc.draw(arb_text_max(3));
+    assert_eq!(pieces.iter().concat_compact(), joined);
+    assert_eq!(pieces.iter().join_compact(&sep), pieces.join(&sep));
+    assert_eq!(pieces.iter().map(String::as_str).join_compact(sep.as_str()), pieces.join(&sep));
+    assert_eq!(pieces.iter().map(CompactString::new).concat_compact(), joined);
+    assert_eq!(pieces.clone().into_iter().join_compact(CompactString::new(&sep)), pieces.join(&sep));
+    inlined_if_short(&pieces.iter().join_compact(&sep), "join_compact");
+    // to_compact_string of strings
+    assert_eq!(text.to_compact_string(), text);
+    assert_eq!(text.as_str().to_compact_string(), text);
+    assert_eq!(c.to_compact_string(), text);
+    assert_eq!(text.try_to_compact_string().unwrap(), text);
+}
