+#[hegel::test]
+fn decoding_matches_std(tc: hegel::TestCase) {
+    // UTF-8: valid text with random bytes spliced in
+    let text = tc.draw(arb_text());
+    let mut bytes = text.into_bytes();
+    let junk = tc.draw(generators::binary().max_size(4));
+    let at = tc.draw(generators::integers::<usize>().max_value(bytes.len()));
+    bytes.splice(at..at, junk);
+    match (CompactString::from_utf8(&bytes), std::str::from_utf8(&bytes)) {
+        (Ok(c), Ok(s)) => {
+            check(&c, s);
+            inlined_if_short(&c, "from_utf8");
+        }
+        (Err(e), Err(f)) => {
+            assert_eq!(e.valid_up_to(), f.valid_up_to());
+            assert_eq!(e.error_len(), f.error_len());
+            assert_eq!(e.to_string(), f.to_string());
+        }
+        (c, s) => panic!("from_utf8 disagrees with str: {c:?} vs {s:?}"),
+    }
+    let lossy = CompactString::from_utf8_lossy(&bytes);
+    check(&lossy, &String::from_utf8_lossy(&bytes));
+    inlined_if_short(&lossy, "from_utf8_lossy");
+    assert_eq!(CompactString::from_utf8(bytes.clone()).is_ok(), std::str::from_utf8(&bytes).is_ok(), "by value");
+
+    // UTF-16: valid code units with random ones spliced in (lone surrogates included)
+    let text = tc.draw(arb_text());
+    let mut units: Vec<u16> = text.encode_utf16().collect();
+    let junk = tc.draw(generators::vecs(generators::integers::<u16>().min_value(0xD000).max_value(0xE000)).max_size(3));
+    let at = tc.draw(generators::integers::<usize>().max_value(units.len()));
+    units.splice(at..at, junk);
+    let expected = decode_utf16(&units);
+    match (CompactString::from_utf16(&units), &expected) {
+        (Ok(c), Some(s)) => {
+            check(&c, s);
+            inlined_if_short(&c, "from_utf16");
+        }
+        (Err(e), None) => assert_eq!(e.to_string(), "invalid utf-16: lone surrogate found"),
+        (c, s) => panic!("from_utf16 disagrees with char::decode_utf16: {c:?} vs {s:?}"),
+    }
+    let lossy = CompactString::from_utf16_lossy(&units);
+    check(&lossy, &String::from_utf16_lossy(&units));
+    assert_eq!(CompactString::from_utf16(units.clone()).is_ok(), expected.is_some(), "by value");
+
+    // the byte-oriented decoders, both endiannesses, aligned and misaligned, even and odd
+    let le: Vec<u8> = units.iter().flat_map(|u| u.to_le_bytes()).collect();
+    let be: Vec<u8> = units.iter().flat_map(|u| u.to_be_bytes()).collect();
+    let odd = tc.draw(generators::booleans());
+    let misaligned = tc.draw(generators::booleans());
+    for (name, bytes) in [("le", le), ("be", be)] {
+        let little = name == "le";
+        let decode = |v: &[u8]| if little { CompactString::from_utf16le(v) } else { CompactString::from_utf16be(v) };
+        let decode_lossy = |v: &[u8]| if little { CompactString::from_utf16le_lossy(v) } else { CompactString::from_utf16be_lossy(v) };
+        let mut buf = Vec::with_capacity(bytes.len() + 2);
+        if misaligned {
+            buf.push(0);
+        }
+        buf.extend_from_slice(&bytes);
+        if odd {
+            buf.push(0x41);
+        }
+        let view = if misaligned { &buf[1..] } else { &buf[..] };
+        assert_eq!(view.len() % 2 == 1, odd);
+        let lossy_expected = if odd {
+            format!("{}\u{FFFD}", String::from_utf16_lossy(&units))
+        } else {
+            String::from_utf16_lossy(&units)
+        };
+        check(&decode_lossy(view), &lossy_expected);
+        match decode(view) {
+            Ok(c) => {
+                assert!(!odd, "{name}: an odd number of bytes is an error");
+                check(&c, expected.as_deref().unwrap_or_else(|| panic!("{name}: decoded {c:?} but decode_utf16 fails")));
+            }
+            Err(e) => {
+                assert!(odd || expected.is_none(), "{name}: {e} for valid input {units:?}");
+            }
+        }
+    }
+}
