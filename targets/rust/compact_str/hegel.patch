+#[hegel::test]
+fn out_of_bounds_and_split_chars_are_refused(tc: hegel::TestCase) {
+    let start = tc.draw(arb_start());
+    let text = if let Start::ConstNew(i) = start { STATICS[i].to_owned() } else { tc.draw(arb_text()) };
+    let mut c = build(&start, &text);
+    let m = text.clone();
+    // a byte offset inside a multi-byte char, if there is one
+    let inside: Vec<usize> = (1..m.len()).filter(|&b| !m.is_char_boundary(b)).collect();
+    let which = tc.draw(generators::integers::<u8>().max_value(7));
+    let n = m.len();
+    if let Some(&mid) = inside.first() {
+        let at = tc.draw(generators::sampled_from(inside.clone()));
+        match which {
+            0 => assert!(panics(|| c.remove(at)), "remove inside a char"),
+            1 => assert!(panics(|| c.insert(at, 'x')), "insert inside a char"),
+            2 => assert!(panics(|| c.insert_str(at, "xy")), "insert_str inside a char"),
+            3 => assert!(panics(|| c.truncate(at)), "truncate inside a char"),
+            4 => assert!(panics(|| c.split_off(at)), "split_off inside a char"),
+            5 => assert!(panics(|| c.replace_range(at.., "x")), "replace_range inside a char"),
+            6 => assert!(panics(|| drop(c.drain(..at))), "drain inside a char"),
+            _ => assert!(panics(|| c.replace_range(0..mid, "x")), "replace_range inside a char"),
+        }
+        check(&c, &m);
+    }
+    match which {
+        0 => assert!(panics(|| c.remove(n)), "remove at the end"),
+        1 => assert!(panics(|| c.insert(n + 1, 'x')), "insert past the end"),
+        2 => assert!(panics(|| c.insert_str(n + 1, "xy")), "insert_str past the end"),
+        3 => assert!(panics(|| c.split_off(n + 1)), "split_off past the end"),
+        4 => assert!(panics(|| c.replace_range(n + 1.., "x")), "replace_range past the end"),
+        5 => assert!(panics(|| drop(c.drain(..n + 1))), "drain past the end"),
+        6 => assert!(panics(|| c.replace_range(2..1, "x")), "reversed range"),
+        _ => {
+            let d = c.drain(n..n);
+            assert_eq!(d.as_str(), "");
+            drop(d);
+            c.replace_range(n..n, "");
+            c.truncate(n + 1);
+            c.insert_str(n, "");
+        }
+    }
+    check(&c, &m);
+    if !m.is_empty() {
+        assert!(c.try_reserve(usize::MAX).is_err(), "len + usize::MAX overflows: an error");
+        assert!(panics(|| c.repeat(usize::MAX)), "repeat overflow panics");
+    } else {
+        assert_eq!(c.repeat(usize::MAX), "");
+    }
+    check(&c, &m);
+}
