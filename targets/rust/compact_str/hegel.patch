+//! Hegel property tests for `compact_str`: a `CompactString` behaves like a `String` holding the
+//! same text, and its documented storage contract holds — inline up to `size_of::<String>()`
+//! bytes (the minimum capacity), heap above with a minimum heap capacity of 4 words, a
+//! `&'static str` variant from `const_new` whose capacity is its length, eager inlining when a
+//! string is created, cloned or shrunk, and buffer re-use with `String`.
+//!
+//! The oracle is `std`: a `String` mirror of every edit, `str`'s own case conversions, decoders
+//! and formatting.
+
+use std::borrow::Cow;
+use std::collections::{BTreeSet, HashMap};
+use std::fmt::{self, Display, Write as _};
+use std::hash::{Hash, Hasher};
+use std::panic::{catch_unwind, AssertUnwindSafe};
+use std::sync::Once;
+
+use compact_str::{CompactString, CompactStringExt, ToCompactString, ToCompactStringError};
+use hegel::generators;
+use hegel::Generator as _;
+
+/// Longest string kept inline; also the minimum capacity of every non-static `CompactString`.
+const MAX_INLINE: usize = std::mem::size_of::<String>();
+/// Smallest heap allocation the crate makes.
+const MIN_HEAP: usize = MAX_INLINE + std::mem::size_of::<usize>();
+
+fn quiet_panics() {
+    static ONCE: Once = Once::new();
+    ONCE.call_once(|| std::panic::set_hook(Box::new(|_| {})));
+}
+
+fn panics<R>(f: impl FnOnce() -> R) -> bool {
+    quiet_panics();
+    catch_unwind(AssertUnwindSafe(f)).is_err()
+}
+
+// ---------------------------------------------------------------------------------------------
+// Generators
+
+/// Text over an alphabet of ASCII (both cases), the case-interesting letters (ß, İ, ﬁ, the
+/// sigmas), 2-, 3- and 4-byte chars and NUL, up to 40 chars (160 bytes) so the inline/heap
+/// boundary at 24 bytes and the minimum heap capacity at 32 are crossed constantly.
+fn arb_text() -> impl hegel::PrintableGenerator<String> {
+    generators::text()
+        .alphabet("abcxyzAZ ,.Σσς ßİﬁé€😀\u{0}\n")
+        .max_size(40)
+}
+
+fn arb_text_max(max: usize) -> impl hegel::PrintableGenerator<String> {
+    generators::text()
+        .alphabet("abcxyzAZ ,.Σσς ßİﬁé€😀\u{0}\n")
+        .max_size(max)
+}
+
+fn arb_char() -> impl hegel::PrintableGenerator<char> {
+    generators::sampled_from("abZ Σσß€😀\u{0}".chars().collect::<Vec<_>>())
+}
+
+/// A byte offset on a char boundary of `s`, `permille` thousandths of the way in.
+fn pos(s: &str, permille: u32) -> usize {
+    let mut b = s.len() * permille as usize / 1000;
+    while !s.is_char_boundary(b) {
+        b -= 1;
+    }
+    b
+}
+
+/// `&'static str`s for `const_new`: below, at and above the inline limit.
+const STATICS: &[&str] = &[
+    "",
+    "short",
+    "exactly twenty-four byt.",
+    "twenty-five bytes long!!!",
+    "a static string well beyond the inline capacity of twenty-four bytes",
+    "ὈΔΥΣΣΕΎΣ ὁ Λαερτιάδης καὶ Σίσυφος",
+    "😀😀😀😀😀😀😀😀😀😀",
+];
+
+/// How the string under test is created.
+#[derive(Debug, Clone)]
+enum Start {
+    New,
+    TryNew,
+    FromString { extra: usize },
+    FromStringBuffer { extra: usize },
+    ConstNew(usize),
+    WithCapacity(usize),
+    Default,
+    CollectChars,
+    FromUtf8,
+    Parse,
+    FromBoxStr,
+    FromCowOwned,
+    FromCowBorrowed,
+    FromStringRef,
+}
+
+impl hegel::PrettyPrintable for Start {
+    fn pretty_print(&self, printer: &mut hegel::pretty::PrettyPrinter) {
+        hegel::pretty::print_debug_repr(&format!("{self:?}"), printer);
+    }
+}
+
+#[hegel::composite]
+fn arb_start(tc: &hegel::TestCase) -> Start {
+    let kind = tc.draw(generators::integers::<u8>().max_value(13));
+    let extra = tc.draw(generators::integers::<usize>().max_value(40));
+    match kind {
+        0 => Start::New,
+        1 => Start::TryNew,
+        2 => Start::FromString { extra },
+        3 => Start::FromStringBuffer { extra },
+        4 => Start::ConstNew(tc.draw(generators::integers::<usize>().max_value(STATICS.len() - 1))),
+        5 => Start::WithCapacity(tc.draw(generators::integers::<usize>().max_value(80))),
+        6 => Start::Default,
+        7 => Start::CollectChars,
+        8 => Start::FromUtf8,
+        9 => Start::Parse,
+        10 => Start::FromBoxStr,
+        11 => Start::FromCowOwned,
+        12 => Start::FromCowBorrowed,
+        _ => Start::FromStringRef,
+    }
+}
+
+/// One edit, mirrored on the `String` model. Positions are thousandths of the current length.
+#[derive(Debug, Clone)]
+enum Op {
+    Push(char),
+    PushStr(String),
+    Pop,
+    Remove(u32),
+    Insert(u32, char),
+    InsertStr(u32, String),
+    Truncate(u32),
+    Clear,
+    SplitOff(u32),
+    /// range, how much of the iterator is consumed and how, range form
+    Drain(u32, u32, u8, u8),
+    /// range, replacement, range form
+    ReplaceRange(u32, u32, String, u8),
+    Retain(u8, u8),
+    Reserve(usize),
+    ShrinkTo(usize),
+    ShrinkToFit,
+    Clone,
+    CloneFrom(String),
+    Repeat(usize),
+    IntoStringAndBack,
+    FromStringBuffer(usize),
+    MakeAsciiUppercase,
+    WriteFmt(String, char),
+    Add(String),
+    Extend(u8, Vec<String>),
+}
+
+impl hegel::PrettyPrintable for Op {
+    fn pretty_print(&self, printer: &mut hegel::pretty::PrettyPrinter) {
+        hegel::pretty::print_debug_repr(&format!("{self:?}"), printer);
+    }
+}
+
+#[hegel::composite]
+fn arb_op(tc: &hegel::TestCase) -> Op {
+    let kind = tc.draw(generators::integers::<u8>().max_value(23));
+    let p = tc.draw(generators::integers::<u32>().max_value(1000));
