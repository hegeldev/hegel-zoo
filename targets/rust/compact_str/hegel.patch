+    match kind {
+        0 => Op::Push(tc.draw(arb_char())),
+        1 => Op::PushStr(tc.draw(arb_text_max(30))),
+        2 => Op::Pop,
+        3 => Op::Remove(p),
+        4 => Op::Insert(p, tc.draw(arb_char())),
+        5 => Op::InsertStr(p, tc.draw(arb_text_max(30))),
+        6 => Op::Truncate(p),
+        7 => Op::Clear,
+        8 => Op::SplitOff(p),
+        9 => Op::Drain(
+            p.min(q),
+            p.max(q),
+            tc.draw(generators::integers::<u8>().max_value(6)),
+            tc.draw(generators::integers::<u8>().max_value(4)),
+        ),
+        10 => Op::ReplaceRange(
+            p.min(q),
+            p.max(q),
+            tc.draw(arb_text_max(30)),
+            tc.draw(generators::integers::<u8>().max_value(4)),
+        ),
+        11 => Op::Retain(
+            tc.draw(generators::integers::<u8>().max_value(4)),
+            tc.draw(generators::integers::<u8>()),
+        ),
+        12 => Op::Reserve(tc.draw(generators::integers::<usize>().max_value(100))),
+        13 => Op::ShrinkTo(tc.draw(generators::integers::<usize>().max_value(150))),
+        14 => Op::ShrinkToFit,
+        15 => Op::Clone,
+        16 => Op::CloneFrom(tc.draw(arb_text_max(40))),
+        17 => Op::Repeat(tc.draw(generators::integers::<usize>().max_value(3))),
+        18 => Op::IntoStringAndBack,
+        19 => Op::FromStringBuffer(tc.draw(generators::integers::<usize>().max_value(40))),
+        20 => Op::MakeAsciiUppercase,
+        21 => Op::WriteFmt(tc.draw(arb_text_max(10)), tc.draw(arb_char())),
+        22 => Op::Add(tc.draw(arb_text_max(30))),
+        _ => Op::Extend(
+            tc.draw(generators::integers::<u8>().max_value(6)),
+            tc.draw(generators::vecs(arb_text_max(10)).max_size(4)),
+        ),
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// The model and the storage contract
+
+/// Everything a `CompactString` must agree with `str` on, plus the storage invariants.
+fn check(c: &CompactString, m: &str) {
+    assert_eq!(c.as_str(), m);
+    assert_eq!(c.len(), m.len());
+    assert_eq!(c.is_empty(), m.is_empty());
+    assert_eq!(c.as_bytes(), m.as_bytes());
+    assert!(c == m, "PartialEq<str>");
+    assert_eq!(&**c, m, "Deref");
+    assert_eq!(c.chars().rev().collect::<String>(), m.chars().rev().collect::<String>());
+    assert_eq!(format!("{c}"), m);
+    assert_eq!(format!("{c:?}"), format!("{m:?}"));
+    assert!(c.capacity() >= c.len(), "capacity {} < len {}", c.capacity(), c.len());
+    if let Some(s) = c.as_static_str() {
+        assert_eq!(s, m, "as_static_str is the text");
+        assert!(!c.is_heap_allocated(), "a static string is not heap allocated");
+        assert_eq!(c.capacity(), c.len(), "a static string's capacity is its length");
+    } else if !c.is_heap_allocated() {
+        assert_eq!(c.capacity(), MAX_INLINE, "an inline string's capacity is the inline size");
+        assert!(c.len() <= MAX_INLINE);
+    }
+}
+
+/// The eager-inlining contract at creation, clone and shrink: short strings are never on the heap.
+fn inlined_if_short(c: &CompactString, what: &str) {
+    if c.len() <= MAX_INLINE {
+        assert!(!c.is_heap_allocated(), "{what}: {} bytes should be inline", c.len());
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+struct Shape {
+    heap: bool,
+    is_static: bool,
+    cap: usize,
+}
+
+fn shape(c: &CompactString) -> Shape {
+    Shape { heap: c.is_heap_allocated(), is_static: c.as_static_str().is_some(), cap: c.capacity() }
+}
+
+/// After an operation that needed `needed` bytes of capacity (`reserve`'s rule): no change if
+/// it already fitted (a static string never "fits", it has to be converted), inline if the
+/// need fits inline, heap otherwise.
+fn check_growth(before: Shape, needed: usize, c: &CompactString) {
+    if !before.is_static && needed <= before.cap {
+        assert_eq!(c.capacity(), before.cap, "growth within capacity keeps it ({before:?})");
+        assert_eq!(c.is_heap_allocated(), before.heap, "growth within capacity keeps the storage");
+    } else if needed <= MAX_INLINE {
+        assert!(!c.is_heap_allocated(), "{needed} bytes fit inline ({before:?})");
+        assert_eq!(c.capacity(), MAX_INLINE);
+    } else {
+        assert!(c.is_heap_allocated(), "{needed} bytes need the heap ({before:?})");
+        assert!(c.capacity() >= needed);
+    }
+}
+
+/// After an operation that only shortens the string: capacity and storage are untouched
+/// (a static string is left alone here since some of these convert it).
+fn check_unchanged(before: Shape, c: &CompactString) {
+    if !before.is_static {
+        assert_eq!(c.capacity(), before.cap, "shortening keeps the capacity ({before:?})");
+        assert_eq!(c.is_heap_allocated(), before.heap, "shortening keeps the storage ({before:?})");
+    }
+}
+
+fn build(start: &Start, text: &str) -> CompactString {
+    match *start {
+        Start::New => {
+            let c = CompactString::new(text);
+            inlined_if_short(&c, "new");
+            if c.is_heap_allocated() {
+                assert_eq!(c.capacity(), text.len().max(MIN_HEAP), "new: exact heap capacity");
+            }
+            c
+        }
+        Start::TryNew => {
+            let c = CompactString::try_new(text).expect("try_new");
+            inlined_if_short(&c, "try_new");
+            c
+        }
+        Start::FromString { extra } => {
+            let mut s = String::with_capacity(text.len() + extra);
+            s.push_str(text);
+            let (ptr, cap) = (s.as_ptr(), s.capacity());
+            let c = CompactString::from(s);
+            inlined_if_short(&c, "From<String>");
+            if text.len() > MAX_INLINE {
+                assert!(c.is_heap_allocated());
+                assert_eq!(c.as_ptr(), ptr, "From<String> re-uses the buffer");
+                assert_eq!(c.capacity(), cap, "From<String> keeps the String's capacity");
+            }
+            c
+        }
+        Start::FromStringBuffer { extra } => {
+            let mut s = String::with_capacity(text.len() + extra);
+            s.push_str(text);
+            let (ptr, cap) = (s.as_ptr(), s.capacity());
+            let c = CompactString::from_string_buffer(s);
+            if cap == 0 {
+                assert!(!c.is_heap_allocated());
+            } else {
+                assert!(c.is_heap_allocated(), "from_string_buffer never inlines");
+                assert_eq!(c.as_ptr(), ptr, "from_string_buffer re-uses the buffer");
+                assert_eq!(c.capacity(), cap);
+            }
+            c
+        }
+        Start::ConstNew(i) => {
+            let s = STATICS[i];
+            let c = CompactString::const_new(s);
+            assert!(!c.is_heap_allocated());
+            if s.len() <= MAX_INLINE {
+                assert_eq!(c.as_static_str(), None, "short const_new is inlined");
+            } else {
+                assert_eq!(c.as_static_str(), Some(s));
+            }
+            c
+        }
+        Start::WithCapacity(n) => {
+            let mut c = CompactString::with_capacity(n);
+            assert!(c.is_empty());
+            if n <= MAX_INLINE {
+                assert!(!c.is_heap_allocated());
+                assert_eq!(c.capacity(), MAX_INLINE);
+            } else {
+                assert!(c.is_heap_allocated());
+                assert_eq!(c.capacity(), n.max(MIN_HEAP), "with_capacity is exact above the minimum");
+            }
+            assert_eq!(CompactString::try_with_capacity(n).unwrap().capacity(), c.capacity());
+            let before = shape(&c);
+            c.push_str(text);
+            if !text.is_empty() {
+                check_growth(before, text.len(), &c);
+            }
+            c
+        }
+        Start::Default => {
+            let mut c = CompactString::default();
+            assert_eq!(c, "");
+            assert_eq!(c.capacity(), MAX_INLINE);
+            c.push_str(text);
+            c
+        }
+        Start::CollectChars => {
+            let c: CompactString = text.chars().collect();
+            inlined_if_short(&c, "FromIterator<char>");
+            c
+        }
+        Start::FromUtf8 => {
+            let c = CompactString::from_utf8(text.as_bytes()).expect("valid utf-8");
+            inlined_if_short(&c, "from_utf8");
+            c
+        }
+        Start::Parse => {
+            let c: CompactString = text.parse().expect("FromStr is infallible");
+            inlined_if_short(&c, "FromStr");
+            c
+        }
+        Start::FromBoxStr => {
+            let b: Box<str> = text.into();
+            let ptr = b.as_ptr();
+            let c = CompactString::from(b);
+            inlined_if_short(&c, "From<Box<str>>");
+            if text.len() > MAX_INLINE {
+                assert!(c.is_heap_allocated());
+                assert_eq!(c.as_ptr(), ptr, "From<Box<str>> re-uses the buffer");
+                assert_eq!(c.capacity(), text.len());
+            }
+            c
+        }
+        Start::FromCowOwned => {
+            let c = CompactString::from(Cow::<str>::Owned(text.to_owned()));
+            inlined_if_short(&c, "From<Cow::Owned>");
+            c
+        }
+        Start::FromCowBorrowed => {
+            let c = CompactString::from(Cow::Borrowed(text));
+            inlined_if_short(&c, "From<Cow::Borrowed>");
+            c
+        }
+        Start::FromStringRef => {
+            let s = text.to_owned();
+            let c = CompactString::from(&s);
+            inlined_if_short(&c, "From<&String>");
+            c
+        }
+    }
+}
+
+/// Which byte range an (a, b) pair means in each `RangeBounds` form; the model gets the same.
+fn apply_replace(c: &mut CompactString, m: &mut String, a: usize, b: usize, s: &str, form: u8) {
+    match form {
+        0 => {
+            c.replace_range(a..b, s);
+            m.replace_range(a..b, s);
+        }
+        1 if b > a => {
+            c.replace_range(a..=b - 1, s);
+            m.replace_range(a..=b - 1, s);
+        }
+        2 => {
+            c.replace_range(..b, s);
+            m.replace_range(..b, s);
+        }
+        3 => {
+            c.replace_range(a.., s);
+            m.replace_range(a.., s);
+        }
+        _ => {
+            c.replace_range(.., s);
+            m.replace_range(.., s);
+        }
+    }
+}
+
+fn apply(op: &Op, c: &mut CompactString, m: &mut String) {
+    let before = shape(c);
+    match op {
+        Op::Push(ch) => {
+            c.push(*ch);
+            m.push(*ch);
+            check_growth(before, m.len(), c);
+        }
+        Op::PushStr(s) => {
+            c.push_str(s);
+            m.push_str(s);
+            if s.is_empty() {
+                assert_eq!(shape(c).cap, before.cap, "pushing nothing changes nothing");
+            } else {
+                check_growth(before, m.len(), c);
+            }
+        }
+        Op::Pop => {
+            assert_eq!(c.pop(), m.pop());
+            check_unchanged(before, c);
+        }
+        Op::Remove(p) => {
+            if m.is_empty() {
+                assert!(panics(|| c.remove(0)), "remove on an empty string panics");
+            } else {
+                let idx = pos(m, *p);
+                let idx = if idx == m.len() { 0 } else { idx };
+                assert_eq!(c.remove(idx), m.remove(idx));
+                check_unchanged(before, c);
+            }
+        }
+        Op::Insert(p, ch) => {
+            let idx = pos(m, *p);
+            c.insert(idx, *ch);
+            m.insert(idx, *ch);
+            check_growth(before, m.len(), c);
+        }
+        Op::InsertStr(p, s) => {
+            let idx = pos(m, *p);
+            c.insert_str(idx, s);
+            m.insert_str(idx, s);
+            check_growth(before, m.len(), c);
+        }
+        Op::Truncate(p) => {
+            let idx = pos(m, *p);
+            c.truncate(idx);
+            m.truncate(idx);
+            check_unchanged(before, c);
+            c.truncate(idx + 100);
+            check_unchanged(before, c);
+        }
+        Op::Clear => {
+            c.clear();
+            m.clear();
+            check_unchanged(before, c);
+        }
+        Op::SplitOff(p) => {
+            let at = pos(m, *p);
+            let tail = c.split_off(at);
+            let mtail = m.split_off(at);
+            check(&tail, &mtail);
+            if before.is_static {
+                assert_eq!(c.capacity(), at, "split_off of a static string: capacity is the cut");
+            } else {
+                check_unchanged(before, c);
+            }
+        }
+        Op::Drain(p, q, how, form) => {
+            let (a, b) = (pos(m, *p), pos(m, *q));
+            let (a, b) = (a.min(b), a.max(b));
+            let range = match form {
+                0 => a..b,
+                1 if b > a => a..b,
+                2 => 0..b,
+                3 => a..m.len(),
+                _ => 0..m.len(),
+            };
+            let expected = m[range.clone()].to_owned();
+            {
+                let mut d = match form {
+                    0 => c.drain(a..b),
+                    1 if b > a => c.drain(a..=b - 1),
+                    2 => c.drain(..b),
+                    3 => c.drain(a..),
+                    _ => c.drain(..),
+                };
+                let mut md = m.drain(range);
+                assert_eq!(d.as_str(), md.as_str(), "drain holds the removed text");
+                assert_eq!(&*d, md.as_str(), "Deref");
+                assert_eq!(format!("{d}"), md.as_str());
+                assert_eq!(format!("{d:?}"), format!("Drain({:?})", md.as_str()));
+                assert_eq!(d.size_hint(), md.size_hint());
+                match how {
+                    0 => {}
+                    1 => {
+                        for _ in 0..3 {
+                            assert_eq!(d.next(), md.next());
+                            assert_eq!(d.as_str(), md.as_str());
+                        }
+                    }
+                    2 => {
+                        for _ in 0..3 {
+                            assert_eq!(d.next_back(), md.next_back());
+                            assert_eq!(d.as_str(), md.as_str());
+                        }
+                    }
+                    3 => {
+                        assert_eq!(d.next(), md.next());
+                        assert_eq!(d.next_back(), md.next_back());
+                        assert_eq!(d.next(), md.next());
+                        assert_eq!(d.as_str(), md.as_str());
+                    }
+                    4 => assert_eq!(d.count(), md.count()),
+                    5 => assert_eq!(d.last(), md.last()),
+                    _ => {
+                        let all: String = d.by_ref().collect();
+                        assert_eq!(all, expected);
+                        assert_eq!(d.next(), None, "fused");
+                        assert_eq!(d.as_str(), "");
+                    }
+                }
+            }
+            check_unchanged(before, c);
+        }
+        Op::ReplaceRange(p, q, s, form) => {
+            let (a, b) = (pos(m, *p), pos(m, *q));
+            let (a, b) = (a.min(b), a.max(b));
+            apply_replace(c, m, a, b, s, *form);
+            check_growth_or_unchanged(before, c, m);
+        }
+        Op::Retain(nth, threshold) => {
+            let n = *nth as u32 + 2;
+            let t = *threshold as u32 * 512;
+            let pred = |ch: char| (ch as u32 % n != 0) && (ch as u32) <= t.max(0x7f);
+            c.retain(pred);
+            m.retain(pred);
+            check_unchanged(before, c);
+        }
+        Op::Reserve(n) => {
+            c.reserve(*n);
+            check_growth(before, m.len() + n, c);
+            c.try_reserve(*n).expect("already reserved");
+            assert_eq!(c.capacity(), shape(c).cap);
+        }
+        Op::ShrinkTo(min) => {
+            c.shrink_to(*min);
+            m.shrink_to(*min);
+            check_shrink(before, *min, c);
+        }
+        Op::ShrinkToFit => {
+            c.shrink_to_fit();
+            m.shrink_to_fit();
+            check_shrink(before, 0, c);
+            inlined_if_short(c, "shrink_to_fit");
+        }
+        Op::Clone => {
+            let d = c.clone();
+            check(&d, m);
+            inlined_if_short(&d, "clone");
+            if before.is_static {
+                assert_eq!(d.as_static_str(), c.as_static_str(), "a static clone stays static");
+            }
+            let mut e = CompactString::new("something else entirely, long enough for the heap");
+            e.clone_from(c);
+            check(&e, m);
+            *c = d;
+        }
+        Op::CloneFrom(other) => {
+            let mut d = CompactString::new(other);
+            d.clone_from(c);
+            check(&d, m);
+            c.clone_from(&d);
+            check(c, m);
+        }
+        Op::Repeat(n) => {
+            let r = c.repeat(*n);
+            let mr = m.repeat(*n);
+            check(&r, &mr);
+            inlined_if_short(&r, "repeat");
+            *c = r;
+            *m = mr;
+        }
+        Op::IntoStringAndBack => {
+            let (ptr, cap) = (c.as_ptr(), c.capacity());
+            let s = std::mem::take(c).into_string();
+            assert_eq!(s, *m);
+            if before.heap {
+                assert_eq!(s.as_ptr(), ptr, "into_string hands the heap buffer over");
+                assert_eq!(s.capacity(), cap);
+            }
+            let (ptr, cap) = (s.as_ptr(), s.capacity());
+            *c = CompactString::from(s);
+            check(c, m);
+            inlined_if_short(c, "From<String>");
+            if m.len() > MAX_INLINE {
+                assert_eq!(c.as_ptr(), ptr, "From<String> takes the buffer back");
+                assert_eq!(c.capacity(), cap);
+            }
+        }
+        Op::FromStringBuffer(extra) => {
+            let mut s = String::with_capacity(m.len() + extra);
+            s.push_str(m);
+            let (ptr, cap) = (s.as_ptr(), s.capacity());
+            *c = CompactString::from_string_buffer(s);
+            if cap == 0 {
+                assert!(!c.is_heap_allocated());
+            } else {
+                assert!(c.is_heap_allocated(), "from_string_buffer never inlines");
+                assert_eq!(c.as_ptr(), ptr);
+                assert_eq!(c.capacity(), cap);
+            }
+        }
+        Op::MakeAsciiUppercase => {
+            c.as_mut_str().make_ascii_uppercase();
+            m.make_ascii_uppercase();
+            assert_eq!(c.as_bytes(), m.as_bytes());
+        }
+        Op::WriteFmt(s, ch) => {
+            write!(c, "{s}{ch:?}").unwrap();
+            write!(m, "{s}{ch:?}").unwrap();
+            c.write_char(*ch).unwrap();
+            m.push(*ch);
+            c.write_str(s).unwrap();
+            m.push_str(s);
+        }
+        Op::Add(s) => {
+            let sum = c.clone() + s.as_str();
+            assert_eq!(sum, format!("{m}{s}"));
+            *c += s.as_str();
+            m.push_str(s);
+            check_growth(before, m.len(), c);
+        }
+        Op::Extend(kind, pieces) => {
+            let joined: String = pieces.concat();
+            match kind {
+                0 => c.extend(joined.chars()),
+                1 => c.extend(pieces.iter().map(|s| s.as_str())),
+                2 => c.extend(pieces.iter().cloned()),
+                3 => c.extend(pieces.iter().map(CompactString::new)),
+                4 => c.extend(pieces.iter().map(|s| Box::<str>::from(s.as_str()))),
+                5 => c.extend(pieces.iter().map(|s| Cow::Borrowed(s.as_str()))),
+                _ => c.extend(joined.chars().collect::<Vec<_>>().iter()),
+            }
+            m.push_str(&joined);
+        }
+    }
+    check(c, m);
+}
+
+/// `replace_range`: growing beyond the capacity goes through `reserve`; otherwise no capacity
+/// changes (a static string is converted in place, which is left alone here).
+fn check_growth_or_unchanged(before: Shape, c: &CompactString, m: &str) {
+    if m.len() > before.cap {
+        check_growth(before, m.len(), c);
+    } else if !before.is_static {
+        check_unchanged(before, c);
+    }
+}
+
+/// `shrink_to(min)`: only a heap string changes; to inline if the result fits, otherwise to
+/// exactly `max(len, min)` clamped at the minimum heap capacity, never growing.
+fn check_shrink(before: Shape, min: usize, c: &CompactString) {
+    if !before.heap {
+        assert_eq!(c.capacity(), before.cap, "shrink_to on inline/static: no-op");
+        assert_eq!(c.as_static_str().is_some(), before.is_static);
+        return;
+    }
+    let target = c.len().max(min);
+    if target <= MAX_INLINE {
+        assert!(!c.is_heap_allocated(), "shrink_to {min}: {} bytes fit inline", c.len());
+        assert_eq!(c.capacity(), MAX_INLINE);
+    } else if target >= before.cap {
+        assert_eq!(c.capacity(), before.cap, "shrink_to {min} cannot grow");
+    } else {
+        assert!(c.is_heap_allocated());
+        assert_eq!(c.capacity(), target.max(MIN_HEAP), "shrink_to {min} is exact");
+    }
+}
