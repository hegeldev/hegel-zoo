+    // ===============================================================
+    // Hegel property-based tests
+    //
+    // The slice routines (`mul_slice` / `mul_slice_xor`) have several
+    // implementations selected at compile time (pure-Rust unrolled
+    // loop by default, SIMD C when `simd-accel` is enabled). Whichever
+    // backend is compiled in must agree with the scalar table lookup
+    // `mul` for every coefficient and every slice length — lengths are
+    // drawn up to a few hundred so the 4-way-unrolled main loop, the
+    // scalar tail, the empty slice, and (with simd-accel) the SIMD
+    // block + remainder split are all exercised.
+    // ===============================================================
+
+    use hegel::generators;
+
+    /// KNOWN FAILURE under `--features simd-accel` on x86_64/aarch64:
+    /// the SIMD wrappers for `mul_slice` / `mul_slice_xor` take
+    /// `&input[0]` without the `return_if_empty!` guard that the
+    /// pure-Rust implementations have, so they panic (index out of
+    /// bounds) on empty slices. The two backends therefore disagree
+    /// on the empty-slice case. Found by the hegel differential tests
+    /// below; this test pins the bug deterministically. It passes on
+    /// the default (pure-Rust) build.
+    #[test]
+    fn mul_slice_empty_input_does_not_panic() {
+        let mut out: [u8; 0] = [];
+        mul_slice(5, &[], &mut out);
+        let mut out: [u8; 0] = [];
+        mul_slice_xor(5, &[], &mut out);
+    }
+
+    /// `mul_slice(c, input, out)` must equal element-wise scalar `mul`.
+    #[hegel::test]
+    fn hegel_mul_slice_matches_scalar_mul(tc: hegel::TestCase) {
+        let c = tc.draw(generators::integers::<u8>());
+        // min_value(1): the empty-slice case panics under simd-accel;
+        // it is pinned by `mul_slice_empty_input_does_not_panic` above.
+        let len = tc.draw(generators::integers::<usize>().min_value(1).max_value(300));
+        let input: Vec<u8> = tc.draw(generators::binary().min_size(len).max_size(len));
+
+        let mut out = vec![0u8; len];
+        mul_slice(c, &input, &mut out);
+
+        let expect: Vec<u8> = input.iter().map(|&x| mul(c, x)).collect();
+        assert_eq!(expect, out);
+    }
+
+    /// `mul_slice_xor(c, input, out)` must equal out[i] ^ mul(c, input[i]).
+    #[hegel::test]
+    fn hegel_mul_slice_xor_matches_scalar_mul(tc: hegel::TestCase) {
+        let c = tc.draw(generators::integers::<u8>());
+        // min_value(1): empty-slice case pinned by
+        // `mul_slice_empty_input_does_not_panic` (see comment there).
+        let len = tc.draw(generators::integers::<usize>().min_value(1).max_value(300));
+        let input: Vec<u8> = tc.draw(generators::binary().min_size(len).max_size(len));
+        let initial: Vec<u8> = tc.draw(generators::binary().min_size(len).max_size(len));
+
+        let mut out = initial.clone();
+        mul_slice_xor(c, &input, &mut out);
+
+        let expect: Vec<u8> = input
+            .iter()
+            .zip(initial.iter())
+            .map(|(&x, &o)| o ^ mul(c, x))
+            .collect();
+        assert_eq!(expect, out);
+    }
+
+    /// Multiplication and division are inverse for non-zero divisors:
+    /// div(mul(a, b), b) == a. Complements the existing exhaustive
+    /// identity/associativity tests by tying `div` to `mul` directly.
+    #[hegel::test]
+    fn hegel_mul_div_roundtrip(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<u8>());
+        let b = tc.draw(generators::integers::<u8>().min_value(1));
+        assert_eq!(a, div(mul(a, b), b));
+    }
 }
