+// Generator for JSON5 decimal number literals per spec.json5.org/#numbers:
+// optional +/- sign; integer part that may be absent (".5") or have a trailing
+// point ("5."); optional exponent with optional sign and permitted leading zeros.
+// Never generates banned leading zeros. Pure-integer forms (no '.', no exponent)
+// are capped at 18 digits (< i64::MAX) because larger integer-shaped literals hit
+// the KNOWN BUG pinned by known_failure_large_integer_literal_rejected_for_f64;
+// forms with a '.' or exponent are unaffected and use up to 25 digits.
+#[hegel::composite]
+fn decimal_literal(tc: &hegel::TestCase) -> String {
+    let mut s = String::new();
+    s.push_str(tc.draw(generators::sampled_from(vec!["", "+", "-"])));
+    // Decide the shape up front so the pure-integer form can be bounded.
+    let int_shape = tc.draw(generators::integers::<u8>().max_value(3));
+    let (int_part, frac): (String, Option<String>) = match int_shape {
+        // ".5" — no integer part, fraction mandatory
+        0 => (
+            String::new(),
+            Some(tc.draw(generators::from_regex("[0-9]{1,25}").fullmatch(true))),
+        ),
+        // "123" — pure integer, bounded (see above)
+        1 => (
+            tc.draw(hegel::one_of!(
+                generators::just("0".to_owned()),
+                generators::from_regex("[1-9][0-9]{0,17}").fullmatch(true),
+            )),
+            None,
+        ),
+        // "123." — trailing decimal point
+        2 => (
+            tc.draw(hegel::one_of!(
+                generators::just("0".to_owned()),
+                generators::from_regex("[1-9][0-9]{0,24}").fullmatch(true),
+            )),
+            Some(String::new()),
+        ),
+        // "123.456"
+        _ => (
+            tc.draw(hegel::one_of!(
+                generators::just("0".to_owned()),
+                generators::from_regex("[1-9][0-9]{0,24}").fullmatch(true),
+            )),
+            Some(tc.draw(generators::from_regex("[0-9]{1,25}").fullmatch(true))),
+        ),
+    };
+    s.push_str(&int_part);
+    if let Some(frac) = &frac {
+        s.push('.');
+        s.push_str(frac);
+    }
+    // An exponent turns a pure-integer form into an f64-routed form, which is safe.
+    if tc.draw(generators::booleans()) {
+        s.push(if tc.draw(generators::booleans()) { 'e' } else { 'E' });
+        s.push_str(tc.draw(generators::sampled_from(vec!["", "+", "-"])));
+        s.push_str(&tc.draw(generators::from_regex("[0-9]{1,3}").fullmatch(true)));
+    }
+    s
+}
+
+// Property (differential): every JSON5 decimal literal form — leading decimal
+// point, trailing decimal point, explicit +, e/E exponents — parses to the same
+// f64 that Rust's own float parser produces for the identical string (Rust's
+// f64::from_str accepts a superset of these forms, so it is an exact oracle).
+#[hegel::test]
+fn decimal_literal_matches_rust_float_parser(tc: hegel::TestCase) {
+    let s: String = tc.draw(decimal_literal());
+    // "-0" alone is excluded: json5 routes it through i128 and loses the negative
+    // zero sign — same KNOWN BUG family as
+    // known_failure_integral_floats_serialize_without_float_marker in tests/ser.rs.
+    tc.assume(s != "-0");
+    let expected: f64 = s.parse().expect("generator must produce Rust-parseable literals");
+    let got: f64 =
+        from_str(&s).unwrap_or_else(|e| panic!("json5 rejected valid literal {s:?}: {e}"));
+    assert_eq!(
+        got.to_bits(),
+        expected.to_bits(),
+        "{s:?}: json5 parsed {got}, Rust parsed {expected}"
+    );
+}
+
+// Property (validation/rejection): decimal integers with leading zeros are banned
+// by the JSON5 grammar and must be rejected, not silently accepted.
+// Evidence: ErrorCode::LeadingZero and the "007" case in the parse_number test.
+#[hegel::test]
+fn leading_zero_is_rejected(tc: hegel::TestCase) {
+    let sign: &str = tc.draw(generators::sampled_from(vec!["", "+", "-"]));
+    let digits: String = tc.draw(generators::from_regex("[0-9]{1,10}").fullmatch(true));
+    let s = format!("{sign}0{digits}");
+    assert!(
+        from_str::<Value>(&s).is_err(),
+        "{s:?} should be rejected (leading zero)"
+    );
+    assert!(
+        from_str::<f64>(&s).is_err(),
+        "{s:?} should be rejected (leading zero)"
+    );
+}
+
+// Property (validation/rejection): unpaired UTF-16 surrogate escapes in strings
+// must be rejected. Evidence: the surrogate-pair error cases in the parse_string
+// unit test; spec.json5.org/#escapes requires a full surrogate pair for
+// supplementary-plane characters.
+#[hegel::test]
+fn unpaired_surrogate_escape_is_rejected(tc: hegel::TestCase) {
+    let hi: u32 = tc.draw(
+        generators::integers::<u32>()
+            .min_value(0xD800)
+            .max_value(0xDBFF),
+    );
+    let lo: u32 = tc.draw(
+        generators::integers::<u32>()
+            .min_value(0xDC00)
+            .max_value(0xDFFF),
+    );
+    let s = match tc.draw(generators::integers::<u8>().max_value(3)) {
+        0 => format!("\"\\u{hi:04x}\""),        // high surrogate at end of string
+        1 => format!("\"\\u{hi:04x}A\""),       // high surrogate then ordinary char
+        2 => format!("\"\\u{hi:04x}\\u0041\""), // high surrogate then BMP escape
+        _ => format!("\"\\u{lo:04x}\""),        // lone low surrogate
+    };
+    assert!(from_str::<String>(&s).is_err(), "{s} should be rejected");
+}
+
+/// Insert a random run of JSON5 whitespace and/or comments (possibly nothing).
+fn pad(tc: &hegel::TestCase, out: &mut String) {
+    match tc.draw_silent(generators::integers::<u8>().max_value(7)) {
+        0 => {}
+        1 => out.push(' '),
+        2 => out.push('\n'),
+        3 => out.push('\t'),
+        4 => out.push('\u{00A0}'),
+        5 => out.push_str("/* comment */"),
+        6 => out.push_str("// comment\n"),
+        _ => out.push_str("\u{FEFF}\u{2028}\u{2029} "),
+    }
+}
+
+/// Same shield as `replace_integral_floats` in tests/ser.rs (duplicated because
+/// integration-test binaries can't share code without a common module): replaces
+/// integral-valued floats, which hit the KNOWN BUG pinned by
+/// `known_failure_integral_floats_serialize_without_float_marker` when serialized
+/// by json5.
+fn replace_integral_floats(v: &mut Value) {
+    match v {
+        Value::Number(n) => {
+            if n.is_f64() && n.as_f64().is_some_and(|f| f.fract() == 0.0) {
+                *v = Value::from(0.5f64);
+            }
+        }
+        Value::Array(a) => a.iter_mut().for_each(replace_integral_floats),
+        Value::Object(o) => o.values_mut().for_each(replace_integral_floats),
+        _ => {}
+    }
+}
+
+// Property: inserting comments and whitespace at token boundaries never changes the
+// parsed value. The serializer escapes '\n' inside strings, so every raw '\n' in
+// to_string output is a structural separator — a guaranteed-safe insertion point.
+// Evidence: spec.json5.org/#white-space and #comments; skip_whitespace runs before
+// every token in src/de.rs.
+#[hegel::test]
+fn comments_and_whitespace_are_insensitive(tc: hegel::TestCase) {
+    let mut v: Value = tc.draw(json_gs::values());
+    replace_integral_floats(&mut v); // KNOWN BUG shield — see fn docs
+    let s = json5::to_string(&v).unwrap();
+    let mut decorated = String::new();
+    pad(&tc, &mut decorated);
+    for c in s.chars() {
+        decorated.push(c);
+        if c == '\n' {
+            pad(&tc, &mut decorated);
+        }
+    }
+    pad(&tc, &mut decorated);
+    let parsed: Value = from_str(&decorated)
+        .unwrap_or_else(|e| panic!("failed to parse {decorated:?}: {e}"));
+    assert_eq!(parsed, v);
+}
+
+/// Write `s` as a JSON5 string literal with a drawn quote style, drawn escape
+/// styles (`\xXX`, `\uXXXX`, UTF-16 surrogate pairs), and occasional line
+/// continuations (backslash-newline, which parses to nothing).
+fn write_string(tc: &hegel::TestCase, s: &str, out: &mut String) {
+    let delim = if tc.draw_silent(generators::booleans()) {
+        '\''
+    } else {
+        '"'
+    };
+    out.push(delim);
+    for c in s.chars() {
+        if tc.draw_silent(generators::integers::<u8>().max_value(15)) == 0 {
+            out.push('\\');
+            out.push('\n'); // line continuation: contributes nothing to the value
+        }
+        let cp = c as u32;
+        match c {
+            c if c == delim => {
+                out.push('\\');
+                out.push(c);
+            }
+            '\\' => out.push_str(r"\\"),
+            '\n' => out.push_str(r"\n"),
+            '\r' => out.push_str(r"\r"),
+            _ => match tc.draw_silent(generators::integers::<u8>().max_value(7)) {
+                0 if cp <= 0xFF && cp != 0x0A && cp != 0x0D => {
+                    out.push_str(&format!("\\x{cp:02x}"));
+                }
+                1 => {
+                    let mut buf = [0u16; 2];
+                    for unit in c.encode_utf16(&mut buf) {
+                        out.push_str(&format!("\\u{unit:04x}"));
+                    }
+                }
+                _ => out.push(c),
+            },
+        }
+    }
+    out.push(delim);
+}
+
+/// Write an object key: unquoted when it is a valid JSON5 identifier (drawn),
+/// otherwise as a string literal.
+fn write_key(tc: &hegel::TestCase, k: &str, out: &mut String) {
+    let mut chars = k.chars();
+    let ident = chars
+        .next()
+        .is_some_and(json5::char::is_json5_identifier_start)
+        && chars.all(json5::char::is_json5_identifier);
+    if ident && tc.draw_silent(generators::booleans()) {
+        out.push_str(k);
+    } else {
+        write_string(tc, k, out);
+    }
+}
+
+/// Write a number with a drawn representation: decimal or hex, optional + sign.
+/// Floats use `{:?}` (Rust Debug), which always keeps a float marker.
+fn write_number(tc: &hegel::TestCase, n: &serde_json::Number, out: &mut String) {
+    if let Some(u) = n.as_u64() {
+        match tc.draw_silent(generators::integers::<u8>().max_value(3)) {
+            0 => out.push_str(&format!("0x{u:x}")),
+            1 => out.push_str(&format!("+0X{u:X}")),
+            2 => out.push_str(&format!("+{u}")),
+            _ => out.push_str(&u.to_string()),
+        }
+    } else if let Some(i) = n.as_i64() {
+        if tc.draw_silent(generators::booleans()) {
+            out.push_str(&format!("-0x{:x}", i.unsigned_abs()));
+        } else {
+            out.push_str(&i.to_string());
+        }
+    } else {
+        out.push_str(&format!("{:?}", n.as_f64().expect("number is f64")));
+    }
+}
+
+/// Write `v` as JSON5 exercising the grammar breadth: comments/whitespace between
+/// all tokens, trailing commas, unquoted keys, both quote styles, escapes, hex.
+fn write_value(tc: &hegel::TestCase, v: &Value, out: &mut String) {
+    match v {
+        Value::Null => out.push_str("null"),
+        Value::Bool(true) => out.push_str("true"),
+        Value::Bool(false) => out.push_str("false"),
+        Value::Number(n) => write_number(tc, n, out),
+        Value::String(s) => write_string(tc, s, out),
+        Value::Array(a) => {
+            out.push('[');
+            for (i, item) in a.iter().enumerate() {
+                if i > 0 {
+                    out.push(',');
+                }
+                pad(tc, out);
+                write_value(tc, item, out);
+                pad(tc, out);
+            }
+            if !a.is_empty() && tc.draw_silent(generators::booleans()) {
+                out.push(',');
+                pad(tc, out);
+            }
+            out.push(']');
+        }
+        Value::Object(o) => {
+            for (i, (k, val)) in o.iter().enumerate() {
+                if i == 0 {
+                    out.push('{');
+                }
+                if i > 0 {
+                    out.push(',');
+                }
+                pad(tc, out);
+                write_key(tc, k, out);
+                pad(tc, out);
+                out.push(':');
+                pad(tc, out);
+                write_value(tc, val, out);
+                pad(tc, out);
+            }
+            if o.is_empty() {
+                out.push('{');
+                pad(tc, out);
+            } else if tc.draw_silent(generators::booleans()) {
+                out.push(',');
+                pad(tc, out);
+            }
+            out.push('}');
+        }
+    }
+}
+
+// Property (grammar-directed differential): a JSON5 document generated directly
+// from the grammar — with comments and exotic whitespace between all tokens,
+// single- and double-quoted strings, \x/\u escapes, UTF-16 surrogate pairs, line
+// continuations, unquoted identifier keys, trailing commas in arrays and objects,
+// and hex/plus-signed numbers — parses back to exactly the expected value.
+// Evidence: each construct is promised by spec.json5.org (linked throughout
+// src/de.rs) and demonstrated in the crate's own doc examples.
+#[hegel::test]
+fn generated_json5_document_parses_to_expected_value(tc: hegel::TestCase) {
+    let v: Value = tc.draw(json_gs::values());
+    let mut doc = String::new();
+    pad(&tc, &mut doc);
+    write_value(&tc, &v, &mut doc);
+    pad(&tc, &mut doc);
+    tc.note(&format!("document: {doc:?}"));
+    let parsed: Value =
+        from_str(&doc).unwrap_or_else(|e| panic!("failed to parse {doc:?}: {e}"));
+    assert_eq!(parsed, v);
+}
