+// KNOWN FAILURE — real bug in json5 1.3.1 (kept failing on purpose; do not "fix" the test):
+// serialize_f64/serialize_f32 write finite floats with a bare `write!("{v}")`
+// (the serialize_float! macro in src/ser.rs), and Rust's f64 Display omits any float
+// marker for integral values. So any float whose value is integral serializes to an
+// integer-shaped token:
+//   * to_string(&1.0f64)  == "1"    -> re-parses as the integer 1, not the float 1.0
+//     (visible through self-describing targets like serde_json::Value)
+//   * to_string(&-0.0f64) == "-0"   -> re-parses as +0.0; the sign of -0.0 is lost
+//     even at the typed f64 level (parse_decimal_number routes "-0" through i128)
+//   * to_string(&1e300f64) == "1000…000" (301 digits) -> from_str::<f64> on json5's
+//     OWN OUTPUT fails with "number too large to fit in target type", because
+//     integer-shaped tokens are routed exclusively through u128/i128 in
+//     src/de.rs parse_decimal_number, never falling back to f64.
+// serde_json avoids all three by always emitting a float marker ("1.0", "1e300").
+// The assertion below pins the strongest manifestation: the crate cannot re-parse
+// its own serializer output.
+#[test]
+fn known_failure_integral_floats_serialize_without_float_marker() {
+    let s = to_string(&1e300f64).unwrap();
+    assert_eq!(
+        json5::from_str::<f64>(&s),
+        Ok(1e300),
+        "json5 cannot re-parse its own serialization of 1e300f64 ({} chars)",
+        s.len()
+    );
+}
+
+/// Replace every float whose value is integral (`fract() == 0.0`, which also covers
+/// `-0.0` and huge values like `1e300`) with `0.5`.
+///
+/// This shields the roundtrip properties below from the KNOWN BUG pinned by
+/// `known_failure_integral_floats_serialize_without_float_marker`: integral-valued
+/// floats serialize without a float marker and either re-parse as integers or
+/// (when wider than u128) fail to parse at all.
+fn replace_integral_floats(v: &mut Value) {
+    match v {
+        Value::Number(n) => {
+            if n.is_f64() && n.as_f64().is_some_and(|f| f.fract() == 0.0) {
+                *v = Value::from(0.5f64);
+            }
+        }
+        Value::Array(a) => a.iter_mut().for_each(replace_integral_floats),
+        Value::Object(o) => o.values_mut().for_each(replace_integral_floats),
+        _ => {}
+    }
+}
+
+// Property: serialize -> deserialize roundtrips arbitrary JSON values, and the
+// roundtrip is a fixpoint (re-serializing the parsed value reproduces the string
+// byte-for-byte). Evidence: to_string/from_str are documented as a
+// serializer/deserializer pair over the whole Serde data model (src/lib.rs docs),
+// and tests/de.rs already deserializes into serde_json::Value.
+#[hegel::test]
+fn value_roundtrip_and_fixpoint(tc: hegel::TestCase) {
+    let mut v: Value = tc.draw(json_gs::values());
+    replace_integral_floats(&mut v); // see comment on replace_integral_floats
+    let s = to_string(&v).expect("every JSON value is expressible in JSON5");
+    let parsed: Value =
+        json5::from_str(&s).unwrap_or_else(|e| panic!("failed to re-parse {s:?}: {e}"));
+    assert_eq!(parsed, v);
+    let s2 = to_string(&parsed).unwrap();
+    assert_eq!(s2, s, "serialize ∘ parse must be a fixpoint");
+}
+
+// Property: f64 values — including NaN, -NaN, Infinity and -Infinity, which JSON5
+// can represent (spec.json5.org/#numbers; serialize_float!/parse_number handle them
+// explicitly) — roundtrip bit-exactly through to_string/from_str.
+#[hegel::test]
+fn float_roundtrip(tc: hegel::TestCase) {
+    let f: f64 = tc.draw(generators::floats::<f64>()); // includes NaN and ±Infinity
+    // Finite integral-valued floats (including -0.0) are excluded: KNOWN BUG, see
+    // known_failure_integral_floats_serialize_without_float_marker.
+    tc.assume(!(f.is_finite() && f.fract() == 0.0));
+    let s = to_string(&f).unwrap();
+    let parsed: f64 =
+        json5::from_str(&s).unwrap_or_else(|e| panic!("failed to parse {s:?}: {e}"));
+    if f.is_nan() {
+        assert!(parsed.is_nan(), "expected NaN, got {parsed}");
+        assert_eq!(
+            parsed.is_sign_negative(),
+            f.is_sign_negative(),
+            "NaN sign not preserved"
+        );
+    } else {
+        assert_eq!(parsed.to_bits(), f.to_bits(), "{s:?} parsed as {parsed}, not {f}");
+    }
+}
+
+// Property: integers roundtrip through to_string/from_str across the full i128 and
+// u128 ranges (MIN/MAX/0 boundaries included — the existing parse_number unit test
+// pins exactly these boundaries as in-contract).
+#[hegel::test]
+fn integer_roundtrip(tc: hegel::TestCase) {
+    let i: i128 = tc.draw(generators::integers::<i128>());
+    let s = to_string(&i).unwrap();
+    assert_eq!(json5::from_str::<i128>(&s), Ok(i));
+
+    let u: u128 = tc.draw(generators::integers::<u128>());
+    let s = to_string(&u).unwrap();
+    assert_eq!(json5::from_str::<u128>(&s), Ok(u));
+}
+
+// Property: strings roundtrip through to_string/from_str. Characters are drawn at
+// the writer's escape boundary (the exact set handled by src/char.rs escape(): both
+// quote kinds, backslash, \n, \r, U+2028/U+2029) plus JSON5 whitespace, controls,
+// and arbitrary codepoints — bugs live in the characters the writer forgot to escape.
+#[hegel::test]
+fn string_roundtrip_at_escape_boundary(tc: hegel::TestCase) {
+    let boundary = vec![
+        '"', '\'', '\\', '\n', '\r', '\t', '\0', '\u{000B}', '\u{000C}', '\u{0085}',
+        '\u{00A0}', '\u{1680}', '\u{2028}', '\u{2029}', '\u{FEFF}', '\u{200C}',
+        '\u{200D}', '\u{FFFD}', '\u{D7FF}', '\u{E000}', '\u{10FFFF}', '/', '*', 'ß',
+        '𝄞',
+    ];
+    let n = tc.draw(generators::integers::<usize>().max_value(30));
+    let mut s = String::new();
+    for _ in 0..n {
+        s.push(tc.draw_silent(hegel::one_of!(
+            generators::sampled_from(boundary.clone()),
+            generators::integers::<u32>()
+                .max_value(0x10FFFF)
+                .map(|c| char::from_u32(c).unwrap_or('\u{FFFD}')),
+        )));
+    }
+    tc.note(&format!("string: {s:?}"));
+    let ser = to_string(&s).unwrap();
+    let back: String =
+        json5::from_str(&ser).unwrap_or_else(|e| panic!("failed to parse {ser:?}: {e}"));
+    assert_eq!(back, s);
+}
+
+// Property: chars roundtrip through the dedicated serialize_char path (which has its
+// own delimiter-choice logic separate from serialize_str).
+#[hegel::test]
+fn char_roundtrip(tc: hegel::TestCase) {
+    let c: char = tc.draw(hegel::one_of!(
+        generators::sampled_from(vec![
+            '"', '\'', '\\', '\n', '\r', '\0', '\u{2028}', '\u{2029}', '\u{FEFF}',
+        ]),
+        generators::integers::<u32>()
+            .max_value(0x10FFFF)
+            .map(|c| char::from_u32(c).unwrap_or('\u{FFFD}')),
+    ));
+    let s = to_string(&c).unwrap();
+    let back: char =
+        json5::from_str(&s).unwrap_or_else(|e| panic!("failed to parse {s:?}: {e}"));
+    assert_eq!(back, c);
+}
