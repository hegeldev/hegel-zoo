+mod common;
+
+/// Property-based tests (hegel).
+mod props {
+    use hegel::Generator;
+    use super::common::{arbitrary_values, enc, eqv, ValueCfg, FULL};
+    use ciborium::value::{canonical_into_writer, canonical_value, CanonicalValue, Value};
+    use hegel::generators;
+    use std::cmp::Ordering;
+
+    /// The ordering documented on `cmp_value` / RFC 8949 4.2.3: shorter
+    /// serializations sort first; equal lengths compare lexicographically.
+    fn byte_order(a: &[u8], b: &[u8]) -> Ordering {
+        a.len().cmp(&b.len()).then_with(|| a.cmp(b))
+    }
+
+    fn canonical_cmp(a: &Value, b: &Value) -> Ordering {
+        CanonicalValue::from(a.clone()).cmp(&CanonicalValue::from(b.clone()))
+    }
+
+    /// `CanonicalValue`'s ordering (i.e. `cmp_value`) matches the documented
+    /// rule: compare the serialized bytes, shorter first, then lexicographic.
+    /// The serialized bytes themselves are the independent oracle.
+    ///
+    /// Tag-vs-tag comparisons are excluded here: they violate this rule and
+    /// are pinned by `known_failure_cmp_value_tag_pairs_ignore_length` below.
+    #[hegel::test]
+    fn canonical_ordering_matches_serialized_bytes(tc: hegel::TestCase) {
+        let v1 = tc.draw((arbitrary_values(2, FULL)).print_as_debug());
+        let v2 = tc.draw((arbitrary_values(2, FULL)).print_as_debug());
+        tc.assume(!(v1.is_tag() && v2.is_tag()));
+        let expected = byte_order(&enc(&v1), &enc(&v2));
+        let got = canonical_cmp(&v1, &v2);
+        assert_eq!(got, expected, "cmp_value({v1:?}, {v2:?})");
+    }
+
+    /// KNOWN FAILURE: when both values are tags, `cmp_value` compares the tag
+    /// *numbers* numerically (`Value::from(t).partial_cmp(...)`) instead of
+    /// following its documented rule that shorter serializations sort first.
+    /// A 1-byte tag header with long content then sorts before a 2-byte tag
+    /// header with short content. Besides contradicting the documentation,
+    /// this makes `CanonicalValue`'s `Ord` intransitive when tags are mixed
+    /// with other types, e.g.:
+    ///   A = Tag(0, Bytes(vec![0; 10]))  (12 bytes), B = Tag(24, Null) (3 bytes),
+    ///   C = Text("abc") (4 bytes)  =>  A < B (tag rule), B < C, C < A (byte rule).
+    /// Code path: `ciborium/src/value/canonical.rs`, `cmp_value`, `(Tag, Tag)` arm.
+    ///
+    /// The generator is pinned to the failing region (1-byte tag + long
+    /// content vs 2-byte tag + `Null`) so this fails deterministically.
+    #[hegel::test(test_cases = 20)]
+    fn known_failure_cmp_value_tag_pairs_ignore_length(tc: hegel::TestCase) {
+        let t1 = tc.draw(generators::integers::<u64>().max_value(1));
+        let t2 = tc.draw(generators::integers::<u64>().min_value(24).max_value(255));
+        let len = tc.draw(generators::integers::<usize>().min_value(10).max_value(23));
+        let v1 = Value::Tag(t1, Box::new(Value::Bytes(vec![0; len])));
+        let v2 = Value::Tag(t2, Box::new(Value::Null));
+        let expected = byte_order(&enc(&v1), &enc(&v2)); // Greater: v1 encodes longer
+        let got = canonical_cmp(&v1, &v2);
+        assert_eq!(got, expected, "cmp_value({v1:?}, {v2:?})");
+    }
+
+    /// `canonical_value` is idempotent: canonicalizing an already-canonical
+    /// value changes nothing. Tag map keys are excluded because of the
+    /// `cmp_value` tag-ordering bug pinned above.
+    #[hegel::test]
+    fn canonical_value_is_idempotent(tc: hegel::TestCase) {
+        let cfg = ValueCfg {
+            bignum_tags: true,
+            tag_keys: false,
+            unique_keys: false,
+        };
+        let v = tc.draw((arbitrary_values(3, cfg)).print_as_debug());
+        let once = canonical_value(v);
+        let twice = canonical_value(once.clone());
+        assert!(eqv(&once, &twice), "{once:?} != {twice:?}");
+    }
+
+    /// Deep-copy `v`, shuffling the entry order of every map using drawn
+    /// indices (Fisher-Yates).
+    fn permuted(tc: &hegel::TestCase, v: &Value) -> Value {
+        match v {
+            Value::Array(xs) => Value::Array(xs.iter().map(|x| permuted(tc, x)).collect()),
+            Value::Tag(t, x) => Value::Tag(*t, Box::new(permuted(tc, x))),
+            Value::Map(entries) => {
+                let mut es: Vec<(Value, Value)> = entries
+                    .iter()
+                    .map(|(k, v)| (k.clone(), permuted(tc, v)))
+                    .collect();
+                for i in (1..es.len()).rev() {
+                    let j = tc.draw(generators::integers::<usize>().max_value(i));
+                    es.swap(i, j);
+                }
+                Value::Map(es)
+            }
+            _ => v.clone(),
+        }
+    }
+
+    /// RFC 8949 deterministic encoding: two values that differ only in map
+    /// entry order produce identical canonical encodings. Map keys are unique
+    /// (duplicate keys have no canonical order) and exclude tags (bug pinned
+    /// above).
+    #[hegel::test]
+    fn canonical_encoding_is_map_order_independent(tc: hegel::TestCase) {
+        let cfg = ValueCfg {
+            bignum_tags: true,
+            tag_keys: false,
+            unique_keys: true,
+        };
+        let v = tc.draw((arbitrary_values(3, cfg)).print_as_debug());
+        let w = permuted(&tc, &v);
+
+        let mut b1 = Vec::new();
+        canonical_into_writer(&v, &mut b1).unwrap();
+        let mut b2 = Vec::new();
+        canonical_into_writer(&w, &mut b2).unwrap();
+        assert_eq!(
+            hex::encode(&b1),
+            hex::encode(&b2),
+            "canonical encodings differ:\n{v:?}\n{w:?}"
+        );
+    }
+
+    /// Canonical encoding preserves the value: decoding the canonical bytes
+    /// yields exactly `canonical_value(v)`. Bignum tags excluded (they collapse
+    /// on decode); tag map keys excluded (cmp_value bug pinned above).
+    #[hegel::test]
+    fn canonical_bytes_decode_to_canonical_value(tc: hegel::TestCase) {
+        let cfg = ValueCfg {
+            bignum_tags: false,
+            tag_keys: false,
+            unique_keys: false,
+        };
+        let v = tc.draw((arbitrary_values(3, cfg)).print_as_debug());
+        let mut bytes = Vec::new();
+        canonical_into_writer(&v, &mut bytes).unwrap();
+        let back: Value = ciborium::de::from_reader(bytes.as_slice()).unwrap();
+        let expected = canonical_value(v);
+        assert!(eqv(&back, &expected), "{expected:?} != {back:?}");
+    }
+}
