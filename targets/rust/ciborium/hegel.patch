+
+mod common;
+
+/// Property-based tests (hegel).
+mod props {
+    use hegel::Generator;
+    use super::common::{arbitrary_values, enc, eqv, ValueCfg, FULL};
+    use ciborium::{de::from_reader, value::Value};
+    use hegel::generators;
+    use std::collections::HashMap;
+
+    /// Decoding arbitrary bytes never panics, whatever the target type
+    /// (parse robustness; same property as the fork-based fuzz test in
+    /// tests/fuzz.rs, but with shrinking).
+    #[hegel::test]
+    fn decoding_arbitrary_bytes_never_panics(tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<usize>().max_value(300));
+        let bytes: Vec<u8> = tc.draw(generators::binary().min_size(n));
+        match tc.draw(generators::integers::<u8>().max_value(5)) {
+            0 => drop(from_reader::<Value, _>(bytes.as_slice())),
+            1 => drop(from_reader::<String, _>(bytes.as_slice())),
+            2 => drop(from_reader::<Vec<i64>, _>(bytes.as_slice())),
+            3 => drop(from_reader::<HashMap<String, u64>, _>(bytes.as_slice())),
+            4 => drop(from_reader::<i128, _>(bytes.as_slice())),
+            _ => drop(from_reader::<(bool, f64, char), _>(bytes.as_slice())),
+        }
+    }
+
+    /// CBOR is self-delimiting, so no strict prefix of a valid encoding is a
+    /// valid encoding: decoding a truncation must fail (and not panic).
+    /// Evidence: all the truncated-input rstest cases above expect errors.
+    #[hegel::test]
+    fn strict_prefix_of_valid_encoding_is_an_error(tc: hegel::TestCase) {
+        let v = tc.draw((arbitrary_values(3, FULL)).print_as_debug());
+        let bytes = enc(&v);
+        let cut = tc.draw(generators::integers::<usize>().max_value(bytes.len() - 1));
+        let result = from_reader::<Value, _>(&bytes[..cut]);
+        assert!(
+            result.is_err(),
+            "decoding {cut}-byte prefix of {bytes:x?} succeeded: {result:?}"
+        );
+    }
+
+    /// `from_reader` consumes exactly one item from the reader: bytes after a
+    /// complete encoding do not affect the decoded value.
+    #[hegel::test]
+    fn trailing_bytes_after_one_item_are_ignored(tc: hegel::TestCase) {
+        // Bignum tags excluded: they decode to a different (normalized) Value,
+        // which is the roundtrip caveat covered in tests/codec.rs, not a
+        // trailing-bytes issue.
+        let cfg = ValueCfg {
+            bignum_tags: false,
+            tag_keys: true,
+            unique_keys: false,
+        };
+        let v = tc.draw((arbitrary_values(3, cfg)).print_as_debug());
+        let mut bytes = enc(&v);
+        bytes.extend(tc.draw(generators::binary()));
+        let back: Value = from_reader(bytes.as_slice()).unwrap();
+        assert!(eqv(&v, &back), "{v:?} -> {bytes:x?} -> {back:?}");
+    }
