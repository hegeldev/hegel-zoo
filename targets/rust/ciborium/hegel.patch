+// SPDX-License-Identifier: Apache-2.0
+
+//! Shared hegel generators and helpers for the ciborium property-based tests.
+
+#![allow(dead_code)] // not every test binary uses every helper
+
+use ciborium::value::{Integer, Value};
+use hegel::generators::{self, BoxedGenerator, Generator};
+use std::collections::HashSet;
+
+/// Configuration for [`arbitrary_values`].
+#[derive(Clone, Copy)]
+pub struct ValueCfg {
+    /// Allow tags 2/3 (bignums). ciborium deliberately decodes wire tags 2/3
+    /// into `Value::Integer` (or a normalized bignum) rather than a `Value::Tag`
+    /// — see the "Not In RFC" cases in tests/codec.rs — so encode->decode
+    /// roundtrip properties must exclude them.
+    pub bignum_tags: bool,
+    /// Allow `Value::Tag` as a map key. `cmp_value` orders two tags by tag
+    /// number instead of the documented serialized-byte order (see the
+    /// KNOWN FAILURE test in tests/canonical.rs), which makes sorting map
+    /// keys containing tags unreliable; canonical tests exclude tag keys.
+    pub tag_keys: bool,
+    /// Deduplicate map keys (by encoded bytes).
+    pub unique_keys: bool,
+}
+
+/// Everything allowed.
+pub const FULL: ValueCfg = ValueCfg {
+    bignum_tags: true,
+    tag_keys: true,
+    unique_keys: false,
+};
+
+/// Encode a `Value` to CBOR bytes.
+pub fn enc(v: &Value) -> Vec<u8> {
+    let mut bytes = Vec::new();
+    ciborium::ser::into_writer(v, &mut bytes).unwrap();
+    bytes
+}
+
+/// Structural equality on `Value` with floats compared bitwise, so that
+/// NaN == NaN (with the same payload). The derived `PartialEq` treats
+/// `Float(NaN) != Float(NaN)`, which is a comparison artifact rather than a
+/// roundtrip failure.
+pub fn eqv(a: &Value, b: &Value) -> bool {
+    match (a, b) {
+        (Value::Float(x), Value::Float(y)) => x.to_bits() == y.to_bits(),
+        (Value::Array(xs), Value::Array(ys)) => {
+            xs.len() == ys.len() && xs.iter().zip(ys).all(|(x, y)| eqv(x, y))
+        }
+        (Value::Map(xs), Value::Map(ys)) => {
+            xs.len() == ys.len()
+                && xs
+                    .iter()
+                    .zip(ys)
+                    .all(|((xk, xv), (yk, yv))| eqv(xk, yk) && eqv(xv, yv))
+        }
+        (Value::Tag(t, x), Value::Tag(u, y)) => t == u && eqv(x, y),
+        _ => a == b,
+    }
+}
+
+/// Draw an `Integer` covering the full encodable range `[-2^64, 2^64 - 1]`,
+/// boosting the encoding-width boundaries where header-size selection changes.
+pub fn draw_integer(tc: &hegel::TestCase) -> Integer {
+    const MIN: i128 = -(1i128 << 64);
+    const MAX: i128 = (1i128 << 64) - 1;
+    let x = tc.draw(hegel::one_of!(
+        generators::integers::<i128>().min_value(MIN).max_value(MAX),
+        generators::integers::<i64>().map(|x| x as i128),
+        generators::sampled_from(vec![
+            MIN,
+            MIN + 1,
+            -(1i128 << 63) - 1,
+            i64::MIN as i128,
+            -65537,
+            -65536,
+            -257,
+            -256,
+            -25,
+            -24,
+            -1,
+            0,
+            1,
+            23,
+            24,
+            255,
+            256,
+            65535,
+            65536,
+            (1i128 << 32) - 1,
+            1i128 << 32,
+            i64::MAX as i128,
+            1i128 << 63,
+            MAX - 1,
+            MAX,
+        ]),
+    ));
+    Integer::try_from(x).unwrap()
+}
+
+/// Draw an arbitrary f64, including NaNs with arbitrary payloads.
+pub fn draw_float(tc: &hegel::TestCase) -> f64 {
+    tc.draw(hegel::one_of!(
+        generators::floats::<f64>(),
+        // Arbitrary bit patterns: exercises subnormals, signaling NaNs and
+        // NaN payloads that do not survive an f64 -> f32 -> f64 conversion.
+        generators::integers::<u64>().map(f64::from_bits),
+    ))
+}
+
+fn draw_tag(tc: &hegel::TestCase, bignum_tags: bool) -> u64 {
+    let t = tc.draw(hegel::one_of!(
+        generators::integers::<u64>(),
+        generators::sampled_from(vec![0u64, 1, 4, 23, 24, 255, 256, 65535, 65536, u64::MAX]),
+    ));
+    if !bignum_tags && (t == 2 || t == 3) {
+        // Shift off the bignum tags without rejection sampling.
+        t + 4
+    } else {
+        t
+    }
+}
+
+/// Recursive generator for arbitrary CBOR `Value`s (up to `depth` levels of
+/// nesting via arrays, maps and tags).
+pub fn arbitrary_values(depth: u32, cfg: ValueCfg) -> BoxedGenerator<'static, Value> {
+    hegel::compose!(|tc| {
+        let max_kind = if depth == 0 { 5 } else { 8 };
+        match tc.draw(generators::integers::<u8>().max_value(max_kind)) {
+            0 => Value::Integer(draw_integer(&tc)),
+            1 => Value::Bytes(tc.draw(generators::binary())),
+            2 => Value::Float(draw_float(&tc)),
+            3 => Value::Text(tc.draw(generators::text())),
+            4 => Value::Bool(tc.draw(generators::booleans())),
+            5 => Value::Null,
+            6 => Value::Tag(
+                draw_tag(&tc, cfg.bignum_tags),
+                Box::new(tc.draw((arbitrary_values(depth - 1, cfg)).print_as_debug())),
+            ),
+            7 => Value::Array(
+                tc.draw((generators::vecs(arbitrary_values(depth - 1, cfg)).max_size(4)).print_as_debug()),
+            ),
+            _ => {
+                let n = tc.draw(generators::integers::<usize>().max_value(4));
+                let mut entries = Vec::with_capacity(n);
+                for _ in 0..n {
+                    let mut k = tc.draw((arbitrary_values(depth - 1, cfg)).print_as_debug());
+                    if !cfg.tag_keys {
+                        while let Value::Tag(_, inner) = k {
+                            k = *inner;
+                        }
+                    }
+                    let v = tc.draw((arbitrary_values(depth - 1, cfg)).print_as_debug());
+                    entries.push((k, v));
+                }
+                if cfg.unique_keys {
+                    let mut seen = HashSet::new();
+                    entries.retain(|(k, _)| seen.insert(enc(k)));
+                }
+                Value::Map(entries)
+            }
+        }
+    })
+    .boxed()
+}
