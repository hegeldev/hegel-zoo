+// ---------------------------------------------------------------------------
+// Property-based tests (hegel) for fuel metering, using the generated
+// arithmetic expression modules from `super::exprs`.
+// ---------------------------------------------------------------------------
+
+use super::exprs::{draw_expr_and_args, expr_module_wat, run_expr_module};
+use hegel::generators;
+
+/// Plenty of fuel for any expression module generated by `draw_expr_and_args`
+/// (expression trees have well below 1000 instructions).
+const AMPLE_FUEL: u64 = 1_000_000;
+
+/// Property: enabling fuel metering (with ample fuel) never changes the
+/// execution outcome compared to unmetered execution — it only determines
+/// whether execution completes.
+#[hegel::test]
+#[cfg_attr(not(feature = "wat"), ignore)]
+fn fuel_metering_does_not_change_outcome(tc: hegel::TestCase) {
+    let (expr, a, b) = draw_expr_and_args(&tc);
+    let wat = expr_module_wat(&expr);
+    tc.note(&format!("wat: {wat}, a: {a}, b: {b}"));
+    let (unmetered, _) = run_expr_module(CompilationMode::Eager, None, &wat, a, b);
+    let (metered, remaining) = run_expr_module(CompilationMode::Eager, Some(AMPLE_FUEL), &wat, a, b);
+    // Sanity: with ample fuel the metered run must not run out of fuel.
+    assert_ne!(metered, Err(TrapCode::OutOfFuel));
+    assert!(remaining.unwrap() > 0);
+    assert_eq!(metered, unmetered);
+}
+
+/// Property: giving more fuel than consumed never changes the outcome nor
+/// the amount of fuel consumed (fuel monotonicity).
+#[hegel::test]
+#[cfg_attr(not(feature = "wat"), ignore)]
+fn more_fuel_never_changes_outcome_or_consumption(tc: hegel::TestCase) {
+    let (expr, a, b) = draw_expr_and_args(&tc);
+    let wat = expr_module_wat(&expr);
+    tc.note(&format!("wat: {wat}, a: {a}, b: {b}"));
+    let (outcome, remaining) = run_expr_module(CompilationMode::Eager, Some(AMPLE_FUEL), &wat, a, b);
+    assert_ne!(outcome, Err(TrapCode::OutOfFuel));
+    let consumed = AMPLE_FUEL - remaining.unwrap();
+    // `extra == 0` checks that exactly the consumed fuel is sufficient.
+    let extra = tc.draw(generators::integers::<u64>().max_value(1_000_000_000));
+    let budget = consumed + extra;
+    let (outcome2, remaining2) = run_expr_module(CompilationMode::Eager, Some(budget), &wat, a, b);
+    assert_eq!(outcome2, outcome);
+    let consumed2 = budget - remaining2.unwrap();
+    assert_eq!(consumed2, consumed);
+}
+
+/// Property: giving less fuel than the run consumes always traps with
+/// `TrapCode::OutOfFuel` — never any other outcome.
+#[hegel::test]
+#[cfg_attr(not(feature = "wat"), ignore)]
+fn insufficient_fuel_always_traps_out_of_fuel(tc: hegel::TestCase) {
+    let (expr, a, b) = draw_expr_and_args(&tc);
+    let wat = expr_module_wat(&expr);
+    tc.note(&format!("wat: {wat}, a: {a}, b: {b}"));
+    let (outcome, remaining) = run_expr_module(CompilationMode::Eager, Some(AMPLE_FUEL), &wat, a, b);
+    assert_ne!(outcome, Err(TrapCode::OutOfFuel));
+    let consumed = AMPLE_FUEL - remaining.unwrap();
+    // Any call consumes at least some base fuel; reject the (unexpected)
+    // zero-consumption case instead of underflowing below.
+    tc.assume(consumed > 0);
+    let budget = tc.draw(generators::integers::<u64>().max_value(consumed - 1));
+    let (outcome2, _) = run_expr_module(CompilationMode::Eager, Some(budget), &wat, a, b);
+    assert_eq!(outcome2, Err(TrapCode::OutOfFuel));
+}
