+// ---------------------------------------------------------------------------
+// Property-based tests (hegel) for `Module::new` / `Module::validate`
+// robustness on arbitrary and wasm-shaped byte inputs.
+// ---------------------------------------------------------------------------
+
+use hegel::generators::{self, Generator as _};
+
+/// The Wasm binary magic bytes and version header.
+const WASM_HEADER: [u8; 8] = [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00];
+
+/// A small, valid Wasm binary module used as a seed for byte mutations:
+///
+/// ```wat
+/// (module (func (result i32) (i32.const 42)))
+/// ```
+const SEED_MODULE: &[u8] = &[
+    0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00, // magic + version
+    0x01, 0x05, 0x01, 0x60, 0x00, 0x01, 0x7F, // type section: () -> i32
+    0x03, 0x02, 0x01, 0x00, // function section: 1 func of type 0
+    0x0A, 0x06, 0x01, 0x04, 0x00, 0x41, 0x2A, 0x0B, // code section: i32.const 42
+];
+
+/// Sanity anchor for the generators below: the unmutated seed is valid.
+#[test]
+fn seed_module_is_valid() {
+    let engine = Engine::default();
+    Module::new(&engine, SEED_MODULE).unwrap();
+}
+
+/// Generator for random mutations of [`SEED_MODULE`].
+///
+/// `keep_header` preserves the first 8 bytes (magic + version) so that the
+/// result stays in the Wasm *binary* format domain.
+#[hegel::composite]
+fn mutated_seed(tc: &hegel::TestCase, keep_header: bool) -> Vec<u8> {
+    let mut bytes = SEED_MODULE.to_vec();
+    let first_mutable = if keep_header { WASM_HEADER.len() } else { 0 };
+    let num_mutations = tc.draw(generators::integers::<usize>().max_value(8));
+    for _ in 0..num_mutations {
+        let idx = tc.draw(
+            generators::integers::<usize>()
+                .min_value(first_mutable)
+                .max_value(bytes.len() - 1),
+        );
+        bytes[idx] = tc.draw(generators::integers::<u8>());
+    }
+    if tc.draw(generators::booleans()) {
+        let cut = tc.draw(
+            generators::integers::<usize>()
+                .min_value(first_mutable)
+                .max_value(bytes.len()),
+        );
+        bytes.truncate(cut);
+    }
+    bytes
+}
+
+/// Generator for arbitrary bytes prefixed with the Wasm binary header.
+#[hegel::composite]
+fn header_prefixed_bytes(tc: &hegel::TestCase) -> Vec<u8> {
+    let tail: Vec<u8> = tc.draw(generators::binary().max_size(300));
+    let mut bytes = WASM_HEADER.to_vec();
+    bytes.extend(tail);
+    bytes
+}
+
+/// Property: `Module::new` never panics, whatever bytes it is fed —
+/// raw garbage (which also exercises the `wat` text frontend), bytes with
+/// a valid Wasm binary header, or mutations of a valid module.
+#[hegel::test]
+fn module_new_never_panics_on_arbitrary_bytes(tc: hegel::TestCase) {
+    let bytes: Vec<u8> = tc.draw(hegel::one_of!(
+        generators::binary().max_size(300).boxed(),
+        header_prefixed_bytes().boxed(),
+        mutated_seed(false).boxed(),
+    ));
+    let engine = Engine::default();
+    // Must return `Ok` or `Err`, but never panic.
+    let _ = Module::new(&engine, &bytes[..]);
+}
+
+/// Property: for Wasm *binary* inputs, `Module::validate` and `Module::new`
+/// agree on acceptance: everything that validates must also translate
+/// (see the `fuzz/translate` fuzz target) and vice versa.
+///
+/// Restricted to inputs starting with the Wasm binary header because
+/// `Module::validate` does not accept the `wat` text format that
+/// `Module::new` additionally supports.
+#[cfg(feature = "validate")]
+#[hegel::test]
+fn module_validate_agrees_with_module_new(tc: hegel::TestCase) {
+    let bytes: Vec<u8> = tc.draw(hegel::one_of!(
+        header_prefixed_bytes().boxed(),
+        mutated_seed(true).boxed(),
+    ));
+    let engine = Engine::default();
+    let validated = Module::validate(&engine, &bytes);
+    let compiled = Module::new(&engine, &bytes[..]);
+    assert_eq!(
+        validated.is_ok(),
+        compiled.is_ok(),
+        "validate: {validated:?}, new: {}",
+        match &compiled {
+            Ok(_) => "Ok".to_string(),
+            Err(err) => format!("Err({err})"),
+        },
+    );
+}
