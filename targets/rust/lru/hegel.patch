+    // ------------------------------------------------------------------
+    // Hegel property-based tests
+    //
+    // The crate is `no_std` (with `extern crate std` in tests) and edition
+    // 2015, so std macros used by hegel-generated code are imported
+    // explicitly below.
+    // ------------------------------------------------------------------
+
+    use hegel::generators;
+    use std::collections::VecDeque;
+    use std::format;
+    use std::string::ToString;
+    use std::vec;
+    use std::vec::Vec;
+
+    /// Reference model for `LruCache`: a `VecDeque` of key-value pairs where
+    /// the front is the most-recently-used entry and the back is the
+    /// least-recently-used entry, plus the documented capacity.
+    struct ModelLru {
+        cap: usize,
+        entries: VecDeque<(u16, u32)>,
+    }
+
+    impl ModelLru {
+        fn new(cap: usize) -> ModelLru {
+            ModelLru {
+                cap,
+                entries: VecDeque::new(),
+            }
+        }
+
+        fn position(&self, k: u16) -> Option<usize> {
+            self.entries.iter().position(|&(ek, _)| ek == k)
+        }
+
+        /// `put`: existing key updates the value AND moves to MRU; a new key
+        /// over capacity evicts exactly the LRU entry.
+        fn put(&mut self, k: u16, v: u32) -> Option<u32> {
+            match self.position(k) {
+                Some(i) => {
+                    let (_, old) = self.entries.remove(i).unwrap();
+                    self.entries.push_front((k, v));
+                    Some(old)
+                }
+                None => {
+                    if self.entries.len() == self.cap {
+                        self.entries.pop_back();
+                    }
+                    self.entries.push_front((k, v));
+                    None
+                }
+            }
+        }
+
+        /// `push`: like `put`, but returns the replaced pair (either the old
+        /// entry for the same key, or the evicted LRU entry).
+        fn push(&mut self, k: u16, v: u32) -> Option<(u16, u32)> {
+            match self.position(k) {
+                Some(i) => {
+                    let (_, old) = self.entries.remove(i).unwrap();
+                    self.entries.push_front((k, v));
+                    Some((k, old))
+                }
+                None => {
+                    let evicted = if self.entries.len() == self.cap {
+                        self.entries.pop_back()
+                    } else {
+                        None
+                    };
+                    self.entries.push_front((k, v));
+                    evicted
+                }
+            }
+        }
+
+        /// `get`: moves the key to MRU.
+        fn get(&mut self, k: u16) -> Option<u32> {
+            match self.position(k) {
+                Some(i) => {
+                    let e = self.entries.remove(i).unwrap();
+                    self.entries.push_front(e);
+                    Some(self.entries[0].1)
+                }
+                None => None,
+            }
+        }
+
+        /// `peek`: does NOT change the recency order.
+        fn peek(&self, k: u16) -> Option<u32> {
+            self.position(k).map(|i| self.entries[i].1)
+        }
+
+        fn pop(&mut self, k: u16) -> Option<u32> {
+            self.position(k)
+                .map(|i| self.entries.remove(i).unwrap().1)
+        }
+
+        fn pop_entry(&mut self, k: u16) -> Option<(u16, u32)> {
+            self.position(k).map(|i| self.entries.remove(i).unwrap())
+        }
+
+        fn pop_lru(&mut self) -> Option<(u16, u32)> {
+            self.entries.pop_back()
+        }
+
+        fn pop_mru(&mut self) -> Option<(u16, u32)> {
+            self.entries.pop_front()
+        }
+
+        fn promote(&mut self, k: u16) -> bool {
+            match self.position(k) {
+                Some(i) => {
+                    let e = self.entries.remove(i).unwrap();
+                    self.entries.push_front(e);
+                    true
+                }
+                None => false,
+            }
+        }
+
+        fn demote(&mut self, k: u16) -> bool {
+            match self.position(k) {
+                Some(i) => {
+                    let e = self.entries.remove(i).unwrap();
+                    self.entries.push_back(e);
+                    true
+                }
+                None => false,
+            }
+        }
+
+        /// `resize` smaller evicts LRU entries down to the new capacity.
+        fn resize(&mut self, cap: usize) {
+            while self.entries.len() > cap {
+                self.entries.pop_back();
+            }
+            self.cap = cap;
+        }
+
+        fn clear(&mut self) {
+            self.entries.clear();
+        }
+    }
+
+    /// Mostly draws from a small key pool so puts/gets/pops collide often
+    /// (recency-order bugs need repeated touches of the same key), while
+    /// keeping the full u16 range reachable.
+    fn draw_lru_key(tc: &hegel::TestCase) -> u16 {
+        tc.draw(hegel::one_of!(
+            generators::integers::<u16>().max_value(7),
+            generators::integers::<u16>(),
+        ))
+    }
+
+    struct LruMachine {
+        cache: LruCache<u16, u32>,
+        model: ModelLru,
+    }
+
+    #[hegel::state_machine]
+    impl LruMachine {
+        #[rule]
+        fn put(&mut self, tc: hegel::TestCase) {
+            let k = draw_lru_key(&tc);
+            let v = tc.draw(generators::integers::<u32>());
+            assert_eq!(self.cache.put(k, v), self.model.put(k, v), "put({}, {})", k, v);
+        }
+
+        #[rule]
+        fn push(&mut self, tc: hegel::TestCase) {
+            let k = draw_lru_key(&tc);
+            let v = tc.draw(generators::integers::<u32>());
+            assert_eq!(
+                self.cache.push(k, v),
+                self.model.push(k, v),
+                "push({}, {})",
+                k,
+                v
+            );
+        }
+
+        #[rule]
+        fn get(&mut self, tc: hegel::TestCase) {
+            let k = draw_lru_key(&tc);
+            assert_eq!(self.cache.get(&k).copied(), self.model.get(k), "get({})", k);
+        }
+
+        #[rule]
+        fn get_mut(&mut self, tc: hegel::TestCase) {
+            let k = draw_lru_key(&tc);
+            let real = match self.cache.get_mut(&k) {
+                Some(v) => {
+                    *v = v.wrapping_add(1);
+                    Some(*v)
+                }
+                None => None,
+            };
+            let expected = match self.model.get(k) {
+                Some(_) => {
+                    let front = self.model.entries.front_mut().unwrap();
+                    front.1 = front.1.wrapping_add(1);
+                    Some(front.1)
+                }
+                None => None,
+            };
+            assert_eq!(real, expected, "get_mut({})", k);
+        }
+
+        #[rule]
+        fn peek(&mut self, tc: hegel::TestCase) {
+            let k = draw_lru_key(&tc);
+            assert_eq!(self.cache.peek(&k).copied(), self.model.peek(k), "peek({})", k);
+        }
+
+        #[rule]
+        fn peek_mut(&mut self, tc: hegel::TestCase) {
+            let k = draw_lru_key(&tc);
+            let real = match self.cache.peek_mut(&k) {
+                Some(v) => {
+                    *v = v.wrapping_sub(1);
+                    Some(*v)
+                }
+                None => None,
+            };
+            // peek_mut mutates the value in place without changing recency.
+            let expected = self.model.position(k).map(|i| {
+                let e = &mut self.model.entries[i];
+                e.1 = e.1.wrapping_sub(1);
+                e.1
+            });
+            assert_eq!(real, expected, "peek_mut({})", k);
+        }
+
+        #[rule]
+        fn contains(&mut self, tc: hegel::TestCase) {
+            let k = draw_lru_key(&tc);
+            assert_eq!(
+                self.cache.contains(&k),
+                self.model.position(k).is_some(),
+                "contains({})",
+                k
+            );
+        }
+
+        #[rule]
+        fn pop(&mut self, tc: hegel::TestCase) {
+            let k = draw_lru_key(&tc);
+            assert_eq!(self.cache.pop(&k), self.model.pop(k), "pop({})", k);
+        }
+
+        #[rule]
+        fn pop_entry(&mut self, tc: hegel::TestCase) {
+            let k = draw_lru_key(&tc);
+            assert_eq!(
+                self.cache.pop_entry(&k),
+                self.model.pop_entry(k),
+                "pop_entry({})",
+                k
+            );
+        }
+
+        #[rule]
+        fn pop_lru(&mut self, _tc: hegel::TestCase) {
+            assert_eq!(self.cache.pop_lru(), self.model.pop_lru(), "pop_lru");
+        }
+
+        #[rule]
+        fn pop_mru(&mut self, _tc: hegel::TestCase) {
+            assert_eq!(self.cache.pop_mru(), self.model.pop_mru(), "pop_mru");
+        }
+
+        #[rule]
+        fn promote(&mut self, tc: hegel::TestCase) {
+            let k = draw_lru_key(&tc);
+            assert_eq!(self.cache.promote(&k), self.model.promote(k), "promote({})", k);
+        }
+
+        #[rule]
+        fn demote(&mut self, tc: hegel::TestCase) {
+            let k = draw_lru_key(&tc);
+            assert_eq!(self.cache.demote(&k), self.model.demote(k), "demote({})", k);
+        }
+
+        #[rule]
+        fn resize(&mut self, tc: hegel::TestCase) {
+            // Small capacities force evictions; occasionally larger ones
+            // exercise growth. The upper bound protects the O(n)-scan model's
+            // runtime, not any contract of the library.
+            let cap = tc.draw(hegel::one_of!(
+                generators::integers::<usize>().min_value(1).max_value(8),
+                generators::integers::<usize>().min_value(1).max_value(300),
+            ));
+            self.cache.resize(NonZeroUsize::new(cap).unwrap());
+            self.model.resize(cap);
+        }
+
+        #[rule]
+        fn clear(&mut self, _tc: hegel::TestCase) {
+            self.cache.clear();
+            self.model.clear();
+        }
+
+        /// Full agreement after every operation: same length, same capacity,
+        /// same MRU->LRU order (and therefore same membership and values),
+        /// and the same LRU/MRU endpoints.
+        #[invariant]
+        fn agrees_with_model(&self, _tc: hegel::TestCase) {
+            assert_eq!(self.cache.len(), self.model.entries.len(), "len");
+            assert!(
+                self.cache.len() <= self.cache.cap().get(),
+                "len {} exceeds cap {}",
+                self.cache.len(),
+                self.cache.cap().get()
+            );
+            assert_eq!(self.cache.cap().get(), self.model.cap, "cap");
+            assert_eq!(self.cache.is_empty(), self.model.entries.is_empty(), "is_empty");
+            let actual: Vec<(u16, u32)> = self.cache.iter().map(|(k, v)| (*k, *v)).collect();
+            let expected: Vec<(u16, u32)> = self.model.entries.iter().cloned().collect();
+            assert_eq!(actual, expected, "iter() MRU->LRU order disagrees with model");
+            assert_eq!(
+                self.cache.peek_lru().map(|(k, v)| (*k, *v)),
+                self.model.entries.back().cloned(),
+                "peek_lru"
+            );
+            assert_eq!(
+                self.cache.peek_mru().map(|(k, v)| (*k, *v)),
+                self.model.entries.front().cloned(),
+                "peek_mru"
+            );
+        }
+    }
+
+    /// Property 1 (stateful model test): a random sequence of cache
+    /// operations applied to both `LruCache` and a VecDeque-based model must
+    /// agree on every return value and, after every step, on the full
+    /// MRU->LRU order.
+    #[hegel::test]
+    fn test_lru_agrees_with_vecdeque_model(tc: hegel::TestCase) {
+        let cap = tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+        let machine = LruMachine {
+            cache: LruCache::new(NonZeroUsize::new(cap).unwrap()),
+            model: ModelLru::new(cap),
+        };
+        hegel::stateful::machine(machine).run(tc);
+    }
+
+    /// Builds a cache holding `keys` (assumed distinct), inserted in order
+    /// with value `i` for `keys[i]`, so `iter()` yields the reverse of the
+    /// insertion order.
+    fn build_cache_from_keys(keys: &[u16], cap: usize) -> LruCache<u16, u32> {
+        let mut cache = LruCache::new(NonZeroUsize::new(cap).unwrap());
+        for (i, &k) in keys.iter().enumerate() {
+            cache.put(k, i as u32);
+        }
+        cache
+    }
+
+    /// Property 2: a `put` of a new key into a full cache evicts exactly the
+    /// least-recently-used entry and nothing else.
+    #[hegel::test]
+    fn test_put_over_capacity_evicts_exactly_lru(tc: hegel::TestCase) {
+        let keys: Vec<u16> = tc.draw(
+            generators::vecs(generators::integers::<u16>())
+                .min_size(2)
+                .max_size(64)
+                .unique(true),
+        );
+        let cap = keys.len() - 1;
+        let mut cache = build_cache_from_keys(&keys[..cap], cap);
+        assert_eq!(cache.len(), cap);
+
+        // The cache is full; keys[0] is the LRU entry. One more put must
+        // evict exactly keys[0].
+        cache.put(keys[cap], cap as u32);
+        assert_eq!(cache.len(), cap);
+        assert!(
+            !cache.contains(&keys[0]),
+            "the LRU key {} must be evicted",
+            keys[0]
+        );
+        for &k in &keys[1..] {
+            assert!(cache.contains(&k), "non-LRU key {} must survive", k);
+        }
+    }
+
+    /// Property 3: `get` moves exactly the touched key to the MRU position
+    /// (preserving the relative order of all other keys), while `peek` leaves
+    /// the recency order completely unchanged.
+    #[hegel::test]
+    fn test_get_moves_to_mru_but_peek_preserves_order(tc: hegel::TestCase) {
+        let keys: Vec<u16> = tc.draw(
+            generators::vecs(generators::integers::<u16>())
+                .min_size(1)
+                .max_size(64)
+                .unique(true),
+        );
+        let mut cache = build_cache_from_keys(&keys, keys.len());
+        let idx = tc.draw(generators::integers::<usize>().max_value(keys.len() - 1));
+        let target = keys[idx];
+
+        let before: Vec<u16> = cache.iter().map(|(k, _)| *k).collect();
+
+        // peek returns the value but must not perturb the order.
+        assert_eq!(cache.peek(&target).copied(), Some(idx as u32));
+        let after_peek: Vec<u16> = cache.iter().map(|(k, _)| *k).collect();
+        assert_eq!(after_peek, before, "peek must not change recency order");
+
+        // get returns the value and moves exactly the target to MRU.
+        assert_eq!(cache.get(&target).copied(), Some(idx as u32));
+        let after_get: Vec<u16> = cache.iter().map(|(k, _)| *k).collect();
+        let mut expected = vec![target];
+        expected.extend(before.iter().copied().filter(|&k| k != target));
+        assert_eq!(
+            after_get, expected,
+            "get must move the key to MRU and preserve the rest"
+        );
+    }
+
+    /// Property 4: operations on an absent key return None/false and do not
+    /// perturb the cache contents or recency order.
+    #[hegel::test]
+    fn test_absent_key_ops_are_noops(tc: hegel::TestCase) {
+        // Present keys are drawn from 0..=255 and the absent key from
+        // 256.., so the absent key is guaranteed absent by construction.
+        let keys: Vec<u16> = tc.draw(
+            generators::vecs(generators::integers::<u16>().max_value(255))
+                .min_size(1)
+                .max_size(64)
+                .unique(true),
+        );
+        let absent = tc.draw(generators::integers::<u16>().min_value(256));
+        let mut cache = build_cache_from_keys(&keys, keys.len());
+
+        let before: Vec<(u16, u32)> = cache.iter().map(|(k, v)| (*k, *v)).collect();
+
+        assert_eq!(cache.get(&absent), None);
+        assert_eq!(cache.get_mut(&absent), None);
+        assert_eq!(cache.peek(&absent), None);
+        assert_eq!(cache.pop(&absent), None);
+        assert_eq!(cache.pop_entry(&absent), None);
+        assert!(!cache.contains(&absent));
+        assert!(!cache.promote(&absent));
+        assert!(!cache.demote(&absent));
+
+        let after: Vec<(u16, u32)> = cache.iter().map(|(k, v)| (*k, *v)).collect();
+        assert_eq!(after, before, "absent-key operations must not perturb the cache");
+    }
+
+    /// Property 5: a capacity-1 cache always holds exactly the last inserted
+    /// pair. (Capacity 0 is unrepresentable: `LruCache::new` takes
+    /// `NonZeroUsize`.)
+    #[hegel::test]
+    fn test_capacity_one_holds_exactly_last_put(tc: hegel::TestCase) {
+        let mut cache: LruCache<u16, u32> = LruCache::new(NonZeroUsize::new(1).unwrap());
+        let ops: Vec<(u16, u32)> = tc.draw(
+            generators::vecs(generators::tuples!(
+                generators::integers::<u16>().max_value(7),
+                generators::integers::<u32>(),
+            ))
+            .min_size(1)
+            .max_size(32),
+        );
+        for &(k, v) in &ops {
+            cache.put(k, v);
+            assert_eq!(cache.len(), 1);
+            assert_eq!(cache.peek(&k).copied(), Some(v));
+            assert_eq!(cache.peek_lru().map(|(k, v)| (*k, *v)), Some((k, v)));
+            assert_eq!(cache.peek_mru().map(|(k, v)| (*k, *v)), Some((k, v)));
+            let all: Vec<(u16, u32)> = cache.iter().map(|(k, v)| (*k, *v)).collect();
+            assert_eq!(all, vec![(k, v)]);
+        }
+    }
+
+    /// Property 6: `resize` to a smaller capacity evicts LRU entries down to
+    /// the new capacity, keeping exactly the most-recently-used prefix;
+    /// `resize` to a larger capacity keeps everything.
+    #[hegel::test]
+    fn test_resize_evicts_lru_down_to_new_cap(tc: hegel::TestCase) {
+        let keys: Vec<u16> = tc.draw(
+            generators::vecs(generators::integers::<u16>())
+                .min_size(1)
+                .max_size(64)
+                .unique(true),
+        );
+        let mut cache = build_cache_from_keys(&keys, keys.len());
+        let new_cap = tc.draw(
+            generators::integers::<usize>()
+                .min_value(1)
+                .max_value(keys.len() * 2),
+        );
+
+        let before: Vec<(u16, u32)> = cache.iter().map(|(k, v)| (*k, *v)).collect();
+        cache.resize(NonZeroUsize::new(new_cap).unwrap());
+
+        assert_eq!(cache.cap().get(), new_cap);
+        let after: Vec<(u16, u32)> = cache.iter().map(|(k, v)| (*k, *v)).collect();
+        let keep = core::cmp::min(new_cap, before.len());
+        assert_eq!(
+            &after[..],
+            &before[..keep],
+            "resize must keep exactly the {} most-recently-used entries",
+            keep
+        );
+    }
+
+    /// Property 7: repeatedly calling `pop_lru` drains the cache in exactly
+    /// the reverse of `iter()`'s MRU->LRU order (sibling-API consistency),
+    /// even after gets have shuffled the recency order.
+    #[hegel::test]
+    fn test_pop_lru_drains_in_reverse_iter_order(tc: hegel::TestCase) {
+        // Draw the size separately so large caches (deep lists) are reachable.
+        let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(200));
+        let keys: Vec<u16> = tc.draw(
+            generators::vecs(generators::integers::<u16>())
+                .min_size(n)
+                .unique(true),
+        );
+        let mut cache = build_cache_from_keys(&keys, keys.len());
+
+        // Shuffle the recency order with some gets.
+        let touches: Vec<usize> = tc.draw(
+            generators::vecs(generators::integers::<usize>().max_value(keys.len() - 1))
+                .max_size(16),
+        );
+        for &i in &touches {
+            cache.get(&keys[i]);
+        }
+
+        let snapshot: Vec<(u16, u32)> = cache.iter().map(|(k, v)| (*k, *v)).collect();
+        let mut drained = Vec::new();
+        while let Some(entry) = cache.pop_lru() {
+            drained.push(entry);
+        }
+        assert!(cache.is_empty());
+        assert_eq!(cache.len(), 0);
+
+        let expected: Vec<(u16, u32)> = snapshot.into_iter().rev().collect();
+        assert_eq!(
+            drained, expected,
+            "pop_lru must drain in reverse of iter() order"
+        );
+    }
 }
 
 /// Doctests for what should *not* compile
