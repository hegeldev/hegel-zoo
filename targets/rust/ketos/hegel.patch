+//! Property-based tests for the ketos interpreter, using hegel (`hegeltest`).
+//!
+//! These exercise the public interpreter pipeline (lex -> parse -> compile ->
+//! execute) as a whole. See HEGEL_REPORT.md for the findings, in particular
+//! the deep-nesting stack-overflow bug pinned by
+//! `deep_nesting_default_overflows_KNOWN_BUG` (ignored, process-aborting).
+
+extern crate ketos;
+
+use ketos::{Builder, Interpreter, RestrictConfig};
+use ketos::integer::Integer;
+
+use hegel::generators;
+
+// ---------------------------------------------------------------------------
+// 1. Robustness: parse + eval of arbitrary text never panics.
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn parse_eval_arbitrary_text_no_panic(tc: hegel::TestCase) {
+    // Any string at all: the interpreter must return Ok or Err, never panic
+    // or abort. (Deep nesting is excluded structurally: text() does not
+    // produce hundreds of balanced parens. The deep-nesting overflow is
+    // pinned separately by deep_nesting_default_overflows_KNOWN_BUG.)
+    let src = tc.draw(generators::text().max_size(200));
+    let interp = Interpreter::new();
+    let _ = interp.run_code(&src, None);
+}
+
+// ---------------------------------------------------------------------------
+// 2. Robustness: Lisp-shaped s-expression "soup" never panics.
+// ---------------------------------------------------------------------------
+
+/// A vocabulary of tokens biased toward real Lisp shapes, so the generated
+/// soup reaches the parser/compiler instead of failing at the lexer.
+const TOKENS: &[&str] = &[
+    "(", ")", "'", "`", ",", ",@", "+", "-", "*", "/", "//", "mod",
+    "define", "lambda", "if", "let", "const", "macro", "struct", "do",
+    "1", "0", "-1", "2.5", "1/3", "foo", "bar", "x", "true", "false", "()",
+    "\"s\"", ":kw", "#t", "#f", "#'a'", "[1 2]", ".", "nil",
+];
+
+#[hegel::test]
+fn parse_eval_sexpr_soup_no_panic(tc: hegel::TestCase) {
+    // Bounded token count keeps nesting well below the ~350-deep threshold at
+    // which the default interpreter overflows the stack (see KNOWN_BUG test);
+    // this bound protects the test process, not any contract of ketos.
+    let n = tc.draw(generators::integers::<usize>().min_value(0).max_value(60));
+    let mut parts: Vec<&str> = Vec::with_capacity(n);
+    for _ in 0..n {
+        parts.push(tc.draw(generators::sampled_from(TOKENS.to_vec())));
+    }
+    let src = parts.join(" ");
+    let interp = Interpreter::new();
+    let _ = interp.run_code(&src, None);
+}
+
+// ---------------------------------------------------------------------------
+// 3. Restriction: with a syntax-nesting limit, deep nesting is rejected
+//    safely (an Err, never a panic/overflow), at any depth.
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn deep_nesting_with_restrict_is_rejected(tc: hegel::TestCase) {
+    // Sweep depth upward, including far past the unguarded overflow threshold.
+    let depth = tc.draw(generators::integers::<usize>().min_value(33).max_value(50_000));
+    let src = format!("{}{}", "(".repeat(depth), ")".repeat(depth));
+
+    let interp = Builder::new()
+        .restrict(RestrictConfig {
+            max_syntax_nesting: 32,
+            ..RestrictConfig::permissive()
+        })
+        .finish();
+
+    // Must be an error (nesting exceeds the limit), and must not overflow.
+    let r = interp.run_code(&src, None);
+    assert!(r.is_err(), "expected error for depth {}, got Ok", depth);
+}
+
+// ---------------------------------------------------------------------------
+// 4. KNOWN BUG (process-aborting): with the DEFAULT (permissive) interpreter,
+//    deeply nested input overflows the stack and aborts the process.
+//    Parsing itself is iterative and succeeds, but recursively dropping /
+//    compiling the resulting deeply nested Value overflows the stack.
+//    Ignored so it cannot take down the rest of the suite.
+// ---------------------------------------------------------------------------
+
+#[test]
+#[ignore = "KNOWN BUG: deep nesting aborts (stack overflow) with the default interpreter; see HEGEL_REPORT.md"]
+#[allow(non_snake_case)]
+fn deep_nesting_default_overflows_KNOWN_BUG() {
+    // Observed to abort around depth ~350 on a test thread (via run_code /
+    // recursive compile), and via recursive Drop of the parsed Value at higher
+    // depths even when only parsing. A large depth guarantees the abort.
+    let depth = 100_000usize;
+    let src = format!("{}{}", "(".repeat(depth), ")".repeat(depth));
+    let interp = Interpreter::new(); // RestrictConfig::permissive(): no nesting limit
+    let _ = interp.run_code(&src, None);
+}
+
+// ---------------------------------------------------------------------------
+// 5. Arithmetic differential: integer + - * agree with an i128 oracle.
+// ---------------------------------------------------------------------------
+
+/// Build an integer arithmetic expression and its exact i128 value.
+/// Leaves are drawn from the full i16 range (includes MIN/MAX/0). Depth <= 3
+/// with i16 leaves keeps every intermediate within i128; on the rare overflow
+/// (e.g. repeated multiplication) we reject the case rather than compare.
+fn arith_expr(tc: &hegel::TestCase, depth: u32) -> (String, i128) {
+    let make_leaf = depth == 0 || tc.draw(generators::booleans());
+    if make_leaf {
+        let v = tc.draw(generators::integers::<i16>()) as i128;
+        return (v.to_string(), v);
+    }
+    let op = tc.draw(generators::sampled_from(vec!["+", "-", "*"]));
+    let (ls, lv) = arith_expr(tc, depth - 1);
+    let (rs, rv) = arith_expr(tc, depth - 1);
+    let checked = match op {
+        "+" => lv.checked_add(rv),
+        "-" => lv.checked_sub(rv),
+        "*" => lv.checked_mul(rv),
+        _ => unreachable!(),
+    };
+    match checked {
+        Some(res) => (format!("({} {} {})", op, ls, rs), res),
+        // i128 oracle overflowed; ketos uses bignum so it would not. Skip:
+        // this case is outside what the i128 oracle can represent.
+        None => tc.reject(),
+    }
+}
+
+#[hegel::test]
+fn integer_arithmetic_matches_i128_oracle(tc: hegel::TestCase) {
+    let depth = tc.draw(generators::integers::<u32>().min_value(0).max_value(3));
+    let (src, expected) = arith_expr(&tc, depth);
+    tc.note(&format!("src = {}", src));
+
+    let interp = Interpreter::new();
+    let v = interp.run_single_expr(&src, None)
+        .unwrap_or_else(|e| panic!("eval of `{}` failed: {}", src, interp.format_error(&e)));
+
+    let got = interp.format_value(&v);
+    assert_eq!(got, expected.to_string(),
+        "ketos evaluated `{}` to {} but oracle says {}", src, got, expected);
+}
+
+// ---------------------------------------------------------------------------
+// 6. Division / remainder by zero is an error, never a panic.
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn division_by_zero_is_error(tc: hegel::TestCase) {
+    let a = tc.draw(generators::integers::<i64>());
+    let op = tc.draw(generators::sampled_from(vec!["/", "//", "mod"]));
+    let src = format!("({} {} 0)", op, a);
+    let interp = Interpreter::new();
+    let r = interp.run_single_expr(&src, None);
+    assert!(r.is_err(), "expected error for `{}`, got {:?}", src,
+        r.ok().map(|v| interp.format_value(&v)));
+}
+
+// ---------------------------------------------------------------------------
+// 7. Ratio exactness: (a/b) * (b/a) == 1 for nonzero a, b.
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn ratio_reciprocal_identity(tc: hegel::TestCase) {
+    let a = tc.draw(generators::integers::<i64>());
+    let b = tc.draw(generators::integers::<i64>());
+    tc.assume(a != 0 && b != 0);
+    // Assert numeric equality via ketos's own `=`: the product is exactly one.
+    // (ketos does not demote a 1/1 ratio to the integer 1, so we compare
+    // numerically rather than on the printed form.)
+    let src = format!("(= (* (/ {a} {b}) (/ {b} {a})) 1)", a = a, b = b);
+    let interp = Interpreter::new();
+    let v = interp.run_single_expr(&src, None)
+        .unwrap_or_else(|e| panic!("eval of `{}` failed: {}", src, interp.format_error(&e)));
+    assert_eq!(interp.format_value(&v), "true",
+        "expected (a/b)*(b/a) == 1 for a={}, b={}", a, b);
+}
+
+// ---------------------------------------------------------------------------
+// 8. Reader round-trip: format_value(v) re-reads to a structurally identical
+//    value, for values in the printable literal subset.
+// ---------------------------------------------------------------------------
+
+fn value_gen(tc: &hegel::TestCase, depth: u32) -> ketos::Value {
+    use ketos::Value;
+    // Leaf vs list.
+    let leaf = depth == 0 || tc.draw(generators::booleans());
+    if leaf {
+        let choice = tc.draw(generators::integers::<u8>().min_value(0).max_value(4));
+        match choice {
+            0 => Value::Bool(tc.draw(generators::booleans())),
+            1 => Value::Integer(Integer::from_i64(tc.draw(generators::integers::<i64>()))),
+            2 => {
+                // A char in the ASCII printable range (round-trippable literal).
+                let c = tc.draw(generators::integers::<u32>().min_value(0x21).max_value(0x7e));
+                Value::Char(char::from_u32(c).unwrap())
+            }
+            3 => Value::Unit,
+            _ => {
+                let s = tc.draw(generators::text().max_size(12));
+                Value::String(s.into())
+            }
+        }
+    } else {
+        let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(5));
+        let mut items = Vec::with_capacity(n);
+        for _ in 0..n {
+            items.push(value_gen(tc, depth - 1));
+        }
+        Value::List(items.into())
+    }
+}
+
+#[hegel::test]
+fn printer_reader_roundtrip(tc: hegel::TestCase) {
+    let depth = tc.draw(generators::integers::<u32>().min_value(0).max_value(3));
+    let v = value_gen(&tc, depth);
+
+    let interp = Interpreter::new();
+    let printed = interp.format_value(&v);
+    tc.note(&format!("printed = {}", printed));
+
+    let reparsed = interp.parse_single_expr(&printed, None)
+        .unwrap_or_else(|e| panic!(
+            "re-parsing printed form `{}` failed: {}", printed, interp.format_error(&e)));
+
+    assert!(v.is_identical(&reparsed),
+        "round-trip mismatch: {:?} printed as `{}` re-read as {:?}",
+        v, printed, reparsed);
+}
+
+// ---------------------------------------------------------------------------
+// 9. Restriction: a call-stack limit bounds unbounded recursion with a
+//    CallStackExceeded error rather than a native stack overflow.
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn restrict_call_stack_bounds_recursion(tc: hegel::TestCase) {
+    let limit = tc.draw(generators::integers::<usize>().min_value(4).max_value(512));
+    let interp = Builder::new()
+        .restrict(RestrictConfig {
+            call_stack_size: limit,
+            ..RestrictConfig::permissive()
+        })
+        .finish();
+
+    // Mutually recursive non-terminating definitions.
+    let src = "
+        (define (foo) (bar))
+        (define (bar) (foo))
+        (foo)
+    ";
+    let r = interp.run_code(src, None);
+    // Must terminate with an error, not overflow the native stack.
+    assert!(r.is_err(), "expected recursion to be bounded at limit {}", limit);
+}
