+#[cfg(test)]
+#[cfg(feature = "alloc")]
+mod hegel_props {
+    //! Property-based tests (hegel) for the segwit address API.
+
+    use core::convert::TryFrom; // Edition 2018: not in the prelude.
+
+    use hegel::generators;
+
+    use super::*;
+    use crate::primitives::decode::UncheckedHrpstring;
+    use crate::{Bech32, Bech32m};
+
+    /// Draws a valid HRP string per BIP-173 with the given length bounds.
+    #[hegel::composite]
+    fn hrp_string(tc: &hegel::TestCase, min_len: usize, max_len: usize) -> String {
+        let len = tc.draw(generators::integers::<usize>().min_value(min_len).max_value(max_len));
+        let uppercase = tc.draw(generators::booleans());
+        let mut s = String::with_capacity(len);
+        for _ in 0..len {
+            let b = tc.draw(generators::integers::<u8>().min_value(33).max_value(126));
+            let c = if uppercase {
+                (b as char).to_ascii_uppercase()
+            } else {
+                (b as char).to_ascii_lowercase()
+            };
+            s.push(c);
+        }
+        s
+    }
+
+    /// Draws a valid witness version (0..=16) and a program length valid for it
+    /// per BIP-141/BIP-173: v0 requires 20 or 32 bytes, other versions 2..=40 bytes.
+    fn draw_valid_version_and_program(tc: &hegel::TestCase) -> (Fe32, Vec<u8>) {
+        let v_idx = tc.draw(generators::integers::<u8>().max_value(16));
+        let version = Fe32::try_from(v_idx).expect("0..=16 are valid field elements");
+        let plen = if v_idx == 0 {
+            if tc.draw(generators::booleans()) {
+                20
+            } else {
+                32
+            }
+        } else {
+            tc.draw(generators::integers::<usize>().min_value(2).max_value(40))
+        };
+        let program: Vec<u8> = tc.draw(generators::binary().min_size(plen).max_size(plen));
+        (version, program)
+    }
+
+    /// Segwit roundtrip: encode a valid (hrp, version, program) triple, decode it back and
+    /// recover all three exactly; the address respects the 90-character limit.
+    #[hegel::test]
+    fn prop_segwit_encode_decode_roundtrip(tc: hegel::TestCase) {
+        let (version, program) = draw_valid_version_and_program(&tc);
+        // hrp + 1 (separator) + 1 (version) + ceil(8*plen/5) + 6 (checksum) <= 90.
+        let fe_len = (program.len() * 8 + 4) / 5;
+        let max_hrp = 90 - 1 - 1 - fe_len - 6;
+        let hrp_str = tc.draw(hrp_string(1, max_hrp));
+        let hrp = Hrp::parse(&hrp_str).expect("valid hrp");
+
+        let addr = encode(hrp, version, &program).expect("valid segwit inputs must encode");
+        assert!(addr.len() <= MAX_STRING_LENGTH);
+        assert!(addr.bytes().all(|b| !b.is_ascii_uppercase()));
+
+        let (got_hrp, got_version, got_program) = decode(&addr).expect("roundtrip decode");
+        assert_eq!(got_hrp, hrp);
+        assert_eq!(got_version, version);
+        assert_eq!(got_program, program);
+    }
+
+    /// `segwit::encode` accepts exactly the BIP-173/BIP-350 valid inputs: witness version
+    /// 0..=16 (guaranteed by construction), program length in 2..=40 (v0: exactly 20 or 32),
+    /// and total encoded length <= 90. The oracle re-states the spec rules independently.
+    #[hegel::test]
+    fn prop_segwit_encode_validity_matches_spec(tc: hegel::TestCase) {
+        let v_idx = tc.draw(generators::integers::<u8>().max_value(16));
+        let version = Fe32::try_from(v_idx).expect("valid fe");
+        let plen = tc.draw(generators::integers::<usize>().max_value(60));
+        let byte = tc.draw(generators::integers::<u8>());
+        let program = vec![byte; plen];
+        let hrp_str = tc.draw(hrp_string(1, 83));
+        let hrp = Hrp::parse(&hrp_str).expect("valid hrp");
+
+        // Oracle transcribed from BIP-173/BIP-350.
+        let length_valid = plen >= 2 && plen <= 40 && !(v_idx == 0 && plen != 20 && plen != 32);
+        let total = hrp.len() + 1 + 1 + (plen * 8 + 4) / 5 + 6;
+        let expect_ok = length_valid && total <= MAX_STRING_LENGTH;
+
+        match encode(hrp, version, &program) {
+            Ok(addr) => {
+                assert!(
+                    expect_ok,
+                    "encode accepted spec-invalid input: v={} plen={} total={}",
+                    v_idx, plen, total
+                );
+                assert_eq!(addr.len(), total);
+            }
+            Err(_) => {
+                assert!(
+                    !expect_ok,
+                    "encode rejected spec-valid input: v={} plen={} total={}",
+                    v_idx, plen, total
+                );
+            }
+        }
+    }
+
+    /// The 90-character limit is enforced on the decode side too: a string with a perfectly
+    /// valid checksum that is longer than 90 characters must be rejected by `segwit::decode`.
+    #[hegel::test]
+    fn prop_segwit_decode_rejects_over_90_chars(tc: hegel::TestCase) {
+        let (version, program) = draw_valid_version_and_program(&tc);
+        let fe_len = (program.len() * 8 + 4) / 5;
+        // Choose the HRP length so hrp + 8 + fe_len >= 91 i.e. the string exceeds the limit.
+        let min_hrp = (91_usize).saturating_sub(1 + 1 + fe_len + 6).max(1);
+        let hrp_str = tc.draw(hrp_string(min_hrp, 83));
+        let hrp = Hrp::parse(&hrp_str).expect("valid hrp");
+
+        let mut addr = String::new();
+        encode_lower_to_fmt_unchecked(&mut addr, hrp, version, &program)
+            .expect("writing to String cannot fail");
+        assert!(addr.len() > MAX_STRING_LENGTH);
+
+        // Guard-liveness: the string is only invalid because of its length — its checksum
+        // is genuinely valid for the algorithm implied by the witness version.
+        let unchecked = UncheckedHrpstring::new(&addr).expect("well formed");
+        if version == VERSION_0 {
+            assert!(unchecked.has_valid_checksum::<Bech32>());
+        } else {
+            assert!(unchecked.has_valid_checksum::<Bech32m>());
+        }
+
+        assert!(
+            decode(&addr).is_err(),
+            "segwit::decode accepted a {} character string: {}",
+            addr.len(),
+            addr
+        );
+    }
