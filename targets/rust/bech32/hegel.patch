+#[cfg(test)]
+#[cfg(feature = "alloc")]
+mod hegel_props {
+    //! Property-based tests (hegel) for the top level encode/decode API.
+
+    use hegel::generators::{self, Generator};
+
+    use crate::primitives::decode::{CheckedHrpstring, SegwitHrpstring, UncheckedHrpstring};
+    use crate::{
+        decode, encode, encode_upper, encoded_length, Bech32, Bech32m, DecodeError, EncodeError,
+        Fe32, Hrp,
+    };
+
+    /// The bech32 data-part character set in value order (BIP-173).
+    const CHARSET: &[u8; 32] = b"qpzry9x8gf2tvdw0s3jn54khce6mua7l";
+
+    /// Draws a valid HRP string per BIP-173: `min_len..=max_len` characters, each in
+    /// ASCII 33..=126, never mixed-case (alphabetic characters folded to one drawn case).
+    #[hegel::composite]
+    fn hrp_string(tc: &hegel::TestCase, min_len: usize, max_len: usize) -> String {
+        let len = tc.draw(generators::integers::<usize>().min_value(min_len).max_value(max_len));
+        let uppercase = tc.draw(generators::booleans());
+        let mut s = String::with_capacity(len);
+        for _ in 0..len {
+            let b = tc.draw(generators::integers::<u8>().min_value(33).max_value(126));
+            let c = if uppercase {
+                (b as char).to_ascii_uppercase()
+            } else {
+                (b as char).to_ascii_lowercase()
+            };
+            s.push(c);
+        }
+        s
+    }
+
+    fn encode_variant(bech32m: bool, hrp: Hrp, data: &[u8]) -> Result<String, EncodeError> {
+        if bech32m {
+            encode::<Bech32m>(hrp, data)
+        } else {
+            encode::<Bech32>(hrp, data)
+        }
+    }
+
+    fn checked_parse_is_ok(bech32m: bool, s: &str) -> bool {
+        if bech32m {
+            CheckedHrpstring::new::<Bech32m>(s).is_ok()
+        } else {
+            CheckedHrpstring::new::<Bech32>(s).is_ok()
+        }
+    }
+
+    /// The crown roundtrip: for any valid HRP and any data, `encode` (either checksum
+    /// algorithm) followed by `decode` recovers the HRP and the data exactly.
+    #[hegel::test]
+    fn prop_encode_decode_roundtrip(tc: hegel::TestCase) {
+        let hrp_str = tc.draw(hrp_string(1, 83));
+        let hrp = Hrp::parse(&hrp_str).expect("generator produces valid HRPs");
+        // 83 + 1 + ceil(8*500/5) + 6 = 890 <= 1023 so encoding always fits the code length.
+        let n = tc.draw(generators::integers::<usize>().max_value(500));
+        let data: Vec<u8> = tc.draw(generators::binary().min_size(n).max_size(n));
+        let bech32m = tc.draw(generators::booleans());
+
+        let s = encode_variant(bech32m, hrp, &data).expect("length fits code length");
+
+        // Encoded strings are documented to be lowercase.
+        assert!(
+            s.bytes().all(|b| b.is_ascii() && !b.is_ascii_uppercase()),
+            "encode produced non-lowercase output: {}",
+            s
+        );
+
+        let (got_hrp, got_data) = decode(&s).expect("decode of freshly encoded string");
+        assert_eq!(got_hrp, hrp, "HRP not recovered");
+        assert_eq!(got_hrp.to_lowercase(), hrp_str.to_lowercase());
+        assert_eq!(got_data, data, "data not recovered");
+
+        // The checksum-specific constructor agrees.
+        assert!(checked_parse_is_ok(bech32m, &s));
+    }
+
+    /// Case consistency: `encode_upper` is exactly the uppercase of `encode_lower`, and both
+    /// decode to the same HRP and data (bech32 is case-insensitive for non-mixed input).
+    #[hegel::test]
+    fn prop_upper_and_lower_encodings_agree(tc: hegel::TestCase) {
+        let hrp_str = tc.draw(hrp_string(1, 83));
+        let hrp = Hrp::parse(&hrp_str).expect("valid hrp");
+        let n = tc.draw(generators::integers::<usize>().max_value(100));
+        let data: Vec<u8> = tc.draw(generators::binary().min_size(n).max_size(n));
+        let bech32m = tc.draw(generators::booleans());
+
+        let lower = encode_variant(bech32m, hrp, &data).expect("fits");
+        let upper = if bech32m {
+            encode_upper::<Bech32m>(hrp, &data).expect("fits")
+        } else {
+            encode_upper::<Bech32>(hrp, &data).expect("fits")
+        };
+
+        assert_eq!(upper, lower.to_uppercase());
+
+        let (hrp_l, data_l) = decode(&lower).expect("lowercase decodes");
+        let (hrp_u, data_u) = decode(&upper).expect("uppercase decodes");
+        assert_eq!(hrp_l, hrp_u); // `Hrp` equality is case-insensitive by design.
+        assert_eq!(data_l, data_u);
+    }
+
+    /// The whole point of the checksum: substituting any single data-part character with any
+    /// other charset character must be rejected, at every position (exhaustively probed).
+    #[hegel::test]
+    fn prop_decode_rejects_every_single_char_substitution_in_data_part(tc: hegel::TestCase) {
+        let hrp_str = tc.draw(hrp_string(1, 83));
+        let hrp = Hrp::parse(&hrp_str).expect("valid hrp");
+        // Keep data small so the exhaustive position x substitution loop stays fast.
+        let n = tc.draw(generators::integers::<usize>().max_value(30));
+        let data: Vec<u8> = tc.draw(generators::binary().min_size(n).max_size(n));
+        let bech32m = tc.draw(generators::booleans());
+
+        let s = encode_variant(bech32m, hrp, &data).expect("fits");
+        // The data part contains no '1', so the last '1' is the separator.
+        let sep = s.rfind('1').expect("encoded string has separator");
+        let bytes = s.as_bytes();
+
+        let mut probed = 0_usize;
+        for i in (sep + 1)..bytes.len() {
+            for &c in CHARSET.iter() {
+                if c == bytes[i] {
+                    continue;
+                }
+                let mut mutated = bytes.to_vec();
+                mutated[i] = c;
+                let m = String::from_utf8(mutated).expect("still ASCII");
+                // Neither the used algorithm nor the permissive top level decode
+                // (which accepts either checksum) may accept a 1-char substitution.
+                assert!(
+                    !checked_parse_is_ok(bech32m, &m),
+                    "single-char substitution accepted by checksum: {} -> {}",
+                    s,
+                    m
+                );
+                assert!(
+                    decode(&m).is_err(),
+                    "single-char substitution accepted by decode: {} -> {}",
+                    s,
+                    m
+                );
+                probed += 1;
+            }
+        }
+        // Liveness: at minimum all 6 checksum characters were probed against 31 substitutes.
+        assert!(probed >= 6 * 31);
+    }
+
+    /// The checksum also covers the HRP: corrupting any single HRP character (with another
+    /// valid, non-'1', non-uppercase HRP character) must be rejected, at every position.
+    #[hegel::test]
+    fn prop_decode_rejects_every_single_char_substitution_in_hrp(tc: hegel::TestCase) {
+        let hrp_str = tc.draw(hrp_string(1, 83));
+        let hrp = Hrp::parse(&hrp_str).expect("valid hrp");
+        let n = tc.draw(generators::integers::<usize>().max_value(30));
+        let data: Vec<u8> = tc.draw(generators::binary().min_size(n).max_size(n));
+        let bech32m = tc.draw(generators::booleans());
+
+        let s = encode_variant(bech32m, hrp, &data).expect("fits");
+        let sep = s.rfind('1').expect("separator");
+        let bytes = s.as_bytes();
+
+        // Replacement set: valid HRP characters that keep the string well formed, i.e.
+        // ASCII 33..=126 except '1' (would move the separator) and except uppercase
+        // (would introduce a mixed-case rejection unrelated to the checksum).
+        let replacement = {
+            let b = tc.draw(generators::integers::<u8>().min_value(33).max_value(126));
+            (b as char).to_ascii_lowercase() as u8
+        };
+        if replacement == b'1' {
+            tc.reject();
+        }
+
+        let mut probed = 0_usize;
+        for i in 0..sep {
+            if bytes[i] == replacement {
+                continue;
+            }
+            let mut mutated = bytes.to_vec();
+            mutated[i] = replacement;
+            let m = String::from_utf8(mutated).expect("still ASCII");
+            assert!(
+                decode(&m).is_err(),
+                "single-char HRP corruption accepted: {} -> {}",
+                s,
+                m
+            );
+            probed += 1;
+        }
+        // Liveness: unless the whole HRP already equals the replacement char at every
+        // position (excluded per position above), we probed something.
+        tc.assume(probed > 0);
+    }
+
+    /// BIP-173: mixed-case strings must be rejected even when the checksum is otherwise valid.
+    #[hegel::test]
+    fn prop_decode_rejects_mixed_case(tc: hegel::TestCase) {
+        let hrp_str = tc.draw(hrp_string(1, 83));
+        let hrp = Hrp::parse(&hrp_str).expect("valid hrp");
+        let n = tc.draw(generators::integers::<usize>().max_value(100));
+        let data: Vec<u8> = tc.draw(generators::binary().min_size(n).max_size(n));
+        let bech32m = tc.draw(generators::booleans());
+
+        let s = encode_variant(bech32m, hrp, &data).expect("fits");
+        let letters: Vec<usize> = s
+            .bytes()
+            .enumerate()
+            .filter(|(_, b)| b.is_ascii_alphabetic())
+            .map(|(i, _)| i)
+            .collect();
+        // Need at least two letters to make a mixed-case string. The 6 checksum
+        // characters make an all-digit string very rare; reject those cases.
+        tc.assume(letters.len() >= 2);
+
+        let mut flags: Vec<bool> = Vec::with_capacity(letters.len());
+        for _ in 0..letters.len() {
+            flags.push(tc.draw(generators::booleans()));
+        }
+        // Force genuine mixed case: at least one uppercased and one lowercase letter.
+        if flags.iter().all(|&f| f) {
+            let last = flags.len() - 1;
+            flags[last] = false;
+        }
+        if flags.iter().all(|&f| !f) {
+            flags[0] = true;
+        }
+
+        let mut bytes = s.clone().into_bytes();
+        for (&pos, &up) in letters.iter().zip(flags.iter()) {
+            if up {
+                bytes[pos] = bytes[pos].to_ascii_uppercase();
+            }
+        }
+        let mixed = String::from_utf8(bytes).expect("still ASCII");
+        assert_ne!(mixed, s);
+
+        assert!(decode(&mixed).is_err(), "mixed-case string accepted: {}", mixed);
+        assert!(UncheckedHrpstring::new(&mixed).is_err());
+    }
+
+    /// Characters outside the 32-character charset (e.g. the excluded '1', 'b', 'i', 'o'
+    /// confusion characters, punctuation) in the data part are rejected with a parse error.
+    #[hegel::test]
+    fn prop_decode_rejects_invalid_data_char(tc: hegel::TestCase) {
+        // ASCII 33..=126 characters that are not valid bech32 data characters. We exclude
+        // '1' (moves the separator) and uppercase characters (charset letters have valid
+        // uppercase forms and invalid ones would conflate with mixed-case detection).
+        let invalid: Vec<u8> = (33_u8..=126)
+            .filter(|&b| {
+                b != b'1' && !b.is_ascii_uppercase() && Fe32::from_char(b as char).is_err()
+            })
+            .collect();
+        assert!(invalid.contains(&b'b') && invalid.contains(&b'i') && invalid.contains(&b'o'));
+
+        let hrp_str = tc.draw(hrp_string(1, 83));
+        let hrp = Hrp::parse(&hrp_str).expect("valid hrp");
+        let n = tc.draw(generators::integers::<usize>().max_value(100));
+        let data: Vec<u8> = tc.draw(generators::binary().min_size(n).max_size(n));
+        let bech32m = tc.draw(generators::booleans());
+
+        let s = encode_variant(bech32m, hrp, &data).expect("fits");
+        let sep = s.rfind('1').expect("separator");
+        let data_part_len = s.len() - sep - 1; // >= 6 (checksum)
+
+        let pos = sep + 1 + tc.draw(generators::integers::<usize>().max_value(data_part_len - 1));
+        let bad = tc.draw(generators::sampled_from(invalid));
+
+        let mut bytes = s.into_bytes();
+        bytes[pos] = bad;
+        let m = String::from_utf8(bytes).expect("still ASCII");
+
+        match decode(&m) {
+            Err(DecodeError::Parse(_)) => {}
+            other => panic!("expected parse error for invalid char {:?}, got {:?}", bad as char, other),
+        }
+    }
+
+    /// A string with a valid Bech32 checksum is never a valid Bech32m string and vice versa
+    /// (the two algorithms differ only in target residue, so validity is mutually exclusive).
+    #[hegel::test]
+    fn prop_bech32_and_bech32m_are_mutually_exclusive(tc: hegel::TestCase) {
+        let hrp_str = tc.draw(hrp_string(1, 83));
+        let hrp = Hrp::parse(&hrp_str).expect("valid hrp");
+        let n = tc.draw(generators::integers::<usize>().max_value(100));
+        let data: Vec<u8> = tc.draw(generators::binary().min_size(n).max_size(n));
+
+        let s32 = encode::<Bech32>(hrp, &data).expect("fits");
+        let s32m = encode::<Bech32m>(hrp, &data).expect("fits");
+
+        assert!(CheckedHrpstring::new::<Bech32>(&s32).is_ok());
+        assert!(
+            CheckedHrpstring::new::<Bech32m>(&s32).is_err(),
+            "bech32-checksummed string accepted as bech32m: {}",
+            s32
+        );
+        assert!(CheckedHrpstring::new::<Bech32m>(&s32m).is_ok());
+        assert!(
+            CheckedHrpstring::new::<Bech32>(&s32m).is_err(),
+            "bech32m-checksummed string accepted as bech32: {}",
+            s32m
+        );
+    }
+
+    /// Length limit: the crate enforces `Checksum::CODE_LENGTH` (1023 for Bech32/Bech32m, not
+    /// the segwit 90-char limit). `encode` succeeds iff the encoded length (computed with an
+    /// independently transcribed formula) is <= 1023, and on success the string has exactly
+    /// that length and `encoded_length` agrees.
+    #[hegel::test]
+    fn prop_encode_enforces_code_length_limit(tc: hegel::TestCase) {
+        let hrp_str = tc.draw(hrp_string(1, 83));
+        let hrp = Hrp::parse(&hrp_str).expect("valid hrp");
+
+        // Bias half the cases to land within a few bytes of the 1023 boundary.
+        let near_boundary = tc.draw(generators::booleans());
+        let n = if near_boundary {
+            // Solve hrp + 1 + ceil(8n/5) + 6 ~ 1023 for n, then wiggle.
+            let base = ((1023 - hrp.len() - 7) * 5) / 8;
+            let delta = tc.draw(generators::integers::<usize>().max_value(8));
+            base.saturating_sub(4) + delta
+        } else {
+            tc.draw(generators::integers::<usize>().max_value(700))
+        };
+        let byte = tc.draw(generators::integers::<u8>());
+        let data = vec![byte; n];
+
+        // Oracle transcribed from BIP-173: data part is ceil(8n/5) characters, plus the
+        // HRP, one separator and a 6 character checksum.
+        let fe_len = (n * 8 + 4) / 5;
+        let expected_len = hrp.len() + 1 + fe_len + 6;
+
+        match encode::<Bech32m>(hrp, &data) {
+            Ok(s) => {
+                assert!(expected_len <= 1023, "encode accepted overlong input: {}", expected_len);
+                assert_eq!(s.len(), expected_len);
+                assert_eq!(encoded_length::<Bech32m>(hrp, &data).expect("fits"), expected_len);
+                // The maximal-length strings still roundtrip.
+                let (h, d) = decode(&s).expect("roundtrip");
+                assert_eq!(h, hrp);
+                assert_eq!(d, data);
+            }
+            Err(EncodeError::TooLong(e)) => {
+                assert!(expected_len > 1023, "encode rejected fitting input: {}", expected_len);
+                assert_eq!(e.encoded_length, expected_len);
+                assert!(encoded_length::<Bech32m>(hrp, &data).is_err());
+            }
+            Err(e) => panic!("unexpected encode error: {:?}", e),
+        }
+    }
+
+    /// Draws bech32-flavored garbage: strings over the charset plus confusing characters
+    /// ('1' separators, uppercase, excluded letters) that stress parser edge paths harder
+    /// than uniform random text.
+    #[hegel::composite]
+    fn bech32_flavored_garbage(tc: &hegel::TestCase) -> String {
+        let alphabet: Vec<char> = "qpzry9x8gf2tvdw0s3jn54khce6mua7l1QPZRY9X8GF2TVDW0S3JN54KHCE6MUA7L1bio B!~\u{00e9}"
+            .chars()
+            .collect();
+        let len = tc.draw(generators::integers::<usize>().max_value(120));
+        let mut s = String::with_capacity(len);
+        for _ in 0..len {
+            s.push(tc.draw(generators::sampled_from(alphabet.clone())));
+        }
+        s
+    }
+
+    /// Robustness: no decoding entry point may panic on arbitrary input.
+    #[hegel::test]
+    fn prop_decode_arbitrary_input_never_panics(tc: hegel::TestCase) {
+        let s: String = tc.draw(hegel::one_of!(
+            generators::text().max_size(120).boxed(),
+            bech32_flavored_garbage().boxed(),
+        ));
+        drop(decode(&s));
+        drop(UncheckedHrpstring::new(&s));
+        drop(CheckedHrpstring::new::<Bech32>(&s));
+        drop(CheckedHrpstring::new::<Bech32m>(&s));
+        drop(SegwitHrpstring::new(&s));
+        drop(Hrp::parse(&s));
+    }
+}
