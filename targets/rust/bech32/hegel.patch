+#[cfg(test)]
+mod hegel_props {
+    //! Property-based tests (hegel) for HRP parsing/validation.
+
+    use hegel::generators::{self, Generator};
+
+    use super::*;
+
+    /// Draws a valid HRP string per BIP-173: `min_len..=max_len` characters, each in
+    /// ASCII 33..=126, never mixed-case (alphabetic characters folded to one drawn case).
+    #[hegel::composite]
+    fn hrp_string(tc: &hegel::TestCase, min_len: usize, max_len: usize) -> String {
+        let len = tc.draw(generators::integers::<usize>().min_value(min_len).max_value(max_len));
+        let uppercase = tc.draw(generators::booleans());
+        let mut s = String::with_capacity(len);
+        for _ in 0..len {
+            let b = tc.draw(generators::integers::<u8>().min_value(33).max_value(126));
+            let c = if uppercase {
+                (b as char).to_ascii_uppercase()
+            } else {
+                (b as char).to_ascii_lowercase()
+            };
+            s.push(c);
+        }
+        s
+    }
+
+    /// Every BIP-173-valid HRP (1..=83 chars of ASCII 33..=126, non-mixed-case) parses,
+    /// preserving content, length and case.
+    #[hegel::test]
+    fn prop_parse_accepts_valid_hrp_and_preserves_it(tc: hegel::TestCase) {
+        let s = tc.draw(hrp_string(1, 83));
+        let hrp = Hrp::parse(&s).expect("valid hrp must parse");
+        assert_eq!(hrp.as_str(), s, "content/case not preserved");
+        assert_eq!(hrp.len(), s.len());
+        assert_eq!(hrp.as_bytes(), s.as_bytes());
+        assert_eq!(hrp.to_lowercase(), s.to_lowercase());
+        // Display preserves case too.
+        assert_eq!(format!("{}", hrp), s);
+    }
+
+    /// `parse_display` is documented as semantically equivalent to `parse` — differential
+    /// test over arbitrary strings (both accepted content and all rejection classes).
+    #[hegel::test]
+    fn prop_parse_display_agrees_with_parse(tc: hegel::TestCase) {
+        let s: String = tc.draw(hegel::one_of!(
+            // Arbitrary unicode, mostly rejected.
+            generators::text().max_size(120).boxed(),
+            // Valid HRPs, always accepted.
+            hrp_string(1, 83).boxed(),
+            // Valid characters but too long, rejected for length.
+            hrp_string(84, 120).boxed(),
+        ));
+
+        let via_parse = Hrp::parse(&s);
+        let via_display = Hrp::parse_display(&s);
+
+        match (via_parse, via_display) {
+            (Ok(a), Ok(b)) => {
+                assert_eq!(a.as_str(), b.as_str());
+                assert_eq!(a, b);
+            }
+            (Err(a), Err(b)) => assert_eq!(a, b, "different errors for {:?}", s),
+            (a, b) => panic!("parse/parse_display disagree for {:?}: {:?} vs {:?}", s, a, b),
+        }
+    }
+
+    /// Characters outside ASCII 33..=126 (controls, space, DEL, non-ASCII) anywhere in an
+    /// otherwise valid HRP cause rejection.
+    #[hegel::test]
+    fn prop_parse_rejects_out_of_range_char(tc: hegel::TestCase) {
+        let mut s = tc.draw(hrp_string(1, 83));
+        let bad: char = tc.draw(hegel::one_of!(
+            // ASCII below 33 (controls and space) and DEL.
+            generators::integers::<u32>().max_value(32).boxed(),
+            generators::just(127_u32).boxed(),
+            // Non-ASCII code points.
+            generators::integers::<u32>().min_value(128).max_value(0x10FFFF).boxed(),
+        )
+        .map(|n| char::from_u32(n).unwrap_or('\u{FFFD}')));
+
+        // Insert at a drawn char boundary position.
+        let positions: Vec<usize> = (0..=s.len()).collect();
+        let pos = tc.draw(generators::sampled_from(positions));
+        s.insert(pos, bad);
+
+        assert!(Hrp::parse(&s).is_err(), "accepted out-of-range char {:?} in {:?}", bad, s);
+        assert!(Hrp::parse_display(&s).is_err());
+    }
+
+    /// HRPs longer than 83 characters are rejected with `Error::TooLong` reporting the length.
+    #[hegel::test]
+    fn prop_parse_rejects_too_long(tc: hegel::TestCase) {
+        let s = tc.draw(hrp_string(84, 300));
+        assert_eq!(Hrp::parse(&s), Err(Error::TooLong(s.len())));
+        assert_eq!(Hrp::parse_display(&s), Err(Error::TooLong(s.len())));
+    }
+
+    /// Mixed-case HRPs are rejected (BIP-173) even though each character is individually valid.
+    #[hegel::test]
+    fn prop_parse_rejects_mixed_case(tc: hegel::TestCase) {
+        // Base of valid non-alphabetic-agnostic chars; then force one lower and one upper letter.
+        let mut s = tc.draw(hrp_string(2, 83)).into_bytes();
+        let n = s.len();
+        let i = tc.draw(generators::integers::<usize>().max_value(n - 1));
+        let mut j = tc.draw(generators::integers::<usize>().max_value(n - 1));
+        if i == j {
+            j = (j + 1) % n;
+        }
+        let lower = tc.draw(generators::integers::<u8>().min_value(b'a').max_value(b'z'));
+        let upper = tc.draw(generators::integers::<u8>().min_value(b'A').max_value(b'Z'));
+        s[i] = lower;
+        s[j] = upper;
+        let s = String::from_utf8(s).expect("ASCII");
+
+        assert_eq!(Hrp::parse(&s), Err(Error::MixedCase));
+        assert_eq!(Hrp::parse_display(&s), Err(Error::MixedCase));
+    }
+}
