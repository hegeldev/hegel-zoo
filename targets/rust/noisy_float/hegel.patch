+#[hegel::test]
+fn serde_and_approx_forward_to_the_primitive(tc: hegel::TestCase) {
+    use approx::{AbsDiffEq, RelativeEq, UlpsEq};
+    let a = tc.draw(arb_finite());
+    let b = tc.draw(arb_finite());
+    let (ra, rb) = (r64(a), r64(b));
+    // serde: transparent, and invalid values are refused on the way in
+    let json = serde_json::to_string(&ra).unwrap();
+    assert_eq!(json, serde_json::to_string(&a).unwrap());
+    // (serde_json without `float_roundtrip` may parse a ULP off; compare with its own f64 parse)
+    let back: R64 = serde_json::from_str(&json).unwrap();
+    let prim: f64 = serde_json::from_str(&json).unwrap();
+    assert!(same(back.raw(), prim), "{json}: {back:?} vs {prim:?}");
+    // (serde_json refuses out-of-range literals itself, so the checker's refusal is exercised
+    // through a custom checker below)
+    assert!(serde_json::from_str::<N64>("null").is_err());
+    let ns: Vec<N64> = serde_json::from_str("[1.0, -2.5, 1e300]").unwrap();
+    assert_eq!(ns.iter().map(|n| n.raw()).collect::<Vec<_>>(), vec![1.0, -2.5, 1e300]);
+    // approx
+    let eps = tc.draw(generators::sampled_from(vec![0.0, 1e-12, 1e-6, 0.5, 100.0]));
+    let ulps = tc.draw(int!(0u32, 8));
+    assert_eq!(ra.abs_diff_eq(&rb, r64(eps)), a.abs_diff_eq(&b, eps), "{a:?} {b:?} {eps}");
+    assert_eq!(ra.relative_eq(&rb, r64(eps), r64(eps)), a.relative_eq(&b, eps, eps));
+    assert_eq!(ra.ulps_eq(&rb, r64(eps), ulps), a.ulps_eq(&b, eps, ulps));
+    assert_eq!(R64::default_epsilon().raw(), f64::default_epsilon());
+    assert_eq!(R64::default_max_relative().raw(), f64::default_max_relative());
+    assert_eq!(R64::default_max_ulps(), f64::default_max_ulps());
+    // a custom checker
+    struct Positive;
+    impl FloatChecker<f64> for Positive {
+        fn check(v: f64) -> bool {
+            v > 0.0
+        }
+        fn assert(v: f64) {
+            assert!(Self::check(v), "not positive");
+        }
+    }
+    type P64 = NoisyFloat<f64, Positive>;
+    assert_eq!(P64::try_new(a).is_some(), a > 0.0);
+    assert_eq!(serde_json::from_str::<P64>(&json).is_ok(), a > 0.0, "{json}: deserialisation goes through the checker");
+    assert_eq!(panics(|| P64::new(a)), a <= 0.0);
+    if a > 0.0 && b > 0.0 {
+        let sum = catch_unwind(AssertUnwindSafe(|| P64::new(a) + P64::new(b)));
+        assert_eq!(sum.is_ok(), a + b > 0.0, "{a} + {b}: the positive checker admits +∞");
+        assert_eq!(panics(|| -P64::new(a)), true);
+        assert_eq!(panics(|| P64::new(a) - P64::new(b)), a - b <= 0.0 || (a - b).is_nan(), "{a} - {b}");
+    }
+}
