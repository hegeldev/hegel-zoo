+#[hegel::test]
+fn constructors_admit_exactly_the_checked_values(tc: hegel::TestCase) {
+    let x = tc.draw(arb_f64());
+    let num = !x.is_nan();
+    let fin = x.is_finite();
+    assert_eq!(NumChecker::check(x), num);
+    assert_eq!(FiniteChecker::check(x), fin);
+    assert_eq!(N64::try_new(x).is_some(), num, "{x:?}");
+    assert_eq!(R64::try_new(x).is_some(), fin, "{x:?}");
+    assert_eq!(N64::try_borrowed(&x).is_some(), num);
+    assert_eq!(R64::try_borrowed(&x).is_some(), fin);
+    let mut m = x;
+    assert_eq!(R64::try_borrowed_mut(&mut m).is_some(), fin);
+    assert_eq!(N64::try_from(x).is_ok(), num);
+    assert_eq!(R64::try_from(x).is_ok(), fin);
+    assert_eq!(<R64 as NumCast>::from(x).is_some(), fin);
+    assert_eq!(<N64 as FromPrimitive>::from_f64(x).is_some(), num);
+    assert_eq!(<R32 as FromPrimitive>::from_f64(x).map(|r| r.raw()), if (x as f32).is_finite() { Some(x as f32) } else { None }, "{x:?}");
+    // the panicking constructors panic exactly on the invalid values
+    assert_eq!(panics(|| N64::new(x)), !num, "{x:?}");
+    assert_eq!(panics(|| R64::new(x)), !fin, "{x:?}");
+    assert_eq!(panics(|| n64(x)), !num);
+    assert_eq!(panics(|| r64(x)), !fin);
+    assert_eq!(panics(|| R64::borrowed(&x)), !fin);
+    assert_eq!(panics(|| N64::from_f64(x)), !num);
+    assert_eq!(panics(|| R32::from_f64(x)), !(x as f32).is_finite(), "{x:?}");
+    // accepted values are kept bit for bit
+    if let Some(n) = N64::try_new(x) {
+        assert!(same(n.raw(), x) && same(<f64 as From<N64>>::from(n), x) && same(*n.as_ref(), x) && same(*N64::borrowed(&x).as_ref(), x));
+        assert!(same(N64::new(x).raw(), x) && same(N64::from_f64(x).raw(), x));
+        assert_eq!(n, x, "PartialEq<f64>");
+        assert_eq!(n.partial_cmp(&x), Some(Ordering::Equal));
+        assert!(n == n && n <= n && n >= n && !(n < n));
+    }
+    if let Some(r) = R64::try_new(x) {
+        let n: N64 = r.into();
+        assert!(same(n.raw(), x));
+        assert!(same(R64::unchecked_new(x).const_raw(), x));
+        assert_eq!(format!("{r}"), format!("{x}"));
+        assert_eq!(format!("{r:?}"), format!("{x:?}"));
+        assert_eq!(format!("{r:e}"), format!("{x:e}"));
+        assert_eq!(format!("{r:E}"), format!("{x:E}"));
+        assert_eq!(format!("{r:.2}"), format!("{x:.2}"));
+        let parsed = <R64 as Num>::from_str_radix(&x.to_string(), 10).unwrap();
+        assert_eq!(parsed, r, "{x}");
+    }
+    // a NaN never equals or orders against a proxy
+    let one = r64(1.0);
+    assert_eq!(one == x, x == 1.0);
+    assert_eq!(one.partial_cmp(&x), 1f64.partial_cmp(&x));
+    assert_eq!(one < x, 1.0 < x);
+    assert_eq!(one >= x, 1.0 >= x);
+}
+
+#[hegel::test]
+fn ordering_equality_and_hashing_are_consistent(tc: hegel::TestCase) {
+    let a = tc.draw(arb_f64());
+    let b = tc.draw(arb_f64());
+    let (Some(na), Some(nb)) = (N64::try_new(a), N64::try_new(b)) else { return };
+    let expected = a.partial_cmp(&b).unwrap();
+    assert_eq!(na.cmp(&nb), expected, "{a:?} vs {b:?}");
+    assert_eq!(na.partial_cmp(&nb), Some(expected));
+    assert_eq!(na == nb, expected == Ordering::Equal);
+    assert_eq!((na < nb, na <= nb, na > nb, na >= nb), (a < b, a <= b, a > b, a >= b));
+    assert_eq!(nb.cmp(&na), expected.reverse());
+    if expected == Ordering::Equal {
+        assert_eq!(hash_of(&na), hash_of(&nb), "{a:?} vs {b:?}: equal values hash alike");
+    }
+    // `min`/`max` (the inherent ones resolve to `Ord`) and `Float::min/max` agree with the primitive
+    assert!(same(na.min(nb).raw(), if expected == Ordering::Greater { b } else { a }));
+    assert!(same(na.max(nb).raw(), if expected == Ordering::Greater { a } else { b }), "Ord::max keeps the second on ties");
+    assert!(same(Float::min(na, nb).raw(), a.min(b)), "{a:?} min {b:?}");
+    assert!(same(Float::max(na, nb).raw(), a.max(b)), "{a:?} max {b:?}");
+    // sorting a vector agrees with the primitive order; a set has one element per value
+    let xs: Vec<f64> = tc.draw(generators::vecs(arb_f64()).max_size(16));
+    let mut ns: Vec<N64> = xs.iter().filter_map(|x| N64::try_new(*x)).collect();
+    let mut model: Vec<f64> = xs.iter().copied().filter(|x| !x.is_nan()).collect();
+    ns.sort();
+    model.sort_by(|p, q| p.partial_cmp(q).unwrap());
+    assert!(ns.iter().zip(&model).all(|(n, m)| n.raw() == *m), "{ns:?} vs {model:?}");
+    let set: HashSet<N64> = ns.iter().copied().collect();
+    let mut classes = model.clone();
+    classes.dedup();
+    assert_eq!(set.len(), classes.len(), "{xs:?}");
+    assert_eq!(ns.iter().max().map(|n| n.raw()), model.last().copied());
+    assert_eq!(ns.iter().min().map(|n| n.raw()), model.first().copied());
+    // `f32`
+    let (p, q) = (tc.draw(arb_f32()), tc.draw(arb_f32()));
+    if let (Some(np), Some(nq)) = (N32::try_new(p), N32::try_new(q)) {
+        assert_eq!(np.cmp(&nq), p.partial_cmp(&q).unwrap());
+        if p == q {
+            assert_eq!(hash_of(&np), hash_of(&nq));
+        }
+        assert_eq!(<f64 as From<N32>>::from(np), p as f64);
+        assert_eq!(<f32 as From<N32>>::from(np), p);
+        assert_eq!(N64::from_f32(p).raw(), p as f64);
+    }
+}
