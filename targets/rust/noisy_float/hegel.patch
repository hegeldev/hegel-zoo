+#[hegel::test]
+fn arithmetic_equals_the_primitive_or_panics_on_an_invalid_result(tc: hegel::TestCase) {
+    let a = tc.draw(arb_finite());
+    let b = tc.draw(arb_finite());
+    let (ra, rb) = (r64(a), r64(b));
+    let (na, nb) = (n64(a), n64(b));
+    // `R64`: valid iff finite; `N64`: valid iff not NaN
+    macro_rules! check {
+        ($what:expr, $proxy:expr, $prim:expr, $valid:expr) => {{
+            let prim: f64 = $prim;
+            let got = catch_unwind(AssertUnwindSafe(|| $proxy));
+            match got {
+                Ok(v) => assert!($valid(prim) && same(v.raw(), prim), "{}: {a:?} {b:?} → {v:?}, primitive {prim:?}", $what),
+                Err(_) => assert!(!$valid(prim), "{}: {a:?} {b:?} panicked but the primitive gives {prim:?}", $what),
+            }
+        }};
+    }
+    let prev = std::panic::take_hook();
+    std::panic::set_hook(Box::new(|_| {}));
+    let fin = |v: f64| v.is_finite();
+    let num = |v: f64| !v.is_nan();
+    check!("add", ra + rb, a + b, fin);
+    check!("sub", ra - rb, a - b, fin);
+    check!("mul", ra * rb, a * b, fin);
+    check!("div", ra / rb, a / b, fin);
+    check!("rem", ra % rb, a % b, fin);
+    check!("add f64", ra + b, a + b, fin);
+    check!("mul &f64", ra * &b, a * b, fin);
+    check!("div &R64", ra / &rb, a / b, fin);
+    check!("neg", -ra, -a, fin);
+    check!("neg ref", -&ra, -a, fin);
+    check!("recip", ra.recip(), a.recip(), fin);
+    check!("sqrt", ra.sqrt(), a.sqrt(), fin);
+    check!("exp", ra.exp(), a.exp(), fin);
+    check!("ln", ra.ln(), a.ln(), fin);
+    check!("log", ra.log(rb), a.log(b), fin);
+    check!("powf", ra.powf(rb), a.powf(b), fin);
+    check!("powi", ra.powi(3), a.powi(3), fin);
+    check!("hypot", ra.hypot(rb), a.hypot(b), fin);
+    check!("atan2", ra.atan2(rb), a.atan2(b), fin);
+    check!("sinh", ra.sinh(), a.sinh(), fin);
+    check!("cosh", ra.cosh(), a.cosh(), fin);
+    check!("tan", ra.tan(), a.tan(), fin);
+    check!("asin", ra.asin(), a.asin(), fin);
+    check!("acosh", ra.acosh(), a.acosh(), fin);
+    check!("atanh", ra.atanh(), a.atanh(), fin);
+    check!("mul_add", ra.mul_add(rb, ra), a.mul_add(b, a), fin);
+    check!("to_degrees", ra.to_degrees(), a.to_degrees(), fin);
+    check!("abs_sub", Float::abs_sub(ra, rb), Float::abs_sub(a, b), fin);
+    check!("signum", ra.signum(), a.signum(), fin);
+    check!("floor", ra.floor(), a.floor(), fin);
+    check!("fract", ra.fract(), a.fract(), fin);
+    check!("N add", na + nb, a + b, num);
+    check!("N mul", na * nb, a * b, num);
+    check!("N div", na / nb, a / b, num);
+    check!("N sqrt", na.sqrt(), a.sqrt(), num);
+    check!("N ln", na.ln(), a.ln(), num);
+    check!("N exp", na.exp(), a.exp(), num);
+    check!("N sinh", na.sinh(), a.sinh(), num);
+    check!("N inf - inf", N64::infinity() - N64::infinity(), f64::NAN, num);
+    check!("N inf * 0", N64::infinity() * nb, f64::INFINITY * b, num);
+    check!("N inf / inf", N64::infinity() / N64::infinity(), f64::NAN, num);
+    check!("N inf.sin", N64::infinity().sin(), f64::INFINITY.sin(), num);
+    check!("N inf.fract", N64::neg_infinity().fract(), f64::NEG_INFINITY.fract(), num);
+    check!("N 0/0", na * 0.0 / (nb * 0.0), (a * 0.0) / (b * 0.0), num);
+    // assignment operators
+    let mut acc = ra;
+    check!("add_assign", { acc += rb; acc }, a + b, fin);
+    let mut acc = ra;
+    check!("mul_assign", { acc *= b; acc }, a * b, fin);
+    let mut acc = ra;
+    check!("div_assign", { acc /= &rb; acc }, a / b, fin);
+    let mut acc = ra;
+    check!("rem_assign", { acc %= rb; acc }, a % b, fin);
+    let mut acc = ra;
+    check!("sub_assign", { acc -= &b; acc }, a - b, fin);
+    std::panic::set_hook(prev);
+    // predicates forward
+    assert_eq!(ra.is_zero(), a == 0.0);
+    assert_eq!(ra.is_one(), a == 1.0);
+    assert_eq!((ra.is_positive(), ra.is_negative()), (a.is_positive(), a.is_negative()));
+    assert_eq!((ra.is_sign_positive(), ra.is_sign_negative()), (a.is_sign_positive(), a.is_sign_negative()));
+    assert_eq!((ra.classify(), ra.is_normal(), ra.is_finite(), ra.is_infinite(), ra.is_nan()), (a.classify(), a.is_normal(), true, false, false));
+    assert_eq!(ra.integer_decode(), a.integer_decode());
+    assert_eq!((ra.to_i64(), ra.to_u8(), ra.to_f32(), ra.to_f64()), (a.to_i64(), a.to_u8(), a.to_f32(), a.to_f64()));
+    assert!(same(Signed::abs(&ra).raw(), a.abs()) && same(Float::abs(ra).raw(), a.abs()));
+}
+
+#[hegel::test]
+fn constants_sums_products_and_casts(tc: hegel::TestCase) {
+    // constants of every kind are the primitive constants
+    assert!(same(R64::PI().raw(), std::f64::consts::PI) && same(R64::E().raw(), std::f64::consts::E) && same(R64::SQRT_2().raw(), std::f64::consts::SQRT_2) && same(R64::LN_2().raw(), std::f64::consts::LN_2));
+    assert!(same(R64::epsilon().raw(), f64::EPSILON) && same(<R64 as Float>::max_value().raw(), f64::MAX) && same(<R64 as Float>::min_value().raw(), f64::MIN) && same(R64::min_positive_value().raw(), f64::MIN_POSITIVE));
+    assert!(same(<R64 as Bounded>::max_value().raw(), f64::MAX) && same(<R64 as Bounded>::min_value().raw(), f64::MIN));
+    assert!(same(R64::zero().raw(), 0.0) && same(R64::one().raw(), 1.0) && same(R64::neg_zero().raw(), -0.0) && same(R64::default().raw(), 0.0));
+    assert!(same(N64::infinity().raw(), f64::INFINITY) && same(N64::neg_infinity().raw(), f64::NEG_INFINITY));
+    // the infinities and NaN are refused by the finite / every type
+    assert!(panics(R64::infinity) && panics(R64::neg_infinity) && panics(R64::nan) && panics(N64::nan));
+    // sums and products fold left like the primitives and panic when the total is invalid
+    let xs: Vec<f64> = tc.draw(generators::vecs(arb_finite()).max_size(8));
+    let sum = xs.iter().fold(0.0, |s, x| s + x);
+    let product = xs.iter().fold(1.0, |p, x| p * x);
+    let rs: Vec<R64> = xs.iter().map(|x| r64(*x)).collect();
+    match catch_unwind(AssertUnwindSafe(|| rs.iter().copied().sum::<R64>())) {
+        Ok(s) => assert!(sum.is_finite() && same(s.raw(), sum), "{xs:?}"),
+        Err(_) => assert!(!sum.is_finite(), "{xs:?}"),
+    }
+    match catch_unwind(AssertUnwindSafe(|| rs.iter().product::<R64>())) {
+        Ok(p) => assert!(product.is_finite() && same(p.raw(), product), "{xs:?}"),
+        Err(_) => assert!(!product.is_finite(), "{xs:?}"),
+    }
+    let ns: Vec<N64> = xs.iter().map(|x| n64(*x)).collect();
+    match catch_unwind(AssertUnwindSafe(|| ns.iter().copied().sum::<N64>())) {
+        Ok(s) => assert!(!sum.is_nan() && same(s.raw(), sum), "{xs:?}"),
+        Err(_) => assert!(sum.is_nan(), "{xs:?}"),
+    }
+    // integer casts
+    let n = tc.draw(generators::integers::<i64>());
+    assert_eq!(R64::from_i64(n).map(|r| r.raw()), f64::from_i64(n));
+    assert_eq!(<R32 as NumCast>::from(n).map(|r| r.raw()), <f32 as NumCast>::from(n));
+    let u = tc.draw(generators::integers::<u128>());
+    assert_eq!(R64::from_u128(u).map(|r| r.raw()), f64::from_u128(u));
+    assert_eq!(<R32 as FromPrimitive>::from_u128(u).is_some(), f32::from_u128(u).map(|f| f.is_finite()).unwrap_or(false), "{u}");
+    let k = tc.draw(generators::integers::<i32>());
+    assert_eq!(<R64 as NumCast>::from(k).unwrap().raw(), k as f64);
+    // from_str_radix agrees with the primitive parser
+    let text = tc.draw(generators::sampled_from(vec!["1.5", "-0.0", "1e300", "1e400", "-1e400", "inf", "NaN", "abc", "", "0x10", "7"]));
+    match (f64::from_str_radix(text, 10), catch_unwind(AssertUnwindSafe(|| <R64 as Num>::from_str_radix(text, 10)))) {
+        (Ok(p), Ok(Ok(r))) => assert!(p.is_finite() && same(r.raw(), p), "{text}"),
+        (Ok(p), Err(_)) => assert!(!p.is_finite(), "{text}: panicked for a finite value"),
+        (Err(_), Ok(Err(_))) => {}
+        (p, r) => panic!("{text}: primitive {p:?}, proxy {:?}", r.map(|r| r.map(|r| r.raw()))),
+    }
+}
