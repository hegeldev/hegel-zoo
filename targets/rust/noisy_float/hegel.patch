+//! Hegel property tests for `noisy_float`: `N64`/`N32` (no NaN) and `R64`/`R32` (finite only)
+//! against the primitive operations, with the checkers as the model — every operation either
+//! equals the primitive result bit for bit or panics (debug assertions are on in the test
+//! profile) exactly when that result is invalid; `Option`/`Result` paths return `None`/`Err`
+//! instead.
+
+#![allow(clippy::float_cmp)]
+
+use std::cmp::Ordering;
+use std::collections::HashSet;
+use std::convert::TryFrom;
+use std::hash::{Hash, Hasher};
+use std::panic::{catch_unwind, AssertUnwindSafe};
+
+use hegel::generators;
+use noisy_float::checkers::{FiniteChecker, NumChecker};
+use noisy_float::prelude::*;
+use noisy_float::{FloatChecker, NoisyFloat};
+use num_traits::{Bounded, FloatConst, FromPrimitive, Num, NumCast, One, Signed, ToPrimitive, Zero};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+/// Any `f64` bit pattern, biased towards the interesting classes.
+#[hegel::composite]
+fn arb_f64(tc: &hegel::TestCase) -> f64 {
+    match tc.draw(int!(0u8, 6)) {
+        0 => f64::from_bits(tc.draw(generators::integers::<u64>())),
+        1 => tc.draw(int!(-1000i64, 1000)) as f64 / [1.0, 2.0, 4.0, 10.0][tc.draw(int!(0usize, 3))],
+        2 => tc.draw(generators::sampled_from(vec![
+            0.0, -0.0, f64::INFINITY, f64::NEG_INFINITY, f64::NAN, -f64::NAN, f64::MAX, f64::MIN, f64::MIN_POSITIVE, -f64::MIN_POSITIVE, f64::EPSILON, 1.0, -1.0, 0.5, 710.0, -710.0, 1e308, -1e308, f64::from_bits(1),
+        ])),
+        3 => {
+            let m = tc.draw(int!(1u64, (1u64 << 52) - 1));
+            let s = if tc.draw(generators::booleans()) { 1u64 << 63 } else { 0 };
+            f64::from_bits(m | s)
+        }
+        4 => {
+            let payload = tc.draw(int!(1u64, (1u64 << 52) - 1));
+            let s = if tc.draw(generators::booleans()) { 1u64 << 63 } else { 0 };
+            f64::from_bits(0x7ff0_0000_0000_0000 | payload | s)
+        }
+        5 => 2f64.powi(tc.draw(int!(-1074i32, 1023))) * if tc.draw(generators::booleans()) { 1.0 } else { -1.0 },
+        _ => {
+            let x = tc.draw(generators::floats::<f64>());
+            if tc.draw(generators::booleans()) { x } else { -x }
+        }
+    }
+}
+
+#[hegel::composite]
+fn arb_f32(tc: &hegel::TestCase) -> f32 {
+    match tc.draw(int!(0u8, 2)) {
+        0 => f32::from_bits(tc.draw(generators::integers::<u32>())),
+        1 => tc.draw(arb_f64()) as f32,
+        _ => tc.draw(generators::sampled_from(vec![0.0f32, -0.0, f32::INFINITY, f32::NEG_INFINITY, f32::NAN, f32::MAX, f32::MIN_POSITIVE, 1.0, -1.0, 100.0])),
+    }
+}
+
+#[hegel::composite]
+fn arb_finite(tc: &hegel::TestCase) -> f64 {
+    let x = tc.draw(arb_f64());
+    if x.is_finite() {
+        x
+    } else {
+        tc.draw(int!(-1_000_000i64, 1_000_000)) as f64 / 8.0
+    }
+}
+
+fn panics<F: FnOnce() -> R, R>(f: F) -> bool {
+    let prev = std::panic::take_hook();
+    std::panic::set_hook(Box::new(|_| {}));
+    let r = catch_unwind(AssertUnwindSafe(f)).is_err();
+    std::panic::set_hook(prev);
+    r
+}
+
+fn same(a: f64, b: f64) -> bool {
+    a.to_bits() == b.to_bits()
+}
+
+fn hash_of<T: Hash>(x: &T) -> u64 {
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    x.hash(&mut h);
+    h.finish()
+}
+
+// ----------------------------------------------------------------------------------------------
