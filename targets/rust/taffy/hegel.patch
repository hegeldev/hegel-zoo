@@ -0,0 +1,56 @@
+//! Property-based tests for the `parse` feature (`FromStr` impls for style types).
+
+use hegel::generators::{self, Generator};
+use taffy::prelude::*;
+
+/// Strings that range from totally arbitrary to almost-valid CSS, to exercise both the
+/// tokenizer and the keyword/function parsing paths.
+#[hegel::composite]
+fn css_like_strings(tc: &hegel::TestCase) -> String {
+    tc.draw(hegel::one_of!(
+        generators::text().max_size(40),
+        generators::from_regex(r"-?[0-9]{0,7}(\.[0-9]{0,4})?(px|%|fr)?").fullmatch(true),
+        generators::sampled_from(vec![
+            "auto",
+            "min-content",
+            "max-content",
+            "fit-content(50px)",
+            "calc(50% + 10px)",
+            "calc(50% +)",
+            "repeat(3, 1fr)",
+            "repeat(auto-fill, minmax(10px, 1fr))",
+            "minmax(10px, 1fr)",
+            "span 3",
+            "span -1",
+            "safe center",
+            "space-between",
+            "1e999px",
+            "-0px",
+            "NaN%",
+            "infinitypx",
+        ])
+        .map(String::from),
+    ))
+}
+
+/// Property: the `FromStr` impls provided by the `parse` feature return `Err` on invalid
+/// input - they never panic (evidence: `FromStr::Err = ParseError` signatures; the
+/// feature is documented as "Implement `FromStr` trait for Taffy style types").
+#[hegel::test]
+fn hegel_style_from_str_never_panics(tc: hegel::TestCase) {
+    let s = tc.draw(css_like_strings());
+
+    let _ = s.parse::<Dimension>();
+    let _ = s.parse::<LengthPercentage>();
+    let _ = s.parse::<LengthPercentageAuto>();
+    let _ = s.parse::<AvailableSpace>();
+    let _ = s.parse::<AlignItems>();
+    let _ = s.parse::<AlignContent>();
+    let _ = s.parse::<GridAutoFlow>();
+    let _ = s.parse::<MinTrackSizingFunction>();
+    let _ = s.parse::<MaxTrackSizingFunction>();
+    let _ = s.parse::<TrackSizingFunction>();
+    let _ = s.parse::<RepetitionCount>();
+    let _ = s.parse::<GridPlacement>();
+    let _ = s.parse::<GridTemplateComponent<String>>();
+}
diff --git a/tests/hand_written/relayout.rs b/tests/hand_written/relayout.rs
index 3d41d68..8957f60 100644
--- a/tests/hand_written/relayout.rs
