@@ -422,3 +422,433 @@ fn relayout_is_stable_with_rounding() {
         assert_eq!(initial_inner_layout.size.height, inner_layout.size.height);
     }
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+
+use hegel::generators::{self, Generator};
+use taffy::geometry::Point;
+use taffy::style::{Clear, Float, Overflow, TextAlign};
+use taffy::TaffyTree;
+use taffy_test_helpers::TestNodeContext;
+
+/// Generator for `Dimension` values (auto, lengths, percentages)
+// NOTE: `Dimension`/`LengthPercentage`/`LengthPercentageAuto` contain a tagged pointer and are
+// not `Send + Sync`, so `generators::just(...)`/`sampled_from(...)` cannot be used with them.
+// These composites draw a discriminant and construct the value imperatively instead.
+
+#[hegel::composite]
+pub(crate) fn dimensions(tc: &hegel::TestCase) -> Dimension {
+    match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => Dimension::AUTO,
+        1 => Dimension::from_length(tc.draw(generators::floats::<f32>().min_value(0.0).max_value(1000.0))),
+        _ => Dimension::from_percent(tc.draw(generators::floats::<f32>().min_value(0.0).max_value(2.0))),
+    }
+}
+
+/// Generator for `LengthPercentage` values (padding/border/gap - non-negative per CSS)
+#[hegel::composite]
+pub(crate) fn length_percentages(tc: &hegel::TestCase) -> LengthPercentage {
+    match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => LengthPercentage::ZERO,
+        1 => LengthPercentage::from_length(tc.draw(generators::floats::<f32>().min_value(0.0).max_value(100.0))),
+        _ => LengthPercentage::from_percent(tc.draw(generators::floats::<f32>().min_value(0.0).max_value(1.0))),
+    }
+}
+
+/// Generator for non-negative `LengthPercentageAuto` values (min_size/max_size since taffy #1099)
+#[hegel::composite]
+pub(crate) fn size_constraints(tc: &hegel::TestCase) -> LengthPercentageAuto {
+    match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => LengthPercentageAuto::AUTO,
+        1 => LengthPercentageAuto::from_length(tc.draw(generators::floats::<f32>().min_value(0.0).max_value(1000.0))),
+        _ => LengthPercentageAuto::from_percent(tc.draw(generators::floats::<f32>().min_value(0.0).max_value(2.0))),
+    }
+}
+
+/// Generator for `LengthPercentageAuto` values (margins/insets - may be negative)
+#[hegel::composite]
+pub(crate) fn length_percentage_autos(tc: &hegel::TestCase) -> LengthPercentageAuto {
+    match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => LengthPercentageAuto::AUTO,
+        1 => LengthPercentageAuto::from_length(
+            tc.draw(generators::floats::<f32>().min_value(-100.0).max_value(100.0)),
+        ),
+        _ => LengthPercentageAuto::from_percent(tc.draw(generators::floats::<f32>().min_value(-1.0).max_value(1.0))),
+    }
+}
+
+/// Generator for grid placements (auto / line / span)
+#[hegel::composite]
+pub(crate) fn grid_placements(tc: &hegel::TestCase) -> GridPlacement {
+    tc.draw((hegel::one_of!(
+        generators::just(GridPlacement::Auto),
+        generators::sampled_from(vec![-4i16, -3, -2, -1, 1, 2, 3, 4]).map(|n| line(n)),
+        generators::integers::<u16>().min_value(1).max_value(4).map(|n| span(n)),
+    )).print_as_debug())
+}
+
+fn align_items_values() -> Vec<AlignItems> {
+    vec![
+        AlignItems::START,
+        AlignItems::END,
+        AlignItems::FLEX_START,
+        AlignItems::FLEX_END,
+        AlignItems::CENTER,
+        AlignItems::BASELINE,
+        AlignItems::STRETCH,
+    ]
+}
+
+fn align_content_values() -> Vec<AlignContent> {
+    vec![
+        AlignContent::START,
+        AlignContent::END,
+        AlignContent::FLEX_START,
+        AlignContent::FLEX_END,
+        AlignContent::CENTER,
+        AlignContent::STRETCH,
+        AlignContent::SPACE_BETWEEN,
+        AlignContent::SPACE_EVENLY,
+        AlignContent::SPACE_AROUND,
+    ]
+}
+
+/// Generator for arbitrary (but valid) `Style` configurations.
+///
+/// Encodes documented validity rules as construction logic: padding/border/gap are
+/// non-negative, flex_grow/flex_shrink are non-negative, aspect_ratio is positive.
+#[hegel::composite]
+pub(crate) fn styles(tc: &hegel::TestCase) -> Style {
+    let mut style = Style::default();
+    style.display =
+        tc.draw((generators::sampled_from(vec![Display::Flex, Display::Grid, Display::Block, Display::None])).print_as_debug());
+    style.box_sizing = tc.draw((generators::sampled_from(vec![BoxSizing::BorderBox, BoxSizing::ContentBox])).print_as_debug());
+    style.position = tc.draw((generators::sampled_from(vec![Position::Relative, Position::Absolute])).print_as_debug());
+    style.overflow = Point {
+        x: tc.draw((generators::sampled_from(vec![Overflow::Visible, Overflow::Clip, Overflow::Hidden, Overflow::Scroll])).print_as_debug()),
+        y: tc.draw((generators::sampled_from(vec![Overflow::Visible, Overflow::Clip, Overflow::Hidden, Overflow::Scroll])).print_as_debug()),
+    };
+    style.scrollbar_width = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(20.0));
+    style.size = Size { width: tc.draw((dimensions()).print_as_debug()), height: tc.draw((dimensions()).print_as_debug()) };
+    style.min_size = Size { width: tc.draw((size_constraints()).print_as_debug()), height: tc.draw((size_constraints()).print_as_debug()) };
+    style.max_size = Size { width: tc.draw((size_constraints()).print_as_debug()), height: tc.draw((size_constraints()).print_as_debug()) };
+    style.aspect_ratio = tc.draw(generators::optional(generators::floats::<f32>().min_value(0.01).max_value(100.0)));
+    style.inset = Rect {
+        left: tc.draw((length_percentage_autos()).print_as_debug()),
+        right: tc.draw((length_percentage_autos()).print_as_debug()),
+        top: tc.draw((length_percentage_autos()).print_as_debug()),
+        bottom: tc.draw((length_percentage_autos()).print_as_debug()),
+    };
+    style.margin = Rect {
+        left: tc.draw((length_percentage_autos()).print_as_debug()),
+        right: tc.draw((length_percentage_autos()).print_as_debug()),
+        top: tc.draw((length_percentage_autos()).print_as_debug()),
+        bottom: tc.draw((length_percentage_autos()).print_as_debug()),
+    };
+    style.padding = Rect {
+        left: tc.draw((length_percentages()).print_as_debug()),
+        right: tc.draw((length_percentages()).print_as_debug()),
+        top: tc.draw((length_percentages()).print_as_debug()),
+        bottom: tc.draw((length_percentages()).print_as_debug()),
+    };
+    style.border = Rect {
+        left: tc.draw((length_percentages()).print_as_debug()),
+        right: tc.draw((length_percentages()).print_as_debug()),
+        top: tc.draw((length_percentages()).print_as_debug()),
+        bottom: tc.draw((length_percentages()).print_as_debug()),
+    };
+    style.gap = Size { width: tc.draw((length_percentages()).print_as_debug()), height: tc.draw((length_percentages()).print_as_debug()) };
+    style.align_items = tc.draw((generators::optional(generators::sampled_from(align_items_values()))).print_as_debug());
+    style.align_self = tc.draw((generators::optional(generators::sampled_from(align_items_values()))).print_as_debug());
+    style.justify_items = tc.draw((generators::optional(generators::sampled_from(align_items_values()))).print_as_debug());
+    style.justify_self = tc.draw((generators::optional(generators::sampled_from(align_items_values()))).print_as_debug());
+    style.align_content = tc.draw((generators::optional(generators::sampled_from(align_content_values()))).print_as_debug());
+    style.justify_content = tc.draw((generators::optional(generators::sampled_from(align_content_values()))).print_as_debug());
+    style.text_align = tc.draw((generators::sampled_from(vec![
+        TextAlign::Auto,
+        TextAlign::LegacyLeft,
+        TextAlign::LegacyRight,
