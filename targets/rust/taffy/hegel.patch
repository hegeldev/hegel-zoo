+
+/// A generated specification for a whole style tree
+#[derive(Debug, Clone, hegel::PrettyPrintable)]
+pub(crate) struct TreeSpec {
+    #[pretty(debug)]
+    pub(crate) style: Style,
+    pub(crate) children: Vec<TreeSpec>,
+}
+
+/// Recursive generator for tree specifications. `depth` bounds the nesting level.
+pub(crate) fn tree_specs(depth: u32) -> generators::BoxedGenerator<'static, TreeSpec> {
+    hegel::compose!(|tc| {
+        let style = tc.draw((styles()).print_as_debug());
+        let children =
+            if depth == 0 { Vec::new() } else { tc.draw((generators::vecs(tree_specs(depth - 1)).max_size(3)).print_as_debug()) };
+        TreeSpec { style, children }
+    })
+    .boxed()
+}
+
+/// Generator for `AvailableSpace` constraints
+#[hegel::composite]
+pub(crate) fn available_spaces(tc: &hegel::TestCase) -> AvailableSpace {
+    tc.draw((hegel::one_of!(
+        generators::just(AvailableSpace::MinContent),
+        generators::just(AvailableSpace::MaxContent),
+        generators::floats::<f32>().min_value(0.0).max_value(2000.0).map(AvailableSpace::Definite),
+    )).print_as_debug())
+}
+
+/// Build a `TaffyTree` from a `TreeSpec`, returning the root and (in post-order) all node ids.
+pub(crate) fn build_tree(
+    taffy: &mut TaffyTree<TestNodeContext>,
+    spec: &TreeSpec,
+    all: &mut Vec<NodeId>,
+) -> NodeId {
+    let children: Vec<NodeId> = spec.children.iter().map(|c| build_tree(taffy, c, all)).collect();
+    let node = taffy.new_with_children(spec.style.clone(), &children).unwrap();
+    all.push(node);
+    node
+}
+
+/// Extract every f32 in a `Layout` (as bits, so that comparisons are exact and NaN-safe)
+/// together with the order field.
+pub(crate) fn layout_bits(l: &Layout) -> Vec<u32> {
+    let fields = [
+        l.location.x,
+        l.location.y,
+        l.size.width,
+        l.size.height,
+        l.scrollable_overflow_rect.left,
+        l.scrollable_overflow_rect.right,
+        l.scrollable_overflow_rect.top,
+        l.scrollable_overflow_rect.bottom,
+        l.scrollbar_size.width,
+        l.scrollbar_size.height,
+        l.border.left,
+        l.border.right,
+        l.border.top,
+        l.border.bottom,
+        l.padding.left,
+        l.padding.right,
+        l.padding.top,
+        l.padding.bottom,
+        l.margin.left,
+        l.margin.right,
+        l.margin.top,
+        l.margin.bottom,
+    ];
+    let mut out = vec![l.order];
+    out.extend(fields.iter().map(|f| f.to_bits()));
+    out
+}
+
+/// Collect all node ids reachable from `root` in pre-order.
+pub(crate) fn collect_preorder(taffy: &TaffyTree<TestNodeContext>, root: NodeId, out: &mut Vec<NodeId>) {
+    out.push(root);
+    for child in taffy.children(root).unwrap() {
+        collect_preorder(taffy, child, out);
+    }
+}
+
+/// Rebuild the subtree reachable from `src_node` in `dst`, copying styles, and return the new root.
+fn clone_reachable(
+    src: &TaffyTree<TestNodeContext>,
+    src_node: NodeId,
+    dst: &mut TaffyTree<TestNodeContext>,
+) -> NodeId {
+    let children: Vec<NodeId> =
+        src.children(src_node).unwrap().iter().map(|c| clone_reachable(src, *c, dst)).collect();
+    dst.new_with_children(src.style(src_node).unwrap().clone(), &children).unwrap()
+}
+
+/// Property: computing layout twice in a row with the same available space produces
+/// identical layouts for every node (evidence: the `relayout` test above).
+#[hegel::test]
+fn hegel_relayout_is_stable(tc: hegel::TestCase) {
+    let spec = tc.draw((tree_specs(3)).print_as_debug());
+    let available_space =
+        Size { width: tc.draw((available_spaces()).print_as_debug()), height: tc.draw((available_spaces()).print_as_debug()) };
+
+    let mut taffy = new_test_tree();
+    let mut nodes = Vec::new();
+    let root = build_tree(&mut taffy, &spec, &mut nodes);
+
+    taffy.compute_layout(root, available_space).unwrap();
+    let before: Vec<Vec<u32>> = nodes.iter().map(|n| layout_bits(taffy.layout(*n).unwrap())).collect();
+
+    taffy.compute_layout(root, available_space).unwrap();
+    let after: Vec<Vec<u32>> = nodes.iter().map(|n| layout_bits(taffy.layout(*n).unwrap())).collect();
+
+    assert_eq!(before, after);
+}
+
+/// Property: marking an arbitrary node dirty and recomputing (with nothing changed)
+/// reproduces the identical layout. Exercises the cache-invalidation path
+/// (evidence: `mark_dirty` docs + the caching tests).
+#[hegel::test]
+fn hegel_relayout_after_mark_dirty_is_stable(tc: hegel::TestCase) {
+    let spec = tc.draw((tree_specs(3)).print_as_debug());
+    let available_space =
+        Size { width: tc.draw((available_spaces()).print_as_debug()), height: tc.draw((available_spaces()).print_as_debug()) };
+
+    let mut taffy = new_test_tree();
+    let mut nodes = Vec::new();
+    let root = build_tree(&mut taffy, &spec, &mut nodes);
+
+    taffy.compute_layout(root, available_space).unwrap();
+    let before: Vec<Vec<u32>> = nodes.iter().map(|n| layout_bits(taffy.layout(*n).unwrap())).collect();
+
+    let dirty_idx = tc.draw(generators::integers::<usize>().max_value(nodes.len() - 1));
+    taffy.mark_dirty(nodes[dirty_idx]).unwrap();
+    taffy.compute_layout(root, available_space).unwrap();
+    let after: Vec<Vec<u32>> = nodes.iter().map(|n| layout_bits(taffy.layout(*n).unwrap())).collect();
+
+    assert_eq!(before, after);
+}
+
+/// Property: for finite style inputs, every value in the computed layout is finite
+/// (no NaN, no infinity). Renderers downstream rely on this.
+#[hegel::test]
+fn hegel_layout_outputs_are_finite(tc: hegel::TestCase) {
+    let spec = tc.draw((tree_specs(3)).print_as_debug());
+    let available_space =
+        Size { width: tc.draw((available_spaces()).print_as_debug()), height: tc.draw((available_spaces()).print_as_debug()) };
+
+    let mut taffy = new_test_tree();
+    let mut nodes = Vec::new();
+    let root = build_tree(&mut taffy, &spec, &mut nodes);
+    taffy.compute_layout(root, available_space).unwrap();
+
+    for node in &nodes {
+        let layout = taffy.layout(*node).unwrap();
+        for bits in layout_bits(layout).into_iter().skip(1) {
+            let value = f32::from_bits(bits);
+            assert!(value.is_finite(), "non-finite layout value {value} in {layout:?}");
+        }
+    }
+}
+
+/// Property: a `Display::None` root hides the entire subtree - every node's size and
+/// location are zero (evidence: `toggle_root_display_none_with_children` above and
+/// `compute_hidden_layout`).
+#[hegel::test]
+fn hegel_display_none_root_zeroes_entire_subtree(tc: hegel::TestCase) {
+    let mut spec = tc.draw((tree_specs(3)).print_as_debug());
+    spec.style.display = Display::None;
+    let available_space =
+        Size { width: tc.draw((available_spaces()).print_as_debug()), height: tc.draw((available_spaces()).print_as_debug()) };
+
+    let mut taffy = new_test_tree();
+    let mut nodes = Vec::new();
+    let root = build_tree(&mut taffy, &spec, &mut nodes);
+    taffy.compute_layout(root, available_space).unwrap();
+
+    for node in &nodes {
+        let layout = taffy.layout(*node).unwrap();
+        assert_eq!(layout.location, Point { x: 0.0, y: 0.0 });
+        assert_eq!(layout.size, Size { width: 0.0, height: 0.0 });
+    }
+}
+
+/// Property: after an arbitrary tree mutation (style change, node removal, adding a
+/// child, detaching a child), recomputing layout produces exactly the same result as
+/// computing layout on a fresh tree with the same final structure. This is the
+/// incremental-layout / cache-consistency contract (evidence: `set_style`,
+/// `add_child`, `remove`, `remove_child_at_index` all promise to invalidate affected
+/// caches, and the `relayout`/`caching` tests).
+#[hegel::test]
+fn hegel_incremental_relayout_matches_fresh_tree(tc: hegel::TestCase) {
+    let spec = tc.draw(tree_specs(3));
+    let available_space =
+        Size { width: tc.draw((available_spaces()).print_as_debug()), height: tc.draw((available_spaces()).print_as_debug()) };
+
+    let mut taffy = new_test_tree();
+    let mut nodes = Vec::new();
+    let root = build_tree(&mut taffy, &spec, &mut nodes);
+    taffy.compute_layout(root, available_space).unwrap();
+
+    // Apply a random mutation
+    let op = tc.draw(generators::integers::<u8>().max_value(3));
+    match op {
+        // Remove a random non-root node from the tree entirely
+        1 if nodes.len() > 1 => {
+            let victims: Vec<NodeId> = nodes.iter().copied().filter(|n| *n != root).collect();
+            let idx = tc.draw(generators::integers::<usize>().max_value(victims.len() - 1));
+            taffy.remove(victims[idx]).unwrap();
+        }
+        // Add a new leaf under a random node
+        2 => {
+            let idx = tc.draw(generators::integers::<usize>().max_value(nodes.len() - 1));
+            let leaf_style = tc.draw((styles()).print_as_debug());
+            let leaf = taffy.new_leaf(leaf_style).unwrap();
+            taffy.add_child(nodes[idx], leaf).unwrap();
+        }
+        // Detach a random child from its parent
+        3 if nodes.len() > 1 => {
+            let parents: Vec<NodeId> =
+                nodes.iter().copied().filter(|n| !taffy.children(*n).unwrap().is_empty()).collect();
+            let idx = tc.draw(generators::integers::<usize>().max_value(parents.len() - 1));
+            let parent = parents[idx];
+            let child_count = taffy.children(parent).unwrap().len();
+            let child_idx = tc.draw(generators::integers::<usize>().max_value(child_count - 1));
+            taffy.remove_child_at_index(parent, child_idx).unwrap();
+        }
+        // Change the style of a random node (also the fallback for ops 1/3 on a leaf-only tree)
+        _ => {
+            let idx = tc.draw(generators::integers::<usize>().max_value(nodes.len() - 1));
+            let new_style = tc.draw((styles()).print_as_debug());
+            taffy.set_style(nodes[idx], new_style).unwrap();
+        }
+    }
+
+    // Incrementally recompute the mutated tree
+    taffy.compute_layout(root, available_space).unwrap();
+
+    // Build an identical fresh tree (same reachable structure and styles) and lay it out once
+    let mut fresh = new_test_tree();
+    let fresh_root = clone_reachable(&taffy, root, &mut fresh);
+    fresh.compute_layout(fresh_root, available_space).unwrap();
+
+    let mut incremental_nodes = Vec::new();
+    collect_preorder(&taffy, root, &mut incremental_nodes);
+    let mut fresh_nodes = Vec::new();
+    collect_preorder(&fresh, fresh_root, &mut fresh_nodes);
+    assert_eq!(incremental_nodes.len(), fresh_nodes.len());
+
+    for (a, b) in incremental_nodes.iter().zip(fresh_nodes.iter()) {
+        let incremental = taffy.layout(*a).unwrap();
+        let from_scratch = fresh.layout(*b).unwrap();
+        assert_eq!(
+            layout_bits(incremental),
+            layout_bits(from_scratch),
+            "incremental relayout {incremental:?} != from-scratch layout {from_scratch:?}"
+        );
+    }
+}
