+/// Property: rounding does not open gaps (or create overlap) between adjacent children
+/// of a flex row - each child's right edge is exactly the next child's left edge, even
+/// for fractional sizes (evidence: the `rounding_doesnt_leave_gaps` test above and the
+/// `round_layout` doc comment).
+#[hegel::test]
+fn hegel_rounding_leaves_no_gaps_between_adjacent_children(tc: hegel::TestCase) {
+    let mut taffy = new_test_tree();
+
+    // A row of children with (fractional) fixed sizes
+    let child_count = tc.draw(generators::integers::<usize>().min_value(2).max_value(6));
+    let mut children = Vec::new();
+    for _ in 0..child_count {
+        let width = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(300.0));
+        let height = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(300.0));
+        let grow = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(2.0));
+        let shrink = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(2.0));
+        let child = taffy
+            .new_leaf(Style {
+                size: Size { width: length(width), height: length(height) },
+                flex_grow: grow,
+                flex_shrink: shrink,
+                ..Default::default()
+            })
+            .unwrap();
+        children.push(child);
+    }
+
+    // Justifications that keep the children contiguous (Space* distribute extra space
+    // *between* children, so gaps are expected for those)
+    let justify_content = tc.draw((generators::optional(generators::sampled_from(vec![
+        JustifyContent::START,
+        JustifyContent::END,
+        JustifyContent::FLEX_START,
+        JustifyContent::FLEX_END,
+        JustifyContent::CENTER,
+    ]))).print_as_debug());
+    let root_width = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(1500.0));
+    let root_height = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(500.0));
+    let padding = tc.draw(generators::floats::<f32>().min_value(0.0).max_value(50.0));
+    let root = taffy
+        .new_with_children(
+            Style {
+                display: Display::Flex,
+                flex_direction: FlexDirection::Row,
+                flex_wrap: FlexWrap::NoWrap,
+                justify_content,
+                size: Size { width: length(root_width), height: length(root_height) },
+                padding: Rect {
+                    left: LengthPercentage::from_length(padding),
+                    right: LengthPercentage::from_length(padding),
+                    top: LengthPercentage::from_length(padding),
+                    bottom: LengthPercentage::from_length(padding),
+                },
+                ..Default::default()
+            },
