+/// Property: with rounding enabled (the default), every rounded layout value
+/// (location, size, scrollable_overflow_rect, scrollbar_size, border, padding) is a whole number
+/// (evidence: `round_layout` docs - "Rounds the calculated layout to exact pixel values").
+/// Note that `Layout::margin` is deliberately not asserted on: `round_layout` does not
+/// round margins.
+#[hegel::test]
+fn hegel_rounded_layout_values_are_whole_numbers(tc: hegel::TestCase) {
+    let spec = tc.draw((tree_specs(3)).print_as_debug());
+    let available_space = Size { width: tc.draw((available_spaces()).print_as_debug()), height: tc.draw((available_spaces()).print_as_debug()) };
+
+    let mut taffy = new_test_tree();
+    let mut nodes = Vec::new();
+    let root = build_tree(&mut taffy, &spec, &mut nodes);
+    taffy.compute_layout(root, available_space).unwrap();
+
+    for node in &nodes {
+        let layout = taffy.layout(*node).unwrap();
+        let rounded_fields = [
+            ("location.x", layout.location.x),
+            ("location.y", layout.location.y),
+            ("size.width", layout.size.width),
+            ("size.height", layout.size.height),
+            ("scrollable_overflow_rect.left", layout.scrollable_overflow_rect.left),
+            ("scrollable_overflow_rect.right", layout.scrollable_overflow_rect.right),
+            ("scrollable_overflow_rect.top", layout.scrollable_overflow_rect.top),
+            ("scrollable_overflow_rect.bottom", layout.scrollable_overflow_rect.bottom),
+            ("scrollbar_size.width", layout.scrollbar_size.width),
+            ("scrollbar_size.height", layout.scrollbar_size.height),
+            ("border.left", layout.border.left),
+            ("border.right", layout.border.right),
+            ("border.top", layout.border.top),
+            ("border.bottom", layout.border.bottom),
+            ("padding.left", layout.padding.left),
+            ("padding.right", layout.padding.right),
+            ("padding.top", layout.padding.top),
+            ("padding.bottom", layout.padding.bottom),
+        ];
+        for (name, value) in rounded_fields {
+            assert!(
+                value.fract() == 0.0,
+                "rounded layout field {name} = {value} is not a whole number in {layout:?}"
+            );
+        }
+    }
