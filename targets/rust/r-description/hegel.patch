+// ---------------------------------------------------------------------------
+// URL entries
+// ---------------------------------------------------------------------------
+
+/// `UrlEntry` round-trips through `Display` for URLs without parentheses, with or without a label.
+#[hegel::test]
+fn url_entries_round_trip(tc: TestCase) {
+    let url = arb_url(&tc);
+    let label = if chance(&tc, 2) {
+        Some(arb_chars(&tc, "abcdefghijklmnopqrstuvwxyz ", 1, 8).trim().to_string()).filter(|l| !l.is_empty())
+    } else {
+        None
+    };
+    let text = match &label {
+        Some(l) => format!("{url} ({l})"),
+        None => url.clone(),
+    };
+    let entry = UrlEntry::from_str(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    assert_eq!(entry.url.as_str(), url, "{text:?}");
+    assert_eq!(entry.label, label, "{text:?}");
+    assert_eq!(entry.to_string(), text);
+}
+
+/// Pinned (r-description/8): a URL with parentheses in its path (`R_(programming_language)`)
+/// is cut at the first `(` and its tail taken for a label.
+#[hegel::test]
+fn urls_with_parentheses_keep_their_path(tc: TestCase) {
+    let text = "https://en.wikipedia.org/wiki/R_(programming_language)";
+    let entry = UrlEntry::from_str(text).unwrap();
+    assert_eq!(entry.url.as_str(), text);
+    assert_eq!(entry.label, None);
+    let url = format!("{}({})", arb_url(&tc), arb_chars(&tc, "abcdefghijklmnopqrstuvwxyz", 1, 6));
+    let entry = UrlEntry::from_str(&url).unwrap();
+    assert_eq!(entry.url.as_str(), url, "{url:?}");
+    assert_eq!(entry.label, None, "{url:?}");
+}
