+// ---------------------------------------------------------------------------
+// DESCRIPTION files against read.dcf
+// ---------------------------------------------------------------------------
+
+const TEXT_CHARS: &str =
+    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 ,.;:()<>@/=+'-";
+
+/// A line of field text: non-empty, no leading or trailing whitespace, never a lone `.`.
+fn arb_line(tc: &TestCase) -> String {
+    let mut s = arb_chars(tc, TEXT_CHARS, 1, 24).trim().to_string();
+    if s.is_empty() || s == "." {
+        s.push_str("text");
+    }
+    s
+}
+
+/// A field value of one line plus 0–3 indented continuation lines (as written after the colon).
+fn arb_text_value(tc: &TestCase, multiline: bool) -> String {
+    let mut raw = arb_line(tc);
+    if multiline {
+        for _ in 0..n(tc, 0, 3) {
+            raw.push('\n');
+            raw.push_str(pick(tc, &[" ", "  ", "    ", "\t"]));
+            raw.push_str(&arb_line(tc));
+        }
+    }
+    raw
+}
+
+fn arb_url(tc: &TestCase) -> String {
+    let host = format!("{}.org", arb_chars(tc, "abcdefghijklmnopqrstuvwxyz", 1, 8));
+    // No dots: the url crate normalises `/.` and `/..` path segments away.
+    let path = arb_chars(tc, "abcdefghijklmnopqrstuvwxyz0123456789/_-~", 0, 12);
+    format!("https://{host}/{path}")
+}
+
+#[derive(Clone, Debug)]
+struct Field {
+    name: &'static str,
+    raw: String,
+}
+
+const OPTIONAL_FIELDS: [&str; 19] = [
+    "Maintainer",
+    "Author",
+    "Encoding",
+    "URL",
+    "BugReports",
+    "Depends",
+    "Imports",
+    "Suggests",
+    "LinkingTo",
+    "Enhances",
+    "LazyData",
+    "Collate",
+    "VignetteBuilder",
+    "SystemRequirements",
+    "Date",
+    "Language",
+    "Repository",
+    "RoxygenNote",
+    "Roxygen",
+];
+
+/// A DESCRIPTION file: the five fields the lossy struct requires plus a random subset of the
+/// optional ones, in random order, with values shaped for each field.
+#[hegel::composite]
+fn arb_description(tc: &TestCase) -> (String, Vec<Field>, Vec<UrlEntry>) {
+    let mut names: Vec<&'static str> = vec!["Package", "Version", "Title", "Description", "License"];
+    for f in OPTIONAL_FIELDS {
+        if chance(tc, 3) {
+            names.push(f);
+        }
+    }
+    // Shuffle.
+    let mut order = vec![];
+    while !names.is_empty() {
+        let i = n(tc, 0, names.len() - 1);
+        order.push(names.remove(i));
+    }
+    let mut fields = vec![];
+    let mut urls = vec![];
+    for name in order {
+        let raw = match name {
+            "Package" | "VignetteBuilder" => arb_name(tc),
+            "Version" => tc.draw(arb_version(false, true)),
+            "Description" => arb_text_value(tc, true),
+            "Depends" | "Imports" | "Suggests" | "LinkingTo" | "Enhances" => {
+                tc.draw(arb_relations(true).print_as_debug()).0
+            }
+            "URL" => {
+                let mut raw = String::new();
+                for i in 0..n(tc, 1, 3) {
+                    let url = arb_url(tc);
+                    let label = if chance(tc, 3) {
+                        Some(arb_chars(tc, "abcdefghijklmnopqrstuvwxyz ", 1, 8).trim().to_string())
+                            .filter(|l| !l.is_empty())
+                    } else {
+                        None
+                    };
+                    if i > 0 {
+                        raw.push(',');
+                        raw.push_str(pick(tc, &[" ", "\n  ", "\n    ", " "]));
+                    }
+                    raw.push_str(&url);
+                    if let Some(l) = &label {
+                        raw.push_str(&format!(" ({l})"));
+                    }
+                    urls.push(UrlEntry {
+                        url: url::Url::parse(&url).unwrap(),
+                        label,
+                    });
+                }
+                raw
+            }
+            "BugReports" => arb_url(tc),
+            "LazyData" => pick(tc, &["true", "false"]).to_string(),
+            "Encoding" => pick(tc, &["UTF-8", "latin1"]).to_string(),
+            "Date" => format!("20{:02}-{:02}-{:02}", n(tc, 0, 26), n(tc, 1, 12), n(tc, 1, 28)),
+            "Language" => "en-US".to_string(),
+            "Repository" => pick(tc, &["CRAN", "RSPM", "Bioconductor"]).to_string(),
+            "RoxygenNote" => tc.draw(arb_version(false, false)),
+            "SystemRequirements" => arb_line(tc).replace(',', ";"),
+            _ => arb_text_value(tc, chance(tc, 2)),
+        };
+        fields.push(Field { name, raw });
+    }
+    let mut text = String::new();
+    for f in &fields {
+        text.push_str(f.name);
+        text.push(':');
+        if !f.raw.starts_with('\n') && !chance(tc, 6) {
+            text.push(' ');
+        } else if chance(tc, 2) {
+            text.push_str("  ");
+        }
+        text.push_str(&f.raw);
+        text.push('\n');
+    }
+    (text, fields, urls)
+}
+
+fn lossless_get(desc: &LosslessDesc, field: &str) -> Option<Option<String>> {
+    Some(match field {
+        "Package" => desc.package(),
+        "Title" => desc.title(),
+        "Description" => desc.description(),
+        "Version" => desc.version(),
+        "License" => desc.license(),
+        "Maintainer" => desc.maintainer(),
+        "Encoding" => desc.encoding(),
+        "Date" => desc.date(),
+        "Repository" => desc.repository(),
+        "Collate" => desc.collate(),
+        "URL" => desc.url(),
+        "RoxygenNote" => desc.roxygen_note(),
+        "Roxygen" => desc.roxygen(),
+        "Author" | "Language" | "Additional_repositories" => return None,
+        _ => return None,
+    })
+}
+
+fn lossless_relations_field(desc: &LosslessDesc, field: &str) -> Option<Relations> {
+    match field {
+        "Depends" => desc.depends(),
+        "Imports" => desc.imports(),
+        "Suggests" => desc.suggests(),
+        "LinkingTo" => desc.linking_to(),
+        "Enhances" => desc.enhances(),
+        _ => unreachable!(),
+    }
+}
+
+/// Every field of a generated DESCRIPTION reads, through the lossless getters and the lossy
+/// struct, as `read.dcf` reads it; relation fields as `.split_dependencies` reads them; the
+/// lossless text is kept; the lossy struct round-trips through its own `Display`.
+#[hegel::test]
+fn description_fields_read_like_read_dcf(tc: TestCase) {
+    let (text, fields, urls) = tc.draw(arb_description().print_as_debug());
+    let lossless = LosslessDesc::from_str(&text).unwrap_or_else(|e| panic!("lossless {text:?}: {e}"));
+    assert_eq!(lossless.to_string(), text, "text identity");
+    let lossy = LossyDesc::from_str(&text).unwrap_or_else(|e| panic!("lossy {text:?}: {e}"));
+
+    for f in &fields {
+        let value = r_dcf(&text, f.name)
+            .unwrap_or_else(|e| panic!("read.dcf rejects {text:?}: {e}"))
+            .unwrap_or_else(|| panic!("read.dcf has no {} in {text:?}", f.name));
+        let ctx = format!("{}: {:?} in {text:?}", f.name, f.raw);
+        if let Some(got) = lossless_get(&lossless, f.name) {
+            assert_eq!(got, Some(value.clone()), "lossless {ctx}");
+        }
+        match f.name {
+            "Depends" | "Imports" | "Suggests" | "LinkingTo" | "Enhances" => {
+                let expected = r_deps(&value).unwrap();
+                let got = lossless_relations_field(&lossless, f.name)
+                    .unwrap_or_else(|| panic!("lossless {ctx}: no field"));
+                assert_eq!(lossless_rels(&got), expected, "lossless {ctx}");
+                let got = match f.name {
+                    "Depends" => &lossy.depends,
+                    "Imports" => &lossy.imports,
+                    "Suggests" => &lossy.suggests,
+                    "LinkingTo" => &lossy.linking_to,
+                    _ => continue, // the lossy struct has no Enhances
+                };
+                assert_eq!(lossy_rels(got.as_ref().unwrap()), expected, "lossy {ctx}");
+            }
+            "LazyData" => {
+                let expected = r_logical(&value);
+                assert_eq!(lossless.lazy_data(), expected, "lossless {ctx}");
+                assert_eq!(lossy.lazy_data.as_deref(), Some(value.as_str()), "lossy {ctx}");
+            }
+            "BugReports" => {
+                assert_eq!(lossless.bug_reports().map(|u| u.to_string()), Some(value.clone()), "lossless {ctx}");
+                assert_eq!(lossy.bug_reports.as_deref(), Some(value.as_str()), "lossy {ctx}");
+            }
+            "URL" => {
+                assert_eq!(lossy.url.as_ref().unwrap(), &urls, "lossy {ctx}");
+            }
+            "VignetteBuilder" => {
+                assert_eq!(lossless.vignette_builder(), Some(vec![value.clone()]), "lossless {ctx}");
+                assert_eq!(lossy.vignette_builder.as_deref(), Some(value.as_str()), "lossy {ctx}");
+            }
+            "SystemRequirements" => {
+                assert_eq!(lossless.system_requirements(), Some(vec![value.clone()]), "lossless {ctx}");
+                assert_eq!(lossy.system_requirements.as_deref(), Some(value.as_str()), "lossy {ctx}");
+            }
+            "Version" => {
+                assert_eq!(lossy.version.to_string(), r_version(&value).unwrap(), "lossy {ctx}");
+            }
+            "Package" => assert_eq!(lossy.name, value, "lossy {ctx}"),
+            "Title" => assert_eq!(lossy.title, value, "lossy {ctx}"),
+            "Description" => assert_eq!(lossy.description, value, "lossy {ctx}"),
+            "License" => assert_eq!(lossy.license, value, "lossy {ctx}"),
+            "Maintainer" => assert_eq!(lossy.maintainer.as_deref(), Some(value.as_str()), "lossy {ctx}"),
+            "Author" => assert_eq!(lossy.author.as_deref(), Some(value.as_str()), "lossy {ctx}"),
+            "Encoding" => assert_eq!(lossy.encoding.as_deref(), Some(value.as_str()), "lossy {ctx}"),
+            "Collate" => assert_eq!(lossy.collate.as_deref(), Some(value.as_str()), "lossy {ctx}"),
+            "Date" => assert_eq!(lossy.date.as_deref(), Some(value.as_str()), "lossy {ctx}"),
+            "Language" => assert_eq!(lossy.language.as_deref(), Some(value.as_str()), "lossy {ctx}"),
+            "Repository" => assert_eq!(lossy.repository.as_deref(), Some(value.as_str()), "lossy {ctx}"),
+            _ => {}
+        }
+    }
+
+    // The lossy struct round-trips through its own Display.
+    let rendered = lossy.to_string();
+    let again = LossyDesc::from_str(&rendered).unwrap_or_else(|e| panic!("lossy re-parse of {rendered:?}: {e}"));
+    assert_eq!(again, lossy, "lossy round trip through {rendered:?}");
+    // … and R reads the same values back from it.
+    for f in &fields {
+        if matches!(f.name, "Version" | "URL" | "Enhances" | "RoxygenNote" | "Roxygen") {
+            continue; // normalised or re-rendered by the lossy struct, or not a field of it
+        }
+        let before = r_dcf(&text, f.name).unwrap();
+        let after = r_dcf(&rendered, f.name).unwrap();
+        if matches!(f.name, "Depends" | "Imports" | "Suggests" | "LinkingTo") {
+            // Re-rendered canonically; R must read the same relations.
+            assert_eq!(
+                r_deps(after.as_deref().unwrap_or("")).unwrap(),
+                r_deps(before.as_deref().unwrap_or("")).unwrap(),
+                "{}: .split_dependencies of the lossy rendering {rendered:?}",
+                f.name
+            );
+        } else {
+            assert_eq!(after, before, "{}: read.dcf of the lossy rendering {rendered:?}", f.name);
+        }
+    }
+}
