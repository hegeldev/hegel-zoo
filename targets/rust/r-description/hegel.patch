+    assert!(imports.is_ok(), "imports() panicked on `foo (>= 1.0) bar`");
+    let bugs = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| desc.bug_reports().map(|u| u.to_string())));
+    assert!(bugs.is_ok(), "bug_reports() panicked on `bugs at example.org`");
+}
+
+/// Pinned (r-description/9): Writing R Extensions allows the `URL` field to be "a list of URLs
+/// separated by commas or whitespace"; the lossy parser splits on commas and newlines only, so
+/// `https://a.org/ https://b.org/` becomes the single URL `https://a.org/%20https://b.org/`.
+#[hegel::test]
+fn url_lists_may_be_whitespace_separated(tc: TestCase) {
+    let text = "Package: p\nTitle: t\nVersion: 1.0\nDescription: d\nLicense: MIT\nURL: https://a.org/ https://b.org/\n";
+    let desc = LossyDesc::from_str(text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    let urls: Vec<String> = desc.url.unwrap().iter().map(|u| u.url.to_string()).collect();
+    assert_eq!(urls, ["https://a.org/", "https://b.org/"]);
+    let mut raw = String::new();
+    let mut expected = vec![];
+    for i in 0..n(&tc, 2, 3) {
+        if i > 0 {
+            raw.push_str(pick(&tc, &[" ", "  ", "\n  ", "\t"]));
+        }
+        let url = arb_url(&tc);
+        raw.push_str(&url);
+        expected.push(url);
+    }
+    let text = format!("Package: p\nTitle: t\nVersion: 1.0\nDescription: d\nLicense: MIT\nURL: {raw}\n");
+    let desc = LossyDesc::from_str(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    let urls: Vec<String> = desc.url.unwrap().iter().map(|u| u.url.to_string()).collect();
+    assert_eq!(urls, expected, "{text:?}");
+}
