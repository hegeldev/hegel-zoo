+//! Hegel properties for `r-description`, with R itself as the oracle.
+//!
+//! A persistent `Rscript` child answers questions with base R's own machinery:
+//! `read.dcf` for the DESCRIPTION file format, `tools:::.split_dependencies`
+//! for the `Depends`/`Imports`/… grammar, `package_version`/`numeric_version`
+//! for version syntax and ordering (what `loadNamespace` and `R CMD INSTALL`
+//! use to check version requirements) and `tools:::config_val_to_logical` for
+//! logical fields such as `LazyData`.
+
+use std::cmp::Ordering;
+use std::fmt::Debug;
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::str::FromStr;
+use std::sync::{Mutex, OnceLock};
+
+use hegel::{generators, Generator, TestCase};
+use r_description::lossless::{
+    RDescription as LosslessDesc, Relation, Relations, Version as LVersion,
+};
+use r_description::lossy::{
+    RDescription as LossyDesc, Relation as LossyRelation, Relations as LossyRelations, UrlEntry,
+};
+use r_description::{Version, VersionConstraint};
+
+// ---------------------------------------------------------------------------
+// The R oracle
+// ---------------------------------------------------------------------------
+
+const ORACLE: &str = r#"
+invisible(Sys.setlocale("LC_ALL", "C.UTF-8"))
+con <- file("stdin"); open(con, "r")
+enc <- function(s) paste0("v", URLencode(as.character(s), reserved = TRUE))
+dec <- function(s) URLdecode(substring(s, 2))
+handle <- function(cmd, a) {
+  if (cmd == "ver") {
+    enc(as.character(package_version(a[1])))
+  } else if (cmd == "cmp") {
+    x <- numeric_version(a[1]); y <- numeric_version(a[2])
+    enc(if (x < y) "-1" else if (x > y) "1" else "0")
+  } else if (cmd == "sat") {
+    # op required actual: how loadNamespace() checks a version requirement
+    enc(as.character(do.call(a[1], list(as.numeric_version(a[3]), as.numeric_version(a[2])))))
+  } else if (cmd == "deps") {
+    x <- tools:::.split_dependencies(a[1])
+    out <- character()
+    for (e in x) {
+      out <- c(out, enc(e$name),
+               enc(if (is.null(e$op)) "" else e$op),
+               enc(if (is.null(e$version)) "" else as.character(e$version)))
+    }
+    out
+  } else if (cmd == "dcf") {
+    m <- read.dcf(textConnection(a[1]), fields = a[2])
+    v <- m[1, 1]
+    if (is.na(v)) "N" else enc(v)
+  } else if (cmd == "logical") {
+    v <- tools:::config_val_to_logical(a[1])
+    if (is.na(v)) "N" else enc(as.character(v))
+  } else stop("unknown command ", cmd)
+}
+while (length(line <- readLines(con, n = 1, warn = FALSE)) > 0) {
+  parts <- strsplit(line, " ", fixed = TRUE)[[1]]
+  cmd <- parts[1]
+  a <- vapply(parts[-1], dec, "", USE.NAMES = FALSE)
+  res <- tryCatch(suppressWarnings(handle(cmd, a)),
+                  error = function(e) paste0("E", URLencode(conditionMessage(e), reserved = TRUE)))
+  cat(paste(res, collapse = " "), "\n", sep = "")
+  flush(stdout())
+}
+"#;
+
+struct R {
+    _child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+static ORACLE_R: OnceLock<Mutex<R>> = OnceLock::new();
+
+fn oracle() -> &'static Mutex<R> {
+    ORACLE_R.get_or_init(|| {
+        let path = std::path::Path::new(env!("CARGO_TARGET_TMPDIR")).join("hegel-oracle.R");
+        std::fs::write(&path, ORACLE).unwrap();
+        let mut child = Command::new("Rscript")
+            .arg("--vanilla")
+            .arg(&path)
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .expect("Rscript (r-base-core) must be installed");
+        let stdin = child.stdin.take().unwrap();
+        let stdout = BufReader::new(child.stdout.take().unwrap());
+        Mutex::new(R {
+            _child: child,
+            stdin,
+            stdout,
+        })
+    })
+}
+
+fn enc(s: &str) -> String {
+    let mut out = String::from("v");
+    for b in s.bytes() {
+        if b.is_ascii_alphanumeric() || b"-._~".contains(&b) {
+            out.push(b as char);
+        } else {
+            out.push_str(&format!("%{b:02X}"));
+        }
+    }
+    out
+}
+
+fn dec(s: &str) -> String {
+    let bytes = s.as_bytes();
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < bytes.len() {
+        if bytes[i] == b'%' && i + 2 < bytes.len() {
+            let h = std::str::from_utf8(&bytes[i + 1..i + 3]).unwrap();
+            out.push(u8::from_str_radix(h, 16).unwrap());
+            i += 3;
+        } else {
+            out.push(bytes[i]);
+            i += 1;
+        }
+    }
+    String::from_utf8(out).unwrap()
+}
+
+/// One request to R. `Ok(fields)` with `None` for `NA`; `Err(message)` when R raised an error.
+fn r(cmd: &str, args: &[&str]) -> Result<Vec<Option<String>>, String> {
+    let mut g = oracle().lock().unwrap();
+    let mut line = String::from(cmd);
+    for a in args {
+        line.push(' ');
+        line.push_str(&enc(a));
+    }
+    line.push('\n');
+    g.stdin.write_all(line.as_bytes()).unwrap();
+    g.stdin.flush().unwrap();
+    let mut resp = String::new();
+    g.stdout.read_line(&mut resp).unwrap();
+    assert!(!resp.is_empty(), "the R oracle died");
+    let mut out = vec![];
+    for f in resp.trim_end_matches('\n').split(' ') {
+        if f.is_empty() {
+            continue;
+        }
+        match f.as_bytes()[0] {
+            b'v' => out.push(Some(dec(&f[1..]))),
+            b'N' => out.push(None),
+            b'E' => return Err(dec(&f[1..])),
+            _ => panic!("bad oracle field {f:?}"),
+        }
+    }
+    Ok(out)
+}
+
+/// `as.character(package_version(s))`, `None` when R rejects the string.
+fn r_version(s: &str) -> Option<String> {
+    r("ver", &[s]).ok().map(|v| v[0].clone().unwrap())
+}
+
+fn r_cmp(a: &str, b: &str) -> Ordering {
+    match r("cmp", &[a, b]).unwrap()[0].as_deref().unwrap() {
+        "-1" => Ordering::Less,
+        "0" => Ordering::Equal,
+        _ => Ordering::Greater,
+    }
+}
+
+/// `actual <op> required` the way `loadNamespace` evaluates a version requirement.
+fn r_satisfied(op: &str, required: &str, actual: &str) -> bool {
+    r("sat", &[op, required, actual]).unwrap()[0].as_deref() == Some("TRUE")
+}
+
+/// A relation as R sees it: name, and `(op, version)` with the version normalised.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+struct Rel {
+    name: String,
+    constraint: Option<(String, String)>,
+}
+
+fn r_deps(text: &str) -> Result<Vec<Rel>, String> {
+    let f = r("deps", &[text])?;
+    let mut out = vec![];
+    for chunk in f.chunks(3) {
+        let name = chunk[0].clone().unwrap();
+        let op = chunk[1].clone().unwrap();
+        let ver = chunk[2].clone().unwrap();
+        if name.is_empty() {
+            continue; // an empty entry (`a,,b`): R keeps it, the crate drops it
+        }
+        out.push(Rel {
+            name,
+            constraint: if op.is_empty() { None } else { Some((op, ver)) },
+        });
+    }
+    Ok(out)
+}
+
+/// `read.dcf(text, fields = field)[1, 1]`.
+fn r_dcf(text: &str, field: &str) -> Result<Option<String>, String> {
+    r("dcf", &[text, field]).map(|v| v[0].clone())
+}
+
+fn r_logical(s: &str) -> Option<bool> {
+    r("logical", &[s]).unwrap()[0].as_deref().map(|v| v == "TRUE")
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+fn n(tc: &TestCase, lo: usize, hi: usize) -> usize {
+    tc.draw(int!(lo as i64, hi as i64)) as usize
+}
+
+fn pick<T: Clone + Debug + Send + Sync + 'static>(tc: &TestCase, items: &[T]) -> T {
+    tc.draw(generators::sampled_from(items.to_vec()).print_as_debug())
+}
+
+/// One chance in `k`.
+fn chance(tc: &TestCase, k: usize) -> bool {
+    n(tc, 1, k) == 1
+}
+
+/// The crate-independent normalisation of an R version string: integers joined by `.`.
+fn norm(v: &str) -> String {
+    v.split(['.', '-'])
+        .map(|c| c.parse::<u64>().unwrap().to_string())
+        .collect::<Vec<_>>()
+        .join(".")
+}
+
+fn lossy_rels(rels: &LossyRelations) -> Vec<Rel> {
+    rels.iter()
+        .map(|r| Rel {
+            name: r.name.clone(),
+            constraint: r
+                .version
+                .as_ref()
+                .map(|(c, v)| (c.to_string(), v.to_string())),
+        })
+        .collect()
+}
+
+fn lossless_rels(rels: &Relations) -> Vec<Rel> {
+    rels.relations()
+        .map(|r| Rel {
+            name: r.name(),
+            constraint: r
+                .version()
+                .map(|(c, v)| (c.to_string(), norm(v.as_str()))),
+        })
+        .collect()
+}
+
+const OPS: [&str; 6] = ["<", "<=", "==", "!=", ">", ">="];
+const LETTERS: &str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
+const NAME_CHARS: &str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.";
+
+fn arb_chars(tc: &TestCase, alphabet: &str, lo: usize, hi: usize) -> String {
+    let chars: Vec<char> = alphabet.chars().collect();
+    (0..n(tc, lo, hi)).map(|_| pick(tc, &chars)).collect()
+}
+
+/// An R package name: a letter, then letters, digits and dots.
+fn arb_name(tc: &TestCase) -> String {
+    let mut s = arb_chars(tc, LETTERS, 1, 1);
+    s.push_str(&arb_chars(tc, NAME_CHARS, 0, 6));
+    s
+}
+
+/// A version string of 2–5 components (`.`- or, when `dashes`, sometimes `-`-separated,
+/// occasionally with a leading zero); `nonzero_tail` keeps the last component ≥ 1.
+#[hegel::composite]
+fn arb_version(tc: &TestCase, nonzero_tail: bool, dashes: bool) -> String {
+    let k = n(tc, 2, 5);
+    let mut out = String::new();
+    for i in 0..k {
+        let mut c: u32 = pick(tc, &[0, 0, 1, 1, 2, 3, 4, 10, 12, 100, 9000]);
+        if i + 1 == k && nonzero_tail && c == 0 {
+            c = 1;
+        }
+        if i > 0 {
+            out.push(if dashes && chance(tc, 4) { '-' } else { '.' });
+        }
+        if chance(tc, 8) {
+            out.push('0');
+        }
+        out.push_str(&c.to_string());
+    }
+    out
+}
+
+/// Horizontal or continuation whitespace (a newline is always followed by indentation,
+/// so the text stays a valid DESCRIPTION field value).
+fn arb_ws(tc: &TestCase, at_least_one: bool) -> String {
+    let units = [" ", "  ", "\t", "\n  ", "\n\t", " \n   "];
+    let k = n(tc, if at_least_one { 1 } else { 0 }, 2);
+    let mut s = String::new();
+    for _ in 0..k {
+        let unit = pick(tc, &units);
+        // Two newlines in a row would make a whitespace-only line, which ends a DCF record.
+        if unit.contains('\n') && s.contains('\n') {
+            s.push(' ');
+        } else {
+            s.push_str(unit);
+        }
+    }
+    if at_least_one && s.is_empty() {
+        s.push(' ');
+    }
+    s
+}
+
+/// A relations field value R accepts, and the relations it lists: distinct names, each
+/// optionally `(<op><ws>version)`, comma-separated with arbitrary (continuation) whitespace.
+/// With `in_field` there is no leading or trailing whitespace.
+#[hegel::composite]
+fn arb_relations(tc: &TestCase, in_field: bool) -> (String, Vec<Rel>) {
+    let count = n(tc, 0, 5);
+    let mut names = std::collections::BTreeSet::new();
+    let mut text = if in_field {
+        String::new()
+    } else {
+        arb_ws(tc, false)
+    };
+    let mut rels = vec![];
+    for i in 0..count {
+        let mut name = arb_name(tc);
+        while !names.insert(name.clone()) {
+            name.push('x');
+        }
+        if i > 0 {
+            text.push_str(&arb_ws(tc, false));
+            text.push(',');
+            text.push_str(&arb_ws(tc, false));
+        }
+        text.push_str(&name);
+        let constraint = if chance(tc, 2) {
+            let op = pick(tc, &OPS).to_string();
+            let ver = tc.draw(arb_version(false, true));
+            text.push_str(&arb_ws(tc, false));
+            text.push('(');
+            text.push_str(&arb_ws(tc, false));
+            text.push_str(&op);
+            text.push_str(&arb_ws(tc, true));
+            text.push_str(&ver);
+            text.push(')');
+            Some((op, norm(&ver)))
+        } else {
+            None
+        };
+        rels.push(Rel { name, constraint });
+    }
+    if !in_field && count > 0 {
+        text.push_str(&arb_ws(tc, false));
+    }
+    (text, rels)
+}
+
+fn constraint_of(op: &str) -> VersionConstraint {
+    VersionConstraint::from_str(op).unwrap()
+}
+
+fn new_relation(rel: &Rel, spelled: Option<&str>) -> Relation {
+    match &rel.constraint {
+        None => Relation::simple(&rel.name),
+        Some((op, ver)) => Relation::new(
+            &rel.name,
+            Some((
+                constraint_of(op),
+                LVersion::from_str(spelled.unwrap_or(ver)).unwrap(),
+            )),
+        ),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Versions
+// ---------------------------------------------------------------------------
+
+/// `Version` parses and orders like `numeric_version` (away from the pinned trailing-zero
+/// shape: the last component is never 0).
+#[hegel::test]
+fn versions_compare_like_numeric_version(tc: TestCase) {
+    let a = tc.draw(arb_version(true, true));
+    let b = tc.draw(arb_version(true, true));
+    let va = Version::from_str(&a).unwrap();
+    let vb = Version::from_str(&b).unwrap();
+    assert_eq!(va.to_string(), r_version(&a).unwrap(), "normalisation of {a:?}");
+    assert_eq!(vb.to_string(), r_version(&b).unwrap(), "normalisation of {b:?}");
+    let expected = r_cmp(&a, &b);
+    assert_eq!(va.cmp(&vb), expected, "{a:?} vs {b:?}");
+    assert_eq!(va == vb, expected == Ordering::Equal, "{a:?} == {b:?}");
+    // The lossless `Version` keeps the spelling but must order the same way.
+    let la = LVersion::from_str(&a).unwrap();
+    let lb = LVersion::from_str(&b).unwrap();
+    assert_eq!(la.as_str(), a);
+    assert_eq!(la.cmp(&lb), expected, "lossless {a:?} vs {b:?}");
+    assert_eq!(la.to_string(), a, "lossless Display keeps the spelling");
+}
+
+/// Version syntax: `Version::from_str` accepts exactly what `package_version` accepts.
+#[hegel::test]
+fn version_syntax_agrees_with_package_version(tc: TestCase) {
+    let s = arb_chars(&tc, "0123456789.-", 0, 8);
+    let ours = Version::from_str(&s);
+    let theirs = r_version(&s);
+    assert_eq!(
+        ours.is_ok(),
+        theirs.is_some(),
+        "{s:?}: crate {ours:?}, R {theirs:?}"
+    );
+    if let (Ok(v), Some(t)) = (ours, theirs) {
+        assert_eq!(v.to_string(), t, "{s:?}");
+    }
+}
+
+/// Pinned (r-description/1): `numeric_version("1.2") == numeric_version("1.2.0")` in R —
+/// trailing zero components do not count, and `loadNamespace` checks requirements with
+/// exactly that comparison — but the crate orders by length.
+#[hegel::test]
+fn trailing_zero_components_compare_equal_like_r(tc: TestCase) {
+    let a = Version::from_str("1.2").unwrap();
+    let b = Version::from_str("1.2.0").unwrap();
+    assert_eq!(r_cmp("1.2", "1.2.0"), Ordering::Equal);
+    assert_eq!(a.cmp(&b), Ordering::Equal, "1.2 vs 1.2.0");
+    assert!(a == b, "1.2 == 1.2.0");
+    let rel: LossyRelation = "R (>= 3.5.0)".parse().unwrap();
+    let r35 = |_: &str| -> Option<Version> { Some(Version::from_str("3.5").unwrap()) };
+    assert!(
+        rel.satisfied_by(r35),
+        "R 3.5 satisfies `R (>= 3.5.0)` in R"
+    );
+    let base = tc.draw(arb_version(false, false));
+    let zeros = ".0".repeat(n(&tc, 1, 3));
+    let padded = format!("{base}{zeros}");
+    assert_eq!(r_cmp(&base, &padded), Ordering::Equal);
+    assert_eq!(
+        Version::from_str(&base).unwrap().cmp(&Version::from_str(&padded).unwrap()),
+        Ordering::Equal,
+        "{base:?} vs {padded:?}"
+    );
+}
+
+/// Pinned (r-description/2): a `+` is not part of an R version component (`package_version`
+/// rejects `1.+2`), but `u32::from_str` accepts a leading `+`, so the crate parses it.
+#[hegel::test]
+fn plus_signs_are_not_version_components(tc: TestCase) {
+    assert!(r_version("1.+2").is_none());
+    assert!(Version::from_str("1.+2").is_err(), "`1.+2` parsed: {:?}", Version::from_str("1.+2"));
+    let base = tc.draw(arb_version(false, false));
+    let parts: Vec<&str> = base.split('.').collect();
+    let i = n(&tc, 0, parts.len() - 1);
+    let s = parts
+        .iter()
+        .enumerate()
+        .map(|(j, p)| if j == i { format!("+{p}") } else { p.to_string() })
+        .collect::<Vec<_>>()
+        .join(".");
+    assert!(r_version(&s).is_none(), "{s:?}");
+    assert!(Version::from_str(&s).is_err(), "{s:?} parsed");
+}
+
+// ---------------------------------------------------------------------------
+// Relations
+// ---------------------------------------------------------------------------
+
+/// Both relation parsers read an R-valid relations field like `tools:::.split_dependencies`;
+/// the lossless tree keeps the text; `wrap_and_sort` canonicalises to the sorted model.
+#[hegel::test]
+fn relations_parse_like_r(tc: TestCase) {
+    let (text, model) = tc.draw(arb_relations(false).print_as_debug());
+    let theirs = r_deps(&text).unwrap_or_else(|e| panic!("R rejected {text:?}: {e}"));
+    assert_eq!(theirs, model, "the generator disagrees with R on {text:?}");
+
+    let lossy = LossyRelations::from_str(&text).unwrap_or_else(|e| panic!("lossy: {text:?}: {e}"));
+    assert_eq!(lossy_rels(&lossy), model, "lossy parse of {text:?}");
+    let again = LossyRelations::from_str(&lossy.to_string()).unwrap();
+    assert_eq!(again, lossy, "lossy Display re-parses: {:?}", lossy.to_string());
+
+    let lossless = Relations::from_str(&text).unwrap_or_else(|e| panic!("lossless: {text:?}: {e}"));
+    assert_eq!(lossless.to_string(), text, "text identity");
+    assert_eq!(lossless_rels(&lossless), model, "lossless parse of {text:?}");
+    assert_eq!(lossless.len(), model.len());
+    assert_eq!(lossless.is_empty(), model.is_empty());
+    for (i, rel) in model.iter().enumerate() {
+        let got = lossless.get_relation(i).unwrap();
+        assert_eq!(got.name(), rel.name);
+        // A relation's own text re-parses to itself.
+        let solo = Relation::from_str(&got.to_string()).unwrap();
+        assert_eq!(solo.name(), rel.name);
+        assert_eq!(
+            solo.version().map(|(c, v)| (c.to_string(), norm(v.as_str()))),
+            rel.constraint
+        );
+    }
+
+    // wrap_and_sort: sorted by name, constraint, version; single spaces; the version spelling kept.
+    let sorted = Relations::from_str(&text).unwrap().wrap_and_sort();
+    let mut expected: Vec<(String, Option<(VersionConstraint, Vec<u32>)>, String)> = vec![];
+    for rel in lossless.relations() {
+        let key = rel
+            .version()
+            .map(|(c, v)| (c, v.components.clone()));
+        let spelled = rel
+            .version()
+            .map(|(c, v)| format!(" ({c} {})", v.as_str()))
+            .unwrap_or_default();
+        expected.push((rel.name(), key, format!("{}{spelled}", rel.name())));
+    }
+    expected.sort_by(|a, b| {
+        a.0.cmp(&b.0).then_with(|| match (&a.1, &b.1) {
+            (Some((ca, va)), Some((cb, vb))) => ca.cmp(cb).then_with(|| {
+                va.iter()
+                    .zip(vb.iter())
+                    .map(|(x, y)| x.cmp(y))
+                    .find(|o| *o != Ordering::Equal)
+                    .unwrap_or_else(|| va.len().cmp(&vb.len()))
+            }),
+            (Some(_), None) => Ordering::Greater,
+            (None, Some(_)) => Ordering::Less,
+            (None, None) => Ordering::Equal,
+        })
+    });
+    let expected_text = expected
+        .iter()
+        .map(|e| e.2.clone())
+        .collect::<Vec<_>>()
+        .join(", ");
+    assert_eq!(sorted.to_string(), expected_text, "wrap_and_sort of {text:?}");
+}
+
+/// A constrained relation is satisfied exactly when R's `do.call(op, list(actual, required))`
+/// says so (versions away from the pinned trailing-zero shape); an unconstrained one is
+/// satisfied by any installed version.
+#[hegel::test]
+fn satisfaction_agrees_with_r(tc: TestCase) {
+    let name = arb_name(&tc);
+    let op = pick(&tc, &OPS);
+    let required = tc.draw(arb_version(true, true));
+    let actual = tc.draw(arb_version(true, true));
+    let text = format!("{name} ({op} {required})");
+    let expected = r_satisfied(op, &required, &actual);
+    let installed = Version::from_str(&actual).unwrap();
+    let lookup = |pkg: &str| -> Option<Version> {
+        if pkg == name { Some(installed.clone()) } else { None }
+    };
+    let lookup = &lookup;
+    let lossy: LossyRelation = text.parse().unwrap();
+    assert_eq!(lossy.satisfied_by(lookup), expected, "lossy {text:?} by {actual:?}");
+    let lossless: Relation = text.parse().unwrap();
+    assert_eq!(lossless.satisfied_by(lookup), expected, "lossless {text:?} by {actual:?}");
+    // A relation on another package is never satisfied by this lookup …
+    let other = format!("{name}x ({op} {required})");
+    assert!(!LossyRelation::from_str(&other).unwrap().satisfied_by(lookup));
+    assert!(!Relation::from_str(&other).unwrap().satisfied_by(lookup));
+    // … and an unconstrained one is satisfied by any version of the package.
+    assert!(LossyRelation::from_str(&name).unwrap().satisfied_by(lookup));
+    assert!(Relation::from_str(&name).unwrap().satisfied_by(lookup));
+    let both: Relations = format!("{text}, {name}").parse().unwrap();
+    assert_eq!(both.satisfied_by(lookup), expected);
+    let both: LossyRelations = format!("{text}, {name}").parse().unwrap();
+    assert_eq!(both.satisfied_by(lookup), expected);
+}
