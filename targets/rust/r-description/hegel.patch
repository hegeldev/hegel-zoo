+// ---------------------------------------------------------------------------
+// Editing the lossless tree
+// ---------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+enum Edit {
+    Push(Rel),
+    Insert(usize, Rel),
+    Remove(usize),
+    Replace(usize, Rel),
+    SetVersion(usize, Option<(String, String)>),
+    DropConstraint(usize),
+}
+
+#[hegel::composite]
+fn arb_rel(tc: &TestCase) -> Rel {
+    let name = arb_name(tc);
+    let constraint = if chance(tc, 2) {
+        let op = pick(tc, &OPS).to_string();
+        let ver = tc.draw(arb_version(false, false));
+        Some((op, ver))
+    } else {
+        None
+    };
+    Rel { name, constraint }
+}
+
+fn check_tree(rels: &Relations, model: &[Rel], context: &str) {
+    let text = rels.to_string();
+    assert_eq!(rels.len(), model.len(), "{context}: len of {text:?}");
+    assert_eq!(lossless_rels(rels), model.to_vec(), "{context}: tree {text:?}");
+    let reparsed = Relations::from_str(&text)
+        .unwrap_or_else(|e| panic!("{context}: {text:?} does not re-parse: {e}"));
+    assert_eq!(lossless_rels(&reparsed), model.to_vec(), "{context}: re-parse of {text:?}");
+    // R's `.split_dependencies` drops duplicate entries (`unique`), so only compare when
+    // the model has none.
+    let mut distinct = model.to_vec();
+    distinct.sort();
+    distinct.dedup();
+    if !model.is_empty() && distinct.len() == model.len() {
+        let theirs = r_deps(&text).unwrap_or_else(|e| panic!("{context}: R rejects {text:?}: {e}"));
+        assert_eq!(theirs, model.to_vec(), "{context}: R reads {text:?}");
+    }
+}
+
+/// Every editing method of `lossless::Relations`/`Relation`, applied to a parsed field, keeps
+/// the tree, its text (re-parsed by the crate and by R) and a `Vec` model in step.
+/// `insert` at index 0 of a one-relation list is pinned separately.
+#[hegel::test]
+fn lossless_edits_follow_a_model(tc: TestCase) {
+    let (text, mut model) = tc.draw(arb_relations(false).print_as_debug());
+    let mut rels = Relations::from_str(&text).unwrap();
+    let mut log = vec![format!("parse {text:?}")];
+    for _ in 0..n(&tc, 1, 6) {
+        let len = model.len();
+        let kind = n(&tc, 0, if len == 0 { 1 } else { 5 });
+        let edit = match kind {
+            0 => Edit::Push(tc.draw(arb_rel().print_as_debug())),
+            1 => {
+                let mut idx = n(&tc, 0, len);
+                if len == 1 && idx == 0 {
+                    idx = 1; // pinned: insert(0, _) into a one-relation list
+                }
+                Edit::Insert(idx, tc.draw(arb_rel().print_as_debug()))
+            }
+            2 => Edit::Remove(n(&tc, 0, len - 1)),
+            3 => Edit::Replace(n(&tc, 0, len - 1), tc.draw(arb_rel().print_as_debug())),
+            4 => {
+                let c = tc.draw(arb_rel().print_as_debug()).constraint;
+                Edit::SetVersion(n(&tc, 0, len - 1), c)
+            }
+            _ => Edit::DropConstraint(n(&tc, 0, len - 1)),
+        };
+        log.push(format!("{edit:?}"));
+        match &edit {
+            Edit::Push(rel) => {
+                rels.push(new_relation(rel, None));
+                model.push(rel.normalized());
+            }
+            Edit::Insert(idx, rel) => {
+                rels.insert(*idx, new_relation(rel, None));
+                model.insert(*idx, rel.normalized());
+            }
+            Edit::Remove(idx) => {
+                let removed = rels.remove_relation(*idx);
+                let gone = model.remove(*idx);
+                assert_eq!(removed.name(), gone.name, "{}", log.join("; "));
+            }
+            Edit::Replace(idx, rel) => {
+                rels.replace(*idx, new_relation(rel, None));
+                model[*idx] = rel.normalized();
+            }
+            Edit::SetVersion(idx, c) => {
+                let mut rel = rels.get_relation(*idx).unwrap();
+                rel.set_version(
+                    c.as_ref()
+                        .map(|(op, v)| (constraint_of(op), LVersion::from_str(v).unwrap())),
+                );
+                model[*idx].constraint = c.as_ref().map(|(op, v)| (op.clone(), norm(v)));
+                assert_eq!(
+                    rel.version().map(|(c, v)| (c.to_string(), norm(v.as_str()))),
+                    model[*idx].constraint,
+                    "{}: the edited relation itself",
+                    log.join("; ")
+                );
+            }
+            Edit::DropConstraint(idx) => {
+                let mut rel = rels.get_relation(*idx).unwrap();
+                let had = rel.drop_constraint();
+                assert_eq!(had, model[*idx].constraint.is_some(), "{}", log.join("; "));
+                model[*idx].constraint = None;
+                assert_eq!(rel.version(), None, "{}", log.join("; "));
+            }
+        }
+        check_tree(&rels, &model, &log.join("; "));
+    }
+}
+
+impl Rel {
+    fn normalized(&self) -> Rel {
+        Rel {
+            name: self.name.clone(),
+            constraint: self
+                .constraint
+                .as_ref()
+                .map(|(op, v)| (op.clone(), norm(v))),
+        }
+    }
+}
+
+/// Pinned (r-description/4): `Relations::insert(0, _)` into a list holding exactly one
+/// relation writes the new relation without a separating comma.
+#[hegel::test]
+fn insert_at_the_start_of_a_single_relation(tc: TestCase) {
+    let mut rels: Relations = "cli (>= 1.0)".parse().unwrap();
+    rels.insert(0, Relation::simple("R"));
+    assert_eq!(rels.to_string(), "R, cli (>= 1.0)");
+    let first = tc.draw(arb_rel().print_as_debug());
+    let second = tc.draw(arb_rel().print_as_debug());
+    let mut rels = Relations::from(vec![new_relation(&first, None)]);
+    rels.insert(0, new_relation(&second, None));
+    check_tree(&rels, &[second.normalized(), first.normalized()], "insert(0) into one");
+}
