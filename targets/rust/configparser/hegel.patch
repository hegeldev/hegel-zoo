+// ---------------------------------------------------------------- the documentation
+
+#[test]
+fn doc_examples() {
+    let mut config = Ini::new();
+    let map = config.read("[2000s]\n    2020 = bad".to_string()).unwrap();
+    assert_eq!(map["2000s"]["2020"].clone().unwrap(), "bad");
+    config
+        .read_and_append("[2000s]\n2020 = terrible\n2023 = better".to_string())
+        .unwrap();
+    assert_eq!(config.get("2000s", "2020").unwrap(), "terrible");
+    assert_eq!(config.get("2000s", "2023").unwrap(), "better");
+    let default = IniDefault::default();
+    assert_eq!(default.default_section, "default");
+    assert_eq!(default.comment_symbols, vec![';', '#']);
+    assert_eq!(default.delimiters, vec!['=', ':']);
+    assert!(
+        !default.case_sensitive
+            && !default.multiline
+            && default.enable_inline_comments
+            && !default.cascade_defaults
+    );
+    let mut config = Ini::new();
+    config.load("tests/test.ini").unwrap();
+    assert_eq!(
+        config.get("TOPSECRET", "KFC").unwrap(),
+        "the secret herb is orega-"
+    );
+    assert_eq!(config.get("topsecret", "Empty string").unwrap(), "");
+    assert_eq!(config.get("topsecret", "None string"), None);
+    assert_eq!(config.get("spacing", "indented").unwrap(), "indented");
+    assert_eq!(config.getuint("values", "Uint").unwrap().unwrap(), 31415);
+    assert_eq!(config.getint("values", "Int").unwrap().unwrap(), -31415);
+    assert_eq!(config.getfloat("values", "Float").unwrap().unwrap(), 3.1415);
+    assert!(config.getbool("values", "Bool").unwrap().unwrap());
+    assert!(!config
+        .getboolcoerce("values", "Boolcoerce")
+        .unwrap()
+        .unwrap());
+    let mut config = Ini::new();
+    config.set_cascade_defaults(true);
+    config.load("tests/test_cascade_defaults.ini").unwrap();
+    assert_eq!(
+        config.get("mysection", "fallback_key"),
+        Some(String::from("fallback value"))
+    );
+    let mut config = Ini::new();
+    config
+        .read("[topsecrets]\nValueless key".to_string())
+        .unwrap();
+    config
+        .get_mut_map()
+        .get_mut("topsecrets")
+        .unwrap()
+        .insert(String::from("nuclear launch codes"), None);
+    assert_eq!(config.get("topsecrets", "nuclear launch codes"), None);
+    assert_eq!(
+        WriteOptions::new_with_params(true, 2, 1).multiline_line_indentation,
+        2
+    );
+}
