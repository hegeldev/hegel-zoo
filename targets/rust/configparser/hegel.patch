+//! Hegel property tests for `configparser`.
+//!
+//! The crate is "inspired by Python's `configparser`" and documents its own syntax (sections,
+//! `=`/`:` delimiters, `;`/`#` comments, inline comments, case-insensitive names, valueless
+//! keys, indented continuation lines).  Where that syntax and Python's coincide, Python is the
+//! oracle: one `python3` child holds a `ConfigParser` configured to the crate's defaults
+//! (`inline_comment_prefixes=(';', '#')`, `allow_no_value`, `strict=False`, no interpolation,
+//! `empty_lines_in_values`) and the generated text keeps to the intersection of the two grammars
+//! (no padding inside `[ ]`, inline comments preceded by whitespace, no continuation line that
+//! starts with `[`, no lowercase `default` section).  The rest — the write/read round trip the
+//! rustdoc calls "always safe", the map editing API, the typed getters — is checked against small
+//! models of the documentation.
+
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader, Write};
+use std::ops::RangeInclusive;
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::sync::{Mutex, OnceLock};
+
+use configparser::ini::{Ini, IniDefault, WriteOptions};
+use hegel::generators::Generator as _;
+use hegel::{generators, TestCase};
+
+type Map = HashMap<String, HashMap<String, Option<String>>>;
+
+// ---------------------------------------------------------------- generators
+
+/// Section names both sides read the same way: no padding, no comment symbol, nothing that
+/// casefolds to `default` except Python's own `DEFAULT`.
+const SECTIONS: &[&str] = &[
+    "a", "b", "sec", "DEFAULT", "Mixed", "x.y", "a b", "c]d", "1",
+];
+/// Keys: no leading `[` (a header attempt for the crate, a key for Python), no delimiter, no
+/// comment symbol.
+const KEYS: &[&str] = &["k", "key", "K2", "k.x", "a b", "c]d", "\u{e9}", "z"];
+/// Values: no comment symbol (inline comments are generated separately).
+const VALUES: &[&str] = &[
+    "v", "", "a b", "x=y", "1", "True", "[v]", "\u{e9}", "a:b", "0.5", "yes",
+];
+/// Continuation text: values that do not start with `[` (the crate ends a value at a header,
+/// Python continues it).
+const CONT: &[&str] = &["v", "a b", "x=y", "1", "\u{e9}", "a:b", "c]d", "k"];
+const INLINE: &[&str] = &[" ;c", "\t#c", " # c ;d", "  ; x = y"];
+const DELIMS: &[&str] = &["=", " = ", ":", " : ", "= ", " :"];
+const COMMENTS: &[&str] = &[";c", "#c", ";", "# k = v", "; [s]"];
+/// Indentation units: spaces twice as often as tabs.
+const BLANKS: &[&str] = &[" ", " ", "\t"];
+
+fn sizes(range: RangeInclusive<usize>) -> generators::IntegerGenerator<usize> {
+    generators::integers()
+        .min_value(*range.start())
+        .max_value(*range.end())
+}
+
+/// One of the given strings.
+fn sampled(pool: &'static [&'static str]) -> impl hegel::PrintableGenerator<String> {
+    generators::sampled_from(pool).map(str::to_string)
+}
+
+/// `lo..=hi` blanks (the pool weights spaces over tabs, so `vecs`, not `text().alphabet()`).
+fn indent(lo: usize, hi: usize) -> impl hegel::PrintableGenerator<String> {
+    generators::vecs(generators::sampled_from(BLANKS))
+        .min_size(lo)
+        .max_size(hi)
+        .map(|units| units.concat())
+}
+
+/// `Some` of a draw from `g` with probability `p`, `None` otherwise; shrinks to `None`.
+fn maybe<T: hegel::PrettyPrintable>(
+    p: f64,
+    g: impl hegel::PrintableGenerator<T>,
+) -> impl hegel::PrintableGenerator<Option<T>> {
+    hegel::tuples!(generators::weighted_booleans(p), g).map(|(present, v)| present.then_some(v))
+}
+
+/// A draw from `g` with probability `p`, the empty string otherwise.
+fn maybe_str(
+    p: f64,
+    g: impl hegel::PrintableGenerator<String>,
+) -> impl hegel::PrintableGenerator<String> {
+    maybe(p, g).map(Option::unwrap_or_default)
+}
+
+/// A `[section]` header, with an inline comment one time in five.  Never indented: Python
+/// takes an indented header after a key as a continuation line, the crate documents that "a
+/// section header ends the value".
+fn header_line() -> impl hegel::PrintableGenerator<String> {
+    hegel::tuples!(sampled(SECTIONS), maybe_str(0.2, sampled(INLINE)))
+        .map(|(section, comment)| format!("[{section}]{comment}"))
+}
+
+/// An indented or flush key, with a delimiter and value four times in five and an inline
+/// comment one time in four.
+fn key_line() -> impl hegel::PrintableGenerator<String> {
+    let value = hegel::tuples!(sampled(DELIMS), sampled(VALUES))
+        .map(|(delim, value)| format!("{delim}{value}"));
+    hegel::tuples!(
+        indent(0, 3),
+        sampled(KEYS),
+        maybe_str(0.8, value),
+        maybe_str(0.25, sampled(INLINE))
+    )
+    .map(|(indent, key, value, comment)| format!("{indent}{key}{value}{comment}"))
+}
+
+/// Indented continuation text, with an inline comment one time in four.
+fn continuation_line() -> impl hegel::PrintableGenerator<String> {
+    hegel::tuples!(
+        indent(1, 8),
+        sampled(CONT),
+        maybe_str(0.25, sampled(INLINE))
+    )
+    .map(|(indent, text, comment)| format!("{indent}{text}{comment}"))
+}
+
+fn comment_line() -> impl hegel::PrintableGenerator<String> {
+    hegel::tuples!(indent(0, 3), sampled(COMMENTS)).map(|(indent, comment)| indent + &comment)
+}
+
+/// One ini line in the common grammar: a blank line or a comment one time in ten each, a header
+/// two, a key four, a continuation two.  Blank first: `one_of!` shrinks towards its first
+/// alternative.
+fn ini_line() -> impl hegel::PrintableGenerator<String> {
+    hegel::one_of!(
+        indent(0, 2),
+        comment_line(),
+        header_line(),
+        header_line(),
+        key_line(),
+        key_line(),
+        key_line(),
+        key_line(),
+        continuation_line(),
+        continuation_line(),
+    )
+}
+
+/// Up to eight newline-terminated lines; the final newline is dropped three times in ten.
+fn ini_text() -> impl hegel::PrintableGenerator<String> {
+    hegel::tuples!(
+        generators::vecs(ini_line()).max_size(8),
+        generators::weighted_booleans(0.3)
+    )
+    .map(|(lines, unterminated)| {
+        let mut text: String = lines.iter().map(|line| format!("{line}\n")).collect();
+        if unterminated {
+            text.pop();
+        }
+        text
+    })
+}
+
+/// `WriteOptions` with or without spaces around the delimiter, the multiline indentation and
+/// the blank lines between sections from the given ranges.
+fn write_options(
+    indentation: RangeInclusive<usize>,
+    blank_lines: RangeInclusive<usize>,
+) -> impl hegel::PrintableGenerator<WriteOptions> {
+    hegel::tuples!(
+        generators::booleans(),
+        sizes(indentation),
+        sizes(blank_lines)
+    )
+    .map(|(spaces, indentation, blank_lines)| {
+        WriteOptions::new_with_params(spaces, indentation, blank_lines)
+    })
+    .print_as_debug()
+}
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|x| format!("{:02x}", x)).collect()
+}
+
+fn unhex(s: &str) -> String {
+    let bytes: Vec<u8> = (0..s.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap())
+        .collect();
+    String::from_utf8(bytes).unwrap()
+}
+
+// ---------------------------------------------------------------- the Python oracle
+
+struct Proc {
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+    _child: Child,
+}
+
+const PY_SERVER: &str = r#"
+import sys, configparser
+def dec(h): return bytes.fromhex(h).decode()
+def enc(s): return s.encode().hex()
+for line in sys.stdin:
+    text = dec(line.strip())
+    p = configparser.ConfigParser(inline_comment_prefixes=(';', '#'), allow_no_value=True,
+                                  strict=False, interpolation=None, empty_lines_in_values=True)
+    try:
+        # sectionless keys are the crate's default section: Python's DEFAULT
+        p.read_string('[DEFAULT]\n' + text)
+    except AttributeError:
+        # Python 3.12: a continuation line after a valueless key ('NoneType' has no 'append');
+        # 3.13 raises MultilineContinuationError.  A Python bug, not a verdict.
+        print('pybug', flush=True)
+        continue
+    except configparser.Error:
+        print('err', flush=True)
+        continue
+    out = ['ok']
+    # the crate lowercases section names (case-insensitive by default); Python keeps them
+    for name, d in [('default', p._defaults)] + [(s.lower(), d) for s, d in p._sections.items()]:
+        out.append('s:' + enc(name))
+        for k, v in d.items():
+            out.append('k:' + enc(k) + '=' + ('_' if v is None else enc(v)))
+    print(' '.join(out), flush=True)
+"#;
+
+fn py() -> &'static Mutex<Proc> {
+    static PY: OnceLock<Mutex<Proc>> = OnceLock::new();
+    PY.get_or_init(|| {
+        let mut child = Command::new("python3")
+            .args(["-u", "-c", PY_SERVER])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .spawn()
+            .expect("python3 is needed as the oracle");
+        let stdin = child.stdin.take().unwrap();
+        let stdout = BufReader::new(child.stdout.take().unwrap());
+        Mutex::new(Proc {
+            stdin,
+            stdout,
+            _child: child,
+        })
+    })
+}
+
+enum Py {
+    Ok(Map),
+    Err,
+    PyBug,
+}
+
+fn python(text: &str) -> Py {
+    let mut py = py().lock().unwrap();
+    py.stdin
+        .write_all(format!("{}\n", hex(text)).as_bytes())
+        .unwrap();
+    let mut reply = String::new();
+    py.stdout.read_line(&mut reply).unwrap();
+    let mut tokens = reply.trim_end_matches('\n').split(' ');
+    match tokens.next().unwrap() {
+        "err" => Py::Err,
+        "pybug" => Py::PyBug,
+        _ => {
+            let mut map: Map = HashMap::new();
+            let mut current = String::new();
+            for tok in tokens {
+                if let Some(name) = tok.strip_prefix("s:") {
+                    current = unhex(name);
+                    assert!(
+                        map.insert(current.clone(), HashMap::new()).is_none(),
+                        "two Python sections read as {:?}: the generator must not produce that",
+                        current
+                    );
+                } else {
+                    let (k, v) = tok.strip_prefix("k:").unwrap().split_once('=').unwrap();
+                    let value = if v == "_" { None } else { Some(unhex(v)) };
+                    map.get_mut(&current).unwrap().insert(unhex(k), value);
+                }
+            }
+            Py::Ok(map)
+        }
+    }
+}
+
+fn multiline_ini() -> Ini {
+    let mut ini = Ini::new();
+    ini.set_multiline(true);
+    ini
+}
+
+/// `ini.read(text)`, rejecting the case when the crate refuses the text.
+fn read_or_reject(tc: &TestCase, ini: &mut Ini, text: &str) -> Map {
+    let parsed = ini.read(text.to_string());
+    tc.assume(parsed.is_ok());
+    parsed.unwrap()
+}
+
+// ---------------------------------------------------------------- properties: parsing
+
+/// On the common grammar, `read` gives Python's sections, keys and values (sections lowercased,
+/// as the crate documents; sectionless keys are the default section = Python's `DEFAULT`).
+#[hegel::test]
+fn parsing_agrees_with_python(tc: TestCase) {
+    let text = tc.draw(ini_text());
+    let mut ini = multiline_ini();
+    let ours = ini.read(text.clone());
+    match python(&text) {
+        // a continuation line after a valueless key crashes Python 3.12: no verdict
+        Py::PyBug => tc.assume(false),
+        Py::Err => assert!(
+            ours.is_err(),
+            "text {:?}: Python rejects, crate gives {:?}",
+            text,
+            ours
+        ),
+        Py::Ok(mut expected) => {
+            let mut ours =
+                ours.unwrap_or_else(|e| panic!("text {:?}: Python accepts, crate: {}", text, e));
+            // the crate creates its default section lazily; Python's DEFAULT always exists
+            let defaults = expected.remove("default").unwrap();
+            let our_defaults = ours.remove("default").unwrap_or_default();
+            assert_eq!(our_defaults, defaults, "text {:?}: default section", text);
+            assert_eq!(ours, expected, "text {:?}", text);
+        }
+    }
+}
+
+/// shlex-style contract of the parser's own knobs, against the parse of the same text: the
+/// `str`/stream/append entry points agree, `get_map`/`get_map_ref`/`sections` mirror the map, and
+/// `read_and_append` is a section-wise merge.
+#[hegel::test]
+fn entry_points_agree_and_append_merges(tc: TestCase) {
+    let text = tc.draw(ini_text());
+    let text2 = tc.draw(ini_text());
+    let mut ini = multiline_ini();
+    let map = read_or_reject(&tc, &mut ini, &text);
+    assert_eq!(&map, ini.get_map_ref());
+    assert_eq!(
+        ini.get_map(),
+        if map.is_empty() {
+            None
+        } else {
+            Some(map.clone())
+        }
+    );
+    let mut sections = ini.sections();
+    sections.sort();
+    let mut keys: Vec<String> = map.keys().cloned().collect();
+    keys.sort();
+    assert_eq!(sections, keys);
+    let mut streamed = multiline_ini();
+    assert_eq!(streamed.load_from_stream(text.as_bytes()), Ok(map.clone()));
+
+    let map2 = read_or_reject(&tc, &mut multiline_ini(), &text2);
+    let merged = ini.read_and_append(text2.clone()).unwrap();
+    let mut expected = map.clone();
+    for (section, entries) in map2 {
+        expected.entry(section).or_default().extend(entries);
+    }
+    assert_eq!(
+        merged, expected,
+        "read_and_append of {:?} onto {:?}",
+        text2, text
+    );
+    assert_eq!(&merged, ini.get_map_ref());
+}
+
+// ---------------------------------------------------------------- properties: writing
+
+/// "This is always safe since the configuration is validated during parsing": a parsed
+/// configuration, written with any `WriteOptions` (indentation ≥ 1), reads back to the same map,
+/// with multiline on or off.
+#[hegel::test]
+fn parsed_config_writes_and_reads_back(tc: TestCase) {
+    let text = tc.draw(ini_text());
+    let multiline = tc.draw(generators::weighted_booleans(0.6));
+    let opts = tc.draw(write_options(1..=6, 0..=2));
+    let mut ini = Ini::new();
+    ini.set_multiline(multiline);
+    let mut map = read_or_reject(&tc, &mut ini, &text);
+    let written = ini.pretty_writes(&opts);
+    let mut again = Ini::new();
+    again.set_multiline(multiline);
+    let reread = again.read(written.clone());
+    // the default section is written without a header, so an empty one has no representation
+    if map.get("default").is_some_and(|d| d.is_empty()) {
+        map.remove("default");
+    }
+    assert_eq!(
+        reread,
+        Ok(map),
+        "text {:?} written as {:?} (multiline {}, {:?})",
+        text,
+        written,
+        multiline,
+        opts
+    );
+    if opts == WriteOptions::default() {
+        assert_eq!(written, ini.writes());
+    }
+}
+
+const SHORT_KEYS: &[&str] = &["k", "key"];
+
+/// configparser/4: `multiline_line_indentation = 0` writes continuation lines flush left, which
+/// read back as keys.
+#[hegel::test]
+fn zero_indentation_output_reads_back(tc: TestCase) {
+    let key = tc.draw(sampled(SHORT_KEYS));
+    let cont = tc.draw(sampled(CONT));
+    let opts = tc.draw(write_options(0..=0, 0..=1));
+    let mut ini = multiline_ini();
+    let text = format!("[s]\n{}=a\n  {}\n", key, cont);
+    let map = ini.read(text.clone()).unwrap();
+    let written = ini.pretty_writes(&opts);
+    let mut again = multiline_ini();
+    assert_eq!(
+        again.read(written.clone()),
+        Ok(map),
+        "text {:?} written as {:?}",
+        text,
+        written
+    );
+}
+
+/// Keys for `set`: plain, containing each delimiter, padded.
+const SET_KEYS: &[&str] = &["k", "a=b", "c:d", " padded "];
+/// Second lines of a value: a header, comment lines, an inline comment.
+const SECOND_LINES: &[&str] = &["[b]", ";c", "#c", "x ;c"];
+/// Values with padding or an inline comment.
+const PADDED_VALUES: &[&str] = &[" v", "v ", "v ;c", "v #c"];
+
+/// A value for `set`: plain, with a trailing newline, padded, or two lines the second of which
+/// the parser reads as something else.
+fn set_value() -> impl hegel::PrintableGenerator<String> {
+    hegel::one_of!(
+        generators::just("plain".to_string()),
+        generators::just("v\n".to_string()),
+        sampled(PADDED_VALUES),
+        sampled(SECOND_LINES).map(|second| format!("a\n{second}")),
+    )
+}
+
+/// configparser/3: values put in with `set` are written verbatim, so a value whose line starts
+/// with `[` or a comment symbol, a key containing a delimiter, or padding around a value do not
+/// read back.
+#[hegel::test]
+fn set_values_write_and_read_back(tc: TestCase) {
+    let key = tc.draw(sampled(SET_KEYS));
+    let value = tc.draw(set_value());
+    let mut ini = multiline_ini();
+    ini.set("s", &key, Some(value.clone()));
+    let written = ini.writes();
+    let mut again = multiline_ini();
+    let reread = again.read(written.clone());
+    assert_eq!(
+        reread.as_ref().map(|m| m
+            .get("s")
+            .and_then(|s| s.get(key.trim().to_lowercase().as_str()))
+            .cloned()),
+        Ok(Some(Some(value.clone()))),
+        "set({:?}, {:?}) written as {:?} read back as {:?}",
+        key,
+        value,
+        written,
+        reread
+    );
+}
+
+// ---------------------------------------------------------------- properties: the map API
+
+const EDIT_SECTIONS: &[&str] = &["A", "a", "b", "Sec"];
+const EDIT_KEYS: &[&str] = &["K", "k", "x", "Y"];
+
+/// One operation of the map API.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Edit {
+    Get,
+    Set {
+        value: Option<String>,
+        via_setstr: bool,
+    },
+    RemoveKey,
+    RemoveSection,
+    Clear,
+}
+
+/// One step: an operation on a section and key.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+struct Step {
+    section: &'static str,
+    key: &'static str,
+    edit: Edit,
+}
+
+/// Two steps in seven read, two set (a value seven times in ten, through `set` or `setstr`),
+/// one removes the key, one the section; the seventh clears one time in five and reads
+/// otherwise.
+fn step() -> impl hegel::PrintableGenerator<Step> {
+    let set = || {
+        hegel::tuples!(maybe(0.7, sampled(VALUES)), generators::booleans())
+            .map(|(value, via_setstr)| Edit::Set { value, via_setstr })
+    };
+    let edit = hegel::one_of!(
+        generators::just(Edit::Get),
+        generators::just(Edit::Get),
+        set(),
+        set(),
+        generators::just(Edit::RemoveKey),
+        generators::just(Edit::RemoveSection),
+        generators::weighted_booleans(0.2).map(|clear| if clear { Edit::Clear } else { Edit::Get }),
+    );
+    hegel::tuples!(
+        generators::sampled_from(EDIT_SECTIONS),
+        generators::sampled_from(EDIT_KEYS),
+        edit
+    )
+    .map(|(section, key, edit)| Step { section, key, edit })
+}
+
+/// `set`/`setstr`/`get`/`remove_key`/`remove_section`/`clear`/`sections` against a `HashMap`
+/// model with the documented casefolding (lowercase unless `new_cs`).
+#[hegel::test]
+fn map_edits_follow_a_model(tc: TestCase) {
+    let cs = tc.draw(generators::weighted_booleans(0.3));
+    let steps = tc.draw(generators::vecs(step()).max_size(12));
+    let mut ini = if cs { Ini::new_cs() } else { Ini::new() };
+    let mut model: Map = HashMap::new();
+    let fold = |s: &str| if cs { s.to_string() } else { s.to_lowercase() };
+    for Step { section, key, edit } in steps {
+        match edit {
+            Edit::Set { value, via_setstr } => {
+                let previous = if via_setstr {
+                    ini.setstr(section, key, value.as_deref())
+                } else {
+                    ini.set(section, key, value.clone())
+                };
+                let expected = model
+                    .entry(fold(section))
+                    .or_default()
+                    .insert(fold(key), value);
+                assert_eq!(previous, expected, "set returns the previous value");
+            }
+            Edit::RemoveKey => {
+                let got = ini.remove_key(section, key);
+                let expected = model
+                    .get_mut(&fold(section))
+                    .and_then(|s| s.remove(&fold(key)));
+                assert_eq!(got, expected);
+            }
+            Edit::RemoveSection => {
+                let got = ini.remove_section(section);
+                assert_eq!(got, model.remove(&fold(section)));
+            }
+            Edit::Clear => {
+                ini.clear();
+                model.clear();
+            }
+            Edit::Get => {
+                let got = ini.get(section, key);
+                let expected = model
+                    .get(&fold(section))
+                    .and_then(|s| s.get(&fold(key)))
+                    .cloned()
+                    .flatten();
+                assert_eq!(got, expected, "get({:?}, {:?})", section, key);
+            }
+        }
+        assert_eq!(ini.get_map_ref(), &model);
+    }
+}
+
+#[rustfmt::skip]
+const TYPED_VALUES: &[&str] = &[
+    "1", "-7", "18446744073709551615", "3.5", "x", "True", "FALSE", "yes", "N", "on", "0", "", "1e3",
+];
+
+/// What `[s]` holds under `k`: nothing, a valueless key, or a value (three times in five).
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+enum Stored {
+    Absent,
+    Valueless,
+    Value(String),
+}
+
+fn stored() -> impl hegel::PrintableGenerator<Stored> {
+    let value = || sampled(TYPED_VALUES).map(Stored::Value);
+    hegel::one_of!(
+        generators::just(Stored::Absent),
+        generators::just(Stored::Valueless),
+        value(),
+        value(),
+        value(),
+    )
+}
+
+/// `getint`/`getuint`/`getfloat`/`getbool`/`getboolcoerce` are `str::parse` on the stored value
+/// (the documented spellings for `getboolcoerce`), `Ok(None)` for a missing key, and with
+/// `cascade_defaults` the default section's value stands in for a missing one.
+#[hegel::test]
+fn typed_getters_follow_the_docs(tc: TestCase) {
+    let cascade = tc.draw(generators::booleans());
+    let in_section = tc.draw(stored());
+    let in_default = tc.draw(maybe(0.6, sampled(TYPED_VALUES)));
+    let mut ini = Ini::new();
+    ini.set_cascade_defaults(cascade);
+    let in_section = match in_section {
+        Stored::Absent => None,
+        Stored::Valueless => {
+            ini.set("s", "k", None);
+            None
+        }
+        Stored::Value(v) => {
+            ini.set("s", "k", Some(v.clone()));
+            Some(v)
+        }
+    };
+    if let Some(v) = &in_default {
+        ini.set("default", "k", Some(v.clone()));
+    }
+    let effective = in_section.or(if cascade { in_default } else { None });
+    assert_eq!(ini.get("s", "k"), effective);
+    let e = effective.as_deref();
+    assert_eq!(
+        ini.getint("s", "k").ok(),
+        e.map_or(Some(None), |v| v.parse::<i64>().ok().map(Some))
+    );
+    assert_eq!(
+        ini.getuint("s", "k").ok(),
+        e.map_or(Some(None), |v| v.parse::<u64>().ok().map(Some))
+    );
+    assert_eq!(
+        ini.getfloat("s", "k").ok(),
+        e.map_or(Some(None), |v| v.parse::<f64>().ok().map(Some))
+    );
+    let strict = e.map_or(Some(None), |v| match v.to_ascii_lowercase().as_str() {
+        "true" => Some(Some(true)),
+        "false" => Some(Some(false)),
+        _ => None,
+    });
+    assert_eq!(ini.getbool("s", "k").ok(), strict);
+    let coerce = e.map_or(Some(None), |v| match v.to_lowercase().as_str() {
+        "true" | "yes" | "t" | "y" | "on" | "1" => Some(Some(true)),
+        "false" | "no" | "f" | "n" | "off" | "0" => Some(Some(false)),
+        _ => None,
+    });
+    assert_eq!(ini.getboolcoerce("s", "k").ok(), coerce);
+}
