+// ---------------------------------------------------------------- pinned
+
+const DEFAULT_NAMES: &[&str] = &["Top", "DEFAULT", "Main", "sEc"];
+
+/// configparser/1: the default section name is stored as given while headers are casefolded, so
+/// with `set_default_section("Top")` the sectionless keys land under `Top`, a `[Top]` header
+/// under `top`, and `get("Top", key)` (which casefolds) finds neither the former nor cascades.
+#[hegel::test]
+fn default_section_name_is_casefolded_like_headers(tc: TestCase) {
+    let name = tc.draw(generators::sampled_from(DEFAULT_NAMES));
+    let with_header = tc.draw(generators::booleans());
+    let mut ini = Ini::new();
+    ini.set_default_section(name);
+    let mut text = "k=v\n".to_string();
+    if with_header {
+        text.push_str(&format!("[{}]\nx=y\n", name));
+    }
+    let map = ini.read(text.clone()).unwrap();
+    assert_eq!(
+        ini.get(name, "k"),
+        Some("v".to_string()),
+        "text {:?} with default section {:?}: map {:?}",
+        text,
+        name,
+        map
+    );
+    assert_eq!(ini.get(&name.to_lowercase(), "k"), Some("v".to_string()));
+    assert_eq!(
+        map.len(),
+        1,
+        "one section, not a casefolded and a raw copy: {:?}",
+        map
+    );
+}
+
+/// Inline comment symbols distinct from the line comment symbols `;` and `#`.
+const OTHER_SYMBOLS: &[char] = &['!', '%', '@'];
+
+/// configparser/2: with inline comment symbols distinct from the line comment symbols, a line
+/// that is only an inline comment becomes a key named `""` — a key the parser refuses elsewhere
+/// ("Key cannot be empty") and one `writes()` cannot represent.
+#[hegel::test]
+fn inline_comment_only_line_is_a_comment(tc: TestCase) {
+    let sym = tc.draw(generators::sampled_from(OTHER_SYMBOLS));
+    let indent = tc.draw(indent(0, 2));
+    let mut ini = Ini::new();
+    ini.set_inline_comment_symbols(Some(&[sym]));
+    let text = format!("[s]\nk=v\n{}{} only a comment\n", indent, sym);
+    let map = ini.read(text.clone()).unwrap();
+    assert_eq!(map["s"].len(), 1, "text {:?}: {:?}", text, map);
+    assert!(!map["s"].contains_key(""));
+}
