+            "--",
+            "1.2.3",
+            "\0",
+        ];
+        let n = tc.draw(generators::integers::<usize>().max_value(30));
+        let mut s = String::new();
+        for _ in 0..n {
+            s.push_str(tc.draw(generators::sampled_from(fragments.clone())));
+            if tc.draw(generators::booleans()) {
+                s.push(' ');
+            }
+        }
+        drop(Wkt::<f64>::from_str(&s));
+    }
