+    #[hegel::test]
+    fn prop_parse_wkt_shaped_soup_never_panics(tc: hegel::TestCase) {
+        let fragments: Vec<&'static str> = vec![
+            "POINT",
+            "LINESTRING",
+            "POLYGON",
+            "MULTIPOINT",
+            "MULTILINESTRING",
+            "MULTIPOLYGON",
+            "GEOMETRYCOLLECTION",
