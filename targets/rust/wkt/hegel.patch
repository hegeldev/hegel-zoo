+    /// Parsing is case-insensitive in keywords and tolerant of extra
+    /// whitespace around parens and commas: a mutated serialization parses to
+    /// the same geometry as the canonical one.
+    #[hegel::test]
+    fn prop_parse_is_case_insensitive_and_whitespace_tolerant(tc: hegel::TestCase) {
+        let dim = pbt::draw_dimension(&tc);
+        let wkt = pbt::draw_wkt(&tc, dim, 1);
+        let canonical = wkt.to_string();
+        let mut mutated = String::new();
+        for ch in canonical.chars() {
+            match ch {
+                c if c.is_ascii_alphabetic() => {
+                    if tc.draw(generators::booleans()) {
+                        mutated.push(c.to_ascii_lowercase());
+                    } else {
+                        mutated.push(c.to_ascii_uppercase());
+                    }
+                }
+                '(' | ')' | ',' => {
+                    if tc.draw(generators::booleans()) {
+                        mutated.push_str(
+                            tc.draw(generators::sampled_from(vec![" ", "\t", "\n", "\r", "  "])),
+                        );
+                    }
+                    mutated.push(ch);
+                    if tc.draw(generators::booleans()) {
+                        mutated.push_str(
+                            tc.draw(generators::sampled_from(vec![" ", "\t", "\n", "\r", "  "])),
+                        );
+                    }
+                }
+                c => mutated.push(c),
+            }
+        }
+        let parsed = Wkt::<f64>::from_str(&mutated)
+            .unwrap_or_else(|e| panic!("failed to parse mutated WKT {mutated:?}: {e}"));
+        assert_eq!(parsed, wkt, "mutated form {mutated:?} parsed differently");
+    }
