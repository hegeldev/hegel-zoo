+    /// Write→parse must recover an equal geometry, and re-serializing must be a
+    /// fixpoint (the second serialization is byte-identical to the first).
+    #[hegel::test]
+    fn prop_write_parse_roundtrip_is_fixpoint(tc: hegel::TestCase) {
+        let wkt = pbt::draw_arbitrary_wkt(&tc);
+        let s1 = wkt.to_string();
+        let reparsed: Wkt<f64> = Wkt::from_str(&s1)
+            .unwrap_or_else(|e| panic!("failed to re-parse written WKT {s1:?}: {e}"));
+        assert_eq!(reparsed, wkt, "write→parse did not recover the value; wrote {s1:?}");
+        let s2 = reparsed.to_string();
+        assert_eq!(s2, s1, "write→parse→write is not a fixpoint");
+    }
+
+    /// The writer must not lose precision: every finite f64 coordinate
+    /// (including subnormals, ±0.0, and values at the extremes of the range)
+    /// must survive write→parse bit-for-bit.
+    #[hegel::test]
+    fn prop_point_coordinates_survive_roundtrip_bit_exact(tc: hegel::TestCase) {
+        let dim = pbt::draw_dimension(&tc);
+        let coord = pbt::draw_coord(&tc, dim);
+        let point = Wkt::Point(Point::new(Some(coord), dim));
+        let s = point.to_string();
+        let reparsed: Wkt<f64> =
+            Wkt::from_str(&s).unwrap_or_else(|e| panic!("failed to parse {s:?}: {e}"));
+        let Wkt::Point(p) = reparsed else {
+            panic!("expected a POINT back, got {reparsed:?}")
+        };
+        let c = p.coord().expect("expected a non-empty POINT back");
+        assert_eq!(
+            coord.x.to_bits(),
+            c.x.to_bits(),
+            "x: {:?} -> {s:?} -> {:?}",
+            coord.x,
+            c.x
+        );
+        assert_eq!(
+            coord.y.to_bits(),
+            c.y.to_bits(),
+            "y: {:?} -> {s:?} -> {:?}",
+            coord.y,
+            c.y
+        );
+        assert_eq!(
+            coord.z.map(f64::to_bits),
+            c.z.map(f64::to_bits),
+            "z: {:?} -> {s:?} -> {:?}",
+            coord.z,
+            c.z
+        );
+        assert_eq!(
+            coord.m.map(f64::to_bits),
+            c.m.map(f64::to_bits),
+            "m: {:?} -> {s:?} -> {:?}",
+            coord.m,
+            c.m
+        );
+    }
