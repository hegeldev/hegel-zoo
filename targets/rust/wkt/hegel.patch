+
+    /// Draw a geometry that is representable in geo-types: XY only, no empty
+    /// points (geo-types points cannot be empty), and polygon rings explicitly
+    /// closed (`geo_types::Polygon::new` closes rings, so an unclosed ring
+    /// would come back with an extra coordinate).
+    pub(crate) fn draw_geo_compatible_wkt(tc: &hegel::TestCase, depth: u32) -> Wkt<f64> {
+        let dim = Dimension::XY;
+        let max_choice = if depth == 0 { 5u8 } else { 6 };
+        match tc.draw(generators::integers::<u8>().max_value(max_choice)) {
+            0 => Wkt::Point(draw_point(tc, dim, false)),
+            1 => Wkt::LineString(draw_linestring(tc, dim, true)),
+            2 => Wkt::Polygon(draw_closed_polygon(tc)),
+            3 => Wkt::MultiPoint(draw_multipoint(tc, dim)),
+            4 => Wkt::MultiLineString(draw_multilinestring(tc, dim)),
+            5 => Wkt::MultiPolygon(draw_closed_multipolygon(tc)),
+            _ => {
+                let n = tc.draw(generators::integers::<usize>().max_value(3));
+                Wkt::GeometryCollection(GeometryCollection::new(
+                    (0..n)
+                        .map(|_| draw_geo_compatible_wkt(tc, depth - 1))
+                        .collect(),
+                    dim,
+                ))
+            }
+        }
+    }
+
+    fn draw_closed_ring(tc: &hegel::TestCase) -> LineString<f64> {
+        let mut coords = draw_coords(tc, Dimension::XY, 1, 4);
+        coords.push(coords[0]);
+        LineString::new(coords, Dimension::XY)
+    }
+
+    fn draw_closed_polygon(tc: &hegel::TestCase) -> Polygon<f64> {
+        let n = tc.draw(generators::integers::<usize>().max_value(3));
+        Polygon::new((0..n).map(|_| draw_closed_ring(tc)).collect(), Dimension::XY)
+    }
+
+    fn draw_closed_multipolygon(tc: &hegel::TestCase) -> MultiPolygon<f64> {
+        let n = tc.draw(generators::integers::<usize>().max_value(3));
+        let polygons = (0..n)
+            .map(|_| {
+                // non-empty: see draw_multipolygon
+                let n_rings = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+                Polygon::new(
+                    (0..n_rings).map(|_| draw_closed_ring(tc)).collect(),
+                    Dimension::XY,
+                )
+            })
+            .collect();
+        MultiPolygon::new(polygons, Dimension::XY)
+    }
 }
