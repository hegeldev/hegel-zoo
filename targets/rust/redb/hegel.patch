+
+// ==== Hegel property-based tests ====
+
+use hegel::generators;
+use std::collections::{BTreeMap, BTreeSet};
+
+const HEGEL_MM_TABLE: MultimapTableDefinition<u64, &[u8]> =
+    MultimapTableDefinition::new("hegel_multimap");
+
+// Property: an arbitrary sequence of multimap operations (insert / remove / remove_all / get)
+// agrees with a BTreeMap<u64, BTreeSet<Vec<u8>>> model after every operation: the returned
+// "was present" booleans match, removed/fetched value iterators yield exactly the model's
+// values in sorted order, and len() equals the total number of key-value pairs. Evidence:
+// `MultimapTable::insert`/`remove` docs ("Returns true if the key-value pair was present"),
+// `len` docs, and the maintainers' own fuzzer (fuzz/fuzz_targets/fuzz_redb.rs) which uses the
+// same reference model.
+#[hegel::test]
+fn hegel_multimap_matches_model(tc: hegel::TestCase) {
+    let tmpfile = create_tempfile();
+    let db = Database::create(tmpfile.path()).unwrap();
+    let mut model: BTreeMap<u64, BTreeSet<Vec<u8>>> = BTreeMap::new();
+    let txn = db.begin_write().unwrap();
+    {
+        let mut table = txn.open_multimap_table(HEGEL_MM_TABLE).unwrap();
+        let num_ops: usize = tc.draw(generators::integers::<usize>().max_value(60));
+        for _ in 0..num_ops {
+            // Mostly draw from a small key space so operations collide, but keep the full
+            // u64 range reachable.
+            let key: u64 = tc.draw(hegel::one_of!(
+                generators::integers::<u64>().max_value(15),
+                generators::integers::<u64>(),
+            ));
+            let op: u8 = tc.draw(generators::integers::<u8>().max_value(3));
+            match op {
+                0 => {
+                    let value: Vec<u8> = tc.draw(generators::binary().max_size(16));
+                    let existed = table.insert(&key, value.as_slice()).unwrap();
+                    let model_existed = !model.entry(key).or_default().insert(value);
+                    assert_eq!(existed, model_existed);
+                }
+                1 => {
+                    // Bias towards values that are actually present under this key.
+                    let candidates: Vec<Vec<u8>> = model
+                        .get(&key)
+                        .map(|s| s.iter().cloned().collect())
+                        .unwrap_or_default();
+                    let value: Vec<u8> =
+                        if !candidates.is_empty() && tc.draw(generators::booleans()) {
+                            tc.draw(generators::sampled_from(candidates))
+                        } else {
+                            tc.draw(generators::binary().max_size(16))
+                        };
+                    let existed = table.remove(&key, value.as_slice()).unwrap();
+                    let model_existed = model
+                        .get_mut(&key)
+                        .map(|s| s.remove(&value))
+                        .unwrap_or(false);
+                    if model.get(&key).is_some_and(|s| s.is_empty()) {
+                        model.remove(&key);
+                    }
+                    assert_eq!(existed, model_existed);
+                }
+                2 => {
+                    let removed_iter = table.remove_all(&key).unwrap();
+                    let removed: Vec<Vec<u8>> =
+                        removed_iter.map(|r| r.unwrap().value().to_vec()).collect();
+                    let expected: Vec<Vec<u8>> =
+                        model.remove(&key).unwrap_or_default().into_iter().collect();
+                    assert_eq!(removed, expected);
+                }
+                _ => {
+                    let got: Vec<Vec<u8>> = table
+                        .get(&key)
+                        .unwrap()
+                        .map(|r| r.unwrap().value().to_vec())
+                        .collect();
+                    let expected: Vec<Vec<u8>> = model
+                        .get(&key)
+                        .map(|s| s.iter().cloned().collect())
+                        .unwrap_or_default();
+                    assert_eq!(got, expected);
+                }
+            }
+            let model_len: u64 = model.values().map(|s| s.len() as u64).sum();
+            assert_eq!(table.len().unwrap(), model_len);
+        }
+    }
+    txn.commit().unwrap();
+
+    // Full comparison of committed state against the model.
+    let read_txn = db.begin_read().unwrap();
+    let table = read_txn.open_multimap_table(HEGEL_MM_TABLE).unwrap();
+    let mut model_iter = model.iter();
+    for item in table.iter().unwrap() {
+        let (key, values) = item.unwrap();
+        let (model_key, model_values) = model_iter.next().unwrap();
+        assert_eq!(key.value(), *model_key);
+        let actual_values: Vec<Vec<u8>> = values.map(|r| r.unwrap().value().to_vec()).collect();
+        let expected_values: Vec<Vec<u8>> = model_values.iter().cloned().collect();
+        assert_eq!(actual_values, expected_values);
+    }
+    assert!(model_iter.next().is_none());
+}
