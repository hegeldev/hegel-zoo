+
+// ==== Hegel property-based tests ====
+
+use hegel::generators::{self, Generator};
+use std::collections::BTreeMap;
+use std::ops::Bound;
+
+type NestedComposite = Vec<(Option<i64>, String)>;
+
+// Property: `Value::from_bytes` and `Value::as_bytes` are inverses, per the contract documented
+// on `Value::as_bytes` ("Implementations must ensure that as_bytes() and from_bytes() are
+// inverses"). Exercised through a nested composite type so the varint length encoding
+// (complex_types.rs), tuple encoding (tuple_types.rs), and Option encoding (types.rs) all
+// participate.
+#[hegel::test]
+fn hegel_value_roundtrip_nested_composite(tc: hegel::TestCase) {
+    let v: Vec<(Option<i64>, String)> = tc.draw(generators::vecs(generators::tuples!(
+        generators::optional(generators::integers::<i64>()),
+        generators::text(),
+    )));
+    let bytes = <NestedComposite as Value>::as_bytes(&v);
+    let decoded = <NestedComposite as Value>::from_bytes(bytes.as_ref());
+    assert_eq!(decoded, v);
+    let reencoded = <NestedComposite as Value>::as_bytes(&decoded);
+    assert_eq!(reencoded.as_ref() as &[u8], bytes.as_ref() as &[u8]);
+}
+
+type TupleKey = (u16, String, Option<i64>);
+
+// Property: the `Key::compare` implementation for tuple keys agrees with Rust's natural
+// lexicographic tuple ordering. Evidence: types.rs implements integer/str/Option compare by
+// decoding and delegating to `Ord`, and tuple_types.rs compares element-wise in order, so the
+// composed order must equal `Ord for (u16, String, Option<i64>)`. Range queries rely on this.
+#[hegel::test]
+fn hegel_key_compare_matches_rust_ordering(tc: hegel::TestCase) {
+    let a: (u16, String, Option<i64>) = tc.draw(generators::tuples!(
+        generators::integers::<u16>(),
+        generators::text(),
+        generators::optional(generators::integers::<i64>()),
+    ));
+    let b: (u16, String, Option<i64>) = tc.draw(generators::tuples!(
+        generators::integers::<u16>(),
+        generators::text(),
+        generators::optional(generators::integers::<i64>()),
+    ));
+    let a_bytes = <TupleKey as Value>::as_bytes(&a);
+    let b_bytes = <TupleKey as Value>::as_bytes(&b);
+    assert_eq!(
+        <TupleKey as Key>::compare(a_bytes.as_ref(), b_bytes.as_ref()),
+        a.cmp(&b)
+    );
+}
+
+fn assert_fixed_width_holds<T: Value>(value: &T::SelfType<'_>) {
+    let width = T::fixed_width().expect("only call this for fixed width types");
+    assert_eq!(
+        T::as_bytes(value).as_ref().len(),
+        width,
+        "fixed_width() does not match serialized length for {:?}",
+        T::type_name().name()
+    );
+}
+
+// Property: for every type whose `Value::fixed_width()` returns `Some(n)`, `as_bytes` produces
+// exactly `n` bytes. Evidence: the doc on `fixed_width` ("Width of a fixed type"), and the
+// B-tree layout code that omits per-entry length metadata for fixed width types, which is only
+// sound if every serialized value has that exact width.
+#[hegel::test]
+fn hegel_fixed_width_matches_serialized_len(tc: hegel::TestCase) {
+    let c: char = tc.draw(
+        generators::text()
+            .min_size(1)
+            .map(|s: String| s.chars().next().unwrap()),
+    );
+    assert_fixed_width_holds::<char>(&c);
+    let oc: Option<char> = tc.draw(generators::optional(
+        generators::text()
+            .min_size(1)
+            .map(|s: String| s.chars().next().unwrap()),
+    ));
+    assert_fixed_width_holds::<Option<char>>(&oc);
+    let t: (u32, i64) = tc.draw(generators::tuples!(
+        generators::integers::<u32>(),
+        generators::integers::<i64>(),
+    ));
+    assert_fixed_width_holds::<(u32, i64)>(&t);
+    let arr: [u16; 4] = tc.draw(generators::arrays(generators::integers::<u16>()));
+    assert_fixed_width_holds::<[u16; 4]>(&arr);
+    let b: bool = tc.draw(generators::booleans());
+    assert_fixed_width_holds::<bool>(&b);
+    let u: u128 = tc.draw(generators::integers::<u128>());
+    assert_fixed_width_holds::<u128>(&u);
+}
+
+const HEGEL_STR_TABLE: TableDefinition<&str, u64> = TableDefinition::new("hegel_str_range");
+
+// Property: `Table::range` over string keys returns exactly the entries `BTreeMap::range`
+// returns, in the same order, for arbitrary bound kinds, forward and reversed. Evidence:
+// `Key for &str` compares with `str::cmp`, and the `ReadableTable::range` doc example shows
+// BTreeMap-like range semantics.
+#[hegel::test]
+fn hegel_str_range_matches_btreemap(tc: hegel::TestCase) {
+    let entries: Vec<(String, u64)> = tc.draw(
+        generators::vecs(generators::tuples!(
+            generators::text().max_size(20),
+            generators::integers::<u64>(),
+        ))
+        .max_size(40),
+    );
+    let mut model: BTreeMap<String, u64> = BTreeMap::new();
+    let tmpfile = create_tempfile();
+    let db = Database::create(tmpfile.path()).unwrap();
+    let txn = db.begin_write().unwrap();
+    {
+        let mut table = txn.open_table(HEGEL_STR_TABLE).unwrap();
+        for (k, v) in &entries {
+            // Both sides use insert-overwrites-existing semantics, so duplicate keys agree.
+            table.insert(k.as_str(), v).unwrap();
+            model.insert(k.clone(), *v);
+        }
+    }
+    txn.commit().unwrap();
+
+    let mut lo: String = tc.draw(generators::text().max_size(20));
+    let mut hi: String = tc.draw(generators::text().max_size(20));
+    if lo > hi {
+        std::mem::swap(&mut lo, &mut hi);
+    }
+    let lo_kind: u8 = tc.draw(generators::integers::<u8>().max_value(2));
+    let hi_kind: u8 = tc.draw(generators::integers::<u8>().max_value(2));
+    // BTreeMap::range (the oracle) panics on start == end with both bounds excluded.
+    tc.assume(!(lo == hi && lo_kind == 2 && hi_kind == 2));
+    let start: Bound<&str> = match lo_kind {
+        0 => Bound::Unbounded,
+        1 => Bound::Included(lo.as_str()),
+        _ => Bound::Excluded(lo.as_str()),
+    };
+    let end: Bound<&str> = match hi_kind {
+        0 => Bound::Unbounded,
+        1 => Bound::Included(hi.as_str()),
+        _ => Bound::Excluded(hi.as_str()),
+    };
+    let reversed: bool = tc.draw(generators::booleans());
+
+    let read_txn = db.begin_read().unwrap();
+    let table = read_txn.open_table(HEGEL_STR_TABLE).unwrap();
+    let actual: Vec<(String, u64)> = if reversed {
+        table
+            .range::<&str>((start, end))
+            .unwrap()
+            .rev()
+            .map(|r| {
+                let (k, v) = r.unwrap();
+                (k.value().to_string(), v.value())
+            })
+            .collect()
+    } else {
+        table
+            .range::<&str>((start, end))
+            .unwrap()
+            .map(|r| {
+                let (k, v) = r.unwrap();
+                (k.value().to_string(), v.value())
+            })
+            .collect()
+    };
+    let expected: Vec<(String, u64)> = if reversed {
+        model
+            .range::<str, _>((start, end))
+            .rev()
+            .map(|(k, v)| (k.clone(), *v))
+            .collect()
+    } else {
+        model
+            .range::<str, _>((start, end))
+            .map(|(k, v)| (k.clone(), *v))
+            .collect()
+    };
+    assert_eq!(actual, expected);
+}
+
+const HEGEL_U64_TABLE: TableDefinition<u64, &[u8]> = TableDefinition::new("hegel_u64_bytes");
+
+// Property: data committed to a database file is intact after dropping the Database and
+// reopening it with `Database::open`. Evidence: the crate's core persistence contract
+// ("ACID, embedded key-value store", lib.rs docs) and `Database::open`'s documented behavior.
+#[hegel::test]
+fn hegel_reopen_preserves_contents(tc: hegel::TestCase) {
+    let entries: Vec<(u64, Vec<u8>)> = tc.draw(
+        generators::vecs(generators::tuples!(
+            generators::integers::<u64>(),
+            generators::binary().max_size(100),
+        ))
+        .max_size(50),
+    );
+    let mut model: BTreeMap<u64, Vec<u8>> = BTreeMap::new();
+    let tmpfile = create_tempfile();
+    {
+        let db = Database::create(tmpfile.path()).unwrap();
+        let txn = db.begin_write().unwrap();
+        {
+            let mut table = txn.open_table(HEGEL_U64_TABLE).unwrap();
+            for (k, v) in &entries {
+                table.insert(k, v.as_slice()).unwrap();
+                model.insert(*k, v.clone());
+            }
+        }
+        txn.commit().unwrap();
+    }
+
+    let db = Database::open(tmpfile.path()).unwrap();
+    let read_txn = db.begin_read().unwrap();
+    let table = read_txn.open_table(HEGEL_U64_TABLE).unwrap();
+    let actual: Vec<(u64, Vec<u8>)> = table
+        .iter()
+        .unwrap()
+        .map(|r| {
+            let (k, v) = r.unwrap();
+            (k.value(), v.value().to_vec())
+        })
+        .collect();
+    let expected: Vec<(u64, Vec<u8>)> = model.iter().map(|(k, v)| (*k, v.clone())).collect();
+    assert_eq!(actual, expected);
+}
+
+// Property: `Database::compact` preserves the logical contents of the database and leaves it
+// in a state that passes `check_integrity`. Evidence: `compact`'s documentation describes it
+// as a space-reclaiming operation, not a mutating one.
+#[hegel::test]
+fn hegel_compact_preserves_contents(tc: hegel::TestCase) {
+    let entries: Vec<(u64, Vec<u8>)> = tc.draw(
+        generators::vecs(generators::tuples!(
+            generators::integers::<u64>(),
+            generators::binary().max_size(200),
+        ))
+        .max_size(60),
+    );
+    let modulus: u64 = tc.draw(generators::integers::<u64>().min_value(1).max_value(8));
+    let mut model: BTreeMap<u64, Vec<u8>> = BTreeMap::new();
+    let tmpfile = create_tempfile();
+    let mut db = Database::create(tmpfile.path()).unwrap();
+    let txn = db.begin_write().unwrap();
+    {
+        let mut table = txn.open_table(HEGEL_U64_TABLE).unwrap();
+        for (k, v) in &entries {
+            table.insert(k, v.as_slice()).unwrap();
+            model.insert(*k, v.clone());
+        }
+    }
+    txn.commit().unwrap();
+    // Delete some entries so compaction has free pages to reclaim.
+    let txn = db.begin_write().unwrap();
+    {
+        let mut table = txn.open_table(HEGEL_U64_TABLE).unwrap();
+        table.retain(|k, _| k % modulus != 0).unwrap();
+        model.retain(|k, _| k % modulus != 0);
+    }
+    txn.commit().unwrap();
+
+    db.compact().unwrap();
+    assert!(db.check_integrity().unwrap());
+
+    let read_txn = db.begin_read().unwrap();
+    let table = read_txn.open_table(HEGEL_U64_TABLE).unwrap();
+    let actual: Vec<(u64, Vec<u8>)> = table
+        .iter()
+        .unwrap()
+        .map(|r| {
+            let (k, v) = r.unwrap();
+            (k.value(), v.value().to_vec())
+        })
+        .collect();
+    let expected: Vec<(u64, Vec<u8>)> = model.iter().map(|(k, v)| (*k, v.clone())).collect();
+    assert_eq!(actual, expected);
+}
