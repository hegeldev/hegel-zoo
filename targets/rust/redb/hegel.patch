+
+// ==== Hegel property-based tests ====
+
+use hegel::TestCase;
+use hegel::generators;
+use redb::Savepoint;
+use std::collections::BTreeMap;
+use std::ops::Bound;
+
+const HEGEL_MODEL_TABLE: TableDefinition<u64, &[u8]> = TableDefinition::new("hegel_model");
+// Bound the number of live savepoints so the test doesn't retain unbounded pages;
+// this protects the test's resources, not the library's contract.
+const HEGEL_MAX_SAVEPOINTS: usize = 5;
+
+// Stateful model test: run arbitrary interleavings of inserts, removes, gets, pops, range
+// scans, commits, aborts, and ephemeral savepoint create/restore against both a redb
+// `Database` and a `BTreeMap` model, asserting they agree after every step. The invariant
+// additionally checks after every rule that a fresh read transaction sees exactly the last
+// committed state (snapshot isolation). Evidence: redb's documented BTreeMap-based API
+// (lib.rs), the ACID transaction contract (`commit`/`abort` docs), the savepoint docs
+// ("Creates a snapshot of the current database state, which can be used to rollback the
+// database"; "Calling this method invalidates all Savepoints created after savepoint"),
+// and the maintainers' fuzzer (fuzz/fuzz_targets/fuzz_redb.rs) which maintains the same
+// reference model including savepoint snapshots.
+struct DbModelMachine {
+    // Field order matters for drop order: the open transaction and savepoints must be dropped
+    // before `db`, because `Database::drop` makes a final cleanup write transaction and blocks
+    // until any live `WriteTransaction` finishes.
+    txn: Option<WriteTransaction>,
+    savepoints: Vec<(Savepoint, BTreeMap<u64, Vec<u8>>)>,
+    db: Database,
+    committed: BTreeMap<u64, Vec<u8>>,
+    uncommitted: BTreeMap<u64, Vec<u8>>,
+    // Whether a table has been opened in the current write transaction (savepoint creation
+    // requires a non-dirty transaction, per `ephemeral_savepoint` docs).
+    txn_dirty: bool,
+}
+
+impl DbModelMachine {
+    // Draw a key, biased towards keys currently in the model so operations actually collide,
+    // with the full u64 range (including MIN/MAX) still reachable.
+    fn arb_key(&self, tc: &TestCase) -> u64 {
+        let keys: Vec<u64> = self.uncommitted.keys().copied().collect();
+        if !keys.is_empty() && tc.draw(generators::booleans()) {
+            tc.draw(generators::sampled_from(keys))
+        } else {
+            tc.draw(hegel::one_of!(
+                generators::integers::<u64>().max_value(500),
+                generators::integers::<u64>(),
+            ))
+        }
+    }
+}
+
+#[hegel::state_machine]
+impl DbModelMachine {
+    #[rule]
+    fn begin_txn(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_none());
+        self.txn = Some(self.db.begin_write().unwrap());
+        self.uncommitted = self.committed.clone();
+        self.txn_dirty = false;
+    }
+
+    #[rule]
+    fn commit(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some());
+        self.txn.take().unwrap().commit().unwrap();
+        self.committed = self.uncommitted.clone();
+    }
+
+    #[rule]
+    fn abort(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some());
+        self.txn.take().unwrap().abort().unwrap();
+        self.uncommitted = self.committed.clone();
+    }
+
+    #[rule]
+    fn insert(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some());
+        let key = self.arb_key(&tc);
+        let value: Vec<u8> = tc.draw(generators::binary().max_size(400));
+        let txn = self.txn.as_ref().unwrap();
+        let mut table = txn.open_table(HEGEL_MODEL_TABLE).unwrap();
+        let previous = table
+            .insert(&key, value.as_slice())
+            .unwrap()
+            .map(|g| g.value().to_vec());
+        let model_previous = self.uncommitted.insert(key, value);
+        assert_eq!(previous, model_previous);
+        self.txn_dirty = true;
+    }
+
+    // Insert a run of consecutive keys so the B-tree actually grows multiple levels.
+    #[rule]
+    fn insert_many(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some());
+        let n: u64 = tc.draw(generators::integers::<u64>().max_value(300));
+        // The subtraction bounds `start + n` away from overflow in the *test's* arithmetic;
+        // it does not restrict the library's domain.
+        let start: u64 = tc.draw(generators::integers::<u64>().max_value(u64::MAX - 301));
+        let txn = self.txn.as_ref().unwrap();
+        let mut table = txn.open_table(HEGEL_MODEL_TABLE).unwrap();
+        for key in start..(start + n) {
+            let value = key.to_le_bytes();
+            table.insert(&key, value.as_slice()).unwrap();
+            self.uncommitted.insert(key, value.to_vec());
+        }
+        self.txn_dirty = true;
+    }
+
+    #[rule]
+    fn remove(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some());
+        let key = self.arb_key(&tc);
+        let txn = self.txn.as_ref().unwrap();
+        let mut table = txn.open_table(HEGEL_MODEL_TABLE).unwrap();
+        let removed = table.remove(&key).unwrap().map(|g| g.value().to_vec());
+        assert_eq!(removed, self.uncommitted.remove(&key));
+        self.txn_dirty = true;
+    }
+
+    #[rule]
+    fn get(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some());
+        let key = self.arb_key(&tc);
+        let txn = self.txn.as_ref().unwrap();
+        let table = txn.open_table(HEGEL_MODEL_TABLE).unwrap();
+        let value = table.get(&key).unwrap().map(|g| g.value().to_vec());
+        assert_eq!(value, self.uncommitted.get(&key).cloned());
+        self.txn_dirty = true;
+    }
+
+    #[rule]
+    fn len_check(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some());
+        let txn = self.txn.as_ref().unwrap();
+        let table = txn.open_table(HEGEL_MODEL_TABLE).unwrap();
+        assert_eq!(table.len().unwrap(), self.uncommitted.len() as u64);
+        assert_eq!(table.is_empty().unwrap(), self.uncommitted.is_empty());
+        self.txn_dirty = true;
+    }
+
+    #[rule]
+    fn pop_first(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some());
+        let txn = self.txn.as_ref().unwrap();
+        let mut table = txn.open_table(HEGEL_MODEL_TABLE).unwrap();
+        let popped = table
+            .pop_first()
+            .unwrap()
+            .map(|(k, v)| (k.value(), v.value().to_vec()));
+        assert_eq!(popped, self.uncommitted.pop_first());
+        self.txn_dirty = true;
+    }
+
+    #[rule]
+    fn pop_last(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some());
+        let txn = self.txn.as_ref().unwrap();
+        let mut table = txn.open_table(HEGEL_MODEL_TABLE).unwrap();
+        let popped = table
+            .pop_last()
+            .unwrap()
+            .map(|(k, v)| (k.value(), v.value().to_vec()));
+        assert_eq!(popped, self.uncommitted.pop_last());
+        self.txn_dirty = true;
+    }
+
+    #[rule]
+    fn first_last_check(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some());
+        let txn = self.txn.as_ref().unwrap();
+        let table = txn.open_table(HEGEL_MODEL_TABLE).unwrap();
+        let first = table
+            .first()
+            .unwrap()
+            .map(|(k, v)| (k.value(), v.value().to_vec()));
+        let last = table
+            .last()
+            .unwrap()
+            .map(|(k, v)| (k.value(), v.value().to_vec()));
+        let model_first = self
+            .uncommitted
+            .first_key_value()
+            .map(|(k, v)| (*k, v.clone()));
+        let model_last = self
+            .uncommitted
+            .last_key_value()
+            .map(|(k, v)| (*k, v.clone()));
+        assert_eq!(first, model_first);
+        assert_eq!(last, model_last);
+        self.txn_dirty = true;
+    }
+
+    #[rule]
+    fn range_check(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some());
+        let mut lo: u64 = tc.draw(generators::integers::<u64>());
+        let mut hi: u64 = tc.draw(generators::integers::<u64>());
+        if lo > hi {
+            std::mem::swap(&mut lo, &mut hi);
+        }
+        let lo_kind: u8 = tc.draw(generators::integers::<u8>().max_value(2));
+        let hi_kind: u8 = tc.draw(generators::integers::<u8>().max_value(2));
+        // BTreeMap::range (the oracle) panics on start == end with both bounds excluded.
+        tc.assume(!(lo == hi && lo_kind == 2 && hi_kind == 2));
+        let start: Bound<u64> = match lo_kind {
+            0 => Bound::Unbounded,
+            1 => Bound::Included(lo),
+            _ => Bound::Excluded(lo),
+        };
+        let end: Bound<u64> = match hi_kind {
+            0 => Bound::Unbounded,
+            1 => Bound::Included(hi),
+            _ => Bound::Excluded(hi),
+        };
+        let reversed: bool = tc.draw(generators::booleans());
+        let txn = self.txn.as_ref().unwrap();
+        let table = txn.open_table(HEGEL_MODEL_TABLE).unwrap();
+        let map_entry =
+            |r: Result<(AccessGuard<'_, u64>, AccessGuard<'_, &[u8]>), StorageError>| {
+                let (k, v) = r.unwrap();
+                (k.value(), v.value().to_vec())
+            };
+        let actual: Vec<(u64, Vec<u8>)> = if reversed {
+            table
+                .range::<u64>((start, end))
+                .unwrap()
+                .rev()
+                .map(map_entry)
+                .collect()
+        } else {
+            table
+                .range::<u64>((start, end))
+                .unwrap()
+                .map(map_entry)
+                .collect()
+        };
+        let expected: Vec<(u64, Vec<u8>)> = if reversed {
+            self.uncommitted
+                .range((start, end))
+                .rev()
+                .map(|(k, v)| (*k, v.clone()))
+                .collect()
+        } else {
+            self.uncommitted
+                .range((start, end))
+                .map(|(k, v)| (*k, v.clone()))
+                .collect()
+        };
+        assert_eq!(actual, expected);
+        self.txn_dirty = true;
+    }
+
+    #[rule]
+    fn create_savepoint(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some() && !self.txn_dirty);
+        let savepoint = self.txn.as_ref().unwrap().ephemeral_savepoint().unwrap();
+        self.savepoints.push((savepoint, self.uncommitted.clone()));
+        if self.savepoints.len() > HEGEL_MAX_SAVEPOINTS {
+            self.savepoints.remove(0);
+        }
+    }
+
+    #[rule]
+    fn restore_savepoint(&mut self, tc: TestCase) {
+        tc.assume(self.txn.is_some() && !self.savepoints.is_empty());
+        let index: usize =
+            tc.draw(generators::integers::<usize>().max_value(self.savepoints.len() - 1));
+        let (savepoint, snapshot) = &self.savepoints[index];
+        self.txn
+            .as_mut()
+            .unwrap()
+            .restore_savepoint(savepoint)
+            .unwrap();
+        self.uncommitted = snapshot.clone();
+        // Restoring invalidates all savepoints created after this one (restore_savepoint docs).
+        self.savepoints.truncate(index + 1);
+        self.txn_dirty = true;
+    }
+
+    // Snapshot isolation: a fresh read transaction must see exactly the last committed state,
+    // regardless of any in-flight write transaction.
+    #[invariant]
+    fn committed_state_visible_to_readers(&self, _: TestCase) {
+        let read_txn = self.db.begin_read().unwrap();
+        let table = read_txn.open_table(HEGEL_MODEL_TABLE).unwrap();
+        assert_eq!(table.len().unwrap(), self.committed.len() as u64);
+        let actual: Vec<(u64, Vec<u8>)> = table
+            .iter()
+            .unwrap()
+            .map(|r| {
+                let (k, v) = r.unwrap();
+                (k.value(), v.value().to_vec())
+            })
+            .collect();
+        let expected: Vec<(u64, Vec<u8>)> = self
+            .committed
+            .iter()
+            .map(|(k, v)| (*k, v.clone()))
+            .collect();
+        assert_eq!(actual, expected);
+    }
+}
+
+#[hegel::test]
+fn hegel_model_matches_btreemap_across_transactions_and_savepoints(tc: TestCase) {
+    // Generate part of the database configuration too: a tiny cache forces page eviction.
+    // (`set_page_size` is cfg(test/fuzzing)-gated and not available to integration tests.)
+    let cache_size: usize = tc.draw(generators::sampled_from(vec![50_000usize, 1 << 30]));
+    let db = Database::builder()
+        .set_cache_size(cache_size)
+        .create_with_backend(InMemoryBackend::new())
+        .unwrap();
+    // Create the table up front so read transactions can always open it.
+    let txn = db.begin_write().unwrap();
+    drop(txn.open_table(HEGEL_MODEL_TABLE).unwrap());
+    txn.commit().unwrap();
+
+    let machine = DbModelMachine {
+        txn: None,
+        savepoints: Vec::new(),
+        db,
+        committed: BTreeMap::new(),
+        uncommitted: BTreeMap::new(),
+        txn_dirty: false,
+    };
+    hegel::stateful::machine(machine).run(tc);
+}
