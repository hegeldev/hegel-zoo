+}
+
+/// Property: a byte that is "not smaller than `1 << size`" makes
+/// encoding fail, and (per the `encode_bytes` docs) "all bytes up to but
+/// not including the offending byte have been consumed".
+#[hegel::test]
+fn hegel_encoder_rejects_out_of_alphabet_byte(tc: hegel::TestCase) {
+    let order = if tc.draw(generators::booleans()) {
+        BitOrder::Msb
+    } else {
+        BitOrder::Lsb
+    };
+    let tiff = tc.draw(generators::booleans());
+    // Only sizes below 8 have inexpressible bytes. TIFF is only
+    // documented for sizes >= 2, see common::coding_params.
+    let min = if tiff { 2 } else { 0 };
+    let size = tc.draw(generators::integers::<u8>().min_value(min).max_value(7));
+    let max = common::max_symbol(size);
+
+    let prefix: Vec<u8> =
+        tc.draw(generators::vecs(generators::integers::<u8>().max_value(max)).max_size(100));
+    let bad = tc.draw(generators::integers::<u8>().min_value(max + 1));
+    let suffix: Vec<u8> = tc.draw(generators::binary().max_size(20));
+
+    let mut input = prefix.clone();
+    input.push(bad);
+    input.extend_from_slice(&suffix);
+
+    // One-shot convenience API reports the error.
+    assert!(
+        common::build_encoder(order, size, tiff)
+            .encode(&input)
+            .is_err(),
+        "encode accepted byte {} at size {}",
+        bad,
+        size
+    );
+
+    // Sans-IO API stops exactly at the offending byte.
+    let mut encoder = common::build_encoder(order, size, tiff);
+    let mut out = vec![0u8; 4 * input.len() + 128];
+    let result = encoder.encode_bytes(&input, &mut out);
+    assert!(
+        result.status.is_err(),
+        "encode_bytes accepted byte {} at size {}",
+        bad,
+        size
+    );
+    assert_eq!(
+        result.consumed_in,
+        prefix.len(),
+        "encode_bytes did not consume exactly the valid prefix (size={})",
+        size
+    );
+}
