+// ---------------------------------------------------------------------------
+// Hegel property-based generalizations of the corruption regression above.
+// ---------------------------------------------------------------------------
+
+/// Property: the decoder handles completely arbitrary input bytes, for
+/// every configuration (order × size 0..=12 × tiff × yield_on_full),
+/// by returning `Ok` or `Err` — it must never panic. Generalizes the
+/// crate's `decode0` fuzz target across all configurations.
+#[hegel::test]
+fn hegel_decode_arbitrary_bytes_never_panics(tc: hegel::TestCase) {
+    let order = if tc.draw(generators::booleans()) {
+        BitOrder::Msb
+    } else {
+        BitOrder::Lsb
+    };
+    let tiff = tc.draw(generators::booleans());
+    let yield_on_full = tc.draw(generators::booleans());
+    // The decoder documents the full `0..=12` size range. KNOWN BUG:
+    // the TIFF flavor at size 0 panics on a leading zero code — pinned
+    // by `known_bug_tiff_size_0_decode_panics` below — so that single
+    // configuration is excluded here to keep testing everything else.
+    let min_size = if tiff { 1 } else { 0 };
+    let size = tc.draw(
+        generators::integers::<u8>()
+            .min_value(min_size)
+            .max_value(12),
+    );
+    let junk: Vec<u8> = tc.draw(generators::binary().max_size(256));
+
+    let config = if tiff {
+        weezl::decode::Configuration::with_tiff_size_switch(order, size)
+    } else {
+        weezl::decode::Configuration::new(order, size)
+    }
+    .with_yield_on_full_buffer(yield_on_full);
+
+    // Returning at all — with either Ok or Err — is the property.
+    let result = config.build().decode(&junk);
+    drop(result);
+}
+
+/// Property: flipping a single bit in a *valid* encoded stream must not
+/// panic the decoder (wrong output or `InvalidCode` are both fine).
+/// Near-valid streams reach much deeper decode paths than random bytes;
+/// this generalizes the fixed single-bit-flip finding pinned by
+/// `corrupt_input_does_not_panic_in_derive_burst` above.
+#[hegel::test]
+fn hegel_bitflip_corrupted_stream_never_panics(tc: hegel::TestCase) {
+    let (order, size, tiff) = common::coding_params(&tc);
+    let max = common::max_symbol(size);
+    let data: Vec<u8> =
+        tc.draw(generators::vecs(generators::integers::<u8>().max_value(max)).max_size(400));
+
+    let mut encoded = common::build_encoder(order, size, tiff)
+        .encode(&data)
+        .expect("encode of valid payload");
+    // Even the empty payload encodes to at least clear + end code.
+    let bit = tc.draw(generators::integers::<usize>().max_value(encoded.len() * 8 - 1));
+    encoded[bit / 8] ^= 1 << (bit % 8);
+
+    let result = common::build_decoder(order, size, tiff).decode(&encoded);
+    drop(result);
+}
+
+/// KNOWN FAILURE — real bug, kept failing on purpose (do not "fix" the test).
+///
+/// Found by `hegel_decode_arbitrary_bytes_never_panics` (shrunk
+/// counterexample: tiff decoder, size 0, input `[0]`).
+///
+/// `Decoder::with_tiff_size_switch` documents the size interval
+/// `0..=12`, but at size 0 decoding any stream whose first 2-bit code
+/// is `0` (a valid literal) violates the burst-loop invariant in
+/// `src/decode.rs` (debug_assert at line ~971):
+///
+///     Table: false, code_size: 2, next_code: 3, table_condition: 2
+///
+/// i.e. `max_code() - is_tiff (= 2) < next_code (= 3)` while the table
+/// is far from full: `bump_initial_code_size`'s TIFF compensation does
+/// not keep `next_code` codable for `min_size = 0`. Both bit orders
+/// panic identically; sizes >= 1 appear unaffected. Release builds skip
+/// the debug_assert but then run the wrapping-arithmetic path whose
+/// correctness relies on the asserted invariant.
+#[test]
+fn known_bug_tiff_size_0_decode_panics() {
+    let mut decoder = weezl::decode::Configuration::with_tiff_size_switch(BitOrder::Lsb, 0).build();
+    // Must not panic: decoding arbitrary input from a documented-valid
+    // configuration should return Ok or Err.
+    let result = decoder.decode(&[0]);
+    drop(result);
+}
