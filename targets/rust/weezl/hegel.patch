+/// Property: `Encoder::reset` produces "an encoder as if just
+/// constructed with `new`" — encoding A on a fresh encoder equals
+/// encoding B, resetting, then encoding A on a reused encoder.
+#[hegel::test]
+fn hegel_encoder_reset_matches_fresh(tc: hegel::TestCase) {
+    let order = if tc.draw(generators::booleans()) {
+        BitOrder::Msb
+    } else {
+        BitOrder::Lsb
+    };
+    let tiff = tc.draw(generators::booleans());
+    // KNOWN BUG: at size 0 a reset encoder emits different bytes than a
+    // fresh one — pinned by `known_bug_encoder_reset_size_0_differs_from_fresh`
+    // below — so size 0 is excluded here to keep testing all other sizes.
+    // (TIFF is only documented for sizes >= 2, see common::coding_params.)
+    let min = if tiff { 2 } else { 1 };
+    let size = tc.draw(generators::integers::<u8>().min_value(min).max_value(12));
+    let data_a = common::payload(&tc, size);
+    let data_b = common::payload(&tc, size);
+
+    let expected = common::build_encoder(order, size, tiff)
+        .encode(&data_a)
+        .expect("fresh encode");
+
+    let mut encoder = common::build_encoder(order, size, tiff);
+    encoder.encode(&data_b).expect("pre-reset encode");
+    encoder.reset();
+    let after_reset = encoder.encode(&data_a).expect("post-reset encode");
+
+    assert_eq!(
+        after_reset, expected,
+        "reset encoder differs from fresh: {:?} size={} tiff={}",
+        order, size, tiff
+    );
+}
+
+/// Property: `Decoder::reset` produces "a decoder as if just
+/// constructed with `new`" — decoding a stream after decoding another
+/// stream plus `reset` equals decoding it fresh.
+#[hegel::test]
+fn hegel_decoder_reset_matches_fresh(tc: hegel::TestCase) {
+    let order = if tc.draw(generators::booleans()) {
+        BitOrder::Msb
+    } else {
+        BitOrder::Lsb
+    };
+    let tiff = tc.draw(generators::booleans());
+    // KNOWN BUG: at size 1 a reset decoder rejects (or mis-decodes)
+    // streams a fresh decoder accepts — pinned by
+    // `known_bug_decoder_reset_size_1_rejects_valid_stream` below — so
+    // size 1 is skipped (0 stays covered) to keep testing everything else.
+    // (TIFF is only documented for sizes >= 2, see common::coding_params.)
+    let size = if tiff {
+        tc.draw(generators::integers::<u8>().min_value(2).max_value(12))
+    } else {
+        match tc.draw(generators::integers::<u8>().max_value(11)) {
+            0 => 0,
+            s => s + 1,
+        }
+    };
+    let data_a = common::payload(&tc, size);
+    let data_b = common::payload(&tc, size);
+
+    let encoded_a = common::build_encoder(order, size, tiff)
+        .encode(&data_a)
+        .expect("encode a");
+    let encoded_b = common::build_encoder(order, size, tiff)
+        .encode(&data_b)
+        .expect("encode b");
+
+    let mut decoder = common::build_decoder(order, size, tiff);
+    decoder.decode(&encoded_b).expect("pre-reset decode");
+    decoder.reset();
+    let after_reset = decoder.decode(&encoded_a).expect("post-reset decode");
+
+    assert_eq!(
+        after_reset, data_a,
+        "reset decoder differs from fresh: {:?} size={} tiff={}",
+        order, size, tiff
+    );
+}
