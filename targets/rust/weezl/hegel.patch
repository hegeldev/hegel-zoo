+/// Property: encoding through `into_stream` — with a drawn intermediate
+/// buffer size and a writer that accepts only tiny writes — produces
+/// byte-identical output to the one-shot `encode` (both append an end
+/// marker), i.e. the stream and buffer APIs agree.
+#[hegel::test]
+fn hegel_stream_encode_matches_vec_encode(tc: hegel::TestCase) {
+    let (order, size, tiff) = common::coding_params(&tc);
+    let data = common::payload(&tc, size);
+    let buf_size = tc.draw(generators::integers::<usize>().min_value(1).max_value(4096));
+    let max_io_len = tc.draw(generators::integers::<usize>().min_value(1).max_value(32));
