@@ -0,0 +1,83 @@
+//! Shared draw-helpers for the hegel property-based tests.
+//!
+//! Each integration test target compiles this module independently, so
+//! not every helper is used by every target.
+#![allow(dead_code)]
+
+use hegel::generators;
+use weezl::{decode, encode, BitOrder};
+
+/// Draw the static coding parameters shared by encoder and decoder: bit
+/// order, minimum code size and whether the TIFF early size-switch is used.
+///
+/// Ranges are evidence-based:
+/// * `Encoder::new` documents sizes `2..=12`; sizes `0` and `1` are
+///   additionally exercised (non-TIFF only) by `tests/lowbit_roundtrip.rs`,
+///   so they are generated for the non-TIFF flavor as well.
+/// * The TIFF flavor is only combined with the documented `2..=12` range;
+///   `src/decode.rs` notes "realistically you should not use this
+///   combination \[low sizes + TIFF\]: tiff mandates 8 bits", and no
+///   existing test pins TIFF behaviour below size 2.
+pub fn coding_params(tc: &hegel::TestCase) -> (BitOrder, u8, bool) {
+    let order = if tc.draw(generators::booleans()) {
+        BitOrder::Msb
+    } else {
+        BitOrder::Lsb
+    };
+    let tiff = tc.draw(generators::booleans());
+    let min = if tiff { 2 } else { 0 };
+    let size = tc.draw(generators::integers::<u8>().min_value(min).max_value(12));
+    (order, size, tiff)
+}
+
+/// The largest byte value the encoder accepts for a given code size
+/// ("is not smaller than `1 << size`" is rejected, per `encode_bytes` docs).
+pub fn max_symbol(size: u8) -> u8 {
+    if size >= 8 {
+        255
+    } else {
+        (1u8 << size) - 1
+    }
+}
+
+/// Draw a payload whose symbols all fit the alphabet of `size` bits.
+///
+/// Two shapes: a short arbitrary payload, and a long repetition of a
+/// small drawn seed. The latter compresses well, which drives the code
+/// table towards the size-bump and (for long totals) table-full/clear
+/// paths that short random data cannot reach.
+pub fn payload(tc: &hegel::TestCase, size: u8) -> Vec<u8> {
+    let max = max_symbol(size);
+    if tc.draw(generators::booleans()) {
+        tc.draw(generators::vecs(generators::integers::<u8>().max_value(max)).max_size(400))
+    } else {
+        let seed: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>().max_value(max))
+                .min_size(1)
+                .max_size(32),
+        );
+        let total = tc.draw(generators::integers::<usize>().min_value(1).max_value(8192));
+        let mut data = Vec::with_capacity(total + seed.len());
+        while data.len() < total {
+            data.extend_from_slice(&seed);
+        }
+        data.truncate(total);
+        data
+    }
+}
+
+pub fn build_encoder(order: BitOrder, size: u8, tiff: bool) -> encode::Encoder {
+    if tiff {
+        encode::Encoder::with_tiff_size_switch(order, size)
+    } else {
+        encode::Encoder::new(order, size)
+    }
+}
+
+pub fn build_decoder(order: BitOrder, size: u8, tiff: bool) -> decode::Decoder {
+    if tiff {
+        decode::Decoder::with_tiff_size_switch(order, size)
+    } else {
+        decode::Decoder::new(order, size)
+    }
+}
