+/// KNOWN FAILURE — real bug, kept failing on purpose (do not "fix" the test).
+///
+/// Found by `hegel_encoder_reset_matches_fresh` (shrunk counterexample:
+/// Lsb, size 0, empty payload). `Encoder::reset` documents "This
+/// produce an encoder as if just constructed with `new`", but at
+/// `min_code_size = 0` the post-reset encoder emits a different (and
+/// undecodable-as-equal) byte stream: fresh `encode(&[])` yields `[9]`
+/// (clear + end at 2-bit width) while reset-then-encode yields `[5]`.
+/// Both bit orders are affected; sizes >= 1 agree. Cause (see
+/// `EncodeState::reset` in `src/encode.rs`): `reset` restores the
+/// buffer to `code_size = min_size + 1` and immediately buffers the
+/// clear code, skipping the `bump_initial_code_size()` step that `new`
+/// performs first — so at size 0 the initial clear code is written at
+/// 1-bit width instead of 2.
+#[test]
+fn known_bug_encoder_reset_size_0_differs_from_fresh() {
+    let data = [];
+    let fresh = encode::Encoder::new(BitOrder::Lsb, 0)
+        .encode(&data)
+        .expect("fresh encode");
+
+    let mut encoder = encode::Encoder::new(BitOrder::Lsb, 0);
+    encoder.encode(&data).expect("pre-reset encode");
+    encoder.reset();
+    let after_reset = encoder.encode(&data).expect("post-reset encode");
+
+    assert_eq!(after_reset, fresh, "Encoder::reset must behave like new");
+}
