+// ---------------------------------------------------------------------------
+// Hegel property-based tests for the buffer/vector APIs.
+// ---------------------------------------------------------------------------
+
+use hegel::generators;
+use weezl::LzwStatus;
+
+/// Property: encode→decode is the identity for every generated
+/// configuration (bit order × min code size × TIFF flavor) and every
+/// payload whose symbols fit the alphabet, per the crate docs: "you must
+/// use the same arguments to `Encoder` and `Decoder`".
+#[hegel::test]
+fn hegel_roundtrip_generated_config(tc: hegel::TestCase) {
+    let (order, size, tiff) = common::coding_params(&tc);
+    let data = common::payload(&tc, size);
+
+    let encoded = common::build_encoder(order, size, tiff)
+        .encode(&data)
+        .unwrap_or_else(|e| panic!("encode {:?}/{}/tiff={}: {:?}", order, size, tiff, e));
+    let decoded = common::build_decoder(order, size, tiff)
+        .decode(&encoded)
+        .unwrap_or_else(|e| panic!("decode {:?}/{}/tiff={}: {:?}", order, size, tiff, e));
+
+    assert_eq!(
+        decoded, data,
+        "roundtrip mismatch: {:?} size={} tiff={}",
+        order, size, tiff
+    );
+}
+
+/// Property: driving the sans-IO `encode_bytes` with arbitrary small
+/// input-chunk and output-buffer sizes produces exactly the same encoded
+/// bytes as the one-shot `encode` convenience method. The `Encoder` docs
+/// promise the same state machine works with "streams as well as your
+/// own buffers and driver logic".
+#[hegel::test]
+fn hegel_chunked_encode_bytes_matches_oneshot(tc: hegel::TestCase) {
+    let (order, size, tiff) = common::coding_params(&tc);
+    let data = common::payload(&tc, size);
+    // Chunk-size schedules are drawn up front (and cycled) so the number
+    // of hegel draws stays bounded regardless of how many loop
+    // iterations the schedule causes.
+    let in_chunks: Vec<usize> = tc.draw(
+        generators::vecs(generators::integers::<usize>().min_value(1).max_value(64))
+            .min_size(1)
+            .max_size(8),
+    );
+    let out_sizes: Vec<usize> = tc.draw(
+        generators::vecs(generators::integers::<usize>().min_value(1).max_value(96))
+            .min_size(1)
+            .max_size(8),
+    );
+
+    let expected = common::build_encoder(order, size, tiff)
+        .encode(&data)
+        .expect("one-shot encode of valid payload");
+
+    let mut encoder = common::build_encoder(order, size, tiff);
+    let mut inp = &data[..];
+    let mut produced = Vec::new();
+    let cap = 16 * (data.len() + expected.len()) + 64;
+    let mut iterations = 0usize;
+    loop {
+        iterations += 1;
+        assert!(iterations <= cap, "chunked encoder made no progress");
+        if inp.is_empty() {
+            encoder.finish();
+        }
+        let in_chunk = in_chunks[iterations % in_chunks.len()].min(inp.len());
+        let mut out = vec![0u8; out_sizes[iterations % out_sizes.len()]];
+        let result = encoder.encode_bytes(&inp[..in_chunk], &mut out);
+        inp = &inp[result.consumed_in..];
+        produced.extend_from_slice(&out[..result.consumed_out]);
+        match result.status {
+            Ok(LzwStatus::Done) => break,
+            Ok(_) => {}
+            Err(err) => panic!("chunked encode error: {:?}", err),
+        }
+    }
+
+    assert_eq!(
+        produced, expected,
+        "chunked encode differs from one-shot: {:?} size={} tiff={}",
+        order, size, tiff
+    );
+}
+
+/// Property: driving the sans-IO `decode_bytes` with arbitrary small
+/// input-chunk and output-buffer sizes reproduces the original payload,
+/// like the one-shot `decode`. Mirrors `hegel_chunked_encode_bytes_...`
+/// on the decode side.
+#[hegel::test]
+fn hegel_chunked_decode_bytes_matches_oneshot(tc: hegel::TestCase) {
+    let (order, size, tiff) = common::coding_params(&tc);
+    let data = common::payload(&tc, size);
+    let in_chunks: Vec<usize> = tc.draw(
+        generators::vecs(generators::integers::<usize>().min_value(1).max_value(64))
+            .min_size(1)
+            .max_size(8),
+    );
+    let out_sizes: Vec<usize> = tc.draw(
+        generators::vecs(generators::integers::<usize>().min_value(1).max_value(96))
+            .min_size(1)
+            .max_size(8),
+    );
+
+    let encoded = common::build_encoder(order, size, tiff)
+        .encode(&data)
+        .expect("encode of valid payload");
+
+    let mut decoder = common::build_decoder(order, size, tiff);
+    let mut inp = &encoded[..];
+    let mut produced = Vec::new();
+    let cap = 16 * (data.len() + encoded.len()) + 64;
+    let mut iterations = 0usize;
+    let done = loop {
+        iterations += 1;
+        assert!(iterations <= cap, "chunked decoder made no progress");
+        let in_chunk = in_chunks[iterations % in_chunks.len()].min(inp.len());
+        let mut out = vec![0u8; out_sizes[iterations % out_sizes.len()]];
+        let result = decoder.decode_bytes(&inp[..in_chunk], &mut out);
+        inp = &inp[result.consumed_in..];
+        produced.extend_from_slice(&out[..result.consumed_out]);
+        match result.status {
+            Ok(LzwStatus::Done) => break true,
+            Ok(LzwStatus::NoProgress) if inp.is_empty() => break false,
+            Ok(_) => {}
+            Err(err) => panic!("chunked decode error: {:?}", err),
+        }
+    };
+
+    assert!(
+        done,
+        "decoder never reached Done on a complete stream: {:?} size={} tiff={}",
+        order, size, tiff
+    );
+    assert_eq!(
+        produced, data,
+        "chunked decode differs from original: {:?} size={} tiff={}",
+        order, size, tiff
+    );
+}
+
+/// Property: decoding a truncated prefix of a valid stream is not an
+/// error (with the non-finishing `IntoVec::decode`) and yields a prefix
+/// of the original payload — LZW decoding is deterministic and
+/// prefix-preserving, and truncation at a byte boundary can only lose
+/// codes, not corrupt them.
+#[hegel::test]
+fn hegel_truncated_stream_decodes_to_prefix(tc: hegel::TestCase) {
+    let (order, size, tiff) = common::coding_params(&tc);
+    let data = common::payload(&tc, size);
+    let encoded = common::build_encoder(order, size, tiff)
+        .encode(&data)
+        .expect("encode of valid payload");
+    let cut = tc.draw(generators::integers::<usize>().max_value(encoded.len()));
+
+    let mut decoder = common::build_decoder(order, size, tiff);
+    let mut out = Vec::new();
+    let result = decoder.into_vec(&mut out).decode(&encoded[..cut]);
