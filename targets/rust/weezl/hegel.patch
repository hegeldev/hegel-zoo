+    let decoded = common::build_decoder(order, size, tiff)
+        .decode(&encoded)
+        .unwrap_or_else(|e| {
+            panic!(
+                "decode with trailing garbage errored: {:?} size={} tiff={}: {:?}",
+                order, size, tiff, e
+            )
