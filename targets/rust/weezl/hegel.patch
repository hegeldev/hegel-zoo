+/// KNOWN FAILURE — real bug, kept failing on purpose (do not "fix" the test).
+///
+/// Found by `hegel_decoder_reset_matches_fresh` (shrunk counterexample:
+/// Lsb, size 1, empty payload). `Decoder::reset` documents "This
+/// produce a decoder as if just constructed with `new`", but at
+/// `min_code_size = 1` a reset decoder returns `InvalidCode` (or a
+/// truncated result) for streams a fresh decoder decodes fine. Both bit
+/// orders are affected; all other sizes agree. Suspected cause as in
+/// `known_bug_encoder_reset_size_0_differs_from_fresh`: `reset()` in
+/// `src/decode.rs` bumps the initial code width when
+/// `next_code (= 4) > max_code() (= 3)`, where `new` (via
+/// `bump_initial_code_size`) keeps 2-bit codes because
+/// `end_code (= 3) <= max_code() (= 3)` — so the reset decoder reads
+/// 3-bit codes from a 2-bit stream.
+#[test]
+fn known_bug_decoder_reset_size_1_rejects_valid_stream() {
+    let encoded = encode::Encoder::new(BitOrder::Lsb, 1)
+        .encode(&[])
+        .expect("encode");
+
+    let mut decoder = decode::Decoder::new(BitOrder::Lsb, 1);
+    decoder.decode(&encoded).expect("fresh decode");
+    decoder.reset();
+    let after_reset = decoder.decode(&encoded);
+
+    assert!(
+        after_reset.is_ok(),
+        "Decoder::reset must behave like new, got {:?}",
+        after_reset
+    );
+}
