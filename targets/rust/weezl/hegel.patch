+    assert!(
+        result.status.is_ok(),
+        "truncated decode errored: {:?} size={} tiff={} cut={} status={:?}",
+        order,
+        size,
+        tiff,
+        cut,
+        result.status
+    );
+    assert!(
+        out.len() <= data.len() && out[..] == data[..out.len()],
+        "truncated decode is not a prefix: {:?} size={} tiff={} cut={} (got {} bytes)",
+        order,
+        size,
+        tiff,
+        cut,
+        out.len()
+    );
+}
+
+/// Property: `decode` stops at the end marker, so arbitrary trailing
+/// garbage after a complete stream does not change the result. Evidence:
+/// `Decoder::has_ended` docs ("No more output is produced beyond the end
+/// code ... excess bytes provided") and `IntoVec::decode_all` ("read
+/// data until the slice is empty or an end marker is reached").
+#[hegel::test]
+fn hegel_trailing_garbage_after_end_marker_is_ignored(tc: hegel::TestCase) {
+    let (order, size, tiff) = common::coding_params(&tc);
+    let data = common::payload(&tc, size);
+    let mut encoded = common::build_encoder(order, size, tiff)
+        .encode(&data)
+        .expect("encode of valid payload");
+    let garbage: Vec<u8> = tc.draw(generators::binary().max_size(64));
+    encoded.extend_from_slice(&garbage);
