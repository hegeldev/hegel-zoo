+    // for the canonical pinned failure; this helper is only used to exclude
+    // those known-buggy inputs from sibling properties.
+    // Only valid for frac_nbits <= 64 (display registers up to u64).
+    fn display_frac_hits_lossy_break(frac_bits: u128, frac_nbits: u32) -> bool {
