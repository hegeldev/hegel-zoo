+        // register width is the smallest power of two >= frac_nbits (min 8).
+        let reg_bits = frac_nbits.next_power_of_two().max(8);
+        let modulus = 1u128 << reg_bits;
+        let mut r = frac_bits << (reg_bits - frac_nbits);
+        // Display emits at most ceil(log10(2) * frac_nbits) + 1 fractional
+        // digits; frac_nbits iterations is a safe upper bound.
