+    // Property: sqrt is documented as "rounded down, and the error is
+    // < DELTA. That is, result <= sqrt(self) < result + DELTA." With
+    // x = X/2^f and r = R/2^f in bit representation, that is exactly
+    //   R^2 <= X << f < (R+1)^2
+    // verified here with exact u128 arithmetic. For signed types the input
+    // is restricted to the documented domain (non-negative); overflow can
+    // only occur for signed types with zero integer bits, which are checked
+    // separately below.
+    macro_rules! check_sqrt_contract {
+        ($tc:expr; $($T:ty, $Bits:ty, $draw:expr);* $(;)?) => {
+            $({
+                let bits: $Bits = $tc.draw($draw);
+                let x = <$T>::from_bits(bits);
+                let r = x.sqrt();
+                let xb = bits as u128;
+                let rb = r.to_bits() as u128;
+                let f = <$T>::FRAC_NBITS;
+                assert!(
+                    rb * rb <= xb << f,
+                    "sqrt too large for {} bits {bits:#x}: r bits {rb:#x}",
+                    stringify!($T),
