+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+//
+// Generalizations of the unit tests above (`interning_returns_equal_keys_for_
+// equal_data`, `interning_two_fields`, ...) from hand-picked ASCII strings to
+// arbitrary Unicode data.
+
+use hegel::TestCase;
+use hegel::generators;
+
+/// Interning round-trips: reading the field back returns exactly the data
+/// that was interned.
+#[hegel::test]
+fn interned_data_roundtrips(tc: TestCase) {
+    let db = salsa::DatabaseImpl::new();
+    let data = tc.draw(generators::text());
+    let interned = InternedString::new(&db, data.clone());
+    assert_eq!(interned.data(&db), &data);
+}
+
+/// Interned handles are equal exactly when the interned data is equal
+/// (within one database). Multi-field version also checks that the field
+/// *boundary* matters, generalizing
+/// `interning_returns_equal_keys_for_equal_data_multi_field`'s
+/// ("Hello, World", "") vs ("Hello, ", "World") example.
+#[hegel::test]
+fn interned_identity_iff_equal_data(tc: TestCase) {
+    let db = salsa::DatabaseImpl::new();
+    let s1 = tc.draw(generators::text());
+    // Bias toward equal data: draw either an independent string or a copy.
+    let s2 = tc.draw(hegel::one_of!(
+        generators::text(),
+        generators::just(s1.clone()),
+    ));
+    let t1 = tc.draw(generators::text());
+    let t2 = tc.draw(hegel::one_of!(
+        generators::text(),
+        generators::just(t1.clone()),
+    ));
+
+    let i1 = InternedTwoFields::new(&db, s1.clone(), t1.clone());
+    let i2 = InternedTwoFields::new(&db, s2.clone(), t2.clone());
+    assert_eq!(i1 == i2, (s1.clone(), t1.clone()) == (s2, t2));
+
+    // Same total content, different field split, must intern differently
+    // unless the split is identical.
+    let joined = format!("{s1}{t1}");
+    let split = tc.draw(generators::integers::<usize>().max_value(joined.len()));
+    if joined.is_char_boundary(split) {
+        let j1 = InternedTwoFields::new(&db, &joined[..split], &joined[split..]);
+        assert_eq!(
+            i1 == j1,
+            (s1.as_str(), t1.as_str()) == (&joined[..split], &joined[split..])
+        );
+    }
+}
