+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+//
+// Property: LRU eviction is invisible to query *results*. For any sequence
+// of input creations, field mutations, capacity changes (including 0 =
+// disabled), synthetic writes (which trigger eviction), and queries, both
+// the LRU-limited query and its dependent query always return the value
+// derived from the current input. Evidence: `lru_works` /
+// `lru_keeps_dependency_info` above pin single instances of this
+// ("even though we've evicted it (LRU), we find that it is still good").
+
+use hegel::TestCase;
+use hegel::generators;
+use hegel::Generator;
+use salsa::Setter as _;
+
+struct LruMachine {
+    db: common::LoggerDatabase,
+    /// Model: every created input together with its current field value.
+    inputs: Vec<(MyInput, u32)>,
+}
+
+#[hegel::state_machine]
+impl LruMachine {
+    #[rule]
+    fn add_input(&mut self, tc: TestCase) {
+        let value = tc.draw(generators::integers::<u32>());
+        let input = MyInput::new(&self.db, value);
+        self.inputs.push((input, value));
+    }
+
+    #[rule]
+    fn set_field(&mut self, tc: TestCase) {
+        tc.assume(!self.inputs.is_empty());
+        let idx = tc.draw(generators::integers::<usize>().max_value(self.inputs.len() - 1));
+        let value = tc.draw(generators::integers::<u32>());
+        self.inputs[idx].0.set_field(&mut self.db).to(value);
+        self.inputs[idx].1 = value;
+    }
+
+    #[rule]
+    fn set_capacity(&mut self, tc: TestCase) {
+        // 0 disables LRU (special-cased in `lru_can_be_changed_at_runtime`).
+        let capacity = tc.draw(generators::integers::<usize>().max_value(12));
+        get_hot_potato::set_lru_capacity(&mut self.db, capacity);
+    }
+
+    #[rule]
+    fn synthetic_write(&mut self, tc: TestCase) {
+        // Triggers LRU eviction ("the GC" in the tests above).
+        let durability = tc.draw((generators::sampled_from(vec![
+            salsa::Durability::LOW,
+            salsa::Durability::MEDIUM,
+            salsa::Durability::HIGH,
+        ])).print_as_debug());
+        self.db.synthetic_write(durability);
+    }
+
+    /// The property: query results always match the current input value,
+    /// whether or not the memo was evicted in the meantime.
+    #[rule]
+    fn query(&mut self, tc: TestCase) {
+        tc.assume(!self.inputs.is_empty());
+        let idx = tc.draw(generators::integers::<usize>().max_value(self.inputs.len() - 1));
+        let (input, expected) = self.inputs[idx];
+        assert_eq!(get_hot_potato(&self.db, input).0, expected);
+        assert_eq!(get_hot_potato2(&self.db, input), expected);
+    }
+}
+
+#[hegel::test]
+fn lru_eviction_never_changes_results(tc: TestCase) {
+    let machine = LruMachine {
+        db: common::LoggerDatabase::default(),
+        inputs: Vec::new(),
+    };
+    hegel::stateful::machine(machine).run(tc);
+}
