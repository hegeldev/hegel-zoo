+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+//
+// Generalization of the unit tests above: after *any* sequence of mutations
+// to `field_a`/`field_b`, `push_logs::accumulated::<Log>` must return exactly
+// the `a` logs followed by the `b` logs for the *current* field values —
+// i.e. accumulated values always reflect the current input state, in
+// execution order, with no stale or duplicated entries.
+
+use hegel::TestCase;
+use hegel::generators;
+
+#[hegel::test]
+fn accumulated_logs_match_current_inputs(tc: TestCase) {
+    let mut db = common::LoggerDatabase::default();
+
+    // The bound keeps the number of accumulated entries per query small so
+    // the test stays fast; it protects the test's resources, not a salsa
+    // contract.
+    let field_gen = || generators::integers::<u32>().max_value(20);
+
+    let mut a = tc.draw(field_gen());
+    let mut b = tc.draw(field_gen());
+    let input = MyInput::new(&db, a, b);
+
+    let check = |db: &dyn LogDatabase, a: u32, b: u32| {
+        let logs = push_logs::accumulated::<Log>(db, input);
+        let expected: Vec<Log> = (0..a)
+            .map(|i| Log(format!("log_a({i} of {a})")))
+            .chain((0..b).map(|i| Log(format!("log_b({i} of {b})"))))
+            .collect();
+        // `Log` doesn't implement `PartialEq`; compare debug renderings.
+        assert_eq!(format!("{logs:?}"), format!("{expected:?}"));
+    };
+    check(&db, a, b);
+
+    let steps = tc.draw(generators::integers::<usize>().min_value(1).max_value(6));
+    for _ in 0..steps {
+        if tc.draw(generators::booleans()) {
+            a = tc.draw(field_gen());
+            input.set_field_a(&mut db).to(a);
+        } else {
+            b = tc.draw(field_gen());
+            input.set_field_b(&mut db).to(b);
+        }
+        // Only sometimes re-query, so some revisions are skipped entirely.
+        if tc.draw(generators::booleans()) {
+            check(&db, a, b);
+        }
+    }
+    check(&db, a, b);
+}
diff --git a/tests/cycle.rs b/tests/cycle.rs
index bd64dd8..943b420 100644
--- a/tests/cycle.rs
+++ b/tests/cycle.rs
@@ -1382,3 +1382,105 @@ fn repeat_query_participating_in_cycle2() {
             "salsa_event(DidFinalizeCycle { database_key: head(Id(0)), iteration: 2 })",
         ]"#]]);
 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+//
+// Default cycle-handling contract: a tracked function *without*
+// `cycle_fn`/`cycle_initial` panics if (and only if) evaluation encounters a
+// dependency cycle; on acyclic graphs it returns the correct value. The
+// panic message is pinned in `src/function/fetch.rs`: "dependency graph
+// cycle when querying ... set cycle_fn/cycle_initial to fixpoint iterate".
+
+use hegel::TestCase;
+use hegel::generators;
+
+#[salsa::input(debug)]
+struct Node {
+    #[returns(ref)]
+    successors: Vec<Node>,
+}
+
+/// Height of a node: 0 for a leaf, else 1 + max height of its successors.
+/// Uses default (panic) cycle handling.
+#[salsa::tracked(returns(copy))]
+fn node_height(db: &dyn Db, node: Node) -> u64 {
+    node.successors(db)
+        .iter()
+        .map(|&s| node_height(db, s))
+        .max()
+        .map_or(0, |h| h + 1)
+}
+
+/// Model oracle: `Some(height)` if no cycle is reachable from `node`,
+/// `None` if evaluating `node` would encounter a cycle.
+fn model_height(
+    edges: &[Vec<usize>],
+    node: usize,
+    state: &mut [u8],
+    memo: &mut [u64],
+) -> Option<u64> {
+    match state[node] {
+        1 => return None, // back-edge: cycle
+        2 => return Some(memo[node]),
+        _ => {}
+    }
+    state[node] = 1;
+    let mut height = 0;
+    for &succ in &edges[node] {
+        height = height.max(model_height(edges, succ, state, memo)? + 1);
+    }
+    state[node] = 2;
+    memo[node] = height;
+    Some(height)
+}
+
+#[hegel::test]
+fn default_cycle_handling_panics_iff_cycle_reachable(tc: TestCase) {
+    let mut db = DbImpl::new();
+    let n = tc.draw(generators::integers::<usize>().min_value(1).max_value(6));
+    let edges: Vec<Vec<usize>> = (0..n)
+        .map(|_| {
+            tc.draw(generators::vecs(generators::integers::<usize>().max_value(n - 1)).max_size(3))
+        })
+        .collect();
+
+    let nodes: Vec<Node> = (0..n).map(|_| Node::new(&db, Vec::new())).collect();
+    for (i, succs) in edges.iter().enumerate() {
+        if !succs.is_empty() {
+            nodes[i]
+                .set_successors(&mut db)
+                .to(succs.iter().map(|&j| nodes[j]).collect());
+        }
+    }
+
+    let mut state = vec![0u8; n];
+    let mut memo = vec![0u64; n];
+    let expected = model_height(&edges, 0, &mut state, &mut memo);
+
+    let result =
+        std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| node_height(&db, nodes[0])));
+
+    match expected {
+        Some(height) => {
+            assert_eq!(
+                result.expect("acyclic evaluation must not panic"),
+                height,
+                "height of node 0"
+            );
+        }
+        None => {
+            let payload = result.expect_err("reachable cycle must panic");
+            let message = payload
+                .downcast_ref::<String>()
+                .map(String::as_str)
+                .or_else(|| payload.downcast_ref::<&str>().copied())
+                .unwrap_or("");
+            assert!(
+                message.contains("dependency graph cycle"),
+                "expected the documented cycle panic, got: {message:?}"
+            );
+        }
+    }
+}
diff --git a/tests/dataflow.rs b/tests/dataflow.rs
index 78ffd64..297138c 100644
--- a/tests/dataflow.rs
+++ b/tests/dataflow.rs
@@ -259,3 +259,263 @@ fn multi_symbol_cycle_converges_then_diverges() {
     assert_eq!(infer_use(&db, use_x), Type::Top);
     assert_eq!(infer_use(&db, use_y), Type::Top);
 }
+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+//
+// Generalization of the hand-written cycle tests above: for an *arbitrary*
+// def/use graph (including cycles, which are resolved by fixpoint iteration)
+// and an *arbitrary* sequence of mutations, the incrementally-recomputed
+// types must equal the types computed by a from-scratch database built from
+// the current graph. Every unit test above is one hand-picked instance of
+// this property.
+
+use hegel::TestCase;
+use hegel::generators;
+use hegel::Generator;
+
+#[derive(Clone, Debug)]
+struct DefModel {
+    /// Index into the uses vector.
+    base: Option<usize>,
+    increment: usize,
+}
+
+/// Build a fresh database (plus defs/uses) from the model graph.
+///
+/// Mirrors how the unit tests above build graphs: create defs without bases,
+/// then uses, then patch the base edges (which may form cycles).
+fn build_db(
+    def_models: &[DefModel],
+    use_models: &[Vec<usize>],
+) -> (salsa::DatabaseImpl, Vec<Definition>, Vec<Use>) {
+    let mut db = salsa::DatabaseImpl::new();
+    let defs: Vec<Definition> = def_models
+        .iter()
+        .map(|m| Definition::new(&db, None, m.increment))
+        .collect();
+    let uses: Vec<Use> = use_models
+        .iter()
+        .map(|m| Use::new(&db, m.iter().map(|&i| defs[i]).collect()))
+        .collect();
+    for (def, m) in defs.iter().zip(def_models) {
+        if let Some(base) = m.base {
+            def.set_base(&mut db).to(Some(uses[base]));
+        }
+    }
+    (db, defs, uses)
+}
+
+struct DataflowMachine {
+    db: salsa::DatabaseImpl,
+    defs: Vec<Definition>,
+    uses: Vec<Use>,
+    def_models: Vec<DefModel>,
+    use_models: Vec<Vec<usize>>,
+}
+
+// Increments stay small: salsa only sees the resulting `Type` values through
+// `Eq`, so small increments maximize interesting joins/convergence without
+// exercising any additional salsa code paths (and keep the fixpoint sets
+// tiny).
+fn increment_gen() -> impl hegel::generators::Generator<usize> {
+    generators::integers::<usize>().max_value(3)
+}
+
+/// For every node (defs first, then uses), whether it lies on a dependency
+/// cycle of `infer_definition`/`infer_use`.
+fn cyclic_nodes(def_models: &[DefModel], use_models: &[Vec<usize>]) -> Vec<bool> {
+    let n_defs = def_models.len();
+    let n = n_defs + use_models.len();
+    let succs = |node: usize| -> Vec<usize> {
+        if node < n_defs {
+            def_models[node]
+                .base
+                .map(|b| n_defs + b)
+                .into_iter()
+                .collect()
+        } else {
+            use_models[node - n_defs].clone()
+        }
+    };
+    (0..n)
+        .map(|start| {
+            // `start` is cyclic iff it can reach itself via >= 1 edge.
+            let mut seen = vec![false; n];
+            let mut stack = succs(start);
+            while let Some(node) = stack.pop() {
+                if node == start {
+                    return true;
+                }
+                if !seen[node] {
+                    seen[node] = true;
+                    stack.extend(succs(node));
+                }
+            }
+            false
+        })
+        .collect()
+}
+
+/// KNOWN BUG EXCLUSION: mutations that remove a node from a cycle trip a
+/// backdate violation assertion inside salsa itself — see the canonical
+/// failing test `known_failure_backdate_violation_when_cycle_is_broken`
+/// below. Until that bug is fixed, the state machine skips such mutations
+/// (returns false) so it stays green and keeps testing everything else.
+fn no_cycle_broken(before: &[bool], after: &[bool]) -> bool {
+    before.iter().zip(after).all(|(b, a)| !b || *a)
+}
+
+#[hegel::state_machine]
+impl DataflowMachine {
+    #[rule]
+    fn set_increment(&mut self, tc: TestCase) {
+        let idx = tc.draw(generators::integers::<usize>().max_value(self.defs.len() - 1));
+        let increment = tc.draw((increment_gen()).print_as_debug());
+        self.defs[idx].set_increment(&mut self.db).to(increment);
+        self.def_models[idx].increment = increment;
+    }
+
+    #[rule]
+    fn set_base(&mut self, tc: TestCase) {
+        let idx = tc.draw(generators::integers::<usize>().max_value(self.defs.len() - 1));
+        let base = tc.draw(generators::optional(
+            generators::integers::<usize>().max_value(self.uses.len() - 1),
+        ));
+        let mut new_def_models = self.def_models.clone();
+        new_def_models[idx].base = base;
+        // See `no_cycle_broken` (known bug exclusion).
+        tc.assume(no_cycle_broken(
+            &cyclic_nodes(&self.def_models, &self.use_models),
+            &cyclic_nodes(&new_def_models, &self.use_models),
+        ));
+        self.defs[idx]
+            .set_base(&mut self.db)
+            .to(base.map(|i| self.uses[i]));
+        self.def_models = new_def_models;
+    }
+
+    #[rule]
+    fn set_reaching_definitions(&mut self, tc: TestCase) {
+        let idx = tc.draw(generators::integers::<usize>().max_value(self.uses.len() - 1));
+        let def_idxs: Vec<usize> = tc.draw(
+            generators::vecs(generators::integers::<usize>().max_value(self.defs.len() - 1))
+                .max_size(4),
+        );
+        let mut new_use_models = self.use_models.clone();
+        new_use_models[idx] = def_idxs.clone();
+        // See `no_cycle_broken` (known bug exclusion).
+        tc.assume(no_cycle_broken(
+            &cyclic_nodes(&self.def_models, &self.use_models),
+            &cyclic_nodes(&self.def_models, &new_use_models),
+        ));
+        self.uses[idx]
+            .set_reaching_definitions(&mut self.db)
+            .to(def_idxs.iter().map(|&i| self.defs[i]).collect());
+        self.use_models = new_use_models;
+    }
+
+    /// Warm a single memo so revisions see queries in varying orders.
+    #[rule]
+    fn query_one(&mut self, tc: TestCase) {
+        let idx = tc.draw(generators::integers::<usize>().max_value(self.uses.len() - 1));
+        let _ = infer_use(&self.db, self.uses[idx]);
+    }
+
+    /// The property: incremental fixpoint recomputation equals a
+    /// from-scratch fixpoint computation over the same graph.
+    #[rule]
+    fn check_against_fresh_db(&mut self, _tc: TestCase) {
+        let (fresh_db, fresh_defs, fresh_uses) = build_db(&self.def_models, &self.use_models);
+        // Query in canonical order in both databases.
+        for (idx, (mine, fresh)) in self.uses.iter().zip(&fresh_uses).enumerate() {
+            assert_eq!(
+                infer_use(&self.db, *mine),
+                infer_use(&fresh_db, *fresh),
+                "use {idx}"
+            );
+        }
+        for (idx, (mine, fresh)) in self.defs.iter().zip(&fresh_defs).enumerate() {
+            assert_eq!(
+                infer_definition(&self.db, *mine),
+                infer_definition(&fresh_db, *fresh),
+                "definition {idx}"
+            );
+        }
+    }
+}
+
+#[hegel::test]
+fn incremental_dataflow_matches_fresh_db(tc: TestCase) {
+    let n_uses = tc.draw(generators::integers::<usize>().min_value(1).max_value(3));
+    let n_defs = tc.draw(generators::integers::<usize>().min_value(1).max_value(4));
+    let def_models: Vec<DefModel> = (0..n_defs)
+        .map(|_| DefModel {
+            base: tc.draw(generators::optional(
+                generators::integers::<usize>().max_value(n_uses - 1),
+            )),
+            increment: tc.draw((increment_gen()).print_as_debug()),
+        })
+        .collect();
+    let use_models: Vec<Vec<usize>> = (0..n_uses)
+        .map(|_| {
+            tc.draw(
+                generators::vecs(generators::integers::<usize>().max_value(n_defs - 1)).max_size(4),
+            )
+        })
+        .collect();
+    let (db, defs, uses) = build_db(&def_models, &use_models);
+    hegel::stateful::machine(DataflowMachine {
+            db,
+            defs,
+            uses,
+            def_models,
+            use_models,
+        }).run(tc);
+}
+
+/// KNOWN FAILURE: pins a suspected salsa bug found by the hegel property
+/// `incremental_dataflow_matches_fresh_db`.
+///
+/// When queries participate in a fixpoint cycle in one revision and the
+/// cycle is broken in a later revision while all values stay equal,
+/// re-executing a former cycle participant trips salsa's backdate
+/// violation check (`src/function/backdate.rs`): while the cycle was being
+/// resolved, the cycle head's memo kept `changed_at = R2` but the
+/// participant's memo was bumped to `changed_at = R3` (memos with cycle
+/// heads are excluded from backdating, see `MemoHeader::can_backdate` and
+/// its TODO comment about backdating around cycles). After the cycle is
+/// broken, the participant re-executes and computes `changed_at = R2` from
+/// its dependencies, which is *older* than its previous `changed_at = R3`.
+///
+/// In debug builds this panics; in release builds it only logs a warning
+/// and `changed_at` moves backwards, so downstream queries may see stale
+/// results. The queries here have no untracked reads, so per the assertion
+/// message itself ("If the query has no untracked reads, please open a
+/// Salsa issue") this is a bug in salsa, not in the test.
+#[test]
+fn known_failure_backdate_violation_when_cycle_is_broken() {
+    let mut db = salsa::DatabaseImpl::new();
+    let def = Definition::new(&db, None, 0);
+    let u = Use::new(&db, vec![]);
+
+    // R2: def := u + 0, but u has no reaching definitions yet.
+    def.set_base(&mut db).to(Some(u));
+    assert_eq!(infer_use(&db, u), Type::Bottom);
+    assert_eq!(infer_definition(&db, def), Type::Bottom);
+
+    // R3: u reaches def, closing the cycle u <-> def. The fixpoint
+    // converges to Bottom, so both values are unchanged.
+    u.set_reaching_definitions(&mut db).to(vec![def]);
+    assert_eq!(infer_use(&db, u), Type::Bottom);
+    assert_eq!(infer_definition(&db, def), Type::Bottom);
+
+    // R4: break the cycle again. All values are still Bottom.
+    u.set_reaching_definitions(&mut db).to(vec![]);
+    assert_eq!(infer_use(&db, u), Type::Bottom);
+    // Panics here in debug builds at src/function/backdate.rs:
+    // "query infer_definition(Id(0)) returned the same value, but the
+    // previous execution changed at R3 and the new execution changed at R2".
+    assert_eq!(infer_definition(&db, def), Type::Bottom);
+}
