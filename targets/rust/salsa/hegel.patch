+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+//
+// Generalization of `durable_to_less_durable` above: for *any* initial
+// durabilities and *any* sequence of value/durability changes (including
+// re-setting the current value with a different durability — the exact shape
+// of the original regression), the derived sums must always reflect the
+// current input values.
+
+use hegel::TestCase;
+use hegel::generators;
+use hegel::Generator;
+
+#[hegel::test]
+fn add3_matches_sum_across_durability_changes(tc: TestCase) {
+    let mut db = salsa::DatabaseImpl::new();
+
+    // The value bound protects the test fixture's unchecked `+` in
+    // `add`/`add3` from u32 overflow; it is not a salsa contract.
+    let value_gen = || generators::integers::<u32>().max_value(u32::MAX / 3);
+    let durability_gen =
+        || generators::sampled_from(vec![Durability::LOW, Durability::MEDIUM, Durability::HIGH]);
+
+    let mut values = [0u32; 3];
+    let mut inputs = Vec::with_capacity(3);
+    for slot in values.iter_mut() {
+        let v = tc.draw(value_gen());
+        let d = tc.draw((durability_gen()).print_as_debug());
+        *slot = v;
+        inputs.push(N::builder(v).value_durability(d).new(&db));
+    }
+    let (a, b, c) = (inputs[0], inputs[1], inputs[2]);
+
+    assert_eq!(add3(&db, a, b, c), values.iter().sum::<u32>());
+
+    let steps = tc.draw(generators::integers::<usize>().min_value(1).max_value(8));
+    for _ in 0..steps {
+        let idx = tc.draw(generators::integers::<usize>().max_value(2));
+        // Branch 2 re-sets the current value, exercising backdating combined
+        // with durability changes (the original regression in this file).
+        let v = tc.draw(hegel::one_of!(value_gen(), generators::just(values[idx])));
+        match tc.draw((generators::optional(durability_gen())).print_as_debug()) {
+            None => {
+                inputs[idx].set_value(&mut db).to(v);
+            }
+            Some(d) => {
+                inputs[idx].set_value(&mut db).with_durability(d).to(v);
+            }
+        }
+        values[idx] = v;
+        // Only sometimes query in between, so that some revisions are
+        // skipped entirely and validation has to cross several revisions.
+        if tc.draw(generators::booleans()) {
+            assert_eq!(add(&db, a, b), values[0] + values[1]);
+            assert_eq!(add3(&db, a, b, c), values.iter().sum::<u32>());
+        }
+    }
+    assert_eq!(add3(&db, a, b, c), values.iter().sum::<u32>());
+    assert_eq!(add(&db, a, b), values[0] + values[1]);
+}
