+// ---------------------------------------------------------------- serde
+
+/// The serde representation is the bare `i64`: every `i64` round-trips through JSON exactly,
+/// JSON strings go through the parser, and out-of-range numbers are refused.
+#[hegel::test]
+fn serde_is_the_transparent_byte_count(mut tc: TestCase) {
+    let x = n(&mut tc, i64::MIN, i64::MAX);
+    let s = Size::from_const(x);
+    let json = serde_json::to_string(&s).unwrap();
+    assert_eq!(json, x.to_string());
+    assert_eq!(serde_json::from_str::<Size>(&json).unwrap().bytes(), x);
+    // a struct field is the bare number too
+    #[derive(serde::Serialize, serde::Deserialize, PartialEq, Debug)]
+    struct File {
+        size: Size,
+    }
+    let file = File { size: s };
+    let json = serde_json::to_string(&file).unwrap();
+    assert_eq!(json, format!("{{\"size\":{x}}}"));
+    assert_eq!(serde_json::from_str::<File>(&json).unwrap(), file);
+    // out of range
+    let big = (x as i128).abs() + i64::MAX as i128 + 1;
+    let err = serde_json::from_str::<Size>(&big.to_string());
+    assert!(err.is_err(), "{} accepted", big);
+    assert!(err.unwrap_err().to_string().contains("out of range"));
+    // strings use the parser
+    let (unit, mult, _) = arb_unit(&mut tc);
+    let v = n(&mut tc, 0, EXACT / mult);
+    let text = format!("{v} {unit}");
+    assert_eq!(
+        serde_json::from_str::<Size>(&format!("\"{text}\"")).unwrap().bytes(),
+        v * mult,
+        "{text:?}"
+    );
+    assert!(serde_json::from_str::<Size>("\"12 XB\"").is_err());
+}
