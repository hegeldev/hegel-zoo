+//! Hegel properties for `size` 0.5.0: the formatter against a model of the documented unit /
+//! precision table, the `FromStr` parser against exact decimal arithmetic and against the
+//! formatter's own output, the arithmetic operators against `i64` arithmetic, and the serde
+//! transparent-integer contract.
+
+use hegel::{generators, TestCase};
+use size::{Base, Size, SizeFormatter, Style};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo as i64).max_value($hi as i64)
+    };
+}
+
+fn n(tc: &mut TestCase, lo: i64, hi: i64) -> i64 {
+    tc.draw(int!(lo, hi))
+}
+
+fn pick<T: Clone>(tc: &mut TestCase, items: &[T]) -> T {
+    let i = n(tc, 0, items.len() as i64 - 1) as usize;
+    items[i].clone()
+}
+
+fn chance(tc: &mut TestCase, pct: i64) -> bool {
+    n(tc, 0, 99) < pct
+}
+
+// ---------------------------------------------------------------- the documented tables
+
+const EXACT: i64 = 1 << 53; // above this, f64 cannot hold every integer
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum B {
+    Two,
+    Ten,
+}
+
+impl B {
+    fn base(self) -> i64 {
+        match self {
+            B::Two => 1024,
+            B::Ten => 1000,
+        }
+    }
+    fn unit(self, k: usize) -> i64 {
+        self.base().pow(k as u32)
+    }
+    fn crate_base(self) -> Base {
+        match self {
+            B::Two => Base::Base2,
+            B::Ten => Base::Base10,
+        }
+    }
+    /// (full lowercase, Full, abbreviated lowercase, Abbreviated) for unit index k (0 = byte).
+    fn text(self, k: usize) -> (&'static str, &'static str, &'static str, &'static str) {
+        match (self, k) {
+            (_, 0) => ("byte", "Byte", "b", "B"),
+            (B::Ten, 1) => ("kilobyte", "Kilobyte", "kb", "KB"),
+            (B::Ten, 2) => ("megabyte", "Megabyte", "mb", "MB"),
+            (B::Ten, 3) => ("gigabyte", "Gigabyte", "gb", "GB"),
+            (B::Ten, 4) => ("terabyte", "Terabyte", "tb", "TB"),
+            (B::Ten, 5) => ("petabyte", "Petabyte", "pb", "PB"),
+            (B::Ten, 6) => ("exabyte", "Exabyte", "eb", "EB"),
+            (B::Two, 1) => ("kibibyte", "Kibibyte", "kib", "KiB"),
+            (B::Two, 2) => ("mebibyte", "Mebibyte", "mib", "MiB"),
+            (B::Two, 3) => ("gibibyte", "Gibibyte", "gib", "GiB"),
+            (B::Two, 4) => ("tebibyte", "Tebibyte", "tib", "TiB"),
+            (B::Two, 5) => ("pebibyte", "Pebibyte", "pib", "PiB"),
+            (B::Two, 6) => ("exbibyte", "Exbibyte", "eib", "EiB"),
+            _ => unreachable!(),
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+enum S {
+    Default,
+    Abbreviated,
+    AbbreviatedLowercase,
+    Full,
+    FullLowercase,
+}
+
+const STYLES: [S; 5] = [S::Default, S::Abbreviated, S::AbbreviatedLowercase, S::Full, S::FullLowercase];
+
+impl S {
+    fn crate_style(self) -> Style {
+        match self {
+            S::Default => Style::Default,
+            S::Abbreviated => Style::Abbreviated,
+            S::AbbreviatedLowercase => Style::AbbreviatedLowercase,
+            S::Full => Style::Full,
+            S::FullLowercase => Style::FullLowercase,
+        }
+    }
+    /// The unit text for magnitude `mag` shown in unit `k` (documented: the default style is
+    /// the full lowercase name for bytes and the abbreviation otherwise; full names take a
+    /// plural `s` except for exactly one byte).
+    fn unit_text(self, base: B, k: usize, mag: u64) -> String {
+        let t = base.text(k);
+        let plural = if k == 0 && mag == 1 { "" } else { "s" };
+        match self {
+            S::Default if k == 0 => format!("{}{plural}", t.0),
+            S::Default => t.3.to_string(),
+            S::Abbreviated => t.3.to_string(),
+            S::AbbreviatedLowercase => t.2.to_string(),
+            S::Full => format!("{}{plural}", t.1),
+            S::FullLowercase => format!("{}{plural}", t.0),
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+struct Config {
+    base: B,
+    style: S,
+    scale: Option<usize>,
+}
+
+fn arb_config(tc: &mut TestCase) -> Config {
+    let base = if chance(tc, 50) { B::Two } else { B::Ten };
+    let style = pick(tc, &STYLES);
+    let scale = if chance(tc, 50) { None } else { Some(n(tc, 0, 4) as usize) };
+    Config { base, style, scale }
+}
+
+fn render(cfg: &Config, size: &Size) -> String {
+    size.format()
+        .with_base(cfg.base.crate_base())
+        .with_style(cfg.style.crate_style())
+        .with_scale(cfg.scale)
+        .to_string()
+}
+
+fn render_standalone(cfg: &Config, bytes: i64) -> String {
+    SizeFormatter::new()
+        .with_base(cfg.base.crate_base())
+        .with_style(cfg.style.crate_style())
+        .with_scale(cfg.scale)
+        .format(bytes)
+}
+
+/// The unit index the documentation's table picks for a magnitude: the largest unit that the
+/// magnitude reaches, capped at exa.
+fn unit_index(base: B, mag: u64) -> usize {
+    let mut k = 0;
+    while k < 6 && mag >= base.unit(k + 1) as u64 {
+        k += 1;
+    }
+    k
+}
+
+/// The number of decimals the documented ladder gives: two below ten units, one below a
+/// hundred, none above (bytes never carry decimals).
+fn ladder(base: B, k: usize, mag: u64) -> usize {
+    if k == 0 {
+        0
+    } else if mag < 10 * base.unit(k) as u64 {
+        2
+    } else if mag < 100 * base.unit(k) as u64 {
+        1
+    } else {
+        0
+    }
+}
+
+/// Model of the documented output. `None` when rounding to the chosen precision would carry the
+/// number up to the next unit or up the decimal ladder — the case is left to the pin for size/2.
+fn model(cfg: &Config, bytes: i64) -> Option<String> {
+    let (sign, mag) = if bytes < 0 {
+        ("-", bytes.checked_abs().map(|a| a as u64).unwrap_or(i64::MAX as u64))
+    } else {
+        ("", bytes as u64)
+    };
+    let k = unit_index(cfg.base, mag);
+    if k == 0 {
+        return Some(format!("{sign}{mag} {}", cfg.style.unit_text(cfg.base, 0, mag)));
+    }
+    let d = cfg.scale.unwrap_or_else(|| ladder(cfg.base, k, mag));
+    let scaled = mag as f64 / cfg.base.unit(k) as f64;
+    let number = format!("{scaled:.d$}");
+    let rounded: f64 = number.parse().unwrap();
+    if rounded >= cfg.base.base() as f64 {
+        return None;
+    }
+    if cfg.scale.is_none() && ((d == 2 && rounded >= 10.0) || (d == 1 && rounded >= 100.0)) {
+        return None;
+    }
+    Some(format!("{sign}{number} {}", cfg.style.unit_text(cfg.base, k, mag)))
+}
+
+/// A magnitude in unit `k` of `base`, log-uniform-ish across the unit.
+fn arb_mag(tc: &mut TestCase, base: B, k: usize) -> i64 {
+    let unit = base.unit(k);
+    let top = if k == 6 { i64::MAX } else { base.unit(k + 1) - 1 };
+    let whole = n(tc, 1, (top / unit).min(base.base() - 1));
+    let frac = n(tc, 0, unit - 1);
+    (whole * unit + frac).min(top)
+}
+
+fn arb_bytes(tc: &mut TestCase, base: B, kmax: usize) -> i64 {
+    let k = n(tc, 0, kmax as i64) as usize;
+    let mag = if chance(tc, 10) { n(tc, 0, 3) } else { arb_mag(tc, base, k) };
+    if chance(tc, 30) { -mag } else { mag }
+}
+
+// ---------------------------------------------------------------- formatting
+
+/// `Display`, `format()` and a standalone `SizeFormatter` all print the model's text.
+#[hegel::test]
+fn formatting_matches_the_model(mut tc: TestCase) {
+    let cfg = arb_config(&mut tc);
+    let bytes = arb_bytes(&mut tc, cfg.base, 5);
+    let size = Size::from_const(bytes);
+    let Some(expected) = model(&cfg, bytes) else {
+        tc.assume(false);
+        return;
+    };
+    let text = render(&cfg, &size);
+    assert_eq!(text, expected, "{cfg:?} {bytes}");
+    assert_eq!(render_standalone(&cfg, bytes), expected, "standalone {cfg:?} {bytes}");
+    if matches!((cfg.base, cfg.style, cfg.scale), (B::Two, S::Default, None)) {
+        assert_eq!(size.to_string(), expected, "Display {bytes}");
+        assert_eq!(format!("{size}"), expected);
+    }
+    assert_eq!(format!("{size:?}"), format!("{bytes} bytes"));
+}
+
+/// The formatted text parses back to within half a unit of the last printed decimal (and the
+/// byte's truncation), in every base, style and scale.
+#[hegel::test]
+fn formatting_and_parsing_round_trip(mut tc: TestCase) {
+    let cfg = arb_config(&mut tc);
+    let bytes = arb_bytes(&mut tc, cfg.base, 5);
+    let size = Size::from_const(bytes);
+    let text = render(&cfg, &size);
+    let parsed = Size::from_str(&text).unwrap_or_else(|e| panic!("{:?} from {}: {}", text, bytes, e));
+    let mag = bytes.unsigned_abs();
+    let k = unit_index(cfg.base, mag);
+    let tolerance = if k == 0 {
+        0.0
+    } else {
+        let d = cfg.scale.unwrap_or_else(|| ladder(cfg.base, k, mag));
+        0.5 * 10f64.powi(-(d as i32)) * cfg.base.unit(k) as f64 + 1.0
+    };
+    let diff = (parsed.bytes() as f64 - bytes as f64).abs();
+    assert!(diff <= tolerance, "{text:?}: {} vs {bytes} (tolerance {tolerance})", parsed.bytes());
+    // `Size::from_str(text)` and `text.parse()` are the same parser.
+    assert_eq!(text.parse::<Size>(), Ok(parsed));
+}
+
+/// The number printed stays below the base and the decimal ladder is consistent (two decimals
+/// only below ten units): the unit and precision must be chosen after rounding.
+/// Expected failure: size/2.
+#[hegel::test]
+fn unit_is_chosen_after_rounding(mut tc: TestCase) {
+    let base = if chance(&mut tc, 50) { B::Two } else { B::Ten };
+    // just below a unit boundary (at least one mega-unit, where the ladder prints no decimals)
+    let k = n(&mut tc, 2, 6) as usize;
+    let bytes = base.unit(k) - n(&mut tc, 1, base.base() / 2);
+    let cfg = Config { base, style: S::Abbreviated, scale: None };
+    let text = render(&cfg, &Size::from_const(bytes));
+    let (number, unit) = text.split_once(' ').unwrap();
+    let value: f64 = number.parse().unwrap();
+    assert!(
+        value < base.base() as f64,
+        "{bytes} -> {text:?}: {value} {unit} is a whole {} of the next unit",
+        base.base()
+    );
+    assert_eq!(unit, base.text(k - 1).3, "{bytes} -> {text:?}");
+    // just below ten units: two decimals may not show "10.00"
+    let k = n(&mut tc, 1, 5) as usize;
+    let bytes = 10 * base.unit(k) - n(&mut tc, 1, base.unit(k) / 200);
+    let text = render(&cfg, &Size::from_const(bytes));
+    let number = text.split_once(' ').unwrap().0;
+    assert!(
+        !number.starts_with("10.00"),
+        "{} -> {:?}: the ladder prints two decimals only below ten units",
+        bytes,
+        text
+    );
+}
+
+/// Exabytes follow the same ladder as every other unit: two decimals below ten of them.
+/// Expected failure: size/3.
+#[hegel::test]
+fn exabytes_keep_the_decimal_ladder(mut tc: TestCase) {
+    let base = if chance(&mut tc, 50) { B::Two } else { B::Ten };
+    let bytes = arb_mag(&mut tc, base, 6);
+    let cfg = Config { base, style: S::Abbreviated, scale: None };
+    let text = render(&cfg, &Size::from_const(bytes));
+    let expected = model(&cfg, bytes).unwrap();
+    assert_eq!(text, expected, "{bytes}");
+}
+
+/// Pins for the formatter.
+#[test]
+fn formatter_examples() {
+    assert_eq!(Size::from_bytes(1_340_249).to_string(), "1.28 MiB");
+    assert_eq!(Size::from_bytes(200).to_string(), "200 bytes");
+    assert_eq!(Size::from_bytes(1).to_string(), "1 byte");
+    assert_eq!(Size::from_bytes(-1).to_string(), "-1 byte");
+    assert_eq!(Size::from_bytes(i64::MIN).to_string(), "-8 EiB");
+    assert_eq!(SizeFormatter::new().with_scale(Some(2)).format(123), "123 bytes");
+    assert_eq!(
+        Size::from_bytes(42_000).format().with_scale(Some(3)).to_string(),
+        "41.016 KiB"
+    );
+    // size/2: the unit is chosen before rounding
+    assert_eq!(Size::from_bytes(1_048_575).to_string(), "1024 KiB"); // should be 1.00 MiB
+    assert_eq!(
+        Size::from_bytes(999_999).format().with_base(Base::Base10).to_string(),
+        "1000 KB" // should be 1.00 MB
+    );
+    assert_eq!(Size::from_bytes(10_239).to_string(), "10.00 KiB"); // 10240 is "10.0 KiB"
+    // size/3: exabytes always print without decimals
+    assert_eq!(
+        Size::from_bytes(1_500_000_000_000_000_000i64).format().with_base(Base::Base10).to_string(),
+        "2 EB" // 1.50 EB
+    );
+    assert_eq!(Size::from_bytes(1_500_000_000_000_000_000i64).to_string(), "1 EiB"); // 1.30 EiB
+}
+
+// ---------------------------------------------------------------- parsing
+
+/// A parseable unit spelling: (text, multiplier, plural allowed).
+fn arb_unit(tc: &mut TestCase) -> (String, i64, bool) {
+    let base = if chance(tc, 50) { B::Two } else { B::Ten };
+    let k = n(tc, 0, 6) as usize;
+    let t = base.text(k);
+    let (spelling, full) = match n(tc, 0, 3) {
+        0 => (t.0, true),
+        1 => (t.1, true),
+        2 => (t.2, false),
+        _ => (t.3, false),
+    };
+    // any mix of case is documented ("12.34 Kibibytes/MegaBytes")
+    let text: String = spelling
+        .chars()
+        .map(|c| if chance(tc, 30) { c.to_ascii_uppercase() } else { c })
+        .collect();
+    let text = if full && chance(tc, 50) { format!("{text}s") } else { text };
+    (text, base.unit(k), full)
+}
+
+fn arb_ws(tc: &mut TestCase) -> &'static str {
+    pick(tc, &["", " ", "  ", "\t", " \t "])
+}
+
+/// `<integer><ws><unit>` parses to `integer × multiplier` exactly, with or without a unit,
+/// with surrounding whitespace, in any case, with a plural `s` on full names.
+#[hegel::test]
+fn parsing_reads_number_times_multiplier(mut tc: TestCase) {
+    let (unit, mult, _) = if chance(&mut tc, 15) {
+        (String::new(), 1, false)
+    } else {
+        arb_unit(&mut tc)
+    };
+    let limit = EXACT / mult;
+    let value = n(&mut tc, 0, limit);
+    let negative = chance(&mut tc, 20);
+    let number = if negative { format!("-{value}") } else { value.to_string() };
+    let text = format!(
+        "{}{number}{}{unit}{}",
+        arb_ws(&mut tc),
+        arb_ws(&mut tc),
+        arb_ws(&mut tc)
+    );
+    let expected = if negative { -value * mult } else { value * mult };
+    assert_eq!(
+        Size::from_str(&text).map(|s| s.bytes()),
+        Ok(expected),
+        "{text:?}"
+    );
+}
+
+/// An exact decimal: `digits.frac` × `mult` computed in integers.
+fn arb_decimal(tc: &mut TestCase, mult: i64) -> (String, i128) {
+    let frac_digits = n(tc, 1, 4) as u32;
+    let scale = 10i128.pow(frac_digits);
+    let limit = (EXACT as i128 / mult as i128).min(1_000_000_000);
+    let whole = n(tc, 0, limit as i64) as i128;
+    let frac = n(tc, 0, scale as i64 - 1) as i128;
+    let text = format!("{whole}.{:0width$}", frac, width = frac_digits as usize);
+    // value × mult, as a numerator over `scale`
+    (text, (whole * scale + frac) * mult as i128)
+}
+
+/// A decimal number whose product with the unit is a whole number of bytes parses to exactly
+/// that number of bytes (the crate's own test: `12.34 kIloByte` is 12 KB + 340 bytes).
+/// Expected failure: size/4.
+#[hegel::test]
+fn parsing_decimals_is_exact(mut tc: TestCase) {
+    let (unit, mult, _) = arb_unit(&mut tc);
+    let (number, numerator) = arb_decimal(&mut tc, mult);
+    let scale = 10i128.pow(number.split('.').nth(1).unwrap().len() as u32);
+    tc.assume(numerator % scale == 0);
+    let expected = (numerator / scale) as i64;
+    let text = format!("{number}{}{unit}", arb_ws(&mut tc));
+    assert_eq!(
+        Size::from_str(&text).map(|s| s.bytes()),
+        Ok(expected),
+        "{text:?}"
+    );
+}
+
+/// A decimal whose product is not whole parses to its floor or its ceiling (rounding mode is
+/// not documented); a whole product parses exactly. Expected failure: size/4.
+#[hegel::test]
+fn parsing_decimals_is_within_the_byte(mut tc: TestCase) {
+    let (unit, mult, _) = arb_unit(&mut tc);
+    let (number, numerator) = arb_decimal(&mut tc, mult);
+    let scale = 10i128.pow(number.split('.').nth(1).unwrap().len() as u32);
+    let floor = numerator.div_euclid(scale);
+    let ceil = if numerator % scale == 0 { floor } else { floor + 1 };
+    let text = format!("{number}{}{unit}", arb_ws(&mut tc));
+    let parsed = Size::from_str(&text).unwrap_or_else(|e| panic!("{:?}: {}", text, e)).bytes() as i128;
+    assert!(
+        parsed == floor || parsed == ceil,
+        "{:?} -> {}, exact {}/{}",
+        text,
+        parsed,
+        numerator,
+        scale
+    );
+}
+
+/// Text that is not a finite number of bytes in range is an error: `inf`, `nan`, `1e400`,
+/// `10 EB` (10^19 > i64::MAX). Expected failure: size/5.
+#[hegel::test]
+fn parsing_rejects_out_of_range_numbers(mut tc: TestCase) {
+    let text = match n(&mut tc, 0, 4) {
+        0 => pick(&mut tc, &["inf", "infinity", "nan", "NaN", "Inf", "INFINITY"]).to_string(),
+        1 => format!("1e{}", n(&mut tc, 309, 999)),
+        2 => format!("{} EB", n(&mut tc, 10, 1_000_000)),
+        3 => format!("{} EiB", n(&mut tc, 8, 1_000_000)),
+        _ => format!("{}", n(&mut tc, 1, 999) as u128 * 10u128.pow(19)),
+    };
+    let parsed = Size::from_str(&text);
+    assert!(parsed.is_err(), "{text:?} -> {:?}", parsed.map(|s| s.bytes()));
+}
+
+/// A unit takes at most one plural `s`, and only full names take one: `kbs`, `bytess`, `s`
+/// and `bs` are not units. Expected failure: size/6.
+#[hegel::test]
+fn unit_suffixes_take_at_most_one_plural_s(mut tc: TestCase) {
+    let (unit, _, full) = arb_unit(&mut tc);
+    let bad = match n(&mut tc, 0, 2) {
+        0 => format!("{}ss", unit.trim_end_matches(['s', 'S'])),
+        1 if !full => format!("{unit}s"),
+        _ => "s".repeat(n(&mut tc, 1, 3) as usize),
+    };
+    let text = format!("{} {bad}", n(&mut tc, 0, 1000));
+    let parsed = Size::from_str(&text);
+    assert!(parsed.is_err(), "{text:?} -> {:?}", parsed.map(|s| s.bytes()));
+}
+
+/// The parser never panics.
+#[hegel::test]
+fn parsing_never_panics(mut tc: TestCase) {
+    let alphabet: Vec<char> = "0123456789.eE+- \tkKmMgGtTpPeEiIbBsSxXyYtTeEinfa"
+        .chars()
+        .collect();
+    let len = n(&mut tc, 0, 12) as usize;
+    let text: String = (0..len).map(|_| pick(&mut tc, &alphabet)).collect();
+    let _ = Size::from_str(&text);
+    let _ = text.parse::<Size>();
+}
+
+/// Pins for the parser.
+#[test]
+fn parser_examples() {
+    assert_eq!(Size::from_str("12.34 KB"), Ok(Size::from_const(12_340)));
+    assert_eq!(Size::from_str("12.34 kIloByte"), Ok(Size::from_const(12_340)));
+    assert_eq!(Size::from_str("1234KiB"), Ok(Size::from_const(1234 * 1024)));
+    assert_eq!(Size::from_str("0.423e3kb"), Ok(Size::from_const(423_000)));
+    assert_eq!(Size::from_str("-1.5 KiB"), Ok(Size::from_const(-1536)));
+    assert!(Size::from_str("1234 XB").is_err());
+    assert!(Size::from_str("12..34 MB").is_err());
+    assert!(Size::from_str("").is_err());
+    // size/4: the product is computed in f64 and truncated
+    assert_eq!(Size::from_str("1.005 KB").map(|s| s.bytes()), Ok(1004)); // 1005
+    assert_eq!(
+        Size::from_str("9007199254740993").map(|s| s.bytes()),
+        Ok(9_007_199_254_740_992) // one less than written
+    );
+    // size/5: out-of-range text is accepted
+    assert_eq!(Size::from_str("inf").map(|s| s.bytes()), Ok(i64::MAX));
+    assert_eq!(Size::from_str("nan").map(|s| s.bytes()), Ok(0));
+    assert_eq!(Size::from_str("10 EB").map(|s| s.bytes()), Ok(i64::MAX));
+    // size/6: any number of trailing `s`
+    assert_eq!(Size::from_str("12 kbs").map(|s| s.bytes()), Ok(12_000));
+    assert_eq!(Size::from_str("12 bytess").map(|s| s.bytes()), Ok(12));
+    assert_eq!(Size::from_str("12 s").map(|s| s.bytes()), Ok(12));
+}
+
+// ---------------------------------------------------------------- arithmetic
+
+/// Within 2^53, construction and arithmetic are exact integer arithmetic: `from_bytes`,
+/// `from_<unit>` of an integer, `+`, `-`, `*` and `/` by an integer (truncating toward zero),
+/// `Sum`, the assign forms, and `Ord`/`Eq` follow the byte counts.
+#[hegel::test]
+fn arithmetic_is_exact_within_2_53(mut tc: TestCase) {
+    let a = n(&mut tc, -(EXACT / 2), EXACT / 2);
+    let b = n(&mut tc, -(EXACT / 2), EXACT / 2);
+    let sa = Size::from_bytes(a);
+    let sb = Size::from_bytes(b);
+    assert_eq!(sa.bytes(), a);
+    assert_eq!(Size::from_bytes(a as f64), sa);
+    assert_eq!(Size::from_const(a), sa);
+    assert_eq!((sa + sb).bytes(), a + b);
+    assert_eq!((&sa + sb).bytes(), a + b);
+    assert_eq!((sa + &sb).bytes(), a + b);
+    assert_eq!((&sa + &sb).bytes(), a + b);
+    assert_eq!((sa - sb).bytes(), a - b);
+    assert_eq!((&sa - &sb).bytes(), a - b);
+    assert_eq!([sa, sb].iter().sum::<Size>().bytes(), a + b);
+    assert_eq!(IntoIterator::into_iter([sa, sb]).sum::<Size>().bytes(), a + b);
+    let mut acc = sa;
+    acc += sb;
+    acc -= sb;
+    assert_eq!(acc, sa);
+    assert_eq!(sa.cmp(&sb), a.cmp(&b));
+    assert_eq!(sa == sb, a == b);
+
+    let k = n(&mut tc, -1000, 1000);
+    // |small| ≤ 2^40 keeps `small / k` (k ≤ 1000) at least half an ulp away from any integer
+    let small = n(&mut tc, -(EXACT / 8192), EXACT / 8192);
+    let s = Size::from_const(small);
+    assert_eq!((s * k).bytes(), small * k, "{small} * {k}");
+    assert_eq!((k * s).bytes(), small * k);
+    assert_eq!((&s * k).bytes(), small * k);
+    assert_eq!((s * (k as f64)).bytes(), small * k);
+    if k != 0 {
+        assert_eq!((s / k).bytes(), small / k, "{small} / {k}");
+        assert_eq!((&s / k).bytes(), small / k);
+        let mut q = s;
+        q /= k;
+        assert_eq!(q.bytes(), small / k);
+    }
+    let mut m = s;
+    m *= k;
+    assert_eq!(m.bytes(), small * k);
+
+    // integer constructors
+    let v = n(&mut tc, -1000, 1000);
+    for (i, (b2, b10)) in [
+        (Size::from_kib(v), Size::from_kb(v)),
+        (Size::from_mib(v), Size::from_mb(v)),
+        (Size::from_gib(v), Size::from_gb(v)),
+        (Size::from_tib(v), Size::from_tb(v)),
+    ]
+    .iter()
+    .enumerate()
+    {
+        let k = (i + 1) as u32;
+        assert_eq!(b2.bytes(), v * 1024i64.pow(k), "from_*ib({v}) k={k}");
+        assert_eq!(b10.bytes(), v * 1000i64.pow(k), "from_*b({v}) k={k}");
+    }
+    assert_eq!(Size::from_kibibytes(v), Size::from_kib(v));
+    assert_eq!(Size::from_gigabytes(v), Size::from_gb(v));
+    assert_eq!(Size::from_pib(v), Size::from_const(v * (1 << 50)));
+    assert_eq!(Size::from_pb(v), Size::from_const(v * 1_000_000_000_000_000));
+    // halves are exact in both bases
+    let half = v as f64 + 0.5;
+    assert_eq!(Size::from_kib(half).bytes(), v * 1024 + 512);
+    assert_eq!(Size::from_kb(half).bytes(), v * 1000 + 500);
+}
+
+/// `Size` holds an `i64`; every `i64` survives `from_bytes`, `+ ZERO`, `- ZERO`, `* 1`, `/ 1`
+/// and a one-element `Sum`. Expected failure: size/1.
+#[hegel::test]
+fn sizes_are_exact_in_the_i64_range(mut tc: TestCase) {
+    // half the draws above 2^53 (8 PiB), where an f64 no longer holds every integer
+    let x = if chance(&mut tc, 50) {
+        let mag = n(&mut tc, EXACT + 1, i64::MAX - 1);
+        if chance(&mut tc, 30) { -mag } else { mag }
+    } else {
+        n(&mut tc, -EXACT, EXACT)
+    };
+    let s = Size::from_const(x);
+    assert_eq!(Size::from_bytes(x).bytes(), x, "from_bytes");
+    assert_eq!((s + Size::ZERO).bytes(), x, "+ ZERO");
+    assert_eq!((s - Size::ZERO).bytes(), x, "- ZERO");
+    assert_eq!((s * 1).bytes(), x, "* 1");
+    assert_eq!((s / 1).bytes(), x, "/ 1");
+    assert_eq!(IntoIterator::into_iter([s]).sum::<Size>().bytes(), x, "sum");
+    let y = n(&mut tc, i64::MIN + 1, i64::MAX - 1);
+    assert_eq!(Size::from_bytes(x) == Size::from_bytes(y), x == y, "{x} == {y}");
+}
+
+/// Pins for arithmetic.
+#[test]
+fn arithmetic_examples() {
+    assert_eq!(Size::from_mib(2) + Size::from_kib(200), Size::from_mb(2.301_952));
+    assert_eq!(Size::from_gb(4.2) / 2, Size::from_gb(2.1));
+    assert_eq!(Size::from_mib(13) / 2, Size::from_mib(6.5_f32));
+    assert_eq!((Size::from_mib(12) - Size::from_mib(14.2_f64)), Size::from_kib(-2252.8));
+    assert_eq!(Size::from_kib(2.5).bytes(), 2560);
+    // size/1: everything above 2^53 goes through f64
+    let x = (1i64 << 53) + 1;
+    assert_eq!(Size::from_bytes(x).bytes(), x - 1);
+    assert_eq!((Size::from_const(x) + Size::ZERO).bytes(), x - 1);
+    assert_eq!((Size::from_const(x) * 1).bytes(), x - 1);
+    assert_eq!(Size::from_bytes(x), Size::from_bytes(x - 1));
+    assert_eq!(Size::from_bytes(i64::MAX - 1).bytes(), i64::MAX);
+    // but `from_const` and the serde integer path are exact
+    assert_eq!(Size::from_const(x).bytes(), x);
+    assert_eq!(serde_json::from_str::<Size>(&x.to_string()).unwrap().bytes(), x);
+}
