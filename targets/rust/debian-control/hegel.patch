+#[hegel::test]
+fn checksum_entries_round_trip(tc: hegel::TestCase) {
+    let filename = arb_filename(&tc, &pick(&tc, SOURCES), &pick(&tc, VERSIONS));
+    let size = tc.draw(int!(0, 1i64 << 40)) as usize;
+    let md5 = Md5Checksum { md5sum: arb_hex(&tc, 32), size, filename: filename.clone() };
+    assert_eq!(Md5Checksum::from_str(&md5.to_string()), Ok(md5.clone()));
+    let sha1 = Sha1Checksum { sha1: arb_hex(&tc, 40), size, filename: filename.clone() };
+    assert_eq!(Sha1Checksum::from_str(&sha1.to_string()), Ok(sha1.clone()));
+    let sha256 = Sha256Checksum { sha256: arb_hex(&tc, 64), size, filename: filename.clone() };
+    assert_eq!(Sha256Checksum::from_str(&sha256.to_string()), Ok(sha256.clone()));
+    let sha512 = Sha512Checksum { sha512: arb_hex(&tc, 128), size, filename: filename.clone() };
+    assert_eq!(Sha512Checksum::from_str(&sha512.to_string()), Ok(sha512.clone()));
+    let file = File { md5sum: md5.md5sum.clone(), size, section: pick(&tc, SECTIONS).to_string(), priority: pick(&tc, PRIORITIES), filename: filename.clone() };
+    assert_eq!(File::from_str(&file.to_string()), Ok(file.clone()));
+    // Extra whitespace is accepted; a missing part is an error, not a panic.
+    assert_eq!(Sha1Checksum::from_str(&format!("  {}\t{} {}  ", sha1.sha1, size, filename)), Ok(sha1.clone()));
+    assert!(Sha1Checksum::from_str(&format!("{} {}", sha1.sha1, size)).is_err());
+    assert!(Sha1Checksum::from_str(&format!("{} x {}", sha1.sha1, filename)).is_err());
+    assert!(File::from_str(&format!("{} {} {}", md5.md5sum, size, filename)).is_err(), "a .dsc-style 3-part Files line is not a .changes File");
+}
