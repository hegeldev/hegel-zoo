+#[hegel::test]
+fn control_files_are_read_like_dpkg(tc: hegel::TestCase) {
+    let g = tc.draw(arb_control(true).print_as_debug());
+    let text = g.text();
+    let c = Control::from_str(&text).expect("a valid control file parses");
+    assert_eq!(c.to_string(), text, "lossless");
+    let s = c.source().expect("a source paragraph");
+    check_source(&s, &g.source);
+    let bins: Vec<Binary> = c.binaries().collect();
+    assert_eq!(bins.len(), g.binaries.len(), "binary count");
+    for (b, gb) in bins.iter().zip(g.binaries.iter()) {
+        check_binary(b, gb);
+    }
+    // Raw fields in order.
+    let raw: Fields = s.as_deb822().items().collect();
+    assert_eq!(raw, g.source.ordered(), "source fields");
+    for (b, gb) in bins.iter().zip(g.binaries.iter()) {
+        let raw: Fields = b.as_deb822().items().collect();
+        assert_eq!(raw, dedent(&gb.ordered()), "binary fields");
+    }
+    // Identity ranges slice the text to the emails.
+    for id in s.maintainer_identities().into_iter().chain(s.uploaders_identities()) {
+        let r = id.email_range;
+        assert_eq!(&text[usize::from(r.start())..usize::from(r.end())], id.email, "email range");
+    }
+    // dpkg reads the same fields.
+    let (dsrc, dpkgs) = dpkg_control(&text).expect("dpkg reads a valid control file");
+    assert_eq!(dsrc, as_dpkg(&g.source.fields()), "dpkg's source fields");
+    assert_eq!(dpkgs.len(), g.binaries.len());
+    for (d, gb) in dpkgs.iter().zip(g.binaries.iter()) {
+        assert_eq!(*d, as_dpkg(&gb.fields()), "dpkg's binary fields");
+    }
+    // Ranges: each binary is found by its own range and no other.
+    for (i, b) in bins.iter().enumerate() {
+        let r = b.as_deb822().text_range();
+        let found: Vec<Option<String>> = c.binaries_in_range(r).map(|x| x.name()).collect();
+        assert_eq!(found, vec![b.name()], "binaries_in_range of binary {i}");
+        assert!(b.overlaps_range(r));
+        assert_eq!(c.source_in_range(r).is_some(), false, "the source does not overlap a binary");
+        let n_fields = b.as_deb822().items().count();
+        assert_eq!(b.fields_in_range(r).count(), n_fields, "fields_in_range of a whole binary");
+    }
+    let sr = s.as_deb822().text_range();
+    assert_eq!(c.source_in_range(sr).map(|s| s.name()), Some(Some(g.source.name.clone())));
+    assert_eq!(c.fields_in_range(sr).count(), g.source.fields().len(), "fields_in_range of the source");
+}
