+/// `Entry::push` on an entry inside a field adds one alternative to that entry and nothing else
+/// (bug debian-control/18: the whole field is nested into the entry and its text duplicated).
+#[hegel::test]
+fn entry_push_inside_a_field_keeps_the_field(tc: hegel::TestCase) {
+    let g = tc.draw(arb_relations(false).print_as_debug());
+    if hits_negated_arch_bug(&g) || hits_rparen_bug(&g) || g.entries.is_empty() {
+        return;
+    }
+    let rels = Relations::from_str(&g.text).unwrap();
+    let idx = tc.draw(int!(0usize, g.entries.len() - 1));
+    let mut r = tc.draw(arb_relation(false).print_as_debug());
+    r.arches = r.arches.map(|a| a.into_iter().map(|x| x.trim_start_matches('!').to_string()).collect());
+    r.profiles = r.profiles.map(|g| g.into_iter().take(1).collect());
+    r.text = r.dpkg_shape();
+    let mut expected = structure(&rels);
+    expected[idx].push(simple_of(&gen_to_relation(&r)));
+    let mut entry = rels.get_entry(idx).unwrap();
+    let len = entry.len();
+    entry.push(gen_to_relation(&r));
+    assert_eq!(entry.len(), len + 1, "entry.len() after push: {}", rels);
+    assert_eq!(rels.len(), g.entries.len(), "field length after push: {}", rels);
+    assert_eq!(structure(&rels), expected, "{}", rels);
+    let d = dpkg(&rels.to_string()).unwrap_or_else(|| panic!("dpkg does not parse {:?}", rels.to_string()));
+    assert_eq!(d.entries, expected, "dpkg reads {:?}", rels.to_string());
+}
