+/// Removing the last alternative of an entry removes the entry: `len()` and `entries()` agree
+/// with the text (bug debian-control/11).
+#[hegel::test]
+fn removing_the_last_alternative_removes_the_entry(tc: hegel::TestCase) {
+    let g = tc.draw(arb_relations(false).print_as_debug());
+    if hits_negated_arch_bug(&g) || hits_rparen_bug(&g) || g.entries.is_empty() {
+        return;
+    }
+    let rels = Relations::from_str(&g.text).unwrap();
+    let count = rels.len();
+    let idx = tc.draw(int!(0usize, count - 1));
+    let entry = rels.get_entry(idx).unwrap();
+    let len = entry.len();
+    for _ in 0..len {
+        entry.remove_relation(0);
+    }
+    let text = rels.to_string();
+    let again = Relations::from_str(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    assert_eq!(rels.len(), again.len(), "len() of the edited tree vs its text {text:?}");
+    assert_eq!(rels.len(), count - 1, "{text:?}");
+    assert_eq!(rels.is_empty(), count == 1);
+}
+
+/// `wrap_and_sort` keeps the architecture qualifier visible: `archqual()` on the result, equality
+/// and a second `wrap_and_sort` (bug debian-control/16).
+#[hegel::test]
+fn wrap_and_sort_keeps_the_qualifier(tc: hegel::TestCase) {
+    let mut r = tc.draw(arb_relation(false).print_as_debug());
+    if r.archqual.is_none() {
+        r.archqual = Some(pick(&tc, ARCHQUALS).to_string());
+    }
+    if r.negated_arches() {
+        r.arches = None;
+    }
+    r.text = r.dpkg_shape();
+    let rel = Relation::from_str(&r.text).unwrap();
+    let sorted = rel.wrap_and_sort();
+    assert_eq!(sorted.to_string(), r.text);
+    assert_eq!(sorted.archqual(), r.archqual, "archqual() after wrap_and_sort of {:?}", r.text);
+    assert_eq!(sorted, rel);
+    assert_eq!(sorted.wrap_and_sort().to_string(), r.text, "second wrap_and_sort of {:?}", r.text);
+    let rels = Relations::from_str(&r.text).unwrap().wrap_and_sort();
+    assert_eq!(rels.wrap_and_sort().to_string(), r.text);
+}
+
+/// `Ord` and `Eq` of `Relation` agree on relations that differ only in their qualifiers
+/// (bug debian-control/10).
+#[hegel::test]
+fn ordering_sees_the_qualifiers_equality_sees(tc: hegel::TestCase) {
+    let mut a = tc.draw(arb_relation(false).print_as_debug());
+    let mut b = a.clone();
+    match tc.draw(int!(0u8, 2)) {
+        0 => {
+            a.arches = Some(vec!["amd64".into()]);
+            b.arches = Some(vec![pick(&tc, &["i386", "arm64"]).to_string()]);
+        }
+        1 => {
+            a.archqual = Some("any".into());
+            b.archqual = Some(pick(&tc, &["native", "amd64"]).to_string());
+        }
+        _ => {
+            a.profiles = Some(vec![vec!["!nocheck".into()]]);
+            b.profiles = Some(vec![vec![pick(&tc, &["nocheck", "!cross"]).to_string()]]);
+        }
+    }
+    for r in [&mut a, &mut b] {
+        r.text = r.dpkg_shape();
+    }
+    let ra = Relation::from_str(&a.text).unwrap();
+    let rb = Relation::from_str(&b.text).unwrap();
+    assert_ne!(ra, rb);
+    assert_ne!(ra.cmp(&rb), std::cmp::Ordering::Equal, "{:?} and {:?} compare Equal but are not equal", a.text, b.text);
+}
