+/// python-debian splits the same text into the same names, qualifiers, versions, architecture
+/// and profile flags.
+#[hegel::test]
+fn relations_split_like_python_debian(tc: hegel::TestCase) {
+    let g = tc.draw(arb_relations(false).print_as_debug());
+    if g.newline() || hits_rparen_bug(&g) {
+        // python-debian's `<.+>` does not span lines (it never sees dpkg's line folding).
+        return;
+    }
+    let Some((py, _)) = pydebian(&g.text) else { return };
+    let rels = Relations::from_str(&g.text).unwrap();
+    let mine: Vec<Vec<PyRel>> = rels
+        .entries()
+        .filter(|e| !e.is_empty())
+        .map(|e| {
+            e.relations()
+                .map(|r| PyRel {
+                    name: r.try_name().unwrap(),
+                    archqual: r.archqual(),
+                    version: r.version().map(|(c, v)| (c.to_string(), v.to_string())),
+                    arch: r.architectures().map(|a| a.map(|x| (true, x)).collect()),
+                    restrictions: {
+                        let p: Vec<Vec<(bool, String)>> = r
+                            .profiles()
+                            .map(|g| {
+                                g.iter()
+                                    .map(|b| match b {
+                                        BuildProfile::Enabled(n) => (true, n.to_lowercase()),
+                                        BuildProfile::Disabled(n) => (false, n.to_lowercase()),
+                                    })
+                                    .collect()
+                            })
+                            .collect();
+                        if p.is_empty() { None } else { Some(p) }
+                    },
+                })
+                .collect()
+        })
+        .collect();
+    // python-debian keeps `a,,b` as an unparsable empty relation; drop those.
+    let py: Vec<Vec<PyRel>> = py.into_iter().filter(|e| !(e.len() == 1 && e[0].name.is_empty())).collect();
+    if hits_negated_arch_bug(&g) {
+        return;
+    }
+    assert_eq!(mine, py, "python-debian's split of {:?}", g.text);
+}
