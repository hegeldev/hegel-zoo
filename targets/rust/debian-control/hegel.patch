+/// `set_version` on `pkg:any` writes `pkg:any (>= 1)`, not `pkg (>= 1):any` (bug debian-control/6).
+#[hegel::test]
+fn set_version_keeps_the_qualifier_in_front(tc: hegel::TestCase) {
+    let name = tc.draw(arb_name());
+    let q = pick(&tc, ARCHQUALS);
+    let op = pick(&tc, OPS);
+    let ver: Version = tc.draw(arb_version()).parse().unwrap();
+    let text = format!("{name}:{q}");
+    let mut rels = Relations::from_str(&text).unwrap();
+    let mut r = rels.get_entry(0).unwrap().get_relation(0).unwrap();
+    r.set_version(Some((vc(op), ver.clone())));
+    let out = rels.to_string();
+    assert_eq!(out, format!("{name}:{q} ({op} {ver})"));
+    let d = dpkg(&out).unwrap_or_else(|| panic!("dpkg does not parse {out:?}"));
+    assert_eq!(d.entries[0][0].archqual.as_deref(), Some(q));
+    // The builder takes the same path.
+    let built = Relation::build(&name).archqual(q).version_constraint(vc(op), ver.clone()).build();
+    assert!(dpkg(&built.to_string()).is_some(), "dpkg does not parse the built {:?}", built.to_string());
+}
