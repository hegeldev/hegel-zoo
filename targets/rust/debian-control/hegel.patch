+#[hegel::test]
+fn wrap_and_sort_keeps_the_values_and_is_idempotent(tc: hegel::TestCase) {
+    // No verbatim description lines (their indentation under wrap_and_sort is pinned).
+    let g = tc.draw(arb_control(false).print_as_debug());
+    let text = g.text();
+    let mut c = Control::from_str(&text).unwrap();
+    c.wrap_and_sort(deb822_lossless::Indentation::Spaces(1), false, Some(79));
+    let once = c.to_string();
+    // The live tree after wrap_and_sort is not the parse of its text
+    // (deb822-lossless/12: continuation lines are rebuilt as KEY tokens), so
+    // everything below reads the re-parsed text.
+    let again = Control::from_str(&once).expect("wrapped text parses");
+    // Source first, binaries by name.
+    let names: Vec<String> = again.binaries().map(|b| b.name().unwrap()).collect();
+    let mut expected: Vec<String> = g.binaries.iter().map(|b| b.name.clone()).collect();
+    expected.sort();
+    assert_eq!(names, expected, "binary order");
+    assert!(again.as_deb822().paragraphs().next().unwrap().get("Source").is_some(), "source first");
+    // Values survive (relations canonicalised).
+    check_source(&again.source().unwrap(), &g.source);
+    for b in again.binaries() {
+        let gb = g.binaries.iter().find(|x| Some(x.name.clone()) == b.name()).unwrap();
+        check_binary(&b, gb);
+    }
+    let (dsrc, dpkgs) = dpkg_control(&once).expect("dpkg reads the wrapped file");
+    assert_eq!(dsrc.len(), g.source.fields().len());
+    assert_eq!(dpkgs.len(), g.binaries.len());
+    // Idempotent.
+    let mut c2 = again;
+    c2.wrap_and_sort(deb822_lossless::Indentation::Spaces(1), false, Some(79));
+    assert_eq!(c2.to_string(), once, "wrap_and_sort is idempotent");
+}
