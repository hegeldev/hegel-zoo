+fn check_source(s: &Source, g: &GenSource) {
+    assert_eq!(s.name(), Some(g.name.clone()), "source name");
+    assert_eq!(s.maintainer(), Some(g.maintainer.clone()), "maintainer");
+    assert_eq!(s.uploaders(), if g.uploaders.is_empty() { None } else { Some(g.uploaders.clone()) }, "uploaders");
+    assert_eq!(s.section(), g.section, "section");
+    assert_eq!(s.priority(), g.priority, "priority");
+    assert_eq!(s.standards_version(), g.standards_version, "standards_version");
+    assert!(rel_eq(s.build_depends(), g.build_depends.as_ref()), "build_depends");
+    assert!(rel_eq(s.build_depends_indep(), g.build_depends_indep.as_ref()), "build_depends_indep");
+    assert_eq!(s.vcs_git(), g.vcs_git.as_ref().map(|v| v.text()), "vcs_git");
+    assert_eq!(s.vcs_browser(), g.vcs_browser, "vcs_browser");
+    assert_eq!(s.homepage(), g.homepage.as_ref().map(|u| url::Url::parse(u).unwrap()), "homepage");
+    assert_eq!(s.rules_requires_root(), g.rules_requires_root, "rules_requires_root");
+    assert_eq!(s.testsuite(), g.testsuite, "testsuite");
+    assert_eq!(s.is_qa_package(), g.maintainer.contains("packages@qa.debian.org"), "is_qa_package");
+    let idents: Vec<(String, String)> = s.maintainer_identities().iter().map(|i| (i.name.clone(), i.email.clone())).collect();
+    let (name, email) = debian_control::parse_identity(&g.maintainer).unwrap();
+    assert_eq!(idents, vec![(name.to_string(), email.to_string())], "maintainer identities");
+    let ups: Vec<(String, String)> = s.uploaders_identities().iter().map(|i| (i.name.clone(), i.email.clone())).collect();
+    let expected: Vec<(String, String)> = g
+        .uploaders
+        .iter()
+        .map(|u| {
+            let (n, e) = debian_control::parse_identity(u).unwrap();
+            (n.to_string(), e.to_string())
+        })
+        .collect();
+    assert_eq!(ups, expected, "uploader identities");
+}
