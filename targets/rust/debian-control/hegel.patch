+// --------------------------------------------------------------------------- satisfaction
+
+const FACT_NAMES: &[&str] = &["libc6", "python3", "debhelper", "perl", "zlib1g", "rustc", "cargo", "samba"];
+
+#[hegel::composite]
+fn arb_facts(tc: &hegel::TestCase) -> BTreeMap<String, String> {
+    let mut m = BTreeMap::new();
+    for n in FACT_NAMES {
+        if tc.draw(int!(0u8, 1)) == 0 {
+            m.insert(n.to_string(), tc.draw(arb_version()));
+        }
+    }
+    m
+}
+
+/// `satisfied_by` (lossless and lossy) agrees with dpkg's evaluation against installed packages.
+#[hegel::test]
+fn satisfied_by_agrees_with_dpkg(tc: hegel::TestCase) {
+    let facts = tc.draw(arb_facts().print_as_debug());
+    let mut g = tc.draw(arb_relations(false).print_as_debug());
+    // Use the fact names, qualifiers dpkg resolves on this host, and dpkg's shape.
+    let mut text = Vec::new();
+    for e in &mut g.entries {
+        for r in e.iter_mut() {
+            r.name = pick(&tc, FACT_NAMES).to_string();
+            if r.archqual.as_deref().is_some_and(|q| !["any", "native"].contains(&q)) {
+                r.archqual = None;
+            }
+            r.arches = None;
+            r.text = r.dpkg_shape();
+        }
+        text.push(e.iter().map(|r| r.text.clone()).collect::<Vec<_>>().join(" | "));
+    }
+    let text = text.join(", ");
+    let Some(d) = dpkg_satisfied(&text, &facts) else { panic!("dpkg does not parse {text:?}") };
+    let rels = Relations::from_str(&text).unwrap();
+    let crate_says = rels.satisfied_by(lookup(&facts));
+    assert_eq!(Some(crate_says), d, "{text:?} with {facts:?}: dpkg says {d:?}");
+    let lossy = LossyRelations::from_str(&text).unwrap();
+    assert_eq!(lossy.satisfied_by(lookup(&facts)), crate_says, "lossy satisfied_by of {text:?}");
+    for e in rels.entries() {
+        let any = e.relations().any(|r| Relations::from_str(&r.to_string()).unwrap().satisfied_by(lookup(&facts)));
+        assert_eq!(any, e.satisfied_by(lookup(&facts)));
+    }
+}
+
+// --------------------------------------------------------------------------- editing
+
+#[derive(Debug, Clone)]
+enum Edit {
+    SetVersion(Option<(String, String)>),
+    DropConstraint,
+    SetArchqual(String),
+    SetArchitectures(Vec<String>),
+    AddProfile(Vec<String>),
+    PushAlternative(GenRelation),
+    RemoveRelation,
+    RemoveEntry,
+    PushEntry(GenRelation),
+    InsertEntry(GenRelation),
+    DropDependency(String),
+    AddDependency(GenRelation),
+    EnsureMinimum(String, String),
+    EnsureExact(String, String),
+    EnsureSome(String),
+    Filter(String),
+}
+
+#[hegel::composite]
+fn arb_edit(tc: &hegel::TestCase, names: Vec<String>) -> Edit {
+    let name = |tc: &hegel::TestCase| -> String {
+        if !names.is_empty() && tc.draw(int!(0u8, 1)) == 0 { pick(tc, &names) } else { tc.draw(arb_name()) }
+    };
+    let plain_rel = |tc: &hegel::TestCase| -> GenRelation {
+        let mut r = tc.draw(arb_relation(false).print_as_debug());
+        if tc.draw(int!(0u8, 1)) == 0 {
+            r.name = name(tc);
+        }
+        // Bugs debian-control/1 and /17 have their own pins.
+        r.arches = r.arches.map(|a| a.into_iter().map(|x| x.trim_start_matches('!').to_string()).collect());
+        r.profiles = r.profiles.map(|g| g.into_iter().take(1).collect());
+        r.text = r.dpkg_shape();
+        r
+    };
+    match tc.draw(int!(0u8, 15)) {
+        0 => Edit::SetVersion(if tc.draw(int!(0u8, 4)) == 0 { None } else { Some((pick(tc, OPS).to_string(), tc.draw(arb_version()))) }),
+        1 => Edit::DropConstraint,
+        2 => Edit::SetArchqual(pick(tc, ARCHQUALS).to_string()),
+        3 => {
+            let n = tc.draw(int!(1usize, 3));
+            let mut set = BTreeSet::new();
+            for _ in 0..n {
+                set.insert(pick(tc, ARCHES).to_string());
+            }
+            Edit::SetArchitectures(set.into_iter().collect())
+        }
+        4 => {
+            let n = tc.draw(int!(1usize, 2));
+            let mut set = BTreeSet::new();
+            for _ in 0..n {
+                set.insert(pick(tc, PROFILES).to_string());
+            }
+            Edit::AddProfile(set.into_iter().map(|p| if tc.draw(int!(0u8, 1)) == 0 { format!("!{p}") } else { p }).collect())
+        }
+        5 => Edit::PushAlternative(plain_rel(tc)),
+        6 => Edit::RemoveRelation,
+        7 => Edit::RemoveEntry,
+        8 => Edit::PushEntry(plain_rel(tc)),
+        9 => Edit::InsertEntry(plain_rel(tc)),
+        10 => Edit::DropDependency(name(tc)),
+        11 => Edit::AddDependency(plain_rel(tc)),
+        12 => Edit::EnsureMinimum(name(tc), tc.draw(arb_version())),
+        13 => Edit::EnsureExact(name(tc), tc.draw(arb_version())),
+        14 => Edit::EnsureSome(name(tc)),
+        _ => Edit::Filter(name(tc)),
+    }
+}
+
+fn gen_to_relation(r: &GenRelation) -> Relation {
+    let mut b = Relation::build(&r.name);
+    if let Some((op, v)) = &r.version {
+        b = b.version_constraint(vc(op), v.parse().unwrap());
+    }
+    if let Some(q) = &r.archqual {
+        b = b.archqual(q);
+    }
+    if let Some(a) = &r.arches {
+        b = b.architectures(a.clone());
+    }
+    if let Some(groups) = &r.profiles {
+        b = b.profiles(groups.iter().map(|g| g.iter().map(|p| p.parse().unwrap()).collect()).collect());
+    }
+    b.build()
+}
+
+/// Whether the entry at `idx` has a first relation named `name` alone (the `ensure_*` fast path).
+fn names_of(e: &Entry) -> Vec<String> {
+    e.relations().filter_map(|r| r.try_name()).collect()
+}
+
+/// The generic expectations after any edit: the text re-parses strictly to the same structure the
+/// accessors on the edited tree show, and dpkg reads that structure too.
+fn check_consistent(rels: &Relations, what: &str, before: &str) {
+    let text = rels.to_string();
+    let reparsed = Relations::from_str(&text).unwrap_or_else(|e| panic!("after {what} on {before:?} the text {text:?} does not parse: {e}"));
+    assert_eq!(structure(&reparsed), structure(rels), "after {what} on {before:?}: tree {text:?} differs from its re-parse");
+    let d = dpkg(&text).unwrap_or_else(|| panic!("after {what} on {before:?} dpkg does not parse {text:?}"));
+    assert_eq!(d.entries, structure(rels), "after {what} on {before:?}: dpkg reads {text:?} differently");
+}
+
+/// Bug debian-control/6: `set_version` on a relation with an architecture qualifier writes
+/// `pkg (>= 1):any`.
+fn hits_set_version_archqual_bug(r: &Relation, edit: &Edit) -> bool {
+    matches!(edit, Edit::SetVersion(Some(_))) && r.archqual().is_some() && r.version().is_none()
+}
+
+/// Bug debian-control/8: `add_profile` replaces the existing restriction lists.
+fn hits_add_profile_bug(r: &Relation, edit: &Edit) -> bool {
+    matches!(edit, Edit::AddProfile(_)) && r.profiles().count() > 0
+}
+
+/// Bug debian-control/9: `ensure_minimum_version` / `ensure_exact_version` replace the relation
+/// wholesale, dropping its qualifier, architectures and profiles.
+fn hits_ensure_drops_qualifiers_bug(rels: &Relations, edit: &Edit) -> bool {
+    let name = match edit {
+        Edit::EnsureMinimum(n, _) | Edit::EnsureExact(n, _) => n,
+        _ => return false,
+    };
+    rels.entries().any(|e| {
+        let names = names_of(&e);
+        names.len() == 1 && &names[0] == name && {
+            let r = e.relations().next().unwrap();
+            r.archqual().is_some() || r.architectures().is_some() || r.profiles().count() > 0
+        }
+    })
+}
+
+/// 1–3 random edits on a parsed field; after each, the tree, its re-parse and dpkg agree and
+/// the edit's own promise holds.
+#[hegel::test]
+fn edits_are_read_back(tc: hegel::TestCase) {
+    let g = tc.draw(arb_relations(false).print_as_debug());
+    if hits_negated_arch_bug(&g) || hits_rparen_bug(&g) {
+        return;
+    }
+    let mut rels = Relations::from_str(&g.text).unwrap();
+    let n = tc.draw(int!(1usize, 3));
+    for _ in 0..n {
+        let names: Vec<String> = rels.entries().flat_map(|e| names_of(&e)).collect();
+        let edit = tc.draw(arb_edit(names.clone()).print_as_debug());
+        let before = rels.to_string();
+        let what = format!("{edit:?}");
+        let count = rels.len();
+        let complex = |name: &str| rels.entries().any(|e| { let ns = names_of(&e); ns.len() > 1 && ns.contains(&name.to_string()) });
+        let target = if count > 0 { Some(tc.draw(int!(0usize, count - 1))) } else { None };
+        match &edit {
+            Edit::SetVersion(_) | Edit::DropConstraint if target.is_some() => {
+                let mut entry = rels.get_entry(target.unwrap()).unwrap();
+                let k = tc.draw(int!(0usize, entry.len() - 1));
+                let mut r = entry.get_relation(k).unwrap();
+                if hits_set_version_archqual_bug(&r, &edit) {
+                    return;
+                }
+                let expected = match &edit {
+                    Edit::SetVersion(Some((op, ver))) => {
+                        r.set_version(Some((vc(op), ver.parse().unwrap())));
+                        Some((vc(op), ver.parse::<Version>().unwrap()))
+                    }
+                    Edit::SetVersion(None) => {
+                        r.set_version(None);
+                        None
+                    }
+                    _ => {
+                        let had = r.version().is_some();
+                        assert_eq!(r.drop_constraint(), had);
+                        None
+                    }
+                };
+                assert_eq!(r.version(), expected, "version() on the edited relation");
+                // The edited relation is the k-th of the entry, in memory.
+                let again = Relations::from_str(&rels.to_string()).unwrap();
+                let rr = again.get_entry(target.unwrap()).unwrap().get_relation(k).unwrap();
+                assert_eq!(rr.version(), expected, "version() after re-parse");
+                let _ = &mut entry;
+            }
+            Edit::SetArchqual(q) if target.is_some() => {
+                let entry = rels.get_entry(target.unwrap()).unwrap();
+                let k = tc.draw(int!(0usize, entry.len() - 1));
+                let mut r = entry.get_relation(k).unwrap();
+                r.set_archqual(q);
+                assert_eq!(r.archqual().as_deref(), Some(q.as_str()));
+                let again = Relations::from_str(&rels.to_string()).unwrap();
+                assert_eq!(again.get_entry(target.unwrap()).unwrap().get_relation(k).unwrap().archqual().as_deref(), Some(q.as_str()));
+            }
+            Edit::SetArchitectures(a) if target.is_some() => {
+                let entry = rels.get_entry(target.unwrap()).unwrap();
+                let k = tc.draw(int!(0usize, entry.len() - 1));
+                let mut r = entry.get_relation(k).unwrap();
+                if hits_immutable_node_bug(&r, &edit) {
+                    return;
+                }
+                r.set_architectures(a.iter().map(|s| s.as_str()));
+                assert_eq!(r.architectures().map(|x| x.collect::<Vec<_>>()), Some(a.clone()));
+                let again = Relations::from_str(&rels.to_string()).unwrap();
+                assert_eq!(again.get_entry(target.unwrap()).unwrap().get_relation(k).unwrap().architectures().map(|x| x.collect::<Vec<_>>()), Some(a.clone()));
+            }
+            Edit::AddProfile(p) if target.is_some() => {
+                let entry = rels.get_entry(target.unwrap()).unwrap();
+                let k = tc.draw(int!(0usize, entry.len() - 1));
+                let mut r = entry.get_relation(k).unwrap();
+                if hits_add_profile_bug(&r, &edit) || hits_immutable_node_bug(&r, &edit) {
+                    return;
+                }
+                let before_groups: Vec<Vec<String>> = r.profiles().map(|g| profile_strings(&g)).collect();
+                let group: Vec<BuildProfile> = p.iter().map(|s| s.parse().unwrap()).collect();
+                r.add_profile(&group);
+                let mut expected = before_groups;
+                expected.push(p.clone());
+                assert_eq!(r.profiles().map(|g| profile_strings(&g)).collect::<Vec<_>>(), expected, "profiles() after add_profile");
+            }
+            Edit::PushAlternative(gr) if target.is_some() => {
+                // Bug debian-control/18.
+                return;
+                #[allow(unreachable_code)]
+                let mut entry = rels.get_entry(target.unwrap()).unwrap();
+                let len = entry.len();
+                entry.push(gen_to_relation(gr));
+                assert_eq!(entry.len(), len + 1);
+                assert_eq!(entry.relations().last().unwrap().try_name().as_deref(), Some(gr.name.as_str()));
+                let again = Relations::from_str(&rels.to_string()).unwrap();
+                assert_eq!(again.get_entry(target.unwrap()).unwrap().len(), len + 1, "{}", rels);
+            }
+            Edit::RemoveRelation if target.is_some() => {
+                let entry = rels.get_entry(target.unwrap()).unwrap();
+                let len = entry.len();
+                if len == 1 {
+                    // Bug debian-control/11.
+                    return;
+                }
+                let k = tc.draw(int!(0usize, len - 1));
+                let expected: Vec<Simple> = entry.relations().enumerate().filter(|(i, _)| *i != k).map(|(_, r)| simple_of(&r)).collect();
+                entry.remove_relation(k);
+                let again = Relations::from_str(&rels.to_string()).unwrap();
+                if len == 1 {
+                    assert_eq!(again.len(), count - 1, "removing the only relation removes the entry: {}", rels);
+                } else {
+                    let e2 = again.get_entry(target.unwrap()).unwrap();
+                    assert_eq!(e2.relations().map(|r| simple_of(&r)).collect::<Vec<_>>(), expected, "{}", rels);
+                }
+            }
+            Edit::RemoveEntry if target.is_some() => {
+                let expected: Vec<Vec<Simple>> = structure(&rels).into_iter().enumerate().filter(|(i, _)| *i != target.unwrap()).map(|(_, e)| e).collect();
+                rels.remove_entry(target.unwrap());
+                assert_eq!(structure(&rels), expected);
+            }
+            Edit::PushEntry(gr) => {
+                let mut expected = structure(&rels);
+                expected.push(vec![simple_of(&gen_to_relation(gr))]);
+                rels.push(Entry::from(gen_to_relation(gr)));
+                assert_eq!(structure(&rels), expected, "{}", rels);
+            }
+            Edit::InsertEntry(gr) => {
+                let at = tc.draw(int!(0usize, count));
+                let mut expected = structure(&rels);
+                expected.insert(at, vec![simple_of(&gen_to_relation(gr))]);
+                rels.insert(at, Entry::from(gen_to_relation(gr)));
+                assert_eq!(structure(&rels), expected, "{}", rels);
+            }
+            Edit::DropDependency(name) => {
+                let expected: Vec<Vec<Simple>> = structure(&rels).into_iter().filter(|e| !(e.len() == 1 && &e[0].package == name)).collect();
+                let found = rels.drop_dependency(name);
+                assert_eq!(found, expected.len() != count);
+                assert_eq!(structure(&rels), expected);
+                assert!(rels.get_relation(name).is_err());
+            }
+            Edit::AddDependency(gr) => {
+                let expected_set: Vec<Simple> = structure(&rels).into_iter().flatten().chain(std::iter::once(simple_of(&gen_to_relation(gr)))).collect();
+                let sorted_before = rels.is_sorted(&WrapAndSortOrder);
+                let default_sorted_before = rels.is_sorted(&DefaultSortingOrder);
+                rels.add_dependency(Entry::from(gen_to_relation(gr)), None);
+                let mut got: Vec<Simple> = structure(&rels).into_iter().flatten().collect();
+                let mut want = expected_set;
+                got.sort_by(|a, b| format!("{a:?}").cmp(&format!("{b:?}")));
+                want.sort_by(|a, b| format!("{a:?}").cmp(&format!("{b:?}")));
+                assert_eq!(got, want);
+                assert!(rels.has_relation(&gr.name));
+                if count >= 2 && sorted_before {
+                    assert!(rels.is_sorted(&WrapAndSortOrder), "add_dependency broke the wrap-and-sort order: {}", rels);
+                } else if count >= 2 && default_sorted_before {
+                    assert!(rels.is_sorted(&DefaultSortingOrder), "add_dependency broke the default order: {}", rels);
+                }
+            }
+            Edit::EnsureMinimum(name, ver) => {
+                if complex(name) || hits_ensure_drops_qualifiers_bug(&rels, &edit) {
+                    return;
+                }
+                let v: Version = ver.parse().unwrap();
+                let previous = rels.get_relation(name).ok().map(|(_, e)| e.relations().next().unwrap().version());
+                rels.ensure_minimum_version(name, &v);
+                let (_, e) = rels.get_relation(name).unwrap_or_else(|err| panic!("{err}: {}", rels));
+                let r = e.relations().next().unwrap();
+                let got = r.version().unwrap();
+                match previous {
+                    Some(Some((VersionConstraint::GreaterThanEqual, old))) if old >= v => assert_eq!(got, (VersionConstraint::GreaterThanEqual, old)),
+                    Some(Some((VersionConstraint::GreaterThan, old))) if old >= v => assert_eq!(got, (VersionConstraint::GreaterThan, old)),
+                    Some(Some((c @ (VersionConstraint::Equal | VersionConstraint::LessThan | VersionConstraint::LessThanEqual), old))) => {
+                        assert_eq!(got, (c, old))
+                    }
+                    _ => assert_eq!(got, (VersionConstraint::GreaterThanEqual, v.clone()), "{}", rels),
+                }
+            }
+            Edit::EnsureExact(name, ver) => {
+                if complex(name) || hits_ensure_drops_qualifiers_bug(&rels, &edit) {
+                    return;
+                }
+                let v: Version = ver.parse().unwrap();
+                rels.ensure_exact_version(name, &v);
+                let (_, e) = rels.get_relation(name).unwrap_or_else(|err| panic!("{err}: {}", rels));
+                assert_eq!(e.relations().next().unwrap().version(), Some((VersionConstraint::Equal, v)), "{}", rels);
+            }
+            Edit::EnsureSome(name) => {
+                if complex(name) {
+                    return;
+                }
+                let before_s = structure(&rels);
+                rels.ensure_some_version(name);
+                if before_s.iter().any(|e| e.len() == 1 && &e[0].package == name) {
+                    assert_eq!(structure(&rels), before_s);
+                } else {
+                    assert_eq!(rels.len(), count + 1);
+                    assert!(rels.get_relation(name).is_ok(), "{}", rels);
+                }
+            }
+            Edit::Filter(name) => {
+                let expected: Vec<Vec<Simple>> = structure(&rels).into_iter().filter(|e| e.iter().any(|r| &r.package == name)).collect();
+                rels.filter_entries(|e| e.relations().any(|r| r.try_name().as_deref() == Some(name)));
+                assert_eq!(structure(&rels), expected);
+            }
+            _ => continue,
+        }
+        check_consistent(&rels, &what, &before);
+    }
+}
+
+/// `set_version` on `pkg:any` writes `pkg:any (>= 1)`, not `pkg (>= 1):any` (bug debian-control/6).
+#[hegel::test]
+fn set_version_keeps_the_qualifier_in_front(tc: hegel::TestCase) {
+    let name = tc.draw(arb_name());
+    let q = pick(&tc, ARCHQUALS);
+    let op = pick(&tc, OPS);
+    let ver: Version = tc.draw(arb_version()).parse().unwrap();
+    let text = format!("{name}:{q}");
+    let mut rels = Relations::from_str(&text).unwrap();
+    let mut r = rels.get_entry(0).unwrap().get_relation(0).unwrap();
+    r.set_version(Some((vc(op), ver.clone())));
+    let out = rels.to_string();
+    assert_eq!(out, format!("{name}:{q} ({op} {ver})"));
+    let d = dpkg(&out).unwrap_or_else(|| panic!("dpkg does not parse {out:?}"));
+    assert_eq!(d.entries[0][0].archqual.as_deref(), Some(q));
+    // The builder takes the same path.
+    let built = Relation::build(&name).archqual(q).version_constraint(vc(op), ver.clone()).build();
+    assert!(dpkg(&built.to_string()).is_some(), "dpkg does not parse the built {:?}", built.to_string());
+}
+
+/// `Entry::from(vec![a, b])` builds a real pipe: removing an alternative afterwards leaves a
+/// clean entry (bug debian-control/7).
+#[hegel::test]
+fn built_entries_have_real_pipes(tc: hegel::TestCase) {
+    let n = tc.draw(int!(2usize, 3));
+    let rels: Vec<GenRelation> = (0..n).map(|_| { let mut r = tc.draw(arb_relation(false).print_as_debug()); r.text = r.dpkg_shape(); r }).collect();
+    let entry = Entry::from(rels.iter().map(gen_to_relation).collect::<Vec<_>>());
+    let text = entry.to_string();
+    assert_eq!(text, rels.iter().map(|r| r.text.clone()).collect::<Vec<_>>().join(" | "));
+    let k = tc.draw(int!(0usize, n - 1));
+    entry.remove_relation(k);
+    let expected: Vec<String> = rels.iter().enumerate().filter(|(i, _)| *i != k).map(|(_, r)| r.text.clone()).collect();
+    assert_eq!(entry.to_string(), expected.join(" | "), "after removing alternative {k} of {text:?}");
+    let mut e2 = Entry::from(rels.iter().map(gen_to_relation).collect::<Vec<_>>());
+    e2.push(Relation::simple("zzz"));
+    assert_eq!(e2.to_string(), format!("{text} | zzz"));
+}
+
+/// `add_profile` adds a restriction list instead of replacing the existing ones (bug debian-control/8).
+#[hegel::test]
+fn add_profile_adds(tc: hegel::TestCase) {
+    let mut r = tc.draw(arb_relation(false).print_as_debug());
+    r.arches = None;
+    if r.profiles.is_none() {
+        r.profiles = Some(vec![vec![format!("!{}", pick(&tc, PROFILES))]]);
+    }
+    r.text = r.dpkg_shape();
+    let mut rel = Relation::from_str(&r.text).unwrap();
+    let new = vec![BuildProfile::Enabled(pick(&tc, PROFILES).to_string())];
+    rel.add_profile(&new);
+    let mut expected = r.profiles.clone().unwrap();
+    expected.push(profile_strings(&new));
+    assert_eq!(rel.profiles().map(|g| profile_strings(&g)).collect::<Vec<_>>(), expected, "{}", rel);
+}
+
+/// `ensure_minimum_version` / `ensure_exact_version` keep the relation's qualifier,
+/// architectures and profiles (bug debian-control/9).
+#[hegel::test]
+fn ensure_version_keeps_qualifiers(tc: hegel::TestCase) {
+    let mut r = tc.draw(arb_relation(false).print_as_debug());
+    if r.archqual.is_none() && r.arches.is_none() && r.profiles.is_none() {
+        r.archqual = Some("any".into());
+    }
+    if r.negated_arches() {
+        r.arches = None;
+        if r.archqual.is_none() && r.profiles.is_none() {
+            r.archqual = Some("native".into());
+        }
+    }
+    r.text = r.dpkg_shape();
+    let v: Version = tc.draw(arb_version()).parse().unwrap();
+    let exact = tc.draw(int!(0u8, 1)) == 0;
+    let mut rels = Relations::from_str(&r.text).unwrap();
+    if exact {
+        rels.ensure_exact_version(&r.name, &v);
+    } else {
+        rels.ensure_minimum_version(&r.name, &v);
+    }
+    let out = rels.to_string();
+    let d = dpkg(&out).unwrap();
+    let s = &d.entries[0][0];
+    assert_eq!(s.archqual, r.archqual, "qualifier after ensure on {:?}: {out:?}", r.text);
+    assert_eq!(s.arches, r.arches, "architectures after ensure on {:?}: {out:?}", r.text);
+    assert_eq!(s.restrictions, r.profiles, "profiles after ensure on {:?}: {out:?}", r.text);
+}
+
+/// `wrap_and_sort` keeps the relations (as a multiset), leaves them sorted and dpkg reads
+/// the result as it read the input (modulo order).
+#[hegel::test]
+fn wrap_and_sort_keeps_the_relations(tc: hegel::TestCase) {
+    let g = tc.draw(arb_relations(false).print_as_debug());
+    if hits_negated_arch_bug(&g) || hits_rparen_bug(&g) || g.any(|r| r.archqual.is_some()) {
+        return;
+    }
+    let rels = Relations::from_str(&g.text).unwrap();
+    let before: Vec<Vec<Simple>> = structure(&rels).into_iter().filter(|e| !e.is_empty()).collect();
+    let sorted = rels.wrap_and_sort();
+    let out = sorted.to_string();
+    let d = dpkg(&out).unwrap_or_else(|| panic!("dpkg does not parse the sorted {out:?}"));
+    let mut a: Vec<Vec<Simple>> = d.entries.into_iter().map(|mut e| { e.sort_by_key(|s| format!("{s:?}")); e }).collect();
+    let mut b: Vec<Vec<Simple>> = before.into_iter().map(|mut e| { e.sort_by_key(|s| format!("{s:?}")); e }).collect();
+    a.sort_by_key(|e| format!("{e:?}"));
+    b.sort_by_key(|e| format!("{e:?}"));
+    assert_eq!(a, b, "wrap_and_sort changed the relations of {:?}: {out:?}", g.text);
+    assert!(sorted.is_sorted(&DefaultSortingOrder), "not sorted: {out:?}");
+    assert_eq!(out, canonical(&sorted), "wrap_and_sort output is not canonical");
+    assert_eq!(sorted.wrap_and_sort().to_string(), out, "wrap_and_sort is not idempotent");
+}
+
+/// `Ord` for `Relation` and `Entry` is a total order consistent with `Eq` (bug debian-control/10:
+/// `cmp` ignores the qualifiers `eq` compares).
+#[hegel::test]
+fn relation_ordering_is_consistent_with_equality(tc: hegel::TestCase) {
+    let make = || { let mut r = tc.draw(arb_relation(false).print_as_debug()); r.text = r.dpkg_shape(); r };
+    let (ga, gb, gc) = (make(), make(), make());
+    if hits_ord_bug(&ga, &gb) || hits_ord_bug(&gb, &gc) || hits_ord_bug(&ga, &gc) {
+        return;
+    }
+    let (ta, tb, tcx) = (ga.text, gb.text, gc.text);
+    let (a, b, c) = (Relation::from_str(&ta).unwrap(), Relation::from_str(&tb).unwrap(), Relation::from_str(&tcx).unwrap());
+    assert_eq!(a.cmp(&a), std::cmp::Ordering::Equal);
+    assert_eq!(a.cmp(&b), b.cmp(&a).reverse(), "{a} vs {b}");
+    if a <= b && b <= c {
+        assert!(a <= c, "transitivity: {a} {b} {c}");
+    }
+    assert_eq!(a.cmp(&b) == std::cmp::Ordering::Equal, a == b, "cmp/eq disagree on {a} vs {b}");
+    let ea = Entry::from_str(&format!("{ta} | {tb}")).unwrap();
+    let eb = Entry::from_str(&format!("{tb} | {ta}")).unwrap();
+    assert_eq!(ea.cmp(&eb) == std::cmp::Ordering::Equal, ea == eb, "entries {ea} vs {eb}");
+}
+
+/// Substvars are preserved, listed, ensured once and dropped cleanly.
+#[hegel::test]
+fn substvars_round_trip(tc: hegel::TestCase) {
+    let g = tc.draw(arb_relations(false).print_as_debug());
+    if hits_negated_arch_bug(&g) || hits_rparen_bug(&g) {
+        return;
+    }
+    let var = pick(&tc, &["${misc:Depends}", "${shlibs:Depends}", "${python3:Depends}", "${perl:Depends}"]);
+    let mut rels = Relations::from_str(&g.text).unwrap();
+    assert!(Relations::from_str(&format!("{}, {var}", g.text)).is_err(), "the strict parser accepted a substvar");
+    let n = rels.len();
+    rels.ensure_substvar(var).unwrap();
+    assert_eq!(rels.substvars().collect::<Vec<_>>(), vec![var.to_string()]);
+    let text = rels.to_string();
+    let (again, errors) = Relations::parse_relaxed(&text, true);
+    assert!(errors.is_empty(), "{text:?}: {errors:?}");
+    assert_eq!(again.substvars().collect::<Vec<_>>(), vec![var.to_string()]);
+    assert_eq!(again.len(), n);
+    rels.ensure_substvar(var).unwrap();
+    assert_eq!(rels.to_string(), text, "ensure_substvar is not idempotent");
+    rels.drop_substvar(var);
+    assert_eq!(rels.substvars().count(), 0);
+    assert_eq!(structure(&rels).into_iter().filter(|e| !e.is_empty()).collect::<Vec<_>>(), structure(&Relations::from_str(&g.text).unwrap()).into_iter().filter(|e| !e.is_empty()).collect::<Vec<_>>());
+    if n > 0 {
+        assert!(dpkg(&rels.to_string()).is_some(), "after drop_substvar dpkg does not parse {:?}", rels.to_string());
+    }
+}
+
+/// `Relation::build` / `Relation::new` / the lossy `Relation` builder print what dpkg reads.
+#[hegel::test]
+fn built_relations_are_read_back_by_dpkg(tc: hegel::TestCase) {
+    let mut r = tc.draw(arb_relation(false).print_as_debug());
+    if r.multi_profile_group() || r.profile_groups() > 1 {
+        // Bugs debian-control/2 and /8 cover these shapes.
+        r.profiles = r.profiles.map(|g| vec![vec![g[0][0].clone()]]);
+    }
+    r.text = r.dpkg_shape();
+    let built = gen_to_relation(&r);
+    assert_eq!(built.to_string(), r.text, "lossless builder");
+    let d = dpkg(&built.to_string()).unwrap_or_else(|| panic!("dpkg does not parse the built {:?}", built.to_string()));
+    assert_eq!(d.entries, vec![vec![simple_of(&built)]]);
+    let mut lb = LossyRelation::build(&r.name);
+    if let Some((op, v)) = &r.version {
+        lb = lb.version(vc(op), v);
+    }
+    if let Some(q) = &r.archqual {
+        lb = lb.archqual(q);
+    }
+    if let Some(a) = &r.arches {
+        lb = lb.architectures(a.iter().map(|s| s.as_str()).collect());
+    }
+    if let Some(groups) = &r.profiles {
+        for g in groups {
+            lb = lb.profile(g.iter().map(|p| p.parse().unwrap()).collect());
+        }
+    }
+    let lossy = lb.build();
+    assert_eq!(lossy.to_string(), r.text, "lossy builder");
+    let converted: Relation = lossy.clone().into();
+    assert_eq!(converted.to_string(), r.text, "lossy -> lossless");
+    let back: LossyRelation = built.into();
+    assert_eq!(back, lossy, "lossless -> lossy");
+}
