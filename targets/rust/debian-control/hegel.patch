+// --------------------------------------------------------------------------- parsing
+
+/// Everything dpkg parses, the strict lossless parser parses with the same fields, and the
+/// canonical rendering of each relation is dpkg's.
+#[hegel::test]
+fn relations_parse_like_dpkg(tc: hegel::TestCase) {
+    let g = tc.draw(arb_relations(false).print_as_debug());
+    let Some(d) = dpkg(&g.text) else {
+        panic!("dpkg does not parse the generated text {:?}", g.text);
+    };
+    assert_eq!(d.entries, gen_structure(&g), "the generator's own view of {:?}", g.text);
+    if hits_rparen_bug(&g) {
+        return;
+    }
+    let rels = Relations::from_str(&g.text).unwrap_or_else(|e| panic!("strict parse of {:?} failed: {e}", g.text));
+    if hits_negated_arch_bug(&g) {
+        return;
+    }
+    assert_eq!(structure(&rels), d.entries, "fields of {:?}", g.text);
+    assert_eq!(canonical(&rels), d.output, "canonical rendering of {:?}", g.text);
+    assert_eq!(rels.len(), d.entries.len());
+    for (e, de) in rels.entries().zip(&d.entries) {
+        assert_eq!(e.len(), de.len());
+        assert!(!e.is_empty());
+    }
+}
+
+/// The lossy parser agrees with dpkg and prints dpkg's canonical form.
+#[hegel::test]
+fn lossy_relations_parse_like_dpkg(tc: hegel::TestCase) {
+    let g = tc.draw(arb_relations(false).print_as_debug());
+    let d = dpkg(&g.text).unwrap();
+    if hits_negated_arch_bug(&g) || hits_lossy_profile_bug(&g) || hits_lossy_newline_bug(&g) || hits_rparen_bug(&g) {
+        return;
+    }
+    let rels = LossyRelations::from_str(&g.text).unwrap_or_else(|e| panic!("lossy parse of {:?} failed: {e}", g.text));
+    assert_eq!(lossy_structure(&rels), d.entries, "lossy fields of {:?}", g.text);
+    assert_eq!(rels.to_string(), d.output, "lossy rendering of {:?}", g.text);
+    let again = LossyRelations::from_str(&rels.to_string()).unwrap();
+    assert_eq!(again, rels, "lossy Display round trip of {:?}", g.text);
+    let d2 = dpkg(&rels.to_string()).unwrap();
+    assert_eq!(d2.entries, d.entries, "dpkg reads the lossy rendering of {:?} differently", g.text);
+}
