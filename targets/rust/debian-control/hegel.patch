+#[hegel::test]
+fn lossy_control_files_are_read_like_the_model(tc: hegel::TestCase) {
+    // No verbatim description lines: the lossy layer's indentation is pinned.
+    let g = tc.draw(arb_control(false).print_as_debug());
+    let text = g.text();
+    let l = debian_control::lossy::Control::from_str(&text).expect("lossy parse");
+    let gs = &g.source;
+    assert_eq!(l.source.name, gs.name);
+    assert_eq!(l.source.maintainer, Some(gs.maintainer.clone()));
+    assert_eq!(l.source.uploaders, if gs.uploaders.is_empty() { None } else { Some(gs.uploaders.join(", ")) });
+    assert_eq!(l.source.section, gs.section);
+    assert_eq!(l.source.priority, gs.priority);
+    assert_eq!(l.source.standards_version, gs.standards_version);
+    assert_eq!(l.source.build_depends.as_ref().map(|r| r.to_string()), gs.build_depends.as_ref().map(|r| Relations::from_str(r).unwrap().to_string()), "build_depends");
+    assert_eq!(l.source.homepage, gs.homepage.as_ref().map(|u| url::Url::parse(u).unwrap()));
+    assert_eq!(l.source.vcs_browser, gs.vcs_browser.as_ref().map(|u| url::Url::parse(u).unwrap()));
+    assert_eq!(l.source.vcs_git.as_ref().map(|v| v.to_string()), gs.vcs_git.as_ref().map(|v| GenVcs { path_first: false, ..v.clone() }.text()), "vcs_git");
+    assert_eq!(l.source.rules_requires_root, gs.rules_requires_root);
+    assert_eq!(l.source.testsuite, gs.testsuite);
+    assert_eq!(l.binaries.len(), g.binaries.len());
+    for (b, gb) in l.binaries.iter().zip(g.binaries.iter()) {
+        assert_eq!(b.name, gb.name);
+        assert_eq!(b.architecture, Some(gb.architecture.clone()));
+        assert_eq!(b.section, gb.section);
+        assert_eq!(b.priority, gb.priority);
+        assert_eq!(b.multi_arch, gb.multi_arch);
+        assert_eq!(b.essential, if gb.essential { Some(true) } else { None });
+        assert_eq!(b.depends.as_ref().map(|r| r.to_string()), gb.depends.as_ref().map(|r| Relations::from_str(r).unwrap().to_string()), "depends");
+        assert_eq!(b.description, Some(gb.description.value()), "description");
+    }
+    // Display round trip.
+    let shown = l.to_string();
+    let again = debian_control::lossy::Control::from_str(&shown).expect("lossy re-parse of Display");
+    assert!(again == l, "lossy Display round trip: {shown:?}");
+    // dpkg reads the rendering too (every binary has Package and Architecture).
+    dpkg_control(&shown).expect("dpkg reads the lossy rendering");
+    // The lossless layer agrees on the typed fields.
+    let c = Control::from_str(&text).unwrap();
+    let s = c.source().unwrap();
+    assert_eq!(s.priority(), l.source.priority);
+    assert_eq!(s.section(), l.source.section);
+    assert_eq!(s.homepage(), l.source.homepage);
+    for (b, lb) in c.binaries().zip(l.binaries.iter()) {
+        assert_eq!(b.description(), lb.description, "layers: description");
+        assert_eq!(b.multi_arch(), lb.multi_arch);
+        assert_eq!(b.priority(), lb.priority);
+    }
+}
