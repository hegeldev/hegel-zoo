+/// `Relation::build` / `Relation::new` / the lossy `Relation` builder print what dpkg reads.
+#[hegel::test]
+fn built_relations_are_read_back_by_dpkg(tc: hegel::TestCase) {
+    let mut r = tc.draw(arb_relation(false).print_as_debug());
+    if r.multi_profile_group() || r.profile_groups() > 1 {
+        // Bugs debian-control/2 and /8 cover these shapes.
+        r.profiles = r.profiles.map(|g| vec![vec![g[0][0].clone()]]);
+    }
+    r.text = r.dpkg_shape();
+    let built = gen_to_relation(&r);
+    assert_eq!(built.to_string(), r.text, "lossless builder");
+    let d = dpkg(&built.to_string()).unwrap_or_else(|| panic!("dpkg does not parse the built {:?}", built.to_string()));
+    assert_eq!(d.entries, vec![vec![simple_of(&built)]]);
+    let mut lb = LossyRelation::build(&r.name);
+    if let Some((op, v)) = &r.version {
+        lb = lb.version(vc(op), v);
+    }
+    if let Some(q) = &r.archqual {
+        lb = lb.archqual(q);
+    }
+    if let Some(a) = &r.arches {
+        lb = lb.architectures(a.iter().map(|s| s.as_str()).collect());
+    }
+    if let Some(groups) = &r.profiles {
+        for g in groups {
+            lb = lb.profile(g.iter().map(|p| p.parse().unwrap()).collect());
+        }
+    }
+    let lossy = lb.build();
+    assert_eq!(lossy.to_string(), r.text, "lossy builder");
+    let converted: Relation = lossy.clone().into();
+    assert_eq!(converted.to_string(), r.text, "lossy -> lossless");
+    let back: LossyRelation = built.into();
+    assert_eq!(back, lossy, "lossless -> lossy");
+}
