+/// `wrap_and_sort` keeps the relations (as a multiset), leaves them sorted and dpkg reads
+/// the result as it read the input (modulo order).
+#[hegel::test]
+fn wrap_and_sort_keeps_the_relations(tc: hegel::TestCase) {
+    let g = tc.draw(arb_relations(false).print_as_debug());
+    if hits_negated_arch_bug(&g) || hits_rparen_bug(&g) || g.any(|r| r.archqual.is_some()) {
+        return;
+    }
+    let rels = Relations::from_str(&g.text).unwrap();
+    let before: Vec<Vec<Simple>> = structure(&rels).into_iter().filter(|e| !e.is_empty()).collect();
+    let sorted = rels.wrap_and_sort();
+    let out = sorted.to_string();
+    let d = dpkg(&out).unwrap_or_else(|| panic!("dpkg does not parse the sorted {out:?}"));
+    let mut a: Vec<Vec<Simple>> = d.entries.into_iter().map(|mut e| { e.sort_by_key(|s| format!("{s:?}")); e }).collect();
+    let mut b: Vec<Vec<Simple>> = before.into_iter().map(|mut e| { e.sort_by_key(|s| format!("{s:?}")); e }).collect();
+    a.sort_by_key(|e| format!("{e:?}"));
+    b.sort_by_key(|e| format!("{e:?}"));
+    assert_eq!(a, b, "wrap_and_sort changed the relations of {:?}: {out:?}", g.text);
+    assert!(sorted.is_sorted(&DefaultSortingOrder), "not sorted: {out:?}");
+    assert_eq!(out, canonical(&sorted), "wrap_and_sort output is not canonical");
+    assert_eq!(sorted.wrap_and_sort().to_string(), out, "wrap_and_sort is not idempotent");
+}
