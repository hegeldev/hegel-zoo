+#[hegel::test]
+fn typed_fields_round_trip(tc: hegel::TestCase) {
+    let p = arb_priority(&tc);
+    assert_eq!(Priority::from_str(&p.to_string()), Ok(p.clone()));
+    let m = arb_multi_arch(&tc);
+    assert_eq!(MultiArch::from_str(&m.to_string()), Ok(m));
+    let u = pick(&tc, &[Urgency::Low, Urgency::Medium, Urgency::High, Urgency::Emergency, Urgency::Critical]);
+    assert_eq!(Urgency::from_str(&u.to_string()), Ok(u));
+    // Standards-Version: the value survives Display; Ord is the tuple order.
+    let a = (tc.draw(int!(0, 9)) as u8, tc.draw(int!(0, 9)) as u8, tc.draw(int!(0, 9)) as u8, tc.draw(int!(0, 3)) as u8);
+    let b = (tc.draw(int!(0, 9)) as u8, tc.draw(int!(0, 9)) as u8, tc.draw(int!(0, 9)) as u8, tc.draw(int!(0, 3)) as u8);
+    let sa = StandardsVersion::new(a.0, a.1, a.2, a.3);
+    let sb = StandardsVersion::new(b.0, b.1, b.2, b.3);
+    assert_eq!(sa.as_tuple(), a);
+    assert_eq!(StandardsVersion::from_str(&sa.to_string()), Ok(sa));
+    assert_eq!(sa.cmp(&sb), a.cmp(&b));
+    let s = arb_standards_version(&tc);
+    let parsed = StandardsVersion::from_str(&s).unwrap();
+    let comps: Vec<u8> = s.split('.').map(|c| c.parse().unwrap()).collect();
+    assert_eq!(parsed.major(), comps[0]);
+    assert_eq!(parsed.minor(), comps[1]);
+    assert_eq!(parsed.patch(), comps[2]);
+    assert_eq!(parsed.micro(), comps.get(3).copied().unwrap_or(0));
+    // Package-List entries: parse(display) is the same entry (extras as a map).
+    let n = tc.draw(int!(0, 3)) as usize;
+    let keys = ["arch", "profile", "essential", "protected"];
+    let mut e = PackageListEntry::new(&pick(&tc, NAMES), &pick(&tc, &["deb", "udeb"]), &pick(&tc, SECTIONS), arb_priority(&tc));
+    for k in keys.iter().take(n) {
+        e.extra.insert(k.to_string(), pick(&tc, &["amd64,i386", "yes", "!nocheck", "linux-any"]).to_string());
+    }
+    let again = PackageListEntry::from_str(&e.to_string()).unwrap();
+    assert_eq!(again, e, "PackageListEntry round trip: {:?}", e.to_string());
+    // format_description encodes blank lines as ` .` and indents every line.
+    let d = arb_description(&tc, true);
+    let formatted = format_description(&d.synopsis, &d.long.join("\n"));
+    let mut lines = formatted.split('\n');
+    assert_eq!(lines.next(), Some(d.synopsis.as_str()));
+    for (l, g) in lines.zip(d.long.iter()) {
+        if g.is_empty() {
+            assert_eq!(l, " .");
+        } else {
+            assert_eq!(l, format!(" {g}"));
+        }
+    }
+}
