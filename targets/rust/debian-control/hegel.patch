+#[derive(Debug, Clone, Copy)]
+enum Mutation {
+    None,
+    Crlf,
+    NoTrailingNewline,
+    ExtraArmorHeader,
+}
+
+#[hegel::test]
+fn clearsigned_files_are_split_like_python_debian_and_dpkg(tc: hegel::TestCase) {
+    let pool = signed_pool();
+    let (payload, signed) = pool[tc.draw(int!(0, pool.len() as i64 - 1)) as usize].clone();
+    let mutation = pick(&tc, &[Mutation::None, Mutation::Crlf, Mutation::NoTrailingNewline, Mutation::ExtraArmorHeader]);
+    let text = match mutation {
+        Mutation::None => signed.clone(),
+        Mutation::Crlf => signed.replace('\n', "\r\n"),
+        Mutation::NoTrailingNewline => signed.trim_end_matches('\n').to_string(),
+        Mutation::ExtraArmorHeader => signed.replacen("\nHash: ", "\nCharset: UTF-8\nHash: ", 1),
+    };
+    // gpg dash-escapes nothing here (no payload line starts with `-` or `From `);
+    // every reference leaves the payload lines as they are.
+    let (got_payload, got_sig) = strip_pgp_signature(&text).unwrap_or_else(|e| panic!("strip_pgp_signature on {mutation:?}: {e}"));
+    let py = python_split_gpg(&text);
+    assert!(py["err"].is_null(), "python-debian: {}", py["err"]);
+    let py_payload: Vec<String> = py["payload"].as_array().unwrap().iter().map(|l| l.as_str().unwrap().trim_end_matches('\r').to_string()).collect();
+    let got_lines: Vec<String> = got_payload.lines().map(|l| l.to_string()).collect();
+    assert_eq!(got_lines, py_payload, "payload lines vs python-debian");
+    assert_eq!(got_payload, payload, "payload is the signed text");
+    let sig = got_sig.expect("a signature");
+    // The signature is the armored block's lines glued together (no blank, no armor lines).
+    let py_post = py["post"].as_array().unwrap();
+    let expected_sig: String = py_post[1..py_post.len() - 1].iter().map(|l| l.as_str().unwrap().trim_end_matches('\r')).collect();
+    assert_eq!(sig, expected_sig, "signature block");
+    // dpkg reads the payload's fields through the signature.
+    let (fields, is_signed) = dpkg_read("changes", &text).unwrap_or_else(|e| panic!("dpkg: {e}"));
+    assert!(is_signed);
+    let (plain, _) = dpkg_read("changes", &payload).unwrap();
+    assert_eq!(fields, plain, "dpkg reads the same fields signed and unsigned");
+    // Unsigned text passes through untouched.
+    assert_eq!(strip_pgp_signature(&payload), Ok((payload.clone(), None)));
+}
