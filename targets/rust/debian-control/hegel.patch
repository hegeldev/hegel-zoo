+/// Any text prints back verbatim from the relaxed parse; when the relaxed parse reports no
+/// errors the accessors work, and the strict parse agrees with the relaxed one on errors.
+#[hegel::test]
+fn the_tree_is_lossless_for_any_text(tc: hegel::TestCase) {
+    let text = tc.draw(arb_text());
+    let (rels, errors) = Relations::parse_relaxed(&text, true);
+    assert_eq!(rels.to_string(), text, "relaxed parse is not lossless");
+    let (rels2, errors2) = Relations::parse_relaxed(&text, false);
+    assert_eq!(rels2.to_string(), text);
+    let strict = Relations::from_str(&text);
+    assert_eq!(strict.is_ok(), errors2.is_empty(), "strict/relaxed disagree on {text:?}: {errors2:?}");
+    if let Ok(s) = &strict {
+        assert_eq!(s.to_string(), text);
+    }
+    if errors.is_empty() {
+        for e in rels.entries() {
+            for r in e.relations() {
+                let _ = r.try_name();
+                let _ = r.archqual();
+                let _ = r.architectures().map(|a| a.count());
+                let _ = r.profiles().count();
+                if hits_version_panic_bug(&r) {
+                    continue;
+                }
+                let _ = r.version();
+                let _ = r.wrap_and_sort();
+            }
+            let _ = e.len();
+        }
+        let _ = rels.substvars().count();
+        let _ = rels.is_sorted(&DefaultSortingOrder);
+        let _ = rels.is_sorted(&WrapAndSortOrder);
+    }
+}
