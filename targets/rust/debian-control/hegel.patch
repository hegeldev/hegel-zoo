+//! Hegel properties for `debian-control`'s relationship-field parsers (`Depends:` and friends).
+//!
+//! Oracles: dpkg's own `Dpkg::Deps` (Perl, driven as a persistent child: `deps_parse`, the
+//! canonical `output`, `implies` and `get_evaluation` against `Dpkg::Deps::KnownFacts`) and
+//! python-debian's `PkgRelation` (the regexes dak and most Debian tooling use). Alongside:
+//! the lossless round trip of the CST, the lossy parser against the lossless one, every setter
+//! read back through a re-parse, through the accessors on the edited tree and by dpkg, the
+//! `ensure_*` helpers, `wrap_and_sort`, `Ord`/`Eq` consistency and substvars.
+#![allow(clippy::all, dead_code)]
+
+use debian_control::lossless::relations::{Entry, Relation, Relations, DefaultSortingOrder, WrapAndSortOrder};
+use debian_control::lossy::{Relation as LossyRelation, Relations as LossyRelations};
+use debian_control::relations::{BuildProfile, SyntaxKind, VersionConstraint};
+use debversion::Version;
+use hegel::generators;
+use hegel::generators::Generator;
+use serde_json::Value;
+use std::collections::{BTreeMap, BTreeSet};
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::str::FromStr;
+use std::sync::{Mutex, OnceLock};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+// --------------------------------------------------------------------------- oracles
+
+const PERL_SCRIPT: &str = r#"
+use strict; use warnings;
+use Dpkg::Deps; use Dpkg::Deps::KnownFacts; use Dpkg::Arch qw(get_host_arch);
+use JSON::PP;
+$| = 1;
+my $json = JSON::PP->new->canonical;
+sub hx { return pack('H*', shift) }
+sub fields {
+    my $d = shift;
+    return { package => $d->{package}, archqual => $d->{archqual}, relation => $d->{relation},
+             version => (defined $d->{version} ? "$d->{version}" : undef),
+             arches => $d->{arches}, restrictions => $d->{restrictions} };
+}
+sub structure {
+    my $d = shift;
+    my @entries;
+    for my $e ($d->get_deps()) {
+        if ($e->isa('Dpkg::Deps::Simple')) { push @entries, [fields($e)]; }
+        else { push @entries, [ map { fields($_) } $e->get_deps() ]; }
+    }
+    return \@entries;
+}
+sub parse1 {
+    my $text = shift;
+    my $d;
+    my $ok = eval { $d = deps_parse($text, build_dep => 1); 1 };
+    return undef unless $ok && defined $d;
+    return $d;
+}
+sub single { my $d = shift; my @m = $d->get_deps(); return @m == 1 ? $m[0] : $d; }
+while (my $line = <STDIN>) {
+    chomp $line;
+    my ($cmd, @args) = split / /, $line;
+    my $reply;
+    if ($cmd eq 'P') {
+        my $d = parse1(hx($args[0]));
+        $reply = defined $d ? { ok => JSON::PP::true, output => $d->output, entries => structure($d) }
+                            : { ok => JSON::PP::false };
+    } elsif ($cmd eq 'I') {
+        my $a = parse1(hx($args[0])); my $b = parse1(hx($args[1]));
+        if (!defined $a || !defined $b) { $reply = { ok => JSON::PP::false }; }
+        else {
+            my $r = single($a)->implies(single($b));
+            $reply = { ok => JSON::PP::true, implies => (defined $r ? ($r ? 'y' : 'n') : 'u') };
+        }
+    } elsif ($cmd eq 'E') {
+        my $d = parse1(hx($args[0]));
+        my $facts = Dpkg::Deps::KnownFacts->new();
+        my $arch = get_host_arch();
+        for my $f (split /;/, hx($args[1] // '')) {
+            next unless length $f;
+            my ($p, $v) = split /=/, $f, 2;
+            $facts->add_installed_package($p, $v, $arch, 'allowed');
+        }
+        if (!defined $d) { $reply = { ok => JSON::PP::false }; }
+        else {
+            my $r = $d->get_evaluation($facts);
+            $reply = { ok => JSON::PP::true, satisfied => (defined $r ? ($r ? 'y' : 'n') : 'u') };
+        }
+    } else { $reply = { error => "unknown $cmd" }; }
+    print $json->encode($reply), "\n";
+}
+"#;
+
+const PYTHON_SCRIPT: &str = r#"
+import sys, json
+try:
+    from debian.deb822 import PkgRelation
+    have = True
+except Exception:
+    have = False
+def hx(s):
+    return bytes.fromhex(s).decode('utf-8')
+for line in sys.stdin:
+    cmd, *args = line.rstrip('\n').split(' ')
+    if not have:
+        print(json.dumps({'na': True}), flush=True)
+        continue
+    if cmd == 'R':
+        rels = PkgRelation.parse_relations(hx(args[0]))
+        out = []
+        for e in rels:
+            ents = []
+            for r in e:
+                ents.append({
+                    'name': r['name'], 'archqual': r['archqual'],
+                    'version': list(r['version']) if r['version'] else None,
+                    'arch': [[a.enabled, a.arch] for a in r['arch']] if r['arch'] is not None else None,
+                    'restrictions': [[[t.enabled, t.profile] for t in g] for g in r['restrictions']] if r['restrictions'] is not None else None,
+                })
+            out.append(ents)
+        print(json.dumps({'entries': out, 'str': PkgRelation.str(rels)}), flush=True)
+    else:
+        print(json.dumps({'error': cmd}), flush=True)
+"#;
+
+struct Child2 {
+    child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+static PERL: OnceLock<Mutex<Child2>> = OnceLock::new();
+static PYTHON: OnceLock<Mutex<Child2>> = OnceLock::new();
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|b| format!("{b:02x}")).collect()
+}
+
+fn spawn(program: &str, args: &[&str]) -> Mutex<Child2> {
+    let mut child = Command::new(program)
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap_or_else(|e| panic!("{program} is needed for the oracle: {e}"));
+    let stdin = child.stdin.take().unwrap();
+    let stdout = BufReader::new(child.stdout.take().unwrap());
+    Mutex::new(Child2 { child, stdin, stdout })
+}
+
+fn ask(which: &'static Mutex<Child2>, cmd: &str, args: &[&str]) -> Value {
+    let mut o = which.lock().unwrap();
+    let mut line = cmd.to_string();
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a));
+    }
+    line.push('\n');
+    o.stdin.write_all(line.as_bytes()).expect("oracle stdin");
+    let mut reply = String::new();
+    let n = o.stdout.read_line(&mut reply).expect("oracle stdout");
+    if n == 0 {
+        let status = o.child.try_wait().ok().flatten();
+        panic!("the oracle exited ({status:?}) on {line:?}");
+    }
+    serde_json::from_str(reply.trim_end_matches(['\n', '\r'])).unwrap_or_else(|e| panic!("bad oracle reply {reply:?}: {e}"))
+}
+
+fn perl() -> &'static Mutex<Child2> {
+    PERL.get_or_init(|| spawn("perl", &["-e", PERL_SCRIPT]))
+}
+
+fn python() -> &'static Mutex<Child2> {
+    PYTHON.get_or_init(|| {
+        let python = if std::path::Path::new("/usr/bin/python3").exists() { "/usr/bin/python3" } else { "python3" };
+        spawn(python, &["-u", "-c", PYTHON_SCRIPT])
+    })
+}
+
+/// One simple dependency as dpkg reads it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Simple {
+    package: String,
+    archqual: Option<String>,
+    version: Option<(String, String)>,
+    arches: Option<Vec<String>>,
+    restrictions: Option<Vec<Vec<String>>>,
+}
+
+#[derive(Debug, Clone)]
+struct Dpkg {
+    output: String,
+    entries: Vec<Vec<Simple>>,
+}
+
+fn jstr(v: &Value) -> Option<String> {
+    v.as_str().map(|s| s.to_string())
+}
+
+/// `Dpkg::Deps::deps_parse($text, build_dep => 1)`; `None` when dpkg cannot parse the text.
+fn dpkg(text: &str) -> Option<Dpkg> {
+    let v = ask(perl(), "P", &[text]);
+    if v["ok"] != Value::Bool(true) {
+        return None;
+    }
+    let entries = v["entries"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|e| {
+            e.as_array()
+                .unwrap()
+                .iter()
+                .map(|s| Simple {
+                    package: jstr(&s["package"]).unwrap(),
+                    archqual: jstr(&s["archqual"]),
+                    version: match (jstr(&s["relation"]), jstr(&s["version"])) {
+                        (Some(r), Some(ver)) => Some((r, ver)),
+                        _ => None,
+                    },
+                    arches: s["arches"].as_array().map(|a| a.iter().map(|x| jstr(x).unwrap()).collect()),
+                    restrictions: s["restrictions"]
+                        .as_array()
+                        .map(|g| g.iter().map(|l| l.as_array().unwrap().iter().map(|x| jstr(x).unwrap()).collect()).collect()),
+                })
+                .collect()
+        })
+        .collect();
+    Some(Dpkg { output: jstr(&v["output"]).unwrap(), entries })
+}
+
+/// `$outer->implies($inner)` in dpkg: `Some(true)`, `Some(false)` or `None` (undecidable).
+fn dpkg_implies(outer: &str, inner: &str) -> Option<Option<bool>> {
+    let v = ask(perl(), "I", &[outer, inner]);
+    if v["ok"] != Value::Bool(true) {
+        return None;
+    }
+    Some(match v["implies"].as_str().unwrap() {
+        "y" => Some(true),
+        "n" => Some(false),
+        _ => None,
+    })
+}
+
+/// `$deps->get_evaluation($facts)` with the given installed packages (host arch, Multi-Arch: allowed).
+fn dpkg_satisfied(text: &str, facts: &BTreeMap<String, String>) -> Option<Option<bool>> {
+    let f: Vec<String> = facts.iter().map(|(k, v)| format!("{k}={v}")).collect();
+    let v = ask(perl(), "E", &[text, &f.join(";")]);
+    if v["ok"] != Value::Bool(true) {
+        return None;
+    }
+    Some(match v["satisfied"].as_str().unwrap() {
+        "y" => Some(true),
+        "n" => Some(false),
+        _ => None,
+    })
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct PyRel {
+    name: String,
+    archqual: Option<String>,
+    version: Option<(String, String)>,
+    arch: Option<Vec<(bool, String)>>,
+    restrictions: Option<Vec<Vec<(bool, String)>>>,
+}
+
+/// python-debian's `PkgRelation.parse_relations` and `PkgRelation.str`; `None` without python-debian.
+fn pydebian(text: &str) -> Option<(Vec<Vec<PyRel>>, String)> {
+    let v = ask(python(), "R", &[text]);
+    if v.get("na").is_some() {
+        return None;
+    }
+    let entries = v["entries"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|e| {
+            e.as_array()
+                .unwrap()
+                .iter()
+                .map(|r| PyRel {
+                    name: jstr(&r["name"]).unwrap(),
+                    archqual: jstr(&r["archqual"]),
+                    version: r["version"].as_array().map(|a| (jstr(&a[0]).unwrap(), jstr(&a[1]).unwrap())),
+                    arch: r["arch"].as_array().map(|a| a.iter().map(|x| (x[0].as_bool().unwrap(), jstr(&x[1]).unwrap())).collect()),
+                    restrictions: r["restrictions"].as_array().map(|g| {
+                        g.iter()
+                            .map(|l| l.as_array().unwrap().iter().map(|x| (x[0].as_bool().unwrap(), jstr(&x[1]).unwrap())).collect())
+                            .collect()
+                    }),
+                })
+                .collect()
+        })
+        .collect();
+    Some((entries, jstr(&v["str"]).unwrap()))
+}
+
+// --------------------------------------------------------------------------- generators
+
+fn pick<'a, T: Clone + Send + Sync + std::fmt::Debug + 'static>(tc: &hegel::TestCase, items: &[T]) -> T {
+    tc.draw(generators::sampled_from(items.to_vec()).print_as_debug())
+}
+
+fn chars_from(tc: &hegel::TestCase, alphabet: &str, n: usize) -> String {
+    let chars: Vec<char> = alphabet.chars().collect();
+    (0..n).map(|_| pick(tc, &chars)).collect()
+}
+
+const NAMES: &[&str] = &[
+    "libc6", "python3", "debhelper", "debhelper-compat", "dh-python", "g++", "libstdc++6", "perl", "cdbs",
+    "python3-dulwich", "libgtk-3-0", "gcc-13-base", "zlib1g", "libssl3t64", "rustc", "cargo", "dpkg-dev",
+    "pkg-config", "samba", "libx11-6", "a", "b", "c", "0ad", "x.y", "foo+bar",
+];
+
+/// A package name: `[a-z0-9][a-z0-9+.-]*` (Policy), occasionally with upper case (dpkg accepts it).
+#[hegel::composite]
+fn arb_name(tc: &hegel::TestCase) -> String {
+    match tc.draw(int!(0u8, 5)) {
+        0..=2 => pick(tc, NAMES).to_string(),
+        3 => {
+            let first = chars_from(tc, "abcdefghijklmnopqrstuvwxyz0123456789", 1);
+            let rest = chars_from(tc, "abcdefghijklmnopqrstuvwxyz0123456789+.-", tc.draw(int!(1usize, 8)));
+            first + &rest
+        }
+        4 => chars_from(tc, "abcdefghijklmnopqrstuvwxyz0123456789", 1),
+        _ => {
+            let first = chars_from(tc, "ABCDEFabcdef0123456789", 1);
+            let rest = chars_from(tc, "abcdefXYZ0123456789+.-", tc.draw(int!(0usize, 6)));
+            first + &rest
+        }
+    }
+}
+
+/// A Debian version that `debversion` parses: `[epoch:]upstream[-revision]`.
+#[hegel::composite]
+fn arb_version(tc: &hegel::TestCase) -> String {
+    let mut s = String::new();
+    if tc.draw(int!(0u8, 4)) == 0 {
+        s.push_str(&tc.draw(int!(0u32, 99)).to_string());
+        s.push(':');
+    }
+    let has_revision = tc.draw(int!(0u8, 2)) != 0;
+    s.push_str(&tc.draw(int!(0u32, 999)).to_string());
+    let upstream_alpha = if has_revision { "0123456789abcdefghijklmnopqrstuvwxyz.+~-" } else { "0123456789abcdefghijklmnopqrstuvwxyz.+~" };
+    s.push_str(&chars_from(tc, upstream_alpha, tc.draw(int!(0usize, 8))));
+    if has_revision {
+        s.push('-');
+        s.push_str(&tc.draw(int!(0u32, 99)).to_string());
+        s.push_str(&chars_from(tc, "0123456789abcdefghijklmnopqrstuvwxyz.+~", tc.draw(int!(0usize, 4))));
+    }
+    s
+}
+
+const OPS: &[&str] = &["<<", "<=", "=", ">=", ">>"];
+const ARCHQUALS: &[&str] = &["any", "native", "amd64", "i386", "arm64", "all"];
+const ARCHES: &[&str] = &[
+    "amd64", "i386", "arm64", "armhf", "armel", "ppc64el", "s390x", "riscv64", "mips64el", "linux-any",
+    "any-amd64", "kfreebsd-amd64", "hurd-i386", "any-i386", "x32", "powerpc", "hppa", "sparc64",
+];
+const PROFILES: &[&str] = &["nocheck", "nodoc", "cross", "stage1", "stage2", "noinsttest", "noudeb", "pkg.foo.bar", "nobiarch", "nogolang"];
+
+/// Whitespace where dpkg allows `\s*` (it collapses newlines to a space before parsing).
+fn ws0(tc: &hegel::TestCase) -> &'static str {
+    pick(tc, &["", " ", " ", " ", "  ", "\t", "\n ", "\n\t"])
+}
+
+/// Whitespace where dpkg needs `\s+`.
+fn ws1(tc: &hegel::TestCase) -> &'static str {
+    pick(tc, &[" ", " ", " ", "  ", "\t", "\n "])
+}
+
+/// The generated shape of one simple dependency.
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct GenRelation {
+    text: String,
+    name: String,
+    archqual: Option<String>,
+    /// Operator as written (may be the deprecated `<` / `>`) and the version.
+    version: Option<(String, String)>,
+    arches: Option<Vec<String>>,
+    profiles: Option<Vec<Vec<String>>>,
+    /// Kinds of whitespace / shapes dpkg accepts that some parsers of the crate do not.
+    newline: bool,
+    deprecated_op: bool,
+    ws_before_rparen: bool,
+    ws_before_rangle: bool,
+    ws_after_langle: bool,
+}
+
+impl GenRelation {
+    fn normalized_op(&self) -> Option<String> {
+        self.version.as_ref().map(|(op, _)| match op.as_str() {
+            ">" => ">=".to_string(),
+            "<" => "<=".to_string(),
+            o => o.to_string(),
+        })
+    }
+
+    fn negated_arches(&self) -> bool {
+        self.arches.as_ref().is_some_and(|a| a.iter().any(|x| x.starts_with('!')))
+    }
+
+    fn multi_profile_group(&self) -> bool {
+        self.profiles.as_ref().is_some_and(|g| g.iter().any(|l| l.len() > 1))
+    }
+
+    fn profile_groups(&self) -> usize {
+        self.profiles.as_ref().map_or(0, |g| g.len())
+    }
+
+    /// The shape dpkg prints back (`output`) for this relation.
+    fn dpkg_shape(&self) -> String {
+        let mut s = self.name.clone();
+        if let Some(q) = &self.archqual {
+            s.push(':');
+            s.push_str(q);
+        }
+        if let Some((_, ver)) = &self.version {
+            s.push_str(&format!(" ({} {})", self.normalized_op().unwrap(), ver));
+        }
+        if let Some(a) = &self.arches {
+            s.push_str(&format!(" [{}]", a.join(" ")));
+        }
+        if let Some(groups) = &self.profiles {
+            for g in groups {
+                s.push_str(&format!(" <{}>", g.join(" ")));
+            }
+        }
+        s
+    }
+}
+
+#[hegel::composite]
+fn arb_relation(tc: &hegel::TestCase, allow_deprecated: bool) -> GenRelation {
+    let name = tc.draw(arb_name());
+    let archqual = if tc.draw(int!(0u8, 5)) == 0 { Some(pick(tc, ARCHQUALS).to_string()) } else { None };
+    let mut deprecated_op = false;
+    let version = if tc.draw(int!(0u8, 2)) != 0 {
+        let op = if allow_deprecated && tc.draw(int!(0u8, 9)) == 0 {
+            deprecated_op = true;
+            pick(tc, &["<", ">"])
+        } else {
+            pick(tc, OPS)
+        };
+        Some((op.to_string(), tc.draw(arb_version())))
+    } else {
+        None
+    };
+    let arches = if tc.draw(int!(0u8, 4)) == 0 {
+        let n = tc.draw(int!(1usize, 3));
+        let neg = tc.draw(int!(0u8, 2)) == 0;
+        let mut set = BTreeSet::new();
+        for _ in 0..n {
+            set.insert(pick(tc, ARCHES).to_string());
+        }
+        Some(set.into_iter().map(|a| if neg { format!("!{a}") } else { a }).collect::<Vec<_>>())
+    } else {
+        None
+    };
+    let profiles = if tc.draw(int!(0u8, 4)) == 0 {
+        let groups = tc.draw(int!(1usize, 2));
+        Some(
+            (0..groups)
+                .map(|_| {
+                    let n = tc.draw(int!(1usize, 3));
+                    let mut set = BTreeSet::new();
+                    for _ in 0..n {
+                        set.insert(pick(tc, PROFILES).to_string());
+                    }
+                    set.into_iter().map(|p| if tc.draw(int!(0u8, 1)) == 0 { format!("!{p}") } else { p }).collect::<Vec<_>>()
+                })
+                .collect::<Vec<_>>(),
+        )
+    } else {
+        None
+    };
+
+    let mut text = name.clone();
+    let mut ws_before_rparen = false;
+    let mut ws_before_rangle = false;
+    let mut ws_after_langle = false;
+    if let Some(q) = &archqual {
+        text.push(':');
+        text.push_str(q);
+    }
+    if let Some((op, ver)) = &version {
+        text.push_str(ws0(tc));
+        text.push('(');
+        text.push_str(ws0(tc));
+        text.push_str(op);
+        text.push_str(ws0(tc));
+        text.push_str(ver);
+        let w = ws0(tc);
+        ws_before_rparen |= !w.is_empty();
+        text.push_str(w);
+        text.push(')');
+    }
+    if let Some(a) = &arches {
+        text.push_str(ws0(tc));
+        text.push('[');
+        text.push_str(ws0(tc));
+        for (i, x) in a.iter().enumerate() {
+            if i > 0 {
+                text.push_str(ws1(tc));
+            }
+            text.push_str(x);
+        }
+        text.push_str(ws0(tc));
+        text.push(']');
+    }
+    if let Some(groups) = &profiles {
+        for g in groups {
+            text.push_str(if text.ends_with('>') { ws1(tc) } else { ws0(tc) });
+            text.push('<');
+            let w = ws0(tc);
+            ws_after_langle |= !w.is_empty();
+            text.push_str(w);
+            for (i, x) in g.iter().enumerate() {
+                if i > 0 {
+                    text.push_str(ws1(tc));
+                }
+                text.push_str(x);
+            }
+            let w = ws0(tc);
+            ws_before_rangle |= !w.is_empty();
+            text.push_str(w);
+            text.push('>');
+        }
+    }
+    let newline = text.contains('\n');
+    GenRelation { text, name, archqual, version, arches, profiles, newline, deprecated_op, ws_before_rparen, ws_before_rangle, ws_after_langle }
+}
+
+#[derive(Debug, Clone)]
+struct GenRelations {
+    text: String,
+    entries: Vec<Vec<GenRelation>>,
+}
+
+impl GenRelations {
+    fn relations(&self) -> impl Iterator<Item = &GenRelation> {
+        self.entries.iter().flatten()
+    }
+    fn any(&self, f: impl Fn(&GenRelation) -> bool) -> bool {
+        self.relations().any(f)
+    }
+    fn newline(&self) -> bool {
+        self.text.contains('\n')
+    }
+}
+
+/// A whole relationship field: 0–4 entries of 1–3 alternatives, dpkg's whitespace freedoms,
+/// optionally a trailing comma or an empty entry (`a,,b`, which dpkg skips).
+#[hegel::composite]
+fn arb_relations(tc: &hegel::TestCase, allow_deprecated: bool) -> GenRelations {
+    let n = tc.draw(int!(0usize, 4));
+    let mut entries = Vec::new();
+    let mut text = String::new();
+    if tc.draw(int!(0u8, 4)) == 0 {
+        text.push_str(ws1(tc));
+    }
+    for i in 0..n {
+        if i > 0 {
+            text.push_str(ws0(tc));
+            text.push(',');
+            if tc.draw(int!(0u8, 9)) == 0 {
+                text.push_str(ws0(tc));
+                text.push(',');
+            }
+            text.push_str(ws0(tc));
+        }
+        let m = tc.draw(int!(1usize, 3));
+        let mut alts = Vec::new();
+        for j in 0..m {
+            if j > 0 {
+                text.push_str(ws0(tc));
+                text.push('|');
+                text.push_str(ws0(tc));
+            }
+            let r = tc.draw(arb_relation(allow_deprecated).print_as_debug());
+            text.push_str(&r.text);
+            alts.push(r);
+        }
+        entries.push(alts);
+    }
+    if n > 0 && tc.draw(int!(0u8, 9)) == 0 {
+        text.push_str(ws0(tc));
+        text.push(',');
+    }
+    if tc.draw(int!(0u8, 4)) == 0 {
+        text.push_str(ws1(tc));
+    }
+    GenRelations { text, entries }
+}
+
+/// Arbitrary text for the lossless round trip: mutated relations or junk.
+#[hegel::composite]
+fn arb_text(tc: &hegel::TestCase) -> String {
+    let base = tc.draw(arb_relations(true).print_as_debug()).text;
+    match tc.draw(int!(0u8, 3)) {
+        0 => base,
+        1 => {
+            let mut chars: Vec<char> = base.chars().collect();
+            let n = tc.draw(int!(1usize, 3));
+            for _ in 0..n {
+                let c = pick(tc, &['(', ')', '[', ']', '<', '>', '=', '!', ',', '|', ':', '$', '{', '}', '#', ' ', '\n', 'a', '1', '~', '@', '\u{e9}']);
+                if chars.is_empty() || tc.draw(int!(0u8, 1)) == 0 {
+                    let at = tc.draw(int!(0usize, chars.len()));
+                    chars.insert(at, c);
+                } else {
+                    let at = tc.draw(int!(0usize, chars.len() - 1));
+                    chars[at] = c;
+                }
+            }
+            chars.into_iter().collect()
+        }
+        2 => chars_from(tc, "ab1 ,|()[]<>=!:${}#\n\t~.+-", tc.draw(int!(0usize, 20))),
+        _ => format!("{} ${{misc:Depends}}{}", base, pick(tc, &["", ", ${shlibs:Depends}", ",${python3:Depends}"])),
+    }
+}
+
+// --------------------------------------------------------------------------- helpers
+
+fn vc(op: &str) -> VersionConstraint {
+    op.parse().unwrap()
+}
+
+fn profile_strings(p: &[BuildProfile]) -> Vec<String> {
+    p.iter().map(|x| x.to_string()).collect()
+}
+
+/// The crate's view of one lossless relation, in dpkg's terms.
+fn simple_of(r: &Relation) -> Simple {
+    Simple {
+        package: r.try_name().unwrap_or_default(),
+        archqual: r.archqual(),
+        version: r.version().map(|(c, v)| (c.to_string(), v.to_string())),
+        arches: r.architectures().map(|a| a.collect()),
+        restrictions: {
+            let p: Vec<Vec<String>> = r.profiles().map(|g| profile_strings(&g)).collect();
+            if p.is_empty() { None } else { Some(p) }
+        },
+    }
+}
+
+fn lossy_simple_of(r: &LossyRelation) -> Simple {
+    Simple {
+        package: r.name.clone(),
+        archqual: r.archqual.clone(),
+        version: r.version.as_ref().map(|(c, v)| (c.to_string(), v.to_string())),
+        arches: r.architectures.clone(),
+        restrictions: if r.profiles.is_empty() { None } else { Some(r.profiles.iter().map(|g| profile_strings(g)).collect()) },
+    }
+}
+
+fn structure(rels: &Relations) -> Vec<Vec<Simple>> {
+    rels.entries().map(|e| e.relations().map(|r| simple_of(&r)).collect()).collect()
+}
+
+fn lossy_structure(rels: &LossyRelations) -> Vec<Vec<Simple>> {
+    rels.iter().map(|e| e.iter().map(|r| lossy_simple_of(r)).collect()).collect()
+}
+
+/// dpkg's structure with the empty entries the generator wrote (`a,,b`) — dpkg drops them.
+fn gen_structure(g: &GenRelations) -> Vec<Vec<Simple>> {
+    g.entries
+        .iter()
+        .map(|e| {
+            e.iter()
+                .map(|r| Simple {
+                    package: r.name.clone(),
+                    archqual: r.archqual.clone(),
+                    version: r.version.as_ref().map(|(_, v)| (r.normalized_op().unwrap(), v.clone())),
+                    arches: r.arches.clone(),
+                    restrictions: r.profiles.clone(),
+                })
+                .collect()
+        })
+        .collect()
+}
+
+fn canonical(rels: &Relations) -> String {
+    rels.entries()
+        .map(|e| e.relations().map(|r| r.wrap_and_sort().to_string()).collect::<Vec<_>>().join(" | "))
+        .collect::<Vec<_>>()
+        .join(", ")
+}
+
+/// Bug debian-control/1: `architectures()` drops the `!` of negated architectures.
+fn hits_negated_arch_bug(g: &GenRelations) -> bool {
+    g.any(|r| r.negated_arches())
+}
+
+/// Bug debian-control/2: the lossy parser's `<...>` loop mishandles whitespace: `<a b>` is split
+/// or rejected, `< a>` opens an empty group, `<a >` is rejected.
+fn hits_lossy_profile_bug(g: &GenRelations) -> bool {
+    g.any(|r| r.multi_profile_group() || r.ws_before_rangle || r.ws_after_langle)
+}
+
+/// Bug debian-control/10: `Relation::cmp` looks at the name and version only.
+fn hits_ord_bug(a: &GenRelation, b: &GenRelation) -> bool {
+    let key = |r: &GenRelation| (r.name.clone(), r.version.clone());
+    let quals = |r: &GenRelation| (r.archqual.clone(), r.arches.clone().map(|a| a.into_iter().collect::<BTreeSet<_>>()), r.profiles.clone());
+    key(a) == key(b) && quals(a) != quals(b)
+}
+
+/// Bug debian-control/17: `set_architectures` / `add_profile` on a relation without such a
+/// list build an immutable node; the next edit inside the entry panics in rowan.
+fn hits_immutable_node_bug(r: &Relation, edit: &Edit) -> bool {
+    (matches!(edit, Edit::SetArchitectures(_)) && r.architectures().is_none())
+        || (matches!(edit, Edit::AddProfile(_)) && r.profiles().count() == 0)
+}
+
+/// Bug debian-control/14: the strict parser rejects whitespace before `)`.
+fn hits_rparen_bug(g: &GenRelations) -> bool {
+    g.any(|r| r.ws_before_rparen)
+}
+
+/// Bug debian-control/3: the lossy parser does not skip newlines inside a relation.
+fn hits_lossy_newline_bug(g: &GenRelations) -> bool {
+    g.any(|r| r.newline)
+}
+
+/// Bug debian-control/12: `version()` unwraps the constraint parse, so any operator text other
+/// than the five spellings (the deprecated `<`/`>`, `=>`, an empty one in `a(a)`) panics.
+fn hits_version_panic_bug(r: &Relation) -> bool {
+    r.syntax()
+        .children()
+        .find(|n| n.kind() == SyntaxKind::VERSION)
+        .and_then(|v| v.children().find(|c| c.kind() == SyntaxKind::CONSTRAINT))
+        .is_some_and(|c| !OPS.contains(&c.to_string().as_str()))
+}
+
+fn lookup(facts: &BTreeMap<String, String>) -> impl Fn(&str) -> Option<Version> + Copy + '_ {
+    move |name: &str| facts.get(name).map(|v| v.parse().unwrap())
+}
