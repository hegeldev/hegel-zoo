+/// `set_architectures` and `add_profile` on a relation that has none yet work inside an entry
+/// and allow further edits (bug debian-control/17: an immutable node is spliced in).
+#[hegel::test]
+fn set_architectures_and_add_profile_work_inside_an_entry(tc: hegel::TestCase) {
+    let mut r = tc.draw(arb_relation(false).print_as_debug());
+    r.arches = None;
+    r.profiles = None;
+    r.text = r.dpkg_shape();
+    let other = format!("{}0", tc.draw(arb_name()));
+    let text = if tc.draw(int!(0u8, 1)) == 0 { r.text.clone() } else { format!("{}, {other}", r.text) };
+    let rels = Relations::from_str(&text).unwrap();
+    let mut rel = rels.get_entry(0).unwrap().get_relation(0).unwrap();
+    let arch = pick(&tc, ARCHES).to_string();
+    let profile = pick(&tc, PROFILES).to_string();
+    if tc.draw(int!(0u8, 1)) == 0 {
+        rel.set_architectures(std::iter::once(arch.as_str()));
+        assert_eq!(rel.architectures().map(|a| a.collect::<Vec<_>>()), Some(vec![arch.clone()]));
+        rel.add_profile(&[BuildProfile::Disabled(profile.clone())]);
+    } else {
+        rel.add_profile(&[BuildProfile::Disabled(profile.clone())]);
+        assert_eq!(rel.profiles().map(|g| profile_strings(&g)).collect::<Vec<_>>(), vec![vec![format!("!{profile}")]]);
+        rel.set_architectures(std::iter::once(arch.as_str()));
+    }
+    rel.set_archqual("any");
+    let out = rels.to_string();
+    let d = dpkg(&out).unwrap_or_else(|| panic!("dpkg does not parse {out:?}"));
+    assert_eq!(d.entries[0][0].arches, Some(vec![arch]));
+    assert_eq!(d.entries[0][0].restrictions, Some(vec![vec![format!("!{profile}")]]));
+    assert_eq!(d.entries[0][0].archqual.as_deref(), Some("any"));
+    // A relation built from scratch takes the same path, and so does the builder with two
+    // restriction lists.
+    let mut fresh = Relation::simple(&r.name);
+    fresh.set_architectures(std::iter::once("amd64"));
+    fresh.set_archqual("native");
+    assert_eq!(fresh.to_string(), format!("{}:native [amd64]", r.name));
+    let built = Relation::build(&r.name).profiles(vec![vec![BuildProfile::Disabled("nocheck".into())], vec![BuildProfile::Enabled("cross".into())]]).build();
+    assert_eq!(built.to_string(), format!("{} <!nocheck> <cross>", r.name));
+}
