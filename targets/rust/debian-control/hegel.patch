+#[hegel::test]
+fn vcs_git_values_parse_like_lintian(tc: hegel::TestCase) {
+    let v = arb_vcs(&tc);
+    let text = v.text();
+    let m = lintian_vcs("Git", &text);
+    assert_eq!(m.len(), 3, "lintian matches every generated value");
+    assert_eq!(m[0].as_deref(), Some(v.url.as_str()), "lintian's url");
+    assert_eq!(m[1], v.path, "lintian's path");
+    assert_eq!(m[2], v.branch, "lintian's branch");
+    let p = ParsedVcs::from_str(&text).unwrap();
+    assert_eq!((p.repo_url.as_str(), p.branch.as_deref(), p.subpath.as_deref()), (v.url.as_str(), v.branch.as_deref(), v.path.as_deref()), "ParsedVcs of {text:?}");
+    let again = ParsedVcs::from_str(&p.to_string()).unwrap();
+    assert_eq!(again, p, "ParsedVcs Display round trip");
+    let vcs = Vcs::from_field("Git", &text).unwrap();
+    match &vcs {
+        Vcs::Git { repo_url, branch, subpath } => {
+            assert_eq!((repo_url, branch, subpath), (&v.url, &v.branch, &v.path));
+        }
+        other => panic!("not a Git vcs: {other:?}"),
+    }
+    let (kind, value) = vcs.to_field();
+    assert_eq!(kind, "Git");
+    assert_eq!(ParsedVcs::from_str(&value).unwrap(), p, "to_field round trip");
+    assert_eq!(vcs.subpath(), v.path.as_deref());
+    // Hg: url [-b branch] (no path).
+    let hg = if let Some(b) = &v.branch { format!("{} -b {b}", v.url) } else { v.url.clone() };
+    let m = lintian_vcs("Hg", &hg);
+    assert_eq!(m[0].as_deref(), Some(v.url.as_str()));
+    assert_eq!(m.get(1).cloned().flatten(), v.branch);
+    match Vcs::from_field("Hg", &hg).unwrap() {
+        Vcs::Hg { repo_url } => assert_eq!(repo_url, hg, "Hg keeps the whole value"),
+        other => panic!("{other:?}"),
+    }
+    // Cvs: root [module].
+    let cvs = if let Some(p) = &v.path { format!("{} {p}", v.url) } else { v.url.clone() };
+    let m = lintian_vcs("Cvs", &cvs);
+    match Vcs::from_field("Cvs", &cvs).unwrap() {
+        Vcs::Cvs { root, module } => {
+            assert_eq!(Some(root.as_str()), m[0].as_deref());
+            assert_eq!(module, m.get(1).cloned().flatten());
+        }
+        other => panic!("{other:?}"),
+    }
+}
