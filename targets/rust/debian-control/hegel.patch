+/// Operator spellings outside the five (`=>`, `<>`, `>>>`, `==`, `=<`; dpkg reads some as an
+/// operator followed by a strange version) are rejected by the strict parser, or at least do
+/// not make `version()` panic (bug debian-control/12).
+#[hegel::test]
+fn bad_operators_do_not_panic(tc: hegel::TestCase) {
+    let name = tc.draw(arb_name());
+    let op = pick(&tc, &["=>", "<>", ">>>", "==", "=<", "><", "<<<", "<=>", "=="]);
+    let ver = tc.draw(arb_version());
+    let text = format!("{name}{}({}{op}{}{ver})", ws0(&tc), ws0(&tc), ws0(&tc));
+    match Relations::from_str(&text) {
+        Err(_) => {}
+        Ok(rels) => {
+            let r = rels.entries().next().unwrap().relations().next().unwrap();
+            let v = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| r.version()));
+            assert!(v.is_ok(), "strict parse accepted {text:?} and version() panicked");
+        }
+    }
+    assert!(LossyRelations::from_str(&text).is_err(), "lossy parse accepted {text:?}");
+}
