+#[derive(Debug, Clone)]
+struct GenBuildinfo {
+    source: String,
+    binary: Vec<String>,
+    architecture: Vec<String>,
+    version: String,
+    md5: Vec<Sum>,
+    sha1: Vec<Sum>,
+    sha256: Vec<Sum>,
+    build_origin: Option<String>,
+    build_architecture: String,
+    build_date: String,
+    build_path: Option<String>,
+    /// Single-line in the general model (dpkg's one-per-line layout is pinned).
+    build_tainted_by: Option<Vec<String>>,
+    installed: Vec<(String, String)>,
+    /// Unquoted `KEY=value` lines (dpkg's quoted layout is pinned).
+    environment: Option<Vec<(String, String)>>,
+}
+
+impl GenBuildinfo {
+    fn fields(&self) -> Fields {
+        let mut f: Fields = vec![
+            ("Format".into(), "1.0".into()),
+            ("Source".into(), self.source.clone()),
+            ("Binary".into(), self.binary.join(" ")),
+            ("Architecture".into(), self.architecture.join(" ")),
+            ("Version".into(), self.version.clone()),
+            ("Checksums-Md5".into(), multi(self.md5.iter().map(Sum::line).collect())),
+            ("Checksums-Sha1".into(), multi(self.sha1.iter().map(Sum::line).collect())),
+            ("Checksums-Sha256".into(), multi(self.sha256.iter().map(Sum::line).collect())),
+        ];
+        if let Some(o) = &self.build_origin {
+            f.push(("Build-Origin".into(), o.clone()));
+        }
+        f.push(("Build-Architecture".into(), self.build_architecture.clone()));
+        f.push(("Build-Date".into(), self.build_date.clone()));
+        if let Some(p) = &self.build_path {
+            f.push(("Build-Path".into(), p.clone()));
+        }
+        if let Some(t) = &self.build_tainted_by {
+            f.push(("Build-Tainted-By".into(), t.join(" ")));
+        }
+        let n = self.installed.len();
+        f.push(("Installed-Build-Depends".into(), multi(self.installed.iter().enumerate().map(|(i, (p, v))| format!("{p} (= {v}){}", if i + 1 < n { "," } else { "" })).collect())));
+        if let Some(e) = &self.environment {
+            f.push(("Environment".into(), multi(e.iter().map(|(k, v)| format!("{k}={v}")).collect())));
+        }
+        f
+    }
+    fn text(&self) -> String {
+        render(&self.fields())
+    }
+    fn relations(&self) -> String {
+        self.installed.iter().map(|(p, v)| format!("{p} (= {v})")).collect::<Vec<_>>().join(", ")
+    }
+}
+
+#[hegel::composite]
+fn arb_buildinfo(tc: &hegel::TestCase) -> GenBuildinfo {
+    let source = pick(tc, SOURCES).to_string();
+    let version = pick(tc, VERSIONS).to_string();
+    let n_bin = tc.draw(int!(1, 3)) as usize;
+    let mut binary = vec![source.clone()];
+    for _ in 1..n_bin {
+        let b = format!("{source}-{}", pick(tc, &["dev", "doc", "utils"]));
+        if !binary.contains(&b) {
+            binary.push(b);
+        }
+    }
+    let mut architecture = vec![pick(tc, &["all", "amd64", "arm64"]).to_string()];
+    if tc.draw(generators::booleans()) {
+        architecture.push("source".into());
+    }
+    let n_files = tc.draw(int!(1, 3)) as usize;
+    let mut filenames = Vec::new();
+    for _ in 0..n_files {
+        let f = arb_filename(tc, &source, &version);
+        if !filenames.contains(&f) {
+            filenames.push(f);
+        }
+    }
+    let n_inst = tc.draw(int!(1, 4)) as usize;
+    let mut installed: Vec<(String, String)> = Vec::new();
+    for _ in 0..n_inst {
+        let p = pick(tc, &["base-files", "bash", "binutils", "gcc-13", "libc6:amd64"]).to_string();
+        if !installed.iter().any(|(q, _)| *q == p) {
+            installed.push((p, pick(tc, &["13ubuntu10.5", "5.2.21-2", "1:2.42-4", "2.39-0ubuntu8.4"]).to_string()));
+        }
+    }
+    installed.sort();
+    let environment = opt(tc, |tc| {
+        let n = tc.draw(int!(1, 3)) as usize;
+        let mut env: Vec<(String, String)> = Vec::new();
+        for _ in 0..n {
+            let k = pick(tc, &["LANG", "DEB_BUILD_OPTIONS", "SOURCE_DATE_EPOCH", "LC_ALL"]).to_string();
+            if !env.iter().any(|(q, _)| *q == k) {
+                env.push((k, pick(tc, &["C.UTF-8", "parallel=4", "1700000000", "nocheck"]).to_string()));
+            }
+        }
+        env.sort();
+        env
+    });
+    GenBuildinfo {
+        source,
+        binary,
+        architecture,
+        version,
+        md5: arb_sums(tc, 32, &filenames),
+        sha1: arb_sums(tc, 40, &filenames),
+        sha256: arb_sums(tc, 64, &filenames),
+        build_origin: opt(tc, |tc| pick(tc, &["Debian", "Ubuntu"]).to_string()),
+        build_architecture: pick(tc, &["amd64", "arm64"]).to_string(),
+        build_date: pick(tc, DATES).to_string(),
+        build_path: opt(tc, |tc| format!("/build/{}-{}", pick(tc, SOURCES), arb_hex(tc, 6))),
+        build_tainted_by: opt(tc, |tc| vec![pick(tc, &["merged-usr-via-aliased-dirs", "usr-local-has-libraries", "usr-local-has-programs"]).to_string()]),
+        installed,
+        environment,
+    }
+}
+
+fn check_buildinfo(b: &Buildinfo, g: &GenBuildinfo) {
+    assert_eq!(b.format(), Some("1.0".to_string()));
+    assert_eq!(b.source(), Some(g.source.clone()));
+    assert_eq!(b.binaries(), Some(g.binary.clone()));
+    assert_eq!(b.architecture(), Some(g.architecture.join(" ")));
+    assert_eq!(b.version().map(|v| v.to_string()), Some(g.version.clone()));
+    let md5: Vec<Md5Checksum> = g.md5.iter().map(|s| Md5Checksum { md5sum: s.hash.clone(), size: s.size as usize, filename: s.filename.clone() }).collect();
+    assert_eq!(b.checksums_md5(), md5);
+    let sha1: Vec<Sha1Checksum> = g.sha1.iter().map(|s| Sha1Checksum { sha1: s.hash.clone(), size: s.size as usize, filename: s.filename.clone() }).collect();
+    assert_eq!(b.checksums_sha1(), sha1);
+    let sha256: Vec<Sha256Checksum> = g.sha256.iter().map(|s| Sha256Checksum { sha256: s.hash.clone(), size: s.size as usize, filename: s.filename.clone() }).collect();
+    assert_eq!(b.checksums_sha256(), sha256);
+    assert_eq!(b.build_origin(), g.build_origin);
+    assert_eq!(b.build_architecture(), Some(g.build_architecture.clone()));
+    assert_eq!(b.build_date(), Some(g.build_date.clone()));
+    assert_eq!(b.build_path(), g.build_path);
+    assert_eq!(b.build_tainted_by(), g.build_tainted_by);
+    let rels = b.installed_build_depends().expect("Installed-Build-Depends");
+    assert_eq!(rels.to_string().split_whitespace().collect::<Vec<_>>(), g.relations().split_whitespace().collect::<Vec<_>>(), "installed build depends");
+    let env: Option<HashMap<String, String>> = g.environment.as_ref().map(|e| e.iter().cloned().collect());
+    assert_eq!(b.environment(), env);
+}
