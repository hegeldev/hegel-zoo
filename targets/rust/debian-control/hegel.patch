+fn set_environment_writes_dpkgs_layout() {
+    let mut b = Buildinfo::new();
+    let env: HashMap<String, String> = [("LANG", "C.UTF-8"), ("DEB_BUILD_OPTIONS", "parallel=4 nocheck"), ("SOURCE_DATE_EPOCH", "1"), ("A", "1"), ("B", "2"), ("C", "3")].iter().map(|(k, v)| (k.to_string(), v.to_string())).collect();
+    b.set_environment(env);
+    let text = b.syntax().text().to_string();
+    assert_eq!(text, "Environment:\n A=\"1\"\n B=\"2\"\n C=\"3\"\n DEB_BUILD_OPTIONS=\"parallel=4 nocheck\"\n LANG=\"C.UTF-8\"\n SOURCE_DATE_EPOCH=\"1\"\n");
+}
+
+#[test]
+fn environment_without_an_equals_sign_does_not_panic() {
+    let b = Buildinfo::from_str("Environment:\n FOO\n").unwrap();
+    let got = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| b.environment()));
+    assert!(got.is_ok(), "environment() panics on a line without `=`");
+}
