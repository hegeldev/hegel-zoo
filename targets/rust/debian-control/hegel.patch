+#[hegel::test]
+fn sort_binaries_orders_the_paragraphs(tc: hegel::TestCase) {
+    let mut g = tc.draw(arb_control(true).print_as_debug());
+    // Moving the last paragraph of a file without a final newline glues it to
+    // its neighbour (deb822-lossless/9); the property needs the newline.
+    g.trailing_newline = true;
+    let keep_first = tc.draw(generators::booleans());
+    let text = g.text();
+    let mut c = Control::from_str(&text).unwrap();
+    c.sort_binaries(keep_first);
+    let names: Vec<String> = c.binaries().map(|b| b.name().unwrap()).collect();
+    let mut expected: Vec<String> = g.binaries.iter().map(|b| b.name.clone()).collect();
+    if keep_first && expected.len() > 1 {
+        expected[1..].sort();
+    } else {
+        expected.sort();
+    }
+    assert_eq!(names, expected, "binary order");
+    // Every paragraph keeps its text; the file re-parses to the same values.
+    let sorted_text = c.to_string();
+    let again = Control::from_str(&sorted_text).expect("sorted text parses");
+    assert!(c.tree_eq(&again), "sorted tree is the parse of its text: {sorted_text:?}");
+    check_source(&again.source().unwrap(), &g.source);
+    for b in again.binaries() {
+        let gb = g.binaries.iter().find(|x| Some(x.name.clone()) == b.name()).unwrap();
+        check_binary(&b, gb);
+        let raw: Fields = b.as_deb822().items().collect();
+        assert_eq!(raw, dedent(&gb.ordered()), "fields untouched");
+    }
+    let (_, dpkgs) = dpkg_control(&sorted_text).expect("dpkg reads the sorted file");
+    assert_eq!(dpkgs.len(), g.binaries.len());
+}
