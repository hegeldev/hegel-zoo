+// Model and generators
+// ---------------------------------------------------------------------------
+
+fn pick<T: Clone + Send + Sync + Debug + 'static>(tc: &hegel::TestCase, items: &[T]) -> T {
+    tc.draw(generators::sampled_from(items.to_vec()).print_as_debug())
+}
+
+const NAMES: &[&str] = &["foo", "libfoo-dev", "bar1", "python3-baz", "a.b+c"];
+const PEOPLE: &[&str] = &["John Doe <john@example.com>", "A. Maintainer <am@debian.org>", "Debian QA Group <packages@qa.debian.org>"];
+const SECTIONS: &[&str] = &["misc", "libs", "python", "non-free/utils"];
+const ARCHES: &[&str] = &["any", "all", "amd64", "linux-any", "amd64 i386"];
+const URLS: &[&str] = &["https://salsa.debian.org/foo/foo.git", "https://github.com/foo/bar", "git://git.example.org/x/y", "https://example.com/"];
+const BRANCHES: &[&str] = &["debian/latest", "main", "debian/sid"];
+const PATHS: &[&str] = &["pkg", "debian/foo", "sub/dir"];
+const RELATIONS: &[&str] = &["debhelper-compat (= 13)", "foo", "bar (>= 1.0), baz", "libc6 | libc6.1", "x [amd64] <!nocheck>"];
+const WORDS: &[&str] = &["Fix", "widget", "frobnication", "speeds", "on", "mips/mipsel", "(etch)", "a:b", "very-long-word-to-fill-the-line"];
+
+fn arb_words(tc: &hegel::TestCase, min: i64, max: i64) -> String {
+    let n = tc.draw(int!(min, max)) as usize;
+    (0..n).map(|_| pick(tc, WORDS).to_string()).collect::<Vec<_>>().join(" ")
+}
+
+#[derive(Debug, Clone, PartialEq)]
+struct GenVcs {
+    url: String,
+    branch: Option<String>,
+    path: Option<String>,
+    /// `[path]` before `-b branch` (lintian accepts both orders).
+    path_first: bool,
+}
+
+impl GenVcs {
+    fn text(&self) -> String {
+        let mut parts = vec![self.url.clone()];
+        let b = self.branch.as_ref().map(|b| format!("-b {b}"));
+        let p = self.path.as_ref().map(|p| format!("[{p}]"));
+        if self.path_first {
+            parts.extend(p);
+            parts.extend(b);
+        } else {
+            parts.extend(b);
+            parts.extend(p);
+        }
+        parts.join(" ")
+    }
+}
+
+fn arb_vcs(tc: &hegel::TestCase) -> GenVcs {
+    GenVcs {
+        url: pick(tc, URLS).to_string(),
+        branch: if tc.draw(generators::booleans()) { Some(pick(tc, BRANCHES).to_string()) } else { None },
+        path: if tc.draw(generators::booleans()) { Some(pick(tc, PATHS).to_string()) } else { None },
+        path_first: tc.draw(generators::booleans()),
+    }
+}
+
+/// A description value: the synopsis and the long lines; `""` is a blank
+/// line (`.` in deb822), a line starting with a space is verbatim.
+#[derive(Debug, Clone, PartialEq)]
+struct GenDescription {
+    synopsis: String,
+    long: Vec<String>,
+}
+
+impl GenDescription {
+    /// The deb822 value as the lossless layer reads it (`get_multiline`):
+    /// `.` markers kept, verbatim lines keep their extra indentation.
+    fn value(&self) -> String {
+        let mut s = self.synopsis.clone();
+        for l in &self.long {
+            s.push('\n');
+            s.push_str(if l.is_empty() { "." } else { l });
+        }
+        s
+    }
+    /// dpkg's reading: `.` → empty line, one indent stripped (extra kept).
+    fn dpkg_value(&self) -> String {
+        let mut s = self.synopsis.clone();
+        for l in &self.long {
+            s.push('\n');
+            s.push_str(l);
+        }
+        s
+    }
+    fn has_verbatim(&self) -> bool {
+        self.long.iter().any(|l| l.starts_with(' '))
+    }
+}
+
+fn arb_description(tc: &hegel::TestCase, verbatim: bool) -> GenDescription {
+    let n = tc.draw(int!(0, 4)) as usize;
+    let mut long: Vec<String> = (0..n)
+        .map(|_| match tc.draw(int!(0, 4)) {
+            0 => String::new(),
+            1 if verbatim => format!(" {}", arb_words(tc, 1, 3)),
+            _ => arb_words(tc, 1, 5),
+        })
+        .collect();
+    // dpkg drops a trailing empty line of a value; keep the ends non-blank.
+    if let Some(l) = long.last_mut() {
+        if l.is_empty() {
+            *l = "end".into();
+        }
+    }
+    if let Some(l) = long.first_mut() {
+        if l.is_empty() {
+            *l = "start".into();
+        }
+    }
+    GenDescription { synopsis: arb_words(tc, 1, 4), long }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+struct GenSource {
+    name: String,
+    maintainer: String,
+    uploaders: Vec<String>,
+    section: Option<String>,
+    priority: Option<Priority>,
+    standards_version: Option<String>,
+    build_depends: Option<String>,
+    build_depends_indep: Option<String>,
+    vcs_git: Option<GenVcs>,
+    vcs_browser: Option<String>,
+    homepage: Option<String>,
+    /// Only `no` here (Policy's `binary-targets` and keyword forms are pinned).
+    rules_requires_root: Option<bool>,
+    testsuite: Option<String>,
+    order: Vec<usize>,
+}
+
+impl GenSource {
+    fn fields(&self) -> Fields {
+        let mut f: Fields = vec![("Source".into(), self.name.clone()), ("Maintainer".into(), self.maintainer.clone())];
+        if !self.uploaders.is_empty() {
+            f.push(("Uploaders".into(), self.uploaders.join(", ")));
+        }
+        if let Some(s) = &self.section {
+            f.push(("Section".into(), s.clone()));
+        }
+        if let Some(p) = &self.priority {
+            f.push(("Priority".into(), p.to_string()));
+        }
+        if let Some(v) = &self.standards_version {
+            f.push(("Standards-Version".into(), v.clone()));
+        }
+        if let Some(v) = &self.build_depends {
+            f.push(("Build-Depends".into(), v.clone()));
+        }
+        if let Some(v) = &self.build_depends_indep {
+            f.push(("Build-Depends-Indep".into(), v.clone()));
+        }
+        if let Some(v) = &self.vcs_git {
+            f.push(("Vcs-Git".into(), v.text()));
+        }
+        if let Some(v) = &self.vcs_browser {
+            f.push(("Vcs-Browser".into(), v.clone()));
+        }
+        if let Some(v) = &self.homepage {
+            f.push(("Homepage".into(), v.clone()));
+        }
+        if let Some(v) = &self.rules_requires_root {
+            f.push(("Rules-Requires-Root".into(), if *v { "yes" } else { "no" }.into()));
+        }
+        if let Some(v) = &self.testsuite {
+            f.push(("Testsuite".into(), v.clone()));
+        }
+        f
+    }
+    fn ordered(&self) -> Fields {
+        let f = self.fields();
+        self.order.iter().map(|&i| f[i].clone()).collect()
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+struct GenBinary {
+    name: String,
+    architecture: String,
+    section: Option<String>,
+    priority: Option<Priority>,
+    multi_arch: Option<MultiArch>,
+    essential: bool,
+    depends: Option<String>,
+    recommends: Option<String>,
+    description: GenDescription,
+    homepage: Option<String>,
+    order: Vec<usize>,
+}
+
+impl GenBinary {
+    fn fields(&self) -> Fields {
+        let mut f: Fields = vec![("Package".into(), self.name.clone()), ("Architecture".into(), self.architecture.clone())];
+        if let Some(s) = &self.section {
+            f.push(("Section".into(), s.clone()));
+        }
+        if let Some(p) = &self.priority {
+            f.push(("Priority".into(), p.to_string()));
+        }
+        if let Some(m) = &self.multi_arch {
+            f.push(("Multi-Arch".into(), m.to_string()));
+        }
+        if self.essential {
+            f.push(("Essential".into(), "yes".into()));
+        }
+        if let Some(v) = &self.depends {
+            f.push(("Depends".into(), v.clone()));
+        }
+        if let Some(v) = &self.recommends {
+            f.push(("Recommends".into(), v.clone()));
+        }
+        f.push(("Description".into(), self.description.value()));
+        if let Some(v) = &self.homepage {
+            f.push(("Homepage".into(), v.clone()));
+        }
+        f
+    }
+    fn ordered(&self) -> Fields {
+        let f = self.fields();
+        self.order.iter().map(|&i| f[i].clone()).collect()
+    }
+}
+
+#[derive(Debug, Clone)]
+struct GenControl {
+    source: GenSource,
+    binaries: Vec<GenBinary>,
+    trailing_newline: bool,
+}
+
+fn render(fields: &Fields) -> String {
+    let mut s = String::new();
+    for (k, v) in fields {
+        s.push_str(k);
+        s.push(':');
+        let mut lines = v.split('\n');
+        let first = lines.next().unwrap();
+        if !first.is_empty() {
+            s.push(' ');
+            s.push_str(first);
+        }
+        s.push('\n');
+        for l in lines {
+            s.push(' ');
+            s.push_str(l);
+            s.push('\n');
+        }
+    }
+    s
+}
+
+impl GenControl {
+    fn text(&self) -> String {
+        let mut s = render(&self.source.ordered());
+        for b in &self.binaries {
+            s.push('\n');
+            s.push_str(&render(&b.ordered()));
+        }
+        if !self.trailing_newline {
+            s.pop();
+        }
+        s
+    }
+    fn has_verbatim(&self) -> bool {
+        self.binaries.iter().any(|b| b.description.has_verbatim())
+    }
+}
+
+fn permutation(tc: &hegel::TestCase, n: usize) -> Vec<usize> {
+    let mut idx: Vec<usize> = (0..n).collect();
+    let mut order = Vec::new();
+    while !idx.is_empty() {
+        let i = tc.draw(int!(0, idx.len() as i64 - 1)) as usize;
+        order.push(idx.remove(i));
+    }
+    order
+}
+
+fn opt<T>(tc: &hegel::TestCase, f: impl FnOnce(&hegel::TestCase) -> T) -> Option<T> {
+    if tc.draw(generators::booleans()) {
+        Some(f(tc))
+    } else {
+        None
+    }
+}
+
+fn arb_priority(tc: &hegel::TestCase) -> Priority {
+    pick(tc, &[Priority::Required, Priority::Important, Priority::Standard, Priority::Optional, Priority::Extra])
+}
+
+fn arb_multi_arch(tc: &hegel::TestCase) -> MultiArch {
+    pick(tc, &[MultiArch::Same, MultiArch::Foreign, MultiArch::No, MultiArch::Allowed])
+}
+
+fn arb_standards_version(tc: &hegel::TestCase) -> String {
+    let mut s = format!("{}.{}.{}", tc.draw(int!(3, 4)), tc.draw(int!(0, 9)), tc.draw(int!(1, 9)));
+    if tc.draw(generators::booleans()) {
+        s.push_str(&format!(".{}", tc.draw(int!(1, 3))));
+    }
+    s
+}
+
+#[hegel::composite]
+fn arb_control(tc: &hegel::TestCase, verbatim: bool) -> GenControl {
+    let n_up = tc.draw(int!(0, 2)) as usize;
+    let mut source = GenSource {
+        name: pick(tc, NAMES).to_string(),
+        maintainer: pick(tc, PEOPLE).to_string(),
+        uploaders: (0..n_up).map(|_| pick(tc, PEOPLE).to_string()).collect(),
+        section: opt(tc, |tc| pick(tc, SECTIONS).to_string()),
+        priority: opt(tc, arb_priority),
+        standards_version: opt(tc, arb_standards_version),
+        build_depends: opt(tc, |tc| pick(tc, RELATIONS).to_string()),
+        build_depends_indep: opt(tc, |tc| pick(tc, RELATIONS).to_string()),
+        vcs_git: opt(tc, arb_vcs),
+        vcs_browser: opt(tc, |tc| pick(tc, URLS).to_string()),
+        homepage: opt(tc, |tc| pick(tc, URLS).to_string()),
+        rules_requires_root: opt(tc, |_| false),
+        testsuite: opt(tc, |_| "autopkgtest".to_string()),
+        order: Vec::new(),
+    };
+    source.order = permutation(tc, source.fields().len());
+    let n_bin = tc.draw(int!(0, 3)) as usize;
+    let mut names: Vec<String> = Vec::new();
+    let mut binaries = Vec::new();
+    for _ in 0..n_bin {
+        let name = pick(tc, NAMES).to_string();
+        if names.contains(&name) {
+            continue; // distinct package names (dpkg and the model index by name)
+        }
+        names.push(name.clone());
+        let mut b = GenBinary {
+            name,
+            architecture: pick(tc, ARCHES).to_string(),
+            section: opt(tc, |tc| pick(tc, SECTIONS).to_string()),
+            priority: opt(tc, arb_priority),
+            multi_arch: opt(tc, arb_multi_arch),
+            essential: tc.draw(int!(0, 3)) == 0,
+            depends: opt(tc, |tc| pick(tc, RELATIONS).to_string()),
+            recommends: opt(tc, |tc| pick(tc, RELATIONS).to_string()),
+            description: arb_description(tc, verbatim),
+            homepage: opt(tc, |tc| pick(tc, URLS).to_string()),
+            order: Vec::new(),
+        };
+        b.order = permutation(tc, b.fields().len());
+        binaries.push(b);
+    }
+    GenControl { source, binaries, trailing_newline: tc.draw(generators::booleans()) }
+}
+
+/// dpkg's view of a field list: sorted, `.` lines decoded.
+fn as_dpkg(fields: &Fields) -> Fields {
+    let mut f: Fields = fields
+        .iter()
+        .map(|(k, v)| (k.clone(), v.split('\n').map(|l| if l == "." { "" } else { l }).collect::<Vec<_>>().join("\n")))
+        .collect();
+    f.sort();
+    f
+}
+
+/// deb822-lossless's `items()`/`get()` drop the whole continuation indent
+/// (documented there; debian-control's `description()` uses `get_multiline`
+/// to keep the verbatim indentation).
+fn dedent(fields: &Fields) -> Fields {
+    fields.iter().map(|(k, v)| (k.clone(), v.split('\n').map(|l| l.trim_start()).collect::<Vec<_>>().join("\n"))).collect()
+}
+
+fn rel_eq(a: Option<Relations>, b: Option<&String>) -> bool {
+    match (a, b) {
+        (None, None) => true,
+        (Some(a), Some(b)) => a.to_string() == Relations::from_str(b).unwrap().to_string(),
+        _ => false,
+    }
+}
