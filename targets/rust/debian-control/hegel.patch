+    let l = debian_control::lossy::Control::from_str(text).unwrap();
+    let c = Control::from_str(text).unwrap();
+    assert_eq!(l.binaries[0].description, c.binaries().next().unwrap().description());
+    assert_eq!(l.binaries[0].description.as_deref(), Some("short\nlong\n verbatim  x\n.\nmore"));
+}
+
+#[test]
+fn format_description_feeds_set_description() {
+    let mut c = Control::from_str("Source: foo\n\nPackage: bar\nArchitecture: all\nDescription: x\n").unwrap();
+    let mut b = c.binaries().next().unwrap();
+    b.set_description(Some(&format_description("short", "long\n\nmore")));
+    assert_eq!(b.description(), Some("short\nlong\n.\nmore".to_string()), "{}", b.to_string());
+    let again = Control::from_str(&b.to_string()).unwrap();
+    assert_eq!(again.binaries().next().unwrap().description(), Some("short\nlong\n.\nmore".to_string()));
+}
+
+#[test]
+fn package_list_entries_display_deterministically() {
+    // dpkg-source writes Package-List extras in a fixed order; Display iterates a HashMap.
+    let s = "foo deb misc optional arch=amd64 profile=!nocheck essential=yes protected=yes a=1 b=2";
+    let e = PackageListEntry::from_str(s).unwrap();
+    assert_eq!(e.to_string(), s);
+    let e2 = PackageListEntry::from_str("foo deb misc optional x=a=b").unwrap();
+    assert_eq!(e2.extra.get("x").map(|s| s.as_str()), Some("a=b"), "a value containing `=`");
+}
