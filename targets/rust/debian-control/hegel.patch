+#[hegel::test]
+fn changes_files_are_read_like_dpkg_and_python_debian(tc: hegel::TestCase) {
+    let g = tc.draw(arb_changes().print_as_debug());
+    let text = g.text();
+    let c = Changes::read(text.as_bytes()).unwrap_or_else(|e| panic!("Changes::read: {e}"));
+    assert_eq!(c.syntax().text().to_string(), text, "lossless");
+    check_changes(&c, &g);
+    // `parse` accepts it without errors, and reads the same.
+    let parsed = Changes::parse(&text);
+    assert!(parsed.errors().is_empty(), "parse errors: {:?}", parsed.errors());
+    check_changes(&parsed.tree(), &g);
+    // dpkg reads the same fields and every field belongs in a .changes file.
+    let (fields, signed) = dpkg_read("changes", &text).unwrap_or_else(|e| panic!("dpkg refuses the file: {e}"));
+    assert_eq!(fields, as_dpkg(&g.fields()), "dpkg's fields");
+    assert!(!signed);
+    for (k, _) in g.fields() {
+        assert!(dpkg_allows("changes", &k), "dpkg does not allow {k} in a .changes file");
+    }
+    // python-debian's typed entries agree with the crate's.
+    let py = python_changes(&text);
+    assert!(py["err"].is_null(), "python-debian: {}", py["err"]);
+    assert_eq!(py["source"].as_str(), Some(g.source.as_str()));
+    assert_eq!(py["pool"].as_str(), Some(g.pool_path().as_str()), "python-debian's pool path");
+    let files = py["files"].as_array().unwrap();
+    assert_eq!(files.len(), g.files.len());
+    for (f, gf) in files.iter().zip(g.files.iter()) {
+        assert_eq!(f["md5sum"].as_str(), Some(gf.md5.as_str()));
+        assert_eq!(f["size"].as_str().unwrap().parse::<u64>().unwrap(), gf.size);
+        assert_eq!(f["section"].as_str(), Some(gf.section.as_str()));
+        assert_eq!(f["priority"].as_str(), Some(gf.priority.to_string().as_str()));
+        assert_eq!(f["name"].as_str(), Some(gf.filename.as_str()));
+    }
+    for (key, sums) in [("sha1", &g.sha1), ("sha256", &g.sha256)] {
+        let entries = py[key].as_array().unwrap();
+        assert_eq!(entries.len(), sums.len());
+        for (e, s) in entries.iter().zip(sums.iter()) {
+            assert_eq!(e[key].as_str(), Some(s.hash.as_str()));
+            assert_eq!(e["size"].as_str().unwrap().parse::<u64>().unwrap(), s.size);
+            assert_eq!(e["name"].as_str(), Some(s.filename.as_str()));
+        }
+    }
+}
