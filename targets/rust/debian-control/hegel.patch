+#[hegel::test]
+fn built_control_files_are_read_back(tc: hegel::TestCase) {
+    let g = tc.draw(arb_control(true).print_as_debug());
+    let mut c = Control::new();
+    {
+        let mut s = c.add_source(&g.source.name);
+        s.set_maintainer(&g.source.maintainer);
+        if !g.source.uploaders.is_empty() {
+            let ups: Vec<&str> = g.source.uploaders.iter().map(|s| s.as_str()).collect();
+            s.set_uploaders(&ups);
+        }
+        s.set_section(g.source.section.as_deref());
+        s.set_priority(g.source.priority.clone());
+        if let Some(v) = &g.source.standards_version {
+            s.set_standards_version(v);
+        }
+        if let Some(v) = &g.source.build_depends {
+            s.set_build_depends(&Relations::from_str(v).unwrap());
+        }
+        if let Some(v) = &g.source.build_depends_indep {
+            s.set_build_depends_indep(&Relations::from_str(v).unwrap());
+        }
+        if let Some(v) = &g.source.vcs_git {
+            s.set_vcs_git(&v.text());
+        }
+        s.set_vcs_browser(g.source.vcs_browser.as_deref());
+        if let Some(v) = &g.source.homepage {
+            s.set_homepage(&url::Url::parse(v).unwrap());
+        }
+        if let Some(v) = g.source.rules_requires_root {
+            s.set_rules_requires_root(v);
+        }
+        if let Some(v) = &g.source.testsuite {
+            s.set_testsuite(v);
+        }
+    }
+    for gb in &g.binaries {
+        let mut b = c.add_binary(&gb.name);
+        b.set_architecture(Some(&gb.architecture));
+        b.set_section(gb.section.as_deref());
+        b.set_priority(gb.priority.clone());
+        b.set_multi_arch(gb.multi_arch.clone());
+        b.set_essential(gb.essential);
+        b.set_depends(gb.depends.as_ref().map(|d| Relations::from_str(d).unwrap()).as_ref());
+        b.set_recommends(gb.recommends.as_ref().map(|d| Relations::from_str(d).unwrap()).as_ref());
+        b.set_description(Some(&gb.description.value()));
+        if let Some(v) = &gb.homepage {
+            b.set_homepage(&url::Url::parse(v).unwrap());
+        }
+    }
+    let text = c.to_string();
+    let again = Control::from_str(&text).expect("the built text parses");
+    if !g.has_verbatim() {
+        // With a verbatim description line `set_description` builds a tree
+        // whose tokens differ from the parse of its text (values agree below).
+        assert!(c.tree_eq(&again), "the built tree is the parse of its text: {text:?}");
+    }
+    for cc in [&c, &again] {
+        let s = cc.source().expect("source");
+        check_source(&s, &g.source);
+        let bins: Vec<Binary> = cc.binaries().collect();
+        assert_eq!(bins.len(), g.binaries.len());
+        for (b, gb) in bins.iter().zip(g.binaries.iter()) {
+            check_binary(b, gb);
+        }
+        // Fields are in canonical order: the known ones as listed, the others
+        // (Homepage is not in BINARY_FIELD_ORDER) after them in insertion order.
+        let canonical = |keys: &[String], order: &[&str]| -> Vec<String> {
+            let mut c: Vec<String> = order.iter().filter(|k| keys.contains(&k.to_string())).map(|k| k.to_string()).collect();
+            c.extend(keys.iter().filter(|k| !order.contains(&k.as_str())).cloned());
+            c
+        };
+        let keys: Vec<String> = s.as_deb822().items().map(|(k, _)| k).collect();
+        assert_eq!(keys, canonical(&keys, SOURCE_FIELD_ORDER), "source field order");
+        for b in &bins {
+            let keys: Vec<String> = b.as_deb822().items().map(|(k, _)| k).collect();
+            assert_eq!(keys, canonical(&keys, BINARY_FIELD_ORDER), "binary field order");
+        }
+    }
+    // dpkg reads the built file.
+    let (dsrc, dpkgs) = dpkg_control(&text).expect("dpkg reads the built file");
+    let mut expected_src = as_dpkg(&g.source.fields());
+    // Relations are canonicalised by the setters; compare through the parser.
+    let canon = |f: &mut Fields| {
+        for (k, v) in f.iter_mut() {
+            if k.starts_with("Build-Depends") || k == "Depends" || k == "Recommends" {
+                *v = Relations::from_str(v).unwrap().to_string();
+            }
+        }
+    };
+    canon(&mut expected_src);
+    let mut dsrc = dsrc;
+    canon(&mut dsrc);
+    assert_eq!(dsrc, expected_src, "dpkg's source fields of the built file");
+    assert_eq!(dpkgs.len(), g.binaries.len());
+    // Removing a binary removes exactly that paragraph.
+    if let Some(gb) = g.binaries.first() {
+        let mut c2 = again;
+        assert!(c2.remove_binary(&gb.name));
+        assert!(!c2.remove_binary(&gb.name), "gone");
+        let names: Vec<Option<String>> = c2.binaries().map(|b| b.name()).collect();
+        let expected: Vec<Option<String>> = g.binaries.iter().skip(1).map(|b| Some(b.name.clone())).collect();
+        assert_eq!(names, expected, "remaining binaries");
+        check_source(&c2.source().unwrap(), &g.source);
+        Control::from_str(&c2.to_string()).expect("still parses");
+    }
+}
