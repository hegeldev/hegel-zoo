+/// Substvars are preserved, listed, ensured once and dropped cleanly.
+#[hegel::test]
+fn substvars_round_trip(tc: hegel::TestCase) {
+    let g = tc.draw(arb_relations(false).print_as_debug());
+    if hits_negated_arch_bug(&g) || hits_rparen_bug(&g) {
+        return;
+    }
+    let var = pick(&tc, &["${misc:Depends}", "${shlibs:Depends}", "${python3:Depends}", "${perl:Depends}"]);
+    let mut rels = Relations::from_str(&g.text).unwrap();
+    assert!(Relations::from_str(&format!("{}, {var}", g.text)).is_err(), "the strict parser accepted a substvar");
+    let n = rels.len();
+    rels.ensure_substvar(var).unwrap();
+    assert_eq!(rels.substvars().collect::<Vec<_>>(), vec![var.to_string()]);
+    let text = rels.to_string();
+    let (again, errors) = Relations::parse_relaxed(&text, true);
+    assert!(errors.is_empty(), "{text:?}: {errors:?}");
+    assert_eq!(again.substvars().collect::<Vec<_>>(), vec![var.to_string()]);
+    assert_eq!(again.len(), n);
+    rels.ensure_substvar(var).unwrap();
+    assert_eq!(rels.to_string(), text, "ensure_substvar is not idempotent");
+    rels.drop_substvar(var);
+    assert_eq!(rels.substvars().count(), 0);
+    assert_eq!(structure(&rels).into_iter().filter(|e| !e.is_empty()).collect::<Vec<_>>(), structure(&Relations::from_str(&g.text).unwrap()).into_iter().filter(|e| !e.is_empty()).collect::<Vec<_>>());
+    if n > 0 {
+        assert!(dpkg(&rels.to_string()).is_some(), "after drop_substvar dpkg does not parse {:?}", rels.to_string());
+    }
+}
