+/// `Entry::from(vec![a, b])` builds a real pipe: removing an alternative afterwards leaves a
+/// clean entry (bug debian-control/7).
+#[hegel::test]
+fn built_entries_have_real_pipes(tc: hegel::TestCase) {
+    let n = tc.draw(int!(2usize, 3));
+    let rels: Vec<GenRelation> = (0..n).map(|_| { let mut r = tc.draw(arb_relation(false).print_as_debug()); r.text = r.dpkg_shape(); r }).collect();
+    let entry = Entry::from(rels.iter().map(gen_to_relation).collect::<Vec<_>>());
+    let text = entry.to_string();
+    assert_eq!(text, rels.iter().map(|r| r.text.clone()).collect::<Vec<_>>().join(" | "));
+    let k = tc.draw(int!(0usize, n - 1));
+    entry.remove_relation(k);
+    let expected: Vec<String> = rels.iter().enumerate().filter(|(i, _)| *i != k).map(|(_, r)| r.text.clone()).collect();
+    assert_eq!(entry.to_string(), expected.join(" | "), "after removing alternative {k} of {text:?}");
+    let mut e2 = Entry::from(rels.iter().map(gen_to_relation).collect::<Vec<_>>());
+    e2.push(Relation::simple("zzz"));
+    assert_eq!(e2.to_string(), format!("{text} | zzz"));
+}
