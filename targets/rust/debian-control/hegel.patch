+/// `ensure_minimum_version` / `ensure_exact_version` keep the relation's qualifier,
+/// architectures and profiles (bug debian-control/9).
+#[hegel::test]
+fn ensure_version_keeps_qualifiers(tc: hegel::TestCase) {
+    let mut r = tc.draw(arb_relation(false).print_as_debug());
+    if r.archqual.is_none() && r.arches.is_none() && r.profiles.is_none() {
+        r.archqual = Some("any".into());
+    }
+    if r.negated_arches() {
+        r.arches = None;
+        if r.archqual.is_none() && r.profiles.is_none() {
+            r.archqual = Some("native".into());
+        }
+    }
+    r.text = r.dpkg_shape();
+    let v: Version = tc.draw(arb_version()).parse().unwrap();
+    let exact = tc.draw(int!(0u8, 1)) == 0;
+    let mut rels = Relations::from_str(&r.text).unwrap();
+    if exact {
+        rels.ensure_exact_version(&r.name, &v);
+    } else {
+        rels.ensure_minimum_version(&r.name, &v);
+    }
+    let out = rels.to_string();
+    let d = dpkg(&out).unwrap();
+    let s = &d.entries[0][0];
+    assert_eq!(s.archqual, r.archqual, "qualifier after ensure on {:?}: {out:?}", r.text);
+    assert_eq!(s.arches, r.arches, "architectures after ensure on {:?}: {out:?}", r.text);
+    assert_eq!(s.restrictions, r.profiles, "profiles after ensure on {:?}: {out:?}", r.text);
+}
