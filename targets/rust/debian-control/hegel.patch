+/// `Entry`/`Relation` `FromStr` are the single-entry / single-relation views of `Relations`.
+#[hegel::test]
+fn entry_and_relation_from_str_are_views(tc: hegel::TestCase) {
+    let g = tc.draw(arb_relations(false).print_as_debug());
+    if hits_rparen_bug(&g) {
+        return;
+    }
+    let rels = Relations::from_str(&g.text).unwrap();
+    for (e, ge) in rels.entries().zip(&g.entries) {
+        let text = e.to_string();
+        let parsed = Entry::from_str(&text).unwrap_or_else(|err| panic!("entry {text:?}: {err}"));
+        assert_eq!(parsed, e);
+        assert_eq!(parsed.len(), ge.len());
+        for (r, gr) in e.relations().zip(ge) {
+            let parsed = Relation::from_str(&r.to_string()).unwrap_or_else(|err| panic!("relation {:?}: {err}", r.to_string()));
+            assert_eq!(parsed, r);
+            assert_eq!(parsed.try_name().as_deref(), Some(gr.name.as_str()));
+        }
+        if ge.len() > 1 {
+            assert!(Relation::from_str(&text).is_err());
+        }
+    }
+    if g.entries.len() > 1 {
+        assert!(Entry::from_str(&g.text).is_err());
+    }
+}
