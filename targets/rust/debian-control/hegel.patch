+//! Hegel property tests for debian-control's upload-side files: the lossless
+//! `Changes` (`.changes`) and `Buildinfo` (`.buildinfo`) paragraphs, the
+//! checksum entry types (`Md5Checksum`, `Sha1Checksum`, `Sha256Checksum`,
+//! `Sha512Checksum`, `changes::File`) and `pgp::strip_pgp_signature`.
+//!
+//! References: **dpkg's `Dpkg::Control`** with the matching file type
+//! (`CTRL_FILE_CHANGES` / `CTRL_FILE_BUILDINFO`: the field values dpkg reads,
+//! its OpenPGP handling, `field_is_allowed_in` for the model's field set),
+//! **python-debian's `Changes`** (`Files`/`Checksums-*` entries and
+//! `get_pool_path`) and `Deb822.split_gpg_and_payload`, **gpg** (real
+//! clearsigned files, one ephemeral key per test process), and the layout
+//! `dpkg-genchanges` / `dpkg-genbuildinfo` write as the generated model.
+//! The relations and `debian/control` parsers are covered by `tests/hegel.rs`
+//! and `tests/hegel_control.rs`.
+
+use debian_control::fields::{Md5Checksum, Sha1Checksum, Sha256Checksum, Sha512Checksum, Urgency};
+use debian_control::lossless::buildinfo::Buildinfo;
+use debian_control::lossless::changes::{Changes, File};
+use debian_control::lossless::relations::Relations;
+use debian_control::pgp::strip_pgp_signature;
+use debian_control::Priority;
+use hegel::generators;
+use hegel::Generator;
+use rowan::ast::AstNode;
+use std::collections::HashMap;
+use std::fmt::Debug;
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::str::FromStr;
+use std::sync::{Mutex, OnceLock};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+// ---------------------------------------------------------------------------
+// Oracles: dpkg, python-debian, gpg
+// ---------------------------------------------------------------------------
+
+const PERL_SCRIPT: &str = r#"
+use strict; use warnings;
+use Dpkg::Control;
+use Dpkg::Control::Types;
+use Dpkg::Control::FieldsCore;
+use JSON::PP;
+$| = 1;
+my $json = JSON::PP->new->canonical;
+my %TYPES = (changes => CTRL_FILE_CHANGES, buildinfo => CTRL_FILE_BUILDINFO);
+while (my $line = <STDIN>) {
+    chomp $line;
+    my ($cmd, @args) = split / /, $line;
+    my @a = map { pack('H*', $_) } @args;
+    if ($cmd eq 'C') {
+        my ($type, $text) = @a;
+        my ($fields, $signed, $err);
+        eval {
+            local $SIG{__WARN__} = sub {};
+            my $c = Dpkg::Control->new(type => $TYPES{$type});
+            open my $fh, '<', \$text or die;
+            $c->parse($fh, 'x');
+            $fields = { map { $_ => $c->{$_} } keys %$c };
+            $signed = $c->get_option('is_pgp_signed') ? JSON::PP::true : JSON::PP::false;
+        };
+        if ($@) { $err = "$@"; }
+        print $json->encode({ fields => $fields, signed => $signed, err => $err }), "\n";
+    } elsif ($cmd eq 'A') {
+        my ($type, $field) = @a;
+        print $json->encode({ allowed => (field_is_allowed_in($field, $TYPES{$type}) ? JSON::PP::true : JSON::PP::false) }), "\n";
+    } else {
+        print "{}\n";
+    }
+}
+"#;
+
+const PYTHON_SCRIPT: &str = r#"
+import sys, json, binascii
+from debian.deb822 import Changes, Deb822
+for line in sys.stdin:
+    parts = line.rstrip("\n").split(" ")
+    cmd, args = parts[0], [binascii.unhexlify(a) for a in parts[1:]]
+    out = {}
+    try:
+        if cmd == "F":
+            c = Changes(args[0].splitlines(True))
+            plain = lambda entries: None if entries is None else [dict(e) for e in entries]
+            out["source"] = c.get("Source")
+            out["files"] = plain(c.get("Files"))
+            out["sha1"] = plain(c.get("Checksums-Sha1"))
+            out["sha256"] = plain(c.get("Checksums-Sha256"))
+            out["binary"] = c.get("Binary")
+            try:
+                out["pool"] = c.get_pool_path()
+            except Exception as e:
+                out["pool_err"] = type(e).__name__
+        elif cmd == "G":
+            pre, payload, post = Deb822.split_gpg_and_payload(args[0].splitlines(True))
+            out["pre"] = [p.decode("utf-8", "replace") for p in pre]
+            out["payload"] = [p.decode("utf-8", "replace") for p in payload]
+            out["post"] = [p.decode("utf-8", "replace") for p in post]
+    except Exception as e:
+        out["err"] = "%s: %s" % (type(e).__name__, e)
+    sys.stdout.write(json.dumps(out) + "\n")
+    sys.stdout.flush()
+"#;
+
+struct Child2 {
+    _child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+fn spawn(program: &str, args: &[&str]) -> Child2 {
+    let mut child = Command::new(program)
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap_or_else(|e| panic!("cannot start {program}: {e}"));
+    let stdin = child.stdin.take().unwrap();
+    let stdout = BufReader::new(child.stdout.take().unwrap());
+    Child2 { _child: child, stdin, stdout }
+}
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|b| format!("{b:02x}")).collect()
+}
+
+fn ask(c: &mut Child2, cmd: &str, args: &[&str]) -> serde_json::Value {
+    let mut line = cmd.to_string();
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a));
+    }
+    writeln!(c.stdin, "{line}").unwrap();
+    c.stdin.flush().unwrap();
+    let mut reply = String::new();
+    c.stdout.read_line(&mut reply).unwrap();
+    assert!(!reply.is_empty(), "{cmd}: oracle child died");
+    serde_json::from_str(&reply).unwrap_or_else(|e| panic!("bad oracle reply {reply:?}: {e}"))
+}
+
+fn perl() -> &'static Mutex<Child2> {
+    static P: OnceLock<Mutex<Child2>> = OnceLock::new();
+    P.get_or_init(|| Mutex::new(spawn("perl", &["-e", PERL_SCRIPT])))
+}
+
+fn python() -> &'static Mutex<Child2> {
+    static P: OnceLock<Mutex<Child2>> = OnceLock::new();
+    // `/usr/bin/python3` is the interpreter python-debian is installed for.
+    P.get_or_init(|| Mutex::new(spawn("/usr/bin/python3", &["-c", PYTHON_SCRIPT])))
+}
+
+type Fields = Vec<(String, String)>;
+
+/// dpkg's reading of a `.changes`/`.buildinfo` text: sorted fields and whether
+/// it saw an OpenPGP signature.
+fn dpkg_read(kind: &str, text: &str) -> Result<(Fields, bool), String> {
+    let mut c = perl().lock().unwrap_or_else(|e| e.into_inner());
+    let v = ask(&mut c, "C", &[kind, text]);
+    if let Some(e) = v["err"].as_str() {
+        return Err(e.to_string());
+    }
+    let mut f: Fields = v["fields"].as_object().unwrap().iter().map(|(k, v)| (k.clone(), v.as_str().unwrap().to_string())).collect();
+    f.sort();
+    Ok((f, v["signed"].as_bool().unwrap()))
+}
+
+fn dpkg_allows(kind: &str, field: &str) -> bool {
+    let mut c = perl().lock().unwrap_or_else(|e| e.into_inner());
+    ask(&mut c, "A", &[kind, field])["allowed"].as_bool().unwrap()
+}
+
+fn python_changes(text: &str) -> serde_json::Value {
+    let mut c = python().lock().unwrap_or_else(|e| e.into_inner());
+    ask(&mut c, "F", &[text])
+}
+
+fn python_split_gpg(text: &str) -> serde_json::Value {
+    let mut c = python().lock().unwrap_or_else(|e| e.into_inner());
+    ask(&mut c, "G", &[text])
+}
+
+/// Clearsigned copies of a fixed pool of `.changes` texts, signed once per
+/// process with an ephemeral gpg key.
+fn signed_pool() -> &'static Vec<(String, String)> {
+    static POOL: OnceLock<Vec<(String, String)>> = OnceLock::new();
+    POOL.get_or_init(|| {
+        let home = std::env::temp_dir().join(format!("hegel-zoo-gpg-{}", std::process::id()));
+        std::fs::create_dir_all(&home).unwrap();
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::set_permissions(&home, std::fs::Permissions::from_mode(0o700)).unwrap();
+        }
+        let gen = Command::new("gpg")
+            .env("GNUPGHOME", &home)
+            .args(["--batch", "--quiet", "--passphrase", "", "--quick-gen-key", "Zoo <zoo@example.com>", "ed25519", "sign", "0"])
+            .stderr(Stdio::null())
+            .status()
+            .expect("gpg is installed");
+        assert!(gen.success(), "gpg key generation");
+        let pool = SIGNED_PAYLOADS
+            .iter()
+            .map(|payload| {
+                let mut child = Command::new("gpg")
+                    .env("GNUPGHOME", &home)
+                    .args(["--batch", "--quiet", "--clearsign", "-u", "zoo@example.com"])
+                    .stdin(Stdio::piped())
+                    .stdout(Stdio::piped())
+                    .stderr(Stdio::null())
+                    .spawn()
+                    .unwrap();
+                child.stdin.take().unwrap().write_all(payload.as_bytes()).unwrap();
+                let out = child.wait_with_output().unwrap();
+                assert!(out.status.success(), "gpg --clearsign");
+                (payload.to_string(), String::from_utf8(out.stdout).unwrap())
+            })
+            .collect();
+        let _ = Command::new("gpgconf").env("GNUPGHOME", &home).args(["--kill", "all"]).stderr(Stdio::null()).status();
+        let _ = std::fs::remove_dir_all(&home);
+        pool
+    })
+}
+
+const SIGNED_PAYLOADS: &[&str] = &[
+    "Format: 1.8\nSource: foo\nBinary: foo\nArchitecture: all\nVersion: 1.0-1\nDistribution: unstable\nUrgency: medium\nMaintainer: Zoo <zoo@example.com>\nDescription:\n foo - short\nChanges:\n foo (1.0-1) unstable; urgency=medium\n .\n   * Initial release.\nFiles:\n d41d8cd98f00b204e9800998ecf8427e 0 misc optional foo_1.0-1_all.deb\n",
+    "Format: 1.8\nSource: bar\nVersion: 2:1.2.3~rc1-4\nMaintainer: Zoë Ünïcode <z@example.com>\nChanges:\n bar (2:1.2.3~rc1-4) experimental; urgency=low\n .\n   * Dash - in the middle, and a line\n   - starting with a dash after the indent.\n",
+    "Source: baz\nBinary: baz libbaz1 libbaz-dev\nArchitecture: amd64 source\nChecksums-Sha256:\n e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 0 baz_1.0.orig.tar.gz\n",
+    "Format: 1.8\nSource: qux\nCloses: 123 456\nDescription:\n qux - a\n qux-doc - b\n",
+    "A: 1\n",
+    "Long: line line line line line line line line line line line line line line line line line line line line line line line line line line line line line line line line line line line\nTab:\tvalue\n",
+];
+
+// ---------------------------------------------------------------------------
+// Model and generators
+// ---------------------------------------------------------------------------
+
+fn pick<T: Clone + Send + Sync + Debug + 'static>(tc: &hegel::TestCase, items: &[T]) -> T {
+    tc.draw(generators::sampled_from(items.to_vec()).print_as_debug())
+}
+
+fn opt<T>(tc: &hegel::TestCase, f: impl FnOnce(&hegel::TestCase) -> T) -> Option<T> {
+    if tc.draw(generators::booleans()) {
+        Some(f(tc))
+    } else {
+        None
+    }
+}
+
+const SOURCES: &[&str] = &["foo", "bar1", "python-baz", "a.b+c", "zzz"];
+const PEOPLE: &[&str] = &["John Doe <john@example.com>", "A. Maintainer <am@debian.org>", "Zoë Ünïcode <z@example.com>"];
+const SECTIONS: &[&str] = &["misc", "libs", "python", "contrib/net", "non-free/utils"];
+const ARCHES: &[&str] = &["all", "amd64", "source", "i386"];
+const VERSIONS: &[&str] = &["1.0-1", "2:1.2.3~rc1-4", "0.1", "1.0+dfsg-2ubuntu1", "3.14.15-9.2"];
+const DISTS: &[&str] = &["unstable", "experimental", "bookworm-security", "UNRELEASED"];
+const DATES: &[&str] = &["Mon, 14 Sep 2026 00:00:00 +0000", "Tue, 01 Jan 2030 23:59:59 -0500", "Thu, 02 Jan 2020 12:00:00 +0100"];
+const WORDS: &[&str] = &["Fix", "widget", "frobnication", "speeds", "on", "mips/mipsel", "(etch)", "a:b", "very-long-word-to-fill-the-line", "#42"];
+const PRIORITIES: &[Priority] = &[Priority::Required, Priority::Important, Priority::Standard, Priority::Optional, Priority::Extra];
+
+fn arb_words(tc: &hegel::TestCase, min: i64, max: i64) -> String {
+    let n = tc.draw(int!(min, max)) as usize;
+    (0..n).map(|_| pick(tc, WORDS).to_string()).collect::<Vec<_>>().join(" ")
+}
+
+fn arb_hex(tc: &hegel::TestCase, len: usize) -> String {
+    (0..len).map(|_| pick(tc, &"0123456789abcdef".chars().collect::<Vec<_>>())).collect()
+}
+
+fn arb_filename(tc: &hegel::TestCase, source: &str, version: &str) -> String {
+    let v = version.split_once(':').map(|(_, v)| v).unwrap_or(version);
+    match tc.draw(int!(0, 3)) {
+        0 => format!("{source}_{v}.dsc"),
+        1 => format!("{source}_{v}_{}.deb", pick(tc, ARCHES)),
+        2 => format!("{source}_{}.orig.tar.xz", v.split_once('-').map(|(u, _)| u).unwrap_or(v)),
+        _ => format!("{source}_{v}_{}.buildinfo", pick(tc, ARCHES)),
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+struct Sum {
+    hash: String,
+    size: u64,
+    filename: String,
+}
+
+impl Sum {
+    fn line(&self) -> String {
+        format!("{} {} {}", self.hash, self.size, self.filename)
+    }
+}
+
+fn arb_sums(tc: &hegel::TestCase, hex_len: usize, filenames: &[String]) -> Vec<Sum> {
+    filenames.iter().map(|f| Sum { hash: arb_hex(tc, hex_len), size: tc.draw(int!(0, 1i64 << 40)) as u64, filename: f.clone() }).collect()
+}
+
+#[derive(Debug, Clone, PartialEq)]
+struct GenFile {
+    md5: String,
+    size: u64,
+    section: String,
+    priority: Priority,
+    filename: String,
+}
+
+impl GenFile {
+    fn line(&self) -> String {
+        format!("{} {} {} {} {}", self.md5, self.size, self.section, self.priority, self.filename)
+    }
+}
+
+/// A `.changes` file as dpkg-genchanges writes it (fields in dpkg's order,
+/// list fields as one entry per continuation line).
+#[derive(Debug, Clone)]
+struct GenChanges {
+    date: String,
+    source: String,
+    binary: Vec<String>,
+    architecture: Vec<String>,
+    version: String,
+    distribution: String,
+    urgency: Urgency,
+    maintainer: String,
+    changed_by: Option<String>,
+    description: Vec<(String, String)>,
+    closes: Option<Vec<u32>>,
+    changes: Vec<String>,
+    sha1: Vec<Sum>,
+    sha256: Vec<Sum>,
+    files: Vec<GenFile>,
+}
+
+fn multi(lines: Vec<String>) -> String {
+    lines.iter().map(|l| format!("\n{l}")).collect()
+}
+
+impl GenChanges {
+    fn fields(&self) -> Fields {
+        let mut f: Fields = vec![
+            ("Format".into(), "1.8".into()),
+            ("Date".into(), self.date.clone()),
+            ("Source".into(), self.source.clone()),
+            ("Binary".into(), self.binary.join(" ")),
+            ("Architecture".into(), self.architecture.join(" ")),
+            ("Version".into(), self.version.clone()),
+            ("Distribution".into(), self.distribution.clone()),
+            ("Urgency".into(), self.urgency.to_string()),
+            ("Maintainer".into(), self.maintainer.clone()),
+        ];
+        if let Some(c) = &self.changed_by {
+            f.push(("Changed-By".into(), c.clone()));
+        }
+        f.push(("Description".into(), multi(self.description.iter().map(|(p, s)| format!("{p} - {s}")).collect())));
+        if let Some(c) = &self.closes {
+            f.push(("Closes".into(), c.iter().map(|n| n.to_string()).collect::<Vec<_>>().join(" ")));
+        }
+        f.push(("Changes".into(), multi(self.changes.iter().map(|l| if l.is_empty() { ".".to_string() } else { l.clone() }).collect())));
+        f.push(("Checksums-Sha1".into(), multi(self.sha1.iter().map(Sum::line).collect())));
+        f.push(("Checksums-Sha256".into(), multi(self.sha256.iter().map(Sum::line).collect())));
+        f.push(("Files".into(), multi(self.files.iter().map(GenFile::line).collect())));
+        f
+    }
+    fn text(&self) -> String {
+        render(&self.fields())
+    }
+    /// python-debian's `get_pool_path`.
+    fn pool_path(&self) -> String {
+        let section = self.files[0].section.split_once('/').map(|(s, _)| s).unwrap_or("main");
+        let subdir = if self.source.starts_with("lib") { &self.source[..4] } else { &self.source[..1] };
+        format!("pool/{section}/{subdir}/{}", self.source)
+    }
+}
+
+/// Render fields; a value starting with `\n` is a list field whose entries
+/// each go on their own continuation line (`Key:\n entry`).
+fn render(fields: &Fields) -> String {
+    let mut s = String::new();
+    for (k, v) in fields {
+        s.push_str(k);
+        s.push(':');
+        let mut lines = v.split('\n');
+        let first = lines.next().unwrap();
+        if !first.is_empty() {
+            s.push(' ');
+            s.push_str(first);
+        }
+        s.push('\n');
+        for l in lines {
+            s.push(' ');
+            s.push_str(l);
+            s.push('\n');
+        }
+    }
+    s
+}
+
+/// dpkg's view: the same values (a list field's value keeps its leading `\n`),
+/// with a `.` line decoded to an empty line.
+fn as_dpkg(fields: &Fields) -> Fields {
+    let mut f: Fields = fields
+        .iter()
+        .map(|(k, v)| (k.clone(), v.split('\n').map(|l| if l == "." { "" } else { l }).collect::<Vec<_>>().join("\n")))
+        .collect();
+    f.sort();
+    f
+}
+
+#[hegel::composite]
+fn arb_changes(tc: &hegel::TestCase) -> GenChanges {
+    // Sources starting with `lib` are pinned (pool path); the pool of names has none.
+    let source = pick(tc, SOURCES).to_string();
+    let version = pick(tc, VERSIONS).to_string();
+    let n_bin = tc.draw(int!(1, 3)) as usize;
+    let mut binary = vec![source.clone()];
+    for _ in 1..n_bin {
+        let b = format!("{source}-{}", pick(tc, &["dev", "doc", "utils"]));
+        if !binary.contains(&b) {
+            binary.push(b);
+        }
+    }
+    let n_arch = tc.draw(int!(1, 2)) as usize;
+    let mut architecture: Vec<String> = Vec::new();
+    for _ in 0..n_arch {
+        let a = pick(tc, ARCHES).to_string();
+        if !architecture.contains(&a) {
+            architecture.push(a);
+        }
+    }
+    let n_files = tc.draw(int!(1, 3)) as usize;
+    let mut filenames: Vec<String> = Vec::new();
+    for _ in 0..n_files {
+        let f = arb_filename(tc, &source, &version);
+        if !filenames.contains(&f) {
+            filenames.push(f);
+        }
+    }
+    let description = binary.iter().map(|b| (b.clone(), arb_words(tc, 1, 4))).collect();
+    let n_changes = tc.draw(int!(1, 4)) as usize;
+    let changes: Vec<String> = (0..n_changes)
+        .map(|i| match (i, tc.draw(int!(0, 3))) {
+            (0, _) => format!("{source} ({version}) unstable; urgency=medium"),
+            (_, 0) => String::new(),
+            (_, 1) => format!("  * {}", arb_words(tc, 1, 5)),
+            _ => format!("  - {}", arb_words(tc, 1, 3)),
+        })
+        .collect();
+    let files = filenames
+        .iter()
+        .map(|f| GenFile { md5: arb_hex(tc, 32), size: tc.draw(int!(0, 1i64 << 40)) as u64, section: pick(tc, SECTIONS).to_string(), priority: pick(tc, PRIORITIES), filename: f.clone() })
+        .collect();
+    GenChanges {
+        date: pick(tc, DATES).to_string(),
+        source,
+        binary,
+        architecture,
+        version,
+        distribution: pick(tc, DISTS).to_string(),
+        urgency: pick(tc, &[Urgency::Low, Urgency::Medium, Urgency::High, Urgency::Emergency, Urgency::Critical]),
+        maintainer: pick(tc, PEOPLE).to_string(),
+        changed_by: opt(tc, |tc| pick(tc, PEOPLE).to_string()),
+        description,
+        closes: opt(tc, |tc| (0..tc.draw(int!(1, 3))).map(|_| tc.draw(int!(1, 1_100_000)) as u32).collect()),
+        changes,
+        sha1: arb_sums(tc, 40, &filenames),
+        sha256: arb_sums(tc, 64, &filenames),
+        files,
+    }
+}
+
+fn check_changes(c: &Changes, g: &GenChanges) {
+    assert_eq!(c.format(), Some("1.8".to_string()));
+    assert_eq!(c.source(), Some(g.source.clone()));
+    assert_eq!(c.binary(), Some(g.binary.clone()));
+    assert_eq!(c.architecture(), Some(g.architecture.clone()));
+    assert_eq!(c.version().map(|v| v.to_string()), Some(g.version.clone()));
+    assert_eq!(c.distribution(), Some(g.distribution.clone()));
+    assert_eq!(c.urgency(), Some(g.urgency.clone()));
+    assert_eq!(c.maintainer(), Some(g.maintainer.clone()));
+    assert_eq!(c.changed_by(), g.changed_by);
+    // The leading empty line of a list field is not kept (deb822-lossless/2).
+    let description: Vec<String> = g.description.iter().map(|(p, s)| format!("{p} - {s}")).collect();
+    assert_eq!(c.description(), Some(description.join("\n")), "description");
+    let sha1: Vec<Sha1Checksum> = g.sha1.iter().map(|s| Sha1Checksum { sha1: s.hash.clone(), size: s.size as usize, filename: s.filename.clone() }).collect();
+    assert_eq!(c.checksums_sha1(), Some(sha1));
+    let sha256: Vec<Sha256Checksum> = g.sha256.iter().map(|s| Sha256Checksum { sha256: s.hash.clone(), size: s.size as usize, filename: s.filename.clone() }).collect();
+    assert_eq!(c.checksums_sha256(), Some(sha256));
+    let files: Vec<File> = g.files.iter().map(|f| File { md5sum: f.md5.clone(), size: f.size as usize, section: f.section.clone(), priority: f.priority.clone(), filename: f.filename.clone() }).collect();
+    assert_eq!(c.files(), Some(files));
+    assert_eq!(c.get_pool_path(), Some(g.pool_path()), "pool path");
+}
