+// --------------------------------------------------------------------------- implication
+
+#[hegel::composite]
+fn arb_same_package_pair(tc: &hegel::TestCase) -> (GenRelation, GenRelation) {
+    let mut a = tc.draw(arb_relation(false).print_as_debug());
+    let mut b = tc.draw(arb_relation(false).print_as_debug());
+    b.name = a.name.clone();
+    // Often share the version so the boundary cases (equal versions) are reached.
+    if tc.draw(int!(0u8, 1)) == 0 {
+        if let (Some((_, va)), Some((ob, _))) = (&a.version, &b.version) {
+            b.version = Some((ob.clone(), va.clone()));
+        }
+    }
+    // Sometimes share the qualifiers so that dpkg gets past its superset checks.
+    if tc.draw(int!(0u8, 1)) == 0 {
+        b.archqual = a.archqual.clone();
+        b.arches = a.arches.clone();
+        b.profiles = a.profiles.clone();
+    }
+    for r in [&mut a, &mut b] {
+        r.text = r.dpkg_shape();
+        r.newline = false;
+    }
+    (a, b)
+}
+
+fn plain(r: &GenRelation) -> bool {
+    r.archqual.is_none() && r.arches.is_none() && r.profiles.is_none()
+}
+
+/// `Relation::is_implied_by` claims exactly the implications dpkg's `implies` proves, for
+/// relations without qualifiers (versions only).
+#[hegel::test]
+fn version_implication_agrees_with_dpkg(tc: hegel::TestCase) {
+    let (mut inner, mut outer) = tc.draw(arb_same_package_pair().print_as_debug());
+    for r in [&mut inner, &mut outer] {
+        r.archqual = None;
+        r.arches = None;
+        r.profiles = None;
+        r.text = r.dpkg_shape();
+    }
+    if hits_strict_implication_bug(&inner, &outer) {
+        return;
+    }
+    let d = dpkg_implies(&outer.text, &inner.text).unwrap();
+    let i = Relation::from_str(&inner.text).unwrap();
+    let o = Relation::from_str(&outer.text).unwrap();
+    assert_eq!(i.is_implied_by(&o), d == Some(true), "{:?} implied by {:?}: dpkg says {d:?}", inner.text, outer.text);
+    // A relation implies itself.
+    assert!(i.is_implied_by(&i));
+}
+
+/// Bug debian-control/15: `pkg (>> V)` is not seen to imply `pkg (>= V)`.
+fn hits_strict_implication_bug(inner: &GenRelation, outer: &GenRelation) -> bool {
+    inner.name == outer.name
+        && matches!((&inner.version, &outer.version), (Some((i, vi)), Some((o, vo)))
+            if i == ">=" && o == ">>" && vi.parse::<Version>().unwrap() == vo.parse::<Version>().unwrap())
+}
+
+/// `pkg (>> V)` implies `pkg (>= V)`, as `pkg (<< V)` implies `pkg (<= V)` (bug debian-control/15).
+#[hegel::test]
+fn strictly_greater_implies_at_least(tc: hegel::TestCase) {
+    let name = tc.draw(arb_name());
+    let v = tc.draw(arb_version());
+    let inner_text = format!("{name} (>= {v})");
+    let outer_text = format!("{name} (>> {v})");
+    assert_eq!(dpkg_implies(&outer_text, &inner_text).unwrap(), Some(true));
+    let i = Relation::from_str(&inner_text).unwrap();
+    let o = Relation::from_str(&outer_text).unwrap();
+    assert!(i.is_implied_by(&o), "{inner_text:?} not implied by {outer_text:?}");
+    // The mirror image, which the crate gets right.
+    let i2 = Relation::from_str(&format!("{name} (<= {v})")).unwrap();
+    let o2 = Relation::from_str(&format!("{name} (<< {v})")).unwrap();
+    assert!(i2.is_implied_by(&o2));
+}
+
+/// With architecture qualifiers, architecture lists and build profiles, an implication the
+/// crate claims must be one dpkg proves (bug debian-control/4: qualifiers are ignored).
+#[hegel::test]
+fn qualified_implication_agrees_with_dpkg(tc: hegel::TestCase) {
+    let (inner, outer) = tc.draw(arb_same_package_pair().print_as_debug());
+    if plain(&inner) && plain(&outer) {
+        return;
+    }
+    if inner.negated_arches() || outer.negated_arches() {
+        return;
+    }
+    let d = dpkg_implies(&outer.text, &inner.text).unwrap();
+    let i = Relation::from_str(&inner.text).unwrap();
+    let o = Relation::from_str(&outer.text).unwrap();
+    assert_eq!(i.is_implied_by(&o), d == Some(true), "{:?} implied by {:?}: dpkg says {d:?}", inner.text, outer.text);
+}
+
+/// An alternative group is implied by another only as dpkg proves it: `a` is not implied by
+/// `a | b` (bug debian-control/5).
+#[hegel::test]
+fn entry_implication_agrees_with_dpkg(tc: hegel::TestCase) {
+    let n = tc.draw(int!(2usize, 3));
+    let names: Vec<String> = (0..n).map(|i| format!("{}{i}", tc.draw(arb_name()))).collect();
+    let make = |k: usize| -> (String, Vec<GenRelation>) {
+        let mut rels = Vec::new();
+        for i in 0..k {
+            let mut r = tc.draw(arb_relation(false).print_as_debug());
+            r.name = names[i].clone();
+            r.archqual = None;
+            r.arches = None;
+            r.profiles = None;
+            r.text = r.dpkg_shape();
+            rels.push(r);
+        }
+        (rels.iter().map(|r| r.text.clone()).collect::<Vec<_>>().join(" | "), rels)
+    };
+    let (inner_text, inner_rels) = make(tc.draw(int!(1usize, names.len())));
+    let (outer_text, outer_rels) = make(tc.draw(int!(1usize, names.len())));
+    if inner_rels.iter().any(|i| outer_rels.iter().any(|o| hits_strict_implication_bug(i, o))) {
+        return;
+    }
+    let d = dpkg_implies(&outer_text, &inner_text).unwrap();
+    let i = Entry::from_str(&inner_text).unwrap();
+    let o = Entry::from_str(&outer_text).unwrap();
+    let claimed = i.is_implied_by(&o);
+    if claimed && d != Some(true) && o.len() > 1 {
+        // Bug debian-control/5: any-to-any instead of dpkg's every-outer-member rule.
+        return;
+    }
+    assert_eq!(claimed, d == Some(true), "{inner_text:?} implied by {outer_text:?}: dpkg says {d:?}");
+}
+
+/// `a (>= 1)` is not implied by `a (>= 2) | b` — installing `b` satisfies the outer entry
+/// without `a` (bug debian-control/5, the crate's own doc example claims the opposite).
+#[hegel::test]
+fn a_single_relation_is_not_implied_by_an_alternative_group(tc: hegel::TestCase) {
+    let a = tc.draw(arb_name());
+    let mut b = tc.draw(arb_name());
+    if b == a {
+        b.push('0');
+    }
+    let inner_text = a.clone();
+    let outer_text = format!("{a} | {b}");
+    let d = dpkg_implies(&outer_text, &inner_text).unwrap();
+    assert_ne!(d, Some(true));
+    let i = Entry::from_str(&inner_text).unwrap();
+    let o = Entry::from_str(&outer_text).unwrap();
+    assert!(!i.is_implied_by(&o), "{inner_text:?} claimed implied by {outer_text:?}");
+    // And therefore ensure_relation must add it.
+    let mut rels = Relations::from_str(&outer_text).unwrap();
+    assert!(rels.ensure_relation(Entry::from_str(&inner_text).unwrap()), "ensure_relation({inner_text:?}) on {outer_text:?} did nothing");
+    assert!(rels.get_relation(&a).is_ok() || rels.iter_relations_for(&a).count() == 2, "{}", rels);
+}
