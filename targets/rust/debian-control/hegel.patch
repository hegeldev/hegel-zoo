+//! Hegel property tests for debian-control's `debian/control` layer: the
+//! lossless `Control`/`Source`/`Binary` (over deb822-lossless), the lossy
+//! `Control` (deb822-fast derive), the typed field values (`fields.rs`) and the
+//! `Vcs-*` parsing (`vcs.rs`).
+//!
+//! References: **dpkg's `Dpkg::Control::Info`** (the parser `dpkg-source` uses
+//! for debian/control, in a persistent Perl child) for the field values and
+//! the structural rules; **lintian's `Vcs-*` regexes** (`Lintian::Check::Fields::Vcs`,
+//! same child) for the `url -b branch [path]` grammar; Debian Policy §5.2/§5.6
+//! as the generated model; and the two layers against each other.
+//! The relations parsers are covered by `tests/hegel.rs`.
+
+use debian_control::fields::{format_description, MultiArch, PackageListEntry, Priority, StandardsVersion, Urgency};
+use debian_control::lossless::control::{Binary, Control, Source, BINARY_FIELD_ORDER, SOURCE_FIELD_ORDER};
+use debian_control::lossless::relations::Relations;
+use debian_control::vcs::{ParsedVcs, Vcs};
+use hegel::generators;
+use hegel::Generator;
+use std::fmt::Debug;
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::str::FromStr;
+use std::sync::{Mutex, OnceLock};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+// ---------------------------------------------------------------------------
+// Oracles: dpkg and lintian
+// ---------------------------------------------------------------------------
+
+const PERL_SCRIPT: &str = r#"
+use strict; use warnings;
+use Dpkg::Control::Info;
+use JSON::PP;
+$| = 1;
+my $json = JSON::PP->new->canonical;
+# lintian's Lintian::Check::Fields::Vcs extractors
+my %VCS = (
+    Cvs => sub { return shift =~ /^(.+?)(?:\s+(\S*))?$/; },
+    Hg  => sub { return shift =~ /^(.+?)(?:\s+-b\s+(\S*))?$/; },
+    Git => sub { return shift =~ /^(.+?)(?:(?:\s+\[(\S*)\])?(?:\s+-b\s+(\S*))?){0,2}$/; },
+);
+while (my $line = <STDIN>) {
+    chomp $line;
+    my ($cmd, @args) = split / /, $line;
+    my @a = map { pack('H*', $_) } @args;
+    if ($cmd eq 'C') {
+        my ($text) = @a;
+        my ($src, @pkgs, $err);
+        eval {
+            local $SIG{__WARN__} = sub {};
+            my $info = Dpkg::Control::Info->new(filename => undef);
+            open my $fh, '<', \$text or die;
+            $info->parse($fh, 'x');
+            my $s = $info->get_source();
+            $src = { map { $_ => $s->{$_} } keys %$s };
+            for my $p ($info->get_packages()) { push @pkgs, { map { $_ => $p->{$_} } keys %$p }; }
+        };
+        if ($@) { $err = "$@"; }
+        print $json->encode({ source => $src, packages => \@pkgs, err => $err }), "\n";
+    } elsif ($cmd eq 'V') {
+        my ($kind, $value) = @a;
+        my @m = $VCS{$kind}->($value);
+        print $json->encode({ m => [ map { defined $_ ? $_ : undef } @m ] }), "\n";
+    } else {
+        print "{}\n";
+    }
+}
+"#;
+
+struct Child2 {
+    _child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+fn spawn(program: &str, args: &[&str]) -> Child2 {
+    let mut child = Command::new(program)
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap_or_else(|e| panic!("cannot start {program}: {e}"));
+    let stdin = child.stdin.take().unwrap();
+    let stdout = BufReader::new(child.stdout.take().unwrap());
+    Child2 { _child: child, stdin, stdout }
+}
+
+fn hex(s: &str) -> String {
+    s.bytes().map(|b| format!("{b:02x}")).collect()
+}
+
+fn ask(c: &mut Child2, cmd: &str, args: &[&str]) -> serde_json::Value {
+    let mut line = cmd.to_string();
+    for a in args {
+        line.push(' ');
+        line.push_str(&hex(a));
+    }
+    writeln!(c.stdin, "{line}").unwrap();
+    c.stdin.flush().unwrap();
+    let mut reply = String::new();
+    c.stdout.read_line(&mut reply).unwrap();
+    assert!(!reply.is_empty(), "{cmd}: oracle child died");
+    serde_json::from_str(&reply).unwrap_or_else(|e| panic!("bad oracle reply {reply:?}: {e}"))
+}
+
+fn oracle() -> &'static Mutex<Child2> {
+    static P: OnceLock<Mutex<Child2>> = OnceLock::new();
+    P.get_or_init(|| Mutex::new(spawn("perl", &["-e", PERL_SCRIPT])))
+}
+
+type Fields = Vec<(String, String)>;
+
+/// dpkg's reading of a debian/control: (source fields, per-package fields), or
+/// the error message (`first stanza lacks a 'Source' field`, …).
+fn dpkg_control(text: &str) -> Result<(Fields, Vec<Fields>), String> {
+    let mut c = oracle().lock().unwrap_or_else(|e| e.into_inner());
+    let v = ask(&mut c, "C", &[text]);
+    if let Some(e) = v["err"].as_str() {
+        return Err(e.to_string());
+    }
+    let fields = |o: &serde_json::Value| -> Fields {
+        let mut f: Fields = o.as_object().unwrap().iter().map(|(k, v)| (k.clone(), v.as_str().unwrap().to_string())).collect();
+        f.sort();
+        f
+    };
+    let src = fields(&v["source"]);
+    let pkgs = v["packages"].as_array().unwrap().iter().map(fields).collect();
+    Ok((src, pkgs))
+}
+
+/// lintian's extraction of a Vcs value: the captures of its regex.
+fn lintian_vcs(kind: &str, value: &str) -> Vec<Option<String>> {
+    let mut c = oracle().lock().unwrap_or_else(|e| e.into_inner());
+    ask(&mut c, "V", &[kind, value])["m"].as_array().unwrap().iter().map(|x| x.as_str().map(|s| s.to_string())).collect()
+}
+
