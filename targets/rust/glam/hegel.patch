diff --git a/tests/affine3.rs b/tests/affine3.rs
index 46894e2..55bb32f 100644
--- a/tests/affine3.rs
+++ b/tests/affine3.rs
@@ -436,3 +436,140 @@ mod daffine3 {
 
     impl_affine3_tests!(f64, DAffine3, DQuat, DVec3, DMat3, DMat4);
 }
+
+// Hegel property-based tests.
+//
+// `Affine3A` (SIMD-backed Vec3A columns) and `Mat4` (SIMD-backed Vec4
+// columns) implement the same affine transform through different storage and
+// code paths, so building both from identical scale/rotation/translation
+// inputs and comparing their action on points is a sibling-implementation
+// differential. `DAffine3` (always scalar f64) serves as the high-precision
+// oracle for composition.
+#[cfg(not(target_family = "wasm"))]
+mod hegel_props {
+    use glam::{Affine3A, DAffine3, DQuat, DVec3, Mat4, Quat, Vec3};
+    use hegel::generators;
+
+    fn unit_quat(tc: &hegel::TestCase) -> Quat {
+        let c = || generators::floats::<f32>().min_value(-1.0).max_value(1.0);
+        let q = Quat::from_xyzw(tc.draw(c()), tc.draw(c()), tc.draw(c()), tc.draw(c()));
+        // Rejecting near-zero raw quaternions protects the normalization
+        // step of the generator, not a library contract.
+        tc.assume(q.length_squared() > 0.01);
+        q.normalize()
+    }
+
+    /// Scale, rotation and translation with moderate magnitudes (|scale| in
+    /// [0.05, 20], |translation| <= 1e3) so the f64-oracle tolerance below
+    /// stays a faithful error model for the f32 computation.
+    fn srt(tc: &hegel::TestCase) -> (Vec3, Quat, Vec3) {
+        let s = || {
+            let mag = tc.draw(generators::floats::<f32>().min_value(0.05).max_value(20.0));
+            if tc.draw(generators::booleans()) {
+                -mag
+            } else {
+                mag
+            }
+        };
+        let t = || tc.draw(generators::floats::<f32>().min_value(-1e3).max_value(1e3));
+        (
+            Vec3::new(s(), s(), s()),
+            unit_quat(tc),
+            Vec3::new(t(), t(), t()),
+        )
+    }
+
+    fn point(tc: &hegel::TestCase) -> Vec3 {
+        let c = || tc.draw(generators::floats::<f32>().min_value(-1e3).max_value(1e3));
+        Vec3::new(c(), c(), c())
+    }
+
+    fn to_daffine((s, q, t): (Vec3, Quat, Vec3)) -> DAffine3 {
+        DAffine3::from_scale_rotation_translation(
+            s.as_dvec3(),
+            DQuat::from_xyzw(q.x as f64, q.y as f64, q.z as f64, q.w as f64),
+            t.as_dvec3(),
+        )
+    }
+
+    fn assert_close(label: &str, got: Vec3, want: DVec3, tol: f64) {
+        for c in 0..3 {
+            let (g, w) = (got.to_array()[c] as f64, want.to_array()[c]);
+            assert!(
+                (g - w).abs() <= tol,
+                "{}: component {} of {:?} vs f64 oracle {:?} (tol {})",
+                label,
+                c,
+                got,
+                want,
+                tol
+            );
+        }
+    }
+
+    // Property: Affine3A and Mat4 built from the same SRT transform points
+    // identically (within f32 rounding of the shared f64 oracle result).
+    #[hegel::test]
+    fn hegel_affine3a_matches_mat4_transform_point(tc: hegel::TestCase) {
+        let srt_val = srt(&tc);
+        let (s, q, t) = srt_val;
+        let a = Affine3A::from_scale_rotation_translation(s, q, t);
+        let m = Mat4::from_scale_rotation_translation(s, q, t);
+        let p = point(&tc);
+
+        let oracle = to_daffine(srt_val).transform_point3(p.as_dvec3());
+        // Result magnitude <= |s|*|p|*sqrt3 + |t| ~ 4e4; error is a modest
+        // multiple of eps at that magnitude.
+        let scale = 1.0 + oracle.abs().max_element();
+        let tol = 64.0 * f32::EPSILON as f64 * scale;
+
+        assert_close("Affine3A::transform_point3", a.transform_point3(p), oracle, tol);
+        assert_close("Mat4::transform_point3", m.transform_point3(p), oracle, tol);
+        assert_close("Mat4::project_point3", m.project_point3(p), oracle, tol);
+    }
+
+    // Property: composing affine transforms then applying equals applying
+    // them in sequence: (a * b).transform_point3(p) == a.transform(b.transform(p)),
+    // both compared against the f64 oracle of the same computation.
+    #[hegel::test]
+    fn hegel_affine3a_composition_matches_sequential(tc: hegel::TestCase) {
+        let srt_a = srt(&tc);
+        let srt_b = srt(&tc);
+        let a = Affine3A::from_scale_rotation_translation(srt_a.0, srt_a.1, srt_a.2);
+        let b = Affine3A::from_scale_rotation_translation(srt_b.0, srt_b.1, srt_b.2);
+        let p = point(&tc);
+
+        let da = to_daffine(srt_a);
+        let db = to_daffine(srt_b);
+        let oracle = da.transform_point3(db.transform_point3(p.as_dvec3()));
+
+        // Two chained transforms: result magnitude can reach ~1e6 and the
+        // f32 path accumulates rounding across both applications.
+        let scale = 1.0 + oracle.abs().max_element();
+        let tol = 512.0 * f32::EPSILON as f64 * scale;
+
+        let composed = (a * b).transform_point3(p);
+        let sequential = a.transform_point3(b.transform_point3(p));
+        assert_close("(a*b).transform_point3", composed, oracle, tol);
+        assert_close("a.transform(b.transform(p))", sequential, oracle, tol);
+    }
+
+    // Property: for well-conditioned affine transforms, transform_point3
+    // followed by the inverse transform returns to the starting point.
+    #[hegel::test]
+    fn hegel_affine3a_inverse_roundtrips_points(tc: hegel::TestCase) {
+        let srt_val = srt(&tc);
+        let a = Affine3A::from_scale_rotation_translation(srt_val.0, srt_val.1, srt_val.2);
+        let p = point(&tc);
+
+        let there = a.transform_point3(p);
+        let back = a.inverse().transform_point3(there);
+
+        // Error amplification ~ cond(a) = max|scale| / min|scale| <= 400,
+        // applied to point magnitudes up to ~4e4.
+        let mag = 1.0 + p.as_dvec3().abs().max_element()
+            + there.as_dvec3().abs().max_element() / srt_val.0.abs().min_element() as f64;
+        let tol = 64.0 * f32::EPSILON as f64 * mag;
+        assert_close("inverse roundtrip", back, p.as_dvec3(), tol);
+    }
+}
diff --git a/tests/euler.rs b/tests/euler.rs
index b15384b..948a7c7 100644
--- a/tests/euler.rs
+++ b/tests/euler.rs
@@ -289,3 +289,116 @@ mod euler {
         impl_mat_euler_test!(DMat4, f64);
     }
 }
+
+// Hegel property-based tests.
+//
+// The existing euler tests sweep a 15-degree grid; these properties draw
+// arbitrary radian angles (including values between grid points and near the
+// gimbal-lock poles) and any of the 24 rotation orders, checking that
+// quat -> euler -> quat preserves the rotation.
+#[cfg(not(target_family = "wasm"))]
+macro_rules! impl_hegel_euler_props {
+    ($t:ident, $quat:ident, $eps:expr) => {
+        use glam::EulerRot;
+        use hegel::generators;
+        use hegel::Generator;
+
+        fn all_orders() -> Vec<EulerRot> {
+            vec![
+                EulerRot::XYZ,
+                EulerRot::XZY,
+                EulerRot::YZX,
+                EulerRot::YXZ,
+                EulerRot::ZXY,
+                EulerRot::ZYX,
+                EulerRot::XZX,
+                EulerRot::XYX,
+                EulerRot::YXY,
+                EulerRot::YZY,
+                EulerRot::ZYZ,
+                EulerRot::ZXZ,
+                EulerRot::XYZEx,
+                EulerRot::XZYEx,
+                EulerRot::YZXEx,
+                EulerRot::YXZEx,
+                EulerRot::ZXYEx,
+                EulerRot::ZYXEx,
+                EulerRot::XZXEx,
+                EulerRot::XYXEx,
+                EulerRot::YXYEx,
+                EulerRot::YZYEx,
+                EulerRot::ZYZEx,
+                EulerRot::ZXZEx,
+            ]
+        }
+
+        /// q and -q represent the same rotation; canonicalize before
+        /// comparing (same convention as the grid-based tests above).
+        fn canonical(q: $quat) -> $quat {
+            if q.w < 0.0 {
+                -q
+            } else {
+                q
+            }
+        }
+
+        // Property: from_euler -> to_euler -> from_euler reproduces the same
+        // rotation, for any order and any finite angles. The tolerance is
+        // larger than the grid tests' epsilon because extracting euler
+        // angles near the gimbal-lock poles legitimately loses ~half the
+        // significand (sqrt(eps)); the property still pins gross errors such
+        // as wrong axis order or sign flips.
+        #[hegel::test]
+        fn hegel_euler_roundtrip_preserves_rotation(tc: hegel::TestCase) {
+            let order = tc.draw((generators::sampled_from(all_orders())).print_as_debug());
+            let angle = || {
+                tc.draw(
+                    generators::floats::<$t>()
+                        .allow_nan(false)
+                        .allow_infinity(false),
+                )
+            };
+            let (a, b, c) = (angle(), angle(), angle());
+            let q = $quat::from_euler(order, a, b, c);
+
+            let (i, j, k) = q.to_euler(order);
+            assert!(
+                i.is_finite() && j.is_finite() && k.is_finite(),
+                "to_euler({:?}) returned non-finite angles ({}, {}, {}) for {:?}",
+                order,
+                i,
+                j,
+                k,
+                q
+            );
+            let q2 = $quat::from_euler(order, i, j, k);
+
+            let (qc, q2c) = (canonical(q), canonical(q2));
+            for (x, y) in qc.to_array().iter().zip(q2c.to_array().iter()) {
+                assert!(
+                    (*x as f64 - *y as f64).abs() <= $eps,
+                    "euler roundtrip changed rotation for order {:?}, angles ({}, {}, {}): \
+                     {:?} vs {:?}",
+                    order,
+                    a,
+                    b,
+                    c,
+                    qc,
+                    q2c
+                );
+            }
+        }
+    };
+}
+
+#[cfg(not(target_family = "wasm"))]
+mod hegel_euler_quat {
+    use glam::Quat;
+    impl_hegel_euler_props!(f32, Quat, 2e-3);
+}
+
+#[cfg(all(not(target_family = "wasm"), feature = "f64"))]
+mod hegel_euler_dquat {
+    use glam::DQuat;
+    impl_hegel_euler_props!(f64, DQuat, 1e-7);
+}
diff --git a/tests/mat3.rs b/tests/mat3.rs
index b71f0ab..704f064 100644
--- a/tests/mat3.rs
+++ b/tests/mat3.rs
@@ -609,3 +609,137 @@ mod dmat3 {
     impl_mat3_tests!(f64, dmat3, DMat3, DMat2, DMat4, DQuat, dvec3, DVec3, DVec2);
     impl_as_ref_tests!(DMat3);
 }
+
+// Hegel property-based tests.
+//
+// `Mat3` uses scalar `Vec3` columns while `Mat3A` uses SIMD-backed `Vec3A`
+// columns, so building both from the same components and comparing results is
+// a direct SIMD-vs-scalar backend differential within a single build.
+#[cfg(not(target_family = "wasm"))]
+mod hegel_props {
+    use glam::{Mat3, Mat3A, Vec3};
+    use hegel::generators;
+
+    /// Finite f32 with |x| <= 1e3. The bound keeps intermediate products of
+    /// the 3x3 determinant / adjugate (products of up to three elements plus
+    /// sums) far from overflow so the tolerance analysis below is valid; it
+    /// protects the property's error model, not a library contract.
+    fn component(tc: &hegel::TestCase) -> f32 {
+        tc.draw(generators::floats::<f32>().min_value(-1e3).max_value(1e3))
+    }
+
+    fn matrix_array(tc: &hegel::TestCase) -> [f32; 9] {
+        core::array::from_fn(|_| component(tc))
+    }
+
+    fn max_abs(m: &[f32]) -> f64 {
+        m.iter().fold(0.0f64, |acc, &x| acc.max((x as f64).abs()))
+    }
+
+    // Property: Mat3 (scalar) and Mat3A (SIMD) built from the same components
+    // agree on transpose (exactly), matrix*vector, matrix*matrix and
+    // determinant (within a tolerance scaled to element magnitudes).
+    #[hegel::test]
+    fn hegel_mat3_vs_mat3a_ops_agree(tc: hegel::TestCase) {
+        let a = matrix_array(&tc);
+        let b = matrix_array(&tc);
+        let m = Mat3::from_cols_array(&a);
+        let ma = Mat3A::from_cols_array(&a);
+        let n = Mat3::from_cols_array(&b);
+        let na = Mat3A::from_cols_array(&b);
+
+        // transpose is a pure lane shuffle: exact agreement required
+        assert_eq!(
+            m.transpose().to_cols_array(),
+            ma.transpose().to_cols_array()
+        );
+
+        // matrix * vector: each component is a 3-term dot product; error
+        // bound K * eps * max|m| * max|v| per component.
+        let vcomps = [component(&tc), component(&tc), component(&tc)];
+        let v = Vec3::from_array(vcomps);
+        let mv = m.mul_vec3(v).to_array();
+        let mav = ma.mul_vec3a(v.into()).to_array();
+        let tol_mv = 16.0 * f32::EPSILON as f64 * 3.0 * max_abs(&a) * max_abs(&vcomps)
+            + f32::MIN_POSITIVE as f64;
+        for c in 0..3 {
+            assert!(
+                (mv[c] as f64 - mav[c] as f64).abs() <= tol_mv,
+                "mul_vec3 diverges at component {}: Mat3 {:?} vs Mat3A {:?} (tol {})",
+                c,
+                mv,
+                mav,
+                tol_mv
+            );
+        }
+
+        // matrix * matrix: same 3-term dot product error model
+        let mn = (m * n).to_cols_array();
+        let mana = (ma * na).to_cols_array();
+        let tol_mm = 16.0 * f32::EPSILON as f64 * 3.0 * max_abs(&a) * max_abs(&b)
+            + f32::MIN_POSITIVE as f64;
+        for c in 0..9 {
+            assert!(
+                (mn[c] as f64 - mana[c] as f64).abs() <= tol_mm,
+                "mat mul diverges at element {}: {:?} vs {:?} (tol {})",
+                c,
+                mn,
+                mana,
+                tol_mm
+            );
+        }
+
+        // determinant: six products of three elements; error bound
+        // K * eps * max|m|^3.
+        let det = m.determinant() as f64;
+        let deta = ma.determinant() as f64;
+        let tol_det =
+            32.0 * f32::EPSILON as f64 * max_abs(&a).powi(3) + f32::MIN_POSITIVE as f64;
+        assert!(
+            (det - deta).abs() <= tol_det,
+            "determinant diverges: Mat3 {} vs Mat3A {} (tol {})",
+            det,
+            deta,
+            tol_det
+        );
+    }
+
+    // Property: Mat3 and Mat3A compute the same inverse (both use the
+    // adjugate-over-determinant formula; per-element divergence must stay
+    // within a few ULP of the shared element scale max|m|^2 / |det|).
+    #[hegel::test]
+    fn hegel_mat3_vs_mat3a_inverse_agree(tc: hegel::TestCase) {
+        let a = matrix_array(&tc);
+        let m = Mat3::from_cols_array(&a);
+        let ma = Mat3A::from_cols_array(&a);
+
+        // Compute the determinant in f64 to decide invertibility soundly.
+        // Excluding near-singular matrices protects the error model of the
+        // comparison (1/det amplification), not a library contract:
+        // inverse() documents that the result is invalid for non-invertible
+        // input.
+        let d = |i: usize| a[i] as f64;
+        let det64 = d(0) * (d(4) * d(8) - d(5) * d(7)) - d(3) * (d(1) * d(8) - d(2) * d(7))
+            + d(6) * (d(1) * d(5) - d(2) * d(4));
+        let scale = {
+            let s = a.iter().fold(0.0f64, |acc, &x| acc.max((x as f64).abs()));
+            s * s
+        };
+        tc.assume(det64.abs() > 1e-6 * scale.max(1e-30));
+
+        let inv = m.inverse().to_cols_array();
+        let inva = ma.inverse().to_cols_array();
+        let elem_scale = 2.0 * scale / det64.abs();
+        let tol = 32.0 * f32::EPSILON as f64 * elem_scale + f32::MIN_POSITIVE as f64;
+        for c in 0..9 {
+            assert!(
+                (inv[c] as f64 - inva[c] as f64).abs() <= tol,
+                "inverse diverges at element {}: Mat3 {:?} vs Mat3A {:?} (tol {})",
+                c,
+                inv,
+                inva,
+                tol
+            );
+        }
+    }
+}
diff --git a/tests/mat4.rs b/tests/mat4.rs
index a2597ef..c7ae578 100644
--- a/tests/mat4.rs
+++ b/tests/mat4.rs
@@ -895,3 +895,124 @@ mod dmat4 {
     impl_mat4_tests!(f64, dmat4, dvec4, dvec3, DMat4, DMat3, DQuat, DVec4, DVec3);
     impl_as_ref_tests!(DMat4);
 }
+
+// Hegel property-based tests.
+//
+// `Mat4` is SIMD-backed (NEON/SSE2/WASM) when available while `DMat4` always
+// uses scalar f64 columns, so instantiating the same properties for both
+// exercises both backends. Inverse correctness is checked as the roundtrip
+// `m * m.inverse() ≈ IDENTITY` on well-conditioned generated matrices.
+#[cfg(not(target_family = "wasm"))]
+macro_rules! impl_hegel_mat4_props {
+    ($t:ident, $mat4:ident, $quat:ident, $vec3:ident) => {
+        use hegel::generators;
+
+        /// A random unit quaternion: draw four components in [-1, 1] and
+        /// normalize. Rejecting near-zero raw quaternions protects the
+        /// normalization step of the generator, not a library contract.
+        fn unit_quat(tc: &hegel::TestCase) -> $quat {
+            let c = || generators::floats::<$t>().min_value(-1.0).max_value(1.0);
+            let q = $quat::from_xyzw(tc.draw(c()), tc.draw(c()), tc.draw(c()), tc.draw(c()));
+            tc.assume(q.length_squared() > 0.01);
+            q.normalize()
+        }
+
+        /// A well-conditioned scale: per-axis |s| in [0.05, 20], random sign.
+        fn well_conditioned_scale(tc: &hegel::TestCase) -> $vec3 {
+            let c = || {
+                let mag = tc.draw(generators::floats::<$t>().min_value(0.05).max_value(20.0));
+                if tc.draw(generators::booleans()) {
+                    -mag
+                } else {
+                    mag
+                }
+            };
+            $vec3::new(c(), c(), c())
+        }
+
+        fn translation(tc: &hegel::TestCase) -> $vec3 {
+            let c = || tc.draw(generators::floats::<$t>().min_value(-1e3).max_value(1e3));
+            $vec3::new(c(), c(), c())
+        }
+
+        fn max_abs(m: &$mat4) -> f64 {
+            m.to_cols_array()
+                .iter()
+                .fold(0.0f64, |acc, &x| acc.max((x as f64).abs()))
+        }
+
+        // Property: for well-conditioned scale/rotation/translation
+        // matrices, the inverse exists (try_inverse is Some) and
+        // m * m.inverse() is the identity within a tolerance scaled to the
+        // magnitudes of m and its inverse.
+        #[hegel::test]
+        fn hegel_mat4_inverse_roundtrip(tc: hegel::TestCase) {
+            let m = $mat4::from_scale_rotation_translation(
+                well_conditioned_scale(&tc),
+                unit_quat(&tc),
+                translation(&tc),
+            );
+
+            let inv = m.inverse();
+            assert!(
+                m.try_inverse().is_some(),
+                "try_inverse returned None for well-conditioned {:?}",
+                m
+            );
+
+            let product = (m * inv).to_cols_array();
+            let identity = $mat4::IDENTITY.to_cols_array();
+            // Error model: each product element is a 4-term dot of elements
+            // bounded by max|m| and max|inv|; K covers accumulated rounding
+            // in from_scale_rotation_translation, the inverse and the
+            // product.
+            let tol = 64.0 * $t::EPSILON as f64 * (1.0 + max_abs(&m) * max_abs(&inv));
+            for c in 0..16 {
+                assert!(
+                    (product[c] as f64 - identity[c] as f64).abs() <= tol,
+                    "m * m.inverse() differs from identity at element {}: {} (tol {}, m {:?})",
+                    c,
+                    product[c],
+                    tol,
+                    m
+                );
+            }
+        }
+
+        // Property: to/from cols-array conversions are exact roundtrips and
+        // transpose is a self-inverse lane shuffle, for arbitrary finite
+        // component values (including huge and subnormal magnitudes).
+        #[hegel::test]
+        fn hegel_mat4_cols_array_roundtrip(tc: hegel::TestCase) {
+            let finite = || {
+                generators::floats::<$t>()
+                    .allow_nan(false)
+                    .allow_infinity(false)
+            };
+            let mut arr = [0.0; 16];
+            for c in arr.iter_mut() {
+                *c = tc.draw(finite());
+            }
+
+            let m = $mat4::from_cols_array(&arr);
+            assert_eq!(arr, m.to_cols_array());
+
+            let arr2d = m.to_cols_array_2d();
+            assert_eq!(m, $mat4::from_cols_array_2d(&arr2d));
+
+            assert_eq!(m, m.transpose().transpose());
+        }
+    };
+}
+
+#[cfg(not(target_family = "wasm"))]
+mod hegel_mat4 {
+    use glam::{Mat4, Quat, Vec3};
+    impl_hegel_mat4_props!(f32, Mat4, Quat, Vec3);
+}
+
+#[cfg(all(not(target_family = "wasm"), feature = "f64"))]
+mod hegel_dmat4 {
+    use glam::{DMat4, DQuat, DVec3};
+    impl_hegel_mat4_props!(f64, DMat4, DQuat, DVec3);
+}
diff --git a/tests/quat.rs b/tests/quat.rs
index 6c29db6..26edd77 100644
--- a/tests/quat.rs
+++ b/tests/quat.rs
@@ -942,3 +942,167 @@ mod dquat {
 
     impl_quat_tests!(f64, dquat, DMat3, DMat4, DQuat, DVec2, DVec3, DVec4);
 }
+
+// Hegel property-based tests.
+//
+// `Quat` is SIMD-backed (NEON/SSE2/WASM) when available while `DQuat` always
+// uses scalar storage, so instantiating the same properties for both
+// exercises both backends. The matrix-rotation comparison uses
+// `Mat3::from_quat` as an independently implemented sibling of the
+// quaternion sandwich product.
+#[cfg(not(target_family = "wasm"))]
+macro_rules! impl_hegel_quat_props {
+    ($t:ident, $quat:ident, $vec3:ident, $mat3:ident) => {
+        use hegel::generators;
+
+        /// A random unit quaternion: draw four components in [-1, 1] and
+        /// normalize. Rejecting near-zero raw quaternions protects the
+        /// normalization step of the generator, not a library contract.
+        fn unit_quat(tc: &hegel::TestCase) -> $quat {
+            let c = || generators::floats::<$t>().min_value(-1.0).max_value(1.0);
+            let q = $quat::from_xyzw(tc.draw(c()), tc.draw(c()), tc.draw(c()), tc.draw(c()));
+            tc.assume(q.length_squared() > 0.01);
+            q.normalize()
+        }
+
+        /// A random unit axis.
+        fn unit_axis(tc: &hegel::TestCase) -> $vec3 {
+            let c = || generators::floats::<$t>().min_value(-1.0).max_value(1.0);
+            let v = $vec3::new(tc.draw(c()), tc.draw(c()), tc.draw(c()));
+            tc.assume(v.length_squared() > 0.01);
+            v.normalize()
+        }
+
+        // Property: from_axis_angle yields a unit quaternion (sin² + cos² = 1
+        // for any finite angle) and the rotation it represents leaves its own
+        // axis fixed.
+        #[hegel::test]
+        fn hegel_quat_from_axis_angle_unit_and_fixes_axis(tc: hegel::TestCase) {
+            let axis = unit_axis(&tc);
+            let angle: $t = tc.draw(
+                generators::floats::<$t>()
+                    .allow_nan(false)
+                    .allow_infinity(false),
+            );
+            let q = $quat::from_axis_angle(axis, angle);
+            assert!(
+                q.is_normalized(),
+                "from_axis_angle({:?}, {}) is not normalized: {:?} (length {})",
+                axis,
+                angle,
+                q,
+                q.length()
+            );
+
+            // |scale| <= 1e15 keeps |v| far from overflow in the sandwich
+            // product's intermediates; protects the tolerance model, not a
+            // library contract.
+            let scale: $t = tc.draw(generators::floats::<$t>().min_value(-1e15).max_value(1e15));
+            let v = axis * scale;
+            let rotated = q.mul_vec3(v);
+            let tol = 32.0 * $t::EPSILON as f64 * (scale as f64).abs() + 1e-30;
+            for c in 0..3 {
+                let (r, e) = (rotated.to_array()[c] as f64, v.to_array()[c] as f64);
+                assert!(
+                    (r - e).abs() <= tol,
+                    "rotation moved its own axis: {:?} -> {:?} (tol {})",
+                    v,
+                    rotated,
+                    tol
+                );
+            }
+        }
+
+        // Property: for a unit quaternion, q * q.conjugate() is the identity
+        // rotation and q.inverse() coincides with q.conjugate().
+        #[hegel::test]
+        fn hegel_quat_conjugate_is_inverse(tc: hegel::TestCase) {
+            let q = unit_quat(&tc);
+
+            let p = q * q.conjugate();
+            let tol = 32.0 * $t::EPSILON as f64;
+            assert!(
+                (p.w as f64 - 1.0).abs() <= tol
+                    && (p.x as f64).abs() <= tol
+                    && (p.y as f64).abs() <= tol
+                    && (p.z as f64).abs() <= tol,
+                "q * q.conjugate() = {:?} is not the identity (tol {})",
+                p,
+                tol
+            );
+
+            let inv = q.inverse();
+            let conj = q.conjugate();
+            for (a, b) in inv.to_array().iter().zip(conj.to_array().iter()) {
+                assert!(
+                    (*a as f64 - *b as f64).abs() <= tol,
+                    "inverse {:?} != conjugate {:?} for unit quat {:?} (tol {})",
+                    inv,
+                    conj,
+                    q,
+                    tol
+                );
+            }
+        }
+
+        // Property: rotating by a unit quaternion preserves vector length,
+        // and the quaternion sandwich product agrees with the independently
+        // implemented rotation-matrix path (Mat3::from_quat).
+        #[hegel::test]
+        fn hegel_quat_rotation_preserves_length_and_matches_mat3(tc: hegel::TestCase) {
+            let q = unit_quat(&tc);
+            // |components| <= 1e15: keeps the sandwich product and length
+            // computation away from overflow; protects the tolerance model,
+            // not a library contract.
+            let c = || generators::floats::<$t>().min_value(-1e15).max_value(1e15);
+            let v = $vec3::new(tc.draw(c()), tc.draw(c()), tc.draw(c()));
+
+            let len64 = |u: $vec3| -> f64 {
+                u.to_array()
+                    .iter()
+                    .map(|&x| (x as f64) * (x as f64))
+                    .sum::<f64>()
+                    .sqrt()
+            };
+            let rotated = q.mul_vec3(v);
+            let vlen = len64(v);
+            let rlen = len64(rotated);
+            let tol_len = 32.0 * $t::EPSILON as f64 * vlen + 1e-30;
+            assert!(
+                (rlen - vlen).abs() <= tol_len,
+                "rotation changed length: |{:?}| = {} vs |{:?}| = {} (tol {})",
+                v,
+                vlen,
+                rotated,
+                rlen,
+                tol_len
+            );
+
+            let m = $mat3::from_quat(q);
+            let mv = m.mul_vec3(v);
+            let tol_mv = 64.0 * $t::EPSILON as f64 * vlen + 1e-30;
+            for c in 0..3 {
+                let (a, b) = (rotated.to_array()[c] as f64, mv.to_array()[c] as f64);
+                assert!(
+                    (a - b).abs() <= tol_mv,
+                    "quat rotation {:?} disagrees with Mat3::from_quat rotation {:?} (tol {})",
+                    rotated,
+                    mv,
+                    tol_mv
+                );
+            }
+        }
+    };
+}
+
+#[cfg(not(target_family = "wasm"))]
+mod hegel_quat {
+    use glam::{Mat3, Quat, Vec3};
+    impl_hegel_quat_props!(f32, Quat, Vec3, Mat3);
+}
+
+#[cfg(all(not(target_family = "wasm"), feature = "f64"))]
+mod hegel_dquat {
+    use glam::{DMat3, DQuat, DVec3};
+    impl_hegel_quat_props!(f64, DQuat, DVec3, DMat3);
+}
diff --git a/tests/vec3.rs b/tests/vec3.rs
index 2957aaf..62cb77b 100644
--- a/tests/vec3.rs
+++ b/tests/vec3.rs
@@ -2932,3 +2932,233 @@ mod usizevec3 {
     impl_vec3_scalar_bit_op_tests!(USizeVec3, 0, 2);
     impl_vec3_bit_op_tests!(USizeVec3, 0, 2);
 }
+
+// Hegel property-based tests.
+//
+// glam selects a SIMD backend (NEON/SSE2/WASM) or a scalar backend per type:
+// `Vec3` always uses scalar `f32` storage while `Vec3A` uses the SIMD backend
+// when available, so comparing them on identical inputs is a direct
+// SIMD-vs-scalar differential within a single build. `DVec3` (always scalar
+// f64) additionally serves as a higher-precision oracle for the f32 math.
+#[cfg(not(target_family = "wasm"))]
+mod hegel_props {
+    use glam::{Vec3, Vec3A};
+    use hegel::generators;
+
+    /// Finite f32 with |x| <= 1e18 so that squares and pairwise products stay
+    /// well below f32::MAX. This bound protects the tolerance analysis of the
+    /// differential properties (no intermediate overflow on either side), not
+    /// a library contract; `hegel_vec3_normalize_family_contract` below covers
+    /// the full range including huge, subnormal and non-finite values.
+    fn bounded_component(tc: &hegel::TestCase) -> f32 {
+        tc.draw(generators::floats::<f32>().min_value(-1e18).max_value(1e18))
+    }
+
+    fn bounded_triple(tc: &hegel::TestCase) -> [f32; 3] {
+        [
+            bounded_component(tc),
+            bounded_component(tc),
+            bounded_component(tc),
+        ]
+    }
+
+    // Property: for lane-wise operations with no reassociation freedom
+    // (IEEE-defined per-lane results), the SIMD-backed Vec3A must agree
+    // exactly with the scalar Vec3.
+    #[hegel::test]
+    fn hegel_vec3_vec3a_lanewise_ops_agree_exactly(tc: hegel::TestCase) {
+        let a = bounded_triple(&tc);
+        let b = bounded_triple(&tc);
+        let (v, w) = (Vec3::from_array(a), Vec3::from_array(b));
+        let (va, wa) = (Vec3A::from_array(a), Vec3A::from_array(b));
+
+        assert_eq!((v + w).to_array(), (va + wa).to_array());
+        assert_eq!((v - w).to_array(), (va - wa).to_array());
+        assert_eq!((v * w).to_array(), (va * wa).to_array());
+        assert_eq!(v.min(w).to_array(), va.min(wa).to_array());
+        assert_eq!(v.max(w).to_array(), va.max(wa).to_array());
+        assert_eq!(v.abs().to_array(), va.abs().to_array());
+        assert_eq!((-v).to_array(), (-va).to_array());
+    }
+
+    // Property: dot, cross and length of both the scalar Vec3 and the
+    // SIMD Vec3A agree with a higher-precision f64 oracle (DVec3) within a
+    // tolerance calibrated to the magnitude of the intermediate products.
+    #[hegel::test]
+    fn hegel_vec3_and_vec3a_match_f64_oracle(tc: hegel::TestCase) {
+        let a = bounded_triple(&tc);
+        let b = bounded_triple(&tc);
+        let (v, w) = (Vec3::from_array(a), Vec3::from_array(b));
+        let (va, wa) = (Vec3A::from_array(a), Vec3A::from_array(b));
+        let (dv, dw) = (v.as_dvec3(), w.as_dvec3());
+
+        // dot: |err| <= K * eps * sum(|a_i * b_i|)
+        let dot64 = dv.dot(dw);
+        let dot_scale: f64 = dv
+            .to_array()
+            .iter()
+            .zip(dw.to_array().iter())
+            .map(|(x, y)| (x * y).abs())
+            .sum();
+        let dot_tol = 8.0 * f32::EPSILON as f64 * dot_scale + f32::MIN_POSITIVE as f64;
+        assert!(
+            (v.dot(w) as f64 - dot64).abs() <= dot_tol,
+            "Vec3 dot {} vs f64 oracle {} (tol {})",
+            v.dot(w),
+            dot64,
+            dot_tol
+        );
+        assert!(
+            (va.dot(wa) as f64 - dot64).abs() <= dot_tol,
+            "Vec3A dot {} vs f64 oracle {} (tol {})",
+            va.dot(wa),
+            dot64,
+            dot_tol
+        );
+
+        // cross: per component |err| <= K * eps * (|a_j*b_k| + |a_k*b_j|)
+        let cross64 = dv.cross(dw).to_array();
+        let cross32 = v.cross(w).to_array();
+        let cross32a = va.cross(wa).to_array();
+        let idx = [(1usize, 2usize), (2, 0), (0, 1)];
+        let a64 = dv.to_array();
+        let b64 = dw.to_array();
+        for c in 0..3 {
+            let (j, k) = idx[c];
+            let scale = (a64[j] * b64[k]).abs() + (a64[k] * b64[j]).abs();
+            let tol = 8.0 * f32::EPSILON as f64 * scale + f32::MIN_POSITIVE as f64;
+            assert!(
+                (cross32[c] as f64 - cross64[c]).abs() <= tol,
+                "Vec3 cross[{}] = {} vs f64 oracle {} (tol {})",
+                c,
+                cross32[c],
+                cross64[c],
+                tol
+            );
+            assert!(
+                (cross32a[c] as f64 - cross64[c]).abs() <= tol,
+                "Vec3A cross[{}] = {} vs f64 oracle {} (tol {})",
+                c,
+                cross32a[c],
+                cross64[c],
+                tol
+            );
+        }
+
+        // length: |err| <= K * eps * length, plus an absolute term for the
+        // subnormal regime: when length_squared lands in the f32 subnormal
+        // range its quantization error is amplified by the square root, with
+        // absolute error bounded by ~sqrt(min_subnormal) = sqrt(1.4e-45).
+        let len64 = dv.length();
+        let len_tol = 8.0 * f32::EPSILON as f64 * len64 + 4e-23;
+        assert!(
+            (v.length() as f64 - len64).abs() <= len_tol,
+            "Vec3 length {} vs f64 oracle {} (tol {})",
+            v.length(),
+            len64,
+            len_tol
+        );
+        assert!(
+            (va.length() as f64 - len64).abs() <= len_tol,
+            "Vec3A length {} vs f64 oracle {} (tol {})",
+            va.length(),
+            len64,
+            len_tol
+        );
+    }
+
+    /// A whole vector drawn from one magnitude class, so that the boundary
+    /// classes (length_squared underflowing to a subnormal/zero, or
+    /// overflowing to +inf) are actually reached — independent per-component
+    /// draws almost never put all three components in the same extreme class.
+    /// Classes: any float (incl. NaN/inf), tiny, and huge magnitudes.
+    fn extreme_triple(tc: &hegel::TestCase) -> [f32; 3] {
+        let class: u8 = tc.draw(generators::integers::<u8>().max_value(2));
+        let draw = || match class {
+            0 => tc.draw(generators::floats::<f32>()),
+            1 => tc.draw(generators::floats::<f32>().min_value(-1e-18).max_value(1e-18)),
+            _ => tc.draw(hegel::one_of!(
+                generators::floats::<f32>().min_value(1e18).max_value(f32::MAX),
+                generators::floats::<f32>().min_value(f32::MIN).max_value(-1e18),
+            )),
+        };
+        [draw(), draw(), draw()]
+    }
+
+    // KNOWN FAILURE: pins a real contract violation found by
+    // hegel_vec3_normalize_family_contract below.
+    //
+    // Vec3::try_normalize documents: "Returns `self` normalized to length 1.0
+    // if possible, else returns `None`. In particular, if the input is zero
+    // (or very close to zero), or non-finite, the result of this operation
+    // will be `None`."
+    //
+    // For vectors whose length_squared lands in the subnormal range,
+    // `length_recip()` is finite and positive, so try_normalize returns
+    // `Some(..)`, but the subnormal rounding of length_squared makes the
+    // result far from unit length: try_normalize(vec3(4e-23, 0.0, 0.0))
+    // returns Some(v) with v.length() ≈ 1.0685 (is_normalized() threshold is
+    // ~1e-4). Deterministic input, fails on every run.
+    #[test]
+    fn hegel_pin_vec3_try_normalize_subnormal_length_not_unit() {
+        let v = Vec3::new(4e-23, 0.0, 0.0);
+        match v.try_normalize() {
+            None => {} // also acceptable per the documentation
+            Some(n) => assert!(
+                n.is_normalized(),
+                "Vec3::try_normalize({:?}) returned Some({:?}) with length {}, \
+                 which is neither None nor unit length",
+                v,
+                n,
+                n.length()
+            ),
+        }
+    }
+
+    // Property (documented contract of try_normalize / normalize_or_zero):
+    // for *any* input, try_normalize returns None or a unit-length vector,
+    // and normalize_or_zero returns zero or a unit-length vector.
+    // "Unit-length" uses glam's own documented `is_normalized` threshold.
+    #[hegel::test]
+    fn hegel_vec3_normalize_family_contract(tc: hegel::TestCase) {
+        let a = extreme_triple(&tc);
+        let v = Vec3::from_array(a);
+        let va = Vec3A::from_array(a);
+
+        // Exclude the known-buggy region pinned by
+        // hegel_pin_vec3_try_normalize_subnormal_length_not_unit: when
+        // length_squared falls near/below the f32 subnormal range the result
+        // of try_normalize is Some(..) but not unit length. Everything else
+        // (zero, huge, non-finite, ordinary vectors) is still checked here.
+        let ls64: f64 = a.iter().map(|&x| (x as f64) * (x as f64)).sum();
+        tc.assume(!(ls64 > 0.0 && ls64 < 1e-37));
+
+        if let Some(n) = v.try_normalize() {
+            assert!(
+                n.is_normalized(),
+                "Vec3::try_normalize({:?}) returned Some({:?}) with length {}",
+                v,
+                n,
+                n.length()
+            );
+        }
+        if let Some(n) = va.try_normalize() {
+            assert!(
+                n.is_normalized(),
+                "Vec3A::try_normalize({:?}) returned Some({:?}) with length {}",
+                va,
+                n,
+                n.length()
+            );
+        }
+
+        let nz = v.normalize_or_zero();
+        assert!(
+            nz == Vec3::ZERO || nz.is_normalized(),
+            "Vec3::normalize_or_zero({:?}) returned {:?} with length {}",
+            v,
+            nz,
+            nz.length()
+        );
+    }
+}
diff --git a/tests/vec4.rs b/tests/vec4.rs
