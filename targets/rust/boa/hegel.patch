+/// Property: a numeric literal produced by Rust's shortest-round-trip f64
+/// `Display` parses through Boa's lexer to exactly the same f64 bits
+/// (including `-0`). Rust's float formatting/parsing acts as an independent
+/// oracle for the lexer's correctly-rounded decimal-to-binary conversion.
+// `hegel::test`'s generated code uses `str::replace`, which this crate disallows.
+#[allow(clippy::disallowed_methods)]
+#[hegel::test]
+fn number_literals_roundtrip_exactly_through_the_lexer(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let x = tc.draw(
+        generators::floats::<f64>()
+            .allow_nan(false)
+            .allow_infinity(false),
+    );
