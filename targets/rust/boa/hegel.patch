+
+/// Property: `Number(String(x)) === x` for every number, per the spec's
+/// guarantee that `Number::toString` emits a decimal string precise enough
+/// to round-trip. `===` (not `Object.is`) is exactly the strength the spec
+/// promises: `String(-0)` is `"0"`, so the round-trip legitimately loses the
+/// sign of zero. `NaN` needs its own clause since `NaN !== NaN`.
+// `hegel::test`'s generated code uses `str::replace`, which this crate disallows.
+#[allow(clippy::disallowed_methods)]
+#[hegel::test]
+fn number_to_string_roundtrips_through_to_number(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let x = tc.draw(generators::floats::<f64>());
+    let source = format!(
+        "var x = {}; var y = Number(String(x)); y === x || (Number.isNaN(y) && Number.isNaN(x))",
+        crate::test_generators::js_number_expr(x)
+    );
+    let context = &mut crate::Context::default();
+    let value = context
+        .eval(crate::Source::from_bytes(source.as_bytes()))
+        .unwrap_or_else(|err| panic!("evaluating `{source}` failed: {err}"));
