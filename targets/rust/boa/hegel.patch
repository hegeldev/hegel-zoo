+// ---------------------------------------------------------------------------
+// Hegel property-based tests.
+// ---------------------------------------------------------------------------
+
+/// The engine's parser (lexer included) must return `Err` on garbage input,
+/// never panic.
+// `hegel::test`'s generated code uses `str::replace`, which this crate disallows.
+#[allow(clippy::disallowed_methods)]
+#[hegel::test]
+fn parsing_arbitrary_text_never_panics(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let source = tc.draw(generators::text());
+    let context = &mut Context::default();
+    drop(crate::script::Script::parse(
+        crate::Source::from_bytes(source.as_bytes()),
+        None,
+        context,
+    ));
+}
+
+/// Same property as [`parsing_arbitrary_text_never_panics`], but on text
+/// assembled from JavaScript tokens, which reaches far deeper into the parser
+/// than uniformly random text does.
+// `hegel::test`'s generated code uses `str::replace`, which this crate disallows.
+#[allow(clippy::disallowed_methods)]
+#[hegel::test]
+fn parsing_js_shaped_text_never_panics(tc: hegel::TestCase) {
+    let source = crate::test_generators::js_shaped_source(&tc);
+    tc.note(&source);
+    let context = &mut Context::default();
+    drop(crate::script::Script::parse(
+        crate::Source::from_bytes(source.as_bytes()),
+        None,
+        context,
+    ));
+}
+
+/// Evaluating the same source in two fresh contexts must produce the same
+/// outcome (same value, or same error). The generated programs contain no
+/// intentional sources of nondeterminism (`Math.random`, `Date`, ...), and
+/// the runtime limits guarantee termination even when a generated program
+/// happens to contain an infinite loop or recursion.
+// `hegel::test`'s generated code uses `str::replace`, which this crate disallows.
+#[allow(clippy::disallowed_methods)]
+#[hegel::test]
+fn evaluation_is_deterministic_across_fresh_contexts(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let source = if tc.draw(generators::booleans()) {
+        crate::test_generators::js_shaped_source(&tc)
+    } else {
+        tc.draw(crate::test_generators::arith_exprs(3)).0
+    };
+    tc.note(&source);
+
+    let run = |source: &str| {
+        let context = &mut Context::default();
+        context.runtime_limits_mut().set_loop_iteration_limit(1_000);
+        context.runtime_limits_mut().set_recursion_limit(32);
+        match context.eval(crate::Source::from_bytes(source.as_bytes())) {
+            Ok(value) => format!("value: {}", value.display()),
+            Err(err) => format!("error: {err}"),
+        }
+    };
+
+    assert_eq!(run(&source), run(&source), "source: {source}");
+}
+
+/// Deeply nested (but reasonably sized) expressions and statements must not
+/// crash the parser. This intentionally generates nesting depths beyond what
+/// `js_shaped_source` produces, since recursive-descent parsers are classic
+/// stack-overflow territory.
+///
+/// KNOWN FAILURE REGION (excluded here): Boa's recursive-descent parser has
+/// no nesting-depth limit, so parsing deeply nested source overflows the
+/// native stack and aborts the whole process. In a debug build on a standard
+/// 2 `MiB` Rust test thread, `"(".repeat(64)` and `"({a:".repeat(32)` already
+/// abort. See [`parser_deep_nesting_stack_overflow_probe`] for the pinned
+/// reproducer; the depth bound below keeps this test under that threshold so
+/// it can keep exercising everything else.
+// `hegel::test`'s generated code uses `str::replace`, which this crate disallows.
+#[allow(clippy::disallowed_methods)]
+#[hegel::test]
+fn parsing_deeply_nested_source_never_panics(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let depth = tc.draw(generators::integers::<usize>().max_value(16));
+    let (open, close) = tc.draw(generators::sampled_from(vec![
+        ("(", ")"),
+        ("[", "]"),
+        ("{", "}"),
+        ("!", ""),
+        // The space matters: `--` would lex as a decrement operator.
+        ("- ", ""),
+        ("typeof ", ""),
+        ("[0,", "]"),
+        ("({a:", "})"),
+    ]));
+    let source = format!("{}0{}", open.repeat(depth), close.repeat(depth));
+    let context = &mut Context::default();
+    drop(crate::script::Script::parse(
+        crate::Source::from_bytes(source.as_bytes()),
+        None,
+        context,
+    ));
+}
+
+/// KNOWN FAILURE (process abort): Boa's recursive-descent parser has no
+/// nesting-depth limit and overflows the native stack on deeply nested
+/// input, aborting the whole process (`RuntimeLimits` only guards VM
+/// execution, not parsing). Measured on a debug build with the standard
+/// 2 `MiB` Rust test-thread stack:
+///
+/// - `"(".repeat(64) + "0" + ")".repeat(64)` → SIGABRT (depth 32 is fine)
+/// - `"({a:".repeat(32) + "0" + "})".repeat(32)` → SIGABRT (depth 24 is fine)
+///
+/// Marked `#[ignore]` because the stack overflow aborts the whole test
+/// binary, which would take every other test down with it. Run manually
+/// with:
+/// `cargo test -p boa_engine --lib parser_deep_nesting_stack_overflow_probe -- --ignored --nocapture`
+#[test]
+#[ignore = "pins a real bug: aborts the process via stack overflow in the parser; run manually"]
