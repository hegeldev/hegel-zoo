+/// Shared generators and helpers for the hegel property-based tests that are
+/// spread across the crate's unit-test modules (`tests/`, `vm/tests.rs`,
+/// `builtins/json/tests.rs`, `builtins/number/tests.rs`, ...).
+#[cfg(test)]
+pub(crate) mod test_generators {
+    use hegel::generators::{self, BoxedGenerator, Generator};
+
+    /// Renders `s` as a double-quoted JavaScript string literal that lexes
+    /// back to exactly the same sequence of code points. Everything outside
+    /// printable ASCII is emitted as `\uXXXX` escapes, one per UTF-16 code
+    /// unit.
+    pub(crate) fn js_string_literal(s: &str) -> String {
+        use std::fmt::Write;
+
+        let mut out = String::with_capacity(s.len() + 2);
+        out.push('"');
+        for c in s.chars() {
+            match c {
+                '"' => out.push_str("\\\""),
+                '\\' => out.push_str("\\\\"),
+                c if c.is_ascii_graphic() || c == ' ' => out.push(c),
+                c => {
+                    let mut buf = [0u16; 2];
+                    for unit in c.encode_utf16(&mut buf) {
+                        write!(out, "\\u{unit:04X}").expect("writing to a String cannot fail");
+                    }
+                }
+            }
+        }
+        out.push('"');
+        out
+    }
+
+    /// Renders an arbitrary f64 as a JavaScript expression that evaluates to
+    /// exactly that value.
+    pub(crate) fn js_number_expr(x: f64) -> String {
+        if x.is_nan() {
+            "(0/0)".to_string()
+        } else if x == f64::INFINITY {
+            "(1/0)".to_string()
+        } else if x == f64::NEG_INFINITY {
+            "(-1/0)".to_string()
+        } else {
+            // Rust's `Display` for f64 produces the shortest decimal string
+            // that round-trips to the same value, and that string is also a
+            // valid JS expression (possibly starting with `-`, hence the
+            // parentheses to keep it usable in any expression position).
+            format!("({x})")
+        }
+    }
+
+    /// Generates a random arithmetic expression together with the value that
+    /// IEEE-754 (and therefore ECMAScript) semantics assign to it. The
+    /// expected value is computed with Rust float arithmetic, which acts as
+    /// an independent oracle for Boa's interpreter, including its integer
+    /// fast paths.
+    pub(crate) fn arith_exprs(depth: u32) -> BoxedGenerator<'static, (String, f64)> {
+        hegel::compose!(|tc| {
+            if depth == 0 || tc.draw(generators::integers::<u8>().max_value(2)) == 0 {
+                let x = tc.draw(
+                    generators::floats::<f64>()
+                        .allow_nan(false)
+                        .allow_infinity(false),
+                );
+                (js_number_expr(x), x)
+            } else {
+                let (ls, lv) = tc.draw(arith_exprs(depth - 1));
+                let (rs, rv) = tc.draw(arith_exprs(depth - 1));
+                let op = tc.draw(generators::sampled_from(vec!['+', '-', '*', '/', '%']));
+                let value = match op {
+                    '+' => lv + rv,
+                    '-' => lv - rv,
+                    '*' => lv * rv,
+                    '/' => lv / rv,
+                    // Rust's `%` on f64 has ECMAScript's remainder semantics
+                    // (result takes the sign of the dividend; computed as fmod).
+                    _ => lv % rv,
+                };
+                (format!("({ls} {op} {rs})"), value)
+            }
+        })
+        .boxed()
+    }
+
+    /// Generates JS-shaped text: sequences of JavaScript tokens and token
+    /// fragments interleaved with small chunks of arbitrary text. Most
+    /// outputs are invalid programs, some parse, and a few even run; the
+    /// engine must handle all of them without panicking.
+    pub(crate) fn js_shaped_source(tc: &hegel::TestCase) -> String {
+        const TOKENS: &[&str] = &[
+            // Keywords and contextual keywords.
+            "var",
+            "let",
+            "const",
+            "function",
+            "return",
+            "if",
+            "else",
+            "for",
+            "while",
+            "do",
+            "class",
+            "extends",
+            "new",
+            "typeof",
+            "delete",
+            "void",
+            "in",
+            "of",
+            "instanceof",
+            "try",
+            "catch",
+            "finally",
+            "throw",
+            "switch",
+            "case",
+            "default",
+            "break",
+            "continue",
+            "yield",
+            "async",
+            "await",
+            "static",
+            "get",
+            "set",
+            "this",
+            "super",
+            "arguments",
+            "eval",
+            "with",
+            "debugger",
+            // Values.
+            "0",
+            "1",
+            "42",
+            "0x1f",
+            "0b101",
+            "0o17",
+            "1e10",
+            ".5",
+            "10n",
+            "NaN",
+            "Infinity",
+            "undefined",
+            "null",
+            "true",
+            "false",
+            "'str'",
+            "\"str\"",
+            "`tpl`",
+            "/re/g",
+            "[1,2]",
+            "{a:1}",
+            "x",
+            "y",
+            "obj",
+            "arr",
+            "fn",
+            "$",
+            "_",
+            "\\u0041",
+            "#priv",
+            // Operators and punctuation.
+            "=>",
+            "...",
+            "?.",
+            "??",
+            "=",
+            "==",
+            "===",
+            "!=",
+            "!==",
+            "+",
+            "-",
+            "*",
+            "/",
+            "%",
+            "**",
+            "++",
+            "--",
+            "!",
+            "~",
+            "&",
+            "|",
+            "^",
+            "<<",
+            ">>",
+            ">>>",
+            "<",
+            ">",
+            "<=",
+            ">=",
+            "&&",
+            "||",
+            "?",
+            ":",
+            ";",
+            ",",
+            ".",
+            "(",
+            ")",
+            "[",
+            "]",
+            "{",
+            "}",
+            "${",
+            "label:",
+            // Whitespace.
+            " ",
+            "\n",
+            "\t",
+        ];
+        let token = hegel::one_of!(
+            generators::sampled_from(TOKENS.to_vec()).map(ToString::to_string),
+            generators::text().max_size(4),
+        );
+        tc.draw(generators::vecs(token).max_size(80)).concat()
+    }
+
+    /// Generates an arbitrary JSON document whose numbers are all exactly
+    /// representable as f64 (integers limited to the 2^53 safe-integer
+    /// range), so that a pass through an ECMAScript engine — where every
+    /// number is an f64 — cannot lose precision on them.
+    pub(crate) fn json_values(depth: u32) -> BoxedGenerator<'static, serde_json::Value> {
+        use serde_json::Value;
+
+        hegel::compose!(|tc| {
+            // Only produce arrays/objects while we have depth budget left.
+            let max_choice = if depth == 0 { 3 } else { 5 };
+            match tc.draw(generators::integers::<u8>().max_value(max_choice)) {
+                0 => Value::Null,
+                1 => Value::Bool(tc.draw(generators::booleans())),
+                2 => {
+                    /// Largest integer `n` such that all integers up to `n`
+                    /// are exactly representable as f64 (2^53).
+                    const MAX_SAFE: i64 = 1 << 53;
+                    let number = tc.draw((hegel::one_of!(
+                        generators::integers::<i64>()
+                            .min_value(-MAX_SAFE)
+                            .max_value(MAX_SAFE)
+                            .map(serde_json::Number::from),
+                        generators::floats::<f64>()
+                            .allow_nan(false)
+                            .allow_infinity(false)
+                            .map(|f| {
+                                serde_json::Number::from_f64(f)
+                                    .expect("finite floats convert to JSON numbers")
+                            }),
+                    )).print_as_debug());
+                    Value::Number(number)
+                }
+                3 => Value::String(tc.draw(generators::text().max_size(20))),
+                4 => Value::Array(tc.draw((generators::vecs(json_values(depth - 1)).max_size(4)).print_as_debug())),
+                _ => {
+                    let entries: Vec<(String, Value)> = tc.draw(
+                        (generators::vecs(generators::tuples!(
+                            generators::text().max_size(8),
+                            json_values(depth - 1),
+                        ))
+                        .max_size(4)).print_as_debug(),
+                    );
+                    Value::Object(entries.into_iter().collect())
+                }
+            }
+        })
+        .boxed()
+    }
+
+    /// Structural JSON equality that compares numbers by f64 value rather
+    /// than by `serde_json`'s internal integer/float representation. An
+    /// ECMAScript engine only has f64 numbers, so `3.0` and `3` must compare
+    /// equal. Object comparison is key-based and therefore order-insensitive.
+    pub(crate) fn json_semantic_eq(a: &serde_json::Value, b: &serde_json::Value) -> bool {
+        use serde_json::Value;
+
+        match (a, b) {
+            (Value::Number(x), Value::Number(y)) => match (x.as_f64(), y.as_f64()) {
+                (Some(x), Some(y)) => x == y,
+                _ => false,
+            },
+            (Value::Array(x), Value::Array(y)) => {
+                x.len() == y.len() && x.iter().zip(y).all(|(a, b)| json_semantic_eq(a, b))
+            }
+            (Value::Object(x), Value::Object(y)) => {
+                x.len() == y.len()
+                    && x.iter()
+                        .all(|(k, v)| y.get(k).is_some_and(|w| json_semantic_eq(v, w)))
+            }
+            _ => a == b,
+        }
+    }
+}
