+/// Property: the documented loop-iteration limit is a tight bound — a loop
+/// that performs at most `limit` iterations succeeds, and a loop that would
+/// exceed it halts with `RuntimeLimitError::LoopIteration` instead of
+/// running (or hanging) forever.
+// `hegel::test`'s generated code uses `str::replace`, which this crate disallows.
+#[allow(clippy::disallowed_methods)]
+#[hegel::test]
+fn loop_iteration_limit_is_a_tight_bound(tc: hegel::TestCase) {
+    use crate::error::EngineError;
+    use hegel::generators;
+
+    let limit = tc.draw(generators::integers::<u64>().min_value(1).max_value(1_000));
+    // Boundary conjunctions (iterations == limit ± 1) almost never happen by
+    // coincidence, so give them a dedicated branch.
+    let iterations = tc.draw(hegel::one_of!(
+        generators::integers::<u64>().max_value(1_500),
+        generators::integers::<u64>()
+            .min_value(limit.saturating_sub(1))
+            .max_value(limit + 1),
+    ));
+    let for_loop = tc.draw(generators::booleans());
+    let source = if for_loop {
+        format!("for (let i = 0; i < {iterations}; ++i) {{ }}")
+    } else {
+        format!("let i = 0; while (i < {iterations}) {{ ++i; }}")
+    };
+
+    let context = &mut Context::default();
+    context.runtime_limits_mut().set_loop_iteration_limit(limit);
+    let result = context.eval(Source::from_bytes(source.as_bytes()));
+
+    // NOTE: this encodes the *actual* behavior. The documented contract
+    // ("Max loop iterations before an error is thrown") promises at most
+    // `limit` iterations, and `while` loops deliver exactly that (the
+    // increment opcode runs before every condition check). `for` loops
+    // however emit the increment after each completed body, letting
+    // `limit + 1` iterations finish. That off-by-one (and the for/while
+    // inconsistency) is pinned by
+    // [`loop_iteration_limit_off_by_one_known_failure`] below, and is
+    // excluded here so this test can keep checking that the limit both
+    // permits small loops and halts runaway ones.
+    let max_allowed = if for_loop { limit + 1 } else { limit };
+    if iterations <= max_allowed {
+        assert!(
+            result.is_ok(),
+            "`{source}` with loop limit {limit} unexpectedly failed: {}",
+            result.unwrap_err()
+        );
+    } else {
+        let err = result.expect_err(&format!(
+            "`{source}` with loop limit {limit} unexpectedly succeeded"
+        ));
+        assert!(
+            matches!(
+                err.as_engine(),
+                Some(EngineError::RuntimeLimit(RuntimeLimitError::LoopIteration))
+            ),
+            "`{source}` with loop limit {limit} failed with the wrong error: {err}"
+        );
+    }
+}
+
+/// Property: the documented recursion limit is a tight bound — recursion
+/// that stays under the limit succeeds, and recursion that would exceed it
+/// halts with `RuntimeLimitError::Recursion` instead of overflowing the
+/// native stack.
+// `hegel::test`'s generated code uses `str::replace`, which this crate disallows.
+#[allow(clippy::disallowed_methods)]
+#[hegel::test]
+fn recursion_limit_is_a_tight_bound(tc: hegel::TestCase) {
+    use crate::error::EngineError;
+    use hegel::generators;
+
+    let limit = tc.draw(generators::integers::<usize>().min_value(4).max_value(400));
+    // Boundary conjunctions (depth right at the limit) almost never happen
+    // by coincidence, so give them a dedicated branch.
+    let depth = tc.draw(hegel::one_of!(
+        generators::integers::<usize>().max_value(500),
+        generators::integers::<usize>()
+            .min_value(limit.saturating_sub(4))
+            .max_value(limit + 2),
+    ));
+    let source = format!("function f(n) {{ return n <= 0 ? 0 : f(n - 1); }} f({depth})");
+
+    let context = &mut Context::default();
+    context.runtime_limits_mut().set_recursion_limit(limit);
+    // Keep the value-stack limit out of the way so only the recursion limit
+    // is being measured.
+    context
+        .runtime_limits_mut()
+        .set_stack_size_limit(usize::MAX);
+    let result = context.eval(Source::from_bytes(source.as_bytes()));
+
+    // `f(depth)` performs `depth + 1` calls to `f`. The VM checks the limit
+    // in `function_call` *before* pushing the new frame, with the script
+    // frame contributing one level, so the deepest checked recursion depth
+    // is `depth + 1` and the call chain succeeds iff `depth + 2 <= limit`.
+    if depth + 2 <= limit {
+        assert!(
+            result.is_ok(),
+            "`{source}` with recursion limit {limit} unexpectedly failed: {}",
+            result.unwrap_err()
+        );
+    } else {
+        let err = result.expect_err(&format!(
+            "`{source}` with recursion limit {limit} unexpectedly succeeded"
+        ));
+        assert!(
+            matches!(
+                err.as_engine(),
+                Some(EngineError::RuntimeLimit(RuntimeLimitError::Recursion))
+            ),
+            "`{source}` with recursion limit {limit} failed with the wrong error: {err}"
+        );
+    }
+}
+
+/// KNOWN FAILURE: the loop-iteration limit is off by one for `for` loops,
+/// and inconsistent between loop kinds. `RuntimeLimits` documents
+/// `loop_iteration` as the "Max loop iterations before an error is thrown",
+/// and `while` loops honor that exactly, but a `for` loop gets to complete
+/// `limit + 1` iterations: `compile_for_loop` emits
+/// `IncrementLoopIteration` after each completed body (and the check in
+/// `IncrementLoopIteration::operation`,
+/// `core/engine/src/vm/opcode/iteration/loop_ops.rs`, compares the
+/// *pre-increment* count with `previous_iteration_count > max`), while
+/// `compile_while_loop` emits it before every condition check. So with
+/// limit 1, `for (let i = 0; i < 2; ++i) {}` completes but
+/// `let i = 0; while (i < 2) { ++i; }` errors.
+///
+/// Found by [`loop_iteration_limit_is_a_tight_bound`], which excludes this
+/// boundary and checks the actual behavior; this minimal, deterministic test
+/// pins the documented contract and is expected to FAIL until the off-by-one
+/// is fixed.
+#[test]
+fn loop_iteration_limit_off_by_one_known_failure() {
+    let context = &mut Context::default();
+    context.runtime_limits_mut().set_loop_iteration_limit(1);
+    let result = context.eval(Source::from_bytes("for (let i = 0; i < 2; ++i) { }"));
+    assert!(
+        result.is_err(),
+        "documented limit of at most 1 loop iteration, but a 2-iteration loop completed: {result:?}"
+    );
+}
