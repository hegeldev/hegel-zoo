+
+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+//
+// The predicates in this crate promise the *exact* sign of the underlying
+// determinant. f64 -> arbitrary-precision rational conversion is lossless, so
+// an oracle computing the same determinant with `BigRational` arithmetic
+// yields the ground-truth sign for any finite inputs. Each oracle below is a
+// transcription of the corresponding fast-path determinant formula from
+// lib.rs into exact rational arithmetic (no rounding), so it shares the sign
+// convention of the crate by construction.
+//
+// Exactness of Shewchuk-style predicates is only guaranteed when no
+// intermediate computation overflows or underflows (see the comment on the
+// omitted underflow guard in `orient2d`). The oracle properties therefore
+// draw coordinate exponents from ranges where the guarantee applies
+// (determinant degree d needs roughly |exponent| * d + slack < 1022).
+// Separate "extreme scale" tests deliberately step outside that window to
+// probe the documented underflow boundary.
+#[cfg(not(feature = "no_std"))]
+mod hegel_props {
+    use super::{incircle, insphere, orient2d, orient3d, Coord, Coord3D};
+    use hegel::generators::{self, Generator};
+    use num_rational::BigRational;
+    use num_traits::Zero;
+
+    // ---------------- exact rational oracles ----------------
+
+    /// Lossless conversion; panics on NaN/infinity, which the oracle-based
+    /// generators never produce.
+    fn rat(x: f64) -> BigRational {
+        BigRational::from_float(x).expect("finite f64")
+    }
+
+    /// Sign class of an f64: -1, 0 (includes -0.0), or +1.
+    fn sign_class(x: f64) -> i8 {
+        if x > 0.0 {
+            1
+        } else if x < 0.0 {
+            -1
+        } else {
+            0
+        }
+    }
+
+    fn rat_sign(r: &BigRational) -> i8 {
+        if r.is_zero() {
+            0
+        } else if r > &BigRational::zero() {
+            1
+        } else {
+            -1
+        }
+    }
+
+    /// Exact sign of the orient2d determinant (same formula as the fast path
+    /// in lib.rs, evaluated without rounding).
+    fn orient2d_exact_sign(pa: Coord<f64>, pb: Coord<f64>, pc: Coord<f64>) -> i8 {
+        let detleft = (rat(pa.x) - rat(pc.x)) * (rat(pb.y) - rat(pc.y));
+        let detright = (rat(pa.y) - rat(pc.y)) * (rat(pb.x) - rat(pc.x));
+        rat_sign(&(detleft - detright))
+    }
+
+    /// Exact sign of the orient3d determinant.
+    fn orient3d_exact_sign(
+        pa: Coord3D<f64>,
+        pb: Coord3D<f64>,
+        pc: Coord3D<f64>,
+        pd: Coord3D<f64>,
+    ) -> i8 {
+        let adx = rat(pa.x) - rat(pd.x);
+        let bdx = rat(pb.x) - rat(pd.x);
+        let cdx = rat(pc.x) - rat(pd.x);
+        let ady = rat(pa.y) - rat(pd.y);
+        let bdy = rat(pb.y) - rat(pd.y);
+        let cdy = rat(pc.y) - rat(pd.y);
+        let adz = rat(pa.z) - rat(pd.z);
+        let bdz = rat(pb.z) - rat(pd.z);
+        let cdz = rat(pc.z) - rat(pd.z);
+
+        let det = adz * (&bdx * &cdy - &cdx * &bdy) + bdz * (&cdx * &ady - &adx * &cdy)
+            + cdz * (&adx * &bdy - &bdx * &ady);
+        rat_sign(&det)
+    }
+
+    /// Exact sign of the incircle determinant.
+    fn incircle_exact_sign(
+        pa: Coord<f64>,
+        pb: Coord<f64>,
+        pc: Coord<f64>,
+        pd: Coord<f64>,
+    ) -> i8 {
+        let adx = rat(pa.x) - rat(pd.x);
+        let bdx = rat(pb.x) - rat(pd.x);
+        let cdx = rat(pc.x) - rat(pd.x);
+        let ady = rat(pa.y) - rat(pd.y);
+        let bdy = rat(pb.y) - rat(pd.y);
+        let cdy = rat(pc.y) - rat(pd.y);
+
+        let alift = &adx * &adx + &ady * &ady;
+        let blift = &bdx * &bdx + &bdy * &bdy;
+        let clift = &cdx * &cdx + &cdy * &cdy;
+
+        let det = alift * (&bdx * &cdy - &cdx * &bdy) + blift * (&cdx * &ady - &adx * &cdy)
+            + clift * (&adx * &bdy - &bdx * &ady);
+        rat_sign(&det)
+    }
+
+    /// Exact sign of the insphere determinant.
+    fn insphere_exact_sign(
+        pa: Coord3D<f64>,
+        pb: Coord3D<f64>,
+        pc: Coord3D<f64>,
+        pd: Coord3D<f64>,
+        pe: Coord3D<f64>,
+    ) -> i8 {
+        let aex = rat(pa.x) - rat(pe.x);
+        let bex = rat(pb.x) - rat(pe.x);
+        let cex = rat(pc.x) - rat(pe.x);
+        let dex = rat(pd.x) - rat(pe.x);
+        let aey = rat(pa.y) - rat(pe.y);
+        let bey = rat(pb.y) - rat(pe.y);
+        let cey = rat(pc.y) - rat(pe.y);
+        let dey = rat(pd.y) - rat(pe.y);
+        let aez = rat(pa.z) - rat(pe.z);
+        let bez = rat(pb.z) - rat(pe.z);
+        let cez = rat(pc.z) - rat(pe.z);
+        let dez = rat(pd.z) - rat(pe.z);
+
+        let ab = &aex * &bey - &bex * &aey;
+        let bc = &bex * &cey - &cex * &bey;
+        let cd = &cex * &dey - &dex * &cey;
+        let da = &dex * &aey - &aex * &dey;
+        let ac = &aex * &cey - &cex * &aey;
+        let bd = &bex * &dey - &dex * &bey;
+
+        let abc = &aez * &bc - &bez * &ac + &cez * &ab;
+        let bcd = &bez * &cd - &cez * &bd + &dez * &bc;
+        let cda = &cez * &da + &dez * &ac + &aez * &cd;
+        let dab = &dez * &ab + &aez * &bd + &bez * &da;
+
+        let alift = &aex * &aex + &aey * &aey + &aez * &aez;
+        let blift = &bex * &bex + &bey * &bey + &bez * &bez;
+        let clift = &cex * &cex + &cey * &cey + &cez * &cez;
+        let dlift = &dex * &dex + &dey * &dey + &dez * &dez;
+
+        let det = (dlift * abc - clift * dab) + (blift * cda - alift * bcd);
+        rat_sign(&det)
+    }
+
+    // ---------------- generator helpers ----------------
+
+    /// Exact power of two, valid for -1074 <= k <= 1023 (subnormals included).
+    fn pow2(k: i32) -> f64 {
+        assert!((-1074..=1023).contains(&k));
+        if k >= -1022 {
+            f64::from_bits(((k + 1023) as u64) << 52)
+        } else {
+            f64::from_bits(1u64 << (k + 1074))
+        }
+    }
+
+    /// Nudge `x` by up to 2 drawn ULPs in a drawn direction. This is where
+    /// adaptive precision switches tiers: nearly-degenerate configurations a
+    /// few ULPs off exact degeneracy.
+    ///
+    /// Values with magnitude below 2^-350 (including exact zeros, whose
+    /// 1-ULP neighbours are the deepest subnormals) are left unperturbed:
+    /// perturbing them creates coordinates in the underflow region where the
+    /// predicates are known to return wrong signs — see the canonical pinned
+    /// failure `prop_orient2d_oracle_subnormal_scale`. The exclusion keeps
+    /// the sibling properties testing everything else.
+    fn perturb_ulps(tc: &hegel::TestCase, x: f64) -> f64 {
+        if x.abs() < pow2(-350) {
+            // Still consume the draw so the choice sequence stays stable.
+            let _ = tc.draw(generators::integers::<i32>().min_value(-2).max_value(2));
+            return x;
+        }
+        perturb_ulps_raw(tc, x)
+    }
+
+    /// Unguarded ULP perturbation, used only by the pinned underflow test.
+    fn perturb_ulps_raw(tc: &hegel::TestCase, x: f64) -> f64 {
+        let n = tc.draw(generators::integers::<i32>().min_value(-2).max_value(2));
+        let mut y = x;
+        for _ in 0..n.unsigned_abs() {
+            y = if n > 0 { y.next_up() } else { y.next_down() };
+        }
+        y
+    }
+
+    /// Snap tiny nonzero mantissa-scale values to exactly 0. Unit-scale
+    /// draws can produce subnormals; scaled by 2^k they land in the
+    /// underflow region excluded above (see
+    /// `prop_orient2d_oracle_subnormal_scale`). Exact zeros are safe: their
+    /// differences and products are exact.
+    fn snap_tiny(x: f64) -> f64 {
+        if x != 0.0 && x.abs() < 3.0e-14 {
+            0.0
+        } else {
+            x
+        }
+    }
+
+    /// A finite f64 `m * 2^k` mixing unit-scale mantissas and integer
+    /// mantissas with exponents in [kmin, kmax]. Different draws land at
+    /// wildly different magnitudes, exercising tiny/huge magnitude mixes.
+    #[hegel::composite]
+    fn scaled_finite(tc: &hegel::TestCase, kmin: i32, kmax: i32) -> f64 {
+        let m = tc.draw(hegel::one_of!(
+            generators::floats::<f64>().min_value(-2.0).max_value(2.0).boxed(),
+            generators::integers::<i32>()
+                .min_value(-1000)
+                .max_value(1000)
+                .map(|i| i as f64)
+                .boxed(),
+        ));
+        let k = tc.draw(generators::integers::<i32>().min_value(kmin).max_value(kmax));
+        snap_tiny(m) * pow2(k)
+    }
+
+    /// Three points drawn independently coordinate-by-coordinate at mixed
+    /// magnitudes (|exponent| <= kmax).
+    #[hegel::composite]
+    fn arbitrary_triple(tc: &hegel::TestCase, kmax: i32) -> (Coord<f64>, Coord<f64>, Coord<f64>) {
+        let mut v = [0f64; 6];
+        for slot in v.iter_mut() {
+            *slot = tc.draw(scaled_finite(-kmax, kmax));
+        }
+        (
+            Coord { x: v[0], y: v[1] },
+            Coord { x: v[2], y: v[3] },
+            Coord { x: v[4], y: v[5] },
+        )
+    }
+
+    /// Three nearly-collinear points: b and c are placed on the line through
+    /// a with direction d (rounded to f64, hence *nearly* on the line), the
+    /// whole configuration is scaled by an exact power of two, and every
+    /// coordinate is then perturbed by a few ULPs.
+    #[hegel::composite]
+    fn near_collinear_triple(
+        tc: &hegel::TestCase,
+        kmax: i32,
+    ) -> (Coord<f64>, Coord<f64>, Coord<f64>) {
+        let unit = || {
+            generators::floats::<f64>()
+                .min_value(-2.0)
+                .max_value(2.0)
+        };
+        let ax = snap_tiny(tc.draw(unit()));
+        let ay = snap_tiny(tc.draw(unit()));
+        let dx = snap_tiny(tc.draw(unit()));
+        let dy = snap_tiny(tc.draw(unit()));
+        let t1 = snap_tiny(tc.draw(unit()));
+        let t2 = snap_tiny(tc.draw(unit()));
+        let s = pow2(tc.draw(generators::integers::<i32>().min_value(-kmax).max_value(kmax)));
+        let coords = [
+            ax,
+            ay,
+            ax + t1 * dx,
+            ay + t1 * dy,
+            ax + t2 * dx,
+            ay + t2 * dy,
+        ];
+        let mut p = [0f64; 6];
+        for (out, c) in p.iter_mut().zip(coords) {
+            *out = perturb_ulps(&tc, snap_tiny(c) * s);
+        }
+        (
+            Coord { x: p[0], y: p[1] },
+            Coord { x: p[2], y: p[3] },
+            Coord { x: p[4], y: p[5] },
+        )
+    }
+
+    /// Four points within a few ULPs of a common circle: exact-ish circle
+    /// points rounded to f64, scaled, then ULP-perturbed. Nearly-cocircular
+    /// inputs drive incircle into its deepest adaptive tiers.
+    #[hegel::composite]
+    fn near_cocircular_quad(
+        tc: &hegel::TestCase,
+    ) -> (Coord<f64>, Coord<f64>, Coord<f64>, Coord<f64>) {
+        let unit = || {
+            generators::floats::<f64>()
+                .min_value(-2.0)
+                .max_value(2.0)
+        };
+        let cx = tc.draw(unit());
+        let cy = tc.draw(unit());
+        let r = tc.draw(
+            generators::floats::<f64>()
+                .min_value(0.25)
+                .max_value(4.0),
+        );
+        let s = pow2(tc.draw(generators::integers::<i32>().min_value(-120).max_value(120)));
+        let mut pts = [Coord { x: 0.0, y: 0.0 }; 4];
+        for pt in pts.iter_mut() {
+            let theta = tc.draw(
+                generators::floats::<f64>()
+                    .min_value(0.0)
+                    .max_value(core::f64::consts::TAU),
+            );
+            pt.x = perturb_ulps(&tc, (cx + r * theta.cos()) * s);
+            pt.y = perturb_ulps(&tc, (cy + r * theta.sin()) * s);
+        }
+        (pts[0], pts[1], pts[2], pts[3])
+    }
+
+    /// Four nearly-coplanar 3D points: d is placed in the plane spanned by
+    /// (a, b, c) (rounded to f64), then everything is scaled and perturbed.
+    #[hegel::composite]
+    fn near_coplanar_quad(
+        tc: &hegel::TestCase,
+    ) -> (Coord3D<f64>, Coord3D<f64>, Coord3D<f64>, Coord3D<f64>) {
+        let unit = || {
+            generators::floats::<f64>()
+                .min_value(-2.0)
+                .max_value(2.0)
+        };
+        let mut v = [0f64; 9];
+        for slot in v.iter_mut() {
+            *slot = tc.draw(unit());
+        }
+        let (a, b, c) = (
+            [v[0], v[1], v[2]],
+            [v[3], v[4], v[5]],
+            [v[6], v[7], v[8]],
+        );
+        let s_par = tc.draw(unit());
+        let t_par = tc.draw(unit());
+        let d = [
+            a[0] + s_par * (b[0] - a[0]) + t_par * (c[0] - a[0]),
+            a[1] + s_par * (b[1] - a[1]) + t_par * (c[1] - a[1]),
+            a[2] + s_par * (b[2] - a[2]) + t_par * (c[2] - a[2]),
+        ];
+        let s = pow2(tc.draw(generators::integers::<i32>().min_value(-150).max_value(150)));
+        let mk = |p: [f64; 3], tc: &hegel::TestCase| Coord3D {
+            x: perturb_ulps(tc, p[0] * s),
+            y: perturb_ulps(tc, p[1] * s),
+            z: perturb_ulps(tc, p[2] * s),
+        };
+        (mk(a, &tc), mk(b, &tc), mk(c, &tc), mk(d, &tc))
+    }
+
+    /// Five points within a few ULPs of a common sphere.
+    #[hegel::composite]
+    fn near_cospherical_five(
+        tc: &hegel::TestCase,
+    ) -> (
+        Coord3D<f64>,
+        Coord3D<f64>,
+        Coord3D<f64>,
+        Coord3D<f64>,
+        Coord3D<f64>,
+    ) {
+        let unit = || {
+            generators::floats::<f64>()
+                .min_value(-2.0)
+                .max_value(2.0)
+        };
+        let cx = tc.draw(unit());
+        let cy = tc.draw(unit());
+        let cz = tc.draw(unit());
+        let r = tc.draw(
+            generators::floats::<f64>()
+                .min_value(0.25)
+                .max_value(4.0),
+        );
+        let s = pow2(tc.draw(generators::integers::<i32>().min_value(-100).max_value(100)));
+        let mut pts = [Coord3D {
+            x: 0.0,
+            y: 0.0,
+            z: 0.0,
+        }; 5];
+        for pt in pts.iter_mut() {
+            // Direction from a cube-drawn vector, rejected near zero length.
+            let ux = tc.draw(unit());
+            let uy = tc.draw(unit());
+            let uz = tc.draw(unit());
+            let norm = (ux * ux + uy * uy + uz * uz).sqrt();
+            tc.assume(norm > 0.05);
+            pt.x = perturb_ulps(&tc, (cx + r * ux / norm) * s);
+            pt.y = perturb_ulps(&tc, (cy + r * uy / norm) * s);
+            pt.z = perturb_ulps(&tc, (cz + r * uz / norm) * s);
+        }
+        (pts[0], pts[1], pts[2], pts[3], pts[4])
+    }
+
+    // ---------------- properties: exact oracle agreement ----------------
+
+    // Property: orient2d returns the exact sign of the determinant, on both
+    // nearly-collinear (deep adaptive tiers) and arbitrary mixed-magnitude
+    // inputs, within the no-overflow/no-underflow window (degree 2).
+    #[hegel::test]
+    fn prop_orient2d_sign_matches_exact_oracle(tc: hegel::TestCase) {
+        let (a, b, c) = tc.draw((hegel::one_of!(
+            near_collinear_triple(250).boxed(),
+            arbitrary_triple(250).boxed(),
+        )).print_as_debug());
+        assert_eq!(
+            sign_class(orient2d(a, b, c)),
+            orient2d_exact_sign(a, b, c),
+            "orient2d sign disagrees with exact rational oracle: a={a:?} b={b:?} c={c:?}"
+        );
+    }
+
+    // Property: orient3d returns the exact sign of the determinant on
+    // nearly-coplanar, ULP-perturbed, scale-mixed inputs (degree 3).
+    #[hegel::test]
+    fn prop_orient3d_sign_matches_exact_oracle(tc: hegel::TestCase) {
+        let (a, b, c, d) = tc.draw((near_coplanar_quad()).print_as_debug());
+        assert_eq!(
+            sign_class(orient3d(a, b, c, d)),
+            orient3d_exact_sign(a, b, c, d),
+            "orient3d sign disagrees with exact rational oracle: a={a:?} b={b:?} c={c:?} d={d:?}"
+        );
+    }
+
+    // Property: incircle returns the exact sign of the determinant on
+    // nearly-cocircular, ULP-perturbed, scale-mixed inputs (degree 4).
+    #[hegel::test]
+    fn prop_incircle_sign_matches_exact_oracle(tc: hegel::TestCase) {
+        let (a, b, c, d) = tc.draw((near_cocircular_quad()).print_as_debug());
+        assert_eq!(
+            sign_class(incircle(a, b, c, d)),
+            incircle_exact_sign(a, b, c, d),
+            "incircle sign disagrees with exact rational oracle: a={a:?} b={b:?} c={c:?} d={d:?}"
+        );
+    }
+
+    // Property: insphere returns the exact sign of the determinant on
+    // nearly-cospherical, ULP-perturbed, scale-mixed inputs (degree 5).
+    #[hegel::test]
+    fn prop_insphere_sign_matches_exact_oracle(tc: hegel::TestCase) {
+        let (a, b, c, d, e) = tc.draw((near_cospherical_five()).print_as_debug());
+        assert_eq!(
+            sign_class(insphere(a, b, c, d, e)),
+            insphere_exact_sign(a, b, c, d, e),
+            "insphere sign disagrees with exact rational oracle: \
+             a={a:?} b={b:?} c={c:?} d={d:?} e={e:?}"
+        );
+    }
+
+    // ---------------- properties: algebraic sign structure ----------------
+
+    // Property: swapping any two arguments of orient2d flips the sign
+    // (determinant row swap). Since the result sign is exact, the sign class
+    // must flip exactly, including 0 -> 0.
+    #[hegel::test]
+    fn prop_orient2d_swap_antisymmetry(tc: hegel::TestCase) {
+        let (a, b, c) = tc.draw((hegel::one_of!(
+            near_collinear_triple(250).boxed(),
+            arbitrary_triple(250).boxed(),
+        )).print_as_debug());
+        let base = sign_class(orient2d(a, b, c));
+        let swapped = match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => orient2d(b, a, c),
+            1 => orient2d(a, c, b),
+            _ => orient2d(c, b, a),
+        };
+        assert_eq!(
+            sign_class(swapped),
+            -base,
+            "swapping two points must flip the orient2d sign: a={a:?} b={b:?} c={c:?}"
+        );
+    }
+
+    // Property: orient2d is invariant under cyclic rotation of its arguments
+    // (an even permutation of determinant rows).
+    #[hegel::test]
+    fn prop_orient2d_cyclic_invariance(tc: hegel::TestCase) {
+        let (a, b, c) = tc.draw((hegel::one_of!(
+            near_collinear_triple(250).boxed(),
+            arbitrary_triple(250).boxed(),
+        )).print_as_debug());
+        let s0 = sign_class(orient2d(a, b, c));
+        assert_eq!(
+            sign_class(orient2d(b, c, a)),
+            s0,
+            "cyclic rotation must preserve the orient2d sign: a={a:?} b={b:?} c={c:?}"
+        );
+        assert_eq!(
+            sign_class(orient2d(c, a, b)),
+            s0,
+            "cyclic rotation must preserve the orient2d sign: a={a:?} b={b:?} c={c:?}"
+        );
+    }
+
+    // Property: swapping any two of the four incircle arguments flips the
+    // sign (row swap in the lifted 4x4 determinant).
+    #[hegel::test]
+    fn prop_incircle_swap_antisymmetry(tc: hegel::TestCase) {
+        let (a, b, c, d) = tc.draw((near_cocircular_quad()).print_as_debug());
+        let base = sign_class(incircle(a, b, c, d));
+        let swapped = match tc.draw(generators::integers::<u8>().max_value(3)) {
+            0 => incircle(b, a, c, d),
+            1 => incircle(a, c, b, d),
+            2 => incircle(a, b, d, c),
+            _ => incircle(d, b, c, a),
+        };
+        assert_eq!(
+            sign_class(swapped),
+            -base,
+            "swapping two points must flip the incircle sign: a={a:?} b={b:?} c={c:?} d={d:?}"
+        );
+    }
+
+    // Property: orient2d is consistent with orient3d on embedded points.
+    // For a, b, c embedded at z = 0 and an apex (px, py, -h) with h > 0, the
+    // 3D determinant equals h * orient2d-determinant exactly (as reals), so
+    // the signs must agree exactly.
+    #[hegel::test]
+    fn prop_orient2d_orient3d_embedding_consistency(tc: hegel::TestCase) {
+        let (a, b, c) = tc.draw((hegel::one_of!(
+            near_collinear_triple(150).boxed(),
+            arbitrary_triple(150).boxed(),
+        )).print_as_debug());
+        let px = tc.draw(scaled_finite(-150, 150));
+        let py = tc.draw(scaled_finite(-150, 150));
+        let h = tc.draw(
+            generators::floats::<f64>()
+                .min_value(0.5)
+                .max_value(2.0),
+        ) * pow2(tc.draw(generators::integers::<i32>().min_value(-150).max_value(150)));
+        let a3 = Coord3D { x: a.x, y: a.y, z: 0.0 };
+        let b3 = Coord3D { x: b.x, y: b.y, z: 0.0 };
+        let c3 = Coord3D { x: c.x, y: c.y, z: 0.0 };
+        let apex = Coord3D { x: px, y: py, z: -h };
+        assert_eq!(
+            sign_class(orient3d(a3, b3, c3, apex)),
+            sign_class(orient2d(a, b, c)),
+            "orient3d on z=0-embedded points must agree with orient2d: \
+             a={a:?} b={b:?} c={c:?} apex={apex:?}"
+        );
+    }
+
+    // ---------------- properties: exact degeneracies give exactly 0 -------
+
+    /// Draw an exact power-of-two scale and apply it to integer-valued
+    /// coordinates. For |v| < 2^38 and k >= -1074 the product v * 2^k is
+    /// exact, so scaled configurations stay *exactly* degenerate.
+    fn scale_exact(v: f64, k: i32) -> f64 {
+        v * pow2(k)
+    }
+
+    // Property: exactly collinear points (integer grid: a, a + i*d, a + j*d,
+    // exactly representable) yield exactly 0.0, at any exact power-of-two
+    // scale within the no-underflow window.
+    #[hegel::test]
+    fn prop_orient2d_exactly_collinear_is_zero(tc: hegel::TestCase) {
+        let int = |lo: i32, hi: i32| generators::integers::<i32>().min_value(lo).max_value(hi);
+        let x0 = tc.draw(int(-1 << 20, 1 << 20)) as f64;
+        let y0 = tc.draw(int(-1 << 20, 1 << 20)) as f64;
+        let dx = tc.draw(int(-1024, 1024)) as f64;
+        let dy = tc.draw(int(-1024, 1024)) as f64;
+        let i = tc.draw(int(-1024, 1024)) as f64;
+        let j = tc.draw(int(-1024, 1024)) as f64;
+        // Degree-2 determinant of ~2^22 coordinates: exponents in [-490, 480]
+        // keep every intermediate product inside the normal range.
+        let k = tc.draw(int(-490, 480));
+        let a = Coord {
+            x: scale_exact(x0, k),
+            y: scale_exact(y0, k),
+        };
+        let b = Coord {
+            x: scale_exact(x0 + i * dx, k),
+            y: scale_exact(y0 + i * dy, k),
+        };
+        let c = Coord {
+            x: scale_exact(x0 + j * dx, k),
+            y: scale_exact(y0 + j * dy, k),
+        };
+        let det = orient2d(a, b, c);
+        assert!(
+            det == 0.0,
+            "exactly collinear points must give exactly 0, got {det:e}: a={a:?} b={b:?} c={c:?}"
+        );
+    }
+
+    // Property: exactly coplanar 3D points (d = a + s*(b-a) + t*(c-a) with
+    // small integer coordinates, exactly representable) yield exactly 0.0.
+    #[hegel::test]
+    fn prop_orient3d_exactly_coplanar_is_zero(tc: hegel::TestCase) {
+        let int = |lo: i32, hi: i32| generators::integers::<i32>().min_value(lo).max_value(hi);
+        let mut p = [[0f64; 3]; 3];
+        for row in p.iter_mut() {
+            for coord in row.iter_mut() {
+                *coord = tc.draw(int(-1024, 1024)) as f64;
+            }
+        }
+        let s = tc.draw(int(-64, 64)) as f64;
+        let t = tc.draw(int(-64, 64)) as f64;
+        let d = [
+            p[0][0] + s * (p[1][0] - p[0][0]) + t * (p[2][0] - p[0][0]),
+            p[0][1] + s * (p[1][1] - p[0][1]) + t * (p[2][1] - p[0][1]),
+            p[0][2] + s * (p[1][2] - p[0][2]) + t * (p[2][2] - p[0][2]),
+        ];
+        // Coordinates are bounded by ~2^18; degree-3 determinant keeps
+        // intermediates in range for exponents in [-320, 320].
+        let k = tc.draw(int(-320, 320));
+        let mk = |v: [f64; 3]| Coord3D {
+            x: scale_exact(v[0], k),
+            y: scale_exact(v[1], k),
+            z: scale_exact(v[2], k),
+        };
+        let (a, b, c, d) = (mk(p[0]), mk(p[1]), mk(p[2]), mk(d));
+        let det = orient3d(a, b, c, d);
+        assert!(
+            det == 0.0,
+            "exactly coplanar points must give exactly 0, got {det:e}: \
+             a={a:?} b={b:?} c={c:?} d={d:?}"
+        );
+    }
+
+    // Property: four distinct points on an exactly-representable common
+    // circle (Pythagorean points with hypotenuse 65 around an integer
+    // center) yield incircle == exactly 0.0 at any exact scale in range.
+    #[hegel::test]
+    fn prop_incircle_exactly_cocircular_is_zero(tc: hegel::TestCase) {
+        // All integer points on the circle of radius 65 centered at origin.
+        let mut circle_pts: Vec<(i32, i32)> = Vec::new();
+        for &(x, y) in &[(65, 0), (16, 63), (33, 56), (25, 60), (39, 52)] {
+            for &(px, py) in &[(x, y), (y, x)] {
+                for &(sx, sy) in &[(1, 1), (1, -1), (-1, 1), (-1, -1)] {
+                    let cand = (px * sx, py * sy);
+                    if !circle_pts.contains(&cand) {
+                        circle_pts.push(cand);
+                    }
+                }
+            }
+        }
+        let idxs: Vec<usize> = tc.draw(
+            generators::vecs(generators::integers::<usize>().max_value(circle_pts.len() - 1))
+                .min_size(4)
+                .max_size(4)
+                .unique(true),
+        );
+        let int = |lo: i32, hi: i32| generators::integers::<i32>().min_value(lo).max_value(hi);
+        let cx = tc.draw(int(-1 << 20, 1 << 20));
+        let cy = tc.draw(int(-1 << 20, 1 << 20));
+        // Degree-4 determinant of ~2^22 coordinates: exponents in [-230, 230].
+        let k = tc.draw(int(-230, 230));
+        let mk = |i: usize| Coord {
+            x: scale_exact((circle_pts[i].0 + cx) as f64, k),
+            y: scale_exact((circle_pts[i].1 + cy) as f64, k),
+        };
+        let (a, b, c, d) = (mk(idxs[0]), mk(idxs[1]), mk(idxs[2]), mk(idxs[3]));
+        let det = incircle(a, b, c, d);
+        assert!(
+            det == 0.0,
+            "exactly cocircular points must give exactly 0, got {det:e}: \
+             a={a:?} b={b:?} c={c:?} d={d:?}"
+        );
+    }
+
+    // Property: five distinct points on an exactly-representable common
+    // sphere (integer points with |p|^2 = 9, e.g. permutations/signs of
+    // (1,2,2) and (3,0,0), around an integer center) yield insphere == 0.0.
+    #[hegel::test]
+    fn prop_insphere_exactly_cospherical_is_zero(tc: hegel::TestCase) {
+        let mut sphere_pts: Vec<(i32, i32, i32)> = Vec::new();
+        for x in -3i32..=3 {
+            for y in -3i32..=3 {
+                for z in -3i32..=3 {
+                    if x * x + y * y + z * z == 9 {
+                        sphere_pts.push((x, y, z));
+                    }
+                }
+            }
+        }
+        let idxs: Vec<usize> = tc.draw(
+            generators::vecs(generators::integers::<usize>().max_value(sphere_pts.len() - 1))
+                .min_size(5)
+                .max_size(5)
+                .unique(true),
+        );
+        let int = |lo: i32, hi: i32| generators::integers::<i32>().min_value(lo).max_value(hi);
+        let cx = tc.draw(int(-1 << 20, 1 << 20));
+        let cy = tc.draw(int(-1 << 20, 1 << 20));
+        let cz = tc.draw(int(-1 << 20, 1 << 20));
+        // Degree-5 determinant of ~2^22 coordinates: exponents in [-180, 180].
+        let k = tc.draw(int(-180, 180));
+        let mk = |i: usize| Coord3D {
+            x: scale_exact((sphere_pts[i].0 + cx) as f64, k),
+            y: scale_exact((sphere_pts[i].1 + cy) as f64, k),
+            z: scale_exact((sphere_pts[i].2 + cz) as f64, k),
+        };
+        let (a, b, c, d, e) = (
+            mk(idxs[0]),
+            mk(idxs[1]),
+            mk(idxs[2]),
+            mk(idxs[3]),
+            mk(idxs[4]),
+        );
+        let det = insphere(a, b, c, d, e);
+        assert!(
+            det == 0.0,
+            "exactly cospherical points must give exactly 0, got {det:e}: \
+             a={a:?} b={b:?} c={c:?} d={d:?} e={e:?}"
+        );
+    }
+
+    // ---------------- properties: robustness at the edges ----------------
+
+    // Property: no predicate panics on any f64 input, including NaN,
+    // infinities, subnormals, and f64::MAX (evidence: the crate ships fuzz
+    // targets feeding arbitrary f64s to orient2d/incircle).
+    #[hegel::test]
+    fn prop_predicates_never_panic_on_any_floats(tc: hegel::TestCase) {
+        let f = || tc.draw(generators::floats::<f64>());
+        let _ = orient2d(
+            Coord { x: f(), y: f() },
+            Coord { x: f(), y: f() },
+            Coord { x: f(), y: f() },
+        );
+        let _ = incircle(
+            Coord { x: f(), y: f() },
+            Coord { x: f(), y: f() },
+            Coord { x: f(), y: f() },
+            Coord { x: f(), y: f() },
+        );
+        let _ = orient3d(
+            Coord3D { x: f(), y: f(), z: f() },
+            Coord3D { x: f(), y: f(), z: f() },
+            Coord3D { x: f(), y: f(), z: f() },
+            Coord3D { x: f(), y: f(), z: f() },
+        );
+        let _ = insphere(
+            Coord3D { x: f(), y: f(), z: f() },
+            Coord3D { x: f(), y: f(), z: f() },
+            Coord3D { x: f(), y: f(), z: f() },
+            Coord3D { x: f(), y: f(), z: f() },
+            Coord3D { x: f(), y: f(), z: f() },
+        );
+    }
+
+    // Property (exploratory, targets the documented underflow boundary): the
+    // exactly-collinear-gives-0 property, but at subnormal scales where the
+    // exactness guarantee of Shewchuk-style predicates no longer applies
+    // (see the underflow-guard comment in `orient2d`).
+    #[hegel::test]
+    fn prop_orient2d_exactly_collinear_is_zero_subnormal_scale(tc: hegel::TestCase) {
+        let int = |lo: i32, hi: i32| generators::integers::<i32>().min_value(lo).max_value(hi);
+        let x0 = tc.draw(int(-1 << 20, 1 << 20)) as f64;
+        let y0 = tc.draw(int(-1 << 20, 1 << 20)) as f64;
+        let dx = tc.draw(int(-1024, 1024)) as f64;
+        let dy = tc.draw(int(-1024, 1024)) as f64;
+        let i = tc.draw(int(-1024, 1024)) as f64;
+        let j = tc.draw(int(-1024, 1024)) as f64;
+        // Scaled coordinates remain exact (|v| < 2^22, k >= -1074), but the
+        // determinant's intermediate products underflow.
+        let k = tc.draw(int(-1074, -500));
+        let a = Coord {
+            x: scale_exact(x0, k),
+            y: scale_exact(y0, k),
+        };
+        let b = Coord {
+            x: scale_exact(x0 + i * dx, k),
+            y: scale_exact(y0 + i * dy, k),
+        };
+        let c = Coord {
+            x: scale_exact(x0 + j * dx, k),
+            y: scale_exact(y0 + j * dy, k),
+        };
+        let det = orient2d(a, b, c);
+        assert!(
+            det == 0.0,
+            "exactly collinear points must give exactly 0, got {det:e}: a={a:?} b={b:?} c={c:?}"
+        );
+    }
+
+    // KNOWN FAILURE: orient2d returns the wrong sign when the determinant's
+    // intermediate products underflow. Minimal counterexample found by this
+    // test: a=(0,0), b=(0,5e-324), c=(5e-324,0). The exact determinant is
+    // -(5e-324)^2 < 0 (the points are NOT collinear), but both fast-path
+    // products underflow to zero, `detsum` (and hence `errbound`) is 0, and
+    // `det >= errbound` accepts det = -0.0, so orient2d reports "collinear".
+    // The public documentation ("Returns 0 if they are collinear") makes no
+    // underflow exception, but the implementation comment in `orient2d`
+    // acknowledges the omitted underflow guard means correct results are not
+    // guaranteed when intermediates underflow (Shewchuk's predicates carry
+    // the same assumption). Kept failing to document the bug; the boosted
+    // generator branch below makes the failure reproduce on every run.
+    //
+    // Property (underflow boundary): oracle agreement for orient2d on
+    // nearly-collinear configurations at subnormal scales.
+    #[hegel::test(test_cases = 200)]
+    fn prop_orient2d_oracle_subnormal_scale(tc: hegel::TestCase) {
+        let (a, b, c) = tc.draw((hegel::one_of!(
+            near_collinear_subnormal_triple().boxed(),
+            ulp_scale_axis_triple().boxed(),
+        )).print_as_debug());
+        assert_eq!(
+            sign_class(orient2d(a, b, c)),
+            orient2d_exact_sign(a, b, c),
+            "orient2d sign disagrees with exact rational oracle: a={a:?} b={b:?} c={c:?}"
+        );
+    }
+
+    /// Boosted branch pinning the counterexample region of
+    /// `prop_orient2d_oracle_subnormal_scale`: a right triangle whose legs
+    /// are a few subnormal ULPs long. Every such triple has a nonzero exact
+    /// determinant of magnitude ~2^-2148, far below f64 range.
+    #[hegel::composite]
+    fn ulp_scale_axis_triple(tc: &hegel::TestCase) -> (Coord<f64>, Coord<f64>, Coord<f64>) {
+        let ulps = || {
+            generators::integers::<i32>()
+                .min_value(-4)
+                .max_value(4)
+                .filter(|q| *q != 0)
+                .map(|q| q as f64 * f64::from_bits(1))
+        };
+        let a = Coord { x: 0.0, y: 0.0 };
+        let b = Coord {
+            x: 0.0,
+            y: tc.draw(ulps()),
+        };
+        let c = Coord {
+            x: tc.draw(ulps()),
+            y: 0.0,
+        };
+        (a, b, c)
+    }
+
+    /// Nearly-collinear triple scaled into (or near) the subnormal range.
+    #[hegel::composite]
+    fn near_collinear_subnormal_triple(
+        tc: &hegel::TestCase,
+    ) -> (Coord<f64>, Coord<f64>, Coord<f64>) {
+        let unit = || {
+            generators::floats::<f64>()
+                .min_value(-2.0)
+                .max_value(2.0)
+        };
+        let ax = tc.draw(unit());
+        let ay = tc.draw(unit());
+        let dx = tc.draw(unit());
+        let dy = tc.draw(unit());
+        let t1 = tc.draw(unit());
+        let t2 = tc.draw(unit());
+        let s = pow2(tc.draw(generators::integers::<i32>().min_value(-1074).max_value(-950)));
+        let coords = [
+            ax,
+            ay,
+            ax + t1 * dx,
+            ay + t1 * dy,
+            ax + t2 * dx,
+            ay + t2 * dy,
+        ];
+        let mut p = [0f64; 6];
+        for (out, c) in p.iter_mut().zip(coords) {
+            *out = perturb_ulps_raw(&tc, c * s);
+        }
+        (
+            Coord { x: p[0], y: p[1] },
+            Coord { x: p[2], y: p[3] },
+            Coord { x: p[4], y: p[5] },
+        )
+    }
+}
