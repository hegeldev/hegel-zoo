+/// quilt strips `[ \t]+#.*` from a series line before reading its options; the lossy
+/// `Series::read` keeps the comment words as options.
+#[test]
+fn lossy_series_drops_trailing_comments() {
+    let s = Series::read("a.patch -p1 # applied upstream\n".as_bytes()).unwrap();
+    let entries: Vec<_> = s.iter().collect();
+    assert_eq!(entries, vec![&SeriesEntry::Patch { name: "a.patch".to_string(), options: vec!["-p1".to_string()] }]);
+}
+
+/// Appending to a series file whose last line has no newline glues the new entry onto it.
+#[test]
+fn pushing_onto_a_series_without_a_final_newline() {
+    let mut tree = eseries::parse("a.patch").quilt_tree_mut();
+    tree.push("b.patch", std::iter::empty::<&str>());
+    let text = text_of(&tree);
+    let again = eseries::parse(&text).quilt_tree();
+    assert_eq!(cst_patches(&again), vec![("a.patch".to_string(), vec![]), ("b.patch".to_string(), vec![])], "text {text:?}");
+    let mut tree = eseries::parse("a.patch").quilt_tree_mut();
+    tree.add_comment("note");
+    let text = text_of(&tree);
+    assert_eq!(cst_comments(&eseries::parse(&text).quilt_tree()), vec!["note".to_string()], "text {text:?}");
+}
+
+/// `reorder` panics (a rowan "range end index out of range") on any series of two or more
+/// patches, whatever the order — even the current one; and by construction it would drop
+/// comments and blank lines ("skip this complex case" in the source).
+#[test]
+fn reorder_reorders() {
+    let mut tree = eseries::parse("a.patch\nb.patch -p1\n").quilt_tree_mut();
+    assert!(tree.reorder(&["b.patch".to_string(), "a.patch".to_string()]));
+    assert_eq!(cst_patches(&tree), vec![("b.patch".to_string(), vec!["-p1".to_string()]), ("a.patch".to_string(), vec![])]);
+    let text = "# first\na.patch\n\nb.patch -p1\n# last\n";
+    let mut tree = eseries::parse(text).quilt_tree_mut();
+    assert!(tree.reorder(&["b.patch".to_string(), "a.patch".to_string()]));
+    assert_eq!(cst_patches(&tree), vec![("b.patch".to_string(), vec!["-p1".to_string()]), ("a.patch".to_string(), vec![])]);
+    assert_eq!(cst_comments(&tree), vec!["first".to_string(), "last".to_string()], "text {:?}", text_of(&tree));
+    assert!(text_of(&tree).contains("\n\n"), "blank line kept: {:?}", text_of(&tree));
+}
