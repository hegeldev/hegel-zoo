+// ---------------------------------------------------------------------------
+// Timestamps
+// ---------------------------------------------------------------------------
+
+/// coreutils' wall-clock rendering of `secs` seen from `offset`, and the `+HHMM` zone.
+fn date_at(secs: i64, offset: i64) -> String {
+    let out = Command::new("date").env("TZ", "UTC").args(["-u", "-d", &format!("@{}", secs + offset), "+%Y-%m-%d %H:%M:%S"]).output().unwrap();
+    let wall = String::from_utf8(out.stdout).unwrap().trim().to_string();
+    let zone = format!("{}{:02}{:02}", if offset >= 0 { '+' } else { '-' }, offset.abs() / 3600, offset.abs() / 60 % 60);
+    format!("{wall} {zone}")
+}
+
+#[hegel::test]
+fn patch_dates_format_like_date(tc: hegel::TestCase) {
+    let secs = tc.draw(int!(0, 4_102_444_800)); // up to 2100
+    let offset = tc.draw(int!(-14 * 60, 14 * 60)) * 60;
+    let formatted = format_patch_date(secs, offset);
+    // The epoch is always given in UTC (documented); a pre-epoch wall-clock time is an error.
+    let eff = if secs == 0 { 0 } else { offset };
+    if secs + eff < 0 {
+        assert!(matches!(formatted, Err(FormatPatchDateError::NegativeTime(..))));
+        return;
+    }
+    let formatted = formatted.unwrap();
+    assert_eq!(formatted, date_at(secs, eff));
+    assert_eq!(parse_patch_date(&formatted).unwrap(), (secs, eff), "{formatted}");
+}
+
+#[hegel::test]
+fn patch_dates_parse_like_date(tc: hegel::TestCase) {
+    let secs = tc.draw(int!(0, 4_102_444_800));
+    let offset = tc.draw(int!(-14 * 60, 14 * 60)) * 60;
+    // Negative offsets with minutes (`-0330`, `-0030`) are pinned (`negative_offsets_with_minutes_parse`).
+    if secs + offset < 0 || (offset < 0 && offset % 3600 != 0) {
+        return;
+    }
+    let text = date_at(secs, offset);
+    assert_eq!(parse_patch_date(&text).unwrap(), (secs, offset), "{text}");
+    // Without the zone the error names the missing offset; garbage is an invalid date.
+    let (wall, _) = text.rsplit_once(' ').unwrap();
+    assert!(matches!(parse_patch_date(wall), Err(patchkit::timestamp::ParsePatchDateError::MissingTimezoneOffset(_))), "{wall}");
+    assert!(matches!(parse_patch_date(&format!("{wall} +2500")), Err(patchkit::timestamp::ParsePatchDateError::InvalidTimezoneOffset(_))));
+}
