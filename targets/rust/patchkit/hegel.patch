+// ---------------------------------------------------------------------------
+// Pinned bugs
+// ---------------------------------------------------------------------------
+
+/// A deleted `-- x` line is `--- x` in the patch; GNU patch counts lines from the hunk
+/// header, the `unified` parser too, but the CST takes it for the next file header.
+#[hegel::test]
+fn deleted_dash_dash_lines_stay_in_the_hunk(tc: hegel::TestCase) {
+    check_unified_cst("--- a/file\n+++ b/file\n@@ -1,3 +1,2 @@\n x\n--- sql comment\n y\n");
+    let dir = scratch();
+    let mut orig = tc.draw(arb_file(5).print_as_debug());
+    let at = tc.draw(int!(0, orig.lines.len() as i64)) as usize;
+    orig.lines.insert(at, pick(&tc, &["-- sql comment", "--", "---", "-- a -- b"]).to_string());
+    let mut modified = orig.clone();
+    modified.lines.remove(at);
+    let text = diff_with(&dir, &["-u", "--label", "a/file", "--label", "b/file"], &orig.bytes(), &modified.bytes());
+    std::fs::remove_dir_all(&dir).ok();
+    check_unified_cst(&text);
+}
+
+/// GNU diff quotes a file name with spaces (`--- "sp ace"\t…`); the `unified` parser keeps
+/// the quoted name, the CST's path token stops at the first space.
+#[test]
+fn quoted_paths_with_spaces_are_kept() {
+    let dir = scratch();
+    write(&dir, "sp ace", b"p q\n");
+    write(&dir, "c", b"p\n");
+    let out = Command::new("diff").current_dir(&dir).args(["-u", "sp ace", "c"]).output().unwrap();
+    std::fs::remove_dir_all(&dir).ok();
+    let text = String::from_utf8(out.stdout).unwrap();
+    assert!(text.starts_with("--- \"sp ace\"\t"), "diff quotes the name: {text:?}");
+    let (orig_name, _, _) = unified_model(&text);
+    assert_eq!(orig_name, "\"sp ace\"");
+    let tree = edit::parse(&text).tree();
+    let file = tree.patch_files().next().unwrap();
+    assert_eq!(file.old_path().as_deref(), Some("\"sp ace\""), "CST old path of {text:?}");
+}
