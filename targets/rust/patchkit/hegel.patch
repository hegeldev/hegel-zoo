+// ---------------------------------------------------------------------------
+// Normal-format diffs (the `ed` module)
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn normal_diff_output_parses_and_applies(tc: hegel::TestCase) {
+    let mut orig = tc.draw(arb_file(6).print_as_debug());
+    orig.final_newline = true;
+    let mut modified = arb_edits(&tc, &orig);
+    modified.final_newline = true;
+    let (o, m) = (orig.bytes(), modified.bytes());
+    if o == m {
+        return;
+    }
+    let dir = scratch();
+    let text = diff_normal(&dir, &o, &m);
+    // GNU patch reads it back to the modified file.
+    let g = gnu_patch(&dir, &o, &text, 0);
+    assert_eq!(g.code, 0);
+    assert_eq!(g.output, m);
+    let p = EdPatch::parse_patch(&text).unwrap_or_else(|e| panic!("EdPatch::parse_patch rejects {:?} at {:?}", String::from_utf8_lossy(&text), String::from_utf8_lossy(&e)));
+    let applied = std::panic::catch_unwind(|| p.apply_exact(&o)).unwrap_or_else(|_| panic!("apply_exact panicked on {:?}", String::from_utf8_lossy(&text)));
+    assert_eq!(String::from_utf8_lossy(&applied.unwrap()), String::from_utf8_lossy(&m), "{:?}", String::from_utf8_lossy(&text));
+    std::fs::remove_dir_all(&dir).unwrap();
+}
