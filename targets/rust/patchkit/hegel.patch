+/// A `\ No newline at end of file` marker on the old side of a normal `c` hunk ends the
+/// hunk; the `---` separator that follows is then read as a unified file header.
+#[hegel::test]
+fn normal_diff_no_newline_markers_stay_in_the_hunk(tc: hegel::TestCase) {
+    check_normal_cst("1c1\n< a\n\\ No newline at end of file\n---\n> b\n");
+    let dir = scratch();
+    let mut orig = tc.draw(arb_file(6).print_as_debug());
+    if orig.lines.is_empty() {
+        orig.lines.push("a".to_string());
+    }
+    orig.final_newline = false;
+    let mut modified = orig.clone();
+    let last = modified.lines.len() - 1;
+    modified.lines[last] = format!("{}!", modified.lines[last]);
+    modified.final_newline = tc.draw(int!(0, 1)) == 1;
+    let text = diff_with(&dir, &[], &orig.bytes(), &modified.bytes());
+    std::fs::remove_dir_all(&dir).ok();
+    check_normal_cst(&text);
+}
