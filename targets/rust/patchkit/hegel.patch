+/// `-p1` (the default strip level, and by far the most common option) on a plain patch name
+/// warns "Invalid strip level": the check compares the level with the number of `/` in the
+/// *series entry*, but `-pN` strips components from the paths inside the patch.
+#[test]
+fn strip_level_options_do_not_warn() {
+    for text in ["a.patch -p1\n", "0001-fix.patch -p1\n", "a.patch -p2\n"] {
+        let parsed = eseries::parse(text);
+        assert!(parsed.ok());
+        assert_eq!(parsed.warnings(), &[] as &[String], "warnings for {text:?}");
+    }
+}
