+/// A comment line is written back as itself, not with a second `#`.
+#[test]
+fn series_comments_round_trip() {
+    let s = Series::read(&b"# a comment\nfoo.patch -p1\n"[..]).unwrap();
+    let mut out = Vec::new();
+    s.write(&mut out).unwrap();
+    assert_eq!(String::from_utf8_lossy(&out), "# a comment\nfoo.patch -p1\n");
+}
