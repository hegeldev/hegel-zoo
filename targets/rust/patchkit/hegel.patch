+// ---------------------------------------------------------------------------
+// Scratch files and the external tools
+// ---------------------------------------------------------------------------
+
+/// A fresh scratch directory per call (one per test case; removed by the caller).
+fn scratch() -> PathBuf {
+    static N: AtomicUsize = AtomicUsize::new(0);
+    let dir = std::env::temp_dir().join(format!("hegel-zoo-patchkit-{}-{}", std::process::id(), N.fetch_add(1, Ordering::Relaxed)));
+    std::fs::create_dir_all(&dir).unwrap();
+    dir
+}
+
+fn write(dir: &Path, name: &str, data: &[u8]) -> PathBuf {
+    let p = dir.join(name);
+    if let Some(parent) = p.parent() {
+        std::fs::create_dir_all(parent).unwrap();
+    }
+    std::fs::write(&p, data).unwrap();
+    p
+}
+
+/// `diff -u` of two files; with `labels`, the names are `a/file` and `b/file` (no timestamps).
+fn diff_u(dir: &Path, orig: &[u8], modified: &[u8], labels: bool) -> Vec<u8> {
+    write(dir, "orig", orig);
+    write(dir, "mod", modified);
+    let mut cmd = Command::new("diff");
+    cmd.current_dir(dir).arg("-u");
+    if labels {
+        cmd.args(["--label", "a/file", "--label", "b/file"]);
+    }
+    let out = cmd.args(["orig", "mod"]).output().unwrap();
+    assert!(out.status.code() == Some(0) || out.status.code() == Some(1), "diff -u: {}", String::from_utf8_lossy(&out.stderr));
+    out.stdout
+}
+
+/// `diff` (normal format) of two files.
+fn diff_normal(dir: &Path, orig: &[u8], modified: &[u8]) -> Vec<u8> {
+    write(dir, "orig", orig);
+    write(dir, "mod", modified);
+    let out = Command::new("diff").current_dir(dir).args(["orig", "mod"]).output().unwrap();
+    assert!(out.status.code() == Some(0) || out.status.code() == Some(1), "diff: {}", String::from_utf8_lossy(&out.stderr));
+    out.stdout
+}
+
+/// What GNU patch did with a patch.
+#[derive(Debug, Clone, PartialEq)]
+struct GnuPatch {
+    /// Exit status: 0 all hunks applied, 1 some failed.
+    code: i32,
+    /// The output file (what patch left on disk).
+    output: Vec<u8>,
+    /// Per hunk (index, offset, fuzz), `None` for a failed hunk.
+    hunks: Vec<Option<(isize, usize)>>,
+}
+
+/// Run `patch -f -F<fuzz> -o out -r rej in < patch` and read its report.
+fn gnu_patch(dir: &Path, input: &[u8], patch: &[u8], fuzz: usize) -> GnuPatch {
+    let inp = write(dir, "in", input);
+    let outp = dir.join("out");
+    let rej = dir.join("rej");
+    let _ = std::fs::remove_file(&outp);
+    let mut child = Command::new("patch")
+        .current_dir(dir)
+        .arg("-f")
+        .arg("--no-backup-if-mismatch")
+        .arg(format!("-F{fuzz}"))
+        .arg("-o")
+        .arg(&outp)
+        .arg("-r")
+        .arg(&rej)
+        .arg(&inp)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    child.stdin.take().unwrap().write_all(patch).unwrap();
+    let out = child.wait_with_output().unwrap();
+    let code = out.status.code().unwrap_or(2);
+    assert!(code < 2, "patch failed: {}{}", String::from_utf8_lossy(&out.stdout), String::from_utf8_lossy(&out.stderr));
+    let output = std::fs::read(&outp).unwrap_or_default();
+    // "Hunk #2 succeeded at 5 with fuzz 1 (offset 2 lines)." / "Hunk #1 FAILED at 1."
+    let text = String::from_utf8_lossy(&out.stdout).to_string();
+    let n_hunks = patch.split(|&b| b == b'\n').filter(|l| l.starts_with(b"@@ ")).count();
+    let mut hunks = vec![Some((0isize, 0usize)); n_hunks];
+    for line in text.lines() {
+        let Some(rest) = line.strip_prefix("Hunk #") else { continue };
+        let (idx, rest) = rest.split_once(' ').unwrap();
+        let idx: usize = idx.parse().unwrap();
+        if rest.starts_with("FAILED") {
+            hunks[idx - 1] = None;
+        } else {
+            let mut fuzz = 0;
+            let mut offset = 0isize;
+            if let Some((_, f)) = rest.split_once("with fuzz ") {
+                fuzz = f.split(|c: char| !c.is_ascii_digit()).next().unwrap().parse().unwrap();
+            }
+            if let Some((_, o)) = rest.split_once("(offset ") {
+                offset = o.split(' ').next().unwrap().parse().unwrap();
+            }
+            hunks[idx - 1] = Some((offset, fuzz));
+        }
+    }
+    GnuPatch { code, output, hunks }
+}
+
+fn has(tool: &str) -> bool {
+    Command::new(tool).arg("--version").stdout(Stdio::null()).stderr(Stdio::null()).status().map(|s| s.success()).unwrap_or(false)
+}
