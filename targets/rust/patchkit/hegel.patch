+// ---------------------------------------------------------------------------
+// Quilt series files
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone)]
+enum GenSeriesLine {
+    Patch { name: String, options: Vec<String>, indent: bool },
+    Comment(String),
+    Blank,
+}
+
+#[hegel::composite]
+fn arb_series(tc: &hegel::TestCase) -> Vec<GenSeriesLine> {
+    let n = tc.draw(int!(0, 6)) as usize;
+    let mut used = Vec::new();
+    (0..n)
+        .map(|i| match tc.draw(int!(0, 5)) {
+            0 => GenSeriesLine::Comment(pick(tc, &["# leading comment", "#no-space", "# debian/patches", "#"]).to_string()),
+            1 => GenSeriesLine::Blank,
+            _ => {
+                let name = format!("{:04}-{}.{}", i, pick(tc, &["foo", "bar_baz", "fix.CVE-2026-1"]), pick(tc, &["patch", "diff"]));
+                used.push(name.clone());
+                let k = tc.draw(int!(0, 2)) as usize;
+                let options = (0..k).map(|_| pick(tc, &["-p1", "-p0", "-R", "-E"]).to_string()).collect();
+                GenSeriesLine::Patch { name, options, indent: tc.draw(int!(0, 3)) == 0 }
+            }
+        })
+        .collect()
+}
+
+fn series_text(lines: &[GenSeriesLine]) -> String {
+    let mut s = String::new();
+    for l in lines {
+        match l {
+            GenSeriesLine::Patch { name, options, indent } => {
+                if *indent {
+                    s.push_str("  ");
+                }
+                s.push_str(name);
+                for o in options {
+                    s.push(' ');
+                    s.push_str(o);
+                }
+                s.push('\n');
+            }
+            GenSeriesLine::Comment(c) => {
+                s.push_str(c);
+                s.push('\n');
+            }
+            GenSeriesLine::Blank => s.push('\n'),
+        }
+    }
+    s
+}
+
+#[hegel::test]
+fn series_files_are_read_like_quilt_and_round_trip(tc: hegel::TestCase) {
+    let g = tc.draw(arb_series().print_as_debug());
+    let text = series_text(&g);
+    let s = Series::read(text.as_bytes()).unwrap();
+    let patches: Vec<(String, Vec<String>)> = g.iter().filter_map(|l| if let GenSeriesLine::Patch { name, options, .. } = l { Some((name.clone(), options.clone())) } else { None }).collect();
+    let names: Vec<&str> = patches.iter().map(|(n, _)| n.as_str()).collect();
+    assert_eq!(s.patches().collect::<Vec<_>>(), names);
+    assert_eq!(s.len(), names.len());
+    assert_eq!(s.is_empty(), names.is_empty());
+    for (name, options) in &patches {
+        assert!(s.contains(name));
+        let entry = s.iter().find(|e| matches!(e, SeriesEntry::Patch { name: n, .. } if n == name)).unwrap();
+        assert_eq!(entry, &SeriesEntry::Patch { name: name.clone(), options: options.clone() });
+    }
+    let comments: Vec<&str> = g.iter().filter_map(|l| if let GenSeriesLine::Comment(c) = l { Some(c.as_str()) } else { None }).collect();
+    assert_eq!(s.iter().filter(|e| matches!(e, SeriesEntry::Comment(_))).count(), comments.len(), "comments kept");
+    // quilt lists the same patches.
+    if has("quilt") {
+        let dir = scratch();
+        write(&dir, "patches/series", text.as_bytes());
+        let out = Command::new("quilt").current_dir(&dir).args(["--quiltrc", "-", "series"]).output().unwrap();
+        let listed: Vec<String> = String::from_utf8_lossy(&out.stdout).lines().map(|l| l.to_string()).collect();
+        assert_eq!(listed, names, "quilt series");
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+    // write() then read() gives the same series (comments are pinned: `series_comments_round_trip`).
+    if comments.is_empty() {
+        let mut written = Vec::new();
+        s.write(&mut written).unwrap();
+        let again = Series::read(written.as_slice()).unwrap();
+        assert_eq!(again, s, "round trip through write():\n{}", String::from_utf8_lossy(&written));
+    }
+    // remove() removes exactly that patch.
+    if let Some((name, _)) = patches.first() {
+        let mut s2 = s.clone();
+        s2.remove(name);
+        assert!(!s2.contains(name));
+        assert_eq!(s2.len(), s.len() - names.iter().filter(|n| *n == name).count());
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Timestamps
+// ---------------------------------------------------------------------------
+
+/// coreutils' wall-clock rendering of `secs` seen from `offset`, and the `+HHMM` zone.
+fn date_at(secs: i64, offset: i64) -> String {
+    let out = Command::new("date").env("TZ", "UTC").args(["-u", "-d", &format!("@{}", secs + offset), "+%Y-%m-%d %H:%M:%S"]).output().unwrap();
+    let wall = String::from_utf8(out.stdout).unwrap().trim().to_string();
+    let zone = format!("{}{:02}{:02}", if offset >= 0 { '+' } else { '-' }, offset.abs() / 3600, offset.abs() / 60 % 60);
+    format!("{wall} {zone}")
+}
+
+#[hegel::test]
+fn patch_dates_format_like_date(tc: hegel::TestCase) {
+    let secs = tc.draw(int!(0, 4_102_444_800)); // up to 2100
+    let offset = tc.draw(int!(-14 * 60, 14 * 60)) * 60;
+    let formatted = format_patch_date(secs, offset);
+    // The epoch is always given in UTC (documented); a pre-epoch wall-clock time is an error.
+    let eff = if secs == 0 { 0 } else { offset };
+    if secs + eff < 0 {
+        assert!(matches!(formatted, Err(FormatPatchDateError::NegativeTime(..))));
+        return;
+    }
+    let formatted = formatted.unwrap();
+    assert_eq!(formatted, date_at(secs, eff));
+    assert_eq!(parse_patch_date(&formatted).unwrap(), (secs, eff), "{formatted}");
+}
+
+#[hegel::test]
+fn patch_dates_parse_like_date(tc: hegel::TestCase) {
+    let secs = tc.draw(int!(0, 4_102_444_800));
+    let offset = tc.draw(int!(-14 * 60, 14 * 60)) * 60;
+    // Negative offsets with minutes (`-0330`, `-0030`) are pinned (`negative_offsets_with_minutes_parse`).
+    if secs + offset < 0 || (offset < 0 && offset % 3600 != 0) {
+        return;
+    }
+    let text = date_at(secs, offset);
+    assert_eq!(parse_patch_date(&text).unwrap(), (secs, offset), "{text}");
+    // Without the zone the error names the missing offset; garbage is an invalid date.
+    let (wall, _) = text.rsplit_once(' ').unwrap();
+    assert!(matches!(parse_patch_date(wall), Err(patchkit::timestamp::ParsePatchDateError::MissingTimezoneOffset(_))), "{wall}");
+    assert!(matches!(parse_patch_date(&format!("{wall} +2500")), Err(patchkit::timestamp::ParsePatchDateError::InvalidTimezoneOffset(_))));
+}
+
+// ---------------------------------------------------------------------------
+// Pins
+// ---------------------------------------------------------------------------
+
+/// The wall-clock part of a patch date is the time *at the offset* (bzr's `gmtime(secs + offset)`).
+#[test]
+fn format_patch_date_applies_the_offset() {
+    assert_eq!(format_patch_date(1546300800, 3600).unwrap(), "2019-01-01 01:00:00 +0100");
+    assert_eq!(format_patch_date(1546300800, -5 * 3600).unwrap(), "2018-12-31 19:00:00 -0500");
+    assert_eq!(parse_patch_date(&format_patch_date(1546300800, 3600).unwrap()).unwrap(), (1546300800, 3600));
+}
+
+/// `-0330` (Newfoundland) is three and a half hours *behind* UTC: the minutes carry the sign
+/// too, also when the hour field is `00`.
+#[test]
+fn negative_offsets_with_minutes_parse() {
+    assert_eq!(parse_patch_date("2019-01-01 00:00:00 -0330").unwrap(), (1546300800 + 3 * 3600 + 1800, -(3 * 3600 + 1800)));
+    assert_eq!(parse_patch_date("2019-01-01 00:00:00 -0030").unwrap(), (1546300800 + 1800, -1800));
+    assert_eq!(parse_patch_date("2019-01-01 00:00:00 +0330").unwrap(), (1546300800 - 3 * 3600 - 1800, 3 * 3600 + 1800));
+}
+
+/// GNU diff's default timestamps carry nanoseconds: `2026-09-14 01:54:15.100545957 +0000`.
+#[test]
+fn diff_timestamps_with_fractions_parse() {
+    let (secs, off) = parse_patch_date("2019-01-01 00:00:00.123456789 +0100").unwrap_or_else(|e| panic!("{e:?}"));
+    assert_eq!((secs, off), (1546300800 - 3600, 3600));
+}
+
+/// `diff` normal output uses `5a6,7` ranges and line numbers that differ on the two sides.
+#[test]
+fn normal_diff_ranges_parse_and_apply() {
+    let orig = b"a\nb\n";
+    let modified = b"a\nb\nc\nd\n";
+    let text = b"2a3,4\n> c\n> d\n";
+    let p = EdPatch::parse_patch(text).unwrap_or_else(|e| panic!("rejects {:?} at {:?}", String::from_utf8_lossy(text), String::from_utf8_lossy(&e)));
+    assert_eq!(p.apply_exact(orig).unwrap(), modified);
+}
+
+/// `Na M` adds after line N of the old file (`0a1` at the top); `Nd M` deletes line N; `Nc M`
+/// replaces it. The two numbers differ whenever earlier hunks changed the line count.
+#[test]
+fn normal_diff_single_line_hunks_apply_like_patch() {
+    let cases: &[(&[u8], &[u8], &[u8])] = &[
+        (b"0a1\n> a\n", b"b\n", b"a\nb\n"),
+        (b"1a2\n> b\n", b"a\nc\n", b"a\nb\nc\n"),
+        (b"2d1\n< b\n", b"a\nb\n", b"a\n"),
+        (b"1c1\n< a\n---\n> x\n", b"a\nb\n", b"x\nb\n"),
+        (b"1d0\n< a\n2a2\n> z\n", b"a\nb\nc\n", b"b\nz\nc\n"),
+    ];
+    let mut failures = Vec::new();
+    let dir = scratch();
+    for (text, orig, modified) in cases {
+        // GNU patch agrees with the expectation.
+        let g = gnu_patch(&dir, orig, text, 0);
+        assert_eq!((g.code, String::from_utf8_lossy(&g.output)), (0, String::from_utf8_lossy(modified)), "patch(1) on {:?}", String::from_utf8_lossy(text));
+        let p = match EdPatch::parse_patch(text) {
+            Ok(p) => p,
+            Err(e) => {
+                failures.push(format!("{:?}: parse rejects {:?}", String::from_utf8_lossy(text), String::from_utf8_lossy(&e)));
+                continue;
+            }
+        };
+        match std::panic::catch_unwind(|| p.apply_exact(orig)) {
+            Err(_) => failures.push(format!("{:?}: apply panics", String::from_utf8_lossy(text))),
+            Ok(Err(e)) => failures.push(format!("{:?}: apply fails: {e}", String::from_utf8_lossy(text))),
+            Ok(Ok(got)) if got != *modified => failures.push(format!("{:?}: applied {:?}, patch(1) gives {:?}", String::from_utf8_lossy(text), String::from_utf8_lossy(&got), String::from_utf8_lossy(modified))),
+            Ok(Ok(_)) => {}
+        }
+    }
+    assert!(failures.is_empty(), "{failures:#?}");
+}
+
+/// A comment line is written back as itself, not with a second `#`.
+#[test]
+fn series_comments_round_trip() {
+    let s = Series::read(&b"# a comment\nfoo.patch -p1\n"[..]).unwrap();
+    let mut out = Vec::new();
+    s.write(&mut out).unwrap();
+    assert_eq!(String::from_utf8_lossy(&out), "# a comment\nfoo.patch -p1\n");
+}
