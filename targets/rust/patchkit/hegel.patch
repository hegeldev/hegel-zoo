+// ---------------------------------------------------------------------------
+// Pins
+// ---------------------------------------------------------------------------
+
+/// The wall-clock part of a patch date is the time *at the offset* (bzr's `gmtime(secs + offset)`).
+#[test]
+fn format_patch_date_applies_the_offset() {
+    assert_eq!(format_patch_date(1546300800, 3600).unwrap(), "2019-01-01 01:00:00 +0100");
+    assert_eq!(format_patch_date(1546300800, -5 * 3600).unwrap(), "2018-12-31 19:00:00 -0500");
+    assert_eq!(parse_patch_date(&format_patch_date(1546300800, 3600).unwrap()).unwrap(), (1546300800, 3600));
+}
+
+/// `-0330` (Newfoundland) is three and a half hours *behind* UTC: the minutes carry the sign
+/// too, also when the hour field is `00`.
+#[test]
+fn negative_offsets_with_minutes_parse() {
+    assert_eq!(parse_patch_date("2019-01-01 00:00:00 -0330").unwrap(), (1546300800 + 3 * 3600 + 1800, -(3 * 3600 + 1800)));
+    assert_eq!(parse_patch_date("2019-01-01 00:00:00 -0030").unwrap(), (1546300800 + 1800, -1800));
+    assert_eq!(parse_patch_date("2019-01-01 00:00:00 +0330").unwrap(), (1546300800 - 3 * 3600 - 1800, 3 * 3600 + 1800));
+}
+
+/// GNU diff's default timestamps carry nanoseconds: `2026-09-14 01:54:15.100545957 +0000`.
+#[test]
+fn diff_timestamps_with_fractions_parse() {
+    let (secs, off) = parse_patch_date("2019-01-01 00:00:00.123456789 +0100").unwrap_or_else(|e| panic!("{e:?}"));
+    assert_eq!((secs, off), (1546300800 - 3600, 3600));
+}
