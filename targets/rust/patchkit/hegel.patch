+// ---------------------------------------------------------------------------
+// Fuzzy application against GNU patch
+// ---------------------------------------------------------------------------
+
+/// Perturb a file: prepend/append/insert lines, change a line.
+fn perturb(tc: &hegel::TestCase, file: &GenFile) -> GenFile {
+    let mut lines = file.lines.clone();
+    let n = tc.draw(int!(1, 3));
+    for _ in 0..n {
+        match tc.draw(int!(0, 3)) {
+            0 => lines.insert(0, arb_line(tc)),
+            1 => lines.push(arb_line(tc)),
+            2 => {
+                let at = tc.draw(int!(0, lines.len() as i64)) as usize;
+                lines.insert(at, arb_line(tc));
+            }
+            _ if !lines.is_empty() => {
+                let at = tc.draw(int!(0, lines.len() as i64 - 1)) as usize;
+                lines[at] = arb_line(tc);
+            }
+            _ => {}
+        }
+    }
+    GenFile { lines, final_newline: true }
+}
+
+#[hegel::test]
+fn fuzzy_application_agrees_with_gnu_patch(tc: hegel::TestCase) {
+    let mut orig = tc.draw(arb_file(10).print_as_debug());
+    orig.final_newline = true;
+    let mut modified = arb_edits(&tc, &orig);
+    modified.final_newline = true;
+    let (o, m) = (orig.bytes(), modified.bytes());
+    if o == m {
+        return;
+    }
+    let target = perturb(&tc, &orig).bytes();
+    let fuzz = tc.draw(int!(0, 2)) as usize;
+    let dir = scratch();
+    let text = diff_u(&dir, &o, &m, true);
+    let p = parse_unified(&text);
+    let g = gnu_patch(&dir, &target, &text, fuzz);
+    let r = p.apply_fuzzy(&target, &ApplyOptions::with_fuzz(fuzz));
+    let show = || format!("patch:\n{}\ntarget:\n{}\nfuzz {fuzz}\npatch(1): {:?}\npatchkit: {:?}", String::from_utf8_lossy(&text), String::from_utf8_lossy(&target), g.hunks, r.hunks);
+    assert_eq!(r.is_success(), g.code == 0, "success: {}", show());
+    let mine: Vec<Option<(isize, usize)>> = r.hunks.iter().map(|h| h.applied().then_some((h.offset, h.fuzz))).collect();
+    assert_eq!(mine, g.hunks, "per-hunk outcome: {}", show());
+    if g.code == 0 {
+        assert_eq!(String::from_utf8_lossy(r.patched.as_deref().unwrap()), String::from_utf8_lossy(&g.output), "patched: {}", show());
+    }
+    assert_eq!(String::from_utf8_lossy(r.partial.as_deref().unwrap()), String::from_utf8_lossy(&g.output), "partial: {}", show());
+    let d = p.dry_run(&target, &ApplyOptions::with_fuzz(fuzz));
+    assert_eq!(d.hunks, r.hunks);
+    std::fs::remove_dir_all(&dir).unwrap();
+}
