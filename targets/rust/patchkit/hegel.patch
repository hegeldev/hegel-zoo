+/// GNU diff's default headers carry `name\tYYYY-MM-DD HH:MM:SS.NNNNNNNNN +ZZZZ` timestamps.
+#[hegel::test]
+fn diff_u_timestamps_are_split_off_and_parse(tc: hegel::TestCase) {
+    let orig = tc.draw(arb_file(6).print_as_debug());
+    let modified = arb_edits(&tc, &orig);
+    let (o, m) = (orig.bytes(), modified.bytes());
+    if o == m {
+        return;
+    }
+    let dir = scratch();
+    let text = diff_u(&dir, &o, &m, false);
+    let p = parse_unified(&text);
+    assert_eq!(p.orig_name, b"orig");
+    assert_eq!(p.mod_name, b"mod");
+    let header: Vec<&[u8]> = splitlines(&text).take(2).collect();
+    let ts_of = |line: &[u8]| line.split(|&b| b == b'\t').nth(1).unwrap().strip_suffix(b"\n").unwrap().to_vec();
+    assert_eq!(p.orig_ts.as_deref(), Some(ts_of(header[0]).as_slice()));
+    assert_eq!(p.mod_ts.as_deref(), Some(ts_of(header[1]).as_slice()));
+    assert_eq!(p.as_bytes(), text);
+    assert_eq!(p.apply_exact(&o).unwrap(), m);
+    // The timestamp diff writes is a patch date with nanoseconds; that it parses is pinned
+    // (`diff_timestamps_with_fractions_parse`), the shape is checked here.
+    let ts = String::from_utf8(p.orig_ts.clone().unwrap()).unwrap();
+    let re = regex::Regex::new(r"^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d\.\d{9} [+-]\d{4}$").unwrap();
+    assert!(re.is_match(&ts), "{ts:?}");
+    std::fs::remove_dir_all(&dir).unwrap();
+}
