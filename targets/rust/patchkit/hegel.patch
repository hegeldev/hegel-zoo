+// ---------------------------------------------------------------------------
+// Multi-file patches (diff -ruN)
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn recursive_diffs_are_split_per_file_and_apply(tc: hegel::TestCase) {
+    let n = tc.draw(int!(1, 3)) as usize;
+    let names = ["one.txt", "sub/two.c", "three"];
+    let mut files: Vec<(&str, Option<Vec<u8>>, Option<Vec<u8>>)> = Vec::new();
+    for name in names.iter().take(n) {
+        let kind = tc.draw(int!(0, 3));
+        let f = tc.draw(arb_file(5).print_as_debug());
+        let (a, b) = match kind {
+            0 => (Some(f.bytes()), Some(arb_edits(&tc, &f).bytes())), // changed (maybe not)
+            1 => (None, Some(f.bytes())),                              // added
+            2 => (Some(f.bytes()), None),                              // removed
+            _ => (Some(f.bytes()), Some(f.bytes())),                   // unchanged
+        };
+        files.push((name, a, b));
+    }
+    let dir = scratch();
+    for (name, a, b) in &files {
+        if let Some(a) = a {
+            write(&dir, &format!("a/{name}"), a);
+        }
+        if let Some(b) = b {
+            write(&dir, &format!("b/{name}"), b);
+        }
+    }
+    std::fs::create_dir_all(dir.join("a")).unwrap();
+    std::fs::create_dir_all(dir.join("b")).unwrap();
+    let out = Command::new("diff").current_dir(&dir).args(["-ruN", "a", "b"]).output().unwrap();
+    assert!(out.status.code() == Some(0) || out.status.code() == Some(1));
+    let text = out.stdout;
+    let patches = UnifiedPatch::parse_patches(splitlines(&text).map(|l| l.to_vec())).unwrap_or_else(|e| panic!("parse_patches: {e}\n{}", String::from_utf8_lossy(&text)));
+    // `-N` treats an absent file as empty, so an empty added file is no change.
+    let changed: Vec<&(&str, Option<Vec<u8>>, Option<Vec<u8>>)> = files.iter().filter(|(_, a, b)| a.clone().unwrap_or_default() != b.clone().unwrap_or_default()).collect();
+    assert_eq!(patches.len(), changed.len(), "one patch per changed file:\n{}", String::from_utf8_lossy(&text));
+    let mut seen = Vec::new();
+    for p in &patches {
+        let PlainOrBinaryPatch::Plain(p) = p else { panic!("binary?") };
+        let name = String::from_utf8(p.orig_name.clone()).unwrap();
+        let name = name.strip_prefix("a/").unwrap().to_string();
+        assert_eq!(p.mod_name, format!("b/{name}").as_bytes());
+        let orig_path = String::from_utf8_lossy(&p.orig_name).to_string();
+        assert_eq!(patchkit::strip_prefix(Path::new(&orig_path), 1), Path::new(&name));
+        let (_, a, b) = files.iter().find(|(n, _, _)| *n == name).unwrap_or_else(|| panic!("unknown file {name}"));
+        let a = a.clone().unwrap_or_default();
+        let b = b.clone().unwrap_or_default();
+        assert_eq!(String::from_utf8_lossy(&p.apply_exact(&a).unwrap()), String::from_utf8_lossy(&b), "{name}");
+        seen.push(name);
+    }
+    if has("lsdiff") {
+        let ls = Command::new("lsdiff").current_dir(&dir).stdin(Stdio::piped()).stdout(Stdio::piped()).spawn().unwrap();
+        let mut ls = ls;
+        ls.stdin.take().unwrap().write_all(&text).unwrap();
+        let ls = ls.wait_with_output().unwrap();
+        // lsdiff prints whichever of the two names it considers best (`a/…` for a removed file).
+        let listed: Vec<String> = String::from_utf8_lossy(&ls.stdout).lines().map(|l| l.trim_start_matches("b/").trim_start_matches("a/").to_string()).collect();
+        assert_eq!(seen, listed, "lsdiff");
+    }
+    std::fs::remove_dir_all(&dir).unwrap();
+}
