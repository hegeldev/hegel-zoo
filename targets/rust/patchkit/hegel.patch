+/// A whitespace-only last line without a final newline is an "Expected patch name or
+/// comment" error (with the newline it is a blank line; quilt ignores it either way).
+#[test]
+fn whitespace_only_last_line_is_not_an_error() {
+    for text in ["  ", "\t", "a.patch\n  "] {
+        let parsed = eseries::parse(text);
+        assert!(parsed.ok(), "errors {:?} for {text:?}", parsed.errors());
+        assert_eq!(text_of(&parsed.quilt_tree()), text);
+    }
+}
