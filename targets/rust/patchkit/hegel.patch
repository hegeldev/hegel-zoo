+// ---------------------------------------------------------------------------
+// Quilt series files
+// ---------------------------------------------------------------------------
+
+#[derive(Debug, Clone)]
+enum GenSeriesLine {
+    Patch { name: String, options: Vec<String>, indent: bool },
+    Comment(String),
+    Blank,
+}
+
+#[hegel::composite]
+fn arb_series(tc: &hegel::TestCase) -> Vec<GenSeriesLine> {
+    let n = tc.draw(int!(0, 6)) as usize;
+    let mut used = Vec::new();
+    (0..n)
+        .map(|i| match tc.draw(int!(0, 5)) {
+            0 => GenSeriesLine::Comment(pick(tc, &["# leading comment", "#no-space", "# debian/patches", "#"]).to_string()),
+            1 => GenSeriesLine::Blank,
+            _ => {
+                let name = format!("{:04}-{}.{}", i, pick(tc, &["foo", "bar_baz", "fix.CVE-2026-1"]), pick(tc, &["patch", "diff"]));
+                used.push(name.clone());
+                let k = tc.draw(int!(0, 2)) as usize;
+                let options = (0..k).map(|_| pick(tc, &["-p1", "-p0", "-R", "-E"]).to_string()).collect();
+                GenSeriesLine::Patch { name, options, indent: tc.draw(int!(0, 3)) == 0 }
+            }
+        })
+        .collect()
+}
+
+fn series_text(lines: &[GenSeriesLine]) -> String {
+    let mut s = String::new();
+    for l in lines {
+        match l {
+            GenSeriesLine::Patch { name, options, indent } => {
+                if *indent {
+                    s.push_str("  ");
+                }
+                s.push_str(name);
+                for o in options {
+                    s.push(' ');
+                    s.push_str(o);
+                }
+                s.push('\n');
+            }
+            GenSeriesLine::Comment(c) => {
+                s.push_str(c);
+                s.push('\n');
+            }
+            GenSeriesLine::Blank => s.push('\n'),
+        }
+    }
+    s
+}
+
+#[hegel::test]
+fn series_files_are_read_like_quilt_and_round_trip(tc: hegel::TestCase) {
+    let g = tc.draw(arb_series().print_as_debug());
+    let text = series_text(&g);
+    let s = Series::read(text.as_bytes()).unwrap();
+    let patches: Vec<(String, Vec<String>)> = g.iter().filter_map(|l| if let GenSeriesLine::Patch { name, options, .. } = l { Some((name.clone(), options.clone())) } else { None }).collect();
+    let names: Vec<&str> = patches.iter().map(|(n, _)| n.as_str()).collect();
+    assert_eq!(s.patches().collect::<Vec<_>>(), names);
+    assert_eq!(s.len(), names.len());
+    assert_eq!(s.is_empty(), names.is_empty());
+    for (name, options) in &patches {
+        assert!(s.contains(name));
+        let entry = s.iter().find(|e| matches!(e, SeriesEntry::Patch { name: n, .. } if n == name)).unwrap();
+        assert_eq!(entry, &SeriesEntry::Patch { name: name.clone(), options: options.clone() });
+    }
+    let comments: Vec<&str> = g.iter().filter_map(|l| if let GenSeriesLine::Comment(c) = l { Some(c.as_str()) } else { None }).collect();
+    assert_eq!(s.iter().filter(|e| matches!(e, SeriesEntry::Comment(_))).count(), comments.len(), "comments kept");
+    // quilt lists the same patches.
+    if has("quilt") {
+        let dir = scratch();
+        write(&dir, "patches/series", text.as_bytes());
+        let out = Command::new("quilt").current_dir(&dir).args(["--quiltrc", "-", "series"]).output().unwrap();
+        let listed: Vec<String> = String::from_utf8_lossy(&out.stdout).lines().map(|l| l.to_string()).collect();
+        assert_eq!(listed, names, "quilt series");
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+    // write() then read() gives the same series (comments are pinned: `series_comments_round_trip`).
+    if comments.is_empty() {
+        let mut written = Vec::new();
+        s.write(&mut written).unwrap();
+        let again = Series::read(written.as_slice()).unwrap();
+        assert_eq!(again, s, "round trip through write():\n{}", String::from_utf8_lossy(&written));
+    }
+    // remove() removes exactly that patch.
+    if let Some((name, _)) = patches.first() {
+        let mut s2 = s.clone();
+        s2.remove(name);
+        assert!(!s2.contains(name));
+        assert_eq!(s2.len(), s.len() - names.iter().filter(|n| *n == name).count());
+    }
+}
