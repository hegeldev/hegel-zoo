+//! Hegel property tests for patchkit.
+//!
+//! References: **GNU diff** (`diff -u`, `diff -ruN`, and its normal format) writes the
+//! patches the parsers read, **GNU patch** (`patch -F<fuzz> -f -o out`) is the reference
+//! for exact and fuzzy application (success, patched content, per-hunk offset and fuzz,
+//! what is left on disk after a partial failure), **patchutils' `lsdiff`** for the file
+//! names of a multi-file patch, **quilt** (`quilt series`) for series files, and
+//! **coreutils `date`** for patch timestamps.
+
+use hegel::generators;
+use hegel::Generator;
+use patchkit::apply::ApplyOptions;
+use patchkit::ed::EdPatch;
+use patchkit::quilt::{Series, SeriesEntry};
+use patchkit::timestamp::{format_patch_date, parse_patch_date, FormatPatchDateError};
+use patchkit::unified::{splitlines, HunkLine, PlainOrBinaryPatch, UnifiedPatch};
+use patchkit::ContentPatch;
+use std::fmt::Debug;
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
