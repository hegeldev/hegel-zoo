+// ---------------------------------------------------------------------------
+// Generators
+// ---------------------------------------------------------------------------
+
+fn pick<T: Clone + Send + Sync + Debug + 'static>(tc: &hegel::TestCase, items: &[T]) -> T {
+    tc.draw(generators::sampled_from(items.to_vec()).print_as_debug())
+}
+
+const WORDS: &[&str] = &["a", "b", "c", "d", "x y", "", "\t", "--- not a header", "+plus", "@@ -1 +1 @@", "\\ backslash"];
+
+fn arb_line(tc: &hegel::TestCase) -> Vec<u8> {
+    format!("{}\n", pick(tc, WORDS)).into_bytes()
+}
+
+/// A file of 0–10 lines, sometimes without a final newline.
+#[derive(Debug, Clone)]
+struct GenFile {
+    lines: Vec<Vec<u8>>,
+    final_newline: bool,
+}
+
+impl GenFile {
+    fn bytes(&self) -> Vec<u8> {
+        let mut b = self.lines.concat();
+        if !self.final_newline && b.ends_with(b"\n") {
+            b.pop();
+        }
+        b
+    }
+}
+
+#[hegel::composite]
+fn arb_file(tc: &hegel::TestCase, max_lines: i64) -> GenFile {
+    let n = tc.draw(int!(0, max_lines)) as usize;
+    let lines = (0..n).map(|_| arb_line(tc)).collect();
+    GenFile { lines, final_newline: tc.draw(int!(0, 3)) != 0 }
+}
+
+/// 1–3 line edits of a file (insert, delete, replace).
+fn arb_edits(tc: &hegel::TestCase, file: &GenFile) -> GenFile {
+    let mut lines = file.lines.clone();
+    let n = tc.draw(int!(1, 3));
+    for _ in 0..n {
+        match tc.draw(int!(0, 2)) {
+            0 => {
+                let at = tc.draw(int!(0, lines.len() as i64)) as usize;
+                lines.insert(at, arb_line(tc));
+            }
+            1 if !lines.is_empty() => {
+                let at = tc.draw(int!(0, lines.len() as i64 - 1)) as usize;
+                lines.remove(at);
+            }
+            _ if !lines.is_empty() => {
+                let at = tc.draw(int!(0, lines.len() as i64 - 1)) as usize;
+                lines[at] = arb_line(tc);
+            }
+            _ => {}
+        }
+    }
+    GenFile { lines, final_newline: tc.draw(int!(0, 3)) != 0 }
+}
+
+// ---------------------------------------------------------------------------
+// Unified diffs: parse, print, apply exactly
+// ---------------------------------------------------------------------------
+
+fn parse_unified(text: &[u8]) -> UnifiedPatch {
+    UnifiedPatch::parse_patch(splitlines(text)).unwrap_or_else(|e| panic!("parse_patch of {:?}: {e}", String::from_utf8_lossy(text)))
+}
+
+#[hegel::test]
+fn diff_u_output_parses_prints_and_applies(tc: hegel::TestCase) {
+    let orig = tc.draw(arb_file(10).print_as_debug());
+    let modified = arb_edits(&tc, &orig);
+    let (o, m) = (orig.bytes(), modified.bytes());
+    let dir = scratch();
+    let text = diff_u(&dir, &o, &m, true);
+    if o == m {
+        assert!(text.is_empty());
+        std::fs::remove_dir_all(&dir).unwrap();
+        return;
+    }
+    let p = parse_unified(&text);
+    assert_eq!(p.orig_name, b"a/file");
+    assert_eq!(p.mod_name, b"b/file");
+    assert_eq!(p.orig_ts, None);
+    assert_eq!(p.mod_ts, None);
+    // The serialisation is GNU diff's text, and parses back to the same patch.
+    assert_eq!(String::from_utf8_lossy(&p.as_bytes()), String::from_utf8_lossy(&text), "as_bytes");
+    assert_eq!(parse_unified(&p.as_bytes()), p);
+    // Hunk headers agree with their bodies.
+    for h in &p.hunks {
+        let orig_side = h.lines.iter().filter(|l| matches!(l, HunkLine::ContextLine(_) | HunkLine::RemoveLine(_))).count();
+        let mod_side = h.lines.iter().filter(|l| matches!(l, HunkLine::ContextLine(_) | HunkLine::InsertLine(_))).count();
+        assert_eq!((h.orig_range, h.mod_range), (orig_side, mod_side), "ranges of {:?}", String::from_utf8_lossy(&h.get_header()));
+        assert_eq!(h.tail, None);
+    }
+    // Exact application in both directions.
+    assert_eq!(String::from_utf8_lossy(&p.apply_exact(&o).unwrap()), String::from_utf8_lossy(&m), "apply_exact");
+    assert_eq!(String::from_utf8_lossy(&p.reverse().apply_exact(&m).unwrap()), String::from_utf8_lossy(&o), "reverse().apply_exact");
+    assert_eq!(p.reverse().reverse(), p);
+    // Fuzzy application on the very file the patch was made from: every hunk at offset 0, fuzz 0.
+    let r = p.apply_fuzzy(&o, &ApplyOptions::default());
+    assert!(r.is_success(), "apply_fuzzy on the original: {:?}", r.hunks);
+    assert_eq!(r.patched.as_deref(), Some(m.as_slice()));
+    assert_eq!(r.partial.as_deref(), Some(m.as_slice()));
+    assert!(r.hunks.iter().all(|h| h.offset == 0 && h.fuzz == 0), "{:?}", r.hunks);
+    let d = p.dry_run(&o, &ApplyOptions::default());
+    assert!(d.is_success() == false && d.patched.is_none() && d.partial.is_none());
+    assert!(d.hunks.iter().all(|h| h.applied()));
+    // The multi-patch reader finds exactly this one patch.
+    let many = UnifiedPatch::parse_patches(splitlines(&text).map(|l| l.to_vec())).unwrap();
+    assert_eq!(many, vec![PlainOrBinaryPatch::Plain(p.clone())]);
+    let via_parse_patch = patchkit::unified::parse_patch(splitlines(&text)).unwrap();
+    assert_eq!(via_parse_patch, PlainOrBinaryPatch::Plain(p));
+    std::fs::remove_dir_all(&dir).unwrap();
+}
