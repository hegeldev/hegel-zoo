+/// `diff` normal output uses `5a6,7` ranges and line numbers that differ on the two sides.
+#[test]
+fn normal_diff_ranges_parse_and_apply() {
+    let orig = b"a\nb\n";
+    let modified = b"a\nb\nc\nd\n";
+    let text = b"2a3,4\n> c\n> d\n";
+    let p = EdPatch::parse_patch(text).unwrap_or_else(|e| panic!("rejects {:?} at {:?}", String::from_utf8_lossy(text), String::from_utf8_lossy(&e)));
+    assert_eq!(p.apply_exact(orig).unwrap(), modified);
+}
+
+/// `Na M` adds after line N of the old file (`0a1` at the top); `Nd M` deletes line N; `Nc M`
+/// replaces it. The two numbers differ whenever earlier hunks changed the line count.
+#[test]
+fn normal_diff_single_line_hunks_apply_like_patch() {
+    let cases: &[(&[u8], &[u8], &[u8])] = &[
+        (b"0a1\n> a\n", b"b\n", b"a\nb\n"),
+        (b"1a2\n> b\n", b"a\nc\n", b"a\nb\nc\n"),
+        (b"2d1\n< b\n", b"a\nb\n", b"a\n"),
+        (b"1c1\n< a\n---\n> x\n", b"a\nb\n", b"x\nb\n"),
+        (b"1d0\n< a\n2a2\n> z\n", b"a\nb\nc\n", b"b\nz\nc\n"),
+    ];
+    let mut failures = Vec::new();
+    let dir = scratch();
+    for (text, orig, modified) in cases {
+        // GNU patch agrees with the expectation.
+        let g = gnu_patch(&dir, orig, text, 0);
+        assert_eq!((g.code, String::from_utf8_lossy(&g.output)), (0, String::from_utf8_lossy(modified)), "patch(1) on {:?}", String::from_utf8_lossy(text));
+        let p = match EdPatch::parse_patch(text) {
+            Ok(p) => p,
+            Err(e) => {
+                failures.push(format!("{:?}: parse rejects {:?}", String::from_utf8_lossy(text), String::from_utf8_lossy(&e)));
+                continue;
+            }
+        };
+        match std::panic::catch_unwind(|| p.apply_exact(orig)) {
+            Err(_) => failures.push(format!("{:?}: apply panics", String::from_utf8_lossy(text))),
+            Ok(Err(e)) => failures.push(format!("{:?}: apply fails: {e}", String::from_utf8_lossy(text))),
+            Ok(Ok(got)) if got != *modified => failures.push(format!("{:?}: applied {:?}, patch(1) gives {:?}", String::from_utf8_lossy(text), String::from_utf8_lossy(&got), String::from_utf8_lossy(modified))),
+            Ok(Ok(_)) => {}
+        }
+    }
+    assert!(failures.is_empty(), "{failures:#?}");
+}
