+#[derive(Serialize, Deserialize, Debug, PartialEq, Clone)]
+#[native_model(id = 6, version = 1)]
+#[native_db]
+struct TestF64 {
+    #[primary_key]
+    id: u32,
+    #[secondary_key]
+    value: f64,
+}
+
+// KNOWN FAILURE: f64 keys are encoded as raw IEEE-754 big-endian bytes
+// (`impl_inner_key_value_for_primitive!(f64)` in src/db_type/key/key.rs), which is
+// not order-preserving: every negative float has its sign bit set and therefore
+// sorts *after* every positive float, and negative floats sort in reversed order
+// among themselves. The signed integers received an order-preserving XOR encoding
+// (see the impls just above the float ones), the floats did not. Range scans over
+// float keys are broken the same way. The generator always includes one negative
+// and one positive value, so this fails deterministically on every run.
+#[hegel::test]
+fn pbt_f64_secondary_scan_sorted(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let mut values: Vec<f64> =
+        tc.draw(generators::vecs(generators::floats::<f64>().allow_nan(false)));
+    // Deterministic pin: one guaranteed-negative and one guaranteed-positive value.
+    values.push(tc.draw(
+        generators::floats::<f64>()
+            .min_value(f64::MIN)
+            .max_value(-1.0),
+    ));
+    values.push(tc.draw(
+        generators::floats::<f64>()
+            .min_value(1.0)
+            .max_value(f64::MAX),
+    ));
+
+    let mut models = Models::new();
+    models.define::<TestF64>().unwrap();
+    let db = Builder::new().create_in_memory(&models).unwrap();
+
+    let rw = db.rw_transaction().unwrap();
+    for (i, value) in values.iter().enumerate() {
+        rw.insert(TestF64 {
+            id: i as u32,
+            value: *value,
+        })
+        .unwrap();
+    }
+    rw.commit().unwrap();
+
+    let r = db.r_transaction().unwrap();
+    let all: Vec<TestF64> = r
+        .scan()
+        .secondary(TestF64Key::value)
+        .unwrap()
+        .all()
+        .unwrap()
+        .collect::<Result<Vec<_>, _>>()
+        .unwrap();
+    let got: Vec<f64> = all.iter().map(|x| x.value).collect();
+
+    for w in got.windows(2) {
+        assert!(
+            w[0] <= w[1],
+            "secondary scan over an f64 key must be in ascending key order, \
+             but {} appears before {} (full scan: {got:?})",
+            w[0],
+            w[1]
+        );
+    }
+}
