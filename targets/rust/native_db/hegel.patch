+
+// Property: a full secondary scan over an i64 key returns items in ascending
+// key order for the *entire* i64 domain, including i64::MIN/MAX (generalizes the
+// hand-picked values in the unit tests above).
+#[hegel::test]
+fn pbt_i64_secondary_scan_sorted(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let values: Vec<i64> = tc.draw(generators::vecs(generators::integers::<i64>()));
+
+    let mut models = Models::new();
+    models.define::<TestI64>().unwrap();
+    let db = Builder::new().create_in_memory(&models).unwrap();
+
+    let rw = db.rw_transaction().unwrap();
+    for (i, value) in values.iter().enumerate() {
+        rw.insert(TestI64 {
+            id: i as u32,
+            value: *value,
+        })
+        .unwrap();
+    }
+    rw.commit().unwrap();
+
+    let r = db.r_transaction().unwrap();
+    let all: Vec<TestI64> = r
+        .scan()
+        .secondary(TestI64Key::value)
+        .unwrap()
+        .all()
+        .unwrap()
+        .collect::<Result<Vec<_>, _>>()
+        .unwrap();
+    let got: Vec<i64> = all.iter().map(|x| x.value).collect();
+
+    // Items with equal keys come back ordered by primary key, i.e. insertion
+    // index here, so a stable sort is the exact model.
+    let mut expected = values.clone();
+    expected.sort();
+    assert_eq!(got, expected);
+}
