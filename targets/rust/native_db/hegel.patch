+// --- Property-based tests (hegel) ---
+
+#[derive(Serialize, Deserialize, Eq, PartialEq, Clone, Debug)]
+#[native_model(id = 3, version = 1)]
+#[native_db]
+struct PersistItem {
+    #[primary_key]
+    id: u32,
+    #[secondary_key]
+    tag: String,
+}
+
+// Property: committed data survives closing and reopening the database file —
+// both the primary table and the secondary index return exactly the inserted
+// items, in key order.
+#[hegel::test]
+fn pbt_reopen_persistence(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let ids: Vec<u32> = tc.draw(generators::vecs(generators::integers::<u32>()).unique(true));
+    let mut items = Vec::with_capacity(ids.len());
+    for id in ids {
+        items.push(PersistItem {
+            id,
+            tag: tc.draw(generators::text().max_size(4)),
+        });
+    }
+
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("test_db");
+    let mut models = Models::new();
+    models.define::<PersistItem>().unwrap();
+
+    {
+        let db = Builder::new().create(&models, &path).unwrap();
+        let rw = db.rw_transaction().unwrap();
+        for item in &items {
+            rw.insert(item.clone()).unwrap();
+        }
+        rw.commit().unwrap();
+    } // drop closes the database
+
+    let db = Builder::new().open(&models, &path).unwrap();
+    let r = db.r_transaction().unwrap();
+
+    let got: Vec<PersistItem> = r
+        .scan()
+        .primary::<PersistItem>()
+        .unwrap()
+        .all()
+        .unwrap()
+        .collect::<Result<_, _>>()
+        .unwrap();
+    let mut want = items.clone();
+    want.sort_by_key(|item| item.id);
+    assert_eq!(got, want);
+
+    let got_by_tag: Vec<PersistItem> = r
+        .scan()
+        .secondary::<PersistItem>(PersistItemKey::tag)
+        .unwrap()
+        .all()
+        .unwrap()
+        .collect::<Result<_, _>>()
+        .unwrap();
+    let mut want_by_tag = items.clone();
+    want_by_tag.sort_by(|x, y| x.tag.cmp(&y.tag).then(x.id.cmp(&y.id)));
+    assert_eq!(got_by_tag, want_by_tag);
+}
