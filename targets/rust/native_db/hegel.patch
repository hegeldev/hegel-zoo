+#[derive(Serialize, Deserialize, Eq, PartialEq, Clone, Debug)]
+#[native_model(id = 2, version = 1)]
+#[native_db]
+struct UniqueSkItem {
+    #[primary_key]
+    id: u32,
+    #[secondary_key(unique)]
+    code: u16,
+}
+
+// Property: a `unique` secondary key is enforced — inserting a second item with a
+// different primary key but the same unique secondary key always fails with
+// `DuplicateKey`, and the unique-key lookup keeps returning the first item.
+#[hegel::test]
+fn pbt_unique_secondary_key_enforced(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let id1 = tc.draw(generators::integers::<u32>());
+    // Construct a distinct primary key directly instead of filtering.
+    let offset = tc.draw(generators::integers::<u32>().min_value(1));
+    let id2 = id1.wrapping_add(offset);
+    let code = tc.draw(generators::integers::<u16>());
+
+    let first = UniqueSkItem { id: id1, code };
+    let second = UniqueSkItem { id: id2, code };
+
+    let mut models = Models::new();
+    models.define::<UniqueSkItem>().unwrap();
+    let db = Builder::new().create_in_memory(&models).unwrap();
+
+    let rw = db.rw_transaction().unwrap();
+    rw.insert(first.clone()).unwrap();
+    rw.commit().unwrap();
+
+    let rw = db.rw_transaction().unwrap();
+    let result = rw.insert(second);
+    assert!(
+        matches!(result, Err(db_type::Error::DuplicateKey { .. })),
+        "expected DuplicateKey, got {result:?}"
+    );
+    // The failed insert has already written the second item into the primary
+    // table before detecting the unique secondary key conflict, so the
+    // transaction must be aborted, not committed.
+    rw.abort().unwrap();
+
+    let r = db.r_transaction().unwrap();
+    let by_code: UniqueSkItem = r
+        .get()
+        .secondary(UniqueSkItemKey::code, code)
+        .unwrap()
+        .unwrap();
+    assert_eq!(by_code, first);
+    let by_pk: UniqueSkItem = r.get().primary(id1).unwrap().unwrap();
+    assert_eq!(by_pk, first);
+}
diff --git a/tests/scan.rs b/tests/scan.rs
index 034dda2..7e97305 100644
--- a/tests/scan.rs
+++ b/tests/scan.rs
@@ -1400,3 +1400,191 @@ fn test_sentinel_value_approach() {
 
     println!("\n✅ Sentinel value approach successfully demonstrates queryable 'null' values!");
 }
+
+// --- Property-based tests (hegel) ---
+
+#[derive(Serialize, Deserialize, Eq, PartialEq, Debug, Clone)]
+#[native_model(id = 20, version = 1)]
+#[native_db]
+struct PkRangeItem {
+    #[primary_key]
+    id: u32,
+    name: String,
+}
+
+// Property: a primary-key range scan returns exactly the items whose primary key
+// falls in the range (compared against a filtered model), in ascending key order.
+//
+// NOTE: the `..=end` (unbounded start, inclusive end) range shape is deliberately
+// excluded here because it is known-buggy — see the canonical failing test
+// `pbt_primary_range_to_inclusive_includes_boundary` below.
+#[hegel::test]
+fn pbt_primary_range_scan_matches_model(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let ids: Vec<u32> = tc.draw(generators::vecs(generators::integers::<u32>()).unique(true));
+
+    let mut models = Models::new();
+    models.define::<PkRangeItem>().unwrap();
+    let db = Builder::new().create_in_memory(&models).unwrap();
+
+    let rw = db.rw_transaction().unwrap();
+    for id in &ids {
+        rw.insert(PkRangeItem {
+            id: *id,
+            name: format!("n{id}"),
+        })
+        .unwrap();
+    }
+    rw.commit().unwrap();
+
+    let a = tc.draw(generators::integers::<u32>());
+    let b = tc.draw(generators::integers::<u32>());
+    let (lo, hi) = if a <= b { (a, b) } else { (b, a) };
+    let kind = tc.draw(generators::integers::<u8>().max_value(4));
+
+    let r = db.r_transaction().unwrap();
+    let scan = r.scan().primary::<PkRangeItem>().unwrap();
+    let got: Vec<PkRangeItem> = match kind {
+        0 => scan.range(lo..hi).unwrap().collect::<Result<_, _>>().unwrap(),
+        1 => scan
+            .range(lo..=hi)
+            .unwrap()
+            .collect::<Result<_, _>>()
+            .unwrap(),
+        2 => scan.range(lo..).unwrap().collect::<Result<_, _>>().unwrap(),
+        3 => scan.range(..hi).unwrap().collect::<Result<_, _>>().unwrap(),
+        _ => scan
+            .range((
+                std::ops::Bound::<u32>::Unbounded,
+                std::ops::Bound::<u32>::Unbounded,
+            ))
+            .unwrap()
+            .collect::<Result<_, _>>()
+            .unwrap(),
+    };
+
+    let mut expected: Vec<u32> = ids
+        .iter()
+        .copied()
+        .filter(|id| match kind {
+            0 => (lo..hi).contains(id),
+            1 => (lo..=hi).contains(id),
+            2 => *id >= lo,
+            3 => *id < hi,
+            _ => true,
+        })
+        .collect();
+    expected.sort_unstable();
+
+    let got_ids: Vec<u32> = got.iter().map(|item| item.id).collect();
+    assert_eq!(got_ids, expected);
+}
+
+// KNOWN FAILURE: `range(..=k)` (unbounded start, inclusive end) silently behaves
+// like the exclusive `range(..k)`. `KeyRange::new` in src/db_type/key/key.rs maps
+// `(Bound::Unbounded, Bound::Included(end))` to `KeyRange::RangeTo`, whose end
+// bound is *excluded* (the `KeyRange::RangeToInclusive` variant exists but is
+// never constructed). The stored item whose key equals the inclusive end bound is
+// therefore dropped from the scan. Fails deterministically for every drawn id.
+// The same code path is used by secondary-key range scans and `RwScan`.
+#[hegel::test]
+fn pbt_primary_range_to_inclusive_includes_boundary(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let id = tc.draw(generators::integers::<u32>());
+
+    let mut models = Models::new();
+    models.define::<PkRangeItem>().unwrap();
+    let db = Builder::new().create_in_memory(&models).unwrap();
+
+    let rw = db.rw_transaction().unwrap();
+    rw.insert(PkRangeItem {
+        id,
+        name: "boundary".to_string(),
+    })
+    .unwrap();
+    rw.commit().unwrap();
+
+    let r = db.r_transaction().unwrap();
+    let got: Vec<PkRangeItem> = r
+        .scan()
+        .primary::<PkRangeItem>()
+        .unwrap()
+        .range(..=id)
+        .unwrap()
+        .collect::<Result<_, _>>()
+        .unwrap();
+    assert!(
+        got.iter().any(|item| item.id == id),
+        "range(..={id}) must include the item whose primary key is exactly {id}, got {got:?}"
+    );
+}
+
+#[derive(Serialize, Deserialize, Eq, PartialEq, Debug, Clone)]
+#[native_model(id = 21, version = 1)]
+#[native_db]
+struct SkPrefixItem {
+    #[primary_key]
+    id: u32,
+    #[secondary_key]
+    name: String,
+}
+
+// Property: `start_with` on a String secondary key returns exactly the items whose
+// key field starts with the prefix (a UTF-8 string prefix is exactly a byte
+// prefix), ordered by (secondary key, primary key).
+#[hegel::test]
+fn pbt_secondary_start_with_matches_model(tc: hegel::TestCase) {
+    use hegel::generators;
+
+    let names: Vec<String> = tc.draw(generators::vecs(generators::text().max_size(6)));
+    let items: Vec<SkPrefixItem> = names
+        .into_iter()
+        .enumerate()
+        .map(|(i, name)| SkPrefixItem {
+            id: i as u32,
+            name,
+        })
+        .collect();
+
+    let mut models = Models::new();
+    models.define::<SkPrefixItem>().unwrap();
+    let db = Builder::new().create_in_memory(&models).unwrap();
+
+    let rw = db.rw_transaction().unwrap();
+    for item in &items {
+        rw.insert(item.clone()).unwrap();
+    }
+    rw.commit().unwrap();
+
+    // Draw either an arbitrary prefix or a (char-boundary) prefix of a stored name,
+    // so the scan regularly matches something.
+    let prefix: String = if !items.is_empty() && tc.draw(generators::booleans()) {
+        let idx = tc.draw(generators::integers::<usize>().max_value(items.len() - 1));
+        let name = &items[idx].name;
+        let k = tc.draw(generators::integers::<usize>().max_value(name.chars().count()));
+        name.chars().take(k).collect()
+    } else {
+        tc.draw(generators::text().max_size(3))
+    };
+
+    let r = db.r_transaction().unwrap();
+    let got: Vec<SkPrefixItem> = r
+        .scan()
+        .secondary::<SkPrefixItem>(SkPrefixItemKey::name)
+        .unwrap()
+        .start_with(prefix.clone())
+        .unwrap()
+        .collect::<Result<_, _>>()
+        .unwrap();
+
+    let mut expected: Vec<SkPrefixItem> = items
+        .iter()
+        .filter(|item| item.name.starts_with(&prefix))
+        .cloned()
+        .collect();
+    expected.sort_by(|x, y| x.name.cmp(&y.name).then(x.id.cmp(&y.id)));
+
+    assert_eq!(got, expected);
+}
