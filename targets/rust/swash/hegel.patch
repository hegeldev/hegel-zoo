+//! Property-based tests for swash's font-introspection / shaping / scaling
+//! surface, written with the hegel (`hegeltest`) library.
+//!
+//! Two broad families:
+//!   * robustness (no-panic) properties driven by arbitrary, wire-shaped, and
+//!     corrupted font bytes; and
+//!   * semantic invariants (charmap consistency, metric finiteness, variation
+//!     coordinate bounds, monotonic shaping clusters) driven by real fonts
+//!     from the `font-test-data` crate.
+
+use hegel::generators;
+
+use swash::shape::ShapeContext;
+use swash::{FontDataRef, FontRef, GlyphId};
+
+#[cfg(feature = "scale")]
+use swash::scale::ScaleContext;
+
+/// A diverse set of real, well-formed fonts to exercise valid-input properties
+/// against. Includes TrueType outlines, CFF, variable fonts, color/bitmap
+/// fonts and several distinct cmap subtable formats.
+fn valid_fonts() -> Vec<&'static [u8]> {
+    use font_test_data as f;
+    vec![
+        f::VAZIRMATN_VAR,
+        f::CANTARELL_VF_TRIMMED,
+        f::AMSTELVAR_AVAR2_A,
+        f::NOTO_SERIF_DISPLAY_TRIMMED,
+        f::NOTO_SANS_JP_CFF,
+        f::SIMPLE_GLYF,
+        f::CUBIC_GLYF,
+        f::CMAP12_FONT1,
+        f::CMAP4_SYMBOL_PUA,
+        f::CMAP6,
+        f::TOFU,
+        f::COLRV0V1,
+        f::VORG,
+        f::EMBEDDED_BITMAPS,
+        f::CBDT,
+        f::AHEM,
+    ]
+}
+
+/// Subset of [`valid_fonts`] excluding fonts that trigger the pinned
+/// zero-long-metrics panic (see `glyph_advance_underflow_on_zero_long_metrics`).
+/// `CMAP4_SYMBOL_PUA` has an `hhea` reporting 0 long metrics, so any per-glyph
+/// horizontal-metric query on it panics. Used by properties that query glyph
+/// metrics (directly or via shaping) so they can stay green while still
+/// covering every other font.
+fn metric_safe_fonts() -> Vec<&'static [u8]> {
+    valid_fonts()
+        .into_iter()
+        .filter(|f| !core::ptr::eq(*f, font_test_data::CMAP4_SYMBOL_PUA))
+        .collect()
+}
+
+/// Draw an arbitrary Unicode-ish codepoint, weighted toward interesting planes
+/// but also including the full u32 range (`map` accepts any `u32`, not just
+/// valid scalar values).
+fn draw_codepoint(tc: &hegel::TestCase) -> u32 {
+    tc.draw(hegel::one_of!(
+        generators::integers::<u32>().max_value(0x7F), // ASCII
+        generators::integers::<u32>().min_value(0x80).max_value(0xFFFF), // BMP
+        generators::integers::<u32>()
+            .min_value(0x1_0000)
+            .max_value(0x10_FFFF), // supplementary
+        generators::integers::<u32>(),                 // anything, incl. > 0x10FFFF
+    ))
+}
+
+/// Runs `f`, swallowing ONLY the two pinned integer-underflow panics
+/// (`xmtx::advance/sb` on zero long-metrics, and `Bytes::check_range` on an
+/// out-of-bounds offset — both "attempt to subtract with overflow"). Any other
+/// panic is re-raised so the robustness sweeps can still surface *new* bugs.
+///
+/// This is the "exclude the known-buggy input" mechanism for the no-panic
+/// sweeps: the buggy inputs (malformed bytes that make an offset exceed the
+/// data length, or metric extraction bail to a 0 count) can't be characterised
+/// up front, so we tolerate their specific panic class after the fact. Both
+/// bugs are pinned by dedicated failing tests
+/// (`glyph_advance_underflow_on_zero_long_metrics`,
+/// `check_range_underflow_on_truncated_font`).
+fn allow_known_overflow(f: impl FnOnce()) {
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f));
+    if let Err(payload) = result {
+        let msg = payload
+            .downcast_ref::<&str>()
+            .copied()
+            .or_else(|| payload.downcast_ref::<String>().map(String::as_str));
+        match msg {
+            Some(m) if m.contains("subtract with overflow") => { /* pinned bug */ }
+            _ => std::panic::resume_unwind(payload),
+        }
+    }
+}
+
+/// Exercise a broad swath of read-only accessors on a `FontRef`. Used by the
+/// robustness properties: none of these calls may panic regardless of how
+/// malformed the underlying bytes are (except the two pinned overflow bugs,
+/// which callers wrap with [`allow_known_overflow`]).
+///
+/// Note: this deliberately does NOT call `Charmap::enumerate`. Unlike `map`
+/// (a bounded binary search), `enumerate` walks `start..=end` of each cmap
+/// segment, and a corrupted format-12 subtable can encode a ~4-billion-wide
+/// range that would hang the test (there is no per-test timeout). `enumerate`
+/// is covered separately against valid fonts only.
+fn exercise_accessors(font: &FontRef) {
+    // check_range is a pervasive parsing primitive, so a corrupted offset can
+    // trigger the pinned underflow in almost any accessor; wrap the whole sweep.
+    allow_known_overflow(|| exercise_accessors_inner(font));
+}
+
+fn exercise_accessors_inner(font: &FontRef) {
+    let _ = font.attributes();
+    let a = font.attributes();
+    let _ = a.parts();
+    let _ = a.has_variations();
+
+    for s in font.localized_strings() {
+        let _ = s.id();
+        let _ = s.language();
+        let _ = s.is_unicode();
+        let _ = s.chars().count();
+        let _ = s.to_string();
+    }
+
+    for w in font.writing_systems() {
+        let _ = w.script();
+        let _ = w.language();
+        let _ = w.script_tag();
+        let _ = w.language_tag();
+    }
+    for feat in font.features() {
+        let _ = feat.tag();
+        let _ = feat.action();
+        let _ = feat.name();
+    }
+
+    // Variations: iterate axes, read bounds, and normalize a few probe values
+    // (including non-finite and out-of-range).
+    for v in font.variations() {
+        let _ = v.tag();
+        let _ = v.min_value();
+        let _ = v.max_value();
+        let _ = v.default_value();
+        for value in [f32::NAN, f32::INFINITY, -1e30, 0.0, 1e30] {
+            let _ = v.normalize(value);
+        }
+    }
+    for inst in font.instances() {
+        let _ = inst.index();
+        let _ = inst.values().count();
+        let _ = inst.normalized_coords().count();
+    }
+
+    let charmap = font.charmap();
+    for cp in [0u32, 0x41, 0xFFFF, 0x1_0000, 0x10_FFFF, u32::MAX] {
+        let _ = charmap.map(cp);
+    }
+
+    let metrics = font.metrics(&[]);
+    let _ = metrics.units_per_em;
+    let gcount = metrics.glyph_count;
+    // Per-glyph metric accessors. On malformed data these can hit the pinned
+    // zero-long-metrics underflow in xmtx; allow_known_overflow tolerates it.
+    let glyph_metrics = font.glyph_metrics(&[]);
+    for gid in [0u16, 1, gcount.wrapping_sub(1), gcount, u16::MAX] {
+        let _ = glyph_metrics.advance_width(gid);
+        let _ = glyph_metrics.lsb(gid);
+        let _ = glyph_metrics.advance_height(gid);
+        let _ = glyph_metrics.tsb(gid);
+        let _ = glyph_metrics.vertical_origin(gid);
+    }
+
+    for palette in font.color_palettes() {
+        let _ = palette.len();
+        let n = palette.len().min(8);
+        for i in 0..n {
+            let _ = palette.get(i);
+        }
+    }
+    for strike in font.alpha_strikes() {
+        let _ = strike.ppem();
+        let _ = strike.bit_depth();
+    }
+    for strike in font.color_strikes() {
+        let _ = strike.ppem();
+        let _ = strike.bit_depth();
+    }
+
+    // Table lookups by tag.
+    for tag in [
+        swash::tag_from_bytes(b"cmap"),
+        swash::tag_from_bytes(b"glyf"),
+        swash::tag_from_bytes(b"CFF "),
+        swash::tag_from_bytes(b"GSUB"),
+        0,
+        u32::MAX,
+    ] {
+        let _ = font.table(tag);
+    }
+    let _ = font.glyph_name(0);
+}
+
+// ---------------------------------------------------------------------------
+// Robustness: no-panic on arbitrary / wire-shaped / corrupted bytes
+// ---------------------------------------------------------------------------
+
+/// `FontDataRef::new` and `FontRef::from_index` must never panic on arbitrary
+/// bytes, and any font they hand back must survive the full accessor sweep.
+#[hegel::test]
+fn fontref_from_arbitrary_bytes_no_panic(tc: hegel::TestCase) {
+    let data: Vec<u8> = tc.draw(generators::binary().max_size(4096));
+
+    if let Some(fd) = FontDataRef::new(&data) {
+        let _ = fd.is_collection();
+        let _ = fd.len();
+        let _ = fd.is_empty();
+        // Iterate the whole collection (bounded by len).
+        for font in fd.fonts() {
+            exercise_accessors(&font);
+        }
+        // get() past the end must be None, not a panic.
+        let _ = fd.get(fd.len());
+        let _ = fd.get(usize::MAX);
+    }
+
+    // from_index for a few indices, including out of bounds.
+    for idx in [0usize, 1, 2, usize::MAX] {
+        if let Some(font) = FontRef::from_index(&data, idx) {
+            exercise_accessors(&font);
+        }
+    }
+}
+
+/// The "wire-shaped garbage" pattern: build bytes with a valid sfnt version and
+/// a generated table directory (arbitrary tags, offsets, and lengths), so we
+/// get past the `is_font` gate and drive the table-parsing paths with
+/// structurally plausible but semantically arbitrary content.
+#[hegel::test]
+fn wire_shaped_sfnt_no_panic(tc: hegel::TestCase) {
+    let version: u32 = tc.draw(generators::sampled_from(vec![
+        0x0001_0000u32, // TrueType outlines
+        0x4F54_544F,    // 'OTTO' — CFF outlines
+        0x7472_7565,    // 'true'
+        0x7474_6366,    // 'ttcf' — collection header
+    ]));
+    let num_tables: u16 = tc.draw(generators::integers::<u16>().max_value(64));
+
+    let mut data: Vec<u8> = Vec::new();
+    data.extend_from_slice(&version.to_be_bytes());
+    data.extend_from_slice(&num_tables.to_be_bytes());
+    // searchRange / entrySelector / rangeShift — arbitrary, parser recomputes.
+    data.extend_from_slice(&tc.draw(generators::integers::<u16>()).to_be_bytes());
+    data.extend_from_slice(&tc.draw(generators::integers::<u16>()).to_be_bytes());
+    data.extend_from_slice(&tc.draw(generators::integers::<u16>()).to_be_bytes());
+
+    // Table directory records: 16 bytes each (tag, checksum, offset, length).
+    for _ in 0..num_tables {
+        let tag: u32 = tc.draw(hegel::one_of!(
+            generators::sampled_from(vec![
+                swash::tag_from_bytes(b"cmap"),
+                swash::tag_from_bytes(b"head"),
+                swash::tag_from_bytes(b"maxp"),
+                swash::tag_from_bytes(b"hhea"),
+                swash::tag_from_bytes(b"hmtx"),
+                swash::tag_from_bytes(b"name"),
+                swash::tag_from_bytes(b"glyf"),
+                swash::tag_from_bytes(b"loca"),
+                swash::tag_from_bytes(b"fvar"),
+                swash::tag_from_bytes(b"OS/2"),
+            ]),
+            generators::integers::<u32>(),
+        ));
+        data.extend_from_slice(&tag.to_be_bytes());
+        data.extend_from_slice(&tc.draw(generators::integers::<u32>()).to_be_bytes());
+        data.extend_from_slice(&tc.draw(generators::integers::<u32>()).to_be_bytes());
+        data.extend_from_slice(&tc.draw(generators::integers::<u32>()).to_be_bytes());
+    }
+
+    // Some arbitrary trailing payload the offsets may point into.
+    let payload: Vec<u8> = tc.draw(generators::binary().max_size(2048));
+    data.extend_from_slice(&payload);
+
+    // from_offset(0) should accept the header; exercise whatever we get.
+    if let Some(font) = FontRef::from_offset(&data, 0) {
+        exercise_accessors(&font);
+    }
+    // Also route through the normal entry point.
+    if let Some(font) = FontRef::from_index(&data, 0) {
+        exercise_accessors(&font);
+    }
+}
+
+/// Bit-flipped / truncated copies of real fonts must not panic. Real fonts get
+/// us deep into every table parser; corruption then stresses the bounds checks.
+#[hegel::test]
+fn corrupted_real_fonts_no_panic(tc: hegel::TestCase) {
+    let original = tc.draw(generators::sampled_from(valid_fonts()));
+    let mut data = original.to_vec();
+
+    // Apply a handful of single-byte mutations at arbitrary positions.
+    let n_flips = tc.draw(generators::integers::<usize>().max_value(16));
+    for _ in 0..n_flips {
+        if data.is_empty() {
+            break;
+        }
+        let pos = tc.draw(generators::integers::<usize>().max_value(data.len() - 1));
+        let byte = tc.draw(generators::integers::<u8>());
+        data[pos] = byte;
+    }
+
+    // Optionally truncate to an arbitrary prefix.
+    if tc.draw(generators::booleans()) {
+        let new_len = tc.draw(generators::integers::<usize>().max_value(data.len()));
+        data.truncate(new_len);
+    }
+
+    if let Some(font) = FontRef::from_index(&data, 0) {
+        exercise_accessors(&font);
+    }
+    if let Some(fd) = FontDataRef::new(&data) {
+        for font in fd.fonts() {
+            exercise_accessors(&font);
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Semantic invariants on valid fonts
+// ---------------------------------------------------------------------------
+
+/// `Charmap::map` must not panic for any `u32` codepoint, and the returned
+/// nominal glyph id must index into the font's glyph set (`< glyph_count`).
+/// A cmap that hands out glyph ids past `maxp.numGlyphs` would produce
+/// out-of-bounds lookups downstream.
+#[hegel::test]
+fn charmap_map_in_glyph_count_bounds(tc: hegel::TestCase) {
+    // metric_safe_fonts excludes CMAP4_SYMBOL_PUA: the same metric-extraction
+    // bail that underflows advances (see the pin
+    // glyph_advance_underflow_on_zero_long_metrics) also leaves its reported
+    // glyph_count at 0, which is not the charmap behavior under test here.
+    let font_data = tc.draw(generators::sampled_from(metric_safe_fonts()));
+    let font = FontRef::from_index(font_data, 0).expect("test font must parse");
+    let charmap = font.charmap();
+    let glyph_count = font.metrics(&[]).glyph_count;
+
+    let cp = draw_codepoint(&tc);
+    let gid = charmap.map(cp);
+    assert!(
+        gid < glyph_count,
+        "map(U+{cp:04X}) = {gid} but glyph_count = {glyph_count}"
+    );
+}
+
+/// Consistency between the two charmap query paths: every (codepoint, glyph)
+/// pair produced by `enumerate` must map back to the same glyph via `map`.
+/// enumerate only ever yields non-zero glyph ids, so the symbol-remap fallback
+/// in `map` (which only fires when the primary lookup is 0) does not interfere.
+#[hegel::test]
+fn charmap_enumerate_agrees_with_map(tc: hegel::TestCase) {
+    let font_data = tc.draw(generators::sampled_from(valid_fonts()));
+    let font = FontRef::from_index(font_data, 0).expect("test font must parse");
+    let charmap = font.charmap();
+
+    // Collect the enumerated pairs (bounded: these are all valid fonts).
+    let mut pairs: Vec<(u32, GlyphId)> = Vec::new();
+    charmap.enumerate(|cp, gid| pairs.push((cp, gid)));
+
+    // Check a drawn sample rather than every pair (keeps each case cheap).
+    if pairs.is_empty() {
+        return;
+    }
+    let idx = tc.draw(generators::integers::<usize>().max_value(pairs.len() - 1));
+    let (cp, gid) = pairs[idx];
+    assert_eq!(
+        charmap.map(cp),
+        gid,
+        "enumerate gave (U+{cp:04X} -> {gid}) but map disagreed"
+    );
+}
+
+/// Glyph metric accessors must not panic for any glyph id across the full u16
+/// range, and for glyph ids within the font's glyph count they must return
+/// finite values.
+#[hegel::test]
+fn glyph_metrics_finite_and_no_panic(tc: hegel::TestCase) {
+    // metric_safe_fonts excludes CMAP4_SYMBOL_PUA, whose zero-long-metrics
+    // panic is pinned by glyph_advance_underflow_on_zero_long_metrics.
+    let font_data = tc.draw(generators::sampled_from(metric_safe_fonts()));
+    let font = FontRef::from_index(font_data, 0).expect("test font must parse");
+    let gm = font.glyph_metrics(&[]);
+    let glyph_count = gm.glyph_count();
+
+    let gid: GlyphId = tc.draw(generators::integers::<GlyphId>());
+
+    // Must never panic for any id.
+    let aw = gm.advance_width(gid);
+    let lsb = gm.lsb(gid);
+    let ah = gm.advance_height(gid);
+    let tsb = gm.tsb(gid);
+    let vo = gm.vertical_origin(gid);
+
+    // For real glyphs, the results must be finite numbers.
+    if gid < glyph_count {
+        for (name, v) in [
+            ("advance_width", aw),
+            ("lsb", lsb),
+            ("advance_height", ah),
+            ("tsb", tsb),
+            ("vertical_origin", vo),
+        ] {
+            assert!(v.is_finite(), "{name}({gid}) = {v} is not finite");
+        }
+    }
+}
+
+/// `Variation::normalize` must accept any `f32` (including NaN, infinities and
+/// values far outside the axis range) without panicking, and the resulting
+/// normalized coordinate must lie within the valid 2.14 normalized range
+/// [-1.0, 1.0], i.e. bits in [-16384, 16384].
+#[hegel::test]
+fn variation_normalize_in_range(tc: hegel::TestCase) {
+    // Fonts with variation axes.
+    let font_data = tc.draw(generators::sampled_from(vec![
+        font_test_data::VAZIRMATN_VAR,
+        font_test_data::CANTARELL_VF_TRIMMED,
+        font_test_data::AMSTELVAR_AVAR2_A,
+    ]));
+    let font = FontRef::from_index(font_data, 0).expect("test font must parse");
+
+    let variations: Vec<_> = font.variations().collect();
+    if variations.is_empty() {
+        return;
+    }
+    let idx = tc.draw(generators::integers::<usize>().max_value(variations.len() - 1));
+    let axis = variations[idx];
+
+    let value: f32 = tc.draw(hegel::one_of!(
+        generators::floats::<f32>(), // full range incl. NaN / inf
+        generators::floats::<f32>()
+            .min_value(-2000.0)
+            .max_value(2000.0),
+        generators::sampled_from(vec![
+            axis.min_value(),
+            axis.max_value(),
+            axis.default_value(),
+        ]),
+    ));
+
+    let coord = axis.normalize(value);
+    assert!(
+        (-16384..=16384).contains(&coord),
+        "normalize({value}) on axis {:?} = {coord}, outside 2.14 [-1,1]",
+        axis.tag()
+    );
+}
+
+/// `Variations::normalized_coords` must accept arbitrary settings (arbitrary
+/// tags and non-finite values) without panicking, and every produced
+/// coordinate must be a valid normalized 2.14 value.
+#[hegel::test]
+fn normalized_coords_no_panic(tc: hegel::TestCase) {
+    let font_data = tc.draw(generators::sampled_from(valid_fonts()));
+    let font = FontRef::from_index(font_data, 0).expect("test font must parse");
+
+    // Draw an arbitrary settings list (tag, value) pairs.
+    let n = tc.draw(generators::integers::<usize>().max_value(8));
+    let mut settings: Vec<(u32, f32)> = Vec::new();
+    for _ in 0..n {
+        let tag = tc.draw(hegel::one_of!(
+            generators::sampled_from(vec![
+                swash::tag_from_bytes(b"wght"),
+                swash::tag_from_bytes(b"wdth"),
+                swash::tag_from_bytes(b"slnt"),
+                swash::tag_from_bytes(b"opsz"),
+            ]),
+            generators::integers::<u32>(),
+        ));
+        let value = tc.draw(generators::floats::<f32>());
+        settings.push((tag, value));
+    }
+
+    let coords: Vec<_> = font.variations().normalized_coords(settings).collect();
+    for c in coords {
+        assert!(
+            (-16384..=16384).contains(&c),
+            "normalized coord {c} outside 2.14 [-1,1]"
+        );
+    }
+}
+
+/// Shaping arbitrary text with a real font must not panic, and the resulting
+/// glyph clusters must satisfy the documented cluster invariants:
+///   * every source range lies within the input byte range;
+///   * cluster source starts are monotonically non-decreasing (LTR shaping);
+///   * all glyph positions and advances are finite.
+#[hegel::test]
+fn shaper_cluster_invariants(tc: hegel::TestCase) {
+    // Shaping computes glyph advances, so use metric_safe_fonts (see the pin
+    // glyph_advance_underflow_on_zero_long_metrics).
+    let font_data = tc.draw(generators::sampled_from(metric_safe_fonts()));
+    let font = FontRef::from_index(font_data, 0).expect("test font must parse");
+
+    let text: String = tc.draw(generators::text().max_size(128));
+    let len = text.len() as u32;
+
+    let mut context = ShapeContext::new();
+    let mut shaper = context.builder(font).size(16.0).build();
+    shaper.add_str(&text);
+
+    let mut last_start: u32 = 0;
+    let mut first = true;
+    shaper.shape_with(|cluster| {
+        let s = cluster.source;
+        assert!(
+            s.start <= s.end,
+            "cluster source range inverted: {}..{}",
+            s.start,
+            s.end
+        );
+        assert!(
+            s.end <= len,
+            "cluster source end {} exceeds input length {len}",
+            s.end
+        );
+        if !first {
+            assert!(
+                s.start >= last_start,
+                "cluster starts not monotonic: {} after {}",
+                s.start,
+                last_start
+            );
+        }
+        first = false;
+        last_start = s.start;
+
+        for g in cluster.glyphs {
+            assert!(g.x.is_finite(), "glyph x not finite");
+            assert!(g.y.is_finite(), "glyph y not finite");
+            assert!(g.advance.is_finite(), "glyph advance not finite");
+        }
+    });
+}
+
+/// Building a shaper with arbitrary variation settings (including non-finite
+/// values) and shaping text must not panic.
+#[hegel::test]
+fn shaper_arbitrary_variations_no_panic(tc: hegel::TestCase) {
+    // Shaping computes glyph advances; see the pin
+    // glyph_advance_underflow_on_zero_long_metrics.
+    let font_data = tc.draw(generators::sampled_from(metric_safe_fonts()));
+    let font = FontRef::from_index(font_data, 0).expect("test font must parse");
+
+    let wght = tc.draw(generators::floats::<f32>());
+    let wdth = tc.draw(generators::floats::<f32>());
+    let size = tc.draw(generators::floats::<f32>().min_value(-10.0).max_value(400.0));
+    let text: String = tc.draw(generators::text().max_size(64));
+
+    let mut context = ShapeContext::new();
+    let mut shaper = context
+        .builder(font)
+        .size(size)
+        .variations(&[
+            (swash::tag_from_bytes(b"wght"), wght),
+            (swash::tag_from_bytes(b"wdth"), wdth),
+        ])
+        .build();
+    shaper.add_str(&text);
+    shaper.shape_with(|_| {});
+}
