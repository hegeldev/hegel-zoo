+/// Scaling outlines for arbitrary glyph ids with arbitrary size and variation
+/// settings must not panic. Any produced outline must have finite bounds.
+#[cfg(feature = "scale")]
+#[hegel::test]
+fn scaler_outline_no_panic(tc: hegel::TestCase) {
+    let font_data = tc.draw(generators::sampled_from(valid_fonts()));
+    let font = FontRef::from_index(font_data, 0).expect("test font must parse");
+
+    let gid: GlyphId = tc.draw(generators::integers::<GlyphId>());
+    let size = tc.draw(generators::floats::<f32>().min_value(-10.0).max_value(400.0));
+    let wght = tc.draw(generators::floats::<f32>());
+
+    let mut context = ScaleContext::new();
+    let mut scaler = context
+        .builder(font)
+        .size(size)
+        .hint(tc.draw(generators::booleans()))
+        .variations(&[(swash::tag_from_bytes(b"wght"), wght)])
+        .build();
+
+    if let Some(outline) = scaler.scale_outline(gid) {
+        let b = outline.bounds();
+        assert!(b.min.x.is_finite() && b.min.y.is_finite());
+        assert!(b.max.x.is_finite() && b.max.y.is_finite());
+    }
+    // Also exercise the color path.
+    let _ = scaler.scale_color_outline(gid);
+}
