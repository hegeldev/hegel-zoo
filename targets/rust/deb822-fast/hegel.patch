+#[hegel::test]
+fn the_model_is_what_the_parser_reads(tc: hegel::TestCase) {
+    let mut opts = tc.draw(arb_opts().print_as_debug());
+    opts.crlf = false;
+    let doc = tc.draw(arb_doc(opts).print_as_debug());
+    if hits_ws_separator_bug(&doc) {
+        return;
+    }
+    let text = doc.text();
+    let ours: Deb822 = text.parse().unwrap_or_else(|e| panic!("parse failed for {text:?}: {e}"));
+    assert_eq!(crate_paras(&ours), doc.crate_model(), "for {text:?}");
+    assert_eq!(ours.len(), doc.paras.len());
+    assert_eq!(ours.is_empty(), doc.paras.is_empty());
+    // `Deb822::from_reader` is `FromStr` on the whole input.
+    let via_reader = Deb822::from_reader(text.as_bytes()).unwrap();
+    assert_eq!(via_reader, ours);
+    // `get` is case-insensitive and finds every field.
+    for (p, gp) in ours.iter().zip(&doc.paras) {
+        assert_eq!(p.len(), gp.entries.len());
+        for e in &gp.entries {
+            assert_eq!(p.get(&e.key), Some(e.crate_value().as_str()));
+            assert_eq!(p.get(&e.key.to_ascii_uppercase()), Some(e.crate_value().as_str()));
+            assert_eq!(p.get(&e.key.to_ascii_lowercase()), Some(e.crate_value().as_str()));
+        }
+        assert_eq!(p.get("no-such-field-here"), None);
+    }
+    // `Paragraph: FromStr` reads exactly a one-paragraph document.
+    let single = text.parse::<Paragraph>();
+    match doc.paras.len() {
+        0 => assert!(matches!(single, Err(Error::UnexpectedEof)), "{single:?}"),
+        1 => assert_eq!(single.unwrap(), ours.iter().next().unwrap().clone()),
+        _ => assert!(matches!(single, Err(Error::ExpectedEof)), "{single:?}"),
+    }
+}
