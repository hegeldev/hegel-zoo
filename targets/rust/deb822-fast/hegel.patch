+// ---------------------------------------------------------------------------
+// Editing a paragraph against a list model
+// ---------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+enum Edit {
+    Insert(String, String),
+    Set(String, String),
+    SetOrdered(String, String, bool),
+    Remove(String),
+    TraitSet(String, String),
+    TraitRemove(String),
+}
+
+#[hegel::composite]
+fn arb_edit(tc: &hegel::TestCase, keys: Vec<String>) -> Edit {
+    let key = {
+        let k = pick(tc, &keys);
+        match tc.draw(int!(0, 3)) {
+            0 => k.to_ascii_uppercase(),
+            1 => k.to_ascii_lowercase(),
+            _ => k,
+        }
+    };
+    let value = tc.draw(arb_line(true));
+    match tc.draw(int!(0, 5)) {
+        0 => Edit::Insert(key, value),
+        1 => Edit::Set(key, value),
+        2 => Edit::SetOrdered(key, value, tc.draw(generators::booleans())),
+        3 => Edit::Remove(key),
+        4 => Edit::TraitSet(key, value),
+        _ => Edit::TraitRemove(key),
+    }
+}
+
+type Model = Vec<(String, String)>;
+
+fn model_apply(model: &mut Model, edit: &Edit) {
+    match edit {
+        Edit::Insert(k, v) => model.push((k.clone(), v.clone())),
+        Edit::Set(k, v) | Edit::TraitSet(k, v) | Edit::SetOrdered(k, v, _) => {
+            if let Some(f) = model.iter_mut().find(|(n, _)| n.eq_ignore_ascii_case(k)) {
+                f.1 = v.clone();
+            } else {
+                // `set` appends; `set_with_field_order` places the field
+                // somewhere (checked separately) — mark with a placeholder.
+                model.push((k.clone(), v.clone()));
+            }
+        }
+        Edit::Remove(k) | Edit::TraitRemove(k) => model.retain(|(n, _)| !n.eq_ignore_ascii_case(k)),
+    }
+}
+
+fn position_in(order: &[&str], name: &str) -> Option<usize> {
+    order.iter().position(|f| f.eq_ignore_ascii_case(name))
+}
+
+fn known_in_order(p: &Paragraph, order: &[&str]) -> Vec<usize> {
+    p.fields.iter().filter_map(|f| position_in(order, &f.name)).collect()
+}
+
+fn is_sorted<T: PartialOrd>(v: &[T]) -> bool {
+    v.windows(2).all(|w| w[0] <= w[1])
+}
+
+#[hegel::test]
+fn edits_follow_the_list_model(tc: hegel::TestCase) {
+    let mut para = tc.draw(arb_built_para().print_as_debug());
+    let mut model: Model = para_items(&para);
+    let mut keys: Vec<String> = model.iter().map(|(k, _)| k.clone()).collect();
+    let extra = tc.draw(arb_keys(3).print_as_debug());
+    keys.extend(extra);
+    let n = tc.draw(int!(0, 6));
+    for _ in 0..n {
+        let edit = tc.draw(arb_edit(keys.clone()).print_as_debug());
+        match &edit {
+            Edit::Insert(k, v) => para.insert(k, v),
+            Edit::Set(k, v) => para.set(k, v),
+            Edit::TraitSet(k, v) => Deb822LikeParagraph::set(&mut para, k, v),
+            Edit::Remove(k) => para.remove(k),
+            Edit::TraitRemove(k) => Deb822LikeParagraph::remove(&mut para, k),
+            Edit::SetOrdered(k, v, binary) => {
+                let order = if *binary { BINARY_FIELD_ORDER } else { SOURCE_FIELD_ORDER };
+                let before = para.clone();
+                para.set_with_field_order(k, v, order);
+                // The value is set (on the first of any duplicates `insert`
+                // made), no field is added if one existed …
+                assert_eq!(para.get(k), Some(v.as_str()), "after {edit:?} on {before:?}");
+                let count = |p: &Paragraph| p.fields.iter().filter(|f| f.name.eq_ignore_ascii_case(k)).count();
+                assert_eq!(count(&para), count(&before).max(1), "after {edit:?} on {before:?}");
+                if before.get(k).is_some() {
+                    // … in place for an existing field …
+                    assert_eq!(
+                        para.fields.iter().map(|f| f.name.clone()).collect::<Vec<_>>(),
+                        before.fields.iter().map(|f| f.name.clone()).collect::<Vec<_>>(),
+                        "set_with_field_order moved fields: {edit:?} on {before:?}"
+                    );
+                } else {
+                    // … and a new field keeps the others in their order.
+                    let others: Vec<&Field> =
+                        para.fields.iter().filter(|f| !f.name.eq_ignore_ascii_case(k)).collect();
+                    assert_eq!(
+                        others.iter().map(|f| (*f).clone()).collect::<Vec<_>>(),
+                        before.fields,
+                        "set_with_field_order reordered fields: {edit:?} on {before:?}"
+                    );
+                    let known_before = known_in_order(&before, order);
+                    if is_sorted(&known_before) && position_in(order, k).is_some() {
+                        assert!(
+                            is_sorted(&known_in_order(&para, order)),
+                            "canonical order broken by {edit:?} on {before:?}: {para:?}"
+                        );
+                    }
+                }
+                // The model does not know where it went: realign it.
+                model_apply(&mut model, &edit);
+                let mut m2 = para_items(&para);
+                m2.sort();
+                let mut m1 = model.clone();
+                m1.sort();
+                assert_eq!(m2, m1, "after {edit:?} on {before:?}");
+                model = para_items(&para);
+                continue;
+            }
+        }
+        model_apply(&mut model, &edit);
+        assert_eq!(para_items(&para), model, "after {edit:?}");
+    }
+    // Accessors agree with the model.
+    assert_eq!(para.len(), model.len());
+    assert_eq!(para.is_empty(), model.is_empty());
+    for k in &keys {
+        let expect = model.iter().find(|(n, _)| n.eq_ignore_ascii_case(k)).map(|(_, v)| v.as_str());
+        assert_eq!(para.get(k), expect, "get({k:?})");
+        assert_eq!(Deb822LikeParagraph::get(&para, k), expect.map(|s| s.to_string()));
+    }
+    // iter_mut edits every value in place.
+    for (_, v) in para.iter_mut() {
+        v.push('!');
+    }
+    let bumped: Model = model.iter().map(|(k, v)| (k.clone(), format!("{v}!"))).collect();
+    assert_eq!(para_items(&para), bumped);
+    // Collecting the items rebuilds the paragraph.
+    let rebuilt: Paragraph = para.clone().into_iter().collect();
+    assert_eq!(rebuilt, para);
+    let from_vec = Paragraph::from(para.clone().into_iter().collect::<Vec<_>>());
+    assert_eq!(from_vec, para);
+}
+
+#[hegel::test]
+fn set_with_field_order_keeps_unknown_fields_sorted(tc: hegel::TestCase) {
+    // All-unknown paragraphs whose names are sorted stay sorted.
+    let n = tc.draw(int!(0, 4)) as usize;
+    let mut keys: Vec<String> = tc.draw(arb_keys(n + 1).print_as_debug());
+    keys.retain(|k| position_in(BINARY_FIELD_ORDER, k).is_none());
+    if keys.is_empty() {
+        return;
+    }
+    keys.sort();
+    keys.dedup();
+    let new = keys.remove(tc.draw(int!(0, keys.len() as i64 - 1)) as usize);
+    let mut para = Paragraph { fields: vec![] };
+    for k in &keys {
+        para.insert(k, "v");
+    }
+    para.set_with_field_order(&new, "new", BINARY_FIELD_ORDER);
+    let names: Vec<&String> = para.fields.iter().map(|f| &f.name).collect();
+    assert!(is_sorted(&names), "{names:?} after inserting {new:?} into {keys:?}");
+}
