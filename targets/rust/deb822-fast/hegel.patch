+/// deb822-fast/1: a whitespace-only line ends a paragraph for dpkg,
+/// python-debian and the crate's own `ParagraphReader`; the owned and the
+/// borrowed parser read it as an (empty) continuation line of the last field.
+#[hegel::test]
+fn a_whitespace_only_line_ends_a_paragraph(tc: hegel::TestCase) {
+    let ws = tc.draw(arb_hws(false));
+    let text = format!("K: a\n{ws}\nJ: b\n");
+    let py = pydebian(&text).unwrap();
+    let dp = dpkg(&text).unwrap();
+    assert_eq!(py.len(), 2);
+    assert_eq!(dp.len(), 2);
+    let streamed: Vec<Paragraph> = reader_paras(&text).into_iter().map(|r| r.unwrap()).collect();
+    assert_eq!(streamed.len(), 2);
+    let owned: Deb822 = text.parse().unwrap();
+    assert_eq!(owned.len(), 2, "owned parser read {owned:?} for {text:?}");
+    let borrowed = parse_borrowed(&text).unwrap();
+    assert_eq!(borrowed.len(), 2);
+}
+
+/// deb822-fast/2: a whitespace-only line between paragraphs (or before the
+/// first) is skipped by the borrowed parser, the `ParagraphReader`, dpkg and
+/// python-debian, and rejected by the owned parser.
+#[hegel::test]
+fn a_whitespace_only_line_between_paragraphs_is_skipped(tc: hegel::TestCase) {
+    let ws = tc.draw(arb_hws(false));
+    let text = if tc.draw(generators::booleans()) {
+        format!("K: a\n\n{ws}\nJ: b\n")
+    } else {
+        format!("{ws}\nK: a\n\nJ: b\n")
+    };
+    assert_eq!(pydebian(&text).unwrap().len(), 2);
+    assert_eq!(dpkg(&text).unwrap().len(), 2);
+    assert_eq!(parse_borrowed(&text).unwrap().len(), 2);
+    let streamed: Vec<Paragraph> = reader_paras(&text).into_iter().map(|r| r.unwrap()).collect();
+    assert_eq!(streamed.len(), 2);
+    let owned = text.parse::<Deb822>();
+    assert_eq!(owned.map(|d| d.len()).map_err(|e| e.to_string()), Ok(2), "for {text:?}");
+}
+
+/// deb822-fast/3: a CRLF document with two paragraphs does not parse (the
+/// `\r` of the blank line is read as a field name without a colon), and the
+/// values of a CRLF document keep their `\r`.
+#[hegel::test]
+fn crlf_documents_are_read_like_python_debian(tc: hegel::TestCase) {
+    let mut opts = tc.draw(arb_opts().print_as_debug());
+    opts.crlf = true;
+    opts.ws_separator = false;
+    let doc = tc.draw(arb_doc(opts).print_as_debug());
+    let text = doc.text();
+    let py = pydebian(&text).unwrap();
+    let ours: Deb822 = text.parse().unwrap_or_else(|e| panic!("parse failed for {text:?}: {e}"));
+    compare_paras("python-debian", &text, &crate_paras(&ours), &py, false);
+    for p in ours.iter() {
+        for (k, v) in p.iter() {
+            assert!(!v.contains('\r'), "{k}: {v:?} keeps a carriage return in {text:?}");
+        }
+    }
+}
+
+/// deb822-fast/4: whitespace between the field name and the colon is part of
+/// the name (dpkg and python-debian: the name is `K`), and a name containing
+/// whitespace is accepted (dpkg: syntax error).
+#[hegel::test]
+fn whitespace_before_the_colon_is_not_part_of_the_field_name(tc: hegel::TestCase) {
+    let key = tc.draw(arb_key());
+    let ws = tc.draw(arb_hws(false));
+    let text = format!("{key}{ws}: v\n");
+    let dp = dpkg(&text).unwrap();
+    assert_eq!(dp, vec![vec![(key.clone(), "v".to_string())]]);
+    let py = pydebian(&text).unwrap();
+    assert_eq!(py, vec![vec![(key.clone(), "v".to_string())]]);
+    let ours: Deb822 = text.parse().unwrap();
+    let p = ours.iter().next().unwrap();
+    assert_eq!(p.get(&key), Some("v"), "for {text:?}: {p:?}");
+    assert_eq!(p.fields[0].name, key);
+}
+
+/// deb822-fast/5: `Display` writes an empty continuation line as a single
+/// space, which dpkg and python-debian read as the end of the paragraph
+/// (`convert::format_multi_line` writes ` .`).
+#[hegel::test]
+fn display_of_an_empty_continuation_line_is_read_by_the_references(tc: hegel::TestCase) {
+    let a = tc.draw(arb_line(false));
+    let b = tc.draw(arb_line(false));
+    let mut para = Paragraph { fields: vec![] };
+    para.insert("K", &format!("{a}\n\n{b}"));
+    para.insert("J", "x");
+    let shown = para.to_string();
+    let ours = vec![para_items(&para)];
+    let py = pydebian(&shown).unwrap();
+    compare_paras("python-debian", &shown, &ours, &py, false);
+    let dp = dpkg(&shown).unwrap_or_else(|e| panic!("dpkg failed for {shown:?}: {e}"));
+    compare_paras("dpkg", &shown, &ours, &dp, true);
+}
+
+/// deb822-fast/6: `Display` of a value ending in a newline (as the parser
+/// produces for a trailing ` ` continuation line) writes a blank line after
+/// the field, so the paragraph is split in two on re-parse.
+#[hegel::test]
+fn display_of_a_value_ending_in_a_newline_round_trips(tc: hegel::TestCase) {
+    let a = tc.draw(arb_line(false));
+    let mut para = Paragraph { fields: vec![] };
+    para.insert("K", &format!("{a}\n"));
+    para.insert("J", "x");
+    let shown = para.to_string();
+    let again: Deb822 = shown.parse().unwrap();
+    assert_eq!(again.len(), 1, "display {shown:?} of {para:?} re-parses as {again:?}");
+    assert_eq!(again.iter().next().unwrap().len(), 2);
+}
+
+/// deb822-fast/7: the `ParagraphReader` skips an indented comment line before
+/// a paragraph that `from_str` (and the borrowed parser) reject.
+#[hegel::test]
+fn the_paragraph_reader_rejects_what_from_str_rejects(tc: hegel::TestCase) {
+    let ws = tc.draw(arb_hws(false));
+    let text = format!("{ws}# c\nK: a\n");
+    assert!(text.parse::<Deb822>().is_err());
+    assert!(parse_borrowed(&text).is_err());
+    let streamed = reader_paras(&text);
+    assert!(streamed.iter().any(|r| r.is_err()), "reader read {streamed:?} for {text:?}");
+}
