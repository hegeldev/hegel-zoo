+// ---------------------------------------------------------------------------
+// The three parsers of the crate agree
+// ---------------------------------------------------------------------------
+
+fn borrowed_paras(text: &str) -> Result<Paras, String> {
+    let paras = parse_borrowed(text).map_err(|e| err_key(&e))?;
+    let mut out = Vec::new();
+    for p in &paras {
+        let mut fields = Vec::new();
+        for f in p.iter() {
+            // Every accessor tells the same story.
+            let joined = f.join();
+            let lines: Vec<&str> = joined.split('\n').collect();
+            assert_eq!(f.lines(), lines.as_slice(), "lines() vs join() for {text:?}");
+            assert_eq!(f.is_single_line(), !joined.contains('\n'));
+            assert_eq!(f.is_multi_line(), joined.contains('\n'));
+            assert_eq!(f.as_single_line(), if joined.contains('\n') { None } else { Some(joined.as_str()) });
+            assert_eq!(p.get(f.name()).map(|l| l.len()), p.get_field(f.name()).map(|g| g.lines().len()));
+            fields.push((f.name().to_string(), joined));
+        }
+        assert_eq!(p.len(), fields.len());
+        assert_eq!(p.is_empty(), fields.is_empty());
+        out.push(fields);
+    }
+    // The streaming borrowed iterator yields the same paragraphs.
+    let mut iterated = Vec::new();
+    for r in iter_paragraphs_borrowed(text) {
+        iterated.push(r.unwrap_or_else(|e| panic!("iterator failed where parse_all succeeded: {e}")));
+    }
+    assert_eq!(iterated, paras, "iter_paragraphs_borrowed vs parse_borrowed for {text:?}");
+    Ok(out)
+}
+
+#[hegel::test]
+fn the_borrowed_parser_agrees_with_the_owned_parser(tc: hegel::TestCase) {
+    let text = tc.draw(arb_text().print_as_debug());
+    if hits_ws_between_paragraphs(&text) {
+        return;
+    }
+    let owned = text.parse::<Deb822>().map_err(|e| err_key(&e));
+    let borrowed = borrowed_paras(&text);
+    match (&owned, &borrowed) {
+        (Ok(o), Ok(b)) => assert_eq!(&crate_paras(o), b, "for {text:?}"),
+        (Err(eo), Err(eb)) => assert_eq!(eo, eb, "errors differ for {text:?}"),
+        _ => panic!("owned: {owned:?}\nborrowed: {borrowed:?}\nfor {text:?}"),
+    }
+}
+
+fn reader_paras(text: &str) -> Vec<Result<Paragraph, String>> {
+    Deb822::iter_paragraphs_from_reader(BufReader::new(text.as_bytes()))
+        .map(|r| r.map_err(|e| err_key(&e)))
+        .collect()
+}
+
+#[hegel::test]
+fn the_paragraph_reader_agrees_with_from_str(tc: hegel::TestCase) {
+    let text = tc.draw(arb_text().print_as_debug());
+    if text.split('\n').any(|l| l.trim().is_empty() && !l.is_empty())
+        || has_indented_comment_between_paragraphs(&text)
+    {
+        return;
+    }
+    let owned = text.parse::<Deb822>();
+    let streamed = reader_paras(&text);
+    match owned {
+        Ok(doc) => {
+            let got: Vec<Paragraph> = streamed
+                .into_iter()
+                .map(|r| r.unwrap_or_else(|e| panic!("reader failed where from_str succeeded: {e} for {text:?}")))
+                .collect();
+            assert_eq!(got, doc.into_iter().collect::<Vec<_>>(), "for {text:?}");
+        }
+        Err(e) => {
+            assert!(
+                streamed.iter().any(|r| r.is_err()),
+                "from_str failed ({e}) but the reader read {streamed:?} for {text:?}"
+            );
+        }
+    }
+}
