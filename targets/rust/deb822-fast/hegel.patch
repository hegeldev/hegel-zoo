+        .collect();
+    assert_eq!(got.split('\n').collect::<Vec<_>>(), expect, "for {value:?} -> {formatted:?}");
+    // Every reference reads it too.
+    let py = pydebian(&text).unwrap();
+    assert_eq!(py.len(), 1, "python-debian on {text:?}");
+    assert_eq!(norm(&py[0][0].1), norm(&got), "python-debian on {text:?}");
+    let dp = dpkg(&text).unwrap();
+    assert_eq!(norm_dpkg(&dp[0][0].1), norm_dpkg(&got), "dpkg on {text:?}");
