+#[hegel::test]
+fn license_values_are_read_like_python_debian(tc: hegel::TestCase) {
+    // The License field as the deb822 layer hands it over: first line, then
+    // continuation lines (python-debian sees them with their indent).
+    let lic = tc.draw(arb_gen_license(true).print_as_debug());
+    let lines = lic.field_lines();
+    let crate_value = lines.join("\n");
+    let py_value = {
+        let mut v = lines[0].clone();
+        for l in &lines[1..] {
+            v.push_str("\n ");
+            v.push_str(l);
+        }
+        v
+    };
+    let theirs = py_license_from_str(&py_value).unwrap();
+    let ours = License::from_str(&crate_value).unwrap();
+    assert_eq!(ours.name().unwrap_or(""), theirs.synopsis, "synopsis of {crate_value:?}");
+    assert_eq!(ours.text().unwrap_or(""), theirs.text, "text of {crate_value:?}");
+    assert_eq!(ours, lic.to_license());
+    // Display is the inverse.
+    assert_eq!(ours.to_string(), crate_value, "display of {ours:?}");
+    assert_eq!(License::from_str(&ours.to_string()).unwrap(), ours);
+    let expr = ours.expr();
+    assert_eq!(expr.is_some(), ours.name().is_some());
+}
