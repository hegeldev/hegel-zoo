+    let text = doc.text();
+    let lossy = LossyCopyright::from_str(&text).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+    let shown = lossy.to_string();
+    let again = LossyCopyright::from_str(&shown).unwrap_or_else(|e| panic!("lossy rejects its own output {shown:?}: {e}"));
+    assert_eq!(again, lossy, "{text:?} -> {shown:?}");
+    assert_eq!(again.to_string(), shown);
+    let ll = lossless::Copyright::from_str(&shown).unwrap_or_else(|e| panic!("lossless rejects the lossy output {shown:?}: {e}"));
