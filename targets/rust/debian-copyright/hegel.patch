+//! Hegel property tests for debian-copyright, checked against python-debian's
+//! `debian.copyright` (the reference implementation of DEP-5 parsing and glob
+//! matching) and against a model of the DEP-5 license-expression grammar.
+#![allow(clippy::all, dead_code, deprecated)]
+
+use debian_copyright::lossless;
+use debian_copyright::{glob, Copyright as LossyCopyright, GlobPattern, License, LicenseExpr};
+use hegel::generators::{self, Generator};
+use std::fmt::Debug;
+use std::io::{BufRead, BufReader, Write};
+use std::path::Path;
+use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
+use std::str::FromStr;
+use std::sync::{Mutex, OnceLock};
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+const CURRENT_FORMAT: &str = "https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/";
+
+// ---------------------------------------------------------------------------
+// Oracle: python-debian
+// ---------------------------------------------------------------------------
+
+const PYTHON_SCRIPT: &str = r#"
+import sys, json, binascii, io, logging
+logging.disable(logging.CRITICAL)
+from debian.copyright import Copyright, License, globs_to_re, FilesParagraph, LicenseParagraph
+
+def lic(l):
+    if l is None:
+        return None
+    return [l.synopsis, l.text]
+
+def header(h):
+    return {
+        'format': h.format, 'known': h.known_format(),
+        'upstream_name': h.upstream_name,
+        'upstream_contact': list(h.upstream_contact) or None,
+        'source': h.source, 'disclaimer': h.disclaimer, 'comment': h.comment,
+        'license': lic(h.license), 'copyright': h.copyright,
+        'files_excluded': list(h.files_excluded) or None,
+        'files_included': list(h.files_included) or None,
+    }
+
+def para(p):
+    if isinstance(p, FilesParagraph):
+        return {'kind': 'files', 'files': list(p.files), 'copyright': p.copyright,
+                'license': lic(p.license), 'comment': p.comment}
+    return {'kind': 'license', 'license': lic(p.license), 'comment': p.comment}
+
+for line in sys.stdin:
+    parts = line.rstrip('\n').split(' ')
+    cmd = parts[0]
+    args = [binascii.unhexlify(a).decode('utf-8') for a in parts[1:]]
+    try:
+        if cmd == 'C':
+            c = Copyright(io.StringIO(args[0]), strict=True)
+            out = {'ok': True, 'header': header(c.header),
+                   'paras': [para(p) for p in c.all_paragraphs() if p is not c.header]}
+        elif cmd == 'F':
+            c = Copyright(io.StringIO(args[0]), strict=True)
+            fps = list(c.all_files_paragraphs())
+            p = c.find_files_paragraph(args[1])
+            idx = -1
+            for i, q in enumerate(fps):
+                if q is p:
+                    idx = i
+            out = {'ok': True, 'index': idx}
+        elif cmd == 'G':
+            r = globs_to_re([args[0]])
+            out = {'ok': True, 'match': r.match(args[1]) is not None}
+        elif cmd == 'L':
+            out = {'ok': True, 'license': lic(License.from_str(args[0]))}
+        else:
+            out = {'ok': False, 'error': 'unknown command'}
+    except Exception as e:
+        out = {'ok': False, 'error': type(e).__name__ + ': ' + str(e)}
+    sys.stdout.write(json.dumps(out) + '\n')
+    sys.stdout.flush()
+"#;
+
+struct Child2 {
+    _child: Child,
+    stdin: ChildStdin,
+    stdout: BufReader<ChildStdout>,
+}
+
+fn python() -> &'static Mutex<Child2> {
+    static P: OnceLock<Mutex<Child2>> = OnceLock::new();
+    P.get_or_init(|| {
+        let mut child = Command::new("/usr/bin/python3")
+            .args(["-c", PYTHON_SCRIPT])
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()
+            .expect("cannot start python3");
+        let stdin = child.stdin.take().unwrap();
+        let stdout = BufReader::new(child.stdout.take().unwrap());
+        Mutex::new(Child2 { _child: child, stdin, stdout })
+    })
+}
+
+fn ask(cmd: &str, args: &[&str]) -> serde_json::Value {
+    let mut c = python().lock().unwrap_or_else(|e| e.into_inner());
+    let mut line = cmd.to_string();
+    for a in args {
+        line.push(' ');
+        for b in a.bytes() {
+            line.push_str(&format!("{b:02x}"));
+        }
+    }
+    writeln!(c.stdin, "{line}").unwrap();
+    c.stdin.flush().unwrap();
+    let mut reply = String::new();
+    c.stdout.read_line(&mut reply).unwrap();
+    assert!(!reply.is_empty(), "python oracle died");
+    serde_json::from_str(&reply).unwrap_or_else(|e| panic!("bad oracle reply {reply:?}: {e}"))
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+struct PyLicense {
+    synopsis: String,
+    text: String,
+}
+
+fn py_license(v: &serde_json::Value) -> Option<PyLicense> {
+    let a = v.as_array()?;
+    Some(PyLicense {
+        synopsis: a[0].as_str().unwrap().to_string(),
+        text: a[1].as_str().unwrap_or("").to_string(),
+    })
+}
+
+fn opt_str(v: &serde_json::Value) -> Option<String> {
+    v.as_str().map(|s| s.to_string())
+}
+
+fn opt_list(v: &serde_json::Value) -> Option<Vec<String>> {
+    v.as_array()
+        .map(|a| a.iter().map(|x| x.as_str().unwrap().to_string()).collect())
+}
+
+#[derive(Clone, Debug)]
+struct PyHeader {
+    format: String,
+    known: bool,
+    upstream_name: Option<String>,
+    upstream_contact: Option<Vec<String>>,
+    source: Option<String>,
+    disclaimer: Option<String>,
+    comment: Option<String>,
+    license: Option<PyLicense>,
+    copyright: Option<String>,
+    files_excluded: Option<Vec<String>>,
+    files_included: Option<Vec<String>>,
+}
+
+#[derive(Clone, Debug)]
+enum PyPara {
+    Files {
+        files: Vec<String>,
+        copyright: String,
+        license: Option<PyLicense>,
+        comment: Option<String>,
+    },
+    License {
+        license: PyLicense,
+        comment: Option<String>,
+    },
+}
+
+#[derive(Clone, Debug)]
+struct PyCopyright {
+    header: PyHeader,
+    paras: Vec<PyPara>,
+}
+
+fn pydebian(text: &str) -> Result<PyCopyright, String> {
+    let v = ask("C", &[text]);
+    if v["ok"] != true {
+        return Err(v["error"].as_str().unwrap_or("?").to_string());
+    }
+    let h = &v["header"];
+    let header = PyHeader {
+        format: h["format"].as_str().unwrap_or("").to_string(),
+        known: h["known"].as_bool().unwrap_or(false),
+        upstream_name: opt_str(&h["upstream_name"]),
+        upstream_contact: opt_list(&h["upstream_contact"]),
+        source: opt_str(&h["source"]),
+        disclaimer: opt_str(&h["disclaimer"]),
+        comment: opt_str(&h["comment"]),
+        license: py_license(&h["license"]),
+        copyright: opt_str(&h["copyright"]),
+        files_excluded: opt_list(&h["files_excluded"]),
+        files_included: opt_list(&h["files_included"]),
+    };
+    let paras = v["paras"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|p| {
+            if p["kind"] == "files" {
+                PyPara::Files {
+                    files: opt_list(&p["files"]).unwrap_or_default(),
+                    copyright: p["copyright"].as_str().unwrap_or("").to_string(),
+                    license: py_license(&p["license"]),
+                    comment: opt_str(&p["comment"]),
+                }
+            } else {
+                PyPara::License {
+                    license: py_license(&p["license"]).unwrap(),
+                    comment: opt_str(&p["comment"]),
+                }
+            }
+        })
+        .collect();
+    Ok(PyCopyright { header, paras })
+}
+
+/// Index (among the Files paragraphs) of python-debian's `find_files_paragraph`.
+fn py_find_files(text: &str, path: &str) -> Result<Option<usize>, String> {
+    let v = ask("F", &[text, path]);
+    if v["ok"] != true {
+        return Err(v["error"].as_str().unwrap_or("?").to_string());
+    }
+    let i = v["index"].as_i64().unwrap();
+    Ok(if i < 0 { None } else { Some(i as usize) })
+}
+
+/// python-debian's `globs_to_re([pattern]).match(path)`: None if the pattern is illegal.
+fn py_glob(pattern: &str, path: &str) -> Option<bool> {
+    let v = ask("G", &[pattern, path]);
+    if v["ok"] != true {
+        return None;
+    }
+    v["match"].as_bool()
+}
+
+fn py_license_from_str(value: &str) -> Result<PyLicense, String> {
+    let v = ask("L", &[value]);
+    if v["ok"] != true {
+        return Err(v["error"].as_str().unwrap_or("?").to_string());
+    }
+    Ok(py_license(&v["license"]).unwrap())
+}
+
+// ---------------------------------------------------------------------------
+// Generators
+// ---------------------------------------------------------------------------
+
+fn pick<T: Clone + Send + Sync + Debug + 'static>(tc: &hegel::TestCase, items: &[T]) -> T {
+    tc.draw(generators::sampled_from(items.to_vec()).print_as_debug())
+}
+
+const PATTERN_CHARS: &[char] = &['a', 'b', 'c', 'd', '.', '/', '-', '_', '*', '?', '(', 'é'];
+const PATH_CHARS: &[char] = &['a', 'b', 'c', 'd', '.', '/', '-', '_', '*', '?', '\\', '(', 'x', 'é'];
+
+/// A DEP-5 glob pattern (no whitespace). With `allow_invalid`, may contain a
+/// bad escape (`\x` or a trailing backslash).
+#[hegel::composite]
+fn arb_pattern(tc: &hegel::TestCase, allow_invalid: bool) -> String {
+    let n = tc.draw(int!(1, 8));
+    let mut s = String::new();
+    for _ in 0..n {
+        if tc.draw(int!(0, 6)) == 0 {
+            s.push('\\');
+            let esc = if allow_invalid && tc.draw(int!(0, 2)) == 0 {
+                pick(tc, &['x', 'n', 'a'])
+            } else {
+                pick(tc, &['*', '?', '\\'])
+            };
+            s.push(esc);
+        } else {
+            s.push(pick(tc, PATTERN_CHARS));
+        }
+    }
+    if allow_invalid && tc.draw(int!(0, 9)) == 0 {
+        s.push('\\');
+    }
+    s
+}
+
+#[hegel::composite]
+fn arb_path(tc: &hegel::TestCase, allow_newline: bool) -> String {
+    let n = tc.draw(int!(0, 10));
+    let mut s = String::new();
+    for _ in 0..n {
+        if allow_newline && tc.draw(int!(0, 9)) == 0 {
+            s.push('\n');
+        } else {
+            s.push(pick(tc, PATH_CHARS));
+        }
+    }
+    s
+}
+
+/// A path built to have a chance of matching `pattern`: the pattern with its
+/// wildcards replaced.
+#[hegel::composite]
+fn arb_path_for(tc: &hegel::TestCase, pattern: String) -> String {
+    let mut out = String::new();
+    let mut it = pattern.chars();
+    while let Some(c) = it.next() {
+        match c {
+            '*' => {
+                let n = tc.draw(int!(0, 4));
+                for _ in 0..n {
+                    out.push(pick(tc, PATH_CHARS));
+                }
+            }
+            '?' => out.push(pick(tc, PATH_CHARS)),
+            '\\' => {
+                if let Some(e) = it.next() {
+                    out.push(e);
+                }
+            }
+            c => out.push(c),
+        }
+    }
+    // Sometimes perturb the path so that it stops matching.
+    if tc.draw(int!(0, 3)) == 0 {
+        let pos = tc.draw(int!(0, out.chars().count() as i64)) as usize;
+        let mut chars: Vec<char> = out.chars().collect();
+        chars.insert(pos, pick(tc, PATH_CHARS));
+        out = chars.into_iter().collect();
+    }
+    out
+}
+
+const LICENSE_NAMES: &[&str] = &[
+    "MIT", "GPL-2+", "GPL-3", "LGPL-2.1+", "Apache-2.0", "BSD-3-clause", "Expat", "ISC", "MPL-2.0",
+    "CC0-1.0", "Zlib", "X11", "Artistic-2.0", "GFDL-1.3+", "public-domain", "GPL-2.0+",
+];
+const EXCEPTIONS: &[&str] = &["OpenSSL-exception", "Font-exception-2.0", "Classpath-exception-2.0", "Autoconf-exception"];
+
+#[hegel::composite]
+fn arb_license_name(tc: &hegel::TestCase) -> String {
+    if tc.draw(int!(0, 3)) != 0 {
+        pick(tc, LICENSE_NAMES).to_string()
+    } else {
+        let n = tc.draw(int!(1, 6));
+        let s: String = (0..n)
+            .map(|_| pick(tc, &['A', 'B', 'G', 'L', 'x', 'y', '1', '2', '.', '-', '+']))
+            .collect();
+        // Never an operator word (case-insensitively) and never starting with a
+        // dash-only name that could look like an option; keep it a single token.
+        if s.eq_ignore_ascii_case("or") || s.eq_ignore_ascii_case("and") || s.eq_ignore_ascii_case("with") {
+            format!("{s}1")
+        } else {
+            s
+        }
+    }
+}
+
+const WORDS: &[&str] = &[
+    "This", "program", "is", "free", "software;", "you", "can", "redistribute", "it", "under",
+    "the", "terms", "of", "License,", "version", "2", "or", "(at", "your", "option)", "any",
+    "later", "Copyright", "(C)", "2019", "Jöhn", "Doe", "<john@example.com>", "and", "with", "*",
+];
+
+/// A line of text without leading/trailing whitespace and not starting with
+/// `#` or `.` (deb822 comment / paragraph-marker shapes).
+#[hegel::composite]
+fn arb_text_line(tc: &hegel::TestCase) -> String {
+    let n = tc.draw(int!(1, 5));
+    let words: Vec<&str> = (0..n).map(|_| pick(tc, WORDS)).collect();
+    let s = words.join(" ");
+    if s.starts_with('#') || s.starts_with('.') {
+        format!("x{s}")
+    } else {
+        s
+    }
+}
+
+/// License text lines as they are meant (blank lines allowed, extra indentation
+/// allowed on some lines).
+#[hegel::composite]
+fn arb_text_lines(tc: &hegel::TestCase) -> Vec<String> {
+    let n = tc.draw(int!(1, 4));
+    let mut lines = Vec::new();
+    for _ in 0..n {
+        let kind = tc.draw(int!(0, 5));
+        let line = if kind == 0 {
+            String::new()
+        } else if kind == 1 {
+            format!("{}{}", " ".repeat(tc.draw(int!(1, 3)) as usize), tc.draw(arb_text_line()))
+        } else {
+            tc.draw(arb_text_line())
+        };
+        lines.push(line);
+    }
+    // A blank first line would be a paragraph marker on the first line, which
+    // has no meaning; make it text.
+    if lines[0].is_empty() {
+        lines[0] = "text".to_string();
+    }
+    // A trailing blank line is dropped by every serialiser (python-debian's
+    // `License.to_str` included), so it is not part of the model.
+    while lines.len() > 1 && lines.last().unwrap().is_empty() {
+        lines.pop();
+    }
+    lines
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct GenLicense {
+    /// The synopsis (first line); may be empty with `text` present.
+    name: String,
+    text: Option<Vec<String>>,
+}
+
+impl GenLicense {
+    fn to_license(&self) -> License {
+        match (&self.name, &self.text) {
+            (n, None) => License::Name(n.clone()),
+            (n, Some(t)) if n.is_empty() => License::Text(t.join("\n")),
+            (n, Some(t)) => License::Named(n.clone(), t.join("\n")),
+        }
+    }
+    /// The field value as written in a file: encoded paragraph markers.
+    fn field_lines(&self) -> Vec<String> {
+        let mut v = vec![self.name.clone()];
+        if let Some(t) = &self.text {
+            v.extend(t.iter().map(|l| if l.is_empty() { ".".to_string() } else { l.clone() }));
+        }
+        v
+    }
+    fn py(&self) -> PyLicense {
+        PyLicense {
+            synopsis: self.name.clone(),
+            text: self.text.as_ref().map(|t| t.join("\n")).unwrap_or_default(),
+        }
+    }
+}
+
+#[hegel::composite]
+fn arb_gen_license(tc: &hegel::TestCase, allow_empty_name: bool) -> GenLicense {
+    let with_text = tc.draw(generators::booleans());
+    let name = if with_text && allow_empty_name && tc.draw(int!(0, 3)) == 0 {
+        String::new()
+    } else {
+        let e = tc.draw(arb_expr_text(2));
+        e
+    };
+    let text = if with_text { Some(tc.draw(arb_text_lines())) } else { None };
+    GenLicense { name, text }
+}
+
+#[derive(Clone, Debug, Default)]
+struct Opts {
+    /// `Files:` / `Copyright:` values starting on the continuation line.
+    empty_first_line: bool,
+    /// A `License:` field with text but no synopsis.
+    empty_synopsis: bool,
+    /// `#` comment lines between paragraphs.
+    comments: bool,
+    /// Header `Format` in a non-canonical spelling (http, no trailing slash).
+    odd_format: bool,
+}
+
+#[hegel::composite]
+fn arb_opts(tc: &hegel::TestCase) -> Opts {
+    Opts {
+        empty_first_line: tc.draw(generators::booleans()),
+        empty_synopsis: tc.draw(generators::booleans()),
+        comments: tc.draw(generators::booleans()),
+        odd_format: tc.draw(generators::booleans()),
+    }
+}
+
+#[derive(Clone, Debug)]
+struct GenHeader {
+    format: String,
+    upstream_name: Option<String>,
+    upstream_contact: Option<Vec<String>>,
+    source: Option<String>,
+    files_excluded: Option<Vec<String>>,
+    files_included: Option<Vec<String>>,
+    disclaimer: Option<String>,
+    comment: Option<Vec<String>>,
+    license: Option<GenLicense>,
+    copyright: Option<Vec<String>>,
+}
+
+#[derive(Clone, Debug)]
+enum GenPara {
+    Files {
+        files: Vec<String>,
+        copyright: Vec<String>,
+        license: GenLicense,
+        comment: Option<Vec<String>>,
+    },
+    License {
+        license: GenLicense,
+        comment: Option<Vec<String>>,
+    },
+}
+
+#[derive(Clone, Debug)]
+struct GenDoc {
+    header: GenHeader,
+    paras: Vec<GenPara>,
+    opts: Opts,
+    /// Per paragraph (header first): whether its multi-line fields start on
+    /// the continuation line.
+    first_line_empty: Vec<bool>,
+}
+
+#[hegel::composite]
+fn arb_patterns(tc: &hegel::TestCase) -> Vec<String> {
+    let n = tc.draw(int!(1, 3));
+    (0..n).map(|_| tc.draw(arb_pattern(false))).collect()
+}
+
+#[hegel::composite]
+fn arb_copyright_lines(tc: &hegel::TestCase) -> Vec<String> {
+    let n = tc.draw(int!(1, 3));
+    (0..n)
+        .map(|_| {
+            format!(
+                "{} {}",
+                pick(tc, &["2019", "2020-2023", "1999,", "© 2001"]),
+                pick(tc, &["John Doe", "Jane <jane@example.com>", "The Foo Authors", "Jöhn"])
+            )
+        })
+        .collect()
+}
+
+#[hegel::composite]
+fn arb_comment(tc: &hegel::TestCase) -> Vec<String> {
+    let n = tc.draw(int!(1, 2));
+    (0..n).map(|_| tc.draw(arb_text_line())).collect()
+}
+
+#[hegel::composite]
+fn arb_header(tc: &hegel::TestCase, opts: Opts) -> GenHeader {
+    let format = if opts.odd_format {
+        pick(
+            tc,
+            &[
+                "http://www.debian.org/doc/packaging-manuals/copyright-format/1.0/",
+                "https://www.debian.org/doc/packaging-manuals/copyright-format/1.0",
+                "http://www.debian.org/doc/packaging-manuals/copyright-format/1.0",
+            ],
+        )
+        .to_string()
+    } else {
+        CURRENT_FORMAT.to_string()
+    };
+    let maybe = |tc: &hegel::TestCase| tc.draw(int!(0, 2)) == 0;
+    GenHeader {
+        format,
+        upstream_name: if maybe(tc) { Some(pick(tc, &["foo", "libbar", "Foo Bar"]).to_string()) } else { None },
+        upstream_contact: if maybe(tc) {
+            let n = tc.draw(int!(1, 2));
+            Some((0..n).map(|_| pick(tc, &["Joe <joe@example.com>", "Jane Doe", "https://example.com/contact"]).to_string()).collect())
+        } else {
+            None
+        },
+        source: if maybe(tc) { Some(pick(tc, &["https://example.com/foo", "git://example.com/foo.git"]).to_string()) } else { None },
+        files_excluded: if maybe(tc) { Some(tc.draw(arb_patterns())) } else { None },
+        files_included: if maybe(tc) { Some(tc.draw(arb_patterns())) } else { None },
+        disclaimer: if maybe(tc) { Some(tc.draw(arb_text_line())) } else { None },
+        comment: if maybe(tc) { Some(tc.draw(arb_comment())) } else { None },
+        license: if maybe(tc) { Some(tc.draw(arb_gen_license(false).print_as_debug())) } else { None },
+        copyright: if maybe(tc) { Some(tc.draw(arb_copyright_lines())) } else { None },
+    }
+}
+
+#[hegel::composite]
+fn arb_para(tc: &hegel::TestCase, opts: Opts) -> GenPara {
+    if tc.draw(int!(0, 2)) != 0 {
+        GenPara::Files {
+            files: tc.draw(arb_patterns()),
+            copyright: tc.draw(arb_copyright_lines()),
+            license: tc.draw(arb_gen_license(opts.empty_synopsis).print_as_debug()),
+            comment: if tc.draw(int!(0, 2)) == 0 { Some(tc.draw(arb_comment())) } else { None },
+        }
+    } else {
+        let mut license = tc.draw(arb_gen_license(opts.empty_synopsis).print_as_debug());
+        if license.text.is_none() && tc.draw(int!(0, 2)) != 0 {
+            license.text = Some(tc.draw(arb_text_lines()));
+        }
+        GenPara::License { license, comment: if tc.draw(int!(0, 2)) == 0 { Some(tc.draw(arb_comment())) } else { None } }
+    }
+}
+
+#[hegel::composite]
+fn arb_doc(tc: &hegel::TestCase, opts: Opts) -> GenDoc {
+    let header = tc.draw(arb_header(opts.clone()).print_as_debug());
+    let n = tc.draw(int!(0, 4));
+    let mut paras = Vec::new();
+    for _ in 0..n {
+        paras.push(tc.draw(arb_para(opts.clone()).print_as_debug()));
+    }
+    let mut first_line_empty = Vec::new();
+    for _ in 0..=paras.len() {
+        first_line_empty.push(opts.empty_first_line && tc.draw(generators::booleans()));
+    }
+    GenDoc { header, paras, opts, first_line_empty }
+}
+
+fn write_field(out: &mut String, key: &str, lines: &[String], first_empty: bool) {
+    if lines.is_empty() {
+        return;
+    }
+    if first_empty {
+        out.push_str(&format!("{key}:\n"));
+        for l in lines {
+            out.push_str(&format!(" {}\n", if l.is_empty() { "." } else { l.as_str() }));
+        }
+    } else {
+        out.push_str(&format!("{key}: {}\n", lines[0]));
+        for l in &lines[1..] {
+            out.push_str(&format!(" {}\n", if l.is_empty() { "." } else { l.as_str() }));
+        }
+    }
+}
+
+fn write_license_field(out: &mut String, lic: &GenLicense) {
+    // A license field: synopsis on the first line (possibly empty), text on
+    // continuation lines with paragraph markers.
+    let lines = lic.field_lines();
+    if lines[0].is_empty() {
+        out.push_str("License:\n");
+    } else {
+        out.push_str(&format!("License: {}\n", lines[0]));
+    }
+    for l in &lines[1..] {
+        out.push_str(&format!(" {l}\n"));
+    }
+}
+
+impl GenDoc {
+    fn text(&self) -> String {
+        let mut out = String::new();
+        let h = &self.header;
+        let fe = self.first_line_empty[0];
+        out.push_str(&format!("Format: {}\n", h.format));
+        if let Some(v) = &h.upstream_name {
+            out.push_str(&format!("Upstream-Name: {v}\n"));
+        }
+        if let Some(v) = &h.upstream_contact {
+            write_field(&mut out, "Upstream-Contact", v, fe || v.len() > 1);
+        }
+        if let Some(v) = &h.source {
+            out.push_str(&format!("Source: {v}\n"));
+        }
+        if let Some(v) = &h.files_excluded {
+            write_field(&mut out, "Files-Excluded", v, fe);
+        }
+        if let Some(v) = &h.files_included {
+            write_field(&mut out, "Files-Included", v, fe);
+        }
+        if let Some(v) = &h.disclaimer {
+            out.push_str(&format!("Disclaimer: {v}\n"));
+        }
+        if let Some(v) = &h.comment {
+            write_field(&mut out, "Comment", v, false);
+        }
+        if let Some(v) = &h.license {
+            write_license_field(&mut out, v);
+        }
+        if let Some(v) = &h.copyright {
+            write_field(&mut out, "Copyright", v, fe);
+        }
+        for (i, p) in self.paras.iter().enumerate() {
+            out.push('\n');
+            if self.opts.comments && i % 2 == 0 {
+                out.push_str("# a comment between paragraphs\n");
+            }
+            let fe = self.first_line_empty[i + 1];
+            match p {
+                GenPara::Files { files, copyright, license, comment } => {
+                    write_field(&mut out, "Files", files, fe);
+                    write_field(&mut out, "Copyright", copyright, fe);
+                    write_license_field(&mut out, license);
+                    if let Some(c) = comment {
+                        write_field(&mut out, "Comment", c, false);
+                    }
+                }
+                GenPara::License { license, comment } => {
+                    write_license_field(&mut out, license);
+                    if let Some(c) = comment {
+                        write_field(&mut out, "Comment", c, false);
+                    }
+                }
+            }
+        }
+        out
+    }
+
+    fn files_paras(&self) -> Vec<&GenPara> {
+        self.paras.iter().filter(|p| matches!(p, GenPara::Files { .. })).collect()
+    }
+    fn license_paras(&self) -> Vec<&GenPara> {
+        self.paras.iter().filter(|p| matches!(p, GenPara::License { .. })).collect()
+    }
+
+    /// The model of `find_files`: the last Files paragraph with a matching pattern.
+    fn model_find_files(&self, path: &str) -> Option<usize> {
+        let fps = self.files_paras();
+        fps.iter()
+            .rposition(|p| match p {
+                GenPara::Files { files, .. } => files.iter().any(|f| model_glob(f, path) == Some(true)),
+                _ => false,
+            })
+    }
+
+    /// The model of `find_license_for_file`.
+    fn model_license_for_file(&self, path: &str) -> Option<GenLicense> {
+        let idx = self.model_find_files(path)?;
+        let GenPara::Files { license, .. } = self.files_paras()[idx] else { unreachable!() };
+        if license.text.is_some() {
+            return Some(license.clone());
+        }
+        self.license_paras().iter().find_map(|p| match p {
+            GenPara::License { license: l, .. } if l.name == license.name => Some(l.clone()),
+            _ => None,
+        })
+    }
+}
+
+/// A second implementation of DEP-5 glob matching: `*` any run, `?` one
+/// character, `\*`, `\?`, `\\` literal; None for an illegal pattern.
+fn model_glob(pattern: &str, path: &str) -> Option<bool> {
+    #[derive(Clone)]
+    enum Tok {
+        Star,
+        Any,
+        Lit(char),
+    }
+    let mut toks = Vec::new();
+    let mut it = pattern.chars();
+    while let Some(c) = it.next() {
+        match c {
+            '*' => toks.push(Tok::Star),
+            '?' => toks.push(Tok::Any),
+            '\\' => match it.next() {
+                Some(e @ ('*' | '?' | '\\')) => toks.push(Tok::Lit(e)),
+                _ => return None,
+            },
+            c => toks.push(Tok::Lit(c)),
+        }
+    }
+    let chars: Vec<char> = path.chars().collect();
+    fn go(toks: &[Tok], chars: &[char]) -> bool {
+        match toks.first() {
+            None => chars.is_empty(),
+            Some(Tok::Star) => (0..=chars.len()).any(|k| go(&toks[1..], &chars[k..])),
+            Some(Tok::Any) => !chars.is_empty() && go(&toks[1..], &chars[1..]),
+            Some(Tok::Lit(c)) => chars.first() == Some(c) && go(&toks[1..], &chars[1..]),
+        }
+    }
+    Some(go(&toks, &chars))
+}
+
+// ---------------------------------------------------------------------------
+// License expressions: a model of the grammar
+// ---------------------------------------------------------------------------
+
+/// Build a random expression tree.
+#[hegel::composite]
+fn arb_expr(tc: &hegel::TestCase, depth: u32) -> LicenseExpr {
+    let kind = if depth == 0 { tc.draw(int!(0, 1)) } else { tc.draw(int!(0, 3)) };
+    match kind {
+        0 => LicenseExpr::Name(tc.draw(arb_license_name())),
+        1 => LicenseExpr::WithException(tc.draw(arb_license_name()), pick(tc, EXCEPTIONS).to_string()),
+        k => {
+            let n = tc.draw(int!(2, 3));
+            let mut v = Vec::new();
+            for _ in 0..n {
+                v.push(tc.draw(arb_expr(depth - 1).print_as_debug()));
+            }
+            if k == 2 { LicenseExpr::And(v) } else { LicenseExpr::Or(v) }
+        }
+    }
+}
+
+/// The text of a random expression, for use as a license synopsis.
+#[hegel::composite]
+fn arb_expr_text(tc: &hegel::TestCase, depth: u32) -> String {
+    if tc.draw(int!(0, 2)) != 0 {
+        tc.draw(arb_license_name())
+    } else {
+        tc.draw(arb_expr(depth).print_as_debug()).to_string()
+    }
+}
+
+/// What a parser must return for a tree: nested `And` inside `And` and `Or`
+/// inside `Or` flattened (the grammar has no way to express the nesting).
+fn normalise(e: &LicenseExpr) -> LicenseExpr {
+    match e {
+        LicenseExpr::And(v) => {
+            let mut out = Vec::new();
+            for x in v {
+                match normalise(x) {
+                    LicenseExpr::And(inner) => out.extend(inner),
+                    other => out.push(other),
+                }
+            }
+            if out.len() == 1 { out.pop().unwrap() } else { LicenseExpr::And(out) }
+        }
+        LicenseExpr::Or(v) => {
+            let mut out = Vec::new();
+            for x in v {
+                match normalise(x) {
+                    LicenseExpr::Or(inner) => out.extend(inner),
+                    other => out.push(other),
+                }
+            }
+            if out.len() == 1 { out.pop().unwrap() } else { LicenseExpr::Or(out) }
+        }
+        other => other.clone(),
+    }
+}
+
+fn names_of(e: &LicenseExpr) -> Vec<String> {
+    match e {
+        LicenseExpr::Name(n) => vec![n.clone()],
+        LicenseExpr::WithException(n, _) => vec![n.clone()],
+        LicenseExpr::And(v) | LicenseExpr::Or(v) => v.iter().flat_map(names_of).collect(),
+    }
+}
+
+/// Any License text line with extra indentation (kept by python-debian and
+/// the lossless parser, stripped by the lossy parser: debian-copyright/4).
+fn indented(l: &GenLicense) -> bool {
+    l.text.as_ref().is_some_and(|t| t.iter().any(|line| line.starts_with(' ')))
+}
+
+fn hits_indented_text(doc: &GenDoc) -> bool {
+    doc.header.license.as_ref().is_some_and(indented)
+        || doc.paras.iter().any(|p| match p {
+            GenPara::Files { license, .. } | GenPara::License { license, .. } => indented(license),
+        })
+}
+
+fn sort_key(p: &str) -> (u8, usize) {
+    debian_copyright::pattern_sort_key(p, debian_copyright::pattern_depth(p))
+}
+
+/// A Files paragraph whose first pattern is not the one with the smallest
+/// sort key: `wrap_and_sort` orders paragraphs by the first pattern before
+/// sorting the patterns (debian-copyright/8).
+fn hits_unsorted_first_pattern(doc: &GenDoc) -> bool {
+    doc.paras.iter().any(|p| match p {
+        GenPara::Files { files, .. } => files.iter().any(|f| sort_key(f) < sort_key(&files[0])),
+        _ => false,
+    })
+}
+
+/// Any License field with text (a multi-line License value).
+fn hits_multiline_license(doc: &GenDoc) -> bool {
+    doc.header.license.as_ref().is_some_and(|l| l.text.is_some())
+        || doc.paras.iter().any(|p| match p {
+            GenPara::Files { license, .. } | GenPara::License { license, .. } => license.text.is_some(),
+        })
+}
+
+/// deb822-lossless bug: a value starting on the continuation line is read
+/// without its empty first line (`Files:\n *` is fine for `files()`, but a
+/// `License:` field with an empty synopsis loses the distinction).
+fn hits_empty_synopsis(doc: &GenDoc) -> bool {
+    let lic_empty = |l: &GenLicense| l.name.is_empty() && l.text.is_some();
+    doc.header.license.as_ref().is_some_and(lic_empty)
+        || doc.paras.iter().any(|p| match p {
+            GenPara::Files { license, .. } | GenPara::License { license, .. } => lic_empty(license),
+        })
+}
+
+// ---------------------------------------------------------------------------
+// Globs
+// ---------------------------------------------------------------------------
+
+#[hegel::test]
+fn globs_match_like_python_debian(tc: hegel::TestCase) {
+    let pattern = tc.draw(arb_pattern(true));
+    let path = if tc.draw(generators::booleans()) {
+        tc.draw(arb_path_for(pattern.clone()))
+    } else {
+        tc.draw(arb_path(false))
+    };
+    let ours = GlobPattern::try_new(&pattern);
+    let theirs = py_glob(&pattern, &path);
+    let model = model_glob(&pattern, &path);
+    assert_eq!(ours.is_ok(), theirs.is_some(), "validity of {pattern:?}: ours {:?}, python {theirs:?}", ours.as_ref().err());
+    assert_eq!(ours.is_ok(), model.is_some(), "validity of {pattern:?} vs model");
+    if let Ok(g) = &ours {
+        assert_eq!(Some(g.is_match(&path)), theirs, "{pattern:?} against {path:?}: python differs");
+        assert_eq!(Some(g.is_match(&path)), model, "{pattern:?} against {path:?}: model differs");
+        assert_eq!(g.is_match_path(Path::new(&path)), g.is_match(&path));
+        assert_eq!(g.pattern(), pattern);
+        assert_eq!(g.to_string(), pattern);
+        assert_eq!(GlobPattern::from_str(&pattern).unwrap().is_match(&path), g.is_match(&path));
+    } else {
+        let err = ours.unwrap_err();
+        assert_eq!(err.pattern(), pattern);
+        assert!(GlobPattern::from_str(&pattern).is_err());
+    }
+    // literal_path / is_glob
+    let lit = glob::literal_path(&pattern);
+    let has_wildcard = {
+        let mut it = pattern.chars();
+        let mut w = false;
+        while let Some(c) = it.next() {
+            match c {
+                '*' | '?' => w = true,
+                '\\' => {
+                    it.next();
+                }
+                _ => {}
+            }
+        }
+        w
+    };
+    assert_eq!(glob::is_glob(&pattern), lit.is_none());
+    if model.is_none() || has_wildcard {
+        assert_eq!(lit, None, "{pattern:?}");
+    } else {
+        let l = lit.expect("literal path for a wildcard-free pattern");
+        assert_eq!(model_glob(&pattern, &l), Some(true), "{pattern:?} does not match its own literal path {l:?}");
+        assert_eq!(model_glob(&pattern, &format!("{l}x")), Some(false));
+    }
+}
+
+#[hegel::test]
+fn globs_match_newlines_like_python_debian(tc: hegel::TestCase) {
+    // python-debian anchors with `\Z` and DOTALL so that `*` spans newlines in
+    // filenames.
+    let pattern = tc.draw(arb_pattern(false));
+    let path = tc.draw(arb_path(true));
+    let g = GlobPattern::try_new(&pattern).unwrap();
+    assert_eq!(Some(g.is_match(&path)), py_glob(&pattern, &path), "{pattern:?} against {path:?}");
+    assert_eq!(Some(g.is_match(&path)), model_glob(&pattern, &path), "{pattern:?} against {path:?} (model)");
+}
