+#[hegel::test]
+fn incomplete_files_are_rejected_by_everyone(tc: hegel::TestCase) {
+    // Drop a required field from a Files paragraph, or add a paragraph that is
+    // neither Files nor License: python-debian (strict) and the lossy parser
+    // both reject; the lossless parser reads what is there.
+    let mut opts = tc.draw(arb_opts().print_as_debug());
+    opts.empty_synopsis = false;
+    opts.comments = false;
+    let doc = tc.draw(arb_doc(opts).print_as_debug());
+    let mut text = doc.text();
+    let kind = tc.draw(int!(0, 2));
+    let files_idx: Vec<usize> = doc
+        .paras
+        .iter()
+        .enumerate()
+        .filter(|(_, p)| matches!(p, GenPara::Files { .. }))
+        .map(|(i, _)| i)
+        .collect();
+    match kind {
+        0 | 1 if !files_idx.is_empty() => {
+            // Remove the Copyright (0) or License (1) field of one Files paragraph.
+            let i = pick(&tc, &files_idx);
+            let field = if kind == 0 { "Copyright:" } else { "License:" };
+            let paras: Vec<&str> = text.split("\n\n").collect();
+            let mut parts: Vec<String> = paras.iter().map(|s| s.to_string()).collect();
+            let target = &mut parts[i + 1];
+            let mut lines: Vec<&str> = target.lines().collect();
+            let start = lines.iter().position(|l| l.starts_with(field)).unwrap();
+            let mut end = start + 1;
+            while end < lines.len() && lines[end].starts_with(' ') {
+                end += 1;
+            }
+            lines.drain(start..end);
+            *target = lines.join("\n");
+            text = parts.join("\n\n");
+            if !text.ends_with('\n') {
+                text.push('\n');
+            }
+        }
+        _ => {
+            text.push_str("\nFoo: bar\n");
+        }
+    }
+    let py = pydebian(&text);
+    assert!(py.is_err(), "python-debian accepts {text:?}");
+    assert!(LossyCopyright::from_str(&text).is_err(), "lossy accepts {text:?}");
+    let c = lossless::Copyright::from_str(&text).unwrap_or_else(|e| panic!("lossless rejects {text:?}: {e}"));
+    assert_eq!(c.to_string(), text);
+    let _ = c.iter_files().count();
+    let _ = c.iter_licenses().count();
+    let _ = c.find_files(Path::new("x"));
+}
