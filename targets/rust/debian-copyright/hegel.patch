+    let mut c = lossless::Copyright::from_str(&text).unwrap();
+    let before = c.iter_files().next().unwrap().license().unwrap();
+    assert_eq!(before.text(), Some(format!("text\n{extra}indented").as_str()));
+    c.wrap_and_sort(deb822_lossless::Indentation::Spaces(1), false, None);
+    let after_text = c.to_string();
+    let after = lossless::Copyright::from_str(&after_text).unwrap().iter_files().next().unwrap().license().unwrap();
+    assert_eq!(after, before, "license after wrap_and_sort: {text:?} -> {after_text:?}");
+}
+
+/// debian-copyright/6: Display does not flatten a nested same-operator tree,
+/// so `And([A, Or([B, Or([C, D])])])` prints as `A, and B, or C or D`, which
+/// both parsers read as `(A and B) or C or D`.
+#[hegel::test]
+fn display_of_a_nested_or_is_read_back(tc: hegel::TestCase) {
+    let names: Vec<String> = (0..4).map(|_| tc.draw(arb_license_name())).collect();
+    let n = |i: usize| LicenseExpr::Name(names[i].clone());
+    let e = LicenseExpr::And(vec![n(0), LicenseExpr::Or(vec![n(1), LicenseExpr::Or(vec![n(2), n(3)])])]);
+    let want = normalise(&e);
+    let text = e.to_string();
+    assert_eq!(normalise(&LicenseExpr::parse(&text)), want, "lenient parse of {text:?}");
+    assert_eq!(normalise(&LicenseExpr::parse_strict(&text).unwrap()), want, "strict parse of {text:?}");
+}
+
+/// debian-copyright/7: the strict and the lenient parser disagree on the
+/// precedence of `, or` and `, and`: `A, or B, and C` is `A or (B and C)` for
+/// `parse` (and for Display, which prints `Or([A, And([Or([B, X]), C])])` as
+/// `A, or B or X, and C`) but `(A or B) and C` for `parse_strict`.
+#[hegel::test]
+fn strict_and_lenient_parsers_agree_on_comma_precedence(tc: hegel::TestCase) {
+    let names: Vec<String> = (0..4).map(|_| tc.draw(arb_license_name())).collect();
+    let text = format!("{}, or {}, and {}", names[0], names[1], names[2]);
+    let strict = LicenseExpr::parse_strict(&text).unwrap();
+    assert_eq!(LicenseExpr::parse(&text), strict, "parsers differ on {text:?}");
+    let n = |i: usize| LicenseExpr::Name(names[i].clone());
+    let e = LicenseExpr::Or(vec![n(0), LicenseExpr::And(vec![LicenseExpr::Or(vec![n(1), n(3)]), n(2)])]);
+    let shown = e.to_string();
+    assert_eq!(normalise(&LicenseExpr::parse_strict(&shown).unwrap()), normalise(&e), "strict parse of {shown:?}");
+    assert_eq!(normalise(&LicenseExpr::parse(&shown)), normalise(&e), "lenient parse of {shown:?}");
+}
+
+/// debian-copyright/8: `wrap_and_sort` sorts the Files paragraphs by their
+/// first pattern *before* sorting the patterns inside each paragraph, so the
+/// result is not ordered by its own criterion and a second `wrap_and_sort`
+/// changes it again.
+#[hegel::test]
+fn wrap_and_sort_is_idempotent(tc: hegel::TestCase) {
+    let deep = pick(&tc, &["a/b", "src/x.c", "lib/y"]);
+    let text = format!("Format: {CURRENT_FORMAT}\n\nFiles: {deep}\nCopyright: 2020 Joe\nLicense: MIT\n\nFiles: {deep} a\nCopyright: 2020 Joe\nLicense: MIT\n");
+    let mut c = lossless::Copyright::from_str(&text).unwrap();
+    c.wrap_and_sort(deb822_lossless::Indentation::Spaces(1), false, None);
+    let once = c.to_string();
+    let firsts: Vec<String> = lossless::Copyright::from_str(&once).unwrap().iter_files().map(|f| f.files()[0].clone()).collect();
+    let keys: Vec<(u8, usize)> = firsts.iter().map(|f| sort_key(f)).collect();
+    assert!(keys.windows(2).all(|w| w[0] <= w[1]), "Files paragraphs not sorted after wrap_and_sort: {text:?} -> {once:?}");
+    c.wrap_and_sort(deb822_lossless::Indentation::Spaces(1), false, None);
+    assert_eq!(c.to_string(), once, "wrap_and_sort is not idempotent on {text:?}");
+}
