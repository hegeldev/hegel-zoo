+#[hegel::test]
+fn find_files_agrees_with_python_debian(tc: hegel::TestCase) {
+    let mut opts = tc.draw(arb_opts().print_as_debug());
+    opts.empty_synopsis = false;
+    let doc = tc.draw(arb_doc(opts).print_as_debug());
+    let text = doc.text();
+    // A path: derived from one of the patterns, or random.
+    let all_patterns: Vec<String> = doc
+        .files_paras()
+        .iter()
+        .flat_map(|p| match p {
+            GenPara::Files { files, .. } => files.clone(),
+            _ => vec![],
+        })
+        .collect();
+    let path = if !all_patterns.is_empty() && tc.draw(int!(0, 2)) != 0 {
+        let p = pick(&tc, &all_patterns);
+        tc.draw(arb_path_for(p))
+    } else {
+        tc.draw(arb_path(false))
+    };
+    let model = doc.model_find_files(&path);
+    // python-debian's `globs_to_re` anchors only the last alternative
+    // (`\*|\*\Z`), so a paragraph with several patterns matches too much
+    // there; the model is checked against python only for single patterns.
+    let single_patterns = doc.files_paras().iter().all(|p| matches!(p, GenPara::Files { files, .. } if files.len() == 1));
+    if single_patterns {
+        let py = py_find_files(&text, &path).unwrap_or_else(|e| panic!("{text:?}: {e}"));
+        assert_eq!(model, py, "model vs python for {path:?} in {text:?}");
+    }
+    let theirs = model;
+    let c = lossless::Copyright::from_str(&text).unwrap();
+    let files: Vec<lossless::FilesParagraph> = c.iter_files().collect();
+    let found = c.find_files(Path::new(&path));
+    let found_idx = found.as_ref().map(|f| {
+        files
+            .iter()
+            .position(|g| g.as_deb822().text_range() == f.as_deb822().text_range())
+            .expect("found paragraph is one of iter_files")
+    });
+    assert_eq!(found_idx, theirs, "lossless find_files({path:?}) in {text:?}");
+    let matcher = c.matcher().unwrap();
+    let via_matcher = matcher.find_files(Path::new(&path)).map(|f| {
+        files.iter().position(|g| g.as_deb822().text_range() == f.as_deb822().text_range()).unwrap()
+    });
+    assert_eq!(via_matcher, theirs, "lossless matcher for {path:?} in {text:?}");
+    if let Some((f, g)) = matcher.find_match(Path::new(&path)) {
+        assert!(f.files().contains(&g.pattern().to_string()));
+        assert!(g.is_match(&path));
+    }
+    // Every paragraph's `matches` agrees with the model.
+    for (i, f) in files.iter().enumerate() {
+        let GenPara::Files { files: pats, .. } = doc.files_paras()[i] else { unreachable!() };
+        let m = pats.iter().any(|p| model_glob(p, &path) == Some(true));
+        assert_eq!(f.matches(Path::new(&path)), m, "matches({path:?}) of paragraph {i} in {text:?}");
+        assert_eq!(f.try_compiled_patterns().unwrap().len(), pats.len());
+    }
+    // Lossy agrees.
+    let lossy = LossyCopyright::from_str(&text).unwrap();
+    let lossy_idx = lossy.find_files(Path::new(&path)).map(|f| {
+        lossy.files.iter().position(|g| std::ptr::eq(g, f)).unwrap()
+    });
+    assert_eq!(lossy_idx, theirs, "lossy find_files({path:?}) in {text:?}");
+    let lossy_matcher = lossy.matcher().unwrap();
+    let lm = lossy_matcher.find_files(Path::new(&path)).map(|f| lossy.files.iter().position(|g| std::ptr::eq(g, f)).unwrap());
+    assert_eq!(lm, theirs, "lossy matcher for {path:?} in {text:?}");
+    // find_license_for_file: the model.
+    let want = doc.model_license_for_file(&path);
+    if !want.as_ref().is_some_and(|l| l.text.is_none()) {
+        // (a text-less stand-alone License paragraph is invisible to the
+        // lossless lookup: debian-copyright/1)
+        let got = c.find_license_for_file(Path::new(&path));
+        assert_eq!(got, want.as_ref().map(|l| l.to_license()), "lossless find_license_for_file({path:?}) in {text:?}");
+    }
+    let indented_doc = hits_indented_text(&doc);
+    if !indented_doc {
+        let got_lossy = lossy.find_license_for_file(Path::new(&path));
+        assert_eq!(got_lossy.cloned(), want.as_ref().map(|l| l.to_license()), "lossy find_license_for_file({path:?}) in {text:?}");
+    }
+    // find_license_by_name: the first license paragraph with that name.
+    for p in doc.license_paras() {
+        let GenPara::License { license, .. } = p else { unreachable!() };
+        let first = doc.license_paras().iter().find_map(|q| match q {
+            GenPara::License { license: l, .. } if l.name == license.name => Some(l.clone()),
+            _ => None,
+        });
+        if !indented_doc {
+            assert_eq!(lossy.find_license_by_name(&license.name).cloned(), first.as_ref().map(|l| l.to_license()), "{text:?}");
+        }
+        if first.as_ref().is_some_and(|l| l.text.is_none()) {
+            continue; // debian-copyright/1
+        }
+        assert_eq!(c.find_license_by_name(&license.name), first.as_ref().map(|l| l.to_license()), "{text:?}");
+    }
+}
