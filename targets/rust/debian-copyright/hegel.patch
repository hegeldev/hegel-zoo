+// ---------------------------------------------------------------------------
+// License expressions
+// ---------------------------------------------------------------------------
+
+/// Both comma-joined operators in one expression: the strict parser reads
+/// them left to right, the lenient parser and Display give `, and` the higher
+/// precedence (debian-copyright/7).
+fn hits_mixed_comma(text: &str) -> bool {
+    text.contains(", and ") && text.contains(", or ")
+}
+
+#[hegel::test]
+fn expressions_round_trip_through_display(tc: hegel::TestCase) {
+    // Normalised (flat) trees of depth <= 3 are expressible in the DEP-5
+    // syntax; nested same-operator trees are debian-copyright/6.
+    let e = normalise(&tc.draw(arb_expr(3).print_as_debug()));
+    let want = e.clone();
+    let text = e.to_string();
+    if hits_mixed_comma(&text) {
+        return;
+    }
+    let strict = LicenseExpr::parse_strict(&text)
+        .unwrap_or_else(|err| panic!("display {text:?} of {e:?} is rejected by parse_strict: {err}"));
+    assert_eq!(normalise(&strict), want, "parse_strict of {text:?}");
+    assert_eq!(normalise(&LicenseExpr::parse(&text)), want, "parse of {text:?}");
+    assert_eq!(normalise(&LicenseExpr::from_str(&text).unwrap()), want);
+    // Display of the parse re-parses to the same expression.
+    let shown = strict.to_string();
+    assert_eq!(normalise(&LicenseExpr::parse_strict(&shown).unwrap()), want, "{text:?} -> {shown:?}");
+    // Names and leaves.
+    assert_eq!(strict.license_names(), names_of(&want).iter().map(|s| s.as_str()).collect::<Vec<_>>());
+    assert_eq!(strict.leaves().len(), names_of(&want).len());
+    let ranges = LicenseExpr::name_ranges(&text);
+    assert_eq!(
+        ranges.iter().map(|(n, _)| n.to_string()).collect::<Vec<_>>(),
+        names_of(&want),
+        "name_ranges of {text:?}"
+    );
+    for (n, r) in &ranges {
+        assert_eq!(&text[r.clone()], *n);
+    }
+}
+
+#[hegel::test]
+fn expressions_round_trip_through_spdx(tc: hegel::TestCase) {
+    let e = tc.draw(arb_expr(3).print_as_debug());
+    let want = normalise(&e);
+    let spdx = e.to_spdx_string();
+    let parsed = LicenseExpr::parse_spdx(&spdx).unwrap_or_else(|err| panic!("{spdx:?}: {err}"));
+    assert_eq!(normalise(&parsed), want, "parse_spdx of {spdx:?}");
+    assert_eq!(parsed.to_spdx_string(), spdx);
+    // Lower-case operators are accepted too.
+    let lower = spdx.replace(" AND ", " and ").replace(" OR ", " or ").replace(" WITH ", " with ");
+    assert_eq!(normalise(&LicenseExpr::parse_spdx(&lower).unwrap()), want);
+    // map_leaves with the identity is the identity; with a renaming it renames.
+    assert_eq!(parsed.map_leaves(|l| l.clone()), parsed);
+    let renamed = parsed.map_leaves(|l| match l {
+        LicenseExpr::Name(n) => LicenseExpr::Name(format!("{n}-x")),
+        LicenseExpr::WithException(n, x) => LicenseExpr::WithException(format!("{n}-x"), x.clone()),
+        o => o.clone(),
+    });
+    assert_eq!(
+        renamed.license_names(),
+        names_of(&want).iter().map(|n| format!("{n}-x")).collect::<Vec<_>>()
+    );
+}
+
+/// Arbitrary token soup in the DEP-5 vocabulary.
+#[hegel::composite]
+fn arb_expr_soup(tc: &hegel::TestCase) -> String {
+    let n = tc.draw(int!(0, 7));
+    let mut parts: Vec<String> = Vec::new();
+    for _ in 0..n {
+        let t = match tc.draw(int!(0, 9)) {
+            0 => "or".to_string(),
+            1 => "and".to_string(),
+            2 => "with".to_string(),
+            3 => ",".to_string(),
+            4 => "OR".to_string(),
+            5 => format!("{},", tc.draw(arb_license_name())),
+            _ => tc.draw(arb_license_name()),
+        };
+        parts.push(t);
+    }
+    parts.join(pick(tc, &[" ", "  ", "\t"]))
+}
+
+#[hegel::test]
+fn lenient_and_strict_parsers_agree_on_valid_input(tc: hegel::TestCase) {
+    let text = tc.draw(arb_expr_soup());
+    let lenient = LicenseExpr::parse(&text);
+    if hits_mixed_comma(&text) {
+        return; // debian-copyright/7
+    }
+    if let Ok(strict) = LicenseExpr::parse_strict(&text) {
+        assert_eq!(lenient, strict, "parsers differ on {text:?}");
+        // Strict output is canonical: its display re-parses to itself.
+        let shown = strict.to_string();
+        assert_eq!(LicenseExpr::parse_strict(&shown).unwrap(), strict, "{text:?} -> {shown:?}");
+    }
+    // The lenient parser never loses a name when the operators are placed
+    // between names: every word that is not an operator or comma appears in
+    // some name.
+    let toks: Vec<String> = text.split_whitespace().map(|w| w.trim_end_matches(',').to_ascii_lowercase()).collect();
+    let is_op = |w: &str| ["or", "and", "with", ""].contains(&w);
+    // `A with B with C` has no reading (an exception is a single name).
+    let mut seen_with = false;
+    let mut double_with = false;
+    for t in &toks {
+        match t.as_str() {
+            "with" => {
+                if seen_with {
+                    double_with = true;
+                }
+                seen_with = true;
+            }
+            "and" | "or" => seen_with = false,
+            _ => {}
+        }
+    }
+    let well_placed = !toks.is_empty()
+        && !double_with
+        && !is_op(&toks[0])
+        && !is_op(toks.last().unwrap())
+        && toks.windows(2).all(|w| !(is_op(&w[0]) && is_op(&w[1])));
+    if !well_placed {
+        return;
+    }
+    let names = lenient.license_names().join(" ");
+    let mut leaves_text = names.clone();
+    for l in lenient.leaves() {
+        if let LicenseExpr::WithException(_, x) = l {
+            leaves_text.push(' ');
+            leaves_text.push_str(x);
+        }
+    }
+    for word in text.split_whitespace() {
+        let w = word.trim_end_matches(',');
+        if w.is_empty() || ["or", "and", "with"].contains(&w.to_ascii_lowercase().as_str()) {
+            continue;
+        }
+        assert!(leaves_text.contains(w), "word {w:?} of {text:?} lost: {lenient:?}");
+    }
+    // Display of the lenient parse re-parses to the same tree (the crate's own
+    // reparse test, on random input) unless a name came out empty.
+    fn has_empty(e: &LicenseExpr) -> bool {
+        match e {
+            LicenseExpr::Name(n) => n.is_empty(),
+            LicenseExpr::WithException(n, x) => n.is_empty() || x.is_empty(),
+            LicenseExpr::And(v) | LicenseExpr::Or(v) => v.iter().any(has_empty),
+        }
+    }
+    if !has_empty(&lenient) {
+        let shown = lenient.to_string();
+        assert_eq!(LicenseExpr::parse(&shown), lenient, "lenient reparse of {text:?} via {shown:?}");
+    }
+}
