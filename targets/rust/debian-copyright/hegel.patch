+#[hegel::test]
+fn files_are_read_like_python_debian(tc: hegel::TestCase) {
+    let opts = tc.draw(arb_opts().print_as_debug());
+    let doc = tc.draw(arb_doc(opts).print_as_debug());
+    if hits_empty_synopsis(&doc) {
+        return;
+    }
+    let text = doc.text();
+    let py = pydebian(&text).unwrap_or_else(|e| panic!("python-debian rejects {text:?}: {e}"));
+    let c = lossless::Copyright::from_str(&text).unwrap_or_else(|e| panic!("lossless rejects {text:?}: {e}"));
+    check_lossless(&doc, &text, &c, &py);
+    assert_eq!(c.to_string(), text);
+    let lossy = LossyCopyright::from_str(&text).unwrap_or_else(|e| panic!("lossy rejects {text:?}: {e}"));
+    if !hits_indented_text(&doc) {
+        check_lossy(&doc, &text, &lossy, &py);
+    }
+    // Relaxed parse of a valid file: no errors, same tree text.
+    let (relaxed, errors) = lossless::Copyright::from_str_relaxed(&text).unwrap();
+    assert!(errors.is_empty(), "{errors:?} for {text:?}");
+    assert_eq!(relaxed.to_string(), text);
+    let parse = lossless::Parse::parse(&text);
+    assert!(parse.ok());
+    assert_eq!(parse.tree().to_string(), text);
+}
