+// ---------------------------------------------------------------------------
+// Editing the lossless tree
+// ---------------------------------------------------------------------------
+
+#[derive(Clone, Debug)]
+struct ModelFiles {
+    files: Vec<String>,
+    copyright: Vec<String>,
+    license: GenLicense,
+    comment: Option<String>,
+}
+
+#[derive(Clone, Debug)]
+struct ModelLicense {
+    license: GenLicense,
+    comment: Option<String>,
+}
+
+#[derive(Clone, Debug, Default)]
+struct Model {
+    upstream_name: Option<String>,
+    upstream_contact: Option<String>,
+    source: Option<String>,
+    files_excluded: Option<Vec<String>>,
+    files: Vec<ModelFiles>,
+    licenses: Vec<ModelLicense>,
+}
+
+#[derive(Clone, Debug)]
+enum Edit {
+    AddFiles { files: Vec<String>, copyright: Vec<String>, license: GenLicense },
+    AddLicense { license: GenLicense },
+    RemoveLicenseByName { name: String },
+    RemoveFilesByPattern { pattern: String },
+    SetUpstreamName(String),
+    SetUpstreamContact(String),
+    SetSource(String),
+    SetFilesExcluded(Vec<String>),
+    RemoveHeaderField(String),
+    SetFiles { idx: usize, files: Vec<String> },
+    AddFile { idx: usize, pattern: String },
+    RemoveFile { idx: usize, pattern: String },
+    SetCopyright { idx: usize, lines: Vec<String> },
+    SetFilesComment { idx: usize, comment: String },
+    SetFilesLicense { idx: usize, license: GenLicense },
+    SetLicenseName { idx: usize, name: String },
+    SetLicenseText { idx: usize, text: Option<Vec<String>> },
+    SetLicenseComment { idx: usize, comment: String },
+    SetLicense { idx: usize, license: GenLicense },
+}
+
+fn arb_edit(tc: &hegel::TestCase, model: &Model) -> Edit {
+    let nf = model.files.len();
+    let nl = model.licenses.len();
+    let kind = tc.draw(int!(0, 18));
+    let fi = |tc: &hegel::TestCase| tc.draw(int!(0, nf as i64 - 1)) as usize;
+    let li = |tc: &hegel::TestCase| tc.draw(int!(0, nl as i64 - 1)) as usize;
+    match kind {
+        0 => Edit::AddFiles {
+            files: tc.draw(arb_patterns().print_as_debug()),
+            copyright: tc.draw(arb_copyright_lines().print_as_debug()),
+            license: tc.draw(arb_gen_license(false).print_as_debug()),
+        },
+        1 => Edit::AddLicense { license: tc.draw(arb_gen_license(false).print_as_debug()) },
+        2 => {
+            let name = if nl > 0 && tc.draw(int!(0, 2)) != 0 {
+                model.licenses[li(tc)].license.name.clone()
+            } else {
+                tc.draw(arb_license_name())
+            };
+            Edit::RemoveLicenseByName { name }
+        }
+        3 => {
+            let pattern = if nf > 0 && tc.draw(int!(0, 2)) != 0 {
+                let f = &model.files[fi(tc)];
+                pick(tc, &f.files)
+            } else {
+                tc.draw(arb_pattern(false))
+            };
+            Edit::RemoveFilesByPattern { pattern }
+        }
+        4 => Edit::SetUpstreamName(pick(tc, &["foo", "bar-baz", "Foo Bar"]).to_string()),
+        5 => Edit::SetUpstreamContact(pick(tc, &["Joe <joe@example.com>", "Jane Doe"]).to_string()),
+        6 => Edit::SetSource(pick(tc, &["https://example.com/foo", "git://example.com/foo.git"]).to_string()),
+        7 => Edit::SetFilesExcluded(tc.draw(arb_patterns().print_as_debug())),
+        8 => Edit::RemoveHeaderField(pick(tc, &["Upstream-Name", "Source", "Files-Excluded", "Upstream-Contact"]).to_string()),
+        9 if nf > 0 => Edit::SetFiles { idx: fi(tc), files: tc.draw(arb_patterns().print_as_debug()) },
+        10 if nf > 0 => Edit::AddFile { idx: fi(tc), pattern: tc.draw(arb_pattern(false)) },
+        11 if nf > 0 => {
+            let idx = fi(tc);
+            let pattern = if tc.draw(int!(0, 2)) != 0 { pick(tc, &model.files[idx].files) } else { tc.draw(arb_pattern(false)) };
+            Edit::RemoveFile { idx, pattern }
+        }
+        12 if nf > 0 => Edit::SetCopyright { idx: fi(tc), lines: tc.draw(arb_copyright_lines().print_as_debug()) },
+        13 if nf > 0 => Edit::SetFilesComment { idx: fi(tc), comment: tc.draw(arb_text_line()) },
+        14 if nf > 0 => Edit::SetFilesLicense { idx: fi(tc), license: tc.draw(arb_gen_license(false).print_as_debug()) },
+        15 if nl > 0 => Edit::SetLicenseName { idx: li(tc), name: tc.draw(arb_license_name()) },
+        16 if nl > 0 => Edit::SetLicenseText {
+            idx: li(tc),
+            text: if tc.draw(int!(0, 3)) == 0 { None } else { Some(tc.draw(arb_text_lines().print_as_debug())) },
+        },
+        17 if nl > 0 => Edit::SetLicenseComment { idx: li(tc), comment: tc.draw(arb_text_line()) },
+        18 if nl > 0 => Edit::SetLicense { idx: li(tc), license: tc.draw(arb_gen_license(false).print_as_debug()) },
+        _ => Edit::AddLicense { license: tc.draw(arb_gen_license(false).print_as_debug()) },
+    }
+}
+
+fn apply(c: &mut lossless::Copyright, model: &mut Model, edit: &Edit) {
+    match edit {
+        Edit::AddFiles { files, copyright, license } => {
+            let f: Vec<&str> = files.iter().map(|s| s.as_str()).collect();
+            let cr: Vec<&str> = copyright.iter().map(|s| s.as_str()).collect();
+            let p = c.add_files(&f, &cr, &license.to_license());
+            assert_eq!(p.files(), *files, "add_files returns the new paragraph");
+            model.files.push(ModelFiles { files: files.clone(), copyright: copyright.clone(), license: license.clone(), comment: None });
+        }
+        Edit::AddLicense { license } => {
+            let p = c.add_license(&license.to_license());
+            assert_eq!(p.license(), license.to_license(), "add_license returns the new paragraph");
+            model.licenses.push(ModelLicense { license: license.clone(), comment: None });
+        }
+        Edit::RemoveLicenseByName { name } => {
+            if model.licenses.iter().any(|l| l.license.name == *name && l.license.text.is_none()) {
+                return; // debian-copyright/1: text-less paragraphs are invisible by name
+            }
+            let pos = model.licenses.iter().position(|l| l.license.name == *name);
+            let removed = c.remove_license_by_name(name);
+            assert_eq!(removed, pos.is_some(), "remove_license_by_name({name:?})");
+            if let Some(i) = pos {
+                model.licenses.remove(i);
+            }
+        }
+        Edit::RemoveFilesByPattern { pattern } => {
+            let pos = model.files.iter().position(|f| f.files.contains(pattern));
+            let removed = c.remove_files_by_pattern(pattern);
+            assert_eq!(removed, pos.is_some(), "remove_files_by_pattern({pattern:?})");
+            if let Some(i) = pos {
+                model.files.remove(i);
+            }
+        }
+        Edit::SetUpstreamName(v) => {
+            c.header().unwrap().set_upstream_name(v);
+            model.upstream_name = Some(v.clone());
+        }
+        Edit::SetUpstreamContact(v) => {
+            c.header().unwrap().set_upstream_contact(v);
+            model.upstream_contact = Some(v.clone());
+        }
+        Edit::SetSource(v) => {
+            c.header().unwrap().set_source(v);
+            model.source = Some(v.clone());
+        }
+        Edit::SetFilesExcluded(v) => {
+            let f: Vec<&str> = v.iter().map(|s| s.as_str()).collect();
+            c.header().unwrap().set_files_excluded(&f);
+            model.files_excluded = Some(v.clone());
+        }
+        Edit::RemoveHeaderField(name) => {
+            c.header().unwrap().remove_field(name);
+            match name.as_str() {
+                "Upstream-Name" => model.upstream_name = None,
+                "Source" => model.source = None,
+                "Files-Excluded" => model.files_excluded = None,
+                _ => model.upstream_contact = None,
+            }
+        }
+        Edit::SetFiles { idx, files } => {
+            let f: Vec<&str> = files.iter().map(|s| s.as_str()).collect();
+            c.iter_files().nth(*idx).unwrap().set_files(&f);
+            model.files[*idx].files = files.clone();
+        }
+        Edit::AddFile { idx, pattern } => {
+            c.iter_files().nth(*idx).unwrap().add_file(pattern);
+            if !model.files[*idx].files.contains(pattern) {
+                model.files[*idx].files.push(pattern.clone());
+            }
+        }
+        Edit::RemoveFile { idx, pattern } => {
+            let had = model.files[*idx].files.contains(pattern);
+            // Removing the last pattern would leave an empty Files field, which
+            // python-debian rejects; keep at least one.
+            if had && model.files[*idx].files.len() == 1 {
+                return;
+            }
+            let removed = c.iter_files().nth(*idx).unwrap().remove_file(pattern);
+            assert_eq!(removed, had, "remove_file({pattern:?})");
+            if let Some(p) = model.files[*idx].files.iter().position(|f| f == pattern) {
+                model.files[*idx].files.remove(p);
+            }
+        }
+        Edit::SetCopyright { idx, lines } => {
+            let l: Vec<&str> = lines.iter().map(|s| s.as_str()).collect();
+            c.iter_files().nth(*idx).unwrap().set_copyright(&l);
+            model.files[*idx].copyright = lines.clone();
+        }
+        Edit::SetFilesComment { idx, comment } => {
+            c.iter_files().nth(*idx).unwrap().set_comment(comment);
+            model.files[*idx].comment = Some(comment.clone());
+        }
+        Edit::SetFilesLicense { idx, license } => {
+            c.iter_files().nth(*idx).unwrap().set_license(&license.to_license());
+            model.files[*idx].license = license.clone();
+        }
+        Edit::SetLicenseName { idx, name } => {
+            c.iter_licenses().nth(*idx).unwrap().set_name(name);
+            model.licenses[*idx].license.name = name.clone();
+        }
+        Edit::SetLicenseText { idx, text } => {
+            let t = text.as_ref().map(|l| l.join("\n"));
+            c.iter_licenses().nth(*idx).unwrap().set_text(t.as_deref());
+            model.licenses[*idx].license.text = text.clone();
+        }
+        Edit::SetLicenseComment { idx, comment } => {
+            c.iter_licenses().nth(*idx).unwrap().set_comment(comment);
+            model.licenses[*idx].comment = Some(comment.clone());
+        }
+        Edit::SetLicense { idx, license } => {
+            c.iter_licenses().nth(*idx).unwrap().set_license(&license.to_license());
+            model.licenses[*idx].license = license.clone();
+        }
+    }
+}
