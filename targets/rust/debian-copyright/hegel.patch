+// Whole files against python-debian
+// ---------------------------------------------------------------------------
+
+fn trimmed_lines(s: &str) -> Vec<String> {
+    s.lines().map(|l| l.trim().to_string()).filter(|l| !l.is_empty()).collect()
+}
+
+fn check_lossless(doc: &GenDoc, text: &str, c: &lossless::Copyright, py: &PyCopyright) {
+    let header = c.header().expect("header");
+    if !doc.opts.odd_format {
+        assert_eq!(header.format_string().as_deref(), Some(py.header.format.as_str()), "{text:?}");
+    }
+    assert_eq!(header.upstream_name(), py.header.upstream_name, "{text:?}");
+    assert_eq!(header.upstream_name(), doc.header.upstream_name);
+    assert_eq!(
+        header.upstream_contact().map(|s| trimmed_lines(&s)),
+        py.header.upstream_contact,
+        "Upstream-Contact in {text:?}"
+    );
+    assert_eq!(header.source(), py.header.source, "{text:?}");
+    let py_flat = |v: &Option<Vec<String>>| {
+        v.as_ref().map(|v| v.iter().flat_map(|s| s.split_whitespace().map(|x| x.to_string())).collect::<Vec<_>>())
+    };
+    assert_eq!(header.files_excluded(), py_flat(&py.header.files_excluded), "Files-Excluded in {text:?}");
+    assert_eq!(header.files_included(), py_flat(&py.header.files_included), "Files-Included in {text:?}");
+    assert_eq!(header.files_excluded(), doc.header.files_excluded);
+    // Paragraphs.
+    let files: Vec<lossless::FilesParagraph> = c.iter_files().collect();
+    let licenses: Vec<lossless::LicenseParagraph> = c.iter_licenses().collect();
+    let py_files: Vec<&PyPara> = py.paras.iter().filter(|p| matches!(p, PyPara::Files { .. })).collect();
+    let py_licenses: Vec<&PyPara> = py.paras.iter().filter(|p| matches!(p, PyPara::License { .. })).collect();
+    assert_eq!(files.len(), py_files.len(), "files paragraphs in {text:?}");
+    assert_eq!(licenses.len(), py_licenses.len(), "license paragraphs in {text:?}");
+    for (f, p) in files.iter().zip(&py_files) {
+        let PyPara::Files { files, copyright, license, comment } = p else { unreachable!() };
+        assert_eq!(&f.files(), files, "Files in {text:?}");
+        assert_eq!(trimmed_lines(&f.copyright().join("\n")), trimmed_lines(copyright), "Copyright in {text:?}");
+        let ours = f.license();
+        assert_eq!(
+            ours.as_ref().map(|l| (l.name().unwrap_or("").to_string(), l.text().unwrap_or("").to_string())),
+            license.as_ref().map(|l| (l.synopsis.clone(), l.text.clone())),
+            "License in {text:?}"
+        );
+        assert_eq!(f.comment().map(|s| trimmed_lines(&s)), comment.as_ref().map(|s| trimmed_lines(s)), "Comment in {text:?}");
+        assert_eq!(f.files_raw().map(|s| s.split_whitespace().map(|x| x.to_string()).collect::<Vec<_>>()), Some(files.clone()));
+        let spans = f.file_spans();
+        assert_eq!(spans.iter().map(|(s, _)| s.clone()).collect::<Vec<_>>(), *files, "file_spans in {text:?}");
+        for (s, r) in &spans {
+            assert_eq!(&text[usize::from(r.start())..usize::from(r.end())], s, "file_spans range in {text:?}");
+        }
+    }
+    for (l, p) in licenses.iter().zip(&py_licenses) {
+        let PyPara::License { license, comment } = p else { unreachable!() };
+        if !license.text.is_empty() {
+            // (a text-less License field has no name(): debian-copyright/1)
+            assert_eq!(l.name().unwrap_or_default(), license.synopsis, "License name in {text:?}");
+            assert_eq!(l.text().unwrap_or_default(), license.text, "License text in {text:?}");
+        }
+        let lic = l.license();
+        assert_eq!(lic.name().unwrap_or(""), license.synopsis);
+        assert_eq!(lic.text().unwrap_or(""), license.text);
+        assert_eq!(l.comment().map(|s| trimmed_lines(&s)), comment.as_ref().map(|s| trimmed_lines(s)));
+    }
+}
+
+fn check_lossy(doc: &GenDoc, text: &str, c: &LossyCopyright, py: &PyCopyright) {
+    let py_files: Vec<&PyPara> = py.paras.iter().filter(|p| matches!(p, PyPara::Files { .. })).collect();
+    let py_licenses: Vec<&PyPara> = py.paras.iter().filter(|p| matches!(p, PyPara::License { .. })).collect();
+    assert_eq!(c.files.len(), py_files.len(), "lossy files paragraphs in {text:?}");
+    assert_eq!(c.licenses.len(), py_licenses.len(), "lossy license paragraphs in {text:?}");
+    // The lossy Display re-parses (by python-debian) to the same paragraphs.
+    let shown = c.to_string();
+    let again = pydebian(&shown).unwrap_or_else(|e| panic!("python rejects the lossy Display {shown:?} of {text:?}: {e}"));
+    let py_files2: Vec<&PyPara> = again.paras.iter().filter(|p| matches!(p, PyPara::Files { .. })).collect();
+    let py_licenses2: Vec<&PyPara> = again.paras.iter().filter(|p| matches!(p, PyPara::License { .. })).collect();
+    assert_eq!(py_files2.len(), py_files.len(), "{text:?} -> {shown:?}");
+    for (a, b) in py_files.iter().zip(&py_files2) {
+        let (PyPara::Files { files: fa, copyright: ca, license: la, comment: ma }, PyPara::Files { files: fb, copyright: cb, license: lb, comment: mb }) = (a, b) else { unreachable!() };
+        assert_eq!(fa, fb, "{text:?} -> {shown:?}");
+        assert_eq!(trimmed_lines(ca), trimmed_lines(cb), "{text:?} -> {shown:?}");
+        assert_eq!(la, lb, "{text:?} -> {shown:?}");
+        assert_eq!(ma.as_ref().map(|s| trimmed_lines(s)), mb.as_ref().map(|s| trimmed_lines(s)), "{text:?} -> {shown:?}");
+    }
+    for (a, b) in py_licenses.iter().zip(&py_licenses2) {
+        let (PyPara::License { license: la, comment: ma }, PyPara::License { license: lb, comment: mb }) = (a, b) else { unreachable!() };
+        assert_eq!(la, lb, "{text:?} -> {shown:?}");
+        assert_eq!(ma.as_ref().map(|s| trimmed_lines(s)), mb.as_ref().map(|s| trimmed_lines(s)), "{text:?} -> {shown:?}");
+    }
+    if !doc.opts.odd_format {
+        assert_eq!(again.header.format, py.header.format);
+    }
+    assert_eq!(again.header.upstream_contact, py.header.upstream_contact, "{text:?} -> {shown:?}");
+    assert_eq!(again.header.source, py.header.source, "{text:?} -> {shown:?}");
+    let flat = |v: &Option<Vec<String>>| v.as_ref().map(|v| v.iter().flat_map(|s| s.split_whitespace().map(|x| x.to_string())).collect::<Vec<_>>());
+    assert_eq!(flat(&again.header.files_excluded), flat(&py.header.files_excluded), "{text:?} -> {shown:?}");
+}
