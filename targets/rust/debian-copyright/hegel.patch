+fn check_edit_model(c: &lossless::Copyright, model: &Model, trail: &[Edit]) {
+    let text = c.to_string();
+    // Live accessors.
+    let header = c.header().unwrap();
+    assert_eq!(header.upstream_name(), model.upstream_name, "live Upstream-Name after {trail:?}\n{text:?}");
+    assert_eq!(header.upstream_contact(), model.upstream_contact, "live Upstream-Contact after {trail:?}\n{text:?}");
+    assert_eq!(header.source(), model.source, "live Source after {trail:?}\n{text:?}");
+    assert_eq!(header.files_excluded(), model.files_excluded, "live Files-Excluded after {trail:?}\n{text:?}");
+    let files: Vec<lossless::FilesParagraph> = c.iter_files().collect();
+    assert_eq!(files.len(), model.files.len(), "live files count after {trail:?}\n{text:?}");
+    for (f, m) in files.iter().zip(&model.files) {
+        assert_eq!(f.files(), m.files, "live Files after {trail:?}\n{text:?}");
+        assert_eq!(trimmed_lines(&f.copyright().join("\n")), trimmed_lines(&m.copyright.join("\n")), "live Copyright after {trail:?}\n{text:?}");
+        assert_eq!(f.license(), Some(m.license.to_license()), "live License after {trail:?}\n{text:?}");
+        assert_eq!(f.comment(), m.comment, "live Comment after {trail:?}\n{text:?}");
+    }
+    let licenses: Vec<lossless::LicenseParagraph> = c.iter_licenses().collect();
+    assert_eq!(licenses.len(), model.licenses.len(), "live licenses count after {trail:?}\n{text:?}");
+    for (l, m) in licenses.iter().zip(&model.licenses) {
+        assert_eq!(l.license(), m.license.to_license(), "live license after {trail:?}\n{text:?}");
+        assert_eq!(l.comment(), m.comment, "live license Comment after {trail:?}\n{text:?}");
+    }
+    // A strict re-parse.
+    let re = lossless::Copyright::from_str(&text).unwrap_or_else(|e| panic!("text does not re-parse after {trail:?}: {e}\n{text:?}"));
+    assert_eq!(re.iter_files().map(|f| f.files()).collect::<Vec<_>>(), model.files.iter().map(|f| f.files.clone()).collect::<Vec<_>>(), "re-parse Files after {trail:?}\n{text:?}");
+    assert_eq!(re.iter_licenses().map(|l| l.license()).collect::<Vec<_>>(), model.licenses.iter().map(|l| l.license.to_license()).collect::<Vec<_>>(), "re-parse licenses after {trail:?}\n{text:?}");
+    // python-debian.
+    let py = pydebian(&text).unwrap_or_else(|e| panic!("python-debian rejects the edited file after {trail:?}: {e}\n{text:?}"));
+    assert_eq!(py.header.upstream_name, model.upstream_name, "python Upstream-Name after {trail:?}\n{text:?}");
+    assert_eq!(py.header.upstream_contact.map(|v| v.join("\n")), model.upstream_contact, "python Upstream-Contact after {trail:?}\n{text:?}");
+    assert_eq!(py.header.source, model.source, "python Source after {trail:?}\n{text:?}");
+    let flat = |v: &Option<Vec<String>>| v.as_ref().map(|v| v.iter().flat_map(|s| s.split_whitespace().map(|x| x.to_string())).collect::<Vec<_>>());
+    assert_eq!(flat(&py.header.files_excluded), model.files_excluded, "python Files-Excluded after {trail:?}\n{text:?}");
+    let py_files: Vec<&PyPara> = py.paras.iter().filter(|p| matches!(p, PyPara::Files { .. })).collect();
+    let py_licenses: Vec<&PyPara> = py.paras.iter().filter(|p| matches!(p, PyPara::License { .. })).collect();
+    assert_eq!(py_files.len(), model.files.len(), "python files count after {trail:?}\n{text:?}");
+    for (p, m) in py_files.iter().zip(&model.files) {
+        let PyPara::Files { files, copyright, license, comment } = p else { unreachable!() };
+        assert_eq!(*files, m.files, "python Files after {trail:?}\n{text:?}");
+        assert_eq!(trimmed_lines(copyright), trimmed_lines(&m.copyright.join("\n")), "python Copyright after {trail:?}\n{text:?}");
+        assert_eq!(*license, Some(m.license.py()), "python License after {trail:?}\n{text:?}");
+        assert_eq!(comment.as_ref().map(|c| trimmed_lines(c)), m.comment.as_ref().map(|c| trimmed_lines(c)), "python Comment after {trail:?}\n{text:?}");
+    }
+    assert_eq!(py_licenses.len(), model.licenses.len(), "python licenses count after {trail:?}\n{text:?}");
+    for (p, m) in py_licenses.iter().zip(&model.licenses) {
+        let PyPara::License { license, comment } = p else { unreachable!() };
+        assert_eq!(*license, m.license.py(), "python license after {trail:?}\n{text:?}");
+        assert_eq!(comment.as_ref().map(|c| trimmed_lines(c)), m.comment.as_ref().map(|c| trimmed_lines(c)), "python license Comment after {trail:?}\n{text:?}");
+    }
+    // The lossy parser.
+    let lossy = LossyCopyright::from_str(&text).unwrap_or_else(|e| panic!("lossy rejects the edited file after {trail:?}: {e}\n{text:?}"));
+    assert_eq!(lossy.files.len(), model.files.len());
+    assert_eq!(lossy.licenses.len(), model.licenses.len());
+    for (i, m) in model.licenses.iter().enumerate() {
+        if indented(&m.license) {
+            continue; // debian-copyright/4
+        }
+        if model.licenses.iter().position(|l| l.license.name == m.license.name) == Some(i) {
+            assert_eq!(lossy.find_license_by_name(&m.license.name).cloned(), Some(m.license.to_license()), "lossy find_license_by_name after {trail:?}\n{text:?}");
+        }
+    }
+}
