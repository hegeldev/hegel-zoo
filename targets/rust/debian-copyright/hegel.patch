+#[hegel::test]
+fn wrap_and_sort_keeps_the_content(tc: hegel::TestCase) {
+    let mut opts = tc.draw(arb_opts().print_as_debug());
+    opts.empty_synopsis = false;
+    opts.comments = false;
+    let doc = tc.draw(arb_doc(opts).print_as_debug());
+    let text = doc.text();
+    let mut c = lossless::Copyright::from_str(&text).unwrap();
+    let before = pydebian(&text).unwrap();
+    let indent = tc.draw(int!(1, 4)) as u32;
+    let immediate = tc.draw(generators::booleans());
+    if immediate && hits_multiline_license(&doc) {
+        return; // debian-copyright/2
+    }
+    if (indent > 1 && hits_multiline_license(&doc)) || hits_indented_text(&doc) {
+        return; // debian-copyright/5
+    }
+    if hits_unsorted_first_pattern(&doc) {
+        return; // debian-copyright/8
+    }
+    c.wrap_and_sort(deb822_lossless::Indentation::Spaces(indent), immediate, None);
+    let after_text = c.to_string();
+    let after = pydebian(&after_text).unwrap_or_else(|e| panic!("python-debian rejects wrap_and_sort output {after_text:?} of {text:?}: {e}"));
+    // Same header fields.
+    assert_eq!(after.header.upstream_name, before.header.upstream_name, "{text:?} -> {after_text:?}");
+    assert_eq!(after.header.source, before.header.source, "{text:?} -> {after_text:?}");
+    assert_eq!(after.header.upstream_contact, before.header.upstream_contact, "{text:?} -> {after_text:?}");
+    // Same Files paragraphs as a multiset (patterns sorted within), same license paragraphs.
+    let key = |p: &PyPara| match p {
+        PyPara::Files { files, copyright, license, comment } => {
+            let mut f = files.clone();
+            f.sort();
+            (f, trimmed_lines(copyright), license.clone(), comment.as_ref().map(|s| trimmed_lines(s)))
+        }
+        PyPara::License { license, comment } => (vec![], vec![], Some(license.clone()), comment.as_ref().map(|s| trimmed_lines(s))),
+    };
+    let mut a: Vec<_> = before.paras.iter().map(key).collect();
+    let mut b: Vec<_> = after.paras.iter().map(key).collect();
+    a.sort();
+    b.sort();
+    assert_eq!(a, b, "wrap_and_sort changed the content of {text:?} -> {after_text:?}");
+    // Header first, then Files, then License paragraphs; Files sorted by key.
+    let kinds: Vec<bool> = after.paras.iter().map(|p| matches!(p, PyPara::Files { .. })).collect();
+    let first_license = kinds.iter().position(|k| !k).unwrap_or(kinds.len());
+    assert!(kinds[first_license..].iter().all(|k| !k), "Files paragraph after a License paragraph in {after_text:?}");
+    let keys: Vec<(u8, usize)> = after
+        .paras
+        .iter()
+        .filter_map(|p| match p {
+            PyPara::Files { files, .. } => {
+                let first = files.first().map(|s| s.as_str()).unwrap_or("");
+                Some(debian_copyright::pattern_sort_key(first, debian_copyright::pattern_depth(first)))
+            }
+            _ => None,
+        })
+        .collect();
+    assert!(keys.windows(2).all(|w| w[0] <= w[1]), "Files paragraphs not sorted in {after_text:?}: {keys:?}");
+    // Idempotent on a re-parse.
+    let mut again = lossless::Copyright::from_str(&after_text).unwrap();
+    again.wrap_and_sort(deb822_lossless::Indentation::Spaces(indent), immediate, None);
+    assert_eq!(again.to_string(), after_text, "wrap_and_sort is not idempotent on {text:?}");
+}
