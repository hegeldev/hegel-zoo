+#[hegel::test]
+fn lossy_display_round_trips(tc: hegel::TestCase) {
+    // A lossy Copyright built by parsing, displayed and re-parsed by the lossy
+    // and lossless parsers, is the same file for python-debian.
+    let mut opts = tc.draw(arb_opts().print_as_debug());
+    opts.empty_synopsis = false;
