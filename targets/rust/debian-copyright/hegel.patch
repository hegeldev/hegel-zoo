+        let GenPara::Files { files, license, .. } = m else { unreachable!() };
+        assert_eq!(&f.files(), files, "{text:?} -> {shown:?}");
+        assert_eq!(f.license(), Some(license.to_license()), "{text:?} -> {shown:?}");
+    }
