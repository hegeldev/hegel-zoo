diff --git a/roaring/tests/common/mod.rs b/roaring/tests/common/mod.rs
new file mode 100644
index 0000000..8a9869c
--- /dev/null
+++ b/roaring/tests/common/mod.rs
@@ -0,0 +1,54 @@
+//! Shared hegel generators for the integration test suite.
+//!
+//! Not a test crate itself: files in `tests/` subdirectories are only
+//! compiled when included with `mod common;` from a test crate root.
+
+#![allow(dead_code)]
+
+use hegel::generators;
+use roaring::RoaringBitmap;
+
+/// Generate a `RoaringBitmap` that exercises all three container store types:
+///
+/// - scattered values over the full `u32` domain -> array containers
+/// - a dense block of random bits (via `from_lsb0_bytes`) -> bitmap containers
+/// - contiguous ranges, possibly crossing container boundaries (via
+///   `insert_range`) -> run/interval containers
+///
+/// `optimize()` is applied to half the generated bitmaps so both the
+/// run-compressed and uncompressed representations of the same content are
+/// covered.
+#[hegel::composite]
+pub fn bitmaps(tc: &hegel::TestCase) -> RoaringBitmap {
+    let mut rb = RoaringBitmap::new();
+
+    // Scattered values (array containers).
+    for v in tc.draw(generators::vecs(generators::integers::<u32>())) {
+        rb.insert(v);
+    }
+
+    // A dense block of random bits (bitmap containers once >4096 bits are
+    // set in one 65536-value container).
+    if tc.draw(generators::booleans()) {
+        let bytes: Vec<u8> = tc.draw(generators::binary().max_size(16 * 1024));
+        let bits = bytes.len() as u32 * 8;
+        // from_lsb0_bytes requires offset + bytes.len() * 8 <= 2^32.
+        let offset =
+            tc.draw(generators::integers::<u32>().max_value(u32::MAX - bits.saturating_sub(1)));
+        rb |= RoaringBitmap::from_lsb0_bytes(offset, &bytes);
+    }
+
+    // Contiguous runs, possibly crossing container boundaries (run containers).
+    let n_ranges = tc.draw(generators::integers::<usize>().max_value(2));
+    for _ in 0..n_ranges {
+        let start = tc.draw(generators::integers::<u32>());
+        let len = tc.draw(generators::integers::<u32>().max_value(0x2_0000));
+        rb.insert_range(start..=start.saturating_add(len));
+    }
+
+    if tc.draw(generators::booleans()) {
+        rb.optimize();
+    }
+
+    rb
+}
diff --git a/roaring/tests/iter.rs b/roaring/tests/iter.rs
index ea3d557..24d5fc1 100644
