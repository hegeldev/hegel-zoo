+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+
+// NOTE: this file cannot `mod common;` like the other test files, because
+// `treemap_iter.rs` includes it as a module (`mod iter;`), which would make
+// the `common` path resolve to `tests/iter/common/mod.rs` there. The bitmap
+// generator is inlined instead (same as `tests/common/mod.rs`).
+use hegel::Generator;
+
+mod hegel_gens {
+    use hegel::generators;
+    use roaring::RoaringBitmap;
+
+    /// Generate a `RoaringBitmap` covering array, bitmap and run containers.
+    #[hegel::composite]
+    pub fn bitmaps(tc: &hegel::TestCase) -> RoaringBitmap {
+        let mut rb = RoaringBitmap::new();
+        for v in tc.draw(generators::vecs(generators::integers::<u32>())) {
+            rb.insert(v);
+        }
+        if tc.draw(generators::booleans()) {
+            let bytes: Vec<u8> = tc.draw(generators::binary().max_size(16 * 1024));
+            let bits = bytes.len() as u32 * 8;
+            let offset =
+                tc.draw(generators::integers::<u32>().max_value(u32::MAX - bits.saturating_sub(1)));
+            rb |= RoaringBitmap::from_lsb0_bytes(offset, &bytes);
+        }
+        let n_ranges = tc.draw(generators::integers::<usize>().max_value(2));
+        for _ in 0..n_ranges {
+            let start = tc.draw(generators::integers::<u32>());
+            let len = tc.draw(generators::integers::<u32>().max_value(0x2_0000));
+            rb.insert_range(start..=start.saturating_add(len));
+        }
+        if tc.draw(generators::booleans()) {
+            rb.optimize();
+        }
+        rb
+    }
+}
+
+/// The iterator must yield exactly the set's members: strictly increasing
+/// values (RoaringBitmap is a sorted set), each of which `contains` reports
+/// as present, and exactly `len()` of them.
+#[hegel::test]
+fn hegel_iter_is_sorted_and_matches_len(tc: hegel::TestCase) {
+    let rb = tc.draw(hegel_gens::bitmaps().print_as_debug());
+
+    let mut count: u64 = 0;
+    let mut prev: Option<u32> = None;
+    for v in rb.iter() {
+        if let Some(p) = prev {
+            assert!(v > p, "iterator not strictly increasing: {p} then {v}");
+        }
+        assert!(rb.contains(v), "iterator yielded {v} but contains({v}) is false");
+        prev = Some(v);
+        count += 1;
+    }
+    assert_eq!(count, rb.len(), "iterator yielded a different number of values than len()");
+}
+
+/// Backward iteration (`Iter` implements `DoubleEndedIterator`) must yield
+/// exactly the reverse of forward iteration.
+#[hegel::test]
+fn hegel_iter_backward_matches_forward(tc: hegel::TestCase) {
+    let rb = tc.draw(hegel_gens::bitmaps().print_as_debug());
+
+    let forward: Vec<u32> = rb.iter().collect();
+    let mut backward: Vec<u32> = rb.iter().rev().collect();
+    backward.reverse();
+    assert_eq!(forward, backward);
+}
diff --git a/roaring/tests/lib.rs b/roaring/tests/lib.rs
index 568de01..5d0a190 100644
--- a/roaring/tests/lib.rs
+++ b/roaring/tests/lib.rs
@@ -150,3 +150,244 @@ fn optimize_run() {
     // Calling optimize a second time should return false as no changes will be made
     assert!(!bitmap.optimize());
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+
+mod common;
+
+use hegel::generators;
+use hegel::Generator;
+use std::collections::BTreeSet;
+
+/// Stateful model test: a `RoaringBitmap` must behave exactly like a
+/// `BTreeSet<u32>` under every mutating and querying operation, and must
+/// remain internally valid throughout (the fuzz targets in `fuzz/` check
+/// `internal_validate` the same way).
+struct BitmapVsBTreeSet {
+    real: RoaringBitmap,
+    model: BTreeSet<u32>,
+}
+
+impl BitmapVsBTreeSet {
+    /// Ranges fed to `insert_range`/`remove_range` are bounded so that the
+    /// *model* update (element-by-element on a `BTreeSet`) stays cheap.
+    /// This bound protects the test's resources, not the library's contract:
+    /// `hegel_insert_range_returns_newly_inserted_count` and
+    /// `hegel_remove_range_returns_removed_count` in `range_checks.rs` cover
+    /// unbounded ranges. 0x11000 still crosses a 65536-value container
+    /// boundary.
+    const MAX_RANGE_LEN: u32 = 0x11000;
+
+    fn draw_range(&self, tc: &hegel::TestCase) -> (u32, u32) {
+        let start = tc.draw(generators::integers::<u32>());
+        let len = tc.draw(generators::integers::<u32>().max_value(Self::MAX_RANGE_LEN));
+        (start, start.saturating_add(len))
+    }
+}
+
+#[hegel::state_machine]
+impl BitmapVsBTreeSet {
+    #[rule]
+    fn insert(&mut self, tc: hegel::TestCase) {
+        let v = tc.draw(generators::integers::<u32>());
+        assert_eq!(self.real.insert(v), self.model.insert(v), "insert({v}) return value");
+    }
+
+    #[rule]
+    fn remove(&mut self, tc: hegel::TestCase) {
+        let v = tc.draw(generators::integers::<u32>());
+        assert_eq!(self.real.remove(v), self.model.remove(&v), "remove({v}) return value");
+    }
+
+    #[rule]
+    fn remove_present(&mut self, tc: hegel::TestCase) {
+        tc.assume(!self.model.is_empty());
+        let idx = tc.draw(generators::integers::<usize>().max_value(self.model.len() - 1));
+        let v = *self.model.iter().nth(idx).unwrap();
+        assert!(self.real.remove(v), "remove of present value {v} must return true");
+        self.model.remove(&v);
+    }
+
+    #[rule]
+    fn insert_range(&mut self, tc: hegel::TestCase) {
+        let (start, end) = self.draw_range(&tc);
+        let inserted = self.real.insert_range(start..=end);
+        let mut expected = 0u64;
+        for v in start..=end {
+            if self.model.insert(v) {
+                expected += 1;
+            }
+        }
+        assert_eq!(inserted, expected, "insert_range({start}..={end}) return value");
+    }
+
+    #[rule]
+    fn remove_range(&mut self, tc: hegel::TestCase) {
+        let (start, end) = self.draw_range(&tc);
+        let removed = self.real.remove_range(start..=end);
+        let before = self.model.len();
+        self.model.retain(|v| !(start..=end).contains(v));
+        assert_eq!(
+            removed,
+            (before - self.model.len()) as u64,
+            "remove_range({start}..={end}) return value"
+        );
+    }
+
+    #[rule]
+    fn try_push(&mut self, tc: hegel::TestCase) {
+        let v = tc.draw(generators::integers::<u32>());
+        // Documented: succeeds iff the value is greater than the current max.
+        let expected_ok = self.model.last().is_none_or(|&max| v > max);
+        assert_eq!(self.real.try_push(v).is_ok(), expected_ok, "try_push({v})");
+        if expected_ok {
+            self.model.insert(v);
+        }
+    }
+
+    #[rule]
+    fn contains(&mut self, tc: hegel::TestCase) {
+        let v = tc.draw(generators::integers::<u32>());
+        assert_eq!(self.real.contains(v), self.model.contains(&v), "contains({v})");
+    }
+
+    #[rule]
+    fn remove_smallest(&mut self, tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<u64>().max_value(self.model.len() as u64 + 1));
+        self.real.remove_smallest(n);
+        self.model = self.model.iter().copied().skip(n as usize).collect();
+    }
+
+    #[rule]
+    fn remove_biggest(&mut self, tc: hegel::TestCase) {
+        let n = tc.draw(generators::integers::<u64>().max_value(self.model.len() as u64 + 1));
+        self.real.remove_biggest(n);
+        let keep = self.model.len().saturating_sub(n as usize);
+        self.model = self.model.iter().copied().take(keep).collect();
+    }
+
+    #[rule]
+    fn optimize(&mut self, _tc: hegel::TestCase) {
+        // Changes representation only, never content.
+        self.real.optimize();
+    }
+
+    #[rule]
+    fn remove_run_compression(&mut self, _tc: hegel::TestCase) {
+        // Changes representation only, never content.
+        self.real.remove_run_compression();
+    }
+
+    #[invariant]
+    fn agrees_with_model(&self, _tc: hegel::TestCase) {
+        assert_eq!(self.real.len(), self.model.len() as u64);
+        assert_eq!(self.real.min(), self.model.first().copied());
+        assert_eq!(self.real.max(), self.model.last().copied());
+        assert_eq!(self.real.is_empty(), self.model.is_empty());
+        assert!(
+            self.real.iter().eq(self.model.iter().copied()),
+            "bitmap contents diverged from model"
+        );
+        self.real.internal_validate().unwrap();
+    }
+}
+
+#[hegel::test(test_cases = 200)]
+fn hegel_bitmap_model_matches_btreeset(tc: hegel::TestCase) {
+    let machine = BitmapVsBTreeSet { real: RoaringBitmap::new(), model: BTreeSet::new() };
+    hegel::stateful::machine(machine).run(tc);
+}
+
+/// `from_lsb0_bytes(offset, bytes)` must contain exactly `offset + i * 8 + b`
+/// for every set bit `b` of `bytes[i]` (contract from its rustdoc examples,
+/// including non-byte-aligned offsets which take the bit-shifting path).
+#[hegel::test]
+fn hegel_from_lsb0_bytes_matches_bit_oracle(tc: hegel::TestCase) {
+    let bytes: Vec<u8> = tc.draw(generators::binary().max_size(1024));
+    let bits = bytes.len() as u32 * 8;
+    // Documented requirement: offset + bytes.len() * 8 <= 2^32.
+    let offset =
+        tc.draw(generators::integers::<u32>().max_value(u32::MAX - bits.saturating_sub(1)));
+
+    let rb = RoaringBitmap::from_lsb0_bytes(offset, &bytes);
+
+    let expected: Vec<u32> = bytes
+        .iter()
+        .enumerate()
+        .flat_map(|(i, &byte)| {
+            (0..8u32).filter(move |b| byte & (1 << b) != 0).map(move |b| offset + i as u32 * 8 + b)
+        })
+        .collect();
+    assert_eq!(rb.len(), expected.len() as u64);
+    assert!(rb.iter().eq(expected.iter().copied()), "from_lsb0_bytes content mismatch");
+}
+
+/// Generate a bitmap made of disjoint runs (run containers) plus the running
+/// cumulative lengths of those runs. `remove_smallest`/`remove_biggest` do
+/// exact-prefix arithmetic over run intervals, so amounts that land exactly
+/// on an interval boundary are the interesting conjunction — the cumulative
+/// lengths let tests target them directly (SKILL: "boundary conjunctions
+/// need help").
+#[hegel::composite]
+fn run_bitmap_with_boundaries(tc: &hegel::TestCase) -> (RoaringBitmap, Vec<u64>) {
+    let n_runs = tc.draw(generators::integers::<usize>().min_value(1).max_value(5));
+    let mut rb = RoaringBitmap::new();
+    let mut boundaries = Vec::new();
+    let mut cursor: u32 = tc.draw(generators::integers::<u32>().max_value(0x1_0000));
+    for _ in 0..n_runs {
+        let gap = tc.draw(generators::integers::<u32>().min_value(2).max_value(0x1000));
+        let len = tc.draw(generators::integers::<u32>().min_value(1).max_value(0x1000));
+        let start = cursor.saturating_add(gap);
+        let end = start.saturating_add(len - 1);
+        rb.insert_range(start..=end);
+        cursor = end;
+        boundaries.push(rb.len());
+    }
+    rb.optimize();
+    (rb, boundaries)
+}
+
+/// `remove_smallest(n)` is documented to remove "the `n` smallests values":
+/// the result must equal what plain iteration says the remaining values are,
+/// and the bitmap must stay internally valid.
+#[hegel::test]
+fn hegel_remove_smallest_matches_iterator_oracle(tc: hegel::TestCase) {
+    let (mut rb, boundaries) = tc.draw(run_bitmap_with_boundaries().print_as_debug());
+    // Half arbitrary amounts, half amounts at/near an exact run boundary.
+    let n = if tc.draw(generators::booleans()) {
+        tc.draw(generators::integers::<u64>().max_value(rb.len()))
+    } else {
+        let b = tc.draw(generators::sampled_from(boundaries));
+        let delta = tc.draw(generators::integers::<i64>().min_value(-2).max_value(2));
+        (b as i64).saturating_add(delta).clamp(0, rb.len() as i64) as u64
+    };
+
+    let expected: Vec<u32> = rb.iter().skip(n as usize).collect();
+    rb.remove_smallest(n);
+    rb.internal_validate().expect("bitmap invalid after remove_smallest");
+    assert!(rb.iter().eq(expected.iter().copied()), "remove_smallest({n}) kept the wrong values");
+}
+
+/// `remove_biggest(n)` is documented to remove "the `n` biggests values":
+/// the result must equal what plain iteration says the remaining values are,
+/// and the bitmap must stay internally valid.
+#[hegel::test]
+fn hegel_remove_biggest_matches_iterator_oracle(tc: hegel::TestCase) {
+    let (mut rb, boundaries) = tc.draw(run_bitmap_with_boundaries().print_as_debug());
+    let n = if tc.draw(generators::booleans()) {
+        tc.draw(generators::integers::<u64>().max_value(rb.len()))
+    } else {
+        // len - boundary lands exactly on a run boundary from the top end.
+        let b = tc.draw(generators::sampled_from(boundaries));
+        let delta = tc.draw(generators::integers::<i64>().min_value(-2).max_value(2));
+        (rb.len() as i64 - b as i64).saturating_add(delta).clamp(0, rb.len() as i64) as u64
+    };
+
+    let keep = rb.len() - n;
+    let expected: Vec<u32> = rb.iter().take(keep as usize).collect();
+    rb.remove_biggest(n);
+    rb.internal_validate().expect("bitmap invalid after remove_biggest");
+    assert!(rb.iter().eq(expected.iter().copied()), "remove_biggest({n}) kept the wrong values");
+}
diff --git a/roaring/tests/ops.rs b/roaring/tests/ops.rs
index eb1ce14..cc1a09a 100644
--- a/roaring/tests/ops.rs
+++ b/roaring/tests/ops.rs
@@ -93,3 +93,57 @@ fn xor() {
 
     assert_eq!(rb4, rb1);
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+
+mod common;
+
+use hegel::generators;
+use hegel::Generator;
+use roaring::MultiOps;
+
+#[derive(Debug, Clone, Copy, PartialEq, hegel::PrettyPrintable)]
+enum SetOp {
+    Union,
+    Intersection,
+    Difference,
+    SymmetricDifference,
+}
+
+/// `MultiOps` documents itself as a faster equivalent of folding the binary
+/// operator over the bitmaps (its rustdoc example asserts
+/// `naive == bitmaps.union()`), so for every operation the multi-way result
+/// must equal the naive left fold, with the empty input producing the empty
+/// bitmap (`unwrap_or_default`, as in the doc example).
+#[hegel::test]
+fn hegel_multiops_agree_with_naive_fold(tc: hegel::TestCase) {
+    let bitmaps: Vec<RoaringBitmap> = tc.draw(generators::vecs(common::bitmaps()).max_size(5).print_as_debug());
+    let op = tc.draw(generators::sampled_from(vec![
+        SetOp::Union,
+        SetOp::Intersection,
+        SetOp::Difference,
+        SetOp::SymmetricDifference,
+    ]));
+
+    let naive = bitmaps
+        .clone()
+        .into_iter()
+        .reduce(|a, b| match op {
+            SetOp::Union => a | b,
+            SetOp::Intersection => a & b,
+            SetOp::Difference => a - b,
+            SetOp::SymmetricDifference => a ^ b,
+        })
+        .unwrap_or_default();
+
+    let multi = match op {
+        SetOp::Union => bitmaps.union(),
+        SetOp::Intersection => bitmaps.intersection(),
+        SetOp::Difference => bitmaps.difference(),
+        SetOp::SymmetricDifference => bitmaps.symmetric_difference(),
+    };
+
+    assert_eq!(multi, naive, "MultiOps {op:?} disagrees with naive fold");
+}
