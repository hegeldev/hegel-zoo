+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+
+mod common;
+
+use hegel::generators;
+use hegel::Generator;
+use std::collections::BTreeSet;
+
+/// Round-trip through the sorted-iterator constructor: `iter()` yields
+/// sorted, deduplicated values, which is exactly what `from_sorted_iter`
+/// documents as its accepted input, so rebuilding from it must succeed and
+/// reproduce the same bitmap.
+#[hegel::test]
+fn hegel_from_sorted_iter_roundtrip(tc: hegel::TestCase) {
+    let rb = tc.draw(common::bitmaps().print_as_debug());
+    let rebuilt = RoaringBitmap::from_sorted_iter(rb.iter())
+        .expect("iter() is sorted, so from_sorted_iter must accept it");
+    assert_eq!(rebuilt, rb);
+}
+
+/// `try_push` is documented to succeed iff the value "is greater than the
+/// current maximum value"; feeding an arbitrary sequence through it must
+/// keep exactly the strictly-increasing subsequence.
+#[hegel::test]
+fn hegel_try_push_succeeds_iff_greater_than_max(tc: hegel::TestCase) {
+    let mut values: Vec<u32> = tc.draw(generators::vecs(generators::integers::<u32>()));
+    // Random sequences are mostly non-increasing; half the time sort them
+    // (keeping duplicates) so long chains of successful pushes and the
+    // `v == max` boundary are exercised too.
+    if tc.draw(generators::booleans()) {
+        values.sort_unstable();
+    }
+
+    let mut rb = RoaringBitmap::new();
+    let mut model = BTreeSet::new();
+    for v in values {
+        let expected_ok = model.last().is_none_or(|&max| v > max);
+        assert_eq!(rb.try_push(v).is_ok(), expected_ok, "try_push({v})");
+        if expected_ok {
+            model.insert(v);
+        }
+    }
+    assert!(rb.iter().eq(model.iter().copied()), "try_push produced wrong contents");
+}
diff --git a/roaring/tests/range_checks.rs b/roaring/tests/range_checks.rs
index 7903eed..61aca65 100644
--- a/roaring/tests/range_checks.rs
+++ b/roaring/tests/range_checks.rs
@@ -75,3 +75,95 @@ proptest! {
         assert!(!bitmap.contains_range(half..end + 1));
     }
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+
+mod common;
+
+use hegel::generators;
+use hegel::Generator;
+
+fn draw_ordered_bounds(tc: &hegel::TestCase) -> (u32, u32) {
+    let a = tc.draw(generators::integers::<u32>());
+    let b = tc.draw(generators::integers::<u32>());
+    if a <= b {
+        (a, b)
+    } else {
+        (b, a)
+    }
+}
+
+/// `range_cardinality(r)` is documented as "the number of elements in this
+/// set which are in the passed range"; plain iteration over the whole set is
+/// an independent oracle for that count. (`Iter::count` is specialized, so
+/// we count with `filter` over the plain iterator instead.)
+#[hegel::test]
+fn hegel_range_cardinality_matches_iteration(tc: hegel::TestCase) {
+    let rb = tc.draw(common::bitmaps().print_as_debug());
+    let (lo, hi) = draw_ordered_bounds(&tc);
+
+    let expected = rb.iter().filter(|v| (lo..=hi).contains(v)).count() as u64;
+    assert_eq!(rb.range_cardinality(lo..=hi), expected);
+}
+
+/// `contains_range(r)` ("true if all values in the range are present") must
+/// agree with `range_cardinality(r)` counting every value of the range.
+#[hegel::test]
+fn hegel_contains_range_iff_full_cardinality(tc: hegel::TestCase) {
+    let mut rb = tc.draw(common::bitmaps().print_as_debug());
+    let (lo, hi) = draw_ordered_bounds(&tc);
+
+    // A random range over a sparse bitmap is almost never fully contained,
+    // so half the time make it contained, and then sometimes poke a single
+    // hole in it to exercise near-miss cases.
+    if tc.draw(generators::booleans()) {
+        rb.insert_range(lo..=hi);
+        if tc.draw(generators::booleans()) {
+            let v = tc.draw(generators::integers::<u32>().min_value(lo).max_value(hi));
+            rb.remove(v);
+        }
+    }
+
+    let span = (hi - lo) as u64 + 1;
+    let expected = rb.range_cardinality(lo..=hi) == span;
+    assert_eq!(rb.contains_range(lo..=hi), expected);
+}
+
+/// `insert_range` is documented to return "the number of inserted values":
+/// that must equal the values of the range that were missing, the length
+/// must grow by exactly that amount, and afterwards the range is contained.
+#[hegel::test]
+fn hegel_insert_range_returns_newly_inserted_count(tc: hegel::TestCase) {
+    let mut rb = tc.draw(common::bitmaps().print_as_debug());
+    let (lo, hi) = draw_ordered_bounds(&tc);
+
+    let span = (hi - lo) as u64 + 1;
+    let missing = span - rb.range_cardinality(lo..=hi);
+    let before = rb.len();
+
+    let inserted = rb.insert_range(lo..=hi);
+
+    assert_eq!(inserted, missing);
+    assert_eq!(rb.len(), before + inserted);
+    assert!(rb.contains_range(lo..=hi));
+}
+
+/// `remove_range` returns the number of removed values: that must equal the
+/// range's prior cardinality, the length must shrink by exactly that amount,
+/// and afterwards the range is empty.
+#[hegel::test]
+fn hegel_remove_range_returns_removed_count(tc: hegel::TestCase) {
+    let mut rb = tc.draw(common::bitmaps().print_as_debug());
+    let (lo, hi) = draw_ordered_bounds(&tc);
+
+    let in_range = rb.range_cardinality(lo..=hi);
+    let before = rb.len();
+
+    let removed = rb.remove_range(lo..=hi);
+
+    assert_eq!(removed, in_range);
+    assert_eq!(rb.len(), before - removed);
+    assert_eq!(rb.range_cardinality(lo..=hi), 0);
+}
