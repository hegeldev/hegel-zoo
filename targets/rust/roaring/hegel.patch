+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+
+use hegel::generators;
+
+/// Round-trip through the treemap on-disk format (documented contract of
+/// `serialized_size`/`serialize_into`/`deserialize_from`): any treemap must
+/// deserialize back equal, and the buffer length must match
+/// `serialized_size`. Values span the full u64 domain so multiple underlying
+/// 32-bit bitmaps are exercised.
+#[hegel::test]
+fn hegel_treemap_serialize_deserialize_roundtrip(tc: hegel::TestCase) {
+    let mut tm: RoaringTreemap =
+        tc.draw(generators::vecs(generators::integers::<u64>())).into_iter().collect();
+    // Add a contiguous run so dense containers are covered too.
+    if tc.draw(generators::booleans()) {
+        let start = tc.draw(generators::integers::<u64>());
+        let len = tc.draw(generators::integers::<u64>().max_value(0x2_0000));
+        tm.insert_range(start..=start.saturating_add(len));
+    }
+
+    let mut buffer = vec![];
+    tm.serialize_into(&mut buffer).unwrap();
+    assert_eq!(buffer.len(), tm.serialized_size());
+
+    let back = RoaringTreemap::deserialize_from(&buffer[..]).unwrap();
+    assert_eq!(back, tm);
+}
