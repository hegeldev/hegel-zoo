 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+
+mod common;
+
+use hegel::generators;
+use hegel::Generator;
+
+/// `select` and `rank` are inverse: `select(n)` is documented as "the `n`th
+/// integer in the set", and `rank(v)` as "the number of integers that are
+/// <= `value`", so for every `n < len()`, `select(n)` must return a member
+/// `v` with `rank(v) == n + 1`.
+#[hegel::test]
+fn hegel_select_rank_inverse(tc: hegel::TestCase) {
+    let rb = tc.draw(common::bitmaps().print_as_debug());
+    tc.assume(!rb.is_empty());
+    let max_n = u32::try_from(rb.len() - 1).unwrap_or(u32::MAX);
+    let n = tc.draw(generators::integers::<u32>().max_value(max_n));
+
+    let v = rb.select(n).expect("select(n) with n < len() must return Some");
+    assert!(rb.contains(v), "select({n}) returned {v}, which is not in the set");
+    assert_eq!(rb.rank(v), n as u64 + 1, "rank(select({n})) must be n + 1");
+}
diff --git a/roaring/tests/serialization.rs b/roaring/tests/serialization.rs
index f4adc8d..52c99ef 100644
--- a/roaring/tests/serialization.rs
+++ b/roaring/tests/serialization.rs
@@ -746,3 +746,65 @@ fn deserialize_bitset_incorrect_cardinality() {
     data[data_start.len()] = 0x0;
     assert_invalid_serialization(&data, "Bitset incorrect cardinality");
 }
+
+// ---------------------------------------------------------------------------
+// Hegel property-based tests
+// ---------------------------------------------------------------------------
+
+mod common;
+
+use hegel::generators;
+use hegel::Generator;
+
+/// Round-trip through the standard on-disk format: `deserialize_from`
+/// must exactly reconstruct any bitmap written by `serialize_into`, and
+/// `serialized_size` must equal the number of bytes actually written
+/// (documented contract of `serialized_size`).
+#[hegel::test]
+fn hegel_serialize_deserialize_roundtrip(tc: hegel::TestCase) {
+    let rb = tc.draw(common::bitmaps().print_as_debug());
+
+    let mut buffer = vec![];
+    rb.serialize_into(&mut buffer).unwrap();
+    assert_eq!(buffer.len(), rb.serialized_size());
+
+    let back = RoaringBitmap::deserialize_from(&buffer[..]).unwrap();
+    assert_eq!(back, rb);
+}
+
+/// Parse robustness: `deserialize_from` documents that it "checks that all
+/// of the internal values are valid", so on arbitrary or corrupted input it
+/// must either return an error or a bitmap that passes `internal_validate`
+/// — it must never panic. (The `against_croaring` fuzz target checks the
+/// same thing.)
+#[hegel::test]
+fn hegel_deserialize_arbitrary_bytes_never_panics(tc: hegel::TestCase) {
+    // Half the time start from a valid serialization (so we get past the
+    // cookie check), half the time from raw bytes.
+    let mut buffer: Vec<u8> = if tc.draw(generators::booleans()) {
+        let rb = tc.draw(common::bitmaps().print_as_debug());
+        let mut buffer = vec![];
+        rb.serialize_into(&mut buffer).unwrap();
+        buffer
+    } else {
+        tc.draw(generators::binary().max_size(2048))
+    };
+
+    // Corrupt a few positions.
+    if !buffer.is_empty() {
+        let edits = tc.draw(generators::integers::<usize>().max_value(8));
+        for _ in 0..edits {
+            let pos = tc.draw(generators::integers::<usize>().max_value(buffer.len() - 1));
+            buffer[pos] = tc.draw(generators::integers::<u8>());
+        }
+    }
+    // Maybe truncate.
+    if tc.draw(generators::booleans()) {
+        let keep = tc.draw(generators::integers::<usize>().max_value(buffer.len()));
+        buffer.truncate(keep);
+    }
+
+    if let Ok(rb) = RoaringBitmap::deserialize_from(&buffer[..]) {
+        rb.internal_validate().expect("checked deserialization produced an invalid bitmap");
+    }
+}
