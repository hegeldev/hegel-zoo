+//! Hegel property tests for `time`: the proleptic Gregorian calendar (`large-dates`, years
+//! ±999 999), Julian days, ISO weeks, `Time`, `UtcOffset`, `OffsetDateTime`/`UtcDateTime`/
+//! `Timestamp`, `SignedDuration`, format descriptions and the well-known RFC 3339/2822/ISO 8601
+//! formats.
+//!
+//! Oracles: a small calendar model (Hinnant's `days_from_civil`/`civil_from_days`, the ISO week
+//! rules, i128 nanoseconds) for the whole range, and the `jiff` crate — an independent library
+//! with its own arithmetic, `strftime`, RFC 3339/2822 codecs — for years −9999..=9999, with
+//! `time`'s format-description components mapped onto `strftime` specifiers.
+
+use hegel::generators;
+use jiff::civil;
+use time::format_description::well_known::{Iso8601, Rfc2822, Rfc3339};
+use time::format_description::{self, BorrowedFormatItem};
+use time::{
+    Date, Month, OffsetDateTime, PlainDateTime, SignedDuration, Time, Timestamp, UtcDateTime,
+    UtcOffset, Weekday,
+};
+
+// ----------------------------------------------------------------------------------------------
+// the calendar model
+
+fn days_from_civil(y: i64, m: i64, d: i64) -> i64 {
+    let y = if m <= 2 { y - 1 } else { y };
+    let era = y.div_euclid(400);
+    let yoe = y - era * 400;
+    let mp = (m + 9) % 12;
+    let doy = (153 * mp + 2) / 5 + d - 1;
+    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    era * 146_097 + doe - 719_468
+}
+
+fn civil_from_days(z: i64) -> (i64, i64, i64) {
+    let z = z + 719_468;
+    let era = z.div_euclid(146_097);
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let y = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    (if m <= 2 { y + 1 } else { y }, m, d)
+}
+
+fn is_leap(y: i64) -> bool {
+    (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
+}
+
+fn days_in_month(y: i64, m: i64) -> i64 {
+    match m {
+        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,
+        4 | 6 | 9 | 11 => 30,
+        2 if is_leap(y) => 29,
+        2 => 28,
+        _ => unreachable!(),
+    }
+}
+
+/// ISO weekday, Monday = 1 … Sunday = 7, of a day count since 1970-01-01 (a Thursday).
+fn iso_weekday(days: i64) -> i64 {
+    (days + 3).rem_euclid(7) + 1
+}
+
+fn ordinal(y: i64, m: i64, d: i64) -> i64 {
+    days_from_civil(y, m, d) - days_from_civil(y, 1, 1) + 1
+}
+
+fn iso_weeks_in_year(y: i64) -> i64 {
+    let jan1 = iso_weekday(days_from_civil(y, 1, 1));
+    if jan1 == 4 || (jan1 == 3 && is_leap(y)) { 53 } else { 52 }
+}
+
+fn iso_week(y: i64, m: i64, d: i64) -> (i64, i64) {
+    let wd = iso_weekday(days_from_civil(y, m, d));
+    let week = (ordinal(y, m, d) - wd + 10) / 7;
+    if week < 1 {
+        (y - 1, iso_weeks_in_year(y - 1))
+    } else if week > iso_weeks_in_year(y) {
+        (y + 1, 1)
+    } else {
+        (y, week)
+    }
+}
+
+/// Week number with weeks starting on Sunday (`%U`) or Monday (`%W`), week 1 being the first
+/// full week of the year.
+fn week_number(y: i64, m: i64, d: i64, week_starts_sunday: bool) -> i64 {
+    let days = days_from_civil(y, m, d);
+    let wd = iso_weekday(days);
+    let offset = if week_starts_sunday { wd % 7 } else { wd - 1 };
+    (ordinal(y, m, d) - 1 - offset + 7) / 7
+}
+
+/// The Julian day number of 1970-01-01.
+const JD_EPOCH: i64 = 2_440_588;
+
+// ----------------------------------------------------------------------------------------------
+// generators
+
+macro_rules! printable {
+    ($($t:ident($inner:ty)),*) => {$(
+        #[derive(Clone, Copy, PartialEq, Eq)]
+        struct $t($inner);
+        impl std::fmt::Debug for $t {
+            fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                write!(f, "{:?}", self.0)
+            }
+        }
+        impl hegel::PrettyPrintable for $t {
+            fn pretty_print(&self, printer: &mut hegel::pretty::PrettyPrinter) {
+                hegel::pretty::print_debug_repr(&format!("{self:?}"), printer);
+            }
+        }
+    )*};
+}
+
+printable!(D(Date), T(Time), Off(UtcOffset), Delta(SignedDuration));
+
+macro_rules! int {
+    ($lo:expr, $hi:expr) => {
+        generators::integers().min_value($lo).max_value($hi)
+    };
+}
+
+fn month(m: i64) -> Month {
+    Month::try_from(m as u8).unwrap()
+}
+
+fn date(y: i64, m: i64, d: i64) -> Date {
+    Date::from_calendar_date(y as i32, month(m), d as u8).unwrap()
+}
+
+const MIN_YEAR: i64 = -999_999;
+const MAX_YEAR: i64 = 999_999;
+
+/// A date anywhere in the `large-dates` range, biased to recent centuries and year edges.
+#[hegel::composite]
+fn arb_date(tc: &hegel::TestCase) -> D {
+    let d = match tc.draw(int!(0u8, 4)) {
+        0 => {
+            let lo = days_from_civil(MIN_YEAR, 1, 1);
+            let hi = days_from_civil(MAX_YEAR, 12, 31);
+            let (y, m, d) = civil_from_days(tc.draw(int!(lo, hi)));
+            date(y, m, d)
+        }
+        1 => {
+            let y = tc.draw(int!(-9999i64, 9999));
+            let m = tc.draw(int!(1i64, 12));
+            date(y, m, tc.draw(int!(1i64, days_in_month(y, m))))
+        }
+        2 => {
+            let y = tc.draw(int!(1890i64, 2110));
+            let m = tc.draw(int!(1i64, 12));
+            date(y, m, tc.draw(int!(1i64, days_in_month(y, m))))
+        }
+        3 => {
+            let y = tc.draw(int!(-9999i64, 9999));
+            let o = tc.draw(int!(1i64, 4));
+            let n = if is_leap(y) { 366 } else { 365 };
+            let o = if tc.draw(generators::booleans()) { o } else { n + 1 - o };
+            Date::from_ordinal_date(y as i32, o as u16).unwrap()
+        }
+        _ => tc.draw(generators::sampled_from(vec![
+            D(Date::MIN),
+            D(Date::MAX),
+            D(date(1970, 1, 1)),
+            D(date(0, 1, 1)),
+            D(date(0, 12, 31)),
+            D(date(1, 1, 1)),
+            D(date(-1, 12, 31)),
+            D(date(2000, 2, 29)),
+            D(date(1900, 2, 28)),
+            D(date(9999, 12, 31)),
+            D(date(10000, 1, 1)),
+            D(date(-10000, 1, 1)),
+            D(date(-4713, 11, 24)),
+        ])).0,
+    };
+    D(d)
+}
+
+#[hegel::composite]
+fn arb_jiff_date(tc: &hegel::TestCase) -> D {
+    let y = match tc.draw(int!(0u8, 2)) {
+        0 => tc.draw(int!(-9999i64, 9999)),
+        1 => tc.draw(int!(1890i64, 2110)),
+        _ => tc.draw(int!(1i64, 9999)),
+    };
+    let m = tc.draw(int!(1i64, 12));
+    D(date(y, m, tc.draw(int!(1i64, days_in_month(y, m)))))
+}
+
+#[hegel::composite]
+fn arb_time(tc: &hegel::TestCase) -> T {
+    let h = tc.draw(int!(0u8, 23));
+    let m = tc.draw(int!(0u8, 59));
+    let s = tc.draw(int!(0u8, 59));
+    let n = match tc.draw(int!(0u8, 3)) {
+        0 => 0,
+        1 => tc.draw(int!(0u32, 999)) * 1_000_000,
+        2 => tc.draw(int!(0u32, 999_999)) * 1_000,
+        _ => tc.draw(int!(0u32, 999_999_999)),
+    };
+    T(Time::from_hms_nano(h, m, s, n).unwrap())
+}
+
+/// An offset: whole hours, half hours, or any seconds below the ±25:59:59 limit.
+#[hegel::composite]
+fn arb_offset(tc: &hegel::TestCase) -> Off {
+    let secs = match tc.draw(int!(0u8, 3)) {
+        0 => 0,
+        1 => tc.draw(int!(-14i32, 14)) * 3600,
+        2 => tc.draw(int!(-27i32, 27)) * 1800,
+        _ => tc.draw(int!(-93_599i32, 93_599)),
+    };
+    Off(UtcOffset::from_whole_seconds(secs).unwrap())
+}
+
+#[hegel::composite]
+fn arb_delta(tc: &hegel::TestCase) -> Delta {
+    let d = match tc.draw(int!(0u8, 4)) {
+        0 => SignedDuration::nanoseconds(tc.draw(int!(-1_000_000_000_000i64, 1_000_000_000_000))),
+        1 => SignedDuration::seconds(tc.draw(int!(-100_000_000i64, 100_000_000))),
+        2 => SignedDuration::new(tc.draw(int!(-1_000_000_000_000i64, 1_000_000_000_000)), tc.draw(int!(-999_999_999i32, 999_999_999))),
+        3 => SignedDuration::new(tc.draw(generators::integers::<i64>()), tc.draw(int!(0i32, 999_999_999))),
+        _ => tc.draw(generators::sampled_from(vec![
+            Delta(SignedDuration::ZERO),
+            Delta(SignedDuration::MIN),
+            Delta(SignedDuration::MAX),
+            Delta(SignedDuration::NANOSECOND),
+            Delta(-SignedDuration::NANOSECOND),
+            Delta(SignedDuration::DAY),
+            Delta(-SignedDuration::DAY),
+            Delta(SignedDuration::new(i64::MAX, 999_999_999)),
+            Delta(SignedDuration::new(i64::MIN, -999_999_999)),
+        ])).0,
+    };
+    Delta(d)
+}
+
+fn jiff_date(d: Date) -> civil::Date {
+    civil::Date::new(d.year() as i16, d.month() as i8, d.day() as i8).unwrap()
+}
+
+fn jiff_datetime(dt: PlainDateTime) -> civil::DateTime {
+    jiff_date(dt.date()).at(dt.hour() as i8, dt.minute() as i8, dt.second() as i8, dt.nanosecond() as i32)
+}
+
+fn jiff_weekday(w: Weekday) -> civil::Weekday {
+    civil::Weekday::from_monday_one_offset(w.number_from_monday() as i8).unwrap()
+}
+
+fn day_count(d: Date) -> i64 {
+    days_from_civil(d.year() as i64, d.month() as i64, d.day() as i64)
+}
+
+fn nanos_of(dt: PlainDateTime) -> i128 {
+    let secs = day_count(dt.date()) as i128 * 86_400 + (dt.hour() as i128 * 3600 + dt.minute() as i128 * 60 + dt.second() as i128);
+    secs * 1_000_000_000 + dt.nanosecond() as i128
+}
+
+fn delta_nanos(d: SignedDuration) -> i128 {
+    d.whole_seconds() as i128 * 1_000_000_000 + d.subsec_nanoseconds() as i128
+}
+
+fn in_jiff_range(dt: PlainDateTime, off: UtcOffset) -> bool {
+    let secs = (nanos_of(dt) - off.whole_seconds() as i128 * 1_000_000_000).div_euclid(1_000_000_000);
+    (-377_705_023_201..=253_402_207_200).contains(&secs)
+}
+
+fn desc(s: &str) -> Vec<BorrowedFormatItem<'_>> {
+    format_description::parse_borrowed::<2>(s).unwrap_or_else(|e| panic!("bad description {s:?}: {e}"))
+}
+
+// ----------------------------------------------------------------------------------------------
+// dates
+
+#[hegel::test]
+fn dates_match_the_calendar_model(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_date());
+    let (y, m, day) = (d.year() as i64, d.month() as i64, d.day() as i64);
+    let days = days_from_civil(y, m, day);
+    assert_eq!(civil_from_days(days), (y, m, day));
+    // Julian day both ways
+    assert_eq!(d.to_julian_day() as i64, days + JD_EPOCH, "{d:?}");
+    assert_eq!(Date::from_julian_day(d.to_julian_day()), Ok(d));
+    // components
+    assert_eq!(d.ordinal() as i64, ordinal(y, m, day), "{d:?}");
+    assert_eq!(d.weekday().number_from_monday() as i64, iso_weekday(days), "{d:?}");
+    assert_eq!(d.weekday().number_from_sunday() as i64, iso_weekday(days) % 7 + 1);
+    assert_eq!(d.weekday().number_days_from_monday() + 1, d.weekday().number_from_monday());
+    assert_eq!(d.weekday().number_days_from_sunday() + 1, d.weekday().number_from_sunday());
+    let (iy, iw) = iso_week(y, m, day);
+    assert_eq!(d.iso_week() as i64, iw, "{d:?}");
+    assert_eq!(d.to_iso_week_date(), (iy as i32, iw as u8, d.weekday()), "{d:?}");
+    assert_eq!(d.sunday_based_week() as i64, week_number(y, m, day, true), "{d:?}");
+    assert_eq!(d.monday_based_week() as i64, week_number(y, m, day, false), "{d:?}");
+    assert_eq!(d.to_calendar_date(), (d.year(), d.month(), d.day()));
+    assert_eq!(d.to_ordinal_date(), (d.year(), d.ordinal()));
+    assert_eq!(d.month().length(d.year()) as i64, days_in_month(y, m), "{d:?}");
+    assert_eq!(time::util::days_in_month(d.month(), d.year()) as i64, days_in_month(y, m));
+    assert_eq!(time::util::is_leap_year(d.year()), is_leap(y));
+    assert_eq!(time::util::days_in_year(d.year()) as i64, if is_leap(y) { 366 } else { 365 });
+    assert_eq!(time::util::weeks_in_year(d.year()) as i64, iso_weeks_in_year(y), "{d:?}");
+    // constructors agree and refuse the values just outside
+    assert_eq!(Date::from_calendar_date(d.year(), d.month(), d.day()), Ok(d));
+    assert_eq!(Date::from_ordinal_date(d.year(), d.ordinal()), Ok(d));
+    assert_eq!(Date::from_iso_week_date(iy as i32, iw as u8, d.weekday()), Ok(d), "{d:?}");
+    assert!(Date::from_calendar_date(d.year(), d.month(), days_in_month(y, m) as u8 + 1).is_err(), "{d:?}");
+    assert!(Date::from_calendar_date(d.year(), d.month(), 0).is_err());
+    assert!(Date::from_ordinal_date(d.year(), if is_leap(y) { 367 } else { 366 }).is_err());
+    assert!(Date::from_ordinal_date(d.year(), 0).is_err());
+    assert!(Date::from_iso_week_date(d.year(), 0, d.weekday()).is_err());
+    assert!(Date::from_iso_week_date(d.year(), iso_weeks_in_year(y) as u8 + 1, d.weekday()).is_err(), "{d:?}");
+    // neighbours and occurrences
+    assert_eq!(d.next_day().map(day_count), if d == Date::MAX { None } else { Some(days + 1) });
+    assert_eq!(d.previous_day().map(day_count), if d == Date::MIN { None } else { Some(days - 1) });
+    if d.year().abs() < MAX_YEAR as i32 - 1 {
+        for w in [Weekday::Monday, Weekday::Thursday, Weekday::Sunday, d.weekday()] {
+            let target = w.number_from_monday() as i64;
+            let next = d.next_occurrence(w);
+            let ahead = (target - iso_weekday(days)).rem_euclid(7);
+            let ahead = if ahead == 0 { 7 } else { ahead };
+            assert_eq!(day_count(next), days + ahead, "{d:?} next {w:?}");
+            let prev = d.prev_occurrence(w);
+            let back = (iso_weekday(days) - target).rem_euclid(7);
+            let back = if back == 0 { 7 } else { back };
+            assert_eq!(day_count(prev), days - back, "{d:?} prev {w:?}");
+            assert_eq!(d.nth_next_occurrence(w, 1), next);
+            assert_eq!(d.nth_next_occurrence(w, 3), next + SignedDuration::days(14));
+            assert_eq!(d.nth_prev_occurrence(w, 1), prev);
+            assert_eq!(d.nth_prev_occurrence(w, 2), prev - SignedDuration::days(7));
+        }
+    }
+    // setters
+    for ny in [d.year() - 1, d.year() + 1, 2000, 1900, 2024] {
+        assert_eq!(d.replace_year(ny).ok(), Date::from_calendar_date(ny, d.month(), d.day()).ok(), "{d:?} year {ny}");
+    }
+    for nm in 1..=12i64 {
+        assert_eq!(d.replace_month(month(nm)).ok(), Date::from_calendar_date(d.year(), month(nm), d.day()).ok(), "{d:?} month {nm}");
+    }
+    for nd in [1u8, 28, 29, 30, 31, 32] {
+        assert_eq!(d.replace_day(nd).ok(), Date::from_calendar_date(d.year(), d.month(), nd).ok(), "{d:?} day {nd}");
+    }
+    for no in [1u16, 59, 60, 365, 366, 367] {
+        assert_eq!(d.replace_ordinal(no).ok(), Date::from_ordinal_date(d.year(), no).ok(), "{d:?} ordinal {no}");
+    }
+    // Display: `year-month-day`, the year padded to four digits, signed outside 0..=9999
+    let text = d.to_string();
+    let expected = if y > 9999 {
+        format!("+{y}-{m:02}-{day:02}")
+    } else if y >= 0 {
+        format!("{y:04}-{m:02}-{day:02}")
+    } else {
+        format!("-{:04}-{m:02}-{day:02}", -y)
+    };
+    assert_eq!(text, expected, "{d:?}");
+    // the default description round-trips for any year
+    let ymd = desc("[year]-[month]-[day]");
+    let formatted = d.format(&ymd).unwrap();
+    assert_eq!(Date::parse(&formatted, &ymd), Ok(d), "{formatted:?}");
+    let yo = desc("[year]-[ordinal]");
+    assert_eq!(Date::parse(&d.format(&yo).unwrap(), &yo), Ok(d), "{d:?}");
+    let iso = desc("[year base:iso_week]-W[week_number]-[weekday repr:monday]");
+    assert_eq!(Date::parse(&d.format(&iso).unwrap(), &iso), Ok(d), "{d:?}");
+    let named = desc("[weekday], [month repr:long] [day padding:none], [year]");
+    assert_eq!(Date::parse(&d.format(&named).unwrap(), &named), Ok(d), "{d:?}");
+    // the Monday-based week number parses back (the Sunday-based one is time/1)
+    let monday = desc("[year]-[week_number repr:monday]-[weekday repr:monday one_indexed:false]");
+    assert_eq!(Date::parse(&d.format(&monday).unwrap(), &monday), Ok(d), "{d:?}");
+}
+
+#[hegel::test]
+fn date_arithmetic_matches_the_model(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_date());
+    let D(e) = tc.draw(arb_date());
+    let Delta(delta) = tc.draw(arb_delta());
+    let days = day_count(d);
+    let lo = days_from_civil(MIN_YEAR, 1, 1);
+    let hi = days_from_civil(MAX_YEAR, 12, 31);
+    let expect = |target: i128| -> Option<Date> {
+        if target < lo as i128 || target > hi as i128 {
+            None
+        } else {
+            let (y, m, dd) = civil_from_days(target as i64);
+            Some(date(y, m, dd))
+        }
+    };
+    // a duration adds its whole days
+    let whole_days = delta.whole_days() as i128;
+    assert_eq!(d.checked_add(delta), expect(days as i128 + whole_days), "{d:?} + {delta:?}");
+    assert_eq!(d.checked_sub(delta), expect(days as i128 - whole_days), "{d:?} - {delta:?}");
+    let std_days = tc.draw(int!(0u64, 400_000_000));
+    let std = std::time::Duration::from_secs(std_days * 86_400 + tc.draw(int!(0u64, 86_399)));
+    assert_eq!(d.checked_add_std(std), expect(days as i128 + std_days as i128), "{d:?} + {std:?}");
+    assert_eq!(d.checked_sub_std(std), expect(days as i128 - std_days as i128), "{d:?} - {std:?}");
+    // saturating
+    let sat = d.saturating_add(delta);
+    assert_eq!(sat, expect(days as i128 + whole_days).unwrap_or(if whole_days > 0 { Date::MAX } else { Date::MIN }), "{d:?} +sat {delta:?}");
+    assert_eq!(d.saturating_sub(delta), expect(days as i128 - whole_days).unwrap_or(if whole_days > 0 { Date::MIN } else { Date::MAX }), "{d:?} -sat {delta:?}");
+    // differences
+    let diff = d - e;
+    assert_eq!(diff, SignedDuration::days(days - day_count(e)), "{d:?} - {e:?}");
+    assert_eq!(e + diff, d);
+    assert_eq!(d.cmp(&e), days.cmp(&day_count(e)));
+    // the Julian day range
+    assert!(Date::from_julian_day(Date::MAX.to_julian_day() + 1).is_err());
+    assert!(Date::from_julian_day(Date::MIN.to_julian_day() - 1).is_err());
+    assert_eq!(Date::MIN.year(), MIN_YEAR as i32);
+    assert_eq!(Date::MAX.year(), MAX_YEAR as i32);
+}
+
+#[hegel::test]
+fn dates_agree_with_jiff(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_jiff_date());
+    let D(e) = tc.draw(arb_jiff_date());
+    let n = tc.draw(int!(-4_000_000i64, 4_000_000));
+    let j = jiff_date(d);
+    assert_eq!(d.weekday().number_from_monday() as i8, j.weekday().to_monday_one_offset(), "{d:?}");
+    assert_eq!(d.ordinal() as i16, j.day_of_year(), "{d:?}");
+    assert_eq!(time::util::is_leap_year(d.year()), j.in_leap_year());
+    assert_eq!(d.month().length(d.year()) as i8, j.days_in_month());
+    let iso = j.iso_week_date();
+    let (iy, iw, wd) = d.to_iso_week_date();
+    assert_eq!((iy as i16, iw as i8, jiff_weekday(wd)), (iso.year(), iso.week(), iso.weekday()), "{d:?}");
+    assert_eq!(civil::Date::from_iso_week_date(civil::ISOWeekDate::new(iy as i16, iw as i8, jiff_weekday(wd)).unwrap()), j);
+    let in_range = |x: &Date| (-9999..=9999).contains(&x.year());
+    assert_eq!(d.next_day().filter(in_range).map(jiff_date), j.tomorrow().ok(), "{d:?}");
+    assert_eq!(d.previous_day().filter(in_range).map(jiff_date), j.yesterday().ok(), "{d:?}");
+    assert_eq!(d.checked_add(SignedDuration::days(n)).filter(in_range).map(jiff_date), j.checked_add(jiff::Span::new().try_days(n).unwrap()).ok(), "{d:?} + {n} days");
+    assert_eq!((d - e).whole_days(), i64::from(j.since(jiff_date(e)).unwrap().get_days()), "{d:?} - {e:?}");
+    if d.year().abs() < 9999 {
+        for w in [Weekday::Monday, Weekday::Friday, d.weekday()] {
+            assert_eq!(jiff_date(d.next_occurrence(w)), j.nth_weekday(1, jiff_weekday(w)).unwrap(), "{d:?} next {w:?}");
+            assert_eq!(jiff_date(d.prev_occurrence(w)), j.nth_weekday(-1, jiff_weekday(w)).unwrap(), "{d:?} prev {w:?}");
+            assert_eq!(jiff_date(d.nth_next_occurrence(w, 2)), j.nth_weekday(2, jiff_weekday(w)).unwrap());
+        }
+    }
+    assert_eq!(jiff_date(d.replace_day(1).unwrap()), j.first_of_month());
+    assert_eq!(jiff_date(d.replace_day(d.month().length(d.year())).unwrap()), j.last_of_month());
+    assert_eq!(d.month().next() as u8, j.month() as u8 % 12 + 1);
+    assert_eq!(d.month().previous() as u8, (j.month() as u8 + 10) % 12 + 1);
+}
