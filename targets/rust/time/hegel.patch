+#[hegel::test]
+fn datetime_arithmetic_matches_the_model(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_date());
+    let T(t) = tc.draw(arb_time());
+    let Delta(delta) = tc.draw(arb_delta());
+    let D(e) = tc.draw(arb_date());
+    let T(u) = tc.draw(arb_time());
+    let dt = PlainDateTime::new(d, t);
+    let other = PlainDateTime::new(e, u);
+    let nanos = nanos_of(dt);
+    let lo = nanos_of(PlainDateTime::MIN);
+    let hi = nanos_of(PlainDateTime::MAX);
+    let expect = |target: i128| -> Option<PlainDateTime> {
+        if target < lo || target > hi {
+            return None;
+        }
+        let days = target.div_euclid(86_400 * 1_000_000_000);
+        let rest = target.rem_euclid(86_400 * 1_000_000_000);
+        let (y, m, dd) = civil_from_days(days as i64);
+        let secs = (rest / 1_000_000_000) as u32;
+        Some(PlainDateTime::new(date(y, m, dd), Time::from_hms_nano((secs / 3600) as u8, (secs / 60 % 60) as u8, (secs % 60) as u8, (rest % 1_000_000_000) as u32).unwrap()))
+    };
+    let sum = dt.checked_add(delta);
+    assert_eq!(sum, expect(nanos + delta_nanos(delta)), "{dt:?} + {delta:?}");
+    assert_eq!(dt.checked_sub(delta), expect(nanos - delta_nanos(delta)), "{dt:?} - {delta:?}");
+    assert_eq!(dt.saturating_add(delta), expect(nanos + delta_nanos(delta)).unwrap_or(if delta.is_negative() { PlainDateTime::MIN } else { PlainDateTime::MAX }));
+    if let Some(sum) = sum {
+        assert_eq!(dt + delta, sum);
+        assert_eq!(sum - delta, dt);
+        assert_eq!(sum - dt, delta);
+        assert_eq!(dt.assume_utc() + delta, sum.assume_utc());
+        assert_eq!(dt.as_utc().checked_add(delta), Some(sum.as_utc()));
+    }
+    assert_eq!(delta_nanos(dt - other), nanos - nanos_of(other), "{dt:?} - {other:?}");
+    assert_eq!(dt.cmp(&other), nanos.cmp(&nanos_of(other)));
+    assert_eq!((dt.date(), dt.time()), (d, t));
+    assert_eq!(dt.replace_time(u), PlainDateTime::new(d, u));
+    assert_eq!(dt.replace_date(e), PlainDateTime::new(e, t));
+    assert_eq!(dt.truncate_to_day(), PlainDateTime::new(d, Time::MIDNIGHT));
+    assert_eq!(dt.to_julian_day(), d.to_julian_day());
+    assert_eq!(dt.sunday_based_week(), d.sunday_based_week());
+    // the same day through an offset
+    let Off(off) = tc.draw(arb_offset());
+    if (-9999..=9999).contains(&d.year()) {
+        let local = dt.assume_offset(off);
+        assert_eq!(local.unix_timestamp_nanos(), nanos - off.whole_seconds() as i128 * 1_000_000_000);
+        assert_eq!(local.checked_add(delta).map(|x| x.unix_timestamp_nanos()), sum.map(|s| nanos_of(s) - off.whole_seconds() as i128 * 1_000_000_000), "{dt:?} at {off:?} + {delta:?}");
+    }
+}
