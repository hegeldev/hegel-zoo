+// ----------------------------------------------------------------------------------------------
+// SignedDuration
+
+#[hegel::test]
+fn signed_durations_match_i128_nanoseconds(tc: hegel::TestCase) {
+    let Delta(a) = tc.draw(arb_delta());
+    let Delta(b) = tc.draw(arb_delta());
+    let k = tc.draw(int!(-1000i32, 1000));
+    let (na, nb) = (delta_nanos(a), delta_nanos(b));
+    let lo = delta_nanos(SignedDuration::MIN);
+    let hi = delta_nanos(SignedDuration::MAX);
+    let make = |n: i128| -> Option<SignedDuration> {
+        if n < lo || n > hi {
+            return None;
+        }
+        Some(SignedDuration::new((n / 1_000_000_000) as i64, (n % 1_000_000_000) as i32))
+    };
+    assert_eq!(a.whole_nanoseconds(), na, "{a:?}");
+    assert_eq!(make(na), Some(a), "{a:?} rebuilt");
+    assert_eq!(SignedDuration::nanoseconds_i128(na), a);
+    // the two parts share a sign and the accessors truncate toward zero
+    assert!(a.whole_seconds() == 0 || a.subsec_nanoseconds() == 0 || (a.whole_seconds() < 0) == (a.subsec_nanoseconds() < 0), "{a:?}: mixed signs");
+    assert_eq!(a.whole_seconds() as i128, na / 1_000_000_000);
+    assert_eq!(a.subsec_nanoseconds() as i128, na % 1_000_000_000);
+    assert_eq!(a.whole_milliseconds(), na / 1_000_000);
+    assert_eq!(a.whole_microseconds(), na / 1_000);
+    assert_eq!(a.subsec_milliseconds() as i128, na % 1_000_000_000 / 1_000_000);
+    assert_eq!(a.subsec_microseconds() as i128, na % 1_000_000_000 / 1_000);
+    assert_eq!(a.whole_minutes() as i128, na / 60_000_000_000);
+    assert_eq!(a.whole_hours() as i128, na / 3_600_000_000_000);
+    assert_eq!(a.whole_days() as i128, na / 86_400_000_000_000);
+    assert_eq!(a.whole_weeks() as i128, na / 604_800_000_000_000);
+    assert_eq!((a.is_zero(), a.is_positive(), a.is_negative()), (na == 0, na > 0, na < 0));
+    assert_eq!(a.cmp(&b), na.cmp(&nb));
+    // arithmetic
+    assert_eq!(a.checked_add(b), make(na + nb), "{a:?} + {b:?}");
+    assert_eq!(a.checked_sub(b), make(na - nb), "{a:?} - {b:?}");
+    assert_eq!(a.saturating_add(b), make(na + nb).unwrap_or(if na + nb > 0 { SignedDuration::MAX } else { SignedDuration::MIN }));
+    if a.whole_seconds() != 0 {
+        // a zero seconds field saturates the wrong way: time/2
+        assert_eq!(a.saturating_sub(b), make(na - nb).unwrap_or(if na - nb > 0 { SignedDuration::MAX } else { SignedDuration::MIN }));
+    }
+    assert_eq!(a.checked_mul(k), make(na * k as i128), "{a:?} × {k}");
+    assert_eq!(a.saturating_mul(k), make(na * k as i128).unwrap_or(if na * k as i128 > 0 { SignedDuration::MAX } else { SignedDuration::MIN }), "{a:?} ×sat {k}");
+    if k != 0 {
+        assert_eq!(a.checked_div(k), make(na / k as i128), "{a:?} / {k}: truncated");
+        if let Some(q) = make(na / k as i128) {
+            assert_eq!(a / k, q);
+        }
+    } else {
+        assert_eq!(a.checked_div(0), None);
+    }
+    assert_eq!(a.checked_neg(), make(-na), "{a:?}");
+    if let Some(neg) = make(-na) {
+        assert_eq!(-a, neg);
+        assert_eq!(a.abs(), if na < 0 { neg } else { a });
+    }
+    assert_eq!(a.unsigned_abs().as_nanos(), na.unsigned_abs());
+    // constructors
+    assert_eq!(delta_nanos(SignedDuration::seconds(a.whole_seconds())), a.whole_seconds() as i128 * 1_000_000_000);
+    if let Ok(ms) = i64::try_from(a.whole_milliseconds()) {
+        assert_eq!(delta_nanos(SignedDuration::milliseconds(ms)), ms as i128 * 1_000_000);
+    }
+    if let Ok(us) = i64::try_from(a.whole_microseconds()) {
+        assert_eq!(delta_nanos(SignedDuration::microseconds(us)), us as i128 * 1_000);
+    }
+    if let Ok(ns) = i64::try_from(na) {
+        assert_eq!(SignedDuration::nanoseconds(ns), a);
+    }
+    let carry = tc.draw(int!(-1i32, 1));
+    if a.whole_seconds().checked_add(carry as i64).is_some() {
+        let shifted = SignedDuration::new(a.whole_seconds(), a.subsec_nanoseconds() + carry * 1_000_000_000);
+        assert_eq!(delta_nanos(shifted), na + carry as i128 * 1_000_000_000, "{a:?}: nanoseconds wrap into seconds");
+    }
+    // std conversions
+    if na >= 0 {
+        let std: std::time::Duration = a.try_into().unwrap();
+        assert_eq!(std.as_nanos(), na as u128);
+        assert_eq!(SignedDuration::try_from(std), Ok(a));
+    } else {
+        assert!(std::time::Duration::try_from(a).is_err(), "{a:?}");
+    }
+    assert!(SignedDuration::try_from(std::time::Duration::MAX).is_err());
+    // floats: the round trip is exact to the nanosecond within f64 precision
+    let f = a.as_seconds_f64();
+    assert!(!f.is_nan());
+    match SignedDuration::checked_seconds_f64(f) {
+        Some(back) => {
+            let tolerance = (na.abs() as f64 * f64::EPSILON * 2.0) as i128 + 1;
+            assert!((delta_nanos(back) - na).abs() <= tolerance, "{a:?} → {f} → {back:?}");
+            assert_eq!(SignedDuration::seconds_f64(f), back);
+        }
+        None => assert!(f.abs() >= i64::MAX as f64, "{a:?} → {f} rejected"),
+    }
+    // Display: `1d2h3m4.5s` style, only the non-zero units; parsed by no one, so checked by shape
+    let text = a.to_string();
+    if na == 0 {
+        assert_eq!(text, "0s");
+    } else {
+        assert_eq!(text.starts_with('-'), na < 0, "{text}");
+        assert!(text.ends_with('s') || text.ends_with('m') || text.ends_with('h') || text.ends_with('d'), "{text}");
+    }
+    let concise = format!("{a:.2}");
+    assert_eq!(concise.starts_with('-'), na < 0 && !concise.starts_with("-0"), "{concise}");
+}
