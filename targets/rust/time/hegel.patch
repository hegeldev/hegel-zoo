+/// time/3: the RFC 2822 parser applies the sign of the offset to the hours only; `-0030` is
+/// read as `-0` hours and `+30` minutes, i.e. `+00:30`.
+#[hegel::test]
+fn rfc2822_negative_offsets_below_an_hour_parse_back(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_jiff_date());
+    if !(1900..=9999).contains(&d.year()) {
+        return;
+    }
+    let T(t) = tc.draw(arb_time());
+    let minutes = tc.draw(int!(1i32, 59));
+    let off = UtcOffset::from_whole_seconds(-60 * minutes).unwrap();
+    let local = PlainDateTime::new(d, t.truncate_to_second()).assume_offset(off);
+    let rfc = local.format(&Rfc2822).unwrap();
+    assert!(rfc.ends_with(&format!("-00{minutes:02}")), "{rfc}");
+    let back = OffsetDateTime::parse(&rfc, &Rfc2822).unwrap();
+    assert_eq!(back.offset(), off, "{rfc}");
+    assert_eq!(back, local, "{rfc}");
+}
