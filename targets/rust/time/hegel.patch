+#[hegel::test]
+fn format_descriptions_agree_with_jiff(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_jiff_date());
+    let T(t) = tc.draw(arb_time());
+    let Off(off) = tc.draw(arb_offset());
+    let off = UtcOffset::from_whole_seconds(off.whole_seconds().clamp(-86_399, 86_399) / 60 * 60).unwrap();
+    let dt = PlainDateTime::new(d, t);
+    if d.year() < 1 || !in_jiff_range(dt, off) {
+        return;
+    }
+    let local = dt.assume_offset(off);
+    let jz = jiff_datetime(dt).to_zoned(jiff::tz::TimeZone::fixed(jiff::tz::Offset::from_seconds(off.whole_seconds()).unwrap())).unwrap();
+    for (component, spec) in SHARED {
+        let mine = local.format(&desc(component)).unwrap();
+        let theirs = jiff::fmt::strtime::format(spec, &jz).unwrap_or_else(|e| panic!("jiff can't format {spec}: {e}"));
+        assert_eq!(mine, theirs, "{component} / {spec} of {local:?}");
+    }
+    // `[unix_timestamp]` is the floor of the instant in seconds; jiff's `%s` truncates toward
+    // zero, so the two agree on whole seconds
+    let stamp = local.format(&desc("[unix_timestamp]")).unwrap();
+    assert_eq!(stamp, local.unix_timestamp().to_string(), "{local:?}");
+    if t.nanosecond() == 0 {
+        assert_eq!(stamp, jiff::fmt::strtime::format("%s", &jz).unwrap(), "{local:?}");
+    }
+    let picks = tc.draw(arb_description());
+    let separators = [" ", "-", ":", "/", "T", ", ", "|", ""];
+    let mut description = String::new();
+    let mut strftime = String::new();
+    for (i, &k) in picks.iter().enumerate() {
+        if i > 0 {
+            let sep = separators[k % separators.len()];
+            description.push_str(sep);
+            strftime.push_str(sep);
+        }
+        description.push_str(SHARED[k].0);
+        strftime.push_str(SHARED[k].1);
+    }
+    let mine = local.format(&desc(&description)).unwrap();
+    let theirs = jiff::fmt::strtime::format(&strftime, &jz).unwrap();
+    assert_eq!(mine, theirs, "{description:?} / {strftime:?} of {local:?}");
+    // the same text parses back in both libraries when the description is complete
+    let complete = desc("[year]-[month]-[day] [hour]:[minute]:[second] [offset_hour sign:mandatory]:[offset_minute]");
+    let text = local.replace_nanosecond(0).unwrap().format(&complete).unwrap();
+    assert_eq!(OffsetDateTime::parse(&text, &complete), Ok(local.replace_nanosecond(0).unwrap()), "{text}");
+    let parsed = jiff::fmt::strtime::parse("%Y-%m-%d %H:%M:%S %:z", &text).unwrap().to_timestamp().unwrap();
+    assert_eq!(parsed.as_second(), local.unix_timestamp(), "{text} in jiff");
+}
+
+/// Descriptions that pin down a whole `PlainDateTime` to the second.
+const COMPLETE: &[&str] = &[
+    "[year]-[month]-[day] [hour]:[minute]:[second]",
+    "[year]-[month]-[day]T[hour]:[minute]:[second]",
+    "[year]-[ordinal] [hour]:[minute]:[second]",
+    "[year base:iso_week]-W[week_number]-[weekday repr:monday] [hour]:[minute]:[second]",
+    "[year] [month] [day] [hour repr:12]:[minute]:[second] [period]",
+    "[weekday repr:short], [day] [month repr:short] [year] [hour]:[minute]:[second]",
+    "[weekday] [month repr:long] [day padding:space] [year] [hour padding:space]:[minute]:[second]",
+    "[day]/[month]/[year] [hour]:[minute]:[second]",
+    "[year][month][day][hour][minute][second]",
+    "[year]-[month]-[day] [hour]:[minute]:[second] [ordinal] [weekday repr:monday]",
+    "[year]-[week_number repr:monday]-[weekday repr:monday one_indexed:false] [hour]:[minute]:[second]",
+    "[year]-[week_number repr:monday]-[weekday repr:sunday] [hour]:[minute]:[second]",
+    "[unix_timestamp]",
+];
+
+#[hegel::test]
+fn format_descriptions_round_trip(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_date());
+    let T(t) = tc.draw(arb_time());
+    let Off(off) = tc.draw(arb_offset());
+    let dt = PlainDateTime::new(d, t);
+    let whole = dt.replace_nanosecond(0).unwrap();
+    let description = tc.draw(generators::sampled_from(COMPLETE.to_vec()));
+    let items = desc(description);
+    if description.contains("unix_timestamp") {
+        let utc = whole.assume_utc();
+        let text = utc.format(&items).unwrap();
+        assert_eq!(text, utc.unix_timestamp().to_string());
+        assert_eq!(OffsetDateTime::parse(&text, &items), Ok(utc), "{description:?} → {text:?}");
+        let precise = desc("[unix_timestamp precision:nanosecond]");
+        let text = dt.assume_utc().format(&precise).unwrap();
+        assert_eq!(text, dt.assume_utc().unix_timestamp_nanos().to_string());
+        assert_eq!(OffsetDateTime::parse(&text, &precise), Ok(dt.assume_utc()), "{text:?}");
+    } else if description.starts_with("[year][month]") && !(0..=9999).contains(&d.year()) {
+        // a signed year in the extended range reads up to six digits: without a separator the
+        // month digits are swallowed, so the description only round-trips in 0..=9999
+    } else {
+        let text = whole.format(&items).unwrap();
+        assert_eq!(PlainDateTime::parse(&text, &items), Ok(whole), "{description:?} → {text:?}");
+    }
+    // fractions
+    let frac = desc("[year]-[month]-[day] [hour]:[minute]:[second].[subsecond]");
+    let text = dt.format(&frac).unwrap();
+    assert_eq!(PlainDateTime::parse(&text, &frac), Ok(dt), "{text:?}");
+    // with an offset, seconds included
+    let local = dt.assume_offset(off);
+    let with_offset = desc("[year]-[month]-[day] [hour]:[minute]:[second].[subsecond] [offset_hour sign:mandatory]:[offset_minute]:[offset_second]");
+    let text = local.format(&with_offset).unwrap();
+    let back = OffsetDateTime::parse(&text, &with_offset);
+    assert_eq!(back, Ok(local), "{text:?}");
+    assert_eq!(back.unwrap().offset(), off, "{text:?}");
+    let hhmm = desc("[year]-[month]-[day] [hour]:[minute]:[second] [offset_hour sign:mandatory][offset_minute]");
+    let text = local.replace_nanosecond(0).unwrap().format(&hhmm).unwrap();
+    let back = OffsetDateTime::parse(&text, &hhmm).unwrap();
+    assert_eq!((back.date(), back.time()), (whole.date(), whole.time()), "{text:?}: local time");
+    assert_eq!(back.offset().whole_seconds(), off.whole_seconds() / 60 * 60, "{text:?}: offset without seconds");
+    // trailing input is an error; the end of the description must be the end of the input
+    let text = format!("{} trailing", whole.format(&desc(COMPLETE[0])).unwrap());
+    assert!(PlainDateTime::parse(&text, &desc(COMPLETE[0])).is_err(), "{text:?}");
+}
