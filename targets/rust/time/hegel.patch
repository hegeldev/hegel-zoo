+#[hegel::test]
+fn offset_date_times_agree_with_jiff_and_the_model(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_jiff_date());
+    let T(t) = tc.draw(arb_time());
+    let Off(off) = tc.draw(arb_offset());
+    let Off(off2) = tc.draw(arb_offset());
+    let dt = PlainDateTime::new(d, t);
+    if !in_jiff_range(dt, UtcOffset::UTC) || !in_jiff_range(dt, off) || !in_jiff_range(dt, off2) {
+        return;
+    }
+    let nanos = nanos_of(dt);
+    let secs = nanos.div_euclid(1_000_000_000) as i64;
+    let sub = nanos.rem_euclid(1_000_000_000) as i64;
+    // offsets
+    let o = off.whole_seconds();
+    let (oh, om, os) = off.as_hms();
+    assert_eq!(oh as i32 * 3600 + om as i32 * 60 + os as i32, o, "{off:?}");
+    assert!(om.signum() * oh.signum() >= 0 && os.signum() * oh.signum() >= 0, "{off:?}: one sign");
+    assert_eq!(off.whole_hours() as i32, o / 3600);
+    assert_eq!(off.whole_minutes() as i32, o / 60);
+    assert_eq!(off.minutes_past_hour() as i32, o / 60 % 60);
+    assert_eq!(off.seconds_past_minute() as i32, o % 60);
+    assert_eq!(UtcOffset::from_hms(oh, om, os), Ok(off));
+    assert_eq!(off.is_utc(), o == 0);
+    assert_eq!((off.is_positive(), off.is_negative()), (o > 0, o < 0));
+    assert!(UtcOffset::from_whole_seconds(93_600).is_err() && UtcOffset::from_whole_seconds(-93_600).is_err());
+    assert_eq!(UtcOffset::from_whole_seconds(93_599).map(|x| x.as_hms()), Ok((25, 59, 59)));
+    // the UTC instant
+    let utc = dt.assume_utc();
+    assert_eq!(utc.unix_timestamp(), secs, "{dt:?}");
+    assert_eq!(utc.unix_timestamp_nanos(), nanos);
+    assert_eq!(OffsetDateTime::from_unix_timestamp(secs).map(|x| x.replace_nanosecond(sub as u32).unwrap()), Ok(utc));
+    assert_eq!(OffsetDateTime::from_unix_timestamp_nanos(nanos), Ok(utc));
+    assert_eq!(UtcDateTime::from_unix_timestamp_nanos(nanos).map(|x| x.unix_timestamp_nanos()), Ok(nanos));
+    assert_eq!(dt.as_utc(), UtcDateTime::from_unix_timestamp_nanos(nanos).unwrap());
+    assert_eq!(dt.as_utc().unix_timestamp(), secs);
+    assert_eq!(UtcDateTime::new(d, t), dt.as_utc());
+    let ts = Timestamp::new(secs, sub as u32).unwrap_or_else(|e| panic!("{dt:?}: {e}"));
+    assert_eq!(ts.as_seconds(), secs);
+    assert_eq!(ts.as_nanoseconds(), nanos);
+    assert_eq!(ts.as_milliseconds(), nanos.div_euclid(1_000_000) as i64, "{dt:?}");
+    assert_eq!(ts.as_microseconds(), nanos.div_euclid(1_000));
+    assert_eq!(Timestamp::from_nanoseconds(nanos), Ok(ts));
+    assert_eq!(Timestamp::from_seconds(secs).map(|x| x.as_nanoseconds()), Ok(secs as i128 * 1_000_000_000));
+    assert_eq!((ts.year(), ts.month(), ts.day(), ts.as_hms_nano()), (d.year(), d.month(), d.day(), t.as_hms_nano()), "{dt:?}");
+    assert_eq!((ts.date(), ts.time()), (d, t));
+    // jiff sees the same civil fields at the same instant, in UTC and in the offset
+    let jts = jiff::Timestamp::new(secs, sub as i32).unwrap();
+    assert_eq!(jts.to_zoned(jiff::tz::TimeZone::UTC).datetime(), jiff_datetime(dt), "{dt:?}");
+    let local = dt.assume_offset(off);
+    assert_eq!(local.unix_timestamp_nanos(), nanos - o as i128 * 1_000_000_000, "{dt:?} at {off:?}");
+    assert_eq!(local.offset(), off);
+    assert_eq!((local.date(), local.time()), (d, t));
+    let jz = jiff::Timestamp::from_nanosecond(local.unix_timestamp_nanos()).unwrap().to_zoned(jiff::tz::TimeZone::fixed(jiff::tz::Offset::from_seconds(o).unwrap()));
+    assert_eq!(jz.datetime(), jiff_datetime(dt), "{dt:?} at {off:?}");
+    // moving between offsets keeps the instant
+    let moved = local.to_offset(off2);
+    assert_eq!(moved.unix_timestamp_nanos(), local.unix_timestamp_nanos());
+    assert_eq!(moved, local, "equal instants compare equal across offsets");
+    assert_eq!(moved.offset(), off2);
+    assert_eq!(local.checked_to_offset(off2), Some(moved));
+    assert_eq!(moved.to_utc(), local.to_utc());
+    assert_eq!(local.to_utc().unix_timestamp_nanos(), local.unix_timestamp_nanos());
+    assert_eq!(nanos_of(PlainDateTime::new(moved.date(), moved.time())), nanos - o as i128 * 1_000_000_000 + off2.whole_seconds() as i128 * 1_000_000_000, "{dt:?} {off:?} → {off2:?}");
+    let jz2 = jz.with_time_zone(jiff::tz::TimeZone::fixed(jiff::tz::Offset::from_seconds(off2.whole_seconds()).unwrap()));
+    assert_eq!(jz2.datetime(), jiff_datetime(PlainDateTime::new(moved.date(), moved.time())), "{dt:?} {off:?} → {off2:?} in jiff");
+    assert_eq!(OffsetDateTime::new_in_offset(d, t, off), local);
+    assert_eq!(OffsetDateTime::new_utc(d, t), utc);
+    assert_eq!(local.replace_offset(off2).unix_timestamp_nanos(), nanos - off2.whole_seconds() as i128 * 1_000_000_000);
+    // ordering follows the instant
+    let later = local.checked_add(SignedDuration::NANOSECOND).unwrap();
+    assert!(later.to_offset(off2) > local);
+    assert_eq!(later - local, SignedDuration::NANOSECOND);
+    // Display / RFC 3339 for whole-minute offsets in 0..=9999
+    if o % 60 == 0 && (0..=9999).contains(&d.year()) {
+        let rfc = local.format(&Rfc3339).unwrap();
+        assert_eq!(OffsetDateTime::parse(&rfc, &Rfc3339), Ok(local), "{rfc}");
+        assert_eq!(OffsetDateTime::parse(&rfc, &Rfc3339).unwrap().offset(), off, "{rfc}");
+        let jparsed: jiff::Timestamp = rfc.parse().unwrap_or_else(|e| panic!("jiff rejects {rfc}: {e}"));
+        assert_eq!(jparsed.as_nanosecond(), local.unix_timestamp_nanos(), "{rfc}");
+        let jtext = jz.timestamp().display_with_offset(jz.offset()).to_string();
+        assert_eq!(OffsetDateTime::parse(&jtext, &Rfc3339), Ok(local), "{jtext}");
+        assert_eq!(OffsetDateTime::parse(&jtext, &Rfc3339).unwrap().offset(), off, "{jtext}");
+        assert_eq!(rfc.ends_with('Z'), o == 0, "{rfc}");
+        assert_eq!(UtcDateTime::parse(&rfc, &Rfc3339), Ok(local.to_utc()), "{rfc}");
+        // ISO 8601 default: nine fraction digits, offset to the minute
+        let iso = local.format(&Iso8601::DEFAULT).unwrap();
+        assert_eq!(OffsetDateTime::parse(&iso, &Iso8601::DEFAULT), Ok(local), "{iso}");
+        assert_eq!(OffsetDateTime::parse(&iso, &Iso8601::DEFAULT).unwrap().offset(), off, "{iso}");
+        assert_eq!(iso.len(), if o == 0 { 30 } else { 35 }, "{iso}");
+        assert_eq!(&iso[..19], &rfc[..19]);
+    }
+    // RFC 2822: seconds precision, `+hhmm`, years 1900..=9999
+    if o % 60 == 0 && (1900..=9999).contains(&d.year()) {
+        let whole = local.replace_nanosecond(0).unwrap();
+        let rfc = whole.format(&Rfc2822).unwrap();
+        if !(-3600 < o && o < 0) {
+            // `-00mm` loses its sign when parsed: time/3
+            assert_eq!(OffsetDateTime::parse(&rfc, &Rfc2822), Ok(whole), "{rfc}");
+            assert_eq!(OffsetDateTime::parse(&rfc, &Rfc2822).unwrap().offset(), off, "{rfc}");
+        }
+        let jparsed = jiff::fmt::rfc2822::parse(&rfc).unwrap_or_else(|e| panic!("jiff rejects {rfc}: {e}"));
+        assert_eq!(jparsed.timestamp().as_second(), whole.unix_timestamp(), "{rfc}");
+        assert_eq!(jparsed.offset().seconds(), o, "{rfc}");
+        let jtext = jiff::fmt::rfc2822::to_string(&jz.with().subsec_nanosecond(0).build().unwrap()).unwrap();
+        if !(-3600 < o && o < 0) {
+            assert_eq!(OffsetDateTime::parse(&jtext, &Rfc2822), Ok(whole), "{jtext}");
+            assert_eq!(OffsetDateTime::parse(&jtext, &Rfc2822).unwrap().offset(), off, "{jtext}");
+        }
+    }
+}
