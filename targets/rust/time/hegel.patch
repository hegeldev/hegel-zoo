+#[hegel::composite]
+fn arb_description(tc: &hegel::TestCase) -> Vec<usize> {
+    let n = tc.draw(int!(1u8, 8));
+    (0..n).map(|_| tc.draw(int!(0usize, SHARED.len() - 1))).collect()
+}
