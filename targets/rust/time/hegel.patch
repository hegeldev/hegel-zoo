+#[hegel::test]
+fn times_match_the_model(tc: hegel::TestCase) {
+    let T(t) = tc.draw(arb_time());
+    let T(u) = tc.draw(arb_time());
+    let Delta(delta) = tc.draw(arb_delta());
+    let (h, m, s, n) = t.as_hms_nano();
+    let pos = |x: Time| -> i128 {
+        let (h, m, s, n) = x.as_hms_nano();
+        (h as i128 * 3600 + m as i128 * 60 + s as i128) * 1_000_000_000 + n as i128
+    };
+    assert_eq!((t.hour(), t.minute(), t.second(), t.nanosecond()), (h, m, s, n));
+    assert_eq!(t.as_hms(), (h, m, s));
+    assert_eq!(t.as_hms_milli(), (h, m, s, (n / 1_000_000) as u16));
+    assert_eq!(t.as_hms_micro(), (h, m, s, n / 1_000));
+    assert_eq!((t.millisecond(), t.microsecond()), ((n / 1_000_000) as u16, n / 1_000));
+    assert_eq!(Time::from_hms_nano(h, m, s, n), Ok(t));
+    assert_eq!(Time::from_hms(h, m, s), Ok(t.replace_nanosecond(0).unwrap()));
+    assert_eq!(Time::from_hms_milli(h, m, s, (n / 1_000_000) as u16), Ok(t.truncate_to_millisecond()));
+    assert_eq!(Time::from_hms_micro(h, m, s, n / 1_000), Ok(t.truncate_to_microsecond()));
+    assert!(Time::from_hms_nano(24, m, s, n).is_err());
+    assert!(Time::from_hms_nano(h, 60, s, n).is_err());
+    assert!(Time::from_hms_nano(h, m, 60, n).is_err());
+    assert!(Time::from_hms_nano(h, m, s, 1_000_000_000).is_err());
+    assert!(t.replace_hour(24).is_err() && t.replace_minute(60).is_err() && t.replace_second(60).is_err() && t.replace_nanosecond(1_000_000_000).is_err());
+    assert_eq!(t.truncate_to_hour(), Time::from_hms(h, 0, 0).unwrap());
+    assert_eq!(t.truncate_to_minute(), Time::from_hms(h, m, 0).unwrap());
+    assert_eq!(t.truncate_to_second(), Time::from_hms(h, m, s).unwrap());
+    // order and differences
+    assert_eq!(t.cmp(&u), pos(t).cmp(&pos(u)));
+    assert_eq!(delta_nanos(t - u), pos(t) - pos(u), "{t:?} - {u:?}");
+    // `duration_since`/`duration_until` are the forward distance around the clock (0..1 day)
+    let day = 86_400i128 * 1_000_000_000;
+    assert_eq!(delta_nanos(t.duration_since(u)), (pos(t) - pos(u)).rem_euclid(day), "{t:?} since {u:?}");
+    assert_eq!(delta_nanos(t.duration_until(u)), (pos(u) - pos(t)).rem_euclid(day), "{t:?} until {u:?}");
+    assert_eq!(u + t.duration_until(u) - t.duration_until(u), u);
+    // addition wraps around the day
+    assert_eq!(pos(t + delta), (pos(t) + delta_nanos(delta)).rem_euclid(day), "{t:?} + {delta:?}");
+    assert_eq!(pos(t - delta), (pos(t) - delta_nanos(delta)).rem_euclid(day), "{t:?} - {delta:?}");
+    assert_eq!((t + delta) - delta, t);
+    let std = std::time::Duration::new(tc.draw(int!(0u64, 1_000_000)), tc.draw(int!(0u32, 999_999_999)));
+    assert_eq!(pos(t + std), (pos(t) + std.as_nanos() as i128).rem_euclid(day));
+    assert_eq!(pos(t - std), (pos(t) - std.as_nanos() as i128).rem_euclid(day));
+    // formatting round trips
+    let full = desc("[hour]:[minute]:[second].[subsecond digits:9]");
+    let text = t.format(&full).unwrap();
+    assert_eq!(text, format!("{h:02}:{m:02}:{s:02}.{n:09}"));
+    assert_eq!(Time::parse(&text, &full), Ok(t));
+    let short = desc("[hour]:[minute]:[second].[subsecond]");
+    let text = t.format(&short).unwrap();
+    let frac = format!("{n:09}");
+    let frac = frac.trim_end_matches('0');
+    let frac = if frac.is_empty() { "0" } else { frac };
+    assert_eq!(text, format!("{h:02}:{m:02}:{s:02}.{frac}"), "{t:?}");
+    assert_eq!(Time::parse(&text, &short), Ok(t));
+    assert_eq!(t.to_string(), if n == 0 { format!("{h}:{m:02}:{s:02}.0") } else { format!("{h}:{m:02}:{s:02}.{frac}") }, "{t:?}");
+    let ms = desc("[hour]:[minute]:[second].[subsecond digits:3]");
+    assert_eq!(Time::parse(&t.format(&ms).unwrap(), &ms), Ok(t.truncate_to_millisecond()), "{t:?}");
+    let twelve = desc("[hour repr:12]:[minute]:[second] [period]");
+    let text = t.format(&twelve).unwrap();
+    let h12 = if h % 12 == 0 { 12 } else { h % 12 };
+    assert_eq!(text, format!("{h12:02}:{m:02}:{s:02} {}", if h < 12 { "AM" } else { "PM" }));
+    assert_eq!(Time::parse(&text, &twelve), Ok(t.truncate_to_second()), "{text}");
+    let lower = desc("[hour repr:12 padding:none]:[minute] [period case:lower]");
+    assert_eq!(t.format(&lower).unwrap(), format!("{h12}:{m:02} {}", if h < 12 { "am" } else { "pm" }));
+}
