+/// `time` components with their `strftime` equivalents, as jiff prints them.
+const SHARED: &[(&str, &str)] = &[
+    ("[year]", "%Y"),
+    ("[year repr:last_two]", "%y"),
+    ("[month]", "%m"),
+    ("[month padding:none]", "%-m"),
+    ("[month repr:short]", "%b"),
+    ("[month repr:long]", "%B"),
+    ("[day]", "%d"),
+    ("[day padding:space]", "%e"),
+    ("[day padding:none]", "%-d"),
+    ("[ordinal]", "%j"),
+    ("[ordinal padding:none]", "%-j"),
+    ("[weekday]", "%A"),
+    ("[weekday repr:short]", "%a"),
+    ("[weekday repr:sunday one_indexed:false]", "%w"),
+    ("[weekday repr:monday]", "%u"),
+    ("[week_number]", "%V"),
+    ("[week_number repr:sunday]", "%U"),
+    ("[week_number repr:monday]", "%W"),
+    ("[year base:iso_week]", "%G"),
+    ("[hour]", "%H"),
+    ("[hour padding:space]", "%k"),
+    ("[hour repr:12]", "%I"),
+    ("[hour repr:12 padding:space]", "%l"),
+    ("[minute]", "%M"),
+    ("[second]", "%S"),
+    ("[period]", "%p"),
+    ("[period case:lower]", "%P"),
+    ("[offset_hour sign:mandatory][offset_minute]", "%z"),
+    ("[offset_hour sign:mandatory]:[offset_minute]", "%:z"),
+];
