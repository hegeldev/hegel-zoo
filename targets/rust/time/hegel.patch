+/// time/2: `saturating_sub` decides the direction of saturation from `self.seconds > 0`, so a
+/// duration with a zero seconds field minus `MIN` saturates to `MIN` instead of `MAX`.
+#[hegel::test]
+fn saturating_subtraction_saturates_toward_the_result(tc: hegel::TestCase) {
+    let sub = tc.draw(int!(0i32, 999_999_999));
+    let a = SignedDuration::new(0, sub);
+    // a subtrahend at or near `MIN`, so that the seconds overflow
+    let b = SignedDuration::new(i64::MIN + tc.draw(int!(0i64, 1)), -tc.draw(int!(0i32, 999_999_999)));
+    let n = delta_nanos(a) - delta_nanos(b);
+    let expected = if n > delta_nanos(SignedDuration::MAX) {
+        SignedDuration::MAX
+    } else if n < delta_nanos(SignedDuration::MIN) {
+        SignedDuration::MIN
+    } else {
+        SignedDuration::nanoseconds_i128(n)
+    };
+    assert_eq!(a.saturating_sub(b), expected, "{a:?} - {b:?}");
+}
