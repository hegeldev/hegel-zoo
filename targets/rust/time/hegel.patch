+/// time/1: parsing `[week_number repr:sunday]` with a weekday uses the Monday-based adjustment
+/// of January 1st, so the date read back is a day off (or fails) in every year.
+#[hegel::test]
+fn sunday_based_week_numbers_parse_back(tc: hegel::TestCase) {
+    let D(d) = tc.draw(arb_date());
+    let sunday = desc("[year]-[week_number repr:sunday]-[weekday repr:sunday]");
+    let text = d.format(&sunday).unwrap();
+    assert_eq!(Date::parse(&text, &sunday), Ok(d), "{d:?} → {text:?}");
+}
