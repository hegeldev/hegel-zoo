diff --git a/crates/parry2d/tests/common/mod.rs b/crates/parry2d/tests/common/mod.rs
new file mode 100644
index 0000000..1555199
--- /dev/null
+++ b/crates/parry2d/tests/common/mod.rs
@@ -0,0 +1,217 @@
+//! Shared generators for the hegel property-based tests.
+//!
+//! Every generator here is a value built from the binding's combinators
+//! (`one_of!`, `tuples!`, `vecs`, `map`, `filter`); a property draws one small
+//! record (`Placed`, `RayCase`, ...) or tuple and reads its parts. Foreign
+//! geometry types (`Vector`, `Pose`, the shapes) print through `Debug`.
+
+use hegel::generators::{self, Generator as _};
+use hegel::PrintableGenerator;
+use parry2d::math::{Pose, Real, Vector};
+use parry2d::shape::{Ball, Cuboid, Shape, SupportMap, Triangle};
+
+/// A finite float in `lo..=hi`.
+pub fn reals(lo: Real, hi: Real) -> generators::FloatGenerator<Real> {
+    generators::floats::<Real>().min_value(lo).max_value(hi)
+}
+
+/// A finite coordinate spanning several magnitude scales, from "everyday"
+/// values to large-but-finite magnitudes where float robustness issues
+/// (cancellation, overflow) tend to live; shrinks to the everyday scale.
+pub fn coord() -> impl PrintableGenerator<Real> {
+    hegel::one_of!(
+        reals(-10.0, 10.0),
+        reals(-1.0e4, 1.0e4),
+        reals(-1.0e8, 1.0e8),
+    )
+}
+
+/// A vector of two independent coordinates.
+pub fn vector_of(coord: impl PrintableGenerator<Real>, other: impl PrintableGenerator<Real>) -> impl PrintableGenerator<Vector> {
+    hegel::tuples!(coord, other)
+        .map(|(x, y)| Vector::new(x, y))
+        .print_as_debug()
+}
+
+/// A point/vector with multi-scale coordinates (see [`coord`]).
+pub fn vector() -> impl PrintableGenerator<Vector> {
+    vector_of(coord(), coord())
+}
+
+/// A coordinate at "shape scale", so generated shapes keep a moderate size.
+pub fn small_coord() -> generators::FloatGenerator<Real> {
+    reals(-100.0, 100.0)
+}
+
+/// A vector at "shape scale".
+pub fn small_vector() -> impl PrintableGenerator<Vector> {
+    vector_of(small_coord(), small_coord())
+}
+
+/// Any finite vector, up to the extremes of the float range.
+pub fn finite_vector() -> impl PrintableGenerator<Vector> {
+    let finite = || generators::floats::<Real>().allow_nan(false).allow_infinity(false);
+    vector_of(finite(), finite())
+}
+
+/// A strictly positive extent (radius, half-extent, ...) for shape sizes.
+pub fn extent() -> generators::FloatGenerator<Real> {
+    reals(1.0e-3, 100.0)
+}
+
+/// The half-extents of a moderately sized cuboid.
+pub fn half_extents() -> impl PrintableGenerator<Vector> {
+    vector_of(extent(), extent())
+}
+
+/// A moderately sized cuboid.
+pub fn cuboid() -> impl PrintableGenerator<Cuboid> {
+    half_extents().map(Cuboid::new).print_as_debug()
+}
+
+/// A triangle with vertices drawn from `vertex`.
+pub fn triangle_of<V: PrintableGenerator<Vector>>(vertex: impl Fn() -> V) -> impl PrintableGenerator<Triangle> {
+    hegel::tuples!(vertex(), vertex(), vertex())
+        .map(|(a, b, c)| Triangle::new(a, b, c))
+        .print_as_debug()
+}
+
+/// A triangle at shape scale.
+pub fn small_triangle() -> impl PrintableGenerator<Triangle> {
+    triangle_of(small_vector)
+}
+
+/// A rotation angle (many turns, so every orientation is reached).
+pub fn angle() -> generators::FloatGenerator<Real> {
+    reals(-1.0e4, 1.0e4)
+}
+
+/// A pose with the given translation and an arbitrary angle.
+pub fn pose_of(translation: impl PrintableGenerator<Vector>) -> impl PrintableGenerator<Pose> {
+    hegel::tuples!(translation, angle())
+        .map(|(translation, angle)| Pose::new(translation, angle))
+        .print_as_debug()
+}
+
+/// An arbitrary pose with a multi-scale translation.
+pub fn pose() -> impl PrintableGenerator<Pose> {
+    pose_of(vector())
+}
+
+/// A pose whose translation stays at moderate scale (within ±1000).
+pub fn moderate_pose() -> impl PrintableGenerator<Pose> {
+    pose_of(vector_of(reals(-1.0e3, 1.0e3), reals(-1.0e3, 1.0e3)))
+}
+
+/// One of a few simple convex shapes of moderate size.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+pub enum ConvexShape {
+    Ball(#[pretty(debug)] Ball),
+    Cuboid(#[pretty(debug)] Cuboid),
+    Triangle(#[pretty(debug)] Triangle),
+}
+
+impl ConvexShape {
+    pub fn as_shape(&self) -> &dyn Shape {
+        match self {
+            ConvexShape::Ball(s) => s,
+            ConvexShape::Cuboid(s) => s,
+            ConvexShape::Triangle(s) => s,
+        }
+    }
+}
+
+/// A ball, a cuboid or a triangle, the ball first (the simplest to read).
+pub fn shape() -> impl PrintableGenerator<ConvexShape> {
+    hegel::one_of!(
+        extent().map(Ball::new).map(ConvexShape::Ball),
+        cuboid().map(ConvexShape::Cuboid),
+        small_triangle().map(ConvexShape::Triangle),
+    )
+}
+
+/// A shape at a pose.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+pub struct Placed {
+    pub shape: ConvexShape,
+    #[pretty(debug)]
+    pub pose: Pose,
+}
+
+/// A simple convex shape at an arbitrary multi-scale pose.
+pub fn placed() -> impl PrintableGenerator<Placed> {
+    hegel::tuples!(shape(), pose()).map(|(shape, pose)| Placed { shape, pose })
+}
+
+/// A polytope whose support point can be checked against its vertices.
+#[derive(Clone, Debug, hegel::PrettyPrintable)]
+pub enum Polytope {
+    Cuboid(#[pretty(debug)] Cuboid),
+    Triangle(#[pretty(debug)] Triangle),
+    Polygon(#[pretty(debug)] parry2d::shape::ConvexPolygon),
+}
+
+impl Polytope {
+    pub fn vertices(&self) -> Vec<Vector> {
+        match self {
+            Polytope::Cuboid(c) => {
+                let he = c.half_extents;
+                vec![
+                    Vector::new(he.x, he.y),
+                    Vector::new(-he.x, he.y),
+                    Vector::new(-he.x, -he.y),
+                    Vector::new(he.x, -he.y),
+                ]
+            }
+            Polytope::Triangle(t) => t.vertices().to_vec(),
+            Polytope::Polygon(p) => p.points().to_vec(),
+        }
+    }
+
+    pub fn support_point(&self, pose: &Pose, dir: Vector) -> Vector {
+        match self {
+            Polytope::Cuboid(c) => c.support_point(pose, dir),
+            Polytope::Triangle(t) => t.support_point(pose, dir),
+            Polytope::Polygon(p) => p.support_point(pose, dir),
+        }
+    }
+}
+
+/// A cuboid, a triangle, or the convex hull of 3 to 12 points at shape scale
+/// (a degenerate cloud, all collinear say, has no convex polygon and is
+/// filtered out).
+pub fn polytope() -> impl PrintableGenerator<Polytope> {
+    let polygon = generators::vecs(small_vector())
+        .min_size(3)
+        .max_size(12)
+        .map(|pts| parry2d::shape::ConvexPolygon::from_convex_hull(&pts))
+        .filter(Option::is_some)
+        .map(Option::unwrap)
+        .print_as_debug();
+    hegel::one_of!(
+        cuboid().map(Polytope::Cuboid),
+        small_triangle().map(Polytope::Triangle),
+        polygon.map(Polytope::Polygon),
+    )
+}
+
+/// A nonzero direction vector, normalized.
+pub fn unit_vector() -> impl PrintableGenerator<Vector> {
+    small_vector()
+        .filter(|v| v.length() > 1.0e-3)
+        .map(|v| v / v.length())
+        .print_as_debug()
+}
+
+/// Relative tolerance for geometric comparisons at the given magnitude scale.
+pub fn tol(scale: Real) -> Real {
+    1.0e-4 * (1.0 + scale.abs())
+}
+
+/// Relative tolerance for GJK-based query results (distance, closest points,
+/// ray casts) at the given magnitude scale. GJK terminates on a relative
+/// error criterion of roughly `sqrt(10 * EPSILON)` (~1e-3 for f32), so
+/// comparisons of its results need a proportionally looser tolerance.
+pub fn query_tol(scale: Real) -> Real {
+    5.0e-3 * (1.0 + scale.abs())
+}
