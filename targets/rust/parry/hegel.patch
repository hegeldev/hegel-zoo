+/// Property: point projection onto a triangle's boundary is idempotent — the
+/// projected point already lies on the boundary, so projecting it again moves
+/// it (almost) nowhere.
+#[hegel::test]
+fn prop_triangle_projection_is_idempotent(tc: hegel::TestCase) {
+    let (tri, pt) = tc.draw(hegel::tuples!(crate::common::small_triangle(), crate::common::vector()));
+
+    let once = tri.project_local_point(pt, false);
+    let twice = tri.project_local_point(once.point, false);
+
+    let tol = crate::common::tol(once.point.abs().max_element());
+    assert!(
+        once.point.distance(twice.point) <= tol,
+        "re-projecting {:?} moved it to {:?} (tol = {tol})",
+        once.point,
+        twice.point
+    );
+}
diff --git a/crates/parry2d/tests/query/shape_query_consistency.rs b/crates/parry2d/tests/query/shape_query_consistency.rs
new file mode 100644
index 0000000..a3ea797
--- /dev/null
+++ b/crates/parry2d/tests/query/shape_query_consistency.rs
@@ -0,0 +1,140 @@
+use parry2d::math::{Pose, Vector};
+use parry2d::query;
+use parry2d::shape::{Cuboid, Triangle};
+
+use crate::common::{self, ConvexShape};
+
+/// Formerly a KNOWN FAILURE: `query::distance` overestimated the distance between two
+/// separated cuboids whenever their closest features are two parallel faces
+/// of different spans.
+///
+/// The dispatcher routes cuboid-cuboid `distance()` to
+/// `distance_cuboid_cuboid`, which takes its witness points from
+/// `closest_points_cuboid_cuboid`. That routine projects the *support point*
+/// of one cuboid along the separating face normal onto the other cuboid
+/// ("for simplicity", per the comment in
+/// `src/query/closest_points/closest_points_cuboid_cuboid.rs`). The support
+/// point is a face corner, so when that corner lies outside the opposing
+/// face's span the witness pair is not the closest pair and the reported
+/// distance is too large — by an unbounded margin as the size mismatch grows.
+/// `closest_points()` itself is unaffected because its cuboid-cuboid
+/// specialization is commented out in `DefaultQueryDispatcher`, so it falls
+/// back to (correct) GJK. The result is also asymmetric:
+/// `distance(a, b) != distance(b, a)`.
+///
+/// Found by `prop_distance_is_symmetric`. Fixed upstream in 0.30.1 ("Fix
+/// incorrect `closest_points_cuboid_cuboid` closest points"); the property
+/// checks cuboid-cuboid pairs again and this pin stays as the regression test.
+#[test]
+fn known_failure_distance_cuboid_cuboid_face_face_overestimate() {
+    let c1 = Cuboid::new(Vector::new(1.0, 1.0));
+    let c2 = Cuboid::new(Vector::new(1.0, 2.0));
+    let p1 = Pose::identity();
+    let p2 = Pose::new(Vector::new(-5.573167, 0.0), 0.0);
+
+    // The faces at x = -1 (of c1) and x = -4.573167 (of c2) are parallel and
+    // overlap in y, so the true distance is the gap along x.
+    let expected = 5.573167 - 1.0 - 1.0;
+
+    let d12 = query::distance(&p1, &c1, &p2, &c2).unwrap().distance;
+    let d21 = query::distance(&p2, &c2, &p1, &c1).unwrap().distance;
+
+    // Currently d12 = 3.710461 (= sqrt(expected^2 + 1), the distance to the
+    // projected corner) while d21 = 3.5731668 (correct).
+    assert!(
+        (d12 - expected).abs() <= 1.0e-3 && (d21 - expected).abs() <= 1.0e-3,
+        "cuboid-cuboid distance is wrong/asymmetric: d12 = {d12}, d21 = {d21}, expected = {expected}"
+    );
+}
+
+/// Property: `distance(a, b) == distance(b, a)` (up to the GJK termination
+/// tolerance) for arbitrary pairs of simple convex shapes at arbitrary poses.
+#[hegel::test]
+fn prop_distance_is_symmetric(tc: hegel::TestCase) {
+    let (a, b) = tc.draw(hegel::tuples!(common::placed(), common::placed()));
+    let (g1, pos1, g2, pos2) = (a.shape.as_shape(), a.pose, b.shape.as_shape(), b.pose);
+
+    // since upstream 3383f51 distance() returns a ShapeDistance carrying the sub-shape ids
+    let d12 = query::distance(&pos1, g1, &pos2, g2).unwrap().distance;
+    let d21 = query::distance(&pos2, g2, &pos1, g1).unwrap().distance;
+
+    let scale = pos1.translation.length() + pos2.translation.length();
+    let tol = common::query_tol(scale);
+    assert!(
+        (d12 - d21).abs() <= tol,
+        "distance(g1, g2) = {d12} but distance(g2, g1) = {d21} (tol = {tol})"
+    );
+}
+
+/// KNOWN FAILURE (parry/4): in 2D, `intersection_test` between a cuboid and a triangle is a
+/// separating-axis test over the cuboid's axes and the triangle's edge normals, and
+/// `sat::triangle_support_map_find_local_separating_normal_oneway` tries each edge's
+/// `Segment::normal()`, the counterclockwise normal, in that one direction only
+/// (src/query/sat/sat_cuboid_triangle.rs). For a clockwise triangle those normals point
+/// inward, so when the only separating axis is a triangle edge normal the pair is reported
+/// intersecting although `distance` finds the gap; the same vertices wound counterclockwise
+/// are handled right, as is a `ConvexPolygon` of them (GJK).
+#[test]
+fn known_failure_cuboid_clockwise_triangle_reported_intersecting_while_apart() {
+    let cuboid = Cuboid::new(Vector::new(1.0, 1.0));
+    let cw = Triangle::new(Vector::new(0.0, 2.0), Vector::new(0.0, 3.0), Vector::new(2.0, 1.0));
+    let ccw = Triangle::new(cw.a, cw.c, cw.b);
+    let p = Pose::identity();
+    let dist = query::distance(&p, &cuboid, &p, &cw).unwrap().distance;
+    let cw_hit = query::intersection_test(&p, &cuboid, &p, &cw).unwrap().intersecting;
+    let ccw_hit = query::intersection_test(&p, &cuboid, &p, &ccw).unwrap().intersecting;
+    assert!(dist > 0.4 && !ccw_hit, "the pair should be about 0.447 apart (distance {dist}, counterclockwise intersecting {ccw_hit})");
+    assert!(
+        !cw_hit,
+        "cuboid (1, 1) and the clockwise triangle (0,2), (0,3), (2,1) are {dist} apart, but intersection_test reports {cw_hit} (counterclockwise winding: {ccw_hit})"
+    );
+}
+
+/// candidate/rust/parry-2: in 2D, `intersection_test_cuboid_triangle` is a SAT over the
+/// cuboid's axes and the triangle's edge normals, and
+/// `sat::triangle_support_map_find_local_separating_normal_oneway` tests each edge's
+/// `Segment::normal()` (the counterclockwise normal) in that one direction only
+/// (src/query/sat/sat_cuboid_triangle.rs). For a clockwise triangle those normals point
+/// inward, so when the only separating axis is a triangle edge normal the pair is reported
+/// intersecting: cuboid half-extents (1, 1) at the origin against the triangle (0,2), (0,3),
+/// (2,1) is `intersecting = true` with `distance = 0.4472` (and `closest_points` finds the
+/// gap); the same triangle wound counterclockwise, (0,2), (2,1), (0,3), is not intersecting.
+/// A `ConvexPolygon` of the same vertices (GJK) is right too.
+fn cuboid_meets_clockwise_triangle(a: &ConvexShape, b: &ConvexShape) -> bool {
+    let clockwise = |t: &Triangle| (t.b - t.a).perp_dot(t.c - t.a) < 0.0;
+    match (a, b) {
+        (ConvexShape::Cuboid(_), ConvexShape::Triangle(t))
+        | (ConvexShape::Triangle(t), ConvexShape::Cuboid(_)) => clockwise(t),
+        _ => false,
+    }
+}
+
+/// Property: if `intersection_test` reports an intersection, then the
+/// distance between the two shapes is ~0 (within the GJK termination
+/// tolerance). Also, reported distances are always non-negative and finite.
+#[hegel::test]
+fn prop_intersection_implies_zero_distance(tc: hegel::TestCase) {
+    let (a, b) = tc.draw(hegel::tuples!(common::placed(), common::placed()));
+    let (g1, pos1, g2, pos2) = (a.shape.as_shape(), a.pose, b.shape.as_shape(), b.pose);
+
+    let intersecting = query::intersection_test(&pos1, g1, &pos2, g2).unwrap().intersecting;
+    // candidate/rust/parry-2: a cuboid and a clockwise triangle can be reported intersecting
+    // while separated (see `cuboid_meets_clockwise_triangle`); the pairs it reports
+    // intersecting are skipped, every other pair is checked.
+    tc.assume(!(intersecting && cuboid_meets_clockwise_triangle(&a.shape, &b.shape)));
+    let dist = query::distance(&pos1, g1, &pos2, g2).unwrap().distance;
+
+    assert!(
+        dist >= 0.0 && dist.is_finite(),
+        "invalid distance {dist} between finite shapes"
+    );
+
+    let scale = pos1.translation.length() + pos2.translation.length();
+    let tol = common::query_tol(scale);
+    if intersecting {
+        assert!(
+            dist <= tol,
+            "shapes reported intersecting but distance = {dist} (tol = {tol})"
+        );
+    }
+}
