+/// Property: point projection onto a triangle's boundary is idempotent — the
+/// projected point already lies on the boundary, so projecting it again moves
+/// it (almost) nowhere.
+#[hegel::test]
+fn prop_triangle_projection_is_idempotent(tc: hegel::TestCase) {
+    let tri = Triangle::new(
+        crate::common::small_vector(&tc),
+        crate::common::small_vector(&tc),
+        crate::common::small_vector(&tc),
+    );
+    let pt = crate::common::vector(&tc);
+
+    let once = tri.project_local_point(pt, false);
+    let twice = tri.project_local_point(once.point, false);
+
+    let tol = crate::common::tol(once.point.abs().max_element());
+    assert!(
+        once.point.distance(twice.point) <= tol,
+        "re-projecting {:?} moved it to {:?} (tol = {tol})",
+        once.point,
+        twice.point
+    );
+}
