+/// Property: the distance between a ball and a cuboid matches the analytic
+/// oracle `max(0, |max(|c| - half_extents, 0)| - radius)`, where `c` is the
+/// ball's center expressed in the cuboid's local frame.
+#[hegel::test]
+fn prop_ball_cuboid_distance_matches_analytic_oracle(tc: hegel::TestCase) {
+    let (radius, cuboid, ball_pos, cuboid_pos) = tc.draw(hegel::tuples!(
+        crate::common::extent(),
+        crate::common::cuboid(),
+        crate::common::pose(),
+        crate::common::pose(),
+    ));
+    let ball = Ball::new(radius);
+    let cuboid_he = cuboid.half_extents;
+
+    // Ball center in the cuboid's local frame.
+    let center = cuboid_pos.inv_mul(&ball_pos).translation;
+    let expected = ((center.abs() - cuboid_he).max(Vector::ZERO).length() - ball.radius).max(0.0);
+
+    let dist = query::distance(&ball_pos, &ball, &cuboid_pos, &cuboid).unwrap().distance;
+
+    let scale = ball_pos.translation.length() + cuboid_pos.translation.length();
+    let tol = crate::common::query_tol(scale);
+    assert!(
+        (dist - expected).abs() <= tol,
+        "query::distance = {dist}, analytic oracle = {expected} (tol = {tol})"
+    );
+}
