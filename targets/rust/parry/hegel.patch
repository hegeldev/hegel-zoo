+/// KNOWN FAILURE (parry/3): in 2D, `Triangle::cast_ray(solid = true)` decides that the ray
+/// origin is inside the triangle when the three edge `perp_dot(origin - a) > 0` signs agree
+/// (src/query/ray/ray_triangle.rs). For a zero-area triangle every perp_dot of an origin on
+/// its supporting line is 0 (for a point triangle, of every origin), so the signs agree and
+/// the cast reports `t = 0` for an origin that is not on the shape at all; the non-solid cast
+/// of the same ray is `None`, as it should be.
+#[test]
+fn known_failure_zero_area_triangle_solid_raycast_claims_origin_inside() {
+    let tri = Triangle::new(Vector::ZERO, Vector::ZERO, Vector::new(1.0, 0.0));
+    // From (5, 0), pointing away from the segment the triangle degenerates to: nothing is hit.
+    let ray = Ray::new(Vector::new(5.0, 0.0), Vector::new(1.0, 0.0));
+    let cast = tri.cast_ray(&Pose::identity(), &ray, Real::MAX, true);
+    assert_eq!(
+        cast, None,
+        "zero-area triangle a = b = (0, 0), c = (1, 0): a solid ray cast from (5, 0) pointing away reported {cast:?}"
+    );
+}
+
+/// candidate/rust/parry-1: in 2D, `Triangle::cast_local_ray_and_get_normal(solid = true)`
+/// decides "the origin is inside" from the three edge `perp_dot(origin - a) > 0` signs being
+/// equal (src/query/ray/ray_triangle.rs). For a zero-area triangle every perp_dot of an origin
+/// on its supporting line is 0 (for a point-triangle, of every origin), so the signs are equal
+/// and the cast reports `t = 0` for an origin that is not on the shape (a=b=c=(0,0), ray from
+/// (0,1): `Some(0.0)`, the origin 1 away; a=b=(0,0), c=(1,0), ray from (5,0): `Some(0.0)`, 4
+/// away). This is exactly that branch's condition, restricted to zero-area triangles.
+fn zero_area_triangle_claims_inside(tri: &Triangle, local_origin: Vector) -> bool {
+    let zero_area = (tri.b - tri.a).perp_dot(tri.c - tri.a) == 0.0;
+    let signs = tri
+        .edges()
+        .map(|e| e.scaled_direction().perp_dot(local_origin - e.a) > 0.0);
+    zero_area && signs[0] == signs[1] && signs[1] == signs[2]
+}
+
+/// Property: if a solid ray cast reports a hit at time `t`, then `t` is
+/// finite and non-negative, and the hit point `ray.point_at(t)` lies on the
+/// shape (its distance to the shape is ~0 relative to the coordinate scale).
+#[hegel::test]
+fn prop_raycast_hit_point_lies_on_shape(tc: hegel::TestCase) {
+    let (common::Placed { shape, pose }, origin, dir) =
+        tc.draw(hegel::tuples!(common::placed(), common::vector(), common::unit_vector()));
+    if let common::ConvexShape::Triangle(tri) = &shape {
+        // candidate/rust/parry-1: a zero-area triangle claims the ray origin is inside
+        // (see `zero_area_triangle_claims_inside`); 4.8% of cases, measured.
+        tc.assume(!zero_area_triangle_claims_inside(tri, pose.inverse() * origin));
+    }
+    let shape = shape.as_shape();
+    let ray = Ray::new(origin, dir);
+
+    if let Some(t) = shape.cast_ray(&pose, &ray, Real::MAX, true) {
+        assert!(t.is_finite() && t >= 0.0, "invalid time of impact {t}");
+
+        let hit = ray.point_at(t);
+        let scale = origin.length() + hit.abs().max_element() + pose.translation.length();
+        let dist = shape.distance_to_point(&pose, hit, true);
+        assert!(
+            dist <= common::query_tol(scale),
+            "hit point {hit:?} at t = {t} is {dist} away from the shape (tol = {})",
+            common::query_tol(scale)
+        );
+    }
+}
+
+/// Property: a solid ray cast whose origin is inside the shape reports a hit
+/// at exactly `t = 0` (the documented semantics of `solid = true`).
+///
+/// The pose translation and cuboid extents are kept at scales where the
+/// inside-point construction itself cannot drift outside the cuboid through
+/// float rounding — this bound protects the test's construction, not the
+/// library's contract.
+#[hegel::test]
+fn prop_solid_raycast_from_inside_starts_at_zero(tc: hegel::TestCase) {
+    // Half-extents of at least 1, a moderate pose, the origin as a fraction of
+    // the half-extents (at most 90% of the way to the boundary), a direction.
+    let fraction = || common::reals(-0.9, 0.9);
+    let (he, pose, f, dir) = tc.draw(hegel::tuples!(
+        common::vector_of(common::reals(1.0, 100.0), common::reals(1.0, 100.0)),
+        common::moderate_pose(),
+        common::vector_of(fraction(), fraction()),
+        common::unit_vector(),
+    ));
+    let cuboid = Cuboid::new(he);
+    let origin = pose * (he * f);
+
+    let ray = Ray::new(origin, dir);
+    let cast = cuboid.cast_ray(&pose, &ray, Real::MAX, true);
+    assert_eq!(
+        cast,
+        Some(0.0),
+        "solid ray cast from inside point {origin:?} did not report t = 0"
+    );
+}
