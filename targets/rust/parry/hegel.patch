@@ -0,0 +1,65 @@
+use hegel::generators;
+use parry2d::math::{Real, Vector};
+use parry2d::shape::{ConvexPolygon, Cuboid, SupportMap, Triangle};
+
+use crate::common;
+
+/// Property: the support point of a transformed convex shape attains the
+/// maximum dot product with the query direction over all of the shape's
+/// (transformed) vertices — checked against a brute-force scan of the
+/// vertices.
+#[hegel::test]
+fn prop_support_point_maximizes_dot_product(tc: hegel::TestCase) {
+    let pose = common::moderate_pose(&tc);
+    let dir = common::unit_vector(&tc);
+
+    let kind = tc.draw(generators::integers::<u8>().max_value(2));
+    let (vertices, support): (Vec<Vector>, Vector) = match kind {
+        0 => {
+            let n = tc.draw(generators::integers::<usize>().min_value(3).max_value(12));
+            let mut pts = Vec::with_capacity(n);
+            for _ in 0..n {
+                pts.push(common::small_vector(&tc));
+            }
+            // Degenerate point clouds (e.g. all collinear) have no convex
+            // polygon; skip those cases.
+            let Some(poly) = ConvexPolygon::from_convex_hull(&pts) else {
+                tc.reject();
+            };
+            let support = poly.support_point(&pose, dir);
+            (poly.points().to_vec(), support)
+        }
+        1 => {
+            let he = Vector::new(common::extent(&tc), common::extent(&tc));
+            let cuboid = Cuboid::new(he);
+            let corners = vec![
+                Vector::new(he.x, he.y),
+                Vector::new(-he.x, he.y),
+                Vector::new(-he.x, -he.y),
+                Vector::new(he.x, -he.y),
+            ];
+            (corners, cuboid.support_point(&pose, dir))
+        }
+        _ => {
+            let tri = Triangle::new(
+                common::small_vector(&tc),
+                common::small_vector(&tc),
+                common::small_vector(&tc),
+            );
+            (tri.vertices().to_vec(), tri.support_point(&pose, dir))
+        }
+    };
+
+    let max_dot = vertices
+        .iter()
+        .map(|v| (pose * *v).dot(dir))
+        .fold(Real::NEG_INFINITY, Real::max);
+    let support_dot = support.dot(dir);
+
+    let tol = common::tol(pose.translation.length() + 100.0);
+    assert!(
+        (support_dot - max_dot).abs() <= tol,
+        "support point {support:?} has dot {support_dot} along {dir:?}, \
+         brute-force max over vertices is {max_dot} (tol = {tol})"
+    );
+}
