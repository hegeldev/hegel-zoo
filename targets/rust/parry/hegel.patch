new file mode 100644
index 0000000..115e289
--- /dev/null
+++ b/crates/parry2d/tests/common/mod.rs
@@ -0,0 +1,110 @@
+//! Shared generator helpers for the hegel property-based tests.
+
+use hegel::generators;
+use parry2d::math::{Pose, Real, Vector};
+use parry2d::shape::{Ball, Cuboid, Shape, Triangle};
+
+/// Draws a finite coordinate spanning several magnitude scales, from
+/// "everyday" values to large-but-finite magnitudes where float robustness
+/// issues (cancellation, overflow) tend to live.
+pub fn coord(tc: &hegel::TestCase) -> Real {
+    tc.draw(hegel::one_of!(
+        generators::floats::<Real>().min_value(-10.0).max_value(10.0),
+        generators::floats::<Real>().min_value(-1.0e4).max_value(1.0e4),
+        generators::floats::<Real>().min_value(-1.0e8).max_value(1.0e8),
+    ))
+}
+
+/// A point/vector with multi-scale coordinates (see [`coord`]).
+pub fn vector(tc: &hegel::TestCase) -> Vector {
+    Vector::new(coord(tc), coord(tc))
+}
+
+/// A coordinate at "shape scale", so generated shapes keep a moderate size.
+pub fn small_coord(tc: &hegel::TestCase) -> Real {
+    tc.draw(
+        generators::floats::<Real>()
+            .min_value(-100.0)
+            .max_value(100.0),
+    )
+}
+
+/// A vector at "shape scale".
+pub fn small_vector(tc: &hegel::TestCase) -> Vector {
+    Vector::new(small_coord(tc), small_coord(tc))
+}
+
+/// A strictly positive extent (radius, half-extent, ...) for shape sizes.
+pub fn extent(tc: &hegel::TestCase) -> Real {
+    tc.draw(
+        generators::floats::<Real>()
+            .min_value(1.0e-3)
+            .max_value(100.0),
+    )
+}
+
+/// An arbitrary pose with a multi-scale translation.
+pub fn pose(tc: &hegel::TestCase) -> Pose {
+    let translation = vector(tc);
+    let angle = tc.draw(
+        generators::floats::<Real>()
+            .min_value(-1.0e4)
+            .max_value(1.0e4),
+    );
+    Pose::new(translation, angle)
+}
+
+/// A pose whose translation stays at moderate scale (within ±1000).
+pub fn moderate_pose(tc: &hegel::TestCase) -> Pose {
+    let translation = Vector::new(
+        tc.draw(
+            generators::floats::<Real>()
+                .min_value(-1.0e3)
+                .max_value(1.0e3),
+        ),
+        tc.draw(
+            generators::floats::<Real>()
+                .min_value(-1.0e3)
+                .max_value(1.0e3),
+        ),
+    );
+    let angle = tc.draw(
+        generators::floats::<Real>()
+            .min_value(-1.0e4)
+            .max_value(1.0e4),
+    );
+    Pose::new(translation, angle)
+}
+
+/// Draws one of a few simple convex shapes of moderate size.
+pub fn shape(tc: &hegel::TestCase) -> Box<dyn Shape> {
+    match tc.draw(generators::integers::<u8>().max_value(2)) {
+        0 => Box::new(Ball::new(extent(tc))),
+        1 => Box::new(Cuboid::new(Vector::new(extent(tc), extent(tc)))),
+        _ => Box::new(Triangle::new(
+            small_vector(tc),
+            small_vector(tc),
+            small_vector(tc),
+        )),
+    }
+}
+
+/// A nonzero direction vector, normalized.
+pub fn unit_vector(tc: &hegel::TestCase) -> Vector {
+    let v = small_vector(tc);
+    tc.assume(v.length() > 1.0e-3);
+    v / v.length()
+}
+
+/// Relative tolerance for geometric comparisons at the given magnitude scale.
+pub fn tol(scale: Real) -> Real {
+    1.0e-4 * (1.0 + scale.abs())
+}
+
+/// Relative tolerance for GJK-based query results (distance, closest points,
+/// ray casts) at the given magnitude scale. GJK terminates on a relative
+/// error criterion of roughly `sqrt(10 * EPSILON)` (~1e-3 for f32), so
+/// comparisons of its results need a proportionally looser tolerance.
+pub fn query_tol(scale: Real) -> Real {
+    5.0e-3 * (1.0 + scale.abs())
+}
