@@ -0,0 +1,57 @@
+use parry2d::math::Vector;
+use parry2d::query::PointQuery;
+
+use crate::common;
+
+/// Property: projecting a point onto a solid cuboid matches the independent
+/// clamp oracle — the projection is the componentwise clamp of the point to
+/// the cuboid's half-extents, and `is_inside` agrees with a componentwise
+/// containment check (points too close to the boundary for float comparisons
+/// are exempted from the flag check only).
+#[hegel::test]
+fn prop_cuboid_solid_projection_matches_clamp_oracle(tc: hegel::TestCase) {
+    let (cuboid, pt) = tc.draw(hegel::tuples!(common::cuboid(), common::vector()));
+    let he = cuboid.half_extents;
+
+    let proj = cuboid.project_local_point(pt, true);
+
+    let expected = pt.clamp(-he, he);
+    let tol = common::tol(pt.abs().max_element());
+    assert!(
+        proj.point.distance(expected) <= tol,
+        "projection {:?} differs from clamp oracle {expected:?} (tol = {tol})",
+        proj.point
+    );
+
+    // The inside flag must agree with the oracle whenever the point is not
+    // within float-comparison distance of the boundary.
+    let boundary_margin = (he.x - pt.x.abs()).min(he.y - pt.y.abs());
+    if boundary_margin > tol {
+        assert!(
+            proj.is_inside,
+            "point {pt:?} inside cuboid {he:?} not flagged inside"
+        );
+    } else if boundary_margin < -tol {
+        assert!(
+            !proj.is_inside,
+            "point {pt:?} outside cuboid {he:?} flagged inside"
+        );
+    }
+}
+
+/// Property: the distance from a point to a solid cuboid matches the
+/// independent clamp oracle `|max(|pt| - half_extents, 0)|`.
+#[hegel::test]
+fn prop_cuboid_distance_to_point_matches_clamp_oracle(tc: hegel::TestCase) {
+    let (cuboid, pt) = tc.draw(hegel::tuples!(common::cuboid(), common::vector()));
+    let he = cuboid.half_extents;
+
+    let expected = (pt.abs() - he).max(Vector::ZERO).length();
+    let dist = cuboid.distance_to_local_point(pt, true);
+
+    let tol = common::tol(pt.abs().max_element());
+    assert!(
+        (dist - expected).abs() <= tol,
+        "distance_to_local_point = {dist}, clamp oracle = {expected} (tol = {tol})"
+    );
+}
