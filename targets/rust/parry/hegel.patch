+/// Property: an AABB built from a set of points contains every one of those
+/// points, and its bounds are finite for finite input — including points at
+/// the extremes of the finite float range (min/max are overflow-free, so the
+/// full range is in-domain here).
+#[hegel::test]
+fn prop_aabb_from_points_contains_points(tc: hegel::TestCase) {
+    let pts = tc.draw(generators::vecs(common::finite_vector()).min_size(1).max_size(32));
+
+    let aabb = Aabb::from_points(pts.iter().copied());
+
+    assert!(
+        aabb.mins.is_finite() && aabb.maxs.is_finite(),
+        "non-finite AABB {aabb:?} from finite points {pts:?}"
+    );
+    for p in &pts {
+        assert!(
+            aabb.contains_local_point(*p),
+            "point {p:?} not contained in its own AABB {aabb:?}"
+        );
+    }
+}
+
+/// Property: the world-space AABB of a transformed shape contains all of the
+/// shape's transformed vertices (within a scale-relative tolerance).
+#[hegel::test]
+fn prop_compute_aabb_contains_transformed_triangle_vertices(tc: hegel::TestCase) {
+    // A triangle with multi-scale vertices (not the shape-scale one), at a pose.
+    let (tri, pose) = tc.draw(hegel::tuples!(common::triangle_of(common::vector), common::pose()));
+
+    let aabb = tri.compute_aabb(&pose);
+
+    for v in tri.vertices() {
+        let w = pose * *v;
+        let tol = common::tol(w.abs().max_element() + pose.translation.length());
+        assert!(
+            w.x >= aabb.mins.x - tol
+                && w.x <= aabb.maxs.x + tol
+                && w.y >= aabb.mins.y - tol
+                && w.y <= aabb.maxs.y + tol,
+            "transformed vertex {w:?} outside compute_aabb result {aabb:?} (tol = {tol})"
+        );
+    }
+}
