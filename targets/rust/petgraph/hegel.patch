+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use hegel::generators;
+use hegel::Generator;
+use petgraph::algo::connected_components;
+use petgraph::data::FromElements;
+use petgraph::visit::EdgeRef;
+
+/// Generate an arbitrary undirected graph with `u32` edge weights. Parallel
+/// edges and self loops are included on purpose (both are allowed by `Graph`).
+#[hegel::composite]
+fn arb_ungraph(tc: &hegel::TestCase, max_nodes: usize) -> UnGraph<(), u32> {
+    let n = tc.draw(generators::integers::<usize>().max_value(max_nodes));
+    let mut g = UnGraph::<(), u32>::new_undirected();
+    for _ in 0..n {
+        g.add_node(());
+    }
+    if n > 0 {
+        let m = tc.draw(generators::integers::<usize>().max_value(4 * n));
+        let edges: Vec<(usize, usize, u32)> = tc.draw(
+            generators::vecs(generators::tuples!(
+                generators::integers::<usize>().max_value(n - 1),
+                generators::integers::<usize>().max_value(n - 1),
+                generators::integers::<u32>(),
+            ))
+            .min_size(m)
+            .max_size(m),
+        );
+        for (a, b, w) in edges {
+            g.add_edge(NodeIndex::new(a), NodeIndex::new(b), w);
+        }
+    }
+    g
+}
+
+/// Generate a *connected* undirected graph by construction: node i > 0 gets an
+/// edge to some earlier node, then extra arbitrary edges are added on top.
+#[hegel::composite]
+fn arb_connected_ungraph(tc: &hegel::TestCase, max_nodes: usize) -> UnGraph<(), u32> {
+    let n = tc.draw(
+        generators::integers::<usize>()
+            .min_value(1)
+            .max_value(max_nodes),
+    );
+    let mut g = UnGraph::<(), u32>::new_undirected();
+    for _ in 0..n {
+        g.add_node(());
+    }
+    for i in 1..n {
+        let j = tc.draw(generators::integers::<usize>().max_value(i - 1));
+        let w = tc.draw(generators::integers::<u32>());
+        g.add_edge(NodeIndex::new(j), NodeIndex::new(i), w);
+    }
+    let m = tc.draw(generators::integers::<usize>().max_value(2 * n));
+    let extra: Vec<(usize, usize, u32)> = tc.draw(
+        generators::vecs(generators::tuples!(
+            generators::integers::<usize>().max_value(n - 1),
+            generators::integers::<usize>().max_value(n - 1),
+            generators::integers::<u32>(),
+        ))
+        .min_size(m)
+        .max_size(m),
+    );
+    for (a, b, w) in extra {
+        g.add_edge(NodeIndex::new(a), NodeIndex::new(b), w);
+    }
+    g
+}
+
+/// Property: `min_spanning_tree` (Kruskal) produces a spanning forest of the
+/// input: same node set, exactly `|V| - c` edges where `c` is the number of
+/// connected components, the same components, and every output edge exists in
+/// the input with the same weight (witness check). Grounded in the docs
+/// ("minimum spanning forest") and the doc example's count assertions.
+#[hegel::test]
+fn prop_min_spanning_tree_is_spanning_forest(tc: hegel::TestCase) {
+    let g = tc.draw((arb_ungraph(64)).print_as_debug());
+    let mst: UnGraph<(), u32> = UnGraph::from_elements(min_spanning_tree(&g));
+    assert_eq!(mst.node_count(), g.node_count(), "node set must be preserved");
+    let components = connected_components(&g);
+    assert_eq!(
+        mst.edge_count(),
+        g.node_count() - components,
+        "a spanning forest has |V| - c edges"
+    );
+    assert_eq!(
+        connected_components(&mst),
+        components,
+        "forest must connect exactly what the input connects"
+    );
+    for e in mst.edge_references() {
+        assert!(
+            g.edges_connecting(e.source(), e.target())
+                .any(|ge| ge.weight() == e.weight()),
+            "MST edge {:?} -> {:?} (weight {}) not in input graph",
+            e.source(),
+            e.target(),
+            e.weight()
+        );
+    }
+}
+
+/// Property: Kruskal (`min_spanning_tree`) and Prim (`min_spanning_tree_prim`)
+/// agree on the total weight of the minimum spanning tree of a connected
+/// graph (all MSTs of a graph have the same total weight). Prim documents it
+/// only supports a single component, so the generator builds connected graphs
+/// by construction.
+#[hegel::test]
+fn prop_kruskal_and_prim_agree_on_total_weight(tc: hegel::TestCase) {
+    let g = tc.draw((arb_connected_ungraph(64)).print_as_debug());
+    let kruskal: UnGraph<(), u32> = UnGraph::from_elements(min_spanning_tree(&g));
+    let prim: UnGraph<(), u32> = UnGraph::from_elements(min_spanning_tree_prim(&g));
+    assert_eq!(kruskal.edge_count(), g.node_count() - 1);
+    assert_eq!(prim.edge_count(), g.node_count() - 1);
+    let total = |t: &UnGraph<(), u32>| -> u64 {
+        t.edge_references().map(|e| u64::from(*e.weight())).sum()
+    };
+    assert_eq!(
+        total(&kruskal),
+        total(&prim),
+        "Kruskal and Prim disagree on MST total weight"
+    );
+}
