+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use std::collections::{BTreeSet, HashSet};
+
+use hegel::generators;
+use hegel::Generator;
+use petgraph::visit::EdgeRef;
+
+/// Generate an arbitrary *simple* undirected graph (no self loops, no parallel
+/// edges) — the graph6 format only represents simple undirected graphs.
+/// Node counts cross the 63-node boundary where the graph6 order encoding
+/// switches to its multi-byte form.
+#[hegel::composite]
+fn arb_simple_ungraph(tc: &hegel::TestCase) -> Graph<(), (), Undirected> {
+    let n = tc.draw(generators::integers::<usize>().max_value(80));
+    let mut g: Graph<(), (), Undirected> = Graph::default();
+    for _ in 0..n {
+        g.add_node(());
+    }
+    if n >= 2 {
+        let m = tc.draw(generators::integers::<usize>().max_value(3 * n));
+        let candidates: Vec<(usize, usize)> = tc.draw(
+            generators::vecs(generators::tuples!(
+                generators::integers::<usize>().max_value(n - 1),
+                generators::integers::<usize>().max_value(n - 1),
+            ))
+            .min_size(m)
+            .max_size(m),
+        );
+        let mut seen = HashSet::new();
+        for (a, b) in candidates {
+            if a == b {
+                continue; // no self loops in a simple graph
+            }
+            let key = (a.min(b), a.max(b));
+            if seen.insert(key) {
+                g.add_edge(
+                    petgraph::graph::NodeIndex::new(key.0),
+                    petgraph::graph::NodeIndex::new(key.1),
+                    (),
+                );
+            }
+        }
+    }
+    g
+}
+
+/// Property: encoding a simple undirected graph to graph6 and decoding it back
+/// preserves the node count and the edge set (round-trip). Grounded in the
+/// module docs (graph6 encoder/decoder for undirected graphs) and the paired
+/// `ToGraph6`/`FromGraph6` traits.
+#[hegel::test]
+fn prop_graph6_roundtrip(tc: hegel::TestCase) {
+    let g = tc.draw((arb_simple_ungraph()).print_as_debug());
+    let encoded = g.graph6_string();
+    let decoded: Graph<(), (), Undirected> = Graph::from_graph6_string(encoded.clone());
+    let edge_set = |g: &Graph<(), (), Undirected>| -> BTreeSet<(usize, usize)> {
+        g.edge_references()
+            .map(|e| {
+                let (a, b) = (e.source().index(), e.target().index());
+                (a.min(b), a.max(b))
+            })
+            .collect()
+    };
+    assert_eq!(
+        decoded.node_count(),
+        g.node_count(),
+        "node count not preserved by graph6 round-trip (encoded: {:?})",
+        encoded
+    );
+    assert_eq!(
+        edge_set(&decoded),
+        edge_set(&g),
+        "edge set not preserved by graph6 round-trip (encoded: {:?})",
+        encoded
+    );
+}
