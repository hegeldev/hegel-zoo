+// ---------------------------------------------------------------------------
+// Property-based tests (hegel)
+// ---------------------------------------------------------------------------
+
+use hegel::TestCase;
+use hegel::generators;
+use hegel::Generator;
+// Aliased because this file already has unit tests *named* `is_cyclic_directed`
+// and `tarjan_scc` in the same value namespace.
+use petgraph::algo::{
+    connected_components, is_cyclic_directed as algo_is_cyclic_directed, kosaraju_scc,
+    tarjan_scc as algo_tarjan_scc, toposort,
+};
+use petgraph::visit::EdgeRef;
+
+/// Generate an arbitrary directed graph with `min_nodes..=max_nodes` nodes and
+/// arbitrary `u32` edge weights. Parallel edges and self loops are included on
+/// purpose — `Graph` documents that it supports both.
+#[hegel::composite]
+fn arb_digraph(tc: &hegel::TestCase, min_nodes: usize, max_nodes: usize) -> DiGraph<(), u32> {
+    let n = tc.draw(
+        generators::integers::<usize>()
+            .min_value(min_nodes)
+            .max_value(max_nodes),
+    );
+    let mut g = DiGraph::<(), u32>::new();
+    for _ in 0..n {
+        g.add_node(());
+    }
+    if n > 0 {
+        // Draw the edge count separately so dense graphs are generated too
+        // (hegel's default collection sizes are small).
+        let m = tc.draw(generators::integers::<usize>().max_value(4 * n));
+        let edges: Vec<(usize, usize, u32)> = tc.draw(
+            generators::vecs(generators::tuples!(
+                generators::integers::<usize>().max_value(n - 1),
+                generators::integers::<usize>().max_value(n - 1),
+                generators::integers::<u32>(),
+            ))
+            .min_size(m)
+            .max_size(m),
+        );
+        for (a, b, w) in edges {
+            g.add_edge(NodeIndex::new(a), NodeIndex::new(b), w);
+        }
+    }
+    g
+}
+
+/// Naive Bellman-Ford-style reference: O(V * E) relaxation until fixpoint.
+/// Distances are computed in u64 so the sums cannot overflow
+/// (<= ~256 edges * u32::MAX < 2^40).
+fn naive_shortest_paths(g: &DiGraph<(), u32>, start: NodeIndex) -> Vec<Option<u64>> {
+    let n = g.node_count();
+    let mut dist: Vec<Option<u64>> = vec![None; n];
+    dist[start.index()] = Some(0);
+    loop {
+        let mut changed = false;
+        for e in g.edge_references() {
+            if let Some(d) = dist[e.source().index()] {
+                let nd = d + u64::from(*e.weight());
+                if dist[e.target().index()].is_none_or(|cur| nd < cur) {
+                    dist[e.target().index()] = Some(nd);
+                    changed = true;
+                }
+            }
+        }
+        if !changed {
+            break;
+        }
+    }
+    dist
+}
+
+/// All-pairs reachability by DFS from every node (a node reaches itself).
+fn all_pairs_reachability(g: &DiGraph<(), u32>) -> Vec<Vec<bool>> {
+    let n = g.node_count();
+    let mut reach = vec![vec![false; n]; n];
+    for s in 0..n {
+        reach[s][s] = true;
+        let mut stack = vec![s];
+        while let Some(u) = stack.pop() {
+            for v in g.neighbors(NodeIndex::new(u)) {
+                if !reach[s][v.index()] {
+                    reach[s][v.index()] = true;
+                    stack.push(v.index());
+                }
+            }
+        }
+    }
+    reach
+}
+
+/// Property: `dijkstra` returns exactly the shortest-path distances to every
+/// reachable node (docs: "Compute the length of the shortest path from `start`
+/// to every reachable node"), compared against a naive O(V*E) relaxation.
+/// The node bound protects the cubic-ish reference oracle's runtime, not the
+/// library's contract.
+#[hegel::test]
+fn prop_dijkstra_matches_naive_shortest_paths(tc: hegel::TestCase) {
+    let g = tc.draw((arb_digraph(1, 64)).print_as_debug());
+    let start = NodeIndex::new(tc.draw(
+        generators::integers::<usize>().max_value(g.node_count() - 1),
+    ));
+    let dist = dijkstra(&g, start, None, |e| u64::from(*e.weight()));
+    let expected = naive_shortest_paths(&g, start);
+    for i in 0..g.node_count() {
+        assert_eq!(
+            dist.get(&NodeIndex::new(i)).copied(),
+            expected[i],
+            "distance from {:?} to node {} differs",
+            start,
+            i
+        );
+    }
+}
+
+/// Property: `astar` with the trivial heuristic behaves like dijkstra (per its
+/// docs) and its returned path is a valid witness: it starts at `start`, ends
+/// at the goal, walks only existing edges, and the per-hop minimum edge
+/// weights sum to exactly the claimed cost.
+#[hegel::test]
+fn prop_astar_zero_heuristic_returns_valid_shortest_path(tc: hegel::TestCase) {
+    let g = tc.draw((arb_digraph(1, 64)).print_as_debug());
+    let start = NodeIndex::new(tc.draw(
+        generators::integers::<usize>().max_value(g.node_count() - 1),
+    ));
+    let goal = NodeIndex::new(tc.draw(
+        generators::integers::<usize>().max_value(g.node_count() - 1),
+    ));
+    let expected = naive_shortest_paths(&g, start)[goal.index()];
+    let res = astar(
+        &g,
+        start,
+        |finish| finish == goal,
+        |e| u64::from(*e.weight()),
+        |_| 0,
+    );
+    match (expected, res) {
+        (None, None) => {}
+        (Some(d), Some((cost, path))) => {
+            assert_eq!(cost, d, "astar cost differs from shortest distance");
+            assert_eq!(path.first(), Some(&start), "path must start at start");
+            assert_eq!(path.last(), Some(&goal), "path must end at goal");
+            let mut sum: u64 = 0;
+            for hop in path.windows(2) {
+                let min_w = g
+                    .edges_connecting(hop[0], hop[1])
+                    .map(|e| u64::from(*e.weight()))
+                    .min()
+                    .unwrap_or_else(|| {
+                        panic!("path uses nonexistent edge {:?} -> {:?}", hop[0], hop[1])
+                    });
+                sum += min_w;
+            }
+            // Any walk start->goal costs >= d, and the per-hop minima cost
+            // <= the edges astar actually used (= cost = d), so equality.
+            assert_eq!(sum, cost, "path is not a witness for the claimed cost");
+        }
+        (expected, got) => panic!(
+            "astar disagrees with reference on reachability: expected distance {:?}, got {:?}",
+            expected, got
+        ),
+    }
+}
+
+/// Property: `tarjan_scc` returns exactly the equivalence classes of mutual
+/// reachability (the definition of strongly connected components), with every
+/// node in exactly one component.
+#[hegel::test]
+fn prop_tarjan_scc_matches_mutual_reachability(tc: hegel::TestCase) {
+    let g = tc.draw((arb_digraph(0, 48)).print_as_debug());
+    let n = g.node_count();
+    let reach = all_pairs_reachability(&g);
+    let sccs = algo_tarjan_scc(&g);
+    let mut comp = vec![usize::MAX; n];
+    for (ci, scc) in sccs.iter().enumerate() {
+        for &v in scc {
+            assert_eq!(comp[v.index()], usize::MAX, "node {:?} in two SCCs", v);
+            comp[v.index()] = ci;
+        }
+    }
+    assert!(
+        comp.iter().all(|&c| c != usize::MAX),
+        "some node is missing from the SCC list"
+    );
+    for u in 0..n {
+        for v in 0..n {
+            assert_eq!(
+                comp[u] == comp[v],
+                reach[u][v] && reach[v][u],
+                "SCC assignment wrong for nodes {} and {}",
+                u,
+                v
+            );
+        }
+    }
+}
+
+/// Property: `kosaraju_scc` and `tarjan_scc` (two independent implementations)
+/// produce the same partition of the nodes.
+#[hegel::test]
+fn prop_kosaraju_and_tarjan_scc_agree(tc: hegel::TestCase) {
+    use std::collections::BTreeSet;
+    let g = tc.draw((arb_digraph(0, 64)).print_as_debug());
+    let canonical = |sccs: Vec<Vec<NodeIndex>>| -> BTreeSet<BTreeSet<usize>> {
+        sccs.into_iter()
+            .map(|scc| scc.into_iter().map(|v| v.index()).collect())
+            .collect()
+    };
+    assert_eq!(canonical(kosaraju_scc(&g)), canonical(algo_tarjan_scc(&g)));
+}
+
+/// Property: `connected_components` (union-find based) matches the component
+/// count of a naive DFS over the undirected view of the graph.
+#[hegel::test]
+fn prop_connected_components_matches_dfs_reference(tc: hegel::TestCase) {
+    let g = tc.draw((arb_digraph(0, 64)).print_as_debug());
+    let n = g.node_count();
+    let mut adj = vec![Vec::new(); n];
+    for e in g.edge_references() {
+        adj[e.source().index()].push(e.target().index());
+        adj[e.target().index()].push(e.source().index());
+    }
+    let mut seen = vec![false; n];
+    let mut count = 0;
+    for s in 0..n {
+        if seen[s] {
+            continue;
+        }
+        count += 1;
+        seen[s] = true;
+        let mut stack = vec![s];
+        while let Some(u) = stack.pop() {
+            for &v in &adj[u] {
+                if !seen[v] {
+                    seen[v] = true;
+                    stack.push(v);
+                }
+            }
+        }
+    }
+    assert_eq!(connected_components(&g), count);
+}
+
+/// Property: `toposort` succeeds if and only if the graph is acyclic
+/// (docs: "`toposort` returns `Err` on graphs with cycles",
+/// self loops included).
+#[hegel::test]
+fn prop_toposort_ok_iff_acyclic(tc: hegel::TestCase) {
+    let g = tc.draw((arb_digraph(0, 64)).print_as_debug());
+    assert_eq!(toposort(&g, None).is_ok(), !algo_is_cyclic_directed(&g));
+}
+
+/// Property: when `toposort` succeeds, the order is a permutation of all nodes
+/// in which every node comes before its successors (docs: "each node is
+/// ordered before its successors").
+#[hegel::test]
+fn prop_toposort_order_respects_edges(tc: hegel::TestCase) {
+    let g = tc.draw((arb_digraph(0, 64)).print_as_debug());
+    if let Ok(order) = toposort(&g, None) {
+        assert_eq!(order.len(), g.node_count(), "order must contain every node");
+        let mut pos = vec![usize::MAX; g.node_count()];
+        for (i, v) in order.iter().enumerate() {
+            assert_eq!(pos[v.index()], usize::MAX, "node {:?} appears twice", v);
+            pos[v.index()] = i;
+        }
+        for e in g.edge_references() {
+            assert!(
+                pos[e.source().index()] < pos[e.target().index()],
+                "edge {:?} -> {:?} goes backwards in the order",
+                e.source(),
+                e.target()
+            );
+        }
+    }
+}
+
+/// Stateful model test of `Graph` mutation.
+///
+/// The model is a `Vec` of node weights plus a multiset of edges. Node indices
+/// are modeled exactly: `add_node` appends and `remove_node` documents
+/// swap-remove semantics ("the last node will adopt the removed node index"),
+/// so the model mirrors them with `Vec::swap_remove`. Edge *indices* after
+/// `remove_node` depend on internal adjacency list order, which is not
+/// documented, so edges are compared as a multiset; the documented
+/// "last edge adopts the removed edge index" rule of `remove_edge` is checked
+/// directly inside the rule.
+struct GraphModelMachine {
+    g: DiGraph<u8, u8>,
+    nodes: Vec<u8>,
+    edges: Vec<(usize, usize, u8)>,
+}
+
+#[hegel::state_machine]
+impl GraphModelMachine {
+    #[rule]
+    fn add_node(&mut self, tc: TestCase) {
+        let w = tc.draw(generators::integers::<u8>());
+        let idx = self.g.add_node(w);
+        assert_eq!(idx.index(), self.nodes.len(), "add_node index not dense");
+        self.nodes.push(w);
+    }
+
+    #[rule]
+    fn add_edge(&mut self, tc: TestCase) {
+        tc.assume(!self.nodes.is_empty());
+        let a = tc.draw(generators::integers::<usize>().max_value(self.nodes.len() - 1));
+        let b = tc.draw(generators::integers::<usize>().max_value(self.nodes.len() - 1));
+        let w = tc.draw(generators::integers::<u8>());
+        let e = self.g.add_edge(NodeIndex::new(a), NodeIndex::new(b), w);
+        assert_eq!(e.index(), self.edges.len(), "add_edge index not dense");
+        self.edges.push((a, b, w));
+    }
+
+    #[rule]
+    fn remove_node(&mut self, tc: TestCase) {
+        // Draw up to len + 1 so the "node doesn't exist -> None" branch is
+        // exercised too.
+        let idx = tc.draw(generators::integers::<usize>().max_value(self.nodes.len() + 1));
+        let removed = self.g.remove_node(NodeIndex::new(idx));
+        if idx >= self.nodes.len() {
+            assert_eq!(removed, None, "removing a nonexistent node must be None");
+            return;
+        }
+        assert_eq!(
+            removed,
+            Some(self.nodes[idx]),
+            "remove_node returned the wrong weight"
+        );
+        // Mirror the documented swap-remove: the last node adopts index `idx`.
+        self.nodes.swap_remove(idx);
+        let old_last = self.nodes.len();
+        // All edges with an endpoint in the removed node disappear...
+        self.edges.retain(|&(a, b, _)| a != idx && b != idx);
+        // ...and endpoints referring to the displaced node are renumbered.
+        for (a, b, _) in &mut self.edges {
+            if *a == old_last {
+                *a = idx;
+            }
+            if *b == old_last {
+                *b = idx;
+            }
+        }
+    }
+
+    #[rule]
+    fn remove_edge(&mut self, tc: TestCase) {
+        let count = self.g.edge_count();
+        // Draw up to count + 1 so the "edge doesn't exist -> None" branch is
+        // exercised too.
+        let e = tc.draw(generators::integers::<usize>().max_value(count + 1));
+        let eidx = pg::graph::EdgeIndex::new(e);
+        let target = self.g.edge_endpoints(eidx).map(|(a, b)| {
+            (a.index(), b.index(), *self.g.edge_weight(eidx).unwrap())
+        });
+        let last_info = if count > 0 {
+            let last = pg::graph::EdgeIndex::new(count - 1);
+            Some((
+                self.g.edge_endpoints(last).unwrap(),
+                *self.g.edge_weight(last).unwrap(),
+            ))
+        } else {
+            None
+        };
+        let removed = self.g.remove_edge(eidx);
+        match target {
+            None => assert_eq!(removed, None, "removing a nonexistent edge must be None"),
+            Some((a, b, w)) => {
+                assert_eq!(removed, Some(w), "remove_edge returned the wrong weight");
+                let pos = self
+                    .edges
+                    .iter()
+                    .position(|&x| x == (a, b, w))
+                    .expect("graph edge not present in model");
+                self.edges.swap_remove(pos);
+                // Documented: "Apart from e, this invalidates the last edge
+                // index in the graph (that edge will adopt the removed edge
+                // index)."
+                if e < count - 1 {
+                    let ((la, lb), lw) = last_info.unwrap();
+                    assert_eq!(
+                        self.g.edge_endpoints(eidx),
+                        Some((la, lb)),
+                        "displaced last edge has wrong endpoints"
+                    );
+                    assert_eq!(
+                        self.g.edge_weight(eidx),
+                        Some(&lw),
+                        "displaced last edge has wrong weight"
+                    );
+                }
+            }
+        }
+    }
+
+    #[invariant]
+    fn agrees_with_model(&self, _: TestCase) {
+        assert_eq!(self.g.node_count(), self.nodes.len());
+        for (i, w) in self.nodes.iter().enumerate() {
+            assert_eq!(
+                self.g.node_weight(NodeIndex::new(i)),
+                Some(w),
+                "node weight at index {} differs from model",
+                i
+            );
+        }
+        assert_eq!(self.g.edge_count(), self.edges.len());
+        let mut graph_edges: Vec<(usize, usize, u8)> = self
+            .g
+            .edge_references()
+            .map(|e| (e.source().index(), e.target().index(), *e.weight()))
+            .collect();
+        let mut model_edges = self.edges.clone();
+        graph_edges.sort_unstable();
+        model_edges.sort_unstable();
+        assert_eq!(graph_edges, model_edges, "edge multisets differ");
+    }
+}
+
+/// Property (stateful): a `Graph` under add/remove of nodes and edges agrees
+/// with a simple vec-based model, including the documented swap-remove index
+/// semantics of `remove_node`/`remove_edge`.
+#[hegel::test]
+fn prop_graph_mutations_match_model(tc: hegel::TestCase) {
+    let machine = GraphModelMachine {
+        g: DiGraph::new(),
+        nodes: Vec::new(),
+        edges: Vec::new(),
+    };
+    hegel::stateful::machine(machine).run(tc);
+}
+
