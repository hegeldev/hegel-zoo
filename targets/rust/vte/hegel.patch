+
+    use hegel::generators::{self, Generator};
+
+    /// Feed `bytes` through a single parser in one call and collect dispatches.
+    fn dispatched_for(bytes: &[u8]) -> Vec<Sequence> {
+        let mut dispatcher = Dispatcher::default();
+        let mut parser = Parser::new();
+        parser.advance(&mut dispatcher, bytes);
+        dispatcher.dispatched
+    }
+
+    /// Feed `bytes` through a single parser split at hegel-chosen positions
+    /// (possibly producing empty chunks) and collect dispatches.
+    fn dispatched_chunked(tc: &hegel::TestCase, bytes: &[u8]) -> Vec<Sequence> {
+        let num_splits = tc.draw(generators::integers::<usize>().max_value(8));
+        let mut splits = Vec::with_capacity(num_splits);
+        for _ in 0..num_splits {
+            splits.push(tc.draw(generators::integers::<usize>().max_value(bytes.len())));
+        }
+        splits.sort_unstable();
+
+        let mut dispatcher = Dispatcher::default();
+        let mut parser = Parser::new();
+        let mut start = 0;
+        for split in splits {
+            parser.advance(&mut dispatcher, &bytes[start..split]);
+            start = split;
+        }
+        parser.advance(&mut dispatcher, &bytes[start..]);
+        dispatcher.dispatched
+    }
+
+    /// Arbitrary parser input assembled from raw bytes, valid UTF-8 text, and
+    /// single codepoints with the C1 control range boosted, so multi-byte
+    /// UTF-8 and C0/C1 boundary cases actually show up.
+    #[hegel::composite]
+    fn input_bytes(tc: &hegel::TestCase) -> Vec<u8> {
+        let num_pieces = tc.draw(generators::integers::<usize>().max_value(6));
+        let mut bytes = Vec::new();
+        for _ in 0..num_pieces {
+            match tc.draw(generators::integers::<u8>().max_value(2)) {
+                0 => bytes.extend(tc.draw(generators::binary().max_size(8))),
+                1 => bytes.extend(tc.draw(generators::text().max_size(8)).into_bytes()),
+                _ => {
+                    let code = tc.draw(hegel::one_of!(
+                        // C1 controls, which ground_dispatch handles specially.
+                        generators::integers::<u32>().min_value(0x80).max_value(0x9F),
+                        generators::integers::<u32>().max_value(0x10FFFF),
+                    ));
+                    let c = char::from_u32(code).unwrap_or('\u{FFFD}');
+                    let mut buf = [0u8; 4];
+                    bytes.extend(c.encode_utf8(&mut buf).as_bytes());
+                },
+            }
+        }
+        bytes
+    }
+
+    /// Bytes biased towards escape sequence syntax so that CSI/OSC/DCS states
+    /// and their size limits are actually reached.
+    #[hegel::composite]
+    fn escape_heavy_bytes(tc: &hegel::TestCase) -> Vec<u8> {
+        let len = tc.draw(generators::integers::<usize>().max_value(96));
+        let mut bytes = Vec::with_capacity(len);
+        for _ in 0..len {
+            bytes.push(tc.draw(hegel::one_of!(
+                generators::sampled_from(vec![
+                    0x1B, b'[', b']', b'P', b';', b':', b'0', b'1', b'9', b'm', b'h', b'\\', 0x07,
+                    b' ', b'!', b'?', b'<', b'|', 0x9C,
+                ]),
+                generators::integers::<u8>(),
+            )));
+        }
+        bytes
+    }
+
+    /// Property: `advance` never panics, for arbitrary bytes fed in arbitrary
+    /// chunks through a single reused parser (parse robustness).
+    #[hegel::test]
+    fn advance_never_panics_on_arbitrary_chunked_input(tc: hegel::TestCase) {
+        let size = tc.draw(generators::integers::<usize>().max_value(1024));
+        let mut bytes: Vec<u8> = tc.draw(generators::binary().min_size(size));
+        bytes.extend(tc.draw(input_bytes()));
+        let _ = dispatched_chunked(&tc, &bytes);
+    }
+
+    /// Property: feeding input in arbitrary chunks produces exactly the same
+    /// dispatch sequence as feeding it in one call. The `partial_utf8` buffer
+    /// exists precisely to guarantee this (see the `partial_utf8*` unit tests).
+    #[hegel::test]
+    fn chunked_advance_equals_whole_input_advance(tc: hegel::TestCase) {
+        let bytes = tc.draw(input_bytes());
+        let whole = dispatched_for(&bytes);
+        let chunked = dispatched_chunked(&tc, &bytes);
+        assert_eq!(chunked, whole, "input: {:02x?}", bytes);
+    }
+
+    /// Property: `Perform::print` never receives C0/C1 control characters;
+    /// those are documented to go through `Perform::execute` instead
+    /// (see `ground_dispatch`).
+    #[hegel::test]
+    fn print_never_receives_control_chars(tc: hegel::TestCase) {
+        let bytes = tc.draw(input_bytes());
+        for seq in dispatched_chunked(&tc, &bytes) {
+            if let Sequence::Print(c) = seq {
+                assert!(
+                    !matches!(c, '\x00'..='\x1f' | '\u{80}'..='\u{9f}'),
+                    "control character {:?} was printed instead of executed; input: {:02x?}",
+                    c,
+                    bytes
+                );
+            }
+        }
+    }
+
+    /// Property: `Perform::execute` only receives C0/C1 control function
+    /// bytes, per its documentation.
+    #[hegel::test]
+    fn execute_only_receives_control_bytes(tc: hegel::TestCase) {
+        let bytes = tc.draw(input_bytes());
+        for seq in dispatched_chunked(&tc, &bytes) {
+            if let Sequence::Execute(byte) = seq {
+                assert!(
+                    matches!(byte, 0x00..=0x1F | 0x80..=0x9F),
+                    "non-control byte {:#04x} was executed; input: {:02x?}",
+                    byte,
+                    bytes
+                );
+            }
+        }
+    }
+
+    /// CSI parameter lists whose total number of (sub)parameters fits within
+    /// `MAX_PARAMS`, so a lossless dispatch is guaranteed.
+    #[hegel::composite]
+    fn csi_params(tc: &hegel::TestCase) -> Vec<Vec<u16>> {
+        let num_params = tc.draw(generators::integers::<usize>().max_value(8));
+        let mut params = Vec::new();
+        let mut total = 0;
+        for _ in 0..num_params {
+            let remaining = params::MAX_PARAMS - total;
+            if remaining == 0 {
+                break;
+            }
+            let num_subparams =
+                tc.draw(generators::integers::<usize>().min_value(1).max_value(remaining.min(5)));
+            let mut param = Vec::with_capacity(num_subparams);
+            for _ in 0..num_subparams {
+                param.push(tc.draw(generators::integers::<u16>()));
+            }
+            total += num_subparams;
+            params.push(param);
+        }
+        params
+    }
+
+    /// Property: a well-formed CSI sequence built from arbitrary parameters,
+    /// subparameters, an optional private marker, and intermediates round-trips
+    /// through the parser into a single `csi_dispatch` with exactly that data.
+    #[hegel::test]
+    fn csi_roundtrip(tc: hegel::TestCase) {
+        let params = tc.draw(csi_params());
+        let marker: Option<u8> = tc.draw(generators::optional(
+            generators::integers::<u8>().min_value(0x3C).max_value(0x3F),
+        ));
+        let max_intermediates = 2 - marker.iter().len();
+        let intermediates: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>().min_value(0x20).max_value(0x2F))
+                .max_size(max_intermediates),
+        );
+        let final_byte = tc.draw(generators::integers::<u8>().min_value(0x40).max_value(0x7E));
+
+        let mut input = vec![0x1B, b'['];
+        input.extend(marker);
+        let param_text = params
+            .iter()
+            .map(|param| param.iter().map(u16::to_string).collect::<Vec<_>>().join(":"))
+            .collect::<Vec<_>>()
+            .join(";");
+        input.extend(param_text.bytes());
+        input.extend(&intermediates);
+        input.push(final_byte);
+
+        // An empty parameter string dispatches as a single zero parameter.
+        let expected_params = if params.is_empty() { vec![vec![0]] } else { params.clone() };
+        let mut expected_intermediates: Vec<u8> = marker.into_iter().collect();
+        expected_intermediates.extend(&intermediates);
+
+        assert_eq!(
+            dispatched_for(&input),
+            vec![Sequence::Csi(expected_params, expected_intermediates, false, final_byte as char)]
+        );
+    }
+
+    /// Property: an OSC sequence built from arbitrary parameter byte strings
+    /// round-trips through the parser into a single `osc_dispatch` with
+    /// exactly those parameters and the right terminator flag.
+    #[hegel::test]
+    fn osc_roundtrip(tc: hegel::TestCase) {
+        let num_params =
+            tc.draw(generators::integers::<usize>().min_value(1).max_value(MAX_OSC_PARAMS));
+        let mut params: Vec<Vec<u8>> = Vec::with_capacity(num_params);
+        for _ in 0..num_params {
+            // Parameter bytes: anything except C0 controls (ignored or
+            // terminators inside OSC) and the `;` separator.
+            params.push(
+                tc.draw(
+                    generators::vecs(
+                        generators::integers::<u8>().min_value(0x20).filter(|byte| *byte != b';'),
+                    )
+                    .max_size(6),
+                ),
+            );
+        }
+        let bell_terminated = tc.draw(generators::booleans());
+
+        let mut input = vec![0x1B, b']'];
+        for (i, param) in params.iter().enumerate() {
+            if i != 0 {
+                input.push(b';');
+            }
+            input.extend(param);
+        }
+        if bell_terminated {
+            input.push(0x07);
+        } else {
+            input.extend(b"\x1b\\");
+        }
+
+        let dispatched = dispatched_for(&input);
+        let expected_osc = Sequence::Osc(params, bell_terminated);
+        if bell_terminated {
+            assert_eq!(dispatched, vec![expected_osc]);
+        } else {
+            assert_eq!(dispatched, vec![expected_osc, Sequence::Esc(Vec::new(), false, b'\\')]);
+        }
+    }
+
+    /// Property: numeric CSI parameters saturate at `u16::MAX` instead of
+    /// overflowing (see `action_paramnext` and `parse_long_csi_param`).
+    /// Leading zeros must not affect the value.
+    #[hegel::test]
+    fn csi_param_saturates_at_u16_max(tc: hegel::TestCase) {
+        let value = tc.draw(generators::integers::<u64>());
+        let leading_zeros = tc.draw(generators::integers::<usize>().max_value(3));
+        let input = format!("\x1b[{}{}m", "0".repeat(leading_zeros), value);
+
+        let expected = value.min(u64::from(u16::MAX)) as u16;
+        assert_eq!(
+            dispatched_for(input.as_bytes()),
+            vec![Sequence::Csi(vec![vec![expected]], Vec::new(), false, 'm')]
+        );
+    }
+
+    /// Property: the DCS callback protocol documented on `Perform` holds for
+    /// arbitrary input: `put` and `unhook` only occur between a `hook` and its
+    /// matching `unhook`, and hooks never nest.
+    #[hegel::test]
+    fn dcs_hook_put_unhook_protocol(tc: hegel::TestCase) {
+        let bytes = tc.draw(escape_heavy_bytes());
+        let mut hooked = false;
+        for seq in dispatched_for(&bytes) {
+            match seq {
+                Sequence::DcsHook(..) => {
+                    assert!(!hooked, "hook while already hooked; input: {:02x?}", bytes);
+                    hooked = true;
+                },
+                Sequence::DcsPut(_) => {
+                    assert!(hooked, "put outside a DCS; input: {:02x?}", bytes)
+                },
+                Sequence::DcsUnhook => {
+                    assert!(hooked, "unhook without hook; input: {:02x?}", bytes);
+                    hooked = false;
+                },
+                _ => (),
+            }
+        }
+    }
+
+    /// Property: dispatched data always respects the documented size limits:
+    /// at most `MAX_PARAMS` (sub)parameters, `MAX_INTERMEDIATES` intermediates,
+    /// `MAX_OSC_PARAMS` OSC parameters, and CSI action chars in `0x40..=0x7E`.
+    #[hegel::test]
+    fn dispatched_data_respects_size_limits(tc: hegel::TestCase) {
+        let bytes = tc.draw(escape_heavy_bytes());
+        for seq in dispatched_for(&bytes) {
+            match seq {
+                Sequence::Csi(params, intermediates, _, action) => {
+                    assert!(params.iter().map(Vec::len).sum::<usize>() <= params::MAX_PARAMS);
+                    assert!(params.iter().all(|param| !param.is_empty()));
+                    assert!(intermediates.len() <= MAX_INTERMEDIATES);
+                    assert!(matches!(action, '\x40'..='\x7E'));
+                },
+                Sequence::DcsHook(params, intermediates, _, _) => {
+                    assert!(params.iter().map(Vec::len).sum::<usize>() <= params::MAX_PARAMS);
+                    assert!(params.iter().all(|param| !param.is_empty()));
+                    assert!(intermediates.len() <= MAX_INTERMEDIATES);
+                },
+                Sequence::Osc(params, _) => assert!(params.len() <= MAX_OSC_PARAMS),
+                Sequence::Esc(intermediates, ..) => {
+                    assert!(intermediates.len() <= MAX_INTERMEDIATES)
+                },
+                _ => (),
+            }
+        }
+    }
+
+    /// A `Perform` impl that reports `terminated` once the wrapped dispatcher
+    /// has recorded at least `limit` events.
+    #[derive(Default)]
+    struct TerminatingDispatcher {
+        inner: Dispatcher,
+        limit: usize,
+    }
+
+    impl Perform for TerminatingDispatcher {
+        fn print(&mut self, c: char) {
+            self.inner.print(c);
+        }
+
+        fn execute(&mut self, byte: u8) {
+            self.inner.execute(byte);
+        }
+
+        fn hook(&mut self, params: &Params, intermediates: &[u8], ignore: bool, action: char) {
+            self.inner.hook(params, intermediates, ignore, action);
+        }
+
+        fn put(&mut self, byte: u8) {
+            self.inner.put(byte);
+        }
+
+        fn unhook(&mut self) {
+            self.inner.unhook();
+        }
+
+        fn osc_dispatch(&mut self, params: &[&[u8]], bell_terminated: bool) {
+            self.inner.osc_dispatch(params, bell_terminated);
+        }
+
+        fn csi_dispatch(
+            &mut self,
+            params: &Params,
+            intermediates: &[u8],
+            ignore: bool,
+            action: char,
+        ) {
+            self.inner.csi_dispatch(params, intermediates, ignore, action);
+        }
+
+        fn esc_dispatch(&mut self, intermediates: &[u8], ignore: bool, byte: u8) {
+            self.inner.esc_dispatch(intermediates, ignore, byte);
+        }
+
+        fn terminated(&self) -> bool {
+            self.inner.dispatched.len() >= self.limit
+        }
+    }
+
+    /// Property: `advance_until_terminated` is documented as equivalent to
+    /// `advance`; terminating at arbitrary points and resuming with the
+    /// remaining bytes must produce the same dispatch sequence overall.
+    #[hegel::test]
+    fn advance_until_terminated_resumes_to_same_dispatches(tc: hegel::TestCase) {
+        let mut bytes = tc.draw(input_bytes());
+        bytes.extend(tc.draw(escape_heavy_bytes()));
+        let expected = dispatched_for(&bytes);
+
+        let mut parser = Parser::new();
+        let mut dispatcher = TerminatingDispatcher {
+            inner: Dispatcher::default(),
+            limit: tc.draw(generators::integers::<usize>().max_value(4)),
+        };
+        let mut processed = 0;
+        while processed < bytes.len() {
+            processed += parser.advance_until_terminated(&mut dispatcher, &bytes[processed..]);
+            if processed < bytes.len() {
+                // The parser stopped early; allow more events before resuming.
+                dispatcher.limit = dispatcher.inner.dispatched.len()
+                    + 1
+                    + tc.draw(generators::integers::<usize>().max_value(4));
+            }
+        }
+
+        assert_eq!(dispatcher.inner.dispatched, expected, "input: {:02x?}", bytes);
+    }
 }
