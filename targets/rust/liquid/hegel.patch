+/// Property-based tests (hegel) for stdlib filters, checked against Rust
+/// oracles through the full parse -> evaluate -> render pipeline.
+mod hegel_filter_properties {
+    use hegel::generators;
+
+    fn try_render(template: &str, globals: &liquid::Object) -> Result<String, liquid::Error> {
+        liquid::ParserBuilder::with_stdlib()
+            .build()
+            .unwrap()
+            .parse(template)?
+            .render(globals)
+    }
+
+    fn render(template: &str, globals: &liquid::Object) -> String {
+        try_render(template, globals).expect("render should succeed")
+    }
+
+    // ------------------------------------------------------------------
+    // Arithmetic filters vs a Rust oracle
+    // ------------------------------------------------------------------
+
+    /// `plus`/`minus`/`times` on integer operands match exact i64 arithmetic.
+    ///
+    /// Operands are bounded to the i32 range so that the exact result always
+    /// fits in i64: the filters do unchecked `i64` arithmetic and panic on
+    /// overflow, which is pinned separately in
+    /// `known_failure_plus_panics_on_i64_overflow`.
+    #[hegel::test]
+    fn integer_add_sub_mul_filters_match_i64_oracle(tc: hegel::TestCase) {
+        let a = i64::from(tc.draw(generators::integers::<i32>()));
+        let b = i64::from(tc.draw(generators::integers::<i32>()));
+        let op = tc.draw(generators::sampled_from(vec!["plus", "minus", "times"]));
+        let expected = match op {
+            "plus" => a + b,
+            "minus" => a - b,
+            "times" => a * b,
+            _ => unreachable!(),
+        };
+        let globals = liquid::object!({ "a": a, "b": b });
+        let src = format!("{{{{ a | {op}: b }}}}");
+        assert_eq!(render(&src, &globals), expected.to_string());
+    }
+
+    /// `plus`/`minus`/`times`/`divided_by`/`modulo` on float operands match
+    /// Rust f64 arithmetic (including NaN/infinity operands), rendered via
+    /// f64's `Display`. Division/modulo by (float) zero is a documented
+    /// render error.
+    #[hegel::test]
+    fn float_arithmetic_filters_match_f64_oracle(tc: hegel::TestCase) {
+        let a = tc.draw(generators::floats::<f64>());
+        let b = tc.draw(generators::floats::<f64>());
+        let op = tc.draw(generators::sampled_from(vec![
+            "plus",
+            "minus",
+            "times",
+            "divided_by",
+            "modulo",
+        ]));
+        let globals = liquid::object!({ "a": a, "b": b });
+        let src = format!("{{{{ a | {op}: b }}}}");
+        let result = try_render(&src, &globals);
+        if (op == "divided_by" || op == "modulo") && b == 0.0 {
+            assert!(result.is_err(), "division by zero must be an error");
+            return;
+        }
+        let expected = match op {
+            "plus" => a + b,
+            "minus" => a - b,
+            "times" => a * b,
+            "divided_by" => a / b,
+            "modulo" => a % b,
+            _ => unreachable!(),
+        };
+        assert_eq!(result.expect("render should succeed"), expected.to_string());
+    }
+
+    /// `divided_by`/`modulo` with an integer zero operand is a render error,
+    /// never a panic, for any numerator.
+    #[hegel::test]
+    fn integer_division_by_zero_is_error_not_panic(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<i64>());
+        let op = tc.draw(generators::sampled_from(vec!["divided_by", "modulo"]));
+        let globals = liquid::object!({ "a": a, "b": 0 });
+        let src = format!("{{{{ a | {op}: b }}}}");
+        assert!(try_render(&src, &globals).is_err());
+    }
+
+    /// `divided_by`/`modulo` on non-negative integer operands match Rust i64
+    /// division/remainder.
+    ///
+    /// The domain is restricted to `a >= 0`, `b >= 1` where truncating (Rust)
+    /// and flooring (Ruby/Shopify) division agree: for negative operands the
+    /// implementation deviates from Shopify's documented floor semantics,
+    /// pinned in `known_failure_divided_by_rounds_toward_zero_not_down`.
+    /// `i64::MIN / -1` (a panic) is pinned in
+    /// `known_failure_divided_by_panics_on_min_by_minus_one`.
+    #[hegel::test]
+    fn integer_division_and_modulo_match_oracle_for_non_negative_operands(tc: hegel::TestCase) {
+        let a = tc.draw(generators::integers::<i64>().min_value(0));
+        let b = tc.draw(generators::integers::<i64>().min_value(1));
+        let op = tc.draw(generators::sampled_from(vec!["divided_by", "modulo"]));
+        let expected = match op {
+            "divided_by" => a / b,
+            "modulo" => a % b,
+            _ => unreachable!(),
+        };
+        let globals = liquid::object!({ "a": a, "b": b });
+        let src = format!("{{{{ a | {op}: b }}}}");
+        assert_eq!(render(&src, &globals), expected.to_string());
+    }
+
+    /// KNOWN FAILURE: the arithmetic filters do unchecked `i64` arithmetic
+    /// (crates/lib/src/stdlib/filters/math.rs, e.g. `i + o` at line 173), so
+    /// with overflow checks enabled (as in test/debug builds) an overflowing
+    /// `plus`/`minus`/`times` panics ("attempt to add with overflow") instead
+    /// of returning a render error. In release builds it silently wraps.
+    #[test]
+    fn known_failure_plus_panics_on_i64_overflow() {
+        let globals = liquid::object!({ "a": i64::MAX, "b": 1 });
+        // Ok or Err are both acceptable; panicking is the bug.
+        drop(try_render("{{ a | plus: b }}", &globals));
+    }
+
+    /// KNOWN FAILURE: `divided_by` computes `i / o` without guarding the
+    /// `i64::MIN / -1` overflow case (crates/lib/src/stdlib/filters/math.rs:330),
+    /// which panics in every build profile ("attempt to divide with
+    /// overflow"). Only division by zero is guarded.
+    #[test]
+    fn known_failure_divided_by_panics_on_min_by_minus_one() {
+        let globals = liquid::object!({ "a": i64::MIN, "b": -1 });
+        drop(try_render("{{ a | divided_by: b }}", &globals));
+    }
+
+    /// KNOWN FAILURE: `modulo` computes `i % o` without guarding
+    /// `i64::MIN % -1` (crates/lib/src/stdlib/filters/math.rs:389), which
+    /// panics in every build profile ("attempt to calculate the remainder
+    /// with overflow").
+    #[test]
+    fn known_failure_modulo_panics_on_min_by_minus_one() {
+        let globals = liquid::object!({ "a": i64::MIN, "b": -1 });
+        drop(try_render("{{ a | modulo: b }}", &globals));
+    }
+
+    /// KNOWN FAILURE (Shopify-compatibility deviation): Liquid documents
+    /// `divided_by` as "rounded down to the nearest integer" (floor) for
+    /// integer division, matching Ruby. This implementation uses Rust's
+    /// truncating division: `{{ -1 | divided_by: 2 }}` renders "0" instead of
+    /// the documented "-1". (Ruby's `modulo` sign convention deviates
+    /// similarly.)
+    #[test]
+    fn known_failure_divided_by_rounds_toward_zero_not_down() {
+        let globals = liquid::object!({});
+        assert_eq!(render("{{ -1 | divided_by: 2 }}", &globals), "-1");
+    }
+
+    // ------------------------------------------------------------------
+    // String filters vs Rust oracles
+    // ------------------------------------------------------------------
+
+    /// A generator biased toward case-interesting Unicode (sharp s, dotted
+    /// and dotless I, ligatures, final sigma, titlecase digraphs).
+    #[hegel::composite]
+    fn casey_strings(tc: &hegel::TestCase) -> String {
+        let pieces: Vec<String> = tc.draw(
+            generators::vecs(hegel::one_of!(
+                generators::text().max_size(10),
+                generators::sampled_from(vec![
+                    "ß".to_owned(),
+                    "ẞ".to_owned(),
+                    "İ".to_owned(),
+                    "ı".to_owned(),
+                    "ﬁ".to_owned(),
+                    "ﬆ".to_owned(),
+                    "Σ".to_owned(),
+                    "ς".to_owned(),
+                    "ǅ".to_owned(),
+                    "ᾈ".to_owned(),
+                ]),
+            ))
+            .max_size(8),
+        );
+        pieces.concat()
+    }
+
+    /// `upcase`/`downcase` match Rust's full Unicode case conversion.
+    #[hegel::test]
+    fn upcase_downcase_match_rust_unicode_case_conversion(tc: hegel::TestCase) {
+        let s = tc.draw(casey_strings());
+        let op = tc.draw(generators::sampled_from(vec!["upcase", "downcase"]));
+        let expected = match op {
+            "upcase" => s.to_uppercase(),
+            "downcase" => s.to_lowercase(),
+            _ => unreachable!(),
+        };
+        let globals = liquid::object!({ "s": s });
+        let src = format!("{{{{ s | {op} }}}}");
+        assert_eq!(render(&src, &globals), expected);
+    }
+
+    /// `append`/`prepend` concatenate exactly, for arbitrary Unicode strings.
+    #[hegel::test]
+    fn append_prepend_concatenate_exactly(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::text().max_size(50));
+        let t: String = tc.draw(generators::text().max_size(50));
+        let globals = liquid::object!({ "s": s.clone(), "t": t.clone() });
+        assert_eq!(render("{{ s | append: t }}", &globals), format!("{s}{t}"));
+        assert_eq!(render("{{ s | prepend: t }}", &globals), format!("{t}{s}"));
+    }
+
+    /// `strip`/`lstrip`/`rstrip` match Rust's Unicode `trim` family.
+    #[hegel::test]
+    fn strip_filters_match_rust_trim(tc: hegel::TestCase) {
+        // Interleave text with explicit whitespace so trimming has work to do.
+        let pieces: Vec<String> = tc.draw(
+            generators::vecs(hegel::one_of!(
+                generators::text().max_size(8),
+                generators::sampled_from(vec![
+                    " ".to_owned(),
+                    "\t".to_owned(),
+                    "\n".to_owned(),
+                    "\r\n".to_owned(),
+                    "\u{a0}".to_owned(),
+                    "\u{2028}".to_owned(),
+                    "\u{3000}".to_owned(),
+                ]),
+            ))
+            .max_size(8),
+        );
+        let s = pieces.concat();
+        let globals = liquid::object!({ "s": s.clone() });
+        assert_eq!(render("{{ s | strip }}", &globals), s.trim());
+        assert_eq!(render("{{ s | lstrip }}", &globals), s.trim_start());
+        assert_eq!(render("{{ s | rstrip }}", &globals), s.trim_end());
+    }
+
+    /// `size` of an array is its element count.
+    #[hegel::test]
+    fn size_of_array_is_element_count(tc: hegel::TestCase) {
+        let arr: Vec<i64> = tc.draw(generators::vecs(generators::integers::<i64>()).max_size(30));
+        let globals = liquid::object!({ "arr": arr.clone() });
+        assert_eq!(render("{{ arr | size }}", &globals), arr.len().to_string());
+    }
+
+    // ------------------------------------------------------------------
+    // escape / escape_once
+    // ------------------------------------------------------------------
+
+    /// Strings generated at the escape encode-set boundary: raw specials,
+    /// entity tails with and without their `&`, and filler.
+    #[hegel::composite]
+    fn escapey_strings(tc: &hegel::TestCase) -> String {
+        let pieces: Vec<&str> = tc.draw(
+            generators::vecs(generators::sampled_from(vec![
+                "&", "<", ">", "'", "\"", ";", "#", "a", "é", " ", "lt;", "gt;", "amp;", "quot;",
+                "#39;", "#x27;", "9;", "lt", "quot", "&amp;", "&lt;", "&gt;", "&quot;", "&#39;",
+                "&#60;", "&nbsp;", "&&",
+            ]))
+            .max_size(20),
+        );
+        pieces.concat()
+    }
+
+    /// `escape` output contains no unescaped `<`, `>`, `"`, `'`, every `&`
+    /// starts one of the five entities it emits, and decoding those entities
+    /// restores the input exactly (lossless).
+    #[hegel::test]
+    fn escape_fully_escapes_and_is_lossless(tc: hegel::TestCase) {
+        let s = tc.draw(escapey_strings());
+        let globals = liquid::object!({ "s": s.clone() });
+        let escaped = render("{{ s | escape }}", &globals);
+
+        assert!(
+            !escaped.contains(['<', '>', '"', '\'']),
+            "unescaped special in {escaped:?}"
+        );
+        let decoded =
+            html_unescape(&escaped).unwrap_or_else(|| panic!("bad entity in {escaped:?}"));
+        assert_eq!(decoded, s);
+    }
+
+    /// Decode the five entities `escape` is allowed to produce. Returns
+    /// `None` on a `&` that does not start one of them.
+    fn html_unescape(s: &str) -> Option<String> {
+        let mut out = String::new();
+        let mut rest = s;
+        while let Some(i) = rest.find('&') {
+            out.push_str(&rest[..i]);
+            rest = &rest[i..];
+            let (replacement, len) = if rest.starts_with("&lt;") {
+                ('<', 4)
+            } else if rest.starts_with("&gt;") {
+                ('>', 4)
+            } else if rest.starts_with("&amp;") {
+                ('&', 5)
+            } else if rest.starts_with("&quot;") {
+                ('"', 6)
+            } else if rest.starts_with("&#39;") {
+                ('\'', 5)
+            } else {
+                return None;
+            };
+            out.push(replacement);
+            rest = &rest[len..];
+        }
+        out.push_str(rest);
+        Some(out)
+    }
+
+    /// `escape_once` is idempotent: escaping its own output changes nothing.
+    #[hegel::test]
+    fn escape_once_is_idempotent(tc: hegel::TestCase) {
+        let s = tc.draw(escapey_strings());
+        let once = render("{{ s | escape_once }}", &liquid::object!({ "s": s }));
+        let twice = render(
+            "{{ s | escape_once }}",
+            &liquid::object!({ "s": once.clone() }),
+        );
+        assert_eq!(twice, once);
+    }
+
+    /// `escape` output is a fixed point of `escape_once`.
+    #[hegel::test]
+    fn escape_then_escape_once_is_fixed_point(tc: hegel::TestCase) {
+        let s = tc.draw(escapey_strings());
+        let globals = liquid::object!({ "s": s });
+        let escaped = render("{{ s | escape }}", &globals);
+        let escaped_once_more = render("{{ s | escape | escape_once }}", &globals);
+        assert_eq!(escaped_once_more, escaped);
+    }
+
+    // ------------------------------------------------------------------
+    // slice / truncate bounds
+    // ------------------------------------------------------------------
+
+    /// Ruby/Shopify `String#slice(offset, length)` oracle (`None` == Ruby
+    /// `nil`, which Liquid renders as ""). For ASCII input bytes == chars, so
+    /// this is unambiguous.
+    fn ruby_slice(s: &str, offset: i64, length: i64) -> Option<String> {
+        let n = s.chars().count() as i64;
+        let mut offset = offset;
+        if offset < 0 {
+            offset += n;
+            if offset < 0 {
+                return None;
+            }
+        }
+        if offset > n {
+            return None;
+        }
+        Some(
+            s.chars()
+                .skip(offset as usize)
+                .take(usize::try_from(length).expect("caller passes length >= 1"))
+                .collect(),
+        )
+    }
+
+    /// `slice` on ASCII strings matches the Ruby `slice` oracle for the full
+    /// i64 offset range; a length < 1 is a render error.
+    ///
+    /// The length is kept small because a huge length triggers a pinned
+    /// overflow panic (`known_failure_slice_panics_on_length_overflow`); the
+    /// bound avoids the pinned bug, it is not a contract. Non-ASCII slicing
+    /// is pinned separately in
+    /// `known_failure_slice_mixes_bytes_and_chars_for_unicode`.
+    #[hegel::test]
+    fn slice_matches_ruby_oracle_on_ascii(tc: hegel::TestCase) {
+        let bytes: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>().min_value(0x20).max_value(0x7e))
+                .max_size(40),
+        );
+        let s = String::from_utf8(bytes).unwrap();
+        let offset = tc.draw(generators::integers::<i64>());
+        let with_length = tc.draw(generators::booleans());
+        let globals = liquid::object!({ "s": s.clone(), "o": offset });
+
+        let (src, length) = if with_length {
+            let length = tc.draw(
+                generators::integers::<i64>()
+                    .min_value(-2)
+                    .max_value(s.len() as i64 + 4),
+            );
+            ("{{ s | slice: o, l }}", Some(length))
+        } else {
+            ("{{ s | slice: o }}", None)
+        };
+        let globals = if let Some(l) = length {
+            liquid::object!({ "s": s.clone(), "o": offset, "l": l })
+        } else {
+            globals
+        };
+
+        let effective_length = length.unwrap_or(1);
+        let result = try_render(src, &globals);
+        if effective_length < 1 {
+            assert!(result.is_err(), "length < 1 must be a render error");
+            return;
+        }
+        let expected = ruby_slice(&s, offset, effective_length).unwrap_or_default();
+        assert_eq!(result.expect("render should succeed"), expected);
+    }
+
+    /// KNOWN FAILURE: `canonicalize_slice` adds offset and length with
+    /// unchecked isize arithmetic (crates/lib/src/stdlib/filters/slice.rs:30),
+    /// so a large length panics in debug builds ("attempt to add with
+    /// overflow") instead of being capped.
+    #[test]
+    fn known_failure_slice_panics_on_length_overflow() {
+        let globals = liquid::object!({ "s": "ab", "l": i64::MAX });
+        // Ok or Err are both acceptable; panicking is the bug.
+        drop(try_render("{{ s | slice: 2, l }}", &globals));
+    }
+
+    /// KNOWN FAILURE (Shopify-compatibility deviation): `slice` canonicalizes
+    /// offsets against the *byte* length but then skips *chars*
+    /// (crates/lib/src/stdlib/filters/slice.rs:86-88), so negative offsets on
+    /// non-ASCII strings land in the wrong place: `"héllo" | slice: -1` must
+    /// be "o" (Ruby/Shopify) but renders "".
+    #[test]
+    fn known_failure_slice_mixes_bytes_and_chars_for_unicode() {
+        let globals = liquid::object!({ "s": "héllo" });
+        assert_eq!(render("{{ s | slice: -1 }}", &globals), "o");
+    }
+
+    /// `truncate` on ASCII strings never fails, and matches the documented
+    /// semantics: unchanged when the length fits, otherwise a prefix plus the
+    /// default "..." ellipsis, with the ellipsis counted in the length.
+    ///
+    /// The value is only checked for `n >= 0`; for negative lengths we only
+    /// require no panic/error (the implementation casts `i64 as usize`).
+    /// Non-ASCII truncation deviates (bytes vs graphemes), pinned in
+    /// `known_failure_truncate_over_truncates_unicode`.
+    #[hegel::test]
+    fn truncate_matches_oracle_on_ascii(tc: hegel::TestCase) {
+        let bytes: Vec<u8> = tc.draw(
+            generators::vecs(generators::integers::<u8>().min_value(0x20).max_value(0x7e))
+                .max_size(80),
+        );
+        let s = String::from_utf8(bytes).unwrap();
+        let n = tc.draw(generators::integers::<i64>());
+        let globals = liquid::object!({ "s": s.clone(), "n": n });
+        let output = try_render("{{ s | truncate: n }}", &globals)
+            .expect("truncate should never fail on a string input");
+        if n >= 0 {
+            let n = n as usize;
+            let expected = if s.len() <= n {
+                s.clone()
+            } else {
+                let keep = n.saturating_sub(3);
+                format!("{}...", &s[..keep.min(s.len())])
+            };
+            assert_eq!(output, expected);
+        }
+    }
+
+    /// KNOWN FAILURE (Shopify-compatibility deviation): `truncate` compares
+    /// the requested length against the *byte* length but truncates by
+    /// grapheme (crates/lib/src/stdlib/filters/string/truncate.rs:85), so
+    /// non-ASCII strings that already fit get truncated: `"ééé" | truncate: 5`
+    /// must be "ééé" (3 chars <= 5) but renders "éé...".
+    #[test]
+    fn known_failure_truncate_over_truncates_unicode() {
+        let globals = liquid::object!({ "s": "ééé" });
+        assert_eq!(render("{{ s | truncate: 5 }}", &globals), "ééé");
+    }
+
+    // ------------------------------------------------------------------
+    // default filter
+    // ------------------------------------------------------------------
+
+    /// `default` substitutes exactly when the input is nil, false, an empty
+    /// string, or an empty array — and passes everything else through. The
+    /// expected output is computed by rendering the value we expect `default`
+    /// to select, so this tests the selection logic, not the formatting.
+    #[hegel::test]
+    fn default_filter_selects_on_nil_false_and_empty(tc: hegel::TestCase) {
+        let d: String = tc.draw(generators::text().max_size(20));
+        let variant = tc.draw(generators::integers::<u8>().max_value(7));
+        let (x, uses_default): (liquid_core::Value, bool) = match variant {
+            0 => (liquid_core::Value::Nil, true),
+            1 => (liquid_core::Value::scalar(false), true),
+            2 => (liquid_core::Value::scalar(true), false),
+            3 => (liquid_core::Value::scalar(""), true),
+            4 => {
+                let s: String = tc.draw(generators::text().min_size(1).max_size(20));
+                (liquid_core::Value::scalar(s), false)
+            }
+            5 => (liquid_core::Value::Array(Default::default()), true),
+            6 => {
+                let arr: Vec<i64> = tc.draw(
+                    generators::vecs(generators::integers::<i64>())
+                        .min_size(1)
+                        .max_size(5),
+                );
+                (
+                    liquid_core::Value::Array(
+                        arr.into_iter().map(liquid_core::Value::scalar).collect(),
+                    ),
+                    false,
+                )
+            }
+            _ => {
+                let n = tc.draw(generators::integers::<i64>());
+                (liquid_core::Value::scalar(n), false)
+            }
+        };
+
+        let selected = if uses_default {
+            liquid_core::Value::scalar(d.clone())
+        } else {
+            x.clone()
+        };
+        let expected = render("{{ y }}", &liquid::object!({ "y": selected }));
+        let actual = render("{{ x | default: d }}", &liquid::object!({ "x": x, "d": d }));
+        assert_eq!(actual, expected);
+    }
+}
