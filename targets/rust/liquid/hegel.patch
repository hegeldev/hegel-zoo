+/// Property-based tests (hegel) for parser robustness: `Parser::parse` on
+/// untrusted input must return `Err`, never panic or crash.
+mod hegel_parse_robustness {
+    use hegel::generators;
+
+    fn parser() -> liquid::Parser {
+        liquid::ParserBuilder::with_stdlib().build().unwrap()
+    }
+
+    fn render_globals() -> liquid::Object {
+        liquid::object!({
+            "a": 1,
+            "foo": "bar",
+            "x": "héllo",
+            "arr": [1, 2],
+            "obj": { "k": "v" },
+        })
+    }
+
+    /// Parsing (and, when parsing succeeds, rendering) arbitrary Unicode text
+    /// must never panic. Errors are fine; panics are not.
+    #[hegel::test]
+    fn parse_never_panics_on_arbitrary_text(tc: hegel::TestCase) {
+        let text: String = tc.draw(generators::text().max_size(200));
+        if let Ok(template) = parser().parse(&text) {
+            // Render errors (unknown variables etc.) are fine; panics are not.
+            drop(template.render(&render_globals()));
+        }
+    }
+
+    /// Parsing Liquid-shaped token soup (delimiters, operators, keywords,
+    /// identifiers, literals glued together in random order) must never panic.
+    ///
+    /// Numeric atoms are deliberately short: integer literals that overflow
+    /// `i64` are a pinned parser panic, see
+    /// `known_failure_parse_panics_on_out_of_range_integer_literal` below.
+    #[hegel::test]
+    fn parse_never_panics_on_liquid_token_soup(tc: hegel::TestCase) {
+        let fragments = vec![
+            "{{",
+            "}}",
+            "{%",
+            "%}",
+            "{{-",
+            "-}}",
+            "{%-",
+            "-%}",
+            "|",
+            ".",
+            "[",
+            "]",
+            ":",
+            ",",
+            "==",
+            "!=",
+            "<",
+            ">",
+            "<=",
+            ">=",
+            "<>",
+            "=",
+            "(",
+            ")",
+            "..",
+            "-",
+            "'",
+            "\"",
+            ";",
+            "if",
+            "endif",
+            "elsif",
+            "else",
+            "unless",
+            "endunless",
+            "case",
+            "when",
+            "endcase",
+            "for",
+            "endfor",
+            "break",
+            "continue",
+            "cycle",
+            "tablerow",
+            "endtablerow",
+            "assign",
+            "capture",
+            "endcapture",
+            "increment",
+            "decrement",
+            "raw",
+            "endraw",
+            "comment",
+            "endcomment",
+            "include",
+            "render",
+            "a",
+            "foo",
+            "x",
+            "arr",
+            "obj",
+            "k",
+            "_",
+            "true",
+            "false",
+            "nil",
+            "null",
+            "empty",
+            "blank",
+            "contains",
+            "and",
+            "or",
+            "in",
+            "reversed",
+            "limit",
+            "offset",
+            "0",
+            "1",
+            "-1",
+            "42",
+            "3.14",
+            "-2.5",
+            "'s'",
+            "\"t\"",
+            "''",
+            "plus",
+            "minus",
+            "times",
+            "divided_by",
+            "modulo",
+            "upcase",
+            "size",
+            "default",
+            " ",
+            "\n",
+            "\t",
+            "é",
+            "\u{2028}",
+            "\0",
+        ];
+        let pieces: Vec<&str> =
+            tc.draw(generators::vecs(generators::sampled_from(fragments)).max_size(30));
+        let text = pieces.concat();
+        if let Ok(template) = parser().parse(&text) {
+            drop(template.render(&render_globals()));
+        }
+    }
+
+    /// Templates with nested blocks up to a moderate depth must parse and
+    /// render successfully.
+    ///
+    /// The depth is capped at 64 because deeper nesting hits an unbounded
+    /// recursion in the parser that aborts the whole process with a stack
+    /// overflow -- see the `#[ignore]`d
+    /// `known_failure_deep_block_nesting_overflows_stack` reproducer below.
+    /// The cap documents the bug's blast radius; it is not a contract.
+    #[hegel::test]
+    fn nested_blocks_parse_and_render_up_to_supported_depth(tc: hegel::TestCase) {
+        let depth = tc.draw(generators::integers::<usize>().min_value(1).max_value(64));
+        let mut openers = Vec::new();
+        let mut closers = Vec::new();
+        for i in 0..depth {
+            // `for` over `(1..1)` iterates exactly once, so rendering stays linear.
+            let (open, close) = match tc.draw(generators::integers::<u8>().max_value(2)) {
+                0 => ("{% if true %}".to_owned(), "{% endif %}"),
+                1 => ("{% unless false %}".to_owned(), "{% endunless %}"),
+                _ => (format!("{{% for v{i} in (1..1) %}}"), "{% endfor %}"),
+            };
+            openers.push(open);
+            closers.push(close);
+        }
+        let mut text = openers.concat();
+        text.push('x');
+        text.extend(closers.iter().rev().copied());
+
+        let template = parser()
+            .parse(&text)
+            .expect("balanced nested blocks should parse");
+        let output = template
+            .render(&liquid::object!({}))
+            .expect("nested blocks over constant conditions should render");
+        assert_eq!(output, "x");
+    }
+
+    /// KNOWN FAILURE: the grammar admits integer literals of any length
+    /// (`ASCII_DIGIT+`), but `parse_literal` converts them with
+    /// `.parse::<i64>().expect(...)` (crates/core/src/parser/parser.rs:117),
+    /// so any literal above `i64::MAX` panics instead of returning a parse
+    /// error: "Grammar ensures matches are parseable as integers.:
+    /// ParseIntError { kind: PosOverflow }".
+    #[test]
+    fn known_failure_parse_panics_on_out_of_range_integer_literal() {
+        // 20 nines > i64::MAX (9223372036854775807).
+        let result = parser().parse("{{ 99999999999999999999 }}");
+        // Ok or Err are both acceptable; panicking is the bug.
+        drop(result);
+    }
+
+    /// KNOWN FAILURE (process-aborting, hence `#[ignore]`): parsing/rendering
+    /// deeply nested blocks recurses without a depth limit and overflows the
+    /// stack, aborting the whole process (SIGABRT). Reproduces at depth 500 on
+    /// a default 8 MiB test-thread stack. Untrusted templates can crash the
+    /// host process.
+    #[test]
+    #[ignore = "aborts the process with a stack overflow; kept as a documented reproducer"]
+    fn known_failure_deep_block_nesting_overflows_stack() {
+        let depth = 2000;
+        let mut text = "{% if true %}".repeat(depth);
+        text.push_str(&"{% endif %}".repeat(depth));
+        drop(parser().parse(&text));
+    }
+
+    /// KNOWN FAILURE (process-aborting, hence `#[ignore]`): deeply nested
+    /// variable indexing (`{{ a[a[a[...]]] }}`) overflows the stack in the
+    /// parser. Reproduces at depth 1000 on a default 8 MiB test-thread stack.
+    #[test]
+    #[ignore = "aborts the process with a stack overflow; kept as a documented reproducer"]
+    fn known_failure_deep_index_nesting_overflows_stack() {
+        let depth = 4000;
+        let mut text = String::from("{{ ");
+        text.push_str(&"a[".repeat(depth));
+        text.push('a');
+        text.push_str(&"]".repeat(depth));
+        text.push_str(" }}");
+        drop(parser().parse(&text));
+    }
+}
