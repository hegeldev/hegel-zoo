+/// Property-based tests (hegel) for rendering: output identity and
+/// determinism.
+mod hegel_render_properties {
+    use hegel::generators;
+
+    fn parser() -> liquid::Parser {
+        liquid::ParserBuilder::with_stdlib().build().unwrap()
+    }
+
+    /// `{{ s }}` renders a string global back exactly, byte for byte, for
+    /// arbitrary Unicode content (controls, NUL, non-BMP, line separators).
+    #[hegel::test]
+    fn rendering_a_string_global_is_identity(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::text().max_size(100));
+        let output = parser()
+            .parse("{{ s }}")
+            .unwrap()
+            .render(&liquid::object!({ "s": s.clone() }))
+            .expect("rendering a plain string global should succeed");
+        assert_eq!(output, s);
+    }
+
+    /// Parsing and rendering are deterministic: parsing the same template
+    /// twice and rendering each with the same globals produces identical
+    /// output.
+    #[hegel::test]
+    fn parse_and_render_are_deterministic(tc: hegel::TestCase) {
+        let s: String = tc.draw(generators::text().max_size(30));
+        // Bounded to the i32 range: the template below feeds `a` through
+        // `plus`/`times`, whose unchecked i64 arithmetic panics on overflow.
+        // That bug is pinned in filters.rs
+        // (known_failure_plus_panics_on_i64_overflow); the bound keeps this
+        // sibling property focused on determinism.
+        let a = i64::from(tc.draw(generators::integers::<i32>()));
+        let pieces: Vec<&str> = tc.draw(
+            generators::vecs(generators::sampled_from(vec![
+                "plain text ",
+                "x\n",
+                "{{ s }}",
+                "{{ s | upcase }}",
+                "{{ a }}",
+                "{{ a | plus: 1 | times: 2 }}",
+                "{% if a > 0 %}pos{% else %}nonpos{% endif %}",
+                "{% for i in (1..3) %}{{ i }}{% endfor %}",
+                "{% assign y = s %}{{ y }}",
+                "{% comment %}hidden{% endcomment %}",
+                "{{- s -}}",
+            ]))
+            .max_size(12),
+        );
+        let template_src = pieces.concat();
+        let globals = liquid::object!({ "s": s, "a": a });
+
+        let template1 = parser()
+            .parse(&template_src)
+            .expect("template built from valid pieces should parse");
+        let template2 = parser().parse(&template_src).unwrap();
+
+        let out1 = template1.render(&globals).expect("render should succeed");
+        let out1_again = template1.render(&globals).unwrap();
+        let out2 = template2.render(&globals).unwrap();
+
+        assert_eq!(
+            out1, out1_again,
+            "same template object must be deterministic"
+        );
+        assert_eq!(out1, out2, "independently parsed templates must agree");
+    }
+}
