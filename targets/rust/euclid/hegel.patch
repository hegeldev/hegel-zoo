diff --git a/src/rotation.rs b/src/rotation.rs
index 534c9db..e561353 100644
--- a/src/rotation.rs
+++ b/src/rotation.rs
@@ -1145,4 +1145,77 @@ mod tests {
         let new_obtained_angle2: f32 = rot2.get_angle().radians;
         assert!(new_obtained_angle2.approx_eq(&angle_of_rotation2));
     }
+
+    mod hegel_props {
+        use crate::default::{Rotation2D, Rotation3D, Vector2D, Vector3D};
+        use crate::{vec2, vec3};
+        use hegel::generators;
+
+        // A rotation is an isometry: transforming a vector by a rotation
+        // must preserve its length.
+        #[hegel::test]
+        fn hegel_rotation2d_preserves_vector_length(tc: hegel::TestCase) {
+            // Any finite angle is fine: sin/cos are always in [-1, 1].
+            let angle = tc.draw(
+                generators::floats::<f64>()
+                    .allow_nan(false)
+                    .allow_infinity(false),
+            );
+            // |x|, |y| <= 1e150 so that x*x + y*y cannot overflow inside
+            // `length()`; this bound protects the test's oracle (the length
+            // computation), not a library contract.
+            let coord = || {
+                generators::floats::<f64>()
+                    .min_value(-1e150)
+                    .max_value(1e150)
+            };
+            let v: Vector2D<f64> = vec2(tc.draw(coord()), tc.draw(coord()));
+            let rv = Rotation2D::radians(angle).transform_vector(v);
+            let tol = 1e-12 * v.length() + 1e-315;
+            assert!(
+                (rv.length() - v.length()).abs() <= tol,
+                "rotating {v:?} by {angle:e} changed its length from {} to {}",
+                v.length(),
+                rv.length()
+            );
+        }
+
+        // Applying a rotation and then its inverse must approximately return
+        // the original vector (`inverse()` of a unit quaternion is its
+        // conjugate, i.e. the opposite rotation).
+        #[hegel::test]
+        fn hegel_rotation3d_inverse_roundtrip(tc: hegel::TestCase) {
+            let q_component = || {
+                generators::floats::<f64>()
+                    .min_value(-100.0)
+                    .max_value(100.0)
+            };
+            let raw: Rotation3D<f64> = Rotation3D::quaternion(
+                tc.draw(q_component()),
+                tc.draw(q_component()),
+                tc.draw(q_component()),
+                tc.draw(q_component()),
+            );
+            // Nearly-zero quaternions cannot be meaningfully normalized;
+            // excluding them protects the normalization step of the test
+            // setup, not a library contract.
+            tc.assume(raw.square_norm() > 1e-4);
+            let q = raw.normalize();
+
+            let coord = || {
+                generators::floats::<f64>()
+                    .min_value(-1e6)
+                    .max_value(1e6)
+            };
+            let v: Vector3D<f64> = vec3(tc.draw(coord()), tc.draw(coord()), tc.draw(coord()));
+            let w = q.inverse().transform_vector3d(q.transform_vector3d(v));
+            let tol = 1e-9 * (1.0 + v.length());
+            assert!(
+                (w.x - v.x).abs() <= tol
+                    && (w.y - v.y).abs() <= tol
+                    && (w.z - v.z).abs() <= tol,
+                "roundtrip of {v:?} through {q:?} and its inverse gave {w:?}"
+            );
+        }
+    }
 }
diff --git a/src/transform2d.rs b/src/transform2d.rs
index 62b600b..3ee54c3 100644
--- a/src/transform2d.rs
+++ b/src/transform2d.rs
@@ -1515,4 +1515,73 @@ mod test {
     pub fn scale_offset_identity() {
         assert!(ScaleOffset::identity().is_identity())
     }
+
+    mod hegel_props {
+        use crate::default;
+        use crate::point2;
+        use hegel::generators;
+
+        type DMat = default::Transform2D<f64>;
+
+        /// Draws a well-conditioned invertible transform.
+        ///
+        /// Components come from a wide-but-moderate range and the determinant
+        /// is required to be large relative to the linear part, so that a
+        /// fixed float tolerance is meaningful. Near-singular transforms have
+        /// unboundedly ill-conditioned inverses; excluding them protects the
+        /// test's tolerance, not a library contract.
+        fn draw_invertible(tc: &hegel::TestCase) -> DMat {
+            let c = || {
+                generators::floats::<f64>()
+                    .min_value(-100.0)
+                    .max_value(100.0)
+            };
+            let m = DMat::new(
+                tc.draw(c()),
+                tc.draw(c()),
+                tc.draw(c()),
+                tc.draw(c()),
+                tc.draw(c()),
+                tc.draw(c()),
+            );
+            let s = m.m11.abs().max(m.m12.abs()).max(m.m21.abs()).max(m.m22.abs());
+            tc.assume(s > 1e-3);
+            tc.assume(m.determinant().abs() > 1e-3 * s * s);
+            m
+        }
+
+        // `inverse()` documents "Returns the inverse transform if possible";
+        // composing a transform with its inverse must approximate the
+        // identity transform.
+        #[hegel::test]
+        fn hegel_then_inverse_approximates_identity(tc: hegel::TestCase) {
+            let m = draw_invertible(&tc);
+            let inv = m.inverse().expect("well-conditioned transform must be invertible");
+            let id = m.then(&inv);
+            assert!(
+                id.approx_eq_eps(&DMat::identity(), &1e-6),
+                "{m:?}.then(inverse) = {id:?} is not approximately the identity"
+            );
+        }
+
+        // Transforming a point and then applying the inverse transform must
+        // approximately return the original point.
+        #[hegel::test]
+        fn hegel_transform_point_inverse_roundtrip(tc: hegel::TestCase) {
+            let m = draw_invertible(&tc);
+            let inv = m.inverse().expect("well-conditioned transform must be invertible");
+            let coord = || {
+                generators::floats::<f64>()
+                    .min_value(-1e4)
+                    .max_value(1e4)
+            };
+            let p: default::Point2D<f64> = point2(tc.draw(coord()), tc.draw(coord()));
+            let q = inv.transform_point(m.transform_point(p));
+            let tol = 1e-6 * (1.0 + p.x.abs().max(p.y.abs()));
+            assert!(
+                (q.x - p.x).abs() <= tol && (q.y - p.y).abs() <= tol,
+                "roundtrip of {p:?} through {m:?} gave {q:?}"
+            );
+        }
+    }
 }
