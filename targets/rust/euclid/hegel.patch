diff --git a/src/angle.rs b/src/angle.rs
index 8cda48f..7db189f 100644
--- a/src/angle.rs
+++ b/src/angle.rs
@@ -399,4 +399,127 @@ mod float {
         let sum = A::radians(6.0);
         assert_eq!(angles.iter().sum::<A>(), sum);
     }
+
+    #[cfg(test)]
+    mod hegel_props {
+        use super::Angle;
+        use hegel::generators;
+
+        const PI: f64 = core::f64::consts::PI;
+        const TWO_PI: f64 = 2.0 * core::f64::consts::PI;
+
+        /// Finite angles, boosted toward the boundary regions where wrapping
+        /// bugs live: tiny negatives, values adjacent to +/-PI and +/-2*PI,
+        /// and the extremes of the finite range. NaN and infinity are excluded
+        /// because wrapping an angle only makes sense for finite values
+        /// (`Angle::is_finite` exists for callers to check).
+        fn draw_angle(tc: &hegel::TestCase) -> f64 {
+            tc.draw(hegel::one_of!(
+                generators::floats::<f64>()
+                    .allow_nan(false)
+                    .allow_infinity(false),
+                generators::floats::<f64>()
+                    .min_value(-4e-16)
+                    .max_value(-1e-300),
+                generators::sampled_from(vec![
+                    -1e-20,
+                    -5e-324,
+                    PI,
+                    -PI,
+                    f64::from_bits(PI.to_bits() + 1), // smallest f64 above PI
+                    TWO_PI,
+                    -TWO_PI,
+                    f64::MAX,
+                    -f64::MAX,
+                ]),
+            ))
+        }
+
+        // KNOWN FAILURE: real bug. `positive()` documents a result in the
+        // "[0..2*PI[" range, but for tiny negative inputs (e.g. -1e-20) the
+        // fixup `a = a + two_pi` rounds to exactly 2*PI, which is outside the
+        // documented half-open range. Code path: `Angle::positive()` in
+        // src/angle.rs (the `a + two_pi` branch when `a < 0`).
+        #[hegel::test(test_cases = 300)]
+        fn hegel_positive_is_in_zero_two_pi(tc: hegel::TestCase) {
+            let radians = draw_angle(&tc);
+            let p = Angle::radians(radians).positive().radians;
+            assert!(
+                (0.0..TWO_PI).contains(&p),
+                "positive({radians:e}) = {p:e} is not in [0, 2*PI)"
+            );
+        }
+
+        // `signed()` documents a result in the "]-PI..PI]" range.
+        //
+        // `signed()` is built on `positive()`, whose 2*PI rounding bug is
+        // pinned by `hegel_positive_is_in_zero_two_pi` (through `signed()` it
+        // returns exactly -PI for inputs just above PI). Exclude the inputs
+        // that hit that known bug so this test keeps checking everything else.
+        #[hegel::test]
+        fn hegel_signed_is_in_neg_pi_pi(tc: hegel::TestCase) {
+            let radians = draw_angle(&tc);
+            let m = (PI - radians) % TWO_PI;
+            tc.assume(!(m < 0.0 && m + TWO_PI == TWO_PI));
+            let s = Angle::radians(radians).signed().radians;
+            assert!(
+                -PI < s && s <= PI,
+                "signed({radians:e}) = {s:e} is not in ]-PI, PI]"
+            );
+        }
+
+        /// Finite angles, boosted toward huge magnitudes whose pairwise
+        /// difference overflows f64.
+        fn draw_extreme_angle(tc: &hegel::TestCase) -> f64 {
+            tc.draw(hegel::one_of!(
+                generators::floats::<f64>()
+                    .allow_nan(false)
+                    .allow_infinity(false),
+                generators::floats::<f64>()
+                    .min_value(1e308)
+                    .max_value(f64::MAX),
+                generators::floats::<f64>()
+                    .min_value(-f64::MAX)
+                    .max_value(-1e308),
+            ))
+        }
+
+        // KNOWN FAILURE: real bug (float overflow). `angle_to()` documents
+        // "the shortest signed angle between two angles", but when two finite
+        // angles are far enough apart, `to.radians - self.radians` overflows
+        // to infinity and `inf % two_pi` is NaN, so a NaN angle is returned
+        // for finite inputs. Code path: `Angle::angle_to()` in src/angle.rs
+        // (`let d = (to.radians - self.radians) % max`).
+        #[hegel::test(test_cases = 300)]
+        fn hegel_angle_to_is_finite_for_finite_angles(tc: hegel::TestCase) {
+            let from = draw_extreme_angle(&tc);
+            let to = draw_extreme_angle(&tc);
+            let d = Angle::radians(from).angle_to(Angle::radians(to)).radians;
+            assert!(
+                d.is_finite(),
+                "angle_to({from:e} -> {to:e}) = {d:e} is not finite"
+            );
+        }
+
+        // "Shortest signed angle" means the result's magnitude is at most PI.
+        //
+        // Inputs are bounded to +/-8.9e307 so that `to - from` cannot
+        // overflow; the overflow-to-NaN at the extremes is the known failure
+        // pinned by `hegel_angle_to_is_finite_for_finite_angles`.
+        #[hegel::test]
+        fn hegel_angle_to_magnitude_is_at_most_pi(tc: hegel::TestCase) {
+            let range = || {
+                generators::floats::<f64>()
+                    .min_value(-8.9e307)
+                    .max_value(8.9e307)
+            };
+            let from = tc.draw(range());
+            let to = tc.draw(range());
+            let d = Angle::radians(from).angle_to(Angle::radians(to)).radians;
+            assert!(
+                d.abs() <= PI,
+                "angle_to({from:e} -> {to:e}) = {d:e} exceeds PI in magnitude"
+            );
+        }
+    }
 }
diff --git a/src/box2d.rs b/src/box2d.rs
index 43fb1e0..74da83e 100644
--- a/src/box2d.rs
+++ b/src/box2d.rs
@@ -1045,4 +1045,126 @@ mod tests {
         assert_eq!(b.min, point2(1.0, 2.0));
         assert_eq!(b.size(), size2(5.0, 6.0));
     }
+
+    mod hegel_props {
+        use hegel::Generator;
+        use crate::default::Box2D;
+        use crate::point2;
+        use hegel::generators;
+
+        /// Coordinates from the full i32 range, widened to i64 so that the
+        /// arithmetic inside the library (`max - min`, `origin + size`)
+        /// cannot overflow while still exercising huge magnitudes.
+        fn draw_coord(tc: &hegel::TestCase) -> i64 {
+            tc.draw(generators::integers::<i32>()) as i64
+        }
+
+        /// A well-formed (min <= max) box, frequently degenerate
+        /// (zero width and/or zero height) to probe empty-box edge cases.
+        fn draw_box(tc: &hegel::TestCase) -> Box2D<i64> {
+            let x0 = draw_coord(tc);
+            let y0 = draw_coord(tc);
+            let x1 = if tc.draw(generators::booleans()) {
+                x0
+            } else {
+                draw_coord(tc)
+            };
+            let y1 = if tc.draw(generators::booleans()) {
+                y0
+            } else {
+                draw_coord(tc)
+            };
+            Box2D::new(
+                point2(x0.min(x1), y0.min(y1)),
+                point2(x0.max(x1), y0.max(y1)),
+            )
+        }
+
+        // Box2D -> Rect -> Box2D must be the exact identity for integer
+        // coordinates (`to_rect` stores min and max - min; `to_box2d`
+        // reconstructs origin and origin + size).
+        #[hegel::test]
+        fn hegel_box_rect_box_roundtrip_is_identity(tc: hegel::TestCase) {
+            // Arbitrary boxes, including negative (min > max) ones: the
+            // conversion is pure arithmetic and must roundtrip regardless.
+            let b: Box2D<i64> = Box2D::new(
+                point2(draw_coord(&tc), draw_coord(&tc)),
+                point2(draw_coord(&tc), draw_coord(&tc)),
+            );
+            assert_eq!(b.to_rect().to_box2d(), b);
+        }
+
+        // KNOWN FAILURE: real bug (inconsistent empty-box handling).
+        // `intersection()` documents "returning None if the boxes do not
+        // intersect", i.e. it must agree with `intersects()`. But for an
+        // empty (degenerate) box lying strictly inside another box,
+        // `intersects()` returns true (its strict comparisons all hold, e.g.
+        // a = [(0,0),(0,0)], b = [(-1,-1),(1,1)]) while `intersection()`
+        // returns None because the computed intersection is empty.
+        // Code paths: `Box2D::intersects()` vs `Box2D::intersection()` in
+        // src/box2d.rs.
+        #[hegel::test(test_cases = 300)]
+        fn hegel_intersects_iff_intersection_is_some(tc: hegel::TestCase) {
+            let a = draw_box(&tc);
+            let b = draw_box(&tc);
+            assert_eq!(
+                a.intersects(&b),
+                a.intersection(&b).is_some(),
+                "intersects() and intersection() disagree for {a:?} and {b:?}"
+            );
+        }
+
+        // When an intersection exists it must be non-empty and contained in
+        // both operands.
+        #[hegel::test]
+        fn hegel_intersection_is_contained_in_both(tc: hegel::TestCase) {
+            let a = draw_box(&tc);
+            let b = draw_box(&tc);
+            if let Some(i) = a.intersection(&b) {
+                assert!(!i.is_empty(), "intersection {i:?} is empty");
+                assert!(
+                    a.contains_box(&i) && b.contains_box(&i),
+                    "intersection {i:?} of {a:?} and {b:?} is not contained in both"
+                );
+            }
+        }
+
+        // The union of two boxes must contain both of them (`contains_box`
+        // is documented to return true when the probed box is empty, and
+        // `union` is documented to return the other box when one is empty).
+        #[hegel::test]
+        fn hegel_union_contains_both_operands(tc: hegel::TestCase) {
+            let a = draw_box(&tc);
+            let b = draw_box(&tc);
+            let u = a.union(&b);
+            assert!(
+                u.contains_box(&a) && u.contains_box(&b),
+                "union {u:?} does not contain both {a:?} and {b:?}"
+            );
+        }
+
+        // Documented on `from_points`: "The top/bottom/left/right-most
+        // points are exactly on the box's edges", and all input points are
+        // contained "when probed with contains_inclusive".
+        #[hegel::test]
+        fn hegel_from_points_contains_all_points_inclusive(tc: hegel::TestCase) {
+            // NaN coordinates are excluded: comparisons against NaN are
+            // meaningless and the min/max scan cannot order them. Infinities
+            // are kept.
+            let points: Vec<crate::default::Point2D<f64>> =
+                tc.draw((generators::vecs(hegel::compose!(|tc| {
+                    point2(
+                        tc.draw(generators::floats::<f64>().allow_nan(false)),
+                        tc.draw(generators::floats::<f64>().allow_nan(false)),
+                    )
+                }))).print_as_debug());
+            let b = Box2D::from_points(&points);
+            for p in &points {
+                assert!(
+                    b.contains_inclusive(*p),
+                    "{b:?} from_points does not contain input point {p:?}"
+                );
+            }
+        }
+    }
 }
diff --git a/src/point.rs b/src/point.rs
index 2097c72..186da12 100644
--- a/src/point.rs
+++ b/src/point.rs
@@ -2003,6 +2003,33 @@ mod point2d {
             assert_eq!(p.div_euclid(&-s), point2(-1.0, -2.0));
         }
     }
+
+    mod hegel_props {
+        use crate::default::Point2D;
+        use crate::point2;
+        use hegel::generators;
+
+        // The doc examples of `lerp` show exact results at t = 0 and t = 1
+        // (`from.lerp(to, 0.0) == from`, `from.lerp(to, 1.0) == to`), and the
+        // `one_t * self + t * other` formulation makes that exact for any
+        // finite endpoints.
+        //
+        // Infinite endpoints are excluded: `0.0 * inf` is NaN by IEEE-754
+        // rules, so endpoint exactness inherently only applies to finite
+        // points.
+        #[hegel::test]
+        fn hegel_lerp_is_exact_at_endpoints(tc: hegel::TestCase) {
+            let coord = || {
+                generators::floats::<f64>()
+                    .allow_nan(false)
+                    .allow_infinity(false)
+            };
+            let from: Point2D<f64> = point2(tc.draw(coord()), tc.draw(coord()));
+            let to: Point2D<f64> = point2(tc.draw(coord()), tc.draw(coord()));
+            assert_eq!(from.lerp(to, 0.0), from, "lerp(t = 0) is not `from`");
+            assert_eq!(from.lerp(to, 1.0), to, "lerp(t = 1) is not `to`");
+        }
+    }
 }
 
