+/// Property: none of the eight IRI/URI string type parsers panic, whatever
+/// the input (they must return `Err` for invalid input instead).
+#[hegel::test]
+fn parse_never_panics_on_arbitrary_input(tc: hegel::TestCase) {
+    let s = tc.draw(utils::pbt::parser_input_strings());
+    let _ = IriReferenceStr::new(&s);
+    let _ = UriReferenceStr::new(&s);
+    let _ = IriStr::new(&s);
+    let _ = UriStr::new(&s);
+    let _ = IriAbsoluteStr::new(&s);
+    let _ = UriAbsoluteStr::new(&s);
+    let _ = IriRelativeStr::new(&s);
+    let _ = UriRelativeStr::new(&s);
+}
+
+/// Property: parse successes across the eight string types respect the
+/// documented type hierarchy:
+///
+/// * every URI type is a subset of the corresponding IRI type,
+/// * absolute IRI implies IRI implies IRI reference, relative implies reference,
+/// * a reference is exactly an IRI or a relative reference, never both,
+/// * an IRI is absolute exactly when it has no fragment part.
+///
+/// KNOWN FAILURE (suspected library bug): `IriAbsoluteStr`/`UriAbsoluteStr`
+/// accept strings with an *empty* fragment part (a trailing `#`), e.g.
+/// `"a:#"` or `"AA://@?#"`, although the `absolute-IRI`/`absolute-URI` rules
+/// (RFC 3987 section 2.2 / RFC 3986 section 4.3) do not allow any fragment
+/// part, and the type documents itself as "RiStr without fragment part".
+/// Cause: `validate_after_path` in `src/parser/validate.rs` rejects a
+/// forbidden fragment via `!maybe_fragment.is_empty()`, which cannot
+/// distinguish "no `#` present" from "`#` present with empty fragment".
+///
+/// The case count is raised because the failure needs a conjunction (valid
+/// absolute IRI and a trailing `#`) that the default count often misses.
+#[hegel::test(test_cases = 1000)]
+fn parse_results_respect_type_hierarchy(tc: hegel::TestCase) {
+    let s = tc.draw(utils::pbt::parser_input_strings());
+
+    let iri_ref = IriReferenceStr::new(&s).is_ok();
+    let iri_normal = IriStr::new(&s).is_ok();
+    let iri_abs = IriAbsoluteStr::new(&s).is_ok();
+    let iri_rel = IriRelativeStr::new(&s).is_ok();
+    let uri_ref = UriReferenceStr::new(&s).is_ok();
+    let uri_normal = UriStr::new(&s).is_ok();
+    let uri_abs = UriAbsoluteStr::new(&s).is_ok();
+    let uri_rel = UriRelativeStr::new(&s).is_ok();
+
+    // URI is a subset of IRI, for every kind.
+    assert!(!uri_ref || iri_ref, "valid URI reference must be a valid IRI reference: {s:?}");
+    assert!(!uri_normal || iri_normal, "valid URI must be a valid IRI: {s:?}");
+    assert!(!uri_abs || iri_abs, "valid absolute URI must be a valid absolute IRI: {s:?}");
+    assert!(!uri_rel || iri_rel, "valid relative URI must be a valid relative IRI: {s:?}");
+
+    // Kind hierarchy, for both specs.
+    for (kind_abs, kind_normal, kind_rel, kind_ref) in [
+        (iri_abs, iri_normal, iri_rel, iri_ref),
+        (uri_abs, uri_normal, uri_rel, uri_ref),
+    ] {
+        assert!(!kind_abs || kind_normal, "absolute implies normal: {s:?}");
+        assert!(!kind_normal || kind_ref, "normal implies reference: {s:?}");
+        assert!(!kind_rel || kind_ref, "relative implies reference: {s:?}");
+        assert_eq!(
+            kind_ref,
+            kind_normal || kind_rel,
+            "reference is exactly (IRI or relative): {s:?}"
+        );
+        assert!(!(kind_normal && kind_rel), "IRI and relative are disjoint: {s:?}");
+    }
+
+    // Absolute IRI/URI is exactly an IRI/URI without a fragment part.
+    if let Ok(iri) = IriStr::new(&s) {
+        assert_eq!(
+            iri_abs,
+            iri.fragment().is_none(),
+            "IRI is absolute iff it has no fragment: {s:?}"
+        );
+    }
+    if let Ok(uri) = UriStr::new(&s) {
+        assert_eq!(
+            uri_abs,
+            uri.fragment().is_none(),
+            "URI is absolute iff it has no fragment: {s:?}"
+        );
+    }
+}
+
+/// Property: the component getters (`scheme_str`, `authority_str`,
+/// `path_str`, `query_str`, `fragment_str`) of a parsed reference recompose
+/// to the original string by the RFC 3986 section 5.3 algorithm.
+#[hegel::test]
+fn components_recompose_to_original(tc: hegel::TestCase) {
+    let uri_only = tc.draw(hegel::generators::booleans());
+    let s = tc.draw(utils::pbt::iri_reference_strings(uri_only));
+    let r = IriReferenceStr::new(&s).expect("generator should produce valid IRI references");
+
+    let recomposed = utils::pbt::recompose(
+        r.scheme_str(),
+        r.authority_str(),
+        r.path_str(),
+        r.query_str(),
+        r.fragment_str(),
+    );
+    assert_eq!(recomposed, s, "components should recompose to the original");
+}
+
+/// Property: the authority sub-component getters (`userinfo`, `host`,
+/// `port`) recompose to exactly the `authority_str` value, and
+/// `authority_components` is present exactly when `authority_str` is.
+#[hegel::test]
+fn authority_components_recompose_to_authority(tc: hegel::TestCase) {
+    let uri_only = tc.draw(hegel::generators::booleans());
+    let s = tc.draw(utils::pbt::iri_reference_strings(uri_only));
+    let r = IriReferenceStr::new(&s).expect("generator should produce valid IRI references");
+
+    match r.authority_components() {
+        Some(components) => {
+            let authority = r
+                .authority_str()
+                .expect("authority_components implies authority_str");
+            let mut recomposed = String::new();
+            if let Some(userinfo) = components.userinfo() {
+                recomposed.push_str(userinfo);
+                recomposed.push('@');
+            }
+            recomposed.push_str(components.host());
+            if let Some(port) = components.port() {
+                recomposed.push(':');
+                recomposed.push_str(port);
+            }
+            assert_eq!(
+                recomposed, authority,
+                "authority components should recompose to authority: {s:?}"
+            );
+        }
+        None => assert!(
+            r.authority_str().is_none(),
+            "authority_str implies authority_components: {s:?}"
+        ),
+    }
+}
