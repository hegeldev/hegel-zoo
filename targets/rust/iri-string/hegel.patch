+/// Property: `encode_to_uri()` is idempotent — encoding an already-encoded
+/// (pure URI) reference changes nothing.
+#[cfg(feature = "alloc")]
+#[hegel::test]
+fn encode_to_uri_is_idempotent_pbt(tc: hegel::TestCase) {
+    let s = tc.draw(utils::pbt::iri_reference_strings(false));
+    let iri = IriReferenceStr::new(&s).expect("generator should produce valid IRI references");
+
+    let encoded = iri.encode_to_uri().to_string();
+    let encoded_ref =
+        UriReferenceStr::new(&encoded).expect("encode_to_uri output should be a valid URI");
