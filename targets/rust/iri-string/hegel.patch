 use iri_string::percent_encode::{PercentEncodedForIri, PercentEncodedForUri};
 
+/// Encodes `raw` for the component selected by `kind`, using spec `S`.
+///
+/// Kinds: 0 = reg_name, 1 = user, 2 = password, 3 = path_segment, 4 = path,
+/// 5 = query, 6 = fragment, 7 = unreserve, 8 = characters.
+#[cfg(feature = "alloc")]
+fn encode_component<S: iri_string::spec::Spec>(kind: u8, raw: &str) -> String {
+    use iri_string::percent_encode::PercentEncoded;
+    match kind {
+        0 => PercentEncoded::<_, S>::from_reg_name(raw).to_string(),
+        1 => PercentEncoded::<_, S>::from_user(raw).to_string(),
+        2 => PercentEncoded::<_, S>::from_password(raw).to_string(),
+        3 => PercentEncoded::<_, S>::from_path_segment(raw).to_string(),
+        4 => PercentEncoded::<_, S>::from_path(raw).to_string(),
+        5 => PercentEncoded::<_, S>::from_query(raw).to_string(),
+        6 => PercentEncoded::<_, S>::from_fragment(raw).to_string(),
+        7 => PercentEncoded::<_, S>::unreserve(raw).to_string(),
+        _ => PercentEncoded::<_, S>::characters(raw).to_string(),
+    }
+}
+
+/// Property: percent-encoding an arbitrary string for any component (and for
+/// either spec) is lossless — percent-decoding the result yields the
+/// original string.
+#[cfg(feature = "alloc")]
+#[hegel::test]
+fn percent_encoding_roundtrips_through_percent_decoding(tc: hegel::TestCase) {
+    let raw: String = tc.draw(hegel::generators::text());
+    let kind = tc.draw(hegel::generators::integers::<u8>().max_value(8));
+
+    for encoded in [
+        encode_component::<iri_string::spec::UriSpec>(kind, &raw),
+        encode_component::<iri_string::spec::IriSpec>(kind, &raw),
+    ] {
+        let decoded = utils::pbt::pct_decode_to_bytes(&encoded);
+        assert_eq!(
+            String::from_utf8(decoded).as_deref(),
+            Ok(raw.as_str()),
+            "percent-decoding should recover the input: kind={kind}, encoded={encoded:?}"
+        );
+    }
+}
+
+/// Property: the output of each component encoder is valid for that
+/// component, as judged by the crate's own validators (`characters` is
+/// excluded: it is documented not to guarantee validity).
+#[cfg(feature = "alloc")]
+#[hegel::test]
+fn percent_encoded_components_are_valid_for_their_component(tc: hegel::TestCase) {
+    use iri_string::spec::{IriSpec, UriSpec};
+    use iri_string::validate;
+
+    let raw: String = tc.draw(hegel::generators::text());
+    let kind = tc.draw(hegel::generators::integers::<u8>().max_value(7));
+
+    let uri = encode_component::<UriSpec>(kind, &raw);
+    let iri = encode_component::<IriSpec>(kind, &raw);
+    let (uri_result, iri_result) = match kind {
+        0 => (
+            validate::reg_name::<UriSpec>(&uri),
+            validate::reg_name::<IriSpec>(&iri),
+        ),
+        // `user` and `password` are both substrings of `userinfo`.
+        1 | 2 => (
+            validate::userinfo::<UriSpec>(&uri),
+            validate::userinfo::<IriSpec>(&iri),
+        ),
+        // `unreserve` output consists only of unreserved characters and
+        // percent-encoded triplets, which is a valid path segment.
+        3 | 7 => (
+            validate::path_segment::<UriSpec>(&uri),
+            validate::path_segment::<IriSpec>(&iri),
+        ),
+        4 => (
+            validate::path::<UriSpec>(&uri),
+            validate::path::<IriSpec>(&iri),
+        ),
+        5 => (
+            validate::query::<UriSpec>(&uri),
+            validate::query::<IriSpec>(&iri),
+        ),
+        _ => (
+            validate::fragment::<UriSpec>(&uri),
+            validate::fragment::<IriSpec>(&iri),
+        ),
+    };
+    assert!(
+        uri_result.is_ok(),
+        "URI-encoded component should be valid: kind={kind}, raw={raw:?}, encoded={uri:?}"
+    );
+    assert!(
+        iri_result.is_ok(),
+        "IRI-encoded component should be valid: kind={kind}, raw={raw:?}, encoded={iri:?}"
+    );
+}
