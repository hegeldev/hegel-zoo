+//! Generators and independent oracles for hegel property-based tests.
+//!
+//! This module is shared between multiple integration test binaries, and not
+//! every binary uses every item, hence the `dead_code` allowance.
+#![allow(dead_code)]
+
+use hegel::generators;
+use hegel::TestCase;
+
+/// `ALPHA` characters (RFC 2234 / RFC 3986).
+const ALPHA: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
+/// `DIGIT` characters.
+const DIGIT: &str = "0123456789";
+/// Non-alphanumeric `unreserved` characters (RFC 3986 section 2.3).
+const UNRESERVED_MARKS: &str = "-._~";
+/// `sub-delims` characters (RFC 3986 section 2.2).
+const SUB_DELIMS: &str = "!$&'()*+,;=";
+
+/// `ucschar` codepoint ranges (RFC 3987 section 2.2), all inclusive.
+const UCSCHAR_RANGES: &[(u32, u32)] = &[
+    (0xA0, 0xD7FF),
+    (0xF900, 0xFDCF),
+    (0xFDF0, 0xFFEF),
+    (0x1_0000, 0x1_FFFD),
+    (0x2_0000, 0x2_FFFD),
+    (0x3_0000, 0x3_FFFD),
+    (0x4_0000, 0x4_FFFD),
+    (0x5_0000, 0x5_FFFD),
+    (0x6_0000, 0x6_FFFD),
+    (0x7_0000, 0x7_FFFD),
+    (0x8_0000, 0x8_FFFD),
+    (0x9_0000, 0x9_FFFD),
+    (0xA_0000, 0xA_FFFD),
+    (0xB_0000, 0xB_FFFD),
+    (0xC_0000, 0xC_FFFD),
+    (0xD_0000, 0xD_FFFD),
+    (0xE_1000, 0xE_FFFD),
+];
+
+/// `iprivate` codepoint ranges (RFC 3987 section 2.2), allowed in query only.
+const IPRIVATE_RANGES: &[(u32, u32)] = &[
+    (0xE000, 0xF8FF),
+    (0xF_0000, 0xF_FFFD),
+    (0x10_0000, 0x10_FFFD),
+];
+
+/// Draws one character out of the given set.
+fn draw_char_from(tc: &TestCase, set: &str) -> char {
+    let chars: Vec<char> = set.chars().collect();
+    let idx = tc.draw(generators::integers::<usize>().max_value(chars.len() - 1));
+    chars[idx]
+}
+
+/// Draws a `ucschar` (optionally also `iprivate`) character.
+fn draw_ucschar(tc: &TestCase, allow_private: bool) -> char {
+    let mut ranges: Vec<(u32, u32)> = UCSCHAR_RANGES.to_vec();
+    if allow_private {
+        ranges.extend_from_slice(IPRIVATE_RANGES);
+    }
+    let (lo, hi) = tc.draw(generators::sampled_from(ranges));
+    let cp = tc.draw(generators::integers::<u32>().min_value(lo).max_value(hi));
+    char::from_u32(cp).expect("ucschar/iprivate ranges contain only valid scalar values")
+}
+
+/// Draws a component string built from `unreserved`, `sub-delims`,
+/// percent-encoded triplets, the extra ASCII characters in `extra`, and
+/// (for the IRI spec) `ucschar` / `iprivate` characters.
+///
+/// `min_picks` is the minimum number of "picks"; each pick contributes at
+/// least one character, so the result is non-empty iff `min_picks > 0`.
+fn component(
+    tc: &TestCase,
+    extra: &str,
+    allow_ucs: bool,
+    allow_private: bool,
+    min_picks: usize,
+) -> String {
+    let ascii_set = format!("{ALPHA}{DIGIT}{UNRESERVED_MARKS}{SUB_DELIMS}{extra}");
+    let picks = tc.draw(
+        generators::integers::<usize>()
+            .min_value(min_picks)
+            .max_value(min_picks + 8),
+    );
+    let mut out = String::new();
+    for _ in 0..picks {
+        match tc.draw(generators::integers::<u8>().max_value(9)) {
+            // ASCII characters directly allowed in the component.
+            0..=5 => out.push(draw_char_from(tc, &ascii_set)),
+            // Percent-encoded octet (any octet is allowed by the grammar).
+            6 | 7 => {
+                let byte = tc.draw(generators::integers::<u8>());
+                let uppercase = tc.draw(generators::booleans());
+                if uppercase {
+                    out.push_str(&format!("%{byte:02X}"));
+                } else {
+                    out.push_str(&format!("%{byte:02x}"));
+                }
+            }
+            // Non-ASCII characters (IRI only).
+            _ => {
+                if allow_ucs {
+                    out.push(draw_ucschar(tc, allow_private));
+                } else {
+                    out.push(draw_char_from(tc, &ascii_set));
+                }
+            }
+        }
+    }
+    out
+}
+
+/// Draws a valid `scheme` string (RFC 3986 section 3.1).
+fn draw_scheme(tc: &TestCase) -> String {
+    let mut out = String::new();
+    out.push(draw_char_from(tc, ALPHA));
+    let rest = tc.draw(generators::integers::<usize>().max_value(6));
+    let set = format!("{ALPHA}{DIGIT}+-.");
+    for _ in 0..rest {
+        out.push(draw_char_from(tc, &set));
+    }
+    out
+}
+
+/// Draws a valid `host` (`ihost`): reg-name, IPv4 address, or IP-literal.
+fn draw_host(tc: &TestCase, allow_ucs: bool) -> String {
+    match tc.draw(generators::integers::<u8>().max_value(5)) {
+        // reg-name (may be empty).
+        0..=3 => component(tc, "", allow_ucs, false, 0),
+        // IPv4 address.
+        4 => {
+            let a = tc.draw(generators::integers::<u8>());
+            let b = tc.draw(generators::integers::<u8>());
+            let c = tc.draw(generators::integers::<u8>());
+            let d = tc.draw(generators::integers::<u8>());
+            format!("{a}.{b}.{c}.{d}")
+        }
+        // IP-literal (IPv6 or IPvFuture).
+        _ => tc.draw(generators::sampled_from(vec![
+            "[2001:db8::7]".to_string(),
+            "[::1]".to_string(),
+            "[::]".to_string(),
+            "[::ffff:192.0.2.128]".to_string(),
+            "[1080:0:0:0:8:800:200C:417A]".to_string(),
+            "[v1.fe]".to_string(),
+        ])),
+    }
+}
+
+/// Draws a valid `authority` (`iauthority`) string.
+fn draw_authority(tc: &TestCase, allow_ucs: bool) -> String {
+    let mut out = String::new();
+    if tc.draw(generators::booleans()) {
+        out.push_str(&component(tc, ":", allow_ucs, false, 0));
+        out.push('@');
+    }
+    out.push_str(&draw_host(tc, allow_ucs));
+    if tc.draw(generators::booleans()) {
+        out.push(':');
+        // The port may be empty.
+        let digits = tc.draw(generators::integers::<usize>().max_value(5));
+        for _ in 0..digits {
+            out.push(draw_char_from(tc, DIGIT));
+        }
+    }
+    out
+}
+
+/// Appends zero or more `/`-prefixed (possibly empty) path segments.
+fn draw_segments_onto(tc: &TestCase, out: &mut String, allow_ucs: bool) {
+    let n = tc.draw(generators::integers::<usize>().max_value(4));
+    for _ in 0..n {
+        out.push('/');
+        out.push_str(&component(tc, ":@", allow_ucs, false, 0));
+    }
+}
+
+/// Which kind of reference to build.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum RefKind {
+    /// Any IRI reference (scheme optional, fragment allowed).
+    AnyReference,
+    /// IRI (scheme required, fragment allowed).
+    Iri,
+    /// Absolute IRI (scheme required, no fragment).
+    AbsoluteIri,
+}
+
+/// Builds a syntactically valid IRI reference from drawn components,
+/// following the RFC 3986/3987 grammar rules directly.
+fn build_reference(tc: &TestCase, uri_only: bool, kind: RefKind) -> String {
+    let allow_ucs = !uri_only;
+    let has_scheme = match kind {
+        RefKind::AnyReference => tc.draw(generators::booleans()),
+        RefKind::Iri | RefKind::AbsoluteIri => true,
+    };
+    let mut out = String::new();
+    if has_scheme {
+        out.push_str(&draw_scheme(tc));
+        out.push(':');
+    }
+    if tc.draw(generators::booleans()) {
+        // With authority: path must be `path-abempty` (`*( "/" segment )`).
+        out.push_str("//");
+        out.push_str(&draw_authority(tc, allow_ucs));
+        draw_segments_onto(tc, &mut out, allow_ucs);
+    } else {
+        // Without authority the path must not start with `//`.
+        match tc.draw(generators::integers::<u8>().max_value(2)) {
+            // path-empty.
+            0 => {}
+            // path-absolute: "/" [ segment-nz *( "/" segment ) ].
+            1 => {
+                out.push('/');
+                if tc.draw(generators::booleans()) {
+                    out.push_str(&component(tc, ":@", allow_ucs, false, 1));
+                    draw_segments_onto(tc, &mut out, allow_ucs);
+                }
+            }
+            // path-rootless (with scheme) / path-noscheme (without).
+            // The first segment must be non-empty, and without a scheme it
+            // must not contain `:`.
+            _ => {
+                let first_extra = if has_scheme { ":@" } else { "@" };
+                out.push_str(&component(tc, first_extra, allow_ucs, false, 1));
+                draw_segments_onto(tc, &mut out, allow_ucs);
+            }
+        }
+    }
+    if tc.draw(generators::booleans()) {
+        out.push('?');
+        out.push_str(&component(tc, ":@/?", allow_ucs, allow_ucs, 0));
+    }
+    if kind != RefKind::AbsoluteIri && tc.draw(generators::booleans()) {
+        out.push('#');
+        out.push_str(&component(tc, ":@/?", allow_ucs, false, 0));
+    }
+    out
+}
+
+/// Generates syntactically valid IRI reference strings (scheme optional,
+/// fragment allowed). With `uri_only`, restricts output to ASCII (URIs).
+#[hegel::composite]
+pub fn iri_reference_strings(tc: &TestCase, uri_only: bool) -> String {
+    build_reference(&tc, uri_only, RefKind::AnyReference)
+}
+
+/// Generates syntactically valid IRI strings (scheme required, fragment
+/// allowed). With `uri_only`, restricts output to ASCII (URIs).
+#[hegel::composite]
+pub fn iri_strings(tc: &TestCase, uri_only: bool) -> String {
+    build_reference(&tc, uri_only, RefKind::Iri)
+}
+
+/// Generates syntactically valid absolute IRI strings (scheme required, no
+/// fragment). With `uri_only`, restricts output to ASCII (URIs).
+#[hegel::composite]
+pub fn absolute_iri_strings(tc: &TestCase, uri_only: bool) -> String {
+    build_reference(&tc, uri_only, RefKind::AbsoluteIri)
+}
+
+/// Characters likely to hit URI parser edge cases: delimiters, percent signs,
+/// characters invalid in IRIs, controls, and boundary non-ASCII codepoints.
+const SOUP_CHARS: &[char] = &[
+    'a', 'z', 'A', 'Z', '0', '9', ':', '/', '?', '#', '[', ']', '@', '!', '$', '&', '\'', '(',
+    ')', '*', '+', ',', ';', '=', '-', '.', '_', '~', '%', '2', 'e', 'E', ' ', '<', '>', '"',
+    '\\', '^', '`', '{', '}', '|', '\u{0}', '\u{7f}', '\u{80}', '\u{a0}', '\u{e9}', '\u{300}',
+    '\u{d7ff}', '\u{e000}', '\u{fffd}', '\u{10000}', '\u{10fffd}', '\u{1f363}',
+];
+
+/// Generates strings for parser robustness testing: arbitrary Unicode text,
+/// URI-flavored character soup, valid references, and valid references with
+/// one arbitrary character inserted.
+#[hegel::composite]
+pub fn parser_input_strings(tc: &TestCase) -> String {
+    match tc.draw(generators::integers::<u8>().max_value(3)) {
+        // Fully arbitrary Unicode text.
+        0 => tc.draw(generators::text()),
+        // URI-flavored character soup.
+        1 => {
+            let n = tc.draw(generators::integers::<usize>().max_value(30));
+            let mut out = String::new();
+            for _ in 0..n {
+                let idx = tc.draw(generators::integers::<usize>().max_value(SOUP_CHARS.len() - 1));
+                out.push(SOUP_CHARS[idx]);
+            }
+            out
+        }
+        // A valid reference, as-is.
+        2 => {
+            let uri_only = tc.draw(generators::booleans());
+            build_reference(&tc, uri_only, RefKind::AnyReference)
+        }
+        // A valid reference with one arbitrary character inserted.
+        _ => {
+            let mut out = build_reference(&tc, false, RefKind::AnyReference);
+            let idx = tc.draw(generators::integers::<usize>().max_value(SOUP_CHARS.len() - 1));
+            let c = SOUP_CHARS[idx];
+            let positions: Vec<usize> = (0..=out.len())
+                .filter(|&i| out.is_char_boundary(i))
+                .collect();
+            let pos_idx =
+                tc.draw(generators::integers::<usize>().max_value(positions.len() - 1));
+            out.insert(positions[pos_idx], c);
+            out
+        }
+    }
+}
+
+/// Recomposes IRI components following RFC 3986 section 5.3 exactly.
+///
+/// This is an independent oracle for the component getters of the IRI types.
+pub fn recompose(
+    scheme: Option<&str>,
+    authority: Option<&str>,
+    path: &str,
+    query: Option<&str>,
+    fragment: Option<&str>,
+) -> String {
+    let mut result = String::new();
+    if let Some(scheme) = scheme {
+        result.push_str(scheme);
+        result.push(':');
+    }
+    if let Some(authority) = authority {
+        result.push_str("//");
+        result.push_str(authority);
+    }
+    result.push_str(path);
+    if let Some(query) = query {
+        result.push('?');
+        result.push_str(query);
+    }
+    if let Some(fragment) = fragment {
+        result.push('#');
+        result.push_str(fragment);
+    }
+    result
+}
+
+/// Decodes all percent-encoded triplets in `s` into raw bytes; other
+/// characters pass through as their UTF-8 bytes.
+///
+/// Panics on a malformed triplet; the tests only feed it strings that are
+/// supposed to be valid, so a panic there is itself a finding.
+pub fn pct_decode_to_bytes(s: &str) -> Vec<u8> {
+    let bytes = s.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        if bytes[i] == b'%' {
+            let hex = s
+                .get(i + 1..i + 3)
+                .expect("percent sign must be followed by two hex digits");
+            out.push(u8::from_str_radix(hex, 16).expect("invalid percent-encoded triplet"));
+            i += 3;
+        } else {
+            out.push(bytes[i]);
+            i += 1;
+        }
+    }
+    out
+}
+
+/// Replaces `%2E` / `%2e` with `.` in a path segment.
+fn pct_dot_normalized(segment: &str) -> String {
+    segment.replace("%2E", ".").replace("%2e", ".")
+}
+
+/// Returns true if the segment is a dot segment (`.` or `..`), counting
+/// percent-encoded dots (`%2E`) as dots, like this crate's resolver does.
+pub fn is_dot_segment(segment: &str) -> bool {
+    let normalized = pct_dot_normalized(segment);
+    normalized == "." || normalized == ".."
+}
+
+/// Returns true if the segment is a dot segment only thanks to
+/// percent-encoded dots (e.g. `%2E`, `.%2e`, `%2E%2E`).
+pub fn is_pct_dot_segment(segment: &str) -> bool {
+    segment.contains('%') && is_dot_segment(segment)
+}
+
+/// Returns true if any segment of the path is a percent-encoded dot segment.
+pub fn path_has_pct_dot_segment(path: &str) -> bool {
+    path.split('/').any(is_pct_dot_segment)
+}
+
+/// Returns true if any segment of the path is a dot segment (plain or
+/// percent-encoded).
+pub fn path_has_dot_segment(path: &str) -> bool {
+    path.split('/').any(is_dot_segment)
+}
