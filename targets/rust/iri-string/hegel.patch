+/// Property: `resolve_against` agrees with an independent implementation of
+/// the plain RFC 3986 section 5.2 algorithm, except for the single documented
+/// divergence (WHATWG-style `/.` serialization when the target has no
+/// authority but its path starts with `//`).
+#[cfg(feature = "alloc")]
+#[hegel::test]
+fn resolve_agrees_with_rfc3986_reference_implementation(tc: hegel::TestCase) {
+    let uri_only = tc.draw(hegel::generators::booleans());
+    let base_s = tc.draw(utils::pbt::absolute_iri_strings(uri_only));
+    let ref_s = tc.draw(utils::pbt::iri_reference_strings(uri_only));
+    let base = IriAbsoluteStr::new(&base_s).expect("generator should produce valid absolute IRIs");
+    let reference =
+        IriReferenceStr::new(&ref_s).expect("generator should produce valid IRI references");
+
+    // The crate intentionally treats wholly-percent-encoded dot segments
+    // (e.g. `%2E`, `.%2e`) as dot segments during resolution; the plain
+    // RFC 3986 algorithm does not. Skip those inputs.
+    tc.assume(!utils::pbt::path_has_pct_dot_segment(base.path_str()));
+    tc.assume(!utils::pbt::path_has_pct_dot_segment(reference.path_str()));
+
+    let resolved = reference.resolve_against(base).to_dedicated_string();
+    let expected = resolve_refimpl(reference, base);
+    if resolved != expected {
+        // Divergence is only allowed for the documented case: the plain
+        // RFC 3986 recomposition cannot represent an authority-less path
+        // starting with `//`, so the crate serializes it with a `/.` prefix.
+        let scheme = resolved.scheme_str();
+        assert!(
+            resolved.as_str().starts_with(&format!("{scheme}:/.//")),
+            "unexpected divergence from RFC 3986 reference implementation: \
+             base={base_s:?}, ref={ref_s:?}, resolved={resolved:?}, refimpl={expected:?}"
+        );
+        assert_eq!(
+            resolved.as_str().replacen(":/.//", "://", 1),
+            expected.as_str(),
+            "divergence beyond WHATWG `//`-path serialization: base={base_s:?}, ref={ref_s:?}"
+        );
+    }
+}
+
+/// Property: resolution output is a valid IRI, and (when its path contains no
+/// dot segments) it is a fixed point of resolution: resolving the resolved
+/// IRI against the same base yields it unchanged.
+#[cfg(feature = "alloc")]
+#[hegel::test]
+fn resolution_output_is_fixed_point_of_resolution(tc: hegel::TestCase) {
+    let uri_only = tc.draw(hegel::generators::booleans());
+    let base_s = tc.draw(utils::pbt::absolute_iri_strings(uri_only));
+    let ref_s = tc.draw(utils::pbt::iri_reference_strings(uri_only));
+    let base = IriAbsoluteStr::new(&base_s).expect("generator should produce valid absolute IRIs");
+    let reference =
+        IriReferenceStr::new(&ref_s).expect("generator should produce valid IRI references");
+
+    let resolved = reference.resolve_against(base).to_dedicated_string();
+    let resolved = IriStr::new(resolved.as_str())
+        .unwrap_or_else(|e| panic!("resolution output should be a valid IRI: {resolved:?}: {e}"));
+
+    // A reference with an empty path keeps the base path verbatim, so the
+    // result can still contain dot segments (plain or percent-encoded); such
+    // results are not fixed points and are excluded.
+    tc.assume(!utils::pbt::path_has_dot_segment(resolved.path_str()));
+
+    let re_resolved = AsRef::<IriReferenceStr>::as_ref(resolved)
+        .resolve_against(base)
+        .to_dedicated_string();
+    assert_eq!(
+        re_resolved.as_str(),
+        resolved.as_str(),
+        "resolving an already-resolved IRI should be identity: base={base_s:?}, ref={ref_s:?}"
+    );
+}
