+
+// ===========================================================================
+// Property-based tests (hegel)
+// ===========================================================================
+
+mod hegel_properties {
+    use hegel::Generator;
+    use byte_unit::{Byte, Unit, UnitType};
+    use hegel::generators;
+    use rust_decimal::prelude::*;
+
+    /// The maximum byte value representable by `Byte` in the active configuration.
+    #[cfg(feature = "u128")]
+    const MAX_BYTES: u128 = 1_000_000_000_000_000_000_000_000_000 - 1; // 10^27 - 1
+    #[cfg(not(feature = "u128"))]
+    const MAX_BYTES: u128 = u64::MAX as u128;
+
+    /// The maximum documented precision for `get_recoverable_unit`.
+    #[cfg(feature = "u128")]
+    const MAX_PRECISION: usize = 26;
+    #[cfg(not(feature = "u128"))]
+    const MAX_PRECISION: usize = 19;
+
+    fn all_units() -> Vec<Unit> {
+        vec![
+            Unit::Bit,
+            Unit::B,
+            Unit::Kbit,
+            Unit::Kibit,
+            Unit::KB,
+            Unit::KiB,
+            Unit::Mbit,
+            Unit::Mibit,
+            Unit::MB,
+            Unit::MiB,
+            Unit::Gbit,
+            Unit::Gibit,
+            Unit::GB,
+            Unit::GiB,
+            Unit::Tbit,
+            Unit::Tibit,
+            Unit::TB,
+            Unit::TiB,
+            Unit::Pbit,
+            Unit::Pibit,
+            Unit::PB,
+            Unit::PiB,
+            Unit::Ebit,
+            Unit::Eibit,
+            Unit::EB,
+            Unit::EiB,
+            #[cfg(feature = "u128")]
+            Unit::Zbit,
+            #[cfg(feature = "u128")]
+            Unit::Zibit,
+            #[cfg(feature = "u128")]
+            Unit::ZB,
+            #[cfg(feature = "u128")]
+            Unit::ZiB,
+            #[cfg(feature = "u128")]
+            Unit::Ybit,
+            #[cfg(feature = "u128")]
+            Unit::Yibit,
+            #[cfg(feature = "u128")]
+            Unit::YB,
+            #[cfg(feature = "u128")]
+            Unit::YiB,
+        ]
+    }
+
+    /// Number of bytes a (non-`Bit`) unit represents, derived from the public
+    /// `as_bits_u128` so tests don't depend on crate-private helpers.
+    fn unit_bytes(unit: Unit) -> u128 {
+        assert_ne!(unit, Unit::Bit);
+        unit.as_bits_u128() >> 3
+    }
+
+    /// A `Byte` covering the full representable range, boosted toward
+    /// boundaries and toward exact multiples of units (interesting for the
+    /// exact/recoverable-unit paths).
+    #[hegel::composite]
+    fn arb_byte(tc: &hegel::TestCase) -> Byte {
+        let v = match tc.draw(generators::integers::<u8>().max_value(2)) {
+            0 => tc.draw(generators::integers::<u128>().max_value(MAX_BYTES)),
+            1 => tc.draw(generators::sampled_from(vec![0, 1, MAX_BYTES - 1, MAX_BYTES])),
+            _ => {
+                let unit = tc.draw((generators::sampled_from(
+                    all_units().into_iter().filter(|u| *u != Unit::Bit).collect::<Vec<_>>(),
+                )).print_as_debug());
+                let ub = unit_bytes(unit);
+                let m = tc.draw(generators::integers::<u128>().max_value(MAX_BYTES / ub));
+                m * ub
+            },
+        };
+
+        Byte::from_u128(v).unwrap()
+    }
+
+    // -----------------------------------------------------------------------
+    // Parse robustness
+    // -----------------------------------------------------------------------
+
+    /// `Byte::parse_str` must never panic, for arbitrary garbage and for
+    /// near-miss numeric strings.
+    #[hegel::test]
+    fn byte_parse_str_never_panics(tc: hegel::TestCase) {
+        let s = if tc.draw(generators::booleans()) {
+            tc.draw(generators::text())
+        } else {
+            // near-miss numeric strings: a number followed by junk
+            let n = tc.draw(generators::integers::<u64>());
+            let mid = tc.draw(generators::sampled_from(vec![
+                "", ".", ".5", " ", "  ", "-", "e3", "..", ". ",
+            ]));
+            let tail = tc.draw(generators::text().max_size(6));
+            format!("{n}{mid}{tail}")
+        };
+        let ignore_case = tc.draw(generators::booleans());
+
+        drop(Byte::parse_str(&s, ignore_case));
+    }
+
+    // -----------------------------------------------------------------------
+    // Display / parse round-trips
+    // -----------------------------------------------------------------------
+
+    /// Plain `Display` output (a bare integer) must re-parse to the same
+    /// `Byte`, over the full representable range.
+    #[hegel::test]
+    fn display_reparses_to_same_byte(tc: hegel::TestCase) {
+        let byte = tc.draw((arb_byte()).print_as_debug());
+        let ignore_case = tc.draw(generators::booleans());
+
+        let s = byte.to_string();
+
+        assert_eq!(Ok(byte), Byte::parse_str(&s, ignore_case).map_err(|e| e.to_string()));
+    }
+
+    /// Alternate (`{:#}`) `Display` output uses `get_recoverable_unit`, which
+    /// is documented to be precise, so it must re-parse to the same `Byte` for
+    /// every documented format style and precision.
+    #[hegel::test]
+    fn alternate_display_reparses_to_same_byte(tc: hegel::TestCase) {
+        let byte = tc.draw((arb_byte()).print_as_debug());
+        let prec = tc.draw(generators::integers::<usize>().max_value(MAX_PRECISION));
+
+        let s = match tc.draw(generators::integers::<u8>().max_value(4)) {
+            0 => format!("{byte:#}"),
+            1 => format!("{byte:#.prec$}"),
+            2 => format!("{byte:-#}"),
+            3 => format!("{byte:>+#15.prec$}"),
+            _ => format!("{byte:#15}"),
+        };
+        tc.note(&format!("formatted: {s:?}"));
+
+        // The unit in the output is an exact byte-based unit string, so
+        // parsing must not depend on ignore_case.
+        assert_eq!(Ok(byte), Byte::parse_str(&s, false).map_err(|e| e.to_string()));
+    }
+
+    // -----------------------------------------------------------------------
+    // Unit-finding inverses
+    // -----------------------------------------------------------------------
+
+    /// `get_recoverable_unit` is documented to "find the appropriate unit and
+    /// value that can be used to recover back to this `Byte` precisely".
+    #[hegel::test]
+    fn recoverable_unit_recovers_byte_exactly(tc: hegel::TestCase) {
+        let byte = tc.draw((arb_byte()).print_as_debug());
+        let allow_in_bits = tc.draw(generators::booleans());
+        let precision = tc.draw(generators::integers::<usize>().max_value(MAX_PRECISION));
+
+        let (value, unit) = byte.get_recoverable_unit(allow_in_bits, precision);
+
+        assert_eq!(
+            Some(byte),
+            Byte::from_decimal_with_unit(value, unit),
+            "get_recoverable_unit({allow_in_bits}, {precision}) returned ({value}, {unit:?})"
+        );
+    }
+
+    /// `get_exact_unit` returns a unit that is a factor of the byte count and
+    /// a value that multiplies back to exactly the original `Byte`.
+    #[hegel::test]
+    fn exact_unit_recovers_byte_exactly(tc: hegel::TestCase) {
+        let byte = tc.draw((arb_byte()).print_as_debug());
+        let allow_in_bits = tc.draw(generators::booleans());
+
+        let (n, unit) = byte.get_exact_unit(allow_in_bits);
+
+        let ub = unit_bytes(unit); // `get_exact_unit` never returns `Bit`
+        assert_eq!(byte.as_u128(), n * ub, "unit {unit:?} is not an exact factor");
+        assert_eq!(Some(byte), Byte::from_u128_with_unit(n, unit));
+    }
+
+    // -----------------------------------------------------------------------
+    // Unit conversion exactness
+    // -----------------------------------------------------------------------
+
+    /// `from_u64_with_unit` must agree with independent u128 arithmetic:
+    /// `size * unit` bytes for byte-based units, `ceil(size / 8)` for `Bit`,
+    /// and `None` exactly when the result exceeds the representable maximum.
+    #[hegel::test]
+    fn from_u64_with_unit_matches_u128_arithmetic(tc: hegel::TestCase) {
+        let n = tc.draw(hegel::one_of!(
+            generators::integers::<u64>(),
+            generators::sampled_from(vec![0, 1, u64::MAX - 1, u64::MAX]),
+        ));
+        let unit = tc.draw((generators::sampled_from(all_units())).print_as_debug());
+
+        let expected: Option<u128> = if unit == Unit::Bit {
+            Some((n as u128).div_ceil(8))
+        } else {
+            (n as u128).checked_mul(unit_bytes(unit)).filter(|v| *v <= MAX_BYTES)
+        };
+
+        let result = Byte::from_u64_with_unit(n, unit);
+
+        assert_eq!(expected, result.map(Byte::as_u128), "{n} {unit:?}");
+    }
+
+    // -----------------------------------------------------------------------
+    // Parsing constructed valid strings against an independent oracle
+    // -----------------------------------------------------------------------
+
+    /// Parsing a constructed `"<number><spaces><unit>"` string must agree
+    /// with `rust_decimal`'s own string parser combined with
+    /// `from_decimal_with_unit` (the hand-rolled digit loop in
+    /// `Byte::parse_str` is independent code).
+    #[hegel::test]
+    fn parse_str_matches_decimal_oracle(tc: hegel::TestCase) {
+        let int_part = tc.draw(generators::integers::<u64>());
+        let frac_digits = tc.draw(
+            generators::vecs(generators::integers::<u8>().max_value(9)).max_size(6),
+        );
+        let spaces = tc.draw(generators::integers::<usize>().max_value(2));
+        // also exercise the empty unit (implies `B` when prefer_byte)
+        let unit = tc.draw((generators::optional(generators::sampled_from(all_units()))).print_as_debug());
+
+        let mut num = int_part.to_string();
+        if !frac_digits.is_empty() {
+            num.push('.');
+            for d in &frac_digits {
+                num.push((b'0' + d) as char);
+            }
+        }
+
+        let unit_str = unit.map(Unit::as_str).unwrap_or("");
+        let s = format!("{num}{}{unit_str}", " ".repeat(spaces));
+        tc.note(&format!("input: {s:?}"));
+
+        let expected_value = Decimal::from_str(&num).unwrap();
+        let expected = Byte::from_decimal_with_unit(expected_value, unit.unwrap_or(Unit::B));
+
+        match (Byte::parse_str(&s, false), expected) {
+            (Ok(parsed), Some(expected)) => assert_eq!(expected, parsed),
+            (Err(_), None) => (), // both agree the value exceeds bounds
+            (parsed, expected) => {
+                panic!("mismatch: parse gave {parsed:?}, oracle gave {expected:?}")
+            },
+        }
+    }
+
+    // -----------------------------------------------------------------------
+    // get_appropriate_unit
+    // -----------------------------------------------------------------------
+
+    fn ladder(unit_type: UnitType) -> Vec<Unit> {
+        let mut units = vec![Unit::B];
+        units.extend(
+            all_units()
+                .into_iter()
+                .filter(|u| !u.is_bit())
+                .filter(|u| match unit_type {
+                    UnitType::Binary => u.is_binary_multiples(),
+                    UnitType::Decimal => !u.is_binary_multiples(),
+                    UnitType::Both => true,
+                }),
+        );
+        units.sort_by_key(|u| unit_bytes(*u));
+        units
+    }
+
+    /// `get_appropriate_unit` must pick the largest unit of the requested
+    /// unit type that does not exceed the byte count (and `B` otherwise).
+    #[hegel::test]
+    fn appropriate_unit_selects_largest_fitting_unit(tc: hegel::TestCase) {
+        let byte = tc.draw((arb_byte()).print_as_debug());
+        let unit_type = tc.draw((generators::sampled_from(vec![
+            UnitType::Binary,
+            UnitType::Decimal,
+            UnitType::Both,
+        ])).print_as_debug());
+
+        let adjusted = byte.get_appropriate_unit(unit_type);
+        let unit = adjusted.get_unit();
+        let ladder = ladder(unit_type);
+
+        assert!(ladder.contains(&unit), "{unit:?} is not a {unit_type:?} unit");
+
+        let ub = unit_bytes(unit);
+        assert!(byte.as_u128() >= ub || unit == Unit::B, "{unit:?} is too large for {byte}");
+
+        if let Some(next) = ladder.iter().find(|u| unit_bytes(**u) > ub) {
+            assert!(
+                byte.as_u128() < unit_bytes(*next),
+                "{next:?} would have fit {byte} but {unit:?} was chosen"
+            );
+        }
+    }
+
+    /// Recovering a `Byte` from its appropriate-unit representation is
+    /// documented to be inexact ("may not be logically equal ... due to the
+    /// accuracy of floating-point numbers"), but the error must be bounded by
+    /// f64 rounding: a couple of ULPs plus the round-up of `ceil`.
+    #[hegel::test]
+    fn appropriate_unit_get_byte_is_close(tc: hegel::TestCase) {
+        let byte = tc.draw((arb_byte()).print_as_debug());
+        let unit_type = tc.draw((generators::sampled_from(vec![
+            UnitType::Binary,
+            UnitType::Decimal,
+            UnitType::Both,
+        ])).print_as_debug());
+
+        let adjusted = byte.get_appropriate_unit(unit_type);
+        let back = adjusted.get_byte();
+
+        let tolerance = (byte.as_u128() >> 47) + 1;
+        assert!(
+            back.as_u128().abs_diff(byte.as_u128()) <= tolerance,
+            "{byte} -> {adjusted} -> {back} (tolerance {tolerance})"
+        );
+    }
+
+    /// Regression test for a bug fixed in 5.2.6 (`AdjustedByte::get_byte`
+    /// now saturates at `Byte::MAX`): `Byte::get_appropriate_unit` computes an
+    /// `f64` value that can round upward (every byte count within 512 of
+    /// `u64::MAX` becomes exactly `16 EiB` = 2^64 bytes), and up to 5.2.5
+    /// `AdjustedByte::get_byte` called `Byte::from_f64_with_unit(...).unwrap()`,
+    /// which panicked because 2^64 exceeds the maximum representable byte
+    /// value. `AdjustedByte`'s `PartialEq`/`Ord` panicked on the same inputs,
+    /// since they call `get_byte` internally. The generator is pinned to the
+    /// once-failing region.
+    #[cfg(not(feature = "u128"))]
+    #[hegel::test]
+    fn known_bug_adjusted_byte_get_byte_panics_near_max(tc: hegel::TestCase) {
+        let v = tc.draw(generators::integers::<u64>().min_value(u64::MAX - 512));
+        let byte = Byte::from_u64(v);
+
+        let adjusted = byte.get_appropriate_unit(UnitType::Binary);
+
+        // must not panic (the docs only promise possible *inaccuracy*)
+        let _ = adjusted.get_byte();
+    }
+
+    // -----------------------------------------------------------------------
+    // Ordering consistency
+    // -----------------------------------------------------------------------
+
+    /// `AdjustedByte`'s `Ord` (defined via `get_byte`) must order two values
+    /// adjusted to the same unit consistently with their byte counts.
+    #[hegel::test]
+    fn adjusted_byte_ordering_is_monotone(tc: hegel::TestCase) {
+        let a = tc.draw((arb_byte()).print_as_debug());
+        let b = tc.draw((arb_byte()).print_as_debug());
+        let unit = tc.draw((generators::sampled_from(all_units())).print_as_debug());
+
+        let (lo, hi) = if a <= b { (a, b) } else { (b, a) };
+
+        assert!(
+            lo.get_adjusted_unit(unit) <= hi.get_adjusted_unit(unit),
+            "{lo} <= {hi} but their {unit:?}-adjusted forms compare the other way"
+        );
+    }
+}
