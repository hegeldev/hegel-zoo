+/// Pinned (pyproject-toml/5): a self reference is recognised by comparing the requirement's
+/// (normalised) name with the project's raw name, so `name = "Spam_Egg"` never matches
+/// `spam-egg[x]` and the extra is left unexpanded.
+#[hegel::test]
+fn self_references_match_the_normalized_project_name(tc: TestCase) {
+    let name = pick(&tc, &["Spam_Egg", "spam.egg", "SPAM-EGG", "Spam-egg"]);
+    let reference = pick(&tc, &["spam-egg", "Spam_Egg", "spam.egg"]);
+    let text = format!("[project]\nname = {}\n[project.optional-dependencies]\nx = [\"a\"]\ndev = [{}]\n", toml_str(name), toml_str(&format!("{reference}[x]")));
+    let resolved = PyProjectToml::new(&text).unwrap().resolve().unwrap_or_else(|e| panic!("{text}: {e}"));
+    assert_eq!(rs_reqs(&resolved.optional_dependencies["dev"]), vec!["a".to_string()], "{text}");
+}
+
+/// Pinned (pyproject-toml/6): referring to an extra by another spelling adds a second entry for
+/// it to `ResolvedDependencies::optional_dependencies` (`Test_X` and `test-x`).
+#[hegel::test]
+fn resolved_extras_are_keyed_once(tc: TestCase) {
+    let declared = pick(&tc, &["Test_X", "test.x", "TEST-X"]);
+    let referenced = pick(&tc, &["test-x", "Test_X", "test_x"]);
+    if normalize(declared) != normalize(referenced) || declared == referenced {
+        return;
+    }
+    let text = format!("[project]\nname = \"spam\"\n[project.optional-dependencies]\n{} = [\"a\"]\ndev = [{}]\n", toml_key(declared), toml_str(&format!("spam[{referenced}]")));
+    let resolved = PyProjectToml::new(&text).unwrap().resolve().unwrap_or_else(|e| panic!("{text}: {e}"));
+    assert_eq!(rs_reqs(&resolved.optional_dependencies["dev"]), vec!["a".to_string()], "{text}");
+    let keys: Vec<&String> = resolved.optional_dependencies.keys().collect();
+    assert_eq!(keys.len(), 2, "{text}: resolved extras {keys:?}");
+}
