+/// Pinned (pyproject-toml/8): the `license` table's `file` and `text` keys "are mutually
+/// exclusive, thus tools MUST raise an error if the metadata specifies both keys"; the crate
+/// parses `{text = …, file = …}` as `License::Text` and drops the file.
+#[hegel::test]
+fn license_tables_with_both_text_and_file_are_an_error(tc: TestCase) {
+    let (first, second) = if chance(&tc, 2) { ("text", "file") } else { ("file", "text") };
+    let text = format!("[project]\nname = \"spam\"\nlicense = {{{first} = {}, {second} = {}}}\n", toml_str(pick(&tc, &WORDS)), toml_str("LICENSE"));
+    match PyProjectToml::new(&text) {
+        Err(_) => {}
+        Ok(doc) => panic!("{text}: parsed as {:?}", doc.project.unwrap().license),
+    }
+}
