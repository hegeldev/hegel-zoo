+/// Pinned (pyproject-toml/7): `check_pep639_glob` is the documented validity check, but it
+/// accepts patterns `parse_pep639_glob` then rejects (`LICENSE**`, `LICEN[CE`, `[`).
+#[hegel::test]
+fn check_and_parse_agree_on_validity(tc: TestCase) {
+    let glob = match n(&tc, 0, 3) {
+        0 => format!("{}**", pick(&tc, &LITERALS)),
+        1 => format!("{}[{}", pick(&tc, &LITERALS), pick(&tc, &["CE", "", "a-z"])),
+        2 => format!("{}/{}", arb_glob(&tc).0, pick(&tc, &["x**", "[", "a[b"])),
+        _ => arb_glob(&tc).0,
+    };
+    let checked = check_pep639_glob(&glob).is_ok();
+    let parsed = parse_pep639_glob(&glob).is_ok();
+    assert_eq!(checked, parsed, "{glob:?}: check_pep639_glob {checked}, parse_pep639_glob {parsed}");
+}
