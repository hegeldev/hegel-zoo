+// --------------------------------------------------------------------------- pins
+
+/// Spellings of one name (PEP 735: names "must be normalized before comparisons").
+const SPELLINGS: [&str; 5] = ["test-group", "Test_Group", "TEST.GROUP", "test_group", "Test-Group"];
+
+/// Pinned (pyproject-toml/1): an `include-group` names its group in any spelling with the same
+/// normalised form; the crate looks the include up by its exact text.
+#[hegel::test]
+fn include_group_names_are_compared_normalized(tc: TestCase) {
+    let declared = pick(&tc, &SPELLINGS);
+    let mut included = pick(&tc, &SPELLINGS);
+    if included == declared {
+        included = if declared == "test-group" { "Test_Group" } else { "test-group" };
+    }
+    let text = format!("[dependency-groups]\n{} = [\"x\"]\nother = [{{include-group = {}}}]\n", toml_key(declared), toml_str(included));
+    let theirs = py_groups(&text);
+    assert_eq!(theirs.groups["other"], Ok(vec!["x".to_string()]), "{text}: reference");
+    let resolved = PyProjectToml::new(&text).unwrap().resolve().unwrap_or_else(|e| panic!("{text}: {e}"));
+    assert_eq!(rs_reqs(&resolved.dependency_groups["other"]), vec!["x".to_string()], "{text}");
+}
+
+/// Pinned (pyproject-toml/2): two groups whose names normalise alike are an error for the
+/// reference ("tools SHOULD emit an error"); the crate resolves them as distinct groups.
+#[hegel::test]
+fn duplicate_normalized_group_names_are_an_error(tc: TestCase) {
+    let a = pick(&tc, &SPELLINGS);
+    let mut b = pick(&tc, &SPELLINGS);
+    if a == b {
+        b = if a == "test-group" { "Test_Group" } else { "test-group" };
+    }
+    let text = format!("[dependency-groups]\n{} = [\"x\"]\n{} = [\"y\"]\n", toml_key(a), toml_key(b));
+    let theirs = py_groups(&text);
+    assert_eq!(theirs.error.as_deref(), Some("invalid"), "{text}: reference");
+    let doc = PyProjectToml::new(&text).unwrap();
+    assert!(doc.resolve().is_err(), "{text}: resolved without an error");
+}
+
+/// Pinned (pyproject-toml/3): a Dependency Group Include is "a table with exactly one key,
+/// `include-group`"; the crate accepts extra keys and ignores them.
+#[hegel::test]
+fn include_tables_have_exactly_one_key(tc: TestCase) {
+    let extra = pick(&tc, &["foo", "includes", "path", "include_group"]);
+    let value = pick(&tc, &["\"bar\"", "1", "true", "[]"]);
+    let text = format!("[dependency-groups]\na = [\"x\"]\nb = [{{include-group = \"a\", {extra} = {value}}}]\n");
+    let theirs = py_groups(&text);
+    assert_eq!(theirs.groups["b"], Err("invalid".to_string()), "{text}: reference");
+    let accepted = PyProjectToml::new(&text).map(|doc| doc.resolve().is_ok()).unwrap_or(false);
+    assert!(!accepted, "{text}: parsed and resolved without an error");
+}
+
+/// Pinned (pyproject-toml/4): PEP 639 — "the leading slash character MUST NOT be used";
+/// `check_pep639_glob` accepts `/LICENSE` (and `pyproject_metadata` rejects it).
+#[hegel::test]
+fn license_globs_reject_a_leading_slash(tc: TestCase) {
+    let mut glob = String::from("/");
+    loop {
+        let (g, valid) = arb_glob(&tc);
+        if valid {
+            glob.push_str(&g);
+            break;
+        }
+    }
+    assert!(py_glob_rejected(&glob), "{glob:?}: pyproject_metadata accepts");
+    assert!(check_pep639_glob(&glob).is_err(), "{glob:?}: accepted by check_pep639_glob");
+    assert!(parse_pep639_glob(&glob).is_err(), "{glob:?}: accepted by parse_pep639_glob");
+}
