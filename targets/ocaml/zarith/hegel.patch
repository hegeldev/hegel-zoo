+; upstream builds with its own warning flags, not dune's dev profile
+(library
+ (name zarith)
+ (wrapped false)
+ (flags
+  (:standard -w -a))
+ (foreign_stubs
+  (language c)
+  (names caml_z)
+  (flags
+   (:standard -DHAS_GMP (:include gmp_cflags.sexp))))
+ (c_library_flags
+  (:include gmp_libs.sexp)))
+
+(rule
+ (targets gmp_cflags.sexp gmp_libs.sexp)
+ (action
+  (progn
+   (with-stdout-to
+    gmp_cflags.sexp
+    (bash "echo \"($(pkg-config --cflags gmp 2>/dev/null))\""))
+   (with-stdout-to
+    gmp_libs.sexp
+    (bash "echo \"($(pkg-config --libs gmp 2>/dev/null || echo -lgmp))\"")))))
+
+(rule
+ (with-stdout-to
+  zarith_version.ml
+  (bash "echo let; grep version %{dep:META} | head -1")))
