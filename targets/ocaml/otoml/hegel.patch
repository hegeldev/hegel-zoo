diff --git a/hegel/zoo.ml b/hegel/zoo.ml
new file mode 100644
index 0000000..ce31977
--- /dev/null
+++ b/hegel/zoo.ml
@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
diff --git a/hegel/zoo_tests.ml b/hegel/zoo_tests.ml
new file mode 100644
index 0000000..3207f05
--- /dev/null
+++ b/hegel/zoo_tests.ml
@@ -0,0 +1,665 @@
+open Hegel
+
+let printable_string g = with_printer Sexplib0.Sexp_conv.sexp_of_string g
+
+let tomllib_script =
+  {|
+import sys, tomllib, struct, datetime, math
+def hx(s): return s.encode('utf-8', 'surrogatepass').hex()
+def tm(t): return f"{t.hour:02}:{t.minute:02}:{t.second:02}.{t.microsecond:06}"
+def off(d):
+    m = int(d.utcoffset().total_seconds()) // 60
+    sg = '+' if m >= 0 else '-'
+    m = abs(m)
+    return f"{sg}{m // 60:02}:{m % 60:02}"
+def c(v):
+    if isinstance(v, bool): return 'b' + ('true' if v else 'false')
+    if isinstance(v, int): return 'i' + str(v)
+    if isinstance(v, float): return 'fnan' if math.isnan(v) else 'f' + struct.pack('>d', v).hex()
+    if isinstance(v, str): return 's' + hx(v)
+    if isinstance(v, datetime.datetime):
+        base = f"{v.year:04}-{v.month:02}-{v.day:02}T{tm(v)}"
+        return 'odt' + base + off(v) if v.tzinfo else 'ldt' + base
+    if isinstance(v, datetime.date): return f"ld{v.year:04}-{v.month:02}-{v.day:02}"
+    if isinstance(v, datetime.time): return 'lt' + tm(v)
+    if isinstance(v, list): return '[' + ','.join(map(c, v)) + ']'
+    if isinstance(v, dict): return '{' + ','.join(sorted(hx(k) + ':' + c(x) for k, x in v.items())) + '}'
+    raise TypeError(type(v))
+while True:
+    line = sys.stdin.buffer.readline()
+    if not line: break
+    data = sys.stdin.buffer.read(int(line))
+    try: r = 'OK ' + c(tomllib.loads(data.decode('utf-8')))
+    except Exception as e: r = 'ERR ' + ' '.join(str(e).split())
+    sys.stdout.write(r + '\n')
+    sys.stdout.flush()
+|}
+;;
+
+let python = lazy (Unix.open_process_args "python3" [| "python3"; "-c"; tomllib_script |])
+
+let tomllib doc =
+  let ic, oc = Lazy.force python in
+  Printf.fprintf oc "%d\n%s%!" (String.length doc) doc;
+  let line = input_line ic in
+  match String.index_opt line ' ' with
+  | Some 2 when String.starts_with ~prefix:"OK" line ->
+    Ok (String.sub line 3 (String.length line - 3))
+  | _ -> Error line
+;;
+
+let hex s = String.to_seq s |> Seq.map (fun c -> Printf.sprintf "%02x" (Char.code c)) |> List.of_seq |> String.concat ""
+
+let is_digit c = c >= '0' && c <= '9'
+let is_hex_digit c = is_digit c || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
+
+let split_time s =
+  let n = String.length s in
+  let stop = ref 8 in
+  let frac =
+    if n > 8 && s.[8] = '.'
+    then (
+      stop := 9;
+      while !stop < n && is_digit s.[!stop] do
+        incr stop
+      done;
+      String.sub s 9 (!stop - 9))
+    else ""
+  in
+  let frac = if String.length frac >= 6 then String.sub frac 0 6 else frac ^ String.make (6 - String.length frac) '0' in
+  String.sub s 0 8 ^ "." ^ frac, String.sub s !stop (n - !stop)
+;;
+
+let canon_datetime s =
+  let time, offset = split_time (String.sub s 11 (String.length s - 11)) in
+  let offset =
+    match offset with
+    | "Z" | "z" | "-00:00" -> "+00:00"
+    | o -> o
+  in
+  String.sub s 0 10 ^ "T" ^ time ^ offset
+;;
+
+let rec canon (v : Otoml.t) =
+  match v with
+  | TomlString s -> "s" ^ hex s
+  | TomlInteger n -> "i" ^ string_of_int n
+  | TomlFloat f -> if Float.is_nan f then "fnan" else Printf.sprintf "f%016Lx" (Int64.bits_of_float f)
+  | TomlBoolean b -> "b" ^ string_of_bool b
+  | TomlOffsetDateTime s -> "odt" ^ canon_datetime s
+  | TomlLocalDateTime s -> "ldt" ^ canon_datetime s
+  | TomlLocalDate s -> "ld" ^ s
+  | TomlLocalTime s -> "lt" ^ fst (split_time s)
+  | TomlArray xs | TomlTableArray xs -> "[" ^ String.concat "," (List.map canon xs) ^ "]"
+  | TomlTable kvs | TomlInlineTable kvs ->
+    "{" ^ String.concat "," (List.sort String.compare (List.map (fun (k, v) -> hex k ^ ":" ^ canon v) kvs)) ^ "}"
+;;
+
+(* the printer cannot format every document (otoml/11) *)
+let show v = try Otoml.Printer.to_string v with Failure _ -> canon v
+
+let printable_toml g = with_printer (fun v -> Sexplib0.Sexp.Atom (show (Otoml.table [ "value", v ]))) g
+
+let interesting_keys =
+  [ "a"; "1"; "true"; "inf"; "nan"; "1979-05-27"; "-"; "_"; "a.b"; ""; " "; "\xc3\xa9"; "\""; "'"; "\\"; "\t" ]
+;;
+
+let keys =
+  one_of
+    [ text ~alphabet:"ab" ~min_size:1 ~max_size:2 ()
+    ; printable_string (sampled_from interesting_keys)
+    ; text ~max_size:4 ()
+    ]
+;;
+
+let quotes_only s = s <> "" && (String.for_all (( = ) '\'') s || String.for_all (( = ) '"') s)
+
+let quote_strings = printable_string (sampled_from [ "'"; "\""; "''"; "\"\"" ])
+let strings = one_of [ text ~alphabet:"ab\"'\\\n\t " ~max_size:6 (); text ~max_size:6 () ]
+
+let two = Printf.sprintf "%02d"
+
+let dates =
+  flat_map
+    (fun (y, m) ->
+       let leap = (y mod 4 = 0 && y mod 100 <> 0) || y mod 400 = 0 in
+       let days = match m with 2 -> if leap then 29 else 28 | 4 | 6 | 9 | 11 -> 30 | _ -> 31 in
+       map (fun d -> Printf.sprintf "%04d-%s-%s" y (two m) (two d)) (integers ~min_value:1 ~max_value:days ()))
+    (tuples2 (integers ~min_value:1 ~max_value:9999 ()) (integers ~min_value:1 ~max_value:12 ()))
+  |> printable_string
+;;
+
+let times =
+  map
+    (fun (((h, m), s), us) -> Printf.sprintf "%s:%s:%s.%06d" (two h) (two m) (two s) us)
+    (tuples2
+       (tuples2
+          (tuples2 (integers ~min_value:0 ~max_value:23 ()) (integers ~min_value:0 ~max_value:59 ()))
+          (integers ~min_value:0 ~max_value:59 ()))
+       (one_of [ integers ~min_value:0 ~max_value:0 (); integers ~min_value:0 ~max_value:999_999 () ]))
+  |> printable_string
+;;
+
+let offsets =
+  map
+    (fun m -> Printf.sprintf "%c%s:%s" (if m < 0 then '-' else '+') (two (abs m / 60)) (two (abs m mod 60)))
+    (one_of [ integers ~min_value:0 ~max_value:0 (); integers ~min_value:(-1439) ~max_value:1439 () ])
+  |> printable_string
+;;
+
+let local_datetimes = map (fun (d, t) -> d ^ "T" ^ t) (tuples2 dates times) |> printable_string
+let offset_datetimes = map (fun (dt, o) -> dt ^ o) (tuples2 local_datetimes offsets) |> printable_string
+
+let lossless_floats =
+  map (fun n -> float_of_int n /. 4.) (integers ~min_value:(-400) ~max_value:400 ())
+  |> with_printer Sexplib0.Sexp_conv.sexp_of_float
+;;
+
+let scalars floats_ =
+  one_of
+    ((if Zoo.known then [ printable_toml (map (fun s -> Otoml.TomlString s) quote_strings) ] else [])
+     @ [ printable_toml (map (fun b -> Otoml.TomlBoolean b) (booleans ()))
+       ; printable_toml (map (fun n -> Otoml.TomlInteger n) (integers ()))
+       ; printable_toml (map (fun s -> Otoml.TomlString s) strings)
+       ; printable_toml (map (fun f -> Otoml.TomlFloat f) floats_)
+       ; printable_toml (map (fun s -> Otoml.TomlLocalDate s) dates)
+       ; printable_toml (map (fun s -> Otoml.TomlLocalTime s) times)
+       ; printable_toml (map (fun s -> Otoml.TomlLocalDateTime s) local_datetimes)
+       ; printable_toml (map (fun s -> Otoml.TomlOffsetDateTime s) offset_datetimes)
+       ])
+;;
+
+let fields_of value =
+  flat_map
+    (fun ks ->
+       let n = List.length ks in
+       map (List.combine ks) (lists value ~min_size:n ~max_size:n ()))
+    (lists keys ~unique:true ~max_size:4 ())
+  |> with_printer (fun kvs -> Sexplib0.Sexp.Atom (show (Otoml.TomlTable kvs)))
+;;
+
+(* the printer expects everything inside an array or an inline table to be inline *)
+let rec values floats_ ~inline depth =
+  if depth = 0
+  then scalars floats_
+  else (
+    let sub = values floats_ ~inline:true (depth - 1) in
+    let block = values floats_ ~inline (depth - 1) in
+    let table kvs = if inline then Otoml.TomlInlineTable kvs else Otoml.TomlTable kvs in
+    one_of
+      [ scalars floats_
+      ; printable_toml (map (fun xs -> Otoml.TomlArray xs) (lists sub ~max_size:3 ()))
+      ; printable_toml (map table (fields_of block))
+      ; printable_toml (map (fun kvs -> Otoml.TomlInlineTable kvs) (fields_of sub))
+      ; printable_toml
+          (map
+             (fun ts -> if inline then Otoml.TomlArray (List.map table ts) else Otoml.TomlTableArray (List.map table ts))
+             (lists (fields_of block) ~min_size:1 ~max_size:2 ()))
+      ])
+;;
+
+let documents floats_ =
+  map (fun kvs -> Otoml.TomlTable kvs) (fields_of (values floats_ ~inline:false 3))
+  |> with_printer (fun v -> Sexplib0.Sexp.Atom (show v))
+;;
+
+let fields_of_table (v : Otoml.t) =
+  match v with
+  | TomlTable kvs | TomlInlineTable kvs -> Some kvs
+  | _ -> None
+;;
+
+let tables_of (v : Otoml.t) =
+  match v with
+  | TomlTableArray (_ :: _ as ts) | TomlArray (_ :: _ as ts) ->
+    let kvss = List.filter_map fields_of_table ts in
+    if List.compare_lengths kvss ts = 0 then Some kvss else None
+  | _ -> None
+;;
+
+let is_control c = Char.code c < 0x20 || Char.code c = 0x7F
+
+let char_spellings ~multiline s i =
+  let d = String.get_utf_8_uchar s i in
+  let n = Uchar.utf_decode_length d in
+  let u = Uchar.to_int (Uchar.utf_decode_uchar d) in
+  let c = s.[i] in
+  let raw =
+    if (is_control c && not (c = '\t' || (multiline && c = '\n'))) || c = '\\' || (c = '"' && not multiline)
+    then []
+    else [ String.sub s i n ]
+  in
+  let short =
+    match c with
+    | '\b' -> [ "\\b" ]
+    | '\t' -> [ "\\t" ]
+    | '\n' -> [ "\\n" ]
+    | '\012' -> [ "\\f" ]
+    | '\r' -> [ "\\r" ]
+    | '"' -> [ "\\\"" ]
+    | '\\' -> [ "\\\\" ]
+    | _ -> []
+  in
+  let long = Printf.sprintf "\\U%08X" u :: (if u < 0x10000 then [ Printf.sprintf "\\u%04x" u ] else []) in
+  raw @ short @ long, n
+;;
+
+let contains s sub =
+  let n = String.length sub in
+  let rec go i = i + n <= String.length s && (String.equal (String.sub s i n) sub || go (i + 1)) in
+  go 0
+;;
+
+let literal_ok ~multiline s =
+  String.for_all (fun c -> (not (is_control c)) || c = '\t' || (multiline && c = '\n')) s
+  && if multiline then not (contains s "'''") else not (String.contains s '\'')
+;;
+
+let spell_basic ~multiline nl s =
+  composite (fun tc ->
+    let b = Buffer.create 16 in
+    let delim = if multiline then "\"\"\"" else "\"" in
+    Buffer.add_string b delim;
+    if multiline && (String.starts_with ~prefix:"\n" s || draw_silent tc (booleans ()))
+    then Buffer.add_string b nl;
+    let quotes = ref 0 in
+    let rec go i =
+      if i < String.length s
+      then (
+        let options, n = char_spellings ~multiline s i in
+        let options = if !quotes >= 2 then List.filter (fun o -> o <> "\"") options else options in
+        let piece = draw_silent tc (sampled_from options) in
+        if multiline && (not (String.contains " \t\n\r" piece.[0])) && draw_silent tc (booleans ~p:0.1 ())
+        then Buffer.add_string b ("\\" ^ nl ^ "  ");
+        quotes := if piece = "\"" then !quotes + 1 else 0;
+        Buffer.add_string b piece;
+        go (i + n))
+    in
+    go 0;
+    Buffer.add_string b delim;
+    Buffer.contents b)
+;;
+
+let spell_string ~key nl s =
+  let literal = if literal_ok ~multiline:false s then [ printable_string (just ("'" ^ s ^ "'")) ] else [] in
+  let ml_literal =
+    if (not key) && literal_ok ~multiline:true s && (Zoo.known || (nl = "\n" && not (contains s "\\\n")))
+    then
+      [ printable_string
+          (sampled_from
+             ((if String.starts_with ~prefix:"\n" s then [] else [ "'''" ^ s ^ "'''" ]) @ [ "'''" ^ nl ^ s ^ "'''" ]))
+      ]
+    else []
+  in
+  let ml_basic = if key then [] else [ printable_string (spell_basic ~multiline:true nl s) ] in
+  if quotes_only s && (not key) && Zoo.known
+  then (
+    let delim = String.make 3 s.[0] in
+    printable_string (just (delim ^ s ^ delim)))
+  else if quotes_only s
+  then one_of (printable_string (spell_basic ~multiline:false nl s) :: literal)
+  else one_of ((printable_string (spell_basic ~multiline:false nl s) :: literal) @ ml_literal @ ml_basic)
+;;
+
+let bare_key k =
+  k <> "" && String.for_all (fun c -> c = '_' || c = '-' || is_digit c || (Char.lowercase_ascii c >= 'a' && Char.lowercase_ascii c <= 'z')) k
+;;
+
+let spell_key nl k =
+  let quoted = spell_string ~key:true nl k in
+  if bare_key k then one_of [ printable_string (just k); quoted ] else quoted
+;;
+
+let underscores ?(hex = false) digits =
+  let digit = if hex then is_hex_digit else is_digit in
+  map
+    (fun gaps ->
+       let b = Buffer.create 32 in
+       String.iteri
+         (fun i c ->
+            if i > 0 && List.nth gaps (i - 1) && digit digits.[i - 1] && digit c
+            then Buffer.add_char b '_';
+            Buffer.add_char b c)
+         digits;
+       Buffer.contents b)
+    (lists (booleans ~p:0.2 ()) ~min_size:(max 0 (String.length digits - 1)) ~max_size:(max 0 (String.length digits - 1)) ())
+;;
+
+let binary n =
+  let rec go n acc = if n = 0 then acc else go (n / 2) (string_of_int (n mod 2) ^ acc) in
+  if n = 0 then "0" else go n ""
+;;
+
+let spell_int n =
+  let decimal = underscores (string_of_int n) in
+  let unsigned = if n >= 0 then [ map (( ^ ) "+") (underscores (string_of_int n)) |> printable_string ] else [] in
+  let prefixed =
+    if n >= 0
+    then
+      List.map
+        (fun (prefix, digits) ->
+           flat_map
+             (fun zeros -> map (( ^ ) prefix) (underscores ~hex:true (String.make zeros '0' ^ digits)))
+             (integers ~min_value:0 ~max_value:2 ())
+           |> printable_string)
+        [ "0x", Printf.sprintf "%x" n; "0x", Printf.sprintf "%X" n; "0o", Printf.sprintf "%o" n; "0b", binary n ]
+    else []
+  in
+  one_of ((printable_string decimal :: unsigned) @ prefixed)
+;;
+
+let spell_float f =
+  if Float.is_nan f
+  then printable_string (sampled_from [ "nan"; "+nan"; "-nan" ])
+  else if Float.abs f = Float.infinity
+  then printable_string (sampled_from (if f > 0. then [ "inf"; "+inf" ] else [ "-inf" ]))
+  else (
+    let g = Printf.sprintf "%.17g" f in
+    let g = if String.exists (fun c -> c = '.' || c = 'e') g then g else g ^ ".0" in
+    let e = Printf.sprintf "%.17e" f in
+    let forms = [ g; e; String.uppercase_ascii e; String.concat "" (String.split_on_char '+' e) ] in
+    let forms = if f >= 0. && not (Float.sign_bit f) then forms @ List.map (( ^ ) "+") forms else forms in
+    let spelled form =
+      match String.index_from_opt (String.lowercase_ascii form) 0 'e' with
+      | Some i when not Zoo.known ->
+        map (fun m -> m ^ String.sub form i (String.length form - i)) (underscores (String.sub form 0 i))
+      | _ -> underscores form
+    in
+    flat_map spelled (sampled_from forms) |> printable_string)
+;;
+
+let spell_time t =
+  let frac = String.sub t 9 6 in
+  let rec trim s = if s <> "" && s.[String.length s - 1] = '0' then trim (String.sub s 0 (String.length s - 1)) else s in
+  let short = trim frac in
+  let fracs = if short = "" then [ ""; ".0"; "." ^ frac ] else [ "." ^ short; "." ^ frac ] in
+  map (( ^ ) (String.sub t 0 8)) (sampled_from fracs) |> printable_string
+;;
+
+let spell_datetime ~offset s =
+  let date = String.sub s 0 10 in
+  let time = String.sub s 11 15 in
+  let offsets =
+    if not offset
+    then [ "" ]
+    else (
+      match String.sub s 26 6 with
+      | "+00:00" -> [ "Z"; "z"; "+00:00"; "-00:00" ]
+      | o -> [ o ])
+  in
+  map
+    (fun ((sep, t), o) -> date ^ sep ^ t ^ o)
+    (tuples2 (tuples2 (printable_string (sampled_from [ "T"; "t"; " " ])) (spell_time time)) (printable_string (sampled_from offsets)))
+  |> printable_string
+;;
+
+let render (doc : Otoml.t) =
+  composite (fun tc ->
+    let pick xs = draw_silent tc (sampled_from xs) in
+    let nl = pick [ "\n"; "\r\n" ] in
+    let ws () = pick [ ""; " "; "\t" ] in
+    let key k = draw_silent tc (spell_key nl k) in
+    let path ks = String.concat (ws () ^ "." ^ ws ()) (List.map key ks) in
+    let assign p v = path p ^ pick [ "="; " = "; "\t=  " ] ^ v in
+    let rec inline (v : Otoml.t) =
+      match v with
+      | TomlString s -> draw_silent tc (spell_string ~key:false nl s)
+      | TomlInteger n -> draw_silent tc (spell_int n)
+      | TomlFloat f -> draw_silent tc (spell_float f)
+      | TomlBoolean b -> string_of_bool b
+      | TomlLocalDate s -> s
+      | TomlLocalTime s -> draw_silent tc (spell_time s)
+      | TomlLocalDateTime s -> draw_silent tc (spell_datetime ~offset:false s)
+      | TomlOffsetDateTime s -> draw_silent tc (spell_datetime ~offset:true s)
+      | TomlArray [] | TomlTableArray [] -> pick [ "[]"; "[ ]"; "[" ^ nl ^ "]" ]
+      | TomlArray xs | TomlTableArray xs ->
+        let items = List.map (fun x -> ws () ^ inline x) xs in
+        let sep () = "," ^ pick [ " "; ""; nl ^ "  "; " # c" ^ nl ] in
+        "[" ^ List.fold_left (fun acc i -> if acc = "" then i else acc ^ sep () ^ i) "" items ^ pick [ ""; ","; nl ] ^ "]"
+      | TomlTable [] | TomlInlineTable [] -> pick [ "{}"; "{ }" ]
+      | TomlTable kvs | TomlInlineTable kvs ->
+        "{" ^ ws () ^ String.concat ("," ^ ws ()) (dotted [] kvs) ^ ws () ^ "}"
+    and dotted prefix kvs =
+      List.concat_map
+        (fun (k, v) ->
+           let p = prefix @ [ k ] in
+           match fields_of_table v with
+           | Some (_ :: _ as sub) when pick [ false; true ] -> dotted p sub
+           | _ -> [ assign p (inline v) ])
+        kvs
+    in
+    let b = Buffer.create 256 in
+    let line s = Buffer.add_string b (pick [ ""; "  "; "\t" ] ^ s ^ pick [ ""; " # c" ] ^ nl) in
+    let rec section p kvs header =
+      let deferred = ref [] in
+      let lines =
+        List.concat_map
+          (fun (k, v) ->
+             match fields_of_table v, tables_of v with
+             | Some sub, _ ->
+               (match pick [ `Header; `Inline; `Dotted ] with
+                | `Header ->
+                  deferred := `Table (k, sub) :: !deferred;
+                  []
+                | `Dotted when sub <> [] -> dotted [ k ] sub
+                | _ -> [ assign [ k ] (inline v) ])
+             | None, Some tables when pick [ true; false ] ->
+               deferred := `Tables (k, tables) :: !deferred;
+               []
+             | _ -> [ assign [ k ] (inline v) ])
+          kvs
+      in
+      (match header with
+       | Some (h, implicit) when not (implicit && lines = [] && !deferred <> [] && pick [ false; true ]) -> line h
+       | _ -> ());
+      List.iter line lines;
+      List.iter
+        (function
+          | `Table (k, sub) -> section (p @ [ k ]) sub (Some ("[" ^ ws () ^ path (p @ [ k ]) ^ ws () ^ "]", true))
+          | `Tables (k, tables) ->
+            List.iter (fun sub -> section (p @ [ k ]) sub (Some ("[[" ^ ws () ^ path (p @ [ k ]) ^ ws () ^ "]]", false))) tables)
+        (List.rev !deferred)
+    in
+    (match fields_of_table doc with
+     | Some kvs -> section [] kvs None
+     | None -> ());
+    Buffer.contents b)
+  |> printable_string
+;;
+
+let parse s = Otoml.Parser.from_string_result s
+
+let agree ~what ~expected got =
+  match got with
+  | Ok v ->
+    if not (String.equal (canon v) expected) then Printf.ksprintf failwith "%s reads as\n%s" what (Otoml.Printer.to_string v)
+  | Error e -> Printf.ksprintf failwith "%s does not parse: %s" what e
+;;
+
+let%hegel_test reads_like_tomllib tc =
+  let doc = draw tc (documents (floats ())) in
+  let text = draw tc (render doc) in
+  let expected = canon doc in
+  (match tomllib text with
+   | Ok c when String.equal c expected -> ()
+   | r -> Printf.ksprintf failwith "zoo renderer: tomllib gives %s" (Result.fold ~ok:Fun.id ~error:Fun.id r));
+  agree ~what:"the document" ~expected (parse text)
+;;
+
+let rec without_arrays_of_tables (v : Otoml.t) : Otoml.t =
+  let fields kvs = List.map (fun (k, v) -> k, without_arrays_of_tables v) kvs in
+  match v with
+  | TomlTable kvs -> TomlTable (fields kvs)
+  | TomlInlineTable kvs -> TomlInlineTable (fields kvs)
+  | TomlTableArray ts ->
+    TomlTable (fields (match ts with t :: _ -> Option.value (fields_of_table t) ~default:[] | [] -> []))
+  | TomlArray xs -> TomlArray (List.map without_arrays_of_tables xs)
+  | v -> v
+;;
+
+let printer_documents () =
+  if Zoo.known then documents (floats ()) else map without_arrays_of_tables (documents lossless_floats) |> printable_toml
+;;
+
+let%hegel_test printer_output_reads_back tc =
+  let doc = draw tc (printer_documents ()) in
+  let text = Otoml.Printer.to_string doc in
+  agree ~what:"the printed document" ~expected:(canon doc) (parse text)
+;;
+
+let%hegel_test printer_output_is_toml tc =
+  let doc = draw tc (printer_documents ()) in
+  let indent_width = draw tc (integers ~min_value:0 ~max_value:4 ()) in
+  let indent_subtables = draw tc (booleans ()) in
+  let collapse_tables = Zoo.known && draw tc (booleans ()) in
+  let force_table_arrays = Zoo.known && draw tc (booleans ()) in
+  let text = Otoml.Printer.to_string ~indent_width ~indent_subtables ~collapse_tables ~force_table_arrays doc in
+  match tomllib text with
+  | Ok c -> if not (String.equal c (canon doc)) then Printf.ksprintf failwith "tomllib reads %S differently" text
+  | Error e -> Printf.ksprintf failwith "tomllib rejects %S: %s" text e
+;;
+
+(* the spec requires an error for an integer that cannot be represented losslessly *)
+let big_integers =
+  let digits alphabet lo hi = text ~alphabet ~min_size:lo ~max_size:hi () in
+  let prefixed prefix first rest n =
+    map (fun (a, b) -> prefix ^ a ^ b) (tuples2 (digits first 1 1) (digits rest n n)) |> printable_string
+  in
+  one_of
+    ((if Zoo.known
+      then
+        [ prefixed "0x" "4567" "0123456789abcdef" 15
+        ; prefixed "0x" "89abcdef" "0123456789abcdef" 15
+        ; prefixed "0o" "4567" "01234567" 20
+        ; prefixed "0b" "1" "01" 62
+        ]
+      else [])
+     @ [ map (fun (a, b) -> a ^ b) (tuples2 (sampled_from [ ""; "-" ] |> printable_string) (prefixed "" "56789" "0123456789" 18))
+       |> printable_string
+       ])
+  |> printable_string
+;;
+
+let%hegel_test big_integers_are_rejected tc =
+  let literal = draw tc big_integers in
+  match parse ("a = " ^ literal) with
+  | Ok v -> Printf.ksprintf failwith "reads as %s" (Otoml.Printer.to_string v)
+  | Error _ -> ()
+;;
+
+let segments = printable_string (sampled_from [ "a"; "b"; "\"a\"" ])
+let headers = map (String.concat ".") (lists segments ~min_size:1 ~max_size:3 ()) |> printable_string
+
+let definitions ?(shape = []) ~heads ~values () =
+  let assignment = map (fun (p, v) -> p ^ " = " ^ v) (tuples2 heads (printable_string (sampled_from values))) in
+  let statement =
+    one_of
+      ([ map (fun p -> "[" ^ p ^ "]") headers |> printable_string; printable_string assignment ]
+       @ if Zoo.known then [ map (fun p -> "[[" ^ p ^ "]]") headers |> printable_string ] else [])
+  in
+  let general = map (String.concat "\n") (lists statement ~min_size:1 ~max_size:5 ()) |> printable_string in
+  one_of ((if Zoo.known then shape else []) @ [ general ])
+;;
+
+let a_and_b f = map (fun (a, b) -> f a b) (tuples2 segments (printable_string (sampled_from [ "b"; "c" ]))) |> printable_string
+
+let accepted_like_tomllib text =
+  match tomllib text, parse text with
+  | Ok expected, got -> agree ~what:"the document" ~expected got
+  | Error _, Ok v -> Printf.ksprintf failwith "tomllib rejects it, otoml reads\n%s" (Otoml.Printer.to_string v)
+  | Error _, Error _ -> ()
+;;
+
+let static_values = [ "1"; "[]"; "[{x = 1}]" ]
+
+let%hegel_test header_definitions_like_tomllib tc =
+  let shape = [ a_and_b (fun a b -> Printf.sprintf "[%s]\n[[%s]]\n[%s]" a b a) ] in
+  let text = draw tc (definitions ~shape ~heads:segments ~values:static_values ()) in
+  accepted_like_tomllib text
+;;
+
+let%hegel_test dotted_definitions_like_tomllib tc =
+  let heads = if Zoo.known then headers else segments in
+  let shape = [ a_and_b (fun a b -> Printf.sprintf "%s.%s = 1\n[%s]" a b a) ] in
+  let text = draw tc (definitions ~shape ~heads ~values:static_values ()) in
+  accepted_like_tomllib text
+;;
+
+let%hegel_test inline_table_definitions_like_tomllib tc =
+  let values = (if Zoo.known then [ "{}"; "{x = 1}" ] else []) @ static_values in
+  let shape = [ a_and_b (fun a b -> Printf.sprintf "%s = {}\n[%s.%s]" a a b) ] in
+  let text = draw tc (definitions ~shape ~heads:segments ~values ()) in
+  accepted_like_tomllib text
+;;
+
+let rejected text =
+  match parse text with
+  | Ok v -> Printf.ksprintf failwith "%S reads as %S" text (Otoml.Printer.to_string v)
+  | Error _ -> ()
+;;
+
+let pin_hex_integer_wraps () = rejected "a = 0x7fffffffffffffff"
+let pin_dotted_table_reopened_by_header () = rejected "a.b = 1\n[a]"
+let pin_inline_table_extended () = rejected "t = {a = 1}\nt.b = 2"
+
+let reads_as text expected =
+  match parse text with
+  | Ok v when String.equal (canon v) (canon expected) -> ()
+  | Ok v -> Printf.ksprintf failwith "%S reads as %S" text (Otoml.Printer.to_string v)
+  | Error e -> Printf.ksprintf failwith "%S: %s" text e
+;;
+
+let prints_back ?(collapse_tables = false) doc =
+  let text = Otoml.Printer.to_string ~collapse_tables doc in
+  match parse text with
+  | Ok v when String.equal (canon v) (canon doc) -> ()
+  | Ok _ -> Printf.ksprintf failwith "prints as %S" text
+  | Error e -> Printf.ksprintf failwith "prints as %S: %s" text e
+;;
+
+let pin_table_redefined_after_array_of_tables () = rejected "[a]\n[[b]]\n[a]"
+let pin_exponent_with_underscore () = reads_as "a = 1e0_0" (Otoml.table [ "a", Otoml.float 1. ])
+let pin_multiline_literal_crlf () = reads_as "a = '''\r\nx'''" (Otoml.table [ "a", Otoml.string "x" ])
+
+let pin_float_printed_to_two_places () = prints_back (Otoml.table [ "a", Otoml.float 0.001 ])
+
+let pin_collapsed_array_of_tables () =
+  prints_back ~collapse_tables:true (Otoml.TomlTable [ "a", TomlTableArray [ TomlTable [ "a", TomlTable [] ] ] ])
+;;
+
+let pin_key_after_array_of_tables () =
+  prints_back (Otoml.TomlTable [ "a", TomlTableArray [ TomlTable [] ]; "b", TomlInteger 1 ])
+;;
+
+let pin_printer_nested_array_of_tables () =
+  match parse "[[a]]\n[a.b]\n[[a.b.c]]\n" with
+  | Ok doc -> prints_back doc
+  | Error e -> failwith e
+;;
+
+let pin_multiline_literal_backslash_newline () = reads_as "a = '''x'a\\\n'''" (Otoml.table [ "a", Otoml.string "x'a\\\n" ])
+let pin_multiline_string_of_one_quote () = reads_as "a = '''''''" (Otoml.table [ "a", Otoml.string "'" ])
+
+let () =
+  Zoo.run
+    [ "reads_like_tomllib", reads_like_tomllib
+    ; "printer_output_reads_back", printer_output_reads_back
+    ; "printer_output_is_toml", printer_output_is_toml
+    ; "big_integers_are_rejected", big_integers_are_rejected
+    ; "header_definitions_like_tomllib", header_definitions_like_tomllib
+    ; "dotted_definitions_like_tomllib", dotted_definitions_like_tomllib
+    ; "inline_table_definitions_like_tomllib", inline_table_definitions_like_tomllib
+    ; "pin_float_printed_to_two_places", pin_float_printed_to_two_places
+    ; "pin_hex_integer_wraps", pin_hex_integer_wraps
+    ; "pin_dotted_table_reopened_by_header", pin_dotted_table_reopened_by_header
+    ; "pin_inline_table_extended", pin_inline_table_extended
+    ; "pin_multiline_string_of_one_quote", pin_multiline_string_of_one_quote
+    ; "pin_table_redefined_after_array_of_tables", pin_table_redefined_after_array_of_tables
+    ; "pin_exponent_with_underscore", pin_exponent_with_underscore
+    ; "pin_multiline_literal_crlf", pin_multiline_literal_crlf
+    ; "pin_collapsed_array_of_tables", pin_collapsed_array_of_tables
+    ; "pin_key_after_array_of_tables", pin_key_after_array_of_tables
+    ; "pin_printer_nested_array_of_tables", pin_printer_nested_array_of_tables
+    ; "pin_multiline_literal_backslash_newline", pin_multiline_literal_backslash_newline
+    ]
+;;
