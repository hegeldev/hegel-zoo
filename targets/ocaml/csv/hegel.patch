@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
diff --git a/hegel/zoo_tests.ml b/hegel/zoo_tests.ml
new file mode 100644
index 0000000..c27a642
--- /dev/null
+++ b/hegel/zoo_tests.ml
@@ -0,0 +1,506 @@
+open Hegel
+
+let show_table t =
+  "[" ^ String.concat "; " (List.map (fun r -> "[" ^ String.concat "; " (List.map (Printf.sprintf "%S") r) ^ "]") t) ^ "]"
+;;
+
+let printed show g = with_printer (fun x -> Sexplib0.Sexp.Atom (show x)) g
+let tables g = printed show_table g
+let strings g = printed (Printf.sprintf "%S") g
+let chars g = printed (Printf.sprintf "%C") g
+
+(* a fifth of the draws, so the shape of a recorded bug is reached every run *)
+let known_first shape g = if Zoo.known then one_of [ shape; g; g; g; g ] else g
+
+(* no 0xEF, 0xFE or 0xFF bytes: a field must not start with a byte order mark *)
+let fields =
+  one_of
+    [ text ~alphabet:"ab" ~max_size:3 ()
+    ; text ~alphabet:"ab ,;|\t\"\r\n=0\\\000\026\195\169" ~max_size:6 ()
+    ]
+;;
+
+let records = lists fields ~max_size:4 ()
+let table_of records = tables (lists records ~max_size:4 ())
+let table = table_of records
+
+let separators =
+  known_first (chars (just ' ')) (chars (sampled_from [ ','; ';'; '\t'; '|' ]))
+;;
+
+let write ?separator ?backslash_escape ?excel_tricks ?quote_all t =
+  let b = Buffer.create 64 in
+  Csv.output_all (Csv.to_buffer ?separator ?backslash_escape ?excel_tricks ?quote_all b) t;
+  Buffer.contents b
+;;
+
+let read ?separator ?strip ?backslash_escape ?excel_tricks s =
+  Csv.input_all (Csv.of_string ?separator ?strip ?backslash_escape ?excel_tricks ~skip_bom:false s)
+;;
+
+let one_empty_field = List.map (function [] -> [ "" ] | r -> r)
+
+let disagree what ours theirs =
+  Printf.ksprintf failwith "%s: ours %s, expected %s" what (show_table ours) (show_table theirs)
+;;
+
+type writer =
+  { separator : char
+  ; backslash_escape : bool
+  ; excel_tricks : bool
+  ; quote_all : bool
+  ; strip : bool
+  }
+
+let writers_with separators =
+  printed
+    (fun w ->
+       Printf.sprintf
+         "separator %C, backslash_escape %b, excel_tricks %b, quote_all %b, strip %b"
+         w.separator
+         w.backslash_escape
+         w.excel_tricks
+         w.quote_all
+         w.strip)
+    (map
+       (fun (separator, (backslash_escape, excel_tricks), (quote_all, strip)) ->
+          { separator; backslash_escape; excel_tricks; quote_all; strip })
+       (tuples3
+          separators
+          (tuples2 (booleans ()) (booleans ()))
+          (tuples2 (booleans ()) (booleans ()))))
+;;
+
+(* csv/2's shape: a space separator and an empty field next to another *)
+let roundtrip_cases =
+  known_first
+    (tuples2 (writers_with (chars (just ' '))) (tables (just [ [ ""; "" ] ])))
+    (tuples2 (writers_with separators) table)
+;;
+
+let%hegel_test write_read_roundtrip tc =
+  let w, t = draw tc roundtrip_cases in
+  let s =
+    write
+      ~separator:w.separator
+      ~backslash_escape:w.backslash_escape
+      ~excel_tricks:w.excel_tricks
+      ~quote_all:w.quote_all
+      t
+  in
+  let back =
+    read
+      ~separator:w.separator
+      ~strip:w.strip
+      ~backslash_escape:w.backslash_escape
+      ~excel_tricks:w.excel_tricks
+      s
+  in
+  if back <> one_empty_field t then disagree (Printf.sprintf "%S reads back" s) back (one_empty_field t)
+;;
+
+let script =
+  {|
+import csv, io, sys
+for line in sys.stdin:
+    sep, _, text = line.rstrip("\n").partition(" ")
+    text = bytes.fromhex(text).decode("latin-1")
+    try:
+        rows = list(csv.reader(io.StringIO(text, newline=""), delimiter=chr(int(sep, 16)), strict=True))
+    except csv.Error:
+        out = "E"
+    else:
+        out = " ".join("R" + ",".join("x" + f.encode("latin-1").hex() for f in r) for r in rows)
+    print(out, flush=True)
+|}
+;;
+
+let python = lazy (Unix.open_process_args "python3" [| "python3"; "-c"; script |])
+
+let hex s = String.concat "" (List.map (fun c -> Printf.sprintf "%02x" (Char.code c)) (List.of_seq (String.to_seq s)))
+let unhex s = String.init (String.length s / 2) (fun i -> Char.chr (int_of_string ("0x" ^ String.sub s (2 * i) 2)))
+
+let python_read sep text =
+  let ic, oc = Lazy.force python in
+  Printf.fprintf oc "%02x %s\n%!" (Char.code sep) (hex text);
+  match input_line ic with
+  | "E" -> None
+  | "" -> Some []
+  | out ->
+    let field f = unhex (String.sub f 1 (String.length f - 1)) in
+    let row r = if String.equal r "R" then [] else List.map field (String.split_on_char ',' (String.sub r 1 (String.length r - 1))) in
+    Some (List.map row (String.split_on_char ' ' out))
+;;
+
+let needs_quotes sep f = String.exists (fun c -> c = sep || c = '"' || c = '\r' || c = '\n') f
+let quoted f = "\"" ^ String.concat "\"\"" (String.split_on_char '"' f) ^ "\""
+
+let spaces f = f <> "" && String.for_all (fun c -> c = ' ' || c = '\t') f
+
+let spell sep t =
+  composite (fun tc ->
+    let field f = if needs_quotes sep f || draw_silent tc (booleans ()) then quoted f else f in
+    let record r = String.concat (String.make 1 sep) (List.map field r) in
+    let eol () = draw_silent tc (sampled_from [ "\n"; "\r\n"; "\r" ]) in
+    match List.rev t with
+    | [] -> ""
+    | last :: rest ->
+      let body = String.concat "" (List.map (fun r -> record r ^ eol ()) (List.rev rest)) in
+      if draw_silent tc (booleans ())
+      then body ^ record last ^ eol ()
+      else (
+        match List.rev last with
+        | f :: fs when spaces f && not Zoo.known -> body ^ record (List.rev fs) ^ String.make 1 sep ^ quoted f
+        | _ -> body ^ record last))
+;;
+
+(* csv/3's shape: a last record of spaces, unquoted, with no line end after it *)
+let python_cases =
+  known_first
+    (tuples3 (chars (just ',')) (tables (just [])) (strings (just "\n ")))
+    (tuples3 separators table (strings (just "")))
+;;
+
+let%hegel_test reader_agrees_with_python tc =
+  let sep, t, tail = draw tc python_cases in
+  let s = draw tc (strings (spell sep t)) ^ tail in
+  match python_read sep s, read ~separator:sep ~strip:false ~excel_tricks:false s with
+  | None, ours -> Printf.ksprintf failwith "Python rejects %S, ours reads %s" s (show_table ours)
+  | Some theirs, ours ->
+    if ours <> one_empty_field theirs then disagree (Printf.sprintf "%S" s) ours (one_empty_field theirs)
+  | exception Csv.Failure (r, f, m) -> Printf.ksprintf failwith "%S: Failure (%d, %d, %s)" s r f m
+;;
+
+let chunked sizes s =
+  object
+    val mutable pos = 0
+    val mutable sizes = sizes
+
+    method input buf ofs len =
+      if pos >= String.length s then raise End_of_file;
+      let n, rest = match sizes with [] -> len, [] | n :: rest -> n, rest @ [ n ] in
+      sizes <- rest;
+      let n = min (min len n) (String.length s - pos) in
+      Bytes.blit_string s pos buf ofs n;
+      pos <- pos + n;
+      n
+
+    method close_in () = ()
+  end
+;;
+
+(* a hang is the bug, and it would take the whole suite with it *)
+let within seconds (f : unit -> Csv.t) : (Csv.t, string) result option =
+  let r, w = Unix.pipe () in
+  match Unix.fork () with
+  | 0 ->
+    Unix.close r;
+    let oc = Unix.out_channel_of_descr w in
+    let v : (Csv.t, string) result = try Ok (f ()) with e -> Error (Printexc.to_string e) in
+    Marshal.to_channel oc v [];
+    close_out oc;
+    Unix._exit 0
+  | pid ->
+    Unix.close w;
+    let ready, _, _ = Unix.select [ r ] [] [] seconds in
+    let v =
+      if ready = []
+      then (
+        Unix.kill pid Sys.sigkill;
+        None)
+      else Some (Marshal.from_channel (Unix.in_channel_of_descr r))
+    in
+    Unix.close r;
+    ignore (Unix.waitpid [] pid);
+    v
+;;
+
+let%hegel_test chunked_reader_agrees_with_of_string tc =
+  let t = draw tc table in
+  let sizes = draw tc (lists (integers ~min_value:1 ~max_value:9 ()) ~min_size:1 ~max_size:4 ()) in
+  let s = write t in
+  let skip_bom = if Zoo.known then None else Some false in
+  match within 1. (fun () -> Csv.input_all (Csv.of_in_obj ?skip_bom (chunked sizes s))) with
+  | None -> Printf.ksprintf failwith "reading %S in reads of %s bytes does not return" s (String.concat "," (List.map string_of_int sizes))
+  | Some (Error e) -> failwith e
+  | Some (Ok ours) ->
+    let whole = read s in
+    if ours <> whole then disagree (Printf.sprintf "%S" s) ours whole
+;;
+
+(* csv/4's shape: the unterminated field ends with an escaped quote *)
+let unterminated_contents =
+  let escaped = map (fun f -> String.concat "\"\"" (String.split_on_char '"' f)) fields in
+  let ends_in_quote f = String.ends_with ~suffix:"\"" (String.trim f) in
+  let plain = strings (filter (fun f -> not (ends_in_quote f)) escaped) in
+  known_first (strings (map (fun f -> f ^ "\"\"") plain)) (if Zoo.known then strings escaped else plain)
+;;
+
+let%hegel_test unterminated_quoted_field_fails tc =
+  let prefix = draw tc table in
+  let content = draw tc unterminated_contents in
+  let s = write prefix ^ "\"" ^ content in
+  match read s with
+  | t -> Printf.ksprintf failwith "%S reads as %s" s (show_table t)
+  | exception Csv.Failure _ -> ()
+;;
+
+let names = one_of [ text ~alphabet:"ab" ~max_size:1 (); text ~alphabet:"abc" ~max_size:2 () ]
+let headers = lists names ~min_size:1 ~max_size:4 ()
+
+let of_names h =
+  List.rev
+    (snd
+       (List.fold_left
+          (fun (seen, acc) n ->
+             if String.equal n "" || List.mem n seen then seen, "" :: acc else n :: seen, n :: acc)
+          ([], [])
+          h))
+;;
+
+let merge ~main t =
+  let main = of_names main
+  and t = of_names t in
+  let nth l i = Option.value (List.nth_opt l i) ~default:"" in
+  let used = ref (List.filter (fun n -> n <> "") main) in
+  List.init (max (List.length main) (List.length t)) (fun i ->
+    match nth main i, nth t i with
+    | "", n when n <> "" && not (List.mem n !used) ->
+      used := n :: !used;
+      n
+    | m, _ -> m)
+;;
+
+type headed =
+  | Has_header
+  | Header_only of string list
+  | Both of string list
+
+let headings =
+  printed
+    (function
+      | Has_header -> "has_header"
+      | Header_only h -> "header " ^ show_table [ h ]
+      | Both h -> "has_header and header " ^ show_table [ h ])
+    (one_of
+       [ printed (fun _ -> "") (just Has_header)
+       ; printed (fun _ -> "") (map (fun h -> Header_only h) headers)
+       ; printed (fun _ -> "") (map (fun h -> Both h) headers)
+       ])
+;;
+
+let open_headed headed csv_header data =
+  match headed with
+  | Has_header -> Csv.of_string ~has_header:true ~skip_bom:false (write (csv_header :: data)), of_names csv_header
+  | Header_only h -> Csv.of_string ~header:h ~skip_bom:false (write data), of_names h
+  | Both h -> Csv.of_string ~has_header:true ~header:h ~skip_bom:false (write (csv_header :: data)), merge ~main:h csv_header
+;;
+
+let%hegel_test rows_header_matches_model tc =
+  let csv_header = draw tc headers in
+  let headed = draw tc headings in
+  let ic, expected = open_headed headed csv_header [] in
+  let got = Csv.Rows.header ic in
+  if got <> expected then disagree "Rows.header" [ got ] [ expected ]
+;;
+
+let%hegel_test row_find_matches_model tc =
+  let csv_header = draw tc headers in
+  let headed = draw tc headings in
+  let data = draw tc (table_of (lists (text ~alphabet:"xy" ~max_size:2 ()) ~max_size:5 ())) in
+  let key = draw tc names in
+  let ic, header = open_headed headed csv_header data in
+  List.iter
+    (fun row ->
+       let cells = Csv.Row.to_list row in
+       let expected =
+         let rec index i = function
+           | [] -> None
+           | n :: ns -> if n <> "" && String.equal n key then Some i else index (i + 1) ns
+         in
+         match index 0 header with
+         | Some i -> Option.value (List.nth_opt cells i) ~default:""
+         | None -> ""
+       in
+       let got = Csv.Row.find row key in
+       if not (String.equal got expected)
+       then Printf.ksprintf failwith "find %S in %s gives %S, expected %S" key (show_table [ cells ]) got expected)
+    (Csv.Rows.input_all ic)
+;;
+
+let%hegel_test row_get_is_nth_or_empty tc =
+  let r = draw tc records in
+  let i = draw tc (integers ~min_value:(-1) ~max_value:5 ()) in
+  let row = List.hd (Csv.Rows.input_all (Csv.of_string ~skip_bom:false (write [ r ]))) in
+  let cells = Csv.Row.to_list row in
+  let expected = if i < 0 then "" else Option.value (List.nth_opt cells i) ~default:"" in
+  let got = Csv.Row.get row i in
+  if not (String.equal got expected) then Printf.ksprintf failwith "get %d gives %S, expected %S" i got expected
+;;
+
+let small = table_of (lists (text ~alphabet:"a" ~max_size:1 ()) ~max_size:4 ())
+let sizes = integers ~min_value:0 ~max_value:5 ()
+let pad n r = List.init n (fun i -> Option.value (List.nth_opt r i) ~default:"")
+let empty_row = List.for_all (String.equal "")
+
+let rec drop_while p = function
+  | x :: xs when p x -> drop_while p xs
+  | l -> l
+;;
+
+let rstrip r = List.rev (drop_while (String.equal "") (List.rev r))
+
+let rec drop n l =
+  match l with
+  | _ :: l when n > 0 -> drop (n - 1) l
+  | l -> l
+;;
+
+let same what got expected = if got <> expected then disagree what got expected
+
+let%hegel_test square_pads_to_columns tc =
+  let t = draw tc small in
+  same "square" (Csv.square t) (List.map (pad (Csv.columns t)) t)
+;;
+
+let%hegel_test is_square_iff_rows_equal_length tc =
+  let t = draw tc small in
+  let expected = List.for_all (fun r -> List.length r = Csv.columns t) t in
+  if Csv.is_square t <> expected then Printf.ksprintf failwith "is_square %s" (show_table t)
+;;
+
+let%hegel_test trim_matches_model tc =
+  let t = draw tc small in
+  let top, left, right, bottom =
+    draw tc (tuples4 (booleans ()) (booleans ()) (booleans ()) (booleans ()))
+  in
+  let expected =
+    let t = if top then drop_while empty_row t else t in
+    let t = if bottom then List.rev (drop_while empty_row (List.rev t)) else t in
+    let t = if right then List.map rstrip t else t in
+    let rec left_trim t =
+      let first_empty = function [] -> true | c :: _ -> String.equal c "" in
+      if List.for_all first_empty t && List.exists (fun r -> r <> []) t
+      then left_trim (List.map (function [] -> [] | _ :: r -> r) t)
+      else t
+    in
+    if left then left_trim t else t
+  in
+  same
+    (Printf.sprintf "trim ~top:%b ~left:%b ~right:%b ~bottom:%b" top left right bottom)
+    (Csv.trim ~top ~left ~right ~bottom t)
+    expected
+;;
+
+let%hegel_test set_columns_pads_or_truncates tc =
+  let t = draw tc small in
+  let cols = draw tc sizes in
+  same (Printf.sprintf "set_columns ~cols:%d" cols) (Csv.set_columns ~cols t) (List.map (pad cols) t)
+;;
+
+let%hegel_test set_rows_pads_or_truncates tc =
+  let t = draw tc small in
+  let rows = draw tc sizes in
+  same
+    (Printf.sprintf "set_rows ~rows:%d" rows)
+    (Csv.set_rows ~rows t)
+    (List.init rows (fun i -> Option.value (List.nth_opt t i) ~default:[]))
+;;
+
+let%hegel_test sub_is_the_window tc =
+  let t = draw tc small in
+  let r, c, rows, cols = draw tc (tuples4 sizes sizes sizes sizes) in
+  let expected =
+    List.init rows (fun i -> pad cols (drop c (Option.value (List.nth_opt t (r + i)) ~default:[])))
+  in
+  same (Printf.sprintf "sub ~r:%d ~c:%d ~rows:%d ~cols:%d" r c rows cols) (Csv.sub ~r ~c ~rows ~cols t) expected
+;;
+
+let%hegel_test compare_is_semantic_equality tc =
+  let a = draw tc small in
+  let b = draw tc small in
+  let norm t = List.rev (drop_while (( = ) []) (List.rev (List.map rstrip t))) in
+  let c = Csv.compare a b in
+  if (c = 0) <> (norm a = norm b) || Int.compare c 0 <> - Int.compare (Csv.compare b a) 0
+  then Printf.ksprintf failwith "compare gives %d, reversed %d" c (Csv.compare b a)
+;;
+
+let%hegel_test concat_places_side_by_side tc =
+  let ts = draw tc (lists small ~max_size:3 ()) in
+  let expected =
+    match List.rev ts with
+    | [] -> []
+    | last :: rest ->
+      let ts = List.rev rest in
+      List.init
+        (List.fold_left (fun m t -> max m (List.length t)) 0 (last :: ts))
+        (fun i ->
+           let row t = Option.value (List.nth_opt t i) ~default:[] in
+           List.concat_map (fun t -> pad (Csv.columns t) (row t)) ts @ row last)
+  in
+  let got = Csv.concat ts in
+  if Csv.compare got expected <> 0 then disagree "concat" got expected
+;;
+
+let%hegel_test transpose_swaps_rows_and_columns tc =
+  let t = draw tc small in
+  let cell i j = Option.value (Option.bind (List.nth_opt t i) (fun r -> List.nth_opt r j)) ~default:"" in
+  let expected = List.init (Csv.columns t) (fun j -> List.init (List.length t) (fun i -> cell i j)) in
+  let got = Csv.transpose t in
+  if Csv.compare got expected <> 0 then disagree "transpose" got expected
+;;
+
+let%hegel_test associate_pads_or_truncates tc =
+  let header = draw tc (lists (text ~alphabet:"h" ~min_size:1 ~max_size:2 ()) ~max_size:4 ()) in
+  let data = draw tc small in
+  let got = Csv.associate header data in
+  let expected = List.map (fun r -> List.combine header (pad (List.length header) r)) data in
+  if got <> expected
+  then
+    Printf.ksprintf failwith "associate gives %s" (show_table (List.map (List.map (fun (h, x) -> h ^ "=" ^ x)) got))
+;;
+
+let pin_csv_1 () =
+  match within 1. (fun () -> Csv.input_all (Csv.of_string "a")) with
+  | None -> failwith "Csv.of_string \"a\" does not return"
+  | Some _ -> ()
+;;
+
+let pin_csv_2 () =
+  let back = read ~separator:' ' ~strip:false "a  b\n" in
+  same "a  b with separator ' '" back [ [ "a"; ""; "b" ] ]
+;;
+
+let pin_csv_3 () = same "a,  with strip=false" (read ~strip:false "a,  ") [ [ "a"; "  " ] ]
+
+let pin_csv_4 () =
+  match read "\"a\"\"" with
+  | t -> Printf.ksprintf failwith "the unterminated \"a\"\" reads as %s" (show_table t)
+  | exception Csv.Failure _ -> ()
+;;
+
+let () =
+  Zoo.run
+    [ "write_read_roundtrip", write_read_roundtrip
+    ; "reader_agrees_with_python", reader_agrees_with_python
+    ; "chunked_reader_agrees_with_of_string", chunked_reader_agrees_with_of_string
+    ; "unterminated_quoted_field_fails", unterminated_quoted_field_fails
+    ; "rows_header_matches_model", rows_header_matches_model
+    ; "row_find_matches_model", row_find_matches_model
+    ; "row_get_is_nth_or_empty", row_get_is_nth_or_empty
+    ; "square_pads_to_columns", square_pads_to_columns
+    ; "is_square_iff_rows_equal_length", is_square_iff_rows_equal_length
+    ; "trim_matches_model", trim_matches_model
+    ; "set_columns_pads_or_truncates", set_columns_pads_or_truncates
+    ; "set_rows_pads_or_truncates", set_rows_pads_or_truncates
+    ; "sub_is_the_window", sub_is_the_window
+    ; "compare_is_semantic_equality", compare_is_semantic_equality
+    ; "concat_places_side_by_side", concat_places_side_by_side
+    ; "transpose_swaps_rows_and_columns", transpose_swaps_rows_and_columns
+    ; "associate_pads_or_truncates", associate_pads_or_truncates
+    ; "pin_csv_1", pin_csv_1
+    ; "pin_csv_2", pin_csv_2
+    ; "pin_csv_3", pin_csv_3
+    ; "pin_csv_4", pin_csv_4
+    ]
+;;
