+open Hegel
+
+let printed show g = with_printer (fun x -> Sexplib0.Sexp.Atom (show x)) g
+let show_ints = CCList.to_string ~start:"[" ~stop:"]" string_of_int
+let show_strings = CCList.to_string ~start:"[" ~stop:"]" (Printf.sprintf "%S")
+let show_int_lists = CCList.to_string ~start:"[" ~stop:"]" show_ints
+let ints = integers ~min_value:0 ~max_value:9 ()
+let int_lists = lists ints ~max_size:12 ()
+let sorted_int_lists = printed show_ints (map (List.sort Int.compare) int_lists)
+
+let haystacks = text ~alphabet:"ab" ~max_size:10 ()
+let needles = text ~alphabet:"ab" ~max_size:3 ()
+let nonempty_needles = text ~alphabet:"ab" ~min_size:1 ~max_size:3 ()
+
+let occurs_at ~sub s i =
+  i + String.length sub <= String.length s
+  && String.equal (String.sub s i (String.length sub)) sub
+;;
+
+let occurrences ?(start = 0) ~sub s =
+  List.filter (occurs_at ~sub s) (List.init (String.length s - start + 1) (fun k -> start + k))
+;;
+
+let haystack_and_start =
+  printed
+    (fun (s, i) -> Printf.sprintf "%S from %d" s i)
+    (flat_map
+       (fun s -> map (fun i -> s, i) (integers ~min_value:0 ~max_value:(String.length s) ()))
+       haystacks)
+;;
+
+let%hegel_test string_find tc =
+  let s, start = draw tc haystack_and_start in
+  let sub = draw tc needles in
+  let expected =
+    match occurrences ~start ~sub s with
+    | i :: _ -> i
+    | [] -> -1
+  in
+  let got = CCString.find ~start ~sub s in
+  if got <> expected then Printf.ksprintf failwith "find gives %d, expected %d" got expected
+;;
+
+let%hegel_test string_rfind tc =
+  let s = draw tc haystacks in
+  let sub = draw tc nonempty_needles in
+  let expected = Option.value (CCList.last_opt (occurrences ~sub s)) ~default:(-1) in
+  let got = CCString.rfind ~sub s in
+  if got <> expected then Printf.ksprintf failwith "rfind gives %d, expected %d" got expected
+;;
+
+let%hegel_test string_find_all tc =
+  let s, start = draw tc haystack_and_start in
+  let sub = draw tc nonempty_needles in
+  let expected = occurrences ~start ~sub s in
+  let got = CCString.find_all_l ~start ~sub s in
+  if got <> expected
+  then Printf.ksprintf failwith "find_all_l gives %s, expected %s" (show_ints got) (show_ints expected)
+;;
+
+let replace_model ~which ~sub ~by s =
+  let n = String.length sub in
+  let splice i = String.sub s 0 i ^ by ^ String.sub s (i + n) (String.length s - i - n) in
+  match which, occurrences ~sub s with
+  | _, [] -> s
+  | `Left, i :: _ -> splice i
+  | `Right, is -> splice (List.nth is (List.length is - 1))
+  | `All, _ ->
+    let b = Buffer.create (String.length s) in
+    let rec go i =
+      if i < String.length s
+      then
+        if occurs_at ~sub s i
+        then (
+          Buffer.add_string b by;
+          go (i + n))
+        else (
+          Buffer.add_char b s.[i];
+          go (i + 1))
+    in
+    go 0;
+    Buffer.contents b
+;;
+
+let%hegel_test string_replace tc =
+  let s = draw tc haystacks in
+  let sub = draw tc nonempty_needles in
+  let by = draw tc (text ~alphabet:"abX" ~max_size:3 ()) in
+  let which =
+    draw tc (printed (function `Left -> "`Left" | `Right -> "`Right" | `All -> "`All")
+               (sampled_from [ `All; `Left; `Right ]))
+  in
+  let expected = replace_model ~which ~sub ~by s in
+  let got = CCString.replace ~which ~sub ~by s in
+  if not (String.equal got expected) then Printf.ksprintf failwith "gives %S, expected %S" got expected
+;;
+
+let drops =
+  printed
+    (fun { CCString.Split.first; last } -> Printf.sprintf "{first=%b; last=%b}" first last)
+    (map
+       (fun (first, last) -> { CCString.Split.first; last })
+       (tuples2 (booleans ()) (booleans ())))
+;;
+
+let%hegel_test string_split tc =
+  let s = draw tc (text ~alphabet:"ab-" ~max_size:10 ()) in
+  let by = draw tc (text ~alphabet:"-a" ~min_size:1 ~max_size:2 ()) in
+  let drop = draw tc drops in
+  let rec pieces start i =
+    if i > String.length s - String.length by
+    then [ String.sub s start (String.length s - start) ]
+    else if occurs_at ~sub:by s i
+    then String.sub s start (i - start) :: pieces (i + String.length by) (i + String.length by)
+    else pieces start (i + 1)
+  in
+  let ps = pieces 0 0 in
+  let ps = if drop.first && List.hd ps = "" then List.tl ps else ps in
+  let ps = if drop.last && ps <> [] && CCList.last_opt ps = Some "" then CCList.take (List.length ps - 1) ps else ps in
+  let got = CCString.Split.list_cpy ~drop ~by s in
+  if got <> ps then Printf.ksprintf failwith "gives %s, expected %s" (show_strings got) (show_strings ps)
+;;
+
+let%hegel_test string_pad tc =
+  let s = draw tc haystacks in
+  let n = draw tc (integers ~min_value:0 ~max_value:12 ()) in
+  let side = draw tc (printed (function `Left -> "`Left" | `Right -> "`Right") (sampled_from [ `Left; `Right ])) in
+  let fill = String.make (max 0 (n - String.length s)) '.' in
+  let expected = if side = `Left then fill ^ s else s ^ fill in
+  let got = CCString.pad ~side ~c:'.' n s in
+  if not (String.equal got expected) then Printf.ksprintf failwith "gives %S, expected %S" got expected
+;;
+
+let levenshtein a b =
+  let d = Array.make_matrix (String.length a + 1) (String.length b + 1) 0 in
+  for i = 0 to String.length a do d.(i).(0) <- i done;
+  for j = 0 to String.length b do d.(0).(j) <- j done;
+  for i = 1 to String.length a do
+    for j = 1 to String.length b do
+      let cost = if a.[i - 1] = b.[j - 1] then 0 else 1 in
+      d.(i).(j) <- min (min (d.(i - 1).(j) + 1) (d.(i).(j - 1) + 1)) (d.(i - 1).(j - 1) + cost)
+    done
+  done;
+  d.(String.length a).(String.length b)
+;;
+
+let%hegel_test string_edit_distance tc =
+  let a = draw tc (text ~alphabet:"abc" ~max_size:8 ()) in
+  let b = draw tc (text ~alphabet:"abc" ~max_size:8 ()) in
+  let cutoff = draw tc (optional (integers ~min_value:0 ~max_value:10 ())) in
+  let expected = levenshtein a b in
+  let got = CCString.edit_distance ?cutoff a b in
+  (* past the cutoff only a result below it is promised to be exact *)
+  let exact = match cutoff with None -> true | Some c -> got < c in
+  if exact && got <> expected then Printf.ksprintf failwith "gives %d, expected %d" got expected
+;;
+
+let%hegel_test list_sublists_of_len tc =
+  let l = draw tc int_lists in
+  let n = draw tc (integers ~min_value:1 ~max_value:4 ()) in
+  let offset = draw tc (optional (integers ~min_value:1 ~max_value:5 ())) in
+  let keep = draw tc (booleans ()) in
+  let step = Option.value offset ~default:n in
+  let len = List.length l in
+  let rec groups start =
+    if start >= len
+    then []
+    else if start + n <= len
+    then CCList.take n (CCList.drop start l) :: groups (start + step)
+    else if keep
+    then [ CCList.drop start l ]
+    else []
+  in
+  let expected = groups 0 in
+  let last = if keep then Option.some else fun _ -> None in
+  let got = CCList.sublists_of_len ~last ?offset n l in
+  if got <> expected
+  then Printf.ksprintf failwith "gives %s, expected %s" (show_int_lists got) (show_int_lists expected)
+;;
+
+(* A call that may never return, or allocate without bound, runs in a forked child with a
+   deadline and a capped heap, so it fails the property instead of taking the run down. *)
+let in_child f =
+  match Unix.fork () with
+  | 0 ->
+    ignore (Gc.create_alarm (fun () -> if (Gc.quick_stat ()).heap_words > 1 lsl 25 then Unix._exit 3));
+    (match f () with
+     | () -> Unix._exit 0
+     | exception e ->
+       prerr_endline (Printexc.to_string e);
+       Unix._exit 1)
+  | pid ->
+    let deadline = Unix.gettimeofday () +. 0.5 in
+    let rec wait () =
+      match Unix.waitpid [ Unix.WNOHANG ] pid with
+      | 0, _ when Unix.gettimeofday () < deadline ->
+        Unix.sleepf 0.005;
+        wait ()
+      | 0, _ ->
+        Unix.kill pid Sys.sigkill;
+        ignore (Unix.waitpid [] pid);
+        failwith "does not return"
+      | _, Unix.WEXITED 0 -> ()
+      | _, Unix.WEXITED 3 -> failwith "allocates without bound"
+      | _ -> failwith "fails (its message is above)"
+    in
+    wait ()
+;;
+
+let small_ranges =
+  tuples3
+    (integers ~min_value:(-20) ~max_value:20 ())
+    (integers ~min_value:(-20) ~max_value:20 ())
+    (filter (fun s -> s <> 0) (integers ~min_value:(-5) ~max_value:5 ()))
+;;
+
+(* steps large enough that the list stays short *)
+let far_ranges =
+  filter
+    (fun (i, j, _) -> Zoo.known || (j - i >= 0) = (j >= i))
+    (tuples3
+       (integers ())
+       (integers ())
+       (one_of [ integers ~min_value:(max_int / 8) (); integers ~max_value:(min_int / 8) () ]))
+;;
+
+(* containers/1: j - i overflows *)
+let overflowing_ranges =
+  one_of
+    [ tuples3
+        (integers ~min_value:1 ~max_value:100 ())
+        (just min_int |> printed string_of_int)
+        (integers ~min_value:(min_int / 4) ~max_value:(min_int / 8) ())
+    ; tuples3
+        (integers ~min_value:(-100) ~max_value:(-1) ())
+        (just max_int |> printed string_of_int)
+        (integers ~min_value:(max_int / 8) ~max_value:(max_int / 4) ())
+    ]
+;;
+
+let ranges =
+  printed
+    (fun (i, j, step) -> Printf.sprintf "i=%d j=%d step=%d" i j step)
+    (one_of
+       (if Zoo.known
+        then [ overflowing_ranges; small_ranges; small_ranges; small_ranges; far_ranges ]
+        else [ small_ranges; far_ranges ]))
+;;
+
+let range_model i j step =
+  let in_bounds x = if step > 0 then x <= j else x >= j in
+  let rec go x =
+    let next = x + step in
+    let advanced = if step > 0 then next > x else next < x in
+    x :: (if advanced && in_bounds next then go next else [])
+  in
+  if in_bounds i then go i else []
+;;
+
+let%hegel_test list_range_by tc =
+  let i, j, step = draw tc ranges in
+  let expected = range_model i j step in
+  in_child (fun () ->
+    let got = CCList.range_by ~step i j in
+    if got <> expected then Printf.ksprintf failwith "gives %s, expected %s" (show_ints got) (show_ints expected))
+;;
+
+let%hegel_test int_range_by tc =
+  let i, j, step = draw tc ranges in
+  let expected = range_model i j step in
+  let got = ref [] in
+  let count = ref 0 in
+  (try
+     CCInt.range_by ~step i j (fun x ->
+       got := x :: !got;
+       incr count;
+       if !count > List.length expected + 1 then raise Exit)
+   with
+   | Exit -> ());
+  let got = List.rev !got in
+  if got <> expected then Printf.ksprintf failwith "gives %s, expected %s" (show_ints got) (show_ints expected)
+;;
+
+let%hegel_test list_sorted_diff_inverts_merge tc =
+  let a = draw tc sorted_int_lists in
+  let b = draw tc sorted_int_lists in
+  let merged = CCList.sorted_merge ~cmp:Int.compare a b in
+  if merged <> List.merge Int.compare a b
+  then Printf.ksprintf failwith "sorted_merge gives %s" (show_ints merged);
+  let back = CCList.sorted_diff ~cmp:Int.compare merged b in
+  if back <> a then Printf.ksprintf failwith "sorted_diff gives %s" (show_ints back)
+;;
+
+let%hegel_test list_sorted_remove_inverts_insert tc =
+  let l = draw tc sorted_int_lists in
+  let x = draw tc ints in
+  let inserted = CCList.sorted_insert ~cmp:Int.compare x l in
+  if inserted <> List.merge Int.compare [ x ] l
+  then Printf.ksprintf failwith "sorted_insert gives %s" (show_ints inserted);
+  let back = CCList.sorted_remove ~cmp:Int.compare x inserted in
+  if back <> l then Printf.ksprintf failwith "sorted_remove gives %s" (show_ints back)
+;;
+
+let%hegel_test list_group_by tc =
+  let l = draw tc int_lists in
+  let groups = CCList.group_by ~hash:Hashtbl.hash ~eq:Int.equal l in
+  let heads = List.map List.hd groups in
+  if List.exists (fun g -> g = [] || List.exists (fun x -> x <> List.hd g) g) groups
+  then Printf.ksprintf failwith "a group mixes values: %s" (show_int_lists groups);
+  if List.length (List.sort_uniq Int.compare heads) <> List.length heads
+  then Printf.ksprintf failwith "a value has two groups: %s" (show_int_lists groups);
+  if List.sort Int.compare (List.concat groups) <> List.sort Int.compare l
+  then Printf.ksprintf failwith "groups lose or add elements: %s" (show_int_lists groups)
+;;
+
+let%hegel_test list_uniq tc =
+  let l = draw tc int_lists in
+  let expected = List.filteri (fun i x -> not (List.mem x (CCList.drop (i + 1) l))) l in
+  let got = CCList.uniq ~eq:Int.equal l in
+  if got <> expected then Printf.ksprintf failwith "gives %s, expected %s" (show_ints got) (show_ints expected)
+;;
+
+let any_ints = one_of [ integers ~min_value:(-20) ~max_value:20 (); integers () ]
+let nonzero = filter (fun n -> n <> 0) any_ints
+
+let%hegel_test int_floor_div_rem tc =
+  let x = draw tc any_ints in
+  let n = draw tc nonzero in
+  let q = CCInt.floor_div x n in
+  let r = CCInt.rem x n in
+  let q_ok = if x mod n <> 0 && (x < 0) <> (n < 0) then q = (x / n) - 1 else q = x / n in
+  if not q_ok then Printf.ksprintf failwith "floor_div gives %d" q;
+  if not (r = 0 || (r > 0) = (n > 0)) then Printf.ksprintf failwith "rem %d has the sign of x, not n" r;
+  if x <> (n * q) + r then Printf.ksprintf failwith "x <> n * %d + %d" q r
+;;
+
+let%hegel_test int_pow tc =
+  let x = draw tc (integers ~min_value:(-10) ~max_value:10 ()) in
+  let y = draw tc (integers ~min_value:(-2) ~max_value:70 ()) in
+  match CCInt.pow x y with
+  | got ->
+    if y < 0 || (x = 0 && y = 0) then Printf.ksprintf failwith "gives %d, expected Invalid_argument" got;
+    let expected = List.fold_left ( * ) 1 (List.init y (fun _ -> x)) in
+    if got <> expected then Printf.ksprintf failwith "gives %d, expected %d" got expected
+  | exception Invalid_argument _ ->
+    if not (y < 0 || (x = 0 && y = 0)) then failwith "raises Invalid_argument"
+;;
+
+let%hegel_test int_popcount tc =
+  let x = draw tc any_ints in
+  let expected = List.length (List.filter (fun i -> (x lsr i) land 1 = 1) (List.init Sys.int_size Fun.id)) in
+  let got = CCInt.popcount x in
+  if got <> expected then Printf.ksprintf failwith "gives %d, expected %d" got expected
+;;
+
+let%hegel_test int_to_string_binary tc =
+  let x = draw tc any_ints in
+  let s = CCInt.to_string_binary x in
+  match int_of_string_opt s with
+  | Some back when back = x -> ()
+  | _ -> Printf.ksprintf failwith "writes %S" s
+;;
+
+let utf8_fragments =
+  [ "a"; "\xc2\xa9"; "\xe2\x82\xac"; "\xf0\x9f\x98\x80"; "\xed\x9f\xbf"; "\xee\x80\x80"
+  ; "\xf4\x8f\xbf\xbf"; "\xc0\x80"; "\xc1\xbf"; "\xe0\x80\x80"; "\xe0\x9f\xbf"; "\xed\xa0\x80"
+  ; "\xed\xbf\xbf"; "\xf0\x80\x80\x80"; "\xf0\x8f\xbf\xbf"; "\xf4\x90\x80\x80"; "\xf5\x80\x80\x80"
+  ; "\xc2"; "\xe2\x82"; "\xf0\x9f\x98"; "\x80"; "\xbf"; "\xff"
+  ]
+;;
+
+let utf8_candidates =
+  one_of
+    [ text ~max_size:6 ()
+    ; printed (Printf.sprintf "%S")
+        (map (String.concat "") (lists (printed (Printf.sprintf "%S") (sampled_from utf8_fragments)) ~max_size:4 ()))
+    ; binary ~max_size:6 ()
+    ]
+;;
+
+let%hegel_test utf8_is_valid tc =
+  let s = draw tc utf8_candidates in
+  let expected = String.is_valid_utf_8 s in
+  let got = CCUtf8_string.is_valid s in
+  if got <> expected then Printf.ksprintf failwith "is_valid gives %b, String.is_valid_utf_8 %b" got expected
+;;
+
+let%hegel_test utf8_to_list tc =
+  let s = draw tc (text ~max_size:8 ()) in
+  let rec decode i =
+    if i >= String.length s
+    then []
+    else (
+      let d = String.get_utf_8_uchar s i in
+      Uchar.to_int (Uchar.utf_decode_uchar d) :: decode (i + Uchar.utf_decode_length d))
+  in
+  let expected = decode 0 in
+  let got = List.map Uchar.to_int (CCUtf8_string.to_list (CCUtf8_string.of_string_exn s)) in
+  if got <> expected then Printf.ksprintf failwith "decodes %s, expected %s" (show_ints got) (show_ints expected)
+;;
+
+let rec sexps depth : (CCSexp.t, printable) generator =
+  let atom = printed CCSexp.to_string (map (fun s -> `Atom s) (one_of [ text ~alphabet:"ab ()\"\\;#|" ~max_size:4 (); binary ~max_size:4 () ])) in
+  if depth = 0
+  then atom
+  else
+    one_of
+      [ atom
+      ; printed CCSexp.to_string (map (fun l -> `List l) (lists (sexps (depth - 1)) ~max_size:3 ()))
+      ]
+;;
+
+let%hegel_test sexp_roundtrip tc =
+  let x = draw tc (sexps 3) in
+  let s = CCSexp.to_string x in
+  match CCSexp.parse_string s with
+  | Ok back -> if back <> x then Printf.ksprintf failwith "%S reads back as %s" s (CCSexp.to_string back)
+  | Error e -> Printf.ksprintf failwith "%S does not parse: %s" s e
+;;
+
+module%hegel_state_machine Vector = struct
+  type state =
+    { v : (int, CCVector.rw) CCVector.t
+    ; mutable m : int list
+    }
+
+  let sexp_of_state st = Sexplib0.Sexp.Atom (show_ints st.m)
+  let index tc st = draw tc (integers ~min_value:0 ~max_value:(List.length st.m - 1) ())
+
+  let push tc st =
+    let x = draw tc ints in
+    CCVector.push st.v x;
+    st.m <- st.m @ [ x ]
+  [@@rule]
+  ;;
+
+  let pop _tc st =
+    let got = CCVector.pop st.v in
+    let expected = CCList.last_opt st.m in
+    if got <> expected then failwith "pop gives the wrong element";
+    st.m <- CCList.take (List.length st.m - 1) st.m
+  [@@rule]
+  ;;
+
+  let insert tc st =
+    let i = draw tc (integers ~min_value:0 ~max_value:(List.length st.m) ()) in
+    let x = draw tc ints in
+    CCVector.insert st.v i x;
+    st.m <- CCList.insert_at_idx i x st.m
+  [@@rule]
+  ;;
+
+  let remove_and_shift tc st =
+    if st.m <> []
+    then (
+      let i = index tc st in
+      CCVector.remove_and_shift st.v i;
+      st.m <- CCList.remove_at_idx i st.m)
+  [@@rule]
+  ;;
+
+  let remove_unordered tc st =
+    if st.m <> []
+    then (
+      let i = index tc st in
+      CCVector.remove_unordered st.v i;
+      let expected = List.sort Int.compare (CCList.remove_at_idx i st.m) in
+      if List.sort Int.compare (CCVector.to_list st.v) <> expected
+      then failwith "remove_unordered removes the wrong element";
+      st.m <- CCVector.to_list st.v)
+  [@@rule]
+  ;;
+
+  let set tc st =
+    if st.m <> []
+    then (
+      let i = index tc st in
+      let x = draw tc ints in
+      CCVector.set st.v i x;
+      st.m <- CCList.set_at_idx i x st.m)
+  [@@rule]
+  ;;
+
+  let truncate tc st =
+    let n = draw tc (integers ~min_value:0 ~max_value:(List.length st.m + 2) ()) in
+    CCVector.truncate st.v n;
+    st.m <- CCList.take n st.m
+  [@@rule]
+  ;;
+
+  let append_list tc st =
+    let l = draw tc (lists ints ~max_size:5 ()) in
+    CCVector.append_list st.v l;
+    st.m <- st.m @ l
+  [@@rule]
+  ;;
+
+  let append_self _tc st =
+    CCVector.append st.v st.v;
+    st.m <- st.m @ st.m
+  [@@rule]
+  ;;
+
+  let resize_with tc st =
+    let len = List.length st.m in
+    (* containers/2: a size below the length truncates *)
+    let grow = integers ~min_value:len ~max_value:(len + 4) () in
+    let n =
+      draw
+        tc
+        (if Zoo.known && len > 0
+         then one_of [ integers ~min_value:0 ~max_value:(len - 1) (); grow; grow; grow; grow ]
+         else grow)
+    in
+    CCVector.resize_with st.v (fun i -> 100 + i) n;
+    if n > len then st.m <- st.m @ List.init (n - len) (fun k -> 100 + len + k)
+  [@@rule { weight = 5.0 }]
+  ;;
+
+  let rev_in_place _tc st =
+    CCVector.rev_in_place st.v;
+    st.m <- List.rev st.m
+  [@@rule]
+  ;;
+
+  let filter_in_place _tc st =
+    CCVector.filter_in_place (fun x -> x mod 2 = 0) st.v;
+    st.m <- List.filter (fun x -> x mod 2 = 0) st.m
+  [@@rule]
+  ;;
+
+  let uniq_sort _tc st =
+    CCVector.uniq_sort Int.compare st.v;
+    st.m <- List.sort_uniq Int.compare st.m
+  [@@rule]
+  ;;
+
+  let shrink_to_fit _tc st = CCVector.shrink_to_fit st.v [@@rule]
+
+  let clear _tc st =
+    CCVector.clear st.v;
+    st.m <- []
+  [@@rule]
+  ;;
+
+  let contents _tc st =
+    let got = CCVector.to_list st.v in
+    if got <> st.m || CCVector.length st.v <> List.length st.m
+    then Printf.ksprintf failwith "vector holds %s" (show_ints got)
+  [@@invariant]
+  ;;
+end
+
+let%hegel_test vector_machine tc = Vector.run tc ~init:{ Vector.v = CCVector.create (); m = [] }
+
+module%hegel_state_machine Deque = struct
+  type state =
+    { d : int CCDeque.t
+    ; mutable m : int list
+    }
+
+  let sexp_of_state st = Sexplib0.Sexp.Atom (show_ints st.m)
+
+  let push_front tc st =
+    let x = draw tc ints in
+    CCDeque.push_front st.d x;
+    st.m <- x :: st.m
+  [@@rule]
+  ;;
+
+  let push_back tc st =
+    let x = draw tc ints in
+    CCDeque.push_back st.d x;
+    st.m <- st.m @ [ x ]
+  [@@rule]
+  ;;
+
+  let take_front _tc st =
+    let got = CCDeque.take_front_opt st.d in
+    if got <> CCList.head_opt st.m then failwith "take_front_opt gives the wrong element";
+    st.m <- CCList.drop 1 st.m
+  [@@rule]
+  ;;
+
+  let take_back _tc st =
+    let got = CCDeque.take_back_opt st.d in
+    if got <> CCList.last_opt st.m then failwith "take_back_opt gives the wrong element";
+    st.m <- CCList.take (List.length st.m - 1) st.m
+  [@@rule]
+  ;;
+
+  let update_front tc st =
+    (* containers/4: a removal leaves the length unchanged *)
+    let remove = Zoo.known && draw tc (booleans ()) in
+    CCDeque.update_front st.d (fun x -> if remove then None else Some (x + 10));
+    st.m <-
+      (match st.m with
+       | [] -> []
+       | x :: rest -> if remove then rest else (x + 10) :: rest)
+  [@@rule]
+  ;;
+
+  let update_back tc st =
+    (* containers/4: a removal leaves the length unchanged *)
+    let remove = Zoo.known && draw tc (booleans ()) in
+    CCDeque.update_back st.d (fun x -> if remove then None else Some (x + 10));
+    st.m <-
+      (match List.rev st.m with
+       | [] -> []
+       | x :: rest -> List.rev (if remove then rest else (x + 10) :: rest))
+  [@@rule]
+  ;;
+
+  let append_back tc st =
+    let l = draw tc (lists ints ~max_size:5 ()) in
+    CCDeque.append_back ~into:st.d (CCDeque.of_list l);
+    st.m <- st.m @ l
+  [@@rule]
+  ;;
+
+  let append_front tc st =
+    let l = draw tc (lists ints ~max_size:5 ()) in
+    CCDeque.append_front ~into:st.d (CCDeque.of_list l);
+    st.m <- List.rev_append l st.m
+  [@@rule]
+  ;;
+
+  let filter_in_place _tc st =
+    CCDeque.filter_in_place st.d (fun x -> x mod 2 = 0);
+    st.m <- List.filter (fun x -> x mod 2 = 0) st.m
+  [@@rule]
+  ;;
+
+  let contents _tc st =
+    let got = CCDeque.to_list st.d in
+    if got <> st.m || CCDeque.length st.d <> List.length st.m
+    then Printf.ksprintf failwith "deque holds %s" (show_ints got);
+    if CCDeque.peek_back_opt st.d <> CCList.last_opt st.m then failwith "peek_back_opt disagrees"
+  [@@invariant]
+  ;;
+end
+
+let%hegel_test deque_machine tc = Deque.run tc ~init:{ Deque.d = CCDeque.create (); m = [] }
+
+(* containers/3 *)
+let%hegel_test deque_append_self tc =
+  let l = draw tc (lists ints ~min_size:2 ~max_size:8 ()) in
+  let back = draw tc (booleans ()) in
+  let d = CCDeque.of_list l in
+  in_child (fun () ->
+    (if back then CCDeque.append_back else CCDeque.append_front) ~into:d d;
+    if CCDeque.to_list d <> (if back then l @ l else List.rev_append l l) then Printf.ksprintf failwith "gives %s" (show_ints (CCDeque.to_list d)))
+;;
+
+module%hegel_state_machine Bitvector = struct
+  type state =
+    { bv : CCBV.t
+    ; mutable m : bool list
+    }
+
+  let sexp_of_state st =
+    Sexplib0.Sexp.Atom (String.concat "" (List.map (fun b -> if b then "1" else "0") st.m))
+  ;;
+
+  (* indices past the length extend the vector, across the 62-bit word boundary *)
+  let index tc st = draw tc (integers ~min_value:0 ~max_value:(List.length st.m + 70) ())
+
+  let write st i b =
+    let len = max (List.length st.m) (i + 1) in
+    st.m <- List.init len (fun k -> if k = i then b else Option.value (List.nth_opt st.m k) ~default:false)
+  ;;
+
+  let of_model bits = CCBV.init (List.length bits) (List.nth bits)
+  let bit_lists = lists (booleans ()) ~max_size:80 ()
+
+  let set tc st =
+    let i = index tc st in
+    CCBV.set st.bv i;
+    write st i true
+  [@@rule]
+  ;;
+
+  let reset tc st =
+    let i = index tc st in
+    CCBV.reset st.bv i;
+    write st i false
+  [@@rule]
+  ;;
+
+  let flip tc st =
+    let i = index tc st in
+    let old = Option.value (List.nth_opt st.m i) ~default:false in
+    CCBV.flip st.bv i;
+    write st i (not old)
+  [@@rule]
+  ;;
+
+  let resize tc st =
+    let n = draw tc (integers ~min_value:0 ~max_value:(List.length st.m + 70) ()) in
+    let shrink = draw tc (booleans ()) in
+    (if shrink then CCBV.resize_minimize_memory else CCBV.resize) st.bv n;
+    st.m <- List.init n (fun k -> Option.value (List.nth_opt st.m k) ~default:false)
+  [@@rule]
+  ;;
+
+  let negate_self _tc st =
+    CCBV.negate_self st.bv;
+    st.m <- List.map not st.m
+  [@@rule]
+  ;;
+
+  let filter_even _tc st =
+    CCBV.filter st.bv (fun i -> i mod 2 = 0);
+    st.m <- List.mapi (fun i b -> b && i mod 2 = 0) st.m
+  [@@rule]
+  ;;
+
+  let clear _tc st =
+    CCBV.clear st.bv;
+    st.m <- List.map (fun _ -> false) st.m
+  [@@rule]
+  ;;
+
+  let pad n bits = List.init n (fun k -> Option.value (List.nth_opt bits k) ~default:false)
+
+  let union_into tc st =
+    let other = draw tc bit_lists in
+    CCBV.union_into ~into:st.bv (of_model other);
+    let n = max (List.length st.m) (List.length other) in
+    st.m <- List.map2 ( || ) (pad n st.m) (pad n other)
+  [@@rule]
+  ;;
+
+  let inter_into tc st =
+    let other = draw tc bit_lists in
+    CCBV.inter_into ~into:st.bv (of_model other);
+    let n = min (List.length st.m) (List.length other) in
+    st.m <- List.map2 ( && ) (pad n st.m) (pad n other)
+  [@@rule]
+  ;;
+
+  let diff_into tc st =
+    let other = draw tc bit_lists in
+    CCBV.diff_into ~into:st.bv (of_model other);
+    let n = List.length st.m in
+    st.m <- List.map2 (fun a b -> a && not b) st.m (pad n other)
+  [@@rule]
+  ;;
+
+  let contents _tc st =
+    let expected = List.filter_map Fun.id (List.mapi (fun i b -> if b then Some i else None) st.m) in
+    let got = CCBV.to_sorted_list st.bv in
+    if got <> expected then Printf.ksprintf failwith "set bits %s" (show_ints got);
+    if CCBV.length st.bv <> List.length st.m
+    then Printf.ksprintf failwith "length %d, expected %d" (CCBV.length st.bv) (List.length st.m);
+    if CCBV.cardinal st.bv <> List.length expected
+    then Printf.ksprintf failwith "cardinal %d" (CCBV.cardinal st.bv);
+    if CCBV.first st.bv <> CCList.head_opt expected then failwith "first disagrees";
+    if not (CCBV.equal st.bv (of_model st.m)) then failwith "not equal to a bitvector built from the model"
+  [@@invariant]
+  ;;
+end
+
+let%hegel_test bitvector_machine tc = Bitvector.run tc ~init:{ Bitvector.bv = CCBV.empty (); m = [] }
+
+module Heap = CCHeap.Make_from_compare (Int)
+
+module%hegel_state_machine Heap_machine = struct
+  type state =
+    { mutable h : Heap.t
+    ; mutable m : int list
+    }
+
+  let sexp_of_state st = Sexplib0.Sexp.Atom (show_ints st.m)
+
+  let add tc st =
+    let x = draw tc ints in
+    st.h <- Heap.add st.h x;
+    st.m <- List.merge Int.compare [ x ] st.m
+  [@@rule]
+  ;;
+
+  let take _tc st =
+    match Heap.take st.h, st.m with
+    | None, [] -> ()
+    | Some (h, x), y :: rest when x = y ->
+      st.h <- h;
+      st.m <- rest
+    | _ -> failwith "take gives the wrong minimum"
+  [@@rule]
+  ;;
+
+  let delete_one tc st =
+    let x = draw tc ints in
+    st.h <- Heap.delete_one Int.equal x st.h;
+    st.m <- CCList.sorted_remove ~cmp:Int.compare x st.m
+  [@@rule]
+  ;;
+
+  let delete_all tc st =
+    let x = draw tc ints in
+    st.h <- Heap.delete_all Int.equal x st.h;
+    st.m <- List.filter (fun y -> y <> x) st.m
+  [@@rule]
+  ;;
+
+  let filter _tc st =
+    st.h <- Heap.filter (fun x -> x mod 2 = 0) st.h;
+    st.m <- List.filter (fun x -> x mod 2 = 0) st.m
+  [@@rule]
+  ;;
+
+  let merge tc st =
+    let l = draw tc (lists ints ~max_size:5 ()) in
+    st.h <- Heap.merge st.h (Heap.of_list l);
+    st.m <- List.merge Int.compare (List.sort Int.compare l) st.m
+  [@@rule]
+  ;;
+
+  let contents _tc st =
+    let got = Heap.to_list_sorted st.h in
+    if got <> st.m then Printf.ksprintf failwith "heap holds %s" (show_ints got);
+    if Heap.size st.h <> List.length st.m then Printf.ksprintf failwith "size %d" (Heap.size st.h);
+    if Heap.find_min st.h <> CCList.head_opt st.m then failwith "find_min disagrees"
+  [@@invariant]
+  ;;
+end
+
+let%hegel_test heap_machine tc = Heap_machine.run tc ~init:{ Heap_machine.h = Heap.empty; m = [] }
+
+module%hegel_state_machine Fqueue = struct
+  type state =
+    { mutable q : int CCFQueue.t
+    ; mutable m : int list
+    }
+
+  let sexp_of_state st = Sexplib0.Sexp.Atom (show_ints st.m)
+
+  let cons tc st =
+    let x = draw tc ints in
+    st.q <- CCFQueue.cons x st.q;
+    st.m <- x :: st.m
+  [@@rule]
+  ;;
+
+  let snoc tc st =
+    let x = draw tc ints in
+    st.q <- CCFQueue.snoc st.q x;
+    st.m <- st.m @ [ x ]
+  [@@rule]
+  ;;
+
+  let tail _tc st =
+    st.q <- CCFQueue.tail st.q;
+    st.m <- CCList.drop 1 st.m
+  [@@rule]
+  ;;
+
+  let init _tc st =
+    st.q <- CCFQueue.init st.q;
+    st.m <- CCList.take (List.length st.m - 1) st.m
+  [@@rule]
+  ;;
+
+  let take_front_l tc st =
+    let n = draw tc (integers ~min_value:0 ~max_value:(List.length st.m + 1) ()) in
+    let got, q = CCFQueue.take_front_l n st.q in
+    let expected, rest = CCList.take_drop n st.m in
+    if got <> expected then Printf.ksprintf failwith "take_front_l gives %s" (show_ints got);
+    st.q <- q;
+    st.m <- rest
+  [@@rule]
+  ;;
+
+  let take_back_l tc st =
+    let n = draw tc (integers ~min_value:0 ~max_value:(List.length st.m + 1) ()) in
+    let q, got = CCFQueue.take_back_l n st.q in
+    let rest, expected = CCList.take_drop (max 0 (List.length st.m - n)) st.m in
+    if got <> expected then Printf.ksprintf failwith "take_back_l gives %s" (show_ints got);
+    st.q <- q;
+    st.m <- rest
+  [@@rule]
+  ;;
+
+  let append tc st =
+    let l = draw tc (lists ints ~max_size:5 ()) in
+    st.q <- CCFQueue.append st.q (CCFQueue.of_list l);
+    st.m <- st.m @ l
+  [@@rule]
+  ;;
+
+  let rev _tc st =
+    st.q <- CCFQueue.rev st.q;
+    st.m <- List.rev st.m
+  [@@rule]
+  ;;
+
+  let contents _tc st =
+    let got = CCFQueue.to_list st.q in
+    if got <> st.m then Printf.ksprintf failwith "queue holds %s" (show_ints got);
+    if CCFQueue.size st.q <> List.length st.m then Printf.ksprintf failwith "size %d" (CCFQueue.size st.q);
+    if CCFQueue.last st.q <> CCList.last_opt st.m then failwith "last disagrees";
+    List.iteri
+      (fun i x -> if CCFQueue.nth i st.q <> Some x then Printf.ksprintf failwith "nth %d disagrees" i)
+      st.m
+  [@@invariant]
+  ;;
+end
+
+let%hegel_test fqueue_machine tc = Fqueue.run tc ~init:{ Fqueue.q = CCFQueue.empty; m = [] }
+
+module%hegel_state_machine Ral = struct
+  type state =
+    { mutable r : int CCRAL.t
+    ; mutable m : int list
+    }
+
+  let sexp_of_state st = Sexplib0.Sexp.Atom (show_ints st.m)
+  let index tc st = draw tc (integers ~min_value:0 ~max_value:(List.length st.m - 1) ())
+
+  let cons tc st =
+    let x = draw tc ints in
+    st.r <- CCRAL.cons x st.r;
+    st.m <- x :: st.m
+  [@@rule]
+  ;;
+
+  let tl _tc st =
+    if st.m <> []
+    then (
+      st.r <- CCRAL.tl st.r;
+      st.m <- List.tl st.m)
+  [@@rule]
+  ;;
+
+  let set tc st =
+    if st.m <> []
+    then (
+      let i = index tc st in
+      let x = draw tc ints in
+      st.r <- CCRAL.set st.r i x;
+      st.m <- CCList.set_at_idx i x st.m)
+  [@@rule]
+  ;;
+
+  let remove tc st =
+    if st.m <> []
+    then (
+      let i = index tc st in
+      st.r <- CCRAL.remove st.r i;
+      st.m <- CCList.remove_at_idx i st.m)
+  [@@rule]
+  ;;
+
+  let append tc st =
+    let l = draw tc (lists ints ~max_size:5 ()) in
+    st.r <- CCRAL.append st.r (CCRAL.of_list l);
+    st.m <- st.m @ l
+  [@@rule]
+  ;;
+
+  let take tc st =
+    let n = draw tc (integers ~min_value:0 ~max_value:(List.length st.m + 1) ()) in
+    st.r <- CCRAL.take n st.r;
+    st.m <- CCList.take n st.m
+  [@@rule]
+  ;;
+
+  let drop tc st =
+    let n = draw tc (integers ~min_value:0 ~max_value:(List.length st.m + 1) ()) in
+    st.r <- CCRAL.drop n st.r;
+    st.m <- CCList.drop n st.m
+  [@@rule]
+  ;;
+
+  let rev _tc st =
+    st.r <- CCRAL.rev st.r;
+    st.m <- List.rev st.m
+  [@@rule]
+  ;;
+
+  let contents _tc st =
+    let got = CCRAL.to_list st.r in
+    if got <> st.m then Printf.ksprintf failwith "list holds %s" (show_ints got);
+    if CCRAL.length st.r <> List.length st.m then Printf.ksprintf failwith "length %d" (CCRAL.length st.r);
+    List.iteri
+      (fun i x -> if CCRAL.get st.r i <> Some x then Printf.ksprintf failwith "get %d disagrees" i)
+      st.m
+  [@@invariant]
+  ;;
+end
+
+let%hegel_test ral_machine tc = Ral.run tc ~init:{ Ral.r = CCRAL.empty; m = [] }
