+let pin_range_by_overflow () =
+  let step = min_int / 4 in
+  let got = CCList.range_by ~step 1 min_int in
+  let expected = [ 1; 1 + step; 1 + (2 * step); 1 + (3 * step); 1 + (4 * step) ] in
+  if got <> expected then Printf.ksprintf failwith "gives %s" (show_ints got)
+;;
+
+let pin_vector_resize_with_shrinks () =
+  let v = CCVector.of_list [ 1; 2; 3 ] in
+  CCVector.resize_with v Fun.id 1;
+  if CCVector.to_list v <> [ 1; 2; 3 ] then Printf.ksprintf failwith "gives %s" (show_ints (CCVector.to_list v))
+;;
+
+let pin_deque_append_self () =
+  let d = CCDeque.of_list [ 0; 1 ] in
+  CCDeque.append_back ~into:d d;
+  if CCDeque.to_list d <> [ 0; 1; 0; 1 ] then Printf.ksprintf failwith "gives %s" (show_ints (CCDeque.to_list d))
+;;
+
+let pin_deque_update_front_removes () =
+  let d = CCDeque.of_list [ 1; 2 ] in
+  CCDeque.update_front d (fun _ -> None);
+  if CCDeque.length d <> 1 then Printf.ksprintf failwith "length %d after removing one of two" (CCDeque.length d)
+;;
