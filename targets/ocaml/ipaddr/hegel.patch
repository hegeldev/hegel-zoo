new file mode 100644
index 0000000..ce31977
--- /dev/null
+++ b/hegel/zoo.ml
@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
diff --git a/hegel/zoo_tests.ml b/hegel/zoo_tests.ml
new file mode 100644
index 0000000..4de2d3c
--- /dev/null
+++ b/hegel/zoo_tests.ml
@@ -0,0 +1,456 @@
+open Hegel
+open Upstream
+
+let python_oracle =
+  {|
+import ipaddress as A, sys
+
+# 3.13 prints IPv4-mapped addresses dotted, as RFC 5952 recommends and ipaddr does
+if sys.version_info < (3, 13):
+    print("python 3.13 or later is needed", flush=True)
+    sys.exit(1)
+
+def addr(h):
+    b = h.encode("latin-1")
+    return A.IPv4Address(b) if len(b) == 4 else A.IPv6Address(b)
+
+def net(h, bits):
+    return A.ip_network((addr(h), int(bits)), strict=False)
+
+def out(*xs):
+    return " ".join(x.packed.hex() if hasattr(x, "packed") else str(x) for x in xs)
+
+def bounds(n):
+    if n.prefixlen >= n.max_prefixlen - 1:
+        first, last = n.network_address, n.broadcast_address
+    elif n.version == 4:
+        first, last = n.network_address + 1, n.broadcast_address - 1
+    else:
+        first, last = n.network_address + 1, n.broadcast_address
+    broadcast = [n.broadcast_address] if n.version == 4 else []
+    return out(n.network_address, n.netmask, *broadcast, first, last)
+
+# ipaddr's top-level mem and subset map IPv4 into ::ffff:0:0/96 rather than keep the versions apart
+def as_v6(a):
+    return a if a.version == 6 else A.IPv6Address(bytes(10) + b"\xff\xff" + a.packed)
+
+def as_v6_net(n):
+    return n if n.version == 6 else A.IPv6Network((as_v6(n.network_address), n.prefixlen + 96))
+
+OPS = {
+    "parse": lambda s: out(A.ip_address(s)),
+    "parse_prefix": lambda s: (lambda i: out(i.ip, i.network.prefixlen))(A.ip_interface(s)),
+    "to_string": lambda h: str(addr(h)),
+    "prefix_to_string": lambda h, bits: str(A.ip_interface((addr(h), int(bits)))),
+    "bounds": lambda h, bits: bounds(net(h, bits)),
+    "mem": lambda h, n, bits: str(as_v6(addr(h)) in as_v6_net(net(n, bits))),
+    "subset": lambda h, bits, n, nbits: str(as_v6_net(net(h, bits)).subnet_of(as_v6_net(net(n, nbits)))),
+    "succ": lambda h: out(addr(h) + 1),
+    "pred": lambda h: out(addr(h) - 1),
+    "subnets": lambda h, bits, n: out(*(s.network_address for s in net(h, bits).subnets(new_prefix=int(n)))),
+    # Python 3.13+ judges an IPv4-mapped address by its IPv4 address; RFC 4291 multicast is ff00::/8
+    "multicast": lambda h: str(addr(h).is_multicast if addr(h).version == 4 else addr(h) in A.IPv6Network("ff00::/8")),
+    "ipv4_mapped": lambda h: out(addr(h).ipv4_mapped),
+}
+
+for line in sys.stdin:
+    op, *args = line.rstrip("\n").split("\t")
+    args = [bytes.fromhex(a).decode("latin-1") for a in args]
+    try:
+        print("OK", OPS[op](*args), flush=True)
+    except ValueError:
+        print("ERR", flush=True)
+|}
+;;
+
+let hex s = String.concat "" (List.of_seq (Seq.map (fun c -> Printf.sprintf "%02x" (Char.code c)) (String.to_seq s)))
+let python = lazy (Unix.open_process_args "python3" [| "python3"; "-c"; python_oracle |])
+
+let ask op args =
+  let ic, oc = Lazy.force python in
+  output_string oc (String.concat "\t" (op :: List.map hex args) ^ "\n");
+  flush oc;
+  match input_line ic with
+  | "ERR" -> None
+  | line when String.starts_with ~prefix:"OK " line ->
+    Some (String.sub line 3 (String.length line - 3))
+  | line -> failwith ("python: " ^ line)
+;;
+
+let expect_python what ours op args =
+  let theirs = ask op args in
+  if not (Option.equal String.equal ours theirs)
+  then
+    failwith
+      (Printf.sprintf
+         "%s: ipaddr %s, python %s"
+         what
+         (Option.value ours ~default:"error")
+         (Option.value theirs ~default:"error"))
+;;
+
+let packed a = hex (Ipaddr.to_octets a)
+let python_bool b = if b then "True" else "False"
+let prefix_args p = [ Ipaddr.to_octets (Ipaddr.Prefix.address p); string_of_int (Ipaddr.Prefix.bits p) ]
+let shown g = with_printer (fun s -> Sexplib0.Sexp.Atom s) g
+let addresses g = with_printer (fun a -> Sexplib0.Sexp.Atom (Ipaddr.to_string a)) g
+let prefixes g = with_printer (fun p -> Sexplib0.Sexp.Atom (Ipaddr.Prefix.to_string p)) g
+
+let edge_or_any lo hi =
+  one_of
+    [ integers ~min_value:lo ~max_value:lo ()
+    ; integers ~min_value:hi ~max_value:hi ()
+    ; integers ~min_value:lo ~max_value:hi ()
+    ]
+;;
+
+let v4 = map (fun n -> Ipaddr.V4 (Ipaddr.V4.of_int32 (Int32.of_int n))) (edge_or_any 0 0xFFFF_FFFF)
+
+let v6_groups =
+  map
+    (function
+      | [ a; b; c; d; e; f; g; h ] -> Ipaddr.V6.make a b c d e f g h
+      | _ -> assert false)
+    (lists (edge_or_any 0 0xFFFF) ~min_size:8 ~max_size:8 ())
+;;
+
+let v4_mapped =
+  map (fun (hi, lo) -> Ipaddr.V6.make 0 0 0 0 0 0xFFFF hi lo) (tuples2 (edge_or_any 0 0xFFFF) (edge_or_any 0 0xFFFF))
+;;
+
+let v6s g = with_printer (fun a -> Sexplib0.Sexp.Atom (Ipaddr.V6.to_string a)) g
+let v6 = map (fun a -> Ipaddr.V6 a) (one_of [ v6s v6_groups; v6s v4_mapped ])
+let any_address = one_of [ addresses v4; addresses v6 ]
+
+let make_prefix bits : Ipaddr.t -> Ipaddr.Prefix.t = function
+  | V4 a -> V4 (Ipaddr.V4.Prefix.make bits a)
+  | V6 a -> V6 (Ipaddr.V6.Prefix.make bits a)
+;;
+
+let max_bits : Ipaddr.t -> int = function
+  | V4 _ -> 32
+  | V6 _ -> 128
+;;
+
+let any_prefix =
+  prefixes
+    (flat_map
+       (fun a -> map (fun bits -> make_prefix bits a) (edge_or_any 0 (max_bits a)))
+       any_address)
+;;
+
+let group_value = edge_or_any 0 0xFFFF
+
+let plain_group =
+  one_of
+    [ shown (map (Printf.sprintf "%x") group_value)
+    ; shown (map (Printf.sprintf "%X") group_value)
+    ; shown (map (Printf.sprintf "%04x") group_value)
+    ]
+;;
+
+let any_group =
+  one_of [ plain_group; shown (map (Printf.sprintf "%x") (integers ~min_value:0x10000 ~max_value:0xFFFFF ())) ]
+;;
+
+let plain_octet = shown (map string_of_int (integers ~min_value:0 ~max_value:255 ()))
+
+let any_octet =
+  one_of
+    [ plain_octet
+    ; shown (map (Printf.sprintf "%03d") (integers ~min_value:0 ~max_value:255 ()))
+    ; shown (map string_of_int (integers ~min_value:256 ~max_value:99999 ()))
+    ]
+;;
+
+let joined sep g = shown (map (String.concat sep) g)
+let dotted octet ~min_size ~max_size = joined "." (lists octet ~min_size ~max_size ())
+
+let v4_text =
+  one_of
+    [ dotted plain_octet ~min_size:4 ~max_size:4
+    ; dotted any_octet ~min_size:4 ~max_size:4
+    ; dotted any_octet ~min_size:0 ~max_size:6
+    ]
+;;
+
+let compressed group ~side tail =
+  shown
+    (map
+       (fun (left, right, tail) -> String.concat ":" left ^ "::" ^ String.concat ":" (right @ tail))
+       (tuples3 (lists group ~max_size:side ()) (lists group ~max_size:side ()) tail))
+;;
+
+let no_tail = lists v4_text ~max_size:0 ()
+let v4_tail octet = lists (dotted octet ~min_size:4 ~max_size:4) ~min_size:1 ~max_size:1 ()
+
+let embedded group octet =
+  joined ":" (map (fun (gs, tail) -> gs @ tail) (tuples2 (lists group ~min_size:6 ~max_size:6 ()) (v4_tail octet)))
+;;
+
+let v6_text =
+  one_of
+    [ joined ":" (lists plain_group ~min_size:8 ~max_size:8 ())
+    ; compressed plain_group ~side:3 no_tail
+    ; embedded plain_group plain_octet
+    ; compressed plain_group ~side:2 (v4_tail plain_octet)
+    ; joined ":" (lists any_group ~min_size:0 ~max_size:9 ())
+    ; compressed any_group ~side:7 no_tail
+    ; embedded any_group any_octet
+    ; compressed any_group ~side:7 (lists v4_text ~min_size:1 ~max_size:1 ())
+    ]
+;;
+
+let edited g =
+  one_of
+    [ g
+    ; g
+    ; shown
+        (flat_map
+           (fun s ->
+              map
+                (fun (i, ins) ->
+                   let rest = if String.equal ins "" then i + 1 else i in
+                   let rest = min rest (String.length s) in
+                   String.sub s 0 i ^ ins ^ String.sub s rest (String.length s - rest))
+                (tuples2
+                   (integers ~min_value:0 ~max_value:(String.length s) ())
+                   (text ~alphabet:":.0aF/x-" ~max_size:1 ())))
+           g)
+    ]
+;;
+
+(* ipaddr/2 *)
+let overlong_group = shown (map (Printf.sprintf "::0%04x") group_value)
+
+let with_known shape g = if Zoo.known then one_of [ shape; g; g; g; g ] else g
+let address_text = with_known overlong_group (edited (one_of [ v4_text; v6_text ]))
+
+let bits_text =
+  one_of
+    [ shown (map string_of_int (integers ~min_value:0 ~max_value:32 ()))
+    ; shown (map string_of_int (integers ~min_value:0 ~max_value:128 ()))
+    ; shown (map (Printf.sprintf "0%d") (integers ~min_value:0 ~max_value:128 ()))
+    ; shown (map string_of_int (integers ~min_value:129 ~max_value:999 ()))
+    ]
+;;
+
+let slashed addresses = shown (map (fun (a, b) -> a ^ "/" ^ b) (tuples2 addresses bits_text))
+let prefix_text = with_known (slashed overlong_group) (edited (slashed (one_of [ v4_text; v6_text ])))
+
+let%hegel_test of_string tc =
+  let s = draw tc address_text in
+  let ours = Option.map packed (Result.to_option (Ipaddr.of_string s)) in
+  expect_python "parse" ours "parse" [ s ]
+;;
+
+let%hegel_test to_string tc =
+  let a = draw tc any_address in
+  expect_python "to_string" (Some (Ipaddr.to_string a)) "to_string" [ Ipaddr.to_octets a ]
+;;
+
+let%hegel_test prefix_of_string tc =
+  let s = draw tc prefix_text in
+  (* without a slash Python reads a host address *)
+  assume tc (String.contains s '/');
+  let ours =
+    Option.map
+      (fun p -> packed (Ipaddr.Prefix.address p) ^ " " ^ string_of_int (Ipaddr.Prefix.bits p))
+      (Result.to_option (Ipaddr.Prefix.of_string s))
+  in
+  expect_python "parse_prefix" ours "parse_prefix" [ s ]
+;;
+
+let%hegel_test prefix_to_string tc =
+  let p = draw tc any_prefix in
+  expect_python "prefix_to_string" (Some (Ipaddr.Prefix.to_string p)) "prefix_to_string" (prefix_args p)
+;;
+
+let%hegel_test prefix_bounds tc =
+  let p = draw tc any_prefix in
+  let broadcast =
+    match p with
+    | V4 q -> [ Ipaddr.V4 (Ipaddr.V4.Prefix.broadcast q) ]
+    | V6 _ -> []
+  in
+  let ours =
+    [ Ipaddr.Prefix.network p; Ipaddr.Prefix.netmask p ]
+    @ broadcast
+    @ [ Ipaddr.Prefix.first p; Ipaddr.Prefix.last p ]
+  in
+  expect_python "bounds" (Some (String.concat " " (List.map packed ours))) "bounds" (prefix_args p)
+;;
+
+let%hegel_test mem tc =
+  let p = draw tc any_prefix in
+  let a = draw tc any_address in
+  expect_python "mem" (Some (python_bool (Ipaddr.Prefix.mem a p))) "mem" (Ipaddr.to_octets a :: prefix_args p)
+;;
+
+let%hegel_test subset tc =
+  let subnet = draw tc any_prefix in
+  let network = draw tc any_prefix in
+  expect_python
+    "subset"
+    (Some (python_bool (Ipaddr.Prefix.subset ~subnet ~network)))
+    "subset"
+    (prefix_args subnet @ prefix_args network)
+;;
+
+let%hegel_test octets_roundtrip tc =
+  let b = draw tc (one_of [ binary ~min_size:4 ~max_size:4 (); binary ~min_size:16 ~max_size:16 () ]) in
+  let a = Ipaddr.of_octets_exn b in
+  if not (String.equal (Ipaddr.to_octets a) b) then failwith (Ipaddr.to_string a)
+;;
+
+let%hegel_test succ tc =
+  let a = draw tc any_address in
+  expect_python "succ" (Option.map packed (Result.to_option (Ipaddr.succ a))) "succ" [ Ipaddr.to_octets a ]
+;;
+
+let%hegel_test pred tc =
+  let a = draw tc any_address in
+  expect_python "pred" (Option.map packed (Result.to_option (Ipaddr.pred a))) "pred" [ Ipaddr.to_octets a ]
+;;
+
+let subnet_split ~lo ~hi p = map (fun n -> p, n) (integers ~min_value:lo ~max_value:hi ())
+
+let any_split =
+  flat_map
+    (fun p ->
+       let bits = Ipaddr.Prefix.bits p in
+       subnet_split ~lo:bits ~hi:(min (max_bits (Ipaddr.Prefix.address p)) (bits + 4)) p)
+    any_prefix
+;;
+
+(* ipaddr/1 *)
+let default_route_split =
+  flat_map (fun a -> subnet_split ~lo:1 ~hi:4 (make_prefix 0 a)) (addresses v4)
+;;
+
+let splits =
+  let shown g =
+    with_printer
+      (fun (p, n) -> Sexplib0.Sexp.Atom (Printf.sprintf "%s into /%d" (Ipaddr.Prefix.to_string p) n))
+      g
+  in
+  with_known (shown default_route_split) (shown any_split)
+;;
+
+let%hegel_test subnets tc =
+  let p, n = draw tc splits in
+  let ours =
+    match Ipaddr.Prefix.subnets n p with
+    | V4 qs -> List.of_seq (Seq.map (fun q -> Ipaddr.V4 (Ipaddr.V4.Prefix.network q)) qs)
+    | V6 qs -> List.of_seq (Seq.map (fun q -> Ipaddr.V6 (Ipaddr.V6.Prefix.network q)) qs)
+  in
+  expect_python
+    "subnets"
+    (Some (String.concat " " (List.map packed ours)))
+    "subnets"
+    (prefix_args p @ [ string_of_int n ])
+;;
+
+let pin_overlong_v6_group () =
+  match Ipaddr.V6.of_string "::00001" with
+  | Ok a -> failwith ("::00001 reads as " ^ Ipaddr.V6.to_string a)
+  | Error _ -> ()
+;;
+
+let pin_v4_subnets_of_default_route () =
+  let halves = Ipaddr.V4.Prefix.subnets 1 (Ipaddr.V4.Prefix.of_string_exn "0.0.0.0/0") in
+  if Seq.length halves <> 2 then failwith (Printf.sprintf "%d subnets" (Seq.length halves))
+;;
+
+let%hegel_test is_multicast tc =
+  let a = draw tc any_address in
+  expect_python "multicast" (Some (python_bool (Ipaddr.is_multicast a))) "multicast" [ Ipaddr.to_octets a ]
+;;
+
+let%hegel_test v4_of_v6 tc =
+  let a = draw tc (one_of [ v6s v6_groups; v6s v4_mapped ]) in
+  let ours =
+    match Ipaddr.v4_of_v6 a with
+    | None -> "None"
+    | Some b -> packed (V4 b)
+  in
+  expect_python "ipv4_mapped" (Some ours) "ipv4_mapped" [ Ipaddr.V6.to_octets a ]
+;;
+
+let mac_model s =
+  let is_hex c = String.contains "0123456789abcdefABCDEF" c in
+  let sep = if String.length s > 2 then s.[2] else ' ' in
+  if String.length s = 17
+     && (sep = ':' || sep = '-')
+     && List.for_all (fun i -> is_hex s.[3 * i] && is_hex s.[(3 * i) + 1]) [ 0; 1; 2; 3; 4; 5 ]
+     && List.for_all (fun i -> s.[(3 * i) + 2] = sep) [ 0; 1; 2; 3; 4 ]
+  then Some (String.init 6 (fun i -> Char.chr (int_of_string ("0x" ^ String.sub s (3 * i) 2))))
+  else None
+;;
+
+let mac_text =
+  let pair = text ~alphabet:"0123456789abcdefABCDEFg" ~min_size:1 ~max_size:3 () in
+  let pair = one_of [ text ~alphabet:"0123456789abcdefABCDEF" ~min_size:2 ~max_size:2 (); pair ] in
+  let sep = text ~alphabet:":-. " ~min_size:1 ~max_size:1 () in
+  edited
+    (shown
+       (map
+          (fun (pairs, seps) ->
+             let rec weave ps ss =
+               match ps, ss with
+               | p :: ps, s :: ss when ps <> [] -> p ^ s ^ weave ps ss
+               | p :: ps, _ -> p ^ String.concat "" ps
+               | [], _ -> ""
+             in
+             weave pairs seps)
+          (tuples2
+             (lists pair ~min_size:5 ~max_size:7 ())
+             (one_of
+                [ map (fun c -> List.init 6 (fun _ -> c)) sep |> with_printer (fun l -> Sexplib0.Sexp.Atom (String.concat "" l))
+                ; lists sep ~min_size:6 ~max_size:6 ()
+                ]))))
+;;
+
+let%hegel_test macaddr_of_string tc =
+  let s = draw tc mac_text in
+  let ours = Option.map Macaddr.to_octets (Result.to_option (Macaddr.of_string s)) in
+  let model = mac_model s in
+  if not (Option.equal String.equal ours model)
+  then
+    failwith
+      (Printf.sprintf
+         "ipaddr %s, model %s"
+         (Option.fold ~none:"error" ~some:hex ours)
+         (Option.fold ~none:"error" ~some:hex model))
+;;
+
+let%hegel_test macaddr_to_string_roundtrip tc =
+  let m = Macaddr.of_octets_exn (draw tc (binary ~min_size:6 ~max_size:6 ())) in
+  let sep = draw tc (text ~alphabet:":-" ~min_size:1 ~max_size:1 ()) in
+  let s = Macaddr.to_string ~sep:sep.[0] m in
+  match Macaddr.of_string s with
+  | Ok m' when Macaddr.compare m m' = 0 -> ()
+  | _ -> failwith (s ^ " does not read back")
+;;
+
+let () =
+  Zoo.run
+    [ "of_string", of_string
+    ; "pin_overlong_v6_group", pin_overlong_v6_group
+    ; "to_string", to_string
+    ; "prefix_of_string", prefix_of_string
+    ; "prefix_to_string", prefix_to_string
+    ; "prefix_bounds", prefix_bounds
+    ; "mem", mem
+    ; "subset", subset
+    ; "octets_roundtrip", octets_roundtrip
+    ; "succ", succ
+    ; "pred", pred
+    ; "subnets", subnets
+    ; "pin_v4_subnets_of_default_route", pin_v4_subnets_of_default_route
+    ; "is_multicast", is_multicast
+    ; "v4_of_v6", v4_of_v6
+    ; "macaddr_of_string", macaddr_of_string
+    ; "macaddr_to_string_roundtrip", macaddr_to_string_roundtrip
+    ]
+;;
