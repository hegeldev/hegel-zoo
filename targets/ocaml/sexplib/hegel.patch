+let pin_render_grown_atom_before_sexp_comment () =
+  match layout "(a #;x)" with
+  | [ Sexp (List (p, Sexp (Atom (ap, _, _)) :: rest, q)) ] ->
+    let r =
+      render_layout [ Layout.Sexp (List (p, Sexp (Atom (ap, "ab", None)) :: rest, q)) ]
+    in
+    (match Layout.Forget.t_or_comments (layout r) with
+     | got ->
+       if not (equal_list got [ List [ Atom "ab" ] ])
+       then Printf.ksprintf failwith "%S reads %s" r (show_list got)
+     | exception e -> Printf.ksprintf failwith "%S raises %s" r (Printexc.to_string e))
+  | _ -> failwith "unexpected layout"
