+(* sexplib/4: m * n wraps round to the length of the data *)
+let wrapping_dims =
+  printed
+    (fun (m, n) -> Printf.sprintf "%d x %d" m n)
+    (map (fun k -> 1 lsl k, 1 lsl (63 - k)) (integers ~min_value:2 ~max_value:61 ()))
+;;
