@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
diff --git a/hegel/zoo_tests.ml b/hegel/zoo_tests.ml
new file mode 100644
index 0000000..187504f
--- /dev/null
+++ b/hegel/zoo_tests.ml
@@ -0,0 +1,1629 @@
+open Hegel
+open Sexplib
+
+let printed show g = with_printer (fun x -> Sexp.Atom (show x)) g
+let spelled g = with_printer (fun s -> Sexp.Atom s) g
+let sexp g = with_printer Fun.id g
+
+let pool =
+  [ 'a'
+  ; 'b'
+  ; '#'
+  ; '|'
+  ; ';'
+  ; '\\'
+  ; '"'
+  ; '('
+  ; ')'
+  ; ' '
+  ; '\n'
+  ; '\t'
+  ; '\012'
+  ; '\011'
+  ; '\000'
+  ; '\''
+  ; '\r'
+  ; '\200'
+  ]
+;;
+
+let atom_text =
+  one_of
+    [ text ~alphabet:"abc" ~min_size:1 ~max_size:3 ()
+    ; spelled
+        (map
+           (fun cs -> String.of_seq (List.to_seq cs))
+           (lists (printed (String.make 1) (sampled_from pool)) ~max_size:6 ()))
+    ; binary ~max_size:4 ()
+    ]
+;;
+
+let leaf = sexp (map (fun s -> Sexp.Atom s) atom_text)
+
+let rec tree depth =
+  if depth = 0
+  then leaf
+  else
+    one_of
+      [ leaf
+      ; sexp (map (fun l -> Sexp.List l) (lists (tree (depth - 1)) ~max_size:4 ()))
+      ]
+;;
+
+let values = tree 3
+let documents = with_printer (fun l -> Sexp.List l) (lists values ~max_size:3 ())
+
+type token =
+  | Open
+  | Close
+  | Bare of string
+  | Quoted of string
+  | Space of string
+  | Line of string
+  | Block of string
+  | Sexp_comment
+
+let render tokens =
+  let b = Buffer.create 64 in
+  ignore
+    (List.fold_left
+       (fun prev t ->
+          (match prev, t with
+           | Some (Bare _), (Bare _ | Block _ | Sexp_comment) | Some (Bare "#"), Line _ ->
+             Buffer.add_char b ' '
+           | _ -> ());
+          Buffer.add_string
+            b
+            (match t with
+             | Open -> "("
+             | Close -> ")"
+             | Bare s | Quoted s | Space s | Line s | Block s -> s
+             | Sexp_comment -> "#;");
+          Some t)
+       None
+       tokens);
+  Buffer.contents b
+;;
+
+let has s sub =
+  let n = String.length sub in
+  let rec go i = i + n <= String.length s && (String.sub s i n = sub || go (i + 1)) in
+  go 0
+;;
+
+let bare_ok s =
+  s <> ""
+  && String.for_all (fun c -> not (String.contains " \n\t\012\r\"();" c)) s
+  && (not (has s "#|"))
+  && not (has s "|#")
+;;
+
+(* The README gives quoted atoms OCaml's lexical conventions, where "\ " is a space and a
+   truncated escape like "\9" keeps its backslash; parsexp documents keeping the backslash
+   of "\ " and rejects truncated escapes. [old] selects the ocamllex reader's reading. *)
+let char_spellings ~old c =
+  let raw = if c = '"' || c = '\\' || c = '\r' then [] else [ String.make 1 c ] in
+  let short =
+    match c with
+    | '\n' -> [ "\\n" ]
+    | '\t' -> [ "\\t" ]
+    | '\b' -> [ "\\b" ]
+    | '\r' -> [ "\\r" ]
+    | '\\' -> [ "\\\\" ]
+    | '"' -> [ "\\\"" ]
+    | '\'' -> [ "\\'" ]
+    | ' ' when old -> [ "\\ " ]
+    | _ -> []
+  in
+  let code = Char.code c in
+  raw
+  @ short
+  @ [ Printf.sprintf "\\%03d" code
+    ; Printf.sprintf "\\x%02x" code
+    ; Printf.sprintf "\\x%02X" code
+    ]
+;;
+
+let escape_starts ~old =
+  if old then "\\\"'ntbrx0123456789\n\r " else "\\\"'ntbrx0123456789\n\r"
+;;
+
+let continuation = map (fun ws -> "\\\n" ^ ws) (text ~alphabet:" \t" ~max_size:2 ())
+
+let quoted ~old s =
+  composite (fun tc ->
+    let n = String.length s in
+    let b = Buffer.create (n + 2) in
+    Buffer.add_char b '"';
+    let rec go i =
+      if i <= n
+      then (
+        let piece, next =
+          if i = n
+          then "\"", i + 1
+          else if
+            s.[i] = '\\'
+            && i + 1 < n
+            && not (String.contains (escape_starts ~old) s.[i + 1])
+          then
+            draw_silent
+              tc
+              (sampled_from [ "\\\\", i + 1; "\\" ^ String.make 1 s.[i + 1], i + 2 ])
+          else draw_silent tc (sampled_from (char_spellings ~old s.[i])), i + 1
+        in
+        if piece.[0] <> ' ' && piece.[0] <> '\t' && draw_silent tc (booleans ~p:0.1 ())
+        then Buffer.add_string b (draw_silent tc continuation);
+        Buffer.add_string b piece;
+        go next)
+    in
+    go 0;
+    Buffer.contents b)
+;;
+
+let blanks = text ~alphabet:" \n\t\012" ~min_size:1 ~max_size:3 ()
+
+let line_comment =
+  map (fun s -> ";" ^ s ^ "\n") (text ~alphabet:"ab ;#|\"()" ~max_size:4 ())
+;;
+
+let rec block ~strings depth =
+  let piece =
+    one_of
+      ([ text ~alphabet:"ab ;\n()" ~max_size:3 () ]
+       @ (if strings then [ spelled (flat_map (quoted ~old:false) atom_text) ] else [])
+       @ if depth = 0 then [] else [ block ~strings (depth - 1) ])
+  in
+  spelled (map (fun ps -> "#|" ^ String.concat "" ps ^ "|#") (lists piece ~max_size:3 ()))
+;;
+
+let token g = with_printer (fun t -> Sexp.Atom (render [ t ])) g
+
+let comment_of block =
+  one_of
+    [ token (map (fun s -> Space s) blanks)
+    ; token (map (fun s -> Line s) line_comment)
+    ; token (map (fun s -> Block s) block)
+    ]
+;;
+
+let gap_piece_of comment =
+  let shown g =
+    with_printer
+      (function
+        | `Comment t -> Sexp.Atom (render [ t ])
+        | `Sexp_comment v -> Sexp.List [ Sexp.Atom "#;"; v ])
+      g
+  in
+  one_of
+    [ shown (map (fun t -> `Comment t) comment)
+    ; shown (map (fun v -> `Sexp_comment v) (tree 1))
+    ]
+;;
+
+let comment = comment_of (block ~strings:true 2)
+let gap_piece = gap_piece_of comment
+
+(* sexplib/5: the ocamllex reader prepends the strings in a block comment to the quoted atom
+   that follows it *)
+let old_comment = comment_of (block ~strings:Zoo.known 2)
+let old_gap_piece = gap_piece_of old_comment
+
+let rec spell ~old tc (v : Sexp.t) =
+  match v with
+  | Atom s ->
+    (match
+       if bare_ok s then draw_silent tc (sampled_from [ `Bare; `Quoted ]) else `Quoted
+     with
+     | `Bare -> [ Bare s ]
+     | `Quoted -> [ Quoted (draw_silent tc (quoted ~old s)) ])
+  | List l ->
+    (Open :: gap ~old tc)
+    @ List.concat_map (fun x -> spell ~old tc x @ gap ~old tc) l
+    @ [ Close ]
+
+and gap ~old tc =
+  List.concat_map
+    (function
+      | `Comment t -> [ t ]
+      | `Sexp_comment v ->
+        (Sexp_comment
+         :: draw_silent tc (lists (if old then old_comment else comment) ~max_size:1 ()))
+        @ spell ~old tc v)
+    (draw_silent tc (lists (if old then old_gap_piece else gap_piece) ~max_size:2 ()))
+;;
+
+let document ?(old = false) vs =
+  spelled
+    (composite (fun tc ->
+       render (gap ~old tc @ List.concat_map (fun v -> spell ~old tc v @ gap ~old tc) vs)))
+;;
+
+let edits text =
+  let n = String.length text in
+  let at = integers ~min_value:0 ~max_value:n () in
+  let inserted =
+    spelled
+      (sampled_from
+         [ "("
+         ; ")"
+         ; "\""
+         ; "\\"
+         ; "#"
+         ; "|"
+         ; ";"
+         ; "\n"
+         ; "x"
+         ; " "
+         ; "\\256"
+         ; "\\999"
+         ; "\\25"
+         ; "\\x4"
+         ; "\\xg0"
+         ; "#|"
+         ; "|#"
+         ; "#;"
+         ; "\\ "
+         ])
+  in
+  one_of
+    ([ spelled (just text)
+     ; spelled (map (fun i -> String.sub text 0 i) at)
+     ; spelled
+         (map
+            (fun (i, ins) -> String.sub text 0 i ^ ins ^ String.sub text i (n - i))
+            (tuples2 at inserted))
+     ]
+     @
+     if n = 0
+     then []
+     else
+       [ spelled
+           (map
+              (fun i -> String.sub text 0 i ^ String.sub text (i + 1) (n - i - 1))
+              (integers ~min_value:0 ~max_value:(n - 1) ()))
+       ])
+;;
+
+let edited ?old vs = spelled (flat_map edits (document ?old vs))
+
+exception Reject
+
+(* A reader written to the README grammar; it returns every node's [start, stop) range in
+   preorder. *)
+let read_reference ?(old = false) s =
+  let n = String.length s in
+  let pos = ref 0 in
+  let peek k = if !pos + k < n then Some s.[!pos + k] else None in
+  let at sub =
+    !pos + String.length sub <= n && String.sub s !pos (String.length sub) = sub
+  in
+  let ranges = ref [] in
+  let digit k =
+    match peek k with
+    | Some '0' .. '9' -> true
+    | _ -> false
+  in
+  let hex k =
+    match peek k with
+    | Some ('0' .. '9' | 'a' .. 'f' | 'A' .. 'F') -> true
+    | _ -> false
+  in
+  let quoted_string () =
+    incr pos;
+    let b = Buffer.create 8 in
+    let rec go () =
+      match peek 0 with
+      | None -> raise Reject
+      | Some '"' -> incr pos
+      | Some '\\' ->
+        incr pos;
+        (match peek 0 with
+         | None -> raise Reject
+         | Some (('\\' | '"' | '\'') as c) ->
+           Buffer.add_char b c;
+           incr pos
+         | Some ' ' when old ->
+           Buffer.add_char b ' ';
+           incr pos
+         | Some 'n' ->
+           Buffer.add_char b '\n';
+           incr pos
+         | Some 't' ->
+           Buffer.add_char b '\t';
+           incr pos
+         | Some 'b' ->
+           Buffer.add_char b '\b';
+           incr pos
+         | Some 'r' ->
+           Buffer.add_char b '\r';
+           incr pos
+         | Some '0' .. '9' when old && not (digit 1 && digit 2) -> Buffer.add_char b '\\'
+         | Some 'x' when old && not (hex 1 && hex 2) -> Buffer.add_char b '\\'
+         | Some '0' .. '9' ->
+           if not (digit 1 && digit 2) then raise Reject;
+           let v = int_of_string (String.sub s !pos 3) in
+           if v > 255 then raise Reject;
+           Buffer.add_char b (Char.chr v);
+           pos := !pos + 3
+         | Some 'x' ->
+           if not (hex 1 && hex 2) then raise Reject;
+           Buffer.add_char b (Char.chr (int_of_string ("0x" ^ String.sub s (!pos + 1) 2)));
+           pos := !pos + 3
+         | Some '\n' ->
+           incr pos;
+           while peek 0 = Some ' ' || peek 0 = Some '\t' do
+             incr pos
+           done
+         | Some _ -> Buffer.add_char b '\\');
+        go ()
+      | Some c ->
+        Buffer.add_char b c;
+        incr pos;
+        go ()
+    in
+    go ();
+    Buffer.contents b
+  in
+  let block () =
+    pos := !pos + 2;
+    let depth = ref 1 in
+    while !depth > 0 do
+      if !pos >= n
+      then raise Reject
+      else if at "|#"
+      then (
+        decr depth;
+        pos := !pos + 2)
+      else if at "#|"
+      then (
+        incr depth;
+        pos := !pos + 2)
+      else if s.[!pos] = '"'
+      then ignore (quoted_string ())
+      else incr pos
+    done
+  in
+  let node start f =
+    let r = ref (start, start) in
+    ranges := r :: !ranges;
+    let v = f () in
+    r := start, !pos;
+    v
+  in
+  let rec skip () =
+    match peek 0 with
+    | Some (' ' | '\n' | '\t' | '\012') ->
+      incr pos;
+      skip ()
+    | Some '\r' ->
+      if not (at "\r\n") then raise Reject;
+      pos := !pos + 2;
+      skip ()
+    | Some ';' ->
+      while not (peek 0 = Some '\n' || peek 0 = None) do
+        incr pos
+      done;
+      skip ()
+    | Some '#' when at "#|" ->
+      block ();
+      skip ()
+    | Some '#' when at "#;" ->
+      pos := !pos + 2;
+      let kept = !ranges in
+      skip ();
+      if Option.is_none (value ()) then raise Reject;
+      ranges := kept;
+      skip ()
+    | _ -> ()
+  and value () =
+    match peek 0 with
+    | None | Some ')' -> None
+    | Some '(' ->
+      Some
+        (node !pos (fun () ->
+           incr pos;
+           let rec items acc =
+             skip ();
+             match peek 0 with
+             | Some ')' ->
+               incr pos;
+               Sexp.List (List.rev acc)
+             | _ ->
+               (match value () with
+                | Some v -> items (v :: acc)
+                | None -> raise Reject)
+           in
+           items []))
+    | Some '"' -> Some (node !pos (fun () -> Sexp.Atom (quoted_string ())))
+    | Some _ when at "|#" -> raise Reject
+    | Some _ ->
+      Some
+        (node !pos (fun () ->
+           let start = !pos in
+           while
+             match peek 0 with
+             | None | Some (' ' | '\n' | '\t' | '\012' | '\r' | '"' | '(' | ')' | ';') ->
+               false
+             | Some _ ->
+               if at "#|" || at "|#" then raise Reject;
+               true
+           do
+             incr pos
+           done;
+           Sexp.Atom (String.sub s start (!pos - start))))
+  in
+  let rec top acc =
+    skip ();
+    match peek 0 with
+    | None -> List.rev acc
+    | _ ->
+      (match value () with
+       | Some v -> top (v :: acc)
+       | None -> raise Reject)
+  in
+  match top [] with
+  | vs -> Ok (vs, List.rev_map ( ! ) !ranges)
+  | exception Reject -> Error ()
+;;
+
+(* A fifth of the time, counting on 0 rather than on a biased boolean: some runs draw every
+   boolean false. *)
+let known_shape tc = Zoo.known && draw tc (integers ~min_value:0 ~max_value:4 ()) = 0
+let equal_list = List.equal Sexp.equal
+let show_list l = String.concat " " (List.map Sexp.to_string_mach l)
+
+let with_file contents f =
+  let file = Filename.temp_file "zoo" ".sexp" in
+  Fun.protect
+    ~finally:(fun () -> Sys.remove file)
+    (fun () ->
+       Out_channel.with_open_bin file (fun oc -> output_string oc contents);
+       f file)
+;;
+
+let buffers = integers ~min_value:1 ~max_value:9 ()
+
+let%hegel_test of_string_reads_spellings tc =
+  let v = draw tc values in
+  let s = draw tc (document [ v ]) in
+  match Sexp.of_string s with
+  | got ->
+    if not (Sexp.equal got v)
+    then Printf.ksprintf failwith "reads as %s" (Sexp.to_string_mach got)
+  | exception e -> Printf.ksprintf failwith "raises %s" (Printexc.to_string e)
+;;
+
+let%hegel_test of_string_many_reads_spellings tc =
+  let vs = draw tc documents in
+  let s = draw tc (document vs) in
+  match Sexp.of_string_many s with
+  | got ->
+    if not (equal_list got vs) then Printf.ksprintf failwith "reads as %s" (show_list got)
+  | exception e -> Printf.ksprintf failwith "raises %s" (Printexc.to_string e)
+;;
+
+let bigstring s =
+  Bigarray.Array1.of_array
+    Bigarray.char
+    Bigarray.c_layout
+    (Array.of_seq (String.to_seq s))
+;;
+
+let%hegel_test of_string_needs_exactly_one tc =
+  let vs = draw tc documents in
+  let s = draw tc (edited vs) in
+  let expected =
+    match read_reference s with
+    | Ok ([ v ], _) -> Some v
+    | Ok _ | Error () -> None
+  in
+  List.iter
+    (fun (name, read) ->
+       match read s, expected with
+       | got, Some v ->
+         if not (Sexp.equal got v)
+         then Printf.ksprintf failwith "%s reads %s" name (Sexp.to_string_mach got)
+       | got, None ->
+         Printf.ksprintf failwith "%s accepts it as %s" name (Sexp.to_string_mach got)
+       | exception (Failure _ | Sexp.Parse_error _) when Option.is_none expected -> ()
+       | exception e ->
+         Printf.ksprintf failwith "%s raises %s" name (Printexc.to_string e))
+    [ "of_string", Sexp.of_string
+    ; ( "Annotated.of_string"
+      , fun s -> Sexp.Annotated.get_sexp (Sexp.Annotated.of_string s) )
+    ; ("of_bigstring", fun s -> Sexp.of_bigstring (bigstring s))
+    ; ( "Annotated.of_bigstring"
+      , fun s -> Sexp.Annotated.get_sexp (Sexp.Annotated.of_bigstring (bigstring s)) )
+    ]
+;;
+
+let writers =
+  printed
+    fst
+    (sampled_from
+       [ "to_string", Sexp.to_string
+       ; ("to_string_hum", fun v -> Sexp.to_string_hum v)
+       ; ("to_string_hum ~indent:0", fun v -> Sexp.to_string_hum ~indent:0 v)
+       ; "to_string_mach", Sexp.to_string_mach
+       ])
+;;
+
+let%hegel_test writers_round_trip tc =
+  let v = draw tc values in
+  let _, write = draw tc writers in
+  let s = write v in
+  match Sexp.of_string s with
+  | got ->
+    if not (Sexp.equal got v)
+    then Printf.ksprintf failwith "%S reads as %s" s (Sexp.to_string_mach got)
+  | exception e -> Printf.ksprintf failwith "%S raises %s" s (Printexc.to_string e)
+;;
+
+let%hegel_test save_load_round_trip tc =
+  let vs = draw tc documents in
+  let hum = draw tc (booleans ()) in
+  let buf = Bytes.create (draw tc buffers) in
+  with_file "" (fun file ->
+    if hum then Sexp.save_sexps_hum file vs else Sexp.save_sexps_mach file vs;
+    let got = Sexp.load_sexps ~buf file in
+    if not (equal_list got vs)
+    then Printf.ksprintf failwith "save_sexps reads back %s" (show_list got);
+    match vs with
+    | [ v ] ->
+      if hum then Sexp.save_hum file v else Sexp.save_mach file v;
+      let got = Sexp.load_sexp ~buf file in
+      if not (Sexp.equal got v)
+      then Printf.ksprintf failwith "save reads back %s" (Sexp.to_string_mach got)
+    | _ -> ())
+;;
+
+let%hegel_test load_sexps_reads_spellings tc =
+  let vs = draw tc documents in
+  let s = draw tc (document vs) in
+  let n = draw tc buffers in
+  with_file s (fun file ->
+    List.iter
+      (fun (name, read) ->
+         match read file with
+         | got ->
+           if not (equal_list got vs)
+           then Printf.ksprintf failwith "%s reads %s" name (show_list got)
+         | exception e ->
+           Printf.ksprintf failwith "%s raises %s" name (Printexc.to_string e))
+      [ ("load_sexps", fun file -> Sexp.load_sexps ~buf:(Bytes.create n) file)
+      ; ( "load_rev_sexps"
+        , fun file -> List.rev (Sexp.load_rev_sexps ~buf:(Bytes.create n) file) )
+      ; ( "input_sexps"
+        , fun file ->
+            In_channel.with_open_bin file (Sexp.input_sexps ~buf:(Bytes.create n)) )
+      ; ( "Annotated.input_rev_sexps"
+        , fun file ->
+            In_channel.with_open_bin file (fun ic ->
+              List.rev_map
+                Sexp.Annotated.get_sexp
+                (Sexp.Annotated.input_rev_sexps ~buf:(Bytes.create n) ic)) )
+      ; ( "Annotated.load_sexps"
+        , fun file ->
+            List.map
+              Sexp.Annotated.get_sexp
+              (Sexp.Annotated.load_sexps ~buf:(Bytes.create n) file) )
+      ])
+;;
+
+(* sexplib/1: a sexp comment over an atom ends the file *)
+let endings =
+  printed
+    (Printf.sprintf "%S")
+    (if Zoo.known
+     then sampled_from [ " #;x"; ""; "\n"; ""; "\n" ]
+     else sampled_from [ "\n"; " \n" ])
+;;
+
+let%hegel_test load_sexp_reads_one tc =
+  let v = draw tc values in
+  let s = draw tc (document [ v ]) ^ draw tc endings in
+  let n = draw tc buffers in
+  with_file s (fun file ->
+    List.iter
+      (fun (name, read) ->
+         match read file with
+         | got ->
+           if not (Sexp.equal got v)
+           then Printf.ksprintf failwith "%s reads %s" name (Sexp.to_string_mach got)
+         | exception e ->
+           Printf.ksprintf failwith "%s raises %s" name (Printexc.to_string e))
+      [ ("load_sexp", fun file -> Sexp.load_sexp ~buf:(Bytes.create n) file)
+      ; ( "Annotated.load_sexp"
+        , fun file ->
+            Sexp.Annotated.get_sexp (Sexp.Annotated.load_sexp ~buf:(Bytes.create n) file)
+        )
+      ])
+;;
+
+let bare_atoms =
+  sexp (map (fun s -> Sexp.Atom s) (text ~alphabet:"abc" ~min_size:1 ~max_size:3 ()))
+;;
+
+let lists_ = sexp (map (fun l -> Sexp.List l) (lists (tree 1) ~max_size:3 ()))
+
+(* sexplib/2: an atom ended by the next token's first character *)
+let%hegel_test input_sexp_leaves_the_rest tc =
+  let adjacent = known_shape tc in
+  let v = draw tc (if adjacent then bare_atoms else values) in
+  let w = draw tc (if adjacent then lists_ else values) in
+  let s =
+    draw
+      tc
+      (spelled
+         (composite (fun tc ->
+            if adjacent
+            then
+              render
+                (Bare
+                   (match v with
+                    | Atom a -> a
+                    | List _ -> assert false)
+                 :: spell ~old:false tc w)
+            else (
+              let first = gap ~old:false tc @ spell ~old:false tc v in
+              let sep =
+                match List.rev first with
+                | Bare _ :: _ when not Zoo.known -> [ Space " " ]
+                | _ -> []
+              in
+              render
+                (first
+                 @ sep
+                 @ gap ~old:false tc
+                 @ spell ~old:false tc w
+                 @ gap ~old:false tc)))))
+  in
+  let annotated = draw tc (booleans ()) in
+  with_file s (fun file ->
+    In_channel.with_open_bin file (fun ic ->
+      let read () =
+        if annotated
+        then Sexp.Annotated.get_sexp (Sexp.Annotated.input_sexp ic)
+        else Sexp.input_sexp ic
+      in
+      List.iter
+        (fun expected ->
+           match read () with
+           | got ->
+             if not (Sexp.equal got expected)
+             then
+               Printf.ksprintf
+                 failwith
+                 "reads %s where %s was next"
+                 (Sexp.to_string_mach got)
+                 (Sexp.to_string_mach expected)
+           | exception e ->
+             Printf.ksprintf
+               failwith
+               "raises %s where %s was next"
+               (Printexc.to_string e)
+               (Sexp.to_string_mach expected))
+        [ v; w ]))
+;;
+
+let position_of s offset =
+  let line = ref 1
+  and bol = ref 0 in
+  String.iteri
+    (fun i c ->
+       if i < offset && c = '\n'
+       then (
+         incr line;
+         bol := i + 1))
+    s;
+  { Sexp.Annotated.line = !line; col = offset - !bol; offset }
+;;
+
+let rec preorder (a : Sexp.Annotated.t) =
+  a
+  ::
+  (match a with
+   | Atom _ -> []
+   | List (_, l, _) -> List.concat_map preorder l)
+;;
+
+let show_range (r : Sexp.Annotated.range) =
+  Printf.sprintf
+    "%d:%d@%d-%d:%d@%d"
+    r.start_pos.line
+    r.start_pos.col
+    r.start_pos.offset
+    r.end_pos.line
+    r.end_pos.col
+    r.end_pos.offset
+;;
+
+(* Annotated ranges end at the node's last character. *)
+let check_ranges ?(origin = 1, 0, 0) s annots ranges =
+  let line0, col0, offset0 = origin in
+  let shifted offset =
+    let p = position_of s offset in
+    { Sexp.Annotated.line = p.line + line0 - 1
+    ; col = (if p.line = 1 then p.col + col0 else p.col)
+    ; offset = p.offset + offset0
+    }
+  in
+  let nodes = List.concat_map preorder annots in
+  if List.length nodes <> List.length ranges
+  then
+    Printf.ksprintf
+      failwith
+      "%d nodes, %d expected"
+      (List.length nodes)
+      (List.length ranges);
+  List.iter2
+    (fun a (start, stop) ->
+       let got = Sexp.Annotated.get_range a in
+       let expected =
+         { Sexp.Annotated.start_pos = shifted start; end_pos = shifted (stop - 1) }
+       in
+       if got <> expected
+       then
+         Printf.ksprintf
+           failwith
+           "%s at %s, expected %s"
+           (Sexp.to_string_mach (Sexp.Annotated.get_sexp a))
+           (show_range got)
+           (show_range expected))
+    nodes
+    ranges
+;;
+
+let%hegel_test annotated_ranges_match_reference tc =
+  let vs = draw tc documents in
+  let s = draw tc (document vs) in
+  match read_reference s with
+  | Error () -> failwith "the reference rejects it"
+  | Ok (_, ranges) ->
+    let annots = Sexp.Annotated.of_string_many s in
+    if not (equal_list (List.map Sexp.Annotated.get_sexp annots) vs)
+    then failwith "of_string_many reads other values";
+    check_ranges s annots ranges;
+    List.iter2
+      (fun a v ->
+         List.iter
+           (fun sub ->
+              match Sexp.Annotated.find_sexp a (Sexp.Annotated.get_sexp sub) with
+              | Some found when found == sub -> ()
+              | _ -> failwith "find_sexp does not find a node")
+           (preorder a);
+         if
+           Option.is_some (Sexp.Annotated.find_sexp a (Sexp.of_string (Sexp.to_string v)))
+         then failwith "find_sexp finds a copy")
+      annots
+      vs;
+    let n = draw tc buffers in
+    let loaded = with_file s (Sexp.Annotated.load_sexps ~buf:(Bytes.create n)) in
+    check_ranges s loaded ranges
+;;
+
+let chunks = lists (integers ~min_value:0 ~max_value:4 ()) ~max_size:8 ()
+
+let parse_in_chunks ?(origin = 1, 0, 0) parse s sizes =
+  let text_line, text_char, global_offset = origin in
+  let n = String.length s in
+  let rec feed cont pos sizes acc =
+    let len, sizes =
+      match sizes with
+      | k :: rest -> min k (n - pos), rest
+      | [] -> n - pos, []
+    in
+    match cont ~pos ~len s with
+    | Sexp.Done (v, parse_pos) ->
+      let next = Atomic.get parse_pos.Sexp.Parse_pos.buf_pos in
+      if next < pos || next > pos + len
+      then
+        Printf.ksprintf
+          failwith
+          "Done at buf_pos %d after feeding [%d, %d)"
+          next
+          pos
+          (pos + len);
+      let restart ~pos ~len s =
+        parse ~parse_pos:(Sexp.Parse_pos.with_buf_pos parse_pos pos) ~len s
+      in
+      feed
+        restart
+        next
+        (if next < pos + len then (pos + len - next) :: sizes else sizes)
+        (v :: acc)
+    | Cont (_, cont) ->
+      if pos + len < n || sizes <> []
+      then feed cont (pos + len) sizes acc
+      else (
+        match cont ~pos:0 ~len:1 " " with
+        | Done (v, _) -> List.rev (v :: acc)
+        | Cont (Parsing_toplevel_whitespace, _) -> List.rev acc
+        | Cont (state, _) ->
+          Printf.ksprintf failwith "ends in state %s" (Sexp.Cont_state.to_string state))
+  in
+  feed
+    (fun ~pos ~len s ->
+       parse
+         ~parse_pos:
+           (Sexp.Parse_pos.create ~text_line ~text_char ~global_offset ~buf_pos:pos ())
+         ~len
+         s)
+    0
+    sizes
+    []
+;;
+
+let%hegel_test parse_in_chunks_agrees tc =
+  let vs = draw tc documents in
+  let s = draw tc (document vs) in
+  let sizes = draw tc chunks in
+  let got =
+    parse_in_chunks (fun ~parse_pos ~len s -> Sexp.parse ~parse_pos ~len s) s sizes
+  in
+  if not (equal_list got vs) then Printf.ksprintf failwith "reads %s" (show_list got)
+;;
+
+let%hegel_test annotated_parse_in_chunks_agrees tc =
+  let vs = draw tc documents in
+  let s = draw tc (document vs) in
+  let sizes = draw tc chunks in
+  let origin =
+    draw
+      tc
+      (tuples3
+         (integers ~min_value:1 ~max_value:3 ())
+         (integers ~min_value:0 ~max_value:3 ())
+         (integers ~min_value:0 ~max_value:3 ()))
+  in
+  let got =
+    parse_in_chunks
+      ~origin
+      (fun ~parse_pos ~len s -> Sexp.Annotated.parse ~parse_pos ~len s)
+      s
+      sizes
+  in
+  match read_reference s with
+  | Error () -> failwith "the reference rejects it"
+  | Ok (_, ranges) -> check_ranges ~origin s got ranges
+;;
+
+let bad_atoms =
+  sexp (map (fun s -> Sexp.Atom s) (text ~alphabet:"xy\"( " ~min_size:1 ~max_size:3 ()))
+;;
+
+let int_atoms =
+  sexp
+    (map
+       (fun i -> Sexp.Atom (string_of_int i))
+       (integers ~min_value:(-99) ~max_value:99 ()))
+;;
+
+let%hegel_test conv_error_points_at_culprit tc =
+  let before = draw tc (lists int_atoms ~max_size:3 ()) in
+  let culprit = draw tc (one_of [ bad_atoms; lists_ ]) in
+  let after = draw tc (lists int_atoms ~max_size:3 ()) in
+  let v = Sexp.List (before @ (culprit :: after)) in
+  let s = draw tc (document [ v ]) ^ "\n" in
+  let f = Conv.list_of_sexp Conv.int_of_sexp in
+  let culprit_range =
+    match read_reference s with
+    | Ok (_, _ :: ranges) ->
+      let start, stop = List.nth ranges (List.length before) in
+      { Sexp.Annotated.start_pos = position_of s start
+      ; end_pos = position_of s (stop - 1)
+      }
+    | Ok (_, []) | Error () -> failwith "the reference rejects it"
+  in
+  let check name = function
+    | `Result _ -> Printf.ksprintf failwith "%s converts it" name
+    | `Error (_, annot) ->
+      if not (Sexp.equal (Sexp.Annotated.get_sexp annot) culprit)
+      then
+        Printf.ksprintf
+          failwith
+          "%s blames %s"
+          name
+          (Sexp.to_string_mach (Sexp.Annotated.get_sexp annot));
+      if Sexp.Annotated.get_range annot <> culprit_range
+      then
+        Printf.ksprintf
+          failwith
+          "%s blames %s, expected %s"
+          name
+          (show_range (Sexp.Annotated.get_range annot))
+          (show_range culprit_range)
+  in
+  check "of_string_conv" (Sexp.of_string_conv s f);
+  (match Sexp.of_string_conv_exn s f with
+   | _ -> failwith "of_string_conv_exn converts it"
+   | exception Sexp.Of_string_conv_exn.E { sub_sexp; _ } ->
+     if not (Sexp.equal sub_sexp culprit)
+     then
+       Printf.ksprintf
+         failwith
+         "of_string_conv_exn blames %s"
+         (Sexp.to_string_mach sub_sexp));
+  with_file s (fun file ->
+    check "load_sexp_conv" (Sexp.load_sexp_conv file f);
+    match Sexp.load_sexp_conv_exn file f with
+    | _ -> failwith "load_sexp_conv_exn converts it"
+    | exception Conv.Of_sexp_error (Sexp.Annotated.Conv_exn (loc, _), _) ->
+      let expected =
+        Printf.sprintf
+          "%s:%d:%d"
+          file
+          culprit_range.start_pos.line
+          culprit_range.start_pos.col
+      in
+      if loc <> expected
+      then Printf.ksprintf failwith "load_sexp_conv_exn says %s, expected %s" loc expected)
+;;
+
+let scan s = Sexp.scan_sexps (Lexing.from_string s)
+
+let block_then_quoted tc =
+  let a = draw tc atom_text in
+  [ Sexp.Atom a ], draw tc (spelled (map (fun q -> "#|\"x\"|#" ^ q) (quoted ~old:true a)))
+;;
+
+let%hegel_test scan_reads_spellings tc =
+  let vs, s =
+    if known_shape tc
+    then block_then_quoted tc
+    else (
+      let vs = draw tc documents in
+      vs, draw tc (document ~old:true vs))
+  in
+  List.iter
+    (fun (name, read) ->
+       match read s with
+       | got ->
+         if not (equal_list got vs)
+         then Printf.ksprintf failwith "%s reads %s" name (show_list got)
+       | exception e ->
+         Printf.ksprintf failwith "%s raises %s" name (Printexc.to_string e))
+    [ "scan_sexps", scan
+    ; ("scan_rev_sexps", fun s -> List.rev (Sexp.scan_rev_sexps (Lexing.from_string s)))
+    ; ( "scan_sexp_opt"
+      , fun s ->
+          let lexbuf = Lexing.from_string s in
+          let rec go acc =
+            match Sexp.scan_sexp_opt lexbuf with
+            | Some v -> go (v :: acc)
+            | None -> List.rev acc
+          in
+          go [] )
+    ; ( "scan_fold_sexps"
+      , fun s ->
+          List.rev
+            (Sexp.scan_fold_sexps
+               ~f:(fun acc v -> v :: acc)
+               ~init:[]
+               (Lexing.from_string s)) )
+    ]
+;;
+
+let%hegel_test scan_accepts_exactly_the_grammar tc =
+  let s =
+    if known_shape tc
+    then snd (block_then_quoted tc)
+    else (
+      let vs = draw tc documents in
+      draw tc (edited ~old:true vs))
+  in
+  match scan s, read_reference ~old:true s with
+  | got, Ok (expected, _) ->
+    if not (equal_list got expected)
+    then Printf.ksprintf failwith "reads %s, not %s" (show_list got) (show_list expected)
+  | got, Error () -> Printf.ksprintf failwith "accepts it as %s" (show_list got)
+  | exception e ->
+    (match read_reference ~old:true s with
+     | Ok _ -> Printf.ksprintf failwith "rejects it: %s" (Printexc.to_string e)
+     | Error () -> ())
+;;
+
+module Layout = Sexp.With_layout
+
+let layout s =
+  Layout.Parser.sexps (fun lexbuf -> Layout.Lexer.main lexbuf) (Lexing.from_string s)
+;;
+
+let render_layout tocs =
+  let b = Buffer.create 64 in
+  Layout.Render.run
+    (Buffer.add_char b)
+    (List.fold_left
+       (fun m toc -> Layout.Render.bind m ~f:(fun () -> Layout.Render.sexp toc))
+       (Layout.Render.return ())
+       tocs);
+  Buffer.contents b
+;;
+
+let%hegel_test layout_accepts_exactly_the_grammar tc =
+  let vs = draw tc documents in
+  let s = draw tc (edited ~old:true vs) in
+  match Layout.Forget.t_or_comments (layout s), read_reference ~old:true s with
+  | got, Ok (expected, _) ->
+    if not (equal_list got expected)
+    then Printf.ksprintf failwith "reads %s, not %s" (show_list got) (show_list expected)
+  | got, Error () -> Printf.ksprintf failwith "accepts it as %s" (show_list got)
+  | exception e ->
+    (match read_reference ~old:true s with
+     | Ok _ -> Printf.ksprintf failwith "rejects it: %s" (Printexc.to_string e)
+     | Error () -> ())
+;;
+
+let%hegel_test layout_reads_spellings tc =
+  let vs = draw tc documents in
+  let s = draw tc (document ~old:true vs) in
+  match layout s with
+  | tocs ->
+    let got = Layout.Forget.t_or_comments tocs in
+    if not (equal_list got vs)
+    then Printf.ksprintf failwith "forgets to %s" (show_list got)
+  | exception e -> Printf.ksprintf failwith "raises %s" (Printexc.to_string e)
+;;
+
+let%hegel_test layout_render_round_trip tc =
+  let vs = draw tc documents in
+  let s = draw tc (document ~old:true vs) in
+  let tocs = layout s in
+  let r = render_layout tocs in
+  match layout r with
+  | again ->
+    let show l = show_list (List.map Layout.sexp_of_t_or_comment l) in
+    if
+      not
+        (equal_list
+           (List.map Layout.sexp_of_t_or_comment again)
+           (List.map Layout.sexp_of_t_or_comment tocs))
+    then
+      Printf.ksprintf
+        failwith
+        "renders as %S, which reads as %s, not %s"
+        r
+        (show again)
+        (show tocs)
+  | exception e ->
+    Printf.ksprintf failwith "renders as %S, which raises %s" r (Printexc.to_string e)
+;;
+
+(* sexplib/6: an atom that grows runs into a #; or #| right after it *)
+let rec relabel tc (t : Layout.t) : Layout.t =
+  match t with
+  | Atom (pos, text, fmt) ->
+    let fits a =
+      Zoo.known
+      || String.length (Sexp.to_string_mach (Atom a))
+         < String.length (Option.value fmt ~default:text)
+    in
+    if draw_silent tc (booleans ~p:0.3 ())
+    then (
+      let a = draw_silent tc atom_text in
+      if fits a then Atom (pos, a, None) else Atom (pos, text, fmt))
+    else Atom (pos, text, fmt)
+  | List (start, tocs, stop) ->
+    List
+      ( start
+      , List.map
+          (function
+            | Layout.Sexp t -> Layout.Sexp (relabel tc t)
+            | Comment c -> Comment c)
+          tocs
+      , stop )
+;;
+
+let%hegel_test layout_render_after_edits tc =
+  let edited =
+    if known_shape tc
+    then (
+      let a = draw tc (text ~alphabet:"abc" ~min_size:1 ~max_size:3 ()) in
+      let c = draw tc (printed Fun.id (sampled_from [ "#;x"; "#|x|#" ])) in
+      match layout ("(" ^ a ^ " " ^ c ^ ")") with
+      | [ Sexp (List (p, Sexp (Atom (ap, a, _)) :: rest, q)) ] ->
+        [ Layout.Sexp (List (p, Sexp (Atom (ap, a ^ "c", None)) :: rest, q)) ]
+      | _ -> assert false)
+    else (
+      let vs = draw tc documents in
+      let s = draw tc (document ~old:true vs) in
+      List.map
+        (function
+          | Layout.Sexp t -> Layout.Sexp (relabel tc t)
+          | Comment c -> Layout.Comment c)
+        (layout s))
+  in
+  let expected = Layout.Forget.t_or_comments edited in
+  let r = render_layout edited in
+  match Layout.Forget.t_or_comments (layout r) with
+  | got ->
+    if not (equal_list got expected)
+    then
+      Printf.ksprintf
+        failwith
+        "renders %s as %S, which reads as %s"
+        (show_list expected)
+        r
+        (show_list got)
+  | exception e ->
+    Printf.ksprintf
+      failwith
+      "renders %s as %S, which raises %s"
+      (show_list expected)
+      r
+      (Printexc.to_string e)
+;;
+
+type step =
+  | Index of string
+  | Tag of string * string
+  | Field of string
+
+let escape name =
+  String.concat
+    ""
+    (List.map
+       (fun c ->
+          if String.contains ".[]\\" c then "\\" ^ String.make 1 c else String.make 1 c)
+       (List.of_seq (String.to_seq name)))
+;;
+
+let path_string steps =
+  String.concat
+    ""
+    (List.map
+       (function
+         | Index d -> ".[" ^ d ^ "]"
+         | Tag (t, d) -> "." ^ escape t ^ "[" ^ d ^ "]"
+         | Field f -> "." ^ escape f)
+       steps)
+;;
+
+let path_names = text ~alphabet:"a.[]\\" ~min_size:1 ~max_size:2 ()
+let path_atoms = sexp (map (fun s -> Sexp.Atom s) path_names)
+
+let rec path_tree depth =
+  if depth = 0
+  then path_atoms
+  else
+    one_of
+      [ path_atoms
+      ; sexp (map (fun l -> Sexp.List l) (lists (path_tree (depth - 1)) ~max_size:3 ()))
+      ; sexp
+          (map
+             (fun (k, v) -> Sexp.List [ Sexp.Atom k; v ])
+             (tuples2 path_names (path_tree (depth - 1))))
+      ]
+;;
+
+let digits = printed Fun.id (map string_of_int (integers ~min_value:0 ~max_value:3 ()))
+
+(* sexplib/3: 2^63, 2^64 and 3 * 2^63 all wrap to index 0 *)
+let wrapping =
+  printed
+    Fun.id
+    (sampled_from
+       [ "9223372036854775808"; "18446744073709551616"; "27670116110564327424" ])
+;;
+
+let steps =
+  printed
+    path_string
+    (lists
+       (one_of
+          [ printed (fun s -> path_string [ s ]) (map (fun d -> Index d) digits)
+          ; printed
+              (fun s -> path_string [ s ])
+              (map (fun (t, d) -> Tag (t, d)) (tuples2 path_names digits))
+          ; printed (fun s -> path_string [ s ]) (map (fun f -> Field f) path_names)
+          ])
+       ~min_size:1
+       ~max_size:3
+       ())
+;;
+
+let rec walk (v : Sexp.t) steps =
+  let nth l d = Option.bind (int_of_string_opt d) (fun i -> List.nth_opt l i) in
+  match steps, v with
+  | [], _ -> Some v
+  | Index d :: rest, List l -> Option.bind (nth l d) (fun x -> walk x rest)
+  | Tag (t, d) :: rest, List (Atom a :: args) when a = t ->
+    Option.bind (nth args d) (fun x -> walk x rest)
+  | Field f :: rest, List l ->
+    Option.bind
+      (List.find_map
+         (function
+           | Sexp.List [ Atom k; x ] when k = f -> Some x
+           | _ -> None)
+         l)
+      (fun x -> walk x rest)
+  | _ -> None
+;;
+
+let%hegel_test path_get_matches_model tc =
+  let wraps = known_shape tc in
+  let v, steps =
+    if wraps
+    then (
+      let x = draw tc (path_tree 1) in
+      Sexp.List [ x ], [ Index (draw tc wrapping) ])
+    else draw tc (path_tree 3), draw tc steps
+  in
+  let str = path_string steps in
+  let expected_path =
+    List.map
+      (function
+        | Index d -> Option.map (fun i -> Path.Pos i) (int_of_string_opt d)
+        | Tag (t, d) -> Option.map (fun i -> Path.Match (t, i)) (int_of_string_opt d)
+        | Field f -> Some (Path.Rec f))
+      steps
+  in
+  if
+    List.for_all Option.is_some expected_path
+    && Path.parse str <> List.map Option.get expected_path
+  then Printf.ksprintf failwith "Path.parse %S disagrees" str;
+  match walk v steps, Path.get ~str v with
+  | Some x, got ->
+    if not (Sexp.equal got x)
+    then
+      Printf.ksprintf
+        failwith
+        "%s gives %s, expected %s"
+        str
+        (Sexp.to_string_mach got)
+        (Sexp.to_string_mach x)
+  | None, got ->
+    Printf.ksprintf
+      failwith
+      "%s gives %s, which is not there"
+      str
+      (Sexp.to_string_mach got)
+  | exception Failure _ when Option.is_none (walk v steps) -> ()
+  | exception e -> Printf.ksprintf failwith "%s raises %s" str (Printexc.to_string e)
+;;
+
+let%hegel_test path_replace_laws tc =
+  let v = draw tc (path_tree 3) in
+  let steps = draw tc steps in
+  let str = path_string steps in
+  match walk v steps with
+  | None -> ()
+  | Some sub ->
+    let path = Path.parse str in
+    let subst, got = Path.subst_path v path in
+    if not (Sexp.equal got sub)
+    then Printf.ksprintf failwith "subst_path finds %s" (Sexp.to_string_mach got);
+    if not (Sexp.equal (subst sub) v) then failwith "subst sub is not the original";
+    let marker = Sexp.Atom "MARK" in
+    let replaced = Path.replace ~str v ~subst:marker in
+    if not (Sexp.equal (Path.get ~str replaced) marker)
+    then Printf.ksprintf failwith "replace leaves %s" (Sexp.to_string_mach replaced);
+    if not (Sexp.equal (Path.replace ~path replaced ~subst:sub) v)
+    then failwith "replacing back does not restore the original"
+;;
+
+let rec at (v : Sexp.t) = function
+  | [] -> v
+  | i :: rest ->
+    (match v with
+     | List l -> at (List.nth l i) rest
+     | Atom _ -> assert false)
+;;
+
+let rec replace_at (v : Sexp.t) x = function
+  | [] -> x
+  | i :: rest ->
+    (match v with
+     | List l ->
+       Sexp.List (List.mapi (fun j y -> if j = i then replace_at y x rest else y) l)
+     | Atom _ -> assert false)
+;;
+
+let rec found_of = function
+  | [] -> `Found
+  | i :: rest -> `Pos (i, found_of rest)
+;;
+
+let%hegel_test search_physical_finds_subterm tc =
+  let v = draw tc values in
+  let rec choose (v : Sexp.t) =
+    match v with
+    | List (_ :: _ as l) when draw tc (booleans ()) ->
+      let i = draw tc (integers ~min_value:0 ~max_value:(List.length l - 1) ()) in
+      i :: choose (List.nth l i)
+    | _ -> []
+  in
+  let idx = choose v in
+  let contained = at v idx in
+  (match Sexp.search_physical v ~contained with
+   | #Sexp.found as found ->
+     if found <> found_of idx then failwith "search_physical finds it elsewhere";
+     let marker = Sexp.Atom "MARK" in
+     if
+       not (Sexp.equal (Sexp.subst_found v ~subst:marker found) (replace_at v marker idx))
+     then failwith "subst_found replaces something else"
+   | `Not_found -> failwith "search_physical misses it");
+  let copy = Sexp.of_string (Sexp.to_string contained) in
+  match Sexp.search_physical v ~contained:copy with
+  | `Not_found -> ()
+  | #Sexp.found -> failwith "search_physical finds a copy"
+;;
+
+let bits n = binary ~min_size:n ~max_size:n ()
+
+let floats_ =
+  one_of
+    [ floats ()
+    ; printed
+        Float.to_string
+        (map (fun b -> String.get_int64_le b 0 |> Int64.float_of_bits) (bits 8))
+    ]
+;;
+
+let round_trip name sexp_of of_sexp equal x =
+  let s = Conv.string_of__of__sexp_of sexp_of x in
+  match Conv.of_string__of__of_sexp of_sexp s with
+  | y ->
+    if not (equal x y)
+    then Printf.ksprintf failwith "%s: %S reads back as another value" name s
+  | exception e ->
+    Printf.ksprintf failwith "%s: %S raises %s" name s (Printexc.to_string e)
+;;
+
+let%hegel_test conv_round_trips tc =
+  round_trip "float" Conv.sexp_of_float Conv.float_of_sexp Float.equal (draw tc floats_);
+  let b8 = draw tc (bits 8) in
+  round_trip
+    "int64"
+    Conv.sexp_of_int64
+    Conv.int64_of_sexp
+    Int64.equal
+    (String.get_int64_le b8 0);
+  round_trip
+    "int32"
+    Conv.sexp_of_int32
+    Conv.int32_of_sexp
+    Int32.equal
+    (String.get_int32_le b8 0);
+  round_trip
+    "nativeint"
+    Conv.sexp_of_nativeint
+    Conv.nativeint_of_sexp
+    Nativeint.equal
+    (Int64.to_nativeint (String.get_int64_le b8 0));
+  round_trip "char" Conv.sexp_of_char Conv.char_of_sexp Char.equal (draw tc (chars ()));
+  let s = draw tc (binary ~max_size:6 ()) in
+  round_trip "string" Conv.sexp_of_string Conv.string_of_sexp String.equal s;
+  let ints = draw tc (lists (integers ()) ~max_size:4 ()) in
+  round_trip
+    "int option"
+    (Conv.sexp_of_option Conv.sexp_of_int)
+    (Conv.option_of_sexp Conv.int_of_sexp)
+    (Option.equal Int.equal)
+    (List.nth_opt ints 0);
+  round_trip
+    "string list"
+    (Conv.sexp_of_list Conv.sexp_of_string)
+    (Conv.list_of_sexp Conv.string_of_sexp)
+    (List.equal String.equal)
+    [ s; "" ];
+  round_trip
+    "int array"
+    (Conv.sexp_of_array Conv.sexp_of_int)
+    (Conv.array_of_sexp Conv.int_of_sexp)
+    (Array.for_all2 Int.equal)
+    (Array.of_list ints);
+  let table = Hashtbl.create 4 in
+  List.iteri (fun i k -> Hashtbl.replace table k (string_of_int i)) ints;
+  round_trip
+    "hashtbl"
+    (Conv.sexp_of_hashtbl Conv.sexp_of_int Conv.sexp_of_string)
+    (Conv.hashtbl_of_sexp Conv.int_of_sexp Conv.string_of_sexp)
+    (fun a b ->
+       Hashtbl.length a = Hashtbl.length b
+       && Hashtbl.fold (fun k v ok -> ok && Hashtbl.find_opt b k = Some v) a true)
+    table;
+  round_trip "bigstring" Conv.sexp_of_bigstring Conv.bigstring_of_sexp ( = ) (bigstring s);
+  let fs = draw tc (lists floats_ ~max_size:6 ()) in
+  let vec =
+    Bigarray.Array1.of_array Bigarray.float64 Bigarray.fortran_layout (Array.of_list fs)
+  in
+  let float_arrays_equal a b =
+    Bigarray.Array1.dim a = Bigarray.Array1.dim b
+    && List.for_all
+         (fun i -> Float.equal (Bigarray.Array1.get a i) (Bigarray.Array1.get b i))
+         (List.init (Bigarray.Array1.dim a) succ)
+  in
+  round_trip "vec" Conv.sexp_of_vec Conv.vec_of_sexp float_arrays_equal vec;
+  let vec32 =
+    Bigarray.Array1.of_array Bigarray.float32 Bigarray.fortran_layout (Array.of_list fs)
+  in
+  round_trip
+    "float32_vec"
+    Conv.sexp_of_float32_vec
+    Conv.float32_vec_of_sexp
+    float_arrays_equal
+    vec32;
+  let rows = draw tc (integers ~min_value:0 ~max_value:3 ()) in
+  let cols = draw tc (integers ~min_value:0 ~max_value:3 ()) in
+  let mat = Bigarray.Array2.create Bigarray.float64 Bigarray.fortran_layout rows cols in
+  List.iteri
+    (fun k f ->
+       if k < rows * cols
+       then Bigarray.Array2.set mat ((k mod rows) + 1) ((k / rows) + 1) f)
+    (fs @ List.init (rows * cols) float_of_int);
+  round_trip
+    "mat"
+    Conv.sexp_of_mat
+    Conv.mat_of_sexp
+    (fun a b ->
+       Bigarray.Array2.dim1 a = Bigarray.Array2.dim1 b
+       && Bigarray.Array2.dim2 a = Bigarray.Array2.dim2 b
+       && List.for_all
+            (fun k ->
+               Float.equal
+                 (Bigarray.Array2.get a ((k mod rows) + 1) ((k / rows) + 1))
+                 (Bigarray.Array2.get b ((k mod rows) + 1) ((k / rows) + 1)))
+            (List.init (rows * cols) Fun.id))
+    mat
+;;
