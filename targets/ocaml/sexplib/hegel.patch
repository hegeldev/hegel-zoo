+let pin_input_sexp_eats_paren () =
+  with_file "a(b)" (fun file ->
+    In_channel.with_open_bin file (fun ic ->
+      let a = Sexp.input_sexp ic in
+      let b = Sexp.input_sexp ic in
+      if not (equal_list [ a; b ] [ Atom "a"; List [ Atom "b" ] ])
+      then Printf.ksprintf failwith "reads %s" (show_list [ a; b ])))
+;;
