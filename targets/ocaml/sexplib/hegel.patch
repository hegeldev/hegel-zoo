+    match Sexp.load_sexp file with
+    | v ->
+      if not (Sexp.equal v (Atom "a"))
+      then Printf.ksprintf failwith "reads %s" (Sexp.to_string_mach v)
+    | exception e -> Printf.ksprintf failwith "raises %s" (Printexc.to_string e))
+;;
