+let%hegel_test mat_of_sexp_checks_dimensions tc =
+  let wraps = known_shape tc in
+  let m, n =
+    if wraps
+    then (
+      let m, n = draw tc wrapping_dims in
+      string_of_int m, string_of_int n)
+    else draw tc dimension_atoms, draw tc dimension_atoms
+  in
+  let data =
+    if wraps
+    then []
+    else
+      draw
+        tc
+        (lists
+           (one_of [ floats_; floats_; printed Float.to_string (just Float.nan) ])
+           ~max_size:7
+           ())
+  in
+  let bad_float = (not wraps) && draw tc (booleans ~p:0.1 ()) in
+  let atoms =
+    List.map (fun f -> Sexp.Atom (Printf.sprintf "%.17g" f)) data
+    @ if bad_float then [ Sexp.Atom "x" ] else []
+  in
+  let input = Sexp.List (Atom m :: Atom n :: atoms) in
+  let expected =
+    match int_of_string_opt m, int_of_string_opt n with
+    | Some m, Some n
+      when (not bad_float)
+           && m >= 0
+           && n >= 0
+           &&
+           if m = 0 || n = 0
+           then data = []
+           else m <= max_int / n && m * n = List.length data ->
+      Some
+        (Sexp.List
+           (Conv.sexp_of_int m :: Conv.sexp_of_int n :: List.map Conv.sexp_of_float data))
+    | _ -> None
+  in
+  match Conv.mat_of_sexp input, expected with
+  | got, Some e ->
+    if not (Sexp.equal (Conv.sexp_of_mat got) e)
+    then Printf.ksprintf failwith "gives %s" (Sexp.to_string_mach (Conv.sexp_of_mat got))
+  | got, None ->
+    Printf.ksprintf
+      failwith
+      "accepts %s as %s"
+      (Sexp.to_string_mach input)
+      (Sexp.to_string_mach (Conv.sexp_of_mat got))
+  | exception Conv.Of_sexp_error _ when Option.is_none expected -> ()
+  | exception e ->
+    Printf.ksprintf
+      failwith
+      "%s raises %s"
+      (Sexp.to_string_mach input)
+      (Printexc.to_string e)
+;;
