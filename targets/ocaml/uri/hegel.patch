new file mode 100644
index 0000000..ce31977
--- /dev/null
+++ b/hegel/zoo.ml
@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
diff --git a/hegel/zoo_tests.ml b/hegel/zoo_tests.ml
new file mode 100644
index 0000000..f815f0e
--- /dev/null
+++ b/hegel/zoo_tests.ml
@@ -0,0 +1,569 @@
+open Hegel
+
+let str g = with_printer (fun s -> Sexplib0.Sexp.Atom s) g
+let uri g = with_printer (fun u -> Sexplib0.Sexp.Atom (Uri.to_string u)) g
+let cat gs = str (composite (fun tc -> String.concat "" (List.map (draw_silent tc) gs)))
+let lit s = str (just s)
+let char_in set = text ~alphabet:set ~min_size:1 ~max_size:1 ()
+
+let many ?(min_size = 0) ?(max_size = 4) g =
+  str (map (String.concat "") (lists g ~min_size ~max_size ()))
+;;
+
+let known_first known gs = one_of ((if Zoo.known then known else []) @ gs)
+
+let alnum = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+let unreserved_chars = alnum ^ "-._~"
+let sub_delim_chars = "!$&'()*+,;="
+let hex = "0123456789ABCDEFabcdef"
+let unreserved = char_in unreserved_chars
+let sub_delims = char_in sub_delim_chars
+
+(* encoded unreserved characters are equivalent to the characters themselves (6.2.2.2), and
+   the resolution algorithm is defined on the encoded string; an encoded slash is uri/5's shape *)
+let unencoded = if Zoo.known then unreserved_chars else unreserved_chars ^ "/"
+
+let pct_encoded =
+  str
+    (map
+       (fun (c, lower) ->
+          let s = Printf.sprintf "%%%02X" (Char.code c) in
+          if lower then String.lowercase_ascii s else s)
+       (tuples2
+          (filter (fun c -> not (String.contains unencoded c)) (chars ()))
+          (booleans ())))
+;;
+
+let pchar = one_of [ unreserved; sub_delims; char_in ":@"; pct_encoded ]
+let pchar_nc = one_of [ unreserved; sub_delims; char_in "@"; pct_encoded ]
+let dots = one_of [ lit "."; lit ".." ]
+let segment = one_of [ many pchar; dots ]
+let path_abempty = many (cat [ lit "/"; segment ])
+let first_segment pchar = one_of [ many ~min_size:1 pchar; dots ]
+let path_absolute = one_of [ lit "/"; cat [ lit "/"; first_segment pchar; path_abempty ] ]
+let path_rootless = cat [ first_segment pchar; path_abempty ]
+let path_noscheme = cat [ first_segment pchar_nc; path_abempty ]
+let query_chars = many (one_of [ pchar; char_in "/?" ])
+
+let generic_scheme = from_regex "[a-z][a-z0-9+.-]{0,5}" ~fullmatch:true ()
+let scheme = one_of [ generic_scheme; from_regex "(?i)(https?|file|urn)" ~fullmatch:true () ]
+
+let ipv4 =
+  str
+    (map
+       (fun os -> String.concat "." (List.map string_of_int os))
+       (lists (integers ~min_value:0 ~max_value:255 ()) ~min_size:4 ~max_size:4 ()))
+;;
+
+let h16 = text ~alphabet:hex ~min_size:1 ~max_size:4 ()
+let h16s n m = lists h16 ~min_size:n ~max_size:m ()
+
+let ipv6 =
+  one_of
+    [ str (map (String.concat ":") (h16s 8 8))
+    ; str
+        (map
+           (fun (l, r) -> String.concat ":" l ^ "::" ^ String.concat ":" r)
+           (tuples2 (h16s 0 3) (h16s 0 3)))
+    ; str (map (fun (l, v4) -> String.concat ":" l ^ ":" ^ v4) (tuples2 (h16s 6 6) ipv4))
+    ]
+;;
+
+let reg_name = many (one_of [ unreserved; sub_delims; pct_encoded ])
+let plain_hosts = [ reg_name; ipv4; cat [ lit "["; ipv6; lit "]" ] ]
+let label = many ~min_size:1 (char_in alnum)
+let dotted_quad_prefixed = cat [ ipv4; one_of [ label; cat [ lit "."; label ] ] ]
+
+let ip_future =
+  cat
+    [ lit "[v"
+    ; text ~alphabet:hex ~min_size:1 ~max_size:2 ()
+    ; lit "."
+    ; many ~min_size:1 (one_of [ unreserved; sub_delims; char_in ":" ])
+    ; lit "]"
+    ]
+;;
+
+let userinfo = many (one_of [ unreserved; sub_delims; char_in ":"; pct_encoded ])
+let port = text ~alphabet:"0123456789" ~max_size:5 ()
+
+let authority host =
+  str
+    (map
+       (fun (u, (h, p)) ->
+          Option.fold ~none:"" ~some:(fun u -> u ^ "@") u
+          ^ h
+          ^ Option.fold ~none:"" ~some:(fun p -> ":" ^ p) p)
+       (tuples2 (optional userinfo) (tuples2 host (optional port))))
+;;
+
+type parts =
+  { scheme : string option
+  ; authority : string option
+  ; path : string
+  ; query : string option
+  ; fragment : string option
+  }
+
+(* 5.3 *)
+let recompose p =
+  let b = Buffer.create 32 in
+  Option.iter (fun s -> Buffer.add_string b (s ^ ":")) p.scheme;
+  Option.iter (fun a -> Buffer.add_string b ("//" ^ a)) p.authority;
+  Buffer.add_string b p.path;
+  Option.iter (fun q -> Buffer.add_string b ("?" ^ q)) p.query;
+  Option.iter (fun f -> Buffer.add_string b ("#" ^ f)) p.fragment;
+  Buffer.contents b
+;;
+
+let reference_with ?(rooted = false) scheme =
+  str
+    (map
+       recompose
+       (flat_map
+          (fun (scheme, authority) ->
+             let path =
+               match authority, scheme with
+               | Some _, _ -> path_abempty
+               | None, Some _ when rooted -> path_absolute
+               | None, Some _ -> one_of [ lit ""; path_absolute; path_rootless ]
+               | None, None -> one_of [ lit ""; path_absolute; path_noscheme ]
+             in
+             map
+               (fun (path, (query, fragment)) -> { scheme; authority; path; query; fragment })
+               (tuples2 path (tuples2 (optional query_chars) (optional query_chars))))
+          (tuples2 scheme (optional (authority (one_of plain_hosts))))))
+;;
+
+let references = reference_with (optional scheme)
+let with_host host = cat [ lit "//"; authority host; path_abempty ]
+
+(* uri/1's shape *)
+let references_known = known_first [ with_host dotted_quad_prefixed ] [ references ]
+
+(* a base whose scheme normalises hosts is uri/4's shape; a path with a scheme that is not
+   rooted is uri/3's *)
+let base_scheme = if Zoo.known then scheme else generic_scheme
+let resolvable = reference_with ~rooted:(not Zoo.known) (optional scheme)
+
+let absolute =
+  reference_with
+    ~rooted:(not Zoo.known)
+    (with_printer (fun s -> Sexplib0.Sexp.Atom (Option.get s)) (map Option.some base_scheme))
+
+(* Appendix B *)
+let split s =
+  let n = String.length s in
+  let upto i stops =
+    let rec go j = if j < n && not (String.contains stops s.[j]) then go (j + 1) else j in
+    go i
+  in
+  let j = upto 0 ":/?#" in
+  let scheme, i =
+    if j > 0 && j < n && s.[j] = ':' then Some (String.sub s 0 j), j + 1 else None, 0
+  in
+  let authority, i =
+    if i + 1 < n && s.[i] = '/' && s.[i + 1] = '/'
+    then (
+      let j = upto (i + 2) "/?#" in
+      Some (String.sub s (i + 2) (j - i - 2)), j)
+    else None, i
+  in
+  let j = upto i "?#" in
+  let path = String.sub s i (j - i) in
+  let query, i =
+    if j < n && s.[j] = '?'
+    then (
+      let k = upto (j + 1) "#" in
+      Some (String.sub s (j + 1) (k - j - 1)), k)
+    else None, j
+  in
+  let fragment = if i < n then Some (String.sub s (i + 1) (n - i - 1)) else None in
+  { scheme; authority; path; query; fragment }
+;;
+
+let split_authority a =
+  let userinfo, rest =
+    match String.index_opt a '@' with
+    | Some i -> Some (String.sub a 0 i), String.sub a (i + 1) (String.length a - i - 1)
+    | None -> None, a
+  in
+  let host_end =
+    if String.length rest > 0 && rest.[0] = '['
+    then String.index rest ']' + 1
+    else Option.value (String.index_opt rest ':') ~default:(String.length rest)
+  in
+  let host = String.sub rest 0 host_end in
+  let port =
+    if host_end < String.length rest
+    then Some (String.sub rest (host_end + 1) (String.length rest - host_end - 1))
+    else None
+  in
+  userinfo, host, port
+;;
+
+let drop k s = String.sub s k (String.length s - k)
+
+(* 5.2.4 *)
+let remove_dot_segments path =
+  let rec go input out =
+    if input = ""
+    then String.concat "" (List.rev out)
+    else if String.starts_with ~prefix:"../" input
+    then go (drop 3 input) out
+    else if String.starts_with ~prefix:"./" input
+    then go (drop 2 input) out
+    else if String.starts_with ~prefix:"/./" input
+    then go ("/" ^ drop 3 input) out
+    else if input = "/."
+    then go "/" out
+    else if String.starts_with ~prefix:"/../" input
+    then go ("/" ^ drop 4 input) (match out with [] -> [] | _ :: t -> t)
+    else if input = "/.."
+    then go "/" (match out with [] -> [] | _ :: t -> t)
+    else if input = "." || input = ".."
+    then go "" out
+    else (
+      let from = if input.[0] = '/' then 1 else 0 in
+      let j =
+        Option.value (String.index_from_opt input from '/') ~default:(String.length input)
+      in
+      go (drop j input) (String.sub input 0 j :: out))
+  in
+  go path []
+;;
+
+(* 5.2.3 *)
+let merge base path =
+  if Option.is_some base.authority && base.path = ""
+  then "/" ^ path
+  else (
+    match String.rindex_opt base.path '/' with
+    | Some i -> String.sub base.path 0 (i + 1) ^ path
+    | None -> path)
+;;
+
+(* 5.2.2, strict *)
+let resolve base r =
+  let t =
+    if Option.is_some r.scheme
+    then { r with path = remove_dot_segments r.path }
+    else if Option.is_some r.authority
+    then { r with scheme = base.scheme; path = remove_dot_segments r.path }
+    else if r.path = ""
+    then
+      { r with
+        scheme = base.scheme
+      ; authority = base.authority
+      ; path = base.path
+      ; query = (if Option.is_some r.query then r.query else base.query)
+      }
+    else (
+      let path =
+        if String.starts_with ~prefix:"/" r.path then r.path else merge base r.path
+      in
+      { r with
+        scheme = base.scheme
+      ; authority = base.authority
+      ; path = remove_dot_segments path
+      })
+  in
+  t
+;;
+
+let normalised u = Uri.with_query u (Uri.query u)
+
+(* 4.2: a first segment with a colon is printed after "./" *)
+let printed_path u =
+  let path = Uri.path u in
+  let first = List.hd (String.split_on_char '/' path) in
+  if Option.is_none (Uri.scheme u) && Option.is_none (Uri.host u) && String.contains first ':'
+  then Uri.with_path u ("./" ^ path)
+  else u
+;;
+
+let%hegel_test string_roundtrip tc =
+  let s = draw tc references_known in
+  let u = Uri.of_string s in
+  let printed = Uri.to_string u in
+  let back = Uri.of_string printed in
+  if not (Uri.equal (normalised back) (normalised (printed_path u)))
+  then
+    Printf.ksprintf failwith "%s reads back with path %S, was %S" printed (Uri.path back)
+      (Uri.path u);
+  if not (String.equal (Uri.to_string back) printed)
+  then Printf.ksprintf failwith "%s prints as %s" printed (Uri.to_string back)
+;;
+
+let lowered_host scheme h =
+  match Option.map String.lowercase_ascii scheme with
+  | Some ("http" | "https") -> String.lowercase_ascii h
+  | Some "file" ->
+    let h = String.lowercase_ascii h in
+    if h = "localhost" then "" else h
+  | _ -> h
+;;
+
+let check_parts u p =
+  let mismatch what got want =
+    if got <> want
+    then
+      Printf.ksprintf failwith "%s: %s, want %s" what
+        (Option.value got ~default:"-") (Option.value want ~default:"-")
+  in
+  mismatch "scheme" (Uri.scheme u) (Option.map String.lowercase_ascii p.scheme);
+  let userinfo, host, port =
+    match p.authority with
+    | None -> None, None, None
+    | Some a ->
+      let userinfo, host, port = split_authority a in
+      let host =
+        if String.starts_with ~prefix:"[" host
+        then String.sub host 1 (String.length host - 2)
+        else Uri.pct_decode host
+      in
+      userinfo, Some (lowered_host p.scheme host), port
+  in
+  mismatch "host" (Uri.host u) host;
+  mismatch
+    "port"
+    (Option.map string_of_int (Uri.port u))
+    (Option.map string_of_int (Option.bind port int_of_string_opt));
+  let user, password =
+    match userinfo with
+    | None -> None, None
+    | Some ui ->
+      (match String.index_opt ui ':' with
+       | None -> Some (Uri.pct_decode ui), None
+       | Some i ->
+         ( Some (Uri.pct_decode (String.sub ui 0 i))
+         , Some (Uri.pct_decode (drop (i + 1) ui)) ))
+  in
+  mismatch "user" (Uri.user u) user;
+  mismatch "password" (Uri.password u) password;
+  mismatch "path" (Some (Uri.path_unencoded u)) (Some (Uri.pct_decode p.path));
+  mismatch "query" (Uri.verbatim_query u) p.query;
+  mismatch "fragment" (Uri.fragment u) (Option.map Uri.pct_decode p.fragment)
+;;
+
+let check_components s = check_parts (Uri.of_string s) (split s)
+
+let%hegel_test components_match_appendix_b tc =
+  check_components (draw tc references_known)
+;;
+
+let%hegel_test ip_future_host_matches_appendix_b tc =
+  check_components (draw tc (with_host ip_future))
+;;
+
+(* uri/5's shape *)
+let encoded_slash_segment =
+  cat [ lit "/"; one_of [ lit "%2F"; lit "%2f" ]; path_abempty ]
+;;
+
+let%hegel_test path_keeps_its_segments tc =
+  let s = draw tc (known_first [ encoded_slash_segment ] [ references ]) in
+  let path = (split s).path in
+  let want =
+    String.concat "/"
+      (List.map
+         (fun seg -> Uri.pct_encode ~component:`Path (Uri.pct_decode seg))
+         (String.split_on_char '/' path))
+  in
+  let got = Uri.path (Uri.of_string s) in
+  if not (String.equal got want) then Printf.ksprintf failwith "path %s, want %s" got want
+;;
+
+(* uri/3's shape: a reference climbing out of a base path that is not rooted *)
+let rootless_base = cat [ generic_scheme; lit ":"; one_of [ lit ""; path_rootless ] ]
+let climbing = cat [ lit ".."; path_abempty ]
+
+let%hegel_test resolve_matches_rfc3986 tc =
+  let base, r =
+    draw tc (known_first [ tuples2 rootless_base climbing ] [ tuples2 absolute resolvable ])
+  in
+  let got = Uri.resolve "" (Uri.of_string base) (Uri.of_string r) in
+  let t = resolve (split base) (split r) in
+  try check_parts got t with
+  | Failure m ->
+    Printf.ksprintf failwith "resolves to %s, RFC 3986 gives %s (%s)" (Uri.to_string got)
+      (recompose t) m
+;;
+
+(* uri/4's shape: a file base erases localhost *)
+let file_base_localhost =
+  tuples2
+    (cat [ lit "file:"; path_abempty ])
+    (cat [ generic_scheme; lit "://localhost"; path_abempty ])
+;;
+
+let%hegel_test resolve_keeps_reference_host tc =
+  let base, r =
+    draw
+      tc
+      (known_first
+         [ file_base_localhost ]
+         [ tuples2 absolute (cat [ scheme; lit "://"; authority (one_of plain_hosts); path_abempty ]) ])
+  in
+  let got = Uri.resolve "" (Uri.of_string base) (Uri.of_string r) in
+  let want = Uri.host (Uri.of_string r) in
+  if Uri.host got <> want
+  then
+    Printf.ksprintf failwith "host %s, want %s"
+      (Option.value (Uri.host got) ~default:"-") (Option.value want ~default:"-")
+;;
+
+let components : (string * Uri.component, printable) generator =
+  with_printer
+    (fun (name, _) -> Sexplib0.Sexp.Atom name)
+    (sampled_from
+       [ "path", `Path
+       ; "userinfo", `Userinfo
+       ; "query", `Query
+       ; "query_key", `Query_key
+       ; "query_value", `Query_value
+       ; "fragment", `Fragment
+       ; "host", `Host
+       ; "generic", `Generic
+       ])
+;;
+
+let allowed : Uri.component -> string = function
+  | `Path -> unreserved_chars ^ sub_delim_chars ^ ":@"
+  | `Userinfo -> unreserved_chars ^ sub_delim_chars ^ ":"
+  | `Query | `Query_key | `Query_value | `Fragment ->
+    unreserved_chars ^ sub_delim_chars ^ ":@/?"
+  | _ -> unreserved_chars ^ sub_delim_chars
+;;
+
+let%hegel_test pct_encode_roundtrip tc =
+  let _, component = draw tc components in
+  let s = draw tc (binary ~max_size:12 ()) in
+  let e = Uri.pct_encode ~component s in
+  let back = Uri.pct_decode e in
+  if not (String.equal back s)
+  then Printf.ksprintf failwith "%S encodes as %S, decodes as %S" s e back
+;;
+
+let%hegel_test pct_encode_output_is_rfc3986 tc =
+  let _, component = draw tc components in
+  let s = draw tc (binary ~max_size:12 ()) in
+  let e = Uri.pct_encode ~component s in
+  let n = String.length e in
+  let rec ok i =
+    i >= n
+    || (String.contains (allowed component) e.[i] && ok (i + 1))
+    || (e.[i] = '%'
+        && i + 2 < n
+        && String.contains hex e.[i + 1]
+        && String.contains hex e.[i + 2]
+        && ok (i + 3))
+  in
+  if not (ok 0) then Printf.ksprintf failwith "%S encodes as %S" s e
+;;
+
+let queries =
+  lists
+    (tuples2 (binary ~max_size:4 ()) (lists (binary ~max_size:4 ()) ~max_size:3 ()))
+    ~min_size:1
+    ~max_size:4
+    ()
+;;
+
+let%hegel_test query_roundtrip tc =
+  let q = draw tc queries in
+  let e = Uri.encoded_of_query q in
+  if Uri.query_of_encoded e <> q then Printf.ksprintf failwith "encodes as %S" e
+;;
+
+let%hegel_test decoded_components_survive_printing tc =
+  let u = draw tc (uri (map Uri.of_string references)) in
+  let fragment = draw tc (binary ~max_size:6 ()) in
+  let query = draw tc queries in
+  let password = draw tc (binary ~max_size:6 ()) in
+  let u =
+    Uri.with_password (Uri.with_fragment (Uri.with_query u query) (Some fragment)) (Some password)
+  in
+  let printed = Uri.to_string u in
+  let back = Uri.of_string printed in
+  if Uri.fragment back <> Some fragment then failwith ("fragment lost in " ^ printed);
+  if Uri.query back <> query then failwith ("query lost in " ^ printed);
+  if Uri.password back <> Some password then failwith ("password lost in " ^ printed)
+;;
+
+let section_5_4 =
+  [ "g:h", "g:h"; "g", "http://a/b/c/g"; "./g", "http://a/b/c/g"; "g/", "http://a/b/c/g/"
+  ; "/g", "http://a/g"; "//g", "http://g"; "?y", "http://a/b/c/d;p?y"
+  ; "g?y", "http://a/b/c/g?y"; "#s", "http://a/b/c/d;p?q#s"; "g#s", "http://a/b/c/g#s"
+  ; "g?y#s", "http://a/b/c/g?y#s"; ";x", "http://a/b/c/;x"; "g;x", "http://a/b/c/g;x"
+  ; "g;x?y#s", "http://a/b/c/g;x?y#s"; "", "http://a/b/c/d;p?q"; ".", "http://a/b/c/"
+  ; "./", "http://a/b/c/"; "..", "http://a/b/"; "../", "http://a/b/"; "../g", "http://a/b/g"
+  ; "../..", "http://a/"; "../../", "http://a/"; "../../g", "http://a/g"
+  ; "../../../g", "http://a/g"; "../../../../g", "http://a/g"; "/./g", "http://a/g"
+  ; "/../g", "http://a/g"; "g.", "http://a/b/c/g."; ".g", "http://a/b/c/.g"
+  ; "g..", "http://a/b/c/g.."; "..g", "http://a/b/c/..g"; "./../g", "http://a/b/g"
+  ; "./g/.", "http://a/b/c/g/"; "g/./h", "http://a/b/c/g/h"; "g/../h", "http://a/b/c/h"
+  ; "g;x=1/./y", "http://a/b/c/g;x=1/y"; "g;x=1/../y", "http://a/b/c/y"
+  ; "g?y/./x", "http://a/b/c/g?y/./x"; "g?y/../x", "http://a/b/c/g?y/../x"
+  ; "g#s/./x", "http://a/b/c/g#s/./x"; "g#s/../x", "http://a/b/c/g#s/../x"; "http:g", "http:g"
+  ]
+;;
+
+let pin_rfc3986_section_5_4 () =
+  let base = Uri.of_string "http://a/b/c/d;p?q" in
+  let wrong =
+    List.filter_map
+      (fun (r, want) ->
+         let got = Uri.to_string (Uri.resolve "" base (Uri.of_string r)) in
+         let want = Uri.to_string (Uri.of_string want) in
+         if String.equal got want then None else Some (Printf.sprintf "%S -> %s, want %s" r got want))
+      section_5_4
+  in
+  if wrong <> [] then failwith (String.concat "; " wrong)
+;;
