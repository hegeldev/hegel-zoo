+let pin_fut_for_negative () =
+  with_pool (fun pool ->
+    match settle ~within:0.5 (Fut.for_ ~on:pool (-1) ignore) with
+    | Some (Ok ()) -> ()
+    | Some (Error (e, _)) -> Printf.ksprintf failwith "fails with %s" (Printexc.to_string e)
+    | None -> failwith "never resolves")
