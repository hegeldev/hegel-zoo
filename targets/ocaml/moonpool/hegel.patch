+let pin_fulfill_after_shutdown_raises () =
+  let fut, promise = Fut.make () in
+  let called = ref false in
+  Fut.on_result fut (fun _ -> called := true);
+  let pool = Ws_pool.create ~num_threads:1 () in
+  ignore (Fut.spawn ~on:pool (fun () -> Fut.await fut) : int Fut.t);
+  Runner.shutdown pool;
+  (match Fut.fulfill promise (Ok 1) with
+   | () -> ()
+   | exception e -> Printf.ksprintf failwith "fulfill raises %s" (Printexc.to_string e));
+  if not !called then failwith "on_result callback not called"
+;;
+
+let pin_fifo_shutdown_drops_awaiting_task () =
+  let pool = Fifo_pool.create ~num_threads:1 () in
+  let gate = Atomic.make false in
+  let started = Atomic.make false in
+  let parent =
+    Fut.spawn ~on:pool (fun () ->
+      let child =
+        Fut.spawn_on_current_runner (fun () ->
+          while not (Atomic.get gate) do
+            Thread.yield ()
+          done;
+          41)
+      in
+      Atomic.set started true;
+      Fut.await child + 1)
+  in
+  eventually "the task has not started" (fun () -> Atomic.get started);
+  Runner.shutdown_without_waiting pool;
+  Atomic.set gate true;
+  Runner.shutdown pool;
+  match Fut.peek parent with
+  | Some (Ok 42) -> ()
+  | Some r -> Printf.ksprintf failwith "the task gives %s" (show_int_outcome (outcome r))
+  | None -> failwith "the task is unresolved after shutdown"
+;;
+
+let pin_chan_max_size_zero () =
+  let c = Chan.create ~max_size:0 () in
+  if Chan.try_push c 1 then failwith "a channel of max_size 0 takes an element"
