new file mode 100644
index 0000000..ce31977
--- /dev/null
+++ b/hegel/zoo.ml
@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
diff --git a/hegel/zoo_tests.ml b/hegel/zoo_tests.ml
new file mode 100644
index 0000000..228cfbc
--- /dev/null
+++ b/hegel/zoo_tests.ml
@@ -0,0 +1,413 @@
+open Hegel
+
+type json = Yojson.Safe.t
+
+(* Yojson.Safe.show, since the writers raise on NaN and the infinities *)
+let json g = with_printer (fun j -> Sexplib0.Sexp.Atom (Yojson.Safe.show j)) g
+let spelling g = with_printer (fun s -> Sexplib0.Sexp.Atom s) g
+
+let beyond_int =
+  filter
+    (fun s -> Option.is_none (int_of_string_opt s))
+    (from_regex "-?[1-9][0-9]{18,24}" ~fullmatch:true ())
+;;
+
+(* yojson passes bytes 128-255 through unvalidated *)
+let strings = one_of [ text ~max_size:8 (); binary ~max_size:8 () ]
+
+let keys = one_of [ text ~alphabet:"ab" ~max_size:2 (); text ~max_size:4 () ]
+
+let leaf floats_ =
+  one_of
+    [ json (just (`Null : json))
+    ; json (map (fun b -> (`Bool b : json)) (booleans ()))
+    ; json (map (fun n -> (`Int n : json)) (integers ()))
+    ; json (map (fun f -> (`Float f : json)) floats_)
+    ; json (map (fun s -> (`String s : json)) strings)
+    ; json (map (fun s -> (`Intlit s : json)) beyond_int)
+    ]
+;;
+
+let rec tree floats_ depth =
+  if depth = 0
+  then leaf floats_
+  else (
+    let sub = tree floats_ (depth - 1) in
+    one_of
+      [ leaf floats_
+      ; json (map (fun xs -> (`List xs : json)) (lists sub ~max_size:4 ()))
+      ; json (map (fun kvs -> (`Assoc kvs : json)) (lists (tuples2 keys sub) ~max_size:4 ()))
+      ])
+;;
+
+let any_values = tree (floats ()) 3
+
+let finite = floats ~allow_nan:false ~allow_infinity:false ()
+let values = tree finite 3
+
+let ws = text ~alphabet:" \t\n\r" ~max_size:2 ()
+
+let uescape u =
+  if u < 0x10000
+  then Printf.sprintf "\\u%04x" u
+  else (
+    let u = u - 0x10000 in
+    Printf.sprintf "\\u%04X\\u%04x" (0xD800 lor (u lsr 10)) (0xDC00 lor (u land 0x3FF)))
+;;
+
+let short_escape = function
+  | '"' -> Some "\\\""
+  | '\\' -> Some "\\\\"
+  | '/' -> Some "\\/"
+  | '\b' -> Some "\\b"
+  | '\012' -> Some "\\f"
+  | '\n' -> Some "\\n"
+  | '\r' -> Some "\\r"
+  | '\t' -> Some "\\t"
+  | _ -> None
+;;
+
+let char_spellings s i =
+  let d = String.get_utf_8_uchar s i in
+  let n = Uchar.utf_decode_length d in
+  if not (Uchar.utf_decode_is_valid d)
+  then [ String.sub s i n ], n
+  else (
+    let u = Uchar.to_int (Uchar.utf_decode_uchar d) in
+    let c = s.[i] in
+    let raw = if u < 0x20 || c = '"' || c = '\\' then [] else [ String.sub s i n ] in
+    let short = if n = 1 then Option.to_list (short_escape c) else [] in
+    raw @ short @ [ uescape u ], n)
+;;
+
+let spell_string s =
+  composite (fun tc ->
+    let b = Buffer.create (String.length s + 2) in
+    Buffer.add_char b '"';
+    let rec go i =
+      if i < String.length s
+      then (
+        let options, n = char_spellings s i in
+        Buffer.add_string b (draw_silent tc (sampled_from options));
+        go (i + n))
+    in
+    go 0;
+    Buffer.add_char b '"';
+    Buffer.contents b)
+;;
+
+let spell_float f =
+  map
+    (fun form ->
+       match form with
+       | `G ->
+         let s = Printf.sprintf "%.17g" f in
+         if String.exists (fun c -> c = '.' || c = 'e') s then s else s ^ ".0"
+       | `E -> Printf.sprintf "%.17e" f
+       | `Upper_e -> Printf.sprintf "%.17E" f
+       | `No_sign ->
+         String.concat "" (String.split_on_char '+' (Printf.sprintf "%.17e" f)))
+    (sampled_from [ `G; `E; `Upper_e; `No_sign ])
+;;
+
+let rec spell (v : json) =
+  composite (fun tc ->
+    let w () = draw_silent tc ws in
+    match v with
+    | `Null -> "null"
+    | `Bool b -> string_of_bool b
+    | `Int n -> string_of_int n
+    | `Intlit s -> s
+    | `Float f -> draw_silent tc (spell_float f)
+    | `String s -> draw_silent tc (spell_string s)
+    | `List xs ->
+      let items = List.map (fun x -> w () ^ draw_silent tc (spell x) ^ w ()) xs in
+      "[" ^ (if items = [] then w () else String.concat "," items) ^ "]"
+    | `Assoc kvs ->
+      let items =
+        List.map
+          (fun (k, x) ->
+             let k = draw_silent tc (spell_string k) in
+             w () ^ k ^ w () ^ ":" ^ w () ^ draw_silent tc (spell x) ^ w ())
+          kvs
+      in
+      "{" ^ (if items = [] then w () else String.concat "," items) ^ "}")
+;;
+
+exception Not_standard of int * string
+
+(* strings are not checked for valid UTF-8, as yojson does not check them either *)
+let read_standard (s : string) : json =
+  let pos = ref 0 in
+  let fail what = raise (Not_standard (!pos, what)) in
+  let peek () = if !pos < String.length s then Some s.[!pos] else None in
+  let eat c = if peek () = Some c then incr pos else fail (Printf.sprintf "expected %C" c) in
+  let rec skip_ws () =
+    match peek () with
+    | Some (' ' | '\t' | '\n' | '\r') ->
+      incr pos;
+      skip_ws ()
+    | _ -> ()
+  in
+  let literal word v =
+    if !pos + String.length word <= String.length s
+       && String.equal (String.sub s !pos (String.length word)) word
+    then (
+      pos := !pos + String.length word;
+      v)
+    else fail ("expected " ^ word)
+  in
+  let digits () =
+    let start = !pos in
+    while
+      match peek () with
+      | Some '0' .. '9' -> true
+      | _ -> false
+    do
+      incr pos
+    done;
+    if !pos = start then fail "expected a digit"
+  in
+  let number () =
+    let start = !pos in
+    if peek () = Some '-' then incr pos;
+    (match peek () with
+     | Some '0' -> incr pos
+     | Some '1' .. '9' -> digits ()
+     | _ -> fail "expected a digit");
+    let integral = ref true in
+    if peek () = Some '.'
+    then (
+      integral := false;
+      incr pos;
+      digits ());
+    (match peek () with
+     | Some ('e' | 'E') ->
+       integral := false;
+       incr pos;
+       (match peek () with
+        | Some ('+' | '-') -> incr pos
+        | _ -> ());
+       digits ()
+     | _ -> ());
+    let lit = String.sub s start (!pos - start) in
+    if !integral
+    then (
+      match int_of_string_opt lit with
+      | Some n -> `Int n
+      | None -> `Intlit lit)
+    else `Float (float_of_string lit)
+  in
+  let hex4 () =
+    if !pos + 4 > String.length s then fail "short \\u escape";
+    match int_of_string_opt ("0x" ^ String.sub s !pos 4) with
+    | Some u when String.for_all (fun c -> c <> '_') (String.sub s !pos 4) ->
+      pos := !pos + 4;
+      u
+    | _ -> fail "bad \\u escape"
+  in
+  let string_ () =
+    eat '"';
+    let b = Buffer.create 16 in
+    let rec go () =
+      match peek () with
+      | None -> fail "unterminated string"
+      | Some '"' -> incr pos
+      | Some c when Char.code c < 0x20 -> fail "unescaped control character"
+      | Some '\\' ->
+        incr pos;
+        let c = Option.value (peek ()) ~default:' ' in
+        incr pos;
+        (match c with
+         | '"' | '\\' | '/' -> Buffer.add_char b c
+         | 'b' -> Buffer.add_char b '\b'
+         | 'f' -> Buffer.add_char b '\012'
+         | 'n' -> Buffer.add_char b '\n'
+         | 'r' -> Buffer.add_char b '\r'
+         | 't' -> Buffer.add_char b '\t'
+         | 'u' ->
+           let u = hex4 () in
+           let u =
+             if u >= 0xD800 && u < 0xDC00 && peek () = Some '\\'
+             then (
+               incr pos;
+               eat 'u';
+               let lo = hex4 () in
+               if lo >= 0xDC00 && lo < 0xE000
+               then 0x10000 + ((u - 0xD800) lsl 10) + (lo - 0xDC00)
+               else fail "unpaired surrogate")
+             else if u >= 0xD800 && u < 0xE000
+             then fail "unpaired surrogate"
+             else u
+           in
+           Buffer.add_utf_8_uchar b (Uchar.of_int u)
+         | _ -> fail "bad escape");
+        go ()
+      | Some c ->
+        Buffer.add_char b c;
+        incr pos;
+        go ()
+    in
+    go ();
+    Buffer.contents b
+  in
+  let rec value () : json =
+    skip_ws ();
+    let v =
+      match peek () with
+      | Some 'n' -> literal "null" `Null
+      | Some 't' -> literal "true" (`Bool true)
+      | Some 'f' -> literal "false" (`Bool false)
+      | Some '"' -> `String (string_ ())
+      | Some '[' ->
+        incr pos;
+        skip_ws ();
+        if peek () = Some ']'
+        then (
+          incr pos;
+          `List [])
+        else (
+          let rec items acc =
+            let acc = value () :: acc in
+            match peek () with
+            | Some ',' ->
+              incr pos;
+              items acc
+            | _ ->
+              eat ']';
+              List.rev acc
+          in
+          `List (items []))
+      | Some '{' ->
+        incr pos;
+        skip_ws ();
+        if peek () = Some '}'
+        then (
+          incr pos;
+          `Assoc [])
+        else (
+          let rec members acc =
+            skip_ws ();
+            let k = string_ () in
+            skip_ws ();
+            eat ':';
+            let acc = (k, value ()) :: acc in
+            match peek () with
+            | Some ',' ->
+              incr pos;
+              members acc
+            | _ ->
+              eat '}';
+              List.rev acc
+          in
+          `Assoc (members []))
+      | Some ('-' | '0' .. '9') -> number ()
+      | _ -> fail "expected a value"
+    in
+    skip_ws ();
+    v
+  in
+  let v = value () in
+  if !pos <> String.length s then fail "trailing data";
+  v
+;;
+
+let%hegel_test roundtrip tc =
+  let v = draw tc values in
+  let s = Yojson.Safe.to_string v in
+  let back = Yojson.Safe.from_string s in
+  if not (Yojson.Safe.equal back v) then Printf.ksprintf failwith "%s reads back as %s" s (Yojson.Safe.show back)
+;;
+
+let%hegel_test pretty_roundtrip tc =
+  let v = draw tc values in
+  let s = Yojson.Safe.pretty_to_string v in
+  let back = Yojson.Safe.from_string s in
+  if not (Yojson.Safe.equal back v) then Printf.ksprintf failwith "%s reads back as %s" s (Yojson.Safe.show back)
+;;
+
+let%hegel_test writer_is_standard tc =
+  let v = draw tc values in
+  let s = Yojson.Safe.to_string v in
+  match read_standard s with
+  | back ->
+    if not (Yojson.Safe.equal back v) then Printf.ksprintf failwith "%s means %s in standard JSON" s (Yojson.Safe.show back)
+  | exception Not_standard (at, what) ->
+    Printf.ksprintf failwith "%s is not standard JSON at byte %d: %s" s at what
+;;
+
+let rec non_finite (v : json) =
+  match v with
+  | `Float f -> not (Float.is_finite f)
+  | `List xs -> List.exists non_finite xs
+  | `Assoc kvs -> List.exists (fun (_, x) -> non_finite x) kvs
+  | _ -> false
+;;
+
+let%hegel_test writer_refuses_non_finite tc =
+  let v = draw tc any_values in
+  match Yojson.Safe.to_string v with
+  | s -> if non_finite v then Printf.ksprintf failwith "writes %s" s
+  | exception Yojson.Json_error _ ->
+    if not (non_finite v) then failwith "a finite value raises Json_error"
+;;
+
+let%hegel_test reader_reads_standard_spellings tc =
+  let v = draw tc values in
+  let s = draw tc (spelling (spell v)) in
+  let back = Yojson.Safe.from_string s in
+  if not (Yojson.Safe.equal back v) then Printf.ksprintf failwith "reads as %s" (Yojson.Safe.show back)
+;;
+
+let int_literals =
+  one_of
+    [ map string_of_int (integers ()) |> spelling
+    ; from_regex "-?46116860184273879[0-9]{2}" ~fullmatch:true ()
+    ; beyond_int
+    ]
+;;
+
+let%hegel_test int_literal_boundary tc =
+  let s = draw tc int_literals in
+  let expected : json =
+    match int_of_string_opt s with
+    | Some n -> `Int n
+    | None -> `Intlit s
+  in
+  let back = Yojson.Safe.from_string s in
+  if not (Yojson.Safe.equal back expected) then Printf.ksprintf failwith "reads as %s" (Yojson.Safe.show back)
+;;
+
+let%hegel_test member_is_first_binding tc =
+  let kvs = draw tc (lists (tuples2 keys (leaf finite)) ~max_size:6 ()) in
+  let k = draw tc keys in
+  let expected = Option.value (List.assoc_opt k kvs) ~default:`Null in
+  let got = Yojson.Safe.Util.member k (`Assoc kvs) in
+  if not (Yojson.Safe.equal got expected) then Printf.ksprintf failwith "member gives %s" (Yojson.Safe.show got)
+;;
+
+let%hegel_test index_counts_from_both_ends tc =
+  let xs = draw tc (lists (leaf finite) ~max_size:6 ()) in
+  let n = List.length xs in
+  let i = draw tc (integers ~min_value:(-n - 2) ~max_value:(n + 1) ()) in
+  let j = if i >= 0 then i else n + i in
+  let expected = if j >= 0 then List.nth_opt xs j else None in
+  match Yojson.Safe.Util.index i (`List xs), expected with
+  | got, Some e -> if not (Yojson.Safe.equal got e) then Printf.ksprintf failwith "index gives %s" (Yojson.Safe.show got)
+  | got, None -> Printf.ksprintf failwith "index out of bounds gives %s" (Yojson.Safe.show got)
+  | exception Yojson.Safe.Util.Undefined _ ->
+    if Option.is_some expected then failwith "index in bounds raises Undefined"
+;;
+
+let () =
+  Zoo.run
+    [ "roundtrip", roundtrip
+    ; "pretty_roundtrip", pretty_roundtrip
+    ; "writer_is_standard", writer_is_standard
+    ; "writer_refuses_non_finite", writer_refuses_non_finite
+    ; "reader_reads_standard_spellings", reader_reads_standard_spellings
+    ; "int_literal_boundary", int_literal_boundary
+    ; "member_is_first_binding", member_is_first_binding
+    ; "index_counts_from_both_ends", index_counts_from_both_ends
+    ]
+;;
