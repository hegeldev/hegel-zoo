new file mode 100644
index 0000000..ed8adee
--- /dev/null
+++ b/hegel/props.ml
@@ -0,0 +1,566 @@
+open Hegel
+
+let shown f g = with_printer (fun x -> Sexplib0.Sexp.Atom (f x)) g
+let hex s = String.concat "" (List.map (fun c -> Printf.sprintf "%02x" (Char.code c)) (List.of_seq (String.to_seq s)))
+
+let unhex h =
+  String.init (String.length h / 2) (fun i -> Char.chr (int_of_string ("0x" ^ String.sub h (2 * i) 2)))
+;;
+
+let bigstring s =
+  Bigarray.Array1.init Bigarray.char Bigarray.c_layout (String.length s) (String.get s)
+;;
+
+type algo =
+  { name : string
+  ; m : (module Digestif.S)
+  }
+
+let hashlib =
+  [ { name = "md5"; m = (module Digestif.MD5) }
+  ; { name = "sha1"; m = (module Digestif.SHA1) }
+  ; { name = "sha224"; m = (module Digestif.SHA224) }
+  ; { name = "sha256"; m = (module Digestif.SHA256) }
+  ; { name = "sha384"; m = (module Digestif.SHA384) }
+  ; { name = "sha512"; m = (module Digestif.SHA512) }
+  ; { name = "sha3_224"; m = (module Digestif.SHA3_224) }
+  ; { name = "sha3_256"; m = (module Digestif.SHA3_256) }
+  ; { name = "sha3_384"; m = (module Digestif.SHA3_384) }
+  ; { name = "sha3_512"; m = (module Digestif.SHA3_512) }
+  ; { name = "blake2b"; m = (module Digestif.BLAKE2B) }
+  ; { name = "blake2s"; m = (module Digestif.BLAKE2S) }
+  ]
+;;
+
+let everything =
+  hashlib
+  @ [ { name = "rmd160"; m = (module Digestif.RMD160) }
+    ; { name = "whirlpool"; m = (module Digestif.WHIRLPOOL) }
+    ; { name = "keccak_256"; m = (module Digestif.KECCAK_256) }
+    ; { name = "blake3"; m = (module Digestif.BLAKE3) }
+    ]
+;;
+
+let algos list = shown (fun a -> a.name) (sampled_from list)
+
+let python_script =
+  {|
+import hashlib, hmac, sys
+for line in sys.stdin:
+    op, alg, size, key, data = line.split()
+    size, key, data = int(size), bytes.fromhex(key[1:]), bytes.fromhex(data[1:])
+    try:
+        if op == "hmac":
+            out = hmac.new(key, data, alg).hexdigest()
+        elif alg in ("blake2b", "blake2s"):
+            h = getattr(hashlib, alg)
+            out = h(data, key=key, digest_size=size or h.MAX_DIGEST_SIZE).hexdigest()
+        else:
+            out = hashlib.new(alg, data).hexdigest()
+    except ValueError:
+        out = "E"
+    print(out, flush=True)
+|}
+;;
+
+let ask process line =
+  let ic, oc = Lazy.force process in
+  output_string oc (line ^ "\n");
+  flush oc;
+  input_line ic
+;;
+
+let python = lazy (Unix.open_process_args "python3" [| "python3"; "-c"; python_script |])
+
+let hashlib_hex ?(op = "hash") ?(size = 0) ?(key = "") alg data =
+  ask python (Printf.sprintf "%s %s %d x%s x%s" op alg size (hex key) (hex data))
+;;
+
+let other = ref ""
+let backend = lazy (Unix.open_process_args !other [| !other; "--serve" |])
+
+let by_name name =
+  let a = List.find (fun a -> String.equal a.name name) everything in
+  let (module M) = a.m in
+  fun data -> M.to_raw_string (M.digest_string data)
+;;
+
+(* the other implementation of the virtual library answers what Python cannot *)
+let serve () =
+  try
+    while true do
+      let line = input_line stdin in
+      let op, key, data, n, seek =
+        Scanf.sscanf line "%s x%s x%s %d %Ld" (fun op key data n seek ->
+          op, unhex key, unhex data, n, seek)
+      in
+      let out =
+        match op with
+        | "blake3-keyed" -> Digestif.BLAKE3.(to_raw_string (Keyed.mac_string ~key data))
+        | "blake3-derive" ->
+          Digestif.BLAKE3.(to_raw_string (Derive_key.derive_key_string ~context:key data))
+        | "blake3-xof" ->
+          Digestif.BLAKE3.(get_xof (feed_string empty data) ~seek n)
+        | name -> by_name name data
+      in
+      print_endline (hex out)
+    done
+  with
+  | End_of_file -> exit 0
+;;
+
+type kind =
+  | String
+  | Bytes
+  | Bigstring
+
+let kinds =
+  shown
+    (function
+      | String -> "string"
+      | Bytes -> "bytes"
+      | Bigstring -> "bigstring")
+    (sampled_from [ String; Bytes; Bigstring ])
+;;
+
+(* lengths around the block sizes, 64 to 144 bytes *)
+let data =
+  one_of
+    [ binary ~max_size:8 ()
+    ; binary ~min_size:60 ~max_size:76 ()
+    ; binary ~min_size:100 ~max_size:150 ()
+    ]
+;;
+
+let slack = one_of [ shown Fun.id (just ""); binary ~min_size:1 ~max_size:4 () ]
+
+type piece =
+  { kind : kind
+  ; before : string
+  ; data : string
+  ; after : string
+  }
+
+let pieces =
+  shown
+    (fun p -> Printf.sprintf "%S" (p.before ^ "|" ^ p.data ^ "|" ^ p.after))
+    (map
+       (fun (kind, before, data, after) -> { kind; before; data; after })
+       (tuples4 kinds slack data slack))
+;;
+
+let whole p = p.before ^ p.data ^ p.after
+let off p = String.length p.before
+let len p = String.length p.data
+
+let keys =
+  one_of
+    [ binary ~max_size:8 ()
+    ; binary ~min_size:60 ~max_size:68 ()
+    ; binary ~min_size:124 ~max_size:200 ()
+    ]
+;;
+
+let mismatch what ours theirs =
+  if not (String.equal (hex ours) theirs)
+  then Printf.ksprintf failwith "%s: %s, expected %s" what (hex ours) theirs
+;;
+
+let%hegel_test digest_matches_hashlib tc =
+  let a = draw tc (algos hashlib) in
+  let p = draw tc pieces in
+  let (module M) = a.m in
+  let d =
+    match p.kind with
+    | String -> M.digest_string ~off:(off p) ~len:(len p) (whole p)
+    | Bytes -> M.digest_bytes ~off:(off p) ~len:(len p) (Bytes.of_string (whole p))
+    | Bigstring -> M.digest_bigstring ~off:(off p) ~len:(len p) (bigstring (whole p))
+  in
+  mismatch a.name (M.to_raw_string d) (hashlib_hex a.name p.data)
+;;
+
+let feed (type c) (module M : Digestif.S with type ctx = c) (ctx : c) p =
+  match p.kind with
+  | String -> M.feed_string ctx ~off:(off p) ~len:(len p) (whole p)
+  | Bytes -> M.feed_bytes ctx ~off:(off p) ~len:(len p) (Bytes.of_string (whole p))
+  | Bigstring -> M.feed_bigstring ctx ~off:(off p) ~len:(len p) (bigstring (whole p))
+;;
+
+let%hegel_test feed_matches_hashlib tc =
+  let a = draw tc (algos hashlib) in
+  let ps = draw tc (lists pieces ~max_size:5 ()) in
+  let (module M) = a.m in
+  let ctx = List.fold_left (feed (module M)) M.empty ps in
+  mismatch
+    a.name
+    (M.to_raw_string (M.get ctx))
+    (hashlib_hex a.name (String.concat "" (List.map (fun p -> p.data) ps)))
+;;
+
+let%hegel_test digest_lists_match_hashlib tc =
+  let a = draw tc (algos hashlib) in
+  let kind = draw tc kinds in
+  let iterated = draw tc (booleans ()) in
+  let chunks = draw tc (lists data ~max_size:5 ()) in
+  let (module M) = a.m in
+  let iter xs f = List.iter f xs in
+  let d =
+    match kind, iterated with
+    | String, false -> M.digestv_string chunks
+    | String, true -> M.digesti_string (iter chunks)
+    | Bytes, false -> M.digestv_bytes (List.map Bytes.of_string chunks)
+    | Bytes, true -> M.digesti_bytes (iter (List.map Bytes.of_string chunks))
+    | Bigstring, false -> M.digestv_bigstring (List.map bigstring chunks)
+    | Bigstring, true -> M.digesti_bigstring (iter (List.map bigstring chunks))
+  in
+  mismatch a.name (M.to_raw_string d) (hashlib_hex a.name (String.concat "" chunks))
+;;
+
+let%hegel_test hmac_matches_python tc =
+  let a = draw tc (algos hashlib) in
+  let key = draw tc keys in
+  let p = draw tc pieces in
+  let (module M) = a.m in
+  let d =
+    match p.kind with
+    | String -> M.hmac_string ~key ~off:(off p) ~len:(len p) (whole p)
+    | Bytes -> M.hmac_bytes ~key ~off:(off p) ~len:(len p) (Bytes.of_string (whole p))
+    | Bigstring -> M.hmac_bigstring ~key ~off:(off p) ~len:(len p) (bigstring (whole p))
+  in
+  mismatch a.name (M.to_raw_string d) (hashlib_hex ~op:"hmac" ~key a.name p.data)
+;;
+
+let hmac_feed (type h) (module M : Digestif.S with type hmac = h) (h : h) p =
+  match p.kind with
+  | String -> M.hmac_feed_string h ~off:(off p) ~len:(len p) (whole p)
+  | Bytes -> M.hmac_feed_bytes h ~off:(off p) ~len:(len p) (Bytes.of_string (whole p))
+  | Bigstring -> M.hmac_feed_bigstring h ~off:(off p) ~len:(len p) (bigstring (whole p))
+;;
+
+let%hegel_test hmac_feed_matches_python tc =
+  let a = draw tc (algos hashlib) in
+  let key = draw tc keys in
+  let ps = draw tc (lists pieces ~max_size:5 ()) in
+  let (module M) = a.m in
+  let h = List.fold_left (hmac_feed (module M)) (M.hmac_init ~key) ps in
+  mismatch
+    a.name
+    (M.to_raw_string (M.hmac_get h))
+    (hashlib_hex ~op:"hmac" ~key a.name (String.concat "" (List.map (fun p -> p.data) ps)))
+;;
+
+let%hegel_test hmac_lists_match_python tc =
+  let a = draw tc (algos hashlib) in
+  let key = draw tc keys in
+  let kind = draw tc kinds in
+  let iterated = draw tc (booleans ()) in
+  let chunks = draw tc (lists data ~max_size:5 ()) in
+  let (module M) = a.m in
+  let iter xs f = List.iter f xs in
+  let d =
+    match kind, iterated with
+    | String, false -> M.hmacv_string ~key chunks
+    | String, true -> M.hmaci_string ~key (iter chunks)
+    | Bytes, false -> M.hmacv_bytes ~key (List.map Bytes.of_string chunks)
+    | Bytes, true -> M.hmaci_bytes ~key (iter (List.map Bytes.of_string chunks))
+    | Bigstring, false -> M.hmacv_bigstring ~key (List.map bigstring chunks)
+    | Bigstring, true -> M.hmaci_bigstring ~key (iter (List.map bigstring chunks))
+  in
+  mismatch
+    a.name
+    (M.to_raw_string d)
+    (hashlib_hex ~op:"hmac" ~key a.name (String.concat "" chunks))
+;;
+
+let blake2 =
+  let sized name max =
+    shown
+      (fun (name, size) -> Printf.sprintf "%s/%d" name size)
+      (map (fun n -> name, n) (integers ~min_value:1 ~max_value:max ()))
+  in
+  one_of [ sized "blake2b" 64; sized "blake2s" 32 ]
+;;
+
+let make_blake2 name size : (module Digestif.S) =
+  if String.equal name "blake2b"
+  then
+    (module Digestif.Make_BLAKE2B (struct
+         let digest_size = size
+       end))
+  else
+    (module Digestif.Make_BLAKE2S (struct
+         let digest_size = size
+       end))
+;;
+
+let%hegel_test blake2_sizes_match_hashlib tc =
+  let name, size = draw tc blake2 in
+  let chunks = draw tc (lists data ~max_size:3 ()) in
+  let (module M) = make_blake2 name size in
+  mismatch
+    name
+    (M.to_raw_string (M.digestv_string chunks))
+    (hashlib_hex ~size name (String.concat "" chunks))
+;;
+
+let%hegel_test blake2_keyed_matches_hashlib tc =
+  let name = draw tc (shown Fun.id (sampled_from [ "blake2b"; "blake2s" ])) in
+  let key =
+    draw tc (binary ~max_size:(if String.equal name "blake2b" then 64 else 32) ())
+  in
+  let p = draw tc pieces in
+  let ours =
+    if String.equal name "blake2b"
+    then
+      Digestif.BLAKE2B.(to_raw_string (Keyed.mac_string ~key ~off:(off p) ~len:(len p) (whole p)))
+    else
+      Digestif.BLAKE2S.(to_raw_string (Keyed.mac_string ~key ~off:(off p) ~len:(len p) (whole p)))
+  in
+  mismatch name ours (hashlib_hex ~key name p.data)
+;;
+
+type cross =
+  | Digest of algo
+  | Blake3_keyed of string
+  | Blake3_derive of string
+  | Blake3_xof of int * int64
+
+let show_cross = function
+  | Digest a -> a.name
+  | Blake3_keyed k -> "blake3 keyed " ^ hex k
+  | Blake3_derive c -> Printf.sprintf "blake3 derive %S" c
+  | Blake3_xof (n, seek) -> Printf.sprintf "blake3 xof %d at %Ld" n seek
+;;
+
+let crosses =
+  let cross g = shown show_cross g in
+  one_of
+    [ cross (map (fun a -> Digest a) (sampled_from everything))
+    ; cross (map (fun k -> Blake3_keyed k) (binary ~min_size:32 ~max_size:32 ()))
+    ; cross (map (fun c -> Blake3_derive c) (text ~max_size:20 ()))
+    ; cross
+        (map
+           (fun (n, seek) -> Blake3_xof (n, Int64.of_int seek))
+           (tuples2
+              (integers ~min_value:0 ~max_value:200 ())
+              (integers ~min_value:0 ~max_value:2000 ())))
+    ]
+;;
+
+let%hegel_test backends_agree tc =
+  let c = draw tc crosses in
+  let d = draw tc (lists data ~max_size:3 ()) in
+  let d = String.concat "" d in
+  let request op key n seek = Printf.sprintf "%s x%s x%s %d %Ld" op (hex key) (hex d) n seek in
+  let ours, line =
+    match c with
+    | Digest a -> by_name a.name d, request a.name "" 0 0L
+    | Blake3_keyed key ->
+      Digestif.BLAKE3.(to_raw_string (Keyed.mac_string ~key d)), request "blake3-keyed" key 0 0L
+    | Blake3_derive context ->
+      ( Digestif.BLAKE3.(to_raw_string (Derive_key.derive_key_string ~context d))
+      , request "blake3-derive" context 0 0L )
+    | Blake3_xof (n, seek) ->
+      Digestif.BLAKE3.(get_xof (feed_string empty d) ~seek n), request "blake3-xof" "" n seek
+  in
+  mismatch "the other backend" ours (ask backend line)
+;;
+
+let%hegel_test to_hex_is_hex_of_raw tc =
+  let a = draw tc (algos everything) in
+  let d = draw tc data in
+  let (module M) = a.m in
+  let t = M.digest_string d in
+  if not (String.equal (M.to_hex t) (hex (M.to_raw_string t)))
+  then Printf.ksprintf failwith "to_hex gives %s" (M.to_hex t)
+;;
+
+let whitespace = " \t\r\n"
+let is_space c = String.contains whitespace c
+let without_spaces s = String.of_seq (Seq.filter (fun c -> not (is_space c)) (String.to_seq s))
+
+let is_hex = function
+  | '0' .. '9' | 'a' .. 'f' | 'A' .. 'F' -> true
+  | _ -> false
+;;
+
+type ending =
+  | Trailing of string
+  | Whole
+  | Cut of int
+  | Extra of string
+
+let hex_text size =
+  let spaces =
+    lists
+      (tuples2
+         (integers ~min_value:0 ~max_value:(2 * size) ())
+         (shown (String.make 1) (sampled_from (List.of_seq (String.to_seq whitespace)))))
+      ~max_size:3
+      ()
+  in
+  let trailing =
+    shown
+      (fun _ -> "trailing")
+      (map (fun t -> Trailing t) (text ~alphabet:whitespace ~min_size:1 ~max_size:2 ()))
+  in
+  let endings =
+    one_of
+      ((if Zoo.known then [ trailing ] else [])
+       @ [ shown (fun _ -> "whole") (just Whole)
+      ; shown (fun _ -> "cut") (map (fun k -> Cut k) (integers ~min_value:1 ~max_value:3 ()))
+         ; shown (fun _ -> "extra") (map (fun t -> Extra t) (text ~alphabet:"0aF \nxg" ~min_size:1 ~max_size:3 ()))
+         ])
+  in
+  let render (raw, upper, spaces, ending) =
+    let h = hex raw in
+    let h = if upper then String.uppercase_ascii h else h in
+    let h =
+      List.fold_left
+        (fun h (at, c) ->
+           let at = at mod (String.length h + 1) in
+           String.sub h 0 at ^ String.make 1 c ^ String.sub h at (String.length h - at))
+        h
+        spaces
+    in
+    match ending with
+    | Trailing t -> h ^ t
+    | Whole -> h
+    | Cut k -> String.sub h 0 (max 0 (String.length h - k))
+    | Extra t -> h ^ t
+  in
+  one_of
+    [ shown Fun.id
+        (map render (tuples4 (binary ~min_size:size ~max_size:size ()) (booleans ()) spaces endings))
+    ; text ~alphabet:"0123456789abcdefABCDEF \t\r\nxg" ~max_size:(2 * size + 2) ()
+    ]
+;;
+
+let of_hex_model size s =
+  let h = without_spaces s in
+  let h = if String.length h > 2 * size then String.sub h 0 (2 * size) else h in
+  if String.for_all is_hex h && String.length h mod 2 = 0
+  then Some (unhex h ^ String.make (size - (String.length h / 2)) '\000')
+  else None
+;;
+
+let%hegel_test of_hex_opt_matches_docs tc =
+  let a = draw tc (algos everything) in
+  let (module M) = a.m in
+  let s = draw tc (hex_text M.digest_size) in
+  let ours = Option.map M.to_raw_string (M.of_hex_opt s) in
+  let expected = of_hex_model M.digest_size s in
+  if not (Option.equal String.equal ours expected)
+  then
+    Printf.ksprintf
+      failwith
+      "of_hex_opt gives %s, expected %s"
+      (Option.fold ~none:"None" ~some:hex ours)
+      (Option.fold ~none:"None" ~some:hex expected)
+;;
+
+let%hegel_test consistent_of_hex_opt_matches_docs tc =
+  let a = draw tc (algos everything) in
+  let (module M) = a.m in
+  let s = draw tc (hex_text M.digest_size) in
+  let h = without_spaces s in
+  let expected =
+    if String.length h = 2 * M.digest_size && String.for_all is_hex h then Some (unhex h) else None
+  in
+  let ours = Option.map M.to_raw_string (M.consistent_of_hex_opt s) in
+  if not (Option.equal String.equal ours expected)
+  then
+    Printf.ksprintf
+      failwith
+      "consistent_of_hex_opt gives %s, expected %s"
+      (Option.fold ~none:"None" ~some:hex ours)
+      (Option.fold ~none:"None" ~some:hex expected)
+;;
+
+let%hegel_test raw_string_roundtrip tc =
+  let a = draw tc (algos everything) in
+  let (module M) = a.m in
+  let s = draw tc (binary ~min_size:(M.digest_size - 2) ~max_size:(M.digest_size + 2) ()) in
+  match M.of_raw_string_opt s with
+  | Some t ->
+    if String.length s <> M.digest_size then failwith "accepts a string of the wrong length";
+    if not (String.equal (M.to_raw_string t) s) then failwith "to_raw_string changes it"
+  | None -> if String.length s = M.digest_size then failwith "rejects a string of the digest size"
+;;
+
+let%hegel_test compare_and_equal_are_string_order tc =
+  let a = draw tc (algos everything) in
+  let (module M) = a.m in
+  let x = draw tc (binary ~min_size:M.digest_size ~max_size:M.digest_size ()) in
+  let flip = draw tc (optional (tuples2 (integers ~min_value:0 ~max_value:(M.digest_size - 1) ()) (integers ~min_value:1 ~max_value:255 ()))) in
+  let y =
+    match flip with
+    | None -> x
+    | Some (i, d) -> String.mapi (fun j c -> if i = j then Char.chr ((Char.code c + d) land 255) else c) x
+  in
+  let tx = M.of_raw_string x and ty = M.of_raw_string y in
+  if Int.compare (M.unsafe_compare tx ty) 0 <> Int.compare (String.compare x y) 0
+  then failwith "unsafe_compare disagrees with String.compare";
+  if M.equal tx ty <> String.equal x y then failwith "equal disagrees with String.equal"
+;;
+
+let%hegel_test get_into_bytes_matches_get tc =
+  let a = draw tc (algos everything) in
+  let d = draw tc data in
+  let (module M) = a.m in
+  let off = draw tc (integers ~min_value:0 ~max_value:8 ()) in
+  let ctx = M.feed_string M.empty d in
+  let buf = Bytes.make (off + M.digest_size + 3) '*' in
+  M.get_into_bytes ctx ~off buf;
+  let expected = String.make off '*' ^ M.to_raw_string (M.get ctx) ^ "***" in
+  if not (String.equal (Bytes.to_string buf) expected)
+  then Printf.ksprintf failwith "buffer is %s" (hex (Bytes.to_string buf))
+;;
+
+let%hegel_test blake3_xof_seeks_into_one_stream tc =
+  let d = draw tc data in
+  let seek = draw tc (integers ~min_value:0 ~max_value:300 ()) in
+  let n = draw tc (integers ~min_value:0 ~max_value:200 ()) in
+  let ctx = Digestif.BLAKE3.(feed_string empty d) in
+  let stream = Digestif.BLAKE3.get_xof ctx (seek + n) in
+  let got = Digestif.BLAKE3.get_xof ctx ~seek:(Int64.of_int seek) n in
+  if not (String.equal got (String.sub stream seek n))
+  then Printf.ksprintf failwith "seek %d gives %s" seek (hex got);
+  let head = Digestif.BLAKE3.get_xof ctx 32 in
+  if not (String.equal head Digestif.BLAKE3.(to_raw_string (get ctx)))
+  then failwith "the first 32 bytes of output are not the digest"
+;;
+
+let pin_consistent_of_hex_trailing_space () =
+  if Option.is_none (Digestif.MD5.consistent_of_hex_opt (String.make 32 '0' ^ " "))
+  then failwith "a digest's hex followed by a space is rejected"
+;;
+
+let tests =
+  [ "digest_matches_hashlib", digest_matches_hashlib
+  ; "feed_matches_hashlib", feed_matches_hashlib
+  ; "digest_lists_match_hashlib", digest_lists_match_hashlib
+  ; "hmac_matches_python", hmac_matches_python
+  ; "hmac_feed_matches_python", hmac_feed_matches_python
+  ; "hmac_lists_match_python", hmac_lists_match_python
+  ; "blake2_sizes_match_hashlib", blake2_sizes_match_hashlib
+  ; "blake2_keyed_matches_hashlib", blake2_keyed_matches_hashlib
+  ; "backends_agree", backends_agree
+  ; "to_hex_is_hex_of_raw", to_hex_is_hex_of_raw
+  ; "of_hex_opt_matches_docs", of_hex_opt_matches_docs
+  ; "consistent_of_hex_opt_matches_docs", consistent_of_hex_opt_matches_docs
+  ; "raw_string_roundtrip", raw_string_roundtrip
+  ; "compare_and_equal_are_string_order", compare_and_equal_are_string_order
+  ; "get_into_bytes_matches_get", get_into_bytes_matches_get
+  ; "blake3_xof_seeks_into_one_stream", blake3_xof_seeks_into_one_stream
+  ; "pin_consistent_of_hex_trailing_space", pin_consistent_of_hex_trailing_space
+  ]
+;;
+
+let main ~backend:name ~other:path =
+  if Array.length Sys.argv > 1 && String.equal Sys.argv.(1) "--serve"
+  then serve ()
+  else (
+    other := path;
+    Zoo.run (List.map (fun (n, t) -> name ^ "::" ^ n, t) tests))
+;;
diff --git a/hegel/zoo.ml b/hegel/zoo.ml
new file mode 100644
index 0000000..ce31977
--- /dev/null
+++ b/hegel/zoo.ml
@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
