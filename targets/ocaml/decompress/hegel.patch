new file mode 100644
index 0000000..ce31977
--- /dev/null
+++ b/hegel/zoo.ml
@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
diff --git a/hegel/zoo_tests.ml b/hegel/zoo_tests.ml
new file mode 100644
index 0000000..513a72a
--- /dev/null
+++ b/hegel/zoo_tests.ml
@@ -0,0 +1,891 @@
+open Hegel
+
+let script =
+  {|
+import sys, zlib, struct
+
+def h(s):
+    return None if s == "." else bytes.fromhex(s[1:])
+
+def x(b):
+    return "." if b is None else "v" + b.hex()
+
+def gz_header(text, hcrc, mtime, os_, extra, name, comment):
+    flg = (text and 1) | (hcrc and 2) | (extra is not None and 4) | (name is not None and 8) | (comment is not None and 16)
+    hd = bytes([0x1F, 0x8B, 8, flg]) + struct.pack("<I", mtime) + bytes([0, os_])
+    if extra is not None:
+        hd += struct.pack("<H", len(extra)) + extra
+    if name is not None:
+        hd += name + b"\0"
+    if comment is not None:
+        hd += comment + b"\0"
+    if hcrc:
+        hd += struct.pack("<H", zlib.crc32(hd) & 0xFFFF)
+    return hd
+
+def gz_parse(d):
+    if len(d) < 10 or d[:3] != b"\x1f\x8b\x08" or d[3] & 0xE0:
+        raise ValueError("header")
+    flg, mtime, os_, p = d[3], struct.unpack("<I", d[4:8])[0], d[9], 10
+    if flg & 4:
+        p += 2 + struct.unpack("<H", d[p:p + 2])[0]
+    name = comment = None
+    if flg & 8:
+        e = d.index(b"\0", p); name = d[p:e]; p = e + 1
+    if flg & 16:
+        e = d.index(b"\0", p); comment = d[p:e]; p = e + 1
+    if flg & 2:
+        if struct.unpack("<H", d[p:p + 2])[0] != zlib.crc32(d[:p]) & 0xFFFF:
+            raise ValueError("header crc")
+        p += 2
+    z = zlib.decompressobj(-15)
+    data = z.decompress(d[p:])
+    t = z.unused_data
+    if not z.eof or len(t) < 8:
+        raise ValueError("truncated")
+    if struct.unpack("<II", t[:8]) != (zlib.crc32(data), len(data) & 0xFFFFFFFF):
+        raise ValueError("trailer")
+    return [x(data), x(name), x(comment), str(os_), str(mtime), str(flg & 1)]
+
+for line in sys.stdin:
+    a = line.split()
+    try:
+        if a[0] == "deflate":
+            c = zlib.compressobj(int(a[2]), zlib.DEFLATED, int(a[1]), int(a[3]), getattr(zlib, a[4]))
+            out = x(c.compress(h(a[5])) + c.flush())
+        elif a[0] == "gzip":
+            level, mem, text, hcrc, mtime, os_ = map(int, [a[1], a[2]] + a[4:8])
+            strategy = getattr(zlib, a[3])
+            data = h(a[11])
+            c = zlib.compressobj(level, zlib.DEFLATED, -15, mem, strategy)
+            out = x(gz_header(text, hcrc, mtime, os_, h(a[8]), h(a[9]), h(a[10]))
+                    + c.compress(data) + c.flush()
+                    + struct.pack("<II", zlib.crc32(data), len(data) & 0xFFFFFFFF))
+        elif a[0] == "inflate":
+            z = zlib.decompressobj(int(a[1]))
+            data = z.decompress(h(a[2]))
+            out = "OK " + x(data) if z.eof else "E"
+        else:
+            out = " ".join(["OK"] + gz_parse(h(a[1])))
+    except Exception:
+        out = "E"
+    sys.stdout.write(out + "\n")
+    sys.stdout.flush()
+|}
+;;
+
+let python = lazy (Unix.open_process_args "python3" [| "python3"; "-c"; script |])
+
+let field = function
+  | None -> "."
+  | Some s ->
+    "v" ^ String.concat "" (List.init (String.length s) (fun k -> Printf.sprintf "%02x" (Char.code s.[k])))
+;;
+
+let unfield = function
+  | "." -> None
+  | f -> Some (String.init ((String.length f - 1) / 2) (fun k -> Char.chr (int_of_string ("0x" ^ String.sub f (1 + (2 * k)) 2))))
+;;
+
+let ask words =
+  let ic, oc = Lazy.force python in
+  output_string oc (String.concat " " words ^ "\n");
+  flush oc;
+  String.split_on_char ' ' (input_line ic)
+;;
+
+let deflate_py ~wbits ~level ~mem ~strategy data =
+  match ask [ "deflate"; string_of_int wbits; string_of_int level; string_of_int mem; strategy; field (Some data) ] with
+  | [ z ] -> Option.get (unfield z)
+  | _ -> failwith "python could not deflate"
+;;
+
+let inflate_py ~wbits z =
+  match ask [ "inflate"; string_of_int wbits; field (Some z) ] with
+  | [ "OK"; data ] -> unfield data
+  | _ -> None
+;;
+
+type gunzipped =
+  { data : string
+  ; name : string option
+  ; comment : string option
+  ; os : int
+  ; mtime : int
+  ; text : bool
+  }
+
+let gunzip_py z =
+  match ask [ "gunzip"; field (Some z) ] with
+  | [ "OK"; data; name; comment; os; mtime; text ] ->
+    Some
+      { data = Option.get (unfield data)
+      ; name = unfield name
+      ; comment = unfield comment
+      ; os = int_of_string os
+      ; mtime = int_of_string mtime
+      ; text = String.equal text "1"
+      }
+  | _ -> None
+;;
+
+let refill_from s =
+  let pos = ref 0
+  and ended = ref false in
+  fun b ->
+    if !ended then failwith "asks for input after the end of input";
+    let len = min (De.bigstring_length b) (String.length s - !pos) in
+    for k = 0 to len - 1 do
+      b.{k} <- s.[!pos + k]
+    done;
+    pos := !pos + len;
+    ended := len = 0;
+    len
+;;
+
+let drain out b len =
+  for k = 0 to len - 1 do
+    Buffer.add_char out b.{k}
+  done
+;;
+
+let bigstring_of_string s =
+  let b = De.bigstring_create (String.length s) in
+  ignore (refill_from s b);
+  b
+;;
+
+let string_of_bigstring b len =
+  let out = Buffer.create len in
+  drain out b len;
+  Buffer.contents out
+;;
+
+let collect f =
+  let out = Buffer.create 16 in
+  f (fun b len -> drain out b len);
+  Buffer.contents out
+;;
+
+let de_inflate ~ibuf ~obuf s =
+  let i = De.bigstring_create ibuf
+  and o = De.bigstring_create obuf in
+  let refill = refill_from s
+  and out = Buffer.create 16 in
+  let d = De.Inf.decoder `Manual ~o ~w:(De.make_window ~bits:15) in
+  let rec go () =
+    match De.Inf.decode d with
+    | `Await ->
+      De.Inf.src d i 0 (refill i);
+      go ()
+    | `Flush ->
+      drain out o (obuf - De.Inf.dst_rem d);
+      De.Inf.flush d;
+      go ()
+    | `End ->
+      drain out o (obuf - De.Inf.dst_rem d);
+      Ok (Buffer.contents out)
+    | `Malformed e -> Error e
+  in
+  go ()
+;;
+
+let gz_inflate ~ibuf ~obuf s =
+  let i = De.bigstring_create ibuf
+  and o = De.bigstring_create obuf in
+  let refill = refill_from s
+  and out = Buffer.create 16 in
+  let rec go d =
+    match Gz.Inf.decode d with
+    | `Await d -> go (Gz.Inf.src d i 0 (refill i))
+    | `Flush d ->
+      drain out o (obuf - Gz.Inf.dst_rem d);
+      go (Gz.Inf.flush d)
+    | `End d ->
+      drain out o (obuf - Gz.Inf.dst_rem d);
+      Ok (Buffer.contents out, d)
+    | `Malformed e -> Error e
+  in
+  go (Gz.Inf.decoder `Manual ~o)
+;;
+
+let zl_deflate ~level ~dynamic ~ibuf ~obuf ~qsize s =
+  let i = De.bigstring_create ibuf
+  and o = De.bigstring_create obuf in
+  let refill = refill_from s
+  and out = Buffer.create 16 in
+  let rec go e =
+    match Zl.Def.encode e with
+    | `Await e -> go (Zl.Def.src e i 0 (refill i))
+    | `Flush e ->
+      if Zl.Def.dst_rem e = obuf then failwith "Flush without writing to an empty output buffer";
+      drain out o (obuf - Zl.Def.dst_rem e);
+      go (Zl.Def.dst e o 0 obuf)
+    | `End e ->
+      drain out o (obuf - Zl.Def.dst_rem e);
+      Buffer.contents out
+  in
+  let e =
+    Zl.Def.encoder
+      ~dynamic
+      ~q:(De.Queue.create qsize)
+      ~w:(De.Lz77.make_window ~bits:15)
+      ~level
+      `Manual
+      `Manual
+  in
+  go (Zl.Def.dst e o 0 obuf)
+;;
+
+let gz_deflate ~level ~ascii ~hcrc ?filename ?comment ~mtime ~os ~ibuf ~obuf ~qsize s =
+  let i = De.bigstring_create ibuf
+  and o = De.bigstring_create obuf in
+  let refill = refill_from s
+  and out = Buffer.create 16 in
+  let rec go e =
+    match Gz.Def.encode e with
+    | `Await e -> go (Gz.Def.src e i 0 (refill i))
+    | `Flush e ->
+      if Gz.Def.dst_rem e = obuf then failwith "Flush without writing to an empty output buffer";
+      drain out o (obuf - Gz.Def.dst_rem e);
+      go (Gz.Def.dst e o 0 obuf)
+    | `End e ->
+      drain out o (obuf - Gz.Def.dst_rem e);
+      Buffer.contents out
+  in
+  let e =
+    Gz.Def.encoder
+      `Manual
+      `Manual
+      ~ascii
+      ~hcrc
+      ?filename
+      ?comment
+      ~mtime
+      os
+      ~q:(De.Queue.create qsize)
+      ~w:(De.Lz77.make_window ~bits:15)
+      ~level
+  in
+  go (Gz.Def.dst e o 0 obuf)
+;;
+
+let printed show g = with_printer (fun v -> Sexplib0.Sexp.Atom (show v)) g
+
+let show_bytes s =
+  if String.length s <= 80
+  then Printf.sprintf "%S" s
+  else Printf.sprintf "%d bytes %S..." (String.length s) (String.sub s 0 48)
+;;
+
+let noise seed n =
+  let st = Random.State.make [| seed |] in
+  String.init n (fun _ -> Char.chr (Random.State.int st 256))
+;;
+
+let piece =
+  one_of
+    [ binary ~max_size:64 ()
+    ; printed
+        show_bytes
+        (map
+           (fun (unit, n) -> String.concat "" (List.init n (Fun.const unit)))
+           (tuples2 (binary ~min_size:1 ~max_size:8 ()) (integers ~min_value:1 ~max_value:400 ())))
+    ; printed
+        show_bytes
+        (map
+           (fun ((x, gap), seed) -> x ^ noise seed gap ^ x)
+           (tuples2
+              (tuples2
+                 (binary ~min_size:3 ~max_size:300 ())
+                 (integers ~min_value:32_400 ~max_value:32_800 ()))
+              (integers ())))
+    ]
+;;
+
+let known_first shapes plain = one_of ((if Zoo.known then shapes else []) @ [ plain ])
+let data = printed show_bytes (map (String.concat "") (lists piece ~max_size:4 ()))
+let levels = integers ~min_value:0 ~max_value:9 ()
+let mem_levels = integers ~min_value:1 ~max_value:9 ()
+
+let strategies =
+  printed Fun.id (sampled_from [ "Z_DEFAULT_STRATEGY"; "Z_FILTERED"; "Z_HUFFMAN_ONLY"; "Z_RLE"; "Z_FIXED" ])
+let window_bits = integers ~min_value:9 ~max_value:15 ()
+
+let buffer_sizes ~min =
+  one_of
+    [ printed string_of_int (just De.io_buffer_size)
+    ; integers ~min_value:min ~max_value:64 ()
+    ]
+;;
+
+let queue_sizes = printed string_of_int (map (fun k -> 1 lsl k) (integers ~min_value:1 ~max_value:12 ()))
+let mtimes = known_first [ integers ~min_value:1 ~max_value:0xFFFF_FFFF () ] (printed string_of_int (just 0))
+let hcrcs = known_first [ printed string_of_bool (just true) ] (printed string_of_bool (just false))
+let header_strings = filter (fun s -> not (String.contains s '\000')) (binary ~max_size:16 ())
+
+let os_numbers =
+  Gz.
+    [ FAT, 0
+    ; Amiga, 1
+    ; VMS, 2
+    ; Unix, 3
+    ; VM, 4
+    ; Atari, 5
+    ; HPFS, 6
+    ; Macintosh, 7
+    ; Z, 8
+    ; CPM, 9
+    ; TOPS20, 10
+    ; NTFS, 11
+    ; QDOS, 12
+    ; Acorn, 13
+    ; Unknown, 255
+    ]
+;;
+
+let oses = printed (fun os -> Format.asprintf "%a" Gz.pp_os os) (sampled_from (List.map fst os_numbers))
+
+let subfield = tuples2 (binary ~min_size:2 ~max_size:2 ()) (binary ~min_size:1 ~max_size:12 ())
+
+let show_extra = function
+  | None -> "none"
+  | Some l -> String.concat "," (List.map (fun (k, v) -> Printf.sprintf "%S=%d bytes" k (String.length v)) l)
+;;
+
+(* XLEN is 4 + 253 = 257 = 0x0101, which reads the same in either byte order *)
+let extras =
+  known_first
+    [ printed show_extra (map (fun kv -> Some [ kv ]) subfield)
+    ; printed
+        show_extra
+        (map (fun k -> Some [ k, String.make 253 'x' ]) (binary ~min_size:2 ~max_size:2 ()))
+    ]
+    (printed show_extra (optional (printed (fun _ -> "[]") (just []))))
+;;
+
+let extra_payload subfields =
+  String.concat
+    ""
+    (List.map
+       (fun (k, v) ->
+          let len = Bytes.create 2 in
+          Bytes.set_uint16_le len 0 (String.length v);
+          k ^ Bytes.to_string len ^ v)
+       subfields)
+;;
+
+let mismatch what ours theirs =
+  if not (String.equal ours theirs)
+  then
+    Printf.ksprintf
+      failwith
+      "%s: %d bytes, expected %d (%s vs %s)"
+      what
+      (String.length ours)
+      (String.length theirs)
+      (show_bytes ours)
+      (show_bytes theirs)
+;;
+
+let%hegel_test inflate_raw_from_python tc =
+  let data = draw tc data in
+  let wbits = draw tc window_bits in
+  let level = draw tc levels in
+  let mem = draw tc mem_levels in
+  let strategy = draw tc strategies in
+  let ibuf = draw tc (buffer_sizes ~min:1) in
+  let obuf = draw tc (buffer_sizes ~min:1) in
+  match de_inflate ~ibuf ~obuf (deflate_py ~wbits:(-wbits) ~level ~mem ~strategy data) with
+  | Ok out -> mismatch "inflated" out data
+  | Error e -> Printf.ksprintf failwith "Malformed %s" e
+;;
+
+let%hegel_test inflate_zlib_from_python tc =
+  let data = draw tc data in
+  let wbits = draw tc window_bits in
+  let level = draw tc levels in
+  let mem = draw tc mem_levels in
+  let strategy = draw tc strategies in
+  let ibuf = draw tc (buffer_sizes ~min:1) in
+  let obuf = draw tc (buffer_sizes ~min:1) in
+  let z = deflate_py ~wbits ~level ~mem ~strategy data in
+  let refill = refill_from z in
+  let allocate bits = De.make_window ~bits in
+  let out = ref (Ok ()) in
+  let inflated =
+    collect (fun flush ->
+      out
+      := Zl.Higher.uncompress
+           ~allocate
+           ~refill
+           ~flush
+           (De.bigstring_create ibuf)
+           (De.bigstring_create obuf))
+  in
+  match !out with
+  | Ok () -> mismatch "inflated" inflated data
+  | Error (`Msg e) -> Printf.ksprintf failwith "Error %s" e
+;;
+
+let%hegel_test inflate_gzip_from_python tc =
+  let data = draw tc data in
+  let level = draw tc levels in
+  let mem = draw tc mem_levels in
+  let strategy = draw tc strategies in
+  let text = draw tc (booleans ()) in
+  let hcrc = draw tc hcrcs in
+  let mtime = draw tc (integers ~min_value:0 ~max_value:0xFFFF_FFFF ()) in
+  let os = draw tc (integers ~min_value:0 ~max_value:255 ()) in
+  let extra = draw tc extras in
+  let name = draw tc (optional header_strings) in
+  let comment = draw tc (optional header_strings) in
+  let terminated = Option.fold ~none:0 ~some:(fun s -> String.length s + 1) in
+  let header =
+    10
+    + Option.fold ~none:0 ~some:(fun l -> 2 + String.length (extra_payload l)) extra
+    + terminated name
+    + terminated comment
+    + if hcrc then 2 else 0
+  in
+  let ibuf =
+    draw
+      tc
+      (known_first
+         [ integers ~min_value:1 ~max_value:header () ]
+         (one_of
+            [ printed string_of_int (just De.io_buffer_size)
+            ; integers ~min_value:(header + 1) ~max_value:(header + 64) ()
+            ]))
+  in
+  let obuf = draw tc (buffer_sizes ~min:1) in
+  let z =
+    match
+      ask
+        [ "gzip"
+        ; string_of_int level
+        ; string_of_int mem
+        ; strategy
+        ; (if text then "1" else "0")
+        ; (if hcrc then "1" else "0")
+        ; string_of_int mtime
+        ; string_of_int os
+        ; field (Option.map extra_payload extra)
+        ; field name
+        ; field comment
+        ; field (Some data)
+        ]
+    with
+    | [ z ] -> Option.get (unfield z)
+    | _ -> failwith "python could not gzip"
+  in
+  match gz_inflate ~ibuf ~obuf z with
+  | Error e -> Printf.ksprintf failwith "Malformed %s" e
+  | Ok (out, d) ->
+    mismatch "inflated" out data;
+    if not (Option.equal String.equal (Gz.Inf.filename d) name)
+    then failwith "filename differs";
+    if not (Option.equal String.equal (Gz.Inf.comment d) comment)
+    then failwith "comment differs";
+    let expected_os =
+      Option.value
+        (List.find_map (fun (o, n) -> if n = os then Some o else None) os_numbers)
+        ~default:Gz.Unknown
+    in
+    if not (Gz.equal_os (Gz.Inf.os d) expected_os) then failwith "os differs";
+    List.iter
+      (fun (key, _) ->
+         let expected = List.assoc_opt key (Option.value extra ~default:[]) in
+         let got = Gz.Inf.extra ~key d in
+         if not (Option.equal String.equal got expected)
+         then
+           Printf.ksprintf
+             failwith
+             "extra %S is %s, expected %s"
+             key
+             (Option.fold ~none:"absent" ~some:(Printf.sprintf "%S") got)
+             (Option.fold ~none:"absent" ~some:(Printf.sprintf "%S") expected))
+      (Option.value extra ~default:[])
+;;
+
+let%hegel_test python_inflates_de tc =
+  let data = draw tc data in
+  let ibuf = draw tc (buffer_sizes ~min:1) in
+  let obuf = draw tc (buffer_sizes ~min:2) in
+  let qsize = draw tc queue_sizes in
+  let z =
+    collect (fun flush ->
+      De.Higher.compress
+        ~w:(De.Lz77.make_window ~bits:15)
+        ~q:(De.Queue.create qsize)
+        ~refill:(refill_from data)
+        ~flush
+        (De.bigstring_create ibuf)
+        (De.bigstring_create obuf))
+  in
+  match inflate_py ~wbits:(-15) z with
+  | Some out -> mismatch "python inflated" out data
+  | None -> Printf.ksprintf failwith "python rejects %s" (show_bytes z)
+;;
+
+let%hegel_test python_inflates_zl tc =
+  let data = draw tc data in
+  let level = draw tc levels in
+  let dynamic = draw tc (booleans ()) in
+  let ibuf = draw tc (buffer_sizes ~min:1) in
+  let obuf = draw tc (known_first [ integers ~min_value:2 ~max_value:3 () ] (buffer_sizes ~min:4)) in
+  let qsize = draw tc queue_sizes in
+  let z = zl_deflate ~level ~dynamic ~ibuf ~obuf ~qsize data in
+  match inflate_py ~wbits:15 z with
+  | Some out -> mismatch "python inflated" out data
+  | None -> Printf.ksprintf failwith "python rejects %s" (show_bytes z)
+;;
+
+let%hegel_test python_inflates_gz tc =
+  let data = draw tc data in
+  let level = draw tc levels in
+  let ascii = draw tc (booleans ()) in
+  let hcrc = draw tc hcrcs in
+  let filename = draw tc (optional header_strings) in
+  let comment = draw tc (optional header_strings) in
+  let mtime = draw tc mtimes in
+  let os = draw tc oses in
+  let ibuf = draw tc (buffer_sizes ~min:1) in
+  let header =
+    let terminated = Option.fold ~none:0 ~some:(fun s -> String.length s + 1) in
+    10 + terminated filename + terminated comment + if hcrc then 2 else 0
+  in
+  let obuf =
+    draw tc (known_first [ integers ~min_value:2 ~max_value:(header - 1) () ] (buffer_sizes ~min:header))
+  in
+  let qsize = draw tc queue_sizes in
+  let z =
+    gz_deflate
+      ~level
+      ~ascii
+      ~hcrc
+      ?filename
+      ?comment
+      ~mtime:(Int32.of_int mtime)
+      ~os
+      ~ibuf
+      ~obuf
+      ~qsize
+      data
+  in
+  match gunzip_py z with
+  | None -> Printf.ksprintf failwith "python rejects %s" (show_bytes z)
+  | Some g ->
+    mismatch "python inflated" g.data data;
+    if not (Option.equal String.equal g.name filename) then failwith "filename differs";
+    if not (Option.equal String.equal g.comment comment) then failwith "comment differs";
+    if g.os <> List.assoc os os_numbers then failwith "os differs";
+    if g.mtime <> mtime then Printf.ksprintf failwith "mtime is %d" g.mtime;
+    if g.text <> ascii then failwith "FTEXT differs"
+;;
+
+let%hegel_test ns_inflate_from_python tc =
+  let data = draw tc data in
+  let level = draw tc levels in
+  let strategy = draw tc strategies in
+  let z = deflate_py ~wbits:(-15) ~level ~mem:8 ~strategy data in
+  let dst = De.bigstring_create (max (String.length data) (String.length z)) in
+  match De.Inf.Ns.inflate (bigstring_of_string z) dst with
+  | Ok (read, written) ->
+    if read <> String.length z
+    then Printf.ksprintf failwith "read %d of %d bytes" read (String.length z);
+    mismatch "inflated" (string_of_bigstring dst written) data
+  | Error e -> Printf.ksprintf failwith "%s" (Format.asprintf "%a" De.Inf.Ns.pp_error e)
+;;
+
+let ns_inputs =
+  known_first
+    [ tuples2
+        (integers ~min_value:5 ~max_value:9 ())
+        (printed
+           show_bytes
+           (map (fun (c, n) -> String.make n c) (tuples2 (chars ()) (integers ~min_value:40 ~max_value:300 ()))))
+    ; tuples2
+        (integers ~min_value:0 ~max_value:4 ())
+        (printed
+           show_bytes
+           (map (fun (seed, n) -> noise seed n) (tuples2 (integers ()) (integers ~min_value:56 ~max_value:300 ()))))
+    ]
+    (tuples2 (integers ~min_value:2 ~max_value:4 ()) data)
+;;
+
+let%hegel_test python_inflates_ns tc =
+  let level, data = draw tc ns_inputs in
+  let dst = De.bigstring_create (De.Def.Ns.compress_bound (String.length data)) in
+  match De.Def.Ns.deflate ~level (bigstring_of_string data) dst with
+  | Error e -> Printf.ksprintf failwith "%s" (Format.asprintf "%a" De.Def.Ns.pp_error e)
+  | Ok len ->
+    let z = string_of_bigstring dst len in
+    (match inflate_py ~wbits:(-15) z with
+     | Some out -> mismatch "python inflated" out data
+     | None -> Printf.ksprintf failwith "python rejects %s" (show_bytes z))
+;;
+
+let gzip_py data =
+  match
+    ask [ "gzip"; "6"; "8"; "Z_DEFAULT_STRATEGY"; "0"; "0"; "0"; "3"; "."; "."; "."; field (Some data) ]
+  with
+  | [ z ] -> Option.get (unfield z)
+  | _ -> failwith "python could not gzip"
+;;
+
+let gz_decode s =
+  let o = De.bigstring_create De.io_buffer_size in
+  let out = Buffer.create 16 in
+  let rec go d =
+    match Gz.Inf.decode d with
+    | `Await _ -> failwith "awaits more input from a string source"
+    | `Flush d ->
+      drain out o (De.io_buffer_size - Gz.Inf.dst_rem d);
+      go (Gz.Inf.flush d)
+    | `End d ->
+      drain out o (De.io_buffer_size - Gz.Inf.dst_rem d);
+      Buffer.contents out, d
+    | `Malformed e -> Printf.ksprintf failwith "Malformed %s" e
+  in
+  go (Gz.Inf.decoder (`String s) ~o)
+;;
+
+let%hegel_test gzip_member_leaves_rest tc =
+  let first = draw tc data in
+  let second = draw tc data in
+  let rest = gzip_py second in
+  let out, d = gz_decode (gzip_py first ^ rest) in
+  mismatch "first member" out first;
+  if Gz.Inf.src_rem d <> String.length rest
+  then Printf.ksprintf failwith "%d bytes left, the second member is %d" (Gz.Inf.src_rem d) (String.length rest)
+;;
+
+let flip z (at, v) = String.mapi (fun k c -> if k = at then Char.chr (Char.code c lxor v) else c) z
+
+let show_corruption = function
+  | `Truncate at -> Printf.sprintf "truncate at %d" at
+  | `Flip (at, v) -> Printf.sprintf "xor byte %d with 0x%02x" at v
+;;
+
+let corruptions ?(shapes = []) z tc =
+  let positions = integers ~min_value:0 ~max_value:(max 0 (String.length z - 1)) () in
+  let plain =
+    printed
+      show_corruption
+      (one_of
+         [ printed show_corruption (map (fun at -> `Truncate at) positions)
+         ; printed
+             show_corruption
+             (map (fun f -> `Flip f) (tuples2 positions (integers ~min_value:1 ~max_value:255 ())))
+         ])
+  in
+  match draw tc (known_first shapes plain) with
+  | `Truncate at -> String.sub z 0 at
+  | `Flip f -> flip z f
+;;
+
+let agree ours theirs =
+  match ours, theirs with
+  | Some a, Some b -> mismatch "inflated" a b
+  | None, None -> ()
+  | Some a, None -> Printf.ksprintf failwith "accepted (%s) what python rejects" (show_bytes a)
+  | None, Some _ -> failwith "rejected what python accepts"
+;;
+
+let header_flips g = printed show_corruption (map (fun f -> `Flip f) g)
+
+let%hegel_test corrupt_raw_agrees_with_zlib tc =
+  let data = draw tc data in
+  let level = draw tc (known_first [ printed string_of_int (just 0) ] (printed string_of_int (just 6))) in
+  let z = deflate_py ~wbits:(-15) ~level ~mem:8 ~strategy:"Z_DEFAULT_STRATEGY" data in
+  (* past a stored block's 5-byte header *)
+  let shapes =
+    if level = 0 && String.length z > 5
+    then
+      [ printed
+          show_corruption
+          (map (fun at -> `Truncate at) (integers ~min_value:5 ~max_value:(String.length z - 1) ()))
+      ]
+    else []
+  in
+  let bad = corruptions ~shapes z tc in
+  let ibuf = draw tc (buffer_sizes ~min:1) in
+  let obuf = draw tc (buffer_sizes ~min:1) in
+  let ours = Result.to_option (de_inflate ~ibuf ~obuf bad) in
+  agree ours (inflate_py ~wbits:(-15) bad)
+;;
+
+let%hegel_test corrupt_zlib_agrees_with_zlib tc =
+  let data = draw tc data in
+  let z = deflate_py ~wbits:15 ~level:6 ~mem:8 ~strategy:"Z_DEFAULT_STRATEGY" data in
+  (* CINFO is the high nibble of the first byte *)
+  let bad =
+    corruptions
+      ~shapes:[ header_flips (tuples2 (printed string_of_int (just 0)) (integers ~min_value:0x80 ~max_value:0xF0 ())) ]
+      z
+      tc
+  in
+  let refill = refill_from bad in
+  let res = ref (Ok ()) in
+  let out =
+    collect (fun flush ->
+      res
+      := Zl.Higher.uncompress
+           ~allocate:(fun bits -> De.make_window ~bits)
+           ~refill
+           ~flush
+           (De.bigstring_create De.io_buffer_size)
+           (De.bigstring_create De.io_buffer_size))
+  in
+  agree (Result.to_option (Result.map (fun () -> out) !res)) (inflate_py ~wbits:15 bad)
+;;
+
+let%hegel_test corrupt_gzip_agrees_with_zlib tc =
+  let data = draw tc data in
+  let bad =
+    corruptions
+      ~shapes:
+        [ header_flips
+            (one_of
+               [ tuples2 (printed string_of_int (just 2)) (integers ~min_value:1 ~max_value:255 ())
+               ; tuples2 (printed string_of_int (just 3)) (printed string_of_int (sampled_from [ 0x20; 0x40; 0x80 ]))
+               ])
+        ]
+      (gzip_py data)
+      tc
+  in
+  let ours = Result.to_option (Result.map fst (gz_inflate ~ibuf:De.io_buffer_size ~obuf:De.io_buffer_size bad)) in
+  agree ours (Option.map (fun g -> g.data) (gunzip_py bad))
+;;
+
+let%hegel_test lzo_roundtrip tc =
+  let data = draw tc data in
+  let n = String.length data in
+  let dst = De.bigstring_create (n + (n / 16) + 64 + 3) in
+  let len = Lzo.compress (bigstring_of_string data) dst (Lzo.make_wrkmem ()) in
+  match Lzo.uncompress_with_buffer (Bigarray.Array1.sub dst 0 len) with
+  | Ok out -> mismatch "decompressed" out data
+  | Error e -> Printf.ksprintf failwith "%s" (Format.asprintf "%a" Lzo.pp_error e)
+;;
+
+(* a stored block of "hello", then its CRC-32 and size *)
+let hello_member flg header_tail =
+  "\x1f\x8b\x08" ^ String.make 1 (Char.chr flg) ^ "\x00\x00\x00\x00\x00\x03" ^ header_tail
+  ^ "\x01\x05\x00\xfa\xffhello\x86\xa6\x10\x36\x05\x00\x00\x00"
+;;
+
+let expect_extra member value =
+  let out, d = gz_decode member in
+  mismatch "inflated" out "hello";
+  match Gz.Inf.extra ~key:"AB" d with
+  | Some v -> mismatch "extra AB" v value
+  | None -> failwith "extra AB is absent"
+;;
+
+let pin_xlen_little_endian () = expect_extra (hello_member 4 "\x05\x00AB\x01\x00x") "x"
+
+let pin_subfield_len_little_endian () =
+  expect_extra (hello_member 4 ("\x01\x01AB\xfd\x00" ^ String.make 253 'y')) (String.make 253 'y')
+;;
+
+let pin_header_crc_accepted () = mismatch "inflated" (fst (gz_decode (hello_member 2 "\xa7\x77"))) "hello"
+
+let encoded_header ~hcrc ~mtime =
+  String.sub (gz_deflate ~level:6 ~ascii:false ~hcrc ~mtime ~os:Gz.Unix ~ibuf:64 ~obuf:64 ~qsize:4096 "") 0 12
+;;
+
+let pin_header_crc_written () =
+  mismatch "header" (encoded_header ~hcrc:true ~mtime:0l) "\x1f\x8b\x08\x02\x00\x00\x00\x00\x00\x03\xa7\x77"
+;;
+
+let pin_mtime_little_endian () =
+  mismatch "mtime" (String.sub (encoded_header ~hcrc:false ~mtime:0x01020304l) 4 4) "\x04\x03\x02\x01"
+;;
+
+let pin_zl_two_byte_output_buffer () =
+  ignore (zl_deflate ~level:6 ~dynamic:true ~ibuf:64 ~obuf:2 ~qsize:4096 "")
+;;
+
+let pin_gz_header_larger_than_output_buffer () =
+  ignore (gz_deflate ~level:6 ~ascii:false ~hcrc:false ~mtime:0l ~os:Gz.Unix ~ibuf:64 ~obuf:9 ~qsize:4096 "")
+;;
+
+let pin_compress_bound_level_0 () =
+  let src = noise 1 56 in
+  let dst = De.bigstring_create (De.Def.Ns.compress_bound (String.length src)) in
+  match De.Def.Ns.deflate ~level:0 (bigstring_of_string src) dst with
+  | Ok _ -> ()
+  | Error e -> Printf.ksprintf failwith "%s" (Format.asprintf "%a" De.Def.Ns.pp_error e)
+;;
+
+let pin_ns_level_5_writes_the_data () =
+  let src = String.make 100 'a' in
+  let dst = De.bigstring_create (De.Def.Ns.compress_bound 100) in
+  match De.Def.Ns.deflate ~level:5 (bigstring_of_string src) dst with
+  | Error e -> Printf.ksprintf failwith "%s" (Format.asprintf "%a" De.Def.Ns.pp_error e)
+  | Ok len ->
+    (match inflate_py ~wbits:(-15) (string_of_bigstring dst len) with
+     | Some out -> mismatch "python inflated" out src
+     | None -> Printf.ksprintf failwith "python rejects the %d bytes written" len)
+;;
+
+let pin_cinfo_above_7_is_malformed () =
+  let o = De.bigstring_create De.io_buffer_size in
+  let rec go d =
+    match Zl.Inf.decode d with
+    | `Malformed _ -> ()
+    | `Await _ | `End _ -> failwith "accepted CINFO 15"
+    | `Flush d -> go (Zl.Inf.flush d)
+  in
+  go (Zl.Inf.decoder (`String "\xf8\x00\x03\x00\x00\x00\x00\x01") ~o ~allocate:(fun bits -> De.make_window ~bits))
+;;
+
+let pin_stored_block_cut_after_header () =
+  match de_inflate ~ibuf:64 ~obuf:64 "\x01\x05\x00\xfa\xff" with
+  | Error _ -> ()
+  | Ok _ -> failwith "accepted a truncated stored block"
+;;
+
+let pin_gzip_header_in_one_byte_chunks () =
+  match gz_inflate ~ibuf:1 ~obuf:64 (hello_member 0 "") with
+  | Ok (out, _) -> mismatch "inflated" out "hello"
+  | Error e -> Printf.ksprintf failwith "Malformed %s" e
+;;
+
+let pin_gzip_cm_checked () =
+  match gz_decode (String.mapi (fun k c -> if k = 2 then '\x09' else c) (hello_member 0 "")) with
+  | exception Failure _ -> ()
+  | _ -> failwith "accepted CM 9"
+;;
+
+let () =
+  Zoo.run
+    [ "inflate_raw_from_python", inflate_raw_from_python
+    ; "inflate_zlib_from_python", inflate_zlib_from_python
+    ; "inflate_gzip_from_python", inflate_gzip_from_python
+    ; "python_inflates_de", python_inflates_de
+    ; "python_inflates_zl", python_inflates_zl
+    ; "python_inflates_gz", python_inflates_gz
+    ; "ns_inflate_from_python", ns_inflate_from_python
+    ; "python_inflates_ns", python_inflates_ns
+    ; "gzip_member_leaves_rest", gzip_member_leaves_rest
+    ; "corrupt_raw_agrees_with_zlib", corrupt_raw_agrees_with_zlib
+    ; "corrupt_zlib_agrees_with_zlib", corrupt_zlib_agrees_with_zlib
+    ; "corrupt_gzip_agrees_with_zlib", corrupt_gzip_agrees_with_zlib
+    ; "lzo_roundtrip", lzo_roundtrip
+    ; "pin_xlen_little_endian", pin_xlen_little_endian
+    ; "pin_subfield_len_little_endian", pin_subfield_len_little_endian
+    ; "pin_header_crc_accepted", pin_header_crc_accepted
+    ; "pin_header_crc_written", pin_header_crc_written
+    ; "pin_mtime_little_endian", pin_mtime_little_endian
+    ; "pin_zl_two_byte_output_buffer", pin_zl_two_byte_output_buffer
+    ; "pin_gz_header_larger_than_output_buffer", pin_gz_header_larger_than_output_buffer
+    ; "pin_compress_bound_level_0", pin_compress_bound_level_0
+    ; "pin_cinfo_above_7_is_malformed", pin_cinfo_above_7_is_malformed
+    ; "pin_ns_level_5_writes_the_data", pin_ns_level_5_writes_the_data
+    ; "pin_gzip_cm_checked", pin_gzip_cm_checked
+    ; "pin_stored_block_cut_after_header", pin_stored_block_cut_after_header
+    ; "pin_gzip_header_in_one_byte_chunks", pin_gzip_header_in_one_byte_chunks
+    ]
+;;
