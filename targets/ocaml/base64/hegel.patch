diff --git a/hegel/zoo.ml b/hegel/zoo.ml
new file mode 100644
index 0000000..ce31977
--- /dev/null
+++ b/hegel/zoo.ml
@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
diff --git a/hegel/zoo_tests.ml b/hegel/zoo_tests.ml
new file mode 100644
index 0000000..6aca63f
--- /dev/null
+++ b/hegel/zoo_tests.ml
@@ -0,0 +1,292 @@
+open Hegel
+
+let python_oracle =
+  {|
+import base64, binascii, sys
+
+def read():
+    n = int(sys.stdin.buffer.readline())
+    return sys.stdin.buffer.read(n)
+
+def mime(data, width):
+    enc = base64.b64encode(data)
+    return b"\r\n".join(enc[i:i + width] for i in range(0, len(enc), width))
+
+while True:
+    op = sys.stdin.buffer.readline().strip()
+    if not op:
+        break
+    if op == b"encode":
+        data, urlsafe, pad = read(), read() == b"1", read() == b"1"
+        out = (base64.urlsafe_b64encode if urlsafe else base64.b64encode)(data)
+        out = out if pad else out.rstrip(b"=")
+    elif op == b"decode":
+        try:
+            out = binascii.a2b_base64(read(), strict_mode=True)
+        except binascii.Error:
+            sys.stdout.buffer.write(b"ERR\n")
+            sys.stdout.buffer.flush()
+            continue
+    elif op == b"mime":
+        data, width = read(), int(read())
+        out = mime(data, width)
+    sys.stdout.buffer.write(b"OK %d\n" % len(out) + out)
+    sys.stdout.buffer.flush()
+|}
+;;
+
+let python = lazy (Unix.open_process_args "python3" [| "python3"; "-c"; python_oracle |])
+
+let ask op args =
+  let ic, oc = Lazy.force python in
+  output_string oc (op ^ "\n");
+  List.iter (fun a -> Printf.fprintf oc "%d\n%s" (String.length a) a) args;
+  flush oc;
+  match String.split_on_char ' ' (input_line ic) with
+  | [ "ERR" ] -> None
+  | [ "OK"; n ] -> Some (really_input_string ic (int_of_string n))
+  | _ -> failwith "python oracle: bad reply"
+;;
+
+let ask_exn op args = Option.get (ask op args)
+let printed show g = with_printer (fun x -> Sexplib0.Sexp.Atom (show x)) g
+let quoted g = printed Fun.id g
+
+let standard = Base64.alphabet Base64.default_alphabet
+
+(* '=' is the padding character, so no alphabet may contain it *)
+let custom_alphabet =
+  map
+    (fun codes ->
+       String.of_seq (List.to_seq (List.map (fun c -> Char.chr (if c >= 61 then c + 1 else c)) codes)))
+    (lists (integers ~min_value:0 ~max_value:254 ()) ~min_size:64 ~max_size:64 ~unique:true ())
+  |> quoted
+;;
+
+let alphabets =
+  one_of
+    [ just Base64.default_alphabet |> printed (fun _ -> "default")
+    ; just Base64.uri_safe_alphabet |> printed (fun _ -> "uri_safe")
+    ; map Base64.make_alphabet custom_alphabet |> printed (fun a -> Printf.sprintf "%S" (Base64.alphabet a))
+    ]
+;;
+
+let to_standard alphabet s =
+  let a = Base64.alphabet alphabet in
+  String.map
+    (fun c ->
+       match String.index_opt a c with
+       | Some i -> standard.[i]
+       | None -> if c = '=' then '=' else '\000')
+    s
+;;
+
+let of_standard alphabet s =
+  let a = Base64.alphabet alphabet in
+  String.map (fun c -> Option.fold ~none:c ~some:(String.get a) (String.index_opt standard c)) s
+;;
+
+let data = binary ~max_size:40 ()
+
+let%hegel_test encode_agrees_with_python tc =
+  let s = draw tc data in
+  let off = draw tc (integers ~min_value:0 ~max_value:(String.length s) ()) in
+  let len = draw tc (integers ~min_value:0 ~max_value:(String.length s - off) ()) in
+  let urlsafe = draw tc (booleans ()) in
+  let pad = draw tc (booleans ()) in
+  let alphabet = if urlsafe then Base64.uri_safe_alphabet else Base64.default_alphabet in
+  let ours = Base64.encode_exn ~pad ~alphabet ~off ~len s in
+  let theirs =
+    ask_exn "encode" [ String.sub s off len; (if urlsafe then "1" else "0"); (if pad then "1" else "0") ]
+  in
+  if not (String.equal ours theirs) then Printf.ksprintf failwith "encodes to %S, python %S" ours theirs
+;;
+
+let%hegel_test custom_alphabet_encode_agrees_with_python tc =
+  let alphabet = Base64.make_alphabet (draw tc custom_alphabet) in
+  let s = draw tc data in
+  let ours = Base64.encode_string ~alphabet s in
+  let theirs = of_standard alphabet (ask_exn "encode" [ s; "0"; "1" ]) in
+  if not (String.equal ours theirs) then Printf.ksprintf failwith "encodes to %S, python %S" ours theirs
+;;
+
+let%hegel_test decode_inverts_encode tc =
+  let alphabet = draw tc alphabets in
+  let pad = draw tc (booleans ()) in
+  let s = draw tc data in
+  let e = Base64.encode_string ~pad ~alphabet s in
+  match Base64.decode ~pad ~alphabet e with
+  | Ok d when String.equal d s -> ()
+  | Ok d -> Printf.ksprintf failwith "%S decodes to %S" e d
+  | Error (`Msg m) -> Printf.ksprintf failwith "%S does not decode: %s" e m
+;;
+
+let known_shape s =
+  let n = String.length s in
+  let rec start i = if i > 0 && s.[i - 1] = '=' then start (i - 1) else i in
+  let body = start n in
+  let run = n - body in
+  (run >= 4 && body mod 4 = 0) || (run = 3 && body mod 4 = 1)
+;;
+
+let whole s = String.sub s 0 (String.length s / 3 * 3)
+let encoded = map Base64.encode_string data |> quoted
+
+let mutated =
+  let at f =
+    map (fun (e, i) -> f e (i mod (String.length e + 1))) (tuples2 encoded (integers ~min_value:0 ~max_value:200 ()))
+    |> quoted
+  in
+  let insert c = at (fun e i -> String.sub e 0 i ^ c ^ String.sub e i (String.length e - i)) in
+  one_of
+    [ encoded
+    ; map (fun e -> String.concat "" (String.split_on_char '=' e)) encoded |> quoted
+    ; map (fun (e, k) -> e ^ String.make k '=') (tuples2 encoded (integers ~min_value:1 ~max_value:8 ())) |> quoted
+    ; at (fun e i -> String.sub e 0 i)
+    ; insert "="
+    ; insert "\n"
+    ; insert " "
+    ; insert "*"
+    ; map (fun (e, f) -> e ^ f) (tuples2 encoded (text ~alphabet:"AZaz09+/=" ~min_size:1 ~max_size:4 ())) |> quoted
+    ]
+;;
+
+(* the known shape first at a fifth of the draws, so every run reaches it *)
+let known_first shape plain = if Zoo.known then one_of (shape :: List.init 4 (fun _ -> plain)) else plain
+
+let padding_quantum = map (fun s -> Base64.encode_string (whole s) ^ "====") data |> quoted
+
+let outcome = Option.fold ~none:"an error" ~some:(Printf.sprintf "%S")
+
+let%hegel_test decode_agrees_with_python tc =
+  let alphabet = draw tc alphabets in
+  let candidate = draw tc (known_first padding_quantum mutated) in
+  let s = of_standard alphabet candidate in
+  if not Zoo.known then assume tc (not (known_shape s));
+  let ours = Result.to_option (Base64.decode ~alphabet s) in
+  let theirs = ask "decode" [ to_standard alphabet s ] in
+  if not (Option.equal String.equal ours theirs)
+  then Printf.ksprintf failwith "decodes to %s, python %s" (outcome ours) (outcome theirs)
+;;
+
+let data_char = map (fun i -> String.make 1 standard.[i]) (integers ~min_value:0 ~max_value:63 ()) |> quoted
+let quantum_char = one_of [ data_char; just "=" |> quoted ]
+let final_quantum = map (String.concat "") (lists quantum_char ~min_size:4 ~max_size:4 ()) |> quoted
+let single_character_quantum = map (fun c -> c ^ "===") data_char |> quoted
+
+let%hegel_test final_quantum_agrees_with_python tc =
+  let prefix = draw tc (map (fun s -> Base64.encode_string (whole s)) data |> quoted) in
+  let quantum = draw tc (known_first single_character_quantum final_quantum) in
+  let s = prefix ^ quantum in
+  if not Zoo.known then assume tc (not (known_shape s));
+  let ours = Result.to_option (Base64.decode s) in
+  let theirs = ask "decode" [ s ] in
+  if not (Option.equal String.equal ours theirs)
+  then Printf.ksprintf failwith "decodes to %s, python %s" (outcome ours) (outcome theirs)
+;;
+
+let%hegel_test unpadded_decode_inverts_encode tc =
+  let alphabet = draw tc alphabets in
+  let s = draw tc data in
+  let k = draw tc (integers ~min_value:0 ~max_value:6 ()) in
+  let e = Base64.encode_string ~pad:false ~alphabet s ^ String.make k '=' in
+  match Base64.decode ~pad:false ~alphabet e with
+  | Ok d when String.equal d s -> ()
+  | Ok d -> Printf.ksprintf failwith "%S decodes to %S" e d
+  | Error (`Msg m) -> Printf.ksprintf failwith "%S does not decode: %s" e m
+;;
+
+(* past 57 bytes, so the encoded lines wrap *)
+let long_data = one_of [ data; binary ~min_size:57 ~max_size:200 () ]
+let chunks = lists (integers ~min_value:1 ~max_value:9 ()) ~max_size:12 ()
+
+let%hegel_test rfc2045_decode_in_chunks tc =
+  let s = draw tc long_data in
+  let width = draw tc (map (fun w -> 4 * w) (integers ~min_value:1 ~max_value:19 ()) |> printed string_of_int) in
+  let input = ask_exn "mime" [ s; string_of_int width ] in
+  let sizes = draw tc chunks in
+  let d = Base64_rfc2045.decoder `Manual in
+  let out = Buffer.create 64 in
+  let rec go pos sizes =
+    match Base64_rfc2045.decode d with
+    | `Await ->
+      let n, rest =
+        match sizes with
+        | n :: rest -> min n (String.length input - pos), rest
+        | [] -> String.length input - pos, []
+      in
+      Base64_rfc2045.src d (Bytes.of_string input) pos n;
+      go (pos + n) rest
+    | `Flush x ->
+      Buffer.add_string out x;
+      go pos sizes
+    | `End -> ()
+    | `Malformed m -> Printf.ksprintf failwith "malformed %S at %d" m (Base64_rfc2045.decoder_byte_count d)
+    | `Wrong_padding -> failwith "wrong padding"
+  in
+  go 0 sizes;
+  if not (String.equal (Buffer.contents out) s)
+  then Printf.ksprintf failwith "%S decodes to %S" input (Buffer.contents out);
+  if Base64_rfc2045.decoder_dangerous d then failwith "lines within 76 columns are dangerous"
+;;
+
+let manual_encode size s =
+  let e = Base64_rfc2045.encoder `Manual in
+  let out = Buffer.create 64 in
+  let buf = Bytes.create size in
+  Base64_rfc2045.dst e buf 0 size;
+  let rec emit v =
+    match Base64_rfc2045.encode e v with
+    | `Ok -> ()
+    | `Partial ->
+      Buffer.add_subbytes out buf 0 (size - Base64_rfc2045.dst_rem e);
+      Base64_rfc2045.dst e buf 0 size;
+      emit `Await
+  in
+  String.iter (fun c -> emit (`Char c)) s;
+  emit `End;
+  Buffer.contents out
+;;
+
+let split_quantum = tuples2 (binary ~min_size:6 ~max_size:200 ()) (integers ~min_value:1 ~max_value:3 ())
+
+let%hegel_test rfc2045_encode_agrees_with_python tc =
+  let s, size = draw tc (known_first split_quantum (tuples2 long_data (integers ~min_value:1 ~max_value:12 ()))) in
+  if not Zoo.known then assume tc (size >= 6);
+  let ours = manual_encode size s in
+  let theirs = ask_exn "mime" [ s; "76" ] in
+  if not (String.equal ours theirs) then Printf.ksprintf failwith "encodes to %S, python %S" ours theirs
+;;
+
+let pin_padding_quantum () =
+  match Base64.decode "QUJD====" with
+  | Ok d -> Printf.ksprintf failwith "QUJD==== decodes to %S" d
+  | Error _ -> ()
+;;
+
+let pin_single_character_quantum () =
+  match Base64.decode "Z===" with
+  | Ok d -> Printf.ksprintf failwith "Z=== decodes to %S" d
+  | Error _ -> ()
+;;
+
+let pin_manual_encoder_small_buffer () =
+  let out = manual_encode 1 "foobar" in
+  if not (String.equal out "Zm9vYmFy") then Printf.ksprintf failwith "foobar encodes to %S" out
+;;
+
+let () =
+  Zoo.run
+    [ "encode_agrees_with_python", encode_agrees_with_python
+    ; "custom_alphabet_encode_agrees_with_python", custom_alphabet_encode_agrees_with_python
+    ; "decode_inverts_encode", decode_inverts_encode
+    ; "decode_agrees_with_python", decode_agrees_with_python
+    ; "final_quantum_agrees_with_python", final_quantum_agrees_with_python
+    ; "unpadded_decode_inverts_encode", unpadded_decode_inverts_encode
+    ; "rfc2045_decode_in_chunks", rfc2045_decode_in_chunks
+    ; "rfc2045_encode_agrees_with_python", rfc2045_encode_agrees_with_python
+    ; "pin_padding_quantum", pin_padding_quantum
+    ; "pin_single_character_quantum", pin_single_character_quantum
+    ; "pin_manual_encoder_small_buffer", pin_manual_encoder_small_buffer
+    ]
+;;
