+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
diff --git a/hegel/zoo_tests.ml b/hegel/zoo_tests.ml
new file mode 100644
index 0000000..d2cb287
--- /dev/null
+++ b/hegel/zoo_tests.ml
@@ -0,0 +1,532 @@
+open Hegel
+open Sexplib0.Sexp_conv
+
+type node =
+  | Chr of char
+  | Not_chr of char
+  | Any
+  | Satisfy of string
+  | Str of string
+  | Str_ci of string
+  | Skip of string
+  | Skip_while of string
+  | Take of int
+  | Take_while of string
+  | Take_while1 of string
+  | Take_till of string
+  | Peek_chr
+  | Peek_chr_fail
+  | Peek_str of int
+  | Advance of int
+  | Eol
+  | At_end
+  | Eoi
+  | Pos
+  | Commit
+  | Return
+  | Fail
+  | Opt of node
+  | Both of node * node
+  | Left of node * node
+  | Right of node * node
+  | Alt of node * node
+  | Count of int * node
+  | Many of node
+  | Many1 of node
+  | Sep_by of node * node
+  | Consumed of node
+  | Nested of node
+[@@deriving sexp_of]
+
+type v =
+  | Unit
+  | S of string
+  | C of char
+  | Co of char option
+  | B of bool
+  | I of int
+  | L of v list
+  | P of v * v
+[@@deriving sexp_of]
+
+let mem cls c = String.contains cls c
+
+let rec compile : node -> v Angstrom.t =
+  let open Angstrom in
+  function
+  | Chr c -> char c >>| fun c -> C c
+  | Not_chr c -> not_char c >>| fun c -> C c
+  | Any -> any_char >>| fun c -> C c
+  | Satisfy cls -> satisfy (mem cls) >>| fun c -> C c
+  | Str t -> string t >>| fun s -> S s
+  | Str_ci t -> string_ci t >>| fun s -> S s
+  | Skip cls -> skip (mem cls) >>| fun () -> Unit
+  | Skip_while cls -> skip_while (mem cls) >>| fun () -> Unit
+  | Take n -> take n >>| fun s -> S s
+  | Take_while cls -> take_while (mem cls) >>| fun s -> S s
+  | Take_while1 cls -> take_while1 (mem cls) >>| fun s -> S s
+  | Take_till cls -> take_till (mem cls) >>| fun s -> S s
+  | Peek_chr -> peek_char >>| fun c -> Co c
+  | Peek_chr_fail -> peek_char_fail >>| fun c -> C c
+  | Peek_str n -> peek_string n >>| fun s -> S s
+  | Advance n -> advance n >>| fun () -> Unit
+  | Eol -> end_of_line >>| fun () -> Unit
+  | At_end -> at_end_of_input >>| fun b -> B b
+  | Eoi -> end_of_input >>| fun () -> Unit
+  | Pos -> pos >>| fun n -> I n
+  | Commit -> commit >>| fun () -> Unit
+  | Return -> return Unit
+  | Fail -> fail "fail"
+  | Opt p -> option Unit (compile p)
+  | Both (p, q) -> both (compile p) (compile q) >>| fun (a, b) -> P (a, b)
+  | Left (p, q) -> compile p <* compile q
+  | Right (p, q) -> compile p *> compile q
+  | Alt (p, q) -> compile p <|> compile q
+  | Count (n, p) -> count n (compile p) >>| fun l -> L l
+  | Many p -> many (compile p) >>| fun l -> L l
+  | Many1 p -> many1 (compile p) >>| fun l -> L l
+  | Sep_by (s, p) -> sep_by (compile s) (compile p) >>| fun l -> L l
+  | Consumed p -> consumed (compile p) >>| fun s -> S s
+  | Nested p ->
+    let p = compile p in
+    fix (fun self -> char '(' *> many (self <|> p) <* char ')' >>| fun l -> L l)
+;;
+
+(* Written from angstrom.mli's documentation, not from the source. *)
+let reference node s =
+  let n = String.length s in
+  let committed = ref 0 in
+  let sub i k = String.sub s i k in
+  let rec span f i = if i < n && f s.[i] then span f (i + 1) else i in
+  let alt i l r =
+    match l () with
+    | Some _ as ok -> ok
+    | None -> if i < !committed then None else r ()
+  in
+  let rec run node i =
+    match node with
+    | Chr c -> if i < n && s.[i] = c then Some (C c, i + 1) else None
+    | Not_chr c -> if i < n && s.[i] <> c then Some (C s.[i], i + 1) else None
+    | Any -> if i < n then Some (C s.[i], i + 1) else None
+    | Satisfy cls -> if i < n && mem cls s.[i] then Some (C s.[i], i + 1) else None
+    | Str t ->
+      let k = String.length t in
+      if i + k <= n && String.equal (sub i k) t then Some (S t, i + k) else None
+    | Str_ci t ->
+      let k = String.length t in
+      if i + k <= n
+         && String.equal (String.lowercase_ascii (sub i k)) (String.lowercase_ascii t)
+      then Some (S (sub i k), i + k)
+      else None
+    | Skip cls -> if i < n && mem cls s.[i] then Some (Unit, i + 1) else None
+    | Skip_while cls -> Some (Unit, span (mem cls) i)
+    | Take k -> if i + k <= n then Some (S (sub i k), i + k) else None
+    | Take_while cls ->
+      let j = span (mem cls) i in
+      Some (S (sub i (j - i)), j)
+    | Take_while1 cls ->
+      let j = span (mem cls) i in
+      if j > i then Some (S (sub i (j - i)), j) else None
+    | Take_till cls ->
+      let j = span (fun c -> not (mem cls c)) i in
+      Some (S (sub i (j - i)), j)
+    | Peek_chr -> Some (Co (if i < n then Some s.[i] else None), i)
+    | Peek_chr_fail -> if i < n then Some (C s.[i], i) else None
+    | Peek_str k -> if i + k <= n then Some (S (sub i k), i) else None
+    | Advance k -> if i + k <= n then Some (Unit, i + k) else None
+    | Eol ->
+      if i < n && s.[i] = '\n'
+      then Some (Unit, i + 1)
+      else if i + 1 < n && s.[i] = '\r' && s.[i + 1] = '\n'
+      then Some (Unit, i + 2)
+      else None
+    | At_end -> Some (B (i = n), i)
+    | Eoi -> if i = n then Some (Unit, i) else None
+    | Pos -> Some (I i, i)
+    | Commit ->
+      committed := max !committed i;
+      Some (Unit, i)
+    | Return -> Some (Unit, i)
+    | Fail -> None
+    | Opt p -> alt i (fun () -> run p i) (fun () -> Some (Unit, i))
+    | Both (p, q) -> seq p q i (fun a b -> P (a, b))
+    | Left (p, q) -> seq p q i (fun a _ -> a)
+    | Right (p, q) -> seq p q i (fun _ b -> b)
+    | Alt (p, q) -> alt i (fun () -> run p i) (fun () -> run q i)
+    | Count (k, p) ->
+      let rec go k i acc =
+        if k = 0
+        then Some (L (List.rev acc), i)
+        else (
+          match run p i with
+          | Some (x, j) -> go (k - 1) j (x :: acc)
+          | None -> None)
+      in
+      go k i []
+    | Many p -> many (fun i -> run p i) i
+    | Many1 p -> many1 (fun i -> run p i) i
+    | Sep_by (sep, p) ->
+      alt i (fun () -> sep_by1 sep p i) (fun () -> Some (L [], i))
+    | Consumed p ->
+      (* intended: the bytes before a commit may already be released ("consumed: parser committed") *)
+      let before = !committed in
+      (match run p i with
+       | Some (_, j) when !committed = before -> Some (S (sub i (j - i)), j)
+       | _ -> None)
+    | Nested p -> nested p i
+  and seq p q i f =
+    match run p i with
+    | None -> None
+    | Some (a, j) -> Option.map (fun (b, k) -> f a b, k) (run q j)
+  and many p i =
+    alt
+      i
+      (fun () ->
+         match p i with
+         | None -> None
+         | Some (x, j) ->
+           (match many p j with
+            | Some (L xs, k) -> Some (L (x :: xs), k)
+            | _ -> None))
+      (fun () -> Some (L [], i))
+  and many1 p i =
+    match p i with
+    | None -> None
+    | Some (x, j) ->
+      (match many p j with
+       | Some (L xs, k) -> Some (L (x :: xs), k)
+       | _ -> None)
+  and sep_by1 sep p i = many1_after (fun i -> run p i) (fun i -> run (Right (sep, p)) i) i
+  and many1_after first rest i =
+    match first i with
+    | None -> None
+    | Some (x, j) ->
+      (match many rest j with
+       | Some (L xs, k) -> Some (L (x :: xs), k)
+       | _ -> None)
+  and nested p i =
+    if i < n && s.[i] = '('
+    then (
+      match many (fun i -> alt i (fun () -> nested p i) (fun () -> run p i)) (i + 1) with
+      | Some (l, j) when j < n && s.[j] = ')' -> Some (l, j + 1)
+      | _ -> None)
+    else None
+  in
+  run node 0
+;;
+
+let buffered p s sizes =
+  let open Angstrom.Buffered in
+  let len = String.length s in
+  let rec go st off sizes =
+    match st, sizes with
+    | Partial _, _ when off >= len -> feed st `Eof, off
+    | Partial _, k :: sizes ->
+      let k = min k (len - off) in
+      go (feed st (`String (String.sub s off k))) (off + k) sizes
+    | Partial _, [] -> go (feed st (`String (String.sub s off (len - off)))) len []
+    | (Done _ | Fail _), _ -> st, off
+  in
+  match go (parse p) 0 sizes with
+  | Done (u, v), fed -> Some (v, fed - u.len)
+  | Fail _, _ -> None
+  | Partial _, _ -> failwith "Buffered: Partial after `Eof"
+;;
+
+let unbuffered p s sizes =
+  let open Angstrom.Unbuffered in
+  let len = String.length s in
+  let rec go st dropped avail complete sizes =
+    match st with
+    | Done (k, v) -> Some (v, dropped + k)
+    | Fail _ -> None
+    | Partial _ when complete -> failwith "Unbuffered: Partial after Complete"
+    | Partial { committed; continue } ->
+      let dropped = dropped + committed in
+      let k, sizes =
+        match sizes with
+        | k :: sizes -> k, sizes
+        | [] -> len, []
+      in
+      let avail = min len (avail + k) in
+      let complete = avail >= len in
+      let buf = Bigstringaf.of_string ~off:dropped ~len:(avail - dropped) s in
+      go
+        (continue buf ~off:0 ~len:(avail - dropped) (if complete then Complete else Incomplete))
+        dropped
+        avail
+        complete
+        sizes
+  in
+  go (parse p) 0 0 false sizes
+;;
+
+let alphabet = "aAb()\r\n"
+let chars = with_printer sexp_of_char (sampled_from (List.of_seq (String.to_seq alphabet)))
+let classes = text ~alphabet ~min_size:1 ~max_size:3 ()
+let words = text ~alphabet ~min_size:1 ~max_size:3 ()
+let small = integers ~min_value:0 ~max_value:3 ()
+let positive = integers ~min_value:1 ~max_value:3 ()
+let node g = with_printer sexp_of_node g
+
+let consuming_leaf =
+  one_of
+    [ node (map (fun c -> Chr c) chars)
+    ; node (map (fun c -> Not_chr c) chars)
+    ; node (just Any)
+    ; node (map (fun cls -> Satisfy cls) classes)
+    ; node (map (fun cls -> Skip cls) classes)
+    ; node (map (fun t -> Str t) words)
+    ; node (map (fun t -> Str_ci t) words)
+    ; node (map (fun k -> Take k) positive)
+    ; node (map (fun cls -> Take_while1 cls) classes)
+    ; node (map (fun k -> Advance k) positive)
+    ; node (just Eol)
+    ]
+;;
+
+(* A [Nested] body that could match a parenthesis makes the grammar ambiguous, and backtracking
+   through it takes exponential time. *)
+let paren_free = "aAb\r\n"
+
+let paren_free_leaf =
+  let chars = with_printer sexp_of_char (sampled_from (List.of_seq (String.to_seq paren_free))) in
+  let classes = text ~alphabet:paren_free ~min_size:1 ~max_size:3 () in
+  one_of
+    [ node (map (fun c -> Chr c) chars)
+    ; node (map (fun cls -> Satisfy cls) classes)
+    ; node (map (fun t -> Str t) classes)
+    ; node (map (fun cls -> Take_while1 cls) classes)
+    ; node (just Eol)
+    ]
+;;
+
+let leaf =
+  one_of
+    [ node (just Return)
+    ; consuming_leaf
+    ; node (just Fail)
+    ; node (map (fun cls -> Skip_while cls) classes)
+    ; node (map (fun k -> Take k) small)
+    ; node (map (fun cls -> Take_while cls) classes)
+    ; node (map (fun cls -> Take_till cls) classes)
+    ; node (just Peek_chr)
+    ; node (just Peek_chr_fail)
+    ; node (map (fun k -> Peek_str k) small)
+    ; node (just At_end)
+    ; node (just Eoi)
+    ; node (just Pos)
+    ; node (just Commit)
+    ]
+;;
+
+(* Loop bodies must consume, or [many] never ends. *)
+let rec parsers depth =
+  if depth = 0
+  then leaf, consuming_leaf
+  else (
+    let any, con = parsers (depth - 1) in
+    let pair f a b = node (map (fun (p, q) -> f p q) (tuples2 a b)) in
+    ( one_of
+        [ leaf
+        ; node (map (fun p -> Opt p) any)
+        ; pair (fun p q -> Both (p, q)) any any
+        ; pair (fun p q -> Left (p, q)) any any
+        ; pair (fun p q -> Right (p, q)) any any
+        ; pair (fun p q -> Alt (p, q)) any any
+        ; pair (fun k p -> Count (k, p)) small any
+        ; node (map (fun p -> Many p) con)
+        ; node (map (fun p -> Many1 p) con)
+        ; pair (fun s p -> Sep_by (s, p)) any con
+        ; node (map (fun p -> Consumed p) any)
+        ; node (map (fun p -> Nested p) paren_free_leaf)
+        ]
+    , one_of
+        [ consuming_leaf
+        ; pair (fun p q -> Both (p, q)) con any
+        ; pair (fun p q -> Right (p, q)) any con
+        ; pair (fun p q -> Alt (p, q)) con con
+        ; node (map (fun p -> Many1 p) con)
+        ; node (map (fun p -> Consumed p) con)
+        ; node (map (fun p -> Nested p) paren_free_leaf)
+        ] ))
+;;
+
+let any_parser, consuming_parser = parsers 3
+let inputs = text ~alphabet ~max_size:12 ()
+let chunks = lists (integers ~min_value:0 ~max_value:4 ()) ~min_size:1 ~max_size:8 ()
+let incremental_parser = one_of [ consuming_parser; any_parser ]
+
+let str g = with_printer sexp_of_string g
+let lit s = str (just s)
+let cat a b = str (map (fun (x, y) -> x ^ y) (tuples2 a b))
+let joined g ~min_size = str (map (String.concat "") (lists g ~min_size ~max_size:3 ()))
+let without cls = String.concat "" (List.filter_map (fun c -> if mem cls c then None else Some (String.make 1 c)) (List.of_seq (String.to_seq alphabet)))
+let from cls ~min_size ~max_size = if cls = "" then lit "" else text ~alphabet:cls ~min_size ~max_size ()
+
+let rec accepted = function
+  | Chr c -> lit (String.make 1 c)
+  | Not_chr c -> from (without (String.make 1 c)) ~min_size:1 ~max_size:1
+  | Any -> from alphabet ~min_size:1 ~max_size:1
+  | Satisfy cls | Skip cls -> from cls ~min_size:1 ~max_size:1
+  | Str t -> lit t
+  | Str_ci t -> one_of [ lit t; lit (String.uppercase_ascii t); lit (String.lowercase_ascii t) ]
+  | Take k | Peek_str k | Advance k -> from alphabet ~min_size:k ~max_size:k
+  | Take_while cls | Skip_while cls -> from cls ~min_size:0 ~max_size:3
+  | Take_while1 cls -> from cls ~min_size:1 ~max_size:3
+  | Take_till cls -> from (without cls) ~min_size:0 ~max_size:3
+  | Eol -> one_of [ lit "\n"; lit "\r\n" ]
+  | Peek_chr | Peek_chr_fail | At_end | Eoi | Pos | Commit | Return | Fail -> lit ""
+  | Opt p -> one_of [ lit ""; accepted p ]
+  | Both (p, q) | Left (p, q) | Right (p, q) -> cat (accepted p) (accepted q)
+  | Alt (p, q) -> one_of [ accepted p; accepted q ]
+  | Count (k, p) -> List.fold_left cat (lit "") (List.init k (fun _ -> accepted p))
+  | Many p -> joined (accepted p) ~min_size:0
+  | Many1 p -> joined (accepted p) ~min_size:1
+  | Sep_by (sep, p) ->
+    one_of [ lit ""; cat (accepted p) (joined (cat (accepted sep) (accepted p)) ~min_size:0) ]
+  | Consumed p -> accepted p
+  | Nested p ->
+    let rec nested depth =
+      let item = if depth = 0 then accepted p else one_of [ accepted p; nested (depth - 1) ] in
+      cat (lit "(") (cat (joined item ~min_size:0) (lit ")"))
+    in
+    nested 2
+;;
+
+let input_for p = one_of [ cat (accepted p) (text ~alphabet ~max_size:3 ()); inputs ]
+
+let consumes =
+  with_printer
+    (function
+      | Angstrom.Consume.Prefix -> Sexplib0.Sexp.Atom "Prefix"
+      | All -> Atom "All")
+    (sampled_from [ Angstrom.Consume.Prefix; All ])
+;;
+
+let show_outcome o = Sexplib0.Sexp.to_string (sexp_of_option (sexp_of_pair sexp_of_v sexp_of_int) o)
+let show_result = function
+  | Ok v -> "Ok " ^ Sexplib0.Sexp.to_string (sexp_of_v v)
+  | Error msg -> "Error " ^ msg
+;;
+let same_result a b = Result.equal ~ok:( = ) ~error:(fun _ _ -> true) a b
+
+let%hegel_test parse_string_agrees_with_reference tc =
+  let p = draw tc any_parser in
+  let s = draw tc (input_for p) in
+  let consume = draw tc consumes in
+  let got = Angstrom.parse_string ~consume (compile p) s in
+  let expected =
+    match reference p s, consume with
+    | Some (v, _), Prefix -> Some v
+    | Some (v, j), All when j = String.length s -> Some v
+    | _ -> None
+  in
+  if not (Option.equal ( = ) (Result.to_option got) expected)
+  then
+    Printf.ksprintf
+      failwith
+      "parse_string gives %s, the documentation %s"
+      (show_result got)
+      (Sexplib0.Sexp.to_string (sexp_of_option sexp_of_v expected))
+;;
+
+let%hegel_test buffered_agrees_with_reference tc =
+  let p = draw tc incremental_parser in
+  let s = draw tc (input_for p) in
+  let sizes = draw tc chunks in
+  let got = buffered (compile p) s sizes in
+  let expected = reference p s in
+  if not (Option.equal ( = ) got expected)
+  then
+    Printf.ksprintf
+      failwith
+      "Buffered gives %s, the documentation %s"
+      (show_outcome got)
+      (show_outcome expected)
+;;
+
+let%hegel_test unbuffered_agrees_with_reference tc =
+  let p = draw tc incremental_parser in
+  let s = draw tc (input_for p) in
+  let sizes = draw tc chunks in
+  let got = unbuffered (compile p) s sizes in
+  let expected = reference p s in
+  if not (Option.equal ( = ) got expected)
+  then
+    Printf.ksprintf
+      failwith
+      "Unbuffered gives %s, the documentation %s"
+      (show_outcome got)
+      (show_outcome expected)
+;;
+
+let%hegel_test consumed_is_the_input_up_to_pos tc =
+  let p = draw tc any_parser in
+  let s = draw tc (input_for p) in
+  match
+    Angstrom.parse_string ~consume:Prefix (Angstrom.both (Angstrom.consumed (compile p)) Angstrom.pos) s
+  with
+  | Ok (c, n) ->
+    if not (String.equal c (String.sub s 0 n))
+    then Printf.ksprintf failwith "consumed %S at pos %d" c n
+  | Error _ -> ()
+;;
+
+let%hegel_test bind_return_is_identity tc =
+  let p = draw tc any_parser in
+  let s = draw tc (input_for p) in
+  let lhs = Angstrom.parse_string ~consume:Prefix Angstrom.(compile p >>= return) s in
+  let rhs = Angstrom.parse_string ~consume:Prefix (compile p) s in
+  if not (same_result lhs rhs)
+  then Printf.ksprintf failwith "p >>= return gives %s, p %s" (show_result lhs) (show_result rhs)
+;;
+
+let%hegel_test fail_is_identity_of_alt tc =
+  let p = draw tc any_parser in
+  let s = draw tc (input_for p) in
+  let run q = Angstrom.parse_string ~consume:Prefix q s in
+  let plain = run (compile p) in
+  let left = run Angstrom.(fail "x" <|> compile p) in
+  let right = run Angstrom.(compile p <|> fail "x") in
+  if not (same_result left plain && same_result right plain)
+  then
+    Printf.ksprintf
+      failwith
+      "fail <|> p gives %s, p <|> fail %s, p %s"
+      (show_result left)
+      (show_result right)
+      (show_result plain)
+;;
+
+let%hegel_test many_is_many1_or_nothing tc =
+  let p = draw tc consuming_parser in
+  let s = draw tc (input_for p) in
+  let run q = Angstrom.parse_string ~consume:Prefix q s in
+  let many = run Angstrom.(many (compile p)) in
+  let unfolded = run Angstrom.(many1 (compile p) <|> return []) in
+  if not (same_result many unfolded)
+  then failwith "many p differs from many1 p <|> return []"
+;;
+
+let%hegel_test consume_all_is_prefix_then_end_of_input tc =
+  let p = draw tc any_parser in
+  let s = draw tc (input_for p) in
+  let all = Angstrom.parse_string ~consume:All (compile p) s in
+  let prefix = Angstrom.parse_string ~consume:Prefix Angstrom.(compile p <* end_of_input) s in
+  if not (same_result all prefix)
+  then Printf.ksprintf failwith "All gives %s, Prefix with end_of_input %s" (show_result all) (show_result prefix)
+;;
