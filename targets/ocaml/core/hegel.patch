+module%hegel_state_machine Union_find_machine = struct
+  type state =
+    { mutable items : int Union_find.t list
+    ; mutable classes : int list
+    ; mutable values : (int * int) list
+    }
+
+  let sexp_of_state st =
+    Sexplib0.Sexp.Atom
+      (String.concat " " (List.map (fun c -> Printf.sprintf "%d=%d" c (List.assoc c st.values)) st.classes))
+  ;;
+
+  let pick tc st = draw tc (integers ~min_value:0 ~max_value:(List.length st.items - 1) ())
+
+  let create tc st =
+    let v = draw tc ints in
+    let id = List.length st.items in
+    st.items <- st.items @ [ Union_find.create v ];
+    st.classes <- st.classes @ [ id ];
+    st.values <- (id, v) :: st.values
+  [@@rule]
+  ;;
+
+  let union tc st =
+    if st.items <> []
+    then (
+      let i = pick tc st in
+      let j = pick tc st in
+      let ci = List.nth st.classes i in
+      let cj = List.nth st.classes j in
+      Union_find.union (List.nth st.items i) (List.nth st.items j);
+      let v = Union_find.get (List.nth st.items i) in
+      if v <> List.assoc ci st.values && v <> List.assoc cj st.values
+      then Printf.ksprintf failwith "union of classes valued %d and %d has value %d" (List.assoc ci st.values) (List.assoc cj st.values) v;
+      st.classes <- List.map (fun c -> if c = cj then ci else c) st.classes;
+      st.values <- (ci, v) :: List.remove_assoc ci st.values)
+  [@@rule]
+  ;;
+
+  let set tc st =
+    if st.items <> []
+    then (
+      let i = pick tc st in
+      let v = draw tc ints in
+      Union_find.set (List.nth st.items i) v;
+      let c = List.nth st.classes i in
+      st.values <- (c, v) :: List.remove_assoc c st.values)
+  [@@rule]
+  ;;
+
+  let classes _tc st =
+    List.iteri
+      (fun i a ->
+         let ci = List.nth st.classes i in
+         if Union_find.get a <> List.assoc ci st.values then Printf.ksprintf failwith "get of item %d disagrees" i;
+         List.iteri
+           (fun j b ->
+              if Union_find.same_class a b <> (ci = List.nth st.classes j)
+              then Printf.ksprintf failwith "same_class %d %d disagrees" i j)
+           st.items)
+      st.items
+  [@@invariant]
+  ;;
+end
+
+let%hegel_test union_find_machine tc =
+  Union_find_machine.run tc ~init:{ Union_find_machine.items = []; classes = []; values = [] }
+;;
