+module%hegel_state_machine Bag_machine = struct
+  type state =
+    { b : int Bag.t
+    ; mutable m : (int Bag.Elt.t * int) list
+    }
+
+  let sexp_of_state st = Sexplib0.Sexp.Atom (show_ints (List.map snd st.m))
+  let sorted l = List.sort Int.compare l
+
+  let add tc st =
+    let x = draw tc ints in
+    let e = Bag.add st.b x in
+    st.m <- (e, x) :: st.m
+  [@@rule]
+  ;;
+
+  let remove tc st =
+    if st.m <> []
+    then (
+      let e, _ = List.nth st.m (draw tc (integers ~min_value:0 ~max_value:(List.length st.m - 1) ())) in
+      Bag.remove st.b e;
+      st.m <- List.filter (fun (e', _) -> not (Bag.Elt.equal e e')) st.m)
+  [@@rule]
+  ;;
+
+  let remove_one _tc st =
+    match Bag.remove_one st.b, st.m with
+    | None, [] -> ()
+    | Some x, _ :: _ ->
+      (match List.find_opt (fun (e, y) -> y = x && not (Bag.mem_elt st.b e)) st.m with
+       | Some (e, _) -> st.m <- List.filter (fun (e', _) -> not (Bag.Elt.equal e e')) st.m
+       | None -> Printf.ksprintf failwith "remove_one gives %d, which was not removed" x)
+    | _ -> failwith "remove_one disagrees on emptiness"
+  [@@rule]
+  ;;
+
+  let filter_inplace _tc st =
+    Bag.filter_inplace st.b ~f:(fun x -> x mod 2 = 0);
+    st.m <- List.filter (fun (_, x) -> x mod 2 = 0) st.m
+  [@@rule]
+  ;;
+
+  let transfer_in tc st =
+    let l = draw tc (lists ints ~max_size:4 ()) in
+    let src = Bag.of_list l in
+    let elts = List.map (fun e -> e, Bag.Elt.value e) (Bag.elts src) in
+    Bag.transfer ~src ~dst:st.b;
+    if not (Bag.is_empty src) then failwith "transfer leaves the source non-empty";
+    st.m <- elts @ st.m
+  [@@rule]
+  ;;
+
+  let contents _tc st =
+    if sorted (Bag.to_list st.b) <> sorted (List.map snd st.m)
+    then Printf.ksprintf failwith "bag holds %s" (show_ints (sorted (Bag.to_list st.b)));
+    if Bag.length st.b <> List.length st.m then failwith "length disagrees";
+    List.iter (fun (e, x) -> if not (Bag.mem_elt st.b e) || Bag.Elt.value e <> x then failwith "an element is lost") st.m;
+    Bag.invariant ignore st.b
+  [@@invariant]
+  ;;
+end
+
+let%hegel_test bag_machine tc = Bag_machine.run tc ~init:{ Bag_machine.b = Bag.create (); m = [] }
+
