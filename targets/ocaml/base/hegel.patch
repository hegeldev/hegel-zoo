+module%hegel_state_machine Hashtbl_machine = struct
+  type state =
+    { mutable t : int Hashtbl.M(Int).t
+    ; mutable model : (int * int) list
+    }
+
+  let sexp_of_state st = [%sexp_of: (int * int) list] st.model
+
+  let set tc st =
+    let key = draw tc keys in
+    let data = draw tc data in
+    Hashtbl.set st.t ~key ~data;
+    st.model <- assoc_set st.model key data
+  [@@rule]
+  ;;
+
+  let add tc st =
+    let key = draw tc keys in
+    let data = draw tc data in
+    match Hashtbl.add st.t ~key ~data, assoc_find st.model key with
+    | `Ok, None -> st.model <- assoc_set st.model key data
+    | `Duplicate, Some _ -> ()
+    | _ -> failwith "add disagrees on whether the key is bound"
+  [@@rule]
+  ;;
+
+  let remove tc st =
+    let key = draw tc keys in
+    Hashtbl.remove st.t key;
+    st.model <- List.Assoc.remove st.model ~equal:Int.equal key
+  [@@rule]
+  ;;
+
+  let find_and_remove tc st =
+    let key = draw tc keys in
+    same_int_option
+      "find_and_remove"
+      (Hashtbl.find_and_remove st.t key)
+      (assoc_find st.model key);
+    st.model <- List.Assoc.remove st.model ~equal:Int.equal key
+  [@@rule]
+  ;;
+
+  let change tc st =
+    let key = draw tc keys in
+    let f = function
+      | None -> Some 50
+      | Some v -> if v % 2 = 0 then None else Some (v * 2)
+    in
+    Hashtbl.change st.t key ~f;
+    st.model
+    <- (match f (assoc_find st.model key) with
+        | None -> List.Assoc.remove st.model ~equal:Int.equal key
+        | Some v -> assoc_set st.model key v)
+  [@@rule]
+  ;;
+
+  let incr tc st =
+    let key = draw tc keys in
+    let by = draw tc (integers ~min_value:(-3) ~max_value:3 ()) in
+    let remove_if_zero = draw tc (booleans ()) in
+    let up = draw tc (booleans ()) in
+    (if up then Hashtbl.incr else Hashtbl.decr) ~by ~remove_if_zero st.t key;
+    let v = Option.value (assoc_find st.model key) ~default:0 + if up then by else -by in
+    st.model
+    <- (if remove_if_zero && v = 0
+        then List.Assoc.remove st.model ~equal:Int.equal key
+        else assoc_set st.model key v)
+  [@@rule]
+  ;;
+
+  let find_or_add tc st =
+    let key = draw tc keys in
+    let got = Hashtbl.find_or_add st.t key ~default:(fun () -> 7) in
+    let expected = Option.value (assoc_find st.model key) ~default:7 in
+    if got <> expected
+    then Printf.ksprintf failwith "find_or_add gives %d, expected %d" got expected;
+    st.model <- assoc_set st.model key expected
+  [@@rule]
+  ;;
+
+  let filter_map_inplace _tc st =
+    let f v = if v % 3 = 0 then None else Some (v + 1) in
+    Hashtbl.filter_map_inplace st.t ~f;
+    st.model
+    <- List.filter_map st.model ~f:(fun (k, v) -> Option.map (f v) ~f:(fun v -> k, v))
+  [@@rule]
+  ;;
+
+  let filteri_inplace _tc st =
+    let f ~key ~data = key % 2 = 0 || data > 4 in
+    Hashtbl.filteri_inplace st.t ~f;
+    st.model <- List.filter st.model ~f:(fun (key, data) -> f ~key ~data)
+  [@@rule]
+  ;;
+
+  let copy _tc st = st.t <- Hashtbl.copy st.t [@@rule]
+
+  let clear tc st =
+    if draw tc (integers ~min_value:0 ~max_value:5 ()) = 0
+    then (
+      Hashtbl.clear st.t;
+      st.model <- [])
+  [@@rule]
+  ;;
+
+  let contents _tc st =
+    same_pairs "to_alist" (List.sort (Hashtbl.to_alist st.t) ~compare:by_key) st.model;
+    Hashtbl.invariant ignore ignore st.t;
+    if Hashtbl.length st.t <> List.length st.model
+    then Printf.ksprintf failwith "length %d" (Hashtbl.length st.t);
+    List.iter st.model ~f:(fun (k, v) ->
+      same_int_option (Printf.sprintf "find %d" k) (Hashtbl.find st.t k) (Some v));
+    match Hashtbl.choose st.t with
+    | None -> if not (List.is_empty st.model) then failwith "choose gives None"
+    | Some (k, v) -> same_int_option "choose" (assoc_find st.model k) (Some v)
+  [@@invariant]
+  ;;
+end
