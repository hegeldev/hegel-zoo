+let pos_len total =
+  printed
+    (fun (pos, len) -> Printf.sprintf "~pos:%d ~len:%d" pos len)
+    (flat_map
+       (fun pos ->
+          map (fun len -> pos, len) (integers ~min_value:0 ~max_value:(total - pos) ()))
+       (integers ~min_value:0 ~max_value:total ()))
