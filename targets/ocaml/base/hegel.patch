+
+let escape_status s ~escape_char =
+  List.rev
+    (String.fold s ~init:[] ~f:(fun acc c ->
+       match acc with
+       | `Escaping :: _ -> `Escaped :: acc
+       | _ -> (if Char.equal c escape_char then `Escaping else `Literal) :: acc))
+;;
+
+let escape_maps =
+  printed
+    (fun m -> Sexp.to_string ([%sexp_of: (char * char) list] m))
+    (map
+       (fun (froms, tos) ->
+          let froms = List.dedup_and_sort (String.to_list froms) ~compare:Char.compare in
+          let tos = List.dedup_and_sort (String.to_list tos) ~compare:Char.compare in
+          let n = Int.min (List.length froms) (List.length tos) in
+          List.zip_exn (List.take froms n) (List.take tos n))
+       (tuples2
+          (text ~alphabet:"ab,!" ~max_size:6 ())
+          (text ~alphabet:"xyz" ~max_size:6 ())))
+;;
+
+let%hegel_test string_escaping tc =
+  let escape_char = draw tc (printed Char.to_string (sampled_from [ '!'; '\\' ])) in
+  let s = draw tc (text ~alphabet:"ab, !\\" ~max_size:12 ()) in
+  let on = draw tc (printed Char.to_string (sampled_from [ ','; ' '; 'a' ])) in
+  let module E = String.Escaping in
+  let status = Array.of_list (escape_status s ~escape_char) in
+  let literal i =
+    match status.(i) with
+    | `Literal -> true
+    | `Escaping | `Escaped -> false
+  in
+  String.iteri s ~f:(fun i _ ->
+    let expect what f st =
+      let holds =
+        match status.(i), st with
+        | `Literal, `Literal | `Escaping, `Escaping | `Escaped, `Escaped -> true
+        | _ -> false
+      in
+      if not (Bool.equal (f s ~escape_char i) holds)
+      then Printf.ksprintf failwith "%s %d disagrees" what i
+    in
+    expect "is_char_literal" E.is_char_literal `Literal;
+    expect "is_char_escaping" E.is_char_escaping `Escaping;
+    expect "is_char_escaped" E.is_char_escaped `Escaped);
+  let literals =
+    List.filter
+      (List.range 0 (String.length s))
+      ~f:(fun i -> literal i && Char.equal s.[i] on)
+  in
+  same_int_option "index" (E.index s ~escape_char on) (List.hd literals);
+  same_int_option "rindex" (E.rindex s ~escape_char on) (List.last literals);
+  let pos = draw tc (integers ~min_value:0 ~max_value:(String.length s) ()) in
+  same_int_option
+    "index_from"
+    (E.index_from s ~escape_char pos on)
+    (List.find literals ~f:(fun i -> i >= pos));
+  if pos < String.length s
+  then
+    same_int_option
+      "rindex_from"
+      (E.rindex_from s ~escape_char pos on)
+      (List.last (List.filter literals ~f:(fun i -> i <= pos)));
+  let starts = 0 :: List.map literals ~f:(fun i -> i + 1) in
+  let stops = literals @ [ String.length s ] in
+  same_strings
+    "split"
+    (E.split s ~on ~escape_char)
+    (List.map2_exn starts stops ~f:(fun a b -> String.sub s ~pos:a ~len:(b - a)));
+  let droppable i = literal i && Char.is_whitespace s.[i] in
+  let first =
+    List.find (List.range 0 (String.length s)) ~f:(fun i -> not (droppable i))
+  in
+  let last =
+    List.find (List.rev (List.range 0 (String.length s))) ~f:(fun i -> not (droppable i))
+  in
+  same_string
+    "strip_literal"
+    (E.strip_literal s ~escape_char)
+    (match first, last with
+     | Some a, Some b -> String.sub s ~pos:a ~len:(b - a + 1)
+     | _ -> "");
+  let escapeworthy_map = draw tc escape_maps in
+  let plain = draw tc (text ~alphabet:"ab,!xyz\\" ~max_size:10 ()) in
+  match
+    ( E.escape_gen ~escapeworthy_map ~escape_char
+    , E.unescape_gen ~escapeworthy_map ~escape_char )
+  with
+  | Ok escape, Ok unescape ->
+    let escaped = escape plain in
+    let full =
+      if List.Assoc.mem escapeworthy_map ~equal:Char.equal escape_char
+      then escapeworthy_map
+      else (escape_char, escape_char) :: escapeworthy_map
+    in
+    same_string
+      "escape_gen"
+      escaped
+      (String.concat_map plain ~f:(fun c ->
+         match List.Assoc.find full ~equal:Char.equal c with
+         | None -> String.of_char c
+         | Some d -> String.of_char_list [ escape_char; d ]));
+    same_string "unescape_gen" (unescape escaped) plain
+  | _ -> failwith "escape_gen rejects a one-to-one map"
+;;
+
+let bound_name = function
+  | `inclusive -> "inclusive"
+  | `exclusive -> "exclusive"
+;;
+
+let bounds =
+  printed (fun b -> "`" ^ bound_name b) (sampled_from [ `inclusive; `exclusive ])
+;;
+
+let show_range (a, b, stride, start, stop) =
+  Printf.sprintf
+    "range ~stride:%d ~start:`%s ~stop:`%s %d %d"
+    stride
+    (bound_name start)
+    (bound_name stop)
+    a
+    b
+;;
+
+let small_ranges =
+  printed
+    show_range
+    (map
+       (fun ((a, b, stride), (start, stop)) -> a, b, stride, start, stop)
+       (tuples2
+          (tuples3
+             (integers ~min_value:(-20) ~max_value:20 ())
+             (integers ~min_value:(-20) ~max_value:20 ())
+             (filter (fun s -> s <> 0) (integers ~min_value:(-5) ~max_value:5 ())))
+          (tuples2 bounds bounds)))
+;;
+
+let wide_ranges =
+  printed
+    show_range
+    (map
+       (fun ((a, b, k), (start, stop)) ->
+          let stride =
+            if b >= a
+            then Int.max 1 ((b / 32) - (a / 32))
+            else Int.min (-1) ((b / 32) - (a / 32))
+          in
+          a, b, (if stride > 0 then stride + k else stride - k), start, stop)
+       (tuples2
+          (tuples3 (integers ()) (integers ()) (integers ~min_value:0 ~max_value:3 ()))
+          (tuples2 bounds bounds)))
+;;
+
+(* base/3: the step after the last element passes max_value or min_value *)
+let edge_ranges =
+  printed
+    show_range
+    (map
+       (fun ((up, k, stride), (start, stop)) ->
+          if up
+          then Int.max_value - k, Int.max_value, stride, start, stop
+          else Int.min_value + k, Int.min_value, -stride, start, stop)
+       (tuples2
+          (tuples3
+             (booleans ())
+             (integers ~min_value:0 ~max_value:20 ())
+             (one_of
+                [ integers ~min_value:2 ~max_value:7 ()
+                ; integers ~min_value:(Int.max_value / 2) ()
+                ]))
+          (tuples2 bounds bounds)))
+;;
+
+let ranges =
+  one_of
+    (if Zoo.known
+     then [ edge_ranges; small_ranges; small_ranges; wide_ranges; wide_ranges ]
+     else [ small_ranges; wide_ranges ])
+;;
+
+let range_case tc =
+  let a, b, stride, start, stop = draw tc ranges in
+  match
+    ask
+      [ "range"
+      ; Int.to_string a
+      ; Int.to_string b
+      ; Int.to_string stride
+      ; bound_name start
+      ; bound_name stop
+      ]
+  with
+  | "long" :: _ -> None
+  | "wraps" :: _ when not Zoo.known -> None
+  | _ :: expected ->
+    Some (a, b, stride, start, stop, List.map expected ~f:Stdlib.int_of_string)
+  | [] -> failwith "oracle"
+;;
+
+let%hegel_test range tc =
+  match range_case tc with
+  | None -> ()
+  | Some (a, b, stride, start, stop, expected) ->
+    (match List.range ~stride ~start ~stop a b with
+     | got -> same_ints "List.range" got expected
+     | exception e -> Printf.ksprintf failwith "List.range raises %s" (Exn.to_string e));
+    same_ints
+      "Sequence.range"
+      (Sequence.to_list
+         (Sequence.take
+            (Sequence.range ~stride ~start ~stop a b)
+            (List.length expected + 1)))
+      expected
+;;
+
+let int_lists = lists (integers ~min_value:0 ~max_value:5 ()) ~max_size:12 ()
+let show_int_lists l = Sexp.to_string ([%sexp_of: int list list] l)
+
+let same_int_lists what got expected =
+  if not (List.equal (List.equal Int.equal) got expected)
+  then
+    Printf.ksprintf
+      failwith
+      "%s gives %s, expected %s"
+      what
+      (show_int_lists got)
+      (show_int_lists expected)
+;;
+
+let slice l a b = Stdlib.List.filteri (fun i _ -> a <= i && i < b) l
+
+let%hegel_test list_slicing tc =
+  let l = draw tc int_lists in
+  let n = draw tc (integers ~min_value:(-2) ~max_value:14 ()) in
+  let len = List.length l in
+  let k = Int.clamp_exn n ~min:0 ~max:len in
+  let rec chunks i = if i >= len then [] else slice l i (i + n) :: chunks (i + n) in
+  if n <= 0
+  then (
+    raises "chunks_of" (fun () -> List.chunks_of l ~length:n);
+    raises "chunk_evenly" (fun () -> List.chunk_evenly l ~into:n))
+  else (
+    same_int_lists "chunks_of" (List.chunks_of l ~length:n) (chunks 0);
+    let sizes = List.init n ~f:(fun i -> (len / n) + if i < len % n then 1 else 0) in
+    let starts = List.folding_map sizes ~init:0 ~f:(fun acc s -> acc + s, acc) in
+    same_int_lists
+      "chunk_evenly"
+      (List.chunk_evenly l ~into:n)
+      (List.map2_exn starts sizes ~f:(fun a s -> slice l a (a + s))));
+  same_ints "take" (List.take l n) (slice l 0 k);
+  same_ints "drop" (List.drop l n) (slice l k len);
+  let #(front, back) = List.split_n l n in
+  same_ints "split_n" (front @ back) l;
+  same_ints "split_n" front (slice l 0 k);
+  let pos = draw tc (integers ~min_value:(-1) ~max_value:(len + 1) ()) in
+  if pos < 0 || n < 0 || pos + n > len
+  then raises "sub" (fun () -> List.sub l ~pos ~len:n)
+  else same_ints "sub" (List.sub l ~pos ~len:n) (slice l pos (pos + n));
+  let small x = x < 3 in
+  let prefix =
+    Option.value_map (List.findi l ~f:(fun _ x -> not (small x))) ~default:len ~f:fst
+  in
+  same_ints "take_while" (List.take_while l ~f:small) (slice l 0 prefix);
+  same_ints "drop_while" (List.drop_while l ~f:small) (slice l prefix len);
+  let breaks =
+    List.filter (List.range 1 len) ~f:(fun i ->
+      i % 3 = 0 || List.nth_exn l i < List.nth_exn l (i - 1))
+  in
+  let stops = breaks @ [ len ] in
+  let starts = 0 :: breaks in
+  same_int_lists
+    "groupi"
+    (List.groupi l ~break:(fun i x y -> i % 3 = 0 || y < x))
+    (if len = 0 then [] else List.map2_exn starts stops ~f:(slice l));
+  same_ints
+    "intersperse"
+    (List.intersperse l ~sep:9)
+    (List.concat_mapi l ~f:(fun i x -> if i = 0 then [ x ] else [ 9; x ]));
+  if
+    not
+      (Option.equal
+         (List.equal Int.equal)
+         (List.drop_last l)
+         (if len = 0 then None else Some (slice l 0 (len - 1))))
+  then failwith "drop_last disagrees";
+  let width = draw tc (integers ~min_value:0 ~max_value:3 ()) in
+  let height = draw tc (integers ~min_value:1 ~max_value:3 ()) in
+  let ragged = draw tc (booleans ()) in
+  let rows =
+    List.init height ~f:(fun r -> List.init width ~f:(fun j -> (r * width) + j))
+  in
+  let rows = if ragged then rows @ [ List.init (width + 1) ~f:Fn.id ] else rows in
+  let expected =
+    if ragged
+    then None
+    else Some (List.init width ~f:(fun j -> List.map rows ~f:(fun r -> List.nth_exn r j)))
+  in
+  if not (Option.equal (List.equal (List.equal Int.equal)) (List.transpose rows) expected)
+  then Printf.ksprintf failwith "transpose %s disagrees" (show_int_lists rows)
+;;
+
+let show_pairs l = Sexp.to_string ([%sexp_of: (int * int) list] l)
+
+let same_pairs what got expected =
+  if not (List.equal [%equal: int * int] got expected)
+  then
+    Printf.ksprintf
+      failwith
+      "%s gives %s, expected %s"
+      what
+      (show_pairs got)
+      (show_pairs expected)
+;;
+
+let%hegel_test list_sorting tc =
+  let keys = draw tc int_lists in
+  let l = List.mapi keys ~f:(fun i k -> k, i) in
+  let compare (a, _) (b, _) = Int.compare a b in
+  let by_key =
+    List.concat_map (List.range 0 6) ~f:(fun k ->
+      List.filter l ~f:(fun (k', _) -> k = k'))
+  in
+  same_pairs "sort" (List.sort l ~compare) by_key;
+  same_pairs "stable_sort" (List.stable_sort l ~compare) by_key;
+  let last_of k = List.last (List.filter l ~f:(fun (k', _) -> k = k')) in
+  let first_of k = List.hd (List.filter l ~f:(fun (k', _) -> k = k')) in
+  same_pairs
+    "dedup_and_sort"
+    (List.dedup_and_sort l ~compare)
+    (List.filter_map (List.range 0 6) ~f:last_of);
+  same_pairs
+    "stable_dedup"
+    (List.stable_dedup l ~compare)
+    (List.filter l ~f:(fun (k, i) -> Int.equal (snd (Option.value_exn (first_of k))) i));
+  if
+    not
+      (List.equal
+         (List.equal [%equal: int * int])
+         (List.sort_and_group l ~compare)
+         (List.filter_map (List.range 0 6) ~f:(fun k ->
+            match List.filter by_key ~f:(fun (k', _) -> k = k') with
+            | [] -> None
+            | g -> Some g)))
+  then failwith "sort_and_group disagrees";
+  let others = List.map (draw tc int_lists) ~f:(fun k -> k, 100 + k) in
+  let sorted_l = List.stable_sort l ~compare in
+  let sorted_o = List.stable_sort others ~compare in
+  let merged =
+    List.concat_map (List.range 0 6) ~f:(fun k ->
+      List.filter sorted_l ~f:(fun (k', _) -> k = k')
+      @ List.filter sorted_o ~f:(fun (k', _) -> k = k'))
+  in
+  same_pairs "merge" (List.merge sorted_l sorted_o ~compare) merged;
+  same_pairs "merge_all" (List.merge_all [ sorted_l; sorted_o ] ~compare) merged;
+  let runs which =
+    List.filteri l ~f:(fun i (k, _) ->
+      match which with
+      | `First -> i = 0 || not (Int.equal (fst (List.nth_exn l (i - 1))) k)
+      | `Last -> i = List.length l - 1 || not (Int.equal (fst (List.nth_exn l (i + 1))) k))
+  in
+  let equal (a, _) (b, _) = Int.equal a b in
+  same_pairs
+    "remove_consecutive_duplicates ~which_to_keep:`First"
+    (List.remove_consecutive_duplicates ~which_to_keep:`First l ~equal)
+    (runs `First);
+  same_pairs
+    "remove_consecutive_duplicates"
+    (List.remove_consecutive_duplicates l ~equal)
+    (runs `Last);
+  let dups =
+    List.filter (List.range 0 6) ~f:(fun k -> List.count keys ~f:(Int.equal k) > 1)
+  in
+  same_ints
+    "find_all_dups"
+    (List.sort (List.find_all_dups keys ~compare:Int.compare) ~compare:Int.compare)
+    dups;
+  if
+    not
+      (Bool.equal
+         (List.contains_dup keys ~compare:Int.compare)
+         (not (List.is_empty dups)))
+  then failwith "contains_dup disagrees";
+  let min_key =
+    List.fold keys ~init:None ~f:(fun acc k ->
+      Some (Option.value_map acc ~default:k ~f:(Int.min k)))
+  in
+  let max_key =
+    List.fold keys ~init:None ~f:(fun acc k ->
+      Some (Option.value_map acc ~default:k ~f:(Int.max k)))
+  in
+  if
+    not
+      (Option.equal
+         [%equal: int * int]
+         (List.min_elt l ~compare)
+         (Option.bind min_key ~f:first_of))
+  then failwith "min_elt is not the first least element";
+  if
+    not
+      (Option.equal
+         [%equal: int * int]
+         (List.max_elt l ~compare)
+         (Option.bind max_key ~f:first_of))
+  then failwith "max_elt is not the first greatest element";
+  let sorted =
+    List.for_alli keys ~f:(fun i k -> i = 0 || List.nth_exn keys (i - 1) <= k)
+  in
+  if not (Bool.equal (List.is_sorted keys ~compare:Int.compare) sorted)
+  then failwith "is_sorted disagrees"
+;;
+
+let atoms =
+  one_of
+    [ text ~alphabet:"a #|;()\"\\\n\t\r\x01\x7f" ~max_size:5 ()
+    ; text ~max_size:4 ()
+    ; binary ~max_size:4 ()
+    ; printed
+        (Printf.sprintf "%S")
+        (sampled_from
+           [ "#|"; "|#"; "#;"; "a\n"; "\n\n"; "\xc3\xa9"; "\xe2\x80\xa8"; "\xc3"; "" ])
+    ]
+;;
+
+let rec sexps depth =
+  let atom = printed Sexp.to_string (map (fun s -> Sexp.Atom s) atoms) in
+  if depth = 0
+  then atom
+  else
+    one_of
+      [ atom
+      ; printed
+          Sexp.to_string
+          (map (fun l -> Sexp.List l) (lists (sexps (depth - 1)) ~max_size:3 ()))
+      ]
+;;
+
+let rec canonical = function
+  | Sexp.Atom s -> "a" ^ hex_digits s ^ ";"
+  | Sexp.List l -> "(" ^ String.concat (List.map l ~f:canonical) ^ ")"
+;;
+
+let%hegel_test sexp_printers_read_back tc =
+  let x = draw tc (sexps 3) in
+  let indent = draw tc (integers ~min_value:0 ~max_value:3 ()) in
+  let expected = canonical x in
+  List.iter
+    [ "to_string", Sexp.to_string x
+    ; "to_string_mach", Sexp.to_string_mach x
+    ; "to_string_hum", Sexp.to_string_hum ~indent x
+    ; "Utf8_as_string.to_string", Sexp.Utf8_as_string.to_string x
+    ; "Utf8_as_string.to_string_mach", Sexp.Utf8_as_string.to_string_mach x
+    ; "Utf8_as_string.to_string_hum", Sexp.Utf8_as_string.to_string_hum ~indent x
+    ]
+    ~f:(fun (what, printed) ->
+      match ask [ "sexp"; hex printed ] with
+      | [ got ] ->
+        if not (String.equal got expected)
+        then
+          Printf.ksprintf failwith "%s prints %S, which reads back as %s" what printed got
+      | _ -> failwith "oracle")
+;;
+
+let keys = integers ~min_value:0 ~max_value:15 ()
+let data = integers ~min_value:0 ~max_value:9 ()
+let by_key (a, _) (b, _) = Int.compare a b
+
+let assoc_set l k v =
+  List.sort ((k, v) :: List.Assoc.remove l ~equal:Int.equal k) ~compare:by_key
+;;
+
+let assoc_find l k = List.Assoc.find l ~equal:Int.equal k
+
+let same_pair_option what got expected =
+  if not (Option.equal [%equal: int * int] got expected)
+  then
+    Printf.ksprintf
+      failwith
+      "%s gives %s, expected %s"
+      what
+      (Sexp.to_string ([%sexp_of: (int * int) option] got))
+      (Sexp.to_string ([%sexp_of: (int * int) option] expected))
+;;
+
+let directions =
+  printed
+    (function
+      | `Greater_or_equal_to -> "`Greater_or_equal_to"
+      | `Greater_than -> "`Greater_than"
+      | `Less_or_equal_to -> "`Less_or_equal_to"
+      | `Less_than -> "`Less_than")
+    (sampled_from [ `Greater_or_equal_to; `Greater_than; `Less_or_equal_to; `Less_than ])
+;;
+
+let targets =
+  printed
+    (function
+      | `Last_strictly_less_than -> "`Last_strictly_less_than"
+      | `Last_less_than_or_equal_to -> "`Last_less_than_or_equal_to"
+      | `Last_equal_to -> "`Last_equal_to"
+      | `First_equal_to -> "`First_equal_to"
+      | `First_greater_than_or_equal_to -> "`First_greater_than_or_equal_to"
+      | `First_strictly_greater_than -> "`First_strictly_greater_than")
+    (sampled_from
+       [ `Last_strictly_less_than
+       ; `Last_less_than_or_equal_to
+       ; `Last_equal_to
+       ; `First_equal_to
+       ; `First_greater_than_or_equal_to
+       ; `First_strictly_greater_than
+       ])
+;;
+
+let target_holds which x k =
+  match which with
+  | `Last_strictly_less_than -> x < k
+  | `Last_less_than_or_equal_to -> x <= k
+  | `Last_equal_to | `First_equal_to -> x = k
+  | `First_greater_than_or_equal_to -> x >= k
+  | `First_strictly_greater_than -> x > k
+;;
+
+let target_is_last = function
+  | `Last_strictly_less_than | `Last_less_than_or_equal_to | `Last_equal_to -> true
+  | `First_equal_to | `First_greater_than_or_equal_to | `First_strictly_greater_than ->
+    false
+;;
+
+let maybe_bounds =
+  let show b = Sexp.to_string ([%sexp_of: int Maybe_bound.t] b) in
+  printed
+    show
+    (one_of
+       [ printed show (map (fun k -> Maybe_bound.Incl k) keys)
+       ; printed show (map (fun k -> Maybe_bound.Excl k) keys)
+       ; printed show (just Maybe_bound.Unbounded)
+       ])
+;;
+
+let in_bounds ~lower ~upper k =
+  Maybe_bound.is_lower_bound lower ~of_:k ~compare:Int.compare
+  && Maybe_bound.is_upper_bound upper ~of_:k ~compare:Int.compare
+;;
+
+let bindings = lists (tuples2 keys data) ~max_size:8 ()
+
+module%hegel_state_machine Map_machine = struct
+  type state =
+    { mutable m : int Map.M(Int).t
+    ; mutable model : (int * int) list
+    }
+
+  let sexp_of_state st = [%sexp_of: (int * int) list] st.model
+
+  let set tc st =
+    let key = draw tc keys in
+    let data = draw tc data in
+    st.m <- Map.set st.m ~key ~data;
+    st.model <- assoc_set st.model key data
+  [@@rule]
+  ;;
+
+  let add tc st =
+    let key = draw tc keys in
+    let data = draw tc data in
+    match Map.add st.m ~key ~data, assoc_find st.model key with
+    | `Ok m, None ->
+      st.m <- m;
+      st.model <- assoc_set st.model key data
+    | `Duplicate, Some _ -> ()
+    | _ -> failwith "add disagrees on whether the key is bound"
+  [@@rule]
+  ;;
+
+  let remove tc st =
+    let key = draw tc keys in
+    st.m <- Map.remove st.m key;
+    st.model <- List.Assoc.remove st.model ~equal:Int.equal key
+  [@@rule]
+  ;;
+
+  let update tc st =
+    let key = draw tc keys in
+    let f = function
+      | None -> 100
+      | Some v -> v + 1
+    in
+    st.m <- Map.update st.m key ~f;
+    st.model <- assoc_set st.model key (f (assoc_find st.model key))
+  [@@rule]
+  ;;
+
+  let change tc st =
+    let key = draw tc keys in
+    let f = function
+      | None -> Some 50
+      | Some v -> if v % 2 = 0 then None else Some (v * 2)
+    in
+    st.m <- Map.change st.m key ~f;
+    st.model
+    <- (match f (assoc_find st.model key) with
+        | None -> List.Assoc.remove st.model ~equal:Int.equal key
+        | Some v -> assoc_set st.model key v)
+  [@@rule]
+  ;;
+
+  let filter _tc st =
+    let f ~key ~data = (key + data) % 3 <> 0 in
+    st.m <- Map.filteri st.m ~f;
+    st.model <- List.filter st.model ~f:(fun (key, data) -> f ~key ~data)
+  [@@rule]
+  ;;
+
+  let split_and_append tc st =
+    let k = draw tc keys in
+    let lower, found, upper = Map.split st.m k in
+    same_pairs
+      "split (lower)"
+      (Map.to_alist lower)
+      (List.filter st.model ~f:(fun (k', _) -> k' < k));
+    same_pairs
+      "split (upper)"
+      (Map.to_alist upper)
+      (List.filter st.model ~f:(fun (k', _) -> k' > k));
+    same_pair_option "split" found (Option.map (assoc_find st.model k) ~f:(fun v -> k, v));
+    let upper =
+      Option.fold found ~init:upper ~f:(fun m (key, data) -> Map.set m ~key ~data)
+    in
+    match Map.append ~lower_part:lower ~upper_part:upper with
+    | `Ok m -> st.m <- m
+    | `Overlapping_key_ranges -> failwith "append reports overlapping key ranges"
+  [@@rule]
+  ;;
+
+  let splits tc st =
+    let k = draw tc keys in
+    let n = draw tc (integers ~min_value:(-1) ~max_value:(List.length st.model + 1) ()) in
+    let le, gt = Map.split_le_gt st.m k in
+    let lt, ge = Map.split_lt_ge st.m k in
+    let below f = List.filter st.model ~f:(fun (k', _) -> f k' k) in
+    same_pairs "split_le_gt" (Map.to_alist le @ Map.to_alist gt) st.model;
+    same_pairs "split_le_gt" (Map.to_alist le) (below ( <= ));
+    same_pairs "split_lt_ge" (Map.to_alist lt @ Map.to_alist ge) st.model;
+    same_pairs "split_lt_ge" (Map.to_alist lt) (below ( < ));
+    let front, back = Map.split_n st.m n in
+    same_pairs "split_n" (Map.to_alist front) (List.take st.model n);
+    same_pairs "split_n" (Map.to_alist back) (List.drop st.model n);
+    if
+      not
+        (List.equal
+           Int.equal
+           [ Map.count_lt st.m k
+           ; Map.count_le st.m k
+           ; Map.count_gt st.m k
+           ; Map.count_ge st.m k
+           ]
+           (List.map [ ( < ); ( <= ); ( > ); ( >= ) ] ~f:(fun f -> List.length (below f))))
+    then failwith "count_lt/le/gt/ge disagree"
+  [@@rule]
+  ;;
+
+  let merge tc st =
+    let other_bindings = draw tc bindings in
+    let other = Map.of_alist_reduce (module Int) other_bindings ~f:(fun _ b -> b) in
+    let other_model =
+      List.fold other_bindings ~init:[] ~f:(fun acc (k, v) -> assoc_set acc k v)
+    in
+    same_pairs "of_alist_reduce" (Map.to_alist other) other_model;
+    let merged =
+      Map.merge st.m other ~f:(fun ~key:_ -> function
+        | `Left a -> Some a
+        | `Right b -> Option.some_if (b % 2 = 0) b
+        | `Both (a, b) -> Some (a + b))
+    in
+    let keys =
+      List.dedup_and_sort (List.map (st.model @ other_model) ~f:fst) ~compare:Int.compare
+    in
+    st.model
+    <- List.filter_map keys ~f:(fun k ->
+         match assoc_find st.model k, assoc_find other_model k with
+         | Some a, None -> Some (k, a)
+         | None, Some b -> Option.some_if (b % 2 = 0) (k, b)
+         | Some a, Some b -> Some (k, a + b)
+         | None, None -> None);
+    st.m <- merged
+  [@@rule]
+  ;;
+
+  let queries tc st =
+    let k = draw tc keys in
+    let dir = draw tc directions in
+    let holds k' =
+      match dir with
+      | `Greater_or_equal_to -> k' >= k
+      | `Greater_than -> k' > k
+      | `Less_or_equal_to -> k' <= k
+      | `Less_than -> k' < k
+    in
+    let candidates = List.filter st.model ~f:(fun (k', _) -> holds k') in
+    same_pair_option
+      "closest_key"
+      (Map.closest_key st.m dir k)
+      (match dir with
+       | `Greater_or_equal_to | `Greater_than -> List.hd candidates
+       | `Less_or_equal_to | `Less_than -> List.last candidates);
+    let which = draw tc targets in
+    let matching = List.filter st.model ~f:(fun (k', _) -> target_holds which k' k) in
+    same_pair_option
+      "binary_search"
+      (Map.binary_search st.m ~compare:(fun ~key ~data:_ k -> Int.compare key k) which k)
+      (if target_is_last which then List.last matching else List.hd matching);
+    let i = draw tc (integers ~min_value:(-1) ~max_value:(List.length st.model) ()) in
+    same_pair_option "nth" (Map.nth st.m i) (if i < 0 then None else List.nth st.model i);
+    same_int_option
+      "rank"
+      (Map.rank st.m k)
+      (Option.map (assoc_find st.model k) ~f:(fun _ ->
+         List.count st.model ~f:(fun (k', _) -> k' < k)));
+    let lo = draw tc keys in
+    let in_range (k', _) = lo <= k' && k' <= k in
+    same_pairs
+      "range_to_alist"
+      (Map.range_to_alist st.m ~min:lo ~max:k)
+      (List.filter st.model ~f:in_range);
+    same_pairs
+      "fold_range_inclusive"
+      (List.rev
+         (Map.fold_range_inclusive st.m ~min:lo ~max:k ~init:[] ~f:(fun ~key ~data acc ->
+            (key, data) :: acc)))
+      (List.filter st.model ~f:in_range);
+    let increasing = draw tc (booleans ()) in
+    let order = if increasing then `Increasing_key else `Decreasing_key in
+    let expected = List.filter st.model ~f:in_range in
+    same_pairs
+      "to_sequence"
+      (Sequence.to_list
+         (Map.to_sequence
+            ~order
+            ~keys_greater_or_equal_to:lo
+            ~keys_less_or_equal_to:k
+            st.m))
+      (if increasing then expected else List.rev expected);
+    let lower = draw tc maybe_bounds in
+    let upper = draw tc maybe_bounds in
+    same_pairs
+      "subrange"
+      (Map.to_alist (Map.subrange st.m ~lower_bound:lower ~upper_bound:upper))
+      (List.filter st.model ~f:(fun (k', _) -> in_bounds ~lower ~upper k'))
+  [@@rule]
+  ;;
+
+  let contents _tc st =
+    same_pairs "to_alist" (Map.to_alist st.m) st.model;
+    if not (Map.invariants st.m) then failwith "invariants do not hold";
+    if Map.length st.m <> List.length st.model
+    then Printf.ksprintf failwith "length %d" (Map.length st.m);
+    same_pair_option "min_elt" (Map.min_elt st.m) (List.hd st.model);
+    same_pair_option "max_elt" (Map.max_elt st.m) (List.last st.model)
+  [@@invariant]
+  ;;
+end
