+let show_strings l = Sexp.to_string ([%sexp_of: string list] l)
+let show_ints l = Sexp.to_string ([%sexp_of: int list] l)
+
+let same_strings what got expected =
+  if not (List.equal String.equal got expected)
+  then
+    Printf.ksprintf
+      failwith
+      "%s gives %s, expected %s"
+      what
+      (show_strings got)
+      (show_strings expected)
+;;
+
+let same_ints what got expected =
+  if not (List.equal Int.equal got expected)
+  then
+    Printf.ksprintf
+      failwith
+      "%s gives %s, expected %s"
+      what
+      (show_ints got)
+      (show_ints expected)
+;;
+
+let same_string what got expected =
+  if not (String.equal got expected)
+  then Printf.ksprintf failwith "%s gives %S, expected %S" what got expected
+;;
+
+let same_int_option what got expected =
+  if not (Option.equal Int.equal got expected)
+  then
+    Printf.ksprintf
+      failwith
+      "%s gives %s, expected %s"
+      what
+      (Sexp.to_string ([%sexp_of: int option] got))
+      (Sexp.to_string ([%sexp_of: int option] expected))
+;;
+
+let occurs ~case_sensitive ~pattern s i =
+  let fold = if case_sensitive then Fn.id else String.lowercase in
+  i + String.length pattern <= String.length s
+  && String.equal (fold (String.sub s ~pos:i ~len:(String.length pattern))) (fold pattern)
+;;
+
+let occurrences ~case_sensitive ~pattern s =
+  List.filter (List.range 0 (String.length s + 1)) ~f:(occurs ~case_sensitive ~pattern s)
+;;
+
+let disjoint_occurrences ~case_sensitive ~pattern s =
+  List.rev
+    (List.fold (occurrences ~case_sensitive ~pattern s) ~init:[] ~f:(fun acc i ->
+       match acc with
+       | j :: _ when i < j + String.length pattern -> acc
+       | _ -> i :: acc))
+;;
+
+let splice s ~at ~len ~with_ =
+  String.sub s ~pos:0 ~len:at
+  ^ with_
+  ^ String.sub s ~pos:(at + len) ~len:(String.length s - at - len)
+;;
+
+let%hegel_test string_search tc =
+  let s = draw tc (text ~alphabet:"abAB" ~max_size:12 ()) in
+  let pattern = draw tc (text ~alphabet:"abAB" ~max_size:3 ()) in
+  let with_ = draw tc (text ~alphabet:"xy" ~max_size:2 ()) in
+  let case_sensitive = draw tc (booleans ()) in
+  let pos = draw tc (integers ~min_value:(-1) ~max_value:(String.length s + 1) ()) in
+  let t = String.Search_pattern.create ~case_sensitive pattern in
+  let all = occurrences ~case_sensitive ~pattern s in
+  let disjoint = disjoint_occurrences ~case_sensitive ~pattern s in
+  let len = String.length pattern in
+  let from_pos =
+    if pos < 0 || pos >= String.length s
+    then None
+    else List.find all ~f:(fun i -> i >= pos)
+  in
+  (* the code finds an empty pattern at pos = length s, which the documentation rules out;
+     not judged *)
+  if not (String.is_empty pattern && pos = String.length s)
+  then (
+    same_int_option "index ~pos" (String.Search_pattern.index ~pos t ~in_:s) from_pos;
+    same_string
+      "replace_first ~pos"
+      (String.Search_pattern.replace_first ~pos t ~in_:s ~with_)
+      (match from_pos with
+       | None -> s
+       | Some at -> splice s ~at ~len ~with_));
+  same_ints
+    "index_all ~may_overlap:true"
+    (String.Search_pattern.index_all t ~may_overlap:true ~in_:s)
+    all;
+  same_ints
+    "index_all ~may_overlap:false"
+    (String.Search_pattern.index_all t ~may_overlap:false ~in_:s)
+    disjoint;
+  same_string
+    "replace_all"
+    (String.Search_pattern.replace_all t ~in_:s ~with_)
+    (List.fold_right disjoint ~init:s ~f:(fun at acc -> splice acc ~at ~len ~with_));
+  if not (Bool.equal (String.Search_pattern.matches t s) (not (List.is_empty all)))
+  then failwith "matches disagrees";
+  if case_sensitive
+  then (
+    if
+      not
+        (Bool.equal (String.is_substring s ~substring:pattern) (not (List.is_empty all)))
+    then failwith "is_substring disagrees";
+    if
+      pos >= 0
+      && pos <= String.length s
+      && not
+           (Bool.equal
+              (String.is_substring_at s ~pos ~substring:pattern)
+              (occurs ~case_sensitive ~pattern s pos))
+    then failwith "is_substring_at disagrees";
+    same_ints
+      "substr_index_all"
+      (String.substr_index_all s ~may_overlap:false ~pattern)
+      disjoint)
+  else (
+    if
+      not
+        (Bool.equal
+           (String.Caseless.is_substring s ~substring:pattern)
+           (not (List.is_empty all)))
+    then failwith "Caseless.is_substring disagrees";
+    same_ints
+      "Caseless.substr_index_all"
+      (String.Caseless.substr_index_all s ~may_overlap:true ~pattern)
+      all);
+  if len > 0
+  then (
+    let starts = 0 :: List.map disjoint ~f:(fun i -> i + len) in
+    let stops = disjoint @ [ String.length s ] in
+    same_strings
+      "split_on"
+      (String.Search_pattern.split_on t s)
+      (List.map2_exn starts stops ~f:(fun a b -> String.sub s ~pos:a ~len:(b - a))))
+;;
+
+let%hegel_test string_split tc =
+  let s = draw tc (text ~alphabet:"ab,;\r\n" ~max_size:12 ()) in
