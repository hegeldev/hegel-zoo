+let%hegel_test string_trim tc =
+  let s = draw tc (text ~alphabet:"ab -\t" ~max_size:10 ()) in
+  let affix = draw tc (text ~alphabet:"ab -" ~max_size:3 ()) in
+  let n = draw tc (integers ~min_value:(-1) ~max_value:12 ()) in
+  let dash = draw tc (booleans ()) in
+  let drop c = if dash then Char.equal c '-' else Char.is_whitespace c in
+  let chars = String.to_list s in
+  let rec skip = function
+    | c :: rest when drop c -> skip rest
+    | l -> l
+  in
+  let lstripped = String.of_list (skip chars) in
+  let rstripped = String.of_list (List.rev (skip (List.rev chars))) in
+  let stripped = String.of_list (List.rev (skip (List.rev (skip chars)))) in
+  let strip_args = if dash then Some drop else None in
+  same_string "lstrip" (String.lstrip ?drop:strip_args s) lstripped;
+  same_string "rstrip" (String.rstrip ?drop:strip_args s) rstripped;
+  same_string "strip" (String.strip ?drop:strip_args s) stripped;
+  let len = String.length s in
+  let k = Int.clamp_exn n ~min:0 ~max:len in
+  let starts =
+    String.length affix <= len
+    && String.equal (String.sub s ~pos:0 ~len:(String.length affix)) affix
+  in
+  let ends =
+    String.length affix <= len
+    && String.equal
+         (String.sub s ~pos:(len - String.length affix) ~len:(String.length affix))
+         affix
+  in
+  let rest = Int.max 0 (len - String.length affix) in
+  let rest_after = String.sub s ~pos:(len - rest) ~len:rest in
+  let rest_before = String.sub s ~pos:0 ~len:rest in
+  if not (Bool.equal (String.is_prefix s ~prefix:affix) starts)
+  then failwith "is_prefix disagrees";
+  if not (Bool.equal (String.is_suffix s ~suffix:affix) ends)
+  then failwith "is_suffix disagrees";
+  if
+    not
+      (Option.equal
+         String.equal
+         (String.chop_prefix s ~prefix:affix)
+         (Option.some_if starts rest_after))
+  then failwith "chop_prefix disagrees";
+  if
+    not
+      (Option.equal
+         String.equal
+         (String.chop_suffix s ~suffix:affix)
+         (Option.some_if ends rest_before))
+  then failwith "chop_suffix disagrees";
+  same_string
+    "chop_prefix_if_exists"
+    (String.chop_prefix_if_exists s ~prefix:affix)
+    (if starts then rest_after else s);
+  same_string
+    "chop_suffix_if_exists"
+    (String.chop_suffix_if_exists s ~suffix:affix)
+    (if ends then rest_before else s);
+  if n >= 0
+  then (
+    same_string "prefix" (String.prefix s n) (String.sub s ~pos:0 ~len:k);
+    same_string "suffix" (String.suffix s n) (String.sub s ~pos:(len - k) ~len:k);
+    same_string
+      "drop_prefix"
+      (String.drop_prefix s n)
+      (String.sub s ~pos:k ~len:(len - k));
+    same_string
+      "drop_suffix"
+      (String.drop_suffix s n)
+      (String.sub s ~pos:0 ~len:(len - k));
+    let fill = String.make (Int.max 0 (n - len)) '.' in
+    same_string "pad_left" (String.pad_left s ~char:'.' ~len:n) (fill ^ s);
+    same_string "pad_right" (String.pad_right s ~char:'.' ~len:n) (s ^ fill))
+;;
+
+let%hegel_test string_tr_multi tc =
+  let target = draw tc (text ~alphabet:"abcd" ~max_size:5 ()) in
