+let%hegel_test array_sorting tc =
+  let keys = draw tc (lists (integers ~min_value:0 ~max_value:6 ()) ~max_size:70 ()) in
+  let l = List.mapi keys ~f:(fun i k -> k, i) in
+  let n = List.length l in
+  let compare (a, _) (b, _) = Int.compare a b in
+  let pos, len = draw tc (pos_len n) in
+  let sorted_slice a b = List.sort (slice keys a b) ~compare:Int.compare in
+  let expect what arr ~lo ~hi =
+    let got = Array.to_list arr in
+    same_ints
+      what
+      (List.map got ~f:fst)
+      (slice keys 0 lo @ sorted_slice lo hi @ slice keys hi n);
+    same_pairs
+      (what ^ " (as a permutation)")
+      (List.sort got ~compare:[%compare: int * int])
+      (List.sort l ~compare:[%compare: int * int]);
+    same_pairs
+      (what ^ " (outside the range)")
+      (slice got 0 lo @ slice got hi n)
+      (slice l 0 lo @ slice l hi n)
+  in
+  let arr = Array.of_list l in
+  Array.sort ~pos ~len arr ~compare;
+  expect "sort ~pos ~len" arr ~lo:pos ~hi:(pos + len);
+  let arr = Array.of_list l in
+  Array.sort arr ~compare;
+  expect "sort" arr ~lo:0 ~hi:n;
+  let arr = Array.of_list l in
+  Array.stable_sort arr ~compare;
+  same_pairs "stable_sort" (Array.to_list arr) (List.stable_sort l ~compare);
+  same_ints
+    "sorted_copy"
+    (List.map (Array.to_list (Array.sorted_copy (Array.of_list l) ~compare)) ~f:fst)
+    (sorted_slice 0 n);
+  if len > 0
+  then (
+    let left = pos
+    and right = pos + len - 1 in
+    List.iter
+      [ "Insertion_sort", Array.Private.Sort.Insertion_sort.sort
+      ; "Heap_sort", Array.Private.Sort.Heap_sort.sort
+      ; "Intro_sort", Array.Private.Sort.Intro_sort.sort
+      ]
+      ~f:(fun (what, sort) ->
+        let arr = Array.of_list l in
+        sort arr ~compare ~left ~right;
+        expect what arr ~lo:left ~hi:(right + 1)))
+;;
+
+let global_index (local_ i : int option) =
+  match i with
+  | None -> None
+  | Some i -> Some i
