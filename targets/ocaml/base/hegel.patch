+++ b/hegel/zoo.ml
@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
diff --git a/hegel/zoo_tests.ml b/hegel/zoo_tests.ml
new file mode 100644
index 0000000..d7878e0
--- /dev/null
+++ b/hegel/zoo_tests.ml
@@ -0,0 +1,2369 @@
+open Hegel
+open Base
+
+let printed show g = with_printer (fun x -> Sexp.Atom (show x)) g
+
+let script =
+  {|
+import math, struct, sys
+from fractions import Fraction
+
+def flo(s):
+    return struct.unpack('<d', struct.pack('<q', int(s)))[0]
+
+def bits(x):
+    return str(struct.unpack('<q', struct.pack('<d', x))[0])
+
+def ints(n, x):
+    n, x = int(n), int(x)
+    a, s, u = abs(x), '-' if x < 0 else '', x & ((1 << n) - 1)
+    return [str(x), format(x, '_'), s + '0x' + format(a, 'x'), s + '0x' + format(a, '_x'),
+            '0b' + format(u, 'b'), '0b' + format(u, '_b')]
+
+def arith(n, x, y):
+    n, x, y = int(n), int(x), int(y)
+    lo, hi = -(1 << (n - 1)), (1 << (n - 1)) - 1
+    fit = lambda v: str(v) if lo <= v <= hi else '!'
+    out = []
+    if y != 0:
+        q = abs(x) // abs(y) * (1 if (x < 0) == (y < 0) else -1)
+        out += [fit(q), fit(x - y * q)]
+    else:
+        out += ['!', '!']
+    if y > 0:
+        d, u = x // y * y, -((-x) // y) * y
+        out += [fit(x % y), fit(x // y), fit(d), fit(u), fit(d if x >= 0 else u),
+                fit(u if u - x <= x - d else d)]
+    else:
+        out += ['!'] * 6
+    if x > 0:
+        f = 1 << (x.bit_length() - 1)
+        out += [str(x.bit_length() - 1), str((x - 1).bit_length()), fit(f),
+                fit(f if f == x else 2 * f), 'true' if f == x else 'false']
+    else:
+        out += ['!'] * 5
+    u = x & ((1 << n) - 1)
+    out += [str(bin(u).count('1'))]
+    out += [str(n - u.bit_length()), str((u & -u).bit_length() - 1)] if u else ['!', '!']
+    return out
+
+def power(n, x, e):
+    n, x, e = int(n), int(x), int(e)
+    if e < 0:
+        return ['!']
+    v = x ** e
+    return [str(v) if -(1 << (n - 1)) <= v < (1 << (n - 1)) else '!']
+
+def digits(s):
+    return str(max(len(s.lstrip('+-').split('e')[0].replace('.', '').strip('0')), 1))
+
+def shortest(x, ours):
+    r = repr(flo(x))
+    return [r, digits(r), digits(ours)]
+
+def fround(x):
+    f = Fraction(flo(x))
+    vs = [math.floor(f), math.ceil(f), math.trunc(f), math.floor(f + Fraction(1, 2)), round(f)]
+    return [bits(float(v)) for v in vs] + [str(v) for v in vs]
+
+def capped(f):
+    try:
+        return bits(f())
+    except OverflowError:
+        return '!'
+
+def rsig(x, n):
+    return [bits(float('%.*g' % (int(n), flo(x))))]
+
+def rdec(x, n):
+    return [capped(lambda: round(flo(x), int(n)))]
+
+def hum(x, d, delim, strip, plus):
+    s = format(flo(x), ('+' if plus == '1' else '') + '_.' + d + 'f')
+    s = s.replace('_', chr(int(delim)))
+    if strip == '1' and '.' in s:
+        left, right = s.split('.')
+        right = right.rstrip('0')
+        s = left + ('.' + right if right else '')
+    return [s]
+
+def compact(x, prefix, *names):
+    x = flo(x)
+    prefix = bytes.fromhex(prefix[1:]).decode('latin-1')
+    names = [bytes.fromhex(n[1:]).decode('latin-1') for n in names]
+    def go(t):
+        if t < 999.95:
+            s = prefix + '%.1f' % t
+            return s[:-2] + '  ' if s.endswith('.0') else s
+        scales = [(999.95e3, 100), (999.95e6, 100_000), (999.95e9, 100_000_000),
+                  (999.95e12, 100_000_000_000), (999.95e15, 100_000_000_000_000)]
+        for (bound, d), name in zip(scales, names):
+            if t < bound:
+                i, r = divmod(round(Fraction(t) / d), 10)
+                return '%s%d%s%s' % (prefix, i, name, r if r else ' ')
+        return prefix + '%.1e' % t
+    if math.isnan(x):
+        s = 'nan  '
+    elif math.isinf(x):
+        s = 'inf  ' if x > 0 else '-inf  '
+    else:
+        s = go(x) if x >= 0 else '-' + go(-x)
+    return [s]
+
+def sexp(h):
+    s, i = bytes.fromhex(h[1:]), 0
+    def blanks():
+        nonlocal i
+        while i < len(s) and s[i] in b' \t\n\r\x0c':
+            i += 1
+    def quoted():
+        nonlocal i
+        out = bytearray()
+        i += 1
+        while s[i] != ord('"'):
+            c = s[i]
+            if c != ord('\\'):
+                out.append(c)
+                i += 1
+                continue
+            e = s[i + 1]
+            i += 2
+            if e in b'0123456789':
+                out.append(int(s[i - 1:i + 2]))
+                i += 2
+            elif e == ord('x'):
+                out.append(int(s[i:i + 2], 16))
+                i += 2
+            elif e == ord('\n'):
+                while s[i] in b' \t':
+                    i += 1
+            else:
+                out += {ord('n'): b'\n', ord('t'): b'\t', ord('b'): b'\b', ord('r'): b'\r',
+                        ord(' '): b' ', ord('\\'): b'\\', ord('"'): b'"', ord("'"): b"'"}[e]
+        i += 1
+        return 'a' + out.hex() + ';'
+    def item():
+        nonlocal i
+        blanks()
+        if s[i] == ord('('):
+            i += 1
+            parts = []
+            blanks()
+            while s[i] != ord(')'):
+                parts.append(item())
+                blanks()
+            i += 1
+            return '(' + ''.join(parts) + ')'
+        if s[i] == ord('"'):
+            return quoted()
+        j = i
+        while i < len(s) and s[i] not in b' \t\n\r\x0c()";':
+            i += 1
+        atom = s[j:i]
+        if atom.startswith(b'#|') or atom.startswith(b'#;') or b'|#' in atom or b'#|' in atom:
+            raise ValueError
+        return 'a' + atom.hex() + ';'
+    try:
+        r = item()
+        blanks()
+        return [r if i == len(s) else 'trailing']
+    except (IndexError, KeyError, ValueError):
+        return ['unreadable']
+
+def irange(a, b, stride, start, stop):
+    a, b, stride = int(a), int(b), int(stride)
+    lo, hi = -(1 << 62), (1 << 62) - 1
+    first = a if start == 'inclusive' else a + stride
+    end = b + (1 if stride > 0 else -1) if stop == 'inclusive' else b
+    r = range(first, end, stride)
+    if len(r) > 60:
+        return ['long']
+    past = [x + stride for x in ([a] + list(r))]
+    wraps = any(not lo <= x <= hi for x in past)
+    return ['wraps' if wraps else 'fits'] + [str(x) for x in r]
+
+def utf(codec, h):
+    b = bytes.fromhex(h[1:])
+    try:
+        valid, text = '1', b.decode(codec)
+    except UnicodeDecodeError:
+        valid, text = '0', b.decode(codec, 'replace')
+    return [valid, ' '.join(str(ord(c)) for c in text)]
+
+ops = {'utf': utf, 'range': irange, 'ints': ints, 'arith': arith, 'pow': power, 'shortest': shortest, 'fround': fround,
+       'rsig': rsig, 'rdec': rdec, 'hum': hum, 'compact': compact, 'sexp': sexp}
+for line in sys.stdin:
+    op, *args = line.split()
+    sys.stdout.write('\t'.join(ops[op](*args)) + '\n')
+    sys.stdout.flush()
+|}
+;;
+
+let python = lazy (Unix.open_process_args "python3" [| "python3"; "-c"; script |])
+
+let ask args =
+  let ic, oc = Lazy.force python in
+  Stdlib.output_string oc (String.concat ~sep:" " args ^ "\n");
+  Stdlib.flush oc;
+  String.split (Stdlib.input_line ic) ~on:'\t'
+;;
+
+let hex_digits s = String.concat_map s ~f:(fun c -> Printf.sprintf "%02x" (Char.to_int c))
+
+(* never empty, so that an empty string is still an argument *)
+let hex s = "x" ^ hex_digits s
+
+let agree what expected got =
+  if not (String.equal expected "!")
+  then (
+    match got () with
+    | v ->
+      if not (String.equal v expected)
+      then Printf.ksprintf failwith "%s gives %s, expected %s" what v expected
+    | exception e ->
+      Printf.ksprintf failwith "%s raises %s, expected %s" what (Exn.to_string e) expected)
+;;
+
+let raises what f =
+  match f () with
+  | _ -> Printf.ksprintf failwith "%s does not raise" what
+  | exception _ -> ()
+;;
+
+module Int_props (I : sig
+    include Int.S
+
+    val bits : int
+    val of_int64_trunc : int64 -> t
+  end) =
+struct
+  let show x = Stdlib.Int64.to_string (I.to_int64 x)
+  let ints lo hi = integers ~min_value:lo ~max_value:hi ()
+
+  let values =
+    printed
+      show
+      (one_of
+         [ printed
+             show
+             (map (fun x -> I.of_int64_trunc (Int64.of_int x)) (ints (-300) 300))
+         ; printed
+             show
+             (map
+                (fun (hi, lo, s) ->
+                   I.of_int64_trunc
+                     Int64.(
+                       shift_right (bit_or (shift_left (of_int hi) 32) (of_int lo)) s))
+                (tuples3
+                   (ints (-(1 lsl 31)) ((1 lsl 31) - 1))
+                   (ints 0 ((1 lsl 32) - 1))
+                   (ints 0 63)))
+         ; printed
+             show
+             (map
+                (fun (top, k) ->
+                   if top
+                   then I.(max_value - of_int_exn k)
+                   else I.(min_value + of_int_exn k))
+                (tuples2 (booleans ()) (ints 0 3)))
+         ; printed
+             show
+             (map
+                (fun (b, k) -> I.(shift_left one b + of_int_exn k))
+                (tuples2 (ints 0 (I.bits - 1)) (ints (-1) 1)))
+         ])
+  ;;
+
+  let delimiters = printed Char.to_string (sampled_from [ '_'; ','; ' ' ])
+
+  let conversions tc =
+    let x = draw tc values in
+    let delimiter = draw tc delimiters in
+    match ask [ "ints"; Int.to_string I.bits; show x ] with
+    | [ dec; hum; hx; hx_hum; bin; bin_hum ] ->
+      let delimited s = String.tr s ~target:'_' ~replacement:delimiter in
+      agree "to_string" dec (fun () -> I.to_string x);
+      agree "to_string_hum" (delimited hum) (fun () -> I.to_string_hum ~delimiter x);
+      agree "Hex.to_string" hx (fun () -> I.Hex.to_string x);
+      agree "Hex.to_string_hum" (delimited hx_hum) (fun () ->
+        I.Hex.to_string_hum ~delimiter x);
+      agree "Binary.to_string" bin (fun () -> I.Binary.to_string x);
+      agree "Binary.to_string_hum" (delimited bin_hum) (fun () ->
+        I.Binary.to_string_hum ~delimiter x);
+      agree "sexp_of_t" dec (fun () -> Sexp.to_string (I.sexp_of_t x));
+      List.iter
+        [ "of_string", (fun s -> I.of_string s), dec
+        ; "of_string", (fun s -> I.of_string s), hum
+        ; "Hex.of_string", (fun s -> I.Hex.of_string s), hx
+        ; "Hex.of_string", (fun s -> I.Hex.of_string s), hx_hum
+        ; "t_of_sexp", (fun s -> I.t_of_sexp (Sexp.Atom s)), hum
+        ]
+        ~f:(fun (what, f, s) ->
+          agree (Printf.sprintf "%s %S" what s) (show x) (fun () -> show (f s)))
+    | _ -> failwith "oracle"
+  ;;
+
+  let arith tc =
+    let x = draw tc values in
+    let y = draw tc values in
+    match ask [ "arith"; Int.to_string I.bits; show x; show y ] with
+    | [ quot
+      ; rem
+      ; modulo
+      ; floor_div
+      ; down
+      ; up
+      ; zero
+      ; nearest
+      ; floor_log2
+      ; ceil_log2
+      ; floor_pow2
+      ; ceil_pow2
+      ; is_pow2
+      ; popcount
+      ; clz
+      ; ctz
+      ] ->
+      if I.equal y I.zero
+      then (
+        raises "x / 0" (fun () -> I.(x / y));
+        raises "rem x 0" (fun () -> I.rem x y));
+      agree "x / y" quot (fun () -> show I.(x / y));
+      agree "rem x y" rem (fun () -> show (I.rem x y));
+      if I.(y <= zero)
+      then (
+        raises "x % y" (fun () -> I.(x % y));
+        raises "x /% y" (fun () -> I.(x /% y));
+        raises "round" (fun () -> I.round x ~to_multiple_of:y));
+      agree "x % y" modulo (fun () -> show I.(x % y));
+      agree "x /% y" floor_div (fun () -> show I.(x /% y));
+      agree "round_down" down (fun () -> show (I.round_down x ~to_multiple_of:y));
+      agree "round_up" up (fun () -> show (I.round_up x ~to_multiple_of:y));
+      agree "round_towards_zero" zero (fun () ->
+        show (I.round_towards_zero x ~to_multiple_of:y));
+      agree "round_nearest" nearest (fun () ->
+        show (I.round ~dir:`Nearest x ~to_multiple_of:y));
+      if I.(x <= zero)
+      then (
+        raises "floor_log2" (fun () -> I.floor_log2 x);
+        raises "ceil_log2" (fun () -> I.ceil_log2 x);
+        raises "is_pow2" (fun () -> I.is_pow2 x));
+      agree "floor_log2" floor_log2 (fun () -> show (I.floor_log2 x));
+      agree "ceil_log2" ceil_log2 (fun () -> show (I.ceil_log2 x));
+      agree "floor_pow2" floor_pow2 (fun () -> show (I.floor_pow2 x));
+      agree "is_pow2" is_pow2 (fun () -> Bool.to_string (I.is_pow2 x));
+      agree "popcount" popcount (fun () -> show (I.popcount x));
+      agree "clz" clz (fun () -> show (I.clz x));
+      agree "ctz" ctz (fun () -> show (I.ctz x));
+      (* base/2: ceil_pow2 of a number that is not a power of two *)
+      if Zoo.known || String.equal is_pow2 "true"
+      then agree "ceil_pow2" ceil_pow2 (fun () -> show (I.ceil_pow2 x))
+    | _ -> failwith "oracle"
+  ;;
+
+  (* base/1: a power whose base is min_value, or whose value is min_value; base/4: for
+     Nativeint, a base or a power beyond 63 bits *)
+  let min_value_powers =
+    let n = I.bits - 1 in
+    let negated_powers_of_two =
+      List.filter_map (List.range 1 n) ~f:(fun k ->
+        Option.some_if (n % k = 0 && n / k % 2 = 1) (I.(neg (shift_left one k)), n / k))
+    in
+    printed
+      (fun (b, e) -> Printf.sprintf "%s ** %d" (show b) e)
+      (sampled_from (negated_powers_of_two @ List.init 6 ~f:(fun e -> I.min_value, e)))
+  ;;
+
+  let powers =
+    let general =
+      printed
+        (fun (b, e) -> Printf.sprintf "%s ** %d" (show b) e)
+        (tuples2
+           (one_of [ printed show (map I.of_int_exn (ints (-10) 10)); values ])
+           (ints (-2) 70))
+    in
+    one_of
+      (if Zoo.known
+       then [ min_value_powers; general; general; general; general ]
+       else [ general ])
+  ;;
+
+  let pow tc =
+    let b, e = draw tc powers in
+    match ask [ "pow"; Int.to_string I.bits; show b; Int.to_string e ] with
+    | [ expected ] ->
+      let beyond_int v = Option.is_none (Stdlib.int_of_string_opt v) in
+      let shape =
+        I.equal b I.min_value
+        || String.equal expected (show I.min_value)
+        || ((not (String.equal expected "!")) && beyond_int expected)
+        || beyond_int (show b)
+      in
+      if Zoo.known || not shape
+      then
+        if e < 0 || String.equal expected "!"
+        then (
+          match I.pow b (I.of_int_exn e) with
+          | v -> Printf.ksprintf failwith "gives %s, expected an exception" (show v)
+          | exception _ -> ())
+        else agree "pow" expected (fun () -> show (I.pow b (I.of_int_exn e)))
+    | _ -> failwith "oracle"
+  ;;
+end
+
+module Int_t = Int_props (struct
+    include Int
+
+    let bits = 63
+    let of_int64_trunc = Int.of_int64_trunc
+  end)
+
+module Int32_t = Int_props (struct
+    include Int32
+
+    let bits = 32
+    let of_int64_trunc = Int32.of_int64_trunc
+  end)
+
+module Int64_t = Int_props (struct
+    include Int64
+
+    let bits = 64
+    let of_int64_trunc x = x
+  end)
+
+module Nativeint_t = Int_props (struct
+    include Nativeint
+
+    let bits = 64
+    let of_int64_trunc = Nativeint.of_int64_trunc
+  end)
+
+module Int63_emul_t = Int_props (struct
+    include Int63.Private.Emul
+
+    let bits = 63
+  end)
+
+let%hegel_test int_conversions tc = Int_t.conversions tc
+let%hegel_test int_arith tc = Int_t.arith tc
+let%hegel_test int_pow tc = Int_t.pow tc
+let%hegel_test int32_conversions tc = Int32_t.conversions tc
+let%hegel_test int32_arith tc = Int32_t.arith tc
+let%hegel_test int32_pow tc = Int32_t.pow tc
+let%hegel_test int64_conversions tc = Int64_t.conversions tc
+let%hegel_test int64_arith tc = Int64_t.arith tc
+let%hegel_test int64_pow tc = Int64_t.pow tc
+let%hegel_test nativeint_conversions tc = Nativeint_t.conversions tc
+let%hegel_test nativeint_arith tc = Nativeint_t.arith tc
+let%hegel_test nativeint_pow tc = Nativeint_t.pow tc
+let%hegel_test int63_emul_conversions tc = Int63_emul_t.conversions tc
+let%hegel_test int63_emul_arith tc = Int63_emul_t.arith tc
+let%hegel_test int63_emul_pow tc = Int63_emul_t.pow tc
+let show_float x = Printf.sprintf "%h (%.17g)" x x
+let float_arg x = Stdlib.Int64.to_string (Stdlib.Int64.bits_of_float x)
+let float_of_arg s = Stdlib.Int64.float_of_bits (Stdlib.Int64.of_string s)
+let same_float a b = Float.equal a b || (Float.is_nan a && Float.is_nan b)
+
+let decimal_floats =
+  printed
+    show_float
+    (map
+       (fun (m, e) -> Stdlib.float_of_string (Printf.sprintf "%de%d" m e))
+       (tuples2
+          (integers ~min_value:(-2_000_000) ~max_value:2_000_000 ())
+          (integers ~min_value:(-12) ~max_value:22 ())))
+;;
+
+let binary_floats =
+  printed
+    show_float
+    (map
+       (fun (m, e) -> Stdlib.ldexp (Stdlib.float_of_int m) e)
+       (tuples2
+          (integers ~min_value:(-(1 lsl 54)) ~max_value:(1 lsl 54) ())
+          (integers ~min_value:(-60) ~max_value:12 ())))
+;;
+
+let finite_floats =
+  printed
+    show_float
+    (one_of
+       [ floats ~allow_nan:false ~allow_infinity:false (); decimal_floats; binary_floats ])
+;;
+
+let%hegel_test float_to_string tc =
+  let x =
+    draw tc (printed show_float (one_of [ floats (); decimal_floats; binary_floats ]))
+  in
+  let s = Float.to_string x in
+  match ask [ "shortest"; float_arg x; s ] with
+  | [ python; shortest; ours ] ->
+    (match Float.of_string s with
+     | back ->
+       if not (same_float back x)
+       then Printf.ksprintf failwith "%S reads back as %h" s back
+     | exception e ->
+       Printf.ksprintf failwith "%S does not read back: %s" s (Exn.to_string e));
+    let shortest = Int.of_string shortest
+    and ours = Int.of_string ours in
+    (* documented: occasionally 17 significant digits where 16 would do *)
+    if (shortest <= 15 && ours <> shortest) || ours > 17
+    then Printf.ksprintf failwith "to_string gives %S, Python's shortest is %S" s python;
+    if not (same_float (Float.of_string python) x)
+    then Printf.ksprintf failwith "of_string %S gives %h" python (Float.of_string python)
+  | _ -> failwith "oracle"
+;;
+
+let%hegel_test float_round tc =
+  let x = draw tc finite_floats in
+  match ask [ "fround"; float_arg x ] with
+  | [ down; up; zero; nearest; even; down_i; up_i; zero_i; nearest_i; _ ] ->
+    let check what got expected =
+      let expected = float_of_arg expected in
+      if not (Float.equal got expected)
+      then Printf.ksprintf failwith "%s gives %h, expected %h" what got expected
+    in
+    check "round_down" (Float.round_down x) down;
+    check "round_up" (Float.round_up x) up;
+    check "round_towards_zero" (Float.round_towards_zero x) zero;
+    check "round_nearest" (Float.round_nearest x) nearest;
+    check "round_nearest_half_to_even" (Float.round_nearest_half_to_even x) even;
+    check "round ~dir:`Nearest" (Float.round ~dir:`Nearest x) nearest;
+    let in_range = Float.(Float.iround_lbound <= x && x <= Float.iround_ubound) in
+    List.iter
+      [ "iround_down", Float.iround_down x, down_i
+      ; "iround_up", Float.iround_up x, up_i
+      ; "iround_towards_zero", Float.iround_towards_zero x, zero_i
+      ; "iround_nearest", Float.iround_nearest x, nearest_i
+      ; "iround ~dir:`Down", Float.iround ~dir:`Down x, down_i
+      ]
+      ~f:(fun (what, got, expected) ->
+        let expected = if in_range then Some (Stdlib.int_of_string expected) else None in
+        if not (Option.equal Int.equal got expected)
+        then
+          Printf.ksprintf
+            failwith
+            "%s gives %s, expected %s"
+            what
+            (Option.value_map got ~default:"None" ~f:Int.to_string)
+            (Option.value_map expected ~default:"None" ~f:Int.to_string))
+  | _ -> failwith "oracle"
+;;
