+(* base/5: more than 22 decimal digits either way, and x within a digit of the rounding
+   unit 10^-n *)
+let near_unit_decimals =
+  printed
+    (fun (x, n) -> Printf.sprintf "%s ~decimal_digits:%d" (show_float x) n)
+    (map
+       (fun (d, k, small) ->
+          let k = if small then -k else k in
+          ( Stdlib.float_of_string (Printf.sprintf "%d.%02de%d" (d / 100) (d % 100) k)
+          , -(k + 1) ))
+       (tuples3
+          (integers ~min_value:101 ~max_value:899 ())
+          (integers ~min_value:24 ~max_value:40 ())
+          (booleans ())))
+;;
+
+let near_unit x n =
+  let lo = Float.int_pow 10. (-n - 2)
+  and hi = Float.int_pow 10. (1 - n) in
+  Int.abs n > 22 && Float.(abs x >= lo && abs x < hi)
+;;
