+let%hegel_test array_binary_search tc =
+  let keys = draw tc (lists (integers ~min_value:0 ~max_value:8 ()) ~max_size:40 ()) in
+  let arr = Array.of_list (List.sort keys ~compare:Int.compare) in
+  let n = Array.length arr in
+  let pos, len = draw tc (pos_len n) in
+  let k = draw tc (integers ~min_value:(-1) ~max_value:9 ()) in
+  let which = draw tc targets in
+  let indices = List.range pos (pos + len) in
+  let matching = List.filter indices ~f:(fun i -> target_holds which arr.(i) k) in
+  same_int_option
+    "binary_search"
+    (global_index (Array.binary_search ~pos ~len arr ~compare:Int.compare which k))
+    (if target_is_last which then List.last matching else List.hd matching);
+  let left = List.filter indices ~f:(fun i -> arr.(i) <= k) in
+  let right = List.filter indices ~f:(fun i -> arr.(i) > k) in
+  let segment_of x = if x <= k then `Left else `Right in
+  same_int_option
+    "binary_search_segmented `Last_on_left"
+    (global_index (Array.binary_search_segmented ~pos ~len arr ~segment_of `Last_on_left))
+    (List.last left);
+  same_int_option
+    "binary_search_segmented `First_on_right"
+    (global_index
+       (Array.binary_search_segmented ~pos ~len arr ~segment_of `First_on_right))
+    (List.hd right)
+;;
+
+let raises_overflow what f =
+  match f () with
+  | v -> Printf.ksprintf failwith "%s gives %s, expected an overflow exception" what v
+  | exception _ -> ()
+;;
+
+let no_exception what f =
+  match f () with
+  | _ -> ()
+  | exception e -> Printf.ksprintf failwith "%s raises %s" what (Exn.to_string e)
+;;
+
+let pin_int_pow_min_value () =
+  raises_overflow "Int.pow Int.min_value 2" (fun () ->
+    Int.to_string (Int.pow Int.min_value 2))
+;;
+
+let pin_int64_pow_to_min_value () =
+  no_exception "Int64.pow (-2L) 63L" (fun () -> Int64.pow (-2L) 63L)
+;;
+
+let pin_nativeint_pow_beyond_int () =
+  agree "Nativeint.pow 2n 62n" "4611686018427387904" (fun () ->
+    Nativeint.to_string (Nativeint.pow 2n 62n))
+;;
+
+let pin_float_round_decimal_beyond_22_digits () =
+  let got = Float.round_decimal 1.01e22 ~decimal_digits:(-23) in
+  if not (Float.equal got 0.)
+  then
+    Printf.ksprintf failwith "round_decimal 1.01e22 ~decimal_digits:(-23) gives %.17g" got
+;;
+
+let pin_int63_emul_pow_min_value () =
+  let module E = Int63.Private.Emul in
+  no_exception "Emul.pow min_value 1" (fun () -> E.pow E.min_value E.one)
+;;
+
+let pin_int63_emul_ceil_pow2 () =
+  let module E = Int63.Private.Emul in
+  agree "Emul.ceil_pow2 17" "32" (fun () -> E.to_string (E.ceil_pow2 (E.of_int 17)))
+;;
+
+let pin_list_range_past_max_value () =
+  match List.range ~stride:2 (Int.max_value - 3) Int.max_value with
+  | got -> same_ints "List.range" got [ Int.max_value - 3; Int.max_value - 1 ]
+  | exception e -> Printf.ksprintf failwith "List.range raises %s" (Exn.to_string e)
+;;
+
+let pin_sequence_range_past_max_value () =
+  same_ints
+    "Sequence.range"
+    (Sequence.to_list
+       (Sequence.take (Sequence.range ~stride:2 (Int.max_value - 3) Int.max_value) 3))
+    [ Int.max_value - 3; Int.max_value - 1 ]
+;;
