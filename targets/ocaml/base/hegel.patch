+  same_strings
+    "split_on_chars"
+    (String.split_on_chars s ~on:[ ','; ';' ])
+    (List.concat_map pieces ~f:(Stdlib.String.split_on_char ';'));
+  let show2 = function
+    | None -> "None"
+    | Some (a, b) -> Printf.sprintf "(%S, %S)" a b
