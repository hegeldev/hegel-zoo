+module type Utf = String.Utf_as_string
+
+let utf8_fragments =
+  [ "a"
+  ; "\xc2\xa9"
+  ; "\xe2\x82\xac"
+  ; "\xf0\x9f\x98\x80"
+  ; "\xed\x9f\xbf"
+  ; "\xee\x80\x80"
+  ; "\xf4\x8f\xbf\xbf"
+  ; "\xc0\x80"
+  ; "\xe0\x80\x80"
+  ; "\xed\xa0\x80"
+  ; "\xf0\x80\x80\x80"
+  ; "\xf4\x90\x80\x80"
+  ; "\xf5\x80\x80\x80"
+  ; "\xc2"
+  ; "\xe2\x82"
+  ; "\xf0\x9f\x98"
+  ; "\x80"
+  ; "\xbf"
+  ; "\xff"
+  ]
+;;
+
+let code_unit ~bits ~big_endian n =
+  let bytes = bits / 8 in
+  String.init bytes ~f:(fun i ->
+    let shift = 8 * if big_endian then bytes - 1 - i else i in
+    Char.of_int_exn ((n lsr shift) land 0xff))
+;;
+
+let encodings =
+  let unit_strings ~bits ~big_endian units =
+    printed
+      (Printf.sprintf "%S")
+      (map
+         (fun l -> String.concat (List.map l ~f:(code_unit ~bits ~big_endian)))
+         (lists (printed Int.to_string (sampled_from units)) ~max_size:5 ()))
+  in
+  let utf16 = [ 0x41; 0xe9; 0x20ac; 0xd800; 0xdbff; 0xdc00; 0xdfff; 0xfeff; 0xffff ] in
+  let utf32 = [ 0x41; 0xe9; 0xd800; 0xdfff; 0x10ffff; 0x110000; 0xffffffff; 0x1f600 ] in
+  let case name (module U : Utf) codec fragments =
+    printed
+      (fun (name, _, _, s) -> Printf.sprintf "%s %S" name s)
+      (map
+         (fun s -> name, (module U : Utf), codec, s)
+         (one_of [ fragments; binary ~max_size:6 () ]))
+  in
+  one_of
+    [ case
+        "Utf8"
+        (module String.Utf8)
+        "utf-8"
+        (printed
+           (Printf.sprintf "%S")
+           (map
+              String.concat
+              (lists
+                 (printed (Printf.sprintf "%S") (sampled_from utf8_fragments))
+                 ~max_size:4
+                 ())))
+    ; case
+        "Utf16le"
+        (module String.Utf16le)
+        "utf-16-le"
+        (unit_strings ~bits:16 ~big_endian:false utf16)
+    ; case
+        "Utf16be"
+        (module String.Utf16be)
+        "utf-16-be"
+        (unit_strings ~bits:16 ~big_endian:true utf16)
+    ; case
+        "Utf32le"
+        (module String.Utf32le)
+        "utf-32-le"
+        (unit_strings ~bits:32 ~big_endian:false utf32)
+    ; case
+        "Utf32be"
+        (module String.Utf32be)
+        "utf-32-be"
+        (unit_strings ~bits:32 ~big_endian:true utf32)
+    ]
+;;
+
+let%hegel_test string_utf tc =
+  let name, (module U : Utf), codec, s = draw tc encodings in
+  match ask [ "utf"; codec; hex s ] with
+  | [ valid; uchars ] ->
+    let uchars =
+      List.map
+        (String.split uchars ~on:' ' |> List.filter ~f:(Fn.non String.is_empty))
+        ~f:Stdlib.int_of_string
+    in
+    let valid = String.equal valid "1" in
+    let decoded t = List.map (U.to_list t) ~f:Uchar.to_scalar in
+    if not (Bool.equal (U.is_valid s) valid)
+    then Printf.ksprintf failwith "%s.is_valid gives %b" name (U.is_valid s);
+    let sanitized = U.sanitize s in
+    if not (U.is_valid (U.to_string sanitized))
+    then Printf.ksprintf failwith "%s.sanitize is not valid" name;
+    same_ints (name ^ ".sanitize") (decoded sanitized) uchars;
+    if valid
+    then (
+      let t = U.of_string s in
+      same_string (name ^ ".sanitize") (U.to_string sanitized) s;
+      if U.length_in_uchars t <> List.length uchars
+      then Printf.ksprintf failwith "%s.length_in_uchars disagrees" name;
+      same_string
+        (name ^ ".of_list")
+        (U.to_string (U.of_list (List.map uchars ~f:Uchar.of_scalar_exn)))
+        s;
+      match uchars with
+      | [] -> ()
+      | on :: _ ->
+        let on = Uchar.of_scalar_exn on in
+        let pieces = U.split t ~on |> List.map ~f:decoded in
+        let expected =
+          List.fold_right (U.to_list t) ~init:[ [] ] ~f:(fun u acc ->
+            if Uchar.equal u on
+            then [] :: acc
+            else (
+              match acc with
+              | first :: rest -> (Uchar.to_scalar u :: first) :: rest
+              | [] -> assert false))
+        in
+        same_int_lists (name ^ ".split") pieces expected)
+  | _ -> failwith "oracle"
+;;
