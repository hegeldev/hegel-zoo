+module%hegel_state_machine Set_machine = struct
+  type state =
+    { mutable s : Set.M(Int).t
+    ; mutable model : int list
+    }
+
+  let sexp_of_state st = [%sexp_of: int list] st.model
+
+  let add tc st =
+    let x = draw tc keys in
+    st.s <- Set.add st.s x;
+    st.model <- set_of (x :: st.model)
+  [@@rule]
+  ;;
+
+  let remove tc st =
+    let x = draw tc keys in
+    st.s <- Set.remove st.s x;
+    st.model <- List.filter st.model ~f:(fun y -> y <> x)
+  [@@rule]
+  ;;
+
+  let union tc st =
+    let l = draw tc elements in
+    st.s <- Set.union st.s (Set.of_list (module Int) l);
+    st.model <- set_of (st.model @ l)
+  [@@rule]
+  ;;
+
+  let inter tc st =
+    let l = draw tc elements in
+    st.s <- Set.inter st.s (Set.of_list (module Int) l);
+    st.model <- List.filter st.model ~f:(List.mem l ~equal:Int.equal)
+  [@@rule]
+  ;;
+
+  let diff tc st =
+    let l = draw tc elements in
+    st.s <- Set.diff st.s (Set.of_list (module Int) l);
+    st.model <- List.filter st.model ~f:(fun x -> not (List.mem l x ~equal:Int.equal))
+  [@@rule]
+  ;;
+
+  let filter _tc st =
+    st.s <- Set.filter st.s ~f:(fun x -> x % 3 <> 0);
+    st.model <- List.filter st.model ~f:(fun x -> x % 3 <> 0)
+  [@@rule]
+  ;;
+
+  let remove_index tc st =
+    let i = draw tc (integers ~min_value:(-1) ~max_value:(List.length st.model) ()) in
+    st.s <- Set.remove_index st.s i;
+    st.model <- List.filteri st.model ~f:(fun j _ -> j <> i)
+  [@@rule]
+  ;;
+
+  let split_and_union tc st =
+    let k = draw tc keys in
+    let lower, found, upper = Set.split st.s k in
+    same_ints
+      "split (lower)"
+      (Set.to_list lower)
+      (List.filter st.model ~f:(fun x -> x < k));
+    same_ints
+      "split (upper)"
+      (Set.to_list upper)
+      (List.filter st.model ~f:(fun x -> x > k));
+    same_int_option "split" found (List.find st.model ~f:(Int.equal k));
+    let le, gt = Set.split_le_gt st.s k in
+    same_ints "split_le_gt" (Set.to_list le) (List.filter st.model ~f:(fun x -> x <= k));
+    same_ints "split_le_gt" (Set.to_list gt) (List.filter st.model ~f:(fun x -> x > k));
+    let lt, ge = Set.split_lt_ge st.s k in
+    same_ints "split_lt_ge" (Set.to_list lt) (List.filter st.model ~f:(fun x -> x < k));
+    same_ints "split_lt_ge" (Set.to_list ge) (List.filter st.model ~f:(fun x -> x >= k));
+    st.s
+    <- Set.union_list
+         (module Int)
+         [ lower; Set.of_list (module Int) (Option.to_list found); upper ]
+  [@@rule]
+  ;;
+
+  let queries tc st =
+    let k = draw tc keys in
+    let which = draw tc targets in
+    let matching = List.filter st.model ~f:(fun x -> target_holds which x k) in
+    same_int_option
+      "binary_search"
+      (Set.binary_search st.s ~compare:Int.compare which k)
+      (if target_is_last which then List.last matching else List.hd matching);
+    let i = draw tc (integers ~min_value:(-1) ~max_value:(List.length st.model) ()) in
+    same_int_option "nth" (Set.nth st.s i) (if i < 0 then None else List.nth st.model i);
+    same_int_option
+      "rank"
+      (Set.rank st.s k)
+      (if List.mem st.model k ~equal:Int.equal
+       then Some (List.count st.model ~f:(fun x -> x < k))
+       else None);
+    let lo = draw tc keys in
+    let increasing = draw tc (booleans ()) in
+    let expected = List.filter st.model ~f:(fun x -> lo <= x && x <= k) in
+    same_ints
+      "to_sequence"
+      (Sequence.to_list
+         (Set.to_sequence
+            ~order:(if increasing then `Increasing else `Decreasing)
+            ~greater_or_equal_to:lo
+            ~less_or_equal_to:k
+            st.s))
+      (if increasing then expected else List.rev expected);
+    let other = set_of (draw tc elements) in
+    let o = Set.of_list (module Int) other in
+    let mem l x = List.mem l x ~equal:Int.equal in
+    if not (Bool.equal (Set.is_subset st.s ~of_:o) (List.for_all st.model ~f:(mem other)))
+    then failwith "is_subset disagrees";
+    if
+      not
+        (Bool.equal (Set.are_disjoint st.s o) (not (List.exists st.model ~f:(mem other))))
+    then failwith "are_disjoint disagrees";
+    let sym =
+      Sequence.to_list (Set.symmetric_diff st.s o)
+      |> List.map ~f:(function
+        | First x -> x
+        | Second x -> -1 - x)
+    in
+    same_ints
+      "symmetric_diff"
+      (List.sort sym ~compare:Int.compare)
+      (List.sort
+         (List.filter st.model ~f:(fun x -> not (mem other x))
+          @ List.filter_map other ~f:(fun x ->
+            Option.some_if (not (mem st.model x)) (-1 - x)))
+         ~compare:Int.compare)
+  [@@rule]
+  ;;
+
+  let contents _tc st =
+    same_ints "to_list" (Set.to_list st.s) st.model;
+    if not (Set.invariants st.s) then failwith "invariants do not hold";
+    if Set.length st.s <> List.length st.model
+    then Printf.ksprintf failwith "length %d" (Set.length st.s);
+    same_int_option "min_elt" (Set.min_elt st.s) (List.hd st.model);
+    same_int_option "max_elt" (Set.max_elt st.s) (List.last st.model)
+  [@@invariant]
+  ;;
+end
