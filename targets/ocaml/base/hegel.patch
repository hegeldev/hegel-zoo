+    then
+      Printf.ksprintf
+        failwith
+        "%s gives %s, expected %s"
+        what
+        (show2 got)
+        (show2 expected)
+  in
+  let around i =
+    String.sub s ~pos:0 ~len:i, String.sub s ~pos:(i + 1) ~len:(String.length s - i - 1)
+  in
+  check2
+    "lsplit2"
+    (String.lsplit2 s ~on:',')
+    (Option.map (Stdlib.String.index_opt s ',') ~f:around);
+  check2
+    "rsplit2"
+    (String.rsplit2 s ~on:',')
+    (Option.map (Stdlib.String.rindex_opt s ',') ~f:around);
+  let lines = Stdlib.String.split_on_char '\n' s in
+  let n = List.length lines in
+  let lines =
+    List.filter_mapi lines ~f:(fun i l ->
+      if i = n - 1
+      then if String.is_empty l then None else Some l
+      else Some (if String.is_suffix l ~suffix:"\r" then String.drop_suffix l 1 else l))
+  in
+  same_strings "split_lines" (String.split_lines s) lines
