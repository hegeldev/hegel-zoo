new file mode 100644
index 0000000..ce31977
--- /dev/null
+++ b/hegel/zoo.ml
@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
diff --git a/hegel/zoo_tests.ml b/hegel/zoo_tests.ml
new file mode 100644
index 0000000..fa7ea21
--- /dev/null
+++ b/hegel/zoo_tests.ml
@@ -0,0 +1,378 @@
+open Hegel
+
+type node =
+  | Lit of char
+  | Any
+  | Set of bool * (char * char) list
+  | Class of char
+  | Bol
+  | Eol
+  | Bos
+  | Eos
+  | Word_boundary
+  | Not_word_boundary
+  | Seq of node list
+  | Alt of node list
+  | Rep of node * int * int option * bool
+  | Group of node
+  | Ngroup of node
+
+let meta = "\\.^$|?*+()[]{}"
+
+let lit c =
+  if String.contains meta c then Printf.sprintf "\\%c" c else String.make 1 c
+;;
+
+let set_char c =
+  if String.contains "\\]^-[" c then Printf.sprintf "\\%c" c else String.make 1 c
+;;
+
+(* Python has no \z before 3.14; its \Z is Perl's \z *)
+let rec render ~python ~capture n =
+  let r = render ~python ~capture in
+  let atom n =
+    match n with
+    | Lit _ | Any | Set _ | Class _ | Group _ | Ngroup _ -> r n
+    | _ -> "(?:" ^ r n ^ ")"
+  in
+  match n with
+  | Lit c -> lit c
+  | Any -> "."
+  | Set (neg, items) ->
+    "["
+    ^ (if neg then "^" else "")
+    ^ String.concat
+        ""
+        (List.map
+           (fun (lo, hi) -> if lo = hi then set_char lo else set_char lo ^ "-" ^ set_char hi)
+           items)
+    ^ "]"
+  | Class c -> Printf.sprintf "\\%c" c
+  | Bol -> "^"
+  | Eol -> "$"
+  | Bos -> "\\A"
+  | Eos -> if python then "\\Z" else "\\z"
+  | Word_boundary -> "\\b"
+  | Not_word_boundary -> "\\B"
+  | Seq ns ->
+    String.concat
+      ""
+      (List.map
+         (fun n ->
+            match n with
+            | Alt _ -> "(?:" ^ r n ^ ")"
+            | _ -> r n)
+         ns)
+  | Alt ns -> String.concat "|" (List.map r ns)
+  | Rep (n, lo, hi, lazy_) ->
+    let q =
+      match lo, hi with
+      | 0, None -> "*"
+      | 1, None -> "+"
+      | 0, Some 1 -> "?"
+      | lo, None -> Printf.sprintf "{%d,}" lo
+      | lo, Some hi when lo = hi -> Printf.sprintf "{%d}" lo
+      | lo, Some hi -> Printf.sprintf "{%d,%d}" lo hi
+    in
+    atom n ^ q ^ if lazy_ then "?" else ""
+  | Group n -> (if capture then "(" else "(?:") ^ r n ^ ")"
+  | Ngroup n -> "(?:" ^ r n ^ ")"
+;;
+
+let perl n = render ~python:false ~capture:true n
+
+let alphabet = "ab A0_\n."
+let chars = sampled_from (List.init (String.length alphabet) (String.get alphabet))
+let sexp s = Sexplib0.Sexp.Atom s
+let printed show g = with_printer (fun x -> sexp (show x)) g
+
+let ranges =
+  let char = printed (String.make 1) chars in
+  printed
+    (fun (a, b) -> Printf.sprintf "%c-%c" a b)
+    (map (fun (a, b) -> if a <= b then a, b else b, a) (tuples2 char char))
+;;
+
+let leaf =
+  one_of
+    [ printed perl (map (fun c -> Lit c) chars)
+    ; printed perl (just Any)
+    ; printed
+        perl
+        (map
+           (fun (neg, items) -> Set (neg, items))
+           (tuples2 (booleans ()) (lists ranges ~min_size:1 ~max_size:3 ())))
+    ; printed perl (map (fun c -> Class c) (sampled_from [ 'd'; 'w'; 's'; 'D'; 'W'; 'S' ]))
+    ; printed
+        perl
+        (sampled_from [ Bol; Eol; Bos; Eos; Word_boundary; Not_word_boundary ])
+    ]
+;;
+
+let quantifiers =
+  sampled_from
+    [ 0, None
+    ; 1, None
+    ; 0, Some 1
+    ; 2, None
+    ; 1, Some 1
+    ; 0, Some 2
+    ; 1, Some 3
+    ; 2, Some 2
+    ]
+;;
+
+let rec nullable = function
+  | Lit _ | Any | Set _ | Class _ -> false
+  | Bol | Eol | Bos | Eos | Word_boundary | Not_word_boundary -> true
+  | Seq ns -> List.for_all nullable ns
+  | Alt ns -> List.exists nullable ns
+  | Rep (n, lo, _, _) -> lo = 0 || nullable n
+  | Group n | Ngroup n -> nullable n
+;;
+
+(* A loop whose body can match empty is where ocaml-re's semantics part from Perl's on purpose:
+   it ranks an iteration that consumes above stopping, and stopping above an empty one
+   (lib_test/fuzz/fuzz.ml), where Perl and Python end the loop at the first empty iteration *)
+let solid n = if nullable n then Seq [ n; Lit 'a' ] else n
+
+let rec tree depth =
+  if depth = 0
+  then leaf
+  else (
+    let sub = tree (depth - 1) in
+    one_of
+      [ leaf
+      ; printed perl (map (fun ns -> Seq ns) (lists sub ~min_size:2 ~max_size:4 ()))
+      ; printed perl (map (fun ns -> Alt ns) (lists sub ~min_size:2 ~max_size:3 ()))
+      ; printed
+          perl
+          (map
+             (fun (n, ((lo, hi), lazy_)) -> Rep (solid n, lo, hi, lazy_))
+             (tuples2
+                sub
+                (tuples2
+                   (printed (fun q -> perl (Rep (Lit 'a', fst q, snd q, false))) quantifiers)
+                   (booleans ()))))
+      ; printed perl (map (fun n -> Group n) sub)
+      ; printed perl (map (fun n -> Ngroup n) sub)
+      ])
+;;
+
+let regexes = tree 3
+let inputs = text ~alphabet ~max_size:8 ()
+
+type flags =
+  { caseless : bool
+  ; multiline : bool
+  ; dotall : bool
+  }
+
+let flags =
+  printed
+    (fun f ->
+       String.concat
+         ""
+         [ (if f.caseless then "i" else "")
+         ; (if f.multiline then "m" else "")
+         ; (if f.dotall then "s" else "")
+         ])
+    (map
+       (fun (caseless, multiline, dotall) -> { caseless; multiline; dotall })
+       (tuples3 (booleans ()) (booleans ()) (booleans ())))
+;;
+
+let opts f =
+  List.concat
+    [ (if f.caseless then [ `Caseless ] else [])
+    ; (if f.multiline then [ `Multiline ] else [])
+    ; (if f.dotall then [ `Dotall ] else [])
+    ]
+;;
+
+let python_flags f =
+  (if f.caseless then 2 else 0) + (if f.multiline then 8 else 0) + if f.dotall then 16 else 0
+;;
+
+(* ocaml-re resumes one byte past an empty match and skips an empty match where a non-empty one
+   ended (search.ml, #233); Python retries at the same position instead *)
+let script =
+  {|
+import re, sys
+
+def matches(r, s):
+    out, pos, after_match = [], 0, False
+    while pos <= len(s):
+        m = r.search(s, pos)
+        if m is None:
+            break
+        p1, p2 = m.span()
+        if after_match and p1 == pos == p2:
+            pos, after_match = pos + 1, False
+            continue
+        out.append(m)
+        pos, after_match = (p2 + 1, False) if p1 == p2 else (p2, True)
+    return out
+
+def pieces(s, ms):
+    out, prev = [], 0
+    for m in ms:
+        out.append(s[prev:m.start()])
+        prev = m.end()
+    out.append(s[prev:])
+    return out
+
+for line in sys.stdin.buffer:
+    op, flags, pat, s, by, pos = line.rstrip(b"\n").split(b" ")
+    pat, s, by = (bytes.fromhex(x.decode()) for x in (pat, s, by))
+    try:
+        r = re.compile(pat, int(flags))
+    except re.error:
+        out = "E"
+    else:
+        if op == b"search":
+            m = r.search(s, int(pos))
+            out = "N" if m is None else " ".join(f"{m.start(i)} {m.end(i)}" for i in range(r.groups + 1))
+        elif op == b"all":
+            out = ";".join(f"{m.start()} {m.end()}" for m in matches(r, s))
+        elif op == b"sub":
+            out = by.join(pieces(s, matches(r, s))).hex()
+        else:
+            out = ";".join(p.hex() for p in pieces(s, matches(r, s)))
+    sys.stdout.write(out + "\n")
+    sys.stdout.flush()
+|}
+;;
+
+let python = lazy (Unix.open_process_args "python3" [| "python3"; "-c"; script |])
+
+let hex s =
+  String.to_seq s
+  |> Seq.map (fun c -> Printf.sprintf "%02x" (Char.code c))
+  |> List.of_seq
+  |> String.concat ""
+;;
+
+let ask op f pat s ?(by = "") ?(pos = 0) () =
+  let ic, oc = Lazy.force python in
+  Printf.fprintf oc "%s %d %s %s %s %d\n%!" op (python_flags f) (hex pat) (hex s) (hex by) pos;
+  input_line ic
+;;
+
+let compile f n =
+  match Re.Perl.compile_pat ~opts:(opts f) (perl n) with
+  | re -> Some re
+  | exception (Re.Perl.Parse_error | Re.Perl.Not_supported) -> None
+;;
+
+let spans_of g =
+  String.concat
+    " "
+    (Array.to_list (Array.map (fun (a, b) -> Printf.sprintf "%d %d" a b) (Re.Group.all_offset g)))
+;;
+
+let python_pattern n = render ~python:true ~capture:true n
+let agree ours theirs =
+  if not (String.equal ours theirs)
+  then failwith (Printf.sprintf "ocaml-re %S, Python %S" ours theirs)
+;;
+
+let%hegel_test search_agrees_with_python tc =
+  let n = draw tc regexes in
+  let f = draw tc flags in
+  let s = draw tc inputs in
+  let ours =
+    match compile f n with
+    | None -> "E"
+    | Some re ->
+      (match Re.exec_opt re s with
+       | None -> "N"
+       | Some g -> spans_of g)
+  in
+  agree ours (ask "search" f (python_pattern n) s ())
+;;
+
+let%hegel_test search_from_position_agrees_with_python tc =
+  let n = draw tc regexes in
+  let f = draw tc flags in
+  let s, pos =
+    draw
+      tc
+      (printed
+         (fun (s, pos) -> Printf.sprintf "%S from %d" s pos)
+         (flat_map
+            (fun s ->
+               map (fun pos -> s, pos) (integers ~min_value:0 ~max_value:(String.length s) ()))
+            inputs))
+  in
+  let ours =
+    match compile f n with
+    | None -> "E"
+    | Some re ->
+      (match Re.exec_opt ~pos re s with
+       | None -> "N"
+       | Some g -> spans_of g)
+  in
+  agree ours (ask "search" f (python_pattern n) s ~pos ())
+;;
+
+let%hegel_test all_agrees_with_finditer tc =
+  let n = draw tc regexes in
+  let f = draw tc flags in
+  let s = draw tc inputs in
+  let ours =
+    match compile f n with
+    | None -> "E"
+    | Some re ->
+      String.concat
+        ";"
+        (List.map
+           (fun g ->
+              let a, b = Re.Group.offset g 0 in
+              Printf.sprintf "%d %d" a b)
+           (Re.all re s))
+  in
+  agree ours (ask "all" f (python_pattern n) s ())
+;;
+
+let%hegel_test replace_agrees_with_sub tc =
+  let n = draw tc regexes in
+  let f = draw tc flags in
+  let s = draw tc inputs in
+  let by = draw tc (text ~alphabet:"xy" ~max_size:2 ()) in
+  let ours =
+    match compile f n with
+    | None -> "E"
+    | Some re -> hex (Re.replace_string re ~by s)
+  in
+  agree ours (ask "sub" f (python_pattern n) s ~by ())
+;;
+
+let%hegel_test split_delim_agrees_with_split tc =
+  let n = draw tc regexes in
+  let f = draw tc flags in
+  let s = draw tc inputs in
+  let ours =
+    match compile f n with
+    | None -> "E"
+    | Some re -> String.concat ";" (List.map hex (Re.split_delim re s))
+  in
+  agree ours (ask "split" f (render ~python:true ~capture:false n) s ())
+;;
+
+let%hegel_test quote_matches_itself tc =
+  let s = draw tc (binary ~max_size:8 ()) in
+  let re = Re.compile (Re.whole_string (Re.Pcre.re (Re.Pcre.quote s))) in
+  if not (Re.execp re s) then failwith (Printf.sprintf "quote gives %S" (Re.Pcre.quote s))
+;;
+
+let () =
+  Zoo.run
+    [ "search_agrees_with_python", search_agrees_with_python
+    ; "search_from_position_agrees_with_python", search_from_position_agrees_with_python
+    ; "all_agrees_with_finditer", all_agrees_with_finditer
+    ; "replace_agrees_with_sub", replace_agrees_with_sub
+    ; "split_delim_agrees_with_split", split_delim_agrees_with_split
+    ; "quote_matches_itself", quote_matches_itself
+    ]
+;;
