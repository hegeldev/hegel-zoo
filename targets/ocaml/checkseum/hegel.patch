diff --git a/hegel/props.ml b/hegel/props.ml
new file mode 100644
index 0000000..bfb8220
--- /dev/null
+++ b/hegel/props.ml
@@ -0,0 +1,237 @@
+open Hegel
+
+let shown f g = with_printer (fun x -> Sexplib0.Sexp.Atom (f x)) g
+let hex s = String.concat "" (List.map (fun c -> Printf.sprintf "%02x" (Char.code c)) (List.of_seq (String.to_seq s)))
+
+let bigstring s =
+  Bigarray.Array1.init Bigarray.char Bigarray.c_layout (String.length s) (String.get s)
+;;
+
+type algo =
+  { name : string
+  ; m : (module Checkseum.S)
+  }
+
+let algos =
+  shown
+    (fun a -> a.name)
+    (sampled_from
+       [ { name = "crc32"; m = (module Checkseum.Crc32) }
+       ; { name = "adler32"; m = (module Checkseum.Adler32) }
+       ; { name = "crc32c"; m = (module Checkseum.Crc32c) }
+       ; { name = "crc24"; m = (module Checkseum.Crc24) }
+       ])
+;;
+
+(* zlib has CRC-32 and Adler-32; CRC-32C (RFC 3720) and CRC-24 (RFC 4880) are written out *)
+let python_script =
+  {|
+import sys, zlib
+
+def reflected_table(poly):
+    table = []
+    for n in range(256):
+        c = n
+        for _ in range(8):
+            c = (c >> 1) ^ poly if c & 1 else c >> 1
+        table.append(c)
+    return table
+
+CRC32C = reflected_table(0x82F63B78)
+
+def crc32c(data, crc):
+    crc ^= 0xFFFFFFFF
+    for b in data:
+        crc = CRC32C[(crc ^ b) & 0xFF] ^ (crc >> 8)
+    return crc ^ 0xFFFFFFFF
+
+def crc24(data, crc):
+    for b in data:
+        crc ^= b << 16
+        for _ in range(8):
+            crc <<= 1
+            if crc & 0x1000000:
+                crc ^= 0x1864CFB
+    return crc & 0xFFFFFF
+
+ALGOS = {"crc32": zlib.crc32, "adler32": zlib.adler32, "crc32c": crc32c, "crc24": crc24}
+INITIAL = {"crc32": 0, "adler32": 1, "crc32c": 0, "crc24": 0xB704CE}
+
+for line in sys.stdin:
+    alg, init, data = line.split()
+    init = INITIAL[alg] if init == "-" else int(init)
+    print(ALGOS[alg](bytes.fromhex(data[1:]), init), flush=True)
+|}
+;;
+
+let python = lazy (Unix.open_process_args "python3" [| "python3"; "-c"; python_script |])
+
+let reference ?init alg data =
+  let ic, oc = Lazy.force python in
+  let init = Option.fold ~none:"-" ~some:string_of_int init in
+  Printf.fprintf oc "%s %s x%s\n%!" alg init (hex data);
+  int_of_string (input_line ic)
+;;
+
+let value (module M : Checkseum.S) v = Option.get (Int32.unsigned_to_int (M.to_int32 v))
+
+type kind =
+  | String
+  | Bytes
+  | Bigstring
+
+let kinds =
+  shown
+    (function
+      | String -> "string"
+      | Bytes -> "bytes"
+      | Bigstring -> "bigstring")
+    (sampled_from [ String; Bytes; Bigstring ])
+;;
+
+let data =
+  one_of [ binary ~max_size:8 (); binary ~min_size:9 ~max_size:40 (); binary ~min_size:200 ~max_size:600 () ]
+;;
+
+let slack = one_of [ shown Fun.id (just ""); binary ~min_size:1 ~max_size:4 () ]
+
+type piece =
+  { kind : kind
+  ; before : string
+  ; data : string
+  ; after : string
+  ; checked : bool
+  }
+
+let pieces =
+  shown
+    (fun p ->
+       Printf.sprintf
+         "%s%s %S"
+         (if p.checked then "" else "unsafe ")
+         (match p.kind with
+          | String -> "string"
+          | Bytes -> "bytes"
+          | Bigstring -> "bigstring")
+         (p.before ^ "|" ^ p.data ^ "|" ^ p.after))
+    (map
+       (fun ((kind, before, data, after), checked) -> { kind; before; data; after; checked })
+       (tuples2 (tuples4 kinds slack data slack) (booleans ~p:0.8 ())))
+;;
+
+let digest (module M : Checkseum.S) v p =
+  let s = p.before ^ p.data ^ p.after in
+  let off = String.length p.before
+  and len = String.length p.data in
+  match p.kind, p.checked with
+  | String, true -> M.digest_string s off len v
+  | String, false -> M.unsafe_digest_string s off len v
+  | Bytes, true -> M.digest_bytes (Bytes.of_string s) off len v
+  | Bytes, false -> M.unsafe_digest_bytes (Bytes.of_string s) off len v
+  | Bigstring, true -> M.digest_bigstring (bigstring s) off len v
+  | Bigstring, false -> M.unsafe_digest_bigstring (bigstring s) off len v
+;;
+
+let%hegel_test digest_matches_reference tc =
+  let a = draw tc algos in
+  let p = draw tc pieces in
+  let (module M) = a.m in
+  let got = value (module M) (digest (module M) M.default p) in
+  let expected = reference a.name p.data in
+  if got <> expected then Printf.ksprintf failwith "%s gives %#x, expected %#x" a.name got expected
+;;
+
+let%hegel_test chained_digest_matches_reference tc =
+  let a = draw tc algos in
+  let ps = draw tc (lists pieces ~max_size:5 ()) in
+  let (module M) = a.m in
+  let got = value (module M) (List.fold_left (digest (module M)) M.default ps) in
+  let expected = reference a.name (String.concat "" (List.map (fun p -> p.data) ps)) in
+  if got <> expected then Printf.ksprintf failwith "%s gives %#x, expected %#x" a.name got expected
+;;
+
+(* Adler-32's two sums are below 65521 in any value a digest can start from *)
+let starts name =
+  if String.equal name "adler32"
+  then
+    map
+      (fun (a, b) -> (b lsl 16) lor a)
+      (tuples2 (integers ~min_value:0 ~max_value:65520 ()) (integers ~min_value:0 ~max_value:65520 ()))
+    |> shown string_of_int
+  else if String.equal name "crc24"
+  then integers ~min_value:0 ~max_value:0xFFFFFF ()
+  else integers ~min_value:0 ~max_value:0xFFFFFFFF ()
+;;
+
+let%hegel_test digest_continues_from_any_value tc =
+  let a = draw tc algos in
+  let init = draw tc (starts a.name) in
+  let d = draw tc data in
+  let (module M) = a.m in
+  let v = M.of_int32 (Int32.of_int init) in
+  let got = value (module M) (M.digest_string d 0 (String.length d) v) in
+  let expected = reference ~init a.name d in
+  if got <> expected then Printf.ksprintf failwith "%s gives %#x, expected %#x" a.name got expected
+;;
+
+let%hegel_test bounds_are_checked tc =
+  let a = draw tc algos in
+  let kind = draw tc kinds in
+  let s = draw tc (binary ~max_size:8 ()) in
+  let n = String.length s in
+  let span g = shown (fun (off, len) -> Printf.sprintf "off %d len %d" off len) g in
+  let off, len =
+    draw
+      tc
+      (one_of
+         ((if Zoo.known then [ span (sampled_from [ 0, -1; n + 1, 0; -1, 0 ]) ] else [])
+          @ [ span
+                (tuples2
+                   (integers ~min_value:(-2) ~max_value:(n + 2) ())
+                   (integers ~min_value:(-2) ~max_value:(n + 2) ()))
+            ]))
+  in
+  let (module M) = a.m in
+  let inside = off >= 0 && len >= 0 && off <= n - len in
+  let run () =
+    match kind with
+    | String -> M.digest_string s off len M.default
+    | Bytes -> M.digest_bytes (Bytes.of_string s) off len M.default
+    | Bigstring -> M.digest_bigstring (bigstring s) off len M.default
+  in
+  match run () with
+  | v ->
+    if not inside then Printf.ksprintf failwith "off %d len %d of %d bytes gives %#x" off len n (value (module M) v)
+  | exception Invalid_argument _ ->
+    if inside then Printf.ksprintf failwith "off %d len %d of %d bytes raises" off len n
+;;
+
+let%hegel_test int32_conversions_roundtrip tc =
+  let a = draw tc algos in
+  let x = draw tc (integers ~min_value:0 ~max_value:0xFFFFFFFF ()) in
+  let y = draw tc (one_of [ shown string_of_int (just x); integers ~min_value:0 ~max_value:0xFFFFFFFF () ]) in
+  let (module M) = a.m in
+  let vx = M.of_int32 (Int32.of_int x) in
+  if not (Int32.equal (M.to_int32 vx) (Int32.of_int x))
+  then Printf.ksprintf failwith "%#x comes back as %#lx" x (M.to_int32 vx);
+  if M.equal vx (M.of_int32 (Int32.of_int y)) <> (x = y)
+  then Printf.ksprintf failwith "equal %#x %#x is wrong" x y
+;;
+
+let pin_negative_length_raises () =
+  match Checkseum.Crc32.digest_string "" 0 (-1) Checkseum.Crc32.default with
+  | _ -> failwith "digest_string \"\" 0 (-1) gives a checksum"
+  | exception Invalid_argument _ -> ()
+;;
+
+let tests =
+  [ "digest_matches_reference", digest_matches_reference
+  ; "chained_digest_matches_reference", chained_digest_matches_reference
+  ; "digest_continues_from_any_value", digest_continues_from_any_value
+  ; "bounds_are_checked", bounds_are_checked
+  ; "int32_conversions_roundtrip", int32_conversions_roundtrip
+  ; "pin_negative_length_raises", pin_negative_length_raises
+  ]
+;;
+
+let main ~backend = Zoo.run (List.map (fun (n, t) -> backend ^ "::" ^ n, t) tests)
diff --git a/hegel/zoo.ml b/hegel/zoo.ml
new file mode 100644
index 0000000..ce31977
--- /dev/null
+++ b/hegel/zoo.ml
@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
