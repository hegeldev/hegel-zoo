--- /dev/null
+++ b/hegel/zoo.ml
@@ -0,0 +1,26 @@
+let hegel_pin = "0.26.1"
+
+let () =
+  if not (String.equal Hegel.version hegel_pin)
+  then failwith (Printf.sprintf "hegel %s is installed, the zoo pins %s" Hegel.version hegel_pin)
+;;
+
+let known = not (Option.equal String.equal (Sys.getenv_opt "HEGEL_NO_KNOWN") (Some "1"))
+
+let run tests =
+  let failed =
+    List.fold_left
+      (fun failed (name, test) ->
+         match test () with
+         | () ->
+           Printf.printf "ZOO ok %s\n%!" name;
+           failed
+         | exception e ->
+           Printf.eprintf "%s: %s\n%!" name (Printexc.to_string e);
+           Printf.printf "ZOO FAILED %s\n%!" name;
+           failed + 1)
+      0
+      tests
+  in
+  exit (if failed = 0 then 0 else 1)
+;;
diff --git a/hegel/zoo_tests.ml b/hegel/zoo_tests.ml
new file mode 100644
index 0000000..4905832
--- /dev/null
+++ b/hegel/zoo_tests.ml
@@ -0,0 +1,618 @@
+open Hegel
+module Sexp = Sexplib0.Sexp
+
+let spelled g = with_printer (fun s -> Sexp.Atom s) g
+let sexp g = with_printer Sexp.sexp_of_t g
+
+let pool =
+  [ 'a'; 'b'; '#'; '|'; ';'; '\\'; '"'; '('; ')'; ' '; '\n'; '\t'; '\012'; '\011'; '\000'; '\''
+  ; '\r'; '\200'
+  ]
+;;
+
+let atom_text =
+  one_of
+    [ text ~alphabet:"abc" ~min_size:1 ~max_size:3 ()
+    ; spelled
+        (map
+           (fun cs -> String.of_seq (List.to_seq cs))
+           (lists
+              (with_printer (fun c -> Sexp.Atom (String.make 1 c)) (sampled_from pool))
+              ~max_size:6
+              ()))
+    ; binary ~max_size:4 ()
+    ]
+;;
+
+let leaf = sexp (map (fun s -> Sexp.Atom s) atom_text)
+
+let rec tree depth =
+  if depth = 0
+  then leaf
+  else
+    one_of
+      [ leaf; sexp (map (fun l -> Sexp.List l) (lists (tree (depth - 1)) ~max_size:4 ())) ]
+;;
+
+let values = tree 3
+let documents = with_printer (fun l -> Sexp.List l) (lists values ~max_size:3 ())
+
+type token =
+  | Open
+  | Close
+  | Bare of string
+  | Quoted of string
+  | Space of string
+  | Line of string
+  | Block of string
+  | Sexp_comment
+
+let render tokens =
+  let b = Buffer.create 64 in
+  ignore
+    (List.fold_left
+       (fun prev t ->
+          (match prev, t with
+           | Some (Bare _), (Bare _ | Block _ | Sexp_comment) | Some (Bare "#"), Line _ ->
+             Buffer.add_char b ' '
+           | _ -> ());
+          Buffer.add_string
+            b
+            (match t with
+             | Open -> "("
+             | Close -> ")"
+             | Bare s | Quoted s | Space s | Line s | Block s -> s
+             | Sexp_comment -> "#;");
+          Some t)
+       None
+       tokens);
+  Buffer.contents b
+;;
+
+let has s sub =
+  let n = String.length sub in
+  let rec go i = i + n <= String.length s && (String.sub s i n = sub || go (i + 1)) in
+  go 0
+;;
+
+(* parsexp rejects #| and |# inside an unquoted atom (Comment_token_in_unquoted_atom) *)
+let bare_ok s =
+  s <> ""
+  && String.for_all (fun c -> not (String.contains " \n\t\012\r\"();" c)) s
+  && (not (has s "#|"))
+  && not (has s "|#")
+;;
+
+let char_spellings c =
+  let raw = if c = '"' || c = '\\' || c = '\r' then [] else [ String.make 1 c ] in
+  let short =
+    match c with
+    | '\n' -> [ "\\n" ]
+    | '\t' -> [ "\\t" ]
+    | '\b' -> [ "\\b" ]
+    | '\r' -> [ "\\r" ]
+    | '\\' -> [ "\\\\" ]
+    | '"' -> [ "\\\"" ]
+    | '\'' -> [ "\\'" ]
+    | _ -> []
+  in
+  let code = Char.code c in
+  raw @ short @ [ Printf.sprintf "\\%03d" code; Printf.sprintf "\\x%02x" code; Printf.sprintf "\\x%02X" code ]
+;;
+
+let escape_starts = "\\\"'ntbrx0123456789\n\r"
+let continuation = map (fun ws -> "\\\n" ^ ws) (text ~alphabet:" \t" ~max_size:2 ())
+
+let quoted s =
+  composite (fun tc ->
+    let n = String.length s in
+    let b = Buffer.create (n + 2) in
+    Buffer.add_char b '"';
+    let rec go i =
+      if i <= n
+      then (
+        let piece, next =
+          if i = n
+          then "\"", i + 1
+          else if s.[i] = '\\' && i + 1 < n && not (String.contains escape_starts s.[i + 1])
+          then
+            (* a backslash that starts no escape is kept as it is *)
+            draw_silent tc (sampled_from [ "\\\\", i + 1; "\\" ^ String.make 1 s.[i + 1], i + 2 ])
+          else draw_silent tc (sampled_from (char_spellings s.[i])), i + 1
+        in
+        if piece.[0] <> ' ' && piece.[0] <> '\t' && draw_silent tc (booleans ~p:0.1 ())
+        then Buffer.add_string b (draw_silent tc continuation);
+        Buffer.add_string b piece;
+        go next)
+    in
+    go 0;
+    Buffer.contents b)
+;;
+
+let blanks = text ~alphabet:" \n\t\012" ~min_size:1 ~max_size:3 ()
+let line_comment = map (fun s -> ";" ^ s ^ "\n") (text ~alphabet:"ab ;#|\"()" ~max_size:4 ())
+
+let rec block depth =
+  let piece =
+    one_of
+      ([ text ~alphabet:"ab ;\n()" ~max_size:3 (); spelled (flat_map quoted atom_text) ]
+       @ if depth = 0 then [] else [ block (depth - 1) ])
+  in
+  spelled (map (fun ps -> "#|" ^ String.concat "" ps ^ "|#") (lists piece ~max_size:3 ()))
+;;
+
+let token g = with_printer (fun t -> Sexp.Atom (render [ t ])) g
+
+let comment =
+  one_of
+    [ token (map (fun s -> Space s) blanks)
+    ; token (map (fun s -> Line s) line_comment)
+    ; token (map (fun s -> Block s) (block 2))
+    ]
+;;
+
+let gap_piece =
+  let shown g =
+    with_printer
+      (function
+        | `Comment t -> Sexp.Atom (render [ t ])
+        | `Sexp_comment v -> Sexp.List [ Sexp.Atom "#;"; v ])
+      g
+  in
+  one_of
+    [ shown (map (fun t -> `Comment t) comment); shown (map (fun v -> `Sexp_comment v) (tree 1)) ]
+;;
+
+let rec spell tc (v : Sexp.t) =
+  match v with
+  | Atom s ->
+    (match if bare_ok s then draw_silent tc (sampled_from [ `Bare; `Quoted ]) else `Quoted with
+     | `Bare -> [ Bare s ]
+     | `Quoted -> [ Quoted (draw_silent tc (quoted s)) ])
+  | List l -> (Open :: gap tc) @ List.concat_map (fun x -> spell tc x @ gap tc) l @ [ Close ]
+
+and gap tc =
+  List.concat_map
+    (function
+      | `Comment t -> [ t ]
+      | `Sexp_comment v -> (Sexp_comment :: draw_silent tc (lists comment ~max_size:1 ())) @ spell tc v)
+    (draw_silent tc (lists gap_piece ~max_size:2 ()))
+;;
+
+let document vs =
+  spelled (composite (fun tc -> render (gap tc @ List.concat_map (fun v -> spell tc v @ gap tc) vs)))
+;;
+
+let edits text =
+  let n = String.length text in
+  let at = integers ~min_value:0 ~max_value:n () in
+  let inserted =
+    spelled
+      (sampled_from
+         [ "("; ")"; "\""; "\\"; "#"; "|"; ";"; "\n"; "x"; "\\256"; "\\999"; "\\25"; "\\x4"
+         ; "\\xg0"; "#|"; "|#"; "#;"
+         ])
+  in
+  one_of
+    ([ spelled (just text)
+     ; spelled (map (fun i -> String.sub text 0 i) at)
+     ; spelled
+         (map
+            (fun (i, ins) -> String.sub text 0 i ^ ins ^ String.sub text i (n - i))
+            (tuples2 at inserted))
+     ]
+     @
+     if n = 0
+     then []
+     else
+       [ spelled
+           (map
+              (fun i -> String.sub text 0 i ^ String.sub text (i + 1) (n - i - 1))
+              (integers ~min_value:0 ~max_value:(n - 1) ()))
+       ])
+;;
+
+let edited vs = spelled (flat_map edits (document vs))
+
+exception Reject
+
+let read_reference s =
+  let n = String.length s in
+  let pos = ref 0 in
+  let peek k = if !pos + k < n then Some s.[!pos + k] else None in
+  let at sub = !pos + String.length sub <= n && String.sub s !pos (String.length sub) = sub in
+  let ranges = ref [] in
+  let digit k = match peek k with Some ('0' .. '9') -> true | _ -> false in
+  let hex k =
+    match peek k with
+    | Some ('0' .. '9' | 'a' .. 'f' | 'A' .. 'F') -> true
+    | _ -> false
+  in
+  let quoted_string () =
+    incr pos;
+    let b = Buffer.create 8 in
+    let rec go () =
+      match peek 0 with
+      | None -> raise Reject
+      | Some '"' -> incr pos
+      | Some '\\' ->
+        incr pos;
+        (match peek 0 with
+         | None -> raise Reject
+         | Some (('\\' | '"' | '\'') as c) ->
+           Buffer.add_char b c;
+           incr pos
+         | Some 'n' ->
+           Buffer.add_char b '\n';
+           incr pos
+         | Some 't' ->
+           Buffer.add_char b '\t';
+           incr pos
+         | Some 'b' ->
+           Buffer.add_char b '\b';
+           incr pos
+         | Some 'r' ->
+           Buffer.add_char b '\r';
+           incr pos
+         | Some '0' .. '9' ->
+           if not (digit 1 && digit 2) then raise Reject;
+           let v = int_of_string (String.sub s !pos 3) in
+           if v > 255 then raise Reject;
+           Buffer.add_char b (Char.chr v);
+           pos := !pos + 3
+         | Some 'x' ->
+           if not (hex 1 && hex 2) then raise Reject;
+           Buffer.add_char b (Char.chr (int_of_string ("0x" ^ String.sub s (!pos + 1) 2)));
+           pos := !pos + 3
+         | Some '\n' ->
+           incr pos;
+           while peek 0 = Some ' ' || peek 0 = Some '\t' do
+             incr pos
+           done
+         | Some _ -> Buffer.add_char b '\\');
+        go ()
+      | Some c ->
+        Buffer.add_char b c;
+        incr pos;
+        go ()
+    in
+    go ();
+    Buffer.contents b
+  in
+  let block () =
+    pos := !pos + 2;
+    let depth = ref 1 in
+    while !depth > 0 do
+      if !pos >= n
+      then raise Reject
+      else if at "|#"
+      then (
+        decr depth;
+        pos := !pos + 2)
+      else if at "#|"
+      then (
+        incr depth;
+        pos := !pos + 2)
+      else if s.[!pos] = '"'
+      then ignore (quoted_string ())
+      else incr pos
+    done
+  in
+  let node start f =
+    let r = ref (start, start) in
+    ranges := r :: !ranges;
+    let v = f () in
+    r := start, !pos;
+    v
+  in
+  let rec skip () =
+    match peek 0 with
+    | Some (' ' | '\n' | '\t' | '\012') ->
+      incr pos;
+      skip ()
+    | Some '\r' ->
+      if not (at "\r\n") then raise Reject;
+      pos := !pos + 2;
+      skip ()
+    | Some ';' ->
+      while not (peek 0 = Some '\n' || peek 0 = None) do
+        incr pos
+      done;
+      skip ()
+    | Some '#' when at "#|" ->
+      block ();
+      skip ()
+    | Some '#' when at "#;" ->
+      pos := !pos + 2;
+      let kept = !ranges in
+      skip ();
+      if Option.is_none (value ()) then raise Reject;
+      ranges := kept;
+      skip ()
+    | _ -> ()
+  and value () =
+    match peek 0 with
+    | None | Some ')' -> None
+    | Some '(' ->
+      Some
+        (node !pos (fun () ->
+           incr pos;
+           let rec items acc =
+             skip ();
+             match peek 0 with
+             | Some ')' ->
+               incr pos;
+               Sexp.List (List.rev acc)
+             | _ ->
+               (match value () with
+                | Some v -> items (v :: acc)
+                | None -> raise Reject)
+           in
+           items []))
+    | Some '"' -> Some (node !pos (fun () -> Sexp.Atom (quoted_string ())))
+    | Some _ when at "|#" -> raise Reject
+    | Some _ ->
+      Some
+        (node !pos (fun () ->
+           let start = !pos in
+           while
+             match peek 0 with
+             | None | Some (' ' | '\n' | '\t' | '\012' | '\r' | '"' | '(' | ')' | ';') -> false
+             | Some _ ->
+               if at "#|" || at "|#" then raise Reject;
+               true
+           do
+             incr pos
+           done;
+           Sexp.Atom (String.sub s start (!pos - start))))
+  in
+  let rec top acc =
+    skip ();
+    match peek 0 with
+    | None -> List.rev acc
+    | _ ->
+      (match value () with
+       | Some v -> top (v :: acc)
+       | None -> raise Reject)
+  in
+  match top [] with
+  | vs -> Ok (vs, List.rev_map ( ! ) !ranges)
+  | exception Reject -> Error ()
+;;
+
+let equal_list = List.equal Sexp.equal
+let show_list l = String.concat " " (List.map Sexp.to_string_mach l)
+
+let error_text e =
+  Printf.sprintf
+    "%s at offset %d"
+    (Parsexp.Parse_error.message e)
+    (Parsexp.Parse_error.position e).offset
+;;
+
+let%hegel_test many_reads_spellings tc =
+  let vs = draw tc documents in
+  let s = draw tc (document vs) in
+  match Parsexp.Many.parse_string s with
+  | Ok got ->
+    if not (equal_list got vs) then Printf.ksprintf failwith "reads as %s" (show_list got)
+  | Error e -> Printf.ksprintf failwith "rejected: %s" (error_text e)
+;;
+
+let%hegel_test single_reads_spellings tc =
+  let v = draw tc values in
+  let s = draw tc (document [ v ]) in
+  match Parsexp.Single.parse_string s with
+  | Ok got ->
+    if not (Sexp.equal got v) then Printf.ksprintf failwith "reads as %s" (Sexp.to_string_mach got)
+  | Error e -> Printf.ksprintf failwith "rejected: %s" (error_text e)
+;;
+
+let writers =
+  with_printer
+    (fun (name, _) -> Sexp.Atom name)
+    (sampled_from
+       [ "to_string", Sexp.to_string
+       ; "to_string_hum", (fun v -> Sexp.to_string_hum v)
+       ; "to_string_mach", Sexp.to_string_mach
+       ])
+;;
+
+let%hegel_test writers_round_trip tc =
+  let v = draw tc values in
+  let _, write = draw tc writers in
+  let s = write v in
+  match Parsexp.Single.parse_string s with
+  | Ok got ->
+    if not (Sexp.equal got v)
+    then Printf.ksprintf failwith "%S reads as %s" s (Sexp.to_string_mach got)
+  | Error e -> Printf.ksprintf failwith "%S rejected: %s" s (error_text e)
+;;
+
+let%hegel_test accepts_exactly_the_grammar tc =
+  let vs = draw tc documents in
+  let s = draw tc (edited vs) in
+  match Parsexp.Many.parse_string s, read_reference s with
+  | Ok got, Ok (expected, _) ->
+    if not (equal_list got expected)
+    then Printf.ksprintf failwith "reads as %s, not %s" (show_list got) (show_list expected)
+  | Ok got, Error () -> Printf.ksprintf failwith "accepts it as %s" (show_list got)
+  | Error e, Ok _ -> Printf.ksprintf failwith "rejects it: %s" (error_text e)
+  | Error e, Error () ->
+    let at = (Parsexp.Parse_error.position e).offset in
+    if at < 0 || at > String.length s
+    then Printf.ksprintf failwith "error offset %d outside the input" at
+;;
+
+let escape_piece =
+  one_of
+    [ spelled (map (fun c -> String.make 1 c) (sampled_from [ 'a'; ' '; '\n'; '\'' ]))
+    ; spelled
+        (map
+           (Printf.sprintf "\\%03d")
+           (one_of
+              [ integers ~min_value:0 ~max_value:999 ()
+              ; with_printer (fun n -> Sexp.Atom (string_of_int n)) (sampled_from [ 255; 256 ])
+              ]))
+    ; spelled
+        (map
+           (fun (a, b) -> Printf.sprintf "\\x%c%c" a b)
+           (tuples2
+              (with_printer (fun c -> Sexp.Atom (String.make 1 c)) (sampled_from (List.of_seq (String.to_seq "09afAFgG"))))
+              (with_printer (fun c -> Sexp.Atom (String.make 1 c)) (sampled_from (List.of_seq (String.to_seq "09afAFgG"))))))
+    ; spelled (sampled_from [ "\\"; "\\1"; "\\25"; "\\x"; "\\o12"; "\\ "; "\\q" ])
+    ]
+;;
+
+let quoted_escapes =
+  spelled
+    (map
+       (fun (in_comment, pieces) ->
+          let q = "\"" ^ String.concat "" pieces ^ "\"" in
+          if in_comment then "#|" ^ q ^ "|# x" else q)
+       (tuples2 (booleans ()) (lists escape_piece ~max_size:4 ())))
+;;
+
+let%hegel_test escapes_agree_with_reference tc =
+  let s = draw tc quoted_escapes in
+  match Parsexp.Single.parse_string s, read_reference s with
+  | Ok got, Ok ([ v ], _) ->
+    if not (Sexp.equal got v) then Printf.ksprintf failwith "reads as %s" (Sexp.to_string_mach got)
+  | Ok got, _ -> Printf.ksprintf failwith "accepts it as %s" (Sexp.to_string_mach got)
+  | Error e, Ok _ -> Printf.ksprintf failwith "rejects it: %s" (error_text e)
+  | Error _, Error () -> ()
+;;
+
+let%hegel_test single_needs_exactly_one tc =
+  let vs = draw tc documents in
+  let s = draw tc (edited vs) in
+  let expected =
+    match read_reference s with
+    | Ok ([ v ], _) -> Some v
+    | Ok _ | Error () -> None
+  in
+  match Parsexp.Single.parse_string s, expected with
+  | Ok got, Some v ->
+    if not (Sexp.equal got v) then Printf.ksprintf failwith "reads as %s" (Sexp.to_string_mach got)
+  | Ok got, None -> Printf.ksprintf failwith "accepts it as %s" (Sexp.to_string_mach got)
+  | Error e, Some _ -> Printf.ksprintf failwith "rejects it: %s" (error_text e)
+  | Error _, None -> ()
+;;
+
+let rec preorder (v : Sexp.t) =
+  v
+  ::
+  (match v with
+   | Atom _ -> []
+   | List l -> List.concat_map preorder l)
+;;
+
+let position_of s offset =
+  let line = ref 1
+  and bol = ref 0 in
+  String.iteri
+    (fun i c ->
+       if i < offset && c = '\n'
+       then (
+         incr line;
+         bol := i + 1))
+    s;
+  { Parsexp.Positions.line = !line; col = offset - !bol; offset }
+;;
+
+let%hegel_test positions_match_reference tc =
+  let vs = draw tc documents in
+  let s = draw tc (document vs) in
+  match Parsexp.Many_and_positions.parse_string s, read_reference s with
+  | Ok (got, positions), Ok (_, ranges) ->
+    let nodes = List.concat_map preorder got in
+    if List.length nodes <> List.length ranges
+    then Printf.ksprintf failwith "%d nodes, %d expected" (List.length nodes) (List.length ranges);
+    List.iter2
+      (fun sub (start, stop) ->
+         let expected =
+           { Parsexp.Positions.start_pos = position_of s start; end_pos = position_of s stop }
+         in
+         match Parsexp.Positions.find_sub_sexp_in_list_phys positions got ~sub with
+         | None -> Printf.ksprintf failwith "no range for %s" (Sexp.to_string_mach sub)
+         | Some r ->
+           if Parsexp.Positions.compare_range r expected <> 0
+           then
+             Printf.ksprintf
+               failwith
+               "%s at %s, expected %s"
+               (Sexp.to_string_mach sub)
+               (Sexp.to_string_mach (Parsexp.Positions.sexp_of_range r))
+               (Sexp.to_string_mach (Parsexp.Positions.sexp_of_range expected)))
+      nodes
+      ranges
+  | Error e, _ -> Printf.ksprintf failwith "rejected: %s" (error_text e)
+  | _, Error () -> failwith "the reference rejects it"
+;;
+
+let chunks = lists (integers ~min_value:0 ~max_value:4 ()) ~max_size:8 ()
+
+let feed_chunks feed s sizes stack =
+  let n = String.length s in
+  let pos, stack =
+    List.fold_left
+      (fun (pos, stack) k ->
+         let len = min k (n - pos) in
+         pos + len, feed s ~pos ~len stack)
+      (0, stack)
+      sizes
+  in
+  feed s ~pos ~len:(n - pos) stack
+;;
+
+let%hegel_test chunked_feeding_agrees tc =
+  let vs = draw tc documents in
+  let s = draw tc (edited vs) in
+  let sizes = draw tc chunks in
+  let chunked =
+    let state = Parsexp.Many.State.create () in
+    match
+      Parsexp.Many.feed_eoi
+        state
+        (feed_chunks (Parsexp.Many.feed_substring state) s sizes Parsexp.Many.Stack.empty)
+    with
+    | v -> Ok v
+    | exception Parsexp.Parse_error.Parse_error e -> Error e
+  in
+  match Parsexp.Many.parse_string s, chunked with
+  | Ok whole, Ok fed ->
+    if not (equal_list whole fed) then Printf.ksprintf failwith "fed in chunks: %s" (show_list fed)
+  | Error a, Error b ->
+    if Parsexp.Positions.compare_pos (Parsexp.Parse_error.position a) (Parsexp.Parse_error.position b)
+       <> 0
+    then Printf.ksprintf failwith "%s whole, %s in chunks" (error_text a) (error_text b)
+  | Ok _, Error e -> Printf.ksprintf failwith "rejected in chunks: %s" (error_text e)
+  | Error e, Ok _ -> Printf.ksprintf failwith "rejected whole: %s" (error_text e)
+;;
+
+let%hegel_test eager_agrees_with_many tc =
+  let vs = draw tc documents in
+  let s = draw tc (document vs) in
+  let sizes = draw tc chunks in
+  let got = ref [] in
+  let state = Parsexp.Eager.State.create (fun _ v -> got := v :: !got) in
+  Parsexp.Eager.feed_eoi
+    state
+    (feed_chunks (Parsexp.Eager.feed_substring state) s sizes Parsexp.Eager.Stack.empty);
+  let got = List.rev !got in
+  if not (equal_list got vs) then Printf.ksprintf failwith "eager gives %s" (show_list got)
+;;
