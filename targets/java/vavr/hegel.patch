index 0000000..6cd49d8
--- /dev/null
+++ b/hegel/src/test/java/zoo/VavrMoreTest.java
@@ -0,0 +1,806 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static zoo.VavrGen.chance;
+import static zoo.VavrGen.ints;
+import static zoo.VavrGen.maybe;
+import static zoo.VavrGen.w;
+import static zoo.VavrGen.weighted;
+import static zoo.VavrTest.deserialize;
+import static zoo.VavrTest.expect;
+import static zoo.VavrTest.list;
+import static zoo.VavrTest.same;
+import static zoo.VavrTest.serialize;
+import static zoo.VavrTest.thrown;
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import dev.hegel.Hegel;
+import io.vavr.Function1;
+import io.vavr.Function2;
+import io.vavr.Lazy;
+import io.vavr.Tuple;
+import io.vavr.Tuple2;
+import io.vavr.Tuple3;
+import io.vavr.collection.CharSeq;
+import io.vavr.collection.HashMap;
+import io.vavr.collection.HashMultimap;
+import io.vavr.collection.HashSet;
+import io.vavr.collection.LinkedHashMap;
+import io.vavr.collection.LinkedHashSet;
+import io.vavr.collection.List;
+import io.vavr.collection.Map;
+import io.vavr.collection.Multimap;
+import io.vavr.collection.Seq;
+import io.vavr.collection.Set;
+import io.vavr.collection.TreeMap;
+import io.vavr.collection.TreeSet;
+import io.vavr.control.Either;
+import io.vavr.control.Option;
+import io.vavr.control.Try;
+import io.vavr.control.Validation;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.Locale;
+import java.util.Objects;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.stream.Collectors;
+import org.junit.jupiter.api.Test;
+
+/** Sets, maps and multimaps against java.util models; CharSeq against String; the control types' laws. */
+class VavrMoreTest {
+
+    // ---- generators ------------------------------------------------------------------------------
+
+    /** A small int (so that duplicates are common), null one time in ten when asked for. */
+    static Generator<Integer> element(boolean nulls) {
+        return nulls ? maybe(10, (Integer) null, ints(-3, 12)) : ints(-3, 12);
+    }
+
+    /** Up to 25 small ints, one time in seven at most 2. */
+    static Generator<java.util.List<Integer>> smallInts(boolean nulls) {
+        Generator<Integer> element = element(nulls);
+        return weighted(w(15, lists(element).maxSize(2)), w(85, lists(element).maxSize(25)));
+    }
+
+    static final String[] SET_KINDS = {"HashSet", "LinkedHashSet", "TreeSet"};
+    static final String[] MAP_KINDS = {"HashMap", "LinkedHashMap", "TreeMap"};
+
+    /** One operation on a set and its model. */
+    sealed interface SetOp permits Add, Remove, AddAll, RemoveAll, Union, Intersect, Diff {}
+
+    record Add(Integer x) implements SetOp {}
+
+    record Remove(Integer x) implements SetOp {}
+
+    record AddAll(java.util.List<Integer> xs) implements SetOp {}
+
+    record RemoveAll(java.util.List<Integer> xs) implements SetOp {}
+
+    record Union(java.util.List<Integer> xs) implements SetOp {}
+
+    record Intersect(java.util.List<Integer> xs) implements SetOp {}
+
+    record Diff(java.util.List<Integer> xs) implements SetOp {}
+
+    static Generator<SetOp> setOp(boolean nulls) {
+        Generator<Integer> x = element(nulls);
+        Generator<java.util.List<Integer>> xs = smallInts(nulls);
+        return Generators.<SetOp>oneOf(x.map(Add::new), x.map(Remove::new), xs.map(AddAll::new), xs.map(RemoveAll::new), xs.map(Union::new),
+                xs.map(Intersect::new), xs.map(Diff::new));
+    }
+
+    /** A set: its kind, whether nulls are allowed (never in a TreeSet), the initial elements, whether the collector builds it, the operations, an element to probe. */
+    record SetCase(String kind, boolean nulls, java.util.List<Integer> init, boolean collector, java.util.List<SetOp> ops, int probe) {}
+
+    static final Generator<SetCase> SET_CASE = sampledFrom(SET_KINDS).flatMap(sk -> (sk.equals("TreeSet") ? just(false) : chance(25)).flatMap(nulls ->
+            tuples(smallInts(nulls), chance(50), lists(setOp(nulls)).maxSize(8), ints(-3, 12))
+                    .map(t -> new SetCase(sk, nulls, t.value1(), t.value2(), t.value3(), t.value4()))));
+
+    /** Set (or clear) a bit: small, up to 5000, or (5 in 7) at a word boundary. */
+    record BitOp(boolean add, int x) {}
+
+    static final Generator<Integer> BIT = weighted(w(1, ints(0, 70)), w(1, ints(0, 5000)), w(5, sampledFrom(63, 64, 127, 128, 0)));
+    static final Generator<BitOp> BIT_OP = tuples(chance(65), BIT).map(t -> new BitOp(t.value1(), t.value2()));
+
+    /** The bit operations, a bit to query, and the range (lo, lo + delta) to compare with. */
+    record BitCase(java.util.List<BitOp> ops, int query, int lo, int delta) {}
+
+    static final Generator<BitCase> BIT_CASE = tuples(lists(BIT_OP).maxSize(10), weighted(w(1, ints(0, 70)), w(2, sampledFrom(64, 5000))), ints(0, 80), ints(-2, 80))
+            .map(t -> new BitCase(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    /** One operation on a map and its model. */
+    sealed interface MapOp permits Put, RemoveKey, Merge, ComputeIfAbsent {}
+
+    record Put(int k, int v) implements MapOp {}
+
+    record RemoveKey(int k) implements MapOp {}
+
+    record Entry(int k, int v) {}
+
+    /** merge(other) ({@code how} 0: this map's values win), merge(other, (a, b) -> b) (1) or merge(other, (a, b) -> a * 1000 + b) (2). */
+    record Merge(java.util.List<Entry> entries, int how) implements MapOp {}
+
+    record ComputeIfAbsent(int k) implements MapOp {}
+
+    static final Generator<Integer> KEY = ints(-2, 8);
+    static final Generator<Integer> VALUE = ints(0, 100);
+    static final Generator<Entry> ENTRY = tuples(KEY, VALUE).map(t -> new Entry(t.value1(), t.value2()));
+
+    /** A put (twice as likely), a removal, a merge with up to four entries, or a computeIfAbsent. */
+    static final Generator<MapOp> MAP_OP = weighted(
+            w(2, tuples(KEY, VALUE).<MapOp>map(t -> new Put(t.value1(), t.value2()))),
+            w(1, KEY.<MapOp>map(RemoveKey::new)),
+            w(1, tuples(lists(ENTRY).maxSize(4), ints(0, 2)).<MapOp>map(t -> new Merge(t.value1(), t.value2()))),
+            w(1, KEY.<MapOp>map(ComputeIfAbsent::new)));
+
+    /** A map: its kind, the operations, and a key that is never put. */
+    record MapCase(String kind, java.util.List<MapOp> ops, int absent) {}
+
+    static final Generator<MapCase> MAP_CASE = tuples(sampledFrom(MAP_KINDS), lists(MAP_OP).maxSize(12), ints(20, 30))
+            .map(t -> new MapCase(t.value1(), t.value2(), t.value3()));
+
+    /** put (75%) or remove a key-value pair of a multimap. */
+    record MultiOp(boolean put, int k, int v) {}
+
+    static final Generator<MultiOp> MULTI_OP = tuples(chance(75), ints(0, 4), ints(0, 5)).map(t -> new MultiOp(t.value1(), t.value2(), t.value3()));
+
+    /** A multimap: its container type and the operations. */
+    record MultiCase(String container, java.util.List<MultiOp> ops) {}
+
+    static final Generator<MultiCase> MULTI_CASE = tuples(sampledFrom("SEQ", "SET", "SORTED_SET"), lists(MULTI_OP).maxSize(10))
+            .map(t -> new MultiCase(t.value1(), t.value2()));
+
+    record SetsCase(SetCase set, BitCase bits, MapCase map, MultiCase multi) {}
+
+    static final Generator<SetsCase> SETS_CASE = tuples(SET_CASE, BIT_CASE, MAP_CASE, MULTI_CASE)
+            .map(t -> new SetsCase(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    static int unorderedHash(Iterable<?> it) {
+        int h = 1;
+        for (Object o : it) {
+            h += Objects.hashCode(o);
+        }
+        return h;
+    }
+
+    static java.util.List<Integer> sortedCopy(java.util.Collection<Integer> c) {
+        java.util.List<Integer> l = new ArrayList<>(c);
+        l.sort(Comparator.nullsFirst(Comparator.naturalOrder()));
+        return l;
+    }
+
+    // ---- sets, maps, multimaps -------------------------------------------------------------------
+
+    @Test
+    void setsMapsAndMultimapsMatchTheirJavaModels() {
+        Hegel.test(tc -> {
+            SetsCase all = tc.draw(SETS_CASE, "case");
+            // sets
+            SetCase sc = all.set();
+            String sk = sc.kind();
+            boolean nulls = sc.nulls();
+            java.util.List<Integer> init = sc.init();
+            java.util.Set<Integer> ms = sk.equals("TreeSet") ? new java.util.TreeSet<>() : sk.equals("LinkedHashSet") ? new java.util.LinkedHashSet<>() : new java.util.HashSet<>();
+            ms.addAll(init);
+            boolean collector = sc.collector();
+            Set<Integer> s = sk.equals("TreeSet") ? (collector ? init.stream().collect(TreeSet.collector()) : TreeSet.ofAll(init))
+                    : sk.equals("LinkedHashSet") ? (collector ? init.stream().collect(LinkedHashSet.collector()) : LinkedHashSet.ofAll(init))
+                    : (collector ? init.stream().collect(HashSet.collector()) : HashSet.ofAll(init));
+            for (SetOp op : sc.ops()) {
+                switch (op) {
+                    case Add add -> {
+                        Integer x = add.x();
+                        Set<Integer> added = s.add(x);
+                        if (ms.contains(x)) {
+                            check(added == s, () -> sk + ".add(" + x + ") of a present element returned a new instance (documented: may be this)");
+                        }
+                        s = added;
+                        ms.add(x);
+                    }
+                    case Remove remove -> {
+                        s = s.remove(remove.x());
+                        ms.remove(remove.x());
+                    }
+                    case AddAll addAll -> {
+                        s = s.addAll(addAll.xs());
+                        ms.addAll(addAll.xs());
+                    }
+                    case RemoveAll removeAll -> {
+                        s = s.removeAll(removeAll.xs());
+                        ms.removeAll(removeAll.xs());
+                    }
+                    case Union union -> { // encounter order of the argument (documented)
+                        s = s.union(LinkedHashSet.ofAll(union.xs()));
+                        ms.addAll(union.xs());
+                    }
+                    case Intersect intersect -> {
+                        s = s.intersect(LinkedHashSet.ofAll(intersect.xs()));
+                        ms.retainAll(new java.util.HashSet<>(intersect.xs()));
+                    }
+                    case Diff diff -> {
+                        java.util.List<Integer> nonNull = diff.xs().stream().filter(Objects::nonNull).collect(Collectors.toList());
+                        s = s.diff(TreeSet.ofAll(nonNull));
+                        ms.removeAll(nonNull);
+                    }
+                }
+            }
+            final Set<Integer> fs = s;
+            String stag = sk + ms;
+            check(fs.size() == ms.size(), () -> "size " + fs.size() + " != " + ms.size() + " for " + stag);
+            check(new java.util.HashSet<>(list(fs)).equals(ms) && list(fs).size() == ms.size(), () -> "elements " + fs + " != " + ms);
+            if (!sk.equals("HashSet")) {
+                same("iteration order " + stag, fs, new ArrayList<>(ms));
+                check(fs.toString().equals(sk + "(" + ms.stream().map(String::valueOf).collect(Collectors.joining(", ")) + ")"), () -> "toString " + fs + " for " + stag);
+                same("toList order " + stag, fs.toList(), new ArrayList<>(ms));
+                if (!ms.isEmpty()) {
+                    check(Objects.equals(fs.head(), ms.iterator().next()), "head is not the first in iteration order " + stag);
+                }
+            }
+            Integer probe = sc.probe();
+            check(fs.contains(probe) == ms.contains(probe), "contains(" + probe + ") " + stag);
+            check(fs.hashCode() == unorderedHash(ms), () -> "hashCode " + fs.hashCode() + " != 1 + sum " + unorderedHash(ms) + " (documented) for " + stag);
+            check(fs.equals(HashSet.ofAll(ms)) && fs.equals(LinkedHashSet.ofAll(ms)) && HashSet.ofAll(ms).equals(fs), "equality across Set implementations " + stag);
+            if (sk.equals("TreeSet") || !ms.contains(null)) {
+                check(fs.equals(TreeSet.ofAll(ms)) && TreeSet.ofAll(ms).equals(fs), "equality with TreeSet " + stag);
+                check(TreeSet.ofAll(ms).hashCode() == fs.hashCode(), "hashCode differs from TreeSet's " + stag);
+                same("toSortedSet " + stag, fs.toSortedSet(), sortedCopy(ms));
+                if (!ms.isEmpty()) {
+                    check(fs.min().get().equals(java.util.Collections.min(ms)) && fs.max().get().equals(java.util.Collections.max(ms)), "min/max " + stag);
+                }
+            }
+            check(!fs.equals(List.ofAll(ms)) && !fs.equals(HashMap.empty()), "Set equals a Seq or a Map " + stag);
+            check(fs.toJavaSet().equals(ms), "toJavaSet " + stag);
+            check(new java.util.HashSet<>(list(fs.map(x -> x == null ? 0 : x * 2))).equals(ms.stream().map(x -> x == null ? 0 : x * 2).collect(Collectors.toSet())), "map " + stag);
+            check(new java.util.HashSet<>(list(fs.filter(x -> x != null && x > 3))).equals(ms.stream().filter(x -> x != null && x > 3).collect(Collectors.toSet())), "filter " + stag);
+            check(fs.removeAll(fs).isEmpty() && fs.diff(fs).isEmpty() && fs.intersect(fs).equals(fs) && fs.union(fs).equals(fs), "set algebra with itself " + stag);
+            try {
+                Object back = deserialize(serialize(fs));
+                check(back.equals(fs) && back.hashCode() == fs.hashCode(), () -> "deserialized set not equal: " + back + " vs " + fs);
+            } catch (IOException | ClassNotFoundException ex) {
+                fail("set serialization threw " + ex + " for " + stag);
+            }
+            if (sk.equals("TreeSet") && !ms.isEmpty()) {
+                TreeSet<Integer> desc = TreeSet.ofAll(Comparator.reverseOrder(), ms);
+                java.util.List<Integer> descM = sortedCopy(ms);
+                java.util.Collections.reverse(descM);
+                same("TreeSet(reverseOrder) order", desc, descM);
+                check(desc.equals(fs) && desc.hashCode() == fs.hashCode(), "TreeSets with different comparators but the same elements are not equal");
+                check(desc.head().equals(descM.get(0)) && desc.last().equals(descM.get(descM.size() - 1)), "TreeSet(reverseOrder) head/last");
+                check(desc.min().get().equals(java.util.Collections.min(ms)) && desc.max().get().equals(java.util.Collections.max(ms)), () -> "TreeSet(reverseOrder) min/max " + desc.min() + "/" + desc.max() + " (natural order documented: the underlying order is not considered)");
+            }
+
+            // BitSet against java.util.BitSet
+            java.util.BitSet bm = new java.util.BitSet();
+            io.vavr.collection.BitSet<Integer> bs = io.vavr.collection.BitSet.empty();
+            BitCase bc = all.bits();
+            for (BitOp op : bc.ops()) {
+                int x = op.x();
+                if (op.add()) {
+                    bs = bs.add(x);
+                    bm.set(x);
+                } else {
+                    bs = bs.remove(x);
+                    bm.clear(x);
+                }
+            }
+            final io.vavr.collection.BitSet<Integer> fbs = bs;
+            same("BitSet iteration " + bm, fbs, bm.stream().boxed().collect(Collectors.toList()));
+            check(fbs.size() == bm.cardinality(), "BitSet size " + bm);
+            int bq = bc.query();
+            check(fbs.contains(bq) == bm.get(bq), "BitSet contains(" + bq + ") " + bm);
+            expect("BitSet.add(-1)", IllegalArgumentException.class, () -> fbs.add(-1));
+            expect("BitSet.contains(-1)", IllegalArgumentException.class, () -> fbs.contains(-1));
+            expect("BitSet.remove(-1)", IllegalArgumentException.class, () -> fbs.remove(-1));
+            int rlo = bc.lo(), rhi = rlo + bc.delta();
+            same("BitSet.range(" + rlo + ", " + rhi + ")", io.vavr.collection.BitSet.range(rlo, rhi), list(io.vavr.collection.Iterator.range(rlo, rhi)));
+            java.util.BitSet bm2 = (java.util.BitSet) bm.clone();
+            bm2.set(rlo, Math.max(rlo, rhi));
+            same("BitSet union range", fbs.union(io.vavr.collection.BitSet.range(rlo, rhi)), bm2.stream().boxed().collect(Collectors.toList()));
+            java.util.BitSet bm3 = (java.util.BitSet) bm.clone();
+            bm3.and(io.vavr.collection.BitSet.range(rlo, rhi).isEmpty() ? new java.util.BitSet() : bitSetOf(rlo, rhi));
+            same("BitSet intersect range", fbs.intersect(io.vavr.collection.BitSet.range(rlo, rhi)), bm3.stream().boxed().collect(Collectors.toList()));
+            check(fbs.toString().equals("BitSet(" + bm.stream().mapToObj(String::valueOf).collect(Collectors.joining(", ")) + ")"), () -> "BitSet toString " + fbs);
+            check(fbs.equals(HashSet.ofAll(bm.stream().boxed().collect(Collectors.toList()))), "BitSet equals HashSet of the same elements");
+            check(fbs.hashCode() == unorderedHash(bm.stream().boxed().collect(Collectors.toList())), "BitSet hashCode formula");
+
+            // maps
+            MapCase mc = all.map();
+            String mk = mc.kind();
+            java.util.Map<Integer, Integer> mm = mk.equals("TreeMap") ? new java.util.TreeMap<>() : mk.equals("LinkedHashMap") ? new java.util.LinkedHashMap<>() : new java.util.HashMap<>();
+            Map<Integer, Integer> map = mk.equals("TreeMap") ? TreeMap.empty() : mk.equals("LinkedHashMap") ? LinkedHashMap.empty() : HashMap.empty();
+            boolean linkedReput = false;
+            for (MapOp op : mc.ops()) {
+                switch (op) {
+                    case Put put -> {
+                        Integer kk = put.k(), vv = put.v();
+                        if (mk.equals("LinkedHashMap") && mm.containsKey(kk) && !Objects.equals(mm.get(kk), vv)) {
+                            linkedReput = true; // the position of a re-put key is not documented
+                        }
+                        map = map.put(kk, vv);
+                        mm.put(kk, vv);
+                    }
+                    case RemoveKey remove -> {
+                        map = map.remove(remove.k());
+                        mm.remove(remove.k());
+                    }
+                    case Merge merge -> {
+                        java.util.Map<Integer, Integer> other = new java.util.LinkedHashMap<>();
+                        for (Entry en : merge.entries()) {
+                            other.put(en.k(), en.v());
+                        }
+                        int how = merge.how();
