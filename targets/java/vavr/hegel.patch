+            char ct = c.chars().to();
+            int cs = c.chars().step();
+            String ctag = "(" + (int) cf + ", " + (int) ct + ", " + cs + ")";
+            BigInteger bcf = BigInteger.valueOf(cf), bct = BigInteger.valueOf(ct), bcs = BigInteger.valueOf(cs);
+            if (cs == 0) {
+                expect("rangeBy(char)" + ctag, IllegalArgumentException.class, () -> Iterator.rangeBy(cf, ct, cs));
+            } else {
+                same("Iterator.rangeBy(char)" + ctag, bigChars(Iterator.rangeBy(cf, ct, cs).take(100)), arith(bcf, bct, bcs, false, 100));
+                same("Iterator.rangeClosedBy(char)" + ctag, bigChars(Iterator.rangeClosedBy(cf, ct, cs).take(100)), arith(bcf, bct, bcs, true, 100));
+                same("CharSeq.rangeClosedBy" + ctag, bigChars(io.vavr.collection.CharSeq.rangeClosedBy(cf, ct, cs).take(100)), arith(bcf, bct, bcs, true, 100));
+                same("List.rangeBy(char)" + ctag, bigChars(List.rangeBy(cf, ct, cs).take(100)), arith(bcf, bct, bcs, false, 100));
+            }
+            if (Math.abs(ct - cf) < 300) {
+                same("Iterator.range(char)" + ctag, bigChars(Iterator.range(cf, ct)), arith(bcf, bct, BigInteger.ONE, false, 400));
+                same("Iterator.rangeClosed(char)" + ctag, bigChars(Iterator.rangeClosed(cf, ct)), arith(bcf, bct, BigInteger.ONE, true, 400));
+                same("CharSeq.range" + ctag, bigChars(io.vavr.collection.CharSeq.range(cf, ct)), arith(bcf, bct, BigInteger.ONE, false, 400));
+            }
+
+            // double ranges go through BigDecimal (Iterator.java 544-546): exact decimal arithmetic is the model
+            BigDecimal df = c.doubles().from().value();
+            BigDecimal dt = df.add(c.doubles().delta().value());
+            BigDecimal ds = c.doubles().step().value();
+            String dtag = "(" + df + ", " + dt + ", " + ds + ")";
+            if (ds.signum() == 0) {
+                expect("rangeBy(double)" + dtag, IllegalArgumentException.class, () -> Iterator.rangeBy(df.doubleValue(), dt.doubleValue(), ds.doubleValue()));
+            } else {
+                java.util.List<Double> wantD = new ArrayList<>(), wantDC = new ArrayList<>();
+                int dir = dt.compareTo(df);
+                if (dir == 0) {
+                    wantDC.add(df.doubleValue());
+                } else if ((dir > 0) == (ds.signum() > 0)) {
+                    for (BigDecimal x = df; (ds.signum() > 0 ? x.compareTo(dt) < 0 : x.compareTo(dt) > 0) && wantD.size() <= 200; x = x.add(ds)) {
+                        wantD.add(x.doubleValue());
+                    }
+                    for (BigDecimal x = df; (ds.signum() > 0 ? x.compareTo(dt) <= 0 : x.compareTo(dt) >= 0) && wantDC.size() <= 200; x = x.add(ds)) {
+                        wantDC.add(x.doubleValue());
+                    }
+                }
+                same("Iterator.rangeBy(double)" + dtag, Iterator.rangeBy(df.doubleValue(), dt.doubleValue(), ds.doubleValue()).take(201), wantD);
+                same("Iterator.rangeClosedBy(double)" + dtag, Iterator.rangeClosedBy(df.doubleValue(), dt.doubleValue(), ds.doubleValue()).take(201), wantDC);
+                same("Vector.rangeClosedBy(double)" + dtag, Vector.rangeClosedBy(df.doubleValue(), dt.doubleValue(), ds.doubleValue()).take(201), wantDC);
+            }
+
+            // documented examples (Iterator.java 638-641, 738-741, 811+)
+            same("rangeBy(1, 3, 1)", Iterator.rangeBy(1, 3, 1), java.util.List.of(1, 2));
+            same("rangeBy(1, 4, 2)", Iterator.rangeBy(1, 4, 2), java.util.List.of(1, 3));
+            same("rangeBy(4, 1, -2)", Iterator.rangeBy(4, 1, -2), java.util.List.of(4, 2));
+            same("rangeBy(4, 1, 2)", Iterator.rangeBy(4, 1, 2), java.util.List.of());
+            same("rangeClosedBy(1, 3, 1)", Iterator.rangeClosedBy(1, 3, 1), java.util.List.of(1, 2, 3));
+            same("rangeClosedBy('d', 'a', -2)", Iterator.rangeClosedBy('d', 'a', -2), java.util.List.of('d', 'b'));
+            same("rangeClosedBy(5, 5, -1) (singleton even against the step, documented)", Iterator.rangeClosedBy(5, 5, -1), java.util.List.of(5));
+
+            // Stream.from wraps (documented); infinite streams stay lazy
+            int f2 = c.f2();
+            int st2 = c.st2();
+            java.util.List<Integer> wantFrom = new ArrayList<>();
+            for (int j = 0, x = f2; j < 5; j++, x += st2) {
+                wantFrom.add(x);
+            }
+            same("Stream.from(" + f2 + ", " + st2 + ").take(5)", Stream.from(f2, st2).take(5), wantFrom);
+            same("Iterator.from(" + f2 + ").take(3)", Iterator.from(f2).take(3), java.util.List.of(f2, f2 + 1, f2 + 2));
+            Stream<Integer> nat = Stream.from(0);
+            int tk = c.tk();
+            same("Stream.from(0).take(" + tk + ")", nat.take(tk), list(Iterator.range(0, tk)));
+            same("Stream.from(0).drop(" + tk + ").take(3)", nat.drop(tk).take(3), java.util.List.of(tk, tk + 1, tk + 2));
+            same("Stream.iterate(1, x -> 2x).take(" + tk + ")", Stream.iterate(1, x -> x * 2).take(tk), list(Iterator.range(0, tk).map(j -> 1 << j)));
+            same("Stream.continually(7).take(3)", Stream.continually(7).take(3), java.util.List.of(7, 7, 7));
+            same("Stream.from(0).scanLeft(0, +).take(" + tk + ")", nat.scanLeft(0, Integer::sum).take(tk), list(Iterator.range(0, tk).map(j -> j * (j - 1) / 2)));
+            same("Stream.from(0).map(*2).filter(%3 == 0).take(4)", nat.map(x -> x * 2).filter(x -> x % 3 == 0).take(4), java.util.List.of(0, 6, 12, 18));
+            same("Stream.from(0).zip(from(10)).take(3)", nat.zip(Stream.from(10)).take(3), java.util.List.of(new Tuple2<>(0, 10), new Tuple2<>(1, 11), new Tuple2<>(2, 12)));
+            same("Stream.from(0).zipWithIndex().take(2)", nat.zipWithIndex().take(2), java.util.List.of(new Tuple2<>(0, 0), new Tuple2<>(1, 1)));
+            same("Stream.from(0).takeWhile(< " + tk + ")", nat.takeWhile(x -> x < tk), list(Iterator.range(0, tk)));
+            same("Stream.from(0).dropWhile(< " + tk + ").take(2)", nat.dropWhile(x -> x < tk).take(2), java.util.List.of(tk, tk + 1));
+            same("Stream.from(0).sliding(2, 3).take(2)", nat.sliding(2, 3).take(2).map(VavrTest::list), java.util.List.of(java.util.List.of(0, 1), java.util.List.of(3, 4)));
+            same("Stream.from(0).grouped(3).take(2)", nat.grouped(3).take(2).map(VavrTest::list), java.util.List.of(java.util.List.of(0, 1, 2), java.util.List.of(3, 4, 5)));
+            same("Stream.from(0).intersperse(-1).take(5)", nat.intersperse(-1).take(5), java.util.List.of(0, -1, 1, -1, 2));
+            same("Stream.from(0).distinctBy(x / 3).take(3)", nat.distinctBy(x -> x / 3).take(3), java.util.List.of(0, 3, 6));
+            check(nat.asPartialFunction().isDefinedAt(1_000_000) && !nat.asPartialFunction().isDefinedAt(-1), "asPartialFunction on an infinite stream (LinearSeq.java 71-82)");
+            check(nat.get(tk) == tk && nat.indexOf(tk) == tk && nat.contains(tk) && nat.find(x -> x > tk).get() == tk + 1, "get/indexOf/contains/find on an infinite stream");
+            check(nat.startsWith(java.util.List.of(0, 1, 2)) && !nat.startsWith(java.util.List.of(1)) && nat.startsWith(java.util.List.of(tk, tk + 1), tk) && !nat.startsWith(java.util.List.of(), -1),
+                    "startsWith on an infinite stream (false for a negative offset, documented)");
+            check(!nat.hasDefiniteSize() && !nat.spliterator().hasCharacteristics(Spliterator.SIZED), "infinite stream claims a definite size");
+            check(nat.head() == 0 && nat.tail().head() == 1, "head/tail of Stream.from(0)");
+            check(nat.take(tk).length() == tk && nat.take(-5).isEmpty(), "take on an infinite stream");
+            Stream<Integer> cons = Stream.cons(5, () -> Stream.of(6, 7));
+            same("Stream.cons(5, () -> (6, 7))", cons, java.util.List.of(5, 6, 7));
+            // Iterator single pass: after exhausting, next() throws NoSuchElementException
+            Iterator<Integer> it = Iterator.range(0, tk);
+            list(it);
+            check(!it.hasNext(), "exhausted iterator hasNext");
+            expect("exhausted Iterator.next()", java.util.NoSuchElementException.class, it::next);
+            expect("Iterator.empty().next()", java.util.NoSuchElementException.class, () -> Iterator.empty().next());
+        }, Zoo.settings("rangesMatchExactArithmeticAndStreamsStayLazy"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..9fe177a
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,62 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
