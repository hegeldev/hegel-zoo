+import org.junit.jupiter.api.Test;
+
+/**
+ * Vavr's sequences against a java.util.ArrayList model and the rules their Javadoc states (Seq.java,
+ * Traversable.java, Iterator.java); the ranges against exact BigInteger/BigDecimal arithmetic.
+ */
+class VavrTest {
+
+    static final String[] KINDS = {"List", "Vector", "Array", "Stream", "Queue"};
+
+    // ---- helpers -----------------------------------------------------------------------------
+
+    static <T> java.util.List<T> list(Iterable<T> it) {
+        java.util.List<T> out = new ArrayList<>();
+        for (T t : it) {
+            out.add(t);
+        }
+        return out;
+    }
+
+    static String show(java.util.List<?> l) {
+        String s = l.toString();
+        return s.length() > 200 ? s.substring(0, 200) + "…(" + l.size() + ")" : s;
+    }
+
+    static void same(String what, Iterable<?> got, java.util.List<?> want) {
+        java.util.List<?> g;
+        try {
+            g = list(got);
+        } catch (RuntimeException e) {
+            fail(what + " threw " + e + " while iterating; want " + show(want));
+            return;
+        }
+        if (!g.equals(want)) {
+            fail(what + ": got " + show(g) + ", want " + show(want));
+        }
+    }
+
+    /** Runs r and reports the exception class it threw (null when none). Never draws inside r. */
+    static Class<?> thrown(Runnable r) {
+        try {
+            r.run();
+            return null;
+        } catch (Throwable t) {
+            if (t.getClass().getName().startsWith("dev.hegel.")) {
+                throw t;
+            }
+            return t.getClass();
+        }
+    }
+
+    /** Streams are lazy: index errors of insert/insertAll/removeAt/subSequence surface when the tail is evaluated. */
+    static Object force(Object o) {
+        return o instanceof Stream ? ((Stream<?>) o).toList() : o;
+    }
+
+    static void expect(String what, Class<?> want, Runnable r) {
+        Class<?> got = thrown(r);
+        if (got != want) {
+            fail(what + " threw " + (got == null ? "nothing" : got.getName()) + ", documented " + (want == null ? "no exception" : want.getName()));
+        }
+    }
+
+    // ---- generators ----------------------------------------------------------------------------
+
+    static final Generator<String> KIND = sampledFrom(KINDS);
+
+    /** Small ints (so that duplicates are common), 12% nulls when asked for; up to 30 of them, one time in seven at most 2. */
+    static Generator<java.util.List<Integer>> smallInts(boolean nulls) {
+        Generator<Integer> element = nulls ? maybe(12, (Integer) null, ints(-3, 9)) : ints(-3, 9);
+        return weighted(w(15, lists(element).maxSize(2)), w(85, lists(element).maxSize(30)));
+    }
+
+    /** How a sequence is built from its elements: ofAll, varargs of, the collector, or tabulate (a Queue: enqueued after some churn). */
+    record Build(int how, int churn) {
+        Seq<Integer> apply(String kind, java.util.List<Integer> m) {
+            Integer[] arr = m.toArray(new Integer[0]);
+            switch (kind) {
+                case "List":
+                    return how == 0 ? List.ofAll(m) : how == 1 ? List.of(arr) : how == 2 ? m.stream().collect(List.collector()) : List.tabulate(m.size(), m::get);
+                case "Vector":
+                    return how == 0 ? Vector.ofAll(m) : how == 1 ? Vector.of(arr) : how == 2 ? m.stream().collect(Vector.collector()) : Vector.tabulate(m.size(), m::get);
+                case "Array":
+                    return how == 0 ? Array.ofAll(m) : how == 1 ? Array.of(arr) : how == 2 ? m.stream().collect(Array.collector()) : Array.tabulate(m.size(), m::get);
+                case "Stream":
+                    return how == 0 ? Stream.ofAll(m) : how == 1 ? Stream.of(arr) : how == 2 ? m.stream().collect(Stream.collector()) : Stream.tabulate(m.size(), m::get);
+                default: {
+                    if (how == 0) {
+                        return Queue.ofAll(m);
+                    }
+                    if (how == 1) {
+                        return Queue.of(arr);
+                    }
+                    // exercise the front/rear representation: enqueue everything after some churn
+                    Queue<Integer> q = Queue.empty();
+                    for (int i = 0; i < churn; i++) {
+                        q = q.enqueue(i);
+                    }
+                    for (int i = 0; i < churn; i++) {
+                        q = q.dequeue()._2;
+                    }
+                    for (Integer x : m) {
+                        q = q.enqueue(x);
+                    }
+                    return q;
+                }
+            }
+        }
+    }
+
+    static final Generator<Build> BUILD = tuples(ints(0, 3), ints(0, 6)).map(t -> new Build(t.value1(), t.value2()));
+
+    /**
+     * The sequence under test: its kind, whether nulls are allowed, its elements and how it is built; a second kind
+     * with two builds for the equality checks; the lists the operations take, and the slice to search for (absent:
+     * a slice of the sequence itself).
+     */
+    record Shape(String kind, boolean nulls, java.util.List<Integer> m, Build build, String otherKind, Build otherBuild, Build changedBuild,
+            java.util.List<Integer> more, java.util.List<Integer> more2, java.util.List<Integer> other, java.util.List<Integer> slice) {}
+
+    static final Generator<Shape> SHAPE = chance(30).flatMap(nulls -> {
+        Generator<java.util.List<Integer>> xs = smallInts(nulls);
+        return tuples(tuples(KIND, xs, BUILD, KIND, BUILD, BUILD), tuples(xs, xs, xs, maybe(30, (java.util.List<Integer>) null, xs)))
+                .map(t -> new Shape(t.value1().value1(), nulls, t.value1().value2(), t.value1().value3(), t.value1().value4(), t.value1().value5(),
+                        t.value1().value6(), t.value2().value1(), t.value2().value2(), t.value2().value3(), t.value2().value4()));
+    });
+
+    /** An index around the sequence and how many elements a patch there replaces (in range only when the index is). */
+    record Patch(int i, int replaced) {}
+
+    /** Slice bounds: around the sequence, or (15%) both before its start, the shapes of vavr/5 and vavr/6. */
+    record Bounds(int b, int e) {}
+
+    /** The probes of a sequence of length {@code len}: the index, a value, a take/drop count, slice bounds, the predicate's limit, a segment start, a needle and a search start. */
+    record Probe(Patch patch, int v, int k, Bounds bounds, int limit, int seg, Integer needle, int from) {}
+
+    static Generator<Probe> probe(java.util.List<Integer> m) {
+        int len = m.size();
+        Generator<Patch> patch = ints(-2, len + 2).flatMap(i -> ints(0, Math.max(0, len - i)).map(r -> new Patch(i, r)));
+        Generator<Integer> k = oneOf(ints(-3, len + 3), just(0), just(len), just(Integer.MIN_VALUE), just(Integer.MAX_VALUE));
+        Generator<Bounds> bounds = weighted(w(85, tuples(ints(-3, len + 3), ints(-3, len + 3))), w(15, tuples(ints(-3, 0), ints(-3, 0))))
+                .map(t -> new Bounds(t.value1(), t.value2()));
+        Generator<Integer> needle = len == 0 ? ints(-3, 9) : weighted(w(30, ints(-3, 9)), w(70, ints(0, len - 1).map(m::get)));
+        return tuples(patch, ints(-3, 9), k, bounds, ints(-3, 9), ints(0, len), needle, ints(-1, len + 1))
+                .map(t -> new Probe(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+    }
+
+    record Windows(int size, int step) {}
+
+    /** More positions and counts: a startsWith offset, a rotation, a pad length, grouped/sliding sizes, the index to change, a search key, the combination size and the cross-product power. */
+    record Ops(int off, int rot, int padLen, Windows windows, int changedAt, Integer q, int kk, int power) {}
+
+    static Generator<Ops> ops(java.util.List<Integer> m) {
+        int len = m.size();
+        Generator<Integer> q = len == 0 ? ints(-4, 10) : oneOf(ints(-4, 10), just(m.get(0)));
+        return tuples(ints(-2, len + 1), ints(0, len), ints(0, len + 4), tuples(ints(1, 5), ints(1, 5)).map(t -> new Windows(t.value1(), t.value2())),
+                ints(0, Math.max(0, len - 1)), q, ints(0, len), ints(-1, 2))
+                .map(t -> new Ops(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+    }
+
+    record SeqCase(Shape shape, Probe probe, Ops ops) {}
+
+    static final Generator<SeqCase> SEQ_CASE = SHAPE.flatMap(sh -> tuples(probe(sh.m()), ops(sh.m())).map(t -> new SeqCase(sh, t.value1(), t.value2())));
+
+    static long fact(int k) {
+        long f = 1;
+        for (int i = 2; i <= k; i++) {
+            f *= i;
+        }
+        return f;
+    }
+
+    static long binom(int nn, int k) {
+        if (k < 0 || k > nn) {
+            return 0;
+        }
+        return fact(nn) / (fact(k) * fact(nn - k));
+    }
+
+    static byte[] serialize(Object o) throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        try (ObjectOutputStream oos = new ObjectOutputStream(bos)) {
+            oos.writeObject(o);
+        }
+        return bos.toByteArray();
+    }
+
+    static Object deserialize(byte[] b) throws IOException, ClassNotFoundException {
+        try (ObjectInputStream ois = new ObjectInputStream(new ByteArrayInputStream(b))) {
+            return ois.readObject();
+        }
+    }
+
+    static final Comparator<Integer> NULLS_FIRST = Comparator.nullsFirst(Comparator.naturalOrder());
+
+    static void permute(java.util.List<Integer> a, int k, HashSet<java.util.List<Integer>> out) {
+        if (k == a.size()) {
+            out.add(new ArrayList<>(a));
+            return;
+        }
+        for (int i = k; i < a.size(); i++) {
+            Collections.swap(a, k, i);
+            permute(a, k + 1, out);
+            Collections.swap(a, k, i);
+        }
+    }
+
+    static <T> java.util.List<T> rev(java.util.List<T> l) {
+        java.util.List<T> r = new ArrayList<>(l);
+        Collections.reverse(r);
+        return r;
+    }
