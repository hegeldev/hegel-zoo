@@ -0,0 +1,50 @@
+package zoo;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import io.vavr.collection.Array;
+import io.vavr.collection.CharSeq;
+import io.vavr.collection.List;
+import io.vavr.collection.Stream;
+import io.vavr.collection.Vector;
+import io.vavr.control.Option;
+import org.junit.jupiter.api.Test;
+
+/**
+ * One pin per bug in bugs.toml: each asserts the documented (correct) behaviour and fails while the
+ * bug exists; `zoo` expects them to fail (target.toml `[expected_failures]`).
+ */
+class VavrPinsTest {
+
+    @Test
+    void pinListRemoveToleratesNullElements() { // vavr/1
+        assertEquals(List.of(1, null), List.of(1, null, 2).remove(2));
+    }
+
+    @Test
+    void pinMinOfASingleNullIsSomeNull() { // vavr/2
+        assertEquals(Option.some(null), List.of((Integer) null).min());
+    }
+
+    @Test
+    void pinVectorTakeRightOfALargeNegativeIsEmpty() { // vavr/3
+        assertEquals(Vector.empty(), Vector.of(1, 2, 3).takeRight(Integer.MIN_VALUE));
+        assertEquals(Vector.of(1, 2, 3), Vector.of(1, 2, 3).dropRight(Integer.MIN_VALUE));
+    }
+
+    @Test
+    void pinCharSeqReverseReversesItsCharacters() { // vavr/4
+        CharSeq c = CharSeq.of("c\uD83D\uDE00");
+        assertEquals(List.ofAll(c).reverse(), c.reverse());
+    }
+
+    @Test
+    void pinStreamSliceEndingBeforeTheStartIsEmpty() { // vavr/5
+        assertEquals(List.empty(), Stream.of(8, 9).slice(-2, -1).toList());
+    }
+
+    @Test
+    void pinArraySliceWithNegativeBoundsIsEmpty() { // vavr/6
+        assertEquals(Array.empty(), Array.of(8, 9).slice(-3, -1));
+    }
+}
