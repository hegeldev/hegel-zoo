+    static final String[] PIECES = {"a", "b", "c", "A", "B", " ", "  ", "0", "1", "9", ".", "-", "_", ":", "é", "ß", "İ", "́", "😀", "\uD83D", "\uDE00", "\t", "\n", "x", "y", "z", "ab", "abc", "ba"};
+
+    /** Up to 12 pieces joined. */
+    static final Generator<String> TEXT = lists(sampledFrom(PIECES)).maxSize(12).map(l -> String.join("", l));
+
+    static final Generator<Integer> CODE_POINT = sampledFrom((int) 'a', (int) ' ', 0x1F600, 0xD83D, (int) 'é');
+    static final Generator<Character> CHAR = sampledFrom('a', ' ', 'z', '\uD83D');
+    static final Generator<String> REGEX = sampledFrom("a", "b+", " ", "[ab]", "\\s+", "", "(?i)A", ".", "x*");
+    static final Generator<Integer> LIMIT = sampledFrom(0, -1, 1, 2, 3);
+
+    /** A fresh text, or (40%, when {@code s} is not empty) a substring of {@code s} around its middle. */
+    static Generator<String> other(String s) {
+        int len = s.length();
+        if (len == 0) {
+            return TEXT;
+        }
+        Generator<String> substring = tuples(ints(0, len / 2), ints(len / 2, len)).map(t -> s.substring(t.value1(), t.value2()));
+        return weighted(w(60, TEXT), w(40, substring));
+    }
+
+    /** What to search for in {@code s}: an index into it, a code point and a char (from a fixed pool, or 70% of the time taken from s), a start and an offset around it. */
+    record Search(int i, int cp, int from, char ch, int off) {}
+
+    static Generator<Search> search(String s) {
+        int len = s.length();
+        Generator<Integer> fromText = ints(0, Math.max(0, len - 1));
+        Generator<Integer> cp = len == 0 ? CODE_POINT : weighted(w(30, CODE_POINT), w(70, fromText.map(s::codePointAt)));
+        Generator<Character> ch = len == 0 ? CHAR : weighted(w(30, CHAR), w(70, fromText.map(s::charAt)));
+        return tuples(fromText, cp, ints(-1, len + 1), ch, ints(-1, len + 1)).map(t -> new Search(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+    }
+
+    /** Substring bounds and a take/drop count around {@code s}, and a repeat count. */
+    record Cut(int b, int e, int k, int rep) {}
+
+    static Generator<Cut> cut(String s) {
+        Generator<Integer> around = ints(-1, s.length() + 1);
+        return tuples(around, around, around, ints(0, 3)).map(t -> new Cut(t.value1(), t.value2(), t.value3(), t.value4()));
+    }
+
+    record Re(String regex, int limit) {}
+
+    /** A string, a second one, whether the CharSeq is built from the list of its chars (else from the string), and the probes. */
+    record CharCase(String s, String t, boolean ofAll, Search search, Cut cut, Re re) {}
+
+    static final Generator<CharCase> CHAR_CASE = TEXT.flatMap(s -> tuples(other(s), chance(50), search(s), cut(s), tuples(REGEX, LIMIT).map(t -> new Re(t.value1(), t.value2())))
+            .map(t -> new CharCase(s, t.value1(), t.value2(), t.value3(), t.value4(), t.value5())));
+
+    static java.util.List<String> strs(Iterable<CharSeq> cs) {
+        java.util.List<String> out = new ArrayList<>();
+        for (CharSeq c : cs) {
+            out.add(c.toString());
+        }
+        return out;
+    }
