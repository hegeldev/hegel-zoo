+    /** The arithmetic sequence from `from` towards `to` by `step`, exclusive or inclusive, at most `cap` elements. */
+    static java.util.List<BigInteger> arith(BigInteger from, BigInteger to, BigInteger step, boolean inclusive, int cap) {
+        java.util.List<BigInteger> out = new ArrayList<>();
+        if (step.signum() == 0) {
+            return out;
+        }
+        int dir = to.compareTo(from);
+        if (inclusive && dir == 0) {
+            out.add(from);
+            return out;
+        }
+        if (dir == 0 || (dir > 0) != (step.signum() > 0)) {
+            return out;
+        }
+        BigInteger x = from;
+        while (out.size() < cap) {
+            int c = x.compareTo(to);
+            if (step.signum() > 0 ? (inclusive ? c > 0 : c >= 0) : (inclusive ? c < 0 : c <= 0)) {
+                break;
+            }
+            out.add(x);
+            x = x.add(step);
+        }
+        return out;
+    }
+
+    static java.util.List<BigInteger> big(Iterable<? extends Number> it) {
+        java.util.List<BigInteger> out = new ArrayList<>();
+        for (Number x : it) {
+            out.add(BigInteger.valueOf(x.longValue()));
+        }
+        return out;
+    }
+
+    static java.util.List<BigInteger> bigChars(Iterable<Character> it) {
+        java.util.List<BigInteger> out = new ArrayList<>();
+        for (Character c : it) {
+            out.add(BigInteger.valueOf(c));
+        }
+        return out;
+    }
