+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Random regular expressions in the syntax that RE2/J and java.util.regex share, as a small AST
+ * rendered separately for each engine (they differ only in the named-group syntax and in how the
+ * Unicode-aware case-insensitive flag is spelled), plus inputs drawn from the same alphabet.
+ */
+final class Rx {
+    private Rx() {}
+
+    // ---- generator helpers -------------------------------------------------------------------------
+
+    /** A weighted alternative for {@link #weighted}. */
+    record Choice<T>(int weight, Generator<T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        int total = 0;
+        for (Choice<T> c : choices) {
+            total += c.weight();
+        }
+        return integers().min(0).max(total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : choices) {
+                acc += c.weight();
+                if (i < acc) {
+                    return c.gen();
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return integers().min(0).max(99).map(x -> x >= 100 - pct);
+    }
+
+    // ---- the alphabet ------------------------------------------------------------------------------
+
+    /** Characters the patterns and inputs are built from: ASCII letters/digits/space, a few
+     *  metacharacters (always escaped in patterns), an accented letter, a Kelvin/long-s pair for
+     *  case folding, and a supplementary character (two UTF-16 units). */
+    static final String[] ATOMS = {"a", "b", "c", "x", "1", "2", " ", "\n", "-", ".", "+", "_", "é", "K", "k", "s", "ſ", "𝒳", "Z"};
+    static final String META = "\\.[]{}()*+-?^$|";
+
+    /** An input over the alphabet: up to 6 atoms, one time in five up to 12. */
+    static final Generator<String> INPUT = weighted(w(4, atoms(6)), w(1, atoms(12)));
+
+    static Generator<String> atoms(int max) {
+        return lists(sampledFrom(ATOMS)).maxSize(max).map(l -> String.join("", l));
+    }
+
+    // ---- the AST -----------------------------------------------------------------------------------
+
+    /** A node of the pattern AST. */
+    abstract static class Node {
+        abstract String render(boolean re2);
+        /** Number of capturing groups inside (in order of the opening parenthesis). */
+        int groups() { return 0; }
+        /** Appends the capturing and named groups inside, in order of the opening parenthesis. */
+        void captures(List<Group> out) {}
+        /** Can this node match the empty string? (anchors count as empty) */
+        abstract boolean nullable();
+        /** Does the shape contain a repetition of a nullable body with a capturing group inside,
+         *  where RE2 (no empty final iteration) and Perl/Java (one) record different captures? */
+        boolean emptyIterationCapture() { return false; }
+        /** Can this node match a non-empty string? */
+        boolean canBeNonEmpty() { return false; }
+        /** Does the shape contain an unbounded repetition (*, + or {n,}) of a body that can match
+         *  both empty and non-empty text, where Java ends the loop at an empty iteration and RE2
+         *  lets a later alternative go on, so the match's extent differs: `(?:\B|a)*` on "aa" is
+         *  "a" in Java and "aa" in RE2 (Go's regexp agrees with RE2/J)? */
+        boolean emptyIterationExtent() { return false; }
+        /** Does the shape contain a {0} or {0,0} repetition with a capturing group inside? */
+        boolean zeroRepetitionCapture() { return false; }
+        boolean containsAnchor() { return false; }
+        boolean containsDollar() { return false; }
+    }
+
+    static final class Lit extends Node {
+        final String s;
+        Lit(String s) { this.s = s; }
+        @Override boolean nullable() { return s.isEmpty(); }
+        @Override boolean canBeNonEmpty() { return !s.isEmpty(); }
+        @Override String render(boolean re2) {
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (META.indexOf(c) >= 0) {
+                    sb.append('\\');
+                }
+                sb.append(c);
+            }
+            return sb.toString();
+        }
+    }
+
+    /** Anything rendered identically for both engines: ., classes, anchors, escapes. */
+    static final class Raw extends Node {
+        final String s;
+        Raw(String s) { this.s = s; }
+        @Override String render(boolean re2) { return s; }
+        @Override boolean nullable() { return containsAnchor(); }
+        @Override boolean canBeNonEmpty() { return !containsAnchor(); }
+        @Override boolean containsAnchor() { return s.equals("^") || s.equals("$") || s.equals("\\b") || s.equals("\\B") || s.equals("\\A") || s.equals("\\z"); }
+        @Override boolean containsDollar() { return s.equals("$"); }
+    }
+
+    static final class Seq extends Node {
+        final List<Node> items;
+        Seq(List<Node> items) { this.items = items; }
+        @Override boolean nullable() { for (Node n : items) if (!n.nullable()) return false; return true; }
+        @Override boolean canBeNonEmpty() { for (Node n : items) if (n.canBeNonEmpty()) return true; return false; }
+        @Override boolean emptyIterationExtent() { for (Node n : items) if (n.emptyIterationExtent()) return true; return false; }
+        @Override boolean emptyIterationCapture() { for (Node n : items) if (n.emptyIterationCapture()) return true; return false; }
+        @Override boolean zeroRepetitionCapture() { for (Node n : items) if (n.zeroRepetitionCapture()) return true; return false; }
+        @Override boolean containsAnchor() { for (Node n : items) if (n.containsAnchor()) return true; return false; }
+        @Override boolean containsDollar() { for (Node n : items) if (n.containsDollar()) return true; return false; }
+        @Override String render(boolean re2) {
+            StringBuilder sb = new StringBuilder();
+            for (Node n : items) {
+                sb.append(n.render(re2));
+            }
+            return sb.toString();
+        }
+        @Override int groups() { int g = 0; for (Node n : items) g += n.groups(); return g; }
+        @Override void captures(List<Group> out) { for (Node n : items) n.captures(out); }
+    }
+
+    static final class Alt extends Node {
+        final List<Node> items;
+        Alt(List<Node> items) { this.items = items; }
+        @Override boolean nullable() { for (Node n : items) if (n.nullable()) return true; return false; }
+        @Override boolean canBeNonEmpty() { for (Node n : items) if (n.canBeNonEmpty()) return true; return false; }
+        @Override boolean emptyIterationExtent() { for (Node n : items) if (n.emptyIterationExtent()) return true; return false; }
+        @Override boolean emptyIterationCapture() { for (Node n : items) if (n.emptyIterationCapture()) return true; return false; }
+        @Override boolean zeroRepetitionCapture() { for (Node n : items) if (n.zeroRepetitionCapture()) return true; return false; }
+        @Override boolean containsAnchor() { for (Node n : items) if (n.containsAnchor()) return true; return false; }
+        @Override boolean containsDollar() { for (Node n : items) if (n.containsDollar()) return true; return false; }
+        @Override String render(boolean re2) {
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < items.size(); i++) {
+                if (i > 0) sb.append('|');
+                sb.append(items.get(i).render(re2));
+            }
+            return sb.toString();
+        }
+        @Override int groups() { int g = 0; for (Node n : items) g += n.groups(); return g; }
+        @Override void captures(List<Group> out) { for (Node n : items) n.captures(out); }
+    }
+
+    /** kind: 0 capturing, 1 non-capturing, 2 named, 3 flag group (?flags: ). */
+    static final class Group extends Node {
+        final int kind;
+        /** Set once by {@link #named} from the group's position among the captures. */
+        String name;
+        final String flags;
+        final Node body;
+        Group(int kind, String flags, Node body) { this.kind = kind; this.flags = flags; this.body = body; }
+        @Override String render(boolean re2) {
+            String b = body.render(re2);
+            switch (kind) {
+                case 0: return "(" + b + ")";
+                case 1: return "(?:" + b + ")";
+                case 2: return (re2 ? "(?P<" : "(?<") + name + ">" + b + ")";
+                default: return "(?" + javaFlags(flags, re2) + ":" + b + ")";
+            }
+        }
+        @Override int groups() { return (kind == 0 || kind == 2 ? 1 : 0) + body.groups(); }
+        @Override void captures(List<Group> out) { if (kind == 0 || kind == 2) out.add(this); body.captures(out); }
+        @Override boolean nullable() { return body.nullable(); }
+        @Override boolean canBeNonEmpty() { return body.canBeNonEmpty(); }
+        @Override boolean emptyIterationExtent() { return body.emptyIterationExtent(); }
+        @Override boolean emptyIterationCapture() { return body.emptyIterationCapture(); }
+        @Override boolean zeroRepetitionCapture() { return body.zeroRepetitionCapture(); }
+        @Override boolean containsAnchor() { return body.containsAnchor(); }
+        @Override boolean containsDollar() { return body.containsDollar(); }
+    }
+
+    /** Java's CASE_INSENSITIVE is ASCII-only unless UNICODE_CASE is added; RE2's is Unicode. */
+    static String javaFlags(String flags, boolean re2) {
+        if (re2 || flags.indexOf('i') < 0) {
+            return flags;
+        }
+        // (?i) -> (?iu) for Java; the negated form (?-i) needs -u too
+        StringBuilder sb = new StringBuilder();
+        for (char c : flags.toCharArray()) {
+            sb.append(c);
+            if (c == 'i') sb.append('u');
+        }
+        return sb.toString();
+    }
+
+    static final class Rep extends Node {
+        final Node body;
+        final String op; // *, +, ?, {n}, {n,}, {n,m}
+        final boolean lazy;
+        Rep(Node body, String op, boolean lazy) { this.body = body; this.op = op; this.lazy = lazy; }
+        @Override String render(boolean re2) {
+            String b = body.render(re2);
+            boolean atom = body instanceof Group || (body instanceof Raw && ((Raw) body).s.length() == 1)
+                    || (body instanceof Raw && ((Raw) body).s.startsWith("[") || body instanceof Raw && ((Raw) body).s.startsWith("\\"))
+                    || (body instanceof Lit && ((Lit) body).s.length() == 1);
+            if (!atom) {
+                b = "(?:" + b + ")";
+            }
+            return b + op + (lazy ? "?" : "");
+        }
+        @Override int groups() { return body.groups(); }
+        @Override void captures(List<Group> out) { body.captures(out); }
+        boolean minZero() { return op.equals("*") || op.equals("?") || op.startsWith("{0"); }
+        boolean zero() { return op.equals("{0}") || op.equals("{0,0}"); }
+        boolean unbounded() { return op.equals("*") || op.equals("+") || op.endsWith(",}"); }
+        @Override boolean nullable() { return minZero() || body.nullable(); }
+        @Override boolean canBeNonEmpty() { return !zero() && body.canBeNonEmpty(); }
+        @Override boolean emptyIterationExtent() { return (unbounded() && body.nullable() && body.canBeNonEmpty()) || body.emptyIterationExtent(); }
+        @Override boolean emptyIterationCapture() { return (body.groups() > 0 && body.nullable() && !zero()) || body.emptyIterationCapture(); }
+        @Override boolean zeroRepetitionCapture() { return (body.groups() > 0 && zero()) || body.zeroRepetitionCapture(); }
+        @Override boolean containsAnchor() { return body.containsAnchor(); }
+        @Override boolean containsDollar() { return body.containsDollar(); }
+    }
+
+    // ---- pattern generators ------------------------------------------------------------------------
+
+    /** One item of a bracket class: an atom of the alphabet (escaped as needed), a range or an escape. */
+    static final Generator<String> CLASS_ITEM = weighted(
+            w(2, sampledFrom(ATOMS).map(Rx::classAtom)),
+            w(1, just("a-c")),
+            w(1, just("\\d")),
+            w(1, just("\\s")),
+            w(1, just("\\-")));
+
+    static String classAtom(String a) {
+        if (a.equals("\n")) return "\\n";
+        if (META.indexOf(a.charAt(0)) >= 0 || a.equals("^")) return "\\" + a;
+        return a;
+    }
+
+    /** A bracket class over the alphabet, sometimes negated: [abc], [^a-c\d]. */
+    static final Generator<Node> BRACKET = tuples(chance(30), lists(CLASS_ITEM).minSize(1).maxSize(3))
+            .map(t -> new Raw("[" + (t.value1() ? "^" : "") + String.join("", t.value2()) + "]"));
+
+    static final Generator<Node> ESCAPE = sampledFrom("\\d", "\\D", "\\w", "\\W", "\\s", "\\S", "\\p{L}", "\\P{L}", "\\p{Lu}", "\\p{N}", "\\n", "\\t", "\\x41", "\\x{e9}", "\\Qa.b\\E").map(Raw::new);
+    static final Generator<Node> ANCHOR = sampledFrom("^", "$", "\\b", "\\B", "\\A", "\\z").map(Raw::new);
+
+    /** A leaf: a literal, ., a bracket class, a class escape, or an anchor. */
+    static final Generator<Node> ATOM = weighted(
+            w(40, sampledFrom(ATOMS).map(Lit::new)),
+            w(8, just(new Raw("."))),
+            w(14, BRACKET),
+            w(16, ESCAPE),
+            w(22, ANCHOR));
+
+    static final Generator<String> REP_OP = sampledFrom("*", "+", "?", "{2}", "{1,}", "{0,2}", "{1,3}", "{0}", "{0,0}", "{2,2}");
+    static final Generator<String> GROUP_FLAGS = sampledFrom("i", "s", "m", "-i", "is", "i-s");
+    static final Generator<Node> EMPTY = just(new Seq(List.of()));
+
+    /** A pattern of at most `depth` nested operators: an atom, or a sequence, alternation, repetition
+     *  or group of smaller patterns. Groups get their names afterwards, see {@link #named}. */
+    static Generator<Node> node(int depth) {
+        if (depth <= 0) {
+            return ATOM;
+        }
+        Generator<Node> sub = node(depth - 1);
+        Generator<Node> branch = weighted(w(9, sub), w(1, EMPTY));
+        return weighted(
+                w(35, ATOM),
+                w(20, lists(sub).minSize(2).maxSize(3).map(Seq::new)),
+                w(15, lists(branch).minSize(2).maxSize(3).map(Alt::new)),
+                w(15, tuples(sub, REP_OP, chance(30)).map(t -> new Rep(t.value1(), t.value2(), t.value3()))),
+                w(15, tuples(sampledFrom(0, 0, 0, 1, 2, 3), GROUP_FLAGS, sub).map(t -> new Group(t.value1(), t.value2(), t.value3()))));
+    }
+
+    /** A random pattern, its named groups called g0, g1, ... by position among the captures. */
+    static final Generator<Node> PATTERN = node(3).map(Rx::named);
+
+    /** Names the named groups of a freshly built tree; {@link #names} lists the result. */
+    static Node named(Node root) {
+        int i = 0;
+        for (Group g : captures(root)) {
+            if (g.kind == 2) {
+                g.name = "g" + i;
+            }
+            i++;
+        }
+        return root;
+    }
+
+    static List<Group> captures(Node root) {
+        List<Group> out = new ArrayList<>();
+        root.captures(out);
+        return out;
+    }
+
+    /** The group names in order of the opening parenthesis, null for an unnamed capturing group. */
+    static List<String> names(Node root) {
+        List<String> out = new ArrayList<>();
+        for (Group g : captures(root)) {
+            out.add(g.name);
+        }
+        return out;
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..6be6010
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,88 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == ' ' || c == ' ') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
