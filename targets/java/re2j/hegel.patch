diff --git a/hegel/pom.xml b/hegel/pom.xml
new file mode 100644
index 0000000..fc668e0
--- /dev/null
+++ b/hegel/pom.xml
@@ -0,0 +1,76 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel zoo: property-based tests for RE2/J. Upstream builds with Gradle, so this module
+     compiles the library's own sources (../java, minus the GWT super-source) as
+     its main sources and needs no installed artifact; see targets/java/re2j in the zoo. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>re2j-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <sourceDirectory>${project.basedir}/../java</sourceDirectory>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+        <configuration>
+          <excludes>
+            <exclude>module-info.java</exclude>
+            <exclude>com/google/re2j/super/**</exclude>
+          </excludes>
+          <showWarnings>false</showWarnings>
+          <compilerArgs>
+            <arg>-Xlint:none</arg>
+          </compilerArgs>
+        </configuration>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -Xmx1g</argLine>
+          <!-- the library ships a module-info.java; run the tests on the class path so the
+               ZooListener registered in META-INF/services is picked up -->
+          <useModulePath>false</useModulePath>
+          <trimStackTrace>false</trimStackTrace>
+          <!-- every test's `ZOO …` line is what the zoo judges; Maven's exit code is not -->
+          <testFailureIgnore>true</testFailureIgnore>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Re2jPinsTest.java b/hegel/src/test/java/zoo/Re2jPinsTest.java
new file mode 100644
index 0000000..05a19d2
--- /dev/null
+++ b/hegel/src/test/java/zoo/Re2jPinsTest.java
@@ -0,0 +1,204 @@
+package zoo;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.google.re2j.Matcher;
+import com.google.re2j.Pattern;
+import com.google.re2j.PatternSyntaxException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+/** One plain JUnit test per bug recorded in bugs.toml; each fails while the bug exists. */
+class Re2jPinsTest {
+
+    static List<Integer> starts(Matcher m) {
+        List<Integer> out = new ArrayList<>();
+        while (m.find()) {
+            out.add(m.start());
+            if (out.size() > 50) break;
+        }
+        return out;
+    }
+
+    // re2j/1: split of an input made only of delimiters
+    @Test
+    void pinSplitOfOnlyDelimitersIsEmpty() {
+        assertArrayEquals(new String[0], Pattern.compile("\\w").split("abc"), "split(\"abc\") by \\w: trailing empty strings are documented as omitted");
+        assertArrayEquals(new String[0], Pattern.compile(",").split(",,,"), "split(\",,,\") by ,");
+        assertArrayEquals(new String[0], Pattern.compile(",").split(",,,", 0));
+    }
+
+    // re2j/2: UTF-8 input, empty-width assertions after a non-ASCII character
+    @Test
+    void pinByteInputAssertionsSeeThePreviousCharacter() {
+        byte[] ex = "\u00e9x".getBytes(StandardCharsets.UTF_8);
+        assertFalse(Pattern.compile("^x", Pattern.MULTILINE).matcher(ex).find(), "(?m)^x matches inside the byte form of \"éx\"");
+        assertEquals(List.of(0), starts(Pattern.compile("\\A").matcher("a\u00e9b".getBytes(StandardCharsets.UTF_8))), "\\A on the bytes of \"aéb\"");
+        // é is not a word character for \b (ASCII), so no boundary between é and x either way; but
+        // between two word characters after a non-ASCII one there must be none
+        assertEquals(List.of(4, 5), starts(Pattern.compile("\\b").matcher("\u00e9\u00e9x".getBytes(StandardCharsets.UTF_8))), "\\b positions on the bytes of \"ééx\" (want 4 and 5 only)");
+    }
+
+    // re2j/3: UTF-8 input, find() after an empty match steps one byte, not one character
+    @Test
+    void pinByteInputEmptyMatchesFallOnCharacterBoundaries() {
+        byte[] s = "\u017f".getBytes(StandardCharsets.UTF_8); // two bytes
+        assertEquals(List.of(0, 2), starts(Pattern.compile("x{0}").matcher(s)), "empty matches on the bytes of a two-byte character");
+        Matcher m = Pattern.compile("").matcher("\u00e9".getBytes(StandardCharsets.UTF_8));
+        assertTrue(m.find() && m.find());
+        assertEquals(2, m.start(), "the second empty match on the bytes of \"é\" is inside the character");
+    }
+
+    // re2j/4: a {0} repetition with a capturing group inside
+    @Test
+    void pinZeroRepetitionLeavesTheGroupUnset() {
+        Matcher m = Pattern.compile("(?:b(c)){0}").matcher("xb");
+        assertTrue(m.find());
+        assertEquals(-1, m.start(1), "group 1 of (?:b(c)){0} cannot participate");
+        assertEquals(null, m.group(1));
+        Pattern p = Pattern.compile("(?P<name>c){0}x");
+        assertEquals(1, p.groupCount());
+        assertEquals(java.util.Map.of("name", 1), p.namedGroups(), "the named group is still a group of the pattern");
+        assertEquals("-x", p.matcher("x").replaceAll("-${name}$0"));
+    }
+
+    // re2j/5: ${name} of a group that did not participate
+    @Test
+    void pinUnmatchedNamedGroupReplacesWithNothing() {
+        Pattern p = Pattern.compile("(?P<g>x)|y");
+        assertEquals("[]", p.matcher("y").replaceAll("[$1]"));
+        assertEquals("[]", p.matcher("y").replaceAll("[${g}]"), "${g} of a non-participating group");
+    }
+
+    // re2j/6: a repetition at the root of the pattern that simplification rewrites loses the named groups
+    @Test
+    void pinNamedGroupsSurviveACountedRepetition() {
+        for (String re : new String[] {"(?P<x>a){1}", "(?P<x>a){2}", "(?P<x>a){1,2}", "(?P<x>a){0,2}", "(?P<x>a{2})+", "(?:(?P<x>a)*)*"}) {
+            Pattern p = Pattern.compile(re);
+            assertEquals(1, p.groupCount(), re);
+            assertEquals(java.util.Map.of("x", 1), p.namedGroups(), "namedGroups() of " + re);
+            Matcher m = p.matcher("aa");
+            assertTrue(m.find(), re);
+            assertEquals(m.group(1), m.group("x"), "group(\"x\") of " + re);
+        }
+    }
+
+    // re2j/7: reading a group re-runs the match over a truncated window for byte input
+    @Test
+    void pinReadingAGroupKeepsTheMatchOnByteInput() {
+        Matcher m = Pattern.compile("(ab$)|a").matcher("abc".getBytes(StandardCharsets.UTF_8));
+        assertTrue(m.find());
+        assertEquals("a", m.group());
+        assertEquals(null, m.group(1), "group 1 (ab$) cannot match in \"abc\"");
+        assertEquals("a", m.group(), "group() changed after reading group(1)");
+        assertEquals(1, m.end());
+    }
+
+    // re2j/17: group() throws after a byte-input match that only a phantom text start allowed
+    @Test
+    void pinReadingAGroupAfterAPhantomTextStartDoesNotThrow() {
+        Matcher m = Pattern.compile("(^).a").matcher("\u00e9ba".getBytes(StandardCharsets.UTF_8));
+        // find() matching at all is re2j/2 (the String API and Go find nothing); once found, the
+        // groups must be readable
+        if (m.find()) {
+            assertEquals("ba", m.group());
+            assertDoesNotThrow(() -> m.group(1), "group(1) after a successful find()");
+        }
+    }
+
+    // re2j/8: a failed find() leaves the previous match readable
+    @Test
+    void pinFailedFindClearsTheMatch() {
+        Matcher m = Pattern.compile("a").matcher("ab");
+        assertTrue(m.find());
+        assertFalse(m.find());
+        assertThrows(IllegalStateException.class, m::group, "group() after a failed find()");
+        assertThrows(IllegalStateException.class, m::start);
+        Matcher m2 = Pattern.compile("a").matcher("ab");
+        assertTrue(m2.find());
+        assertFalse(m2.find());
+        assertThrows(IllegalStateException.class, () -> m2.appendReplacement(new StringBuilder(), "X"), "appendReplacement after a failed find()");
+    }
+
+    // re2j/9: malformed replacement strings are accepted silently
+    @Test
+    void pinMalformedReplacementsAreRejected() {
+        for (String rep : new String[] {"$", "a\\", "$x"}) {
+            assertThrows(IllegalArgumentException.class, () -> Pattern.compile("a").matcher("bab").replaceAll(rep), "replaceAll(" + Zoo.show(rep) + ")");
+        }
+    }
+
+    // re2j/10: invalid UTF-8 bytes swallow the following byte or end the input
+    @Test
+    void pinInvalidUtf8BytesDecodeAsReplacementCharacters() {
+        assertEquals(List.of(0, 1), starts(Pattern.compile(".").matcher(new byte[] {(byte) 0xC3, 'a'})), ". over {C3, 'a'}: the truncated lead byte must not swallow the 'a'");
+        assertEquals(List.of(1), starts(Pattern.compile("a").matcher(new byte[] {(byte) 0xFF, 'a'})).subList(0, 1));
+        assertEquals(List.of(1), starts(Pattern.compile("\\w").matcher(new byte[] {(byte) 0x80, 'a'})), "\\w over {80, 'a'}");
+        assertEquals(List.of(0, 1), starts(Pattern.compile(".").matcher(new byte[] {'a', (byte) 0xC3})), ". over {'a', C3}");
+    }
+
+    // re2j/11: matching recurses through the epsilon closure and overflows the stack
+    @Test
+    void pinMatchingNeverOverflowsTheStack() {
+        Pattern p = Pattern.compile("(?:(?:a?){1000}){10}");
+        try {
+            assertTrue(p.matcher("aaa").matches());
+        } catch (StackOverflowError e) {
+            throw new AssertionError("matches() threw StackOverflowError for a 10 000-instruction program", e);
+        }
+    }
+
+    // re2j/12: nested counted repetitions have no overall limit
+    @Test
+    void pinNestedRepeatCountsAreBounded() {
+        assertThrows(PatternSyntaxException.class, () -> Pattern.compile("(a{2}){1000}"), "(a{2}){1000} repeats 2000 times; RE2 rejects a nested product above 1000");
+        assertThrows(PatternSyntaxException.class, () -> Pattern.compile("(?:(?:a{100}){100}){100}"));
+    }
+
+    // re2j/13: deeply nested parentheses overflow the stack in compile
+    @Test
+    void pinDeepNestingIsASyntaxErrorNotAnError() {
+        String deep = "(".repeat(20000) + "a" + ")".repeat(20000);
+        try {
+            Pattern.compile(deep);
+        } catch (PatternSyntaxException e) {
+            return; // RE2 says "expression nests too deeply"
+        } catch (StackOverflowError e) {
+            throw new AssertionError("compile of 20000 nested groups threw StackOverflowError", e);
+        }
+    }
+
+    // re2j/14: [[:] is rejected as an invalid POSIX class
+    @Test
+    void pinBracketColonIsAnOrdinaryClass() {
+        assertTrue(Pattern.compile("[[:]]").matcher(":]").matches(), "[[:]] is the class {[, :} followed by a literal ]");
+        assertTrue(Pattern.compile("[[:]]").matcher("[]").matches());
+        assertTrue(Pattern.compile("[[:]").matcher("[").matches());
+        assertFalse(Pattern.compile("[[:]").matcher("a").matches());
+    }
+
+    // re2j/15: (?i)[X] does not fold code points above U+1044F, (?i)X does
+    @Test
+    void pinCaseInsensitiveClassFoldsAllOfUnicode() {
+        String upper = new String(Character.toChars(0x10C80)), lower = new String(Character.toChars(0x10CC0)); // Old Hungarian
+        assertTrue(Pattern.compile("(?i)\\x{10C80}").matcher(lower).matches());
+        assertTrue(Pattern.compile("(?i)[\\x{10C80}]").matcher(lower).matches(), "(?i)[U+10C80] against U+10CC0");
+        assertTrue(Pattern.compile("(?i)[\\x{1E900}]").matcher(new String(Character.toChars(0x1E922))).matches(), "(?i)[U+1E900] against U+1E922 (Adlam)");
+    }
+
+    // re2j/16: an unbalanced ) is reported as an internal error
+    @Test
+    void pinUnexpectedParenIsNotAnInternalError() {
+        for (String re : new String[] {"a)", ")"}) {
+            PatternSyntaxException e = assertThrows(PatternSyntaxException.class, () -> Pattern.compile(re));
+            assertFalse(e.getDescription().contains("internal error"), re + " -> " + e.getDescription());
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/Re2jTest.java b/hegel/src/test/java/zoo/Re2jTest.java
new file mode 100644
index 0000000..bc839ca
--- /dev/null
+++ b/hegel/src/test/java/zoo/Re2jTest.java
@@ -0,0 +1,583 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.oneOf;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static zoo.Rx.chance;
+import static zoo.Rx.w;
+import static zoo.Rx.weighted;
+import static zoo.Zoo.check;
+import static zoo.Zoo.show;
+
+import com.google.re2j.Matcher;
+import com.google.re2j.Pattern;
+import com.google.re2j.PatternSyntaxException;
+import dev.hegel.Generator;
+import dev.hegel.Hegel;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Objects;
+import java.util.TreeMap;
+import org.junit.jupiter.api.Test;
+
+/**
+ * RE2/J against java.util.regex on the syntax the two share. RE2/J documents its Pattern and
+ * Matcher as the java.util.regex API; where the two engines' semantics differ by design (RE2 is
+ * Go's regexp: no empty final iteration of a repeated group, Unicode case folding of every class,
+ * `$` only at the very end of the text, `(?m)^` also at the end of the text, ASCII-only `\b`) the
+ * property lets the disagreement pass instead of failing, and the
+ * same goes for the recorded bugs (`re2j/N`). Every gate applies only when the results differ.
+ */
+class Re2jTest {
+
+    /** A generated case: the AST rendered for each engine, its flags and group names. */
+    static final class Case {
+        final Rx.Node node;
+        final String re2;
+        final String jre;
+        final int flags; // RE2/J flags
+        final List<String> names;
+        final int groups;
+        Case(Rx.Node node, int flags) {
+            this.node = node;
+            re2 = node.render(true);
+            jre = node.render(false);
+            names = Rx.names(node);
+            groups = node.groups();
+            this.flags = flags;
+        }
+        int javaFlags() {
+            int f = 0;
+            if ((flags & Pattern.CASE_INSENSITIVE) != 0) f |= java.util.regex.Pattern.CASE_INSENSITIVE | java.util.regex.Pattern.UNICODE_CASE;
+            if ((flags & Pattern.DOTALL) != 0) f |= java.util.regex.Pattern.DOTALL;
+            if ((flags & Pattern.MULTILINE) != 0) f |= java.util.regex.Pattern.MULTILINE;
+            return f;
+        }
+        boolean caseInsensitive() {
+            return (flags & Pattern.CASE_INSENSITIVE) != 0 || re2.contains("(?i") || re2.contains("(?-i");
+        }
+        @Override public String toString() {
+            return "/" + re2 + "/" + (flags == 0 ? "" : " flags " + flags) + (jre.equals(re2) ? "" : " (java: /" + jre + "/)");
+        }
+    }
+
+    /** The compile flags: each of CASE_INSENSITIVE, DOTALL and MULTILINE on its own coin. */
+    static final Generator<Integer> FLAGS = tuples(chance(20), chance(15), chance(15))
+            .map(t -> (t.value1() ? Pattern.CASE_INSENSITIVE : 0) | (t.value2() ? Pattern.DOTALL : 0) | (t.value3() ? Pattern.MULTILINE : 0));
+
+    static final Generator<Case> CASE = tuples(Rx.PATTERN, FLAGS).map(t -> new Case(t.value1(), t.value2()));
+
+    /** A replacement string: literal text, $n and ${name} references, escaped $ and \. */
+    static Generator<String> replacement(Case c) {
+        List<String> named = c.names.stream().filter(Objects::nonNull).toList();
+        Generator<String> piece = weighted(
+                w(2, sampledFrom("x", "-", "é", "𝒳", "\\n", "\\-")),
+                w(1, just("$0")),
+                w(1, integers().min(1).max(Math.max(1, c.groups)).map(g -> "$" + g)),
+                w(1, named.isEmpty() ? just("[]") : sampledFrom(named).map(n -> "${" + n + "}")),
+                w(1, just("\\$")),
+                w(1, just("\\\\")));
+        return lists(piece).maxSize(4).map(l -> String.join("", l));
+    }
+
+    /** Text for quoteReplacement: every character it must make literal. */
+    static final Generator<String> LITERAL = sampledFrom("$1", "\\", "$", "a\\$b", "${g0}", "$$", "\\\\");
+
+    /** A code point of the four ranges the case-folding tables treat differently, never a lone surrogate. */
+    static final Generator<Integer> CODE_POINT = oneOf(
+            integers().min(0x20).max(0x7e),
+            integers().min(0x80).max(0x24f),
+            integers().min(0x250).max(0xffff).filter(cp -> !Character.isSurrogate((char) (int) cp)),
+            integers().min(0x10000).max(0x1ffff));
+
+    enum EditOp { DELETE, REPLACE, INSERT }
+
+    /** One edit of a pattern string; `at` is taken modulo the current length when applied. */
+    record Edit(EditOp op, int at, String text) {}
+
+    static final Generator<String> JUNK_CHAR = sampledFrom("(", ")", "[", "]", "{", "}", "*", "\\", "|", "?");
+    static final Generator<String> JUNK_INSERT = sampledFrom("(", ")", "[", "]", "{", "}", "*", "+", "?", "\\", "|", "^", "$", "-", "{2,1}", "{1001}", "(?P<", "(?<", "\\p{", "\\x{", "\\Q", "\\E", "(?", "#");
+    static final Generator<Integer> AT = integers().min(0).max(99);
+    static final Generator<Edit> EDIT = oneOf(
+            AT.map(at -> new Edit(EditOp.DELETE, at, "")),
+            tuples(AT, JUNK_CHAR).map(t -> new Edit(EditOp.REPLACE, t.value1(), t.value2())),
+            tuples(AT, JUNK_INSERT).map(t -> new Edit(EditOp.INSERT, t.value1(), t.value2())));
+    static final Generator<List<Edit>> EDITS = lists(EDIT).minSize(1).maxSize(3);
+
+    static String edit(String re, List<Edit> edits) {
+        StringBuilder sb = new StringBuilder(re);
+        for (Edit e : edits) {
+            if (sb.length() == 0) break;
+            int at = e.at() % sb.length();
+            switch (e.op()) {
+                case DELETE -> sb.deleteCharAt(at);
+                case REPLACE -> sb.setCharAt(at, e.text().charAt(0));
+                case INSERT -> sb.insert(at, e.text());
+            }
+        }
+        return sb.toString();
+    }
+
+    /** Compiles both; null when both engines reject the pattern, a failure when only one does. */
+    static Pattern[] compileBoth(Case c, java.util.regex.Pattern[] javaOut) {
+        Pattern p = null;
+        java.util.regex.Pattern q = null;
+        String re2Err = null, javaErr = null;
+        try {
+            p = Pattern.compile(c.re2, c.flags);
+        } catch (PatternSyntaxException e) {
+            re2Err = e.getDescription();
+        }
+        try {
+            q = java.util.regex.Pattern.compile(c.jre, c.javaFlags());
+        } catch (java.util.regex.PatternSyntaxException e) {
+            javaErr = e.getDescription();
+        }
+        if (p == null || q == null) {
+            final String re2E = re2Err, javaE = javaErr;
+            check(p == null && q == null, () -> "compile " + c + ": RE2/J " + (re2E == null ? "accepts" : "rejects (" + re2E + ")")
+                    + ", java.util.regex " + (javaE == null ? "accepts" : "rejects (" + javaE + ")"));
+            return null;
+        }
+        javaOut[0] = q;
+        return new Pattern[] {p};
+    }
+
+    static boolean nonAscii(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            if (s.charAt(i) >= 0x80) return true;
+        }
+        return false;
+    }
+
+    /**
+     * The RE2-vs-Perl design differences a disagreement on this case may come from, or null. Used
+     * only when the engines disagree: RE2 (Go's regexp) does not run an extra empty iteration of a
+     * repeated group, so the captures of `(a*)+` on "aa" or `(^){0,2}` differ from Java's; RE2
+     * applies Unicode simple case folding to every class under (?i), so `(?i)\w` matches the long s
+     * (U+017F) and Java's ASCII \w does not; RE2's `$` without (?m) matches only at the very end of
+     * the text while Java's also matches before a final line terminator; Java ends an unbounded
+     * loop at an empty iteration while RE2 lets a later, non-empty alternative of the body go on,
+     * so `(?:\B|a)*` matches "a" of "aa" in Java and all of it in RE2 (and in Go's regexp).
+     */
+    static String designDifference(Case c, String input) {
+        if (c.node.emptyIterationCapture()) return "empty-iteration-capture";
+        if (c.node.emptyIterationExtent()) return "empty-iteration-extent";
+        if (c.caseInsensitive() && (input.indexOf('ſ') >= 0 || c.re2.indexOf('ſ') >= 0)) return "unicode-case-folding";
+        if (c.node.containsDollar() && input.endsWith("\n")) return "dollar-before-final-newline";
+        // java.util.regex's \b is Unicode-aware (Character.isLetterOrDigit: é and ſ are word
+        // characters, and it reports a \B between the two surrogates of a supplementary character)
+        // while its \w and RE2's \b, \w are ASCII
+        if ((c.re2.contains("\\b") || c.re2.contains("\\B")) && nonAscii(input)) return "java-unicode-word-boundary";
+        // under (?m) RE2's ^ matches at the start of the text and after every "\n", including at
+        // the end of the text; java.util.regex's never matches at the end of the input
+        boolean multiline = (c.flags & Pattern.MULTILINE) != 0 || c.re2.contains("(?m");
+        if (multiline && c.re2.replace("[^", "").replace("\\^", "").contains("^") && (input.isEmpty() || input.endsWith("\n"))) return "multiline-caret-at-end-of-text";
+        return null;
+    }
