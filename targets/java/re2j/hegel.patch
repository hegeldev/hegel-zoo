+    /**
+     * Is the pattern, outside non-capturing and flag groups, one repetition that simplification
+     * rewrites into a new node: a counted repetition {n}, {n,}, {n,m}, or a *, + or ? whose body is
+     * itself rewritten (contains a counted repetition, or is directly another repetition)?
+     */
+    static boolean rootCountedRepetition(Rx.Node n) {
+        n = unwrap(n);
+        if (!(n instanceof Rx.Rep)) return false;
+        Rx.Rep r = (Rx.Rep) n;
+        return r.op.startsWith("{") || r.body.render(true).contains("{") || unwrap(r.body) instanceof Rx.Rep;
+    }
+
+    static Rx.Node unwrap(Rx.Node n) {
+        while (n instanceof Rx.Group && ((Rx.Group) n).kind != 0 && ((Rx.Group) n).kind != 2) {
+            n = ((Rx.Group) n).body;
+        }
+        return n;
+    }
