+    @Test
+    void findAndGroupsAgreeWithJavaUtilRegex() {
+        Hegel.test(tc -> {
+            Case c = tc.draw(CASE, "case");
+            java.util.regex.Pattern[] jq = new java.util.regex.Pattern[1];
+            Pattern[] pp = compileBoth(c, jq);
+            tc.assume(pp != null);
+            Pattern p = pp[0];
+            java.util.regex.Pattern q = jq[0];
+            check(p.groupCount() == q.matcher("").groupCount() && p.groupCount() == c.groups,
+                    () -> "groupCount of " + c + " = " + p.groupCount() + ", java " + q.matcher("").groupCount() + ", generated " + c.groups);
+            TreeMap<String, Integer> re2Names = new TreeMap<>(p.namedGroups());
+            TreeMap<String, Integer> javaNames = new TreeMap<>(q.namedGroups());
+            if (!re2Names.equals(javaNames)) {
+                // known re2j/6: a repetition at the root that simplification rewrites loses the names
+                if (!rootCountedRepetition(c.node)) {
+                    Zoo.fail("namedGroups of " + c + " = " + re2Names + ", java " + javaNames);
+                }
+            }
+            check(p.pattern().equals(c.re2) && p.toString().equals(c.re2) && p.flags() == c.flags, () -> "pattern()/toString()/flags() of " + c + " do not echo the input");
+            String input = tc.draw(Rx.INPUT, "input");
+            String design = designDifference(c, input);
+            String zeroRep = c.node.zeroRepetitionCapture() ? "re2j/4" : null;
+            Matcher m = p.matcher(input);
+            java.util.regex.Matcher jm = q.matcher(input);
+            String got = findAll(m);
+            String want = findAll(jm);
+            if (!got.equals(want)) {
+                if (design == null && zeroRep == null) {
+                    Zoo.fail("find loop of " + c + " on " + show(input) + ": RE2/J " + got + ", java " + want);
+                }
+                return;
+            }
+            // group strings and named groups of the first match
+            m.reset();
+            jm.reset();
+            if (jm.find() && m.find()) {
+                for (int g = 0; g <= p.groupCount(); g++) {
+                    String a = m.group(g), b = jm.group(g);
+                    int gg = g;
+                    check(a == null ? b == null : a.equals(b), () -> "group(" + gg + ") of " + c + " on " + show(input) + ": RE2/J " + show(a) + ", java " + show(b));
+                }
+                for (String name : c.names) {
+                    if (name != null && re2Names.equals(javaNames)) {
+                        String a = m.group(name), b = jm.group(name);
+                        check(a == null ? b == null : a.equals(b), () -> "group(" + name + ") of " + c + " on " + show(input) + ": RE2/J " + show(a) + ", java " + show(b));
+                        check(m.start(name) == jm.start(name) && m.end(name) == jm.end(name), () -> "start/end(" + name + ") of " + c + " on " + show(input) + " differ from java");
+                    }
+                }
+            }
+            // matches, lookingAt and find(int) from every position: the find loop agreed, but a
+            // search that starts elsewhere can still run into a design difference
+            boolean re2Matches = p.matcher(input).matches(), javaMatches = q.matcher(input).matches();
+            if (re2Matches != javaMatches && design == null) {
+                Zoo.fail("matches() of " + c + " on " + show(input) + ": RE2/J " + re2Matches + ", java " + javaMatches);
+            }
+            check(p.matches(input) == re2Matches, () -> "Pattern.matches disagrees with Matcher.matches for " + c + " on " + show(input));
+            boolean re2Looking = p.matcher(input).lookingAt(), javaLooking = q.matcher(input).lookingAt();
+            if (re2Looking != javaLooking && design == null) {
+                Zoo.fail("lookingAt() of " + c + " on " + show(input) + ": RE2/J " + re2Looking + ", java " + javaLooking);
+            }
+            for (int from = 0; from <= input.length(); from++) {
+                Matcher m2 = p.matcher(input);
+                java.util.regex.Matcher jm2 = q.matcher(input);
+                boolean a = m2.find(from), b = jm2.find(from);
+                if (a != b || (a && (m2.start() != jm2.start() || m2.end() != jm2.end()))) {
+                    if (design == null) {
+                        Zoo.fail("find(" + from + ") of " + c + " on " + show(input) + ": RE2/J " + (a ? m2.start() + "-" + m2.end() : "none") + ", java " + (b ? jm2.start() + "-" + jm2.end() : "none"));
+                    }
+                    break;
