+    /** The whole find() loop as one string: for every match "start-end" and each group's span. */
+    static String findAll(Matcher m) {
+        StringBuilder sb = new StringBuilder();
+        int guard = 0;
+        while (m.find()) {
+            if (sb.length() > 0) sb.append(' ');
+            sb.append(m.start()).append('-').append(m.end());
+            for (int g = 1; g <= m.groupCount(); g++) {
+                sb.append(",g").append(g).append('=').append(m.start(g)).append('-').append(m.end(g));
+            }
+            if (++guard > 200) {
+                sb.append(" ...");
+                break;
+            }
+        }
+        return sb.toString();
+    }
+
+    static String findAll(java.util.regex.Matcher m) {
+        StringBuilder sb = new StringBuilder();
+        int guard = 0;
+        while (m.find()) {
+            if (sb.length() > 0) sb.append(' ');
+            sb.append(m.start()).append('-').append(m.end());
+            for (int g = 1; g <= m.groupCount(); g++) {
+                sb.append(",g").append(g).append('=').append(m.start(g)).append('-').append(m.end(g));
+            }
+            if (++guard > 200) {
+                sb.append(" ...");
+                break;
+            }
+        }
+        return sb.toString();
+    }
