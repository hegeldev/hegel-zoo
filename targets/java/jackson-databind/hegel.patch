+
+    static final List<Class<?>> TIME_TYPES = List.of(Instant.class, LocalDate.class, LocalTime.class, LocalDateTime.class, OffsetDateTime.class,
+            OffsetTime.class, ZonedDateTime.class, Duration.class, Period.class, Year.class, YearMonth.class, MonthDay.class, ZoneId.class,
+            ZoneOffset.class, DayOfWeek.class, Month.class);
+
+    @Test
+    void mapKeysRoundTrip() {
+        Zoo.run("mapKeysRoundTrip", tc -> {
+            Class<?> k = pick(tc, KEY_TYPES.toArray(new Class<?>[0]));
+            Map<Object, String> map = new LinkedHashMap<>();
+            for (int i = n(tc, 0, 4); i > 0; i--) {
+                map.put(key(tc, k), word(tc));
+            }
+            ObjectMapper m = pick(tc, MAPPER, NO_ADJUST, ZONE_IDS);
+            JavaType type = m.getTypeFactory().constructMapType(LinkedHashMap.class, k, String.class);
+            String text = m.writer().forType(type).writeValueAsString(map);
+            String err = thrown(() -> m.readValue(text, type));
+            if (err != null) {
+                // the key serializer is toString(), which spells a year of 10000 or more without the "+" the key
+                // deserializer's parser (YearMonth's own) insists on; the value deserializer takes it
+                if (k == YearMonth.class && err.contains("could not be parsed") && map.keySet().stream().anyMatch(ym -> ((YearMonth) ym).getYear() > 9999)) {
+                    count("known jackson-databind/6");
+                    return;
+                }
+                Zoo.fail("Map<" + k.getSimpleName() + ", String> written as " + show(text) + " cannot be read back: " + err);
+                return;
+            }
+            Map<?, ?> back = m.readValue(text, type);
+            if (k == OffsetDateTime.class || k == ZonedDateTime.class) {
+                // keys are written as text; with ADJUST_DATES_TO_CONTEXT_TIME_ZONE the zone/offset changes on the way back
+                check(back.size() == map.size(), () -> "Map<" + k.getSimpleName() + "> " + show(text) + " read back as " + back);
+                count(k.getSimpleName() + " keys: " + (map.equals(back) ? "exact" : "adjusted"));
+            } else {
+                check(map.equals(back), () -> "Map<" + k.getSimpleName() + ", String> written as " + show(text) + " read back as " + back);
+                check(new ArrayList<>(back.keySet()).equals(new ArrayList<>(map.keySet())), () -> "Map<" + k.getSimpleName() + "> key order changed: " + back.keySet() + " from " + map.keySet());
+            }
+            String again = m.writer().forType(type).writeValueAsString(back);
+            check(again.equals(text) || k == OffsetDateTime.class || k == ZonedDateTime.class, () -> "Map<" + k.getSimpleName() + "> written again as " + show(again) + " from " + show(text));
+            // sorted output orders the keys as the key type does (Comparable keys)
+            if (Comparable.class.isAssignableFrom(k) && k != ZoneId.class && k != Double.class && k != Float.class && m == MAPPER) {
+                String sorted = SORTED.writer().forType(type).writeValueAsString(map);
+                Map<?, ?> sortedBack = SORTED.readValue(sorted, type);
+                List<Object> wantOrder = new ArrayList<>(new TreeMap<>(map).keySet());
+                List<Object> gotOrder = new ArrayList<>(sortedBack.keySet());
+                if (k == OffsetDateTime.class || k == ZonedDateTime.class) {
+                    // read back adjusted to UTC: compare the instants
+                    wantOrder = wantOrder.stream().map(ValuesTest::instantOf).collect(Collectors.toList());
+                    gotOrder = gotOrder.stream().map(ValuesTest::instantOf).collect(Collectors.toList());
+                }
+                List<Object> want = wantOrder, got = gotOrder;
+                check(got.equals(want), () -> "ORDER_MAP_ENTRIES_BY_KEYS wrote " + show(sorted) + " with keys " + got + " expected " + want);
+            }
+            count(k.getSimpleName());
+        });
+    }
+
+    static Object instantOf(Object k) {
+        return k instanceof OffsetDateTime o ? o.toInstant() : k instanceof ZonedDateTime z ? z.toInstant() : k;
+    }
+
+    // ------------------------------------------------------------------ 4. java.time
+
+    @Test
+    void javaTimeValuesRoundTrip() {
+        Zoo.run("javaTimeValuesRoundTrip", tc -> {
+            Class<?> k = pick(tc, TIME_TYPES.toArray(new Class<?>[0]));
+            Object v = time(tc, k);
+            ObjectMapper m = pick(tc, MAPPER, TIMESTAMPS, NO_ADJUST, ZONE_IDS);
+            String mode = m == MAPPER ? "default" : m == TIMESTAMPS ? "timestamps" : m == NO_ADJUST ? "no-adjust" : "zone-ids";
+            String writeErr = thrown(() -> m.writeValueAsString(v));
+            if (writeErr != null) {
+                // the nanosecond timestamp of a negative Duration is computed from its absolute value, which
+                // Duration.ofSeconds(Long.MIN_VALUE) has none of
+                if (k == Duration.class && m == TIMESTAMPS && ((Duration) v).getSeconds() == Long.MIN_VALUE && writeErr.contains("Exceeds capacity")) {
+                    count("known jackson-databind/5");
+                    return;
+                }
+                Zoo.fail(k.getSimpleName() + " " + v + " (" + mode + ") cannot be written: " + writeErr);
+                return;
+            }
+            String text = m.writeValueAsString(v);
+            String err = thrown(() -> m.readValue(text, k));
+            if (err != null) {
+                Zoo.fail(k.getSimpleName() + " " + v + " written as " + show(text) + " (" + mode + ") cannot be read back: " + err);
+                return;
+            }
+            Object back = m.readValue(text, k);
+            boolean adjusts = m == MAPPER || m == TIMESTAMPS;
+            if (k == OffsetDateTime.class) {
+                OffsetDateTime a = (OffsetDateTime) v;
+                OffsetDateTime b = (OffsetDateTime) back;
+                if (adjusts) {
+                    check(a.isEqual(b) && b.getOffset().equals(ZoneOffset.UTC), () -> "OffsetDateTime " + a + " (" + mode + ", " + show(text) + ") read back as " + b + " - expected the same instant at UTC");
+                } else {
+                    check(a.equals(b), () -> "OffsetDateTime " + a + " (" + mode + ", " + show(text) + ") read back as " + b);
+                }
+            } else if (k == ZonedDateTime.class) {
+                ZonedDateTime a = (ZonedDateTime) v;
+                ZonedDateTime b = (ZonedDateTime) back;
+                if (m == ZONE_IDS) {
+                    check(a.equals(b), () -> "ZonedDateTime " + a + " (" + mode + ", " + show(text) + ") read back as " + b);
+                } else {
+                    check(a.toInstant().equals(b.toInstant()), () -> "ZonedDateTime " + a + " (" + mode + ", " + show(text) + ") read back as " + b + " - another instant");
+                    count("ZonedDateTime zone " + (a.getZone().equals(b.getZone()) ? "kept" : "lost") + " (" + mode + ")");
+                }
+            } else if (k == OffsetTime.class && adjusts) {
+                check(((OffsetTime) v).isEqual((OffsetTime) back), () -> "OffsetTime " + v + " (" + mode + ", " + show(text) + ") read back as " + back);
+            } else {
+                check(v.equals(back), () -> k.getSimpleName() + " " + v + " (" + mode + ") written as " + show(text) + " read back as " + back);
+            }
+            // idempotent text
+            String again = m.writeValueAsString(back);
+            if (!(k == OffsetDateTime.class || k == ZonedDateTime.class || k == OffsetTime.class) || !adjusts) {
+                check(again.equals(text), () -> k.getSimpleName() + " " + v + " (" + mode + "): written " + show(text) + " then, read back, " + show(again));
+            }
+            // inside a record and a list the same
+            List<Object> list = List.of(v);
+            String listText = m.writeValueAsString(list);
+            JavaType listType = m.getTypeFactory().constructCollectionType(List.class, k);
+            String listErr = thrown(() -> m.readValue(listText, listType));
+            if (listErr != null) {
+                Zoo.fail("List<" + k.getSimpleName() + "> " + show(listText) + " (" + mode + ") cannot be read back: " + listErr);
+            } else {
+                List<?> listBack = m.readValue(listText, listType);
+                // the element reads back exactly as the root value did (adjusted or not)
+                String wantList = m.writeValueAsString(List.of(back));
+                check(listBack.size() == 1 && m.writeValueAsString(listBack).equals(wantList), () -> "List<" + k.getSimpleName() + "> " + show(listText) + " read back as " + listBack + " but the value alone as " + back);
+            }
+            // a timestamp is a number, a text a string (documented by the features)
+            JsonNode node = m.readTree(text);
+            boolean numeric = m == TIMESTAMPS && (k == Instant.class || k == LocalDate.class || k == LocalTime.class || k == LocalDateTime.class
+                    || k == OffsetDateTime.class || k == ZonedDateTime.class || k == Duration.class || k == OffsetTime.class || k == YearMonth.class || k == MonthDay.class);
+            count(k.getSimpleName() + " " + mode + " as " + node.getNodeType());
+            if (m == TIMESTAMPS && k == Instant.class) {
+                check(node.isNumber(), () -> "Instant with WRITE_DATES_AS_TIMESTAMPS written as " + show(text));
+            }
+            if (m == MAPPER && (k == Instant.class || k == LocalDate.class || k == Duration.class)) {
+                check(node.isString(), () -> k.getSimpleName() + " without WRITE_DATES_AS_TIMESTAMPS written as " + show(text));
+            }
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..5c690ce
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,139 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+import dev.hegel.Hegel;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    private static final TreeMap<String, Integer> STATS = new TreeMap<>();
+
+    /** Run a property under its settings; in collect mode print the counters afterwards. */
+    static void run(String name, Consumer<TestCase> body) {
+        STATS.clear();
+        try {
+            Hegel.test(body::accept, settings(name));
+        } finally {
+            if (COLLECT && !STATS.isEmpty()) {
+                System.out.println("STATS " + name + " " + STATS);
+                System.out.flush();
+            }
+        }
+    }
+
+    /** Count an outcome (printed after the property in collect mode). */
+    static void count(String key) {
+        if (COLLECT) {
+            STATS.merge(key, 1, Integer::sum);
+        }
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
