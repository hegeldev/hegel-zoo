+                JsonNode x = leaf(tc);
+                int i = n(tc, -1, model.size() + 1);
+                String op;
+                switch (n(tc, 0, 12)) {
+                    case 0 -> {
+                        op = "add";
+                        JsonNode y = chance(tc, 15) ? null : x;
+                        check(node.add(y) == node, "add() did not return this");
+                        model.add(y == null ? F.nullNode() : y);
+                    }
+                    case 1 -> {
+                        op = "add(int)";
+                        node.add(3);
+                        model.add(F.numberNode(3));
+                    }
+                    case 2 -> {
+                        op = "addNull";
