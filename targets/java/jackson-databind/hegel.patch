+                        model.put(k, F.numberNode(i));
+                    }
+                    case 1 -> {
+                        op = "put(String)";
+                        String s = chance(tc, 20) ? null : Zoo.word(tc, "xy", 0, 2);
+                        node.put(k, s);
+                        model.put(k, s == null ? F.nullNode() : F.stringNode(s));
+                    }
+                    case 2 -> {
+                        op = "set";
+                        JsonNode y = chance(tc, 15) ? null : x;
+                        ObjectNode ret = node.set(k, y);
+                        check(ret == node, "set() did not return this");
+                        model.put(k, y == null ? F.nullNode() : y);
+                    }
+                    case 3 -> {
+                        op = "replace";
+                        JsonNode old = node.replace(k, x);
+                        JsonNode wantOld = model.put(k, x);
+                        check(same(old, wantOld), () -> "replace(" + show(k) + ") returned " + old + " expected " + wantOld);
+                    }
+                    case 4 -> {
+                        op = "remove(name)";
+                        JsonNode old = node.remove(k);
+                        JsonNode wantOld = model.remove(k);
+                        check(same(old, wantOld), () -> "remove(" + show(k) + ") returned " + old + " expected " + wantOld);
+                    }
+                    case 5 -> {
+                        op = "remove(names)";
+                        List<String> ks = List.of(k, key(tc));
+                        node.remove(ks);
+                        ks.forEach(model::remove);
+                    }
+                    case 6 -> {
+                        op = "removeAll";
+                        node.removeAll();
+                        model.clear();
+                    }
+                    case 7 -> {
+                        op = "retain";
+                        List<String> ks = List.of(k, key(tc));
+                        if (chance(tc, 50)) {
+                            node.retain(ks);
+                        } else {
+                            node.retain(ks.get(0), ks.get(1));
+                        }
+                        model.keySet().retainAll(ks);
+                    }
+                    case 8 -> {
+                        op = "without";
+                        if (chance(tc, 50)) {
+                            node.without(k);
+                            model.remove(k);
+                        } else {
+                            List<String> ks = List.of(k, key(tc));
+                            node.without(ks);
+                            ks.forEach(model::remove);
+                        }
+                    }
+                    case 9 -> {
+                        op = "setAll(map)";
+                        Map<String, JsonNode> more = new LinkedHashMap<>();
+                        more.put(k, x);
+                        more.put(key(tc), leaf(tc));
+                        node.setAll(more);
+                        model.putAll(more);
+                    }
+                    case 10 -> {
+                        op = "setAll(ObjectNode)";
+                        ObjectNode more = F.objectNode();
+                        more.set(k, x);
+                        more.set(key(tc), leaf(tc));
+                        node.setAll(more);
+                        for (Map.Entry<String, JsonNode> e : more.properties()) {
+                            model.put(e.getKey(), e.getValue());
+                        }
+                    }
+                    case 11 -> {
+                        op = "putIfAbsent";
+                        JsonNode old = node.putIfAbsent(k, x);
+                        JsonNode wantOld = model.putIfAbsent(k, x);
+                        check(same(old, wantOld), () -> "putIfAbsent(" + show(k) + ") returned " + old + " expected " + wantOld);
+                    }
+                    case 12 -> {
+                        op = "removeIf";
+                        Predicate<JsonNode> pred = chance(tc, 50) ? JsonNode::isNull : JsonNode::isNumber;
+                        node.removeIf(pred);
+                        model.values().removeIf(pred);
+                    }
+                    case 13 -> {
+                        op = "putNull";
+                        node.putNull(k);
+                        model.put(k, F.nullNode());
+                    }
+                    case 14 -> {
+                        op = "putArray";
+                        ArrayNode child = node.putArray(k);
+                        child.add(1);
+                        model.put(k, F.arrayNode().add(1));
+                    }
+                    case 15 -> {
+                        op = "putObject";
+                        ObjectNode child = node.putObject(k);
+                        child.put("z", true);
+                        model.put(k, F.objectNode().put("z", true));
+                    }
+                    case 16 -> {
+                        op = "removeNulls";
