+            JsonNode snode = STRIPPED.readTree(text);
+            check(Model.same(Model.toRef(snode), v, true), () -> "STRIP_TRAILING_BIGDECIMAL_ZEROES read " + Model.show(snode) + " for " + show(text));
+            checkStripped(snode);
+            // an invalid text is rejected (a blank one is the missing node, as documented)
+            if (chance(tc, 50)) {
+                String bad = Ref.mutate(tc, text);
+                if (bad.indexOf('\0') >= 0 || bad.isBlank()) {
+                    return;
+                }
+                boolean ok;
+                try {
+                    Ref.parse(bad);
