+                check(a.size() + 1 == c.size(), () -> "mutating a deepCopy changed the original " + Model.show(a));
+            }
+            // a different value gives a different tree
+            Object w = Ref.gen(tc, 3);
+            if (!Model.awkward(w, false)) {
+                JsonNode other = MAPPER.readTree(Ref.write(w, Ref.PLAIN));
+                boolean sameValue = Model.same(Model.toRef(a), Model.toRef(other), false)
+                        && sameNumberTypes(a, other);
+                check(a.equals(other) == sameValue, () -> "equals is " + a.equals(other) + " for " + Model.show(a) + " and " + Model.show(other));
+                count(sameValue ? "equal pair" : "different pair");
