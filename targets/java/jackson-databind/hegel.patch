+    @Test
+    void sequencesReadBackTheValuesWritten() {
+        Zoo.run("sequencesReadBackTheValuesWritten", tc -> {
+            List<Object> values = new ArrayList<>();
+            Class<?> type = pick(tc, Point.class, Shape.class, Integer.class, String.class, Object.class);
+            int size = n(tc, 0, 4);
+            for (int i = 0; i < size; i++) {
+                if (type == Point.class) {
+                    values.add(point(tc));
+                } else if (type == Shape.class) {
+                    values.add(shape(tc));
+                } else if (type == Integer.class) {
+                    values.add(n(tc, -9, 9));
+                } else if (type == String.class) {
+                    values.add(word(tc));
+                } else {
+                    values.add(any(tc, 2));
+                }
+            }
+            // SequenceWriter: root values one after the other, or as an array
+            StringWriter sw = new StringWriter();
+            boolean asArray = chance(tc, 50);
+            try (SequenceWriter seq = asArray ? MAPPER.writer().writeValuesAsArray(sw) : MAPPER.writer().writeValues(sw)) {
+                for (Object v : values) {
+                    seq.write(v);
+                }
+            }
+            String text = sw.toString();
+            // a root array is iterated element by element (documented), not read as one value
+            boolean firstIsArray = !values.isEmpty() && text(MAPPER, values.get(0)).startsWith("[");
+            String wantText = text(MAPPER, values);
+            if (asArray || !firstIsArray) {
+                // read them back with a MappingIterator
+                List<Object> back = new ArrayList<>();
+                try (MappingIterator<?> it = MAPPER.readerFor(type).readValues(text)) {
+                    while (it.hasNextValue()) {
+                        back.add(it.nextValue());
+                    }
+                }
+                String gotText = text(MAPPER, back);
+                check(gotText.equals(wantText), () -> "readValues(" + show(text) + ") = " + gotText + " expected " + wantText + (asArray ? " (array)" : " (roots)"));
+            }
+            if (firstIsArray) {
+                count("first root value is an array");
+                return;
+            }
+            // hand-made separators between root values: a scalar must be followed by whitespace
+            // (documented: "Expected space separating root-level values"), a container or string need not
+            StringBuilder sb = new StringBuilder();
+            String prev = "";
+            for (Object v : values) {
+                boolean afterScalar = !prev.isEmpty() && !(prev.endsWith("}") || prev.endsWith("]") || prev.endsWith("\""));
+                sb.append(afterScalar ? pick(tc, " ", "\n", "\t\r\n", "  ") : pick(tc, "", " ", "\n", "\t\r\n"));
+                prev = text(MAPPER, v);
+                sb.append(prev);
+            }
+            sb.append(pick(tc, "", " ", "\n"));
+            String loose = sb.toString();
+
+            List<Object> back2 = new ArrayList<>();
+            String err = thrown(() -> {
+                try (MappingIterator<?> it = MAPPER.readerFor(type).readValues(loose)) {
+                    while (it.hasNextValue()) {
+                        back2.add(it.nextValue());
+                    }
+                }
+            });
+            if (err != null) {
+                Zoo.fail("readValues(" + show(loose) + ") threw " + err);
+            } else {
+                String got2 = text(MAPPER, back2);
+                check(got2.equals(wantText), () -> "readValues(" + show(loose) + ") = " + got2 + " expected " + wantText);
+            }
+            count(type.getSimpleName() + (asArray ? " array" : " roots") + " " + size);
+        });
+    }
