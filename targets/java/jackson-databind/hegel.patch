+                    }
+                }
+            }
+        }
+        sb.append('"');
+    }
+
+    /** Deep equality; maps compared in order when {@code ordered}, as sets of entries otherwise. */
+    @SuppressWarnings("unchecked")
+    static boolean same(Object a, Object b, boolean ordered) {
+        if (a == NULL || b == NULL || a == null || b == null) {
+            return (a == NULL || a == null) && (b == NULL || b == null);
+        }
+        if (a instanceof List<?> la && b instanceof List<?> lb) {
+            if (la.size() != lb.size()) {
+                return false;
+            }
+            for (int i = 0; i < la.size(); i++) {
+                if (!same(la.get(i), lb.get(i), ordered)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a instanceof Map<?, ?> ma && b instanceof Map<?, ?> mb) {
+            if (ma.size() != mb.size()) {
+                return false;
+            }
+            if (ordered) {
+                var ia = ((Map<String, Object>) ma).entrySet().iterator();
+                var ib = ((Map<String, Object>) mb).entrySet().iterator();
+                while (ia.hasNext()) {
+                    var ea = ia.next();
+                    var eb = ib.next();
+                    if (!ea.getKey().equals(eb.getKey()) || !same(ea.getValue(), eb.getValue(), true)) {
+                        return false;
+                    }
+                }
+                return true;
+            }
+            for (Map.Entry<String, Object> e : ((Map<String, Object>) ma).entrySet()) {
+                if (!mb.containsKey(e.getKey()) || !same(e.getValue(), mb.get(e.getKey()), false)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a instanceof List || a instanceof Map || b instanceof List || b instanceof Map) {
+            return false;
+        }
+        return a.equals(b);
+    }
+
+    static String show(Object v) {
+        return write(v, PLAIN);
+    }
+
+    // ------------------------------------------------------------------ generators
+
+    static final String[] KEYS = {
+        "", "a", "b", "c", "key", "1", "0", "-1", "a b", "é", "null", "true", "__proto__", "constructor",
+        "with\"quote", "back\\slash", "new\nline", "tab\t", "日本", "<b>&'=", "😀", "A", "aa",
+    };
+
+    static final String[] NUMBERS = {
+        "0", "-0", "1", "-1", "7", "10", "42", "255", "256", "65535", "2147483647", "2147483648", "-2147483648",
+        "-2147483649", "4294967295", "9007199254740992", "9007199254740993", "9223372036854775807",
+        "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "18446744073709551616",
+        "123456789012345678901234567890", "0.0", "-0.0", "1.0", "1.5", "0.1", "0.2", "0.30000000000000004",
