+
+/**
+ * Hegel zoo: jackson-databind's tree model (JsonNode) against the reference JSON value ({@link Ref})
+ * and models of the documented node operations.
+ */
+class TreesTest {
+
+    static final ObjectMapper MAPPER = JsonMapper.builder().build();
+    static final ObjectMapper EXACT = JsonMapper.builder().enable(JsonNodeFeature.USE_BIG_DECIMAL_FOR_FLOATS).build();
+    static final ObjectMapper EXACT_DESER = JsonMapper.builder().enable(DeserializationFeature.USE_BIG_DECIMAL_FOR_FLOATS).build();
+    static final ObjectMapper STRIPPED = JsonMapper.builder().enable(JsonNodeFeature.USE_BIG_DECIMAL_FOR_FLOATS, JsonNodeFeature.STRIP_TRAILING_BIGDECIMAL_ZEROES).build();
+    static final ObjectMapper SORTED = JsonMapper.builder().enable(JsonNodeFeature.WRITE_PROPERTIES_SORTED).build();
+    static final ObjectMapper NO_NULLS_OUT = JsonMapper.builder().disable(JsonNodeFeature.WRITE_NULL_PROPERTIES).build();
+    static final ObjectMapper NO_NULLS_IN = JsonMapper.builder().disable(JsonNodeFeature.READ_NULL_PROPERTIES).build();
+    static final ObjectMapper PRETTY = JsonMapper.builder().enable(SerializationFeature.INDENT_OUTPUT).build();
+    static final JsonNodeFactory F = JsonNodeFactory.instance;
+
+    /** The input paths a text can take into readTree. */
+    enum Src { STRING, BYTES, READER, STREAM, DATA_INPUT, BYTE_RANGE, PARSER, TOKEN_BUFFER }
+
+    /** A lone surrogate has no UTF-8 encoding (Java writes '?'): byte sources cannot carry the text. */
+    static boolean loneSurrogate(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
+                    i++;
+                } else {
+                    return true;
+                }
+            } else if (Character.isLowSurrogate(c)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** A lone surrogate anywhere in the value's strings or keys (escaped in the text or not). */
+    static boolean loneSurrogateIn(Object v) {
+        if (v instanceof String s) {
+            return loneSurrogate(s);
+        }
+        if (v instanceof Map<?, ?> m) {
+            for (Map.Entry<?, ?> e : m.entrySet()) {
+                if (loneSurrogate((String) e.getKey()) || loneSurrogateIn(e.getValue())) {
+                    return true;
+                }
+            }
+        } else if (v instanceof List<?> l) {
+            for (Object x : l) {
+                if (loneSurrogateIn(x)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Read the text through a source; a text with lone surrogates (which UTF-8 cannot carry, and whose
+     * escapes the byte parsers reject in names: jackson-core/3) takes a char source instead.
+     */
+    static JsonNode read(ObjectMapper m, Src src, String text, boolean charsOnly, TestCase tc) {
+        byte[] bytes = text.getBytes(StandardCharsets.UTF_8);
+        if (charsOnly && src != Src.STRING && src != Src.READER && src != Src.PARSER && src != Src.TOKEN_BUFFER) {
+            src = Src.READER;
+        }
+        // jackson-core/1: the DataInput parser fails on a root scalar at the very end of the input
+        if (src == Src.DATA_INPUT && !text.trim().startsWith("{") && !text.trim().startsWith("[")) {
+            src = Src.STREAM;
+        }
+        switch (src) {
+            case STRING:
+                return m.readTree(text);
+            case BYTES:
+                return m.readTree(bytes);
+            case READER:
+                return m.readTree(new StringReader(text));
+            case STREAM:
+                return m.readTree(new ByteArrayInputStream(bytes));
+            case DATA_INPUT:
+                return m.readValue((DataInput) new DataInputStream(new ByteArrayInputStream(bytes)), JsonNode.class);
+            case BYTE_RANGE: {
+                int pre = n(tc, 0, 3);
+                int post = n(tc, 0, 3);
+                byte[] padded = new byte[pre + bytes.length + post];
+                Arrays.fill(padded, (byte) 'x');
+                System.arraycopy(bytes, 0, padded, pre, bytes.length);
+                return m.readTree(padded, pre, bytes.length);
+            }
+            case PARSER:
+                try (JsonParser p = m.createParser(text)) {
+                    return m.readTree(p);
+                }
+            default: {
+                JsonNode direct = m.readTree(text);
+                TokenBuffer buf = TokenBuffer.forGeneration();
+                m.writeValue((JsonGenerator) buf, direct);
+                return m.readTree(buf);
+            }
+        }
+    }
+
+    static String thrown(Runnable r) {
+        try {
+            r.run();
+            return null;
+        } catch (JacksonException | UnsupportedOperationException | IllegalArgumentException | IndexOutOfBoundsException e) {
+            return e.getClass().getSimpleName() + ": " + e.getMessage();
+        }
+    }
+
+    // ------------------------------------------------------------------ 1. readTree and writing back
+
+    @Test
+    void treeReadsTheReferenceValue() {
+        Zoo.run("treeReadsTheReferenceValue", tc -> {
+            Object v = Ref.gen(tc, 4);
+            if (Model.awkward(v, true)) {
+                count("skipped: number without a BigDecimal");
+                return;
+            }
+            String text = Ref.text(tc, v);
+            boolean overflow = Model.awkward(v, false);
+            // default mapper: doubles for floats
+            JsonNode node = MAPPER.readTree(text);
+            if (!overflow) {
+                JsonNode want = Model.toNode(v, F, false);
+                check(node.equals(want), () -> "readTree(" + show(text) + ") = " + Model.show(node) + " expected " + Model.show(want));
+                check(node.hashCode() == want.hashCode(), () -> "hashCode differs for equal trees " + Model.show(node));
+                // every source builds the same tree
+                Src src = pick(tc, Src.values());
+                JsonNode other = read(MAPPER, src, text, loneSurrogate(text) || loneSurrogateIn(v), tc);
+                check(node.equals(other), () -> "readTree via " + src + " = " + Model.show(other) + " but via String " + Model.show(node));
+                // written back, the text denotes the same value (floats as the doubles they are)
+                String out = MAPPER.writeValueAsString(node);
+                Object back = Ref.parse(out);
+                check(Model.same(back, v, false), () -> "writeValueAsString(readTree(" + show(text) + ")) = " + show(out));
+                check(node.toString().equals(out), () -> "toString() " + show(node.toString()) + " differs from writeValueAsString " + show(out));
+                String pretty = pick(tc, PRETTY.writeValueAsString(node), node.toPrettyString(), MAPPER.writerWithDefaultPrettyPrinter().writeValueAsString(node));
+                check(Model.compact(pretty).equals(out), () -> "pretty output " + show(pretty) + " is not the compact " + show(out) + " plus whitespace");
+                // WRITE_PROPERTIES_SORTED, WRITE_NULL_PROPERTIES, READ_NULL_PROPERTIES
+                Object sortedBack = Ref.parse(SORTED.writeValueAsString(node));
+                check(Model.same(sortedBack, Model.sorted(v), false), () -> "WRITE_PROPERTIES_SORTED wrote " + show(SORTED.writeValueAsString(node)) + " for " + show(text));
+                Object noNullsOut = Ref.parse(NO_NULLS_OUT.writeValueAsString(node));
+                check(Model.same(noNullsOut, Model.withoutNulls(v), false), () -> "WRITE_NULL_PROPERTIES=false wrote " + show(NO_NULLS_OUT.writeValueAsString(node)) + " for " + show(text));
+                JsonNode noNullsIn = NO_NULLS_IN.readTree(text);
+                JsonNode wantNoNulls = Model.toNode(Model.withoutNulls(v), F, false);
+                check(noNullsIn.equals(wantNoNulls), () -> "READ_NULL_PROPERTIES=false read " + Model.show(noNullsIn) + " expected " + Model.show(wantNoNulls));
+                count("default");
+            } else {
