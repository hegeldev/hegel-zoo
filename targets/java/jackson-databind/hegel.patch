+                String q = key(tc);
+                JsonNode m = model.get(q);
+                check(same(node.get(q), m), () -> "get(" + show(q) + ") = " + node.get(q) + " expected " + m);
+                check(m == null ? node.path(q).isMissingNode() : node.path(q).equals(m), () -> "path(" + show(q) + ") = " + node.path(q) + " expected " + (m == null ? "missing" : m));
+                Optional<JsonNode> opt = node.optional(q);
+                check(m == null ? opt.isEmpty() : opt.isPresent() && opt.get().equals(m), () -> "optional(" + show(q) + ") = " + opt);
+                check(node.has(q) == (m != null), () -> "has(" + show(q) + ") = " + node.has(q));
+                check(node.hasNonNull(q) == (m != null && !m.isNull()), () -> "hasNonNull(" + show(q) + ") = " + node.hasNonNull(q) + " for " + m);
+                String err = thrown(() -> node.required(q));
+                check((err == null) == (m != null), () -> "required(" + show(q) + ") " + (err == null ? "returned" : "threw " + err) + " for " + m);
+                check(m == null ? node.get(q) == null : node.get(q) == node.path(q), () -> "get and path return different objects for " + show(q));
+            }
+        });
+    }
+
+    static boolean same(JsonNode a, JsonNode b) {
+        return a == null ? b == null : a.equals(b);
+    }
