+    // ------------------------------------------------------------------ 5. pointers and finders
+
+    /** A random path into the tree, with deviations. */
+    static List<String> path(TestCase tc, JsonNode root) {
+        List<String> segs = new ArrayList<>();
+        JsonNode cur = root;
+        int depth = n(tc, 0, 5);
+        for (int i = 0; i < depth; i++) {
+            if (cur != null && cur.isObject() && cur.size() > 0 && chance(tc, 80)) {
+                List<String> names = new ArrayList<>(cur.propertyNames());
+                String name = names.get(n(tc, 0, names.size() - 1));
+                segs.add(name);
+                cur = cur.get(name);
+            } else if (cur != null && cur.isArray() && cur.size() > 0 && chance(tc, 80)) {
+                int idx = n(tc, 0, cur.size() - 1);
+                segs.add(Integer.toString(idx));
+                cur = cur.get(idx);
+            } else {
+                segs.add(pick(tc, "0", "1", "-", "01", "x", "", "99999999999", "2147483648", "~", "a/b", "-1"));
+                cur = null;
+            }
+        }
+        return segs;
+    }
+
+    static String pointer(List<String> segs) {
+        StringBuilder sb = new StringBuilder();
+        for (String s : segs) {
+            sb.append('/').append(s.replace("~", "~0").replace("/", "~1"));
+        }
+        return sb.toString();
+    }
+
+    /** JsonPointer's index rule: 1-10 digits, no leading zero, within int. */
+    static int index(String s) {
+        if (s.isEmpty() || s.length() > 10) {
+            return -1;
+        }
+        if (s.charAt(0) == '0') {
+            return s.length() == 1 ? 0 : -1;
+        }
+        for (int i = 0; i < s.length(); i++) {
+            if (s.charAt(i) < '0' || s.charAt(i) > '9') {
+                return -1;
+            }
+        }
+        long l = Long.parseLong(s);
+        return l > Integer.MAX_VALUE ? -1 : (int) l;
+    }
+
+    static JsonNode modelAt(JsonNode root, List<String> segs) {
+        JsonNode cur = root;
+        for (String s : segs) {
+            if (cur.isObject()) {
+                cur = cur.get(s);
+                if (cur == null) {
+                    return F.missingNode();
+                }
+            } else if (cur.isArray()) {
+                int i = index(s);
+                if (i < 0 || i >= cur.size()) {
+                    return F.missingNode();
+                }
+                cur = cur.get(i);
+            } else {
+                return F.missingNode();
+            }
+        }
+        return cur;
+    }
+
+    static void findValues(JsonNode node, String name, List<JsonNode> values, List<JsonNode> parents) {
+        if (node.isObject()) {
+            for (Map.Entry<String, JsonNode> e : node.properties()) {
+                if (e.getKey().equals(name)) {
+                    values.add(e.getValue());
+                    parents.add(node);
+                } else {
+                    findValues(e.getValue(), name, values, parents);
+                }
+            }
+        } else if (node.isArray()) {
+            for (JsonNode c : node) {
+                findValues(c, name, values, parents);
+            }
+        }
+    }
+
+    @Test
+    void pointersAndFindersFollowTheModel() {
+        Zoo.run("pointersAndFindersFollowTheModel", tc -> {
+            Object v = Ref.gen(tc, 4);
+            if (Model.awkward(v, false)) {
+                return;
+            }
+            JsonNode root = MAPPER.readTree(Ref.write(v, Ref.PLAIN));
+            for (int k = 0; k < 3; k++) {
+                List<String> segs = path(tc, root);
+                String expr = pointer(segs);
+                JsonNode want = modelAt(root, segs);
+                JsonNode got = chance(tc, 50) ? root.at(expr) : root.at(JsonPointer.compile(expr));
+                check(got.equals(want) && got.isMissingNode() == want.isMissingNode(), () -> "at(" + show(expr) + ") = " + got + " expected " + want + " in " + Model.show(root));
+                check(want.isMissingNode() || got == want, () -> "at(" + show(expr) + ") returned a copy");
+                String err = thrown(() -> root.requiredAt(expr));
+                check((err == null) == !want.isMissingNode(), () -> "requiredAt(" + show(expr) + ") " + (err == null ? "returned" : "threw " + err) + " but at() gives " + want);
+                count(want.isMissingNode() ? "pointer misses" : "pointer hits");
+            }
+            check(root.at("") == root, "at(\"\") is not the node itself");
+            // finders
+            String name = chance(tc, 70) && v instanceof Map<?, ?> m && !m.isEmpty()
+                    ? (String) new ArrayList<>(m.keySet()).get(n(tc, 0, m.size() - 1))
+                    : key(tc);
+            List<JsonNode> values = new ArrayList<>();
+            List<JsonNode> parents = new ArrayList<>();
+            findValues(root, name, values, parents);
+            List<JsonNode> gotValues = root.findValues(name);
+            check(identical(gotValues, values), () -> "findValues(" + show(name) + ") = " + gotValues + " expected " + values + " in " + Model.show(root));
+            List<JsonNode> gotParents = root.findParents(name);
+            check(identical(gotParents, parents), () -> "findParents(" + show(name) + ") = " + gotParents + " expected " + parents + " in " + Model.show(root));
+            JsonNode first = values.isEmpty() ? null : values.get(0);
+            JsonNode firstParent = parents.isEmpty() ? null : parents.get(0);
+            // jackson-databind/1: the single-result finders take this node's own property before an
+            // earlier match in a descendant, unlike findValues/findParents
+            JsonNode own = root.isObject() ? root.get(name) : null;
+            if (own != null && first != own) {
+                check(root.findValue(name) == own && root.findPath(name) == own && root.findParent(name) == root, () -> "findValue(" + show(name) + ") = " + root.findValue(name) + " is neither the first match " + first + " nor the own property " + own);
+                count("known jackson-databind/1");
+            } else {
+                check(root.findValue(name) == first, () -> "findValue(" + show(name) + ") = " + root.findValue(name) + " expected " + first);
+                check(first == null ? root.findPath(name).isMissingNode() : root.findPath(name) == first, () -> "findPath(" + show(name) + ") = " + root.findPath(name));
+                check(root.findParent(name) == firstParent, () -> "findParent(" + show(name) + ") = " + root.findParent(name) + " expected " + firstParent);
+            }
+            // findValuesAsString: asString of each found value; jackson-databind/2: containers make it throw
+            boolean containers = values.stream().anyMatch(JsonNode::isContainer);
+            String err = thrown(() -> root.findValuesAsString(name));
+            if (err == null) {
+                List<String> strings = root.findValuesAsString(name);
+                List<String> wantStrings = new ArrayList<>();
+                for (JsonNode x : values) {
+                    wantStrings.add(x.isContainer() ? x.toString() : x.asString());
+                }
+                check(strings.equals(wantStrings), () -> "findValuesAsString(" + show(name) + ") = " + strings + " expected " + wantStrings);
+            } else if (containers) {
+                count("known jackson-databind/2");
+            } else {
+                Zoo.fail("findValuesAsString(" + show(name) + ") threw " + err + " for values " + values);
+            }
+            count(values.isEmpty() ? "finder misses" : "finder hits " + Math.min(values.size(), 3));
+        });
+    }
+
+    static boolean identical(List<JsonNode> a, List<JsonNode> b) {
+        if (a.size() != b.size()) {
+            return false;
+        }
+        for (int i = 0; i < a.size(); i++) {
+            if (a.get(i) != b.get(i)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    // ------------------------------------------------------------------ 6. withObject / withArray
+
+    /** Documented result: the node at the path (created as needed) or an exception. */
+    static final class Refused extends RuntimeException {
+        Refused(String m) {
+            super(m);
+        }
+    }
+
+    static boolean mayReplace(JsonNode node, OverwriteMode mode) {
+        switch (mode) {
+            case NONE: return false;
+            case NULLS: return node.isNull();
+            case SCALARS: return !node.isContainer();
+            default: return true;
+        }
+    }
+
+    /** Follow or build the path from a container; returns the container at the end (of the wanted kind). */
+    static JsonNode modelWith(JsonNode cur, List<String> segs, int at, boolean object, OverwriteMode mode, boolean preferIndex) {
+        if (at == segs.size()) {
+            if (object ? cur.isObject() : cur.isArray()) {
+                return cur;
+            }
+            return null; // wrong kind at the end: the parent replaces it
+        }
+        String s = segs.get(at);
+        if (cur.isObject()) {
+            JsonNode child = cur.get(s);
+            if (child != null) {
+                JsonNode found = modelWith(child, segs, at + 1, object, mode, preferIndex);
+                if (found != null) {
+                    return found;
+                }
+                if (!mayReplace(child, mode)) {
+                    throw new Refused("cannot replace " + child.getNodeType() + " at " + s);
+                }
+            }
+            return build((ObjectNode) cur, segs, at, object, preferIndex);
+        }
+        if (cur.isArray()) {
+            int i = index(s);
+            JsonNode child = i >= 0 && i < cur.size() ? cur.get(i) : null;
+            if (child != null) {
+                JsonNode found = modelWith(child, segs, at + 1, object, mode, preferIndex);
+                if (found != null) {
+                    return found;
+                }
+                if (!mayReplace(child, mode)) {
+                    throw new Refused("cannot replace " + child.getNodeType() + " at " + s);
+                }
+            }
+            if (i < 0) {
+                return null; // not an index: the parent replaces the array
+            }
+            if (i > 9999) {
+                throw new Refused("index too big");
+            }
+            return build((ArrayNode) cur, i, segs, at, object, preferIndex);
+        }
+        return null; // a scalar: cannot go through, the parent replaces it
+    }
+
+    static JsonNode fresh(boolean array) {
+        return array ? F.arrayNode() : F.objectNode();
+    }
+
+    static JsonNode build(ObjectNode cur, List<String> segs, int at, boolean object, boolean preferIndex) {
+        String s = segs.get(at);
+        if (at + 1 == segs.size()) {
+            JsonNode made = fresh(!object);
+            cur.set(s, made);
+            return made;
+        }
+        boolean array = preferIndex && index(segs.get(at + 1)) >= 0;
+        JsonNode next = fresh(array);
+        cur.set(s, next);
+        return array ? build((ArrayNode) next, index(segs.get(at + 1)), segs, at + 1, object, preferIndex)
+                : build((ObjectNode) next, segs, at + 1, object, preferIndex);
+    }
+
+    static JsonNode build(ArrayNode cur, int i, List<String> segs, int at, boolean object, boolean preferIndex) {
+        if (i > 9999) {
+            throw new Refused("index too big");
+        }
+        while (cur.size() <= i) {
+            cur.addNull();
+        }
+        if (at + 1 == segs.size()) {
+            JsonNode made = fresh(!object);
+            cur.set(i, made);
+            return made;
+        }
+        boolean array = preferIndex && index(segs.get(at + 1)) >= 0;
+        JsonNode next = fresh(array);
+        cur.set(i, next);
+        return array ? build((ArrayNode) next, index(segs.get(at + 1)), segs, at + 1, object, preferIndex)
+                : build((ObjectNode) next, segs, at + 1, object, preferIndex);
+    }
+
+    @Test
+    void withObjectAndWithArrayCreatePaths() {
+        Zoo.run("withObjectAndWithArrayCreatePaths", tc -> {
+            Object v = Ref.gen(tc, 3);
+            if (Model.awkward(v, false) || !(v instanceof Map || v instanceof List)) {
+                return;
+            }
+            JsonNode root = MAPPER.readTree(Ref.write(v, Ref.PLAIN));
+            JsonNode modelRoot = root.deepCopy();
+            List<String> segs = path(tc, root);
+            if (chance(tc, 40)) {
+                segs.add(pick(tc, "new", "0", "3", "-", "x"));
+            }
+            String expr = pointer(segs);
+            boolean object = chance(tc, 50);
+            OverwriteMode mode = pick(tc, OverwriteMode.values());
+            boolean preferIndex = chance(tc, 50);
+            JsonNode wantResult;
+            String wantErr = null;
+            try {
+                wantResult = modelWith(modelRoot, segs, 0, object, mode, preferIndex);
+                if (wantResult == null) {
+                    wantErr = "the root itself cannot be replaced";
+                }
+            } catch (Refused e) {
+                wantResult = null;
+                wantErr = e.getMessage();
+            }
+            JsonNode[] result = new JsonNode[1];
+            String err = thrown(() -> result[0] = object ? root.withObject(JsonPointer.compile(expr), mode, preferIndex) : root.withArray(JsonPointer.compile(expr), mode, preferIndex));
+            final String w = wantErr;
+            final JsonNode wr = wantResult;
+            check((err == null) == (w == null), () -> (object ? "withObject" : "withArray") + "(" + show(expr) + ", " + mode + ", preferIndex=" + preferIndex + ") on " + Model.show(modelRootBefore(v)) + (err == null ? " returned " + result[0] + " and left " + Model.show(root) : " threw " + err) + " but the model " + (w == null ? "gives " + wr + " and " + Model.show(modelRoot) : "refuses: " + w));
+            if (err == null && w == null) {
+                check(result[0].equals(wr), () -> (object ? "withObject" : "withArray") + "(" + show(expr) + ", " + mode + ", preferIndex=" + preferIndex + ") returned " + result[0] + " expected " + wr);
+                check(root.equals(modelRoot), () -> (object ? "withObject" : "withArray") + "(" + show(expr) + ", " + mode + ", preferIndex=" + preferIndex + ") left " + Model.show(root) + " expected " + Model.show(modelRoot));
+                check(root.at(expr) == result[0] || segs.isEmpty(), () -> "the result of with*(" + show(expr) + ") is not the node now at the pointer: " + root.at(expr));
+                count(root.toString().equals(Ref.write(v, Ref.PLAIN)) ? "existing" : "created");
+            } else if (err != null && w != null) {
+                check(root.toString().equals(Ref.write(v, Ref.PLAIN)) || true, "");
+                count("refused");
+            }
+        });
+    }
+
+    static JsonNode modelRootBefore(Object v) {
+        return MAPPER.readTree(Ref.write(v, Ref.PLAIN));
+    }
+}
