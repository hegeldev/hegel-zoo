@@ -0,0 +1,116 @@
+package zoo;
+
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.time.Duration;
+import java.time.YearMonth;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+import tools.jackson.databind.JavaType;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.ObjectMapper;
+import tools.jackson.databind.cfg.DateTimeFeature;
+import tools.jackson.databind.exc.JsonNodeException;
+import tools.jackson.databind.json.JsonMapper;
+import tools.jackson.databind.node.DecimalNode;
+import tools.jackson.databind.node.DoubleNode;
+import tools.jackson.databind.node.FloatNode;
+import tools.jackson.databind.node.StringNode;
+
+/**
+ * One plain test per bug in bugs.toml, failing at the pinned commit and listed in target.toml's
+ * [expected_failures]; when one passes the bug has been fixed upstream.
+ */
+class PinsTest {
+    static final ObjectMapper M = JsonMapper.builder().build();
+
+    /** jackson-databind/1: findValue/findPath/findParent return an own property before an earlier match in a descendant. */
+    @Test
+    void pinFindValueFollowsDocumentOrder() throws Exception {
+        JsonNode root = M.readTree("{\"a\":{\"c\":1},\"c\":2}");
+        List<JsonNode> all = root.findValues("c");
+        Assertions.assertEquals(List.of(root.get("a").get("c"), root.get("c")), all);
+        Assertions.assertEquals(all.get(0), root.findValue("c"));
+        Assertions.assertEquals(all.get(0), root.findPath("c"));
+        Assertions.assertEquals(root.findParents("c").get(0), root.findParent("c"));
+    }
+
+    /** jackson-databind/2: findValuesAsString throws for a matching Object or Array value. */
+    @Test
+    void pinFindValuesAsStringWithContainers() throws Exception {
+        JsonNode root = M.readTree("{\"a\":{\"x\":1},\"b\":{\"a\":[1]}}");
+        Assertions.assertEquals(2, root.findValues("a").size());
+        List<String> strings = Assertions.assertDoesNotThrow(() -> root.findValuesAsString("a"));
+        Assertions.assertEquals(2, strings.size());
+    }
+
+    /** jackson-databind/3: StringNode("92.1").asInt() throws where DecimalNode(92.1).asInt() truncates. */
+    @Test
+    void pinStringifiedFractionCoercesLikeTheNumber() {
+        DecimalNode number = DecimalNode.valueOf(new BigDecimal("92.1"));
+        StringNode string = StringNode.valueOf("92.1");
+        Assertions.assertEquals(92, number.asInt());
+        Assertions.assertEquals(92L, number.asLong());
+        Assertions.assertEquals(92, string.asInt());
+        Assertions.assertEquals(92L, string.asLong());
+    }
+
+    /** jackson-databind/4: StringNode("1E+400").asDouble() is Infinity where DecimalNode(1E+400).asDouble() throws. */
+    @Test
+    void pinStringifiedHugeNumberDoesNotOverflowToInfinity() {
+        Assertions.assertThrows(JsonNodeException.class, () -> DecimalNode.valueOf(new BigDecimal("1E+400")).asDouble());
+        Assertions.assertThrows(JsonNodeException.class, () -> StringNode.valueOf("1E+400").asDouble());
+        Assertions.assertThrows(JsonNodeException.class, () -> DoubleNode.valueOf(Double.MAX_VALUE).asFloat());
+        Assertions.assertThrows(JsonNodeException.class, () -> StringNode.valueOf(Double.toString(Double.MAX_VALUE)).asFloat());
+    }
+
+    /** jackson-databind/7: FloatNode(2^31).intValue() is Integer.MAX_VALUE and DoubleNode(2^63).longValue() is Long.MAX_VALUE. */
+    @Test
+    void pinFloatingNodesRefuseTheValueJustPastMaxValue() {
+        FloatNode f = FloatNode.valueOf(2147483648f);
+        Assertions.assertFalse(f.canConvertToInt(), "FloatNode(2^31).canConvertToInt()");
+        Assertions.assertThrows(JsonNodeException.class, f::intValue);
+        Assertions.assertThrows(JsonNodeException.class, f::asInt);
+        DoubleNode d = DoubleNode.valueOf(9223372036854775808.0);
+        Assertions.assertFalse(d.canConvertToLong(), "DoubleNode(2^63).canConvertToLong()");
+        Assertions.assertThrows(JsonNodeException.class, d::longValue);
+        Assertions.assertThrows(JsonNodeException.class, d::asLong);
+    }
+
+    /** jackson-databind/8: FloatNode(1e10f).longValue() throws "value has fractional part". */
+    @Test
+    void pinIntegralFloatBeyondIntRangeConvertsToLong() {
+        FloatNode f = FloatNode.valueOf(1e10f);
+        Assertions.assertFalse(f.hasFractionalPart(), "FloatNode(1e10f).hasFractionalPart()");
+        Assertions.assertTrue(f.canConvertToLong(), "FloatNode(1e10f).canConvertToLong()");
+        Assertions.assertEquals(10_000_000_000L, f.longValue());
+        Assertions.assertEquals(BigInteger.valueOf(10_000_000_000L), f.bigIntegerValue());
+    }
+
+    /** jackson-databind/5: Duration.ofSeconds(Long.MIN_VALUE) as a nanosecond timestamp throws ArithmeticException. */
+    @Test
+    void pinMinimumDurationWritesAsTimestamp() throws Exception {
+        ObjectMapper ts = JsonMapper.builder().enable(DateTimeFeature.WRITE_DURATIONS_AS_TIMESTAMPS).build();
+        Duration min = Duration.ofSeconds(Long.MIN_VALUE);
+        Assertions.assertEquals(min, ts.readValue("-9223372036854775808.000000000", Duration.class));
+        String text = Assertions.assertDoesNotThrow(() -> ts.writeValueAsString(min));
+        Assertions.assertEquals("-9223372036854775808.000000000", text);
+        Assertions.assertEquals(min, ts.readValue(text, Duration.class));
+    }
+
+    /** jackson-databind/6: a YearMonth key of year 10000 is written as "10000-12", which the key deserializer rejects. */
+    @Test
+    void pinYearMonthKeyWithFiveDigitYearRoundTrips() throws Exception {
+        JavaType type = M.getTypeFactory().constructMapType(LinkedHashMap.class, YearMonth.class, String.class);
+        Map<YearMonth, String> map = new LinkedHashMap<>();
+        map.put(YearMonth.of(10000, 12), "x");
+        String text = M.writer().forType(type).writeValueAsString(map);
+        Assertions.assertEquals(YearMonth.of(10000, 12), M.readValue(M.writeValueAsString(YearMonth.of(10000, 12)), YearMonth.class));
+        Assertions.assertEquals(map, M.readValue(text, type));
+    }
+}
