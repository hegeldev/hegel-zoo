+
+    /** Numeric leaves have the same node types (equals is type-sensitive for numbers, by design). */
+    static boolean sameNumberTypes(JsonNode a, JsonNode b) {
+        if (a.isNumber() || b.isNumber()) {
+            return a.getClass() == b.getClass();
+        }
+        if (a.isObject() && b.isObject()) {
+            if (a.size() != b.size()) {
+                return false;
+            }
+            for (Map.Entry<String, JsonNode> e : a.properties()) {
+                JsonNode o = b.get(e.getKey());
+                if (o == null || !sameNumberTypes(e.getValue(), o)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a.isArray() && b.isArray()) {
+            if (a.size() != b.size()) {
+                return false;
+            }
+            for (int i = 0; i < a.size(); i++) {
+                if (!sameNumberTypes(a.get(i), b.get(i))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        return true;
+    }
+
+    // ------------------------------------------------------------------ 3. ObjectNode as a map
+
+    static final String[] KEYS = {"a", "b", "c", "", "a/b", "~", "0", "1", "-", "é", "x y"};
+
+    static String key(TestCase tc) {
+        return pick(tc, KEYS);
+    }
+
+    /** A random scalar or small container node. */
+    static JsonNode leaf(TestCase tc) {
+        switch (n(tc, 0, 9)) {
+            case 0: return F.nullNode();
+            case 1: return F.booleanNode(chance(tc, 50));
+            case 2: return F.numberNode(n(tc, -5, 5));
+            case 3: return F.numberNode(n(tc, -5, 5) * 1.5);
+            case 4: return F.stringNode(Zoo.word(tc, "ab ", 0, 3));
+            case 5: return F.objectNode();
+            case 6: return F.arrayNode().add(1);
+            case 7: return F.numberNode(BigDecimal.valueOf(n(tc, 0, 9), 1));
+            case 8: return F.numberNode(1L << 40);
+            default: return F.objectNode().put("k", n(tc, 0, 3));
+        }
+    }
+
+    static String showMap(Map<String, JsonNode> m) {
+        return MAPPER.writeValueAsString(m);
+    }
+
+    @Test
+    void objectNodeFollowsAMapModel() {
+        Zoo.run("objectNodeFollowsAMapModel", tc -> {
+            ObjectNode node = F.objectNode();
+            Map<String, JsonNode> model = new LinkedHashMap<>();
+            int steps = n(tc, 1, 14);
+            for (int step = 0; step < steps; step++) {
+                String k = key(tc);
+                JsonNode x = leaf(tc);
+                String op;
+                switch (n(tc, 0, 17)) {
+                    case 0 -> {
+                        op = "put(int)";
+                        int i = n(tc, -3, 3);
