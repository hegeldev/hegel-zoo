+                            case 1 -> { node.put(k, 2.5); model.put(k, F.numberNode(2.5)); }
+                            case 2 -> { node.put(k, true); model.put(k, F.booleanNode(true)); }
+                            case 3 -> { node.put(k, new BigDecimal("1.50")); model.put(k, F.numberNode(new BigDecimal("1.50"))); }
+                            case 4 -> { node.put(k, BigInteger.TEN); model.put(k, F.numberNode(BigInteger.TEN)); }
+                            default -> { node.put(k, new byte[] {1, 2}); model.put(k, F.binaryNode(new byte[] {1, 2})); }
+                        }
+                    }
+                }
+                final String opName = op;
+                // the whole node equals the model, in order
+                List<Map.Entry<String, JsonNode>> got = new ArrayList<>(node.properties());
+                List<Map.Entry<String, JsonNode>> want = new ArrayList<>(model.entrySet());
+                check(got.equals(want), () -> "after " + opName + ": properties " + showMap(node.properties().stream().collect(LinkedHashMap::new, (m, e) -> m.put(e.getKey(), e.getValue()), Map::putAll)) + " expected " + showMap(model));
+                check(node.size() == model.size() && node.isEmpty() == model.isEmpty(), () -> "after " + opName + ": size " + node.size() + " expected " + model.size());
+                check(new ArrayList<>(node.propertyNames()).equals(new ArrayList<>(model.keySet())), () -> "after " + opName + ": propertyNames " + node.propertyNames() + " expected " + model.keySet());
+                check(new ArrayList<>(node.values()).equals(new ArrayList<>(model.values())), () -> "after " + opName + ": values " + node.values() + " expected " + model.values());
