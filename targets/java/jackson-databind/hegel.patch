+    @Test
+    void valuesRoundTripThroughJsonAndTrees() {
+        Zoo.run("valuesRoundTripThroughJsonAndTrees", tc -> {
+            Object v;
+            Class<?> type;
+            switch (n(tc, 0, 3)) {
+                case 0 -> { v = point(tc); type = Point.class; }
+                case 1 -> { v = bag(tc); type = Bag.class; }
+                case 2 -> { v = shape(tc); type = Shape.class; }
+                default -> { v = nested(tc, 2); type = Nested.class; }
+            }
+            count(type.getSimpleName());
+            String text = text(MAPPER, v);
+            Object back = MAPPER.readValue(text, type);
+            check(sameTree(MAPPER, v, back), () -> "readValue(writeValueAsString(v)) differs for " + text + ": " + text(MAPPER, back));
+            String again = text(MAPPER, back);
+            check(again.equals(text), () -> "writing the read value back gives " + again + " for " + text);
+            if (type != Bag.class && type != Nested.class) {
+                check(v.equals(back), () -> "readValue(writeValueAsString(v)) is not equal to v: " + text + " -> " + back);
+            }
+            // through the tree
+            JsonNode tree = MAPPER.valueToTree(v);
+            check(text(MAPPER, tree).equals(text), () -> "valueToTree(v) writes as " + text(MAPPER, tree) + " but v as " + text);
+            Object viaTree = MAPPER.treeToValue(tree, type);
+            check(text(MAPPER, viaTree).equals(text), () -> "treeToValue(valueToTree(v)) writes as " + text(MAPPER, viaTree) + " for " + text);
+            Object converted = MAPPER.convertValue(v, type);
+            check(text(MAPPER, converted).equals(text), () -> "convertValue(v, same type) writes as " + text(MAPPER, converted) + " for " + text);
+            // (convertValue goes through a TokenBuffer, which keeps BigDecimal scales and byte[]s the text cannot)
+            Object asMap = MAPPER.convertValue(v, Object.class);
+            check(text(MAPPER, asMap).equals(text), () -> "convertValue(v, Object) writes as " + text(MAPPER, asMap) + " but v as " + text);
+            // every source reads the same
+            String src = pick(tc, SRCS);
+            if (!TreesTest.loneSurrogate(text)) {
+                Object viaSrc = readFrom(MAPPER, src, text, MAPPER.constructType(type), tc);
+                check(text(MAPPER, viaSrc).equals(text), () -> "readValue via " + src + " gives " + text(MAPPER, viaSrc) + " for " + text);
+            }
+            // bytes are the UTF-8 of the string
+            if (!TreesTest.loneSurrogate(text)) {
+                check(Arrays.equals(MAPPER.writeValueAsBytes(v), text.getBytes(StandardCharsets.UTF_8)), () -> "writeValueAsBytes differs from the UTF-8 of writeValueAsString for " + text);
+            }
+            // pretty output is the same document
+            String pretty = MAPPER.writerWithDefaultPrettyPrinter().writeValueAsString(v);
+            check(MAPPER.readTree(pretty).equals(MAPPER.readTree(text)), () -> "pretty output " + show(pretty) + " reads as another tree than " + text);
+        });
+    }
