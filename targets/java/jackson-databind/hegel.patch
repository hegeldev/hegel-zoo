+                count(refOk ? "mutation still valid" : "mutation rejected");
+            }
+        });
+    }
+
+    static void checkStripped(JsonNode node) {
+        if (node.isBigDecimal()) {
+            BigDecimal d = node.decimalValue();
+            check(d.signum() == 0 || d.stripTrailingZeros().scale() == d.scale(), () -> "STRIP_TRAILING_BIGDECIMAL_ZEROES kept " + d);
+        }
+        for (JsonNode c : node) {
+            checkStripped(c);
+        }
+    }
+
+    // ------------------------------------------------------------------ 2. equality
+
+    @Test
+    void treesAreEqualWhenTheirValuesAre() {
+        Zoo.run("treesAreEqualWhenTheirValuesAre", tc -> {
+            Object v = Ref.gen(tc, 4);
+            if (Model.awkward(v, false)) {
+                return;
+            }
+            String text = Ref.write(v, Ref.PLAIN);
+            JsonNode a = MAPPER.readTree(text);
+            JsonNode b = Model.toNode(v, F, false);
+            JsonNode c = a.deepCopy();
+            JsonNode d = MAPPER.valueToTree(Model.toJava(v, false));
+            JsonNode e = MAPPER.convertValue(Model.toJava(v, false), JsonNode.class);
+            check(a.equals(b) && b.equals(a), () -> "readTree and the built tree differ: " + Model.show(a) + " vs " + Model.show(b));
+            check(a.equals(c) && a.hashCode() == c.hashCode(), () -> "deepCopy differs: " + Model.show(c));
+            check(a.equals(d), () -> "valueToTree(" + show(Model.toJava(v, false)) + ") = " + Model.show(d) + " but readTree " + Model.show(a));
+            check(d.equals(e), () -> "convertValue to JsonNode = " + Model.show(e) + " but valueToTree " + Model.show(d));
+            check(a.size() == (v instanceof Map<?, ?> m ? m.size() : v instanceof List<?> l ? l.size() : 0), () -> "size() of " + Model.show(a) + " is " + a.size());
+            check(a.isEmpty() == (a.size() == 0), () -> "isEmpty() disagrees with size() for " + Model.show(a));
