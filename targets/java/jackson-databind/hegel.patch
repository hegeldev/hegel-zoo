+                    }
+                    case 6 -> {
+                        op = "setNull(" + i + ")";
+                        String err = thrown(() -> node.setNull(i));
+                        boolean inRange = i >= 0 && i < model.size();
+                        check((err == null) == inRange, () -> "setNull(" + i + ") on size " + model.size() + (err == null ? " succeeded" : " threw " + err));
+                        if (inRange) {
+                            model.set(i, F.nullNode());
