+    static <T> T readFrom(ObjectMapper m, String src, String text, JavaType type, TestCase tc) {
+        byte[] bytes = text.getBytes(StandardCharsets.UTF_8);
+        return switch (src) {
+            case "bytes" -> m.readValue(bytes, type);
+            case "reader" -> m.readValue(new StringReader(text), type);
+            case "stream" -> m.readValue(new ByteArrayInputStream(bytes), type);
+            case "dataInput" -> m.readValue((DataInput) new DataInputStream(new ByteArrayInputStream(bytes)), type);
+            case "range" -> {
+                int pre = n(tc, 0, 3);
+                byte[] padded = new byte[pre + bytes.length + 2];
+                Arrays.fill(padded, (byte) '!');
+                System.arraycopy(bytes, 0, padded, pre, bytes.length);
+                yield m.readValue(padded, pre, bytes.length, type);
+            }
+            default -> m.readValue(text, type);
+        };
+    }
