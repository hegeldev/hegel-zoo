+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel zoo: property-based tests for jackson-databind against the library built from this checkout
+     (`mvn -DskipTests install` at the root first; see targets/java/jackson-databind in the zoo). -->
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>jackson-databind-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <jackson.version>3.3.0-SNAPSHOT</jackson.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>tools.jackson.core</groupId>
+      <artifactId>jackson-databind</artifactId>
+      <version>${jackson.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
+          <trimStackTrace>false</trimStackTrace>
+          <!-- every test's `ZOO …` line is what the zoo judges; Maven's exit code is not -->
+          <testFailureIgnore>true</testFailureIgnore>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/CoercionsTest.java b/hegel/src/test/java/zoo/CoercionsTest.java
new file mode 100644
index 0000000..bb62e0e
--- /dev/null
+++ b/hegel/src/test/java/zoo/CoercionsTest.java
@@ -0,0 +1,519 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.count;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.show;
+
+import dev.hegel.TestCase;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.OptionalDouble;
+import java.util.OptionalInt;
+import java.util.OptionalLong;
+import java.util.function.Function;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.node.JsonNodeFactory;
+
+/**
+ * Hegel zoo: the JsonNode value accessors and coercions ({@code xValue()}, {@code asX()}, their
+ * {@code Opt} and default-value variants, {@code canConvertTo*}) against their Javadoc and against
+ * each other across the node types that hold the same number.
+ */
+class CoercionsTest {
+
+    static final JsonNodeFactory F = JsonNodeFactory.instance;
+
+    /** A result: the value, or the exception's class name. */
+    static Object run(Function<JsonNode, Object> f, JsonNode node) {
+        try {
+            return f.apply(node);
+        } catch (RuntimeException e) {
+            return "threw " + e.getClass().getSimpleName();
+        }
+    }
+
+    static boolean threw(Object r) {
+        return r instanceof String s && s.startsWith("threw ");
+    }
+
+    static final Map<String, Function<JsonNode, Object>> VALUE = new LinkedHashMap<>();
+    static final Map<String, Function<JsonNode, Object>> AS = new LinkedHashMap<>();
+    static final Map<String, Function<JsonNode, Object>> VALUE_OPT = new LinkedHashMap<>();
+    static final Map<String, Function<JsonNode, Object>> AS_OPT = new LinkedHashMap<>();
+    static final Map<String, Function<JsonNode, Object>> AS_DEFAULT = new LinkedHashMap<>();
+    static final Map<String, Object> DEFAULTS = new LinkedHashMap<>();
+
+    static {
+        VALUE.put("int", JsonNode::intValue);
+        VALUE.put("long", JsonNode::longValue);
+        VALUE.put("short", JsonNode::shortValue);
+        VALUE.put("double", JsonNode::doubleValue);
+        VALUE.put("float", JsonNode::floatValue);
+        VALUE.put("decimal", JsonNode::decimalValue);
+        VALUE.put("bigInteger", JsonNode::bigIntegerValue);
+        VALUE.put("boolean", JsonNode::booleanValue);
+        VALUE.put("string", JsonNode::stringValue);
+        VALUE_OPT.put("int", JsonNode::intValueOpt);
+        VALUE_OPT.put("long", JsonNode::longValueOpt);
+        VALUE_OPT.put("short", JsonNode::shortValueOpt);
+        VALUE_OPT.put("double", JsonNode::doubleValueOpt);
+        VALUE_OPT.put("float", JsonNode::floatValueOpt);
+        VALUE_OPT.put("decimal", JsonNode::decimalValueOpt);
+        VALUE_OPT.put("bigInteger", JsonNode::bigIntegerValueOpt);
+        VALUE_OPT.put("boolean", JsonNode::booleanValueOpt);
+        VALUE_OPT.put("string", JsonNode::stringValueOpt);
+        AS.put("int", JsonNode::asInt);
+        AS.put("long", JsonNode::asLong);
+        AS.put("short", JsonNode::asShort);
+        AS.put("double", JsonNode::asDouble);
+        AS.put("float", JsonNode::asFloat);
+        AS.put("decimal", JsonNode::asDecimal);
+        AS.put("bigInteger", JsonNode::asBigInteger);
+        AS.put("boolean", JsonNode::asBoolean);
+        AS.put("string", JsonNode::asString);
+        AS_OPT.put("int", JsonNode::asIntOpt);
+        AS_OPT.put("long", JsonNode::asLongOpt);
+        AS_OPT.put("short", JsonNode::asShortOpt);
+        AS_OPT.put("double", JsonNode::asDoubleOpt);
+        AS_OPT.put("float", JsonNode::asFloatOpt);
+        AS_OPT.put("decimal", JsonNode::asDecimalOpt);
+        AS_OPT.put("bigInteger", JsonNode::asBigIntegerOpt);
+        AS_OPT.put("boolean", JsonNode::asBooleanOpt);
+        AS_OPT.put("string", JsonNode::asStringOpt);
+        DEFAULTS.put("int", -77);
+        DEFAULTS.put("long", -77L);
+        DEFAULTS.put("short", (short) -77);
+        DEFAULTS.put("double", -77.5);
+        DEFAULTS.put("float", -77.5f);
+        DEFAULTS.put("decimal", new BigDecimal("-77.5"));
+        DEFAULTS.put("bigInteger", BigInteger.valueOf(-77));
+        DEFAULTS.put("boolean", Boolean.TRUE);
+        DEFAULTS.put("string", "dflt");
+        AS_DEFAULT.put("int", x -> x.asInt(-77));
+        AS_DEFAULT.put("long", x -> x.asLong(-77L));
+        AS_DEFAULT.put("short", x -> x.asShort((short) -77));
+        AS_DEFAULT.put("double", x -> x.asDouble(-77.5));
+        AS_DEFAULT.put("float", x -> x.asFloat(-77.5f));
+        AS_DEFAULT.put("decimal", x -> x.asDecimal(new BigDecimal("-77.5")));
+        AS_DEFAULT.put("bigInteger", x -> x.asBigInteger(BigInteger.valueOf(-77)));
+        AS_DEFAULT.put("boolean", x -> x.asBoolean(true));
+        AS_DEFAULT.put("string", x -> x.asString("dflt"));
+    }
+
+    /** Whether an Optional-like holds a value, and that value. */
+    static boolean present(Object o) {
+        if (o instanceof Optional<?> x) return x.isPresent();
+        if (o instanceof OptionalInt x) return x.isPresent();
+        if (o instanceof OptionalLong x) return x.isPresent();
+        if (o instanceof OptionalDouble x) return x.isPresent();
+        throw new IllegalStateException("not an optional: " + o);
+    }
+
+    static Object held(Object o) {
+        if (o instanceof Optional<?> x) return x.get();
+        if (o instanceof OptionalInt x) return x.getAsInt();
+        if (o instanceof OptionalLong x) return x.getAsLong();
+        return ((OptionalDouble) o).getAsDouble();
+    }
+
+    static boolean sameResult(Object a, Object b) {
+        if (a instanceof Double x && b instanceof Double y) return x.doubleValue() == y.doubleValue() || x.isNaN() && y.isNaN(); // -0.0 has no BigDecimal
+        if (a instanceof Float x && b instanceof Float y) return x.floatValue() == y.floatValue() || x.isNaN() && y.isNaN();
+        if (a instanceof BigDecimal x && b instanceof BigDecimal y) return x.compareTo(y) == 0;
+        return a == null ? b == null : a.equals(b);
+    }
+
+    // ------------------------------------------------------------------ values and their nodes
+
+    static final String[] DECIMALS = {
+        "0", "1", "-1", "7", "-0", "0.0", "-0.0", "1.5", "-1.5", "0.1", "2.5", "3.0", "-3.0", "100", "1e2", "1E+2", "0.000", "1.50",
+        "32767", "32768", "-32768", "-32769", "2147483647", "2147483648", "-2147483648", "-2147483649",
+        "9223372036854775807", "9223372036854775808", "-9223372036854775808", "-9223372036854775809",
+        "9007199254740993", "1e10", "1e19", "1e20", "1e300", "1e-300", "123456789012345678901234567890",
+        "123456789012345678901234567890.5", "0.5", "-0.5", "1.9999999", "2147483647.5", "-2147483648.5",
+        "16777217", "3.4028235E38", "1.7976931348623157E308", "4.9E-324", "1e-400", "1e400",
+    };
+
+    /** The number nodes holding exactly the decimal x (only those whose type can represent it). */
+    static List<JsonNode> nodesFor(BigDecimal x) {
+        List<JsonNode> out = new ArrayList<>();
+        BigInteger integral = null;
+        try {
+            integral = x.toBigIntegerExact();
+        } catch (ArithmeticException e) {
+            // fractional
+        }
+        if (integral != null) {
+            if (integral.bitLength() < 16) {
+                out.add(F.numberNode(integral.shortValue()));
+            }
+            if (integral.bitLength() < 32) {
+                out.add(F.numberNode(integral.intValue()));
+            }
+            if (integral.bitLength() < 64) {
+                out.add(F.numberNode(integral.longValue()));
+            }
+            out.add(F.numberNode(integral));
+        }
+        double d = x.doubleValue();
+        if (!Double.isInfinite(d) && new BigDecimal(d).compareTo(x) == 0) {
+            out.add(F.numberNode(d));
+        }
+        float f = x.floatValue();
+        if (!Float.isInfinite(f) && new BigDecimal(f).compareTo(x) == 0) {
+            out.add(F.numberNode(f));
+        }
+        out.add(F.numberNode(x));
+        out.add(F.numberNode(x.setScale(x.scale() + 2)));
+        return out;
+    }
+
+    static BigDecimal exactOf(JsonNode node) {
+        if (node.isDouble()) {
+            return new BigDecimal(node.doubleValue());
+        }
+        if (node.isFloat()) {
+            return new BigDecimal(node.floatValue());
+        }
+        if (node.isBigDecimal()) {
+            return node.decimalValue();
+        }
+        return new BigDecimal(node.bigIntegerValue());
+    }
+
+    static boolean fitsInt(BigDecimal x) {
+        return x.compareTo(BigDecimal.valueOf(Integer.MIN_VALUE)) >= 0 && x.compareTo(BigDecimal.valueOf(Integer.MAX_VALUE)) <= 0;
+    }
+
+    static boolean fitsLong(BigDecimal x) {
+        return x.compareTo(BigDecimal.valueOf(Long.MIN_VALUE)) >= 0 && x.compareTo(BigDecimal.valueOf(Long.MAX_VALUE)) <= 0;
+    }
+
+    static boolean fitsShort(BigDecimal x) {
+        return x.compareTo(BigDecimal.valueOf(Short.MIN_VALUE)) >= 0 && x.compareTo(BigDecimal.valueOf(Short.MAX_VALUE)) <= 0;
+    }
+
+    static boolean isIntegral(BigDecimal x) {
+        return x.signum() == 0 || x.stripTrailingZeros().scale() <= 0;
+    }
+
+    static final BigDecimal TWO_31 = new BigDecimal("2147483648");
+    static final BigDecimal TWO_63 = new BigDecimal("9223372036854775808");
+
+    /** The known bug that makes a Float/Double node of x unusable for the integral accessors, or null. */
+    static String knownNode(JsonNode node, BigDecimal x, boolean integral) {
+        boolean fp = node.isFloat() || node.isDouble();
+        if (node.isFloat() && x.compareTo(TWO_31) == 0 || fp && x.compareTo(TWO_63) == 0) {
+            // jackson-databind/7: inIntRange/inLongRange compare against MAX_VALUE rounded up to a float/double
+            return "known jackson-databind/7";
+        }
+        if (node.isFloat() && integral && !fitsInt(x)) {
+            // jackson-databind/8: FloatNode.hasFractionalPart() rounds through Math.round(float), an int
+            return "known jackson-databind/8";
+        }
+        return null;
+    }
+
+    static BigDecimal big(Object o) {
+        return o instanceof BigInteger b ? new BigDecimal(b) : o instanceof String s ? new BigDecimal(s) : (BigDecimal) o;
+    }
+
+    /** A Float/Double node's decimal, big integer or string is its shortest representation, not its exact value: the same float/double. */
+    static boolean near(JsonNode node, Object got, Object want) {
+        return node.isFloat() ? big(got).floatValue() == big(want).floatValue() : big(got).doubleValue() == big(want).doubleValue();
+    }
+
+    // ------------------------------------------------------------------ 1. number nodes
+
+    @Test
+    void numberNodesCoerceAsDocumented() {
+        Zoo.run("numberNodesCoerceAsDocumented", tc -> {
+            BigDecimal x;
+            if (chance(tc, 70)) {
+                String text = pick(tc, DECIMALS);
+                if (text.equals("1e-400") || text.equals("1e400")) {
+                    x = new BigDecimal(text);
+                } else {
+                    x = new BigDecimal(text);
+                }
+            } else {
+                x = BigDecimal.valueOf(n(tc, -100000, 100000), n(tc, -3, 6));
+            }
+            List<JsonNode> nodes = nodesFor(x);
+            boolean integral = isIntegral(x);
+            // each node against the documented rules
+            for (JsonNode node : nodes) {
+                String kind = node.getClass().getSimpleName();
+                count(kind);
+                String known = knownNode(node, x, integral);
+                if (known != null) {
+                    count(known);
+                    continue;
+                }
+                // a Float/Double node's decimal is its shortest representation (BigDecimal.valueOf), not its exact value
+                boolean fp = node.isFloat() || node.isDouble();
+                check(node.isNumber() && !node.isString() && !node.isNull(), () -> kind + " is not a number node");
+                check(node.isIntegralNumber() != node.isFloatingPointNumber(), () -> kind + " is both or neither integral and floating point");
+                check(node.numberValue() != null && new BigDecimal(node.numberValue().toString()).compareTo(x) == 0 || node.isDouble() || node.isFloat(), () -> kind + ".numberValue() = " + node.numberValue() + " for " + x);
+                // exact accessors: value or exception, exactly as the doc says
+                Object iv = run(VALUE.get("int"), node);
+                check(threw(iv) == !(fitsInt(x) && integral), () -> kind + "(" + x + ").intValue() = " + iv);
+                if (!threw(iv)) check(((Integer) iv).intValue() == x.intValueExact(), () -> kind + "(" + x + ").intValue() = " + iv);
+                Object lv = run(VALUE.get("long"), node);
+                check(threw(lv) == !(fitsLong(x) && integral), () -> kind + "(" + x + ").longValue() = " + lv);
+                Object sv = run(VALUE.get("short"), node);
+                check(threw(sv) == !(fitsShort(x) && integral), () -> kind + "(" + x + ").shortValue() = " + sv);
+                Object bv = run(VALUE.get("bigInteger"), node);
+                check(threw(bv) == !integral, () -> kind + "(" + x + ").bigIntegerValue() = " + bv);
+                if (!threw(bv)) check(new BigDecimal((BigInteger) bv).compareTo(x) == 0 || fp && near(node, bv, x), () -> kind + "(" + x + ").bigIntegerValue() = " + bv);
+                Object dv = run(VALUE.get("decimal"), node);
+                check(!threw(dv) && (((BigDecimal) dv).compareTo(x) == 0 || fp && near(node, dv, x)), () -> kind + "(" + x + ").decimalValue() = " + dv);
+                Object dbl = run(VALUE.get("double"), node);
+                boolean hugeDouble = Double.isInfinite(x.doubleValue());
+                check(hugeDouble ? threw(dbl) : !threw(dbl) && (Double) dbl == x.doubleValue(), () -> kind + "(" + x + ").doubleValue() = " + dbl + " expected " + x.doubleValue());
+                Object flt = run(VALUE.get("float"), node);
+                if (!threw(flt) && (Float) flt != x.floatValue()) {
+                    count("floatValue differs from BigDecimal.floatValue: " + kind);
+                }
+                check(node.canConvertToInt() == !threw(iv), () -> kind + "(" + x + ").canConvertToInt() = " + node.canConvertToInt() + " but intValue() " + iv);
+                check(node.canConvertToLong() == !threw(lv), () -> kind + "(" + x + ").canConvertToLong() = " + node.canConvertToLong() + " but longValue() " + lv);
+                check(node.canConvertToShort() == !threw(sv), () -> kind + "(" + x + ").canConvertToShort() = " + node.canConvertToShort() + " but shortValue() " + sv);
+                check(node.canConvertToExactIntegral() == integral, () -> kind + "(" + x + ").canConvertToExactIntegral() = " + node.canConvertToExactIntegral());
+                // lenient accessors: truncation when the value itself is in range (2147483647.5 is not)
+                BigInteger trunc = x.toBigInteger();
+                Object ai = run(AS.get("int"), node);
+                check(threw(ai) == !fitsInt(x), () -> kind + "(" + x + ").asInt() = " + ai);
+                if (!threw(ai)) check(((Integer) ai).intValue() == trunc.intValue(), () -> kind + "(" + x + ").asInt() = " + ai + " expected " + trunc);
+                Object al = run(AS.get("long"), node);
+                check(threw(al) == !fitsLong(x), () -> kind + "(" + x + ").asLong() = " + al);
+                if (!threw(al)) check(((Long) al).longValue() == trunc.longValue(), () -> kind + "(" + x + ").asLong() = " + al + " expected " + trunc);
+                Object as = run(AS.get("short"), node);
+                check(threw(as) == !fitsShort(x), () -> kind + "(" + x + ").asShort() = " + as);
+                Object ab = run(AS.get("bigInteger"), node);
+                check(!threw(ab) && (ab.equals(trunc) || fp && near(node, ab, new BigDecimal(trunc))), () -> kind + "(" + x + ").asBigInteger() = " + ab + " expected " + trunc);
+                Object ad = run(AS.get("decimal"), node);
+                check(!threw(ad) && (((BigDecimal) ad).compareTo(x) == 0 || fp && near(node, ad, x)), () -> kind + "(" + x + ").asDecimal() = " + ad);
+                Object add = run(AS.get("double"), node);
+                check(hugeDouble ? threw(add) : !threw(add) && (Double) add == x.doubleValue(), () -> kind + "(" + x + ").asDouble() = " + add);
+                Object astr = run(AS.get("string"), node);
+                check(!threw(astr) && (new BigDecimal((String) astr).compareTo(x) == 0 || fp && near(node, astr, x)), () -> kind + "(" + x + ").asString() = " + astr);
+                check(run(VALUE.get("string"), node) instanceof String s && s.startsWith("threw "), () -> kind + ".stringValue() did not throw");
+                check(run(VALUE.get("boolean"), node) instanceof String s && s.startsWith("threw "), () -> kind + ".booleanValue() did not throw");
+                Object abool = run(AS.get("boolean"), node);
+                if (node.isIntegralNumber()) {
+                    check(abool.equals(x.signum() != 0), () -> kind + "(" + x + ").asBoolean() = " + abool);
+                } else {
+                    // the doc speaks of integer numbers only: floating-point node types are unspecified
+                    count("asBoolean of a " + kind + (integral ? " (integral value)" : " (fraction)") + ": " + (threw(abool) ? "throws" : abool));
+                }
+                // Opt and default variants agree with the throwing ones
+                optsAgree(node, kind, x);
+            }
+            // the nodes of one value agree with each other on every accessor
+            JsonNode base = nodes.get(nodes.size() - 2); // the DecimalNode with x's own scale
+            for (JsonNode node : nodes) {
+                String kind = node.getClass().getSimpleName();
+                if (knownNode(node, x, integral) != null) {
+                    continue;
+                }
+                boolean fp = node.isFloat() || node.isDouble();
+                for (Map.Entry<String, Function<JsonNode, Object>> e : AS.entrySet()) {
+                    if (e.getKey().equals("string")) {
+                        continue;
+                    }
+                    Object a = run(e.getValue(), node);
+                    Object b = run(e.getValue(), base);
+                    if (threw(a) != threw(b) || !threw(a) && !sameResult(a, b)) {
+                        if ((e.getKey().equals("bigInteger") || e.getKey().equals("decimal")) && fp && !threw(a) && !threw(b) && near(node, a, b)) {
+                            count("shortest-representation decimal of a " + kind);
+                        } else if (e.getKey().equals("boolean") && (!node.isIntegralNumber() || !base.isIntegralNumber())) {
+                            count("asBoolean differs between " + kind + " and DecimalNode");
+                        } else if (e.getKey().equals("float") && !threw(a) && !threw(b)) {
+                            count("asFloat differs between " + kind + " and DecimalNode");
+                        } else {
+                            Zoo.fail(kind + "(" + x + ").as" + e.getKey() + "() = " + a + " but DecimalNode(" + x + ") gives " + b);
+                        }
+                    }
+                }
+                for (String k : List.of("int", "long", "short", "bigInteger")) {
+                    Object a = run(VALUE.get(k), node);
+                    Object b = run(VALUE.get(k), base);
+                    check(threw(a) == threw(b) && (threw(a) || sameResult(a, b) || k.equals("bigInteger") && fp && near(node, a, b)), () -> kind + "(" + x + ")." + k + "Value() = " + a + " but DecimalNode gives " + b);
+                }
+            }
+            // a JSON String holding the number coerces like the number (asX), never like a value (xValue)
+            JsonNode str = F.stringNode(pick(tc, x.toString(), x.toPlainString()));
+            for (Map.Entry<String, Function<JsonNode, Object>> e : AS.entrySet()) {
+                if (e.getKey().equals("string") || e.getKey().equals("boolean")) {
+                    continue;
+                }
+                Object a = run(e.getValue(), str);
+                Object b = run(e.getValue(), base);
+                boolean integralAccessor = List.of("int", "long", "short", "bigInteger").contains(e.getKey());
+                boolean floatAccessor = e.getKey().equals("double") || e.getKey().equals("float");
+                if (floatAccessor && threw(b) && !threw(a) && (a instanceof Double d && d.isInfinite() || a instanceof Float f && f.isInfinite())) {
+                    // jackson-databind/4: the stringified number overflows to Infinity where the number node refuses
+                    count("known jackson-databind/4");
+                    continue;
+                }
+                if (integralAccessor && !isIntegral(x) && threw(a) && !threw(b)) {
+                    // jackson-databind/3: a stringified number with a fraction is not truncated like the number
+                    count("known jackson-databind/3");
+                    continue;
+                }
+                if (integralAccessor && integral && !isPlainInteger(str.stringValue()) && threw(a) && !threw(b)) {
+                    // jackson-databind/3 as well: an integral value spelled with a fraction or exponent ("9.3E+4", "100.0")
+                    count("known jackson-databind/3");
+                    continue;
+                }
+                check(threw(a) == threw(b) && (threw(a) || sameResult(a, b)), () -> "StringNode(" + show(str.stringValue()) + ").as" + e.getKey() + "() = " + a + " but DecimalNode(" + x + ") gives " + b);
+            }
+            for (String k : List.of("int", "long", "short", "double", "float", "decimal", "bigInteger")) {
+                check(threw(run(VALUE.get(k), str)), () -> "StringNode(" + show(str.stringValue()) + ")." + k + "Value() did not throw");
+                check(!str.canConvertToInt() && !str.canConvertToLong() && !str.canConvertToExactIntegral(), "canConvertTo* is true for a StringNode");
+            }
+            optsAgree(str, "StringNode", x);
+        });
+    }
+
+    /**
+     * The Opt and default variants agree with the throwing accessors: empty/default exactly when the
+     * accessor throws - or, as documented, when the node is null or missing (asX() coerces those to
+     * zero, "" or false; xValue() of a JSON null is a Java null for stringValue()).
+     */
+    static void optsAgree(JsonNode node, String kind, Object shown) {
+        boolean nullish = node.isNull() || node.isMissingNode();
+        for (String k : VALUE.keySet()) {
+            Object v = run(VALUE.get(k), node);
+            Object o = run(VALUE_OPT.get(k), node);
+            check(!threw(o), () -> kind + "(" + shown + ")." + k + "ValueOpt() threw: " + o);
+            if (!threw(o)) {
+                boolean want = !threw(v) && v != null;
+                check(present(o) == want && (!want || sameResult(held(o), v)), () -> kind + "(" + shown + ")." + k + "ValueOpt() = " + o + " but " + k + "Value() " + v);
+            }
+            Object a = run(AS.get(k), node);
+            Object ao = run(AS_OPT.get(k), node);
+            check(!threw(ao), () -> kind + "(" + shown + ").as" + k + "Opt() threw: " + ao);
+            if (!threw(ao)) {
+                boolean want = !threw(a) && !nullish;
+                check(present(ao) == want && (!want || sameResult(held(ao), a)), () -> kind + "(" + shown + ").as" + k + "Opt() = " + ao + " but as" + k + "() " + a);
+            }
+            Object ad = run(AS_DEFAULT.get(k), node);
+            check(!threw(ad), () -> kind + "(" + shown + ").as" + k + "(default) threw: " + ad);
+            if (!threw(ad)) {
+                Object want = threw(a) || nullish ? DEFAULTS.get(k) : a;
+                check(sameResult(ad, want), () -> kind + "(" + shown + ").as" + k + "(default) = " + ad + " but as" + k + "() " + a);
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------ 2. the other node types
+
+    @Test
+    void otherNodesCoerceAsDocumented() {
+        Zoo.run("otherNodesCoerceAsDocumented", tc -> {
+            String which = pick(tc, "null", "missing", "true", "false", "string", "numeric-string", "binary", "object", "array", "pojo");
+            String s = pick(tc, "", " ", "true", "false", "TRUE", "abc", "12", " 12", "12 ", "+12", "1.5", "1e2", "-0", "0x10", "NaN", "Infinity", "-", "1_000", "12abc", "١٢");
+            JsonNode node = switch (which) {
+                case "null" -> F.nullNode();
+                case "missing" -> F.missingNode();
+                case "true" -> F.booleanNode(true);
+                case "false" -> F.booleanNode(false);
+                case "string", "numeric-string" -> F.stringNode(s);
+                case "binary" -> F.binaryNode(new byte[] {1, 2, 3});
+                case "object" -> F.objectNode().put("a", 1);
+                case "array" -> F.arrayNode().add(1);
+                default -> F.pojoNode(n(tc, -3, 3));
+            };
+            String kind = which + (which.contains("string") ? "(" + show(s) + ")" : "");
+            optsAgree(node, kind, "");
+            boolean nullish = node.isNull() || node.isMissingNode();
+            boolean container = node.isContainer();
+            // strings: asString is the string; null/missing: ""; booleans/numbers: their text; containers throw
+            Object astr = run(AS.get("string"), node);
+            if (node.isString()) {
+                check(s.equals(astr), () -> kind + ".asString() = " + astr);
+                check(s.equals(run(VALUE.get("string"), node)), () -> kind + ".stringValue() = " + run(VALUE.get("string"), node));
+            } else if (nullish) {
+                check("".equals(astr), () -> kind + ".asString() = " + astr);
+                check(node.isNull() ? run(VALUE.get("string"), node) == null : threw(run(VALUE.get("string"), node)), () -> kind + ".stringValue() = " + run(VALUE.get("string"), node));
+            } else if (node.isBoolean()) {
+                check(String.valueOf(node.booleanValue()).equals(astr), () -> kind + ".asString() = " + astr);
+            } else if (container) {
+                check(threw(astr), () -> kind + ".asString() = " + astr);
+            } else {
+                count("asString of " + which + ": " + (threw(astr) ? astr : "ok"));
+            }
+            // booleans
+            Object ab = run(AS.get("boolean"), node);
+            if (node.isBoolean()) {
+                check(ab.equals(node.booleanValue()), () -> kind + ".asBoolean() = " + ab);
+            } else if (nullish) {
+                check(Boolean.FALSE.equals(ab), () -> kind + ".asBoolean() = " + ab);
+            } else if (node.isString()) {
+                if (s.equals("true") || s.equals("false")) {
+                    check(ab.equals(Boolean.parseBoolean(s)), () -> kind + ".asBoolean() = " + ab);
+                } else {
+                    count("asBoolean of string " + show(s) + ": " + ab);
+                }
+            } else if (container || node.isBinary()) {
+                check(threw(ab), () -> kind + ".asBoolean() = " + ab);
+            }
+            check(node.isBoolean() || threw(run(VALUE.get("boolean"), node)), () -> kind + ".booleanValue() did not throw");
+            // numbers: null/missing coerce to zero; strings by their JSON number; others throw
+            for (String k : List.of("int", "long", "short", "double", "float", "decimal", "bigInteger")) {
+                check(threw(run(VALUE.get(k), node)), () -> kind + "." + k + "Value() did not throw: " + run(VALUE.get(k), node));
+                Object a = run(AS.get(k), node);
+                if (nullish) {
+                    check(!threw(a) && new BigDecimal(a.toString()).signum() == 0, () -> kind + ".as" + k + "() = " + a);
+                } else if (container || node.isBinary() || node.isBoolean()) {
+                    if (!threw(a)) {
+                        count("as" + k + " of " + which + " = " + a);
+                    }
+                } else if (node.isString()) {
+                    BigDecimal parsed = jsonNumber(s);
+                    if (parsed == null) {
+                        if (!threw(a)) {
+                            count("as" + k + " of the non-JSON-number string " + show(s) + " = " + a);
+                        }
+                    } else {
+                        Object b = run(AS.get(k), F.numberNode(parsed));
+                        boolean integralAccessor = List.of("int", "long", "short", "bigInteger").contains(k);
+                        if (integralAccessor && threw(a) && !threw(b) && !isPlainInteger(s)) {
+                            // jackson-databind/3: a stringified number with a fraction or exponent is not truncated like the number
+                            count("known jackson-databind/3");
+                        } else if ((k.equals("double") || k.equals("float")) && threw(b) && !threw(a) && (a instanceof Double d && d.isInfinite() || a instanceof Float f && f.isInfinite())) {
+                            count("known jackson-databind/4");
+                        } else {
+                            check(threw(a) == threw(b) && (threw(a) || sameResult(a, b)), () -> kind + ".as" + k + "() = " + a + " but DecimalNode(" + parsed + ") gives " + b);
+                        }
+                    }
+                }
+            }
+            check(!node.canConvertToInt() && !node.canConvertToLong() && !node.canConvertToShort() && !node.canConvertToExactIntegral(), () -> kind + " canConvertTo* is true");
+            check(threw(run(JsonNode::numberValue, node)) || node.isPojo(), () -> kind + ".numberValue() did not throw");
+            count(which);
+        });
+    }
+
+    static boolean isPlainInteger(String s) {
+        return s.matches("-?[0-9]+");
+    }
+
+    /** The value of a JSON number text (RFC 8259 grammar), or null. */
+    static BigDecimal jsonNumber(String s) {
+        if (!s.matches("-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?")) {
+            return null;
+        }
+        return new BigDecimal(s);
+    }
+}
diff --git a/hegel/src/test/java/zoo/Model.java b/hegel/src/test/java/zoo/Model.java
new file mode 100644
index 0000000..e7ce455
--- /dev/null
+++ b/hegel/src/test/java/zoo/Model.java
@@ -0,0 +1,287 @@
+package zoo;
+
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.node.ArrayNode;
+import tools.jackson.databind.node.JsonNodeFactory;
+import tools.jackson.databind.node.ObjectNode;
+
+/**
+ * The reference JSON value ({@link Ref}: Map, List, String, Num, Boolean, NULL) mapped onto the tree
+ * model the way {@code readTree} builds it, and back; and the Java values {@code valueToTree} turns
+ * into the same tree.
+ */
+final class Model {
+    private Model() {}
+
+    static final BigInteger INT_MIN = BigInteger.valueOf(Integer.MIN_VALUE);
+    static final BigInteger INT_MAX = BigInteger.valueOf(Integer.MAX_VALUE);
+    static final BigInteger LONG_MIN = BigInteger.valueOf(Long.MIN_VALUE);
+    static final BigInteger LONG_MAX = BigInteger.valueOf(Long.MAX_VALUE);
+
+    static boolean integral(Ref.Num n) {
+        String t = n.text();
+        return t.indexOf('.') < 0 && t.indexOf('e') < 0 && t.indexOf('E') < 0;
+    }
+
+    /** True when some number in the value has no BigDecimal (exponent out of range) or overflows a double. */
+    static boolean awkward(Object v, boolean exactFloats) {
+        if (v instanceof Ref.Num n) {
+            if (n.value() == null) {
+                return true;
+            }
+            if (!integral(n) && !exactFloats) {
+                double d = Double.parseDouble(n.text());
+                return Double.isInfinite(d);
+            }
+            return false;
+        }
+        if (v instanceof Map<?, ?> m) {
+            for (Object x : m.values()) {
+                if (awkward(x, exactFloats)) {
+                    return true;
+                }
+            }
+        } else if (v instanceof List<?> l) {
+            for (Object x : l) {
+                if (awkward(x, exactFloats)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /** The node readTree builds for a number: Int/Long/BigInteger by range, Double or (exact) Decimal. */
+    static JsonNode numberNode(Ref.Num n, JsonNodeFactory f, boolean exactFloats) {
+        if (integral(n)) {
+            BigInteger bi = n.value().toBigIntegerExact();
+            if (bi.compareTo(INT_MIN) >= 0 && bi.compareTo(INT_MAX) <= 0) {
+                return f.numberNode(bi.intValue());
+            }
+            if (bi.compareTo(LONG_MIN) >= 0 && bi.compareTo(LONG_MAX) <= 0) {
+                return f.numberNode(bi.longValue());
+            }
+            return f.numberNode(bi);
+        }
+        if (exactFloats) {
+            return f.numberNode(new BigDecimal(n.text()));
+        }
+        return f.numberNode(Double.parseDouble(n.text()));
+    }
+
+    static JsonNode toNode(Object v, JsonNodeFactory f, boolean exactFloats) {
+        if (v == Ref.NULL) {
+            return f.nullNode();
+        }
+        if (v instanceof Map<?, ?> m) {
+            ObjectNode o = f.objectNode();
+            for (Map.Entry<?, ?> e : m.entrySet()) {
+                o.set((String) e.getKey(), toNode(e.getValue(), f, exactFloats));
+            }
+            return o;
+        }
+        if (v instanceof List<?> l) {
+            ArrayNode a = f.arrayNode();
+            for (Object x : l) {
+                a.add(toNode(x, f, exactFloats));
+            }
+            return a;
+        }
+        if (v instanceof String s) {
+            return f.stringNode(s);
+        }
+        if (v instanceof Boolean b) {
+            return f.booleanNode(b);
+        }
+        return numberNode((Ref.Num) v, f, exactFloats);
+    }
+
+    /** The Java value valueToTree maps onto the same tree (Integer/Long/BigInteger by range, Double or BigDecimal). */
+    static Object toJava(Object v, boolean exactFloats) {
+        if (v == Ref.NULL) {
+            return null;
+        }
+        if (v instanceof Map<?, ?> m) {
+            Map<String, Object> out = new LinkedHashMap<>();
+            for (Map.Entry<?, ?> e : m.entrySet()) {
+                out.put((String) e.getKey(), toJava(e.getValue(), exactFloats));
+            }
+            return out;
+        }
+        if (v instanceof List<?> l) {
+            List<Object> out = new ArrayList<>();
+            for (Object x : l) {
+                out.add(toJava(x, exactFloats));
+            }
+            return out;
+        }
+        if (v instanceof Ref.Num n) {
+            if (integral(n)) {
+                BigInteger bi = n.value().toBigIntegerExact();
+                if (bi.compareTo(INT_MIN) >= 0 && bi.compareTo(INT_MAX) <= 0) {
+                    return bi.intValue();
+                }
+                if (bi.compareTo(LONG_MIN) >= 0 && bi.compareTo(LONG_MAX) <= 0) {
+                    return bi.longValue();
+                }
+                return bi;
+            }
+            return exactFloats ? new BigDecimal(n.text()) : (Object) Double.parseDouble(n.text());
+        }
+        return v;
+    }
+
+    /** The reference value a node denotes (numbers by their exact decimal value). */
+    static Object toRef(JsonNode n) {
+        if (n.isNull() || n.isMissingNode()) {
+            return Ref.NULL;
+        }
+        if (n.isObject()) {
+            Map<String, Object> m = new LinkedHashMap<>();
+            for (Map.Entry<String, JsonNode> e : n.properties()) {
+                m.put(e.getKey(), toRef(e.getValue()));
+            }
+            return m;
+        }
+        if (n.isArray()) {
+            List<Object> l = new ArrayList<>();
+            for (JsonNode x : n) {
+                l.add(toRef(x));
+            }
+            return l;
+        }
+        if (n.isString()) {
+            return n.stringValue();
+        }
+        if (n.isBoolean()) {
+            return n.booleanValue();
+        }
+        if (n.isNumber()) {
+            return Ref.Num.of(n.numberValue().toString());
+        }
+        return n.toString();
+    }
+
+    /**
+     * Two reference values denote the same JSON: numbers exactly, or - when a lexeme is a float and
+     * {@code exactFloats} is false - as the doubles they round to.
+     */
+    static boolean same(Object a, Object b, boolean exactFloats) {
+        if (a instanceof Ref.Num x && b instanceof Ref.Num y) {
+            if (x.value() == null || y.value() == null) {
+                return x.text().equals(y.text());
+            }
+            if (!exactFloats && (!integral(x) || !integral(y))) {
+                return Double.compare(Double.parseDouble(x.text()), Double.parseDouble(y.text())) == 0
+                        || x.value().compareTo(y.value()) == 0;
+            }
+            return x.value().compareTo(y.value()) == 0;
+        }
+        if (a instanceof Map<?, ?> x && b instanceof Map<?, ?> y) {
+            if (x.size() != y.size()) {
+                return false;
+            }
+            var i = x.entrySet().iterator();
+            var j = y.entrySet().iterator();
+            while (i.hasNext()) {
+                var e = i.next();
+                var g = j.next();
+                if (!e.getKey().equals(g.getKey()) || !same(e.getValue(), g.getValue(), exactFloats)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a instanceof List<?> x && b instanceof List<?> y) {
+            if (x.size() != y.size()) {
+                return false;
+            }
+            for (int i = 0; i < x.size(); i++) {
+                if (!same(x.get(i), y.get(i), exactFloats)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        return a == b || a.equals(b);
+    }
+
+    /** Sort object keys (recursively). */
+    static Object sorted(Object v) {
+        if (v instanceof Map<?, ?> m) {
+            List<String> keys = new ArrayList<>();
+            for (Object k : m.keySet()) {
+                keys.add((String) k);
+            }
+            keys.sort(null);
+            Map<String, Object> out = new LinkedHashMap<>();
+            for (String k : keys) {
+                out.put(k, sorted(m.get(k)));
+            }
+            return out;
+        }
+        if (v instanceof List<?> l) {
+            List<Object> out = new ArrayList<>();
+            for (Object x : l) {
+                out.add(sorted(x));
+            }
+            return out;
+        }
+        return v;
+    }
+
+    /** Drop object properties whose value is null (recursively). */
+    static Object withoutNulls(Object v) {
+        if (v instanceof Map<?, ?> m) {
+            Map<String, Object> out = new LinkedHashMap<>();
+            for (Map.Entry<?, ?> e : m.entrySet()) {
+                if (e.getValue() != Ref.NULL) {
+                    out.put((String) e.getKey(), withoutNulls(e.getValue()));
+                }
+            }
+            return out;
+        }
+        if (v instanceof List<?> l) {
+            List<Object> out = new ArrayList<>();
+            for (Object x : l) {
+                out.add(withoutNulls(x));
+            }
+            return out;
+        }
+        return v;
+    }
+
+    /** The JSON text without its insignificant whitespace. */
+    static String compact(String json) {
+        StringBuilder sb = new StringBuilder();
+        boolean inString = false;
+        for (int i = 0; i < json.length(); i++) {
+            char c = json.charAt(i);
+            if (inString) {
+                sb.append(c);
+                if (c == '\\') {
+                    sb.append(json.charAt(++i));
+                } else if (c == '"') {
+                    inString = false;
+                }
+            } else if (c == '"') {
+                inString = true;
+                sb.append(c);
+            } else if (c != ' ' && c != '\n' && c != '\r' && c != '\t') {
+                sb.append(c);
+            }
+        }
+        return sb.toString();
+    }
+
+    static String show(JsonNode n) {
+        String s = String.valueOf(n);
+        return s.length() > 300 ? s.substring(0, 300) + "..." : s;
+    }
+}
