+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..9b2c7a9
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,337 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.word;
+
+import dev.hegel.TestCase;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.List;
+import zoo.Spec.Ver;
+
+/** Generators: versions (as values and as text), pre-release identifiers, npm-style ranges and Ivy intervals. */
+final class Gen {
+    private Gen() {}
+
+    static final String[] ALPHA = {"alpha", "beta", "rc", "a", "b", "z", "SNAPSHOT", "pre", "dev", "-", "a-b", "--", "final", "RC", "Beta"};
+    static final String[] ALNUM = {"rc1", "1a", "a1b2", "01a", "9-macro", "9-macro2", "x10", "beta9", "beta10", "b2", "a1", "a01", "1-1", "0a", "00a", "a-1", "-1", "1x2y3"};
+
+    /** Options for a version's shape. */
+    record Shape(boolean bigNumbers, boolean alnumWithDigits, boolean longDigits, boolean build, boolean pre) {
+        static final Shape PLAIN = new Shape(false, false, false, true, true);
+        static final Shape CORE = new Shape(false, false, false, false, false);
+        /** Everything the grammar allows (large numbers, alphanumerics with digits, long numeric identifiers). */
+        static final Shape FULL = new Shape(true, true, true, true, true);
+        /** Pre-release identifiers that semver4j orders like the spec: numeric or free of digits. */
+        static final Shape TAME = new Shape(false, false, false, true, true);
+    }
+
+    static BigInteger number(TestCase tc, boolean big) {
+        int kind = n(tc, 0, 99);
+        if (kind < 55) {
+            return BigInteger.valueOf(n(tc, 0, 3));
+        } else if (kind < 90 || !big) {
+            return BigInteger.valueOf(n(tc, 0, 250));
+        } else if (kind < 96) {
+            return BigInteger.valueOf(Integer.MAX_VALUE - n(tc, 0, 2));
+        } else {
+            return BigInteger.valueOf(Integer.MAX_VALUE).add(BigInteger.valueOf(n(tc, 1, 1_000_000)));
+        }
+    }
+
+    static String numericId(TestCase tc, boolean longDigits) {
+        int kind = n(tc, 0, 99);
+        if (kind < 70) {
+            return String.valueOf(n(tc, 0, 12));
+        } else if (kind < 92 || !longDigits) {
+            return String.valueOf(n(tc, 0, Integer.MAX_VALUE));
+        } else {
+            return "1" + "0".repeat(n(tc, 18, 24)) + n(tc, 0, 9);
+        }
+    }
+
+    static String alphaId(TestCase tc) {
+        return chance(tc, 80) ? pick(tc, ALPHA) : word(tc, "abcxyzABC-", 1, 6);
+    }
+
+    static String alnumId(TestCase tc, boolean longDigits) {
+        String s;
+        if (chance(tc, 70)) {
+            s = pick(tc, ALNUM);
+        } else {
+            s = word(tc, "ab-019", 1, 7);
+            if (Spec.isNumeric(s) || s.isEmpty()) {
+                s = s + "a";
+            }
+        }
+        if (longDigits && chance(tc, 10)) {
+            s = pick(tc, "a", "rc", "x") + "9".repeat(n(tc, 19, 22));
+        }
+        return s;
+    }
+
+    static String preId(TestCase tc, Shape shape) {
+        int kind = n(tc, 0, 99);
+        if (kind < 40) {
+            return numericId(tc, shape.longDigits);
+        } else if (kind < 75 || !shape.alnumWithDigits) {
+            String id = alphaId(tc);
+            // semver4j/11: a tame identifier never begins with a hyphen (the shapes that compare it skip that case)
+            return !shape.alnumWithDigits && id.startsWith("-") ? "a" + id : id;
+        } else {
+            return alnumId(tc, shape.longDigits);
+        }
+    }
+
+    static List<String> preIds(TestCase tc, Shape shape) {
+        List<String> ids = new ArrayList<>();
+        if (!shape.pre || chance(tc, 55)) {
+            return ids;
+        }
+        int k = n(tc, 1, 3);
+        for (int i = 0; i < k; i++) {
+            ids.add(preId(tc, shape));
+        }
+        return ids;
+    }
+
+    static List<String> buildIds(TestCase tc, Shape shape) {
+        List<String> ids = new ArrayList<>();
+        if (!shape.build || chance(tc, 70)) {
+            return ids;
+        }
+        int k = n(tc, 1, 2);
+        for (int i = 0; i < k; i++) {
+            ids.add(chance(tc, 50) ? pick(tc, "001", "build", "sha-1", "20130313144700", "exp", "5114f85", "0", "-") : word(tc, "0aZ-9", 1, 6));
+        }
+        return ids;
+    }
+
+    static Ver version(TestCase tc, Shape shape) {
+        return new Ver(number(tc, shape.bigNumbers), number(tc, shape.bigNumbers), number(tc, shape.bigNumbers), preIds(tc, shape), buildIds(tc, shape));
+    }
+
+    /** A version close to another: the same core with a component nudged, or the same with a pre-release change. */
+    static Ver near(TestCase tc, Ver base, Shape shape) {
+        BigInteger[] c = {base.major(), base.minor(), base.patch()};
+        int kind = n(tc, 0, 99);
+        if (kind < 60) {
+            int i = n(tc, 0, 2);
+            BigInteger d = BigInteger.valueOf(pick(tc, -1, 1, 1, 2));
+            c[i] = c[i].add(d).max(BigInteger.ZERO);
+        } else if (kind < 75) {
+            int i = n(tc, 0, 2);
+            c[i] = BigInteger.valueOf(n(tc, 0, 3));
+        }
+        return new Ver(c[0], c[1], c[2], preIds(tc, shape), buildIds(tc, shape));
+    }
+
+    /** The text of a version as semver4j accepts it: canonical, sometimes with a {@code v} and surrounding blanks. */
+    static String text(TestCase tc, Ver v) {
+        String s = v.text();
+        if (chance(tc, 15)) {
+            s = "v" + s;
+        }
+        if (chance(tc, 10)) {
+            s = pick(tc, " ", "\t", "\n", "  ") + s;
+        }
+        if (chance(tc, 10)) {
+            s = s + pick(tc, " ", "\t", "\n", "\r\n");
+        }
+        return s;
+    }
+
+    /** Text that may or may not be a version: a version, or one damaged in a way the grammar cares about. */
+    static String versionLike(TestCase tc) {
+        Ver v = version(tc, Shape.FULL);
+        String s = text(tc, v);
+        int kind = n(tc, 0, 99);
+        if (kind < 35) {
+            return s;
+        }
+        if (kind < 45) {
+            return word(tc, "0123456789.-+vVxX*= abABé", 0, 12);
+        }
+        int edits = n(tc, 1, 2);
+        for (int e = 0; e < edits; e++) {
+            int at = s.isEmpty() ? 0 : n(tc, 0, s.length());
+            switch (n(tc, 0, 11)) {
+                case 0 -> s = s.isEmpty() ? s : s.substring(0, Math.min(at, s.length() - 1)) + s.substring(Math.min(at, s.length() - 1) + 1);
+                case 1 -> s = s.substring(0, at) + pick(tc, ".", "-", "+", "v", "=", " ", "x", "*", "0", "_", "٠", "é", "\u00a0") + s.substring(at);
+                case 2 -> s = s.replaceFirst("(\\d+)", "0$1");
+                case 3 -> s = s.replace(".", "..");
+                case 4 -> s = s.replaceFirst("\\.(\\d+)$", "");
+                case 5 -> s = s + pick(tc, "-", "+", ".", "-01", "+.", "-a..b", "+a_b", "-é");
+                case 6 -> s = s.toUpperCase();
+                case 7 -> s = "=" + s;
+                case 8 -> s = s.replaceFirst("-", "+").replaceFirst("\\+", "-");
+                case 9 -> s = s.trim().replace(" ", "");
+                case 10 -> s = s + " " + s;
+                default -> s = s.replaceFirst("\\d", pick(tc, "x", "X", "*", "١"));
+            }
+        }
+        return s;
+    }
+
+    // ------------------------------------------------------------------ npm ranges
+
+    /** One comparator or partial of an npm range, with the flags the known-bug skips need. */
+    record Part(String text, boolean operator, boolean mainless) {}
+
+    /** A whole range with its description. */
+    record Range(String text, int sets, boolean hasWildcardOperand) {}
+
+    static String xToken(TestCase tc) {
+        return pick(tc, "x", "X", "*");
+    }
+
+    /** {@code M}, {@code M.m}, {@code M.m.p}, or with x-tokens; {@code depth} = how many numeric components. */
+    static String partial(TestCase tc, BigInteger[] c, int depth, boolean allowX) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < 3; i++) {
+            if (i < depth) {
+                sb.append(i > 0 ? "." : "").append(c[i]);
+            } else if (allowX && chance(tc, 50)) {
+                sb.append(i > 0 ? "." : "").append(xToken(tc));
+            } else {
+                break;
+            }
+        }
+        return sb.toString();
+    }
+
+    static BigInteger[] core(TestCase tc) {
+        return new BigInteger[] {number(tc, false), number(tc, false), number(tc, false)};
+    }
+
+    static String tamePre(TestCase tc) {
+        List<String> ids = new ArrayList<>();
+        int k = n(tc, 1, 2);
+        for (int i = 0; i < k; i++) {
+            ids.add(chance(tc, 50) ? String.valueOf(n(tc, 0, 12)) : alphaId(tc));
+        }
+        return String.join(".", ids);
+    }
+
+    static String fullVersion(TestCase tc, BigInteger[] c, boolean pre) {
+        String s = c[0] + "." + c[1] + "." + c[2];
+        if (pre && chance(tc, 35)) {
+            s += "-" + tamePre(tc);
+        }
+        if (chance(tc, 10)) {
+            s += "+" + pick(tc, "build", "001", "sha.1");
+        }
+        return s;
+    }
+
+    static String maybeV(TestCase tc, String s) {
+        return chance(tc, 10) ? "v" + s : s;
+    }
+
+    static String gap(TestCase tc) {
+        return chance(tc, 80) ? " " : pick(tc, "  ", " \t ", "   ");
+    }
+
+    /**
+     * A primitive comparator ({@code >=1.2.3}, {@code <1.x}, {@code =2}, {@code 1.2.x}, {@code *}) — never a caret,
+     * tilde or hyphen, so that any number of them may share a set.
+     */
+    static Part primitive(TestCase tc, BigInteger[] c) {
+        String op = pick(tc, "", "", "<", "<=", ">", ">=", "=");
+        int depth = n(tc, 1, 3); // a bare wildcard is semver4j/5: only ever emitted as a whole set, see npmRange
+        String body;
+        if (depth == 3) {
+            body = fullVersion(tc, c, true);
+        } else if (depth == 0) {
+            body = xToken(tc);
+        } else {
+            body = partial(tc, c, depth, true);
+        }
+        String between = chance(tc, 15) && !op.isEmpty() ? " " : "";
+        return new Part(op + between + maybeV(tc, body), !op.isEmpty(), depth == 0);
+    }
+
+    /** A caret, tilde ({@code ~}, {@code ~>}) or hyphen range: the whole set of its own. */
+    static Part advanced(TestCase tc, BigInteger[] c, boolean allowWildcardOperand) {
+        int kind = n(tc, 0, 2);
+        if (kind == 2) {
+            BigInteger[] d = core(tc);
+            int ld = n(tc, allowWildcardOperand ? 0 : 1, 3);
+            int rd = n(tc, allowWildcardOperand ? 0 : 1, 3);
+            String l = ld == 3 ? fullVersion(tc, c, true) : ld == 0 ? xToken(tc) : partial(tc, c, ld, true);
+            String r = rd == 3 ? fullVersion(tc, d, true) : rd == 0 ? xToken(tc) : partial(tc, d, rd, true);
+            return new Part(maybeV(tc, l) + gap(tc) + "-" + gap(tc) + maybeV(tc, r), true, ld == 0 || rd == 0);
+        }
+        String op = kind == 0 ? "^" : pick(tc, "~", "~", "~>");
+        int depth = n(tc, allowWildcardOperand ? 0 : 1, 3);
+        String body = depth == 3 ? fullVersion(tc, c, true) : depth == 0 ? xToken(tc) : partial(tc, c, depth, true);
+        String between = chance(tc, 10) ? " " : "";
+        return new Part(op + between + maybeV(tc, body), true, depth == 0);
+    }
+
+    /** True for a caret whose major is 0 and whose minor or patch is left open (the {@code ^0.x} shape). */
+    static boolean caretZeroOpen(String part) {
+        return part.matches("\\^\\s*v?0(?:\\.(?:[xX*]|0)(?:\\.[xX*])?)?");
+    }
+
+    /**
+     * An npm range of one to three sets joined by {@code ||}; a set is either several primitives or one advanced
+     * range. The versions inside come from {@code cores}, so that the tested version can be drawn near them.
+     */
+    static Range npmRange(TestCase tc, List<BigInteger[]> cores, boolean includePreRelease) {
+        int sets = n(tc, 1, 3);
+        boolean wildcardOperand = false;
+        StringBuilder sb = new StringBuilder();
+        for (int s = 0; s < sets; s++) {
+            if (s > 0) {
+                sb.append(chance(tc, 80) ? " || " : pick(tc, "||", " ||", "|| ", "  ||  "));
+            }
+            BigInteger[] c = core(tc);
+            cores.add(c);
+            if (chance(tc, 5)) {
+                sb.append("*");
+            } else if (chance(tc, 50)) {
+                Part p = advanced(tc, c, false);
+                // ^0.x is semver4j/4; a hyphen range with pre-releases included is a documented difference from
+                // node-semver (semver4j keeps >=1.2.3 where node lowers the bound to >=1.2.3-0): both redrawn
+                while ((p.text.startsWith("^") && caretZeroOpen(p.text)) || (includePreRelease && p.text.contains(" - "))) {
+                    c = core(tc);
+                    cores.add(c);
+                    p = advanced(tc, c, false);
+                }
+                wildcardOperand |= p.mainless;
+                sb.append(p.text);
+            } else {
+                int k = n(tc, 1, 3);
+                for (int i = 0; i < k; i++) {
+                    if (i > 0) {
+                        sb.append(gap(tc));
+                        c = chance(tc, 50) ? c : core(tc);
+                        cores.add(c);
+                    }
+                    sb.append(primitive(tc, c).text);
+                }
+            }
+        }
+        String text = sb.toString();
+        if (chance(tc, 10)) {
+            text = " " + text;
+        }
+        if (chance(tc, 10)) {
+            text = text + " ";
+        }
+        return new Range(text, sets, wildcardOperand);
+    }
+
+    // ------------------------------------------------------------------ Ivy
+
+    /** An Ivy bound: 1–3 numbers, or empty for open. */
+    static String ivyBound(TestCase tc, BigInteger[] c, boolean allowEmpty) {
+        if (allowEmpty && chance(tc, 25)) {
+            return "";
+        }
+        return partial(tc, c, n(tc, 1, 3), false);
+    }
+}
diff --git a/hegel/src/test/java/zoo/Node.java b/hegel/src/test/java/zoo/Node.java
new file mode 100644
index 0000000..8b3ab10
--- /dev/null
+++ b/hegel/src/test/java/zoo/Node.java
@@ -0,0 +1,134 @@
+package zoo;
+
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * node-semver as an oracle: a {@code node node/oracle.js} child fed one request per line (operation and JSON-quoted
+ * string arguments separated by tabs) that answers one line per request (tab-separated fields). Started lazily, once.
+ */
+final class Node {
+    private Node() {}
+
+    private static Process process;
+    private static BufferedWriter in;
+    private static BufferedReader out;
+    private static String failure;
+
+    /** A parsed version as node-semver sees it, or null when it rejects the text. */
+    record Parsed(long major, long minor, long patch, List<String> pre, List<String> build, String version) {}
+
+    static synchronized String call(String op, String... args) {
+        start();
+        if (failure != null) {
+            throw new IllegalStateException("node oracle unavailable: " + failure);
+        }
+        StringBuilder sb = new StringBuilder(op);
+        for (String a : args) {
+            sb.append('\t').append(quote(a));
+        }
+        try {
+            in.write(sb.toString());
+            in.write('\n');
+            in.flush();
+            String reply = out.readLine();
+            if (reply == null) {
+                failure = "child exited";
+                throw new IllegalStateException("node oracle exited (request " + sb + ")");
+            }
+            return reply;
+        } catch (IOException e) {
+            failure = e.toString();
+            throw new IllegalStateException("node oracle I/O failure", e);
+        }
+    }
+
+    static Parsed parse(String text) {
+        String r = call("parse", text);
+        if (r.equals("null") || r.startsWith("ERR")) {
+            return null;
+        }
+        String[] f = r.split("\t", -1);
+        return new Parsed(Long.parseLong(f[0]), Long.parseLong(f[1]), Long.parseLong(f[2]),
+            f[3].isEmpty() ? List.of() : Arrays.asList(f[3].split("\\.")),
+            f[4].isEmpty() ? List.of() : Arrays.asList(f[4].split("\\.")), f[5]);
+    }
+
+    /** -1, 0, 1, or null when node-semver rejects one of the versions. */
+    static Integer compare(String a, String b) {
+        String r = call("cmp", a, b);
+        return r.startsWith("ERR") ? null : Integer.valueOf(r);
+    }
+
+    /** true/false, or null when node-semver rejects the range or the version. */
+    static Boolean satisfies(String version, String range, boolean includePrerelease) {
+        String r = call("sat", version, range, includePrerelease ? "1" : "0");
+        return r.startsWith("ERR") ? null : Boolean.valueOf(r);
+    }
+
+    /** node-semver's normalised range text, or null for an invalid range. */
+    static String validRange(String range, boolean includePrerelease) {
+        String r = call("valid", range, includePrerelease ? "1" : "0");
+        return r.equals("null") || r.startsWith("ERR") ? null : r;
+    }
+
+    static String coerce(String text) {
+        String r = call("coerce", text);
+        return r.equals("null") || r.startsWith("ERR") ? null : r;
+    }
+
+    static String inc(String version, String kind) {
+        String r = call("inc", version, kind);
+        return r.equals("null") || r.startsWith("ERR") ? null : r;
+    }
+
+    private static void start() {
+        if (process != null || failure != null) {
+            return;
+        }
+        Path script = Paths.get(System.getProperty("basedir", "."), "node", "oracle.js").toAbsolutePath();
+        if (!Files.isRegularFile(script)) {
+            failure = "missing " + script;
+            return;
+        }
+        try {
+            ProcessBuilder pb = new ProcessBuilder("node", script.toString());
+            pb.redirectError(ProcessBuilder.Redirect.INHERIT);
+            process = pb.start();
+            in = new BufferedWriter(new OutputStreamWriter(process.getOutputStream(), StandardCharsets.UTF_8));
+            out = new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8));
+            Runtime.getRuntime().addShutdownHook(new Thread(process::destroy));
+            String v = call("version");
+            if (!v.matches("\\d+\\.\\d+\\.\\d+")) {
+                failure = "unexpected version reply " + v;
+            }
+        } catch (IOException e) {
+            failure = e.toString();
+        }
+    }
+
+    /** JSON string literal (JSON.parse on the other side). */
+    static String quote(String s) {
+        StringBuilder sb = new StringBuilder("\"");
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '"' || c == '\\') {
+                sb.append('\\').append(c);
+            } else if (c < 0x20 || c == 0x7f || c == '\u00a0' || c == '\u2028' || c == '\u2029' || (c >= 0xd800 && c <= 0xdfff)) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.append('"').toString();
+    }
+}
diff --git a/hegel/src/test/java/zoo/Semver4jPinsTest.java b/hegel/src/test/java/zoo/Semver4jPinsTest.java
new file mode 100644
index 0000000..90c67d2
--- /dev/null
+++ b/hegel/src/test/java/zoo/Semver4jPinsTest.java
@@ -0,0 +1,179 @@
+package zoo;
+
+import static zoo.Zoo.check;
+
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+import org.semver4j.Semver;
+import org.semver4j.SemverException;
+import org.semver4j.range.RangeExpression;
+import org.semver4j.range.RangeList;
+import org.semver4j.range.RangeListFactory;
+
+/**
+ * One pin per recorded bug (bugs.toml). Each asserts the correct behaviour on a minimal input and is listed in
+ * [expected_failures] of target.toml, so it fails while the bug exists and flags the fix when it stops failing.
+ */
+class Semver4jPinsTest {
+
+    static Object attempt(Supplier<Object> s) {
+        try {
+            return s.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String describe(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : String.valueOf(o);
+    }
+
+    static Object cmp(String a, String b) {
+        return attempt(() -> Integer.signum(new Semver(a).compareTo(new Semver(b))));
+    }
+
+    static Object sat(String version, String range) {
+        return attempt(() -> new Semver(version).satisfies(range));
+    }
+
+    /** semver4j/1: numeric pre-release identifiers are unbounded; comparing one of 20 digits throws NumberFormatException. */
+    @Test
+    void pin_longIdentifierCompare() {
+        Object a = cmp("1.0.0-99999999999999999999", "1.0.0-1");
+        Object b = cmp("1.0.0-rc99999999999999999999", "1.0.0-rc1");
+        Object c = cmp("1.0.0-99999999999999999999", "1.0.0-99999999999999999998");
+        check(a instanceof Integer i && i == 1, () -> "compareTo(1.0.0-99999999999999999999, 1.0.0-1) = " + describe(a));
+        check(b instanceof Integer i && i == 1, () -> "compareTo(1.0.0-rc99999999999999999999, 1.0.0-rc1) = " + describe(b));
+        check(c instanceof Integer i && i == 1, () -> "compareTo(1.0.0-99999999999999999999, 1.0.0-99999999999999999998) = " + describe(c));
+    }
+
+    /** semver4j/2: alphanumeric identifiers containing digits are not compared in ASCII order, and the order is not transitive. */
+    @Test
+    void pin_alnumIdentifierOrder() {
+        Object x = cmp("1.0.0-a1b2", "1.0.0-b1");
+        Object y = cmp("1.0.0-b1", "1.0.0-b");
+        Object z = cmp("1.0.0-b", "1.0.0-a1b2");
+        check(x instanceof Integer i && i == -1, () -> "compareTo(1.0.0-a1b2, 1.0.0-b1) = " + describe(x) + " (ASCII order says -1; with " + describe(y) + " and " + describe(z) + " the order is a cycle)");
+        Object w = cmp("1.0.0-a2", "1.0.0-a10");
+        check(w instanceof Integer i && i == 1, () -> "compareTo(1.0.0-a2, 1.0.0-a10) = " + describe(w) + " (ASCII order says 1)");
+        Object v = cmp("1.0.0-1a", "1.0.0-2");
+        check(v instanceof Integer i && i == 1, () -> "compareTo(1.0.0-1a, 1.0.0-2) = " + describe(v) + " (numeric identifiers rank below alphanumeric ones)");
+    }
+
+    /** semver4j/3: a caret, tilde or hyphen range sharing a set with other comparators is dropped from the set. */
+    @Test
+    void pin_caretKeptBesideComparators() {
+        Object a = sat("0.5.0", "^1.0.0 <1.5.0");
+        Object b = sat("5.0.0", "~1.2.3 >=1.2.5");
+        Object c = sat("1.3.0", "^1.0.0 ^1.2.0");
+        Object d = sat("3.0.0", "1.0.0 - 2.0.0 <1.5.0");
+        check(Boolean.FALSE.equals(a), () -> "0.5.0 satisfies ^1.0.0 <1.5.0: " + describe(a) + " (parsed as " + RangeListFactory.create("^1.0.0 <1.5.0") + ")");
+        check(Boolean.FALSE.equals(b), () -> "5.0.0 satisfies ~1.2.3 >=1.2.5: " + describe(b) + " (parsed as " + RangeListFactory.create("~1.2.3 >=1.2.5") + ")");
+        check(Boolean.TRUE.equals(c), () -> "1.3.0 satisfies ^1.0.0 ^1.2.0: " + describe(c) + " (parsed as " + RangeListFactory.create("^1.0.0 ^1.2.0") + ")");
+        check(Boolean.FALSE.equals(d), () -> "3.0.0 satisfies 1.0.0 - 2.0.0 <1.5.0: " + describe(d) + " (parsed as " + RangeListFactory.create("1.0.0 - 2.0.0 <1.5.0") + ")");
+    }
+
+    /** semver4j/4: a caret with major 0 and an open minor or patch (^0.x, ^0.0.x, ^0.0) gets the wrong upper bound. */
+    @Test
+    void pin_caretZeroWildcard() {
+        Object a = sat("0.0.5", "^0.0.x");
+        Object b = sat("1.0.0", "^0.x");
+        Object c = sat("0.5.0", "^0.x");
+        Object d = sat("0.0.5", "^0.0");
+        check(Boolean.TRUE.equals(a), () -> "0.0.5 satisfies ^0.0.x: " + describe(a) + " (parsed as " + RangeListFactory.create("^0.0.x") + ", npm: >=0.0.0 <0.1.0-0)");
+        check(Boolean.FALSE.equals(b), () -> "1.0.0 satisfies ^0.x: " + describe(b) + " (parsed as " + RangeListFactory.create("^0.x") + ", npm: >=0.0.0 <1.0.0-0)");
+        check(Boolean.TRUE.equals(c), () -> "0.5.0 satisfies ^0.x: " + describe(c));
+        check(Boolean.TRUE.equals(d), () -> "0.0.5 satisfies ^0.0: " + describe(d) + " (parsed as " + RangeListFactory.create("^0.0") + ")");
+    }
+
+    /** semver4j/5: a wildcard standing for the whole version (x, >=*, ^*, ~*, 1.2.3 - *, >=1.0.0 *) is mistranslated. */
+    @Test
+    void pin_bareWildcardOperand() {
+        for (String range : new String[] {"x", "X", ">=*", "<=*", "=*", "^*", "^x", "~*", "1.2.3 - *", ">=1.0.0 *", "1 - x"}) {
+            Object got = sat("5.0.0", range);
+            check(Boolean.TRUE.equals(got), () -> "5.0.0 satisfies " + range + ": " + describe(got) + " (parsed as " + RangeListFactory.create(range).get() + ", npm: " + (range.contains("1") ? ">=1.0.0" : "*") + ")");
+        }
+    }
+
+    /** semver4j/6: Ivy intervals mixing bracket styles, which the parser accepts, lose a bound or every version. */
+    @Test
+    void pin_ivyMixedBrackets() {
+        Object a = sat("3.0.0", "[1.0,2.0)");
+        Object b = sat("0.5.0", "(1.0,2.0]");
+        Object c = sat("1.5.0", "(1.0,2.0)");
+        check(Boolean.FALSE.equals(a), () -> "3.0.0 satisfies [1.0,2.0): " + describe(a) + " (parsed as " + RangeListFactory.create("[1.0,2.0)") + ")");
+        check(Boolean.FALSE.equals(b), () -> "0.5.0 satisfies (1.0,2.0]: " + describe(b) + " (parsed as " + RangeListFactory.create("(1.0,2.0]") + ")");
+        check(Boolean.TRUE.equals(c), () -> "1.5.0 satisfies (1.0,2.0): " + describe(c) + " (parsed as " + RangeListFactory.create("(1.0,2.0)").get() + ")");
+    }
+
+    /** semver4j/7: comparators that are not ranges are silently dropped; an empty result still claims to be satisfiable. */
+    @Test
+    void pin_invalidRangeRefused() {
+        Object a = attempt(() -> RangeListFactory.create("foo"));
+        Object b = attempt(() -> RangeListFactory.create(">=1.0.0 garbage"));
+        Object c = attempt(() -> RangeListFactory.create(">==1.0.0"));
+        check(a instanceof SemverException || a instanceof IllegalArgumentException, () -> "RangeListFactory.create(\"foo\") gave " + describe(a)
+            + (a instanceof RangeList rl ? " with sets " + rl.get() + ", isSatisfiedByAny " + rl.isSatisfiedByAny() + ", 1.0.0 satisfies it: " + rl.isSatisfiedBy(new Semver("1.0.0")) : ""));
+        check(b instanceof SemverException || b instanceof IllegalArgumentException, () -> "RangeListFactory.create(\">=1.0.0 garbage\") gave " + describe(b));
+        check(c instanceof SemverException || c instanceof IllegalArgumentException, () -> "RangeListFactory.create(\">==1.0.0\") gave " + describe(c));
+    }
+
+    /** semver4j/8: an empty alternative after a trailing || is ignored, while a leading one matches every version. */
+    @Test
+    void pin_trailingOrSection() {
+        Object leading = sat("2.0.0", "|| 1.0.0");
+        Object trailing = sat("2.0.0", "1.0.0 ||");
+        Object trailingSpace = sat("5.0.0", ">=1.0.0 <2.0.0 || ");
+        check(Boolean.TRUE.equals(trailing), () -> "2.0.0 satisfies \"1.0.0 ||\": " + describe(trailing) + " (npm: *), while \"|| 1.0.0\" gives " + describe(leading) + "; parsed as " + RangeListFactory.create("1.0.0 ||"));
+        check(Boolean.TRUE.equals(trailingSpace), () -> "5.0.0 satisfies \">=1.0.0 <2.0.0 || \": " + describe(trailingSpace));
+    }
+
+    /** semver4j/9: a range number above Integer.MAX_VALUE throws NumberFormatException instead of SemverException. */
+    @Test
+    void pin_bigRangeNumber() {
+        for (String range : new String[] {">=99999999999.0.0", "^99999999999", "~2147483648", "[99999999999,)", "1.0.0 - 99999999999"}) {
+            Object got = attempt(() -> RangeListFactory.create(range));
+            check(!(got instanceof NumberFormatException), () -> "RangeListFactory.create(" + range + ") threw " + describe(got) + " (versions say SemverException: Value [...] is too big)");
+        }
+    }
+
+    /** semver4j/10: withPreRelease/withBuild drop a trailing dot; "." clears the identifiers instead of being refused. */
+    @Test
+    void pin_trailingDotIdentifiers() {
+        Semver v = new Semver("1.2.3-alpha+build");
+        Object a = attempt(() -> v.withPreRelease("."));
+        Object b = attempt(() -> v.withPreRelease("a."));
+        Object c = attempt(() -> v.withBuild("."));
+        check(a instanceof SemverException, () -> "1.2.3-alpha+build.withPreRelease(\".\") = " + describe(a));
+        check(b instanceof SemverException, () -> "1.2.3-alpha+build.withPreRelease(\"a.\") = " + describe(b));
+        check(c instanceof SemverException, () -> "1.2.3-alpha+build.withBuild(\".\") = " + describe(c));
+    }
+
+    /** semver4j/11: an alphanumeric identifier beginning with a hyphen is ordered below numeric identifiers. */
+    @Test
+    void pin_hyphenIdentifierAboveNumeric() {
+        Object a = cmp("1.0.0--", "1.0.0-1");
+        Object b = cmp("1.0.0--a", "1.0.0-9");
+        check(a instanceof Integer i && i == 1, () -> "compareTo(1.0.0--, 1.0.0-1) = " + describe(a) + " (numeric identifiers have lower precedence)");
+        check(b instanceof Integer i && i == 1, () -> "compareTo(1.0.0--a, 1.0.0-9) = " + describe(b));
+    }
+
+    /** semver4j/12: after and/or with an operand holding several sets, the next and() opens a new set instead of joining the last. */
+    @Test
+    void pin_fluentAndAfterOr() {
+        RangeExpression e = RangeExpression.less("1.0.0").or(RangeExpression.less("2.0.0").or(RangeExpression.greaterOrEqual("5.0.0"))).and(RangeExpression.eq("6.0.0"));
+        RangeList built = RangeListFactory.create(e);
+        Object got = attempt(() -> new Semver("7.0.0").satisfies(built));
+        check(Boolean.FALSE.equals(got), () -> "7.0.0 satisfies less(1.0.0).or(less(2.0.0).or(greaterOrEqual(5.0.0))).and(eq(6.0.0)): " + describe(got) + "; built " + built.get() + ", the text form <1.0.0 || <2.0.0 || >=5.0.0 =6.0.0 parses to " + RangeListFactory.create("<1.0.0 || <2.0.0 || >=5.0.0 =6.0.0").get());
+    }
+
+    /** Sanity: the harness itself sees the documented behaviours these pins build on. */
+    @Test
+    void pinsPreconditions() {
+        check(new Semver("1.0.0-alpha").compareTo(new Semver("1.0.0")) < 0, () -> "pre-release precedence");
+        check(new Semver("1.2.3").satisfies("^1.0.0") && !new Semver("2.0.0").satisfies("^1.0.0"), () -> "caret");
+        check(new Semver("1.5.0").satisfies("[1.0,2.0]") && !new Semver("2.0.0").satisfies("[1.0,2.0["), () -> "ivy");
+        check(new Semver("2.0.0").satisfies("|| 1.0.0"), () -> "leading empty alternative matches everything");
+        check(new Semver("7.0.0").satisfies(RangeExpression.less("1.0.0").or(RangeExpression.greaterOrEqual("5.0.0").and(RangeExpression.eq("6.0.0")))) == false, () -> "fluent and inside or");
+    }
+}
diff --git a/hegel/src/test/java/zoo/Semver4jTest.java b/hegel/src/test/java/zoo/Semver4jTest.java
new file mode 100644
index 0000000..fc4eaa6
--- /dev/null
+++ b/hegel/src/test/java/zoo/Semver4jTest.java
@@ -0,0 +1,615 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.show;
+
+import dev.hegel.HealthCheck;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+import org.semver4j.Semver;
+import org.semver4j.Semver.VersionDiff;
+import org.semver4j.SemverException;
+import org.semver4j.range.Range;
+import org.semver4j.range.Range.RangeOperator;
+import org.semver4j.range.RangeExpression;
+import org.semver4j.range.RangeList;
+import org.semver4j.range.RangeListFactory;
+import zoo.Gen.Shape;
+import zoo.Spec.Ver;
+
+/**
+ * semver4j against a model of SemVer 2.0.0 and against node-semver (a child process; {@link Node}).
+ *
+ * <p>Known bugs (bugs.toml) are skipped by shape, never worked around: identifiers with more than 18 digits and
+ * pairs of alphanumeric identifiers that both contain digits (semver4j/1, /2) are not compared; caret, tilde and
+ * hyphen ranges are never combined with other comparators in one set (semver4j/3); {@code ^0.x}-shaped carets and
+ * bare wildcard operands are not generated (semver4j/4, /5); Ivy intervals mix no bracket styles (semver4j/6); range
+ * text is always well-formed (semver4j/7), has no trailing {@code ||} (semver4j/8) and no number above
+ * {@code Integer.MAX_VALUE} (semver4j/9); the identifier lists given to withPreRelease/withBuild have no trailing dot
+ * (semver4j/10); an identifier beginning with a hyphen is never compared with a numeric one (semver4j/11); a fluent
+ * chain ends after an operand that contains {@code or} (semver4j/12).
+ */
+class Semver4jTest {
+
+    static final Shape NO_BIG = new Shape(false, true, true, true, true);
+    static final Shape MODIFY = new Shape(false, true, false, true, true);
+
+    /** semver4j/1 and /2: pairs the library compares in its own way; the precedence checks skip them. */
+    static boolean comparable(Ver a, Ver b) {
+        for (String id : a.pre()) {
+            if (Spec.longestDigitRun(id) > 18) {
+                return false;
+            }
+        }
+        for (String id : b.pre()) {
+            if (Spec.longestDigitRun(id) > 18) {
+                return false;
+            }
+        }
+        int i = Spec.firstDifference(a.pre(), b.pre());
+        if (i >= 0) {
+            String x = a.pre().get(i);
+            String y = b.pre().get(i);
+            if (Spec.hasDigit(x) && Spec.hasDigit(y) && !(Spec.isNumeric(x) && Spec.isNumeric(y))) {
+                return false;
+            }
+            // semver4j/11: an alphanumeric identifier beginning with a hyphen is ordered below a numeric one
+            if (Spec.isNumeric(x) != Spec.isNumeric(y) && (x.startsWith("-") || y.startsWith("-"))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static boolean ascii(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            if (s.charAt(i) > 0x7e) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static Object attempt(Supplier<Object> s) {
+        try {
+            return s.get();
+        } catch (RuntimeException e) {
+            if (e.getClass().getName().startsWith("dev.hegel")) {
+                Zoo.sneaky(e);
+            }
+            return e;
+        }
+    }
+
+    static String describe(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : show(o);
+    }
+
+    // ------------------------------------------------------------------ parsing
+
+    /** {@code Semver.parse}/{@code isValid}/the constructor accept exactly the grammar (plus v and blanks) and normalise the text. */
+    @Test
+    void parsingMatchesTheSpec() {
+        Hegel.test(tc -> {
+            String s = Gen.versionLike(tc);
+            Ver expected = Spec.parse(s);
+            Object made = attempt(() -> new Semver(s));
+            Semver got = Semver.parse(s);
+            boolean valid = Semver.isValid(s);
+            check(valid == (got != null), () -> "isValid " + valid + " but parse gave " + describe(got) + " for " + show(s));
+            check((made instanceof Semver) == (got != null), () -> "constructor " + describe(made) + " but parse " + describe(got) + " for " + show(s));
+            if (expected == null) {
+                check(got == null, () -> "accepted " + show(s) + " as " + describe(got) + ", not a version");
+                check(made instanceof SemverException, () -> "constructor gave " + describe(made) + " for " + show(s));
+            } else if (!expected.fitsInt()) {
+                check(got == null, () -> "accepted " + show(s) + " whose number exceeds Integer.MAX_VALUE as " + describe(got));
+                check(made instanceof SemverException e && String.valueOf(e.getMessage()).contains("too big"), () -> "constructor gave " + describe(made) + " for " + show(s));
+            } else {
+                check(got != null, () -> "rejected " + show(s) + " (" + describe(made) + "), a version");
+                if (got != null) {
+                    final Semver g = got;
+                    check(g.getMajor() == expected.major().intValue() && g.getMinor() == expected.minor().intValue() && g.getPatch() == expected.patch().intValue(),
+                        () -> "core of " + show(s) + " read as " + g.getMajor() + "." + g.getMinor() + "." + g.getPatch());
+                    check(g.getPreRelease().equals(expected.pre()), () -> "pre-release of " + show(s) + " read as " + g.getPreRelease() + ", expected " + expected.pre());
+                    check(g.getBuild().equals(expected.build()), () -> "build of " + show(s) + " read as " + g.getBuild() + ", expected " + expected.build());
+                    check(g.getVersion().equals(expected.text()) && g.toString().equals(expected.text()), () -> "getVersion of " + show(s) + " is " + show(g.getVersion()) + ", expected " + show(expected.text()));
+                    check(g.equals(new Semver(expected.text())) && g.hashCode() == new Semver(expected.text()).hashCode(), () -> show(s) + " is not equal to its canonical form " + show(expected.text()));
+                    check(g.isStable() == (expected.major().signum() > 0 && expected.pre().isEmpty()), () -> "isStable of " + show(s) + " is " + g.isStable());
+                }
+            }
+            if (ascii(s) && s.length() <= 256) {
+                Node.Parsed node = Node.parse(s);
+                check((node != null) == (expected != null), () -> "node-semver " + (node == null ? "rejects" : "accepts") + " " + show(s) + " but the grammar says " + (expected == null ? "invalid" : "valid"));
+                if (node != null && expected != null && expected.fitsInt()) {
+                    check(node.major() == expected.major().longValue() && node.minor() == expected.minor().longValue() && node.patch() == expected.patch().longValue()
+                        && node.pre().equals(expected.pre()) && node.build().equals(expected.build()), () -> "node-semver reads " + show(s) + " as " + node + ", the grammar as " + expected);
+                }
+            }
