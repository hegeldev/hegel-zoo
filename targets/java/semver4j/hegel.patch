+    /**
+     * The oracle of the npm range properties: node-semver accepts the range (or, for a part that is no comparator,
+     * refuses it and semver4j must too), semver4j parses it into one set per alternative (a number above
+     * Integer.MAX_VALUE may be refused as "too big"), and satisfies agrees with node-semver on versions near the
+     * numbers the range was written with, through every overload.
+     */
+    static void npmRange(TestCase tc, boolean pre, Gen.Range r) {
+        npmRange(tc, pre, r, nearRange(r));
+    }
+
+    /** {@link #npmRange(TestCase, boolean, Gen.Range)} with the versions satisfies is asked about drawn from {@code tested}. */
+    static void npmRange(TestCase tc, boolean pre, Gen.Range r, Generator<List<Shown>> tested) {
+        String range = r.text();
+        String nodeRange = Node.validRange(range, pre);
+        if (r.junk()) {
+            check(nodeRange == null, () -> "node-semver accepts " + show(range) + " as " + show(nodeRange) + " though a part of it is no comparator");
+            Object made = attempt(() -> RangeListFactory.create(range, pre));
+            check(made instanceof SemverException || made instanceof IllegalArgumentException, () -> "RangeListFactory.create(" + show(range) + "), which node-semver refuses, gave " + describe(made)
+                + (made instanceof RangeList rl ? " with sets " + rl.get() + ", isSatisfiedByAny " + rl.isSatisfiedByAny() : ""));
+            return;
+        }
+        check(nodeRange != null, () -> "node-semver rejects the generated range " + show(range));
+        if (nodeRange == null) {
+            return;
+        }
+        Object made = attempt(() -> RangeListFactory.create(range, pre));
+        if (r.tooBig() && made instanceof SemverException) {
+            return; // a number above Integer.MAX_VALUE, refused as the version parser refuses it; node-semver takes up to 16 digits
+        }
+        check(made instanceof RangeList, () -> "RangeListFactory.create(" + show(range) + ") threw " + describe(made)
+            + (r.tooBig() ? " for a number above Integer.MAX_VALUE (versions say SemverException: Value [...] is too big)" : ""));
+        if (!(made instanceof RangeList rl)) {
+            return;
+        }
+        check(rl.get().size() == r.sets(), () -> "range " + show(range) + " parsed into " + rl.get().size() + " sets " + rl + ", expected " + r.sets() + " (node: " + nodeRange + ")");
+        for (Shown v : tc.draw(tested, "versions")) {
+            String vt = v.text();
+            if (!pre && r.sets() > 1 && nodeRange.equals("*") && !v.ver().pre().isEmpty()) {
+                // node-semver collapses a range one of whose sets is "any version" (`*`, `x`, `>=*`, an empty
+                // alternative) to `*` alone (classes/range.js: "if we have any that are *, then the range is just
+                // *"), which then excludes every pre-release, so "1.2.3-a" does not satisfy "* || 1.2.3-a" there
+                // while semver4j, evaluating each set, says it does (as the npm rule for pre-releases would). A
+                // node-semver quirk: not compared.
+                continue;
+            }
+            Boolean node = Node.satisfies(vt, range, pre);
+            check(node != null, () -> "node-semver rejects the version " + show(vt) + " or the range " + show(range));
+            if (node == null) {
+                continue;
+            }
+            Semver sv = new Semver(vt);
+            Object got = attempt(() -> sv.satisfies(range, pre));
+            boolean bug13 = !pre && Boolean.TRUE.equals(got) && !node && openUpperBoundWithoutMinusZero(v.ver(), rl, range, nodeRange);
+            if (bug13 && Zoo.NO_KNOWN) {
+                continue; // semver4j/13, see openUpperBoundWithoutMinusZero
+            }
+            check(got instanceof Boolean b && b == node, () -> (bug13 ? "semver4j/13: " : "") + show(vt) + " satisfies " + show(range) + (pre ? " (with pre-releases)" : "") + ": semver4j " + describe(got) + ", node-semver " + node + "; parsed as " + rl + ", node as " + show(nodeRange));
+            Object viaList = attempt(() -> sv.satisfies(rl));
+            check(viaList instanceof Boolean b && b.equals(got), () -> "satisfies(RangeList) " + describe(viaList) + " differs from satisfies(String) " + describe(got) + " for " + show(vt) + " and " + show(range));
+            if (!pre) {
+                Object plain = attempt(() -> sv.satisfies(range));
+                check(plain instanceof Boolean b && b.equals(got), () -> "satisfies(String) " + describe(plain) + " differs from satisfies(String, false) " + describe(got) + " for " + show(vt) + " and " + show(range));
+            }
+        }
+    }
