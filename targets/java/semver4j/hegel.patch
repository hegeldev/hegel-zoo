+/**
+ * semver4j against a model of SemVer 2.0.0 and against node-semver (a child process; {@link Node}).
+ *
+ * <p>The generators draw the shapes of the recorded bugs (bugs.toml): identifiers of more than 19 digits and pairs
+ * of alphanumeric identifiers that both contain digits are compared (semver4j/1, /2), as is an identifier beginning
+ * with a hyphen against a numeric one (/11); a caret or tilde shares a set with other comparators (/3); {@code ^0.x}
+ * carets (/4), bare wildcard operands (/5), Ivy intervals mixing bracket styles (/6), parts that are no comparator
+ * (/7), a trailing {@code ||} (/8) and range numbers above {@code Integer.MAX_VALUE} (/9) are written; identifier
+ * lists with a trailing dot are given to withPreRelease/withBuild (/10); a fluent chain goes on with {@code and}
+ * after an operand holding several sets (/12); a partial or x-range upper bound stands beside a comparator naming a
+ * pre-release of the version it excludes (/13). So the wide properties fail on them, and the narrow properties - one
+ * per bug, each over its shape region with random contents and the same oracle - fail on them too; all are the
+ * expected failures. {@code HEGEL_NO_KNOWN=1} ({@link Zoo#NO_KNOWN}) leaves the shapes out (and the precedence
+ * checks skip the few pairs the shapes of /1, /2 and /11 still reach, the range checks the few versions /13's does).
+ */
+class Semver4jTest {
+
+    /**
+     * Every identifier shape but numbers above Integer.MAX_VALUE (the constructor refuses them). Under HEGEL_NO_KNOWN
+     * the identifiers are numeric or free of digits and hyphens ({@link Shape#TAME}): the long digit runs of
+     * semver4j/1, the alphanumeric identifiers of /2 and the hyphens of /11 would otherwise make the
+     * {@link #comparable} gate skip a tenth of the pairs.
+     */
+    static final Shape NO_BIG = Zoo.NO_KNOWN ? Shape.TAME : new Shape(false, true, true, true, true);
+    static final Shape MODIFY = new Shape(false, true, false, true, true);
+
+    /** Whether the precedence checks compare the pair: always, or under HEGEL_NO_KNOWN only when {@link #comparable}. */
+    static boolean compared(Ver a, Ver b) {
+        return !Zoo.NO_KNOWN || comparable(a, b);
+    }
+
+    /**
+     * semver4j/1, /2 and /11: pairs the library compares in its own way (the shape test of the HEGEL_NO_KNOWN gate).
+     * Identifiers are compared only when the cores are equal and both versions have a pre-release, up to and
+     * including the first differing pair.
+     */
+    static boolean comparable(Ver a, Ver b) {
+        if (!a.core().equals(b.core()) || a.pre().isEmpty() || b.pre().isEmpty()) {
+            return true;
+        }
+        int i = Spec.firstDifference(a.pre(), b.pre());
+        int compared = i < 0 ? Math.min(a.pre().size(), b.pre().size()) : i + 1;
+        for (int k = 0; k < compared; k++) {
+            if (Spec.longestDigitRun(a.pre().get(k)) > 18 || Spec.longestDigitRun(b.pre().get(k)) > 18) {
+                return false;
+            }
+        }
+        if (i >= 0) {
+            String x = a.pre().get(i);
+            String y = b.pre().get(i);
+            if (Spec.hasDigit(x) && Spec.hasDigit(y) && !(Spec.isNumeric(x) && Spec.isNumeric(y))) {
+                return false;
+            }
+            // semver4j/11: an alphanumeric identifier beginning with a hyphen is ordered below a numeric one
+            if (Spec.isNumeric(x) != Spec.isNumeric(y) && (x.startsWith("-") || y.startsWith("-"))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static boolean ascii(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            if (s.charAt(i) > 0x7e) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static Object attempt(Supplier<Object> s) {
+        try {
+            return s.get();
+        } catch (RuntimeException e) {
+            if (e.getClass().getName().startsWith("dev.hegel")) {
+                Zoo.sneaky(e);
+            }
+            return e;
+        }
+    }
+
+    static String describe(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : show(o);
+    }
+
+    /**
+     * A version for a model built step by step: a fresh one, or ({@code near}, and when some were drawn before it)
+     * one near the version at {@code at} modulo their number.
