+
+    /** A number above Integer.MAX_VALUE (semver4j/9); under HEGEL_NO_KNOWN a large one that fits. */
+    static final Generator<BigInteger> BIG = Zoo.NO_KNOWN ? ints(1_000_000, Integer.MAX_VALUE - 3).map(BigInteger::valueOf) : Gen.TOO_BIG;
+    static final Generator<Core> BIG_CORE = Gen.core(BIG);
