+    /**
+     * semver4j/13: node-semver writes the exclusive upper bound it derives from a partial or x-range (and from a caret,
+     * tilde or hyphen range) with a {@code -0} ({@code <0.1} is {@code <0.1.0-0}, {@code 1.2.x} is
+     * {@code >=1.2.0 <1.3.0-0}), so no pre-release of the bound satisfies it; semver4j writes {@code <0.1.0}, so when
+     * another comparator of the set admits the bound's pre-releases ({@code <0.1 >0.1.0-1}) a pre-release of the bound
+     * ({@code 0.1.0-5}) satisfies the range in semver4j and not in node-semver. The shape: the version tested is a
+     * pre-release of a V that node's range bounds by {@code <V-0} and semver4j's by {@code <V}, and the range names
+     * a pre-release of V. (With pre-releases included semver4j writes the {@code -0} too; a caret or tilde beside
+     * another comparator is dropped altogether, semver4j/3, and node-semver refuses a hyphen range there.)
+     */
+    static boolean openUpperBoundWithoutMinusZero(Ver v, RangeList rl, String range, String nodeRange) {
+        String core = v.core().text();
+        return !v.pre().isEmpty() && nodeRange.contains("<" + core + "-0") && range.contains(core + "-")
+            && rl.get().stream().flatMap(List::stream).anyMatch(c -> c.getRangeOperator() == RangeOperator.LT && c.getRangeVersion().getVersion().equals(core));
+    }
