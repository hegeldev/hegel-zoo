+        }, Zoo.settings("precedenceMatchesTheSpec"));
+    }
+
+    // ------------------------------------------------------------------ npm ranges
+
+    /** One to three versions near the numbers a range was written with, as written for semver4j. */
+    static Generator<List<Shown>> nearRange(Gen.Range r) {
+        return lists(Gen.shown(sampledFrom(r.cores()).flatMap(c -> Gen.near(c.ver(), Shape.TAME)))).minSize(1).maxSize(3);
+    }
+
+    /** satisfies(version, npmRange, includePreRelease) agrees with node-semver on every range syntax semver4j lists as supported. */
+    @Test
+    void npmRangesMatchNodeSemver() {
+        Hegel.test(tc -> {
+            boolean pre = tc.draw(chance(50), "includePreRelease");
+            Gen.Range r = tc.draw(Gen.npmRange(pre), "range");
+            String range = r.text();
+            String nodeRange = Node.validRange(range, pre);
+            check(nodeRange != null, () -> "node-semver rejects the generated range " + show(range));
+            if (nodeRange == null) {
+                return;
+            }
+            Object made = attempt(() -> RangeListFactory.create(range, pre));
+            check(made instanceof RangeList, () -> "RangeListFactory.create(" + show(range) + ") threw " + describe(made));
+            if (!(made instanceof RangeList rl)) {
+                return;
+            }
+            check(rl.get().size() == r.sets(), () -> "range " + show(range) + " parsed into " + rl.get().size() + " sets " + rl + ", expected " + r.sets() + " (node: " + nodeRange + ")");
