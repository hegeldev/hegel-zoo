+    /** Pre-release identifiers named in a range: one or two small numbers or words without digits. */
+    static final Generator<List<String>> PRE_IDS = lists(oneOf(ints(0, 12).map(String::valueOf), Gen.TAME_ALPHA_ID)).minSize(1).maxSize(2);
+
+    /**
+     * semver4j/13: an upper bound written as a partial or x-range primitive ({@code <M.m}, {@code <M}, {@code <=M.m},
+     * {@code M.m.x}, {@code =M}, ...): {@code depth} numbers of the core, then {@code xs} x-tokens, sometimes a
+     * {@code v}. node-semver writes the version V it excludes as {@code <V-0}, semver4j as {@code <V}.
+     */
+    record OpenBound(String op, int depth, Core core, List<String> xs, boolean v) {
+        String text() {
+            return op + new Gen.Body(depth, xs, "", "", v).render(core);
+        }
+
+        /** The version the bound excludes: {@code <} stops at the partial version filled with zeros, the other operators just after it. */
+        Ver bound() {
+            if (op.equals("<")) {
+                return new Core(core.major(), depth > 1 ? core.minor() : ZERO, ZERO).ver();
+            }
+            return depth > 1 ? new Core(core.major(), core.minor().add(BigInteger.ONE), ZERO).ver() : new Core(core.major().add(BigInteger.ONE), ZERO, ZERO).ver();
+        }
+    }
