+    /** The oracle of the precedence properties: a third version, a companion of the two, the texts they are written as, then {@link #precedence}. */
+    static void precedence(TestCase tc, Ver a, Ver b, Shape third) {
+        Ver c = tc.draw(Gen.companion(List.of(a, b), third), "c");
+        precedence(a, b, c, tc.draw(Gen.text(a), "a as written"), tc.draw(Gen.text(b), "b as written"), tc.draw(Gen.text(c), "c as written"));
+    }
+
+    /**
+     * compareTo and the ten comparison methods on {@code a} and {@code b} follow section 11 and node-semver, the order is
+     * antisymmetric and transitive over {@code c}, equals means equal canonical text, diff is the greatest difference.
+     */
+    static void precedence(Ver a, Ver b, Ver c, String ta, String tb, String tcText) {
+        Semver sa = new Semver(ta);
+        Semver sb = new Semver(tb);
+        Semver sc = new Semver(tcText);
+        boolean ab = compared(a, b);
+        boolean bc = compared(b, c);
+        boolean ac = compared(a, c);
+        if (ab) {
+            int expected = Spec.compare(a, b);
+            Object got = attempt(() -> Integer.signum(sa.compareTo(sb)));
+            check(got instanceof Integer i && i == expected, () -> "compareTo(" + show(sa.getVersion()) + ", " + show(sb.getVersion()) + ") = " + describe(got) + ", spec says " + expected);
+            Object back = attempt(() -> Integer.signum(sb.compareTo(sa)));
+            check(back instanceof Integer i && i == -expected, () -> "compareTo(" + show(sb.getVersion()) + ", " + show(sa.getVersion()) + ") = " + describe(back) + ", not the negation of " + expected);
+            if (got instanceof Integer) {
+                String s1 = sb.getVersion();
+                check(sa.isEquivalentTo(sb) == (expected == 0) && sa.isEquivalentTo(s1) == (expected == 0), () -> "isEquivalentTo(" + sa + ", " + sb + ") disagrees with compareTo " + expected);
+                check(sa.isGreaterThan(sb) == (expected > 0) && sa.isGreaterThan(s1) == (expected > 0), () -> "isGreaterThan(" + sa + ", " + sb + ") disagrees with compareTo " + expected);
+                check(sa.isGreaterThanOrEqualTo(sb) == (expected >= 0) && sa.isGreaterThanOrEqualTo(s1) == (expected >= 0), () -> "isGreaterThanOrEqualTo(" + sa + ", " + sb + ") disagrees with compareTo " + expected);
+                check(sa.isLowerThan(sb) == (expected < 0) && sa.isLowerThan(s1) == (expected < 0), () -> "isLowerThan(" + sa + ", " + sb + ") disagrees with compareTo " + expected);
+                check(sa.isLowerThanOrEqualTo(sb) == (expected <= 0) && sa.isLowerThanOrEqualTo(s1) == (expected <= 0), () -> "isLowerThanOrEqualTo(" + sa + ", " + sb + ") disagrees with compareTo " + expected);
+            }
+            boolean sameText = a.text().equals(b.text());
+            check(sa.equals(sb) == sameText && sa.isEqualTo(sb) == sameText && sa.isEqualTo(sb.getVersion()) == sameText, () -> "equals(" + sa + ", " + sb + ") = " + sa.equals(sb) + ", the canonical texts are " + (sameText ? "equal" : "different"));
+            check(!sameText || sa.hashCode() == sb.hashCode(), () -> "equal versions " + sa + " with different hash codes");
+            if (expected == 0 && !sameText) {
+                check(sa.diff(sb) == VersionDiff.BUILD, () -> "diff(" + sa + ", " + sb + ") = " + sa.diff(sb) + " for versions differing in build metadata only");
+            }
+            // node-semver agrees (its numeric identifiers are doubles: keep them exact)
+            boolean exact = true;
+            for (String id : a.pre()) {
+                exact &= !Spec.isNumeric(id) || id.length() <= 15;
+            }
+            for (String id : b.pre()) {
+                exact &= !Spec.isNumeric(id) || id.length() <= 15;
+            }
+            if (exact) {
+                Integer node = Node.compare(a.text(), b.text());
+                check(node != null && node == expected, () -> "node-semver compares " + show(a.text()) + " and " + show(b.text()) + " as " + node + ", the model says " + expected);
+            }
+        }
+        if (ab && bc && ac) {
+            Object xo = attempt(() -> Integer.signum(sa.compareTo(sb)));
+            Object yo = attempt(() -> Integer.signum(sb.compareTo(sc)));
+            Object zo = attempt(() -> Integer.signum(sa.compareTo(sc)));
+            check(xo instanceof Integer && yo instanceof Integer && zo instanceof Integer, () -> "compareTo over " + sa + ", " + sb + ", " + sc + " gave " + describe(xo) + ", " + describe(yo) + ", " + describe(zo));
+            if (xo instanceof Integer x && yo instanceof Integer y && zo instanceof Integer z) {
+                check(!(x <= 0 && y <= 0) || z <= 0, () -> "compareTo is not transitive: " + sa + " <= " + sb + " <= " + sc + " but " + sa + " > " + sc);
+                check(!(x >= 0 && y >= 0) || z >= 0, () -> "compareTo is not transitive: " + sa + " >= " + sb + " >= " + sc + " but " + sa + " < " + sc);
+            }
+        }
+        // the greatest difference
+        VersionDiff expectedDiff = !a.major().equals(b.major()) ? VersionDiff.MAJOR : !a.minor().equals(b.minor()) ? VersionDiff.MINOR : !a.patch().equals(b.patch()) ? VersionDiff.PATCH
+            : !a.pre().equals(b.pre()) ? VersionDiff.PRE_RELEASE : !a.build().equals(b.build()) ? VersionDiff.BUILD : VersionDiff.NONE;
+        check(sa.diff(sb) == expectedDiff && sa.diff(sb.getVersion()) == expectedDiff, () -> "diff(" + sa + ", " + sb + ") = " + sa.diff(sb) + ", expected " + expectedDiff);
+        check(sa.isApiCompatible(sb) == (expectedDiff.ordinal() < VersionDiff.MAJOR.ordinal()) && sa.isApiCompatible(sb.getVersion()) == sa.isApiCompatible(sb), () -> "isApiCompatible(" + sa + ", " + sb + ") = " + sa.isApiCompatible(sb) + " with diff " + expectedDiff);
+    }
