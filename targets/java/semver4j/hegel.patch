+    /** semver4j/9: a primitive, caret, tilde or hyphen range written with a big number. */
+    static Generator<Gen.Alt> bigNumber(boolean pre) {
+        return withHyphenUnlessPre(pre, hyphen(BIG_CORE, Gen.body(1, 3), Gen.body(1, 3)),
