+            check(s.isStable() == (v.major().signum() > 0 && v.pre().isEmpty()), () -> "isStable of " + s + " = " + s.isStable());
+            // invalid identifiers are refused with SemverException
+            // semver4j/10: a trailing dot is dropped by String.split, so "a." and "." are not refused; skipped here
+            String bad = tc.draw(sampledFrom("", "a..b", ".a", "é", "a b", "01", "+x", "a-.b", "a.01"), "bad identifiers");
