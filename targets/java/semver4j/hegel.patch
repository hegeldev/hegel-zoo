+    static final Generator<OpenBound> OPEN_BOUND = ints(1, 2).flatMap(depth -> tuples(sampledFrom("<", "<=", "", "="), Gen.CORE, lists(Gen.X_TOKEN).maxSize(3 - depth), chance(10))
+        .map(t -> new OpenBound(t.value1(), depth, t.value2(), t.value3(), t.value4())));
