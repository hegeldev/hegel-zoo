+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for semver4j, added by the Hegel zoo (targets/java/semver4j). Runs against the
+     org.semver4j:semver4j artifact that `[run] setup` installs from this checkout into the local Maven repository.
+     Oracles: a model of SemVer 2.0.0 (grammar and precedence, BigInteger arithmetic) and node-semver 7.8.5 running as
+     a child process (node/oracle.js, installed by `[run] setup` into node/node_modules). -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>semver4j-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <semver4j.version>0.0.1-SNAPSHOT</semver4j.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.semver4j</groupId>
+      <artifactId>semver4j</artifactId>
+      <version>${semver4j.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..1401f91
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,595 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.oneOf;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import dev.hegel.Generator;
+import dev.hegel.Tuple2;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.List;
+import zoo.Spec.Ver;
+
+/**
+ * Generators, as values: versions (as values and as text), pre-release identifiers, npm-style ranges and Ivy bounds.
+ * Anything that depends on a value drawn before it (a version near another, the numbers a range was written with)
+ * is either a generator-returning method of that value or data applied by a pure function afterwards.
+ *
+ * <p>The shapes of the recorded bugs (bugs.toml) are drawn: identifiers beginning with a hyphen (semver4j/11), a
+ * caret or tilde beside other comparators in one set (/3), {@code ^0.x} carets (/4), bare wildcard bodies (/5),
+ * operators no grammar has (/7), a trailing {@code ||} (/8) and range numbers above {@code Integer.MAX_VALUE} (/9).
+ * Under {@code HEGEL_NO_KNOWN=1} ({@link Zoo#NO_KNOWN}) each is left out.
+ */
+final class Gen {
+    private Gen() {}
+
+    // ------------------------------------------------------------------ combinators the binding lacks
+
+    /** A weighted alternative for {@link #weighted}. */
+    record Choice<T>(int weight, Generator<T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        int total = 0;
+        for (Choice<T> c : choices) {
+            total += c.weight();
+        }
+        return integers().min(0).max(total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : choices) {
+                acc += c.weight();
+                if (i < acc) {
+                    return c.gen();
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return integers().min(0).max(99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A string of lo..hi characters of the alphabet (the binding's text() has no alphabet of its own). */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        List<String> chars = alphabet.codePoints().mapToObj(Character::toString).toList();
+        return lists(sampledFrom(chars)).minSize(lo).maxSize(hi).map(l -> String.join("", l));
+    }
+
+    // ------------------------------------------------------------------ versions
+
+    static final String[] ALPHA = {"alpha", "beta", "rc", "a", "b", "z", "SNAPSHOT", "pre", "dev", "-", "a-b", "--", "final", "RC", "Beta"};
+    static final String[] ALNUM = {"rc1", "1a", "a1b2", "01a", "9-macro", "9-macro2", "x10", "beta9", "beta10", "b2", "a1", "a01", "1-1", "0a", "00a", "a-1", "-1", "1x2y3"};
+
+    /** Options for a version's shape. */
+    record Shape(boolean bigNumbers, boolean alnumWithDigits, boolean longDigits, boolean build, boolean pre) {
+        static final Shape PLAIN = new Shape(false, false, false, true, true);
+        static final Shape CORE = new Shape(false, false, false, false, false);
+        /** Everything the grammar allows (large numbers, alphanumerics with digits, long numeric identifiers). */
+        static final Shape FULL = new Shape(true, true, true, true, true);
+        /**
+         * Pre-release identifiers of the versions in the range properties: numeric or free of digits (the alphanumeric
+         * identifiers with digits are the precedence property's, semver4j/1 and /2); they may begin with a hyphen
+         * (semver4j/11) unless HEGEL_NO_KNOWN is set, see {@link #TAME_ALPHA_ID}.
+         */
+        static final Shape TAME = new Shape(false, false, false, true, true);
+    }
+
+    static final BigInteger MAX_INT = BigInteger.valueOf(Integer.MAX_VALUE);
+    static final Generator<BigInteger> TINY = ints(0, 3).map(BigInteger::valueOf);
+    static final Generator<BigInteger> SMALL = ints(0, 250).map(BigInteger::valueOf);
+
+    /** A version number: mostly 0..3, else up to 250; when {@code big}, sometimes at or just above Integer.MAX_VALUE. */
+    static Generator<BigInteger> number(boolean big) {
+        if (!big) {
+            return weighted(w(55, TINY), w(45, SMALL));
+        }
+        return weighted(
+            w(55, TINY),
+            w(35, SMALL),
+            w(6, ints(0, 2).map(d -> MAX_INT.subtract(BigInteger.valueOf(d)))),
+            w(4, ints(1, 1_000_000).map(d -> MAX_INT.add(BigInteger.valueOf(d)))));
+    }
+
+    /** The three numbers of a version, as ranges write them. */
+    record Core(BigInteger major, BigInteger minor, BigInteger patch) {
+        BigInteger get(int i) {
+            return i == 0 ? major : i == 1 ? minor : patch;
+        }
+
+        Ver ver() {
+            return new Ver(major, minor, patch, List.of(), List.of());
+        }
+    }
+
+    static final Generator<BigInteger> NUMBER = number(false);
+    /** semver4j/9: a number just above Integer.MAX_VALUE, which a range cannot hold ("too big" for a version). */
+    static final Generator<BigInteger> TOO_BIG = ints(1, 1_000_000).map(d -> MAX_INT.add(BigInteger.valueOf(d)));
+    /** A number written in an npm range: as {@link #NUMBER}, and once in a hundred (semver4j/9, not under HEGEL_NO_KNOWN) too big. */
+    static final Generator<BigInteger> RANGE_NUMBER = Zoo.NO_KNOWN ? NUMBER : weighted(w(55, TINY), w(44, SMALL), w(1, TOO_BIG));
+
+    static Generator<Core> core(Generator<BigInteger> num) {
+        return tuples(num, num, num).map(t -> new Core(t.value1(), t.value2(), t.value3()));
+    }
+
+    static final Generator<Core> CORE = core(NUMBER);
+    static final Generator<Core> RANGE_CORE = core(RANGE_NUMBER);
+
+    /** Every component of a version capped at Integer.MAX_VALUE - 2, so that a version nudged from it still fits an int. */
+    static Ver fit(Ver v) {
+        BigInteger cap = MAX_INT.subtract(BigInteger.TWO);
+        return new Ver(v.major().min(cap), v.minor().min(cap), v.patch().min(cap), v.pre(), v.build());
+    }
+
+    /** Whether the text holds a number above Integer.MAX_VALUE (a range's numbers are its only long digit runs). */
+    static boolean tooBig(String text) {
+        for (String run : text.split("\\D+")) {
+            if (run.length() > 9 && new BigInteger(run).compareTo(MAX_INT) > 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** A numeric identifier: mostly 0..12, else any int; when {@code longDigits}, sometimes 20-26 digits. */
+    static Generator<String> numericId(boolean longDigits) {
+        Generator<String> few = ints(0, 12).map(String::valueOf);
+        Generator<String> any = ints(0, Integer.MAX_VALUE).map(String::valueOf);
+        if (!longDigits) {
+            return weighted(w(70, few), w(30, any));
+        }
+        return weighted(w(70, few), w(22, any), w(8, tuples(ints(18, 24), ints(0, 9)).map(t -> "1" + "0".repeat(t.value1()) + t.value2())));
+    }
+
+    /** An identifier without digits: one of the usual words, or letters and hyphens. */
+    static final Generator<String> ALPHA_ID = weighted(w(80, sampledFrom(ALPHA)), w(20, word("abcxyzABC-", 1, 6)));
+
+    /**
+     * An identifier without digits for a version the range properties compare: any (semver4j/11 is an identifier
+     * beginning with a hyphen ordered below a numeric one); under HEGEL_NO_KNOWN never beginning with a hyphen.
+     */
+    static final Generator<String> TAME_ALPHA_ID = Zoo.NO_KNOWN ? ALPHA_ID.map(id -> id.startsWith("-") ? "a" + id : id) : ALPHA_ID;
+
+    /** An identifier mixing letters, digits and hyphens (never purely numeric); when {@code longDigits}, sometimes with 19-22 nines. */
+    static Generator<String> alnumId(boolean longDigits) {
+        Generator<String> id = weighted(w(70, sampledFrom(ALNUM)), w(30, word("ab-019", 1, 7).map(s -> Spec.isNumeric(s) ? s + "a" : s)));
+        if (!longDigits) {
+            return id;
+        }
+        return weighted(w(90, id), w(10, tuples(sampledFrom("a", "rc", "x"), ints(19, 22)).map(t -> t.value1() + "9".repeat(t.value2()))));
+    }
+
+    static Generator<String> preId(Shape shape) {
+        Generator<String> numeric = numericId(shape.longDigits);
+        if (shape.alnumWithDigits) {
+            return weighted(w(40, numeric), w(35, ALPHA_ID), w(25, alnumId(shape.longDigits)));
+        }
+        return weighted(w(40, numeric), w(60, TAME_ALPHA_ID));
+    }
+
+    static Generator<List<String>> preIds(Shape shape) {
+        return shape.pre ? maybe(45, List.<String>of(), lists(preId(shape)).minSize(1).maxSize(3)) : just(List.of());
+    }
+
+    static final Generator<String> BUILD_ID = oneOf(sampledFrom("001", "build", "sha-1", "20130313144700", "exp", "5114f85", "0", "-"), word("0aZ-9", 1, 6));
+
+    static Generator<List<String>> buildIds(Shape shape) {
+        return shape.build ? maybe(30, List.<String>of(), lists(BUILD_ID).minSize(1).maxSize(2)) : just(List.of());
+    }
+
+    static Generator<Ver> version(Shape shape) {
+        Generator<BigInteger> num = number(shape.bigNumbers);
+        return tuples(num, num, num, preIds(shape), buildIds(shape)).map(t -> new Ver(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+    }
+
+    /** One step from a base version's core: keep it, move one component by -1..2 (not below 0), or reset one to 0..3. */
+    record Move(Kind kind, int component, int amount) {
+        enum Kind { KEEP, STEP, RESET }
+
+        BigInteger[] apply(Ver base) {
+            BigInteger[] c = {base.major(), base.minor(), base.patch()};
+            switch (kind) {
+                case STEP -> c[component] = c[component].add(BigInteger.valueOf(amount)).max(BigInteger.ZERO);
+                case RESET -> c[component] = BigInteger.valueOf(amount);
+                default -> { }
+            }
+            return c;
+        }
+    }
+
+    static final Generator<Move> MOVE = weighted(
+        w(25, just(new Move(Move.Kind.KEEP, 0, 0))),
+        w(60, tuples(ints(0, 2), sampledFrom(-1, 1, 1, 2)).map(t -> new Move(Move.Kind.STEP, t.value1(), t.value2()))),
+        w(15, tuples(ints(0, 2), ints(0, 3)).map(t -> new Move(Move.Kind.RESET, t.value1(), t.value2()))));
+
+    /** How a version close to another is made: a move of the core, then its own pre-release and build. */
+    record Nudge(Move move, List<String> pre, List<String> build) {
+        Ver apply(Ver base) {
+            BigInteger[] c = move.apply(base);
+            return new Ver(c[0], c[1], c[2], pre, build);
+        }
+    }
+
+    static Generator<Nudge> nudge(Shape shape) {
+        return tuples(MOVE, preIds(shape), buildIds(shape)).map(t -> new Nudge(t.value1(), t.value2(), t.value3()));
+    }
+
+    /** A version close to another: the same core with a component nudged, or the same with a pre-release change. */
+    static Generator<Ver> near(Ver base, Shape shape) {
+        return nudge(shape).map(n -> n.apply(base));
+    }
+
+    /** Near one of the bases (weight 60), or a fresh version (weight 40). */
+    static Generator<Ver> nearOrFresh(List<Ver> bases, Shape shape) {
+        return weighted(w(60, sampledFrom(bases).flatMap(b -> near(b, shape))), w(40, version(shape)));
+    }
+
+    /** A sibling of the base in pre-release space: the same core with a fresh, non-empty pre-release list and its own build. */
+    static Generator<Ver> sibling(Ver base, Shape shape) {
+        return tuples(lists(preId(shape)).minSize(1).maxSize(3), buildIds(shape)).map(t -> new Ver(base.major(), base.minor(), base.patch(), t.value1(), t.value2()));
+    }
+
+    /** A version to compare with the bases: a sibling of one of them (weight 50), else {@link #nearOrFresh}. */
+    static Generator<Ver> companion(List<Ver> bases, Shape shape) {
+        return weighted(w(50, sampledFrom(bases).flatMap(b -> sibling(b, shape))), w(50, nearOrFresh(bases, shape)));
+    }
+
+    /** What semver4j accepts around a version's text: sometimes a {@code v}, sometimes blanks on either side. */
+    record Decor(boolean v, String lead, String trail) {
+        String apply(String text) {
+            return lead + (v ? "v" : "") + text + trail;
+        }
+    }
+
+    static final Generator<Decor> DECOR = tuples(chance(15), maybe(10, "", sampledFrom(" ", "\t", "\n", "  ")), maybe(10, "", sampledFrom(" ", "\t", "\n", "\r\n")))
+        .map(t -> new Decor(t.value1(), t.value2(), t.value3()));
+
+    /** The text of a version as semver4j accepts it: canonical, sometimes with a {@code v} and surrounding blanks. */
+    static Generator<String> text(Ver v) {
+        return DECOR.map(d -> d.apply(v.text()));
+    }
+
+    /** A version together with the text it is handed to semver4j as. */
+    record Shown(Ver ver, String text) {}
+
+    static Generator<Shown> shown(Generator<Ver> versions) {
+        return tuples(versions, DECOR).map(t -> new Shown(t.value1(), t.value2().apply(t.value1().text())));
+    }
+
+    // ------------------------------------------------------------------ damaged versions
+
+    /** One damage to a version's text, of a kind the grammar cares about; {@code at} is taken modulo the length. */
+    record Edit(Damage damage, int at, String token) {
+        enum Damage { DELETE, INSERT, LEADING_ZERO, DOUBLE_DOTS, DROP_PATCH, APPEND, UPPER, EQUALS, SWAP_SIGNS, STRIP_BLANKS, TWICE, REPLACE_DIGIT }
+
+        String apply(String s) {
+            return switch (damage) {
+                case DELETE -> s.isEmpty() ? s : s.substring(0, at % s.length()) + s.substring(at % s.length() + 1);
+                case INSERT -> s.substring(0, at % (s.length() + 1)) + token + s.substring(at % (s.length() + 1));
+                case LEADING_ZERO -> s.replaceFirst("(\\d+)", "0$1");
+                case DOUBLE_DOTS -> s.replace(".", "..");
+                case DROP_PATCH -> s.replaceFirst("\\.(\\d+)$", "");
+                case APPEND -> s + token;
+                case UPPER -> s.toUpperCase();
+                case EQUALS -> "=" + s;
+                case SWAP_SIGNS -> s.replaceFirst("-", "+").replaceFirst("\\+", "-");
+                case STRIP_BLANKS -> s.trim().replace(" ", "");
+                case TWICE -> s + " " + s;
+                case REPLACE_DIGIT -> s.replaceFirst("\\d", token);
+            };
+        }
+    }
+
+    static final Generator<Integer> AT = ints(0, 40);
+    static final Generator<Edit> EDIT = weighted(
+        w(1, AT.map(at -> new Edit(Edit.Damage.DELETE, at, ""))),
+        w(1, tuples(AT, sampledFrom(".", "-", "+", "v", "=", " ", "x", "*", "0", "_", "٠", "é", "\u00a0")).map(t -> new Edit(Edit.Damage.INSERT, t.value1(), t.value2()))),
+        w(8, sampledFrom(Edit.Damage.LEADING_ZERO, Edit.Damage.DOUBLE_DOTS, Edit.Damage.DROP_PATCH, Edit.Damage.UPPER, Edit.Damage.EQUALS,
+            Edit.Damage.SWAP_SIGNS, Edit.Damage.STRIP_BLANKS, Edit.Damage.TWICE).map(d -> new Edit(d, 0, ""))),
+        w(1, sampledFrom("-", "+", ".", "-01", "+.", "-a..b", "+a_b", "-é").map(t -> new Edit(Edit.Damage.APPEND, 0, t))),
+        w(1, sampledFrom("x", "X", "*", "١").map(t -> new Edit(Edit.Damage.REPLACE_DIGIT, 0, t))));
+
+    static String edit(String s, List<Edit> edits) {
+        for (Edit e : edits) {
+            s = e.apply(s);
+        }
+        return s;
+    }
+
+    static final Generator<String> FULL_TEXT = shown(version(Shape.FULL)).map(Shown::text);
+
+    /** Text that may or may not be a version: a version, junk over the version alphabet, or a version damaged once or twice. */
+    static final Generator<String> VERSION_LIKE = weighted(
+        w(35, FULL_TEXT),
+        w(10, word("0123456789.-+vVxX*= abABé", 0, 12)),
+        w(55, tuples(FULL_TEXT, lists(EDIT).minSize(1).maxSize(2)).map(t -> edit(t.value1(), t.value2()))));
+
+    // ------------------------------------------------------------------ npm ranges
+
+    static final Generator<String> X_TOKEN = sampledFrom("x", "X", "*");
+
+    /** Pre-release identifiers for a version written inside a range: small numbers or words without digits. */
+    static final Generator<String> TAME_PRE = lists(oneOf(ints(0, 12).map(String::valueOf), TAME_ALPHA_ID)).minSize(1).maxSize(2).map(l -> String.join(".", l));
+
+    /**
+     * The version inside a comparator, written against a {@link Core}: {@code depth} of its numbers ({@code M},
+     * {@code M.m}, {@code M.m.p}; 0 is a bare x-token), the open components sometimes filled with x-tokens, at full
+     * depth sometimes a tame pre-release and a build, and sometimes a {@code v}.
+     */
+    record Body(int depth, List<String> xs, String pre, String build, boolean v) {
+        static Body plain(int depth) {
+            return new Body(depth, List.of(), "", "", false);
+        }
+
+        String render(Core c) {
+            List<String> parts = new ArrayList<>();
+            for (int i = 0; i < depth; i++) {
+                parts.add(c.get(i).toString());
+            }
+            parts.addAll(xs);
+            return (v ? "v" : "") + String.join(".", parts) + pre + build;
+        }
+    }
+
+    /** The least depth of a comparator's body: 0, a bare wildcard (semver4j/5); 1 under HEGEL_NO_KNOWN. */
+    static final int MIN_DEPTH = Zoo.NO_KNOWN ? 1 : 0;
+
+    /** A body of {@code minDepth..maxDepth} numeric components; the open ones sometimes x-tokens. */
+    static Generator<Body> body(int minDepth, int maxDepth) {
+        return ints(minDepth, maxDepth).flatMap(d -> switch (d) {
+            case 0 -> tuples(X_TOKEN, chance(10)).map(t -> new Body(0, List.of(t.value1()), "", "", t.value2()));
+            case 3 -> tuples(maybe(35, "", TAME_PRE.map(p -> "-" + p)), maybe(10, "", sampledFrom("build", "001", "sha.1").map(b -> "+" + b)), chance(10))
+                .map(t -> new Body(3, List.of(), t.value1(), t.value2(), t.value3()));
+            default -> tuples(lists(X_TOKEN).maxSize(3 - d), chance(10)).map(t -> new Body(d, t.value1(), "", "", t.value2()));
+        });
+    }
+
+    /** Something written against one {@link Core}: a comparator or a hyphen range. */
+    interface Piece {
+        String render(Core c);
+    }
+
+    /** {@code op}, sometimes a blank, then a body: a primitive comparator, or a caret or tilde range. */
+    record Comparator(String op, boolean between, Body body) implements Piece {
+        @Override
+        public String render(Core c) {
+            return op + (between && !op.isEmpty() ? " " : "") + body.render(c);
+        }
+
+        /** Whether the operator is one no range grammar has, so the part is no comparator (semver4j/7). */
+        boolean junk() {
+            return !OPS.contains(op) && !ADVANCED_OPS.contains(op);
+        }
+    }
+
+    static final List<String> OPS = List.of("", "<", "<=", ">", ">=", "=");
+    static final List<String> ADVANCED_OPS = List.of("^", "~", "~>");
+    static final Generator<String> OP = sampledFrom("", "", "<", "<=", ">", ">=", "=");
+    /**
+     * semver4j/7: an operator no range grammar has: a misspelt one, or a word (never containing a wildcard letter).
+     * Not {@code >==}: node-semver's x-range pattern eats a stray {@code =} after the operator.
+     */
+    static final Generator<String> JUNK_OP = oneOf(sampledFrom("=>", ">>", "=<"), word("abcdefgo", 1, 5));
+    /** A primitive's operator: one of the six, and (not under HEGEL_NO_KNOWN) three times in a hundred junk. */
+    static final Generator<String> PRIMITIVE_OP = Zoo.NO_KNOWN ? OP : weighted(w(97, OP), w(3, JUNK_OP));
+
+    /**
+     * A primitive comparator ({@code >=1.2.3}, {@code <1.x}, {@code =2}, {@code 1.2.x}) — never a caret, tilde or
+     * hyphen, so that any number of them may share a set. Depth {@link #MIN_DEPTH}..3: a bare wildcard body (depth 0)
+     * is semver4j/5, a junk operator semver4j/7.
+     */
+    static final Generator<Comparator> PRIMITIVE = tuples(PRIMITIVE_OP, chance(15), body(MIN_DEPTH, 3))
+        .map(t -> new Comparator(t.value1(), t.value2(), t.value3())).map(Gen::notGreaterThanAny);
+
+    /**
+     * {@code >*} is read as "nothing" by node-semver ({@code <0.0.0-0}) and as {@code >=0.0.0} by semver4j; neither the
+     * npm range grammar nor the bug record settles it, so that one comparator is written {@code >=*} instead.
+     */
+    static Comparator notGreaterThanAny(Comparator c) {
+        return c.op().equals(">") && c.body().depth() == 0 ? new Comparator(">=", c.between(), c.body()) : c;
+    }
+    static final Generator<Comparator> CARET = tuples(just("^"), chance(10), body(MIN_DEPTH, 3)).map(t -> new Comparator(t.value1(), t.value2(), t.value3()));
+    static final Generator<Comparator> TILDE = tuples(sampledFrom("~", "~", "~>"), chance(10), body(MIN_DEPTH, 3)).map(t -> new Comparator(t.value1(), t.value2(), t.value3()));
+    static final Generator<Comparator> ADVANCED = oneOf(CARET, TILDE);
+    /** A comparator of any kind for a set that mixes them (semver4j/3). */
+    static final Generator<Comparator> ANY_COMPARATOR = weighted(w(70, PRIMITIVE), w(30, ADVANCED));
+
+    static final Generator<String> GAP = weighted(w(80, just(" ")), w(20, sampledFrom("  ", " \t ", "   ")));
+
+    /** A hyphen range {@code l - r}; the right side has numbers of its own. */
+    record Hyphen(Body left, String gap1, String gap2, Body right, Core rightCore) implements Piece {
+        @Override
+        public String render(Core c) {
+            return left.render(c) + gap1 + "-" + gap2 + right.render(rightCore);
+        }
+    }
+
+    static final Generator<Hyphen> HYPHEN = tuples(body(MIN_DEPTH, 3), GAP, GAP, body(MIN_DEPTH, 3), RANGE_CORE).map(t -> new Hyphen(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    /** True for a caret whose major is 0 and whose minor or patch is left open (the {@code ^0.x} shape). */
+    static boolean caretZeroOpen(String part) {
+        return part.matches("\\^\\s*v?0(?:\\.(?:[xX*]|0)(?:\\.[xX*])?)?");
+    }
+
+    /** One {@code ||} alternative of a range. Rendering appends the numbers it was written with to {@code cores}. */
+    sealed interface Alt {
+        String render(List<Core> cores);
+
+        /** Whether one of its parts is no comparator (semver4j/7). */
+        default boolean junk() {
+            return false;
+        }
+    }
+
+    /** The whole-set wildcard. */
+    record Star(Core core) implements Alt {
+        @Override
+        public String render(List<Core> cores) {
+            cores.add(core);
+            return "*";
+        }
+    }
+
+    /** One advanced range (caret, tilde or hyphen): the whole set of its own. */
+    record Single(Core core, Piece piece) implements Alt {
+        @Override
+        public String render(List<Core> cores) {
+            cores.add(core);
+            return piece.render(core);
+        }
+    }
+
+    /** A comparator after the first of a set: its own numbers, or ({@code same}) the previous one's. */
+    record More(String gap, boolean same, Core core, Comparator cmp) {}
+
+    static Generator<More> more(Generator<Comparator> cmp) {
+        return more(RANGE_CORE, cmp);
+    }
+
+    static Generator<More> more(Generator<Core> core, Generator<Comparator> cmp) {
+        return tuples(GAP, chance(50), core, cmp).map(m -> new More(m.value1(), m.value2(), m.value3(), m.value4()));
+    }
+
+    /** The comparators of one set, the first against {@code core}, appending the numbers used to {@code cores}. */
+    static String renderSet(Core core, Comparator first, List<More> more, List<Core> cores) {
+        cores.add(core);
+        StringBuilder sb = new StringBuilder(first.render(core));
+        Core previous = core;
+        for (More m : more) {
+            Core c = m.same() ? previous : m.core();
+            cores.add(c);
+            sb.append(m.gap()).append(m.cmp().render(c));
+            previous = c;
+        }
+        return sb.toString();
+    }
+
+    static boolean anyJunk(Comparator first, List<More> more) {
+        return first.junk() || more.stream().anyMatch(m -> m.cmp().junk());
+    }
+
+    /** One to three primitives sharing a set. */
+    record Primitives(Core core, Comparator first, List<More> more) implements Alt {
+        @Override
+        public String render(List<Core> cores) {
+            return renderSet(core, first, more, cores);
+        }
+
+        @Override
+        public boolean junk() {
+            return anyJunk(first, more);
+        }
+    }
+
+    /**
+     * A comparator standing at position {@code at} (modulo their number) among one or two others in one set: a caret
+     * or tilde beside comparators of any kind (semver4j/3; a hyphen range there is refused by node-semver, so it is
+     * not drawn), or a part that is no comparator (semver4j/7).
+     */
+    record Beside(Core core, String gap, Comparator piece, int at, List<More> more) implements Alt {
+        List<More> pieces() {
+            List<More> pieces = new ArrayList<>(more);
+            pieces.add(at % (more.size() + 1), new More(gap, false, core, piece));
+            return pieces;
+        }
+
+        @Override
+        public String render(List<Core> cores) {
+            List<More> pieces = pieces();
+            More first = pieces.get(0);
+            return renderSet(first.core(), first.cmp(), pieces.subList(1, pieces.size()), cores);
+        }
+
+        @Override
+        public boolean junk() {
+            List<More> pieces = pieces();
+            return anyJunk(pieces.get(0).cmp(), pieces.subList(1, pieces.size()));
+        }
+    }
+
+    static final Generator<Alt> STAR = RANGE_CORE.map(Star::new);
+    static final Generator<Alt> PRIMITIVES = tuples(RANGE_CORE, PRIMITIVE, lists(more(PRIMITIVE)).maxSize(2))
+        .map(t -> new Primitives(t.value1(), t.value2(), t.value3()));
+    /** semver4j/3: a caret or tilde beside one or two comparators of any kind. */
+    static final Generator<Alt> MIXED = tuples(RANGE_CORE, GAP, ADVANCED, ints(0, 2), lists(more(ANY_COMPARATOR)).minSize(1).maxSize(2))
+        .map(t -> new Beside(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+    static final Generator<Alt> ANY_CARET_SET = tuples(RANGE_CORE, CARET).map(t -> new Single(t.value1(), t.value2()));
+    /** A caret set; {@code ^0.x} is semver4j/4, filtered out under HEGEL_NO_KNOWN (a few per cent of carets). */
+    static final Generator<Alt> CARET_SET = Zoo.NO_KNOWN ? ANY_CARET_SET.filter(a -> !caretZeroOpen(a.render(new ArrayList<>()))) : ANY_CARET_SET;
+    static final Generator<Alt> TILDE_SET = tuples(RANGE_CORE, TILDE).map(t -> new Single(t.value1(), t.value2()));
+    static final Generator<Alt> HYPHEN_SET = tuples(RANGE_CORE, HYPHEN).map(t -> new Single(t.value1(), t.value2()));
+
+    /**
+     * A set: {@code *}, several primitives, one advanced range, or (semver4j/3, not under HEGEL_NO_KNOWN) an advanced
+     * range beside other comparators. A hyphen range with pre-releases included is a documented difference from
+     * node-semver (semver4j keeps >=1.2.3 where node lowers the bound to >=1.2.3-0), so it is not generated then.
+     */
+    static Generator<Alt> alt(boolean includePreRelease) {
+        Generator<Alt> advanced = includePreRelease ? oneOf(CARET_SET, TILDE_SET) : oneOf(CARET_SET, TILDE_SET, HYPHEN_SET);
+        return Zoo.NO_KNOWN
+            ? weighted(w(10, STAR), w(95, PRIMITIVES), w(95, advanced))
+            : weighted(w(10, STAR), w(95, PRIMITIVES), w(95, advanced), w(40, MIXED));
+    }
+
+    static final Generator<String> SEP = weighted(w(80, just(" || ")), w(20, sampledFrom("||", " ||", "|| ", "  ||  ")));
+    /** semver4j/8: a {@code ||} after the last set (an empty alternative, "any version"); never under HEGEL_NO_KNOWN. */
+    static final Generator<String> TRAILING_OR = Zoo.NO_KNOWN ? just("") : maybe(8, "", sampledFrom(" ||", "||", " || ", " ||  "));
+
+    /**
+     * An npm range: its text, how many sets it has (a trailing {@code ||} counts one), the cores used (to draw tested
+     * versions near), whether a part is no comparator ({@link Alt#junk}), and whether a number is too big for an int.
+     */
+    record Range(String text, int sets, List<Core> cores, boolean junk, boolean tooBig) {}
+
+    /** An npm range of one to three sets joined by {@code ||}, sometimes with a blank at either end or a trailing {@code ||}. */
+    static Generator<Range> npmRange(boolean includePreRelease) {
+        Generator<Alt> alt = alt(includePreRelease);
+        return npmRange(just(""), alt, alt, TRAILING_OR);
+    }
+
+    /**
+     * An npm range: {@code leading} ({@code ||} or nothing), the {@code first} set, up to two more {@code others}
+     * behind separators, {@code trailing} ({@code ||} or nothing), sometimes a blank at either end. An empty
+     * alternative at either end counts as a set.
+     */
+    static Generator<Range> npmRange(Generator<String> leading, Generator<Alt> first, Generator<Alt> others, Generator<String> trailing) {
+        return tuples(leading, first, lists(tuples(SEP, others)).maxSize(2), chance(10), chance(10), trailing).map(t -> {
+            List<Core> cores = new ArrayList<>();
+            StringBuilder sb = new StringBuilder(t.value2().render(cores));
+            boolean junk = t.value2().junk();
+            for (Tuple2<String, Alt> more : t.value3()) {
+                sb.append(more.value1()).append(more.value2().render(cores));
+                junk |= more.value2().junk();
+            }
+            String text = (t.value4() ? " " : "") + t.value1() + sb + t.value6() + (t.value5() ? " " : "");
+            int sets = 1 + t.value3().size() + (t.value1().isEmpty() ? 0 : 1) + (t.value6().isEmpty() ? 0 : 1);
+            return new Range(text, sets, cores, junk, tooBig(text));
+        });
+    }
+
+    // ------------------------------------------------------------------ Ivy
+
+    /** An Ivy bound: the first {@code depth} (1-3) numbers of a core. */
+    static String ivyBound(Core c, int depth) {
+        return Body.plain(depth).render(c);
+    }
+}
diff --git a/hegel/src/test/java/zoo/Node.java b/hegel/src/test/java/zoo/Node.java
new file mode 100644
index 0000000..8b3ab10
--- /dev/null
+++ b/hegel/src/test/java/zoo/Node.java
@@ -0,0 +1,134 @@
+package zoo;
+
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * node-semver as an oracle: a {@code node node/oracle.js} child fed one request per line (operation and JSON-quoted
+ * string arguments separated by tabs) that answers one line per request (tab-separated fields). Started lazily, once.
+ */
+final class Node {
+    private Node() {}
+
+    private static Process process;
+    private static BufferedWriter in;
+    private static BufferedReader out;
+    private static String failure;
+
+    /** A parsed version as node-semver sees it, or null when it rejects the text. */
+    record Parsed(long major, long minor, long patch, List<String> pre, List<String> build, String version) {}
+
+    static synchronized String call(String op, String... args) {
+        start();
+        if (failure != null) {
+            throw new IllegalStateException("node oracle unavailable: " + failure);
+        }
+        StringBuilder sb = new StringBuilder(op);
+        for (String a : args) {
+            sb.append('\t').append(quote(a));
+        }
+        try {
+            in.write(sb.toString());
+            in.write('\n');
+            in.flush();
+            String reply = out.readLine();
+            if (reply == null) {
+                failure = "child exited";
+                throw new IllegalStateException("node oracle exited (request " + sb + ")");
+            }
+            return reply;
+        } catch (IOException e) {
+            failure = e.toString();
+            throw new IllegalStateException("node oracle I/O failure", e);
+        }
+    }
+
+    static Parsed parse(String text) {
+        String r = call("parse", text);
+        if (r.equals("null") || r.startsWith("ERR")) {
+            return null;
+        }
+        String[] f = r.split("\t", -1);
+        return new Parsed(Long.parseLong(f[0]), Long.parseLong(f[1]), Long.parseLong(f[2]),
+            f[3].isEmpty() ? List.of() : Arrays.asList(f[3].split("\\.")),
+            f[4].isEmpty() ? List.of() : Arrays.asList(f[4].split("\\.")), f[5]);
+    }
+
+    /** -1, 0, 1, or null when node-semver rejects one of the versions. */
+    static Integer compare(String a, String b) {
+        String r = call("cmp", a, b);
+        return r.startsWith("ERR") ? null : Integer.valueOf(r);
+    }
+
+    /** true/false, or null when node-semver rejects the range or the version. */
+    static Boolean satisfies(String version, String range, boolean includePrerelease) {
+        String r = call("sat", version, range, includePrerelease ? "1" : "0");
+        return r.startsWith("ERR") ? null : Boolean.valueOf(r);
+    }
+
+    /** node-semver's normalised range text, or null for an invalid range. */
+    static String validRange(String range, boolean includePrerelease) {
+        String r = call("valid", range, includePrerelease ? "1" : "0");
+        return r.equals("null") || r.startsWith("ERR") ? null : r;
+    }
+
+    static String coerce(String text) {
+        String r = call("coerce", text);
+        return r.equals("null") || r.startsWith("ERR") ? null : r;
+    }
+
+    static String inc(String version, String kind) {
+        String r = call("inc", version, kind);
+        return r.equals("null") || r.startsWith("ERR") ? null : r;
+    }
+
+    private static void start() {
+        if (process != null || failure != null) {
+            return;
+        }
+        Path script = Paths.get(System.getProperty("basedir", "."), "node", "oracle.js").toAbsolutePath();
+        if (!Files.isRegularFile(script)) {
+            failure = "missing " + script;
+            return;
+        }
+        try {
+            ProcessBuilder pb = new ProcessBuilder("node", script.toString());
+            pb.redirectError(ProcessBuilder.Redirect.INHERIT);
+            process = pb.start();
+            in = new BufferedWriter(new OutputStreamWriter(process.getOutputStream(), StandardCharsets.UTF_8));
+            out = new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8));
+            Runtime.getRuntime().addShutdownHook(new Thread(process::destroy));
+            String v = call("version");
+            if (!v.matches("\\d+\\.\\d+\\.\\d+")) {
+                failure = "unexpected version reply " + v;
+            }
+        } catch (IOException e) {
+            failure = e.toString();
+        }
+    }
+
+    /** JSON string literal (JSON.parse on the other side). */
+    static String quote(String s) {
+        StringBuilder sb = new StringBuilder("\"");
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '"' || c == '\\') {
+                sb.append('\\').append(c);
+            } else if (c < 0x20 || c == 0x7f || c == '\u00a0' || c == '\u2028' || c == '\u2029' || (c >= 0xd800 && c <= 0xdfff)) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.append('"').toString();
+    }
+}
diff --git a/hegel/src/test/java/zoo/Semver4jPinsTest.java b/hegel/src/test/java/zoo/Semver4jPinsTest.java
new file mode 100644
index 0000000..ad4c69c
--- /dev/null
+++ b/hegel/src/test/java/zoo/Semver4jPinsTest.java
@@ -0,0 +1,197 @@
+package zoo;
+
+import static zoo.Zoo.check;
+
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+import org.semver4j.Semver;
+import org.semver4j.SemverException;
+import org.semver4j.range.RangeExpression;
+import org.semver4j.range.RangeList;
+import org.semver4j.range.RangeListFactory;
+
+/**
+ * One pin per recorded bug (bugs.toml). Each asserts the correct behaviour on a minimal input and is listed in
+ * [expected_failures] of target.toml, so it fails while the bug exists and flags the fix when it stops failing.
+ */
+class Semver4jPinsTest {
+
+    static Object attempt(Supplier<Object> s) {
+        try {
+            return s.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String describe(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : String.valueOf(o);
+    }
+
+    static Object cmp(String a, String b) {
+        return attempt(() -> Integer.signum(new Semver(a).compareTo(new Semver(b))));
+    }
+
+    static Object sat(String version, String range) {
+        return attempt(() -> new Semver(version).satisfies(range));
+    }
+
+    /** semver4j/1: numeric pre-release identifiers are unbounded; comparing one of 20 digits throws NumberFormatException. */
+    @Test
+    void pin_longIdentifierCompare() {
+        Object a = cmp("1.0.0-99999999999999999999", "1.0.0-1");
+        Object b = cmp("1.0.0-rc99999999999999999999", "1.0.0-rc1");
+        Object c = cmp("1.0.0-99999999999999999999", "1.0.0-99999999999999999998");
+        check(a instanceof Integer i && i == 1, () -> "compareTo(1.0.0-99999999999999999999, 1.0.0-1) = " + describe(a));
+        check(b instanceof Integer i && i == 1, () -> "compareTo(1.0.0-rc99999999999999999999, 1.0.0-rc1) = " + describe(b));
+        check(c instanceof Integer i && i == 1, () -> "compareTo(1.0.0-99999999999999999999, 1.0.0-99999999999999999998) = " + describe(c));
+    }
+
+    /** semver4j/2: alphanumeric identifiers containing digits are not compared in ASCII order, and the order is not transitive. */
+    @Test
+    void pin_alnumIdentifierOrder() {
+        Object x = cmp("1.0.0-a1b2", "1.0.0-b1");
+        Object y = cmp("1.0.0-b1", "1.0.0-b");
+        Object z = cmp("1.0.0-b", "1.0.0-a1b2");
+        check(x instanceof Integer i && i == -1, () -> "compareTo(1.0.0-a1b2, 1.0.0-b1) = " + describe(x) + " (ASCII order says -1; with " + describe(y) + " and " + describe(z) + " the order is a cycle)");
+        Object w = cmp("1.0.0-a2", "1.0.0-a10");
+        check(w instanceof Integer i && i == 1, () -> "compareTo(1.0.0-a2, 1.0.0-a10) = " + describe(w) + " (ASCII order says 1)");
+        Object v = cmp("1.0.0-1a", "1.0.0-2");
+        check(v instanceof Integer i && i == 1, () -> "compareTo(1.0.0-1a, 1.0.0-2) = " + describe(v) + " (numeric identifiers rank below alphanumeric ones)");
+    }
+
+    /** semver4j/3: a caret, tilde or hyphen range sharing a set with other comparators is dropped from the set. */
+    @Test
+    void pin_caretKeptBesideComparators() {
+        Object a = sat("0.5.0", "^1.0.0 <1.5.0");
+        Object b = sat("5.0.0", "~1.2.3 >=1.2.5");
+        Object c = sat("1.3.0", "^1.0.0 ^1.2.0");
