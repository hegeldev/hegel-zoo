+            List<List<Range>> sets = new ArrayList<>();
+            List<List<Ver>> setVers = new ArrayList<>();
+            List<Ver> all = new ArrayList<>();
+            for (List<Entry> entries : drawn) {
+                List<Range> set = new ArrayList<>();
+                List<Ver> vers = new ArrayList<>();
+                for (Entry e : entries) {
+                    Ver v = e.rel().resolve(all);
+                    all.add(v);
+                    vers.add(v);
+                    String vt = e.decor().apply(v.text());
+                    set.add(e.asSemver() ? new Range(new Semver(vt), e.op()) : new Range(vt, e.op()));
+                }
+                rl.add(set);
+                if (!set.isEmpty()) {
+                    sets.add(set);
+                    setVers.add(vers);
+                }
+            }
+            check(rl.get().equals(sets), () -> "RangeList holds " + rl.get() + ", expected " + sets);
+            for (Tuple2<Rel, Decor> tested : tc.draw(TESTED, "versions")) {
+                Ver v = tested.value1().resolve(all);
+                String vt = tested.value2().apply(v.text());
+                Semver sv = new Semver(vt);
+                boolean expected = false;
+                for (int s = 0; s < sets.size(); s++) {
+                    boolean holds = true;
+                    boolean preAllowed = v.pre().isEmpty() || include;
+                    for (int i = 0; i < sets.get(s).size(); i++) {
+                        Range range = sets.get(s).get(i);
+                        Ver rv = setVers.get(s).get(i);
+                        int c = Spec.compare(v, rv);
+                        boolean one = switch (range.getRangeOperator()) {
+                            case EQ -> c == 0;
+                            case LT -> c < 0;
+                            case LTE -> c <= 0;
+                            case GT -> c > 0;
+                            case GTE -> c >= 0;
+                        };
+                        final boolean want = one;
+                        Object got = attempt(() -> range.isSatisfiedBy(sv));
+                        check(got instanceof Boolean b && b == want, () -> range + ".isSatisfiedBy(" + show(vt) + ") = " + describe(got) + ", expected " + want);
+                        Object viaText = attempt(() -> range.isSatisfiedBy(vt));
+                        check(viaText instanceof Boolean b && b == want, () -> range + ".isSatisfiedBy(String " + show(vt) + ") = " + describe(viaText) + ", expected " + want);
+                        holds &= one;
+                        if (!rv.pre().isEmpty() && rv.core().equals(v.core())) {
+                            preAllowed = true;
+                        }
+                    }
+                    expected |= holds && preAllowed;
+                }
+                final boolean want = expected;
+                Object got = attempt(() -> rl.isSatisfiedBy(sv));
+                check(got instanceof Boolean b && b == want, () -> rl + ".isSatisfiedBy(" + show(vt) + ")" + (include ? " with pre-releases" : "") + " = " + describe(got) + ", the model says " + want);
+                Object viaSemver = attempt(() -> sv.satisfies(rl));
+                check(viaSemver instanceof Boolean b && b == want, () -> "satisfies(RangeList) = " + describe(viaSemver) + ", expected " + want);
+            }
+        }, Zoo.settings("rangeListsEvaluateLikeTheModel"));
+    }
+
+    // ------------------------------------------------------------------ fluent expressions
+
+    record Built(RangeExpression expression, String text, String tree) {}
+
+    enum Cmp {
+        EQ("="), GT(">"), GTE(">="), LT("<"), LTE("<=");
+
+        final String sign;
+
+        Cmp(String sign) {
+            this.sign = sign;
+        }
+
+        RangeExpression of(String text) {
+            return switch (this) {
+                case EQ -> RangeExpression.eq(text);
+                case GT -> RangeExpression.greater(text);
+                case GTE -> RangeExpression.greaterOrEqual(text);
+                case LT -> RangeExpression.less(text);
+                case LTE -> RangeExpression.lessOrEqual(text);
+            };
+        }
+
+        RangeExpression of(Semver v) {
+            return switch (this) {
+                case EQ -> RangeExpression.eq(v);
+                case GT -> RangeExpression.greater(v);
+                case GTE -> RangeExpression.greaterOrEqual(v);
+                case LT -> RangeExpression.less(v);
+                case LTE -> RangeExpression.lessOrEqual(v);
+            };
+        }
+    }
+
+    /** An operand of a fluent chain, built left to right; every version it resolves is appended to {@code all}. */
+    sealed interface Operand {
+        Built build(List<Ver> all);
+    }
+
+    /** One comparison of a version, given as text or as a Semver. */
+    record Leaf(Rel rel, Cmp cmp, boolean asString) implements Operand {
+        @Override
+        public Built build(List<Ver> all) {
+            Ver v = rel.resolve(all);
+            all.add(v);
+            String text = v.text();
+            RangeExpression e = asString ? cmp.of(text) : cmp.of(new Semver(text));
+            return new Built(e, cmp.sign + text, cmp.sign + text);
+        }
+    }
+
+    record Link(boolean or, Operand operand) {}
+
+    /** A leaf followed by up to three operands joined with and/or. */
+    record Chain(Leaf first, List<Link> links) implements Operand {
+        @Override
+        public Built build(List<Ver> all) {
+            Built b = first.build(all);
+            for (Link link : links) {
+                Built o = link.operand().build(all);
+                if (link.or()) {
+                    b = new Built(b.expression.or(o.expression), b.text + " || " + o.text, "(" + b.tree + " OR " + o.tree + ")");
+                } else {
+                    b = new Built(b.expression.and(o.expression), b.text + " " + o.text, "(" + b.tree + " AND " + o.tree + ")");
+                }
+                if (o.text.contains("||")) {
+                    break; // semver4j/12: anything chained after a multi-set operand starts a new set
+                }
+            }
+            return b;
+        }
+    }
+
+    static final Generator<Leaf> LEAF = tuples(rel(chance(60)), sampledFrom(Cmp.values()), chance(50)).map(t -> new Leaf(t.value1(), t.value2(), t.value3()));
+    static final Generator<Operand> LEAF_OPERAND = LEAF.map(l -> l);
+
+    /** A chain whose operands are leaves or, up to {@code depth} deep, chains of their own. */
+    static Generator<Operand> chain(int depth) {
+        Generator<Operand> operand = depth > 0 ? weighted(w(70, LEAF_OPERAND), w(30, chain(depth - 1))) : LEAF_OPERAND;
+        Generator<Link> link = tuples(chance(50), operand).map(t -> new Link(t.value1(), t.value2()));
+        return tuples(LEAF, lists(link).maxSize(3)).map(t -> new Chain(t.value1(), t.value2()));
+    }
+
+    static final Generator<Operand> CHAIN = chain(1);
+
+    /** The fluent RangeExpression is the string form written left to right: {@code and} is a space, {@code or} is {@code ||}. */
+    @Test
+    void fluentExpressionsMatchStrings() {
+        Hegel.test(tc -> {
+            List<Ver> all = new ArrayList<>();
+            Built b = tc.draw(CHAIN, "chain").build(all);
+            RangeList fromText = RangeListFactory.create(b.text);
+            RangeList fromExpression = RangeListFactory.create(b.expression);
+            check(fromExpression.get().equals(fromText.get()), () -> "expression " + b.tree + " (text " + b.text + ") built the sets " + fromExpression.get() + ", the text parses to " + fromText.get());
+            for (Tuple2<Rel, Decor> tested : tc.draw(TESTED, "versions")) {
+                Ver v = tested.value1().resolve(all);
+                Semver sv = new Semver(tested.value2().apply(v.text()));
+                Object viaText = attempt(() -> sv.satisfies(b.text));
+                Object viaExpression = attempt(() -> sv.satisfies(b.expression));
+                check(viaExpression instanceof Boolean x && viaText instanceof Boolean y && x.equals(y), () -> sv + " satisfies the expression " + b.text + ": fluent " + describe(viaExpression) + ", text " + describe(viaText));
+            }
+        }, Zoo.settings("fluentExpressionsMatchStrings"));
+    }
+
+    // ------------------------------------------------------------------ modifiers
+
+    static Object same(Object got, Ver expected) {
+        return got instanceof Semver s && s.getVersion().equals(expected.text()) ? null : describe(got);
+    }
+
+    /** A build identifier for withBuild: a word without hyphens, or a small number. */
+    static final Generator<String> NEW_BUILD_ID = oneOf(Gen.ALPHA_ID.map(a -> a.replace("-", "x")), ints(0, 99).map(String::valueOf));
+
+    /** The next, withInc, with and withCleared families produce the documented versions; next agrees with node-semver's inc. */
+    @Test
+    void modifiersMatchTheModel() {
