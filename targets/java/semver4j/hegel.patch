+    static Generator<Gen.Alt> single(Generator<Core> core, Generator<? extends Gen.Piece> piece) {
+        return tuples(core, piece).map(t -> new Gen.Single(t.value1(), t.value2()));
+    }
+
+    /** A core whose major is 1 or more: no caret on it is semver4j/4. */
+    static final Generator<Core> POSITIVE_CORE = Gen.core(ints(1, 250).map(BigInteger::valueOf));
+    /** A primitive with a plain operator and a body of one to three numbers: the neighbour of a shaped comparator in a narrow property's set. */
+    static final Generator<Gen.Comparator> PLAIN = comparator(Gen.OP, Gen.body(1, 3));
+    /** A caret, tilde or tilde-arrow comparator with a body of one to three numbers. */
+    static final Generator<Gen.Comparator> PLAIN_ADVANCED = comparator(sampledFrom("^", "~", "~>"), Gen.body(1, 3));
+    /** A set of no recorded bug's shape: {@code *}, one plain primitive, or one plain advanced comparator on a positive core. */
+    static final Generator<Gen.Alt> PLAIN_SET = oneOf(Gen.STAR, single(Gen.CORE, PLAIN), single(POSITIVE_CORE, PLAIN_ADVANCED));
+
+    /** semver4j/3: a caret or tilde among one or two plain primitives in one set (alone in its set under HEGEL_NO_KNOWN). */
+    static final Generator<Gen.Alt> CARET_BESIDE_COMPARATORS = Zoo.NO_KNOWN
+        ? oneOf(Gen.CARET_SET, Gen.TILDE_SET)
+        : tuples(POSITIVE_CORE, Gen.GAP, PLAIN_ADVANCED, ints(0, 2), lists(Gen.more(POSITIVE_CORE, PLAIN)).minSize(1).maxSize(2))
+            .map(t -> new Gen.Beside(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    static final BigInteger ZERO = BigInteger.ZERO;
+    /** A core with major and minor 0. */
+    static final Generator<Core> ZERO_CORE = Gen.NUMBER.map(p -> new Core(ZERO, ZERO, p));
+    /** A core with major 0 and a minor of 1 or more. */
+    static final Generator<Core> ZERO_MAJOR_CORE = tuples(ints(1, 250), Gen.NUMBER).map(t -> new Core(ZERO, BigInteger.valueOf(t.value1()), t.value2()));
+
+    /** A body of {@code depth} numbers followed by up to {@code maxXs} x-tokens, sometimes with a v. */
+    static Generator<Gen.Body> openBody(int depth, int maxXs) {
+        return tuples(lists(Gen.X_TOKEN).maxSize(maxXs), chance(10)).map(t -> new Gen.Body(depth, t.value1(), "", "", t.value2()));
+    }
+
+    static Generator<Gen.Alt> caretSet(Generator<Core> core, Generator<Gen.Body> body) {
+        return single(core, tuples(chance(10), body).map(t -> new Gen.Comparator("^", t.value1(), t.value2())));
+    }
+
+    /** semver4j/4: {@code ^0}, {@code ^0.x}, {@code ^0.x.x}, {@code ^0.0}, {@code ^0.0.x}; under HEGEL_NO_KNOWN {@code ^0.m}, {@code ^0.m.x} (m >= 1) and {@code ^0.0.p}. */
+    static final Generator<Gen.Alt> CARET_ZERO_OPEN = Zoo.NO_KNOWN
+        ? oneOf(caretSet(ZERO_MAJOR_CORE, openBody(2, 1)), caretSet(ZERO_CORE, openBody(3, 0)))
+        : oneOf(caretSet(ZERO_CORE, openBody(1, 2)), caretSet(ZERO_CORE, openBody(2, 1)));
+
+    /** A body that is a bare wildcard (semver4j/5); one number under HEGEL_NO_KNOWN. */
+    static final Generator<Gen.Body> BARE = Zoo.NO_KNOWN ? Gen.body(1, 1) : Gen.body(0, 0);
+    /** The core a bare body is written against; under HEGEL_NO_KNOWN its major is 1 or more ({@code ^0} would be semver4j/4). */
+    static final Generator<Core> BARE_CORE = Zoo.NO_KNOWN ? POSITIVE_CORE : Gen.CORE;
+    static Generator<Gen.Comparator> comparator(Generator<String> op, Generator<Gen.Body> body) {
+        return tuples(op, chance(10), body).map(t -> new Gen.Comparator(t.value1(), t.value2(), t.value3())).map(Gen::notGreaterThanAny);
+    }
+
+    /** A hyphen range from {@code left} to {@code right}, each side against its own core drawn from {@code core}; sometimes the sides swapped. */
+    static Generator<Gen.Alt> hyphen(Generator<Core> core, Generator<Gen.Body> left, Generator<Gen.Body> right) {
+        return tuples(core, left, Gen.GAP, Gen.GAP, right, core, chance(50))
+            .map(t -> new Gen.Single(t.value1(), t.value7() ? new Gen.Hyphen(t.value5(), t.value3(), t.value4(), t.value2(), t.value6()) : new Gen.Hyphen(t.value2(), t.value3(), t.value4(), t.value5(), t.value6())));
+    }
+
+    /** The alternatives, the last one (a hyphen range) only without pre-releases included: the documented difference from node-semver, see {@link Gen#alt}. */
+    @SafeVarargs
+    static Generator<Gen.Alt> withHyphenUnlessPre(boolean pre, Generator<Gen.Alt> hyphen, Generator<Gen.Alt>... others) {
+        List<Generator<Gen.Alt>> all = new ArrayList<>(List.of(others));
+        if (!pre) {
+            all.add(hyphen);
+        }
+        return all.size() == 1 ? all.get(0) : all.size() == 2 ? oneOf(all.get(0), all.get(1)) : oneOf(all.get(0), all.get(1), all.get(2));
+    }
+
+    /** semver4j/5: a wildcard standing for the whole version: bare or behind an operator, a caret or a tilde, beside a primitive, or on one side of a hyphen. */
+    static Generator<Gen.Alt> bareWildcard(boolean pre) {
+        return withHyphenUnlessPre(pre, hyphen(BARE_CORE, Gen.body(1, 3), BARE),
+            single(BARE_CORE, comparator(oneOf(Gen.OP, sampledFrom("^", "~", "~>")), BARE)),
+            tuples(BARE_CORE, PLAIN, Gen.more(BARE_CORE, comparator(Gen.OP, BARE)), chance(50)).map(t -> t.value4()
+                ? new Gen.Primitives(t.value1(), t.value3().cmp(), List.of(new Gen.More(t.value3().gap(), t.value3().same(), t.value3().core(), t.value2())))
+                : new Gen.Primitives(t.value1(), t.value2(), List.of(t.value3()))));
+    }
