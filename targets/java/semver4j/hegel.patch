+            Object cpb = attempt(s::withClearedPreReleaseAndBuild);
+            check(same(wp, v.withPre(newPre)) == null, () -> "withPreRelease(" + String.join(".", newPre) + ") of " + s + " = " + describe(wp) + ", expected " + v.withPre(newPre).text());
+            check(same(wb, v.withBuild(newBuild)) == null, () -> "withBuild(" + String.join(".", newBuild) + ") of " + s + " = " + describe(wb) + ", expected " + v.withBuild(newBuild).text());
+            check(same(cp, v.withPre(List.of())) == null, () -> "withClearedPreRelease of " + s + " = " + describe(cp));
+            check(same(cb, v.withBuild(List.of())) == null, () -> "withClearedBuild of " + s + " = " + describe(cb));
