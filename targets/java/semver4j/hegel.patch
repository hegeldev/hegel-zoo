+    /** RangeList/Range built directly from operators and versions evaluate as OR of ANDs with the pre-release rule. */
+    @Test
+    void rangeListsEvaluateLikeTheModel() {
+        Hegel.test(tc -> {
+            boolean include = chance(tc, 50);
+            RangeList rl = new RangeList(include);
