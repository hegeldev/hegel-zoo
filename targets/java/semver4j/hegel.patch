+    /** The oracle of the Ivy properties: the interval parses (a bound above Integer.MAX_VALUE may be refused as "too big") and versions near its bounds satisfy it as the interval model says. */
+    static void ivy(TestCase tc, Interval iv, boolean include) {
+        String range = iv.text();
+        Ver lo = iv.lo();
+        Ver hi = iv.hi();
+        Object made = attempt(() -> RangeListFactory.create(range, include));
+        if (Gen.tooBig(range) && made instanceof SemverException) {
+            return; // a bound above Integer.MAX_VALUE, refused as the version parser refuses it
+        }
+        check(made instanceof RangeList, () -> "RangeListFactory.create(" + show(range) + ") threw " + describe(made)
+            + (Gen.tooBig(range) ? " for a number above Integer.MAX_VALUE (versions say SemverException: Value [...] is too big)" : ""));
+        if (!(made instanceof RangeList rl)) {
+            return;
+        }
+        List<Shown> versions = tc.draw(lists(Gen.shown(oneOf(Gen.near(Gen.fit(lo), Shape.TAME), Gen.near(Gen.fit(hi), Shape.TAME)))).minSize(1).maxSize(3), "versions");
+        for (Shown sh : versions) {
+            Ver v = sh.ver();
+            boolean expected = true;
+            if (!iv.ivy().lowerOpen()) {
+                int c = Spec.compare(v, lo);
+                expected &= iv.ivy().lowerIncl() ? c >= 0 : c > 0;
+            }
+            if (!iv.ivy().upperOpen()) {
