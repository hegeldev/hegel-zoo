+            for (Shown sh : versions) {
+                Ver v = sh.ver();
+                boolean expected = true;
+                if (!iv.ivy().lowerOpen()) {
+                    int c = Spec.compare(v, lo);
+                    expected &= iv.ivy().lowerIncl() ? c >= 0 : c > 0;
+                }
+                if (!iv.ivy().upperOpen()) {
+                    int c = Spec.compare(v, hi);
+                    expected &= iv.ivy().upperIncl() ? c <= 0 : c < 0;
+                }
+                if (!v.pre().isEmpty() && !include) {
+                    expected = false;
+                }
