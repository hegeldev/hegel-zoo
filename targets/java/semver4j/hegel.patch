+    /** One Ivy notation: the brackets, which bounds are open, which are inclusive; or one of the two {@code latest} words. */
+    record Ivy(String open, String close, boolean lowerOpen, boolean upperOpen, boolean lowerIncl, boolean upperIncl, String word) {}
+
+    static final List<Ivy> IVY = List.of(
+        new Ivy("[", "]", false, false, true, true, null),
+        new Ivy("[", "[", false, false, true, false, null),
+        new Ivy("]", "]", false, false, false, true, null),
+        new Ivy("]", "[", false, false, false, false, null),
+        new Ivy("[", ")", false, true, true, false, null),
+        new Ivy("]", ")", false, true, false, false, null),
+        new Ivy("(", "]", true, false, false, true, null),
+        new Ivy("(", "[", true, false, false, false, null),
+        new Ivy("", "", true, true, false, false, "latest"),
+        new Ivy("", "", true, true, false, false, "latest.integration"));
+
+    /** semver4j/6: both bounds present with the bracket styles mixed, which the tokenizer accepts. */
+    static final List<Ivy> MIXED_IVY = List.of(
+        new Ivy("[", ")", false, false, true, false, null),
+        new Ivy("]", ")", false, false, false, false, null),
+        new Ivy("(", "]", false, false, false, true, null),
+        new Ivy("(", "[", false, false, false, false, null),
+        new Ivy("(", ")", false, false, false, false, null));
+
+    static <T> List<T> concat(List<T> a, List<T> b) {
+        List<T> out = new ArrayList<>(a);
+        out.addAll(b);
+        return out;
+    }
+
+    /** Every notation, the mixed ones (semver4j/6) included unless HEGEL_NO_KNOWN is set. */
+    static final Generator<Ivy> NOTATION = sampledFrom(Zoo.NO_KNOWN ? IVY : concat(IVY, MIXED_IVY));
+
+    /** An Ivy interval: a notation and two bounds of one to three numbers each. */
+    record Interval(Ivy ivy, Core lc, int lowerDepth, Core rc, int upperDepth) {
+        String text() {
+            if (ivy.word() != null) {
+                return ivy.word();
+            }
+            return ivy.open() + (ivy.lowerOpen() ? "" : Gen.ivyBound(lc, lowerDepth)) + "," + (ivy.upperOpen() ? "" : Gen.ivyBound(rc, upperDepth)) + ivy.close();
+        }
+
+        /** A bound written with fewer components is completed with zeros. */
+        static Ver bound(Core c, int depth) {
+            return new Ver(c.major(), depth > 1 ? c.minor() : BigInteger.ZERO, depth > 2 ? c.patch() : BigInteger.ZERO, List.of(), List.of());
+        }
+
+        Ver lo() {
+            return bound(lc, lowerDepth);
+        }
+
+        Ver hi() {
+            return bound(rc, upperDepth);
+        }
+    }
+
+    static Generator<Interval> interval(Generator<Ivy> notation, Generator<Core> core) {
+        return tuples(notation, core, ints(1, 3), core, ints(1, 3)).map(t -> new Interval(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+    }
