+
+    /** Two versions on one core whose pre-release lists begin with {@code x} and {@code y}, then more identifiers; sometimes swapped. */
+    record IdPair(Core core, String x, String y, List<String> restA, List<String> restB, List<String> buildA, List<String> buildB, boolean swap) {
+        Ver a() {
+            return swap ? ver(y, restB, buildB) : ver(x, restA, buildA);
+        }
+
+        Ver b() {
+            return swap ? ver(x, restA, buildA) : ver(y, restB, buildB);
+        }
+
+        Ver ver(String first, List<String> rest, List<String> build) {
+            List<String> pre = new ArrayList<>();
+            pre.add(first);
+            pre.addAll(rest);
+            return new Ver(core.major(), core.minor(), core.patch(), pre, build);
+        }
+    }
+
+    static Generator<IdPair> idPair(Generator<String> x, Generator<String> y) {
+        Generator<List<String>> rest = lists(Gen.preId(Shape.TAME)).maxSize(2);
+        Generator<List<String>> build = Gen.buildIds(Shape.TAME);
+        return tuples(Gen.CORE, x, y, rest, rest, build, build, chance(50))
+            .map(t -> new IdPair(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+    }
+
+    /** A run of 20-26 digits (semver4j/1; 10-18 under HEGEL_NO_KNOWN) with a non-zero first digit and random contents. */
+    static final Generator<String> LONG_DIGITS = tuples(ints(Zoo.NO_KNOWN ? 10 : 20, Zoo.NO_KNOWN ? 18 : 26), ints(1, 9), ints(0, 999_999_999))
