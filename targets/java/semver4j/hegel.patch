+    /** A pre-release list above {@code ids}: the last identifier bumped (a number by 1..9, a word by a letter), one more identifier after them, or ({@code >=} only) the same list. */
+    record Above(Kind kind, int bump, String extra) {
+        enum Kind { BUMP, APPEND, SAME }
+
+        List<String> apply(List<String> ids, boolean orEqual) {
+            List<String> out = new ArrayList<>(ids);
+            int last = out.size() - 1;
+            switch (kind == Kind.SAME && !orEqual ? Kind.BUMP : kind) {
+                case BUMP -> out.set(last, Spec.isNumeric(out.get(last)) ? new BigInteger(out.get(last)).add(BigInteger.valueOf(bump)).toString() : out.get(last) + "a");
+                case APPEND -> out.add(extra);
+                default -> { }
+            }
+            return out;
+        }
+    }
+
+    static final Generator<Above> ABOVE = tuples(sampledFrom(Above.Kind.values()), ints(1, 9), oneOf(ints(0, 12).map(String::valueOf), Gen.TAME_ALPHA_ID))
+        .map(t -> new Above(t.value1(), t.value2(), t.value3()));
