+    /** The region a case of {@link #OPEN_CASE} lies in: the bug's shape, or (HEGEL_NO_KNOWN) a neighbour it does not touch: the bound written in full as {@code <V}, or V itself tested. */
+    enum Region { SHAPE, EXPLICIT_BOUND, RELEASE }
+
+    static final Generator<Region> REGION = Zoo.NO_KNOWN ? sampledFrom(Region.EXPLICIT_BOUND, Region.RELEASE) : just(Region.SHAPE);
+
+    /**
+     * semver4j/13: one set of an open upper bound on V and a {@code >V-ids} or {@code >=V-ids} comparator, in either
+     * order, tested with a pre-release of V above {@code ids}: node-semver's {@code <V-0} excludes it, semver4j's
+     * {@code <V} admits it. Pre-releases are not included: with them semver4j writes the {@code -0} too.
+     */
+    record OpenCase(Region region, OpenBound open, boolean lowerFirst, String gap, String op, boolean v, List<String> ids, Above above) {
+        Ver bound() {
+            return open.bound();
+        }
+
+        String lower() {
+            return op + (v ? "v" : "") + bound().withPre(ids).text();
+        }
+
+        String upper() {
+            return region == Region.EXPLICIT_BOUND ? "<" + bound().text() : open.text();
+        }
+
+        Gen.Range range() {
+            Ver b = bound();
+            return new Gen.Range(lowerFirst ? lower() + gap + upper() : upper() + gap + lower(), 1, List.of(new Core(b.major(), b.minor(), b.patch())), false, false);
+        }
+
+        /** The version tested: a pre-release of V above ids, or in the RELEASE region V itself. */
+        Ver tested() {
+            return region == Region.RELEASE ? bound() : bound().withPre(above.apply(ids, op.equals(">=")));
+        }
+    }
