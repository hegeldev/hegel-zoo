+    /** Ivy interval notation, in the forms the Ivy documentation and semver4j's own list give, matches an interval model. */
+    @Test
+    void ivyRangesMatchTheIntervalModel() {
+        Hegel.test(tc -> {
+            BigInteger[] lc = Gen.core(tc);
+            BigInteger[] rc = Gen.core(tc);
+            int kind = n(tc, 0, 9);
+            String open;
+            String close;
+            boolean lowerOpen;
+            boolean upperOpen;
+            boolean lowerIncl;
+            boolean upperIncl;
+            String lower = Gen.ivyBound(tc, lc, false);
+            String upper = Gen.ivyBound(tc, rc, false);
+            switch (kind) {
+                case 0 -> { open = "["; close = "]"; lowerOpen = false; upperOpen = false; lowerIncl = true; upperIncl = true; }
+                case 1 -> { open = "["; close = "["; lowerOpen = false; upperOpen = false; lowerIncl = true; upperIncl = false; }
+                case 2 -> { open = "]"; close = "]"; lowerOpen = false; upperOpen = false; lowerIncl = false; upperIncl = true; }
+                case 3 -> { open = "]"; close = "["; lowerOpen = false; upperOpen = false; lowerIncl = false; upperIncl = false; }
+                case 4 -> { open = "["; close = ")"; lowerOpen = false; upperOpen = true; lowerIncl = true; upperIncl = false; upper = ""; }
+                case 5 -> { open = "]"; close = ")"; lowerOpen = false; upperOpen = true; lowerIncl = false; upperIncl = false; upper = ""; }
+                case 6 -> { open = "("; close = "]"; lowerOpen = true; upperOpen = false; lowerIncl = false; upperIncl = true; lower = ""; }
+                case 7 -> { open = "("; close = "["; lowerOpen = true; upperOpen = false; lowerIncl = false; upperIncl = false; lower = ""; }
+                default -> { open = ""; close = ""; lowerOpen = true; upperOpen = true; lowerIncl = false; upperIncl = false; lower = ""; upper = ""; }
+            }
+            String range = kind >= 8 ? (kind == 8 ? "latest" : "latest.integration") : open + lower + "," + upper + close;
+            boolean include = chance(tc, 50);
+            Ver lo = new Ver(lc[0], lc[1], lc[2], List.of(), List.of());
+            Ver hi = new Ver(rc[0], rc[1], rc[2], List.of(), List.of());
+            // a bound written with fewer components is completed with zeros
+            if (!lowerOpen) {
+                int depth = lower.split("\\.").length;
+                lo = new Ver(lc[0], depth > 1 ? lc[1] : BigInteger.ZERO, depth > 2 ? lc[2] : BigInteger.ZERO, List.of(), List.of());
+            }
+            if (!upperOpen) {
+                int depth = upper.split("\\.").length;
+                hi = new Ver(rc[0], depth > 1 ? rc[1] : BigInteger.ZERO, depth > 2 ? rc[2] : BigInteger.ZERO, List.of(), List.of());
+            }
+            Object made = attempt(() -> RangeListFactory.create(range, include));
+            check(made instanceof RangeList, () -> "RangeListFactory.create(" + show(range) + ") threw " + describe(made));
+            if (!(made instanceof RangeList rl)) {
+                return;
+            }
+            int versions = n(tc, 1, 3);
+            for (int i = 0; i < versions; i++) {
+                Ver v = Gen.near(tc, chance(tc, 50) ? lo : hi, Shape.TAME);
+                boolean expected = true;
+                if (!lowerOpen) {
+                    int c = Spec.compare(v, lo);
+                    expected &= lowerIncl ? c >= 0 : c > 0;
+                }
+                if (!upperOpen) {
+                    int c = Spec.compare(v, hi);
+                    expected &= upperIncl ? c <= 0 : c < 0;
+                }
+                if (!v.pre().isEmpty() && !include) {
+                    expected = false;
+                }
+                final boolean want = expected;
+                String vt = Gen.text(tc, v);
+                Semver sv = new Semver(vt);
+                Object got = attempt(() -> sv.satisfies(range, include));
+                check(got instanceof Boolean b && b == want, () -> show(vt) + " satisfies Ivy " + show(range) + (include ? " (with pre-releases)" : "") + ": semver4j " + describe(got) + ", the interval says " + want + "; parsed as " + rl);
+            }
+        }, Zoo.settings("ivyRangesMatchTheIntervalModel"));
+    }
