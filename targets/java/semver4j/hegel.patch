+    /** The oracle of the fluent properties: the expression builds the sets its text parses to, and satisfies agrees on versions near those in it. */
+    static void fluent(TestCase tc, Operand chain) {
+        List<Ver> all = new ArrayList<>();
+        Built b = chain.build(all);
+        RangeList fromText = RangeListFactory.create(b.text);
+        RangeList fromExpression = RangeListFactory.create(b.expression);
