+            }
+        }, Zoo.settings("ivyRangesMatchTheIntervalModel"));
+    }
+
+    // ------------------------------------------------------------------ RangeList
+
+    /** One Range of a set: its version (fresh or near an earlier one), operator, and whether it is built from a Semver or from text. */
+    record Entry(Rel rel, RangeOperator op, boolean asSemver, Decor decor) {}
+
+    static final Generator<Entry> ENTRY = tuples(rel(chance(60)), sampledFrom(RangeOperator.values()), chance(50), Gen.DECOR)
+        .map(t -> new Entry(t.value1(), t.value2(), t.value3(), t.value4()));
+    static final Generator<List<List<Entry>>> SETS = lists(lists(ENTRY).maxSize(3)).maxSize(3);
+
+    /** RangeList/Range built directly from operators and versions evaluate as OR of ANDs with the pre-release rule. */
+    @Test
+    void rangeListsEvaluateLikeTheModel() {
+        Hegel.test(tc -> {
