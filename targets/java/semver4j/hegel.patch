+    // ------------------------------------------------------------------ fluent expressions
+
+    record Built(RangeExpression expression, String text, String tree) {}
+
+    static Built leaf(TestCase tc, List<Ver> all) {
+        Ver v = all.isEmpty() || chance(tc, 40) ? Gen.version(tc, Shape.TAME) : Gen.near(tc, pick(tc, all.toArray(new Ver[0])), Shape.TAME);
+        all.add(v);
+        String text = v.text();
+        boolean asString = chance(tc, 50);
+        Semver sv = new Semver(text);
+        return switch (n(tc, 0, 4)) {
+            case 0 -> new Built(asString ? RangeExpression.eq(text) : RangeExpression.eq(sv), "=" + text, "=" + text);
+            case 1 -> new Built(asString ? RangeExpression.greater(text) : RangeExpression.greater(sv), ">" + text, ">" + text);
+            case 2 -> new Built(asString ? RangeExpression.greaterOrEqual(text) : RangeExpression.greaterOrEqual(sv), ">=" + text, ">=" + text);
+            case 3 -> new Built(asString ? RangeExpression.less(text) : RangeExpression.less(sv), "<" + text, "<" + text);
+            default -> new Built(asString ? RangeExpression.lessOrEqual(text) : RangeExpression.lessOrEqual(sv), "<=" + text, "<=" + text);
+        };
+    }
+
+    static Built chain(TestCase tc, List<Ver> all, int depth) {
+        Built b = leaf(tc, all);
+        int steps = n(tc, 0, 3);
+        for (int i = 0; i < steps; i++) {
+            Built o = depth > 0 && chance(tc, 30) ? chain(tc, all, depth - 1) : leaf(tc, all);
+            if (chance(tc, 50)) {
+                b = new Built(b.expression.and(o.expression), b.text + " " + o.text, "(" + b.tree + " AND " + o.tree + ")");
+            } else {
+                b = new Built(b.expression.or(o.expression), b.text + " || " + o.text, "(" + b.tree + " OR " + o.tree + ")");
+            }
+            if (o.text.contains("||")) {
+                break; // semver4j/12: anything chained after a multi-set operand starts a new set
+            }
+        }
+        return b;
+    }
+
+    /** The fluent RangeExpression is the string form written left to right: {@code and} is a space, {@code or} is {@code ||}. */
+    @Test
+    void fluentExpressionsMatchStrings() {
+        Hegel.test(tc -> {
+            List<Ver> all = new ArrayList<>();
+            Built b = chain(tc, all, 1);
+            RangeList fromText = RangeListFactory.create(b.text);
+            RangeList fromExpression = RangeListFactory.create(b.expression);
+            check(fromExpression.get().equals(fromText.get()), () -> "expression " + b.tree + " (text " + b.text + ") built the sets " + fromExpression.get() + ", the text parses to " + fromText.get());
+            int versions = n(tc, 1, 3);
+            for (int t = 0; t < versions; t++) {
+                Ver v = Gen.near(tc, pick(tc, all.toArray(new Ver[0])), Shape.TAME);
+                Semver sv = new Semver(Gen.text(tc, v));
+                Object viaText = attempt(() -> sv.satisfies(b.text));
+                Object viaExpression = attempt(() -> sv.satisfies(b.expression));
+                check(viaExpression instanceof Boolean x && viaText instanceof Boolean y && x.equals(y), () -> sv + " satisfies the expression " + b.text + ": fluent " + describe(viaExpression) + ", text " + describe(viaText));
+            }
+        }, Zoo.settings("fluentExpressionsMatchStrings"));
+    }
