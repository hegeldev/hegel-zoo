+            if (!max) {
+                Ver nextMajor = new Ver(v.minor().signum() != 0 || v.patch().signum() != 0 || v.pre().isEmpty() ? v.major().add(one) : v.major(), BigInteger.ZERO, BigInteger.ZERO, List.of(), v.build());
+                Ver nextMinor = new Ver(v.major(), v.patch().signum() != 0 || v.pre().isEmpty() ? v.minor().add(one) : v.minor(), BigInteger.ZERO, List.of(), v.build());
+                Ver nextPatch = new Ver(v.major(), v.minor(), v.pre().isEmpty() ? v.patch().add(one) : v.patch(), List.of(), v.build());
+                Object a = attempt(s::nextMajor);
+                Object b = attempt(s::nextMinor);
+                Object c = attempt(s::nextPatch);
+                check(same(a, nextMajor) == null, () -> "nextMajor of " + s + " = " + describe(a) + ", expected " + nextMajor.text());
+                check(same(b, nextMinor) == null, () -> "nextMinor of " + s + " = " + describe(b) + ", expected " + nextMinor.text());
+                check(same(c, nextPatch) == null, () -> "nextPatch of " + s + " = " + describe(c) + ", expected " + nextPatch.text());
+                String nodeMajor = Node.inc(v.text(), "major");
+                String nodeMinor = Node.inc(v.text(), "minor");
+                String nodePatch = Node.inc(v.text(), "patch");
+                check(nodeMajor != null && nodeMajor.equals(nextMajor.withBuild(List.of()).text()), () -> "node-semver inc major of " + v.text() + " = " + nodeMajor + ", the model says " + nextMajor.withBuild(List.of()).text());
+                check(nodeMinor != null && nodeMinor.equals(nextMinor.withBuild(List.of()).text()), () -> "node-semver inc minor of " + v.text() + " = " + nodeMinor + ", the model says " + nextMinor.withBuild(List.of()).text());
+                check(nodePatch != null && nodePatch.equals(nextPatch.withBuild(List.of()).text()), () -> "node-semver inc patch of " + v.text() + " = " + nodePatch + ", the model says " + nextPatch.withBuild(List.of()).text());
+                int k = tc.draw(ints(0, 5), "increment");
+                BigInteger bk = BigInteger.valueOf(k);
+                Object im = attempt(() -> s.withIncMajor(k));
+                Object in = attempt(() -> s.withIncMinor(k));
+                Object ip = attempt(() -> s.withIncPatch(k));
+                Object i1 = attempt(() -> s.withIncMajor());
+                Object i2 = attempt(() -> s.withIncMinor());
+                Object i3 = attempt(() -> s.withIncPatch());
+                check(same(im, new Ver(v.major().add(bk), v.minor(), v.patch(), v.pre(), v.build())) == null, () -> "withIncMajor(" + k + ") of " + s + " = " + describe(im));
+                check(same(in, new Ver(v.major(), v.minor().add(bk), v.patch(), v.pre(), v.build())) == null, () -> "withIncMinor(" + k + ") of " + s + " = " + describe(in));
+                check(same(ip, new Ver(v.major(), v.minor(), v.patch().add(bk), v.pre(), v.build())) == null, () -> "withIncPatch(" + k + ") of " + s + " = " + describe(ip));
+                check(same(i1, new Ver(v.major().add(one), v.minor(), v.patch(), v.pre(), v.build())) == null, () -> "withIncMajor() of " + s + " = " + describe(i1));
+                check(same(i2, new Ver(v.major(), v.minor().add(one), v.patch(), v.pre(), v.build())) == null, () -> "withIncMinor() of " + s + " = " + describe(i2));
+                check(same(i3, new Ver(v.major(), v.minor(), v.patch().add(one), v.pre(), v.build())) == null, () -> "withIncPatch() of " + s + " = " + describe(i3));
+            }
+            List<String> newPre = tc.draw(lists(Gen.preId(MODIFY)).minSize(1).maxSize(3), "new pre-release");
+            List<String> newBuild = tc.draw(lists(NEW_BUILD_ID).minSize(1).maxSize(2), "new build");
+            Object wp = attempt(() -> s.withPreRelease(String.join(".", newPre)));
+            Object wb = attempt(() -> s.withBuild(String.join(".", newBuild)));
+            Object cp = attempt(s::withClearedPreRelease);
+            Object cb = attempt(s::withClearedBuild);
+            Object cpb = attempt(s::withClearedPreReleaseAndBuild);
+            check(same(wp, v.withPre(newPre)) == null, () -> "withPreRelease(" + String.join(".", newPre) + ") of " + s + " = " + describe(wp) + ", expected " + v.withPre(newPre).text());
+            check(same(wb, v.withBuild(newBuild)) == null, () -> "withBuild(" + String.join(".", newBuild) + ") of " + s + " = " + describe(wb) + ", expected " + v.withBuild(newBuild).text());
+            check(same(cp, v.withPre(List.of())) == null, () -> "withClearedPreRelease of " + s + " = " + describe(cp));
+            check(same(cb, v.withBuild(List.of())) == null, () -> "withClearedBuild of " + s + " = " + describe(cb));
+            check(same(cpb, v.core()) == null, () -> "withClearedPreReleaseAndBuild of " + s + " = " + describe(cpb));
+            check(s.isStable() == (v.major().signum() > 0 && v.pre().isEmpty()), () -> "isStable of " + s + " = " + s.isStable());
+            refusesMalformedIdentifiers(s, tc.draw(BAD_IDS, "bad identifiers"));
+        }, Zoo.settings("modifiersMatchTheModel"));
+    }
+
+    /** Malformed identifier lists of every kind but semver4j/10's. */
+    static final Generator<String> MALFORMED_IDS = sampledFrom("", "a..b", ".a", "é", "a b", "01", "+x", "a-.b", "a.01");
+    /** An identifier list: pre-release identifiers joined by dots. */
+    static final Generator<String> ID_LIST = lists(Gen.preId(MODIFY)).minSize(1).maxSize(3).map(ids -> String.join(".", ids));
+    /** semver4j/10: an identifier list with a trailing dot or two, or a dot alone; under HEGEL_NO_KNOWN a leading dot or two dots inside. */
+    static final Generator<String> TRAILING_DOT_IDS = Zoo.NO_KNOWN
+        ? oneOf(ID_LIST.map(ids -> "." + ids), tuples(ID_LIST, ID_LIST).map(t -> t.value1() + ".." + t.value2()))
+        : oneOf(ID_LIST.map(ids -> ids + "."), just("."), ID_LIST.map(ids -> ids + ".."));
+    /** The malformed lists the modifiers property hands to withPreRelease/withBuild: the usual kinds, and semver4j/10's unless HEGEL_NO_KNOWN. */
+    static final Generator<String> BAD_IDS = Zoo.NO_KNOWN ? MALFORMED_IDS : weighted(w(70, MALFORMED_IDS), w(30, sampledFrom("a.", ".", "0.", "a..")));
+
+    /** semver4j/10: withPreRelease/withBuild refuse an identifier list with a trailing dot, as they refuse every other malformed list. */
+    @Test
+    void trailingDotIdentifierListsAreRefused() {
+        Hegel.test(tc -> {
+            Semver s = new Semver(tc.draw(Gen.shown(Gen.version(MODIFY)), "version").text());
+            refusesMalformedIdentifiers(s, tc.draw(TRAILING_DOT_IDS, "identifiers"));
+        }, Zoo.settings("trailingDotIdentifierListsAreRefused"));
+    }
+
+    /** withPreRelease/withBuild accept exactly the lists the grammar accepts and refuse the rest with SemverException. */
+    static void refusesMalformedIdentifiers(Semver s, String bad) {
+        Object badPre = attempt(() -> s.withPreRelease(bad));
+        Object badBuild = attempt(() -> s.withBuild(bad));
+        boolean preOk = Spec.parse("0.0.0-" + bad) != null;
+        boolean buildOk = Spec.parse("0.0.0+" + bad) != null;
+        check(preOk ? badPre instanceof Semver : badPre instanceof SemverException, () -> "withPreRelease(" + show(bad) + ") of " + s + " gave " + describe(badPre));
+        check(buildOk ? badBuild instanceof Semver : badBuild instanceof SemverException, () -> "withBuild(" + show(bad) + ") of " + s + " gave " + describe(badBuild));
+    }
+
+    // ------------------------------------------------------------------ coerce
+
+    static final Generator<Integer> N30 = ints(0, 30);
+
+    /** Text for coerce: version-like text, junk over the version alphabet, four-part versions, prose around numbers, leading zeros, huge numbers, and classic cases. */
+    static final Generator<String> COERCE_INPUT = weighted(
+        w(2, Gen.VERSION_LIKE),
+        w(1, Gen.word("0123456789.v -+ab", 0, 12)),
+        w(1, tuples(N30, N30, N30, N30).map(t -> "v" + t.value1() + "." + t.value2() + "." + t.value3() + "." + t.value4())),
+        w(1, tuples(sampledFrom("release-", "", "  ", "version ", "R", "x"), ints(0, 300),
+                oneOf(just(""), N30.map(n -> "." + n), tuples(N30, N30).map(t -> "." + t.value1() + "." + t.value2())),
+                sampledFrom("", " ", "-alpha", "+b", ".", "..1", "x"))
+            .map(t -> t.value1() + t.value2() + t.value3() + t.value4())),
+        w(1, tuples(ints(0, 20), ints(0, 99), oneOf(just(""), ints(0, 9).map(d -> ".0" + d), just(".00.007"))).map(t -> "0".repeat(t.value1()) + t.value2() + t.value3())),
+        w(1, tuples(ints(1, 10), sampledFrom("", "0", "00", "9999999", "99999999999")).map(t -> String.valueOf(Integer.MAX_VALUE).substring(0, t.value1()) + t.value2())),
+        w(1, sampledFrom("", " ", "abc", "1..2", "1.2.3.4.5", "x1.2", "١.٢", "1.2.3-alpha.1+b", ".1", "1.", "1.2.", "-1.2.3", "v.1.2", "1,2,3", "1_2_3", "1-2-3", "1 2 3")));
+
+    /** coerce agrees with node-semver's coerce (the first up-to-16-digit number groups), keeping a valid input whole. */
+    @Test
+    void coerceMatchesNodeSemver() {
+        Hegel.test(tc -> {
+            String s = tc.draw(COERCE_INPUT, "text");
+            // node-semver keeps leading zeros (and then rejects them), semver4j strips them: a documented extension
+            tc.assume(Spec.longestDigitRun(s) <= 16 && !s.matches("(?s).*(^|\\D)0\\d.*"));
+            Object made = attempt(() -> Semver.coerce(s));
+            check(!(made instanceof Throwable), () -> "coerce(" + show(s) + ") threw " + describe(made));
+            Semver got = made instanceof Semver g ? g : null;
+            String node = Node.coerce(s);
+            if (Semver.isValid(s)) {
+                check(got != null && got.equals(new Semver(s)), () -> "coerce(" + show(s) + ") = " + describe(made) + " for a valid version");
+            } else if (node == null) {
+                check(got == null, () -> "coerce(" + show(s) + ") = " + describe(made) + ", node-semver finds no version");
+            } else {
+                Ver nv = Spec.parse(node);
+                if (nv == null || !nv.fitsInt()) {
+                    check(got == null, () -> "coerce(" + show(s) + ") = " + describe(made) + ", node-semver gives " + node + " which exceeds Integer.MAX_VALUE");
+                } else {
+                    check(got != null && got.getVersion().equals(node), () -> "coerce(" + show(s) + ") = " + describe(made) + ", node-semver gives " + node);
+                }
+            }
+            if (got != null && node != null) {
+                final Semver g = got;
+                check(g.getMajor() == Long.parseLong(node.split("\\.")[0]) && g.getMinor() == Long.parseLong(node.split("\\.")[1]) && g.getPatch() == Long.parseLong(node.split("\\.")[2]),
+                    () -> "coerce(" + show(s) + ") core " + g.getMajor() + "." + g.getMinor() + "." + g.getPatch() + " differs from node-semver's " + node);
+            }
+        }, Zoo.settings("coerceMatchesNodeSemver"));
+    }
+
+    // ------------------------------------------------------------------ builder
+
+    /** Which setter puts a list of identifiers on the builder: the single-value one (only for one identifier), the List one, or the varargs one. */
+    static Semver.Builder withPre(Semver.Builder b, List<String> ids, int setter) {
+        return switch (ids.size() == 1 ? setter : Math.max(setter, 1)) {
+            case 0 -> b.withPreRelease(ids.get(0));
+            case 1 -> b.withPreReleases(ids);
+            default -> b.withPreReleases(ids.toArray(new String[0]));
+        };
+    }
+
+    static Semver.Builder withBuild(Semver.Builder b, List<String> ids, int setter) {
+        return switch (ids.size() == 1 ? setter : Math.max(setter, 1)) {
+            case 0 -> b.withBuild(ids.get(0));
+            case 1 -> b.withBuilds(ids);
+            default -> b.withBuilds(ids.toArray(new String[0]));
+        };
+    }
+
+    /** Builder/of/create produce the canonical text and round-trip through the parser; invalid parts are refused. */
+    @Test
+    void buildersRoundTrip() {
+        Hegel.test(tc -> {
+            Ver v = tc.draw(Gen.version(MODIFY), "version");
+            int preSetter = tc.draw(ints(0, 2), "pre-release setter");
+            int buildSetter = tc.draw(ints(0, 2), "build setter");
+            Semver.Builder b = Semver.builder().withMajor(v.major().intValue()).withMinor(v.minor().intValue()).withPatch(v.patch().intValue());
+            if (!v.pre().isEmpty()) {
+                b = withPre(b, v.pre(), preSetter);
+            }
+            if (!v.build().isEmpty()) {
+                b = withBuild(b, v.build(), buildSetter);
+            }
+            final Semver.Builder built = b;
+            Object made = attempt(built::build);
+            check(made instanceof Semver s && s.getVersion().equals(v.text()), () -> "builder for " + v + " gave " + describe(made) + ", expected " + v.text());
+            if (made instanceof Semver s) {
+                Semver parsed = new Semver(v.text());
+                check(s.equals(parsed) && parsed.equals(s) && s.hashCode() == parsed.hashCode() && s.compareTo(parsed) == 0, () -> "built " + s + " is not equal to parsed " + parsed);
+                check(s.getPreRelease().equals(v.pre()) && s.getBuild().equals(v.build()), () -> "built " + s + " has parts " + s.getPreRelease() + " " + s.getBuild());
+                check(s.format(x -> x.getMajor() + "/" + x.getMinor()).equals(v.major() + "/" + v.minor()), () -> "format of " + s);
+            }
+            Semver core = Semver.create(v.major().intValue(), v.minor().intValue(), v.patch().intValue());
+            Semver core2 = Semver.of(v.major().intValue(), v.minor().intValue(), v.patch().intValue()).build();
+            check(core.getVersion().equals(v.core().text()) && core.equals(core2), () -> "create/of gave " + core + " and " + core2 + ", expected " + v.core().text());
+            // invalid parts
+            String bad = tc.draw(sampledFrom("", "a..b", "a.b", ".", "é", "a b", "01", "+x", "-", "a-.b"), "bad identifiers");
+            Object badPre = attempt(() -> Semver.of(1, 2, 3).withPreRelease(bad).build());
+            Object badBuild = attempt(() -> Semver.of(1, 2, 3).withBuild(bad).build());
+            boolean preOk = Spec.parse("1.2.3-" + bad) != null;
+            boolean buildOk = Spec.parse("1.2.3+" + bad) != null;
+            check(preOk ? badPre instanceof Semver : badPre instanceof SemverException, () -> "builder withPreRelease(" + show(bad) + ") gave " + describe(badPre));
+            check(buildOk ? badBuild instanceof Semver : badBuild instanceof SemverException, () -> "builder withBuild(" + show(bad) + ") gave " + describe(badBuild));
+            int neg = -tc.draw(ints(1, 1000), "negative major");
+            Object negative = attempt(() -> Semver.of(neg, 0, 0).build());
+            check(negative instanceof SemverException, () -> "builder with major " + neg + " gave " + describe(negative));
+        }, Zoo.settings("buildersRoundTrip"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/Spec.java b/hegel/src/test/java/zoo/Spec.java
new file mode 100644
index 0000000..d5a6a0e
--- /dev/null
+++ b/hegel/src/test/java/zoo/Spec.java
@@ -0,0 +1,159 @@
+package zoo;
+
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * SemVer 2.0.0 as a model: the grammar (with semver4j's two documented extensions, an optional {@code v} prefix and
+ * surrounding whitespace), the precedence rules of section 11 with exact integers, and the canonical text.
+ */
+final class Spec {
+    private Spec() {}
+
+    static final String NUM = "0|[1-9]\\d*";
+    static final String PRE_ID = "(?:" + NUM + "|\\d*[a-zA-Z-][a-zA-Z0-9-]*)";
+    static final String BUILD_ID = "[0-9A-Za-z-]+";
+    static final Pattern STRICT = Pattern.compile("^v?(" + NUM + ")\\.(" + NUM + ")\\.(" + NUM + ")"
+        + "(?:-(" + PRE_ID + "(?:\\." + PRE_ID + ")*))?(?:\\+(" + BUILD_ID + "(?:\\." + BUILD_ID + ")*))?$");
+    static final Pattern NUMERIC = Pattern.compile("\\d+");
+    static final BigInteger MAX_INT = BigInteger.valueOf(Integer.MAX_VALUE);
+
+    record Ver(BigInteger major, BigInteger minor, BigInteger patch, List<String> pre, List<String> build) {
+        static Ver of(long major, long minor, long patch, List<String> pre, List<String> build) {
+            return new Ver(BigInteger.valueOf(major), BigInteger.valueOf(minor), BigInteger.valueOf(patch), pre, build);
+        }
+
+        /** The canonical text: {@code M.m.p[-pre][+build]}. */
+        String text() {
+            StringBuilder sb = new StringBuilder().append(major).append('.').append(minor).append('.').append(patch);
+            if (!pre.isEmpty()) {
+                sb.append('-').append(String.join(".", pre));
+            }
+            if (!build.isEmpty()) {
+                sb.append('+').append(String.join(".", build));
+            }
+            return sb.toString();
+        }
+
+        boolean fitsInt() {
+            return major.compareTo(MAX_INT) <= 0 && minor.compareTo(MAX_INT) <= 0 && patch.compareTo(MAX_INT) <= 0;
+        }
+
+        Ver core() {
+            return new Ver(major, minor, patch, List.of(), List.of());
+        }
+
+        Ver withPre(List<String> p) {
+            return new Ver(major, minor, patch, p, build);
+        }
+
+        Ver withBuild(List<String> b) {
+            return new Ver(major, minor, patch, pre, b);
+        }
+    }
+
+    /**
+     * What semver4j must accept: the text trimmed (Java's {@code trim}), then the strict grammar with an optional
+     * {@code v}; null when the grammar rejects it. Numbers above {@code Integer.MAX_VALUE} are grammatical but
+     * semver4j documents them as "too big": {@link Ver#fitsInt()} tells the two cases apart.
+     */
+    static Ver parse(String text) {
+        Matcher m = STRICT.matcher(text.trim());
+        if (!m.matches()) {
+            return null;
+        }
+        return new Ver(new BigInteger(m.group(1)), new BigInteger(m.group(2)), new BigInteger(m.group(3)),
+            split(m.group(4)), split(m.group(5)));
+    }
+
+    static List<String> split(String dotted) {
+        return dotted == null ? List.of() : Arrays.asList(dotted.split("\\."));
+    }
+
+    /** Section 11 precedence: -1, 0, 1. Build metadata is ignored. */
+    static int compare(Ver a, Ver b) {
+        int c = a.major.compareTo(b.major);
+        if (c != 0) {
+            return c;
+        }
+        c = a.minor.compareTo(b.minor);
+        if (c != 0) {
+            return c;
+        }
+        c = a.patch.compareTo(b.patch);
+        if (c != 0) {
+            return c;
+        }
+        if (a.pre.isEmpty() || b.pre.isEmpty()) {
+            return a.pre.isEmpty() == b.pre.isEmpty() ? 0 : a.pre.isEmpty() ? 1 : -1;
+        }
+        int n = Math.min(a.pre.size(), b.pre.size());
+        for (int i = 0; i < n; i++) {
+            c = compareIdentifiers(a.pre.get(i), b.pre.get(i));
+            if (c != 0) {
+                return c;
+            }
+        }
+        return Integer.compare(a.pre.size(), b.pre.size());
+    }
+
+    static int compareIdentifiers(String x, String y) {
+        boolean xn = NUMERIC.matcher(x).matches();
+        boolean yn = NUMERIC.matcher(y).matches();
+        if (xn && yn) {
+            return Integer.signum(new BigInteger(x).compareTo(new BigInteger(y)));
+        }
+        if (xn != yn) {
+            return xn ? -1 : 1;
+        }
+        return Integer.signum(x.compareTo(y));
+    }
+
+    /** The first position at which two pre-release lists differ (both identifiers present), or -1. */
+    static int firstDifference(List<String> a, List<String> b) {
+        int n = Math.min(a.size(), b.size());
+        for (int i = 0; i < n; i++) {
+            if (!a.get(i).equals(b.get(i))) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    static boolean isNumeric(String id) {
+        return NUMERIC.matcher(id).matches();
+    }
+
+    static boolean hasDigit(String id) {
+        for (int i = 0; i < id.length(); i++) {
+            if (Character.isDigit(id.charAt(i))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** The length of the longest run of ASCII digits in the text. */
+    static int longestDigitRun(String s) {
+        int best = 0;
+        int run = 0;
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c >= '0' && c <= '9') {
+                run++;
+                best = Math.max(best, run);
+            } else {
+                run = 0;
+            }
+        }
+        return best;
+    }
+
+    static List<String> list(String... xs) {
+        return new ArrayList<>(Arrays.asList(xs));
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..1a959c3
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,98 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once. {@link #NO_KNOWN}
+ * ({@code HEGEL_NO_KNOWN=1}) switches the recorded bugs' shapes off for a run that looks past the
+ * known bugs: Gen then leaves them out and the properties skip the few pairs it cannot shape away.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    /** Off by default: the properties draw the recorded bugs' shapes and fail on them (they are the expected failures). */
+    static final boolean NO_KNOWN = notEmpty(System.getenv("HEGEL_NO_KNOWN"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+
+    /** Rethrows any throwable unchecked (for control-flow exceptions such as Hegel's that must not be swallowed). */
+    @SuppressWarnings("unchecked")
+    static <T extends Throwable> void sneaky(Throwable t) throws T {
+        throw (T) t;
+    }
+}
