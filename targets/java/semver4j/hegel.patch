+                check(!(x >= 0 && y >= 0) || z >= 0, () -> "compareTo is not transitive: " + sa + " >= " + sb + " >= " + sc + " but " + sa + " < " + sc);
+            }
+            // the greatest difference
+            VersionDiff expectedDiff = !a.major().equals(b.major()) ? VersionDiff.MAJOR : !a.minor().equals(b.minor()) ? VersionDiff.MINOR : !a.patch().equals(b.patch()) ? VersionDiff.PATCH
