diff --git a/hegel/node/oracle.js b/hegel/node/oracle.js
new file mode 100644
index 0000000..808c8f8
--- /dev/null
+++ b/hegel/node/oracle.js
@@ -0,0 +1,53 @@
+// node-semver as an oracle for the Hegel zoo's semver4j tests. One request per line: an operation and its
+// arguments as JSON strings separated by tabs; one reply line per request, fields separated by tabs.
+'use strict';
+const semver = require('semver');
+const readline = require('readline');
+
+function ver(v) {
+  if (v === null || v === undefined) return 'null';
+  return [v.major, v.minor, v.patch, v.prerelease.join('.'), v.build.join('.'), v.version].join('\t');
+}
+
+function handle(op, a) {
+  switch (op) {
+    case 'parse': {
+      let v = null;
+      try { v = semver.parse(a[0]); } catch (e) { return 'ERR'; }
+      return ver(v);
+    }
+    case 'cmp': {
+      try { return String(semver.compare(a[0], a[1])); } catch (e) { return 'ERR'; }
+    }
+    case 'sat': {
+      try { return String(semver.satisfies(a[0], a[1], { includePrerelease: a[2] === '1' })); } catch (e) { return 'ERR'; }
+    }
+    case 'valid': {
+      try { const r = semver.validRange(a[0], { includePrerelease: a[1] === '1' }); return r === null ? 'null' : r; } catch (e) { return 'ERR'; }
+    }
+    case 'coerce': {
+      try { const v = semver.coerce(a[0]); return v === null ? 'null' : v.version; } catch (e) { return 'ERR'; }
+    }
+    case 'inc': {
+      try { const v = semver.inc(a[0], a[1]); return v === null ? 'null' : v; } catch (e) { return 'ERR'; }
+    }
+    case 'version': {
+      return require('semver/package.json').version;
+    }
+    default:
+      return 'ERR unknown op ' + op;
+  }
+}
+
+const rl = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });
+rl.on('line', (line) => {
+  if (line.length === 0) return;
+  const parts = line.split('\t');
+  const op = parts[0];
+  let args;
+  try { args = parts.slice(1).map((p) => JSON.parse(p)); } catch (e) { process.stdout.write('ERR bad request\n'); return; }
+  let out;
+  try { out = handle(op, args); } catch (e) { out = 'ERR ' + (e && e.message); }
+  process.stdout.write(String(out).replace(/[\r\n]/g, ' ') + '\n');
+});
+rl.on('close', () => process.exit(0));
