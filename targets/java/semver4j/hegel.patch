+    /** semver4j/7: a set with a part that is no comparator among one or two primitives (a primitive under HEGEL_NO_KNOWN). */
+    static final Generator<Gen.Alt> JUNK_PART = tuples(Gen.CORE, Gen.GAP, comparator(Zoo.NO_KNOWN ? Gen.OP : Gen.JUNK_OP, Gen.body(1, 3)), ints(0, 2), lists(Gen.more(Gen.CORE, PLAIN)).maxSize(2))
