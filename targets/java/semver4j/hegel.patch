+    static final Generator<Interval> INTERVAL = interval(NOTATION, Gen.CORE);
+    /** semver4j/6: the notations mixing bracket styles (the square ones under HEGEL_NO_KNOWN). */
+    static final Generator<Interval> MIXED_INTERVAL = interval(sampledFrom(Zoo.NO_KNOWN ? IVY.subList(0, 4) : MIXED_IVY), Gen.CORE);
