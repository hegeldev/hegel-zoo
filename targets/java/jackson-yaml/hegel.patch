+    /** An indicator or a marker rather than a plain scalar. */
+    static boolean isIndicator(String s) {
+        return s.isEmpty() || s.startsWith("-") && (s.length() == 1 || s.charAt(1) == ' ') || s.startsWith("?") || s.startsWith(":") || s.startsWith("!") || s.startsWith("%")
+            || s.startsWith("@") || s.startsWith("`") || s.startsWith("#") || s.equals("<<") || s.startsWith("&") || s.startsWith("*");
+    }
+
+    /** Text that cannot stand as a plain scalar in any position. */
+    static boolean neverPlain(String s) {
+        return s.contains(": ") || s.contains(" #") || s.endsWith(":") || s.endsWith(" ");
+    }
+
+    /** A string of the pool that fits a plain scalar. */
+    static boolean plainAnywhere(String s) {
+        return !s.isEmpty() && !YamlGen.hasAny(s, "\n\r\t") && !YamlGen.hasControl(s) && !YamlGen.hasSurrogate(s) && YamlGen.PLAIN_BAN_FIRST.indexOf(s.charAt(0)) < 0
+            && !neverPlain(s) && !s.startsWith("---") && !s.startsWith("...") && s.length() < 100;
+    }
+
+    /** The table's entries that are plain scalars the schema's readers are not known to differ on. */
+    static List<String> oddScalars(boolean core) {
+        List<String> out = new ArrayList<>();
+        for (String s : ODD_SCALARS) {
+            if (!isIndicator(s) && !neverPlain(s) && knownScalar(s, core) == null) {
+                out.add(s);
+            }
+        }
+        return out;
+    }
+
+    static final List<String> POOL_PLAIN = Arrays.stream(YamlGen.STRING_POOL).filter(JacksonYamlTest::plainAnywhere).toList();
+
+    /** The digits with an underscore inside, at a drawn position. */
+    static String underscore(String digits, int at) {
+        if (digits.length() < 2) {
+            return digits;
+        }
+        int i = 1 + Math.floorMod(at, digits.length() - 1);
+        return digits.substring(0, i) + "_" + digits.substring(i);
+    }
+
+    /**
+     * A decimal int, sometimes signed, with a leading zero (15%) or underscores. Under the core schema a leading zero is the
+     * PARSE_OCTAL_NUMBERS shape (octal digits: tolerated; a digit 8 or 9: jackson-yaml/4), not drawn there under HEGEL_NO_KNOWN.
+     */
+    static Generator<String> decimalInt(boolean core) {
+        return tuples(ints(0, 999999999), chance(30), core && Zoo.NO_KNOWN ? just(false) : chance(15), chance(15), INDEX, pick("", "", "-", "+")).map(t -> {
+            String d = Long.toString((long) t.value1() * (t.value2() ? 1000000000L : 1));
+            if (t.value3()) {
+                d = "0" + d;
+            }
+            if (t.value4()) {
+                d = underscore(d, t.value5());
+            }
+            return t.value6() + d;
+        });
+    }
+
+    /** A number in another base (or with a bare leading zero), underscored. */
+    static final Generator<String> OTHER_BASE = tuples(pick("", "-", "+"), pick("0x", "0X", "0b", "0o", "0"), pick("1f", "7", "101", "0", "ff_ff", "17", "9", "a", "8", "ffffffff", "1ffffffff"), INDEX)
+        .map(t -> t.value1() + t.value2() + underscore(t.value3(), t.value4()));
+
+    /** A float text: a sign, digits (80%), a dot, digits (85%), an exponent (40%), one time in ten underscored. */
+    static final Generator<String> FLOAT_TEXT = tuples(
+            pick("", "-", "+"),
+            maybe(80, "", ints(0, 999).map(String::valueOf)),
+            maybe(85, "", ints(0, 9999).map(String::valueOf)),
+            maybe(40, "", tuples(pick("e", "E"), pick("", "+", "-"), ints(0, 400)).map(e -> e.value1() + e.value2() + e.value3())),
+            chance(10),
+            INDEX)
+        .map(t -> {
+            String f = t.value1() + t.value2() + "." + t.value3() + t.value4();
+            return t.value5() ? underscore(f, t.value6()) : f;
+        });
