+            } else {
+                check(mine.ok() == theirs.ok(), () -> "Jackson: " + mine + "; the engine: " + theirs + " for " + tag);
+            }
+            if (!mine.ok()) {
+                check(mine.jacksonError(), () -> "Jackson threw " + mine.cause.getClass().getName() + ": " + firstLine(mine.cause.getMessage()) + " for " + tag);
+            }
+        });
+    }
+}
