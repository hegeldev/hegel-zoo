+    /** Entries in the syntax of a position: a block mapping (0), a flow mapping (1), a block sequence (2), a flow sequence (3), the root value alone (4). */
+    static String layout(int position, List<String> keys, List<String> values, String root) {
+        StringBuilder sb = new StringBuilder();
+        switch (position) {
+            case 0 -> {
+                for (int i = 0; i < keys.size(); i++) {
+                    sb.append(keys.get(i)).append(": ").append(values.get(i)).append("\n");
+                }
+            }
+            case 1 -> {
+                sb.append("{");
+                for (int i = 0; i < keys.size(); i++) {
+                    sb.append(i > 0 ? ", " : "").append(keys.get(i)).append(": ").append(values.get(i));
+                }
+                sb.append("}\n");
+            }
+            case 2 -> {
+                for (String v : values) {
+                    sb.append("- ").append(v).append("\n");
+                }
+            }
+            case 3 -> sb.append("[").append(String.join(", ", values)).append("]\n");
+            default -> sb.append(root).append("\n");
+        }
+        return sb.toString();
+    }
