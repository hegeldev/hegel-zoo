+    /** The oracle of scalarsTypeLikeTheSchema and of the narrow scalar properties: Jackson's token kind is the schema resolver's, its value the scalar's, the engine agrees. */
+    static void scalarCase(TestCase tc, ScalarCase c) {
+        boolean core = c.core();
+        String s = c.scalar();
+        count("cases");
+        // the generated words can still spell an indicator, a known shape or text no position takes plain
+        if (isIndicator(s)) {
+            count("skipped: an indicator, not a plain scalar");
+        }
+        tc.assume(!isIndicator(s));
+        String known = knownScalar(s, core);
+        if (known != null) {
+            count("skipped: " + known);
+        }
+        tc.assume(known == null);
+        if (neverPlain(s)) {
+            count("skipped: not plain in any position");
+        }
+        tc.assume(!neverPlain(s));
+        ScalarResolver resolver = core ? YamlGen.CORE_RESOLVER : YamlGen.JSON_RESOLVER;
+        String kind = expectedKind(resolver, s);
+        String text = inPosition(s, c.position());
+        String tag = "scalar \"" + s + "\" (" + kind + " in the " + (core ? "core" : "json") + " schema) in " + describe(text);
+        Loaded mine = readAll(yaml(core), text);
+        Loaded theirs = engineAll(engine(core), text);
+        if (mine.ok() && theirs.ok()) {
+            check(mine.docs.equals(theirs.docs), () -> "Jackson reads " + mine + " but the engine " + theirs + " for " + tag);
+        } else if (mine.ok() != theirs.ok()) {
+            check(false, () -> "Jackson: " + mine + "; the engine: " + theirs + " for " + tag);
+        }
+        if (!mine.ok()) {
+            check(mine.jacksonError(), () -> "Jackson threw " + mine.cause.getClass().getName() + ": " + firstLine(mine.cause.getMessage()) + " for " + tag);
+        } else {
+            // the token kind is the resolver's, and its value is the scalar's
+            JsonNode value = mine.docs.get(0);
+            if (text.startsWith("k:") || text.startsWith("{")) {
+                value = value.get("$m").get(0).get(1);
+            } else if (text.startsWith("- ") || text.startsWith("[")) {
+                value = value.get(0);
+            }
+            JsonNode v = value;
+            check(kindOf(v).equals(kind), () -> "Jackson gives a " + kindOf(v) + " " + Canon.show(v) + " where the schema says " + kind + " for " + tag);
+            if (kind.equals("string")) {
+                check(v.stringValue().equals(s), () -> "Jackson gives the string " + Canon.show(v) + " for " + tag);
+            } else if (kind.equals("int") && !core) {
+                check(v.get("$n").stringValue().equals(new BigInteger(s).toString()), () -> "Jackson gives " + Canon.show(v) + " for " + tag);
+            } else if (kind.equals("float") && !core && !s.contains("inf") && !s.contains("nan")) {
+                check(v.get("$f").stringValue().equals(Long.toHexString(Double.doubleToLongBits(Double.parseDouble(s)))), () -> "Jackson gives " + Canon.show(v) + " for " + tag);
+            }
+        }
+        // the number type follows the value under the JSON schema
+        if (!core && kind.equals("int")) {
+            try (JsonParser p = YAML.createParser(s)) {
+                p.nextToken();
+                BigInteger v = new BigInteger(s);
