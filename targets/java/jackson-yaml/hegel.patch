+    /** null; variant: its core-schema spelling (null, null, Null, NULL, ~). */
+    record Null(int variant) implements Node {}
+
+    /** A boolean; variant: its core-schema spelling (true, true, True, TRUE). */
+    record Bool(boolean v, int variant) implements Node {}
+
+    /** An integer; spell: 0-7 decimal, 8 hex, 9 upper-case hex, 10 octal, 11 with a + (core only; a zero uses spell % 6). */
