+            JacksonYamlTest.Loaded fromEngine = JacksonYamlTest.readAll(JacksonYamlTest.yaml(o.core), engineText);
+            JsonNode pure = expected(tree); // the engine writes the Java value (a BigDecimal "1000" went in as the double 1000.0)
+            check(fromEngine.ok() && fromEngine.docs.size() == 1 && fromEngine.docs.get(0).equals(pure), () -> "Jackson reads the engine's dump as " + fromEngine + " instead of " + Canon.show(pure) + describe(engineText));
+        }, Zoo.settings("treesWrittenByJacksonReadBack"));
+    }
+
+    // ---- 2. the generator's entry points agree ---------------------------------------------------
+
+    /** Write the node through a random choice of the generator's methods. */
+    static void writeVia(TestCase tc, JsonGenerator gen, JsonNode nd, List<String> paths) {
+        if (nd.isNull()) {
+            if (chance(tc, 20)) {
+                paths.add("writePOJO(null)");
+                gen.writePOJO(null);
+            } else {
+                gen.writeNull();
+            }
+        } else if (nd.isBoolean()) {
+            gen.writeBoolean(nd.booleanValue());
+        } else if (nd.isBinary()) {
+            byte[] b = nd.binaryValue();
+            switch (n(tc, 1, 4)) {
+                case 1:
+                    paths.add("writeBinary(variant, off, len)");
+                    byte[] padded = new byte[b.length + 3];
+                    System.arraycopy(b, 0, padded, 2, b.length);
+                    gen.writeBinary(Base64Variants.MIME, padded, 2, b.length);
+                    break;
+                // not writeBinary(InputStream): unsupported, jackson-yaml/10
+                default:
+                    gen.writeBinary(b);
+            }
+        } else if (nd.isIntegralNumber()) {
+            BigInteger v = nd.bigIntegerValue();
+            int r = n(tc, 1, 6);
+            if (r == 1) {
+                paths.add("writeNumber(String)");
+                gen.writeNumber(v.toString());
+            } else if (r == 2) {
+                paths.add("writeNumber(BigInteger)");
+                gen.writeNumber(v);
+            } else if (r == 3 && v.bitLength() < 16) {
+                paths.add("writeNumber(short)");
+                gen.writeNumber(v.shortValue());
+            } else if (v.bitLength() < 32) {
+                gen.writeNumber(v.intValue());
+            } else if (v.bitLength() < 64) {
+                gen.writeNumber(v.longValue());
+            } else {
+                gen.writeNumber(v);
+            }
+        } else if (nd.isNumber()) {
+            if (nd instanceof FloatNode) {
+                gen.writeNumber(nd.floatValue());
+            } else if (nd.isBigDecimal()) {
+                gen.writeNumber(nd.decimalValue());
+            } else if (chance(tc, 20) && !Double.isNaN(nd.doubleValue()) && !Double.isInfinite(nd.doubleValue())) {
+                paths.add("writeNumber(String) for a double");
+                gen.writeNumber(Double.toString(nd.doubleValue()));
+            } else {
+                gen.writeNumber(nd.doubleValue());
+            }
+        } else if (nd.isTextual()) {
+            String s = nd.stringValue();
+            switch (n(tc, 1, 6)) {
+                case 1:
+                    paths.add("writeString(char[])");
+                    char[] padded = ("xx" + s + "y").toCharArray();
+                    gen.writeString(padded, 2, s.length());
+                    break;
+                case 2:
+                    paths.add("writeString(SerializableString)");
+                    gen.writeString(new SerializedString(s));
+                    break;
+                case 3:
+                    if (!YamlGen.hasSurrogate(s)) {
+                        paths.add("writeUTF8String");
+                        byte[] b = s.getBytes(StandardCharsets.UTF_8);
+                        gen.writeUTF8String(b, 0, b.length);
+                        break;
+                    }
+                    gen.writeString(s);
+                    break;
+                case 4:
+                    paths.add("writePOJO(String)");
+                    gen.writePOJO(s);
+                    break;
+                default:
+                    gen.writeString(s);
+            }
+        } else if (nd.isArray()) {
+            if (chance(tc, 15)) {
+                paths.add("writeTree(array)");
+                gen.writeTree(nd);
+                return;
+            }
+            boolean allInts = nd.size() > 0;
+            for (JsonNode c : nd) {
+                allInts &= c.isIntegralNumber() && c.bigIntegerValue().bitLength() < 32;
+            }
+            if (allInts && chance(tc, 40)) {
+                paths.add("writeArray(int[])");
+                int[] xs = new int[nd.size() + 1];
+                for (int i = 0; i < nd.size(); i++) {
+                    xs[i + 1] = nd.get(i).intValue();
+                }
+                gen.writeArray(xs, 1, nd.size());
+                return;
+            }
+            switch (n(tc, 1, 3)) {
+                case 1:
+                    paths.add("writeStartArray(obj)");
+                    gen.writeStartArray(nd);
+                    break;
+                case 2:
+                    paths.add("writeStartArray(obj, size)");
+                    gen.writeStartArray(nd, nd.size());
+                    break;
+                default:
+                    gen.writeStartArray();
+            }
+            for (JsonNode c : nd) {
+                writeVia(tc, gen, c, paths);
+            }
+            gen.writeEndArray();
+        } else {
+            if (chance(tc, 15)) {
+                paths.add("writeTree(object)");
+                gen.writeTree(nd);
+                return;
+            }
+            switch (n(tc, 1, 3)) {
+                case 1:
+                    paths.add("writeStartObject(obj)");
+                    gen.writeStartObject(nd);
+                    break;
+                case 2:
+                    paths.add("writeStartObject(obj, size)");
+                    gen.writeStartObject(nd, nd.size());
+                    break;
+                default:
+                    gen.writeStartObject();
+            }
+            for (Map.Entry<String, JsonNode> e : nd.properties()) {
+                JsonNode v = e.getValue();
+                int r = n(tc, 1, 5);
+                if (r == 1 && v.isTextual()) {
+                    paths.add("writeStringProperty");
+                    gen.writeStringProperty(e.getKey(), v.stringValue());
+                    continue;
+                }
+                if (r == 2 && v.isIntegralNumber() && v.bigIntegerValue().bitLength() < 64) {
+                    paths.add("writeNumberProperty(long)");
+                    gen.writeNumberProperty(e.getKey(), v.longValue());
+                    continue;
+                }
+                if (r == 3) {
+                    paths.add("writeName(SerializableString)");
+                    gen.writeName(new SerializedString(e.getKey()));
+                } else {
+                    gen.writeName(e.getKey());
+                }
+                writeVia(tc, gen, v, paths);
+            }
+            gen.writeEndObject();
+        }
+    }
+
+    static final Pattern DOUBLED_CONTINUATION = Pattern.compile("(^|\\r|\\n) *\\\\\\\\(\\r|\\n)");
+
+    @Test
+    void generatorCallsAgreeWithTheTreeWriter() {
+        Hegel.test(tc -> {
+            YamlGen g = new YamlGen(tc, false);
+            Options o = new Options(tc);
+            JsonNode tree = genNode(tc, g, 0);
+            JsonNode expected = o.expected(tree);
+            List<String> values = new ArrayList<>(), keys = new ArrayList<>();
+            strings(tree, values, keys);
+            if (o.knownLoss(tree, values, o.resolver()) != null) {
+                return;
+            }
+            String reference;
+            try {
+                reference = o.mapper.writeValueAsString(tree);
+            } catch (JacksonException ex) {
+                return; // the tree writer's failure is the other property's finding
+            }
+            List<String> paths = new ArrayList<>();
+            StringWriter sw = new StringWriter();
+            try (JsonGenerator gen = o.mapper.createGenerator(sw)) {
+                writeVia(tc, gen, tree, paths);
+            } catch (JacksonException | UnsupportedOperationException ex) {
+                fail("the generator threw " + ex.getClass().getSimpleName() + ": " + JacksonYamlTest.firstLine(ex.getMessage()) + " via " + paths + " with " + o.style + " for " + Canon.show(expected));
+                return;
+            }
+            String text = sw.toString();
+            String tag = "via " + paths + " with " + o.style + ", value " + Canon.show(expected) + describe(text);
+            JacksonYamlTest.Loaded back = JacksonYamlTest.readAll(o.reader, text);
+            check(back.ok() && back.docs.size() == 1 && back.docs.get(0).equals(expected), () -> "the generator's text reads back as " + back + " for " + tag);
+            // writeNumber(String) and writePOJO may spell numbers differently; otherwise the text is the tree writer's
+            boolean spellingMayDiffer = paths.stream().anyMatch(p -> p.startsWith("writeNumber(String)") || p.startsWith("writePOJO") || p.equals("writeNumber(short)"));
+            if (!spellingMayDiffer) {
+                check(text.equals(reference), () -> "the generator's text differs from the tree writer's:" + describe(reference) + "vs" + tag);
+            }
+            // type ids and object ids on collections survive
+            if (tree.isContainer() && !hasBinary(tree) && chance(tc, 50)) {
+                String typeId = pick(tc, "T", "my.Type", "t1", "a-b");
+                String objectId = pick(tc, "a", "id1", "x_y");
+                boolean withType = chance(tc, 60);
+                boolean withObject = chance(tc, 60);
+                sw = new StringWriter();
+                try (JsonGenerator gen = o.mapper.createGenerator(sw)) {
+                    gen.writeStartArray();
+                    if (withType) {
+                        gen.writeTypeId(typeId);
+                    }
+                    if (withObject) {
+                        gen.writeObjectId(objectId);
+                    }
+                    gen.writeTree(tree);
+                    if (withObject) {
+                        gen.writeObjectRef(objectId);
+                    }
+                    gen.writeEndArray();
+                } catch (JacksonException ex) {
+                    fail("writing ids threw " + ex.getClass().getSimpleName() + ": " + JacksonYamlTest.firstLine(ex.getMessage()) + " with " + o.style + " for " + Canon.show(expected));
+                    return;
+                }
+                String idText = sw.toString();
+                String idTag = "ids type=" + (withType ? typeId : "-") + " object=" + (withObject ? objectId : "-") + " with " + o.style + describe(idText);
+                boolean nativeIds = o.on(YAMLWriteFeature.USE_NATIVE_TYPE_ID) && o.on(YAMLWriteFeature.USE_NATIVE_OBJECT_ID);
+                if (nativeIds) {
+                    // the replaying parser gives the value twice
+                    YAMLMapper replaying = new YAMLMapper(new YAMLAnchorReplayingFactory(o.mapper.tokenStreamFactory() instanceof YAMLFactory ? (YAMLFactory) o.mapper.tokenStreamFactory() : new YAMLFactory()));
+                    JacksonYamlTest.Loaded rep = JacksonYamlTest.readAll(replaying, idText);
+                    List<JsonNode> want = new ArrayList<>();
+                    want.add(expected);
+                    if (withObject) {
+                        want.add(expected);
+                    }
+                    check(rep.ok() && rep.docs.size() == 1 && rep.docs.get(0).equals(Canon.seq(want)), () -> "the replaying parser reads " + rep + " instead of " + Canon.show(Canon.seq(want)) + " for " + idTag);
+                    // the streaming parser reports the ids at the collection's start
+                    try (JsonParser p = o.reader.createParser(idText)) {
+                        p.nextToken(); // START_ARRAY
+                        JsonToken start = p.nextToken();
+                        Object tid = p.getTypeId();
+                        Object oid = p.getObjectId();
+                        if (oid == null && start == JsonToken.START_OBJECT) {
+                            p.nextToken(); // the anchor of an object is reported at its first property name
+                            oid = p.getObjectId();
+                        }
+                        Object tidF = tid, oidF = oid;
+                        check(!withType || typeId.equals(tidF), () -> "the type id reads as " + tidF + " for " + idTag);
+                        check(!withObject || objectId.equals(oidF), () -> "the object id reads as " + oidF + " for " + idTag);
+                    } catch (JacksonException ex) {
+                        fail("reading ids threw " + ex.getClass().getSimpleName() + ": " + JacksonYamlTest.firstLine(ex.getMessage()) + " for " + idTag);
+                    }
+                    // the engine reads the alias as the same value
+                    JacksonYamlTest.Loaded eng = JacksonYamlTest.engineAll(JacksonYamlTest.engine(o.core), idText.replace("!" + typeId + " ", "").replace("!<" + typeId + "> ", ""));
+                    if (!withType) {
+                        check(eng.ok() && eng.docs.size() == 1 && eng.docs.get(0).equals(Canon.seq(want)), () -> "the engine reads the ids text as " + eng + " for " + idTag);
+                    }
+                }
+            }
+        }, Zoo.settings("generatorCallsAgreeWithTheTreeWriter"));
+    }
+}
