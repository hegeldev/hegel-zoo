+    /** What the schema's resolver says the plain scalar is; Jackson's token must match. */
+    static String expectedKind(ScalarResolver r, String s) {
+        Tag t = r.resolve(s, true);
+        if (t.equals(Tag.INT)) {
+            return "int";
+        }
+        if (t.equals(Tag.FLOAT)) {
+            return "float";
+        }
+        if (t.equals(Tag.BOOL)) {
+            return "bool";
+        }
+        if (t.equals(Tag.NULL)) {
+            return "null";
+        }
+        return "string";
+    }
+
+    static String kindOf(JsonNode canon) {
+        if (canon.isNull()) {
+            return "null";
+        }
+        if (canon.isBoolean()) {
+            return "bool";
+        }
+        if (canon.isTextual()) {
+            return "string";
+        }
+        if (canon.has("$n")) {
+            return "int";
+        }
+        if (canon.has("$f")) {
+            return "float";
+        }
+        return canon.getNodeType().toString();
+    }
