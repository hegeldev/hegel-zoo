+    /** Adds the entries; a key already used gets an x behind it (the engine rejects duplicate keys, Jackson keeps the last). */
+    static void addPairs(List<Pair> pairs, List<String> keys, List<String> values) {
+        for (Pair p : pairs) {
+            addKey(keys, p.key());
+            values.add(String.valueOf(p.value()));
+        }
+    }
