+    String plainScalar(TestCase tc) {
+        int r = n(tc, 1, 12);
+        switch (r) {
+            case 1:
+            case 2:
+            case 3:
+                return pick(tc, ODD_SCALARS);
+            case 4: { // decimal int, sometimes signed, with leading zeros or underscores
+                String d = Long.toString(Math.abs((long) n(tc, 0, 999999999) * (chance(tc, 30) ? 1000000000L : 1)));
+                if (chance(tc, 15)) {
+                    d = "0" + d;
+                }
+                if (chance(tc, 15)) {
+                    d = underscore(tc, d);
+                }
+                return pick(tc, "", "", "-", "+") + d;
+            }
+            case 5: // other bases
+                return pick(tc, "", "-", "+") + pick(tc, "0x", "0X", "0b", "0o", "0") + underscore(tc, pick(tc, "1f", "7", "101", "0", "ff_ff", "17", "9", "a", "8", "ffffffff", "1ffffffff"));
+            case 6: { // float
+                String f = pick(tc, "", "-", "+") + (chance(tc, 80) ? Integer.toString(n(tc, 0, 999)) : "") + "." + (chance(tc, 85) ? Integer.toString(n(tc, 0, 9999)) : "");
+                if (chance(tc, 40)) {
+                    f += pick(tc, "e", "E") + pick(tc, "", "+", "-") + n(tc, 0, 400);
+                }
+                return chance(tc, 10) ? underscore(tc, f) : f;
+            }
+            case 7: // digits and letters
+                return Zoo.word(tc, "0123456789abcdefxo_.:-+eE", 1, 8);
+            case 8: // a word-ish string
+                return Zoo.word(tc, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.", 1, 8);
+            default: // a string from the pool that fits a plain scalar
+                for (int i = 0; i < 10; i++) {
+                    String s = pick(tc, YamlGen.STRING_POOL);
+                    if (!s.isEmpty() && !YamlGen.hasAny(s, "\n\r\t") && !YamlGen.hasControl(s) && !YamlGen.hasSurrogate(s) && YamlGen.PLAIN_BAN_FIRST.indexOf(s.charAt(0)) < 0 && !s.contains(": ") && !s.contains(" #") && !s.endsWith(":") && !s.endsWith(" ") && !s.startsWith("---") && !s.startsWith("...") && s.length() < 100) {
+                        return s;
+                    }
+                }
+                return "plain";
+        }
+    }
