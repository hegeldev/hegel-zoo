+    // ---- the token stream ----------------------------------------------------------------------
+
+    /** A parser's tokens, each with what Jackson reports for it (names, texts, exact numbers, binary). */
+    static List<String> tokens(JsonParser p) {
+        List<String> out = new ArrayList<>();
+        for (JsonToken t = p.nextToken(); t != null; t = p.nextToken()) {
+            StringBuilder sb = new StringBuilder(t.name());
+            switch (t) {
+                case PROPERTY_NAME:
+                    sb.append(' ').append(Canon.show(Canon.string(p.currentName()))).append(" text=").append(Canon.show(Canon.string(p.getString())));
+                    break;
+                case VALUE_STRING:
+                    sb.append(' ').append(Canon.show(Canon.string(p.getString())));
+                    break;
+                case VALUE_NUMBER_INT:
+                    sb.append(' ').append(p.getNumberType()).append(' ').append(p.getBigIntegerValue()).append(" exact=").append(p.getNumberValueExact());
+                    break;
+                case VALUE_NUMBER_FLOAT: {
+                    double d = p.getDoubleValue();
+                    sb.append(' ').append(p.getNumberType()).append(' ').append(Double.isNaN(d) ? "nan" : Long.toHexString(Double.doubleToLongBits(d)));
+                    break;
+                }
+                case VALUE_EMBEDDED_OBJECT:
+                    sb.append(' ').append(Canon.show(Canon.binary(p.getBinaryValue())));
+                    break;
+                default:
+                    break;
+            }
+            out.add(sb.toString());
+        }
+        return out;
+    }
+
+    static String diffLists(List<String> a, List<String> b) {
+        StringBuilder sb = new StringBuilder();
+        int max = Math.max(a.size(), b.size());
+        int shown = 0;
+        for (int i = 0; i < max && shown < 5; i++) {
+            String x = i < a.size() ? a.get(i) : "<none>", y = i < b.size() ? b.get(i) : "<none>";
+            if (!x.equals(y)) {
+                sb.append("\n    #").append(i).append(": ").append(x).append("\n      -> ").append(y);
+                shown++;
+            }
+        }
+        return sb.toString();
+    }
+
+    // ---- 1. written documents read as their trees ----------------------------------------------
+
+    @Test
+    void writtenDocumentsReadAsTheirTrees() {
+        Hegel.test(tc -> {
+            boolean core = chance(tc, 30);
+            YamlGen g = new YamlGen(tc, core);
+            List<YamlGen.Tree> trees = genTrees(g);
+            List<String> style = new ArrayList<>();
+            String text = g.writeStream(trees, style);
+            List<JsonNode> expected = new ArrayList<>();
+            for (YamlGen.Tree t : trees) {
+                expected.add(t.canon());
+            }
+            String tag = "style " + style + (core ? " core schema" : " json schema") + describe(text);
+            YAMLMapper mapper = yaml(core);
+            Loaded mine = readAll(mapper, text);
+            check(mine.ok() && mine.docs.equals(expected), () -> "Jackson reads " + mine + " instead of " + show(expected) + " for " + tag);
+            Loaded theirs = engineAll(engine(core), text);
+            check(theirs.ok() && theirs.docs.equals(expected), () -> "the engine reads " + theirs + " instead of " + show(expected) + " for " + tag);
+            // the same trees as JSON, through Jackson's JSON reader, give the same canonical form (guards Canon)
+            for (int i = 0; i < trees.size(); i++) {
+                YamlGen.Tree t = trees.get(i);
+                JsonNode viaJson = Canon.ofTree(JSON.readTree(t.json()));
+                check(viaJson.equals(t.canon()), () -> "the JSON reader gives " + Canon.show(viaJson) + " for " + t.json());
+            }
+            // the YAML token stream equals the JSON token stream of the same documents (one document at a time)
+            if (trees.size() == 1) {
+                List<String> yamlTokens, jsonTokens;
+                try (JsonParser p = mapper.createParser(text)) {
+                    yamlTokens = tokens(p);
+                }
+                try (JsonParser p = JSON.createParser(trees.get(0).json())) {
+                    jsonTokens = tokens(p);
+                }
+                List<String> yamlCmp = new ArrayList<>(yamlTokens), jsonCmp = new ArrayList<>(jsonTokens);
+                if (core) {
+                    // 0x7fffffff is a LONG by digit count where the JSON reader says INT (README, observed)
+                    yamlCmp.replaceAll(t -> t.replaceFirst("^VALUE_NUMBER_INT (INT|LONG|BIG_INTEGER) ", "VALUE_NUMBER_INT "));
+                    jsonCmp.replaceAll(t -> t.replaceFirst("^VALUE_NUMBER_INT (INT|LONG|BIG_INTEGER) ", "VALUE_NUMBER_INT "));
+                }
+                check(yamlCmp.equals(jsonCmp), () -> "the YAML tokens differ from the JSON tokens:" + diffLists(jsonCmp, yamlCmp) + "\nfor " + tag);
+                // every input path gives the same tokens
+                byte[] bytes = text.getBytes(StandardCharsets.UTF_8);
+                int path = n(tc, 1, 4);
+                List<String> again;
+                String pathName;
+                switch (path) {
+                    case 1:
+                        pathName = "byte[]";
+                        try (JsonParser p = mapper.createParser(bytes)) {
+                            again = tokens(p);
+                        }
+                        break;
+                    case 2:
+                        pathName = "Reader";
+                        try (JsonParser p = mapper.createParser(new StringReader(text))) {
+                            again = tokens(p);
+                        }
+                        break;
+                    case 3:
+                        pathName = "InputStream";
+                        try (JsonParser p = mapper.createParser(new ByteArrayInputStream(bytes))) {
+                            again = tokens(p);
+                        }
+                        break;
+                    default:
+                        pathName = "char[]";
+                        try (JsonParser p = mapper.createParser(text.toCharArray())) {
+                            again = tokens(p);
+                        }
+                }
+                check(again.equals(yamlTokens), () -> "the " + pathName + " parser gives other tokens:" + diffLists(yamlTokens, again) + "\nfor " + tag);
+            }
+            // readTree of a single document agrees with readValues
+            if (trees.size() == 1 && !style.contains("end-marker")) {
+                try {
+                    JsonNode one = Canon.ofTree(mapper.readTree(text));
+                    check(one.equals(expected.get(0)), () -> "readTree gives " + Canon.show(one) + " instead of " + Canon.show(expected.get(0)) + " for " + tag);
+                } catch (JacksonException e) {
+                    fail("readTree threw " + e.getClass().getSimpleName() + ": " + firstLine(e.getMessage()) + " for " + tag);
+                }
+            }
+        }, Zoo.settings("writtenDocumentsReadAsTheirTrees"));
+    }
