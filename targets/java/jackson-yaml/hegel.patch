+        /** The recorded bugs' loss shapes (bugs.toml); the properties fail on them by default and skip them under HEGEL_NO_KNOWN. */
+        String knownBug(JsonNode tree, List<String> values, List<String> keys) {
+            // custom dumperOptions drop CANONICAL_OUTPUT with the other built options
+            if (on(YAMLWriteFeature.CANONICAL_OUTPUT) && dump == null) {
+                return "CANONICAL_OUTPUT double-quotes every scalar (jackson-yaml/8)";
+            }
+            // needToQuoteName never quotes "<<", so a key is plain under every option; a value only under MINIMIZE_QUOTES
+            if (core && (keys.contains("<<") || on(YAMLWriteFeature.MINIMIZE_QUOTES) && values.contains("<<"))) {
+                return "the merge key written plain (jackson-yaml/11)";
+            }
+            if (values.stream().anyMatch(s -> unquoted(s) && s.indexOf('\u0085') >= 0) || keys.stream().anyMatch(s -> s.indexOf('\u0085') >= 0)) {
+                return "a next-line character written unquoted folds away (jackson-yaml/1)";
+            }
+            if (core && on(YAMLWriteFeature.MINIMIZE_QUOTES) && on(YAMLWriteFeature.ALWAYS_QUOTE_NUMBERS_AS_STRINGS) && values.stream().anyMatch(s -> numberLike(s, YamlGen.CORE_RESOLVER) && !numberLike(s, YamlGen.JSON_RESOLVER))) {
+                return "ALWAYS_QUOTE_NUMBERS_AS_STRINGS knows only the JSON schema's numbers (jackson-yaml/5)";
+            }
+            // jackson-yaml/13: StringQuotingChecker lets a string starting with U+FEFF go plain (a key always, a value under
+            // MINIMIZE_QUOTES); as the first scalar of a document without a start marker it starts the stream, where every reader swallows the
+            // byte order mark (reproduced standalone: "\ufeff" reads as no document, "\ufeffa" as "a", a first key "\ufeff" leaves ": ..."; with
+            // the marker, "--- \ufeff" reads back)
+            String first = tree.isTextual() ? tree.stringValue() : tree.isObject() && !tree.isEmpty() ? tree.propertyNames().iterator().next() : "";
+            if (startsTheStream(true, tree.isObject()) && first.startsWith("\ufeff")) {
+                return "a first scalar starting with U+FEFF written plain at the start of the stream (jackson-yaml/13)";
+            }
+            return null;
+        }
+
+        /** Shapes not compared further: the tolerated ones, and under HEGEL_NO_KNOWN the recorded bugs'. */
+        String knownLoss(JsonNode tree, List<String> values, List<String> keys) {
+            String tolerated = toleratedLoss(tree, values);
+            return tolerated != null ? tolerated : Zoo.NO_KNOWN ? knownBug(tree, values, keys) : null;
+        }
+
+        /** The tree with every string and key of a {@link #toleratedLoss tolerated loss shape} steered away (a letter in front), so the case is read back like any other; under HEGEL_NO_KNOWN the {@link #knownBug recorded bugs'} shapes too. */
+        JsonNode shaped(JsonNode n) {
+            return shaped(n, true);
+        }
+
+        private JsonNode shaped(JsonNode n, boolean first) {
+            if (n.isTextual()) {
+                return F.stringNode(safeValue(n.stringValue(), first));
+            }
+            if (n.isArray()) {
+                ArrayNode a = F.arrayNode();
+                for (JsonNode c : n) {
+                    a.add(shaped(c, false));
+                }
+                return a;
+            }
+            if (n.isObject()) {
+                ObjectNode o = F.objectNode();
+                boolean firstKey = first;
+                for (Map.Entry<String, JsonNode> e : n.properties()) {
+                    o.set(safeKey(e.getKey(), firstKey), shaped(e.getValue(), false));
+                    firstKey = false;
+                }
+                return o;
+            }
+            return n;
+        }
+
+        String safeValue(String s) {
+            return safeValue(s, false);
+        }
+
+        /** A string value not of a tolerated loss shape; under HEGEL_NO_KNOWN not of a recorded bug's shape either. */
+        String safeValue(String s, boolean first) {
+            boolean minimize = on(YAMLWriteFeature.MINIMIZE_QUOTES);
+            boolean quoteNumbers = on(YAMLWriteFeature.ALWAYS_QUOTE_NUMBERS_AS_STRINGS);
+            if (minimize && !quoteNumbers && numberLike(s, resolver())
+                    || indentedIndicator() && s.contains("\n") && (s.startsWith(" ") || s.startsWith("\n"))) {
+                return "s" + s;
+            }
+            if (Zoo.NO_KNOWN) {
+                if (core && minimize && quoteNumbers && numberLike(s, YamlGen.CORE_RESOLVER) && !numberLike(s, YamlGen.JSON_RESOLVER) // jackson-yaml/5
+                        || core && minimize && s.equals("<<") // jackson-yaml/11
+                        || startsTheStream(first, false) && s.startsWith("\ufeff")) { // jackson-yaml/13
+                    return "s" + s;
+                }
+                if (unquoted(s)) {
+                    return s.replace('\u0085', 'n'); // jackson-yaml/1
+                }
+            }
+            return s;
+        }
+
+        String safeKey(String k) {
+            return safeKey(k, false);
+        }
+
+        /** A key not of a recorded bug's shape under HEGEL_NO_KNOWN (keys are always plain: the merge key under the core schema, a leading U+FEFF first in the stream, a next-line character). */
+        String safeKey(String k, boolean first) {
+            if (!Zoo.NO_KNOWN) {
+                return k;
+            }
+            if (core && k.equals("<<") || startsTheStream(first, true) && k.startsWith("\ufeff")) {
+                return "s" + k;
+            }
+            return k.replace('\u0085', 'n');
+        }
+
+        /** Canon of the node as Jackson's own reader will see it after a dump under these options. */
+        JsonNode expected(JsonNode n) {
+            if (n instanceof FloatNode) {
+                return Canon.floating(Double.parseDouble(Float.toString(n.floatValue())));
+            }
+            if (n.isBigDecimal()) {
+                // written as the BigDecimal's text: "100" is an integer again, "1E+3" a float
+                String text = bigDecimalPlain ? n.decimalValue().toPlainString() : n.decimalValue().toString();
+                Tag tag = resolver().resolve(text, true);
+                if (tag.equals(Tag.INT)) {
+                    return Canon.integer(new BigInteger(text));
+                }
+                return Canon.floating(Double.parseDouble(text));
+            }
+            if (n.isArray()) {
+                List<JsonNode> items = new ArrayList<>();
+                for (JsonNode c : n) {
+                    items.add(expected(c));
+                }
+                return Canon.seq(items);
+            }
+            if (n.isObject()) {
+                List<JsonNode[]> pairs = new ArrayList<>();
+                for (Map.Entry<String, JsonNode> e : n.properties()) {
+                    pairs.add(new JsonNode[] {Canon.string(e.getKey()), expected(e.getValue())});
+                }
+                return Canon.map(pairs);
+            }
+            return Canon.ofTree(n);
+        }
+
+        ScalarResolver resolver() {
+            return core ? YamlGen.CORE_RESOLVER : YamlGen.JSON_RESOLVER;
+        }
+
+        /** A mapper over the same factory whose parser replays anchored nodes at their aliases. */
+        YAMLMapper replaying() {
+            return new YAMLMapper(new YAMLAnchorReplayingFactory(mapper.tokenStreamFactory() instanceof YAMLFactory ? (YAMLFactory) mapper.tokenStreamFactory() : new YAMLFactory()));
+        }
+
+        @Override
+        public String toString() {
+            return "options " + style;
+        }
+    }
+
+    // ---- what a dump must read back as -----------------------------------------------------------
+
+    /** Canon of the node as Jackson's own reader will see it after a dump (floats through their decimal text). */
+    static JsonNode expected(JsonNode n) {
+        if (n instanceof FloatNode) {
+            return Canon.floating(Double.parseDouble(Float.toString(n.floatValue())));
+        }
+        if (n.isArray()) {
+            List<JsonNode> items = new ArrayList<>();
+            for (JsonNode c : n) {
+                items.add(expected(c));
+            }
+            return Canon.seq(items);
+        }
+        if (n.isObject()) {
+            List<JsonNode[]> pairs = new ArrayList<>();
+            for (Map.Entry<String, JsonNode> e : n.properties()) {
+                pairs.add(new JsonNode[] {Canon.string(e.getKey()), expected(e.getValue())});
+            }
+            return Canon.map(pairs);
+        }
+        return Canon.ofTree(n);
+    }
+
+    /** Strings of the tree (values and keys). */
+    static void strings(JsonNode n, List<String> values, List<String> keys) {
+        if (n.isTextual()) {
+            values.add(n.stringValue());
+        } else if (n.isArray()) {
+            for (JsonNode c : n) {
+                strings(c, values, keys);
+            }
+        } else if (n.isObject()) {
+            for (Map.Entry<String, JsonNode> e : n.properties()) {
+                keys.add(e.getKey());
+                strings(e.getValue(), values, keys);
+            }
+        }
+    }
+
+    /** The double of a non-integral node; DecimalNode.doubleValue() throws out of range, BigDecimal's saturates. */
+    static double dbl(JsonNode n) {
+        return n.isBigDecimal() ? n.decimalValue().doubleValue() : n.doubleValue();
+    }
+
+    static boolean hasNonFinite(JsonNode n) {
+        if (n.isNumber() && !n.isIntegralNumber()) {
+            double d = dbl(n);
+            return Double.isNaN(d) || Double.isInfinite(d);
+        }
+        if (n.isContainer()) {
+            for (JsonNode c : n) {
+                if (hasNonFinite(c)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /** A string value MINIMIZE_QUOTES writes plain and the schema then reads as a number (documented: ALWAYS_QUOTE_NUMBERS_AS_STRINGS opts out). */
+    static boolean numberLike(String s, ScalarResolver r) {
+        Tag t = r.resolve(s, true);
+        return t.equals(Tag.INT) || t.equals(Tag.FLOAT);
+    }
+
+    /** The Java value of a tree, for the engine's Dump. */
+    static Object javaValue(JsonNode n) {
+        if (n.isNull()) {
+            return null;
+        }
+        if (n.isBoolean()) {
+            return n.booleanValue();
+        }
+        if (n.isBinary()) {
+            return n.binaryValue();
+        }
+        if (n.isIntegralNumber()) {
+            BigInteger v = n.bigIntegerValue();
+            return v.bitLength() < 32 ? (Object) v.intValue() : v.bitLength() < 64 ? (Object) v.longValue() : v;
+        }
+        if (n.isNumber()) {
+            return n instanceof FloatNode ? Double.parseDouble(Float.toString(n.floatValue())) : dbl(n);
+        }
+        if (n.isTextual()) {
+            return n.stringValue();
+        }
+        if (n.isArray()) {
+            List<Object> l = new ArrayList<>();
+            for (JsonNode c : n) {
+                l.add(javaValue(c));
+            }
+            return l;
+        }
+        Map<Object, Object> m = new LinkedHashMap<>();
+        for (Map.Entry<String, JsonNode> e : n.properties()) {
+            m.put(e.getKey(), javaValue(e.getValue()));
+        }
+        return m;
+    }
+
+    static String describe(String text) {
+        return JacksonYamlTest.describe(text);
+    }
+
+    static String firstLine(String s) {
+        return JacksonYamlTest.firstLine(s);
+    }
+
+    // ---- 1. trees written by Jackson read back ---------------------------------------------------
+
+    /**
+     * The options, the tree, up to two more roots for the multi-document check (none when a %YAML directive is expected: the engine's
+     * emitter writes no "..." before a second directive), and the engine's own dump styles.
+     */
+    record ReadBackCase(Options o, JsonNode tree, List<JsonNode> more, FlowStyle flow, ScalarStyle scalar) {}
+
+    /** Read-back cases over these options, with the tree drawn from the options; the more roots only when asked. */
+    static Generator<ReadBackCase> readBackCases(Generator<Opts> opts, Function<Options, Generator<JsonNode>> tree, boolean more) {
+        return opts.map(Options::new).flatMap(o -> tuples(
+                tree.apply(o),
+                more && !o.directiveExpected() ? many(node(o.finite(), 2), 0, 2).map(xs -> xs.stream().map(o::shaped).toList()) : just(List.<JsonNode>of()),
+                pick(FlowStyle.AUTO, FlowStyle.BLOCK, FlowStyle.FLOW),
+                pick(ScalarStyle.PLAIN, ScalarStyle.PLAIN, ScalarStyle.DOUBLE_QUOTED, ScalarStyle.SINGLE_QUOTED, ScalarStyle.LITERAL, ScalarStyle.FOLDED))
+            .map(t -> new ReadBackCase(o, t.value1(), t.value2(), t.value3(), t.value4())));
+    }
+
+    static final Generator<ReadBackCase> READ_BACK = readBackCases(OPTS, o -> node(o.finite(), 3).map(o::shaped), true);
+
+    @Test
+    void treesWrittenByJacksonReadBack() {
+        Zoo.run("treesWrittenByJacksonReadBack", tc -> readsBack(tc, tc.draw(READ_BACK, "case")));
+    }
+
+    /** The oracle of treesWrittenByJacksonReadBack and of the narrow read-back properties: the frame, the read-back in Jackson and in the engine, several roots, the engine's own dump. */
+    static void readsBack(TestCase tc, ReadBackCase c) {
+        Options o = c.o();
+        JsonNode tree = c.tree();
+        JsonNode expected = o.expected(tree);
+        count("cases");
+        String text;
+        try {
+            text = o.mapper.writeValueAsString(tree);
+        } catch (JacksonException ex) {
+            fail("writing threw " + ex.getClass().getSimpleName() + ": " + firstLine(ex.getMessage()) + " with " + o.style + " for " + Canon.show(expected));
+            return;
+        }
+        String tag = "options " + o.style + ", value " + Canon.show(expected) + describe(text);
+        // the frame
+        String br = o.dump == null ? "\n" : o.dump.getBestLineBreak();
+        check(text.endsWith(br), () -> "the dump does not end with the line break for " + tag);
+        // canonical output always has an explicit document start (the emitter's rule); custom dumperOptions drop CANONICAL_OUTPUT with the other built options
+        boolean canonical = o.on(YAMLWriteFeature.CANONICAL_OUTPUT) && o.dump == null;
+        // an empty scalar as the whole document needs the marker too, or the stream would be empty (the emitter's checkEmptyDocument; the NEL of jackson-yaml/1 shows the same "--- ")
+        boolean emptyRoot = tree.isTextual() && tree.stringValue().isEmpty();
+        check((o.on(YAMLWriteFeature.WRITE_DOC_START_MARKER) || canonical || o.directiveExpected() || emptyRoot) == (text.startsWith("---") || text.startsWith("%YAML")), () -> "the document start marker does not follow WRITE_DOC_START_MARKER for " + tag);
+        check(o.directiveExpected() == text.startsWith("%YAML 1.1"), () -> "the %YAML directive does not follow yamlVersionToWrite for " + tag);
+        List<String> values = new ArrayList<>(), keys = new ArrayList<>();
+        strings(tree, values, keys);
+        // the tolerated loss shapes are steered away from by construction (and under HEGEL_NO_KNOWN the recorded bugs'); what is left is counted
+        String loss = o.knownLoss(tree, values, keys);
+        if (loss != null) {
+            count("skipped: " + loss);
+        }
+        tc.assume(loss == null);
+        // Jackson reads it back
+        JacksonYamlTest.Loaded back = JacksonYamlTest.readAll(o.reader, text);
+        check(back.ok() && back.docs.size() == 1 && back.docs.get(0).equals(expected), () -> "Jackson reads the dump back as " + back + " for " + tag);
+        // the engine reads the same
+        JacksonYamlTest.Loaded theirs = JacksonYamlTest.engineAll(JacksonYamlTest.engine(o.core), text);
+        check(theirs.ok() && theirs.docs.size() == 1 && theirs.docs.get(0).equals(expected), () -> "the engine reads the dump as " + theirs + " for " + tag);
+        // several root values are several documents
+        List<JsonNode> several = new ArrayList<>();
+        several.add(tree);
+        several.addAll(c.more());
+        List<String> v2 = new ArrayList<>(), k2 = new ArrayList<>();
+        List<JsonNode> expectedAll = new ArrayList<>();
+        boolean skipAll = o.directiveExpected() && several.size() > 1; // the engine's emitter writes no "..." before a second %YAML directive (drawn away)
+        if (skipAll) {
+            count("several roots not checked: a %YAML directive");
+        }
+        for (JsonNode nd : several) {
+            expectedAll.add(o.expected(nd));
+            strings(nd, v2, k2);
+            String more = o.knownLoss(nd, v2, k2);
+            if (more != null) {
+                count("several roots not checked: " + more);
+                skipAll = true;
+            }
+        }
+        if (!skipAll) {
+            StringWriter sw = new StringWriter();
+            try (JsonGenerator gen = o.mapper.createGenerator(sw)) {
+                for (JsonNode nd : several) {
+                    gen.writeTree(nd);
+                }
+            } catch (JacksonException ex) {
+                fail("writing several roots threw " + ex.getClass().getSimpleName() + ": " + firstLine(ex.getMessage()) + " for " + tag);
+                return;
+            }
+            String all = sw.toString();
+            JacksonYamlTest.Loaded backAll = JacksonYamlTest.readAll(o.reader, all);
+            check(backAll.ok() && backAll.docs.equals(expectedAll), () -> "several roots read back as " + backAll + " instead of " + JacksonYamlTest.show(expectedAll) + " with " + o.style + describe(all));
+            JacksonYamlTest.Loaded theirsAll = JacksonYamlTest.engineAll(JacksonYamlTest.engine(o.core), all);
+            check(theirsAll.ok() && theirsAll.docs.equals(expectedAll), () -> "the engine reads several roots as " + theirsAll + " instead of " + JacksonYamlTest.show(expectedAll) + " with " + o.style + describe(all));
+        }
+        // the engine's own dump of the same value reads back in Jackson; not of a root string starting with U+FEFF: the engine's emitter writes
+        // it plain and every reader, the engine's own included, swallows the leading byte order mark (belongs to snakeyaml-engine; reproduced standalone)
+        boolean bomRoot = tree.isTextual() && tree.stringValue().startsWith("\ufeff");
+        if (bomRoot) {
+            count("the engine's dump not checked: a root string starting with U+FEFF (snakeyaml-engine)");
+        }
+        tc.assume(!bomRoot);
+        // nor in the single-quoted style of a string with a next-line character: the engine's own Load folds it away beside a space
+        // ("' \u0085'" reads as " "; belongs to snakeyaml-engine; reproduced standalone, candidate/java/jackson-yaml-14)
+        if (c.scalar() == ScalarStyle.SINGLE_QUOTED && (values.stream().anyMatch(s -> s.indexOf('\u0085') >= 0) || keys.stream().anyMatch(s -> s.indexOf('\u0085') >= 0))) {
+            count("the engine's dump not checked: SINGLE_QUOTED with a next-line character (candidate/java/jackson-yaml-14)");
+            return;
+        }
+        DumpSettingsBuilder db = DumpSettings.builder().setDefaultFlowStyle(c.flow()).setDefaultScalarStyle(c.scalar());
+        if (o.core) {
+            db.setSchema(new CoreSchema());
+        }
+        String engineText;
+        try {
+            engineText = new Dump(db.build()).dumpToString(javaValue(tree));
+        } catch (RuntimeException ex) {
+            fail("the engine's dump threw " + ex.getClass().getSimpleName() + ": " + firstLine(ex.getMessage()) + " for " + Canon.show(expected));
+            return;
+        }
+        JacksonYamlTest.Loaded fromEngine = JacksonYamlTest.readAll(JacksonYamlTest.yaml(o.core), engineText);
+        JsonNode pure = expected(tree); // the engine writes the Java value (a BigDecimal "1000" went in as the double 1000.0)
+        check(fromEngine.ok() && fromEngine.docs.size() == 1 && fromEngine.docs.get(0).equals(pure), () -> "Jackson reads the engine's dump as " + fromEngine + " instead of " + Canon.show(pure) + describe(engineText));
+    }
+
+    // ---- 2. the generator's entry points agree ---------------------------------------------------
+
+    /** Writes a tree through the generator's entry points, each chosen by the next coin of the tape (a coin of 0 is the plain call). */
+    static final class Via {
+        final List<Integer> coins;
+        final List<String> paths = new ArrayList<>();
+        int at;
+
+        Via(List<Integer> coins) {
+            this.coins = coins;
+        }
+
+        int coin() {
+            return Gen.tape(coins, at++, 0);
+        }
+
+        boolean coin(int pct) {
+            return coin() >= 100 - pct;
+        }
+
+        void write(JsonGenerator gen, JsonNode nd) {
+            if (nd.isNull()) {
+                if (coin(20)) {
+                    paths.add("writePOJO(null)");
+                    gen.writePOJO(null);
+                } else {
+                    gen.writeNull();
+                }
+            } else if (nd.isBoolean()) {
+                gen.writeBoolean(nd.booleanValue());
+            } else if (nd.isBinary()) {
+                byte[] b = nd.binaryValue();
+                int r = choose(coin(), 50, 25, 25); // plain, a variant with offset and length, from a stream
+                if (r == 1) {
+                    paths.add("writeBinary(variant, off, len)");
+                    byte[] padded = new byte[b.length + 3];
+                    System.arraycopy(b, 0, padded, 2, b.length);
+                    gen.writeBinary(Base64Variants.MIME, padded, 2, b.length);
+                } else if (r == 2 && !Zoo.NO_KNOWN) { // unsupported, jackson-yaml/10: the plain call under HEGEL_NO_KNOWN
+                    paths.add("writeBinary(InputStream)");
+                    gen.writeBinary(Base64Variants.getDefaultVariant(), new ByteArrayInputStream(b), b.length);
+                } else {
+                    gen.writeBinary(b);
+                }
+            } else if (nd.isIntegralNumber()) {
+                BigInteger v = nd.bigIntegerValue();
+                int r = choose(coin(), 50, 17, 17, 16); // by size, String, BigInteger, short when it fits
+                if (r == 1) {
+                    paths.add("writeNumber(String)");
+                    gen.writeNumber(v.toString());
+                } else if (r == 2) {
+                    paths.add("writeNumber(BigInteger)");
+                    gen.writeNumber(v);
+                } else if (r == 3 && v.bitLength() < 16) {
+                    paths.add("writeNumber(short)");
+                    gen.writeNumber(v.shortValue());
+                } else if (v.bitLength() < 32) {
+                    gen.writeNumber(v.intValue());
+                } else if (v.bitLength() < 64) {
+                    gen.writeNumber(v.longValue());
+                } else {
+                    gen.writeNumber(v);
+                }
+            } else if (nd.isNumber()) {
+                if (nd instanceof FloatNode) {
+                    gen.writeNumber(nd.floatValue());
+                } else if (nd.isBigDecimal()) {
+                    gen.writeNumber(nd.decimalValue());
+                } else if (coin(20) && !Double.isNaN(nd.doubleValue()) && !Double.isInfinite(nd.doubleValue())) {
+                    paths.add("writeNumber(String) for a double");
+                    gen.writeNumber(Double.toString(nd.doubleValue()));
+                } else {
+                    gen.writeNumber(nd.doubleValue());
+                }
+            } else if (nd.isTextual()) {
+                String s = nd.stringValue();
+                switch (choose(coin(), 34, 17, 17, 16, 16)) {
+                    case 1:
+                        paths.add("writeString(char[])");
+                        char[] padded = ("xx" + s + "y").toCharArray();
+                        gen.writeString(padded, 2, s.length());
+                        break;
+                    case 2:
+                        paths.add("writeString(SerializableString)");
+                        gen.writeString(new SerializedString(s));
+                        break;
+                    case 3:
+                        if (!YamlGen.hasSurrogate(s)) {
+                            paths.add("writeUTF8String");
+                            byte[] b = s.getBytes(StandardCharsets.UTF_8);
+                            gen.writeUTF8String(b, 0, b.length);
+                            break;
+                        }
+                        gen.writeString(s);
+                        break;
+                    case 4:
+                        paths.add("writePOJO(String)");
+                        gen.writePOJO(s);
+                        break;
+                    default:
+                        gen.writeString(s);
+                }
+            } else if (nd.isArray()) {
+                if (coin(15)) {
+                    paths.add("writeTree(array)");
+                    gen.writeTree(nd);
+                    return;
+                }
+                boolean allInts = nd.size() > 0;
+                for (JsonNode c : nd) {
+                    allInts &= c.isIntegralNumber() && c.bigIntegerValue().bitLength() < 32;
+                }
+                if (allInts && coin(40)) {
+                    paths.add("writeArray(int[])");
+                    int[] xs = new int[nd.size() + 1];
+                    for (int i = 0; i < nd.size(); i++) {
+                        xs[i + 1] = nd.get(i).intValue();
+                    }
+                    gen.writeArray(xs, 1, nd.size());
+                    return;
+                }
+                switch (choose(coin(), 34, 33, 33)) {
+                    case 1:
+                        paths.add("writeStartArray(obj)");
+                        gen.writeStartArray(nd);
+                        break;
+                    case 2:
+                        paths.add("writeStartArray(obj, size)");
+                        gen.writeStartArray(nd, nd.size());
+                        break;
+                    default:
+                        gen.writeStartArray();
+                }
+                for (JsonNode c : nd) {
+                    write(gen, c);
+                }
+                gen.writeEndArray();
+            } else {
+                if (coin(15)) {
+                    paths.add("writeTree(object)");
+                    gen.writeTree(nd);
+                    return;
+                }
+                switch (choose(coin(), 34, 33, 33)) {
+                    case 1:
+                        paths.add("writeStartObject(obj)");
+                        gen.writeStartObject(nd);
+                        break;
+                    case 2:
+                        paths.add("writeStartObject(obj, size)");
+                        gen.writeStartObject(nd, nd.size());
+                        break;
+                    default:
+                        gen.writeStartObject();
+                }
+                for (Map.Entry<String, JsonNode> e : nd.properties()) {
+                    JsonNode v = e.getValue();
+                    int r = choose(coin(), 40, 20, 20, 20); // writeName, writeStringProperty, writeNumberProperty, writeName(SerializableString)
+                    if (r == 1 && v.isTextual()) {
+                        paths.add("writeStringProperty");
+                        gen.writeStringProperty(e.getKey(), v.stringValue());
+                        continue;
+                    }
+                    if (r == 2 && v.isIntegralNumber() && v.bigIntegerValue().bitLength() < 64) {
+                        paths.add("writeNumberProperty(long)");
+                        gen.writeNumberProperty(e.getKey(), v.longValue());
+                        continue;
+                    }
+                    if (r == 3) {
+                        paths.add("writeName(SerializableString)");
+                        gen.writeName(new SerializedString(e.getKey()));
+                    } else {
+                        gen.writeName(e.getKey());
+                    }
+                    write(gen, v);
+                }
+                gen.writeEndObject();
+            }
+        }
+    }
+
+    /** Type and object ids written around the tree. */
+    record Ids(String typeId, String objectId, boolean withType, boolean withObject) {}
+
+    static final Generator<Ids> IDS = tuples(pick("T", "my.Type", "t1", "a-b"), pick("a", "id1", "x_y"), chance(60), chance(60)).map(t -> new Ids(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    /** The options, the tree, the coins the streaming writer reads, and perhaps ids to write around the tree (under HEGEL_NO_KNOWN used only when it is a container). */
+    record GeneratorCase(Options o, JsonNode tree, List<Integer> coins, Ids ids) {}
+
+    static final Generator<GeneratorCase> GENERATOR_CASE = OPTS.map(Options::new).flatMap(o -> tuples(node(o.finite(), 3).map(o::shaped), many(ints(0, 99), 0, 40), maybe(50, (Ids) null, IDS))
+        .map(t -> new GeneratorCase(o, t.value1(), t.value2(), t.value3())));
