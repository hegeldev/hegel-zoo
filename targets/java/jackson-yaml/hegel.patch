+        addKey(keys, "k1");
+        values.add(c.undefined() ? c.value() : "&" + c.anchor() + " " + c.value());
+        addPairs(c.between(), keys, values);
+        addKey(keys, "k2");
+        values.add(Zoo.NO_KNOWN ? c.value() : "*" + c.anchor());
+        addPairs(c.after(), keys, values);
+        return layout(c.position(), keys, values, "");
+    }
+
+    @Test
+    void aliasesReadAsTheAnchoredValue() {
+        Zoo.run("aliasesReadAsTheAnchoredValue", tc -> {
+            AliasCase c = tc.draw(ALIAS_CASE, "case");
+            String text = aliasText(c);
+            String tag = (c.core() ? "core schema" : "json schema") + describe(text);
