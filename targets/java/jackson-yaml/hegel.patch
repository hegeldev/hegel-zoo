+    // ---------------------------------------------------------------- the three views of a tree
+
+    static JsonNode canon(Node n) {
+        return switch (n) {
+            case Null x -> Canon.nul();
+            case Bool b -> Canon.bool(b.v());
+            case Int i -> Canon.integer(i.v());
+            case Flt f -> Canon.floating(f.v());
+            case Str s -> Canon.string(s.v());
+            case Seq s -> {
+                List<JsonNode> a = new ArrayList<>();
+                for (Item it : s.items()) {
+                    a.add(canon(it.node()));
+                }
+                yield Canon.seq(a);
+            }
+            case Mapping m -> {
+                List<JsonNode[]> pairs = new ArrayList<>();
+                for (Entry e : m.entries()) {
+                    pairs.add(new JsonNode[] {Canon.string(e.key()), canon(e.node())});
+                }
+                yield Canon.map(pairs);
+            }
+        };
+    }
+
+    static Object java(Node n) {
+        return switch (n) {
+            case Null x -> null;
+            case Bool b -> b.v();
+            case Int i -> i.v() >= Integer.MIN_VALUE && i.v() <= Integer.MAX_VALUE ? (Object) (int) i.v() : (Object) i.v();
+            case Flt f -> f.v();
+            case Str s -> s.v();
+            case Seq s -> {
+                List<Object> l = new ArrayList<>();
+                for (Item it : s.items()) {
+                    l.add(java(it.node()));
+                }
+                yield l;
+            }
+            case Mapping m -> {
+                Map<Object, Object> out = new LinkedHashMap<>();
+                for (Entry e : m.entries()) {
+                    out.put(e.key(), java(e.node()));
+                }
+                yield out;
+            }
+        };
+    }
+
+    static void json(Node n, StringBuilder sb) {
+        switch (n) {
+            case Null x -> sb.append("null");
+            case Bool b -> sb.append(b.v());
+            case Int i -> sb.append(i.v());
+            case Flt f -> {
+                double d = f.v();
+                if (Double.isNaN(d) || Double.isInfinite(d)) {
+                    sb.append(Double.isNaN(d) ? "NaN" : d > 0 ? "Infinity" : "-Infinity");
+                } else {
+                    sb.append(Double.toString(d));
+                }
+            }
+            case Str s -> jsonString(s.v(), sb);
+            case Seq s -> {
+                sb.append('[');
+                for (int i = 0; i < s.items().size(); i++) {
+                    if (i > 0) {
+                        sb.append(',');
+                    }
+                    json(s.items().get(i).node(), sb);
+                }
+                sb.append(']');
+            }
+            case Mapping m -> {
+                sb.append('{');
+                for (int i = 0; i < m.entries().size(); i++) {
+                    if (i > 0) {
+                        sb.append(',');
+                    }
+                    jsonString(m.entries().get(i).key(), sb);
+                    sb.append(':');
+                    json(m.entries().get(i).node(), sb);
+                }
+                sb.append('}');
+            }
+        }
+    }
+
+    static void jsonString(String s, StringBuilder sb) {
+        sb.append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '"' || c == '\\') {
+                sb.append('\\').append(c);
+            } else if (c < 0x20 || (c >= 0xd800 && c <= 0xdfff) || c == 0x2028 || c == 0x2029 || c == 0xfeff || c == 0x85 || c == 0x7f) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        sb.append('"');
+    }
+
+    // ---------------------------------------------------------------- what fits which scalar style
+
+    static boolean isControl(int c) {
+        return c <= 0x08 || c == 0x0b || c == 0x0c || (c >= 0x0e && c <= 0x1f) || c == 0x7f || c == 0x85 || c == 0x2028 || c == 0x2029 || c == 0xfeff;
+    }
+
+    static boolean hasControl(String s) {
+        return s.codePoints().anyMatch(YamlGen::isControl);
+    }
+
+    static boolean hasSurrogate(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
+                    i++;
+                    continue;
+                }
+                return true;
+            }
+            if (Character.isLowSurrogate(c)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean hasAny(String s, String chars) {
+        for (int i = 0; i < s.length(); i++) {
+            if (chars.indexOf(s.charAt(i)) >= 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * A string may be plain when the syntax leaves it whole and the schema's resolver gives a
+     * string back. Not: empty, multi-line, tabs, leading/trailing space.
+     */
+    static boolean plainSafe(String s, boolean flow, ScalarResolver resolver) {
+        if (s.isEmpty() || hasAny(s, "\n\r\t") || hasControl(s) || hasSurrogate(s)) {
+            return false;
+        }
+        if (PLAIN_BAN_FIRST.indexOf(s.charAt(0)) >= 0) {
+            return false;
+        }
+        if (s.contains(": ") || s.contains(" #") || s.endsWith(":") || s.endsWith(" ")) {
+            return false;
+        }
+        if (s.startsWith("---") || s.startsWith("...")) {
+            return false;
+        }
+        if (s.equals("<<")) {
+            return false; // the merge key
+        }
+        if (flow && hasAny(s, ",[]{}:?")) {
+            return false;
+        }
+        if (s.length() > 1000) {
+            return false;
+        }
+        return resolver.resolve(s, true).equals(Tag.STR);
+    }
+
+    static boolean singleOK(String s) {
+        return !hasAny(s, "\n\r\t") && !hasControl(s) && !hasSurrogate(s) && s.length() <= 1000;
+    }
+
+    static String single(String s) {
+        return "'" + s.replace("'", "''") + "'";
+    }
+
+    static List<String> splitLines(String s) {
+        return new ArrayList<>(Arrays.asList(s.split("\n", -1)));
+    }
+
+    /**
+     * A literal block can hold s when it is multi-line, free of CR/tab/controls, not all whitespace,
+     * no line ends in a space and the first non-empty line does not start with one.
+     */
+    static boolean literalOK(String s) {
+        if (!s.contains("\n") || hasAny(s, "\r\t") || hasControl(s) || s.trim().isEmpty() || hasSurrogate(s)) {
+            return false;
+        }
+        List<String> lines = splitLines(s);
+        String first = null;
+        for (String l : lines) {
+            if (!l.isEmpty() && l.trim().isEmpty()) {
+                return false;
+            }
+            if (l.endsWith(" ")) {
+                return false;
+            }
+            if (first == null && !l.isEmpty()) {
+                first = l;
+            }
+        }
+        return first != null && !first.startsWith(" ");
+    }
+
+    /** A folded block can hold s when no line is empty or starts/ends with a space or holds two. */
+    static boolean foldedOK(String s) {
+        if (!literalOK(s) && !(!s.isEmpty() && !s.contains("\n") && s.contains(" "))) {
+            return false;
+        }
+        if (hasAny(s, "\r\t") || hasControl(s) || hasSurrogate(s)) {
+            return false;
+        }
+        for (String l : splitLines(s.replaceAll("\n+$", ""))) {
+            if (l.isEmpty() || l.startsWith(" ") || l.endsWith(" ") || l.contains("  ")) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static final class Chomp {
+        final String trimmed;
+        final int trailing;
+        final String chomp;
+
+        Chomp(String s) {
+            trimmed = s.replaceAll("\n+$", "");
+            trailing = s.length() - trimmed.length();
+            chomp = trailing == 0 ? "-" : trailing == 1 ? "" : "+";
+        }
+    }
+
+    static boolean isKeep(List<String> block) {
+        return block != null && block.get(0).matches("^[|>][0-9]?\\+.*|^[|>]\\+.*");
+    }
+
+    static String ascii(String s) {
+        StringBuilder sb = new StringBuilder();
+        for (char c : s.toCharArray()) {
+            if (c >= 0x20 && c <= 0x7e) {
+                sb.append(c);
+            }
+        }
+        return sb.length() > 20 ? sb.substring(0, 20) : sb.toString();
+    }
+
+    // ---------------------------------------------------------------- the writer
+
+    static final String[] NULLS = {"null", "null", "Null", "NULL", "~"};
+    static final String[] TRUES = {"true", "true", "True", "TRUE"};
+    static final String[] FALSES = {"false", "false", "False", "FALSE"};
+    static final String[] ZEROS = {"0", "0", "+0", "0x0", "0o0", "-0"};
+    static final String[] INFS = {".inf", ".Inf", ".INF"};
+    static final String[] NEG_INFS = {"-.inf", "-.Inf", "-.INF"};
+    static final String[] NANS = {".nan", ".NaN", ".NAN"};
+    static final String[] NEG_ZEROS = {"-0.0", "-0.0e+0", "-0."};
+    static final String[] FLOW_SEPS = {" ", " ", "", "  "};
+
+    /** Writes a stream in the spellings of one schema (core: 0x, 0o, +1, ~, Null, True, .Inf; else only the JSON schema's), reading the tapes for the small choices. */
+    static final class Writer {
+        final boolean core;
+        final ScalarResolver resolver;
+        final Stream stream;
+        final List<String> style = new ArrayList<>();
+        int spaceAt;
+        int coinAt;
+        boolean fragileTail; // after a keep-chomped block scalar an empty line would join its content
+
+        Writer(boolean core, Stream stream) {
+            this.core = core;
+            this.resolver = core ? CORE_RESOLVER : JSON_RESOLVER;
+            this.stream = stream;
+        }
+
+        Written write() {
+            StringBuilder out = new StringBuilder();
+            List<Doc> docs = stream.docs();
+            for (int i = 0; i < docs.size(); i++) {
+                out.append(document(docs.get(i), i > 0));
+            }
+            return new Written(out.toString(), style);
+        }
+
+        /** The next coin of the tape, 0..99 (0 when the tape is empty). */
+        int coin() {
+            return Gen.tape(stream.coins(), coinAt++, 0);
+        }
+
+        /** The next coin read as a biased boolean: true with about pct/100, false for a coin of 0. */
+        boolean coin(int pct) {
+            return coin() >= 100 - pct;
+        }
+
+        /** Zero to two spaces, from the spaces tape. */
+        String sp() {
+            return " ".repeat(Gen.tape(stream.spaces(), spaceAt++, 0));
+        }
+
+        // ---- scalars
+
+        /**
+         * An integer: decimal in the JSON schema; in the core schema also signed, 0x hex or 0o octal
+         * (never with leading zeros — a Jackson feature reads those as octal).
+         */
+        String integer(Int n) {
+            long v = n.v();
+            int spell = n.spell();
+            if (!core) {
+                return v == 0 && spell >= 9 ? "-0" : Long.toString(v);
+            }
+            if (v == 0) {
+                return ZEROS[spell % 6];
+            }
+            if (v < 0) {
+                return Long.toString(v);
+            }
+            return switch (spell) {
+                case 8 -> "0x" + Long.toHexString(v);
+                case 9 -> "0x" + Long.toHexString(v).toUpperCase();
+                case 10 -> "0o" + Long.toOctalString(v);
+                case 11 -> "+" + v;
+                default -> Long.toString(v);
+            };
+        }
+
+        /**
+         * A float in the schema's spelling: the JSON schema's `-?(0|[1-9][0-9]*)(\.[0-9]*)?([eE][-+]?[0-9]+)?`
+         * plus `.inf`/`-.inf`/`.nan`; the core schema also `+`, a leading dot and the capitalised words.
+         */
+        String floating(Flt n) {
+            double f = n.v();
+            if (f == Double.POSITIVE_INFINITY) {
+                return core ? INFS[n.variant()] : ".inf"; // not "+.inf": snakeyaml-engine's core float constructor fails on it
+            }
+            if (f == Double.NEGATIVE_INFINITY) {
+                return core ? NEG_INFS[n.variant()] : "-.inf";
+            }
+            if (Double.isNaN(f)) {
+                return core ? NANS[n.variant()] : ".nan";
+            }
+            if (f == 0 && 1 / f < 0) {
+                return NEG_ZEROS[n.variant()];
+            }
+            String plain = Double.toString(f); // 1.5, 1.0E21, 1.0E-7
+            String s = switch (n.form()) {
+                case 1 -> plain;
+                case 2 -> Math.abs(f) < 1e17 && Math.abs(f) >= 1e-6 ? new java.math.BigDecimal(f).toPlainString() : plain.toLowerCase();
+                default -> plain.toLowerCase();
+            };
+            if (n.canonical()) {
+                // a dot and a signed exponent: the spelling every YAML version accepts
+                s = s.replaceFirst("^([-+]?\\d+)([eE])", "$1.0$2");
+                s = s.replaceFirst("([eE])(\\d)", "$1+$2");
+                if (!s.contains(".")) {
+                    s += ".0";
+                }
+            } else {
+                // 1.2 spellings: 1e21, 5., 1.0E21
+                s = s.replaceFirst("\\.0([eE])", "$1");
+                if (s.endsWith(".0") && n.trim()) {
+                    s = s.substring(0, s.length() - 1);
+                }
+                if (!s.contains(".") && !s.contains("e") && !s.contains("E")) {
+                    s += ".";
+                }
+            }
+            if (core && s.startsWith("0.") && s.length() > 2 && Character.isDigit(s.charAt(2)) && n.shortZero()) {
+                s = s.substring(1);
+            }
+            if (core && Character.isDigit(s.charAt(0)) && n.plus()) {
+                s = "+" + s;
+            }
+            return s;
+        }
+
+        String doubleQuoted(String s) {
+            StringBuilder out = new StringBuilder("\"");
+            int i = 0;
+            while (i < s.length()) {
+                int c = s.codePointAt(i);
+                i += Character.charCount(c);
+                if (c == '"') {
+                    out.append("\\\"");
+                } else if (c == '\\') {
+                    out.append("\\\\");
+                } else if (c == '\n') {
+                    out.append(coin(20) ? "\\x0a" : "\\n");
+                } else if (c == '\r') {
+                    out.append("\\r");
+                } else if (c == '\t') {
+                    out.append(coin(30) ? "\\x09" : "\\t");
+                } else if (c == 0x85) {
+                    out.append("\\N");
+                } else if (c == 0xa0) {
+                    out.append(coin(50) ? "\\xa0" : "\\_");
+                } else if (c == 0x2028) {
+                    out.append("\\u2028"); // snakeyaml-engine rejects the 1.2 escapes \L and \P
+                } else if (c == 0x2029) {
+                    out.append("\\u2029");
+                } else if (c == 0xfeff) {
+                    out.append("\\ufeff");
+                } else if (c == '/' && coin(30)) {
+                    out.append("\\/"); // YAML 1.2 has the escape
+                } else if (c < 0x20 || c == 0x7f) {
+                    out.append(String.format("\\x%02x", c));
+                } else if (c >= 0xd800 && c <= 0xdfff) {
+                    out.append(String.format("\\u%04x", c));
+                } else if (c == ' ' && coin(10)) {
+                    out.append("\\ ");
+                } else if (c > 0x7f && coin(30)) {
+                    out.append(c < 0x10000 ? String.format("\\u%04x", c) : String.format("\\U%08x", c));
+                } else {
+                    out.appendCodePoint(c);
+                }
+            }
+            return out.append('"').toString();
+        }
+
+        /** The text in the drawn quoting, falling back down the ladder plain, single, double where the text does not fit. */
+        String quoted(String s, int quote, boolean flow) {
+            int q = quote >= 3 ? 0 : quote;
+            if (q == 0 && plainSafe(s, flow, resolver)) {
+                return s;
+            }
+            if (q <= 1 && singleOK(s)) {
+                return single(s);
+            }
+            return doubleQuoted(s);
+        }
+
+        String scalar(Node t, boolean flow) {
+            return switch (t) {
+                case Null x -> core ? NULLS[x.variant()] : "null";
+                case Bool b -> !core ? String.valueOf(b.v()) : b.v() ? TRUES[b.variant()] : FALSES[b.variant()];
+                case Int i -> integer(i);
+                case Flt f -> floating(f);
+                case Str s -> quoted(s.v(), s.quote(), flow);
+                default -> throw new IllegalArgumentException("not a scalar: " + t);
+            };
+        }
+
+        String key(String k, int quote, boolean flow) {
+            return quoted(k, quote, flow);
+        }
+
+        // ---- block scalars
+
+        String header(String kind, String chomp, String ind, BlockStyle b) {
+            String h = b.indFirst() ? kind + ind + chomp : kind + chomp + ind;
+            if (b.comment()) {
+                h += " # comment";
+            }
+            return h;
+        }
+
+        /** Lines of a literal block for s, content indented by `indent` spaces (parent at parentIndent). */
+        List<String> literal(String s, int parentIndent, int indent, BlockStyle b) {
+            Chomp c = new Chomp(s);
+            List<String> lines = splitLines(c.trimmed);
+            String ind = "";
+            if (!c.chomp.equals("+") && indent - parentIndent <= 9 && b.indicator()) {
+                ind = Integer.toString(indent - parentIndent);
+            }
+            List<String> out = new ArrayList<>();
+            out.add(header("|", c.chomp, ind, b));
+            String pad = " ".repeat(indent);
+            for (String l : lines) {
+                out.add(l.isEmpty() ? (coin(50) ? pad : "") : pad + l);
+            }
+            for (int i = 1; i < c.trailing; i++) {
+                out.add("");
+            }
+            return out;
+        }
+
+        /** Lines of a folded block for s: single spaces may become line breaks (a coin per word), a newline an empty line. */
+        List<String> folded(String s, int parentIndent, int indent, BlockStyle b) {
+            Chomp c = new Chomp(s);
+            List<String> srcLines = splitLines(c.trimmed);
+            String ind = "";
+            if (!c.chomp.equals("+") && indent - parentIndent <= 9 && b.indicator()) {
+                ind = Integer.toString(indent - parentIndent);
+            }
+            List<String> out = new ArrayList<>();
+            out.add(header(">", c.chomp, ind, b));
+            String pad = " ".repeat(indent);
+            for (int i = 0; i < srcLines.size(); i++) {
+                if (i > 0) {
+                    out.add("");
+                }
+                String[] words = srcLines.get(i).split(" ", -1);
+                String cur = words[0];
+                for (int w = 1; w < words.length; w++) {
+                    if (coin(40)) {
+                        out.add(pad + cur);
+                        cur = words[w];
+                    } else {
+                        cur += " " + words[w];
+                    }
+                }
+                out.add(pad + cur);
+            }
+            for (int i = 1; i < c.trailing; i++) {
+                out.add("");
+            }
+            return out;
+        }
+
+        /** A block scalar's lines after the head (key or `-`) when the string's quoting is a block style that fits it, else null. */
+        List<String> blockScalarLines(Str t, int indent) {
+            if (t.quote() < 3) {
+                return null;
+            }
+            String s = t.v();
+            int step = t.block().step();
+            boolean lit = literalOK(s);
+            boolean fold = foldedOK(s);
+            if (t.quote() == 3 && lit) {
+                return literal(s, indent, indent + step, t.block());
+            }
+            if (fold) {
+                return folded(s, indent, indent + step, t.block());
+            }
+            if (lit) {
+                return literal(s, indent, indent + step, t.block());
+            }
+            return null;
+        }
+
+        // ---- collections
+
+        String flow(Node t) {
+            if (t instanceof Seq q) {
+                if (q.items().isEmpty()) {
+                    return "[" + sp() + "]";
+                }
+                String sep = sp() + "," + FLOW_SEPS[q.sep()];
+                StringBuilder s = new StringBuilder("[").append(sp());
+                for (int i = 0; i < q.items().size(); i++) {
+                    if (i > 0) {
+                        s.append(sep);
+                    }
+                    s.append(flow(q.items().get(i).node()));
+                }
+                if (q.trailingComma()) {
+                    s.append(sp()).append(",");
+                }
+                return s.append(sp()).append("]").toString();
+            }
+            if (t instanceof Mapping m) {
+                if (m.entries().isEmpty()) {
+                    return "{" + sp() + "}";
+                }
+                String sep = sp() + "," + FLOW_SEPS[m.sep()];
+                StringBuilder s = new StringBuilder("{").append(sp());
+                for (int i = 0; i < m.entries().size(); i++) {
+                    if (i > 0) {
+                        s.append(sep);
+                    }
+                    Entry e = m.entries().get(i);
+                    s.append(key(e.key(), e.keyQuote(), true)).append(sp()).append(": ").append(sp()).append(flow(e.node()));
+                }
+                if (m.trailingComma()) {
+                    s.append(sp()).append(",");
+                }
+                return s.append(sp()).append("}").toString();
+            }
+            return scalar(t, true);
+        }
+
+        /** Lines of a collection in block style, every line indented by `indent` spaces. */
+        List<String> blockLines(Node t, int indent) {
+            String pad = " ".repeat(indent);
+            List<String> lines = new ArrayList<>();
+            if (t instanceof Mapping m) {
+                for (Entry e : m.entries()) {
+                    String k = e.key();
+                    Node kid = e.node();
+                    EntryStyle st = e.style();
+                    fragileTail = false;
+                    if (st.commentBefore()) {
+                        lines.add(pad + "# before " + ascii(k));
+                    }
+                    String head = pad + key(k, e.keyQuote(), false) + ":";
+                    boolean explicit = false;
+                    if (st.explicit() && !k.contains("\n")) {
+                        lines.add(pad + "? " + key(k, e.keyQuote(), false));
+                        head = pad + ":";
+                        explicit = true;
+                    }
+                    List<String> block = kid instanceof Str s ? blockScalarLines(s, indent) : null;
+                    if (kid instanceof Null && st.emptyNull()) {
+                        lines.add(head + st.comment());
+                    } else if (block != null) {
+                        lines.add(head + " " + block.get(0));
+                        lines.addAll(block.subList(1, block.size()));
+                        fragileTail = isKeep(block);
+                    } else if (kid.isColl() && kid.size() > 0 && st.block()) {
+                        int step = st.step();
+                        if (kid instanceof Seq && !explicit && st.zeroStep()) {
+                            step = 0;
+                        }
+                        lines.add(head + st.comment());
+                        lines.addAll(blockLines(kid, indent + step));
+                    } else if (kid.isColl()) {
+                        lines.add(head + " " + flow(kid) + st.comment());
+                    } else {
+                        lines.add(head + " " + sp() + scalar(kid, false) + st.comment());
+                    }
+                    if (st.blankAfter() && !fragileTail) {
+                        lines.add("");
+                    }
+                }
+            } else if (t instanceof Seq q) {
+                for (Item it : q.items()) {
+                    Node kid = it.node();
+                    fragileTail = false;
+                    List<String> block = kid instanceof Str s ? blockScalarLines(s, indent) : null;
+                    if (kid.isColl() && kid.size() > 0 && it.compact()) {
+                        // compact: "- k: v" / "- - a", the rest aligned under the first entry
+                        List<String> sub = blockLines(kid, indent + 2);
+                        sub.set(0, pad + "- " + sub.get(0).substring(indent + 2));
+                        lines.addAll(sub);
+                    } else if (kid.isColl() && kid.size() > 0) {
+                        lines.add(pad + "-" + it.comment());
+                        lines.addAll(blockLines(kid, indent + it.step()));
+                    } else if (block != null) {
+                        lines.add(pad + "- " + block.get(0));
+                        lines.addAll(block.subList(1, block.size()));
+                        fragileTail = isKeep(block);
+                    } else if (kid.isColl()) {
+                        lines.add(pad + "- " + flow(kid) + it.comment());
+                    } else if (kid instanceof Null && it.bareNull()) {
+                        lines.add(pad + "-");
+                    } else {
+                        lines.add(pad + "- " + sp() + scalar(kid, false) + it.comment());
+                    }
+                    if (it.blankAfter() && !fragileTail) {
+                        lines.add("");
+                    }
+                }
+            } else {
+                lines.add(pad + scalar(t, false));
+            }
+            return lines;
+        }
+
+        /** A whole document for the tree, as text; `style` records the top-level choices. */
+        String document(Doc d, boolean forceMarker) {
+            DocStyle s = d.style();
+            Node t = d.root();
+            StringBuilder out = new StringBuilder();
+            if (s.leadingComment()) {
+                out.append("# leading comment\n");
+                style.add("leading-comment");
+            }
+            // a blank line straight after the previous document's keep-chomped block scalar would join its
+            // content (a comment line in between ends the scalar)
+            if (s.blank() && (s.leadingComment() || !fragileTail)) {
+                out.append("\n");
+            }
+            fragileTail = false;
+            boolean marker = forceMarker || s.marker();
+            if (marker) {
+                style.add("marker");
+            }
+            if (t.isColl() && t.size() > 0 && s.block()) {
+                if (marker) {
+                    out.append("---").append(s.markerComment()).append("\n");
+                }
+                int indent = s.rootIndent();
+                if (indent > 0) {
+                    style.add("indented-root");
+                }
+                out.append(String.join("\n", blockLines(t, indent))).append("\n");
+                style.add("block");
+            } else if (t.isColl()) {
+                if (marker) {
+                    out.append("--- ");
+                }
+                out.append(flow(t)).append("\n");
+                style.add("flow");
+            } else if (t instanceof Str str && (literalOK(str.v()) || foldedOK(str.v())) && s.blockScalar()) {
+                // a top-level block scalar without an indentation indicator
+                String v = str.v();
+                boolean useLiteral = literalOK(v) && (!foldedOK(v) || s.useLiteral());
+                List<String> lines = useLiteral ? literal(v, -1, s.step(), str.block()) : folded(v, -1, s.step(), str.block());
+                lines.set(0, lines.get(0).replaceFirst("^([|>])([+-]?)[0-9]", "$1$2").replaceFirst("^([|>])[0-9]([+-])", "$1$2"));
+                out.append(marker ? "--- " : "").append(String.join("\n", lines)).append("\n");
+                style.add("block-scalar");
+                fragileTail = isKeep(lines);
+            } else {
+                if (marker) {
+                    out.append("--- ");
+                }
+                out.append(scalar(t, false)).append("\n");
+                style.add("scalar");
+            }
+            if (s.endMarker()) {
+                out.append("...\n");
+                style.add("end-marker");
+                fragileTail = false;
+            }
+            if (s.trailingComment()) {
+                out.append("# trailing comment\n");
+                fragileTail = false;
+            }
+            return out.toString();
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..e310c6c
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,120 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    /**
+     * Off by default: the properties draw the recorded bugs' shapes (bugs.toml) and fail on them, and are the expected
+     * failures beside the pins. {@code HEGEL_NO_KNOWN=1} switches the shapes off, for a run that looks past the known bugs.
+     */
+    static final boolean NO_KNOWN = notEmpty(System.getenv("HEGEL_NO_KNOWN"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    /** Runs a property under {@link #settings}; in collect mode the {@link #count statistics} follow as a {@code STATS} line. */
+    static void run(String name, java.util.function.Consumer<TestCase> body) {
+        dev.hegel.Hegel.test(body, settings(name));
+        if (COLLECT) {
+            String st = stats();
+            if (!st.equals("{}")) {
+                System.out.println("STATS " + name + " " + st);
+                System.out.flush();
+            }
+        }
+    }
+
+    private static final java.util.Map<String, Integer> STATS = new java.util.TreeMap<>();
+
+    /** Bumps a statistic (the shape of a case, the reason it was assumed away); printed in collect mode. */
+    static synchronized void count(String key) {
+        STATS.merge(key, 1, Integer::sum);
+    }
+
+    /** The statistics so far, cleared, as one line. */
+    static synchronized String stats() {
+        String s = STATS.toString();
+        STATS.clear();
+        return s;
+    }
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
