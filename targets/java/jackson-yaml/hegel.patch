+
+    static String inPosition(String s, int position) {
+        return switch (position) {
+            case 0 -> s + "\n";
+            case 1 -> "--- " + s + "\n";
+            case 2 -> "k: " + s + "\n";
+            case 3 -> "- " + s + "\n";
+            case 4 -> "[" + s + "]\n";
+            default -> "{k: " + s + "}\n";
+        };
+    }
