+    /** Options over the shapes' schema (null: drawn) with these features forced and CANONICAL_OUTPUT off (its own shape is jackson-yaml/8). */
+    static Generator<Opts> shapeOpts(Boolean core, boolean bare, Object... forced) {
+        Map<YAMLWriteFeature, Boolean> m = new LinkedHashMap<>();
+        m.put(YAMLWriteFeature.CANONICAL_OUTPUT, false);
+        for (int i = 0; i < forced.length; i += 2) {
+            m.put((YAMLWriteFeature) forced[i], (Boolean) forced[i + 1]);
+        }
+        return opts(core, m, bare);
+    }
