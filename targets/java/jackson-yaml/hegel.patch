+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel zoo: property-based tests for jackson-dataformat-yaml against the module built from this checkout
+     (`mvn -pl yaml -am -DskipTests install` at the root first; see targets/java/jackson-yaml in the zoo).
+     snakeyaml-engine (the YAML 1.2 processor Jackson wraps) is the second reader and writer. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>jackson-yaml-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <jackson.yaml.version>3.3.0-SNAPSHOT</jackson.yaml.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <!-- jackson-core/databind 3.3.0-SNAPSHOT (the module's dependencies at this commit) live in Central's snapshot repository -->
+  <repositories>
+    <repository>
+      <id>central-snapshots</id>
+      <url>https://central.sonatype.com/repository/maven-snapshots</url>
+      <releases><enabled>false</enabled></releases>
+      <snapshots><enabled>true</enabled></snapshots>
+    </repository>
+  </repositories>
+
+  <dependencies>
+    <dependency>
+      <groupId>tools.jackson.dataformat</groupId>
+      <artifactId>jackson-dataformat-yaml</artifactId>
+      <version>${jackson.yaml.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g</argLine>
+          <trimStackTrace>false</trimStackTrace>
+          <!-- every test's `ZOO …` line is what the zoo judges; Maven's exit code is not -->
+          <testFailureIgnore>true</testFailureIgnore>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Canon.java b/hegel/src/test/java/zoo/Canon.java
new file mode 100644
index 0000000..15b3593
--- /dev/null
+++ b/hegel/src/test/java/zoo/Canon.java
@@ -0,0 +1,185 @@
+package zoo;
+
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.node.ArrayNode;
+import tools.jackson.databind.node.JsonNodeFactory;
+import tools.jackson.databind.node.ObjectNode;
+
+/**
+ * One canonical form for values read by Jackson (a {@link JsonNode} tree) and by snakeyaml-engine
+ * (plain Java objects), so the two can be compared exactly: null, booleans and strings as
+ * themselves, integers of any size as {@code {"$n": digits}}, floats as {@code {"$f": hex bits}}
+ * ("nan" for NaN), binary as {@code {"$b": base64}}, sets as {@code {"$set": [...]}}, mappings as
+ * {@code {"$m": [[k, v], ...]}} with the pairs sorted by the key's text (so equality is unordered),
+ * sequences as arrays. Jackson's {@code JsonNode.equals} on the result is the comparison.
+ */
+final class Canon {
+
+    static final JsonNodeFactory F = JsonNodeFactory.instance;
+
+    static JsonNode nul() {
+        return F.nullNode();
+    }
+
+    static JsonNode bool(boolean b) {
+        return F.booleanNode(b);
+    }
+
+    static JsonNode string(String s) {
+        return F.textNode(s);
+    }
+
+    static JsonNode integer(BigInteger v) {
+        ObjectNode o = F.objectNode();
+        o.put("$n", v.toString());
+        return o;
+    }
+
+    static JsonNode integer(long v) {
+        return integer(BigInteger.valueOf(v));
+    }
+
+    static JsonNode floating(double d) {
+        ObjectNode o = F.objectNode();
+        o.put("$f", Double.isNaN(d) ? "nan" : Long.toHexString(Double.doubleToLongBits(d)));
+        return o;
+    }
+
+    static JsonNode binary(byte[] b) {
+        ObjectNode o = F.objectNode();
+        o.put("$b", Base64.getEncoder().encodeToString(b));
+        return o;
+    }
+
+    static JsonNode seq(List<JsonNode> items) {
+        ArrayNode a = F.arrayNode();
+        for (JsonNode n : items) {
+            a.add(n);
+        }
+        return a;
+    }
+
+    static JsonNode set(List<JsonNode> items) {
+        List<JsonNode> sorted = new ArrayList<>(items);
+        sorted.sort((x, y) -> x.toString().compareTo(y.toString()));
+        ObjectNode o = F.objectNode();
+        o.set("$set", seq(sorted));
+        return o;
+    }
+
+    /** A mapping from key/value pairs (keys already canonical); duplicate keys keep every pair. */
+    static JsonNode map(List<JsonNode[]> pairs) {
+        List<JsonNode[]> sorted = new ArrayList<>(pairs);
+        sorted.sort((x, y) -> x[0].toString().compareTo(y[0].toString()));
+        ArrayNode a = F.arrayNode();
+        for (JsonNode[] p : sorted) {
+            ArrayNode pair = F.arrayNode();
+            pair.add(p[0]);
+            pair.add(p[1]);
+            a.add(pair);
+        }
+        ObjectNode o = F.objectNode();
+        o.set("$m", a);
+        return o;
+    }
+
+    /** The canonical form of a tree Jackson read (integral numbers exact, other numbers as doubles). */
+    static JsonNode ofTree(JsonNode n) {
+        if (n == null || n.isNull() || n.isMissingNode()) {
+            return nul();
+        }
+        if (n.isBoolean()) {
+            return bool(n.booleanValue());
+        }
+        if (n.isNumber()) {
+            if (n.isIntegralNumber()) {
+                return integer(n.bigIntegerValue());
+            }
+            // DecimalNode.doubleValue() throws for values outside the double range; BigDecimal's saturates to infinity
+            return floating(n.isBigDecimal() ? n.decimalValue().doubleValue() : n.doubleValue());
+        }
+        if (n.isBinary()) {
+            return binary(n.binaryValue());
+        }
+        if (n.isTextual()) {
+            return string(n.stringValue());
+        }
+        if (n.isArray()) {
+            List<JsonNode> items = new ArrayList<>();
+            for (JsonNode c : n) {
+                items.add(ofTree(c));
+            }
+            return seq(items);
+        }
+        if (n.isObject()) {
+            List<JsonNode[]> pairs = new ArrayList<>();
+            for (Map.Entry<String, JsonNode> e : n.properties()) {
+                pairs.add(new JsonNode[] {string(e.getKey()), ofTree(e.getValue())});
+            }
+            return map(pairs);
+        }
+        throw new IllegalArgumentException("no canonical form for " + n.getNodeType() + " " + n);
+    }
+
+    /** The canonical form of a value snakeyaml-engine constructed. */
+    static JsonNode ofObject(Object v) {
+        if (v == null) {
+            return nul();
+        }
+        if (v instanceof Boolean) {
+            return bool((Boolean) v);
+        }
+        if (v instanceof BigInteger) {
+            return integer((BigInteger) v);
+        }
+        if (v instanceof Integer || v instanceof Long || v instanceof Short || v instanceof Byte) {
+            return integer(((Number) v).longValue());
+        }
+        if (v instanceof BigDecimal) {
+            return floating(((BigDecimal) v).doubleValue());
+        }
+        if (v instanceof Double || v instanceof Float) {
+            return floating(((Number) v).doubleValue());
+        }
+        if (v instanceof String) {
+            return string((String) v);
+        }
+        if (v instanceof byte[]) {
+            return binary((byte[]) v);
+        }
+        if (v instanceof List) {
+            List<JsonNode> items = new ArrayList<>();
+            for (Object x : (List<?>) v) {
+                items.add(ofObject(x));
+            }
+            return seq(items);
+        }
+        if (v instanceof Set) {
+            List<JsonNode> items = new ArrayList<>();
+            for (Object x : (Set<?>) v) {
+                items.add(ofObject(x));
+            }
+            return set(items);
+        }
+        if (v instanceof Map) {
+            List<JsonNode[]> pairs = new ArrayList<>();
+            for (Map.Entry<?, ?> e : ((Map<?, ?>) v).entrySet()) {
+                pairs.add(new JsonNode[] {ofObject(e.getKey()), ofObject(e.getValue())});
+            }
+            return map(pairs);
+        }
+        throw new IllegalArgumentException("no canonical form for " + v.getClass().getName() + " " + v);
+    }
+
+    static String show(JsonNode n) {
+        String s = String.valueOf(n);
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+}
diff --git a/hegel/src/test/java/zoo/JacksonYamlPinsTest.java b/hegel/src/test/java/zoo/JacksonYamlPinsTest.java
new file mode 100644
index 0000000..51e743b
--- /dev/null
+++ b/hegel/src/test/java/zoo/JacksonYamlPinsTest.java
@@ -0,0 +1,206 @@
+package zoo;
+
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+
+import java.io.StringWriter;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import tools.jackson.core.JacksonException;
+import tools.jackson.core.JsonGenerator;
+import tools.jackson.core.JsonParser;
+import tools.jackson.core.JsonToken;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.dataformat.yaml.YAMLFactory;
+import tools.jackson.dataformat.yaml.YAMLMapper;
+import tools.jackson.dataformat.yaml.YAMLReadFeature;
+import tools.jackson.dataformat.yaml.YAMLSchema;
+import tools.jackson.dataformat.yaml.YAMLWriteFeature;
+
+/**
+ * One pin per recorded bug (bugs.toml). Each asserts the correct behaviour and so fails while the
+ * bug exists; target.toml lists them as expected failures.
+ */
+class JacksonYamlPinsTest {
+
+    static YAMLMapper mapper(YAMLWriteFeature... on) {
+        YAMLMapper.Builder b = YAMLMapper.builder();
+        for (YAMLWriteFeature f : on) {
+            b.enable(f);
+        }
+        return b.build();
+    }
+
+    static YAMLMapper coreMapper(YAMLWriteFeature... on) {
+        YAMLMapper.Builder b = YAMLMapper.builder(YAMLFactory.builder().yamlSchema(YAMLSchema.CORE).build());
+        for (YAMLWriteFeature f : on) {
+            b.enable(f);
+        }
+        return b.build();
+    }
+
+    static String read(YAMLMapper m, String text) {
+        try {
+            return Canon.show(Canon.ofTree(m.readTree(text)));
+        } catch (RuntimeException e) {
+            return e.getClass().getSimpleName() + ": " + JacksonYamlTest.firstLine(e.getMessage());
+        }
+    }
+
+    /** jackson-yaml/1: MINIMIZE_QUOTES writes a lone U+0085 (NEL) plain; it reads back as null. */
+    @Test
+    void pin1_nextLineStringIsQuoted() {
+        YAMLMapper m = mapper(YAMLWriteFeature.MINIMIZE_QUOTES);
+        String text = m.writeValueAsString("\u0085");
+        String back = read(m, text);
+        check(back.equals("\"\\u0085\""), () -> "a lone NEL written with MINIMIZE_QUOTES as " + JacksonYamlTest.describe(text) + "reads back as " + back);
+    }
+
+    /** jackson-yaml/2: EMPTY_DOCUMENT_AS_EMPTY_OBJECT leaves the parser without a context after the synthetic object. */
+    @Test
+    void pin2_emptyDocumentAsEmptyObjectKeepsAContext() {
+        YAMLMapper m = YAMLMapper.builder().enable(YAMLReadFeature.EMPTY_DOCUMENT_AS_EMPTY_OBJECT).build();
+        try (JsonParser p = m.createParser("")) {
+            JsonToken t1 = p.nextToken();
+            JsonToken t2 = p.nextToken();
+            check(t1 == JsonToken.START_OBJECT && t2 == JsonToken.END_OBJECT, () -> "the empty document gives " + t1 + " " + t2);
+            String name;
+            try {
+                name = String.valueOf(p.currentName());
+            } catch (RuntimeException e) {
+                name = e.getClass().getSimpleName();
+            }
+            String nameF = name;
+            check(!name.contains("NullPointer"), () -> "currentName() after the synthetic empty object throws " + nameF);
+        }
+        String back = read(m, "---\n");
+        check(back.equals("{\"$m\":[]}"), () -> "an explicit empty document reads as " + back + " with EMPTY_DOCUMENT_AS_EMPTY_OBJECT");
+    }
+
+    /** jackson-yaml/3: "!!int +" ends the token stream in the middle of a document. */
+    @Test
+    void pin3_taggedSignAloneIsAnErrorOrAString() {
+        YAMLMapper m = new YAMLMapper();
+        List<String> tokens = new ArrayList<>();
+        String outcome;
+        try (JsonParser p = m.createParser("a: !!int +\nb: 1\n")) {
+            for (JsonToken t = p.nextToken(); t != null; t = p.nextToken()) {
+                tokens.add(t.name());
+            }
+            outcome = tokens.toString();
+        } catch (JacksonException e) {
+            outcome = "error";
+        }
+        String o = outcome;
+        check(!o.equals("[START_OBJECT, PROPERTY_NAME]"), () -> "the tokens of 'a: !!int +' stop at " + o);
+    }
+
+    /** jackson-yaml/4: under the core schema PARSE_OCTAL_NUMBERS treats "08" as octal and throws instead of reading 8. */
+    @Test
+    void pin4_leadingZeroWithNonOctalDigitsUnderCore() {
+        YAMLMapper m = coreMapper();
+        for (String[] c : new String[][] {{"08", "8"}, {"09", "9"}, {"0128000000000", "128000000000"}, {"-08", "-8"}}) {
+            String back = read(m, c[0] + "\n");
+            check(back.equals("{\"$n\":\"" + c[1] + "\"}"), () -> "'" + c[0] + "' under the core schema reads as " + back);
+        }
+    }
+
+    /** jackson-yaml/11: MINIMIZE_QUOTES writes the merge key "<<" plain, so a core-schema reader merges or fails. */
+    @Test
+    void pin11_mergeKeyIsQuoted() {
+        YAMLMapper m = coreMapper(YAMLWriteFeature.MINIMIZE_QUOTES);
+        JsonNode tree = m.readTree("{\"a\": {\"x\": 1}, \"<<\": {\"y\": 2}, \"k\": \"<<\"}");
+        String text = m.writeValueAsString(tree);
+        Object back;
+        try {
+            back = new org.snakeyaml.engine.v2.api.Load(org.snakeyaml.engine.v2.api.LoadSettings.builder().setSchema(new org.snakeyaml.engine.v2.schema.CoreSchema()).build()).loadFromString(text);
+        } catch (RuntimeException e) {
+            back = e.getClass().getSimpleName() + ": " + JacksonYamlTest.firstLine(e.getMessage());
+        }
+        Object b = back;
+        check(!text.contains("\n<<:") && !text.contains(": <<\n"), () -> "the merge key is written plain:" + JacksonYamlTest.describe(text) + "and a core-schema reader gives " + b);
+    }
+
+    /** jackson-yaml/10: writeBinary(InputStream) is not supported although the byte[] variants are. */
+    @Test
+    void pin10_writeBinaryFromAStream() {
+        YAMLMapper m = new YAMLMapper();
+        StringWriter sw = new StringWriter();
+        try (JsonGenerator g = m.createGenerator(sw)) {
+            g.writeStartArray();
+            g.writeBinary(new java.io.ByteArrayInputStream(new byte[] {1, 2, 3}), 3);
+            g.writeEndArray();
+        } catch (UnsupportedOperationException e) {
+            fail("writeBinary(InputStream, int) throws " + e);
+            return;
+        }
+        String back = read(m, sw.toString());
+        check(back.equals("[{\"$b\":\"AQID\"}]"), () -> "writeBinary(InputStream) gives" + JacksonYamlTest.describe(sw.toString()) + "which reads as " + back);
+    }
+
+    /** jackson-yaml/5: ALWAYS_QUOTE_NUMBERS_AS_STRINGS uses the JSON schema's number shapes even under the core schema. */
+    @Test
+    void pin5_coreNumberStringsAreQuoted() {
+        YAMLMapper m = coreMapper(YAMLWriteFeature.MINIMIZE_QUOTES, YAMLWriteFeature.ALWAYS_QUOTE_NUMBERS_AS_STRINGS);
+        for (String s : new String[] {"0x1F", "0o17", ".Inf", "+.inf", ".NaN"}) {
+            String text = m.writeValueAsString(s);
+            String back = read(m, text);
+            check(back.equals("\"" + s + "\""), () -> "the string " + s + " written as " + JacksonYamlTest.describe(text) + "reads back as " + back);
+        }
+    }
+
+    /** jackson-yaml/6: an object id before writeBinary is dropped and leaks to the next property name. */
+    @Test
+    void pin6_objectIdBeforeBinary() {
+        YAMLMapper m = new YAMLMapper();
+        StringWriter sw = new StringWriter();
+        try (JsonGenerator g = m.createGenerator(sw)) {
+            g.writeStartObject();
+            g.writeName("a");
+            g.writeObjectId("anch");
+            g.writeBinary(new byte[] {1, 2, 3});
+            g.writeName("b");
+            g.writeString("x");
+            g.writeEndObject();
+        }
+        String text = sw.toString();
+        check(text.contains("a: &anch") && !text.contains("&anch b"), () -> "the anchor lands on the wrong scalar:" + JacksonYamlTest.describe(text));
+    }
+
+    /** jackson-yaml/7: the tree model reads an alias as the anchor's name (upstream #2). */
+    @Test
+    void pin7_aliasInTheTreeModel() {
+        YAMLMapper m = new YAMLMapper();
+        String back = read(m, "a: &x 1\nb: *x\n");
+        check(!back.equals("{\"$m\":[[\"a\",{\"$n\":\"1\"}],[\"b\",\"x\"]]}"), () -> "the alias *x reads as the string \"x\": " + back);
+        String undefined = read(m, "a: *nope\n");
+        check(!undefined.equals("{\"$m\":[[\"a\",\"nope\"]]}"), () -> "an undefined alias reads as its name: " + undefined);
+    }
+
+    /** jackson-yaml/8: CANONICAL_OUTPUT writes every scalar double-quoted, so numbers, booleans and nulls read back as strings. */
+    @Test
+    void pin8_canonicalOutputKeepsTypes() {
+        YAMLMapper m = mapper(YAMLWriteFeature.CANONICAL_OUTPUT);
+        JsonNode tree = m.readTree("{\"a\": [1, \"x\", true, null, 1.5]}");
+        String text = m.writeValueAsString(tree);
+        String back = read(m, text);
+        String want = Canon.show(Canon.ofTree(tree));
+        check(back.equals(want), () -> "CANONICAL_OUTPUT writes" + JacksonYamlTest.describe(text) + "which reads back as " + back + " instead of " + want);
+    }
+
+    /** jackson-yaml/9: a type id before a scalar value is silently dropped. */
+    @Test
+    void pin9_typeIdOnAScalar() {
+        YAMLMapper m = new YAMLMapper();
+        StringWriter sw = new StringWriter();
+        try (JsonGenerator g = m.createGenerator(sw)) {
+            g.writeStartArray();
+            g.writeTypeId("T");
+            g.writeString("v");
+            g.writeEndArray();
+        }
+        String text = sw.toString();
+        check(text.contains("!T") || text.contains("!<T>"), () -> "the type id on a scalar is dropped:" + JacksonYamlTest.describe(text));
+    }
+}
diff --git a/hegel/src/test/java/zoo/JacksonYamlTest.java b/hegel/src/test/java/zoo/JacksonYamlTest.java
new file mode 100644
index 0000000..1b58171
--- /dev/null
+++ b/hegel/src/test/java/zoo/JacksonYamlTest.java
@@ -0,0 +1,582 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.ByteArrayInputStream;
+import java.io.StringReader;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+import java.util.regex.Pattern;
+import org.junit.jupiter.api.Test;
+import org.snakeyaml.engine.v2.api.Load;
+import org.snakeyaml.engine.v2.api.LoadSettings;
+import org.snakeyaml.engine.v2.nodes.Tag;
+import org.snakeyaml.engine.v2.resolver.ScalarResolver;
+import org.snakeyaml.engine.v2.schema.CoreSchema;
+import tools.jackson.core.JacksonException;
+import tools.jackson.core.JsonParser;
+import tools.jackson.core.JsonToken;
+import tools.jackson.core.json.JsonReadFeature;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.MappingIterator;
+import tools.jackson.databind.json.JsonMapper;
+import tools.jackson.dataformat.yaml.YAMLFactory;
+import tools.jackson.dataformat.yaml.YAMLMapper;
+import tools.jackson.dataformat.yaml.YAMLSchema;
+
+/**
+ * jackson-dataformat-yaml's reader against the YAML 1.2 processor it wraps (snakeyaml-engine) and
+ * against Jackson's own JSON reader: a randomised YAML writer produces documents whose value is
+ * known, and the three readers must agree on it.
+ */
+class JacksonYamlTest {
+
+    static final Load ENGINE = new Load(LoadSettings.builder().build());
+    static final Load ENGINE_CORE = new Load(LoadSettings.builder().setSchema(new CoreSchema()).build());
+    static final YAMLMapper YAML = new YAMLMapper();
+    static final YAMLMapper YAML_CORE = YAMLMapper.builder(YAMLFactory.builder().yamlSchema(YAMLSchema.CORE).build()).build();
+    static final JsonMapper JSON = JsonMapper.builder().enable(JsonReadFeature.ALLOW_NON_NUMERIC_NUMBERS).build();
+
+    static YAMLMapper yaml(boolean core) {
+        return core ? YAML_CORE : YAML;
+    }
+
+    static Load engine(boolean core) {
+        return core ? ENGINE_CORE : ENGINE;
+    }
+
+    /** What a reader gave for a stream: the canonical form of every document, or an error. */
+    static final class Loaded {
+        final List<JsonNode> docs;
+        final String error;
+        final Throwable cause;
+
+        Loaded(List<JsonNode> docs, Throwable cause) {
+            this.docs = docs;
+            this.cause = cause;
+            this.error = cause == null ? null : cause.getClass().getSimpleName() + ": " + firstLine(cause.getMessage());
+        }
+
+        boolean ok() {
+            return error == null;
+        }
+
+        /** The exception is one Jackson documents (a JacksonException), not an escaped runtime failure. */
+        boolean jacksonError() {
+            return cause instanceof JacksonException;
+        }
+
+        @Override
+        public String toString() {
+            if (!ok()) {
+                return "error " + error;
+            }
+            StringBuilder sb = new StringBuilder();
+            for (JsonNode d : docs) {
+                sb.append(sb.length() == 0 ? "" : " | ").append(Canon.show(d));
+            }
+            return docs.size() + " doc(s): " + sb;
+        }
+    }
+
+    static String firstLine(String s) {
+        if (s == null) {
+            return "null";
+        }
+        int i = s.indexOf('\n');
+        String l = i < 0 ? s : s.substring(0, i);
+        return l.length() > 200 ? l.substring(0, 200) + "…" : l;
+    }
+
+    /** Every document of the stream through Jackson's tree model. */
+    static Loaded readAll(YAMLMapper mapper, String text) {
+        List<JsonNode> docs = new ArrayList<>();
+        try (JsonParser p = mapper.createParser(text)) {
+            MappingIterator<JsonNode> it = mapper.readValues(p, JsonNode.class);
+            while (it.hasNext()) {
+                docs.add(Canon.ofTree(it.next()));
+            }
+            return new Loaded(docs, null);
+        } catch (RuntimeException | StackOverflowError e) {
+            return new Loaded(null, e);
+        }
+    }
+
+    /** Every document of the stream through the engine's own constructor. */
+    static Loaded engineAll(Load load, String text) {
+        List<JsonNode> docs = new ArrayList<>();
+        try {
+            for (Object o : load.loadAllFromString(text)) {
+                docs.add(Canon.ofObject(o));
+            }
+            return new Loaded(docs, null);
+        } catch (RuntimeException | StackOverflowError e) {
+            return new Loaded(null, e);
+        }
+    }
+
+    /** The engine gives typed keys; Jackson's property names are always strings, so such documents are not compared. */
+    static boolean hasNonStringKeys(Load load, String text) {
+        try {
+            for (Object o : load.loadAllFromString(text)) {
+                if (nonStringKey(o)) {
+                    return true;
+                }
+            }
+        } catch (RuntimeException | StackOverflowError e) {
+            return false;
+        }
+        return false;
+    }
+
+    static boolean nonStringKey(Object o) {
+        if (o instanceof java.util.Map<?, ?> m) {
+            for (java.util.Map.Entry<?, ?> e : m.entrySet()) {
+                if (!(e.getKey() instanceof String) || nonStringKey(e.getValue())) {
+                    return true;
+                }
+            }
+        } else if (o instanceof Iterable<?> it) {
+            for (Object c : it) {
+                if (nonStringKey(c)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /** Scalars where the differential oracle itself is wrong or Jackson's behaviour is pinned (bugs.toml / README). */
+    static String knownScalar(String s, boolean core) {
+        if (core && s.matches("\\+\\.(inf|Inf|INF)")) {
+            return "snakeyaml-engine's core schema fails on +.inf";
+        }
+        if (core && s.matches("[-+]?0[0-9_]+")) {
+            return "PARSE_OCTAL_NUMBERS reads a leading zero as octal (017 = 15, a feature; 08 throws, jackson-yaml/4)";
+        }
+        return null;
+    }
+
+    static String describe(String text) {
+        StringBuilder sb = new StringBuilder("\n    ");
+        String shown = text.length() > 1500 ? text.substring(0, 1500) + "…" : text;
+        for (int i = 0; i < shown.length(); i++) {
+            char c = shown.charAt(i);
+            if (c == '\n') {
+                sb.append("\n    ");
+            } else if (c == '\t') {
+                sb.append("\\t");
+            } else if (c == '\r') {
+                sb.append("\\r");
+            } else if (c < 0x20 || c == 0x7f || c == 0x85 || c == 0xa0 || c == 0x2028 || c == 0x2029 || c == 0xfeff || (c >= 0xd800 && c <= 0xdfff)) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.append('\n').toString();
+    }
+
+    static List<YamlGen.Tree> genTrees(YamlGen g) {
+        int docs = chance(g.tc, 80) ? 1 : n(g.tc, 2, 4);
+        List<YamlGen.Tree> trees = new ArrayList<>();
+        for (int i = 0; i < docs; i++) {
+            trees.add(g.genTree(0));
+        }
+        return trees;
+    }
