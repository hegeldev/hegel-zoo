+        });
+    }
+
+    /**
+     * jackson-yaml/7: an anchored node and an alias to it (under HEGEL_NO_KNOWN the anchored text repeated instead), or an alias
+     * to no anchor, among random entries in one of the four collection positions; Jackson and the engine must agree.
+     */
+    record AliasCase(boolean core, String anchor, String value, boolean undefined, int position, List<Pair> before, List<Pair> between, List<Pair> after) {}
+
+    static final Generator<String> ANCHORED = pick("1", "x", "true", "1.5", "null", "[1, 2]", "{k: v}", "\"q\"");
+
