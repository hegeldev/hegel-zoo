+import org.junit.jupiter.api.Test;
+import org.snakeyaml.engine.v2.api.Load;
+import org.snakeyaml.engine.v2.api.LoadSettings;
+import org.snakeyaml.engine.v2.nodes.Tag;
+import org.snakeyaml.engine.v2.resolver.ScalarResolver;
+import org.snakeyaml.engine.v2.schema.CoreSchema;
+import tools.jackson.core.JacksonException;
+import tools.jackson.core.JsonParser;
+import tools.jackson.core.JsonToken;
+import tools.jackson.core.json.JsonReadFeature;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.MappingIterator;
+import tools.jackson.databind.json.JsonMapper;
+import tools.jackson.dataformat.yaml.YAMLFactory;
+import tools.jackson.dataformat.yaml.YAMLMapper;
+import tools.jackson.dataformat.yaml.YAMLReadFeature;
+import tools.jackson.dataformat.yaml.YAMLSchema;
+
+/**
+ * jackson-dataformat-yaml's reader against the YAML 1.2 processor it wraps (snakeyaml-engine) and
+ * against Jackson's own JSON reader: a randomised YAML writer produces documents whose value is
+ * known, and the three readers must agree on it.
+ *
+ * <p>The generators draw the recorded bugs' shapes (bugs.toml: a leading zero before an 8 or 9 under
+ * the core schema for jackson-yaml/4, aliases for /7), so the wide properties fail on them, and the
+ * narrow properties of section 4 - one per bug, over its shape region with random contents and the
+ * same oracle - fail on them too; all are the expected failures. {@code HEGEL_NO_KNOWN=1}
+ * ({@link Zoo#NO_KNOWN}) switches the shapes off, for a run that looks past the known bugs.
+ */
+class JacksonYamlTest {
+
+    static final Load ENGINE = new Load(LoadSettings.builder().build());
+    static final Load ENGINE_CORE = new Load(LoadSettings.builder().setSchema(new CoreSchema()).build());
+    static final YAMLMapper YAML = new YAMLMapper();
+    static final YAMLMapper YAML_CORE = YAMLMapper.builder(YAMLFactory.builder().yamlSchema(YAMLSchema.CORE).build()).build();
+    static final JsonMapper JSON = JsonMapper.builder().enable(JsonReadFeature.ALLOW_NON_NUMERIC_NUMBERS).build();
+
+    static YAMLMapper yaml(boolean core) {
+        return core ? YAML_CORE : YAML;
+    }
+
+    static Load engine(boolean core) {
+        return core ? ENGINE_CORE : ENGINE;
+    }
+
+    /** What a reader gave for a stream: the canonical form of every document, or an error. */
+    static final class Loaded {
+        final List<JsonNode> docs;
+        final String error;
+        final Throwable cause;
+
+        Loaded(List<JsonNode> docs, Throwable cause) {
+            this.docs = docs;
+            this.cause = cause;
+            this.error = cause == null ? null : cause.getClass().getSimpleName() + ": " + firstLine(cause.getMessage());
+        }
+
+        boolean ok() {
+            return error == null;
+        }
+
+        /** The exception is one Jackson documents (a JacksonException), not an escaped runtime failure. */
+        boolean jacksonError() {
+            return cause instanceof JacksonException;
+        }
+
+        @Override
+        public String toString() {
+            if (!ok()) {
+                return "error " + error;
+            }
+            StringBuilder sb = new StringBuilder();
+            for (JsonNode d : docs) {
+                sb.append(sb.length() == 0 ? "" : " | ").append(Canon.show(d));
+            }
+            return docs.size() + " doc(s): " + sb;
+        }
+    }
+
+    static String firstLine(String s) {
+        if (s == null) {
+            return "null";
+        }
+        int i = s.indexOf('\n');
+        String l = i < 0 ? s : s.substring(0, i);
+        return l.length() > 200 ? l.substring(0, 200) + "…" : l;
+    }
+
+    /** Every document of the stream through Jackson's tree model. */
+    static Loaded readAll(YAMLMapper mapper, String text) {
+        List<JsonNode> docs = new ArrayList<>();
+        try (JsonParser p = mapper.createParser(text)) {
+            MappingIterator<JsonNode> it = mapper.readValues(p, JsonNode.class);
+            while (it.hasNext()) {
+                docs.add(Canon.ofTree(it.next()));
+            }
+            return new Loaded(docs, null);
+        } catch (RuntimeException | StackOverflowError e) {
+            return new Loaded(null, e);
+        }
+    }
+
+    /** Every document of the stream through the engine's own constructor. */
+    static Loaded engineAll(Load load, String text) {
+        List<JsonNode> docs = new ArrayList<>();
+        try {
+            for (Object o : load.loadAllFromString(text)) {
+                docs.add(Canon.ofObject(o));
+            }
+            return new Loaded(docs, null);
+        } catch (RuntimeException | StackOverflowError e) {
+            return new Loaded(null, e);
+        }
+    }
+
+    /** The engine gives typed keys; Jackson's property names are always strings, so such documents are not compared. */
+    static boolean hasNonStringKeys(Load load, String text) {
+        try {
+            for (Object o : load.loadAllFromString(text)) {
+                if (nonStringKey(o)) {
+                    return true;
+                }
+            }
+        } catch (RuntimeException | StackOverflowError e) {
+            return false;
+        }
+        return false;
+    }
+
+    static boolean nonStringKey(Object o) {
+        if (o instanceof java.util.Map<?, ?> m) {
+            for (java.util.Map.Entry<?, ?> e : m.entrySet()) {
+                if (!(e.getKey() instanceof String) || nonStringKey(e.getValue())) {
+                    return true;
+                }
+            }
+        } else if (o instanceof Iterable<?> it) {
+            for (Object c : it) {
+                if (nonStringKey(c)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /** Scalars where the differential oracle itself is wrong or Jackson's behaviour is documented (README): not compared. */
+    static String toleratedScalar(String s, boolean core) {
+        if (core && s.matches("\\+\\.(inf|Inf|INF)")) {
+            return "snakeyaml-engine's core schema fails on +.inf";
+        }
+        if (core && s.matches("[-+]?0[0-7_]+")) {
+            return "PARSE_OCTAL_NUMBERS reads a leading zero as octal (017 = 15, a documented feature)";
+        }
+        return null;
+    }
+
+    /** The recorded bugs' scalar shapes (bugs.toml): compared by default, so the properties fail on them; skipped under HEGEL_NO_KNOWN. */
+    static String knownBugScalar(String s, boolean core) {
+        if (core && s.matches("[-+]?0[0-9]*[89][0-9]*")) {
+            return "a leading zero before a digit 8 or 9 under the core schema throws Invalid base-8 number (jackson-yaml/4)";
+        }
+        return null;
+    }
+
+    /** Scalars not compared: the tolerated ones, and under HEGEL_NO_KNOWN the recorded bugs' shapes. */
+    static String knownScalar(String s, boolean core) {
+        String tolerated = toleratedScalar(s, core);
+        return tolerated != null ? tolerated : Zoo.NO_KNOWN ? knownBugScalar(s, core) : null;
+    }
+
+    static String describe(String text) {
+        StringBuilder sb = new StringBuilder("\n    ");
+        String shown = text.length() > 1500 ? text.substring(0, 1500) + "…" : text;
+        for (int i = 0; i < shown.length(); i++) {
+            char c = shown.charAt(i);
+            if (c == '\n') {
+                sb.append("\n    ");
+            } else if (c == '\t') {
+                sb.append("\\t");
+            } else if (c == '\r') {
+                sb.append("\\r");
+            } else if (c < 0x20 || c == 0x7f || c == 0x85 || c == 0xa0 || c == 0x2028 || c == 0x2029 || c == 0xfeff || (c >= 0xd800 && c <= 0xdfff)) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.append('\n').toString();
+    }
+
+    // ---- the token stream ----------------------------------------------------------------------
+
+    /** A parser's tokens, each with what Jackson reports for it (names, texts, exact numbers, binary). */
+    static List<String> tokens(JsonParser p) {
+        List<String> out = new ArrayList<>();
+        for (JsonToken t = p.nextToken(); t != null; t = p.nextToken()) {
+            StringBuilder sb = new StringBuilder(t.name());
+            switch (t) {
+                case PROPERTY_NAME:
+                    sb.append(' ').append(Canon.show(Canon.string(p.currentName()))).append(" text=").append(Canon.show(Canon.string(p.getString())));
+                    break;
+                case VALUE_STRING:
+                    sb.append(' ').append(Canon.show(Canon.string(p.getString())));
+                    break;
+                case VALUE_NUMBER_INT:
+                    sb.append(' ').append(p.getNumberType()).append(' ').append(p.getBigIntegerValue()).append(" exact=").append(p.getNumberValueExact());
+                    break;
+                case VALUE_NUMBER_FLOAT: {
+                    double d = p.getDoubleValue();
+                    sb.append(' ').append(p.getNumberType()).append(' ').append(Double.isNaN(d) ? "nan" : Long.toHexString(Double.doubleToLongBits(d)));
+                    break;
+                }
+                case VALUE_EMBEDDED_OBJECT:
+                    sb.append(' ').append(Canon.show(Canon.binary(p.getBinaryValue())));
+                    break;
+                default:
+                    break;
+            }
+            out.add(sb.toString());
+        }
+        return out;
+    }
+
+    static String diffLists(List<String> a, List<String> b) {
+        StringBuilder sb = new StringBuilder();
+        int max = Math.max(a.size(), b.size());
+        int shown = 0;
+        for (int i = 0; i < max && shown < 5; i++) {
+            String x = i < a.size() ? a.get(i) : "<none>", y = i < b.size() ? b.get(i) : "<none>";
+            if (!x.equals(y)) {
+                sb.append("\n    #").append(i).append(": ").append(x).append("\n      -> ").append(y);
+                shown++;
+            }
+        }
+        return sb.toString();
+    }
+
+    static String show(List<JsonNode> docs) {
+        StringBuilder sb = new StringBuilder();
+        for (JsonNode d : docs) {
+            sb.append(sb.length() == 0 ? "" : " | ").append(Canon.show(d));
+        }
+        return sb.toString();
+    }
+
+    // ---- 1. written documents read as their trees ----------------------------------------------
+
+    /** The core schema (else the JSON schema), three times in ten. */
+    static final Generator<Boolean> CORE = chance(30);
+
+    /** The schema, the stream to write, and the input path whose tokens are compared with the String parser's. */
+    record WrittenCase(boolean core, YamlGen.Stream stream, String path) {}
+
+    static final Generator<WrittenCase> WRITTEN = tuples(CORE, YamlGen.STREAM, pick("byte[]", "Reader", "InputStream", "char[]"))
+        .map(t -> new WrittenCase(t.value1(), t.value2(), t.value3()));
+
+    static JsonParser parser(YAMLMapper mapper, String path, String text, byte[] bytes) {
+        return switch (path) {
+            case "byte[]" -> mapper.createParser(bytes);
+            case "Reader" -> mapper.createParser(new StringReader(text));
+            case "InputStream" -> mapper.createParser(new ByteArrayInputStream(bytes));
+            default -> mapper.createParser(text.toCharArray());
+        };
+    }
+
+    @Test
+    void writtenDocumentsReadAsTheirTrees() {
+        Zoo.run("writtenDocumentsReadAsTheirTrees", tc -> {
+            WrittenCase c = tc.draw(WRITTEN, "case");
+            boolean core = c.core();
+            List<YamlGen.Node> trees = c.stream().roots();
+            YamlGen.Written written = c.stream().write(core);
+            String text = written.text();
+            List<String> style = written.style();
+            List<JsonNode> expected = new ArrayList<>();
+            for (YamlGen.Node t : trees) {
+                expected.add(t.canon());
+            }
+            String tag = "style " + style + (core ? " core schema" : " json schema") + describe(text);
+            YAMLMapper mapper = yaml(core);
+            Loaded mine = readAll(mapper, text);
+            check(mine.ok() && mine.docs.equals(expected), () -> "Jackson reads " + mine + " instead of " + show(expected) + " for " + tag);
+            Loaded theirs = engineAll(engine(core), text);
+            check(theirs.ok() && theirs.docs.equals(expected), () -> "the engine reads " + theirs + " instead of " + show(expected) + " for " + tag);
+            // the same trees as JSON, through Jackson's JSON reader, give the same canonical form (guards Canon)
+            for (YamlGen.Node t : trees) {
+                JsonNode viaJson = Canon.ofTree(JSON.readTree(t.json()));
+                check(viaJson.equals(t.canon()), () -> "the JSON reader gives " + Canon.show(viaJson) + " for " + t.json());
+            }
+            // the YAML token stream equals the JSON token stream of the same documents (one document at a time)
+            if (trees.size() == 1) {
+                List<String> yamlTokens, jsonTokens;
+                try (JsonParser p = mapper.createParser(text)) {
+                    yamlTokens = tokens(p);
+                }
+                try (JsonParser p = JSON.createParser(trees.get(0).json())) {
+                    jsonTokens = tokens(p);
+                }
+                List<String> yamlCmp = new ArrayList<>(yamlTokens), jsonCmp = new ArrayList<>(jsonTokens);
+                if (core) {
+                    // 0x7fffffff is a LONG by digit count where the JSON reader says INT (README, observed)
+                    yamlCmp.replaceAll(t -> t.replaceFirst("^VALUE_NUMBER_INT (INT|LONG|BIG_INTEGER) ", "VALUE_NUMBER_INT "));
+                    jsonCmp.replaceAll(t -> t.replaceFirst("^VALUE_NUMBER_INT (INT|LONG|BIG_INTEGER) ", "VALUE_NUMBER_INT "));
+                }
+                check(yamlCmp.equals(jsonCmp), () -> "the YAML tokens differ from the JSON tokens:" + diffLists(jsonCmp, yamlCmp) + "\nfor " + tag);
+                // every input path gives the same tokens
+                byte[] bytes = text.getBytes(StandardCharsets.UTF_8);
+                List<String> again;
+                try (JsonParser p = parser(mapper, c.path(), text, bytes)) {
+                    again = tokens(p);
+                }
+                check(again.equals(yamlTokens), () -> "the " + c.path() + " parser gives other tokens:" + diffLists(yamlTokens, again) + "\nfor " + tag);
+            }
+            // readTree of a single document agrees with readValues
+            if (trees.size() == 1 && !style.contains("end-marker")) {
+                try {
+                    JsonNode one = Canon.ofTree(mapper.readTree(text));
+                    check(one.equals(expected.get(0)), () -> "readTree gives " + Canon.show(one) + " instead of " + Canon.show(expected.get(0)) + " for " + tag);
+                } catch (JacksonException e) {
+                    fail("readTree threw " + e.getClass().getSimpleName() + ": " + firstLine(e.getMessage()) + " for " + tag);
+                }
+            }
+        });
+    }
+
+    // ---- 2. mutated documents read like the engine ---------------------------------------------
+
+    static final String[] MUTATION_CHARS = {" ", " ", "\n", "\n", "\t", "-", ":", "?", ",", "[", "]", "{", "}", "#", "|", ">", "'", "\"", "%", "@", "`", "\\", "a", "0", ".", "~", "---", "...", "  ", ": ", "- ", "\r", "%YAML 1.2\n---\n", "\ufeff", "+", "e", "E", "0x", "0o", ".inf", ".nan"};
+
+    /** Node properties and the merge key: the readers differ on tags and merge keys by design and on aliases by jackson-yaml/7 ({@link #knownDifference}), so they are one mutation in twenty. */
+    static final String[] PROPERTY_CHARS = {"&", "*", "!", "&a ", "*a", "!!str ", "!!int ", "!!float ", "!!bool ", "!!null ", "!!binary ", "!!seq ", "!!map ", "!!set ", "!<tag:yaml.org,2002:str> ", "<<: "};
+
+    /** Where a node property or the merge key can start: the beginning, after white space or a flow or block indicator. */
+    static final String TOKEN_START = "(^|[\\s\\[{,?:-])";
+
+    /**
+     * Shapes where Jackson and the engine differ by design or by a defect of the engine (README): an indicator where a token
+     * starts, not inside a quoted scalar. Anchors and aliases are the shape of jackson-yaml/7 (the tree model reads an alias
+     * as the anchor's name): compared by default, so the property fails on them, and left out under HEGEL_NO_KNOWN.
+     */
+    static String knownDifference(String text) {
+        if (Zoo.NO_KNOWN && Pattern.compile(TOKEN_START + "[&*]").matcher(text).find()) {
+            return "an anchor or alias (the tree model reads an alias as the anchor's name, jackson-yaml/7)";
+        }
+        if (Pattern.compile(TOKEN_START + "!").matcher(text).find()) {
+            return "a tag (Jackson ignores unknown tags and falls back to strings where the engine fails)";
+        }
+        if (text.indexOf('\ufeff') > 0) {
+            return "a byte order mark inside the stream";
+        }
+        if (Pattern.compile(TOKEN_START + "<<").matcher(text).find()) {
+            return "a merge key";
+        }
+        if (Pattern.compile("(^|[\\s\\[{,])\\+\\.(inf|Inf|INF)\\s*($|[\\s,\\]}#])").matcher(text).find()) {
+            return "+.inf (snakeyaml-engine's core schema fails on it)";
+        }
+        if (text.contains("\\L") || text.contains("\\P")) {
+            return "the escapes \\L and \\P (snakeyaml-engine rejects them)";
+        }
+        return null;
+    }
+
+    /** An edit of the text; positions are taken modulo the live text (line indices modulo the live line count) when applied. */
+    sealed interface Edit permits Delete, Insert, Replace, Reindent, Swap {}
+
+    record Delete(int at) implements Edit {}
+
+    record Insert(int at, String what) implements Edit {}
+
+    record Replace(int at, String what) implements Edit {}
+
+    /** A line re-indented to the given number of spaces. */
+    record Reindent(int line, int spaces) implements Edit {}
+
+    /** A line swapped with the next. */
+    record Swap(int line) implements Edit {}
+
+    static final Generator<String> MUTATION = weighted(w(19, pick(MUTATION_CHARS)), w(1, pick(PROPERTY_CHARS)));
+
+    /** A deletion (2), an insertion (4), a replacement (2), a re-indentation (1), a line swap (1). */
+    static final Generator<Edit> EDIT = Gen.<Edit>weighted(
+        w(2, INDEX.<Edit>map(Delete::new)),
+        w(4, tuples(INDEX, MUTATION).<Edit>map(t -> new Insert(t.value1(), t.value2()))),
+        w(2, tuples(INDEX, MUTATION).<Edit>map(t -> new Replace(t.value1(), t.value2()))),
+        w(1, tuples(INDEX, ints(0, 6)).<Edit>map(t -> new Reindent(t.value1(), t.value2()))),
+        w(1, INDEX.<Edit>map(Swap::new)));
+
+    /** The schema, the stream to write, and one to three edits of its text. */
+    record MutatedCase(boolean core, YamlGen.Stream stream, List<Edit> edits) {}
+
+    static final Generator<MutatedCase> MUTATED = tuples(CORE, YamlGen.STREAM, many(EDIT, 1, 3)).map(t -> new MutatedCase(t.value1(), t.value2(), t.value3()));
+
+    /** A plain scalar with a leading zero and octal digits only: PARSE_OCTAL_NUMBERS reads it as octal under the core schema (017 = 15, documented). */
+    static final Pattern OCTAL_LIKE = Pattern.compile("(^|[\\s\\[{,])[-+]?0[0-7_]+\\s*($|[\\s,\\]}#])");
+
+    /** A plain scalar with a leading zero before a digit 8 or 9: jackson-yaml/4's shape under the core schema. */
+    static final Pattern LEADING_ZERO_89 = Pattern.compile("(^|[\\s\\[{,])[-+]?0[0-9]*[89][0-9]*\\s*($|[\\s,\\]}#])");
+
+    /** The text after the edits, each applied to the live text. */
+    static String mutate(String text, List<Edit> edits) {
+        StringBuilder sb = new StringBuilder(text);
+        for (Edit e : edits) {
+            if (sb.length() == 0) {
+                break;
+            }
+            switch (e) {
+                case Insert i -> sb.insert(Math.floorMod(i.at(), sb.length() + 1), i.what());
+                case Delete d -> sb.deleteCharAt(Math.floorMod(d.at(), sb.length()));
+                case Replace r -> {
+                    int at = Math.floorMod(r.at(), sb.length());
+                    sb.replace(at, at + 1, r.what());
+                }
+                case Reindent r -> {
+                    List<String> lines = new ArrayList<>(Arrays.asList(sb.toString().split("\n", -1)));
+                    int li = Math.floorMod(r.line(), lines.size());
+                    lines.set(li, " ".repeat(r.spaces()) + lines.get(li).replaceFirst("^ +", ""));
+                    sb = new StringBuilder(String.join("\n", lines));
+                }
+                case Swap s -> {
+                    List<String> lines = new ArrayList<>(Arrays.asList(sb.toString().split("\n", -1)));
+                    if (lines.size() >= 2) {
+                        int li = Math.floorMod(s.line(), lines.size() - 1);
+                        String a = lines.get(li);
+                        lines.set(li, lines.get(li + 1));
+                        lines.set(li + 1, a);
+                        sb = new StringBuilder(String.join("\n", lines));
+                    }
+                }
+            }
+        }
+        return sb.toString();
+    }
