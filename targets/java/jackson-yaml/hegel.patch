+
+    /** A sequence; sep and trailingComma are its flow spelling. */
+    record Seq(List<Item> items, int sep, boolean trailingComma) implements Node {}
+
+    /** A mapping (keys distinct by construction); sep and trailingComma are its flow spelling. */
+    record Mapping(List<Entry> entries, int sep, boolean trailingComma) implements Node {}
+
+    /** A block scalar's header: the indentation step, the indicator before the chomping, a header comment, an explicit indentation indicator. */
+    record BlockStyle(int step, boolean indFirst, boolean comment, boolean indicator) {}
+
+    /** A sequence item in block style: compact `- k: v`, the step of a nested block, a bare `-` for null, a comment, a blank line after. */
+    record Item(Node node, boolean compact, int step, boolean bareNull, String comment, boolean blankAfter) {}
+
+    /** A mapping entry: its key and the key's quoting, the value, and its block layout. */
+    record Entry(String key, int keyQuote, Node node, EntryStyle style) {}
+
+    /** A mapping entry in block style: a comment line before, an explicit `?` key, an empty value for null, a nested block (else flow) with its step (0 for a sequence), a comment, a blank line after. */
+    record EntryStyle(boolean commentBefore, boolean explicit, boolean emptyNull, boolean block, int step, boolean zeroStep, String comment, boolean blankAfter) {}
