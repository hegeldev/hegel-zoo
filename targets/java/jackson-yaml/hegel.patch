+        default boolean isColl() {
+            return this instanceof Seq || this instanceof Mapping;
+        }
+
+        default int size() {
+            return this instanceof Seq s ? s.items().size() : this instanceof Mapping m ? m.entries().size() : 0;
+        }
+    }
