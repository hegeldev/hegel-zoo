+    // ---- 2. mutated documents read like the engine ---------------------------------------------
+
+    static final String[] MUTATION_CHARS = {" ", " ", "\n", "\n", "\t", "-", ":", "?", ",", "[", "]", "{", "}", "#", "&", "*", "!", "|", ">", "'", "\"", "%", "@", "`", "\\", "a", "0", ".", "~", "---", "...", "  ", ": ", "- ", "&a ", "*a", "!!str ", "!!int ", "!!float ", "!!bool ", "!!null ", "!!binary ", "!!seq ", "!!map ", "!!set ", "!<tag:yaml.org,2002:str> ", "\r", "%YAML 1.2\n---\n", "\ufeff", "<<: ", "+", "e", "E", "0x", "0o", ".inf", ".nan"};
+
+    /** Shapes where Jackson and the engine are known to differ (see bugs.toml and the README). */
+    static String knownDifference(String text) {
+        if (text.indexOf('&') >= 0 || text.indexOf('*') >= 0) {
+            return "an anchor or alias (the tree model reads an alias as the anchor's name, jackson-yaml/…)";
+        }
+        if (Pattern.compile("(^|[\\s\\[{,?:-])!").matcher(text).find()) {
+            return "a tag (Jackson ignores unknown tags and falls back to strings where the engine fails)";
+        }
+        if (text.indexOf('\ufeff') > 0) {
+            return "a byte order mark inside the stream";
+        }
+        if (text.contains("<<")) {
+            return "a merge key";
+        }
+        if (Pattern.compile("(^|[\\s\\[{,])\\+\\.(inf|Inf|INF)\\s*($|[\\s,\\]}#])").matcher(text).find()) {
+            return "+.inf (snakeyaml-engine's core schema fails on it)";
+        }
+        if (text.contains("\\L") || text.contains("\\P")) {
+            return "the escapes \\L and \\P (snakeyaml-engine rejects them)";
+        }
+        return null;
+    }
+
+    static String mutate(TestCase tc, String text) {
+        int edits = n(tc, 1, 3);
+        StringBuilder sb = new StringBuilder(text);
+        for (int e = 0; e < edits && sb.length() > 0; e++) {
+            int r = n(tc, 1, 10);
+            int at = n(tc, 0, sb.length());
+            if (r <= 4) {
+                sb.insert(at, pick(tc, MUTATION_CHARS));
+            } else if (r <= 6) {
+                if (at < sb.length()) {
+                    sb.deleteCharAt(at);
+                }
+            } else if (r <= 8) {
+                if (at < sb.length()) {
+                    sb.replace(at, at + 1, pick(tc, MUTATION_CHARS));
+                }
+            } else if (r == 9) {
+                List<String> lines = new ArrayList<>(java.util.Arrays.asList(sb.toString().split("\n", -1)));
+                int li = n(tc, 0, lines.size() - 1);
+                String l = lines.get(li);
+                lines.set(li, " ".repeat(n(tc, 0, 6)) + l.replaceFirst("^ +", ""));
+                sb = new StringBuilder(String.join("\n", lines));
+            } else {
+                List<String> lines = new ArrayList<>(java.util.Arrays.asList(sb.toString().split("\n", -1)));
+                if (lines.size() >= 2) {
+                    int li = n(tc, 0, lines.size() - 2);
+                    String a = lines.get(li);
+                    lines.set(li, lines.get(li + 1));
+                    lines.set(li + 1, a);
+                    sb = new StringBuilder(String.join("\n", lines));
+                }
+            }
+        }
+        return sb.toString();
+    }
