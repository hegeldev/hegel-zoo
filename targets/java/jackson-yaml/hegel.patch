+    @Test
+    void mutatedDocumentsReadLikeTheEngine() {
+        Hegel.test(tc -> {
+            boolean core = chance(tc, 30);
+            YamlGen g = new YamlGen(tc, core);
+            List<String> style = new ArrayList<>();
+            String text = mutate(tc, g.writeStream(genTrees(g), style));
+            String tag = (core ? "core schema" : "json schema") + describe(text);
+            Loaded mine = readAll(yaml(core), text);
+            Loaded theirs = engineAll(engine(core), text);
+            String known = knownDifference(text);
+            if (known != null || (theirs.ok() && hasNonStringKeys(engine(core), text)) || (core && Pattern.compile("(^|[\\s\\[{,])[-+]?0[0-9_]+\\s*($|[\\s,\\]}#])").matcher(text).find())) {
+                // compared no further; the exception check below still applies
+            } else if (!theirs.ok() && theirs.error.contains("DuplicateKeyException")) {
+                // the engine rejects duplicate keys, Jackson keeps the last (JSON semantics; STRICT_DUPLICATE_DETECTION opts in)
+            } else if (mine.ok() && theirs.ok()) {
