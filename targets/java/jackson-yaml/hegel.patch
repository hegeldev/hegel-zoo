+    @Test
+    void generatorCallsAgreeWithTheTreeWriter() {
+        Zoo.run("generatorCallsAgreeWithTheTreeWriter", tc -> {
+            GeneratorCase c = tc.draw(GENERATOR_CASE, "case");
+            Options o = c.o();
+            JsonNode tree = c.tree();
+            JsonNode expected = o.expected(tree);
+            List<String> values = new ArrayList<>(), keys = new ArrayList<>();
+            strings(tree, values, keys);
+            count("cases");
+            String loss = o.knownLoss(tree, values, keys);
+            if (loss != null) {
+                count("skipped: " + loss);
+            }
+            tc.assume(loss == null);
+            String reference = null;
+            try {
+                reference = o.mapper.writeValueAsString(tree);
+            } catch (JacksonException ex) {
+                count("skipped: the tree writer threw (the other property's finding)");
+            }
+            tc.assume(reference != null);
+            String ref = reference;
+            Via via = new Via(c.coins());
+            List<String> paths = via.paths;
+            StringWriter sw = new StringWriter();
+            try (JsonGenerator gen = o.mapper.createGenerator(sw)) {
+                via.write(gen, tree);
+            } catch (JacksonException | UnsupportedOperationException ex) {
+                fail("the generator threw " + ex.getClass().getSimpleName() + ": " + firstLine(ex.getMessage()) + " via " + paths + " with " + o.style + " for " + Canon.show(expected));
+                return;
+            }
+            String text = sw.toString();
+            String tag = "via " + paths + " with " + o.style + ", value " + Canon.show(expected) + describe(text);
+            JacksonYamlTest.Loaded back = JacksonYamlTest.readAll(o.reader, text);
+            check(back.ok() && back.docs.size() == 1 && back.docs.get(0).equals(expected), () -> "the generator's text reads back as " + back + " for " + tag);
+            // writeNumber(String) and writePOJO may spell numbers differently; otherwise the text is the tree writer's
+            boolean spellingMayDiffer = paths.stream().anyMatch(p -> p.startsWith("writeNumber(String)") || p.startsWith("writePOJO") || p.equals("writeNumber(short)"));
+            if (!spellingMayDiffer) {
+                check(text.equals(ref), () -> "the generator's text differs from the tree writer's:" + describe(ref) + "vs" + tag);
+            }
+            // type ids and object ids around the tree survive (a type id before a scalar is dropped, jackson-yaml/9; an object id before a binary
+            // scalar lands on the next node, jackson-yaml/6: under HEGEL_NO_KNOWN the ids go around containers only)
+            Ids ids = c.ids();
+            if (ids != null && (tree.isContainer() || !Zoo.NO_KNOWN)) {
+                String typeId = ids.typeId();
+                String objectId = ids.objectId();
+                boolean withType = ids.withType();
+                boolean withObject = ids.withObject();
+                sw = new StringWriter();
+                try (JsonGenerator gen = o.mapper.createGenerator(sw)) {
+                    gen.writeStartArray();
+                    if (withType) {
+                        gen.writeTypeId(typeId);
+                    }
+                    if (withObject) {
+                        gen.writeObjectId(objectId);
+                    }
+                    gen.writeTree(tree);
+                    if (withObject) {
+                        gen.writeObjectRef(objectId);
+                    }
+                    gen.writeEndArray();
+                } catch (JacksonException ex) {
+                    fail("writing ids threw " + ex.getClass().getSimpleName() + ": " + firstLine(ex.getMessage()) + " with " + o.style + " for " + Canon.show(expected));
+                    return;
+                }
+                String idText = sw.toString();
+                String idTag = "ids type=" + (withType ? typeId : "-") + " object=" + (withObject ? objectId : "-") + " with " + o.style + describe(idText);
+                boolean nativeIds = o.on(YAMLWriteFeature.USE_NATIVE_TYPE_ID) && o.on(YAMLWriteFeature.USE_NATIVE_OBJECT_ID);
+                if (nativeIds) {
+                    List<JsonNode> want = new ArrayList<>();
+                    want.add(expected);
+                    if (withObject) {
+                        want.add(expected);
+                    }
+                    // the replaying parser gives the value twice
+                    // jackson-yaml/12: YAMLAnchorReplayingParser.nextEvent takes every scalar event whose value is "<<" for a merge
+                    // key, a quoted "<<" or a sequence item included, and throws "found field '<<' but value isn't a map" (reproduced standalone)
+                    if (Zoo.NO_KNOWN && (values.contains("<<") || keys.contains("<<"))) {
+                        count("replaying parser not checked: a string \"<<\" in the tree (jackson-yaml/12)");
+                    } else {
+                        JacksonYamlTest.Loaded rep = JacksonYamlTest.readAll(o.replaying(), idText);
+                        check(rep.ok() && rep.docs.size() == 1 && rep.docs.get(0).equals(Canon.seq(want)), () -> "the replaying parser reads " + rep + " instead of " + Canon.show(Canon.seq(want)) + " for " + idTag);
+                    }
+                    // the streaming parser reports the ids at the collection's start (an object id of a scalar is not reported: documented)
+                    try (JsonParser p = o.reader.createParser(idText)) {
+                        p.nextToken(); // START_ARRAY
+                        JsonToken start = p.nextToken();
+                        Object tid = p.getTypeId();
+                        Object oid = p.getObjectId();
+                        if (oid == null && start == JsonToken.START_OBJECT) {
+                            p.nextToken(); // the anchor of an object is reported at its first property name
+                            oid = p.getObjectId();
+                        }
+                        Object tidF = tid, oidF = oid;
+                        check(!withType || typeId.equals(tidF), () -> "the type id reads as " + tidF + " for " + idTag);
+                        check(!withObject || !tree.isContainer() || objectId.equals(oidF), () -> "the object id reads as " + oidF + " for " + idTag);
+                    } catch (JacksonException ex) {
+                        fail("reading ids threw " + ex.getClass().getSimpleName() + ": " + firstLine(ex.getMessage()) + " for " + idTag);
+                    }
+                    // the engine reads the alias as the same value
+                    JacksonYamlTest.Loaded eng = JacksonYamlTest.engineAll(JacksonYamlTest.engine(o.core), idText.replace("!" + typeId + " ", "").replace("!<" + typeId + "> ", ""));
+                    if (!withType) {
+                        check(eng.ok() && eng.docs.size() == 1 && eng.docs.get(0).equals(Canon.seq(want)), () -> "the engine reads the ids text as " + eng + " for " + idTag);
+                    }
+                }
+            }
+        });
+    }
