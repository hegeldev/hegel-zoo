+    @Test
+    void multiChannelReadsLikeOne() {
+        Zoo.property("commons-compress.utils.multiChannelReadsLikeOne", tc -> {
+            byte[] all = Data.bytes(tc, n(tc, 0, 300));
+            int pieces = n(tc, 1, 5);
+            List<SeekableByteChannel> parts = new ArrayList<>();
+            List<Integer> sizes = new ArrayList<>();
+            int at = 0;
+            for (int i = 0; i < pieces; i++) {
+                int len = i == pieces - 1 ? all.length - at : n(tc, 0, all.length - at);
+                parts.add(new SeekableInMemoryByteChannel(Arrays.copyOfRange(all, at, at + len)));
+                sizes.add(len);
+                at += len;
+            }
+            try (SeekableByteChannel ch = MultiReadOnlySeekableByteChannel.forSeekableByteChannels(parts.toArray(new SeekableByteChannel[0]))) {
+                long gotSize = ch.size();
+                check(gotSize == all.length, () -> "size() is " + gotSize + " for " + all.length + " with pieces " + sizes);
+                for (int step = 0; step < 15; step++) {
+                    int p = n(tc, 0, all.length + 5);
+                    int len = n(tc, 0, 120);
+                    ch.position(p);
+                    ByteBuffer b = ByteBuffer.allocate(len);
+                    int r = ch.read(b);
+                    int want = len == 0 ? 0 : p >= all.length ? -1 : Math.min(len, all.length - p);
+                    // a read may legitimately return fewer bytes; then keep reading
+                    int total = r < 0 ? -1 : r;
+                    while (total >= 0 && total < want) {
+                        int more = ch.read(b);
+                        if (more < 0) {
+                            break;
+                        }
+                        total += more;
+                    }
+                    final int got = total;
+                    // an empty buffer at the end may be answered with 0 or -1
+                    check(got == want || (len == 0 && got == -1), () -> "read(" + len + ") at " + p + " returned " + got + " for " + want + " with pieces " + sizes);
+                    if (got > 0) {
+                        byte[] bytes = Arrays.copyOf(b.array(), got);
+                        byte[] exp = Arrays.copyOfRange(all, p, p + got);
+                        check(Arrays.equals(bytes, exp), () -> "read at " + p + " gives the wrong bytes with pieces " + sizes);
+                    }
+                    long gotPos = ch.position();
+                    check(gotPos == p + Math.max(got, 0), () -> "position() is " + gotPos + " for " + (p + Math.max(got, 0)) + " with pieces " + sizes);
+                }
+            } catch (IOException ex) {
+                throw new java.io.UncheckedIOException(ex);
+            }
+        });
+    }
