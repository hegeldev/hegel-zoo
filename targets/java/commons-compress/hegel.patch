+    /** Walks a raw snappy stream and returns the tag types of every copy element. */
+    static List<Integer> snappyCopyTags(byte[] s) {
+        List<Integer> tags = new ArrayList<>();
+        int i = 0;
+        while ((s[i] & 0x80) != 0) {
+            i++;
+        }
+        i++;
+        while (i < s.length) {
+            int tag = s[i] & 0xff;
+            int type = tag & 3;
+            if (type == 0) {
+                int len = tag >>> 2;
+                int extra = len >= 60 ? len - 59 : 0;
+                if (extra > 0) {
+                    len = 0;
+                    for (int k = 0; k < extra; k++) {
+                        len |= (s[i + 1 + k] & 0xff) << (8 * k);
+                    }
+                }
+                i += 1 + extra + len + 1;
+            } else {
+                tags.add(type);
+                i += type == 1 ? 2 : type == 2 ? 3 : 5;
+            }
+        }
+        return tags;
+    }
