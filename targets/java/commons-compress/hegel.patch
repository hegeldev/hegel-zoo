+            check(read.size() == es.size(), () -> "ArArchiveInputStream read " + read.size() + " entries of " + es.size() + " in mode " + mode + ": " + es);
+            if (read.size() != es.size()) {
+                return;
+            }
+            for (int i = 0; i < es.size(); i++) {
+                ArArchiveEntry e = es.get(i);
+                ArArchiveEntry r = read.get(i);
+                byte[] d = readData.get(i);
+                check(r.getName().equals(e.getName()), () -> "ar: name " + show(r.getName()) + " for " + show(e.getName()) + " in mode " + mode);
+                check(r.getSize() == e.getSize(), () -> "ar: size " + r.getSize() + " for " + e.getName());
+                check(java.util.Arrays.equals(d, datas.get(i)), () -> "ar: data differs for " + e.getName());
+                check(r.getUserId() == e.getUserId() && r.getGroupId() == e.getGroupId(), () -> "ar: ids " + r.getUserId() + "/" + r.getGroupId() + " for " + e.getUserId() + "/" + e.getGroupId());
+                check(r.getMode() == e.getMode(), () -> "ar: mode " + Integer.toOctalString(r.getMode()) + " for " + Integer.toOctalString(e.getMode()));
+                check(r.getLastModified() == e.getLastModified(), () -> "ar: mtime " + r.getLastModified() + " for " + e.getLastModified());
+            }
+            // bug: names with spaces are written unterminated and binutils cuts them at the space (the pin carries it)
+            boolean spaces = es.stream().anyMatch(e -> e.getName().contains(" "));
+            if (Tools.available("ar") && !es.isEmpty() && !spaces) {
+                Path dir = Tools.tempDir("zoo-ar");
+                try {
+                    Path f = dir.resolve("a.a");
+                    Files.write(f, ar);
+                    Tools.Result list = Tools.run(null, dir, "ar", "t", f.toString());
+                    check(list.ok(), () -> "binutils ar rejects the archive of " + es + " in mode " + mode + ": " + list.err());
+                    if (list.ok()) {
+                        List<String> names = List.of(new String(list.out(), StandardCharsets.UTF_8).split("\n"));
+                        List<String> want = es.stream().map(ArArchiveEntry::getName).toList();
+                        check(names.equals(want), () -> "binutils ar lists " + names + " for " + want + " in mode " + mode);
+                    }
+                    ArArchiveEntry first = es.get(0);
+                    Tools.Result cat = Tools.run(null, dir, "ar", "p", f.toString(), first.getName());
+                    check(cat.ok() && java.util.Arrays.equals(cat.out(), datas.get(0)), () -> "binutils ar extracts " + cat.out().length + " bytes for " + show(first.getName()) + " in mode " + mode + ": " + cat.err());
+                } catch (IOException ex) {
+                    throw new java.io.UncheckedIOException(ex);
+                } finally {
+                    Tools.deleteTree(dir);
+                }
+            }
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/Data.java b/hegel/src/test/java/zoo/Data.java
new file mode 100644
index 0000000..5bf3b2b
--- /dev/null
+++ b/hegel/src/test/java/zoo/Data.java
@@ -0,0 +1,108 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.TestCase;
+import java.nio.charset.StandardCharsets;
+
+/** Payloads for the codecs: empty, tiny, boundary-sized, random, repetitive, text-like, mixed. */
+final class Data {
+    private Data() {}
+
+    static final int[] BOUNDARIES = {0, 1, 2, 3, 4, 5, 7, 8, 11, 12, 15, 16, 17, 31, 32, 33, 63, 64, 65, 127, 128, 255, 256, 257,
+        511, 512, 513, 1023, 1024, 1025, 4095, 4096, 4097, 8191, 8192, 8193, 10239, 10240, 10241, 32767, 32768, 32769, 65535, 65536, 65537,
+        65535 + 512, 131072, 262144};
+
+    static int size(TestCase tc, int max) {
+        int s = chance(tc, 50) ? pick(tc, box(BOUNDARIES)) : n(tc, 0, Math.min(max, 20000));
+        return Math.min(s, max);
+    }
+
+    static Integer[] box(int[] xs) {
+        Integer[] b = new Integer[xs.length];
+        for (int i = 0; i < xs.length; i++) {
+            b[i] = xs[i];
+        }
+        return b;
+    }
+
+    static byte[] bytes(TestCase tc, int size) {
+        byte[] b = new byte[size];
+        switch (n(tc, 0, 6)) {
+            case 0 -> { // random
+                for (int i = 0; i < size; i++) {
+                    b[i] = (byte) n(tc, 0, 255);
+                }
+            }
+            case 1 -> { // one value
+                byte v = (byte) n(tc, 0, 255);
+                java.util.Arrays.fill(b, v);
+            }
+            case 2 -> { // a short period
+                int period = n(tc, 1, 20);
+                byte[] p = new byte[period];
+                for (int i = 0; i < period; i++) {
+                    p[i] = (byte) n(tc, 0, 255);
+                }
+                for (int i = 0; i < size; i++) {
+                    b[i] = p[i % period];
+                }
+            }
+            case 3 -> { // text
+                String words = "the quick brown fox jumps over the lazy dog compress archive entry header block ";
+                StringBuilder sb = new StringBuilder();
+                while (sb.length() < size) {
+                    int w = n(tc, 0, 10);
+                    int start = 0;
+                    for (int i = 0; i < w; i++) {
+                        start = words.indexOf(' ', start) + 1;
+                    }
+                    int end = words.indexOf(' ', start);
+                    sb.append(words, start, end < 0 ? words.length() : end).append(chance(tc, 10) ? '\n' : ' ');
+                }
+                byte[] t = sb.toString().getBytes(StandardCharsets.US_ASCII);
+                System.arraycopy(t, 0, b, 0, size);
+            }
+            case 4 -> { // runs of random lengths (RLE-friendly, bzip2's run edge at 4+ and 255)
+                int i = 0;
+                while (i < size) {
+                    int run = pick(tc, 1, 2, 3, 4, 5, 251, 252, 253, 254, 255, 256, 257, 258, 259, 260, n(tc, 1, 3000));
+                    byte v = (byte) n(tc, 0, 255);
+                    for (int j = 0; j < run && i < size; j++, i++) {
+                        b[i] = v;
+                    }
+                }
+            }
+            case 5 -> { // mixed: random segments and copies of earlier segments (LZ matches with long offsets)
+                int i = 0;
+                while (i < size) {
+                    if (i > 0 && chance(tc, 60)) {
+                        int len = Math.min(size - i, n(tc, 1, 300));
+                        int off = n(tc, 1, Math.min(i, 70000));
+                        for (int j = 0; j < len; j++, i++) {
+                            b[i] = b[i - off];
+                        }
+                    } else {
+                        int len = Math.min(size - i, n(tc, 1, 40));
+                        for (int j = 0; j < len; j++, i++) {
+                            b[i] = (byte) n(tc, 0, 255);
+                        }
+                    }
+                }
+            }
+            default -> { // small alphabet
+                int k = n(tc, 1, 4);
+                for (int i = 0; i < size; i++) {
+                    b[i] = (byte) ('a' + n(tc, 0, k));
+                }
+            }
+        }
+        return b;
+    }
+
+    static byte[] bytes(TestCase tc) {
+        return bytes(tc, size(tc, 300000));
+    }
+}
diff --git a/hegel/src/test/java/zoo/Entries.java b/hegel/src/test/java/zoo/Entries.java
new file mode 100644
index 0000000..fcc6106
--- /dev/null
+++ b/hegel/src/test/java/zoo/Entries.java
@@ -0,0 +1,215 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.word;
+
+import dev.hegel.TestCase;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.attribute.FileTime;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/** A format-independent model of archive entries and a generator for them. */
+final class Entries {
+    private Entries() {}
+
+    enum Kind { FILE, DIR, SYMLINK, HARDLINK, CHR, BLK, FIFO }
+
+    /** An entry as the caller meant it; formats keep what they can. */
+    static final class Entry {
+        String name;
+        Kind kind = Kind.FILE;
+        byte[] data = new byte[0];
+        int mode = 0644;
+        long uid;
+        long gid;
+        String uname = "";
+        String gname = "";
+        FileTime mtime = FileTime.fromMillis(1_500_000_000_000L);
+        String linkName = "";
+        int devMajor;
+        int devMinor;
+
+        @Override
+        public String toString() {
+            return "Entry{" + Zoo.show(name) + " " + kind + " size=" + data.length + " mode=" + Integer.toOctalString(mode) + " uid=" + uid
+                + " gid=" + gid + " uname=" + Zoo.show(uname) + " gname=" + Zoo.show(gname) + " mtime=" + mtime + " link=" + Zoo.show(linkName)
+                + " dev=" + devMajor + "," + devMinor + "}";
+        }
+    }
+
+    static final String ASCII_NAME_CHARS = "abcxyzABCXYZ0123456789._-";
+    static final String ODD_NAME_CHARS = " !#$%&'()+,;=@[]^`{}~";
+    static final String UNICODE_NAME_CHARS = "éüßñ日本語中文Ωж";
+
+    /** A path component: ASCII words, sometimes odd punctuation or non-ASCII. */
+    static String component(TestCase tc, boolean allowUnicode, int lo, int hi) {
+        String alphabet = ASCII_NAME_CHARS;
+        if (chance(tc, 15)) {
+            alphabet += ODD_NAME_CHARS;
+        }
+        if (allowUnicode && chance(tc, 25)) {
+            alphabet += UNICODE_NAME_CHARS;
+        }
+        String c = word(tc, alphabet, lo, hi);
+        if (allowUnicode && chance(tc, 10)) {
+            c += "\uD83D\uDE00"; // one non-BMP character, as a proper pair
+        }
+        // avoid the names that mean something in a path
+        if (c.equals(".") || c.equals("..") || c.isEmpty()) {
+            return "x" + c;
+        }
+        return c;
+    }
+
+    /** A name; with probability the length is steered to a boundary (100, 155/100 split, 255, 256, 1000). */
+    static String name(TestCase tc, boolean allowUnicode, boolean allowDirSlash) {
+        if (chance(tc, 35)) {
+            int target = pick(tc, 99, 100, 101, 154, 155, 156, 200, 254, 255, 256, 257, 511, 512, 1000, 4096);
+            StringBuilder sb = new StringBuilder();
+            while (sb.length() < target) {
+                int room = target - sb.length();
+                int len = Math.min(room, n(tc, 1, 60));
+                sb.append(word(tc, ASCII_NAME_CHARS, len, len));
+                if (sb.length() < target && chance(tc, 40)) {
+                    sb.append('/');
+                }
+            }
+            String s = sb.toString();
+            if (s.endsWith("/") && !allowDirSlash) {
+                s = s.substring(0, s.length() - 1) + "x";
+            }
+            return s.substring(0, Math.min(s.length(), target));
+        }
+        int depth = n(tc, 1, 4);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < depth; i++) {
+            if (i > 0) {
+                sb.append('/');
+            }
+            sb.append(component(tc, allowUnicode, 1, 12));
+        }
+        if (allowDirSlash && chance(tc, 10)) {
+            sb.append('/');
+        }
+        return sb.toString();
+    }
+
+    static long id(TestCase tc) {
+        return switch (n(tc, 0, 9)) {
+            case 0 -> 0;
+            case 1 -> n(tc, 1, 65535);
+            case 2 -> 65535;
+            case 3 -> 65536;
+            case 4 -> 2097151; // 7 octal digits
+            case 5 -> 2097152;
+            case 6 -> 4294967295L;
+            case 7 -> 4294967296L;
+            default -> n(tc, 1000, 60000);
+        };
+    }
+
+    static FileTime mtime(TestCase tc) {
+        long seconds = switch (n(tc, 0, 9)) {
+            case 0 -> 0;
+            case 1 -> -1;
+            case 2 -> -86400L * 365;
+            case 3 -> 315532800L; // 1980-01-01, the DOS epoch
+            case 4 -> 315532799L;
+            case 5 -> 2147483647L;
+            case 6 -> 2147483648L;
+            case 7 -> 8589934591L; // 11 octal digits
+            case 8 -> 8589934592L;
+            default -> n(tc, 315532800, 2000000000);
+        };
+        int nanos = switch (n(tc, 0, 4)) {
+            case 0 -> 0;
+            case 1 -> n(tc, 1, 999) * 1_000_000; // milliseconds
+            case 2 -> n(tc, 1, 9_999_999) * 100; // 100 ns ticks
+            default -> n(tc, 1, 999_999_999);
+        };
+        if (seconds < 0) {
+            nanos = 0;
+        }
+        return FileTime.from(Instant.ofEpochSecond(seconds, nanos));
+    }
+
+    static int mode(TestCase tc) {
+        return switch (n(tc, 0, 5)) {
+            case 0 -> 0644;
+            case 1 -> 0755;
+            case 2 -> 0;
+            case 3 -> 07777;
+            case 4 -> n(tc, 0, 07777);
+            default -> 0600;
+        };
+    }
+
+    /** Draws an entry. {@code kinds} limits the kinds; {@code unicode} allows non-ASCII names. */
+    static Entry entry(TestCase tc, Set<String> usedNames, List<String> earlierFiles, boolean unicode, int maxData, Kind... kinds) {
+        Entry e = new Entry();
+        e.kind = pick(tc, kinds);
+        String name;
+        int tries = 0;
+        do {
+            name = name(tc, unicode, e.kind == Kind.DIR);
+            if (e.kind == Kind.DIR && !name.endsWith("/") && chance(tc, 50)) {
+                name = name + "/";
+            }
+            if (e.kind != Kind.DIR && name.endsWith("/")) {
+                name = name.substring(0, name.length() - 1) + "f";
+            }
+            tries++;
+        } while ((usedNames.contains(name) || usedNames.contains(name.endsWith("/") ? name.substring(0, name.length() - 1) : name + "/")) && tries < 20);
+        e.name = name;
+        usedNames.add(name);
+        if (e.kind == Kind.FILE) {
+            e.data = Data.bytes(tc, Data.size(tc, maxData));
+        }
+        e.mode = mode(tc);
+        e.uid = id(tc);
+        e.gid = id(tc);
+        if (chance(tc, 40)) {
+            e.uname = word(tc, chance(tc, 20) && unicode ? ASCII_NAME_CHARS + "éü" : ASCII_NAME_CHARS, 1, chance(tc, 20) ? 40 : 10);
+            e.gname = word(tc, ASCII_NAME_CHARS, 1, chance(tc, 20) ? 40 : 10);
+        }
+        e.mtime = mtime(tc);
+        if (e.kind == Kind.SYMLINK) {
+            e.linkName = chance(tc, 30) ? name(tc, unicode, false) : word(tc, ASCII_NAME_CHARS, 1, pick(tc, 10, 99, 100, 101, 300));
+        } else if (e.kind == Kind.HARDLINK) {
+            e.linkName = earlierFiles.isEmpty() ? "target" : pick(tc, earlierFiles.toArray(new String[0]));
+        } else if (e.kind == Kind.CHR || e.kind == Kind.BLK) {
+            e.devMajor = pick(tc, 0, 1, 8, 255, 256, 4095, 4096, 65535, 2097151);
+            e.devMinor = pick(tc, 0, 1, 5, 255, 256, 65535, 1048575);
+        }
+        return e;
+    }
+
+    static List<Entry> entries(TestCase tc, int max, boolean unicode, int maxData, Kind... kinds) {
+        int count = n(tc, 0, max);
+        Set<String> used = new HashSet<>();
+        List<String> files = new ArrayList<>();
+        List<Entry> es = new ArrayList<>();
+        for (int i = 0; i < count; i++) {
+            Entry e = entry(tc, used, files, unicode, maxData, kinds);
+            es.add(e);
+            if (e.kind == Kind.FILE) {
+                files.add(e.name);
+            }
+        }
+        return es;
+    }
+
+    static int utf8Length(String s) {
+        return s.getBytes(StandardCharsets.UTF_8).length;
+    }
+
+    static boolean isAscii(String s) {
+        return StandardCharsets.US_ASCII.newEncoder().canEncode(s);
+    }
+}
diff --git a/hegel/src/test/java/zoo/GzipHeaderTest.java b/hegel/src/test/java/zoo/GzipHeaderTest.java
new file mode 100644
index 0000000..d72ec8c
--- /dev/null
+++ b/hegel/src/test/java/zoo/GzipHeaderTest.java
@@ -0,0 +1,233 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.show;
+
+import dev.hegel.TestCase;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.zip.CRC32;
+import org.apache.commons.compress.compressors.gzip.ExtraField;
+import org.apache.commons.compress.compressors.gzip.GzipCompressorInputStream;
+import org.apache.commons.compress.compressors.gzip.GzipCompressorOutputStream;
+import org.apache.commons.compress.compressors.gzip.GzipParameters;
+import org.junit.jupiter.api.Test;
+
+/** Gzip members: the header follows RFC 1952 byte for byte, the metadata reads back, and the reference tools accept it. */
+class GzipHeaderTest {
+
+    static final String NAME_CHARS = "abcXYZ019._- ()[]{}!#$%&'+,;=@^`~éüßñ";
+
+    record Sub(String id, byte[] payload) {}
+
+    record Header(String fileName, String comment, long mtime, GzipParameters.OS os, List<Sub> subs, boolean headerCrc, int level) {}
+
+    static Header header(TestCase tc) {
+        String fileName = chance(tc, 60) ? Zoo.word(tc, NAME_CHARS, 1, 40) : null;
+        String comment = chance(tc, 40) ? Zoo.word(tc, NAME_CHARS + "\n", 1, 60) : null;
+        long mtime = pick(tc, 0L, 1L, 1500000000L, 2147483647L, 2147483648L, 4294967295L, (long) n(tc, 0, 2000000000));
+        GzipParameters.OS os = pick(tc, GzipParameters.OS.values());
+        List<Sub> subs = new ArrayList<>();
+        if (chance(tc, 40)) {
+            int count = n(tc, 0, 3);
+            java.util.Set<String> ids = new java.util.HashSet<>();
+            for (int i = 0; i < count; i++) {
+                String id = Zoo.word(tc, "ABXYZabxyz01", 2, 2);
+                if (ids.add(id)) {
+                    subs.add(new Sub(id, Data.bytes(tc, n(tc, 0, 200))));
+                }
+            }
+        }
+        return new Header(fileName, comment, mtime, os, subs, chance(tc, 40), n(tc, -1, 9));
+    }
+
+    static GzipParameters parameters(Header h) throws IOException {
+        GzipParameters p = new GzipParameters();
+        p.setFileName(h.fileName);
+        p.setComment(h.comment);
+        p.setModificationInstant(Instant.ofEpochSecond(h.mtime));
+        p.setOS(h.os);
+        p.setHeaderCRC(h.headerCrc);
+        p.setCompressionLevel(h.level);
+        if (!h.subs.isEmpty()) {
+            ExtraField x = new ExtraField();
+            for (Sub s : h.subs) {
+                x.addSubField(s.id, s.payload);
+            }
+            p.setExtraField(x);
+        }
+        return p;
+    }
+
+    static byte[] latin1(String s) {
+        return s.getBytes(StandardCharsets.ISO_8859_1);
+    }
+
+    /** The RFC 1952 header for the parameters. */
+    static byte[] modelHeader(Header h) {
+        ByteArrayOutputStream b = new ByteArrayOutputStream();
+        int flg = (h.headerCrc ? 2 : 0) | (h.subs.isEmpty() ? 0 : 4) | (h.fileName != null ? 8 : 0) | (h.comment != null ? 16 : 0);
+        b.write(0x1f);
+        b.write(0x8b);
+        b.write(8);
+        b.write(flg);
+        for (int i = 0; i < 4; i++) {
+            b.write((int) (h.mtime >>> (8 * i)) & 0xff);
+        }
+        b.write(h.level == 9 ? 2 : h.level == 1 ? 4 : 0);
+        b.write(osCode(h.os));
+        if (!h.subs.isEmpty()) {
+            int xlen = 0;
+            for (Sub s : h.subs) {
+                xlen += 4 + s.payload.length;
+            }
+            b.write(xlen & 0xff);
+            b.write(xlen >>> 8);
+            for (Sub s : h.subs) {
+                b.write(s.id.charAt(0));
+                b.write(s.id.charAt(1));
+                b.write(s.payload.length & 0xff);
+                b.write(s.payload.length >>> 8);
+                b.write(s.payload, 0, s.payload.length);
+            }
+        }
+        if (h.fileName != null) {
+            byte[] nm = latin1(h.fileName);
+            b.write(nm, 0, nm.length);
+            b.write(0);
+        }
+        if (h.comment != null) {
+            byte[] c = latin1(h.comment);
+            b.write(c, 0, c.length);
+            b.write(0);
+        }
+        if (h.headerCrc) {
+            CRC32 crc = new CRC32();
+            crc.update(b.toByteArray());
+            b.write((int) crc.getValue() & 0xff);
+            b.write((int) (crc.getValue() >>> 8) & 0xff);
+        }
+        return b.toByteArray();
+    }
+
+    @Test
+    void headerFollowsRfc1952() {
+        Zoo.property("commons-compress.gzip.headerFollowsRfc1952", tc -> {
+            Header h = header(tc);
+            byte[] data = Data.bytes(tc, Data.size(tc, 20000));
+            ByteArrayOutputStream bos = new ByteArrayOutputStream();
+            try (GzipCompressorOutputStream out = new GzipCompressorOutputStream(bos, parameters(h))) {
+                out.write(data);
+            } catch (IOException | RuntimeException ex) {
+                Zoo.rethrowStop(ex);
+                check(false, () -> "writing a member with " + h + " failed: " + ex);
+                return;
+            }
+            byte[] gz = bos.toByteArray();
+            byte[] want = modelHeader(h);
+            check(gz.length >= want.length + 8 && Arrays.equals(Arrays.copyOf(gz, want.length), want),
+                () -> "header bytes " + Tools.hex(Arrays.copyOf(gz, Math.min(gz.length, want.length)), 400) + " differ from the RFC 1952 model " + Tools.hex(want, 400) + " for " + h);
+            // the trailer: CRC32 and ISIZE
+            CRC32 crc = new CRC32();
+            crc.update(data);
+            long trailerCrc = le(gz, gz.length - 8, 4);
+            long isize = le(gz, gz.length - 4, 4);
+            check(trailerCrc == crc.getValue(), () -> "trailer CRC " + Long.toHexString(trailerCrc) + " for " + Long.toHexString(crc.getValue()));
+            check(isize == data.length, () -> "trailer ISIZE " + isize + " for " + data.length);
+            // reading it back gives the same metadata
+            try (GzipCompressorInputStream in = GzipCompressorInputStream.builder().setInputStream(new ByteArrayInputStream(gz)).setIgnoreExtraField(false).get()) {
+                byte[] back = in.readAllBytes();
+                check(Arrays.equals(back, data), () -> "the member decodes to " + back.length + " bytes for " + data.length + " with " + h);
+                GzipParameters m = in.getMetaData();
+                check(java.util.Objects.equals(m.getFileName(), h.fileName), () -> "file name read back as " + show(m.getFileName()) + " for " + h);
+                check(java.util.Objects.equals(m.getComment(), h.comment), () -> "comment read back as " + show(m.getComment()) + " for " + h);
+                check(m.getModificationInstant().getEpochSecond() == h.mtime, () -> "mtime read back as " + m.getModificationInstant().getEpochSecond() + " for " + h);
+                check(m.getOS() == h.os, () -> "OS read back as " + m.getOS() + " for " + h);
+                check(m.getHeaderCRC() == h.headerCrc, () -> "header CRC flag read back as " + m.getHeaderCRC() + " for " + h);
+                ExtraField x = m.getExtraField();
+                int count = x == null ? 0 : x.size();
+                check(count == h.subs.size(), () -> "extra field read back with " + count + " subfields for " + h);
+                if (x != null && count == h.subs.size()) {
+                    for (int i = 0; i < count; i++) {
+                        Sub s = h.subs.get(i);
+                        ExtraField.SubField sf = x.getSubField(i);
+                        check(sf.getId().equals(s.id) && Arrays.equals(sf.getPayload(), s.payload), () -> "subfield " + sf.getId() + " read back differently for " + h);
+                    }
+                }
+            } catch (IOException | RuntimeException ex) {
+                Zoo.rethrowStop(ex);
+                check(false, () -> "reading back the member with " + h + " failed: " + ex);
+            }
+            // the reference tools
+            if (Tools.available("gzip")) {
+                Tools.Result r = Tools.run(gz, "gzip", "-dc");
+                check(r.ok() && Arrays.equals(r.out(), data), () -> "gzip -dc gives " + r.out().length + " bytes (exit " + r.exit() + ") for " + h + ": " + r.err());
+                Tools.Result t = Tools.run(gz, "gzip", "-t");
+                check(t.ok(), () -> "gzip -t rejects the member with " + h + ": " + t.err());
+            }
+            Tools.Result py = Tools.python(gz, "import sys, gzip\nsys.stdout.buffer.write(gzip.decompress(sys.stdin.buffer.read()))");
+            check(py.ok() && Arrays.equals(py.out(), data), () -> "python gzip gives " + py.out().length + " bytes for " + h + ": " + py.err());
+        });
+    }
+
+    static int osCode(GzipParameters.OS os) {
+        try {
+            GzipParameters p = new GzipParameters();
+            p.setOS(os);
+            return p.getOperatingSystem();
+        } catch (RuntimeException ex) {
+            Zoo.rethrowStop(ex);
+            throw ex;
+        }
+    }
+
+    static long le(byte[] b, int off, int len) {
+        long v = 0;
+        for (int i = len - 1; i >= 0; i--) {
+            v = (v << 8) | (b[off + i] & 0xff);
+        }
+        return v;
+    }
+
+    /** Members written by GNU gzip and Python (names, mtimes, any OS byte) are read back with their metadata. */
+    @Test
+    void foreignHeadersRead() {
+        Zoo.property("commons-compress.gzip.foreignHeadersRead", tc -> {
+            byte[] data = Data.bytes(tc, Data.size(tc, 20000));
+            String name = chance(tc, 70) ? Zoo.word(tc, "abcXYZ019._-", 1, 30) : null;
+            long mtime = pick(tc, 0L, 1500000000L, 4294967295L, (long) n(tc, 1, 2000000000));
+            String code = "import sys, gzip, io\ndata = sys.stdin.buffer.read()\nbuf = io.BytesIO()\n"
+                + "with gzip.GzipFile(filename=" + (name == null ? "''" : Json.py(name)) + ", mode='wb', fileobj=buf, mtime=" + mtime + ", compresslevel=" + n(tc, 0, 9) + ") as f:\n    f.write(data)\n"
+                + "sys.stdout.buffer.write(buf.getvalue())";
+            Tools.Result py = Tools.python(data, code);
+            check(py.ok(), () -> "python could not write the member: " + py.err());
+            if (!py.ok()) {
+                return;
+            }
+            byte[] gz = py.out();
+            // the OS byte: RFC 1952 assigns 0-13 and 255; decoders must accept any value
+            int os = pick(tc, gz[9] & 0xff, 0, 3, 7, 11, 13, 255);
+            gz[9] = (byte) os;
+            try (GzipCompressorInputStream in = GzipCompressorInputStream.builder().setInputStream(new ByteArrayInputStream(gz)).get()) {
+                byte[] back = in.readAllBytes();
+                check(Arrays.equals(back, data), () -> "the python member decodes to " + back.length + " bytes for " + data.length);
+                GzipParameters m = in.getMetaData();
+                check(java.util.Objects.equals(m.getFileName(), name), () -> "file name read back as " + show(m.getFileName()) + " for " + show(name));
+                check(m.getModificationInstant().getEpochSecond() == mtime, () -> "mtime read back as " + m.getModificationInstant().getEpochSecond() + " for " + mtime);
+                check(m.getOperatingSystem() == os, () -> "OS read back as " + m.getOS() + " for code " + os);
+            } catch (IOException | RuntimeException ex) {
+                Zoo.rethrowStop(ex);
+                check(false, () -> "reading the python member (OS byte " + os + ", name " + show(name) + ", mtime " + mtime + ") failed: " + ex);
+            }
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/Json.java b/hegel/src/test/java/zoo/Json.java
new file mode 100644
index 0000000..02c265e
--- /dev/null
+++ b/hegel/src/test/java/zoo/Json.java
@@ -0,0 +1,178 @@
+package zoo;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** A small JSON reader for the oracles' replies, and string literals for JSON and Python. */
+final class Json {
+    private Json() {}
+
+    static Object parse(String s) {
+        Parser p = new Parser(s);
+        Object v = p.value();
+        p.ws();
+        if (p.i != s.length()) {
+            throw new IllegalArgumentException("trailing data at " + p.i + " in " + s);
+        }
+        return v;
+    }
+
+    private static final class Parser {
+        final String s;
+        int i;
+
+        Parser(String s) {
+            this.s = s;
+        }
+
+        void ws() {
+            while (i < s.length() && " \t\r\n".indexOf(s.charAt(i)) >= 0) {
+                i++;
+            }
+        }
+
+        Object value() {
+            ws();
+            char c = s.charAt(i);
+            switch (c) {
+                case '{': {
+                    i++;
+                    Map<String, Object> m = new LinkedHashMap<>();
+                    ws();
+                    if (s.charAt(i) == '}') {
+                        i++;
+                        return m;
+                    }
+                    while (true) {
+                        ws();
+                        String k = string();
+                        ws();
+                        expect(':');
+                        m.put(k, value());
+                        ws();
+                        if (s.charAt(i) == ',') {
+                            i++;
+                        } else {
+                            expect('}');
+                            return m;
+                        }
+                    }
+                }
+                case '[': {
+                    i++;
+                    List<Object> l = new ArrayList<>();
+                    ws();
+                    if (s.charAt(i) == ']') {
+                        i++;
+                        return l;
+                    }
+                    while (true) {
+                        l.add(value());
+                        ws();
+                        if (s.charAt(i) == ',') {
+                            i++;
+                        } else {
+                            expect(']');
+                            return l;
+                        }
+                    }
+                }
+                case '"':
+                    return string();
+                case 't':
+                    i += 4;
+                    return Boolean.TRUE;
+                case 'f':
+                    i += 5;
+                    return Boolean.FALSE;
+                case 'n':
+                    i += 4;
+                    return null;
+                default: {
+                    int start = i;
+                    while (i < s.length() && "+-0123456789.eE".indexOf(s.charAt(i)) >= 0) {
+                        i++;
+                    }
+                    String num = s.substring(start, i);
+                    if (num.contains(".") || num.contains("e") || num.contains("E")) {
+                        return Double.parseDouble(num);
+                    }
+                    return Long.parseLong(num);
+                }
+            }
+        }
+
+        void expect(char c) {
+            if (s.charAt(i) != c) {
+                throw new IllegalArgumentException("expected " + c + " at " + i + " in " + s);
+            }
+            i++;
+        }
+
+        String string() {
+            expect('"');
+            StringBuilder sb = new StringBuilder();
+            while (true) {
+                char c = s.charAt(i++);
+                if (c == '"') {
+                    return sb.toString();
+                }
+                if (c == '\\') {
+                    char e = s.charAt(i++);
+                    switch (e) {
+                        case 'n' -> sb.append('\n');
+                        case 't' -> sb.append('\t');
+                        case 'r' -> sb.append('\r');
+                        case 'b' -> sb.append('\b');
+                        case 'f' -> sb.append('\f');
+                        case 'u' -> {
+                            sb.append((char) Integer.parseInt(s.substring(i, i + 4), 16));
+                            i += 4;
+                        }
+                        default -> sb.append(e);
+                    }
+                } else {
+                    sb.append(c);
+                }
+            }
+        }
+    }
+
+    /** A JSON string literal. */
+    static String quote(String s) {
+        StringBuilder sb = new StringBuilder("\"");
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '"' || c == '\\') {
+                sb.append('\\').append(c);
+            } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c > 0x7e) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.append('"').toString();
+    }
+
+    /** A Python string literal (non-BMP characters as one code point, not a surrogate pair). */
+    static String py(String s) {
+        StringBuilder sb = new StringBuilder("\"");
+        int i = 0;
+        while (i < s.length()) {
+            int cp = s.codePointAt(i);
+            i += Character.charCount(cp);
+            if (cp == '"' || cp == '\\') {
+                sb.append('\\').append((char) cp);
+            } else if (cp < 0x20 || cp == 0x7f || (cp >= 0xd800 && cp <= 0xdfff) || (cp > 0x7e && cp <= 0xffff)) {
+                sb.append(String.format("\\u%04x", cp));
+            } else if (cp > 0xffff) {
+                sb.append(String.format("\\U%08x", cp));
+            } else {
+                sb.append((char) cp);
+            }
+        }
+        return sb.append('"').toString();
+    }
+}
diff --git a/hegel/src/test/java/zoo/TarTest.java b/hegel/src/test/java/zoo/TarTest.java
new file mode 100644
index 0000000..07db3f3
--- /dev/null
+++ b/hegel/src/test/java/zoo/TarTest.java
@@ -0,0 +1,506 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.show;
+
+import dev.hegel.TestCase;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.attribute.FileTime;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import org.apache.commons.compress.archivers.ArchiveException;
+import org.apache.commons.compress.archivers.tar.TarArchiveEntry;
+import org.apache.commons.compress.archivers.tar.TarArchiveInputStream;
+import org.apache.commons.compress.archivers.tar.TarArchiveOutputStream;
+import org.apache.commons.compress.archivers.tar.TarConstants;
+import org.apache.commons.compress.archivers.tar.TarFile;
+import org.apache.commons.compress.utils.SeekableInMemoryByteChannel;
+import org.junit.jupiter.api.Test;
+import zoo.Entries.Entry;
+import zoo.Entries.Kind;
+
+/**
+ * Tar: entries written by TarArchiveOutputStream under every long-name and big-number mode are read back by
+ * TarArchiveInputStream and TarFile as the modes promise, and Python's tarfile and GNU tar read the same archive
+ * the same way.
+ */
+class TarTest {
+
+    static final long MAXSIZE = TarConstants.MAXSIZE; // 8589934591 (11 octal digits)
+    static final long MAXID = TarConstants.MAXID; // 2097151 (7 octal digits)
+
+    record Options(int longFileMode, int bigNumberMode, boolean paxForNonAscii, boolean foreignWriter) {
+        Options(int longFileMode, int bigNumberMode, boolean paxForNonAscii) {
+            this(longFileMode, bigNumberMode, paxForNonAscii, false);
+        }
+
+        @Override
+        public String toString() {
+            return "longFileMode=" + new String[] {"ERROR", "TRUNCATE", "GNU", "POSIX"}[longFileMode] + " bigNumberMode="
+                + new String[] {"ERROR", "STAR", "POSIX"}[bigNumberMode] + " paxForNonAscii=" + paxForNonAscii;
+        }
+    }
+
+    static Options options(TestCase tc) {
+        return new Options(n(tc, 0, 3), n(tc, 0, 2), chance(tc, 40));
+    }
+
+    static TarArchiveEntry toTar(Entry e) throws IOException {
+        byte flag = switch (e.kind) {
+            case FILE -> TarConstants.LF_NORMAL;
+            case DIR -> TarConstants.LF_DIR;
+            case SYMLINK -> TarConstants.LF_SYMLINK;
+            case HARDLINK -> TarConstants.LF_LINK;
+            case CHR -> TarConstants.LF_CHR;
+            case BLK -> TarConstants.LF_BLK;
+            case FIFO -> TarConstants.LF_FIFO;
+        };
+        TarArchiveEntry t = new TarArchiveEntry(e.name, flag);
+        t.setSize(e.kind == Kind.FILE ? e.data.length : 0);
+        t.setMode(e.mode);
+        t.setUserId(e.uid);
+        t.setGroupId(e.gid);
+        t.setUserName(e.uname);
+        t.setGroupName(e.gname);
+        t.setLastModifiedTime(e.mtime);
+        if (e.kind == Kind.SYMLINK || e.kind == Kind.HARDLINK) {
+            t.setLinkName(e.linkName);
+        }
+        if (e.kind == Kind.CHR || e.kind == Kind.BLK) {
+            t.setDevMajor(e.devMajor);
+            t.setDevMinor(e.devMinor);
+        }
+        return t;
+    }
+
+    static byte[] write(List<Entry> es, Options o) throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        try (TarArchiveOutputStream t = new TarArchiveOutputStream(bos, "UTF-8")) {
+            t.setLongFileMode(o.longFileMode);
+            t.setBigNumberMode(o.bigNumberMode);
+            t.setAddPaxHeadersForNonAsciiNames(o.paxForNonAscii);
+            for (Entry e : es) {
+                t.putArchiveEntry(toTar(e));
+                if (e.kind == Kind.FILE) {
+                    t.write(e.data);
+                }
+                t.closeArchiveEntry();
+            }
+        }
+        return bos.toByteArray();
+    }
+
+    // ---- the expectation model -----------------------------------------------------------------------------------
+
+    /** Why the writer must refuse an entry under the options, or null. */
+    static String refusal(Entry e, Options o) {
+        int nameLen = Entries.utf8Length(e.name);
+        int linkLen = Entries.utf8Length(e.linkName);
+        if (o.longFileMode == TarArchiveOutputStream.LONGFILE_ERROR) {
+            // a name of exactly 100 bytes fits the ustar field (no terminator needed); the writer refuses it (bug 1)
+            if (nameLen > TarConstants.NAMELEN || linkLen > TarConstants.NAMELEN) {
+                return "long name";
+            }
+        }
+        if (o.bigNumberMode == TarArchiveOutputStream.BIGNUMBER_ERROR) {
+            long seconds = e.mtime.toInstant().getEpochSecond();
+            if (e.uid > MAXID || e.gid > MAXID || seconds < 0 || seconds > MAXSIZE || e.devMajor > MAXID || e.devMinor > MAXID) {
+                return "big number";
+            }
+        }
+        return null;
+    }
+
+    /** Whether the writer emits a pax extended header for the entry under the options. */
+    static boolean paxHeaderWritten(Entry e, Options o) {
+        long seconds = e.mtime.toInstant().getEpochSecond();
+        if (o.bigNumberMode == TarArchiveOutputStream.BIGNUMBER_POSIX
+            && (e.uid > MAXID || e.gid > MAXID || seconds < 0 || seconds > MAXSIZE || e.devMajor > MAXID || e.devMinor > MAXID || e.mtime.toInstant().getNano() != 0)) {
+            return true;
+        }
+        if (o.longFileMode == TarArchiveOutputStream.LONGFILE_POSIX
+            && (Entries.utf8Length(e.name) > TarConstants.NAMELEN || Entries.utf8Length(e.linkName) > TarConstants.NAMELEN)) {
+            return true;
+        }
+        return o.paxForNonAscii && (!Entries.isAscii(e.name) || !Entries.isAscii(e.linkName));
+    }
+
+    /** Whether the shape is one of the recorded bugs (the pins carry it). */
+    static boolean known(Entry e, Options o) {
+        int nameLen = Entries.utf8Length(e.name);
+        int linkLen = Entries.utf8Length(e.linkName);
+        if (o.longFileMode == TarArchiveOutputStream.LONGFILE_ERROR && (nameLen == TarConstants.NAMELEN || linkLen == TarConstants.NAMELEN)) {
+            return true; // 1: names of exactly 100 bytes are refused
+        }
+        if (o.bigNumberMode == TarArchiveOutputStream.BIGNUMBER_STAR && (e.uid > Integer.MAX_VALUE || e.gid > Integer.MAX_VALUE)) {
+            return true; // 2: base-256 ids are narrowed to int on read
+        }
+        if (o.longFileMode == TarArchiveOutputStream.LONGFILE_GNU && (nameLen > TarConstants.NAMELEN || linkLen > TarConstants.NAMELEN) && paxHeaderWritten(e, o)) {
+            return true; // 4: a GNU long name next to a pax header is lost on read
+        }
+        if (o.bigNumberMode == TarArchiveOutputStream.BIGNUMBER_POSIX && (Entries.utf8Length(e.uname) > 32 || Entries.utf8Length(e.gname) > 32)) {
+            return true; // 5: long owner names are truncated instead of going into pax uname/gname
+        }
+        return false;
+    }
+
+    /** Directory names come back with a trailing slash whatever was written; compare without it. */
+    static String dirless(String name) {
+        return name.endsWith("/") && name.length() > 1 ? name.substring(0, name.length() - 1) : name;
+    }
+
+    static String expectedName(Entry e, Options o) {
+        if (o.longFileMode == TarArchiveOutputStream.LONGFILE_TRUNCATE && Entries.utf8Length(e.name) > TarConstants.NAMELEN) {
+            return null; // a prefix; checked separately
+        }
+        return e.name;
+    }
+
+    static FileTime expectedMtime(Entry e, Options o) {
+        if (o.bigNumberMode == TarArchiveOutputStream.BIGNUMBER_POSIX) {
+            // the library's pax mtime carries up to 7 fractional digits (the writer rounds down to 100 ns); foreign
+            // writers put all nine digits in the record and the reader keeps them
+            long nanos = o.foreignWriter ? e.mtime.toInstant().getNano() : e.mtime.toInstant().getNano() / 100 * 100;
+            return FileTime.from(java.time.Instant.ofEpochSecond(e.mtime.toInstant().getEpochSecond(), nanos));
+        }
+        return FileTime.from(java.time.Instant.ofEpochSecond(e.mtime.toInstant().getEpochSecond()));
+    }
+
+    /** ustar keeps 32 bytes of the user and group names; the writer never adds pax uname/gname (recorded as bug 2). */
+    static String expectedOwnerName(String name) {
+        byte[] b = name.getBytes(StandardCharsets.UTF_8);
+        if (b.length <= 32) {
+            return name;
+        }
+        return new String(b, 0, 32, StandardCharsets.UTF_8);
+    }
+
+    // ---- the properties ------------------------------------------------------------------------------------------
+
+    @Test
+    void writtenEntriesReadBack() {
+        Zoo.property("commons-compress.tar.writtenEntriesReadBack", tc -> {
+            Options o = options(tc);
+            List<Entry> es = Entries.entries(tc, 6, true, 5000, Kind.FILE, Kind.FILE, Kind.DIR, Kind.SYMLINK, Kind.HARDLINK, Kind.CHR, Kind.BLK, Kind.FIFO);
+            boolean bigIds = false;
+            for (Entry e : es) {
+                if (known(e, o) || (Entries.utf8Length(e.uname) > 32 && !Entries.isAscii(e.uname))) {
+                    return;
+                }
+                bigIds |= e.uid > 4294967295L || e.gid > 4294967295L;
+            }
+            String refusal = null;
+            for (Entry e : es) {
+                refusal = refusal(e, o);
+                if (refusal != null) {
+                    break;
+                }
+            }
+            byte[] tar;
+            try {
+                tar = write(es, o);
+            } catch (ArchiveException | IllegalArgumentException ex) {
+                final String r = refusal;
+                check(r != null, () -> "the writer refused " + es + " under " + o + " although every entry fits: " + ex);
+                return;
+            }
+            final String r = refusal;
+            check(r == null, () -> "the writer accepted " + es + " under " + o + " although an entry does not fit (" + r + ")");
+            if (r != null) {
+                return;
+            }
+            List<TarArchiveEntry> streamed = readStream(tar);
+            List<TarArchiveEntry> filed = readFile(tar);
+            check(streamed.size() == es.size(), () -> "TarArchiveInputStream read " + streamed.size() + " entries of " + es.size() + " under " + o + ": " + es);
+            check(filed.size() == es.size(), () -> "TarFile read " + filed.size() + " entries of " + es.size() + " under " + o + ": " + es);
+            if (streamed.size() != es.size() || filed.size() != es.size()) {
+                return;
+            }
+            for (int i = 0; i < es.size(); i++) {
+                Entry e = es.get(i);
+                compare("TarArchiveInputStream", e, streamed.get(i), o);
+                compare("TarFile", e, filed.get(i), o);
+            }
+            // the same bytes through Python's tarfile
+            Tools.Result py = Tools.python(tar, PY_TARINFO);
+            check(py.ok(), () -> "python tarfile failed on " + es + " under " + o + ": " + py.err());
+            if (py.ok()) {
+                comparePython(es, o, new String(py.out(), StandardCharsets.UTF_8), tar);
+            }
+            // GNU tar lists it (GNU tar itself refuses ids beyond uid_t, so those archives are not shown to it)
+            if (bigIds) {
+                return;
+            }
+            Tools.Result gnu = Tools.run(tar, "tar", "-tf", "-");
+            check(gnu.ok(), () -> "GNU tar rejects the archive of " + es + " under " + o + ": " + gnu.err());
+            if (gnu.ok()) {
+                String[] lines = new String(gnu.out(), StandardCharsets.UTF_8).split("\n");
+                int count = gnu.out().length == 0 ? 0 : lines.length;
+                check(count == es.size(), () -> "GNU tar lists " + count + " entries of " + es.size() + " for " + es + " under " + o + ": " + show(new String(gnu.out(), StandardCharsets.UTF_8)));
+            }
+        });
+    }
+
+    static void compare(String reader, Entry e, TarArchiveEntry t, Options o) {
+        String expectedName = expectedName(e, o);
+        String got = e.kind == Kind.DIR ? dirless(t.getName()) : t.getName();
+        if (expectedName != null) {
+            String want = e.kind == Kind.DIR ? dirless(expectedName) : expectedName;
+            check(got.equals(want), () -> reader + ": name " + show(t.getName()) + " for " + e + " under " + o);
+        } else {
+            check(e.name.startsWith(got) && Entries.utf8Length(got) <= TarConstants.NAMELEN, () -> reader + ": truncated name " + show(t.getName()) + " for " + e + " under " + o);
+        }
+        long size = e.kind == Kind.FILE ? e.data.length : 0;
+        check(t.getSize() == size, () -> reader + ": size " + t.getSize() + " for " + e + " under " + o);
+        check((t.getMode() & 07777) == (e.mode & 07777), () -> reader + ": mode " + Integer.toOctalString(t.getMode()) + " for " + e + " under " + o);
+        check(t.getLongUserId() == e.uid, () -> reader + ": uid " + t.getLongUserId() + " for " + e + " under " + o);
+        check(t.getLongGroupId() == e.gid, () -> reader + ": gid " + t.getLongGroupId() + " for " + e + " under " + o);
+        FileTime mtime = expectedMtime(e, o);
+        check(t.getLastModifiedTime().equals(mtime), () -> reader + ": mtime " + t.getLastModifiedTime() + " (expected " + mtime + ") for " + e + " under " + o);
+        // a foreign pax writer puts long owner names into uname/gname records, which the reader keeps (bug 4 is the library's writer)
+        boolean fullOwnerNames = o.foreignWriter && o.bigNumberMode == TarArchiveOutputStream.BIGNUMBER_POSIX;
+        String wantUname = fullOwnerNames ? e.uname : expectedOwnerName(e.uname);
+        String wantGname = fullOwnerNames ? e.gname : expectedOwnerName(e.gname);
+        check(t.getUserName().equals(wantUname), () -> reader + ": uname " + show(t.getUserName()) + " for " + e + " under " + o);
+        check(t.getGroupName().equals(wantGname), () -> reader + ": gname " + show(t.getGroupName()) + " for " + e + " under " + o);
+        boolean kindOk = switch (e.kind) {
+            case FILE -> t.isFile() && !t.isSymbolicLink() && !t.isLink();
+            case DIR -> t.isDirectory();
+            case SYMLINK -> t.isSymbolicLink();
+            case HARDLINK -> t.isLink();
+            case CHR -> t.isCharacterDevice();
+            case BLK -> t.isBlockDevice();
+            case FIFO -> t.isFIFO();
+        };
+        check(kindOk, () -> reader + ": kind flag " + (int) t.getLinkFlag() + " for " + e + " under " + o);
+        if (e.kind == Kind.SYMLINK || e.kind == Kind.HARDLINK) {
+            if (o.longFileMode == TarArchiveOutputStream.LONGFILE_TRUNCATE && Entries.utf8Length(e.linkName) > TarConstants.NAMELEN) {
+                check(e.linkName.startsWith(t.getLinkName()), () -> reader + ": truncated link " + show(t.getLinkName()) + " for " + e + " under " + o);
+            } else {
+                check(t.getLinkName().equals(e.linkName), () -> reader + ": link " + show(t.getLinkName()) + " for " + e + " under " + o);
+            }
+        }
+        if (e.kind == Kind.CHR || e.kind == Kind.BLK) {
+            check(t.getDevMajor() == e.devMajor && t.getDevMinor() == e.devMinor, () -> reader + ": dev " + t.getDevMajor() + "," + t.getDevMinor() + " for " + e + " under " + o);
+        }
+    }
+
+    static final String PY_TARINFO = read("/zoo/tarinfo.py");
+
+    static String read(String resource) {
+        try (var in = TarTest.class.getResourceAsStream(resource)) {
+            return new String(in.readAllBytes(), StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    static void comparePython(List<Entry> es, Options o, String json, byte[] tar) {
+        List<Object> members = (List<Object>) Json.parse(json);
+        if (members.size() == 1 && members.get(0) instanceof Map<?, ?> m0 && m0.containsKey("error")) {
+            check(false, () -> "python tarfile cannot read the archive of " + es + " under " + o + ": " + m0.get("error"));
+            return;
+        }
+        check(members.size() == es.size(), () -> "python tarfile reads " + members.size() + " members of " + es.size() + " for " + es + " under " + o);
+        if (members.size() != es.size()) {
+            return;
+        }
+        for (int i = 0; i < es.size(); i++) {
+            Entry e = es.get(i);
+            Map<String, Object> m = (Map<String, Object>) members.get(i);
+            String expectedName = expectedName(e, o);
+            String name = (String) m.get("name");
+            // tarfile strips a trailing slash from directory names
+            String want = expectedName == null ? null : dirless(expectedName);
+            if (want != null) {
+                check(dirless(name).equals(want), () -> "python tarfile: name " + show(name) + " for " + e + " under " + o);
+            }
+            long size = e.kind == Kind.FILE ? e.data.length : 0;
+            check(((Number) m.get("size")).longValue() == size, () -> "python tarfile: size " + m.get("size") + " for " + e + " under " + o);
+            check((((Number) m.get("mode")).intValue() & 07777) == (e.mode & 07777), () -> "python tarfile: mode " + m.get("mode") + " for " + e + " under " + o);
+            check(((Number) m.get("uid")).longValue() == e.uid, () -> "python tarfile: uid " + m.get("uid") + " for " + e + " under " + o);
+            check(((Number) m.get("gid")).longValue() == e.gid, () -> "python tarfile: gid " + m.get("gid") + " for " + e + " under " + o);
+            double mtime = ((Number) m.get("mtime")).doubleValue();
+            FileTime want2 = expectedMtime(e, o);
+            double wantSeconds = want2.toInstant().getEpochSecond() + want2.toInstant().getNano() / 1e9;
+            check(Math.abs(mtime - wantSeconds) < 1e-6 * Math.max(1, Math.abs(wantSeconds)), () -> "python tarfile: mtime " + mtime + " (expected " + wantSeconds + ") for " + e + " under " + o);
+            String type = (String) m.get("type");
+            String wantType = switch (e.kind) {
+                case FILE -> "0";
+                case DIR -> "5";
+                case SYMLINK -> "2";
+                case HARDLINK -> "1";
+                case CHR -> "3";
+                case BLK -> "4";
+                case FIFO -> "6";
+            };
+            check(type.equals(wantType), () -> "python tarfile: type " + type + " for " + e + " under " + o);
+            if (e.kind == Kind.SYMLINK || e.kind == Kind.HARDLINK) {
+                if (!(o.longFileMode == TarArchiveOutputStream.LONGFILE_TRUNCATE && Entries.utf8Length(e.linkName) > TarConstants.NAMELEN)) {
+                    check(e.linkName.equals(m.get("linkname")), () -> "python tarfile: linkname " + show((String) m.get("linkname")) + " for " + e + " under " + o);
+                }
+            }
+            check(expectedOwnerName(e.uname).equals(m.get("uname")), () -> "python tarfile: uname " + show((String) m.get("uname")) + " for " + e + " under " + o);
+            check(expectedOwnerName(e.gname).equals(m.get("gname")), () -> "python tarfile: gname " + show((String) m.get("gname")) + " for " + e + " under " + o);
+            if (e.kind == Kind.CHR || e.kind == Kind.BLK) {
+                check(((Number) m.get("devmajor")).intValue() == e.devMajor && ((Number) m.get("devminor")).intValue() == e.devMinor, () -> "python tarfile: dev " + m.get("devmajor") + "," + m.get("devminor") + " for " + e + " under " + o);
+            }
+            if (e.kind == Kind.FILE) {
+                String sha = sha1(e.data);
+                check(sha.equals(m.get("sha1")), () -> "python tarfile: data differs for " + e + " under " + o);
+            }
+        }
+    }
+
+    static List<TarArchiveEntry> readStream(byte[] tar) throws IOException {
+        List<TarArchiveEntry> out = new ArrayList<>();
+        try (TarArchiveInputStream in = new TarArchiveInputStream(new ByteArrayInputStream(tar), "UTF-8")) {
+            TarArchiveEntry e;
+            while ((e = in.getNextEntry()) != null) {
+                final TarArchiveEntry t = e;
+                byte[] data = in.readAllBytes();
+                check(data.length == t.getSize(), () -> "TarArchiveInputStream: " + data.length + " bytes of data for size " + t.getSize() + " of " + t.getName());
+                out.add(t);
+            }
+        }
+        return out;
+    }
+
+    static List<TarArchiveEntry> readFile(byte[] tar) throws IOException {
+        List<TarArchiveEntry> out = new ArrayList<>();
+        try (TarFile f = new TarFile(new SeekableInMemoryByteChannel(tar), TarConstants.DEFAULT_BLKSIZE, TarConstants.DEFAULT_RCDSIZE, "UTF-8", false)) {
+            for (TarArchiveEntry e : f.getEntries()) {
+                byte[] data;
+                try (var in = f.getInputStream(e)) {
+                    data = in.readAllBytes();
+                }
+                check(data.length == e.getSize(), () -> "TarFile: " + data.length + " bytes of data for size " + e.getSize() + " of " + e.getName());
+                out.add(e);
+            }
+        }
+        return out;
+    }
+
+    static String sha1(byte[] data) {
+        try {
+            byte[] d = MessageDigest.getInstance("SHA-1").digest(data);
+            StringBuilder sb = new StringBuilder();
+            for (byte b : d) {
+                sb.append(String.format("%02x", b & 0xff));
+            }
+            return sb.toString();
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    /** Archives written by GNU tar and Python's tarfile in every format are read by both readers with the right entries. */
+    @Test
+    void foreignArchivesRead() {
+        Zoo.property("commons-compress.tar.foreignArchivesRead", tc -> {
+            List<Entry> es = Entries.entries(tc, 5, true, 3000, Kind.FILE, Kind.FILE, Kind.DIR, Kind.SYMLINK);
+            String format = pick(tc, "ustar", "gnu", "pax");
+            // ustar cannot hold long names, big ids or non-ASCII beyond its fields; keep to what the format allows
+            for (Entry e : es) {
+                if (format.equals("ustar") && (Entries.utf8Length(e.name) > 99 || Entries.utf8Length(e.linkName) > 99 || e.uid > MAXID || e.gid > MAXID
+                    || e.mtime.toInstant().getEpochSecond() < 0 || e.mtime.toInstant().getEpochSecond() > MAXSIZE)) {
+                    return;
+                }
+                if (format.equals("gnu") && (e.mtime.toInstant().getEpochSecond() < 0)) {
+                    return;
+                }
+                if (!format.equals("pax") && (Entries.utf8Length(e.uname) > 32 || Entries.utf8Length(e.gname) > 32)) {
+                    return; // ustar and gnu hold 32 bytes; tarfile cuts silently
+                }
+                if (e.uid > 4294967295L || e.gid > 4294967295L) {
+                    return;
+                }
+                if (format.equals("gnu") && (e.uid > Integer.MAX_VALUE || e.gid > Integer.MAX_VALUE)) {
+                    return; // bug 2: base-256 ids are narrowed to int on read
+                }
+            }
+            String script = pythonWriter(es, format);
+            Tools.Result py = Tools.python(null, script);
+            check(py.ok(), () -> "python tarfile could not write " + es + " as " + format + ": " + py.err());
+            if (!py.ok()) {
+                return;
+            }
+            byte[] tar = py.out();
+            List<TarArchiveEntry> streamed0;
+            List<TarArchiveEntry> filed0;
+            try {
+                streamed0 = readStream(tar);
+                filed0 = readFile(tar);
+            } catch (IOException | RuntimeException ex) {
+                Zoo.rethrowStop(ex);
+                check(false, () -> "reading the " + format + " archive of " + es + " written by python failed: " + ex);
+                return;
+            }
+            final List<TarArchiveEntry> streamed = streamed0;
+            final List<TarArchiveEntry> filed = filed0;
+            check(streamed.size() == es.size(), () -> "TarArchiveInputStream read " + streamed.size() + " of " + es.size() + " python-written " + format + " entries: " + es);
+            check(filed.size() == es.size(), () -> "TarFile read " + filed.size() + " of " + es.size() + " python-written " + format + " entries: " + es);
+            if (streamed.size() != es.size() || filed.size() != es.size()) {
+                return;
+            }
+            Options o = new Options(TarArchiveOutputStream.LONGFILE_POSIX, format.equals("pax") ? TarArchiveOutputStream.BIGNUMBER_POSIX : TarArchiveOutputStream.BIGNUMBER_STAR, true, true);
+            for (int i = 0; i < es.size(); i++) {
+                Entry e = es.get(i);
+                // python's gnu/ustar formats truncate the mtime to whole seconds; pax keeps the fraction
+                compare("TarArchiveInputStream (" + format + " by python)", e, streamed.get(i), o);
+                compare("TarFile (" + format + " by python)", e, filed.get(i), o);
+            }
+        });
+    }
+
+    static String pythonWriter(List<Entry> es, String format) {
+        StringBuilder sb = new StringBuilder();
+        sb.append("import io, sys, tarfile, base64\n");
+        sb.append("fmt = {'ustar': tarfile.USTAR_FORMAT, 'gnu': tarfile.GNU_FORMAT, 'pax': tarfile.PAX_FORMAT}['").append(format).append("']\n");
+        sb.append("buf = io.BytesIO()\n");
+        sb.append("tf = tarfile.open(fileobj=buf, mode='w:', format=fmt, encoding='utf-8')\n");
+        for (Entry e : es) {
+            sb.append("ti = tarfile.TarInfo(").append(Json.py(e.name)).append(")\n");
+            String type = switch (e.kind) {
+                case FILE -> "REGTYPE";
+                case DIR -> "DIRTYPE";
+                case SYMLINK -> "SYMTYPE";
+                case HARDLINK -> "LNKTYPE";
+                case CHR -> "CHRTYPE";
+                case BLK -> "BLKTYPE";
+                case FIFO -> "FIFOTYPE";
+            };
+            sb.append("ti.type = tarfile.").append(type).append("\n");
+            sb.append("ti.size = ").append(e.kind == Kind.FILE ? e.data.length : 0).append("\n");
+            sb.append("ti.mode = ").append(e.mode).append("\n");
+            sb.append("ti.uid = ").append(e.uid).append("\n");
+            sb.append("ti.gid = ").append(e.gid).append("\n");
+            sb.append("ti.uname = ").append(Json.py(e.uname)).append("\n");
+            sb.append("ti.gname = ").append(Json.py(e.gname)).append("\n");
+            java.time.Instant t = e.mtime.toInstant();
+            sb.append("ti.mtime = ").append(t.getEpochSecond()).append("\n");
+            if (format.equals("pax") && t.getNano() != 0) {
+                // an explicit pax record with nine digits, as GNU tar writes it (a float mtime would go through a double)
+                sb.append("ti.pax_headers = {'mtime': '").append(t.getEpochSecond()).append(".").append(String.format("%09d", t.getNano())).append("'}\n");
+            }
+            sb.append("ti.linkname = ").append(Json.py(e.linkName)).append("\n");
+            if (e.kind == Kind.FILE) {
+                sb.append("tf.addfile(ti, io.BytesIO(base64.b64decode('").append(java.util.Base64.getEncoder().encodeToString(e.data)).append("')))\n");
+            } else {
+                sb.append("tf.addfile(ti)\n");
+            }
+        }
+        sb.append("tf.close()\n");
+        sb.append("sys.stdout.buffer.write(buf.getvalue())\n");
+        return sb.toString();
+    }
+}
diff --git a/hegel/src/test/java/zoo/Tools.java b/hegel/src/test/java/zoo/Tools.java
new file mode 100644
index 0000000..0b91eee
--- /dev/null
+++ b/hegel/src/test/java/zoo/Tools.java
@@ -0,0 +1,128 @@
+package zoo;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+/** The system tools as oracles: run a command with bytes on stdin, get stdout, stderr and the exit code back. */
+final class Tools {
+    private Tools() {}
+
+    record Result(int exit, byte[] out, String err) {
+        boolean ok() {
+            return exit == 0;
+        }
+    }
+
+    static Result run(byte[] stdin, Path dir, String... cmd) {
+        try {
+            ProcessBuilder pb = new ProcessBuilder(cmd);
+            if (dir != null) {
+                pb.directory(dir.toFile());
+            }
+            pb.environment().put("LC_ALL", "C.UTF-8");
+            pb.environment().put("TZ", "UTC");
+            Process p = pb.start();
+            Thread writer = new Thread(() -> {
+                try (OutputStream os = p.getOutputStream()) {
+                    if (stdin != null) {
+                        os.write(stdin);
+                    }
+                } catch (IOException e) {
+                    // the tool closed its input early; its exit code tells
+                }
+            });
+            writer.start();
+            ByteArrayOutputStream err = new ByteArrayOutputStream();
+            Thread errReader = new Thread(() -> {
+                try (InputStream es = p.getErrorStream()) {
+                    es.transferTo(err);
+                } catch (IOException e) {
+                    // ignore
+                }
+            });
+            errReader.start();
+            byte[] out;
+            try (InputStream is = p.getInputStream()) {
+                out = is.readAllBytes();
+            }
+            if (!p.waitFor(120, TimeUnit.SECONDS)) {
+                p.destroyForcibly();
+                throw new IllegalStateException("timeout: " + String.join(" ", cmd));
+            }
+            writer.join();
+            errReader.join();
+            return new Result(p.exitValue(), out, err.toString(StandardCharsets.UTF_8));
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException(e);
+        }
+    }
+
+    static Result run(byte[] stdin, String... cmd) {
+        return run(stdin, null, cmd);
+    }
+
+    /** Runs a Python 3 snippet; the snippet reads stdin bytes as `sys.stdin.buffer` and writes to `sys.stdout.buffer`. */
+    static Result python(byte[] stdin, String code) {
+        return run(stdin, "python3", "-c", code);
+    }
+
+    static Path tempDir(String prefix) {
+        try {
+            return Files.createTempDirectory(prefix);
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    static void deleteTree(Path p) {
+        if (p == null || !Files.exists(p)) {
+            return;
+        }
+        try (var walk = Files.walk(p)) {
+            List<Path> all = new ArrayList<>();
+            walk.forEach(all::add);
+            all.sort((a, b) -> b.getNameCount() - a.getNameCount());
+            for (Path q : all) {
+                Files.deleteIfExists(q);
+            }
+        } catch (IOException e) {
+            // best effort
+        }
+    }
+
+    static boolean available(String tool) {
+        try {
+            return new ProcessBuilder("sh", "-c", "command -v " + tool).start().waitFor() == 0;
+        } catch (IOException | InterruptedException e) {
+            return false;
+        }
+    }
+
+    static String hex(byte[] b, int max) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < Math.min(b.length, max); i++) {
+            sb.append(String.format("%02x", b[i] & 0xff));
+        }
+        if (b.length > max) {
+            sb.append("…(").append(b.length).append(" bytes)");
+        }
+        return sb.toString();
+    }
+
+    static byte[] slice(byte[] b, int from, int to) {
+        return Arrays.copyOfRange(b, from, to);
+    }
+}
