+"""Reads a tar archive from stdin with Python's tarfile and prints one JSON object per member on stdout.
+
+Used as an oracle for what another implementation reads out of the bytes commons-compress wrote. Names and
+link names are given as UTF-8 text with surrogateescape (tarfile's default), pax headers as they were parsed.
+"""
+import hashlib
+import io
+import json
+import sys
+import tarfile
+
+data = sys.stdin.buffer.read()
+out = []
+try:
+    with tarfile.open(fileobj=io.BytesIO(data), mode="r:", format=tarfile.PAX_FORMAT, encoding="utf-8", errors="surrogateescape") as tf:
+        for m in tf:
+            rec = {
+                "name": m.name,
+                "size": m.size,
+                "mode": m.mode,
+                "uid": m.uid,
+                "gid": m.gid,
+                "mtime": m.mtime,
+                "type": m.type.decode("ascii"),
+                "linkname": m.linkname,
+                "uname": m.uname,
+                "gname": m.gname,
+                "devmajor": m.devmajor,
+                "devminor": m.devminor,
+                "pax": {k: v for k, v in m.pax_headers.items()},
+                "sparse": m.sparse is not None,
+            }
+            if m.isfile():
+                f = tf.extractfile(m)
+                content = f.read() if f is not None else b""
+                rec["sha1"] = hashlib.sha1(content).hexdigest()
+                rec["read"] = len(content)
+            out.append(rec)
+except Exception as e:  # noqa: BLE001
+    out.append({"error": type(e).__name__ + ": " + str(e)})
+sys.stdout.write(json.dumps(out, ensure_ascii=True))
