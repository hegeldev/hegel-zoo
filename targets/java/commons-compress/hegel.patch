+import org.apache.commons.compress.archivers.cpio.CpioArchiveOutputStream;
+import org.apache.commons.compress.archivers.cpio.CpioConstants;
+import org.apache.commons.compress.archivers.sevenz.SevenZArchiveEntry;
+import org.apache.commons.compress.archivers.sevenz.SevenZFile;
+import org.apache.commons.compress.archivers.sevenz.SevenZOutputFile;
+import org.apache.commons.compress.archivers.tar.TarArchiveEntry;
+import org.apache.commons.compress.archivers.tar.TarArchiveInputStream;
+import org.apache.commons.compress.archivers.tar.TarArchiveOutputStream;
+import org.apache.commons.compress.archivers.tar.TarConstants;
+import org.apache.commons.compress.archivers.zip.ZipArchiveEntry;
+import org.apache.commons.compress.archivers.zip.ZipArchiveInputStream;
+import org.apache.commons.compress.archivers.zip.ZipArchiveOutputStream;
+import org.apache.commons.compress.archivers.zip.ZipFile;
+import org.apache.commons.compress.compressors.CompressorStreamFactory;
+import org.apache.commons.compress.compressors.gzip.GzipCompressorInputStream;
+import org.apache.commons.compress.compressors.gzip.GzipCompressorOutputStream;
+import org.apache.commons.compress.compressors.gzip.GzipParameters;
+import org.apache.commons.compress.compressors.lz4.BlockLZ4CompressorOutputStream;
+import org.apache.commons.compress.compressors.lz4.FramedLZ4CompressorInputStream;
+import org.apache.commons.compress.compressors.lz4.FramedLZ4CompressorOutputStream;
+import org.apache.commons.compress.compressors.snappy.SnappyCompressorInputStream;
+import org.apache.commons.compress.compressors.snappy.SnappyCompressorOutputStream;
+import org.apache.commons.compress.compressors.xz.XZCompressorOutputStream;
+import org.apache.commons.compress.compressors.z.ZCompressorInputStream;
+import org.apache.commons.compress.compressors.zstandard.ZstdCompressorOutputStream;
+import org.apache.commons.compress.utils.ByteUtils;
+import org.apache.commons.compress.utils.FixedLengthBlockOutputStream;
+import org.apache.commons.compress.utils.IOUtils;
+import org.apache.commons.compress.utils.SeekableInMemoryByteChannel;
+import org.junit.jupiter.api.Test;
+
+/** One pin per recorded bug; each asserts the correct behaviour and fails while the bug exists. */
+class CommonsCompressPinsTest {
+
+    // ---- tar -----------------------------------------------------------------------------------------------------
+
+    static byte[] tar(TarArchiveEntry e, byte[] data, int longMode, int bigMode) throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        try (TarArchiveOutputStream t = new TarArchiveOutputStream(bos, "UTF-8")) {
+            t.setLongFileMode(longMode);
+            t.setBigNumberMode(bigMode);
+            if (data != null) {
+                e.setSize(data.length);
+            }
+            t.putArchiveEntry(e);
+            if (data != null) {
+                t.write(data);
+            }
+            t.closeArchiveEntry();
+        }
+        return bos.toByteArray();
+    }
+
+    static TarArchiveEntry firstTar(byte[] tar) throws IOException {
+        try (TarArchiveInputStream in = new TarArchiveInputStream(new ByteArrayInputStream(tar), "UTF-8")) {
+            return in.getNextEntry();
+        }
+    }
+
+    @Test
+    void tarNamesOfExactly100BytesAreAccepted() throws IOException {
+        // ustar's name field is 100 bytes with no terminator required
+        TarArchiveEntry e = new TarArchiveEntry("n".repeat(100));
+        byte[] tar = tar(e, new byte[1], TarArchiveOutputStream.LONGFILE_ERROR, TarArchiveOutputStream.BIGNUMBER_ERROR);
+        check(firstTar(tar).getName().equals("n".repeat(100)), "a 100-byte name did not round-trip");
+    }
+
+    @Test
+    void tarBase256IdsAreNotNarrowedOnRead() throws IOException {
+        TarArchiveEntry e = new TarArchiveEntry("u");
+        e.setUserId(4294967295L);
+        e.setGroupId(2147483648L);
+        TarArchiveEntry r = firstTar(tar(e, new byte[1], TarArchiveOutputStream.LONGFILE_GNU, TarArchiveOutputStream.BIGNUMBER_STAR));
+        check(r.getLongUserId() == 4294967295L, "uid 4294967295 written in base-256 reads back as " + r.getLongUserId());
+        check(r.getLongGroupId() == 2147483648L, "gid 2147483648 written in base-256 reads back as " + r.getLongGroupId());
+    }
+
+    @Test
+    void tarGnuLongNameSurvivesNextToPaxHeader() throws IOException {
+        TarArchiveEntry e = new TarArchiveEntry("n".repeat(150));
+        e.setLastModifiedTime(FileTime.from(Instant.ofEpochSecond(1500000000L, 500000000)));
+        TarArchiveEntry r = firstTar(tar(e, new byte[1], TarArchiveOutputStream.LONGFILE_GNU, TarArchiveOutputStream.BIGNUMBER_POSIX));
+        check(r.getName().length() == 150, "a 150-character GNU long name next to a pax mtime header reads back with " + r.getName().length() + " characters");
+    }
+
+    @Test
+    void tarLongOwnerNamesGoIntoPaxHeaders() throws IOException {
+        TarArchiveEntry e = new TarArchiveEntry("o");
+        e.setUserName("u".repeat(40));
+        TarArchiveEntry r = firstTar(tar(e, new byte[1], TarArchiveOutputStream.LONGFILE_POSIX, TarArchiveOutputStream.BIGNUMBER_POSIX));
+        check(r.getUserName().equals("u".repeat(40)), "a 40-character user name in POSIX mode reads back as " + r.getUserName().length() + " characters");
+    }
+
+    @Test
+    void tarDirectoryWithSizeIsRefusedOrReadable() throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        boolean refused;
+        try (TarArchiveOutputStream t = new TarArchiveOutputStream(bos)) {
+            TarArchiveEntry d = new TarArchiveEntry("d/");
+            d.setSize(5);
+            t.putArchiveEntry(d);
+            try {
+                t.closeArchiveEntry();
+                refused = false;
+            } catch (IOException ex) {
+                refused = true;
+            }
+            if (!refused) {
+                TarArchiveEntry f = new TarArchiveEntry("f");
+                f.setSize(1);
+                t.putArchiveEntry(f);
+                t.write(7);
+                t.closeArchiveEntry();
+            }
+        }
+        if (refused) {
+            return;
+        }
+        List<String> names = new ArrayList<>();
+        try (TarArchiveInputStream in = new TarArchiveInputStream(new ByteArrayInputStream(bos.toByteArray()))) {
+            TarArchiveEntry e;
+            while ((e = in.getNextEntry()) != null) {
+                names.add(e.getName());
+                in.readAllBytes();
+            }
+        } catch (IOException ex) {
+            check(false, "the archive with a sized directory entry is unreadable: " + ex);
+        }
+        check(names.equals(List.of("d/", "f")), "the archive with a sized directory entry reads as " + names);
+    }
+
+    @Test
+    void tarPaxKeysWithEqualsSignAreRefused() throws IOException {
+        TarArchiveEntry e = new TarArchiveEntry("x");
+        boolean refused = throwsA(IllegalArgumentException.class, () -> e.addPaxHeader("a=b", "c"));
+        if (refused) {
+            return;
+        }
+        TarArchiveEntry r = firstTar(tar(e, new byte[0], TarArchiveOutputStream.LONGFILE_POSIX, TarArchiveOutputStream.BIGNUMBER_POSIX));
+        check("c".equals(r.getExtraPaxHeader("a=b")), "the pax header a=b=c reads back as " + r.getExtraPaxHeaders());
+    }
+
+    // ---- cpio ----------------------------------------------------------------------------------------------------
+
+    @Test
+    void cpioCrcChecksumUsesTheWrittenSlice() throws IOException {
+        byte[] buf = {9, 9, 9, 1, 2, 3};
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        try (CpioArchiveOutputStream c = new CpioArchiveOutputStream(bos, CpioConstants.FORMAT_NEW_CRC)) {
+            CpioArchiveEntry e = new CpioArchiveEntry(CpioConstants.FORMAT_NEW_CRC, "a");
+            e.setSize(3);
+            e.setChksum(6);
+            c.putArchiveEntry(e);
+            c.write(buf, 3, 3);
+            c.closeArchiveEntry();
+        }
+        try (CpioArchiveInputStream in = new CpioArchiveInputStream(new ByteArrayInputStream(bos.toByteArray()))) {
+            in.getNextEntry();
+            check(Arrays.equals(in.readAllBytes(), new byte[] {1, 2, 3}), "the CRC-format entry written with an offset reads back wrongly");
+        }
+    }
+
+    @Test
+    void cpioOverflowingValuesAreRefused() throws IOException {
+        for (short f : new short[] {CpioConstants.FORMAT_NEW, CpioConstants.FORMAT_OLD_BINARY}) {
+            ByteArrayOutputStream bos = new ByteArrayOutputStream();
+            boolean refused = false;
+            try (CpioArchiveOutputStream c = new CpioArchiveOutputStream(bos, f)) {
+                CpioArchiveEntry e = new CpioArchiveEntry(f, "a");
+                e.setSize(0);
+                if (f == CpioConstants.FORMAT_NEW) {
+                    e.setTime(8589934592L); // 2^33 does not fit 8 hex digits
+                } else {
+                    e.setUID(65536); // does not fit 16 bits
+                }
+                try {
+                    c.putArchiveEntry(e);
+                    c.closeArchiveEntry();
+                } catch (IOException | IllegalArgumentException ex) {
+                    refused = true;
+                }
+            }
+            if (refused) {
+                continue;
+            }
+            try (CpioArchiveInputStream in = new CpioArchiveInputStream(new ByteArrayInputStream(bos.toByteArray()))) {
+                CpioArchiveEntry r = in.getNextEntry();
+                if (f == CpioConstants.FORMAT_NEW) {
+                    check(r.getTime() == 8589934592L, "mtime 2^33 in the new format was written as " + r.getTime() + " instead of being refused");
+                } else {
+                    check(r.getUID() == 65536, "uid 65536 in the old binary format was written as " + r.getUID() + " instead of being refused");
+                }
+            }
+        }
+    }
+
+    @Test
+    void cpioTrailerNameIsRefused() throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        boolean refused = false;
+        try (CpioArchiveOutputStream c = new CpioArchiveOutputStream(bos)) {
+            CpioArchiveEntry e = new CpioArchiveEntry("TRAILER!!!");
+            e.setSize(1);
+            try {
+                c.putArchiveEntry(e);
+                c.write(7);
+                c.closeArchiveEntry();
+            } catch (IOException | IllegalArgumentException ex) {
+                refused = true;
+            }
+            if (!refused) {
+                CpioArchiveEntry f = new CpioArchiveEntry("after");
+                f.setSize(1);
+                c.putArchiveEntry(f);
+                c.write(8);
+                c.closeArchiveEntry();
+            }
+        }
+        if (refused) {
+            return;
+        }
+        List<String> names = new ArrayList<>();
+        try (CpioArchiveInputStream in = new CpioArchiveInputStream(new ByteArrayInputStream(bos.toByteArray()))) {
+            CpioArchiveEntry r;
+            while ((r = in.getNextEntry()) != null) {
+                names.add(r.getName());
+                in.readAllBytes();
+            }
+        }
+        check(names.equals(List.of("TRAILER!!!", "after")), "an entry named TRAILER!!! was accepted and the archive reads as " + names);
+    }
+
+    @Test
+    void cpioBytesReadCountsEveryByteConsumed() throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        try (CpioArchiveOutputStream c = new CpioArchiveOutputStream(bos, CpioConstants.FORMAT_NEW)) {
+            for (String name : new String[] {"abc", "de"}) {
+                CpioArchiveEntry e = new CpioArchiveEntry(CpioConstants.FORMAT_NEW, name);
+                e.setSize(3);
+                c.putArchiveEntry(e);
+                c.write(new byte[3]);
+                c.closeArchiveEntry();
+            }
+        }
+        byte[] archive = bos.toByteArray();
+        ByteArrayInputStream bin = new ByteArrayInputStream(archive);
+        try (CpioArchiveInputStream in = new CpioArchiveInputStream(bin)) {
+            while (in.getNextEntry() != null) {
+                in.readAllBytes();
+            }
+            long consumed = archive.length - bin.available();
+            check(in.getBytesRead() == consumed, "getBytesRead() is " + in.getBytesRead() + " after consuming " + consumed + " bytes of the underlying stream");
+        }
+    }
+
+    // ---- ar ------------------------------------------------------------------------------------------------------
+
+    @Test
+    void arEmptyArchiveHasTheMagic() throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        new ArArchiveOutputStream(bos).close();
+        check(Arrays.equals(bos.toByteArray(), "!<arch>\n".getBytes()), "an empty ar archive is written as " + bos.size() + " bytes");
+        try (ArArchiveInputStream in = new ArArchiveInputStream(new ByteArrayInputStream(bos.toByteArray()))) {
+            check(in.getNextEntry() == null, "the empty archive has an entry");
+        }
+    }
+
+    static List<String> arNames(byte[] ar) throws IOException {
+        List<String> names = new ArrayList<>();
+        try (ArArchiveInputStream in = new ArArchiveInputStream(new ByteArrayInputStream(ar))) {
+            ArArchiveEntry e;
+            while ((e = in.getNextEntry()) != null) {
+                names.add(e.getName());
+                in.readAllBytes();
+            }
+        }
+        return names;
+    }
+
+    static byte[] ar(String name, int longMode) throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        try (ArArchiveOutputStream a = new ArArchiveOutputStream(bos)) {
+            a.setLongFileMode(longMode);
+            a.putArchiveEntry(new ArArchiveEntry(name, 3));
+            a.write(new byte[] {1, 2, 3});
+            a.closeArchiveEntry();
+            a.putArchiveEntry(new ArArchiveEntry("z", 1));
+            a.write(9);
+            a.closeArchiveEntry();
+        }
+        return bos.toByteArray();
+    }
+
+    @Test
+    void arReservedNamesAreRefused() throws IOException {
+        for (String name : new String[] {"/12", "#1/5", "//"}) {
+            byte[] ar;
+            try {
+                ar = ar(name, ArArchiveOutputStream.LONGFILE_BSD);
+            } catch (IOException | IllegalArgumentException ex) {
+                continue; // refused: fine
+            }
+            List<String> names;
+            try {
+                names = arNames(ar);
+            } catch (IOException ex) {
+                check(false, "the ar writer accepted the name " + Zoo.show(name) + " and the archive is unreadable: " + ex);
+                continue;
+            }
+            check(names.equals(List.of(name, "z")), "the ar writer accepted the name " + Zoo.show(name) + " and the archive reads as " + names);
+        }
+    }
+
+    @Test
+    void arNonAsciiNamesAreRefusedOrKept() throws IOException {
+        byte[] ar;
+        try {
+            ar = ar("é", ArArchiveOutputStream.LONGFILE_BSD);
+        } catch (IOException | IllegalArgumentException ex) {
+            return;
+        }
+        List<String> names = arNames(ar);
+        check(names.get(0).equals("é"), "the ar name é was written as " + Zoo.show(names.get(0)));
+    }
+
+    @Test
+    void arWriterRefusesMoreDataThanDeclared() throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        boolean refused = throwsA(IOException.class, () -> {
+            try (ArArchiveOutputStream a = new ArArchiveOutputStream(bos)) {
+                a.putArchiveEntry(new ArArchiveEntry("a", 1));
+                a.write(new byte[] {1, 2, 3});
+                a.closeArchiveEntry();
+            }
+        });
+        check(refused, "3 bytes were written into an ar entry declared with size 1 and the archive is " + bos.size() + " bytes");
+    }
+
+    @Test
+    void arNamesWithSpacesAreTerminated() throws IOException {
+        // the plain 16-byte field is space padded, so a name with a space needs the GNU terminator (name/) or the BSD form (#1/N)
+        for (int mode : new int[] {ArArchiveOutputStream.LONGFILE_ERROR, ArArchiveOutputStream.LONGFILE_BSD}) {
+            byte[] ar = ar("a b", mode);
+            String field = new String(ar, 8, 16, java.nio.charset.StandardCharsets.US_ASCII);
+            check(field.startsWith("#1/") || field.trim().endsWith("/"), "the name \"a b\" is written as the header field " + Zoo.show(field) + " in mode " + mode);
+        }
+    }
+
+    // ---- zip -----------------------------------------------------------------------------------------------------
+
+    static ZipFile zipFile(byte[] zip) throws IOException {
+        return ZipFile.builder().setSeekableByteChannel(new SeekableInMemoryByteChannel(zip)).get();
+    }
+
+    @Test
+    void zipNtfsExtraDoesNotInventAccessTimes() throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        try (ZipArchiveOutputStream z = new ZipArchiveOutputStream(bos)) {
+            ZipArchiveEntry e = new ZipArchiveEntry("a");
+            e.setLastModifiedTime(FileTime.from(Instant.ofEpochSecond(1500000000L, 123456700)));
+            z.putArchiveEntry(e);
+            z.write(1);
+            z.closeArchiveEntry();
+        }
+        try (ZipFile zf = zipFile(bos.toByteArray())) {
+            ZipArchiveEntry r = zf.getEntries().nextElement();
+            check(r.getLastAccessTime() == null && r.getCreationTime() == null,
+                "an entry written with only a modification time reads back with atime " + r.getLastAccessTime() + " and ctime " + r.getCreationTime());
+        }
+    }
+
+    @Test
+    void zipArchiveCommentTooLongIsRefused() throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        boolean refused = throwsA(IllegalArgumentException.class, () -> {
+            try (ZipArchiveOutputStream z = new ZipArchiveOutputStream(bos)) {
+                z.setComment("c".repeat(70000));
+                z.putArchiveEntry(new ZipArchiveEntry("a"));
+                z.write(1);
+                z.closeArchiveEntry();
+            }
+        });
+        if (refused) {
+            return;
+        }
+        try (ZipFile zf = zipFile(bos.toByteArray())) {
+            check(zf.getEntries().hasMoreElements(), "the archive with a 70000-byte comment has no entries");
+        } catch (IOException ex) {
+            check(false, "a 70000-byte archive comment was accepted and the archive is unreadable: " + ex);
+        }
+    }
+
+    /** A unix-made entry whose name keeps a backslash (a Java-side stand-in for archives written by unix tools). */
+    static final class UnixEntry extends ZipArchiveEntry {
+        UnixEntry(String name) {
+            super("placeholder");
+            setUnixMode(0644);
+            setName(name);
+        }
+    }
+
+    @Test
+    void zipReadersAgreeOnBackslashNames() throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        try (ZipArchiveOutputStream z = new ZipArchiveOutputStream(bos)) {
+            z.putArchiveEntry(new UnixEntry("x\\y"));
+            z.write(1);
+            z.closeArchiveEntry();
+        }
+        String filed;
+        try (ZipFile zf = zipFile(bos.toByteArray())) {
+            filed = zf.getEntries().nextElement().getName();
+        }
+        String streamed;
+        try (ZipArchiveInputStream in = new ZipArchiveInputStream(new ByteArrayInputStream(bos.toByteArray()))) {
+            streamed = in.getNextEntry().getName();
+        }
+        check(filed.equals(streamed), "ZipFile reads the name as " + Zoo.show(filed) + " but ZipArchiveInputStream as " + Zoo.show(streamed));
+    }
+
+    @Test
+    void zipLanguageEncodingFlagDoesNotDependOnCallOrder() throws IOException {
+        boolean[] flags = new boolean[2];
+        for (int k = 0; k < 2; k++) {
+            ByteArrayOutputStream bos = new ByteArrayOutputStream();
+            try (ZipArchiveOutputStream z = new ZipArchiveOutputStream(bos)) {
+                if (k == 0) {
+                    z.setUseLanguageEncodingFlag(true);
+                    z.setEncoding("Cp437");
+                    z.setEncoding("UTF-8");
+                } else {
+                    z.setEncoding("Cp437");
+                    z.setEncoding("UTF-8");
+                    z.setUseLanguageEncodingFlag(true);
+                }
