+    @Test
+    void seekableInMemoryChannelMatchesModel() {
+        Zoo.property("commons-compress.utils.seekableInMemoryChannelMatchesModel", tc -> {
+            byte[] initial = Data.bytes(tc, n(tc, 0, 100));
+            byte[] model = initial.clone();
+            boolean[] known = new boolean[model.length];
+            Arrays.fill(known, true);
+            long pos = 0;
+            List<String> ops = new ArrayList<>();
+            try (SeekableInMemoryByteChannel ch = new SeekableInMemoryByteChannel(initial.clone())) {
+                for (int step = 0; step < 25; step++) {
+                    switch (n(tc, 0, 4)) {
+                        case 0 -> {
+                            int p = n(tc, 0, model.length + 20);
+                            ops.add("position(" + p + ")");
+                            ch.position(p);
+                            pos = p;
+                        }
+                        case 1 -> {
+                            byte[] w = Data.bytes(tc, n(tc, 0, 40));
+                            ops.add("write(" + w.length + ")");
+                            int written = ch.write(ByteBuffer.wrap(w));
+                            check(written == w.length, () -> "write returned " + written + " for " + w.length + " after " + ops);
+                            if (pos + w.length > model.length) {
+                                model = Arrays.copyOf(model, (int) (pos + w.length));
+                                known = Arrays.copyOf(known, model.length); // the gap's bytes are unspecified
+                            }
+                            System.arraycopy(w, 0, model, (int) pos, w.length);
+                            Arrays.fill(known, (int) pos, (int) pos + w.length, true);
+                            pos += w.length;
+                        }
+                        case 2 -> {
+                            int len = n(tc, 0, 40);
+                            ByteBuffer b = ByteBuffer.allocate(len);
+                            ops.add("read(" + len + ")");
+                            int r = ch.read(b);
+                            int wantLen = pos >= model.length ? -1 : (int) Math.min(len, model.length - pos);
+                            if (len == 0 && pos < model.length) {
+                                wantLen = 0;
+                            }
+                            final int want = wantLen;
+                            check(r == want, () -> "read(" + len + ") returned " + r + " for " + want + " at " + ops);
+                            if (r > 0) {
+                                byte[] got = Arrays.copyOf(b.array(), r);
+                                byte[] exp = Arrays.copyOfRange(model, (int) pos, (int) pos + r);
+                                boolean same = true;
+                                for (int k = 0; k < r; k++) {
+                                    same &= !known[(int) pos + k] || got[k] == exp[k];
+                                }
+                                check(same, () -> "read gives " + Tools.hex(got, 100) + " for " + Tools.hex(exp, 100) + " at " + ops);
+                                pos += r;
+                            }
+                        }
+                        case 3 -> {
+                            int s = n(tc, 0, model.length + 10);
+                            ops.add("truncate(" + s + ")");
+                            ch.truncate(s);
+                            if (s < model.length) {
+                                model = Arrays.copyOf(model, s);
+                                known = Arrays.copyOf(known, s);
+                            }
+                            if (pos > s) {
+                                pos = s;
+                            }
+                        }
+                        default -> {
+                            ops.add("size");
+                        }
+                    }
+                    final long p = pos;
+                    final int size = model.length;
+                    long gotSize = ch.size();
+                    long gotPos = ch.position();
+                    check(gotSize == size, () -> "size() is " + gotSize + " for " + size + " after " + ops);
+                    check(gotPos == p, () -> "position() is " + gotPos + " for " + p + " after " + ops);
+                }
+                byte[] content = Arrays.copyOf(ch.array(), (int) ch.size());
+                final byte[] m = model;
+                boolean same = content.length == m.length;
+                for (int k = 0; same && k < m.length; k++) {
+                    same = !known[k] || content[k] == m[k];
+                }
+                check(same, () -> "content " + Tools.hex(content, 100) + " for " + Tools.hex(m, 100) + " after " + ops);
+            } catch (IOException ex) {
+                throw new java.io.UncheckedIOException(ex);
+            }
+        });
+    }
