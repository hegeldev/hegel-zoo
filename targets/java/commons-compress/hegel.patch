+/** Cpio in its four formats against CpioArchiveInputStream and GNU cpio; ar against ArArchiveInputStream and binutils ar. */
+class CpioArTest {
+
+    static final short[] FORMATS = {CpioConstants.FORMAT_NEW, CpioConstants.FORMAT_NEW_CRC, CpioConstants.FORMAT_OLD_ASCII, CpioConstants.FORMAT_OLD_BINARY};
+
+    static String formatName(short f) {
+        return switch (f) {
+            case CpioConstants.FORMAT_NEW -> "newc";
+            case CpioConstants.FORMAT_NEW_CRC -> "crc";
+            case CpioConstants.FORMAT_OLD_ASCII -> "odc";
+            default -> "bin";
+        };
+    }
+
+    /** The widest value each header field of the format can hold. */
+    static long maxId(short f) {
+        return switch (f) {
+            case CpioConstants.FORMAT_NEW, CpioConstants.FORMAT_NEW_CRC -> 0xFFFFFFFFL;
+            case CpioConstants.FORMAT_OLD_ASCII -> 0777777L;
+            default -> 0xFFFFL;
+        };
+    }
+
+    static long maxTime(short f) {
+        return switch (f) {
+            case CpioConstants.FORMAT_NEW, CpioConstants.FORMAT_NEW_CRC -> 0xFFFFFFFFL;
+            case CpioConstants.FORMAT_OLD_ASCII -> 077777777777L;
+            default -> 0xFFFFFFFFL;
+        };
+    }
+
+    static boolean fits(Entry e, short f) {
+        long seconds = e.mtime.toInstant().getEpochSecond();
+        return e.uid <= maxId(f) && e.gid <= maxId(f) && seconds >= 0 && seconds <= maxTime(f);
+    }
+
+    static long checksum(byte[] data) {
+        long sum = 0;
+        for (byte b : data) {
+            sum += b & 0xff;
+        }
+        return sum & 0xFFFFFFFFL;
+    }
+
+    static byte[] writeCpio(List<Entry> es, short f) throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        try (CpioArchiveOutputStream c = new CpioArchiveOutputStream(bos, f, CpioConstants.BLOCK_SIZE, "UTF-8")) {
+            for (Entry e : es) {
+                CpioArchiveEntry ce = new CpioArchiveEntry(f, e.name);
+                ce.setMode((e.kind == Kind.DIR ? CpioConstants.C_ISDIR : CpioConstants.C_ISREG) | (e.mode & 07777));
+                ce.setUID(e.uid);
+                ce.setGID(e.gid);
+                ce.setTime(e.mtime.toInstant().getEpochSecond());
+                ce.setSize(e.kind == Kind.FILE ? e.data.length : 0);
+                if (f == CpioConstants.FORMAT_NEW_CRC) {
+                    ce.setChksum(checksum(e.data));
+                }
+                c.putArchiveEntry(ce);
+                if (e.kind == Kind.FILE) {
+                    c.write(e.data);
+                }
+                c.closeArchiveEntry();
+            }
+        }
+        return bos.toByteArray();
+    }
+
+    static boolean globSafe(String name) {
+        for (char c : name.toCharArray()) {
+            if ("*?[]\\".indexOf(c) >= 0) {
+                return false;
+            }
+        }
+        return !name.startsWith("-");
+    }
+
+    @Test
+    void cpioRoundTrip() {
+        Zoo.property("commons-compress.cpio.roundTrip", tc -> {
+            short f = pick(tc, CpioConstants.FORMAT_NEW, CpioConstants.FORMAT_NEW_CRC, CpioConstants.FORMAT_OLD_ASCII, CpioConstants.FORMAT_OLD_BINARY);
+            List<Entry> es = Entries.entries(tc, 6, true, 5000, Kind.FILE, Kind.FILE, Kind.FILE, Kind.DIR);
+            for (Entry e : es) {
+                if (e.name.equals("TRAILER!!!")) {
+                    return;
+                }
+                if (Entries.utf8Length(e.name) > 200) {
+                    return; // old ascii holds 6 octal digits of name length; keep to what GNU cpio handles everywhere
+                }
+                if (!fits(e, f)) {
+                    return; // bug: the writer keeps the low digits of a value that overflows its field (the pins carry it)
+                }
+            }
+            byte[] cpio;
+            try {
+                cpio = writeCpio(es, f);
+            } catch (IOException | RuntimeException ex) {
+                Zoo.rethrowStop(ex);
+                check(false, () -> "the cpio writer failed on " + es + " as " + formatName(f) + ": " + ex);
+                return;
+            }
+            List<CpioArchiveEntry> read = new ArrayList<>();
+            List<byte[]> data = new ArrayList<>();
+            try (CpioArchiveInputStream in = new CpioArchiveInputStream(new ByteArrayInputStream(cpio), CpioConstants.BLOCK_SIZE, "UTF-8")) {
+                CpioArchiveEntry ce;
+                while ((ce = in.getNextEntry()) != null) {
+                    read.add(ce);
+                    data.add(in.readAllBytes());
+                }
+            } catch (IOException | RuntimeException ex) {
+                Zoo.rethrowStop(ex);
+                check(false, () -> "CpioArchiveInputStream failed on the " + formatName(f) + " archive of " + es + ": " + ex);
+                return;
+            }
+            check(read.size() == es.size(), () -> "CpioArchiveInputStream read " + read.size() + " entries of " + es.size() + " as " + formatName(f) + ": " + es);
+            if (read.size() != es.size()) {
+                return;
+            }
+            for (int i = 0; i < es.size(); i++) {
+                Entry e = es.get(i);
+                CpioArchiveEntry c = read.get(i);
+                byte[] d = data.get(i);
+                check(c.getName().equals(e.name), () -> formatName(f) + ": name " + show(c.getName()) + " for " + e);
+                check(c.getSize() == e.data.length, () -> formatName(f) + ": size " + c.getSize() + " for " + e);
+                check(java.util.Arrays.equals(d, e.data), () -> formatName(f) + ": data differs for " + e);
+                check((c.getMode() & 07777) == (e.mode & 07777), () -> formatName(f) + ": mode " + Long.toOctalString(c.getMode()) + " for " + e);
+                check(c.isDirectory() == (e.kind == Kind.DIR), () -> formatName(f) + ": isDirectory " + c.isDirectory() + " for " + e);
+                check(c.isRegularFile() == (e.kind == Kind.FILE), () -> formatName(f) + ": isRegularFile " + c.isRegularFile() + " for " + e);
+                check(c.getUID() == e.uid, () -> formatName(f) + ": uid " + c.getUID() + " for " + e);
+                check(c.getGID() == e.gid, () -> formatName(f) + ": gid " + c.getGID() + " for " + e);
+                check(c.getTime() == e.mtime.toInstant().getEpochSecond(), () -> formatName(f) + ": mtime " + c.getTime() + " for " + e);
+                check(c.getFormat() == f, () -> formatName(f) + ": format " + c.getFormat() + " for " + e);
+            }
+            // GNU cpio lists the same names in order and extracts the same bytes
+            if (Tools.available("cpio")) {
+                Tools.Result list = Tools.run(cpio, "cpio", "-t", "--quiet");
+                check(list.exit() == 0, () -> "GNU cpio rejects the " + formatName(f) + " archive of " + es + ": " + list.err());
+                if (list.exit() == 0) {
+                    String out = new String(list.out(), StandardCharsets.UTF_8);
+                    List<String> names = out.isEmpty() ? List.of() : List.of(out.split("\n"));
+                    List<String> want = es.stream().map(e -> e.name).toList();
+                    check(names.equals(want), () -> "GNU cpio lists " + names + " for " + want + " as " + formatName(f) + ": " + list.err());
+                }
+                for (Entry e : es) {
+                    if (e.kind == Kind.FILE && globSafe(e.name) && Entries.isAscii(e.name) && !e.name.isEmpty()) {
