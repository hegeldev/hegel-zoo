+                        check(cat.exit() == 0 && java.util.Arrays.equals(cat.out(), e.data), () -> "GNU cpio extracts " + cat.out().length + " bytes for " + e + " as " + formatName(f) + ": " + cat.err());
+                        break;
+                    }
+                }
+            }
+        });
+    }
