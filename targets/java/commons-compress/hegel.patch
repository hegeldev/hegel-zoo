+                    byte[] piece = Data.bytes(tc, n(tc, 0, 1500));
+                    expected.write(piece);
+                    switch (n(tc, 0, 2)) {
+                        case 0 -> out.write(piece);
+                        case 1 -> out.write(ByteBuffer.wrap(piece));
+                        default -> {
+                            for (byte b : piece) {
+                                out.write(b);
+                            }
+                        }
+                    }
+                }
+            } catch (IOException ex) {
+                throw new java.io.UncheckedIOException(ex);
+            }
+            byte[] got = bos.toByteArray();
