@@ -0,0 +1,41 @@
+"""Reads a zip archive from stdin with Python's zipfile and prints one JSON object per member on stdout."""
+import hashlib
+import io
+import json
+import sys
+import zipfile
+
+data = sys.stdin.buffer.read()
+out = []
+try:
+    with zipfile.ZipFile(io.BytesIO(data)) as zf:
+        comment = zf.comment
+        for zi in zf.infolist():
+            rec = {
+                "name": zi.filename,
+                "orig_name": zi.orig_filename,
+                "size": zi.file_size,
+                "csize": zi.compress_size,
+                "method": zi.compress_type,
+                "crc": zi.CRC,
+                "date_time": list(zi.date_time),
+                "flag_bits": zi.flag_bits,
+                "external_attr": zi.external_attr,
+                "create_system": zi.create_system,
+                "create_version": zi.create_version,
+                "extract_version": zi.extract_version,
+                "comment": zi.comment.decode("utf-8", "surrogateescape"),
+                "extra_len": len(zi.extra),
+                "is_dir": zi.is_dir(),
+            }
+            try:
+                content = zf.read(zi)
+                rec["sha1"] = hashlib.sha1(content).hexdigest()
+                rec["read"] = len(content)
+            except Exception as e:  # noqa: BLE001
+                rec["read_error"] = type(e).__name__ + ": " + str(e)
+            out.append(rec)
+        out.append({"archive_comment": comment.decode("utf-8", "surrogateescape"), "testzip": zf.testzip()})
+except Exception as e:  # noqa: BLE001
+    out.append({"error": type(e).__name__ + ": " + str(e)})
+sys.stdout.write(json.dumps(out, ensure_ascii=True))
