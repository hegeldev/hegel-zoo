+import org.junit.jupiter.api.Test;
+import zoo.Entries.Entry;
+import zoo.Entries.Kind;
+
+/**
+ * Zip: archives written by ZipArchiveOutputStream under every encoding, flag, zip64 and method option are read back
+ * by ZipFile, ZipArchiveInputStream, the JDK, Python's zipfile and Info-ZIP unzip with the same entries; archives
+ * written by Python are read by both commons readers alike.
+ */
+class ZipTest {
+
+    static final String PY_ZIPINFO = TarTest.read("/zoo/zipinfo.py");
+
+    record Options(String encoding, boolean langFlag, boolean unicodeExtra, boolean fallbackUtf8, Zip64Mode zip64, int method, int level,
+        String comment, boolean seekable, boolean unixMode) {}
+
+    static Options options(TestCase tc, boolean unicodeNames) {
+        String encoding = unicodeNames ? "UTF-8" : pick(tc, "UTF-8", "UTF-8", "Cp437", "ISO-8859-1");
+        return new Options(encoding, chance(tc, 60), chance(tc, 30), chance(tc, 30), pick(tc, Zip64Mode.AsNeeded, Zip64Mode.AsNeeded, Zip64Mode.Always, Zip64Mode.Never),
+            chance(tc, 30) ? ZipEntry.STORED : ZipEntry.DEFLATED, n(tc, 0, 9), chance(tc, 30) ? Zoo.word(tc, Entries.ASCII_NAME_CHARS + " ", 0, 40) : "",
+            chance(tc, 50), chance(tc, 50));
+    }
+
+    static byte[] write(List<Entry> es, Options o) throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        SeekableInMemoryByteChannel ch = new SeekableInMemoryByteChannel();
+        long size = -1;
+        ZipArchiveOutputStream z = o.seekable ? new ZipArchiveOutputStream(ch) : new ZipArchiveOutputStream(bos);
+        try {
+            z.setEncoding(o.encoding);
+            z.setUseLanguageEncodingFlag(o.langFlag);
+            z.setCreateUnicodeExtraFields(o.unicodeExtra ? ZipArchiveOutputStream.UnicodeExtraFieldPolicy.ALWAYS : ZipArchiveOutputStream.UnicodeExtraFieldPolicy.NEVER);
+            z.setFallbackToUTF8(o.fallbackUtf8);
+            z.setUseZip64(o.zip64);
+            z.setMethod(o.method);
+            z.setLevel(o.level);
+            z.setComment(o.comment);
+            for (Entry e : es) {
+                ZipArchiveEntry ze = new ZipArchiveEntry(e.kind == Kind.DIR && !e.name.endsWith("/") ? e.name + "/" : e.name);
+                ze.setLastModifiedTime(e.mtime);
+                if (o.unixMode) {
+                    ze.setUnixMode(e.mode | (e.kind == Kind.DIR ? 040000 : 0100000));
+                }
+                if (!e.uname.isEmpty()) {
+                    ze.setComment(e.uname);
+                }
+                if (o.method == ZipEntry.STORED) {
+                    ze.setSize(e.data.length);
+                    CRC32 crc = new CRC32();
+                    crc.update(e.data);
+                    ze.setCrc(crc.getValue());
+                }
+                z.putArchiveEntry(ze);
+                if (e.kind == Kind.FILE) {
+                    z.write(e.data);
+                }
+                z.closeArchiveEntry();
+            }
+            z.finish();
+            size = ch.size();
+        } finally {
+            z.close();
+        }
+        if (o.seekable) {
+            return java.util.Arrays.copyOf(ch.array(), (int) size);
+        }
+        return bos.toByteArray();
+    }
+
+    static String zipName(Entry e) {
+        return e.kind == Kind.DIR && !e.name.endsWith("/") ? e.name + "/" : e.name;
+    }
+
+    /** DOS times hold even seconds from 1980 to 2107 in the local zone. */
+    static boolean inDosRange(FileTime t) {
+        long s = t.toInstant().getEpochSecond();
+        return s >= 315532800L && s < 4354819200L;
+    }
+
+    static long dosTruncatedMillis(FileTime t) {
+        LocalDateTime l = LocalDateTime.ofInstant(t.toInstant(), ZoneId.systemDefault());
+        l = l.withNano(0).withSecond(l.getSecond() / 2 * 2);
+        return l.atZone(ZoneId.systemDefault()).toInstant().toEpochMilli();
+    }
+
+    static boolean mtimeOk(FileTime got, FileTime want) {
+        Instant w = want.toInstant();
+        FileTime hundreds = FileTime.from(Instant.ofEpochSecond(w.getEpochSecond(), w.getNano() / 100 * 100));
+        if (got.equals(hundreds)) {
+            return true;
+        }
+        return inDosRange(want) && got.toMillis() == dosTruncatedMillis(want);
+    }
+
+    @Test
+    void writtenEntriesReadBack() {
+        Zoo.property("commons-compress.zip.writtenEntriesReadBack", tc -> {
+            boolean unicode = chance(tc, 50);
+            Options o = options(tc, unicode);
+            List<Entry> es = Entries.entries(tc, 6, unicode, 20000, Kind.FILE, Kind.FILE, Kind.FILE, Kind.DIR);
+            for (Entry e : es) {
+                // ASCII names only for the legacy encodings; the writer's %Uxxxx escaping of unmappable names is documented
+                if (!o.encoding.equals("UTF-8") && (!Entries.isAscii(e.name) || !Entries.isAscii(e.uname))) {
+                    return;
+                }
+                if (Entries.utf8Length(e.name) > 65535) {
+                    return;
+                }
+            }
+            byte[] zip;
+            try {
+                zip = write(es, o);
+            } catch (IOException | RuntimeException ex) {
+                Zoo.rethrowStop(ex);
+                check(false, () -> "the writer failed on " + es + " under " + o + ": " + ex);
+                return;
+            }
+            List<ZipArchiveEntry> filed = new ArrayList<>();
+            List<byte[]> filedData = new ArrayList<>();
+            try (ZipFile zf = ZipFile.builder().setSeekableByteChannel(new SeekableInMemoryByteChannel(zip)).setCharset(o.encoding).get()) {
+                for (ZipArchiveEntry ze : Collections.list(zf.getEntries())) {
+                    filed.add(ze);
+                    try (var in = zf.getInputStream(ze)) {
+                        filedData.add(in.readAllBytes());
+                    }
+                }
+            } catch (IOException | RuntimeException ex) {
+                Zoo.rethrowStop(ex);
+                check(false, () -> "ZipFile failed on the archive of " + es + " under " + o + ": " + ex);
+                return;
+            }
+            List<ZipArchiveEntry> streamed = new ArrayList<>();
+            List<byte[]> streamedData = new ArrayList<>();
+            try (ZipArchiveInputStream in = new ZipArchiveInputStream(new ByteArrayInputStream(zip), o.encoding, o.langFlag, true)) {
+                ZipArchiveEntry ze;
+                while ((ze = in.getNextEntry()) != null) {
+                    streamed.add(ze);
+                    streamedData.add(in.readAllBytes());
+                }
+            } catch (IOException | RuntimeException ex) {
+                Zoo.rethrowStop(ex);
+                check(false, () -> "ZipArchiveInputStream failed on the archive of " + es + " under " + o + ": " + ex);
+                return;
+            }
+            check(filed.size() == es.size(), () -> "ZipFile read " + filed.size() + " entries of " + es.size() + " under " + o + ": " + es);
+            check(streamed.size() == es.size(), () -> "ZipArchiveInputStream read " + streamed.size() + " entries of " + es.size() + " under " + o + ": " + es);
+            if (filed.size() != es.size() || streamed.size() != es.size()) {
+                return;
+            }
+            for (int i = 0; i < es.size(); i++) {
+                compare("ZipFile", es.get(i), filed.get(i), filedData.get(i), o, false);
+                compare("ZipArchiveInputStream", es.get(i), streamed.get(i), streamedData.get(i), o, true);
+            }
+            // the JDK reader (UTF-8 names only, and it does not know the zip64 data descriptors)
+            if (o.encoding.equals("UTF-8") && o.zip64 != Zip64Mode.Always) {
+                try (ZipInputStream in = new ZipInputStream(new ByteArrayInputStream(zip), StandardCharsets.UTF_8)) {
+                    int i = 0;
+                    ZipEntry ze;
+                    while ((ze = in.getNextEntry()) != null) {
+                        byte[] data = in.readAllBytes();
+                        Entry e = es.get(i++);
+                        final ZipEntry z = ze;
+                        check(z.getName().equals(zipName(e)), () -> "JDK ZipInputStream: name " + show(z.getName()) + " for " + e + " under " + o);
+                        check(java.util.Arrays.equals(data, e.data), () -> "JDK ZipInputStream: data differs for " + e + " under " + o);
+                    }
+                    final int count = i;
+                    check(count == es.size(), () -> "JDK ZipInputStream read " + count + " entries of " + es.size() + " under " + o);
+                } catch (IOException | RuntimeException ex) {
+                    Zoo.rethrowStop(ex);
+                    check(false, () -> "JDK ZipInputStream failed on the archive of " + es + " under " + o + ": " + ex);
+                }
+            }
+            // Python's zipfile
+            Tools.Result py = Tools.python(zip, PY_ZIPINFO);
+            check(py.ok(), () -> "python zipfile failed on " + es + " under " + o + ": " + py.err());
+            if (py.ok()) {
+                comparePython(es, o, new String(py.out(), StandardCharsets.UTF_8));
+            }
+            // Info-ZIP unzip tests it (Debian's zip-bomb check trips over data descriptors, so only the seekable archives)
+            boolean longNames = es.stream().anyMatch(e -> Entries.utf8Length(e.name) > 250); // unzip truncates long names with a warning exit
+            if (Tools.available("unzip") && !es.isEmpty() && o.seekable && !longNames) {
+                java.nio.file.Path dir = Tools.tempDir("zoo-zip");
+                try {
+                    java.nio.file.Path f = dir.resolve("a.zip");
+                    java.nio.file.Files.write(f, zip);
+                    Tools.Result unzip = Tools.run(null, dir, "unzip", "-tqq", f.toString());
+                    check(unzip.ok(), () -> "unzip -t rejects the archive of " + es + " under " + o + ": " + unzip.err() + " " + new String(unzip.out(), StandardCharsets.UTF_8));
+                } finally {
+                    Tools.deleteTree(dir);
+                }
+            }
+        });
+    }
+
+    static void compare(String reader, Entry e, ZipArchiveEntry z, byte[] data, Options o, boolean streaming) {
+        check(z.getName().equals(zipName(e)), () -> reader + ": name " + show(z.getName()) + " for " + e + " under " + o);
+        check(z.isDirectory() == (e.kind == Kind.DIR), () -> reader + ": isDirectory " + z.isDirectory() + " for " + e + " under " + o);
+        check(java.util.Arrays.equals(data, e.data), () -> reader + ": data differs (" + data.length + " bytes for " + e.data.length + ") for " + e + " under " + o);
+        check(z.getSize() == e.data.length, () -> reader + ": size " + z.getSize() + " for " + e + " under " + o);
+        check(mtimeOk(z.getLastModifiedTime(), e.mtime), () -> reader + ": mtime " + z.getLastModifiedTime() + " for " + e + " under " + o);
+        check(z.getMethod() == (e.kind == Kind.DIR ? z.getMethod() : o.method), () -> reader + ": method " + z.getMethod() + " for " + e + " under " + o);
+        if (!streaming) {
+            // comments live in the central directory
+            check(z.getComment() == null ? e.uname.isEmpty() : z.getComment().equals(e.uname), () -> reader + ": comment " + show(z.getComment()) + " for " + e + " under " + o);
+            if (o.unixMode) {
+                check((z.getUnixMode() & 07777) == (e.mode & 07777), () -> reader + ": unix mode " + Integer.toOctalString(z.getUnixMode()) + " for " + e + " under " + o);
+            }
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    static void comparePython(List<Entry> es, Options o, String json) {
+        List<Object> members = (List<Object>) Json.parse(json);
+        if (members.size() == 1 && members.get(0) instanceof Map<?, ?> m0 && m0.containsKey("error")) {
+            check(false, () -> "python zipfile cannot read the archive of " + es + " under " + o + ": " + m0.get("error"));
+            return;
+        }
+        Map<String, Object> tail = (Map<String, Object>) members.get(members.size() - 1);
+        check(tail.get("testzip") == null, () -> "python testzip reports a bad member " + tail.get("testzip") + " for " + es + " under " + o);
+        check(o.comment.equals(tail.get("archive_comment")), () -> "python zipfile: archive comment " + show(tail.get("archive_comment")) + " for " + show(o.comment) + " under " + o);
+        check(members.size() - 1 == es.size(), () -> "python zipfile reads " + (members.size() - 1) + " members of " + es.size() + " for " + es + " under " + o);
+        if (members.size() - 1 != es.size()) {
+            return;
+        }
+        for (int i = 0; i < es.size(); i++) {
+            Entry e = es.get(i);
+            Map<String, Object> m = (Map<String, Object>) members.get(i);
+            // zipfile decodes names as cp437 unless the language encoding flag is set
+            boolean nameReadable = Entries.isAscii(e.name) || (o.encoding.equals("UTF-8") && o.langFlag);
+            if (nameReadable) {
+                check(zipName(e).equals(m.get("name")), () -> "python zipfile: name " + show(m.get("name")) + " for " + e + " under " + o);
+            }
+            check(((Number) m.get("size")).longValue() == e.data.length, () -> "python zipfile: size " + m.get("size") + " for " + e + " under " + o);
+            check(m.containsKey("sha1") && TarTest.sha1(e.data).equals(m.get("sha1")), () -> "python zipfile: data differs for " + e + " under " + o + ": " + m.get("read_error"));
+            check(Boolean.TRUE.equals(m.get("is_dir")) == (e.kind == Kind.DIR), () -> "python zipfile: is_dir " + m.get("is_dir") + " for " + e + " under " + o);
+            if (e.kind == Kind.FILE) {
+                check(((Number) m.get("method")).intValue() == o.method, () -> "python zipfile: method " + m.get("method") + " for " + e + " under " + o);
+            }
+            if (Entries.isAscii(e.uname) || o.langFlag) {
+                check(e.uname.equals(m.get("comment")), () -> "python zipfile: comment " + show(m.get("comment")) + " for " + e + " under " + o);
+            }
+            if (inDosRange(e.mtime)) {
+                LocalDateTime l = LocalDateTime.ofInstant(Instant.ofEpochMilli(dosTruncatedMillis(e.mtime)), ZoneId.systemDefault());
+                List<Object> dt = (List<Object>) m.get("date_time");
+                String want = l.getYear() + "-" + l.getMonthValue() + "-" + l.getDayOfMonth() + " " + l.getHour() + ":" + l.getMinute() + ":" + l.getSecond();
+                String got = dt.get(0) + "-" + dt.get(1) + "-" + dt.get(2) + " " + dt.get(3) + ":" + dt.get(4) + ":" + dt.get(5);
+                check(want.equals(got), () -> "python zipfile: date_time " + got + " (expected " + want + ") for " + e + " under " + o);
+            }
+            if (o.unixMode) {
+                long attr = ((Number) m.get("external_attr")).longValue();
+                check(((attr >>> 16) & 07777) == (e.mode & 07777), () -> "python zipfile: external_attr " + Long.toOctalString(attr) + " for " + e + " under " + o);
+            }
+        }
+    }
+
+    /** Archives written by Python's zipfile (stored, deflated, bzip2, lzma) are read by ZipFile and ZipArchiveInputStream alike. */
+    @Test
+    void pythonArchivesRead() {
+        Zoo.property("commons-compress.zip.pythonArchivesRead", tc -> {
+            List<Entry> es = Entries.entries(tc, 5, true, 20000, Kind.FILE, Kind.FILE, Kind.FILE, Kind.DIR);
+            String method = pick(tc, "ZIP_STORED", "ZIP_DEFLATED", "ZIP_DEFLATED", "ZIP_BZIP2", "ZIP_LZMA");
+            int pyMethod = switch (method) {
+                case "ZIP_STORED" -> 0;
+                case "ZIP_DEFLATED" -> 8;
+                case "ZIP_BZIP2" -> 12;
+                default -> 14;
+            };
+            boolean backslash = chance(tc, 10);
+            for (Entry e : es) {
+                if (e.mtime.toInstant().getEpochSecond() < 315532800L || e.mtime.toInstant().getEpochSecond() >= 4354819200L) {
+                    return; // zipfile refuses times outside the DOS range
+                }
+                if (backslash && e.name.length() > 2 && e.kind == Kind.FILE && chance(tc, 50)) {
+                    e.name = e.name.replace('/', '\\');
+                }
+            }
+            for (Entry e : es) {
+                if (e.name.contains("\\")) {
+                    return; // bug: ZipFile and ZipArchiveInputStream disagree on backslash names written by a unix tool (the pin carries it)
+                }
+            }
+            StringBuilder sb = new StringBuilder();
+            sb.append("import io, sys, zipfile, base64\n");
+            sb.append("buf = io.BytesIO()\n");
+            sb.append("zf = zipfile.ZipFile(buf, 'w')\n");
+            for (Entry e : es) {
+                String name = zipName(e);
+                Instant t = Instant.ofEpochMilli(dosTruncatedMillis(e.mtime));
+                LocalDateTime l = LocalDateTime.ofInstant(t, ZoneId.systemDefault());
+                sb.append("zi = zipfile.ZipInfo(").append(Json.py(name)).append(", (").append(l.getYear()).append(",").append(l.getMonthValue()).append(",")
+                    .append(l.getDayOfMonth()).append(",").append(l.getHour()).append(",").append(l.getMinute()).append(",").append(l.getSecond()).append("))\n");
+                sb.append("zi.create_system = 3\n");
+                sb.append("zi.external_attr = ").append(((long) (e.mode | (e.kind == Kind.DIR ? 040000 : 0100000))) << 16).append(e.kind == Kind.DIR ? " | 0x10" : "").append("\n");
+                sb.append("zi.comment = ").append(Json.py(e.uname)).append(".encode('utf-8')\n");
+                sb.append("zi.compress_type = zipfile.").append(e.kind == Kind.DIR ? "ZIP_STORED" : method).append("\n");
+                sb.append("zf.writestr(zi, base64.b64decode('").append(java.util.Base64.getEncoder().encodeToString(e.data)).append("'))\n");
+            }
+            sb.append("zf.close()\n");
+            sb.append("sys.stdout.buffer.write(buf.getvalue())\n");
+            Tools.Result py = Tools.python(null, sb.toString());
+            check(py.ok(), () -> "python zipfile could not write " + es + " with " + method + ": " + py.err());
+            if (!py.ok()) {
+                return;
+            }
+            byte[] zip = py.out();
+            List<ZipArchiveEntry> filed = new ArrayList<>();
+            List<byte[]> filedData = new ArrayList<>();
+            List<ZipArchiveEntry> streamed = new ArrayList<>();
+            List<byte[]> streamedData = new ArrayList<>();
+            try (ZipFile zf = ZipFile.builder().setSeekableByteChannel(new SeekableInMemoryByteChannel(zip)).get()) {
+                for (ZipArchiveEntry ze : Collections.list(zf.getEntries())) {
+                    filed.add(ze);
+                    if (zf.canReadEntryData(ze)) {
+                        try (var in = zf.getInputStream(ze)) {
+                            filedData.add(in.readAllBytes());
+                        }
+                    } else {
+                        filedData.add(null);
+                    }
+                }
+                try (ZipArchiveInputStream in = new ZipArchiveInputStream(new ByteArrayInputStream(zip), "UTF-8", true, true)) {
+                    ZipArchiveEntry ze;
+                    while ((ze = in.getNextEntry()) != null) {
+                        streamed.add(ze);
+                        streamedData.add(in.canReadEntryData(ze) ? in.readAllBytes() : null);
+                    }
+                }
+            } catch (IOException | RuntimeException ex) {
+                Zoo.rethrowStop(ex);
+                check(false, () -> "reading the python " + method + " archive of " + es + " failed: " + ex);
+                return;
+            }
+            check(filed.size() == es.size(), () -> "ZipFile read " + filed.size() + " of " + es.size() + " python " + method + " entries: " + es);
+            check(streamed.size() == es.size(), () -> "ZipArchiveInputStream read " + streamed.size() + " of " + es.size() + " python " + method + " entries: " + es);
+            if (filed.size() != es.size() || streamed.size() != es.size()) {
+                return;
+            }
+            for (int i = 0; i < es.size(); i++) {
+                Entry e = es.get(i);
+                ZipArchiveEntry f = filed.get(i);
+                ZipArchiveEntry s = streamed.get(i);
+                check(f.getName().equals(zipName(e)), () -> "ZipFile (python " + method + "): name " + show(f.getName()) + " for " + e);
+                check(s.getName().equals(zipName(e)), () -> "ZipArchiveInputStream (python " + method + "): name " + show(s.getName()) + " for " + e);
+                check(f.isDirectory() == (e.kind == Kind.DIR), () -> "ZipFile (python " + method + "): isDirectory " + f.isDirectory() + " for " + e);
+                check(s.isDirectory() == (e.kind == Kind.DIR), () -> "ZipArchiveInputStream (python " + method + "): isDirectory " + s.isDirectory() + " for " + e);
+                int wantMethod = e.kind == Kind.DIR ? 0 : pyMethod;
+                check(f.getMethod() == wantMethod, () -> "ZipFile (python " + method + "): method " + f.getMethod() + " for " + e);
+                check(s.getMethod() == wantMethod, () -> "ZipArchiveInputStream (python " + method + "): method " + s.getMethod() + " for " + e);
+                check(f.getSize() == e.data.length, () -> "ZipFile (python " + method + "): size " + f.getSize() + " for " + e);
+                byte[] fd = filedData.get(i);
+                byte[] sd = streamedData.get(i);
+                check(fd == null || java.util.Arrays.equals(fd, e.data), () -> "ZipFile (python " + method + "): data differs for " + e);
+                check(sd == null || java.util.Arrays.equals(sd, e.data), () -> "ZipArchiveInputStream (python " + method + "): data differs for " + e);
+                check(fd != null || wantMethod == 14, () -> "ZipFile cannot read a python " + method + " entry: " + e);
+                check(e.uname.equals(f.getComment() == null ? "" : f.getComment()), () -> "ZipFile (python " + method + "): comment " + show(f.getComment()) + " for " + e);
+                check((f.getUnixMode() & 07777) == (e.mode & 07777), () -> "ZipFile (python " + method + "): unix mode " + Integer.toOctalString(f.getUnixMode()) + " for " + e);
+                long wantMillis = dosTruncatedMillis(e.mtime);
+                check(f.getTime() == wantMillis, () -> "ZipFile (python " + method + "): time " + f.getLastModifiedTime() + " (expected " + FileTime.fromMillis(wantMillis) + ") for " + e);
+                check(s.getTime() == wantMillis, () -> "ZipArchiveInputStream (python " + method + "): time " + s.getLastModifiedTime() + " (expected " + FileTime.fromMillis(wantMillis) + ") for " + e);
+            }
+        });
+    }
+
+    static Charset charset(String name) {
+        return Charset.forName(name);
+    }
+}
