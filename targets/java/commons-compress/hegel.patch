+    // ---- ar ----------------------------------------------------------------------------------------------------
+
+    /** A name the ar format can hold: no slash, no surrounding spaces, not one of the long-name markers. */
+    static String arName(TestCase tc) {
+        String s = Zoo.word(tc, Entries.ASCII_NAME_CHARS + (chance(tc, 30) ? " !#$%&'()+,;=@[]^`{}~" : ""), 1, chance(tc, 40) ? 40 : 16);
+        s = s.strip();
+        if (s.isEmpty() || s.startsWith("#1/") || s.startsWith("/") || s.startsWith("-")) {
+            s = "x" + s;
+        }
+        if (s.length() == 16) {
+            s += "x"; // binutils reads only 15 characters of an unterminated 16-character name; an oracle divergence, not recorded
+        }
+        return s;
+    }
+
+    @Test
+    void arRoundTrip() {
