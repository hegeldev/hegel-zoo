+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.channels.SeekableByteChannel;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import org.apache.commons.compress.utils.BitInputStream;
+import org.apache.commons.compress.utils.ByteUtils;
+import org.apache.commons.compress.utils.FixedLengthBlockOutputStream;
+import org.apache.commons.compress.utils.IOUtils;
+import org.apache.commons.compress.utils.MultiReadOnlySeekableByteChannel;
+import org.apache.commons.compress.utils.SeekableInMemoryByteChannel;
+import org.junit.jupiter.api.Test;
+
+/** The utility classes against small reference models. */
+class UtilsTest {
+
+    @Test
+    void littleEndianRoundTrips() {
+        Zoo.property("commons-compress.utils.littleEndianRoundTrips", tc -> {
+            int len = n(tc, 1, 8);
+            long value = len == 8 ? pick(tc, -1L, Long.MIN_VALUE, Long.MAX_VALUE, (long) n(tc, 0, Integer.MAX_VALUE) << 32 | n(tc, 0, Integer.MAX_VALUE))
+                : pick(tc, 0L, (1L << (8 * len)) - 1, 1L << (8 * len - 1), (long) n(tc, 0, Integer.MAX_VALUE) & ((1L << (8 * len)) - 1));
+            byte[] buf = new byte[len + 3];
+            ByteUtils.toLittleEndian(buf, value, 2, len);
+            ByteBuffer ref = ByteBuffer.allocate(8).order(ByteOrder.LITTLE_ENDIAN).putLong(value);
+            byte[] want = Arrays.copyOf(ref.array(), len);
+            check(Arrays.equals(Arrays.copyOfRange(buf, 2, 2 + len), want), () -> "toLittleEndian(" + value + ", " + len + ") wrote " + Tools.hex(buf, 20) + " for " + Tools.hex(want, 20));
+            check(buf[0] == 0 && buf[1] == 0 && buf[len + 2] == 0, () -> "toLittleEndian wrote outside its range: " + Tools.hex(buf, 20));
+            long back = ByteUtils.fromLittleEndian(buf, 2, len);
+            check(back == value, () -> "fromLittleEndian gives " + back + " for " + value + " in " + len + " bytes");
+            try {
+                ByteArrayOutputStream bos = new ByteArrayOutputStream();
+                ByteUtils.toLittleEndian(bos, value, len);
+                check(Arrays.equals(bos.toByteArray(), want), () -> "toLittleEndian(OutputStream) wrote " + Tools.hex(bos.toByteArray(), 20) + " for " + Tools.hex(want, 20));
+                long back2 = ByteUtils.fromLittleEndian(new ByteArrayInputStream(want), len);
+                check(back2 == value, () -> "fromLittleEndian(InputStream) gives " + back2 + " for " + value);
+                long back3 = ByteUtils.fromLittleEndian(want);
+                check(back3 == value, () -> "fromLittleEndian(byte[]) gives " + back3 + " for " + value);
+            } catch (IOException ex) {
+                throw new java.io.UncheckedIOException(ex);
+            }
+        });
+    }
+
+    /** A reference bit reader over the same bytes. */
+    static final class RefBits {
+        final byte[] data;
+        final boolean little;
+        long bitPos;
+
+        RefBits(byte[] data, boolean little) {
+            this.data = data;
+            this.little = little;
+        }
+
+        long remaining() {
+            return 8L * data.length - bitPos;
+        }
+
+        int bit(long pos) {
+            int b = data[(int) (pos / 8)] & 0xff;
+            int i = (int) (pos % 8);
+            return little ? (b >> i) & 1 : (b >> (7 - i)) & 1;
+        }
+
+        long read(int count) {
+            if (count == 0) {
+                return 0;
+            }
+            if (remaining() < count) {
+                bitPos = 8L * data.length;
+                return -1;
+            }
+            long v = 0;
+            if (little) {
+                for (int i = 0; i < count; i++) {
+                    v |= (long) bit(bitPos + i) << i;
+                }
+            } else {
+                for (int i = 0; i < count; i++) {
+                    v = (v << 1) | bit(bitPos + i);
+                }
+            }
+            bitPos += count;
+            return v;
+        }
+
+        void align() {
+            bitPos = (bitPos + 7) / 8 * 8;
+        }
+    }
+
+    @Test
+    void bitInputStreamMatchesReference() {
+        Zoo.property("commons-compress.utils.bitInputStreamMatchesReference", tc -> {
+            byte[] data = Data.bytes(tc, n(tc, 0, 64));
+            boolean little = chance(tc, 50);
+            RefBits ref = new RefBits(data, little);
+            List<String> ops = new ArrayList<>();
+            try (BitInputStream in = new BitInputStream(new ByteArrayInputStream(data), little ? ByteOrder.LITTLE_ENDIAN : ByteOrder.BIG_ENDIAN)) {
+                for (int step = 0; step < 40; step++) {
+                    if (chance(tc, 10)) {
+                        ops.add("align");
+                        in.alignWithByteBoundary();
+                        ref.align();
+                        continue;
+                    }
+                    int count = pick(tc, n(tc, 1, 8), n(tc, 1, 63), 1, 8, 16, 32, 57, 58, 63);
+                    ops.add("read" + count);
+                    long want = ref.read(count);
+                    long got = in.readBits(count);
+                    check(got == want, () -> "readBits(" + count + ") gives " + got + " for " + want + " after " + ops + " on " + Tools.hex(data, 200) + (little ? " little" : " big"));
+                    if (want < 0) {
+                        break;
+                    }
+                    long avail = in.bitsAvailable();
+                    check(avail == ref.remaining(), () -> "bitsAvailable() is " + avail + " for " + ref.remaining() + " after " + ops);
+                }
+            } catch (IOException ex) {
+                throw new java.io.UncheckedIOException(ex);
+            }
+        });
+    }
