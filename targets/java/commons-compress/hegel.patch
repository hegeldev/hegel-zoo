+            int block = pick(tc, 1, 2, 3, 8, 512, n(tc, 1, 1000));
+            ByteArrayOutputStream bos = new ByteArrayOutputStream();
+            ByteArrayOutputStream expected = new ByteArrayOutputStream();
+            try (FixedLengthBlockOutputStream out = new FixedLengthBlockOutputStream(bos, block)) {
