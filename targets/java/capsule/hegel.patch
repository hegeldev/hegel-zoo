+                Zoo.check(AbstractSpecialisedImmutableMap.mapOf(xs.get(0), 0, xs.get(1), 1).equals(em), () -> "mapOf(k0, v0, k1, v1) of " + xs);
+            }
+            // multimaps and relations
+            if (xs.size() == 2) {
