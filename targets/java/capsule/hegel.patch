diff --git a/hegel/src/test/java/zoo/CapsulePinsTest.java b/hegel/src/test/java/zoo/CapsulePinsTest.java
new file mode 100644
index 0000000..4396c1e
--- /dev/null
+++ b/hegel/src/test/java/zoo/CapsulePinsTest.java
@@ -0,0 +1,255 @@
+package zoo;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import io.usethesource.capsule.BinaryRelation;
+import io.usethesource.capsule.Map;
+import io.usethesource.capsule.Set;
+import io.usethesource.capsule.SetMultimap;
+import io.usethesource.capsule.core.PersistentBidirectionalTrieSetMultimap;
+import io.usethesource.capsule.core.PersistentTrieMap;
+import io.usethesource.capsule.core.PersistentTrieSet;
+import io.usethesource.capsule.core.PersistentTrieSetMultimap;
+import io.usethesource.capsule.core.trie.ArrayView;
+import io.usethesource.capsule.util.collection.AbstractSpecialisedImmutableMap;
+import io.usethesource.capsule.util.collection.AbstractSpecialisedImmutableSet;
+import io.usethesource.capsule.util.iterator.SupplierIterator;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.ListIterator;
+import java.util.NoSuchElementException;
+import org.junit.jupiter.api.Test;
+import zoo.Keys.K;
+
+/**
+ * One deterministic pin per recorded bug (bugs.toml). Each pin asserts the correct behaviour, so it fails
+ * while the bug exists and passes once upstream fixes it; the properties in the other classes skip these
+ * shapes through the switches in {@link Known}.
+ */
+class CapsulePinsTest {
+
+    /** capsule/1 */
+    @Test
+    void mapEntrySetContainsTestsEntries() {
+        Map.Immutable<Integer, Integer> m = PersistentTrieMap.of();
+        m = m.__put(1, 5);
+        assertTrue(m.entrySet().contains(java.util.Map.entry(1, 5)), "entrySet().contains(entry(1, 5))");
+        assertFalse(m.entrySet().contains((Object) 1), "entrySet().contains(1) — a bare key is not an entry");
+        java.util.HashMap<Integer, Integer> twin = new java.util.HashMap<>(java.util.Map.of(1, 5));
+        assertTrue(m.entrySet().equals(twin.entrySet()), "entrySet().equals(HashMap.entrySet())");
+        SetMultimap.Immutable<Integer, Integer> mm = PersistentTrieSetMultimap.of();
+        mm = mm.__insert(1, 2).__insert(1, 3);
+        assertTrue(mm.entrySet().contains(java.util.Map.entry(1, 2)), "multimap entrySet().contains(entry(1, 2))");
+    }
+
+    /** capsule/2 */
+    @Test
+    void transientPutOfAnEqualValueReturnsTheOldValueInCollisionNodes() {
+        Map.Transient<K, Integer> t = PersistentTrieMap.transientOf();
+        K a = new K(1, 7);
+        K b = new K(2, 7);
+        t.__put(a, 5);
+        t.__put(b, 6);
+        // a bitmap node returns the previous value for an unchanged mapping; so must a hash-collision node
+        Map.Transient<K, Integer> plain = PersistentTrieMap.transientOf();
+        plain.__put(a, 5);
+        assertEquals(5, plain.__put(a, 5), "bitmap node: __put of the same value returns the old value");
+        assertEquals(5, t.__put(a, 5), "collision node: __put of the same value returns the old value");
+    }
+
+    /** capsule/3 */
+    @Test
+    void transientPutAllOfUnchangedMappingsReportsNoChange() {
+        Map.Transient<Integer, Integer> t = PersistentTrieMap.transientOf();
+        t.__put(1, 5);
+        assertFalse(t.__putAll(java.util.Map.of(1, 5)), "__putAll of a mapping already present is not a modification");
+    }
+
+    /** capsule/4 */
+    @Test
+    void insertOfASetOntoASingletonCountsEveryTuple() {
+        Set.Immutable<Integer> two = PersistentTrieSet.of(15, 18);
+        SetMultimap.Immutable<Integer, Integer> mm = PersistentTrieSetMultimap.of();
+        mm = mm.__insert(39, 5).__insert(39, two);
+        assertEquals(3, mm.get(39).size(), "the key maps to three values");
+        assertEquals(3, mm.size(), "size counts the three tuples");
+        SetMultimap.Transient<Integer, Integer> t = PersistentTrieSetMultimap.transientOf();
+        t.__insert(39, 5);
+        t.__insert(39, two);
+        assertEquals(3, t.size(), "transient size counts the three tuples");
+    }
+
+    /** capsule/5 */
+    @Test
+    void transientPutOfTheSameValuesReportsNoChange() {
+        SetMultimap.Transient<Integer, Integer> t = PersistentTrieSetMultimap.transientOf();
+        t.__insert(1, 2);
+        assertFalse(t.__put(1, 2), "__put(1, 2) when 1 maps to exactly {2}");
+        assertFalse(t.__put(1, PersistentTrieSet.of(2)), "__put(1, {2}) when 1 maps to exactly {2}");
+        assertEquals(1, t.size());
+    }
+
+    /** capsule/6 */
+    @Test
+    void relationTransientInsertOfPresentValuesReportsNoChange() {
+        BinaryRelation.Transient<Integer, Integer> t = PersistentBidirectionalTrieSetMultimap.transientOf();
+        t.__insert(1, 2);
+        t.__insert(1, 3);
+        assertFalse(t.__insert(1, PersistentTrieSet.of(2)), "inserting a value already present changes nothing");
+        assertFalse(t.__insert(1, PersistentTrieSet.of()), "inserting no values changes nothing");
+        assertEquals(2, t.size());
+    }
+
+    /** capsule/7 */
+    @Test
+    void relationPutKeepsTheInverseInSync() {
+        BinaryRelation.Immutable<Integer, String> r = PersistentBidirectionalTrieSetMultimap.of();
+        SetMultimap.Immutable<Integer, String> m = r.__insert(1, "a").__insert(2, "a").__put(3, "a");
+        BinaryRelation.Immutable<Integer, String> rel = (BinaryRelation.Immutable<Integer, String>) m;
+        assertEquals(new HashSet<>(java.util.Set.of(1, 2, 3)), new HashSet<>(rel.inverse().get("a")), "inverse of {1:a, 2:a, 3:a} maps a to {1, 2, 3}");
+        assertEquals(3, rel.inverse().size(), "inverse has three tuples");
+        SetMultimap.Immutable<Integer, String> q = r.__insert(1, "a").__insert(1, "b").__put(1, "c");
+        BinaryRelation.Immutable<Integer, String> qr = (BinaryRelation.Immutable<Integer, String>) q;
+        assertFalse(qr.inverse().containsKey("b"), "after __put(1, c) the inverse no longer knows b");
+        assertFalse(q.containsValue("b"), "after __put(1, c) the relation no longer contains the value b");
+    }
+
+    /** capsule/8 */
+    @Test
+    void setOfTwoEqualElementsHoldsOne() {
+        Set.Immutable<Integer> s = Set.Immutable.of(7, 7);
+        assertEquals(1, s.size(), "Set.Immutable.of(7, 7).size()");
+        assertEquals(new HashSet<>(java.util.Set.of(7)), s, "Set.Immutable.of(7, 7) equals {7}");
+        assertEquals(7, s.hashCode(), "hashCode of {7}");
+        assertFalse(s.__remove(7).contains(7), "removing 7 removes it");
+        Set.Immutable<Integer> viaCore = PersistentTrieSet.of(7, 7);
+        assertEquals(1, viaCore.size(), "PersistentTrieSet.of(7, 7).size()");
+    }
+
+    /** capsule/9 */
+    @Test
+    void mapEntryEqualsIsSymmetric() {
+        java.util.Map.Entry<String, Integer> e = AbstractSpecialisedImmutableMap.mapOf("a", 1).entryIterator().next();
+        java.util.Map.Entry<String, Integer> twin = new java.util.AbstractMap.SimpleEntry<>("a", 1);
+        assertTrue(twin.equals(e), "SimpleEntry.equals(MapEntry)");
+        assertTrue(e.equals(twin), "MapEntry.equals(SimpleEntry) — Map.Entry equality is by key and value");
+        assertTrue(e.equals(java.util.Map.entry("a", 1)), "MapEntry.equals(Map.entry)");
+        assertTrue(AbstractSpecialisedImmutableMap.entryOf("a", 1).equals(twin), "entryOf(a, 1).equals(SimpleEntry)");
+    }
+
+    /** capsule/10 */
+    @Test
+    void transientPutOfNullFailsAtomically() {
+        Map.Transient<String, Integer> t = Map.Transient.of("a", 1, "b", 2);
+        boolean threw = false;
+        try {
+            t.__put("a", null);
+        } catch (NullPointerException expected) {
+            threw = true;
+        }
+        assertTrue(threw, "__put(a, null) throws NullPointerException");
+        assertEquals(1, t.get("a"), "the mapping of a is unchanged after the refused put");
+        assertEquals(java.util.Map.of("a", 1, "b", 2), new java.util.HashMap<>(t), "the transient still equals its content");
+        Map.Immutable<String, Integer> frozen = t.freeze();
+        assertEquals(1, frozen.get("a"), "the frozen map has the old value");
+    }
+
+    /** capsule/11 */
+    @Test
+    void arrayViewListIteratorMovesBackwards() {
+        String[] items = {"a", "b", "c"};
+        ArrayView<String> view = new ArrayView<>() {
+            @Override
+            public int size() {
+                return items.length;
+            }
+
+            @Override
+            public String get(int index) {
+                return items[index];
+            }
+        };
+        ListIterator<String> fresh = view.iterator();
+        assertFalse(fresh.hasPrevious(), "a fresh ListIterator has no previous element");
+        assertEquals(0, fresh.nextIndex(), "nextIndex() of a fresh iterator is 0");
+        ListIterator<String> it = view.iterator();
+        assertEquals("a", it.next());
+        assertEquals("b", it.next());
+        assertEquals("c", it.next());
+        assertEquals(3, it.nextIndex(), "nextIndex() after three next() calls");
+        assertTrue(it.hasPrevious());
+        assertEquals("c", it.previous(), "previous() returns the element last returned by next()");
+        assertEquals("b", it.previous());
+        assertEquals("a", it.previous());
+        assertFalse(it.hasPrevious(), "back at the start");
+    }
+
+    /** capsule/12 */
+    @Test
+    void transientIteratorRemoveFollowsTheContract() {
+        Set.Transient<Integer> t = Set.Transient.of(1, 2, 3);
+        Iterator<Integer> before = t.iterator();
+        boolean illegal = false;
+        try {
+            before.remove();
+        } catch (IllegalStateException expected) {
+            illegal = true;
+        } catch (UnsupportedOperationException alsoFine) {
+            illegal = true;
+        }
+        assertTrue(illegal, "remove() before next() throws IllegalStateException");
+        assertEquals(3, t.size(), "nothing removed");
+        Iterator<Integer> it = t.iterator();
+        it.next();
+        it.remove();
+        assertEquals(2, t.size(), "one element removed");
+        boolean second = false;
+        try {
+            it.remove();
+        } catch (IllegalStateException expected) {
+            second = true;
+        }
+        assertTrue(second, "a second remove() without next() throws IllegalStateException");
+    }
+
+    /** capsule/13 */
+    @Test
+    void specialisedSupplierIteratorGetReturnsTheValue() {
+        Map.Immutable<Integer, Integer> m = AbstractSpecialisedImmutableMap.mapOf(1, 100, 2, 200);
+        Iterator<Integer> it = m.keyIterator();
+        assertTrue(it instanceof SupplierIterator, "the specialised key iterator is a SupplierIterator");
+        SupplierIterator<Integer, Integer> si = (SupplierIterator<Integer, Integer>) it;
+        Integer k = si.next();
+        assertEquals(m.get(k), si.get(), "get() is the value of the key just returned");
+    }
+
+    /** capsule/14 */
+    @Test
+    void specialisedIteratorsThrowNoSuchElementException() {
+        Iterator<Integer> it = AbstractSpecialisedImmutableSet.setOf(7).iterator();
+        assertEquals(7, it.next());
+        assertFalse(it.hasNext());
+        boolean nse = false;
+        try {
+            it.next();
+        } catch (NoSuchElementException expected) {
+            nse = true;
+        } catch (IllegalStateException wrong) {
+            nse = false;
+        }
+        assertTrue(nse, "next() past the end throws NoSuchElementException");
+        Iterator<Integer> mit = AbstractSpecialisedImmutableMap.mapOf(1, 2).keyIterator();
+        mit.next();
+        boolean nse2 = false;
+        try {
+            mit.next();
+        } catch (NoSuchElementException expected) {
+            nse2 = true;
+        } catch (IllegalStateException wrong) {
+            nse2 = false;
+        }
+        assertTrue(nse2, "map key iterator: next() past the end throws NoSuchElementException");
+    }
+}
diff --git a/hegel/src/test/java/zoo/Keys.java b/hegel/src/test/java/zoo/Keys.java
new file mode 100644
index 0000000..0a05752
--- /dev/null
+++ b/hegel/src/test/java/zoo/Keys.java
@@ -0,0 +1,139 @@
+package zoo;
+
+import dev.hegel.TestCase;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.io.Serializable;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+
+/**
+ * Keys with a controllable hash code: {@code equals} compares the value, {@code hashCode} is the second
+ * field, so a key domain can force hash collisions (same hash, different values), deep tries (hashes that
+ * differ only in their top bits) or behave like plain integers. Serializable, so the collections holding
+ * them round-trip through Java serialization.
+ */
+final class Keys {
+    private Keys() {}
+
+    static final class K implements Serializable, Comparable<K> {
+        final int v;
+        final int h;
+
+        K(int v, int h) {
+            this.v = v;
+            this.h = h;
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            return o instanceof K k && k.v == v;
+        }
+
+        @Override
+        public int hashCode() {
+            return h;
+        }
+
+        @Override
+        public int compareTo(K o) {
+            return Integer.compare(v, o.v);
+        }
+
+        @Override
+        public String toString() {
+            return h == v ? Integer.toString(v) : v + "#" + Integer.toHexString(h);
+        }
+    }
+
+    /** How values map to hash codes. */
+    enum Shape { PLAIN, COLLIDE, DEEP, TOPBITS, MIXED }
+
+    /** A bounded universe of keys of one shape; small universes make repeats (and removals of members) likely. */
+    static final class Domain {
+        final Shape shape;
+        final int universe;
+
+        Domain(Shape shape, int universe) {
+            this.shape = shape;
+            this.universe = universe;
+        }
+
+        K key(TestCase tc) {
+            return of(Zoo.n(tc, 0, universe - 1));
+        }
+
+        /** The key of value {@code v}: the hash is a function of the value, so equal keys hash alike. */
+        K of(int v) {
+            return switch (shape) {
+                case PLAIN -> new K(v, v);
+                // four hash buckets only: every bucket ends in a hash-collision node
+                case COLLIDE -> new K(v, (v & 3) == 0 ? 0 : (v & 3) == 1 ? 1 : (v & 3) == 2 ? 32 : Integer.MIN_VALUE);
+                // hashes that agree in the low 25 bits: the trie is seven levels deep before it separates them
+                case DEEP -> new K(v, (v << 25) | 0x155_5555);
+                // hashes that differ only in the top two bits (the last 2-bit fragment) and collide beyond that
+                case TOPBITS -> new K(v, ((v & 3) << 30) | ((v >>> 2) & 1) * 0x3fff_ffff);
+                case MIXED -> switch (v % 3) {
+                    case 0 -> new K(v, v);
+                    case 1 -> new K(v, (v << 25) | 7);
+                    default -> new K(v, v & 1);
+                };
+            };
+        }
+
+        @Override
+        public String toString() {
+            return shape + "/" + universe;
+        }
+    }
+
+    static Domain domain(TestCase tc) {
+        Shape shape = Zoo.pick(tc, Shape.PLAIN, Shape.COLLIDE, Shape.DEEP, Shape.TOPBITS, Shape.MIXED);
+        int universe = Zoo.pick(tc, 3, 6, 12, 40, 300);
+        return new Domain(shape, universe);
+    }
+
+    /** A random subset of the domain of 0..max keys. */
+    static HashSet<K> subset(TestCase tc, Domain d, int max) {
+        int n = Zoo.n(tc, 0, max);
+        HashSet<K> s = new HashSet<>();
+        for (int i = 0; i < n; i++) {
+            s.add(d.key(tc));
+        }
+        return s;
+    }
+
+    static List<K> list(TestCase tc, Domain d, int max) {
+        int n = Zoo.n(tc, 0, max);
+        List<K> s = new ArrayList<>();
+        for (int i = 0; i < n; i++) {
+            s.add(d.key(tc));
+        }
+        return s;
+    }
+
+    /** Java serialization round trip. */
+    @SuppressWarnings("unchecked")
+    static <T> T roundTrip(T o) throws Exception {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        try (ObjectOutputStream oos = new ObjectOutputStream(bos)) {
+            oos.writeObject(o);
+        }
+        try (ObjectInputStream ois = new ObjectInputStream(new ByteArrayInputStream(bos.toByteArray()))) {
+            return (T) ois.readObject();
+        }
+    }
+
+    /** The number of elements an iterator yields (capped, so a broken iterator cannot hang the test). */
+    static int count(java.util.Iterator<?> it, int cap) {
+        int n = 0;
+        while (it.hasNext() && n <= cap) {
+            it.next();
+            n++;
+        }
+        return n;
+    }
+}
diff --git a/hegel/src/test/java/zoo/Known.java b/hegel/src/test/java/zoo/Known.java
new file mode 100644
index 0000000..65ce9d0
--- /dev/null
+++ b/hegel/src/test/java/zoo/Known.java
@@ -0,0 +1,52 @@
+package zoo;
+
+/**
+ * The recorded bugs (bugs.toml), as switches: the properties skip exactly these shapes so that they stay green
+ * while the pins in {@link CapsulePinsTest} fail until upstream fixes them. Flip one to false to see the
+ * property find the bug again.
+ */
+final class Known {
+    private Known() {}
+
+    /** capsule/1: {@code entrySet().contains(o)} of the trie map and the multimaps delegates to {@code containsKey(o)}. */
+    static final boolean ENTRY_SET_CONTAINS_TESTS_KEYS = true;
+
+    /** capsule/2: transient {@code __put} of an existing key with an equal value returns null in a hash-collision node. */
+    static final boolean PUT_OF_EQUAL_VALUE_RETURNS_NULL_IN_COLLISION_NODES = true;
+
+    /** capsule/3: transient {@code __putAll} reports a modification for a re-put equal mapping. */
+    static final boolean PUT_ALL_COUNTS_UNCHANGED_MAPPINGS = true;
+
+    /** capsule/4: {@code __insert(key, set)} of two or more values onto a key holding one value undercounts {@code size()} by one. */
+    static final boolean INSERT_SET_ONTO_SINGLETON_UNDERCOUNTS = true;
+
+    /** capsule/5: transient {@code __put(key, value)} and {@code __put(key, set)} report a change when the key already maps to exactly those values. */
+    static final boolean PUT_OF_SAME_SINGLETON_REPORTS_CHANGE = true;
+
+    /** capsule/6: the relation's transient {@code __insert(key, set)} (the interface default) reports a change whenever the set differs from the current values, even if nothing was inserted. */
+    static final boolean INSERT_SET_REPORTS_CHANGE_WITHOUT_INSERTING = true;
+
+    /** capsule/7: the bidirectional relation's {@code __put(key, value)} applies a put to the inverse too, desynchronising it. */
+    static final boolean RELATION_PUT_DESYNCS_INVERSE = true;
+
+    /** capsule/8: {@code Set.Immutable.of(a, b)} with equal elements builds a two-element set holding the element twice. */
+    static final boolean SET_OF_TWO_EQUAL_ELEMENTS_IS_CORRUPT = true;
+
+    /** capsule/9: the specialised maps' {@code Map.Entry} compares classes, so it is not equal to an equal entry of another class. */
+    static final boolean MAP_ENTRY_EQUALS_USES_GET_CLASS = true;
+
+    /** capsule/10: transient {@code __put(existingKey, null)} mutates the node before throwing, leaving the map unusable. */
+    static final boolean TRANSIENT_PUT_OF_NULL_POISONS_THE_MAP = true;
+
+    /** capsule/11: {@code ArrayView.iterator()} goes wrong backwards (no property; pin only). */
+    static final boolean ARRAY_VIEW_LIST_ITERATOR_IS_BROKEN_BACKWARDS = true;
+
+    /** capsule/12: transient {@code iterator().remove()} before {@code next()} throws NullPointerException, twice in a row is a silent no-op. */
+    static final boolean TRANSIENT_ITERATOR_REMOVE_IGNORES_THE_CONTRACT = true;
+
+    /** capsule/13: the specialised maps' {@code SupplierIterator.get()} always throws. */
+    static final boolean SPECIALISED_SUPPLIER_ITERATOR_GET_IS_DEAD = true;
+
+    /** capsule/14: the specialised sets' and maps' iterators throw IllegalStateException past the end. */
+    static final boolean SPECIALISED_ITERATORS_THROW_ILLEGAL_STATE = true;
+}
diff --git a/hegel/src/test/java/zoo/MapTest.java b/hegel/src/test/java/zoo/MapTest.java
new file mode 100644
index 0000000..370cdd8
--- /dev/null
+++ b/hegel/src/test/java/zoo/MapTest.java
@@ -0,0 +1,236 @@
+package zoo;
+
+import io.usethesource.capsule.Map;
+import io.usethesource.capsule.core.PersistentTrieMap;
+import io.usethesource.capsule.util.collection.AbstractSpecialisedImmutableMap;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+import zoo.Keys.Domain;
+import zoo.Keys.K;
+
+/**
+ * Capsule's persistent maps against {@link HashMap} under the same operation script: the CHAMP trie
+ * ({@link PersistentTrieMap}) and the specialised small maps ({@link AbstractSpecialisedImmutableMap}),
+ * driven immutably and through transients. Values are small integers so that a key is often re-put with
+ * an equal value and often with a different one.
+ */
+class MapTest {
+
+    enum Start {
+        TRIE(PersistentTrieMap::of), SPECIALISED(AbstractSpecialisedImmutableMap::mapOf), DEFAULT(Map.Immutable::of);
+
+        final Supplier<Map.Immutable<K, Integer>> make;
+
+        Start(Supplier<Map.Immutable<K, Integer>> make) {
+            this.make = make;
+        }
+    }
+
+    static Map.Immutable<K, Integer> build(Start start, java.util.Map<K, Integer> entries) {
+        Map.Immutable<K, Integer> m = start.make.get();
+        for (var e : entries.entrySet()) {
+            m = m.__put(e.getKey(), e.getValue());
+        }
+        return m;
+    }
+
+    static Integer value(dev.hegel.TestCase tc) {
+        return Zoo.n(tc, 0, 3);
+    }
+
+    static void agree(String where, Map<K, Integer> m, HashMap<K, Integer> model, Domain d) {
+        Zoo.check(m.size() == model.size(), () -> where + ": size " + m.size() + " vs model " + model.size() + " " + model);
+        Zoo.check(m.isEmpty() == model.isEmpty(), () -> where + ": isEmpty " + m.isEmpty());
+        for (var e : model.entrySet()) {
+            K k = e.getKey();
+            Zoo.check(m.containsKey(k), () -> where + ": key " + k + " missing from " + m);
+            Zoo.check(Objects.equals(m.get(k), e.getValue()), () -> where + ": get(" + k + ") = " + m.get(k) + " vs " + e.getValue());
+            Zoo.check(m.containsValue(e.getValue()), () -> where + ": containsValue(" + e.getValue() + ") false");
+        }
+        for (int v = 0; v < Math.min(d.universe, 64); v++) {
+            K k = d.of(v);
+            if (!model.containsKey(k)) {
+                Zoo.check(!m.containsKey(k), () -> where + ": absent key " + k + " reported present");
+                Zoo.check(m.get(k) == null, () -> where + ": get(absent " + k + ") = " + m.get(k));
+            }
+        }
+        for (int v = 0; v <= 4; v++) {
+            final int vv = v;
+            Zoo.check(m.containsValue(v) == model.containsValue(v), () -> where + ": containsValue(" + vv + ") = " + m.containsValue(vv));
+        }
+        Zoo.check(m.hashCode() == model.hashCode(), () -> where + ": hashCode " + m.hashCode() + " vs model " + model.hashCode());
+        Zoo.check(m.equals(model), () -> where + ": map.equals(HashMap) false: " + m + " vs " + model);
+        Zoo.check(model.equals(m), () -> where + ": HashMap.equals(map) false: " + model + " vs " + m);
+        // views
+        Zoo.check(m.keySet().equals(model.keySet()) && model.keySet().equals(m.keySet()), () -> where + ": keySet " + m.keySet() + " vs " + model.keySet());
+        Zoo.check(m.keySet().size() == model.size(), () -> where + ": keySet size " + m.keySet().size());
+        Zoo.check(model.entrySet().equals(m.entrySet()), () -> where + ": HashMap.entrySet.equals(entrySet) false " + m.entrySet() + " vs " + model.entrySet());
+        if (!Known.ENTRY_SET_CONTAINS_TESTS_KEYS) {
+            Zoo.check(m.entrySet().equals(model.entrySet()), () -> where + ": entrySet.equals(HashMap.entrySet) false " + m.entrySet() + " vs " + model.entrySet());
+        }
+        Zoo.check(m.entrySet().size() == model.size(), () -> where + ": entrySet size " + m.entrySet().size());
+        List<Integer> values = new ArrayList<>(m.values());
+        List<Integer> modelValues = new ArrayList<>(model.values());
+        values.sort(null);
+        modelValues.sort(null);
+        Zoo.check(values.equals(modelValues), () -> where + ": values " + values + " vs " + modelValues);
+        for (var e : model.entrySet()) {
+            if (!Known.ENTRY_SET_CONTAINS_TESTS_KEYS) {
+                Zoo.check(m.entrySet().contains(java.util.Map.entry(e.getKey(), e.getValue())), () -> where + ": entrySet lacks " + e);
+                Zoo.check(!m.entrySet().contains((Object) e.getKey()), () -> where + ": entrySet contains the bare key " + e.getKey());
+            }
+            Zoo.check(!m.entrySet().contains(java.util.Map.entry(e.getKey(), e.getValue() + 10)), () -> where + ": entrySet contains a wrong value for " + e.getKey());
+        }
+        // iterators
+        HashSet<K> keys = new HashSet<>();
+        int nk = Keys.count(m.keyIterator(), model.size() + 1);
+        m.keyIterator().forEachRemaining(keys::add);
+        Zoo.check(nk == model.size() && keys.equals(model.keySet()), () -> where + ": keyIterator " + keys + " (" + nk + ")");
+        int nv = Keys.count(m.valueIterator(), model.size() + 1);
+        Zoo.check(nv == model.size(), () -> where + ": valueIterator yields " + nv);
+        HashMap<K, Integer> seen = new HashMap<>();
+        int ne = 0;
+        for (Iterator<java.util.Map.Entry<K, Integer>> it = m.entryIterator(); it.hasNext() && ne <= model.size() + 1; ne++) {
+            var e = it.next();
+            seen.put(e.getKey(), e.getValue());
+        }
+        int count = ne;
+        Zoo.check(count == model.size() && seen.equals(model), () -> where + ": entryIterator " + seen + " (" + count + ")");
+    }
+
+    @Test
+    void immutableMapsAgreeWithHashMap() {
+        Zoo.property("capsule map: immutable operations agree with HashMap", tc -> {
+            Domain d = Keys.domain(tc);
+            Start start = Zoo.pick(tc, Start.values());
+            HashMap<K, Integer> model = new HashMap<>();
+            for (K k : Keys.list(tc, d, 30)) {
+                model.put(k, value(tc));
+            }
+            Map.Immutable<K, Integer> m = build(start, model);
+            agree("start " + start + " " + d, m, model, d);
+            int steps = Zoo.n(tc, 1, 25);
+            for (int i = 0; i < steps; i++) {
+                Map.Immutable<K, Integer> before = m;
+                HashMap<K, Integer> beforeModel = new HashMap<>(model);
+                String op;
+                switch (Zoo.n(tc, 0, 6)) {
+                    case 0, 1, 2 -> {
+                        K k = d.key(tc);
+                        Integer v = value(tc);
+                        op = "put " + k + "=" + v;
+                        m = m.__put(k, v);
+                        model.put(k, v);
+                    }
+                    case 3, 4 -> {
+                        K k = d.key(tc);
+                        op = "remove " + k;
+                        m = m.__remove(k);
+                        model.remove(k);
+                    }
+                    case 5 -> {
+                        HashMap<K, Integer> other = new HashMap<>();
+                        for (K k : Keys.list(tc, d, 10)) {
+                            other.put(k, value(tc));
+                        }
+                        op = "putAll " + other;
+                        m = m.__putAll(Zoo.chance(tc, 50) ? other : build(Zoo.pick(tc, Start.values()), other));
+                        model.putAll(other);
+                    }
+                    default -> {
+                        Map.Immutable<K, Integer> copy = build(Zoo.pick(tc, Start.values()), model);
+                        Map.Immutable<K, Integer> cur = m;
+                        Zoo.check(cur.equals(copy) && copy.equals(cur) && cur.hashCode() == copy.hashCode(),
+                                () -> "copy of " + model + " differs: " + cur + " vs " + copy);
+                        op = "putAll self";
+                        m = m.__putAll(m);
+                    }
+                }
+                final String where = "after " + op + " on " + beforeModel + " (" + start + ", " + d + ")";
+                agree(where, m, model, d);
+                agree("previous version " + where, before, beforeModel, d);
+            }
+            Map.Immutable<K, Integer> fin = m;
+            if (fin.isTransientSupported()) {
+                Map.Transient<K, Integer> t = fin.asTransient();
+                agree("asTransient of " + model, t, model, d);
+                Map.Immutable<K, Integer> frozen = t.freeze();
+                agree("freeze of asTransient of " + model, frozen, model, d);
+                Zoo.check(frozen.equals(fin) && fin.equals(frozen), () -> "frozen copy differs from original: " + frozen + " vs " + fin);
+            }
+            if (m instanceof java.io.Serializable) {
+                Map.Immutable<K, Integer> back = Keys.roundTrip(m);
+                agree("deserialized " + model, back, model, d);
+            }
+        });
+    }
+
+    @Test
+    void transientMapsAgreeWithHashMap() {
+        Zoo.property("capsule map: transient operations agree with HashMap", tc -> {
+            Domain d = Keys.domain(tc);
+            Start start = Zoo.pick(tc, Start.values());
+            HashMap<K, Integer> baseModel = new HashMap<>();
+            for (K k : Keys.list(tc, d, 30)) {
+                baseModel.put(k, value(tc));
+            }
+            Map.Immutable<K, Integer> base = build(start, baseModel);
+            if (!base.isTransientSupported()) {
+                return;
+            }
+            Map.Transient<K, Integer> t = base.asTransient();
+            HashMap<K, Integer> model = new HashMap<>(baseModel);
+            int steps = Zoo.n(tc, 1, 40);
+            for (int i = 0; i < steps; i++) {
+                HashMap<K, Integer> beforeModel = new HashMap<>(model);
+                String op;
+                switch (Zoo.n(tc, 0, 5)) {
+                    case 0, 1, 2 -> {
+                        K k = d.key(tc);
+                        Integer v = value(tc);
+                        op = "put " + k + "=" + v;
+                        Integer old = t.__put(k, v);
+                        Integer expected = model.put(k, v);
+                        // known bug: an unchanged mapping returns null from a hash-collision node
+                        boolean tolerated = Known.PUT_OF_EQUAL_VALUE_RETURNS_NULL_IN_COLLISION_NODES && old == null && v.equals(expected);
+                        Zoo.check(tolerated || Objects.equals(old, expected), () -> "transient put " + k + "=" + v + " on " + beforeModel + " returned " + old + ", expected " + expected);
+                    }
+                    case 3, 4 -> {
+                        K k = d.key(tc);
+                        op = "remove " + k;
+                        Integer old = t.__remove(k);
+                        Integer expected = model.remove(k);
+                        Zoo.check(Objects.equals(old, expected), () -> "transient remove " + k + " on " + beforeModel + " returned " + old + ", expected " + expected);
+                    }
+                    default -> {
+                        HashMap<K, Integer> other = new HashMap<>();
+                        for (K k : Keys.list(tc, d, 10)) {
+                            other.put(k, value(tc));
+                        }
+                        op = "putAll " + other;
+                        boolean changed = t.__putAll(other);
+                        boolean expected = !model.entrySet().containsAll(other.entrySet());
+                        model.putAll(other);
+                        // known bug: re-putting an equal mapping counts as a modification
+                        boolean tolerated = Known.PUT_ALL_COUNTS_UNCHANGED_MAPPINGS && changed && !expected;
+                        Zoo.check(tolerated || changed == expected, () -> "transient putAll " + other + " on " + beforeModel + " returned " + changed + ", expected " + expected);
+                    }
+                }
+                final String where = "transient after " + op + " on " + beforeModel + " (" + start + ", " + d + ")";
+                agree(where, t, model, d);
+                agree("base of " + where, base, baseModel, d);
+            }
+            Map.Immutable<K, Integer> frozen = t.freeze();
+            agree("frozen " + model, frozen, model, d);
+            Map.Immutable<K, Integer> rebuilt = build(start, model);
+            Zoo.check(frozen.equals(rebuilt) && rebuilt.equals(frozen) && frozen.hashCode() == rebuilt.hashCode(),
+                    () -> "frozen " + frozen + " differs from rebuilt " + rebuilt + " (" + start + ", " + d + ")");
+        });
+    }
+}
