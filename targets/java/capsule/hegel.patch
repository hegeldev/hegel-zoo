+package zoo;
+
+import io.usethesource.capsule.Map;
+import io.usethesource.capsule.Set;
+import io.usethesource.capsule.SetMultimap;
+import io.usethesource.capsule.core.PersistentBidirectionalTrieSetMultimap;
+import io.usethesource.capsule.core.PersistentTrieMap;
+import io.usethesource.capsule.core.PersistentTrieSet;
+import io.usethesource.capsule.core.PersistentTrieSetMultimap;
+import io.usethesource.capsule.util.collection.AbstractSpecialisedImmutableMap;
+import io.usethesource.capsule.util.collection.AbstractSpecialisedImmutableSet;
+import io.usethesource.capsule.util.iterator.SupplierIterator;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.NoSuchElementException;
+import org.junit.jupiter.api.Test;
+import zoo.Keys.Domain;
+import zoo.Keys.K;
+
+/**
+ * The java.util contracts around the collections: iterators end with {@link NoSuchElementException}, the
+ * immutable views refuse mutation with {@link UnsupportedOperationException}, null keys and values are refused
+ * atomically, the factories agree with the builders, and frozen transients refuse every mutator.
+ */
+class MiscTest {
+
+    /** Every kind of collection holding {@code keys}, as (name, collection, expected elements of its main iterator). */
+    record Kind(String name, Iterable<?> collection, HashSet<?> expected, Iterator<?> keyIterator) {}
+
+    static List<Kind> kinds(HashSet<K> keys) {
+        List<Kind> out = new ArrayList<>();
+        Set.Immutable<K> trie = SetTest.build(SetTest.Start.TRIE, keys);
+        Set.Immutable<K> spec = SetTest.build(SetTest.Start.SPECIALISED, keys);
+        out.add(new Kind("trie set", trie, keys, trie.keyIterator()));
+        out.add(new Kind("specialised set", spec, keys, spec.keyIterator()));
+        out.add(new Kind("transient set", trie.asTransient(), keys, trie.asTransient().keyIterator()));
+        HashMap<K, Integer> entries = new HashMap<>();
+        for (K k : keys) {
+            entries.put(k, k.v);
+        }
+        Map.Immutable<K, Integer> tmap = MapTest.build(MapTest.Start.TRIE, entries);
+        Map.Immutable<K, Integer> smap = MapTest.build(MapTest.Start.SPECIALISED, entries);
+        out.add(new Kind("trie map keySet", tmap.keySet(), keys, tmap.keyIterator()));
+        out.add(new Kind("specialised map keySet", smap.keySet(), keys, smap.keyIterator()));
+        out.add(new Kind("trie map values", tmap.values(), new HashSet<>(entries.values()), tmap.valueIterator()));
+        out.add(new Kind("specialised map values", smap.values(), new HashSet<>(entries.values()), smap.valueIterator()));
+        out.add(new Kind("transient map keySet", tmap.asTransient().keySet(), keys, tmap.asTransient().keyIterator()));
+        List<java.util.Map.Entry<K, K>> tuples = new ArrayList<>();
+        for (K k : keys) {
+            tuples.add(java.util.Map.entry(k, k));
+        }
+        SetMultimap.Immutable<K, K> mm = MultimapTest.build(MultimapTest.Start.MULTIMAP, tuples);
+        SetMultimap.Immutable<K, K> rel = MultimapTest.build(MultimapTest.Start.RELATION, tuples);
+        out.add(new Kind("multimap keySet", mm.keySet(), keys, mm.keyIterator()));
+        out.add(new Kind("multimap values", mm.values(), keys, mm.valueIterator()));
+        out.add(new Kind("relation keySet", rel.keySet(), keys, rel.keyIterator()));
+        out.add(new Kind("transient multimap keySet", mm.asTransient().keySet(), keys, mm.asTransient().keyIterator()));
+        return out;
+    }
+
+    static void exhaust(String where, Iterator<?> it, HashSet<?> expected, boolean specialised) {
+        HashSet<Object> seen = new HashSet<>();
+        int n = 0;
+        while (n <= expected.size() && it.hasNext()) {
+            seen.add(it.next());
+            n++;
+        }
+        int count = n;
+        Zoo.check(count == expected.size() && seen.equals(expected), () -> where + ": yields " + seen + " (" + count + ") vs " + expected);
+        Zoo.check(!it.hasNext(), () -> where + ": hasNext() true after " + count + " elements");
+        if (specialised && Known.SPECIALISED_ITERATORS_THROW_ILLEGAL_STATE) {
+            return;
+        }
+        try {
+            Object extra = it.next();
+            Zoo.fail(where + ": next() past the end returned " + extra);
+        } catch (NoSuchElementException e) {
+            // the contract
+        } catch (RuntimeException e) {
+            Zoo.rethrowStop(e);
+            Zoo.fail(where + ": next() past the end threw " + e.getClass().getSimpleName() + " instead of NoSuchElementException");
+        }
+    }
+
+    @Test
+    void iteratorsYieldTheElementsThenEnd() {
+        Zoo.property("capsule iterators: every collection's iterators yield exactly its elements and then throw NoSuchElementException", tc -> {
+            Domain d = Keys.domain(tc);
+            HashSet<K> keys = Keys.subset(tc, d, Zoo.pick(tc, 0, 1, 2, 3, 4, 5, 6, 12, 40));
+            for (Kind kind : kinds(keys)) {
+                boolean specialised = kind.name().startsWith("specialised") && keys.size() <= 5;
+                exhaust(kind.name() + " iterator of " + keys, kind.collection().iterator(), kind.expected(), specialised);
+                exhaust(kind.name() + " key/value iterator of " + keys, kind.keyIterator(), kind.expected(), specialised);
+                int viaForEach = 0;
+                for (Object ignored : kind.collection()) {
+                    viaForEach++;
+                }
+                int fe = viaForEach;
+                Zoo.check(fe == kind.expected().size(), () -> kind.name() + " for-each visits " + fe + " of " + keys);
+            }
+            // specialised map key iterators are SupplierIterators: get() is the value of the last key
+            HashMap<K, Integer> entries = new HashMap<>();
+            for (K k : keys) {
+                entries.put(k, k.v);
+            }
+            Map.Immutable<K, Integer> smap = MapTest.build(MapTest.Start.SPECIALISED, entries);
+            if (!Known.SPECIALISED_SUPPLIER_ITERATOR_GET_IS_DEAD && smap.keyIterator() instanceof SupplierIterator<?, ?> si) {
+                while (si.hasNext()) {
+                    Object k = si.next();
+                    Object v = si.get();
+                    Zoo.check(entries.get(k).equals(v), () -> "SupplierIterator.get() after " + k + " = " + v + " for " + entries);
+                }
+            }
+        });
+    }
+
+    @Test
+    void immutableViewsRefuseMutation() {
+        Zoo.property("capsule immutables: java.util mutators throw UnsupportedOperationException and leave the collection alone", tc -> {
+            Domain d = Keys.domain(tc);
+            HashSet<K> keys = Keys.subset(tc, d, Zoo.pick(tc, 1, 3, 5, 12));
+            keys.add(d.key(tc));
+            K extra = d.of(d.universe + 1);
+            for (SetTest.Start start : SetTest.Start.values()) {
+                Set.Immutable<K> s = SetTest.build(start, keys);
+                for (var op : List.<java.util.function.Consumer<Set.Immutable<K>>>of(
+                        x -> x.add(extra), x -> x.remove(keys.iterator().next()), x -> x.clear(), x -> x.addAll(List.of(extra)),
+                        x -> x.removeAll(keys), x -> x.retainAll(List.of()), x -> x.removeIf(k -> true),
+                        x -> { Iterator<K> it = x.iterator(); it.next(); it.remove(); })) {
+                    Zoo.check(Zoo.throwsA(UnsupportedOperationException.class, () -> op.accept(s)), () -> start + " set mutator did not throw UnsupportedOperationException");
+                    Zoo.check(s.equals(keys), () -> start + " set changed by a refused mutator: " + s + " vs " + keys);
+                }
+            }
+            HashMap<K, Integer> entries = new HashMap<>();
+            for (K k : keys) {
+                entries.put(k, k.v);
+            }
+            for (MapTest.Start start : MapTest.Start.values()) {
+                Map.Immutable<K, Integer> m = MapTest.build(start, entries);
+                K first = keys.iterator().next();
+                for (var op : List.<java.util.function.Consumer<Map.Immutable<K, Integer>>>of(
+                        x -> x.put(extra, 1), x -> x.remove(first), x -> x.clear(), x -> x.putAll(java.util.Map.of(extra, 1)),
+                        x -> x.putIfAbsent(extra, 1), x -> x.merge(first, 1, Integer::sum), x -> x.compute(first, (k, v) -> 9),
+                        x -> x.keySet().remove(first), x -> x.values().clear(), x -> x.entrySet().clear(),
+                        x -> x.entrySet().iterator().next().setValue(9), x -> x.replaceAll((k, v) -> 0))) {
+                    Zoo.check(Zoo.throwsA(UnsupportedOperationException.class, () -> op.accept(m)), () -> start + " map mutator did not throw UnsupportedOperationException");
+                    Zoo.check(m.equals(entries), () -> start + " map changed by a refused mutator: " + m + " vs " + entries);
+                }
+            }
+        });
+    }
+
+    @Test
+    void nullsAreRefusedAtomically() {
+        Zoo.property("capsule: null keys and values are refused with NullPointerException and leave the collection unchanged", tc -> {
+            Domain d = Keys.domain(tc);
+            HashSet<K> keys = Keys.subset(tc, d, 12);
+            HashMap<K, Integer> entries = new HashMap<>();
+            for (K k : keys) {
+                entries.put(k, k.v);
+            }
+            Set.Immutable<K> s = SetTest.build(SetTest.Start.TRIE, keys);
+            Zoo.check(Zoo.throwsA(NullPointerException.class, () -> s.__insert(null)), () -> "trie set __insert(null) did not throw NullPointerException");
+            Zoo.check(s.equals(keys), () -> "trie set changed by __insert(null)");
+            Map.Immutable<K, Integer> m = MapTest.build(MapTest.Start.TRIE, entries);
+            Zoo.check(Zoo.throwsA(NullPointerException.class, () -> m.__put(null, 1)), () -> "trie map __put(null, 1) did not throw NullPointerException");
+            K k = keys.isEmpty() ? d.of(0) : keys.iterator().next();
+            Zoo.check(Zoo.throwsA(NullPointerException.class, () -> m.__put(k, null)), () -> "trie map __put(k, null) did not throw NullPointerException");
+            Zoo.check(m.equals(entries), () -> "trie map changed by a refused put: " + m);
+            Map.Transient<K, Integer> t = m.asTransient();
+            Zoo.check(Zoo.throwsA(NullPointerException.class, () -> t.__put(null, 1)), () -> "transient map __put(null, 1) did not throw NullPointerException");
+            Zoo.check(t.equals(entries) && t.size() == entries.size(), () -> "transient map changed by __put(null, 1): " + t);
+            if (!Known.TRANSIENT_PUT_OF_NULL_POISONS_THE_MAP) {
+                Zoo.check(Zoo.throwsA(NullPointerException.class, () -> t.__put(k, null)), () -> "transient map __put(k, null) did not throw NullPointerException");
+                Zoo.check(t.equals(entries) && t.size() == entries.size() && java.util.Objects.equals(t.get(k), entries.get(k)),
+                        () -> "transient map changed by the refused __put(" + k + ", null): " + t);
+            }
+            SetMultimap.Immutable<K, K> mm = PersistentTrieSetMultimap.of();
+            Zoo.check(Zoo.throwsA(NullPointerException.class, () -> mm.__insert(k, (K) null)), () -> "multimap __insert(k, null) did not throw NullPointerException");
+            Zoo.check(Zoo.throwsA(NullPointerException.class, () -> mm.__insert((K) null, k)), () -> "multimap __insert(null, v) did not throw NullPointerException");
+        });
+    }
+
+    @Test
+    void factoriesAgreeWithTheBuilders() {
+        Zoo.property("capsule factories: of(...)/setOf(...)/mapOf(...)/transientOf(...) build what the insert chain builds", tc -> {
+            Domain d = Keys.domain(tc);
+            List<K> xs = Keys.list(tc, d, 6);
+            HashSet<K> distinct = new HashSet<>(xs);
+            Set.Immutable<K> expected = SetTest.build(SetTest.Start.TRIE, distinct);
+            K[] arr = xs.toArray(new K[0]);
