+package zoo;
+
+import io.usethesource.capsule.BinaryRelation;
+import io.usethesource.capsule.Set;
+import io.usethesource.capsule.SetMultimap;
+import io.usethesource.capsule.core.PersistentBidirectionalTrieSetMultimap;
+import io.usethesource.capsule.core.PersistentTrieSet;
+import io.usethesource.capsule.core.PersistentTrieSetMultimap;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import org.junit.jupiter.api.Test;
+import zoo.Keys.Domain;
+import zoo.Keys.K;
+
+/**
+ * Capsule's set-multimaps ({@link PersistentTrieSetMultimap}, keys mapped to sets of values with the
+ * singleton/set heterogeneous payload) and the bidirectional binary relation
+ * ({@link PersistentBidirectionalTrieSetMultimap}) against a {@code HashMap<K, HashSet<V>>} model under the same
+ * operation script, immutably and through transients; the relation's {@code inverse()} against the inverted
+ * model.
+ */
+class MultimapTest {
+
+    /** The model: keys to non-empty value sets. */
+    static final class Model {
+        final HashMap<K, HashSet<K>> m = new HashMap<>();
+
+        Model() {}
+
+        Model(Model o) {
+            for (var e : o.m.entrySet()) {
+                m.put(e.getKey(), new HashSet<>(e.getValue()));
+            }
+        }
+
+        boolean insert(K k, K v) {
+            return m.computeIfAbsent(k, x -> new HashSet<>()).add(v);
+        }
+
+        void put(K k, java.util.Collection<K> vs) {
+            m.remove(k);
+            for (K v : vs) {
+                insert(k, v);
+            }
+        }
+
+        boolean remove(K k) {
+            return m.remove(k) != null;
+        }
+
+        boolean remove(K k, K v) {
+            HashSet<K> vs = m.get(k);
+            if (vs == null || !vs.remove(v)) {
+                return false;
+            }
+            if (vs.isEmpty()) {
+                m.remove(k);
+            }
+            return true;
+        }
+
+        int size() {
+            int n = 0;
+            for (HashSet<K> vs : m.values()) {
+                n += vs.size();
+            }
+            return n;
+        }
+
+        HashSet<K> get(K k) {
+            HashSet<K> vs = m.get(k);
+            return vs == null ? new HashSet<>() : vs;
+        }
+
+        boolean contains(K k, K v) {
+            return get(k).contains(v);
+        }
+
+        HashSet<Map.Entry<K, K>> tuples() {
+            HashSet<Map.Entry<K, K>> t = new HashSet<>();
+            for (var e : m.entrySet()) {
+                for (K v : e.getValue()) {
+                    t.add(Map.entry(e.getKey(), v));
+                }
+            }
+            return t;
+        }
+
+        Model inverse() {
+            Model inv = new Model();
+            for (var e : m.entrySet()) {
+                for (K v : e.getValue()) {
+                    inv.insert(v, e.getKey());
+                }
+            }
+            return inv;
+        }
+
+        @Override
+        public String toString() {
+            return m.toString();
+        }
+    }
+
+    enum Start { MULTIMAP, RELATION }
+
+    static SetMultimap.Immutable<K, K> empty(Start start) {
+        return start == Start.MULTIMAP ? PersistentTrieSetMultimap.of() : PersistentBidirectionalTrieSetMultimap.of();
+    }
+
+    /** A multimap of the given kind holding the model's tuples, inserted in the order given. */
+    static SetMultimap.Immutable<K, K> build(Start start, List<Map.Entry<K, K>> tuples) {
+        SetMultimap.Immutable<K, K> mm = empty(start);
+        for (var t : tuples) {
+            mm = mm.__insert(t.getKey(), t.getValue());
+        }
+        return mm;
+    }
+
+    static Set.Immutable<K> setOf(java.util.Collection<K> vs) {
+        Set.Immutable<K> s = PersistentTrieSet.of();
+        for (K v : vs) {
+            s = s.__insert(v);
+        }
+        return s;
+    }
+
+    static void agree(String where, SetMultimap<K, K> mm, Model model, Domain dk, Domain dv) {
+        int size = model.size();
+        Zoo.check(mm.size() == size, () -> where + ": size " + mm.size() + " vs model " + size + " " + model);
+        Zoo.check(mm.sizeDistinct() == model.m.size(), () -> where + ": sizeDistinct " + mm.sizeDistinct() + " vs " + model.m.size());
+        Zoo.check(mm.isEmpty() == (size == 0), () -> where + ": isEmpty " + mm.isEmpty());
+        for (var e : model.m.entrySet()) {
+            K k = e.getKey();
+            Zoo.check(mm.containsKey(k), () -> where + ": key " + k + " missing");
+            Set.Immutable<K> got = mm.get(k);
+            Zoo.check(got != null && got.equals(e.getValue()) && e.getValue().equals(got), () -> where + ": get(" + k + ") = " + got + " vs " + e.getValue());
+            for (K v : e.getValue()) {
+                Zoo.check(mm.containsEntry(k, v), () -> where + ": tuple " + k + "->" + v + " missing");
+            }
+            for (int i = 0; i < Math.min(dv.universe, 16); i++) {
+                K v = dv.of(i);
+                if (!e.getValue().contains(v)) {
+                    Zoo.check(!mm.containsEntry(k, v), () -> where + ": tuple " + k + "->" + v + " reported present");
+                }
+            }
+        }
+        for (int i = 0; i < Math.min(dk.universe, 64); i++) {
+            K k = dk.of(i);
+            if (!model.m.containsKey(k)) {
+                Zoo.check(!mm.containsKey(k), () -> where + ": absent key " + k + " reported present");
+                Set.Immutable<K> got = mm.get(k);
+                Zoo.check(got != null && got.isEmpty(), () -> where + ": get(absent " + k + ") = " + got);
+            }
+        }
+        HashSet<K> allValues = new HashSet<>();
+        model.m.values().forEach(allValues::addAll);
+        for (int i = 0; i < Math.min(dv.universe, 16); i++) {
+            K v = dv.of(i);
+            Zoo.check(mm.containsValue(v) == allValues.contains(v), () -> where + ": containsValue(" + v + ") = " + mm.containsValue(v));
+        }
+        // views
+        Zoo.check(mm.keySet().equals(model.m.keySet()) && model.m.keySet().equals(mm.keySet()), () -> where + ": keySet " + mm.keySet() + " vs " + model.m.keySet());
+        Zoo.check(mm.keySet().size() == model.m.size(), () -> where + ": keySet size " + mm.keySet().size());
+        Zoo.check(mm.values().size() == size, () -> where + ": values size " + mm.values().size());
+        List<K> values = new ArrayList<>(mm.values());
+        Zoo.check(values.size() == size && allValues.containsAll(values), () -> where + ": values " + values);
+        Zoo.check(mm.entrySet().size() == size, () -> where + ": entrySet size " + mm.entrySet().size());
+        HashSet<Map.Entry<K, K>> tuples = model.tuples();
+        HashSet<Map.Entry<K, K>> entries = new HashSet<>();
+        int n = 0;
+        for (Iterator<Map.Entry<K, K>> it = mm.entrySet().iterator(); it.hasNext() && n <= size + 1; n++) {
+            var e = it.next();
+            entries.add(Map.entry(e.getKey(), e.getValue()));
+        }
+        int count = n;
+        Zoo.check(count == size && entries.equals(tuples), () -> where + ": entrySet iteration " + entries + " (" + count + ") vs " + tuples);
+        if (!Known.ENTRY_SET_CONTAINS_TESTS_KEYS) {
+            for (var t : tuples) {
+                Zoo.check(mm.entrySet().contains(t), () -> where + ": entrySet.contains(" + t + ") false");
+            }
+        }
+        // iterators
+        HashSet<K> keys = new HashSet<>();
+        int nk = Keys.count(mm.keyIterator(), model.m.size() + 1);
+        mm.keyIterator().forEachRemaining(keys::add);
+        Zoo.check(nk == model.m.size() && keys.equals(model.m.keySet()), () -> where + ": keyIterator " + keys + " (" + nk + ")");
+        int nv = Keys.count(mm.valueIterator(), size + 1);
+        Zoo.check(nv == size, () -> where + ": valueIterator yields " + nv + ", size " + size);
+        HashSet<Map.Entry<K, K>> seen = new HashSet<>();
+        int ne = 0;
+        for (Iterator<Map.Entry<K, K>> it = mm.entryIterator(); it.hasNext() && ne <= size + 1; ne++) {
+            var e = it.next();
+            seen.add(Map.entry(e.getKey(), e.getValue()));
+        }
+        int ce = ne;
+        Zoo.check(ce == size && seen.equals(tuples), () -> where + ": entryIterator " + seen + " (" + ce + ") vs " + tuples);
+        HashSet<Map.Entry<K, K>> seenT = new HashSet<>();
+        int nt = Keys.count(mm.tupleIterator(Map::entry), size + 1);
+        mm.tupleIterator(Map::entry).forEachRemaining(seenT::add);
+        Zoo.check(nt == size && seenT.equals(tuples), () -> where + ": tupleIterator " + seenT + " (" + nt + ")");
+        long streamed = mm.tupleStream(Map::entry).count();
+        Zoo.check(streamed == size, () -> where + ": tupleStream count " + streamed);
+        // equality and hash against the same tuples inserted in another order and kind
+        List<Map.Entry<K, K>> reversed = new ArrayList<>(tuples);
+        java.util.Collections.reverse(reversed);
+        for (Start other : Start.values()) {
+            SetMultimap.Immutable<K, K> fresh = build(other, reversed);
+            Zoo.check(mm.equals(fresh), () -> where + ": not equal to a fresh " + other + " with the same tuples: " + mm + " vs " + fresh);
+            Zoo.check(fresh.equals(mm), () -> where + ": fresh " + other + " not equal to it: " + fresh + " vs " + mm);
+            Zoo.check(mm.hashCode() == fresh.hashCode(), () -> where + ": hashCode " + mm.hashCode() + " vs fresh " + other + " " + fresh.hashCode());
+        }
+        if (size > 0) {
+            var t = tuples.iterator().next();
+            SetMultimap.Immutable<K, K> less = build(Start.MULTIMAP, reversed).__remove(t.getKey(), t.getValue());
+            Zoo.check(!mm.equals(less) && !less.equals(mm), () -> where + ": equal to a multimap lacking " + t + ": " + less);
+        }
+    }
+
+    static K value(dev.hegel.TestCase tc, Domain dv) {
+        return dv.key(tc);
+    }
+
+    @Test
+    void immutableMultimapsAgreeWithTheModel() {
+        Zoo.property("capsule multimap: immutable operations agree with a HashMap-of-HashSet model", tc -> {
+            Domain dk = Keys.domain(tc);
+            Domain dv = new Domain(Zoo.pick(tc, Keys.Shape.values()), Zoo.pick(tc, 2, 3, 6, 20));
+            Start start = Zoo.pick(tc, Start.values());
+            Model model = new Model();
+            List<Map.Entry<K, K>> initial = new ArrayList<>();
+            int n0 = Zoo.n(tc, 0, 25);
+            for (int i = 0; i < n0; i++) {
+                K k = dk.key(tc);
+                K v = value(tc, dv);
+                initial.add(Map.entry(k, v));
+                model.insert(k, v);
+            }
+            SetMultimap.Immutable<K, K> mm = build(start, initial);
+            agree("start " + start + " " + dk + " " + dv, mm, model, dk, dv);
+            int steps = Zoo.n(tc, 1, 20);
+            for (int i = 0; i < steps; i++) {
+                SetMultimap.Immutable<K, K> before = mm;
+                Model beforeModel = new Model(model);
+                String op;
+                switch (Zoo.n(tc, 0, 9)) {
+                    case 0, 1, 2 -> {
+                        K k = dk.key(tc);
+                        K v = value(tc, dv);
+                        op = "insert " + k + "->" + v;
+                        mm = mm.__insert(k, v);
+                        model.insert(k, v);
+                    }
+                    case 3 -> {
+                        K k = dk.key(tc);
+                        HashSet<K> vs = Keys.subset(tc, dv, 4);
+                        if (Known.INSERT_SET_ONTO_SINGLETON_UNDERCOUNTS && model.get(k).size() == 1 && vs.size() >= 2) {
+                            vs = new HashSet<>(List.of(vs.iterator().next()));
+                        }
+                        op = "insert " + k + "->" + vs;
+                        mm = mm.__insert(k, setOf(vs));
+                        vs.forEach(v -> model.insert(k, v));
+                    }
+                    case 4 -> {
+                        HashSet<K> ks = Keys.subset(tc, dk, 4);
+                        K v = value(tc, dv);
+                        op = "insert " + ks + "->" + v;
+                        mm = mm.__insert(setOf(ks), v);
+                        ks.forEach(k -> model.insert(k, v));
+                    }
+                    case 5 -> {
+                        K k = dk.key(tc);
+                        K v = value(tc, dv);
+                        op = "put " + k + "->" + v;
+                        if (start == Start.RELATION && Known.RELATION_PUT_DESYNCS_INVERSE) {
+                            // known bug: the relation's __put(k, v) puts into the inverse as well and desynchronises it
+                            op = "skipped put";
+                        } else {
+                            mm = mm.__put(k, v);
+                            model.put(k, List.of(v));
+                        }
+                    }
+                    case 6 -> {
+                        K k = dk.key(tc);
+                        HashSet<K> vs = Keys.subset(tc, dv, 4);
+                        op = "put " + k + "->" + vs;
+                        if (start == Start.RELATION) {
+                            SetMultimap.Immutable<K, K> cur = mm;
+                            Zoo.check(Zoo.throwsA(UnsupportedOperationException.class, () -> cur.__put(k, setOf(vs))), () -> "relation __put(k, set) did not throw UnsupportedOperationException");
+                        } else {
+                            mm = mm.__put(k, setOf(vs));
+                            model.put(k, vs);
+                        }
+                    }
+                    case 7 -> {
+                        K k = dk.key(tc);
+                        op = "remove " + k;
+                        if (start == Start.RELATION) {
+                            // no Map semantics on the immutable relation: __remove(key) throws UnsupportedOperationException
+                            SetMultimap.Immutable<K, K> cur = mm;
+                            Zoo.check(Zoo.throwsA(UnsupportedOperationException.class, () -> cur.__remove(k)), () -> "relation __remove(k) did not throw UnsupportedOperationException");
+                        } else {
+                            mm = mm.__remove(k);
+                            model.remove(k);
+                        }
+                    }
+                    case 8 -> {
+                        K k = dk.key(tc);
+                        K v = value(tc, dv);
+                        op = "remove " + k + "->" + v;
+                        mm = mm.__remove(k, v);
+                        model.remove(k, v);
+                    }
+                    default -> {
+                        // complement: the tuples of another multimap that are not in this one
+                        Model other = new Model();
+                        List<Map.Entry<K, K>> ts = new ArrayList<>();
+                        int n = Zoo.n(tc, 0, 8);
+                        for (int j = 0; j < n; j++) {
+                            K k = dk.key(tc);
+                            K v = value(tc, dv);
+                            ts.add(Map.entry(k, v));
+                            other.insert(k, v);
+                        }
+                        op = "complement of " + other;
+                        SetMultimap.Immutable<K, K> c = mm.complement(build(Zoo.pick(tc, Start.values()), ts));
+                        Model expected = new Model();
+                        for (var t : other.tuples()) {
+                            if (!model.contains(t.getKey(), t.getValue())) {
+                                expected.insert(t.getKey(), t.getValue());
+                            }
+                        }
+                        agree("complement of " + other + " against " + model, c, expected, dk, dv);
+                    }
+                }
+                final String where = "after " + op + " on " + beforeModel + " (" + start + ", " + dk + ", " + dv + ")";
+                agree(where, mm, model, dk, dv);
+                agree("previous version " + where, before, beforeModel, dk, dv);
+                if (mm instanceof BinaryRelation.Immutable<K, K> rel) {
+                    BinaryRelation.Immutable<K, K> inv = rel.inverse();
+                    agree("inverse " + where, inv, model.inverse(), dv, dk);
+                    BinaryRelation.Immutable<K, K> back = inv.inverse();
+                    Zoo.check(back.equals(rel) && rel.equals(back) && back.hashCode() == rel.hashCode(),
+                            () -> "inverse of inverse differs " + where + ": " + back + " vs " + rel);
+                    agree("toSetMultimap " + where, rel.toSetMultimap(), model, dk, dv);
+                }
+            }
+            SetMultimap.Immutable<K, K> fin = mm;
+            if (fin.isTransientSupported()) {
+                SetMultimap.Transient<K, K> t = fin.asTransient();
+                agree("asTransient of " + model, t, model, dk, dv);
+                SetMultimap.Immutable<K, K> frozen = t.freeze();
+                agree("freeze of asTransient of " + model, frozen, model, dk, dv);
+                Zoo.check(frozen.equals(fin) && fin.equals(frozen), () -> "frozen copy differs from original: " + frozen + " vs " + fin);
+            }
+            if (fin instanceof java.io.Serializable) {
+                SetMultimap.Immutable<K, K> back = Keys.roundTrip(fin);
+                agree("deserialized " + model, back, model, dk, dv);
+            }
+        });
+    }
+
+    @Test
+    void transientMultimapsAgreeWithTheModel() {
+        Zoo.property("capsule multimap: transient operations agree with the model", tc -> {
+            Domain dk = Keys.domain(tc);
+            Domain dv = new Domain(Zoo.pick(tc, Keys.Shape.values()), Zoo.pick(tc, 2, 3, 6, 20));
+            Start start = Zoo.pick(tc, Start.values());
+            Model baseModel = new Model();
+            List<Map.Entry<K, K>> initial = new ArrayList<>();
+            int n0 = Zoo.n(tc, 0, 25);
+            for (int i = 0; i < n0; i++) {
+                K k = dk.key(tc);
+                K v = value(tc, dv);
+                initial.add(Map.entry(k, v));
+                baseModel.insert(k, v);
+            }
+            SetMultimap.Immutable<K, K> base = build(start, initial);
+            if (!base.isTransientSupported()) {
+                return;
+            }
+            SetMultimap.Transient<K, K> t = base.asTransient();
+            Model model = new Model(baseModel);
+            int steps = Zoo.n(tc, 1, 30);
+            List<String> history = new ArrayList<>();
+            for (int i = 0; i < steps; i++) {
+                Model beforeModel = new Model(model);
+                String op;
+                boolean changed;
+                boolean expected;
+                switch (Zoo.n(tc, 0, start == Start.RELATION ? 5 : 7)) {
+                    case 0, 1, 2 -> {
+                        K k = dk.key(tc);
+                        K v = value(tc, dv);
+                        op = "insert " + k + "->" + v;
+                        changed = t.__insert(k, v);
+                        expected = model.insert(k, v);
+                    }
+                    case 3 -> {
+                        K k = dk.key(tc);
+                        HashSet<K> vs = Keys.subset(tc, dv, 4);
+                        if (Known.INSERT_SET_ONTO_SINGLETON_UNDERCOUNTS && model.get(k).size() == 1 && vs.size() >= 2) {
+                            vs = new HashSet<>(List.of(vs.iterator().next()));
+                        }
+                        op = "insert " + k + "->" + vs;
+                        boolean sameSet = vs.equals(model.get(k));
+                        changed = t.__insert(k, setOf(vs));
+                        boolean any = false;
+                        for (K v : vs) {
+                            any |= model.insert(k, v);
+                        }
+                        // known bug (relation only): the interface default reports a change whenever the set differs from the current values
+                        expected = start == Start.RELATION && Known.INSERT_SET_REPORTS_CHANGE_WITHOUT_INSERTING ? !sameSet : any;
+                    }
+                    case 4 -> {
+                        K k = dk.key(tc);
+                        op = "remove " + k;
+                        changed = t.__remove(k);
+                        expected = model.remove(k);
+                    }
+                    case 5 -> {
+                        K k = dk.key(tc);
+                        K v = value(tc, dv);
+                        op = "remove " + k + "->" + v;
+                        changed = t.__remove(k, v);
+                        expected = model.remove(k, v);
+                    }
+                    case 6 -> {
+                        K k = dk.key(tc);
+                        K v = value(tc, dv);
+                        op = "put " + k + "->" + v;
+                        changed = t.__put(k, v);
+                        // known bug: putting the value the key already maps to alone is reported as a change
+                        expected = Known.PUT_OF_SAME_SINGLETON_REPORTS_CHANGE || !model.get(k).equals(new HashSet<>(List.of(v)));
+                        model.put(k, List.of(v));
+                    }
+                    default -> {
+                        K k = dk.key(tc);
+                        HashSet<K> vs = Keys.subset(tc, dv, 4);
+                        op = "put " + k + "->" + vs;
+                        changed = t.__put(k, setOf(vs));
+                        // known bug: putting the values the key already maps to is reported as a change (an empty set removes the key)
+                        expected = vs.isEmpty() ? model.m.containsKey(k) : Known.PUT_OF_SAME_SINGLETON_REPORTS_CHANGE || !model.get(k).equals(vs);
+                        model.put(k, vs);
+                    }
+                }
+                history.add(op);
+                final String where = "transient after " + op + " on " + beforeModel + " (" + start + ", " + dk + ", " + dv + "; from " + baseModel + " via " + history + ")";
+                Zoo.check(changed == expected, () -> where + ": returned " + changed + ", model changed " + expected);
+                agree(where, t, model, dk, dv);
+                agree("base of " + where, base, baseModel, dk, dv);
+                if (t instanceof BinaryRelation.Transient<K, K> rel) {
+                    agree("inverse " + where, rel.inverse(), model.inverse(), dv, dk);
+                }
+            }
+            SetMultimap.Immutable<K, K> frozen = t.freeze();
+            agree("frozen " + model, frozen, model, dk, dv);
+            Zoo.check(Zoo.throwsA(null, () -> t.__insert(dk.of(0), dv.of(0))) || t.size() == model.size(),
+                    () -> "insert on a frozen transient neither threw nor left it alone: " + t);
+        });
+    }
+
+    @Test
+    void multimapsAndMapsOfSetsAgree() {
+        Zoo.property("capsule multimap: get() sets, keySet and the tuple count are consistent with Set/Map built from the same tuples", tc -> {
+            Domain dk = Keys.domain(tc);
+            Domain dv = new Domain(Zoo.pick(tc, Keys.Shape.values()), Zoo.pick(tc, 2, 3, 6, 20));
+            List<Map.Entry<K, K>> tuples = new ArrayList<>();
+            int n0 = Zoo.n(tc, 0, 40);
+            for (int i = 0; i < n0; i++) {
+                tuples.add(Map.entry(dk.key(tc), value(tc, dv)));
+            }
+            SetMultimap.Immutable<K, K> mm = build(Zoo.pick(tc, Start.values()), tuples);
+            io.usethesource.capsule.Map.Immutable<K, Set.Immutable<K>> asMap = io.usethesource.capsule.Map.Immutable.of();
+            Set.Immutable<K> keys = PersistentTrieSet.of();
+            int size = 0;
+            for (var t : tuples) {
+                Set.Immutable<K> vs = asMap.containsKey(t.getKey()) ? asMap.get(t.getKey()) : PersistentTrieSet.of();
+                if (!vs.contains(t.getValue())) {
+                    size++;
+                }
+                asMap = asMap.__put(t.getKey(), vs.__insert(t.getValue()));
+                keys = keys.__insert(t.getKey());
+            }
+            final int total = size;
+            final Set.Immutable<K> fKeys = keys;
+            final io.usethesource.capsule.Map.Immutable<K, Set.Immutable<K>> fMap = asMap;
+            Zoo.check(mm.size() == total, () -> "size " + mm.size() + " vs " + total + " for " + tuples);
+            Zoo.check(mm.keySet().equals(fKeys) && fKeys.equals(mm.keySet()), () -> "keySet " + mm.keySet() + " vs " + fKeys);
+            for (K k : fKeys) {
+                Zoo.check(Objects.equals(mm.get(k), fMap.get(k)), () -> "get(" + k + ") " + mm.get(k) + " vs " + fMap.get(k));
+            }
+            // the collector
+            SetMultimap.Immutable<K, K> collected = tuples.stream()
+                    .collect(io.usethesource.capsule.util.stream.CapsuleCollectors.toSetMultimap(Map.Entry::getKey, Map.Entry::getValue));
+            Zoo.check(collected.equals(mm) && mm.equals(collected) && collected.hashCode() == mm.hashCode(),
+                    () -> "collected " + collected + " differs from built " + mm);
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/SetTest.java b/hegel/src/test/java/zoo/SetTest.java
new file mode 100644
index 0000000..6a98f43
--- /dev/null
+++ b/hegel/src/test/java/zoo/SetTest.java
@@ -0,0 +1,313 @@
+package zoo;
+
+import io.usethesource.capsule.Set;
+import io.usethesource.capsule.core.PersistentTrieSet;
+import io.usethesource.capsule.util.collection.AbstractSpecialisedImmutableSet;
+import io.usethesource.capsule.util.stream.CapsuleCollectors;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+import zoo.Keys.Domain;
+import zoo.Keys.K;
+
+/**
+ * Capsule's persistent sets against {@link HashSet} under the same operation script: the CHAMP trie
+ * ({@link PersistentTrieSet}), the specialised small sets ({@link AbstractSpecialisedImmutableSet}) that
+ * grow into a trie, and the default factory, each driven immutably and through transients.
+ */
+class SetTest {
+
+    enum Start {
+        TRIE(PersistentTrieSet::of), SPECIALISED(AbstractSpecialisedImmutableSet::setOf), DEFAULT(Set.Immutable::of);
+
+        final Supplier<Set.Immutable<K>> make;
+
+        Start(Supplier<Set.Immutable<K>> make) {
+            this.make = make;
+        }
+    }
+
+    /** A set of the given start kind holding exactly {@code keys}. */
+    static Set.Immutable<K> build(Start start, java.util.Collection<K> keys) {
+        Set.Immutable<K> s = start.make.get();
+        for (K k : keys) {
+            s = s.__insert(k);
+        }
+        return s;
+    }
+
+    /** Checks the set against the model completely. */
+    static void agree(String where, Set<K> s, HashSet<K> model, Domain d) {
+        Zoo.check(s.size() == model.size(), () -> where + ": size " + s.size() + " vs model " + model.size() + " " + model);
+        Zoo.check(s.isEmpty() == model.isEmpty(), () -> where + ": isEmpty " + s.isEmpty() + " for " + model);
+        for (K k : model) {
+            Zoo.check(s.contains(k), () -> where + ": member " + k + " not contained in " + s);
+            K got = s.get(k);
+            Zoo.check(k.equals(got), () -> where + ": get(" + k + ") = " + got);
+        }
+        for (int v = 0; v < Math.min(d.universe, 64); v++) {
+            K k = d.of(v);
+            if (!model.contains(k)) {
+                Zoo.check(!s.contains(k), () -> where + ": non-member " + k + " contained in " + s);
+                Zoo.check(s.get(k) == null, () -> where + ": get(non-member " + k + ") = " + s.get(k));
+            }
+        }
+        Zoo.check(s.containsAll(model), () -> where + ": containsAll(model) false");
+        Zoo.check(s.hashCode() == model.hashCode(), () -> where + ": hashCode " + s.hashCode() + " vs model " + model.hashCode() + " " + model);
+        Zoo.check(s.equals(model), () -> where + ": set.equals(HashSet) false: " + s + " vs " + model);
+        Zoo.check(model.equals(s), () -> where + ": HashSet.equals(set) false: " + model + " vs " + s);
+        HashSet<K> seen = new HashSet<>();
+        int n = 0;
+        for (Iterator<K> it = s.iterator(); it.hasNext() && n <= model.size() + 1; n++) {
+            seen.add(it.next());
+        }
+        int count = n;
+        Zoo.check(count == model.size(), () -> where + ": iterator yields " + count + " elements, size " + model.size());
+        Zoo.check(seen.equals(model), () -> where + ": iterator elements " + seen + " vs model " + model);
+        HashSet<K> seen2 = new HashSet<>();
+        int n2 = Keys.count(s.keyIterator(), model.size() + 1);
+        s.keyIterator().forEachRemaining(seen2::add);
+        Zoo.check(n2 == model.size() && seen2.equals(model), () -> where + ": keyIterator yields " + seen2 + " (" + n2 + ")");
+        long streamed = s.stream().count();
+        Zoo.check(streamed == model.size(), () -> where + ": stream().count() " + streamed + " vs size " + model.size());
+        Object[] arr = s.toArray();
+        Zoo.check(arr.length == model.size() && model.containsAll(List.of(arr)), () -> where + ": toArray " + List.of(arr));
+        Zoo.check(s.findFirst().isPresent() == !model.isEmpty(), () -> where + ": findFirst " + s.findFirst());
+        if (!model.isEmpty()) {
+            Zoo.check(model.contains(s.findFirst().get()), () -> where + ": findFirst not a member " + s.findFirst());
+        }
+    }
+
+    @Test
+    void immutableSetsAgreeWithHashSet() {
+        Zoo.property("capsule set: immutable operations agree with HashSet", tc -> {
+            Domain d = Keys.domain(tc);
+            Start start = Zoo.pick(tc, Start.values());
+            HashSet<K> initial = Keys.subset(tc, d, 30);
+            Set.Immutable<K> s = build(start, initial);
+            HashSet<K> model = new HashSet<>(initial);
+            agree("start " + start + " " + d, s, model, d);
+            int steps = Zoo.n(tc, 1, 25);
+            for (int i = 0; i < steps; i++) {
+                Set.Immutable<K> before = s;
+                HashSet<K> beforeModel = new HashSet<>(model);
+                String op;
+                switch (Zoo.n(tc, 0, 9)) {
+                    case 0, 1, 2 -> {
+                        K k = d.key(tc);
+                        op = "insert " + k;
+                        s = s.__insert(k);
+                        model.add(k);
+                    }
+                    case 3, 4 -> {
+                        K k = d.key(tc);
+                        op = "remove " + k;
+                        s = s.__remove(k);
+                        model.remove(k);
+                    }
+                    case 5 -> {
+                        HashSet<K> other = Keys.subset(tc, d, 12);
+                        op = "insertAll " + other;
+                        s = s.__insertAll(Zoo.chance(tc, 50) ? other : build(Zoo.pick(tc, Start.values()), other));
+                        model.addAll(other);
+                    }
+                    case 6 -> {
+                        HashSet<K> other = Keys.subset(tc, d, 12);
+                        op = "removeAll " + other;
+                        s = s.__removeAll(Zoo.chance(tc, 50) ? other : build(Zoo.pick(tc, Start.values()), other));
+                        model.removeAll(other);
+                    }
+                    case 7 -> {
+                        HashSet<K> other = Keys.subset(tc, d, 12);
+                        op = "retainAll " + other;
+                        s = s.__retainAll(Zoo.chance(tc, 50) ? other : build(Zoo.pick(tc, Start.values()), other));
+                        model.retainAll(other);
+                    }
+                    case 8 -> {
+                        HashSet<K> other = Keys.subset(tc, d, 12);
+                        Set.Immutable<K> o = build(Zoo.pick(tc, Start.values()), other);
+                        switch (Zoo.n(tc, 0, 2)) {
+                            case 0 -> {
+                                op = "union " + other;
+                                s = s.union(o);
+                                model.addAll(other);
+                            }
+                            case 1 -> {
+                                op = "subtract " + other;
+                                s = s.subtract(o);
+                                model.removeAll(other);
+                            }
+                            default -> {
+                                op = "intersect " + other;
+                                s = s.intersect(o);
+                                model.retainAll(other);
+                            }
+                        }
+                    }
+                    default -> {
+                        // the same set built again, then a set operation with itself or its copy
+                        Set.Immutable<K> copy = build(Zoo.pick(tc, Start.values()), model);
+                        Set.Immutable<K> cur = s;
+                        Zoo.check(cur.equals(copy) && copy.equals(cur) && cur.hashCode() == copy.hashCode(),
+                                () -> "copy of " + model + " built from " + start + " differs: " + cur + " vs " + copy);
+                        switch (Zoo.n(tc, 0, 3)) {
+                            case 0 -> {
+                                op = "union self-copy";
+                                s = s.union(copy);
+                            }
+                            case 1 -> {
+                                op = "intersect self-copy";
+                                s = s.intersect(copy);
+                            }
+                            case 2 -> {
+                                op = "subtract self-copy";
+                                s = s.subtract(copy);
+                                model.clear();
+                            }
+                            default -> {
+                                op = "insertAll self";
+                                s = s.__insertAll(s);
+                            }
+                        }
+                    }
+                }
+                final String where = "after " + op + " on " + beforeModel + " (" + start + ", " + d + ")";
+                agree(where, s, model, d);
+                agree("previous version " + where, before, beforeModel, d);
+            }
+            // transient copy and back
+            Set.Immutable<K> fin = s;
+            if (fin.isTransientSupported()) {
+                Set.Transient<K> t = fin.asTransient();
+                agree("asTransient of " + model, t, model, d);
+                Set.Immutable<K> frozen = t.freeze();
+                agree("freeze of asTransient of " + model, frozen, model, d);
+                Zoo.check(frozen.equals(fin) && fin.equals(frozen), () -> "frozen copy differs from original: " + frozen + " vs " + fin);
+            }
+            if (fin instanceof java.io.Serializable) {
+                Set.Immutable<K> back = Keys.roundTrip(fin);
+                agree("deserialized " + model, back, model, d);
+                Zoo.check(back.equals(fin) && fin.equals(back), () -> "deserialized set differs: " + back + " vs " + fin);
+            }
+            Set.Immutable<K> collected = model.stream().collect(CapsuleCollectors.toSet());
+            agree("collected " + model, collected, model, d);
+            Set.Immutable<K> collectedParallel = new ArrayList<>(model).parallelStream().collect(CapsuleCollectors.toSet());
+            agree("collected in parallel " + model, collectedParallel, model, d);
+        });
+    }
+
+    @Test
+    void transientSetsAgreeWithHashSet() {
+        Zoo.property("capsule set: transient operations agree with HashSet", tc -> {
+            Domain d = Keys.domain(tc);
+            Start start = Zoo.pick(tc, Start.values());
+            HashSet<K> initial = Keys.subset(tc, d, 30);
+            Set.Immutable<K> base = build(start, initial);
+            if (!base.isTransientSupported()) {
+                return;
+            }
+            HashSet<K> baseModel = new HashSet<>(initial);
+            Set.Transient<K> t = base.asTransient();
+            HashSet<K> model = new HashSet<>(initial);
+            int steps = Zoo.n(tc, 1, 40);
+            for (int i = 0; i < steps; i++) {
+                HashSet<K> beforeModel = new HashSet<>(model);
+                String op;
+                boolean changed;
+                boolean expectedChange;
+                switch (Zoo.n(tc, 0, 7)) {
+                    case 0, 1, 2 -> {
+                        K k = d.key(tc);
+                        op = "insert " + k;
+                        changed = t.__insert(k);
+                        expectedChange = model.add(k);
+                    }
+                    case 3, 4 -> {
+                        K k = d.key(tc);
+                        op = "remove " + k;
+                        changed = t.__remove(k);
+                        expectedChange = model.remove(k);
+                    }
+                    case 5 -> {
+                        HashSet<K> other = Keys.subset(tc, d, 12);
+                        op = "insertAll " + other;
+                        changed = t.__insertAll(other);
+                        expectedChange = model.addAll(other);
+                    }
+                    case 6 -> {
+                        HashSet<K> other = Keys.subset(tc, d, 12);
+                        op = "removeAll " + other;
+                        changed = t.__removeAll(other);
+                        expectedChange = model.removeAll(other);
+                    }
+                    default -> {
+                        HashSet<K> other = Keys.subset(tc, d, 12);
+                        op = "retainAll " + other;
+                        changed = t.__retainAll(other);
+                        expectedChange = model.retainAll(other);
+                    }
+                }
+                final String where = "transient after " + op + " on " + beforeModel + " (" + start + ", " + d + ")";
+                Zoo.check(changed == expectedChange, () -> where + ": returned " + changed + ", model changed " + expectedChange);
+                agree(where, t, model, d);
+                agree("base of " + where, base, baseModel, d);
+                if (Zoo.chance(tc, 15)) {
+                    // an iterator removal on the transient
+                    Iterator<K> it = t.iterator();
+                    if (it.hasNext()) {
+                        K k = it.next();
+                        try {
+                            it.remove();
+                            model.remove(k);
+                            agree("iterator.remove of " + k + " on " + beforeModel, t, model, d);
+                        } catch (UnsupportedOperationException e) {
+                            // allowed for a transient too
+                        }
+                    }
+                }
+            }
+            Set.Immutable<K> frozen = t.freeze();
+            agree("frozen " + model, frozen, model, d);
+            Zoo.check(Zoo.throwsA(null, () -> t.__insert(d.of(0))) || t.size() == model.size(),
+                    () -> "insert on a frozen transient neither threw nor left it alone: " + t);
+            Set.Immutable<K> rebuilt = build(start, model);
+            Zoo.check(frozen.equals(rebuilt) && rebuilt.equals(frozen) && frozen.hashCode() == rebuilt.hashCode(),
+                    () -> "frozen " + frozen + " differs from rebuilt " + rebuilt + " (" + start + ", " + d + ")");
+        });
+    }
+
+    @Test
+    void setAlgebraMatchesTheModel() {
+        Zoo.property("capsule set: union/subtract/intersect of two sets match HashSet algebra", tc -> {
+            Domain d = Keys.domain(tc);
+            HashSet<K> a = Keys.subset(tc, d, 40);
+            HashSet<K> b = Keys.subset(tc, d, 40);
+            Set.Immutable<K> sa = build(Zoo.pick(tc, Start.values()), a);
+            Set.Immutable<K> sb = build(Zoo.pick(tc, Start.values()), b);
+            HashSet<K> union = new HashSet<>(a);
+            union.addAll(b);
+            HashSet<K> inter = new HashSet<>(a);
+            inter.retainAll(b);
+            HashSet<K> diff = new HashSet<>(a);
+            diff.removeAll(b);
+            agree("union " + a + " " + b, sa.union(sb), union, d);
+            agree("union static " + a + " " + b, Set.Immutable.union(sa, sb), union, d);
+            agree("intersect " + a + " " + b, sa.intersect(sb), inter, d);
+            agree("intersect static " + a + " " + b, Set.Immutable.intersect(sa, sb), inter, d);
+            agree("subtract " + a + " " + b, sa.subtract(sb), diff, d);
+            agree("subtract static " + a + " " + b, Set.Immutable.subtract(sa, sb), diff, d);
+            agree("a unchanged", sa, a, d);
+            agree("b unchanged", sb, b, d);
+            // equal sets of different kinds
+            Set.Immutable<K> ta = build(Start.TRIE, a);
+            Set.Immutable<K> pa = build(Start.SPECIALISED, a);
+            Zoo.check(ta.equals(pa) && pa.equals(ta), () -> "trie and specialised sets of " + a + " are not equal: " + ta + " vs " + pa);
+            Zoo.check(ta.hashCode() == pa.hashCode(), () -> "trie and specialised sets of " + a + " hash differently");
+            Zoo.check(ta.equals(sb) == a.equals(b), () -> "equals of " + a + " and " + b + " is " + ta.equals(sb));
+            Zoo.check(sb.equals(ta) == a.equals(b), () -> "equals of " + b + " and " + a + " is " + sb.equals(ta));
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..f6eeb74
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,157 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+
+    /** Rethrows any throwable unchecked (for control-flow exceptions such as Hegel's that must not be swallowed). */
+    @SuppressWarnings("unchecked")
+    /** Broad catch blocks must let Hegel's own stop signal through. */
+    static void rethrowStop(Throwable t) {
+        if (t instanceof RuntimeException r && t.getClass().getName().equals("dev.hegel.StopTest")) {
+            throw r;
+        }
+    }
+
+    static <T extends Throwable> void sneaky(Throwable t) throws T {
+        throw (T) t;
+    }
+
+    /** A property body that may throw checked exceptions. */
+    interface Body {
+        void run(TestCase tc) throws Exception;
+    }
+
+    /** Runs {@code body} as a Hegel property named {@code name}; checked exceptions escape as they are. */
+    static void property(String name, Body body) {
+        dev.hegel.Hegel.test(tc -> {
+            try {
+                body.run(tc);
+            } catch (Exception e) {
+                Zoo.<RuntimeException>sneaky(e);
+            }
+        }, settings(name));
+    }
+
+    /** Whether {@code t} throws an instance of {@code type} (or, with {@code type} null, anything at all). */
+    static boolean throwsA(Class<? extends Throwable> type, Body0 t) {
+        try {
+            t.run();
+            return false;
+        } catch (Throwable e) {
+            return type == null || type.isInstance(e);
+        }
+    }
+
+    interface Body0 {
+        void run() throws Exception;
+    }
+}
