+                SetMultimap.Immutable<K, Integer> built = PersistentTrieSetMultimap.<K, Integer>of().__insert(xs.get(0), 0).__insert(xs.get(1), 1);
+                Zoo.check(mm.equals(built) && built.equals(mm), () -> "SetMultimap.Immutable.of(k0, v0, k1, v1) of " + xs + " = " + mm + " vs " + built);
+                SetMultimap.Immutable<K, Integer> rel = PersistentBidirectionalTrieSetMultimap.<K, Integer>of().__insert(xs.get(0), 0).__insert(xs.get(1), 1);
+                Zoo.check(rel.equals(built) && built.equals(rel) && rel.hashCode() == built.hashCode(), () -> "relation of " + xs + " = " + rel + " vs " + built);
+            }
+        });
+    }
+
+    @Test
+    void frozenTransientsRefuseMutators() {
+        Zoo.property("capsule transients: after freeze() every mutator throws IllegalStateException and freeze() cannot be repeated", tc -> {
+            Domain d = Keys.domain(tc);
+            HashSet<K> keys = Keys.subset(tc, d, 12);
+            K k = d.of(0);
+            keys.add(k);
+            keys.add(d.of(1));
+            Set.Transient<K> t = SetTest.build(SetTest.Start.TRIE, keys).asTransient();
+            Set.Immutable<K> frozen = t.freeze();
+            Zoo.check(Zoo.throwsA(IllegalStateException.class, t::freeze), () -> "second freeze() did not throw IllegalStateException");
+            for (var op : List.<Runnable>of(() -> t.__insert(k), () -> t.__remove(k), () -> t.__insertAll(java.util.Set.of(k)),
+                    () -> t.__removeAll(java.util.Set.of(k)), () -> t.__retainAll(java.util.Set.of(k)))) {
+                Zoo.check(Zoo.throwsA(IllegalStateException.class, op::run), () -> "frozen set transient mutator did not throw IllegalStateException");
+            }
+            Zoo.check(frozen.equals(keys) && t.equals(keys), () -> "frozen set changed: " + frozen + " / " + t);
+            HashMap<K, Integer> entries = new HashMap<>();
+            for (K x : keys) {
+                entries.put(x, x.v);
+            }
+            Map.Transient<K, Integer> mt = MapTest.build(MapTest.Start.TRIE, entries).asTransient();
+            mt.freeze();
+            for (var op : List.<Runnable>of(() -> mt.__put(k, 1), () -> mt.__remove(k), () -> mt.__putAll(java.util.Map.of(k, 1)), mt::freeze)) {
+                Zoo.check(Zoo.throwsA(IllegalStateException.class, op::run), () -> "frozen map transient mutator did not throw IllegalStateException");
+            }
+            SetMultimap.Transient<K, K> mmt = PersistentTrieSetMultimap.transientOf();
+            mmt.__insert(k, k);
+            mmt.freeze();
+            for (var op : List.<Runnable>of(() -> mmt.__insert(k, k), () -> mmt.__remove(k), () -> mmt.__remove(k, k), () -> mmt.__put(k, k),
+                    () -> mmt.__insert(k, PersistentTrieSet.of(k)), () -> mmt.__put(k, PersistentTrieSet.of(k)), mmt::freeze)) {
+                Zoo.check(Zoo.throwsA(IllegalStateException.class, op::run), () -> "frozen multimap transient mutator did not throw IllegalStateException");
+            }
+        });
+    }
