+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for Capsule, added by the Hegel zoo (targets/java/capsule).
+     Runs against the capsule artifact that `[run] setup` installs from this checkout into the local Maven
+     repository. The oracles are java.util.HashSet/HashMap twins driven by the same operation scripts, the
+     java.util.Set/Map contracts (equals/hashCode/iteration), and the library against itself (trie vs
+     specialised sets and maps, immutable vs transient, forward vs inverse relations). -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>capsule-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <capsule.version>0.7.3-SNAPSHOT</capsule.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>io.usethesource</groupId>
+      <artifactId>capsule</artifactId>
+      <version>${capsule.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
