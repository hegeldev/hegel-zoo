+/**
+ * Capsule's set-multimaps ({@link PersistentTrieSetMultimap}, keys mapped to sets of values with the
+ * singleton/set heterogeneous payload) and the bidirectional binary relation
+ * ({@link PersistentBidirectionalTrieSetMultimap}) against a {@code HashMap<K, HashSet<V>>} model under the same
+ * operation script, immutably and through transients; the relation's {@code inverse()} against the inverted
+ * model.
+ */
+class MultimapTest {
+
+    /** The model: keys to non-empty value sets. */
+    static final class Model {
+        final HashMap<K, HashSet<K>> m = new HashMap<>();
+
+        Model() {}
+
+        Model(Model o) {
+            for (var e : o.m.entrySet()) {
+                m.put(e.getKey(), new HashSet<>(e.getValue()));
+            }
+        }
+
+        boolean insert(K k, K v) {
+            return m.computeIfAbsent(k, x -> new HashSet<>()).add(v);
+        }
+
+        void put(K k, java.util.Collection<K> vs) {
+            m.remove(k);
+            for (K v : vs) {
+                insert(k, v);
+            }
+        }
+
+        boolean remove(K k) {
+            return m.remove(k) != null;
+        }
+
+        boolean remove(K k, K v) {
+            HashSet<K> vs = m.get(k);
+            if (vs == null || !vs.remove(v)) {
+                return false;
+            }
+            if (vs.isEmpty()) {
+                m.remove(k);
+            }
+            return true;
+        }
+
+        int size() {
+            int n = 0;
+            for (HashSet<K> vs : m.values()) {
+                n += vs.size();
+            }
+            return n;
+        }
+
+        HashSet<K> get(K k) {
+            HashSet<K> vs = m.get(k);
+            return vs == null ? new HashSet<>() : vs;
+        }
+
+        boolean contains(K k, K v) {
+            return get(k).contains(v);
+        }
+
+        HashSet<Map.Entry<K, K>> tuples() {
+            HashSet<Map.Entry<K, K>> t = new HashSet<>();
+            for (var e : m.entrySet()) {
+                for (K v : e.getValue()) {
+                    t.add(Map.entry(e.getKey(), v));
+                }
+            }
+            return t;
+        }
+
+        Model inverse() {
+            Model inv = new Model();
+            for (var e : m.entrySet()) {
+                for (K v : e.getValue()) {
+                    inv.insert(v, e.getKey());
+                }
+            }
+            return inv;
+        }
+
+        @Override
+        public String toString() {
+            return m.toString();
+        }
+    }
+
+    enum Start { MULTIMAP, RELATION }
+
+    static final Generator<Start> START = sampledFrom(Start.values());
+
+    static SetMultimap.Immutable<K, K> empty(Start start) {
+        return start == Start.MULTIMAP ? PersistentTrieSetMultimap.of() : PersistentBidirectionalTrieSetMultimap.of();
+    }
+
+    /** A multimap of the given kind holding the model's tuples, inserted in the order given. */
+    static SetMultimap.Immutable<K, K> build(Start start, List<Map.Entry<K, K>> tuples) {
+        SetMultimap.Immutable<K, K> mm = empty(start);
+        for (var t : tuples) {
+            mm = mm.__insert(t.getKey(), t.getValue());
+        }
+        return mm;
+    }
+
+    static Set.Immutable<K> setOf(java.util.Collection<K> vs) {
+        Set.Immutable<K> s = PersistentTrieSet.of();
+        for (K v : vs) {
+            s = s.__insert(v);
+        }
+        return s;
+    }
+
+    static void agree(String where, SetMultimap<K, K> mm, Model model, Domain dk, Domain dv) {
