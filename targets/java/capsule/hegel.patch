+        java.util.Collections.reverse(reversed);
+        for (Start other : Start.values()) {
+            SetMultimap.Immutable<K, K> fresh = build(other, reversed);
+            Zoo.check(mm.equals(fresh), () -> where + ": not equal to a fresh " + other + " with the same tuples: " + mm + " vs " + fresh);
+            Zoo.check(fresh.equals(mm), () -> where + ": fresh " + other + " not equal to it: " + fresh + " vs " + mm);
+            Zoo.check(mm.hashCode() == fresh.hashCode(), () -> where + ": hashCode " + mm.hashCode() + " vs fresh " + other + " " + fresh.hashCode());
+        }
+        if (size > 0) {
+            var t = tuples.iterator().next();
+            SetMultimap.Immutable<K, K> less = build(Start.MULTIMAP, reversed).__remove(t.getKey(), t.getValue());
+            Zoo.check(!mm.equals(less) && !less.equals(mm), () -> where + ": equal to a multimap lacking " + t + ": " + less);
+        }
+    }
+
+    // ---- the scripts -------------------------------------------------------------------------------------------
+
+    /** A tuple: a key of the key domain and a value of the value domain. */
+    static Generator<Map.Entry<K, K>> tuple(Domain dk, Domain dv) {
+        return tuples(key(dk), key(dv)).map(t -> Map.entry(t.value1(), t.value2()));
+    }
+
+    /** One operation on the immutable multimap and the model. */
+    sealed interface Op permits Insert, InsertSet, InsertKeys, Put, PutSet, RemoveKey, Remove, Complement {}
+
+    /** One operation on the transient and the model. */
+    sealed interface TOp permits Insert, InsertSet, RemoveKey, Remove, Put, PutSet {}
+
+    record Insert(K k, K v) implements Op, TOp {}
+
+    /** {@code __insert(k, set)}; while capsule/4 stands, a set of two or more onto a key holding one value is cut to its first member when applied. */
+    record InsertSet(K k, HashSet<K> vs) implements Op, TOp {}
+
+    record InsertKeys(HashSet<K> ks, K v) implements Op {}
+
+    record Put(K k, K v) implements Op, TOp {}
+
+    /** {@code __put(k, set)}; the immutable relation refuses it. */
+    record PutSet(K k, HashSet<K> vs) implements Op, TOp {}
+
+    /** {@code __remove(k)}; the immutable relation refuses it. */
+    record RemoveKey(K k) implements Op, TOp {}
+
+    record Remove(K k, K v) implements Op, TOp {}
+
+    /** The tuples of another multimap of kind {@code start} that are not in this one. */
+    record Complement(List<Map.Entry<K, K>> tuples, Start start) implements Op {}
+
+    /**
+     * The immutable operations: an insert three times in ten, the rest once each. The relation's {@code __put(k, v)} is
+     * left out while capsule/7 stands (it puts into the inverse as well and desynchronises it).
+     */
+    static Generator<Op> op(Domain dk, Domain dv, Start start) {
+        Generator<K> k = key(dk);
+        Generator<K> v = key(dv);
+        List<Choice<Op>> choices = new ArrayList<>();
+        choices.add(w(3, tuples(k, v).<Op>map(t -> new Insert(t.value1(), t.value2()))));
+        choices.add(w(1, tuples(k, subset(dv, 4)).<Op>map(t -> new InsertSet(t.value1(), t.value2()))));
+        choices.add(w(1, tuples(subset(dk, 4), v).<Op>map(t -> new InsertKeys(t.value1(), t.value2()))));
+        if (start != Start.RELATION || !Known.RELATION_PUT_DESYNCS_INVERSE) {
+            choices.add(w(1, tuples(k, v).<Op>map(t -> new Put(t.value1(), t.value2()))));
+        }
+        choices.add(w(1, tuples(k, subset(dv, 4)).<Op>map(t -> new PutSet(t.value1(), t.value2()))));
+        choices.add(w(1, k.<Op>map(RemoveKey::new)));
+        choices.add(w(1, tuples(k, v).<Op>map(t -> new Remove(t.value1(), t.value2()))));
+        choices.add(w(1, tuples(lists(tuple(dk, dv)).maxSize(8), START).<Op>map(t -> new Complement(t.value1(), t.value2()))));
+        return Gen.weighted(choices);
+    }
+
+    /** The transient operations: an insert three times, the rest once each; the map-semantic puts on the multimap only. */
+    static Generator<TOp> transientOp(Domain dk, Domain dv, Start start) {
+        Generator<K> k = key(dk);
+        Generator<K> v = key(dv);
+        List<Choice<TOp>> choices = new ArrayList<>();
+        choices.add(w(3, tuples(k, v).<TOp>map(t -> new Insert(t.value1(), t.value2()))));
+        choices.add(w(1, tuples(k, subset(dv, 4)).<TOp>map(t -> new InsertSet(t.value1(), t.value2()))));
+        choices.add(w(1, k.<TOp>map(RemoveKey::new)));
+        choices.add(w(1, tuples(k, v).<TOp>map(t -> new Remove(t.value1(), t.value2()))));
+        if (start == Start.MULTIMAP) {
+            choices.add(w(1, tuples(k, v).<TOp>map(t -> new Put(t.value1(), t.value2()))));
+            choices.add(w(1, tuples(k, subset(dv, 4)).<TOp>map(t -> new PutSet(t.value1(), t.value2()))));
+        }
+        return Gen.weighted(choices);
+    }
+
+    /** The key and value domains, the kind of multimap, its initial tuples and the operations on it. */
+    record ImmutableCase(Domain dk, Domain dv, Start start, List<Map.Entry<K, K>> initial, List<Op> ops) {}
+
+    static final Generator<ImmutableCase> IMMUTABLE_CASE = tuples(DOMAIN, VALUE_DOMAIN, START).flatMap(t ->
+            tuples(lists(tuple(t.value1(), t.value2())).maxSize(25), lists(op(t.value1(), t.value2(), t.value3())).minSize(1).maxSize(20))
+                    .map(u -> new ImmutableCase(t.value1(), t.value2(), t.value3(), u.value1(), u.value2())));
+
+    /** The values of an {@code __insert(k, set)}: cut to one while capsule/4 stands and the key holds exactly one value. */
+    static HashSet<K> insertable(HashSet<K> vs, K k, Model model) {
+        if (Known.INSERT_SET_ONTO_SINGLETON_UNDERCOUNTS && model.get(k).size() == 1 && vs.size() >= 2) {
+            return new HashSet<>(List.of(vs.iterator().next()));
+        }
+        return vs;
+    }
+
+    @Test
+    void immutableMultimapsAgreeWithTheModel() {
+        Zoo.property("capsule multimap: immutable operations agree with a HashMap-of-HashSet model", tc -> {
+            ImmutableCase c = tc.draw(IMMUTABLE_CASE, "case");
+            Domain dk = c.dk();
+            Domain dv = c.dv();
+            Start start = c.start();
+            Model model = new Model();
+            for (var t : c.initial()) {
+                model.insert(t.getKey(), t.getValue());
+            }
+            SetMultimap.Immutable<K, K> mm = build(start, c.initial());
+            agree("start " + start + " " + dk + " " + dv, mm, model, dk, dv);
+            for (Op op : c.ops()) {
+                SetMultimap.Immutable<K, K> before = mm;
+                Model beforeModel = new Model(model);
+                switch (op) {
+                    case Insert o -> {
+                        mm = mm.__insert(o.k(), o.v());
+                        model.insert(o.k(), o.v());
+                    }
+                    case InsertSet o -> {
+                        HashSet<K> vs = insertable(o.vs(), o.k(), model);
+                        mm = mm.__insert(o.k(), setOf(vs));
+                        vs.forEach(v -> model.insert(o.k(), v));
+                    }
+                    case InsertKeys o -> {
+                        mm = mm.__insert(setOf(o.ks()), o.v());
+                        o.ks().forEach(k -> model.insert(k, o.v()));
+                    }
+                    case Put o -> {
+                        mm = mm.__put(o.k(), o.v());
+                        model.put(o.k(), List.of(o.v()));
+                    }
+                    case PutSet o -> {
+                        if (start == Start.RELATION) {
+                            SetMultimap.Immutable<K, K> cur = mm;
+                            Zoo.check(Zoo.throwsA(UnsupportedOperationException.class, () -> cur.__put(o.k(), setOf(o.vs()))), () -> "relation __put(k, set) did not throw UnsupportedOperationException");
+                        } else {
+                            mm = mm.__put(o.k(), setOf(o.vs()));
+                            model.put(o.k(), o.vs());
+                        }
+                    }
+                    case RemoveKey o -> {
+                        if (start == Start.RELATION) {
+                            // no Map semantics on the immutable relation: __remove(key) throws UnsupportedOperationException
+                            SetMultimap.Immutable<K, K> cur = mm;
+                            Zoo.check(Zoo.throwsA(UnsupportedOperationException.class, () -> cur.__remove(o.k())), () -> "relation __remove(k) did not throw UnsupportedOperationException");
+                        } else {
+                            mm = mm.__remove(o.k());
+                            model.remove(o.k());
+                        }
+                    }
+                    case Remove o -> {
+                        mm = mm.__remove(o.k(), o.v());
+                        model.remove(o.k(), o.v());
+                    }
+                    case Complement o -> {
+                        Model other = new Model();
+                        for (var t : o.tuples()) {
+                            other.insert(t.getKey(), t.getValue());
+                        }
+                        SetMultimap.Immutable<K, K> cpl = mm.complement(build(o.start(), o.tuples()));
+                        Model expected = new Model();
+                        for (var t : other.tuples()) {
+                            if (!model.contains(t.getKey(), t.getValue())) {
+                                expected.insert(t.getKey(), t.getValue());
+                            }
+                        }
+                        agree("complement of " + other + " against " + model, cpl, expected, dk, dv);
+                    }
+                }
+                final String where = "after " + op + " on " + beforeModel + " (" + start + ", " + dk + ", " + dv + ")";
+                agree(where, mm, model, dk, dv);
+                agree("previous version " + where, before, beforeModel, dk, dv);
+                if (mm instanceof BinaryRelation.Immutable<K, K> rel) {
+                    BinaryRelation.Immutable<K, K> inv = rel.inverse();
+                    agree("inverse " + where, inv, model.inverse(), dv, dk);
+                    BinaryRelation.Immutable<K, K> back = inv.inverse();
+                    Zoo.check(back.equals(rel) && rel.equals(back) && back.hashCode() == rel.hashCode(),
+                            () -> "inverse of inverse differs " + where + ": " + back + " vs " + rel);
+                    agree("toSetMultimap " + where, rel.toSetMultimap(), model, dk, dv);
+                }
+            }
+            SetMultimap.Immutable<K, K> fin = mm;
+            if (fin.isTransientSupported()) {
+                SetMultimap.Transient<K, K> t = fin.asTransient();
+                agree("asTransient of " + model, t, model, dk, dv);
+                SetMultimap.Immutable<K, K> frozen = t.freeze();
+                agree("freeze of asTransient of " + model, frozen, model, dk, dv);
+                Zoo.check(frozen.equals(fin) && fin.equals(frozen), () -> "frozen copy differs from original: " + frozen + " vs " + fin);
+            }
+            if (fin instanceof java.io.Serializable) {
+                SetMultimap.Immutable<K, K> back = Keys.roundTrip(fin);
+                agree("deserialized " + model, back, model, dk, dv);
+            }
+        });
+    }
+
+    /** The domains, the kind of multimap the transient is taken from, its tuples and the operations on the transient. */
+    record TransientCase(Domain dk, Domain dv, Start start, List<Map.Entry<K, K>> initial, List<TOp> ops) {}
+
+    static final Generator<TransientCase> TRANSIENT_CASE = tuples(DOMAIN, VALUE_DOMAIN, START).flatMap(t ->
+            tuples(lists(tuple(t.value1(), t.value2())).maxSize(25), lists(transientOp(t.value1(), t.value2(), t.value3())).minSize(1).maxSize(30))
+                    .map(u -> new TransientCase(t.value1(), t.value2(), t.value3(), u.value1(), u.value2())));
+
+    /** What a transient mutator returned and what the model says it should have. */
+    record Outcome(boolean changed, boolean expected) {}
+
+    @Test
+    void transientMultimapsAgreeWithTheModel() {
+        Zoo.property("capsule multimap: transient operations agree with the model", tc -> {
+            TransientCase c = tc.draw(TRANSIENT_CASE, "case");
+            Domain dk = c.dk();
+            Domain dv = c.dv();
+            Start start = c.start();
+            Model baseModel = new Model();
+            for (var t : c.initial()) {
+                baseModel.insert(t.getKey(), t.getValue());
+            }
+            SetMultimap.Immutable<K, K> base = build(start, c.initial());
+            tc.assume(base.isTransientSupported());
+            SetMultimap.Transient<K, K> t = base.asTransient();
+            Model model = new Model(baseModel);
+            List<TOp> history = new ArrayList<>();
+            for (TOp op : c.ops()) {
+                Model beforeModel = new Model(model);
+                Outcome r = switch (op) {
+                    case Insert o -> new Outcome(t.__insert(o.k(), o.v()), model.insert(o.k(), o.v()));
+                    case InsertSet o -> {
+                        HashSet<K> vs = insertable(o.vs(), o.k(), model);
+                        boolean sameSet = vs.equals(model.get(o.k()));
+                        boolean changed = t.__insert(o.k(), setOf(vs));
+                        boolean any = false;
+                        for (K v : vs) {
+                            any |= model.insert(o.k(), v);
+                        }
+                        // known bug (relation only): the interface default reports a change whenever the set differs from the current values
+                        yield new Outcome(changed, start == Start.RELATION && Known.INSERT_SET_REPORTS_CHANGE_WITHOUT_INSERTING ? !sameSet : any);
+                    }
+                    case RemoveKey o -> new Outcome(t.__remove(o.k()), model.remove(o.k()));
+                    case Remove o -> new Outcome(t.__remove(o.k(), o.v()), model.remove(o.k(), o.v()));
+                    case Put o -> {
+                        boolean changed = t.__put(o.k(), o.v());
+                        // known bug: putting the value the key already maps to alone is reported as a change
+                        boolean expected = Known.PUT_OF_SAME_SINGLETON_REPORTS_CHANGE || !model.get(o.k()).equals(new HashSet<>(List.of(o.v())));
+                        model.put(o.k(), List.of(o.v()));
+                        yield new Outcome(changed, expected);
+                    }
+                    case PutSet o -> {
+                        boolean changed = t.__put(o.k(), setOf(o.vs()));
+                        // known bug: putting the values the key already maps to is reported as a change (an empty set removes the key)
+                        boolean expected = o.vs().isEmpty() ? model.m.containsKey(o.k()) : Known.PUT_OF_SAME_SINGLETON_REPORTS_CHANGE || !model.get(o.k()).equals(o.vs());
+                        model.put(o.k(), o.vs());
+                        yield new Outcome(changed, expected);
+                    }
+                };
+                history.add(op);
+                final String where = "transient after " + op + " on " + beforeModel + " (" + start + ", " + dk + ", " + dv + "; from " + baseModel + " via " + history + ")";
+                Zoo.check(r.changed() == r.expected(), () -> where + ": returned " + r.changed() + ", model changed " + r.expected());
+                agree(where, t, model, dk, dv);
+                agree("base of " + where, base, baseModel, dk, dv);
+                if (t instanceof BinaryRelation.Transient<K, K> rel) {
+                    agree("inverse " + where, rel.inverse(), model.inverse(), dv, dk);
+                }
+            }
+            SetMultimap.Immutable<K, K> frozen = t.freeze();
+            agree("frozen " + model, frozen, model, dk, dv);
+            Zoo.check(Zoo.throwsA(null, () -> t.__insert(dk.of(0), dv.of(0))) || t.size() == model.size(),
+                    () -> "insert on a frozen transient neither threw nor left it alone: " + t);
+        });
+    }
+
+    /** The domains, the kind of multimap and the tuples it is built from. */
+    record TuplesCase(Domain dk, Domain dv, Start start, List<Map.Entry<K, K>> tuples) {}
+
+    static final Generator<TuplesCase> TUPLES_CASE = tuples(DOMAIN, VALUE_DOMAIN, START).flatMap(t ->
+            lists(tuple(t.value1(), t.value2())).maxSize(40).map(ts -> new TuplesCase(t.value1(), t.value2(), t.value3(), ts)));
+
+    @Test
+    void multimapsAndMapsOfSetsAgree() {
+        Zoo.property("capsule multimap: get() sets, keySet and the tuple count are consistent with Set/Map built from the same tuples", tc -> {
+            TuplesCase c = tc.draw(TUPLES_CASE, "case");
+            List<Map.Entry<K, K>> tuples = c.tuples();
+            SetMultimap.Immutable<K, K> mm = build(c.start(), tuples);
+            io.usethesource.capsule.Map.Immutable<K, Set.Immutable<K>> asMap = io.usethesource.capsule.Map.Immutable.of();
+            Set.Immutable<K> keys = PersistentTrieSet.of();
+            int size = 0;
+            for (var t : tuples) {
+                Set.Immutable<K> vs = asMap.containsKey(t.getKey()) ? asMap.get(t.getKey()) : PersistentTrieSet.of();
+                if (!vs.contains(t.getValue())) {
+                    size++;
+                }
+                asMap = asMap.__put(t.getKey(), vs.__insert(t.getValue()));
+                keys = keys.__insert(t.getKey());
+            }
+            final int total = size;
+            final Set.Immutable<K> fKeys = keys;
+            final io.usethesource.capsule.Map.Immutable<K, Set.Immutable<K>> fMap = asMap;
+            Zoo.check(mm.size() == total, () -> "size " + mm.size() + " vs " + total + " for " + tuples);
+            Zoo.check(mm.keySet().equals(fKeys) && fKeys.equals(mm.keySet()), () -> "keySet " + mm.keySet() + " vs " + fKeys);
+            for (K k : fKeys) {
+                Zoo.check(Objects.equals(mm.get(k), fMap.get(k)), () -> "get(" + k + ") " + mm.get(k) + " vs " + fMap.get(k));
+            }
+            // the collector
+            SetMultimap.Immutable<K, K> collected = tuples.stream()
+                    .collect(io.usethesource.capsule.util.stream.CapsuleCollectors.toSetMultimap(Map.Entry::getKey, Map.Entry::getValue));
+            Zoo.check(collected.equals(mm) && mm.equals(collected) && collected.hashCode() == mm.hashCode(),
+                    () -> "collected " + collected + " differs from built " + mm);
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/SetTest.java b/hegel/src/test/java/zoo/SetTest.java
