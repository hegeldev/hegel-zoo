+        model.m.values().forEach(allValues::addAll);
+        for (int i = 0; i < Math.min(dv.universe(), 16); i++) {
+            K v = dv.of(i);
+            Zoo.check(mm.containsValue(v) == allValues.contains(v), () -> where + ": containsValue(" + v + ") = " + mm.containsValue(v));
+        }
+        // views
+        Zoo.check(mm.keySet().equals(model.m.keySet()) && model.m.keySet().equals(mm.keySet()), () -> where + ": keySet " + mm.keySet() + " vs " + model.m.keySet());
+        Zoo.check(mm.keySet().size() == model.m.size(), () -> where + ": keySet size " + mm.keySet().size());
+        Zoo.check(mm.values().size() == size, () -> where + ": values size " + mm.values().size());
+        List<K> values = new ArrayList<>(mm.values());
+        Zoo.check(values.size() == size && allValues.containsAll(values), () -> where + ": values " + values);
+        Zoo.check(mm.entrySet().size() == size, () -> where + ": entrySet size " + mm.entrySet().size());
+        HashSet<Map.Entry<K, K>> tuples = model.tuples();
+        HashSet<Map.Entry<K, K>> entries = new HashSet<>();
+        int n = 0;
+        for (Iterator<Map.Entry<K, K>> it = mm.entrySet().iterator(); it.hasNext() && n <= size + 1; n++) {
+            var e = it.next();
+            entries.add(Map.entry(e.getKey(), e.getValue()));
+        }
+        int count = n;
+        Zoo.check(count == size && entries.equals(tuples), () -> where + ": entrySet iteration " + entries + " (" + count + ") vs " + tuples);
+        if (!Known.ENTRY_SET_CONTAINS_TESTS_KEYS) {
+            for (var t : tuples) {
+                Zoo.check(mm.entrySet().contains(t), () -> where + ": entrySet.contains(" + t + ") false");
+            }
+        }
+        // iterators
+        HashSet<K> keys = new HashSet<>();
