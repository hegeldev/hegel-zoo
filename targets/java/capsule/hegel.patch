+        Zoo.check(nk == model.m.size() && keys.equals(model.m.keySet()), () -> where + ": keyIterator " + keys + " (" + nk + ")");
+        int nv = Keys.count(mm.valueIterator(), size + 1);
+        Zoo.check(nv == size, () -> where + ": valueIterator yields " + nv + ", size " + size);
+        HashSet<Map.Entry<K, K>> seen = new HashSet<>();
+        int ne = 0;
+        for (Iterator<Map.Entry<K, K>> it = mm.entryIterator(); it.hasNext() && ne <= size + 1; ne++) {
+            var e = it.next();
