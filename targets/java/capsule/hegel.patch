+        Zoo.check(mm.sizeDistinct() == model.m.size(), () -> where + ": sizeDistinct " + mm.sizeDistinct() + " vs " + model.m.size());
+        Zoo.check(mm.isEmpty() == (size == 0), () -> where + ": isEmpty " + mm.isEmpty());
+        for (var e : model.m.entrySet()) {
