index 0000000..e306e91
--- /dev/null
+++ b/hegel/src/test/java/zoo/SetTest.java
@@ -0,0 +1,383 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.maybe;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Keys.DOMAIN;
+import static zoo.Keys.key;
+import static zoo.Keys.subset;
+
+import dev.hegel.Generator;
+import io.usethesource.capsule.Set;
+import io.usethesource.capsule.core.PersistentTrieSet;
+import io.usethesource.capsule.util.collection.AbstractSpecialisedImmutableSet;
+import io.usethesource.capsule.util.stream.CapsuleCollectors;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+import zoo.Keys.Domain;
+import zoo.Keys.K;
+
+/**
+ * Capsule's persistent sets against {@link HashSet} under the same operation script: the CHAMP trie
+ * ({@link PersistentTrieSet}), the specialised small sets ({@link AbstractSpecialisedImmutableSet}) that
+ * grow into a trie, and the default factory, each driven immutably and through transients.
+ */
+class SetTest {
+
+    enum Start {
+        TRIE(PersistentTrieSet::of), SPECIALISED(AbstractSpecialisedImmutableSet::setOf), DEFAULT(Set.Immutable::of);
+
+        final Supplier<Set.Immutable<K>> make;
+
+        Start(Supplier<Set.Immutable<K>> make) {
+            this.make = make;
+        }
+    }
+
+    static final Generator<Start> START = sampledFrom(Start.values());
+
+    /** A set of the given start kind holding exactly {@code keys}. */
+    static Set.Immutable<K> build(Start start, java.util.Collection<K> keys) {
+        Set.Immutable<K> s = start.make.get();
+        for (K k : keys) {
+            s = s.__insert(k);
+        }
+        return s;
+    }
+
+    /** Checks the set against the model completely. */
+    static void agree(String where, Set<K> s, HashSet<K> model, Domain d) {
+        Zoo.check(s.size() == model.size(), () -> where + ": size " + s.size() + " vs model " + model.size() + " " + model);
+        Zoo.check(s.isEmpty() == model.isEmpty(), () -> where + ": isEmpty " + s.isEmpty() + " for " + model);
+        for (K k : model) {
+            Zoo.check(s.contains(k), () -> where + ": member " + k + " not contained in " + s);
+            K got = s.get(k);
+            Zoo.check(k.equals(got), () -> where + ": get(" + k + ") = " + got);
+        }
+        for (int v = 0; v < Math.min(d.universe(), 64); v++) {
+            K k = d.of(v);
+            if (!model.contains(k)) {
+                Zoo.check(!s.contains(k), () -> where + ": non-member " + k + " contained in " + s);
+                Zoo.check(s.get(k) == null, () -> where + ": get(non-member " + k + ") = " + s.get(k));
+            }
+        }
+        Zoo.check(s.containsAll(model), () -> where + ": containsAll(model) false");
+        Zoo.check(s.hashCode() == model.hashCode(), () -> where + ": hashCode " + s.hashCode() + " vs model " + model.hashCode() + " " + model);
+        Zoo.check(s.equals(model), () -> where + ": set.equals(HashSet) false: " + s + " vs " + model);
+        Zoo.check(model.equals(s), () -> where + ": HashSet.equals(set) false: " + model + " vs " + s);
+        HashSet<K> seen = new HashSet<>();
+        int n = 0;
+        for (Iterator<K> it = s.iterator(); it.hasNext() && n <= model.size() + 1; n++) {
+            seen.add(it.next());
+        }
+        int count = n;
+        Zoo.check(count == model.size(), () -> where + ": iterator yields " + count + " elements, size " + model.size());
+        Zoo.check(seen.equals(model), () -> where + ": iterator elements " + seen + " vs model " + model);
+        HashSet<K> seen2 = new HashSet<>();
+        int n2 = Keys.count(s.keyIterator(), model.size() + 1);
+        s.keyIterator().forEachRemaining(seen2::add);
+        Zoo.check(n2 == model.size() && seen2.equals(model), () -> where + ": keyIterator yields " + seen2 + " (" + n2 + ")");
+        long streamed = s.stream().count();
+        Zoo.check(streamed == model.size(), () -> where + ": stream().count() " + streamed + " vs size " + model.size());
+        Object[] arr = s.toArray();
+        Zoo.check(arr.length == model.size() && model.containsAll(List.of(arr)), () -> where + ": toArray " + List.of(arr));
+        Zoo.check(s.findFirst().isPresent() == !model.isEmpty(), () -> where + ": findFirst " + s.findFirst());
+        if (!model.isEmpty()) {
+            Zoo.check(model.contains(s.findFirst().get()), () -> where + ": findFirst not a member " + s.findFirst());
+        }
+    }
+
+    // ---- the immutable script ----------------------------------------------------------------------------------
+
+    /** The argument of a bulk operation: the keys as a HashSet, or (50%) as a Capsule set of the given kind. */
+    record Other(HashSet<K> keys, Start start) {
+        java.util.Set<K> asArgument() {
+            return start == null ? keys : build(start, keys);
+        }
+    }
+
+    static Generator<Other> other(Domain d) {
+        return tuples(subset(d, 12), maybe(50, (Start) null, START)).map(t -> new Other(t.value1(), t.value2()));
+    }
+
+    /** One operation on the immutable set and the model. */
+    sealed interface Op permits Insert, Remove, InsertAll, RemoveAll, RetainAll, Union, Subtract, Intersect, UnionCopy, IntersectCopy,
+            SubtractCopy, InsertAllSelf {}
+
+    /** One operation on the transient and the model; the bulk operations take a HashSet. */
+    sealed interface TOp permits Insert, Remove, TInsertAll, TRemoveAll, TRetainAll, IteratorRemove {}
+
+    record Insert(K k) implements Op, TOp {}
+
+    record Remove(K k) implements Op, TOp {}
+
+    record InsertAll(Other other) implements Op {}
+
+    record RemoveAll(Other other) implements Op {}
+
+    record RetainAll(Other other) implements Op {}
+
+    /** union with a Capsule set of kind {@code start} holding {@code other}. */
+    record Union(HashSet<K> other, Start start) implements Op {}
+
+    record Subtract(HashSet<K> other, Start start) implements Op {}
+
+    record Intersect(HashSet<K> other, Start start) implements Op {}
+
+    /** The set built again from the model as kind {@code copy}, checked equal, then combined with the set. */
+    record UnionCopy(Start copy) implements Op {}
+
+    record IntersectCopy(Start copy) implements Op {}
+
+    record SubtractCopy(Start copy) implements Op {}
+
+    /** The copy check, then {@code __insertAll} of the set itself. */
+    record InsertAllSelf(Start copy) implements Op {}
+
+    /** The operations: an insert three times in ten, a remove twice, the bulk operations once each, the algebra spread over its kinds. */
+    static Generator<Op> op(Domain d) {
+        Generator<K> key = key(d);
+        Generator<Other> other = other(d);
+        Generator<HashSet<K>> keys = subset(d, 12);
+        return weighted(
+                w(36, key.<Op>map(Insert::new)),
+                w(24, key.<Op>map(Remove::new)),
+                w(12, other.<Op>map(InsertAll::new)),
+                w(12, other.<Op>map(RemoveAll::new)),
+                w(12, other.<Op>map(RetainAll::new)),
+                w(4, tuples(keys, START).<Op>map(t -> new Union(t.value1(), t.value2()))),
+                w(4, tuples(keys, START).<Op>map(t -> new Subtract(t.value1(), t.value2()))),
+                w(4, tuples(keys, START).<Op>map(t -> new Intersect(t.value1(), t.value2()))),
+                w(3, START.<Op>map(UnionCopy::new)),
+                w(3, START.<Op>map(IntersectCopy::new)),
+                w(3, START.<Op>map(SubtractCopy::new)),
+                w(3, START.<Op>map(InsertAllSelf::new)));
+    }
+
+    /** A key domain, the kind of set to start from, its initial keys and the operations on it. */
+    record ImmutableCase(Domain d, Start start, HashSet<K> initial, List<Op> ops) {}
+
+    static final Generator<ImmutableCase> IMMUTABLE_CASE = DOMAIN.flatMap(d ->
+            tuples(START, subset(d, 30), lists(op(d)).minSize(1).maxSize(25)).map(t -> new ImmutableCase(d, t.value1(), t.value2(), t.value3())));
+
+    @Test
+    void immutableSetsAgreeWithHashSet() {
+        Zoo.property("capsule set: immutable operations agree with HashSet", tc -> {
+            ImmutableCase c = tc.draw(IMMUTABLE_CASE, "case");
+            Domain d = c.d();
+            Start start = c.start();
+            Set.Immutable<K> s = build(start, c.initial());
+            HashSet<K> model = new HashSet<>(c.initial());
+            agree("start " + start + " " + d, s, model, d);
+            for (Op op : c.ops()) {
+                Set.Immutable<K> before = s;
+                HashSet<K> beforeModel = new HashSet<>(model);
+                switch (op) {
+                    case Insert o -> {
+                        s = s.__insert(o.k());
+                        model.add(o.k());
+                    }
+                    case Remove o -> {
+                        s = s.__remove(o.k());
+                        model.remove(o.k());
+                    }
+                    case InsertAll o -> {
+                        s = s.__insertAll(o.other().asArgument());
+                        model.addAll(o.other().keys());
+                    }
+                    case RemoveAll o -> {
+                        s = s.__removeAll(o.other().asArgument());
+                        model.removeAll(o.other().keys());
+                    }
+                    case RetainAll o -> {
+                        s = s.__retainAll(o.other().asArgument());
+                        model.retainAll(o.other().keys());
+                    }
+                    case Union o -> {
+                        s = s.union(build(o.start(), o.other()));
+                        model.addAll(o.other());
+                    }
+                    case Subtract o -> {
+                        s = s.subtract(build(o.start(), o.other()));
+                        model.removeAll(o.other());
+                    }
+                    case Intersect o -> {
+                        s = s.intersect(build(o.start(), o.other()));
+                        model.retainAll(o.other());
+                    }
+                    case UnionCopy o -> s = s.union(copy(o.copy(), s, model, start));
+                    case IntersectCopy o -> s = s.intersect(copy(o.copy(), s, model, start));
+                    case SubtractCopy o -> {
+                        s = s.subtract(copy(o.copy(), s, model, start));
+                        model.clear();
+                    }
+                    case InsertAllSelf o -> {
+                        copy(o.copy(), s, model, start);
+                        s = s.__insertAll(s);
+                    }
+                }
+                final String where = "after " + op + " on " + beforeModel + " (" + start + ", " + d + ")";
+                agree(where, s, model, d);
+                agree("previous version " + where, before, beforeModel, d);
+            }
+            // transient copy and back
+            Set.Immutable<K> fin = s;
+            if (fin.isTransientSupported()) {
+                Set.Transient<K> t = fin.asTransient();
+                agree("asTransient of " + model, t, model, d);
+                Set.Immutable<K> frozen = t.freeze();
+                agree("freeze of asTransient of " + model, frozen, model, d);
+                Zoo.check(frozen.equals(fin) && fin.equals(frozen), () -> "frozen copy differs from original: " + frozen + " vs " + fin);
+            }
+            if (fin instanceof java.io.Serializable) {
+                Set.Immutable<K> back = Keys.roundTrip(fin);
+                agree("deserialized " + model, back, model, d);
+                Zoo.check(back.equals(fin) && fin.equals(back), () -> "deserialized set differs: " + back + " vs " + fin);
+            }
+            Set.Immutable<K> collected = model.stream().collect(CapsuleCollectors.toSet());
+            agree("collected " + model, collected, model, d);
+            Set.Immutable<K> collectedParallel = new ArrayList<>(model).parallelStream().collect(CapsuleCollectors.toSet());
+            agree("collected in parallel " + model, collectedParallel, model, d);
+        });
+    }
+
+    /** The same set built again from the model as kind {@code copy}; equal to the current set in both directions and in hash. */
+    static Set.Immutable<K> copy(Start copy, Set.Immutable<K> cur, HashSet<K> model, Start start) {
+        Set.Immutable<K> c = build(copy, model);
+        Zoo.check(cur.equals(c) && c.equals(cur) && cur.hashCode() == c.hashCode(),
+                () -> "copy of " + model + " built from " + start + " differs: " + cur + " vs " + c);
+        return c;
+    }
+
+    // ---- the transient script ----------------------------------------------------------------------------------
+
+    record TInsertAll(HashSet<K> other) implements TOp {}
+
+    record TRemoveAll(HashSet<K> other) implements TOp {}
+
+    record TRetainAll(HashSet<K> other) implements TOp {}
+
+    /** The first element of a fresh iterator is removed through it (if the transient's iterator allows). */
+    record IteratorRemove() implements TOp {}
+
+    /** The operations: an insert three times in eight, a remove twice, the bulk operations once each, and an iterator removal one time in eight. */
+    static Generator<TOp> transientOp(Domain d) {
+        Generator<K> key = key(d);
+        Generator<HashSet<K>> other = subset(d, 12);
+        return weighted(
+                w(3, key.<TOp>map(Insert::new)),
+                w(2, key.<TOp>map(Remove::new)),
+                w(1, other.<TOp>map(TInsertAll::new)),
+                w(1, other.<TOp>map(TRemoveAll::new)),
+                w(1, other.<TOp>map(TRetainAll::new)),
+                w(1, just((TOp) new IteratorRemove())));
+    }
+
+    /** A key domain, the kind of set the transient is taken from, its keys and the operations on the transient. */
+    record TransientCase(Domain d, Start start, HashSet<K> initial, List<TOp> ops) {}
+
+    static final Generator<TransientCase> TRANSIENT_CASE = DOMAIN.flatMap(d ->
+            tuples(START, subset(d, 30), lists(transientOp(d)).minSize(1).maxSize(40)).map(t -> new TransientCase(d, t.value1(), t.value2(), t.value3())));
+
+    /** What a transient mutator returned and what the model's did. */
+    record Outcome(boolean changed, boolean expected) {}
+
+    @Test
+    void transientSetsAgreeWithHashSet() {
+        Zoo.property("capsule set: transient operations agree with HashSet", tc -> {
+            TransientCase c = tc.draw(TRANSIENT_CASE, "case");
+            Domain d = c.d();
+            Start start = c.start();
+            Set.Immutable<K> base = build(start, c.initial());
+            tc.assume(base.isTransientSupported());
+            HashSet<K> baseModel = new HashSet<>(c.initial());
+            Set.Transient<K> t = base.asTransient();
+            HashSet<K> model = new HashSet<>(c.initial());
+            for (TOp op : c.ops()) {
+                HashSet<K> beforeModel = new HashSet<>(model);
+                Outcome r = switch (op) {
+                    case Insert o -> new Outcome(t.__insert(o.k()), model.add(o.k()));
+                    case Remove o -> new Outcome(t.__remove(o.k()), model.remove(o.k()));
+                    case TInsertAll o -> new Outcome(t.__insertAll(o.other()), model.addAll(o.other()));
+                    case TRemoveAll o -> new Outcome(t.__removeAll(o.other()), model.removeAll(o.other()));
+                    case TRetainAll o -> new Outcome(t.__retainAll(o.other()), model.retainAll(o.other()));
+                    case IteratorRemove o -> {
+                        Iterator<K> it = t.iterator();
+                        if (it.hasNext()) {
+                            K k = it.next();
+                            try {
+                                it.remove();
+                                model.remove(k);
+                            } catch (UnsupportedOperationException e) {
+                                // allowed for a transient too
+                            }
+                        }
+                        yield null;
+                    }
+                };
+                final String where = "transient after " + op + " on " + beforeModel + " (" + start + ", " + d + ")";
+                if (r != null) {
+                    Zoo.check(r.changed() == r.expected(), () -> where + ": returned " + r.changed() + ", model changed " + r.expected());
+                }
+                agree(where, t, model, d);
+                agree("base of " + where, base, baseModel, d);
+            }
+            Set.Immutable<K> frozen = t.freeze();
+            agree("frozen " + model, frozen, model, d);
+            Zoo.check(Zoo.throwsA(null, () -> t.__insert(d.of(0))) || t.size() == model.size(),
+                    () -> "insert on a frozen transient neither threw nor left it alone: " + t);
+            Set.Immutable<K> rebuilt = build(start, model);
+            Zoo.check(frozen.equals(rebuilt) && rebuilt.equals(frozen) && frozen.hashCode() == rebuilt.hashCode(),
+                    () -> "frozen " + frozen + " differs from rebuilt " + rebuilt + " (" + start + ", " + d + ")");
+        });
+    }
+
+    // ---- set algebra -------------------------------------------------------------------------------------------
+
+    /** Two key sets of one domain and the kinds of Capsule set holding them. */
+    record AlgebraCase(Domain d, HashSet<K> a, HashSet<K> b, Start sa, Start sb) {}
+
+    static final Generator<AlgebraCase> ALGEBRA_CASE = DOMAIN.flatMap(d ->
+            tuples(subset(d, 40), subset(d, 40), START, START).map(t -> new AlgebraCase(d, t.value1(), t.value2(), t.value3(), t.value4())));
+
+    @Test
+    void setAlgebraMatchesTheModel() {
+        Zoo.property("capsule set: union/subtract/intersect of two sets match HashSet algebra", tc -> {
+            AlgebraCase c = tc.draw(ALGEBRA_CASE, "case");
+            Domain d = c.d();
+            HashSet<K> a = c.a();
+            HashSet<K> b = c.b();
+            Set.Immutable<K> sa = build(c.sa(), a);
+            Set.Immutable<K> sb = build(c.sb(), b);
+            HashSet<K> union = new HashSet<>(a);
+            union.addAll(b);
+            HashSet<K> inter = new HashSet<>(a);
+            inter.retainAll(b);
+            HashSet<K> diff = new HashSet<>(a);
+            diff.removeAll(b);
+            agree("union " + a + " " + b, sa.union(sb), union, d);
+            agree("union static " + a + " " + b, Set.Immutable.union(sa, sb), union, d);
+            agree("intersect " + a + " " + b, sa.intersect(sb), inter, d);
+            agree("intersect static " + a + " " + b, Set.Immutable.intersect(sa, sb), inter, d);
+            agree("subtract " + a + " " + b, sa.subtract(sb), diff, d);
+            agree("subtract static " + a + " " + b, Set.Immutable.subtract(sa, sb), diff, d);
+            agree("a unchanged", sa, a, d);
+            agree("b unchanged", sb, b, d);
+            // equal sets of different kinds
+            Set.Immutable<K> ta = build(Start.TRIE, a);
+            Set.Immutable<K> pa = build(Start.SPECIALISED, a);
+            Zoo.check(ta.equals(pa) && pa.equals(ta), () -> "trie and specialised sets of " + a + " are not equal: " + ta + " vs " + pa);
+            Zoo.check(ta.hashCode() == pa.hashCode(), () -> "trie and specialised sets of " + a + " hash differently");
+            Zoo.check(ta.equals(sb) == a.equals(b), () -> "equals of " + a + " and " + b + " is " + ta.equals(sb));
+            Zoo.check(sb.equals(ta) == a.equals(b), () -> "equals of " + b + " and " + a + " is " + sb.equals(ta));
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..b179723
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,106 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+
+    /** Broad catch blocks must let Hegel's own stop signal through (dev.hegel.StopTest is package-private). */
+    static void rethrowStop(Throwable t) {
+        if (t instanceof RuntimeException r && t.getClass().getName().equals("dev.hegel.StopTest")) {
+            throw r;
+        }
+    }
+
+    /** Rethrows any throwable unchecked (for control-flow exceptions such as Hegel's that must not be swallowed). */
+    @SuppressWarnings("unchecked")
+    static <T extends Throwable> void sneaky(Throwable t) throws T {
+        throw (T) t;
+    }
+
+    /** A property body that may throw checked exceptions. */
+    interface Body {
+        void run(TestCase tc) throws Exception;
+    }
+
+    /** Runs {@code body} as a Hegel property named {@code name}; checked exceptions escape as they are (Hegel.test takes a Consumer). */
+    static void property(String name, Body body) {
+        dev.hegel.Hegel.test(tc -> {
+            try {
+                body.run(tc);
+            } catch (Exception e) {
+                Zoo.<RuntimeException>sneaky(e);
+            }
+        }, settings(name));
+    }
+
+    /** Whether {@code t} throws an instance of {@code type} (or, with {@code type} null, anything at all). */
+    static boolean throwsA(Class<? extends Throwable> type, Body0 t) {
+        try {
+            t.run();
+            return false;
+        } catch (Throwable e) {
+            return type == null || type.isInstance(e);
+        }
+    }
+
+    interface Body0 {
+        void run() throws Exception;
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
