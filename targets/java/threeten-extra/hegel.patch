+        // lengths, stream, period
+        if (a.isUnboundedStart() || a.isUnboundedEnd()) {
+            Zoo.check(a.lengthInDays() == Integer.MAX_VALUE, () -> at + "lengthInDays of an unbounded range " + a.lengthInDays());
