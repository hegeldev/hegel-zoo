+        int wby = d.get(WEEK_BASED_YEAR);
+        int wowby = d.get(WEEK_OF_WEEK_BASED_YEAR);
+        Zoo.check(yw.getYear() == wby && yw.getWeek() == wowby, () -> atw + "java.time says " + wby + "-W" + wowby);
