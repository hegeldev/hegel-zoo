+    // ------------------------------------------------------------------------------------------------------------
+    // Date ranges
+
+    @Test
+    void dateRangesMatchTheSetModel() {
+        Hegel.test(this::dateRangeCase, Zoo.settings("threeten.dateRanges").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
+    }
+
+    static final LocalDate MINP1 = LocalDate.MIN.plusDays(1);
+    static final LocalDate MAXM1 = LocalDate.MAX.minusDays(1);
+
+    /** The documented reason {@code LocalDateRange.of(s, e)} refuses, or null. */
+    static String refusal(LocalDate s, LocalDate e) {
+        if (e.isBefore(s)) {
+            return "end before start";
+        }
+        if (s.equals(MAXM1) || s.equals(LocalDate.MAX)) {
+            return "start at MAX or MAX-1";
+        }
+        if (e.equals(MINP1) || e.equals(LocalDate.MIN)) {
+            return "end at MIN or MIN+1";
+        }
+        return null;
+    }
+
+    LocalDate[] datePool(TestCase tc) {
+        LocalDate base = Gen.date(tc);
+        if (base.getYear() > 999_990_000 || base.getYear() < -999_990_000) {
+            base = LocalDate.ofEpochDay(Zoo.n(tc, -30_000, 30_000));
+        }
+        boolean edges = Zoo.chance(tc, 30);
+        LocalDate[] pool = new LocalDate[5];
+        for (int i = 0; i < pool.length; i++) {
+            pool[i] = edges && Zoo.chance(tc, 25) ? Zoo.pick(tc, LocalDate.MIN, LocalDate.MAX, MINP1, MAXM1, LocalDate.MIN.plusDays(2), LocalDate.MAX.minusDays(2))
+                    : base.plusDays(Zoo.n(tc, -4, 4));
+        }
+        return pool;
+    }
+
+    LocalDateRange range(TestCase tc, LocalDate[] pool) {
+        while (true) {
+            LocalDate a = Zoo.pick(tc, pool);
+            LocalDate b = Zoo.chance(tc, 15) ? a : Zoo.pick(tc, pool);
+            LocalDate s = a.compareTo(b) <= 0 ? a : b;
+            LocalDate e = a.compareTo(b) <= 0 ? b : a;
+            Object r = outcome(() -> LocalDateRange.of(s, e));
+            String why = refusal(s, e);
+            Zoo.check(why == null ? r instanceof LocalDateRange : r instanceof DateTimeException,
+                    () -> "LocalDateRange.of(" + s + ", " + e + ") = " + kind(r) + (why == null ? "" : ", expected refusal: " + why));
+            if (r instanceof LocalDateRange lr) {
+                return lr;
+            }
+            if (why == null) {
+                return LocalDateRange.ofEmpty(LocalDate.EPOCH);
+            }
+        }
+    }
+
+    void dateRangeCase(TestCase tc) {
+        LocalDate[] pool = datePool(tc);
+        LocalDateRange a = range(tc, pool);
+        LocalDateRange b = range(tc, pool);
+        LocalDate sa = a.getStart();
+        LocalDate ea = a.getEnd();
+        LocalDate sb = b.getStart();
+        LocalDate eb = b.getEnd();
+        String at = a + " and " + b + ": ";
+        Zoo.check(a.isEmpty() == sa.equals(ea), () -> at + "isEmpty");
+        Zoo.check(a.isUnboundedStart() == sa.equals(LocalDate.MIN) && a.isUnboundedEnd() == ea.equals(LocalDate.MAX), () -> at + "isUnbounded");
+        Zoo.check(a.getEndInclusive().equals(a.isUnboundedEnd() ? LocalDate.MAX : ea.minusDays(1)), () -> at + "getEndInclusive " + a.getEndInclusive());
+        boolean encloses = sa.compareTo(sb) <= 0 && eb.compareTo(ea) <= 0;
+        boolean abuts = ea.equals(sb) ^ sa.equals(eb);
+        boolean overlaps = a.equals(b) || (sa.isBefore(eb) && sb.isBefore(ea));
+        boolean connected = overlaps || abuts;
+        Zoo.check(a.encloses(b) == encloses, () -> at + "encloses " + a.encloses(b));
+        Zoo.check(a.abuts(b) == abuts, () -> at + "abuts " + a.abuts(b));
+        Zoo.check(a.overlaps(b) == overlaps, () -> at + "overlaps " + a.overlaps(b));
+        Zoo.check(a.isConnected(b) == connected, () -> at + "isConnected " + a.isConnected(b));
+        Zoo.check(a.overlaps(b) == (a.isConnected(b) && !a.abuts(b)), () -> at + "overlaps is not (isConnected and not abuts)");
+        Zoo.check(a.abuts(b) == b.abuts(a) && a.overlaps(b) == b.overlaps(a) && a.isConnected(b) == b.isConnected(a), () -> at + "relations are not symmetric");
+        LocalDate ls = sa.compareTo(sb) <= 0 ? sa : sb;
+        LocalDate le = ea.compareTo(eb) >= 0 ? ea : eb;
+        Object span = outcome(() -> a.span(b));
+        Zoo.check(span.equals(LocalDateRange.of(ls, le)), () -> at + "span " + kind(span) + " vs model " + ls + "/" + le);
+        Object inter = outcome(() -> a.intersection(b));
+        Object union = outcome(() -> a.union(b));
+        if (connected) {
+            LocalDate ms = sa.compareTo(sb) >= 0 ? sa : sb;
+            LocalDate me = ea.compareTo(eb) <= 0 ? ea : eb;
+            Object model = outcome(() -> LocalDateRange.of(ms, me));
+            Zoo.check(sameOutcome(inter, model), () -> at + "intersection " + kind(inter) + " vs model " + kind(model));
+            Zoo.check(union.equals(LocalDateRange.of(ls, le)), () -> at + "union " + kind(union) + " vs model " + ls + "/" + le);
+        } else {
+            Zoo.check(inter instanceof DateTimeException && union instanceof DateTimeException, () -> at + "not connected but intersection " + kind(inter) + ", union " + kind(union));
+        }
+        boolean before = !a.equals(b) && ea.compareTo(sb) <= 0;
+        boolean after = !a.equals(b) && sa.compareTo(eb) >= 0;
+        Zoo.check(a.isBefore(b) == before && a.isAfter(b) == after, () -> at + "isBefore " + a.isBefore(b) + " isAfter " + a.isAfter(b));
+        Zoo.check(a.isBefore(b) == b.isAfter(a), () -> at + "isBefore is not the mirror of isAfter");
+
+        LocalDate d = Zoo.pick(tc, pool);
+        String atd = a + " and date " + d + ": ";
+        boolean contains = !a.isEmpty() && sa.compareTo(d) <= 0 && (d.isBefore(ea) || a.isUnboundedEnd());
+        Zoo.check(a.contains(d) == contains, () -> atd + "contains " + a.contains(d));
+        Zoo.check(a.isAfter(d) == sa.isAfter(d), () -> atd + "isAfter " + a.isAfter(d));
+        Zoo.check(a.isBefore(d) == (a.isEmpty() ? sa.isBefore(d) : ea.compareTo(d) <= 0), () -> atd + "isBefore " + a.isBefore(d));
+        Object ws = outcome(() -> a.withStart(d));
+        Object wsModel = outcome(() -> LocalDateRange.of(d, ea));
+        Zoo.check(sameOutcome(ws, wsModel), () -> atd + "withStart " + kind(ws) + " vs of " + kind(wsModel));
+        Object we = outcome(() -> a.withEnd(d));
+        Object weModel = outcome(() -> LocalDateRange.of(sa, d));
+        Zoo.check(sameOutcome(we, weModel), () -> atd + "withEnd " + kind(we) + " vs of " + kind(weModel));
+        Object wei = outcome(() -> a.withEndInclusive(d));
+        Object weiModel = outcome(() -> LocalDateRange.ofClosed(sa, d));
+        Zoo.check(sameOutcome(wei, weiModel), () -> atd + "withEndInclusive " + kind(wei) + " vs ofClosed " + kind(weiModel));
