index 0000000..88f7051
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,181 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.oneOf;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import java.time.Duration;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+import java.time.Period;
+import java.time.ZoneOffset;
+import java.util.List;
+
+/**
+ * Generators, as values, shared by the ThreeTen-Extra properties: dates near the present, anywhere in years 1..9999,
+ * in the cutover century, over the full LocalDate range and at its ends; times, offsets, instants, durations and
+ * periods of mixed sizes and signs including the extremes. Plus the combinators the binding lacks: weighted choice, a
+ * biased coin and an optional with a probability.
+ */
+final class Gen {
+    private Gen() {}
+
+    // ---- combinators the binding lacks -------------------------------------------------------------------------
+
+    /** A weighted alternative for {@link #weighted}. */
+    record Choice<T>(int weight, Generator<T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    static <T> Generator<T> weighted(List<Choice<T>> choices) {
+        int total = 0;
+        for (Choice<T> c : choices) {
+            total += c.weight();
+        }
+        return integers().min(0).max(total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : choices) {
+                acc += c.weight();
+                if (i < acc) {
+                    return c.gen();
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return integers().min(0).max(99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A long in [lo, hi]. */
+    static Generator<Long> longs(long lo, long hi) {
+        return Generators.longs().min(lo).max(hi);
+    }
+
+    // ---- counts ------------------------------------------------------------------------------------------------
+
+    /** A small signed count: within 3, 40, 2000 or a million. */
+    static final Generator<Integer> COUNT = oneOf(ints(-3, 3), ints(-40, 40), ints(-2000, 2000), ints(-1_000_000, 1_000_000));
+
+    /** Any int: small, middling, at the extremes, or (twice as often) anywhere. */
+    static final Generator<Integer> ANY_INT = weighted(w(1, ints(-10, 10)), w(1, ints(-100_000, 100_000)),
+            w(1, sampledFrom(0, Integer.MIN_VALUE, Integer.MIN_VALUE + 1, Integer.MAX_VALUE, Integer.MAX_VALUE - 1)),
+            w(2, ints(Integer.MIN_VALUE, Integer.MAX_VALUE)));
+
+    // ---- dates and times ---------------------------------------------------------------------------------------
+
+    /** Epoch day of 0001-01-01 and of 9999-12-31. */
+    static final long DAY_0001 = LocalDate.of(1, 1, 1).toEpochDay();
+    static final long DAY_9999 = LocalDate.of(9999, 12, 31).toEpochDay();
+
+    /** A day within about 82 years of 1970. */
+    static final Generator<LocalDate> NEAR_DATE = longs(-30_000, 30_000).map(LocalDate::ofEpochDay);
+
+    /**
+     * A date away from the ends of the LocalDate range: near the present (40%), anywhere in years 1..9999 (30%), in
+     * the cutover century (10%), anywhere in years -999999..999999 (10%), or a notable day (10%).
+     */
+    static final Generator<LocalDate> INNER_DATE = weighted(
+            w(40, NEAR_DATE),
+            w(30, longs(DAY_0001, DAY_9999).map(LocalDate::ofEpochDay)),
+            w(10, tuples(ints(1700, 1800), ints(1, 12), ints(1, 28)).map(t -> LocalDate.of(t.value1(), t.value2(), t.value3()))),
+            w(10, longs(LocalDate.of(-999_999, 1, 1).toEpochDay(), LocalDate.of(999_999, 12, 31).toEpochDay()).map(LocalDate::ofEpochDay)),
+            w(10, sampledFrom(LocalDate.of(1970, 1, 1), LocalDate.of(0, 1, 1), LocalDate.of(1, 1, 1), LocalDate.of(9999, 12, 31),
+                    LocalDate.of(1752, 9, 2), LocalDate.of(1752, 9, 14), LocalDate.of(2000, 2, 29))));
+
+    /** An {@link #INNER_DATE}, or (one time in 25) a day at the ends of the LocalDate range. */
+    static final Generator<LocalDate> DATE = weighted(w(96, INNER_DATE),
+            w(4, sampledFrom(LocalDate.MIN, LocalDate.MIN.plusDays(1), LocalDate.MAX, LocalDate.MAX.minusDays(1))));
+
+    /** A date in years 1000..9999 (the packed-date range) or a few days outside it. */
+    static final Generator<LocalDate> PACKED_DATE = longs(LocalDate.of(999, 12, 20).toEpochDay(), LocalDate.of(10000, 1, 10).toEpochDay())
+            .map(LocalDate::ofEpochDay);
+
+    /** A time to the minute, to the second, to the nanosecond, or one of the notable ones. */
+    static final Generator<LocalTime> TIME = oneOf(
+            tuples(ints(0, 23), ints(0, 59)).map(t -> LocalTime.of(t.value1(), t.value2())),
+            tuples(ints(0, 23), ints(0, 59), ints(0, 59)).map(t -> LocalTime.of(t.value1(), t.value2(), t.value3())),
+            longs(0, 86_399_999_999_999L).map(LocalTime::ofNanoOfDay),
+            sampledFrom(LocalTime.MIDNIGHT, LocalTime.MAX, LocalTime.NOON, LocalTime.of(23, 59, 59)));
+
+    static final Generator<LocalDateTime> DATE_TIME = tuples(DATE, TIME).map(t -> LocalDateTime.of(t.value1(), t.value2()));
+    static final Generator<LocalDateTime> INNER_DATE_TIME = tuples(INNER_DATE, TIME).map(t -> LocalDateTime.of(t.value1(), t.value2()));
+
+    /** UTC, whole hours, hours with a quarter-hour part, or any number of seconds within 18 hours. */
+    static final Generator<ZoneOffset> OFFSET = oneOf(
+            just(ZoneOffset.UTC),
+            ints(-18, 18).map(ZoneOffset::ofHours),
+            tuples(ints(-17, 17), sampledFrom(0, 30, 45, 15)).map(t -> ZoneOffset.ofHoursMinutes(t.value1(), t.value1() < 0 ? -t.value2() : t.value2())),
+            ints(-64_800, 64_800).map(ZoneOffset::ofTotalSeconds));
+
+    // ---- instants ----------------------------------------------------------------------------------------------
+
+    static final Generator<Long> NOTABLE_SECONDS = sampledFrom(0L, -1L, 86_399L, 86_400L,
+            LocalDateTime.of(2016, 12, 31, 23, 59, 59).toEpochSecond(ZoneOffset.UTC),
+            LocalDateTime.of(1972, 6, 30, 23, 59, 59).toEpochSecond(ZoneOffset.UTC),
+            LocalDateTime.of(1958, 1, 1, 0, 0).toEpochSecond(ZoneOffset.UTC));
+
+    /** Epoch seconds within 12 days, 100 years (twice as often), 3000 years, or one of the notable ones. */
+    static final Generator<Long> NEAR_SECOND = weighted(w(1, longs(-1_000_000, 1_000_000)), w(2, longs(-2_000_000_000L, 4_000_000_000L)),
+            w(1, longs(-100_000_000_000L, 100_000_000_000L)), w(1, NOTABLE_SECONDS));
+
+    /** Epoch seconds: mostly near, sometimes anywhere in the Instant range, rarely at its ends. */
+    static final Generator<Long> SECOND = weighted(w(10, NEAR_SECOND), w(2, longs(Instant.MIN.getEpochSecond(), Instant.MAX.getEpochSecond())),
+            w(1, sampledFrom(Instant.MIN.getEpochSecond(), Instant.MAX.getEpochSecond())));
+
+    /** Nanoseconds: none, whole milliseconds, the notable ones, or any. */
+    static final Generator<Integer> NANOS = oneOf(just(0), ints(0, 999).map(ms -> ms * 1_000_000),
+            sampledFrom(1, 999_999_999, 500_000_000, 999_999_000, 1_000), ints(0, 999_999_999));
+
+    static final Generator<Instant> INSTANT = tuples(SECOND, NANOS).map(t -> Instant.ofEpochSecond(t.value1(), t.value2()));
+
+    /** An instant within about 3000 years of 1970, so that a few years of arithmetic around it cannot leave the range. */
+    static final Generator<Instant> NEAR_INSTANT = tuples(NEAR_SECOND, NANOS).map(t -> Instant.ofEpochSecond(t.value1(), t.value2()));
+
+    // ---- amounts -----------------------------------------------------------------------------------------------
+
+    /** A duration of mixed sizes and signs: seconds with nanos, whole minutes, up to 3000 years, a count with a negative nano part, the extremes, or any. */
+    static final Generator<Duration> DURATION = oneOf(
+            tuples(ints(-100, 100), NANOS).map(t -> Duration.ofSeconds(t.value1(), t.value2())),
+            COUNT.map(k -> Duration.ofSeconds(k * 60L)),
+            tuples(longs(-100_000_000_000L, 100_000_000_000L), NANOS).map(t -> Duration.ofSeconds(t.value1(), t.value2())),
+            tuples(COUNT, maybe(50, 0, NANOS.map(n -> -n))).map(t -> Duration.ofSeconds(t.value1(), t.value2())),
+            sampledFrom(Duration.ZERO, Duration.ofSeconds(Long.MAX_VALUE, 999_999_999), Duration.ofSeconds(Long.MIN_VALUE), Duration.ofNanos(1),
+                    Duration.ofNanos(-1), Duration.ofDays(1), Duration.ofDays(-1), Duration.ofHours(Integer.MAX_VALUE + 1L), Duration.ofSeconds(-10_000_000_000L)),
+            tuples(longs(Long.MIN_VALUE, Long.MAX_VALUE), NANOS).map(t -> Duration.ofSeconds(t.value1(), t.value2())));
+
+    /** A period of mixed sizes and signs: small parts, days only, counts, the extremes, or any ints. */
+    static final Generator<Period> PERIOD = oneOf(
+            tuples(ints(-3, 3), ints(-15, 15), ints(-40, 40)).map(t -> Period.of(t.value1(), t.value2(), t.value3())),
+            COUNT.map(Period::ofDays),
+            tuples(COUNT, COUNT, COUNT).map(t -> Period.of(t.value1(), t.value2(), t.value3())),
+            sampledFrom(Period.ZERO, Period.ofYears(Integer.MAX_VALUE), Period.ofMonths(Integer.MIN_VALUE), Period.ofDays(Integer.MAX_VALUE),
+                    Period.ofWeeks(3), Period.ofDays(-7), Period.of(1, -1, 0), Period.of(-1, 13, 0)),
+            tuples(ANY_INT, ANY_INT, ANY_INT).map(t -> Period.of(t.value1(), t.value2(), t.value3())));
+}
