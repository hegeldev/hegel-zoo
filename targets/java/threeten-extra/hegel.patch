+    void temporalsCase(TestCase tc) {
+        TemporalsCase cs = tc.draw(TEMPORALS_CASE, "case");
+        // unit conversion
+        long amount = cs.conversion().amount();
+        TemporalUnit from = cs.conversion().from();
+        TemporalUnit to = cs.conversion().to();
+        Object conv = outcome(() -> Temporals.convertAmount(amount, from, to));
+        Object convWant = convertModel(amount, from, to);
+        Zoo.check(sameConversion(conv, convWant), () -> "convertAmount(" + amount + ", " + from + ", " + to + ") = " + showConversion(conv) + " vs model " + showConversion(convWant));
+        if (conv instanceof long[] r && r[1] == 0 && Math.abs(amount) < 1_000_000_000L) {
+            Object back = outcome(() -> Temporals.convertAmount(r[0], to, from));
+            Zoo.check(back instanceof long[] b && b[0] == amount && b[1] == 0, () -> "convertAmount(" + amount + ", " + from + ", " + to + ") = " + r[0] + " but back " + showConversion(back));
+        }
+        // TimeUnit
+        TimeUnit tu = cs.conversion().timeUnit();
+        Zoo.check(Temporals.timeUnit(Temporals.chronoUnit(tu)) == tu && Temporals.chronoUnit(tu).getDuration().toNanos() == tu.toNanos(1), () -> "chronoUnit(" + tu + ") = " + Temporals.chronoUnit(tu));
+        ChronoUnit cu = cs.conversion().chronoUnit();
+        Object tuo = outcome(() -> Temporals.timeUnit(cu));
+        Zoo.check(cu.compareTo(DAYS) <= 0 && cu != ChronoUnit.HALF_DAYS ? tuo instanceof TimeUnit t && Temporals.chronoUnit(t) == cu : tuo instanceof IllegalArgumentException, () -> "timeUnit(" + cu + ") = " + kind(tuo));
+
+        // working days
+        LocalDateTime ldt = cs.dateTime();
+        LocalDate d = ldt.toLocalDate();
+        LocalDate fd = d;
+        LocalDate next = d.plusDays(1);
+        while (weekend(next)) {
+            next = next.plusDays(1);
+        }
+        LocalDate nextOrSame = d;
+        while (weekend(nextOrSame)) {
+            nextOrSame = nextOrSame.plusDays(1);
+        }
+        LocalDate prev = d.minusDays(1);
+        while (weekend(prev)) {
+            prev = prev.minusDays(1);
+        }
+        LocalDate prevOrSame = d;
+        while (weekend(prevOrSame)) {
+            prevOrSame = prevOrSame.minusDays(1);
+        }
+        LocalDate fnext = next;
+        LocalDate fprev = prev;
+        Zoo.check(d.with(Temporals.nextWorkingDay()).equals(next), () -> fd + ".with(nextWorkingDay) = " + fd.with(Temporals.nextWorkingDay()) + " vs " + fnext);
+        Zoo.check(d.with(Temporals.nextWorkingDayOrSame()).equals(nextOrSame), () -> fd + ".with(nextWorkingDayOrSame) = " + fd.with(Temporals.nextWorkingDayOrSame()));
+        Zoo.check(d.with(Temporals.previousWorkingDay()).equals(prev), () -> fd + ".with(previousWorkingDay) = " + fd.with(Temporals.previousWorkingDay()) + " vs " + fprev);
+        Zoo.check(d.with(Temporals.previousWorkingDayOrSame()).equals(prevOrSame), () -> fd + ".with(previousWorkingDayOrSame) = " + fd.with(Temporals.previousWorkingDayOrSame()));
+        Zoo.check(ldt.with(Temporals.nextWorkingDay()).equals(next.atTime(ldt.toLocalTime())), () -> ldt + ".with(nextWorkingDay) = " + ldt.with(Temporals.nextWorkingDay()));
+
+        // BigDecimal and double seconds
+        Duration dur = cs.seconds().dur();
+        BigDecimal secs = Temporals.durationToBigDecimalSeconds(dur);
+        Zoo.check(secs.equals(seconds(dur)) && secs.scale() == 9, () -> "durationToBigDecimalSeconds(" + dur + ") = " + secs);
+        Zoo.check(Temporals.durationFromBigDecimalSeconds(secs).equals(dur), () -> "durationFromBigDecimalSeconds(" + secs + ") = " + Temporals.durationFromBigDecimalSeconds(secs) + " vs " + dur);
+        BigDecimal x = cs.seconds().big().of(secs);
+        Duration fromBig = Temporals.durationFromBigDecimalSeconds(x);
+        Zoo.check(fromBig.equals(fromSecondsModel(x)), () -> "durationFromBigDecimalSeconds(" + x + ") = " + fromBig + " vs model " + fromSecondsModel(x));
+        double dbl = cs.seconds().dbl() == null ? secs.doubleValue() : cs.seconds().dbl();
+        Duration fromDouble = Temporals.durationFromDoubleSeconds(dbl);
+        Zoo.check(fromDouble.equals(fromSecondsModel(BigDecimal.valueOf(dbl))), () -> "durationFromDoubleSeconds(" + dbl + ") = " + fromDouble + " vs model " + fromSecondsModel(BigDecimal.valueOf(dbl)));
+        Object toDouble = dur.getSeconds() < -9_223_372_036L ? Double.valueOf(secs.doubleValue()) : outcome(() -> Temporals.durationToDoubleSeconds(dur));  // threeten-extra/3
+        Zoo.check(toDouble instanceof Double v && Math.abs(v - secs.doubleValue()) <= Math.ulp(secs.doubleValue()) * 2, () -> "durationToDoubleSeconds(" + dur + ") = " + kind(toDouble) + " vs " + secs.doubleValue());
+        double mult = cs.seconds().mult();
+        Duration times = Temporals.multiply(dur, mult);
+        Duration timesWant = mult == 0d || dur.isZero() ? Duration.ZERO : mult == 1d ? dur : fromSecondsModel(secs.multiply(BigDecimal.valueOf(mult)));
+        Zoo.check(times.equals(timesWant), () -> "multiply(" + dur + ", " + mult + ") = " + times + " vs model " + timesWant);
+
+        // parseFirstMatching
+        LocalDate pdate = cs.parsing().date();
+        DateTimeFormatter[] fmts = {DateTimeFormatter.ISO_LOCAL_DATE, DateTimeFormatter.BASIC_ISO_DATE, DateTimeFormatter.ofPattern("dd/MM/uuuu"), DateTimeFormatter.ofPattern("d MMM uuuu", Locale.ENGLISH)};
+        int chosen = cs.parsing().chosen();
+        String ptext = fmts[chosen].format(pdate);
+        List<DateTimeFormatter> order = new ArrayList<>(Arrays.asList(fmts));
+        java.util.Collections.rotate(order, cs.parsing().rotation());
+        if (cs.parsing().drop()) {
+            order.remove(fmts[chosen]);
+        }
+        boolean present = order.contains(fmts[chosen]);
+        Object pf = outcome(() -> Temporals.parseFirstMatching(ptext, LocalDate::from, order.toArray(new DateTimeFormatter[0])));
+        Zoo.check(present ? pdate.equals(pf) : pf instanceof DateTimeParseException, () -> "parseFirstMatching(" + s(ptext) + ", " + order.size() + " formatters, matching one " + (present ? "present" : "absent") + ") = " + kind(pf));
+
+        // comparators
+        Comparator<TemporalUnit> uc = Temporals.unitComparator();
+        TemporalUnit u1 = cs.comparators().u1();
+        TemporalUnit u2 = cs.comparators().u2();
+        int ucmp = u1.getDuration().compareTo(u2.getDuration());
+        int ucWant = ucmp != 0 ? ucmp : u1.toString().compareTo(u2.toString());
+        Zoo.check(Integer.signum(uc.compare(u1, u2)) == Integer.signum(ucWant), () -> "unitComparator(" + u1 + ", " + u2 + ") = " + uc.compare(u1, u2));
+        Comparator<TemporalField> fc = Temporals.fieldComparator();
+        TemporalField f1 = cs.comparators().f1();
+        TemporalField f2 = cs.comparators().f2();
+        int fcmp = f1.getBaseUnit().getDuration().compareTo(f2.getBaseUnit().getDuration());
+        if (fcmp == 0) {
+            fcmp = f1.getRangeUnit().getDuration().compareTo(f2.getRangeUnit().getDuration());
+        }
+        if (fcmp == 0) {
+            fcmp = f1.toString().compareTo(f2.toString());
+        }
+        int fcWant = fcmp;
+        Zoo.check(Integer.signum(fc.compare(f1, f2)) == Integer.signum(fcWant), () -> "fieldComparator(" + f1 + ", " + f2 + ") = " + fc.compare(f1, f2));
+    }
