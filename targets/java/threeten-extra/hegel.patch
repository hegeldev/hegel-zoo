+    @Test
+    void periodDurationsMatchPeriodAndDuration() {
+        Hegel.test(this::periodDurationCase, Zoo.settings("threeten.periodDurations").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
