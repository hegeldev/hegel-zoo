+        long e = Zoo.chance(tc, 5) ? Zoo.pick(tc, CUTOVER_DAY, CUTOVER_DAY - 1, CUTOVER_DAY - 12, CUTOVER_DAY - 11, 0L, -719162L, -719163L, -365L, 365L) : e0;
