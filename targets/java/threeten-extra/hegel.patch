+    /** The conversion; a date-time away from the ends of the range for the working-day adjusters; the seconds; the parse; the comparisons. */
+    record TemporalsCase(Conversion conversion, LocalDateTime dateTime, DecimalSeconds seconds, Parsing parsing, Comparators comparators) {}
+
+    static final Generator<TemporalsCase> TEMPORALS_CASE = tuples(CONVERSION, INNER_DATE_TIME, DECIMAL_SECONDS, PARSING, COMPARATORS)
+            .map(t -> new TemporalsCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
