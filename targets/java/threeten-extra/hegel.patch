+    static final String[] WORDS = {"year", "month", "week", "day", "hour", "minute", "second", "millisecond"};
+
+    /** The English word-based format of the values, as documented: ", " between, " and " before the last. */
+    static String words(long[] values, int firstUnit) {
+        int nonZero = 0;
+        for (long v : values) {
+            if (v != 0) {
+                nonZero++;
+            }
+        }
+        StringBuilder buf = new StringBuilder();
+        int count = 0;
+        for (int i = 0; i < values.length; i++) {
+            if (values[i] != 0 || (count == 0 && i == values.length - 1)) {
+                buf.append(values[i]).append(' ').append(WORDS[firstUnit + i]).append(Math.abs(values[i]) == 1 ? "" : "s");
+                if (count < nonZero - 2) {
+                    buf.append(", ");
+                } else if (count == nonZero - 2) {
+                    buf.append(" and ");
+                }
+                count++;
+            }
+        }
+        return buf.toString();
+    }
+
+    static long[] periodWords(Period p) {
+        Period n = (p.getYears() < 0) != (p.getMonths() < 0) && p.getYears() != 0 && p.getMonths() != 0 ? p.normalized() : p;
+        long weeks = n.getDays() % 7 == 0 ? n.getDays() / 7 : 0;
+        long days = n.getDays() % 7 == 0 ? 0 : n.getDays();
+        return new long[] {n.getYears(), n.getMonths(), weeks, days};
+    }
+
+    static long[] durationWords(Duration d) {
+        return new long[] {d.toHours(), d.toMinutes() % 60, d.getSeconds() % 60, d.getNano() / 1_000_000};
+    }
+
