+
+/** Properties of the amount classes, PeriodDuration, AmountFormats, Temporals, the small temporals and the UTC/TAI scales. */
+class ThreetenExtraAmountsTest {
+
+    static String s(Object o) {
+        return Zoo.show(o);
+    }
+
+    static Object outcome(Supplier<?> f) {
+        try {
+            return f.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String kind(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : "value " + s(o);
+    }
+
+    static boolean sameOutcome(Object a, Object b) {
+        if (a instanceof Throwable ta) {
+            return b instanceof Throwable tb && ta.getClass() == tb.getClass();
+        }
+        return !(b instanceof Throwable) && Objects.equals(a, b);
+    }
+
+    /** Invokes a public method reflectively, rethrowing what it throws. */
+    static Object inv(Class<?> cls, Object target, String name, Class<?>[] types, Object... args) {
+        try {
+            return cls.getMethod(name, types).invoke(target, args);
+        } catch (InvocationTargetException e) {
+            Zoo.sneaky(e.getCause());
+            return null;
+        } catch (ReflectiveOperationException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Unit conversion model shared by Temporals.convertAmount and the amount classes
+
+    static final List<TemporalUnit> UNITS = new ArrayList<>();
+    static {
+        UNITS.addAll(Arrays.asList(ChronoUnit.values()));
+        UNITS.add(IsoFields.QUARTER_YEARS);
+        UNITS.add(IsoFields.WEEK_BASED_YEARS);
+    }
+
+    static boolean precise(TemporalUnit u) {
+        return u instanceof ChronoUnit cu && cu.compareTo(WEEKS) <= 0;
+    }
+
+    static int monthFactor(TemporalUnit u) {
+        if (u == IsoFields.QUARTER_YEARS) {
+            return 3;
+        }
+        if (u instanceof ChronoUnit cu) {
+            return switch (cu) {
+                case MONTHS -> 1;
+                case YEARS -> 12;
+                case DECADES -> 120;
+                case CENTURIES -> 1200;
+                case MILLENNIA -> 12000;
+                default -> 0;
+            };
+        }
+        return 0;
+    }
+
+    /** The documented conversion: {whole, remainder}, or the exception class. */
+    static Object convertModel(long amount, TemporalUnit from, TemporalUnit to) {
+        for (TemporalUnit u : List.of(from, to)) {
+            boolean ok = (u instanceof ChronoUnit && u != ChronoUnit.ERAS && u != ChronoUnit.FOREVER) || u == IsoFields.QUARTER_YEARS;
+            if (!ok) {
+                return new UnsupportedTemporalTypeException("");
+            }
+        }
+        if (from.equals(to)) {
+            return new long[] {amount, 0};
+        }
+        long f;
+        long t;
+        if (precise(from) && precise(to)) {
+            f = from.getDuration().toNanos();
+            t = to.getDuration().toNanos();
+        } else if (monthFactor(from) > 0 && monthFactor(to) > 0) {
+            f = monthFactor(from);
+            t = monthFactor(to);
+        } else {
+            return new DateTimeException("");
+        }
+        try {
+            if (f > t) {
+                return new long[] {Math.multiplyExact(amount, f / t), 0};
+            }
+            return new long[] {amount / (t / f), amount % (t / f)};
+        } catch (ArithmeticException e) {
+            return e;
+        }
+    }
+
+    static boolean sameConversion(Object got, Object want) {
+        if (got instanceof long[] g && want instanceof long[] w) {
+            return Arrays.equals(g, w);
+        }
+        return sameOutcome(got, want);
+    }
+
+    static String showConversion(Object o) {
+        return o instanceof long[] a ? Arrays.toString(a) : kind(o);
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Days, Weeks, Months, Years, Hours, Minutes, Seconds
+
+    record Kind(Class<?> cls, TemporalUnit unit, String prefix, String suffix, boolean dateBased) {
+        String name() {
+            return cls.getSimpleName();
+        }
+
+        @Override
+        public String toString() {
+            return name();
+        }
+
+        Object of(int n) {
+            return inv(cls, null, "of", new Class<?>[] {int.class}, n);
+        }
+
+        int amount(Object x) {
+            return (Integer) inv(cls, x, "getAmount", new Class<?>[0]);
+        }
+
+        Object parse(String text) {
+            return inv(cls, null, "parse", new Class<?>[] {CharSequence.class}, text);
+        }
+
+        Object from(TemporalAmount a) {
+            return inv(cls, null, "from", new Class<?>[] {TemporalAmount.class}, a);
+        }
+
+        Object between(Temporal a, Temporal b) {
+            return inv(cls, null, "between", new Class<?>[] {Temporal.class, Temporal.class}, a, b);
+        }
+
+        Object call(Object x, String name) {
+            return inv(cls, x, name, new Class<?>[0]);
+        }
+
+        Object call(Object x, String name, int n) {
+            return inv(cls, x, name, new Class<?>[] {int.class}, n);
+        }
+
+        Object call(Object x, String name, TemporalAmount a) {
+            return inv(cls, x, name, new Class<?>[] {TemporalAmount.class}, a);
+        }
+    }
+
+    static final Kind[] KINDS = {
+        new Kind(Days.class, DAYS, "P", "D", true),
+        new Kind(Weeks.class, WEEKS, "P", "W", true),
+        new Kind(Months.class, MONTHS, "P", "M", true),
+        new Kind(Years.class, YEARS, "P", "Y", true),
+        new Kind(Hours.class, HOURS, "PT", "H", false),
