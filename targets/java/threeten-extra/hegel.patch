+    // Intervals
+
+    @Test
+    void intervalsMatchTheSetModel() {
+        Hegel.test(this::intervalCase, Zoo.settings("threeten.intervals").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
+    }
+
+    /** A member of the pool of instants the intervals are built from. */
+    sealed interface Member permits Shifted, Edge {
+        Instant of(Instant base);
+    }
+
+    /** The base moved by a few seconds and (30%) a nano or a millisecond, kept ten seconds inside the Instant range. */
+    record Shifted(int seconds, int nanos) implements Member {
+        @Override
+        public Instant of(Instant base) {
+            long sec = Math.max(Instant.MIN.getEpochSecond() + 10, Math.min(Instant.MAX.getEpochSecond() - 10, base.getEpochSecond() + seconds));
+            return Instant.ofEpochSecond(sec, base.getNano() + nanos);
+        }
+    }
+
+    /** Instant.MIN or Instant.MAX. */
+    record Edge(boolean max) implements Member {
+        @Override
+        public Instant of(Instant base) {
+            return max ? Instant.MAX : Instant.MIN;
+        }
+    }
+
+    static final Generator<Member> SHIFTED = tuples(ints(-3, 3), maybe(30, 0, sampledFrom(1, -1, 1_000_000))).map(t -> new Shifted(t.value1(), t.value2()));
+    static final Generator<Member> EDGE = booleans().map(Edge::new);
+
+    /** Five members around the base; in 30% of pools each is an edge one time in four. */
+    static final Generator<List<Member>> POOL = chance(30).flatMap(edges -> lists(edges ? weighted(w(75, SHIFTED), w(25, EDGE)) : SHIFTED).minSize(5).maxSize(5));
+
+    /** An interval between the pool members at two indices (the second the same as the first, 15%), the bounds ordered. */
+    record Span(int a, int b, boolean same) {
+        <T extends Comparable<? super T>> T lower(List<T> pool) {
+            T x = pool.get(a);
+            T y = same ? x : pool.get(b);
+            return x.compareTo(y) <= 0 ? x : y;
+        }
+
+        <T extends Comparable<? super T>> T upper(List<T> pool) {
+            T x = pool.get(a);
+            T y = same ? x : pool.get(b);
+            return x.compareTo(y) <= 0 ? y : x;
+        }
+    }
+
+    static final Generator<Span> SPAN = tuples(ints(0, 4), ints(0, 4), chance(15)).map(t -> new Span(t.value1(), t.value2(), t.value3()));
+
+    /** The base instant, the pool around it, two intervals over the pool, the index of the instant to probe, two offsets for the text forms. */
+    record IntervalCase(Instant base, List<Member> pool, Span a, Span b, int probe, ZoneOffset off, ZoneOffset off2) {
+        List<Instant> instants() {
+            return pool.stream().map(m -> m.of(base)).toList();
+        }
+    }
+
+    static final Generator<IntervalCase> INTERVAL_CASE = tuples(INSTANT, POOL, SPAN, SPAN, ints(0, 4), OFFSET, OFFSET)
+            .map(t -> new IntervalCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    static int cmp(Instant a, Instant b) {
+        return a.compareTo(b);
+    }
+
+    void intervalCase(TestCase tc) {
+        IntervalCase ic = tc.draw(INTERVAL_CASE, "case");
+        List<Instant> pool = ic.instants();
+        Interval a = Interval.of(ic.a().lower(pool), ic.a().upper(pool));
+        Interval b = Interval.of(ic.b().lower(pool), ic.b().upper(pool));
+        Instant sa = a.getStart();
+        Instant ea = a.getEnd();
+        Instant sb = b.getStart();
+        Instant eb = b.getEnd();
+        String at = a + " and " + b + ": ";
+        Zoo.check(a.isEmpty() == sa.equals(ea), () -> at + "isEmpty");
+        Zoo.check(a.isUnboundedStart() == sa.equals(Instant.MIN) && a.isUnboundedEnd() == ea.equals(Instant.MAX), () -> at + "isUnbounded");
+        boolean encloses = cmp(sa, sb) <= 0 && cmp(eb, ea) <= 0;
+        boolean abuts = ea.equals(sb) ^ sa.equals(eb);
+        boolean overlaps = a.equals(b) || (cmp(sa, eb) < 0 && cmp(sb, ea) < 0);
+        boolean connected = overlaps || abuts;
+        Zoo.check(a.encloses(b) == encloses, () -> at + "encloses " + a.encloses(b));
+        Zoo.check(a.abuts(b) == abuts, () -> at + "abuts " + a.abuts(b));
+        Zoo.check(a.overlaps(b) == overlaps, () -> at + "overlaps " + a.overlaps(b));
+        Zoo.check(a.isConnected(b) == connected, () -> at + "isConnected " + a.isConnected(b) + " vs overlaps " + overlaps + " or abuts " + abuts);
+        Zoo.check(a.overlaps(b) == (a.isConnected(b) && !a.abuts(b)), () -> at + "overlaps is not (isConnected and not abuts)");
+        Zoo.check(a.abuts(b) == b.abuts(a) && a.overlaps(b) == b.overlaps(a) && a.isConnected(b) == b.isConnected(a), () -> at + "abuts/overlaps/isConnected are not symmetric");
+        Zoo.check(!encloses || a.isConnected(b), () -> at + "encloses but not connected");
+        Interval lo = Interval.of(cmp(sa, sb) <= 0 ? sa : sb, cmp(ea, eb) >= 0 ? ea : eb);
+        Zoo.check(a.span(b).equals(lo), () -> at + "span " + a.span(b) + " vs model " + lo);
+        Zoo.check(a.span(b).encloses(a) && a.span(b).encloses(b), () -> at + "span does not enclose both");
+        Object inter = outcome(() -> a.intersection(b));
+        Object union = outcome(() -> a.union(b));
+        if (connected) {
+            Instant ms = cmp(sa, sb) >= 0 ? sa : sb;
+            Instant me = cmp(ea, eb) <= 0 ? ea : eb;
+            Zoo.check(inter.equals(Interval.of(ms, me)), () -> at + "intersection " + kind(inter) + " vs model " + Interval.of(ms, me));
+            Zoo.check(union.equals(lo), () -> at + "union " + kind(union) + " vs model " + lo);
+            Zoo.check(a.intersection(b).equals(b.intersection(a)) && a.union(b).equals(b.union(a)), () -> at + "intersection/union are not symmetric");
+        } else {
+            Zoo.check(inter instanceof DateTimeException && union instanceof DateTimeException, () -> at + "not connected but intersection " + kind(inter) + ", union " + kind(union));
+        }
+        boolean before = !a.equals(b) && cmp(ea, sb) <= 0;
+        boolean after = !a.equals(b) && cmp(sa, eb) >= 0;
+        Zoo.check(a.isBefore(b) == before, () -> at + "isBefore(interval) " + a.isBefore(b));
+        Zoo.check(a.isAfter(b) == after, () -> at + "isAfter(interval) " + a.isAfter(b));
+        Zoo.check(a.isBefore(b) == b.isAfter(a), () -> at + "isBefore is not the mirror of isAfter");
+        Zoo.check(!(a.isBefore(b) && a.isAfter(b)), () -> at + "both before and after");
+        Zoo.check(!a.isBefore(b) || !a.overlaps(b), () -> at + "before but overlapping");
+
+        // instants
+        Instant i = pool.get(ic.probe());
+        String ati = a + " and instant " + i + ": ";
+        Zoo.check(a.contains(i) == (cmp(sa, i) <= 0 && (cmp(i, ea) < 0 || a.isUnboundedEnd())), () -> ati + "contains " + a.contains(i));
+        Zoo.check(a.isAfter(i) == cmp(sa, i) > 0, () -> ati + "isAfter " + a.isAfter(i));
+        Zoo.check(a.isBefore(i) == (!a.isUnboundedEnd() && cmp(ea, i) <= 0 && cmp(sa, i) < 0), () -> ati + "isBefore " + a.isBefore(i));
+        Zoo.check(a.startsBefore(i) == cmp(sa, i) < 0 && a.startsAtOrBefore(i) == cmp(sa, i) <= 0
+                && a.startsAfter(i) == cmp(sa, i) > 0 && a.startsAtOrAfter(i) == cmp(sa, i) >= 0, () -> ati + "starts*");
+        if (a.isUnboundedEnd()) {
+            Zoo.check(!a.endsBefore(i) && !a.endsAtOrBefore(i) && a.endsAfter(i) && a.endsAtOrAfter(i), () -> ati + "ends* for an unbounded end");
+        } else {
+            Zoo.check(a.endsBefore(i) == cmp(ea, i) < 0 && a.endsAtOrBefore(i) == cmp(ea, i) <= 0
+                    && a.endsAfter(i) == cmp(ea, i) > 0 && a.endsAtOrAfter(i) == cmp(ea, i) >= 0, () -> ati + "ends*");
+        }
+        Object ws = outcome(() -> a.withStart(i));
+        Zoo.check(cmp(i, ea) <= 0 ? ws.equals(Interval.of(i, ea)) : ws instanceof DateTimeException, () -> ati + "withStart " + kind(ws));
+        Object we = outcome(() -> a.withEnd(i));
+        Zoo.check(cmp(sa, i) <= 0 ? we.equals(Interval.of(sa, i)) : we instanceof DateTimeException, () -> ati + "withEnd " + kind(we));
+        Zoo.check(Interval.startingAt(i).equals(Interval.of(i, Instant.MAX)) && Interval.endingAt(i).equals(Interval.of(Instant.MIN, i)), () -> ati + "startingAt/endingAt");
+
+        // duration and text
+        Object dur = outcome(a::toDuration);
+        Object durModel = outcome(() -> Duration.between(sa, ea));
+        Zoo.check(sameOutcome(dur, durModel), () -> at + "toDuration " + kind(dur) + " vs Duration.between " + kind(durModel));
+        Zoo.check(a.toString().equals(sa + "/" + ea), () -> at + "toString " + a);
+        Object parsed = outcome(() -> Interval.parse(a.toString()));
+        Zoo.check(a.equals(parsed), () -> at + "parse(toString) = " + kind(parsed));
+        if (dur instanceof Duration du && Math.abs(sa.getEpochSecond()) < 1_000_000_000_000_000L && Math.abs(ea.getEpochSecond()) < 1_000_000_000_000_000L) {
+            String t1 = sa + "/" + PeriodDuration.of(du);
+            Object p1 = outcome(() -> Interval.parse(t1));
+            Zoo.check(a.equals(p1), () -> at + "parse(" + s(t1) + ") = " + kind(p1));
+            String t2 = PeriodDuration.of(du) + "/" + ea;
+            Object p2 = outcome(() -> Interval.parse(t2));
+            Zoo.check(a.equals(p2), () -> at + "parse(" + s(t2) + ") = " + kind(p2));
+            ZoneOffset off = ic.off();
+            ZoneOffset off2 = ic.off2();
+            Zoo.check(Interval.of(sa, du).equals(a) && Interval.of(du, ea).equals(a), () -> at + "of(start, duration)/of(duration, end)");
+            if (Math.abs(sa.getEpochSecond()) < 1_000_000_000_000_000L - 100_000 && Math.abs(ea.getEpochSecond()) < 1_000_000_000_000_000L - 100_000) {
+                OffsetDateTime os = sa.atOffset(off);
+                OffsetDateTime oe = ea.atOffset(off);
+                String t3 = os + "/" + oe.toLocalDateTime();
+                Object p3 = outcome(() -> Interval.parse(t3));
+                Zoo.check(a.equals(p3), () -> at + "parse(" + s(t3) + ") (end offset implied) = " + kind(p3));
+                String t4 = os + "/" + ea.atOffset(off2);
+                Object p4 = outcome(() -> Interval.parse(t4));
+                Zoo.check(a.equals(p4), () -> at + "parse(" + s(t4) + ") = " + kind(p4));
+                String t5 = os + "/" + PeriodDuration.of(du);
+                Object p5 = outcome(() -> Interval.parse(t5));
+                Zoo.check(a.equals(p5), () -> at + "parse(" + s(t5) + ") = " + kind(p5));
+            }
+        }
+        Zoo.check(a.equals(b) == (sa.equals(sb) && ea.equals(eb)), () -> at + "equals");
+        Zoo.check(!a.equals(b) || a.hashCode() == b.hashCode(), () -> at + "equal but different hash codes");
+    }
