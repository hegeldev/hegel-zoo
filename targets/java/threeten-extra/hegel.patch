+        Zoo.check(DayOfMonth.from(md).getValue() == md.getDayOfMonth() && dm.getValue() == dom && dm.atMonth(Month.FEBRUARY).getDayOfMonth() == Math.min(dom, 29), () -> "DayOfMonth.from/atMonth");
+        Object withDm = outcome(() -> md.with(dm));
+        Zoo.check(dom <= md.lengthOfMonth() ? withDm.equals(md.withDayOfMonth(dom)) : withDm instanceof DateTimeException, () -> md + ".with(DayOfMonth " + dom + ") = " + kind(withDm));
+        int doy = Zoo.n(tc, 1, 366);
+        DayOfYear dy = DayOfYear.of(doy);
+        Object atYear = outcome(() -> dy.atYear(y));
+        Zoo.check(dy.isValidYear(y) == (doy <= md.lengthOfYear()) && (doy <= md.lengthOfYear() ? atYear.equals(LocalDate.ofYearDay(y, doy)) : atYear instanceof DateTimeException), () -> "DayOfYear.of(" + doy + ").atYear(" + y + ") = " + kind(atYear));
+        Zoo.check(DayOfYear.from(md).getValue() == md.getDayOfYear(), () -> "DayOfYear.from(" + md + ")");
+        Quarter q = Quarter.from(md);
+        Zoo.check(q.getValue() == md.get(IsoFields.QUARTER_OF_YEAR) && Quarter.ofMonth(md.getMonthValue()) == q && q.firstMonth().getValue() == (q.getValue() - 1) * 3 + 1, () -> md + " quarter " + q);
+        int qLen = 0;
+        for (int mo = q.firstMonth().getValue(); mo < q.firstMonth().getValue() + 3; mo++) {
+            qLen += YearMonth.of(y, mo).lengthOfMonth();
+        }
+        int fqLen = qLen;
+        Zoo.check(q.length(md.isLeapYear()) == qLen && q.plus(kd) == Quarter.of((int) Math.floorMod(q.getValue() - 1 + kd, 4) + 1), () -> md + " quarter " + q + " length " + q.length(md.isLeapYear()) + " vs " + fqLen + ", plus(" + kd + ") = " + q.plus(kd));
+        Half hf = Half.from(md);
+        Zoo.check(hf.getValue() == (md.getMonthValue() - 1) / 6 + 1 && Half.ofMonth(md.getMonthValue()) == hf && hf.firstMonth().getValue() == (hf.getValue() - 1) * 6 + 1, () -> md + " half " + hf);
+        Zoo.check(hf.length(md.isLeapYear()) == (hf.getValue() == 1 ? (md.isLeapYear() ? 182 : 181) : 184) && hf.plus(kd) == Half.of((int) Math.floorMod(hf.getValue() - 1 + kd, 2) + 1), () -> md + " half " + hf + " length " + hf.length(md.isLeapYear()) + ", plus(" + kd + ") = " + hf.plus(kd));
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // UTC and TAI
+
+    @Test
+    void utcAndTaiInstantsRoundTrip() {
+        Hegel.test(this::scaleCase, Zoo.settings("threeten.scales").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
+    }
+
+    static final long MJD_EPOCH = 40587; // 1970-01-01
+    static final long MJD_TAI_EPOCH = 36204; // 1958-01-01, the TAI epoch
+    static final long TAI_1958_TO_1970 = (MJD_EPOCH - MJD_TAI_EPOCH) * 86400L;
+    static final long NANOS_PER_DAY = 86_400_000_000_000L;
+
+    void scaleCase(TestCase tc) {
+        UtcRules rules = UtcRules.system();
+        long[] leaps = rules.getLeapSecondDates();
+        Zoo.check(leaps.length >= 27 && Arrays.binarySearch(leaps, 41498) >= 0 && Arrays.binarySearch(leaps, 57753) >= 0, () -> "leap second table " + Arrays.toString(leaps));
+        long mjd = switch (Zoo.n(tc, 0, 4)) {
+            case 0 -> Gen.lng(tc, 15_000, 90_000);
+            case 1 -> leaps[Zoo.n(tc, 0, leaps.length - 1)];
+            case 2 -> leaps[Zoo.n(tc, 0, leaps.length - 1)] + Zoo.pick(tc, -1, 1);
+            case 3 -> Gen.lng(tc, MJD_EPOCH - 30_000, MJD_EPOCH + 30_000);
+            default -> Zoo.<Long>pick(tc, MJD_EPOCH, MJD_EPOCH - 1, 41317L, 36204L, 0L, -100_000L, 1_000_000L);
+        };
+        int adj = rules.getLeapSecondAdjustment(mjd);
+        Zoo.check(adj == (Arrays.binarySearch(leaps, mjd) >= 0 && mjd != 41317 ? 1 : 0), () -> "getLeapSecondAdjustment(" + mjd + ") = " + adj);
+        int offset = rules.getTaiOffset(mjd);
+        Zoo.check(rules.getTaiOffset(mjd + 1) == offset + adj, () -> "getTaiOffset(" + (mjd + 1) + ") = " + rules.getTaiOffset(mjd + 1) + " but offset " + offset + " + adjustment " + adj);
+        if (mjd >= 41317) {
+            int count = 0;
+            for (long l : leaps) {
+                if (l < mjd && l != 41317) {
+                    count++;
+                }
+            }
+            int fc = count;
+            Zoo.check(offset == 10 + count, () -> "getTaiOffset(" + mjd + ") = " + offset + " vs 10 + " + fc + " leap seconds before");
+        }
+        long dayNanos = NANOS_PER_DAY + adj * 1_000_000_000L;
+        long nod = switch (Zoo.n(tc, 0, 4)) {
+            case 0 -> Gen.lng(tc, 0, dayNanos - 1);
+            case 1 -> Gen.lng(tc, Math.max(0, dayNanos - 2_000_000_000_000L), dayNanos - 1);
+            case 2 -> Gen.lng(tc, 0, 86_399) * 1_000_000_000L + Zoo.pick(tc, 0, 1, 999_999_999);
+            case 3 -> Zoo.<Long>pick(tc, 0L, dayNanos - 1, NANOS_PER_DAY - 1, NANOS_PER_DAY, NANOS_PER_DAY + 999_999_999L, -1L, dayNanos);
+            default -> Gen.lng(tc, 0, 86_399) * 1_000_000_000L;
+        };
+        Object made = outcome(() -> UtcInstant.ofModifiedJulianDay(mjd, nod));
+        boolean valid = nod >= 0 && nod < dayNanos;
+        Zoo.check(valid ? made instanceof UtcInstant : made instanceof DateTimeException, () -> "UtcInstant.ofModifiedJulianDay(" + mjd + ", " + nod + ") = " + kind(made) + " (day has " + dayNanos + " ns)");
+        if (!(made instanceof UtcInstant u)) {
+            return;
+        }
+        String at = u + " (mjd " + mjd + ", nod " + nod + "): ";
+        Zoo.check(u.getModifiedJulianDay() == mjd && u.getNanoOfDay() == nod, () -> at + "fields");
+        Zoo.check(u.isLeapSecond() == (nod >= NANOS_PER_DAY), () -> at + "isLeapSecond " + u.isLeapSecond());
+        TaiInstant tai = u.toTaiInstant();
+        long taiSecsWant = (mjd - MJD_TAI_EPOCH) * 86400L + nod / 1_000_000_000L + offset;
+        Zoo.check(tai.getTaiSeconds() == taiSecsWant && tai.getNano() == nod % 1_000_000_000L, () -> at + "toTaiInstant " + tai + " vs " + taiSecsWant + "." + nod % 1_000_000_000L);
+        Zoo.check(TaiInstant.of(u).equals(tai) && tai.toUtcInstant().equals(u) && UtcInstant.of(tai).equals(u), () -> at + "TAI round trip " + tai.toUtcInstant());
+        Zoo.check(u.compareTo(tai.toUtcInstant()) == 0 && u.equals(tai.toUtcInstant()) && u.hashCode() == tai.toUtcInstant().hashCode(), () -> at + "equals/hashCode after the round trip");
+        Object parsed = outcome(() -> UtcInstant.parse(u.toString()));
+        Zoo.check(u.equals(parsed), () -> at + "parse(toString " + s(u.toString()) + ") = " + kind(parsed));
+        Object taiParsed = outcome(() -> TaiInstant.parse(tai.toString()));
+        Zoo.check(tai.equals(taiParsed), () -> at + "TaiInstant.parse(" + s(tai.toString()) + ") = " + kind(taiParsed));
+        String tt = tai.toString();
+        Zoo.check(tt.equals(tai.getTaiSeconds() + "." + String.format("%09d", tai.getNano()) + "s(TAI)"), () -> at + "TaiInstant.toString " + s(tt));
+        Instant inst = u.toInstant();
+        UtcInstant back = UtcInstant.of(inst);
+        if (!u.isLeapSecond() && nod < NANOS_PER_DAY - 1_000_000_000_000L) {
+            Zoo.check(back.equals(u), () -> at + "toInstant = " + inst + ", back " + back);
+            Zoo.check(inst.getEpochSecond() == (mjd - MJD_EPOCH) * 86400L + nod / 1_000_000_000L && inst.getNano() == nod % 1_000_000_000L, () -> at + "toInstant " + inst);
+        } else {
+            Zoo.check(Math.abs(back.durationUntil(u).toNanos()) <= 2_000, () -> at + "toInstant = " + inst + ", back " + back + " (leap-second smear)");
+        }
+        Zoo.check(TaiInstant.of(inst).toInstant().equals(inst) && tai.toInstant().equals(inst), () -> at + "TAI <-> Instant " + TaiInstant.of(inst) + " " + tai.toInstant());
+        // arithmetic
+        Duration dur = Zoo.chance(tc, 50) ? Duration.ofSeconds(Zoo.n(tc, -100_000, 100_000), Gen.nanos(tc)) : Gen.duration(tc);
+        Object plus = outcome(() -> u.plus(dur));
+        Object plusWant = outcome(() -> UtcInstant.of(tai.plus(dur)));
+        Zoo.check(sameOutcome(plus, plusWant), () -> at + "plus(" + dur + ") = " + kind(plus) + " vs via TAI " + kind(plusWant));
+        if (plus instanceof UtcInstant up && dur.getSeconds() > -4_000_000_000_000_000_000L && dur.getSeconds() < 4_000_000_000_000_000_000L) {
+            Zoo.check(u.durationUntil(up).equals(dur) && up.minus(dur).equals(u), () -> at + "plus(" + dur + ") = " + up + ", durationUntil " + u.durationUntil(up) + ", minus back " + up.minus(dur));
+            Zoo.check(Integer.signum(u.compareTo(up)) == -Integer.signum(dur.compareTo(Duration.ZERO)) && u.isBefore(up) == dur.compareTo(Duration.ZERO) > 0, () -> at + "compareTo(" + up + ")");
+            Zoo.check(up.toTaiInstant().equals(tai.plus(dur)) && tai.plus(dur).durationUntil(tai).equals(dur.negated()), () -> at + "TAI plus/durationUntil");
+        }
+        TaiInstant t2 = TaiInstant.ofTaiSeconds(Gen.lng(tc, -1_000_000_000L, 5_000_000_000L), Gen.lng(tc, -3_000_000_000L, 3_000_000_000L));
+        Zoo.check(t2.getNano() >= 0 && t2.getNano() < 1_000_000_000, () -> "ofTaiSeconds normalisation " + t2);
+        Zoo.check(Integer.signum(tai.compareTo(t2)) == Integer.signum(tai.durationUntil(t2).negated().compareTo(Duration.ZERO)) || tai.equals(t2), () -> at + "TAI compareTo " + t2 + " vs durationUntil " + tai.durationUntil(t2));
+        Zoo.check(t2.toUtcInstant().toTaiInstant().equals(t2), () -> "TAI " + t2 + " -> UTC " + t2.toUtcInstant() + " -> TAI " + t2.toUtcInstant().toTaiInstant());
+        // Instant -> UTC/TAI on a random instant
+        Instant i = Gen.instant(tc);
+        if (Math.abs(i.getEpochSecond()) < 1_000_000_000_000L) {
+            UtcInstant ui = UtcInstant.of(i);
+            long mjdI = Math.floorDiv(i.getEpochSecond(), 86400L) + MJD_EPOCH;
+            long sod = Math.floorMod(i.getEpochSecond(), 86400L);
+            Zoo.check(ui.getModifiedJulianDay() == mjdI, () -> "UtcInstant.of(" + i + ") = " + ui + " on mjd " + ui.getModifiedJulianDay() + " vs " + mjdI);
+            if (rules.getLeapSecondAdjustment(mjdI) == 0 || sod < 86400 - 1000) {
+                Zoo.check(ui.getNanoOfDay() == sod * 1_000_000_000L + i.getNano(), () -> "UtcInstant.of(" + i + ") = " + ui);
+                TaiInstant ti = TaiInstant.of(i);
+                Zoo.check(ti.getTaiSeconds() == i.getEpochSecond() + TAI_1958_TO_1970 + rules.getTaiOffset(mjdI) && ti.getNano() == i.getNano(), () -> "TaiInstant.of(" + i + ") = " + ti + " with offset " + rules.getTaiOffset(mjdI));
+            }
+            Zoo.check(ui.toInstant().equals(i), () -> "UtcInstant.of(" + i + ") = " + ui + " but toInstant " + ui.toInstant());
+            Instant j = i.plusNanos(Zoo.<Long>pick(tc, 1L, 1000L, 1_000_000_000L, -1L, 500_000_000L, 999L * 1_000_000_000L));
+            Zoo.check(Integer.signum(UtcInstant.of(i).compareTo(UtcInstant.of(j))) == Integer.signum(i.compareTo(j)), () -> "UTC order of " + i + " and " + j + ": " + UtcInstant.of(i) + " vs " + UtcInstant.of(j));
+            Zoo.check(Integer.signum(TaiInstant.of(i).compareTo(TaiInstant.of(j))) == Integer.signum(i.compareTo(j)), () -> "TAI order of " + i + " and " + j);
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/ThreetenExtraPinsTest.java b/hegel/src/test/java/zoo/ThreetenExtraPinsTest.java
new file mode 100644
index 0000000..08cb117
--- /dev/null
+++ b/hegel/src/test/java/zoo/ThreetenExtraPinsTest.java
@@ -0,0 +1,93 @@
+package zoo;
+
+import java.time.Duration;
+import java.time.Period;
+import java.time.chrono.Chronology;
+import java.time.chrono.IsoEra;
+import java.time.format.DateTimeParseException;
+import java.util.Locale;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+import org.threeten.extra.AmountFormats;
+import org.threeten.extra.Days;
+import org.threeten.extra.Temporals;
+import org.threeten.extra.Years;
+import org.threeten.extra.chrono.Symmetry010Chronology;
+import org.threeten.extra.chrono.Symmetry454Chronology;
+
+/**
+ * Pins for the bugs in targets/java/threeten-extra/bugs.toml. Each asserts the correct behaviour and therefore fails
+ * while the bug exists; the ids are the keys of [expected_failures] in target.toml.
+ */
+class ThreetenExtraPinsTest {
+
+    static Object outcome(Supplier<?> f) {
+        try {
+            return f.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String kind(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : "value " + o;
+    }
+
+    /** threeten-extra/1: the Symmetry calendars misjudge leap years before year -2 and lose days before year 0. */
+    @Test
+    void pin_symmetryDatesBeforeYearZero() {
+        for (Chronology c : new Chronology[] {Symmetry454Chronology.INSTANCE, Symmetry010Chronology.INSTANCE}) {
+            // the documented rule: a year is leap when (52 * year + 146) mod 293 < 52; for -3 the remainder is 283
+            Zoo.check(!c.isLeapYear(-3), c.getId() + ".isLeapYear(-3) is true (52 * -3 + 146 = -10, which is 283 mod 293)");
+            Zoo.check(!c.isLeapYear(-6), c.getId() + ".isLeapYear(-6) is true");
+            for (long e : new long[] {-719_527, -721_717, -1_000_000}) {
+                Object d = outcome(() -> c.dateEpochDay(e));
+                Zoo.check(d instanceof java.time.chrono.ChronoLocalDate x && x.toEpochDay() == e,
+                        c.getId() + ".dateEpochDay(" + e + ") = " + kind(d) + (d instanceof java.time.chrono.ChronoLocalDate x ? " with toEpochDay " + x.toEpochDay() : ""));
+            }
+        }
+    }
+
+    /** threeten-extra/2: the Symmetry calendars ignore the era in prolepticYear and date(era, ...). */
+    @Test
+    void pin_symmetryErasRespected() {
+        for (Chronology c : new Chronology[] {Symmetry454Chronology.INSTANCE, Symmetry010Chronology.INSTANCE}) {
+            Zoo.check(c.prolepticYear(IsoEra.BCE, 5) == -4, c.getId() + ".prolepticYear(BCE, 5) = " + c.prolepticYear(IsoEra.BCE, 5));
+            Zoo.check(c.date(IsoEra.BCE, 5, 1, 1).equals(c.date(-4, 1, 1)), c.getId() + ".date(BCE, 5, 1, 1) = " + c.date(IsoEra.BCE, 5, 1, 1));
+        }
+    }
+
+    /** threeten-extra/3: durationToDoubleSeconds throws for durations below about -292 years. */
+    @Test
+    void pin_negativeDurationToDoubleSeconds() {
+        Duration d = Duration.ofSeconds(-10_000_000_000L);
+        Object got = outcome(() -> Temporals.durationToDoubleSeconds(d));
+        Zoo.check(got instanceof Double v && v == -1e10, "durationToDoubleSeconds(" + d + ") = " + kind(got));
+    }
+
+    /** threeten-extra/4: wordBased casts the hour and day counts to int. */
+    @Test
+    void pin_wordBasedHugeHours() {
+        String hours = AmountFormats.wordBased(Duration.ofHours(2_147_483_648L), Locale.ENGLISH);
+        Zoo.check(hours.equals("2147483648 hours"), "wordBased(PT2147483648H) = \"" + hours + "\"");
+        String days = AmountFormats.wordBased(Period.ZERO, Duration.ofHours(51_539_607_552L), Locale.ENGLISH);
+        Zoo.check(days.equals("2147483648 days"), "wordBased(P0D, PT51539607552H) = \"" + days + "\"");
+    }
+
+    /** threeten-extra/5: negative months without years are normalised into years, positive ones are not. */
+    @Test
+    void pin_wordBasedNegativeMonths() {
+        Zoo.check(AmountFormats.wordBased(Period.ofMonths(13), Locale.ENGLISH).equals("13 months"), "wordBased(P13M) is not \"13 months\"");
+        String neg = AmountFormats.wordBased(Period.ofMonths(-13), Locale.ENGLISH);
+        Zoo.check(neg.equals("-13 months"), "wordBased(P-13M) = \"" + neg + "\"");
+    }
+
+    /** threeten-extra/6: the amount parsers throw ArithmeticException, not DateTimeParseException, when the components overflow. */
+    @Test
+    void pin_amountParseOverflowIsParseException() {
+        Object days = outcome(() -> Days.parse("P2147483647W21D"));
+        Zoo.check(days instanceof DateTimeParseException, "Days.parse(\"P2147483647W21D\") = " + kind(days));
+        Object years = outcome(() -> Years.parse("-P-2147483648Y"));
+        Zoo.check(years instanceof DateTimeParseException, "Years.parse(\"-P-2147483648Y\") = " + kind(years));
+    }
+}
