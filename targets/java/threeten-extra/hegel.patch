+        Zoo.check(rules.getTaiOffset(mjd + 1) == offset + adj, () -> "getTaiOffset(" + (mjd + 1) + ") = " + rules.getTaiOffset(mjd + 1) + " but offset " + offset + " + adjustment " + adj);
+        if (mjd >= 41317) {
+            int count = 0;
+            for (long l : leaps) {
+                if (l < mjd && l != 41317) {
+                    count++;
+                }
+            }
+            int fc = count;
