+    static final String[] WORDS = {"year", "month", "week", "day", "hour", "minute", "second", "millisecond"};
+
+    /** The English word-based format of the values, as documented: ", " between, " and " before the last. */
+    static String words(long[] values, int firstUnit) {
+        int nonZero = 0;
+        for (long v : values) {
+            if (v != 0) {
+                nonZero++;
+            }
+        }
+        StringBuilder buf = new StringBuilder();
+        int count = 0;
+        for (int i = 0; i < values.length; i++) {
+            if (values[i] != 0 || (count == 0 && i == values.length - 1)) {
+                buf.append(values[i]).append(' ').append(WORDS[firstUnit + i]).append(Math.abs(values[i]) == 1 ? "" : "s");
+                if (count < nonZero - 2) {
+                    buf.append(", ");
+                } else if (count == nonZero - 2) {
+                    buf.append(" and ");
+                }
+                count++;
+            }
+        }
+        return buf.toString();
+    }
+
+    static long[] periodWords(Period p) {
+        Period n = (p.getYears() < 0) != (p.getMonths() < 0) && p.getYears() != 0 && p.getMonths() != 0 ? p.normalized() : p;
+        long weeks = n.getDays() % 7 == 0 ? n.getDays() / 7 : 0;
+        long days = n.getDays() % 7 == 0 ? 0 : n.getDays();
+        return new long[] {n.getYears(), n.getMonths(), weeks, days};
+    }
+
+    static long[] durationWords(Duration d) {
+        return new long[] {d.toHours(), d.toMinutes() % 60, d.getSeconds() % 60, d.getNano() / 1_000_000};
+    }
+
+    record DurUnit(String text, long nanos) {}
+
+    static final DurUnit[] DUR_UNITS = {
+        new DurUnit("ns", 1), new DurUnit("us", 1_000), new DurUnit("µs", 1_000), new DurUnit("μs", 1_000),
+        new DurUnit("ms", 1_000_000), new DurUnit("s", 1_000_000_000L), new DurUnit("m", 60_000_000_000L), new DurUnit("h", 3_600_000_000_000L),
+    };
+
+    /** One part of a unit-based duration text: a whole number (zero-padded one time in twenty), a fraction of up to twelve digits (40%) and a unit. */
+    record Part(long whole, boolean padded, DurUnit unit, String fraction) {
+        String text() {
+            return (padded ? "0" : "") + whole + (fraction == null ? "" : "." + fraction) + unit.text();
+        }
+
+        /** The exact value in nanoseconds, the fraction truncated at the unit's nanosecond count as the parser does. */
+        BigInteger nanos() {
+            BigInteger n = BigInteger.valueOf(whole).multiply(BigInteger.valueOf(unit.nanos()));
+            if (fraction != null) {
+                n = n.add(new BigInteger(fraction).multiply(BigInteger.valueOf(unit.nanos())).divide(BigInteger.TEN.pow(fraction.length())));
+            }
+            return n;
+        }
+    }
+
+    static final Generator<Part> PART = tuples(weighted(w(70, longs(0, 1000)), w(30, longs(0, Long.MAX_VALUE))), chance(5), sampledFrom(DUR_UNITS),
+            maybe(40, (String) null, text().codepoints('0', '9').minSize(1).maxSize(12)))
+            .map(t -> new Part(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    static final String[] UNIT_JUNK = {"", "-", "1", "1x", "h", "1.h", "1 h", "1h ", " 1h", "1hh", "-+1h", "1e3s", "1,5s", "0.", ".5s", "1d", "00"};
+
+    /** A unit-based duration text: a sign (none half the time), one to four parts, and a junk text. */
+    record UnitText(String sign, List<Part> parts, String junk) {
+        String text() {
+            StringBuilder sb = new StringBuilder(sign);
+            for (Part p : parts) {
+                sb.append(p.text());
+            }
+            return sb.toString();
+        }
+
+        BigInteger nanos() {
+            BigInteger total = BigInteger.ZERO;
+            for (Part p : parts) {
+                total = total.add(p.nanos());
+            }
+            return total;
+        }
+    }
