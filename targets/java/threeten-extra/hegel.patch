+    /**
+     * A day of the chronology whose arithmetic in the property stays inside its range: in years 53..10182 (85%),
+     * anywhere in the range (10%), or one of the notable days (5%).
+     */
+    static Generator<Long> epochDay(Chronology c, int k, int k2) {
+        long lo = (symmetry(c) ? Math.max(firstDay(c), SYMMETRY_FLOOR) : firstDay(c)) + margin(k, k2);
+        long hi = lastDay(c) - margin(k, k2);
