+                    want.add(x);
+                }
+                Zoo.check(got.equals(want), () -> at + "stream " + got);
+                Zoo.check(!want.contains(d) || a.contains(d), () -> atd + "streamed but not contained");
+                Zoo.check(want.contains(d) || !a.contains(d), () -> atd + "contained but not streamed");
+            }
+            Zoo.check(LocalDateRange.of(sa, Period.ofDays((int) Math.min(len, Integer.MAX_VALUE))).equals(a) || len > Integer.MAX_VALUE, () -> at + "of(start, Period)");
+            if (!a.isEmpty()) {
