+import org.threeten.extra.chrono.JulianChronology;
+import org.threeten.extra.chrono.PaxChronology;
+import org.threeten.extra.chrono.Symmetry010Chronology;
+import org.threeten.extra.chrono.Symmetry454Chronology;
+
+/** Properties of ThreeTen-Extra against java.time and independent models: calendars, intervals, ranges, year-parts. */
+class ThreetenExtraTest {
+
+    static String s(Object o) {
+        return Zoo.show(o);
+    }
+
+    /** Runs {@code f} and returns its value, or the exception it threw. */
+    static Object outcome(Supplier<?> f) {
+        try {
+            return f.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String kind(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : "value " + s(o);
+    }
+
+    static boolean sameOutcome(Object a, Object b) {
+        if (a instanceof Throwable ta) {
+            return b instanceof Throwable tb && ta.getClass() == tb.getClass();
+        }
+        return !(b instanceof Throwable) && Objects.equals(a, b);
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Calendars
+
+    static final Chronology[] CHRONOS = {
+        JulianChronology.INSTANCE, CopticChronology.INSTANCE, EthiopicChronology.INSTANCE, BritishCutoverChronology.INSTANCE,
+        DiscordianChronology.INSTANCE, InternationalFixedChronology.INSTANCE, PaxChronology.INSTANCE,
+        Symmetry454Chronology.INSTANCE, Symmetry010Chronology.INSTANCE,
+    };
+
+    static final long CUTOVER_DAY = LocalDate.of(1752, 9, 14).toEpochDay();
+
+    /** Whether the ISO year of the day is comfortably inside the chronology's documented year range. */
+    static boolean inRange(Chronology c, long epochDay) {
+        if (epochDay < LocalDate.MIN.toEpochDay() + 400 || epochDay > LocalDate.MAX.toEpochDay() - 400) {
+            return false;
+        }
+        int isoYear = LocalDate.ofEpochDay(epochDay).getYear();
+        java.time.temporal.ValueRange years = c.range(YEAR);
+        long shift = c == DiscordianChronology.INSTANCE ? -1166 : 0;
+        return isoYear >= years.getMinimum() + shift + 2 && isoYear <= years.getMaximum() + shift - 2;
+    }
+
+    /** Julian calendar day count: proleptic year, month 1..12, day 1..31. */
+    static long julianEpochDay(long y, long m, long d) {
+        long a = (14 - m) / 12;
+        long y2 = y + 4800 - a;
+        long m2 = m + 12 * a - 3;
+        long jdn = d + (153 * m2 + 2) / 5 + 365 * y2 + Math.floorDiv(y2, 4) - 32083;
+        return jdn - 2440588;
+    }
+
+    static int julianMonthLength(long y, int m) {
+        return switch (m) {
+            case 2 -> Math.floorMod(y, 4) == 0 ? 29 : 28;
+            case 4, 6, 9, 11 -> 30;
+            default -> 31;
+        };
+    }
+
+    /** Coptic and Ethiopic day count: thirteen months, the last of five or six days, leap when y mod 4 == 3. */
+    static long alexandrianEpochDay(long epoch, long y, long m, long d) {
+        return epoch + 365 * (y - 1) + Math.floorDiv(y, 4) + 30 * (m - 1) + (d - 1);
+    }
+
+    static int alexandrianMonthLength(long y, int m) {
+        return m < 13 ? 30 : (Math.floorMod(y, 4) == 3 ? 6 : 5);
+    }
+
+    static final long COPTIC_EPOCH = -615558;   // Coptic 0001-01-01 = Julian 0284-08-29
+    static final long ETHIOPIC_EPOCH = -716367; // Ethiopic 0001-01-01 = Julian 0008-08-29
