+        // comparators
+        Comparator<TemporalUnit> uc = Temporals.unitComparator();
+        TemporalUnit u1 = Zoo.pick(tc, UNITS.toArray(new TemporalUnit[0]));
+        TemporalUnit u2 = Zoo.pick(tc, UNITS.toArray(new TemporalUnit[0]));
