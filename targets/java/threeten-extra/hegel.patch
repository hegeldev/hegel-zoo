+    /** An amount, small (60%) or any long, and the units to convert between; a TimeUnit and a ChronoUnit. */
+    record Conversion(long amount, TemporalUnit from, TemporalUnit to, TimeUnit timeUnit, ChronoUnit chronoUnit) {}
+
+    static final Generator<Conversion> CONVERSION = tuples(weighted(w(60, longs(-100_000, 100_000)), w(40, longs(Long.MIN_VALUE, Long.MAX_VALUE))), UNIT, UNIT,
+            sampledFrom(TimeUnit.values()), sampledFrom(ChronoUnit.values()))
+            .map(t -> new Conversion(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    /** The BigDecimal seconds durationFromBigDecimalSeconds is asked about. */
+    sealed interface BigSeconds permits Scaled, Decimal {
+        BigDecimal of(BigDecimal secs);
+    }
+
+    /** The duration's own seconds times a factor. */
+    record Scaled(double factor) implements BigSeconds {
+        @Override
+        public BigDecimal of(BigDecimal secs) {
+            return secs.multiply(BigDecimal.valueOf(factor));
+        }
+    }
+
+    /** Any long, the point moved left by up to 20 places, times 1, 1000 or a million. */
+    record Decimal(long mantissa, int shift, long mult) implements BigSeconds {
+        @Override
+        public BigDecimal of(BigDecimal secs) {
+            return new BigDecimal(mantissa).movePointLeft(shift).multiply(BigDecimal.valueOf(mult));
+        }
+    }
+
+    static final Generator<BigSeconds> SCALED = sampledFrom(1.5, -0.3, 2.0, 1e-12, 7.0, 1e6).map(Scaled::new);
+    static final Generator<BigSeconds> DECIMAL = tuples(longs(Long.MIN_VALUE, Long.MAX_VALUE), ints(0, 20), sampledFrom(1L, 1L, 1000L, 1_000_000L))
+            .map(t -> new Decimal(t.value1(), t.value2(), t.value3()));
