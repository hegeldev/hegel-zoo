+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for ThreeTen-Extra, added by the Hegel zoo (targets/java/threeten-extra). Runs against the
+     org.threeten:threeten-extra artifact that `[run] setup` installs from this checkout into the local Maven
+     repository. Oracles: java.time itself (the ISO calendar, Period/Duration arithmetic, IsoFields) and independent
+     models written in the tests (Julian/Coptic/Ethiopic day counts, interval set algebra, long/BigDecimal
+     arithmetic). -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>threeten-extra-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <threeten.version>1.10.1-SNAPSHOT</threeten.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.threeten</groupId>
+      <artifactId>threeten-extra</artifactId>
+      <version>${threeten.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..500f1a8
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,150 @@
+package zoo;
+
+import dev.hegel.TestCase;
+import java.time.Duration;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+import java.time.Period;
+import java.time.ZoneOffset;
+
+/** Generators shared by the ThreeTen-Extra properties. */
+final class Gen {
+    private Gen() {}
+
+    /** Epoch day of 0001-01-01 and of 9999-12-31. */
+    static final long DAY_0001 = LocalDate.of(1, 1, 1).toEpochDay();
+    static final long DAY_9999 = LocalDate.of(9999, 12, 31).toEpochDay();
+
+    /** A long in [lo, hi], drawn from two ints when the span does not fit one. */
+    static long lng(TestCase tc, long lo, long hi) {
+        long span = hi - lo;
+        if (span >= 0 && span < Integer.MAX_VALUE) {
+            return lo + Zoo.n(tc, 0, (int) span);
+        }
+        long hiPart = Zoo.n(tc, 0, (int) Math.min(Integer.MAX_VALUE, span >>> 31));
+        long v = (hiPart << 31) + Zoo.n(tc, 0, Integer.MAX_VALUE);
+        if (v < 0 || v > span) {
+            v = span;
+        }
+        return lo + v;
+    }
+
+    /** A small signed count, mostly small, sometimes large. */
+    static int count(TestCase tc) {
+        return switch (Zoo.n(tc, 0, 3)) {
+            case 0 -> Zoo.n(tc, -3, 3);
+            case 1 -> Zoo.n(tc, -40, 40);
+            case 2 -> Zoo.n(tc, -2000, 2000);
+            default -> Zoo.n(tc, -1_000_000, 1_000_000);
+        };
+    }
+
+    /** Any int, biased to small values and the extremes. */
+    static int anyInt(TestCase tc) {
+        return switch (Zoo.n(tc, 0, 4)) {
+            case 0 -> Zoo.n(tc, -10, 10);
+            case 1 -> Zoo.n(tc, -100_000, 100_000);
+            case 2 -> Zoo.pick(tc, Integer.MIN_VALUE, Integer.MIN_VALUE + 1, Integer.MAX_VALUE, Integer.MAX_VALUE - 1, 0);
+            default -> Zoo.n(tc, Integer.MIN_VALUE, Integer.MAX_VALUE);
+        };
+    }
+
+    /** A date: mostly near the present, sometimes anywhere in years 1..9999, rarely at the extremes. */
+    static LocalDate date(TestCase tc) {
+        return switch (Zoo.n(tc, 0, 9)) {
+            case 0, 1, 2, 3 -> LocalDate.ofEpochDay(Zoo.n(tc, -30_000, 30_000));
+            case 4, 5, 6 -> LocalDate.ofEpochDay(lng(tc, DAY_0001, DAY_9999));
+            case 7 -> LocalDate.of(Zoo.n(tc, 1700, 1800), Zoo.n(tc, 1, 12), Zoo.n(tc, 1, 28));
+            case 8 -> LocalDate.ofEpochDay(lng(tc, LocalDate.of(-999_999, 1, 1).toEpochDay(), LocalDate.of(999_999, 12, 31).toEpochDay()));
+            default -> Zoo.pick(tc, LocalDate.MIN, LocalDate.MIN.plusDays(1), LocalDate.MAX, LocalDate.MAX.minusDays(1),
+                    LocalDate.of(0, 1, 1), LocalDate.of(1, 1, 1), LocalDate.of(9999, 12, 31), LocalDate.of(1752, 9, 2),
+                    LocalDate.of(1752, 9, 14), LocalDate.of(2000, 2, 29), LocalDate.of(1970, 1, 1));
+        };
+    }
+
+    /** A date in years 1000..9999 (the packed-date range) or nearby. */
+    static LocalDate midDate(TestCase tc) {
+        return LocalDate.ofEpochDay(lng(tc, LocalDate.of(999, 12, 20).toEpochDay(), LocalDate.of(10000, 1, 10).toEpochDay()));
+    }
+
+    static LocalTime time(TestCase tc) {
+        return switch (Zoo.n(tc, 0, 3)) {
+            case 0 -> LocalTime.of(Zoo.n(tc, 0, 23), Zoo.n(tc, 0, 59));
+            case 1 -> LocalTime.of(Zoo.n(tc, 0, 23), Zoo.n(tc, 0, 59), Zoo.n(tc, 0, 59));
+            case 2 -> LocalTime.ofNanoOfDay(lng(tc, 0, 86_399_999_999_999L));
+            default -> Zoo.pick(tc, LocalTime.MIDNIGHT, LocalTime.MAX, LocalTime.NOON, LocalTime.of(23, 59, 59));
+        };
+    }
+
+    static LocalDateTime dateTime(TestCase tc) {
+        return LocalDateTime.of(date(tc), time(tc));
+    }
+
+    static ZoneOffset offset(TestCase tc) {
+        return switch (Zoo.n(tc, 0, 3)) {
+            case 0 -> ZoneOffset.UTC;
+            case 1 -> ZoneOffset.ofHours(Zoo.n(tc, -18, 18));
+            case 2 -> {
+                int h = Zoo.n(tc, -17, 17);
+                int mi = Zoo.pick(tc, 0, 30, 45, 15);
+                yield ZoneOffset.ofHoursMinutes(h, h < 0 ? -mi : mi);
+            }
+            default -> ZoneOffset.ofTotalSeconds(Zoo.n(tc, -64_800, 64_800));
+        };
+    }
+
+    /** Epoch seconds: mostly recent, sometimes far, rarely at the Instant range. */
+    static long epochSecond(TestCase tc) {
+        return switch (Zoo.n(tc, 0, 5)) {
+            case 0, 1 -> lng(tc, -2_000_000_000L, 4_000_000_000L);
+            case 2 -> lng(tc, -100_000_000_000L, 100_000_000_000L);
+            case 3 -> lng(tc, Instant.MIN.getEpochSecond(), Instant.MAX.getEpochSecond());
+            case 4 -> lng(tc, -1_000_000, 1_000_000);
+            default -> Zoo.pick(tc, 0L, -1L, 86_399L, 86_400L, Instant.MIN.getEpochSecond(), Instant.MAX.getEpochSecond(),
+                    LocalDateTime.of(2016, 12, 31, 23, 59, 59).toEpochSecond(ZoneOffset.UTC),
+                    LocalDateTime.of(1972, 6, 30, 23, 59, 59).toEpochSecond(ZoneOffset.UTC),
+                    LocalDateTime.of(1958, 1, 1, 0, 0).toEpochSecond(ZoneOffset.UTC));
+        };
+    }
+
+    static int nanos(TestCase tc) {
+        return switch (Zoo.n(tc, 0, 3)) {
+            case 0 -> 0;
+            case 1 -> Zoo.n(tc, 0, 999) * 1_000_000;
+            case 2 -> Zoo.pick(tc, 1, 999_999_999, 500_000_000, 999_999_000, 1_000);
+            default -> Zoo.n(tc, 0, 999_999_999);
+        };
+    }
+
+    static Instant instant(TestCase tc) {
+        return Instant.ofEpochSecond(epochSecond(tc), nanos(tc));
+    }
+
+    /** A duration of mixed sizes and signs. */
+    static Duration duration(TestCase tc) {
+        return switch (Zoo.n(tc, 0, 5)) {
+            case 0 -> Duration.ofSeconds(Zoo.n(tc, -100, 100), nanos(tc));
+            case 1 -> Duration.ofSeconds(count(tc) * 60L, 0);
+            case 2 -> Duration.ofSeconds(lng(tc, -100_000_000_000L, 100_000_000_000L), nanos(tc));
+            case 3 -> Duration.ofSeconds(count(tc), Zoo.chance(tc, 50) ? 0 : -nanos(tc));
+            case 4 -> Zoo.pick(tc, Duration.ZERO, Duration.ofSeconds(Long.MAX_VALUE, 999_999_999), Duration.ofSeconds(Long.MIN_VALUE),
+                    Duration.ofNanos(1), Duration.ofNanos(-1), Duration.ofDays(1), Duration.ofDays(-1), Duration.ofHours(Integer.MAX_VALUE + 1L),
+                    Duration.ofSeconds(-10_000_000_000L));
+            default -> Duration.ofSeconds(lng(tc, Long.MIN_VALUE, Long.MAX_VALUE), nanos(tc));
+        };
+    }
+
+    /** A period of mixed sizes and signs. */
+    static Period period(TestCase tc) {
+        return switch (Zoo.n(tc, 0, 4)) {
+            case 0 -> Period.of(Zoo.n(tc, -3, 3), Zoo.n(tc, -15, 15), Zoo.n(tc, -40, 40));
+            case 1 -> Period.ofDays(count(tc));
+            case 2 -> Period.of(count(tc), count(tc), count(tc));
+            case 3 -> Zoo.pick(tc, Period.ZERO, Period.ofYears(Integer.MAX_VALUE), Period.ofMonths(Integer.MIN_VALUE), Period.ofDays(Integer.MAX_VALUE),
+                    Period.ofWeeks(3), Period.ofDays(-7), Period.of(1, -1, 0), Period.of(-1, 13, 0));
+            default -> Period.of(anyInt(tc), anyInt(tc), anyInt(tc));
+        };
+    }
+}
