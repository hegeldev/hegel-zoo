+        Duration dur = sc.dur();
+        Object plus = outcome(() -> u.plus(dur));
+        Object plusWant = outcome(() -> UtcInstant.of(tai.plus(dur)));
+        Zoo.check(sameOutcome(plus, plusWant), () -> at + "plus(" + dur + ") = " + kind(plus) + " vs via TAI " + kind(plusWant));
+        if (plus instanceof UtcInstant up && dur.getSeconds() > -4_000_000_000_000_000_000L && dur.getSeconds() < 4_000_000_000_000_000_000L) {
+            Zoo.check(u.durationUntil(up).equals(dur) && up.minus(dur).equals(u), () -> at + "plus(" + dur + ") = " + up + ", durationUntil " + u.durationUntil(up) + ", minus back " + up.minus(dur));
+            Zoo.check(Integer.signum(u.compareTo(up)) == -Integer.signum(dur.compareTo(Duration.ZERO)) && u.isBefore(up) == dur.compareTo(Duration.ZERO) > 0, () -> at + "compareTo(" + up + ")");
+            Zoo.check(up.toTaiInstant().equals(tai.plus(dur)) && tai.plus(dur).durationUntil(tai).equals(dur.negated()), () -> at + "TAI plus/durationUntil");
+        }
+        TaiInstant t2 = TaiInstant.ofTaiSeconds(sc.taiSeconds(), sc.taiNanos());
+        Zoo.check(t2.getNano() >= 0 && t2.getNano() < 1_000_000_000, () -> "ofTaiSeconds normalisation " + t2);
+        Zoo.check(Integer.signum(tai.compareTo(t2)) == Integer.signum(tai.durationUntil(t2).negated().compareTo(Duration.ZERO)) || tai.equals(t2), () -> at + "TAI compareTo " + t2 + " vs durationUntil " + tai.durationUntil(t2));
+        Zoo.check(t2.toUtcInstant().toTaiInstant().equals(t2), () -> "TAI " + t2 + " -> UTC " + t2.toUtcInstant() + " -> TAI " + t2.toUtcInstant().toTaiInstant());
+        // Instant -> UTC/TAI on a random instant
+        Instant i = sc.instant();
+        if (Math.abs(i.getEpochSecond()) < 1_000_000_000_000L) {
+            UtcInstant ui = UtcInstant.of(i);
+            long mjdI = Math.floorDiv(i.getEpochSecond(), 86400L) + MJD_EPOCH;
+            long sod = Math.floorMod(i.getEpochSecond(), 86400L);
+            Zoo.check(ui.getModifiedJulianDay() == mjdI, () -> "UtcInstant.of(" + i + ") = " + ui + " on mjd " + ui.getModifiedJulianDay() + " vs " + mjdI);
+            if (rules.getLeapSecondAdjustment(mjdI) == 0 || sod < 86400 - 1000) {
+                Zoo.check(ui.getNanoOfDay() == sod * 1_000_000_000L + i.getNano(), () -> "UtcInstant.of(" + i + ") = " + ui);
+                TaiInstant ti = TaiInstant.of(i);
+                Zoo.check(ti.getTaiSeconds() == i.getEpochSecond() + TAI_1958_TO_1970 + rules.getTaiOffset(mjdI) && ti.getNano() == i.getNano(), () -> "TaiInstant.of(" + i + ") = " + ti + " with offset " + rules.getTaiOffset(mjdI));
+            }
+            Zoo.check(ui.toInstant().equals(i), () -> "UtcInstant.of(" + i + ") = " + ui + " but toInstant " + ui.toInstant());
+            Instant j = i.plusNanos(sc.jump());
+            Zoo.check(Integer.signum(UtcInstant.of(i).compareTo(UtcInstant.of(j))) == Integer.signum(i.compareTo(j)), () -> "UTC order of " + i + " and " + j + ": " + UtcInstant.of(i) + " vs " + UtcInstant.of(j));
+            Zoo.check(Integer.signum(TaiInstant.of(i).compareTo(TaiInstant.of(j))) == Integer.signum(i.compareTo(j)), () -> "TAI order of " + i + " and " + j);
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/ThreetenExtraPinsTest.java b/hegel/src/test/java/zoo/ThreetenExtraPinsTest.java
