+    /** The exact conversion of {@code amount} of {@code unit} into whole {@code kind}s, or the exception. */
+    static Object fromModel(Kind kind, TemporalAmount a) {
+        try {
+            // an int running total, as in the library: both exceptions are documented, and when the total overflows before an
+            // inconvertible unit is reached (Months.from(P-4894Y-2147483648M-1D)) the overflow is reported
+            int total = 0;
+            for (TemporalUnit u : a.getUnits()) {
+                long v = a.get(u);
+                if (v == 0) {
+                    continue;
+                }
+                Object conv = convertModel(v, u, kind.unit());
+                if (conv instanceof long[] c) {
+                    if (c[1] != 0) {
+                        return new DateTimeException("remainder");
+                    }
+                    total = Math.addExact(total, Math.toIntExact(c[0]));
+                } else if (conv instanceof DateTimeException e) {
+                    return e;
+                } else {
+                    return conv;
+                }
+            }
+            return kind.of(total);
+        } catch (ArithmeticException e) {
+            return e;
+        }
+    }
+
+    static Object exact(Supplier<Integer> f) {
+        try {
+            return f.get();
+        } catch (ArithmeticException e) {
+            return e;
+        }
+    }
+
+    static boolean amountIs(Kind kind, Object got, Object want) {
+        if (want instanceof Integer n) {
+            return !(got instanceof Throwable) && got != null && kind.amount(got) == n;
+        }
+        return sameOutcome(got, want);
+    }
