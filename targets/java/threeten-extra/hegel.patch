+        int y = d.get(YEAR);
+        int m = d.get(MONTH_OF_YEAR);
+        int dom = d.get(DAY_OF_MONTH);
+        int doy = d.get(DAY_OF_YEAR);
+        int lom = d.lengthOfMonth();
