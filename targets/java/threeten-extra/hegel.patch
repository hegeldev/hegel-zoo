+            Zoo.check(LocalDateRange.from(d).equals(LocalDateRange.ofClosed(d, d)), () -> atd + "from(date) " + LocalDateRange.from(d));
+            Zoo.check(LocalDateRange.from(d.atTime(rc.time())).equals(LocalDateRange.ofClosed(d, d)), () -> atd + "from(date-time)");
+            if (Math.abs(d.getYear()) < 999_000_000) {
+                YearMonth ym = YearMonth.from(d);
+                Zoo.check(LocalDateRange.from(ym).equals(LocalDateRange.ofClosed(ym.atDay(1), ym.atEndOfMonth())), () -> atd + "from(YearMonth)");
+                Zoo.check(LocalDateRange.from(Year.from(d)).equals(LocalDateRange.ofClosed(d.withDayOfYear(1), d.withDayOfYear(d.lengthOfYear()))), () -> atd + "from(Year)");
+                YearQuarter yq = YearQuarter.from(d);
+                Zoo.check(LocalDateRange.from(yq).equals(LocalDateRange.ofClosed(yq.atDay(1), yq.atEndOfQuarter())), () -> atd + "from(YearQuarter)");
+                YearWeek yw = YearWeek.from(d);
+                Zoo.check(LocalDateRange.from(yw).equals(LocalDateRange.ofClosed(yw.atDay(DayOfWeek.MONDAY), yw.atDay(DayOfWeek.SUNDAY))), () -> atd + "from(YearWeek)");
+                Zoo.check(LocalDateRange.from(yw).contains(d), () -> atd + "from(YearWeek) does not contain the date");
+            }
+        }
+        // text
+        Zoo.check(a.toString().equals(sa + "/" + ea), () -> at + "toString " + a);
+        Object parsed = outcome(() -> LocalDateRange.parse(a.toString()));
+        Zoo.check(a.equals(parsed), () -> at + "parse(toString) = " + kind(parsed));
+        if (!a.isUnboundedStart() && !a.isUnboundedEnd() && a.lengthInDays() < Integer.MAX_VALUE) {
+            String t1 = sa + "/" + Period.ofDays(a.lengthInDays());
+            Object p1 = outcome(() -> LocalDateRange.parse(t1));
+            Zoo.check(a.equals(p1), () -> at + "parse(" + s(t1) + ") = " + kind(p1));
+            String t2 = Period.ofDays(a.lengthInDays()) + "/" + ea;
+            Object p2 = outcome(() -> LocalDateRange.parse(t2));
+            Zoo.check(a.equals(p2), () -> at + "parse(" + s(t2) + ") = " + kind(p2));
+            String t3 = sa + "/" + Period.between(sa, ea);
+            Object p3 = outcome(() -> LocalDateRange.parse(t3));
+            Zoo.check(a.equals(p3), () -> at + "parse(" + s(t3) + ") = " + kind(p3));
+        }
+        Zoo.check(a.equals(b) == (sa.equals(sb) && ea.equals(eb)), () -> at + "equals");
+        Zoo.check(!a.equals(b) || a.hashCode() == b.hashCode(), () -> at + "equal but different hash codes");
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Weeks, quarters, halves
+
+    @Test
+    void yearPartsMatchJavaTime() {
+        Hegel.test(this::yearPartCase, Zoo.settings("threeten.yearParts").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
+    }
+
+    static String yearText(int year) {
+        int abs = Math.abs(year);
+        String digits = abs < 1000 ? String.format("%04d", abs) : Integer.toString(abs);
+        return year < 0 ? "-" + digits : year > 9999 ? "+" + digits : digits;
+    }
+
+    static long quarterIndex(YearQuarter q) {
+        return q.getYear() * 4L + q.getQuarterValue() - 1;
+    }
+
+    static long halfIndex(YearHalf h) {
+        return h.getYear() * 2L + h.getHalfValue() - 1;
+    }
+
+    /** A date; weeks, quarters or halves to add; years to add; a week number around the valid ones; a day count to another date; a day of the quarter and of the half; a time. */
+    record YearPartCase(LocalDate date, int k, int years, int week, int shift, int quarterDay, int halfDay, LocalTime time) {}
+
+    static final Generator<YearPartCase> YEAR_PART_CASE = tuples(INNER_DATE, ints(-2000, 2000), ints(-400, 400), ints(0, 54), ints(-400, 400), ints(0, 93), ints(0, 185), TIME)
+            .map(t -> new YearPartCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    void yearPartCase(TestCase tc) {
+        YearPartCase yc = tc.draw(YEAR_PART_CASE, "case");
+        LocalDate d = yc.date();
+        LocalDate fd = d;
+        int k = yc.k();
+        // ISO weeks
+        YearWeek yw = YearWeek.from(d);
+        String atw = d + " -> " + yw + ": ";
+        int wby = d.get(WEEK_BASED_YEAR);
+        int wowby = d.get(WEEK_OF_WEEK_BASED_YEAR);
+        Zoo.check(yw.getYear() == wby && yw.getWeek() == wowby, () -> atw + "java.time says " + wby + "-W" + wowby);
+        Zoo.check(yw.atDay(fd.getDayOfWeek()).equals(fd), () -> atw + "atDay(" + fd.getDayOfWeek() + ") = " + yw.atDay(fd.getDayOfWeek()));
+        Zoo.check(YearWeek.of(wby, wowby).equals(yw), () -> atw + "of(" + wby + ", " + wowby + ") = " + YearWeek.of(wby, wowby));
+        Zoo.check(YearWeek.of(Year.of(wby), wowby).equals(yw), () -> atw + "of(Year, week)");
+        boolean is53 = d.range(WEEK_OF_WEEK_BASED_YEAR).getMaximum() == 53;
+        Zoo.check(yw.is53WeekYear() == is53, () -> atw + "is53WeekYear " + yw.is53WeekYear() + " but java.time gives " + fd.range(WEEK_OF_WEEK_BASED_YEAR));
+        Zoo.check(yw.lengthOfYear() == (is53 ? 371 : 364), () -> atw + "lengthOfYear " + yw.lengthOfYear());
+        Zoo.check(yw.range(WEEK_OF_WEEK_BASED_YEAR).getMaximum() == (is53 ? 53 : 52), () -> atw + "range(WEEK_OF_WEEK_BASED_YEAR) " + yw.range(WEEK_OF_WEEK_BASED_YEAR));
+        Zoo.check(yw.get(WEEK_BASED_YEAR) == wby && yw.getLong(WEEK_OF_WEEK_BASED_YEAR) == wowby, () -> atw + "get(field)");
+        String wt = yearText(wby) + "-W" + (wowby < 10 ? "0" : "") + wowby;
+        Zoo.check(yw.toString().equals(wt), () -> atw + "toString " + s(yw.toString()) + " vs model " + s(wt));
+        Object wp = outcome(() -> YearWeek.parse(yw.toString()));
+        Zoo.check(yw.equals(wp), () -> atw + "parse(toString) = " + kind(wp));
+        Zoo.check(yw.plusWeeks(k).atDay(DayOfWeek.MONDAY).equals(yw.atDay(DayOfWeek.MONDAY).plusWeeks(k)), () -> atw + "plusWeeks(" + k + ") = " + yw.plusWeeks(k) + ", Monday " + yw.plusWeeks(k).atDay(DayOfWeek.MONDAY) + " vs " + yw.atDay(DayOfWeek.MONDAY).plusWeeks(k));
+        Zoo.check(yw.minusWeeks(k).equals(yw.plusWeeks(-k)) && yw.plus(k, WEEKS).equals(yw.plusWeeks(k)), () -> atw + "minusWeeks/plus(WEEKS)");
+        YearWeek yw2 = yw.plusWeeks(k);
+        Zoo.check(yw.until(yw2, WEEKS) == k, () -> atw + "until(" + yw2 + ", WEEKS) = " + yw.until(yw2, WEEKS) + " vs " + k);
+        Zoo.check(Integer.signum(yw.compareTo(yw2)) == Integer.signum(-k) && yw.isBefore(yw2) == (k > 0) && yw.isAfter(yw2) == (k < 0), () -> atw + "compareTo " + yw2);
+        int ky = yc.years();
+        YearWeek ywy = yw.plusYears(ky);
+        Zoo.check(ywy.getYear() == wby + ky && (ywy.getWeek() == wowby || (wowby == 53 && ywy.getWeek() == 52 && !ywy.is53WeekYear())), () -> atw + "plusYears(" + ky + ") = " + ywy);
+        Zoo.check(yw.withYear(wby + ky).equals(ywy), () -> atw + "withYear(" + (wby + ky) + ") = " + yw.withYear(wby + ky) + " vs plusYears " + ywy);
+        int w = yc.week();
+        Object ofW = outcome(() -> YearWeek.of(wby, w));
+        if (w >= 1 && w <= (is53 ? 53 : 52)) {
+            Zoo.check(ofW instanceof YearWeek x && x.getYear() == wby && x.getWeek() == w, () -> "YearWeek.of(" + wby + ", " + w + ") = " + kind(ofW));
+            Zoo.check(yw.withWeek(w).equals(ofW) && yw.with(WEEK_OF_WEEK_BASED_YEAR, w).equals(ofW), () -> atw + "withWeek(" + w + ") = " + yw.withWeek(w));
+        } else if (w == 53) {
+            Zoo.check(ofW.equals(YearWeek.of(wby + 1, 1)), () -> "YearWeek.of(" + wby + ", 53) in a 52-week year = " + kind(ofW));
+        } else {
+            Zoo.check(ofW instanceof DateTimeException, () -> "YearWeek.of(" + wby + ", " + w + ") = " + kind(ofW));
+        }
+        Zoo.check(YearWeek.from(d.atTime(yc.time())).equals(yw), () -> atw + "from(date-time)");
+        Zoo.check(YearWeek.from(JulianChronology.INSTANCE.date(fd)).equals(yw), () -> atw + "from(JulianDate) " + YearWeek.from(JulianChronology.INSTANCE.date(fd)));
+        LocalDate other = fd.plusDays(yc.shift());
+        LocalDate adjusted = other.with(yw);
+        Zoo.check(adjusted.equals(yw.atDay(other.getDayOfWeek())), () -> atw + other + ".with(" + yw + ") = " + adjusted + " vs atDay(" + other.getDayOfWeek() + ") " + yw.atDay(other.getDayOfWeek()));
+
+        // quarters
+        YearQuarter yq = YearQuarter.from(d);
+        String atq = d + " -> " + yq + ": ";
+        int q = d.get(QUARTER_OF_YEAR);
+        Zoo.check(yq.getYear() == fd.getYear() && yq.getQuarterValue() == q, () -> atq + "java.time says quarter " + q);
+        LocalDate qStart = LocalDate.of(fd.getYear(), (q - 1) * 3 + 1, 1);
+        LocalDate qEnd = YearMonth.of(fd.getYear(), q * 3).atEndOfMonth();
+        int qLen = (int) (qEnd.toEpochDay() - qStart.toEpochDay() + 1);
+        Zoo.check(yq.atDay(1).equals(qStart) && yq.atEndOfQuarter().equals(qEnd), () -> atq + "atDay(1) " + yq.atDay(1) + ", atEndOfQuarter " + yq.atEndOfQuarter());
+        Zoo.check(yq.lengthOfQuarter() == qLen && yq.lengthOfYear() == fd.lengthOfYear() && yq.isLeapYear() == fd.isLeapYear(), () -> atq + "lengthOfQuarter " + yq.lengthOfQuarter() + " vs " + qLen);
+        int dq = yc.quarterDay();
+        Object atDq = outcome(() -> yq.atDay(dq));
+        Zoo.check(yq.isValidDay(dq) == (dq >= 1 && dq <= qLen), () -> atq + "isValidDay(" + dq + ")");
+        Zoo.check(dq >= 1 && dq <= qLen ? atDq.equals(qStart.plusDays(dq - 1)) : atDq instanceof DateTimeException, () -> atq + "atDay(" + dq + ") = " + kind(atDq));
+        String qt = yearText(fd.getYear()) + "-Q" + q;
+        Zoo.check(yq.toString().equals(qt), () -> atq + "toString " + s(yq.toString()) + " vs model " + s(qt));
+        Object qp = outcome(() -> YearQuarter.parse(yq.toString()));
+        Zoo.check(yq.equals(qp), () -> atq + "parse(toString) = " + kind(qp));
+        YearQuarter yq2 = yq.plusQuarters(k);
+        long qi = quarterIndex(yq) + k;
+        Zoo.check(yq2.getYear() == Math.floorDiv(qi, 4) && yq2.getQuarterValue() == Math.floorMod(qi, 4) + 1, () -> atq + "plusQuarters(" + k + ") = " + yq2);
+        Zoo.check(yq.plus(k, QUARTER_YEARS).equals(yq2) && yq.minusQuarters(-k).equals(yq2), () -> atq + "plus(QUARTER_YEARS)/minusQuarters");
+        Zoo.check(yq.until(yq2, QUARTER_YEARS) == k, () -> atq + "until(" + yq2 + ", QUARTER_YEARS) = " + yq.until(yq2, QUARTER_YEARS));
+        Zoo.check(yq.until(yq2, YEARS) == yq.atDay(1).until(yq2.atDay(1), YEARS), () -> atq + "until(" + yq2 + ", YEARS) = " + yq.until(yq2, YEARS) + " vs java.time " + yq.atDay(1).until(yq2.atDay(1), YEARS));
+        Zoo.check(yq.atDay(1).until(yq2.atDay(1), QUARTER_YEARS) == k, () -> atq + "java.time QUARTER_YEARS between quarter starts " + yq.atDay(1).until(yq2.atDay(1), QUARTER_YEARS));
+        if (k >= 0 && k <= 50) {
+            List<YearQuarter> qs = yq.quartersUntil(yq2).toList();
+            Zoo.check(qs.size() == k && (k == 0 || (qs.get(0).equals(yq) && qs.get(k - 1).equals(yq2.minusQuarters(1)))), () -> atq + "quartersUntil(" + yq2 + ") = " + qs);
+        }
+        Zoo.check(yq.plusYears(ky).equals(YearQuarter.of(fd.getYear() + ky, q)) && yq.withYear(fd.getYear() + ky).equals(yq.plusYears(ky)), () -> atq + "plusYears(" + ky + ")");
+        Zoo.check(Integer.signum(yq.compareTo(yq2)) == Integer.signum(-k), () -> atq + "compareTo " + yq2);
+        Zoo.check(YearQuarter.of(fd.getYear(), q).equals(yq) && YearQuarter.of(Year.of(fd.getYear()), q).equals(yq), () -> atq + "of");
+        Zoo.check(YearQuarter.from(d.atTime(yc.time())).equals(yq) && YearQuarter.from(YearMonth.from(d)).equals(yq), () -> atq + "from(date-time)/from(YearMonth)");
+        Zoo.check(yq.get(QUARTER_OF_YEAR) == q && yq.get(YEAR) == fd.getYear(), () -> atq + "get(field)");
+
+        // halves
+        YearHalf yh = YearHalf.from(d);
+        String ath = d + " -> " + yh + ": ";
+        int h = (d.getMonthValue() - 1) / 6 + 1;
+        Zoo.check(yh.getYear() == fd.getYear() && yh.getHalfValue() == h, () -> ath + "model half " + h);
+        LocalDate hStart = LocalDate.of(fd.getYear(), (h - 1) * 6 + 1, 1);
+        LocalDate hEnd = YearMonth.of(fd.getYear(), h * 6).atEndOfMonth();
+        int hLen = (int) (hEnd.toEpochDay() - hStart.toEpochDay() + 1);
+        Zoo.check(yh.atDay(1).equals(hStart) && yh.atEndOfHalf().equals(hEnd) && yh.lengthOfHalf() == hLen, () -> ath + "atDay(1) " + yh.atDay(1) + ", atEndOfHalf " + yh.atEndOfHalf() + ", lengthOfHalf " + yh.lengthOfHalf());
+        int dh = yc.halfDay();
+        Object atDh = outcome(() -> yh.atDay(dh));
+        Zoo.check(yh.isValidDay(dh) == (dh >= 1 && dh <= hLen), () -> ath + "isValidDay(" + dh + ")");
+        Zoo.check(dh >= 1 && dh <= hLen ? atDh.equals(hStart.plusDays(dh - 1)) : atDh instanceof DateTimeException, () -> ath + "atDay(" + dh + ") = " + kind(atDh));
+        Object hp = outcome(() -> YearHalf.parse(yh.toString()));
+        Zoo.check(yh.equals(hp), () -> ath + "parse(toString " + s(yh.toString()) + ") = " + kind(hp));
+        Zoo.check(yh.toString().equals(yearText(fd.getYear()) + "-H" + h), () -> ath + "toString " + s(yh.toString()));
+        YearHalf yh2 = yh.plusHalves(k);
+        long hi = halfIndex(yh) + k;
+        Zoo.check(yh2.getYear() == Math.floorDiv(hi, 2) && yh2.getHalfValue() == Math.floorMod(hi, 2) + 1, () -> ath + "plusHalves(" + k + ") = " + yh2);
+        Zoo.check(yh.until(yh2, YEARS) == yh.atDay(1).until(yh2.atDay(1), YEARS), () -> ath + "until(" + yh2 + ", YEARS) = " + yh.until(yh2, YEARS) + " vs java.time " + yh.atDay(1).until(yh2.atDay(1), YEARS));
+        Zoo.check(yh.plusYears(ky).equals(YearHalf.of(fd.getYear() + ky, h)), () -> ath + "plusYears(" + ky + ") = " + yh.plusYears(ky));
+        Zoo.check(YearHalf.from(YearQuarter.from(d)).equals(yh) && YearHalf.from(YearMonth.from(d)).equals(yh), () -> ath + "from(YearQuarter)/from(YearMonth)");
+        Zoo.check(Integer.signum(yh.compareTo(yh2)) == Integer.signum(-k), () -> ath + "compareTo " + yh2);
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..d4b8f0a
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,94 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+
+    /** Rethrows any throwable unchecked (for control-flow exceptions such as Hegel's that must not be swallowed). */
+    @SuppressWarnings("unchecked")
+    static <T extends Throwable> void sneaky(Throwable t) throws T {
+        throw (T) t;
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
