+
+    static final long MJD_EPOCH = 40587; // 1970-01-01
+    static final long MJD_TAI_EPOCH = 36204; // 1958-01-01, the TAI epoch
+    static final long TAI_1958_TO_1970 = (MJD_EPOCH - MJD_TAI_EPOCH) * 86400L;
+    static final long NANOS_PER_DAY = 86_400_000_000_000L;
+
+    /** The leap-second table, read once for the generators; the property checks the table itself. */
+    static final long[] LEAPS = UtcRules.system().getLeapSecondDates();
+    static final List<Long> LEAP_DAYS = Arrays.stream(LEAPS).boxed().toList();
+
+    /** A modified Julian day: in 1899..2105, a day of the leap table, the day before or after one, within 82 years of 1970, or a notable one. */
+    static final Generator<Long> MJD = oneOf(longs(15_000, 90_000), sampledFrom(LEAP_DAYS),
+            tuples(sampledFrom(LEAP_DAYS), sampledFrom(-1L, 1L)).map(t -> t.value1() + t.value2()),
+            longs(MJD_EPOCH - 30_000, MJD_EPOCH + 30_000),
+            sampledFrom(MJD_EPOCH, MJD_EPOCH - 1, 41317L, 36204L, 0L, -100_000L, 1_000_000L));
+
+    /** The model's length of the day in nanos: a leap second on the days of the table except its first entry, the start of the table. */
+    static long dayNanos(long mjd) {
+        return NANOS_PER_DAY + (Arrays.binarySearch(LEAPS, mjd) >= 0 && mjd != 41317 ? 1_000_000_000L : 0);
+    }
+
+    /** A nano-of-day for a day of that length: anywhere, in the last 2000 s, a whole second with a notable nano part, a notable one (two just outside the day), or a whole second. */
+    static Generator<Long> nanoOfDay(long dayNanos) {
+        return oneOf(longs(0, dayNanos - 1), longs(Math.max(0, dayNanos - 2_000_000_000_000L), dayNanos - 1),
+                tuples(longs(0, 86_399), sampledFrom(0L, 1L, 999_999_999L)).map(t -> t.value1() * 1_000_000_000L + t.value2()),
+                sampledFrom(0L, dayNanos - 1, NANOS_PER_DAY - 1, NANOS_PER_DAY, NANOS_PER_DAY + 999_999_999L, -1L, dayNanos),
+                longs(0, 86_399).map(s -> s * 1_000_000_000L));
+    }
+
+    /** The day and its nano-of-day; a duration to add (within 100000 s, 50%); the seconds and nano adjustment of a TAI instant; an instant and the nanos to a second one. */
+    record ScaleCase(long mjd, long nod, Duration dur, long taiSeconds, long taiNanos, Instant instant, long jump) {}
+
+    static final Generator<ScaleCase> SCALE_CASE = MJD.flatMap(mjd -> tuples(nanoOfDay(dayNanos(mjd)),
+            weighted(w(50, tuples(ints(-100_000, 100_000), Gen.NANOS).map(t -> Duration.ofSeconds(t.value1(), t.value2()))), w(50, Gen.DURATION)),
+            longs(-1_000_000_000L, 5_000_000_000L), longs(-3_000_000_000L, 3_000_000_000L), INSTANT,
+            sampledFrom(1L, 1000L, 1_000_000_000L, -1L, 500_000_000L, 999L * 1_000_000_000L))
+            .map(t -> new ScaleCase(mjd, t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6())));
+
+    void scaleCase(TestCase tc) {
+        ScaleCase sc = tc.draw(SCALE_CASE, "case");
+        UtcRules rules = UtcRules.system();
+        long[] leaps = rules.getLeapSecondDates();
+        Zoo.check(leaps.length >= 27 && Arrays.binarySearch(leaps, 41498) >= 0 && Arrays.binarySearch(leaps, 57753) >= 0, () -> "leap second table " + Arrays.toString(leaps));
+        long mjd = sc.mjd();
+        int adj = rules.getLeapSecondAdjustment(mjd);
+        Zoo.check(adj == (Arrays.binarySearch(leaps, mjd) >= 0 && mjd != 41317 ? 1 : 0), () -> "getLeapSecondAdjustment(" + mjd + ") = " + adj);
