+    static int julianMonthLength(long y, int m) {
+        return switch (m) {
+            case 2 -> Math.floorMod(y, 4) == 0 ? 29 : 28;
+            case 4, 6, 9, 11 -> 30;
+            default -> 31;
+        };
+    }
