+            ints(-50, 50).map(n -> Period.ofMonths(n * 12)),
+            ints(-300, 300).map(n -> Duration.ofMinutes(n * 60L)),
+            ints(-300, 300).map(n -> Duration.ofSeconds(n * 86400L)),
+            tuples(ints(-10, 10), sampledFrom(0, 1, 500_000_000)).map(t -> Duration.ofSeconds(t.value1(), t.value2())),
+            tuples(ints(-3, 3), ints(-13, 13)).map(t -> Period.of(t.value1(), t.value2(), 0)),
+            tuples(KIND, ints(-20_000, 20_000)).map(t -> (TemporalAmount) t.value1().of(t.value2() * 12)),
