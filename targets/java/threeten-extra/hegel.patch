+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for ThreeTen-Extra, added by the Hegel zoo (targets/java/threeten-extra). Runs against the
+     org.threeten:threeten-extra artifact that `[run] setup` installs from this checkout into the local Maven
+     repository. Oracles: java.time itself (the ISO calendar, Period/Duration arithmetic, IsoFields) and independent
+     models written in the tests (Julian/Coptic/Ethiopic day counts, interval set algebra, long/BigDecimal
+     arithmetic). -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>threeten-extra-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <threeten.version>1.10.1-SNAPSHOT</threeten.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.threeten</groupId>
+      <artifactId>threeten-extra</artifactId>
+      <version>${threeten.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
