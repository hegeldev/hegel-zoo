@@ -0,0 +1,1001 @@
+package zoo;
+
+import static java.time.temporal.ChronoField.DAY_OF_WEEK;
+import static java.time.temporal.ChronoUnit.DAYS;
+import static java.time.temporal.ChronoUnit.HOURS;
+import static java.time.temporal.ChronoUnit.MINUTES;
+import static java.time.temporal.ChronoUnit.MONTHS;
+import static java.time.temporal.ChronoUnit.SECONDS;
+import static java.time.temporal.ChronoUnit.WEEKS;
+import static java.time.temporal.ChronoUnit.YEARS;
+
+import dev.hegel.HealthCheck;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.lang.reflect.InvocationTargetException;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.math.RoundingMode;
+import java.time.DateTimeException;
+import java.time.DayOfWeek;
+import java.time.Duration;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+import java.time.Month;
+import java.time.OffsetDateTime;
+import java.time.Period;
+import java.time.YearMonth;
+import java.time.ZoneOffset;
+import java.time.format.DateTimeFormatter;
+import java.time.format.DateTimeFormatterBuilder;
+import java.time.format.DateTimeParseException;
+import java.time.format.ResolverStyle;
+import java.time.temporal.ChronoField;
+import java.time.temporal.ChronoUnit;
+import java.time.temporal.IsoFields;
+import java.time.temporal.Temporal;
+import java.time.temporal.TemporalAmount;
+import java.time.temporal.TemporalField;
+import java.time.temporal.TemporalUnit;
+import java.time.temporal.UnsupportedTemporalTypeException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Locale;
+import java.util.Objects;
+import java.util.concurrent.TimeUnit;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+import org.threeten.extra.AmountFormats;
+import org.threeten.extra.DayOfMonth;
+import org.threeten.extra.DayOfYear;
+import org.threeten.extra.Days;
+import org.threeten.extra.Half;
+import org.threeten.extra.HourMinute;
+import org.threeten.extra.Hours;
+import org.threeten.extra.Minutes;
+import org.threeten.extra.Months;
+import org.threeten.extra.OffsetDate;
+import org.threeten.extra.PackedFields;
+import org.threeten.extra.PeriodDuration;
+import org.threeten.extra.Quarter;
+import org.threeten.extra.Seconds;
+import org.threeten.extra.Temporals;
+import org.threeten.extra.Weeks;
+import org.threeten.extra.Years;
+import org.threeten.extra.scale.TaiInstant;
+import org.threeten.extra.scale.UtcInstant;
+import org.threeten.extra.scale.UtcRules;
+
+/** Properties of the amount classes, PeriodDuration, AmountFormats, Temporals, the small temporals and the UTC/TAI scales. */
+class ThreetenExtraAmountsTest {
+
+    static String s(Object o) {
+        return Zoo.show(o);
+    }
+
+    static Object outcome(Supplier<?> f) {
+        try {
+            return f.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String kind(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : "value " + s(o);
+    }
+
+    static boolean sameOutcome(Object a, Object b) {
+        if (a instanceof Throwable ta) {
+            return b instanceof Throwable tb && ta.getClass() == tb.getClass();
+        }
+        return !(b instanceof Throwable) && Objects.equals(a, b);
+    }
+
+    /** Invokes a public method reflectively, rethrowing what it throws. */
+    static Object inv(Class<?> cls, Object target, String name, Class<?>[] types, Object... args) {
+        try {
+            return cls.getMethod(name, types).invoke(target, args);
+        } catch (InvocationTargetException e) {
+            Zoo.sneaky(e.getCause());
+            return null;
+        } catch (ReflectiveOperationException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Unit conversion model shared by Temporals.convertAmount and the amount classes
+
+    static final List<TemporalUnit> UNITS = new ArrayList<>();
+    static {
+        UNITS.addAll(Arrays.asList(ChronoUnit.values()));
+        UNITS.add(IsoFields.QUARTER_YEARS);
+        UNITS.add(IsoFields.WEEK_BASED_YEARS);
+    }
+
+    static boolean precise(TemporalUnit u) {
+        return u instanceof ChronoUnit cu && cu.compareTo(WEEKS) <= 0;
+    }
+
+    static int monthFactor(TemporalUnit u) {
+        if (u == IsoFields.QUARTER_YEARS) {
+            return 3;
+        }
+        if (u instanceof ChronoUnit cu) {
+            return switch (cu) {
+                case MONTHS -> 1;
+                case YEARS -> 12;
+                case DECADES -> 120;
+                case CENTURIES -> 1200;
+                case MILLENNIA -> 12000;
+                default -> 0;
+            };
+        }
+        return 0;
+    }
+
+    /** The documented conversion: {whole, remainder}, or the exception class. */
+    static Object convertModel(long amount, TemporalUnit from, TemporalUnit to) {
+        for (TemporalUnit u : List.of(from, to)) {
+            boolean ok = (u instanceof ChronoUnit && u != ChronoUnit.ERAS && u != ChronoUnit.FOREVER) || u == IsoFields.QUARTER_YEARS;
+            if (!ok) {
+                return new UnsupportedTemporalTypeException("");
+            }
+        }
+        if (from.equals(to)) {
+            return new long[] {amount, 0};
+        }
+        long f;
+        long t;
+        if (precise(from) && precise(to)) {
+            f = from.getDuration().toNanos();
+            t = to.getDuration().toNanos();
+        } else if (monthFactor(from) > 0 && monthFactor(to) > 0) {
+            f = monthFactor(from);
+            t = monthFactor(to);
+        } else {
+            return new DateTimeException("");
+        }
+        try {
+            if (f > t) {
+                return new long[] {Math.multiplyExact(amount, f / t), 0};
+            }
+            return new long[] {amount / (t / f), amount % (t / f)};
+        } catch (ArithmeticException e) {
+            return e;
+        }
+    }
+
+    static boolean sameConversion(Object got, Object want) {
+        if (got instanceof long[] g && want instanceof long[] w) {
+            return Arrays.equals(g, w);
+        }
+        return sameOutcome(got, want);
+    }
+
+    static String showConversion(Object o) {
+        return o instanceof long[] a ? Arrays.toString(a) : kind(o);
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Days, Weeks, Months, Years, Hours, Minutes, Seconds
+
+    record Kind(Class<?> cls, TemporalUnit unit, String prefix, String suffix, boolean dateBased) {
+        String name() {
+            return cls.getSimpleName();
+        }
+
+        Object of(int n) {
+            return inv(cls, null, "of", new Class<?>[] {int.class}, n);
+        }
+
+        int amount(Object x) {
+            return (Integer) inv(cls, x, "getAmount", new Class<?>[0]);
+        }
+
+        Object parse(String text) {
+            return inv(cls, null, "parse", new Class<?>[] {CharSequence.class}, text);
+        }
+
+        Object from(TemporalAmount a) {
+            return inv(cls, null, "from", new Class<?>[] {TemporalAmount.class}, a);
+        }
+
+        Object between(Temporal a, Temporal b) {
+            return inv(cls, null, "between", new Class<?>[] {Temporal.class, Temporal.class}, a, b);
+        }
+
+        Object call(Object x, String name) {
+            return inv(cls, x, name, new Class<?>[0]);
+        }
+
+        Object call(Object x, String name, int n) {
+            return inv(cls, x, name, new Class<?>[] {int.class}, n);
+        }
+
+        Object call(Object x, String name, TemporalAmount a) {
+            return inv(cls, x, name, new Class<?>[] {TemporalAmount.class}, a);
+        }
+    }
+
+    static final Kind[] KINDS = {
+        new Kind(Days.class, DAYS, "P", "D", true),
+        new Kind(Weeks.class, WEEKS, "P", "W", true),
+        new Kind(Months.class, MONTHS, "P", "M", true),
+        new Kind(Years.class, YEARS, "P", "Y", true),
+        new Kind(Hours.class, HOURS, "PT", "H", false),
+        new Kind(Minutes.class, MINUTES, "PT", "M", false),
+        new Kind(Seconds.class, SECONDS, "PT", "S", false),
+    };
+
+    /** The exact conversion of {@code amount} of {@code unit} into whole {@code kind}s, or the exception. */
+    static Object fromModel(Kind kind, TemporalAmount a) {
+        try {
+            long total = 0;
+            for (TemporalUnit u : a.getUnits()) {
+                long v = a.get(u);
+                if (v == 0) {
+                    continue;
+                }
+                Object conv = convertModel(v, u, kind.unit());
+                if (conv instanceof long[] c) {
+                    if (c[1] != 0) {
+                        return new DateTimeException("remainder");
+                    }
+                    total = Math.addExact(total, Math.toIntExact(c[0]));
+                } else if (conv instanceof DateTimeException e) {
+                    return e;
+                } else {
+                    return conv;
+                }
+            }
+            return kind.of(Math.toIntExact(total));
+        } catch (ArithmeticException e) {
+            return e;
+        }
+    }
+
+    static Object exact(Supplier<Integer> f) {
+        try {
+            return f.get();
+        } catch (ArithmeticException e) {
+            return e;
+        }
+    }
+
+    static boolean amountIs(Kind kind, Object got, Object want) {
+        if (want instanceof Integer n) {
+            return !(got instanceof Throwable) && got != null && kind.amount(got) == n;
+        }
+        return sameOutcome(got, want);
+    }
+
+    @Test
+    void amountsMatchIntArithmetic() {
+        Hegel.test(this::amountCase, Zoo.settings("threeten.amounts").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
+    }
+
+    void amountCase(TestCase tc) {
+        Kind k = Zoo.pick(tc, KINDS);
+        int a = Gen.anyInt(tc);
+        int b = Gen.anyInt(tc);
+        int sc = Zoo.chance(tc, 50) ? Zoo.n(tc, -5, 5) : Gen.anyInt(tc);
+        Object x = k.of(a);
+        Object y = k.of(b);
+        String at = k.name() + ".of(" + a + "): ";
+        Zoo.check(k.amount(x) == a, () -> at + "getAmount " + k.amount(x));
+        Zoo.check(((TemporalAmount) x).get(k.unit()) == a && ((TemporalAmount) x).getUnits().equals(List.of(k.unit())), () -> at + "get(unit)/getUnits");
+        String text = k.prefix() + a + k.suffix();
+        Zoo.check(x.toString().equals(text), () -> at + "toString " + s(x.toString()) + " vs " + s(text));
+        Zoo.check(x.equals(k.parse(text)) && x.equals(k.parse(text.toLowerCase(Locale.ROOT))), () -> at + "parse(" + s(text) + ") = " + kind(outcome(() -> k.parse(text))));
+        if (a != Integer.MIN_VALUE) {  // threeten-extra/6
+            Object neg = outcome(() -> k.parse("-" + text));
+            Zoo.check(amountIs(k, neg, -a), () -> at + "parse(" + s("-" + text) + ") = " + kind(neg));
+        }
+        Zoo.check(amountIs(k, outcome(() -> k.parse("+" + text)), a), () -> at + "parse(" + s("+" + text) + ")");
+        Zoo.check(amountIs(k, outcome(() -> k.call(x, "plus", b)), exact(() -> Math.addExact(a, b))), () -> at + "plus(" + b + ") = " + kind(outcome(() -> k.call(x, "plus", b))));
+        Zoo.check(amountIs(k, outcome(() -> k.call(x, "plus", (TemporalAmount) y)), exact(() -> Math.addExact(a, b))), () -> at + "plus(" + y + ") = " + kind(outcome(() -> k.call(x, "plus", (TemporalAmount) y))));
