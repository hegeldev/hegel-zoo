+    /** A date in years 1001..9999, which of the four formatters writes it, how far the list is rotated, and whether the writer is dropped (30%). */
+    record Parsing(LocalDate date, int chosen, int rotation, boolean drop) {}
+
+    static final Generator<Parsing> PARSING = tuples(longs(Gen.DAY_0001 + 365 * 1000, Gen.DAY_9999).map(LocalDate::ofEpochDay), ints(0, 3), ints(0, 3), chance(30))
+            .map(t -> new Parsing(t.value1(), t.value2(), t.value3(), t.value4()));
