+    // UTC and TAI
+
+    @Test
+    void utcAndTaiInstantsRoundTrip() {
+        Hegel.test(this::scaleCase, Zoo.settings("threeten.scales").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
