+            }
+            Zoo.check(LocalDateRange.of(sa, Period.ofDays((int) Math.min(len, Integer.MAX_VALUE))).equals(a) || len > Integer.MAX_VALUE, () -> at + "of(start, Period)");
+            if (!a.isEmpty()) {
+                Zoo.check(LocalDateRange.ofClosed(sa, ea.minusDays(1)).equals(a), () -> at + "ofClosed(start, end - 1)");
+            }
+        }
+        // construction variants
+        Object closed = outcome(() -> LocalDateRange.ofClosed(sa, d));
+        Object closedModel = d.isBefore(sa) ? new DateTimeException("") : outcome(() -> LocalDateRange.of(sa, d.equals(LocalDate.MAX) ? LocalDate.MAX : d.plusDays(1)));
+        Zoo.check(sameOutcome(closed, closedModel), () -> atd + "ofClosed " + kind(closed) + " vs model " + kind(closedModel));
+        Object empty = outcome(() -> LocalDateRange.ofEmpty(d));
+        Object emptyModel = outcome(() -> LocalDateRange.of(d, d));
+        Zoo.check(sameOutcome(empty, emptyModel), () -> atd + "ofEmpty " + kind(empty) + " vs of(d, d) " + kind(emptyModel));
+        Zoo.check(sameOutcome(outcome(() -> LocalDateRange.ofUnboundedStart(d)), outcome(() -> LocalDateRange.of(LocalDate.MIN, d))), () -> atd + "ofUnboundedStart");
+        Zoo.check(sameOutcome(outcome(() -> LocalDateRange.ofUnboundedEnd(d)), outcome(() -> LocalDateRange.of(d, LocalDate.MAX))), () -> atd + "ofUnboundedEnd");
+        Zoo.check(LocalDateRange.ofUnbounded().equals(LocalDateRange.ALL) && LocalDateRange.ALL.equals(LocalDateRange.of(LocalDate.MIN, LocalDate.MAX)), "ALL");
+        if (!d.equals(LocalDate.MIN) && !d.equals(LocalDate.MAX) && !d.equals(MAXM1) && !d.equals(MINP1)) {
+            Zoo.check(LocalDateRange.from(d).equals(LocalDateRange.ofClosed(d, d)), () -> atd + "from(date) " + LocalDateRange.from(d));
