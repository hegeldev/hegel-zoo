+        if (Math.max(lo, -700_000) <= Math.min(hi, 3_000_000)) {
+            choices.add(w(85, longs(Math.max(lo, -700_000), Math.min(hi, 3_000_000))));
+        }
+        choices.add(w(10, longs(Math.max(lo, -360_000_000L), Math.min(hi, 360_000_000L))));
+        List<Long> notable = LongStream.of(NOTABLE_DAYS).filter(e -> e >= lo && e <= hi).boxed().toList();
+        if (!notable.isEmpty()) {
+            choices.add(w(5, sampledFrom(notable)));
+        }
+        return weighted(choices);
