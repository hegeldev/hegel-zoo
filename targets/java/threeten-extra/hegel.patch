+
+    static final Generator<DecimalSeconds> DECIMAL_SECONDS = tuples(Gen.DURATION, oneOf(SCALED, DECIMAL),
+            maybe(50, (Double) null, sampledFrom(0.0, -0.0, 1e-9, 1.5e-9, -1e-9, 1e19, -1e19, 123456.789, Double.MIN_VALUE, 1e300, -1e300, 9.3e18)),
+            sampledFrom(0.0, 1.0, -1.0, 0.5, 2.0, 1.5, 3.3, -0.25, 1e-9, 1e9, 0.1, 7.0))
