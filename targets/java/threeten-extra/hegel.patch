+++ b/hegel/src/test/java/zoo/ThreetenExtraPinsTest.java
@@ -0,0 +1,164 @@
+package zoo;
+
+import java.time.Duration;
+import java.time.Period;
+import java.time.chrono.Chronology;
+import java.time.chrono.IsoEra;
+import java.time.format.DateTimeParseException;
+import java.util.Locale;
+import java.util.function.Supplier;
+import org.junit.jupiter.api.Test;
+import org.threeten.extra.AmountFormats;
+import org.threeten.extra.Days;
+import org.threeten.extra.Temporals;
+import org.threeten.extra.Years;
+import java.time.temporal.ChronoField;
+import java.time.temporal.ChronoUnit;
+import org.threeten.extra.chrono.InternationalFixedChronology;
+import org.threeten.extra.chrono.PaxChronology;
+import org.threeten.extra.chrono.Symmetry010Chronology;
+import org.threeten.extra.chrono.Symmetry010Date;
+import org.threeten.extra.chrono.Symmetry454Chronology;
+import org.threeten.extra.chrono.Symmetry454Date;
+
+/**
+ * Pins for the bugs in targets/java/threeten-extra/bugs.toml. Each asserts the correct behaviour and therefore fails
+ * while the bug exists; the ids are the keys of [expected_failures] in target.toml.
+ */
+class ThreetenExtraPinsTest {
+
+    static Object outcome(Supplier<?> f) {
+        try {
+            return f.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String kind(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : "value " + o;
+    }
+
+    /** threeten-extra/1: the Symmetry calendars misjudge leap years before year -2 and lose days before year 0. */
+    @Test
+    void pin_symmetryDatesBeforeYearZero() {
+        for (Chronology c : new Chronology[] {Symmetry454Chronology.INSTANCE, Symmetry010Chronology.INSTANCE}) {
+            // the documented rule: a year is leap when (52 * year + 146) mod 293 < 52; for -3 the remainder is 283
+            Zoo.check(!c.isLeapYear(-3), c.getId() + ".isLeapYear(-3) is true (52 * -3 + 146 = -10, which is 283 mod 293)");
+            Zoo.check(!c.isLeapYear(-6), c.getId() + ".isLeapYear(-6) is true");
+            for (long e : new long[] {-719_527, -721_717, -1_000_000}) {
+                Object d = outcome(() -> c.dateEpochDay(e));
+                Zoo.check(d instanceof java.time.chrono.ChronoLocalDate x && x.toEpochDay() == e,
+                        c.getId() + ".dateEpochDay(" + e + ") = " + kind(d) + (d instanceof java.time.chrono.ChronoLocalDate x ? " with toEpochDay " + x.toEpochDay() : ""));
+            }
+        }
+    }
+
+    /** threeten-extra/2: the Symmetry calendars ignore the era in prolepticYear and date(era, ...). */
+    @Test
+    void pin_symmetryErasRespected() {
+        for (Chronology c : new Chronology[] {Symmetry454Chronology.INSTANCE, Symmetry010Chronology.INSTANCE}) {
+            Zoo.check(c.prolepticYear(IsoEra.BCE, 5) == -4, c.getId() + ".prolepticYear(BCE, 5) = " + c.prolepticYear(IsoEra.BCE, 5));
+            Zoo.check(c.date(IsoEra.BCE, 5, 1, 1).equals(c.date(-4, 1, 1)), c.getId() + ".date(BCE, 5, 1, 1) = " + c.date(IsoEra.BCE, 5, 1, 1));
+        }
+    }
+
+    /** threeten-extra/3: durationToDoubleSeconds throws for durations below about -292 years. */
+    @Test
+    void pin_negativeDurationToDoubleSeconds() {
+        Duration d = Duration.ofSeconds(-10_000_000_000L);
+        Object got = outcome(() -> Temporals.durationToDoubleSeconds(d));
+        Zoo.check(got instanceof Double v && v == -1e10, "durationToDoubleSeconds(" + d + ") = " + kind(got));
+    }
+
+    /** threeten-extra/4: wordBased casts the hour and day counts to int. */
+    @Test
+    void pin_wordBasedHugeHours() {
+        String hours = AmountFormats.wordBased(Duration.ofHours(2_147_483_648L), Locale.ENGLISH);
+        Zoo.check(hours.equals("2147483648 hours"), "wordBased(PT2147483648H) = \"" + hours + "\"");
+        String days = AmountFormats.wordBased(Period.ZERO, Duration.ofHours(51_539_607_552L), Locale.ENGLISH);
+        Zoo.check(days.equals("2147483648 days"), "wordBased(P0D, PT51539607552H) = \"" + days + "\"");
+    }
+
+    /** threeten-extra/5: negative months without years are normalised into years, positive ones are not. */
+    @Test
+    void pin_wordBasedNegativeMonths() {
+        Zoo.check(AmountFormats.wordBased(Period.ofMonths(13), Locale.ENGLISH).equals("13 months"), "wordBased(P13M) is not \"13 months\"");
+        String neg = AmountFormats.wordBased(Period.ofMonths(-13), Locale.ENGLISH);
+        Zoo.check(neg.equals("-13 months"), "wordBased(P-13M) = \"" + neg + "\"");
+    }
+
+    /** threeten-extra/6: the amount parsers throw ArithmeticException, not DateTimeParseException, when the components overflow. */
+    @Test
+    void pin_amountParseOverflowIsParseException() {
+        Object days = outcome(() -> Days.parse("P2147483647W21D"));
+        Zoo.check(days instanceof DateTimeParseException, "Days.parse(\"P2147483647W21D\") = " + kind(days));
+        Object years = outcome(() -> Years.parse("-P-2147483648Y"));
+        Zoo.check(years instanceof DateTimeParseException, "Years.parse(\"-P-2147483648Y\") = " + kind(years));
+    }
+
+    // threeten-extra/7: InternationalFixedDate.plusWeeks lands a month early when the target is the first week of
+    // a month and the count is not a multiple of four
+    @Test
+    void pin_ifcPlusWeeksKeepsTheDayOfWeek() {
+        InternationalFixedChronology ifc = InternationalFixedChronology.INSTANCE;
+        Zoo.check(ifc.dateEpochDay(-2).plus(1, ChronoUnit.WEEKS).equals(ifc.date(1970, 1, 7)),
+                "1969/13/28 plus one week = " + ifc.dateEpochDay(-2).plus(1, ChronoUnit.WEEKS) + ", want 1970/01/07");
+        Zoo.check(ifc.date(1970, 1, 25).plus(1, ChronoUnit.WEEKS).equals(ifc.date(1970, 2, 4)),
+                "1970/01/25 plus one week = " + ifc.date(1970, 1, 25).plus(1, ChronoUnit.WEEKS) + ", want 1970/02/04");
+    }
+
+    // threeten-extra/8: Symmetry454Date.weeksUntil counts four weeks in every month
+    @Test
+    void pin_symmetry454WeeksUntilCountsFiveWeekMonths() {
+        Symmetry454Chronology c = Symmetry454Chronology.INSTANCE;
+        long weeks = c.date(1970, 1, 1).until(c.date(1970, 3, 1), ChronoUnit.WEEKS);
+        Zoo.check(weeks == 9, "1970/01/01 until 1970/03/01 (63 days) = " + weeks + " weeks, want 9");
+    }
+
+    // threeten-extra/9: Symmetry010Date.weeksUntil mixes the year-aligned week with the month-aligned day of week
+    @Test
+    void pin_symmetry010WeeksUntilMatchesTheDays() {
+        Symmetry010Chronology c = Symmetry010Chronology.INSTANCE;
+        long a = c.date(1970, 2, 1).until(c.date(1970, 3, 1), ChronoUnit.WEEKS);
+        Zoo.check(a == 4, "1970/02/01 until 1970/03/01 (31 days) = " + a + " weeks, want 4");
+        long b = c.date(1969, 12, 19).until(c.date(1970, 1, 15), ChronoUnit.WEEKS);
+        Zoo.check(b == 3, "1969/12/19 until 1970/01/15 (26 days) = " + b + " weeks, want 3");
+    }
+
+    // threeten-extra/10: Symmetry454Date.with and Symmetry010Date.with return the date unchanged for a value of 0
+    @Test
+    void pin_symmetryWithZeroSetsTheField() {
+        long a = Symmetry454Chronology.INSTANCE.dateEpochDay(-2047).with(ChronoField.EPOCH_DAY, 0).toEpochDay();
+        Zoo.check(a == 0, "Symmetry454 with(EPOCH_DAY, 0).toEpochDay() = " + a);
+        long b = Symmetry010Chronology.INSTANCE.dateEpochDay(-2047).with(ChronoField.EPOCH_DAY, 0).toEpochDay();
+        Zoo.check(b == 0, "Symmetry010 with(EPOCH_DAY, 0).toEpochDay() = " + b);
+        int y = Symmetry454Chronology.INSTANCE.date(1970, 1, 1).with(ChronoField.YEAR, 0).get(ChronoField.YEAR);
+        Zoo.check(y == 0, "Symmetry454 1970/01/01 with(YEAR, 0) has year " + y);
+    }
+
+    // threeten-extra/11: PaxDate.plusMonths computes month 0 when the target is the leap-year fourteenth month
+    @Test
+    void pin_paxPlusMonthsReachesTheLeapDecember() {
+        PaxChronology pax = PaxChronology.INSTANCE;
+        Object plus = outcome(() -> pax.date(1860, 13, 1).plus(1, ChronoUnit.MONTHS));
+        Zoo.check(pax.date(1860, 14, 1).equals(plus), "1860-13-01 plus one month = " + kind(plus) + ", want 1860-14-01");
+        Object minus = outcome(() -> pax.date(1861, 1, 1).minus(1, ChronoUnit.MONTHS));
+        Zoo.check(pax.date(1860, 14, 1).equals(minus), "1861-01-01 minus one month = " + kind(minus) + ", want 1860-14-01");
+        Object until = outcome(() -> pax.date(1996, 5, 22).until(pax.date(2000, 1, 7)));
+        Zoo.check(!(until instanceof Throwable), "1996-05-22 until 2000-01-07 = " + kind(until));
+    }
+
+    // threeten-extra/12: from a day of the Symmetry leap week, plus(until(end)) does not reach end
+    @Test
+    void pin_symmetryUntilRoundTripsFromTheLeapWeek() {
+        Symmetry010Chronology s010 = Symmetry010Chronology.INSTANCE;
+        Symmetry010Date a = s010.date(2004, 12, 37);
+        Zoo.check(a.plus(a.until(s010.date(2006, 3, 1))).equals(s010.date(2006, 3, 1)),
+                "Symmetry010 2004/12/37 plus " + a.until(s010.date(2006, 3, 1)) + " = " + a.plus(a.until(s010.date(2006, 3, 1))) + ", want 2006/03/01");
+        Symmetry454Chronology s454 = Symmetry454Chronology.INSTANCE;
+        Symmetry454Date b = s454.date(2004, 12, 35);
+        Zoo.check(b.plus(b.until(s454.date(2006, 3, 1))).equals(s454.date(2006, 3, 1)),
+                "Symmetry454 2004/12/35 plus " + b.until(s454.date(2006, 3, 1)) + " = " + b.plus(b.until(s454.date(2006, 3, 1))) + ", want 2006/03/01");
+    }
+}
