+    void unitBasedCase(TestCase tc) {
+        int parts = Zoo.n(tc, 1, 4);
+        StringBuilder text = new StringBuilder();
+        String sign = Zoo.pick(tc, "", "", "-", "+");
+        text.append(sign);
+        BigInteger total = BigInteger.ZERO;
+        boolean tooBig = false;
+        for (int i = 0; i < parts; i++) {
+            long whole = Zoo.chance(tc, 70) ? Zoo.n(tc, 0, 1000) : Gen.lng(tc, 0, Long.MAX_VALUE);
+            String wholeText = Zoo.chance(tc, 5) ? "0" + whole : Long.toString(whole);
+            DurUnit u = Zoo.pick(tc, DUR_UNITS);
+            BigInteger part = BigInteger.valueOf(whole).multiply(BigInteger.valueOf(u.nanos()));
+            text.append(wholeText);
+            if (Zoo.chance(tc, 40)) {
+                String frac = Zoo.word(tc, "0123456789", 1, 12);
+                text.append('.').append(frac);
+                part = part.add(new BigInteger(frac).multiply(BigInteger.valueOf(u.nanos())).divide(BigInteger.TEN.pow(frac.length())));
+            }
+            text.append(u.text());
+            total = total.add(part);
+        }
+        BigInteger maxNanos = BigInteger.valueOf(Long.MAX_VALUE).multiply(BigInteger.valueOf(1_000_000_000L)).add(BigInteger.valueOf(999_999_999));
+        tooBig = total.compareTo(maxNanos) > 0;
+        String t = text.toString();
+        BigInteger ftotal = total;
+        Object got = outcome(() -> AmountFormats.parseUnitBasedDuration(t));
