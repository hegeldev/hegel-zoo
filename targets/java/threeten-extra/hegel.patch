+        Object wp = outcome(() -> YearWeek.parse(yw.toString()));
+        Zoo.check(yw.equals(wp), () -> atw + "parse(toString) = " + kind(wp));
+        Zoo.check(yw.plusWeeks(k).atDay(DayOfWeek.MONDAY).equals(yw.atDay(DayOfWeek.MONDAY).plusWeeks(k)), () -> atw + "plusWeeks(" + k + ") = " + yw.plusWeeks(k) + ", Monday " + yw.plusWeeks(k).atDay(DayOfWeek.MONDAY) + " vs " + yw.atDay(DayOfWeek.MONDAY).plusWeeks(k));
+        Zoo.check(yw.minusWeeks(k).equals(yw.plusWeeks(-k)) && yw.plus(k, WEEKS).equals(yw.plusWeeks(k)), () -> atw + "minusWeeks/plus(WEEKS)");
