+        Zoo.check(amountIs(k, outcome(() -> k.call(x, "negated")), exact(() -> Math.negateExact(a))), () -> at + "negated = " + kind(outcome(() -> k.call(x, "negated"))));
+        Zoo.check(amountIs(k, outcome(() -> k.call(x, "abs")), exact(() -> Math.absExact(a))), () -> at + "abs = " + kind(outcome(() -> k.call(x, "abs"))));
+        Zoo.check(k.call(x, "isNegative").equals(a < 0) && k.call(x, "isZero").equals(a == 0) && k.call(x, "isPositive").equals(a > 0), () -> at + "isNegative/isZero/isPositive");
