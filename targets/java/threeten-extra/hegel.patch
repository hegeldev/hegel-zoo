+    @Test
+    void temporalsMatchTheModel() {
+        Hegel.test(this::temporalsCase, Zoo.settings("threeten.temporals").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
+    }
+
+    static boolean weekend(LocalDate d) {
+        return d.getDayOfWeek() == DayOfWeek.SATURDAY || d.getDayOfWeek() == DayOfWeek.SUNDAY;
+    }
+
+    static BigDecimal seconds(Duration d) {
+        return BigDecimal.valueOf(d.getSeconds()).add(BigDecimal.valueOf(d.getNano(), 9));
+    }
+
+    static final BigDecimal MIN_SECONDS = seconds(Duration.ofSeconds(Long.MIN_VALUE));
+    static final BigDecimal MAX_SECONDS = seconds(Duration.ofSeconds(Long.MAX_VALUE, 999_999_999));
+
+    static Duration fromSecondsModel(BigDecimal x) {
+        BigDecimal r = x.setScale(9, RoundingMode.UP).max(MIN_SECONDS).min(MAX_SECONDS);
+        BigInteger nanos = r.unscaledValue();
+        BigInteger[] qr = nanos.divideAndRemainder(BigInteger.valueOf(1_000_000_000L));
+        return Duration.ofSeconds(qr[0].longValueExact(), qr[1].longValueExact());
+    }
+
+    void temporalsCase(TestCase tc) {
+        // unit conversion
+        long amount = Zoo.chance(tc, 60) ? Zoo.n(tc, -100_000, 100_000) : Gen.lng(tc, Long.MIN_VALUE, Long.MAX_VALUE);
+        TemporalUnit from = Zoo.pick(tc, UNITS.toArray(new TemporalUnit[0]));
+        TemporalUnit to = Zoo.pick(tc, UNITS.toArray(new TemporalUnit[0]));
+        Object conv = outcome(() -> Temporals.convertAmount(amount, from, to));
+        Object convWant = convertModel(amount, from, to);
+        Zoo.check(sameConversion(conv, convWant), () -> "convertAmount(" + amount + ", " + from + ", " + to + ") = " + showConversion(conv) + " vs model " + showConversion(convWant));
+        if (conv instanceof long[] r && r[1] == 0 && Math.abs(amount) < 1_000_000_000L) {
+            Object back = outcome(() -> Temporals.convertAmount(r[0], to, from));
+            Zoo.check(back instanceof long[] b && b[0] == amount && b[1] == 0, () -> "convertAmount(" + amount + ", " + from + ", " + to + ") = " + r[0] + " but back " + showConversion(back));
+        }
+        // TimeUnit
+        TimeUnit tu = Zoo.pick(tc, TimeUnit.values());
+        Zoo.check(Temporals.timeUnit(Temporals.chronoUnit(tu)) == tu && Temporals.chronoUnit(tu).getDuration().toNanos() == tu.toNanos(1), () -> "chronoUnit(" + tu + ") = " + Temporals.chronoUnit(tu));
+        ChronoUnit cu = Zoo.pick(tc, ChronoUnit.values());
+        Object tuo = outcome(() -> Temporals.timeUnit(cu));
+        Zoo.check(cu.compareTo(DAYS) <= 0 && cu != ChronoUnit.HALF_DAYS ? tuo instanceof TimeUnit t && Temporals.chronoUnit(t) == cu : tuo instanceof IllegalArgumentException, () -> "timeUnit(" + cu + ") = " + kind(tuo));
+
+        // working days
+        LocalDate d = Gen.date(tc);
+        if (Math.abs(d.getYear()) > 999_999_000) {
+            d = LocalDate.ofEpochDay(Zoo.n(tc, -30_000, 30_000));
+        }
+        LocalDate fd = d;
+        LocalDate next = d.plusDays(1);
+        while (weekend(next)) {
+            next = next.plusDays(1);
+        }
+        LocalDate nextOrSame = d;
+        while (weekend(nextOrSame)) {
+            nextOrSame = nextOrSame.plusDays(1);
+        }
+        LocalDate prev = d.minusDays(1);
+        while (weekend(prev)) {
+            prev = prev.minusDays(1);
+        }
+        LocalDate prevOrSame = d;
+        while (weekend(prevOrSame)) {
+            prevOrSame = prevOrSame.minusDays(1);
+        }
+        LocalDate fnext = next;
+        LocalDate fprev = prev;
+        Zoo.check(d.with(Temporals.nextWorkingDay()).equals(next), () -> fd + ".with(nextWorkingDay) = " + fd.with(Temporals.nextWorkingDay()) + " vs " + fnext);
+        Zoo.check(d.with(Temporals.nextWorkingDayOrSame()).equals(nextOrSame), () -> fd + ".with(nextWorkingDayOrSame) = " + fd.with(Temporals.nextWorkingDayOrSame()));
+        Zoo.check(d.with(Temporals.previousWorkingDay()).equals(prev), () -> fd + ".with(previousWorkingDay) = " + fd.with(Temporals.previousWorkingDay()) + " vs " + fprev);
+        Zoo.check(d.with(Temporals.previousWorkingDayOrSame()).equals(prevOrSame), () -> fd + ".with(previousWorkingDayOrSame) = " + fd.with(Temporals.previousWorkingDayOrSame()));
+        LocalDateTime ldt = d.atTime(Gen.time(tc));
+        Zoo.check(ldt.with(Temporals.nextWorkingDay()).equals(next.atTime(ldt.toLocalTime())), () -> ldt + ".with(nextWorkingDay) = " + ldt.with(Temporals.nextWorkingDay()));
