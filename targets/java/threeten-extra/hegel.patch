+        }
+        int fcWant = fcmp;
+        Zoo.check(Integer.signum(fc.compare(f1, f2)) == Integer.signum(fcWant), () -> "fieldComparator(" + f1 + ", " + f2 + ") = " + fc.compare(f1, f2));
+    }
