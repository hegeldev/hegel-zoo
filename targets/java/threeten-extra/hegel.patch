+    void unitBasedCase(UnitText ut) {
+        BigInteger total = ut.nanos();
+        BigInteger maxNanos = BigInteger.valueOf(Long.MAX_VALUE).multiply(BigInteger.valueOf(1_000_000_000L)).add(BigInteger.valueOf(999_999_999));
+        boolean tooBig = total.compareTo(maxNanos) > 0;
+        String t = ut.text();
+        Object got = outcome(() -> AmountFormats.parseUnitBasedDuration(t));
+        if (tooBig) {
+            Zoo.check(got instanceof DateTimeParseException, () -> "parseUnitBasedDuration(" + s(t) + ") = " + kind(got) + " for a total of " + total + " ns");
+        } else {
+            BigInteger[] qr = total.divideAndRemainder(BigInteger.valueOf(1_000_000_000L));
+            Duration want = Duration.ofSeconds(qr[0].longValueExact(), qr[1].longValueExact());
+            if (ut.sign().equals("-")) {
+                want = want.negated();
+            }
+            Duration fw = want;
+            Zoo.check(fw.equals(got), () -> "parseUnitBasedDuration(" + s(t) + ") = " + kind(got) + " vs model " + fw);
+        }
+        Object junk = outcome(() -> AmountFormats.parseUnitBasedDuration(ut.junk()));
+        Zoo.check(junk instanceof DateTimeParseException, () -> "parseUnitBasedDuration(junk) = " + kind(junk));
+        Zoo.check(AmountFormats.parseUnitBasedDuration("0").isZero() && AmountFormats.parseUnitBasedDuration("-0").isZero(), "parseUnitBasedDuration(\"0\")");
+    }
