+
+/** Properties of ThreeTen-Extra against java.time and independent models: calendars, intervals, ranges, year-parts. */
+class ThreetenExtraTest {
+
+    static String s(Object o) {
+        return Zoo.show(o);
+    }
+
+    /** Runs {@code f} and returns its value, or the exception it threw. */
+    static Object outcome(Supplier<?> f) {
+        try {
+            return f.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String kind(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : "value " + s(o);
+    }
+
+    static boolean sameOutcome(Object a, Object b) {
+        if (a instanceof Throwable ta) {
+            return b instanceof Throwable tb && ta.getClass() == tb.getClass();
+        }
+        return !(b instanceof Throwable) && Objects.equals(a, b);
+    }
+
+    // ------------------------------------------------------------------------------------------------------------
+    // Calendars
+
+    static final Chronology[] CHRONOS = {
+        JulianChronology.INSTANCE, CopticChronology.INSTANCE, EthiopicChronology.INSTANCE, BritishCutoverChronology.INSTANCE,
+        DiscordianChronology.INSTANCE, InternationalFixedChronology.INSTANCE, PaxChronology.INSTANCE,
+        Symmetry454Chronology.INSTANCE, Symmetry010Chronology.INSTANCE,
+    };
+
+    static final long CUTOVER_DAY = LocalDate.of(1752, 9, 14).toEpochDay();
+
+    static final Generator<Chronology> CHRONO = sampledFrom(CHRONOS);
+
+    static boolean symmetry(Chronology c) {
+        return c == Symmetry454Chronology.INSTANCE || c == Symmetry010Chronology.INSTANCE;
+    }
+
+    /** The ISO year the chronology's year 1 begins in, minus one: how far its year numbers are from the ISO ones. */
+    static long yearShift(Chronology c) {
+        return LocalDate.from(c.date(1, 1, 1)).getYear() - 1;
+    }
+
+    /** The first and last epoch day comfortably (two years) inside the chronology's documented year range, and 400 days inside LocalDate's. */
+    static long firstDay(Chronology c) {
+        return Math.max(LocalDate.MIN.toEpochDay() + 400, LocalDate.of((int) (c.range(YEAR).getMinimum() + yearShift(c) + 2), 1, 1).toEpochDay());
+    }
+
+    static long lastDay(Chronology c) {
+        return Math.min(LocalDate.MAX.toEpochDay() - 400, LocalDate.of((int) (c.range(YEAR).getMaximum() + yearShift(c) - 2), 12, 31).toEpochDay());
+    }
+
+    /** Whether the day is comfortably inside the chronology's documented year range. */
+    static boolean inRange(Chronology c, long epochDay) {
+        return epochDay >= firstDay(c) && epochDay <= lastDay(c);
+    }
+
+    /** ISO 0001-01-01: the Symmetry calendars are not exercised before year 0 (threeten-extra/1). */
+    static final long SYMMETRY_FLOOR = LocalDate.of(1, 1, 1).toEpochDay();
+
+    static final long[] NOTABLE_DAYS = {0L, CUTOVER_DAY, CUTOVER_DAY - 1, CUTOVER_DAY - 12, CUTOVER_DAY - 11, -719162L, -719163L, -365L, 365L};
+
+    /**
+     * How far the property's arithmetic can move a day: {@code k} weeks (of up to eight days where a weekless day is skipped),
+     * {@code k2} days to the second date, and 30 months and 30 years.
+     */
+    static long margin(int k, int k2) {
+        return 8L * Math.abs(k) + Math.abs(k2) + 40 * 366;
+    }
+
+    /** St. Tib's Day (Discordian) and Leap Day and Year Day (International Fixed) belong to no week. */
+    static boolean weekless(Chronology c, ChronoLocalDate d) {
+        return (c == DiscordianChronology.INSTANCE && d.get(DAY_OF_MONTH) == 0)
+                || (c == InternationalFixedChronology.INSTANCE && d.get(DAY_OF_MONTH) == 29);
+    }
+
+    /**
+     * The calendar-week model of the Discordian and International Fixed calendars: the day {@code k} weeks from {@code d} with the
+     * same day of the week, the weekless days not counting. International Fixed: 13 months of four seven-day weeks; Discordian: 73
+     * five-day weeks a year, St. Tib's Day between days 59 and 60 of a leap year. {@code d} must not be weekless.
+     */
+    static ChronoLocalDate plusCalendarWeeks(Chronology c, ChronoLocalDate d, long k) {
+        int y = d.get(YEAR);
+        if (c == InternationalFixedChronology.INSTANCE) {
+            int dom = d.get(DAY_OF_MONTH);
+            long week = y * 52L + (d.get(MONTH_OF_YEAR) - 1) * 4L + (dom - 1) / 7 + k;
+            int weekOfYear = (int) Math.floorMod(week, 52);
+            return c.date(Math.toIntExact(Math.floorDiv(week, 52)), 1 + weekOfYear / 4, 1 + (weekOfYear % 4) * 7 + (dom - 1) % 7);
+        }
+        int doy = d.get(DAY_OF_YEAR);
+        int weekDay = d.isLeapYear() && doy > 60 ? doy - 1 : doy;  // day of year not counting St. Tib's Day
+        long week = y * 73L + (weekDay - 1) / 5 + k;
+        int year = Math.toIntExact(Math.floorDiv(week, 73));
+        int day = (int) Math.floorMod(week, 73) * 5 + (weekDay - 1) % 5 + 1;
+        return c.dateYearDay(year, c.isLeapYear(year) && day >= 60 ? day + 1 : day);
+    }
+
+    /** Pax months: the (year, month) {@code months} months on from month {@code m} of year {@code y}; a year has 13 months, a leap year 14. */
+    static int[] paxMonthsOn(Chronology c, int y, int m, long months) {
+        while (months > 0) {
+            if (++m > (c.isLeapYear(y) ? 14 : 13)) {
+                m = 1;
