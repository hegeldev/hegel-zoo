+        Map<Graph<Integer, DefaultWeightedEdge>, Integer> id = new HashMap<>();
+        for (Graph<Integer, DefaultWeightedEdge> c : cond.vertexSet()) {
+            id.put(c, id.size());
+            g.addVertex(id.get(c));
+        }
+        for (DefaultEdge e : cond.edgeSet()) {
+            g.addEdge(id.get(cond.getEdgeSource(e)), id.get(cond.getEdgeTarget(e)));
+        }
