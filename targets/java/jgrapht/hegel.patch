+    /** Chordal: no chordless cycle of length 4 or more (checked over all simple cycles). */
+    static boolean isChordal(Graph<Integer, DefaultWeightedEdge> g) {
+        for (List<Integer> c : Brute.simpleCycles(g)) {
+            if (c.size() >= 4 && isChordless(g, c)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static boolean isChordless(Graph<Integer, DefaultWeightedEdge> g, List<Integer> c) {
+        int k = c.size();
+        for (int i = 0; i < k; i++) {
+            if (!g.containsEdge(c.get(i), c.get((i + 1) % k))) {
+                return false;
+            }
+            for (int j = i + 2; j < k; j++) {
+                if ((i == 0 && j == k - 1)) {
+                    continue;
+                }
+                if (g.containsEdge(c.get(i), c.get(j))) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    /** Perfect elimination order in JGraphT's sense: each vertex's earlier neighbours form a clique. */
+    static boolean isPeo(Graph<Integer, DefaultWeightedEdge> g, List<Integer> order) {
+        if (!new HashSet<>(order).equals(g.vertexSet()) || order.size() != g.vertexSet().size()) {
+            return false;
+        }
+        Map<Integer, Integer> pos = new HashMap<>();
+        for (int i = 0; i < order.size(); i++) {
+            pos.put(order.get(i), i);
+        }
+        for (int v : order) {
+            Set<Integer> earlier = new HashSet<>();
+            for (int u : Graphs.neighborSetOf(g, v)) {
+                if (pos.get(u) < pos.get(v)) {
+                    earlier.add(u);
+                }
+            }
+            if (!Brute.isClique(g, earlier)) {
+                return false;
+            }
+        }
+        return true;
+    }
