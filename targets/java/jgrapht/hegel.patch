+    static void checkMatching(Graph<Integer, DefaultWeightedEdge> g, Matching<Integer, DefaultWeightedEdge> m, String who, String ctx) {
+        check(Brute.isMatching(g, m.getEdges()), () -> who + " returns " + m.getEdges() + ", which is not a matching" + ctx);
+        double w = Brute.weight(g, m.getEdges());
+        if (Math.abs(m.getWeight() - w) >= 1e-9 && m.getWeight() == m.getEdges().size() && (who.equals("HopcroftKarp") || who.equals("SparseEdmonds"))) {
+            // known jgrapht/28: these two report the cardinality as the weight
+            count("known jgrapht/28");
+        } else {
+            check(Math.abs(m.getWeight() - w) < 1e-9, () -> who + ".getWeight() = " + m.getWeight() + " but the edges weigh " + w + ctx);
+        }
+        Set<Integer> matched = new HashSet<>();
+        for (DefaultWeightedEdge e : m.getEdges()) {
+            matched.add(g.getEdgeSource(e));
+            matched.add(g.getEdgeTarget(e));
+        }
+        for (int v : g.vertexSet()) {
+            check(m.isMatched(v) == matched.contains(v), () -> who + ".isMatched(" + v + ") = " + m.isMatched(v) + " for edges " + m.getEdges() + ctx);
+        }
+        boolean perfect = matched.size() == g.vertexSet().size();
+        check(m.isPerfect() == perfect, () -> who + ".isPerfect() = " + m.isPerfect() + " with " + matched.size() + " of " + g.vertexSet().size() + " vertices matched" + ctx);
+    }
