+    @Test
+    void matchingsMatchTheBitmaskDynamicProgram() {
+        Hegel.test(tc -> {
+            GraphGen.Spec spec = GraphGen.simpleUndirected(tc, true);
+            int nv = n(tc, 0, 9);
+            Graph<Integer, DefaultWeightedEdge> g = GraphGen.graph(tc, spec, nv, n(tc, 0, 18));
+            String ctx = " for " + GraphGen.show(g);
+            int card = Brute.maxMatching(g);
+            double maxW = Brute.maxWeightMatching(g);
+            double perfectMin = Brute.minWeightPerfectMatching(g);
+            count("card-" + card);
+            for (String who : new String[] {"DenseEdmonds", "SparseEdmonds"}) {
+                MatchingAlgorithm<Integer, DefaultWeightedEdge> alg = who.equals("DenseEdmonds") ? new DenseEdmondsMaximumCardinalityMatching<>(g) : new SparseEdmondsMaximumCardinalityMatching<>(g);
+                Matching<Integer, DefaultWeightedEdge> m;
+                try {
+                    m = alg.getMatching();
+                } catch (RuntimeException | AssertionError e) {
+                    if (e instanceof AssertionError && g.vertexSet().isEmpty()) {
+                        // known jgrapht/27: a queue of capacity 0 fails its assertion on the null graph
+                        count("known jgrapht/27");
+                    } else {
+                        fail(who + ".getMatching() throws " + e + ctx);
+                    }
+                    continue;
+                }
+                checkMatching(g, m, who, ctx);
+                check(m.getEdges().size() == card, () -> who + " matching has " + m.getEdges().size() + " edges, maximum is " + card + ctx);
+            }
+            if (!g.vertexSet().isEmpty()) { // the null graph fails both algorithms' assertion (known jgrapht/27, counted above)
+                DenseEdmondsMaximumCardinalityMatching<Integer, DefaultWeightedEdge> dense = new DenseEdmondsMaximumCardinalityMatching<>(g);
+                Matching<Integer, DefaultWeightedEdge> dm = dense.getMatching();
+                check(dense.isMaximumMatching(dm), () -> "DenseEdmonds.isMaximumMatching rejects its own matching " + dm.getEdges() + ctx);
+                SparseEdmondsMaximumCardinalityMatching<Integer, DefaultWeightedEdge> sparse = new SparseEdmondsMaximumCardinalityMatching<>(g);
+                Matching<Integer, DefaultWeightedEdge> sm = sparse.getMatching();
+                check(SparseEdmondsMaximumCardinalityMatching.isOptimalMatching(g, sm.getEdges(), sparse.getOddSetCover()), () -> "SparseEdmonds odd set cover " + sparse.getOddSetCover() + " does not certify " + sm.getEdges() + ctx);
+            }
+            Matching<Integer, DefaultWeightedEdge> greedy = new GreedyMaximumCardinalityMatching<>(g, chance(tc, 50)).getMatching();
+            checkMatching(g, greedy, "GreedyMaximumCardinality", ctx);
+            check(2 * greedy.getEdges().size() >= card, () -> "GreedyMaximumCardinality finds " + greedy.getEdges().size() + " edges, less than half of " + card + ctx);
+            // maximal: no edge can be added
+            for (DefaultWeightedEdge e : g.edgeSet()) {
+                check(greedy.isMatched(g.getEdgeSource(e)) || greedy.isMatched(g.getEdgeTarget(e)), () -> "GreedyMaximumCardinality matching " + greedy.getEdges() + " is not maximal: " + e + " could be added" + ctx);
+            }
+            // weighted
+            Matching<Integer, DefaultWeightedEdge> kw = new KolmogorovWeightedMatching<>(g, ObjectiveSense.MAXIMIZE).getMatching();
+            checkMatching(g, kw, "KolmogorovWeightedMatching(MAXIMIZE)", ctx);
+            check(Math.abs(kw.getWeight() - maxW) < 1e-9, () -> "KolmogorovWeightedMatching(MAXIMIZE) weighs " + kw.getWeight() + ", the maximum is " + maxW + ctx);
+            Matching<Integer, DefaultWeightedEdge> kmin = new KolmogorovWeightedMatching<>(g, ObjectiveSense.MINIMIZE).getMatching();
+            checkMatching(g, kmin, "KolmogorovWeightedMatching(MINIMIZE)", ctx);
+            check(kmin.getWeight() <= 1e-9 && kmin.getWeight() >= -1e-9 || spec.minW() == 0, () -> "KolmogorovWeightedMatching(MINIMIZE) weighs " + kmin.getWeight() + " though the empty matching weighs 0" + ctx);
+            Matching<Integer, DefaultWeightedEdge> gw = new GreedyWeightedMatching<>(g, false).getMatching();
+            checkMatching(g, gw, "GreedyWeightedMatching", ctx);
+            check(2 * gw.getWeight() + 1e-9 >= maxW, () -> "GreedyWeightedMatching weighs " + gw.getWeight() + ", less than half of " + maxW + ctx);
+            Matching<Integer, DefaultWeightedEdge> pg = new PathGrowingWeightedMatching<>(g, chance(tc, 50)).getMatching();
+            checkMatching(g, pg, "PathGrowingWeightedMatching", ctx);
+            check(2 * pg.getWeight() + 1e-9 >= maxW, () -> "PathGrowingWeightedMatching weighs " + pg.getWeight() + ", less than half of " + maxW + ctx);
+            // perfect matchings
+            boolean perfectExists = 2 * card == g.vertexSet().size();
+            if (perfectExists) {
+                for (ObjectiveSense sense : ObjectiveSense.values()) {
+                    Matching<Integer, DefaultWeightedEdge> pm;
+                    try {
+                        pm = new KolmogorovWeightedPerfectMatching<>(g, sense).getMatching();
+                    } catch (RuntimeException e) {
+                        fail("KolmogorovWeightedPerfectMatching(" + sense + ") throws " + e + " though a perfect matching exists" + ctx);
+                        continue;
+                    }
+                    checkMatching(g, pm, "KolmogorovWeightedPerfectMatching(" + sense + ")", ctx);
+                    check(pm.isPerfect(), () -> "KolmogorovWeightedPerfectMatching(" + sense + ") is not perfect: " + pm.getEdges() + ctx);
+                    if (sense == ObjectiveSense.MINIMIZE) {
+                        check(Math.abs(pm.getWeight() - perfectMin) < 1e-9, () -> "KolmogorovWeightedPerfectMatching(MINIMIZE) weighs " + pm.getWeight() + ", the minimum is " + perfectMin + ctx);
+                    } else {
+                        double perfectMax = -perfectMinOfNegated(g);
+                        check(Math.abs(pm.getWeight() - perfectMax) < 1e-9, () -> "KolmogorovWeightedPerfectMatching(MAXIMIZE) weighs " + pm.getWeight() + ", the maximum is " + perfectMax + ctx);
+                    }
+                }
+            } else if (!g.vertexSet().isEmpty()) {
+                try {
+                    Matching<Integer, DefaultWeightedEdge> pm = new KolmogorovWeightedPerfectMatching<>(g).getMatching();
+                    fail("KolmogorovWeightedPerfectMatching returns " + pm.getEdges() + " though no perfect matching exists" + ctx);
+                } catch (IllegalArgumentException expected) {
+                    // documented
+                }
+            }
+        }, Zoo.settings("matchingsMatchTheBitmaskDynamicProgram"));
+    }
+
+    static double perfectMinOfNegated(Graph<Integer, DefaultWeightedEdge> g) {
+        Graph<Integer, DefaultWeightedEdge> neg = new GraphGen.Spec(false, false, false, true, 0, 0).empty();
+        for (int v : g.vertexSet()) {
+            neg.addVertex(v);
+        }
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            DefaultWeightedEdge f = neg.addEdge(g.getEdgeSource(e), g.getEdgeTarget(e));
+            neg.setEdgeWeight(f, -g.getEdgeWeight(e));
+        }
+        return Brute.minWeightPerfectMatching(neg);
+    }
