+    @Test
+    void graphWalksFollowTheirContract() {
+        Hegel.test(tc -> {
+            boolean directed = chance(tc, 50);
+            GraphGen.Spec spec = GraphGen.spec(tc, directed, true);
+            Graph<Integer, DefaultWeightedEdge> g = GraphGen.connected(tc, spec, n(tc, 1, 7), n(tc, 0, 8));
+            String ctx = " for " + GraphGen.show(g);
+            // a random walk along the edges
+            int len = n(tc, 0, 6);
+            List<DefaultWeightedEdge> es = new ArrayList<>();
+            List<Integer> vs = new ArrayList<>();
+            int u = GraphGen.vertex(tc, g);
+            vs.add(u);
+            for (int i = 0; i < len; i++) {
+                List<DefaultWeightedEdge> out = new ArrayList<>(g.outgoingEdgesOf(u));
+                if (out.isEmpty()) {
+                    break;
+                }
+                DefaultWeightedEdge e = out.get(n(tc, 0, out.size() - 1));
+                int v = g.getEdgeSource(e) == u ? g.getEdgeTarget(e) : g.getEdgeSource(e);
+                es.add(e);
+                vs.add(v);
+                u = v;
+            }
+            double w = weight(g, es);
+            int start = vs.get(0);
+            int end = vs.get(vs.size() - 1);
+            GraphWalk<Integer, DefaultWeightedEdge> walk = new GraphWalk<>(g, start, end, vs, es, w);
+            try {
+                walk.verify();
+            } catch (RuntimeException e) {
+                fail("GraphWalk.verify rejects a real walk " + vs + " / " + es + ": " + e + ctx);
+            }
+            check(walk.getLength() == es.size() && walk.getWeight() == w, () -> "GraphWalk length " + walk.getLength() + " weight " + walk.getWeight() + " for " + es.size() + " edges of weight " + w + ctx);
+            check(walk.getVertexList().equals(vs) && walk.getEdgeList().equals(es), () -> "GraphWalk lists differ from the input" + ctx);
+            check(walk.isEmpty() == false, () -> "GraphWalk with a start vertex isEmpty()" + ctx);
+            // edge-only construction: the vertex list is derived
+            GraphWalk<Integer, DefaultWeightedEdge> fromEdges = new GraphWalk<>(g, start, end, es, w);
+            check(fromEdges.getVertexList().equals(vs), () -> "GraphWalk from edges derives the vertices " + fromEdges.getVertexList() + " for " + vs + ctx);
+            check(fromEdges.equals(walk) && fromEdges.hashCode() == walk.hashCode(), () -> "GraphWalk from edges is not equal to the same walk from both lists" + ctx);
+            // vertex-only construction on a simple graph
+            if (!spec.multi()) {
+                GraphWalk<Integer, DefaultWeightedEdge> fromVertices = new GraphWalk<>(g, vs, w);
+                List<DefaultWeightedEdge> derived = fromVertices.getEdgeList();
+                check(derived.equals(es), () -> "GraphWalk from vertices derives the edges " + derived + " for " + es + ctx);
+            }
+            // the reverse walk exists in an undirected graph, or in a directed one when every arc has its twin
+            boolean reversible = !directed;
+            if (directed) {
+                reversible = true;
+                for (int i = 0; i < es.size(); i++) {
+                    if (!g.containsEdge(vs.get(i + 1), vs.get(i))) {
+                        reversible = false;
+                    }
+                }
+            }
+            if (reversible) {
+                GraphWalk<Integer, DefaultWeightedEdge> rev = walk.reverse();
+                List<Integer> rvs = new ArrayList<>(vs);
+                Collections.reverse(rvs);
+                check(rev.getStartVertex() == end && rev.getEndVertex() == start && rev.getVertexList().equals(rvs), () -> "GraphWalk.reverse() of " + vs + " is " + rev.getVertexList() + ctx);
+                check(rev.getLength() == es.size(), () -> "GraphWalk.reverse() has length " + rev.getLength() + " for " + es.size() + " edges" + ctx);
+                try {
+                    rev.verify();
+                } catch (RuntimeException e) {
+                    fail("GraphWalk.reverse() does not verify: " + e + ctx);
+                }
+                double rw = weight(g, rev.getEdgeList());
+                if (!directed) {
+                    check(rev.getWeight() == w && rw == w, () -> "GraphWalk.reverse() weighs " + rev.getWeight() + " (edges " + rw + ") for a walk of weight " + w + ctx);
+                } else {
+                    check(rev.getWeight() == rw, () -> "GraphWalk.reverse() weighs " + rev.getWeight() + " but its edges sum to " + rw + ctx);
+                }
+                GraphWalk<Integer, DefaultWeightedEdge> back = rev.reverse();
+                check(back.getVertexList().equals(vs) && back.getEdgeList().size() == es.size(), () -> "GraphWalk reversed twice is " + back.getVertexList() + " for " + vs + ctx);
+            } else {
+                try {
+                    GraphWalk<Integer, DefaultWeightedEdge> rev = walk.reverse();
+                    fail("GraphWalk.reverse() of " + vs + " gives " + rev + " though an arc has no twin" + ctx);
+                } catch (RuntimeException expected) {
+                    // documented: InvalidGraphWalkException
+                }
+            }
+            // concatenation with a second walk starting at the end
+            List<DefaultWeightedEdge> es2 = new ArrayList<>();
+            List<Integer> vs2 = new ArrayList<>();
+            vs2.add(end);
+            u = end;
+            for (int i = 0; i < n(tc, 0, 3); i++) {
+                List<DefaultWeightedEdge> out = new ArrayList<>(g.outgoingEdgesOf(u));
+                if (out.isEmpty()) {
+                    break;
+                }
+                DefaultWeightedEdge e = out.get(n(tc, 0, out.size() - 1));
+                int v = g.getEdgeSource(e) == u ? g.getEdgeTarget(e) : g.getEdgeSource(e);
+                es2.add(e);
+                vs2.add(v);
+                u = v;
+            }
+            GraphWalk<Integer, DefaultWeightedEdge> second = new GraphWalk<>(g, end, u, vs2, es2, weight(g, es2));
+            Function<GraphWalk<Integer, DefaultWeightedEdge>, Double> sum = x -> weight(g, x.getEdgeList());
+            GraphWalk<Integer, DefaultWeightedEdge> cat = walk.concat(second, sum);
+            List<Integer> catVs = new ArrayList<>(vs);
+            catVs.addAll(vs2.subList(1, vs2.size()));
+            List<DefaultWeightedEdge> catEs = new ArrayList<>(es);
+            catEs.addAll(es2);
+            check(cat.getVertexList().equals(catVs) && cat.getEdgeList().equals(catEs), () -> "GraphWalk.concat gives " + cat.getVertexList() + " / " + cat.getEdgeList() + " for " + catVs + " / " + catEs + ctx);
+            check(cat.getWeight() == w + weight(g, es2) && cat.getLength() == catEs.size(), () -> "GraphWalk.concat weight " + cat.getWeight() + " length " + cat.getLength() + " for " + (w + weight(g, es2)) + ", " + catEs.size() + ctx);
+            try {
+                cat.verify();
+            } catch (RuntimeException e) {
+                fail("GraphWalk.concat does not verify: " + e + ctx);
+            }
+            // a walk that is not a walk must fail verify
+            if (es.size() >= 1 && g.vertexSet().size() >= 2) {
+                List<Integer> bad = new ArrayList<>(vs);
+                int i = n(tc, 0, bad.size() - 1);
+                int other = -1;
+                for (int v : g.vertexSet()) {
+                    if (v != bad.get(i)) {
+                        other = v;
+                        break;
+                    }
+                }
+                bad.set(i, other);
+                GraphWalk<Integer, DefaultWeightedEdge> wrong = new GraphWalk<>(g, bad.get(0), bad.get(bad.size() - 1), bad, es, w);
+                boolean stillWalk = true;
+                for (int j = 0; j < es.size(); j++) {
+                    DefaultWeightedEdge e = es.get(j);
+                    int a = bad.get(j);
+                    int b = bad.get(j + 1);
+                    boolean ok = directed ? g.getEdgeSource(e) == a && g.getEdgeTarget(e) == b
+                            : (g.getEdgeSource(e) == a && g.getEdgeTarget(e) == b) || (g.getEdgeSource(e) == b && g.getEdgeTarget(e) == a);
+                    if (!ok) {
+                        stillWalk = false;
+                    }
+                }
+                if (!stillWalk) {
+                    try {
+                        wrong.verify();
+                        fail("GraphWalk.verify accepts " + bad + " with edges " + es + ", which is not a walk" + ctx);
+                    } catch (RuntimeException expected) {
+                        // documented
+                    }
+                }
+            }
+            // the singleton and empty walks
+            GraphWalk<Integer, DefaultWeightedEdge> single = GraphWalk.singletonWalk(g, start);
+            check(single.getLength() == 0 && single.getWeight() == 0 && single.getVertexList().equals(List.of(start)) && single.getEdgeList().isEmpty() && !single.isEmpty(), () -> "singletonWalk(" + start + ") = " + single + " length " + single.getLength() + " weight " + single.getWeight() + ctx);
+            GraphWalk<Integer, DefaultWeightedEdge> empty = GraphWalk.emptyWalk(g);
+            check(empty.isEmpty() && empty.getLength() == 0 && empty.getVertexList().isEmpty() && empty.getEdgeList().isEmpty(), () -> "emptyWalk = " + empty + ctx);
+            try {
+                empty.verify();
+                single.verify();
+            } catch (RuntimeException e) {
+                fail("verify rejects the empty or singleton walk: " + e + ctx);
+            }
+        }, Zoo.settings("graphWalksFollowTheirContract"));
+    }
+}
