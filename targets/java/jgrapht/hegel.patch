+    /** Vertex connectivity by removing vertex subsets: the smallest set whose removal disconnects the rest (n - 1 for complete graphs). */
+    static int vertexConnectivity(Graph<Integer, DefaultWeightedEdge> g) {
+        List<Integer> vs = new ArrayList<>(g.vertexSet());
+        int n = vs.size();
+        if (n <= 1) {
+            return 0;
+        }
+        if (!Brute.connected(g)) {
+            return 0;
+        }
+        for (int size = 1; size < n - 1; size++) {
+            for (int mask = 0; mask < (1 << n); mask++) {
+                if (Integer.bitCount(mask) != size) {
+                    continue;
+                }
+                Set<Integer> keep = new HashSet<>();
+                for (int i = 0; i < n; i++) {
+                    if ((mask >> i & 1) == 0) {
+                        keep.add(vs.get(i));
+                    }
+                }
+                Graph<Integer, DefaultWeightedEdge> sub = new org.jgrapht.graph.AsSubgraph<>(g, keep);
+                if (!Brute.connected(sub)) {
+                    return size;
+                }
+            }
+        }
+        return n - 1;
+    }
