+    @Test
+    void toursMatchHeldKarp() {
+        Hegel.test(tc -> {
+            int nv = n(tc, 1, 8);
+            boolean metric = chance(tc, 60);
+            GraphGen.Spec spec = new GraphGen.Spec(false, false, false, true, metric ? 0 : 1, 30);
+            Graph<Integer, DefaultWeightedEdge> g = GraphGen.complete(tc, nv, metric, spec);
+            String ctx = " for " + GraphGen.show(g);
+            double opt = Brute.tsp(g);
+            count(metric ? "metric" : "arbitrary");
+            for (String who : new String[] {"HeldKarp", "Christofides", "TwoApprox", "NearestNeighbor", "NearestInsertion", "Greedy", "TwoOpt", "Random"}) {
+                if ((who.equals("Christofides") || who.equals("TwoApprox")) && !metric) {
+                    continue;
+                }
+                GraphPath<Integer, DefaultWeightedEdge> tour;
+                try {
+                    tour = switch (who) {
+                        case "HeldKarp" -> new HeldKarpTSP<Integer, DefaultWeightedEdge>().getTour(g);
+                        case "Christofides" -> new ChristofidesThreeHalvesApproxMetricTSP<Integer, DefaultWeightedEdge>().getTour(g);
+                        case "TwoApprox" -> new TwoApproxMetricTSP<Integer, DefaultWeightedEdge>().getTour(g);
+                        case "NearestNeighbor" -> new NearestNeighborHeuristicTSP<Integer, DefaultWeightedEdge>(GraphGen.vertex(tc, g)).getTour(g);
+                        case "NearestInsertion" -> new NearestInsertionHeuristicTSP<Integer, DefaultWeightedEdge>().getTour(g);
+                        case "Greedy" -> new GreedyHeuristicTSP<Integer, DefaultWeightedEdge>().getTour(g);
+                        case "TwoOpt" -> new TwoOptHeuristicTSP<Integer, DefaultWeightedEdge>(1, 7L).getTour(g);
+                        default -> new RandomTourTSP<Integer, DefaultWeightedEdge>(new java.util.Random(11)).getTour(g);
+                    };
+                } catch (RuntimeException e) {
+                    fail(who + ".getTour throws " + e + ctx);
+                    continue;
+                }
+                double w = checkTour(g, tour, who, ctx);
+                check(w + 1e-9 >= opt, () -> who + " tour weighs " + w + ", below the optimum " + opt + ": " + tour + ctx);
+                if (who.equals("HeldKarp")) {
+                    check(w == opt, () -> "HeldKarpTSP tour weighs " + w + ", the optimum is " + opt + ": " + tour + ctx);
+                }
+                if (who.equals("Christofides")) {
+                    check(w <= 1.5 * opt + 1e-9, () -> "Christofides tour weighs " + w + ", more than 3/2 of the optimum " + opt + ": " + tour + ctx);
+                }
+                if (who.equals("TwoApprox")) {
+                    check(w <= 2 * opt + 1e-9, () -> "TwoApproxMetricTSP tour weighs " + w + ", more than twice the optimum " + opt + ": " + tour + ctx);
+                }
+            }
+            // improving a tour never makes it heavier
+            if (nv >= 3) {
+                GraphPath<Integer, DefaultWeightedEdge> start = new RandomTourTSP<Integer, DefaultWeightedEdge>(new java.util.Random(3)).getTour(g);
+                GraphPath<Integer, DefaultWeightedEdge> better = new TwoOptHeuristicTSP<Integer, DefaultWeightedEdge>().improveTour(start);
+                double a = checkTour(g, start, "RandomTour", ctx);
+                double b = checkTour(g, better, "TwoOpt.improveTour", ctx);
+                check(b <= a + 1e-9, () -> "TwoOptHeuristicTSP.improveTour makes the tour heavier: " + a + " -> " + b + ctx);
+            }
+            // Palmer's construction on a graph with Ore's property
+            Graph<Integer, DefaultWeightedEdge> ore = GraphGen.graph(tc, GraphGen.simpleUndirected(tc, false), n(tc, 3, 7), n(tc, 5, 21));
+            boolean hasOre = hasOre(ore);
+            check(GraphTests.hasOreProperty(ore) == hasOre, () -> "GraphTests.hasOreProperty = " + GraphTests.hasOreProperty(ore) + ", brute force " + hasOre + " for " + GraphGen.show(ore));
+            if (hasOre) {
+                count("ore");
+                GraphPath<Integer, DefaultWeightedEdge> ham = new PalmerHamiltonianCycle<Integer, DefaultWeightedEdge>().getTour(ore);
+                checkTour(ore, ham, "PalmerHamiltonianCycle", " for " + GraphGen.show(ore));
+            }
+        }, Zoo.settings("toursMatchHeldKarp"));
+    }
+
+    static boolean hasOre(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = g.vertexSet().size();
+        if (n < 3) {
+            return false;
+        }
+        for (int u : g.vertexSet()) {
+            for (int v : g.vertexSet()) {
+                if (u < v && !g.containsEdge(u, v) && g.degreeOf(u) + g.degreeOf(v) < n) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    /** A Hamiltonian cycle: closed, visits every vertex once, edges in the graph; returns its weight. */
+    static double checkTour(Graph<Integer, DefaultWeightedEdge> g, GraphPath<Integer, DefaultWeightedEdge> tour, String who, String ctx) {
+        List<Integer> vs = tour.getVertexList();
+        int n = g.vertexSet().size();
+        if (n == 1) {
+            check(vs.size() == 1 && tour.getEdgeList().isEmpty() && tour.getWeight() == 0, () -> who + " tour of a single vertex is " + tour + ctx);
+            return 0;
+        }
+        check(vs.size() == n + 1 && vs.get(0).equals(vs.get(n)), () -> who + " tour " + vs + " does not visit the " + n + " vertices once and return" + ctx);
+        check(new HashSet<>(vs).equals(g.vertexSet()), () -> who + " tour " + vs + " misses vertices of " + g.vertexSet() + ctx);
+        double w = PathsTest.checkPath(g, tour, vs.get(0), vs.get(0), who, ctx);
+        check(Math.abs(w - tour.getWeight()) < 1e-9, () -> who + " tour weighs " + tour.getWeight() + " but its edges sum to " + w + ctx);
+        return w;
+    }
