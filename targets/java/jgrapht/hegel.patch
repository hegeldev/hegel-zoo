+            boolean multi = false;
+            Set<List<Integer>> pairs = new HashSet<>();
+            for (DefaultWeightedEdge e : g.edgeSet()) {
+                int u = g.getEdgeSource(e);
+                int v = g.getEdgeTarget(e);
+                if (u == v) {
+                    loops = true;
+                }
+                List<Integer> key = directed ? List.of(u, v) : List.of(Math.min(u, v), Math.max(u, v));
+                if (!pairs.add(key)) {
+                    multi = true;
+                }
+            }
+            final boolean l = loops;
+            final boolean m = multi;
+            check(GraphTests.hasSelfLoops(g) == l, () -> "hasSelfLoops = " + GraphTests.hasSelfLoops(g) + ", expected " + l + ctx);
+            check(GraphTests.hasMultipleEdges(g) == m, () -> "hasMultipleEdges = " + GraphTests.hasMultipleEdges(g) + ", expected " + m + ctx);
+            check(GraphTests.isSimple(g) == (!l && !m), () -> "isSimple = " + GraphTests.isSimple(g) + ", expected " + (!l && !m) + ctx);
+            check(GraphTests.isEmpty(g) == g.edgeSet().isEmpty(), () -> "isEmpty = " + GraphTests.isEmpty(g) + ctx);
+            int nv = g.vertexSet().size();
+            boolean complete = !l && !m && g.edgeSet().size() == (directed ? nv * (nv - 1) : nv * (nv - 1) / 2);
+            check(GraphTests.isComplete(g) == complete, () -> "isComplete = " + GraphTests.isComplete(g) + ", expected " + complete + ctx);
+            boolean bip = Brute.isBipartite(g);
+            BipartitePartitioning<Integer, DefaultWeightedEdge> bp = new BipartitePartitioning<>(g);
+            if (bip && !bp.isBipartite() && (m || directed)) {
+                // known jgrapht/6: the quick rejection 4|E| > |V|^2 assumes a simple graph
+                count("known jgrapht/6");
+            } else {
+                check(GraphTests.isBipartite(g) == bip, () -> "isBipartite = " + GraphTests.isBipartite(g) + ", brute force " + bip + ctx);
+                check(bp.isBipartite() == bip, () -> "BipartitePartitioning.isBipartite() = " + bp.isBipartite() + ", brute force " + bip + ctx);
+            }
+            if (bip) {
+                Partitioning<Integer> p = bp.getPartitioning();
+                check(p != null && p.getNumberPartitions() == 2, () -> "BipartitePartitioning.getPartitioning() = " + p + ctx);
+                if (p != null) {
+                    Set<Integer> p1 = p.getPartition(0);
+                    Set<Integer> p2 = p.getPartition(1);
+                    check(GraphTests.isBipartitePartition(g, p1, p2), () -> "isBipartitePartition rejects " + p1 + " / " + p2 + ctx);
+                    check(bp.isValidPartitioning(p), () -> "isValidPartitioning rejects its own partitioning " + p + ctx);
+                    Set<Integer> all = new HashSet<>(p1);
+                    all.addAll(p2);
+                    check(all.equals(g.vertexSet()) && p1.size() + p2.size() == nv, () -> "partitioning " + p1 + " / " + p2 + " does not partition the vertices" + ctx);
+                    for (DefaultWeightedEdge e : g.edgeSet()) {
+                        check(p1.contains(g.getEdgeSource(e)) != p1.contains(g.getEdgeTarget(e)), () -> "edge " + e + " inside a part of " + p1 + " / " + p2 + ctx);
+                    }
+                }
+            } else {
+                check(bp.getPartitioning() == null, () -> "BipartitePartitioning.getPartitioning() = " + bp.getPartitioning() + " for a non-bipartite graph" + ctx);
+            }
+            boolean triangleFree = Brute.maxClique(g) < 3;
+            if (!directed) {
+                check(GraphTests.isTriangleFree(g) == triangleFree, () -> "isTriangleFree = " + GraphTests.isTriangleFree(g) + ", brute force " + triangleFree + ctx);
+            }
+            boolean cubic = true;
+            for (int v : g.vertexSet()) {
+                if (Brute.degree(g, v) != 3) {
+                    cubic = false;
+                }
+            }
+            final boolean cb = cubic;
+            check(GraphTests.isCubic(g) == cb, () -> "isCubic = " + GraphTests.isCubic(g) + ", expected " + cb + ctx);
+            if (!directed) {
+                int comps = Brute.components(g).size();
+                boolean forest = nv > 0 && g.edgeSet().size() + comps == nv && !l;
+                boolean tree = forest && comps == 1;
+                check(GraphTests.isForest(g) == forest, () -> "isForest = " + GraphTests.isForest(g) + ", expected " + forest + ctx);
+                check(GraphTests.isTree(g) == tree, () -> "isTree = " + GraphTests.isTree(g) + ", expected " + tree + ctx);
+                if (nv > 0) {
+                    int maxDeg = 0;
+                    for (int v : g.vertexSet()) {
+                        maxDeg = Math.max(maxDeg, Brute.degree(g, v));
+                    }
+                    boolean overfull = g.edgeSet().size() > maxDeg * (nv / 2);
+                    check(GraphTests.isOverfull(g) == overfull, () -> "isOverfull = " + GraphTests.isOverfull(g) + ", expected " + overfull + ctx);
+                } else {
+                    try {
+                        check(!GraphTests.isOverfull(g), () -> "isOverfull = true for the null graph" + ctx);
+                    } catch (java.util.NoSuchElementException e) {
+                        // known jgrapht/15: the maximum degree of no vertices
+                        count("known jgrapht/15");
+                    }
+                }
+                boolean planar = isPlanarBrute(g);
+                BoyerMyrvoldPlanarityInspector<Integer, DefaultWeightedEdge> bm = new BoyerMyrvoldPlanarityInspector<>(g);
+                boolean bmPlanar = bm.isPlanar();
+                if (planar && !bmPlanar && (l || m)) {
+                    // known jgrapht/11: self loops and parallel edges make the inspector answer "not planar"
+                    count("known jgrapht/11");
+                } else {
+                    check(bmPlanar == planar, () -> "BoyerMyrvoldPlanarityInspector.isPlanar() = " + bmPlanar + ", brute force " + planar + ctx);
+                    check(GraphTests.isPlanar(g) == planar, () -> "GraphTests.isPlanar = " + GraphTests.isPlanar(g) + ", brute force " + planar + ctx);
+                }
+                if (bmPlanar) {
+                    var emb = bm.getEmbedding();
+                    for (int v : g.vertexSet()) {
+                        List<DefaultWeightedEdge> around = emb.getEdgesAround(v);
+                        boolean ok = new HashSet<>(around).equals(g.edgesOf(v)) && around.size() == Brute.degree(g, v);
+                        if (!ok && (l || m)) {
+                            // known jgrapht/11: the embedding of a multigraph omits parallel edges
+                            count("known jgrapht/11");
+                        } else {
+                            check(ok, () -> "embedding around " + v + " lists " + around + " for edges " + g.edgesOf(v) + ctx);
+                        }
+                    }
+                } else if (!planar) {
+                    Graph<Integer, DefaultWeightedEdge> kur = bm.getKuratowskiSubdivision();
+                    check(kur != null && GraphTests.isKuratowskiSubdivision(kur), () -> "Kuratowski subdivision " + kur + " is not one" + ctx);
+                    if (kur != null) {
+                        for (DefaultWeightedEdge e : kur.edgeSet()) {
+                            check(g.containsEdge(e), () -> "Kuratowski subdivision uses a foreign edge " + e + ctx);
+                        }
+                    }
+                }
+                // split graphs: the vertices partition into a clique and an independent set
+                if (!l && !m) {
+                    boolean split = isSplit(g);
+                    check(GraphTests.isSplit(g) == split, () -> "isSplit = " + GraphTests.isSplit(g) + ", brute force " + split + ctx);
+                }
+            } else {
+                // DAGs: the class rejects cycles, iterates in topological order, ancestors and descendants
+                DirectedAcyclicGraph<Integer, DefaultWeightedEdge> dag = new DirectedAcyclicGraph<>(null, () -> new DefaultWeightedEdge(), false, spec.multi());
+                for (int v : g.vertexSet()) {
+                    dag.addVertex(v);
+                }
+                Graph<Integer, DefaultWeightedEdge> kept = new GraphGen.Spec(true, spec.multi(), false, false, 0, 0).empty();
+                for (int v : g.vertexSet()) {
+                    kept.addVertex(v);
+                }
+                for (DefaultWeightedEdge e : g.edgeSet()) {
+                    int u = g.getEdgeSource(e);
+                    int v = g.getEdgeTarget(e);
+                    boolean creates = u == v || Brute.reach(kept)[v][u];
+                    try {
+                        DefaultWeightedEdge added = dag.addEdge(u, v);
+                        check(!creates, () -> "DirectedAcyclicGraph.addEdge(" + u + ", " + v + ") = " + added + " though it closes a cycle in " + GraphGen.show(kept));
+                        if (added != null) {
+                            kept.addEdge(u, v);
+                        }
+                    } catch (IllegalArgumentException ex) {
+                        check(creates || (u == v), () -> "DirectedAcyclicGraph.addEdge(" + u + ", " + v + ") throws " + ex + " though no cycle would form in " + GraphGen.show(kept));
+                        check(ex instanceof GraphCycleProhibitedException || u == v, () -> "DirectedAcyclicGraph.addEdge throws " + ex.getClass() + ctx);
+                    }
+                }
+                List<Integer> order = new ArrayList<>();
+                for (int v : dag) {
+                    order.add(v);
+                }
+                check(Brute.isTopological(kept, order), () -> "DirectedAcyclicGraph iterates " + order + ", not a topological order of " + GraphGen.show(kept));
+                List<Integer> topo = new ArrayList<>();
+                new TopologicalOrderIterator<>(kept).forEachRemaining(topo::add);
+                check(Brute.isTopological(kept, topo), () -> "TopologicalOrderIterator gives " + topo + " for " + GraphGen.show(kept));
+                boolean[][] r = Brute.reach(kept);
+                for (int v : kept.vertexSet()) {
+                    Set<Integer> anc = new HashSet<>();
+                    Set<Integer> desc = new HashSet<>();
+                    for (int u : kept.vertexSet()) {
+                        if (u != v && r[u][v]) {
+                            anc.add(u);
+                        }
+                        if (u != v && r[v][u]) {
+                            desc.add(u);
+                        }
+                    }
+                    check(dag.getAncestors(v).equals(anc), () -> "getAncestors(" + v + ") = " + dag.getAncestors(v) + ", expected " + anc + " in " + GraphGen.show(kept));
+                    check(dag.getDescendants(v).equals(desc), () -> "getDescendants(" + v + ") = " + dag.getDescendants(v) + ", expected " + desc + " in " + GraphGen.show(kept));
+                }
+                if (Brute.hasCycle(g)) {
+                    try {
+                        List<Integer> t = new ArrayList<>();
+                        new TopologicalOrderIterator<>(g).forEachRemaining(t::add);
+                        fail("TopologicalOrderIterator yields " + t + " for a cyclic graph" + ctx);
+                    } catch (IllegalArgumentException expected) {
+                        // documented: NotDirectedAcyclicGraphException
+                    }
+                }
+            }
+            // traversals: BFS depths are hop distances, DFS visits exactly the reachable vertices
+            if (nv > 0) {
+                int s = GraphGen.vertex(tc, g);
+                double[][] hops = Brute.distances(new org.jgrapht.graph.AsUnweightedGraph<>(g));
+                BreadthFirstIterator<Integer, DefaultWeightedEdge> bfs = new BreadthFirstIterator<>(g, s);
+                Set<Integer> visited = new HashSet<>();
+                Integer prev = null;
+                while (bfs.hasNext()) {
+                    int v = bfs.next();
+                    visited.add(v);
+                    int depth = bfs.getDepth(v);
+                    final Integer p = prev;
+                    check(depth == (int) hops[s][v], () -> "BreadthFirstIterator depth of " + v + " from " + s + " is " + depth + ", hops " + hops[s][v] + ctx);
+                    if (v != s) {
+                        Integer parent = bfs.getParent(v);
+                        DefaultWeightedEdge te = bfs.getSpanningTreeEdge(v);
+                        check(parent != null && hops[s][parent] == depth - 1 && te != null && g.containsEdge(te) && (g.getEdgeSource(te) == parent || g.getEdgeTarget(te) == parent), () -> "BreadthFirstIterator parent of " + v + " is " + parent + " via " + te + " at depth " + depth + ctx);
+                    }
+                    if (p != null) {
+                        check(bfs.getDepth(p) <= depth, () -> "BreadthFirstIterator visits " + p + " (depth " + bfs.getDepth(p) + ") before " + v + " (depth " + depth + ")" + ctx);
+                    }
+                    prev = v;
+                }
+                Set<Integer> reachable = new HashSet<>();
+                for (int v : g.vertexSet()) {
+                    if (hops[s][v] != Brute.INF) {
+                        reachable.add(v);
+                    }
+                }
+                check(visited.equals(reachable), () -> "BreadthFirstIterator from " + s + " visits " + visited + ", reachable " + reachable + ctx);
+                Set<Integer> dfs = new HashSet<>();
+                new DepthFirstIterator<>(g, s).forEachRemaining(dfs::add);
+                check(dfs.equals(reachable), () -> "DepthFirstIterator from " + s + " visits " + dfs + ", reachable " + reachable + ctx);
+                Set<Integer> all = new HashSet<>();
+                new DepthFirstIterator<>(g).forEachRemaining(all::add);
+                check(all.equals(g.vertexSet()), () -> "DepthFirstIterator over all components visits " + all + ctx);
+            }
+        }, Zoo.settings("graphTestsAndDagsMatchTheirDefinitions"));
+    }
+
+    /** Split: some vertex subset is a clique and its complement independent. */
+    static boolean isSplit(Graph<Integer, DefaultWeightedEdge> g) {
+        if (g.vertexSet().isEmpty()) {
+            return false; // JGraphT's convention for the null graph
+        }
+        List<Integer> vs = new ArrayList<>(g.vertexSet());
+        for (int mask = 0; mask < (1 << vs.size()); mask++) {
+            Set<Integer> k = new HashSet<>();
+            Set<Integer> i = new HashSet<>();
+            for (int j = 0; j < vs.size(); j++) {
+                if ((mask >> j & 1) != 0) {
+                    k.add(vs.get(j));
+                } else {
+                    i.add(vs.get(j));
+                }
+            }
+            if (Brute.isClique(g, k) && Brute.isIndependent(g, i)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Planarity by Kuratowski's theorem on graphs of at most 7 vertices: a graph is non-planar iff it contains a
+     * subgraph that is a subdivision of K5 or K3,3, which for so few vertices means a K5 or K3,3 minor obtained by
+     * deleting edges/vertices and contracting at most two edges; simpler and exact: Euler's bound plus a search
+     * for a K5 or K3,3 subdivision by trying every subset of vertices as branch vertices with disjoint paths.
+     * Here the brute force is a search over subgraphs: non-planar iff some subgraph is a Kuratowski subdivision.
+     */
+    static boolean isPlanarBrute(Graph<Integer, DefaultWeightedEdge> g) {
+        // simple underlying graph
+        Graph<Integer, DefaultWeightedEdge> s = new GraphGen.Spec(false, false, false, false, 0, 0).empty();
+        for (int v : g.vertexSet()) {
+            s.addVertex(v);
+        }
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            int u = g.getEdgeSource(e);
+            int v = g.getEdgeTarget(e);
+            if (u != v && !s.containsEdge(u, v)) {
+                s.addEdge(u, v);
+            }
+        }
+        int nv = s.vertexSet().size();
+        int m = s.edgeSet().size();
+        if (nv < 5 || m <= 8) {
+            return true; // fewer than 9 edges: K5 needs 10, K3,3 needs 9
+        }
+        // enumerate edge subsets (m <= 21 for 7 vertices) and ask GraphTests for a Kuratowski subdivision
+        List<DefaultWeightedEdge> es = new ArrayList<>(s.edgeSet());
+        for (int mask = 0; mask < (1 << es.size()); mask++) {
+            if (Integer.bitCount(mask) < 9) {
+                continue;
+            }
+            Set<DefaultWeightedEdge> sub = new HashSet<>();
+            for (int i = 0; i < es.size(); i++) {
+                if ((mask >> i & 1) != 0) {
+                    sub.add(es.get(i));
+                }
+            }
+            Set<Integer> touched = new HashSet<>();
+            for (DefaultWeightedEdge e : sub) {
+                touched.add(s.getEdgeSource(e));
+                touched.add(s.getEdgeTarget(e));
+            }
+            if (isKuratowski(new AsSubgraph<>(s, touched, sub))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** Is this graph exactly a subdivision of K5 or K3,3? Contract the degree-2 vertices and compare. */
+    static boolean isKuratowski(Graph<Integer, DefaultWeightedEdge> g) {
+        List<Integer> branch = new ArrayList<>();
+        for (int v : g.vertexSet()) {
+            int d = g.degreeOf(v);
+            if (d == 2) {
+                continue;
+            }
+            if (d != 3 && d != 4) {
+                return false;
+            }
+            branch.add(v);
+        }
+        if (branch.size() == 5) {
+            for (int v : branch) {
+                if (g.degreeOf(v) != 4) {
+                    return false;
+                }
+            }
+        } else if (branch.size() == 6) {
+            for (int v : branch) {
+                if (g.degreeOf(v) != 3) {
+                    return false;
+                }
+            }
+        } else {
+            return false;
+        }
+        if (!Brute.connected(g)) {
+            return false;
+        }
+        // follow each path from a branch vertex through degree-2 vertices to the next branch vertex
+        Set<List<Integer>> links = new HashSet<>();
+        int paths = 0;
+        for (int b : branch) {
+            for (DefaultWeightedEdge e : g.edgesOf(b)) {
+                int prev = b;
+                int cur = Graphs.getOppositeVertex(g, e, b);
+                while (g.degreeOf(cur) == 2) {
+                    int next = -1;
+                    for (DefaultWeightedEdge f : g.edgesOf(cur)) {
+                        int o = Graphs.getOppositeVertex(g, f, cur);
+                        if (o != prev || (g.edgesOf(cur).size() == 2 && f != e && o == prev)) {
+                            next = o;
+                        }
+                    }
+                    if (next < 0) {
+                        return false;
+                    }
+                    prev = cur;
+                    cur = next;
+                }
+                if (cur == b) {
+                    return false;
+                }
+                links.add(List.of(Math.min(b, cur), Math.max(b, cur)));
+                paths++;
+            }
+        }
+        if (branch.size() == 5) {
+            return links.size() == 10 && paths == 20;
+        }
+        // K3,3: each branch vertex linked to exactly 3 others, bipartite
+        if (links.size() != 9 || paths != 18) {
+            return false;
+        }
+        Graph<Integer, DefaultWeightedEdge> k = new GraphGen.Spec(false, false, false, false, 0, 0).empty();
+        for (int b : branch) {
+            k.addVertex(b);
+        }
+        for (List<Integer> l : links) {
+            k.addEdge(l.get(0), l.get(1));
+        }
+        return Brute.isBipartite(k) && Brute.maxClique(k) == 2;
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000000..3a4b425229
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,128 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    private static final java.util.Map<String, Integer> STATS = new java.util.TreeMap<>();
+
+    /** Bumps a statistic; the counts are printed in collect mode (ZOO_COLLECT=1) via {@link #stats()}. */
+    static synchronized void count(String key) {
+        STATS.merge(key, 1, Integer::sum);
+    }
+
+    /** The statistics so far, cleared, as one line. */
+    static synchronized String stats() {
+        String s = STATS.toString();
+        STATS.clear();
+        return s;
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000000..7e317bbb9f
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
