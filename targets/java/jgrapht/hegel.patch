+                GusfieldEquivalentFlowTree<Integer, DefaultWeightedEdge> eq = new GusfieldEquivalentFlowTree<>(g);
+                for (int u : g.vertexSet()) {
+                    for (int v : g.vertexSet()) {
+                        if (u >= v) {
+                            continue;
+                        }
+                        double w = Brute.minCut(g, u, v);
+                        double a = gh.getMaximumFlowValue(u, v);
+                        double b = eq.getMaximumFlowValue(u, v);
+                        check(a == w, () -> "GusfieldGomoryHuCutTree flow " + u + "-" + v + " = " + a + ", minimum cut " + w + ctx);
+                        check(b == w, () -> "GusfieldEquivalentFlowTree flow " + u + "-" + v + " = " + b + ", minimum cut " + w + ctx);
+                        double c = gh.calculateMinCut(u, v);
+                        check(c == w, () -> "GusfieldGomoryHuCutTree.calculateMinCut(" + u + ", " + v + ") = " + c + ", brute force " + w + ctx);
+                        Set<Integer> src = gh.getSourcePartition();
+                        boolean[] inS = new boolean[Brute.nv(g)];
+                        for (int x : src) {
+                            inS[x] = true;
+                        }
+                        double cap = Brute.cutCapacity(g, inS);
+                        check(src.contains(u) && !src.contains(v) && cap == w, () -> "GusfieldGomoryHuCutTree partition " + src + " for " + u + "-" + v + " has capacity " + cap + ", minimum " + w + ctx);
+                    }
+                }
+                SimpleWeightedGraph<Integer, DefaultWeightedEdge> tree = gh.getGomoryHuTree();
+                check(tree.vertexSet().equals(g.vertexSet()) && tree.edgeSet().size() == g.vertexSet().size() - 1, () -> "Gomory-Hu tree has " + tree.vertexSet().size() + " vertices and " + tree.edgeSet().size() + " edges" + ctx);
+                // the global minimum cut
+                double global = Brute.globalMinCut(g);
+                double ghGlobal = gh.calculateMinCut();
+                check(ghGlobal == global, () -> "GusfieldGomoryHuCutTree.calculateMinCut() = " + ghGlobal + ", brute force " + global + ctx);
+                StoerWagnerMinimumCut<Integer, DefaultWeightedEdge> sw = new StoerWagnerMinimumCut<>(g);
+                double swv = sw.minCutWeight();
+                check(swv == global, () -> "StoerWagnerMinimumCut.minCutWeight() = " + swv + ", brute force " + global + ctx);
+                Set<Integer> side = sw.minCut();
+                boolean[] inS = new boolean[Brute.nv(g)];
+                for (int x : side) {
+                    inS[x] = true;
+                }
+                double cap = Brute.cutCapacity(g, inS);
+                check(!side.isEmpty() && side.size() < g.vertexSet().size() && cap == global, () -> "StoerWagnerMinimumCut.minCut() = " + side + " has capacity " + cap + ", minimum " + global + ctx);
+                // edge connectivity of the unweighted graph
+                KConnectivityFlowAlgorithm<Integer, DefaultWeightedEdge> kc = new KConnectivityFlowAlgorithm<>(new org.jgrapht.graph.AsUnweightedGraph<>(g));
+                double unitGlobal = Brute.globalMinCut(new org.jgrapht.graph.AsUnweightedGraph<>(g));
+                int ec = kc.getEdgeConnectivity();
+                check(ec == (int) unitGlobal, () -> "KConnectivityFlowAlgorithm.getEdgeConnectivity() = " + ec + ", brute force " + unitGlobal + ctx);
+                int vc = kc.getVertexConnectivity();
+                int bruteVc = vertexConnectivity(g);
+                check(vc == bruteVc, () -> "KConnectivityFlowAlgorithm.getVertexConnectivity() = " + vc + ", brute force " + bruteVc + ctx);
+                for (int k = 0; k <= 3; k++) {
+                    final int kk = k;
+                    check(kc.isKEdgeConnected(k) == (ec >= k), () -> "isKEdgeConnected(" + kk + ") = " + kc.isKEdgeConnected(kk) + " with edge connectivity " + ec + ctx);
+                    check(kc.isKVertexConnected(k) == (vc >= k), () -> "isKVertexConnected(" + kk + ") = " + kc.isKVertexConnected(kk) + " with vertex connectivity " + vc + ctx);
+                }
+            }
+        }, Zoo.settings("maximumFlowsEqualMinimumCuts"));
+    }
