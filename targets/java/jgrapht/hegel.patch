+    /** Rank over GF(2) of the edge-incidence vectors of the cycles. */
+    static int rank(Set<List<DefaultWeightedEdge>> cycles, Graph<Integer, DefaultWeightedEdge> g) {
+        List<DefaultWeightedEdge> es = new ArrayList<>(g.edgeSet());
+        List<java.util.BitSet> rows = new ArrayList<>();
+        for (List<DefaultWeightedEdge> c : cycles) {
+            java.util.BitSet b = new java.util.BitSet();
+            for (DefaultWeightedEdge e : c) {
+                b.flip(es.indexOf(e));
+            }
+            rows.add(b);
+        }
+        int rank = 0;
+        for (int col = 0; col < es.size() && rank < rows.size(); col++) {
+            int pivot = -1;
+            for (int i = rank; i < rows.size(); i++) {
+                if (rows.get(i).get(col)) {
+                    pivot = i;
+                    break;
+                }
+            }
+            if (pivot < 0) {
+                continue;
+            }
+            java.util.BitSet tmp = rows.get(rank);
+            rows.set(rank, rows.get(pivot));
+            rows.set(pivot, tmp);
+            for (int i = 0; i < rows.size(); i++) {
+                if (i != rank && rows.get(i).get(col)) {
+                    rows.get(i).xor(rows.get(rank));
+                }
+            }
+            rank++;
+        }
+        return rank;
+    }
