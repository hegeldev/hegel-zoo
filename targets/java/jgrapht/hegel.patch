+        List<Integer> vs = p.getVertexList();
+        check(vs.size() == es.size() + 1, () -> who + " path has " + es.size() + " edges but " + vs.size() + " vertices: " + p + ctx);
+        check(p.getLength() == es.size(), () -> who + " path getLength = " + p.getLength() + " for " + es.size() + " edges" + ctx);
+        check(vs.get(0) == s && vs.get(vs.size() - 1) == t, () -> who + " vertex list " + vs + " does not run from " + s + " to " + t + ctx);
+        double w = 0;
+        for (int i = 0; i < es.size(); i++) {
+            DefaultWeightedEdge e = es.get(i);
+            int u = vs.get(i);
+            int v = vs.get(i + 1);
+            check(g.containsEdge(e), () -> who + " path uses an edge that is not in the graph: " + e + ctx);
+            boolean ok = g.getType().isDirected() ? g.getEdgeSource(e) == u && g.getEdgeTarget(e) == v
+                    : (g.getEdgeSource(e) == u && g.getEdgeTarget(e) == v) || (g.getEdgeSource(e) == v && g.getEdgeTarget(e) == u);
+            check(ok, () -> who + " path edge " + e + " does not join " + u + " and " + v + ": " + p + ctx);
+            w += g.getEdgeWeight(e);
+        }
+        if (p instanceof GraphWalk<Integer, DefaultWeightedEdge> walk) {
+            try {
+                walk.verify();
+            } catch (RuntimeException e) {
+                fail(who + " path does not verify (" + e + "): " + p + ctx);
+            }
+        }
+        return w;
+    }
