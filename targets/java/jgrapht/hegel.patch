+            check(Math.abs(m.getWeight() - maxW) < 1e-9, () -> "MaximumWeightBipartiteMatching weighs " + m.getWeight() + ", the maximum is " + maxW + ctx);
+            check(mw.getMatchingWeight().doubleValue() == m.getWeight(), () -> "MaximumWeightBipartiteMatching.getMatchingWeight() = " + mw.getMatchingWeight() + " for a matching of weight " + m.getWeight() + ctx);
+            // the assignment problem on a complete bipartite graph with equal parts
+            if (a == b && a > 0) {
+                Graph<Integer, DefaultWeightedEdge> k = spec.empty();
+                for (int v = 0; v < 2 * a; v++) {
+                    k.addVertex(v);
+                }
+                for (int u = 0; u < a; u++) {
+                    for (int v = a; v < 2 * a; v++) {
+                        DefaultWeightedEdge e = k.addEdge(u, v);
+                        k.setEdgeWeight(e, n(tc, 0, 9));
+                    }
+                }
+                String kctx = " for " + GraphGen.show(k);
+                double want = Brute.minWeightPerfectMatching(k);
+                Matching<Integer, DefaultWeightedEdge> km = new KuhnMunkresMinimalWeightBipartitePerfectMatching<>(k, p1, p2).getMatching();
+                checkMatching(k, km, "KuhnMunkres", kctx);
+                check(km.isPerfect(), () -> "KuhnMunkres matching " + km.getEdges() + " is not perfect" + kctx);
+                check(Math.abs(km.getWeight() - want) < 1e-9, () -> "KuhnMunkres weighs " + km.getWeight() + ", the minimum perfect matching weighs " + want + kctx);
+            }
+        }, Zoo.settings("bipartiteMatchingsMatchTheBitmaskDynamicProgram"));
+    }
