+    static List<Integer> rotate(List<Integer> c) {
+        int min = 0;
+        for (int i = 1; i < c.size(); i++) {
+            if (c.get(i) < c.get(min)) {
+                min = i;
+            }
+        }
+        List<Integer> out = new ArrayList<>();
+        for (int i = 0; i < c.size(); i++) {
+            out.add(c.get((min + i) % c.size()));
+        }
+        return out;
+    }
