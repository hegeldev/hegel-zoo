+    /** A path's weight recomputed from its edges, and the path's shape checked against the graph. */
+    static double checkPath(Graph<Integer, DefaultWeightedEdge> g, GraphPath<Integer, DefaultWeightedEdge> p, int s, int t, String who, String ctx) {
+        check(p.getStartVertex() == s && p.getEndVertex() == t, () -> who + " path from " + s + " to " + t + " has ends " + p.getStartVertex() + ", " + p.getEndVertex() + ctx);
