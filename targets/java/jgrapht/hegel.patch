+            Graph<Integer, DefaultWeightedEdge> tree = GraphGen.tree(tc, nv, directed, false);
+            int root = 0;
+            String ctx = " for " + GraphGen.show(tree) + " rooted at " + root;
+            int a = GraphGen.vertex(tc, tree);
+            int b = GraphGen.vertex(tc, tree);
+            Integer want = Brute.lca(tree, root, a, b);
+            count(a == b ? "same" : want == a || want == b ? "ancestor" : "cousins");
+            for (String who : new String[] {"BinaryLifting", "EulerTourRMQ", "HeavyPath", "Tarjan", "Naive"}) {
+                if (who.equals("Naive") && !directed) {
+                    continue;
+                }
+                Integer got;
+                try {
+                    got = switch (who) {
+                        case "BinaryLifting" -> new BinaryLiftingLCAFinder<>(tree, root).getLCA(a, b);
+                        case "EulerTourRMQ" -> new EulerTourRMQLCAFinder<>(tree, root).getLCA(a, b);
+                        case "HeavyPath" -> new HeavyPathLCAFinder<>(tree, root).getLCA(a, b);
+                        case "Tarjan" -> new TarjanLCAFinder<>(tree, root).getLCA(a, b);
+                        default -> new NaiveLCAFinder<>(tree).getLCA(a, b);
+                    };
+                } catch (RuntimeException e) {
+                    fail(who + "LCAFinder.getLCA(" + a + ", " + b + ") throws " + e + ctx);
+                    continue;
+                }
+                if (!want.equals(got) && who.equals("BinaryLifting") && depth(tree, Set.of(root), a, b) >= (1 << (31 - Integer.numberOfLeadingZeros(nv)))) {
+                    // known jgrapht/9: the jump table has floor(log2 n) levels, too few for a vertex this deep
+                    count("known jgrapht/9");
+                } else {
+                    check(want.equals(got), () -> who + "LCAFinder.getLCA(" + a + ", " + b + ") = " + got + ", the ancestor is " + want + ctx);
+                }
+            }
+            if (directed) {
+                Set<Integer> set = new NaiveLCAFinder<>(tree).getLCASet(a, b);
+                check(set.equals(Set.of(want)), () -> "NaiveLCAFinder.getLCASet(" + a + ", " + b + ") = " + set + ", the ancestor is " + want + ctx);
+                // batch queries
+                List<org.jgrapht.alg.util.Pair<Integer, Integer>> qs = new ArrayList<>();
+                List<Integer> wants = new ArrayList<>();
+                for (int i = 0; i < n(tc, 0, 5); i++) {
+                    int x = GraphGen.vertex(tc, tree);
+                    int y = GraphGen.vertex(tc, tree);
+                    qs.add(org.jgrapht.alg.util.Pair.of(x, y));
+                    wants.add(Brute.lca(tree, root, x, y));
+                }
+                List<Integer> batch = new TarjanLCAFinder<>(tree, root).getBatchLCA(qs);
+                check(batch.equals(wants), () -> "TarjanLCAFinder.getBatchLCA(" + qs + ") = " + batch + ", expected " + wants + ctx);
+                // a forest of two trees: the roots set, pairs across trees have no ancestor
+                if (nv >= 2) {
+                    Graph<Integer, DefaultWeightedEdge> forest = copyOf(tree);
+                    int cutChild = n(tc, 1, nv - 1);
+                    DefaultWeightedEdge in = forest.incomingEdgesOf(cutChild).iterator().next();
+                    forest.removeEdge(in);
+                    Set<Integer> roots = Set.of(root, cutChild);
+                    int x = GraphGen.vertex(tc, forest);
+                    int y = GraphGen.vertex(tc, forest);
+                    Integer w1 = Brute.lca(forest, root, x, y);
+                    Integer w2 = Brute.lca(forest, cutChild, x, y);
+                    Integer fw = w1 != null ? w1 : w2;
+                    for (String who : new String[] {"BinaryLifting", "EulerTourRMQ", "HeavyPath", "Tarjan"}) {
+                        Integer got = switch (who) {
+                            case "BinaryLifting" -> new BinaryLiftingLCAFinder<>(forest, roots).getLCA(x, y);
+                            case "EulerTourRMQ" -> new EulerTourRMQLCAFinder<>(forest, roots).getLCA(x, y);
+                            case "HeavyPath" -> new HeavyPathLCAFinder<>(forest, roots).getLCA(x, y);
+                            default -> new TarjanLCAFinder<>(forest, roots).getLCA(x, y);
+                        };
+                        if (!java.util.Objects.equals(got, fw) && who.equals("BinaryLifting") && depth(forest, roots, x, y) >= (1 << (31 - Integer.numberOfLeadingZeros(nv)))) {
+                            count("known jgrapht/9");
+                        } else {
+                            check(java.util.Objects.equals(got, fw), () -> who + "LCAFinder on the forest " + GraphGen.show(forest) + " roots " + roots + ": getLCA(" + x + ", " + y + ") = " + got + ", expected " + fw);
+                        }
+                    }
+                }
+            }
+        }, Zoo.settings("lowestCommonAncestorsMatchTheTree"));
+    }
