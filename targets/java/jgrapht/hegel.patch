+    /** jgrapht/18: two cycles of equal mean 5/14 with fractional weights: the policy graph is mutated below the tolerance and buildPath loops forever. */
+    @Test
+    void pinHowardTerminatesOnTiedMeans() throws Exception {
+        // in a child JVM with a small heap: the hanging call cannot be interrupted and would exhaust this JVM's heap
+        String javaBin = System.getProperty("java.home") + "/bin/java";
+        Process p = new ProcessBuilder(javaBin, "-Xmx128m", "-cp", System.getProperty("java.class.path"), "zoo.HowardProbe").redirectErrorStream(true).start();
+        String out;
+        try (java.io.InputStream in = p.getInputStream()) {
+            byte[] buf = in.readNBytes(4000);
+            out = new String(buf, java.nio.charset.StandardCharsets.UTF_8);
+        }
+        assertTrue(p.waitFor(60, java.util.concurrent.TimeUnit.SECONDS), "HowardMinimumMeanCycle.getCycle() did not return within 60 s: " + out);
+        assertEquals(0, p.exitValue(), "HowardProbe: " + out);
+        assertTrue(out.contains("MEAN " + (5.0 / 14)), "expected mean 5/14: " + out);
+    }
