+    /** Floyd-Warshall without the negative-cycle veto: the diagonal shows the cycles. */
+    static double[][] rawDistances(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = Brute.nv(g);
+        double[][] d = Brute.direct(g);
+        for (int i = 0; i < n; i++) {
+            d[i][i] = Math.min(0, d[i][i]);
+        }
+        for (int k = 0; k < n; k++) {
+            for (int i = 0; i < n; i++) {
+                for (int j = 0; j < n; j++) {
+                    if (d[i][k] != Brute.INF && d[k][j] != Brute.INF && d[i][k] + d[k][j] < d[i][j]) {
+                        d[i][j] = d[i][k] + d[k][j];
+                    }
+                }
+            }
+        }
+        return d;
+    }
+
+    static void checkManyToMany(Graph<Integer, DefaultWeightedEdge> g, ManyToManyShortestPathsAlgorithm<Integer, DefaultWeightedEdge> alg, double[][] d, Set<Integer> sources, Set<Integer> targets, String who, String ctx) {
+        ManyToManyShortestPaths<Integer, DefaultWeightedEdge> m;
+        try {
+            m = alg.getManyToManyPaths(sources, targets);
+        } catch (RuntimeException e) {
+            fail(who + ".getManyToManyPaths(" + sources + ", " + targets + ") throws " + e + ctx);
+            return;
+        }
+        check(m.getSources().equals(sources) && m.getTargets().equals(targets), () -> who + " reports sources " + m.getSources() + " and targets " + m.getTargets() + " for " + sources + ", " + targets + ctx);
+        for (int s : sources) {
+            for (int t : targets) {
+                double want = d[s][t];
+                double got = m.getWeight(s, t);
+                check(got == want, () -> who + ".getWeight(" + s + ", " + t + ") = " + got + ", shortest is " + want + ctx);
+                GraphPath<Integer, DefaultWeightedEdge> p = m.getPath(s, t);
+                if (want == Brute.INF) {
+                    check(p == null, () -> who + ".getPath(" + s + ", " + t + ") = " + p + " though unreachable" + ctx);
+                } else {
+                    check(p != null, () -> who + ".getPath(" + s + ", " + t + ") = null though the distance is " + want + ctx);
+                    if (p != null) {
+                        double w = checkPath(g, p, s, t, who, ctx);
+                        check(w == want && p.getWeight() == want, () -> who + ".getPath(" + s + ", " + t + ") weighs " + p.getWeight() + " (edges " + w + "), shortest is " + want + ctx);
+                    }
+                }
+            }
+        }
+    }
+
+    /** All simple s-t paths as edge lists, by DFS (the graph is small). */
+    /** Does some cycle lie on an s-t walk (a vertex on a cycle, reachable from s and reaching t)? Then walks are unbounded. */
+    static boolean cycleBetween(Graph<Integer, DefaultWeightedEdge> g, int s, int t) {
+        boolean[][] r = Brute.reach(g);
+        for (int v : g.vertexSet()) {
+            if (!r[s][v] || !r[v][t]) {
+                continue;
+            }
+            for (DefaultWeightedEdge e : g.outgoingEdgesOf(v)) {
+                if (r[g.getEdgeTarget(e)][v]) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    static List<List<DefaultWeightedEdge>> simplePaths(Graph<Integer, DefaultWeightedEdge> g, int s, int t) {
+        List<List<DefaultWeightedEdge>> out = new ArrayList<>();
+        Set<Integer> used = new HashSet<>();
+        used.add(s);
+        simplePaths(g, s, t, used, new ArrayList<>(), out);
+        return out;
+    }
+
+    private static void simplePaths(Graph<Integer, DefaultWeightedEdge> g, int u, int t, Set<Integer> used, List<DefaultWeightedEdge> path, List<List<DefaultWeightedEdge>> out) {
+        if (u == t && !path.isEmpty()) {
+            out.add(new ArrayList<>(path));
+            return;
+        }
+        if (u == t && path.isEmpty()) {
+            // the trivial path from s to s; continue only along edges that come back (a cycle is not simple) -> nothing
+            out.add(new ArrayList<>());
+            return;
+        }
+        for (DefaultWeightedEdge e : g.outgoingEdgesOf(u)) {
+            int v = g.getEdgeSource(e) == u ? g.getEdgeTarget(e) : g.getEdgeSource(e);
+            if (used.contains(v)) {
+                continue;
+            }
+            used.add(v);
+            path.add(e);
+            simplePaths(g, v, t, used, path, out);
+            path.remove(path.size() - 1);
+            used.remove(v);
+        }
+    }
+
+    static double weight(Graph<Integer, DefaultWeightedEdge> g, List<DefaultWeightedEdge> es) {
+        double w = 0;
+        for (DefaultWeightedEdge e : es) {
+            w += g.getEdgeWeight(e);
+        }
+        return w;
+    }
+
+    static boolean isSimple(GraphPath<Integer, DefaultWeightedEdge> p) {
+        return new HashSet<>(p.getVertexList()).size() == p.getVertexList().size();
+    }
+
+    @Test
+    void kShortestPathsMatchTheEnumeration() {
+        Hegel.test(tc -> {
+            boolean directed = chance(tc, 60);
+            GraphGen.Spec spec = directed ? GraphGen.simpleDirected(tc, true) : GraphGen.simpleUndirected(tc, true);
+            spec = new GraphGen.Spec(spec.directed(), false, false, true, spec.minW(), spec.maxW());
+            boolean dag = directed && chance(tc, 40);
+            int nv = n(tc, 1, 7);
+            Graph<Integer, DefaultWeightedEdge> g = dag ? GraphGen.dag(tc, nv, n(tc, 0, 14), spec) : GraphGen.graph(tc, spec, nv, n(tc, 0, 14));
+            String ctx = " for " + GraphGen.show(g);
+            int s = GraphGen.vertex(tc, g);
+            int t = GraphGen.vertex(tc, g);
+            if (s == t) {
+                return;
+            }
+            List<List<DefaultWeightedEdge>> all = simplePaths(g, s, t);
+            List<Double> weights = new ArrayList<>();
+            for (List<DefaultWeightedEdge> p : all) {
+                weights.add(weight(g, p));
+            }
+            Collections.sort(weights);
+            int k = n(tc, 1, 6);
+            List<Double> want = weights.subList(0, Math.min(k, weights.size()));
+            count(all.isEmpty() ? "no-path" : all.size() < k ? "fewer-than-k" : "k-or-more");
+            checkK(g, "Yen", new YenKShortestPath<>(g).getPaths(s, t, k), want, s, t, k, true, ctx);
+            checkK(g, "BoundedPrunedYen", new BoundedPrunedYenKShortestPath<>(g).getPaths(s, t, k), want, s, t, k, true, ctx);
+            if (directed) {
+                List<GraphPath<Integer, DefaultWeightedEdge>> ep = new EppsteinKShortestPath<>(g).getPaths(s, t, k);
+                if (dag || !cycleBetween(g, s, t)) {
+                    // when no cycle lies on any s-t walk, every walk is a simple path
+                    checkK(g, "Eppstein", ep, want, s, t, k, true, ctx);
+                } else {
+                    // walks: sorted, valid, the i-th no heavier than the i-th simple path
+                    List<Double> got = new ArrayList<>();
+                    for (GraphPath<Integer, DefaultWeightedEdge> p : ep) {
+                        double w = checkPath(g, p, s, t, "Eppstein", ctx);
+                        check(w == p.getWeight(), () -> "Eppstein path weighs " + p.getWeight() + " but its edges sum to " + w + ": " + p + ctx);
+                        got.add(w);
+                    }
+                    List<Double> sorted = new ArrayList<>(got);
+                    Collections.sort(sorted);
+                    check(got.equals(sorted), () -> "Eppstein paths are not sorted by weight: " + got + ctx);
+                    check(got.size() == (all.isEmpty() ? 0 : k), () -> "Eppstein returns " + got.size() + " walks for k = " + k + " (" + all.size() + " simple paths exist)" + ctx);
+                    for (int i = 0; i < Math.min(got.size(), want.size()); i++) {
+                        final int idx = i;
+                        check(got.get(i) <= want.get(i), () -> "Eppstein walk " + idx + " weighs " + got.get(idx) + " but the simple path of that rank weighs " + want.get(idx) + ctx);
+                    }
+                }
+                // every simple path, unordered
+                List<GraphPath<Integer, DefaultWeightedEdge>> allPaths = new AllDirectedPaths<>(g).getAllPaths(s, t, true, null);
+                Set<List<DefaultWeightedEdge>> gotSet = new HashSet<>();
+                for (GraphPath<Integer, DefaultWeightedEdge> p : allPaths) {
+                    checkPath(g, p, s, t, "AllDirectedPaths", ctx);
+                    check(isSimple(p), () -> "AllDirectedPaths(simple) returns a non-simple path " + p + ctx);
+                    gotSet.add(p.getEdgeList());
+                }
+                Set<List<DefaultWeightedEdge>> wantSet = new HashSet<>(all);
+                check(gotSet.equals(wantSet) && allPaths.size() == all.size(), () -> "AllDirectedPaths finds " + allPaths.size() + " simple paths, there are " + all.size() + ": " + gotSet + " vs " + wantSet + ctx);
+                // bounded length: exactly the simple paths of at most that many edges
+                int maxLen = n(tc, 0, 4);
+                List<GraphPath<Integer, DefaultWeightedEdge>> bounded = new AllDirectedPaths<>(g).getAllPaths(s, t, true, maxLen);
+                int expectBounded = 0;
+                for (List<DefaultWeightedEdge> p : all) {
+                    if (p.size() <= maxLen) {
+                        expectBounded++;
+                    }
+                }
+                final int eb = expectBounded;
+                check(bounded.size() == eb, () -> "AllDirectedPaths with maxPathLength " + maxLen + " finds " + bounded.size() + " paths, there are " + eb + ctx);
+                for (GraphPath<Integer, DefaultWeightedEdge> p : bounded) {
+                    check(p.getLength() <= maxLen, () -> "AllDirectedPaths with maxPathLength " + maxLen + " returns " + p + ctx);
+                }
+            }
+        }, Zoo.settings("kShortestPathsMatchTheEnumeration"));
+    }
+
+    static void checkK(Graph<Integer, DefaultWeightedEdge> g, String who, List<GraphPath<Integer, DefaultWeightedEdge>> got, List<Double> want, int s, int t, int k, boolean simple, String ctx) {
+        List<Double> ws = new ArrayList<>();
+        Set<List<DefaultWeightedEdge>> seen = new HashSet<>();
+        for (GraphPath<Integer, DefaultWeightedEdge> p : got) {
+            double w = checkPath(g, p, s, t, who, ctx);
+            check(w == p.getWeight(), () -> who + " path weighs " + p.getWeight() + " but its edges sum to " + w + ": " + p + ctx);
+            if (simple) {
+                check(isSimple(p), () -> who + " returns a non-simple path " + p + ctx);
+            }
+            check(seen.add(p.getEdgeList()), () -> who + " returns the same path twice: " + p + ctx);
+            ws.add(w);
+        }
+        check(ws.equals(want), () -> who + ".getPaths(" + s + ", " + t + ", " + k + ") weights " + ws + ", the " + k + " lightest simple paths weigh " + want + ctx);
+    }
+
+    @Test
+    void disjointPathsAreDisjointAndAsManyAsTheCutAllows() {
+        Hegel.test(tc -> {
+            GraphGen.Spec spec = new GraphGen.Spec(true, false, false, true, 1, n(tc, 1, 9));
+            int nv = n(tc, 2, 7);
+            Graph<Integer, DefaultWeightedEdge> g = GraphGen.graph(tc, spec, nv, n(tc, 0, 16));
+            String ctx = " for " + GraphGen.show(g);
+            int s = GraphGen.vertex(tc, g);
+            int t = GraphGen.vertex(tc, g);
+            if (s == t) {
+                return;
+            }
+            // the number of edge-disjoint paths is the minimum cut with unit capacities
+            Graph<Integer, DefaultWeightedEdge> unit = new AsUnweightedGraph<>(g);
+            int maxDisjoint = (int) Brute.minCut(unit, s, t);
+            int k = n(tc, 1, 4);
+            List<List<DefaultWeightedEdge>> all = simplePaths(g, s, t);
+            // the cheapest pair of edge-disjoint simple paths, when k = 2 and the enumeration is small
+            double bestPair = Brute.INF;
+            if (all.size() <= 60) {
+                for (int i = 0; i < all.size(); i++) {
+                    for (int j = i + 1; j < all.size(); j++) {
+                        if (Collections.disjoint(all.get(i), all.get(j))) {
+                            bestPair = Math.min(bestPair, weight(g, all.get(i)) + weight(g, all.get(j)));
+                        }
+                    }
+                }
+            }
+            count("disjoint-" + Math.min(maxDisjoint, k));
+            for (String who : new String[] {"Suurballe", "Bhandari"}) {
+                List<GraphPath<Integer, DefaultWeightedEdge>> paths;
+                try {
+                    paths = who.equals("Suurballe") ? new SuurballeKDisjointShortestPaths<>(g).getPaths(s, t, k) : new BhandariKDisjointShortestPaths<>(g).getPaths(s, t, k);
+                } catch (RuntimeException e) {
+                    fail(who + ".getPaths(" + s + ", " + t + ", " + k + ") throws " + e + ctx);
+                    continue;
+                }
+                int expect = Math.min(k, maxDisjoint);
+                check(paths.size() == expect, () -> who + ".getPaths(" + s + ", " + t + ", " + k + ") returns " + paths.size() + " paths; " + maxDisjoint + " edge-disjoint paths exist" + ctx);
+                Set<DefaultWeightedEdge> used = new HashSet<>();
+                double total = 0;
+                for (GraphPath<Integer, DefaultWeightedEdge> p : paths) {
+                    double w = checkPath(g, p, s, t, who, ctx);
+                    check(w == p.getWeight(), () -> who + " path weighs " + p.getWeight() + " but its edges sum to " + w + ": " + p + ctx);
+                    check(isSimple(p), () -> who + " returns a non-simple path " + p + ctx);
+                    for (DefaultWeightedEdge e : p.getEdgeList()) {
+                        check(used.add(e), () -> who + " paths share the edge " + e + ": " + paths + ctx);
+                    }
+                    total += w;
+                }
+                if (paths.size() >= 1 && !all.isEmpty()) {
+                    double shortest = Brute.INF;
+                    for (List<DefaultWeightedEdge> p : all) {
+                        shortest = Math.min(shortest, weight(g, p));
+                    }
+                    final double sh = shortest;
+                    if (paths.size() == 1) {
+                        check(paths.get(0).getWeight() == sh, () -> who + " single path weighs " + paths.get(0).getWeight() + ", the shortest path weighs " + sh + ctx);
+                    }
+                }
+                if (k == 2 && paths.size() == 2 && bestPair != Brute.INF) {
+                    final double tt = total;
+                    final double bp = bestPair;
+                    check(tt == bp, () -> who + " two disjoint paths weigh " + tt + " in total, the cheapest disjoint pair weighs " + bp + ": " + paths + ctx);
+                }
+            }
+        }, Zoo.settings("disjointPathsAreDisjointAndAsManyAsTheCutAllows"));
+    }
