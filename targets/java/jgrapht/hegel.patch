+import org.jgrapht.graph.DefaultWeightedEdge;
+import org.jgrapht.graph.builder.GraphTypeBuilder;
+import org.jgrapht.util.SupplierUtil;
+
+/**
+ * Small random graphs for the properties: Integer vertices 0..n-1, {@link DefaultWeightedEdge} edges (so every
+ * graph can be read as weighted or not), directed or undirected, simple or with parallel edges and self loops,
+ * with integral weights (exact in doubles) drawn from a few ranges. Every graph is described by a {@link Spec}
+ * so that a failing case prints as something that can be typed back into jshell.
+ */
+final class GraphGen {
+    private GraphGen() {}
+
+    /** The flavour of a graph: its type flags plus the weight range. */
+    record Spec(boolean directed, boolean multi, boolean loops, boolean weighted, int minW, int maxW) {
+        Graph<Integer, DefaultWeightedEdge> empty() {
+            GraphTypeBuilder<Integer, DefaultWeightedEdge> b = directed ? GraphTypeBuilder.directed() : GraphTypeBuilder.undirected();
+            // the vertex supplier yields fresh vertices (Johnson's algorithm adds one); vertices start far above ours
+            return b.allowingMultipleEdges(multi).allowingSelfLoops(loops).weighted(weighted)
+                    .edgeClass(DefaultWeightedEdge.class).vertexSupplier(SupplierUtil.createIntegerSupplier(1000)).buildGraph();
+        }
+    }
+
+    static Spec spec(TestCase tc, boolean directed, boolean weighted) {
+        boolean multi = chance(tc, 25);
+        boolean loops = chance(tc, 20);
+        int lo;
+        int hi;
+        switch (n(tc, 0, 3)) {
+            case 0 -> { lo = 1; hi = 1; }
+            case 1 -> { lo = 1; hi = 5; }
+            case 2 -> { lo = 0; hi = 9; }
+            default -> { lo = 1; hi = 1000; }
+        }
+        return new Spec(directed, multi, loops, weighted, lo, hi);
+    }
+
+    /** A simple undirected graph spec (the shape most algorithms want), weighted or not. */
+    static Spec simpleUndirected(TestCase tc, boolean weighted) {
+        Spec s = spec(tc, false, weighted);
+        return new Spec(false, false, false, weighted, s.minW, s.maxW);
+    }
+
+    static Spec simpleDirected(TestCase tc, boolean weighted) {
+        Spec s = spec(tc, true, weighted);
+        return new Spec(true, false, false, weighted, s.minW, s.maxW);
+    }
+
+    /** A random graph on n vertices with about m edges (fewer when the spec forbids duplicates). */
+    static Graph<Integer, DefaultWeightedEdge> graph(TestCase tc, Spec spec, int nv, int m) {
+        Graph<Integer, DefaultWeightedEdge> g = spec.empty();
+        for (int i = 0; i < nv; i++) {
+            g.addVertex(i);
+        }
+        if (nv == 0) {
+            return g;
+        }
+        for (int i = 0; i < m; i++) {
+            int u = n(tc, 0, nv - 1);
+            int v = n(tc, 0, nv - 1);
+            if (u == v && !spec.loops) {
+                continue;
+            }
+            if (!spec.multi && g.containsEdge(u, v)) {
+                continue;
+            }
+            DefaultWeightedEdge e = g.addEdge(u, v);
+            if (e != null && spec.weighted) {
+                g.setEdgeWeight(e, weight(tc, spec));
+            }
+        }
+        return g;
+    }
+
+    static double weight(TestCase tc, Spec spec) {
+        return n(tc, spec.minW, spec.maxW);
+    }
+
+    /** A random graph with a size drawn from the usual range: up to 9 vertices and 16 edges, sometimes tiny. */
+    static Graph<Integer, DefaultWeightedEdge> graph(TestCase tc, Spec spec) {
+        int nv = chance(tc, 15) ? n(tc, 0, 2) : n(tc, 1, 9);
+        int m = nv == 0 ? 0 : n(tc, 0, Math.min(16, spec.multi ? 16 : nv * (nv - 1) / (spec.directed ? 1 : 2) + (spec.loops ? nv : 0)));
+        return graph(tc, spec, nv, m);
+    }
+
+    /** A connected undirected graph: a random spanning tree first, then extra edges. */
+    static Graph<Integer, DefaultWeightedEdge> connected(TestCase tc, Spec spec, int nv, int extra) {
+        Graph<Integer, DefaultWeightedEdge> g = spec.empty();
+        for (int i = 0; i < nv; i++) {
+            g.addVertex(i);
+            if (i > 0) {
+                int p = n(tc, 0, i - 1);
+                DefaultWeightedEdge e = spec.directed && chance(tc, 50) ? g.addEdge(i, p) : g.addEdge(p, i);
+                if (spec.weighted) {
+                    g.setEdgeWeight(e, weight(tc, spec));
+                }
+            }
+        }
+        for (int i = 0; i < extra && nv > 0; i++) {
+            int u = n(tc, 0, nv - 1);
+            int v = n(tc, 0, nv - 1);
+            if ((u == v && !spec.loops) || (!spec.multi && g.containsEdge(u, v))) {
+                continue;
+            }
+            DefaultWeightedEdge e = g.addEdge(u, v);
+            if (e != null && spec.weighted) {
+                g.setEdgeWeight(e, weight(tc, spec));
+            }
+        }
+        return g;
+    }
+
+    /** A complete graph with weights (a metric one when metric is set: points on a grid, Manhattan distances). */
+    static Graph<Integer, DefaultWeightedEdge> complete(TestCase tc, int nv, boolean metric, Spec spec) {
+        Graph<Integer, DefaultWeightedEdge> g = spec.empty();
+        int[] xs = new int[nv];
+        int[] ys = new int[nv];
+        for (int i = 0; i < nv; i++) {
+            g.addVertex(i);
+            xs[i] = n(tc, 0, 20);
+            ys[i] = n(tc, 0, 20);
+        }
+        for (int i = 0; i < nv; i++) {
+            for (int j = spec.directed ? 0 : i + 1; j < nv; j++) {
+                if (i == j) {
+                    continue;
+                }
+                DefaultWeightedEdge e = g.addEdge(i, j);
+                double w = metric ? Math.abs(xs[i] - xs[j]) + Math.abs(ys[i] - ys[j]) : weight(tc, spec);
+                g.setEdgeWeight(e, w);
+            }
+        }
+        return g;
+    }
+
+    /** A random tree (undirected, or directed away from the root 0 when directed). */
+    static Graph<Integer, DefaultWeightedEdge> tree(TestCase tc, int nv, boolean directed, boolean weighted) {
+        Spec spec = new Spec(directed, false, false, weighted, 1, 9);
+        Graph<Integer, DefaultWeightedEdge> g = spec.empty();
+        for (int i = 0; i < nv; i++) {
+            g.addVertex(i);
+            if (i > 0) {
+                DefaultWeightedEdge e = g.addEdge(n(tc, 0, i - 1), i);
+                if (weighted) {
+                    g.setEdgeWeight(e, weight(tc, spec));
+                }
+            }
+        }
+        return g;
+    }
+
+    /** A random bipartite graph with parts 0..a-1 and a..a+b-1. */
+    static Graph<Integer, DefaultWeightedEdge> bipartite(TestCase tc, int a, int b, int m, boolean weighted, Spec spec) {
+        Graph<Integer, DefaultWeightedEdge> g = spec.empty();
+        for (int i = 0; i < a + b; i++) {
+            g.addVertex(i);
+        }
+        for (int i = 0; i < m && a > 0 && b > 0; i++) {
+            int u = n(tc, 0, a - 1);
+            int v = a + n(tc, 0, b - 1);
+            if (!spec.multi && g.containsEdge(u, v)) {
+                continue;
+            }
+            DefaultWeightedEdge e = g.addEdge(u, v);
+            if (e != null && weighted) {
+                g.setEdgeWeight(e, weight(tc, spec));
+            }
+        }
+        return g;
+    }
+
+    /** A directed acyclic graph: edges go from a smaller to a larger vertex under a random permutation. */
+    static Graph<Integer, DefaultWeightedEdge> dag(TestCase tc, int nv, int m, Spec spec) {
+        Graph<Integer, DefaultWeightedEdge> g = spec.empty();
+        List<Integer> order = new ArrayList<>();
+        for (int i = 0; i < nv; i++) {
+            g.addVertex(i);
+            order.add(n(tc, 0, order.size()), i);
+        }
+        for (int i = 0; i < m && nv > 1; i++) {
+            int a = n(tc, 0, nv - 2);
+            int b = n(tc, a + 1, nv - 1);
+            int u = order.get(a);
+            int v = order.get(b);
+            if (!spec.multi && g.containsEdge(u, v)) {
+                continue;
+            }
+            DefaultWeightedEdge e = g.addEdge(u, v);
+            if (e != null && spec.weighted) {
+                g.setEdgeWeight(e, weight(tc, spec));
+            }
+        }
+        return g;
+    }
+
+    static int vertex(TestCase tc, Graph<Integer, ?> g) {
+        return pick(tc, g.vertexSet().toArray(new Integer[0]));
+    }
+
+    /** A jshell-typable description of the graph. */
+    static String show(Graph<Integer, DefaultWeightedEdge> g) {
+        StringBuilder sb = new StringBuilder();
+        sb.append(g.getType().isDirected() ? "directed" : "undirected");
+        if (g.getType().isAllowingMultipleEdges()) {
+            sb.append(" multi");
+        }
+        if (g.getType().isAllowingSelfLoops()) {
+            sb.append(" loops");
+        }
+        sb.append(g.getType().isWeighted() ? " weighted" : " unweighted");
+        sb.append(" V=").append(g.vertexSet()).append(" E=[");
+        boolean first = true;
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            if (!first) {
+                sb.append(", ");
+            }
+            first = false;
+            sb.append(g.getEdgeSource(e)).append(g.getType().isDirected() ? "->" : "-").append(g.getEdgeTarget(e));
+            if (g.getType().isWeighted()) {
+                double w = g.getEdgeWeight(e);
+                sb.append(':').append(w == Math.rint(w) ? String.valueOf((long) w) : String.valueOf(w));
+            }
+        }
+        return sb.append(']').toString();
+    }
+}
