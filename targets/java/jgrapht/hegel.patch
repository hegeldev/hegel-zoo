+    @Test
+    void spanningTreesMatchKruskalOnTheEdgeList() {
+        Hegel.test(tc -> {
+            GraphGen.Spec spec = GraphGen.spec(tc, false, true);
+            if (chance(tc, 25)) {
+                spec = new GraphGen.Spec(false, spec.multi(), spec.loops(), true, -5, 9);
+            }
+            Graph<Integer, DefaultWeightedEdge> g = GraphGen.graph(tc, spec);
+            String ctx = " for " + GraphGen.show(g);
+            double want = Brute.spanningForestWeight(g);
+            int components = Brute.components(g).size();
+            count(components <= 1 ? "connected" : "forest");
+            for (String who : new String[] {"Kruskal", "Prim", "Boruvka"}) {
+                SpanningTree<DefaultWeightedEdge> t;
+                try {
+                    t = switch (who) {
+                        case "Kruskal" -> new KruskalMinimumSpanningTree<>(g).getSpanningTree();
+                        case "Prim" -> new PrimMinimumSpanningTree<>(g).getSpanningTree();
+                        default -> new BoruvkaMinimumSpanningTree<>(g).getSpanningTree();
+                    };
+                } catch (RuntimeException e) {
+                    fail(who + " throws " + e + ctx);
+                    continue;
+                }
+                check(Brute.isSpanningForest(g, t.getEdges()), () -> who + " returns " + t.getEdges() + ", not a spanning forest" + ctx);
+                double w = Brute.weight(g, t.getEdges());
+                check(t.getWeight() == w, () -> who + ".getWeight() = " + t.getWeight() + " but the edges weigh " + w + ctx);
+                check(w == want, () -> who + " forest weighs " + w + ", the minimum is " + want + ctx);
+            }
+            // spanner: a subgraph whose distances are within the stretch, on non-negative simple graphs
+            if (spec.minW() >= 0 && !spec.multi() && !spec.loops() && !g.vertexSet().isEmpty()) {
+                int k = n(tc, 1, 3);
+                Set<DefaultWeightedEdge> spanner;
+                try {
+                    spanner = new GreedyMultiplicativeSpanner<>(g, k).getSpanner();
+                } catch (IndexOutOfBoundsException e) {
+                    if (!g.edgeSet().isEmpty()) {
+                        throw e;
+                    }
+                    // known jgrapht/21: getSpanner() reads the first edge of an edgeless graph
+                    count("known jgrapht/21");
+                    spanner = Set.of();
+                }
+                Graph<Integer, DefaultWeightedEdge> sub = new org.jgrapht.graph.AsSubgraph<>(g, g.vertexSet(), spanner);
+                double[][] d = Brute.distances(g);
+                double[][] ds = Brute.distances(sub);
+                for (int u : g.vertexSet()) {
+                    for (int v : g.vertexSet()) {
+                        final int uu = u;
+                        final int vv = v;
+                        if (d[u][v] == Brute.INF) {
+                            check(ds[u][v] == Brute.INF, () -> "spanner connects " + uu + " and " + vv + " which the graph does not" + ctx);
+                        } else {
+                            check(ds[u][v] <= (2 * k - 1) * d[u][v] + 1e-9, () -> "GreedyMultiplicativeSpanner(k=" + k + ") distance " + uu + "-" + vv + " is " + ds[uu][vv] + ", graph " + d[uu][vv] + ", stretch " + (2 * k - 1) + ctx);
+                        }
+                    }
+                }
+            }
+            // Steiner tree on a connected graph with positive weights: 2-approximation, contains the terminals
+            if (spec.minW() >= 1 && Brute.connected(g) && g.vertexSet().size() >= 2) {
+                Set<Integer> terminals = new HashSet<>();
+                for (int v : g.vertexSet()) {
+                    if (chance(tc, 50)) {
+                        terminals.add(v);
+                    }
+                }
+                if (terminals.isEmpty()) {
+                    terminals.add(GraphGen.vertex(tc, g));
+                }
+                var st = new KouMarkowskyBermanAlgorithm<>(g).getSteinerTree(terminals);
+                Set<DefaultWeightedEdge> es = st.getEdges();
+                // the returned edges are fresh objects, not the graph's (known jgrapht/49): rebuild the tree by endpoints
+                boolean foreign = false;
+                Graph<Integer, DefaultWeightedEdge> tree = new GraphGen.Spec(false, true, true, true, 0, 0).empty();
+                for (int v : g.vertexSet()) {
+                    tree.addVertex(v);
+                }
+                for (DefaultWeightedEdge e : es) {
+                    if (!g.containsEdge(e)) {
+                        foreign = true;
+                    }
+                    int a = g.getEdgeSource(e);
+                    int b = g.getEdgeTarget(e);
+                    check(g.containsVertex(a) && g.containsVertex(b) && g.containsEdge(a, b), () -> "Steiner tree edge " + e + " joins vertices the graph does not join" + ctx);
+                    tree.setEdgeWeight(tree.addEdge(a, b), g.getEdgeWeight(e));
+                }
+                if (foreign) {
+                    count("known jgrapht/49");
+                }
+                boolean[][] r = Brute.reach(tree);
+                for (int u : terminals) {
+                    for (int v : terminals) {
+                        final int uu = u;
+                        final int vv = v;
+                        check(r[u][v], () -> "Steiner tree " + es + " does not connect terminals " + uu + " and " + vv + ctx);
+                    }
+                }
+                double w = Brute.weight(g, es);
+                check(st.getWeight() == w, () -> "SteinerTree.getWeight() = " + st.getWeight() + " but the edges weigh " + w + ctx);
+                double opt = steinerOptimum(g, terminals);
+                if (w > 2 * opt + 1e-9 && spec.multi()) {
+                    // known jgrapht/50: the paths are rebuilt with an arbitrary parallel edge
+                    count("known jgrapht/50");
+                } else {
+                    check(w <= 2 * opt + 1e-9, () -> "KouMarkowskyBerman Steiner tree weighs " + w + ", the optimum is " + opt + " (more than twice)" + ctx);
+                }
+                check(w >= opt - 1e-9, () -> "KouMarkowskyBerman Steiner tree weighs " + w + ", below the optimum " + opt + ctx);
+                // a tree: no cycles among its edges
+                check(Brute.isSpanningForest(tree, tree.edgeSet()), () -> "Steiner tree edges " + es + " contain a cycle" + ctx);
+            }
+        }, Zoo.settings("spanningTreesMatchKruskalOnTheEdgeList"));
+    }
+
+    static Set<Integer> verticesOf(Graph<Integer, DefaultWeightedEdge> g, Set<DefaultWeightedEdge> es, Set<Integer> also) {
+        Set<Integer> vs = new HashSet<>(also);
+        for (DefaultWeightedEdge e : es) {
+            vs.add(g.getEdgeSource(e));
+            vs.add(g.getEdgeTarget(e));
+        }
+        return vs;
+    }
+
+    /** The optimal Steiner tree weight: the minimum spanning tree weight over every vertex superset of the terminals. */
+    static double steinerOptimum(Graph<Integer, DefaultWeightedEdge> g, Set<Integer> terminals) {
+        List<Integer> others = new ArrayList<>();
+        for (int v : g.vertexSet()) {
+            if (!terminals.contains(v)) {
+                others.add(v);
+            }
+        }
+        double best = Brute.INF;
+        for (int mask = 0; mask < (1 << others.size()); mask++) {
+            Set<Integer> keep = new HashSet<>(terminals);
+            for (int i = 0; i < others.size(); i++) {
+                if ((mask >> i & 1) != 0) {
+                    keep.add(others.get(i));
+                }
+            }
+            Graph<Integer, DefaultWeightedEdge> sub = new org.jgrapht.graph.AsSubgraph<>(g, keep);
+            if (Brute.components(sub).size() == 1) {
+                best = Math.min(best, Brute.spanningForestWeight(sub));
+            }
+        }
+        return best;
+    }
+}
