+    static void checkShortest(Graph<Integer, DefaultWeightedEdge> g, ShortestPathAlgorithm<Integer, DefaultWeightedEdge> alg, double[][] d, int s, int t, String who, String ctx) {
+        GraphPath<Integer, DefaultWeightedEdge> p;
+        try {
+            p = alg.getPath(s, t);
+        } catch (RuntimeException e) {
+            fail(who + ".getPath(" + s + ", " + t + ") throws " + e + ctx);
+            return;
+        }
+        double want = d[s][t];
+        if (want == Brute.INF) {
+            check(p == null, () -> who + ".getPath(" + s + ", " + t + ") = " + p + " though " + t + " is unreachable" + ctx);
+        } else {
+            check(p != null, () -> who + ".getPath(" + s + ", " + t + ") = null though the distance is " + want + ctx);
+            if (p != null) {
+                double w = checkPath(g, p, s, t, who, ctx);
+                check(p.getWeight() == want, () -> who + ".getPath(" + s + ", " + t + ").getWeight() = " + p.getWeight() + ", shortest is " + want + ctx);
+                check(w == p.getWeight(), () -> who + ".getPath(" + s + ", " + t + ") edges sum to " + w + " but getWeight() = " + p.getWeight() + ctx);
+            }
+        }
+        double pw = alg.getPathWeight(s, t);
+        check(pw == want, () -> who + ".getPathWeight(" + s + ", " + t + ") = " + pw + ", shortest is " + want + ctx);
+    }
