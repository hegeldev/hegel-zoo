+    @Test
+    void bipartiteMatchingsMatchTheBitmaskDynamicProgram() {
+        Hegel.test(tc -> {
+            int a = n(tc, 0, 5);
+            int b = n(tc, 0, 5);
+            GraphGen.Spec spec = GraphGen.simpleUndirected(tc, true);
+            Graph<Integer, DefaultWeightedEdge> g = GraphGen.bipartite(tc, a, b, n(tc, 0, 14), true, spec);
+            String ctx = " for " + GraphGen.show(g) + " with parts 0.." + (a - 1) + " and " + a + ".." + (a + b - 1);
+            Set<Integer> p1 = new HashSet<>();
+            Set<Integer> p2 = new HashSet<>();
+            for (int v = 0; v < a; v++) {
+                p1.add(v);
+            }
+            for (int v = a; v < a + b; v++) {
+                p2.add(v);
+            }
+            int card = Brute.maxMatching(g);
+            double maxW = Brute.maxWeightMatching(g);
+            count("card-" + card);
+            Matching<Integer, DefaultWeightedEdge> hk = new HopcroftKarpMaximumCardinalityBipartiteMatching<>(g, p1, p2).getMatching();
+            checkMatching(g, hk, "HopcroftKarp", ctx);
+            check(hk.getEdges().size() == card, () -> "HopcroftKarp matching has " + hk.getEdges().size() + " edges, maximum is " + card + ctx);
+            MaximumWeightBipartiteMatching<Integer, DefaultWeightedEdge> mw = new MaximumWeightBipartiteMatching<>(g, p1, p2);
