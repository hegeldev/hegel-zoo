+package zoo;
+
+import org.jgrapht.GraphPath;
+import org.jgrapht.alg.cycle.HowardMinimumMeanCycle;
+import org.jgrapht.graph.DefaultWeightedEdge;
+import org.jgrapht.graph.SimpleDirectedWeightedGraph;
+
+/**
+ * Runs Howard's minimum mean cycle on the tied-means instance of jgrapht/18 in a separate JVM: while the bug
+ * exists the call never returns and its path list grows until the heap is exhausted, which would take the test
+ * JVM down with it (a timeout cannot stop the thread). The pin starts this with a small heap and a deadline.
+ */
+public final class HowardProbe {
+    private HowardProbe() {}
+
+    public static void main(String[] args) {
+        SimpleDirectedWeightedGraph<Integer, DefaultWeightedEdge> g = new SimpleDirectedWeightedGraph<>(DefaultWeightedEdge.class);
+        for (int i = 0; i < 3; i++) {
+            g.addVertex(i);
+        }
+        g.setEdgeWeight(g.addEdge(2, 0), 9.0 / 7);
+        g.setEdgeWeight(g.addEdge(2, 1), -9.0 / 7);
+        g.setEdgeWeight(g.addEdge(0, 1), 11.0 / 7);
+        g.setEdgeWeight(g.addEdge(1, 0), -6.0 / 7);
+        g.setEdgeWeight(g.addEdge(1, 2), 2.0);
+        GraphPath<Integer, DefaultWeightedEdge> cycle = new HowardMinimumMeanCycle<>(g).getCycle();
+        System.out.println("MEAN " + (cycle.getWeight() / cycle.getLength()) + " " + cycle);
+    }
+}
