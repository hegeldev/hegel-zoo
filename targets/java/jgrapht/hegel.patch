+    /** The larger depth of a and b below their roots (hops). */
+    static int depth(Graph<Integer, DefaultWeightedEdge> forest, Set<Integer> roots, int a, int b) {
+        double[][] d = Brute.distances(new org.jgrapht.graph.AsUnweightedGraph<>(forest));
+        int deep = 0;
+        for (int r : roots) {
+            for (int v : new int[] {a, b}) {
+                if (d[r][v] != Brute.INF) {
+                    deep = Math.max(deep, (int) d[r][v]);
+                }
+            }
+        }
+        return deep;
+    }
