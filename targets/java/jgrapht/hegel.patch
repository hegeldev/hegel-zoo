+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel zoo: property-based tests for JGraphT against jgrapht-core built from this checkout
+     (`mvn -pl jgrapht-core -am install -DskipTests -Dformatter.skip` at the root first; see
+     targets/java/jgrapht in the zoo). Brute-force graph algorithms on small random graphs are the oracles. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>jgrapht-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <jgrapht.version>1.6.0-SNAPSHOT</jgrapht.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.jgrapht</groupId>
+      <artifactId>jgrapht-core</artifactId>
+      <version>${jgrapht.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>-XX:-OmitStackTraceInFastThrow -Xmx1g -Xss4m --enable-native-access=ALL-UNNAMED</argLine>
+          <trimStackTrace>false</trimStackTrace>
+          <!-- every test's `ZOO ...` line is what the zoo judges; Maven's exit code is not -->
+          <testFailureIgnore>true</testFailureIgnore>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Brute.java b/hegel/src/test/java/zoo/Brute.java
new file mode 100644
index 0000000000..7a21ded992
--- /dev/null
+++ b/hegel/src/test/java/zoo/Brute.java
@@ -0,0 +1,986 @@
+package zoo;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.BitSet;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.jgrapht.Graph;
+import org.jgrapht.graph.DefaultWeightedEdge;
+
+/**
+ * Brute-force oracles on small graphs with Integer vertices 0..n-1. Everything here is written from the
+ * definitions (Floyd-Warshall over the edge list, subset enumeration, bitmask DP) and never uses JGraphT's
+ * algorithms; weights are the graph's edge weights (1 for an unweighted graph), all integral in the generator,
+ * so sums are exact.
+ */
+final class Brute {
+    private Brute() {}
+
+    static final double INF = Double.POSITIVE_INFINITY;
+
+    static int nv(Graph<Integer, ?> g) {
+        int max = -1;
+        for (int v : g.vertexSet()) {
+            max = Math.max(max, v);
+        }
+        return max + 1;
+    }
+
+    /** Cheapest direct edge between u and v (respecting direction), INF if none; self loops count for u == v. */
+    static double[][] direct(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        double[][] w = new double[n][n];
+        for (double[] row : w) {
+            Arrays.fill(row, INF);
+        }
+        boolean dir = g.getType().isDirected();
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            int u = g.getEdgeSource(e);
+            int v = g.getEdgeTarget(e);
+            double x = g.getEdgeWeight(e);
+            w[u][v] = Math.min(w[u][v], x);
+            if (!dir) {
+                w[v][u] = Math.min(w[v][u], x);
+            }
+        }
+        return w;
+    }
+
+    /**
+     * All-pairs shortest path distances by Floyd-Warshall (dist[v][v] = 0). Returns null when a negative cycle is
+     * reachable somewhere (an undirected negative edge is such a cycle).
+     */
+    static double[][] distances(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        double[][] d = direct(g);
+        for (int i = 0; i < n; i++) {
+            d[i][i] = Math.min(0, d[i][i]);
+        }
+        for (int k = 0; k < n; k++) {
+            for (int i = 0; i < n; i++) {
+                if (d[i][k] == INF) {
+                    continue;
+                }
+                for (int j = 0; j < n; j++) {
+                    if (d[k][j] != INF && d[i][k] + d[k][j] < d[i][j]) {
+                        d[i][j] = d[i][k] + d[k][j];
+                    }
+                }
+            }
+        }
+        for (int i = 0; i < n; i++) {
+            if (d[i][i] < 0) {
+                return null;
+            }
+        }
+        return d;
+    }
+
+    static boolean hasNegativeEdge(Graph<Integer, DefaultWeightedEdge> g) {
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            if (g.getEdgeWeight(e) < 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Reachability (reach[v][v] is true). */
+    static boolean[][] reach(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        boolean[][] r = new boolean[n][n];
+        boolean dir = g.getType().isDirected();
+        for (int i = 0; i < n; i++) {
+            if (g.containsVertex(i)) {
+                r[i][i] = true;
+            }
+        }
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            r[g.getEdgeSource(e)][g.getEdgeTarget(e)] = true;
+            if (!dir) {
+                r[g.getEdgeTarget(e)][g.getEdgeSource(e)] = true;
+            }
+        }
+        for (int k = 0; k < n; k++) {
+            for (int i = 0; i < n; i++) {
+                if (r[i][k]) {
+                    for (int j = 0; j < n; j++) {
+                        if (r[k][j]) {
+                            r[i][j] = true;
+                        }
+                    }
+                }
+            }
+        }
+        return r;
+    }
+
+    /** Weakly connected components as sets of vertices (direction ignored). */
+    static List<Set<Integer>> components(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        int[] comp = new int[n];
+        Arrays.fill(comp, -1);
+        List<Set<Integer>> out = new ArrayList<>();
+        for (int s : g.vertexSet()) {
+            if (comp[s] >= 0) {
+                continue;
+            }
+            Set<Integer> c = new HashSet<>();
+            ArrayDeque<Integer> q = new ArrayDeque<>();
+            q.add(s);
+            comp[s] = out.size();
+            while (!q.isEmpty()) {
+                int u = q.poll();
+                c.add(u);
+                for (DefaultWeightedEdge e : g.edgesOf(u)) {
+                    int v = g.getEdgeSource(e) == u ? g.getEdgeTarget(e) : g.getEdgeSource(e);
+                    if (comp[v] < 0) {
+                        comp[v] = out.size();
+                        q.add(v);
+                    }
+                }
+            }
+            out.add(c);
+        }
+        return out;
+    }
+
+    /** Strongly connected components (mutual reachability). */
+    static List<Set<Integer>> strongComponents(Graph<Integer, DefaultWeightedEdge> g) {
+        boolean[][] r = reach(g);
+        List<Set<Integer>> out = new ArrayList<>();
+        Set<Integer> done = new HashSet<>();
+        for (int u : g.vertexSet()) {
+            if (done.contains(u)) {
+                continue;
+            }
+            Set<Integer> c = new HashSet<>();
+            for (int v : g.vertexSet()) {
+                if (r[u][v] && r[v][u]) {
+                    c.add(v);
+                }
+            }
+            done.addAll(c);
+            out.add(c);
+        }
+        return out;
+    }
+
+    static boolean connected(Graph<Integer, DefaultWeightedEdge> g) {
+        return g.vertexSet().isEmpty() || components(g).size() == 1;
+    }
+
+    /** Set-of-sets equality helper. */
+    static boolean samePartition(List<Set<Integer>> a, Iterable<Set<Integer>> b) {
+        Set<Set<Integer>> x = new HashSet<>(a);
+        Set<Set<Integer>> y = new HashSet<>();
+        for (Set<Integer> s : b) {
+            y.add(new HashSet<>(s));
+        }
+        return x.equals(y);
+    }
+
+    /** Weight of a minimum spanning forest by Kruskal on the sorted edge list (union-find). */
+    static double spanningForestWeight(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        int[] parent = new int[n];
+        for (int i = 0; i < n; i++) {
+            parent[i] = i;
+        }
+        List<DefaultWeightedEdge> es = new ArrayList<>(g.edgeSet());
+        es.sort((a, b) -> Double.compare(g.getEdgeWeight(a), g.getEdgeWeight(b)));
+        double total = 0;
+        for (DefaultWeightedEdge e : es) {
+            int a = find(parent, g.getEdgeSource(e));
+            int b = find(parent, g.getEdgeTarget(e));
+            if (a != b) {
+                parent[a] = b;
+                total += g.getEdgeWeight(e);
+            }
+        }
+        return total;
+    }
+
+    static int find(int[] p, int x) {
+        while (p[x] != x) {
+            p[x] = p[p[x]];
+            x = p[x];
+        }
+        return x;
+    }
+
+    /** Is the edge set a spanning forest of g with as many trees as g has components? */
+    static boolean isSpanningForest(Graph<Integer, DefaultWeightedEdge> g, Set<DefaultWeightedEdge> edges) {
+        int n = nv(g);
+        int[] parent = new int[n];
+        for (int i = 0; i < n; i++) {
+            parent[i] = i;
+        }
+        for (DefaultWeightedEdge e : edges) {
+            if (!g.containsEdge(e)) {
+                return false;
+            }
+            int a = find(parent, g.getEdgeSource(e));
+            int b = find(parent, g.getEdgeTarget(e));
+            if (a == b) {
+                return false; // a cycle (or a self loop)
+            }
+            parent[a] = b;
+        }
+        return edges.size() == g.vertexSet().size() - components(g).size();
+    }
+
+    /** Capacity of the cut (S, V \ S): edges leaving S (both directions for an undirected graph). */
+    static double cutCapacity(Graph<Integer, DefaultWeightedEdge> g, boolean[] inS) {
+        double c = 0;
+        boolean dir = g.getType().isDirected();
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            int u = g.getEdgeSource(e);
+            int v = g.getEdgeTarget(e);
+            if (inS[u] && !inS[v]) {
+                c += g.getEdgeWeight(e);
+            } else if (!dir && inS[v] && !inS[u]) {
+                c += g.getEdgeWeight(e);
+            }
+        }
+        return c;
+    }
+
+    /** Minimum s-t cut capacity by enumerating every vertex subset containing s and not t (n <= 16). */
+    static double minCut(Graph<Integer, DefaultWeightedEdge> g, int s, int t) {
+        int n = nv(g);
+        List<Integer> others = new ArrayList<>();
+        for (int v : g.vertexSet()) {
+            if (v != s && v != t) {
+                others.add(v);
+            }
+        }
+        double best = INF;
+        for (int mask = 0; mask < (1 << others.size()); mask++) {
+            boolean[] inS = new boolean[n];
+            inS[s] = true;
+            for (int i = 0; i < others.size(); i++) {
+                if ((mask >> i & 1) != 0) {
+                    inS[others.get(i)] = true;
+                }
+            }
+            best = Math.min(best, cutCapacity(g, inS));
+        }
+        return best;
+    }
+
+    /** Global minimum cut of an undirected graph (both sides non-empty). */
+    static double globalMinCut(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        List<Integer> vs = new ArrayList<>(g.vertexSet());
+        double best = INF;
+        for (int mask = 1; mask < (1 << vs.size()) - 1; mask++) {
+            boolean[] inS = new boolean[n];
+            for (int i = 0; i < vs.size(); i++) {
+                if ((mask >> i & 1) != 0) {
+                    inS[vs.get(i)] = true;
+                }
+            }
+            best = Math.min(best, cutCapacity(g, inS));
+        }
+        return best;
+    }
+
+    /** Adjacency lists ignoring direction and self loops, one entry per neighbour (parallel edges collapsed). */
+    static List<Set<Integer>> neighbours(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        List<Set<Integer>> adj = new ArrayList<>();
+        for (int i = 0; i < n; i++) {
+            adj.add(new HashSet<>());
+        }
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            int u = g.getEdgeSource(e);
+            int v = g.getEdgeTarget(e);
+            if (u != v) {
+                adj.get(u).add(v);
+                adj.get(v).add(u);
+            }
+        }
+        return adj;
+    }
+
+    /** Maximum cardinality matching size by bitmask DP over the vertices (n <= 16). */
+    static int maxMatching(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        List<Set<Integer>> adj = neighbours(g);
+        int[] memo = new int[1 << n];
+        Arrays.fill(memo, -1);
+        return maxMatching(adj, 0, n, memo);
+    }
+
+    private static int maxMatching(List<Set<Integer>> adj, int used, int n, int[] memo) {
+        if (memo[used] >= 0) {
+            return memo[used];
+        }
+        int u = -1;
+        for (int i = 0; i < n; i++) {
+            if ((used >> i & 1) == 0) {
+                u = i;
+                break;
+            }
+        }
+        if (u < 0) {
+            return memo[used] = 0;
+        }
+        int best = maxMatching(adj, used | 1 << u, n, memo);
+        for (int v : adj.get(u)) {
+            if ((used >> v & 1) == 0) {
+                best = Math.max(best, 1 + maxMatching(adj, used | 1 << u | 1 << v, n, memo));
+            }
+        }
+        return memo[used] = best;
+    }
+
+    /** Maximum weight matching (any cardinality) by bitmask DP; the heaviest edge between two vertices is used. */
+    static double maxWeightMatching(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        double[][] w = new double[n][n];
+        for (double[] row : w) {
+            Arrays.fill(row, Double.NEGATIVE_INFINITY);
+        }
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            int u = g.getEdgeSource(e);
+            int v = g.getEdgeTarget(e);
+            if (u != v) {
+                w[u][v] = Math.max(w[u][v], g.getEdgeWeight(e));
+                w[v][u] = w[u][v];
+            }
+        }
+        double[] memo = new double[1 << n];
+        Arrays.fill(memo, Double.NaN);
+        return maxWeightMatching(w, 0, n, memo, false);
+    }
+
+    /** Minimum weight perfect matching by bitmask DP, INF when no perfect matching exists. */
+    static double minWeightPerfectMatching(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        double[][] w = new double[n][n];
+        for (double[] row : w) {
+            Arrays.fill(row, Double.NEGATIVE_INFINITY);
+        }
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            int u = g.getEdgeSource(e);
+            int v = g.getEdgeTarget(e);
+            if (u != v) {
+                // negate so that the maximising DP minimises; the heaviest "negated" edge is the lightest one
+                w[u][v] = Math.max(w[u][v], -g.getEdgeWeight(e));
+                w[v][u] = w[u][v];
+            }
+        }
+        double[] memo = new double[1 << n];
+        Arrays.fill(memo, Double.NaN);
+        double best = maxWeightMatching(w, 0, n, memo, true);
+        return best == Double.NEGATIVE_INFINITY ? INF : -best;
+    }
+
+    private static double maxWeightMatching(double[][] w, int used, int n, double[] memo, boolean perfect) {
+        if (!Double.isNaN(memo[used])) {
+            return memo[used];
+        }
+        int u = -1;
+        for (int i = 0; i < n; i++) {
+            if ((used >> i & 1) == 0) {
+                u = i;
+                break;
+            }
+        }
+        if (u < 0) {
+            return memo[used] = 0;
+        }
+        double best = perfect ? Double.NEGATIVE_INFINITY : maxWeightMatching(w, used | 1 << u, n, memo, perfect);
+        for (int v = 0; v < n; v++) {
+            if (v != u && (used >> v & 1) == 0 && w[u][v] != Double.NEGATIVE_INFINITY) {
+                double rest = maxWeightMatching(w, used | 1 << u | 1 << v, n, memo, perfect);
+                if (rest != Double.NEGATIVE_INFINITY) {
+                    best = Math.max(best, w[u][v] + rest);
+                }
+            }
+        }
+        return memo[used] = best;
+    }
+
+    /** Is the edge set a matching of g (no shared endpoints, no self loops)? */
+    static boolean isMatching(Graph<Integer, DefaultWeightedEdge> g, Set<DefaultWeightedEdge> edges) {
+        Set<Integer> seen = new HashSet<>();
+        for (DefaultWeightedEdge e : edges) {
+            if (!g.containsEdge(e)) {
+                return false;
+            }
+            int u = g.getEdgeSource(e);
+            int v = g.getEdgeTarget(e);
+            if (u == v || !seen.add(u) || !seen.add(v)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static double weight(Graph<Integer, DefaultWeightedEdge> g, Iterable<DefaultWeightedEdge> edges) {
+        double s = 0;
+        for (DefaultWeightedEdge e : edges) {
+            s += g.getEdgeWeight(e);
+        }
+        return s;
+    }
+
+    /** Two-colourable ignoring direction; self loops make a graph non-bipartite. */
+    static boolean isBipartite(Graph<Integer, DefaultWeightedEdge> g) {
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            if (g.getEdgeSource(e).equals(g.getEdgeTarget(e))) {
+                return false;
+            }
+        }
+        int n = nv(g);
+        int[] colour = new int[n];
+        List<Set<Integer>> adj = neighbours(g);
+        for (int s : g.vertexSet()) {
+            if (colour[s] != 0) {
+                continue;
+            }
+            colour[s] = 1;
+            ArrayDeque<Integer> q = new ArrayDeque<>();
+            q.add(s);
+            while (!q.isEmpty()) {
+                int u = q.poll();
+                for (int v : adj.get(u)) {
+                    if (colour[v] == 0) {
+                        colour[v] = -colour[u];
+                        q.add(v);
+                    } else if (colour[v] == colour[u]) {
+                        return false;
+                    }
+                }
+            }
+        }
+        return true;
+    }
+
+    /** Chromatic number by backtracking over the vertices (n <= 10); 0 for the empty graph. */
+    static int chromaticNumber(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        if (g.vertexSet().isEmpty()) {
+            return 0;
+        }
+        List<Set<Integer>> adj = neighbours(g);
+        for (int k = 1; k <= n; k++) {
+            if (colourable(adj, new int[n], 0, n, k)) {
+                return k;
+            }
+        }
+        return n;
+    }
+
+    private static boolean colourable(List<Set<Integer>> adj, int[] c, int u, int n, int k) {
+        if (u == n) {
+            return true;
+        }
+        for (int col = 1; col <= k; col++) {
+            boolean ok = true;
+            for (int v : adj.get(u)) {
+                if (v < u && c[v] == col) {
+                    ok = false;
+                    break;
+                }
+            }
+            if (ok) {
+                c[u] = col;
+                if (colourable(adj, c, u + 1, n, k)) {
+                    return true;
+                }
+            }
+        }
+        c[u] = 0;
+        return false;
+    }
+
+    static boolean isProperColouring(Graph<Integer, DefaultWeightedEdge> g, Map<Integer, Integer> colours) {
+        if (!colours.keySet().equals(g.vertexSet())) {
+            return false;
+        }
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            int u = g.getEdgeSource(e);
+            int v = g.getEdgeTarget(e);
+            if (u != v && colours.get(u).equals(colours.get(v))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** Maximum clique size by subset enumeration (n <= 16). */
+    static int maxClique(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        List<Set<Integer>> adj = neighbours(g);
+        int best = 0;
+        List<Integer> vs = new ArrayList<>(g.vertexSet());
+        for (int mask = 1; mask < (1 << vs.size()); mask++) {
+            int size = Integer.bitCount(mask);
+            if (size <= best) {
+                continue;
+            }
+            if (isClique(adj, vs, mask)) {
+                best = size;
+            }
+        }
+        return best;
+    }
+
+    private static boolean isClique(List<Set<Integer>> adj, List<Integer> vs, int mask) {
+        for (int i = 0; i < vs.size(); i++) {
+            if ((mask >> i & 1) == 0) {
+                continue;
+            }
+            for (int j = i + 1; j < vs.size(); j++) {
+                if ((mask >> j & 1) != 0 && !adj.get(vs.get(i)).contains(vs.get(j))) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    static boolean isClique(Graph<Integer, DefaultWeightedEdge> g, Set<Integer> s) {
+        List<Set<Integer>> adj = neighbours(g);
+        for (int u : s) {
+            for (int v : s) {
+                if (u < v && !adj.get(u).contains(v)) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    /** All maximal cliques (as vertex sets) by subset enumeration. */
+    static Set<Set<Integer>> maximalCliques(Graph<Integer, DefaultWeightedEdge> g) {
+        List<Set<Integer>> adj = neighbours(g);
+        List<Integer> vs = new ArrayList<>(g.vertexSet());
+        List<Integer> cliques = new ArrayList<>();
+        for (int mask = 1; mask < (1 << vs.size()); mask++) {
+            if (isClique(adj, vs, mask)) {
+                cliques.add(mask);
+            }
+        }
+        Set<Set<Integer>> out = new HashSet<>();
+        for (int c : cliques) {
+            boolean maximal = true;
+            for (int d : cliques) {
+                if (d != c && (c & d) == c) {
+                    maximal = false;
+                    break;
+                }
+            }
+            if (maximal) {
+                Set<Integer> s = new HashSet<>();
+                for (int i = 0; i < vs.size(); i++) {
+                    if ((c >> i & 1) != 0) {
+                        s.add(vs.get(i));
+                    }
+                }
+                out.add(s);
+            }
+        }
+        return out;
+    }
+
+    /** Maximum independent set size (self loops make a vertex ineligible). */
+    static int maxIndependentSet(Graph<Integer, DefaultWeightedEdge> g) {
+        List<Set<Integer>> adj = neighbours(g);
+        List<Integer> vs = new ArrayList<>(g.vertexSet());
+        Set<Integer> looped = new HashSet<>();
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            if (g.getEdgeSource(e).equals(g.getEdgeTarget(e))) {
+                looped.add(g.getEdgeSource(e));
+            }
+        }
+        int best = 0;
+        for (int mask = 0; mask < (1 << vs.size()); mask++) {
+            if (Integer.bitCount(mask) <= best) {
+                continue;
+            }
+            boolean ok = true;
+            for (int i = 0; i < vs.size() && ok; i++) {
+                if ((mask >> i & 1) == 0) {
+                    continue;
+                }
+                if (looped.contains(vs.get(i))) {
+                    ok = false;
+                    break;
+                }
+                for (int j = i + 1; j < vs.size(); j++) {
+                    if ((mask >> j & 1) != 0 && adj.get(vs.get(i)).contains(vs.get(j))) {
+                        ok = false;
+                        break;
+                    }
+                }
+            }
+            if (ok) {
+                best = Integer.bitCount(mask);
+            }
+        }
+        return best;
+    }
+
+    static boolean isIndependent(Graph<Integer, DefaultWeightedEdge> g, Set<Integer> s) {
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            if (s.contains(g.getEdgeSource(e)) && s.contains(g.getEdgeTarget(e))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static boolean isVertexCover(Graph<Integer, DefaultWeightedEdge> g, Set<Integer> s) {
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            if (!s.contains(g.getEdgeSource(e)) && !s.contains(g.getEdgeTarget(e))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** Minimum weight vertex cover by subset enumeration (weights per vertex, 1 if the map lacks a vertex). */
+    static double minVertexCover(Graph<Integer, DefaultWeightedEdge> g, Map<Integer, Double> weights) {
+        List<Integer> vs = new ArrayList<>(g.vertexSet());
+        double best = INF;
+        for (int mask = 0; mask < (1 << vs.size()); mask++) {
+            Set<Integer> s = new HashSet<>();
+            double w = 0;
+            for (int i = 0; i < vs.size(); i++) {
+                if ((mask >> i & 1) != 0) {
+                    s.add(vs.get(i));
+                    w += weights == null ? 1 : weights.getOrDefault(vs.get(i), 1.0);
+                }
+            }
+            if (w < best && isVertexCover(g, s)) {
+                best = w;
+            }
+        }
+        return best;
+    }
+
+    /** Degree ignoring direction; a self loop adds 2. */
+    static int degree(Graph<Integer, DefaultWeightedEdge> g, int v) {
+        int d = 0;
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            if (g.getEdgeSource(e) == v) {
+                d++;
+            }
+            if (g.getEdgeTarget(e) == v) {
+                d++;
+            }
+        }
+        return d;
+    }
+
+    /** Eulerian: every edge on one closed walk (an edgeless graph counts). */
+    static boolean isEulerian(Graph<Integer, DefaultWeightedEdge> g) {
+        if (g.vertexSet().isEmpty()) {
+            return false; // JGraphT's convention: the null graph is not Eulerian, an edgeless graph with vertices is
+        }
+        if (g.edgeSet().isEmpty()) {
+            return true;
+        }
+        Set<Integer> touched = new HashSet<>();
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            touched.add(g.getEdgeSource(e));
+            touched.add(g.getEdgeTarget(e));
+        }
+        if (g.getType().isDirected()) {
+            for (int v : touched) {
+                if (g.inDegreeOf(v) != g.outDegreeOf(v)) {
+                    return false;
+                }
+            }
+            boolean[][] r = reach(g);
+            for (int u : touched) {
+                for (int v : touched) {
+                    if (!r[u][v]) {
+                        return false;
+                    }
+                }
+            }
+            return true;
+        }
+        for (int v : touched) {
+            if (degree(g, v) % 2 != 0) {
+                return false;
+            }
+        }
+        boolean[][] r = reach(g);
+        for (int u : touched) {
+            for (int v : touched) {
+                if (!r[u][v]) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    /** Held-Karp: the cheapest Hamiltonian cycle of a complete weighted graph (n <= 12), INF when n < 3. */
+    static double tsp(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        if (n == 1) {
+            return 0;
+        }
+        if (n == 2) {
+            double[][] w = direct(g);
+            return g.getType().isDirected() ? w[0][1] + w[1][0] : 2 * w[0][1];
+        }
+        double[][] w = direct(g);
+        double[][] dp = new double[1 << n][n];
+        for (double[] row : dp) {
+            Arrays.fill(row, INF);
+        }
+        dp[1][0] = 0;
+        for (int mask = 1; mask < (1 << n); mask++) {
+            if ((mask & 1) == 0) {
+                continue;
+            }
+            for (int last = 0; last < n; last++) {
+                if ((mask >> last & 1) == 0 || dp[mask][last] == INF) {
+                    continue;
+                }
+                for (int next = 0; next < n; next++) {
+                    if ((mask >> next & 1) != 0 || w[last][next] == INF) {
+                        continue;
+                    }
+                    int m2 = mask | 1 << next;
+                    dp[m2][next] = Math.min(dp[m2][next], dp[mask][last] + w[last][next]);
+                }
+            }
+        }
+        double best = INF;
+        int full = (1 << n) - 1;
+        for (int last = 1; last < n; last++) {
+            if (dp[full][last] != INF && w[last][0] != INF) {
+                best = Math.min(best, dp[full][last] + w[last][0]);
+            }
+        }
+        return best;
+    }
+
+    /** Does the graph have a Hamiltonian cycle (n >= 3; direction respected)? */
+    static boolean hasHamiltonianCycle(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        if (n < 3) {
+            return false;
+        }
+        return tsp(g) != INF;
+    }
+
+    /** Does the graph have a Hamiltonian path? */
+    static boolean hasHamiltonianPath(Graph<Integer, DefaultWeightedEdge> g) {
+        int n = nv(g);
+        if (n <= 1) {
+            return true;
+        }
+        double[][] w = direct(g);
+        boolean[][] dp = new boolean[1 << n][n];
+        for (int v = 0; v < n; v++) {
+            dp[1 << v][v] = true;
+        }
+        for (int mask = 1; mask < (1 << n); mask++) {
+            for (int last = 0; last < n; last++) {
+                if (!dp[mask][last]) {
+                    continue;
+                }
+                for (int next = 0; next < n; next++) {
+                    if ((mask >> next & 1) == 0 && w[last][next] != INF) {
+                        dp[mask | 1 << next][next] = true;
+                    }
+                }
+            }
+        }
+        for (int v = 0; v < n; v++) {
+            if (dp[(1 << n) - 1][v]) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Vertices whose removal increases the number of components (direction ignored). */
+    static Set<Integer> cutVertices(Graph<Integer, DefaultWeightedEdge> g) {
+        Set<Integer> out = new HashSet<>();
+        int base = components(g).size();
+        for (int v : new ArrayList<>(g.vertexSet())) {
+            List<DefaultWeightedEdge> es = new ArrayList<>(g.edgesOf(v));
+            List<int[]> ends = new ArrayList<>();
+            List<Double> ws = new ArrayList<>();
+            for (DefaultWeightedEdge e : es) {
+                ends.add(new int[] {g.getEdgeSource(e), g.getEdgeTarget(e)});
+                ws.add(g.getEdgeWeight(e));
+            }
+            g.removeVertex(v);
+            int after = components(g).size();
+            g.addVertex(v);
+            for (int i = 0; i < es.size(); i++) {
+                DefaultWeightedEdge e = es.get(i);
+                g.addEdge(ends.get(i)[0], ends.get(i)[1], e);
+                if (g.getType().isWeighted()) {
+                    g.setEdgeWeight(e, ws.get(i));
+                }
+            }
+            // removing v also removed v itself from the count: v is a cut vertex when the rest has more components
+            if (after > base) {
+                out.add(v);
+            }
+        }
+        return out;
+    }
+
+    /** Edges whose removal increases the number of components. */
+    static Set<DefaultWeightedEdge> bridges(Graph<Integer, DefaultWeightedEdge> g) {
+        Set<DefaultWeightedEdge> out = new HashSet<>();
+        int base = components(g).size();
+        for (DefaultWeightedEdge e : new ArrayList<>(g.edgeSet())) {
+            int u = g.getEdgeSource(e);
+            int v = g.getEdgeTarget(e);
+            double w = g.getEdgeWeight(e);
+            g.removeEdge(e);
+            int after = components(g).size();
+            g.addEdge(u, v, e);
+            if (g.getType().isWeighted()) {
+                g.setEdgeWeight(e, w);
+            }
+            if (after > base) {
+                out.add(e);
+            }
+        }
+        return out;
+    }
+
+    /** All simple cycles of a directed graph as vertex lists rotated to start at their minimum (canonical). */
+    static Set<List<Integer>> simpleCycles(Graph<Integer, DefaultWeightedEdge> g) {
+        Set<List<Integer>> out = new HashSet<>();
+        int n = nv(g);
+        boolean[][] adj = new boolean[n][n];
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            adj[g.getEdgeSource(e)][g.getEdgeTarget(e)] = true;
+            if (!g.getType().isDirected()) {
+                adj[g.getEdgeTarget(e)][g.getEdgeSource(e)] = true;
+            }
+        }
+        for (int s : g.vertexSet()) {
+            List<Integer> path = new ArrayList<>();
+            path.add(s);
+            cycles(adj, n, s, s, path, new BitSet(), out, g.getType().isDirected());
+        }
+        return out;
+    }
+
+    private static void cycles(boolean[][] adj, int n, int start, int u, List<Integer> path, BitSet used, Set<List<Integer>> out, boolean directed) {
+        used.set(u);
+        for (int v = 0; v < n; v++) {
+            if (!adj[u][v]) {
+                continue;
+            }
+            if (v == start) {
+                if (directed || path.size() >= 3 || (path.size() == 1)) {
+                    // undirected: a cycle needs 3+ distinct vertices unless it is a self loop
+                    if (!directed && path.size() == 2) {
+                        continue;
+                    }
+                    List<Integer> c = new ArrayList<>(path);
+                    if (!directed) {
+                        // canonical direction: second element smaller than the last
+                        if (c.size() >= 3 && c.get(1) > c.get(c.size() - 1)) {
+                            List<Integer> r = new ArrayList<>();
+                            r.add(c.get(0));
+                            for (int i = c.size() - 1; i >= 1; i--) {
+                                r.add(c.get(i));
+                            }
+                            c = r;
+                        }
+                    }
+                    out.add(c);
+                }
+            } else if (v > start && !used.get(v)) {
+                path.add(v);
+                cycles(adj, n, start, v, path, used, out, directed);
+                path.remove(path.size() - 1);
+            }
+        }
+        used.clear(u);
+    }
+
+    /** Lowest common ancestor in a tree rooted at root (undirected edges), by ancestor lists. */
+    static Integer lca(Graph<Integer, DefaultWeightedEdge> tree, int root, int a, int b) {
+        Map<Integer, Integer> parent = new HashMap<>();
+        parent.put(root, null);
+        ArrayDeque<Integer> q = new ArrayDeque<>();
+        q.add(root);
+        while (!q.isEmpty()) {
+            int u = q.poll();
+            for (DefaultWeightedEdge e : tree.edgesOf(u)) {
+                int v = tree.getEdgeSource(e) == u ? tree.getEdgeTarget(e) : tree.getEdgeSource(e);
+                if (!parent.containsKey(v)) {
+                    parent.put(v, u);
+                    q.add(v);
+                }
+            }
+        }
+        if (!parent.containsKey(a) || !parent.containsKey(b)) {
+            return null;
+        }
+        List<Integer> pa = new ArrayList<>();
+        for (Integer x = a; x != null; x = parent.get(x)) {
+            pa.add(x);
+        }
+        Set<Integer> anc = new HashSet<>(pa);
+        for (Integer x = b; x != null; x = parent.get(x)) {
+            if (anc.contains(x)) {
+                return x;
+            }
+        }
+        return null;
+    }
+
+    /** Is the vertex order a topological order of the DAG? */
+    static boolean isTopological(Graph<Integer, DefaultWeightedEdge> g, List<Integer> order) {
+        if (order.size() != g.vertexSet().size() || new HashSet<>(order).size() != order.size()) {
+            return false;
+        }
+        Map<Integer, Integer> pos = new HashMap<>();
+        for (int i = 0; i < order.size(); i++) {
+            pos.put(order.get(i), i);
+        }
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            if (pos.get(g.getEdgeSource(e)) >= pos.get(g.getEdgeTarget(e))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** Does the graph contain a directed cycle (self loops included)? */
+    static boolean hasCycle(Graph<Integer, DefaultWeightedEdge> g) {
+        boolean[][] r = reach(g);
+        for (DefaultWeightedEdge e : g.edgeSet()) {
+            if (r[g.getEdgeTarget(e)][g.getEdgeSource(e)]) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static String show(double[][] m) {
+        StringBuilder sb = new StringBuilder();
+        for (double[] row : m) {
+            sb.append(Arrays.toString(row)).append('\n');
+        }
+        return sb.toString();
+    }
+}
