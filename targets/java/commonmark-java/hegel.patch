+    }
+}
diff --git a/hegel/src/test/java/zoo/CoreTest.java b/hegel/src/test/java/zoo/CoreTest.java
new file mode 100644
index 0000000..0084a1d
--- /dev/null
+++ b/hegel/src/test/java/zoo/CoreTest.java
@@ -0,0 +1,57 @@
+package zoo;
+
+import static zoo.Zoo.check;
+import static zoo.Zoo.show;
+
+import org.commonmark.node.Node;
+import org.commonmark.parser.IncludeSourceSpans;
+import org.commonmark.parser.Parser;
+import org.commonmark.renderer.html.HtmlRenderer;
+import org.junit.jupiter.api.Test;
+
+/** The core parser and HTML renderer against commonmark.js, the reference implementation of spec 0.31.2. */
+class CoreTest {
+
+    static final Parser PARSER = Parser.builder().includeSourceSpans(IncludeSourceSpans.BLOCKS).build();
+    static final HtmlRenderer HTML = HtmlRenderer.builder().percentEncodeUrls(true).build();
+
+    @Test
+    void htmlMatchesCommonmarkJs() {
+        Zoo.property("commonmark-java.htmlMatchesCommonmarkJs", tc -> {
+            String md = tc.draw(MdGen.CORE, "doc").render();
+            String expected = Cmjs.html(md);
+            Node doc = PARSER.parse(md);
+            String actual = HTML.render(doc);
+            boolean same = same(md, actual, expected);
+            // a difference by a recorded bug is the pin's business, not this property's
+            tc.assume(same || !Known.differential(md, doc, actual));
+            check(same, () -> "HTML differs from commonmark.js for " + show(md) + "\n  expected " + show(expected) + "\n  actual   " + show(actual));
+        });
+    }
+
+    /**
+     * Differences that are commonmark.js's, not the library's (checked against the spec text, see the README): the
+     * reference trims Unicode spaces (U+00A0, U+2003, …) off paragraphs as JavaScript whitespace (the spec's blank characters are space and tab),
+     * and it omits an empty title attribute where the library writes {@code title=""} (the spec leaves this open).
+     */
+    /** What JavaScript's trim strips beyond ASCII whitespace: the Zs spaces, the line and paragraph separators, the BOM. */
+    static final java.util.regex.Pattern UNICODE_SPACE = java.util.regex.Pattern.compile("[\\p{Zs}&&[^ ]]|[\\u2028\\u2029\\uFEFF]");
+
+    static boolean same(String md, String actual, String expected) {
+        String a = actual.replace(" title=\"\"", "");
+        String e = expected;
+        if (UNICODE_SPACE.matcher(md).find()) {
+            // the Unicode spaces other than U+0020 (Zs minus the ASCII space) and the BOM are dropped from both; ASCII
+            // spaces must match, except at the edges of paragraphs and headings: commonmark.js trims a run of ASCII
+            // and Unicode spaces (and a line made of them alone, with its line ending) where the library keeps the ASCII
+            // spaces and the line before a Unicode space, as the spec says.
+            a = trimEdges(UNICODE_SPACE.matcher(a).replaceAll(""));
+            e = trimEdges(UNICODE_SPACE.matcher(e).replaceAll(""));
+        }
+        return a.equals(e);
+    }
+
+    static String trimEdges(String html) {
+        return html.replaceAll("(<(?:p|h[1-6])>)[ \\n]+", "$1").replaceAll("[ \\n]+(</(?:p|h[1-6])>)", "$1");
+    }
+}
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..1c75578
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,88 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The combinators the binding lacks: weighted choice, a biased coin, an optional with a probability, an int range,
+ * and text over an alphabet ({@code TextGenerator} takes code point ranges, not an alphabet).
+ */
+final class Gen {
+    private Gen() {}
+
+    /** A weighted alternative for {@link #weighted}; the generator may produce a subtype of the choice's type. */
+    record Choice<T>(int weight, Generator<? extends T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<? extends T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    static <T> Generator<T> weighted(List<Choice<T>> choices) {
+        List<Choice<T>> cs = List.copyOf(choices);
+        int total = 0;
+        for (Choice<T> c : cs) {
+            total += c.weight();
+        }
+        return ints(0, total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : cs) {
+                acc += c.weight();
+                if (i < acc) {
+                    return widen(c.gen());
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** A generator of a subtype is a generator of the supertype: it only ever produces values. */
+    @SuppressWarnings("unchecked")
+    static <T> Generator<T> widen(Generator<? extends T> g) {
+        return (Generator<T>) g;
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return ints(0, 99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<? extends T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** One character of the alphabet (by UTF-16 unit, so a supplementary character's halves come out alone, as before). */
+    static Generator<String> chars(String alphabet) {
+        List<String> cs = new ArrayList<>();
+        for (int i = 0; i < alphabet.length(); i++) {
+            cs.add(String.valueOf(alphabet.charAt(i)));
+        }
+        return sampledFrom(cs);
+    }
+
+    /** A string of lo..hi characters of the alphabet; shrinks to lo characters. */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        return lists(chars(alphabet)).minSize(lo).maxSize(hi).map(Gen::join);
+    }
+
+    static String join(List<String> parts) {
+        return String.join("", parts);
+    }
+}
