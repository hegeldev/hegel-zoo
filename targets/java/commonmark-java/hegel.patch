+            if (n instanceof Emphasis || n instanceof StrongEmphasis) {
+                Node p = n.getParent();
+                if (p instanceof Emphasis || p instanceof StrongEmphasis || n instanceof StrongEmphasis
+                    || n.getPrevious() instanceof Emphasis || n.getPrevious() instanceof StrongEmphasis
+                    || n.getNext() instanceof Emphasis || n.getNext() instanceof StrongEmphasis) {
+                    return true; // 15, 16
+                }
+            }
+            if (n instanceof HtmlInline && ((HtmlInline) n).getLiteral().indexOf('\n') >= 0) {
+                return true; // 17
+            }
+            if (n instanceof Link && walk(n, c -> c != n && c instanceof Link)) {
+                return true; // 18
+            }
+            if (n instanceof ListItem && n.getFirstChild() instanceof ThematicBreak) {
+                return true; // 19
+            }
+            if (n instanceof Text && (n.getPrevious() == null || n.getPrevious() instanceof SoftLineBreak || n.getPrevious() instanceof HardLineBreak)) {
+                String t = ((Text) n).getLiteral();
+                if (t.startsWith("+") || t.startsWith("~~~")) {
+                    return true; // 21, 23
+                }
+            }
+            String dest = destination(n);
+            if (dest != null && dest.indexOf('&') >= 0) {
+                return true; // 24
+            }
+            if (n instanceof Link && ((Link) n).getTitle() != null && ((Link) n).getTitle().indexOf('&') >= 0
+                || n instanceof Image && ((Image) n).getTitle() != null && ((Image) n).getTitle().indexOf('&') >= 0) {
+                return true; // 24
+            }
+            if (n instanceof FootnoteDefinition && n.getFirstChild() == null) {
+                return true; // 32
+            }
+            if (n instanceof FootnoteDefinition && FOOTNOTE_ESCAPED_OPENER.matcher(sourceLines(md, n).lines().findFirst().orElse("")).find()) {
+                return true; // found by the generator rewrite, not yet recorded: see FOOTNOTE_ESCAPED_OPENER
+            }
+            if (n instanceof HtmlBlock && ((HtmlBlock) n).getLiteral() != null && ((HtmlBlock) n).getLiteral().indexOf('\t') >= 0) {
+                return true; // 2 (a tab kept whole in the literal changes its width under the rendered prefix)
+            }
+            if (dest != null && dest.isEmpty() && (n instanceof Link && ((Link) n).getTitle() != null || n instanceof Image && ((Image) n).getTitle() != null)) {
+                return true; // 51
+            }
+            if (n instanceof TableHead && n.getFirstChild() instanceof TableRow && n.getFirstChild().getFirstChild() == null) {
+                return true; // 33
+            }
+            if (n instanceof TableCell && walk(n, c -> c instanceof Text && ((Text) c).getLiteral().indexOf('\\') >= 0)) {
+                return true; // 47
+            }
+            return false;
+        });
+    }
+
+    /** Bugs 26–28: a child's span starting before its parent's on the same line, with only whitespace or block quote markers between. */
+    static boolean spanProblem(String md, SourceSpan child, java.util.List<SourceSpan> parents) {
+        int start = child.getInputIndex();
+        int end = start + child.getLength();
+        for (SourceSpan p : parents) {
+            if (p.getLineIndex() == child.getLineIndex() && start < p.getInputIndex() && end <= p.getInputIndex() + p.getLength()
+                && md.substring(start, p.getInputIndex()).matches("[ \\t>]*")) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Bug 48: a paragraph that follows a link reference definition whose title failed has no spans. */
+    static boolean spanless(Node node) {
+        Node p = node instanceof Paragraph ? node : node.getParent();
+        return p instanceof Paragraph && p.getPrevious() instanceof LinkReferenceDefinition;
+    }
+
+    /** Bug 30: image attributes are unlinked by the HTML renderer. */
+    static boolean pure(Node doc) {
+        return walk(doc, n -> n instanceof ImageAttributes);
+    }
+
+    // ---- helpers ---------------------------------------------------------------------------------------------------
+
+    interface Pred {
+        boolean test(Node n);
+    }
+
+    static boolean walk(Node node, Pred pred) {
+        if (pred.test(node)) {
+            return true;
+        }
+        for (Node c = node.getFirstChild(); c != null; c = c.getNext()) {
+            if (walk(c, pred)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static String destination(Node n) {
+        if (n instanceof Link) {
+            return ((Link) n).getDestination();
+        }
+        if (n instanceof Image) {
+            return ((Image) n).getDestination();
+        }
+        if (n instanceof LinkReferenceDefinition) {
+            return ((LinkReferenceDefinition) n).getDestination();
+        }
+        return null;
+    }
+
+    static boolean unbalanced(String dest) {
+        int depth = 0;
+        for (int i = 0; i < dest.length(); i++) {
+            char c = dest.charAt(i);
+            if (c == '(') {
+                depth++;
+            } else if (c == ')') {
+                depth--;
+            }
+        }
+        return depth != 0;
+    }
+
+    static boolean hasUnpairedSurrogate(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
+                    i++;
+                } else {
+                    return true;
+                }
+            } else if (Character.isLowSurrogate(c)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** A list one of whose items has a non-paragraph block followed, after a blank line, by another block (bug 1's shape; needs block spans). */
+    static boolean blankLineAfterNonParagraphInsideAnItem(Node list) {
+        for (Node item = list.getFirstChild(); item != null; item = item.getNext()) {
+            Block prev = null;
+            for (Node c = item.getFirstChild(); c != null; c = c.getNext()) {
+                if (!(c instanceof Block)) {
+                    continue;
+                }
+                if (prev != null && !(prev instanceof Paragraph) && !prev.getSourceSpans().isEmpty() && !c.getSourceSpans().isEmpty()) {
+                    int lastLine = prev.getSourceSpans().get(prev.getSourceSpans().size() - 1).getLineIndex();
+                    int firstLine = c.getSourceSpans().get(0).getLineIndex();
+                    if (firstLine > lastLine + 1) {
+                        return true;
+                    }
+                }
+                prev = (Block) c;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Not yet recorded: a blank line inside a nested list (after a paragraph or an item) sets the enclosing item's
+     * {@code hadBlankLine} ({@code ListItemParser.java:64}), which nothing clears, so a block that follows the nested
+     * list on the very next line makes the outer list loose ({@code canContain}, {@code ListItemParser.java:36-45}):
+     * {@code "- a\n  - b\n\n  - # c\n  d\n"} renders {@code <p>d</p>} where commonmark.js has {@code d} (spec §Lists:
+     * the outer item's two blocks have no blank line between them). The loose list is also what the Markdown renderer
+     * writes back with a blank line after every item, and that re-parses tight.
+     */
+    static boolean blockRightAfterNestedListWithBlankLine(Node list) {
+        if (((ListBlock) list).isTight()) {
+            return false;
+        }
+        for (Node item = list.getFirstChild(); item != null; item = item.getNext()) {
+            for (Node c = item.getFirstChild(); c != null; c = c.getNext()) {
+                Node next = c.getNext();
+                if (c instanceof ListBlock && next != null && skipsALine(c.getSourceSpans()) && !next.getSourceSpans().isEmpty()
+                    && next.getSourceSpans().get(0).getLineIndex() == lastLine(c) + 1) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Not yet recorded: inside a tight list item the Markdown renderer separates blocks by a line ending alone,
+     * also inside a block quote or footnote definition there, where the parser needs a {@code >} line (a blank line) between two paragraphs
+     * ({@code MarkdownWriter.block}, {@code MarkdownWriter.java:77}: {@code blockSeparator = isTight() ? 1 : 2}). A
+     * block ending in a paragraph (or a table) followed by anything a paragraph line runs into, or two block quotes,
+     * are written with nothing between them and re-parse merged: {@code "- > a\n  >\n  > a\n"} (two paragraphs in
+     * the quote) is rendered {@code "- > a\n  > a\n"} (one); {@code "- > a\n  >\n  a\n"} (the second {@code a} is
+     * the item's) becomes {@code "- > a\n  a\n"} (the quote's, lazily); {@code "- a\n  > a\n  >\n  >     a\n"} makes
+     * the indented code a lazy line and {@code "- > a\n  >\n  > a\n  > a\n  > ===\n"} a three-line setext heading;
+     * {@code "- > > a\n  >\n  > > b\n"} becomes {@code "- > > a\n  > > b\n"} (one nested quote); after a table
+     * ({@code "- > a|a\n  > ---|---\n  >\n  a\n"}) the paragraph line becomes a row. The gate takes every follower
+     * (an ATX heading or a fence would be safe) for a plainer rule.
+     */
+    static boolean blocksRunOnInTightItem(Node block) {
+        Node next = block.getNext();
+        Node leaf = lastLeaf(block);
+        boolean merge = block instanceof BlockQuote && next instanceof BlockQuote || next != null && (leaf instanceof Paragraph || leaf instanceof TableBlock);
+        if (!merge) {
+            return false;
+        }
+        Node p = block.getParent();
+        while (p instanceof BlockQuote || p instanceof Alert || p instanceof FootnoteDefinition) {
+            p = p.getParent();
+        }
+        return p instanceof ListItem && p.getParent() instanceof ListBlock && ((ListBlock) p.getParent()).isTight();
+    }
+
+    /**
+     * Not yet recorded: a footnote definition with a second block inside a container. The parser reads the second
+     * block's lines against the wrong column ({@code "-   a[^1]\n    [^1]: a\n    \n        a\n"}: the second
+     * {@code a}, four columns past the definition, is indented code, not a paragraph), and the Markdown renderer
+     * writes it four columns further out again ({@code "            a"}), which re-parses as a paragraph joined to
+     * the first: neither the HTML nor the Markdown survives the round trip. In two block quotes, or one with a tab
+     * after its marker, the indentation grows by four columns at every rendering ({@code "> > [^1]: a\n> >\n> >     a\n"}
+     * is rendered with eight spaces before the second {@code a}, that with twelve); at the top level it is stable.
+     * (Kept for the report: {@link #inListItem} is the list item case's test.)
+     */
+    static boolean inListItem(Node n) {
+        for (Node p = n.getParent(); p != null; p = p.getParent()) {
+            if (p instanceof ListItem) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static Node lastLeaf(Node n) {
+        Node last = n;
+        while (last.getLastChild() instanceof Block) {
+            last = last.getLastChild();
+        }
+        return last;
+    }
+
+    /**
+     * Not yet recorded: a list item that may not interrupt a paragraph (spec §List items: an ordered one must start
+     * with 1, and the first line must not be blank) does so right after a link reference definition, because the
+     * definition's lines no longer count as the paragraph's ({@code ListBlockParser.java:214} asks for the lines left
+     * after the definitions): {@code "[a]: /u\n2. x\n"} is an ordered list starting at 2 (commonmark.js: the paragraph
+     * {@code 2. x}), {@code "[a]: /u\n- \n"} an empty bullet item (commonmark.js: the paragraph {@code -}).
+     */
+    static boolean listInterruptingADefinition(Node list) {
+        Node def = list.getPrevious();
+        if (!(def instanceof LinkReferenceDefinition) || def.getSourceSpans().isEmpty() || list.getSourceSpans().isEmpty()
+            || list.getSourceSpans().get(0).getLineIndex() != lastLine(def) + 1) {
+            return false;
+        }
+        if (list instanceof OrderedList) {
+            Integer start = ((OrderedList) list).getMarkerStartNumber();
+            if (start != null && start != 1) {
+                return true;
+            }
+        }
+        Node item = list.getFirstChild();
+        Node content = item == null ? null : item.getFirstChild();
+        return content == null || !content.getSourceSpans().isEmpty() && content.getSourceSpans().get(0).getLineIndex() > list.getSourceSpans().get(0).getLineIndex();
+    }
+
+    /**
+     * The input lines a block spans, from its first span to the end of its last span's line. A link reference
+     * definition with a tab in it is commonmark.js's difference, not the library's: its {@code reSpaceAtEndOfLine}
+     * ({@code /^ *(?:\n|$)/}) and {@code spnl} match spaces only, so {@code "[a]: /u\t"} stays a paragraph there,
+     * where the spec (§Link reference definitions: "optional spaces or tabs") and the library see a definition.
+     */
+    /**
+     * Bug 49's shape at the top level: {@code "[foo]: /url\n<a href=\"x\">\n"} is a paragraph of inline HTML (an HTML
+     * block of kind 7 cannot interrupt the paragraph the definition opened); the renderer drops the definition and
+     * writes {@code <a href="x">} at a line start, where it is an HTML block. A paragraph without spans is bug 48's
+     * (a definition whose title failed), taken as continuing it.
+     */
+    static boolean htmlLineContinuesTheDefinition(String md, Node def) {
+        Node p = def.getNext();
+        if (def.getSourceSpans().isEmpty() || p.getSourceSpans().isEmpty()) {
+            return true;
+        }
+        return p.getSourceSpans().get(0).getLineIndex() == lastLine(def) + 1 && sourceLines(md, p).stripLeading().startsWith("<");
+    }
+
+    /**
+     * Bug 52 as the HTML cannot show it: a code span inside an image's alt text is rendered as plain text, so
+     * {@code "```![`code`](/url)`code`"} (the image's code span closes the scan, the last {@code `code`} is left literal)
+     * has no {@code </code>} before its literal backtick. In document order: a Code node, then a Text with a backtick.
+     */
+    static boolean literalBacktickAfterCodeSpan(Node doc) {
+        boolean[] code = {false};
+        return walk(doc, n -> {
+            if (n instanceof Code) {
+                code[0] = true;
+            }
+            return code[0] && n instanceof Text && ((Text) n).getLiteral().indexOf('`') >= 0;
+        });
+    }
+
+    static String sourceLines(String md, Node n) {
+        java.util.List<SourceSpan> spans = n.getSourceSpans();
+        if (spans.isEmpty()) {
+            return "";
+        }
+        SourceSpan last = spans.get(spans.size() - 1);
+        int end = last.getInputIndex() + last.getLength();
+        while (end < md.length() && md.charAt(end) != '\n' && md.charAt(end) != '\r') {
+            end++;
+        }
+        return md.substring(spans.get(0).getInputIndex(), end);
+    }
+
+    static int lastLine(Node n) {
+        java.util.List<SourceSpan> spans = n.getSourceSpans();
+        return spans.get(spans.size() - 1).getLineIndex();
+    }
+
+    /** Whether consecutive spans skip a line index (a blank line inside the block). */
+    static boolean skipsALine(java.util.List<SourceSpan> spans) {
+        for (int i = 1; i < spans.size(); i++) {
+            if (spans.get(i).getLineIndex() > spans.get(i - 1).getLineIndex() + 1) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** A tight list one of whose items has two block children with a blank line between (their spans skip a line). */
+    static boolean tightListWithBlankLineInsideAnItem(Node list) {
+        for (Node item = list.getFirstChild(); item != null; item = item.getNext()) {
+            Block prev = null;
+            for (Node c = item.getFirstChild(); c != null; c = c.getNext()) {
+                if (!(c instanceof Block)) {
+                    continue;
+                }
+                if (prev != null && !prev.getSourceSpans().isEmpty() && !c.getSourceSpans().isEmpty()) {
+                    int lastLine = prev.getSourceSpans().get(prev.getSourceSpans().size() - 1).getLineIndex();
+                    int firstLine = c.getSourceSpans().get(0).getLineIndex();
+                    if (firstLine > lastLine + 1) {
+                        return true;
+                    }
+                }
+                prev = (Block) c;
+            }
+        }
+        return false;
+    }
+}
