index 0000000..6cc091b
--- /dev/null
+++ b/hegel/src/test/java/zoo/Known.java
@@ -0,0 +1,293 @@
+package zoo;
+
+import java.util.regex.Pattern;
+import org.commonmark.ext.footnotes.FootnoteDefinition;
+import org.commonmark.ext.gfm.tables.TableCell;
+import org.commonmark.ext.gfm.tables.TableHead;
+import org.commonmark.ext.gfm.tables.TableRow;
+import org.commonmark.ext.image.attributes.ImageAttributes;
+import org.commonmark.ext.task.list.items.TaskListItemMarker;
+import org.commonmark.node.Block;
+import org.commonmark.node.Document;
+import org.commonmark.node.Emphasis;
+import org.commonmark.node.FencedCodeBlock;
+import org.commonmark.node.HardLineBreak;
+import org.commonmark.node.HtmlBlock;
+import org.commonmark.node.HtmlInline;
+import org.commonmark.node.Image;
+import org.commonmark.node.IndentedCodeBlock;
+import org.commonmark.node.Link;
+import org.commonmark.node.LinkReferenceDefinition;
+import org.commonmark.node.ListBlock;
+import org.commonmark.node.ListItem;
+import org.commonmark.node.Node;
+import org.commonmark.node.OrderedList;
+import org.commonmark.node.Paragraph;
+import org.commonmark.node.SoftLineBreak;
+import org.commonmark.node.SourceSpan;
+import org.commonmark.node.StrongEmphasis;
+import org.commonmark.node.Text;
+import org.commonmark.node.ThematicBreak;
+
+/**
+ * The shapes of the recorded bugs (bugs.toml), which the properties leave to the pins: a property that meets one of
+ * them skips the case instead of failing. Numbers are the bug ids.
+ */
+final class Known {
+    private Known() {}
+
+    static final Pattern LOWERCASE_DECLARATION_BLOCK = Pattern.compile("(?m)^ {0,3}<![a-z]");
+    /** A fence line with a mixed info string, at the line start or after any container prefix (quote markers, list markers, indents). */
+    static final Pattern MIXED_FENCE = Pattern.compile("(?m)^[^`~\\r\\n]*(`{3,}[^`\\r\\n]*~|~{3,}[^\\r\\n]*`)");
+    static final Pattern DECLARATION_WITHOUT_SPACE = Pattern.compile("<![A-Za-z][^\\s>]*>");
+    static final Pattern ENTITY_AFTER_DELIMITER = Pattern.compile("[*_]&#?[A-Za-z0-9]+;");
+    static final Pattern LEADING_ZERO_MARKER = Pattern.compile("(?m)^[ \\t>]*0[0-9]*[.)][ \\t]");
+    static final Pattern LONG_MARKER = Pattern.compile("(?m)^[ \\t>]*[0-9]{2,}[.)][ \\t]");
+    static final Pattern BACKTICK_AFTER_CODE = Pattern.compile("(?s)</code>.*`");
+    static final Pattern CONTROL = Pattern.compile("[\\u0000-\\u0008\\u000B-\\u000C\\u000E-\\u001F\\u007F]");
+
+    /** Bugs 1–11 and 46 as met by the differential against commonmark.js; {@code doc} is parsed with block source spans. */
+    static boolean differential(String md, Node doc, String actual) {
+        if (LOWERCASE_DECLARATION_BLOCK.matcher(md).find() || MIXED_FENCE.matcher(md).find()
+            || DECLARATION_WITHOUT_SPACE.matcher(md).find() || CONTROL.matcher(md).find()) {
+            return true; // 5, 7, 9, 10, 11
+        }
+        if (hasUnpairedSurrogate(actual)) {
+            return true; // 6
+        }
+        if (BACKTICK_AFTER_CODE.matcher(actual).find()) {
+            return true; // 52 (a literal backtick after a code span: a later code span may have been missed)
+        }
+        return walk(doc, n -> {
+            if (n instanceof ListBlock && ((ListBlock) n).isTight() && tightListWithBlankLineInsideAnItem(n)) {
+                return true; // 1
+            }
+            if (n instanceof FencedCodeBlock) {
+                FencedCodeBlock f = (FencedCodeBlock) n;
+                if (f.getLiteral() != null && f.getLiteral().indexOf('\t') >= 0 && (f.getFenceIndent() > 0 || !(n.getParent() instanceof org.commonmark.node.Document))) {
+                    return true; // 2
+                }
+                if (f.getInfo() != null && f.getInfo().indexOf('\t') >= 0) {
+                    return true; // 3
+                }
+            }
+            String dest = destination(n);
+            if (dest != null && unbalanced(dest)) {
+                return true; // 4
+            }
+            if (n instanceof Image && walk(n, c -> c instanceof HtmlInline)) {
+                return true; // 8
+            }
+            if (n instanceof HtmlBlock && !(n.getParent() instanceof org.commonmark.node.Document)) {
+                return true; // 46
+            }
+            return false;
+        });
+    }
+
+    /** Bugs 7, 13–24, 45 and 49 (and 32, 33, 47 with the GFM extensions) as met by the Markdown round trip. */
+    static boolean roundTrip(String md, Node doc) {
+        if (MIXED_FENCE.matcher(md).find() || ENTITY_AFTER_DELIMITER.matcher(md).find() || LEADING_ZERO_MARKER.matcher(md).find()
+            || LONG_MARKER.matcher(md).find()) {
+            return true; // 7, 20, 22 (renumbered items change the marker's width)
+        }
+        return walk(doc, n -> {
+            if (n instanceof ListBlock && blankLineAfterNonParagraphInsideAnItem(n)) {
+                return true; // 1 (the list's tightness differs between the parse and the re-parse, without a trace in the HTML)
+            }
+            if (n instanceof HardLineBreak && (n.getPrevious() == null || n.getPrevious() instanceof HardLineBreak
+                || n.getPrevious() instanceof SoftLineBreak || n.getPrevious() instanceof TaskListItemMarker
+                || n.getPrevious() instanceof Text && (((Text) n.getPrevious()).getLiteral().isEmpty() || ((Text) n.getPrevious()).getLiteral().endsWith(" ")))) {
+                return true; // 13, 45 (an empty Text precedes the break after a task list marker)
+            }
+            if (n instanceof LinkReferenceDefinition && (!(n.getParent() instanceof Document) || n.getPrevious() instanceof ListBlock
+                || n.getPrevious() instanceof IndentedCodeBlock && n.getNext() instanceof IndentedCodeBlock)) {
+                return true; // 49 (a dropped definition inside a container leaves a stray line, or lets the blocks around it merge)
+            }
+            if (n instanceof ListItem && n.getFirstChild() instanceof ListBlock && n.getFirstChild().getFirstChild() instanceof ListItem
+                && ((ListItem) n.getFirstChild().getFirstChild()).getMarkerIndent() > 0) {
+                return true; // 50
+            }
+            if (n instanceof FencedCodeBlock) {
+                FencedCodeBlock f = (FencedCodeBlock) n;
+                String info = f.getInfo();
+                if (info != null && !info.isEmpty() && (info.charAt(0) == f.getFenceCharacter().charAt(0) || info.indexOf('&') >= 0)) {
+                    return true; // 14, 24
+                }
+            }
+            if (n instanceof Emphasis || n instanceof StrongEmphasis) {
+                Node p = n.getParent();
+                if (p instanceof Emphasis || p instanceof StrongEmphasis || n instanceof StrongEmphasis
+                    || n.getPrevious() instanceof Emphasis || n.getPrevious() instanceof StrongEmphasis
+                    || n.getNext() instanceof Emphasis || n.getNext() instanceof StrongEmphasis) {
+                    return true; // 15, 16
+                }
+            }
+            if (n instanceof HtmlInline && ((HtmlInline) n).getLiteral().indexOf('\n') >= 0) {
+                return true; // 17
+            }
+            if (n instanceof Link && walk(n, c -> c != n && c instanceof Link)) {
+                return true; // 18
+            }
+            if (n instanceof ListItem && n.getFirstChild() instanceof ThematicBreak) {
+                return true; // 19
+            }
+            if (n instanceof Text && (n.getPrevious() == null || n.getPrevious() instanceof SoftLineBreak || n.getPrevious() instanceof HardLineBreak)) {
+                String t = ((Text) n).getLiteral();
+                if (t.startsWith("+") || t.startsWith("~~~")) {
+                    return true; // 21, 23
+                }
+            }
+            String dest = destination(n);
+            if (dest != null && dest.indexOf('&') >= 0) {
+                return true; // 24
+            }
+            if (n instanceof Link && ((Link) n).getTitle() != null && ((Link) n).getTitle().indexOf('&') >= 0
+                || n instanceof Image && ((Image) n).getTitle() != null && ((Image) n).getTitle().indexOf('&') >= 0) {
+                return true; // 24
+            }
+            if (n instanceof FootnoteDefinition && n.getFirstChild() == null) {
+                return true; // 32
+            }
+            if (n instanceof HtmlBlock && ((HtmlBlock) n).getLiteral() != null && ((HtmlBlock) n).getLiteral().indexOf('\t') >= 0) {
+                return true; // 2 (a tab kept whole in the literal changes its width under the rendered prefix)
+            }
+            if (dest != null && dest.isEmpty() && (n instanceof Link && ((Link) n).getTitle() != null || n instanceof Image && ((Image) n).getTitle() != null)) {
+                return true; // 51
+            }
+            if (n instanceof TableHead && n.getFirstChild() instanceof TableRow && n.getFirstChild().getFirstChild() == null) {
+                return true; // 33
+            }
+            if (n instanceof TableCell && walk(n, c -> c instanceof Text && ((Text) c).getLiteral().indexOf('\\') >= 0)) {
+                return true; // 47
+            }
+            return false;
+        });
+    }
+
+    /** Bugs 26–28: a child's span starting before its parent's on the same line, with only whitespace or block quote markers between. */
+    static boolean spanProblem(String md, SourceSpan child, java.util.List<SourceSpan> parents) {
+        int start = child.getInputIndex();
+        int end = start + child.getLength();
+        for (SourceSpan p : parents) {
+            if (p.getLineIndex() == child.getLineIndex() && start < p.getInputIndex() && end <= p.getInputIndex() + p.getLength()
+                && md.substring(start, p.getInputIndex()).matches("[ \\t>]*")) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Bug 48: a paragraph that follows a link reference definition whose title failed has no spans. */
+    static boolean spanless(Node node) {
+        Node p = node instanceof Paragraph ? node : node.getParent();
+        return p instanceof Paragraph && p.getPrevious() instanceof LinkReferenceDefinition;
+    }
+
+    /** Bug 30: image attributes are unlinked by the HTML renderer. */
+    static boolean pure(Node doc) {
+        return walk(doc, n -> n instanceof ImageAttributes);
+    }
+
+    // ---- helpers ---------------------------------------------------------------------------------------------------
+
+    interface Pred {
+        boolean test(Node n);
+    }
+
+    static boolean walk(Node node, Pred pred) {
+        if (pred.test(node)) {
+            return true;
+        }
+        for (Node c = node.getFirstChild(); c != null; c = c.getNext()) {
+            if (walk(c, pred)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static String destination(Node n) {
+        if (n instanceof Link) {
+            return ((Link) n).getDestination();
+        }
+        if (n instanceof Image) {
+            return ((Image) n).getDestination();
+        }
+        if (n instanceof LinkReferenceDefinition) {
+            return ((LinkReferenceDefinition) n).getDestination();
+        }
+        return null;
+    }
+
+    static boolean unbalanced(String dest) {
+        int depth = 0;
+        for (int i = 0; i < dest.length(); i++) {
+            char c = dest.charAt(i);
+            if (c == '(') {
+                depth++;
+            } else if (c == ')') {
+                depth--;
+            }
+        }
+        return depth != 0;
+    }
+
+    static boolean hasUnpairedSurrogate(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
+                    i++;
+                } else {
+                    return true;
+                }
+            } else if (Character.isLowSurrogate(c)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** A list one of whose items has a non-paragraph block followed, after a blank line, by another block (bug 1's shape; needs block spans). */
+    static boolean blankLineAfterNonParagraphInsideAnItem(Node list) {
+        for (Node item = list.getFirstChild(); item != null; item = item.getNext()) {
+            Block prev = null;
+            for (Node c = item.getFirstChild(); c != null; c = c.getNext()) {
+                if (!(c instanceof Block)) {
+                    continue;
+                }
+                if (prev != null && !(prev instanceof Paragraph) && !prev.getSourceSpans().isEmpty() && !c.getSourceSpans().isEmpty()) {
+                    int lastLine = prev.getSourceSpans().get(prev.getSourceSpans().size() - 1).getLineIndex();
+                    int firstLine = c.getSourceSpans().get(0).getLineIndex();
+                    if (firstLine > lastLine + 1) {
+                        return true;
+                    }
+                }
+                prev = (Block) c;
+            }
+        }
+        return false;
+    }
+
+    /** A tight list one of whose items has two block children with a blank line between (their spans skip a line). */
+    static boolean tightListWithBlankLineInsideAnItem(Node list) {
+        for (Node item = list.getFirstChild(); item != null; item = item.getNext()) {
+            Block prev = null;
+            for (Node c = item.getFirstChild(); c != null; c = c.getNext()) {
+                if (!(c instanceof Block)) {
+                    continue;
+                }
+                if (prev != null && !prev.getSourceSpans().isEmpty() && !c.getSourceSpans().isEmpty()) {
+                    int lastLine = prev.getSourceSpans().get(prev.getSourceSpans().size() - 1).getLineIndex();
+                    int firstLine = c.getSourceSpans().get(0).getLineIndex();
+                    if (firstLine > lastLine + 1) {
+                        return true;
+                    }
+                }
+                prev = (Block) c;
+            }
+        }
+        return false;
+    }
+}
diff --git a/hegel/src/test/java/zoo/MdGen.java b/hegel/src/test/java/zoo/MdGen.java
new file mode 100644
index 0000000..5255228
--- /dev/null
+++ b/hegel/src/test/java/zoo/MdGen.java
@@ -0,0 +1,472 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.word;
+
+import dev.hegel.TestCase;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Random CommonMark documents: structured ones built from every block and inline construct of the spec (with
+ * deliberate near misses: unclosed fences, lazy continuation lines, unbalanced delimiter runs, tabs, odd
+ * indentation) and unstructured ones drawn from an alphabet of Markdown punctuation. With {@code gfm} the
+ * structured documents also carry tables, strikethrough, task list items, footnotes and alerts.
+ */
+final class MdGen {
+    private MdGen() {}
+
+    static final String WORDS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+    static final String PUNCT = "*_`[]()<>#-+!\\&;:\"' \n\t=~|.,/?{}^$%";
+    static final String UNICODE = "éüß中文😀\u00a0 “”¡—·。ẞ";
+
+    /** A random document (structured or chaotic); a fifth of the documents get CRLF line endings. */
+    static String document(TestCase tc, boolean gfm) {
+        String d;
+        if (chance(tc, 20)) {
+            d = chaos(tc);
+        } else {
+            d = String.join("", blocks(tc, 0, gfm));
+        }
+        if (chance(tc, 10) && d.endsWith("\n")) {
+            d = d.substring(0, d.length() - 1);
+        }
+        if (chance(tc, 10)) {
+            d = d.replace("\n", "\r\n");
+        }
+        return d;
+    }
+
+    static String chaos(TestCase tc) {
+        StringBuilder sb = new StringBuilder();
+        int lines = n(tc, 1, 6);
+        for (int i = 0; i < lines; i++) {
+            int len = n(tc, 0, 30);
+            for (int j = 0; j < len; j++) {
+                int r = n(tc, 0, 9);
+                if (r < 5) {
+                    sb.append(PUNCT.charAt(n(tc, 0, PUNCT.length() - 1)));
+                } else if (r < 9) {
+                    sb.append(WORDS.charAt(n(tc, 0, WORDS.length() - 1)));
+                } else {
+                    sb.append(UNICODE.charAt(n(tc, 0, UNICODE.length() - 1)));
+                }
+            }
+            sb.append('\n');
+        }
+        return sb.toString().replace(":\t", ": ").replace("(\t", "( ").replace("\t)", " )");
+    }
+
+    // ---- blocks -------------------------------------------------------------------------------------------------
+
+    /** Blocks at nesting depth {@code depth}, each a string of complete lines. */
+    static List<String> blocks(TestCase tc, int depth, boolean gfm) {
+        int count = n(tc, 1, depth == 0 ? 5 : 3);
+        List<String> out = new ArrayList<>();
+        for (int i = 0; i < count; i++) {
+            out.add(block(tc, depth, gfm));
+            if (chance(tc, 60)) {
+                out.add("\n");
+            }
+        }
+        return out;
+    }
+
+    static String block(TestCase tc, int depth, boolean gfm) {
+        int r = n(tc, 0, gfm ? 16 : 12);
+        switch (r) {
+            case 0, 1, 2:
+                return paragraph(tc);
+            case 3:
+                return atxHeading(tc);
+            case 4:
+                return setextHeading(tc);
+            case 5:
+                return fencedCode(tc);
+            case 6:
+                return indentedCode(tc);
+            case 7:
+                return thematicBreak(tc);
+            case 8:
+                return htmlBlock(tc);
+            case 9:
+                return linkReferenceDefinition(tc);
+            case 10:
+                return depth < 3 ? blockQuote(tc, depth, gfm) : paragraph(tc);
+            case 11, 12:
+                return depth < 3 ? list(tc, depth, gfm) : paragraph(tc);
+            case 13:
+                return table(tc);
+            case 14:
+                return footnoteDefinition(tc);
+            case 15:
+                return alert(tc, depth, gfm);
+            default:
+                return depth < 3 ? taskList(tc, depth, gfm) : paragraph(tc);
+        }
+    }
+
+    static String paragraph(TestCase tc) {
+        StringBuilder sb = new StringBuilder();
+        int lines = n(tc, 1, 3);
+        for (int i = 0; i < lines; i++) {
+            if (chance(tc, 15)) {
+                sb.append(pick(tc, " ", "  ", "   ", "\t"));
+            }
+            sb.append(inlines(tc, 0));
+            if (i < lines - 1 && chance(tc, 20)) {
+                sb.append(pick(tc, "  ", "\\", "   ", " \\"));
+            }
+            sb.append('\n');
+        }
+        return sb.toString();
+    }
+
+    static String atxHeading(TestCase tc) {
+        StringBuilder sb = new StringBuilder();
+        if (chance(tc, 20)) {
+            sb.append(pick(tc, " ", "   ", "    "));
+        }
+        sb.append("#".repeat(n(tc, 1, 7)));
+        if (chance(tc, 90)) {
+            sb.append(pick(tc, " ", "\t", "  "));
+            sb.append(inlines(tc, 0));
+        }
+        if (chance(tc, 30)) {
+            sb.append(pick(tc, " #", " ###", "#", " # ", " ##\t"));
+        }
+        return sb.append('\n').toString();
+    }
+
+    static String setextHeading(TestCase tc) {
+        return paragraph(tc) + pick(tc, "===", "=", "---", "- - -", "  ===  ", "----\t", "    ===") + "\n";
+    }
+
+    static String fencedCode(TestCase tc) {
+        char fence = pick(tc, '`', '~');
+        int open = n(tc, 3, 5);
+        StringBuilder sb = new StringBuilder();
+        String indent = pick(tc, "", "", " ", "  ", "   ", "    ");
+        sb.append(indent).append(String.valueOf(fence).repeat(open));
+        if (chance(tc, 60)) {
+            sb.append(pick(tc, "", " ")).append(pick(tc, "java", "c++", "ruby startline=3", "`x`", "~", "a&amp;b", "\\`", " x "));
+        }
+        sb.append('\n');
+        int lines = n(tc, 0, 3);
+        for (int i = 0; i < lines; i++) {
+            sb.append(pick(tc, "", " ", "    ", "\t", indent)).append(word(tc, WORDS + " *_<>&`~", 0, 12)).append('\n');
+        }
+        if (chance(tc, 85)) {
+            sb.append(pick(tc, "", indent, "  ", "    ")).append(String.valueOf(fence).repeat(open + n(tc, -1, 2)));
+            if (chance(tc, 15)) {
+                sb.append(pick(tc, " ", "\t", " x"));
+            }
+            sb.append('\n');
+        }
+        return sb.toString();
+    }
+
+    static String indentedCode(TestCase tc) {
+        StringBuilder sb = new StringBuilder();
+        int lines = n(tc, 1, 3);
+        for (int i = 0; i < lines; i++) {
+            sb.append(pick(tc, "    ", "\t", "     ", "  \t", " \t", "        "));
+            sb.append(word(tc, WORDS + " *_<>&`#-", 0, 12)).append('\n');
+            if (chance(tc, 20)) {
+                sb.append(pick(tc, "\n", "  \n", "    \n"));
+            }
+        }
+        return sb.toString();
+    }
+
+    static String thematicBreak(TestCase tc) {
+        char c = pick(tc, '*', '-', '_');
+        StringBuilder sb = new StringBuilder(pick(tc, "", " ", "   "));
+        int count = n(tc, 2, 6);
+        for (int i = 0; i < count; i++) {
+            sb.append(c).append(pick(tc, "", "", " ", "\t", "  "));
+        }
+        return sb.append('\n').toString();
+    }
+
+    static String htmlBlock(TestCase tc) {
+        switch (n(tc, 0, 7)) {
+            case 0:
+                return "<pre>\n" + word(tc, WORDS + " *_<>&", 0, 12) + "\n</pre>\n";
+            case 1:
+                return "<!-- " + word(tc, WORDS + " -", 0, 8) + " -->\n";
+            case 2:
+                return "<?php " + word(tc, WORDS, 0, 8) + " ?>\n";
+            case 3:
+                return "<!DOCTYPE html>\n";
+            case 4:
+                return "<![CDATA[" + word(tc, WORDS + " ]", 0, 8) + "]]>\n";
+            case 5:
+                return pick(tc, "<div>", "<div class=\"a\">", "</div>", "<table><tr><td>", "<DIV>", "<div\n", "<hr/>") + "\n"
+                    + word(tc, WORDS + " *_", 0, 10) + "\n" + pick(tc, "</div>\n", "", "\n");
+            case 6:
+                return pick(tc, "<a href=\"x\">", "<a  href='x'  >", "<span>", "</span>", "<a/>", "<a href=x", "<a")
+                    + pick(tc, "\n", " \n", "x\n") + word(tc, WORDS + " *", 0, 10) + "\n";
+            default:
+                return "<script>\n" + word(tc, WORDS + " <>&", 0, 10) + "\n</script>\n";
+        }
+    }
+
+    static String linkReferenceDefinition(TestCase tc) {
+        StringBuilder sb = new StringBuilder(pick(tc, "", "", " ", "   ", "    "));
+        sb.append('[').append(label(tc)).append("]:");
+        // commonmark.js knows no tabs between the parts of a definition (its spnl matches spaces only), so none here
+        sb.append(pick(tc, " ", "", "  ", "\n", "\n  ", "   "));
+        sb.append(destination(tc));
+        if (chance(tc, 50)) {
+            sb.append(pick(tc, " ", "\n", "  \n  ", "   ")).append(title(tc));
+        }
+        if (chance(tc, 15)) {
+            sb.append(pick(tc, " x", "  ", " "));
+        }
+        return sb.append('\n').toString();
+    }
+
+    static String label(TestCase tc) {
+        return pick(tc, "foo", "Foo", "FOO", "foo bar", "foo  bar", "ß", "SS", "a\\]b", "a*b*", "ẞ", "a\nb", " x ", "1", "*", "bar");
+    }
+
+    static String destination(TestCase tc) {
+        return pick(tc, "/url", "http://a.b/c?d=e&f=g", "<a b>", "<>", "", "a(b)c", "a(b", "a\\)b", "é/x y", "/%20/é", "javascript:alert(1)",
+            "data:text/html,x", "#frag", "mailto:a@b.c", "a\\*b", "http://a.b/é%zz", "<a\\>b>", "url with space", "vbscript:x", "FILE:x");
+    }
+
+    static String title(TestCase tc) {
+        return pick(tc, "\"t\"", "'t'", "(t)", "\"a \\\" b\"", "'a \"b\" c'", "\"a\nb\"", "\"&copy;\"", "\"\"", "\"a'b\"", "(a(b)c)", "\"x", "\"*a*\"");
+    }
+
+    static String blockQuote(TestCase tc, int depth, boolean gfm) {
+        StringBuilder sb = new StringBuilder();
+        for (String b : blocks(tc, depth + 1, gfm)) {
+            String[] lines = b.split("\n", -1);
+            for (int i = 0; i < lines.length - 1; i++) {
+                String l = lines[i];
+                if (i > 0 && chance(tc, 15)) {
+                    sb.append(l).append('\n'); // lazy continuation (or not)
+                } else {
+                    sb.append(pick(tc, "> ", ">", ">  ", " > ", ">\t", "   >")).append(l).append('\n');
+                }
+            }
+        }
+        return sb.toString();
+    }
+
+    static String list(TestCase tc, int depth, boolean gfm) {
+        boolean ordered = chance(tc, 40);
+        String bullet = pick(tc, "-", "*", "+");
+        int start = pick(tc, 1, 1, 0, 2, 9, 10, 123456789, 1234567890);
+        String delim = pick(tc, ".", ")");
+        boolean sameNumber = chance(tc, 30);
+        int items = n(tc, 1, 4);
+        StringBuilder sb = new StringBuilder();
+        for (int k = 0; k < items; k++) {
+            String marker;
+            if (ordered) {
+                marker = (sameNumber ? start : start + k) + delim;
+            } else {
+                marker = chance(tc, 10) ? pick(tc, "-", "*", "+") : bullet;
+            }
+            String gap = pick(tc, " ", " ", "  ", "   ", "    ", "     ", "\t");
+            String first = marker + gap;
+            String cont = " ".repeat(Math.min(first.length(), 6));
+            if (chance(tc, 10)) {
+                cont = pick(tc, "", " ", "  ", "\t", "      ");
+            }
+            List<String> bs = chance(tc, 10) ? List.of("\n") : blocks(tc, depth + 1, gfm);
+            boolean firstLine = true;
+            for (String b : bs) {
+                String[] lines = b.split("\n", -1);
+                for (int i = 0; i < lines.length - 1; i++) {
+                    String l = lines[i];
+                    if (firstLine) {
+                        sb.append(pick(tc, "", "", " ", "  ", "   ")).append(first).append(l).append('\n');
+                        firstLine = false;
+                    } else if (l.isEmpty()) {
+                        sb.append(pick(tc, "", cont)).append('\n');
+                    } else {
+                        sb.append(chance(tc, 10) ? "" : cont).append(l).append('\n');
+                    }
+                }
+            }
+            if (chance(tc, 30)) {
+                sb.append('\n');
+            }
+        }
+        return sb.toString();
+    }
+
+    // ---- GFM blocks ---------------------------------------------------------------------------------------------
+
+    static String table(TestCase tc) {
+        int cols = n(tc, 1, 4);
+        StringBuilder sb = new StringBuilder();
+        boolean leading = chance(tc, 80);
+        boolean trailing = chance(tc, 80);
+        sb.append(row(tc, cols, leading, trailing, true)).append('\n');
+        StringBuilder d = new StringBuilder(leading ? "|" : "");
+        for (int c = 0; c < cols; c++) {
+            if (c > 0) {
+                d.append('|');
+            }
+            d.append(pick(tc, "", " ")).append(pick(tc, "---", ":--", "--:", ":-:", "-", ":-", "-:", "   ---   ", "--- --")).append(pick(tc, "", " "));
+        }
+        if (trailing) {
+            d.append('|');
+        }
+        sb.append(d).append('\n');
+        int rows = n(tc, 0, 3);
+        for (int r = 0; r < rows; r++) {
+            sb.append(row(tc, chance(tc, 20) ? n(tc, 0, cols + 1) : cols, leading, trailing, false)).append('\n');
+        }
+        return sb.toString();
+    }
+
+    static String row(TestCase tc, int cols, boolean leading, boolean trailing, boolean header) {
+        StringBuilder sb = new StringBuilder(leading ? "|" : "");
+        for (int c = 0; c < cols; c++) {
+            if (c > 0) {
+                sb.append('|');
+            }
+            sb.append(pick(tc, "", " ", "  "));
+            sb.append(pick(tc, "a", "b c", "*e*", "`x|y`", "a\\|b", "", "中文", "![i](u)", "[l](u)", "\\\\", "`", "x  ", "&amp;", "<b>x</b>", "a\\\\|b"));
+            sb.append(pick(tc, "", " ", "  "));
+        }
+        if (trailing) {
+            sb.append('|');
+        }
+        return sb.toString();
+    }
+
+    static String footnoteDefinition(TestCase tc) {
+        StringBuilder sb = new StringBuilder("[^").append(pick(tc, "1", "a", "A", "note", "a b", "x\\]y", "é")).append("]:");
+        sb.append(pick(tc, " ", "", "  ", "\t"));
+        sb.append(inlines(tc, 0)).append('\n');
+        if (chance(tc, 30)) {
+            sb.append(pick(tc, "\n    ", "    ", "\n  ", "\t")).append(inlines(tc, 0)).append('\n');
+        }
+        return sb.toString();
+    }
+
+    static String alert(TestCase tc, int depth, boolean gfm) {
+        StringBuilder sb = new StringBuilder("> [!").append(pick(tc, "NOTE", "TIP", "IMPORTANT", "WARNING", "CAUTION", "note", "Warning", "OTHER", "")).append(']');
+        if (chance(tc, 20)) {
+            sb.append(pick(tc, " ", " x", "\t", "]"));
+        }
+        sb.append('\n');
+        if (chance(tc, 80)) {
+            sb.append(blockQuote(tc, depth, gfm));
+        }
+        return sb.toString();
+    }
+
+    static String taskList(TestCase tc, int depth, boolean gfm) {
+        int items = n(tc, 1, 3);
+        StringBuilder sb = new StringBuilder();
+        for (int k = 0; k < items; k++) {
+            sb.append(pick(tc, "- ", "* ", "1. ", "-  ", "-\t"));
+            sb.append(pick(tc, "[ ]", "[x]", "[X]", "[]", "[ ] ", "[x]x", "[ ]\t", "[-]", "[  ]"));
+            sb.append(pick(tc, " ", "", "  "));
+            sb.append(inlines(tc, 0)).append('\n');
+            if (chance(tc, 25)) {
+                sb.append("  ").append(inlines(tc, 0)).append('\n');
+            }
+        }
+        return sb.toString();
+    }
+
+    // ---- inlines -----------------------------------------------------------------------------------------------
+
+    /** A line's worth of inline content (no newlines except inside constructs that allow them). */
+    static String inlines(TestCase tc, int depth) {
+        int count = n(tc, 0, depth == 0 ? 5 : 3);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < count; i++) {
+            sb.append(inline(tc, depth));
+            if (chance(tc, 50)) {
+                sb.append(' ');
+            }
+        }
+        if (sb.length() == 0) {
+            sb.append(word(tc, WORDS, 1, 6));
+        }
+        return sb.toString();
+    }
+
+    static String inline(TestCase tc, int depth) {
+        int r = n(tc, 0, 21);
+        switch (r) {
+            case 0, 1, 2, 3, 4:
+                return word(tc, WORDS, 1, 8);
+            case 5:
+                return word(tc, WORDS + UNICODE, 1, 6);
+            case 6, 7: {
+                String d = pick(tc, "*", "_", "**", "__", "***", "___", "*", "_");
+                String close = chance(tc, 85) ? d : pick(tc, "*", "_", "**", "__", "");
+                String inner = depth < 3 ? inlines(tc, depth + 1) : word(tc, WORDS, 1, 5);
+                if (chance(tc, 20)) {
+                    inner = pick(tc, " ", "", ".", "\u00a0", "“") + inner;
+                }
+                if (chance(tc, 20)) {
+                    inner = inner + pick(tc, " ", ".", ",", "—", "¡");
+                }
+                return d + inner + close;
+            }
+            case 8: {
+                String ticks = "`".repeat(n(tc, 1, 3));
+                String content = pick(tc, "code", " code ", "`", "``", "a ` b", "  ", "", "\\", "&amp;", "<b>", "a\nb", "* *", "é\t");
+                return ticks + content + (chance(tc, 90) ? ticks : "`".repeat(n(tc, 1, 4)));
+            }
+            case 9, 10: {
+                String text = depth < 3 ? inlines(tc, depth + 1) : word(tc, WORDS, 1, 5);
+                if (chance(tc, 15)) {
+                    text = pick(tc, "", "*a*", "`]`", "\\]", "[x]", "![i](u)", "<b>]</b>", "a\nb");
+                }
+                switch (n(tc, 0, 4)) {
+                    case 0:
+                        return "[" + text + "](" + pick(tc, "", "", " ", "\n") + destination(tc) + (chance(tc, 40) ? pick(tc, " ", "  ", "\n") + title(tc) : "") + pick(tc, "", " ", "\n") + ")";
+                    case 1:
+                        return "[" + text + "][" + label(tc) + "]";
+                    case 2:
+                        return "[" + text + "]" + pick(tc, "", "[]", " []", "(", "( )", "[ ]");
+                    case 3:
+                        return "![" + text + "](" + destination(tc) + (chance(tc, 40) ? " " + title(tc) : "") + ")";
+                    default:
+                        return "[" + label(tc) + "]";
+                }
+            }
+            case 11:
+                return pick(tc, "<http://a.b/c?d=e&f>", "<https://x.y/é>", "<a@b.c>", "<mailto:a@b.c>", "<a.b-c@d.e>", "<http://a b>", "<ftp://a.b:21/x\\y>", "<MAILTO:A@B.C>",
+                    "<x:y>", "<xy:>", "<a@b>", "<a@b.>", "<1http://x>", "<http://[::1]>", "<irc6://a>", "<made-up-scheme://a,b>", "<a+b-c.d@e.f>");
+            case 12:
+                return pick(tc, "<b>", "</b>", "<a href=\"x\">", "<a href='x' b>", "<br/>", "<br />", "<!-- x -->", "<!---->", "<?x?>", "<!X y>", "<![CDATA[x]]>", "<a b=c>",
+                    "<a b= c>", "<a b=\"c\ne\">", "<A>", "<1>", "<a\n>", "<-a>", "<a-b>", "<a_b>", "<a:b>", "<a b=\"x\"c>", "<a />", "<!-- -- -->", "<!--->", "<!--x-->y");
+            case 13:
+                return pick(tc, "&amp;", "&lt;", "&gt;", "&quot;", "&copy;", "&AElig;", "&ouml;", "&#35;", "&#1234;", "&#x1F600;", "&#0;", "&#X22;", "&#xD800;", "&#99999999;",
+                    "&#1234567;", "&#;", "&#x;", "&foo;", "&Ncaron;", "&ngE;", "&nbsp;", "&#x110000;", "&#00000000000000000000035;", "&amp", "&; ", "&#x0;");
+            case 14:
+                return "\\" + pick(tc, "*", "_", "`", "\\", "[", "]", "(", ")", "#", "!", "&", "<", ">", "|", "~", "a", " ", "é", "\"", "'", "-", ".", "+", "{", "}", "$");
+            case 15:
+                return pick(tc, "  \n", "\\\n", "\n", " \n", "   \n", "\t\n", "\\\\\n", "  \\\n");
+            case 16:
+                return pick(tc, "*", "**", "_", "__", "`", "[", "]", "!", "![", "](", "<", ">", "&", "\\", "~~", "~", "***", "_*", "*_", "`` ` ``");
+            case 17:
+                return pick(tc, "~~", "~") + word(tc, WORDS + " ", 1, 6) + pick(tc, "~~", "~", "~~~", "");
+            case 18:
+                return pick(tc, "[^1]", "[^a]", "[^note]", "[^x]", "^[inline note]", "[^]", "[^ ]", "[^1]:", "[^a b]");
+            case 19:
+                return pick(tc, "http://a.b/c", "www.a.b/c.", "www.a.b/c)", "(www.a.b)", "a@b.c", "a@b.c.", "https://a.b/c_(d)", "www.a.b/c&amp;", "http://a.b/é", "www.a", "ftp://a.b");
+            case 20:
+                return pick(tc, "++", "+", "++x++", "++x+", "{width=10}", "{height=2 width=3}", "{x}", "{width=\"a\"}", "{}", "{ width=1 }",
+                    "![i](u){width=10}", "![i](u){height=2 width=3}", "![i](u){ width=1 }", "![i](u){width=1 x=2}", "![i](u){width=1=2}");
+            default:
+                return word(tc, PUNCT.replace("\n", ""), 1, 4);
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/RoundTripTest.java b/hegel/src/test/java/zoo/RoundTripTest.java
new file mode 100644
index 0000000..d9e492c
--- /dev/null
+++ b/hegel/src/test/java/zoo/RoundTripTest.java
@@ -0,0 +1,67 @@
+package zoo;
+
+import static zoo.Zoo.check;
+import static zoo.Zoo.show;
+
+import java.util.List;
+import org.commonmark.Extension;
+import org.commonmark.ext.front.matter.YamlFrontMatterExtension;
+import org.commonmark.ext.gfm.alerts.AlertsExtension;
+import org.commonmark.ext.gfm.strikethrough.StrikethroughExtension;
+import org.commonmark.ext.gfm.tables.TablesExtension;
+import org.commonmark.ext.ins.InsExtension;
+import org.commonmark.ext.footnotes.FootnotesExtension;
+import org.commonmark.ext.task.list.items.TaskListItemsExtension;
+import org.commonmark.node.Node;
+import org.commonmark.parser.IncludeSourceSpans;
+import org.commonmark.parser.Parser;
+import org.commonmark.renderer.html.HtmlRenderer;
+import org.commonmark.renderer.markdown.MarkdownRenderer;
+import org.junit.jupiter.api.Test;
+
+/**
+ * The Markdown renderer against the parser: rendering a parsed document back to Markdown and parsing that must give
+ * the same document (compared through the HTML renderer, which prints every field the tree carries), and rendering
+ * it once more must reproduce the same Markdown (the renderer's output is a fixed point).
+ */
+class RoundTripTest {
+
+    static final List<Extension> GFM = List.of(TablesExtension.create(), StrikethroughExtension.create(),
+        TaskListItemsExtension.create(), FootnotesExtension.create(), AlertsExtension.create(), InsExtension.create(),
+        YamlFrontMatterExtension.create());
+
+    static final Parser CORE = Parser.builder().includeSourceSpans(IncludeSourceSpans.BLOCKS).build();
+    static final HtmlRenderer CORE_HTML = HtmlRenderer.builder().build();
+    static final MarkdownRenderer CORE_MD = MarkdownRenderer.builder().build();
+
+    static final Parser GFM_PARSER = Parser.builder().includeSourceSpans(IncludeSourceSpans.BLOCKS).extensions(GFM).build();
+    static final HtmlRenderer GFM_HTML = HtmlRenderer.builder().extensions(GFM).build();
+    static final MarkdownRenderer GFM_MD = MarkdownRenderer.builder().extensions(GFM).build();
+
+    @Test
+    void markdownRendererRoundTrips() {
+        Zoo.property("commonmark-java.markdownRendererRoundTrips", tc -> roundTrip(MdGen.document(tc, false), CORE, CORE_HTML, CORE_MD));
+    }
+
+    @Test
+    void markdownRendererRoundTripsWithExtensions() {
+        Zoo.property("commonmark-java.markdownRendererRoundTripsWithExtensions", tc -> roundTrip(MdGen.document(tc, true), GFM_PARSER, GFM_HTML, GFM_MD));
+    }
+
+    static void roundTrip(String md, Parser parser, HtmlRenderer html, MarkdownRenderer renderer) {
+        Node doc = parser.parse(md);
+        if (Known.roundTrip(md, doc)) {
+            return;
+        }
+        String html1 = html.render(doc);
+        String md2 = renderer.render(doc);
+        Node doc2 = parser.parse(md2);
+        String html2 = html.render(doc2);
+        if (!html1.equals(html2)) {
+            Zoo.fail("Markdown rendering changed the document " + show(md) + "\n  rendered " + show(md2) + "\n  HTML before " + show(html1) + "\n  HTML after  " + show(html2));
+            return;
+        }
+        String md3 = renderer.render(doc2);
+        check(md3.equals(md2), () -> "Markdown rendering is not a fixed point for " + show(md) + "\n  first  " + show(md2) + "\n  second " + show(md3));
+    }
+}
diff --git a/hegel/src/test/java/zoo/SpansTest.java b/hegel/src/test/java/zoo/SpansTest.java
