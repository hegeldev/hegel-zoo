+
+    static Generator<Inline> lit(List<String> texts) {
+        return sampledFrom(texts).map(Lit::new);
+    }
+
+    static List<String> without(List<String> texts, Predicate<String> shape) {
+        return texts.stream().filter(shape.negate()).toList();
+    }
+
+    static <T> List<T> concat(List<? extends T> a, List<? extends T> b) {
+        List<T> out = new ArrayList<>(a);
+        out.addAll(b);
+        return out;
+    }
+
+    /**
+     * The generators of one flavour: an inline ladder of four nesting depths, a block ladder of four container
+     * depths (block quotes, lists and task lists give way to paragraphs at the bottom; an alert there has no body),
+     * and the document: structured (80%) or chaos, a tenth without the final line ending, a tenth with CRLF endings.
+     *
+     * <p>The round-trip flavour keeps the shapes of the Markdown renderer's recorded bugs out of the documents, so
+     * that {@link Known#roundTrip} rejects a few cases instead of two in five. Single-character emphasis delimiters
+     * and no emphasis inside emphasis (bugs 15, 16); line breaks glued to a word, and none with spaces before the
+     * backslash (13, 45); one-digit list numbers (22); a letter before a leading {@code +}, no {@code +} or
+     * {@code ~} among the escapes, punctuation words and chaos characters (21, 23); fence info strings without
+     * fence characters or {@code &} (7, 14, 24); destinations and autolinks without {@code &} (24); a letter before
+     * an entity (20); one-line raw HTML (17); definitions and HTML blocks at the top level only (49, 2); list items
+     * whose non-paragraph blocks lose their trailing blank lines (1) and do not start with a thematic break (19),
+     * indented at their content column with the list's bullet, never {@code +} (1, 21); no tab-indented paragraph
+     * line or four-space-indented fence (1, 23); table cells without backslashes (47).
+     */
+    static final class Grammar {
+        final Flavour f;
+
+        final Generator<String> dest;
+        final Generator<Inline> autolink;
+        final Generator<Inline> rawHtml;
+        final Generator<Inline> entity;
+        final Generator<Inline> escape;
+        final Generator<Inline> lineBreak;
+        final Generator<Inline> stray;
+        final Generator<Inline> ins;
+        final Generator<Inline> punct;
+        final Generator<Inline> codeSpan;
+        final Generator<Inline> strike;
+        final Generator<Block> html;
+        final Generator<Rule> rule;
+        final Generator<Inline> footnoteRef;
+        final Generator<Indented> indented;
+
+        /** Inline content of a paragraph line, heading, footnote or task item. */
+        final Generator<Inlines> inlines;
+
+        final Generator<Doc> document;
+
+        Grammar(Flavour f) {
+            this.f = f;
+            boolean rt = f.roundTrip;
+            // the round trip: no & (bug 24) and no empty destination (with a title, bug 51)
+            dest = sampledFrom(rt ? without(DESTS, d -> d.contains("&") || d.isEmpty() || d.equals("<>")) : DESTS);
