+final class MdGen {
+    private MdGen() {}
+
+    /** Which properties the documents are for: with the GFM blocks, and shaped for the Markdown round trip. */
+    record Flavour(boolean gfm, boolean roundTrip) {}
+
+    static final String WORDS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
