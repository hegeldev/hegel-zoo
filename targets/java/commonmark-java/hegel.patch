+            // the round trip: one-line tags (bug 17), after a word (a line holding a tag alone opens an HTML block, which
+            // runs on into the blocks below and their tabs, bug 2)
+            rawHtml = rt
+                ? tuples(word(WORDS, 1, 2), sampledFrom(without(RAW_HTMLS, h -> h.contains("\n")))).map(t -> new Lit(t.value1() + t.value2()))
