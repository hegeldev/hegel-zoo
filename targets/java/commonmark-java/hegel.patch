+
+    // ---- YAML front matter --------------------------------------------------------------------------------------
+
+    static final Parser YAML = Parser.builder().extensions(List.of(YamlFrontMatterExtension.create())).build();
+    static final HtmlRenderer PLAIN = HtmlRenderer.builder().build();
+
+    /** A value and the quote around it ("" for none). */
+    record Quoted(String value, String quote) {
+        String render() {
+            return quote + value + quote;
+        }
+    }
+
+    /** An entry of the front matter: a key alone, a scalar, or a list of indented items. */
+    sealed interface Entry permits Empty, Scalar, Items {
+        String key();
+
+        List<String> values();
+
+        String render();
+    }
+
+    record Empty(String key) implements Entry {
+        @Override
+        public List<String> values() {
+            return List.of();
+        }
+
+        @Override
+        public String render() {
+            return key + ":\n";
+        }
+    }
+
+    record Scalar(String key, String sep, Quoted value) implements Entry {
+        @Override
+        public List<String> values() {
+            return List.of(value.value());
+        }
+
+        @Override
+        public String render() {
+            return key + ":" + sep + value.render() + "\n";
+        }
+    }
+
+    /** A list item written the README's way: indented, with a dash. */
+    record YamlItem(String indent, Quoted value) {}
+
+    /**
+     * A list of one to three items (the subset parser knows no flow sequences, "[a, b]" stays one value, and no
+     * unindented "- item" lines).
+     */
+    record Items(String key, List<YamlItem> items) implements Entry {
+        @Override
+        public List<String> values() {
+            return items.stream().map(i -> i.value().value()).toList();
+        }
+
+        @Override
+        public String render() {
+            StringBuilder sb = new StringBuilder(key).append(":\n");
+            for (YamlItem i : items) {
+                sb.append(i.indent()).append(i.value().render()).append('\n');
+            }
+            return sb.toString();
+        }
+    }
+
+    /** A front matter block: up to four entries between "---" and its closer. */
+    record FrontMatter(List<Entry> entries, String closer) {
+        String render() {
+            StringBuilder sb = new StringBuilder("---\n");
+            for (Entry e : entries) {
+                sb.append(e.render());
+            }
+            return sb.append(closer).append('\n').toString();
+        }
+
+        /** The map the parser must produce: a repeated key keeps its last values. */
+        Map<String, List<String>> expected() {
+            Map<String, List<String>> m = new LinkedHashMap<>();
+            for (Entry e : entries) {
+                m.put(e.key(), e.values());
+            }
+            return m;
+        }
+    }
+
+    /** A document: front matter (85%) and a body (80%). */
+    record YamlCase(FrontMatter frontMatter, Doc body) {
+        String render() {
+            return (frontMatter == null ? "" : frontMatter.render()) + bodyText();
+        }
+
+        String bodyText() {
+            return body == null ? "" : body.render();
+        }
+    }
+
+    static final Generator<String> KEY = word("abcxyzXYZ019_.-", 1, 6);
+    static final Generator<Quoted> QUOTED = tuples(word("abcXYZ019_.-/", 1, 8), sampledFrom("", "", "\"", "'")).map(t -> new Quoted(t.value1(), t.value2()));
+    static final Generator<YamlItem> YAML_ITEM = tuples(sampledFrom("  - ", "    - ", "   - "), QUOTED).map(t -> new YamlItem(t.value1(), t.value2()));
+
+    /** An entry: a key alone one time in five, a scalar (the separator a space, or none, two, or a tab) or a list two each. */
+    static final Generator<Entry> ENTRY = KEY.flatMap(key -> weighted(
+        w(1, Gen.<Entry>widen(dev.hegel.Generators.just(new Empty(key)))),
+        w(2, tuples(sampledFrom(" ", " ", " ", "", "  ", "\t"), QUOTED).map(t -> new Scalar(key, t.value1(), t.value2()))),
+        w(2, lists(YAML_ITEM).minSize(1).maxSize(3).map(items -> new Items(key, items)))));
+
+    static final Generator<FrontMatter> FRONT_MATTER = tuples(lists(ENTRY).maxSize(4), sampledFrom("---", "---", "...")).map(t -> new FrontMatter(t.value1(), t.value2()));
+
+    /** The extension's opener ({@code REGEX_BEGIN} of its block parser): three dashes at column 0, then whitespace or nothing. */
+    static final Pattern FRONT_MATTER_OPENER = Pattern.compile("-{3}(\\s.*)?");
+
+    static final Generator<YamlCase> YAML_CASE =tuples(maybe(85, (FrontMatter) null, FRONT_MATTER), maybe(80, (Doc) null, MdGen.CORE)).map(t -> new YamlCase(t.value1(), t.value2()));
+
+    /** YAML front matter: the documented subset (key: value, indented "- item" lists, quoted values) against a model. */
+    @Test
+    void yamlFrontMatterMatchesTheModel() {
+        Zoo.property("commonmark-java.yamlFrontMatterMatchesTheModel", tc -> {
+            YamlCase c = tc.draw(YAML_CASE, "case");
+            Map<String, List<String>> expected = c.frontMatter() == null ? Map.of() : c.frontMatter().expected();
+            String md = c.render();
+            // recorded bug 29: without front matter, a body whose first line is "---" (a thematic break) opens a
+            // front matter block that is never closed and swallows the document
+            tc.assume(c.frontMatter() != null || !FRONT_MATTER_OPENER.matcher(md.lines().findFirst().orElse("")).matches());
+            Node doc = YAML.parse(md);
+            Map<String, List<String>> data = YamlFrontMatterVisitor.readData(doc);
+            check(data.equals(expected), () -> "front matter of " + show(md) + "\n  expected " + expected + "\n  actual   " + data);
+            // the rest of the document parses as without the front matter
+            String rest = PLAIN.render(doc);
+            String restWithout = PLAIN.render(CoreTest.PARSER.parse(c.bodyText()));
+            check(rest.equals(restWithout), () -> "the document after the front matter " + show(md) + " renders as " + show(rest) + " but the body alone as " + show(restWithout));
+        });
+    }
+
+    // ---- tables -------------------------------------------------------------------------------------------------
+
+    static final Pattern CELL = Pattern.compile("<(th|td)(?: align=\"(left|center|right)\")?>(.*?)</\\1>", Pattern.DOTALL);
+
+    /** A body cell: its text, and whether it is written empty instead (where an empty cell is allowed). */
+    record BodyCell(String text, boolean empty) {}
+
+    /** A well-formed table: pipes at the edges (70% each), header cells, one delimiter per column, up to three body rows. */
+    record TableCase(boolean leading, boolean trailing, List<String> header, List<Delim> delims, List<List<BodyCell>> rows) {
+        int cols() {
+            return header.size();
+        }
+
+        /**
+         * The text of a body cell: without a leading pipe the first cell must not be empty (an empty one would read
+         * as the leading pipe), and a single-column row of "|" alone is a dangling pipe that ends the table.
+         */
+        String text(int c, BodyCell cell) {
+            return cell.empty() && (leading || c > 0) && cols() > 1 ? "" : cell.text();
+        }
+
+        List<List<String>> rowTexts() {
+            List<List<String>> out = new ArrayList<>();
+            for (List<BodyCell> row : rows) {
+                List<String> texts = new ArrayList<>();
+                for (int c = 0; c < row.size(); c++) {
+                    texts.add(text(c, row.get(c)));
+                }
+                out.add(texts);
+            }
+            return out;
+        }
+
+        String render() {
+            StringBuilder sb = new StringBuilder();
+            sb.append(open());
+            for (int c = 0; c < cols(); c++) {
+                sb.append(c > 0 ? "|" : "").append(' ').append(header.get(c)).append(' ');
+            }
+            sb.append(close()).append('\n').append(open());
+            for (int c = 0; c < cols(); c++) {
+                sb.append(c > 0 ? "|" : "").append(delims.get(c).render());
+            }
+            sb.append(close()).append('\n');
+            for (List<String> row : rowTexts()) {
+                sb.append(open());
+                for (int c = 0; c < cols(); c++) {
+                    sb.append(c > 0 ? "|" : "").append(' ').append(row.get(c)).append(' ');
+                }
+                sb.append(close()).append('\n');
+            }
+            return sb.toString();
+        }
+
+        private String open() {
+            return leading ? "|" : "";
+        }
+
+        private String close() {
+            return trailing || cols() == 1 && !leading ? "|" : "";
+        }
+    }
+
+    /** Cells start with a letter or digit (a cell is inline content; "*" alone would be a list in a paragraph model). */
+    static final Generator<String> CELL_TEXT = tuples(word("abcXYZ019", 1, 1), word("abc XYZ019*_`", 0, 5)).map(t -> t.value1() + t.value2());
+    static final Generator<BodyCell> BODY_CELL = tuples(CELL_TEXT, chance(20)).map(t -> new BodyCell(t.value1(), t.value2()));
+    static final Generator<Delim> DELIM = tuples(sampledFrom("", " "), sampledFrom("---", ":--", "--:", ":-:", "-", ":-", "-:", "------"), sampledFrom("", " "))
+        .map(t -> new Delim(t.value1(), t.value2(), t.value3()));
+
+    static final Generator<TableCase> TABLE_CASE = ints(1, 5).flatMap(cols -> tuples(chance(70), chance(70), lists(CELL_TEXT).minSize(cols).maxSize(cols),
+            lists(DELIM).minSize(cols).maxSize(cols), lists(lists(BODY_CELL).minSize(cols).maxSize(cols)).maxSize(3))
+        .map(t -> new TableCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5())));
+
+    /** A well-formed GFM table (header, delimiter row, body rows) renders every cell with its alignment. */
+    @Test
+    void tablesRenderTheirCells() {
+        Zoo.property("commonmark-java.tablesRenderTheirCells", tc -> {
+            TableCase c = tc.draw(TABLE_CASE, "table");
+            int cols = c.cols();
+            List<List<String>> rows = c.rowTexts();
+            String md = c.render();
+            String html = HTML.render(PARSER.parse(md));
+            List<String> problems = new ArrayList<>();
+            if (!html.startsWith("<table>")) {
+                problems.add("not a table: " + show(html));
+            } else {
+                Matcher m = CELL.matcher(html);
+                int i = 0;
+                int total = cols * (1 + rows.size());
+                while (m.find()) {
+                    int r = i / cols;
+                    int col = i % cols;
+                    String tag = r == 0 ? "th" : "td";
+                    if (!m.group(1).equals(tag)) {
+                        problems.add("cell " + i + " is <" + m.group(1) + ">, expected <" + tag + ">");
+                    }
+                    String align = m.group(2);
+                    String want = c.delims().get(col).align();
+                    if (want == null ? align != null : !want.equals(align)) {
+                        problems.add("cell " + i + " aligned " + align + ", expected " + want);
+                    }
+                    String text = (r == 0 ? c.header().get(col) : rows.get(r - 1).get(col)).trim();
+                    String plainCell = PLAIN.render(Parser.builder().build().parse(text)).replaceAll("^<p>|</p>\\n$", "");
+                    if (!m.group(3).equals(plainCell)) {
+                        problems.add("cell " + i + " rendered " + show(m.group(3)) + ", expected " + show(plainCell));
+                    }
+                    i++;
+                }
+                if (i != total) {
+                    problems.add(i + " cells rendered, expected " + total);
+                }
+            }
+            check(problems.isEmpty(), () -> "table " + show(md) + " → " + show(html) + "\n  " + String.join("\n  ", problems));
+        });
+    }
+}
