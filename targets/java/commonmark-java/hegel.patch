index 0000000..267466d
--- /dev/null
+++ b/hegel/src/test/java/zoo/SpansTest.java
@@ -0,0 +1,223 @@
+package zoo;
+
+import static zoo.Zoo.check;
+import static zoo.Zoo.show;
+
+import java.io.StringReader;
+import java.util.ArrayList;
+import java.util.List;
+import org.commonmark.node.Block;
+import org.commonmark.node.BlockQuote;
+import org.commonmark.node.Code;
+import org.commonmark.node.Document;
+import org.commonmark.node.Emphasis;
+import org.commonmark.node.FencedCodeBlock;
+import org.commonmark.node.HardLineBreak;
+import org.commonmark.node.Heading;
+import org.commonmark.node.HtmlBlock;
+import org.commonmark.node.HtmlInline;
+import org.commonmark.node.Image;
+import org.commonmark.node.IndentedCodeBlock;
+import org.commonmark.node.Link;
+import org.commonmark.node.LinkReferenceDefinition;
+import org.commonmark.node.ListItem;
+import org.commonmark.node.Node;
+import org.commonmark.node.Paragraph;
+import org.commonmark.node.SoftLineBreak;
+import org.commonmark.node.SourceSpan;
+import org.commonmark.node.StrongEmphasis;
+import org.commonmark.node.Text;
+import org.commonmark.node.ThematicBreak;
+import org.commonmark.parser.IncludeSourceSpans;
+import org.commonmark.parser.Parser;
+import org.commonmark.renderer.html.HtmlRenderer;
+import org.junit.jupiter.api.Test;
+
+/** Source spans against the input text, and the Reader entry point against the String one. */
+class SpansTest {
+
+    static final Parser SPANS = Parser.builder().includeSourceSpans(IncludeSourceSpans.BLOCKS_AND_INLINES).build();
+    static final Parser PLAIN = Parser.builder().build();
+    static final HtmlRenderer HTML = HtmlRenderer.builder().build();
+
+    @Test
+    void sourceSpansPointIntoTheInput() {
+        Zoo.property("commonmark-java.sourceSpansPointIntoTheInput", tc -> {
+            String md = MdGen.document(tc, false);
+            Node doc = SPANS.parse(md);
+            // the same tree as without spans
+            String html = HTML.render(doc);
+            String plain = HTML.render(PLAIN.parse(md));
+            check(html.equals(plain), () -> "including source spans changed the document " + show(md) + "\n  with    " + show(html) + "\n  without " + show(plain));
+            List<Integer> lineStarts = lineStarts(md);
+            List<String> problems = new ArrayList<>();
+            walk(doc, md, lineStarts, problems);
+            check(problems.isEmpty(), () -> "source spans of " + show(md) + ":\n  " + String.join("\n  ", problems));
+        });
+    }
+
+    @Test
+    void readerAndStringParseAlike() {
+        Zoo.property("commonmark-java.readerAndStringParseAlike", tc -> {
+            String md = MdGen.document(tc, false);
+            String fromString = HTML.render(PLAIN.parse(md));
+            String fromReader = HTML.render(PLAIN.parseReader(new StringReader(md)));
+            check(fromString.equals(fromReader), () -> "parseReader differs from parse for " + show(md) + "\n  string " + show(fromString) + "\n  reader " + show(fromReader));
+        });
+    }
+
+    static List<Integer> lineStarts(String s) {
+        List<Integer> starts = new ArrayList<>();
+        starts.add(0);
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '\n') {
+                starts.add(i + 1);
+            } else if (c == '\r') {
+                if (i + 1 < s.length() && s.charAt(i + 1) == '\n') {
+                    i++;
+                }
+                starts.add(i + 1);
+            }
+        }
+        return starts;
+    }
+
+    static void walk(Node node, String md, List<Integer> lineStarts, List<String> problems) {
+        List<SourceSpan> spans = node.getSourceSpans();
+        String kind = node.getClass().getSimpleName();
+        if (!(node instanceof Document) && !Known.spanless(node)) {
+            if (spans.isEmpty()) {
+                // line breaks carry no spans (a span cannot cover a line ending); empty text nodes neither
+                if (!(node instanceof Text && ((Text) node).getLiteral().isEmpty()) && !(node instanceof SoftLineBreak) && !(node instanceof HardLineBreak)) {
+                    problems.add(kind + " has no source span");
+                }
+            }
+            int prevEnd = -1;
+            for (SourceSpan span : spans) {
+                String where = kind + " span " + span;
+                if (span.getLineIndex() < 0 || span.getLineIndex() >= lineStarts.size()) {
+                    problems.add(where + ": line index out of range");
+                    continue;
+                }
+                int start = span.getInputIndex();
+                int end = start + span.getLength();
+                if (span.getLength() < 0 || start < 0 || end > md.length()) {
+                    problems.add(where + ": outside the input (length " + md.length() + ")");
+                    continue;
+                }
+                if (lineStarts.get(span.getLineIndex()) + span.getColumnIndex() != start) {
+                    problems.add(where + ": input index " + start + " is not line start " + lineStarts.get(span.getLineIndex()) + " + column " + span.getColumnIndex());
+                }
+                String text = md.substring(start, end);
+                if (text.indexOf('\n') >= 0 || text.indexOf('\r') >= 0) {
+                    problems.add(where + ": covers a line ending: " + show(text));
+                }
+                if (start < prevEnd) {
+                    problems.add(where + ": overlaps the previous span of the node");
+                }
+                prevEnd = end;
+                if (node instanceof Block && node.getParent() != null && !(node.getParent() instanceof Document)) {
+                    if (!within(span, node.getParent().getSourceSpans()) && !Known.spanProblem(md, span, node.getParent().getSourceSpans())) {
+                        problems.add(where + ": not inside the parent " + node.getParent().getClass().getSimpleName() + "'s spans " + node.getParent().getSourceSpans());
+                    }
+                }
+                if (!(node instanceof Block) && node.getParent() != null) {
+                    if (!within(span, node.getParent().getSourceSpans()) && !Known.spanProblem(md, span, node.getParent().getSourceSpans())) {
+                        problems.add(where + ": not inside the parent " + node.getParent().getClass().getSimpleName() + "'s spans " + node.getParent().getSourceSpans());
+                    }
+                }
+            }
+            if (!spans.isEmpty()) {
+                String first = md.substring(spans.get(0).getInputIndex(), spans.get(0).getInputIndex() + spans.get(0).getLength());
+                SourceSpan last = spans.get(spans.size() - 1);
+                String lastText = md.substring(last.getInputIndex(), last.getInputIndex() + last.getLength());
+                shape(node, first, lastText, problems);
+            }
+        }
+        for (Node child = node.getFirstChild(); child != null; child = child.getNext()) {
+            walk(child, md, lineStarts, problems);
+        }
+    }
+
+    static boolean within(SourceSpan span, List<SourceSpan> parents) {
+        int start = span.getInputIndex();
+        int end = start + span.getLength();
+        for (SourceSpan p : parents) {
+            if (start >= p.getInputIndex() && end <= p.getInputIndex() + p.getLength()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** What the text under a node's first (and last) span must look like, from the syntax that produces the node. */
+    static void shape(Node node, String first, String last, List<String> problems) {
+        String kind = node.getClass().getSimpleName();
+        String f = first.stripLeading();
+        if (node instanceof Heading) {
+            Heading h = (Heading) node;
+            // an ATX opener of another level (a setext heading's first line may start with seven or more #s)
+            if (f.matches("#{1,6}([ \\t].*|)") && !f.startsWith("#".repeat(h.getLevel()) + " ") && !f.startsWith("#".repeat(h.getLevel()) + "\t")
+                && !f.equals("#".repeat(h.getLevel()))) {
+                problems.add(kind + " level " + h.getLevel() + " but its first line is " + show(first));
+            }
+        } else if (node instanceof ThematicBreak) {
+            if (!f.matches("[-*_][-*_ \\t]*")) {
+                problems.add(kind + " over " + show(first));
+            }
+        } else if (node instanceof FencedCodeBlock) {
+            FencedCodeBlock c = (FencedCodeBlock) node;
+            String fence = c.getFenceCharacter().repeat(c.getOpeningFenceLength());
+            if (!f.startsWith(fence)) {
+                problems.add(kind + " with fence " + show(fence) + " but its first line is " + show(first));
+            }
+        } else if (node instanceof IndentedCodeBlock) {
+            if (!(first.startsWith("    ") || first.startsWith("\t") || first.startsWith(" \t") || first.startsWith("  \t") || first.startsWith("   \t") || first.isBlank())) {
+                problems.add(kind + " whose first line " + show(first) + " is not indented");
+            }
+        } else if (node instanceof HtmlBlock) {
+            if (!f.startsWith("<")) {
+                problems.add(kind + " whose first line " + show(first) + " does not start with <");
+            }
+        } else if (node instanceof BlockQuote) {
+            if (!f.startsWith(">")) {
+                problems.add(kind + " whose first line " + show(first) + " does not start with >");
+            }
+        } else if (node instanceof ListItem) {
+            if (!f.matches("([-+*]|[0-9]{1,9}[.)])(\\s.*|)")) {
+                problems.add(kind + " whose first line " + show(first) + " does not start with a list marker");
+            }
+        } else if (node instanceof LinkReferenceDefinition) {
+            if (!f.startsWith("[")) {
+                problems.add(kind + " whose first line " + show(first) + " does not start with [");
+            }
+        } else if (node instanceof Paragraph) {
+            // blank in the spec's sense: spaces and tabs only (a Unicode space is paragraph content)
+            if (first.matches("[ \\t]*") || last.matches("[ \\t]*")) {
+                problems.add(kind + " with a blank first or last line: " + show(first) + " / " + show(last));
+            }
+        } else if (node instanceof Code) {
+            if (!first.startsWith("`") || !last.endsWith("`")) {
+                problems.add(kind + " not delimited by backticks: " + show(first) + " / " + show(last));
+            }
+        } else if (node instanceof Emphasis || node instanceof StrongEmphasis) {
+            String open = node instanceof Emphasis ? ((Emphasis) node).getOpeningDelimiter() : ((StrongEmphasis) node).getOpeningDelimiter();
+            String close = node instanceof Emphasis ? ((Emphasis) node).getClosingDelimiter() : ((StrongEmphasis) node).getClosingDelimiter();
+            if (!first.startsWith(open) || !last.endsWith(close)) {
+                problems.add(kind + " with delimiters " + show(open) + " " + show(close) + " over " + show(first) + " / " + show(last));
+            }
+        } else if (node instanceof Link || node instanceof Image) {
+            if (!(first.startsWith("[") || first.startsWith("![") || first.startsWith("<"))) {
+                problems.add(kind + " over " + show(first));
+            }
+            if (!(last.endsWith(")") || last.endsWith("]") || last.endsWith(">"))) {
+                problems.add(kind + " ending in " + show(last));
+            }
+        } else if (node instanceof HtmlInline) {
+            if (!first.startsWith("<") || !last.endsWith(">")) {
+                problems.add(kind + " over " + show(first) + " / " + show(last));
+            }
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..7af945d
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,150 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+
+    /** Rethrows any throwable unchecked (for control-flow exceptions such as Hegel's that must not be swallowed). */
+    @SuppressWarnings("unchecked")
+    static <T extends Throwable> void sneaky(Throwable t) throws T {
+        throw (T) t;
+    }
+
+    /** A property body that may throw checked exceptions. */
+    interface Body {
+        void run(TestCase tc) throws Exception;
+    }
+
+    /** Runs {@code body} as a Hegel property named {@code name}; checked exceptions escape as they are. */
+    static void property(String name, Body body) {
+        dev.hegel.Hegel.test(tc -> {
+            try {
+                body.run(tc);
+            } catch (Exception e) {
+                Zoo.<RuntimeException>sneaky(e);
+            }
+        }, settings(name));
+    }
+
+    /** Whether {@code t} throws an instance of {@code type} (or, with {@code type} null, anything at all). */
+    static boolean throwsA(Class<? extends Throwable> type, Body0 t) {
+        try {
+            t.run();
+            return false;
+        } catch (Throwable e) {
+            return type == null || type.isInstance(e);
+        }
+    }
+
+    interface Body0 {
+        void run() throws Exception;
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
