index 0000000..a32f72f
--- /dev/null
+++ b/hegel/node/oracle.js
@@ -0,0 +1,61 @@
+// commonmark.js as an oracle for the Hegel zoo's commonmark-java tests. One request per line: an operation and
+// its arguments as JSON strings separated by tabs; one reply line per request (a JSON string, or ERR ...).
+'use strict';
+const commonmark = require('commonmark');
+const readline = require('readline');
+
+const parser = new commonmark.Parser();
+const html = new commonmark.HtmlRenderer();
+const htmlSafe = new commonmark.HtmlRenderer({ safe: true });
+const htmlSourcepos = new commonmark.HtmlRenderer({ sourcepos: true });
+
+// The tree as nested S-expressions, one node per line: type, then the structural fields commonmark-java exposes.
+function tree(node) {
+  const out = [];
+  const walker = node.walker();
+  let ev;
+  let depth = 0;
+  while ((ev = walker.next())) {
+    const n = ev.node;
+    if (ev.entering) {
+      let line = ' '.repeat(depth) + n.type;
+      switch (n.type) {
+        case 'heading': line += ' ' + n.level; break;
+        case 'code_block': line += ' ' + JSON.stringify(n.info === null ? '' : n.info) + ' ' + JSON.stringify(n.literal) + (n._isFenced ? ' fenced' : ' indented'); break;
+        case 'text': case 'code': case 'html_inline': case 'html_block': line += ' ' + JSON.stringify(n.literal); break;
+        case 'link': case 'image': line += ' ' + JSON.stringify(n.destination) + ' ' + JSON.stringify(n.title === null ? '' : n.title); break;
+        case 'list': line += ' ' + n.listType + ' ' + (n.listTight ? 'tight' : 'loose') + (n.listType === 'ordered' ? ' ' + n.listStart + ' ' + n.listDelimiter : ' ' + n._listData.bulletChar); break;
+        default: break;
+      }
+      out.push(line);
+      if (n.isContainer) depth++;
+    } else {
+      depth--;
+    }
+  }
+  return out.join('\n');
+}
+
+function handle(op, a) {
+  switch (op) {
+    case 'html': return html.render(parser.parse(a[0]));
+    case 'safe': return htmlSafe.render(parser.parse(a[0]));
+    case 'pos': return htmlSourcepos.render(parser.parse(a[0]));
+    case 'tree': return tree(parser.parse(a[0]));
+    case 'version': return JSON.parse(require('fs').readFileSync(require.resolve('commonmark').replace(/dist[\/].*$|lib[\/].*$/, '') + 'package.json', 'utf8')).version;
+    default: return 'ERR unknown op ' + op;
+  }
+}
+
+const rl = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });
+rl.on('line', (line) => {
+  if (line.length === 0) return;
+  const parts = line.split('\t');
+  const op = parts[0];
+  let args;
+  try { args = parts.slice(1).map((p) => JSON.parse(p)); } catch (e) { process.stdout.write('ERR bad request\n'); return; }
+  let out;
+  try { out = JSON.stringify(handle(op, args)); } catch (e) { out = 'ERR ' + (e && e.message); }
+  process.stdout.write(out.replace(/[\r\n]/g, ' ') + '\n');
+});
+rl.on('close', () => process.exit(0));
