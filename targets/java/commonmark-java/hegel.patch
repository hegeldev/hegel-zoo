+package zoo;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.regex.Pattern;
+
+/**
+ * The tree a generated document is rendered from ({@link MdGen} draws it): blocks render to complete lines, inlines
+ * to text without line endings except where the construct allows them. Every {@code render} is a pure function of
+ * the record, so a failing case is a small tree in the draw report and the text in the message.
+ */
+final class Md {
+    private Md() {}
+
+    /** A document: its body, whether the final line ending is dropped, whether the line endings are CRLF. */
+    record Doc(Body body, boolean dropFinalNewline, boolean crlf) {
+        String render() {
+            String d = body.render();
+            if (dropFinalNewline && d.endsWith("\n")) {
+                d = d.substring(0, d.length() - 1);
+            }
+            return crlf ? d.replace("\n", "\r\n") : d;
+        }
+    }
+
+    sealed interface Body permits Structured, Chaos {
+        String render();
+    }
+
+    /** Blocks built from the constructs of the spec. */
+    record Structured(List<Sep> blocks) implements Body {
+        @Override
+        public String render() {
+            return Md.render(blocks);
+        }
+    }
+
+    /** Lines of characters drawn from Markdown punctuation, letters and a few non-ASCII characters. */
+    record Chaos(List<String> lines) implements Body {
+        @Override
+        public String render() {
+            StringBuilder sb = new StringBuilder();
+            for (String l : lines) {
+                sb.append(l).append('\n');
+            }
+            // commonmark.js knows no tabs between the parts of a link (its spnl matches spaces only), so none there
+            return sb.toString().replace(":\t", ": ").replace("(\t", "( ").replace("\t)", " )");
+        }
+    }
+
+    /** A block and whether a blank line follows it. */
+    record Sep(Block block, boolean blank) {
+        String render() {
+            return block.render() + (blank ? "\n" : "");
+        }
+    }
+
+    static String render(List<Sep> blocks) {
+        StringBuilder sb = new StringBuilder();
+        for (Sep s : blocks) {
+            sb.append(s.render());
+        }
+        return sb.toString();
+    }
+
+    /** The lines of a block's text, without the empty string after the final line ending. */
+    static List<String> lines(String text) {
+        String[] ls = text.split("\n", -1);
+        return Arrays.asList(ls).subList(0, ls.length - 1);
+    }
+
+    /** The lines of each block as a group, and a group of one empty line for each blank line after a block. */
+    static List<List<String>> groups(List<Sep> blocks) {
+        List<List<String>> out = new ArrayList<>();
+        for (Sep s : blocks) {
+            out.add(lines(s.block().render()));
+            if (s.blank()) {
+                out.add(List.of(""));
+            }
+        }
+        return out;
+    }
+
+    // ---- blocks -------------------------------------------------------------------------------------------------
+
+    sealed interface Block permits Paragraph, Atx, Setext, Fenced, Indented, Rule, Html, LinkDef, Quote, ListBlock, Table, Footnote, Alert, TaskList, Tight, Padded {
+        String render();
+    }
+
+    /** A block with a blank line of its own after it (an HTML block or a table would otherwise run on into the lines below). */
+    record Padded(Block block) implements Block {
+        @Override
+        public String render() {
+            return block.render() + "\n";
+        }
+    }
+
+    static final Pattern TRAILING_BLANK_LINES = Pattern.compile("\n(?:[ \t]*\n)+$");
+
+    /** A block without its trailing blank lines (a list item's block in the round-trip flavour: a blank line after a non-paragraph block, bug 1). */
+    record Tight(Block block) implements Block {
+        @Override
+        public String render() {
+            return TRAILING_BLANK_LINES.matcher(block.render()).replaceAll("\n");
+        }
+    }
+
+    /** A paragraph line: its indentation, its text and the hard break written after it (used before another line only). */
+    record ParaLine(String indent, Inlines text, String brk) {}
+
+    record Paragraph(List<ParaLine> lines) implements Block {
+        @Override
+        public String render() {
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < lines.size(); i++) {
+                ParaLine l = lines.get(i);
+                sb.append(l.indent()).append(l.text().render()).append(i < lines.size() - 1 ? l.brk() : "").append('\n');
+            }
+            return sb.toString();
+        }
+    }
+
+    /** A separator and inline text: the content of an ATX heading, the continuation of a footnote definition. */
+    record Headed(String sep, Inlines text) {
+        String render() {
+            return sep + text.render();
+        }
+    }
+
+    /** An ATX heading; {@code content} null for a heading of #s alone. */
+    record Atx(String indent, int level, Headed content, String closer) implements Block {
+        @Override
+        public String render() {
+            return indent + "#".repeat(level) + (content == null ? "" : content.render()) + closer + "\n";
+        }
+    }
+
+    record Setext(Paragraph text, String underline) implements Block {
+        @Override
+        public String render() {
+            return text.render() + underline + "\n";
+        }
+    }
+
+    /** An indentation of a fenced code block's line: a fixed one, or the fence's own. */
+    enum Indent {
+        NONE(""), ONE(" "), TWO("  "), FOUR("    "), TAB("\t"), FENCE(null);
+
+        final String text;
+
+        Indent(String text) {
+            this.text = text;
+        }
+
+        String of(String fenceIndent) {
+            return text == null ? fenceIndent : text;
+        }
+    }
+
+    record Info(String sep, String text) {
+        String render() {
+            return sep + text;
+        }
+    }
+
+    record CodeLine(Indent indent, String text) {}
+
+    /** The closing fence: its indentation, its length relative to the opening fence, and what follows it on the line. */
+    record Closing(Indent indent, int extra, String tail) {}
+
+    /** A fenced code block; {@code info} null for none, {@code closing} null for an unclosed fence. */
+    record Fenced(char fence, int open, String indent, Info info, List<CodeLine> lines, Closing closing) implements Block {
+        @Override
+        public String render() {
+            String f = String.valueOf(fence);
+            StringBuilder sb = new StringBuilder(indent).append(f.repeat(open)).append(info == null ? "" : info.render()).append('\n');
+            for (CodeLine l : lines) {
+                sb.append(l.indent().of(indent)).append(l.text()).append('\n');
+            }
+            if (closing != null) {
+                sb.append(closing.indent().of(indent)).append(f.repeat(open + closing.extra())).append(closing.tail()).append('\n');
+            }
+            return sb.toString();
+        }
+    }
+
+    /** A line of an indented code block and the blank line (possibly of spaces) after it, or "". */
+    record IndentedLine(String indent, String text, String blankAfter) {}
+
+    record Indented(List<IndentedLine> lines) implements Block {
+        @Override
+        public String render() {
+            StringBuilder sb = new StringBuilder();
+            for (IndentedLine l : lines) {
+                sb.append(l.indent()).append(l.text()).append('\n').append(l.blankAfter());
+            }
+            return sb.toString();
+        }
+    }
+
+    /** A thematic break: the character repeated once per gap, each repetition followed by its gap. */
+    record Rule(String lead, char c, List<String> gaps) implements Block {
+        @Override
+        public String render() {
+            StringBuilder sb = new StringBuilder(lead);
+            for (String g : gaps) {
+                sb.append(c).append(g);
+            }
+            return sb.append('\n').toString();
+        }
+    }
+
+    /** An HTML block, one of the seven kinds, as text. */
+    record Html(String text) implements Block {
+        @Override
+        public String render() {
+            return text;
+        }
+    }
+
+    /** A link title and the separator before it. */
+    record Title(String sep, String text) {
+        String render() {
+            return sep + text;
+        }
+    }
+
+    /** A link reference definition; {@code title} null for none. */
+    record LinkDef(String lead, String label, String sep, String dest, Title title, String tail) implements Block {
+        @Override
+        public String render() {
+            return lead + "[" + label + "]:" + sep + dest + (title == null ? "" : title.render()) + tail + "\n";
+        }
+    }
+
+    /** How a line of a block quote is prefixed: lazily (no marker; only after the first line of its block), or with the marker. */
+    record QuoteLine(boolean lazy, String marker) {}
+
+    /** A block quote: the blocks inside, and the prefixes of its lines, taken in turn (modulo their number). */
+    record Quote(List<Sep> body, List<QuoteLine> prefixes) implements Block {
+        @Override
+        public String render() {
+            StringBuilder sb = new StringBuilder();
+            int k = 0;
+            for (List<String> group : groups(body)) {
+                for (int i = 0; i < group.size(); i++, k++) {
+                    QuoteLine q = prefixes.get(k % prefixes.size());
+                    if (!(i > 0 && q.lazy())) {
+                        sb.append(q.marker());
+                    }
+                    sb.append(group.get(i)).append('\n');
+                }
+            }
+            return sb.toString();
+        }
+    }
+
+    /**
+     * A list item: its own bullet (null: the list's), the gap after the marker, the continuation indent (null: the
+     * content column, at most six), its blocks (empty: a blank first line), the indent before the marker, per-line
+     * style draws 0..99 (taken modulo their number: a blank line keeps its indent below 50, a text line loses it at
+     * 90 and above), and whether a blank line separates it from the next item (the list's last item has none: the
+     * blank line after the list is its {@link Sep}'s).
+     */
+    record Item(String bullet, String gap, String cont, List<Sep> body, String lead, List<Integer> style, boolean blankAfter) {}
+
+    /** A list; ordered items are numbered from {@code start}, or all with it. */
+    record ListBlock(boolean ordered, String bullet, int start, String delim, boolean sameNumber, List<Item> items) implements Block {
+        @Override
+        public String render() {
+            StringBuilder sb = new StringBuilder();
+            for (int k = 0; k < items.size(); k++) {
+                Item item = items.get(k);
+                String marker = ordered ? (sameNumber ? start : start + k) + delim : item.bullet() == null ? bullet : item.bullet();
+                String first = marker + item.gap();
+                String cont = item.cont() == null ? " ".repeat(Math.min(first.length(), 6)) : item.cont();
+                List<String> ls = new ArrayList<>();
+                for (List<String> group : groups(item.body())) {
+                    ls.addAll(group);
+                }
+                if (ls.isEmpty()) {
+                    ls.add("");
+                }
+                for (int j = 0; j < ls.size(); j++) {
+                    String l = ls.get(j);
+                    int x = item.style().get(j % item.style().size());
+                    if (j == 0) {
+                        sb.append(item.lead()).append(first).append(l);
+                    } else if (l.isEmpty()) {
+                        sb.append(x < 50 ? cont : "");
+                    } else {
+                        sb.append(x < 90 ? cont : "").append(l);
+                    }
+                    sb.append('\n');
+                }
+                if (item.blankAfter() && k < items.size() - 1) {
+                    sb.append('\n');
+                }
+            }
+            return sb.toString();
+        }
+    }
+
+    /** A table cell with the spaces around its text. */
+    record Cell(String pre, String text, String post) {
+        String render() {
+            return pre + text + post;
+        }
+    }
+
+    /** A delimiter-row cell with the spaces around it. */
+    record Delim(String pre, String d, String post) {
+        String render() {
+            return pre + d + post;
+        }
+
+        /** The alignment the delimiter declares, as the HTML attribute value, or null for none. */
+        String align() {
+            boolean left = d.startsWith(":");
+            boolean right = d.endsWith(":");
+            return left && right ? "center" : left ? "left" : right ? "right" : null;
+        }
+    }
+
+    /** A GFM table: header cells, one delimiter per header cell, body rows of any width. */
+    record Table(boolean leading, boolean trailing, List<Cell> header, List<Delim> delims, List<List<Cell>> rows) implements Block {
+        @Override
+        public String render() {
+            StringBuilder sb = new StringBuilder();
+            sb.append(row(header.stream().map(Cell::render).toList())).append('\n');
+            sb.append(row(delims.stream().map(Delim::render).toList())).append('\n');
+            for (List<Cell> r : rows) {
+                sb.append(row(r.stream().map(Cell::render).toList())).append('\n');
+            }
+            return sb.toString();
+        }
+
+        private String row(List<String> cells) {
+            return (leading ? "|" : "") + String.join("|", cells) + (trailing ? "|" : "");
+        }
+    }
+
+    /** A footnote definition; {@code more} null for a one-line definition. */
+    record Footnote(String label, String sep, Inlines text, Headed more) implements Block {
+        @Override
+        public String render() {
+            return "[^" + label + "]:" + sep + text.render() + "\n" + (more == null ? "" : more.render() + "\n");
+        }
+    }
+
+    /** A GFM alert: the marker line and the quote below it (null: the marker line alone). */
+    record Alert(String type, String tail, Quote body) implements Block {
+        @Override
+        public String render() {
+            return "> [!" + type + "]" + tail + "\n" + (body == null ? "" : body.render());
+        }
+    }
+
+    /** A task list item; {@code more} null for a one-line item. */
+    record Task(String marker, String box, String sep, Inlines text, Inlines more) {}
+
+    record TaskList(List<Task> items) implements Block {
+        @Override
+        public String render() {
+            StringBuilder sb = new StringBuilder();
+            for (Task t : items) {
+                sb.append(t.marker()).append(t.box()).append(t.sep()).append(t.text().render()).append('\n');
+                if (t.more() != null) {
+                    sb.append("  ").append(t.more().render()).append('\n');
+                }
+            }
+            return sb.toString();
+        }
+    }
+
+    // ---- inlines -----------------------------------------------------------------------------------------------
+
+    /** An inline and whether a space follows it. */
+    record Spaced(Inline item, boolean space) {
+        String render() {
+            return item.render() + (space ? " " : "");
+        }
+    }
+
+    /** A line's worth of inline content; never empty. */
+    record Inlines(List<Spaced> items) {
+        String render() {
+            StringBuilder sb = new StringBuilder();
+            for (Spaced s : items) {
+                sb.append(s.render());
+            }
+            return sb.toString();
+        }
+
+        static Inlines of(String word) {
+            return new Inlines(List.of(new Spaced(new Lit(word), false)));
+        }
+    }
+
+    sealed interface Inline permits Lit, Emph, CodeSpan, Link, RefLink, BareLink, Image, Shortcut, Strike {
+        String render();
+    }
+
+    /** Literal text: a word, an autolink, raw HTML, an entity, an escape, a line break, stray delimiters, ... */
+    record Lit(String text) implements Inline {
+        @Override
+        public String render() {
+            return text;
+        }
+    }
+
+    /** Emphasis: the opening delimiter run, the closing one (null: the same), and decorations inside the delimiters. */
+    record Emph(String open, String close, String prefix, Inlines inner, String suffix) implements Inline {
+        @Override
+        public String render() {
+            return open + prefix + inner.render() + suffix + (close == null ? open : close);
+        }
+    }
+
+    /** A code span; {@code closeTicks} null for a closing run as long as the opening one. */
+    record CodeSpan(int ticks, String content, Integer closeTicks) implements Inline {
+        @Override
+        public String render() {
+            return "`".repeat(ticks) + content + "`".repeat(closeTicks == null ? ticks : closeTicks);
+        }
+    }
+
+    /** Link text: inline content, or a fixed hostile text in its place. */
+    record LinkText(Inlines inner, String override) {
+        String render() {
+            return override == null ? inner.render() : override;
+        }
+    }
+
+    /** An inline link; {@code title} null for none. */
+    record Link(LinkText text, String pre, String dest, Title title, String post) implements Inline {
+        @Override
+        public String render() {
+            return "[" + text.render() + "](" + pre + dest + (title == null ? "" : title.render()) + post + ")";
+        }
+    }
+
+    record RefLink(LinkText text, String label) implements Inline {
+        @Override
+        public String render() {
+            return "[" + text.render() + "][" + label + "]";
+        }
+    }
+
+    /** Bracketed text followed by something that is not quite a link. */
+    record BareLink(LinkText text, String suffix) implements Inline {
+        @Override
+        public String render() {
+            return "[" + text.render() + "]" + suffix;
+        }
+    }
+
+    /** An inline image; {@code title} null for none. */
+    record Image(LinkText text, String dest, String title) implements Inline {
+        @Override
+        public String render() {
+            return "![" + text.render() + "](" + dest + (title == null ? "" : " " + title) + ")";
+        }
+    }
+
+    record Shortcut(String label) implements Inline {
+        @Override
+        public String render() {
+            return "[" + label + "]";
+        }
+    }
+
+    record Strike(String open, String text, String close) implements Inline {
+        @Override
+        public String render() {
+            return open + text + close;
+        }
+    }
+}
