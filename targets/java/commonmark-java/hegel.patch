+            escape = sampledFrom(rt ? without(ESCAPED, c -> c.equals("+") || c.equals("~")) : ESCAPED).map(c -> new Lit("\\" + c));
+            Generator<String> brk = sampledFrom(rt ? without(BREAKS, b -> b.contains(" \\")) : BREAKS);
+            lineBreak = rt ? tuples(word(WORDS, 1, 3), brk).map(t -> new Lit(t.value1() + t.value2())) : brk.map(Lit::new);
+            // the round trip: no delimiter runs (bugs 15, 16), no lone backslash (a hard break after a space, bug 13), no > (a quote)
+            stray = lit(rt ? without(STRAYS, s -> s.length() > 1 && s.matches("[*_]+") || s.equals("\\") || s.equals(">")) : STRAYS);
+            ins = lit(concat(rt ? List.of("a++", "a+", "a++x++", "a++x+") : List.of("++", "+", "++x++", "++x+"), ATTRIBUTES));
+            // the round trip: no tab either (a lone tag line opens an HTML block, whose literal then holds the tab,
+            // bug 2), no emphasis delimiters (a run next to an emphasis merges with it, bugs 15, 16), and none of
+            // > # - = (first on a paragraph line they make it another block, and a blank line after that is bug 1's)
+            String punctuation = rt ? PUNCT.replaceAll("[+~\t*_>#=-]", "") : PUNCT;
+            punct = word(punctuation.replace("\n", ""), 1, 4).map(Lit::new);
+            // the round trip: three backticks and a tilde on one line are bug 7's mixed fence
+            codeSpan = rt
+                ? codeSpan(ints(1, 2), ints(1, 2), without(CODE_SPAN_CONTENTS, c -> c.contains("`") || c.isEmpty()))
+                : codeSpan(ints(1, 3), ints(1, 4), CODE_SPAN_CONTENTS);
+            // the round trip: a line holding a tag alone opens an HTML block (bug 2's tabs), so a word goes first
+            footnoteRef = lit(rt ? without(FOOTNOTE_REFS, r -> r.endsWith(":")) : FOOTNOTE_REFS);
+            indented = indented(rt ? 1 : 0);
+            strike = strike(rt ? sampledFrom("~~", "~", "") : sampledFrom("~~", "~", "~~~", ""));
+            // the round trip: a blank line after every HTML block (an open one swallows the blocks below, with their tabs, bug 2)
+            html = rt ? HTML.map(Padded::new) : Gen.<Block>widen(HTML);
+            // the round trip: no indented break after a list (it would join the list's last item after the blank line,
+            // bug 1's shape), and three characters at least (two are a list item holding an empty item)
+            rule = rt ? rule(just(""), 3) : rule(sampledFrom("", " ", "   "), 2);
+            this.inlines = inlines(0, true, true);
+            Level deeper = null;
+            for (int depth = 3; depth >= 0; depth--) {
+                deeper = level(depth, deeper);
+            }
+            Generator<List<Sep>> blocks = lists(sep(deeper.block())).minSize(1).maxSize(5);
+            // the round trip: a definition (dropped by the renderer, bug 49) only as the first block, before any list
+            Generator<List<Sep>> structured = rt
+                ? tuples(maybe(20, List.<Sep>of(), sep(Gen.<Block>widen(linkDef())).map(List::of)), blocks).map(t -> concat(t.value1(), t.value2()))
+                : blocks;
+            Generator<Body> body = weighted(w(80, structured.map(Structured::new)), w(20, chaos(punctuation)));
+            this.document = tuples(body, chance(10), chance(10)).map(t -> new Doc(t.value1(), t.value2(), t.value3()));
+        }
+
+        /** Up to six chaos lines of up to 30 characters: letters 40%, punctuation 50%, non-ASCII 10%; the length is drawn first so long lines stay as common as short ones. */
+        static Generator<Chaos> chaos(String punctuation) {
+            Generator<String> c = weighted(w(40, chars(WORDS)), w(50, chars(punctuation)), w(10, chars(UNICODE)));
+            Generator<String> line = ints(0, 30).flatMap(n -> lists(c).minSize(n).maxSize(n)).map(Gen::join);
+            return lists(line).minSize(1).maxSize(6).map(Chaos::new);
+        }
+
+        // ---- inlines ---------------------------------------------------------------------------------------------
+
+        /**
+         * Inline content at nesting depth {@code depth} (0: a line of a paragraph): a word alone one time in six
+         * (in four below the top), or up to five (three) inlines each followed by a space half the time.
+         */
+        Generator<Inlines> inlines(int depth, boolean emphasis, boolean links) {
+            int max = depth == 0 ? 5 : 3;
+            Generator<Spaced> spaced = tuples(inline(depth, emphasis, links), chance(50)).map(t -> new Spaced(t.value1(), t.value2()));
+            return weighted(w(1, word(WORDS, 1, 6).map(Inlines::of)), w(max, lists(spaced).minSize(1).maxSize(max).map(Inlines::new)));
+        }
+
+        /**
+         * One inline; {@code emphasis} false leaves emphasis out, {@code links} false links and autolinks (inside
+         * emphasis and inside link text, in the round-trip flavour: bugs 15 and 18).
+         */
+        Generator<Inline> inline(int depth, boolean emphasis, boolean links) {
+            Generator<Inlines> bottom = word(WORDS, 1, 5).map(Inlines::of);
+            Generator<Inlines> emphInner = depth < 3 ? inlines(depth + 1, emphasis && !f.roundTrip, links) : bottom;
+            Generator<Inlines> linkInner = depth < 3 ? inlines(depth + 1, emphasis, links && !f.roundTrip) : bottom;
+            List<Gen.Choice<Inline>> c = new ArrayList<>();
+            c.add(w(5, word(WORDS, 1, 8).map(Lit::new)));
+            c.add(w(1, word(WORDS + UNICODE, 1, 6).map(Lit::new)));
+            if (emphasis) {
+                c.add(w(2, emph(emphInner)));
+            }
+            c.add(w(1, codeSpan));
+            if (links) {
+                c.add(w(2, link(linkInner)));
+                c.add(w(1, autolink));
+            }
+            c.add(w(1, rawHtml));
+            c.add(w(1, entity));
+            c.add(w(1, escape));
+            c.add(w(1, lineBreak));
+            c.add(w(1, stray));
+            c.add(w(1, strike));
+            c.add(w(1, footnoteRef));
+            c.add(w(1, BARE_URL));
+            c.add(w(1, ins));
+            c.add(w(1, punct));
+            return weighted(c);
+        }
+
+        /**
+         * Emphasis around {@code inner}: a delimiter run, closed by the same run (85%) or another, with punctuation
+         * or spaces at its edges one time in five (the round trip: single delimiters, and always something after the
+         * closer, so that two emphases are never adjacent, bugs 15 and 16).
+         */
+        Generator<Emph> emph(Generator<Inlines> inner) {
+            Generator<String> open = f.roundTrip ? sampledFrom("*", "_") : sampledFrom("*", "_", "**", "__", "***", "___", "*", "_");
+            Generator<String> close = f.roundTrip ? sampledFrom("*", "_", "") : sampledFrom("*", "_", "**", "__", "");
+            Generator<String> suffix = f.roundTrip ? sampledFrom(" ", ". ", ", ") : maybe(20, "", sampledFrom(" ", ".", ",", "—", "¡"));
+            return tuples(open, maybe(15, (String) null, close), maybe(20, "", sampledFrom(" ", "", ".", " ", "“")), inner, suffix)
+                .map(t -> new Emph(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+        }
+
+        /** A link or image around {@code inner}: shortcut, bracketed text and a near miss, reference, inline, image. */
+        Generator<Inline> link(Generator<Inlines> inner) {
+            Generator<LinkText> text = tuples(inner, maybe(15, (String) null, LINK_TEXT_OVERRIDE)).map(t -> new LinkText(t.value1(), t.value2()));
+            Generator<Title> title = tuples(sampledFrom(" ", "  ", "\n"), TITLE).map(t -> new Title(t.value1(), t.value2()));
+            return Generators.<Inline>oneOf(
+                LABEL.map(Shortcut::new),
+                tuples(text, sampledFrom("", "[]", " []", "(", "( )", "[ ]")).map(t -> new BareLink(t.value1(), t.value2())),
+                tuples(text, LABEL).map(t -> new RefLink(t.value1(), t.value2())),
+                tuples(text, sampledFrom("", "", " ", "\n"), dest, maybe(40, (Title) null, title), sampledFrom("", " ", "\n"))
+                    .map(t -> new Link(t.value1(), t.value2(), t.value3(), t.value4(), t.value5())),
+                tuples(text, dest, maybe(40, (String) null, TITLE)).map(t -> new Image(t.value1(), t.value2(), t.value3())));
+        }
+
+        // ---- blocks ----------------------------------------------------------------------------------------------
+
+        /**
+         * The generators of one container depth: any block, a block that is not a list (the round trip puts a
+         * nested list last in its item), and a list (null at the bottom).
+         */
+        record Level(Generator<Block> block, Generator<Block> leaf, Generator<ListBlock> list) {}
+
+        /** The level at container depth {@code depth}; {@code deeper} is the level inside a container, null at the bottom. */
+        Level level(int depth, Level deeper) {
+            Generator<ListBlock> list = deeper == null ? null : list(deeper);
+            return new Level(block(depth, deeper, list, false), block(depth, deeper, null, true), list);
+        }
+
+        /**
+         * A block at container depth {@code depth}, with {@code list} for the lists (null: paragraphs instead, at
+         * the bottom, where the other containers give way to paragraphs too; as in the weights: three in thirteen
+         * paragraphs, two lists, one of everything else; with GFM four blocks more). {@code leaf}: the blocks of a
+         * round-trip list item other than its last (no table: the lines below would be its rows).
+         */
+        Generator<Block> block(int depth, Level deeper, Generator<ListBlock> list, boolean leaf) {
+            Generator<Paragraph> paragraph = paragraph();
+            boolean top = !f.roundTrip || depth == 0;
+            List<Gen.Choice<Block>> c = new ArrayList<>();
+            c.add(w(3, paragraph));
+            c.add(w(1, atx()));
+            c.add(w(1, tuples(paragraph, sampledFrom("===", "=", "---", "- - -", "  ===  ", "----\t", "    ===")).map(t -> new Setext(t.value1(), t.value2()))));
+            c.add(w(1, fenced()));
+            c.add(w(1, indented));
+            c.add(w(1, rule));
+            // the round trip: HTML blocks at the top level only (a container's tab is kept in the block's literal,
+            // bug 2) and definitions only as the document's first block (the renderer drops them, bug 49)
+            c.add(w(1, top ? html : paragraph));
+            c.add(w(1, f.roundTrip ? paragraph : linkDef()));
+            c.add(w(1, deeper == null ? paragraph : quote(deeper.block())));
+            c.add(w(2, list == null ? paragraph : list));
+            if (f.gfm) {
+                // the round trip: a blank line after a table (the lines below would be its rows)
+                Generator<? extends Block> table = !f.roundTrip ? table() : leaf ? paragraph : table().map(Padded::new);
+                c.add(w(1, table));
+                c.add(w(1, footnote()));
+                c.add(w(1, alert(deeper == null ? null : deeper.block())));
+                c.add(w(1, list == null ? paragraph : taskList()));
+            }
+            return weighted(c);
+        }
+
+        /** One to three lines, indented one time in seven, with a hard break before the next line one time in five. */
+        Generator<Paragraph> paragraph() {
+            // the round trip: a break only after a word (never after a space or first on its line) and no space before the backslash (bugs 13, 45)
+            Generator<String> brk = f.roundTrip
+                ? tuples(word(WORDS, 1, 3), sampledFrom("  ", "\\", "   ")).map(t -> t.value1() + t.value2())
+                : sampledFrom("  ", "\\", "   ", " \\");
+            // the round trip: no indent (after a list marker's four-space gap even one space makes the line indented
+            // code, and an indented line after a list joins the list's last item: bug 1's shape after a blank line)
+            Generator<String> indent = f.roundTrip ? just("") : maybe(15, "", sampledFrom(" ", "  ", "   ", "\t"));
+            Generator<ParaLine> line = tuples(indent, inlines, maybe(20, "", brk))
+                .map(t -> new ParaLine(t.value1(), t.value2(), t.value3()));
+            return lists(line).minSize(1).maxSize(3).map(Paragraph::new);
+        }
+
+        Generator<Atx> atx() {
+            Generator<Headed> content = tuples(sampledFrom(" ", "\t", "  "), inlines).map(t -> new Headed(t.value1(), t.value2()));
+            Generator<String> indent = f.roundTrip ? just("") : maybe(20, "", sampledFrom(" ", "   ", "    "));
+            return tuples(indent, ints(1, 7), maybe(90, (Headed) null, content), maybe(30, "", sampledFrom(" #", " ###", "#", " # ", " ##\t")))
+                .map(t -> new Atx(t.value1(), t.value2(), t.value3(), t.value4()));
+        }
+
+        Generator<Fenced> fenced() {
+            // the round trip: no fence characters or & in the info string (bugs 7, 14, 24)
+            Generator<String> infoText = f.roundTrip
+                ? sampledFrom("java", "c++", "ruby startline=3", " x ")
+                : sampledFrom("java", "c++", "ruby startline=3", "`x`", "~", "a&amp;b", "\\`", " x ");
+            Generator<Info> info = tuples(sampledFrom("", " "), infoText).map(t -> new Info(t.value1(), t.value2()));
+            Generator<CodeLine> line = tuples(sampledFrom(Indent.NONE, Indent.ONE, Indent.FOUR, Indent.TAB, Indent.FENCE), word(WORDS + " *_<>&`~", 0, 12))
+                .map(t -> new CodeLine(t.value1(), t.value2()));
+            Generator<Closing> closing = tuples(sampledFrom(Indent.NONE, Indent.FENCE, Indent.TWO, Indent.FOUR), ints(-1, 2), maybe(15, "", sampledFrom(" ", "\t", " x")))
+                .map(t -> new Closing(t.value1(), t.value2(), t.value3()));
+            // the round trip: a fence indented four spaces is text starting with the fence characters (bug 23); one indented two or three joins a list above
+            Generator<String> indent = f.roundTrip ? sampledFrom("", "", " ") : sampledFrom("", "", " ", "  ", "   ", "    ");
+            return tuples(sampledFrom('`', '~'), ints(3, 5), indent, maybe(60, (Info) null, info), lists(line).maxSize(3), maybe(85, (Closing) null, closing))
+                .map(t -> new Fenced(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+        }
+
+        Generator<LinkDef> linkDef() {
+            // commonmark.js knows no tabs between the parts of a definition (its spnl matches spaces only), so none here
+            Generator<Title> title = tuples(sampledFrom(" ", "\n", "  \n  ", "   "), TITLE).map(t -> new Title(t.value1(), t.value2()));
+            return tuples(sampledFrom("", "", " ", "   ", "    "), LABEL, sampledFrom(" ", "", "  ", "\n", "\n  ", "   "), dest,
+                    maybe(50, (Title) null, title), maybe(15, "", sampledFrom(" x", "  ", " ")))
+                .map(t -> new LinkDef(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+        }
+
+        /** The blocks inside a container: one to three, each followed by a blank line 60% of the time. */
+        Generator<List<Sep>> blocks(Generator<Block> deeper) {
+            return lists(sep(deeper)).minSize(1).maxSize(3);
+        }
+
+        Generator<Sep> sep(Generator<Block> block) {
+            return tuples(block, chance(60)).map(t -> new Sep(t.value1(), t.value2()));
+        }
+
+        /**
+         * A block quote: its blocks, and up to eight line prefixes (a lazy line one time in seven) used in turn. The
+         * round trip: no lazy line (one inside a fenced block breaks the fence, and the fence lines below are text
+         * starting with tildes, bug 23) and no marker indent (a quote after a list would join its last item).
+         */
+        Generator<Quote> quote(Generator<Block> deeper) {
+            Generator<QuoteLine> prefix = f.roundTrip
+                ? sampledFrom("> ", ">", ">  ", ">\t").map(m -> new QuoteLine(false, m))
+                : tuples(chance(15), sampledFrom("> ", ">", ">  ", " > ", ">\t", "   >")).map(t -> new QuoteLine(t.value1(), t.value2()));
+            // the round trip: one prefix for every line (widths varying by line move a nested item's content column, and its blocks fall out)
+            return tuples(blocks(deeper), lists(prefix).minSize(1).maxSize(f.roundTrip ? 1 : 8)).map(t -> new Quote(t.value1(), t.value2()));
+        }
+
+        /**
+         * A list of one to four items, ordered two times in five, with odd gaps, indents and continuation columns.
+         * The round trip keeps the item's lines at its content column (a block falling out of an item lands after
+         * the list, where the blank line before it counts as bug 1's), with no lazy line (one inside a fenced block
+         * breaks the fence, bug 23), uses the list's bullet for every item (a new list after a blank line is the
+         * same shape), and no {@code +} bullet (an empty {@code +} item after a paragraph is text starting with
+         * {@code +}, bug 21).
+         */
+        Generator<ListBlock> list(Level deeper) {
+            boolean rt = f.roundTrip;
+            Generator<List<Sep>> body = rt ? itemBlocks(deeper.leaf(), deeper.list()) : blocks(deeper.block());
+            Generator<Item> item = tuples(
+                    rt ? just((String) null) : maybe(10, (String) null, sampledFrom("-", "*", "+")),
+                    rt ? sampledFrom(" ", " ", "  ", "   ", "    ") : sampledFrom(" ", " ", "  ", "   ", "    ", "     ", "\t"),
+                    rt ? just((String) null) : maybe(10, (String) null, sampledFrom("", " ", "  ", "\t", "      ")),
+                    weighted(w(10, just(List.<Sep>of())), w(90, body)),
+                    rt ? just("") : sampledFrom("", "", " ", "  ", "   "),
+                    lists(ints(0, rt ? 89 : 99)).minSize(1).maxSize(6),
+                    chance(30))
+                .map(t -> new Item(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+            // the round trip: numbers of one digit only (the renderer renumbers, changing the marker's width, bug 22)
+            Generator<Integer> start = rt ? sampledFrom(1, 1, 2, 5) : sampledFrom(1, 1, 0, 2, 9, 10, 123456789, 1234567890);
+            Generator<String> bullet = rt ? sampledFrom("-", "*") : sampledFrom("-", "*", "+");
+            return tuples(chance(40), bullet, start, sampledFrom(".", ")"), chance(30), lists(item).minSize(1).maxSize(4))
+                .map(t -> new ListBlock(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+        }
+
+        /**
+         * The blocks of a list item in the round-trip flavour: one to three blocks that are not lists, with a blank
+         * line after a paragraph only and none at the end of another block (bug 1), no thematic break (bug 19) or
+         * indented code first, then one time in three a nested list or (GFM) a table, last (a block after a nested
+         * list with a blank line inside makes the outer list loose in the parser, see
+         * {@link Known#blockRightAfterNestedListWithBlankLine}; paragraph lines after a table are its rows).
+         */
+        Generator<List<Sep>> itemBlocks(Generator<Block> leaf, Generator<ListBlock> nested) {
+            Generator<Sep> sep = leaf.flatMap(b -> b instanceof Paragraph
+                ? chance(60).map(blank -> new Sep(b, blank))
+                : just(new Sep(new Tight(b), false)));
+            // no indented code first either: with the marker's gap it makes the item's content column the marker's
+            // width plus one, and the block's later lines, indented for the wider column, are paragraphs after its blank lines (bug 1's shape)
+            Generator<Sep> first = sep.filter(s -> !(s.block() instanceof Tight t && (t.block() instanceof Rule || t.block() instanceof Indented)));
+            List<Gen.Choice<Block>> trailers = new ArrayList<>();
+            if (nested != null) {
+                trailers.add(w(2, nested));
+            }
+            if (f.gfm) {
+                trailers.add(w(1, table()));
+            }
+            Generator<List<Sep>> last = trailers.isEmpty()
+                ? just(List.of())
+                : maybe(30, List.<Sep>of(), weighted(trailers).map(b -> List.of(new Sep(new Tight(b), false))));
+            return tuples(first, lists(sep).maxSize(2), last).map(t -> {
+                List<Sep> out = new ArrayList<>();
+                out.add(t.value1());
+                out.addAll(t.value2());
+                out.addAll(t.value3());
+                return out;
+            });
+        }
+
+        /** A table of one to four columns: header, delimiter row, up to three body rows of the same width or (one in five) another. */
+        Generator<Table> table() {
+            // the round trip: no backslashes in cells (an escaped backslash before a pipe is read as an escaped pipe, bug 47)
+            Generator<Cell> cell = tuples(sampledFrom("", " ", "  "), sampledFrom(f.roundTrip ? without(CELLS, c -> c.contains("\\\\")) : CELLS), sampledFrom("", " ", "  "))
+                .map(t -> new Cell(t.value1(), t.value2(), t.value3()));
+            return ints(1, 4).flatMap(cols -> tuples(chance(80), chance(80), cells(cell, cols), lists(DELIM).minSize(cols).maxSize(cols),
+                    lists(weighted(w(80, cells(cell, cols)), w(20, ints(0, cols + 1).flatMap(n -> cells(cell, n))))).maxSize(3))
+                .map(t -> new Table(t.value1(), t.value2(), t.value3(), t.value4(), t.value5())));
+        }
+
+        static Generator<List<Cell>> cells(Generator<Cell> cell, int n) {
+            return lists(cell).minSize(n).maxSize(n);
+        }
+
+        Generator<Footnote> footnote() {
+            // the round trip: a second line indented enough to stay in the definition (in a list item the other is a paragraph after a blank line, bug 1's shape)
+            Generator<String> sep = f.roundTrip ? sampledFrom("\n    ", "    ", "\t") : sampledFrom("\n    ", "    ", "\n  ", "\t");
+            Generator<Headed> more = tuples(sep, inlines).map(t -> new Headed(t.value1(), t.value2()));
+            // the round trip: labels a footnote takes (the others are link reference definitions, dropped by the renderer, bug 49)
+            Generator<String> label = f.roundTrip ? sampledFrom("1", "a", "A", "note", "é") : sampledFrom("1", "a", "A", "note", "a b", "x\\]y", "é");
+            return tuples(label, sampledFrom(" ", "", "  ", "\t"), inlines, maybe(30, (Headed) null, more))
+                .map(t -> new Footnote(t.value1(), t.value2(), t.value3(), t.value4()));
+        }
+
+        /** An alert marker line, followed four times in five by a block quote (none at the bottom of the ladder). */
+        Generator<Alert> alert(Generator<Block> deeper) {
+            Generator<Quote> body = deeper == null ? just((Quote) null) : maybe(80, (Quote) null, quote(deeper));
+            return tuples(sampledFrom("NOTE", "TIP", "IMPORTANT", "WARNING", "CAUTION", "note", "Warning", "OTHER", ""), maybe(20, "", sampledFrom(" ", " x", "\t", "]")), body)
+                .map(t -> new Alert(t.value1(), t.value2(), t.value3()));
+        }
+
+        Generator<TaskList> taskList() {
+            Generator<Task> task = tuples(sampledFrom("- ", "* ", "1. ", "-  ", "-\t"), sampledFrom("[ ]", "[x]", "[X]", "[]", "[ ] ", "[x]x", "[ ]\t", "[-]", "[  ]"),
+                    sampledFrom(" ", "", "  "), inlines, maybe(25, (Inlines) null, inlines))
+                .map(t -> new Task(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+            return lists(task).minSize(1).maxSize(3).map(TaskList::new);
+        }
+    }
+
+    // ---- the documents (after the tables: a grammar is built from them) ---------------------------------------
+
+    static final Generator<Doc> CORE = new Grammar(new Flavour(false, false)).document;
+    static final Generator<Doc> GFM = new Grammar(new Flavour(true, false)).document;
+    static final Generator<Doc> CORE_ROUND_TRIP = new Grammar(new Flavour(false, true)).document;
+    static final Generator<Doc> GFM_ROUND_TRIP = new Grammar(new Flavour(true, true)).document;
+}
