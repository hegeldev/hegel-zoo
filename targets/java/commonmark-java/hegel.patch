+    static final Generator<Inline> BARE_URL = lit(List.of("http://a.b/c", "www.a.b/c.", "www.a.b/c)", "(www.a.b)", "a@b.c", "a@b.c.", "https://a.b/c_(d)", "www.a.b/c&amp;", "http://a.b/é", "www.a", "ftp://a.b"));
