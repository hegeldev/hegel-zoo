+    static final Generator<String> TITLE = sampledFrom("\"t\"", "'t'", "(t)", "\"a \\\" b\"", "'a \"b\" c'", "\"a\nb\"", "\"&copy;\"", "\"\"", "\"a'b\"", "(a(b)c)", "\"x", "\"*a*\"");
+
+    static final List<String> AUTOLINKS = List.of("<http://a.b/c?d=e&f>", "<https://x.y/é>", "<a@b.c>", "<mailto:a@b.c>", "<a.b-c@d.e>", "<http://a b>", "<ftp://a.b:21/x\\y>", "<MAILTO:A@B.C>",
