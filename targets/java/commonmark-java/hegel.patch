+
+    @Test
+    void pinRenderedEmptyDestinationWithTitle() {
+        // "[a](<> \"t\")": an empty destination with a title is written as "[a]( \"t\")", and the title re-parses as the
+        // destination (the renderer must write "<>" for an empty destination when a title follows)
+        same("[a](<> \"t\")", html("[a](<> \"t\")\n"), roundTrip("[a](<> \"t\")\n"));
