diff --git a/hegel/src/test/java/zoo/Cmjs.java b/hegel/src/test/java/zoo/Cmjs.java
new file mode 100644
index 0000000..7f073da
--- /dev/null
+++ b/hegel/src/test/java/zoo/Cmjs.java
@@ -0,0 +1,138 @@
+package zoo;
+
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+
+/**
+ * commonmark.js (the reference implementation of the CommonMark spec, same spec version as the library) as an
+ * oracle: a {@code node node/oracle.js} child fed one request per line (operation and JSON-quoted string
+ * arguments separated by tabs) that answers one JSON string per request. Started lazily, once.
+ */
+final class Cmjs {
+    private Cmjs() {}
+
+    private static Process process;
+    private static BufferedWriter in;
+    private static BufferedReader out;
+    private static String failure;
+
+    /** The reference HTML of a document. */
+    static String html(String markdown) {
+        return call("html", markdown);
+    }
+
+    /** The reference HTML with unsafe URLs and raw HTML removed ({@code safe: true}). */
+    static String safeHtml(String markdown) {
+        return call("safe", markdown);
+    }
+
+    /** The reference tree, one node per line, indented by depth (see oracle.js). */
+    static String tree(String markdown) {
+        return call("tree", markdown);
+    }
+
+    static synchronized String call(String op, String... args) {
+        start();
+        if (failure != null) {
+            throw new IllegalStateException("commonmark.js oracle unavailable: " + failure);
+        }
+        StringBuilder sb = new StringBuilder(op);
+        for (String a : args) {
+            sb.append('\t').append(quote(a));
+        }
+        try {
+            in.write(sb.toString());
+            in.write('\n');
+            in.flush();
+            String reply = out.readLine();
+            if (reply == null) {
+                failure = "child exited";
+                throw new IllegalStateException("commonmark.js oracle exited (request " + sb + ")");
+            }
+            if (reply.startsWith("ERR")) {
+                throw new IllegalStateException("commonmark.js oracle: " + reply + " (request " + sb + ")");
+            }
+            return unquote(reply);
+        } catch (IOException e) {
+            failure = e.toString();
+            throw new IllegalStateException("commonmark.js oracle I/O failure", e);
+        }
+    }
+
+    private static void start() {
+        if (process != null || failure != null) {
+            return;
+        }
+        Path script = Paths.get(System.getProperty("basedir", "."), "node", "oracle.js").toAbsolutePath();
+        if (!Files.isRegularFile(script)) {
+            failure = "missing " + script;
+            return;
+        }
+        try {
+            ProcessBuilder pb = new ProcessBuilder("node", script.toString());
+            pb.redirectError(ProcessBuilder.Redirect.INHERIT);
+            process = pb.start();
+            in = new BufferedWriter(new OutputStreamWriter(process.getOutputStream(), StandardCharsets.UTF_8));
+            out = new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8));
+            Runtime.getRuntime().addShutdownHook(new Thread(process::destroy));
+            String v = call("version");
+            if (!v.equals("0.31.2")) {
+                failure = "unexpected commonmark.js version " + v;
+            }
+        } catch (IOException e) {
+            failure = e.toString();
+        }
+    }
+
+    /** JSON string literal (JSON.parse on the other side). */
+    static String quote(String s) {
+        StringBuilder sb = new StringBuilder("\"");
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '"' || c == '\\') {
+                sb.append('\\').append(c);
+            } else if (c < 0x20 || c == 0x7f || c == '\u00a0' || c == '\u2028' || c == '\u2029' || (c >= 0xd800 && c <= 0xdfff)) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.append('"').toString();
+    }
+
+    /** The value of a JSON string literal as JSON.stringify writes it. */
+    static String unquote(String json) {
+        if (json.length() < 2 || json.charAt(0) != '"' || json.charAt(json.length() - 1) != '"') {
+            throw new IllegalStateException("not a JSON string: " + json);
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int i = 1; i < json.length() - 1; i++) {
+            char c = json.charAt(i);
+            if (c != '\\') {
+                sb.append(c);
+                continue;
+            }
+            char e = json.charAt(++i);
+            switch (e) {
+                case 'n' -> sb.append('\n');
+                case 't' -> sb.append('\t');
+                case 'r' -> sb.append('\r');
+                case 'b' -> sb.append('\b');
+                case 'f' -> sb.append('\f');
+                case 'u' -> {
+                    sb.append((char) Integer.parseInt(json.substring(i + 1, i + 5), 16));
+                    i += 4;
+                }
+                default -> sb.append(e);
+            }
+        }
+        return sb.toString();
+    }
+}
diff --git a/hegel/src/test/java/zoo/CommonmarkPinsTest.java b/hegel/src/test/java/zoo/CommonmarkPinsTest.java
new file mode 100644
index 0000000..a4c7924
--- /dev/null
+++ b/hegel/src/test/java/zoo/CommonmarkPinsTest.java
@@ -0,0 +1,473 @@
+package zoo;
+
+import static zoo.Zoo.check;
+import static zoo.Zoo.show;
+
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import org.commonmark.Extension;
+import org.commonmark.ext.autolink.AutolinkExtension;
+import org.commonmark.ext.footnotes.FootnotesExtension;
+import org.commonmark.ext.front.matter.YamlFrontMatterExtension;
+import org.commonmark.ext.front.matter.YamlFrontMatterVisitor;
+import org.commonmark.ext.gfm.alerts.Alert;
+import org.commonmark.ext.gfm.alerts.AlertsExtension;
+import org.commonmark.ext.gfm.tables.TablesExtension;
+import org.commonmark.ext.heading.anchor.HeadingAnchorExtension;
+import org.commonmark.ext.image.attributes.ImageAttributesExtension;
+import org.commonmark.ext.task.list.items.TaskListItemsExtension;
+import org.commonmark.node.BulletList;
+import org.commonmark.node.Document;
+import org.commonmark.node.Image;
+import org.commonmark.node.Link;
+import org.commonmark.node.ListItem;
+import org.commonmark.node.Text;
+import org.commonmark.node.Node;
+import org.commonmark.node.Paragraph;
+import org.commonmark.node.SourceSpan;
+import org.commonmark.parser.IncludeSourceSpans;
+import org.commonmark.parser.Parser;
+import org.commonmark.renderer.html.HtmlRenderer;
+import org.commonmark.renderer.markdown.MarkdownRenderer;
+import org.commonmark.renderer.text.TextContentRenderer;
+import org.junit.jupiter.api.Test;
+
+/**
+ * One pin per recorded bug (bugs.toml). Each asserts the behaviour the CommonMark spec 0.31.2 / the GFM spec / the
+ * extension's documentation calls for, so it fails while the bug is there and passes once it is fixed.
+ */
+class CommonmarkPinsTest {
+
+    static final Parser P = Parser.builder().build();
+    static final HtmlRenderer H = HtmlRenderer.builder().build();
+    static final MarkdownRenderer M = MarkdownRenderer.builder().build();
+
+    static String html(String md) {
+        return H.render(P.parse(md));
+    }
+
+    static String html(String md, Extension... exts) {
+        List<Extension> e = List.of(exts);
+        return HtmlRenderer.builder().extensions(e).build().render(Parser.builder().extensions(e).build().parse(md));
+    }
+
+    /** HTML after a Markdown round trip through the renderer. */
+    static String roundTrip(String md, Extension... exts) {
+        List<Extension> e = List.of(exts);
+        Parser p = Parser.builder().extensions(e).build();
+        MarkdownRenderer m = MarkdownRenderer.builder().extensions(e).build();
+        HtmlRenderer h = HtmlRenderer.builder().extensions(e).build();
+        return h.render(p.parse(m.render(p.parse(md))));
+    }
+
+    static void same(String what, String expected, String actual) {
+        check(expected.equals(actual), () -> what + "\n  expected " + show(expected) + "\n  actual   " + show(actual));
+    }
+
+    // ---- parser (spec 0.31.2) ---------------------------------------------------------------------------------------
+
+    @Test
+    void pinLooseListAfterThematicBreak() {
+        // spec §Lists: "a list is loose if ... any of its constituent list items directly contain two block-level
+        // elements with a blank line between them"
+        same("- ***\\n\\n  foo", "<ul>\n<li>\n<hr />\n<p>foo</p>\n</li>\n</ul>\n", html("- ***\n\n  foo\n"));
+        same("- # h\\n\\n  foo", "<ul>\n<li>\n<h1>h</h1>\n<p>foo</p>\n</li>\n</ul>\n", html("- # h\n\n  foo\n"));
+        same("2.     a\\n\\n   a", "<ol start=\"2\">\n<li>\n<pre><code>a\n</code></pre>\n<p>a</p>\n</li>\n</ol>\n", html("2.     a\n\n   a\n"));
+    }
+
+    @Test
+    void pinPartialTabInFencedCode() {
+        // spec §Tabs: a tab is expanded to the next tab stop for indentation; "up to N spaces of indentation are
+        // removed from each line of the content" of a fence indented N spaces, so a tab loses N columns
+        same(" ```\\n\\tx", "<pre><code>   x\n</code></pre>\n", html(" ```\n\tx\n```\n"));
+        same(">```\\n>\\tx", "<blockquote>\n<pre><code>  x\n</code></pre>\n</blockquote>\n", html(">```\n>\tx\n>```\n"));
+        // the same for an HTML block: two columns of the tab remain after the quote marker's optional space
+        same(">\\t<!DOCTYPE html>", "<blockquote>\n  <!DOCTYPE html>\n</blockquote>\n", html(">\t<!DOCTYPE html>\n"));
+    }
+
+    @Test
+    void pinInfoStringFirstWordEndsAtTab() {
+        // spec §Fenced code blocks: "The first word of the info string is typically used to specify the language"
+        same("~~~a\\tb", "<pre><code class=\"language-a\"></code></pre>\n", html("~~~a\tb\n~~~\n"));
+    }
+
+    @Test
+    void pinUnbalancedParenthesisInDestination() {
+        // spec §Links: a destination "includes parentheses only if (a) they are backslash-escaped or (b) they are part
+        // of a balanced pair of unescaped parentheses"
+        same("[a](( )", "<p>[a](( )</p>\n", html("[a](( )\n"));
+        same("[a]:(", "<p>[a]:(</p>\n", html("[a]:(\n"));
+    }
+
+    @Test
+    void pinHtmlBlockStartWithLowercaseDeclaration() {
+        // spec §HTML blocks, start condition 4: "line begins with the string <! followed by an ASCII letter"
+        same("<!x>", "<!x>\n", html("<!x>\n"));
+    }
+
+    @Test
+    void pinSurrogateCharacterReference() {
+        // spec §Entity and numeric character references: "Invalid Unicode code points will be replaced by the
+        // REPLACEMENT CHARACTER (U+FFFD)"; a surrogate code point is not a Unicode scalar value
+        same("&#xD800;", "<p>\uFFFD</p>\n", html("&#xD800;\n"));
+    }
+
+    @Test
+    void pinFenceFollowedByTheOtherFenceCharacter() {
+        // spec §Fenced code blocks: a backtick fence's info string "may not contain any backtick characters"; tildes
+        // are fine, and "Info strings for tilde code blocks can contain backticks and tildes"
+        same("```~", "<pre><code class=\"language-~\">a\n</code></pre>\n", html("```~\na\n```\n"));
+        same("~~~`", "<pre><code class=\"language-`\">a\n</code></pre>\n", html("~~~`\na\n~~~\n"));
+    }
+
+    @Test
+    void pinAltTextKeepsRawHtml() {
+        // the alt text is the plain string content of the description: both reference implementations keep raw HTML
+        // (cmark escapes it) as they keep code spans, which this renderer does keep
+        same("![`a` <b>c]()", "<p><img src=\"\" alt=\"a &lt;b&gt;c\" /></p>\n", html("![`a` <b>c]()\n"));
+    }
+
+    @Test
+    void pinHtmlBlockKeepsBlankLineInsideListItem() {
+        // an HTML block of kind 1 runs through blank lines until </pre>; the blank line is part of it even where it
+        // also ends the enclosing list item (commonmark.js and cmark keep it)
+        same("1. <pre>\n\n</pre>", "<ol>\n<li>\n<pre>\n\n</li>\n</ol>\n</pre>\n", html("1. <pre>\n\n</pre>\n"));
+    }
+
+    // ---- MarkdownRenderer -------------------------------------------------------------------------------------------
+
+    @Test
+    void pinRenderedHardBreakAtParagraphStart() {
+        same("\\\\\\na", "<p><br />\na</p>\n", roundTrip("\\\na\n"));
+        same("a  \\n \\\\\\na", "<p>a<br />\n<br />\na</p>\n", roundTrip("a  \n \\\na\n"));
+    }
+
+    @Test
+    void pinRenderedInfoStringStartingWithFenceCharacter() {
+        same("~~~ ~", "<pre><code class=\"language-~\">a\n</code></pre>\n", roundTrip("~~~ ~\na\n~~~\n"));
+        String md = M.render(P.parse("~~~ ~\na\n~~~\n"));
+        check(!md.startsWith("~~~~"), () -> "the info string is glued to the fence: " + show(md));
+    }
+
+    @Test
+    void pinRenderedNestedEmphasisSameDelimiter() {
+        same("__$_ —__", "<p><em><em>$</em> —</em>_</p>\n", roundTrip("__$_ —__\n"));
+        same("***a*a*", "<p>*<em><em>a</em>a</em></p>\n", roundTrip("***a*a*\n"));
+    }
+
+    @Test
+    void pinRenderedStrongEmphasisKeepsItsDelimiter() {
+        // MarkdownRenderer Javadoc: "if the Markdown was parsed again and compared against the original AST, it
+        // should be the same"; strong(em(a)) written as ***a*** parses as em(strong(a))
+        same("__*a*__", "<p><strong><em>a</em></strong></p>\n", roundTrip("__*a*__\n"));
+    }
+
+    @Test
+    void pinRenderedLeadingPlusEscaped() {
+        same("\\+ a", "<p>+ a</p>\n", roundTrip("\\+ a\n"));
+    }
+
+    @Test
+    void pinRenderedListItemPaddingAtMostFour() {
+        // "01.    a" has a content indent of 7; re-rendered with marker "1." and the same indent, five spaces follow
+        // the marker and the content becomes an indented code block
+        same("01.    a", "<ol>\n<li>a</li>\n</ol>\n", roundTrip("01.    a\n"));
+    }
+
+    @Test
+    void pinRenderedLeadingTildesEscaped() {
+        same("\\~~~", "<p>~~~</p>\n", roundTrip("\\~~~\n"));
+    }
+
+    @Test
+    void pinRenderedInfoStringAndDestinationReEscaped() {
+        // the parser decodes entity references in info strings and destinations; the renderer writes the decoded
+        // text raw, so a second parse decodes once more
+        same("```&amp;amp;", "<pre><code class=\"language-&amp;amp;\">c\n</code></pre>\n", roundTrip("```&amp;amp;\nc\n```\n"));
