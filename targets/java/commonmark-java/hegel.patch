diff --git a/hegel/src/test/java/zoo/Cmjs.java b/hegel/src/test/java/zoo/Cmjs.java
new file mode 100644
index 0000000..7f073da
--- /dev/null
+++ b/hegel/src/test/java/zoo/Cmjs.java
@@ -0,0 +1,138 @@
+package zoo;
+
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+
+/**
+ * commonmark.js (the reference implementation of the CommonMark spec, same spec version as the library) as an
+ * oracle: a {@code node node/oracle.js} child fed one request per line (operation and JSON-quoted string
+ * arguments separated by tabs) that answers one JSON string per request. Started lazily, once.
+ */
+final class Cmjs {
+    private Cmjs() {}
+
+    private static Process process;
+    private static BufferedWriter in;
+    private static BufferedReader out;
+    private static String failure;
+
+    /** The reference HTML of a document. */
+    static String html(String markdown) {
+        return call("html", markdown);
+    }
+
+    /** The reference HTML with unsafe URLs and raw HTML removed ({@code safe: true}). */
+    static String safeHtml(String markdown) {
+        return call("safe", markdown);
+    }
+
+    /** The reference tree, one node per line, indented by depth (see oracle.js). */
+    static String tree(String markdown) {
+        return call("tree", markdown);
+    }
+
+    static synchronized String call(String op, String... args) {
+        start();
+        if (failure != null) {
+            throw new IllegalStateException("commonmark.js oracle unavailable: " + failure);
+        }
+        StringBuilder sb = new StringBuilder(op);
+        for (String a : args) {
+            sb.append('\t').append(quote(a));
+        }
+        try {
+            in.write(sb.toString());
+            in.write('\n');
+            in.flush();
+            String reply = out.readLine();
+            if (reply == null) {
+                failure = "child exited";
+                throw new IllegalStateException("commonmark.js oracle exited (request " + sb + ")");
+            }
+            if (reply.startsWith("ERR")) {
+                throw new IllegalStateException("commonmark.js oracle: " + reply + " (request " + sb + ")");
+            }
+            return unquote(reply);
+        } catch (IOException e) {
+            failure = e.toString();
+            throw new IllegalStateException("commonmark.js oracle I/O failure", e);
+        }
+    }
+
+    private static void start() {
+        if (process != null || failure != null) {
+            return;
+        }
+        Path script = Paths.get(System.getProperty("basedir", "."), "node", "oracle.js").toAbsolutePath();
+        if (!Files.isRegularFile(script)) {
+            failure = "missing " + script;
+            return;
+        }
+        try {
+            ProcessBuilder pb = new ProcessBuilder("node", script.toString());
+            pb.redirectError(ProcessBuilder.Redirect.INHERIT);
+            process = pb.start();
+            in = new BufferedWriter(new OutputStreamWriter(process.getOutputStream(), StandardCharsets.UTF_8));
+            out = new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8));
+            Runtime.getRuntime().addShutdownHook(new Thread(process::destroy));
+            String v = call("version");
+            if (!v.equals("0.31.2")) {
+                failure = "unexpected commonmark.js version " + v;
+            }
+        } catch (IOException e) {
+            failure = e.toString();
+        }
+    }
+
+    /** JSON string literal (JSON.parse on the other side). */
+    static String quote(String s) {
+        StringBuilder sb = new StringBuilder("\"");
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '"' || c == '\\') {
+                sb.append('\\').append(c);
+            } else if (c < 0x20 || c == 0x7f || c == '\u00a0' || c == '\u2028' || c == '\u2029' || (c >= 0xd800 && c <= 0xdfff)) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.append('"').toString();
+    }
+
+    /** The value of a JSON string literal as JSON.stringify writes it. */
+    static String unquote(String json) {
+        if (json.length() < 2 || json.charAt(0) != '"' || json.charAt(json.length() - 1) != '"') {
+            throw new IllegalStateException("not a JSON string: " + json);
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int i = 1; i < json.length() - 1; i++) {
+            char c = json.charAt(i);
+            if (c != '\\') {
+                sb.append(c);
+                continue;
+            }
+            char e = json.charAt(++i);
+            switch (e) {
+                case 'n' -> sb.append('\n');
+                case 't' -> sb.append('\t');
+                case 'r' -> sb.append('\r');
+                case 'b' -> sb.append('\b');
+                case 'f' -> sb.append('\f');
+                case 'u' -> {
+                    sb.append((char) Integer.parseInt(json.substring(i + 1, i + 5), 16));
+                    i += 4;
+                }
+                default -> sb.append(e);
+            }
+        }
+        return sb.toString();
+    }
+}
diff --git a/hegel/src/test/java/zoo/CommonmarkPinsTest.java b/hegel/src/test/java/zoo/CommonmarkPinsTest.java
new file mode 100644
index 0000000..a4c7924
--- /dev/null
+++ b/hegel/src/test/java/zoo/CommonmarkPinsTest.java
@@ -0,0 +1,473 @@
+package zoo;
+
+import static zoo.Zoo.check;
+import static zoo.Zoo.show;
+
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import org.commonmark.Extension;
+import org.commonmark.ext.autolink.AutolinkExtension;
+import org.commonmark.ext.footnotes.FootnotesExtension;
+import org.commonmark.ext.front.matter.YamlFrontMatterExtension;
+import org.commonmark.ext.front.matter.YamlFrontMatterVisitor;
+import org.commonmark.ext.gfm.alerts.Alert;
+import org.commonmark.ext.gfm.alerts.AlertsExtension;
+import org.commonmark.ext.gfm.tables.TablesExtension;
+import org.commonmark.ext.heading.anchor.HeadingAnchorExtension;
+import org.commonmark.ext.image.attributes.ImageAttributesExtension;
+import org.commonmark.ext.task.list.items.TaskListItemsExtension;
+import org.commonmark.node.BulletList;
+import org.commonmark.node.Document;
+import org.commonmark.node.Image;
+import org.commonmark.node.Link;
+import org.commonmark.node.ListItem;
+import org.commonmark.node.Text;
+import org.commonmark.node.Node;
+import org.commonmark.node.Paragraph;
+import org.commonmark.node.SourceSpan;
+import org.commonmark.parser.IncludeSourceSpans;
+import org.commonmark.parser.Parser;
+import org.commonmark.renderer.html.HtmlRenderer;
+import org.commonmark.renderer.markdown.MarkdownRenderer;
+import org.commonmark.renderer.text.TextContentRenderer;
+import org.junit.jupiter.api.Test;
+
+/**
+ * One pin per recorded bug (bugs.toml). Each asserts the behaviour the CommonMark spec 0.31.2 / the GFM spec / the
+ * extension's documentation calls for, so it fails while the bug is there and passes once it is fixed.
+ */
+class CommonmarkPinsTest {
+
+    static final Parser P = Parser.builder().build();
+    static final HtmlRenderer H = HtmlRenderer.builder().build();
+    static final MarkdownRenderer M = MarkdownRenderer.builder().build();
+
+    static String html(String md) {
+        return H.render(P.parse(md));
+    }
+
+    static String html(String md, Extension... exts) {
+        List<Extension> e = List.of(exts);
+        return HtmlRenderer.builder().extensions(e).build().render(Parser.builder().extensions(e).build().parse(md));
+    }
+
+    /** HTML after a Markdown round trip through the renderer. */
+    static String roundTrip(String md, Extension... exts) {
+        List<Extension> e = List.of(exts);
+        Parser p = Parser.builder().extensions(e).build();
+        MarkdownRenderer m = MarkdownRenderer.builder().extensions(e).build();
+        HtmlRenderer h = HtmlRenderer.builder().extensions(e).build();
+        return h.render(p.parse(m.render(p.parse(md))));
+    }
+
+    static void same(String what, String expected, String actual) {
+        check(expected.equals(actual), () -> what + "\n  expected " + show(expected) + "\n  actual   " + show(actual));
+    }
+
+    // ---- parser (spec 0.31.2) ---------------------------------------------------------------------------------------
+
+    @Test
+    void pinLooseListAfterThematicBreak() {
+        // spec §Lists: "a list is loose if ... any of its constituent list items directly contain two block-level
+        // elements with a blank line between them"
+        same("- ***\\n\\n  foo", "<ul>\n<li>\n<hr />\n<p>foo</p>\n</li>\n</ul>\n", html("- ***\n\n  foo\n"));
+        same("- # h\\n\\n  foo", "<ul>\n<li>\n<h1>h</h1>\n<p>foo</p>\n</li>\n</ul>\n", html("- # h\n\n  foo\n"));
+        same("2.     a\\n\\n   a", "<ol start=\"2\">\n<li>\n<pre><code>a\n</code></pre>\n<p>a</p>\n</li>\n</ol>\n", html("2.     a\n\n   a\n"));
+    }
+
+    @Test
+    void pinPartialTabInFencedCode() {
+        // spec §Tabs: a tab is expanded to the next tab stop for indentation; "up to N spaces of indentation are
+        // removed from each line of the content" of a fence indented N spaces, so a tab loses N columns
+        same(" ```\\n\\tx", "<pre><code>   x\n</code></pre>\n", html(" ```\n\tx\n```\n"));
+        same(">```\\n>\\tx", "<blockquote>\n<pre><code>  x\n</code></pre>\n</blockquote>\n", html(">```\n>\tx\n>```\n"));
+        // the same for an HTML block: two columns of the tab remain after the quote marker's optional space
+        same(">\\t<!DOCTYPE html>", "<blockquote>\n  <!DOCTYPE html>\n</blockquote>\n", html(">\t<!DOCTYPE html>\n"));
+    }
+
+    @Test
+    void pinInfoStringFirstWordEndsAtTab() {
+        // spec §Fenced code blocks: "The first word of the info string is typically used to specify the language"
+        same("~~~a\\tb", "<pre><code class=\"language-a\"></code></pre>\n", html("~~~a\tb\n~~~\n"));
+    }
+
+    @Test
+    void pinUnbalancedParenthesisInDestination() {
+        // spec §Links: a destination "includes parentheses only if (a) they are backslash-escaped or (b) they are part
+        // of a balanced pair of unescaped parentheses"
+        same("[a](( )", "<p>[a](( )</p>\n", html("[a](( )\n"));
+        same("[a]:(", "<p>[a]:(</p>\n", html("[a]:(\n"));
+    }
+
+    @Test
+    void pinHtmlBlockStartWithLowercaseDeclaration() {
+        // spec §HTML blocks, start condition 4: "line begins with the string <! followed by an ASCII letter"
+        same("<!x>", "<!x>\n", html("<!x>\n"));
+    }
+
+    @Test
+    void pinSurrogateCharacterReference() {
+        // spec §Entity and numeric character references: "Invalid Unicode code points will be replaced by the
+        // REPLACEMENT CHARACTER (U+FFFD)"; a surrogate code point is not a Unicode scalar value
+        same("&#xD800;", "<p>\uFFFD</p>\n", html("&#xD800;\n"));
+    }
+
+    @Test
+    void pinFenceFollowedByTheOtherFenceCharacter() {
+        // spec §Fenced code blocks: a backtick fence's info string "may not contain any backtick characters"; tildes
+        // are fine, and "Info strings for tilde code blocks can contain backticks and tildes"
+        same("```~", "<pre><code class=\"language-~\">a\n</code></pre>\n", html("```~\na\n```\n"));
+        same("~~~`", "<pre><code class=\"language-`\">a\n</code></pre>\n", html("~~~`\na\n~~~\n"));
+    }
+
+    @Test
+    void pinAltTextKeepsRawHtml() {
+        // the alt text is the plain string content of the description: both reference implementations keep raw HTML
+        // (cmark escapes it) as they keep code spans, which this renderer does keep
+        same("![`a` <b>c]()", "<p><img src=\"\" alt=\"a &lt;b&gt;c\" /></p>\n", html("![`a` <b>c]()\n"));
+    }
+
+    @Test
+    void pinHtmlBlockKeepsBlankLineInsideListItem() {
+        // an HTML block of kind 1 runs through blank lines until </pre>; the blank line is part of it even where it
+        // also ends the enclosing list item (commonmark.js and cmark keep it)
+        same("1. <pre>\n\n</pre>", "<ol>\n<li>\n<pre>\n\n</li>\n</ol>\n</pre>\n", html("1. <pre>\n\n</pre>\n"));
+    }
+
+    // ---- MarkdownRenderer -------------------------------------------------------------------------------------------
+
+    @Test
+    void pinRenderedHardBreakAtParagraphStart() {
+        same("\\\\\\na", "<p><br />\na</p>\n", roundTrip("\\\na\n"));
+        same("a  \\n \\\\\\na", "<p>a<br />\n<br />\na</p>\n", roundTrip("a  \n \\\na\n"));
+    }
+
+    @Test
+    void pinRenderedInfoStringStartingWithFenceCharacter() {
+        same("~~~ ~", "<pre><code class=\"language-~\">a\n</code></pre>\n", roundTrip("~~~ ~\na\n~~~\n"));
+        String md = M.render(P.parse("~~~ ~\na\n~~~\n"));
+        check(!md.startsWith("~~~~"), () -> "the info string is glued to the fence: " + show(md));
+    }
+
+    @Test
+    void pinRenderedNestedEmphasisSameDelimiter() {
+        same("__$_ —__", "<p><em><em>$</em> —</em>_</p>\n", roundTrip("__$_ —__\n"));
+        same("***a*a*", "<p>*<em><em>a</em>a</em></p>\n", roundTrip("***a*a*\n"));
+    }
+
+    @Test
+    void pinRenderedStrongEmphasisKeepsItsDelimiter() {
+        // MarkdownRenderer Javadoc: "if the Markdown was parsed again and compared against the original AST, it
+        // should be the same"; strong(em(a)) written as ***a*** parses as em(strong(a))
+        same("__*a*__", "<p><strong><em>a</em></strong></p>\n", roundTrip("__*a*__\n"));
+    }
+
+    @Test
+    void pinRenderedLeadingPlusEscaped() {
+        same("\\+ a", "<p>+ a</p>\n", roundTrip("\\+ a\n"));
+    }
+
+    @Test
+    void pinRenderedListItemPaddingAtMostFour() {
+        // "01.    a" has a content indent of 7; re-rendered with marker "1." and the same indent, five spaces follow
+        // the marker and the content becomes an indented code block
+        same("01.    a", "<ol>\n<li>a</li>\n</ol>\n", roundTrip("01.    a\n"));
+    }
+
+    @Test
+    void pinRenderedLeadingTildesEscaped() {
+        same("\\~~~", "<p>~~~</p>\n", roundTrip("\\~~~\n"));
+    }
+
+    @Test
+    void pinRenderedInfoStringAndDestinationReEscaped() {
+        // the parser decodes entity references in info strings and destinations; the renderer writes the decoded
+        // text raw, so a second parse decodes once more
+        same("```&amp;amp;", "<pre><code class=\"language-&amp;amp;\">c\n</code></pre>\n", roundTrip("```&amp;amp;\nc\n```\n"));
+        same("[a](<u&amp;amp;v>)", "<p><a href=\"u&amp;amp;v\">a</a></p>\n", roundTrip("[a](<u&amp;amp;v>)\n"));
+    }
+
+    @Test
+    void pinInlineDeclarationWithoutWhitespace() {
+        // spec §Raw HTML: "A declaration consists of the string <!, an ASCII letter, zero or more characters not
+        // including the character >, and the character >"
+        same("foo <!A>", "<p>foo <!A></p>\n", html("foo <!A>\n"));
+    }
+
+    @Test
+    void pinVerticalTabIsNotLinkWhitespace() {
+        // spec §Links: the parts of an inline link are separated by "spaces or tabs (including up to one line
+        // ending)"; U+000B is an ASCII control character and cannot appear in a destination either
+        same("[a](\u000bb)", "<p>[a](\u000bb)</p>\n", html("[a](\u000bb)\n"));
+    }
+
+    @Test
+    void pinLabelNormalisationStripsOnlyWhitespace() {
+        // spec §Matching: "strip leading and trailing spaces, tabs, and line endings" — U+0001 is none of these
+        same("[\u0001a]: /u  [a]", "<p>[a]</p>\n", html("[\u0001a]: /u\n\n[a]\n"));
+    }
+
+    @Test
+    void pinInsertAfterOnDetachedNode() {
+        Paragraph a = new Paragraph();
+        Paragraph b = new Paragraph();
+        check(!Zoo.throwsA(NullPointerException.class, () -> a.insertAfter(b)), "insertAfter on a node without a parent throws NullPointerException");
+        check(!Zoo.throwsA(NullPointerException.class, () -> new Paragraph().insertBefore(new Paragraph())), "insertBefore on a node without a parent throws NullPointerException");
+    }
+
+    @Test
+    void pinTextContentOfBulletListWithoutMarker() {
+        // the Markdown renderer and OrderedList default missing fields; a hand-built BulletList has no marker
+        BulletList list = new BulletList();
+        ListItem item = new ListItem();
+        Paragraph p = new Paragraph();
+        p.appendChild(new Text("x"));
+        item.appendChild(p);
+        list.appendChild(item);
+        Document doc = new Document();
+        doc.appendChild(list);
+        check(!Zoo.throwsA(NullPointerException.class, () -> TextContentRenderer.builder().build().render(doc)), "TextContentRenderer throws NullPointerException on a BulletList without a marker");
+    }
+
+    @Test
+    void pinParagraphSpanExcludesMarkerTab() {
+        // ">\tfoo": the tab is the quote marker's optional space (one column of it) plus two columns of content; the
+        // paragraph's span must start where its text does, as it does with ">  foo"
+        Node doc = SPANS.parse(">\tfoo\n");
+        Node para = doc.getFirstChild().getFirstChild();
+        SourceSpan ps = para.getSourceSpans().get(0);
+        SourceSpan ts = para.getFirstChild().getSourceSpans().get(0);
+        check(ps.getInputIndex() == ts.getInputIndex(), () -> "paragraph span " + ps + " starts before its text " + ts);
+    }
+
+    @Test
+    void pinRenderedInlineHtmlLineStartingWithBlockQuoteMarker() {
+        same("<a\\n    >", "<p><a\n></p>\n", roundTrip("<a\n    >\n"));
+    }
+
+    @Test
+    void pinRenderedAutolinkInsideLinkText() {
+        same("[<a@a>]()", "<p><a href=\"\"><a href=\"mailto:a@a\">a@a</a></a></p>\n", roundTrip("[<a@a>]()\n"));
+    }
+
+    @Test
+    void pinRenderedThematicBreakInBulletItem() {
+        same("*\\n  ***", "<ul>\n<li>\n<hr />\n</li>\n</ul>\n", roundTrip("*\n  ***\n"));
+    }
+
+    @Test
+    void pinRenderedEntityAfterEmphasisCloser() {
+        same("**.**&AElig;", "<p><strong>.</strong>\u00C6</p>\n", roundTrip("**.**&AElig;\n"));
+    }
+
+    @Test
+    void pinRenderedDefinitionKeepsListLoose() {
+        // the definition is the item's second block; dropping it from the output makes the list tight
+        same("- Q\n\n  [Foo]: /url", "<ul>\n<li>\n<p>Q</p>\n</li>\n</ul>\n", roundTrip("- Q\n\n  [Foo]: /url\n"));
+    }
+
+    @Test
+    void pinRenderedSpaceBeforeHardBreak() {
+        // "r \\" + line ending is the text "r " followed by a hard break; written as "r   \n" the spaces all belong to the break
+        same("r \\\\\\na", "<p>r <br />\na</p>\n", roundTrip("r \\\na\n"));
+    }
+
+    // ---- source spans -----------------------------------------------------------------------------------------------
+
+    static Parser SPANS = Parser.builder().includeSourceSpans(IncludeSourceSpans.BLOCKS_AND_INLINES).build();
+
+    @Test
+    void pinParagraphSpanOnLazyLineInsideItemSpan() {
+        // a child's span lies within its parent's: the item's span on the lazy line covers the paragraph text
+        Node doc = SPANS.parse(">- a\nb\n **\n");
+        Node item = doc.getFirstChild().getFirstChild().getFirstChild();
+        Node para = item.getFirstChild();
+        List<SourceSpan> itemSpans = item.getSourceSpans();
+        List<SourceSpan> paraSpans = para.getSourceSpans();
+        SourceSpan lazyItem = itemSpans.get(2);
+        SourceSpan lazyPara = paraSpans.get(2);
+        check(lazyPara.getInputIndex() >= lazyItem.getInputIndex()
+            && lazyPara.getInputIndex() + lazyPara.getLength() <= lazyItem.getInputIndex() + lazyItem.getLength(),
+            () -> "paragraph span " + lazyPara + " lies outside the list item's " + lazyItem + " on the lazy line");
+    }
+
+    @Test
+    void pinItemSpanOnLazyLineInsideListSpan() {
+        Node doc = SPANS.parse(">0) a\n> b\n");
+        Node list = doc.getFirstChild().getFirstChild();
+        Node item = list.getFirstChild();
+        SourceSpan lazyList = list.getSourceSpans().get(1);
+        SourceSpan lazyItem = item.getSourceSpans().get(1);
+        check(lazyItem.getInputIndex() >= lazyList.getInputIndex()
+            && lazyItem.getInputIndex() + lazyItem.getLength() <= lazyList.getInputIndex() + lazyList.getLength(),
+            () -> "list item span " + lazyItem + " lies outside the list's " + lazyList + " on the lazy line");
+    }
+
+    @Test
+    void pinParagraphAfterDefinitionHasSpans() {
+        // "[foo]: /url" then a line that fails as a title: the line is a paragraph, and it has a span like any other
+        Node doc = SPANS.parse("[foo]: /url\n\"x\n");
+        Node para = doc.getLastChild();
+        check(para instanceof Paragraph && !para.getSourceSpans().isEmpty(), () -> "paragraph spans " + para.getSourceSpans() + " for " + para);
+    }
+
+    // ---- extensions -------------------------------------------------------------------------------------------------
+
+    @Test
+    void pinUnterminatedFrontMatter() {
+        // without a closing "---" there is no front matter: the document is ordinary Markdown
+        String md = "---\nkey: value\n\nHello world\n";
+        String out = html(md, YamlFrontMatterExtension.create());
+        same("unterminated front matter", html(md), out);
+    }
+
+    @Test
+    void pinImageAttributesSurviveRendering() {
+        List<Extension> e = List.of(ImageAttributesExtension.create());
+        Node doc = Parser.builder().extensions(e).build().parse("![t](/u.png){width=5 height=6}\n");
+        HtmlRenderer h = HtmlRenderer.builder().extensions(e).build();
+        String first = h.render(doc);
+        String second = h.render(doc);
+        same("rendering twice", first, second);
+    }
+
+    @Test
+    void pinFrontMatterLiteralBlockKeepsKeyLikeLines() {
+        // README: "literal: |\n  this is literal value.\n  literal values 2" — indented lines are the value
+        Node doc = Parser.builder().extensions(List.of(YamlFrontMatterExtension.create())).build()
+            .parse("---\ndesc: |\n  key: value\n  more\n---\n\nHi\n");
+        Map<String, List<String>> data = YamlFrontMatterVisitor.readData(doc);
+        check(data.equals(Map.of("desc", List.of("key: value\nmore"))) || data.equals(Map.of("desc", List.of("key: value", "more"))),
+            () -> "front matter data " + data);
+    }
+
+    @Test
+    void pinEmptyFootnoteDefinitionRendering() {
+        same("[^foo]:\\n\\ntext", html("[^foo]:\n\ntext\n", FootnotesExtension.create()), roundTrip("[^foo]:\n\ntext\n", FootnotesExtension.create()));
+    }
+
+    @Test
+    void pinTableNeedsHeaderCells() {
+        // GFM §Tables: "The header row must match the delimiter row in the number of cells"; a header row of "|"
+        // has no cells, so this is not a table
+        same("|\\n|-|\\n|x|", "<p>|\n|-|\n|x|</p>\n", html("|\n|-|\n|x|\n", TablesExtension.create()));
+    }
+
+    @Test
+    void pinTableCellEscapedBackslashBeforePipe() {
+        // "\\\\|": an escaped backslash, then a cell delimiter; the cell holds one backslash
+        same("|\\\\|", "<table>\n<thead>\n<tr>\n<th>\\</th>\n</tr>\n</thead>\n</table>\n", html("|\\\\|\n|-|\n", TablesExtension.create()));
+    }
+
+    @Test
+    void pinTaskListCheckboxInsideParagraph() {
+        // GFM §Task list items: the checkbox replaces the marker "as the first child of the paragraph"
+        same("- [ ] a\\n\\n- [x] b", "<ul>\n<li>\n<p><input type=\"checkbox\" disabled=\"\"> a</p>\n</li>\n<li>\n<p><input type=\"checkbox\" disabled=\"\" checked=\"\"> b</p>\n</li>\n</ul>\n",
+            html("- [ ] a\n\n- [x] b\n", TaskListItemsExtension.create()));
+    }
+
+    @Test
+    void pinHeadingIdSeparatesLines() {
+        // README: "The id is based on the text of the heading" — the text of "Foo\nbar" is "Foo bar" (a soft break
+        // renders as a space), whose id is foo-bar
+        same("Foo\\nbar\\n===", "<h1 id=\"foo-bar\">Foo\nbar</h1>\n", html("Foo\nbar\n===\n", HeadingAnchorExtension.create()));
+    }
+
+    @Test
+    void pinFootnoteReferenceIdsUnique() {
+        String out = html("a[^foo][^foo][^foo-2]\n\n[^foo]: one\n\n[^foo-2]: two\n", FootnotesExtension.create());
+        int first = out.indexOf("id=\"fnref-foo-2\"");
+        int second = out.indexOf("id=\"fnref-foo-2\"", first + 1);
+        check(first >= 0 && second < 0, () -> "duplicate reference id fnref-foo-2 in " + show(out));
+    }
+
+    @Test
+    void pinDelimiterRowMustMatchHeader() {
+        // GFM §Tables: "The header row must match the delimiter row in the number of cells. If not, a table will not
+        // be recognized"
+        same("| abc |\\n| --- | --- |", "<p>| abc |\n| --- | --- |\n| bar |</p>\n", html("| abc |\n| --- | --- |\n| bar |\n", TablesExtension.create()));
+    }
+
+    @Test
+    void pinTableEndsAtBlockStart() {
+        // GFM §Tables: "The table is broken at the first empty line, or beginning of another block-level structure"
+        same("|a|\\n|-|\\n> b|c", "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n</table>\n<blockquote>\n<p>b|c</p>\n</blockquote>\n",
+            html("|a|\n|-|\n> b|c\n", TablesExtension.create()));
+    }
+
+    @Test
+    void pinHeadingIdIgnoresDefaultLocale() {
+        Locale old = Locale.getDefault();
+        try {
+            Locale.setDefault(Locale.forLanguageTag("tr-TR"));
+            same("# INTRO", "<h1 id=\"intro\">INTRO</h1>\n", html("# INTRO\n", HeadingAnchorExtension.create()));
+        } finally {
+            Locale.setDefault(old);
+        }
+    }
+
+    @Test
+    void pinAutolinkLeavesImageDescriptionAlone() {
+        // the extension skips link text (a link cannot contain a link); an image description is the same case, and
+        // the Markdown renderer cannot express a link inside it
+        Node doc = Parser.builder().extensions(List.of(AutolinkExtension.create())).build().parse("![www.example.com](/x)\n");
+        Node image = doc.getFirstChild().getFirstChild();
+        check(image instanceof Image && !(image.getFirstChild() instanceof Link), () -> "the image description was autolinked: " + image.getFirstChild());
+    }
+
+    @Test
+    void pinFrontMatterOnlyAtDocumentStart() {
+        Node doc = Parser.builder().extensions(List.of(YamlFrontMatterExtension.create())).build().parse("\n---\nkey: value\n---\n\nHi\n");
+        Map<String, List<String>> data = YamlFrontMatterVisitor.readData(doc);
+        check(data.isEmpty(), () -> "front matter after a blank line: " + data);
+    }
+
+    @Test
+    void pinImageAttributesWithLeadingSpace() {
+        // "{width=5 }" is accepted, so "{ width=5}" must be too (README: key=value pairs inside curly braces)
+        same("![t](/u.png){ width=5}", html("![t](/u.png){width=5 }\n", ImageAttributesExtension.create()), html("![t](/u.png){ width=5}\n", ImageAttributesExtension.create()));
+    }
+
+    @Test
+    void pinAlertRendererAcceptsAnyType() {
+        Document doc = new Document();
+        Alert alert = new Alert("BUG");
+        Paragraph p = new Paragraph();
+        alert.appendChild(p);
+        doc.appendChild(alert);
+        List<Extension> e = List.of(AlertsExtension.create());
+        HtmlRenderer h = HtmlRenderer.builder().extensions(e).build();
+        check(!Zoo.throwsA(RuntimeException.class, () -> h.render(doc)), "HtmlRenderer throws on an Alert of an unknown type");
+    }
+
+    @Test
+    void pinRenderedCaretBeforeBracketWithInlineFootnotes() {
+        Extension f = FootnotesExtension.builder().inlineFootnotes(true).build();
+        same("Test \\\\^[foo](/url)", html("Test \\^[foo](/url)\n", f), roundTrip("Test \\^[foo](/url)\n", f));
+    }
+
+    @Test
+    void pinRenderedNestedListIndentStaysInsideItem() {
+        // "-\n   - a\n\n  b": the item starts with a blank line (content indent 2) and holds a nested list indented one
+        // more and a paragraph; the renderer writes the nested list's indent on the item's first line ("-  - a"), which
+        // makes the content indent 3 on re-parse, and "  b" falls out of the item
+        same("-\\n   - a\\n\\n  b", html("-\n   - a\n\n  b\n"), roundTrip("-\n   - a\n\n  b\n"));
+    }
+
+    @Test
+    void pinRenderedEmptyDestinationWithTitle() {
+        // "[a](<> \"t\")": an empty destination with a title is written as "[a]( \"t\")", and the title re-parses as the
+        // destination (the renderer must write "<>" for an empty destination when a title follows)
+        same("[a](<> \"t\")", html("[a](<> \"t\")\n"), roundTrip("[a](<> \"t\")\n"));
+        same("![a](<> \"t\")", html("![a](<> \"t\")\n"), roundTrip("![a](<> \"t\")\n"));
+    }
+
+    @Test
+    void pinCodeSpanAfterUnclosedBackticks() {
+        // spec §Code spans: the unclosed "``" is literal, "`a`" and "`c`" are code spans (commonmark.js, cmark agree);
+        // BackticksInlineParser's cache of the last backtick run per length is overwritten by the scan that closes "`a`",
+        // so the opener of "`c`" believes there is no closer after it
+        same("`` `a` `c`", "<p>`` <code>a</code> <code>c</code></p>\n", html("`` `a` `c`\n"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/CoreTest.java b/hegel/src/test/java/zoo/CoreTest.java
new file mode 100644
index 0000000..3cfa02f
--- /dev/null
+++ b/hegel/src/test/java/zoo/CoreTest.java
@@ -0,0 +1,57 @@
+package zoo;
+
+import static zoo.Zoo.check;
+import static zoo.Zoo.show;
+
+import org.commonmark.node.Node;
+import org.commonmark.parser.IncludeSourceSpans;
+import org.commonmark.parser.Parser;
+import org.commonmark.renderer.html.HtmlRenderer;
+import org.junit.jupiter.api.Test;
+
+/** The core parser and HTML renderer against commonmark.js, the reference implementation of spec 0.31.2. */
+class CoreTest {
+
+    static final Parser PARSER = Parser.builder().includeSourceSpans(IncludeSourceSpans.BLOCKS).build();
+    static final HtmlRenderer HTML = HtmlRenderer.builder().percentEncodeUrls(true).build();
+
+    @Test
+    void htmlMatchesCommonmarkJs() {
+        Zoo.property("commonmark-java.htmlMatchesCommonmarkJs", tc -> {
+            String md = MdGen.document(tc, false);
+            String expected = Cmjs.html(md);
+            Node doc = PARSER.parse(md);
+            String actual = HTML.render(doc);
+            if (same(md, actual, expected) || Known.differential(md, doc, actual)) {
+                return;
+            }
+            check(actual.equals(expected), () -> "HTML differs from commonmark.js for " + show(md) + "\n  expected " + show(expected) + "\n  actual   " + show(actual));
+        });
+    }
+
+    /**
+     * Differences that are commonmark.js's, not the library's (checked against the spec text, see the README): the
+     * reference trims Unicode spaces (U+00A0, U+2003, …) off paragraphs as JavaScript whitespace (the spec's blank characters are space and tab),
+     * and it omits an empty title attribute where the library writes {@code title=""} (the spec leaves this open).
+     */
+    /** What JavaScript's trim strips beyond ASCII whitespace: the Zs spaces, the line and paragraph separators, the BOM. */
+    static final java.util.regex.Pattern UNICODE_SPACE = java.util.regex.Pattern.compile("[\\p{Zs}&&[^ ]]|[\\u2028\\u2029\\uFEFF]");
+
+    static boolean same(String md, String actual, String expected) {
+        String a = actual.replace(" title=\"\"", "");
+        String e = expected;
+        if (UNICODE_SPACE.matcher(md).find()) {
+            // the Unicode spaces other than U+0020 (Zs minus the ASCII space) and the BOM are dropped from both; ASCII
+            // spaces must match, except at the edges of paragraphs and headings: commonmark.js trims a run of ASCII
+            // and Unicode spaces (and a line made of them alone, with its line ending) where the library keeps the ASCII
+            // spaces and the line before a Unicode space, as the spec says.
+            a = trimEdges(UNICODE_SPACE.matcher(a).replaceAll(""));
+            e = trimEdges(UNICODE_SPACE.matcher(e).replaceAll(""));
+        }
+        return a.equals(e);
+    }
+
+    static String trimEdges(String html) {
+        return html.replaceAll("(<(?:p|h[1-6])>)[ \\n]+", "$1").replaceAll("[ \\n]+(</(?:p|h[1-6])>)", "$1");
+    }
+}
diff --git a/hegel/src/test/java/zoo/GfmTest.java b/hegel/src/test/java/zoo/GfmTest.java
new file mode 100644
index 0000000..41b9764
--- /dev/null
+++ b/hegel/src/test/java/zoo/GfmTest.java
@@ -0,0 +1,223 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.show;
+import static zoo.Zoo.word;
+
+import dev.hegel.TestCase;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import org.commonmark.Extension;
+import org.commonmark.ext.autolink.AutolinkExtension;
+import org.commonmark.ext.front.matter.YamlFrontMatterExtension;
+import org.commonmark.ext.front.matter.YamlFrontMatterVisitor;
+import org.commonmark.ext.heading.anchor.HeadingAnchorExtension;
+import org.commonmark.ext.image.attributes.ImageAttributesExtension;
+import org.commonmark.node.Node;
+import org.commonmark.parser.Parser;
+import org.commonmark.renderer.html.HtmlRenderer;
+import org.commonmark.renderer.text.TextContentRenderer;
+import org.junit.jupiter.api.Test;
+
+/** The extensions: rendering is a pure function of the tree, YAML front matter against a model, tables against their source. */
+class GfmTest {
+
+    static final List<Extension> ALL = all();
+
+    static List<Extension> all() {
+        List<Extension> all = new ArrayList<>(RoundTripTest.GFM);
+        all.add(AutolinkExtension.create());
+        all.add(HeadingAnchorExtension.create());
+        all.add(ImageAttributesExtension.create());
+        return all;
+    }
+
+    static final Parser PARSER = Parser.builder().extensions(ALL).build();
+    static final HtmlRenderer HTML = HtmlRenderer.builder().extensions(ALL).build();
+    static final TextContentRenderer TEXT = TextContentRenderer.builder().extensions(ALL).build();
+
+    @Test
+    void renderingIsPure() {
+        Zoo.property("commonmark-java.renderingIsPure", tc -> {
+            String md = MdGen.document(tc, true);
+            Node doc = PARSER.parse(md);
+            if (Known.pure(doc)) {
+                return;
+            }
+            String h1 = HTML.render(doc);
+            String t1 = TEXT.render(doc);
+            String h2 = HTML.render(doc);
+            String t2 = TEXT.render(doc);
+            check(h1.equals(h2), () -> "rendering the same tree twice to HTML differs for " + show(md) + "\n  first  " + show(h1) + "\n  second " + show(h2));
+            check(t1.equals(t2), () -> "rendering the same tree twice to text differs for " + show(md) + "\n  first  " + show(t1) + "\n  second " + show(t2));
+            // parsing the same text twice gives the same rendering
+            String h3 = HTML.render(PARSER.parse(md));
+            check(h1.equals(h3), () -> "parsing twice differs for " + show(md) + "\n  first  " + show(h1) + "\n  second " + show(h3));
+        });
+    }
+
+    static final Parser YAML = Parser.builder().extensions(List.of(YamlFrontMatterExtension.create())).build();
+    static final HtmlRenderer PLAIN = HtmlRenderer.builder().build();
+
+    /** YAML front matter: the documented subset (key: value, key: [a, b], indented "- item" lists, quoted values) against a model. */
+    @Test
+    void yamlFrontMatterMatchesTheModel() {
+        Zoo.property("commonmark-java.yamlFrontMatterMatchesTheModel", tc -> {
+            Map<String, List<String>> expected = new LinkedHashMap<>();
+            StringBuilder sb = new StringBuilder();
+            boolean present = chance(tc, 85);
+            String body = chance(tc, 80) ? MdGen.document(tc, false) : "";
+            if (present) {
+                sb.append("---\n");
+                int keys = n(tc, 0, 4);
+                for (int i = 0; i < keys; i++) {
+                    String key = word(tc, "abcxyzXYZ019_.-", 1, 6);
+                    List<String> values = new ArrayList<>();
+                    switch (n(tc, 0, 4)) {
+                        case 0 -> {
+                            String v = value(tc);
+                            sb.append(key).append(": ").append(quoted(tc, v)).append('\n');
+                            values.add(v);
+                        }
+                        case 1 -> {
+                            // the subset parser knows no flow sequences ("[a, b]" stays one value) and no
+                            // unindented "- item" lines, so lists are written the README's way only
+                            int count = n(tc, 1, 3);
+                            sb.append(key).append(":\n");
+                            for (int j = 0; j < count; j++) {
+                                String v = value(tc);
+                                values.add(v);
+                                sb.append("  - ").append(v).append('\n');
+                            }
+                        }
+                        case 2 -> {
+                            int count = n(tc, 1, 3);
+                            sb.append(key).append(":\n");
+                            for (int j = 0; j < count; j++) {
+                                String v = value(tc);
+                                values.add(v);
+                                sb.append(pick(tc, "  - ", "    - ", "   - ")).append(quoted(tc, v)).append('\n');
+                            }
+                        }
+                        case 3 -> {
+                            sb.append(key).append(":\n");
+                        }
+                        default -> {
+                            String v = value(tc);
+                            sb.append(key).append(":").append(pick(tc, "", "  ", "\t")).append(quoted(tc, v)).append('\n');
+                            values.add(v);
+                        }
+                    }
+                    expected.put(key, values);
+                }
+                sb.append(pick(tc, "---", "---", "..."));
+                sb.append('\n');
+            }
+            sb.append(body);
+            String md = sb.toString();
+            Node doc = YAML.parse(md);
+            Map<String, List<String>> data = YamlFrontMatterVisitor.readData(doc);
+            check(data.equals(expected), () -> "front matter of " + show(md) + "\n  expected " + expected + "\n  actual   " + data);
+            // the rest of the document parses as without the front matter
+            String rest = PLAIN.render(doc);
+            String restWithout = PLAIN.render(CoreTest.PARSER.parse(body));
+            check(rest.equals(restWithout), () -> "the document after the front matter " + show(md) + " renders as " + show(rest) + " but the body alone as " + show(restWithout));
+        });
+    }
+
+    static String value(TestCase tc) {
+        return word(tc, "abcXYZ019 _.-/", 1, 8).trim().isEmpty() ? "x" : word(tc, "abcXYZ019_.-/", 1, 8);
+    }
+
+    static String quoted(TestCase tc, String v) {
+        return switch (n(tc, 0, 3)) {
+            case 0 -> "\"" + v + "\"";
+            case 1 -> "'" + v + "'";
+            default -> v;
+        };
+    }
+
+    static final Pattern CELL = Pattern.compile("<(th|td)(?: align=\"(left|center|right)\")?>(.*?)</\\1>", Pattern.DOTALL);
+
+    /** A well-formed GFM table (header, delimiter row, body rows) renders every cell with its alignment. */
+    @Test
+    void tablesRenderTheirCells() {
+        Zoo.property("commonmark-java.tablesRenderTheirCells", tc -> {
+            int cols = n(tc, 1, 5);
+            String[] aligns = new String[cols];
+            StringBuilder sb = new StringBuilder();
+            List<List<String>> rows = new ArrayList<>();
+            boolean leading = chance(tc, 70);
+            boolean trailing = chance(tc, 70);
+            List<String> header = new ArrayList<>();
+            sb.append(leading ? "|" : "");
+            for (int c = 0; c < cols; c++) {
+                // cells start with a letter or digit (a cell is inline content; "*" alone would be a list in a paragraph model)
+                String cell = word(tc, "abcXYZ019", 1, 1) + word(tc, "abc XYZ019*_`", 0, 5);
+                header.add(cell);
+                sb.append(c > 0 ? "|" : "").append(' ').append(cell).append(' ');
+            }
+            sb.append(trailing || cols == 1 && !leading ? "|" : "").append('\n');
+            sb.append(leading ? "|" : "");
+            for (int c = 0; c < cols; c++) {
+                String d = pick(tc, "---", ":--", "--:", ":-:", "-", ":-", "-:", "------");
+                aligns[c] = d.startsWith(":") && d.endsWith(":") ? "center" : d.startsWith(":") ? "left" : d.endsWith(":") ? "right" : null;
+                sb.append(c > 0 ? "|" : "").append(pick(tc, "", " ")).append(d).append(pick(tc, "", " "));
+            }
+            sb.append(trailing || cols == 1 && !leading ? "|" : "").append('\n');
+            int count = n(tc, 0, 3);
+            for (int r = 0; r < count; r++) {
+                List<String> row = new ArrayList<>();
+                sb.append(leading ? "|" : "");
+                for (int c = 0; c < cols; c++) {
+                    // without a leading pipe the first cell must not be empty (an empty one would read as the leading pipe); a
+                    // single-column row of "|" alone is a dangling pipe that ends the table
+                    String cell = chance(tc, 20) && (leading || c > 0) && cols > 1 ? "" : word(tc, "abcXYZ019", 1, 1) + word(tc, "abc XYZ019*_`", 0, 5);
+                    row.add(cell);
+                    sb.append(c > 0 ? "|" : "").append(' ').append(cell).append(' ');
+                }
+                sb.append(trailing || cols == 1 && !leading ? "|" : "").append('\n');
+                rows.add(row);
+            }
+            String md = sb.toString();
+            String html = HTML.render(PARSER.parse(md));
+            List<String> problems = new ArrayList<>();
+            if (!html.startsWith("<table>")) {
+                problems.add("not a table: " + show(html));
+            } else {
+                Matcher m = CELL.matcher(html);
+                int i = 0;
+                int total = cols * (1 + rows.size());
+                while (m.find()) {
+                    int r = i / cols;
+                    int c = i % cols;
+                    String tag = r == 0 ? "th" : "td";
+                    if (!m.group(1).equals(tag)) {
+                        problems.add("cell " + i + " is <" + m.group(1) + ">, expected <" + tag + ">");
+                    }
+                    String align = m.group(2);
+                    if (aligns[c] == null ? align != null : !aligns[c].equals(align)) {
+                        problems.add("cell " + i + " aligned " + align + ", expected " + aligns[c]);
+                    }
+                    String text = (r == 0 ? header.get(c) : rows.get(r - 1).get(c)).trim();
+                    String plainCell = PLAIN.render(Parser.builder().build().parse(text)).replaceAll("^<p>|</p>\\n$", "");
+                    if (!m.group(3).equals(plainCell)) {
+                        problems.add("cell " + i + " rendered " + show(m.group(3)) + ", expected " + show(plainCell));
+                    }
+                    i++;
+                }
+                if (i != total) {
+                    problems.add(i + " cells rendered, expected " + total);
+                }
+            }
+            check(problems.isEmpty(), () -> "table " + show(md) + " → " + show(html) + "\n  " + String.join("\n  ", problems));
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/Known.java b/hegel/src/test/java/zoo/Known.java
