+    static final List<String> ENTITIES = List.of("&amp;", "&lt;", "&gt;", "&quot;", "&copy;", "&AElig;", "&ouml;", "&#35;", "&#1234;", "&#x1F600;", "&#0;", "&#X22;", "&#xD800;", "&#99999999;",
