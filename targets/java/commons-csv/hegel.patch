+++ b/hegel/oracle.py
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+"""Python csv module as an oracle for the Hegel zoo's Commons CSV tests.
+
+One JSON object per request line on stdin, one JSON object per reply line on stdout.
+  {"op": "read", "text": str, "delimiter": str, "quotechar": str, "skipinitialspace": bool}
+      -> {"rows": [[str, ...], ...]} or {"error": str}
+  {"op": "write", "rows": [[str|null, ...], ...], "delimiter": str, "quotechar": str,
+   "quoting": "minimal"|"all"|"nonnumeric", "lineterminator": str}
+      -> {"text": str}
+"""
+import csv
+import io
+import json
+import sys
+
+QUOTING = {"minimal": csv.QUOTE_MINIMAL, "all": csv.QUOTE_ALL, "nonnumeric": csv.QUOTE_NONNUMERIC}
+
+
+def read(req):
+    reader = csv.reader(
+        io.StringIO(req["text"], newline=""),
+        delimiter=req["delimiter"],
+        quotechar=req["quotechar"],
+        doublequote=True,
+        skipinitialspace=req.get("skipinitialspace", False),
+        strict=True,
+    )
+    try:
+        return {"rows": list(reader)}
+    except csv.Error as e:
+        return {"error": str(e)}
+
+
+def write(req):
+    out = io.StringIO()
+    writer = csv.writer(
+        out,
+        delimiter=req["delimiter"],
+        quotechar=req["quotechar"],
+        doublequote=True,
+        quoting=QUOTING[req["quoting"]],
+        lineterminator=req["lineterminator"],
+    )
+    for row in req["rows"]:
+        writer.writerow(row)
+    return {"text": out.getvalue()}
+
+
+def main():
+    csv.field_size_limit(1 << 30)
+    for line in sys.stdin:
+        req = json.loads(line)
+        try:
+            reply = read(req) if req["op"] == "read" else write(req)
+        except Exception as e:  # noqa: BLE001 - report everything to the Java side
+            reply = {"error": type(e).__name__ + ": " + str(e)}
+        sys.stdout.write(json.dumps(reply, ensure_ascii=True) + "\n")
+        sys.stdout.flush()
+
+
+if __name__ == "__main__":
+    main()
