+package zoo;
+
+import static dev.hegel.Generators.binary;
+import static dev.hegel.Generators.composite;
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.oneOf;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import dev.hegel.Generator;
+import java.io.ByteArrayInputStream;
+import java.io.StringReader;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.List;
+import org.apache.commons.csv.CSVFormat;
+import org.apache.commons.csv.QuoteMode;
+
+/**
+ * Generators, as values, for Commons CSV formats and the values printed through them, and the model of what a value
+ * printed with a format reads back as when the same format parses the text (the CSVFormat Javadoc's contract for null
+ * strings, quote modes, trimming and surrounding spaces). A format's markers depend on each other (the builder refuses
+ * a quote inside the delimiter, a comment equal to the escape ...), so the format is a composite; the values printed
+ * with it are generators of the format, built from tuples of independent parts and rendered by pure functions.
+ *
+ * <p>The shapes of the recorded bugs (bugs.toml) are drawn: a null string starting with the comment marker (commons-csv/1),
+ * multi-character delimiters holding the letters {@code r n t b f} in escape mode (commons-csv/2), and a null string in a
+ * quote-less {@code QuoteMode.ALL} (commons-csv/6); the round-trip property fails on them and is an expected failure. Under
+ * {@code HEGEL_NO_KNOWN=1} ({@link Zoo#NO_KNOWN}) the nulls of those shapes are replaced by a plain value and the values of an
+ * escaping letter-delimiter format keep clear of the delimiter's characters, so a run can look past the known bugs.
+ */
+final class CsvGen {
+    private CsvGen() {}
+
+    // ------------------------------------------------------------------ combinators the binding lacks
+
+    /** A weighted alternative for {@link #weighted}. */
+    record Choice<T>(int weight, Generator<T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        int total = 0;
+        for (Choice<T> c : choices) {
+            total += c.weight();
+        }
+        return integers().min(0).max(total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : choices) {
+                acc += c.weight();
+                if (i < acc) {
+                    return c.gen();
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return integers().min(0).max(99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    static Generator<Long> longs(int lo, int hi) {
+        return ints(lo, hi).map(Integer::longValue);
+    }
+
+    /** A string of lo..hi characters of the alphabet, repeated characters weighing more (the binding's text() has no alphabet). */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        return lists(sampledFrom(alphabet.codePoints().mapToObj(Character::toString).toList())).minSize(lo).maxSize(hi).map(l -> String.join("", l));
+    }
+
+    /** The generator's values as Objects (a {@code Generator<Rdr>} is not a {@code Generator<Object>}). */
+    static Generator<Object> obj(Generator<?> g) {
+        return g.map(x -> x);
+    }
+
+    // ------------------------------------------------------------------ values with a visible content
+
+    /** A Reader value whose content the model can see. */
+    static final class Rdr extends StringReader {
+        final String content;
+
+        Rdr(String s) {
+            super(s);
+            content = s;
+        }
+
+        @Override
+        public String toString() {
+            return "Reader(" + Zoo.show(content) + ")";
+        }
+    }
+
+    /** An InputStream value whose bytes the model can see; printed as Base64. */
+    static final class Bytes extends ByteArrayInputStream {
+        final byte[] data;
+
+        Bytes(byte[] b) {
+            super(b);
+            data = b;
+        }
+
+        @Override
+        public String toString() {
+            return "InputStream(" + data.length + " bytes)";
+        }
+    }
+
+    // ------------------------------------------------------------------ formats
+
+    /** A format together with the choices that built it. */
+    record Fmt(CSVFormat format, String delimiter, Character quote, Character escape, QuoteMode mode, Character comment,
+            String nullString, String separator, boolean spaces, boolean emptyLines, boolean trim, boolean trailingDelimiter,
+            boolean lenientEof, boolean trailingData, String name) {
+
+        /** Values are written with the escape character rather than encapsulated. */
+        boolean escaping() {
+            return escape != null && (quote == null || mode == QuoteMode.NONE);
+        }
+
+        /** Neither quoting nor escaping: only safe values survive. */
+        boolean raw() {
+            return quote == null && escape == null;
+        }
+
+        /** The parser distinguishes quoted from unquoted empty fields (and null strings). */
+        boolean strict() {
+            return mode == QuoteMode.ALL_NON_NULL || mode == QuoteMode.NON_NUMERIC;
+        }
+
+        boolean minimal() {
+            return quote != null && (mode == null || mode == QuoteMode.MINIMAL);
+        }
+
+        boolean containsDelimiterChar(String s) {
+            for (char c : delimiter.toCharArray()) {
+                if (s.indexOf(c) >= 0) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        Flags flags() {
+            return new Flags(spaces, emptyLines, trim, trailingDelimiter, lenientEof, trailingData);
+        }
+
+        String describe() {
+            return (name != null ? name + " " : "") + format + (trim ? " trim" : "") + (trailingDelimiter ? " trailingDelimiter" : "")
+                    + (lenientEof ? " lenientEof" : "") + (trailingData ? " trailingData" : "") + " sep=" + Zoo.show(separator);
+        }
+
+        @Override
+        public String toString() {
+            return describe();
+        }
+    }
+
+    /** The boolean options of a format. */
+    record Flags(boolean spaces, boolean emptyLines, boolean trim, boolean trailingDelimiter, boolean lenientEof, boolean trailingData) {}
+
+    static final String[] SINGLE = {",", ";", "\t", "|", ":", " ", "§", "中", "x"};
+    /** Multi-character delimiters holding one of the letters {@code r n t b f}: commons-csv/2's shape in escape mode. */
+    static final String[] LETTER_MULTI = {"nn", "aba", "t~t"};
+    static final String[] MULTI = {"||", "::", ",,", "<>", "\t\t", "|~|", ";;", "xy", "~~~", "[|]", "nn", "aba", "t~t"};
+    static final Character[] QUOTES = {'"', '\'', '`'};
+    static final Character[] ESCAPES = {'\\', '!', '^', '~'};
+    static final Character[] COMMENTS = {'#', '!', '%', ';'};
+    static final String[] NULLS = {"NULL", "null", "-", "N/A", "\\N", "", "#", "%"};
+    static final String[] SEPARATORS = {"\n", "\n", "\n", "\r\n", "\r\n", "\r\n", "\r"};
+    static final CSVFormat.Predefined[] PREDEFINED = CSVFormat.Predefined.values();
+
+    /** A single character (weight {@code singlePct}) or a multi-character delimiter. */
+    static Generator<String> delimiter(int singlePct) {
+        return weighted(w(singlePct, sampledFrom(SINGLE)), w(100 - singlePct, sampledFrom(MULTI)));
+    }
+
+    static final Generator<Flags> FLAGS = tuples(chance(30), chance(50), chance(20), chance(20), chance(30), chance(20))
+            .map(t -> new Flags(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+
+    /** The pool's characters that are not in the delimiter and not already taken. */
+    static List<Character> free(Character[] pool, String delimiter, Character... taken) {
+        List<Character> free = new ArrayList<>();
+        for (Character c : pool) {
+            if (delimiter.indexOf(c) < 0 && !Arrays.asList(taken).contains(c)) {
+                free.add(c);
+            }
+        }
+        return free;
+    }
+
+    /** Absent (weight 100 - pct), or one of the pool's characters that is not in the delimiter and not already taken. */
+    static Generator<Character> marker(int pct, Character[] pool, String delimiter, Character... taken) {
+        List<Character> free = free(pool, delimiter, taken);
+        return free.isEmpty() ? just(null) : maybe(pct, null, sampledFrom(free));
+    }
+
+    /** The pool's strings free of the delimiter's characters, the quote and the escape (a backslash may stay). */
+    static List<String> fitting(String[] pool, String delimiter, Character quote, Character escape) {
+        List<String> fit = new ArrayList<>();
+        for (String s : pool) {
+            if (!containsAny(s, delimiter) && (quote == null || s.indexOf(quote) < 0) && (escape == null || escape == '\\' || s.indexOf(escape) < 0)) {
+                fit.add(s);
+            }
+        }
+        return fit;
+    }
+
+    /** Absent (weight 55), or a null string free of the delimiter's characters, the quote and the escape (a backslash may stay). */
+    static Generator<String> nullString(String delimiter, Character quote, Character escape) {
+        List<String> fit = fitting(NULLS, delimiter, quote, escape);
+        return fit.isEmpty() ? just(null) : maybe(45, null, sampledFrom(fit));
+    }
+
+    /** The quote modes, the default first; {@code NONE} only when the format has an escape character (the builder refuses it otherwise). */
+    static Generator<QuoteMode> mode(boolean escaped) {
+        return weighted(w(30, just((QuoteMode) null)), w(15, just(QuoteMode.MINIMAL)), w(15, just(QuoteMode.ALL)), w(12, just(QuoteMode.ALL_NON_NULL)),
+                w(12, just(QuoteMode.NON_NUMERIC)), w(16, just(escaped ? QuoteMode.NONE : null)));
+    }
+
+    /** The quote modes but {@code excluded}, the default first; {@code NONE} only with an escape character. */
+    static Generator<QuoteMode> modeExcept(boolean escaped, QuoteMode excluded) {
+        List<QuoteMode> modes = new ArrayList<>(Arrays.asList(QuoteMode.MINIMAL, QuoteMode.ALL, QuoteMode.ALL_NON_NULL, QuoteMode.NON_NUMERIC));
+        if (escaped) {
+            modes.add(QuoteMode.NONE);
+        }
+        modes.remove(excluded);
+        return weighted(w(30, just((QuoteMode) null)), w(70, sampledFrom(modes)));
+    }
+
+    /** The format of the settings, with the choices that built it. */
+    static Fmt build(String delimiter, Character quote, Character escape, QuoteMode mode, Character comment, String nullString, String separator, Flags fl) {
+        CSVFormat.Builder b = CSVFormat.Builder.create().setDelimiter(delimiter).setQuote(quote).setEscape(escape).setQuoteMode(mode)
+                .setCommentMarker(comment).setNullString(nullString).setRecordSeparator(separator).setIgnoreSurroundingSpaces(fl.spaces())
+                .setIgnoreEmptyLines(fl.emptyLines()).setTrim(fl.trim()).setTrailingDelimiter(fl.trailingDelimiter()).setLenientEof(fl.lenientEof())
+                .setTrailingData(fl.trailingData());
+        return new Fmt(b.get(), delimiter, quote, escape, mode, comment, nullString, separator, fl.spaces(), fl.emptyLines(), fl.trim(),
+                fl.trailingDelimiter(), fl.lenientEof(), fl.trailingData(), null);
+    }
+
+    /** A format built from scratch; every marker is drawn from the characters the builder still accepts after the ones before it. */
+    static final Generator<Fmt> CUSTOM = composite(tc -> {
+        String delimiter = tc.draw(delimiter(75), "delimiter");
+        Character quote = tc.draw(marker(70, QUOTES, delimiter), "quote");
+        Character escape = tc.draw(marker(quote == null ? 70 : 35, ESCAPES, delimiter, quote), "escape");
+        QuoteMode mode = tc.draw(mode(escape != null), "mode");
+        Character comment = tc.draw(marker(40, COMMENTS, delimiter, quote, escape), "comment");
+        String nullString = tc.draw(nullString(delimiter, quote, escape), "nullString");
+        String separator = tc.draw(sampledFrom(SEPARATORS), "separator");
+        Flags fl = tc.draw(FLAGS, "flags");
+        return build(delimiter, quote, escape, mode, comment, nullString, separator, fl);
+    });
+
+    /** What may follow the comment marker in a null string of commons-csv/1's region. */
+    static final String[] NULL_TAILS = {"", "N", "NULL", "-", "A"};
+
+    /**
+     * commons-csv/1's region: a custom format with a comment marker and a null string that starts with it, in every quote
+     * mode but {@code ALL} (which quotes the null string).
+     */
+    static final Generator<Fmt> NULL_STRING_STARTING_WITH_COMMENT = composite(tc -> {
+        Fmt f = tc.draw(CUSTOM, "format");
+        Character comment = tc.draw(sampledFrom(free(COMMENTS, f.delimiter, f.quote, f.escape)), "comment");
+        String nullString = comment + tc.draw(sampledFrom(fitting(NULL_TAILS, f.delimiter, f.quote, f.escape)), "tail");
+        QuoteMode mode = tc.draw(modeExcept(f.escape != null, QuoteMode.ALL), "mode");
+        return build(f.delimiter, f.quote, f.escape, mode, comment, nullString, f.separator, f.flags());
+    });
+
+    /** commons-csv/6's region: a custom format without a quote character, in {@code QuoteMode.ALL}, with a null string. */
+    static final Generator<Fmt> QUOTELESS_ALL_WITH_NULL_STRING = composite(tc -> {
+        Fmt f = tc.draw(CUSTOM, "format");
+        String nullString = tc.draw(sampledFrom(fitting(NULLS, f.delimiter, null, f.escape)), "nullString");
+        return build(f.delimiter, null, f.escape, QuoteMode.ALL, f.comment, nullString, f.separator, f.flags());
+    });
+
+    /**
+     * commons-csv/2's region: escape mode (no quote character, or {@code QuoteMode.NONE}) with a multi-character delimiter
+     * holding one of the letters {@code r n t b f}.
+     */
+    static final Generator<Fmt> ESCAPING_LETTER_DELIMITER = composite(tc -> {
+        String delimiter = tc.draw(sampledFrom(LETTER_MULTI), "delimiter");
+        Character quote = tc.draw(marker(50, QUOTES, delimiter), "quote");
+        Character escape = tc.draw(sampledFrom(free(ESCAPES, delimiter, quote)), "escape");
+        QuoteMode mode = quote == null ? tc.draw(mode(true), "mode") : QuoteMode.NONE;
+        Character comment = tc.draw(marker(40, COMMENTS, delimiter, quote, escape), "comment");
+        String nullString = tc.draw(nullString(delimiter, quote, escape), "nullString");
+        String separator = tc.draw(sampledFrom(SEPARATORS), "separator");
+        Flags fl = tc.draw(FLAGS, "flags");
+        return build(delimiter, quote, escape, mode, comment, nullString, separator, fl);
+    });
+
+    /** One of the predefined formats (weight 15), or a custom one. */
+    static final Generator<Fmt> FORMAT = weighted(w(15, sampledFrom(PREDEFINED).map(p -> fromFormat(p.getFormat(), p.name()))), w(85, CUSTOM));
+
+    static Fmt fromFormat(CSVFormat f, String name) {
+        return new Fmt(f, f.getDelimiterString(), f.getQuoteCharacter(), f.getEscapeCharacter(), f.getQuoteMode(), f.getCommentMarker(),
+                f.getNullString(), f.getRecordSeparator(), f.getIgnoreSurroundingSpaces(), f.getIgnoreEmptyLines(), f.getTrim(),
+                f.getTrailingDelimiter(), f.getLenientEof(), f.getTrailingData(), name);
+    }
+
+    static boolean containsAny(String s, String chars) {
+        for (int i = 0; i < chars.length(); i++) {
+            if (s.indexOf(chars.charAt(i)) >= 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // ------------------------------------------------------------------ values
+
+    static final String COMMON = "ab1 0#\"'`\\,;|: \t\n\r!~%<>xyé\u2003\u00a0中\u0001\u007f";
+
+    /**
+     * commons-csv/2's shape: a multi-character delimiter holding one of the letters {@code r n t b f}, whose straddling
+     * prefix the escape-mode printer leaves bare (the letters' escapes would read back as control characters).
+     */
+    static boolean escapeLetterDelimiter(String delimiter) {
+        return delimiter.length() > 1 && delimiter.chars().anyMatch(c -> "rntbf".indexOf(c) >= 0);
+    }
+
+    /** Under HEGEL_NO_KNOWN the values of an escaping letter-delimiter format keep clear of the delimiter (commons-csv/2). */
+    static boolean avoidsLetterDelimiter(Fmt f) {
+        return Zoo.NO_KNOWN && f.escaping() && escapeLetterDelimiter(f.delimiter);
+    }
+
+    /**
+     * The characters a value may hold: the common pool, the format's own special characters and (twice, for weight) a
+     * surrogate pair; a raw format keeps only what survives unquoted (no line breaks, delimiter or comment characters),
+     * and so does an escaping letter-delimiter format under HEGEL_NO_KNOWN (no line breaks or delimiter characters).
+     */
+    static List<String> alphabet(Fmt f) {
+        StringBuilder pool = new StringBuilder(COMMON).append(f.delimiter);
+        for (Character c : new Character[] {f.quote, f.escape, f.comment}) {
+            if (c != null) {
+                pool.append(c.charValue());
+            }
+        }
+        boolean bare = f.raw() || avoidsLetterDelimiter(f);
+        List<String> chars = new ArrayList<>();
+        for (int i = 0; i < pool.length(); i++) {
+            char c = pool.charAt(i);
+            boolean breaksBare = c == '\r' || c == '\n' || f.delimiter.indexOf(c) >= 0 || f.raw() && f.comment != null && c == f.comment;
+            if (!bare || !breaksBare) {
+                chars.add(String.valueOf(c));
+            }
+        }
+        chars.add("😀");
+        chars.add("😀");
+        return chars;
+    }
+
+    /**
+     * Decorations that probe the printer's quoting decisions: a leading comment marker, a trailing prefix of a
+     * multi-character delimiter ({@code delimiterPrefix} characters of it), a leading quote character.
+     */
+    record Decor(boolean commentFirst, int delimiterPrefix, boolean quoteFirst) {
+        static final Decor NONE = new Decor(false, 0, false);
+
+        String apply(Fmt f, String body) {
+            return (quoteFirst && f.quote != null ? String.valueOf(f.quote) : "") + (commentFirst && f.comment != null ? String.valueOf(f.comment) : "")
+                    + body + f.delimiter.substring(0, delimiterPrefix);
+        }
+    }
+
+    /**
+     * Undecorated for raw formats (nothing survives there anyway); otherwise each decoration with its own small chance (no
+     * delimiter prefix for an escaping letter-delimiter format under HEGEL_NO_KNOWN).
+     */
+    static Generator<Decor> decor(Fmt f) {
+        if (f.raw()) {
+            return just(Decor.NONE);
+        }
+        Generator<Integer> prefix = f.delimiter.length() > 1 && !avoidsLetterDelimiter(f) ? maybe(12, 0, ints(1, f.delimiter.length() - 1)) : just(0);
+        return tuples(chance(8), prefix, chance(5)).map(t -> new Decor(t.value1(), t.value2(), t.value3()));
+    }
+
+    /**
+     * A string value fit for the format: mostly short, sometimes long, decorated; sometimes the null string itself (not in a
+     * raw format whose null string starts with the comment marker: nothing there can keep such a value from reading as a
+     * comment line, as with the alphabet).
+     */
+    static Generator<String> value(Fmt f) {
+        List<String> a = alphabet(f);
+        Generator<String> body = weighted(w(90, word(a, 0, 6)), w(10, word(a, 8, 40)));
+        Generator<String> decorated = tuples(body, decor(f)).map(t -> t.value2().apply(f, t.value1()));
+        boolean nullStringIsBareComment = f.raw() && f.comment != null && f.nullString != null && !f.nullString.isEmpty() && f.nullString.charAt(0) == f.comment;
+        return f.nullString == null || nullStringIsBareComment ? decorated : weighted(w(94, decorated), w(6, just(f.nullString)));
+    }
+
+    static Generator<String> word(List<String> alphabet, int lo, int hi) {
+        return lists(sampledFrom(alphabet)).minSize(lo).maxSize(hi).map(l -> String.join("", l));
+    }
+
+    /** JDK numbers of every kind the printer sees: small ints first, then the long, floating, big and short corners. */
+    static final Generator<Number> NUMBER = oneOf(ints(0, 9), ints(-1000, 1000), just(Long.MIN_VALUE),
+            sampledFrom(1.5, -0.0, Double.NaN, 1e300, Double.MIN_VALUE), just(new BigDecimal("1E+10")),
+            just(new BigInteger("123456789012345678901234567890")), ints(-300, 300).map(i -> (short) i.intValue()), just(0.1f));
+
+    /** A cell: null, a Number, a Reader or InputStream (quoting formats only), a StringBuilder or a String. */
+    static Generator<Object> cell(Fmt f) {
+        Generator<String> v = value(f);
+        if (f.quote == null) {
+            return weighted(w(18, just(null)), w(8, obj(NUMBER)), w(11, obj(v.map(StringBuilder::new))), w(63, obj(v)));
+        }
+        return weighted(w(18, just(null)), w(8, obj(NUMBER)), w(4, obj(v.map(Rdr::new))), w(3, obj(binary().maxSize(30).map(Bytes::new))),
+                w(4, obj(v.map(StringBuilder::new))), w(63, obj(v)));
+    }
+
+    /** A record of cells (sometimes none or one). */
+    static Generator<List<Object>> record(Fmt f) {
+        Generator<Object> cell = cell(f);
+        return shaped(f, weighted(w(12, lists(cell).maxSize(1)), w(88, lists(cell).minSize(1).maxSize(5))));
+    }
+
+    /** The records as drawn; under HEGEL_NO_KNOWN with the nulls of the known-bug shapes replaced by a plain value. */
+    static Generator<List<Object>> shaped(Fmt f, Generator<List<Object>> records) {
+        return Zoo.NO_KNOWN ? records.map(cells -> withoutKnownBugs(f, cells)) : records;
+    }
+
+    /** A record whose first cell is null, the rest random: commons-csv/1's shape when the null string starts with the comment marker. */
+    static Generator<List<Object>> recordStartingWithNull(Fmt f) {
+        return shaped(f, lists(cell(f)).maxSize(4).map(rest -> {
+            List<Object> out = new ArrayList<>();
+            out.add(null);
+            out.addAll(rest);
+            return out;
+        }));
+    }
+
+    /** A record with a null among random cells: commons-csv/6's shape in a quote-less {@code QuoteMode.ALL} with a null string. */
+    static Generator<List<Object>> recordWithNull(Fmt f) {
+        return shaped(f, tuples(lists(cell(f)).minSize(1).maxSize(4), ints(0, 3)).map(t -> {
+            List<Object> out = new ArrayList<>(t.value1());
+            out.set(Math.floorMod(t.value2(), out.size()), null);
+            return out;
+        }));
+    }
+
+    /** The prefixes of the delimiter that straddle: appended after a value, the delimiter would match one character early. */
+    static List<String> straddlingPrefixes(String delimiter) {
+        List<String> out = new ArrayList<>();
+        for (int n = 1; n < delimiter.length(); n++) {
+            if (endsWithStraddlingPrefix(delimiter.substring(0, n), delimiter)) {
+                out.add(delimiter.substring(0, n));
+            }
+        }
+        return out;
+    }
+
+    /**
+     * A record of string values, one of them ending in a straddling prefix of the format's multi-character delimiter after a
+     * body free of the delimiter's characters and line breaks (so the prefix is not covered by an escaped delimiter):
+     * commons-csv/2's shape in escape mode; under HEGEL_NO_KNOWN the prefix is left off.
+     */
+    static Generator<List<Object>> recordWithStraddlingValue(Fmt f) {
+        List<String> letters = new ArrayList<>(alphabet(f));
+        letters.removeIf(c -> c.equals("\r") || c.equals("\n") || f.delimiter.contains(c));
+        Generator<String> straddling = tuples(word(letters, 0, 4), sampledFrom(straddlingPrefixes(f.delimiter)))
+                .map(t -> t.value1() + (Zoo.NO_KNOWN ? "" : t.value2()));
+        return tuples(lists(obj(value(f))).maxSize(3), straddling, ints(0, 3)).map(t -> {
+            List<Object> out = new ArrayList<>(t.value1());
+            out.add(Math.floorMod(t.value3(), out.size() + 1), t.value2());
+            return out;
+        });
+    }
+
+    // ------------------------------------------------------------------ the read-back model
+
+    /** The text the printer writes for a value (before trimming). */
+    static String text(Object v) {
+        if (v == null) {
+            return null;
+        }
+        if (v instanceof Rdr r) {
+            return r.content;
+        }
+        if (v instanceof Bytes b) {
+            return Base64.getEncoder().encodeToString(b.data);
+        }
+        return v.toString();
+    }
+
+    /** Leading whitespace the lexer skips before an unquoted token: not line breaks (they are escaped) nor delimiter characters. */
+    static String stripUnquoted(Fmt f, String s) {
+        int start = 0;
+        while (start < s.length()) {
+            char c = s.charAt(start);
+            if (!Character.isWhitespace(c) || c == '\r' || c == '\n' || f.delimiter.indexOf(c) >= 0) {
+                break;
+            }
+            start++;
+        }
+        int end = s.length();
+        while (end > start && Character.isWhitespace(s.charAt(end - 1))) {
+            end--;
+        }
+        return s.substring(start, end);
+    }
+
+    /** What an empty unquoted field reads as. */
+    static String emptyRead(Fmt f) {
+        if (f.nullString != null) {
+            return f.nullString.isEmpty() ? null : "";
+        }
+        return f.strict() ? null : "";
+    }
+
+    /** Whether the value is encapsulated on output (only asked for strict modes, where it decides the null-string reading). */
+    static boolean encapsulated(Fmt f, Object v) {
+        if (f.quote == null) {
+            return false;
+        }
+        if (v instanceof Bytes) {
+            return true;
+        }
+        if (f.mode == QuoteMode.NONE) {
+            return false;
+        }
+        if (v instanceof Rdr || f.mode == QuoteMode.ALL || f.mode == QuoteMode.ALL_NON_NULL) {
+            return true;
+        }
+        if (f.mode == QuoteMode.NON_NUMERIC) {
+            return !(v instanceof Number);
+        }
+        return false; // minimal: unknown here, never needed
+    }
+
+    /** The value the parser gives back for a printed cell; {@code first} = the cell starts its record. */
+    static String expected(Fmt f, Object v, boolean first) {
+        if (v == null) {
+            if (f.nullString == null) {
+                return f.strict() ? null : "";
+            }
+            return null;
+        }
+        String t = text(v);
+        if (f.trim) {
+            t = t.trim();
+        }
+        String r = t;
+        if (f.spaces && (f.escaping() || f.raw()) && !(v instanceof Bytes && f.quote != null)) {
+            // the lexer strips Unicode whitespace around an unquoted token whether or not the format also trims
+            r = stripUnquoted(f, t);
+            if (f.trim) {
+                r = r.trim();
+            }
+        }
+        if (r.isEmpty() && f.strict() && f.nullString == null && !encapsulated(f, v)) {
+            return null; // an unquoted empty field is null in the strict quote modes
+        }
+        if (f.nullString != null && r.equals(f.nullString)) {
+            // a token that needed an escape translation is never the null marker (CSVParser.handleNull); the printer escapes the
+            // escape and quote characters, and in escape mode also line breaks, the delimiter, a leading comment marker (in every
+            // cell, not only the first) and a straddling prefix of a multi-character delimiter (unless the delimiter holds one of
+            // the letters r n t b f, commons-csv/2) - whitespace among them is what the lexer strips away afterwards, leaving the
+            // null string
+            boolean translated = f.escape != null && !f.escape.equals(f.quote)
+                    && (t.indexOf(f.escape) >= 0 || f.quote != null && t.indexOf(f.quote) >= 0);
+            if (f.escaping() && (t.indexOf('\r') >= 0 || t.indexOf('\n') >= 0 || t.contains(f.delimiter)
+                    || !escapeLetterDelimiter(f.delimiter) && endsWithStraddlingPrefix(t, f.delimiter)
+                    || f.comment != null && !t.isEmpty() && t.charAt(0) == f.comment)) {
+                translated = true;
+            }
+            if (!(f.strict() && encapsulated(f, v)) && !translated) {
+                return null;
+            }
+        }
+        return r;
+    }
+
+    /**
+     * CSVFormat.indexOfDelimiterPrefix: the value ends with a prefix of a multi-character delimiter that would match one character
+     * early once the delimiter is appended.
+     */
+    static boolean endsWithStraddlingPrefix(String s, String delimiter) {
+        int dl = delimiter.length();
+        if (dl < 2) {
+            return false;
+        }
+        int len = s.length();
+        for (int start = Math.max(0, len - dl + 1); start < len; start++) {
+            boolean match = true;
+            for (int j = 0; j < dl && match; j++) {
+                int idx = start + j;
+                match = (idx < len ? s.charAt(idx) : delimiter.charAt(idx - len)) == delimiter.charAt(j);
+            }
+            if (match) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Whether the cell prints as nothing at all (so a record of just this cell is an empty line). */
+    static boolean printsEmptyUnquoted(Fmt f, Object v) {
+        if (v == null) {
+            if (f.nullString != null && !f.nullString.isEmpty()) {
+                return false;
+            }
+            if (f.minimal()) {
+                return false;
+            }
+            return !(f.mode == QuoteMode.ALL && f.nullString != null);
+        }
+        if (v instanceof Bytes b) {
+            return f.quote == null && b.data.length == 0;
+        }
+        if (v instanceof Rdr r) {
+            return !(f.quote != null && f.mode != QuoteMode.NONE) && r.content.isEmpty();
+        }
+        String t = text(v);
+        if (f.trim) {
+            t = t.trim();
+        }
+        if (!t.isEmpty()) {
+            return false;
+        }
+        return !(f.quote != null && f.mode != QuoteMode.NONE);
+    }
+
+    /** The record the parser gives back for a printed record, or null when the line is dropped as empty. */
+    static List<String> expectedRecord(Fmt f, List<Object> cells) {
+        if (cells.isEmpty() || cells.size() == 1 && printsEmptyUnquoted(f, cells.get(0))) {
+            if (!f.trailingDelimiter && f.emptyLines) {
+                return null;
+            }
+            List<String> one = new ArrayList<>();
+            one.add(emptyRead(f));
+            return one;
+        }
+        List<String> out = new ArrayList<>();
+        for (int i = 0; i < cells.size(); i++) {
+            out.add(expected(f, cells.get(i), i == 0));
+        }
+        return out;
+    }
+
+    /** commons-csv/1 shape: a null whose null string starts with the comment marker turns the record into a comment. */
+    static boolean nullStringIsComment(Fmt f) {
+        return f.nullString != null && !f.nullString.isEmpty() && f.comment != null && f.nullString.charAt(0) == f.comment
+                && f.mode != QuoteMode.ALL;
+    }
+
+    /** commons-csv/6 shape: QuoteMode.ALL without a quote character wraps the null string in double quotes. */
+    static boolean quotelessAllNull(Fmt f) {
+        return f.quote == null && f.mode == QuoteMode.ALL && f.nullString != null;
+    }
+
+    /** The cells with the nulls of the known-bug shapes replaced by a plain value (what HEGEL_NO_KNOWN switches off). */
+    static List<Object> withoutKnownBugs(Fmt f, List<Object> cells) {
+        List<Object> out = new ArrayList<>(cells);
+        for (int i = 0; i < out.size(); i++) {
+            if (out.get(i) == null && (i == 0 && nullStringIsComment(f) || quotelessAllNull(f))) {
+                out.set(i, plain(f));
+            }
+        }
+        return out;
+    }
+
+    /** A one-letter value that is neither a special character of the format nor its null string. */
+    static String plain(Fmt f) {
+        for (String c : new String[] {"x", "y", "q", "z", "k"}) {
+            char ch = c.charAt(0);
+            boolean special = f.delimiter.indexOf(ch) >= 0 || f.quote != null && f.quote == ch || f.escape != null && f.escape == ch
+                    || f.comment != null && f.comment == ch || c.equals(f.nullString);
+            if (!special) {
+                return c;
+            }
+        }
+        return "k";
+    }
+
+    static String showCells(List<Object> cells) {
+        StringBuilder sb = new StringBuilder("[");
+        for (int i = 0; i < cells.size(); i++) {
+            Object c = cells.get(i);
+            sb.append(i > 0 ? ", " : "").append(c instanceof StringBuilder ? "SB" + Zoo.show(c.toString()) : Zoo.show(c));
+        }
+        return sb.append("]").toString();
+    }
+
+    static String showRows(List<? extends List<String>> rows) {
+        StringBuilder sb = new StringBuilder("[");
+        for (int i = 0; i < rows.size(); i++) {
+            sb.append(i > 0 ? ", [" : "[");
+            List<String> r = rows.get(i);
+            for (int j = 0; j < r.size(); j++) {
+                sb.append(j > 0 ? ", " : "").append(Zoo.show(r.get(j)));
+            }
+            sb.append("]");
+        }
+        return sb.append("]").toString();
+    }
+}
