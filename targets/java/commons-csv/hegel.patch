+++ b/hegel/src/test/java/zoo/CommonsCsvParserTest.java
@@ -0,0 +1,928 @@
+package zoo;
+
+import static dev.hegel.Generators.booleans;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.oneOf;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.sets;
+import static dev.hegel.Generators.tuples;
+import static zoo.CsvGen.chance;
+import static zoo.CsvGen.ints;
+import static zoo.CsvGen.longs;
+import static zoo.CsvGen.maybe;
+import static zoo.CsvGen.w;
+import static zoo.CsvGen.weighted;
+import static zoo.CsvGen.word;
+
+import dev.hegel.Generator;
+import dev.hegel.HealthCheck;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.io.Reader;
+import java.io.StringReader;
+import java.io.StringWriter;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.NoSuchElementException;
+import java.util.Objects;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.function.Function;
+import java.util.function.Supplier;
+import org.apache.commons.csv.CSVFormat;
+import org.apache.commons.csv.CSVParser;
+import org.apache.commons.csv.CSVPrinter;
+import org.apache.commons.csv.CSVRecord;
+import org.apache.commons.csv.DuplicateHeaderMode;
+import org.apache.commons.csv.QuoteMode;
+import org.junit.jupiter.api.Test;
+
+/**
+ * CSVParser's headers, positions and comments against models of the text, and CSVFormat as a value. The generators draw
+ * the recorded bugs' shapes (bugs.toml: repeated header names for commons-csv/3, a first comment line for /4, names
+ * differing only in case under ignoreHeaderCase for /5), so the wide properties fail on them and the narrow properties -
+ * one per bug, over its shape region with random contents and the same oracle - fail on them too; all are the expected
+ * failures. {@code HEGEL_NO_KNOWN=1} ({@link Zoo#NO_KNOWN}) leaves the checks of those shapes out.
+ */
+class CommonsCsvParserTest {
+
+    /** A test case body that may throw checked exceptions. */
+    interface Body {
+        void run(TestCase tc) throws Exception;
+    }
+
+    static void run(TestCase tc, Body body) {
+        try {
+            body.run(tc);
+        } catch (RuntimeException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    static Object outcome(Supplier<?> f) {
+        try {
+            return f.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String kind(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : "value " + Zoo.show(o);
+    }
+
+    /** A reader that hands out the text in random small chunks (a pipe or socket). */
+    static final class Chunked extends Reader {
+        private final String text;
+        private final List<Integer> sizes;
+        private int pos;
+        private int k;
+
+        Chunked(String text, List<Integer> sizes) {
+            this.text = text;
+            this.sizes = sizes;
+        }
+
+        @Override
+        public int read(char[] buf, int off, int len) {
+            if (len == 0) {
+                return 0;
+            }
+            if (pos >= text.length()) {
+                return -1;
+            }
+            int n = Math.min(len, Math.min(sizes.get(k++ % sizes.size()), text.length() - pos));
+            text.getChars(pos, pos + n, buf, off);
+            pos += n;
+            return n;
+        }
+
+        @Override
+        public void close() {}
+    }
+
+    // ---------------------------------------------------------------- headers
+
+    enum HeaderMode { NONE, AUTO, EXPLICIT }
+
+    static final String[] NAMES = {"a", "b", "c", "A", "B", "id", "", " ", "\t", "ab"};
+    static final String[] CELLS = {"1", "2", "", "x y", "#", "NULL"};
+
+    /** Header names and data rows: mostly as wide as the header, sometimes narrower or wider. */
+    record Table(List<String> names, List<List<String>> data) {}
+
+    static Generator<List<String>> dataRow(int width) {
+        Generator<String> cell = sampledFrom(CELLS);
+        return weighted(w(60, lists(cell).minSize(width).maxSize(width)), w(40, lists(cell).minSize(1).maxSize(width + 2)));
+    }
+
+    static final Generator<Table> TABLE = lists(sampledFrom(NAMES)).minSize(1).maxSize(4)
+            .flatMap(names -> lists(dataRow(names.size())).maxSize(4).map(data -> new Table(names, data)));
+
+    /**
+     * A header setup: how the header is given, the parser's header options, the table, {@code maxRows} (0 = none), the
+     * first record number, and whether {@code hasNext} is asked before each record (absent = not asked).
+     */
+    record HeaderCase(HeaderMode hm, boolean skip, DuplicateHeaderMode dup, boolean allowMissing, boolean ignoreCase, Table table, long maxRows,
+            long startNumber, List<Boolean> probes) {}
+
+    static final Generator<HeaderCase> HEADER_CASE = tuples(
+            tuples(sampledFrom(HeaderMode.values()), chance(50), sampledFrom(DuplicateHeaderMode.values()), chance(50), chance(40)),
+            TABLE, maybe(30, 0L, longs(1, 5)), maybe(30, 1L, longs(-2, 10)), lists(booleans()).maxSize(6))
+            .map(t -> new HeaderCase(t.value1().value1(), t.value1().value2(), t.value1().value3(), t.value1().value4(), t.value1().value5(),
+                    t.value2(), t.value3(), t.value4(), t.value5()));
+
+    /** A table whose header has a repeated name, its first data row as wide as the header: commons-csv/3's shape. */
+    static final Generator<Table> REPEATED_NAME_TABLE = tuples(lists(sampledFrom(NAMES)).minSize(1).maxSize(3), ints(0, 9), ints(0, 9)).map(t -> {
+        List<String> names = new ArrayList<>(t.value1());
+        names.add(Math.floorMod(t.value3(), names.size() + 1), names.get(Math.floorMod(t.value2(), names.size())));
+        return names;
+    }).flatMap(names -> tuples(lists(sampledFrom(CELLS)).minSize(names.size()).maxSize(names.size()), lists(dataRow(names.size())).maxSize(3)).map(t -> {
+        List<List<String>> data = new ArrayList<>();
+        data.add(t.value1());
+        data.addAll(t.value2());
+        return new Table(names, data);
+    }));
+
+    /** commons-csv/3's region: a header with a repeated name, read from the text or given, accepted whole (ALLOW_ALL, allowMissingColumnNames). */
+    static final Generator<HeaderCase> REPEATED_NAME_CASE = tuples(sampledFrom(HeaderMode.AUTO, HeaderMode.EXPLICIT), chance(50), chance(40), REPEATED_NAME_TABLE,
+            maybe(30, 1L, longs(-2, 10)), lists(booleans()).maxSize(6))
+            .map(t -> new HeaderCase(t.value1(), t.value2(), DuplicateHeaderMode.ALLOW_ALL, true, t.value3(), t.value4(), 0L, t.value5(), t.value6()));
+
+    /** The name with the case of its {@code i}-th letter (modulo its length) toggled. */
+    static String toggledCase(String name, int i) {
+        char[] cs = name.toCharArray();
+        int at = Math.floorMod(i, cs.length);
+        cs[at] = Character.isUpperCase(cs[at]) ? Character.toLowerCase(cs[at]) : Character.toUpperCase(cs[at]);
+        return new String(cs);
+    }
+
+    /** Two names differing only in case among names distinct from them and from each other: commons-csv/5's shape under ignoreHeaderCase. */
+    static final Generator<List<String>> CASE_DUPLICATE_NAMES = tuples(sampledFrom("a", "b", "id", "ab"), ints(0, 9), sets(sampledFrom("c", "x", "y", "z")).maxSize(2),
+            ints(0, 9), ints(0, 9)).map(t -> {
+                List<String> names = new ArrayList<>(t.value3());
+                names.add(Math.floorMod(t.value4(), names.size() + 1), t.value1());
+                names.add(Math.floorMod(t.value5(), names.size() + 1), toggledCase(t.value1(), t.value2()));
+                return names;
+            });
+
+    /** commons-csv/5's region: an explicit header with names differing only in case, under ignoreHeaderCase and a mode that refuses duplicates. */
+    static final Generator<HeaderCase> CASE_DUPLICATE_CASE = tuples(chance(50), sampledFrom(DuplicateHeaderMode.ALLOW_EMPTY, DuplicateHeaderMode.DISALLOW), chance(50),
+            CASE_DUPLICATE_NAMES.flatMap(names -> lists(dataRow(names.size())).maxSize(4).map(data -> new Table(names, data))),
+            maybe(30, 0L, longs(1, 5)), maybe(30, 1L, longs(-2, 10)), lists(booleans()).maxSize(6))
+            .map(t -> new HeaderCase(HeaderMode.EXPLICIT, t.value1(), t.value2(), t.value3(), true, t.value4(), t.value5(), t.value6(), t.value7()));
+
+    static dev.hegel.Settings settings(String name) {
+        return Zoo.settings(name).suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE);
+    }
+
+    @Test
+    void headersMatchTheModel() {
+        Hegel.test(tc -> run(tc, t -> headerCase(t.draw(HEADER_CASE, "case"))), settings("headersMatchTheModel"));
+    }
+
+    /** commons-csv/3: a record as wide as a header with repeated names is consistent (the header size is the number of names, not of distinct names). */
+    @Test
+    void isConsistentCountsRepeatedHeaderNames() {
+        Hegel.test(tc -> run(tc, t -> headerCase(t.draw(REPEATED_NAME_CASE, "case"))), settings("isConsistentCountsRepeatedHeaderNames"));
+    }
+
+    /** commons-csv/5: under ignoreHeaderCase the format refuses a header whose names differ only in case, as its parser does. */
+    @Test
+    void formatRefusesCaseInsensitiveDuplicateHeader() {
+        Hegel.test(tc -> run(tc, t -> headerCase(t.draw(CASE_DUPLICATE_CASE, "case"))), settings("formatRefusesCaseInsensitiveDuplicateHeader"));
+    }
+
+    static boolean blank(String s) {
+        return s == null || s.trim().isEmpty();
+    }
+
+    /**
+     * Whether the header holds a duplicate the mode refuses: blank names count as one name "", and under ignoreCase names
+     * differing only in case are one name (the parser's header map is case-insensitive then).
+     */
+    static boolean duplicateNames(List<String> names, DuplicateHeaderMode dup, boolean ignoreCase) {
+        if (dup == DuplicateHeaderMode.ALLOW_ALL) {
+            return false;
+        }
+        Set<String> seen = new HashSet<>();
+        for (String name : names) {
+            String key = blank(name) ? "" : ignoreCase ? name.toLowerCase(Locale.ROOT) : name;
+            if (!seen.add(key) && !(blank(name) && dup == DuplicateHeaderMode.ALLOW_EMPTY)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** The oracle of the header properties: the format's and the parser's validation, the header map and names, every record accessor, counts and the printer. */
+    static void headerCase(HeaderCase c) throws IOException {
+        HeaderMode hm = c.hm();
+        boolean skip = c.skip();
+        DuplicateHeaderMode dup = c.dup();
+        boolean allowMissing = c.allowMissing();
+        boolean ignoreCase = c.ignoreCase();
+        List<String> names = c.table().names();
+        List<List<String>> data = c.table().data();
+        long maxRows = c.maxRows();
+        long startNumber = c.startNumber();
+        Rfc.Dialect d = new Rfc.Dialect(',', '"');
+        boolean headerInText = hm == HeaderMode.AUTO || hm == HeaderMode.EXPLICIT && skip;
+        List<List<String>> lines = new ArrayList<>();
+        if (headerInText) {
+            lines.add(names);
+        }
+        lines.addAll(data);
+        String text = Rfc.write(lines, d, "\n");
+
+        CSVFormat.Builder b = CSVFormat.DEFAULT.builder().setDuplicateHeaderMode(dup).setAllowMissingColumnNames(allowMissing)
+                .setIgnoreHeaderCase(ignoreCase).setSkipHeaderRecord(skip).setMaxRows(maxRows);
+        if (hm == HeaderMode.AUTO) {
+            b.setHeader();
+        } else if (hm == HeaderMode.EXPLICIT) {
+            b.setHeader(names.toArray(new String[0]));
+        }
+        String setup = hm + (skip ? " skip" : "") + " " + dup + (allowMissing ? " allowMissing" : "") + (ignoreCase ? " ignoreCase" : "")
+                + " maxRows=" + maxRows + " start=" + startNumber + " header=" + names + " text=" + Zoo.show(text);
+
+        // the format validates an explicit header's duplicates (blank names count as one name "", and under ignoreHeaderCase names
+        // differing only in case are one name, as the parser has them)
+        boolean formatRejects = hm == HeaderMode.EXPLICIT && duplicateNames(names, dup, ignoreCase);
+        // commons-csv/5 shape: a duplicate only under ignoreHeaderCase, which the format's case-sensitive check misses while the
+        // parser refuses the header; under HEGEL_NO_KNOWN the parser's refusal is what is checked
+        boolean caseOnlyDuplicate = formatRejects && !duplicateNames(names, dup, false);
+        Object built = outcome(b::get);
+        if (formatRejects) {
+            if (!(caseOnlyDuplicate && Zoo.NO_KNOWN)) {
+                Zoo.check(built instanceof IllegalArgumentException, () -> "CSVFormat with duplicate header " + names + " under " + dup
+                        + (ignoreCase ? " ignoreHeaderCase" : "") + " gave " + kind(built));
+                return;
+            }
+            if (built instanceof IllegalArgumentException) {
+                return; // refused, as it should be
+            }
+        }
+        if (!(built instanceof CSVFormat format)) {
+            Zoo.fail("CSVFormat for " + setup + " gave " + kind(built));
+            return;
+        }
+        // the parser validates the header it uses: blanks need allowMissingColumnNames, duplicates follow the mode (case-insensitively if so set)
+        boolean parserRejects = false;
+        Map<String, Integer> index = ignoreCase ? new TreeMap<>(String.CASE_INSENSITIVE_ORDER) : new LinkedHashMap<>();
+        List<String> keys = new ArrayList<>(); // key spellings in insertion order (first spelling wins under ignoreCase)
+        if (hm != HeaderMode.NONE) {
+            boolean observedMissing = false;
+            for (int i = 0; i < names.size(); i++) {
+                String name = names.get(i);
+                boolean bl = blank(name);
+                if (bl && !allowMissing) {
+                    parserRejects = true;
+                    break;
+                }
+                boolean contains = bl ? observedMissing : index.containsKey(name);
+                if (contains && dup != DuplicateHeaderMode.ALLOW_ALL && !(bl && dup == DuplicateHeaderMode.ALLOW_EMPTY)) {
+                    parserRejects = true;
+                    break;
+                }
+                observedMissing |= bl;
+                if (!index.containsKey(name)) {
+                    keys.add(name);
+                }
+                index.put(name, i);
+            }
+        }
+        CSVParser parser;
+        try {
+            parser = CSVParser.builder().setCharSequence(text).setFormat(format).setRecordNumber(startNumber).get();
+        } catch (IllegalArgumentException e) {
+            Zoo.check(parserRejects, () -> "parser rejected the header for " + setup + ": " + e.getMessage());
+            return;
+        }
+        try (parser) {
+            if (parserRejects) {
+                Zoo.fail("parser accepted a header the documentation rejects for " + setup + ": map " + parser.getHeaderMap());
+                return;
+            }
+            if (hm == HeaderMode.NONE) {
+                Zoo.check(parser.getHeaderMap() == null && parser.getHeaderNames().isEmpty(), () -> "header map " + parser.getHeaderMap() + " / names "
+                        + parser.getHeaderNames() + " without a header for " + setup);
+            } else {
+                Map<String, Integer> map = parser.getHeaderMap();
+                Zoo.check(map != null && map.keySet().equals(index.keySet()) && new ArrayList<>(map.keySet()).equals(keys)
+                        && map.values().equals(new ArrayList<>(index.values())) || map != null && map.equals(index),
+                        () -> "header map " + map + " for " + setup + ", expected " + index);
+                Zoo.check(parser.getHeaderNames().equals(names), () -> "header names " + parser.getHeaderNames() + " for " + setup + ", expected " + names);
+                Object unmodifiable = outcome(() -> {
+                    parser.getHeaderNames().add("z");
+                    return "added";
+                });
+                Zoo.check(unmodifiable instanceof UnsupportedOperationException, () -> "getHeaderNames().add gave " + kind(unmodifiable));
+            }
+            long expectedCount = maxRows > 0 ? Math.min(maxRows, data.size()) : data.size();
+            long number = startNumber; // the header record read from the text does not advance the record numbers
+            Iterator<CSVRecord> it = parser.iterator();
+            int i = 0;
+            for (; ; i++) {
+                if (i < c.probes().size() && c.probes().get(i)) {
+                    boolean has = it.hasNext();
+                    Zoo.check(has == i < expectedCount, "hasNext " + has + " before record " + i + " of " + expectedCount + " for " + setup);
+                    if (!has) {
+                        break;
+                    }
+                }
+                CSVRecord r;
+                try {
+                    r = it.next();
+                } catch (NoSuchElementException e) {
+                    Zoo.check(i == expectedCount, "records ran out after " + i + " of " + expectedCount + " for " + setup);
+                    break;
+                }
+                if (i >= expectedCount) {
+                    Zoo.fail("record " + i + " " + r + " beyond the expected " + expectedCount + " for " + setup);
+                    break;
+                }
+                List<String> row = data.get(i);
+                final int idx = i;
+                Zoo.check(r.toList().equals(row) && r.size() == row.size() && Arrays.asList(r.values()).equals(row)
+                        && r.stream().toList().equals(row), () -> "record " + idx + " " + r + " for " + setup + ", expected " + row);
+                Zoo.check(r.getRecordNumber() == number + i, () -> "record " + idx + " number " + r.getRecordNumber() + " for " + setup + ", expected "
+                        + (number + idx));
+                Zoo.check(parser.getRecordNumber() == number + i, () -> "parser record number " + parser.getRecordNumber() + " after record " + idx
+                        + " for " + setup);
+                Zoo.check(r.getParser() == parser && !r.hasComment() && r.getComment() == null, () -> "record " + idx + " parser/comment for " + setup);
+                for (int j = -1; j <= row.size(); j++) {
+                    final int jj = j;
+                    boolean set = j >= 0 && j < row.size();
+                    Zoo.check(r.isSet(j) == set, () -> "isSet(" + jj + ") on " + r + " for " + setup);
+                    Object v = outcome(() -> r.get(jj));
+                    Zoo.check(set ? row.get(j).equals(v) : v instanceof ArrayIndexOutOfBoundsException, () -> "get(" + jj + ") on " + r + " = " + kind(v));
+                }
+                if (hm == HeaderMode.NONE) {
+                    Object v = outcome(() -> r.get("a"));
+                    Zoo.check(v instanceof IllegalStateException, () -> "get(name) without a header gave " + kind(v));
+                    Zoo.check(!r.isMapped("a") && !r.isSet("a") && r.isConsistent() && r.toMap().isEmpty(), () -> "name queries without a header on " + r);
+                } else {
+                    Map<String, String> expectedMap = new LinkedHashMap<>();
+                    for (String key : keys) {
+                        int at = index.get(key);
+                        if (at < row.size()) {
+                            expectedMap.put(key, row.get(at));
+                        }
+                    }
+                    Map<String, String> map = r.toMap();
+                    Zoo.check(map.equals(expectedMap), () -> "toMap " + map + " on " + r + " for " + setup + ", expected " + expectedMap);
+                    Map<String, String> put = r.putIn(new TreeMap<>());
+                    Zoo.check(put.equals(expectedMap), () -> "putIn " + put + " on " + r + " for " + setup + ", expected " + expectedMap);
+                    // commons-csv/3 shape: isConsistent compares the record size with the number of distinct header names (the header
+                    // map's size) instead of the number of header names; under HEGEL_NO_KNOWN the check is left out when names repeat
+                    boolean distinct = keys.size() == names.size();
+                    if (distinct || !Zoo.NO_KNOWN) {
+                        Zoo.check(r.isConsistent() == (row.size() == names.size()), () -> "isConsistent " + r.isConsistent() + " on " + r + " for " + setup
+                                + " (" + names.size() + " header names, " + keys.size() + " distinct)");
+                    }
+                    for (String probe : new String[] {"a", "A", "b", "id", "", "zz", null}) {
+                        String key = probe;
+                        Integer at = key == null ? null : index.get(key);
+                        boolean mapped = at != null;
+                        Zoo.check(r.isMapped(key) == mapped, () -> "isMapped(" + Zoo.show(key) + ") = " + r.isMapped(key) + " on " + r + " for " + setup);
+                        Zoo.check(r.isSet(key) == (mapped && at < row.size()), () -> "isSet(" + Zoo.show(key) + ") = " + r.isSet(key) + " on " + r + " for " + setup);
+                        Object v = outcome(() -> r.get(key));
+                        boolean ok = mapped && at < row.size() ? row.get(at).equals(v) : v instanceof IllegalArgumentException;
+                        Zoo.check(ok, () -> "get(" + Zoo.show(key) + ") on " + r + " for " + setup + " gave " + kind(v));
+                    }
+                }
+            }
+            Zoo.check(!it.hasNext(), "hasNext after the end for " + setup);
+            Object after = outcome(it::next);
+            Zoo.check(after instanceof NoSuchElementException, () -> "next() after the end gave " + kind(after));
+        }
+        // getRecords and stream give the same records, and a closed parser has none
+        try (CSVParser p2 = CSVParser.parse(text, format)) {
+            List<CSVRecord> all = p2.getRecords();
+            long expectedCount = maxRows > 0 ? Math.min(maxRows, data.size()) : data.size();
+            Zoo.check(all.size() == expectedCount, () -> "getRecords gave " + all.size() + " records for " + setup + ", expected " + expectedCount);
+            for (int i = 0; i < all.size(); i++) {
+                Zoo.check(all.get(i).toList().equals(data.get(i)), "getRecords record " + i + " " + all.get(i) + " for " + setup);
+            }
+            p2.close();
+            Zoo.check(p2.isClosed() && !p2.iterator().hasNext(), "closed parser still has records for " + setup);
+            Object v = outcome(() -> p2.iterator().next());
+            Zoo.check(v instanceof NoSuchElementException, () -> "next() on a closed parser gave " + kind(v));
+        }
+        try (CSVParser p3 = CSVParser.parse(text, format)) {
+            List<List<String>> streamed = p3.stream().map(CSVRecord::toList).toList();
+            long expectedCount = maxRows > 0 ? Math.min(maxRows, data.size()) : data.size();
+            Zoo.check(streamed.size() == expectedCount && streamed.equals(data.subList(0, (int) expectedCount)), () -> "stream gave " + streamed + " for " + setup);
+        }
+        // the printer honours maxRows for printRecords too, and writes the format's header unless skipped
+        if (hm == HeaderMode.EXPLICIT) {
+            StringWriter out = new StringWriter();
+            try (CSVPrinter printer = new CSVPrinter(out, format)) {
+                printer.printRecords(data);
+                long expectedPrinted = (skip ? 0 : 1) + (maxRows > 0 ? Math.min(maxRows, data.size()) : data.size());
+                Zoo.check(printer.getRecordCount() == expectedPrinted, () -> "printer record count " + printer.getRecordCount() + " for " + setup
+                        + ", expected " + expectedPrinted);
+            }
+            List<List<String>> printed = Rfc.commons(out.toString(), CSVFormat.DEFAULT.builder().setIgnoreEmptyLines(false).get());
+            List<List<String>> expectedLines = new ArrayList<>();
+            if (!skip) {
+                expectedLines.add(names);
+            }
+            for (int i = 0; i < data.size() && (maxRows <= 0 || i < maxRows); i++) {
+                expectedLines.add(data.get(i));
+            }
+            Zoo.check(printed.equals(expectedLines), () -> "printer wrote " + Zoo.show(out.toString()) + " for " + setup + ", expected " + expectedLines);
+        }
+    }
+
+    // ---------------------------------------------------------------- positions and comments
+
+    /** A line of the text as drawn: a record of fields, a comment line, or an empty line. */
+    sealed interface Kind permits Rec, Note, Blank {}
+
+    record Rec(List<Rfc.Field> fields) implements Kind {}
+
+    record Note(String text) implements Kind {}
+
+    record Blank() implements Kind {}
+
+    record Ln(Kind kind, String terminator) {}
+
+    /** A line of the text as the model sees it. */
+    record Line(int kind, List<String> fields, String comment, String text, String terminator) {} // kind 0 record, 1 comment, 2 empty
+
+    /**
+     * The text (lines, the last one sometimes unterminated), the format's comment marker and empty-line option, the
+     * builder's offsets (-1 = no byte offset), the reader's chunk sizes (none = a StringReader), and the malformed
+     * quoting probes: junk after a closing quote, the two leniency options and the quoted field {@code a}.
+     */
+    record PositionCase(Rfc.Dialect d, Character comment, boolean emptyLines, List<Ln> lines, boolean unterminatedLast, long charOffset, long byteOffset,
+            List<Integer> chunks, String junk, boolean trailingData, boolean lenientEof, String a) {}
+
+    /** A comment line's text. */
+    static Generator<Kind> note(Rfc.Dialect d) {
+        return word("ab #\t" + d.delimiter() + d.quote(), 0, 8).map(Note::new);
+    }
+
+    /** A record line (weight 55), a comment line or an empty line. */
+    static Generator<Kind> kind(Rfc.Dialect d) {
+        Generator<Kind> rec = lists(Rfc.field(d)).minSize(1).maxSize(4).map(Rec::new);
+        return weighted(w(55, rec), w(22, note(d)), w(23, just(new Blank())));
+    }
+
+    /** {@code min} to seven lines with breaks from {@code breaks}. */
+    static Generator<List<Ln>> lines(Rfc.Dialect d, int min, Generator<String> breaks) {
+        return lists(tuples(kind(d), breaks).map(t -> new Ln(t.value1(), t.value2()))).minSize(min).maxSize(7);
+    }
+
+    static Generator<List<Ln>> lines(Rfc.Dialect d) {
+        return lines(d, 0, sampledFrom(Rfc.BREAKS));
+    }
+
+    /** A comment line first, then one to seven lines whose breaks differ from its own: commons-csv/4's shape. */
+    static Generator<List<Ln>> commentFirstLines(Rfc.Dialect d) {
+        return tuples(note(d), sampledFrom(Rfc.BREAKS)).flatMap(first -> {
+            List<String> others = Arrays.stream(Rfc.BREAKS).filter(b -> !b.equals(first.value2())).toList();
+            return lines(d, 1, sampledFrom(others)).map(rest -> {
+                List<Ln> out = new ArrayList<>();
+                out.add(new Ln(first.value1(), first.value2()));
+                out.addAll(rest);
+                return out;
+            });
+        });
+    }
+
+    static final Generator<List<Integer>> CHUNKS = oneOf(just(List.<Integer>of()), lists(ints(1, 3)).minSize(1).maxSize(4));
+
+    /** A position case over a dialect: the comment marker and the lines from the given generators, the rest as always. */
+    static Generator<PositionCase> positionCases(Generator<Character> comment, Function<Rfc.Dialect, Generator<List<Ln>>> lines) {
+        return Rfc.DIALECT.flatMap(d -> tuples(
+                tuples(comment, chance(50), lines.apply(d), chance(35)),
+                tuples(maybe(30, 0L, longs(0, 1000)), maybe(30, -1L, longs(0, 1000)), CHUNKS),
+                tuples(sampledFrom(" ", "x", " x", "\t", "x "), chance(40), chance(40), Rfc.field(d, true)))
+                .map(t -> new PositionCase(d, t.value1().value1(), t.value1().value2(), t.value1().value3(), t.value1().value4(),
+                        t.value2().value1(), t.value2().value2(), t.value2().value3(),
+                        t.value3().value1(), t.value3().value2(), t.value3().value3(), t.value3().value4())));
+    }
+
+    static final Generator<PositionCase> POSITION_CASE = positionCases(maybe(60, null, sampledFrom('#', '!', '%')), CommonsCsvParserTest::lines);
+
+    /** commons-csv/4's region: a comment marker, a comment line first, the later lines with other line breaks. */
+    static final Generator<PositionCase> COMMENT_FIRST_CASE = positionCases(sampledFrom('#', '!', '%'), CommonsCsvParserTest::commentFirstLines);
+
+    /**
+     * The lines as written. Without a comment marker a comment line is an empty one; an empty line right after a lone
+     * CR (its LF would make one CR LF) or without a terminator is dropped; a plain first field must not start with the
+     * comment marker and a plain lone field must not be empty (the line would be a comment or an empty line); an empty
+     * comment on an unterminated last line is not reported as the trailer (see the README), so it gets a letter.
+     */
+    static List<Line> render(Rfc.Dialect d, Character comment, List<Ln> lines, boolean unterminatedLast) {
+        List<Line> out = new ArrayList<>();
+        for (int i = 0; i < lines.size(); i++) {
+            Ln ln = lines.get(i);
+            String terminator = i == lines.size() - 1 && unterminatedLast ? "" : ln.terminator();
+            boolean afterCr = !out.isEmpty() && out.get(out.size() - 1).terminator().equals("\r");
+            Kind k = ln.kind() instanceof Note && comment == null ? new Blank() : ln.kind();
+            if (k instanceof Blank) {
+                if (!afterCr && !terminator.isEmpty()) {
+                    out.add(new Line(2, null, null, "", terminator));
+                }
+            } else if (k instanceof Note n) {
+                String c = terminator.isEmpty() && n.text().trim().isEmpty() ? "c" : n.text();
+                out.add(new Line(1, null, c, comment + c, terminator));
+            } else if (k instanceof Rec r) {
+                List<String> fields = new ArrayList<>();
+                StringBuilder line = new StringBuilder();
+                int m = r.fields().size();
+                for (int j = 0; j < m; j++) {
+                    Rfc.Field fd = r.fields().get(j);
+                    String f = fd.text();
+                    boolean q = fd.quoted();
+                    if (!q && j == 0 && comment != null && !f.isEmpty() && f.charAt(0) == comment) {
+                        f = "x" + f;
+                    }
+                    if (!q && m == 1 && f.isEmpty()) {
+                        f = "x";
+                    }
+                    if (j > 0) {
+                        line.append(d.delimiter());
+                    }
+                    fields.add(f);
+                    line.append(q ? Rfc.quoted(f, d.quote()) : f);
+                }
+                out.add(new Line(0, fields, null, line.toString(), terminator));
+            }
+        }
+        return out;
+    }
+
+    @Test
+    void positionsAndCommentsMatchTheText() {
+        Hegel.test(tc -> run(tc, t -> positionCase(t.draw(POSITION_CASE, "case"))), settings("positionsAndCommentsMatchTheText"));
+    }
+
+    /** commons-csv/4: the first end of line reported is the line break of a first comment line. */
+    @Test
+    void firstEndOfLineCountsCommentLines() {
+        Hegel.test(tc -> run(tc, t -> positionCase(t.draw(COMMENT_FIRST_CASE, "case"))), settings("firstEndOfLineCountsCommentLines"));
+    }
+
+    static int utf8Length(String s) {
+        return s.getBytes(StandardCharsets.UTF_8).length;
+    }
+
+    /** Line breaks in the text (CRLF counting once). */
+    static int breaks(String s) {
+        int n = 0;
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '\n') {
+                n++;
+            } else if (c == '\r') {
+                n++;
+                if (i + 1 < s.length() && s.charAt(i + 1) == '\n') {
+                    i++;
+                }
+            }
+        }
+        return n;
+    }
+
+    /** The oracle of the position properties: values, positions, comments, line numbers, the first end of line, and the malformed-quoting probes. */
+    static void positionCase(PositionCase c) throws IOException {
+        Rfc.Dialect d = c.d();
+        final Character comment = c.comment();
+        boolean emptyLines = c.emptyLines();
+        CSVFormat format = CSVFormat.DEFAULT.builder().setDelimiter(d.delimiter()).setQuote(d.quote()).setCommentMarker(comment)
+                .setIgnoreEmptyLines(emptyLines).get();
+        List<Line> lines = render(d, comment, c.lines(), c.unterminatedLast());
+        StringBuilder sb = new StringBuilder();
+        for (Line line : lines) {
+            sb.append(line.text()).append(line.terminator());
+        }
+        String text = sb.toString();
+        // the model: records with their start offsets, comments, and the parser's line number after each
+        List<List<String>> expected = new ArrayList<>();
+        List<Integer> starts = new ArrayList<>();
+        List<String> comments = new ArrayList<>();
+        List<Integer> lineNumbers = new ArrayList<>();
+        int offset = 0;
+        int resume = 0;
+        List<String> pending = new ArrayList<>();
+        for (Line line : lines) {
+            int end = offset + line.text().length() + line.terminator().length();
+            boolean isRecord = line.kind() == 0 || line.kind() == 2 && !emptyLines;
+            if (isRecord) {
+                expected.add(line.kind() == 0 ? line.fields() : List.of(""));
+                starts.add(resume);
+                comments.add(pending.isEmpty() ? null : String.join("\n", pending));
+                pending = new ArrayList<>();
+                lineNumbers.add(breaks(text.substring(0, end)) + (line.terminator().isEmpty() ? 1 : 0));
+                resume = end;
+            } else if (line.kind() == 1) {
+                pending.add(line.comment().trim());
+            }
+            offset = end;
+        }
+        String trailer = pending.isEmpty() ? null : String.join("\n", pending);
+        String eol = null;
+        boolean inQuotes = false;
+        for (int i = 0; i < text.length() && eol == null; i++) {
+            char ch = text.charAt(i);
+            if (ch == d.quote()) {
+                inQuotes = !inQuotes;
+            } else if (!inQuotes && ch == '\r') {
+                eol = i + 1 < text.length() && text.charAt(i + 1) == '\n' ? "\r\n" : "\r";
+            } else if (!inQuotes && ch == '\n') {
+                eol = "\n";
+            }
+        }
+        final String firstEol = eol;
+        // commons-csv/4 shape: the first line is a comment, whose line break the parser does not report as the first end of line;
+        // under HEGEL_NO_KNOWN that check is left out for such texts
+        boolean commentFirst = !lines.isEmpty() && lines.get(0).kind() == 1;
+        String setup = d + (comment != null ? " comment=" + comment : "") + (emptyLines ? " ignoreEmptyLines" : "") + " text=" + Zoo.show(text);
+
+        long charOffset = c.charOffset();
+        long byteOffset = c.byteOffset();
+        Reader reader = c.chunks().isEmpty() ? new StringReader(text) : new Chunked(text, c.chunks());
+        CSVParser.Builder pb = CSVParser.builder().setReader(reader).setFormat(format).setCharset(StandardCharsets.UTF_8).setTrackBytes(true)
+                .setCharacterOffset(charOffset);
+        if (byteOffset >= 0) {
+            pb.setByteOffset(byteOffset);
+        }
+        long expectedByteBase = byteOffset >= 0 ? byteOffset : charOffset;
+        String how = (c.chunks().isEmpty() ? "String" : "chunked " + c.chunks()) + " charOffset=" + charOffset + " byteOffset=" + byteOffset + " " + setup;
+        try (CSVParser parser = pb.get()) {
+            Iterator<CSVRecord> it = parser.iterator();
+            int i = 0;
+            for (; ; i++) {
+                CSVRecord r;
+                try {
+                    r = it.next();
+                } catch (NoSuchElementException e) {
+                    break;
+                }
+                if (i >= expected.size()) {
+                    Zoo.fail("record " + i + " " + r + " beyond the expected " + expected.size() + " for " + how);
+                    break;
+                }
+                final int idx = i;
+                final CSVRecord rec = r;
+                Zoo.check(r.toList().equals(expected.get(i)), () -> "record " + idx + " " + rec.toList() + " for " + how + ", expected " + expected.get(idx));
+                long start = starts.get(i) + charOffset;
+                Zoo.check(r.getCharacterPosition() == start, () -> "record " + idx + " character position " + rec.getCharacterPosition() + " for " + how
+                        + ", expected " + start);
+                long bytes = utf8Length(text.substring(0, starts.get(i))) + expectedByteBase;
+                Zoo.check(r.getBytePosition() == bytes, () -> "record " + idx + " byte position " + rec.getBytePosition() + " for " + how + ", expected " + bytes);
+                Zoo.check(Objects.equals(r.getComment(), comments.get(i)) && r.hasComment() == (comments.get(i) != null),
+                        () -> "record " + idx + " comment " + Zoo.show(rec.getComment()) + " for " + how + ", expected " + Zoo.show(comments.get(idx)));
+                Zoo.check(parser.getCurrentLineNumber() == lineNumbers.get(i), () -> "line number " + parser.getCurrentLineNumber() + " after record "
+                        + idx + " for " + how + ", expected " + lineNumbers.get(idx));
+                Zoo.check(r.getRecordNumber() == idx + 1, () -> "record number " + rec.getRecordNumber() + " for record " + idx + " of " + how);
+            }
+            Zoo.check(i == expected.size(), "read " + i + " records for " + how + ", expected " + expected.size());
+            Zoo.check(Objects.equals(parser.getTrailerComment(), trailer) && parser.hasTrailerComment() == (trailer != null),
+                    () -> "trailer comment " + Zoo.show(parser.getTrailerComment()) + " for " + how + ", expected " + Zoo.show(trailer));
+            Zoo.check(parser.getHeaderComment() == null && !parser.hasHeaderComment(), () -> "header comment without a header for " + how);
+            if (!commentFirst || !Zoo.NO_KNOWN) {
+                Zoo.check(Objects.equals(parser.getFirstEndOfLine(), firstEol), () -> "first end of line " + Zoo.show(parser.getFirstEndOfLine()) + " for " + how
+                        + ", expected " + Zoo.show(firstEol) + (commentFirst ? " (the first line is a comment)" : ""));
+            }
+            Zoo.check(parser.getRecordNumber() == expected.size(), () -> "parser record number " + parser.getRecordNumber() + " for " + how);
+        }
+        // malformed quoting: junk after a closing quote, an unterminated quote
+        final String junk = c.junk().indexOf(d.delimiter()) >= 0 ? "x" : c.junk();
+        boolean trailingData = c.trailingData();
+        boolean lenientEof = c.lenientEof();
+        CSVFormat lenient = format.builder().setTrailingData(trailingData).setLenientEof(lenientEof).get();
+        String a = c.a();
+        String bad = Rfc.quoted(a, d.quote()) + junk + d.delimiter() + "b\n";
+        Object got = outcome(() -> {
+            try {
+                return Rfc.commons(bad, lenient);
+            } catch (IOException e) {
+                throw new UncheckedIOException(e);
+            }
+        });
+        boolean whitespaceOnly = junk.trim().isEmpty();
+        Object want = trailingData ? List.of(List.of(a + junk, "b")) : whitespaceOnly ? List.of(List.of(a, "b")) : null;
+        Zoo.check(want == null ? got instanceof UncheckedIOException : want.equals(got), () -> "junk " + Zoo.show(junk) + " after a closing quote in "
+                + Zoo.show(bad) + (trailingData ? " with trailingData" : "") + " gave " + kind(got) + ", expected " + (want == null ? "CSVException" : want));
+        String open = "b" + d.delimiter() + d.quote() + a.replace(String.valueOf(d.quote()), "" + d.quote() + d.quote());
+        Object got2 = outcome(() -> {
+            try {
+                return Rfc.commons(open, lenient);
+            } catch (IOException e) {
+                throw new UncheckedIOException(e);
+            }
+        });
+        Object want2 = lenientEof ? List.of(List.of("b", a)) : null;
+        Zoo.check(want2 == null ? got2 instanceof UncheckedIOException : want2.equals(got2), () -> "unterminated quote in " + Zoo.show(open)
+                + (lenientEof ? " with lenientEof" : "") + " gave " + kind(got2) + ", expected " + (want2 == null ? "CSVException" : want2));
+    }
+
+    // ---------------------------------------------------------------- formats as values
+
+    /** The characters a marker may be set to, or none. */
+    static final Generator<Character> MARKER = weighted(w(1, just((Character) null)), w(10, sampledFrom(',', ';', '"', '\'', '\\', '#', '!', '|', 'x', '§')));
+
+    static final Generator<QuoteMode> ANY_MODE = weighted(w(1, just((QuoteMode) null)),
+            w(5, sampledFrom(QuoteMode.MINIMAL, QuoteMode.ALL, QuoteMode.ALL_NON_NULL, QuoteMode.NON_NUMERIC, QuoteMode.NONE)));
+
+    /** The builder's markers, drawn independently: about a twentieth of them are refused. */
+    record Markers(String delimiter, Character quote, Character escape, Character comment, QuoteMode mode, String nullString, String separator) {}
+
+    static final Generator<Markers> MARKERS = tuples(CsvGen.delimiter(70), MARKER, MARKER, MARKER, ANY_MODE, maybe(40, null, sampledFrom(CsvGen.NULLS)),
+            weighted(w(15, just((String) null)), w(85, sampledFrom("\n", "\r\n", "\r", ";;"))))
+            .map(t -> new Markers(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    record Flags(boolean ignoreEmpty, boolean spaces, boolean trim, boolean trailing, boolean skipHeader, boolean ignoreCase, boolean allowMissing,
+            boolean autoFlush, boolean lenient, boolean trailingData) {}
+
+    static final Generator<Flags> FLAGS = tuples(tuples(chance(50), chance(50), chance(50), chance(50), chance(50)),
+            tuples(chance(50), chance(50), chance(50), chance(50), chance(50)))
+            .map(t -> new Flags(t.value1().value1(), t.value1().value2(), t.value1().value3(), t.value1().value4(), t.value1().value5(),
+                    t.value2().value1(), t.value2().value2(), t.value2().value3(), t.value2().value4(), t.value2().value5()));
+
+    /** An explicit header (weight 35) of up to three names, some of them null. */
+    static final Generator<List<String>> HEADER = maybe(35, null, lists(weighted(w(10, just((String) null)), w(90, sampledFrom(NAMES)))).maxSize(3));
+
+    /** A format's settings, the record printed through it ({@code extra} is its fourth value) and a predefined format to look up. */
+    record FormatCase(Markers m, List<String> header, DuplicateHeaderMode dup, Flags flags, long maxRows, String extra, CSVFormat.Predefined predefined) {}
+
+    static final Generator<FormatCase> FORMAT_CASE = tuples(MARKERS, HEADER, sampledFrom(DuplicateHeaderMode.values()), FLAGS, maybe(30, 0L, longs(1, 9)),
+            word("ab ,\"\n", 0, 5), sampledFrom(CSVFormat.Predefined.values()))
+            .map(t -> new FormatCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    @Test
+    void formatsAreValues() {
+        Hegel.test(tc -> run(tc, this::formatCase), settings("formatsAreValues"));
+    }
+
+    private void formatCase(TestCase tc) throws IOException, ClassNotFoundException {
+        FormatCase c = tc.draw(FORMAT_CASE, "case");
+        String delimiter = c.m().delimiter();
+        Character quote = c.m().quote();
+        Character escape = c.m().escape();
+        Character comment = c.m().comment();
+        QuoteMode mode = c.m().mode();
+        String nullString = c.m().nullString();
+        String separator = c.m().separator();
+        String[] header = c.header() == null ? null : c.header().toArray(new String[0]);
+        DuplicateHeaderMode dup = c.dup();
+        Flags fl = c.flags();
+        boolean ignoreEmpty = fl.ignoreEmpty();
+        boolean spaces = fl.spaces();
+        boolean trim = fl.trim();
+        boolean trailing = fl.trailing();
+        boolean skipHeader = fl.skipHeader();
+        boolean ignoreCase = fl.ignoreCase();
+        boolean allowMissing = fl.allowMissing();
+        boolean autoFlush = fl.autoFlush();
+        boolean lenient = fl.lenient();
+        boolean trailingData = fl.trailingData();
+        long maxRows = c.maxRows();
+        String setup = "delimiter=" + Zoo.show(delimiter) + " quote=" + quote + " escape=" + escape + " comment=" + comment + " mode=" + mode
+                + " nullString=" + Zoo.show(nullString) + " separator=" + Zoo.show(separator) + " header=" + Arrays.toString(header) + " " + dup
+                + (ignoreCase ? " ignoreHeaderCase" : "");
+
+        boolean duplicateHeader = header != null && duplicateNames(Arrays.asList(header), dup, ignoreCase);
+        // commons-csv/5 shape: names differing only in case under ignoreHeaderCase, which the format's case-sensitive duplicate check
+        // misses (the parser refuses the header); under HEGEL_NO_KNOWN the format that builds is tested like a valid one
+        boolean caseOnlyDuplicate = duplicateHeader && !duplicateNames(Arrays.asList(header), dup, false);
+        boolean invalid = quote != null && delimiter.indexOf(quote) >= 0 || escape != null && delimiter.indexOf(escape) >= 0
+                || comment != null && delimiter.indexOf(comment) >= 0 || quote != null && quote.equals(comment) || escape != null && escape.equals(comment)
+                || escape == null && mode == QuoteMode.NONE || duplicateHeader && !(caseOnlyDuplicate && Zoo.NO_KNOWN);
+        Object built = outcome(() -> CSVFormat.DEFAULT.builder().setDelimiter(delimiter).setQuote(quote).setEscape(escape).setCommentMarker(comment)
+                .setQuoteMode(mode).setNullString(nullString).setRecordSeparator(separator).setHeader(header).setDuplicateHeaderMode(dup)
+                .setIgnoreEmptyLines(ignoreEmpty).setIgnoreSurroundingSpaces(spaces).setTrim(trim).setTrailingDelimiter(trailing)
+                .setSkipHeaderRecord(skipHeader).setIgnoreHeaderCase(ignoreCase).setAllowMissingColumnNames(allowMissing).setAutoFlush(autoFlush)
+                .setLenientEof(lenient).setTrailingData(trailingData).setMaxRows(maxRows).get());
+        if (invalid) {
+            Zoo.check(built instanceof IllegalArgumentException, () -> "an invalid format (" + setup + ") gave " + kind(built));
+            return;
+        }
+        if (!(built instanceof CSVFormat f)) {
+            if (caseOnlyDuplicate && built instanceof IllegalArgumentException) {
+                return; // refused, as it should be
+            }
+            Zoo.fail("a valid format (" + setup + ") gave " + kind(built));
+            return;
+        }
+        // getters
+        Zoo.check(f.getDelimiterString().equals(delimiter) && f.getDelimiter() == delimiter.charAt(0) && Objects.equals(f.getQuoteCharacter(), quote)
+                && Objects.equals(f.getEscapeCharacter(), escape) && Objects.equals(f.getCommentMarker(), comment) && f.getQuoteMode() == mode
+                && Objects.equals(f.getNullString(), nullString) && Objects.equals(f.getRecordSeparator(), separator)
+                && Arrays.equals(f.getHeader(), header) && f.getDuplicateHeaderMode() == dup && f.getIgnoreEmptyLines() == ignoreEmpty
+                && f.getIgnoreSurroundingSpaces() == spaces && f.getTrim() == trim && f.getTrailingDelimiter() == trailing
+                && f.getSkipHeaderRecord() == skipHeader && f.getIgnoreHeaderCase() == ignoreCase && f.getAllowMissingColumnNames() == allowMissing
+                && f.getAutoFlush() == autoFlush && f.getLenientEof() == lenient && f.getTrailingData() == trailingData && f.getMaxRows() == maxRows
+                && f.isQuoteCharacterSet() == (quote != null) && f.isEscapeCharacterSet() == (escape != null) && f.isCommentMarkerSet() == (comment != null)
+                && f.isNullStringSet() == (nullString != null) && f.getAllowDuplicateHeaderNames() == (dup == DuplicateHeaderMode.ALLOW_ALL),
+                () -> "getters disagree with the settings for " + setup + ": " + f);
+        if (header != null && header.length > 0) {
+            String[] copy = f.getHeader();
+            copy[0] = "mutated";
+            Zoo.check(Arrays.equals(f.getHeader(), header), () -> "getHeader() shares its array for " + setup);
+        }
+        // value semantics
+        CSVFormat again = f.builder().get();
+        Zoo.check(again.equals(f) && f.equals(again) && again.hashCode() == f.hashCode() && again.toString().equals(f.toString()),
+                () -> "builder().get() is not equal for " + setup + ": " + f + " vs " + again);
+        CSVFormat other = f.builder().setMaxRows(maxRows + 1).get();
+        Zoo.check(!other.equals(f), () -> "maxRows " + maxRows + " and " + (maxRows + 1) + " compare equal for " + setup);
+        CSVFormat other2 = f.builder().setTrailingData(!trailingData).setLenientEof(!lenient).get();
+        Zoo.check(!other2.equals(f), () -> "trailingData/lenientEof are ignored by equals for " + setup);
+        Zoo.check(f.toString().startsWith("Delimiter=<" + delimiter + ">"), () -> "toString " + f + " for " + setup);
+        // serialization
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        try (ObjectOutputStream oos = new ObjectOutputStream(bytes)) {
+            oos.writeObject(f);
+        }
+        Object back;
+        try (ObjectInputStream ois = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()))) {
+            back = ois.readObject();
+        }
+        final Object deserialized = back;
+        Zoo.check(f.equals(deserialized) && deserialized.hashCode() == f.hashCode(), () -> "deserialized " + deserialized + " differs from " + f + " for " + setup);
+        // the deprecated with* methods build the same formats as the builder
+        Zoo.check(f.withDelimiter('~').equals(f.builder().setDelimiter('~').get()), "withDelimiter for " + setup);
+        Zoo.check(f.withRecordSeparator("\n").equals(f.builder().setRecordSeparator("\n").get()), "withRecordSeparator for " + setup);
+        Zoo.check(f.withIgnoreEmptyLines(!ignoreEmpty).equals(f.builder().setIgnoreEmptyLines(!ignoreEmpty).get()), "withIgnoreEmptyLines for " + setup);
+        Zoo.check(f.withIgnoreSurroundingSpaces(!spaces).equals(f.builder().setIgnoreSurroundingSpaces(!spaces).get()), "withIgnoreSurroundingSpaces for " + setup);
+        Zoo.check(f.withTrim(!trim).equals(f.builder().setTrim(!trim).get()), "withTrim for " + setup);
+        Zoo.check(f.withTrailingDelimiter(!trailing).equals(f.builder().setTrailingDelimiter(!trailing).get()), "withTrailingDelimiter for " + setup);
+        Zoo.check(f.withSkipHeaderRecord(!skipHeader).equals(f.builder().setSkipHeaderRecord(!skipHeader).get()), "withSkipHeaderRecord for " + setup);
+        Zoo.check(f.withIgnoreHeaderCase(!ignoreCase).equals(f.builder().setIgnoreHeaderCase(!ignoreCase).get()), "withIgnoreHeaderCase for " + setup);
+        Zoo.check(f.withAllowMissingColumnNames(!allowMissing).equals(f.builder().setAllowMissingColumnNames(!allowMissing).get()), "withAllowMissingColumnNames for " + setup);
+        Zoo.check(f.withAutoFlush(!autoFlush).equals(f.builder().setAutoFlush(!autoFlush).get()), "withAutoFlush for " + setup);
+        Zoo.check(f.withNullString("NIL").equals(f.builder().setNullString("NIL").get()), "withNullString for " + setup);
+        Zoo.check(f.withHeader("p", "q").equals(f.builder().setHeader("p", "q").get()), "withHeader for " + setup);
+        Zoo.check(f.withHeaderComments("c1", 2).equals(f.builder().setHeaderComments("c1", "2").get()), "withHeaderComments for " + setup);
+        Zoo.check(f.withFirstRecordAsHeader().equals(f.builder().setHeader().setSkipHeaderRecord(true).get()), "withFirstRecordAsHeader for " + setup);
+        if (header == null) {
+            Zoo.check(f.withAllowDuplicateHeaderNames(false).getDuplicateHeaderMode() == DuplicateHeaderMode.ALLOW_EMPTY
+                    && f.withAllowDuplicateHeaderNames(true).getDuplicateHeaderMode() == DuplicateHeaderMode.ALLOW_ALL, "withAllowDuplicateHeaderNames for " + setup);
+        }
+        if (quote != null && delimiter.indexOf('`') < 0 && !Character.valueOf('`').equals(comment) && !Character.valueOf('`').equals(escape)) {
+            Zoo.check(f.withQuote('`').equals(f.builder().setQuote('`').get()), "withQuote for " + setup);
+        }
+        if (delimiter.indexOf('^') < 0 && !Character.valueOf('^').equals(comment)) {
+            Zoo.check(f.withEscape('^').equals(f.builder().setEscape('^').get()), "withEscape for " + setup);
+            if (mode == QuoteMode.NONE || escape != null) {
+                Zoo.check(f.withQuoteMode(QuoteMode.NONE).withEscape('^').equals(f.builder().setQuoteMode(QuoteMode.NONE).setEscape('^').get()), "withQuoteMode for " + setup);
+            }
+        }
+        if (delimiter.indexOf('%') < 0 && !Character.valueOf('%').equals(quote) && !Character.valueOf('%').equals(escape)) {
+            Zoo.check(f.withCommentMarker('%').equals(f.builder().setCommentMarker('%').get()), "withCommentMarker for " + setup);
+        }
+        // the printed null in QuoteMode.ALL is the null string in the quote character, whatever the order the two were set in
+        if (nullString != null && quote != null && mode == QuoteMode.ALL && separator != null && header == null) {
+            String printed = f.format((Object) null);
+            String swapped = f.builder().setQuote('`').setNullString(nullString).get().format((Object) null);
+            String swapped2 = f.builder().setNullString(nullString).setQuote('`').get().format((Object) null);
+            String tail = trailing ? delimiter : ""; // format() keeps the trailing delimiter, it strips only the record separator
+            Zoo.check(printed.equals(quote + nullString + quote + tail) && swapped.equals("`" + nullString + "`" + tail)
+                    && swapped2.equals("`" + nullString + "`" + tail),
+                    () -> "null in QuoteMode.ALL printed as " + Zoo.show(printed) + " / " + Zoo.show(swapped) + " / " + Zoo.show(swapped2) + " for " + setup);
+        }
+        // format(values) is one printed record without the record separator
+        if (header == null && separator != null && (quote != null || escape != null)) {
+            Object[] values = {"a", null, 1, c.extra()};
+            String one = f.format(values);
+            StringWriter out = new StringWriter();
+            try (CSVPrinter printer = new CSVPrinter(out, f)) {
+                printer.printRecord(values);
+            }
+            Zoo.check(out.toString().equals(one + separator), () -> "format() " + Zoo.show(one) + " vs printer " + Zoo.show(out.toString()) + " for " + setup);
+            StringBuilder direct = new StringBuilder();
+            f.printRecord(direct, values);
+            Zoo.check(direct.toString().equals(out.toString()), () -> "CSVFormat.printRecord(Appendable) " + Zoo.show(direct.toString()) + " vs printer "
+                    + Zoo.show(out.toString()) + " for " + setup);
+        }
+        // predefined formats and valueOf
+        CSVFormat.Predefined p = c.predefined();
+        Zoo.check(CSVFormat.valueOf(p.name()) == p.getFormat() && CSVFormat.Predefined.valueOf(p.name()) == p, () -> "Predefined " + p);
+        CSVFormat fresh = CSVFormat.newFormat(delimiter.charAt(0));
+        Zoo.check(fresh.getDelimiterString().equals(delimiter.substring(0, 1)) && fresh.getQuoteCharacter() == null && fresh.getEscapeCharacter() == null
+                && fresh.getRecordSeparator() == null && !fresh.getIgnoreEmptyLines() && fresh.getCommentMarker() == null && fresh.getNullString() == null
+                && fresh.getQuoteMode() == null && fresh.getHeader() == null, () -> "newFormat(" + delimiter.charAt(0) + ") = " + fresh);
+    }
+}
diff --git a/hegel/src/test/java/zoo/CommonsCsvPinsTest.java b/hegel/src/test/java/zoo/CommonsCsvPinsTest.java
new file mode 100644
index 0000000..31487f8
--- /dev/null
+++ b/hegel/src/test/java/zoo/CommonsCsvPinsTest.java
@@ -0,0 +1,114 @@
+package zoo;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.function.Supplier;
+import org.apache.commons.csv.CSVFormat;
+import org.apache.commons.csv.CSVParser;
+import org.apache.commons.csv.CSVRecord;
+import org.apache.commons.csv.DuplicateHeaderMode;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Pins for the bugs in targets/java/commons-csv/bugs.toml. Each asserts the correct behaviour and therefore fails
+ * while the bug exists; the ids are the keys of [expected_failures] in target.toml.
+ */
+class CommonsCsvPinsTest {
+
+    static Object outcome(Supplier<?> f) {
+        try {
+            return f.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String kind(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : "value " + o;
+    }
+
+    static List<List<String>> parse(String text, CSVFormat format) {
+        try (CSVParser parser = CSVParser.parse(text, format)) {
+            List<List<String>> rows = new ArrayList<>();
+            for (CSVRecord r : parser) {
+                rows.add(r.toList());
+            }
+            return rows;
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    static String show(String s) {
+        return Zoo.show(s);
+    }
+
+    /** commons-csv/1: a null string that starts with the comment marker is printed bare, so the record reads back as a comment. */
+    @Test
+    void pin_nullStringStartingWithCommentMarker() {
+        CSVFormat f = CSVFormat.DEFAULT.builder().setCommentMarker('#').setNullString("#").setRecordSeparator("\n").get();
+        String text = f.format((Object) null, "x") + "\n";
+        List<List<String>> rows = parse(text, f);
+        Zoo.check(rows.equals(List.of(Arrays.asList((String) null, "x"))), "printed " + show(text) + " for [null, \"x\"], read back " + CsvGen.showRows(rows));
+    }
+
+    /** commons-csv/2: in escape mode a value ending in a prefix of a multi-character delimiter that contains one of the letters r n t b f is not escaped. */
+    @Test
+    void pin_escapedDelimiterPrefixWithEscapeLetters() {
+        for (String delimiter : new String[] {"aba", "nn"}) {
+            CSVFormat f = CSVFormat.DEFAULT.builder().setQuote(null).setEscape('\\').setDelimiter(delimiter).setRecordSeparator("\n").get();
+            String first = delimiter.substring(0, delimiter.length() - 1);
+            String text = f.format("x" + first, "y") + "\n";
+            List<List<String>> rows = parse(text, f);
+            Zoo.check(rows.equals(List.of(List.of("x" + first, "y"))), "delimiter " + show(delimiter) + ": printed " + show(text) + " for [\"x" + first
+                    + "\", \"y\"], read back " + CsvGen.showRows(rows));
+        }
+    }
+
+    /** commons-csv/3: isConsistent compares the record size with the number of distinct header names, not of header names. */
+    @Test
+    void pin_isConsistentWithDuplicateHeaderNames() {
+        CSVFormat f = CSVFormat.DEFAULT.builder().setHeader().setSkipHeaderRecord(true).setDuplicateHeaderMode(DuplicateHeaderMode.ALLOW_ALL).get();
+        try (CSVParser parser = CSVParser.parse("a,a,b\n1,2,3\n", f)) {
+            CSVRecord r = parser.getRecords().get(0);
+            Zoo.check(r.isConsistent(), "isConsistent() is false for " + r + " under the header [a, a, b] (names " + parser.getHeaderNames() + ")");
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    /** commons-csv/4: the first end of line reported ignores the line breaks that end comment lines. */
+    @Test
+    void pin_firstEndOfLineAfterComment() {
+        CSVFormat f = CSVFormat.DEFAULT.builder().setCommentMarker('#').get();
+        try (CSVParser parser = CSVParser.parse("# c\r\na,b\nc,d\n", f)) {
+            parser.getRecords();
+            String eol = parser.getFirstEndOfLine();
+            Zoo.check("\r\n".equals(eol), "getFirstEndOfLine() = " + show(eol) + " for a text whose first line, a comment, ends with CR LF");
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    /** commons-csv/5: a header with names differing only in case passes the format's duplicate check under ignoreHeaderCase, and the parser then rejects it. */
+    @Test
+    void pin_formatRejectsCaseInsensitiveDuplicateHeader() {
+        Object built = outcome(() -> CSVFormat.DEFAULT.builder().setHeader("a", "A").setIgnoreHeaderCase(true).setDuplicateHeaderMode(DuplicateHeaderMode.DISALLOW).get());
+        Object parsed = built instanceof CSVFormat f ? outcome(() -> parse("1,2\n", f)) : "not built";
+        Zoo.check(built instanceof IllegalArgumentException, "the format was built (" + kind(built) + ") while the parser says " + kind(parsed));
+    }
+
+    /** commons-csv/6: QuoteMode.ALL without a quote character prints the null string between double quotes. */
+    @Test
+    void pin_quotelessAllModeNullString() {
+        CSVFormat f = CSVFormat.DEFAULT.builder().setQuote(null).setEscape('\\').setNullString("NULL").setQuoteMode(org.apache.commons.csv.QuoteMode.ALL)
+                .setRecordSeparator("\n").get();
+        String text = f.format((Object) null, "a") + "\n";
+        List<List<String>> rows = parse(text, f);
+        Zoo.check(rows.equals(List.of(Arrays.asList((String) null, "a"))), "printed " + show(text) + " for [null, \"a\"] without a quote character, read back "
+                + CsvGen.showRows(rows));
+    }
+}
diff --git a/hegel/src/test/java/zoo/CommonsCsvTest.java b/hegel/src/test/java/zoo/CommonsCsvTest.java
new file mode 100644
index 0000000..b34a4ff
--- /dev/null
+++ b/hegel/src/test/java/zoo/CommonsCsvTest.java
@@ -0,0 +1,334 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static zoo.CsvGen.maybe;
+import static zoo.CsvGen.w;
+import static zoo.CsvGen.weighted;
+import static zoo.CsvGen.word;
+
+import de.siegmar.fastcsv.writer.LineDelimiter;
+import de.siegmar.fastcsv.writer.QuoteStrategies;
+import dev.hegel.Generator;
+import dev.hegel.HealthCheck;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.IOException;
+import java.io.StringWriter;
+import java.io.UncheckedIOException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.Function;
+import org.apache.commons.csv.CSVFormat;
+import org.apache.commons.csv.CSVParser;
+import org.apache.commons.csv.CSVPrinter;
+import org.apache.commons.csv.CSVRecord;
+import org.apache.commons.csv.QuoteMode;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Commons CSV's printer and parser against each other over the whole option space, and against Python's csv and FastCSV.
+ * The round-trip generators draw the recorded bugs' shapes (bugs.toml), so {@code printerParserRoundTrip} fails on them
+ * and the narrow properties below - one per bug, over that bug's shape region with random contents and the same oracle -
+ * fail on them too; all are the expected failures. {@code HEGEL_NO_KNOWN=1} ({@link Zoo#NO_KNOWN}) switches the shapes off.
+ */
+class CommonsCsvTest {
+
+    /** A test case body that may throw checked exceptions. */
+    interface Body {
+        void run(TestCase tc) throws Exception;
+    }
+
+    static void run(TestCase tc, Body body) {
+        try {
+            body.run(tc);
+        } catch (RuntimeException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    // ---------------------------------------------------------------- printer and parser
+
+    /** How a record reaches the printer. */
+    enum How { ARRAY, ITERABLE, STREAM, CELLS }
+
+    record Printed(List<Object> cells, How how) {}
+
+    /** A format, the records printed through it and the header comments, if any. */
+    record RoundTrip(CsvGen.Fmt f, List<Printed> records, List<String> headerComments) {}
+
+    /** Absent, or (when the format has a comment marker, weight 25) one or two comments over line breaks and the delimiter. */
+    static Generator<List<String>> headerComments(CsvGen.Fmt f) {
+        if (f.comment() == null) {
+            return just(null);
+        }
+        return maybe(25, null, lists(word("ab #\n\r\t" + f.delimiter(), 0, 6)).minSize(1).maxSize(2));
+    }
+
+    static Generator<Printed> printed(Generator<List<Object>> records) {
+        return tuples(records, sampledFrom(How.values())).map(t -> new Printed(t.value1(), t.value2()));
+    }
+
+    /** A format of {@code formats}, {@code min} to five records of its record generator, and header comments. */
+    static Generator<RoundTrip> roundTrips(Generator<CsvGen.Fmt> formats, Function<CsvGen.Fmt, Generator<List<Object>>> records, int min) {
+        return formats.flatMap(f -> tuples(lists(printed(records.apply(f))).minSize(min).maxSize(5), headerComments(f))
+                .map(t -> new RoundTrip(f, t.value1(), t.value2())));
+    }
+
+    static final Generator<RoundTrip> ROUND_TRIP = roundTrips(CsvGen.FORMAT, CsvGen::record, 0);
+
+    /** commons-csv/1's region: a null string starting with the comment marker, records starting with a null. */
+    static final Generator<RoundTrip> NULL_STRING_STARTING_WITH_COMMENT_TRIP = roundTrips(CsvGen.NULL_STRING_STARTING_WITH_COMMENT, CsvGen::recordStartingWithNull, 1);
+
+    /** commons-csv/2's region: escape mode with a letter delimiter, records holding a value that ends in a straddling prefix of it. */
+    static final Generator<RoundTrip> STRADDLING_LETTER_DELIMITER_TRIP = roundTrips(CsvGen.ESCAPING_LETTER_DELIMITER, CsvGen::recordWithStraddlingValue, 1);
+
+    /** commons-csv/6's region: QuoteMode.ALL without a quote character and with a null string, records holding a null. */
+    static final Generator<RoundTrip> QUOTELESS_ALL_NULL_TRIP = roundTrips(CsvGen.QUOTELESS_ALL_WITH_NULL_STRING, CsvGen::recordWithNull, 1);
+
+    static dev.hegel.Settings settings(String name) {
+        return Zoo.settings(name).suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE);
+    }
+
+    /** Values printed with a format read back through the same format as the Javadoc says they do. */
+    @Test
+    void printerParserRoundTrip() {
+        Hegel.test(tc -> roundTrip(tc.draw(ROUND_TRIP, "case")), settings("printerParserRoundTrip"));
+    }
+
+    /** commons-csv/1: a record whose first value is null reads back as the record, not as a comment line, when the null string starts with the comment marker. */
+    @Test
+    void nullStringStartingWithCommentMarkerRoundTrips() {
+        Hegel.test(tc -> roundTrip(tc.draw(NULL_STRING_STARTING_WITH_COMMENT_TRIP, "case")), settings("nullStringStartingWithCommentMarkerRoundTrips"));
+    }
+
+    /** commons-csv/2: in escape mode a value ending in a straddling prefix of a delimiter that holds one of the letters r n t b f reads back whole. */
+    @Test
+    void straddlingLetterDelimiterPrefixRoundTripsInEscapeMode() {
+        Hegel.test(tc -> roundTrip(tc.draw(STRADDLING_LETTER_DELIMITER_TRIP, "case")), settings("straddlingLetterDelimiterPrefixRoundTripsInEscapeMode"));
+    }
+
+    /** commons-csv/6: a null printed in QuoteMode.ALL without a quote character reads back as null. */
+    @Test
+    void quotelessAllModeNullStringRoundTrips() {
+        Hegel.test(tc -> roundTrip(tc.draw(QUOTELESS_ALL_NULL_TRIP, "case")), settings("quotelessAllModeNullStringRoundTrips"));
+    }
+
+    /** The oracle of the round-trip properties: the parser gives the modelled values, counts, comments and format() back. */
+    static void roundTrip(RoundTrip c) {
+        CsvGen.Fmt f = c.f();
+        List<List<Object>> records = c.records().stream().map(Printed::cells).toList();
+        String[] headerComments = c.headerComments() == null ? null : c.headerComments().toArray(new String[0]);
+        CSVFormat format = f.format();
+        if (headerComments != null) {
+            format = format.builder().setHeaderComments(headerComments).get();
+        }
+        String text;
+        long printed;
+        int manual = 0; // records written cell by cell with print/println are not printRecord calls
+        try {
+            StringWriter out = new StringWriter();
+            try (CSVPrinter printer = new CSVPrinter(out, format)) {
+                for (Printed p : c.records()) {
+                    List<Object> cells = p.cells();
+                    switch (p.how()) {
+                        case ARRAY -> printer.printRecord(cells.toArray());
+                        case ITERABLE -> printer.printRecord(cells);
+                        case STREAM -> printer.printRecord(cells.stream());
+                        case CELLS -> {
+                            for (Object cell : cells) {
+                                printer.print(cell);
+                            }
+                            printer.println();
+                            manual++;
+                        }
+                    }
+                }
+                printed = printer.getRecordCount();
+            }
+            text = out.toString();
+        } catch (IOException | RuntimeException e) {
+            Zoo.fail("printing " + describe(records) + " with " + f.describe() + " threw " + e);
+            return;
+        }
+        final int printRecordCalls = records.size() - manual;
+        Zoo.check(printed == printRecordCalls, () -> "getRecordCount " + printed + " after " + printRecordCalls + " printRecord calls with " + f.describe());
+
+        List<List<String>> expected = new ArrayList<>();
+        for (List<Object> cells : records) {
+            List<String> r = CsvGen.expectedRecord(f, cells);
+            if (r != null) {
+                expected.add(r);
+            }
+        }
+        List<List<String>> got = new ArrayList<>();
+        List<String> comments = new ArrayList<>();
+        String trailer;
+        long lastNumber;
+        try (CSVParser parser = CSVParser.parse(text, format)) {
+            for (CSVRecord r : parser) {
+                got.add(r.toList());
+                comments.add(r.getComment());
+            }
+            trailer = parser.getTrailerComment();
+            lastNumber = parser.getRecordNumber();
+        } catch (IOException | RuntimeException e) {
+            Zoo.fail("parsing " + Zoo.show(text) + " printed from " + describe(records) + " with " + f.describe() + " threw " + e);
+            return;
+        }
+        if (!got.equals(expected)) {
+            Zoo.fail("round trip of " + describe(records) + " with " + f.describe() + ": printed " + Zoo.show(text) + ", read back "
+                    + CsvGen.showRows(got) + ", expected " + CsvGen.showRows(expected));
+            return;
+        }
+        Zoo.check(lastNumber == got.size(), () -> "getRecordNumber " + lastNumber + " after " + got.size() + " records with " + f.describe());
+        final String[] hc = headerComments;
+        if (hc != null) {
+            List<String> lines = new ArrayList<>();
+            for (String comment : hc) {
+                for (String line : comment.split("\r\n|\r|\n", -1)) {
+                    lines.add(line.trim());
+                }
+            }
+            String joined = String.join("\n", lines);
+            String first = got.isEmpty() ? trailer : comments.get(0);
+            Zoo.check(Objects.equals(first, joined), () -> "header comments " + Zoo.show(String.join("|", hc)) + " read back as "
+                    + Zoo.show(first) + " (expected " + Zoo.show(joined) + ") from " + Zoo.show(text) + " with " + f.describe());
+        } else {
+            Zoo.check(trailer == null && comments.stream().allMatch(Objects::isNull), () -> "comments " + comments + " / trailer "
+                    + Zoo.show(trailer) + " read from " + Zoo.show(text) + " printed without comments with " + f.describe());
+        }
+        // CSVFormat.format is the printer without the record separator
+        if (!records.isEmpty() && headerComments == null) {
+            List<Object> cells = records.get(0);
+            boolean streams = cells.stream().anyMatch(cell -> cell instanceof CsvGen.Rdr || cell instanceof CsvGen.Bytes);
+            if (!streams) {
+                String one = f.format().format(cells.toArray());
+                StringWriter out = new StringWriter();
+                try (CSVPrinter printer = new CSVPrinter(out, f.format())) {
+                    printer.printRecord(cells);
+                } catch (IOException e) {
+                    throw new UncheckedIOException(e);
+                }
+                String line = out.toString();
+                String sep = f.separator() == null ? "" : f.separator();
+                Zoo.check(line.equals(one + sep), () -> "format(" + describe(List.of(cells)) + ") = " + Zoo.show(one) + " but the printer wrote "
+                        + Zoo.show(line) + " with " + f.describe());
+            }
+        }
+    }
+
+    static String describe(List<List<Object>> records) {
+        StringBuilder sb = new StringBuilder("[");
+        for (int i = 0; i < records.size(); i++) {
+            sb.append(i > 0 ? ", " : "").append(CsvGen.showCells(records.get(i)));
+        }
+        return sb.append("]").toString();
+    }
+
+    // ---------------------------------------------------------------- RFC dialects against Python and FastCSV
+
+    /** A dialect, well-formed text in it, rows for the writers, and the writers' options. */
+    record RfcCase(Rfc.Dialect d, Rfc.Text t, List<List<String>> rows, String lineBreak, QuoteMode mode, String quoting, QuoteStrategies strategy) {}
+
+    /** The printer's quote modes an RFC reader can follow, the default first. */
+    static final Generator<QuoteMode> RFC_MODE = weighted(w(1, just((QuoteMode) null)), w(3, sampledFrom(QuoteMode.MINIMAL, QuoteMode.ALL, QuoteMode.NON_NUMERIC)));
+
+    static Generator<List<List<String>>> rows(Rfc.Dialect d) {
+        return lists(lists(Rfc.field(d, true)).minSize(1).maxSize(4)).minSize(1).maxSize(4);
+    }
+
+    static final Generator<RfcCase> RFC_CASE = Rfc.DIALECT.flatMap(d -> tuples(Rfc.text(d), rows(d), sampledFrom(Rfc.BREAKS), RFC_MODE,
+            sampledFrom("minimal", "all", "nonnumeric"), sampledFrom(QuoteStrategies.values()))
+            .map(t -> new RfcCase(d, t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6())));
+
+    /** RFC 4180 dialects: Commons CSV, Python's csv module and FastCSV read the same rows from well-formed text and from each other's output. */
+    @Test
+    void rfcDialectsAgreeWithPythonAndFastCsv() {
+        Hegel.test(tc -> run(tc, this::rfcCase), Zoo.settings("rfcDialectsAgreeWithPythonAndFastCsv").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
+    }
+
+    private void rfcCase(TestCase tc) throws IOException {
+        RfcCase c = tc.draw(RFC_CASE, "case");
+        Rfc.Dialect d = c.d();
+        CSVFormat format = CSVFormat.DEFAULT.builder().setDelimiter(d.delimiter()).setQuote(d.quote()).setIgnoreEmptyLines(false).get();
+        // 1. well-formed text with known rows
+        Rfc.Text t = c.t();
+        List<List<String>> commons = Rfc.commons(t.text(), format);
+        Zoo.check(commons.equals(t.rows()), () -> "Commons CSV read " + CsvGen.showRows(commons) + " from " + Zoo.show(t.text()) + " with " + d
+                + ", expected " + CsvGen.showRows(t.rows()));
+        Py.Rows py = Py.read(t.text(), d.delimiter(), d.quote(), false);
+        if (py.error() != null) {
+            Zoo.fail("Python csv refused " + Zoo.show(t.text()) + " with " + d + ": " + py.error());
+        } else {
+            List<List<String>> pyRows = Rfc.emptyAsOneField(py.rows());
+            Zoo.check(pyRows.equals(t.rows()), () -> "Python csv read " + CsvGen.showRows(pyRows) + " from " + Zoo.show(t.text()) + " with " + d
+                    + ", expected " + CsvGen.showRows(t.rows()));
+        }
+        // FastCSV 4.0.0 loses quoted fields that contain a lone CR (its own defect, not Commons CSV's): compare without them
+        boolean carriageReturns = t.rows().stream().flatMap(List::stream).anyMatch(s -> s.indexOf('\r') >= 0);
+        if (!carriageReturns) {
+            List<List<String>> fast = Rfc.emptyAsOneField(Rfc.fast(t.text(), d));
+            Zoo.check(fast.equals(t.rows()), () -> "FastCSV read " + CsvGen.showRows(fast) + " from " + Zoo.show(t.text()) + " with " + d + ", expected "
+                    + CsvGen.showRows(t.rows()));
+        }
+
+        // 2. values written by each side, read by the others
+        List<List<String>> rows = c.rows();
+        String lineBreak = c.lineBreak();
+        QuoteMode mode = c.mode();
+        CSVFormat writing = format.builder().setRecordSeparator(lineBreak).setQuoteMode(mode).get();
+        String printed = writing.format(rows.get(0).toArray()) + lineBreak;
+        if (rows.size() > 1) {
+            StringWriter out = new StringWriter();
+            try (CSVPrinter printer = new CSVPrinter(out, writing)) {
+                printer.printRecords(rows);
+            }
+            printed = out.toString();
+        }
+        final String printedText = printed;
+        Py.Rows py2 = Py.read(printedText, d.delimiter(), d.quote(), false);
+        if (py2.error() != null) {
+            Zoo.fail("Python csv refused Commons CSV's " + Zoo.show(printedText) + " (" + mode + ", " + d + ") for " + CsvGen.showRows(rows) + ": " + py2.error());
+        } else {
+            Zoo.check(py2.rows().equals(rows), () -> "Python csv read " + CsvGen.showRows(py2.rows()) + " from Commons CSV's " + Zoo.show(printedText)
+                    + " (" + mode + ", " + d + ") for " + CsvGen.showRows(rows));
+        }
+        if (rows.stream().flatMap(List::stream).noneMatch(s -> s.indexOf('\r') >= 0)) {
+            List<List<String>> fast2 = Rfc.fast(printedText, d);
+            Zoo.check(fast2.equals(rows), () -> "FastCSV read " + CsvGen.showRows(fast2) + " from Commons CSV's " + Zoo.show(printedText) + " (" + mode
+                    + ", " + d + ") for " + CsvGen.showRows(rows));
+        }
+        List<List<String>> back = Rfc.commons(printedText, format);
+        Zoo.check(back.equals(rows), () -> "Commons CSV read " + CsvGen.showRows(back) + " from its own " + Zoo.show(printedText) + " (" + mode + ", "
+                + d + ") for " + CsvGen.showRows(rows));
+
+        String quoting = c.quoting();
+        String pyText = Py.write(rows, d.delimiter(), d.quote(), quoting, lineBreak);
+        List<List<String>> fromPy = Rfc.commons(pyText, format);
+        Zoo.check(fromPy.equals(rows), () -> "Commons CSV read " + CsvGen.showRows(fromPy) + " from Python's " + Zoo.show(pyText) + " (" + quoting
+                + ", " + d + ") for " + CsvGen.showRows(rows));
+
+        QuoteStrategies strategy = c.strategy();
+        LineDelimiter ld = lineBreak.equals("\n") ? LineDelimiter.LF : lineBreak.equals("\r") ? LineDelimiter.CR : LineDelimiter.CRLF;
+        String fastText = Rfc.fastWrite(rows, d, strategy, ld);
+        List<List<String>> fromFast = Rfc.commons(fastText, format);
+        Zoo.check(fromFast.equals(rows), () -> "Commons CSV read " + CsvGen.showRows(fromFast) + " from FastCSV's " + Zoo.show(fastText) + " ("
+                + strategy + ", " + d + ") for " + CsvGen.showRows(rows));
+
+        // 3. the plain all-quoted writer, through the RFC4180 and EXCEL predefined formats when the dialect is theirs
+        if (d.delimiter() == ',' && d.quote() == '"') {
+            String plain = Rfc.write(rows, d, lineBreak);
+            for (CSVFormat pre : Arrays.asList(CSVFormat.RFC4180, CSVFormat.EXCEL, CSVFormat.DEFAULT)) {
+                List<List<String>> got = Rfc.commons(plain, pre);
+                Zoo.check(got.equals(rows), () -> pre + " read " + CsvGen.showRows(got) + " from " + Zoo.show(plain) + " for " + CsvGen.showRows(rows));
+            }
+        }
+    }
+}
