--- /dev/null
+++ b/hegel/src/test/java/zoo/CommonsCsvTest.java
@@ -0,0 +1,258 @@
+package zoo;
+
+import de.siegmar.fastcsv.writer.LineDelimiter;
+import de.siegmar.fastcsv.writer.QuoteStrategies;
+import dev.hegel.HealthCheck;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.IOException;
+import java.io.StringWriter;
+import java.io.UncheckedIOException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Objects;
+import org.apache.commons.csv.CSVFormat;
+import org.apache.commons.csv.CSVParser;
+import org.apache.commons.csv.CSVPrinter;
+import org.apache.commons.csv.CSVRecord;
+import org.apache.commons.csv.QuoteMode;
+import org.junit.jupiter.api.Test;
+
+/** Commons CSV's printer and parser against each other over the whole option space, and against Python's csv and FastCSV. */
+class CommonsCsvTest {
+
+    /** A test case body that may throw checked exceptions. */
+    interface Body {
+        void run(TestCase tc) throws Exception;
+    }
+
+    static void run(TestCase tc, Body body) {
+        try {
+            body.run(tc);
+        } catch (RuntimeException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    /** Values printed with a format read back through the same format as the Javadoc says they do. */
+    @Test
+    void printerParserRoundTrip() {
+        Hegel.test(tc -> run(tc, this::roundTripCase), Zoo.settings("printerParserRoundTrip").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
+    }
+
+    private void roundTripCase(TestCase tc) {
+        CsvGen.Fmt f = CsvGen.format(tc);
+        List<List<Object>> records = new ArrayList<>();
+        int n = Zoo.n(tc, 0, 5);
+        for (int i = 0; i < n; i++) {
+            List<Object> cells = CsvGen.record(tc, f);
+            CsvGen.skipKnownBugs(f, cells); // commons-csv/1 and /6
+            records.add(cells);
+        }
+        String[] headerComments = null;
+        CSVFormat format = f.format();
+        if (f.comment() != null && Zoo.chance(tc, 25)) {
+            headerComments = new String[Zoo.n(tc, 1, 2)];
+            for (int i = 0; i < headerComments.length; i++) {
+                headerComments[i] = Zoo.word(tc, "ab #\n\r\t" + f.delimiter(), 0, 6);
+            }
+            format = format.builder().setHeaderComments(headerComments).get();
+        }
+        String text;
+        long printed;
+        int[] manual = {0}; // records written cell by cell with print/println are not printRecord calls
+        try {
+            StringWriter out = new StringWriter();
+            try (CSVPrinter printer = new CSVPrinter(out, format)) {
+                for (List<Object> cells : records) {
+                    switch (Zoo.n(tc, 0, 3)) {
+                        case 0 -> printer.printRecord(cells.toArray());
+                        case 1 -> printer.printRecord(cells);
+                        case 2 -> printer.printRecord(cells.stream());
+                        default -> {
+                            for (Object c : cells) {
+                                printer.print(c);
+                            }
+                            printer.println();
+                            manual[0]++;
+                        }
+                    }
+                }
+                printed = printer.getRecordCount();
+            }
+            text = out.toString();
+        } catch (IOException | RuntimeException e) {
+            Zoo.fail("printing " + describe(records) + " with " + f.describe() + " threw " + e);
+            return;
+        }
+        Zoo.check(printed == records.size() - manual[0], () -> "getRecordCount " + printed + " after " + (records.size() - manual[0])
+                + " printRecord calls with " + f.describe());
+
+        List<List<String>> expected = new ArrayList<>();
+        for (List<Object> cells : records) {
+            List<String> r = CsvGen.expectedRecord(f, cells);
+            if (r != null) {
+                expected.add(r);
+            }
+        }
+        List<List<String>> got = new ArrayList<>();
+        List<String> comments = new ArrayList<>();
+        String trailer;
+        long lastNumber;
+        try (CSVParser parser = CSVParser.parse(text, format)) {
+            for (CSVRecord r : parser) {
+                got.add(r.toList());
+                comments.add(r.getComment());
+            }
+            trailer = parser.getTrailerComment();
+            lastNumber = parser.getRecordNumber();
+        } catch (IOException | RuntimeException e) {
+            Zoo.fail("parsing " + Zoo.show(text) + " printed from " + describe(records) + " with " + f.describe() + " threw " + e);
+            return;
+        }
+        if (!got.equals(expected)) {
+            Zoo.fail("round trip of " + describe(records) + " with " + f.describe() + ": printed " + Zoo.show(text) + ", read back "
+                    + CsvGen.showRows(got) + ", expected " + CsvGen.showRows(expected));
+            return;
+        }
+        Zoo.check(lastNumber == got.size(), () -> "getRecordNumber " + lastNumber + " after " + got.size() + " records with " + f.describe());
+        final String[] hc = headerComments;
+        if (hc != null) {
+            List<String> lines = new ArrayList<>();
+            for (String c : hc) {
+                for (String line : c.split("\r\n|\r|\n", -1)) {
+                    lines.add(line.trim());
+                }
+            }
+            String joined = String.join("\n", lines);
+            String first = got.isEmpty() ? trailer : comments.get(0);
+            Zoo.check(Objects.equals(first, joined), () -> "header comments " + Zoo.show(String.join("|", hc)) + " read back as "
+                    + Zoo.show(first) + " (expected " + Zoo.show(joined) + ") from " + Zoo.show(text) + " with " + f.describe());
+        } else {
+            Zoo.check(trailer == null && comments.stream().allMatch(Objects::isNull), () -> "comments " + comments + " / trailer "
+                    + Zoo.show(trailer) + " read from " + Zoo.show(text) + " printed without comments with " + f.describe());
+        }
+        // CSVFormat.format is the printer without the record separator
+        if (!records.isEmpty() && headerComments == null) {
+            List<Object> cells = records.get(0);
+            boolean streams = cells.stream().anyMatch(c -> c instanceof CsvGen.Rdr || c instanceof CsvGen.Bytes);
+            if (!streams) {
+                String one = f.format().format(cells.toArray());
+                StringWriter out = new StringWriter();
+                try (CSVPrinter printer = new CSVPrinter(out, f.format())) {
+                    printer.printRecord(cells);
+                } catch (IOException e) {
+                    throw new UncheckedIOException(e);
+                }
+                String line = out.toString();
+                String sep = f.separator() == null ? "" : f.separator();
+                Zoo.check(line.equals(one + sep), () -> "format(" + describe(List.of(cells)) + ") = " + Zoo.show(one) + " but the printer wrote "
+                        + Zoo.show(line) + " with " + f.describe());
+            }
+        }
+    }
+
+    static String describe(List<List<Object>> records) {
+        StringBuilder sb = new StringBuilder("[");
+        for (int i = 0; i < records.size(); i++) {
+            sb.append(i > 0 ? ", " : "").append(CsvGen.showCells(records.get(i)));
+        }
+        return sb.append("]").toString();
+    }
+
+    /** RFC 4180 dialects: Commons CSV, Python's csv module and FastCSV read the same rows from well-formed text and from each other's output. */
+    @Test
+    void rfcDialectsAgreeWithPythonAndFastCsv() {
+        Hegel.test(tc -> run(tc, this::rfcCase), Zoo.settings("rfcDialectsAgreeWithPythonAndFastCsv").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
+    }
+
+    private void rfcCase(TestCase tc) throws IOException {
+        Rfc.Dialect d = Rfc.dialect(tc);
+        CSVFormat format = CSVFormat.DEFAULT.builder().setDelimiter(d.delimiter()).setQuote(d.quote()).setIgnoreEmptyLines(false).get();
+        // 1. well-formed text with known rows
+        Rfc.Text t = Rfc.text(tc, d);
+        List<List<String>> commons = Rfc.commons(t.text(), format);
+        Zoo.check(commons.equals(t.rows()), () -> "Commons CSV read " + CsvGen.showRows(commons) + " from " + Zoo.show(t.text()) + " with " + d
+                + ", expected " + CsvGen.showRows(t.rows()));
+        Py.Rows py = Py.read(t.text(), d.delimiter(), d.quote(), false);
+        if (py.error() != null) {
+            Zoo.fail("Python csv refused " + Zoo.show(t.text()) + " with " + d + ": " + py.error());
+        } else {
+            List<List<String>> pyRows = Rfc.emptyAsOneField(py.rows());
+            Zoo.check(pyRows.equals(t.rows()), () -> "Python csv read " + CsvGen.showRows(pyRows) + " from " + Zoo.show(t.text()) + " with " + d
+                    + ", expected " + CsvGen.showRows(t.rows()));
+        }
+        // FastCSV 4.0.0 loses quoted fields that contain a lone CR (its own defect, not Commons CSV's): compare without them
+        boolean carriageReturns = t.rows().stream().flatMap(List::stream).anyMatch(s -> s.indexOf('\r') >= 0);
+        if (!carriageReturns) {
+            List<List<String>> fast = Rfc.emptyAsOneField(Rfc.fast(t.text(), d));
+            Zoo.check(fast.equals(t.rows()), () -> "FastCSV read " + CsvGen.showRows(fast) + " from " + Zoo.show(t.text()) + " with " + d + ", expected "
+                    + CsvGen.showRows(t.rows()));
+        }
+
+        // 2. values written by each side, read by the others
+        List<List<String>> rows = new ArrayList<>();
+        int n = Zoo.n(tc, 1, 4);
+        for (int i = 0; i < n; i++) {
+            int m = Zoo.n(tc, 1, 4);
+            List<String> row = new ArrayList<>();
+            for (int j = 0; j < m; j++) {
+                row.add(Rfc.field(tc, d, true));
+            }
+            rows.add(row);
+        }
+        String lineBreak = Zoo.pick(tc, Rfc.BREAKS);
+        QuoteMode[] modes = {QuoteMode.MINIMAL, QuoteMode.ALL, QuoteMode.NON_NUMERIC, null};
+        QuoteMode mode = modes[Zoo.n(tc, 0, modes.length - 1)];
+        CSVFormat writing = format.builder().setRecordSeparator(lineBreak).setQuoteMode(mode).get();
+        String printed = writing.format(rows.get(0).toArray()) + lineBreak;
+        if (rows.size() > 1) {
+            StringWriter out = new StringWriter();
+            try (CSVPrinter printer = new CSVPrinter(out, writing)) {
+                printer.printRecords(rows);
+            }
+            printed = out.toString();
+        }
+        final String printedText = printed;
+        Py.Rows py2 = Py.read(printedText, d.delimiter(), d.quote(), false);
+        if (py2.error() != null) {
+            Zoo.fail("Python csv refused Commons CSV's " + Zoo.show(printedText) + " (" + mode + ", " + d + ") for " + CsvGen.showRows(rows) + ": " + py2.error());
+        } else {
+            Zoo.check(py2.rows().equals(rows), () -> "Python csv read " + CsvGen.showRows(py2.rows()) + " from Commons CSV's " + Zoo.show(printedText)
+                    + " (" + mode + ", " + d + ") for " + CsvGen.showRows(rows));
+        }
+        if (rows.stream().flatMap(List::stream).noneMatch(s -> s.indexOf('\r') >= 0)) {
+            List<List<String>> fast2 = Rfc.fast(printedText, d);
+            Zoo.check(fast2.equals(rows), () -> "FastCSV read " + CsvGen.showRows(fast2) + " from Commons CSV's " + Zoo.show(printedText) + " (" + mode
+                    + ", " + d + ") for " + CsvGen.showRows(rows));
+        }
+        List<List<String>> back = Rfc.commons(printedText, format);
+        Zoo.check(back.equals(rows), () -> "Commons CSV read " + CsvGen.showRows(back) + " from its own " + Zoo.show(printedText) + " (" + mode + ", "
+                + d + ") for " + CsvGen.showRows(rows));
+
+        String quoting = Zoo.pick(tc, "minimal", "all", "nonnumeric");
+        String pyText = Py.write(rows, d.delimiter(), d.quote(), quoting, lineBreak);
+        List<List<String>> fromPy = Rfc.commons(pyText, format);
+        Zoo.check(fromPy.equals(rows), () -> "Commons CSV read " + CsvGen.showRows(fromPy) + " from Python's " + Zoo.show(pyText) + " (" + quoting
+                + ", " + d + ") for " + CsvGen.showRows(rows));
+
+        QuoteStrategies strategy = Zoo.pick(tc, QuoteStrategies.values());
+        LineDelimiter ld = lineBreak.equals("\n") ? LineDelimiter.LF : lineBreak.equals("\r") ? LineDelimiter.CR : LineDelimiter.CRLF;
+        String fastText = Rfc.fastWrite(rows, d, strategy, ld);
+        List<List<String>> fromFast = Rfc.commons(fastText, format);
+        Zoo.check(fromFast.equals(rows), () -> "Commons CSV read " + CsvGen.showRows(fromFast) + " from FastCSV's " + Zoo.show(fastText) + " ("
+                + strategy + ", " + d + ") for " + CsvGen.showRows(rows));
+
+        // 3. the plain all-quoted writer, through the RFC4180 and EXCEL predefined formats when the dialect is theirs
+        if (d.delimiter() == ',' && d.quote() == '"') {
+            String plain = Rfc.write(rows, d, lineBreak);
+            for (CSVFormat pre : Arrays.asList(CSVFormat.RFC4180, CSVFormat.EXCEL, CSVFormat.DEFAULT)) {
+                List<List<String>> got = Rfc.commons(plain, pre);
+                Zoo.check(got.equals(rows), () -> pre + " read " + CsvGen.showRows(got) + " from " + Zoo.show(plain) + " for " + CsvGen.showRows(rows));
+            }
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/CsvGen.java b/hegel/src/test/java/zoo/CsvGen.java
new file mode 100644
index 0000000..43c8759
--- /dev/null
+++ b/hegel/src/test/java/zoo/CsvGen.java
@@ -0,0 +1,461 @@
+package zoo;
+
+import dev.hegel.TestCase;
+import java.io.ByteArrayInputStream;
+import java.io.StringReader;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import org.apache.commons.csv.CSVFormat;
+import org.apache.commons.csv.QuoteMode;
+
+/**
+ * Generators for Commons CSV formats and values, and the model of what a value printed with a format reads back as
+ * when the same format parses the text (the CSVFormat Javadoc's contract for null strings, quote modes, trimming and
+ * surrounding spaces).
+ */
+final class CsvGen {
+    private CsvGen() {}
+
+    /** A Reader value whose content the model can see. */
+    static final class Rdr extends StringReader {
+        final String content;
+
+        Rdr(String s) {
+            super(s);
+            content = s;
+        }
+
+        @Override
+        public String toString() {
+            return "Reader(" + Zoo.show(content) + ")";
+        }
+    }
+
+    /** An InputStream value whose bytes the model can see; printed as Base64. */
+    static final class Bytes extends ByteArrayInputStream {
+        final byte[] data;
+
+        Bytes(byte[] b) {
+            super(b);
+            data = b;
+        }
+
+        @Override
+        public String toString() {
+            return "InputStream(" + data.length + " bytes)";
+        }
+    }
+
+    /** A format together with the choices that built it. */
+    record Fmt(CSVFormat format, String delimiter, Character quote, Character escape, QuoteMode mode, Character comment,
+            String nullString, String separator, boolean spaces, boolean emptyLines, boolean trim, boolean trailingDelimiter,
+            boolean lenientEof, boolean trailingData, String name) {
+
+        /** Values are written with the escape character rather than encapsulated. */
+        boolean escaping() {
+            return escape != null && (quote == null || mode == QuoteMode.NONE);
+        }
+
+        /** Neither quoting nor escaping: only safe values survive. */
+        boolean raw() {
+            return quote == null && escape == null;
+        }
+
+        /** The parser distinguishes quoted from unquoted empty fields (and null strings). */
+        boolean strict() {
+            return mode == QuoteMode.ALL_NON_NULL || mode == QuoteMode.NON_NUMERIC;
+        }
+
+        boolean minimal() {
+            return quote != null && (mode == null || mode == QuoteMode.MINIMAL);
+        }
+
+        boolean containsDelimiterChar(String s) {
+            for (char c : delimiter.toCharArray()) {
+                if (s.indexOf(c) >= 0) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        String describe() {
+            return (name != null ? name + " " : "") + format + (trim ? " trim" : "") + (trailingDelimiter ? " trailingDelimiter" : "")
+                    + (lenientEof ? " lenientEof" : "") + (trailingData ? " trailingData" : "") + " sep=" + Zoo.show(separator);
+        }
+    }
+
+    static final String[] SINGLE = {",", ";", "\t", "|", ":", " ", "§", "中", "x"};
+    static final String[] MULTI = {"||", "::", ",,", "<>", "\t\t", "|~|", ";;", "xy", "~~~", "[|]"};
+    static final Character[] QUOTES = {'"', '\'', '`'};
+    static final Character[] ESCAPES = {'\\', '!', '^', '~'};
+    static final Character[] COMMENTS = {'#', '!', '%', ';'};
+    static final String[] NULLS = {"NULL", "null", "-", "N/A", "\\N", "", "#", "%"};
+    static final String[] SEPARATORS = {"\n", "\n", "\n", "\r\n", "\r\n", "\r\n", "\r"};
+    static final CSVFormat.Predefined[] PREDEFINED = CSVFormat.Predefined.values();
+
+    static Fmt format(TestCase tc) {
+        if (Zoo.chance(tc, 15)) {
+            CSVFormat.Predefined p = Zoo.pick(tc, PREDEFINED);
+            return fromFormat(p.getFormat(), p.name());
+        }
+        for (int attempt = 0; attempt < 50; attempt++) {
+            String delimiter = Zoo.chance(tc, 75) ? Zoo.pick(tc, SINGLE) : Zoo.pick(tc, MULTI);
+            Character quote = Zoo.chance(tc, 70) ? Zoo.pick(tc, QUOTES) : null;
+            Character escape = Zoo.chance(tc, quote == null ? 70 : 35) ? Zoo.pick(tc, ESCAPES) : null;
+            QuoteMode mode;
+            int m = Zoo.n(tc, 0, 99);
+            if (m < 30) {
+                mode = null;
+            } else if (m < 45) {
+                mode = QuoteMode.MINIMAL;
+            } else if (m < 60) {
+                mode = QuoteMode.ALL;
+            } else if (m < 72) {
+                mode = QuoteMode.ALL_NON_NULL;
+            } else if (m < 84) {
+                mode = QuoteMode.NON_NUMERIC;
+            } else {
+                mode = escape != null ? QuoteMode.NONE : null;
+            }
+            Character comment = Zoo.chance(tc, 40) ? Zoo.pick(tc, COMMENTS) : null;
+            String nullString = Zoo.chance(tc, 45) ? Zoo.pick(tc, NULLS) : null;
+            if (quote != null && delimiter.indexOf(quote) >= 0 || escape != null && delimiter.indexOf(escape) >= 0
+                    || comment != null && delimiter.indexOf(comment) >= 0 || quote != null && quote.equals(comment)
+                    || escape != null && escape.equals(comment) || escape != null && escape.equals(quote)) {
+                continue;
+            }
+            if (nullString != null && (containsAny(nullString, delimiter) || quote != null && nullString.indexOf(quote) >= 0
+                    || escape != null && escape != '\\' && nullString.indexOf(escape) >= 0)) {
+                continue;
+            }
+            String separator = Zoo.pick(tc, SEPARATORS);
+            boolean spaces = Zoo.chance(tc, 30);
+            boolean emptyLines = Zoo.chance(tc, 50);
+            boolean trim = Zoo.chance(tc, 20);
+            boolean trailingDelimiter = Zoo.chance(tc, 20);
+            boolean lenientEof = Zoo.chance(tc, 30);
+            boolean trailingData = Zoo.chance(tc, 20);
+            CSVFormat.Builder b = CSVFormat.Builder.create().setDelimiter(delimiter).setQuote(quote).setEscape(escape).setQuoteMode(mode)
+                    .setCommentMarker(comment).setNullString(nullString).setRecordSeparator(separator).setIgnoreSurroundingSpaces(spaces)
+                    .setIgnoreEmptyLines(emptyLines).setTrim(trim).setTrailingDelimiter(trailingDelimiter).setLenientEof(lenientEof)
+                    .setTrailingData(trailingData);
+            return new Fmt(b.get(), delimiter, quote, escape, mode, comment, nullString, separator, spaces, emptyLines, trim,
+                    trailingDelimiter, lenientEof, trailingData, null);
+        }
+        return fromFormat(CSVFormat.DEFAULT, "DEFAULT");
+    }
+
+    static Fmt fromFormat(CSVFormat f, String name) {
+        return new Fmt(f, f.getDelimiterString(), f.getQuoteCharacter(), f.getEscapeCharacter(), f.getQuoteMode(), f.getCommentMarker(),
+                f.getNullString(), f.getRecordSeparator(), f.getIgnoreSurroundingSpaces(), f.getIgnoreEmptyLines(), f.getTrim(),
+                f.getTrailingDelimiter(), f.getLenientEof(), f.getTrailingData(), name);
+    }
+
+    static boolean containsAny(String s, String chars) {
+        for (int i = 0; i < chars.length(); i++) {
+            if (s.indexOf(chars.charAt(i)) >= 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static final String COMMON = "ab1 0#\"'`\\,;|: \t\n\r!~%<>xyé \u00a0中\u0001\u007f";
+
+    /** A string value fit for the format: anything for quoting/escaping formats, only safe characters for raw ones. */
+    static String value(TestCase tc, Fmt f) {
+        StringBuilder alphabet = new StringBuilder(COMMON).append(f.delimiter);
+        if (f.quote != null) {
+            alphabet.append(f.quote);
+        }
+        if (f.escape != null) {
+            alphabet.append(f.escape);
+        }
+        if (f.comment != null) {
+            alphabet.append(f.comment);
+        }
+        String a = alphabet.toString();
+        if (f.raw()) {
+            StringBuilder safe = new StringBuilder();
+            for (int i = 0; i < a.length(); i++) {
+                char c = a.charAt(i);
+                if (c != '\r' && c != '\n' && f.delimiter.indexOf(c) < 0 && (f.comment == null || c != f.comment)) {
+                    safe.append(c);
+                }
+            }
+            a = safe.toString();
+        }
+        int len = Zoo.chance(tc, 10) ? Zoo.n(tc, 8, 40) : Zoo.n(tc, 0, 6);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            if (Zoo.chance(tc, 4)) {
+                sb.append("😀");
+            } else {
+                sb.append(a.charAt(Zoo.n(tc, 0, a.length() - 1)));
+            }
+        }
+        if (!f.raw()) {
+            if (f.comment != null && Zoo.chance(tc, 8)) {
+                sb.insert(0, f.comment.charValue());
+            }
+            if (f.delimiter.length() > 1 && Zoo.chance(tc, 12)) {
+                sb.append(f.delimiter, 0, Zoo.n(tc, 1, f.delimiter.length() - 1));
+            }
+            if (f.quote != null && Zoo.chance(tc, 5)) {
+                sb.insert(0, f.quote.charValue());
+            }
+        }
+        if (f.nullString != null && Zoo.chance(tc, 6)) {
+            return f.nullString;
+        }
+        return sb.toString();
+    }
+
+    static Number number(TestCase tc) {
+        return switch (Zoo.n(tc, 0, 7)) {
+            case 0 -> Zoo.n(tc, -1000, 1000);
+            case 1 -> Long.MIN_VALUE;
+            case 2 -> Zoo.pick(tc, 1.5, -0.0, Double.NaN, 1e300, Double.MIN_VALUE);
+            case 3 -> new BigDecimal("1E+10");
+            case 4 -> new BigInteger("123456789012345678901234567890");
+            case 5 -> (short) Zoo.n(tc, -300, 300);
+            case 6 -> 0.1f;
+            default -> Zoo.n(tc, 0, 9);
+        };
+    }
+
+    /** A cell: null, a Number, a Reader or InputStream (quoting formats only), a StringBuilder or a String. */
+    static Object cell(TestCase tc, Fmt f) {
+        int k = Zoo.n(tc, 0, 99);
+        if (k < 18) {
+            return null;
+        }
+        if (k < 26) {
+            return number(tc);
+        }
+        if (k < 30 && f.quote != null) {
+            return new Rdr(value(tc, f));
+        }
+        if (k < 33 && f.quote != null) {
+            byte[] b = new byte[Zoo.n(tc, 0, 30)];
+            for (int i = 0; i < b.length; i++) {
+                b[i] = (byte) Zoo.n(tc, 0, 255);
+            }
+            return new Bytes(b);
+        }
+        if (k < 37) {
+            return new StringBuilder(value(tc, f));
+        }
+        return value(tc, f);
+    }
+
+    static List<Object> record(TestCase tc, Fmt f) {
+        int n = Zoo.chance(tc, 12) ? Zoo.n(tc, 0, 1) : Zoo.n(tc, 1, 5);
+        List<Object> cells = new ArrayList<>();
+        for (int i = 0; i < n; i++) {
+            cells.add(cell(tc, f));
+        }
+        return cells;
+    }
+
+    // ---- the read-back model ----
+
+    /** The text the printer writes for a value (before trimming). */
+    static String text(Object v) {
+        if (v == null) {
+            return null;
+        }
+        if (v instanceof Rdr r) {
+            return r.content;
+        }
+        if (v instanceof Bytes b) {
+            return Base64.getEncoder().encodeToString(b.data);
+        }
+        return v.toString();
+    }
+
+    /** Leading whitespace the lexer skips before an unquoted token: not line breaks (they are escaped) nor delimiter characters. */
+    static String stripUnquoted(Fmt f, String s) {
+        int start = 0;
+        while (start < s.length()) {
+            char c = s.charAt(start);
+            if (!Character.isWhitespace(c) || c == '\r' || c == '\n' || f.delimiter.indexOf(c) >= 0) {
+                break;
+            }
+            start++;
+        }
+        int end = s.length();
+        while (end > start && Character.isWhitespace(s.charAt(end - 1))) {
+            end--;
+        }
+        return s.substring(start, end);
+    }
+
+    /** What an empty unquoted field reads as. */
+    static String emptyRead(Fmt f) {
+        if (f.nullString != null) {
+            return f.nullString.isEmpty() ? null : "";
+        }
+        return f.strict() ? null : "";
+    }
+
+    /** Whether the value is encapsulated on output (only asked for strict modes, where it decides the null-string reading). */
+    static boolean encapsulated(Fmt f, Object v) {
+        if (f.quote == null) {
+            return false;
+        }
+        if (v instanceof Bytes) {
+            return true;
+        }
+        if (f.mode == QuoteMode.NONE) {
+            return false;
+        }
+        if (v instanceof Rdr || f.mode == QuoteMode.ALL || f.mode == QuoteMode.ALL_NON_NULL) {
+            return true;
+        }
+        if (f.mode == QuoteMode.NON_NUMERIC) {
+            return !(v instanceof Number);
+        }
+        return false; // minimal: unknown here, never needed
+    }
+
+    /** The value the parser gives back for a printed cell; {@code first} = the cell starts its record. */
+    static String expected(Fmt f, Object v, boolean first) {
+        if (v == null) {
+            if (f.nullString == null) {
+                return f.strict() ? null : "";
+            }
+            return null;
+        }
+        String t = text(v);
+        if (f.trim) {
+            t = t.trim();
+        }
+        String r = t;
+        if (f.spaces && (f.escaping() || f.raw()) && !(v instanceof Bytes && f.quote != null)) {
+            // the lexer strips Unicode whitespace around an unquoted token whether or not the format also trims
+            r = stripUnquoted(f, t);
+            if (f.trim) {
+                r = r.trim();
+            }
+        }
+        if (r.isEmpty() && f.strict() && f.nullString == null && !encapsulated(f, v)) {
+            return null; // an unquoted empty field is null in the strict quote modes
+        }
+        if (f.nullString != null && r.equals(f.nullString)) {
+            boolean translated = f.escape != null && !f.escape.equals(f.quote)
+                    && (t.indexOf(f.escape) >= 0 || f.quote != null && t.indexOf(f.quote) >= 0);
+            if (f.escaping() && f.comment != null && !t.isEmpty() && t.charAt(0) == f.comment) {
+                // the escape-mode printer escapes a leading comment marker in every cell, not only the first
+                translated = true;
+            }
+            if (!(f.strict() && encapsulated(f, v)) && !translated) {
+                return null;
+            }
+        }
+        return r;
+    }
+
+    /** Whether the cell prints as nothing at all (so a record of just this cell is an empty line). */
+    static boolean printsEmptyUnquoted(Fmt f, Object v) {
+        if (v == null) {
+            if (f.nullString != null && !f.nullString.isEmpty()) {
+                return false;
+            }
+            if (f.minimal()) {
+                return false;
+            }
+            return !(f.mode == QuoteMode.ALL && f.nullString != null);
+        }
+        if (v instanceof Bytes b) {
+            return f.quote == null && b.data.length == 0;
+        }
+        if (v instanceof Rdr r) {
+            return !(f.quote != null && f.mode != QuoteMode.NONE) && r.content.isEmpty();
+        }
+        String t = text(v);
+        if (f.trim) {
+            t = t.trim();
+        }
+        if (!t.isEmpty()) {
+            return false;
+        }
+        return !(f.quote != null && f.mode != QuoteMode.NONE);
+    }
+
+    /** The record the parser gives back for a printed record, or null when the line is dropped as empty. */
+    static List<String> expectedRecord(Fmt f, List<Object> cells) {
+        if (cells.isEmpty() || cells.size() == 1 && printsEmptyUnquoted(f, cells.get(0))) {
+            if (!f.trailingDelimiter && f.emptyLines) {
+                return null;
+            }
+            List<String> one = new ArrayList<>();
+            one.add(emptyRead(f));
+            return one;
+        }
+        List<String> out = new ArrayList<>();
+        for (int i = 0; i < cells.size(); i++) {
+            out.add(expected(f, cells.get(i), i == 0));
+        }
+        return out;
+    }
+
+    /** commons-csv/1 shape: a null whose null string starts with the comment marker turns the record into a comment. */
+    static boolean nullStringIsComment(Fmt f) {
+        return f.nullString != null && !f.nullString.isEmpty() && f.comment != null && f.nullString.charAt(0) == f.comment
+                && f.mode != QuoteMode.ALL;
+    }
+
+    /** commons-csv/6 shape: QuoteMode.ALL without a quote character wraps the null string in double quotes. */
+    static boolean quotelessAllNull(Fmt f) {
+        return f.quote == null && f.mode == QuoteMode.ALL && f.nullString != null;
+    }
+
+    /** Replaces the cells of the known-bug shapes (the pins carry them). */
+    static void skipKnownBugs(Fmt f, List<Object> cells) {
+        for (int i = 0; i < cells.size(); i++) {
+            if (cells.get(i) == null && (i == 0 && nullStringIsComment(f) || quotelessAllNull(f))) {
+                cells.set(i, plain(f));
+            }
+        }
+    }
+
+    /** A one-letter value that is neither a special character of the format nor its null string. */
+    static String plain(Fmt f) {
+        for (String c : new String[] {"x", "y", "q", "z", "k"}) {
+            char ch = c.charAt(0);
+            boolean special = f.delimiter.indexOf(ch) >= 0 || f.quote != null && f.quote == ch || f.escape != null && f.escape == ch
+                    || f.comment != null && f.comment == ch || c.equals(f.nullString);
+            if (!special) {
+                return c;
+            }
+        }
+        return "k";
+    }
+
+    static String showCells(List<Object> cells) {
+        StringBuilder sb = new StringBuilder("[");
+        for (int i = 0; i < cells.size(); i++) {
+            Object c = cells.get(i);
+            sb.append(i > 0 ? ", " : "").append(c instanceof StringBuilder ? "SB" + Zoo.show(c.toString()) : Zoo.show(c));
+        }
+        return sb.append("]").toString();
+    }
+
+    static String showRows(List<? extends List<String>> rows) {
+        StringBuilder sb = new StringBuilder("[");
+        for (int i = 0; i < rows.size(); i++) {
+            sb.append(i > 0 ? ", [" : "[");
+            List<String> r = rows.get(i);
+            for (int j = 0; j < r.size(); j++) {
+                sb.append(j > 0 ? ", " : "").append(Zoo.show(r.get(j)));
+            }
+            sb.append("]");
+        }
+        return sb.append("]").toString();
+    }
+}
diff --git a/hegel/src/test/java/zoo/Py.java b/hegel/src/test/java/zoo/Py.java
new file mode 100644
index 0000000..31c004a
--- /dev/null
+++ b/hegel/src/test/java/zoo/Py.java
@@ -0,0 +1,115 @@
+package zoo;
+
+import com.google.gson.Gson;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Python's csv module as a child process (hegel/oracle.py), one JSON request line per call. */
+final class Py {
+    private Py() {}
+
+    private static final Gson GSON = new Gson();
+    private static Process process;
+    private static BufferedWriter out;
+    private static BufferedReader in;
+
+    record Rows(List<List<String>> rows, String error) {}
+
+    private static synchronized void start() {
+        if (process != null) {
+            return;
+        }
+        String env = System.getenv("ZOO_ORACLE");
+        Path script = env != null && !env.isEmpty() ? Paths.get(env) : Paths.get("oracle.py");
+        if (!Files.exists(script)) {
+            script = Paths.get("hegel", "oracle.py");
+        }
+        try {
+            ProcessBuilder pb = new ProcessBuilder("python3", script.toAbsolutePath().toString());
+            pb.redirectError(ProcessBuilder.Redirect.INHERIT);
+            process = pb.start();
+            out = new BufferedWriter(new OutputStreamWriter(process.getOutputStream(), StandardCharsets.UTF_8));
+            in = new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8));
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    static synchronized JsonObject call(Map<String, Object> request) {
+        start();
+        try {
+            out.write(GSON.toJson(request));
+            out.write('\n');
+            out.flush();
+            String line = in.readLine();
+            if (line == null) {
+                throw new IllegalStateException("the Python oracle died");
+            }
+            return JsonParser.parseString(line).getAsJsonObject();
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    static Rows read(String text, char delimiter, char quote, boolean skipInitialSpace) {
+        Map<String, Object> req = new LinkedHashMap<>();
+        req.put("op", "read");
+        req.put("text", text);
+        req.put("delimiter", String.valueOf(delimiter));
+        req.put("quotechar", String.valueOf(quote));
+        req.put("skipinitialspace", skipInitialSpace);
+        JsonObject reply = call(req);
+        if (reply.has("error")) {
+            return new Rows(null, reply.get("error").getAsString());
+        }
+        List<List<String>> rows = new ArrayList<>();
+        for (JsonElement row : reply.getAsJsonArray("rows")) {
+            List<String> r = new ArrayList<>();
+            for (JsonElement cell : row.getAsJsonArray()) {
+                r.add(cell.isJsonNull() ? null : cell.getAsString());
+            }
+            rows.add(r);
+        }
+        return new Rows(rows, null);
+    }
+
+    /** quoting: minimal, all or nonnumeric. */
+    static String write(List<List<String>> rows, char delimiter, char quote, String quoting, String lineTerminator) {
+        Map<String, Object> req = new LinkedHashMap<>();
+        req.put("op", "write");
+        JsonArray arr = new JsonArray();
+        for (List<String> row : rows) {
+            JsonArray r = new JsonArray();
+            for (String s : row) {
+                r.add(s);
+            }
+            arr.add(r);
+        }
+        req.put("rows", arr);
+        req.put("delimiter", String.valueOf(delimiter));
+        req.put("quotechar", String.valueOf(quote));
+        req.put("quoting", quoting);
+        req.put("lineterminator", lineTerminator);
+        JsonObject reply = call(req);
+        if (reply.has("error")) {
+            throw new IllegalStateException("Python csv.writer: " + reply.get("error").getAsString());
+        }
+        return reply.get("text").getAsString();
+    }
+}
diff --git a/hegel/src/test/java/zoo/Rfc.java b/hegel/src/test/java/zoo/Rfc.java
new file mode 100644
index 0000000..e288ae9
--- /dev/null
+++ b/hegel/src/test/java/zoo/Rfc.java
@@ -0,0 +1,164 @@
+package zoo;
+
+import de.siegmar.fastcsv.reader.CommentStrategy;
+import de.siegmar.fastcsv.reader.CsvReader;
+import de.siegmar.fastcsv.reader.CsvRecord;
+import de.siegmar.fastcsv.writer.CsvWriter;
+import de.siegmar.fastcsv.writer.LineDelimiter;
+import de.siegmar.fastcsv.writer.QuoteStrategy;
+import dev.hegel.TestCase;
+import java.io.IOException;
+import java.io.StringWriter;
+import java.io.UncheckedIOException;
+import java.util.ArrayList;
+import java.util.List;
+import org.apache.commons.csv.CSVFormat;
+import org.apache.commons.csv.CSVParser;
+import org.apache.commons.csv.CSVRecord;
+
+/** RFC 4180-style dialects: a text grammar with known rows, a plain writer, and the FastCSV and Commons CSV readers. */
+final class Rfc {
+    private Rfc() {}
+
+    record Dialect(char delimiter, char quote) {}
+
+    record Text(String text, List<List<String>> rows) {}
+
+    static final char[] DELIMITERS = {',', ';', '\t', '|'};
+    static final char[] QUOTE_CHARS = {'"', '\''};
+    static final String[] BREAKS = {"\n", "\r\n", "\r"};
+    static final String PLAIN = "ab 01#\\xyé中~!%-";
+    static final String ANY = "ab 01#\\xyé中~!%-,;|\t\"'\r\n";
+
+    static Dialect dialect(TestCase tc) {
+        return new Dialect(Zoo.pick(tc, ',', ';', '\t', '|'), Zoo.pick(tc, '"', '\''));
+    }
+
+    /** A string over the alphabet, with the dialect's delimiter and quote character added to it if {@code any}. */
+    static String field(TestCase tc, Dialect d, boolean any) {
+        String alphabet = any ? ANY + d.delimiter + d.quote : PLAIN;
+        String s = Zoo.word(tc, alphabet, 0, Zoo.chance(tc, 10) ? 20 : 5);
+        if (!any) {
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c != d.delimiter && c != d.quote && c != '\r' && c != '\n') {
+                    sb.append(c);
+                }
+            }
+            s = sb.toString();
+        }
+        if (Zoo.chance(tc, 4)) {
+            s += "😀";
+        }
+        return s;
+    }
+
+    static String quoted(String s, char q) {
+        return q + s.replace(String.valueOf(q), "" + q + q) + q;
+    }
+
+    /** Well-formed text: rows of quoted or plain fields, a zero-field row being an empty line; rows as a parser reads them. */
+    static Text text(TestCase tc, Dialect d) {
+        StringBuilder sb = new StringBuilder();
+        List<List<String>> rows = new ArrayList<>();
+        int n = Zoo.n(tc, 0, 6);
+        String previousBreak = null;
+        for (int i = 0; i < n; i++) {
+            // after a lone CR the next line must not be empty or start with a plain empty field: CR LF would read as one break
+            boolean afterCr = "\r".equals(previousBreak);
+            int fields = Zoo.chance(tc, 15) && !afterCr ? 0 : Zoo.n(tc, 1, 5);
+            boolean last = i == n - 1;
+            boolean terminated = !last || Zoo.chance(tc, 70);
+            List<String> row = new ArrayList<>();
+            for (int j = 0; j < fields; j++) {
+                if (j > 0) {
+                    sb.append(d.delimiter);
+                }
+                boolean q = Zoo.chance(tc, 45) || afterCr && j == 0;
+                String f = field(tc, d, q);
+                sb.append(q ? quoted(f, d.quote) : f);
+                row.add(f);
+            }
+            if (fields == 0) {
+                if (!terminated) {
+                    continue; // nothing at all
+                }
+                row.add("");
+            }
+            previousBreak = terminated ? Zoo.pick(tc, BREAKS) : null;
+            if (terminated) {
+                sb.append(previousBreak);
+            }
+            rows.add(row);
+        }
+        return new Text(sb.toString(), rows);
+    }
+
+    /** Every field quoted: unambiguous text for any RFC reader. */
+    static String write(List<? extends List<String>> rows, Dialect d, String lineBreak) {
+        StringBuilder sb = new StringBuilder();
+        for (List<String> row : rows) {
+            for (int j = 0; j < row.size(); j++) {
+                if (j > 0) {
+                    sb.append(d.delimiter);
+                }
+                sb.append(quoted(row.get(j), d.quote));
+            }
+            sb.append(lineBreak);
+        }
+        return sb.toString();
+    }
+
+    static List<List<String>> fast(String text, Dialect d) {
+        List<List<String>> rows = new ArrayList<>();
+        try (CsvReader<CsvRecord> reader = CsvReader.builder().fieldSeparator(d.delimiter).quoteCharacter(d.quote)
+                .commentStrategy(CommentStrategy.NONE).skipEmptyLines(false).allowExtraFields(true).allowMissingFields(true)
+                .ofCsvRecord(text)) {
+            for (CsvRecord r : reader) {
+                rows.add(new ArrayList<>(r.getFields()));
+            }
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+        return rows;
+    }
+
+    static String fastWrite(List<? extends List<String>> rows, Dialect d, QuoteStrategy strategy, LineDelimiter lineDelimiter) {
+        StringWriter w = new StringWriter();
+        try (CsvWriter writer = CsvWriter.builder().fieldSeparator(d.delimiter).quoteCharacter(d.quote).quoteStrategy(strategy)
+                .lineDelimiter(lineDelimiter).build(w)) {
+            for (List<String> row : rows) {
+                writer.writeRecord(row);
+            }
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+        return w.toString();
+    }
+
+    static List<List<String>> commons(String text, CSVFormat format) throws IOException {
+        List<List<String>> rows = new ArrayList<>();
+        try (CSVParser parser = CSVParser.parse(text, format)) {
+            for (CSVRecord r : parser) {
+                rows.add(r.toList());
+            }
+        }
+        return rows;
+    }
+
+    /** Python and FastCSV report an empty line as a record without fields; Commons CSV as one empty field. */
+    static List<List<String>> emptyAsOneField(List<List<String>> rows) {
+        List<List<String>> out = new ArrayList<>();
+        for (List<String> r : rows) {
+            if (r.isEmpty()) {
+                List<String> one = new ArrayList<>();
+                one.add("");
+                out.add(one);
+            } else {
+                out.add(r);
+            }
+        }
+        return out;
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..2ca81bf
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,120 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+
+    /** Rethrows any throwable unchecked (for control-flow exceptions such as Hegel's that must not be swallowed). */
+    @SuppressWarnings("unchecked")
+    static <T extends Throwable> void sneaky(Throwable t) throws T {
+        throw (T) t;
+    }
+}
