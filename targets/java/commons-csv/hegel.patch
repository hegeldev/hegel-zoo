+package zoo;
+
+import com.google.gson.Gson;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Python's csv module as a child process (hegel/oracle.py), one JSON request line per call. */
+final class Py {
+    private Py() {}
+
+    private static final Gson GSON = new Gson();
+    private static Process process;
+    private static BufferedWriter out;
+    private static BufferedReader in;
+
+    record Rows(List<List<String>> rows, String error) {}
+
+    private static synchronized void start() {
+        if (process != null) {
+            return;
+        }
+        String env = System.getenv("ZOO_ORACLE");
+        Path script = env != null && !env.isEmpty() ? Paths.get(env) : Paths.get("oracle.py");
+        if (!Files.exists(script)) {
+            script = Paths.get("hegel", "oracle.py");
+        }
+        try {
+            ProcessBuilder pb = new ProcessBuilder("python3", script.toAbsolutePath().toString());
+            pb.redirectError(ProcessBuilder.Redirect.INHERIT);
+            process = pb.start();
+            out = new BufferedWriter(new OutputStreamWriter(process.getOutputStream(), StandardCharsets.UTF_8));
+            in = new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8));
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    static synchronized JsonObject call(Map<String, Object> request) {
+        start();
+        try {
+            out.write(GSON.toJson(request));
+            out.write('\n');
+            out.flush();
+            String line = in.readLine();
+            if (line == null) {
+                throw new IllegalStateException("the Python oracle died");
+            }
+            return JsonParser.parseString(line).getAsJsonObject();
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    static Rows read(String text, char delimiter, char quote, boolean skipInitialSpace) {
+        Map<String, Object> req = new LinkedHashMap<>();
+        req.put("op", "read");
+        req.put("text", text);
+        req.put("delimiter", String.valueOf(delimiter));
+        req.put("quotechar", String.valueOf(quote));
+        req.put("skipinitialspace", skipInitialSpace);
+        JsonObject reply = call(req);
+        if (reply.has("error")) {
+            return new Rows(null, reply.get("error").getAsString());
+        }
+        List<List<String>> rows = new ArrayList<>();
+        for (JsonElement row : reply.getAsJsonArray("rows")) {
+            List<String> r = new ArrayList<>();
+            for (JsonElement cell : row.getAsJsonArray()) {
+                r.add(cell.isJsonNull() ? null : cell.getAsString());
+            }
+            rows.add(r);
+        }
+        return new Rows(rows, null);
+    }
+
+    /** quoting: minimal, all or nonnumeric. */
+    static String write(List<List<String>> rows, char delimiter, char quote, String quoting, String lineTerminator) {
+        Map<String, Object> req = new LinkedHashMap<>();
+        req.put("op", "write");
+        JsonArray arr = new JsonArray();
+        for (List<String> row : rows) {
+            JsonArray r = new JsonArray();
+            for (String s : row) {
+                r.add(s);
+            }
+            arr.add(r);
+        }
+        req.put("rows", arr);
+        req.put("delimiter", String.valueOf(delimiter));
+        req.put("quotechar", String.valueOf(quote));
+        req.put("quoting", quoting);
+        req.put("lineterminator", lineTerminator);
+        JsonObject reply = call(req);
+        if (reply.has("error")) {
+            throw new IllegalStateException("Python csv.writer: " + reply.get("error").getAsString());
+        }
+        return reply.get("text").getAsString();
+    }
+}
diff --git a/hegel/src/test/java/zoo/Rfc.java b/hegel/src/test/java/zoo/Rfc.java
new file mode 100644
index 0000000..7b9259a
--- /dev/null
+++ b/hegel/src/test/java/zoo/Rfc.java
@@ -0,0 +1,185 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static zoo.CsvGen.chance;
+import static zoo.CsvGen.w;
+import static zoo.CsvGen.weighted;
+import static zoo.CsvGen.word;
+
+import de.siegmar.fastcsv.reader.CommentStrategy;
+import de.siegmar.fastcsv.reader.CsvReader;
+import de.siegmar.fastcsv.reader.CsvRecord;
+import de.siegmar.fastcsv.writer.CsvWriter;
+import de.siegmar.fastcsv.writer.LineDelimiter;
+import de.siegmar.fastcsv.writer.QuoteStrategy;
+import dev.hegel.Generator;
+import java.io.IOException;
+import java.io.StringWriter;
+import java.io.UncheckedIOException;
+import java.util.ArrayList;
+import java.util.List;
+import org.apache.commons.csv.CSVFormat;
+import org.apache.commons.csv.CSVParser;
+import org.apache.commons.csv.CSVRecord;
+
+/**
+ * RFC 4180-style dialects: a text grammar with known rows (rows of plain or quoted fields as data, rendered by a pure
+ * function that keeps the text unambiguous), a plain writer, and the FastCSV and Commons CSV readers.
+ */
+final class Rfc {
+    private Rfc() {}
+
+    record Dialect(char delimiter, char quote) {}
+
+    record Text(String text, List<List<String>> rows) {}
+
+    /** A field as it is written: plain, or quoted (then it may hold the delimiter, quotes and line breaks). */
+    record Field(String text, boolean quoted) {}
+
+    /** A line of the text: fields (none = an empty line) and the line break after it. */
+    record Row(List<Field> fields, String lineBreak) {}
+
+    static final char[] DELIMITERS = {',', ';', '\t', '|'};
+    static final char[] QUOTE_CHARS = {'"', '\''};
+    static final String[] BREAKS = {"\n", "\r\n", "\r"};
+    static final String PLAIN = "ab 01#\\xyé中~!%-";
+    static final String ANY = "ab 01#\\xyé中~!%-,;|\t\"'\r\n";
+
+    static final Generator<Dialect> DIALECT = tuples(sampledFrom(',', ';', '\t', '|'), sampledFrom('"', '\'')).map(t -> new Dialect(t.value1(), t.value2()));
+
+    /** A string over the alphabet (with the dialect's delimiter and quote character if {@code any}), mostly short, sometimes with an emoji. */
+    static Generator<String> field(Dialect d, boolean any) {
+        String alphabet = any ? ANY + d.delimiter + d.quote : PLAIN;
+        Generator<String> s = weighted(w(90, word(alphabet, 0, 5)), w(10, word(alphabet, 0, 20)));
+        return tuples(s, chance(4)).map(t -> t.value2() ? t.value1() + "😀" : t.value1());
+    }
+
+    /** A plain field (weight 55) or a quoted one. */
+    static Generator<Field> field(Dialect d) {
+        return weighted(w(55, field(d, false).map(s -> new Field(s, false))), w(45, field(d, true).map(s -> new Field(s, true))));
+    }
+
+    /** An empty line (weight 15) or one to five fields, with its line break. */
+    static Generator<Row> row(Dialect d) {
+        Generator<List<Field>> fields = weighted(w(15, just(List.<Field>of())), w(85, lists(field(d)).minSize(1).maxSize(5)));
+        return tuples(fields, sampledFrom(BREAKS)).map(t -> new Row(t.value1(), t.value2()));
+    }
+
+    /** Well-formed text of up to six rows, the last one sometimes without its line break, with the rows as a parser reads them. */
+    static Generator<Text> text(Dialect d) {
+        return tuples(lists(row(d)).maxSize(6), chance(30)).map(t -> render(d, t.value1(), t.value2()));
+    }
+
+    /**
+     * The text of the rows. After a lone CR the next line must not be empty or start with a plain empty field (CR LF
+     * would read as one break): an empty line there is dropped and a first field quoted. An unterminated last line
+     * with nothing on it (no fields, or one plain empty field) is nothing at all.
+     */
+    static Text render(Dialect d, List<Row> rows, boolean unterminatedLast) {
+        StringBuilder sb = new StringBuilder();
+        List<List<String>> out = new ArrayList<>();
+        String previousBreak = null;
+        for (int i = 0; i < rows.size(); i++) {
+            Row row = rows.get(i);
+            boolean afterCr = "\r".equals(previousBreak);
+            boolean terminated = i < rows.size() - 1 || !unterminatedLast;
+            List<String> values = new ArrayList<>();
+            StringBuilder line = new StringBuilder();
+            for (int j = 0; j < row.fields().size(); j++) {
+                Field f = row.fields().get(j);
+                if (j > 0) {
+                    line.append(d.delimiter);
+                }
+                line.append(f.quoted() || afterCr && j == 0 ? quoted(f.text(), d.quote) : f.text());
+                values.add(f.text());
+            }
+            if (row.fields().isEmpty()) {
+                values.add("");
+            }
+            if (line.isEmpty() && (afterCr || !terminated)) {
+                continue;
+            }
+            sb.append(line);
+            previousBreak = terminated ? row.lineBreak() : null;
+            if (terminated) {
+                sb.append(row.lineBreak());
+            }
+            out.add(values);
+        }
+        return new Text(sb.toString(), out);
+    }
+
+    static String quoted(String s, char q) {
+        return q + s.replace(String.valueOf(q), "" + q + q) + q;
+    }
+
+    /** Every field quoted: unambiguous text for any RFC reader. */
+    static String write(List<? extends List<String>> rows, Dialect d, String lineBreak) {
+        StringBuilder sb = new StringBuilder();
+        for (List<String> row : rows) {
+            for (int j = 0; j < row.size(); j++) {
+                if (j > 0) {
+                    sb.append(d.delimiter);
+                }
+                sb.append(quoted(row.get(j), d.quote));
+            }
+            sb.append(lineBreak);
+        }
+        return sb.toString();
+    }
+
+    static List<List<String>> fast(String text, Dialect d) {
+        List<List<String>> rows = new ArrayList<>();
+        try (CsvReader<CsvRecord> reader = CsvReader.builder().fieldSeparator(d.delimiter).quoteCharacter(d.quote)
+                .commentStrategy(CommentStrategy.NONE).skipEmptyLines(false).allowExtraFields(true).allowMissingFields(true)
+                .ofCsvRecord(text)) {
+            for (CsvRecord r : reader) {
+                rows.add(new ArrayList<>(r.getFields()));
+            }
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+        return rows;
+    }
+
+    static String fastWrite(List<? extends List<String>> rows, Dialect d, QuoteStrategy strategy, LineDelimiter lineDelimiter) {
+        StringWriter w = new StringWriter();
+        try (CsvWriter writer = CsvWriter.builder().fieldSeparator(d.delimiter).quoteCharacter(d.quote).quoteStrategy(strategy)
+                .lineDelimiter(lineDelimiter).build(w)) {
+            for (List<String> row : rows) {
+                writer.writeRecord(row);
+            }
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+        return w.toString();
+    }
+
+    static List<List<String>> commons(String text, CSVFormat format) throws IOException {
+        List<List<String>> rows = new ArrayList<>();
+        try (CSVParser parser = CSVParser.parse(text, format)) {
+            for (CSVRecord r : parser) {
+                rows.add(r.toList());
+            }
+        }
+        return rows;
+    }
+
+    /** Python and FastCSV report an empty line as a record without fields; Commons CSV as one empty field. */
+    static List<List<String>> emptyAsOneField(List<List<String>> rows) {
+        List<List<String>> out = new ArrayList<>();
+        for (List<String> r : rows) {
+            if (r.isEmpty()) {
+                List<String> one = new ArrayList<>();
+                one.add("");
+                out.add(one);
+            } else {
+                out.add(r);
+            }
+        }
+        return out;
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..d65cb22
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,93 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    /**
+     * Off by default: the properties draw the recorded bugs' shapes (bugs.toml) and fail on them, and are the expected
+     * failures beside the pins. {@code HEGEL_NO_KNOWN=1} switches the shapes off, for a run that looks past the known bugs.
+     */
+    static final boolean NO_KNOWN = notEmpty(System.getenv("HEGEL_NO_KNOWN"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
