+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for Apache Commons CSV, added by the Hegel zoo (targets/java/commons-csv). Runs against the
+     org.apache.commons:commons-csv artifact that `[run] setup` installs from this checkout into the local Maven
+     repository. Oracles: the generated values themselves (printer -> parser round trips over the whole CSVFormat option
+     space), Python's csv module as a child process and FastCSV in process as independent readers and writers of the
+     RFC 4180 dialects, and text-position/header/format models written in the tests. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>commons-csv-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <commons-csv.version>1.15.0-SNAPSHOT</commons-csv.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.apache.commons</groupId>
+      <artifactId>commons-csv</artifactId>
+      <version>${commons-csv.version}</version>
+    </dependency>
+    <dependency>
+      <!-- independent reader/writer of the RFC 4180 dialects -->
+      <groupId>de.siegmar</groupId>
+      <artifactId>fastcsv</artifactId>
+      <version>4.0.0</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <!-- JSON lines to and from the Python csv oracle -->
+      <groupId>com.google.code.gson</groupId>
+      <artifactId>gson</artifactId>
+      <version>2.13.1</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+          <environmentVariables>
+            <ZOO_ORACLE>${project.basedir}/oracle.py</ZOO_ORACLE>
+          </environmentVariables>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/CommonsCsvParserTest.java b/hegel/src/test/java/zoo/CommonsCsvParserTest.java
new file mode 100644
index 0000000..cf98381
--- /dev/null
+++ b/hegel/src/test/java/zoo/CommonsCsvParserTest.java
@@ -0,0 +1,726 @@
+package zoo;
+
+import dev.hegel.HealthCheck;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.io.Reader;
+import java.io.StringReader;
+import java.io.StringWriter;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.NoSuchElementException;
+import java.util.Objects;
+import java.util.TreeMap;
+import java.util.function.Supplier;
+import org.apache.commons.csv.CSVFormat;
+import org.apache.commons.csv.CSVParser;
+import org.apache.commons.csv.CSVPrinter;
+import org.apache.commons.csv.CSVRecord;
+import org.apache.commons.csv.DuplicateHeaderMode;
+import org.apache.commons.csv.QuoteMode;
+import org.junit.jupiter.api.Test;
+
+/** CSVParser's headers, positions and comments against models of the text, and CSVFormat as a value. */
+class CommonsCsvParserTest {
+
+    /** A test case body that may throw checked exceptions. */
+    interface Body {
+        void run(TestCase tc) throws Exception;
+    }
+
+    static void run(TestCase tc, Body body) {
+        try {
+            body.run(tc);
+        } catch (RuntimeException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    static Object outcome(Supplier<?> f) {
+        try {
+            return f.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String kind(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : "value " + Zoo.show(o);
+    }
+
+    /** A reader that hands out the text in random small chunks (a pipe or socket). */
+    static final class Chunked extends Reader {
+        private final String text;
+        private final int[] sizes;
+        private int pos;
+        private int k;
+
+        Chunked(String text, int[] sizes) {
+            this.text = text;
+            this.sizes = sizes;
+        }
+
+        @Override
+        public int read(char[] buf, int off, int len) {
+            if (len == 0) {
+                return 0;
+            }
+            if (pos >= text.length()) {
+                return -1;
+            }
+            int n = Math.min(len, Math.min(sizes[k++ % sizes.length], text.length() - pos));
+            text.getChars(pos, pos + n, buf, off);
+            pos += n;
+            return n;
+        }
+
+        @Override
+        public void close() {}
+    }
+
+    // ---------------------------------------------------------------- headers
+
+    enum HeaderMode { NONE, AUTO, EXPLICIT }
+
+    static final String[] NAMES = {"a", "b", "c", "A", "B", "id", "", " ", "\t", "ab"};
+    static final String[] CELLS = {"1", "2", "", "x y", "#", "NULL"};
+
+    @Test
+    void headersMatchTheModel() {
+        Hegel.test(tc -> run(tc, this::headerCase), Zoo.settings("headersMatchTheModel").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
+    }
+
+    static boolean blank(String s) {
+        return s == null || s.trim().isEmpty();
+    }
+
+    private void headerCase(TestCase tc) throws IOException {
+        HeaderMode hm = Zoo.pick(tc, HeaderMode.values());
+        boolean skip = Zoo.chance(tc, 50);
+        DuplicateHeaderMode dup = Zoo.pick(tc, DuplicateHeaderMode.values());
+        boolean allowMissing = Zoo.chance(tc, 50);
+        boolean ignoreCase = Zoo.chance(tc, 40);
+        int width = Zoo.n(tc, 1, 4);
+        List<String> names = new ArrayList<>();
+        for (int i = 0; i < width; i++) {
+            names.add(Zoo.pick(tc, NAMES));
+        }
+        List<List<String>> data = new ArrayList<>();
+        int rows = Zoo.n(tc, 0, 4);
+        for (int i = 0; i < rows; i++) {
+            List<String> row = new ArrayList<>();
+            int m = Zoo.chance(tc, 60) ? width : Zoo.n(tc, 1, width + 2);
+            for (int j = 0; j < m; j++) {
+                row.add(Zoo.pick(tc, CELLS));
+            }
+            data.add(row);
+        }
+        long maxRows = Zoo.chance(tc, 30) ? Zoo.n(tc, 1, 5) : 0;
+        long startNumber = Zoo.chance(tc, 30) ? Zoo.n(tc, -2, 10) : 1;
+        Rfc.Dialect d = new Rfc.Dialect(',', '"');
+        boolean headerInText = hm == HeaderMode.AUTO || hm == HeaderMode.EXPLICIT && skip;
+        List<List<String>> lines = new ArrayList<>();
+        if (headerInText) {
+            lines.add(names);
+        }
+        lines.addAll(data);
+        String text = Rfc.write(lines, d, "\n");
+
+        CSVFormat.Builder b = CSVFormat.DEFAULT.builder().setDuplicateHeaderMode(dup).setAllowMissingColumnNames(allowMissing)
+                .setIgnoreHeaderCase(ignoreCase).setSkipHeaderRecord(skip).setMaxRows(maxRows);
+        if (hm == HeaderMode.AUTO) {
+            b.setHeader();
+        } else if (hm == HeaderMode.EXPLICIT) {
+            b.setHeader(names.toArray(new String[0]));
+        }
+        String setup = hm + (skip ? " skip" : "") + " " + dup + (allowMissing ? " allowMissing" : "") + (ignoreCase ? " ignoreCase" : "")
+                + " maxRows=" + maxRows + " start=" + startNumber + " header=" + names + " text=" + Zoo.show(text);
+
+        // the format validates an explicit header's duplicates (blank names count as one name "")
+        boolean formatRejects = false;
+        if (hm == HeaderMode.EXPLICIT && dup != DuplicateHeaderMode.ALLOW_ALL) {
+            List<String> seen = new ArrayList<>();
+            for (String name : names) {
+                String key = blank(name) ? "" : name;
+                if (seen.contains(key) && !(blank(name) && dup == DuplicateHeaderMode.ALLOW_EMPTY)) {
+                    formatRejects = true;
+                }
+                seen.add(key);
+            }
+        }
+        Object built = outcome(b::get);
+        if (formatRejects) {
+            Zoo.check(built instanceof IllegalArgumentException, () -> "CSVFormat with duplicate header " + names + " under " + dup + " gave " + kind(built));
+            return;
+        }
+        if (!(built instanceof CSVFormat format)) {
+            Zoo.fail("CSVFormat for " + setup + " gave " + kind(built));
+            return;
+        }
+        // the parser validates the header it uses: blanks need allowMissingColumnNames, duplicates follow the mode (case-insensitively if so set)
+        boolean parserRejects = false;
+        Map<String, Integer> index = ignoreCase ? new TreeMap<>(String.CASE_INSENSITIVE_ORDER) : new LinkedHashMap<>();
+        List<String> keys = new ArrayList<>(); // key spellings in insertion order (first spelling wins under ignoreCase)
+        if (hm != HeaderMode.NONE) {
+            boolean observedMissing = false;
+            for (int i = 0; i < names.size(); i++) {
+                String name = names.get(i);
+                boolean bl = blank(name);
+                if (bl && !allowMissing) {
+                    parserRejects = true;
+                    break;
+                }
+                boolean contains = bl ? observedMissing : index.containsKey(name);
+                if (contains && dup != DuplicateHeaderMode.ALLOW_ALL && !(bl && dup == DuplicateHeaderMode.ALLOW_EMPTY)) {
+                    parserRejects = true;
+                    break;
+                }
+                observedMissing |= bl;
+                if (!index.containsKey(name)) {
+                    keys.add(name);
+                }
+                index.put(name, i);
+            }
+        }
+        // commons-csv/6: a case-insensitive duplicate passes the format and fails the parser; the parser's view is the documented one
+        boolean caseOnlyDuplicate = hm == HeaderMode.EXPLICIT && ignoreCase && parserRejects && dup != DuplicateHeaderMode.ALLOW_ALL;
+        CSVParser parser;
+        try {
+            parser = CSVParser.builder().setCharSequence(text).setFormat(format).setRecordNumber(startNumber).get();
+        } catch (IllegalArgumentException e) {
+            Zoo.check(parserRejects, () -> "parser rejected the header for " + setup + ": " + e.getMessage());
+            return;
+        }
+        try (parser) {
+            if (parserRejects && !caseOnlyDuplicate) {
+                Zoo.fail("parser accepted a header the documentation rejects for " + setup + ": map " + parser.getHeaderMap());
+                return;
+            }
+            if (hm == HeaderMode.NONE) {
+                Zoo.check(parser.getHeaderMap() == null && parser.getHeaderNames().isEmpty(), () -> "header map " + parser.getHeaderMap() + " / names "
+                        + parser.getHeaderNames() + " without a header for " + setup);
+            } else {
+                Map<String, Integer> map = parser.getHeaderMap();
+                Zoo.check(map != null && map.keySet().equals(index.keySet()) && new ArrayList<>(map.keySet()).equals(keys)
+                        && map.values().equals(new ArrayList<>(index.values())) || map != null && map.equals(index),
+                        () -> "header map " + map + " for " + setup + ", expected " + index);
+                Zoo.check(parser.getHeaderNames().equals(names), () -> "header names " + parser.getHeaderNames() + " for " + setup + ", expected " + names);
+                Object unmodifiable = outcome(() -> {
+                    parser.getHeaderNames().add("z");
+                    return "added";
+                });
+                Zoo.check(unmodifiable instanceof UnsupportedOperationException, () -> "getHeaderNames().add gave " + kind(unmodifiable));
+            }
+            long expectedCount = maxRows > 0 ? Math.min(maxRows, data.size()) : data.size();
+            long number = startNumber; // the header record read from the text does not advance the record numbers
+            Iterator<CSVRecord> it = parser.iterator();
+            int i = 0;
+            for (; ; i++) {
+                if (Zoo.chance(tc, 50)) {
+                    boolean has = it.hasNext();
+                    Zoo.check(has == i < expectedCount, "hasNext " + has + " before record " + i + " of " + expectedCount + " for " + setup);
+                    if (!has) {
+                        break;
+                    }
+                }
+                CSVRecord r;
+                try {
+                    r = it.next();
+                } catch (NoSuchElementException e) {
+                    Zoo.check(i == expectedCount, "records ran out after " + i + " of " + expectedCount + " for " + setup);
+                    break;
+                }
+                if (i >= expectedCount) {
+                    Zoo.fail("record " + i + " " + r + " beyond the expected " + expectedCount + " for " + setup);
+                    break;
+                }
+                List<String> row = data.get(i);
+                final int idx = i;
+                Zoo.check(r.toList().equals(row) && r.size() == row.size() && Arrays.asList(r.values()).equals(row)
+                        && r.stream().toList().equals(row), () -> "record " + idx + " " + r + " for " + setup + ", expected " + row);
+                Zoo.check(r.getRecordNumber() == number + i, () -> "record " + idx + " number " + r.getRecordNumber() + " for " + setup + ", expected "
+                        + (number + idx));
+                Zoo.check(parser.getRecordNumber() == number + i, () -> "parser record number " + parser.getRecordNumber() + " after record " + idx
+                        + " for " + setup);
+                Zoo.check(r.getParser() == parser && !r.hasComment() && r.getComment() == null, () -> "record " + idx + " parser/comment for " + setup);
+                for (int j = -1; j <= row.size(); j++) {
+                    final int jj = j;
+                    boolean set = j >= 0 && j < row.size();
+                    Zoo.check(r.isSet(j) == set, () -> "isSet(" + jj + ") on " + r + " for " + setup);
+                    Object v = outcome(() -> r.get(jj));
+                    Zoo.check(set ? row.get(j).equals(v) : v instanceof ArrayIndexOutOfBoundsException, () -> "get(" + jj + ") on " + r + " = " + kind(v));
+                }
+                if (hm == HeaderMode.NONE) {
+                    Object v = outcome(() -> r.get("a"));
+                    Zoo.check(v instanceof IllegalStateException, () -> "get(name) without a header gave " + kind(v));
+                    Zoo.check(!r.isMapped("a") && !r.isSet("a") && r.isConsistent() && r.toMap().isEmpty(), () -> "name queries without a header on " + r);
+                } else {
+                    Map<String, String> expectedMap = new LinkedHashMap<>();
+                    for (String key : keys) {
+                        int at = index.get(key);
+                        if (at < row.size()) {
+                            expectedMap.put(key, row.get(at));
+                        }
+                    }
+                    Map<String, String> map = r.toMap();
+                    Zoo.check(map.equals(expectedMap), () -> "toMap " + map + " on " + r + " for " + setup + ", expected " + expectedMap);
+                    Map<String, String> put = r.putIn(new TreeMap<>());
+                    Zoo.check(put.equals(expectedMap), () -> "putIn " + put + " on " + r + " for " + setup + ", expected " + expectedMap);
+                    // commons-csv/5: the header size is the number of header names, not of distinct names
+                    boolean distinct = keys.size() == names.size();
+                    if (distinct) {
+                        Zoo.check(r.isConsistent() == (row.size() == names.size()), () -> "isConsistent " + r.isConsistent() + " on " + r + " for " + setup);
+                    }
+                    for (String probe : new String[] {"a", "A", "b", "id", "", "zz", null}) {
+                        String key = probe;
+                        Integer at = key == null ? null : index.get(key);
+                        boolean mapped = at != null;
+                        Zoo.check(r.isMapped(key) == mapped, () -> "isMapped(" + Zoo.show(key) + ") = " + r.isMapped(key) + " on " + r + " for " + setup);
+                        Zoo.check(r.isSet(key) == (mapped && at < row.size()), () -> "isSet(" + Zoo.show(key) + ") = " + r.isSet(key) + " on " + r + " for " + setup);
+                        Object v = outcome(() -> r.get(key));
+                        boolean ok = mapped && at < row.size() ? row.get(at).equals(v) : v instanceof IllegalArgumentException;
+                        Zoo.check(ok, () -> "get(" + Zoo.show(key) + ") on " + r + " for " + setup + " gave " + kind(v));
+                    }
+                }
+            }
+            Zoo.check(!it.hasNext(), "hasNext after the end for " + setup);
+            Object after = outcome(it::next);
+            Zoo.check(after instanceof NoSuchElementException, () -> "next() after the end gave " + kind(after));
+        }
+        // getRecords and stream give the same records, and a closed parser has none
+        try (CSVParser p2 = CSVParser.parse(text, format)) {
+            List<CSVRecord> all = p2.getRecords();
+            long expectedCount = maxRows > 0 ? Math.min(maxRows, data.size()) : data.size();
+            Zoo.check(all.size() == expectedCount, () -> "getRecords gave " + all.size() + " records for " + setup + ", expected " + expectedCount);
+            for (int i = 0; i < all.size(); i++) {
+                Zoo.check(all.get(i).toList().equals(data.get(i)), "getRecords record " + i + " " + all.get(i) + " for " + setup);
+            }
+            p2.close();
+            Zoo.check(p2.isClosed() && !p2.iterator().hasNext(), "closed parser still has records for " + setup);
+            Object v = outcome(() -> p2.iterator().next());
+            Zoo.check(v instanceof NoSuchElementException, () -> "next() on a closed parser gave " + kind(v));
+        }
+        try (CSVParser p3 = CSVParser.parse(text, format)) {
+            List<List<String>> streamed = p3.stream().map(CSVRecord::toList).toList();
+            long expectedCount = maxRows > 0 ? Math.min(maxRows, data.size()) : data.size();
+            Zoo.check(streamed.size() == expectedCount && streamed.equals(data.subList(0, (int) expectedCount)), () -> "stream gave " + streamed + " for " + setup);
+        }
+        // the printer honours maxRows for printRecords too, and writes the format's header unless skipped
+        if (hm == HeaderMode.EXPLICIT) {
+            StringWriter out = new StringWriter();
+            try (CSVPrinter printer = new CSVPrinter(out, format)) {
+                printer.printRecords(data);
+                long expectedPrinted = (skip ? 0 : 1) + (maxRows > 0 ? Math.min(maxRows, data.size()) : data.size());
+                Zoo.check(printer.getRecordCount() == expectedPrinted, () -> "printer record count " + printer.getRecordCount() + " for " + setup
+                        + ", expected " + expectedPrinted);
+            }
+            List<List<String>> printed = Rfc.commons(out.toString(), CSVFormat.DEFAULT.builder().setIgnoreEmptyLines(false).get());
+            List<List<String>> expectedLines = new ArrayList<>();
+            if (!skip) {
+                expectedLines.add(names);
+            }
+            for (int i = 0; i < data.size() && (maxRows <= 0 || i < maxRows); i++) {
+                expectedLines.add(data.get(i));
+            }
+            Zoo.check(printed.equals(expectedLines), () -> "printer wrote " + Zoo.show(out.toString()) + " for " + setup + ", expected " + expectedLines);
+        }
+    }
+
+    // ---------------------------------------------------------------- positions and comments
+
+    record Line(int kind, List<String> fields, String comment, String text, String terminator) {} // kind 0 record, 1 comment, 2 empty
+
+    @Test
+    void positionsAndCommentsMatchTheText() {
+        Hegel.test(tc -> run(tc, this::positionCase), Zoo.settings("positionsAndCommentsMatchTheText").suppressHealthCheck(HealthCheck.LARGE_INITIAL_TEST_CASE));
+    }
+
+    static int utf8Length(String s) {
+        return s.getBytes(StandardCharsets.UTF_8).length;
+    }
+
+    /** Line breaks in the text (CRLF counting once). */
+    static int breaks(String s) {
+        int n = 0;
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '\n') {
+                n++;
+            } else if (c == '\r') {
+                n++;
+                if (i + 1 < s.length() && s.charAt(i + 1) == '\n') {
+                    i++;
+                }
+            }
+        }
+        return n;
+    }
+
+    private void positionCase(TestCase tc) throws IOException {
+        Rfc.Dialect d = Rfc.dialect(tc);
