+/**
+ * Pins for the bugs in targets/java/commons-csv/bugs.toml. Each asserts the correct behaviour and therefore fails
+ * while the bug exists; the ids are the keys of [expected_failures] in target.toml.
+ */
+class CommonsCsvPinsTest {
+
+    static Object outcome(Supplier<?> f) {
+        try {
+            return f.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String kind(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : "value " + o;
+    }
+
+    static List<List<String>> parse(String text, CSVFormat format) {
+        try (CSVParser parser = CSVParser.parse(text, format)) {
+            List<List<String>> rows = new ArrayList<>();
+            for (CSVRecord r : parser) {
+                rows.add(r.toList());
+            }
+            return rows;
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    static String show(String s) {
+        return Zoo.show(s);
+    }
+
+    /** commons-csv/1: a null string that starts with the comment marker is printed bare, so the record reads back as a comment. */
+    @Test
+    void pin_nullStringStartingWithCommentMarker() {
+        CSVFormat f = CSVFormat.DEFAULT.builder().setCommentMarker('#').setNullString("#").setRecordSeparator("\n").get();
+        String text = f.format((Object) null, "x") + "\n";
+        List<List<String>> rows = parse(text, f);
+        Zoo.check(rows.equals(List.of(Arrays.asList((String) null, "x"))), "printed " + show(text) + " for [null, \"x\"], read back " + CsvGen.showRows(rows));
+    }
+
+    /** commons-csv/2: in escape mode a value ending in a prefix of a multi-character delimiter that contains one of the letters r n t b f is not escaped. */
+    @Test
+    void pin_escapedDelimiterPrefixWithEscapeLetters() {
+        for (String delimiter : new String[] {"aba", "nn"}) {
+            CSVFormat f = CSVFormat.DEFAULT.builder().setQuote(null).setEscape('\\').setDelimiter(delimiter).setRecordSeparator("\n").get();
+            String first = delimiter.substring(0, delimiter.length() - 1);
+            String text = f.format("x" + first, "y") + "\n";
+            List<List<String>> rows = parse(text, f);
+            Zoo.check(rows.equals(List.of(List.of("x" + first, "y"))), "delimiter " + show(delimiter) + ": printed " + show(text) + " for [\"x" + first
+                    + "\", \"y\"], read back " + CsvGen.showRows(rows));
+        }
+    }
+
+    /** commons-csv/3: isConsistent compares the record size with the number of distinct header names, not of header names. */
+    @Test
+    void pin_isConsistentWithDuplicateHeaderNames() {
+        CSVFormat f = CSVFormat.DEFAULT.builder().setHeader().setSkipHeaderRecord(true).setDuplicateHeaderMode(DuplicateHeaderMode.ALLOW_ALL).get();
+        try (CSVParser parser = CSVParser.parse("a,a,b\n1,2,3\n", f)) {
+            CSVRecord r = parser.getRecords().get(0);
+            Zoo.check(r.isConsistent(), "isConsistent() is false for " + r + " under the header [a, a, b] (names " + parser.getHeaderNames() + ")");
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    /** commons-csv/4: the first end of line reported ignores the line breaks that end comment lines. */
+    @Test
+    void pin_firstEndOfLineAfterComment() {
+        CSVFormat f = CSVFormat.DEFAULT.builder().setCommentMarker('#').get();
+        try (CSVParser parser = CSVParser.parse("# c\r\na,b\nc,d\n", f)) {
+            parser.getRecords();
+            String eol = parser.getFirstEndOfLine();
+            Zoo.check("\r\n".equals(eol), "getFirstEndOfLine() = " + show(eol) + " for a text whose first line, a comment, ends with CR LF");
+        } catch (IOException e) {
+            throw new UncheckedIOException(e);
+        }
+    }
+
+    /** commons-csv/5: a header with names differing only in case passes the format's duplicate check under ignoreHeaderCase, and the parser then rejects it. */
+    @Test
+    void pin_formatRejectsCaseInsensitiveDuplicateHeader() {
+        Object built = outcome(() -> CSVFormat.DEFAULT.builder().setHeader("a", "A").setIgnoreHeaderCase(true).setDuplicateHeaderMode(DuplicateHeaderMode.DISALLOW).get());
+        Object parsed = built instanceof CSVFormat f ? outcome(() -> parse("1,2\n", f)) : "not built";
+        Zoo.check(built instanceof IllegalArgumentException, "the format was built (" + kind(built) + ") while the parser says " + kind(parsed));
+    }
+
+    /** commons-csv/6: QuoteMode.ALL without a quote character prints the null string between double quotes. */
+    @Test
+    void pin_quotelessAllModeNullString() {
+        CSVFormat f = CSVFormat.DEFAULT.builder().setQuote(null).setEscape('\\').setNullString("NULL").setQuoteMode(org.apache.commons.csv.QuoteMode.ALL)
+                .setRecordSeparator("\n").get();
+        String text = f.format((Object) null, "a") + "\n";
+        List<List<String>> rows = parse(text, f);
+        Zoo.check(rows.equals(List.of(Arrays.asList((String) null, "a"))), "printed " + show(text) + " for [null, \"a\"] without a quote character, read back "
+                + CsvGen.showRows(rows));
+    }
+}
