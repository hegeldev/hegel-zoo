+    /** Another holder of (mostly) the same value: a different Number class, or the same string. */
+    static Object sameValueOtherClass(TestCase tc, Object h) {
+        if (h instanceof Integer i) {
+            return pick(tc, (long) i, (double) i, BigDecimal.valueOf(i), BigInteger.valueOf(i), new LazilyParsedNumber(Integer.toString(i)), (Number) (short) (int) i);
+        }
+        if (h instanceof Long l) {
+            return pick(tc, (double) l, BigDecimal.valueOf(l), BigInteger.valueOf(l), new LazilyParsedNumber(Long.toString(l)));
+        }
+        if (h instanceof Double d) {
+            return pick(tc, Double.isNaN(d) || Double.isInfinite(d) ? d : new BigDecimal(d), new LazilyParsedNumber(Double.toString(d)), (Number) d.floatValue(), (Number) (long) d.doubleValue());
+        }
+        if (h instanceof BigDecimal bd) {
+            return pick(tc, bd.doubleValue(), new LazilyParsedNumber(bd.toString()), bd.setScale(bd.scale() + 1));
+        }
+        if (h instanceof LazilyParsedNumber lp) {
+            return pick(tc, new BigDecimal(lp.toString()), lp.doubleValue(), new LazilyParsedNumber(lp.toString()));
+        }
+        if (h instanceof BigInteger bi) {
+            return pick(tc, new BigDecimal(bi), bi.doubleValue(), bi.bitLength() < 64 ? bi.longValue() : bi);
+        }
+        if (h instanceof Character c) {
+            return String.valueOf(c);
+        }
+        if (h instanceof String s && s.length() == 1) {
+            return s.charAt(0);
+        }
+        return h;
+    }
