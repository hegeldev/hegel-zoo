+    @Test
+    void recordsRoundTripThroughJson() {
+        Hegel.test(tc -> {
+            Cfg c = gson(tc, true);
+            Gson g = c.g();
+            Pojo p = pojo(tc, c);
+            String text;
+            try {
+                text = g.toJson(p);
+            } catch (IllegalArgumentException e) {
+                fail("toJson threw " + e + " for " + p);
+                return;
+            }
+            boolean hasSpecial = Double.isNaN(p.d()) || Double.isInfinite(p.d()) || (p.bd() != null && (p.bd().isNaN() || p.bd().isInfinite()));
+            if (!hasSpecial) {
+                try {
+                    Ref.parse(text);
+                } catch (Ref.Bad e) {
+                    fail("toJson(record) is not valid JSON " + show(text) + ": " + e.getMessage());
+                }
+            }
+            Pojo back;
+            try {
+                back = g.fromJson(text, Pojo.class);
+            } catch (RuntimeException e) {
+                fail("fromJson(toJson(p)) threw " + e + " for " + show(text));
+                return;
+            }
+            check(samePojo(p, back), () -> "record round trip: " + p + " -> " + show(text) + " -> " + back);
+
+            // through a tree (gson/3: a non-lenient toJsonTree refuses a BigDecimal/BigInteger
+            // beyond the double range, which toJson writes — the pin carries it)
+            boolean hugeExact = (p.big() != null && Double.isInfinite(p.big().doubleValue()))
+                    || (p.bigInt() != null && Double.isInfinite(p.bigInt().doubleValue()));
+            if (c.lenient() || !hugeExact) {
+                JsonElement tree = g.toJsonTree(p);
+                Pojo viaTree = g.fromJson(tree, Pojo.class);
+                check(samePojo(p, viaTree), () -> "fromJson(toJsonTree(p)) differs: " + viaTree + " vs " + p);
+                check(g.toJson(tree).equals(text), () -> "toJson(toJsonTree(p)) " + show(g.toJson(tree)) + " differs from toJson(p) " + show(text));
+            }
+
+            // typed collections at the top
+            String lt = g.toJson(List.of(p));
+            List<Pojo> lback = g.fromJson(lt, new TypeToken<List<Pojo>>() {});
+            check(lback.size() == 1 && samePojo(p, lback.get(0)), () -> "List<Pojo> round trip: " + show(lt));
+            Map<String, Pojo> mp = new LinkedHashMap<>();
+            mp.put(cleanString(tc), p);
+            String mt = g.toJson(mp);
+            Map<String, Pojo> mback = g.fromJson(mt, new TypeToken<Map<String, Pojo>>() {});
+            check(mback.size() == 1 && mback.keySet().equals(mp.keySet()) && samePojo(p, mback.values().iterator().next()),
+                    () -> "Map<String,Pojo> round trip: " + show(mt));
+
+            // arrays
+            int[] ints = new int[n(tc, 0, 4)];
+            for (int i = 0; i < ints.length; i++) {
+                ints[i] = anyInt(tc);
+            }
+            check(Arrays.equals(ints, g.fromJson(g.toJson(ints), int[].class)), () -> "int[] round trip " + Arrays.toString(ints));
+            String[] strs = new String[n(tc, 0, 3)];
+            for (int i = 0; i < strs.length; i++) {
+                strs[i] = str(tc);
+            }
+            check(Arrays.equals(strs, g.fromJson(g.toJson(strs), String[].class)), () -> "String[] round trip " + Arrays.toString(strs) + " via " + show(g.toJson(strs)));
+            double[][] dd = {{anyDouble(tc, c.special()), anyDouble(tc, c.special())}, {}};
+            check(Arrays.deepEquals(dd, g.fromJson(g.toJson(dd), double[][].class)), () -> "double[][] round trip " + Arrays.deepToString(dd) + " via " + show(g.toJson(dd)));
+        }, Zoo.settings("recordsRoundTripThroughJson"));
+    }
