+                            pm.valueDone();
+                        }
+                        case BOOLEAN -> {
+                            boolean bo = r.nextBoolean();
+                            check(e.kind().equals("bool") && e.arg().equals(bo), () -> "event " + i + ": boolean " + bo + ", expected " + e);
+                            pm.valueDone();
+                        }
+                        case NULL -> {
+                            r.nextNull();
+                            check(e.kind().equals("null"), () -> "event " + i + ": null, expected " + e);
