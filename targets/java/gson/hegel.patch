diff --git a/hegel/pom.xml b/hegel/pom.xml
new file mode 100644
index 0000000..7c3cc79
--- /dev/null
+++ b/hegel/pom.xml
@@ -0,0 +1,67 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel zoo: property-based tests for Gson against the library built from this checkout
+     (`mvn -DskipTests install` at the root first; see targets/java/gson in the zoo). -->
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>gson-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <gson.version>2.14.1-SNAPSHOT</gson.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>com.google.code.gson</groupId>
+      <artifactId>gson</artifactId>
+      <version>${gson.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
+          <trimStackTrace>false</trimStackTrace>
+          <!-- every test's `ZOO …` line is what the zoo judges; Maven's exit code is not -->
+          <testFailureIgnore>true</testFailureIgnore>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..09e4ec9
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,462 @@
+package zoo;
+
+import static dev.hegel.Generators.booleans;
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.oneOf;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import com.google.gson.Strictness;
+import com.google.gson.internal.LazilyParsedNumber;
+import dev.hegel.Generator;
+import dev.hegel.Tuple2;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Generators, as values: reference JSON values ({@link Ref}) whose numbers carry the Number class
+ * a Gson tree holds them in, the spelling of a text (whitespace and escape choices, as data a pure
+ * renderer cycles through), the edits that break a text, and a GsonBuilder's settings. A case
+ * draws one small record of these and renders it with pure functions.
+ */
+final class Gen {
+    private Gen() {}
+
+    // ------------------------------------------------------------------ combinators the binding lacks
+
+    /** A weighted alternative for {@link #weighted}. */
+    record Choice<T>(int weight, Generator<T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        int total = 0;
+        for (Choice<T> c : choices) {
+            total += c.weight();
+        }
+        return integers().min(0).max(total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : choices) {
+                acc += c.weight();
+                if (i < acc) {
+                    return c.gen();
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return integers().min(0).max(99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A string of lo..hi characters of the alphabet (the binding's text() has no alphabet of its own). */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        List<String> chars = alphabet.codePoints().mapToObj(Character::toString).toList();
+        return lists(sampledFrom(chars)).minSize(lo).maxSize(hi).map(l -> String.join("", l));
+    }
+
+    /** The generator's values as Objects (a {@code Generator<String>} is not a {@code Generator<Object>}). */
+    static Generator<Object> obj(Generator<?> g) {
+        return g.map(x -> x);
+    }
+
+    // ------------------------------------------------------------------ strings
+
+    static final String[] KEYS = {
+        "", "a", "b", "c", "key", "1", "0", "-1", "a b", "é", "null", "true", "__proto__", "constructor",
+        "with\"quote", "back\\slash", "new\nline", "tab\t", "日本", "<b>&'=", "😀", "A", "aa",
+    };
+
+    static final String STRING_ALPHABET =
+            "ab1 _/\"\\\n\t\r\b\f\u0001\u001f\u007fé日<>&='\u2028\u2029\u00a0\ufeff\u0000";
+
+    /**
+     * A string: a short word over the alphabet of the characters JSON cares about (weight 75), one
+     * of the usual keys (15), or a surrogate pair, a lone surrogate or a broken pair (10).
+     */
+    static final Generator<String> STRING = weighted(w(75, word(STRING_ALPHABET, 0, 8)), w(15, sampledFrom(KEYS)),
+            w(10, sampledFrom("😀", "a😀b", "\ud800", "\udc00", "x\ud83dy", "😀😀")));
+
+    /** A string without unpaired surrogates (a STRICT reader refuses those, documented). */
+    static final Generator<String> CLEAN_STRING = STRING.filter(s -> !Ref.loneSurrogate(s));
+
+    // ------------------------------------------------------------------ numbers
+
+    static final String[] NUMBERS = {
+        "0", "-0", "1", "-1", "7", "10", "42", "255", "256", "65535", "2147483647", "2147483648", "-2147483648",
+        "-2147483649", "4294967295", "9007199254740992", "9007199254740993", "9223372036854775807",
+        "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "18446744073709551616",
+        "123456789012345678901234567890", "0.0", "-0.0", "1.0", "1.5", "0.1", "0.2", "0.30000000000000004",
+        "2.5", "-2.5", "3.14159", "1e2", "1E2", "1e+2", "1e-2", "1.5e3", "1E-7", "1e22", "1e23", "1e308",
+        "1.7976931348623157e308", "1e309", "1e400", "1e-400", "4.9e-324", "2.2250738585072014E-308",
+        "123456789.123456789", "0.000001", "1e-6", "100000000000000000000", "1E+2", "0e0", "0E-5",
+        "9007199254740993.0", "1.00000000000000011102230246251565404236316680908203125",
+    };
+
+    static final String DIGITS = "0123456789";
+
+    /**
+     * A number lexeme: one of the boundary lexemes (weight 70), or one built from the grammar: a
+     * sign, an integer part (a lone zero, or up to 19 digits), a fraction and an exponent, each
+     * optional part absent first.
+     */
+    static final Generator<String> LEXEME = weighted(w(70, sampledFrom(NUMBERS)), w(30, tuples(
+            maybe(30, "", just("-")),
+            weighted(w(20, just("0")), w(80, tuples(word("123456789", 1, 1), word(DIGITS, 0, 18)).map(t -> t.value1() + t.value2()))),
+            maybe(40, "", word(DIGITS, 1, 12).map(f -> "." + f)),
+            maybe(30, "", tuples(sampledFrom("e", "E"), sampledFrom("", "+", "-"), word(DIGITS, 1, 3)).map(t -> t.value1() + t.value2() + t.value3())))
+            .map(t -> t.value1() + t.value2() + t.value3() + t.value4())));
+
+    /**
+     * The Number classes a lexeme can be held in: the LazilyParsedNumber of the lexeme (what
+     * parsing gives) first, then an int, a long and a BigInteger when the lexeme is an integer in
+     * their range, the exact BigDecimal, and the double whose shortest form the lexeme is. Every one
+     * prints as a valid JSON number of the same value.
+     */
+    static List<Number> holders(String text) {
+        BigDecimal v = new BigDecimal(text);
+        List<Number> out = new ArrayList<>();
+        out.add(new LazilyParsedNumber(text));
+        if (text.matches("-?(0|[1-9][0-9]*)")) {
+            BigInteger bi = v.toBigIntegerExact();
+            if (bi.bitLength() < 32) {
+                out.add(bi.intValue());
+            }
+            if (bi.bitLength() < 64) {
+                out.add(bi.longValue());
+            }
+            out.add(bi);
+        }
+        out.add(v);
+        double d = Double.parseDouble(text);
+        if (!Double.isInfinite(d) && new BigDecimal(d).compareTo(v) == 0 && new BigDecimal(Double.toString(d)).compareTo(v) == 0
+                && !text.equals("-0")) {
+            out.add(d);
+        }
+        return out;
+    }
+
+    /** A number: a lexeme held in one of its classes, the LazilyParsedNumber of the lexeme first. */
+    static final Generator<Ref.Num> NUMBER = LEXEME.flatMap(text -> sampledFrom(holders(text)).map(h -> Ref.Num.of(text, h)));
+
+    /**
+     * Re-holds the numbers of the values passed through it: the k-th number takes the class its
+     * choice names among {@link #holders} (modulo how many it has); no choices means the
+     * LazilyParsedNumber of the lexeme. Drawn as a list of small integers, so a probe can hold a
+     * value in another class than the element it is compared with.
+     */
+    static final class Reholder {
+        private final List<Integer> choices;
+        private int k;
+
+        Reholder(List<Integer> choices) {
+            this.choices = choices;
+        }
+
+        @SuppressWarnings("unchecked")
+        Object apply(Object v) {
+            if (v instanceof Ref.Num num) {
+                List<Number> hs = holders(num.text());
+                int c = choices.isEmpty() ? 0 : choices.get(k++ % choices.size());
+                return Ref.Num.of(num.text(), hs.get(c % hs.size()));
+            }
+            if (v instanceof List<?> l) {
+                List<Object> out = new ArrayList<>();
+                for (Object x : l) {
+                    out.add(apply(x));
+                }
+                return out;
+            }
+            if (v instanceof Map<?, ?> m) {
+                Map<String, Object> out = new LinkedHashMap<>();
+                for (Map.Entry<String, Object> en : ((Map<String, Object>) m).entrySet()) {
+                    out.put(en.getKey(), apply(en.getValue()));
+                }
+                return out;
+            }
+            return v;
+        }
+    }
+
+    // ------------------------------------------------------------------ values
+
+    static final Generator<Object> NULL = just(Ref.NULL);
+    static final Generator<Object> BOOLEAN = obj(booleans());
+
+    /**
+     * A JSON value: at the leaves null, a boolean, a number or (mostly) a string; above, also an
+     * array or an object of up to five smaller values.
+     */
+    static Generator<Object> value(int depth) {
+        if (depth <= 0) {
+            return weighted(w(8, NULL), w(7, BOOLEAN), w(20, obj(NUMBER)), w(65, obj(STRING)));
+        }
+        Generator<Object> inner = value(depth - 1);
+        return weighted(w(8, NULL), w(7, BOOLEAN), w(20, obj(NUMBER)), w(20, obj(STRING)),
+                w(20, obj(lists(inner).maxSize(5))), w(25, obj(lists(tuples(STRING, inner)).maxSize(5).map(Gen::object))));
+    }
+
+    /** An object from its members in order; a repeated name keeps its first position and takes the last value (as the reference parser reads it). */
+    static Map<String, Object> object(List<Tuple2<String, Object>> members) {
+        Map<String, Object> out = new LinkedHashMap<>();
+        for (Tuple2<String, Object> m : members) {
+            out.put(m.value1(), m.value2());
+        }
+        return out;
+    }
+
+    static final Generator<Object> SCALAR = value(0);
+    static final Generator<Object> SHALLOW = value(1);
+    static final Generator<Object> VALUE = value(4);
+
+    // ------------------------------------------------------------------ texts
+
+    /**
+     * How one character of a string is spelt: with a backslash-u escape rather than the short one,
+     * in upper-case hex, and escaped although it need not be.
+     */
+    record Spell(boolean unicode, boolean upper, boolean optional) {
+        static final Spell PLAIN = new Spell(false, false, false);
+    }
+
+    static final Generator<Spell> SPELL = tuples(chance(50), chance(50), chance(10)).map(t -> new Spell(t.value1(), t.value2(), t.value3()));
+
+    /** The whitespace at a gap between tokens: none (weight 70) or a run. */
+    static final Generator<String> GAP = maybe(30, "", sampledFrom(" ", "  ", "\t", "\n", "\r\n", " \n\t "));
+
+    /**
+     * How a text spells a value: the gaps and the spellings, each list cycled through in reading
+     * order; empty lists give the compact, plainly escaped text.
+     */
+    record Layout(List<String> gaps, List<Spell> spells) {
+        static final Layout TIGHT = new Layout(List.of(), List.of());
+    }
+
+    /** The tight layout (weight 40) or a loose one. */
+    static final Generator<Layout> LAYOUT = maybe(60, Layout.TIGHT,
+            tuples(lists(GAP).minSize(1).maxSize(12), lists(SPELL).minSize(1).maxSize(12)).map(t -> new Layout(t.value1(), t.value2())));
+
+    /** Valid text for {@code v}, spelt as the layout says. */
+    static String text(Object v, Layout layout) {
+        Renderer r = new Renderer(layout);
+        r.value(v);
+        return r.sb.toString();
+    }
+
+    private static final class Renderer {
+        final Layout layout;
+        final StringBuilder sb = new StringBuilder();
+        int gaps;
+        int spells;
+
+        Renderer(Layout layout) {
+            this.layout = layout;
+        }
+
+        void gap() {
+            if (!layout.gaps().isEmpty()) {
+                sb.append(layout.gaps().get(gaps++ % layout.gaps().size()));
+            }
+        }
+
+        Spell spell() {
+            return layout.spells().isEmpty() ? Spell.PLAIN : layout.spells().get(spells++ % layout.spells().size());
+        }
+
+        @SuppressWarnings("unchecked")
+        void value(Object v) {
+            gap();
+            if (v == Ref.NULL) {
+                sb.append("null");
+            } else if (v instanceof Boolean || v instanceof Ref.Num) {
+                sb.append(v);
+            } else if (v instanceof String s) {
+                quote(s);
+            } else if (v instanceof List<?> l) {
+                sb.append('[');
+                boolean first = true;
+                for (Object e : l) {
+                    if (!first) {
+                        gap();
+                        sb.append(',');
+                    }
+                    first = false;
+                    value(e);
+                }
+                gap();
+                sb.append(']');
+            } else {
+                sb.append('{');
+                boolean first = true;
+                for (Map.Entry<String, Object> e : ((Map<String, Object>) v).entrySet()) {
+                    if (!first) {
+                        gap();
+                        sb.append(',');
+                    }
+                    first = false;
+                    gap();
+                    quote(e.getKey());
+                    gap();
+                    sb.append(':');
+                    value(e.getValue());
+                }
+                gap();
+                sb.append('}');
+            }
+            gap();
+        }
+
+        /** A valid quoting: the characters that must be escaped are, the others as their spelling says. */
+        void quote(String s) {
+            sb.append('"');
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                boolean must = c == '"' || c == '\\' || c < 0x20;
+                Spell sp = spell();
+                if (must || sp.optional()) {
+                    switch (c) {
+                        case '"' -> sb.append(sp.unicode() ? "\\u0022" : "\\\"");
+                        case '\\' -> sb.append(sp.unicode() ? "\\u005c" : "\\\\");
+                        case '/' -> sb.append(sp.unicode() ? "\\u002f" : "\\/");
+                        case '\n' -> sb.append(sp.unicode() ? "\\u000a" : "\\n");
+                        case '\t' -> sb.append(sp.unicode() ? "\\u0009" : "\\t");
+                        case '\r' -> sb.append("\\r");
+                        case '\b' -> sb.append("\\b");
+                        case '\f' -> sb.append("\\f");
+                        default -> sb.append(String.format(sp.upper() ? "\\u%04X" : "\\u%04x", (int) c));
+                    }
+                } else {
+                    sb.append(c);
+                }
+            }
+            sb.append('"');
+        }
+    }
+
+    // ------------------------------------------------------------------ mutations
+
+    static final String[] JUNK = {
+        ",", "]", "}", "{", "[", ":", "\"", "'", "//c\n", "/*c*/", "#x\n", "NaN", "Infinity", "-Infinity", "01", "+1",
+        ".5", "1.", "1e", "1e+", "0x1F", "TRUE", "True", "nul", "None", "undefined", ";", "=", "=>", "\\x41", "\\u12",
+        "\\U0041", "\\'", "\\a", "\\0", "\u0001", "\u0000", "\u007f", "\f", "\u00a0", "\u2028", "\ufeff", "-", "--1",
+        "1 2", "a", "[,]", "{,}", "[1,]", "{\"a\":1,}", "{\"a\"}", "{\"a\":}", "{1:2}", "{a:1}", "[1 2]", "\"\n\"",
+        "\"\t\"", "\"\\", "true false", "é", "1_000", "1,000",
+    };
+
+    /** One edit of a text that (nearly always) breaks it; its position is taken modulo the text's length. */
+    sealed interface Mutation permits Insert, Delete, Truncate, Replace {
+        String apply(String text);
+    }
+
+    /** Junk inserted at the position (modulo length + 1: the end included). */
+    record Insert(int at, String junk) implements Mutation {
+        @Override
+        public String apply(String text) {
+            int i = at % (text.length() + 1);
+            return text.substring(0, i) + junk + text.substring(i);
+        }
+    }
+
+    /** The character at the position removed. */
+    record Delete(int at) implements Mutation {
+        @Override
+        public String apply(String text) {
+            if (text.isEmpty()) {
+                return text;
+            }
+            int i = at % text.length();
+            return text.substring(0, i) + text.substring(i + 1);
+        }
+    }
+
+    /** The text cut short before the position. */
+    record Truncate(int at) implements Mutation {
+        @Override
+        public String apply(String text) {
+            return text.isEmpty() ? text : text.substring(0, at % text.length());
+        }
+    }
+
+    /** The character at the position replaced. */
+    record Replace(int at, String with) implements Mutation {
+        @Override
+        public String apply(String text) {
+            if (text.isEmpty()) {
+                return text;
+            }
+            int i = at % text.length();
+            return text.substring(0, i) + with + text.substring(i + 1);
+        }
+    }
+
+    static final Generator<Integer> POSITION = ints(0, 999);
+
+    /** An insertion of junk (weight 55), a deletion (20), a truncation (15) or a replacement (10). */
+    static final Generator<Mutation> MUTATION = weighted(
+            w(55, tuples(POSITION, sampledFrom(JUNK)).<Mutation>map(t -> new Insert(t.value1(), t.value2()))),
+            w(20, POSITION.<Mutation>map(Delete::new)),
+            w(15, POSITION.<Mutation>map(Truncate::new)),
+            w(10, tuples(POSITION, sampledFrom("a", "1", "\"", "\\", ",", " ", "\u0000", "\u00a0")).<Mutation>map(t -> new Replace(t.value1(), t.value2()))));
+
+    // ------------------------------------------------------------------ a Gson's settings
+
+    /** How a Gson lays its text out: the default compact form, setPrettyPrinting, a FormattingStyle of its own, or compact with a space after separators. */
+    sealed interface Style permits Compact, Pretty, Custom, Spaced {}
+
+    record Compact() implements Style {}
+
+    record Pretty() implements Style {}
+
+    record Custom(String indent, String newline, boolean space) implements Style {}
+
+    record Spaced(boolean space) implements Style {}
+
+    static final Generator<Style> COMPACT = just(new Compact());
+    static final Generator<Style> PRETTY = just(new Pretty());
+    static final Generator<Style> CUSTOM = tuples(sampledFrom("", " ", "\t", "    ", " \t"), sampledFrom("\n", "\r\n", "\r", ""), chance(50))
+            .map(t -> new Custom(t.value1(), t.value2(), t.value3()));
+    static final Generator<Style> SPACED = chance(50).map(Spaced::new);
+    static final Generator<Style> STYLE = oneOf(COMPACT, PRETTY, CUSTOM, SPACED);
+
+    /**
+     * A GsonBuilder's settings: serializeNulls, disableHtmlEscaping, an explicit strictness (absent =
+     * Gson's lenient legacy default), serializeSpecialFloatingPointValues (honoured only where the
+     * Gson is lenient and the test allows it) and the layout.
+     */
+    record Setup(boolean nulls, boolean noHtml, Strictness strictness, boolean special, Style style) {
+        /** No explicit strictness, or LENIENT: Gson reads and writes leniently (documented legacy behaviour). */
+        boolean lenient() {
+            return strictness == null || strictness == Strictness.LENIENT;
+        }
+
+        /** Whether NaN and the infinities are written: only when the test allows them and the Gson is lenient. */
+        boolean specialFloats(boolean allowed) {
+            return allowed && lenient() && special;
+        }
+    }
+
+    static final Generator<Setup> SETUP = tuples(chance(50), chance(40),
+            maybe(40, (Strictness) null, sampledFrom(Strictness.STRICT, Strictness.LEGACY_STRICT, Strictness.LENIENT)), chance(30), STYLE)
+            .map(t -> new Setup(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+}
diff --git a/hegel/src/test/java/zoo/GsonTest.java b/hegel/src/test/java/zoo/GsonTest.java
