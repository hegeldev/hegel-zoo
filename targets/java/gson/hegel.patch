+    // ------------------------------------------------------------------ 6. primitives
+
+    /** The documented number classes JsonPrimitive treats as integral. */
+    static boolean integral(Number x) {
+        return x instanceof BigInteger || x instanceof Long || x instanceof Integer || x instanceof Short || x instanceof Byte;
+    }
+
+    /** A random holder for a JsonPrimitive: Boolean, String, Character or one of the Number classes. */
+    static Object holder(TestCase tc) {
+        int r = n(tc, 0, 9);
+        return switch (r) {
+            case 0 -> chance(tc, 50);
+            case 1 -> Ref.string(tc);
+            case 2 -> pick(tc, "12", "1.9", "1e2", "-0", "true", "TrUe", "", " 1", "0x10", "9223372036854775808", "1.0");
+            case 3 -> pick(tc, 'a', '1', '\n', 'é');
+            case 4 -> anyInt(tc);
+            case 5 -> anyLong(tc);
+            case 6 -> anyDouble(tc, true);
+            case 7 -> new BigDecimal(Ref.number(tc));
+            case 8 -> new LazilyParsedNumber(Ref.number(tc));
+            default -> pick(tc, BigInteger.ZERO, BigInteger.ONE.negate(), BigInteger.TWO.pow(63), BigInteger.TWO.pow(100));
+        };
+    }
+
+    static JsonPrimitive prim(Object h) {
+        if (h instanceof Boolean b) {
+            return new JsonPrimitive(b);
+        }
+        if (h instanceof String s) {
+            return new JsonPrimitive(s);
+        }
+        if (h instanceof Character c) {
+            return new JsonPrimitive(c);
+        }
+        return new JsonPrimitive((Number) h);
+    }
+
+    /** JsonPrimitive.equals as documented. */
+    static boolean docEquals(Object a, Object b) {
+        if (a instanceof Character c) {
+            a = String.valueOf(c);
+        }
+        if (b instanceof Character c) {
+            b = String.valueOf(c);
+        }
+        if (a instanceof Number x && b instanceof Number y) {
+            if (integral(x) && integral(y)) {
+                if (x instanceof BigInteger || y instanceof BigInteger) {
+                    return big(x).equals(big(y));
+                }
+                return x.longValue() == y.longValue();
+            }
+            if (x instanceof BigDecimal p && y instanceof BigDecimal q) {
+                return p.compareTo(q) == 0;
+            }
+            double p = x.doubleValue();
+            double q = y.doubleValue();
+            return p == q || (Double.isNaN(p) && Double.isNaN(q));
+        }
+        return a.equals(b);
+    }
+
+    static BigInteger big(Number x) {
+        return x instanceof BigInteger b ? b : BigInteger.valueOf(x.longValue());
+    }
+
+    @Test
+    void primitivesFollowTheDocumentedEqualityAndCoercions() {
+        Hegel.test(tc -> {
+            Object h = holder(tc);
+            Object h2 = chance(tc, 50) ? holder(tc) : sameValueOtherClass(tc, h);
+            JsonPrimitive a = prim(h);
+            JsonPrimitive b = prim(h2);
+            boolean eq = docEquals(h, h2);
+            check(a.equals(b) == eq, () -> "equals(" + show(h) + ", " + show(h2) + ") = " + a.equals(b) + " expected " + eq);
+            check(b.equals(a) == eq, () -> "equals not symmetric for " + show(h) + ", " + show(h2));
+            if (eq) {
+                check(a.hashCode() == b.hashCode(), () -> "equal primitives hash differently: " + show(h) + " (" + a.hashCode() + ") vs " + show(h2) + " (" + b.hashCode() + ")");
+            }
+            check(a.equals(a) && a.hashCode() == prim(h).hashCode(), () -> "reflexivity/hash stability for " + show(h));
+
+            // type predicates and getters
+            boolean isNum = h instanceof Number;
+            boolean isStr = h instanceof String || h instanceof Character;
+            check(a.isNumber() == isNum && a.isString() == isStr && a.isBoolean() == (h instanceof Boolean), () -> "type predicates for " + show(h));
+            String asString = h instanceof Boolean ? h.toString() : h instanceof Character c ? String.valueOf(c) : h instanceof Number x ? x.toString() : (String) h;
+            check(a.getAsString().equals(asString), () -> "getAsString " + show(a.getAsString()) + " expected " + show(asString) + " for " + show(h));
+            boolean asBool = h instanceof Boolean bo ? bo : Boolean.parseBoolean(asString);
+            check(a.getAsBoolean() == asBool, () -> "getAsBoolean " + a.getAsBoolean() + " expected " + asBool + " for " + show(h));
+            if (h instanceof Boolean) {
+                try {
+                    a.getAsNumber();
+                    fail("getAsNumber on a boolean did not throw");
+                } catch (UnsupportedOperationException expected) {
+                    // documented
+                }
+            } else {
+                Number num = a.getAsNumber();
+                check(num.toString().equals(asString), () -> "getAsNumber().toString() " + num + " expected " + asString + " for " + show(h));
+            }
+            // getAsInt: numbers truncate, strings parse as an int or throw
+            Integer wantInt = null;
+            String intError = null;
+            if (isNum) {
+                wantInt = ((Number) h).intValue();
+            } else {
+                try {
+                    wantInt = Integer.parseInt(asString);
+                } catch (NumberFormatException e) {
+                    intError = "NumberFormatException";
+                }
+            }
+            try {
+                int got = a.getAsInt();
+                final Integer w = wantInt;
+                check(w != null && got == w, () -> "getAsInt " + got + " expected " + (w == null ? "NumberFormatException" : w) + " for " + show(h));
+            } catch (NumberFormatException e) {
+                check(intError != null, () -> "getAsInt threw " + e + " for " + show(h));
+            }
+            // getAsDouble likewise
+            Double wantD = null;
+            if (isNum) {
+                wantD = ((Number) h).doubleValue();
+            } else {
+                try {
+                    wantD = Double.parseDouble(asString);
+                } catch (NumberFormatException e) {
+                    // expected to throw
+                }
+            }
+            try {
+                double got = a.getAsDouble();
+                final Double w = wantD;
+                check(w != null && Double.compare(got, w) == 0, () -> "getAsDouble " + got + " expected " + w + " for " + show(h));
+            } catch (NumberFormatException e) {
+                check(wantD == null, () -> "getAsDouble threw " + e + " for " + show(h));
+            }
+            // a Character is stored as a one-character string
+            if (h instanceof Character c) {
+                check(a.equals(new JsonPrimitive(String.valueOf(c))), "Character primitive equals its String");
+            }
+            // deepCopy is the same instance; JsonNull instances are all equal
+            check(a.deepCopy() == a, "deepCopy of a primitive is itself");
+            @SuppressWarnings("deprecation")
+            JsonNull fresh = new JsonNull();
+            check(fresh.equals(JsonNull.INSTANCE) && fresh.hashCode() == JsonNull.INSTANCE.hashCode(), "JsonNull equality");
+            // toString of a lone primitive: not html-escaped, NaN allowed
+            String ts = a.toString();
+            String wantTs = h instanceof Boolean || h instanceof Number ? asString : Ref.write(asString, Ref.PLAIN);
+            check(ts.equals(wantTs), () -> "primitive toString " + show(ts) + " expected " + show(wantTs));
+        }, Zoo.settings("primitivesFollowTheDocumentedEqualityAndCoercions"));
+    }
