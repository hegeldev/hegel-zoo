+    /** A string field: absent one time in five, else without unpaired surrogates. */
+    static final Generator<String> STR = maybe(80, (String) null, Gen.CLEAN_STRING);
+
+    static final Generator<Colour> COLOUR = maybe(85, (Colour) null, sampledFrom(Colour.values()));
+
+    static final Generator<Character> CHAR = sampledFrom('a', ' ', '"', '\\', '\n', '\u0000', 'é', '\u2028', '<', '=');
+
+    /** A map from its entries in order (a repeated key keeps its first position and takes the last value). */
+    static <K, V> Map<K, V> mapOf(List<Tuple2<K, V>> entries) {
+        Map<K, V> out = new LinkedHashMap<>();
+        for (Tuple2<K, V> e : entries) {
+            out.put(e.value1(), e.value2());
+        }
+        return out;
+    }
+
+    /** Up to three entries; a null value (one in seven) only when the Gson serializes nulls, else the member would be dropped. */
+    static Generator<Map<String, Integer>> stringIntMap(boolean nulls) {
+        Generator<Integer> value = nulls ? maybe(15, (Integer) null, ints(-1000, 1000)) : ints(-1000, 1000);
+        return lists(tuples(Gen.CLEAN_STRING, value)).maxSize(3).map(GsonTest::mapOf);
+    }
+
+    static Generator<Leaf> leaf(boolean nulls) {
+        return tuples(ANY_INT, maybe(80, (Integer) null, ANY_INT), ANY_LONG, STR, COLOUR, maybe(85, (List<String>) null, lists(STR).maxSize(3)),
+                maybe(85, (Map<String, Integer>) null, stringIntMap(nulls)), booleans())
+                .map(t -> new Leaf(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+    }
