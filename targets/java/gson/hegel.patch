+    // ------------------------------------------------------------------ 7. typed number reading
+
+    /** A number lexeme, and whether it is read from a JSON string. */
+    record NumberCase(String lexeme, boolean quoted) {}
+
+    static final Generator<NumberCase> NUMBER_CASE = tuples(Gen.LEXEME, chance(30)).map(t -> new NumberCase(t.value1(), t.value2()));
+
+    @Test
+    void numbersReadIntoTypedFieldsExactly() {
+        Hegel.test(tc -> {
+            NumberCase c = tc.draw(NUMBER_CASE, "case");
+            String lexeme = c.lexeme();
+            String text = c.quoted() ? "\"" + lexeme + "\"" : lexeme;
+            BigDecimal exact = new BigDecimal(lexeme);
+            Gson g = new Gson();
+            // int / long: documented "if the numeric value cannot be exactly represented, throws"
+            boolean intOk = isIntegral(exact) && exact.compareTo(BigDecimal.valueOf(Integer.MIN_VALUE)) >= 0 && exact.compareTo(BigDecimal.valueOf(Integer.MAX_VALUE)) <= 0;
+            double dd = Double.parseDouble(lexeme);
+            // Gson reads a lexeme Long.parseLong accepts exactly; every other lexeme goes through
+            // Double.parseDouble and is accepted when that double is integral - gson/1: this
+            // saturates out-of-range values, accepts non-integral ones and loses precision beyond
+            // 2^53. The property skips that shape; the pins carry it.
+            boolean plain;
+            try {
+                Long.parseLong(lexeme);
+                plain = true;
+            } catch (NumberFormatException e) {
+                plain = false;
+            }
+            boolean intBug = !plain && (int) dd == dd && !(intOk && exact.compareTo(BigDecimal.valueOf((int) dd)) == 0);
+            boolean longOk = isIntegral(exact) && exact.compareTo(BigDecimal.valueOf(Long.MIN_VALUE)) >= 0 && exact.compareTo(BigDecimal.valueOf(Long.MAX_VALUE)) <= 0;
+            boolean longBug = !plain && (long) dd == dd && !(longOk && exact.compareTo(BigDecimal.valueOf((long) dd)) == 0);
+            if (!intBug) try {
+                int got = g.fromJson(text, int.class);
+                check(intOk && got == exact.intValueExact(), () -> "fromJson(" + show(text) + ", int) = " + got + (intOk ? " expected " + exact.intValueExact() : " but the value is not an exact int"));
+            } catch (JsonSyntaxException e) {
+                check(!intOk, () -> "fromJson(" + show(text) + ", int) rejected an exact int: " + e.getMessage());
+            }
+            if (!longBug) try {
+                long got = g.fromJson(text, long.class);
+                check(longOk && got == exact.longValueExact(), () -> "fromJson(" + show(text) + ", long) = " + got + (longOk ? " expected " + exact.longValueExact() : " but the value is not an exact long"));
+            } catch (JsonSyntaxException e) {
+                check(!longOk, () -> "fromJson(" + show(text) + ", long) rejected an exact long: " + e.getMessage());
+            }
+            // double: Double.parseDouble of the lexeme (documented)
+            double d = g.fromJson(text, double.class);
+            check(Double.compare(d, Double.parseDouble(lexeme)) == 0, () -> "fromJson(" + show(text) + ", double) = " + d);
+            // BigDecimal: exact; BigInteger: integer lexemes only
+            BigDecimal bd = g.fromJson(text, BigDecimal.class);
+            check(bd.compareTo(exact) == 0, () -> "fromJson(" + show(text) + ", BigDecimal) = " + bd);
+            boolean biOk = lexeme.matches("-?[0-9]+");
+            try {
+                BigInteger bi = g.fromJson(text, BigInteger.class);
+                check(biOk && bi.equals(exact.toBigIntegerExact()), () -> "fromJson(" + show(text) + ", BigInteger) = " + bi);
+            } catch (JsonSyntaxException e) {
+                check(!biOk, () -> "fromJson(" + show(text) + ", BigInteger) rejected " + lexeme);
+            }
+            // String keeps the literal; Number is a LazilyParsedNumber of the literal
+            String s = g.fromJson(text, String.class);
+            check(s.equals(lexeme), () -> "fromJson(" + show(text) + ", String) = " + show(s));
+            Number num = g.fromJson(text, Number.class);
+            check(num instanceof LazilyParsedNumber && num.toString().equals(lexeme), () -> "fromJson(" + show(text) + ", Number) = " + num + " (" + num.getClass().getSimpleName() + ")");
+            // and writing the typed values back gives the same value
+            check(new BigDecimal(g.toJson(bd)).compareTo(exact) == 0, () -> "toJson(BigDecimal " + bd + ") = " + g.toJson(bd));
+            check(g.toJson(num).equals(lexeme), () -> "toJson(LazilyParsedNumber) = " + g.toJson(num) + " expected " + lexeme);
+        }, Zoo.settings("numbersReadIntoTypedFieldsExactly"));
+    }
+
+    static boolean isIntegral(BigDecimal v) {
+        return v.signum() == 0 || v.stripTrailingZeros().scale() <= 0;
+    }
+
+    // ------------------------------------------------------------------ 8. writer/reader streams
+
+    /** One writer event; the reader must see it back. */
+    record Ev(String kind, Object arg) {}
+
+    /** The writer events of a value, numbers as the Number their {@link Ref.Num#holder} names. */
+    static List<Ev> events(Object v, List<Ev> out) {
+        if (v == Ref.NULL) {
+            out.add(new Ev("null", null));
+        } else if (v instanceof Boolean b) {
+            out.add(new Ev("bool", b));
+        } else if (v instanceof String s) {
+            out.add(new Ev("string", s));
+        } else if (v instanceof Ref.Num num) {
+            out.add(new Ev("number", num.holder()));
+        } else if (v instanceof List<?> l) {
+            out.add(new Ev("[", null));
+            for (Object x : l) {
+                events(x, out);
+            }
+            out.add(new Ev("]", null));
+        } else {
+            out.add(new Ev("{", null));
+            for (Map.Entry<?, ?> en : ((Map<?, ?>) v).entrySet()) {
+                out.add(new Ev("name", en.getKey()));
+                events(en.getValue(), out);
+            }
+            out.add(new Ev("}", null));
+        }
+        return out;
+    }
+
+    /** Events after dropping name+null pairs (a writer without serializeNulls). */
+    static List<Ev> withoutNullMembers(List<Ev> evs) {
+        List<Ev> out = new ArrayList<>();
+        for (int i = 0; i < evs.size(); i++) {
+            Ev e = evs.get(i);
+            if (e.kind().equals("name") && i + 1 < evs.size() && evs.get(i + 1).kind().equals("null")) {
+                i++;
+                continue;
+            }
+            out.add(e);
+        }
+        return out;
+    }
+
+    /** Compact text of an event list, per the writer's documented escaping. */
+    static String compact(List<Ev> evs, boolean html) {
+        StringBuilder sb = new StringBuilder();
+        Ref.Escaping esc = html ? Ref.HTML : Ref.PLAIN;
+        List<Boolean> firstInScope = new ArrayList<>();
+        boolean afterName = false;
+        for (Ev e : evs) {
+            boolean value = !e.kind().equals("]") && !e.kind().equals("}");
+            if (value && !afterName && !firstInScope.isEmpty()) {
+                if (!firstInScope.get(firstInScope.size() - 1)) {
+                    sb.append(',');
+                }
+                firstInScope.set(firstInScope.size() - 1, false);
+            }
+            afterName = false;
+            switch (e.kind()) {
+                case "null" -> sb.append("null");
+                case "bool" -> sb.append(e.arg());
+                case "string" -> Ref.quote((String) e.arg(), esc, sb);
+                case "number" -> sb.append(e.arg().toString());
+                case "[" -> {
+                    sb.append('[');
+                    firstInScope.add(true);
+                }
+                case "{" -> {
+                    sb.append('{');
+                    firstInScope.add(true);
+                }
+                case "]" -> {
+                    sb.append(']');
+                    firstInScope.remove(firstInScope.size() - 1);
+                }
+                case "}" -> {
+                    sb.append('}');
+                    firstInScope.remove(firstInScope.size() - 1);
+                }
+                case "name" -> {
+                    Ref.quote((String) e.arg(), esc, sb);
+                    sb.append(':');
+                    afterName = true;
+                }
+                default -> throw new IllegalStateException(e.kind());
+            }
+        }
+        return sb.toString();
+    }
+
+    /** The documented JsonReader.getPath()/getPreviousPath() model. */
+    static final class PathModel {
+        private final List<Object> frames = new ArrayList<>(); // Integer (array index) or String[] {name}
+
+        void beginArray() {
+            frames.add(0);
+        }
+
+        void beginObject() {
+            frames.add(new String[] {null});
+        }
+
+        void name(String n) {
+            ((String[]) frames.get(frames.size() - 1))[0] = n;
+        }
+
+        void valueDone() {
+            if (!frames.isEmpty() && frames.get(frames.size() - 1) instanceof Integer i) {
+                frames.set(frames.size() - 1, i + 1);
+            }
+        }
+
+        void end() {
+            frames.remove(frames.size() - 1);
+            valueDone();
+        }
+
+        String path(boolean previous) {
+            StringBuilder sb = new StringBuilder("$");
+            for (int k = 0; k < frames.size(); k++) {
+                Object f = frames.get(k);
+                if (f instanceof Integer i) {
+                    int idx = previous && k == frames.size() - 1 && i > 0 ? i - 1 : i;
+                    sb.append('[').append(idx).append(']');
+                } else {
+                    String name = ((String[]) f)[0];
+                    sb.append('.').append(name == null ? "" : name);
+                }
+            }
+            return sb.toString();
+        }
+    }
+
+    /**
+     * A value and the writer's settings: setHtmlSafe, setSerializeNulls, the indent (empty = compact),
+     * the strictness, and for the numbers in turn whether a Double or Long is written through the
+     * primitive value(double)/value(long) overload (cycled; none = always value(Number)).
+     */
+    record WriterCase(Object v, boolean html, boolean nulls, String indent, Strictness strictness, List<Boolean> primitives) {}
+
+    static final Generator<WriterCase> WRITER_CASE = tuples(Gen.VALUE, chance(50), chance(70), sampledFrom("", "", "  ", "\t"),
+            sampledFrom(Strictness.STRICT, Strictness.LEGACY_STRICT, Strictness.LENIENT), lists(booleans()).maxSize(8))
+            .map(t -> new WriterCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+
+    @Test
+    void writerEventsReadBackAsTheSameEvents() {
+        Hegel.test(tc -> {
+            WriterCase c = tc.draw(WRITER_CASE, "case");
+            Object v = c.v();
+            List<Ev> evs = events(v, new ArrayList<>());
+            StringWriter sw = new StringWriter();
+            boolean html = c.html();
+            boolean nulls = c.nulls();
+            String indent = c.indent();
+            int numbers = 0;
+            try (JsonWriter w = new JsonWriter(sw)) {
+                w.setHtmlSafe(html);
+                w.setSerializeNulls(nulls);
+                w.setIndent(indent);
+                w.setStrictness(c.strictness());
+                for (Ev e : evs) {
+                    switch (e.kind()) {
+                        case "null" -> w.nullValue();
+                        case "bool" -> w.value((boolean) e.arg());
+                        case "string" -> w.value((String) e.arg());
+                        case "number" -> {
+                            Number num = (Number) e.arg();
+                            boolean primitive = !c.primitives().isEmpty() && c.primitives().get(numbers++ % c.primitives().size());
+                            if (num instanceof Double d && primitive) {
+                                w.value(d.doubleValue());
+                            } else if (num instanceof Long l && primitive) {
+                                w.value(l.longValue());
+                            } else {
+                                w.value(num);
+                            }
+                        }
+                        case "[" -> w.beginArray();
+                        case "]" -> w.endArray();
+                        case "{" -> w.beginObject();
+                        case "}" -> w.endObject();
+                        case "name" -> w.name((String) e.arg());
+                        default -> throw new IllegalStateException(e.kind());
+                    }
+                }
+            } catch (IOException e) {
+                fail("writer threw " + e + " for " + Ref.show(v));
+                return;
+            }
+            String text = sw.toString();
+            List<Ev> want = nulls ? evs : withoutNullMembers(evs);
+            Object expected = nulls ? v : dropNullMembers(v);
+            Object parsed;
+            try {
+                parsed = Ref.parse(text);
+            } catch (Ref.Bad e) {
+                fail("JsonWriter produced invalid JSON " + show(text) + ": " + e.getMessage() + " for " + Ref.show(v));
+                return;
+            }
+            check(Ref.same(parsed, expected, true), () -> "JsonWriter text " + show(text) + " reads as " + Ref.show(parsed) + " expected " + Ref.show(expected));
+            if (indent.isEmpty()) {
+                String compact = compact(want, html);
+                check(text.equals(compact), () -> "compact JsonWriter text " + show(text) + " expected " + show(compact));
+            }
+
+            // read the events back with JsonReader, checking getPath/getPreviousPath against the model
+            PathModel pm = new PathModel();
+            List<String> seen = new ArrayList<>();
+            try {
+                JsonReader r = new JsonReader(new StringReader(text));
+                r.setStrictness(Strictness.LEGACY_STRICT);
+                check(r.getPath().equals("$") && r.getPreviousPath().equals("$"), () -> "initial path " + r.getPath() + " / " + r.getPreviousPath());
+                int idx = 0;
+                while (true) {
+                    JsonToken t = r.peek();
+                    if (t == JsonToken.END_DOCUMENT) {
+                        break;
+                    }
+                    if (idx >= want.size()) {
+                        fail("reader has more tokens than written: " + t + " at " + r.getPath() + " for " + show(text));
+                        return;
+                    }
+                    Ev e = want.get(idx++);
+                    final int i = idx - 1;
+                    switch (t) {
+                        case BEGIN_ARRAY -> {
+                            check(e.kind().equals("["), () -> "event " + i + ": BEGIN_ARRAY, expected " + e);
+                            r.beginArray();
+                            pm.beginArray();
+                        }
+                        case END_ARRAY -> {
+                            check(e.kind().equals("]"), () -> "event " + i + ": END_ARRAY, expected " + e);
+                            r.endArray();
+                            pm.end();
+                        }
+                        case BEGIN_OBJECT -> {
+                            check(e.kind().equals("{"), () -> "event " + i + ": BEGIN_OBJECT, expected " + e);
+                            r.beginObject();
+                            pm.beginObject();
+                        }
+                        case END_OBJECT -> {
+                            check(e.kind().equals("}"), () -> "event " + i + ": END_OBJECT, expected " + e);
+                            r.endObject();
+                            pm.end();
+                        }
+                        case NAME -> {
+                            String name = r.nextName();
+                            check(e.kind().equals("name") && name.equals(e.arg()), () -> "event " + i + ": name " + show(name) + ", expected " + e);
+                            pm.name(name);
+                        }
+                        case STRING -> {
+                            String s = r.nextString();
+                            check(e.kind().equals("string") && s.equals(e.arg()), () -> "event " + i + ": string " + show(s) + ", expected " + e);
+                            pm.valueDone();
+                        }
+                        case NUMBER -> {
+                            String s = r.nextString();
+                            check(e.kind().equals("number") && new BigDecimal(s).compareTo(new BigDecimal(e.arg().toString())) == 0,
+                                    () -> "event " + i + ": number " + s + ", expected " + e);
+                            pm.valueDone();
+                        }
+                        case BOOLEAN -> {
+                            boolean bo = r.nextBoolean();
+                            check(e.kind().equals("bool") && e.arg().equals(bo), () -> "event " + i + ": boolean " + bo + ", expected " + e);
+                            pm.valueDone();
+                        }
+                        case NULL -> {
+                            r.nextNull();
+                            check(e.kind().equals("null"), () -> "event " + i + ": null, expected " + e);
+                            pm.valueDone();
+                        }
+                        default -> fail("unexpected token " + t);
+                    }
+                    String path = r.getPath();
+                    String prev = r.getPreviousPath();
+                    seen.add(path);
+                    check(path.equals(pm.path(false)), () -> "after event " + i + " " + e + ": getPath " + path + " expected " + pm.path(false) + " in " + show(text));
+                    check(prev.equals(pm.path(true)), () -> "after event " + i + " " + e + ": getPreviousPath " + prev + " expected " + pm.path(true) + " in " + show(text));
+                }
+                final int consumed = idx;
+                check(consumed == want.size(), () -> "reader stopped after " + consumed + " of " + want.size() + " events for " + show(text));
+                check(r.getPath().equals("$"), () -> "path at the end " + r.getPath());
+            } catch (IOException | IllegalStateException e) {
+                fail("reader threw " + e + " reading " + show(text) + " after " + seen);
+            }
+        }, Zoo.settings("writerEventsReadBackAsTheSameEvents"));
+    }
+
+    // ------------------------------------------------------------------ pins
+
+    /** gson/1: 2^63 is not a long, but nextLong's double fallback saturates it to Long.MAX_VALUE. */
+    @Test
+    void pinLongReadSaturatesOutOfRange() {
+        Gson g = new Gson();
+        org.junit.jupiter.api.Assertions.assertThrows(JsonSyntaxException.class, () -> g.fromJson("9223372036854775808", long.class));
+        org.junit.jupiter.api.Assertions.assertThrows(JsonSyntaxException.class, () -> g.fromJson("-9223372036854775809", long.class));
+    }
+
+    /** gson/1: 332462415175414378.6 is not a long, yet nextLong returns 332462415175414400. */
+    @Test
+    void pinLongReadRoundsNonIntegral() {
+        Gson g = new Gson();
+        org.junit.jupiter.api.Assertions.assertThrows(JsonSyntaxException.class, () -> g.fromJson("332462415175414378.6", long.class));
+        org.junit.jupiter.api.Assertions.assertThrows(JsonSyntaxException.class, () -> g.fromJson("1.00000000000000001", int.class));
+        org.junit.jupiter.api.Assertions.assertThrows(JsonSyntaxException.class, () -> g.fromJson("-993e-801", int.class));
+    }
+
+    /** gson/1: 123456789012345678.0 is exactly a long, yet nextLong returns 123456789012345680. */
+    @Test
+    void pinLongReadLosesPrecision() {
+        Gson g = new Gson();
+        org.junit.jupiter.api.Assertions.assertEquals(123456789012345678L, g.fromJson("123456789012345678.0", long.class));
+        org.junit.jupiter.api.Assertions.assertEquals(9007199254740993L, g.fromJson("9007199254740993e0", long.class));
+    }
+
+    /** gson/3: toJsonTree with an explicit strictness refuses a finite BigDecimal beyond the double range. */
+    @Test
+    void pinToJsonTreeRefusesLargeBigDecimal() {
+        Gson g = new GsonBuilder().setStrictness(Strictness.LEGACY_STRICT).create();
+        BigDecimal big = new BigDecimal("1E+309");
+        org.junit.jupiter.api.Assertions.assertEquals("1E+309", g.toJson(big));
+        org.junit.jupiter.api.Assertions.assertEquals(new JsonPrimitive(big), g.toJsonTree(big));
+    }
+
+    /** gson/2: parseString promises an exception for trailing data, but not after a top-level null. */
+    @Test
+    void pinParseStringTrailingDataAfterNull() {
+        org.junit.jupiter.api.Assertions.assertThrows(JsonSyntaxException.class, () -> JsonParser.parseString("null 1"));
+    }
+
+    /** gson/4: parsed numbers of different value are equal JsonElements when their doubles agree, and remove(Object) follows suit. */
+    @Test
+    void pinParsedNumbersOfDifferentValueAreNotEqual() {
+        org.junit.jupiter.api.Assertions.assertNotEquals(JsonParser.parseString("9007199254740993"), JsonParser.parseString("9007199254740992"));
+        org.junit.jupiter.api.Assertions.assertNotEquals(JsonParser.parseString("1e-400"), JsonParser.parseString("0"));
+        JsonArray arr = JsonParser.parseString("[1e-400, 0]").getAsJsonArray();
+        arr.remove(new JsonPrimitive(0));
+        org.junit.jupiter.api.Assertions.assertEquals("[1e-400]", arr.toString());
+    }
+}
diff --git a/hegel/src/test/java/zoo/Ref.java b/hegel/src/test/java/zoo/Ref.java
new file mode 100644
index 0000000..1a9b9d0
--- /dev/null
+++ b/hegel/src/test/java/zoo/Ref.java
@@ -0,0 +1,518 @@
+package zoo;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Hegel zoo: a reference for RFC 8259 JSON on plain Java values, written from the grammar and
+ * independent of Gson. Values are {@link Map} (LinkedHashMap, insertion order), {@link List},
+ * {@link String}, {@link Num} (the lexeme and its exact value), {@link Boolean} and {@link #NULL}.
+ * The generators of values, texts and edits are in {@link Gen}.
+ */
+final class Ref {
+    private Ref() {}
+
+    /** JSON null (Java null means "absent"). */
+    static final Object NULL = new Object() {
+        @Override
+        public String toString() {
+            return "null";
+        }
+    };
+
+    /**
+     * A JSON number: the lexeme as written and its exact value; equal by value. A lexeme the
+     * grammar accepts but BigDecimal cannot hold (an exponent beyond the int range) has a null
+     * value and is equal by text only. The {@code holder} is the Number a Gson tree holds the
+     * value in (generator data, see {@link Gen#holders}; the exact value unless drawn otherwise):
+     * it plays no part in equality.
+     */
+    record Num(String text, BigDecimal value, Number holder) {
+        static Num of(String text) {
+            BigDecimal value = valueOf(text);
+            return new Num(text, value, value);
+        }
+
+        static Num of(String text, Number holder) {
+            return new Num(text, valueOf(text), holder);
+        }
+
+        private static BigDecimal valueOf(String text) {
+            try {
+                return new BigDecimal(text);
+            } catch (NumberFormatException e) {
+                return null;
+            }
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (!(o instanceof Num n)) {
+                return false;
+            }
+            if (value == null || n.value == null) {
+                return text.equals(n.text);
+            }
+            return value.compareTo(n.value) == 0;
+        }
+
+        @Override
+        public int hashCode() {
+            return value == null ? text.hashCode() : value.signum() == 0 ? 0 : value.stripTrailingZeros().hashCode();
+        }
+
+        @Override
+        public String toString() {
+            return text;
+        }
+    }
+
+    /** Invalid JSON, with the offset of the offending character. */
+    static final class Bad extends RuntimeException {
+        final int at;
+
+        Bad(String msg, int at) {
+            super(msg + " at " + at);
+            this.at = at;
+        }
+    }
+
+    // ------------------------------------------------------------------ parser
+
+    /** Parse a whole text: one value with optional whitespace (space, tab, LF, CR) around it. */
+    static Object parse(String s) {
+        Parser p = new Parser(s);
+        p.ws();
+        Object v = p.value();
+        p.ws();
+        if (p.i != s.length()) {
+            throw p.bad("trailing content");
+        }
+        return v;
+    }
+
+    private static final class Parser {
+        final String s;
+        int i;
+
+        Parser(String s) {
+            this.s = s;
+        }
+
+        Bad bad(String msg) {
+            return new Bad(msg, i);
+        }
+
+        void ws() {
+            while (i < s.length()) {
+                char c = s.charAt(i);
+                if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
+                    i++;
+                } else {
+                    break;
+                }
+            }
+        }
+
+        char peek() {
+            if (i >= s.length()) {
+                throw bad("unexpected end");
+            }
+            return s.charAt(i);
+        }
+
+        void expect(char c) {
+            if (peek() != c) {
+                throw bad("expected '" + c + "'");
+            }
+            i++;
+        }
+
+        Object value() {
+            char c = peek();
+            switch (c) {
+                case '{':
+                    return object();
+                case '[':
+                    return array();
+                case '"':
+                    return string();
+                case 't':
+                    literal("true");
+                    return Boolean.TRUE;
+                case 'f':
+                    literal("false");
+                    return Boolean.FALSE;
+                case 'n':
+                    literal("null");
+                    return NULL;
+                default:
+                    if (c == '-' || (c >= '0' && c <= '9')) {
+                        return number();
+                    }
+                    throw bad("unexpected character");
+            }
+        }
+
+        void literal(String word) {
+            if (!s.startsWith(word, i)) {
+                throw bad("bad literal");
+            }
+            i += word.length();
+        }
+
+        Num number() {
+            int start = i;
+            if (peek() == '-') {
+                i++;
+            }
+            char c = peek();
+            if (c == '0') {
+                i++;
+            } else if (c >= '1' && c <= '9') {
+                digits();
+            } else {
+                throw bad("bad number");
+            }
+            if (i < s.length() && s.charAt(i) == '.') {
+                i++;
+                if (i >= s.length() || !isDigit(s.charAt(i))) {
+                    throw bad("bad fraction");
+                }
+                digits();
+            }
+            if (i < s.length() && (s.charAt(i) == 'e' || s.charAt(i) == 'E')) {
+                i++;
+                if (i < s.length() && (s.charAt(i) == '+' || s.charAt(i) == '-')) {
+                    i++;
+                }
+                if (i >= s.length() || !isDigit(s.charAt(i))) {
+                    throw bad("bad exponent");
+                }
+                digits();
+            }
+            return Num.of(s.substring(start, i));
+        }
+
+        void digits() {
+            while (i < s.length() && isDigit(s.charAt(i))) {
+                i++;
+            }
+        }
+
+        String string() {
+            expect('"');
+            StringBuilder sb = new StringBuilder();
+            while (true) {
+                char c = peek();
+                if (c == '"') {
+                    i++;
+                    return sb.toString();
+                }
+                if (c < 0x20) {
+                    throw bad("control character in string");
+                }
+                if (c == '\\') {
+                    i++;
+                    char e = peek();
+                    i++;
+                    switch (e) {
+                        case '"':
+                            sb.append('"');
+                            break;
+                        case '\\':
+                            sb.append('\\');
+                            break;
+                        case '/':
+                            sb.append('/');
+                            break;
+                        case 'b':
+                            sb.append('\b');
+                            break;
+                        case 'f':
+                            sb.append('\f');
+                            break;
+                        case 'n':
+                            sb.append('\n');
+                            break;
+                        case 'r':
+                            sb.append('\r');
+                            break;
+                        case 't':
+                            sb.append('\t');
+                            break;
+                        case 'u':
+                            if (i + 4 > s.length()) {
+                                throw bad("short \\u escape");
+                            }
+                            int v = 0;
+                            for (int k = 0; k < 4; k++) {
+                                int d = Character.digit(s.charAt(i + k), 16);
+                                if (d < 0) {
+                                    throw bad("bad \\u escape");
+                                }
+                                v = v * 16 + d;
+                            }
+                            i += 4;
+                            sb.append((char) v);
+                            break;
+                        default:
+                            i--;
+                            throw bad("bad escape");
+                    }
+                } else {
+                    sb.append(c);
+                    i++;
+                }
+            }
+        }
+
+        List<Object> array() {
+            expect('[');
+            List<Object> out = new ArrayList<>();
+            ws();
+            if (peek() == ']') {
+                i++;
+                return out;
+            }
+            while (true) {
+                ws();
+                out.add(value());
+                ws();
+                char c = peek();
+                i++;
+                if (c == ']') {
+                    return out;
+                }
+                if (c != ',') {
+                    i--;
+                    throw bad("expected ',' or ']'");
+                }
+            }
+        }
+
+        Map<String, Object> object() {
+            expect('{');
+            Map<String, Object> out = new LinkedHashMap<>();
+            ws();
+            if (peek() == '}') {
+                i++;
+                return out;
+            }
+            while (true) {
+                ws();
+                if (peek() != '"') {
+                    throw bad("expected a name");
+                }
+                String name = string();
+                ws();
+                expect(':');
+                ws();
+                out.put(name, value()); // a repeated name: the last value wins (RFC 8259 leaves it open)
+                ws();
+                char c = peek();
+                i++;
+                if (c == '}') {
+                    return out;
+                }
+                if (c != ',') {
+                    i--;
+                    throw bad("expected ',' or '}'");
+                }
+            }
+        }
+    }
+
+    private static boolean isDigit(char c) {
+        return c >= '0' && c <= '9';
+    }
+
+    // ------------------------------------------------------------------ writer
+
+    /** How strings are escaped: the JSON minimum, or also HTML-sensitive characters. */
+    record Escaping(boolean htmlSafe) {}
+
+    static final Escaping PLAIN = new Escaping(false);
+    static final Escaping HTML = new Escaping(true);
+
+    /** Compact text: no whitespace, numbers as their lexemes, strings per {@code esc}. */
+    static String write(Object v, Escaping esc) {
+        StringBuilder sb = new StringBuilder();
+        write(v, esc, sb);
+        return sb.toString();
+    }
+
+    @SuppressWarnings("unchecked")
+    private static void write(Object v, Escaping esc, StringBuilder sb) {
+        if (v == NULL || v == null) {
+            sb.append("null");
+        } else if (v instanceof Boolean || v instanceof Num) {
+            sb.append(v);
+        } else if (v instanceof String s) {
+            quote(s, esc, sb);
+        } else if (v instanceof List<?> l) {
+            sb.append('[');
+            boolean first = true;
+            for (Object e : l) {
+                if (!first) {
+                    sb.append(',');
+                }
+                first = false;
+                write(e, esc, sb);
+            }
+            sb.append(']');
+        } else if (v instanceof Map<?, ?> m) {
+            sb.append('{');
+            boolean first = true;
+            for (Map.Entry<String, Object> e : ((Map<String, Object>) m).entrySet()) {
+                if (!first) {
+                    sb.append(',');
+                }
+                first = false;
+                quote(e.getKey(), esc, sb);
+                sb.append(':');
+                write(e.getValue(), esc, sb);
+            }
+            sb.append('}');
+        } else {
+            throw new IllegalArgumentException("not a JSON value: " + v.getClass());
+        }
+    }
+
+    /**
+     * Gson's escaping: {@code "} and {@code \} escaped, the control characters as {@code \b \f
+     * \n \r \t} or backslash-u00XX, U+2028/U+2029 as U+2028/U+2029 escapes; with
+     * {@code htmlSafe} also {@code < > & = '} as backslash-u00XX. Everything else verbatim.
+     */
+    static void quote(String s, Escaping esc, StringBuilder sb) {
+        sb.append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            switch (c) {
+                case '"':
+                    sb.append("\\\"");
+                    break;
+                case '\\':
+                    sb.append("\\\\");
+                    break;
+                case '\b':
+                    sb.append("\\b");
+                    break;
+                case '\f':
+                    sb.append("\\f");
+                    break;
+                case '\n':
+                    sb.append("\\n");
+                    break;
+                case '\r':
+                    sb.append("\\r");
+                    break;
+                case '\t':
+                    sb.append("\\t");
+                    break;
+                default:
+                    if (c < 0x20 || c == 0x2028 || c == 0x2029
+                            || (esc.htmlSafe() && (c == '<' || c == '>' || c == '&' || c == '=' || c == '\''))) {
+                        sb.append(String.format("\\u%04x", (int) c));
+                    } else {
+                        sb.append(c);
+                    }
+            }
+        }
+        sb.append('"');
+    }
+
+    /** Deep equality; maps compared in order when {@code ordered}, as sets of entries otherwise. */
+    @SuppressWarnings("unchecked")
+    static boolean same(Object a, Object b, boolean ordered) {
+        if (a == NULL || b == NULL || a == null || b == null) {
+            return (a == NULL || a == null) && (b == NULL || b == null);
+        }
+        if (a instanceof List<?> la && b instanceof List<?> lb) {
+            if (la.size() != lb.size()) {
+                return false;
+            }
+            for (int i = 0; i < la.size(); i++) {
+                if (!same(la.get(i), lb.get(i), ordered)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a instanceof Map<?, ?> ma && b instanceof Map<?, ?> mb) {
+            if (ma.size() != mb.size()) {
+                return false;
+            }
+            if (ordered) {
+                var ia = ((Map<String, Object>) ma).entrySet().iterator();
+                var ib = ((Map<String, Object>) mb).entrySet().iterator();
+                while (ia.hasNext()) {
+                    var ea = ia.next();
+                    var eb = ib.next();
+                    if (!ea.getKey().equals(eb.getKey()) || !same(ea.getValue(), eb.getValue(), true)) {
+                        return false;
+                    }
+                }
+                return true;
+            }
+            for (Map.Entry<String, Object> e : ((Map<String, Object>) ma).entrySet()) {
+                if (!mb.containsKey(e.getKey()) || !same(e.getValue(), mb.get(e.getKey()), false)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a instanceof List || a instanceof Map || b instanceof List || b instanceof Map) {
+            return false;
+        }
+        return a.equals(b);
+    }
+
+    static String show(Object v) {
+        return write(v, PLAIN);
+    }
+
+    // ------------------------------------------------------------------ surrogates
+
+    /** Whether the string has a surrogate without its partner (RFC 8259 allows it, a STRICT Gson reader does not). */
+    static boolean loneSurrogate(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
+                    i++;
+                } else {
+                    return true;
+                }
+            } else if (Character.isLowSurrogate(c)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Whether any string or member name of the value has a lone surrogate. */
+    static boolean hasLoneSurrogate(Object v) {
+        if (v instanceof String s) {
+            return loneSurrogate(s);
+        }
+        if (v instanceof List<?> l) {
+            for (Object x : l) {
+                if (hasLoneSurrogate(x)) {
+                    return true;
+                }
+            }
+        }
+        if (v instanceof Map<?, ?> m) {
+            for (Map.Entry<?, ?> en : m.entrySet()) {
+                if (loneSurrogate((String) en.getKey()) || hasLoneSurrogate(en.getValue())) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..b19422a
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,88 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
