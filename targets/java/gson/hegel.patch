+    /** The corner ints (weight 8) or a middling one. */
+    static final Generator<Integer> ANY_INT = weighted(w(8, sampledFrom(0, 1, -1, 7, 255, 65536, Integer.MAX_VALUE, Integer.MIN_VALUE)), w(1, ints(-100000, 100000)));
+
+    static final Generator<Long> ANY_LONG = weighted(w(8, sampledFrom(0L, 1L, -1L, 1L << 31, 1L << 53, (1L << 53) + 1, Long.MAX_VALUE, Long.MIN_VALUE)),
+            w(1, ints(-100000, 100000).map(Integer::longValue)));
+
+    /** The corner doubles (weight 12) or a small multiple of an eighth; with {@code special}, also NaN and the infinities (weight 3). */
+    static Generator<Double> doubles(boolean special) {
+        Generator<Double> finite = weighted(w(12, sampledFrom(0.0, -0.0, 1.0, -1.5, 0.1, 1e21, 1e-7, 123456.789, Double.MAX_VALUE, Double.MIN_VALUE, 4.9e-324,
+                1.7976931348623157e308)), w(1, ints(-1000, 1000).map(i -> i / 8.0)));
+        return special ? weighted(w(13, finite), w(3, sampledFrom(Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY))) : finite;
+    }
+
+    static final Generator<Float> ANY_FLOAT = weighted(w(8, sampledFrom(0f, -0f, 1f, 0.1f, 3.4028235e38f, 1.4e-45f, 16777217f, 1.1f)),
+            w(1, ints(-1000, 1000).map(i -> i / 8f)));
