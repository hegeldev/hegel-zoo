+    /**
+     * A record of the universe: the scalars, the texts and numbers, and the collections (map values
+     * are null only when the Gson serializes nulls; doubles are special only when it writes them).
+     */
+    static Generator<Pojo> pojo(boolean nulls, boolean special) {
+        Generator<Double> d = doubles(special);
+        Generator<String> mapValue = nulls ? STR : Gen.CLEAN_STRING;
+        return tuples(
+                tuples(ANY_INT, maybe(80, (Integer) null, ANY_INT), ANY_LONG, d, maybe(80, (Double) null, d), ANY_FLOAT, booleans(), maybe(80, (Boolean) null, booleans())),
+                tuples(STR, tuples(CHAR, chance(80)), COLOUR, ints(-128, 127), ints(-32768, 32767), maybe(85, (BigDecimal) null, Gen.LEXEME.map(BigDecimal::new)),
+                        maybe(85, (BigInteger) null, sampledFrom("0", "-1", "18446744073709551616", "123456789012345678901234567890").map(BigInteger::new))),
+                tuples(maybe(85, (List<String>) null, Gen.CLEAN_STRING.map(s -> List.of(s))), lists(maybe(90, (Integer) null, ANY_INT)).maxSize(3), stringIntMap(nulls),
