+package zoo;
+
+import dev.hegel.TestCase;
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Hegel zoo: a reference for RFC 8259 JSON on plain Java values, written from the grammar and
+ * independent of Gson. Values are {@link Map} (LinkedHashMap, insertion order), {@link List},
+ * {@link String}, {@link Num} (the lexeme and its exact value), {@link Boolean} and {@link #NULL}.
+ * Also the generators: random trees, valid texts with random whitespace and escape choices, and
+ * mutations that make a text (almost always) invalid.
+ */
+final class Ref {
+    private Ref() {}
+
+    /** JSON null (Java null means "absent"). */
+    static final Object NULL = new Object() {
+        @Override
+        public String toString() {
+            return "null";
+        }
+    };
+
+    /**
+     * A JSON number: the lexeme as written and its exact value; equal by value. A lexeme the
+     * grammar accepts but BigDecimal cannot hold (an exponent beyond the int range) has a null
+     * value and is equal by text only.
+     */
+    record Num(String text, BigDecimal value) {
+        static Num of(String text) {
+            try {
+                return new Num(text, new BigDecimal(text));
+            } catch (NumberFormatException e) {
+                return new Num(text, null);
+            }
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (!(o instanceof Num n)) {
+                return false;
+            }
+            if (value == null || n.value == null) {
+                return text.equals(n.text);
+            }
+            return value.compareTo(n.value) == 0;
+        }
+
+        @Override
+        public int hashCode() {
+            return value == null ? text.hashCode() : value.signum() == 0 ? 0 : value.stripTrailingZeros().hashCode();
+        }
+
+        @Override
+        public String toString() {
+            return text;
+        }
+    }
+
+    /** Invalid JSON, with the offset of the offending character. */
+    static final class Bad extends RuntimeException {
+        final int at;
+
+        Bad(String msg, int at) {
+            super(msg + " at " + at);
+            this.at = at;
+        }
+    }
+
+    // ------------------------------------------------------------------ parser
+
+    /** Parse a whole text: one value with optional whitespace (space, tab, LF, CR) around it. */
+    static Object parse(String s) {
+        Parser p = new Parser(s);
+        p.ws();
+        Object v = p.value();
+        p.ws();
+        if (p.i != s.length()) {
+            throw p.bad("trailing content");
+        }
+        return v;
+    }
+
+    private static final class Parser {
+        final String s;
+        int i;
+
+        Parser(String s) {
+            this.s = s;
+        }
+
+        Bad bad(String msg) {
+            return new Bad(msg, i);
+        }
+
+        void ws() {
+            while (i < s.length()) {
+                char c = s.charAt(i);
+                if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
+                    i++;
+                } else {
+                    break;
+                }
+            }
+        }
+
+        char peek() {
+            if (i >= s.length()) {
+                throw bad("unexpected end");
+            }
+            return s.charAt(i);
+        }
+
+        void expect(char c) {
+            if (peek() != c) {
+                throw bad("expected '" + c + "'");
+            }
+            i++;
+        }
+
+        Object value() {
+            char c = peek();
+            switch (c) {
+                case '{':
+                    return object();
+                case '[':
+                    return array();
+                case '"':
+                    return string();
+                case 't':
+                    literal("true");
+                    return Boolean.TRUE;
+                case 'f':
+                    literal("false");
+                    return Boolean.FALSE;
+                case 'n':
+                    literal("null");
+                    return NULL;
+                default:
+                    if (c == '-' || (c >= '0' && c <= '9')) {
+                        return number();
+                    }
+                    throw bad("unexpected character");
+            }
+        }
+
+        void literal(String word) {
+            if (!s.startsWith(word, i)) {
+                throw bad("bad literal");
+            }
+            i += word.length();
+        }
+
+        Num number() {
+            int start = i;
+            if (peek() == '-') {
+                i++;
+            }
+            char c = peek();
+            if (c == '0') {
+                i++;
+            } else if (c >= '1' && c <= '9') {
+                digits();
+            } else {
+                throw bad("bad number");
+            }
+            if (i < s.length() && s.charAt(i) == '.') {
+                i++;
+                if (i >= s.length() || !isDigit(s.charAt(i))) {
+                    throw bad("bad fraction");
+                }
+                digits();
+            }
+            if (i < s.length() && (s.charAt(i) == 'e' || s.charAt(i) == 'E')) {
+                i++;
+                if (i < s.length() && (s.charAt(i) == '+' || s.charAt(i) == '-')) {
+                    i++;
+                }
+                if (i >= s.length() || !isDigit(s.charAt(i))) {
+                    throw bad("bad exponent");
+                }
+                digits();
+            }
+            return Num.of(s.substring(start, i));
+        }
+
+        void digits() {
+            while (i < s.length() && isDigit(s.charAt(i))) {
+                i++;
+            }
+        }
+
+        String string() {
+            expect('"');
+            StringBuilder sb = new StringBuilder();
+            while (true) {
+                char c = peek();
+                if (c == '"') {
+                    i++;
+                    return sb.toString();
+                }
+                if (c < 0x20) {
+                    throw bad("control character in string");
+                }
+                if (c == '\\') {
+                    i++;
+                    char e = peek();
+                    i++;
+                    switch (e) {
+                        case '"':
+                            sb.append('"');
+                            break;
+                        case '\\':
+                            sb.append('\\');
+                            break;
+                        case '/':
+                            sb.append('/');
+                            break;
+                        case 'b':
+                            sb.append('\b');
+                            break;
+                        case 'f':
+                            sb.append('\f');
+                            break;
+                        case 'n':
+                            sb.append('\n');
+                            break;
+                        case 'r':
+                            sb.append('\r');
+                            break;
+                        case 't':
+                            sb.append('\t');
+                            break;
+                        case 'u':
+                            if (i + 4 > s.length()) {
+                                throw bad("short \\u escape");
+                            }
+                            int v = 0;
+                            for (int k = 0; k < 4; k++) {
+                                int d = Character.digit(s.charAt(i + k), 16);
+                                if (d < 0) {
+                                    throw bad("bad \\u escape");
+                                }
+                                v = v * 16 + d;
+                            }
+                            i += 4;
+                            sb.append((char) v);
+                            break;
+                        default:
+                            i--;
+                            throw bad("bad escape");
+                    }
+                } else {
+                    sb.append(c);
+                    i++;
+                }
+            }
+        }
+
+        List<Object> array() {
+            expect('[');
+            List<Object> out = new ArrayList<>();
+            ws();
+            if (peek() == ']') {
+                i++;
+                return out;
+            }
+            while (true) {
+                ws();
+                out.add(value());
+                ws();
+                char c = peek();
+                i++;
+                if (c == ']') {
+                    return out;
+                }
+                if (c != ',') {
+                    i--;
+                    throw bad("expected ',' or ']'");
+                }
+            }
+        }
+
+        Map<String, Object> object() {
+            expect('{');
+            Map<String, Object> out = new LinkedHashMap<>();
+            ws();
+            if (peek() == '}') {
+                i++;
+                return out;
+            }
+            while (true) {
+                ws();
+                if (peek() != '"') {
+                    throw bad("expected a name");
+                }
+                String name = string();
+                ws();
+                expect(':');
+                ws();
+                out.put(name, value()); // a repeated name: the last value wins (RFC 8259 leaves it open)
+                ws();
+                char c = peek();
+                i++;
+                if (c == '}') {
+                    return out;
+                }
+                if (c != ',') {
+                    i--;
+                    throw bad("expected ',' or '}'");
+                }
+            }
+        }
+    }
+
+    private static boolean isDigit(char c) {
+        return c >= '0' && c <= '9';
+    }
+
+    // ------------------------------------------------------------------ writer
+
+    /** How strings are escaped: the JSON minimum, or also HTML-sensitive characters. */
+    record Escaping(boolean htmlSafe) {}
+
+    static final Escaping PLAIN = new Escaping(false);
+    static final Escaping HTML = new Escaping(true);
+
+    /** Compact text: no whitespace, numbers as their lexemes, strings per {@code esc}. */
+    static String write(Object v, Escaping esc) {
+        StringBuilder sb = new StringBuilder();
+        write(v, esc, sb);
+        return sb.toString();
+    }
+
+    @SuppressWarnings("unchecked")
+    private static void write(Object v, Escaping esc, StringBuilder sb) {
+        if (v == NULL || v == null) {
+            sb.append("null");
+        } else if (v instanceof Boolean || v instanceof Num) {
+            sb.append(v);
+        } else if (v instanceof String s) {
+            quote(s, esc, sb);
+        } else if (v instanceof List<?> l) {
+            sb.append('[');
+            boolean first = true;
+            for (Object e : l) {
+                if (!first) {
+                    sb.append(',');
+                }
+                first = false;
+                write(e, esc, sb);
+            }
+            sb.append(']');
+        } else if (v instanceof Map<?, ?> m) {
+            sb.append('{');
+            boolean first = true;
+            for (Map.Entry<String, Object> e : ((Map<String, Object>) m).entrySet()) {
+                if (!first) {
+                    sb.append(',');
+                }
+                first = false;
+                quote(e.getKey(), esc, sb);
+                sb.append(':');
+                write(e.getValue(), esc, sb);
+            }
+            sb.append('}');
+        } else {
+            throw new IllegalArgumentException("not a JSON value: " + v.getClass());
+        }
+    }
+
+    /**
+     * Gson's escaping: {@code "} and {@code \} escaped, the control characters as {@code \b \f
+     * \n \r \t} or backslash-u00XX, U+2028/U+2029 as U+2028/U+2029 escapes; with
+     * {@code htmlSafe} also {@code < > & = '} as backslash-u00XX. Everything else verbatim.
+     */
+    static void quote(String s, Escaping esc, StringBuilder sb) {
+        sb.append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            switch (c) {
+                case '"':
+                    sb.append("\\\"");
+                    break;
+                case '\\':
+                    sb.append("\\\\");
+                    break;
+                case '\b':
+                    sb.append("\\b");
+                    break;
+                case '\f':
+                    sb.append("\\f");
+                    break;
+                case '\n':
+                    sb.append("\\n");
+                    break;
+                case '\r':
+                    sb.append("\\r");
+                    break;
+                case '\t':
+                    sb.append("\\t");
+                    break;
+                default:
+                    if (c < 0x20 || c == 0x2028 || c == 0x2029
+                            || (esc.htmlSafe() && (c == '<' || c == '>' || c == '&' || c == '=' || c == '\''))) {
+                        sb.append(String.format("\\u%04x", (int) c));
+                    } else {
+                        sb.append(c);
+                    }
+            }
+        }
+        sb.append('"');
+    }
+
+    /** Deep equality; maps compared in order when {@code ordered}, as sets of entries otherwise. */
+    @SuppressWarnings("unchecked")
+    static boolean same(Object a, Object b, boolean ordered) {
+        if (a == NULL || b == NULL || a == null || b == null) {
+            return (a == NULL || a == null) && (b == NULL || b == null);
+        }
+        if (a instanceof List<?> la && b instanceof List<?> lb) {
+            if (la.size() != lb.size()) {
+                return false;
+            }
+            for (int i = 0; i < la.size(); i++) {
+                if (!same(la.get(i), lb.get(i), ordered)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a instanceof Map<?, ?> ma && b instanceof Map<?, ?> mb) {
+            if (ma.size() != mb.size()) {
+                return false;
+            }
+            if (ordered) {
+                var ia = ((Map<String, Object>) ma).entrySet().iterator();
+                var ib = ((Map<String, Object>) mb).entrySet().iterator();
+                while (ia.hasNext()) {
+                    var ea = ia.next();
+                    var eb = ib.next();
+                    if (!ea.getKey().equals(eb.getKey()) || !same(ea.getValue(), eb.getValue(), true)) {
+                        return false;
+                    }
+                }
+                return true;
+            }
+            for (Map.Entry<String, Object> e : ((Map<String, Object>) ma).entrySet()) {
+                if (!mb.containsKey(e.getKey()) || !same(e.getValue(), mb.get(e.getKey()), false)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a instanceof List || a instanceof Map || b instanceof List || b instanceof Map) {
+            return false;
+        }
+        return a.equals(b);
+    }
+
+    static String show(Object v) {
+        return write(v, PLAIN);
+    }
+
+    // ------------------------------------------------------------------ generators
+
+    static final String[] KEYS = {
+        "", "a", "b", "c", "key", "1", "0", "-1", "a b", "é", "null", "true", "__proto__", "constructor",
+        "with\"quote", "back\\slash", "new\nline", "tab\t", "日本", "<b>&'=", "😀", "A", "aa",
+    };
+
+    static final String[] NUMBERS = {
+        "0", "-0", "1", "-1", "7", "10", "42", "255", "256", "65535", "2147483647", "2147483648", "-2147483648",
+        "-2147483649", "4294967295", "9007199254740992", "9007199254740993", "9223372036854775807",
+        "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "18446744073709551616",
+        "123456789012345678901234567890", "0.0", "-0.0", "1.0", "1.5", "0.1", "0.2", "0.30000000000000004",
+        "2.5", "-2.5", "3.14159", "1e2", "1E2", "1e+2", "1e-2", "1.5e3", "1E-7", "1e22", "1e23", "1e308",
+        "1.7976931348623157e308", "1e309", "1e400", "1e-400", "4.9e-324", "2.2250738585072014E-308",
+        "123456789.123456789", "0.000001", "1e-6", "100000000000000000000", "1E+2", "0e0", "0E-5",
+        "9007199254740993.0", "1.00000000000000011102230246251565404236316680908203125",
+    };
+
+    static final String STRING_ALPHABET =
+            "ab1 _/\"\\\n\t\r\b\f\u0001\u001f\u007fé日<>&='\u2028\u2029\u00a0\ufeff\u0000";
+
+    /** A random string: mostly short words over an alphabet of the characters JSON cares about. */
+    static String string(TestCase tc) {
+        int r = Zoo.n(tc, 0, 99);
+        if (r < 15) {
+            return Zoo.pick(tc, KEYS);
+        }
+        if (r < 25) {
+            return Zoo.pick(tc, "😀", "a😀b", "\ud800", "\udc00", "x\ud83dy", "😀😀");
+        }
+        return Zoo.word(tc, STRING_ALPHABET, 0, 8);
+    }
+
+    static String number(TestCase tc) {
+        if (Zoo.chance(tc, 70)) {
+            return Zoo.pick(tc, NUMBERS);
+        }
+        StringBuilder sb = new StringBuilder();
+        if (Zoo.chance(tc, 30)) {
+            sb.append('-');
+        }
+        if (Zoo.chance(tc, 20)) {
+            sb.append('0');
+        } else {
+            sb.append(Zoo.word(tc, "123456789", 1, 1)).append(Zoo.word(tc, "0123456789", 0, 18));
+        }
+        if (Zoo.chance(tc, 40)) {
+            sb.append('.').append(Zoo.word(tc, "0123456789", 1, 12));
+        }
+        if (Zoo.chance(tc, 30)) {
+            sb.append(Zoo.pick(tc, "e", "E")).append(Zoo.pick(tc, "", "+", "-")).append(Zoo.word(tc, "0123456789", 1, 3));
+        }
+        return sb.toString();
+    }
+
+    /** A random JSON value; containers up to {@code depth} deep. */
+    static Object gen(TestCase tc, int depth) {
+        int r = Zoo.n(tc, 0, 99);
+        if (depth > 0 && r < 20) {
+            List<Object> out = new ArrayList<>();
+            int n = Zoo.n(tc, 0, 5);
+            for (int i = 0; i < n; i++) {
+                out.add(gen(tc, depth - 1));
+            }
+            return out;
+        }
+        if (depth > 0 && r < 45) {
+            Map<String, Object> out = new LinkedHashMap<>();
+            int n = Zoo.n(tc, 0, 5);
+            for (int i = 0; i < n; i++) {
+                out.put(string(tc), gen(tc, depth - 1));
+            }
+            return out;
+        }
+        if (r < 65) {
+            return string(tc);
+        }
+        if (r < 85) {
+            return Num.of(number(tc));
+        }
+        if (r < 92) {
+            return Zoo.chance(tc, 50);
+        }
+        return NULL;
+    }
+
+    /** A random non-empty container (the shape most APIs want at the top). */
+    static Object genContainer(TestCase tc, int depth) {
+        while (true) {
+            Object v = gen(tc, depth);
+            if (v instanceof List || v instanceof Map) {
+                return v;
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------ texts
+
+    /** Valid text for {@code v} with random whitespace and random (valid) escape choices. */
+    static String text(TestCase tc, Object v) {
+        StringBuilder sb = new StringBuilder();
+        boolean loose = Zoo.chance(tc, 60);
+        text(tc, v, sb, loose);
+        return sb.toString();
+    }
+
+    private static void gap(TestCase tc, StringBuilder sb, boolean loose) {
+        if (loose && Zoo.chance(tc, 30)) {
+            sb.append(Zoo.pick(tc, " ", "  ", "\t", "\n", "\r\n", " \n\t "));
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static void text(TestCase tc, Object v, StringBuilder sb, boolean loose) {
+        gap(tc, sb, loose);
+        if (v == NULL) {
+            sb.append("null");
+        } else if (v instanceof Boolean || v instanceof Num) {
+            sb.append(v);
+        } else if (v instanceof String s) {
+            quoteLoose(tc, s, sb, loose);
+        } else if (v instanceof List<?> l) {
+            sb.append('[');
+            boolean first = true;
+            for (Object e : l) {
+                if (!first) {
+                    gap(tc, sb, loose);
+                    sb.append(',');
+                }
+                first = false;
+                text(tc, e, sb, loose);
+            }
+            gap(tc, sb, loose);
+            sb.append(']');
+        } else {
+            sb.append('{');
+            boolean first = true;
+            for (Map.Entry<String, Object> e : ((Map<String, Object>) v).entrySet()) {
+                if (!first) {
+                    gap(tc, sb, loose);
+                    sb.append(',');
+                }
+                first = false;
+                gap(tc, sb, loose);
+                quoteLoose(tc, e.getKey(), sb, loose);
+                gap(tc, sb, loose);
+                sb.append(':');
+                text(tc, e.getValue(), sb, loose);
+            }
+            gap(tc, sb, loose);
+            sb.append('}');
+        }
+        gap(tc, sb, loose);
+    }
+
+    /** A valid quoting with random escape choices: backslash-u escapes for any char, escaped slashes. */
+    private static void quoteLoose(TestCase tc, String s, StringBuilder sb, boolean loose) {
+        sb.append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            boolean must = c == '"' || c == '\\' || c < 0x20;
+            if (must || (loose && Zoo.chance(tc, 10))) {
+                switch (c) {
+                    case '"' -> sb.append(Zoo.chance(tc, 50) ? "\\\"" : "\\u0022");
+                    case '\\' -> sb.append(Zoo.chance(tc, 50) ? "\\\\" : "\\u005c");
+                    case '/' -> sb.append(Zoo.chance(tc, 50) ? "\\/" : "\\u002f");
+                    case '\n' -> sb.append(Zoo.chance(tc, 50) ? "\\n" : "\\u000a");
+                    case '\t' -> sb.append(Zoo.chance(tc, 50) ? "\\t" : "\\u0009");
+                    case '\r' -> sb.append("\\r");
+                    case '\b' -> sb.append("\\b");
+                    case '\f' -> sb.append("\\f");
+                    default -> sb.append(Zoo.chance(tc, 50) ? String.format("\\u%04x", (int) c) : String.format("\\u%04X", (int) c));
+                }
+            } else {
+                sb.append(c);
+            }
+        }
+        sb.append('"');
+    }
+
+    static final String[] JUNK = {
+        ",", "]", "}", "{", "[", ":", "\"", "'", "//c\n", "/*c*/", "#x\n", "NaN", "Infinity", "-Infinity", "01", "+1",
+        ".5", "1.", "1e", "1e+", "0x1F", "TRUE", "True", "nul", "None", "undefined", ";", "=", "=>", "\\x41", "\\u12",
+        "\\U0041", "\\'", "\\a", "\\0", "\u0001", "\u0000", "\u007f", "\f", "\u00a0", "\u2028", "\ufeff", "-", "--1",
+        "1 2", "a", "[,]", "{,}", "[1,]", "{\"a\":1,}", "{\"a\"}", "{\"a\":}", "{1:2}", "{a:1}", "[1 2]", "\"\n\"",
+        "\"\t\"", "\"\\", "true false", "é", "1_000", "1,000",
+    };
+
+    /** A text derived from a valid one by an edit that (nearly always) breaks it. */
+    static String mutate(TestCase tc, String text) {
+        int r = Zoo.n(tc, 0, 99);
+        if (r < 55 || text.isEmpty()) {
+            int at = Zoo.n(tc, 0, text.length());
+            return text.substring(0, at) + Zoo.pick(tc, JUNK) + text.substring(at);
+        }
+        if (r < 75) {
+            int at = Zoo.n(tc, 0, text.length() - 1);
+            return text.substring(0, at) + text.substring(at + 1);
+        }
+        if (r < 90) {
+            return text.substring(0, Zoo.n(tc, 0, text.length() - 1));
+        }
+        int at = Zoo.n(tc, 0, text.length() - 1);
+        return text.substring(0, at) + Zoo.pick(tc, "a", "1", "\"", "\\", ",", " ", "\u0000", "\u00a0") + text.substring(at + 1);
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
