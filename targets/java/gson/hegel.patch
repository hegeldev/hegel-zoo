+                    check(prev.equals(pm.path(true)), () -> "after event " + i + " " + e + ": getPreviousPath " + prev + " expected " + pm.path(true) + " in " + show(text));
+                }
+                final int consumed = idx;
+                check(consumed == want.size(), () -> "reader stopped after " + consumed + " of " + want.size() + " events for " + show(text));
+                check(r.getPath().equals("$"), () -> "path at the end " + r.getPath());
+            } catch (IOException | IllegalStateException e) {
+                fail("reader threw " + e + " reading " + show(text) + " after " + seen);
+            }
+        }, Zoo.settings("writerEventsReadBackAsTheSameEvents"));
+    }
+
+    // ------------------------------------------------------------------ pins
+
+    /** gson/1: 2^63 is not a long, but nextLong's double fallback saturates it to Long.MAX_VALUE. */
+    @Test
+    void pinLongReadSaturatesOutOfRange() {
+        Gson g = new Gson();
+        org.junit.jupiter.api.Assertions.assertThrows(JsonSyntaxException.class, () -> g.fromJson("9223372036854775808", long.class));
+        org.junit.jupiter.api.Assertions.assertThrows(JsonSyntaxException.class, () -> g.fromJson("-9223372036854775809", long.class));
+    }
+
+    /** gson/1: 332462415175414378.6 is not a long, yet nextLong returns 332462415175414400. */
+    @Test
+    void pinLongReadRoundsNonIntegral() {
+        Gson g = new Gson();
+        org.junit.jupiter.api.Assertions.assertThrows(JsonSyntaxException.class, () -> g.fromJson("332462415175414378.6", long.class));
+        org.junit.jupiter.api.Assertions.assertThrows(JsonSyntaxException.class, () -> g.fromJson("1.00000000000000001", int.class));
+        org.junit.jupiter.api.Assertions.assertThrows(JsonSyntaxException.class, () -> g.fromJson("-993e-801", int.class));
+    }
+
+    /** gson/1: 123456789012345678.0 is exactly a long, yet nextLong returns 123456789012345680. */
+    @Test
+    void pinLongReadLosesPrecision() {
+        Gson g = new Gson();
+        org.junit.jupiter.api.Assertions.assertEquals(123456789012345678L, g.fromJson("123456789012345678.0", long.class));
+        org.junit.jupiter.api.Assertions.assertEquals(9007199254740993L, g.fromJson("9007199254740993e0", long.class));
+    }
+
+    /** gson/3: toJsonTree with an explicit strictness refuses a finite BigDecimal beyond the double range. */
+    @Test
+    void pinToJsonTreeRefusesLargeBigDecimal() {
+        Gson g = new GsonBuilder().setStrictness(Strictness.LEGACY_STRICT).create();
+        BigDecimal big = new BigDecimal("1E+309");
+        org.junit.jupiter.api.Assertions.assertEquals("1E+309", g.toJson(big));
+        org.junit.jupiter.api.Assertions.assertEquals(new JsonPrimitive(big), g.toJsonTree(big));
+    }
+
+    /** gson/2: parseString promises an exception for trailing data, but not after a top-level null. */
+    @Test
+    void pinParseStringTrailingDataAfterNull() {
+        org.junit.jupiter.api.Assertions.assertThrows(JsonSyntaxException.class, () -> JsonParser.parseString("null 1"));
+    }
+}
