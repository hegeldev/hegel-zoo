index 0000000..19eb37a
--- /dev/null
+++ b/hegel/src/test/java/zoo/GsonTest.java
@@ -0,0 +1,1681 @@
+package zoo;
+
+import static dev.hegel.Generators.booleans;
+import static dev.hegel.Generators.just;
