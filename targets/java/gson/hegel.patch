+    /** Record equality with BigDecimal by value (Gson may re-scale). */
+    static boolean samePojo(Pojo a, Pojo b) {
+        if (a == null || b == null) {
+            return a == b;
+        }
+        boolean bigOk = a.big() == null ? b.big() == null : b.big() != null && a.big().compareTo(b.big()) == 0;
+        return bigOk && a.i() == b.i() && Objects.equals(a.boxed(), b.boxed()) && a.l() == b.l()
+                && Double.compare(a.d(), b.d()) == 0 && Objects.equals(a.bd(), b.bd()) && Float.compare(a.f(), b.f()) == 0
+                && a.b() == b.b() && Objects.equals(a.bb(), b.bb()) && Objects.equals(a.s(), b.s()) && a.ch() == b.ch()
+                && Objects.equals(a.bch(), b.bch()) && a.e() == b.e() && a.by() == b.by() && a.sh() == b.sh()
+                && Objects.equals(a.bigInt(), b.bigInt()) && Objects.equals(a.xs(), b.xs()) && Objects.equals(a.ns(), b.ns())
+                && Objects.equals(a.m(), b.m()) && Objects.equals(a.im(), b.im()) && Objects.equals(a.dm(), b.dm())
+                && Objects.equals(a.bm(), b.bm()) && Objects.equals(a.leaf(), b.leaf()) && Objects.equals(a.leaves(), b.leaves());
+    }
