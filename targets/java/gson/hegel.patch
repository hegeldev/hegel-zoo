+                } catch (NullPointerException expected) {
+                    // documented
+                }
+            }
+            JsonObject freshObj = (JsonObject) tree(tc, omodel);
+            check(freshObj.equals(obj) && freshObj.hashCode() == obj.hashCode(), () -> "fresh object not equal (or hash differs): " + freshObj + " vs " + obj);
+            if (omodel.size() >= 2) {
+                JsonObject reordered = new JsonObject();
+                List<String> keys = new ArrayList<>(omodel.keySet());
+                for (int i = keys.size() - 1; i >= 0; i--) {
+                    reordered.add(keys.get(i), obj.get(keys.get(i)).deepCopy());
+                }
+                check(reordered.equals(obj) && reordered.hashCode() == obj.hashCode(), () -> "reordered object not equal: " + reordered + " vs " + obj);
+                check(!reordered.toString().equals(obj.toString()), () -> "reordered object prints in the same order: " + obj);
+            }
+        }, Zoo.settings("arraysAndObjectsMatchTheCollectionModels"));
+    }
