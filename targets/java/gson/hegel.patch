+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.show;
+
+import com.google.gson.FormattingStyle;
+import com.google.gson.Gson;
+import com.google.gson.GsonBuilder;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonNull;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonPrimitive;
+import com.google.gson.JsonSyntaxException;
+import com.google.gson.Strictness;
+import com.google.gson.ToNumberPolicy;
+import com.google.gson.internal.LazilyParsedNumber;
+import com.google.gson.reflect.TypeToken;
+import com.google.gson.stream.JsonReader;
+import com.google.gson.stream.JsonToken;
+import com.google.gson.stream.JsonWriter;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.IOException;
+import java.io.StringReader;
+import java.io.StringWriter;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: Gson against a reference JSON reader/writer on plain values ({@link Ref}), models of
+ * the documented formatting, path, equality and coercion rules, and its own inverse pairs
+ * (toJson/fromJson over a record universe).
+ */
+class GsonTest {
+
+    // ------------------------------------------------------------------ bridges
+
+    /** The reference value of a Gson tree (numbers by their Number's toString). */
+    static Object model(JsonElement e) {
+        if (e == null || e.isJsonNull()) {
+            return Ref.NULL;
+        }
+        if (e.isJsonArray()) {
+            List<Object> out = new ArrayList<>();
+            for (JsonElement x : e.getAsJsonArray()) {
+                out.add(model(x));
+            }
+            return out;
+        }
+        if (e.isJsonObject()) {
+            Map<String, Object> out = new LinkedHashMap<>();
+            for (Map.Entry<String, JsonElement> en : e.getAsJsonObject().entrySet()) {
+                out.put(en.getKey(), model(en.getValue()));
+            }
+            return out;
+        }
+        JsonPrimitive p = e.getAsJsonPrimitive();
+        if (p.isBoolean()) {
+            return p.getAsBoolean();
+        }
+        if (p.isString()) {
+            return p.getAsString();
+        }
+        return Ref.Num.of(p.getAsNumber().toString());
+    }
+
+    /** A Gson tree for a reference value; numbers become a random Number class fitting the lexeme. */
+    @SuppressWarnings("unchecked")
+    static JsonElement tree(TestCase tc, Object v) {
+        if (v == Ref.NULL) {
+            return JsonNull.INSTANCE;
+        }
+        if (v instanceof Boolean b) {
+            return new JsonPrimitive(b);
+        }
+        if (v instanceof String s) {
+            return new JsonPrimitive(s);
+        }
+        if (v instanceof Ref.Num num) {
+            return new JsonPrimitive(number(tc, num));
+        }
+        if (v instanceof List<?> l) {
+            JsonArray a = new JsonArray();
+            for (Object x : l) {
+                a.add(tree(tc, x));
+            }
+            return a;
+        }
+        JsonObject o = new JsonObject();
+        for (Map.Entry<String, Object> en : ((Map<String, Object>) v).entrySet()) {
+            o.add(en.getKey(), tree(tc, en.getValue()));
+        }
+        return o;
+    }
+
+    /**
+     * A Number for a lexeme — the lexeme itself as a LazilyParsedNumber (what parsing gives), the
+     * exact BigDecimal, a BigInteger/long/int when the lexeme is an integer in range, or the double
+     * whose shortest representation the lexeme is. Every choice prints as a valid JSON number of
+     * the same value.
+     */
+    static Number number(TestCase tc, Ref.Num num) {
+        BigDecimal v = num.value();
+        boolean plainInt = num.text().matches("-?(0|[1-9][0-9]*)");
+        int r = n(tc, 0, 4);
+        if (r == 0) {
+            return new LazilyParsedNumber(num.text());
+        }
+        if (plainInt) {
+            BigInteger bi = v.toBigIntegerExact();
+            if (r == 1 && bi.bitLength() < 32) {
+                return bi.intValue();
+            }
+            if (r <= 2 && bi.bitLength() < 64) {
+                return bi.longValue();
+            }
+            if (r == 3) {
+                return bi;
+            }
+        }
+        if (r == 4) {
+            double d = Double.parseDouble(num.text());
+            if (!Double.isInfinite(d) && new BigDecimal(d).compareTo(v) == 0 && new BigDecimal(Double.toString(d)).compareTo(v) == 0
+                    && !num.text().equals("-0")) {
+                return d;
+            }
+        }
+        return v;
+    }
+
+    /** A Gson with random settings, remembered for the models. */
+    record Cfg(Gson g, boolean nulls, boolean html, String newline, String indent, boolean space, Strictness strictness, boolean special) {
+        boolean lenient() {
+            // no explicit strictness: Gson reads and writes leniently (documented legacy behaviour)
+            return strictness == null || strictness == Strictness.LENIENT;
+        }
+    }
+
+    static Cfg gson(TestCase tc, boolean allowSpecial) {
+        GsonBuilder b = new GsonBuilder();
+        boolean nulls = chance(tc, 50);
+        if (nulls) {
+            b.serializeNulls();
+        }
+        boolean html = !chance(tc, 40);
+        if (!html) {
+            b.disableHtmlEscaping();
+        }
+        Strictness strictness = null;
+        if (chance(tc, 40)) {
+            strictness = pick(tc, Strictness.STRICT, Strictness.LEGACY_STRICT, Strictness.LENIENT);
+            b.setStrictness(strictness);
+        }
+        boolean special = allowSpecial && (strictness == null || strictness == Strictness.LENIENT) && chance(tc, 30);
+        if (special) {
+            b.serializeSpecialFloatingPointValues();
+        }
+        String newline = "";
+        String indent = "";
+        boolean space = false;
+        int style = n(tc, 0, 3);
+        if (style == 1) {
+            b.setPrettyPrinting();
+            newline = "\n";
+            indent = "  ";
+            space = true;
+        } else if (style == 2) {
+            indent = pick(tc, "", " ", "\t", "    ", " \t");
+            newline = pick(tc, "\n", "\r\n", "\r", "");
+            space = chance(tc, 50);
+            b.setFormattingStyle(FormattingStyle.PRETTY.withIndent(indent).withNewline(newline).withSpaceAfterSeparators(space));
+        } else if (style == 3) {
+            space = chance(tc, 50);
+            b.setFormattingStyle(FormattingStyle.COMPACT.withSpaceAfterSeparators(space));
+        }
+        return new Cfg(b.create(), nulls, html, newline, indent, space, strictness, special);
+    }
+
+    /**
+     * The text Gson's writer documents for a tree: newline + indent per depth before every array
+     * element and every member (never after a colon, never inside an empty container), ", " only
+     * when spaces are on and there is no newline, ": " when spaces are on, members with a JsonNull
+     * value dropped unless nulls are serialized.
+     */
+    static String format(JsonElement e, boolean nulls, boolean html, String newline, String indent, boolean space) {
+        StringBuilder sb = new StringBuilder();
+        format(e, 0, nulls, html ? Ref.HTML : Ref.PLAIN, newline, indent, space, sb);
+        return sb.toString();
+    }
+
+    private static void format(JsonElement e, int depth, boolean nulls, Ref.Escaping esc, String newline, String indent, boolean space, StringBuilder sb) {
+        boolean nl = !(newline.isEmpty() && indent.isEmpty());
+        String comma = space && newline.isEmpty() ? ", " : ",";
+        String colon = space ? ": " : ":";
+        if (e.isJsonNull()) {
+            sb.append("null");
+        } else if (e.isJsonPrimitive()) {
+            JsonPrimitive p = e.getAsJsonPrimitive();
+            if (p.isString()) {
+                Ref.quote(p.getAsString(), esc, sb);
+            } else if (p.isBoolean()) {
+                sb.append(p.getAsBoolean());
+            } else {
+                sb.append(p.getAsNumber().toString());
+            }
+        } else if (e.isJsonArray()) {
+            sb.append('[');
+            int i = 0;
+            for (JsonElement x : e.getAsJsonArray()) {
+                if (i > 0) {
+                    sb.append(comma);
+                }
+                if (nl) {
+                    sb.append(newline).append(indent.repeat(depth + 1));
+                }
+                format(x, depth + 1, nulls, esc, newline, indent, space, sb);
+                i++;
+            }
+            if (i > 0 && nl) {
+                sb.append(newline).append(indent.repeat(depth));
+            }
+            sb.append(']');
+        } else {
+            sb.append('{');
+            int i = 0;
+            for (Map.Entry<String, JsonElement> en : e.getAsJsonObject().entrySet()) {
+                if (en.getValue().isJsonNull() && !nulls) {
+                    continue;
+                }
+                if (i > 0) {
+                    sb.append(comma);
+                }
+                if (nl) {
+                    sb.append(newline).append(indent.repeat(depth + 1));
+                }
+                Ref.quote(en.getKey(), esc, sb);
+                sb.append(colon);
+                format(en.getValue(), depth + 1, nulls, esc, newline, indent, space, sb);
+                i++;
+            }
+            if (i > 0 && nl) {
+                sb.append(newline).append(indent.repeat(depth));
+            }
+            sb.append('}');
+        }
+    }
+
+    /** The value with JsonNull object members removed (what a writer without serializeNulls emits). */
+    static Object dropNullMembers(Object v) {
+        if (v instanceof List<?> l) {
+            List<Object> out = new ArrayList<>();
+            for (Object x : l) {
+                out.add(dropNullMembers(x));
+            }
+            return out;
+        }
+        if (v instanceof Map<?, ?> m) {
+            Map<String, Object> out = new LinkedHashMap<>();
+            for (Map.Entry<?, ?> en : m.entrySet()) {
+                if (en.getValue() != Ref.NULL) {
+                    out.put((String) en.getKey(), dropNullMembers(en.getValue()));
+                }
+            }
+            return out;
+        }
+        return v;
+    }
+
+    static boolean loneSurrogate(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
+                    i++;
+                } else {
+                    return true;
+                }
+            } else if (Character.isLowSurrogate(c)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean hasLoneSurrogate(Object v) {
+        if (v instanceof String s) {
+            return loneSurrogate(s);
+        }
+        if (v instanceof List<?> l) {
+            for (Object x : l) {
+                if (hasLoneSurrogate(x)) {
+                    return true;
+                }
+            }
+        }
+        if (v instanceof Map<?, ?> m) {
+            for (Map.Entry<?, ?> en : m.entrySet()) {
+                if (loneSurrogate((String) en.getKey()) || hasLoneSurrogate(en.getValue())) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    // ------------------------------------------------------------------ 1. trees and text
+
+    @Test
+    void treesRoundTripThroughText() {
+        Hegel.test(tc -> {
+            Object v = Ref.gen(tc, 4);
+            // the reference agrees with itself first (a generator or parser slip is ours)
+            String own = Ref.text(tc, v);
+            Object back;
+            try {
+                back = Ref.parse(own);
+            } catch (Ref.Bad e) {
+                fail("reference rejects its own text " + show(own) + ": " + e.getMessage());
+                return;
+            }
+            check(Ref.same(back, v, true), () -> "reference round trip " + show(own) + " -> " + Ref.show(back));
+
+            JsonElement tree = tree(tc, v);
+            check(Ref.same(model(tree), v, true), () -> "tree(v) models back to " + Ref.show(model(tree)) + " not " + Ref.show(v));
+
+            // JsonElement.toString: compact, not html-escaped, nulls kept (documented)
+            String s = tree.toString();
+            String want = format(tree, true, false, "", "", false);
+            check(s.equals(want), () -> "toString " + show(s) + " expected " + show(want));
+            JsonElement re = JsonParser.parseString(s);
+            check(re.equals(tree), () -> "parseString(toString) differs: " + re + " vs " + tree);
+            check(re.hashCode() == tree.hashCode(), () -> "equal trees, hashCodes differ: " + tree + " (" + tree.hashCode() + " vs " + re.hashCode() + ")");
+            check(re.toString().equals(s), () -> "toString not idempotent: " + show(s) + " -> " + show(re.toString()));
+
+            // the reference's own text parses to an equal tree
+            JsonElement fromLoose = JsonParser.parseString(own);
+            check(fromLoose.equals(tree), () -> "parseString(" + show(own) + ") = " + fromLoose + " not " + tree);
+            check(Ref.same(model(fromLoose), v, true), () -> "model(parseString(own)) differs for " + show(own));
+
+            // Gson.toJson with random settings is exactly the documented formatting, and reads back
+            Cfg c = gson(tc, false);
+            String text = c.g().toJson(tree);
+            String expectedText = format(tree, c.nulls(), c.html(), c.newline(), c.indent(), c.space());
+            check(text.equals(expectedText), () -> "toJson " + show(text) + " expected " + show(expectedText) + " (nulls=" + c.nulls() + " html=" + c.html()
+                    + " newline=" + show(c.newline()) + " indent=" + show(c.indent()) + " space=" + c.space() + ")");
+            Object expected = c.nulls() ? v : dropNullMembers(v);
+            Object parsed;
+            try {
+                parsed = Ref.parse(text);
+            } catch (Ref.Bad e) {
+                fail("toJson produced invalid JSON " + show(text) + ": " + e.getMessage());
+                return;
+            }
+            check(Ref.same(parsed, expected, true), () -> "toJson " + show(text) + " reads back as " + Ref.show(parsed) + " expected " + Ref.show(expected));
+            if (c.strictness() == Strictness.STRICT && hasLoneSurrogate(v)) {
+                return; // a STRICT reader refuses unpaired surrogates (documented)
+            }
+            JsonElement again = c.g().fromJson(text, JsonElement.class);
+            check(Ref.same(model(again), expected, true), () -> "fromJson(toJson) " + again + " expected " + Ref.show(expected));
+            check(c.g().toJson(again).equals(text), () -> "toJson(fromJson(text)) differs from text: " + show(c.g().toJson(again)) + " vs " + show(text));
+
+            // deepCopy is equal and independent
+            JsonElement copy = tree.deepCopy();
+            check(copy.equals(tree) && copy.hashCode() == tree.hashCode(), () -> "deepCopy differs: " + copy + " vs " + tree);
+            if (tree.isJsonArray() && !tree.getAsJsonArray().isEmpty()) {
+                copy.getAsJsonArray().set(0, new JsonPrimitive("changed"));
+                check(!copy.equals(tree) && Ref.same(model(tree), v, true), () -> "deepCopy shares structure: " + tree);
+            } else if (tree.isJsonObject()) {
+                copy.getAsJsonObject().addProperty("zoo-extra", 1);
+                check(!copy.equals(tree) && Ref.same(model(tree), v, true), () -> "deepCopy shares structure: " + tree);
+            }
+        }, Zoo.settings("treesRoundTripThroughText"));
+    }
+
+    // ------------------------------------------------------------------ 2. reader vs reference
+
+    static JsonElement parseStrict(String text) throws IOException {
+        JsonReader r = new JsonReader(new StringReader(text));
+        r.setStrictness(Strictness.STRICT);
+        JsonElement e = JsonParser.parseReader(r);
+        if (r.peek() != JsonToken.END_DOCUMENT) {
+            throw new JsonSyntaxException("trailing content at " + r.getPath());
+        }
+        return e;
+    }
+
+    @Test
+    void strictReaderAgreesWithTheReference() {
+        Hegel.test(tc -> {
+            Object v = Ref.gen(tc, 4);
+            String text = Ref.text(tc, v);
+            if (chance(tc, 55)) {
+                text = Ref.mutate(tc, text);
+            }
+            Object ref = null;
+            String refError = null;
+            try {
+                ref = Ref.parse(text);
+            } catch (Ref.Bad e) {
+                refError = e.getMessage();
+            }
+            JsonElement got = null;
+            String gotError = null;
+            try {
+                got = parseStrict(text);
+            } catch (Exception e) {
+                gotError = e.getClass().getSimpleName() + ": " + e.getMessage();
+            } catch (StackOverflowError e) {
+                gotError = "StackOverflowError";
+            }
+            final String t = text;
+            if (refError == null && gotError != null) {
+                final String ge = gotError;
+                // strict mode also rejects unpaired surrogates (documented), which RFC 8259 allows
+                if (!hasLoneSurrogate(ref)) {
+                    fail("strict reader rejects valid JSON " + show(t) + " (" + ge + ")");
+                }
+            } else if (refError != null && gotError == null) {
+                final String re = refError;
+                final JsonElement g = got;
+                // a leading byte-order mark is consumed silently (documented in the reader)
+                // an empty or whitespace-only document is JsonNull (documented compatibility rule)
+                if (!t.startsWith("\ufeff") && !t.matches("[ \\t\\n\\r]*")) {
+                    fail("strict reader accepts invalid JSON " + show(t) + " as " + g + " (reference: " + re + ")");
+                }
+            } else if (refError == null) {
+                final Object r = ref;
+                final JsonElement g = got;
+                check(Ref.same(model(g), r, true), () -> "strict reader value " + g + " expected " + Ref.show(r) + " for " + show(t));
+                // the lenient modes accept everything strict does, with the same value
+                for (Strictness s : new Strictness[] {Strictness.LEGACY_STRICT, Strictness.LENIENT}) {
+                    try {
+                        JsonReader rd = new JsonReader(new StringReader(t));
+                        rd.setStrictness(s);
+                        JsonElement e = JsonParser.parseReader(rd);
+                        check(e.equals(g), () -> s + " reader value " + e + " differs from strict " + g + " for " + show(t));
+                    } catch (Exception e) {
+                        fail(s + " reader rejects " + show(t) + " which strict accepts: " + e);
+                    }
+                }
+                try {
+                    JsonElement e = JsonParser.parseString(t);
+                    check(e.equals(g), () -> "parseString value " + e + " differs from strict " + g + " for " + show(t));
+                } catch (Exception e) {
+                    fail("parseString rejects " + show(t) + " which strict accepts: " + e);
+                }
+                // documented: parseString and Gson.fromJson(String) throw on trailing data
+                // (a top-level null: gson/2, parseString does not check for trailing data then)
+                if (chance(tc, 40) && !g.isJsonNull()) {
+                    String tail = pick(tc, " 1", " null", " {}", " []", " \"x\"", " true", " x", " ,", " ]");
+                    String more = t + tail;
+                    try {
+                        JsonElement e = JsonParser.parseString(more);
+                        fail("parseString accepts trailing data: " + show(more) + " -> " + e);
+                    } catch (JsonSyntaxException expected) {
+                        // documented
+                    } catch (RuntimeException e) {
+                        fail("parseString threw " + e.getClass().getSimpleName() + " (not JsonSyntaxException) for trailing data " + show(more));
+                    }
+                    try {
+                        JsonElement e = new Gson().fromJson(more, JsonElement.class);
+                        fail("Gson.fromJson(String) accepts trailing data: " + show(more) + " -> " + e);
+                    } catch (JsonSyntaxException expected) {
+                        // documented
+                    } catch (RuntimeException e) {
+                        fail("Gson.fromJson threw " + e.getClass().getSimpleName() + " (not JsonSyntaxException) for trailing data " + show(more));
+                    }
+                }
+            }
+        }, Zoo.settings("strictReaderAgreesWithTheReference"));
+    }
+
+    // ------------------------------------------------------------------ 3. records round trip
+
+    enum Colour {
+        RED,
+        GREEN,
+        BLUE
+    }
+
+    record Leaf(int i, Integer boxed, long l, String s, Colour c, List<String> xs, Map<String, Integer> m, boolean b) {}
+
+    record Pojo(
+            int i,
+            Integer boxed,
+            long l,
+            double d,
+            Double bd,
+            float f,
+            boolean b,
+            Boolean bb,
+            String s,
+            char ch,
+            Character bch,
+            Colour e,
+            byte by,
+            short sh,
+            BigDecimal big,
+            BigInteger bigInt,
+            List<String> xs,
+            List<Integer> ns,
+            Map<String, Integer> m,
+            Map<Integer, String> im,
+            Map<Double, Boolean> dm,
+            Map<Boolean, String> bm,
+            Leaf leaf,
+            List<Leaf> leaves) {}
+
+    /** A string without unpaired surrogates (a STRICT reader refuses those, documented). */
+    static String cleanString(TestCase tc) {
+        for (int k = 0; k < 5; k++) {
