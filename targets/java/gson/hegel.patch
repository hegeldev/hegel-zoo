+    // ------------------------------------------------------------------ 4. Object / Number reading
+
+    /** A value, the spelling of its text, and the Gson's number policy and strictness. */
+    record PolicyCase(Object v, Gen.Layout layout, ToNumberPolicy policy, Strictness strictness) {}
+
+    static final Generator<PolicyCase> POLICY_CASE = tuples(Gen.value(3), Gen.LAYOUT,
+            sampledFrom(ToNumberPolicy.DOUBLE, ToNumberPolicy.LAZILY_PARSED_NUMBER, ToNumberPolicy.LONG_OR_DOUBLE, ToNumberPolicy.BIG_DECIMAL),
+            sampledFrom(Strictness.LENIENT, Strictness.LEGACY_STRICT, Strictness.STRICT))
+            .map(t -> new PolicyCase(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    @Test
+    void objectsReadPerTheNumberPolicy() {
+        Hegel.test(tc -> {
+            PolicyCase c = tc.draw(POLICY_CASE, "case");
+            Object v = c.v();
+            String text = Gen.text(v, c.layout());
+            ToNumberPolicy policy = c.policy();
+            Strictness strictness = c.strictness();
+            Gson g = new GsonBuilder().setObjectToNumberStrategy(policy).setStrictness(strictness).serializeNulls().create();
+            boolean infinite = anyNumber(v, num -> Double.isInfinite(Double.parseDouble(num.text())));
+            Object got;
+            try {
+                got = g.fromJson(text, Object.class);
+            } catch (RuntimeException e) {
+                // DOUBLE / LONG_OR_DOUBLE turn 1e400 into Infinity, which the non-lenient modes refuse (documented)
+                if (infinite && (policy == ToNumberPolicy.DOUBLE || policy == ToNumberPolicy.LONG_OR_DOUBLE) && strictness != Strictness.LENIENT) {
+                    return;
+                }
+                if (strictness == Strictness.STRICT && Ref.hasLoneSurrogate(v)) {
+                    return;
+                }
+                fail("fromJson(Object) threw " + e + " for " + show(text) + " with " + policy + "/" + strictness);
+                return;
+            }
+            Object expected = asObjects(v, policy);
+            check(sameObjects(got, expected), () -> "fromJson(Object) " + describe(got) + " expected " + describe(expected) + " for " + show(text) + " with " + policy);
+            // and back to JSON of the same value (numbers respelled by their Number class)
+            if (policy == ToNumberPolicy.LAZILY_PARSED_NUMBER || policy == ToNumberPolicy.BIG_DECIMAL) {
+                String again = g.toJson(got);
+                Object re;
+                try {
+                    re = Ref.parse(again);
+                } catch (Ref.Bad e) {
+                    fail("toJson(fromJson(Object)) is not valid JSON " + show(again) + ": " + e.getMessage());
+                    return;
+                }
+                check(Ref.same(re, v, true), () -> "toJson(fromJson(Object)) " + show(again) + " expected the value of " + show(text));
+            }
+        }, Zoo.settings("objectsReadPerTheNumberPolicy"));
+    }
+
+    interface NumPred {
+        boolean test(Ref.Num n);
+    }
+
+    static boolean anyNumber(Object v, NumPred p) {
+        if (v instanceof Ref.Num num) {
+            return p.test(num);
+        }
+        if (v instanceof List<?> l) {
+            for (Object x : l) {
+                if (anyNumber(x, p)) {
+                    return true;
+                }
+            }
+        }
+        if (v instanceof Map<?, ?> m) {
+            for (Object x : m.values()) {
+                if (anyNumber(x, p)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /** The plain-Java value Gson's ObjectTypeAdapter documents (nulls as Java null). */
+    static Object asObjects(Object v, ToNumberPolicy policy) {
+        if (v == Ref.NULL) {
+            return null;
+        }
+        if (v instanceof Ref.Num num) {
+            return switch (policy) {
+                case DOUBLE -> Double.parseDouble(num.text());
+                case LAZILY_PARSED_NUMBER -> num; // compared by lexeme below
+                case LONG_OR_DOUBLE -> {
+                    try {
+                        yield Long.parseLong(num.text());
+                    } catch (NumberFormatException e) {
+                        yield Double.parseDouble(num.text());
+                    }
+                }
+                case BIG_DECIMAL -> num.value();
+            };
+        }
+        if (v instanceof List<?> l) {
+            List<Object> out = new ArrayList<>();
+            for (Object x : l) {
+                out.add(asObjects(x, policy));
+            }
+            return out;
+        }
+        if (v instanceof Map<?, ?> m) {
+            Map<String, Object> out = new LinkedHashMap<>();
+            for (Map.Entry<?, ?> en : m.entrySet()) {
+                out.put((String) en.getKey(), asObjects(en.getValue(), policy));
+            }
+            return out;
+        }
+        return v;
+    }
+
+    static boolean sameObjects(Object got, Object exp) {
+        if (got == null || exp == null) {
+            return got == exp;
+        }
+        if (exp instanceof List<?> le) {
+            if (!(got instanceof List<?> lg) || lg.size() != le.size()) {
+                return false;
+            }
+            for (int i = 0; i < le.size(); i++) {
+                if (!sameObjects(lg.get(i), le.get(i))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (exp instanceof Map<?, ?> me) {
+            if (!(got instanceof Map<?, ?> mg) || mg.size() != me.size()) {
+                return false;
+            }
+            var ig = mg.entrySet().iterator();
+            for (Map.Entry<?, ?> e : me.entrySet()) {
+                Map.Entry<?, ?> ge = ig.next();
+                if (!e.getKey().equals(ge.getKey()) || !sameObjects(ge.getValue(), e.getValue())) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (exp instanceof Ref.Num num) {
+            return got instanceof LazilyParsedNumber && got.toString().equals(num.text());
+        }
+        if (exp instanceof Double d) {
+            return got instanceof Double gd && Double.compare(d, gd) == 0;
+        }
+        if (exp instanceof Long l) {
+            return got instanceof Long gl && l.longValue() == gl.longValue();
+        }
+        if (exp instanceof BigDecimal bd) {
+            return got instanceof BigDecimal gb && bd.compareTo(gb) == 0;
+        }
+        return exp.equals(got);
+    }
+
+    static String describe(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof List<?> l) {
+            StringBuilder sb = new StringBuilder("[");
+            for (Object x : l) {
+                sb.append(describe(x)).append(", ");
+            }
+            return sb.append("]").toString();
+        }
+        if (o instanceof Map<?, ?> m) {
+            StringBuilder sb = new StringBuilder("{");
+            for (Map.Entry<?, ?> e : m.entrySet()) {
+                sb.append(show(e.getKey())).append(": ").append(describe(e.getValue())).append(", ");
+            }
+            return sb.append("}").toString();
+        }
+        return show(o);
+    }
+
+    // ------------------------------------------------------------------ 5. the tree API vs models
+
+    /** One operation on a JsonArray and its ArrayList model; a position is taken modulo the live size (nothing happens on an empty array). */
+    sealed interface ArrOp permits Add, RemoveAt, SetAt, AddString, RemoveEqual, AddAll {}
+
+    record Add(Object v) implements ArrOp {}
+
+    record RemoveAt(int at) implements ArrOp {}
+
+    record SetAt(int at, Object v) implements ArrOp {}
+
+    /** add(String): null becomes JsonNull (documented). */
+    record AddString(String s) implements ArrOp {}
+
+    /** remove(element) with an equal element, its numbers held in other classes. */
+    record RemoveEqual(int at) implements ArrOp {}
+
+    record AddAll(List<Object> vs) implements ArrOp {}
+
+    /** add (weight 3), remove(int), set, add(String), remove(element), addAll of up to two scalars. */
+    static final Generator<ArrOp> ARR_OP = weighted(
+            w(3, Gen.SHALLOW.<ArrOp>map(Add::new)),
+            w(1, ints(0, 99).<ArrOp>map(RemoveAt::new)),
+            w(1, tuples(ints(0, 99), Gen.SHALLOW).<ArrOp>map(t -> new SetAt(t.value1(), t.value2()))),
+            w(1, maybe(85, (String) null, Gen.STRING).<ArrOp>map(AddString::new)),
+            w(1, ints(0, 99).<ArrOp>map(RemoveEqual::new)),
+            w(1, lists(Gen.SCALAR).maxSize(2).<ArrOp>map(AddAll::new)));
+
+    /** The name an object operation works on: the {@code at}-th existing name (modulo the size) when asked for and there is one, else the fresh one. */
+    record Key(boolean existing, int at, String fresh) {
+        String resolve(Map<String, ?> model) {
+            if (existing && !model.isEmpty()) {
+                List<String> keys = new ArrayList<>(model.keySet());
+                return keys.get(at % keys.size());
+            }
+            return fresh;
+        }
+    }
+
+    static final Generator<Key> KEY = tuples(chance(30), ints(0, 99), Gen.STRING).map(t -> new Key(t.value1(), t.value2(), t.value3()));
+
+    /** One operation on a JsonObject and its LinkedHashMap model. */
+    sealed interface ObjOp permits Put, Remove, PutString, PutInt, PutBool, PutChar, PutNull {
+        Key key();
+    }
+
+    record Put(Key key, Object v) implements ObjOp {}
+
+    record Remove(Key key) implements ObjOp {}
+
+    /** addProperty(String): null becomes JsonNull. */
+    record PutString(Key key, String s) implements ObjOp {}
+
+    record PutInt(Key key, int i) implements ObjOp {}
+
+    record PutBool(Key key, boolean b) implements ObjOp {}
+
+    record PutChar(Key key, char c) implements ObjOp {}
+
+    /** add(name, null): JsonNull (documented). */
+    record PutNull(Key key) implements ObjOp {}
+
+    static final Generator<ObjOp> PUT = tuples(KEY, Gen.SHALLOW).map(t -> new Put(t.value1(), t.value2()));
+    static final Generator<ObjOp> REMOVE = KEY.map(Remove::new);
+    static final Generator<ObjOp> PUT_STRING = tuples(KEY, maybe(85, (String) null, Gen.STRING)).map(t -> new PutString(t.value1(), t.value2()));
+    static final Generator<ObjOp> PUT_INT = tuples(KEY, ANY_INT).map(t -> new PutInt(t.value1(), t.value2()));
+    static final Generator<ObjOp> PUT_BOOL = tuples(KEY, booleans()).map(t -> new PutBool(t.value1(), t.value2()));
+    static final Generator<ObjOp> PUT_CHAR = tuples(KEY, sampledFrom('x', '"', '\n', 'é')).map(t -> new PutChar(t.value1(), t.value2()));
+    static final Generator<ObjOp> PUT_NULL = KEY.map(PutNull::new);
+
+    /** add (weight 3), remove, one of the addProperty overloads, add(name, null). */
+    static final Generator<ObjOp> OBJ_OP = weighted(w(3, PUT), w(1, REMOVE), w(1, oneOf(PUT_STRING, PUT_INT, PUT_BOOL, PUT_CHAR)), w(1, PUT_NULL));
+
+    /**
+     * The array operations, the Number classes the probes hold values in (see {@link Gen.Reholder}),
+     * the value the asList view sets, the object operations and the digit of the missing name.
+     */
+    /** gson/4: whether a number before index idx has the double value of model.get(idx) without being equal to it. */
+    static boolean collidesBefore(List<Object> model, int idx) {
+        if (!(model.get(idx) instanceof Ref.Num v) || v.value() == null) {
+            return false;
+        }
+        for (int j = 0; j < idx; j++) {
+            if (model.get(j) instanceof Ref.Num n && n.value() != null && n.value().compareTo(v.value()) != 0
+                    && n.value().doubleValue() == v.value().doubleValue()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    record CollectionsCase(List<ArrOp> arrayOps, List<Integer> holders, Object replacement, List<ObjOp> objectOps, int missing) {}
+
+    static final Generator<CollectionsCase> COLLECTIONS_CASE = tuples(lists(ARR_OP).minSize(1).maxSize(15), lists(ints(0, 5)).maxSize(8), Gen.SCALAR,
+            lists(OBJ_OP).minSize(1).maxSize(15), ints(0, 9)).map(t -> new CollectionsCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    @Test
+    void arraysAndObjectsMatchTheCollectionModels() {
+        Hegel.test(tc -> {
+            CollectionsCase c = tc.draw(COLLECTIONS_CASE, "case");
+            Gen.Reholder re = new Gen.Reholder(c.holders());
+            // JsonArray vs ArrayList
+            JsonArray arr = new JsonArray();
+            List<Object> model = new ArrayList<>();
+            List<ArrOp> ops = c.arrayOps();
+            for (int k = 0; k < ops.size(); k++) {
+                switch (ops.get(k)) {
+                    case Add op -> {
+                        arr.add(tree(op.v()));
+                        model.add(op.v());
+                    }
+                    case RemoveAt op -> {
+                        if (!model.isEmpty()) {
+                            int i = op.at() % model.size();
+                            JsonElement removed = arr.remove(i);
+                            Object o = model.remove(i);
+                            check(Ref.same(model(removed), o, true), () -> "remove(i) returned " + removed + " expected " + Ref.show(o));
+                        }
+                    }
+                    case SetAt op -> {
+                        if (!model.isEmpty()) {
+                            int i = op.at() % model.size();
+                            JsonElement old = arr.set(i, tree(op.v()));
+                            Object o = model.set(i, op.v());
+                            check(Ref.same(model(old), o, true), () -> "set returned " + old + " expected " + Ref.show(o));
+                        }
+                    }
+                    case AddString op -> {
+                        arr.add(op.s());
+                        model.add(op.s() == null ? Ref.NULL : op.s());
+                    }
+                    case RemoveEqual op -> {
+                        if (!model.isEmpty()) {
+                            Object v = model.get(op.at() % model.size());
+                            int idx = model.indexOf(v);
+                            // gson/4: remove(Object) takes the first element equal as a double, not the first equal number
+                            if (!collidesBefore(model, idx)) {
+                                JsonElement probe = tree(re.apply(v));
+                                boolean removed = arr.remove(probe);
+                                check(removed, () -> "remove(equal element) returned false for " + probe + " in " + arr);
+                                model.remove(idx);
+                            }
+                        }
+                    }
+                    case AddAll op -> {
+                        JsonArray other = new JsonArray();
+                        for (Object v : op.vs()) {
+                            other.add(tree(v));
+                            model.add(v);
+                        }
+                        arr.addAll(other);
+                    }
+                }
+                final int step = k;
+                check(arr.size() == model.size(), () -> "step " + step + ": size " + arr.size() + " expected " + model.size());
+                check(Ref.same(model(arr), model, true), () -> "step " + step + ": array " + arr + " expected " + Ref.show(model));
+            }
+            check(arr.isEmpty() == model.isEmpty(), "isEmpty");
+            for (int i = 0; i < model.size(); i++) {
+                final int idx = i;
+                check(Ref.same(model(arr.get(i)), model.get(i), true), () -> "get(" + idx + ")");
+                check(arr.contains(tree(re.apply(model.get(i)))), () -> "contains(element " + idx + ") false: " + arr);
+            }
+            List<JsonElement> view = arr.asList();
+            check(view.size() == arr.size(), "asList size");
+            if (!model.isEmpty()) {
+                Object v = c.replacement();
+                view.set(0, tree(v));
+                check(Ref.same(model(arr.get(0)), v, true), () -> "asList is not a live view: " + arr);
+                model.set(0, v);
+                try {
+                    view.add(null);
+                    fail("asList().add(null) did not throw");
+                } catch (NullPointerException expected) {
+                    // documented
+                }
+            }
+            try {
+                arr.get(model.size());
+                fail("get(size) did not throw for " + arr);
+            } catch (IndexOutOfBoundsException expected) {
+                // documented
+            }
+            if (arr.size() == 1) {
+                JsonElement only = arr.get(0);
+                if (only.isJsonPrimitive()) {
+                    check(arr.getAsString().equals(only.getAsString()), "getAsString on a one-element array");
+                }
+            } else {
+                try {
+                    arr.getAsString();
+                    fail("getAsString on " + arr.size() + " elements did not throw");
+                } catch (IllegalStateException expected) {
+                    check(expected.getMessage().equals("Array must have size 1, but has size " + arr.size()), () -> "getAsString message: " + expected.getMessage());
+                }
+            }
+            JsonArray fresh = (JsonArray) tree(re.apply(model));
+            check(fresh.equals(arr) && fresh.hashCode() == arr.hashCode(), () -> "fresh array not equal (or hash differs): " + fresh + " vs " + arr);
+            if (model.size() >= 2 && !model.get(0).equals(model.get(1))) {
+                JsonArray swapped = fresh.deepCopy();
+                JsonElement a0 = swapped.get(0);
+                swapped.set(0, swapped.get(1));
+                swapped.set(1, a0);
+                check(!swapped.equals(arr), () -> "arrays equal despite different order: " + swapped + " vs " + arr);
+            }
+
+            // JsonObject vs LinkedHashMap (insertion order, re-adding keeps the position)
+            JsonObject obj = new JsonObject();
+            Map<String, Object> omodel = new LinkedHashMap<>();
+            List<ObjOp> oops = c.objectOps();
+            for (int k = 0; k < oops.size(); k++) {
+                ObjOp op = oops.get(k);
+                String key = op.key().resolve(omodel);
+                switch (op) {
+                    case Put p -> {
+                        obj.add(key, tree(p.v()));
+                        omodel.put(key, p.v());
+                    }
+                    case Remove r -> {
+                        JsonElement removed = obj.remove(key);
+                        Object o = omodel.remove(key);
+                        check(o == null ? removed == null : removed != null && Ref.same(model(removed), o, true),
+                                () -> "remove(" + show(key) + ") returned " + removed + " expected " + (o == null ? "null" : Ref.show(o)));
+                    }
+                    case PutString p -> {
