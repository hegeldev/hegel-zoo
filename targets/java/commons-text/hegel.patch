+    // ------------------------------------------------------------------ 5. RandomStringGenerator
+
+    static boolean acceptable(int cp, CharacterPredicate[] preds) {
+        int type = Character.getType(cp);
+        if (type == Character.SURROGATE || type == Character.PRIVATE_USE || type == Character.UNASSIGNED) {
+            return false;
+        }
+        if (preds == null) {
+            return true;
+        }
+        for (CharacterPredicate p : preds) {
+            if (p.test(cp)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    @Test
+    void randomStringGeneratorHonoursItsBounds() {
+        Hegel.test(tc -> {
+            RandomStringGenerator.Builder b = RandomStringGenerator.builder();
+            int lo = n(tc, 0, 0x300);
+            int hi = pick(tc, n(tc, lo, 0x300), n(tc, lo, 0xffff), n(tc, lo, 0x10ffff));
+            CharacterPredicate[] preds = null;
+            char[] selected = null;
+            int mode = n(tc, 0, 2);
+            String ctx;
+            if (mode == 0) {
+                b.withinRange(lo, hi);
+                ctx = "withinRange(" + lo + ", " + hi + ")";
+            } else if (mode == 1) {
+                hi = Math.min(hi, n(tc, lo, 0x3000)); // keep the rejection sampling of a filtered range quick
+                b.withinRange(lo, hi);
+                preds = new CharacterPredicate[n(tc, 1, 3)];
+                for (int k = 0; k < preds.length; k++) {
+                    preds[k] = pick(tc, CharacterPredicates.values());
+                }
+                b.filteredBy(preds);
+                ctx = "withinRange(" + lo + ", " + hi + ").filteredBy(" + Arrays.toString(preds) + ")";
+            } else {
+                selected = Zoo.word(tc, "abcXYZ019 é", 1, 6).toCharArray();
+                b.selectFrom(selected);
+                ctx = "selectFrom(" + show(new String(selected)) + ")";
+            }
+            // deterministic randomness so the run is reproducible and the length maths is checkable
+            long[] seed = {tc.draw(Generators.longs())};
+            java.util.Random rnd = new java.util.Random(seed[0]);
+            b.usingRandom(max -> rnd.nextInt(max));
+            RandomStringGenerator g = b.get();
+            // bug commons-text/6: a configuration no code point satisfies makes generate() spin forever; skip those
+            boolean satisfiable = false;
+            if (selected != null) {
+                for (char c : selected) {
+                    satisfiable |= acceptable(c, null);
+                }
+            } else {
+                for (int cp = lo; cp <= hi && !satisfiable; cp++) {
+                    satisfiable = acceptable(cp, preds);
+                }
+            }
+            if (!satisfiable) {
+                return;
+            }
+            int len = n(tc, 0, 30);
+            String s;
+            try {
+                s = g.generate(len);
+            } catch (RuntimeException e) {
+                fail(ctx + ".generate(" + len + ") threw " + e);
+                return;
+            }
+            check(s.codePointCount(0, s.length()) == len, () -> ctx + ".generate(" + len + ") has " + s.codePointCount(0, s.length()) + " code points: " + show(s));
+            for (int i = 0; i < s.length(); ) {
+                int cp = s.codePointAt(i);
+                i += Character.charCount(cp);
+                int type = Character.getType(cp);
+                check(type != Character.SURROGATE && type != Character.PRIVATE_USE && type != Character.UNASSIGNED, () -> ctx + " produced U+" + Integer.toHexString(cp) + " of type " + type);
+                if (selected != null) {
+                    check(new String(selected).indexOf(cp) >= 0, () -> ctx + " produced U+" + Integer.toHexString(cp) + " outside the selection");
+                } else {
+                    check(cp >= lo && cp <= hi, () -> ctx + " produced U+" + Integer.toHexString(cp) + " outside the range");
+                }
+                if (preds != null) {
+                    boolean any = false;
+                    for (CharacterPredicate p : preds) {
+                        any |= p.test(cp);
+                    }
+                    check(any, () -> ctx + " produced U+" + Integer.toHexString(cp) + " matching no predicate");
+                }
+            }
+            int min = n(tc, 0, 10);
+            int max = n(tc, min, 14);
+            String ranged = g.generate(min, max);
+            int cps = ranged.codePointCount(0, ranged.length());
+            check(cps >= min && cps <= max, () -> ctx + ".generate(" + min + ", " + max + ") has " + cps + " code points");
+            // the same seed gives the same string
+            java.util.Random rnd2 = new java.util.Random(seed[0]);
+            String again = b.usingRandom(max2 -> rnd2.nextInt(max2)).get().generate(len);
+            check(again.equals(s), () -> ctx + " is not reproducible: " + show(s) + " vs " + show(again));
+        }, Zoo.settings("randomStringGeneratorHonoursItsBounds"));
+    }
