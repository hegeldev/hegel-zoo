+    // ------------------------------------------------------------------ 6. FormattableUtils / ExtendedMessageFormat
+
+    static final class Padded implements Formattable {
+        final String seq;
+        final CharSequence ellipsis;
+        final char pad;
+
+        Padded(String seq, CharSequence ellipsis, char pad) {
+            this.seq = seq;
+            this.ellipsis = ellipsis;
+            this.pad = pad;
+        }
+
+        @Override
+        public void formatTo(Formatter formatter, int flags, int width, int precision) {
+            FormattableUtils.append(seq, formatter, flags, width, precision, pad, ellipsis);
+        }
+    }
+
+    @Test
+    void formattableUtilsAndExtendedMessageFormatKeepTheirShape() {
+        Hegel.test(tc -> {
+            String seq = Zoo.word(tc, "abcdef ", 0, 12);
+            int width = pick(tc, -1, n(tc, 1, 14));
+            int precision = n(tc, -1, 10);
+            boolean left = width > 0 && chance(tc, 50);
+            int ellipsisChoice = n(tc, 0, 4);
+            String ellipsis = ellipsisChoice == 0 ? null : ellipsisChoice == 1 ? "" : ellipsisChoice == 2 ? "..." : ellipsisChoice == 3 ? "~" : "..";
+            char pad = pick(tc, ' ', '_');
+            if (ellipsis != null && precision >= 0 && ellipsis.length() > precision) {
+                Assertions.assertThrows(IllegalArgumentException.class,
+                    () -> FormattableUtils.append(seq, new Formatter(), 0, width, precision, pad, ellipsis));
+            } else {
+                String spec = "%" + (left ? "-" : "") + (width >= 0 ? width : "") + (precision >= 0 ? "." + precision : "") + "s";
+                String out = String.format(spec, new Padded(seq, ellipsis, pad));
+                int shown = precision >= 0 ? Math.min(precision, seq.length()) : seq.length();
+                int wantLen = Math.max(width, shown);
+                String body = precision >= 0 && precision < seq.length()
+                    ? seq.substring(0, precision - (ellipsis == null ? 0 : ellipsis.length())) + (ellipsis == null ? "" : ellipsis)
+                    : seq;
+                String want = left ? body + String.valueOf(pad).repeat(wantLen - body.length()) : String.valueOf(pad).repeat(wantLen - body.length()) + body;
+                check(out.equals(want), () -> "FormattableUtils.append(" + show(seq) + ", " + spec + ", pad " + pad + ", ellipsis " + show(ellipsis) + ") = " + show(out) + ", want " + show(want));
+            }
+
+            // ExtendedMessageFormat: with no registry it formats like MessageFormat and toPattern() reparses the same
+            StringBuilder p = new StringBuilder();
+            int args = n(tc, 0, 3);
+            // arguments: strings or numbers; a number format needs a Number (MessageFormat itself refuses a
+            // String) and the custom upper format is only compared on strings (it prints numbers unformatted)
+            Object[] values = new Object[3];
+            boolean[] numeric = new boolean[3];
+            for (int k = 0; k < 3; k++) {
+                numeric[k] = chance(tc, 40);
+                values[k] = numeric[k] ? (chance(tc, 50) ? 42 : 1234.5) : pick(tc, "x", "Hello", "a'b");
+            }
+            int items = n(tc, 0, 6);
+            boolean upper = false;
+            boolean literalBrace = false;
+            for (int k = 0; k < items; k++) {
+                switch (n(tc, 0, 5)) {
+                    case 0, 1 -> p.append(Zoo.word(tc, "abc ,.-", 1, 5));
+                    case 2 -> p.append("''");
+                    case 3 -> {
+                        String quoted = Zoo.word(tc, "abc {}", 1, 4);
+                        literalBrace |= quoted.indexOf('}') >= 0;
+                        p.append('\'').append(quoted).append('\'');
+                    }
+                    case 4 -> p.append('{').append(n(tc, 0, 2)).append('}');
+                    default -> {
+                        int idx = n(tc, 0, 2);
+                        if (chance(tc, 50)) {
+                            if (numeric[idx]) {
+                                p.append('{').append(idx).append('}');
+                            } else {
+                                p.append('{').append(idx).append(",upper}");
+                                upper = true;
+                            }
+                        } else if (numeric[idx]) {
+                            p.append('{').append(idx).append(pick(tc, ",number", ",number,integer", ",number,#.##", ", number , integer ")).append('}');
+                        } else {
+                            p.append('{').append(idx).append('}');
+                        }
+                    }
+                }
+            }
+            String pattern = p.toString();
+            Map<String, FormatFactory> registry = new HashMap<>();
+            registry.put("upper", (name, arguments, locale) -> new java.text.Format() {
+                @Override
+                public StringBuffer format(Object obj, StringBuffer toAppendTo, java.text.FieldPosition pos) {
+                    return toAppendTo.append(String.valueOf(obj).toUpperCase(Locale.ROOT));
+                }
+
+                @Override
+                public Object parseObject(String source, java.text.ParsePosition pos) {
+                    return null;
+                }
+            });
+            ExtendedMessageFormat emf;
+            try {
+                emf = new ExtendedMessageFormat(pattern, Locale.US, registry);
+            } catch (IllegalArgumentException e) {
+                fail("ExtendedMessageFormat rejected " + show(pattern) + ": " + e.getMessage());
+                return;
+            }
+            String formatted = emf.format(values);
+            String ctx = " for pattern " + show(pattern) + " and " + Arrays.toString(values);
+            if (!upper) {
+                String plain = new MessageFormat(pattern, Locale.US).format(values);
+                check(formatted.equals(plain), () -> "ExtendedMessageFormat gave " + show(formatted) + ", MessageFormat " + show(plain) + ctx);
+            } else {
+                // the custom format applies: every {n,upper} argument appears upper-cased
+                String manual = new MessageFormat(pattern.replace(",upper}", "}"), Locale.US).format(values);
+                check(formatted.equalsIgnoreCase(manual), () -> "ExtendedMessageFormat with upper gave " + show(formatted) + ", plain " + show(manual) + ctx);
+            }
+            // bug commons-text/9: a literal '}' in the pattern makes toPattern() drop every custom format
+            // description after it; pinned, patterns with a quoted '}' are left to the pin here
+            if (literalBrace && upper) {
+                return;
+            }
+            String again = emf.toPattern();
+            String reformatted = new ExtendedMessageFormat(again, Locale.US, registry).format(values);
+            check(reformatted.equals(formatted), () -> "toPattern() " + show(again) + " formats " + show(reformatted) + ", the original " + show(formatted) + ctx);
+            check(new ExtendedMessageFormat(again, Locale.US, registry).toPattern().equals(again), () -> "toPattern() is not a fixed point: " + show(again) + " -> " + show(new ExtendedMessageFormat(again, Locale.US, registry).toPattern()) + ctx);
+        }, Zoo.settings("formattableUtilsAndExtendedMessageFormatKeepTheirShape"));
+    }
