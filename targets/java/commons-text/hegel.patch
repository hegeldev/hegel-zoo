+    // ------------------------------------------------------------------ 2. the Java literal grammar
+
+    static boolean isHex(char c) {
+        return c >= '0' && c <= '9' || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F';
+    }
+
+    static boolean isOctal(char c) {
+        return c >= '0' && c <= '7';
+    }
+
+    /** unescapeJava per the Javadoc and the Java literal grammar: octal escapes (1..3 digits, 3 only
+     * when the first is 0..3), \\u+ escapes with any number of u's and an optional +, the named
+     * controls and quotes; a backslash before anything else is dropped. Null when a \\u escape is
+     * malformed (the library throws there; the test skips those). */
+    static String modelUnescapeJava(String t) {
+        StringBuilder out = new StringBuilder();
+        int i = 0;
+        int len = t.length();
+        while (i < len) {
+            char c = t.charAt(i);
+            if (c != '\\' || i + 1 == len) {
+                if (c != '\\') {
+                    out.append(c);
+                }
+                i++;
+                continue;
+            }
+            char d = t.charAt(i + 1);
+            if (d == 'u') {
+                int j = i + 1;
+                while (j < len && t.charAt(j) == 'u') {
+                    j++;
+                }
+                if (j < len && t.charAt(j) == '+') {
+                    j++;
+                }
+                if (j + 4 > len) {
+                    return null;
+                }
+                for (int k = j; k < j + 4; k++) {
+                    if (!isHex(t.charAt(k))) {
+                        return null;
+                    }
+                }
+                out.append((char) Integer.parseInt(t.substring(j, j + 4), 16));
+                i = j + 4;
+            } else if (isOctal(d)) {
+                int max = d <= '3' ? 3 : 2;
+                int j = i + 1;
+                while (j < len && j - (i + 1) < max && isOctal(t.charAt(j))) {
+                    j++;
+                }
+                out.append((char) Integer.parseInt(t.substring(i + 1, j), 8));
+                i = j;
+            } else {
+                switch (d) {
+                    case 'b' -> out.append('\b');
+                    case 'n' -> out.append('\n');
+                    case 't' -> out.append('\t');
+                    case 'f' -> out.append('\f');
+                    case 'r' -> out.append('\r');
+                    case '"', '\'', '\\' -> out.append(d);
+                    default -> {
+                        i++; // the backslash alone is dropped; d is processed on its own
+                        continue;
+                    }
+                }
+                i += 2;
+            }
+        }
+        return out.toString();
+    }
