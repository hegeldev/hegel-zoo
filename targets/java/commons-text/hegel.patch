+    // ------------------------------------------------------------------ 2. the Java literal grammar
+
+    static boolean isHex(char c) {
+        return c >= '0' && c <= '9' || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F';
+    }
+
+    static boolean isOctal(char c) {
+        return c >= '0' && c <= '7';
+    }
+
+    /** unescapeJava per the Javadoc and the Java literal grammar: octal escapes (1..3 digits, 3 only
+     * when the first is 0..3), \\u+ escapes with any number of u's and an optional +, the named
+     * controls and quotes; a backslash before anything else is dropped. Null when a \\u escape is
+     * malformed (the library throws there; the test skips those). */
+    static String modelUnescapeJava(String t) {
+        StringBuilder out = new StringBuilder();
+        int i = 0;
+        int len = t.length();
+        while (i < len) {
+            char c = t.charAt(i);
+            if (c != '\\' || i + 1 == len) {
+                if (c != '\\') {
+                    out.append(c);
+                }
+                i++;
+                continue;
+            }
+            char d = t.charAt(i + 1);
+            if (d == 'u') {
+                int j = i + 1;
+                while (j < len && t.charAt(j) == 'u') {
+                    j++;
+                }
+                if (j < len && t.charAt(j) == '+') {
+                    j++;
+                }
+                if (j + 4 > len) {
+                    return null;
+                }
+                for (int k = j; k < j + 4; k++) {
+                    if (!isHex(t.charAt(k))) {
+                        return null;
+                    }
+                }
+                out.append((char) Integer.parseInt(t.substring(j, j + 4), 16));
+                i = j + 4;
+            } else if (isOctal(d)) {
+                int max = d <= '3' ? 3 : 2;
+                int j = i + 1;
+                while (j < len && j - (i + 1) < max && isOctal(t.charAt(j))) {
+                    j++;
+                }
+                out.append((char) Integer.parseInt(t.substring(i + 1, j), 8));
+                i = j;
+            } else {
+                switch (d) {
+                    case 'b' -> out.append('\b');
+                    case 'n' -> out.append('\n');
+                    case 't' -> out.append('\t');
+                    case 'f' -> out.append('\f');
+                    case 'r' -> out.append('\r');
+                    case '"', '\'', '\\' -> out.append(d);
+                    default -> {
+                        i++; // the backslash alone is dropped; d is processed on its own
+                        continue;
+                    }
+                }
+                i += 2;
+            }
+        }
+        return out.toString();
+    }
+
+    /** The code of a unicode escape: ASCII, any BMP unit, or a surrogate. */
+    static final Generator<Integer> ESCAPE_CODE = weighted(w(1, ints(0, 0x7f)), w(1, ints(0, 0xffff)), w(1, ints(0xd800, 0xdfff)));
+
+    /**
+     * An item of an escape soup: text, a named (or unknown) escape, an octal escape, a unicode escape with one to
+     * three u's and a plus one time in five, a plain unicode escape, a lone backslash (which may end the string or
+     * combine with the next item), bare octal digits, a possibly malformed unicode escape, a fixed oddity.
+     */
+    static final Generator<String> SOUP_ITEM = weighted(
+        w(1, word("abcxyz 019AF\"'/", 1, 4)),
+        w(1, sampledFrom("b", "n", "t", "f", "r", "\"", "'", "\\", "q", "x", "8", "9", " ").map(c -> "\\" + c)),
+        w(1, word("01234567", 1, 3).map(o -> "\\" + o)),
+        w(1, tuples(ints(1, 3), chance(20), ESCAPE_CODE)
+            .map(t -> "\\" + "u".repeat(t.value1()) + (t.value2() ? "+" : "") + hex4(t.value3()).toLowerCase(Locale.ROOT))),
+        w(1, ints(0, 0xffff).map(c -> "\\u" + hex4(c))),
+        w(1, just("\\")),
+        w(1, word("01234567", 1, 2)),
+        w(1, word("0123456789abcdefg", 0, 3).map(h -> "\\u" + h)),
+        w(2, sampledFrom("u", "+", "0", "\\\\", "\\0", "\\377", "\\400", "\\uD83D\\uDE00")));
+
+    /** A soup of up to twelve items. */
+    static final Generator<String> SOUP = lists(SOUP_ITEM).maxSize(12).map(Gen::join);
+
+    @Test
+    void javaUnescapeFollowsTheLiteralGrammar() {
+        Hegel.test(tc -> {
+            String t = tc.draw(SOUP, "soup");
+            String want = modelUnescapeJava(t);
+            if (want == null) {
+                // a malformed \\u escape: the library throws IllegalArgumentException
+                try {
+                    String got = StringEscapeUtils.unescapeJava(t);
+                    fail("unescapeJava accepted a malformed unicode escape " + show(t) + " -> " + show(got));
+                } catch (IllegalArgumentException expected) {
+                    // documented on UnicodeUnescaper
+                }
+                return;
+            }
+            eq("unescapeJava", StringEscapeUtils.unescapeJava(t), want, t);
+            eq("unescapeEcmaScript", StringEscapeUtils.unescapeEcmaScript(t), want, t);
+            eq("unescapeJson", StringEscapeUtils.unescapeJson(t), want, t);
+            // and what the escapers write is a fixed point of the grammar
+            eq("unescapeJava(escapeJava(unescaped))", StringEscapeUtils.unescapeJava(StringEscapeUtils.escapeJava(want)), want, t);
+        }, Zoo.settings("javaUnescapeFollowsTheLiteralGrammar"));
+    }
