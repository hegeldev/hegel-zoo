+    static final Generator<SimilarityCase> SIMILARITY_CASE = tuples(SIMILARITY_WORD, OTHER, ints(0, 6)).map(t -> new SimilarityCase(t.value1(), t.value2(), t.value3()));
+
+    static final class Replay implements CommandVisitor<Character> {
+        final StringBuilder left = new StringBuilder();
+        final StringBuilder right = new StringBuilder();
+        int keeps;
+        int inserts;
+        int deletes;
+        char last = 'k';
+
+        @Override
+        public void visitInsertCommand(Character c) {
+            right.append(c);
+            inserts++;
+            last = 'i';
+        }
+
+        @Override
+        public void visitKeepCommand(Character c) {
+            left.append(c);
+            right.append(c);
+            keeps++;
+            last = 'k';
+        }
+
+        @Override
+        public void visitDeleteCommand(Character c) {
+            left.append(c);
+            deletes++;
+            last = 'd';
+        }
+    }
