+    /** An edit of the first string; its position is taken modulo the live length when applied. */
+    sealed interface Edit permits Delete, Insert, Replace, Swap {
+        int at();
+    }
+
+    record Delete(int at) implements Edit {}
+
+    record Insert(int at, char c) implements Edit {}
+
+    record Replace(int at, char c) implements Edit {}
+
+    /** Swap the character with the next. */
+    record Swap(int at) implements Edit {}
+
+    static final Generator<Integer> POSITION = ints(0, 99);
+
+    static final Generator<Edit> EDIT = weighted(
+        w(1, POSITION.<Edit>map(Delete::new)),
+        w(1, tuples(POSITION, sampledFrom('a', 'b', 'z', ' ')).<Edit>map(t -> new Insert(t.value1(), t.value2()))),
+        w(1, tuples(POSITION, sampledFrom('a', 'b', 'z', 'A')).<Edit>map(t -> new Replace(t.value1(), t.value2()))),
+        w(1, POSITION.<Edit>map(Swap::new)));
+
+    /** The second string: an independent word (30%), or the first with up to three edits. */
+    sealed interface Other permits Fresh, Edited {}
+
+    record Fresh(String s) implements Other {}
+
+    record Edited(List<Edit> edits) implements Other {}
+
+    static final Generator<Other> OTHER = weighted(
+        w(30, SIMILARITY_WORD.<Other>map(Fresh::new)),
+        w(70, lists(EDIT).maxSize(3).<Other>map(Edited::new)));
+
+    /** The second string from the first: the edits applied in turn while there is text left. */
+    static String other(String base, Other other) {
+        if (other instanceof Fresh f) {
+            return f.s();
+        }
+        StringBuilder sb = new StringBuilder(base);
+        for (Edit e : ((Edited) other).edits()) {
+            if (sb.length() == 0) {
+                break;
+            }
+            int at = e.at() % sb.length();
+            switch (e) {
+                case Delete d -> sb.deleteCharAt(at);
+                case Insert i -> sb.insert(at, i.c());
+                case Replace r -> sb.setCharAt(at, r.c());
+                case Swap s -> {
+                    if (at + 1 < sb.length()) {
+                        char c = sb.charAt(at);
+                        sb.setCharAt(at, sb.charAt(at + 1));
+                        sb.setCharAt(at + 1, c);
+                    }
+                }
+            }
+        }
+        return sb.toString();
+    }
