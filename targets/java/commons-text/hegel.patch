+    // ------------------------------------------------------------------ 3. entities
+
+    static final List<String> HTML_EXTENDED_NAMES = new ArrayList<>();
+    static final List<String> ISO_NAMES = new ArrayList<>();
+    static {
+        for (CharSequence k : EntityArrays.HTML40_EXTENDED_UNESCAPE.keySet()) {
+            HTML_EXTENDED_NAMES.add(k.toString());
+        }
+        for (CharSequence k : EntityArrays.ISO8859_1_UNESCAPE.keySet()) {
+            ISO_NAMES.add(k.toString());
+        }
+        HTML_EXTENDED_NAMES.sort(null);
+        ISO_NAMES.sort(null);
+    }
+
+    /** A text of plain runs and entities (or one such piece), and what each unescaper must make of it. */
+    record EntityText(String text, String html4, String html3, String xml) {
+        /** A piece every unescaper leaves alone. */
+        static EntityText same(String piece) {
+            return new EntityText(piece, piece, piece, piece);
+        }
+
+        /** A piece every unescaper decodes to {@code value}. */
+        static EntityText all(String piece, String value) {
+            return new EntityText(piece, value, value, value);
+        }
+
+        static EntityText concat(List<EntityText> pieces) {
+            StringBuilder t = new StringBuilder();
+            StringBuilder h4 = new StringBuilder();
+            StringBuilder h3 = new StringBuilder();
+            StringBuilder x = new StringBuilder();
+            for (EntityText p : pieces) {
+                t.append(p.text());
+                h4.append(p.html4());
+                h3.append(p.html3());
+                x.append(p.xml());
+            }
+            return new EntityText(t.toString(), h4.toString(), h3.toString(), x.toString());
+        }
+    }
+
+    /** A plain run without ';' (one would complete a semicolon-less entity before it); a bare & that starts no known entity stays. */
+    static final Generator<EntityText> PLAIN_RUN = tuples(word("abc xyz#0123 &", 1, 5), chance(50)).map(t -> {
+        String piece = t.value1().replace("&", t.value2() ? "&&" : "&");
+        if (piece.contains("&") && (piece.matches(".*&#.*") || piece.matches(".*&[a-zA-Z]+;.*"))) {
+            piece = piece.replace("&", "+");
+        }
+        return EntityText.same(piece);
+    });
+
+    static final Generator<Integer> CODE_POINT = weighted(w(1, ints(1, 0x7f)), w(1, ints(0x80, 0xffff)), w(1, ints(0x10000, 0x10ffff)), w(1, just(0)));
+
+    /** A numeric entity: decimal, or hexadecimal (upper-cased half the time, x or X), with one to three leading zeros one time in five. */
+    static final Generator<EntityText> NUMERIC = tuples(CODE_POINT, chance(50), chance(50), sampledFrom("x", "X"), maybe(20, "", ints(1, 3).map(n -> "0".repeat(n)))).map(t -> {
+        int cp = t.value1();
+        boolean hex = t.value2();
+        String digits = hex ? (t.value3() ? Integer.toHexString(cp).toUpperCase(Locale.ROOT) : Integer.toHexString(cp)) : Integer.toString(cp);
+        return EntityText.all("&#" + (hex ? t.value4() : "") + t.value5() + digits + ";", new String(Character.toChars(cp)));
+    });
+
+    /** Without the semicolon the default unescaper leaves it alone. */
+    static final Generator<EntityText> UNTERMINATED = tuples(chance(50), ints(1, 0xffff))
+        .map(t -> EntityText.same("&#" + (t.value1() ? "x" + Integer.toHexString(t.value2()) : Integer.toString(t.value2()))));
+
+    /** Out of range or empty: left alone. */
+    static final Generator<EntityText> OUT_OF_RANGE = sampledFrom("&#1114112;", "&#x110000;", "&#99999999999;", "&#;", "&#x;", "&#xg1;", "&#", "&#x").map(EntityText::same);
+
+    static final Generator<EntityText> BASIC = sampledFrom("&amp;", "&lt;", "&gt;", "&quot;").map(n -> EntityText.all(n, EntityArrays.BASIC_UNESCAPE.get(n).toString()));
+
+    static final Generator<EntityText> APOS = just(new EntityText("&apos;", "&apos;", "&apos;", "'"));
+
+    static final Generator<EntityText> ISO = sampledFrom(ISO_NAMES).map(n -> {
+        String v = EntityArrays.ISO8859_1_UNESCAPE.get(n).toString();
+        return new EntityText(n, v, v, n);
+    });
+
+    static final Generator<EntityText> EXTENDED = sampledFrom(HTML_EXTENDED_NAMES).map(n -> new EntityText(n, EntityArrays.HTML40_EXTENDED_UNESCAPE.get(n).toString(), n, n));
+
+    static final Generator<EntityText> UNKNOWN = sampledFrom("&zzzz;", "&Amp;", "&amp", "&AMP;", "&nbsp", "&;", "& ", "&").map(EntityText::same);
+
+    /** A piece: a plain run or a numeric entity (two each in twelve), the basic names (two), the rest one each. */
+    static final Generator<EntityText> ENTITY_PIECE = weighted(
+        w(2, PLAIN_RUN), w(2, NUMERIC), w(1, UNTERMINATED), w(1, OUT_OF_RANGE), w(2, BASIC), w(1, APOS), w(1, ISO), w(1, EXTENDED), w(1, UNKNOWN));
+
+    /** Up to ten pieces. */
+    static final Generator<EntityText> ENTITY_TEXT = lists(ENTITY_PIECE).maxSize(10).map(EntityText::concat);
+
