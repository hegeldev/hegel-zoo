@@ -0,0 +1,1223 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.sets;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.maybe;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Gen.word;
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.show;
+
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import dev.hegel.Hegel;
+import java.io.IOException;
+import java.io.Reader;
+import java.io.StringReader;
+import java.io.UnsupportedEncodingException;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.math.MathContext;
+import java.math.RoundingMode;
+import java.text.MessageFormat;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Formattable;
+import java.util.Formatter;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.function.DoubleFunction;
+import org.apache.commons.text.AlphabetConverter;
+import org.apache.commons.text.CharacterPredicate;
+import org.apache.commons.text.CharacterPredicates;
+import org.apache.commons.text.ExtendedMessageFormat;
+import org.apache.commons.text.FormatFactory;
+import org.apache.commons.text.FormattableUtils;
+import org.apache.commons.text.RandomStringGenerator;
+import org.apache.commons.text.StringTokenizer;
+import org.apache.commons.text.TextStringBuilder;
+import org.apache.commons.text.matcher.StringMatcherFactory;
+import org.apache.commons.text.numbers.DoubleFormat;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: Apache Commons Text's DoubleFormat, TextStringBuilder, StringTokenizer,
+ * AlphabetConverter, RandomStringGenerator, FormattableUtils and ExtendedMessageFormat against
+ * their documented contracts (round trips, BigDecimal rounding, java.lang.StringBuilder as the model).
+ */
+class CommonsTextMoreTest {
+
+    // ------------------------------------------------------------------ 1. DoubleFormat
+
+    static final Generator<Double> NOTABLE = sampledFrom(0.0, -0.0, Double.MIN_VALUE, -Double.MIN_VALUE, Double.MIN_NORMAL, Double.MAX_VALUE, -Double.MAX_VALUE,
+        1.0, -1.0, 0.5, 999.5, 1000.0, 0.001, 0.0099, 0.01, 1e6, 1e7, 9999999.0, 123456789.0, 1e-3, 1e-4, 0.125, 0.135, 2.5, 3.5);
+
+    /** A short decimal: up to six digits and a decimal exponent, negated half the time. */
+    static final Generator<Double> SHORT_DECIMAL = tuples(ints(0, 999999), ints(-12, 12), chance(50)).map(t -> {
+        double d = Double.parseDouble(t.value1() + "E" + t.value2());
+        return t.value3() ? -d : d;
+    });
+
+    /** A double: any (half the time), a short decimal (two in ten), a multiple of an eighth, a notable value, random bits. */
+    static final Generator<Double> ANY_DOUBLE = weighted(
+        w(5, Generators.doubles()),
+        w(2, SHORT_DECIMAL),
+        w(1, ints(-100000, 100000).map(i -> i / 8.0)),
+        w(1, NOTABLE),
+        w(1, Generators.longs().map(Double::longBitsToDouble)));
+
+    static final Generator<DoubleFormat> TYPE = sampledFrom(DoubleFormat.PLAIN, DoubleFormat.SCIENTIFIC, DoubleFormat.ENGINEERING, DoubleFormat.MIXED);
+
+    /** A value, a format type, a maxPrecision, a minDecimalExponent and MIXED's plain-format exponent bounds. */
+    record FormatCase(double d, DoubleFormat type, int precision, int minExp, int lo, int hi) {}
+
+    static final Generator<FormatCase> FORMAT_CASE = tuples(ANY_DOUBLE, TYPE, ints(1, 18), ints(-8, 8), ints(-6, 0), ints(0, 8))
+        .map(t -> new FormatCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+
+    /** The scientific exponent of d's shortest decimal representation (the position of its first significant digit). */
+    static int sciExponent(BigDecimal v) {
+        return v.precision() - v.scale() - 1;
+    }
+
+    static BigDecimal exact(String out) {
+        return new BigDecimal(out.replace(",", ""));
+    }
+
+    @Test
+    void doubleFormatRoundTripsAndRoundsHalfEven() {
+        Hegel.test(tc -> {
+            FormatCase c = tc.draw(FORMAT_CASE, "case");
+            double d = c.d();
+            DoubleFormat type = c.type();
+            String ctx = " for " + type + " of " + d + " (" + Double.toString(d) + ")";
+            DoubleFunction<String> dflt = type.builder().get();
+            String out = dflt.apply(d);
+            if (Double.isNaN(d)) {
+                check(out.equals("NaN"), () -> "NaN formats as " + show(out));
+                return;
+            }
+            if (Double.isInfinite(d)) {
+                check(out.equals(d > 0 ? "Infinity" : "-Infinity"), () -> "infinity formats as " + show(out));
+                return;
+            }
+            // 1. the documented round trip with the default (unlimited) precision
+            double back = Double.parseDouble(out);
+            check(Double.compare(back, d) == 0 || back == d && d == 0.0, () -> "Double.parseDouble(" + show(out) + ") = " + back + ctx);
+            check(out.startsWith("-") == (Double.doubleToRawLongBits(d) < 0), () -> "sign of " + show(out) + ctx);
+            // 2. the layout of each type
+            BigDecimal v = new BigDecimal(Double.toString(Math.abs(d)));
+            String digits = out.startsWith("-") ? out.substring(1) : out;
+            int ePos = digits.indexOf('E');
+            String mantissa = ePos < 0 ? digits : digits.substring(0, ePos);
+            String exponent = ePos < 0 ? null : digits.substring(ePos + 1);
+            check(mantissa.matches("[0-9]+\\.[0-9]+"), () -> "mantissa " + show(mantissa) + " of " + show(out) + ctx);
+            check(exponent == null || exponent.matches("-?[1-9][0-9]*|0"), () -> "exponent " + show(exponent) + " of " + show(out) + ctx);
+            int intDigits = mantissa.indexOf('.');
+            int sciExp = d == 0 ? 0 : sciExponent(v.stripTrailingZeros());
+            switch (type) {
+                case PLAIN -> check(exponent == null, () -> "PLAIN has an exponent: " + show(out) + ctx);
+                case SCIENTIFIC -> check((exponent != null || sciExp == 0) && (exponent == null || Integer.parseInt(exponent) == sciExp)
+                    && intDigits == 1 && (d == 0 || mantissa.charAt(0) != '0'),
+                    () -> "SCIENTIFIC layout " + show(out) + " for scientific exponent " + sciExp + ctx);
+                case ENGINEERING -> check((exponent != null || Math.floorDiv(sciExp, 3) == 0) && (exponent == null || Integer.parseInt(exponent) == Math.floorDiv(sciExp, 3) * 3)
+                    && intDigits >= 1 && intDigits <= 3 && (d == 0 || mantissa.charAt(0) != '0'),
+                    () -> "ENGINEERING layout " + show(out) + " for scientific exponent " + sciExp + ctx);
+                case MIXED -> check(exponent == null == (sciExp >= -3 && sciExp <= 6), () -> "MIXED chose " + show(out) + " for scientific exponent " + sciExp + ctx);
+            }
+            // 3. maxPrecision rounds half-even to that many significant digits
+            int precision = c.precision();
+            String rounded = type.builder().maxPrecision(precision).get().apply(d);
+            BigDecimal wantRounded = new BigDecimal(Double.toString(d)).round(new MathContext(precision, RoundingMode.HALF_EVEN));
+            check(exact(rounded).compareTo(wantRounded) == 0, () -> "maxPrecision(" + precision + ") gave " + show(rounded) + ", want " + wantRounded.toPlainString() + ctx);
+            check(exact(rounded).precision() <= precision || exact(rounded).stripTrailingZeros().precision() <= precision,
+                () -> "maxPrecision(" + precision + ") gave " + show(rounded) + " with more significant digits" + ctx);
+            // 4. minDecimalExponent rounds half-even to that decimal place
+            int minExp = c.minExp();
+            // bug commons-text/12: a value that is a single digit 5 (0.5, 5, 0.05, 50, ...) rounded at the position
+            // just above it (minDecimalExponent(0) of 0.5) throws ArrayIndexOutOfBoundsException; pinned, skipped here
+            BigDecimal stripped = v.stripTrailingZeros();
+            tc.assume(!(d != 0 && stripped.unscaledValue().abs().equals(BigInteger.valueOf(5)) && minExp == sciExp + 1));
+            String cut;
+            try {
+                cut = type.builder().minDecimalExponent(minExp).get().apply(d);
+            } catch (RuntimeException e) {
+                fail("minDecimalExponent(" + minExp + ") threw " + e + ctx);
+                return;
+            }
+            BigDecimal wantCut = new BigDecimal(Double.toString(d)).setScale(-minExp, RoundingMode.HALF_EVEN);
+            check(exact(cut).compareTo(wantCut) == 0, () -> "minDecimalExponent(" + minExp + ") gave " + show(cut) + ", want " + wantCut.toPlainString() + ctx);
+            check(exact(cut).signum() == 0 || exact(cut).stripTrailingZeros().scale() <= -minExp,
+                () -> "minDecimalExponent(" + minExp + ") gave " + show(cut) + " with digits below 10^" + minExp + ctx);
+            // 5. the switches
+            String noPlaceholder = type.builder().includeFractionPlaceholder(false).get().apply(d);
+            check(exact(noPlaceholder).compareTo(new BigDecimal(Double.toString(d))) == 0 && !noPlaceholder.contains(".0E") && !noPlaceholder.endsWith(".0"),
+                () -> "includeFractionPlaceholder(false) gave " + show(noPlaceholder) + ctx);
+            String unsigned = type.builder().allowSignedZero(false).minDecimalExponent(minExp).get().apply(d);
+            check(!(unsigned.startsWith("-") && exact(unsigned).signum() == 0), () -> "allowSignedZero(false) gave " + show(unsigned) + ctx);
+            if (type == DoubleFormat.SCIENTIFIC || type == DoubleFormat.ENGINEERING) {
+                String withExp = type.builder().alwaysIncludeExponent(true).get().apply(d);
+                check(withExp.contains("E") && Double.parseDouble(withExp) == d, () -> "alwaysIncludeExponent gave " + show(withExp) + ctx);
+            }
+            if (type == DoubleFormat.PLAIN) {
+                String grouped = type.builder().groupThousands(true).get().apply(d);
+                String intPart = grouped.substring(grouped.startsWith("-") ? 1 : 0, grouped.indexOf('.'));
+                check(intPart.matches("[0-9]{1,3}(,[0-9]{3})*") && grouped.replace(",", "").equals(out),
+                    () -> "groupThousands gave " + show(grouped) + " vs " + show(out) + ctx);
+            }
+            // 6. custom symbols map one-to-one onto the default output
+            String custom = type.builder().digits("abcdefghij").decimalSeparator(',').minusSign('_').exponentSeparator("x").get().apply(d);
+            StringBuilder mapped = new StringBuilder();
+            for (char ch : custom.toCharArray()) {
+                if (ch >= 'a' && ch <= 'j') {
+                    mapped.append((char) ('0' + ch - 'a'));
+                } else if (ch == ',') {
+                    mapped.append('.');
+                } else if (ch == '_') {
+                    mapped.append('-');
+                } else if (ch == 'x') {
+                    mapped.append('E');
+                } else {
+                    mapped.append(ch);
+                }
+            }
+            check(mapped.toString().equals(out), () -> "custom symbols gave " + show(custom) + " = " + show(mapped.toString()) + ", default " + show(out) + ctx);
+            // 7. MIXED thresholds after rounding
+            if (type == DoubleFormat.MIXED) {
+                int lo = c.lo();
+                int hi = c.hi();
+                String mixed = DoubleFormat.MIXED.builder().plainFormatMinDecimalExponent(lo).plainFormatMaxDecimalExponent(hi).maxPrecision(precision).get().apply(d);
+                BigDecimal mv = wantRounded.abs().stripTrailingZeros();
+                int mExp = mv.signum() == 0 ? 0 : sciExponent(mv);
+                check(mixed.contains("E") != (mExp >= lo && mExp <= hi), () -> "MIXED[" + lo + ", " + hi + "] with maxPrecision " + precision + " gave " + show(mixed) + " for rounded exponent " + mExp + ctx);
+            }
+        }, Zoo.settings("doubleFormatRoundTripsAndRoundsHalfEven"));
+    }
+
+    // ------------------------------------------------------------------ 2. TextStringBuilder
+
+    /** A piece of text: letters, spaces, a tab, a Latin-1 letter and the two halves of an emoji. */
+    static final Generator<String> PIECE = word("abcAB \t\u00e9\ud83d\ude00", 0, 6);
+
+    /** A position or a length, taken modulo the live size when the operation is applied. */
+    static final Generator<Integer> POS = ints(0, 99);
+
+    /** An operation on the builder and its model; positions are taken modulo the live length. */
+    sealed interface Op permits Append, Insert, Delete, DeleteAll, ReplaceAll, ReplaceFirst, Reverse, Trim, SetLength, PadLeft, PadRight,
+        Separator, WithSeparators, Appendln, Padding, ReadFrom, SetText, Replace, DeleteCharAt, NewLineAndAll, Capacity, AsWriter, AppendChars {}
+
+    record Append(String s) implements Op {}
+
+    record Insert(int at, String s) implements Op {}
+
+    /** delete(i, j) with i = from modulo the length plus one and j = i + to modulo what remains. */
+    record Delete(int from, int to) implements Op {}
+
+    record DeleteAll(char c) implements Op {}
+
+    record ReplaceAll(String search, String rep) implements Op {}
+
+    record ReplaceFirst(String search, String rep) implements Op {}
+
+    record Reverse() implements Op {}
+
+    record Trim() implements Op {}
+
+    /** setLength to the draw modulo the length plus four. */
+    record SetLength(int len) implements Op {}
+
+    /** appendFixedWidthPadLeft of the string (null one time in five). */
+    record PadLeft(String s, int width, char pad) implements Op {}
+
+    record PadRight(String s, int width, char pad) implements Op {}
+
+    record Separator(String sep) implements Op {}
+
+    /** appendWithSeparators of up to three items (null one in four, else a string or the number 7) and a separator (null 30%). */
+    record WithSeparators(List<Object> items, String sep) implements Op {}
+
+    record Appendln(String s) implements Op {}
+
+    record Padding(int count) implements Op {}
+
+    record ReadFrom(String s) implements Op {}
+
+    record SetText(String s) implements Op {}
+
+    record Replace(int from, int to, String s) implements Op {}
+
+    /** deleteCharAt at the position (the last one when it is the length), then insert 'q' there. */
+    record DeleteCharAt(int at) implements Op {}
+
+    record NewLineAndAll() implements Op {}
+
+    record Capacity(int n) implements Op {}
+
+    record AsWriter(String s) implements Op {}
+
+    /** append(char[], off, count) from the doubled string. */
+    record AppendChars(String s, int off, int count) implements Op {}
+
+    static final Generator<Op> OP = weighted(
+        w(2, PIECE.<Op>map(Append::new)),
+        w(1, tuples(POS, PIECE).<Op>map(t -> new Insert(t.value1(), t.value2()))),
+        w(1, tuples(POS, POS).<Op>map(t -> new Delete(t.value1(), t.value2()))),
+        w(1, sampledFrom('a', 'b', ' ', 'A').<Op>map(DeleteAll::new)),
+        w(1, tuples(sampledFrom("a", "ab", "b", " ", "aa", "ba"), sampledFrom("", "x", "ba", "aab", "b")).<Op>map(t -> new ReplaceAll(t.value1(), t.value2()))),
+        w(1, tuples(sampledFrom("a", "ab", "b", " "), sampledFrom("", "x", "ba")).<Op>map(t -> new ReplaceFirst(t.value1(), t.value2()))),
+        w(1, Generators.<Op>just(new Reverse())),
+        w(1, Generators.<Op>just(new Trim())),
+        w(1, POS.<Op>map(SetLength::new)),
+        w(1, tuples(maybe(80, (String) null, PIECE), ints(-1, 6), sampledFrom('.', '0')).<Op>map(t -> new PadLeft(t.value1(), t.value2(), t.value3()))),
+        w(1, tuples(PIECE, ints(-1, 6), sampledFrom('.', '0')).<Op>map(t -> new PadRight(t.value1(), t.value2(), t.value3()))),
+        w(1, sampledFrom(", ", "|", "").<Op>map(Separator::new)),
+        w(1, tuples(lists(maybe(75, (Object) null, Generators.<Object>sampledFrom("x", "yy", 7))).maxSize(3), maybe(70, (String) null, sampledFrom(", ", "|")))
+            .<Op>map(t -> new WithSeparators(t.value1(), t.value2()))),
+        w(1, PIECE.<Op>map(Appendln::new)),
+        w(1, ints(0, 8).<Op>map(Padding::new)),
+        w(1, PIECE.<Op>map(ReadFrom::new)),
+        w(1, PIECE.<Op>map(SetText::new)),
+        w(1, tuples(POS, POS, PIECE).<Op>map(t -> new Replace(t.value1(), t.value2(), t.value3()))),
+        w(1, POS.<Op>map(DeleteCharAt::new)),
+        w(1, Generators.<Op>just(new NewLineAndAll())),
+        w(1, ints(-1, 100).<Op>map(Capacity::new)),
+        w(1, PIECE.<Op>map(AsWriter::new)),
+        w(1, tuples(PIECE, POS, ints(0, 4)).<Op>map(t -> new AppendChars(t.value1(), t.value2(), t.value3()))));
+
+    /** Applies the operation to the builder and to its model. */
+    static void apply(Op op, TextStringBuilder t, StringBuilder m) throws IOException {
+        int len = m.length();
+        switch (op) {
+            case Append a -> {
+                t.append(a.s());
+                m.append(a.s());
+            }
+            case Insert x -> {
+                int i = x.at() % (len + 1);
+                t.insert(i, x.s());
+                m.insert(i, x.s());
+            }
+            case Delete x -> {
+                int i = x.from() % (len + 1);
+                int j = i + x.to() % (len - i + 1);
+                t.delete(i, j);
+                m.delete(i, j);
+            }
+            case DeleteAll x -> {
+                t.deleteAll(x.c());
+                String r = m.toString().replace(String.valueOf(x.c()), "");
+                m.setLength(0);
+                m.append(r);
+            }
+            case ReplaceAll x -> {
+                t.replaceAll(x.search(), x.rep());
+                String r = m.toString().replace(x.search(), x.rep());
+                m.setLength(0);
+                m.append(r);
+            }
+            case ReplaceFirst x -> {
+                t.replaceFirst(x.search(), x.rep());
+                int at = m.indexOf(x.search());
+                if (at >= 0) {
+                    m.replace(at, at + x.search().length(), x.rep());
+                }
+            }
+            case Reverse x -> {
+                t.reverse();
+                m.reverse();
+            }
+            case Trim x -> {
+                t.trim();
+                String r = m.toString().trim();
+                m.setLength(0);
+                m.append(r);
+            }
+            case SetLength x -> {
+                int newLen = x.len() % (len + 4);
+                t.setLength(newLen);
+                m.setLength(newLen);
+            }
+            case PadLeft x -> {
+                t.appendFixedWidthPadLeft(x.s(), x.width(), x.pad());
+                if (x.width() > 0) {
+                    String str = x.s() == null ? "" : x.s();
+                    m.append(str.length() >= x.width() ? str.substring(str.length() - x.width()) : String.valueOf(x.pad()).repeat(x.width() - str.length()) + str);
+                }
+            }
+            case PadRight x -> {
+                t.appendFixedWidthPadRight(x.s(), x.width(), x.pad());
+                if (x.width() > 0) {
+                    m.append(x.s().length() >= x.width() ? x.s().substring(0, x.width()) : x.s() + String.valueOf(x.pad()).repeat(x.width() - x.s().length()));
+                }
+            }
+            case Separator x -> {
+                t.appendSeparator(x.sep());
+                if (len > 0) {
+                    m.append(x.sep());
+                }
+            }
+            case WithSeparators x -> {
+                Object[] items = x.items().toArray();
+                t.appendWithSeparators(items, x.sep());
+                for (int k = 0; k < items.length; k++) {
+                    if (k > 0 && x.sep() != null) {
+                        m.append(x.sep());
+                    }
+                    m.append(items[k] == null ? t.getNullText() == null ? "" : t.getNullText() : String.valueOf(items[k]));
+                }
+            }
+            case Appendln x -> {
+                t.appendln(x.s());
+                m.append(x.s()).append(System.lineSeparator());
+            }
+            case Padding x -> {
+                t.appendPadding(x.count(), '*');
+                m.append("*".repeat(x.count()));
+            }
+            case ReadFrom x -> {
+                int got = t.readFrom(new StringReader(x.s()));
+                check(got == (x.s().isEmpty() ? -1 : x.s().length()), () -> "readFrom returned " + got + " for " + show(x.s()));
+                m.append(x.s());
+            }
+            case SetText x -> {
+                t.set(x.s());
+                m.setLength(0);
+                m.append(x.s());
+            }
+            case Replace x -> {
+                int i = x.from() % (len + 1);
+                int j = i + x.to() % (len - i + 1);
+                t.replace(i, j, x.s());
+                m.replace(i, j, x.s());
+            }
+            case DeleteCharAt x -> {
+                int i = x.at() % (len + 1);
+                if (len > 0) {
+                    t.deleteCharAt(i == len ? len - 1 : i);
+                    m.deleteCharAt(i == len ? len - 1 : i);
+                }
+                t.insert(Math.min(i, m.length()), 'q');
+                m.insert(Math.min(i, m.length()), 'q');
+            }
+            case NewLineAndAll x -> {
+                t.appendNewLine();
+                m.append(System.lineSeparator());
+                t.appendAll("u", "v");
+                m.append("u").append("v");
+            }
+            case Capacity x -> {
+                t.minimizeCapacity();
+                t.ensureCapacity(x.n());
+            }
+            case AsWriter x -> {
+                t.asWriter().write(x.s());
+                m.append(x.s());
+            }
+            case AppendChars x -> {
+                char[] cs = (x.s() + x.s()).toCharArray();
+                int off = Math.min(x.off() % (len + 1), cs.length);
+                int cnt = Math.min(x.count(), cs.length - off);
+                t.append(cs, off, cnt);
+                m.append(cs, off, cnt);
+            }
+        }
+    }
+
+    /**
+     * A builder (with an initial capacity half the time), up to 25 operations, and the queries after them: a needle,
+     * two indices (taken modulo the length plus five, from -2), the read sizes that drain asReader (cycled), a
+     * position for charAt (modulo the length).
+     */
+    record BuilderCase(Integer capacity, List<Op> ops, String needle, int i, int k, List<Integer> reads, int at) {}
+
+    static final Generator<BuilderCase> BUILDER_CASE = tuples(
+            maybe(50, (Integer) null, ints(0, 40)), lists(OP).maxSize(25),
+            sampledFrom("a", "ab", "aa", " ", "zz", "\ud83d\ude00"), POS, POS,
+            lists(ints(1, 5)).minSize(1).maxSize(6), POS)
+        .map(t -> new BuilderCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    static String clip(String s, int from, int to) {
+        from = Math.max(0, Math.min(from, s.length()));
+        to = Math.max(from, Math.min(to, s.length()));
+        return s.substring(from, to);
+    }
+
+    @Test
+    void textStringBuilderTracksStringBuilder() {
+        Hegel.test(tc -> {
+            BuilderCase c = tc.draw(BUILDER_CASE, "case");
+            TextStringBuilder t = c.capacity() == null ? new TextStringBuilder() : new TextStringBuilder(c.capacity());
+            StringBuilder m = new StringBuilder();
+            List<Op> ops = c.ops();
+            for (int step = 0; step < ops.size(); step++) {
+                try {
+                    apply(ops.get(step), t, m);
+                } catch (IOException e) {
+                    fail(ops.get(step) + " threw " + e);
+                }
+                String got = t.toString();
+                String want = m.toString();
+                if (!got.equals(want)) {
+                    fail("TextStringBuilder " + show(got) + " vs StringBuilder " + show(want) + " after " + ops.subList(0, step + 1));
+                    return;
+                }
+            }
+            // queries
+            String want = m.toString();
+            String ctx = " on " + show(want);
+            check(t.length() == want.length() && t.size() == want.length() && t.isEmpty() == want.isEmpty(), () -> "length/size/isEmpty" + ctx);
+            check(t.hashCode() == want.hashCode(), () -> "hashCode " + t.hashCode() + " vs String " + want.hashCode() + ctx);
+            check(t.equals(new TextStringBuilder(want)) && t.equalsIgnoreCase(new TextStringBuilder(want.toUpperCase(Locale.ROOT)))
+                == want.equalsIgnoreCase(want.toUpperCase(Locale.ROOT)), () -> "equals/equalsIgnoreCase" + ctx);
+            int len = want.length();
+            int i = -2 + c.i() % (len + 5);
+            int k = -2 + c.k() % (len + 5);
+            check(t.leftString(i).equals(clip(want, 0, i)), () -> "leftString(" + i + ")" + ctx + " = " + show(t.leftString(i)));
+            check(t.rightString(i).equals(clip(want, len - i, len)), () -> "rightString(" + i + ")" + ctx + " = " + show(t.rightString(i)));
+            String mid = t.midString(i, k);
+            String wantMid = k <= 0 || i >= len ? "" : clip(want, Math.max(i, 0), Math.max(i, 0) + k);
+            check(mid.equals(wantMid), () -> "midString(" + i + ", " + k + ")" + ctx + " = " + show(mid) + ", want " + show(wantMid));
+            if (i >= 0 && i <= len) {
+                check(t.substring(i).equals(want.substring(i)), () -> "substring(" + i + ")" + ctx);
+                check(t.substring(i, Math.max(i, k)).equals(clip(want, i, Math.max(i, k))), () -> "substring(" + i + ", " + Math.max(i, k) + ")" + ctx);
+            }
+            // bug commons-text/5: indexOf("") is -1 at the end of the builder; the empty needle is pinned, not modelled
+            String needle = c.needle();
+            check(t.indexOf(needle) == want.indexOf(needle) && t.lastIndexOf(needle) == want.lastIndexOf(needle) && t.contains(needle) == want.contains(needle),
+                () -> "indexOf/lastIndexOf/contains(" + show(needle) + ")" + ctx + ": " + t.indexOf(needle) + "/" + t.lastIndexOf(needle) + "/" + t.contains(needle));
+            check(t.indexOf(needle, i) == want.indexOf(needle, Math.max(i, 0)), () -> "indexOf(" + show(needle) + ", " + i + ")" + ctx + " = " + t.indexOf(needle, i));
+            if (i <= len) {
+                int fromEnd = Math.min(i, len);
+                // bug commons-text/11: a needle of two or more chars matching exactly at the start index is missed
+                // ("abab".lastIndexOf("ab", 2) is 0); pinned, that shape is left out here
+                if (needle.length() == 1 || i < 0 || want.lastIndexOf(needle, fromEnd) != fromEnd) {
+                    check(t.lastIndexOf(needle, i) == (i < 0 ? -1 : want.lastIndexOf(needle, fromEnd)), () -> "lastIndexOf(" + show(needle) + ", " + i + ")" + ctx + " = " + t.lastIndexOf(needle, i) + ", want " + want.lastIndexOf(needle, fromEnd));
+                }
+            }
+            check(t.startsWith(needle) == want.startsWith(needle) && t.endsWith(needle) == want.endsWith(needle), () -> "startsWith/endsWith(" + show(needle) + ")" + ctx);
+            check(Arrays.equals(t.toCharArray(), want.toCharArray()) && t.toStringBuilder().toString().equals(want) && t.toStringBuffer().toString().equals(want)
+                && t.get().equals(want) && t.build().equals(want), () -> "toCharArray/toStringBuilder/toStringBuffer/get/build" + ctx);
+            check(new TextStringBuilder(want).reverse().toString().equals(new StringBuilder(want).reverse().toString()), () -> "reverse" + ctx);
+            check(t.indexOf(StringMatcherFactory.INSTANCE.charMatcher('a')) == want.indexOf('a'), () -> "indexOf(charMatcher)" + ctx);
+            try {
+                Reader r = t.asReader();
+                StringBuilder read = new StringBuilder();
+                char[] buf = new char[5];
+                int got;
+                for (int n = 0; (got = r.read(buf, 0, c.reads().get(n % c.reads().size()))) >= 0; n++) {
+                    read.append(buf, 0, got);
+                }
+                check(read.toString().equals(want), () -> "asReader read " + show(read.toString()) + ctx);
+            } catch (IOException e) {
+                fail("asReader threw " + e);
+            }
+            if (len > 0) {
+                int at = c.at() % len;
+                check(t.charAt(at) == want.charAt(at), () -> "charAt(" + at + ")" + ctx);
+            }
+            char[] target = new char[len + 2];
+            t.getChars(0, len, target, 1);
+            check(new String(target, 1, len).equals(want), () -> "getChars" + ctx);
+            // asTokenizer sees the content, and its tokens are the whitespace-separated words
+            List<String> tokens = t.asTokenizer().getTokenList();
+            List<String> wantTokens = new ArrayList<>(Arrays.asList(want.split("[ \t\n\r\f]+")));
+            wantTokens.removeIf(String::isEmpty);
+            check(tokens.equals(wantTokens), () -> "asTokenizer tokens " + tokens + ", want " + wantTokens + ctx);
+        }, Zoo.settings("textStringBuilderTracksStringBuilder"));
+    }
+
+    // ------------------------------------------------------------------ 3. StringTokenizer
+
+    /** The tokenizer under test: the CSV/TSV instance (trimmed, empty tokens kept) or a custom one. */
+    sealed interface Splitter permits CsvLike, Custom {
+        char delim();
+
+        char quote();
+
+        boolean csvTrim();
+
+        boolean ignoreEmpty();
+
+        boolean emptyAsNull();
+
+        StringTokenizer tokenizer(String text);
+
+        String describe();
+    }
+
+    record CsvLike(boolean csv) implements Splitter {
+        @Override
+        public char delim() {
+            return csv ? ',' : '\t';
+        }
+
+        @Override
+        public char quote() {
+            return '"';
+        }
+
+        @Override
+        public boolean csvTrim() {
+            return true;
+        }
+
+        @Override
+        public boolean ignoreEmpty() {
+            return false;
+        }
+
+        @Override
+        public boolean emptyAsNull() {
+            return false;
+        }
+
+        @Override
+        public StringTokenizer tokenizer(String text) {
+            return csv ? StringTokenizer.getCSVInstance(text) : StringTokenizer.getTSVInstance(text);
+        }
+
+        @Override
+        public String describe() {
+            return csv ? "CSV" : "TSV";
+        }
+    }
+
+    record Custom(char delim, char quote, boolean ignoreEmpty, boolean emptyAsNull) implements Splitter {
+        @Override
+        public boolean csvTrim() {
+            return false;
+        }
+
+        @Override
+        public StringTokenizer tokenizer(String text) {
+            return new StringTokenizer(text, delim, quote).setIgnoreEmptyTokens(ignoreEmpty).setEmptyTokenAsNull(emptyAsNull);
+        }
+
+        @Override
+        public String describe() {
+            return "tokenizer(" + delim + ", " + quote + ", ignoreEmpty " + ignoreEmpty + ", emptyAsNull " + emptyAsNull + ")";
+        }
+    }
+
+    static final Generator<Splitter> SPLITTER = weighted(
+        w(1, chance(50).<Splitter>map(CsvLike::new)),
+        w(2, tuples(sampledFrom(',', ';', '|', ' '), sampledFrom('"', '\''), chance(50), chance(50)).<Splitter>map(t -> new Custom(t.value1(), t.value2(), t.value3(), t.value4()))));
+
+    /**
+     * A field: its value (a word over letters, spaces, the delimiter, the quote and the halves of an emoji, or one
+     * of a few edge cases one time in five), whether it is quoted even when it need not be (30%), and the spaces
+     * before and after it (CSV/TSV only; one or two, 30% each).
+     */
+    record Field(String value, boolean quoted, int before, int after) {}
+
+    static Generator<Field> field(Splitter sp) {
+        Generator<String> value = weighted(
+            w(80, word("ab c" + sp.delim() + sp.quote() + "\ud83d\ude00", 0, 5)),
+            w(20, sampledFrom("", " ", "  ", "a b", " a", "a ")));
+        return tuples(value, chance(30), maybe(30, 0, ints(1, 2)), maybe(30, 0, ints(1, 2))).map(t -> new Field(t.value1(), t.value2(), t.value3(), t.value4()));
+    }
+
+    /** Fields joined by the delimiter and quoted (with doubled quotes) where they need it or ask for it. */
+    record TokenizerCase(Splitter splitter, List<Field> fields) {
+        String text() {
+            char delim = splitter.delim();
+            char quote = splitter.quote();
+            StringBuilder text = new StringBuilder();
+            for (int k = 0; k < fields.size(); k++) {
+                Field f = fields.get(k);
+                boolean needsQuote = f.value().indexOf(delim) >= 0 || f.value().indexOf(quote) >= 0 || splitter.csvTrim() && (f.value().startsWith(" ") || f.value().endsWith(" "));
+                if (k > 0) {
+                    text.append(delim);
+                }
+                if (splitter.csvTrim()) {
+                    text.append(" ".repeat(f.before()));
+                }
+                if (needsQuote || f.quoted()) {
+                    text.append(quote).append(f.value().replace(String.valueOf(quote), "" + quote + quote)).append(quote);
+                } else {
+                    text.append(f.value());
+                }
+                if (splitter.csvTrim()) {
+                    text.append(" ".repeat(f.after()));
+                }
+            }
+            return text.toString();
+        }
+
+        /** The tokens the text splits into: none for an empty text (not one empty token). */
+        List<String> tokens() {
+            List<String> tokens = new ArrayList<>();
+            if (text().isEmpty()) {
+                return tokens;
+            }
+            for (Field f : fields) {
+                if (f.value().isEmpty()) {
+                    if (!splitter.ignoreEmpty()) {
+                        tokens.add(splitter.emptyAsNull() ? null : "");
+                    }
+                } else {
+                    tokens.add(f.value());
+                }
+            }
+            return tokens;
+        }
+    }
+
+    static final Generator<TokenizerCase> TOKENIZER_CASE = SPLITTER.flatMap(sp -> lists(field(sp)).maxSize(6).map(fs -> new TokenizerCase(sp, fs)));
+
+    @Test
+    void stringTokenizerSplitsWhatItsGrammarJoins() {
+        Hegel.test(tc -> {
+            TokenizerCase c = tc.draw(TOKENIZER_CASE, "case");
+            String text = c.text();
+            List<String> want = c.tokens();
+            StringTokenizer tok = c.splitter().tokenizer(text);
+            String ctx = c.splitter().describe() + " of " + show(text);
+            List<String> got = tok.getTokenList();
+            check(got.equals(want), () -> ctx + ": got " + got + ", want " + want);
+            check(tok.size() == want.size(), () -> ctx + ": size " + tok.size());
+            check(Arrays.asList(tok.getTokenArray()).equals(want), () -> ctx + ": getTokenArray");
+            // the ListIterator walks the same tokens forwards and back
+            List<String> forward = new ArrayList<>();
+            while (tok.hasNext()) {
+                forward.add(tok.next());
+            }
+            List<String> backward = new ArrayList<>();
+            while (tok.hasPrevious()) {
+                backward.add(0, tok.previous());
+            }
+            check(forward.equals(want) && backward.equals(want), () -> ctx + ": iteration " + forward + " / " + backward);
+            check(tok.nextToken() == null || !forward.isEmpty(), () -> ctx + ": nextToken after the end");
+            // reset with the same content tokenizes the same
+            tok.reset(text);
+            check(tok.getTokenList().equals(want), () -> ctx + ": reset");
+            // clone is independent
+            StringTokenizer copy = (StringTokenizer) tok.clone();
+            check(copy.getTokenList().equals(want) && copy.getContent().equals(text), () -> ctx + ": clone");
+        }, Zoo.settings("stringTokenizerSplitsWhatItsGrammarJoins"));
+    }
+
+    // ------------------------------------------------------------------ 4. AlphabetConverter
+
+    /** A code point of the original alphabet: a letter, digit or space (one in three), any BMP character but a surrogate, or a supplementary one. */
+    static final Generator<Integer> ORIGINAL_CP = weighted(
+        w(1, sampledFrom((int) 'a', (int) 'b', (int) 'c', (int) 'd', (int) 'e', (int) '0', (int) '1', (int) ' ')),
+        w(1, weighted(w(7, ints(0x20, 0xd7ff)), w(1, ints(0xe000, 0xffff)))),
+        w(1, ints(0x10000, 0x10ffff)));
+
+    static final Generator<Integer> ENCODING_CP = sampledFrom((int) '0', (int) '1', (int) '2', (int) 'x', (int) 'y', (int) 'a', (int) 'b');
+
+    /** An original alphabet (one to eight code points), an encoding alphabet (one to five), a subset of both left as-is, a text over the original, a code point that may lie outside it. */
+    record AlphabetCase(List<Integer> original, List<Integer> encoding, List<Integer> doNotEncode, String text, int outside) {}
+
+    static final Generator<AlphabetCase> ALPHABET_CASE = tuples(sets(ORIGINAL_CP).minSize(1).maxSize(8), sets(ENCODING_CP).minSize(1).maxSize(5)).flatMap(t -> {
+        List<Integer> original = new ArrayList<>(t.value1());
+        List<Integer> encoding = new ArrayList<>(t.value2());
+        List<Integer> shared = original.stream().filter(encoding::contains).toList();
+        Generator<List<Integer>> doNotEncode = shared.isEmpty()
+            ? just(List.<Integer>of())
+            : sets(sampledFrom(shared)).maxSize(shared.size()).map(s -> shared.stream().filter(s::contains).toList());
+        Generator<String> text = lists(sampledFrom(original)).maxSize(12).map(cps -> {
+            StringBuilder sb = new StringBuilder();
+            for (int cp : cps) {
+                sb.appendCodePoint(cp);
+            }
+            return sb.toString();
+        });
+        return tuples(doNotEncode, text, ints(0x20, 0x7e)).map(u -> new AlphabetCase(original, encoding, u.value1(), u.value2(), u.value3()));
+    });
+
+    @Test
+    void alphabetConverterRoundTrips() {
+        Hegel.test(tc -> {
+            AlphabetCase c = tc.draw(ALPHABET_CASE, "case");
+            List<Integer> original = c.original();
+            List<Integer> encoding = c.encoding();
+            List<Integer> doNotEncode = c.doNotEncode();
+            Integer[] orig = original.toArray(new Integer[0]);
+            Integer[] enc = encoding.toArray(new Integer[0]);
+            Integer[] dne = doNotEncode.toArray(new Integer[0]);
+            String ctx = " for original " + original + ", encoding " + encoding + ", doNotEncode " + doNotEncode;
+            AlphabetConverter ac;
+            try {
+                ac = AlphabetConverter.createConverter(orig, enc, dne);
+            } catch (IllegalArgumentException e) {
+                // documented: fewer than two usable encoding characters
+                check(encoding.size() - doNotEncode.size() < 2 && encoding.size() < original.size(), () -> "createConverter refused" + ctx + ": " + e.getMessage());
+                return;
+            }
+            String s = c.text();
+            try {
+                String encoded = ac.encode(s);
+                String decoded = ac.decode(encoded);
+                check(decoded.equals(s), () -> "decode(encode(" + show(s) + ")) = " + show(decoded) + " via " + show(encoded) + ctx);
+                // every encoded letter has the fixed length, except the do-not-encode ones (length 1)
+                int width = ac.getEncodedCharLength();
+                int wantLen = 0;
+                for (int i = 0; i < s.length(); ) {
+                    int cp = s.codePointAt(i);
+                    i += Character.charCount(cp);
+                    wantLen += doNotEncode.contains(cp) ? 1 : width;
+                }
+                int wantLenF = wantLen;
+                check(encoded.length() == wantLenF, () -> "encode(" + show(s) + ") = " + show(encoded) + " has length " + encoded.length() + ", want " + wantLenF + ctx);
+                for (char ch : encoded.toCharArray()) {
+                    check(encoding.contains((int) ch), () -> "encoded text uses " + show(String.valueOf(ch)) + " outside the encoding alphabet" + ctx);
+                }
+                // the map form rebuilds an equal converter
+                AlphabetConverter again = AlphabetConverter.createConverterFromMap(ac.getOriginalToEncoded());
+                check(again.equals(ac) && again.hashCode() == ac.hashCode() && again.decode(encoded).equals(s), () -> "createConverterFromMap differs" + ctx);
+                // a code point outside the alphabet is refused
+                int outside = c.outside();
+                if (!original.contains(outside)) {
+                    try {
+                        String e = ac.encode(new String(Character.toChars(outside)));
+                        fail("encode accepted a char outside the alphabet: " + show(e) + ctx);
+                    } catch (UnsupportedEncodingException expected) {
+                        // documented
+                    }
+                }
+            } catch (UnsupportedEncodingException e) {
+                fail("encode/decode threw " + e + " for " + show(s) + ctx);
+            }
+        }, Zoo.settings("alphabetConverterRoundTrips"));
+    }
+
+    // ------------------------------------------------------------------ 5. RandomStringGenerator
+
+    static boolean acceptable(int cp, List<CharacterPredicates> preds) {
+        int type = Character.getType(cp);
+        if (type == Character.SURROGATE || type == Character.PRIVATE_USE || type == Character.UNASSIGNED) {
+            return false;
+        }
+        if (preds == null) {
+            return true;
+        }
+        for (CharacterPredicate p : preds) {
+            if (p.test(cp)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Where the generator's code points come from: a range, a range filtered by predicates, a selection of characters. */
+    sealed interface Source permits Range, Filtered, Selected {
+        void configure(RandomStringGenerator.Builder b);
+
+        /** bug commons-text/6: a configuration no code point satisfies makes generate() spin forever. */
+        boolean satisfiable();
+
+        /** Whether the code point may come out of the configured generator. */
+        boolean admits(int cp);
+
+        String describe();
+    }
+
+    record Range(int lo, int hi) implements Source {
+        @Override
+        public void configure(RandomStringGenerator.Builder b) {
+            b.withinRange(lo, hi);
+        }
+
+        @Override
+        public boolean satisfiable() {
+            for (int cp = lo; cp <= hi; cp++) {
+                if (acceptable(cp, null)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        @Override
+        public boolean admits(int cp) {
+            return cp >= lo && cp <= hi;
+        }
+
+        @Override
+        public String describe() {
+            return "withinRange(" + lo + ", " + hi + ")";
+        }
+    }
+
+    record Filtered(int lo, int hi, List<CharacterPredicates> preds) implements Source {
+        @Override
+        public void configure(RandomStringGenerator.Builder b) {
+            b.withinRange(lo, hi).filteredBy(preds.toArray(new CharacterPredicate[0]));
+        }
+
+        @Override
+        public boolean satisfiable() {
+            for (int cp = lo; cp <= hi; cp++) {
+                if (acceptable(cp, preds)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        @Override
+        public boolean admits(int cp) {
+            return cp >= lo && cp <= hi && acceptable(cp, preds);
+        }
+
+        @Override
+        public String describe() {
+            return "withinRange(" + lo + ", " + hi + ").filteredBy(" + preds + ")";
+        }
+    }
+
+    record Selected(String chars) implements Source {
+        @Override
+        public void configure(RandomStringGenerator.Builder b) {
+            b.selectFrom(chars.toCharArray());
+        }
+
+        @Override
+        public boolean satisfiable() {
+            for (char ch : chars.toCharArray()) {
+                if (acceptable(ch, null)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        @Override
+        public boolean admits(int cp) {
+            return chars.indexOf(cp) >= 0;
+        }
+
+        @Override
+        public String describe() {
+            return "selectFrom(" + show(chars) + ")";
+        }
+    }
+
+    static final Generator<Integer> LOW = ints(0, 0x300);
+
+    /** The upper bound of a range from {@code lo}: within the Latin block, the BMP, or anywhere. */
+    static Generator<Integer> high(int lo) {
+        return weighted(w(1, ints(lo, 0x300)), w(1, ints(lo, 0xffff)), w(1, ints(lo, 0x10ffff)));
+    }
+
+    /** Code points a filtered range is built around: digits, letters, marks and symbols of several blocks. */
+    static final List<Integer> ANCHORS = List.of((int) '0', (int) '5', (int) '9', (int) 'A', (int) 'Z', (int) 'a', (int) 'z', 0x00e9, 0x0100, 0x02ff, 0x0300, 0x0660, 0x0966, 0x2000, 0x2fff);
+
+    /**
+     * A filtered range holds a code point its predicates accept (bug commons-text/6: generate() spins forever otherwise,
+     * so that shape is left to the pin): the range is drawn around an anchor they accept ('0', 'A' or 'a' at least),
+     * and its upper bound stays below 0x3000 so the rejection sampling stays quick; the predicates are one to three.
+     */
+    static final Generator<Source> FILTERED = lists(sampledFrom(CharacterPredicates.values())).minSize(1).maxSize(3).flatMap(preds ->
+        sampledFrom(ANCHORS.stream().filter(cp -> acceptable(cp, preds)).toList()).flatMap(anchor ->
+            tuples(ints(0, anchor), weighted(w(1, ints(anchor, Math.max(anchor, 0x300))), w(1, ints(anchor, 0x3000)))).<Source>map(t -> new Filtered(t.value1(), t.value2(), preds))));
+
+    /** Where the code points come from: a plain range, a filtered range, a selection. */
+    static final Generator<Source> SOURCE = weighted(
+        w(1, LOW.flatMap(lo -> high(lo).<Source>map(hi -> new Range(lo, hi)))),
+        w(1, FILTERED),
+        w(1, word("abcXYZ019 \u00e9", 1, 6).<Source>map(Selected::new)));
+
+    /** A source, the seed of its randomness, a length, and the bounds of a ranged length. */
+    record RandomStringCase(Source source, long seed, int len, int min, int max) {}
+
+    static final Generator<RandomStringCase> RANDOM_STRING_CASE = tuples(SOURCE, Generators.longs(), ints(0, 30), ints(0, 10).flatMap(min -> tuples(just(min), ints(min, 14))))
+        .map(t -> new RandomStringCase(t.value1(), t.value2(), t.value3(), t.value4().value1(), t.value4().value2()));
+
+    @Test
+    void randomStringGeneratorHonoursItsBounds() {
+        Hegel.test(tc -> {
+            RandomStringCase c = tc.draw(RANDOM_STRING_CASE, "case");
+            Source source = c.source();
+            // bug commons-text/6: a configuration no code point satisfies makes generate() spin forever; skip those
+            tc.assume(source.satisfiable());
+            RandomStringGenerator.Builder b = RandomStringGenerator.builder();
+            source.configure(b);
+            String ctx = source.describe();
+            // deterministic randomness so the run is reproducible and the length maths is checkable
+            java.util.Random rnd = new java.util.Random(c.seed());
+            b.usingRandom(max -> rnd.nextInt(max));
+            RandomStringGenerator g = b.get();
+            int len = c.len();
+            String s;
+            try {
+                s = g.generate(len);
+            } catch (RuntimeException e) {
+                fail(ctx + ".generate(" + len + ") threw " + e);
+                return;
+            }
+            check(s.codePointCount(0, s.length()) == len, () -> ctx + ".generate(" + len + ") has " + s.codePointCount(0, s.length()) + " code points: " + show(s));
+            for (int i = 0; i < s.length(); ) {
+                int cp = s.codePointAt(i);
+                i += Character.charCount(cp);
+                int type = Character.getType(cp);
+                check(type != Character.SURROGATE && type != Character.PRIVATE_USE && type != Character.UNASSIGNED, () -> ctx + " produced U+" + Integer.toHexString(cp) + " of type " + type);
+                check(source.admits(cp), () -> ctx + " produced U+" + Integer.toHexString(cp) + " outside the range, selection or predicates");
+            }
+            int min = c.min();
+            int max = c.max();
+            String ranged = g.generate(min, max);
+            int cps = ranged.codePointCount(0, ranged.length());
+            check(cps >= min && cps <= max, () -> ctx + ".generate(" + min + ", " + max + ") has " + cps + " code points");
+            // the same seed gives the same string
+            java.util.Random rnd2 = new java.util.Random(c.seed());
+            String again = b.usingRandom(max2 -> rnd2.nextInt(max2)).get().generate(len);
+            check(again.equals(s), () -> ctx + " is not reproducible: " + show(s) + " vs " + show(again));
+        }, Zoo.settings("randomStringGeneratorHonoursItsBounds"));
+    }
+
+    // ------------------------------------------------------------------ 6. FormattableUtils / ExtendedMessageFormat
+
+    static final class Padded implements Formattable {
+        final String seq;
+        final CharSequence ellipsis;
+        final char pad;
+
+        Padded(String seq, CharSequence ellipsis, char pad) {
+            this.seq = seq;
+            this.ellipsis = ellipsis;
+            this.pad = pad;
+        }
+
+        @Override
+        public void formatTo(Formatter formatter, int flags, int width, int precision) {
+            FormattableUtils.append(seq, formatter, flags, width, precision, pad, ellipsis);
+        }
+    }
+
+    /** A FormattableUtils.append call: the text, a width (-1: none, half the time), a precision (-1: none), left-justified (when there is a width) half the time, an ellipsis (null one in five), a pad. */
+    record Spec(String seq, int width, int precision, boolean leftCoin, String ellipsis, char pad) {
+        boolean left() {
+            return width > 0 && leftCoin;
+        }
+    }
+
+    static final Generator<Spec> SPEC = tuples(word("abcdef ", 0, 12), maybe(50, -1, ints(1, 14)), ints(-1, 10), chance(50), maybe(80, (String) null, sampledFrom("", "...", "~", "..")), sampledFrom(' ', '_'))
+        .map(t -> new Spec(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+
+    /** An item of a message pattern; the format elements are rendered against the argument types (see {@link MessageCase#render}). */
+    sealed interface Item permits Text, Quotes, Quoted, Arg, Formatted {}
+
+    record Text(String s) implements Item {}
+
+    /** Two quotes: an escaped quote. */
+    record Quotes() implements Item {}
+
+    /** Quoted text, which may hold braces. */
+    record Quoted(String s) implements Item {}
+
+    /** A plain {n}. */
+    record Arg(int idx) implements Item {}
+
+    /** With {@code upper}: {n,upper} on a string argument, {n} on a number; else {n,number...} on a number and {n} on a string. */
+    record Formatted(int idx, boolean upper, String numberFormat) implements Item {}
+
+    /** An argument: a string (60%) or a number (an int or a double). */
+    static final Generator<Object> ARG = weighted(w(60, Generators.<Object>sampledFrom("x", "Hello", "a'b")), w(40, Generators.<Object>sampledFrom(42, 1234.5)));
+
+    static final Generator<Item> ITEM = weighted(
+        w(2, word("abc ,.-", 1, 5).<Item>map(Text::new)),
+        w(1, Generators.<Item>just(new Quotes())),
+        w(1, word("abc {}", 1, 4).<Item>map(Quoted::new)),
+        w(1, ints(0, 2).<Item>map(Arg::new)),
+        w(1, tuples(ints(0, 2), chance(50), sampledFrom(",number", ",number,integer", ",number,#.##", ", number , integer "))
+            .<Item>map(t -> new Formatted(t.value1(), t.value2(), t.value3()))));
+
+    /**
+     * A message pattern of up to six items over three arguments; a number format needs a Number (MessageFormat itself
+     * refuses a String) and the custom upper format is only compared on strings (it prints numbers unformatted).
+     */
+    record MessageCase(Spec spec, List<Object> values, List<Item> items) {
+        boolean numeric(int idx) {
+            return values.get(idx) instanceof Number;
+        }
+
+        String render(Item item) {
+            return switch (item) {
+                case Text t -> t.s();
+                case Quotes q -> "''";
+                case Quoted q -> "'" + q.s() + "'";
+                case Arg a -> "{" + a.idx() + "}";
+                case Formatted f -> f.upper()
+                    ? (numeric(f.idx()) ? "{" + f.idx() + "}" : "{" + f.idx() + ",upper}")
+                    : (numeric(f.idx()) ? "{" + f.idx() + f.numberFormat() + "}" : "{" + f.idx() + "}");
+            };
+        }
+
+        String pattern() {
+            StringBuilder p = new StringBuilder();
+            for (Item item : items) {
+                p.append(render(item));
+            }
+            return p.toString();
+        }
+
+        /** Whether the custom upper format applies somewhere. */
+        boolean upper() {
+            return items.stream().anyMatch(i -> i instanceof Formatted f && f.upper() && !numeric(f.idx()));
+        }
+
+        /** Whether a quoted literal holds a '}'. */
+        boolean literalBrace() {
+            return items.stream().anyMatch(i -> i instanceof Quoted q && q.s().indexOf('}') >= 0);
+        }
+    }
+
+    static final Generator<MessageCase> MESSAGE_CASE = tuples(SPEC, lists(ARG).minSize(3).maxSize(3), lists(ITEM).maxSize(6))
+        .map(t -> new MessageCase(t.value1(), t.value2(), t.value3()));
+
+    static Map<String, FormatFactory> upperRegistry() {
+        Map<String, FormatFactory> registry = new HashMap<>();
+        registry.put("upper", (name, arguments, locale) -> new java.text.Format() {
+            @Override
+            public StringBuffer format(Object obj, StringBuffer toAppendTo, java.text.FieldPosition pos) {
+                return toAppendTo.append(String.valueOf(obj).toUpperCase(Locale.ROOT));
+            }
+
+            @Override
+            public Object parseObject(String source, java.text.ParsePosition pos) {
+                return null;
+            }
+        });
+        return registry;
+    }
+
+    @Test
+    void formattableUtilsAndExtendedMessageFormatKeepTheirShape() {
+        Hegel.test(tc -> {
+            MessageCase c = tc.draw(MESSAGE_CASE, "case");
+            Spec sp = c.spec();
+            String seq = sp.seq();
+            int width = sp.width();
+            int precision = sp.precision();
+            boolean left = sp.left();
+            String ellipsis = sp.ellipsis();
+            char pad = sp.pad();
+            if (ellipsis != null && precision >= 0 && ellipsis.length() > precision) {
+                Assertions.assertThrows(IllegalArgumentException.class,
+                    () -> FormattableUtils.append(seq, new Formatter(), 0, width, precision, pad, ellipsis));
+            } else {
+                String spec = "%" + (left ? "-" : "") + (width >= 0 ? width : "") + (precision >= 0 ? "." + precision : "") + "s";
+                String out = String.format(spec, new Padded(seq, ellipsis, pad));
+                int shown = precision >= 0 ? Math.min(precision, seq.length()) : seq.length();
+                int wantLen = Math.max(width, shown);
+                String body = precision >= 0 && precision < seq.length()
+                    ? seq.substring(0, precision - (ellipsis == null ? 0 : ellipsis.length())) + (ellipsis == null ? "" : ellipsis)
+                    : seq;
+                String want = left ? body + String.valueOf(pad).repeat(wantLen - body.length()) : String.valueOf(pad).repeat(wantLen - body.length()) + body;
+                check(out.equals(want), () -> "FormattableUtils.append(" + show(seq) + ", " + spec + ", pad " + pad + ", ellipsis " + show(ellipsis) + ") = " + show(out) + ", want " + show(want));
+            }
+
+            // ExtendedMessageFormat: with no registry it formats like MessageFormat and toPattern() reparses the same
+            Object[] values = c.values().toArray();
+            String pattern = c.pattern();
+            boolean upper = c.upper();
+            Map<String, FormatFactory> registry = upperRegistry();
+            ExtendedMessageFormat emf;
+            try {
+                emf = new ExtendedMessageFormat(pattern, Locale.US, registry);
+            } catch (IllegalArgumentException e) {
+                fail("ExtendedMessageFormat rejected " + show(pattern) + ": " + e.getMessage());
+                return;
+            }
+            String formatted = emf.format(values);
+            String ctx = " for pattern " + show(pattern) + " and " + Arrays.toString(values);
+            if (!upper) {
+                String plain = new MessageFormat(pattern, Locale.US).format(values);
+                check(formatted.equals(plain), () -> "ExtendedMessageFormat gave " + show(formatted) + ", MessageFormat " + show(plain) + ctx);
+            } else {
+                // the custom format applies: every {n,upper} argument appears upper-cased
+                String manual = new MessageFormat(pattern.replace(",upper}", "}"), Locale.US).format(values);
