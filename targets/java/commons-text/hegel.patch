+        }
+        return special ? "\"" + s.replace("\"", "\"\"") + "\"" : s;
+    }
+
+    static final String XSI_SPECIALS = "|&;<>()$`\\\"' \t*?[#~=%";
+
+    static String modelEscapeXsi(String s) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (c == '\r' && i + 1 < s.length() && s.charAt(i + 1) == '\n') {
+                i++;
+            } else if (c == '\n') {
+                // removed
+            } else if (XSI_SPECIALS.indexOf(c) >= 0) {
+                sb.append('\\').append(c);
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.toString();
+    }
+
+    static void eq(String what, Object got, Object want, String input) {
+        if (!java.util.Objects.equals(got, want)) {
+            fail(what + " for " + show(input) + ": got " + show(got) + ", want " + show(want));
+        }
+    }
