+    @Test
+    void similarityScoresAndDiffsMatchTheTextbookDefinitions() {
+        Hegel.test(tc -> {
+            SimilarityCase c = tc.draw(SIMILARITY_CASE, "case");
+            String a = c.a();
+            String b = other(a, c.other());
+            String ctx = " for " + show(a) + ", " + show(b);
+
+            int lev = levenshtein(a, b);
+            Integer got = LevenshteinDistance.getDefaultInstance().apply(a, b);
+            check(got == lev, () -> "LevenshteinDistance" + ctx + ": got " + got + ", want " + lev);
+            int threshold = c.threshold();
+            Integer limited = new LevenshteinDistance(threshold).apply(a, b);
+            int wantLimited = lev <= threshold ? lev : -1;
+            check(limited == wantLimited, () -> "LevenshteinDistance(" + threshold + ")" + ctx + ": got " + limited + ", want " + wantLimited);
+            // bug commons-text/8: the detailed distance is the length of a backtrack that ignores the costs, so it
+            // can exceed the Levenshtein distance ("abba" -> "baab": 4 substitutions, distance 3); pinned, so only
+            // the weaker facts are checked here: an upper bound, a consistent breakdown, the length difference
+            LevenshteinResults r = LevenshteinDetailedDistance.getDefaultInstance().apply(a, b);
+            check(r.getDistance() >= lev && r.getInsertCount() + r.getDeleteCount() + r.getSubstituteCount() == r.getDistance()
+                && r.getInsertCount() - r.getDeleteCount() == b.length() - a.length(),
+                () -> "LevenshteinDetailedDistance" + ctx + ": " + r + ", distance " + lev);
+
+            if (a.length() == b.length()) {
+                int ham = 0;
+                for (int i = 0; i < a.length(); i++) {
+                    ham += a.charAt(i) == b.charAt(i) ? 0 : 1;
+                }
+                Integer gotHam = new HammingDistance().apply(a, b);
+                int wantHam = ham;
+                check(gotHam == wantHam, () -> "HammingDistance" + ctx + ": got " + gotHam + ", want " + wantHam);
+            }
+
+            int lcs = lcsLength(a, b);
+            LongestCommonSubsequence l = new LongestCommonSubsequence();
+            Integer gotLcs = l.apply(a, b);
+            check(gotLcs == lcs, () -> "LongestCommonSubsequence.apply" + ctx + ": got " + gotLcs + ", want " + lcs);
+            CharSequence seq = l.longestCommonSubsequence(a, b);
+            check(seq.length() == lcs && isSubsequence(seq, a) && isSubsequence(seq, b),
+                () -> "longestCommonSubsequence" + ctx + ": " + show(seq.toString()) + " (length " + lcs + " wanted)");
+            Integer gotLcsD = new LongestCommonSubsequenceDistance().apply(a, b);
+            check(gotLcsD == a.length() + b.length() - 2 * lcs, () -> "LongestCommonSubsequenceDistance" + ctx + ": got " + gotLcsD);
+
+            double jw = jaroWinkler(a, b);
+            Double gotJw = new JaroWinklerSimilarity().apply(a, b);
+            check(Math.abs(gotJw - jw) < 1e-9, () -> "JaroWinklerSimilarity" + ctx + ": got " + gotJw + ", want " + jw);
+            Double gotJwBa = new JaroWinklerSimilarity().apply(b, a);
+            check(gotJwBa.equals(gotJw), () -> "JaroWinklerSimilarity is not symmetric" + ctx + ": " + gotJw + " vs " + gotJwBa);
+            Double gotJwD = new JaroWinklerDistance().apply(a, b);
+            check(Math.abs(gotJwD - (1 - jw)) < 1e-9, () -> "JaroWinklerDistance" + ctx + ": got " + gotJwD + ", want " + (1 - jw));
+
+            double jac = jaccard(a, b);
+            Double gotJac = new JaccardSimilarity().apply(a, b);
+            check(Math.abs(gotJac - jac) < 1e-12, () -> "JaccardSimilarity" + ctx + ": got " + gotJac + ", want " + jac);
+            Double gotJacD = new JaccardDistance().apply(a, b);
+            check(Math.abs(gotJacD - (1 - jac)) < 1e-12, () -> "JaccardDistance" + ctx + ": got " + gotJacD);
+
+            int fz = fuzzy(a, b);
+            Integer gotFz = new FuzzyScore(Locale.ENGLISH).fuzzyScore(a, b);
+            check(gotFz == fz, () -> "FuzzyScore" + ctx + ": got " + gotFz + ", want " + fz);
+
+            if (!a.isBlank() && !b.isBlank()) {
+                // bug commons-text/1: blank inputs throw; skipped here, pinned below
+                Double cos = new CosineDistance().apply(a, b);
+                check(cos >= -1e-12 && cos <= 1 + 1e-12, () -> "CosineDistance out of [0, 1]" + ctx + ": " + cos);
+                Double cosBa = new CosineDistance().apply(b, a);
+                check(Math.abs(cos - cosBa) < 1e-12, () -> "CosineDistance is not symmetric" + ctx + ": " + cos + " vs " + cosBa);
+                if (a.matches(".*\\w.*")) {
+                    Double self = new CosineDistance().apply(a, a);
+                    check(Math.abs(self) < 1e-12, () -> "CosineDistance(a, a) = " + self + " for " + show(a));
+                }
+            }
+
+            // the edit script: keeps + deletes spell a, keeps + inserts spell b, and it is shortest
+            EditScript<Character> script = new StringsComparator(a, b).getScript();
+            Replay replay = new Replay();
+            script.visit(replay);
+            check(replay.left.toString().equals(a) && replay.right.toString().equals(b),
+                () -> "EditScript does not replay the strings" + ctx + ": " + show(replay.left.toString()) + " / " + show(replay.right.toString()));
+            check(script.getLCSLength() == replay.keeps && script.getModifications() == replay.inserts + replay.deletes,
+                () -> "EditScript counts" + ctx + ": lcs " + script.getLCSLength() + " keeps " + replay.keeps + " modifications " + script.getModifications());
+            check(replay.keeps == lcs, () -> "EditScript keeps " + replay.keeps + " but the LCS has length " + lcs + ctx);
+            // ReplacementsFinder: applying the reported replacements to a gives b - while the script ends with a keep
+            // (bug commons-text/2: a trailing replacement is never reported; pinned below)
+            if (replay.last == 'k') {
+                StringBuilder rebuilt = new StringBuilder();
+                int[] pos = {0};
+                script.visit(new ReplacementsFinder<Character>((skipped, from, to) -> {
+                    rebuilt.append(a, pos[0], pos[0] + skipped);
+                    pos[0] += skipped + from.size();
+                    for (Character ch : to) {
+                        rebuilt.append(ch);
+                    }
+                }));
+                rebuilt.append(a, pos[0], a.length());
+                check(rebuilt.toString().equals(b), () -> "ReplacementsFinder replacements rebuild " + show(rebuilt.toString()) + ctx);
+            }
+        }, Zoo.settings("similarityScoresAndDiffsMatchTheTextbookDefinitions"));
+    }
+
+    // ------------------------------------------------------------------ pins
+
+    /** commons-text/1: CosineDistance throws for blank input instead of returning a distance. */
+    @Test
+    void pinCosineDistanceRejectsBlankText() {
+        Assertions.assertDoesNotThrow(() -> new CosineDistance().apply("abc", " "));
+        Assertions.assertDoesNotThrow(() -> new CosineDistance().apply("", ""));
+    }
+
+    /** commons-text/2: ReplacementsFinder never reports a replacement at the end of the sequences. */
+    @Test
+    void pinReplacementsFinderDropsTheTrailingReplacement() {
+        List<String> calls = new ArrayList<>();
+        new StringsComparator("ab", "ac").getScript().visit(new ReplacementsFinder<Character>(
+            (skipped, from, to) -> calls.add(skipped + ":" + from + "->" + to)));
+        Assertions.assertEquals(List.of("1:[b]->[c]"), calls);
+    }
+
+    /** commons-text/7: StringSubstitutorReader.read(char[], int, int) returns 0 (not allowed by Reader) when a variable is empty. */
+    @Test
+    void pinSubstitutorReaderNeverReadsZeroChars() throws IOException {
+        StringSubstitutor sub = new StringSubstitutor(Map.of("b", ""));
+        Reader r = new StringSubstitutorReader(new StringReader("${b}z"), sub);
+        char[] buf = new char[8];
+        int got = r.read(buf, 0, 8);
+        Assertions.assertTrue(got != 0, "read(buf, 0, 8) returned 0");
+        Assertions.assertEquals("z", new String(buf, 0, Math.max(got, 0)));
+    }
+
+    /** commons-text/3: JaroWinklerSimilarity of two equal empty non-String CharSequences is 0, of two empty Strings 1. */
+    @Test
+    void pinJaroWinklerOfEqualEmptyBuildersIsOne() {
+        Assertions.assertEquals(1.0, new JaroWinklerSimilarity().apply("", ""));
+        Assertions.assertEquals(1.0, new JaroWinklerSimilarity().apply(new StringBuilder(), new StringBuilder()));
+    }
+
+    /** commons-text/8: LevenshteinDetailedDistance reports 4 for "abba" -> "baab", whose Levenshtein distance is 3. */
+    @Test
+    void pinDetailedLevenshteinDistanceIsTheLevenshteinDistance() {
+        Assertions.assertEquals(3, LevenshteinDistance.getDefaultInstance().apply("abba", "baab"));
+        LevenshteinResults r = LevenshteinDetailedDistance.getDefaultInstance().apply("abba", "baab");
+        Assertions.assertEquals(3, r.getDistance(), r.toString());
+        Assertions.assertEquals(3, r.getInsertCount() + r.getDeleteCount() + r.getSubstituteCount(), r.toString());
+    }
+
+    /** commons-text/10: with prefix == suffix the reader and replace() substitute the same text differently. */
+    @Test
+    void pinSubstitutorReaderAgreesWithReplaceWhenPrefixEqualsSuffix() throws IOException {
+        StringSubstitutor sub = new StringSubstitutor(Map.of("a", "X", "b", "Y"), "%", "%");
+        String text = "$%a%%b%";
+        StringBuilder streamed = new StringBuilder();
+        Reader r = new StringSubstitutorReader(new StringReader(text), sub);
+        char[] buf = new char[64];
+        int got;
+        while ((got = r.read(buf, 0, 64)) >= 0) {
+            streamed.append(buf, 0, got);
+        }
+        Assertions.assertEquals(sub.replace(text), streamed.toString());
+    }
+
+    /** commons-text/13: with a one-character prefix the reader throws for a text that ends with the escape character. */
+    @Test
+    void pinSubstitutorReaderAcceptsATrailingEscapeChar() throws IOException {
+        StringSubstitutor sub = new StringSubstitutor(Map.of("a", "X"), "<", ">");
+        Reader r = new StringSubstitutorReader(new StringReader("$"), sub);
+        char[] buf = new char[8];
+        int got = Assertions.assertDoesNotThrow(() -> r.read(buf, 0, 8));
+        Assertions.assertEquals("$", new String(buf, 0, Math.max(got, 0)));
+    }
+
+    /** commons-text/14: a value ending in '$' escapes the variable that follows it in the template. */
+    @Test
+    void pinValueEndingInDollarDoesNotEscapeTheNextVariable() {
+        Map<String, String> vars = Map.of("a", "x$", "b", "y");
+        Assertions.assertEquals("x$y", new StringSubstitutor(vars).replace("${a}${b}"));
+        Assertions.assertEquals("x$y", new StringSubstitutor(vars).setDisableSubstitutionInValues(true).replace("${a}${b}"));
+        Assertions.assertEquals("x$y", new StringSubstitutor(vars).replace("${z:-x$}${b}"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..05c963d
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,88 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The combinators the binding lacks: weighted choice, a biased coin, an optional with a probability, an int range,
+ * and text over an alphabet ({@code TextGenerator} takes code point ranges, not an alphabet).
+ */
+final class Gen {
+    private Gen() {}
+
+    /** A weighted alternative for {@link #weighted}; the generator may produce a subtype of the choice's type. */
+    record Choice<T>(int weight, Generator<? extends T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<? extends T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    static <T> Generator<T> weighted(List<Choice<T>> choices) {
+        List<Choice<T>> cs = List.copyOf(choices);
+        int total = 0;
+        for (Choice<T> c : cs) {
+            total += c.weight();
+        }
+        return ints(0, total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : cs) {
+                acc += c.weight();
+                if (i < acc) {
+                    return widen(c.gen());
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** A generator of a subtype is a generator of the supertype: it only ever produces values. */
+    @SuppressWarnings("unchecked")
+    static <T> Generator<T> widen(Generator<? extends T> g) {
+        return (Generator<T>) g;
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return ints(0, 99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<? extends T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** One character of the alphabet (by UTF-16 unit). */
+    static Generator<String> chars(String alphabet) {
+        List<String> cs = new ArrayList<>();
+        for (int i = 0; i < alphabet.length(); i++) {
+            cs.add(String.valueOf(alphabet.charAt(i)));
+        }
+        return sampledFrom(cs);
+    }
+
+    /** A string of lo..hi characters of the alphabet; shrinks to lo characters. */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        return lists(chars(alphabet)).minSize(lo).maxSize(hi).map(Gen::join);
+    }
+
+    static String join(List<String> parts) {
+        return String.join("", parts);
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..f114523
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,88 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "\u2026" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
