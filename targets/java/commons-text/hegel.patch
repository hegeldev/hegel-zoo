+    // ------------------------------------------------------------------ 6. similarity and diff
+
+    static int levenshtein(String a, String b) {
+        int[] prev = new int[b.length() + 1];
+        int[] cur = new int[b.length() + 1];
+        for (int j = 0; j <= b.length(); j++) {
+            prev[j] = j;
+        }
+        for (int i = 1; i <= a.length(); i++) {
+            cur[0] = i;
+            for (int j = 1; j <= b.length(); j++) {
+                int sub = prev[j - 1] + (a.charAt(i - 1) == b.charAt(j - 1) ? 0 : 1);
+                cur[j] = Math.min(sub, Math.min(prev[j] + 1, cur[j - 1] + 1));
+            }
+            int[] t = prev;
+            prev = cur;
+            cur = t;
+        }
+        return prev[b.length()];
+    }
+
+    static int lcsLength(String a, String b) {
+        int[][] m = new int[a.length() + 1][b.length() + 1];
+        for (int i = 1; i <= a.length(); i++) {
+            for (int j = 1; j <= b.length(); j++) {
+                m[i][j] = a.charAt(i - 1) == b.charAt(j - 1) ? m[i - 1][j - 1] + 1 : Math.max(m[i - 1][j], m[i][j - 1]);
+            }
+        }
+        return m[a.length()][b.length()];
+    }
+
+    static boolean isSubsequence(CharSequence sub, String of) {
+        int j = 0;
+        for (int i = 0; i < of.length() && j < sub.length(); i++) {
+            if (of.charAt(i) == sub.charAt(j)) {
+                j++;
+            }
+        }
+        return j == sub.length();
+    }
+
+    /** Jaro-Winkler as defined: matches within floor(max/2)-1, half transpositions, prefix up to 4, boost when jaro >= 0.7. */
+    static double jaroWinkler(String a, String b) {
+        if (a.equals(b)) {
+            return 1.0;
+        }
+        if (a.isEmpty() || b.isEmpty()) {
+            return 0.0;
+        }
+        int range = Math.max(Math.max(a.length(), b.length()) / 2 - 1, 0);
+        boolean[] usedB = new boolean[b.length()];
+        StringBuilder ma = new StringBuilder();
+        StringBuilder mb = new StringBuilder();
+        for (int i = 0; i < a.length(); i++) {
+            for (int j = Math.max(0, i - range); j < Math.min(b.length(), i + range + 1); j++) {
+                if (!usedB[j] && a.charAt(i) == b.charAt(j)) {
+                    usedB[j] = true;
+                    ma.append(a.charAt(i));
+                    break;
+                }
+            }
+        }
+        for (int j = 0; j < b.length(); j++) {
+            if (usedB[j]) {
+                mb.append(b.charAt(j));
+            }
+        }
+        int m = ma.length();
+        if (m == 0) {
+            return 0.0;
+        }
+        int half = 0;
+        for (int i = 0; i < m; i++) {
+            if (ma.charAt(i) != mb.charAt(i)) {
+                half++;
+            }
+        }
+        int prefix = 0;
+        while (prefix < Math.min(4, Math.min(a.length(), b.length())) && a.charAt(prefix) == b.charAt(prefix)) {
+            prefix++;
+        }
+        double j = ((double) m / a.length() + (double) m / b.length() + (m - half / 2.0) / m) / 3;
+        return j < 0.7 ? j : j + 0.1 * prefix * (1 - j);
+    }
+
+    static double jaccard(String a, String b) {
+        if (a.isEmpty() && b.isEmpty()) {
+            return 1.0;
+        }
+        if (a.isEmpty() || b.isEmpty()) {
+            return 0.0;
+        }
+        Set<Character> sa = new HashSet<>();
+        Set<Character> sb = new HashSet<>();
+        for (char c : a.toCharArray()) {
+            sa.add(c);
+        }
+        for (char c : b.toCharArray()) {
+            sb.add(c);
+        }
+        Set<Character> union = new HashSet<>(sa);
+        union.addAll(sb);
+        Set<Character> inter = new HashSet<>(sa);
+        inter.retainAll(sb);
+        return (double) inter.size() / union.size();
+    }
+
+    static int fuzzy(String term, String query) {
+        term = term.toLowerCase(Locale.ENGLISH);
+        query = query.toLowerCase(Locale.ENGLISH);
+        int score = 0;
+        int from = 0;
+        int prev = Integer.MIN_VALUE;
+        for (int q = 0; q < query.length(); q++) {
+            int at = term.indexOf(query.charAt(q), from);
+            if (at < 0) {
+                from = term.length(); // a miss scans the rest of the term; later query chars cannot match
+                continue;
+            }
+            score++;
+            if (prev + 1 == at) {
+                score += 2;
+            }
+            prev = at;
+            from = at + 1;
+        }
+        return score;
+    }
