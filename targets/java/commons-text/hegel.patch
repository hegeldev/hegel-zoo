+
+    // ------------------------------------------------------------------ 4. StringSubstitutor
+
+    record SubFlags(String prefix, String suffix, boolean preserveEscapes, boolean noSubInValues,
+                    boolean undefinedThrows) {}
+
+    static final class Undefined extends RuntimeException {
+        Undefined(String name) {
+            super(name);
+        }
+    }
+
+    /** bug commons-text/14: a substituted value ending in '$' escapes a variable that follows it directly. */
+    static final class ValueEscapeLeak extends RuntimeException {
+        ValueEscapeLeak() {
+            super("value ending in $ followed by the prefix");
+        }
+    }
+
+    /** The documented ${name}, ${name:-default}, $${escaped} syntax, values substituted recursively
+     * unless disabled. Restricted to templates without nested ${ inside a variable expression. */
+    static String modelSubstitute(String t, Map<String, String> vars, SubFlags f, int depth) {
+        StringBuilder out = new StringBuilder();
+        int i = 0;
+        int len = t.length();
+        while (i < len) {
+            if (t.startsWith(f.prefix(), i)) {
+                boolean escaped = i > 0 && t.charAt(i - 1) == '$' && t.indexOf(f.suffix(), i + f.prefix().length()) >= 0;
+                if (escaped) {
+                    if (!f.preserveEscapes()) {
+                        out.setLength(out.length() - 1);
+                    }
+                    out.append(f.prefix());
+                    i += f.prefix().length();
+                    continue;
+                }
+                int j = t.indexOf(f.suffix(), i + f.prefix().length());
+                if (j < 0) {
+                    out.append(t, i, len);
+                    break;
+                }
+                String expr = t.substring(i + f.prefix().length(), j);
+                String name = expr;
+                String dflt = null;
+                int d = expr.indexOf(":-");
+                if (d >= 0) {
+                    name = expr.substring(0, d);
+                    dflt = expr.substring(d + 2);
+                }
+                String value = vars.get(name);
+                if (value != null) {
+                    if (!f.noSubInValues()) {
+                        if (depth > 20) {
+                            throw new IllegalStateException("cycle");
+                        }
+                        value = modelSubstitute(value, vars, f, depth + 1);
+                    }
+                    out.append(value);
+                } else if (dflt != null) {
+                    out.append(dflt);
+                    value = dflt;
+                } else if (f.undefinedThrows()) {
+                    throw new Undefined(name);
+                } else {
+                    out.append(t, i, j + f.suffix().length());
+                }
+                i = j + f.suffix().length();
+                // bug commons-text/14: the library scans on over the inserted value, so a value ending in '$'
+                // escapes a variable that follows it directly ("${a}${b}", a = "x$" -> "x${b}"); pinned, skipped here
+                if (value != null && value.endsWith("$") && t.startsWith(f.prefix(), i)) {
+                    throw new ValueEscapeLeak();
+                }
+            } else {
+                out.append(t.charAt(i));
+                i++;
+            }
+        }
+        return out.toString();
+    }
+
+    static final String[] NAMES = {"a", "b", "c", "d", "ee", "x1", "", "a.b", "A"};
+
+    static final Generator<String> NAME = sampledFrom(NAMES);
+
+    record Delims(String prefix, String suffix) {}
+
+    /** The delimiters: the default ${ } (three in four) or a custom pair. */
+    static final Generator<Delims> DELIMS = weighted(
+        w(75, just(new Delims("${", "}"))),
+        w(25, tuples(sampledFrom("<", "@{", "%%"), sampledFrom(">", "}", "%%")).map(t -> new Delims(t.value1(), t.value2()))));
+
+    static final Generator<SubFlags> FLAGS = tuples(DELIMS, chance(30), chance(30), chance(30))
+        .map(t -> new SubFlags(t.value1().prefix(), t.value1().suffix(), t.value2(), t.value3(), t.value4()));
+
+    /** Literal text with the prefix/suffix (and their first characters, unless the prefix is the escape's) replaced. */
+    static String literal(String s, SubFlags f) {
+        // keep the prefix/suffix (and the value delimiter) out of literal text
+        s = s.replace(f.prefix(), "_").replace(f.suffix(), "_");
+        if (f.prefix().indexOf('$') < 0) {
+            s = s.replace(String.valueOf(f.prefix().charAt(0)), "_").replace(String.valueOf(f.suffix().charAt(0)), "_");
+        }
+        return s;
+    }
+
+    static Generator<String> literal(SubFlags f) {
+        return word("ab xyz.,-/!$09", 1, 6).map(s -> literal(s, f));
+    }
+
+    /**
+     * A piece of a template: a literal (three in eight), a variable (two), a variable with a default, an escaped
+     * variable (a literal where escapes are not allowed), a stray escape character or suffix.
+     */
+    static Generator<String> piece(SubFlags f, boolean allowEscapes) {
+        Generator<String> lit = literal(f);
+        Generator<String> escaped = tuples(NAME, maybe(30, "", just(":-dd"))).map(t -> "$" + f.prefix() + t.value1() + t.value2() + f.suffix());
+        return weighted(
+            w(3, lit),
+            w(2, NAME.map(n -> f.prefix() + n + f.suffix())),
+            w(1, tuples(NAME, word("abc 09.", 0, 4)).map(t -> f.prefix() + t.value1() + ":-" + t.value2() + f.suffix())),
+            w(1, allowEscapes ? escaped : lit),
+            w(1, sampledFrom("$", "$$", f.suffix(), "$" + f.suffix())));
+    }
+
+    /** A $${ escape immediately followed by another expression start is outside the modelled grammar. */
+    static String collapse(String s, SubFlags f) {
+        while (s.contains("$" + f.prefix() + f.prefix())) {
+            s = s.replace("$" + f.prefix() + f.prefix(), f.prefix());
+        }
+        return s;
+    }
+
+    /** A template of up to eight pieces, with an unclosed variable (everything from it on is literal) at the end 15% of the time. */
+    static Generator<String> template(SubFlags f, boolean allowEscapes) {
+        Generator<String> unclosed = tuples(chance(30), NAME, literal(f)).map(t -> (t.value1() ? "$" : "") + f.prefix() + t.value2() + t.value3());
+        return tuples(lists(piece(f, allowEscapes)).maxSize(8), maybe(15, "", unclosed)).map(t -> collapse(join(t.value1()) + t.value2(), f));
+    }
+
+    /**
+     * The variables: values are plain (60%) or templates (40%), which may reference other variables (and use the
+     * escape) unless substitution in values is off; a value's reference to its own name is renamed away.
+     */
+    static Generator<Map<String, String>> vars(SubFlags f) {
+        Generator<String> value = weighted(w(60, word("abc xyz09", 0, 6)), w(40, template(f, !f.noSubInValues())));
+        return maps(NAME, value).maxSize(6).map(m -> {
+            Map<String, String> out = new LinkedHashMap<>();
+            m.forEach((name, v) -> out.put(name, f.noSubInValues() ? v : v.replace(f.prefix() + name, f.prefix() + "zz" + name)));
+            return out;
+        });
+    }
+
+    /** The reads that drain the reader, taken in turn and cycled: 0 is a read(), otherwise read(buf, 0, n). */
+    static final Generator<List<Integer>> READS = lists(weighted(w(30, just(0)), w(70, ints(1, 9)))).minSize(1).maxSize(8);
+
+    record SubCase(SubFlags flags, Map<String, String> vars, String template, List<Integer> reads) {
+        boolean defaultDelims() {
+            return flags.prefix().equals("${") && flags.suffix().equals("}");
+        }
+    }
+
+    static final Generator<SubCase> SUB_CASE = FLAGS.flatMap(f -> tuples(vars(f), template(f, true), READS).map(t -> new SubCase(f, t.value1(), t.value2(), t.value3())));
+
+    static String drain(Reader r, List<Integer> reads) throws IOException {
+        StringBuilder sb = new StringBuilder();
+        char[] buf = new char[16];
+        for (int k = 0; ; k++) {
+            int want = reads.get(k % reads.size());
+            if (want == 0) {
+                int c = r.read();
+                if (c < 0) {
+                    break;
+                }
+                sb.append((char) c);
+            } else {
+                int got = r.read(buf, 0, want);
+                if (got < 0) {
+                    break;
+                }
+                // bug commons-text/7: a variable resolving to "" makes read(buf, off, len) return 0; pinned, tolerated here
+                check(got >= 0 && got <= want, () -> "read(buf, 0, " + want + ") returned " + got + " after " + show(sb.toString()));
+                sb.append(buf, 0, got);
+            }
+        }
+        return sb.toString();
+    }
+
+    @Test
+    void stringSubstitutorFollowsTheDocumentedSyntax() {
+        Hegel.test(tc -> {
+            SubCase c = tc.draw(SUB_CASE, "case");
+            SubFlags f = c.flags();
+            Map<String, String> vars = c.vars();
+            String t = c.template();
+            StringSubstitutor sub = new StringSubstitutor(vars, f.prefix(), f.suffix())
+                .setPreserveEscapes(f.preserveEscapes())
+                .setDisableSubstitutionInValues(f.noSubInValues())
+                .setEnableUndefinedVariableException(f.undefinedThrows());
+            String want;
+            try {
+                want = modelSubstitute(t, vars, f, 0);
+            } catch (Undefined u) {
+                try {
+                    String got = sub.replace(t);
+                    fail("no exception for the undefined variable " + show(u.getMessage()) + " in " + show(t) + " -> " + show(got) + " vars " + vars);
+                } catch (IllegalArgumentException expected) {
+                    // documented
+                }
+                return;
+            } catch (IllegalStateException cycle) {
+                tc.assume(false); // the model refuses cycles through values that reach themselves via aliases
+                return;
+            } catch (ValueEscapeLeak leak) {
+                tc.assume(false); // bug commons-text/14, pinned
+                return;
+            }
+            String got;
+            try {
+                got = sub.replace(t);
+            } catch (RuntimeException e) {
+                fail("replace threw " + e + " for " + show(t) + " vars " + vars + " flags " + f);
+                return;
+            }
+            String ctx = " for " + show(t) + " vars " + vars + " flags " + f;
+            check(got.equals(want), () -> "replace(String)" + ctx + ": got " + show(got) + ", want " + show(want));
+            check(sub.replace(t.toCharArray()).equals(want), () -> "replace(char[])" + ctx);
+            check(sub.replace((CharSequence) new StringBuilder(t)).equals(want), () -> "replace(CharSequence)" + ctx);
+            StringBuilder sb = new StringBuilder(t);
+            boolean changed = sub.replaceIn(sb);
+            check(sb.toString().equals(want), () -> "replaceIn(StringBuilder)" + ctx + ": " + show(sb.toString()));
+            check(changed == !want.equals(t), () -> "replaceIn returned " + changed + ctx);
+            StringBuffer sbuf = new StringBuffer("pre" + t + "post");
+            sub.replaceIn(sbuf, 3, t.length());
+            check(sbuf.toString().equals("pre" + want + "post"), () -> "replaceIn(StringBuffer, offset, length)" + ctx + ": " + show(sbuf.toString()));
+            // bug commons-text/10: with prefix == suffix the reader pairs the delimiters differently from replace()
+            // ("$%a%%b%" -> "%a%%b%" / "%a%Y"); pinned, the reader is compared only for distinct delimiters here
+            // bug commons-text/13: with a one-character prefix the reader throws StringIndexOutOfBoundsException
+            // when the text ends with the escape character; pinned, that shape is left out here
+            if (!f.prefix().equals(f.suffix()) && !(f.prefix().length() == 1 && t.endsWith("$"))) {
+                try {
+                    String streamed = drain(new StringSubstitutorReader(new StringReader(t), sub), c.reads());
+                    check(streamed.equals(want), () -> "StringSubstitutorReader" + ctx + ": got " + show(streamed) + ", want " + show(want));
+                } catch (IOException | RuntimeException e) {
+                    fail("StringSubstitutorReader threw " + e + ctx);
+                }
+            }
+            if (c.defaultDelims() && !f.preserveEscapes() && !f.noSubInValues() && !f.undefinedThrows()) {
+                check(StringSubstitutor.replace(t, vars).equals(want), () -> "static replace(Object, Map)" + ctx);
+            }
+        }, Zoo.settings("stringSubstitutorFollowsTheDocumentedSyntax"));
+    }
