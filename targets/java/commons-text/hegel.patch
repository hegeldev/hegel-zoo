+    // ------------------------------------------------------------------ 5. WordUtils / CaseUtils
+
+    static String modelWrap(String str, int wrapLength, String nl, boolean wrapLong, char on) {
+        if (wrapLength < 1) {
+            wrapLength = 1;
+        }
+        int len = str.length();
+        StringBuilder out = new StringBuilder();
+        int offset = 0;
+        while (offset < len) {
+            // leading wrap characters are dropped at the start of every line, the last one included
+            if (str.charAt(offset) == on) {
+                offset++;
+                continue;
+            }
+            if (len - offset <= wrapLength) {
+                break;
+            }
+            int at = str.lastIndexOf(on, offset + wrapLength);
+            if (at >= offset) {
+                out.append(str, offset, at).append(nl);
+                offset = at + 1;
+            } else if (wrapLong) {
+                int cut = offset + wrapLength;
+                if (isHigh(str.charAt(cut - 1)) && isLow(str.charAt(cut))) {
+                    cut++;
+                }
+                out.append(str, offset, cut).append(nl);
+                offset = cut;
+            } else {
+                int next = str.indexOf(on, offset + wrapLength);
+                if (next >= 0) {
+                    out.append(str, offset, next).append(nl);
+                    offset = next + 1;
+                } else {
+                    out.append(str, offset, len);
+                    offset = len;
+                }
+            }
+        }
+        out.append(str, offset, len);
+        return out.toString();
+    }
+
+    interface CpMap {
+        int apply(int cp);
+    }
+
+    static java.util.function.IntPredicate delimiterSet(char[] delimiters) {
+        if (delimiters == null) {
+            return Character::isWhitespace;
+        }
+        Set<Integer> set = new HashSet<>();
+        for (char c : delimiters) {
+            set.add((int) c);
+        }
+        return set::contains;
+    }
+
+    /** capitalize/uncapitalize: the first code point and every code point after a delimiter is mapped. */
+    static String modelWordCase(String s, char[] delimiters, CpMap map) {
+        java.util.function.IntPredicate delim = delimiterSet(delimiters);
+        StringBuilder out = new StringBuilder();
+        boolean capNext = true;
+        for (int i = 0; i < s.length(); ) {
+            int cp = s.codePointAt(i);
+            i += Character.charCount(cp);
+            if (delim.test(cp)) {
+                capNext = true;
+                out.appendCodePoint(cp);
+            } else if (capNext) {
+                out.appendCodePoint(map.apply(cp));
+                capNext = false;
+            } else {
+                out.appendCodePoint(cp);
+            }
+        }
+        return out.toString();
+    }
+
+    static String modelSwapCase(String s) {
+        StringBuilder out = new StringBuilder();
+        boolean whitespace = true;
+        for (int i = 0; i < s.length(); ) {
+            int cp = s.codePointAt(i);
+            i += Character.charCount(cp);
+            int r;
+            if (Character.isUpperCase(cp) || Character.isTitleCase(cp)) {
+                r = Character.toLowerCase(cp);
+                whitespace = false;
+            } else if (Character.isLowerCase(cp)) {
+                r = whitespace ? Character.toTitleCase(cp) : Character.toUpperCase(cp);
+                whitespace = false;
+            } else {
+                r = cp;
+                whitespace = Character.isWhitespace(cp);
+            }
+            out.appendCodePoint(r);
+        }
+        return out.toString();
+    }
+
+    static String modelInitials(String s, char[] delimiters) {
+        if (delimiters != null && delimiters.length == 0) {
+            return "";
+        }
+        java.util.function.IntPredicate delim = delimiterSet(delimiters);
+        StringBuilder out = new StringBuilder();
+        boolean take = true;
+        for (int i = 0; i < s.length(); ) {
+            int cp = s.codePointAt(i);
+            i += Character.charCount(cp);
+            if (delim.test(cp)) {
+                take = true;
+            } else if (take) {
+                out.appendCodePoint(cp);
+                take = false;
+            }
+        }
+        return out.toString();
+    }
+
+    static String modelAbbreviate(String str, int lower, int upper, String append) {
+        if (str.isEmpty()) {
+            return str;
+        }
+        int len = str.length();
+        lower = Math.max(0, Math.min(lower, len));
+        upper = upper == -1 || upper > len ? len : upper;
+        int space = str.indexOf(' ', lower);
+        String tail = append == null ? "" : append;
+        if (space < 0) {
+            return str.substring(0, upper) + (upper != len ? tail : "");
+        }
+        return str.substring(0, Math.min(space, upper)) + tail;
+    }
