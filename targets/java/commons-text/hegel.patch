+    // ------------------------------------------------------------------ 3. StringTokenizer
+
+    record Tok(String text, List<String> tokens) {}
+
+    /** Fields joined by a delimiter, quoted (with doubled quotes) when they need it or at random. */
+    static Tok tokenized(TestCase tc, char delim, char quote, boolean csvTrim, boolean ignoreEmpty, boolean emptyAsNull) {
+        int count = n(tc, 0, 6);
+        List<String> fields = new ArrayList<>();
+        StringBuilder text = new StringBuilder();
+        for (int k = 0; k < count; k++) {
+            String f = Zoo.word(tc, "ab c" + delim + quote + "😀", 0, 5);
+            if (chance(tc, 20)) {
+                f = pick(tc, "", " ", "  ", "a b", " a", "a ");
+            }
+            fields.add(f);
+            boolean needsQuote = f.indexOf(delim) >= 0 || f.indexOf(quote) >= 0 || csvTrim && (f.startsWith(" ") || f.endsWith(" "));
+            if (k > 0) {
+                text.append(delim);
+            }
+            if (csvTrim && chance(tc, 30)) {
+                text.append(Zoo.word(tc, " ", 1, 2));
+            }
+            if (needsQuote || chance(tc, 30)) {
+                text.append(quote).append(f.replace(String.valueOf(quote), "" + quote + quote)).append(quote);
+            } else {
+                text.append(f);
+            }
+            if (csvTrim && chance(tc, 30)) {
+                text.append(Zoo.word(tc, " ", 1, 2));
+            }
+        }
+        List<String> tokens = new ArrayList<>();
+        if (text.length() == 0) {
+            fields.clear(); // an empty text has no tokens, not one empty token
+        }
+        for (String f : fields) {
+            if (f.isEmpty()) {
+                if (!ignoreEmpty) {
+                    tokens.add(emptyAsNull ? null : "");
+                }
+            } else {
+                tokens.add(f);
+            }
+        }
+        return new Tok(text.toString(), tokens);
+    }
+
+    @Test
+    void stringTokenizerSplitsWhatItsGrammarJoins() {
+        Hegel.test(tc -> {
+            int mode = n(tc, 0, 2);
+            StringTokenizer tok;
+            Tok data;
+            String ctx;
+            if (mode == 0) {
+                // CSV/TSV instances: trimmed, empty tokens kept
+                boolean csv = chance(tc, 50);
+                data = tokenized(tc, csv ? ',' : '\t', '"', true, false, false);
+                tok = csv ? StringTokenizer.getCSVInstance(data.text()) : StringTokenizer.getTSVInstance(data.text());
+                ctx = (csv ? "CSV" : "TSV") + " of " + show(data.text());
+            } else {
+                char delim = pick(tc, ',', ';', '|', ' ');
+                char quote = pick(tc, '"', '\'');
+                boolean ignoreEmpty = chance(tc, 50);
+                boolean emptyAsNull = chance(tc, 50);
+                data = tokenized(tc, delim, quote, false, ignoreEmpty, emptyAsNull);
+                tok = new StringTokenizer(data.text(), delim, quote).setIgnoreEmptyTokens(ignoreEmpty).setEmptyTokenAsNull(emptyAsNull);
+                ctx = "tokenizer(" + delim + ", " + quote + ", ignoreEmpty " + ignoreEmpty + ", emptyAsNull " + emptyAsNull + ") of " + show(data.text());
+            }
+            List<String> got = tok.getTokenList();
+            check(got.equals(data.tokens()), () -> ctx + ": got " + got + ", want " + data.tokens());
+            check(tok.size() == data.tokens().size(), () -> ctx + ": size " + tok.size());
+            check(Arrays.asList(tok.getTokenArray()).equals(data.tokens()), () -> ctx + ": getTokenArray");
+            // the ListIterator walks the same tokens forwards and back
+            List<String> forward = new ArrayList<>();
+            while (tok.hasNext()) {
+                forward.add(tok.next());
+            }
+            List<String> backward = new ArrayList<>();
+            while (tok.hasPrevious()) {
+                backward.add(0, tok.previous());
+            }
+            check(forward.equals(data.tokens()) && backward.equals(data.tokens()), () -> ctx + ": iteration " + forward + " / " + backward);
+            check(tok.nextToken() == null || !forward.isEmpty(), () -> ctx + ": nextToken after the end");
+            // reset with the same content tokenizes the same
+            tok.reset(data.text());
+            check(tok.getTokenList().equals(data.tokens()), () -> ctx + ": reset");
+            // clone is independent
+            StringTokenizer copy = (StringTokenizer) tok.clone();
+            check(copy.getTokenList().equals(data.tokens()) && copy.getContent().equals(data.text()), () -> ctx + ": clone");
+        }, Zoo.settings("stringTokenizerSplitsWhatItsGrammarJoins"));
+    }
