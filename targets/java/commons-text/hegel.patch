+            String reformatted = new ExtendedMessageFormat(again, Locale.US, registry).format(values);
+            check(reformatted.equals(formatted), () -> "toPattern() " + show(again) + " formats " + show(reformatted) + ", the original " + show(formatted) + ctx);
+            check(new ExtendedMessageFormat(again, Locale.US, registry).toPattern().equals(again), () -> "toPattern() is not a fixed point: " + show(again) + " -> " + show(new ExtendedMessageFormat(again, Locale.US, registry).toPattern()) + ctx);
+        }, Zoo.settings("formattableUtilsAndExtendedMessageFormatKeepTheirShape"));
+    }
+
+    // ------------------------------------------------------------------ pins
+
+    /** commons-text/4: equalsIgnoreCase(null) throws NullPointerException where the Javadoc says false. */
+    @Test
+    void pinEqualsIgnoreCaseNullIsFalse() {
+        Assertions.assertFalse(new TextStringBuilder("a").equalsIgnoreCase(null));
+    }
+
+    /** commons-text/5: indexOf("") is -1 on an empty builder (and at its end) while lastIndexOf("") finds it. */
+    @Test
+    void pinIndexOfEmptyStringIsFound() {
+        TextStringBuilder empty = new TextStringBuilder();
+        Assertions.assertEquals(0, empty.lastIndexOf(""));
+        Assertions.assertEquals(0, empty.indexOf(""));
+        Assertions.assertEquals(2, new TextStringBuilder("ab").indexOf("", 2));
+    }
+
+    /** commons-text/6: generate() never returns when no code point of the configuration is acceptable. */
+    @Test
+    void pinGenerateRefusesAnUnsatisfiableRange() throws InterruptedException {
+        Thread t = new Thread(() -> {
+            try {
+                RandomStringGenerator.builder().withinRange('a', 'z').filteredBy(CharacterPredicates.DIGITS).get().generate(1);
+            } catch (RuntimeException expected) {
+                // an exception is the acceptable outcome
+            }
+        });
+        t.setDaemon(true);
+        t.start();
+        t.join(3000);
+        Assertions.assertFalse(t.isAlive(), "generate() is still running after 3 s");
+    }
+
+    /** commons-text/12: minDecimalExponent rounding a lone digit 5 at the position just above it throws. */
+    @Test
+    void pinRoundingAHalfAwayDoesNotThrow() {
+        String out = Assertions.assertDoesNotThrow(() -> DoubleFormat.PLAIN.builder().minDecimalExponent(0).get().apply(0.5));
+        Assertions.assertEquals("0.0", out);
+        Assertions.assertDoesNotThrow(() -> DoubleFormat.SCIENTIFIC.builder().minDecimalExponent(1).get().apply(5.0));
+    }
+
+    /** commons-text/11: lastIndexOf(String, startIndex) misses a match of two or more chars that begins at startIndex. */
+    @Test
+    void pinLastIndexOfFindsAMatchAtTheStartIndex() {
+        Assertions.assertEquals(2, new TextStringBuilder("abab").lastIndexOf("ab", 2));
+        Assertions.assertEquals(0, new TextStringBuilder("aab").lastIndexOf("aa", 0));
+    }
+
+    /** commons-text/9: a literal '}' before a custom format element makes toPattern() drop the format description. */
+    @Test
+    void pinToPatternKeepsCustomFormatsAfterALiteralBrace() {
+        Map<String, FormatFactory> registry = new HashMap<>();
+        registry.put("upper", (name, arguments, locale) -> new java.text.Format() {
+            @Override
+            public StringBuffer format(Object obj, StringBuffer toAppendTo, java.text.FieldPosition pos) {
+                return toAppendTo.append(String.valueOf(obj).toUpperCase(Locale.ROOT));
+            }
+
+            @Override
+            public Object parseObject(String source, java.text.ParsePosition pos) {
+                return null;
+            }
+        });
+        Object[] values = {"x"};
+        ExtendedMessageFormat emf = new ExtendedMessageFormat("}{0,upper}", Locale.US, registry);
+        Assertions.assertEquals("}X", emf.format(values));
+        String again = emf.toPattern();
+        Assertions.assertEquals("}X", new ExtendedMessageFormat(again, Locale.US, registry).format(values), "toPattern() gave " + again);
+    }
