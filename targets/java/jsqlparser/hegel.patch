+        Generator<String> update(Table t, Scope s, int sub) {
+            List<String> data = t.dataColumns();
+            if (data.isEmpty()) {
+                return delete(t, s, sub);
+            }
+            Generator<Integer> other = tables.size() > 1 ? maybe(20, -1, INDEX) : just(-1);
+            return other.flatMap(oi -> {
+                // UPDATE ... FROM other: every column reference in SET and WHERE must be qualified (both tables have an id)
+                Table o = oi < 0 || at(tables, oi).name().equals(t.name()) ? null : at(tables, oi);
+                Scope sc = o == null ? s : new Scope(List.of(t.name(), o.name()), List.of(t.names(), o.names()), false);
+                Generator<String> sets = many(tuples(INDEX, ID_STYLE, expr(sc, 2, sub)), 1, 3).map(xs -> {
+                    Set<String> done = new LinkedHashSet<>();
+                    List<String> out = new ArrayList<>();
+                    for (var x : xs) {
+                        String c = at(data, x.value1());
+                        if (done.add(c)) {
+                            out.add(j(id(c, x.value2()), "=", x.value3()));
+                        }
+                    }
+                    return String.join(", ", out);
+                });
+                Generator<String> rowValue = data.size() < 2 ? lit("") : maybe(10, "", rowValueSet(data, sc, sub, rowValueFirst(sc, sub)));
+                Generator<String> where = o != null
+                    ? tuples(id(o.name()), condition(sc, 2, sub)).map(x -> j(kw("FROM"), x.value1(), kw("WHERE"), x.value2()))
+                    : opt(70, condition(s, 3, sub).map(c -> j(kw("WHERE"), c)));
+                // RETURNING sees the updated table only
+                return tuples(id(t.name()), sets, rowValue, where, returning(s, sub))
+                    .map(b -> j(kw("UPDATE"), b.value1(), kw("SET"), b.value3().isEmpty() ? b.value2() : b.value3(), b.value4(), b.value5()));
+            });
+        }
