+
+/**
+ * Prints a JSqlParser expression tree fully parenthesised, so that SQLite evaluates the tree's grouping rather
+ * than re-parsing the operators: `1 + 2 * 3` parsed right prints as `(1 + (2 * 3))`. Node kinds this printer
+ * does not know are printed with their own toString(), which keeps the check conservative.
+ */
+final class Paren {
+
+    private Paren() {
+    }
+
+    static String of(Expression e) {
+        if (e instanceof Column || e instanceof LongValue || e instanceof DoubleValue || e instanceof StringValue || e instanceof HexValue
+            || e instanceof NullValue || e instanceof BooleanValue) {
+            return e.toString();
+        }
+        if (e instanceof ParenthesedExpressionList<?> p) {
+            if (p.size() == 1) {
+                return "(" + of((Expression) p.get(0)) + ")";
+            }
+            return "(" + list(p) + ")";
+        }
+        if (e instanceof ParenthesedSelect) {
+            return e.toString();
+        }
+        if (e instanceof LikeExpression l) {
+            String s = of(l.getLeftExpression()) + (l.isNot() ? " NOT " : " ") + l.getLikeKeyWord() + " " + of(l.getRightExpression());
+            if (l.getEscape() != null) {
+                s += " ESCAPE " + of(l.getEscape());
+            }
+            return "(" + s + ")";
+        }
+        if (e instanceof BinaryExpression b) {
+            if (b instanceof IsDistinctExpression) {
+                return "(" + b.toString() + ")";
+            }
+            return "(" + of(b.getLeftExpression()) + " " + b.getStringExpression() + " " + of(b.getRightExpression()) + ")";
+        }
+        if (e instanceof NotExpression n) {
+            return "(NOT " + of(n.getExpression()) + ")";
+        }
+        if (e instanceof SignedExpression s) {
+            return "(" + s.getSign() + of(s.getExpression()) + ")";
+        }
+        if (e instanceof IsNullExpression i) {
+            return "(" + of(i.getLeftExpression()) + (i.isNot() ? " IS NOT NULL" : " IS NULL") + ")";
+        }
+        if (e instanceof IsBooleanExpression i) {
+            return "(" + of(i.getLeftExpression()) + " IS " + (i.isNot() ? "NOT " : "") + (i.isTrue() ? "TRUE" : "FALSE") + ")";
+        }
+        if (e instanceof Between b) {
+            return "(" + of(b.getLeftExpression()) + (b.isNot() ? " NOT BETWEEN " : " BETWEEN ") + of(b.getBetweenExpressionStart()) + " AND " + of(b.getBetweenExpressionEnd()) + ")";
+        }
+        if (e instanceof InExpression i) {
+            Expression r = i.getRightExpression();
+            String right;
+            if (r instanceof ParenthesedSelect) {
+                right = r.toString();
+            } else if (r instanceof ExpressionList<?> l) {
+                right = "(" + list(l) + ")";
+            } else {
+                right = r.toString();
+            }
+            return "(" + of(i.getLeftExpression()) + (i.isNot() ? " NOT IN " : " IN ") + right + ")";
+        }
+        if (e instanceof ExistsExpression x) {
+            return "(" + (x.isNot() ? "NOT " : "") + "EXISTS " + x.getRightExpression().toString() + ")";
+        }
+        if (e instanceof CaseExpression c) {
+            StringBuilder sb = new StringBuilder("(CASE");
+            if (c.getSwitchExpression() != null) {
+                sb.append(" ").append(of(c.getSwitchExpression()));
+            }
+            for (WhenClause w : c.getWhenClauses()) {
+                sb.append(" WHEN ").append(of(w.getWhenExpression())).append(" THEN ").append(of(w.getThenExpression()));
+            }
+            if (c.getElseExpression() != null) {
+                sb.append(" ELSE ").append(of(c.getElseExpression()));
+            }
+            return sb.append(" END)").toString();
+        }
+        if (e instanceof CastExpression c) {
+            if (!c.isUseCastKeyword() || c.getFormat() != null) {
+                return c.toString();
+            }
+            return "CAST(" + of(c.getLeftExpression()) + " AS " + c.getColDataType() + ")";
+        }
+        if (e instanceof CollateExpression c) {
+            return "(" + of(c.getLeftExpression()) + " COLLATE " + c.getCollate() + ")";
+        }
+        if (e instanceof Function f) {
+            if (f.isAllColumns() || f.getParameters() == null || f.getOrderByElements() != null || f.getHavingClause() != null || f.getKeep() != null
+                || f.getAttribute() != null || f.isIgnoreNulls() || f.getLimit() != null || f.getNamedParameters() != null || f.getExtraKeyword() != null) {
+                return f.toString();
+            }
+            return f.getName() + "(" + (f.isDistinct() ? "DISTINCT " : "") + list(f.getParameters()) + ")";
+        }
+        return e.toString();
+    }
+
+    static String list(ExpressionList<?> l) {
+        List<String> parts = new ArrayList<>();
+        for (Object o : l) {
+            parts.add(of((Expression) o));
+        }
+        return String.join(", ", parts);
+    }
+}
diff --git a/hegel/src/test/java/zoo/Raw.java b/hegel/src/test/java/zoo/Raw.java
new file mode 100644
index 0000000..ce43a26
--- /dev/null
+++ b/hegel/src/test/java/zoo/Raw.java
@@ -0,0 +1,25 @@
+package zoo;
+
+import net.sf.jsqlparser.expression.Expression;
+import net.sf.jsqlparser.expression.ExpressionVisitor;
+import net.sf.jsqlparser.parser.ASTNodeAccessImpl;
+
+/** An expression that prints as the given text — a carrier for re-parenthesised sub-trees inside a statement's toString(). */
+final class Raw extends ASTNodeAccessImpl implements Expression {
+
+    final String text;
+
+    Raw(String text) {
+        this.text = text;
+    }
+
+    @Override
+    public <T, S> T accept(ExpressionVisitor<T> visitor, S context) {
+        throw new UnsupportedOperationException("Raw is for toString() only");
+    }
+
+    @Override
+    public String toString() {
+        return text;
+    }
+}
diff --git a/hegel/src/test/java/zoo/SqlGen.java b/hegel/src/test/java/zoo/SqlGen.java
new file mode 100644
index 0000000..d975f2f
--- /dev/null
+++ b/hegel/src/test/java/zoo/SqlGen.java
@@ -0,0 +1,1406 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.TestCase;
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * A random SQL program in the dialect SQLite and JSqlParser share: a small schema (tables with rows) and one
+ * statement against it — a query, a data change or a schema change. SQLite is the oracle for acceptance and
+ * meaning, so everything generated here must be SQLite; the shapes JSqlParser does not support (SQLite's own
+ * `==`, GLOB, MATCH, `x IS y`, `NOT NULL` as a postfix, `INSERT OR IGNORE`, WITHOUT ROWID, STRICT, column-level ON
+ * CONFLICT clauses, `[bracket]` quoting) are left out, and so are the shapes of the known bugs (bugs.toml; the pins
+ * carry them): stacked unary operators, a predicate followed by IS TRUE/FALSE, `COLLATE BINARY`/`RTRIM`, type names
+ * as bare column references, `exclude` as a column name. Operators of different families (`+ -`, `* / %`, `||`,
+ * bitwise) are never mixed without parentheses: the dialects disagree on their relative precedence and
+ * JSqlParser follows the majority, not SQLite.
+ */
+final class SqlGen {
+
+    enum Kind { SELECT, DML, DDL }
+
+    record Column(String name, String type) {
+        String decl() {
+            return SqlGen.ident(name) + (type.isEmpty() ? "" : " " + type);
+        }
+    }
+
+    record Table(String name, List<Column> columns, List<List<String>> rows) {
+        /** Column names other than the id. */
+        List<String> dataColumns() {
+            List<String> out = new ArrayList<>();
+            for (Column c : columns) {
+                if (!c.name.equals("id")) {
+                    out.add(c.name);
+                }
+            }
+            return out;
+        }
+    }
+
+    record Schema(List<Table> tables) {
+        /** The CREATE TABLE and INSERT statements that build the database. */
+        List<String> setup() {
+            List<String> out = new ArrayList<>();
+            for (Table t : tables) {
+                StringBuilder sb = new StringBuilder("CREATE TABLE " + ident(t.name) + " (");
+                for (int i = 0; i < t.columns.size(); i++) {
+                    if (i > 0) {
+                        sb.append(", ");
+                    }
+                    sb.append(t.columns.get(i).decl());
+                    if (i == 0) {
+                        sb.append(" PRIMARY KEY");
+                    }
+                }
+                out.add(sb.append(")").toString());
+                for (List<String> row : t.rows) {
+                    out.add("INSERT INTO " + ident(t.name) + " VALUES (" + String.join(", ", row) + ")");
+                }
+            }
+            return out;
+        }
+
+        Table byName(String name) {
+            for (Table t : tables) {
+                if (t.name.equals(name)) {
+                    return t;
+                }
+            }
+            throw new IllegalArgumentException(name);
+        }
+    }
+
+    /** One generated statement with what the properties need to know about it. */
+    record Program(String sql, Kind kind, Schema schema, Set<String> tables, boolean ordered, boolean hasLimit, Set<String> features) {
+        @Override
+        public String toString() {
+            return sql;
+        }
+    }
+
+    /** Column-name pool: words SQLite and the JSqlParser reserved-keyword list both allow as names. */
+    static final String[] NAMES = {"a", "b", "c", "d", "val", "num", "txt", "name", "amount", "label", "flag", "total", "status", "data", "level", "year",
+        "key", "type", "date", "text", "count", "position", "result", "size", "source", "target", "user", "version", "col x", "Größe", "select", "from",
+        "abort", "action", "after", "before", "begin", "by", "cascade", "column", "conflict", "desc", "asc", "do", "each", "end", "fail", "first", "last",
+        "no", "of", "plan", "query", "range", "row", "rows", "temp", "view", "virtual", "nulls", "partition", "others", "ties", "rename", "replace", "match"};
+
+    /** Words that need quoting to be a name (space, non-ASCII, or a keyword in SQLite or JSqlParser). */
+    static final Set<String> QUOTED = Set.of("col x", "Größe", "select", "from", "match", "replace", "range", "row", "rows", "end", "do", "by", "of", "no",
+        "desc", "asc", "first", "last", "nulls", "partition", "column", "conflict", "cascade", "begin", "before", "after", "action", "abort", "each", "fail",
+        "plan", "query", "temp", "view", "virtual", "others", "ties", "rename", "key", "type", "date", "text", "count", "position", "result", "size", "source",
+        "target", "user", "version", "year", "level", "data", "status", "total", "flag", "label", "amount", "name");
+
+    /** Names the generator may write bare (plain identifiers in both parsers). */
+    static final Set<String> BARE = Set.of("a", "b", "c", "d", "val", "num", "txt", "name", "amount", "label", "flag", "total", "status", "data", "level",
+        "year", "key", "type", "date", "text", "count", "position", "result", "size", "source", "target", "user", "version", "abort", "action", "after",
+        "before", "begin", "by", "cascade", "column", "conflict", "desc", "asc", "do", "each", "end", "fail", "first", "last", "no", "of", "plan", "query",
+        "range", "row", "rows", "temp", "view", "virtual", "nulls", "partition", "others", "ties", "rename", "replace", "match");
+
+    static final String[] TEXTS = {"'a'", "'b'", "'ab'", "'it''s'", "''", "'x y'", "'Ä'", "'%'", "'_'", "'one'", "'two'", "'A'", "'\\'", "'--'", "'/*'", "';'"};
+    static final String[] REALS = {"1.5", "-0.5", "2.0", "1e2", "0.25", "3.0", ".5", "5.", "1.5e-1", "1E+1"};
+    static final String[] FUNCTIONS1 = {"abs", "length", "upper", "lower", "typeof", "hex", "quote", "trim", "ltrim", "rtrim", "unicode", "sign"};
+    static final String[] COLLATIONS = {"NOCASE", "\"BINARY\"", "\"RTRIM\""};
+
+    final TestCase tc;
+    final boolean trivia;
+    final Schema schema;
+    final Set<String> features = new LinkedHashSet<>();
+    final Set<String> tablesUsed = new LinkedHashSet<>();
+    int subqueryBudget;
+    int cteCount;
+
+    SqlGen(TestCase tc, boolean trivia) {
+        this.tc = tc;
+        this.trivia = trivia;
+        this.schema = schema(tc);
+    }
+
+    // ----- schema
+
+    static Schema schema(TestCase tc) {
+        int count = n(tc, 1, 3);
+        List<Table> tables = new ArrayList<>();
+        Set<String> usedNames = new LinkedHashSet<>();
+        for (int i = 0; i < count; i++) {
+            String tname = "t" + i;
+            List<Column> cols = new ArrayList<>();
+            cols.add(new Column("id", "INTEGER"));
+            int ncols = n(tc, 1, 4);
+            Set<String> names = new LinkedHashSet<>();
+            for (int j = 0; j < ncols; j++) {
+                String name = pick(tc, NAMES);
+                if (names.add(name)) {
+                    cols.add(new Column(name, pick(tc, "INTEGER", "INTEGER", "TEXT", "TEXT", "REAL", "", "INT", "NUMERIC", "VARCHAR(10)")));
+                }
+            }
+            int nrows = n(tc, 0, 5);
+            List<List<String>> rows = new ArrayList<>();
+            for (int r = 0; r < nrows; r++) {
+                List<String> row = new ArrayList<>();
+                row.add(String.valueOf(r + 1 + (chance(tc, 30) ? 10 : 0)));
+                for (int j = 1; j < cols.size(); j++) {
+                    row.add(value(tc, cols.get(j).type));
+                }
+                rows.add(row);
+            }
+            tables.add(new Table(tname, cols, rows));
+            usedNames.add(tname);
+        }
+        return new Schema(tables);
+    }
+
+    static String value(TestCase tc, String type) {
+        if (chance(tc, 20)) {
+            return "NULL";
+        }
+        switch (type) {
+            case "INTEGER":
+            case "INT":
+                return String.valueOf(n(tc, -3, 12));
+            case "TEXT":
+            case "VARCHAR(10)":
+                return pick(tc, TEXTS);
+            case "REAL":
+                return pick(tc, REALS);
+            default:
+                return chance(tc, 50) ? String.valueOf(n(tc, -3, 12)) : chance(tc, 50) ? pick(tc, TEXTS) : pick(tc, REALS);
+        }
+    }
+
+    // ----- lexical helpers
+
+    /** An identifier, quoted when it must be; otherwise sometimes quoted anyway. */
+    static String ident(String name) {
+        if (QUOTED.contains(name) || !name.matches("[A-Za-z_][A-Za-z0-9_]*")) {
+            return "\"" + name.replace("\"", "\"\"") + "\"";
+        }
+        return name;
+    }
+
+    String id(String name) {
+        if (!QUOTED.contains(name) && name.matches("[A-Za-z_][A-Za-z0-9_]*") && chance(tc, 12)) {
+            return chance(tc, 50) ? "\"" + name + "\"" : "`" + name + "`";
+        }
+        return ident(name);
+    }
+
+    /** A keyword, in random case when trivia is on. */
+    String kw(String k) {
+        if (!trivia) {
+            return k;
+        }
+        int mode = n(tc, 0, 9);
+        if (mode < 6) {
+            return k;
+        }
+        if (mode < 8) {
+            return k.toLowerCase();
+        }
+        StringBuilder sb = new StringBuilder();
+        for (char ch : k.toCharArray()) {
+            sb.append(chance(tc, 50) ? Character.toLowerCase(ch) : Character.toUpperCase(ch));
+        }
+        return sb.toString();
+    }
+
+    /** Separator between tokens: a space, or white space and comments when trivia is on. */
+    String sp() {
+        if (!trivia || chance(tc, 75)) {
+            return " ";
+        }
+        switch (n(tc, 0, 5)) {
+            case 0:
+                return "\n";
+            case 1:
+                return "\t";
+            case 2:
+                return "  ";
+            case 3:
+                return " /* c */ ";
+            case 4:
+                return " -- line comment\n";
+            default:
+                return "\r\n";
+        }
+    }
+
+    /** Joins parts with separators. */
+    String j(String... parts) {
+        StringBuilder sb = new StringBuilder();
+        for (String p : parts) {
+            if (p == null || p.isEmpty()) {
+                continue;
+            }
+            if (sb.length() > 0) {
+                sb.append(sp());
+            }
+            sb.append(p);
+        }
+        return sb.toString();
+    }
+
+    // ----- programs
+
+    Program program() {
+        int k = n(tc, 0, 99);
+        Kind kind = k < 60 ? Kind.SELECT : k < 85 ? Kind.DML : Kind.DDL;
+        subqueryBudget = 3;
+        String sql;
+        boolean ordered = false;
+        boolean hasLimit = false;
+        switch (kind) {
+            case SELECT: {
+                Query q = query(true);
+                sql = q.sql;
+                ordered = q.ordered;
+                hasLimit = q.hasLimit;
+                break;
+            }
+            case DML:
+                sql = dml();
+                break;
+            default:
+                sql = ddl();
+        }
+        if (trivia && chance(tc, 20)) {
+            // SQLite stores ALTER TABLE ... ADD's column text verbatim; a trailing line comment gives "incomplete input"
+            sql = sql + (sql.regionMatches(true, 0, "ALTER", 0, 5) ? "" : sp()) + ";";
+        }
+        if (trivia && chance(tc, 10)) {
+            sql = sp() + sql;
+        }
+        // a "/" alone on a line is a statement terminator for JSqlParser (SQL*Plus style): keep the divisor on its line
+        sql = sql.replaceAll("([\\r\\n])[ \\t]*/[ \\t]*\\r?\\n", "$1/ ");
+        return new Program(sql, kind, schema, new LinkedHashSet<>(tablesUsed), ordered, hasLimit, new LinkedHashSet<>(features));
+    }
+
+    // ----- expressions
+
+    /** What an expression may refer to. */
+    record Scope(List<String> aliases, List<List<String>> columns, boolean aggregates, boolean grouped, List<String> groupExprs) {
+        boolean empty() {
+            return aliases.isEmpty();
+        }
+    }
+
+    static final Scope NONE = new Scope(List.of(), List.of(), false, false, List.of());
+
+    /** A column reference from the scope, or a literal when the scope is empty. */
+    String columnRef(Scope s) {
+        if (s.empty()) {
+            return literal();
+        }
+        int i = n(tc, 0, s.aliases.size() - 1);
+        List<String> cols = s.columns.get(i);
+        String col = pick(tc, cols.toArray(new String[0]));
+        boolean qualify = !s.aliases.get(i).isEmpty() && (s.aliases.size() > 1 || chance(tc, 30));
+        return qualify ? id(s.aliases.get(i)) + "." + id(col) : id(col);
+    }
+
+    String literal() {
+        switch (n(tc, 0, 11)) {
+            case 0:
+            case 1:
+            case 2:
+                return String.valueOf(n(tc, 0, 20));
+            case 3:
+                return pick(tc, "0", "1", "100", "255", "1000", "9223372036854775807", "0x1F", "0X10", "007");
+            case 4:
+            case 5:
+                return pick(tc, TEXTS);
+            case 6:
+                return pick(tc, REALS);
+            case 7:
+                return "NULL";
+            case 8:
+                return pick(tc, "X'0F'", "X''", "x'ab'", "X'00FF'");
+            case 9:
+                return pick(tc, "TRUE", "FALSE");
+            case 10:
+                return pick(tc, "CURRENT_DATE", "'2020-01-02'", "'12:30'");
+            default:
+                return "'" + Zoo.word(tc, "abcxyz _%é", 0, 4).replace("'", "''") + "'";
+        }
+    }
+
+    /** An expression of a family: any value. */
+    String expr(Scope s, int depth) {
+        if (depth <= 0 || chance(tc, 25)) {
+            return chance(tc, 60) ? columnRef(s) : literal();
+        }
+        switch (n(tc, 0, 15)) {
+            case 0:
+            case 1:
+                return arith(s, depth);
+            case 2:
+                return concat(s, depth);
+            case 3:
+                return bitwise(s, depth);
+            case 4:
+            case 5:
+                return predicate(s, depth);
+            case 6:
+                return caseExpr(s, depth);
+            case 7:
+                return cast(s, depth);
+            case 8:
+            case 9:
+                return function(s, depth);
+            case 10:
+                return unary(s, depth);
+            case 11:
+                return "(" + expr(s, depth - 1) + ")";
+            case 12:
+                return subqueryBudget > 0 && chance(tc, 60) ? scalarSubquery(s) : literal();
+            case 13:
+                return collate(s, depth);
+            case 14:
+                return s.aggregates ? aggregate(s, depth) : columnRef(s);
+            default:
+                return logical(s, depth);
+        }
+    }
+
+    /** An operand of an arithmetic chain: something that binds tighter than + - * / % in every dialect. */
+    String term(Scope s, int depth) {
+        if (depth <= 0 || chance(tc, 40)) {
+            return chance(tc, 60) ? columnRef(s) : numberLiteral();
+        }
+        switch (n(tc, 0, 6)) {
+            case 0:
+                return "(" + expr(s, depth - 1) + ")";
+            case 1:
+                return function(s, depth - 1);
+            case 2:
+                return cast(s, depth - 1);
+            case 3:
+                return caseExpr(s, depth - 1);
+            case 4:
+                return unarySigned(s, depth - 1);
+            case 5:
+                return s.aggregates ? aggregate(s, depth - 1) : columnRef(s);
+            default:
+                return subqueryBudget > 0 ? scalarSubquery(s) : numberLiteral();
+        }
+    }
+
+    String numberLiteral() {
+        return chance(tc, 70) ? String.valueOf(n(tc, 0, 20)) : pick(tc, REALS);
+    }
+
+    /** `+ - * / %` chains; `*`-family binds tighter than `+`-family in every dialect. */
+    String arith(Scope s, int depth) {
+        int terms = n(tc, 2, 4);
+        StringBuilder sb = new StringBuilder(term(s, depth - 1));
+        for (int i = 1; i < terms; i++) {
+            String op = pick(tc, "+", "-", "*", "/", "%");
+            String right = term(s, depth - 1);
+            // a binary minus followed by a negative literal is `- -1`, fine; `--` would start a comment
+            sb.append(sp()).append(op).append(sp()).append(right);
+        }
+        return sb.toString();
+    }
+
+    String concat(Scope s, int depth) {
+        int terms = n(tc, 2, 3);
+        StringBuilder sb = new StringBuilder(term(s, depth - 1));
+        for (int i = 1; i < terms; i++) {
+            sb.append(sp()).append("||").append(sp()).append(chance(tc, 50) ? term(s, depth - 1) : pick(tc, TEXTS));
+        }
+        return sb.toString();
+    }
+
+    String bitwise(Scope s, int depth) {
+        int terms = n(tc, 2, 3);
+        StringBuilder sb = new StringBuilder(term(s, depth - 1));
+        for (int i = 1; i < terms; i++) {
+            sb.append(sp()).append(pick(tc, "&", "|", "<<", ">>")).append(sp()).append(term(s, depth - 1));
+        }
+        return sb.toString();
+    }
+
+    /** `-x`, `+x`, `~x` on a term (never stacked: bug 1), or `NOT x` on a predicate. */
+    String unary(Scope s, int depth) {
+        if (chance(tc, 50)) {
+            return unarySigned(s, depth);
+        }
+        return kw("NOT") + sp() + predicateOperand(s, depth - 1);
+    }
+
+    String unarySigned(Scope s, int depth) {
+        String operand = depth <= 0 || chance(tc, 50) ? columnRef(s) : chance(tc, 50) ? "(" + expr(s, depth - 1) + ")" : function(s, depth - 1);
+        if (operand.startsWith("-") || operand.startsWith("+") || operand.startsWith("~")) {
+            operand = "(" + operand + ")";
+        }
+        return pick(tc, "-", "-", "+", "~") + (chance(tc, 20) ? sp() : "") + operand;
+    }
+
+    /** The left operand of a comparison or predicate: a term or an arithmetic chain (tighter than comparisons everywhere). */
+    String comparand(Scope s, int depth) {
+        switch (n(tc, 0, 4)) {
+            case 0:
+                return arith(s, depth);
+            case 1:
+                return concat(s, depth);
+            default:
+                return term(s, depth);
+        }
+    }
+
+    /** An operand for NOT / AND / OR: a predicate or a parenthesised expression (never a bare comparison chain). */
+    String predicateOperand(Scope s, int depth) {
+        if (depth <= 0 || chance(tc, 30)) {
+            return chance(tc, 50) ? columnRef(s) : "(" + expr(s, depth) + ")";
+        }
+        return predicate(s, depth);
+    }
+
+    /** Comparisons, IS NULL, BETWEEN, IN, LIKE, EXISTS, IS TRUE — none chained (JSqlParser rejects `a = b = c`, SQLite allows). */
+    String predicate(Scope s, int depth) {
+        String left = comparand(s, depth - 1);
+        switch (n(tc, 0, 9)) {
+            case 0:
+            case 1:
+            case 2:
+                return j(left, pick(tc, "=", "<>", "!=", "<", ">", "<=", ">="), comparand(s, depth - 1));
+            case 3:
+                return j(left, kw("IS"), chance(tc, 40) ? kw("NOT") : "", kw("NULL"));
+            case 4:
+                return j(left, chance(tc, 30) ? kw("NOT") : "", kw("BETWEEN"), term(s, depth - 1), kw("AND"), term(s, depth - 1));
+            case 5: {
+                if (subqueryBudget > 0 && chance(tc, 30)) {
+                    return j(left, chance(tc, 30) ? kw("NOT") : "", kw("IN"), "(" + subquery(s, 1) + ")");
+                }
+                int k = n(tc, 0, 3);
+                List<String> items = new ArrayList<>();
+                for (int i = 0; i < k; i++) {
+                    items.add(chance(tc, 70) ? literal() : term(s, depth - 1));
+                }
+                return j(left, chance(tc, 30) ? kw("NOT") : "", kw("IN"), "(" + String.join(", ", items) + ")");
+            }
+            case 6: {
+                String pattern = chance(tc, 60) ? pick(tc, "'a%'", "'%b%'", "'_'", "'it''s'", "'%'", "'x!%' ESCAPE '!'", "'a\\%' ESCAPE '\\'", "'%Ä%'") : term(s, depth - 1);
+                return j(left, chance(tc, 30) ? kw("NOT") : "", kw("LIKE"), pattern);
+            }
+            case 7:
+                return j(left, kw("IS"), chance(tc, 40) ? kw("NOT") : "", pick(tc, kw("TRUE"), kw("FALSE")));
+            case 8:
+                return subqueryBudget > 0 ? j(chance(tc, 30) ? kw("NOT") : "", kw("EXISTS"), "(" + subquery(s, 1) + ")") : j(left, "=", literal());
+            default:
+                return j(left, kw("IS"), chance(tc, 50) ? kw("NOT") : "", kw("DISTINCT"), kw("FROM"), comparand(s, depth - 1));
+        }
+    }
+
+    /** AND / OR / NOT over predicates. */
+    String logical(Scope s, int depth) {
+        int terms = n(tc, 2, 3);
+        StringBuilder sb = new StringBuilder(notMaybe(s, depth - 1));
+        for (int i = 1; i < terms; i++) {
+            sb.append(sp()).append(kw(pick(tc, "AND", "OR"))).append(sp()).append(notMaybe(s, depth - 1));
+        }
+        return sb.toString();
+    }
+
+    String notMaybe(Scope s, int depth) {
+        String p = predicateOperand(s, depth);
+        return chance(tc, 25) ? kw("NOT") + sp() + p : p;
+    }
+
+    /** A condition for WHERE / HAVING / ON: a predicate or a logical combination. */
+    String condition(Scope s, int depth) {
+        switch (n(tc, 0, 4)) {
+            case 0:
+            case 1:
+                return predicate(s, depth);
+            case 2:
+                return logical(s, depth);
+            case 3:
+                return columnRef(s);
+            default:
+                return kw("NOT") + sp() + predicateOperand(s, depth - 1);
+        }
+    }
+
+    String caseExpr(Scope s, int depth) {
+        StringBuilder sb = new StringBuilder(kw("CASE"));
+        boolean simple = chance(tc, 40);
+        if (simple) {
+            sb.append(sp()).append(noSign(term(s, depth - 1)));
+        }
+        int whens = n(tc, 1, 3);
+        for (int i = 0; i < whens; i++) {
+            sb.append(sp()).append(kw("WHEN")).append(sp()).append(simple ? term(s, depth - 1) : condition(s, depth - 1));
+            sb.append(sp()).append(kw("THEN")).append(sp()).append(expr(s, depth - 1));
+        }
+        if (chance(tc, 60)) {
+            sb.append(sp()).append(kw("ELSE")).append(sp()).append(expr(s, depth - 1));
+        }
+        return sb.append(sp()).append(kw("END")).toString();
+    }
+
+    String cast(Scope s, int depth) {
+        String e = expr(s, depth - 1);
+        // bug castCondition: JSqlParser takes no comparison, predicate or AND/OR as the operand of CAST unless parenthesised
+        if ((" " + e).matches("(?is).*(\\s(OR|AND|XOR|IS|BETWEEN|IN|LIKE|NOT|EXISTS)[\\s(]|[=<>]).*")) {
+            e = "(" + e + ")";
+        }
+        return kw("CAST") + "(" + e + sp() + kw("AS") + sp() + pick(tc, "INTEGER", "INT", "REAL", "TEXT", "NUMERIC", "BLOB", "VARCHAR(5)", "CHAR(2)") + ")";
+    }
+
+    String collate(Scope s, int depth) {
+        String c = pick(tc, COLLATIONS);
+        String operand = term(s, depth - 1);
+        if (operand.matches("(?is).*\\s(NULL|TRUE|FALSE)\\s*$")) {
+            operand = "(" + operand + ")"; // bug collateAfterIsNull
+        } else if (operand.matches("(?is).*\\bESCAPE\\s+'[^']*'\\s*$")) {
+            operand = "(" + operand + ")"; // bug likeEscapeCollate: `a LIKE 'x' ESCAPE '!' COLLATE NOCASE` is rejected
+        }
+        return j(operand, kw("COLLATE"), c);
+    }
+
+    String function(Scope s, int depth) {
+        switch (n(tc, 0, 12)) {
+            case 0:
+            case 1:
+                return pick(tc, FUNCTIONS1) + "(" + expr(s, depth - 1) + ")";
+            case 2:
+                return "coalesce(" + expr(s, depth - 1) + ", " + expr(s, depth - 1) + (chance(tc, 30) ? ", " + literal() : "") + ")";
+            case 3:
+                return pick(tc, "ifnull", "nullif") + "(" + expr(s, depth - 1) + ", " + expr(s, depth - 1) + ")";
+            case 4:
+                return "substr(" + expr(s, depth - 1) + ", " + n(tc, -2, 3) + (chance(tc, 50) ? ", " + n(tc, 0, 3) : "") + ")";
+            case 5:
+                return "replace(" + expr(s, depth - 1) + ", " + pick(tc, TEXTS) + ", " + pick(tc, TEXTS) + ")";
+            case 6:
+                return "instr(" + expr(s, depth - 1) + ", " + pick(tc, TEXTS) + ")";
+            case 7:
+                return "round(" + expr(s, depth - 1) + (chance(tc, 50) ? ", " + n(tc, 0, 3) : "") + ")";
+            case 8:
+                return pick(tc, "min", "max") + "(" + expr(s, depth - 1) + ", " + expr(s, depth - 1) + ")";
+            case 9:
+                return "iif(" + condition(s, depth - 1) + ", " + expr(s, depth - 1) + ", " + expr(s, depth - 1) + ")";
+            case 10:
+                return "printf('%s|%d', " + expr(s, depth - 1) + ", " + expr(s, depth - 1) + ")";
+            case 11:
+                return "char(" + n(tc, 65, 90) + ", " + n(tc, 97, 122) + ")";
+            default:
+                return "length(" + expr(s, depth - 1) + ")";
+        }
+    }
+
+    /** An aggregate over the scope's rows (only where the scope allows aggregates). */
+    String aggregate(Scope s, int depth) {
+        String arg = s.empty() ? literal() : chance(tc, 70) ? columnRef(s) : expr(new Scope(s.aliases, s.columns, false, false, s.groupExprs), depth - 1);
+        String f;
+        switch (n(tc, 0, 8)) {
+            case 0:
+                f = "count(*)";
+                break;
+            case 1:
+                f = "count(" + (chance(tc, 30) ? kw("DISTINCT") + " " : "") + arg + ")";
+                break;
+            case 2:
+                f = pick(tc, "sum", "total", "avg") + "(" + (chance(tc, 20) ? kw("DISTINCT") + " " : "") + arg + ")";
+                break;
+            case 3:
+                f = pick(tc, "min", "max") + "(" + arg + ")";
+                break;
+            case 4:
+                f = "group_concat(" + arg + (chance(tc, 50) ? ", " + pick(tc, "','", "';'", "'-'") : "") + " " + kw("ORDER BY") + " " + arg + (chance(tc, 30) ? " " + kw("DESC") : "") + ")";
+                break;
+            case 5:
+                f = "group_concat(" + kw("DISTINCT") + " " + arg + ")";
+                features.add("groupConcatDistinct");
+                break;
+            default:
+                f = pick(tc, "sum", "min", "max", "count") + "(" + arg + ")";
+        }
+        if (chance(tc, 20)) {
+            f = f + " " + kw("FILTER") + " (" + kw("WHERE") + " " + condition(new Scope(s.aliases, s.columns, false, false, s.groupExprs), depth - 1) + ")";
+        }
+        return f;
+    }
+
+    /** A window function call over the scope (aggregates as windows, or ranking functions). */
+    String window(Scope s, int depth, List<String> orderKeys) {
+        Scope plain = new Scope(s.aliases, s.columns, false, false, s.groupExprs);
+        String arg = plain.empty() ? literal() : columnRef(plain);
+        String f;
+        switch (n(tc, 0, 5)) {
+            case 0:
+                f = "row_number()";
+                break;
+            case 1:
+                f = pick(tc, "rank()", "dense_rank()", "cume_dist()", "percent_rank()");
+                break;
+            case 2:
+                f = pick(tc, "sum", "min", "max", "count", "avg", "total") + "(" + arg + ")";
+                break;
+            case 3:
+                f = pick(tc, "lag", "lead") + "(" + arg + (chance(tc, 50) ? ", 1" + (chance(tc, 50) ? ", " + literal() : "") : "") + ")";
+                break;
+            case 4:
+                f = pick(tc, "first_value", "last_value") + "(" + arg + ")";
+                break;
+            default:
+                f = "nth_value(" + arg + ", " + n(tc, 1, 3) + ")";
+        }
+        StringBuilder over = new StringBuilder();
+        if (chance(tc, 40)) {
+            over.append(kw("PARTITION BY")).append(" ").append(arg);
+        }
+        // the ordering must be total: every row's keys (ids) come last
+        StringBuilder ob = new StringBuilder();
+        if (chance(tc, 40)) {
+            ob.append(expr(plain, 1)).append(chance(tc, 50) ? " " + kw("DESC") : "").append(", ");
+        }
+        ob.append(String.join(", ", orderKeys));
+        if (over.length() > 0) {
+            over.append(" ");
+        }
+        over.append(kw("ORDER BY")).append(" ").append(ob);
+        if (chance(tc, 40)) {
+            String mode = pick(tc, "ROWS", "RANGE", "GROUPS");
+            int frame = n(tc, 0, 3);
+            if (frame == 3 && mode.equals("RANGE")) {
+                mode = "ROWS"; // RANGE with offsets needs exactly one ORDER BY expression
+            }
+            over.append(" ").append(mode).append(" ");
+            switch (frame) {
+                case 0:
+                    over.append(kw("UNBOUNDED PRECEDING"));
+                    break;
+                case 1:
+                    over.append(kw("BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW"));
+                    break;
+                case 2:
+                    over.append(kw("BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING"));
+                    break;
+                default:
+                    over.append(kw("BETWEEN 1 PRECEDING AND 1 FOLLOWING"));
+            }
+            if (chance(tc, 30)) {
+                over.append(" ").append(kw("EXCLUDE")).append(" ").append(pick(tc, "NO OTHERS", "CURRENT ROW", "TIES"));
+            }
+        }
+        return f + " " + kw("OVER") + " (" + over + ")";
+    }
+
+    String scalarSubquery(Scope outer) {
+        return "(" + subquery(outer, 1) + ")";
+    }
+
+    // ----- queries
+
+    /** A query and what the property needs to know: whether its rows are totally ordered, whether it has LIMIT. */
+    record Query(String sql, boolean ordered, boolean hasLimit, List<String> columns) {
+    }
+
+    /** A subquery producing `width` columns (a plain select against one table, possibly correlated to the outer scope). */
+    String subquery(Scope outer, int width) {
+        subqueryBudget--;
+        Table t = pick(tc, schema.tables.toArray(new Table[0]));
+        tablesUsed.add(t.name);
+        String alias = chance(tc, 50) ? "s" + n(tc, 0, 9) : t.name;
+        List<String> aliases = new ArrayList<>();
+        List<List<String>> columns = new ArrayList<>();
+        aliases.add(alias);
+        columns.add(names(t));
+        if (chance(tc, 40) && !outer.empty()) {
+            for (int i = 0; i < outer.aliases.size(); i++) {
+                if (!outer.aliases.get(i).equals(alias)) {
+                    aliases.add(outer.aliases.get(i));
+                    columns.add(outer.columns.get(i));
+                }
+            }
+        }
+        Scope s = new Scope(aliases, columns, false, false, List.of());
+        boolean agg = chance(tc, 30);
+        Scope aggScope = new Scope(List.of(alias), List.of(names(t)), true, false, List.of());
+        List<String> items = new ArrayList<>();
+        for (int i = 0; i < width; i++) {
+            items.add(agg ? aggregate(aggScope, 1) : expr(s, 1));
+        }
+        String sql = j(kw("SELECT"), String.join(", ", items), kw("FROM"), id(t.name), alias.equals(t.name) ? "" : (chance(tc, 50) ? kw("AS") + sp() : "") + alias);
+        if (chance(tc, 50)) {
+            sql = j(sql, kw("WHERE"), condition(s, 1));
+        }
+        if (!agg && chance(tc, 30)) {
+            sql = j(sql, kw("ORDER BY"), id(alias) + ".id", kw("LIMIT"), String.valueOf(n(tc, 0, 3)));
+        }
+        return sql;
+    }
+
+    /** A bare integer literal in GROUP BY / ORDER BY is a column index in SQLite: parenthesise it to keep it a value. */
+    static String noIndex(String e) {
+        // SQLite looks through parentheses and signs: `(15)`, `-1`, `0x10` are indexes too; `15 + 0` is a value
+        String bare = e.replaceAll("/\\*.*?\\*/", " ").replaceAll("--[^\\n]*\\n", " ").replaceAll("(?is)\\s*COLLATE\\s+\"?\\w+\"?\\s*$", "");
+        return bare.matches("[-+()\\s]*(\\d+|0[xX][0-9A-Fa-f]+)[()\\s]*") ? "(" + e + ") + 0" : e;
+    }
+
+    /** bug caseSignedOperand: JSqlParser rejects a CASE operand starting with a sign (`CASE -1 WHEN …`). */
+    static String noSign(String e) {
+        return e.startsWith("-") || e.startsWith("+") ? "(" + e + ")" : e;
+    }
+
+    static List<String> names(Table t) {
+        List<String> out = new ArrayList<>();
+        for (Column c : t.columns) {
+            out.add(c.name);
+        }
+        return out;
+    }
+
+    /** A top-level query: a plain select, a compound, a VALUES, possibly under WITH. */
+    Query query(boolean top) {
+        int k = n(tc, 0, 9);
+        if (k == 0 && top) {
+            return values();
+        }
+        if (k <= 2 && top) {
+            return compound();
+        }
+        if (k == 3 && top && cteCount == 0) {
+            return withQuery();
+        }
+        return plainSelect(top, null);
+    }
+
+    Query values() {
+        int width = n(tc, 1, 3);
+        int rows = n(tc, 1, 3);
+        List<String> rs = new ArrayList<>();
+        for (int r = 0; r < rows; r++) {
+            List<String> vs = new ArrayList<>();
+            for (int i = 0; i < width; i++) {
+                vs.add(chance(tc, 70) ? literal() : expr(NONE, 1));
+            }
+            rs.add("(" + String.join(", ", vs) + ")");
+        }
+        String sql = j(kw("VALUES"), String.join("," + sp(), rs));
+        if (chance(tc, 40)) {
+            sql = j(kw("SELECT"), "*", kw("FROM"), "(" + sql + ")" + (chance(tc, 50) ? sp() + kw("AS") + sp() + "v" : ""));
+        }
+        return new Query(sql, false, false, List.of());
+    }
+
+    Query withQuery() {
+        cteCount++;
+        String name = pick(tc, "cte", "w", "\"c t\"");
+        Table t = pick(tc, schema.tables.toArray(new Table[0]));
+        tablesUsed.add(t.name);
+        List<String> cols = names(t);
+        boolean explicitCols = chance(tc, 40);
+        String body = j(kw("SELECT"), explicitCols || chance(tc, 50) ? String.join(", ", idAll(cols)) : "*", kw("FROM"), id(t.name));
+        if (chance(tc, 40)) {
+            body = j(body, kw("WHERE"), condition(new Scope(List.of(t.name), List.of(cols), false, false, List.of()), 1));
+        }
+        List<String> cteCols = new ArrayList<>();
+        for (int i = 0; i < cols.size(); i++) {
+            cteCols.add(explicitCols ? "c" + i : cols.get(i));
+        }
+        String head = j(kw("WITH"), chance(tc, 20) ? kw("RECURSIVE") : "", name + (explicitCols ? " (" + String.join(", ", cteCols) + ")" : ""), kw("AS"),
+            chance(tc, 20) ? kw(pick(tc, "MATERIALIZED", "NOT MATERIALIZED")) : "", "(" + body + ")");
+        Table cte = new Table(name.replace("\"", ""), tableOf(cteCols), List.of());
+        Query main = plainSelect(true, cte);
+        return new Query(j(head, main.sql), main.ordered, main.hasLimit, main.columns);
+    }
+
+    static List<Column> tableOf(List<String> cols) {
+        List<Column> out = new ArrayList<>();
+        for (String c : cols) {
+            out.add(new Column(c, ""));
+        }
+        return out;
+    }
+
+    List<String> idAll(List<String> cols) {
+        List<String> out = new ArrayList<>();
+        for (String c : cols) {
+            out.add(id(c));
+        }
+        return out;
+    }
+
+    Query compound() {
+        int members = n(tc, 2, 3);
+        int width = n(tc, 1, 2);
+        List<String> parts = new ArrayList<>();
+        for (int i = 0; i < members; i++) {
+            Table t = pick(tc, schema.tables.toArray(new Table[0]));
+            tablesUsed.add(t.name);
+            Scope s = new Scope(List.of(t.name), List.of(names(t)), false, false, List.of());
+            List<String> items = new ArrayList<>();
+            for (int w = 0; w < width; w++) {
+                items.add(expr(s, 1));
+            }
+            String p = j(kw("SELECT"), chance(tc, 20) ? kw("DISTINCT") : "", String.join(", ", items), kw("FROM"), id(t.name));
+            if (chance(tc, 40)) {
+                p = j(p, kw("WHERE"), condition(s, 1));
+            }
+            parts.add(p);
+        }
+        StringBuilder sb = new StringBuilder(parts.get(0));
+        for (int i = 1; i < parts.size(); i++) {
+            sb.append(sp()).append(kw(pick(tc, "UNION", "UNION ALL", "INTERSECT", "EXCEPT"))).append(sp()).append(parts.get(i));
+        }
+        boolean ordered = false;
+        if (chance(tc, 50)) {
+            List<String> keys = new ArrayList<>();
+            for (int w = 1; w <= width; w++) {
+                keys.add(w + (chance(tc, 40) ? " " + kw("DESC") : ""));
+            }
+            sb.append(sp()).append(kw("ORDER BY")).append(sp()).append(String.join(", ", keys));
+            ordered = true;
+        }
+        return new Query(sb.toString(), ordered, false, List.of());
+    }
+
+    /** A plain SELECT with FROM (tables/joins/subquery/the CTE), WHERE, GROUP BY, HAVING, ORDER BY, LIMIT. */
+    Query plainSelect(boolean top, Table cte) {
+        List<String> aliases = new ArrayList<>();
+        List<List<String>> columns = new ArrayList<>();
+        List<String> idKeys = new ArrayList<>();
+        StringBuilder from = new StringBuilder();
+        boolean noFrom = cte == null && chance(tc, 8);
+        boolean hasNatural = false;
+        if (!noFrom) {
+            int sources = n(tc, 1, 3);
+            for (int i = 0; i < sources; i++) {
+                String alias;
+                List<String> cols;
+                String item;
+                if (i == 0 && cte != null) {
+                    alias = cte.name;
+                    cols = names(cte);
+                    item = ident(cte.name);
+                } else if (subqueryBudget > 0 && chance(tc, 15)) {
+                    Table t = pick(tc, schema.tables.toArray(new Table[0]));
+                    tablesUsed.add(t.name);
+                    subqueryBudget--;
+                    alias = "d" + i;
+                    cols = names(t);
+                    item = "(" + j(kw("SELECT"), "*", kw("FROM"), id(t.name)) + ")" + sp() + (chance(tc, 50) ? kw("AS") + sp() : "") + alias;
+                } else {
+                    Table t = pick(tc, schema.tables.toArray(new Table[0]));
+                    tablesUsed.add(t.name);
+                    cols = names(t);
+                    if (chance(tc, 50) || aliases.contains(t.name)) {
+                        alias = "x" + i;
+                        item = j(id(t.name), chance(tc, 50) ? kw("AS") : "", alias);
+                    } else {
+                        alias = t.name;
+                        item = id(t.name);
+                    }
+                }
+                if (i == 0) {
+                    from.append(item);
+                } else {
+                    String join = pick(tc, ",", "JOIN", "INNER JOIN", "LEFT JOIN", "LEFT OUTER JOIN", "CROSS JOIN", "NATURAL JOIN", "JOIN", "LEFT JOIN");
+                    if (join.equals(",")) {
+                        from.append(",").append(sp()).append(item);
+                    } else {
+                        String block = sp() + kw(join) + sp() + item;
+                        from.append(block);
+                        if (join.startsWith("NATURAL") && !(cols.contains("id") && columns.stream().allMatch(cs -> cs.contains("id")))) {
+                            from.setLength(from.length() - block.length());
+                            from.append(sp()).append(kw("CROSS JOIN")).append(sp()).append(item);
+                        } else if (join.startsWith("NATURAL")) {
+                            hasNatural = true;
+                        } else if (!join.equals("CROSS JOIN") && chance(tc, 80)) {
+                            if (chance(tc, 25) && cols.contains("id") && columns.stream().allMatch(cs -> cs.contains("id"))) {
+                                from.append(sp()).append(kw("USING")).append(" (id)");
+                                hasNatural = true;
+                            } else {
+                                List<String> a2 = new ArrayList<>(aliases);
+                                a2.add(alias);
+                                List<List<String>> c2 = new ArrayList<>(columns);
+                                c2.add(cols);
+                                from.append(sp()).append(kw("ON")).append(sp()).append(condition(new Scope(a2, c2, false, false, List.of()), 2));
+                            }
+                        }
+                    }
+                }
+                aliases.add(alias);
+                columns.add(cols);
+                idKeys.add(ident(alias) + "." + ident(cols.get(0)));
+            }
+        }
+        Scope plain = new Scope(aliases, columns, false, false, List.of());
+        boolean grouped = !noFrom && chance(tc, 25);
+        boolean wholeAgg = !grouped && !noFrom && chance(tc, 12);
+        List<String> groupExprs = new ArrayList<>();
+        if (grouped) {
+            int k = n(tc, 1, 2);
+            for (int i = 0; i < k; i++) {
+                groupExprs.add(chance(tc, 70) ? columnRef(plain) : noIndex(expr(plain, 1)));
+            }
+        }
+        Scope itemScope = grouped ? new Scope(aliases, columns, true, true, groupExprs) : wholeAgg ? new Scope(aliases, columns, true, false, List.of()) : plain;
+        List<String> items = new ArrayList<>();
+        List<String> itemNames = new ArrayList<>();
+        int nItems = n(tc, 1, 4);
+        boolean star = false;
+        boolean windowed = false;
+        for (int i = 0; i < nItems; i++) {
+            String e;
+            if (grouped) {
+                e = chance(tc, 50) ? aggregate(itemScope, 2) : pick(tc, groupExprs.toArray(new String[0]));
+            } else if (wholeAgg) {
+                e = aggregate(itemScope, 2);
+            } else if (!noFrom && i == 0 && chance(tc, 15)) {
+                e = chance(tc, 50) || aliases.size() == 1 && chance(tc, 50) ? "*" : id(pick(tc, aliases.toArray(new String[0]))) + ".*";
+                star = true;
+                items.add(e);
+                itemNames.add("*");
+                continue;
+            } else if (!noFrom && !hasNatural && chance(tc, 12)) {
+                e = window(plain, 2, idKeys);
+                windowed = true;
+            } else {
+                e = expr(plain, 3);
+            }
+            String alias = null;
+            if (chance(tc, 45)) {
+                alias = pick(tc, "r" + i, "\"r " + i + "\"", "res" + i, "'q" + i + "'");
+                e = j(e, chance(tc, 60) ? kw("AS") : "", alias);
+            }
+            items.add(e);
+            itemNames.add(alias == null ? null : alias.startsWith("'") ? "\"" + alias.substring(1, alias.length() - 1) + "\"" : alias);
+        }
+        StringBuilder sb = new StringBuilder(kw("SELECT"));
+        if (!star && chance(tc, 15)) {
+            sb.append(sp()).append(kw(pick(tc, "DISTINCT", "ALL")));
+        }
+        sb.append(sp()).append(String.join("," + sp(), items));
+        if (!noFrom) {
+            sb.append(sp()).append(kw("FROM")).append(sp()).append(from);
+        }
+        if (!noFrom && chance(tc, 55)) {
+            sb.append(sp()).append(kw("WHERE")).append(sp()).append(condition(plain, 3));
+        }
+        if (grouped) {
+            sb.append(sp()).append(kw("GROUP BY")).append(sp()).append(String.join(", ", groupExprs));
+            if (chance(tc, 40)) {
+                sb.append(sp()).append(kw("HAVING")).append(sp()).append(condition(itemScope, 2));
+            }
+        }
+        boolean ordered = false;
+        boolean total = false;
+        if (chance(tc, 45)) {
+            List<String> keys = new ArrayList<>();
+            int k = n(tc, 1, 2);
+            for (int i = 0; i < k; i++) {
+                String key;
+                if (grouped) {
+                    key = chance(tc, 50) ? pick(tc, groupExprs.toArray(new String[0])) : String.valueOf(n(tc, 1, items.size()));
+                } else if (chance(tc, 30)) {
+                    key = String.valueOf(n(tc, 1, items.size()));
+                } else if (chance(tc, 30) && itemNames.stream().anyMatch(x -> x != null && !x.equals("*"))) {
+                    List<String> named = new ArrayList<>();
+                    for (String nm : itemNames) {
+                        if (nm != null && !nm.equals("*")) {
+                            named.add(nm);
+                        }
+                    }
+                    key = pick(tc, named.toArray(new String[0]));
+                } else {
+                    key = noIndex(expr(plain, 1));
+                }
+                if (chance(tc, 30) && !key.matches("(?is).*\\s(NULL|TRUE|FALSE)\\s*$") && !key.matches("(?is).*\\bCOLLATE\\b.*")
+                        && !key.matches("(?is).*\\bESCAPE\\s+'[^']*'\\s*$")) {
+                    // (and no chained COLLATE: JSqlParser rejects `x COLLATE a COLLATE b`, SQLite takes the first)
+                    // bug collateAfterIsNull: `x IS NULL COLLATE NOCASE` is rejected (every other predicate takes COLLATE)
+                    // bug likeEscapeCollate: `a LIKE 'x' ESCAPE '!' COLLATE NOCASE` is rejected
+                    key = j(key, kw("COLLATE"), pick(tc, "NOCASE", "\"BINARY\""));
+                }
+                if (chance(tc, 40)) {
+                    key = j(key, kw(pick(tc, "ASC", "DESC")));
+                }
+                if (chance(tc, 25)) {
+                    key = j(key, kw(pick(tc, "NULLS FIRST", "NULLS LAST")));
+                }
+                keys.add(key);
+            }
+            if (!grouped && !wholeAgg && !noFrom && !star && chance(tc, 60) && !hasNatural) {
+                // a total order: the row keys last
+                keys.addAll(idKeys);
+                total = true;
+            }
+            sb.append(sp()).append(kw("ORDER BY")).append(sp()).append(String.join(", ", keys));
+            ordered = true;
+        }
+        boolean hasLimit = false;
+        if (total && chance(tc, 50) || (noFrom || wholeAgg) && chance(tc, 20)) {
+            hasLimit = true;
+            if (chance(tc, 70)) {
+                sb.append(sp()).append(kw("LIMIT")).append(sp()).append(pick(tc, "0", "1", "2", "3", "-1", "10"));
+                if (chance(tc, 50)) {
+                    sb.append(sp()).append(kw("OFFSET")).append(sp()).append(n(tc, 0, 3));
+                }
+            } else {
+                sb.append(sp()).append(kw("LIMIT")).append(sp()).append(n(tc, 0, 2)).append(", ").append(n(tc, 0, 3));
+            }
+        }
+        if (windowed) {
+            features.add("window");
+        }
+        // rows are comparable in order only under a total order; otherwise as a multiset
+        return new Query(sb.toString(), ordered && (total || noFrom), hasLimit, itemNames);
+    }
+
+    // ----- DML
+
+    String dml() {
+        Table t = pick(tc, schema.tables.toArray(new Table[0]));
+        tablesUsed.add(t.name);
+        Scope s = new Scope(List.of(t.name), List.of(names(t)), false, false, List.of());
+        switch (n(tc, 0, 9)) {
+            case 0:
+            case 1:
+            case 2:
+            case 3:
+                return insert(t, s);
+            case 4:
+            case 5:
+            case 6:
+                return update(t, s);
+            default:
+                return delete(t, s);
+        }
+    }
+
+    String returning(Scope s) {
+        if (!chance(tc, 35)) {
+            return "";
+        }
+        if (chance(tc, 40)) {
+            return j(kw("RETURNING"), "*");
+        }
+        List<String> items = new ArrayList<>();
+        int k = n(tc, 1, 2);
+        for (int i = 0; i < k; i++) {
+            items.add(j(expr(s, 1), chance(tc, 30) ? kw("AS") + sp() + "r" + i : ""));
+        }
+        return j(kw("RETURNING"), String.join(", ", items));
+    }
+
+    String insert(Table t, Scope s) {
+        List<String> data = t.dataColumns();
+        String head = kw("INSERT") + (chance(tc, 15) ? sp() + kw("OR REPLACE") : "");
+        if (chance(tc, 10)) {
+            head = kw("REPLACE");
+        }
+        // bug replaceLikeInsert: REPLACE / INSERT OR REPLACE take neither DEFAULT VALUES nor RETURNING in JSqlParser
+        boolean replace = head.toUpperCase().contains("REPLACE");
+        head = j(head, kw("INTO"), id(t.name));
+        int k = n(tc, 0, 9);
+        if (k == 0 && !replace) {
+            return j(head, kw("DEFAULT VALUES"), returning(s));
+        }
+        // the column list: a subset (never the id, unless explicitly with a fresh value)
+        List<String> cols = new ArrayList<>();
+        boolean withId = chance(tc, 30);
+        if (withId) {
+            cols.add("id");
+        }
+        for (String c : data) {
+            if (chance(tc, 70)) {
+                cols.add(c);
+            }
+        }
+        boolean listed = !cols.isEmpty() && chance(tc, 80);
+        if (!listed) {
+            cols = names(t);
+            withId = true;
+        }
+        String colList = listed ? " (" + String.join(", ", idAll(cols)) + ")" : "";
+        String tail;
+        boolean upsertable = true;
+        if (k <= 6) {
+            int rows = n(tc, 1, 3);
+            List<String> rs = new ArrayList<>();
+            for (int r = 0; r < rows; r++) {
+                List<String> vs = new ArrayList<>();
+                for (String c : cols) {
+                    if (c.equals("id")) {
+                        vs.add(chance(tc, 30) ? "NULL" : String.valueOf(n(tc, 1, 20)));
+                    } else {
+                        vs.add(chance(tc, 60) ? literal() : expr(NONE, 2));
+                    }
+                }
+                rs.add("(" + String.join(", ", vs) + ")");
+            }
+            tail = j(kw("VALUES"), String.join("," + sp(), rs));
+        } else {
+            Table src = pick(tc, schema.tables.toArray(new Table[0]));
+            tablesUsed.add(src.name);
+            Scope ss = new Scope(List.of(src.name), List.of(names(src)), false, false, List.of());
+            List<String> items = new ArrayList<>();
+            for (String c : cols) {
+                items.add(c.equals("id") ? "NULL" : expr(ss, 1));
+            }
+            tail = j(kw("SELECT"), String.join(", ", items), kw("FROM"), id(src.name));
+            // SQLite wants a WHERE clause between INSERT ... SELECT and an upsert (the ON would read as a join constraint)
+            upsertable = chance(tc, 50);
+            if (upsertable) {
+                tail = j(tail, kw("WHERE"), condition(ss, 2));
+            }
+            if (chance(tc, 30)) {
+                tail = j(tail, kw("ORDER BY"), id(src.name) + ".id", kw("LIMIT"), String.valueOf(n(tc, 0, 3)));
+            }
+        }
+        String sql = head + colList + sp() + tail;
+        if (withId && upsertable && chance(tc, 40) && !replace) {
+            if (chance(tc, 50) || data.isEmpty()) {
+                sql = j(sql, kw("ON CONFLICT"), chance(tc, 50) ? "(id)" : "", kw("DO NOTHING"));
+            } else {
+                String c = pick(tc, data.toArray(new String[0]));
+                sql = j(sql, kw("ON CONFLICT"), "(id)", kw("DO UPDATE SET"), id(c), "=", chance(tc, 50) ? "excluded." + id(c) : expr(s, 1),
+                    chance(tc, 30) ? j(kw("WHERE"), condition(s, 1)) : "");
+            }
+        }
+        return replace ? sql : j(sql, returning(s));
+    }
+
+    String update(Table t, Scope s) {
+        List<String> data = t.dataColumns();
+        if (data.isEmpty()) {
+            return delete(t, s);
+        }
+        String head = j(kw("UPDATE"), id(t.name), kw("SET"));
+        List<String> sets = new ArrayList<>();
+        Set<String> done = new LinkedHashSet<>();
+        // UPDATE ... FROM other: every column reference in SET and WHERE must be qualified (both tables have an id)
+        Table other = null;
+        Scope single = s;
+        if (chance(tc, 20) && schema.tables.size() > 1) {
+            Table o = pick(tc, schema.tables.toArray(new Table[0]));
+            if (!o.name.equals(t.name)) {
+                other = o;
+                tablesUsed.add(other.name);
+                s = new Scope(List.of(t.name, other.name), List.of(names(t), names(other)), false, false, List.of());
+            }
+        }
+        int k = n(tc, 1, 3);
+        for (int i = 0; i < k; i++) {
+            String c = pick(tc, data.toArray(new String[0]));
+            if (done.add(c)) {
+                sets.add(j(id(c), "=", expr(s, 2)));
+            }
+        }
+        if (chance(tc, 10) && data.size() >= 2) {
+            sets.clear();
+            // bug rowValueSetStartsWithSubquery: JSqlParser takes a first element starting with "(" for the whole
+            // right-hand side, so the first element must not begin with a parenthesis.
+            String first = expr(s, 1);
+            while (first.startsWith("(")) {
+                first = expr(s, 1);
+            }
+            sets.add("(" + id(data.get(0)) + ", " + id(data.get(1)) + ") = (" + first + ", " + expr(s, 1) + ")");
+        }
+        String sql = j(head, String.join(", ", sets));
+        if (other != null) {
+            sql = j(sql, kw("FROM"), id(other.name), kw("WHERE"), condition(s, 2));
+            return j(sql, returning(single)); // RETURNING sees the updated table only
+        }
+        if (chance(tc, 70)) {
+            sql = j(sql, kw("WHERE"), condition(s, 3));
+        }
+        return j(sql, returning(s));
+    }
+
+    String delete(Table t, Scope s) {
+        String sql = j(kw("DELETE FROM"), id(t.name));
+        if (chance(tc, 75)) {
+            sql = j(sql, kw("WHERE"), condition(s, 3));
+        }
+        return j(sql, returning(s));
+    }
+
+    // ----- DDL
+
+    String ddl() {
+        Table t = pick(tc, schema.tables.toArray(new Table[0]));
+        tablesUsed.add(t.name);
+        switch (n(tc, 0, 9)) {
+            case 0:
+            case 1:
+            case 2:
+                return createTable();
+            case 3:
+                return j(kw("CREATE"), chance(tc, 30) ? kw("TEMP") : "", kw("TABLE"), chance(tc, 30) ? kw("IF NOT EXISTS") : "", "n1", kw("AS"), query(false).sql);
+            case 4:
+                return createIndex(t);
+            case 5:
+                return createView(t);
+            case 6: {
+                String what = pick(tc, "TABLE", "TABLE", "VIEW", "INDEX");
+                boolean ifExists = !what.equals("TABLE") || chance(tc, 50);
+                return j(kw("DROP"), kw(what), ifExists ? kw("IF EXISTS") : "", what.equals("TABLE") && chance(tc, 80) ? id(t.name) : pick(tc, "v1", "i1", "nothere", "\"no where\""));
+            }
+            default:
+                return alterTable(t);
+        }
+    }
+
+    String createTable() {
+        List<String> defs = new ArrayList<>();
+        int k = n(tc, 1, 4);
+        Set<String> used = new LinkedHashSet<>();
+        List<String> colNames = new ArrayList<>();
+        boolean pkDone = false;
+        for (int i = 0; i < k; i++) {
+            String name = pick(tc, NAMES);
+            if (!used.add(name)) {
+                continue;
+            }
+            colNames.add(name);
+            // bug typelessColumnConstraints: a typeless column (SQLite) is only accepted when every column is typeless and bare
+            String type = pick(tc, "INTEGER", "TEXT", "REAL", "INT", "NUMERIC", "VARCHAR(20)", "BLOB", "DOUBLE", "CHAR(3)", "DECIMAL(5,2)");
+            StringBuilder d = new StringBuilder(id(name));
+            if (!type.isEmpty()) {
+                d.append(" ").append(type);
+            }
+            int cs = n(tc, 0, 2);
+            for (int c = 0; c < cs; c++) {
+                switch (n(tc, 0, 7)) {
+                    case 0:
+                        if (!pkDone) {
+                            d.append(" ").append(kw("PRIMARY KEY"));
+                            if (type.equals("INTEGER") && chance(tc, 40)) {
+                                d.append(" ").append(kw("AUTOINCREMENT"));
+                            }
+                            pkDone = true;
+                        }
+                        break;
+                    case 1:
+                        d.append(" ").append(kw("NOT NULL"));
+                        break;
+                    case 2:
+                        d.append(" ").append(kw("UNIQUE"));
+                        break;
+                    case 3:
+                        subqueryBudget = 0; // a DEFAULT must be constant: no subqueries
+                        d.append(" ").append(kw("DEFAULT")).append(" ").append(chance(tc, 60) ? literal() : "(" + expr(NONE, 2) + ")");
+                        break;
+                    case 4:
+                        subqueryBudget = 0;
+                        d.append(" ").append(kw("CHECK")).append(" (").append(condition(new Scope(List.of(""), List.of(List.of(name)), false, false, List.of()), 2)).append(")");
+                        break;
+                    case 5:
+                        d.append(" ").append(kw("COLLATE")).append(" ").append(pick(tc, "NOCASE", "\"BINARY\""));
+                        break;
+                    default:
+                        Table ref = pick(tc, schema.tables.toArray(new Table[0]));
+                        tablesUsed.add(ref.name);
+                        d.append(" ").append(kw("REFERENCES")).append(" ").append(id(ref.name)).append(chance(tc, 50) ? " (id)" : "");
+                        if (chance(tc, 40)) {
+                            d.append(" ").append(kw(pick(tc, "ON DELETE CASCADE", "ON UPDATE SET NULL", "ON DELETE SET DEFAULT", "ON DELETE RESTRICT", "ON UPDATE NO ACTION")));
+                        }
+                }
+            }
+            defs.add(d.toString());
+        }
+        int tcs = n(tc, 0, 2);
+        for (int c = 0; c < tcs; c++) {
+            String col = pick(tc, colNames.toArray(new String[0]));
+            String named = chance(tc, 30) ? kw("CONSTRAINT") + " k" + c + " " : "";
+            switch (n(tc, 0, 3)) {
+                case 0:
+                    if (!pkDone) {
+                        defs.add(named + kw("PRIMARY KEY") + " (" + id(col) + ")");
+                        pkDone = true;
+                    }
+                    break;
+                case 1:
+                    defs.add(named + kw("UNIQUE") + " (" + String.join(", ", idAll(colNames.subList(0, n(tc, 1, colNames.size())))) + ")");
+                    break;
+                case 2:
+                    subqueryBudget = 0;
+                    defs.add(named + kw("CHECK") + " (" + condition(new Scope(List.of(""), List.of(colNames), false, false, List.of()), 2) + ")");
+                    break;
+                default:
+                    Table ref = pick(tc, schema.tables.toArray(new Table[0]));
+                    tablesUsed.add(ref.name);
+                    defs.add(named + kw("FOREIGN KEY") + " (" + id(col) + ") " + kw("REFERENCES") + " " + id(ref.name) + " (id)" + (chance(tc, 40) ? " " + kw("ON DELETE CASCADE") : ""));
+            }
+        }
+        return j(kw("CREATE"), chance(tc, 20) ? kw(pick(tc, "TEMP", "TEMPORARY")) : "", kw("TABLE"), chance(tc, 30) ? kw("IF NOT EXISTS") : "", pick(tc, "n1", "\"new table\"", "n2"),
+            "(" + String.join("," + sp(), defs) + ")");
+    }
+
+    String createIndex(Table t) {
+        subqueryBudget = 0; // no subqueries in index expressions or a partial index's WHERE
+        List<String> cols = new ArrayList<>();
+        int k = n(tc, 1, 2);
+        Scope s = new Scope(List.of(""), List.of(names(t)), false, false, List.of()); // "." is prohibited in index expressions
+        for (int i = 0; i < k; i++) {
+            String col = id(pick(tc, names(t).toArray(new String[0])));
+            String c = chance(tc, 80) ? col : "(" + pick(tc, col + " + 1", col + " * 2", "abs(" + col + ")", "lower(" + col + ")", col + " % 3") + ")";
+            if (chance(tc, 30)) {
+                c = j(c, kw("COLLATE"), pick(tc, "NOCASE", "\"BINARY\""));
+            }
+            if (chance(tc, 40)) {
+                c = j(c, kw(pick(tc, "ASC", "DESC")));
+            }
+            cols.add(c);
+        }
+        String sql = j(kw("CREATE"), chance(tc, 30) ? kw("UNIQUE") : "", kw("INDEX"), chance(tc, 30) ? kw("IF NOT EXISTS") : "", "i1", kw("ON"), id(t.name), "(" + String.join(", ", cols) + ")");
+        if (chance(tc, 40)) {
+            sql = j(sql, kw("WHERE"), condition(s, 2));
+        }
+        return sql;
+    }
+
+    String createView(Table t) {
+        Query q = plainSelect(false, null);
+        String cols = "";
+        if (chance(tc, 30) && !q.columns.isEmpty() && !q.columns.contains("*")) {
+            List<String> names = new ArrayList<>();
+            for (int i = 0; i < q.columns.size(); i++) {
+                names.add("v" + i);
+            }
+            cols = " (" + String.join(", ", names) + ")";
+        }
+        return j(kw("CREATE"), chance(tc, 20) ? kw("TEMP") : "", kw("VIEW"), chance(tc, 30) ? kw("IF NOT EXISTS") : "", "v1" + cols, kw("AS"), q.sql);
+    }
+
+    String alterTable(Table t) {
+        String head = j(kw("ALTER TABLE"), id(t.name));
+        List<String> cols = names(t);
+        switch (n(tc, 0, 4)) {
+            case 0:
+                return j(head, kw("RENAME TO"), pick(tc, "n1", "\"new table\""));
+            case 1:
+                return j(head, kw("RENAME"), chance(tc, 50) ? kw("COLUMN") : "", id(pick(tc, cols.toArray(new String[0]))), kw("TO"), pick(tc, "z", "\"z z\""));
+            case 2: {
+                String type = pick(tc, "INTEGER", "TEXT", "REAL", "", "NUMERIC");
+                String def = j("z", type);
+                if (chance(tc, 50)) {
+                    def = j(def, kw("DEFAULT"), literal());
+                }
+                if (chance(tc, 30)) {
+                    subqueryBudget = 0;
+                    def = j(def, kw("CHECK"), "(" + condition(new Scope(List.of(""), List.of(List.of("z")), false, false, List.of()), 1) + ")");
+                }
+                if (chance(tc, 20)) {
+                    def = j(def, kw("COLLATE NOCASE"));
+                }
+                return j(head, kw("ADD"), chance(tc, 50) ? kw("COLUMN") : "", def);
+            }
+            default:
+                if (cols.size() < 2) {
+                    return j(head, kw("RENAME TO"), "n1");
+                }
+                return j(head, kw("DROP"), chance(tc, 50) ? kw("COLUMN") : "", id(pick(tc, cols.subList(1, cols.size()).toArray(new String[0]))));
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
