+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for JSqlParser, added by the Hegel zoo (targets/java/jsqlparser). Runs against the
+     com.github.jsqlparser:jsqlparser artifact that `[run] setup` installs from this checkout into the local Maven
+     repository; SQLite (sqlite-jdbc, in process) is the oracle. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>jsqlparser-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <jsqlparser.version>5.5-SNAPSHOT</jsqlparser.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>com.github.jsqlparser</groupId>
+      <artifactId>jsqlparser</artifactId>
+      <version>${jsqlparser.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>org.xerial</groupId>
+      <artifactId>sqlite-jdbc</artifactId>
+      <version>3.53.4.0</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g -Xss4m</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Db.java b/hegel/src/test/java/zoo/Db.java
new file mode 100644
index 0000000..662e8e1
--- /dev/null
+++ b/hegel/src/test/java/zoo/Db.java
@@ -0,0 +1,242 @@
+package zoo;
+
+import java.sql.Connection;
+import java.sql.DriverManager;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.ResultSetMetaData;
+import java.sql.SQLException;
+import java.sql.Statement;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.TreeMap;
+
+/** An in-memory SQLite database (sqlite-jdbc): the oracle for acceptance and for the meaning of a statement. */
+final class Db implements AutoCloseable {
+
+    final Connection c;
+
+    Db() {
+        try {
+            c = DriverManager.getConnection("jdbc:sqlite::memory:");
+        } catch (SQLException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    /** A database holding the schema and rows the generator describes. */
+    static Db of(SqlGen.Schema schema) {
+        Db db = new Db();
+        for (String s : schema.setup()) {
+            String err = db.exec(s);
+            if (err != null) {
+                throw new IllegalStateException("schema setup failed: " + err + " for " + s);
+            }
+        }
+        return db;
+    }
+
+    /** null when SQLite compiles the statement, else its message. Nothing is executed. */
+    String accepts(String sql) {
+        try (PreparedStatement ps = c.prepareStatement(sql)) {
+            return null;
+        } catch (SQLException e) {
+            return message(e);
+        }
+    }
+
+    /** The number of result columns SQLite reports for the statement, 0 for none (DML/DDL), -1 when rejected. */
+    int columnCount(String sql) {
+        try (PreparedStatement ps = c.prepareStatement(sql)) {
+            ResultSetMetaData md = ps.getMetaData();
+            return md == null ? 0 : md.getColumnCount();
+        } catch (SQLException e) {
+            return -1;
+        }
+    }
+
+    /** Executes a statement; null on success, else the message. */
+    String exec(String sql) {
+        try (Statement st = c.createStatement()) {
+            st.execute(sql);
+            return null;
+        } catch (SQLException e) {
+            return message(e);
+        }
+    }
+
+    /** Runs a statement and returns its rows (an empty list for statements without a result set), or throws. */
+    Result run(String sql) {
+        try (Statement st = c.createStatement()) {
+            boolean hasRows = st.execute(sql);
+            List<List<Object>> rows = new ArrayList<>();
+            List<String> names = new ArrayList<>();
+            if (hasRows) {
+                try (ResultSet rs = st.getResultSet()) {
+                    ResultSetMetaData md = rs.getMetaData();
+                    for (int i = 1; i <= md.getColumnCount(); i++) {
+                        names.add(md.getColumnLabel(i));
+                    }
+                    while (rs.next()) {
+                        List<Object> row = new ArrayList<>();
+                        for (int i = 1; i <= md.getColumnCount(); i++) {
+                            row.add(rs.getObject(i));
+                        }
+                        rows.add(row);
+                    }
+                }
+            }
+            return new Result(names, rows, hasRows ? -1 : st.getUpdateCount(), null);
+        } catch (SQLException e) {
+            return new Result(List.of(), List.of(), -1, message(e));
+        }
+    }
+
+    /** Rows of a query, or the error. */
+    record Result(List<String> names, List<List<Object>> rows, int updateCount, String error) {
+        boolean ok() {
+            return error == null;
+        }
+
+        /** The rows in order, canonically printed (type-tagged, blobs in hex). */
+        List<String> lines() {
+            List<String> out = new ArrayList<>();
+            for (List<Object> row : rows) {
+                out.add(line(row));
+            }
+            return out;
+        }
+
+        /** The rows as a multiset (sorted lines). */
+        List<String> sorted() {
+            List<String> out = lines();
+            out.sort(null);
+            return out;
+        }
+    }
+
+    static String line(List<Object> row) {
+        StringBuilder sb = new StringBuilder("[");
+        for (int i = 0; i < row.size(); i++) {
+            if (i > 0) {
+                sb.append(", ");
+            }
+            sb.append(value(row.get(i)));
+        }
+        return sb.append("]").toString();
+    }
+
+    static String value(Object o) {
+        if (o == null) {
+            return "NULL";
+        }
+        if (o instanceof byte[] b) {
+            return "X'" + HexFormat.of().withUpperCase().formatHex(b) + "'";
+        }
+        if (o instanceof Double d) {
+            return "R:" + d;
+        }
+        if (o instanceof Float f) {
+            return "R:" + f.doubleValue();
+        }
+        if (o instanceof Number n) {
+            return "I:" + n.longValue();
+        }
+        if (o instanceof String s) {
+            return "T:" + Zoo.show(s);
+        }
+        return o.getClass().getSimpleName() + ":" + o;
+    }
+
+    /** The whole database, canonically: for every table and view its rows, sorted; plus the schema catalogue. */
+    TreeMap<String, List<String>> snapshot() {
+        TreeMap<String, List<String>> out = new TreeMap<>();
+        Result master = run("SELECT type, name, tbl_name FROM sqlite_master WHERE name NOT LIKE 'sqlite_%' ORDER BY 1, 2, 3");
+        out.put("#master", master.lines());
+        for (List<Object> row : master.rows) {
+            String type = String.valueOf(row.get(0));
+            String name = String.valueOf(row.get(1));
+            String q = "\"" + name.replace("\"", "\"\"") + "\"";
+            if (type.equals("table") || type.equals("view")) {
+                if (type.equals("table")) {
+                    List<String> cols = new ArrayList<>();
+                    for (String l : run("SELECT name, type, \"notnull\", dflt_value, pk, hidden FROM pragma_table_xinfo(" + quote(name) + ")").lines()) {
+                        // a CREATE TABLE ... AS names columns after the expression text: comments, white space and
+                        // keyword case are not meaning (JSqlParser prints `false` for FALSE and drops comments)
+                        cols.add(withoutComments(l).replaceAll("\\\\u000[9ad]", "").replace(" ", "").toLowerCase());
+                    }
+                    out.put("#columns " + name, cols);
+                    Result rows = run("SELECT * FROM " + q);
+                    out.put("rows " + name, rows.ok() ? rows.sorted() : List.of("ERR " + rows.error));
+                    out.put("#indexes " + name, run("SELECT name, \"unique\", origin, partial FROM pragma_index_list(" + quote(name) + ") ORDER BY 1").lines());
+                    out.put("#fks " + name, run("SELECT \"table\", \"from\", \"to\", on_update, on_delete FROM pragma_foreign_key_list(" + quote(name) + ") ORDER BY 1, 2").lines());
+                } else {
+                    Result rows = run("SELECT * FROM " + q);
+                    out.put("rows " + name, rows.ok() ? rows.sorted() : List.of("ERR"));
+                }
+            } else if (type.equals("index")) {
+                out.put("#index " + name, run("SELECT seqno, cid, name, \"desc\", coll, key FROM pragma_index_xinfo(" + quote(name) + ") ORDER BY 1").lines());
+            }
+        }
+        return out;
+    }
+
+    static String quote(String s) {
+        return "'" + s.replace("'", "''") + "'";
+    }
+
+    /**
+     * The line without block comments and `-- ...` line comments (the line has its control characters escaped, so a
+     * line comment ends at the six characters of an escaped newline); string literals are kept whole: `'--'` is not
+     * a comment.
+     */
+    static String withoutComments(String l) {
+        StringBuilder sb = new StringBuilder();
+        int i = 0;
+        while (i < l.length()) {
+            char c = l.charAt(i);
+            if (c == '\'') {
+                int j = i + 1;
+                while (j < l.length() && !(l.charAt(j) == '\'' && (j + 1 >= l.length() || l.charAt(j + 1) != '\''))) {
+                    j += l.charAt(j) == '\'' ? 2 : 1;
+                }
+                int end = Math.min(l.length(), j + 1);
+                sb.append(l, i, end);
+                i = end;
+            } else if (l.startsWith("/*", i)) {
+                int end = l.indexOf("*/", i + 2);
+                i = end < 0 ? l.length() : end + 2;
+            } else if (l.startsWith("--", i) && l.indexOf("\\u000a", i) >= 0) {
+                i = l.indexOf("\\u000a", i) + 6;
+            } else {
+                sb.append(c);
+                i++;
+            }
+        }
+        return sb.toString();
+    }
+
+    static String message(SQLException e) {
+        String m = String.valueOf(e.getMessage()).replace("\n", " ");
+        return m.replaceFirst("^\\[SQLITE_[A-Z_]+\\]\\s*", "").replaceFirst("^SQL error or missing database \\((.*)\\)$", "$1");
+    }
+
+    @Override
+    public void close() {
+        try {
+            c.close();
+        } catch (SQLException e) {
+            // ignore
+        }
+    }
+
+    static String show(List<String> lines) {
+        return lines.size() > 12 ? String.join(" ", lines.subList(0, 12)) + " … (" + lines.size() + " rows)" : String.join(" ", lines);
+    }
+
+    static boolean sameBytes(byte[] a, byte[] b) {
+        return Arrays.equals(a, b);
+    }
+}
diff --git a/hegel/src/test/java/zoo/EngineText.java b/hegel/src/test/java/zoo/EngineText.java
new file mode 100644
index 0000000..43611cc
--- /dev/null
+++ b/hegel/src/test/java/zoo/EngineText.java
@@ -0,0 +1,59 @@
+package zoo;
+
+/** Text helpers shared by the tests. */
+final class EngineText {
+
+    static String firstLine(String s) {
+        if (s == null) {
+            return "null";
+        }
+        int i = s.indexOf('\n');
+        String l = i < 0 ? s : s.substring(0, i);
+        return l.length() > 300 ? l.substring(0, 300) + "…" : l;
+    }
+
+    /** The text, indented and with invisible characters made visible, for messages. */
+    static String describe(String text) {
+        StringBuilder sb = new StringBuilder("\n    ");
+        String shown = text.length() > 3000 ? text.substring(0, 3000) + "…" : text;
+        for (int i = 0; i < shown.length(); i++) {
+            char c = shown.charAt(i);
+            if (c == '\n') {
+                sb.append("\n    ");
+            } else if (c == '\t') {
+                sb.append("\\t");
+            } else if (c == '\r') {
+                sb.append("\\r");
+            } else if (c == '\f') {
+                sb.append("\\f");
+            } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff)) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.append('\n').toString();
+    }
+
+    /** Whitespace removed (types are compared as text). */
+    static String squash(String s) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (!Character.isWhitespace(c)) {
+                sb.append(c);
+            }
+        }
+        return sb.toString();
+    }
+
+    /** The first differing position of two shapes, with context, for messages. */
+    static String diff(String a, String b) {
+        int i = 0;
+        while (i < a.length() && i < b.length() && a.charAt(i) == b.charAt(i)) {
+            i++;
+        }
+        int from = Math.max(0, i - 80);
+        return "\n    javaparser: …" + a.substring(from, Math.min(a.length(), i + 160)) + "\n    javac:      …" + b.substring(from, Math.min(b.length(), i + 160));
+    }
+}
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..e531f5f
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,126 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The combinators the binding lacks: weighted choice, a biased coin, an optional with a probability, int ranges,
+ * bounded lists and words over an alphabet.
+ */
+final class Gen {
+    private Gen() {}
+
+    /** A weighted alternative for {@link #weighted}; the generator may produce a subtype of the choice's type. */
+    record Choice<T>(int weight, Generator<? extends T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<? extends T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** A constant alternative. */
+    static <T> Choice<T> v(int weight, T value) {
+        return new Choice<>(weight, just(value));
+    }
+
+    /** All the generators, in order, as one list (a tuple of any arity). */
+    static <T> Generator<List<T>> all(List<Generator<T>> gens) {
+        Generator<List<T>> acc = just(List.of());
+        for (Generator<T> g : gens) {
+            acc = tuples(acc, g).map(t -> {
+                List<T> out = new ArrayList<>(t.value1());
+                out.add(t.value2());
+                return out;
+            });
+        }
+        return acc;
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        List<Choice<T>> cs = List.of(choices);
+        int total = 0;
+        for (Choice<T> c : cs) {
+            total += c.weight();
+        }
+        return ints(0, total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : cs) {
+                acc += c.weight();
+                if (i < acc) {
+                    return widen(c.gen());
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** A generator of a subtype is a generator of the supertype: it only ever produces values. */
+    @SuppressWarnings("unchecked")
+    static <T> Generator<T> widen(Generator<? extends T> g) {
+        return (Generator<T>) g;
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return ints(0, 99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<? extends T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** The empty string, or {@code present} with probability pct/100. */
+    static Generator<String> opt(int pct, String present) {
+        return maybe(pct, "", just(present));
+    }
+
+    /** The empty string, or a value of {@code present} with probability pct/100. */
+    static Generator<String> opt(int pct, Generator<String> present) {
+        return maybe(pct, "", present);
+    }
+
+    /** One of the values, equally likely; shrinks to the first. */
+    @SafeVarargs
+    static <T> Generator<T> pick(T... xs) {
+        return sampledFrom(xs);
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A position, taken modulo the live size where it is used. */
+    static final Generator<Integer> INDEX = ints(0, 999);
+
+    /** lo..hi values of the generator. */
+    static <T> Generator<List<T>> many(Generator<T> g, int lo, int hi) {
+        return lists(g).minSize(lo).maxSize(hi);
+    }
+
+    /** One character of the alphabet, as a string. */
+    static Generator<String> chars(String alphabet) {
+        List<String> cs = new ArrayList<>();
+        alphabet.codePoints().forEach(cp -> cs.add(new String(Character.toChars(cp))));
+        return sampledFrom(cs);
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        return many(chars(alphabet), lo, hi).map(parts -> String.join("", parts));
+    }
+
+    /** The element of the list at a drawn position, modulo its size (the list must not be empty). */
+    static <T> T at(List<T> xs, int index) {
+        return xs.get(Math.floorMod(index, xs.size()));
+    }
+}
diff --git a/hegel/src/test/java/zoo/JSqlParserPinsTest.java b/hegel/src/test/java/zoo/JSqlParserPinsTest.java
new file mode 100644
index 0000000..7c0a03d
--- /dev/null
+++ b/hegel/src/test/java/zoo/JSqlParserPinsTest.java
@@ -0,0 +1,214 @@
+package zoo;
+
+import static zoo.Zoo.check;
+
+import net.sf.jsqlparser.JSQLParserException;
+import net.sf.jsqlparser.expression.Expression;
+import net.sf.jsqlparser.expression.HexValue;
+import net.sf.jsqlparser.parser.CCJSqlParserUtil;
+import net.sf.jsqlparser.schema.Column;
+import net.sf.jsqlparser.statement.Statement;
+import net.sf.jsqlparser.statement.Statements;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Pins for the bugs in bugs.toml: each asserts the correct behaviour and fails while the bug exists (see
+ * target.toml [expected_failures]). Every statement here is accepted by SQLite (and, unless said otherwise, by
+ * PostgreSQL and MySQL too).
+ */
+class JSqlParserPinsTest {
+
+    static Statement parse(String sql) {
+        try {
+            return CCJSqlParserUtil.parse(sql);
+        } catch (JSQLParserException e) {
+            check(false, "rejected: " + JSqlParserTest.reason(e) + " for " + sql);
+            return null;
+        }
+    }
+
+    /** bug stackedUnaryOperators: `- -1`, `~ ~x`, `+-1`, `- NOT x` are one unary operator applied to another. */
+    @Test
+    void pin_stackedUnaryOperators() {
+        parse("SELECT - -1");
+        parse("SELECT ~ ~a FROM t");
+        parse("SELECT +-1, -~1");
+    }
+
+    /** bug predicateIsTrue: a comparison or predicate may be tested with IS [NOT] TRUE/FALSE (JLS-style boolean test, SQL:2016 6.39). */
+    @Test
+    void pin_predicateIsTrue() {
+        parse("SELECT a > 0 IS TRUE FROM t");
+        parse("SELECT * FROM t WHERE a BETWEEN 0 AND 2 IS NOT TRUE");
+        parse("SELECT a IN (1, 2) IS FALSE, b LIKE 'x%' IS TRUE, a IS NULL IS FALSE FROM t");
+    }
+
+    /** bug collateKeywordNames: SQLite's built-in collations BINARY and RTRIM are collation names after COLLATE. */
+    @Test
+    void pin_collateKeywordNames() {
+        parse("SELECT b COLLATE BINARY FROM t ORDER BY b COLLATE RTRIM");
+    }
+
+    /** bug typeNamesAsColumns: type names are not in the reserved-keyword list and name columns in every RDBMS with such columns. */
+    @Test
+    void pin_typeNamesAsColumns() {
+        parse("SELECT int, integer, real, blob, numeric, varchar, float, double, decimal, number, uuid FROM t");
+        parse("SELECT int AS x FROM t WHERE int = 1 ORDER BY int");
+    }
+
+    /** bug excludeColumn: `exclude` is not a reserved keyword; it names a column in CREATE TABLE like anywhere else. */
+    @Test
+    void pin_excludeColumn() {
+        parse("CREATE TABLE n (exclude INTEGER, a TEXT)");
+    }
+
+    /** bug quotedIdentifierWithDot: a quoted identifier is one name whatever it contains. */
+    @Test
+    void pin_quotedIdentifierWithDot() {
+        Statement s = parse("SELECT \"a.b\", \"x.\", \".y\" FROM t");
+        if (s != null) {
+            String out = s.toString();
+            check(out.equals("SELECT \"a.b\", \"x.\", \".y\" FROM t"), () -> "printed as " + out);
+            Column c = (Column) ((net.sf.jsqlparser.statement.select.PlainSelect) s).getSelectItem(0).getExpression();
+            check(c.getTable() == null && "\"a.b\"".equals(c.getColumnName()), () -> "the column \"a.b\" became table " + c.getTable() + ", column " + c.getColumnName());
+        }
+        try {
+            CCJSqlParserUtil.parse("SELECT \".\" FROM t");
+        } catch (JSQLParserException e) {
+            Throwable r = e;
+            while (r.getCause() != null && r.getCause() != r) {
+                r = r.getCause();
+            }
+            Throwable root = r;
+            check(false, () -> "SELECT \".\" FROM t fails with " + root);
+        }
+        Statement ct = parse("CREATE TABLE \"a.b\" (c INTEGER)");
+        if (ct != null) {
