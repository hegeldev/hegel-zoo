+    /** Quoted names holding a dot: bug quotedIdentifierWithDot's shape (JSqlParser splits them), not drawn under HEGEL_NO_KNOWN. */
+    static final String[] DOTTED_NAMES = Zoo.NO_KNOWN ? new String[0] : new String[] {"a.b", "x."};
