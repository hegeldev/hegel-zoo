+/**
+ * JSqlParser against SQLite: a random statement in the dialect both accept (SqlGen) must parse, print back to a
+ * statement SQLite accepts with the same meaning, and the tree must group the operators as SQLite does. The
+ * generators draw the recorded bugs' shapes (bugs.toml), so the broad properties fail on them and the narrow ones
+ * below - one per bug, each over that bug's shape region with random contents and the same oracle - fail on them
+ * too; all are the expected failures. {@code HEGEL_NO_KNOWN=1} ({@link Zoo#NO_KNOWN}) switches the shapes off.
+ */
+class JSqlParserTest {
+
+    static Statement parse(String sql) throws JSQLParserException {
+        return CCJSqlParserUtil.parse(sql);
+    }
+
+    static boolean hasHex(String sql) {
+        return sql.contains("X'") || sql.contains("x'");
+    }
+
+    /**
+     * Whether a reprint is the same text as the print. Under HEGEL_NO_KNOWN a text holding a hex literal is compared
+     * without its white space: bug hexLiteralTrailingSpace (HexValue keeps the white space after the literal, so
+     * toString() grows a space per round trip).
+     */
+    static boolean samePrint(String print, String reprint) {
+        return Zoo.NO_KNOWN && hasHex(print) ? EngineText.squash(reprint).equals(EngineText.squash(print)) : reprint.equals(print);
+    }
+
+    static String describe(SqlGen.Program p) {
+        return EngineText.describe(p.sql()) + "\n    schema: " + String.join("; ", p.schema().setup());
+    }
+
+    /** The message of a JSQLParserException without the SQL echo. */
+    static String reason(Throwable e) {
+        Throwable c = e;
+        while (c.getCause() != null && c.getCause() != c) {
+            c = c.getCause();
+        }
+        String m = String.valueOf(c.getMessage()).replace("\n", " ");
+        return c.getClass().getSimpleName() + ": " + (m.length() > 200 ? m.substring(0, 200) + "…" : m);
+    }
+
+    /** Both results equal: same acceptance, same rows (ordered or as a multiset), same update count. */
+    static String sameResult(Db.Result a, Db.Result b, boolean ordered) {
+        return sameResult(a, b, ordered, true);
+    }
+
+    static String sameResult(Db.Result a, Db.Result b, boolean ordered, boolean names) {
+        if (a.ok() != b.ok()) {
+            return a.ok() ? "the reprint fails in SQLite: " + b.error() : "the original fails in SQLite (" + a.error() + ") but the reprint runs";
+        }
+        if (!a.ok()) {
+            return a.error().equals(b.error()) ? null : "different SQLite errors: " + a.error() + " vs " + b.error();
+        }
+        if (names && !normNames(a.names()).equals(normNames(b.names()))) {
+            return "different column names: " + a.names() + " vs " + b.names();
+        }
+        List<String> x = ordered ? a.lines() : a.sorted();
+        List<String> y = ordered ? b.lines() : b.sorted();
+        if (!x.equals(y)) {
+            return "different rows: " + Db.show(x) + " vs " + Db.show(y);
+        }
+        if (a.updateCount() != b.updateCount()) {
+            return "different change counts: " + a.updateCount() + " vs " + b.updateCount();
+        }
+        return null;
+    }
+
+    static List<String> normNames(List<String> names) {
+        List<String> out = new ArrayList<>();
+        for (String s : names) {
+            out.add(EngineText.squash(s.replaceAll("'(?:[^']|'')*'", "''").replaceAll("/\\*.*?\\*/", " ").replaceAll("--[^\\n]*", " ")).toLowerCase().replace("(", "").replace(")", "").replace(" ", ""));
+        }
+        return out;
+    }
+
+    /** Runs a statement on a fresh database of the program's schema and captures the result and the database after it. */
+    record Outcome(Db.Result result, TreeMap<String, List<String>> after) {
+    }
+
+    static Outcome outcome(SqlGen.Program p, String sql) {
+        try (Db db = Db.of(p.schema())) {
+            Db.Result r = db.run(sql);
+            return new Outcome(r, db.snapshot());
+        }
+    }
+
+    /** Where the meaning of the original and of a reprint differ, or null. */
+    static String differentMeaning(SqlGen.Program p, String reprint) {
+        return differentMeaning(p, reprint, true);
+    }
+
+    static String differentMeaning(SqlGen.Program p, String reprint, boolean names) {
+        Outcome a = outcome(p, p.sql());
+        Outcome b = outcome(p, reprint);
+        String d = sameResult(a.result, b.result, p.ordered(), names);
+        if (d == null && !a.after.equals(b.after)) {
+            for (String k : a.after.keySet()) {
+                if (!Objects.equals(a.after.get(k), b.after.get(k))) {
+                    return "the database differs afterwards at " + k + ": " + Db.show(a.after.get(k)) + " vs " + Db.show(b.after.getOrDefault(k, List.of()));
+                }
+            }
+            return "the database differs afterwards: " + a.after.keySet() + " vs " + b.after.keySet();
+        }
+        if (d != null) {
+            // confirm the original is stable before blaming the reprint
+            Outcome a2 = outcome(p, p.sql());
+            if (sameResult(a.result, a2.result, p.ordered()) != null) {
+                return null;
+            }
+        }
+        return d;
+    }
