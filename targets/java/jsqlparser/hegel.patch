+        /** Plain rows, every item an aggregate over the whole table, or GROUP BY these expressions. */
+        record Grouping(boolean grouped, boolean wholeAgg, List<String> groupExprs) {
+        }
+
+        Generator<Grouping> grouping(From f, int sub) {
+            Grouping none = new Grouping(false, false, List.of());
+            if (f.noFrom()) {
+                return just(none);
+            }
+            Scope plain = f.scope();
+            Generator<String> groupExpr = weighted(w(7, columnRef(plain)), w(3, expr(plain, 1, sub).map(SqlGen::noIndex)));
+            return weighted(v(66, none), v(9, new Grouping(false, true, List.of())), w(25, many(groupExpr, 1, 2).map(gs -> new Grouping(true, false, gs))));
+        }
