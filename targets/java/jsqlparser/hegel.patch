+    static final Generator<String> COLLATION = Zoo.NO_KNOWN ? pick("NOCASE", "\"BINARY\"", "\"RTRIM\"") : pick("NOCASE", "\"BINARY\"", "\"RTRIM\"", "BINARY", "RTRIM");
