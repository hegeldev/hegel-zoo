+        /** A select item: its expression (or a star), and its alias form (-1: none; 0 r0, 1 "r 0", 2 res0, 3 'q0') with or without AS. */
+        record Item(String expr, boolean star, int aliasForm, String asKw) {
+            String alias(int i) {
+                return switch (aliasForm) {
+                    case 0 -> "r" + i;
+                    case 1 -> "\"r " + i + "\"";
+                    case 2 -> "res" + i;
+                    default -> "'q" + i + "'";
+                };
+            }
+
+            /** The item's text at position i. */
+            String text(int i) {
+                return star || aliasForm < 0 ? expr : j(expr, asKw, alias(i));
+            }
+
+            /** The item's result name as ORDER BY may refer to it: null when unnamed. */
+            String name(int i) {
+                if (star) {
+                    return "*";
+                }
+                if (aliasForm < 0) {
+                    return null;
+                }
+                return aliasForm == 3 ? "\"q" + i + "\"" : alias(i);
+            }
+        }
+
+        Generator<Item> item(From f, Grouping g, int sub, boolean first) {
+            Scope plain = f.scope();
+            Generator<String> e;
+            if (g.grouped()) {
+                e = weighted(w(1, INDEX.map(i -> at(g.groupExprs(), i))), w(1, aggregate(plain.aggregating(), 2, sub)));
+            } else if (g.wholeAgg()) {
+                e = aggregate(plain.aggregating(), 2, sub);
+            } else if (!f.noFrom() && !f.hasNatural()) {
+                e = weighted(w(88, expr(plain, 3, sub)), w(12, window(plain, f.idKeys(), sub)));
+            } else {
+                e = expr(plain, 3, sub);
+            }
+            Generator<Item> plainItem = tuples(e, maybe(45, -1, ints(0, 3)), opt(60, kw("AS"))).map(t -> new Item(t.value1(), false, t.value2(), t.value3()));
+            if (first && !f.noFrom() && !g.grouped() && !g.wholeAgg()) {
+                Generator<Item> star = tuples(chance(50), chance(50), INDEX, ID_STYLE)
+                    .map(t -> new Item(t.value1() || f.aliases().size() == 1 && t.value2() ? "*" : id(at(f.aliases(), t.value3()), t.value4()) + ".*", true, -1, ""));
+                return weighted(w(85, plainItem), w(15, star));
+            }
+            return plainItem;
+        }
