+        /** One FROM item as drawn: which table, derived or not, aliased or not, how joined, whether it gets ON / USING. */
+        record Source(int table, boolean derived, boolean aliased, int idStyle, String asKw, String join, boolean on, boolean using) {
+        }
+
+        static final Generator<Source> SOURCE = tuples(INDEX, chance(15), chance(50), ID_STYLE, opt(50, kw("AS")),
+            pick(",", "JOIN", "INNER JOIN", "LEFT JOIN", "LEFT OUTER JOIN", "CROSS JOIN", "NATURAL JOIN", "JOIN", "LEFT JOIN"), chance(80), chance(25))
+            .map(t -> new Source(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+        /** The FROM clause resolved: the aliases in scope with their columns, the row keys, and its text. */
+        record From(boolean noFrom, List<String> aliases, List<List<String>> columns, List<String> idKeys, boolean hasNatural, String text) {
+            Scope scope() {
+                return new Scope(aliases, columns, false);
+            }
+        }
+
+        /** Tables, joins, derived tables and the CTE (first, when there is one); no FROM at all 8% of the time. */
+        Generator<From> from(Table cte, int sub) {
+            Generator<List<Source>> sources = cte == null ? maybe(8, List.<Source>of(), many(SOURCE, 1, 3)) : many(SOURCE, 0, 2);
+            return sources.flatMap(srcs -> {
+                List<String> aliases = new ArrayList<>();
+                List<List<String>> columns = new ArrayList<>();
+                List<String> idKeys = new ArrayList<>();
+                List<String> parts = new ArrayList<>();
+                List<Generator<String>> ons = new ArrayList<>();
+                boolean hasNatural = false;
+                if (cte != null) {
+                    aliases.add(cte.name());
+                    columns.add(cte.names());
+                    idKeys.add(ident(cte.name()) + "." + ident(cte.names().get(0)));
+                    parts.add(ident(cte.name()));
+                }
+                for (Source src : srcs) {
+                    int i = aliases.size();
+                    Table t = at(tables, src.table());
+                    List<String> cols = t.names();
+                    String alias;
+                    String item;
+                    if (src.derived() && sub > 0) {
+                        alias = "d" + i;
+                        item = parens(j(kw("SELECT"), "*", kw("FROM"), id(t.name(), src.idStyle()))) + S + (src.asKw().isEmpty() ? "" : src.asKw() + S) + alias;
+                    } else if (src.aliased() || aliases.contains(t.name())) {
+                        alias = "x" + i;
+                        item = j(id(t.name(), src.idStyle()), src.asKw(), alias);
+                    } else {
+                        alias = t.name();
+                        item = id(t.name(), src.idStyle());
+                    }
+                    if (i == 0) {
+                        parts.add(item);
+                    } else if (src.join().equals(",")) {
+                        parts.add("," + S + item);
+                    } else {
+                        boolean allIds = cols.contains("id") && columns.stream().allMatch(cs -> cs.contains("id"));
+                        if (src.join().startsWith("NATURAL") && !allIds) {
+                            parts.add(S + kw("CROSS JOIN") + S + item);
+                        } else {
+                            parts.add(S + kw(src.join()) + S + item);
+                            if (src.join().startsWith("NATURAL")) {
+                                hasNatural = true;
+                            } else if (!src.join().equals("CROSS JOIN") && src.on()) {
+                                if (src.using() && allIds) {
+                                    parts.add(S + kw("USING") + " (id)");
+                                    hasNatural = true;
+                                } else {
+                                    List<String> a2 = new ArrayList<>(aliases);
+                                    a2.add(alias);
+                                    List<List<String>> c2 = new ArrayList<>(columns);
+                                    c2.add(cols);
+                                    ons.add(condition(new Scope(List.copyOf(a2), List.copyOf(c2), false), 2, sub).map(c -> S + kw("ON") + S + c));
+                                    parts.add(null);
+                                }
+                            }
+                        }
+                    }
+                    aliases.add(alias);
+                    columns.add(cols);
+                    idKeys.add(ident(alias) + "." + ident(cols.get(0)));
+                }
+                boolean natural = hasNatural;
+                return Gen.all(ons).map(conds -> {
+                    StringBuilder sb = new StringBuilder();
+                    int k = 0;
+                    for (String p : parts) {
+                        sb.append(p == null ? conds.get(k++) : p);
+                    }
+                    return new From(aliases.isEmpty(), List.copyOf(aliases), List.copyOf(columns), List.copyOf(idKeys), natural, sb.toString());
+                });
+            });
+        }
