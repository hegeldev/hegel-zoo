+        // ----- DML
+
+        Generator<String> dml(int sub) {
+            return INDEX.flatMap(i -> {
+                Table t = at(tables, i);
+                Scope s = Scope.of(t);
+                return weighted(w(3, delete(t, s, sub)), w(4, insert(t, s, sub)), w(3, update(t, s, sub)));
+            });
+        }
+
+        /** A RETURNING clause 35% of the time. */
+        Generator<String> returning(Scope s, int sub) {
+            return maybe(35, "", returningClause(s, sub));
+        }
+
+        /** `RETURNING *` or one or two expressions. */
+        Generator<String> returningClause(Scope s, int sub) {
+            Generator<String> items = many(tuples(expr(s, 1, sub), opt(30, kw("AS") + S + "r")), 1, 2).map(xs -> {
+                List<String> out = new ArrayList<>();
+                for (int i = 0; i < xs.size(); i++) {
+                    out.add(j(xs.get(i).value1(), xs.get(i).value2().isEmpty() ? "" : xs.get(i).value2() + i));
+                }
+                return j(kw("RETURNING"), String.join(", ", out));
+            });
+            return weighted(v(4, j(kw("RETURNING"), "*")), w(6, items));
+        }
