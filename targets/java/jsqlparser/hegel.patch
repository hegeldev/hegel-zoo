+        // ----- queries
+
+        /** A query and what the property needs to know: whether its rows are totally ordered, and its result column names. */
+        record Query(String sql, boolean ordered, List<String> columns) {
+        }
+
+        /** A top-level query: a VALUES, a compound, a query under WITH, or a plain select; not at the top only a plain select. */
+        Generator<Query> query(boolean top, int sub) {
+            if (!top) {
+                return plainSelect(null, sub);
+            }
+            return weighted(w(1, values(sub)), w(2, compound(sub)), w(1, withQuery(sub)), w(6, plainSelect(null, sub)));
+        }
+
+        Generator<Query> values(int sub) {
+            Generator<String> item = weighted(w(7, LITERAL), w(3, expr(NONE, 1, sub)));
+            Generator<List<List<String>>> rows = ints(1, 3).flatMap(width -> many(many(item, width, width), 1, 3));
+            return tuples(rows, weighted(v(60, 0), v(20, 1), v(20, 2))).map(t -> {
+                List<String> rs = new ArrayList<>();
+                for (List<String> vs : t.value1()) {
+                    rs.add("(" + String.join(", ", vs) + ")");
+                }
+                String sql = j(kw("VALUES"), String.join("," + S, rs));
+                if (t.value2() > 0) {
+                    sql = j(kw("SELECT"), "*", kw("FROM"), parens(sql) + (t.value2() == 2 ? S + kw("AS") + S + "v" : ""));
+                }
+                return new Query(sql, false, List.of());
+            });
+        }
+
+        Generator<Query> withQuery(int sub) {
+            return tuples(pick("cte", "w", "\"c t\""), INDEX, chance(40), chance(50)).flatMap(h -> {
+                String name = h.value1();
+                Table t = at(tables, h.value2());
+                List<String> cols = t.names();
+                boolean explicit = h.value3();
+                List<String> cteCols = new ArrayList<>();
+                for (int i = 0; i < cols.size(); i++) {
+                    cteCols.add(explicit ? "c" + i : cols.get(i));
+                }
+                Table cte = new Table(name.replace("\"", ""), tableOf(cteCols), List.of());
+                Generator<String> items = explicit || h.value4() ? idAll(cols).map(xs -> String.join(", ", xs)) : lit("*");
+                Generator<String> body = seq(kwd("SELECT"), items, kwd("FROM"), id(t.name()), opt(40, condition(Scope.of(t), 1, sub).map(c -> j(kw("WHERE"), c))));
+                Generator<String> head = seq(kwd("WITH"), opt(20, kw("RECURSIVE")), lit(name + (explicit ? " (" + String.join(", ", cteCols) + ")" : "")), kwd("AS"),
+                    opt(20, pick(kw("MATERIALIZED"), kw("NOT MATERIALIZED"))), body.map(SqlGen::parens));
+                return tuples(head, plainSelect(cte, sub)).map(t2 -> new Query(j(t2.value1(), t2.value2().sql()), t2.value2().ordered(), t2.value2().columns()));
+            });
+        }
