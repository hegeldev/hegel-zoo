+                w(2, arith(s, d, sub)),
+                w(1, concat(s, d, sub)),
+                w(1, bitwise(s, d, sub)),
+                w(2, predicate(s, d, sub)),
+                w(1, caseExpr(s, d, sub)),
+                w(1, cast(s, d, sub)),
+                w(2, function(s, d, sub)),
+                w(1, unary(s, d, sub)),
+                w(1, expr(s, d - 1, sub).map(SqlGen::parens)),
+                w(1, sub > 0 ? weighted(w(40, LITERAL), w(60, scalarSubquery(s, sub))) : LITERAL),
+                w(1, collate(s, d, sub)),
+                w(1, s.aggregates() ? aggregate(s, d, sub) : columnRef(s)),
+                w(1, logical(s, d, sub))))));
+        }
+
+        Generator<String> termLeaf(Scope s) {
+            return weighted(w(2, NUMBER), w(3, columnRef(s)));
+        }
+
+        /** An operand of an arithmetic chain: something that binds tighter than + - * / % in every dialect. */
+        Generator<String> term(Scope s, int d, int sub) {
+            if (d <= 0) {
+                return termLeaf(s);
+            }
+            return memo("term", s, d, sub, () -> weighted(w(40, termLeaf(s)), w(60, weighted(
+                w(1, expr(s, d - 1, sub).map(SqlGen::parens)),
+                w(1, function(s, d - 1, sub)),
+                w(1, cast(s, d - 1, sub)),
+                w(1, caseExpr(s, d - 1, sub)),
+                w(1, unarySigned(s, d - 1, sub)),
+                w(1, s.aggregates() ? aggregate(s, d - 1, sub) : columnRef(s)),
+                w(1, sub > 0 ? scalarSubquery(s, sub) : NUMBER)))));
+        }
+
+        /** first, then 1..n more operands each behind an operator, all separated by slots. */
+        Generator<String> chain(Generator<String> first, Generator<String> op, Generator<String> rest, int lo, int hi) {
+            return tuples(first, many(tuples(op, rest), lo, hi)).map(t -> {
+                StringBuilder sb = new StringBuilder(t.value1());
+                for (Tuple2<String, String> p : t.value2()) {
+                    sb.append(S).append(p.value1()).append(S).append(p.value2());
+                }
+                return sb.toString();
+            });
+        }
+
+        /** `+ - * / %` chains; `*`-family binds tighter than `+`-family in every dialect. */
+        Generator<String> arith(Scope s, int d, int sub) {
+            Generator<String> t = term(s, d - 1, sub);
+            return chain(t, pick("+", "-", "*", "/", "%"), t, 1, 3);
+        }
+
+        Generator<String> concat(Scope s, int d, int sub) {
+            Generator<String> t = term(s, d - 1, sub);
+            return chain(t, lit("||"), weighted(w(1, pick(TEXTS)), w(1, t)), 1, 2);
+        }
+
+        Generator<String> bitwise(Scope s, int d, int sub) {
+            Generator<String> t = term(s, d - 1, sub);
+            return chain(t, pick("&", "|", "<<", ">>"), t, 1, 2);
+        }
+
+        /** `-x`, `+x`, `~x` on a term, or `NOT x` on a predicate. */
+        Generator<String> unary(Scope s, int d, int sub) {
+            return weighted(w(1, unarySigned(s, d, sub)), w(1, seq(kwd("NOT"), predicateOperand(s, d - 1, sub))));
+        }
+
+        /** A sign on a column, a parenthesised expression, a function call or another signed expression (`- -1`, `~ ~a`: bug stackedUnaryOperators). */
+        Generator<String> unarySigned(Scope s, int d, int sub) {
+            Generator<String> operand = d <= 0 ? columnRef(s)
+                : weighted(w(2, columnRef(s)), w(1, expr(s, d - 1, sub).map(SqlGen::parens)), w(1, function(s, d - 1, sub)), w(1, unarySigned(s, d - 1, sub)));
+            return signed(operand);
+        }
+
+        /** A sign on a signed expression: the stacked shape itself. */
+        Generator<String> stackedUnary(Scope s, int d, int sub) {
+            return signed(unarySigned(s, d, sub));
+        }
+
+        /**
+         * `-`, `+` or `~` before the operand, separated one time in five. A signed operand stays stacked (with a
+         * separator between two minuses, which would read as a comment); under HEGEL_NO_KNOWN it is parenthesised,
+         * the spelling JSqlParser takes (bug stackedUnaryOperators).
+         */
+        static Generator<String> signed(Generator<String> operand) {
+            return tuples(pick("-", "-", "+", "~"), opt(20, S), operand).map(t -> {
+                String sign = t.value1();
+                String x = t.value3();
+                if (!isSigned(x)) {
+                    return sign + t.value2() + x;
+                }
+                if (Zoo.NO_KNOWN) {
+                    return sign + t.value2() + parens(x);
+                }
+                return sign + (sign.equals("-") && x.startsWith("-") ? S : t.value2()) + x;
+            });
+        }
+
+        /** The left operand of a comparison or predicate: a term or an arithmetic chain (tighter than comparisons everywhere). */
+        Generator<String> comparand(Scope s, int d, int sub) {
+            return weighted(w(3, term(s, d, sub)), w(1, arith(s, d, sub)), w(1, concat(s, d, sub)));
+        }
+
+        /** An operand for NOT / AND / OR: a predicate or a parenthesised expression (never a bare comparison chain). */
+        Generator<String> predicateOperand(Scope s, int d, int sub) {
+            Generator<String> simple = weighted(w(1, columnRef(s)), w(1, expr(s, d, sub).map(SqlGen::parens)));
+            if (d <= 0) {
+                return simple;
+            }
+            return memo("po", s, d, sub, () -> weighted(w(30, simple), w(70, predicate(s, d, sub))));
+        }
+
+        /**
+         * Comparisons, IS NULL, BETWEEN, IN, LIKE, EXISTS, IS TRUE - none chained (JSqlParser rejects `a = b = c`,
+         * SQLite allows), except that the operand of IS [NOT] TRUE/FALSE may itself be a predicate (`a > 0 IS TRUE`:
+         * bug predicateIsTrue; SQLite groups it `(a > 0) IS TRUE`).
+         */
+        Generator<String> predicate(Scope s, int d, int sub) {
+            return memo("pred", s, d, sub, () -> {
+                Generator<String> left = comparand(s, d - 1, sub);
+                Generator<String> t = term(s, d - 1, sub);
+                Generator<String> not30 = opt(30, kw("NOT"));
+                Generator<String> inList = many(weighted(w(7, LITERAL), w(3, t)), 0, 3).map(items -> "(" + String.join(", ", items) + ")");
+                Generator<String> in = sub > 0 ? weighted(w(7, inList), w(3, subquery(s, 1, sub - 1).map(SqlGen::parens))) : inList;
+                Generator<String> exists = sub > 0 ? seq(not30, kwd("EXISTS"), subquery(s, 1, sub - 1).map(SqlGen::parens)) : seq(left, lit("="), LITERAL);
+                Generator<String> booleanTested = d > 0 ? weighted(w(2, left), w(1, booleanTestable(predicate(s, d - 1, sub)))) : left;
+                return weighted(
+                    w(3, seq(left, pick("=", "<>", "!=", "<", ">", "<=", ">="), comparand(s, d - 1, sub))),
+                    w(1, seq(left, kwd("IS"), NOT40, kwd("NULL"))),
+                    w(1, seq(left, not30, kwd("BETWEEN"), t, kwd("AND"), t)),
+                    w(1, seq(left, not30, kwd("IN"), in)),
+                    w(1, seq(left, not30, kwd("LIKE"), weighted(w(6, LIKE_PATTERN), w(4, t)))),
+                    w(1, isBoolean(booleanTested)),
+                    w(1, exists),
+                    w(1, seq(left, kwd("IS"), opt(50, kw("NOT")), kwd("DISTINCT"), kwd("FROM"), comparand(s, d - 1, sub))));
+            });
+        }
+
+        static final Generator<String> NOT40 = opt(40, kw("NOT"));
+
+        /** `x IS [NOT] TRUE|FALSE`. */
+        static Generator<String> isBoolean(Generator<String> operand) {
+            return seq(operand, kwd("IS"), NOT40, pick(kw("TRUE"), kw("FALSE")));
+        }
+
+        /** A predicate as the operand of IS TRUE/FALSE: as drawn, or parenthesised under HEGEL_NO_KNOWN (bug predicateIsTrue). */
+        static Generator<String> booleanTestable(Generator<String> predicate) {
+            return Zoo.NO_KNOWN ? predicate.map(SqlGen::parens) : predicate;
+        }
+
+        /** A predicate tested with IS [NOT] TRUE/FALSE: the shape itself. */
+        Generator<String> predicateIsBoolean(Scope s, int d, int sub) {
+            return isBoolean(booleanTestable(predicate(s, d, sub)));
+        }
+
+        /** AND / OR / NOT over predicates. */
+        Generator<String> logical(Scope s, int d, int sub) {
+            Generator<String> p = notMaybe(s, d - 1, sub);
+            return chain(p, pick(kw("AND"), kw("OR")), p, 1, 2);
+        }
+
+        Generator<String> notMaybe(Scope s, int d, int sub) {
+            return seq(opt(25, kw("NOT")), predicateOperand(s, d, sub));
+        }
+
+        /** A condition for WHERE / HAVING / ON: a predicate or a logical combination. */
+        Generator<String> condition(Scope s, int d, int sub) {
+            return memo("cond", s, d, sub, () -> weighted(
+                w(1, columnRef(s)),
+                w(2, predicate(s, d, sub)),
+                w(1, logical(s, d, sub)),
+                w(1, seq(kwd("NOT"), predicateOperand(s, d - 1, sub)))));
+        }
+
+        Generator<String> caseExpr(Scope s, int d, int sub) {
+            return memo("case", s, d, sub, () -> {
+                Generator<String> e = expr(s, d - 1, sub);
+                Generator<String> searched = tuples(many(tuples(condition(s, d - 1, sub), e), 1, 3), orElse(e))
+                    .map(c -> caseText("", c.value1(), c.value2()));
+                return weighted(w(60, searched), w(40, simpleCase(s, d, sub, term(s, d - 1, sub))));
+            });
+        }
+
+        static Generator<String> orElse(Generator<String> e) {
+            return opt(60, e.map(x -> S + kw("ELSE") + S + x));
+        }
+
+        /** `CASE operand WHEN t THEN e ... END`; a signed operand as drawn (bug caseSignedOperand), parenthesised under HEGEL_NO_KNOWN. */
+        Generator<String> simpleCase(Scope s, int d, int sub, Generator<String> operand) {
+            Generator<String> t = term(s, d - 1, sub);
+            Generator<String> e = expr(s, d - 1, sub);
+            return tuples(operand.map(SqlGen::noSign), many(tuples(t, e), 1, 3), orElse(e))
+                .map(c -> caseText(S + c.value1(), c.value2(), c.value3()));
+        }
+
+        static String caseText(String operand, List<Tuple2<String, String>> whens, String orElse) {
+            StringBuilder sb = new StringBuilder(kw("CASE")).append(operand);
+            for (Tuple2<String, String> w : whens) {
+                sb.append(S).append(kw("WHEN")).append(S).append(w.value1()).append(S).append(kw("THEN")).append(S).append(w.value2());
+            }
+            return sb.append(orElse).append(S).append(kw("END")).toString();
+        }
+
+        Generator<String> cast(Scope s, int d, int sub) {
+            return cast(expr(s, d - 1, sub));
+        }
+
+        /** `CAST(operand AS type)`; a comparison or predicate operand as drawn (bug castCondition), parenthesised under HEGEL_NO_KNOWN. */
+        static Generator<String> cast(Generator<String> operand) {
+            return tuples(operand, pick("INTEGER", "INT", "REAL", "TEXT", "NUMERIC", "BLOB", "VARCHAR(5)", "CHAR(2)"))
+                .map(t -> kw("CAST") + "(" + noPredicate(t.value1()) + S + kw("AS") + S + t.value2() + ")");
+        }
+
+        Generator<String> collate(Scope s, int d, int sub) {
+            return collate(term(s, d - 1, sub), COLLATION);
+        }
+
+        /** `operand COLLATE name`; an operand ending in IS NULL/TRUE/FALSE or an ESCAPE literal as drawn (bugs collateAfterIsNull, likeEscapeCollate), parenthesised under HEGEL_NO_KNOWN. */
+        static Generator<String> collate(Generator<String> operand, Generator<String> collation) {
+            return tuples(operand, collation).map(t -> j(collatable(t.value1()), kw("COLLATE"), t.value2()));
+        }
+
+        /** `x IS [NOT] NULL|TRUE|FALSE`. */
+        Generator<String> isNull(Scope s, int d, int sub) {
+            return seq(comparand(s, d - 1, sub), kwd("IS"), NOT40, pick(kw("NULL"), kw("TRUE"), kw("FALSE")));
+        }
+
+        /** `x [NOT] LIKE 'pattern' ESCAPE 'c'`. */
+        Generator<String> likeEscape(Scope s, int d, int sub) {
+            Generator<String> pattern = tuples(pick("!", "\\", "#", "^", "a"), word("ab%_", 0, 4)).map(t -> "'" + t.value2() + "'" + S + kw("ESCAPE") + S + "'" + t.value1() + "'");
+            return seq(comparand(s, d - 1, sub), opt(30, kw("NOT")), kwd("LIKE"), pattern);
+        }
+
+        Generator<String> function(Scope s, int d, int sub) {
+            return memo("fn", s, d, sub, () -> {
+                Generator<String> e = expr(s, d - 1, sub);
+                Generator<String> texts = pick(TEXTS);
+                Generator<String> count = opt(50, ints(0, 3).map(n -> ", " + n));
+                return weighted(
+                    w(2, tuples(pick(FUNCTIONS1), e).map(t -> t.value1() + "(" + t.value2() + ")")),
+                    w(1, tuples(e, e, opt(30, LITERAL.map(l -> ", " + l))).map(t -> "coalesce(" + t.value1() + ", " + t.value2() + t.value3() + ")")),
+                    w(1, tuples(pick("ifnull", "nullif"), e, e).map(t -> t.value1() + "(" + t.value2() + ", " + t.value3() + ")")),
+                    w(1, substr(e)),
+                    w(1, tuples(e, texts, texts).map(t -> "replace(" + t.value1() + ", " + t.value2() + ", " + t.value3() + ")")),
+                    w(1, tuples(e, texts).map(t -> "instr(" + t.value1() + ", " + t.value2() + ")")),
+                    w(1, tuples(e, count).map(t -> "round(" + t.value1() + t.value2() + ")")),
+                    w(1, tuples(pick("min", "max"), e, e).map(t -> t.value1() + "(" + t.value2() + ", " + t.value3() + ")")),
+                    w(1, tuples(condition(s, d - 1, sub), e, e).map(t -> "iif(" + t.value1() + ", " + t.value2() + ", " + t.value3() + ")")),
+                    w(1, tuples(e, e).map(t -> "printf('%s|%d', " + t.value1() + ", " + t.value2() + ")")),
+                    w(1, tuples(ints(65, 90), ints(97, 122)).map(t -> "char(" + t.value1() + ", " + t.value2() + ")")),
+                    w(1, e.map(x -> "length(" + x + ")")));
+            });
+        }
+
+        /** `substr(arg, from[, count])` or `substring(...)`; a predicate argument as drawn (bug substrPredicateArgument), parenthesised under HEGEL_NO_KNOWN. */
+        static Generator<String> substr(Generator<String> arg) {
+            Generator<String> count = opt(50, ints(0, 3).map(n -> ", " + n));
+            return tuples(pick("substr", "substr", "substring"), arg, ints(-2, 3), count).map(t -> t.value1() + "(" + noPredicate(t.value2()) + ", " + t.value3() + t.value4() + ")");
+        }
+
+        /** An aggregate over the scope's rows (only where the scope allows aggregates). */
+        Generator<String> aggregate(Scope s, int d, int sub) {
+            return memo("agg", s, d, sub, () -> {
+                Scope plain = s.plain();
+                Generator<String> arg = s.empty() ? LITERAL : weighted(w(7, columnRef(s)), w(3, expr(plain, d - 1, sub)));
+                Generator<String> filter = opt(20, condition(plain, d - 1, sub).map(c -> " " + kw("FILTER") + " (" + kw("WHERE") + " " + c + ")"));
+                Generator<String> call = arg.flatMap(a -> weighted(
+                    v(1, "count(*)"),
+                    w(1, opt(30, kw("DISTINCT") + " ").map(dist -> "count(" + dist + a + ")")),
+                    w(1, tuples(pick("sum", "total", "avg"), opt(20, kw("DISTINCT") + " ")).map(t -> t.value1() + "(" + t.value2() + a + ")")),
+                    w(1, pick("min", "max").map(f -> f + "(" + a + ")")),
+                    w(1, tuples(opt(50, pick("','", "';'", "'-'").map(sep -> ", " + sep)), opt(30, " " + kw("DESC")))
+                        .map(t -> "group_concat(" + a + t.value1() + " " + kw("ORDER BY") + " " + a + t.value2() + ")")),
+                    v(1, "group_concat(" + kw("DISTINCT") + " " + a + ")"),
+                    w(3, pick("sum", "min", "max", "count").map(f -> f + "(" + a + ")"))));
+                return tuples(call, filter).map(t -> t.value1() + t.value2());
+            });
+        }
+
+        /** A window function call over the scope (aggregates as windows, or ranking functions); the order keys make the ordering total. */
+        Generator<String> window(Scope s, List<String> orderKeys, int sub) {
+            Scope plain = s.plain();
+            Generator<String> arg = plain.empty() ? LITERAL : columnRef(plain);
+            Generator<String> orderBy = opt(40, tuples(expr(plain, 1, sub), opt(50, " " + kw("DESC"))).map(t -> t.value1() + t.value2() + ", "))
+                .map(pre -> kw("ORDER BY") + " " + pre + String.join(", ", orderKeys));
+            Generator<String> frame = opt(40, tuples(pick("ROWS", "RANGE", "GROUPS"), ints(0, 3), opt(30, pick("NO OTHERS", "CURRENT ROW", "TIES").map(x -> " " + kw("EXCLUDE") + " " + x)))
+                .map(t -> {
+                    // RANGE with offsets needs exactly one ORDER BY expression
+                    String mode = t.value2() == 3 && t.value1().equals("RANGE") ? "ROWS" : t.value1();
+                    String[] frames = {kw("UNBOUNDED PRECEDING"), kw("BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW"),
+                        kw("BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING"), kw("BETWEEN 1 PRECEDING AND 1 FOLLOWING")};
+                    return " " + mode + " " + frames[t.value2()] + t.value3();
+                }));
+            return arg.flatMap(a -> {
+                Generator<String> f = weighted(
+                    v(1, "row_number()"),
+                    w(1, pick("rank()", "dense_rank()", "cume_dist()", "percent_rank()")),
+                    w(1, pick("sum", "min", "max", "count", "avg", "total").map(fn -> fn + "(" + a + ")")),
+                    w(1, tuples(pick("lag", "lead"), opt(50, opt(50, LITERAL.map(l -> ", " + l)).map(x -> ", 1" + x))).map(t -> t.value1() + "(" + a + t.value2() + ")")),
+                    w(1, pick("first_value", "last_value").map(fn -> fn + "(" + a + ")")),
+                    w(1, ints(1, 3).map(n -> "nth_value(" + a + ", " + n + ")")));
+                Generator<String> partition = opt(40, kw("PARTITION BY") + " " + a + " ");
+                return tuples(f, partition, orderBy, frame).map(t -> t.value1() + " " + kw("OVER") + " (" + t.value2() + t.value3() + t.value4() + ")");
+            });
+        }
+
+        Generator<String> scalarSubquery(Scope outer, int sub) {
+            return subquery(outer, 1, sub - 1).map(SqlGen::parens);
+        }
+
+        /** A subquery producing `width` columns (a plain select against one table, possibly correlated to the outer scope). */
+        Generator<String> subquery(Scope outer, int width, int sub) {
+            return memo("subquery" + width, outer, 0, sub, () -> tuples(INDEX, maybe(50, -1, ints(0, 9)), chance(40), chance(30)).flatMap(h -> {
+                Table t = at(tables, h.value1());
+                String alias = h.value2() < 0 ? t.name() : "s" + h.value2();
+                List<String> aliases = new ArrayList<>(List.of(alias));
+                List<List<String>> columns = new ArrayList<>(List.of(t.names()));
+                if (h.value3() && !outer.empty()) {
+                    for (int i = 0; i < outer.aliases().size(); i++) {
+                        if (!outer.aliases().get(i).equals(alias)) {
+                            aliases.add(outer.aliases().get(i));
+                            columns.add(outer.columns().get(i));
+                        }
+                    }
+                }
+                Scope s = new Scope(List.copyOf(aliases), List.copyOf(columns), false);
+                boolean agg = h.value4();
+                Generator<String> item = agg ? aggregate(new Scope(List.of(alias), List.of(t.names()), true), 1, sub) : expr(s, 1, sub);
+                Generator<String> asAlias = alias.equals(t.name()) ? lit("") : opt(50, kw("AS") + S).map(as -> as + alias);
+                Generator<String> where = opt(50, condition(s, 1, sub).map(c -> j(kw("WHERE"), c)));
+                Generator<String> tail = agg ? lit("")
+                    : opt(30, tuples(id(alias), ints(0, 3)).map(t2 -> j(kw("ORDER BY"), t2.value1() + ".id", kw("LIMIT"), String.valueOf(t2.value2()))));
+                return tuples(many(item, width, width), id(t.name()), asAlias, where, tail)
+                    .map(b -> j(kw("SELECT"), String.join(", ", b.value1()), kw("FROM"), b.value2(), b.value3(), b.value4(), b.value5()));
+            }));
+        }
