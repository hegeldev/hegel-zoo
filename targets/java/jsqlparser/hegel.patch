+    /** Replaces the expressions of the select's items, WHERE, HAVING and ON clauses by their fully parenthesised text. */
+    static void parenthesise(Select sel, List<Expression> visited) {
+        if (sel.getWithItemsList() != null) {
+            for (WithItem<?> w : sel.getWithItemsList()) {
+                if (w.getSelect() instanceof Select inner) {
+                    parenthesise(inner, visited);
+                }
+            }
+        }
+        if (sel instanceof PlainSelect ps) {
+            for (SelectItem<?> item : ps.getSelectItems()) {
+                Expression e = item.getExpression();
+                if (e instanceof Expression && !(e instanceof net.sf.jsqlparser.statement.select.AllColumns)) {
+                    visited.add(e);
+                    @SuppressWarnings("unchecked")
+                    SelectItem<Expression> it = (SelectItem<Expression>) item;
+                    it.setExpression(new Raw(Paren.of(e)));
+                }
+            }
+            if (ps.getWhere() != null) {
+                visited.add(ps.getWhere());
+                ps.setWhere(new Raw(Paren.of(ps.getWhere())));
+            }
+            if (ps.getHaving() != null) {
+                visited.add(ps.getHaving());
+                ps.setHaving(new Raw(Paren.of(ps.getHaving())));
+            }
+            if (ps.getJoins() != null) {
+                for (Join j : ps.getJoins()) {
+                    if (j.getOnExpressions() != null && !j.getOnExpressions().isEmpty()) {
+                        List<Expression> ons = new ArrayList<>();
+                        for (Expression e : j.getOnExpressions()) {
+                            visited.add(e);
+                            ons.add(new Raw(Paren.of(e)));
+                        }
+                        j.setOnExpressions(ons);
+                    }
+                }
+            }
+        } else if (sel instanceof SetOperationList sol) {
+            for (Select member : sol.getSelects()) {
+                parenthesise(member, visited);
+            }
+        } else if (sel instanceof ParenthesedSelect pq) {
+            parenthesise(pq.getSelect(), visited);
+        }
+    }
+
+    /** TablesNamesFinder finds the tables the generator referred to, and the statement's features match what SQLite does with it. */
+    @Test
+    void tablesAndFeatures() {
+        Hegel.test(tc -> {
+            SqlGen.Program p = tc.draw(SqlGen.PROGRAM, "program");
+            int columns;
+            try (Db db = Db.of(p.schema())) {
+                tc.assume(db.accepts(p.sql()) == null);
+                columns = db.columnCount(p.sql());
+            }
+            Statement s = parsedOrNull(p.sql());
+            tc.assume(s != null);
+            StatementFeatures f = s.getFeatures();
+            // sqlite-jdbc reports a result column for `ALTER TABLE ... ADD ... CHECK (...)` (the check of existing rows): DDL never returns rows
+            boolean returnsRows = p.kind() != SqlGen.Kind.DDL && columns > 0;
+            Zoo.check(f.returnsResultSet() == returnsRows, () -> "getFeatures().returnsResultSet() is " + f.returnsResultSet() + " but SQLite reports " + columns + " result columns; features " + f + describe(p));
+            switch (p.kind()) {
+                case SELECT:
+                    Zoo.check(!f.modifiesData() && !f.modifiesSchema(), () -> "a query is reported as modifying: " + f + describe(p));
+                    break;
+                case DML:
+                    Zoo.check(f.mayModifyData(), () -> "a data change is reported as not modifying data: " + f + describe(p));
+                    break;
+                default:
+                    Zoo.check(f.modifiesSchema() || f.mayModifyData(), () -> "a schema change is reported as modifying neither schema nor data: " + f + describe(p));
+            }
+            java.util.Set<String> found;
+            try {
+                found = TablesNamesFinder.findTables(p.sql());
+            } catch (Exception e) {
+                Zoo.fail("TablesNamesFinder throws " + reason(e) + describe(p));
+                return;
+            }
+            java.util.Set<String> norm = new java.util.TreeSet<>();
+            for (String t : found) {
+                norm.add(t.replace("\"", "").replace("`", "").toLowerCase());
+            }
+            // the tables the text names (t0, t1, t2 - outside string literals and comments)
+            java.util.Set<String> expected = new java.util.TreeSet<>();
+            java.util.regex.Matcher m = java.util.regex.Pattern.compile("(?<![\\w.])t\\d(?!\\w)").matcher(
+                p.sql().replaceAll("'(?:[^']|'')*'", "''").replaceAll("/\\*.*?\\*/", " ").replaceAll("--[^\\n]*", " ").replace("\"", "").replace("`", ""));
+            while (m.find()) {
+                expected.add(m.group().toLowerCase());
+            }
+            // DDL names the object it creates too; the finder may or may not list it - compare the schema's tables only
+            java.util.Set<String> normTables = new java.util.TreeSet<>();
+            for (String t : norm) {
+                if (expected.contains(t) || t.startsWith("t")) {
+                    normTables.add(t);
+                }
+            }
+            if (p.kind() == SqlGen.Kind.SELECT || p.kind() == SqlGen.Kind.DML) {
+                Zoo.check(normTables.equals(expected), () -> "TablesNamesFinder.findTables gives " + found + ", the statement refers to " + expected + describe(p));
+            }
+        }, Zoo.settings("tablesAndFeatures"));
+    }
+
+    /** A program without `--` anywhere (a line comment or the literal '--'; about one program in twenty has one). */
+    static final Generator<SqlGen.Program> WITHOUT_DASHES = SqlGen.PROGRAM.filter(p -> !p.sql().contains("--"));
+
+    /** A statement separator: one `;` with white space or a comment around it. */
+    static final Generator<String> SEPARATOR = pick(";", "; ", ";\n", " ;", ";\n\n", "; -- c\n", ";/* c */");
+    /** A separator holding an empty statement (`;;`): as the last one, bug parseStatementsTrailingEmpty's shape (parseStatements rejects it; parse accepts it). */
+    static final Generator<String> EMPTY_STATEMENT_SEPARATOR = pick(";;", "; ;", ";\n;\n");
+    /** The separator after the last statement: any separator; under HEGEL_NO_KNOWN one without an empty statement. */
+    static final Generator<String> LAST_SEPARATOR = Zoo.NO_KNOWN ? SEPARATOR : Gen.weighted(Gen.w(7, SEPARATOR), Gen.w(3, EMPTY_STATEMENT_SEPARATOR));
+
+    /** 0..3 programs each followed by a separator, then the last program with its separator, dropped 30% of the time. */
+    record Split(List<Tuple2<SqlGen.Program, String>> heads, Tuple2<SqlGen.Program, String> last, boolean dropTrailing) {
+        List<Tuple2<SqlGen.Program, String>> parts() {
+            List<Tuple2<SqlGen.Program, String>> out = new ArrayList<>(heads);
+            out.add(last);
+            return out;
+        }
+    }
+
+    static Generator<Split> split(Generator<String> lastSeparator) {
+        return tuples(many(tuples(WITHOUT_DASHES, Gen.weighted(Gen.w(9, SEPARATOR), Gen.w(1, EMPTY_STATEMENT_SEPARATOR))), 0, 3), tuples(WITHOUT_DASHES, lastSeparator), chance(30))
+            .map(t -> new Split(t.value1(), t.value2(), t.value3()));
+    }
+
+    static final Generator<Split> SPLIT = split(LAST_SEPARATOR);
+
+    /** Several statements separated by `;` parse as the list of the single parses. */
+    @Test
+    void statementsSplit() {
+        Hegel.test(tc -> splits(tc, tc.draw(SPLIT, "split")), Zoo.settings("statementsSplit"));
+    }
+
+    /** The oracle of statementsSplit: parseStatements of the joined text gives the single parses' toString()s. */
+    static void splits(TestCase tc, Split split) {
+        List<String> singles = new ArrayList<>();
+        StringBuilder sb = new StringBuilder();
+        for (Tuple2<SqlGen.Program, String> part : split.parts()) {
+            String sql = part.value1().sql().strip();
+            while (sql.endsWith(";")) {
+                sql = sql.substring(0, sql.length() - 1).strip();
+            }
+            Statement s = parsedOrNull(sql);
+            tc.assume(s != null);
+            singles.add(s.toString());
+            sb.append(sql).append(part.value2());
+        }
+        if (split.dropTrailing()) {
+            // no trailing separator at all
+            String t = sb.toString().stripTrailing();
+            while (t.endsWith(";") || t.endsWith("*/") || t.endsWith("-- c")) {
+                t = t.endsWith("*/") ? t.substring(0, t.lastIndexOf("/*")).stripTrailing() : t.endsWith("-- c") ? t.substring(0, t.length() - 4).stripTrailing() : t.substring(0, t.length() - 1).stripTrailing();
+            }
+            sb.setLength(0);
+            sb.append(t);
+        }
+        String all = sb.toString();
+        Statements st;
+        try {
+            st = CCJSqlParserUtil.parseStatements(all);
+        } catch (JSQLParserException e) {
+            Zoo.fail("parseStatements rejects statements that parse one by one: " + reason(e) + EngineText.describe(all));
+            return;
+        }
+        List<String> got = new ArrayList<>();
+        for (Statement s : st) {
+            got.add(s.toString());
+        }
+        // bug hexLiteralTrailingSpace: a hex literal keeps the white space that followed it in the text, so
+        // `X'0F' ;` prints with a trailing space where the single statement `X'0F'` does not - tolerated under HEGEL_NO_KNOWN
+        boolean hex = Zoo.NO_KNOWN && hasHex(all);
+        List<String> gotNorm = new ArrayList<>();
+        List<String> singlesNorm = new ArrayList<>();
+        for (String s : got) {
+            gotNorm.add(hex ? EngineText.squash(s) : s);
+        }
+        for (String s : singles) {
+            singlesNorm.add(hex ? EngineText.squash(s) : s);
+        }
+        Zoo.check(gotNorm.equals(singlesNorm), () -> "parseStatements gives " + got.size() + " statements " + got + ", expected " + singles + EngineText.describe(all));
+    }
+
+    static final String[] TOKENS = {"(", ")", ",", ";", "'", "\"", "`", "*", "-", "--", "+", "/", "/*", "*/", "=", "<", ">", "<>", "!", "|", "||", "&", ".", ":", "?", "$",
+        "SELECT", "FROM", "WHERE", "AND", "OR", "NOT", "NULL", "IS", "IN", "LIKE", "BETWEEN", "CASE", "WHEN", "THEN", "ELSE", "END", "AS", "ON", "JOIN", "GROUP BY", "ORDER BY",
+        "LIMIT", "OFFSET", "UNION", "ALL", "DISTINCT", "EXISTS", "CAST", "COLLATE", "VALUES", "INSERT", "INTO", "UPDATE", "SET", "DELETE", "CREATE", "TABLE", "INDEX", "VIEW", "DROP",
+        "WITH", "RECURSIVE", "OVER", "PARTITION", "ROWS", "1", "0", "1.5", "x", "t0", "id", "a", "'a'", "X'00'", " ", "\n", "\t", "ä", "\u0000"};
+
+    /**
+     * One edit of the text; positions are taken modulo the live length. Kinds: insert the token; delete 1..6
+     * characters; duplicate 1..8 characters; swap the halves around two positions; insert the token between spaces;
+     * replace one character by the token.
+     */
+    record Edit(int kind, int at, int other, int length, String token) {
+        String apply(String sql) {
+            if (sql.isEmpty()) {
+                return token;
+            }
+            int at = Math.floorMod(this.at, sql.length());
+            switch (kind) {
+                case 0:
+                    return sql.substring(0, at) + token + sql.substring(at);
+                case 1: {
+                    int len = 1 + Math.floorMod(length - 1, Math.min(6, sql.length() - at));
+                    return sql.substring(0, at) + sql.substring(at + len);
+                }
+                case 2: {
+                    int len = 1 + Math.floorMod(length - 1, Math.min(8, sql.length() - at));
+                    return sql.substring(0, at) + sql.substring(at, at + len) + sql.substring(at, at + len) + sql.substring(at + len);
+                }
+                case 3: {
+                    int b = Math.floorMod(other, sql.length());
+                    int lo = Math.min(at, b);
+                    int hi = Math.max(at, b);
+                    return sql.substring(0, lo) + sql.substring(hi) + sql.substring(lo, hi);
+                }
+                case 4:
+                    return sql.substring(0, at) + " " + token + " " + sql.substring(at);
+                default:
+                    return sql.substring(0, at) + token + sql.substring(Math.min(sql.length(), at + 1));
+            }
+        }
+    }
+
+    static final Generator<Edit> EDIT = tuples(ints(0, 5), INDEX, INDEX, ints(1, 8), pick(TOKENS)).map(t -> new Edit(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+    static final Generator<Tuple2<SqlGen.Program, List<Edit>>> MUTATION = tuples(SqlGen.PROGRAM, many(EDIT, 1, 3));
+
+    /** A random edit of a valid statement never makes JSqlParser crash or hang, and whatever it accepts it prints as a fixpoint. */
+    @Test
+    void mutationsNeverCrash() {
+        Hegel.test(tc -> {
+            Tuple2<SqlGen.Program, List<Edit>> m = tc.draw(MUTATION, "mutation");
+            String sql = m.value1().sql();
+            for (Edit e : m.value2()) {
+                sql = e.apply(sql);
+            }
+            neverCrashes(tc, sql);
+        }, Zoo.settings("mutationsNeverCrash"));
+    }
+
+    /**
+     * The oracle of mutationsNeverCrash and of the narrow text properties: parse either succeeds or fails with a
+     * parse error (never another exception, never a timeout), and what is accepted prints as a fixpoint that parses.
+     * Under HEGEL_NO_KNOWN the recorded shapes are skipped (assume) or tolerated.
+     */
+    static void neverCrashes(TestCase tc, String text) {
+        Statement s;
+        try {
+            s = CCJSqlParserUtil.parse(text, parser -> parser.withTimeOut(20000));
+        } catch (JSQLParserException e) {
+            Throwable c = e;
+            while (c.getCause() != null && c.getCause() != c) {
+                c = c.getCause();
+            }
+            Throwable cause = c;
+            boolean syntactic = cause instanceof ParseException || cause instanceof TokenMgrException || cause instanceof JSQLParserException || cause instanceof TimeoutException
+                // bug quotedIdentifierWithDot: a quoted name made of dots ends in RuntimeException("Invalid column name") - tolerated under HEGEL_NO_KNOWN
+                || (Zoo.NO_KNOWN && cause instanceof RuntimeException && String.valueOf(cause.getMessage()).startsWith("Invalid column name"));
+            Zoo.check(syntactic, () -> "parse fails with " + reason(e) + " (not a parse error)" + EngineText.describe(text));
+            Zoo.check(!(cause instanceof TimeoutException), () -> "parse times out" + EngineText.describe(text));
+            return;
+        } catch (Throwable t) {
+            Zoo.fail("parse throws " + reason(t) + EngineText.describe(text));
+            return;
+        }
+        String out;
+        try {
+            out = s.toString();
+        } catch (Throwable t) {
+            Zoo.fail("toString() of a parsed statement throws " + reason(t) + EngineText.describe(text));
+            return;
+        }
+        if (Zoo.NO_KNOWN) {
+            // bug rowGetOnNumberReprint: `3 ."id"` prints as `3."id"`, a number
+            tc.assume(!text.matches("(?s).*\\d\\s+\\.[\\w\"`].*"));
+            // bug quotedIdentifierWithDot: a quoted name with a dot in it is split at the dot when printed (the quote
+            // must open a name: the `"."` between two quoted qualifiers is not one)
+            tc.assume(!text.matches("(?s).*((?<![\\w\"])\"[^\"]*\\.[^\"]*\"|(?<![\\w`])`[^`]*\\.[^`]*`).*"));
+            // bug deleteWithoutTable: `DELETE` alone is accepted and prints as `DELETE null`
+            tc.assume(!(s instanceof net.sf.jsqlparser.statement.delete.Delete del && del.getTable() == null));
+            // bug collateKeywordNames: a printed bare COLLATE BINARY / RTRIM does not parse back
+            tc.assume(!out.matches("(?is).*\\bCOLLATE\\s+(BINARY|RTRIM)\\b.*"));
+            // bug unsupportedStatementDotNumber: the token echo of an UnsupportedStatement glues
+            // a bare `.` to its neighbours, so `REPLACE( . 5` prints as `REPLACE (.5`, which re-lexes as the number .5
+            // and prints as `REPLACE ( .5`
+            tc.assume(!(s instanceof net.sf.jsqlparser.statement.UnsupportedStatement && text.matches("(?s).*\\.\\s+\\d.*")));
+        }
+        try {
+            String out2 = parse(out).toString();
+            Zoo.check(samePrint(out, out2), () -> "toString() is not a fixpoint for an accepted text: " + EngineText.diff(out, out2) + EngineText.describe(text));
+        } catch (JSQLParserException e) {
+            Zoo.fail("toString() of an accepted text does not parse: " + reason(e) + "\n    printed: " + EngineText.describe(out) + EngineText.describe(text));
+        }
+    }
+
+    // ----- the recorded bugs' shapes, one narrow property each, over the region of the shape with random contents
+
+    /** bug stackedUnaryOperators: `- -1`, `~ ~a`, `+-x` in a select item. */
+    @Test
+    void stackedUnaryOperatorsAgreeWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.STACKED_UNARY, "program")), Zoo.settings("stackedUnaryOperatorsAgreeWithSqlite"));
+    }
+
+    /** bug predicateIsTrue: a comparison or predicate tested with IS [NOT] TRUE/FALSE. */
+    @Test
+    void predicateIsTrueAgreesWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.PREDICATE_IS_BOOLEAN, "program")), Zoo.settings("predicateIsTrueAgreesWithSqlite"));
+    }
+
+    /** bug collateKeywordNames: COLLATE BINARY / RTRIM written bare. */
+    @Test
+    void collateKeywordNamesAgreeWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.COLLATE_KEYWORD_NAME, "program")), Zoo.settings("collateKeywordNamesAgreeWithSqlite"));
+    }
+
+    /** bug excludeColumn: a CREATE TABLE with a column named exclude. */
+    @Test
+    void excludeColumnAgreesWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.EXCLUDE_COLUMN, "program")), Zoo.settings("excludeColumnAgreesWithSqlite"));
+    }
+
+    /** bug quotedIdentifierWithDot: a quoted column name holding a dot. */
+    @Test
+    void quotedNamesWithDotsAgreeWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.DOTTED_NAME, "program")), Zoo.settings("quotedNamesWithDotsAgreeWithSqlite"));
+    }
+
+    /** bug hexLiteralTrailingSpace: a hex literal followed by white space. */
+    @Test
+    void hexLiteralPrintIsFixpoint() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.HEX_LITERAL_ITEM, "program")), Zoo.settings("hexLiteralPrintIsFixpoint"));
+    }
+
+    /** bug replaceLikeInsert: REPLACE / INSERT OR REPLACE with DEFAULT VALUES or RETURNING. */
+    @Test
+    void replaceWithInsertTailAgreesWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.REPLACE_WITH_TAIL, "program")), Zoo.settings("replaceWithInsertTailAgreesWithSqlite"));
+    }
+
+    /** bug parseStatementsTrailingEmpty: the statements end in an empty statement (`;;`). */
+    @Test
+    void trailingEmptyStatementSplits() {
+        Generator<Split> ending = split(Zoo.NO_KNOWN ? SEPARATOR : EMPTY_STATEMENT_SEPARATOR);
+        Hegel.test(tc -> splits(tc, tc.draw(ending, "split")), Zoo.settings("trailingEmptyStatementSplits"));
+    }
+
+    /** bug rowValueSetStartsWithSubquery: `SET (a, b) = ((...), e)`. */
+    @Test
+    void rowValueSetStartingWithParenthesisAgreesWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.ROW_VALUE_SET, "program")), Zoo.settings("rowValueSetStartingWithParenthesisAgreesWithSqlite"));
+    }
+
+    /** bug caseSignedOperand: `CASE -x WHEN ...`. */
+    @Test
+    void caseSignedOperandAgreesWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.CASE_SIGNED_OPERAND, "program")), Zoo.settings("caseSignedOperandAgreesWithSqlite"));
+    }
+
+    /** bug castCondition: `CAST(a = 1 AS TEXT)` and other conditions in CAST. */
+    @Test
+    void castConditionAgreesWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.CAST_CONDITION, "program")), Zoo.settings("castConditionAgreesWithSqlite"));
+    }
+
+    /** bug typelessColumnConstraints: a typeless column with constraints or beside typed ones. */
+    @Test
+    void typelessColumnsAgreeWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.TYPELESS_COLUMN, "program")), Zoo.settings("typelessColumnsAgreeWithSqlite"));
+    }
+
+    /** bug collateAfterIsNull: `a IS NULL COLLATE NOCASE`. */
+    @Test
+    void collateAfterIsNullAgreesWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.COLLATE_AFTER_IS_NULL, "program")), Zoo.settings("collateAfterIsNullAgreesWithSqlite"));
+    }
+
+    /** bug likeEscapeCollate: `a LIKE 'x' ESCAPE '!' COLLATE NOCASE`. */
+    @Test
+    void likeEscapeCollateAgreesWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.LIKE_ESCAPE_COLLATE, "program")), Zoo.settings("likeEscapeCollateAgreesWithSqlite"));
+    }
+
+    /** bug substrPredicateArgument: a predicate as the first argument of substr / substring. */
+    @Test
+    void substrPredicateArgumentAgreesWithSqlite() {
+        Hegel.test(tc -> agrees(tc.draw(SqlGen.Shapes.SUBSTR_PREDICATE, "program")), Zoo.settings("substrPredicateArgumentAgreesWithSqlite"));
+    }
+
+    static final Generator<String> SPACES = word(" \t", 1, 3);
+
+    /**
+     * bug rowGetOnNumberReprint: `3 ."id"` - a `.field` accessor on a number (under HEGEL_NO_KNOWN on a column), in a
+     * WHERE or a select item.
+     */
+    static final Generator<String> ROW_GET_ON_NUMBER = tuples(pick("SELECT * FROM t0 WHERE ", "SELECT "), Zoo.NO_KNOWN ? pick("a", "t0.a", "\"b\"") : ints(0, 999).map(String::valueOf),
+        SPACES, pick("\"id\"", "id", "`x`", "\"a b\"", "a"), pick(" > 1", " = 0", " <> 2"), pick(" FROM t0", ""))
+        .map(t -> t.value1() + t.value2() + t.value3() + "." + t.value4() + t.value5() + (t.value1().startsWith("SELECT *") ? "" : t.value6()));
+
+    /** bug rowGetOnNumberReprint: what parse() accepts, toString() prints so that parse() accepts it again. */
+    @Test
+    void rowGetOnNumberReprintParses() {
+        Hegel.test(tc -> neverCrashes(tc, tc.draw(ROW_GET_ON_NUMBER, "text")), Zoo.settings("rowGetOnNumberReprintParses"));
+    }
+
+    /** bug deleteWithoutTable: `DELETE` or `DELETE FROM` with no table, a `;` and text after it (under HEGEL_NO_KNOWN `DELETE FROM t0`). */
+    static final Generator<String> DELETE_WITHOUT_TABLE = tuples(pick("DELETE", "delete", "Delete"), Zoo.NO_KNOWN ? just(" FROM t0") : opt(50, " FROM"), opt(50, pick(";", " ;", "\n;")),
+        opt(40, pick(" FROM t0", " SELECT 1", " WHERE id = 1", " t0")))
+        .map(t -> t.value1() + t.value2() + t.value3() + (t.value3().isEmpty() ? "" : t.value4()));
+
+    /** bug deleteWithoutTable: a DELETE without a table is rejected, or at least prints as something that parses. */
+    @Test
+    void deleteWithoutTableReprintParses() {
+        Hegel.test(tc -> neverCrashes(tc, tc.draw(DELETE_WITHOUT_TABLE, "text")), Zoo.settings("deleteWithoutTableReprintParses"));
+    }
+
+    /** bug unsupportedStatementDotNumber: an unsupported statement holding a bare `.` before a number (glued to it under HEGEL_NO_KNOWN, one token). */
+    static final Generator<String> UNSUPPORTED_DOT_NUMBER = tuples(pick("REPLACE(", "REPLACE( INTO t0 VALUES (1,", "REPLACE ( a,"), word(" ", 0, 2), Zoo.NO_KNOWN ? just("") : SPACES,
+        ints(0, 999), opt(50, ")"))
+        .map(t -> t.value1() + t.value2() + "." + t.value3() + t.value4() + t.value5());
+
+    /** bug unsupportedStatementDotNumber: toString() of an UnsupportedStatement is a fixpoint. */
+    @Test
+    void unsupportedStatementDotNumberReprintIsFixpoint() {
+        Hegel.test(tc -> neverCrashes(tc, tc.draw(UNSUPPORTED_DOT_NUMBER, "text")), Zoo.settings("unsupportedStatementDotNumberReprintIsFixpoint"));
+    }
