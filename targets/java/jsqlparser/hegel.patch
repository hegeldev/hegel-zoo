+        /** The source of an INSERT's rows, and whether an upsert clause may follow it. */
+        record Tail(String text, boolean upsertable) {
+        }
+
+        static final Generator<String> INSERT_HEAD = weighted(v(75, kw("INSERT")), v(15, kw("INSERT") + S + kw("OR REPLACE")), v(10, kw("REPLACE")));
+        /** The REPLACE spellings (bug replaceLikeInsert); a plain INSERT under HEGEL_NO_KNOWN. */
+        static final Generator<String> REPLACE_HEAD = Zoo.NO_KNOWN ? just(kw("INSERT")) : pick(kw("REPLACE"), kw("INSERT") + S + kw("OR REPLACE"));
+
+        Generator<String> insert(Table t, Scope s, int sub) {
+            return insert(t, s, sub, INSERT_HEAD, ints(0, 9), returning(s, sub));
+        }
+
+        /**
+         * `head INTO t ...`: form 0 is DEFAULT VALUES, 1..6 VALUES rows, 7..9 a SELECT; {@code ret} the RETURNING clause
+         * ("" for none). A REPLACE takes DEFAULT VALUES and RETURNING like an INSERT (bug replaceLikeInsert: JSqlParser
+         * rejects both), not under HEGEL_NO_KNOWN.
+         */
+        Generator<String> insert(Table t, Scope s, int sub, Generator<String> head, Generator<Integer> form, Generator<String> ret) {
+            List<String> data = t.dataColumns();
+            return tuples(head, form, chance(30), many(chance(70), data.size(), data.size()), chance(80)).flatMap(h -> {
+                boolean replace = h.value1().contains("REPLACE");
+                boolean plainTail = Zoo.NO_KNOWN && replace;
+                Generator<String> into = id(t.name()).map(name -> j(h.value1(), kw("INTO"), name));
+                if (h.value2() == 0 && !plainTail) {
+                    return tuples(into, ret).map(r -> j(r.value1(), kw("DEFAULT VALUES"), r.value2()));
+                }
+                // the column list: a subset (never the id, unless explicitly with a fresh value)
+                List<String> cols = new ArrayList<>();
+                boolean withId = h.value3();
+                if (withId) {
+                    cols.add("id");
+                }
+                for (int i = 0; i < data.size(); i++) {
+                    if (h.value4().get(i)) {
+                        cols.add(data.get(i));
+                    }
+                }
+                boolean listed = !cols.isEmpty() && h.value5();
