+import org.junit.jupiter.api.Test;
+
+/**
+ * JSqlParser against SQLite: a random statement in the dialect both accept (SqlGen) must parse, print back to a
+ * statement SQLite accepts with the same meaning, and the tree must group the operators as SQLite does.
+ */
+class JSqlParserTest {
+
+    static SqlGen.Program program(TestCase tc) {
+        return new SqlGen(tc, chance(tc, 30)).program();
+    }
+
+    static Statement parse(String sql) throws JSQLParserException {
+        return CCJSqlParserUtil.parse(sql);
+    }
+
+    static String describe(SqlGen.Program p) {
+        return EngineText.describe(p.sql()) + "\n    schema: " + String.join("; ", p.schema().setup());
+    }
+
+    /** The message of a JSQLParserException without the SQL echo. */
+    static String reason(Throwable e) {
+        Throwable c = e;
+        while (c.getCause() != null && c.getCause() != c) {
+            c = c.getCause();
+        }
+        String m = String.valueOf(c.getMessage()).replace("\n", " ");
+        return c.getClass().getSimpleName() + ": " + (m.length() > 200 ? m.substring(0, 200) + "…" : m);
+    }
+
+    /** Both results equal: same acceptance, same rows (ordered or as a multiset), same update count. */
+    static String sameResult(Db.Result a, Db.Result b, boolean ordered) {
+        return sameResult(a, b, ordered, true);
+    }
+
+    static String sameResult(Db.Result a, Db.Result b, boolean ordered, boolean names) {
+        if (a.ok() != b.ok()) {
+            return a.ok() ? "the reprint fails in SQLite: " + b.error() : "the original fails in SQLite (" + a.error() + ") but the reprint runs";
+        }
+        if (!a.ok()) {
+            return a.error().equals(b.error()) ? null : "different SQLite errors: " + a.error() + " vs " + b.error();
+        }
+        if (names && !normNames(a.names()).equals(normNames(b.names()))) {
+            return "different column names: " + a.names() + " vs " + b.names();
+        }
+        List<String> x = ordered ? a.lines() : a.sorted();
+        List<String> y = ordered ? b.lines() : b.sorted();
+        if (!x.equals(y)) {
+            return "different rows: " + Db.show(x) + " vs " + Db.show(y);
+        }
+        if (a.updateCount() != b.updateCount()) {
+            return "different change counts: " + a.updateCount() + " vs " + b.updateCount();
+        }
+        return null;
+    }
+
+    static List<String> normNames(List<String> names) {
+        List<String> out = new ArrayList<>();
+        for (String s : names) {
+            out.add(EngineText.squash(s.replaceAll("'(?:[^']|'')*'", "''").replaceAll("/\\*.*?\\*/", " ").replaceAll("--[^\\n]*", " ")).toLowerCase().replace("(", "").replace(")", "").replace(" ", ""));
+        }
+        return out;
+    }
+
+    /** Runs a statement on a fresh database of the program's schema and captures the result and the database after it. */
+    record Outcome(Db.Result result, TreeMap<String, List<String>> after) {
+    }
+
+    static Outcome outcome(SqlGen.Program p, String sql) {
+        try (Db db = Db.of(p.schema())) {
+            Db.Result r = db.run(sql);
+            return new Outcome(r, db.snapshot());
+        }
+    }
+
+    /** Where the meaning of the original and of a reprint differ, or null. */
+    static String differentMeaning(SqlGen.Program p, String reprint) {
+        return differentMeaning(p, reprint, true);
+    }
+
+    static String differentMeaning(SqlGen.Program p, String reprint, boolean names) {
+        Outcome a = outcome(p, p.sql());
+        Outcome b = outcome(p, reprint);
+        String d = sameResult(a.result, b.result, p.ordered(), names);
+        if (d == null && !a.after.equals(b.after)) {
+            for (String k : a.after.keySet()) {
+                if (!Objects.equals(a.after.get(k), b.after.get(k))) {
+                    return "the database differs afterwards at " + k + ": " + Db.show(a.after.get(k)) + " vs " + Db.show(b.after.getOrDefault(k, List.of()));
+                }
+            }
+            return "the database differs afterwards: " + a.after.keySet() + " vs " + b.after.keySet();
+        }
+        if (d != null) {
+            // confirm the original is stable before blaming the reprint
+            Outcome a2 = outcome(p, p.sql());
+            if (sameResult(a.result, a2.result, p.ordered()) != null) {
+                return null;
+            }
+        }
+        return d;
+    }
+
+    /** SQLite accepts the program (else the generator is at fault), JSqlParser accepts it, prints it back to SQL with the same meaning, and the print is a fixpoint. */
+    @Test
+    void agreesWithSqlite() {
+        Hegel.test(tc -> {
+            SqlGen.Program p = program(tc);
+            String rejected;
+            try (Db db = Db.of(p.schema())) {
+                rejected = db.accepts(p.sql());
+            }
+            if (rejected != null) {
+                Zoo.fail("generator: SQLite rejects the program: " + rejected + describe(p));
+                return;
+            }
+            Statement s;
+            try {
+                s = parse(p.sql());
+            } catch (JSQLParserException e) {
+                Zoo.fail("rejects a statement SQLite accepts: " + reason(e) + describe(p));
+                return;
+            }
+            String out = s.toString();
+            String d = differentMeaning(p, out);
+            Zoo.check(d == null, () -> "toString() changes the meaning: " + d + "\n    printed: " + EngineText.describe(out) + describe(p));
+            Statement s2;
+            try {
+                s2 = parse(out);
+            } catch (JSQLParserException e) {
+                Zoo.fail("toString() is not parseable: " + reason(e) + "\n    printed: " + EngineText.describe(out) + describe(p));
+                return;
+            }
+            String out2 = s2.toString();
+            boolean hex = out.contains("X'") || out.contains("x'");
+            Zoo.check(hex ? EngineText.squash(out2).equals(EngineText.squash(out)) : out2.equals(out), () -> "toString() is not a fixpoint: " + EngineText.diff(out, out2) + describe(p));
+            Zoo.check(s2.getClass() == s.getClass(), () -> "the reprint parses to a " + s2.getClass().getSimpleName() + ", the original to a " + s.getClass().getSimpleName() + describe(p));
+            StringBuilder sb = new StringBuilder();
+            s.accept(new StatementDeParser(sb));
+            String dep = sb.toString();
+            Zoo.check(EngineText.squash(dep).equals(EngineText.squash(out)), () -> "StatementDeParser differs from toString(): " + EngineText.diff(out, dep) + describe(p));
+        }, Zoo.settings("agreesWithSqlite"));
+    }
+
+    /** Fully parenthesising the parsed tree does not change what SQLite computes: the parser groups operators as SQLite does. */
+    @Test
+    void treeMatchesSqlite() {
+        Hegel.test(tc -> {
+            SqlGen.Program p = program(tc);
+            if (p.kind() != SqlGen.Kind.SELECT) {
+                return;
+            }
+            Statement s;
+            try (Db db = Db.of(p.schema())) {
+                if (db.accepts(p.sql()) != null) {
+                    return;
+                }
+                s = parse(p.sql());
+            } catch (JSQLParserException e) {
+                return;
+            }
+            if (!(s instanceof Select sel)) {
+                return;
+            }
+            List<Expression> visited = new ArrayList<>();
+            parenthesise(sel, visited);
+            String out = s.toString();
+            String d = differentMeaning(p, out, false);
+            Zoo.check(d == null, () -> "the tree groups the operators differently from SQLite: " + d + "\n    tree: " + EngineText.describe(out) + describe(p));
+            // every expression prints to text the expression parser reads back the same way
+            for (Expression e : visited) {
+                String text = e.toString();
+                if (text.contains("SELECT") || text.contains("select")) {
+                    continue;
+                }
+                try {
+                    Expression back = CCJSqlParserUtil.parseExpression(text, false);
+                    String again = back.toString();
+                    boolean hex = text.contains("X'") || text.contains("x'"); // bug hexLiteralTrailingSpace
+                    Zoo.check(hex ? EngineText.squash(again).equals(EngineText.squash(text)) : again.equals(text), () -> "parseExpression(toString()) prints differently: " + EngineText.diff(text, again) + describe(p));
+                } catch (JSQLParserException ex) {
+                    Zoo.fail("parseExpression rejects a printed expression: " + reason(ex) + "\n    expression: " + text + describe(p));
+                }
+            }
+        }, Zoo.settings("treeMatchesSqlite"));
+    }
+
+    /** Replaces the expressions of the select's items, WHERE, HAVING and ON clauses by their fully parenthesised text. */
+    static void parenthesise(Select sel, List<Expression> visited) {
+        if (sel.getWithItemsList() != null) {
+            for (WithItem<?> w : sel.getWithItemsList()) {
+                if (w.getSelect() instanceof Select inner) {
+                    parenthesise(inner, visited);
+                }
+            }
+        }
+        if (sel instanceof PlainSelect ps) {
+            for (SelectItem<?> item : ps.getSelectItems()) {
+                Expression e = item.getExpression();
+                if (e instanceof Expression && !(e instanceof net.sf.jsqlparser.statement.select.AllColumns)) {
+                    visited.add(e);
+                    @SuppressWarnings("unchecked")
+                    SelectItem<Expression> it = (SelectItem<Expression>) item;
+                    it.setExpression(new Raw(Paren.of(e)));
+                }
+            }
+            if (ps.getWhere() != null) {
+                visited.add(ps.getWhere());
+                ps.setWhere(new Raw(Paren.of(ps.getWhere())));
+            }
+            if (ps.getHaving() != null) {
+                visited.add(ps.getHaving());
+                ps.setHaving(new Raw(Paren.of(ps.getHaving())));
+            }
+            if (ps.getJoins() != null) {
+                for (Join j : ps.getJoins()) {
+                    if (j.getOnExpressions() != null && !j.getOnExpressions().isEmpty()) {
+                        List<Expression> ons = new ArrayList<>();
+                        for (Expression e : j.getOnExpressions()) {
+                            visited.add(e);
+                            ons.add(new Raw(Paren.of(e)));
+                        }
+                        j.setOnExpressions(ons);
+                    }
+                }
+            }
+        } else if (sel instanceof SetOperationList sol) {
+            for (Select member : sol.getSelects()) {
+                parenthesise(member, visited);
+            }
+        } else if (sel instanceof ParenthesedSelect pq) {
+            parenthesise(pq.getSelect(), visited);
+        }
+    }
+
+    /** TablesNamesFinder finds the tables the generator referred to, and the statement's features match what SQLite does with it. */
+    @Test
+    void tablesAndFeatures() {
+        Hegel.test(tc -> {
+            SqlGen.Program p = program(tc);
+            Statement s;
+            int columns;
+            try (Db db = Db.of(p.schema())) {
+                if (db.accepts(p.sql()) != null) {
+                    return;
+                }
+                columns = db.columnCount(p.sql());
+                s = parse(p.sql());
+            } catch (JSQLParserException e) {
+                return;
+            }
+            StatementFeatures f = s.getFeatures();
+            // sqlite-jdbc reports a result column for `ALTER TABLE ... ADD ... CHECK (...)` (the check of existing rows): DDL never returns rows
+            boolean returnsRows = p.kind() != SqlGen.Kind.DDL && columns > 0;
+            Zoo.check(f.returnsResultSet() == returnsRows, () -> "getFeatures().returnsResultSet() is " + f.returnsResultSet() + " but SQLite reports " + columns + " result columns; features " + f + describe(p));
+            switch (p.kind()) {
+                case SELECT:
+                    Zoo.check(!f.modifiesData() && !f.modifiesSchema(), () -> "a query is reported as modifying: " + f + describe(p));
+                    break;
+                case DML:
+                    Zoo.check(f.mayModifyData(), () -> "a data change is reported as not modifying data: " + f + describe(p));
+                    break;
+                default:
+                    Zoo.check(f.modifiesSchema() || f.mayModifyData(), () -> "a schema change is reported as modifying neither schema nor data: " + f + describe(p));
+            }
+            java.util.Set<String> found;
+            try {
+                found = TablesNamesFinder.findTables(p.sql());
+            } catch (Exception e) {
+                Zoo.fail("TablesNamesFinder throws " + reason(e) + describe(p));
+                return;
+            }
+            java.util.Set<String> norm = new java.util.TreeSet<>();
+            for (String t : found) {
+                norm.add(t.replace("\"", "").replace("`", "").toLowerCase());
+            }
+            // the tables the text names (t0, t1, t2 — outside string literals and comments; the generator's own
+            // bookkeeping over-approximates when it picks a table and then discards the shape)
+            java.util.Set<String> expected = new java.util.TreeSet<>();
+            java.util.regex.Matcher m = java.util.regex.Pattern.compile("(?<![\\w.])t\\d(?!\\w)").matcher(
+                p.sql().replaceAll("'(?:[^']|'')*'", "''").replaceAll("/\\*.*?\\*/", " ").replaceAll("--[^\\n]*", " ").replace("\"", "").replace("`", ""));
+            while (m.find()) {
+                expected.add(m.group().toLowerCase());
+            }
+            // DDL names the object it creates too; the finder may or may not list it — compare the schema's tables only
+            java.util.Set<String> normTables = new java.util.TreeSet<>();
+            for (String t : norm) {
+                if (expected.contains(t) || t.startsWith("t")) {
+                    normTables.add(t);
+                }
+            }
+            if (p.kind() == SqlGen.Kind.SELECT || p.kind() == SqlGen.Kind.DML) {
+                Zoo.check(normTables.equals(expected), () -> "TablesNamesFinder.findTables gives " + found + ", the statement refers to " + expected + describe(p));
+            }
+        }, Zoo.settings("tablesAndFeatures"));
+    }
+
+    /** Several statements separated by `;` parse as the list of the single parses. */
+    @Test
+    void statementsSplit() {
+        Hegel.test(tc -> {
+            int k = n(tc, 1, 4);
+            List<SqlGen.Program> ps = new ArrayList<>();
+            List<String> singles = new ArrayList<>();
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < k; i++) {
+                SqlGen.Program p = program(tc);
+                String sql = p.sql().strip();
+                while (sql.endsWith(";")) {
+                    sql = sql.substring(0, sql.length() - 1).strip();
+                }
+                if (sql.contains("--")) {
+                    return;
+                }
+                try {
+                    singles.add(parse(sql).toString());
+                } catch (JSQLParserException e) {
+                    return;
+                }
+                ps.add(p);
+                sb.append(sql).append(pick(tc, ";", "; ", ";\n", " ;", ";\n\n", "; -- c\n", ";/* c */"));
+            }
+            if (chance(tc, 30)) {
+                // no trailing separator at all
+                String t = sb.toString().stripTrailing();
+                while (t.endsWith(";") || t.endsWith("*/") || t.endsWith("-- c")) {
+                    t = t.endsWith("*/") ? t.substring(0, t.lastIndexOf("/*")).stripTrailing() : t.endsWith("-- c") ? t.substring(0, t.length() - 4).stripTrailing() : t.substring(0, t.length() - 1).stripTrailing();
+                }
+                sb.setLength(0);
+                sb.append(t);
+            }
+            String all = sb.toString();
+            Statements st;
+            try {
+                st = CCJSqlParserUtil.parseStatements(all);
+            } catch (JSQLParserException e) {
+                Zoo.fail("parseStatements rejects statements that parse one by one: " + reason(e) + EngineText.describe(all));
+                return;
+            }
+            List<String> got = new ArrayList<>();
+            for (Statement s : st) {
+                got.add(s.toString());
+            }
+            Zoo.check(got.equals(singles), () -> "parseStatements gives " + got.size() + " statements " + got + ", expected " + singles + EngineText.describe(all));
+        }, Zoo.settings("statementsSplit"));
+    }
+
+    /** A random edit of a valid statement never makes JSqlParser crash or hang, and whatever it accepts it prints as a fixpoint. */
+    @Test
+    void mutationsNeverCrash() {
+        Hegel.test(tc -> {
+            SqlGen.Program p = program(tc);
+            String sql = p.sql();
+            int edits = n(tc, 1, 3);
+            for (int i = 0; i < edits; i++) {
+                sql = mutate(tc, sql);
+            }
+            String text = sql;
+            Statement s;
+            try {
+                s = CCJSqlParserUtil.parse(text, parser -> parser.withTimeOut(20000));
+            } catch (JSQLParserException e) {
+                Throwable c = e;
+                while (c.getCause() != null && c.getCause() != c) {
+                    c = c.getCause();
+                }
+                Throwable cause = c;
+                boolean syntactic = cause instanceof ParseException || cause instanceof TokenMgrException || cause instanceof JSQLParserException || cause instanceof TimeoutException
+                    // bug quotedIdentifierWithDot: a quoted name made of dots ends in RuntimeException("Invalid column name")
+                    || (cause instanceof RuntimeException && String.valueOf(cause.getMessage()).startsWith("Invalid column name"));
+                Zoo.check(syntactic, () -> "parse fails with " + reason(e) + " (not a parse error)" + EngineText.describe(text));
+                Zoo.check(!(cause instanceof TimeoutException), () -> "parse times out" + EngineText.describe(text));
+                return;
+            } catch (Throwable t) {
+                Zoo.fail("parse throws " + reason(t) + EngineText.describe(text));
+                return;
+            }
+            String out;
+            try {
+                out = s.toString();
+            } catch (Throwable t) {
+                Zoo.fail("toString() of a parsed statement throws " + reason(t) + EngineText.describe(text));
+                return;
+            }
+            if (text.matches("(?s).*\\d\\s+\\.[\\w\"`].*")) {
+                return; // bug rowGetOnNumberReprint: `3 ."id"` prints as `3."id"`, a number
+            }
+            if (s instanceof net.sf.jsqlparser.statement.delete.Delete && ((net.sf.jsqlparser.statement.delete.Delete) s).getTable() == null) {
+                return; // bug deleteWithoutTable: `DELETE` alone is accepted and prints as `DELETE null`
+            }
+            if (out.matches("(?is).*\\b(BINARY|RTRIM)\\b.*")) {
+                return; // bug collateKeywordNames: a printed bare BINARY / RTRIM does not parse back
+            }
+            try {
+                String out2 = parse(out).toString();
+                boolean hex = out.contains("X'") || out.contains("x'");
+                Zoo.check(hex ? EngineText.squash(out2).equals(EngineText.squash(out)) : out2.equals(out), () -> "toString() is not a fixpoint for an accepted text: " + EngineText.diff(out, out2) + EngineText.describe(text));
+            } catch (JSQLParserException e) {
+                Zoo.fail("toString() of an accepted text does not parse: " + reason(e) + "\n    printed: " + EngineText.describe(out) + EngineText.describe(text));
+            }
+        }, Zoo.settings("mutationsNeverCrash"));
+    }
+
+    static final String[] TOKENS = {"(", ")", ",", ";", "'", "\"", "`", "*", "-", "--", "+", "/", "/*", "*/", "=", "<", ">", "<>", "!", "|", "||", "&", ".", ":", "?", "$",
+        "SELECT", "FROM", "WHERE", "AND", "OR", "NOT", "NULL", "IS", "IN", "LIKE", "BETWEEN", "CASE", "WHEN", "THEN", "ELSE", "END", "AS", "ON", "JOIN", "GROUP BY", "ORDER BY",
+        "LIMIT", "OFFSET", "UNION", "ALL", "DISTINCT", "EXISTS", "CAST", "COLLATE", "VALUES", "INSERT", "INTO", "UPDATE", "SET", "DELETE", "CREATE", "TABLE", "INDEX", "VIEW", "DROP",
+        "WITH", "RECURSIVE", "OVER", "PARTITION", "ROWS", "1", "0", "1.5", "x", "t0", "id", "a", "'a'", "X'00'", " ", "\n", "\t", "ä", "\u0000"};
+
+    static String mutate(TestCase tc, String sql) {
+        if (sql.isEmpty()) {
+            return pick(tc, TOKENS);
+        }
+        int at = n(tc, 0, sql.length() - 1);
+        switch (n(tc, 0, 5)) {
+            case 0:
+                return sql.substring(0, at) + pick(tc, TOKENS) + sql.substring(at);
+            case 1: {
+                int len = n(tc, 1, Math.min(6, sql.length() - at));
+                return sql.substring(0, at) + sql.substring(at + len);
+            }
+            case 2: {
+                int len = n(tc, 1, Math.min(8, sql.length() - at));
+                return sql.substring(0, at) + sql.substring(at, at + len) + sql.substring(at, at + len) + sql.substring(at + len);
+            }
+            case 3: {
+                int b = n(tc, 0, sql.length() - 1);
+                int lo = Math.min(at, b);
+                int hi = Math.max(at, b);
+                return sql.substring(0, lo) + sql.substring(hi) + sql.substring(lo, hi);
+            }
+            case 4:
+                return sql.substring(0, at) + " " + pick(tc, TOKENS) + " " + sql.substring(at);
+            default:
+                return sql.substring(0, at) + pick(tc, TOKENS) + sql.substring(Math.min(sql.length(), at + 1));
+        }
+    }
+}
