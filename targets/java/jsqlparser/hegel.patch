+        /** An ORDER BY key: by form a group expression (0), a column index (1), an item name (2) or an expression (3), then COLLATE / ASC DESC / NULLS. */
+        record Key(int form, int index, String expr, String collate, String dir, String nulls) {
+            String text(Grouping g, List<Item> items) {
+                String key;
+                List<String> named = new ArrayList<>();
+                for (int i = 0; i < items.size(); i++) {
+                    String nm = items.get(i).name(i);
+                    if (nm != null && !nm.equals("*")) {
+                        named.add(nm);
+                    }
+                }
+                if (form == 0) {
+                    key = at(g.groupExprs(), index);
+                } else if (form == 1) {
+                    key = String.valueOf(1 + Math.floorMod(index, items.size()));
+                } else if (form == 2 && !named.isEmpty()) {
+                    key = at(named, index);
+                } else {
+                    key = expr;
+                }
+                String p = plain(key);
+                // no chained COLLATE: JSqlParser rejects `x COLLATE a COLLATE b`, SQLite takes the first. A key ending in
+                // IS NULL or an ESCAPE literal takes the COLLATE as drawn (bugs collateAfterIsNull, likeEscapeCollate:
+                // JSqlParser rejects it there), not under HEGEL_NO_KNOWN
+                boolean chained = p.matches("(?is).*\\bCOLLATE\\b.*");
+                if (!collate.isEmpty() && !chained && !(Zoo.NO_KNOWN && endsUncollatable(p))) {
+                    key = j(key, kw("COLLATE"), collate);
+                }
+                return j(key, dir, nulls);
+            }
+        }
+
+        Generator<Key> key(From f, Grouping g, int sub) {
+            Generator<Integer> form = g.grouped() ? weighted(v(1, 0), v(1, 1)) : weighted(v(30, 1), v(21, 2), v(49, 3));
+            Generator<String> e = expr(f.scope(), 1, sub).map(SqlGen::noIndex);
+            Generator<Tuple2<Integer, String>> formAndExpr = form.flatMap(fm -> tuples(just(fm), fm >= 2 ? e : lit("")));
+            return tuples(formAndExpr, INDEX, opt(30, COLLATION), opt(40, pick(kw("ASC"), kw("DESC"))), opt(25, pick(kw("NULLS FIRST"), kw("NULLS LAST"))))
+                .map(t -> new Key(t.value1().value1(), t.value2(), t.value1().value2(), t.value3(), t.value4(), t.value5()));
+        }
+
+        static final Generator<String> LIMIT_TEXT = weighted(
+            w(7, tuples(pick("0", "1", "2", "3", "-1", "10"), opt(50, ints(0, 3).map(o -> S + kw("OFFSET") + S + o))).map(t -> S + kw("LIMIT") + S + t.value1() + t.value2())),
+            w(3, tuples(ints(0, 2), ints(0, 3)).map(t -> S + kw("LIMIT") + S + t.value1() + ", " + t.value2())));
+
+        /** A plain SELECT with FROM (tables/joins/subquery/the CTE), WHERE, GROUP BY, HAVING, ORDER BY, LIMIT. */
+        Generator<Query> plainSelect(Table cte, int sub) {
+            return from(cte, sub).flatMap(f -> grouping(f, sub).flatMap(g -> {
+                Scope plain = f.scope();
+                Generator<Tuple2<Item, List<Item>>> items = tuples(item(f, g, sub, true), many(item(f, g, sub, false), 0, 3));
+                Generator<String> distinct = opt(15, pick(kw("DISTINCT"), kw("ALL")));
+                Generator<String> where = f.noFrom() ? lit("") : opt(55, condition(plain, 3, sub));
+                Generator<String> having = g.grouped() ? opt(40, condition(plain.aggregating(), 2, sub)) : lit("");
+                Generator<List<Key>> order = maybe(45, List.<Key>of(), many(key(f, g, sub), 1, 2));
+                return tuples(items, distinct, where, having, order, chance(60), tuples(ints(0, 99), LIMIT_TEXT)).map(t -> {
+                    List<Item> all = new ArrayList<>();
+                    all.add(t.value1().value1());
+                    all.addAll(t.value1().value2());
+                    List<String> texts = new ArrayList<>();
+                    List<String> names = new ArrayList<>();
+                    boolean star = false;
+                    for (int i = 0; i < all.size(); i++) {
+                        texts.add(all.get(i).text(i));
+                        names.add(all.get(i).name(i));
+                        star |= all.get(i).star();
+                    }
+                    StringBuilder sb = new StringBuilder(kw("SELECT"));
+                    if (!star && !t.value2().isEmpty()) {
+                        sb.append(S).append(t.value2());
+                    }
+                    sb.append(S).append(String.join("," + S, texts));
+                    if (!f.noFrom()) {
+                        sb.append(S).append(kw("FROM")).append(S).append(f.text());
+                    }
+                    if (!t.value3().isEmpty()) {
+                        sb.append(S).append(kw("WHERE")).append(S).append(t.value3());
+                    }
+                    if (g.grouped()) {
+                        sb.append(S).append(kw("GROUP BY")).append(S).append(String.join(", ", g.groupExprs()));
+                        if (!t.value4().isEmpty()) {
+                            sb.append(S).append(kw("HAVING")).append(S).append(t.value4());
+                        }
+                    }
+                    boolean ordered = false;
+                    boolean total = false;
+                    if (!t.value5().isEmpty()) {
+                        List<String> keys = new ArrayList<>();
+                        for (Key k : t.value5()) {
+                            keys.add(k.text(g, all));
+                        }
+                        if (!g.grouped() && !g.wholeAgg() && !f.noFrom() && !star && t.value6() && !f.hasNatural()) {
+                            // a total order: the row keys last
+                            keys.addAll(f.idKeys());
+                            total = true;
+                        }
+                        sb.append(S).append(kw("ORDER BY")).append(S).append(String.join(", ", keys));
+                        ordered = true;
+                    }
+                    int coin = t.value7().value1();
+                    if (total ? coin >= 50 : (f.noFrom() || g.wholeAgg()) && coin >= 80) {
+                        sb.append(t.value7().value2());
+                    }
+                    // rows are comparable in order only under a total order; otherwise as a multiset
+                    return new Query(sb.toString(), ordered && (total || f.noFrom()), names);
+                });
+            }));
+        }
