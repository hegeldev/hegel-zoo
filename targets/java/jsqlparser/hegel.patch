+            Generator<String> row = Gen.all(cells).map(vs -> "(" + String.join(", ", vs) + ")");
+            return many(row, 1, 3).map(rs -> new Tail(j(kw("VALUES"), String.join("," + S, rs)), true));
+        }
+
+        /** INSERT ... SELECT from one of the tables. */
+        Generator<Tail> selectTail(List<String> cols, int sub) {
+            return INDEX.flatMap(i -> {
+                Table src = at(tables, i);
+                Scope ss = Scope.of(src);
+                List<Generator<String>> items = new ArrayList<>();
+                for (String c : cols) {
+                    items.add(c.equals("id") ? lit("NULL") : expr(ss, 1, sub));
+                }
+                // SQLite wants a WHERE clause between INSERT ... SELECT and an upsert (the ON would read as a join constraint)
+                Generator<String> where = opt(50, condition(ss, 2, sub).map(c -> j(kw("WHERE"), c)));
