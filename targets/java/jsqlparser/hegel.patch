+         */
+        Generator<String> rowValueFirst(Scope sc, int sub) {
+            Generator<String> e = expr(sc, 1, sub);
+            return Zoo.NO_KNOWN ? e.filter(x -> !x.startsWith("(")) : e;
+        }
+
+        /** A first element that begins with a parenthesis: a subquery, a parenthesised expression, or one followed by an operator. */
+        Generator<String> parenthesisedFirst(Scope sc, int sub) {
+            Generator<String> inParens = expr(sc, 1, sub).map(SqlGen::parens);
+            return weighted(w(1, scalarSubquery(sc, sub)), w(1, inParens), w(1, seq(inParens, pick("+", "-", "*"), term(sc, 0, sub))));
+        }
+
+        /** `UPDATE t SET (c0, c1) = (first, e) [WHERE ...]` over a table with two data columns. */
+        Generator<String> rowValueUpdate(Table t, int sub, Generator<String> first) {
+            Scope s = Scope.of(t);
+            return seq(kwd("UPDATE"), id(t.name()), kwd("SET"), rowValueSet(t.dataColumns(), s, sub, first), opt(50, condition(s, 2, sub).map(c -> j(kw("WHERE"), c))));
+        }
+
+        Generator<String> delete(Table t, Scope s, int sub) {
+            return seq(kwd("DELETE FROM"), id(t.name()), opt(75, condition(s, 3, sub).map(c -> j(kw("WHERE"), c))), returning(s, sub));
+        }
+
+        // ----- DDL
+
+        Generator<String> ddl(int sub) {
+            return INDEX.flatMap(i -> {
+                Table t = at(tables, i);
+                return weighted(
+                    w(1, drop(t)),
+                    w(3, alterTable(t)),
+                    w(1, createIndex(t)),
+                    w(1, createView(sub)),
+                    w(3, createTable()),
+                    w(1, seq(kwd("CREATE"), opt(30, kw("TEMP")), kwd("TABLE"), opt(30, kw("IF NOT EXISTS")), lit("n1"), kwd("AS"), query(false, sub).map(Query::sql))));
+            });
+        }
+
+        Generator<String> drop(Table t) {
+            return tuples(pick("TABLE", "TABLE", "VIEW", "INDEX"), chance(50), chance(80), id(t.name()), pick("v1", "i1", "nothere", "\"no where\"")).map(x -> {
+                boolean table = x.value1().equals("TABLE");
+                boolean ifExists = !table || x.value2();
+                // without IF EXISTS only a table that exists can be dropped
+                return j(kw("DROP"), kw(x.value1()), ifExists ? kw("IF EXISTS") : "", table && (x.value3() || !ifExists) ? x.value4() : x.value5());
+            });
+        }
+
+        /** A column constraint: PRIMARY KEY [AUTOINCREMENT] (kind 0, only the first one in the table counts) or its text. */
+        record ColCons(int kind, boolean autoincrement, String text) {
+        }
+
+        /** No subqueries in DEFAULT (must be constant) or CHECK. */
+        Generator<ColCons> colCons(String name) {
+            return weighted(
+                w(1, chance(40).map(a -> new ColCons(0, a, ""))),
+                v(1, new ColCons(1, false, kw("NOT NULL"))),
+                v(1, new ColCons(2, false, kw("UNIQUE"))),
+                w(1, weighted(w(6, LITERAL), w(4, expr(NONE, 2, 0).map(SqlGen::parens))).map(x -> new ColCons(3, false, kw("DEFAULT") + " " + x))),
+                w(1, condition(Scope.bare(List.of(name)), 2, 0).map(c -> new ColCons(4, false, kw("CHECK") + " (" + c + ")"))),
+                w(1, COLLATION.map(c -> new ColCons(5, false, kw("COLLATE") + " " + c))),
+                w(2, tuples(INDEX, ID_STYLE, opt(50, " (id)"),
+                    opt(40, pick(kw("ON DELETE CASCADE"), kw("ON UPDATE SET NULL"), kw("ON DELETE SET DEFAULT"), kw("ON DELETE RESTRICT"), kw("ON UPDATE NO ACTION")).map(a -> " " + a)))
+                    .map(x -> new ColCons(6, false, kw("REFERENCES") + " " + id(at(tables, x.value1()).name(), x.value2()) + x.value3() + x.value4()))));
+        }
+
+        /** A column definition of CREATE TABLE; the type may be absent (SQLite's typeless column). */
+        record ColDef(String name, String type, int idStyle, List<ColCons> constraints) {
+            String decl() {
+                return id(name, idStyle) + (type.isEmpty() ? "" : " " + type);
+            }
+        }
+
+        static final Generator<String> COL_TYPE = pick("INTEGER", "TEXT", "REAL", "INT", "NUMERIC", "VARCHAR(20)", "BLOB", "DOUBLE", "CHAR(3)", "DECIMAL(5,2)");
+        /** A type, or none one time in eight (bug typelessColumnConstraints: JSqlParser rejects a typeless column beside typed ones or with a constraint); always a type under HEGEL_NO_KNOWN. */
+        static final Generator<String> COL_TYPE_OR_NONE = Zoo.NO_KNOWN ? COL_TYPE : weighted(w(7, COL_TYPE), v(1, ""));
+        /** No type (a type under HEGEL_NO_KNOWN). */
+        static final Generator<String> NO_TYPE = Zoo.NO_KNOWN ? COL_TYPE : just("");
+
+        Generator<ColDef> colDef() {
+            return colDef(NEW_COLUMN_NAME, COL_TYPE_OR_NONE, 0);
+        }
+
+        /** A column of the name and type with at least {@code minCons} constraints. */
+        Generator<ColDef> colDef(Generator<String> name, Generator<String> type, int minCons) {
+            return tuples(name, type, ID_STYLE).flatMap(h -> many(colCons(h.value1()), minCons, 2).map(cs -> new ColDef(h.value1(), h.value2(), h.value3(), cs)));
+        }
+
+        /** The first definition, then the others. */
+        static Generator<List<ColDef>> first(Generator<ColDef> first, Generator<List<ColDef>> others) {
+            return tuples(first, others).map(t -> {
+                List<ColDef> out = new ArrayList<>();
+                out.add(t.value1());
+                out.addAll(t.value2());
+                return out;
+            });
+        }
+
+        /** A table constraint: PRIMARY KEY (col) (kind 0, if no column has one), UNIQUE (first n columns), CHECK (check), FOREIGN KEY (col) REFERENCES ref. */
+        record TableCons(int kind, int col, int idStyle, boolean named, int n, String check, int ref, int refStyle, boolean cascade) {
+        }
+
+        Generator<TableCons> tableCons(List<String> colNames) {
+            return tuples(tuples(weighted(v(1, 0), v(1, 1), v(1, 2), v(1, 3)), INDEX, ID_STYLE, chance(30)),
+                tuples(INDEX, condition(Scope.bare(colNames), 2, 0), INDEX, ID_STYLE, chance(40)))
+                .map(x -> new TableCons(x.value1().value1(), x.value1().value2(), x.value1().value3(), x.value1().value4(),
+                    x.value2().value1(), x.value2().value2(), x.value2().value3(), x.value2().value4(), x.value2().value5()));
+        }
+
+        Generator<String> createTable() {
+            return createTable(many(colDef(), 1, 4));
+        }
+
+        /** `CREATE TABLE n (...)` over the column definitions (the first of a repeated name kept) and 0..2 table constraints. */
+        Generator<String> createTable(Generator<List<ColDef>> columns) {
+            return columns.flatMap(drawn -> {
+                List<ColDef> defs = new ArrayList<>();
+                List<String> colNames = new ArrayList<>();
+                for (ColDef d : drawn) {
+                    if (!colNames.contains(d.name())) {
+                        defs.add(d);
+                        colNames.add(d.name());
+                    }
+                }
+                Generator<String> head = seq(kwd("CREATE"), opt(20, pick(kw("TEMP"), kw("TEMPORARY"))), kwd("TABLE"), opt(30, kw("IF NOT EXISTS")), pick("n1", "\"new table\"", "n2"));
+                return tuples(head, many(tableCons(colNames), 0, 2)).map(x -> {
+                    List<String> out = new ArrayList<>();
+                    boolean pkDone = false;
+                    for (ColDef d : defs) {
+                        StringBuilder sb = new StringBuilder(d.decl());
+                        for (ColCons c : d.constraints()) {
+                            if (c.kind() == 0) {
+                                if (!pkDone) {
+                                    sb.append(" ").append(kw("PRIMARY KEY"));
+                                    if (d.type().equals("INTEGER") && c.autoincrement()) {
+                                        sb.append(" ").append(kw("AUTOINCREMENT"));
+                                    }
+                                    pkDone = true;
+                                }
+                            } else {
+                                sb.append(" ").append(c.text());
+                            }
+                        }
+                        out.add(sb.toString());
+                    }
+                    for (int k = 0; k < x.value2().size(); k++) {
+                        TableCons c = x.value2().get(k);
+                        String col = id(at(colNames, c.col()), c.idStyle());
+                        String named = c.named() ? kw("CONSTRAINT") + " k" + k + " " : "";
+                        switch (c.kind()) {
+                            case 0 -> {
+                                if (!pkDone) {
+                                    out.add(named + kw("PRIMARY KEY") + " (" + col + ")");
+                                    pkDone = true;
+                                }
+                            }
+                            case 1 -> {
+                                List<String> some = new ArrayList<>();
+                                for (String nm : colNames.subList(0, 1 + Math.floorMod(c.n(), colNames.size()))) {
+                                    some.add(id(nm, c.idStyle()));
+                                }
+                                out.add(named + kw("UNIQUE") + " (" + String.join(", ", some) + ")");
+                            }
+                            case 2 -> out.add(named + kw("CHECK") + " (" + c.check() + ")");
+                            default -> out.add(named + kw("FOREIGN KEY") + " (" + col + ") " + kw("REFERENCES") + " " + id(at(tables, c.ref()).name(), c.refStyle()) + " (id)"
+                                + (c.cascade() ? " " + kw("ON DELETE CASCADE") : ""));
+                        }
+                    }
+                    return j(x.value1(), "(" + String.join("," + S, out) + ")");
+                });
+            });
+        }
+
+        /** No subqueries in index expressions or a partial index's WHERE. */
+        Generator<String> createIndex(Table t) {
+            List<String> names = t.names();
+            Generator<String> indexed = tuples(INDEX, ID_STYLE, maybe(20, -1, ints(0, 4)), opt(30, COLLATION.map(c -> j(kw("COLLATE"), c))), opt(40, pick(kw("ASC"), kw("DESC"))))
+                .map(x -> {
+                    String col = id(at(names, x.value1()), x.value2());
+                    String c = switch (x.value3()) {
+                        case 0 -> "(" + col + " + 1)";
+                        case 1 -> "(" + col + " * 2)";
+                        case 2 -> "(abs(" + col + "))";
+                        case 3 -> "(lower(" + col + "))";
+                        case 4 -> "(" + col + " % 3)";
+                        default -> col;
+                    };
+                    return j(c, x.value4(), x.value5());
+                });
+            return seq(kwd("CREATE"), opt(30, kw("UNIQUE")), kwd("INDEX"), opt(30, kw("IF NOT EXISTS")), lit("i1"), kwd("ON"), id(t.name()),
+                many(indexed, 1, 2).map(cols -> "(" + String.join(", ", cols) + ")"),
+                opt(40, condition(Scope.bare(names), 2, 0).map(c -> j(kw("WHERE"), deterministic(c)))));
+        }
+
+        /** A partial index's WHERE may not use non-deterministic functions: CURRENT_DATE becomes a date literal. */
+        static String deterministic(String condition) {
+            return condition.replace("CURRENT_DATE", "'2020-01-02'");
+        }
+
+        Generator<String> createView(int sub) {
+            Generator<String> body = tuples(plainSelect(null, sub), chance(30)).map(x -> {
+                Query q = x.value1();
+                String cols = "";
+                if (x.value2() && !q.columns().isEmpty() && !q.columns().contains("*")) {
+                    List<String> names = new ArrayList<>();
+                    for (int i = 0; i < q.columns().size(); i++) {
+                        names.add("v" + i);
+                    }
+                    cols = " (" + String.join(", ", names) + ")";
+                }
+                return j("v1" + cols, kw("AS"), q.sql());
+            });
+            return seq(kwd("CREATE"), opt(20, kw("TEMP")), kwd("VIEW"), opt(30, kw("IF NOT EXISTS")), body);
+        }
+
+        Generator<String> alterTable(Table t) {
+            List<String> cols = t.names();
+            Generator<String> head = id(t.name()).map(n -> j(kw("ALTER TABLE"), n));
+            Generator<String> add = seq(lit("z"), pick("INTEGER", "TEXT", "REAL", "", "NUMERIC"), opt(50, LITERAL.map(l -> j(kw("DEFAULT"), l))),
+                opt(30, condition(Scope.bare(List.of("z")), 1, 0).map(c -> j(kw("CHECK"), parens(c)))), opt(20, kw("COLLATE NOCASE")));
+            Generator<String> dropColumn = cols.size() < 2 ? seq(kwd("RENAME TO"), lit("n1"))
