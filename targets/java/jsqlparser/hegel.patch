+    static final String[] TEXTS = {"'a'", "'b'", "'ab'", "'it''s'", "''", "'x y'", "'Ä'", "'%'", "'_'", "'one'", "'two'", "'A'", "'\\'", "'--'", "'/*'", "';'"};
