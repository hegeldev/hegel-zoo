+        /** `(c0, c1) = (first, e)`: a row value over the first two data columns. */
+        Generator<String> rowValueSet(List<String> data, Scope sc, int sub, Generator<String> first) {
+            return tuples(first, expr(sc, 1, sub), ID_STYLE, ID_STYLE)
+                .map(x -> "(" + id(data.get(0), x.value3()) + ", " + id(data.get(1), x.value4()) + ") = (" + x.value1() + ", " + x.value2() + ")");
+        }
+
+        /**
+         * The first element of a row value: any expression - one starting with `(` is bug rowValueSetStartsWithSubquery's
