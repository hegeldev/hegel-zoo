+        /** ON CONFLICT DO NOTHING / DO UPDATE SET, 40% of the time. */
+        Generator<String> upsert(List<String> data, Scope s, int sub) {
+            Generator<String> nothing = opt(50, "(id)").map(c -> j(kw("ON CONFLICT"), c, kw("DO NOTHING")));
+            if (data.isEmpty()) {
+                return maybe(40, "", nothing);
+            }
+            Generator<String> update = tuples(INDEX, ID_STYLE, chance(50), expr(s, 1, sub), opt(30, condition(s, 1, sub).map(c -> j(kw("WHERE"), c)))).map(x -> {
+                String c = at(data, x.value1());
+                return j(kw("ON CONFLICT"), "(id)", kw("DO UPDATE SET"), id(c, x.value2()), "=", x.value3() ? "excluded." + id(c, x.value2()) : x.value4(), x.value5());
+            });
+            return maybe(40, "", weighted(w(1, nothing), w(1, update)));
+        }
