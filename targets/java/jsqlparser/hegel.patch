+                w(1, seq(kwd("RENAME TO"), pick("n1", "\"new table\""))),
+                w(1, seq(kwd("RENAME"), opt(50, kw("COLUMN")), tuples(INDEX, ID_STYLE).map(x -> id(at(cols, x.value1()), x.value2())), kwd("TO"), pick("z", "\"z z\""))),
+                w(1, seq(kwd("ADD"), opt(50, kw("COLUMN")), add)),
+                w(2, dropColumn)));
+        }
+
+        // ----- programs
+
+        record Stmt(String sql, Kind kind, boolean ordered) {
+        }
+
+        /** A statement of the kind, its trivia rendered. */
+        Generator<Program> program(Generator<Kind> kindGen) {
+            int sub = 2;
+            return finish(kindGen.flatMap(kind -> switch (kind) {
+                case SELECT -> query(true, sub).map(q -> new Stmt(q.sql(), Kind.SELECT, q.ordered()));
+                case DML -> dml(sub).map(sql -> new Stmt(sql, Kind.DML, false));
+                case DDL -> ddl(sub).map(sql -> new Stmt(sql, Kind.DDL, false));
+            }));
+        }
+
+        /** The statement with its trivia rendered; under trivia a trailing `;` (20%) and leading white space (10%). */
+        Generator<Program> finish(Generator<Stmt> stmt) {
+            return tuples(TRIVIA, stmt, chance(20), chance(10)).map(t -> {
+                Trivia trivia = t.value1();
+                boolean isPlain = trivia.equals(Trivia.PLAIN);
+                String marked = t.value2().sql();
+                if (!isPlain && t.value3()) {
+                    // SQLite stores ALTER TABLE ... ADD's column text verbatim; a trailing line comment gives "incomplete input"
+                    marked = marked + (plain(marked).regionMatches(true, 0, "ALTER", 0, 5) ? "" : S) + ";";
+                }
+                if (!isPlain && t.value4()) {
+                    marked = S + marked;
+                }
+                // a "/" alone on a line is a statement terminator for JSqlParser (SQL*Plus style): keep the divisor on its line
+                String sql = trivia.render(marked).replaceAll("([\\r\\n])[ \\t]*/[ \\t]*\\r?\\n", "$1/ ");
+                return new Program(sql, t.value2().kind(), schema, t.value2().ordered());
+            });
+        }
+    }
+
+    // ----- the recorded bugs' shapes
+
+    /** A program over a drawn schema whose statement the function builds from the schema's context. */
+    static Generator<Program> shaped(Kind kind, Function<Ctx, Generator<String>> statement) {
+        return shaped(SCHEMA, kind, statement);
+    }
+
+    static Generator<Program> shaped(Generator<Schema> schema, Kind kind, Function<Ctx, Generator<String>> statement) {
+        return schema.flatMap(sch -> {
+            Ctx c = new Ctx(sch);
+            return c.finish(statement.apply(c).map(sql -> new Ctx.Stmt(sql, kind, false)));
+        });
+    }
+
+    /** `SELECT item FROM t0`, the item built over t0's scope. */
+    static Generator<Program> selectItem(BiFunction<Ctx, Scope, Generator<String>> item) {
+        return shaped(Kind.SELECT, c -> seq(kwd("SELECT"), item.apply(c, Scope.of(c.tables.get(0))), kwd("FROM"), id("t0")));
+    }
+
+    /** The schema with one more column on t0 (NULL in every row), unless t0 has the name already. */
+    static Schema withColumn(Schema schema, Column c) {
+        List<Table> tables = new ArrayList<>(schema.tables());
+        Table t = tables.get(0);
+        if (t.names().contains(c.name())) {
+            return schema;
+        }
+        List<Column> cols = new ArrayList<>(t.columns());
+        cols.add(c);
+        List<List<String>> rows = new ArrayList<>();
+        for (List<String> r : t.rows()) {
+            List<String> row = new ArrayList<>(r);
+            row.add("NULL");
+            rows.add(row);
+        }
+        tables.set(0, new Table(t.name(), cols, rows));
+        return new Schema(tables);
+    }
+
+    /** The schema with at least two data columns on t0. */
+    static Schema withTwoDataColumns(Schema schema) {
+        Schema out = schema;
+        for (int i = 0; out.tables().get(0).dataColumns().size() < 2; i++) {
+            out = withColumn(out, new Column("extra" + i, "INTEGER"));
+        }
+        return out;
+    }
+
+    /**
+     * The regions of the recorded bugs (bugs.toml), each drawn with random contents; the narrow properties draw
+     * them. Under HEGEL_NO_KNOWN each region is drawn in the spelling JSqlParser takes, or without the shape.
+     */
+    static final class Shapes {
+        private Shapes() {}
+
+        /** bug stackedUnaryOperators: a sign on a signed expression. */
+        static final Generator<Program> STACKED_UNARY = selectItem((c, s) -> c.stackedUnary(s, 2, 1));
+        /** bug predicateIsTrue: a predicate tested with IS [NOT] TRUE/FALSE. */
+        static final Generator<Program> PREDICATE_IS_BOOLEAN = selectItem((c, s) -> c.predicateIsBoolean(s, 2, 1));
+        /** bug collateKeywordNames: COLLATE BINARY / RTRIM. */
+        static final Generator<Program> COLLATE_KEYWORD_NAME = selectItem((c, s) -> Ctx.collate(c.term(s, 1, 1), KEYWORD_COLLATION));
+        /** bug excludeColumn: a CREATE TABLE whose first column is named exclude. */
+        static final Generator<Program> EXCLUDE_COLUMN = shaped(Kind.DDL, c -> c.createTable(Ctx.first(c.colDef(just("exclude"), Ctx.COL_TYPE, 0), many(c.colDef(), 0, 3))));
+        /** A quoted name holding a dot (a plain quoted name under HEGEL_NO_KNOWN). */
+        static final Generator<String> DOTTED = Zoo.NO_KNOWN ? pick("a_b", "x_", "y0") : pick("a.b", "x.", ".y", "a.b.c");
+        /** bug quotedIdentifierWithDot: a select of a dotted quoted column of t0, bare or qualified, aliased or not. */
+        static final Generator<Program> DOTTED_NAME = tuples(SCHEMA, DOTTED, TYPE).flatMap(t -> {
+            String name = t.value2();
+            Schema schema = withColumn(t.value1(), new Column(name, t.value3()));
+            return shaped(just(schema), Kind.SELECT, c -> seq(kwd("SELECT"), opt(30, "t0.").map(q -> q + ident(name)), opt(40, kw("AS") + S + "r0"), kwd("FROM"), id("t0"),
+                opt(40, seq(kwd("WHERE"), lit(ident(name)), kwd("IS"), Ctx.NOT40, kwd("NULL")))));
+        });
+        /** bug hexLiteralTrailingSpace: a hex literal followed by white space. */
+        static final Generator<String> HEX_LITERAL = tuples(pick("X", "x"), word("0123456789ABCDEFabcdef", 0, 4)).map(t -> t.value1() + "'" + t.value2() + t.value2() + "'");
+        static final Generator<Program> HEX_LITERAL_ITEM = selectItem((c, s) -> seq(HEX_LITERAL, opt(40, kw("AS") + S + "r0")));
+        /** bug replaceLikeInsert: REPLACE / INSERT OR REPLACE with DEFAULT VALUES or RETURNING. */
+        static final Generator<Program> REPLACE_WITH_TAIL = shaped(Kind.DML, c -> {
+            Table t = c.tables.get(0);
+            Scope s = Scope.of(t);
+            return c.insert(t, s, 1, Ctx.REPLACE_HEAD, weighted(v(3, 0), w(7, ints(1, 9))), c.returningClause(s, 1));
+        });
+        /** bug rowValueSetStartsWithSubquery: a row-value SET whose first element begins with `(`. */
+        static final Generator<Program> ROW_VALUE_SET = shaped(SCHEMA.map(SqlGen::withTwoDataColumns), Kind.DML, c -> {
+            Table t = c.tables.get(0);
+            return c.rowValueUpdate(t, 1, Zoo.NO_KNOWN ? c.rowValueFirst(Scope.of(t), 1) : c.parenthesisedFirst(Scope.of(t), 1));
+        });
+        /** bug caseSignedOperand: a simple CASE on a signed operand. */
+        static final Generator<Program> CASE_SIGNED_OPERAND = selectItem((c, s) -> c.simpleCase(s, 2, 1, c.unarySigned(s, 1, 1)));
+        /** bug castCondition: CAST of a condition. */
+        static final Generator<Program> CAST_CONDITION = selectItem((c, s) -> Ctx.cast(c.condition(s, 2, 1)));
+        /** bug typelessColumnConstraints: a typeless column, with constraints or beside typed ones. */
+        static final Generator<Program> TYPELESS_COLUMN = shaped(Kind.DDL, c -> c.createTable(weighted(
+            w(1, Ctx.first(c.colDef(NEW_COLUMN_NAME, Ctx.NO_TYPE, 1), many(c.colDef(NEW_COLUMN_NAME, Ctx.NO_TYPE, 0), 0, 2))),
+            w(1, Ctx.first(c.colDef(NEW_COLUMN_NAME, Ctx.NO_TYPE, 0), many(c.colDef(NEW_COLUMN_NAME, Ctx.COL_TYPE, 0), 1, 3))))));
+        /** bug collateAfterIsNull: COLLATE after IS [NOT] NULL/TRUE/FALSE. */
+        static final Generator<Program> COLLATE_AFTER_IS_NULL = selectItem((c, s) -> Ctx.collate(c.isNull(s, 2, 1), COLLATION));
+        /** bug likeEscapeCollate: COLLATE after a LIKE's ESCAPE literal. */
+        static final Generator<Program> LIKE_ESCAPE_COLLATE = selectItem((c, s) -> Ctx.collate(c.likeEscape(s, 2, 1), COLLATION));
+        /** bug substrPredicateArgument: a predicate as the first argument of substr / substring. */
+        static final Generator<Program> SUBSTR_PREDICATE = selectItem((c, s) -> Ctx.substr(c.predicate(s, 2, 1)));
+    }
+}
