+        Generator<Query> compound(int sub) {
+            return ints(1, 2).flatMap(width -> {
+                Generator<String> member = tuples(INDEX, opt(20, kw("DISTINCT"))).flatMap(h -> {
+                    Table t = at(tables, h.value1());
+                    Scope s = Scope.of(t);
+                    return tuples(many(expr(s, 1, sub), width, width), id(t.name()), opt(40, condition(s, 1, sub).map(c -> j(kw("WHERE"), c))))
+                        .map(b -> j(kw("SELECT"), h.value2(), String.join(", ", b.value1()), kw("FROM"), b.value2(), b.value3()));
+                });
+                Generator<String> body = chain(member, pick(kw("UNION"), kw("UNION ALL"), kw("INTERSECT"), kw("EXCEPT")), member, 1, 2);
+                Generator<List<Boolean>> order = maybe(50, List.<Boolean>of(), many(chance(40), width, width));
+                return tuples(body, order).map(t -> {
+                    if (t.value2().isEmpty()) {
+                        return new Query(t.value1(), false, List.of());
+                    }
+                    List<String> keys = new ArrayList<>();
+                    for (int i = 0; i < width; i++) {
+                        keys.add((i + 1) + (t.value2().get(i) ? " " + kw("DESC") : ""));
+                    }
+                    return new Query(t.value1() + S + kw("ORDER BY") + S + String.join(", ", keys), true, List.of());
+                });
+            });
+        }
