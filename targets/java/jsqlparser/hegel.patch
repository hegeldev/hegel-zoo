+        /** 1..3 rows of VALUES for the columns. */
+        Generator<Tail> valuesTail(List<String> cols, int sub) {
+            List<Generator<String>> cells = new ArrayList<>();
+            for (String c : cols) {
+                cells.add(c.equals("id") ? weighted(w(7, ints(1, 20).map(String::valueOf)), v(3, "NULL")) : weighted(w(6, LITERAL), w(4, expr(NONE, 2, sub))));
