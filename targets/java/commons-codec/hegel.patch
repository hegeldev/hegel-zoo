+            Zoo.check(Arrays.equals(MurmurHash3.hash128x64(window), murmur3x64(window, 0, len, 0)), () -> "hash128x64(" + show(window) + ") with the default seed 0 disagrees with the reference");
+            // hash128(byte[]) is documented as the default seed 104729 without the sign bug (the seed is positive)
+            Zoo.check(Arrays.equals(MurmurHash3.hash128(window), murmur3x64(window, 0, len, 104729)), () -> "hash128(" + show(window) + ") disagrees with the reference at seed 104729");
