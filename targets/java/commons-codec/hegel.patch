+    @Test
+    void apr1AndSaltRulesFollowTheDocuments() {
+        // fixed vector from openssl passwd -apr1
+        assertEquals("$apr1$xxxxxxxx$/mULyOsdWlXlIt5U99q7h1", Md5Crypt.apr1Crypt("secret", "$apr1$xxxxxxxx"));
+        assertEquals("$1$xxxx$aMkevjfEIpa35Bh3G4bAc.", Crypt.crypt("secret", "$1$xxxx"));
+        Hegel.test(tc -> {
+            String password = password(tc);
+            String salt = saltChars(tc, 1, 8);
+            String got = Md5Crypt.apr1Crypt(password, "$apr1$" + salt);
+            Zoo.check(got.startsWith("$apr1$" + salt + "$") && got.length() == 6 + salt.length() + 1 + 22, () -> "apr1Crypt(" + show(password) + ", $apr1$" + salt + ") = " + show(got));
+            Zoo.check(Md5Crypt.apr1Crypt(password, got).equals(got), () -> "apr1Crypt does not verify its own hash " + got + " for " + show(password));
+            // the same salt without the prefix is accepted by md5Crypt with the apr1 prefix
+            Zoo.check(Md5Crypt.md5Crypt(password.getBytes(StandardCharsets.UTF_8), "$apr1$" + salt, "$apr1$").equals(got), () -> "md5Crypt(prefix $apr1$) differs from apr1Crypt for " + show(password) + ", " + salt);
+            // rounds below 1000 are clamped to 1000 (Drepper's reference behaviour, which the class follows; the upper
+            // bound of 999,999,999 rounds is too slow to exercise)
+            int rounds = Zoo.pick(tc, 0, 1, 999, 1000, 1500);
+            String spec = "$5$rounds=" + rounds + "$" + saltChars(tc, 1, 16);
+            String sha = Crypt.crypt(password, spec);
+            int clamped = Math.max(1000, Math.min(999_999_999, rounds));
+            Zoo.check(sha.startsWith("$5$rounds=" + clamped + "$"), () -> "crypt(" + show(password) + ", " + spec + ") = " + sha + ": expected rounds clamped to " + clamped);
+            // invalid salts are rejected with IllegalArgumentException
+            String bad = Zoo.pick(tc, "$1$", "$5$", "$6$", "$2a$abcd", "$apr1$abcd", "x", "", "$1$" + "!!", "$7$abc", "ab cd".substring(0, 2) + "!", "$6$rounds=abc$xyz");
+            try {
+                String r = Crypt.crypt(password, bad);
+                if (bad.equals("$6$rounds=abc$xyz")) {
+                    // known commons-codec/5: a malformed rounds= is hashed with the salt "rounds"
+                    Zoo.count("known commons-codec/5");
+                    return;
+                }
+                Zoo.count("bad-salt-accepted " + bad);
+                if (bad.equals("$2a$abcd") || bad.equals("$apr1$abcd") || bad.equals("x") || bad.equals("") || bad.equals("ab!") || bad.equals("$7$abc")) {
+                    Zoo.fail("crypt(" + show(password) + ", " + show(bad) + ") = " + r + " instead of rejecting the salt");
+                }
+            } catch (IllegalArgumentException e) {
+                Zoo.count("bad-salt-rejected");
+            }
+        }, Zoo.settings("apr1AndSaltRulesFollowTheDocuments"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS apr1AndSaltRulesFollowTheDocuments " + Zoo.stats());
+        }
+    }
