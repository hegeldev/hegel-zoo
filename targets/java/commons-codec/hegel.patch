+    // ---------------------------------------------------------------- crypt(3)
+
+    /** libc's crypt through Python, one line per request: hex(salt) hex(password) -> hex(result) or "-". */
+    static final class LibcCrypt {
+        final Process proc;
+        final Writer in;
+        final BufferedReader out;
+
+        private LibcCrypt(Process proc) {
+            this.proc = proc;
+            this.in = new OutputStreamWriter(proc.getOutputStream(), StandardCharsets.US_ASCII);
+            this.out = new BufferedReader(new InputStreamReader(proc.getInputStream(), StandardCharsets.US_ASCII));
+        }
+
+        static LibcCrypt start() {
+            String script = "import sys, crypt, binascii\n"
+                + "for line in sys.stdin:\n"
+                + "    try:\n"
+                + "        parts = line.split()\n"
+                + "        s = parts[0]\n"
+                + "        p = parts[1] if len(parts) > 1 else ''\n"
+                + "        r = crypt.crypt(bytes.fromhex(p).decode('utf-8'), bytes.fromhex(s).decode('ascii'))\n"
+                + "        sys.stdout.write(binascii.hexlify((r or '').encode()).decode() + '\\n')\n"
+                + "    except Exception:\n"
+                + "        sys.stdout.write('-\\n')\n"
+                + "    sys.stdout.flush()\n";
+            try {
+                Process p = new ProcessBuilder("python3", "-W", "ignore", "-c", script).redirectErrorStream(false).start();
+                LibcCrypt c = new LibcCrypt(p);
+                String probe = c.crypt("xx", "secret");
+                if (!"xxWAum7tHdIUw".equals(probe)) {
+                    p.destroy();
+                    return null;
+                }
+                return c;
+            } catch (Exception e) {
+                return null;
+            }
+        }
+
+        /** The libc result, or null when libc refuses (it returns "*0" or errors). */
+        synchronized String crypt(String salt, String password) throws Exception {
+            in.write(hex(salt.getBytes(StandardCharsets.US_ASCII)) + " " + hex(password.getBytes(StandardCharsets.UTF_8)) + "\n");
+            in.flush();
+            String line = out.readLine();
+            if (line == null || line.equals("-") || line.isEmpty()) {
+                return null;
+            }
+            String r = new String(Hex.decodeHex(line), StandardCharsets.UTF_8);
+            return r.startsWith("*") || r.isEmpty() ? null : r;
+        }
+
+        void stop() {
+            proc.destroy();
+        }
+    }
+
+    static String saltChars(TestCase tc, int lo, int hi) {
+        return Zoo.word(tc, B64T, lo, hi);
+    }
+
+    static String password(TestCase tc) {
+        if (Zoo.chance(tc, 15)) {
+            // some non-ASCII: the key is its UTF-8 bytes
+            return Zoo.word(tc, PRINTABLE, 0, 6) + Zoo.pick(tc, "\u00e9", "\u00df", "\u65e5\u672c", "\ud83d\ude00", "\u0416") + Zoo.word(tc, PRINTABLE, 0, 6);
+        }
+        return Zoo.word(tc, PRINTABLE, 0, Zoo.chance(tc, 50) ? 8 : 24);
+    }
+
+    @Test
+    void cryptMatchesLibcAndItsDocumentedFormat() {
+        LibcCrypt libc = LibcCrypt.start();
+        if (libc == null) {
+            Zoo.count("no-libc-oracle");
+        }
+        try {
+            Hegel.test(tc -> {
+                String algo = Zoo.pick(tc, "des", "md5", "sha256", "sha512");
+                String password = password(tc);
+                // the salt specification handed to crypt: the documented forms plus their documented edge cases
+                String spec;
+                String saltUsed; // what the salt should be cut to
+                int expectLength;
+                String prefix;
+                switch (algo) {
+                    case "des": {
+                        // only the first two salt characters are used
+                        String raw = saltChars(tc, 2, Zoo.chance(tc, 30) ? 5 : 2);
+                        saltUsed = raw.substring(0, 2);
+                        spec = raw;
+                        expectLength = 13;
+                        prefix = "";
+                        break;
+                    }
+                    case "md5": {
+                        // the salt is cut at 8 characters or at a "$"
+                        String raw = saltChars(tc, 1, Zoo.chance(tc, 30) ? 12 : 8);
+                        saltUsed = raw.substring(0, Math.min(8, raw.length()));
+                        spec = "$1$" + raw + (Zoo.chance(tc, 25) ? "$" + saltChars(tc, 0, 22) : "");
+                        expectLength = 3 + saltUsed.length() + 1 + 22;
+                        prefix = "$1$";
+                        break;
+                    }
+                    default: {
+                        boolean sha512 = algo.equals("sha512");
+                        prefix = sha512 ? "$6$" : "$5$";
+                        String rounds = "";
+                        if (Zoo.chance(tc, 35)) {
+                            rounds = "rounds=" + Zoo.pick(tc, 1000, 1001, 1234, 4999, 5000, 5001, 20000) + "$";
+                        }
+                        // the salt is cut at 16 characters or at a "$"
+                        String raw = saltChars(tc, 1, Zoo.chance(tc, 30) ? 20 : 16);
+                        saltUsed = raw.substring(0, Math.min(16, raw.length()));
+                        String tail = Zoo.chance(tc, 25) ? "$" + saltChars(tc, 0, 40) : "";
+                        spec = prefix + rounds + raw + tail;
+                        expectLength = -1; // checked below from the parts
+                        break;
+                    }
+                }
+                String got;
+                try {
+                    got = Crypt.crypt(password, spec);
+                } catch (RuntimeException e) {
+                    Zoo.fail(algo + " crypt(" + show(password) + ", " + show(spec) + ") threw " + e);
+                    return;
+                }
+                Zoo.count(algo);
+                // documented format
+                Zoo.check(got.startsWith(prefix), () -> algo + " crypt(" + show(password) + ", " + show(spec) + ") = " + show(got) + " lacks the prefix " + prefix);
+                if (algo.equals("des")) {
+                    Zoo.check(got.length() == 13 && got.startsWith(saltUsed), () -> "DES crypt(" + show(password) + ", " + show(spec) + ") = " + show(got) + ": expected 13 chars starting with the salt " + saltUsed);
+                    // only the first 8 password chars are used (bytes, for ASCII passwords)
+                    if (password.length() >= 8 && password.chars().allMatch(c -> c < 128)) {
+                        String longer = Crypt.crypt(password + Zoo.word(tc, PRINTABLE, 1, 5), spec);
+                        Zoo.check(longer.equals(got), () -> "DES crypt uses more than 8 password chars: " + show(password) + " -> " + got + " but with a suffix -> " + longer);
+                    }
+                    Zoo.check(UnixCrypt.crypt(password, spec).equals(got), () -> "UnixCrypt.crypt(" + show(password) + ", " + show(spec) + ") = " + UnixCrypt.crypt(password, spec) + " but Crypt.crypt = " + got);
+                } else if (algo.equals("md5")) {
+                    Zoo.check(got.length() == expectLength && got.startsWith("$1$" + saltUsed + "$"), () -> "MD5 crypt(" + show(password) + ", " + show(spec) + ") = " + show(got) + ": expected $1$" + saltUsed + "$ and 22 hash chars");
+                    Zoo.check(Md5Crypt.md5Crypt(password.getBytes(StandardCharsets.UTF_8), spec).equals(got), () -> "Md5Crypt.md5Crypt disagrees with Crypt.crypt for " + show(password) + ", " + show(spec));
+                } else {
+                    String rest = got.substring(3);
+                    String roundsOut = "";
+                    if (rest.startsWith("rounds=")) {
+                        roundsOut = rest.substring(0, rest.indexOf('$') + 1);
+                        rest = rest.substring(roundsOut.length());
+                    }
+                    int hashLen = algo.equals("sha512") ? 86 : 43;
+                    String expectSalt = saltUsed;
+                    Zoo.check(rest.equals(expectSalt + "$" + rest.substring(rest.indexOf('$') + 1)) && rest.length() == expectSalt.length() + 1 + hashLen,
+                        () -> algo + " crypt(" + show(password) + ", " + show(spec) + ") = " + show(got) + ": expected the salt " + expectSalt + ", $ and " + hashLen + " hash chars");
+                    if (spec.contains("rounds=")) {
+                        String r = spec.substring(spec.indexOf("rounds="), spec.indexOf('$', 3) + 1);
+                        Zoo.check(roundsOut.equals(r), () -> algo + " crypt(" + show(password) + ", " + show(spec) + ") = " + show(got) + ": expected " + r + " in the output");
+                    } else {
+                        Zoo.check(roundsOut.isEmpty(), () -> algo + " crypt(" + show(password) + ", " + show(spec) + ") = " + show(got) + ": rounds were not requested");
+                    }
+                    String direct = algo.equals("sha512") ? Sha2Crypt.sha512Crypt(password.getBytes(StandardCharsets.UTF_8), spec) : Sha2Crypt.sha256Crypt(password.getBytes(StandardCharsets.UTF_8), spec);
+                    Zoo.check(direct.equals(got), () -> "Sha2Crypt disagrees with Crypt.crypt for " + show(password) + ", " + show(spec) + ": " + direct + " vs " + got);
+                }
+                // verification: a stored hash works as the salt and reproduces itself
+                String again = Crypt.crypt(password, got);
+                Zoo.check(again.equals(got), () -> algo + " crypt(" + show(password) + ", <its own hash " + got + ">) = " + again);
+                // a different password (almost surely) gives a different hash; traditional DES
+                // crypt uses only the first 8 bytes of the key, so only a change within them counts
+                String other = password + "x";
+                if (!algo.equals("des") || password.getBytes(StandardCharsets.UTF_8).length < 8) {
+                    String otherHash = Crypt.crypt(other, got);
+                    Zoo.check(!otherHash.equals(got), () -> algo + " crypt gives the same hash for " + show(password) + " and " + show(other) + ": " + got);
+                }
+                // the key bytes are zeroed by the byte[] entry points (documented)
+                if (!algo.equals("des")) {
+                    byte[] key = password.getBytes(StandardCharsets.UTF_8);
+                    Crypt.crypt(key, spec);
+                    boolean zero = true;
+                    for (byte b : key) {
+                        zero &= b == 0;
+                    }
+                    Zoo.check(zero, () -> algo + " crypt(byte[], salt) did not zero the key array for " + show(password));
+                }
+                // libc
+                if (libc != null) {
+                    String want;
+                    try {
+                        want = libc.crypt(spec, password);
+                    } catch (Exception e) {
+                        throw new RuntimeException(e);
+                    }
+                    if (want == null) {
+                        Zoo.count("libc-refused-" + algo);
+                    } else {
+                        Zoo.count("libc-checked-" + algo);
+                        Zoo.check(want.equals(got), () -> algo + " crypt(" + show(password) + ", " + show(spec) + ") = " + got + " but libc gives " + want);
+                    }
+                }
+            }, Zoo.settings("cryptMatchesLibcAndItsDocumentedFormat"));
+        } finally {
+            if (libc != null) {
+                libc.stop();
+            }
+        }
+        if (Zoo.COLLECT) {
+            System.out.println("STATS cryptMatchesLibcAndItsDocumentedFormat " + Zoo.stats());
+        }
+    }
