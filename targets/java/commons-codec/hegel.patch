+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.count;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.word;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Locale;
+import org.apache.commons.codec.CodecPolicy;
+import org.apache.commons.codec.DecoderException;
+import org.apache.commons.codec.binary.Base16;
+import org.apache.commons.codec.binary.Base16InputStream;
+import org.apache.commons.codec.binary.Base16OutputStream;
+import org.apache.commons.codec.binary.Base32;
+import org.apache.commons.codec.binary.Base32InputStream;
+import org.apache.commons.codec.binary.Base32OutputStream;
+import org.apache.commons.codec.binary.Base45;
+import org.apache.commons.codec.binary.Base45InputStream;
+import org.apache.commons.codec.binary.Base45OutputStream;
+import org.apache.commons.codec.binary.Base58;
+import org.apache.commons.codec.binary.Base58InputStream;
+import org.apache.commons.codec.binary.Base58OutputStream;
+import org.apache.commons.codec.binary.Base64;
+import org.apache.commons.codec.binary.Base64InputStream;
+import org.apache.commons.codec.binary.Base64OutputStream;
+import org.apache.commons.codec.binary.BaseNCodec;
+import org.apache.commons.codec.binary.BinaryCodec;
+import org.apache.commons.codec.binary.Hex;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: the binary-to-text codecs of Apache Commons Codec against bit-level models of RFC 4648
+ * (Base64, Base32, base32hex, Base16), RFC 9285 (Base45) and the Base58 draft, against
+ * {@code java.util.Base64}, and against themselves (streams vs one-shot, strict vs lenient decoding).
+ */
+class BinaryTest {
+
+    static final String B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    static final String B64URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+    static final String B32 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
+    static final String B32HEX = "0123456789ABCDEFGHIJKLMNOPQRSTUV";
+    static final String B16 = "0123456789ABCDEF";
+    static final String B45 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:";
+    static final String B58 = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
+
+    // ------------------------------------------------------------------ generators
+
+    /** Random bytes with a bias to the interesting values. */
+    static byte[] bytes(TestCase tc, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        byte[] b = new byte[len];
+        for (int i = 0; i < len; i++) {
+            b[i] = (byte) (chance(tc, 30) ? (int) pick(tc, 0, 0xff, 0x80, 0x7f, 1, 0xfe) : n(tc, 0, 255));
+        }
+        return b;
+    }
+
+    static String show(Object o) {
+        return Zoo.show(o);
+    }
+
+    /** Bytes as hex, for messages (Zoo.show prints arrays by identity). */
+    static String show(byte[] b) {
+        return b == null ? "null" : b.length + " bytes " + hex(b, true);
+    }
+
+    static String ascii(byte[] b) {
+        return new String(b, StandardCharsets.US_ASCII);
+    }
+
+    static byte[] ascii(String s) {
+        return s.getBytes(StandardCharsets.US_ASCII);
+    }
+
+    // ------------------------------------------------------------------ models
+
+    /** RFC 4648 base-2^bits encoding: bits taken MSB first, the final quantum padded to a block of lcm(8, bits) bits. */
+    static String rfc4648(byte[] data, String alphabet, int bits, boolean pad, char padChar) {
+        StringBuilder sb = new StringBuilder();
+        int acc = 0;
+        int nbits = 0;
+        for (byte x : data) {
+            acc = (acc << 8) | (x & 0xff);
+            nbits += 8;
+            while (nbits >= bits) {
+                sb.append(alphabet.charAt((acc >> (nbits - bits)) & ((1 << bits) - 1)));
+                nbits -= bits;
+                acc &= (1 << nbits) - 1;
+            }
+        }
+        if (nbits > 0) {
+            sb.append(alphabet.charAt((acc << (bits - nbits)) & ((1 << bits) - 1)));
+        }
+        int block = lcm(8, bits) / bits;
+        if (pad) {
+            while (sb.length() % block != 0) {
+                sb.append(padChar);
+            }
+        }
+        return sb.toString();
+    }
+
+    static int lcm(int a, int b) {
+        return a * b / BigInteger.valueOf(a).gcd(BigInteger.valueOf(b)).intValue();
+    }
+
+    /** Line breaking: lines of lineLength rounded down to whole encoded blocks, each followed by the separator. */
+    static String chunked(String enc, int lineLength, String sep, int block) {
+        int ll = lineLength / block * block;
+        if (ll <= 0 || enc.isEmpty()) {
+            return enc;
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < enc.length(); i += ll) {
+            sb.append(enc, i, Math.min(i + ll, enc.length())).append(sep);
+        }
+        return sb.toString();
+    }
+
+    /** RFC 9285: pairs to three characters, little-endian in base 45; a final byte to two. */
+    static String base45(byte[] data) {
+        StringBuilder sb = new StringBuilder();
+        int i = 0;
+        for (; i + 1 < data.length; i += 2) {
+            int v = (data[i] & 0xff) * 256 + (data[i + 1] & 0xff);
+            sb.append(B45.charAt(v % 45)).append(B45.charAt(v / 45 % 45)).append(B45.charAt(v / 2025));
+        }
+        if (i < data.length) {
+            int v = data[i] & 0xff;
+            sb.append(B45.charAt(v % 45)).append(B45.charAt(v / 45));
+        }
+        return sb.toString();
+    }
+
+    /** Base58 (Bitcoin): leading zero bytes become '1's, the rest is the big-endian number in base 58. */
+    static String base58(byte[] data) {
+        int zeros = 0;
+        while (zeros < data.length && data[zeros] == 0) {
+            zeros++;
+        }
+        StringBuilder sb = new StringBuilder();
+        BigInteger v = new BigInteger(1, data);
+        while (v.signum() > 0) {
+            BigInteger[] qr = v.divideAndRemainder(BigInteger.valueOf(58));
+            sb.append(B58.charAt(qr[1].intValue()));
+            v = qr[0];
+        }
+        for (int i = 0; i < zeros; i++) {
+            sb.append('1');
+        }
+        return sb.reverse().toString();
+    }
+
+    static String hex(byte[] data, boolean lower) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : data) {
+            sb.append(String.format(lower ? "%02x" : "%02X", x & 0xff));
+        }
+        return sb.toString();
+    }
+
+    /** BinaryCodec's bit string: the bytes from last to first, each MSB first (its documented order is by example only). */
+    static String bits(byte[] data) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = data.length - 1; i >= 0; i--) {
+            for (int bit = 7; bit >= 0; bit--) {
+                sb.append((data[i] >> bit & 1) == 1 ? '1' : '0');
+            }
+        }
+        return sb.toString();
+    }
+
+    // ------------------------------------------------------------------ properties
+
+    @Test
+    void base64MatchesJavaUtilAndTheRfcModel() {
+        Hegel.test(tc -> {
+            byte[] d = bytes(tc, 0, 120);
+            String ctx = " for " + show(d);
+            String model = rfc4648(d, B64, 6, true, '=');
+            String jdk = java.util.Base64.getEncoder().encodeToString(d);
+            check(model.equals(jdk), () -> "model " + show(model) + " vs java.util " + show(jdk) + ctx);
+            String std = Base64.encodeBase64String(d);
+            check(std.equals(model), () -> "encodeBase64String = " + show(std) + ", model " + show(model) + ctx);
+            check(new Base64().encodeToString(d).equals(model), () -> "new Base64().encodeToString differs" + ctx);
+            check(Arrays.equals(Base64.encodeBase64(d), ascii(model)), () -> "encodeBase64 differs" + ctx);
+            check(new Base64().getEncodedLength(d) == model.length(), () -> "getEncodedLength = " + new Base64().getEncodedLength(d) + ", model " + model.length() + ctx);
+
+            // URL-safe: the alphabet swaps + and /, and (documented) no padding is added
+            String urlModel = rfc4648(d, B64URL, 6, false, '=');
+            String url = Base64.encodeBase64URLSafeString(d);
+            check(url.equals(urlModel), () -> "encodeBase64URLSafeString = " + show(url) + ", model " + show(urlModel) + ctx);
+            check(url.equals(java.util.Base64.getUrlEncoder().withoutPadding().encodeToString(d)), () -> "URL-safe differs from java.util" + ctx);
+
+            // chunked: 76-character lines, each followed by CRLF
+            String chunkedModel = chunked(model, 76, "\r\n", 4);
+            String chunkedOut = ascii(Base64.encodeBase64Chunked(d));
+            check(chunkedOut.equals(chunkedModel), () -> "encodeBase64Chunked = " + show(chunkedOut) + ", model " + show(chunkedModel) + ctx);
+            String mime = java.util.Base64.getMimeEncoder().encodeToString(d);
+            check(chunkedOut.equals(mime.isEmpty() ? "" : mime + "\r\n"), () -> "chunked differs from java.util MIME " + show(mime) + ctx);
+            check(new Base64(76).getEncodedLength(d) == chunkedModel.length(), () -> "chunked getEncodedLength = " + new Base64(76).getEncodedLength(d) + ", model " + chunkedModel.length() + ctx);
+
+            // custom line length and separator
+            int ll = pick(tc, 0, 1, 3, 4, 5, 8, 10, 16, 64, 76, 200);
+            String sep = pick(tc, "\n", "\r\n", "|", "!!", "");
+            Base64 custom = new Base64(ll, ascii(sep));
+            String customModel = sep.isEmpty() ? model : chunked(model, ll, sep, 4);
+            String customOut = custom.encodeToString(d);
+            check(customOut.equals(customModel), () -> "new Base64(" + ll + ", " + show(sep) + ").encodeToString = " + show(customOut) + ", model " + show(customModel) + ctx);
+            check(custom.getEncodedLength(d) == customModel.length(), () -> "new Base64(" + ll + ", " + show(sep) + ").getEncodedLength = " + custom.getEncodedLength(d) + ", model " + customModel.length() + ctx);
+
+            // everything decodes back leniently, and strictly by a decoder configured like its encoder (since
+            // 8b506a1 strict decoding accepts only the canonical form of the instance's own encoder: alphabet,
+            // padding, line length and separator); the standard strict decoder accepts exactly the standard form
+            Base64[] twins = {
+                new Base64(0, null, false, CodecPolicy.STRICT),
+                new Base64(0, null, true, CodecPolicy.STRICT),
+                new Base64(76, ascii("\r\n"), false, CodecPolicy.STRICT),
+                new Base64(ll, ascii(sep), false, CodecPolicy.STRICT),
+            };
+            String[] encs = {model, url, chunkedOut, customOut};
+            for (int i = 0; i < encs.length; i++) {
+                String enc = encs[i];
+                Base64 twin = twins[i];
+                check(Arrays.equals(Base64.decodeBase64(enc), d), () -> "decodeBase64(" + show(enc) + ") differs" + ctx);
+                check(Arrays.equals(twin.decode(enc), d), () -> "strict decode(" + show(enc) + ") by a decoder configured like the encoder differs" + ctx);
+                check(twin.encodeToString(d).equals(enc), () -> "the strict twin's encoder does not reproduce " + show(enc) + ctx);
+                Base64 strictStandard = twins[0];
+                try {
+                    byte[] got = strictStandard.decode(enc);
+                    check(enc.equals(model), () -> "standard strict decode accepted the non-canonical " + show(enc) + " (canonical " + show(model) + ")" + ctx);
+                    check(Arrays.equals(got, d), () -> "standard strict decode(" + show(enc) + ") differs" + ctx);
+                    count(i == 0 ? "strict-canonical" : "strict-canonical-coincidence");
+                } catch (IllegalArgumentException e) {
+                    check(!enc.equals(model), () -> "standard strict decode rejected its own canonical form " + show(enc) + ": " + e.getMessage() + ctx);
+                    count("strict-rejected-noncanonical");
+                }
+                boolean onlyWhitespaceOutside = enc.chars().allMatch(c -> B64.indexOf(c) >= 0 || B64URL.indexOf(c) >= 0 || c == '=' || Character.isWhitespace(c));
+                if (onlyWhitespaceOutside) {
+                    check(Base64.isBase64(enc), () -> "isBase64(" + show(enc) + ") is false" + ctx);
+                    check(new Base64().isInAlphabet(enc), () -> "isInAlphabet(" + show(enc) + ") is false" + ctx);
+                } else {
+                    check(!new Base64().isInAlphabet(enc), () -> "isInAlphabet(" + show(enc) + ") is true with a separator outside the alphabet" + ctx);
+                    count(Base64.isBase64(enc) ? "isBase64-true-with-separator" : "isBase64-false-with-separator");
+                }
+            }
+            check(Arrays.equals(java.util.Base64.getMimeDecoder().decode(chunkedOut), d), () -> "java.util MIME cannot read the chunked output" + ctx);
+            check(Arrays.equals(Base64.decodeBase64(java.util.Base64.getUrlEncoder().encodeToString(d)), d), () -> "padded URL-safe from java.util not decoded" + ctx);
+            check(Arrays.equals(Base64.decodeBase64UrlSafe(url), d), () -> "decodeBase64UrlSafe differs" + ctx);
+            check(Arrays.equals(Base64.decodeBase64Standard(model), d), () -> "decodeBase64Standard differs" + ctx);
+            check(Base64.isBase64Standard(model) && Base64.isBase64Url(url), () -> "isBase64Standard/isBase64Url false on their own output" + ctx);
+            if (model.contains("+") || model.contains("/")) {
+                check(!Base64.isBase64Url(model), () -> "isBase64Url accepts a standard encoding with + or /: " + show(model) + ctx);
+            }
+            if (url.contains("-") || url.contains("_")) {
+                check(!Base64.isBase64Standard(url), () -> "isBase64Standard accepts a URL-safe encoding with - or _: " + show(url) + ctx);
+            }
+        }, Zoo.settings("base64MatchesJavaUtilAndTheRfcModel"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS base64MatchesJavaUtilAndTheRfcModel " + Zoo.stats());
+        }
+    }
+
+    @Test
+    void base32AndBase16MatchTheRfcModel() {
+        Hegel.test(tc -> {
+            byte[] d = bytes(tc, 0, 80);
+            String ctx = " for " + show(d);
+            boolean hex = chance(tc, 40);
+            String alphabet = hex ? B32HEX : B32;
+            byte padByte = chance(tc, 70) ? (byte) '=' : (byte) (int) pick(tc, (int) '-', (int) '~', (int) '*', (int) '.');
+            String model = rfc4648(d, alphabet, 5, true, (char) padByte);
+            Base32 codec = padByte == '=' ? new Base32(hex) : new Base32(hex, padByte);
+            String out = codec.encodeToString(d);
+            check(out.equals(model), () -> "Base32(hex=" + hex + ", pad=" + (char) padByte + ").encodeToString = " + show(out) + ", model " + show(model) + ctx);
+            check(codec.getEncodedLength(d) == model.length(), () -> "Base32.getEncodedLength = " + codec.getEncodedLength(d) + ", model " + model.length() + ctx);
+            check(Arrays.equals(codec.decode(out), d), () -> "Base32 decode of its own output differs" + ctx);
+            check(Arrays.equals(new Base32(0, null, hex, padByte, CodecPolicy.STRICT).decode(out), d), () -> "strict Base32 decode differs" + ctx);
+            check(codec.isInAlphabet(out), () -> "Base32.isInAlphabet false on its output" + ctx);
+            // unpadded input decodes too (RFC 4648 says padding may be omitted where known)
+            String unpadded = model.replace(String.valueOf((char) padByte), "");
+            check(Arrays.equals(codec.decode(unpadded), d), () -> "Base32 decode of the unpadded " + show(unpadded) + " differs" + ctx);
+
+            int ll = pick(tc, 0, 4, 8, 12, 16, 64, 76);
+            String sep = pick(tc, "\n", "\r\n", ";");
+            String lineModel = chunked(rfc4648(d, alphabet, 5, true, '='), ll, sep, 8);
+            String lineOut = new Base32(ll, ascii(sep), hex).encodeToString(d);
+            check(lineOut.equals(lineModel), () -> "Base32(" + ll + ", " + show(sep) + ", hex=" + hex + ").encodeToString = " + show(lineOut) + ", model " + show(lineModel) + ctx);
+            check(Arrays.equals(new Base32(ll, ascii(sep), hex).decode(lineOut), d), () -> "Base32 chunked decode differs" + ctx);
+
+            boolean lower = chance(tc, 50);
+            String hexModel = rfc4648(d, lower ? B16.toLowerCase(Locale.ROOT) : B16, 4, false, '=');
+            Base16 b16 = new Base16(lower);
+            String hexOut = b16.encodeToString(d);
+            check(hexOut.equals(hexModel), () -> "Base16(lower=" + lower + ").encodeToString = " + show(hexOut) + ", model " + show(hexModel) + ctx);
+            check(hexOut.equals(hex(d, lower)), () -> "Base16 differs from String.format" + ctx);
+            check(Arrays.equals(b16.decode(hexOut), d), () -> "Base16 decode differs" + ctx);
+            check(Arrays.equals(new Base16(lower, CodecPolicy.STRICT).decode(hexOut), d), () -> "strict Base16 decode differs" + ctx);
+            check(b16.getEncodedLength(d) == hexModel.length(), () -> "Base16.getEncodedLength = " + b16.getEncodedLength(d) + ctx);
+            // Hex agrees, in both cases, and reads either case
+            check(Hex.encodeHexString(d, lower).equals(hexModel), () -> "Hex.encodeHexString = " + show(Hex.encodeHexString(d, lower)) + ctx);
+            check(Hex.encodeHexString(d).equals(hex(d, true)), () -> "Hex.encodeHexString default is not lower case" + ctx);
+            check(Arrays.equals(new Hex().encode(d), ascii(hex(d, true))), () -> "new Hex().encode differs" + ctx);
+            try {
+                check(Arrays.equals(Hex.decodeHex(hexOut), d), () -> "Hex.decodeHex differs" + ctx);
+                check(Arrays.equals(Hex.decodeHex(hexOut.toUpperCase(Locale.ROOT)), d) && Arrays.equals(Hex.decodeHex(hexOut.toLowerCase(Locale.ROOT)), d), () -> "Hex.decodeHex is case sensitive" + ctx);
+                check(Arrays.equals(new Hex().decode(ascii(hexOut)), d), () -> "new Hex().decode differs" + ctx);
+            } catch (DecoderException e) {
+                fail("Hex.decodeHex(" + show(hexOut) + ") threw " + e + ctx);
+            }
+        }, Zoo.settings("base32AndBase16MatchTheRfcModel"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS base32AndBase16MatchTheRfcModel " + Zoo.stats());
+        }
+    }
+
+    @Test
+    void base45AndBase58MatchTheirModels() {
+        Hegel.test(tc -> {
+            byte[] d = bytes(tc, 0, 60);
+            if (chance(tc, 30)) {
+                // leading zeros are Base58's special case
+                int z = n(tc, 1, 4);
+                byte[] e = new byte[d.length + z];
+                System.arraycopy(d, 0, e, z, d.length);
+                d = e;
+            }
+            byte[] data = d;
+            String ctx = " for " + show(data);
+            String m45 = base45(data);
+            Base45 b45 = new Base45();
+            String o45 = b45.encodeToString(data);
+            check(o45.equals(m45), () -> "Base45.encodeToString = " + show(o45) + ", model " + show(m45) + ctx);
+            check(b45.getEncodedLength(data) == m45.length(), () -> "Base45.getEncodedLength = " + b45.getEncodedLength(data) + ", model " + m45.length() + ctx);
+            check(Arrays.equals(b45.decode(o45), data), () -> "Base45 decode differs" + ctx);
+            check(Arrays.equals(Base45.builder().setDecodingPolicy(CodecPolicy.STRICT).get().decode(o45), data), () -> "strict Base45 decode differs" + ctx);
+            check(b45.isInAlphabet(ascii(o45), false), () -> "Base45.isInAlphabet false on its output" + ctx);
+
+            String m58 = base58(data);
+            Base58 b58 = new Base58();
+            String o58 = b58.encodeToString(data);
+            check(o58.equals(m58), () -> "Base58.encodeToString = " + show(o58) + ", model " + show(m58) + ctx);
+            check(Arrays.equals(b58.decode(o58), data), () -> "Base58 decode differs" + ctx);
+            // commons-codec/1: Base58.getEncodedLength divides by zero for every input
+            count("known commons-codec/1");
+        }, Zoo.settings("base45AndBase58MatchTheirModels"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS base45AndBase58MatchTheirModels " + Zoo.stats());
+        }
+    }
+
+    /** A noise character the lenient decoders are documented to ignore. */
+    static String noise(TestCase tc) {
+        return pick(tc, " ", "\n", "\r\n", "\t", "*", "!", "#", "~", "é", ",", ";");
+    }
