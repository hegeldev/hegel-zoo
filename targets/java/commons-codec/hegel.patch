+    // ---------------------------------------------------------------- MurmurHash, xxHash
+
+    static int le32(byte[] d, int i) {
+        return (d[i] & 0xff) | (d[i + 1] & 0xff) << 8 | (d[i + 2] & 0xff) << 16 | (d[i + 3] & 0xff) << 24;
+    }
+
+    static long le64(byte[] d, int i) {
+        return (le32(d, i) & 0xffffffffL) | (long) le32(d, i + 4) << 32;
+    }
+
+    static int fmix32(int h) {
+        h ^= h >>> 16;
+        h *= 0x85ebca6b;
+        h ^= h >>> 13;
+        h *= 0xc2b2ae35;
+        h ^= h >>> 16;
+        return h;
+    }
+
+    static long fmix64(long k) {
+        k ^= k >>> 33;
+        k *= 0xff51afd7ed558ccdL;
+        k ^= k >>> 33;
+        k *= 0xc4ceb9fe1a85ec53L;
+        k ^= k >>> 33;
+        return k;
+    }
+
+    /** Austin Appleby's MurmurHash3_x86_32 over data[off, off+len). */
+    static int murmur3x86(byte[] data, int off, int len, int seed) {
+        final int c1 = 0xcc9e2d51, c2 = 0x1b873593;
+        int h1 = seed;
+        int blocks = len / 4;
+        for (int i = 0; i < blocks; i++) {
+            int k1 = le32(data, off + i * 4);
+            k1 *= c1;
+            k1 = Integer.rotateLeft(k1, 15);
+            k1 *= c2;
+            h1 ^= k1;
+            h1 = Integer.rotateLeft(h1, 13);
+            h1 = h1 * 5 + 0xe6546b64;
+        }
+        int tail = off + blocks * 4;
+        int k1 = 0;
+        switch (len & 3) {
+            case 3:
+                k1 ^= (data[tail + 2] & 0xff) << 16;
+            case 2:
+                k1 ^= (data[tail + 1] & 0xff) << 8;
+            case 1:
+                k1 ^= data[tail] & 0xff;
+                k1 *= c1;
+                k1 = Integer.rotateLeft(k1, 15);
+                k1 *= c2;
+                h1 ^= k1;
+            default:
+        }
+        h1 ^= len;
+        return fmix32(h1);
+    }
+
+    /** Austin Appleby's MurmurHash3_x64_128 over data[off, off+len); the 32-bit seed is zero-extended as in C. */
+    static long[] murmur3x64(byte[] data, int off, int len, int seed) {
+        final long c1 = 0x87c37b91114253d5L, c2 = 0x4cf5ad432745937fL;
+        long h1 = seed & 0xffffffffL, h2 = seed & 0xffffffffL;
+        int blocks = len / 16;
+        for (int i = 0; i < blocks; i++) {
+            long k1 = le64(data, off + i * 16);
+            long k2 = le64(data, off + i * 16 + 8);
+            k1 *= c1;
+            k1 = Long.rotateLeft(k1, 31);
+            k1 *= c2;
+            h1 ^= k1;
+            h1 = Long.rotateLeft(h1, 27);
+            h1 += h2;
+            h1 = h1 * 5 + 0x52dce729;
+            k2 *= c2;
+            k2 = Long.rotateLeft(k2, 33);
+            k2 *= c1;
+            h2 ^= k2;
+            h2 = Long.rotateLeft(h2, 31);
+            h2 += h1;
+            h2 = h2 * 5 + 0x38495ab5;
+        }
+        int tail = off + blocks * 16;
+        long k1 = 0, k2 = 0;
+        switch (len & 15) {
+            case 15:
+                k2 ^= (long) (data[tail + 14] & 0xff) << 48;
+            case 14:
+                k2 ^= (long) (data[tail + 13] & 0xff) << 40;
+            case 13:
+                k2 ^= (long) (data[tail + 12] & 0xff) << 32;
+            case 12:
+                k2 ^= (long) (data[tail + 11] & 0xff) << 24;
+            case 11:
+                k2 ^= (long) (data[tail + 10] & 0xff) << 16;
+            case 10:
+                k2 ^= (long) (data[tail + 9] & 0xff) << 8;
+            case 9:
+                k2 ^= data[tail + 8] & 0xff;
+                k2 *= c2;
+                k2 = Long.rotateLeft(k2, 33);
+                k2 *= c1;
+                h2 ^= k2;
+            case 8:
+                k1 ^= (long) (data[tail + 7] & 0xff) << 56;
+            case 7:
+                k1 ^= (long) (data[tail + 6] & 0xff) << 48;
+            case 6:
+                k1 ^= (long) (data[tail + 5] & 0xff) << 40;
+            case 5:
+                k1 ^= (long) (data[tail + 4] & 0xff) << 32;
+            case 4:
+                k1 ^= (long) (data[tail + 3] & 0xff) << 24;
+            case 3:
+                k1 ^= (long) (data[tail + 2] & 0xff) << 16;
+            case 2:
+                k1 ^= (long) (data[tail + 1] & 0xff) << 8;
+            case 1:
+                k1 ^= data[tail] & 0xff;
+                k1 *= c1;
+                k1 = Long.rotateLeft(k1, 31);
+                k1 *= c2;
+                h1 ^= k1;
+            default:
+        }
+        h1 ^= len;
+        h2 ^= len;
+        h1 += h2;
+        h2 += h1;
+        h1 = fmix64(h1);
+        h2 = fmix64(h2);
+        h1 += h2;
+        h2 += h1;
+        return new long[] {h1, h2};
+    }
+
+    /** Appleby's MurmurHash2 (32-bit). */
+    static int murmur2(byte[] data, int len, int seed) {
+        final int m = 0x5bd1e995, r = 24;
+        int h = seed ^ len;
+        int i = 0;
+        while (len - i >= 4) {
+            int k = le32(data, i);
+            k *= m;
+            k ^= k >>> r;
+            k *= m;
+            h *= m;
+            h ^= k;
+            i += 4;
+        }
+        switch (len - i) {
+            case 3:
+                h ^= (data[i + 2] & 0xff) << 16;
+            case 2:
+                h ^= (data[i + 1] & 0xff) << 8;
+            case 1:
+                h ^= data[i] & 0xff;
+                h *= m;
+            default:
+        }
+        h ^= h >>> 13;
+        h *= m;
+        h ^= h >>> 15;
+        return h;
+    }
+
+    /** Appleby's MurmurHash64A with the 32-bit seed zero-extended (as the class documents its port). */
+    static long murmur64a(byte[] data, int len, int seed) {
+        final long m = 0xc6a4a7935bd1e995L;
+        final int r = 47;
+        long h = (seed & 0xffffffffL) ^ (len * m);
+        int i = 0;
+        while (len - i >= 8) {
+            long k = le64(data, i);
+            k *= m;
+            k ^= k >>> r;
+            k *= m;
+            h ^= k;
+            h *= m;
+            i += 8;
+        }
+        switch (len - i) {
+            case 7:
+                h ^= (long) (data[i + 6] & 0xff) << 48;
+            case 6:
+                h ^= (long) (data[i + 5] & 0xff) << 40;
+            case 5:
+                h ^= (long) (data[i + 4] & 0xff) << 32;
+            case 4:
+                h ^= (long) (data[i + 3] & 0xff) << 24;
+            case 3:
+                h ^= (long) (data[i + 2] & 0xff) << 16;
+            case 2:
+                h ^= (long) (data[i + 1] & 0xff) << 8;
+            case 1:
+                h ^= data[i] & 0xff;
+                h *= m;
+            default:
+        }
+        h ^= h >>> r;
+        h *= m;
+        h ^= h >>> r;
+        return h;
+    }
+
+    /** Yann Collet's XXH32. */
+    static int xxh32(byte[] data, int len, int seed) {
+        final int p1 = 0x9E3779B1, p2 = 0x85EBCA77, p3 = 0xC2B2AE3D, p4 = 0x27D4EB2F, p5 = 0x165667B1;
+        int i = 0;
+        int h;
+        if (len >= 16) {
+            int v1 = seed + p1 + p2, v2 = seed + p2, v3 = seed, v4 = seed - p1;
+            while (len - i >= 16) {
+                v1 = Integer.rotateLeft(v1 + le32(data, i) * p2, 13) * p1;
+                v2 = Integer.rotateLeft(v2 + le32(data, i + 4) * p2, 13) * p1;
+                v3 = Integer.rotateLeft(v3 + le32(data, i + 8) * p2, 13) * p1;
+                v4 = Integer.rotateLeft(v4 + le32(data, i + 12) * p2, 13) * p1;
+                i += 16;
+            }
+            h = Integer.rotateLeft(v1, 1) + Integer.rotateLeft(v2, 7) + Integer.rotateLeft(v3, 12) + Integer.rotateLeft(v4, 18);
+        } else {
+            h = seed + p5;
+        }
+        h += len;
+        while (len - i >= 4) {
+            h = Integer.rotateLeft(h + le32(data, i) * p3, 17) * p4;
+            i += 4;
+        }
+        while (i < len) {
+            h = Integer.rotateLeft(h + (data[i] & 0xff) * p5, 11) * p1;
+            i++;
+        }
+        h ^= h >>> 15;
+        h *= p2;
+        h ^= h >>> 13;
+        h *= p3;
+        h ^= h >>> 16;
+        return h;
+    }
+
+    static int seed(TestCase tc) {
+        return Zoo.chance(tc, 30) ? Zoo.pick(tc, 0, 1, -1, 104729, 0x9747b28c, 0xe17a1465, Integer.MIN_VALUE, Integer.MAX_VALUE) : Zoo.n(tc, Integer.MIN_VALUE, Integer.MAX_VALUE);
+    }
