+                    } catch (DecoderException expected) {
+                        count("hex-odd-rejected");
+                    }
+                }
+                case 2 -> {
+                    // Base45: a length of 1 mod 3 is invalid, so is a triple above 65535 or a character outside the alphabet
+                    String enc = base45(d);
+                    String bad;
+                    String why;
+                    switch (n(tc, 0, 2)) {
+                        case 0 -> {
+                            bad = enc + B45.charAt(n(tc, 0, 44));
+                            if (bad.length() % 3 != 1) {
+                                bad = bad + B45.charAt(n(tc, 0, 44));
