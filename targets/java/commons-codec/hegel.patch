+            int off = Zoo.n(tc, 0, data.length);
+            int len = Zoo.n(tc, 0, data.length - off);
+            byte[] window = Arrays.copyOfRange(data, off, off + len);
+
+            int m3 = MurmurHash3.hash32x86(data, off, len, seed);
+            int m3Want = murmur3x86(data, off, len, seed);
+            Zoo.check(m3 == m3Want, () -> "hash32x86(" + show(window) + ", seed " + seed + ") = " + Integer.toHexString(m3) + " but the reference gives " + Integer.toHexString(m3Want));
+            Zoo.check(MurmurHash3.hash32x86(window) == murmur3x86(window, 0, len, 0), () -> "hash32x86(" + show(window) + ") with the default seed 0 disagrees with the reference");
+
+            long[] m128 = MurmurHash3.hash128x64(data, off, len, seed);
