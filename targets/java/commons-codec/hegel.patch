+
+    /** Reads everything through the stream in random-sized chunks. */
+    static byte[] drain(TestCase tc, InputStream in) throws IOException {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        byte[] buf = new byte[64];
+        while (true) {
+            if (chance(tc, 15)) {
+                // the single-byte read path
+                int b = in.read();
+                if (b < 0) {
+                    break;
+                }
+                out.write(b);
+                continue;
+            }
+            int want = n(tc, 1, buf.length);
+            int r = in.read(buf, 0, want);
+            if (r < 0) {
+                break;
+            }
+            check(r > 0, () -> "read(buf, 0, " + want + ") returned 0");
+            out.write(buf, 0, Math.max(r, 0));
+        }
+        return out.toByteArray();
+    }
+
+    /** Writes everything through the stream in random-sized chunks. */
+    static void pour(TestCase tc, OutputStream out, byte[] data) throws IOException {
+        int i = 0;
+        while (i < data.length) {
+            if (chance(tc, 15)) {
+                out.write(data[i]);
+                i++;
+                continue;
+            }
+            int len = Math.min(n(tc, 1, 40), data.length - i);
+            out.write(data, i, len);
+            i += len;
+            if (chance(tc, 20)) {
+                out.flush();
+            }
+        }
+        out.close();
+    }
+
+    @Test
+    void streamsAgreeWithOneShotCodecs() {
+        Hegel.test(tc -> {
+            byte[] d = bytes(tc, 0, 200);
+            String ctx = " for " + show(d);
+            int which = n(tc, 0, 4);
+            String name = new String[] {"Base64", "Base32", "Base16", "Base45", "Base58"}[which];
+            BaseNCodec codec = switch (which) {
+                case 0 -> chance(tc, 50) ? new Base64() : new Base64(pick(tc, 8, 76), ascii(pick(tc, "\n", "\r\n")));
+                case 1 -> chance(tc, 50) ? new Base32() : new Base32(pick(tc, 16, 64), ascii("\n"));
+                case 2 -> new Base16(chance(tc, 50));
+                case 3 -> new Base45();
+                default -> new Base58();
+            };
+            byte[] encoded = codec.encode(d);
+            String encodedText = ascii(encoded);
+            try {
+                // encoding input stream
+                byte[] viaIn = drain(tc, inputStream(which, new ByteArrayInputStream(d), true, codec));
+                check(Arrays.equals(viaIn, encoded), () -> name + "InputStream(encode) gave " + show(ascii(viaIn)) + ", one-shot " + show(encodedText) + ctx);
+                // decoding input stream
+                byte[] backIn = drain(tc, inputStream(which, new ByteArrayInputStream(encoded), false, codec));
+                check(Arrays.equals(backIn, d), () -> name + "InputStream(decode) of " + show(encodedText) + " gave " + show(backIn) + ctx);
+                // encoding output stream
+                ByteArrayOutputStream sink = new ByteArrayOutputStream();
+                pour(tc, outputStream(which, sink, true, codec), d);
+                byte[] viaOut = sink.toByteArray();
+                check(Arrays.equals(viaOut, encoded), () -> name + "OutputStream(encode) gave " + show(ascii(viaOut)) + ", one-shot " + show(encodedText) + ctx);
+                // decoding output stream
+                ByteArrayOutputStream sink2 = new ByteArrayOutputStream();
+                pour(tc, outputStream(which, sink2, false, codec), encoded);
+                byte[] backOut = sink2.toByteArray();
+                check(Arrays.equals(backOut, d), () -> name + "OutputStream(decode) of " + show(encodedText) + " gave " + show(backOut) + ctx);
+            } catch (IOException e) {
+                fail(name + " stream threw " + e + ctx);
+            }
+        }, Zoo.settings("streamsAgreeWithOneShotCodecs"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS streamsAgreeWithOneShotCodecs " + Zoo.stats());
+        }
+    }
+
+    static InputStream inputStream(int which, InputStream in, boolean encode, BaseNCodec codec) {
+        return switch (which) {
+            case 0 -> Base64InputStream.builder().setInputStream(in).setEncode(encode).setBaseNCodec((Base64) codec).get();
+            case 1 -> Base32InputStream.builder().setInputStream(in).setEncode(encode).setBaseNCodec((Base32) codec).get();
+            case 2 -> Base16InputStream.builder().setInputStream(in).setEncode(encode).setBaseNCodec((Base16) codec).get();
+            case 3 -> Base45InputStream.builder().setInputStream(in).setEncode(encode).setBaseNCodec((Base45) codec).get();
+            default -> Base58InputStream.builder().setInputStream(in).setEncode(encode).setBaseNCodec((Base58) codec).get();
+        };
+    }
+
+    static OutputStream outputStream(int which, OutputStream out, boolean encode, BaseNCodec codec) {
+        return switch (which) {
+            case 0 -> Base64OutputStream.builder().setOutputStream(out).setEncode(encode).setBaseNCodec((Base64) codec).get();
+            case 1 -> Base32OutputStream.builder().setOutputStream(out).setEncode(encode).setBaseNCodec((Base32) codec).get();
+            case 2 -> Base16OutputStream.builder().setOutputStream(out).setEncode(encode).setBaseNCodec((Base16) codec).get();
+            case 3 -> Base45OutputStream.builder().setOutputStream(out).setEncode(encode).setBaseNCodec((Base45) codec).get();
+            default -> Base58OutputStream.builder().setOutputStream(out).setEncode(encode).setBaseNCodec((Base58) codec).get();
+        };
+    }
+
+    @Test
+    void binaryCodecAndIntegersRoundTrip() {
+        Hegel.test(tc -> {
+            byte[] d = bytes(tc, 0, 40);
+            String ctx = " for " + show(d);
+            String model = bits(d);
+            String out = BinaryCodec.toAsciiString(d);
+            check(out.equals(model), () -> "BinaryCodec.toAsciiString = " + show(out) + ", model " + show(model) + ctx);
+            check(Arrays.equals(BinaryCodec.toAsciiBytes(d), ascii(model)) && Arrays.equals(BinaryCodec.toAsciiChars(d), model.toCharArray()), () -> "toAsciiBytes/toAsciiChars differ from toAsciiString" + ctx);
+            check(Arrays.equals(BinaryCodec.fromAscii(model.toCharArray()), d), () -> "BinaryCodec.fromAscii(chars) differs" + ctx);
+            check(Arrays.equals(BinaryCodec.fromAscii(ascii(model)), d), () -> "BinaryCodec.fromAscii(bytes) differs" + ctx);
+            BinaryCodec codec = new BinaryCodec();
+            check(Arrays.equals(codec.decode(codec.encode(d)), d), () -> "BinaryCodec encode/decode round trip differs" + ctx);
+            check(Arrays.equals(codec.toByteArray(model), d), () -> "BinaryCodec.toByteArray differs" + ctx);
+            // since upstream 7bc15f1 every character must be '0' or '1' (before, any character other than '1' was a
+            // zero bit): the whole input is validated, then whole bytes are decoded from the end
+            char other = pick(tc, ' ', 'x', 'O', '2');
+            String loose = model.replace('0', other);
+            if (model.indexOf('0') >= 0) {
+                try {
+                    byte[] r = BinaryCodec.fromAscii(loose.toCharArray());
+                    fail("BinaryCodec.fromAscii(" + show(loose) + ") = " + Arrays.toString(r) + " instead of rejecting '" + other + "'" + ctx);
+                } catch (IllegalArgumentException expected) {
+                    // documented
+                }
+                try {
+                    byte[] r = BinaryCodec.fromAscii(ascii(loose));
+                    fail("BinaryCodec.fromAscii(bytes " + show(loose) + ") = " + Arrays.toString(r) + " instead of rejecting '" + other + "'" + ctx);
+                } catch (IllegalArgumentException expected) {
+                    // documented
+                }
+            }
+            // a length that is not a multiple of 8 keeps whole bytes only, counted from the end
+            String prefix = word(tc, "01", 1, 7);
+            check(Arrays.equals(BinaryCodec.fromAscii((prefix + model).toCharArray()), d), () -> "BinaryCodec.fromAscii(" + show(prefix + model) + ") does not drop the leading " + prefix.length() + " bits" + ctx);
+
+            BigInteger big = new BigInteger(1, bytes(tc, 0, 40));
+            byte[] enc = Base64.encodeInteger(big);
+            check(Base64.decodeInteger(enc).equals(big), () -> "decodeInteger(encodeInteger(" + big + ")) = " + Base64.decodeInteger(enc) + ctx);
+            check(Base64.isBase64(enc), () -> "encodeInteger(" + big + ") = " + show(ascii(enc)) + " is not base64" + ctx);
+            // the encoding is the two's-complement magnitude without a sign byte, as the Javadoc's XML-DSIG reference wants
+            byte[] mag = big.toByteArray();
+            if (mag[0] == 0) {
+                // no sign byte, and zero has no octets at all
+                mag = Arrays.copyOfRange(mag, 1, mag.length);
+            }
+            byte[] magnitude = mag;
+            check(Arrays.equals(Base64.decodeBase64(enc), magnitude), () -> "encodeInteger(" + big + ") encodes " + show(Base64.decodeBase64(enc)) + ", not the magnitude " + show(magnitude) + ctx);
+        }, Zoo.settings("binaryCodecAndIntegersRoundTrip"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS binaryCodecAndIntegersRoundTrip " + Zoo.stats());
+        }
+    }
+}
