+        for (int i = 0; i < n; i++) {
+            b[i] = (byte) (Zoo.chance(tc, 30) ? Zoo.pick(tc, 0, 0xff, 0x80, 0x7f, 1, 0xfe) : Zoo.n(tc, 0, 255));
