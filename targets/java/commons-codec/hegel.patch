+            }
+            // a ByteBuffer window
+            int off = Zoo.n(tc, 0, data.length);
+            ByteBuffer bb = ByteBuffer.wrap(data, off, data.length - off);
+            byte[] windowWant;
+            try {
+                windowWant = MessageDigest.getInstance(alg).digest(Arrays.copyOfRange(data, off, data.length));
+            } catch (Exception e) {
+                throw new RuntimeException(e);
+            }
+            Zoo.check(du.digestAsHex(bb).equals(hex(windowWant)), () -> "DigestUtils(" + alg + ").digestAsHex(ByteBuffer from " + off + ") differs for " + show(data));
+            Zoo.check(bb.remaining() == 0, () -> "DigestUtils.digest(ByteBuffer) left " + bb.remaining() + " bytes remaining");
+            String text = Zoo.word(tc, PRINTABLE + "\u00e9\u65e5\ud83d\ude00", 0, 30);
+            byte[] textWant;
+            try {
+                textWant = MessageDigest.getInstance(alg).digest(text.getBytes(StandardCharsets.UTF_8));
+            } catch (Exception e) {
+                throw new RuntimeException(e);
+            }
+            Zoo.check(du.digestAsHex(text).equals(hex(textWant)), () -> "DigestUtils(" + alg + ").digestAsHex(String " + show(text) + ") is not the digest of its UTF-8 bytes");
+
+            // HMAC
+            HmacAlgorithms hm = Zoo.pick(tc, HmacAlgorithms.values());
+            byte[] key = bytes(tc, 1, 80);
+            byte[] macWant;
+            try {
+                Mac mac = Mac.getInstance(hm.getName());
+                mac.init(new SecretKeySpec(key, hm.getName()));
+                macWant = mac.doFinal(data);
+            } catch (Exception e) {
+                throw new RuntimeException(e);
+            }
+            HmacUtils hu = new HmacUtils(hm, key);
+            byte[] macGot = hu.hmac(data);
+            Zoo.check(Arrays.equals(macGot, macWant), () -> "HmacUtils(" + hm + ") of " + show(data) + " with key " + show(key) + " = " + hex(macGot) + " but JCA gives " + hex(macWant));
+            Zoo.check(hu.hmacHex(data).equals(hex(macWant)), () -> "HmacUtils(" + hm + ").hmacHex differs from the bytes for " + show(data));
+            try {
+                Zoo.check(hu.hmacHex(new ByteArrayInputStream(data)).equals(hex(macWant)), () -> "HmacUtils(" + hm + ").hmacHex(InputStream) differs for " + show(data));
+            } catch (java.io.IOException e) {
+                throw new RuntimeException(e);
+            }
+            Zoo.check(Arrays.equals(HmacUtils.getInitializedMac(hm, key).doFinal(data), macWant), () -> "HmacUtils.getInitializedMac(" + hm + ") differs for " + show(data));
+            // a second use of the same HmacUtils gives the same answer (the Mac is reset)
+            Zoo.check(Arrays.equals(hu.hmac(data), macWant), () -> "HmacUtils(" + hm + ").hmac twice disagrees for " + show(data));
+        }, Zoo.settings("digestAndHmacUtilsMatchTheJca"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS digestAndHmacUtilsMatchTheJca " + Zoo.stats());
+        }
+    }
+
+    // ---------------------------------------------------------------- GitIdentifiers
+
+    static MessageDigest sha1() {
+        try {
+            return MessageDigest.getInstance("SHA-1");
+        } catch (Exception e) {
+            throw new RuntimeException(e);
+        }
+    }
+
+    static byte[] gitObject(String type, byte[] content) {
+        MessageDigest md = sha1();
+        md.update((type + " " + content.length + "\0").getBytes(StandardCharsets.US_ASCII));
+        md.update(content);
+        return md.digest();
+    }
+
+    /** A model tree: name -> entry; a directory entry holds a nested Tree. */
+    static final class Tree {
+        record Entry(String mode, byte[] id, Tree sub) {
+        }
+
+        final Map<String, Entry> entries = new TreeMap<>();
+
+        Tree dir(String name) {
+            Entry e = entries.get(name);
+            if (e == null) {
+                e = new Entry("40000", null, new Tree());
+                entries.put(name, e);
+            }
+            return e.sub();
+        }
+
+        static byte[] sortKey(String name, boolean dir) {
+            return (dir ? name + "/" : name).getBytes(StandardCharsets.UTF_8);
+        }
+
+        byte[] id() {
+            List<Map.Entry<String, Entry>> sorted = new ArrayList<>(entries.entrySet());
+            sorted.sort((a, b) -> Arrays.compareUnsigned(sortKey(a.getKey(), a.getValue().sub() != null), sortKey(b.getKey(), b.getValue().sub() != null)));
+            java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream();
+            for (Map.Entry<String, Entry> e : sorted) {
+                Entry v = e.getValue();
+                byte[] id = v.sub() != null ? v.sub().id() : v.id();
+                out.writeBytes((v.mode() + " " + e.getKey() + "\0").getBytes(StandardCharsets.UTF_8));
+                out.writeBytes(id);
+            }
+            return gitObject("tree", out.toByteArray());
+        }
+    }
+
+    static final String[] NAMES = {"a", "b", "ab", "a-", "a.", "A", "z", "~", "a b", "\u00e9", "\u00e9t\u00e9", "\uff01", "\ud83d\ude00", "\ud83d\ude00x", "1", "_", "foo", "foobar", "foo.c", "foo-c", "README", "Makefile"};
+
+    @Test
+    void gitIdentifiersMatchGitsObjectFormat() {
+        Hegel.test(tc -> {
+            byte[] data = bytes(tc, 0, 200);
+            byte[] blob = GitIdentifiers.blobId(sha1(), data);
+            byte[] blobWant = gitObject("blob", data);
+            Zoo.check(Arrays.equals(blob, blobWant), () -> "blobId of " + show(data) + " = " + hex(blob) + " but Git's formula gives " + hex(blobWant));
+            try {
+                byte[] streamed = GitIdentifiers.blobId(sha1(), data.length, new ByteArrayInputStream(data));
+                Zoo.check(Arrays.equals(streamed, blobWant), () -> "blobId(InputStream) of " + show(data) + " = " + hex(streamed) + ", expected " + hex(blobWant));
+            } catch (java.io.IOException e) {
+                throw new RuntimeException(e);
+            }
+
+            // a random tree
+            Tree model = new Tree();
+            GitIdentifiers.TreeIdBuilder builder = GitIdentifiers.treeIdBuilder(sha1());
+            int entries = Zoo.n(tc, 0, 8);
+            List<String> log = new ArrayList<>();
+            java.util.Set<String> paths = new java.util.HashSet<>();
+            for (int i = 0; i < entries; i++) {
+                int depth = Zoo.n(tc, 1, 3);
+                String[] parts = new String[depth];
+                for (int d = 0; d < depth; d++) {
+                    parts[d] = Zoo.pick(tc, NAMES);
+                }
+                String path = String.join("/", parts);
+                // a path must not be a file and a directory at once, nor repeat
+                boolean conflict = false;
+                for (String p : paths) {
+                    conflict |= p.equals(path) || p.startsWith(path + "/") || path.startsWith(p + "/");
+                }
+                if (conflict) {
+                    continue;
+                }
+                paths.add(path);
+                Tree at = model;
+                for (int d = 0; d < depth - 1; d++) {
+                    at = at.dir(parts[d]);
+                }
+                String leaf = parts[depth - 1];
+                int kind = Zoo.n(tc, 0, 4);
+                try {
+                    switch (kind) {
+                        case 0 -> {
+                            byte[] content = bytes(tc, 0, 30);
+                            builder.addFile(GitIdentifiers.FileMode.REGULAR, path, content);
+                            at.entries.put(leaf, new Tree.Entry("100644", gitObject("blob", content), null));
+                            log.add("file " + path);
+                        }
+                        case 1 -> {
+                            byte[] content = bytes(tc, 0, 30);
+                            builder.addFile(GitIdentifiers.FileMode.EXECUTABLE, path, content.length, new ByteArrayInputStream(content));
+                            at.entries.put(leaf, new Tree.Entry("100755", gitObject("blob", content), null));
+                            log.add("exe " + path);
+                        }
+                        case 2 -> {
+                            String target = Zoo.pick(tc, "a", "../b", "/etc/passwd", "\u00e9");
+                            builder.addSymbolicLink(path, target);
+                            at.entries.put(leaf, new Tree.Entry("120000", gitObject("blob", target.getBytes(StandardCharsets.UTF_8)), null));
+                            log.add("link " + path + " -> " + target);
+                        }
+                        default -> {
+                            builder.addDirectory(path);
+                            at.dir(leaf);
+                            log.add("dir " + path);
+                        }
+                    }
+                } catch (java.io.IOException e) {
+                    throw new RuntimeException(e);
+                }
+            }
+            byte[] got = builder.get();
+            byte[] want = model.id();
+            Zoo.check(Arrays.equals(got, want), () -> "treeId of " + log + " = " + hex(got) + " but Git's tree format gives " + hex(want));
+            Zoo.count("entries-" + Math.min(paths.size(), 3));
+        }, Zoo.settings("gitIdentifiersMatchGitsObjectFormat"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS gitIdentifiersMatchGitsObjectFormat " + Zoo.stats());
+        }
+    }
+}
