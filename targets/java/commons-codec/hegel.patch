+++ b/hegel/src/test/java/zoo/NetTest.java
@@ -0,0 +1,542 @@
+package zoo;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.ByteArrayOutputStream;
+import java.net.URLDecoder;
+import java.net.URLEncoder;
+import java.nio.charset.Charset;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.BitSet;
+import java.util.Locale;
+import org.apache.commons.codec.DecoderException;
+import org.apache.commons.codec.EncoderException;
+import org.apache.commons.codec.binary.Base64;
+import org.apache.commons.codec.binary.Hex;
+import org.apache.commons.codec.net.BCodec;
+import org.apache.commons.codec.net.PercentCodec;
+import org.apache.commons.codec.net.QCodec;
+import org.apache.commons.codec.net.QuotedPrintableCodec;
+import org.apache.commons.codec.net.URLCodec;
+import org.junit.jupiter.api.Test;
+
+/**
+ * org.apache.commons.codec.net against models written from the documents the classes cite: HTML 4.01's
+ * www-form-urlencoded (and java.net.URLEncoder), RFC 3986 percent-encoding, RFC 1521 quoted-printable
+ * (rules 1-5) and RFC 1522 encoded words (B and Q).
+ */
+class NetTest {
+
+    static final String PRINTABLE = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
+
+    static byte[] bytes(TestCase tc, int lo, int hi) {
+        int n = Zoo.n(tc, lo, hi);
+        byte[] b = new byte[n];
+        for (int i = 0; i < n; i++) {
+            int r = Zoo.n(tc, 0, 99);
+            if (r < 50) {
+                b[i] = (byte) PRINTABLE.charAt(Zoo.n(tc, 0, PRINTABLE.length() - 1));
+            } else if (r < 65) {
+                String pool = " %+=\r\n\t_?\u0000\u00ff\u0080";
+                b[i] = (byte) pool.charAt(Zoo.n(tc, 0, pool.length() - 1));
+            } else {
+                b[i] = (byte) Zoo.n(tc, 0, 255);
+            }
+        }
+        return b;
+    }
+
+    /** Text mixing ASCII with a few non-ASCII characters. */
+    static String text(TestCase tc, int lo, int hi) {
+        StringBuilder sb = new StringBuilder();
+        int n = Zoo.n(tc, lo, hi);
+        for (int i = 0; i < n; i++) {
+            int r = Zoo.n(tc, 0, 99);
+            if (r < 70) {
+                sb.append(PRINTABLE.charAt(Zoo.n(tc, 0, PRINTABLE.length() - 1)));
+            } else if (r < 85) {
+                sb.append(Zoo.pick(tc, ' ', '%', '+', '=', '_', '?', '\t'));
+            } else {
+                sb.append(Zoo.pick(tc, "é", "ß", "日", "😀", "Ж", " ", " "));
+            }
+        }
+        return sb.toString();
+    }
+
+    static String show(Object o) {
+        return Zoo.show(o);
+    }
+
+    static String show(byte[] b) {
+        return b.length + " bytes " + Hex.encodeHexString(b);
+    }
+
+    static String ascii(byte[] b) {
+        return new String(b, StandardCharsets.ISO_8859_1);
+    }
+
+    static String hex2(int b) {
+        return String.format(Locale.ROOT, "%02X", b & 0xff);
+    }
+
+    // ---------------------------------------------------------------- www-form-urlencoded
+
+    static final BitSet FORM_SAFE = new BitSet(256);
+
+    static {
+        for (char c = 'a'; c <= 'z'; c++) {
+            FORM_SAFE.set(c);
+        }
+        for (char c = 'A'; c <= 'Z'; c++) {
+            FORM_SAFE.set(c);
+        }
+        for (char c = '0'; c <= '9'; c++) {
+            FORM_SAFE.set(c);
+        }
+        FORM_SAFE.set('-');
+        FORM_SAFE.set('_');
+        FORM_SAFE.set('.');
+        FORM_SAFE.set('*');
+        FORM_SAFE.set(' ');
+    }
+
+    /**
+     * HTML 4.01 17.13.4: safe bytes literal, space as "+" (when space is in the safe set; otherwise it is "%20"),
+     * everything else "%XX"; "%" and "+" always escaped.
+     */
+    static String formEncode(byte[] data, BitSet safe) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : data) {
+            int b = x & 0xff;
+            if (b == ' ' && safe.get(b)) {
+                sb.append('+');
+            } else if (safe.get(b) && b != '%' && b != '+') {
+                sb.append((char) b);
+            } else {
+                sb.append('%').append(hex2(b));
+            }
+        }
+        return sb.toString();
+    }
+
+    /** Decodes "+" and "%XX"; returns null for a malformed escape. */
+    static byte[] formDecode(byte[] enc) {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        for (int i = 0; i < enc.length; i++) {
+            int b = enc[i] & 0xff;
+            if (b == '+') {
+                out.write(' ');
+            } else if (b == '%') {
+                if (i + 2 >= enc.length) {
+                    return null;
+                }
+                int hi = Character.digit(enc[i + 1], 16), lo = Character.digit(enc[i + 2], 16);
+                if (hi < 0 || lo < 0) {
+                    return null;
+                }
+                out.write(hi << 4 | lo);
+                i += 2;
+            } else {
+                out.write(b);
+            }
+        }
+        return out.toByteArray();
+    }
+
+    @Test
+    void urlCodecMatchesTheFormEncodingAndTheJdk() {
+        Hegel.test(tc -> {
+            byte[] data = bytes(tc, 0, 40);
+            URLCodec codec = new URLCodec();
+            byte[] enc;
+            try {
+                enc = codec.encode(data);
+            } catch (Exception e) {
+                Zoo.fail("URLCodec.encode(" + show(data) + ") threw " + e);
+                return;
+            }
+            String want = formEncode(data, FORM_SAFE);
+            Zoo.check(ascii(enc).equals(want), () -> "URLCodec.encode(" + show(data) + ") = " + ascii(enc) + " but the form encoding is " + want);
+            try {
+                byte[] back = codec.decode(enc);
+                Zoo.check(Arrays.equals(back, data), () -> "URLCodec.decode(encode(" + show(data) + ")) = " + show(back));
+            } catch (DecoderException e) {
+                Zoo.fail("URLCodec.decode(" + ascii(enc) + ") threw " + e);
+            }
+            // Strings: UTF-8 bytes, and the JDK's URLEncoder agrees on the same safe set
+            String text = text(tc, 0, 30);
+            try {
+                String encS = codec.encode(text);
+                String jdk = URLEncoder.encode(text, StandardCharsets.UTF_8);
+                Zoo.check(encS.equals(jdk), () -> "URLCodec.encode(" + show(text) + ") = " + encS + " but URLEncoder gives " + jdk);
+                String backS = codec.decode(encS);
+                Zoo.check(backS.equals(text), () -> "URLCodec.decode(encode(" + show(text) + ")) = " + show(backS));
+                Zoo.check(URLDecoder.decode(encS, StandardCharsets.UTF_8).equals(text), () -> "URLDecoder cannot read URLCodec's " + encS + " back to " + show(text));
+                // a Latin-1 codec
+                String latin = text.chars().allMatch(c -> c < 256) ? text : text.replaceAll("[^\\x00-\\xff]", "?");
+                URLCodec latinCodec = new URLCodec("ISO-8859-1");
+                String latinEnc = latinCodec.encode(latin);
+                Zoo.check(latinEnc.equals(URLEncoder.encode(latin, StandardCharsets.ISO_8859_1)), () -> "URLCodec(ISO-8859-1).encode(" + show(latin) + ") = " + latinEnc + " but URLEncoder gives " + URLEncoder.encode(latin, StandardCharsets.ISO_8859_1));
+                String latinBack = latinCodec.decode(latinEnc);
+                Zoo.check(latinBack.equals(latin), () -> "URLCodec(ISO-8859-1) round trip fails for " + show(latin) + ": " + show(latinBack));
+            } catch (EncoderException | DecoderException e) {
+                Zoo.fail("URLCodec String round trip of " + show(text) + " threw " + e);
+            }
+            // a custom safe set: "%" and "+" stay escaped, space is "+"
+            BitSet safe = new BitSet(256);
+            for (int i = 0; i < 128; i++) {
+                if (Zoo.chance(tc, 50)) {
+                    safe.set(i);
+                }
+            }
+            byte[] custom = URLCodec.encodeUrl(safe, data);
+            String customWant = formEncode(data, safe);
+            Zoo.check(ascii(custom).equals(customWant), () -> "URLCodec.encodeUrl(custom safe set, " + show(data) + ") = " + ascii(custom) + " but the form encoding is " + customWant);
+            try {
+                byte[] back = URLCodec.decodeUrl(custom);
+                Zoo.check(Arrays.equals(back, data), () -> "URLCodec.decodeUrl(encodeUrl(custom, " + show(data) + ")) = " + show(back));
+            } catch (DecoderException e) {
+                Zoo.fail("URLCodec.decodeUrl(" + ascii(custom) + ") threw " + e);
+            }
+            // decoding arbitrary input: the model's verdict on malformed escapes
+            byte[] noisy = bytes(tc, 0, 20);
+            byte[] modelDecoded = formDecode(noisy);
+            try {
+                byte[] got = URLCodec.decodeUrl(noisy);
+                if (modelDecoded == null) {
+                    Zoo.fail("URLCodec.decodeUrl(" + show(noisy) + ") = " + show(got) + " but the input has a malformed % escape");
+                } else {
+                    Zoo.check(Arrays.equals(got, modelDecoded), () -> "URLCodec.decodeUrl(" + show(noisy) + ") = " + show(got) + " but the model gives " + show(modelDecoded));
+                    Zoo.count("noisy-decoded");
+                }
+            } catch (DecoderException e) {
+                Zoo.check(modelDecoded == null, () -> "URLCodec.decodeUrl(" + show(noisy) + ") threw " + e + " but the model decodes it to " + show(modelDecoded));
+                Zoo.count("noisy-rejected");
+            }
+        }, Zoo.settings("urlCodecMatchesTheFormEncodingAndTheJdk"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS urlCodecMatchesTheFormEncodingAndTheJdk " + Zoo.stats());
+        }
+    }
+
+    // ---------------------------------------------------------------- percent-encoding
+
+    static String percentEncode(byte[] data, BitSet always, boolean plusForSpace) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : data) {
+            int b = x & 0xff;
+            if (plusForSpace && b == ' ' && !always.get(b)) {
+                // a space listed in alwaysEncode is percent-encoded even with plusForSpace
+                sb.append('+');
+            } else if (b < 0x80 && b != '%' && !always.get(b) && !(plusForSpace && b == '+')) {
+                sb.append((char) b);
+            } else {
+                sb.append('%').append(hex2(b));
+            }
+        }
+        return sb.toString();
+    }
+
+    @Test
+    void percentCodecMatchesRfc3986AndRoundTrips() {
+        Hegel.test(tc -> {
+            byte[] data = bytes(tc, 0, 40);
+            boolean plus = Zoo.chance(tc, 50);
+            boolean custom = Zoo.chance(tc, 60);
+            BitSet always = new BitSet(256);
+            byte[] alwaysBytes = new byte[0];
+            if (custom) {
+                ByteArrayOutputStream ab = new ByteArrayOutputStream();
+                int n = Zoo.n(tc, 0, 6);
+                for (int i = 0; i < n; i++) {
+                    String pool = "aZ0/?#[]@!$&'()*+,;= %~\u007f\u0000";
+                    int c = pool.charAt(Zoo.n(tc, 0, pool.length() - 1));
+                    always.set(c);
+                    ab.write(c);
+                }
+                alwaysBytes = ab.toByteArray();
+            }
+            PercentCodec codec = custom ? new PercentCodec(alwaysBytes, plus) : new PercentCodec();
+            boolean effectivePlus = custom && plus;
+            String config = custom ? "alwaysEncode " + show(alwaysBytes) + ", plusForSpace " + plus : "default";
+            byte[] enc;
+            try {
+                enc = codec.encode(data);
+            } catch (EncoderException e) {
+                Zoo.fail("PercentCodec(" + config + ").encode(" + show(data) + ") threw " + e);
+                return;
+            }
+            String want = percentEncode(data, always, effectivePlus);
+            Zoo.check(ascii(enc).equals(want), () -> "PercentCodec(" + config + ").encode(" + show(data) + ") = " + ascii(enc) + " but the model gives " + want);
+            try {
+                byte[] back = codec.decode(enc);
+                Zoo.check(Arrays.equals(back, data), () -> "PercentCodec(" + config + ").decode(encode(" + show(data) + ")) = " + show(back) + " via " + ascii(enc));
+            } catch (DecoderException e) {
+                Zoo.fail("PercentCodec(" + config + ").decode(" + ascii(enc) + ") threw " + e);
+            }
+            // empty and null pass through
+            try {
+                Zoo.check(codec.encode(new byte[0]).length == 0 && codec.decode(new byte[0]).length == 0, () -> "PercentCodec on empty input");
+                Zoo.check(codec.encode((byte[]) null) == null && codec.decode((byte[]) null) == null, () -> "PercentCodec on null input");
+            } catch (EncoderException | DecoderException e) {
+                Zoo.fail("PercentCodec on empty/null threw " + e);
+            }
+            // malformed escapes are rejected, well-formed ones decoded
+            byte[] noisy = bytes(tc, 0, 20);
+            byte[] modelDecoded = formDecode(noisy);
+            try {
+                byte[] got = codec.decode(noisy);
+                if (modelDecoded == null) {
+                    Zoo.fail("PercentCodec(" + config + ").decode(" + show(noisy) + ") = " + show(got) + " but the input has a malformed % escape");
+                } else if (effectivePlus) {
+                    Zoo.check(Arrays.equals(got, modelDecoded), () -> "PercentCodec(" + config + ").decode(" + show(noisy) + ") = " + show(got) + " but the model gives " + show(modelDecoded));
+                } else {
+                    // without plusForSpace a "+" is data
+                    byte[] plusKept = modelDecodedKeepingPlus(noisy);
+                    Zoo.check(Arrays.equals(got, plusKept), () -> "PercentCodec(" + config + ").decode(" + show(noisy) + ") = " + show(got) + " but the model gives " + show(plusKept));
+                }
+            } catch (DecoderException e) {
+                Zoo.check(modelDecoded == null, () -> "PercentCodec(" + config + ").decode(" + show(noisy) + ") threw " + e + " but the model decodes it");
+            }
+        }, Zoo.settings("percentCodecMatchesRfc3986AndRoundTrips"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS percentCodecMatchesRfc3986AndRoundTrips " + Zoo.stats());
+        }
+    }
+
+    static byte[] modelDecodedKeepingPlus(byte[] enc) {
+        // same as formDecode but "+" is literal
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        for (int i = 0; i < enc.length; i++) {
+            int b = enc[i] & 0xff;
+            if (b == '%') {
+                int hi = Character.digit(enc[i + 1], 16), lo = Character.digit(enc[i + 2], 16);
+                out.write(hi << 4 | lo);
+                i += 2;
+            } else {
+                out.write(b);
+            }
+        }
+        return out.toByteArray();
+    }
+
+    // ---------------------------------------------------------------- quoted-printable
+
+    static boolean qpPrintable(int b) {
+        return b == '\t' || b == ' ' || (b >= 33 && b <= 126 && b != '=');
+    }
+
+    /** RFC 1521 rules 1 and 2 only: printable bytes literal, all others "=XX". */
+    static String qpEncodeLoose(byte[] data) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : data) {
+            int b = x & 0xff;
+            if (qpPrintable(b)) {
+                sb.append((char) b);
+            } else {
+                sb.append('=').append(hex2(b));
+            }
+        }
+        return sb.toString();
+    }
+
+    /** Decodes "=XX", drops soft line breaks "=\r\n" (and a bare "=\n"), ignores bare CR/LF; null when malformed. */
+    static byte[] qpDecode(byte[] enc) {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        for (int i = 0; i < enc.length; i++) {
+            int b = enc[i] & 0xff;
+            if (b == '=') {
+                if (i + 1 < enc.length && enc[i + 1] == '\r') {
+                    if (i + 2 < enc.length && enc[i + 2] == '\n') {
+                        i += 2;
+                    } else {
+                        i += 1;
+                    }
+                    continue;
+                }
+                // "=" followed by a bare LF is not a soft line break (RFC 1521 requires CRLF): malformed
+                if (i + 2 >= enc.length) {
+                    return null;
+                }
+                int hi = Character.digit(enc[i + 1], 16), lo = Character.digit(enc[i + 2], 16);
+                if (hi < 0 || lo < 0) {
+                    return null;
+                }
+                out.write(hi << 4 | lo);
+                i += 2;
+            } else if (b == '\r' || b == '\n') {
+                continue;
+            } else {
+                out.write(b);
+            }
+        }
+        return out.toByteArray();
+    }
+
+    @Test
+    void quotedPrintableFollowsRfc1521() {
+        Hegel.test(tc -> {
+            byte[] data = bytes(tc, 0, Zoo.chance(tc, 30) ? 250 : 40);
+            QuotedPrintableCodec loose = new QuotedPrintableCodec(false);
+            QuotedPrintableCodec strict = new QuotedPrintableCodec(true);
+            byte[] encLoose = loose.encode(data);
+            String wantLoose = qpEncodeLoose(data);
+            Zoo.check(ascii(encLoose).equals(wantLoose), () -> "QuotedPrintableCodec(false).encode(" + show(data) + ") = " + ascii(encLoose) + " but rules 1-2 give " + wantLoose);
+            Zoo.check(Arrays.equals(QuotedPrintableCodec.encodeQuotedPrintable(null, data), encLoose), () -> "encodeQuotedPrintable(null, data) differs from the non-strict instance for " + show(data));
+            try {
+                byte[] back = loose.decode(encLoose);
+                Zoo.check(Arrays.equals(back, data), () -> "QuotedPrintableCodec(false).decode(encode(" + show(data) + ")) = " + show(back));
+            } catch (DecoderException e) {
+                Zoo.fail("QuotedPrintableCodec.decode(" + ascii(encLoose) + ") threw " + e);
+            }
+            // strict: soft line breaks keep lines to 76 characters, no trailing white space, round trip
+            byte[] encStrict = strict.encode(data);
+            if (encStrict == null) {
+                // the class returns null for fewer than 3 bytes in strict mode (asserted by its own tests)
+                Zoo.check(data.length < 3, () -> "QuotedPrintableCodec(true).encode(" + show(data) + ") returned null");
+                Zoo.count("strict-null-short");
+            } else {
+                String s = ascii(encStrict);
+                String[] lines = s.split("\r\n", -1);
+                for (int i = 0; i < lines.length; i++) {
+                    String line = lines[i];
+                    boolean last = i == lines.length - 1;
+                    if (line.length() > 76 && line.length() <= 78 && line.endsWith("=")) {
+                        // known commons-codec/4: the safe-length bookkeeping lets a line grow to 77 or 78 characters
+                        Zoo.count("known commons-codec/4");
+                    } else {
+                        Zoo.check(line.length() <= 76, () -> "QuotedPrintableCodec(true).encode(" + show(data) + ") has a line of " + line.length() + " chars: " + line);
+                    }
+                    Zoo.check(last || line.endsWith("="), () -> "QuotedPrintableCodec(true).encode(" + show(data) + ") has a hard line break after: " + line);
+                    Zoo.check(line.isEmpty() || !(line.endsWith(" ") || line.endsWith("\t")), () -> "QuotedPrintableCodec(true).encode(" + show(data) + ") ends a line with white space: " + line);
+                    for (char c : line.toCharArray()) {
+                        Zoo.check(qpPrintable(c) || c == '=', () -> "QuotedPrintableCodec(true).encode(" + show(data) + ") emits a non-printable char " + (int) c + " in: " + line);
+                    }
+                }
+                byte[] modelBack = qpDecode(encStrict);
+                Zoo.check(modelBack != null && Arrays.equals(modelBack, data), () -> "the RFC decoding of QuotedPrintableCodec(true).encode(" + show(data) + ") = " + s + " gives " + (modelBack == null ? "malformed" : show(modelBack)));
+                try {
+                    byte[] back = strict.decode(encStrict);
+                    Zoo.check(Arrays.equals(back, data), () -> "QuotedPrintableCodec(true).decode(encode(" + show(data) + ")) = " + show(back) + " via " + s);
+                    byte[] backLoose = loose.decode(encStrict);
+                    Zoo.check(Arrays.equals(backLoose, data), () -> "QuotedPrintableCodec(false).decode of the strict encoding of " + show(data) + " = " + show(backLoose));
+                } catch (DecoderException e) {
+                    Zoo.fail("QuotedPrintableCodec.decode(" + s + ") threw " + e);
+                }
+                Zoo.count(s.contains("=\r\n") ? "strict-soft-breaks" : "strict-one-line");
+            }
+            // decoding arbitrary input against the RFC model
+            byte[] noisy = bytes(tc, 0, 20);
+            byte[] modelDecoded = qpDecode(noisy);
+            try {
+                byte[] got = QuotedPrintableCodec.decodeQuotedPrintable(noisy);
+                if (modelDecoded == null) {
+                    Zoo.fail("decodeQuotedPrintable(" + show(noisy) + ") = " + show(got) + " but the input has a malformed = escape");
+                } else {
+                    Zoo.check(Arrays.equals(got, modelDecoded), () -> "decodeQuotedPrintable(" + show(noisy) + ") = " + show(got) + " but the model gives " + show(modelDecoded));
+                }
+            } catch (DecoderException e) {
+                Zoo.check(modelDecoded == null, () -> "decodeQuotedPrintable(" + show(noisy) + ") threw " + e + " but the model decodes it to " + show(modelDecoded));
+            }
+            // Strings with a charset
+            String text = text(tc, 0, 30);
+            try {
+                String enc = loose.encode(text, StandardCharsets.UTF_8);
+                Zoo.check(enc.equals(qpEncodeLoose(text.getBytes(StandardCharsets.UTF_8))), () -> "QuotedPrintableCodec.encode(" + show(text) + ", UTF-8) = " + enc);
+                Zoo.check(loose.decode(enc, StandardCharsets.UTF_8).equals(text), () -> "QuotedPrintableCodec String round trip fails for " + show(text));
+            } catch (DecoderException e) {
+                Zoo.fail("QuotedPrintableCodec String round trip of " + show(text) + " threw " + e);
+            }
+        }, Zoo.settings("quotedPrintableFollowsRfc1521"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS quotedPrintableFollowsRfc1521 " + Zoo.stats());
+        }
+    }
+
+    // ---------------------------------------------------------------- RFC 1522 B and Q
+
+    static final String Q_PRINTABLE = " !\"#$%&'()*+,-./0123456789:;<>@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^`abcdefghijklmnopqrstuvwxyz{|}~";
+
+    static String qEncode(byte[] data, boolean blanks) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : data) {
+            int b = x & 0xff;
+            if (b == ' ' && blanks) {
+                sb.append('_');
+            } else if (b < 128 && Q_PRINTABLE.indexOf(b) >= 0) {
+                sb.append((char) b);
+            } else {
+                sb.append('=').append(hex2(b));
+            }
+        }
+        return sb.toString();
+    }
+
+    @Test
+    void bAndQCodecsProduceRfc1522EncodedWords() {
+        Hegel.test(tc -> {
+            Charset cs = Zoo.pick(tc, StandardCharsets.UTF_8, StandardCharsets.ISO_8859_1, StandardCharsets.UTF_16, StandardCharsets.US_ASCII);
+            String text = text(tc, 0, 30);
+            // keep the text representable in the charset
+            if (cs == StandardCharsets.ISO_8859_1) {
+                text = text.replaceAll("[^\\x00-\\xff]", "?");
+            } else if (cs == StandardCharsets.US_ASCII) {
+                text = text.replaceAll("[^\\x00-\\x7f]", "?");
+            }
+            String t = text;
+            byte[] raw = t.getBytes(cs);
+            BCodec b = new BCodec(cs);
+            try {
+                String enc = b.encode(t);
+                String want = "=?" + cs.name() + "?B?" + Base64.encodeBase64String(raw) + "?=";
+                Zoo.check(enc.equals(want), () -> "BCodec(" + cs + ").encode(" + show(t) + ") = " + enc + " but RFC 1522 B gives " + want);
+                String back = b.decode(enc);
+                Zoo.check(back.equals(t), () -> "BCodec(" + cs + ").decode(encode(" + show(t) + ")) = " + show(back));
+                // a codec with another default charset reads the header's charset
+                String otherBack = new BCodec(StandardCharsets.ISO_8859_1).decode(enc);
+                Zoo.check(otherBack.equals(t), () -> "BCodec(ISO-8859-1).decode(" + enc + ") = " + show(otherBack) + ", expected the header charset to win");
+                // lower-case encoding token is accepted
+                Zoo.check(b.decode(enc.replace("?B?", "?b?")).equals(t), () -> "BCodec rejects a lower-case ?b? token in " + enc);
+            } catch (EncoderException | DecoderException e) {
+                Zoo.fail("BCodec(" + cs + ") round trip of " + show(t) + " threw " + e);
+            }
+            boolean blanks = Zoo.chance(tc, 50);
+            QCodec q = new QCodec(cs);
+            q.setEncodeBlanks(blanks);
+            try {
+                String enc = q.encode(t);
+                String want = "=?" + cs.name() + "?Q?" + qEncode(raw, blanks) + "?=";
+                Zoo.check(enc.equals(want), () -> "QCodec(" + cs + ", blanks " + blanks + ").encode(" + show(t) + ") = " + enc + " but RFC 1522 Q gives " + want);
+                String back = q.decode(enc);
+                Zoo.check(back.equals(t), () -> "QCodec(" + cs + ", blanks " + blanks + ").decode(encode(" + show(t) + ")) = " + show(back) + " via " + enc);
+                QCodec other = new QCodec(cs);
+                other.setEncodeBlanks(!blanks);
+                Zoo.check(other.decode(enc).equals(t), () -> "QCodec with encodeBlanks " + !blanks + " cannot decode " + enc + " to " + show(t));
+            } catch (EncoderException | DecoderException e) {
+                Zoo.fail("QCodec(" + cs + ") round trip of " + show(t) + " threw " + e);
+            }
+            // malformed encoded words are DecoderExceptions, never anything else
+            String bad = Zoo.pick(tc, "=?UTF-8?B?", "?UTF-8?B?QQ==?=", "=?UTF-8?B?QQ==", "=??B?QQ==?=", "=?UTF-8??QQ==?=", "=?UTF-8?X?QQ==?=", "=?NOSUCH?B?QQ==?=", "=?UTF-8?Q?=ZZ?=", "=?UTF-8?B?Q?=", "=?UTF-8?B", "=?=", "=??=", "=?UTF-8?B?QQ==?=x", "=?UTF-8?Q?a=?=");
+            try {
+                String r = b.decode(bad);
+                Zoo.count("bad-word-decoded-B " + bad + " -> " + r);
+            } catch (DecoderException e) {
+                Zoo.count("bad-word-rejected-B");
+            } catch (RuntimeException e) {
+                Zoo.fail("BCodec.decode(" + show(bad) + ") threw " + e);
+            }
+            try {
+                String r = q.decode(bad);
+                Zoo.count("bad-word-decoded-Q " + bad + " -> " + r);
+            } catch (DecoderException e) {
+                Zoo.count("bad-word-rejected-Q");
+            } catch (RuntimeException e) {
+                Zoo.fail("QCodec.decode(" + show(bad) + ") threw " + e);
+            }
+        }, Zoo.settings("bAndQCodecsProduceRfc1522EncodedWords"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS bAndQCodecsProduceRfc1522EncodedWords " + Zoo.stats());
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..3a4b425
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,128 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    private static final java.util.Map<String, Integer> STATS = new java.util.TreeMap<>();
+
+    /** Bumps a statistic; the counts are printed in collect mode (ZOO_COLLECT=1) via {@link #stats()}. */
+    static synchronized void count(String key) {
+        STATS.merge(key, 1, Integer::sum);
+    }
+
+    /** The statistics so far, cleared, as one line. */
+    static synchronized String stats() {
+        String s = STATS.toString();
+        STATS.clear();
+        return s;
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
