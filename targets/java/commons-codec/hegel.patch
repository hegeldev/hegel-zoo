+    @Test
+    void lenientDecodingIgnoresNoiseAndStrictRejectsBadTrailingBits() {
+        Hegel.test(tc -> {
+            byte[] d = bytes(tc, 0, 40);
+            String ctx = " for " + show(d);
+            boolean is64 = chance(tc, 55);
+            int bits = is64 ? 6 : 5;
+            String alphabet = is64 ? B64 : B32;
+            BaseNCodec lenient = is64 ? new Base64() : new Base32();
+            BaseNCodec strict = is64 ? Base64.builder().setDecodingPolicy(CodecPolicy.STRICT).get() : Base32.builder().setDecodingPolicy(CodecPolicy.STRICT).get();
+            String clean = rfc4648(d, alphabet, bits, true, '=');
+            String name = is64 ? "Base64" : "Base32";
+
+            // noise anywhere before the padding is ignored by the lenient decoder
+            StringBuilder noisy = new StringBuilder();
+            int firstPad = clean.indexOf('=') < 0 ? clean.length() : clean.indexOf('=');
+            for (int i = 0; i < clean.length(); i++) {
+                if (i <= firstPad && chance(tc, 25)) {
+                    noisy.append(noise(tc));
+                }
+                noisy.append(clean.charAt(i));
+            }
+            if (chance(tc, 50)) {
+                noisy.append(noise(tc));
+            }
+            String ns = noisy.toString();
+            byte[] got = lenient.decode(ns);
+            check(Arrays.equals(got, d), () -> name + " lenient decode of " + show(ns) + " = " + show(got) + ctx);
+            count("noisy");
+
+            // padding may be dropped or doubled for the lenient decoder; the strict decoder (since 8b506a1)
+            // requires the canonical padding of its own padded encoder
+            String unpadded = clean.replace("=", "");
+            check(Arrays.equals(lenient.decode(unpadded), d), () -> name + " lenient decode of the unpadded " + show(unpadded) + " differs" + ctx);
+            check(Arrays.equals(lenient.decode(clean + "=="), d), () -> name + " decode with extra padding differs" + ctx);
+            check(Arrays.equals(strict.decode(clean), d), () -> name + " strict decode of the canonical " + show(clean) + " differs" + ctx);
+            if (unpadded.equals(clean)) {
+                count("no-padding");
+            } else {
+                try {
+                    byte[] strictGot = strict.decode(unpadded);
+                    fail(name + " strict decode of the unpadded " + show(unpadded) + " returned " + show(strictGot) + " instead of rejecting the missing padding" + ctx);
+                } catch (IllegalArgumentException expected) {
+                    count("strict-rejected-unpadded");
+                }
+                try {
+                    byte[] strictGot = strict.decode(clean + "==");
+                    fail(name + " strict decode of the over-padded " + show(clean + "==") + " returned " + show(strictGot) + ctx);
+                } catch (IllegalArgumentException expected) {
+                    count("strict-rejected-overpadded");
+                }
+            }
+
+            // a last character whose discarded bits are not zero: lenient reads the data, strict throws
+            int lastIdx = firstPad - 1;
+            int discarded = (clean.length() % (is64 ? 4 : 8) == 0 && firstPad == clean.length()) ? 0 : (firstPad * bits) - d.length * 8;
+            if (lastIdx >= 0 && discarded > 0) {
+                int value = alphabet.indexOf(clean.charAt(lastIdx));
+                int mask = (1 << discarded) - 1;
+                int bad = value | n(tc, 1, mask);
+                String corrupt = clean.substring(0, lastIdx) + alphabet.charAt(bad) + clean.substring(lastIdx + 1);
+                byte[] lenientGot = lenient.decode(corrupt);
+                check(Arrays.equals(lenientGot, d), () -> name + " lenient decode of " + show(corrupt) + " (dirty trailing bits) = " + show(lenientGot) + ", expected the data" + ctx);
+                try {
+                    byte[] strictGot = strict.decode(corrupt);
+                    fail(name + " strict decode of " + show(corrupt) + " (dirty trailing bits) returned " + show(strictGot) + " instead of throwing" + ctx);
+                } catch (IllegalArgumentException expected) {
+                    count("strict-rejected");
+                }
+            }
+            // a lone trailing character can never carry a byte: strict throws, lenient drops it
+            String dangling = unpadded + alphabet.charAt(n(tc, 0, alphabet.length() - 1));
+            if (!is64 && (unpadded.length() + 1) % 8 == 1) {
+                // commons-codec/2: the lenient Base32 decoder turns a dangling character into a byte
+                count("known commons-codec/2");
+            } else if ((unpadded.length() + 1) * bits / 8 == d.length) {
+                byte[] lenientGot = lenient.decode(dangling);
+                check(Arrays.equals(lenientGot, d), () -> name + " lenient decode of " + show(dangling) + " (dangling character) = " + show(lenientGot) + ctx);
+                try {
+                    byte[] strictGot = strict.decode(dangling);
+                    fail(name + " strict decode of " + show(dangling) + " (dangling character) returned " + show(strictGot) + ctx);
+                } catch (IllegalArgumentException expected) {
+                    count("dangling-rejected");
+                }
+            }
+        }, Zoo.settings("lenientDecodingIgnoresNoiseAndStrictRejectsBadTrailingBits"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS lenientDecodingIgnoresNoiseAndStrictRejectsBadTrailingBits " + Zoo.stats());
+        }
+    }
