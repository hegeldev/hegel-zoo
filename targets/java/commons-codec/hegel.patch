+    @Test
+    void blake3IsConsistentAcrossItsEntryPoints() {
+        assertEquals("af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262", hex(Blake3.hash(new byte[0])));
+        Hegel.test(tc -> {
+            // lengths around the 64-byte block and 1024-byte chunk boundaries matter to a tree hash
+            int n = Zoo.chance(tc, 40) ? Zoo.pick(tc, 0, 1, 63, 64, 65, 1023, 1024, 1025, 2047, 2048, 2049, 3072, 4096) : Zoo.n(tc, 0, 2500);
+            byte[] data = new byte[n];
+            for (int i = 0; i < n; i++) {
+                data[i] = (byte) Zoo.n(tc, 0, 255);
+            }
+            byte[] one = Blake3.hash(data);
+            Zoo.check(one.length == 32, () -> "Blake3.hash returns " + one.length + " bytes");
+            // incremental over random chunks
+            Blake3 h = Blake3.initHash();
+            int at = 0;
+            List<Integer> chunks = new ArrayList<>();
+            while (at < n) {
+                int c = Zoo.chance(tc, 30) ? Zoo.pick(tc, 0, 1, 63, 64, 65, 1024) : Zoo.n(tc, 0, 1100);
+                c = Math.min(c, n - at);
+                chunks.add(c);
+                h.update(data, at, c);
+                at += c;
+            }
+            int out = Zoo.pick(tc, 0, 1, 31, 32, 33, 64, 100, 200);
+            byte[] xof = h.doFinalize(out);
+            Zoo.check(xof.length == out && Arrays.equals(Arrays.copyOf(xof, Math.min(out, 32)), Arrays.copyOf(one, Math.min(out, 32))),
+                () -> "Blake3 incremental (chunks " + chunks + ") doFinalize(" + out + ") = " + show(xof) + " does not extend Blake3.hash = " + show(one) + " for " + n + " bytes");
+            // the same output through the out/offset/length form
+            byte[] buf = new byte[out + 7];
+            Blake3.initHash().update(data).doFinalize(buf, 3, out);
+            Zoo.check(Arrays.equals(Arrays.copyOfRange(buf, 3, 3 + out), xof) && buf[0] == 0 && buf[out + 6] == 0, () -> "Blake3.doFinalize(out, 3, " + out + ") wrote " + show(buf) + " for " + n + " bytes, expected " + show(xof));
+            // reset gives the same as a new instance
+            h.reset();
+            h.update(data);
+            Zoo.check(Arrays.equals(h.doFinalize(32), one), () -> "Blake3.reset() then update does not reproduce Blake3.hash for " + n + " bytes");
+            // keyed hash: 32-byte key; differs from the plain hash; consistent between entry points
+            byte[] key = new byte[32];
+            for (int i = 0; i < 32; i++) {
+                key[i] = (byte) Zoo.n(tc, 0, 255);
+            }
+            byte[] mac = Blake3.keyedHash(key, data);
+            Zoo.check(Arrays.equals(mac, Blake3.initKeyedHash(key).update(data).doFinalize(32)), () -> "Blake3.keyedHash and initKeyedHash disagree for " + n + " bytes");
+            Zoo.check(!Arrays.equals(mac, one), () -> "Blake3.keyedHash equals the plain hash for " + n + " bytes");
+            byte[] shortKey = new byte[Zoo.pick(tc, 0, 16, 31, 33, 64)];
+            try {
+                Blake3.initKeyedHash(shortKey);
+                Zoo.fail("Blake3.initKeyedHash accepted a " + shortKey.length + "-byte key");
+            } catch (IllegalArgumentException e) {
+                Zoo.count("short-key-rejected");
+            }
+            // KDF: successive finalizations continue the output stream
+            Blake3 kdf = Blake3.initKeyDerivationFunction(("ctx " + n).getBytes(StandardCharsets.UTF_8)).update(data);
+            byte[] first = kdf.doFinalize(16);
+            byte[] second = kdf.doFinalize(16);
+            byte[] both = Blake3.initKeyDerivationFunction(("ctx " + n).getBytes(StandardCharsets.UTF_8)).update(data).doFinalize(32);
+            Zoo.check(Arrays.equals(Arrays.copyOf(both, 16), first), () -> "Blake3 KDF: the first doFinalize(16) " + hex(first) + " is not the start of doFinalize(32) " + hex(both));
+            if (Arrays.equals(second, first)) {
+                // known commons-codec/3: every doFinalize restarts the output stream at block 0
+                Zoo.count("known commons-codec/3");
+            } else {
+                Zoo.check(Arrays.equals(Arrays.copyOfRange(both, 16, 32), second), () -> "Blake3 KDF: the second doFinalize(16) " + hex(second) + " is not the continuation of doFinalize(32) " + hex(both));
+            }
+        }, Zoo.settings("blake3IsConsistentAcrossItsEntryPoints"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS blake3IsConsistentAcrossItsEntryPoints " + Zoo.stats());
+        }
+    }
