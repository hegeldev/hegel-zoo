+            Zoo.check(MurmurHash3.hash32(a) == murmur3x86(one, 0, 8, 104729), () -> "hash32(long " + a + ") disagrees with hash32x86 of its big-endian bytes at seed 104729");
+            Zoo.check(MurmurHash3.hash32(a, seed) == murmur3x86(one, 0, 8, seed), () -> "hash32(long " + a + ", seed " + seed + ") disagrees with hash32x86 of its big-endian bytes");
+            Zoo.check(MurmurHash3.hash32(a, b) == murmur3x86(two, 0, 16, 104729), () -> "hash32(long " + a + ", long " + b + ") disagrees with hash32x86 of their big-endian bytes");
+            Zoo.check(MurmurHash3.hash32(a, b, seed) == murmur3x86(two, 0, 16, seed), () -> "hash32(long " + a + ", long " + b + ", seed " + seed + ") disagrees with hash32x86 of their big-endian bytes");
+            // the legacy hash32 is documented as agreeing when no trailing byte is negative
+            boolean tailNonNegative = true;
+            for (int i = len - len % 4; i < len; i++) {
+                tailNonNegative &= window[i] >= 0;
+            }
+            if (tailNonNegative) {
+                @SuppressWarnings("deprecation")
+                int legacy = MurmurHash3.hash32(window, len, seed);
+                Zoo.check(legacy == m3Want, () -> "legacy hash32(" + show(window) + ", seed " + seed + ") = " + Integer.toHexString(legacy) + " with no negative trailing byte, reference " + Integer.toHexString(m3Want));
+            }
