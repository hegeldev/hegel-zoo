+    // ---------------------------------------------------------------- CRCs
+
+    /** A reflected CRC-16 (refin = refout = true) with the given reflected polynomial. */
+    static int crc16(byte[] data, int polyReflected, int init, int xorOut) {
+        int crc = init;
+        for (byte b : data) {
+            crc ^= b & 0xff;
+            for (int i = 0; i < 8; i++) {
+                crc = (crc & 1) != 0 ? (crc >>> 1) ^ polyReflected : crc >>> 1;
+            }
+        }
+        return (crc ^ xorOut) & 0xffff;
+    }
+
+    record Crc16Kind(String name, int poly, int init, int xorOut, int check, java.util.function.Supplier<Crc16> make) {
+    }
+
+    static final List<Crc16Kind> CRC16S = List.of(
+        new Crc16Kind("arc", 0xA001, 0x0000, 0x0000, 0xBB3D, Crc16::arc),
+        new Crc16Kind("ccitt/kermit", 0x8408, 0x0000, 0x0000, 0x2189, Crc16::ccitt),
+        new Crc16Kind("dnp", 0xA6BC, 0x0000, 0xFFFF, 0xEA82, Crc16::dnp),
+        new Crc16Kind("ibm-sdlc/x-25", 0x8408, 0xFFFF, 0xFFFF, 0x906E, Crc16::ibmSdlc),
+        new Crc16Kind("maxim-dow", 0xA001, 0x0000, 0xFFFF, 0x44C2, Crc16::maxim),
+        new Crc16Kind("mcrf4xx", 0x8408, 0xFFFF, 0x0000, 0x6F91, Crc16::mcrf4xx),
+        new Crc16Kind("modbus", 0xA001, 0xFFFF, 0x0000, 0x4B37, Crc16::modbus),
+        new Crc16Kind("nrsc-5", 0xD010, 0xFFFF, 0x0000, 0xA066, Crc16::nrsc5),
+        new Crc16Kind("usb", 0xA001, 0xFFFF, 0xFFFF, 0xB4C8, Crc16::usb));
+
+    @Test
+    void crcsMatchTheJdkAndTheCatalogue() {
+        byte[] check = "123456789".getBytes(StandardCharsets.US_ASCII);
+        for (Crc16Kind k : CRC16S) {
+            assertEquals(k.check(), crc16(check, k.poly(), k.init(), k.xorOut()), "model of " + k.name());
+        }
+        Hegel.test(tc -> {
+            byte[] data = bytes(tc, 0, 200);
+            // chunked updates shared by all checksums
+            List<int[]> chunks = new ArrayList<>();
+            int at = 0;
+            while (at < data.length) {
+                int n = Zoo.n(tc, 0, Math.min(50, data.length - at));
+                chunks.add(new int[] {at, n});
+                at += n;
+            }
+            java.util.function.Consumer<java.util.zip.Checksum> feed = c -> {
+                for (int[] ch : chunks) {
+                    if (ch[1] == 1 && (ch[0] & 1) == 0) {
+                        c.update(data[ch[0]]);
+                    } else {
+                        c.update(data, ch[0], ch[1]);
+                    }
+                }
+            };
+            CRC32 jdk32 = new CRC32();
+            feed.accept(jdk32);
+            PureJavaCrc32 pj32 = new PureJavaCrc32();
+            feed.accept(pj32);
+            Zoo.check(pj32.getValue() == jdk32.getValue(), () -> "PureJavaCrc32 of " + show(data) + " = " + Long.toHexString(pj32.getValue()) + " but java.util.zip.CRC32 gives " + Long.toHexString(jdk32.getValue()));
+            CRC32C jdk32c = new CRC32C();
+            feed.accept(jdk32c);
+            PureJavaCrc32C pj32c = new PureJavaCrc32C();
+            feed.accept(pj32c);
+            Zoo.check(pj32c.getValue() == jdk32c.getValue(), () -> "PureJavaCrc32C of " + show(data) + " = " + Long.toHexString(pj32c.getValue()) + " but java.util.zip.CRC32C gives " + Long.toHexString(jdk32c.getValue()));
+            pj32.reset();
+            Zoo.check(pj32.getValue() == 0, () -> "PureJavaCrc32.reset() leaves " + pj32.getValue());
+            pj32c.reset();
+            Zoo.check(pj32c.getValue() == 0, () -> "PureJavaCrc32C.reset() leaves " + pj32c.getValue());
+
+            Crc16Kind k = Zoo.pick(tc, CRC16S.toArray(new Crc16Kind[0]));
+            Crc16 crc = k.make().get();
+            feed.accept(crc);
+            long got = crc.getValue();
+            int want = crc16(data, k.poly(), k.init(), k.xorOut());
+            Zoo.check(got == want, () -> "Crc16." + k.name() + " of " + show(data) + " = " + Long.toHexString(got) + " but the catalogue parameters give " + Integer.toHexString(want));
+            crc.reset();
+            long fresh = k.make().get().getValue();
+            Zoo.check(crc.getValue() == fresh, () -> "Crc16." + k.name() + ".reset() leaves " + Long.toHexString(crc.getValue()) + ", a new instance has " + Long.toHexString(fresh));
+            Zoo.check(fresh == ((k.init() ^ k.xorOut()) & 0xffff), () -> "a fresh Crc16." + k.name() + " has value " + Long.toHexString(fresh) + ", expected init ^ xorOut = " + Integer.toHexString((k.init() ^ k.xorOut()) & 0xffff));
+            // the builder with the published table and parameters agrees
+            int[] table = switch (k.name()) {
+                case "arc" -> Crc16.getArcTable();
+                case "ccitt/kermit" -> Crc16.getCcittTable();
+                case "dnp" -> Crc16.getDnpTable();
+                case "ibm-sdlc/x-25" -> Crc16.getIbmSdlcTable();
+                case "maxim-dow" -> Crc16.getMaximTable();
+                case "mcrf4xx" -> Crc16.getMcrf4xxTable();
+                case "modbus" -> Crc16.getModbusTable();
+                case "nrsc-5" -> Crc16.getNrsc5Table();
+                default -> Crc16.getModbusTable();
+            };
+            Crc16 built = Crc16.builder().setTable(table).setInit(k.init()).setXorOut(k.xorOut()).get();
+            feed.accept(built);
+            Zoo.check(built.getValue() == want, () -> "Crc16.builder() with the " + k.name() + " table, init " + Integer.toHexString(k.init()) + " and xorOut " + Integer.toHexString(k.xorOut()) + " gives " + Long.toHexString(built.getValue()) + " for " + show(data) + ", expected " + Integer.toHexString(want));
+        }, Zoo.settings("crcsMatchTheJdkAndTheCatalogue"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS crcsMatchTheJdkAndTheCatalogue " + Zoo.stats());
+        }
+    }
