+package zoo;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.util.Locale;
+import java.util.regex.Pattern;
+import org.apache.commons.codec.EncoderException;
+import org.apache.commons.codec.language.Caverphone1;
+import org.apache.commons.codec.language.Caverphone2;
+import org.apache.commons.codec.language.ColognePhonetic;
+import org.apache.commons.codec.language.DaitchMokotoffSoundex;
+import org.apache.commons.codec.language.DoubleMetaphone;
+import org.apache.commons.codec.language.MatchRatingApproachEncoder;
+import org.apache.commons.codec.language.Metaphone;
+import org.apache.commons.codec.language.Nysiis;
+import org.apache.commons.codec.language.RefinedSoundex;
+import org.apache.commons.codec.language.Soundex;
+import org.apache.commons.codec.language.bm.BeiderMorseEncoder;
+import org.apache.commons.codec.language.bm.NameType;
+import org.apache.commons.codec.language.bm.RuleType;
+import org.junit.jupiter.api.Test;
+
+/**
+ * org.apache.commons.codec.language: Soundex, Refined Soundex and the Kölner Phonetik against models of the
+ * algorithms as the classes document them; laws for the encoders whose specifications are too long to model
+ * here (Metaphone, Double Metaphone, Caverphone, NYSIIS, Daitch-Mokotoff, Match Rating, Beider-Morse).
+ */
+class LanguageTest {
+
+    static final String LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+
+    /** A word of letters, mostly A-Z in mixed case, sometimes with punctuation, digits, spaces or accented letters. */
+    static String name(TestCase tc, boolean fancy) {
+        StringBuilder sb = new StringBuilder();
+        int n = Zoo.n(tc, 0, 12);
+        for (int i = 0; i < n; i++) {
+            int r = Zoo.n(tc, 0, 99);
+            if (r < 80 || !fancy) {
+                char c = LETTERS.charAt(Zoo.chance(tc, 40) ? Zoo.pick(tc, 0, 4, 8, 14, 20, 7, 22, 24, 2, 18, 19, 3) : Zoo.n(tc, 0, 25));
+                sb.append(Zoo.chance(tc, 50) ? Character.toLowerCase(c) : c);
+            } else if (r < 92) {
+                sb.append(Zoo.pick(tc, " ", "-", "'", ".", "1", ","));
+            } else {
+                sb.append(Zoo.pick(tc, "é", "ü", "Ä", "Ö", "ß", "ñ"));
+            }
+        }
+        return sb.toString();
+    }
+
+    static String show(Object o) {
+        return Zoo.show(o);
+    }
+
+    /** SoundexUtils.clean as documented: only letters, upper-cased. */
+    static String clean(String s) {
+        StringBuilder sb = new StringBuilder();
+        for (char c : s.toCharArray()) {
+            if (Character.isLetter(c)) {
+                sb.append(c);
+            }
+        }
+        return sb.toString().toUpperCase(Locale.ENGLISH);
+    }
+
+    // ---------------------------------------------------------------- Soundex
+
+    /**
+     * The documented algorithm: first letter, then the codes of the following letters, dropping vowels (code 0),
+     * silent letters and a code equal to the previous letter's code; 0 acts as a separator, silent letters do not;
+     * with specialCaseHW the letters H and W are silent (skipped without touching the previous code).
+     */
+    static char map(String mapping, char ch) {
+        if (ch < 'A' || ch > 'Z') {
+            throw new IllegalArgumentException("not mapped: " + ch);
+        }
+        return mapping.charAt(ch - 'A');
+    }
+
+    static String soundex(String cleaned, String mapping, boolean specialCaseHW) {
+        if (cleaned.isEmpty()) {
+            return "";
+        }
+        StringBuilder out = new StringBuilder();
+        out.append(cleaned.charAt(0));
+        char last = map(mapping, cleaned.charAt(0));
+        for (int i = 1; i < cleaned.length() && out.length() < 4; i++) {
+            char ch = cleaned.charAt(i);
+            if (specialCaseHW && (ch == 'H' || ch == 'W')) {
+                continue;
+            }
+            char code = map(mapping, ch);
+            if (code == '-') {
+                continue;
+            }
+            if (code != '0' && code != last) {
+                out.append(code);
+            }
+            last = code;
+        }
+        while (out.length() < 4) {
+            out.append('0');
+        }
+        return out.toString();
+    }
+
+    static boolean allAtoZ(String s) {
+        return s.chars().allMatch(c -> c >= 'A' && c <= 'Z');
+    }
+
+    @Test
+    void soundexVariantsMatchTheirDocumentedRules() {
+        Hegel.test(tc -> {
+            String raw = name(tc, true);
+            String cleaned = clean(raw);
+            int variant = Zoo.n(tc, 0, 2);
+            Soundex codec = variant == 0 ? Soundex.US_ENGLISH : variant == 1 ? Soundex.US_ENGLISH_SIMPLIFIED : Soundex.US_ENGLISH_GENEALOGY;
+            String label = variant == 0 ? "US_ENGLISH" : variant == 1 ? "US_ENGLISH_SIMPLIFIED" : "US_ENGLISH_GENEALOGY";
+            String mapping = variant == 2 ? "-123-12--22455-12623-1-2-2" : "01230120022455012623010202";
+            boolean hw = variant == 0;
+            String want;
+            try {
+                want = soundex(cleaned, mapping, hw);
+            } catch (IllegalArgumentException unmapped) {
+                // a letter outside A-Z is reached before the code is complete: the class documents the exception
+                try {
+                    String got = codec.soundex(raw);
+                    Zoo.fail("Soundex." + label + ".soundex(" + show(raw) + ") = " + got + " although a letter is not mapped");
+                } catch (IllegalArgumentException e) {
+                    Zoo.count("unmapped-rejected");
+                }
+                return;
+            }
+            String got = codec.soundex(raw);
+            Zoo.check(got.equals(want), () -> "Soundex." + label + ".soundex(" + show(raw) + ") = " + got + " but the documented rules give " + want);
+            Zoo.check(codec.encode(raw).equals(got), () -> "Soundex.encode differs from soundex for " + show(raw));
+            if (variant == 0) {
+                Zoo.check(new Soundex().soundex(raw).equals(got), () -> "new Soundex() differs from US_ENGLISH for " + show(raw));
+            }
+            // difference counts equal positions
+            String other = name(tc, false);
+            if (!allAtoZ(cleaned)) {
+                Zoo.count("unmapped-after-full-code");
+                return;
+            }
+            String otherCode = codec.soundex(other);
+            int same = 0;
+            for (int i = 0; i < Math.min(got.length(), otherCode.length()); i++) {
+                same += got.charAt(i) == otherCode.charAt(i) ? 1 : 0;
+            }
+            int diff;
+            try {
+                diff = codec.difference(raw, other);
+            } catch (EncoderException e) {
+                throw new RuntimeException(e);
+            }
+            Zoo.check(diff == same, () -> "Soundex." + label + ".difference(" + show(raw) + ", " + show(other) + ") = " + diff + " for codes " + got + " and " + otherCode);
+            // Refined Soundex: every letter's code, consecutive duplicates dropped, first letter kept
+            String refinedMapping = "01360240043788015936020505";
+            StringBuilder r = new StringBuilder();
+            if (!cleaned.isEmpty()) {
+                r.append(cleaned.charAt(0));
+                char last = '*';
+                for (char ch : cleaned.toCharArray()) {
+                    char code = ch >= 'A' && ch <= 'Z' ? refinedMapping.charAt(ch - 'A') : 0;
+                    if (code != last && code != 0) {
+                        r.append(code);
+                    }
+                    last = code;
+                }
+            }
+            String refined = RefinedSoundex.US_ENGLISH.soundex(raw);
+            Zoo.check(refined.equals(r.toString()), () -> "RefinedSoundex.soundex(" + show(raw) + ") = " + refined + " but the documented mapping gives " + r);
+        }, Zoo.settings("soundexVariantsMatchTheirDocumentedRules"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS soundexVariantsMatchTheirDocumentedRules " + Zoo.stats());
+        }
+    }
+
+    // ---------------------------------------------------------------- Kölner Phonetik
+
+    static String colognePreprocess(String s) {
+        StringBuilder sb = new StringBuilder();
+        for (char c : s.toUpperCase(Locale.GERMAN).toCharArray()) {
+            switch (c) {
+                case 'Ä' -> sb.append('A');
+                case 'Ö' -> sb.append('O');
+                case 'Ü' -> sb.append('U');
+                case 'ß' -> sb.append('S');
+                default -> {
+                    if (c >= 'A' && c <= 'Z') {
+                        sb.append(c);
+                    }
+                }
+            }
+        }
+        return sb.toString();
+    }
+
+    /** The input as the encoder sees it after its own preprocessing, with the characters it ignores removed. */
+    static String cologneKept(String s) {
+        StringBuilder sb = new StringBuilder();
+        for (char c : s.toUpperCase(Locale.GERMAN).toCharArray()) {
+            switch (c) {
+                case '\u00C4' -> sb.append('A');
+                case '\u00D6' -> sb.append('O');
+                case '\u00DC' -> sb.append('U');
+                default -> {
+                    if (c >= 'A' && c <= 'Z') {
+                        sb.append(c);
+                    }
+                }
+            }
+        }
+        return sb.toString();
+    }
+
+    /** The documented rule table, applied letter by letter with the previous and next letters as context. */
+    static String cologneRaw(String w) {
+        StringBuilder out = new StringBuilder();
+        for (int i = 0; i < w.length(); i++) {
+            char c = w.charAt(i);
+            char prev = i > 0 ? w.charAt(i - 1) : ' ';
+            char next = i + 1 < w.length() ? w.charAt(i + 1) : ' ';
+            switch (c) {
+                case 'A', 'E', 'I', 'J', 'O', 'U', 'Y' -> out.append('0');
+                case 'H' -> {
+                }
+                case 'B' -> out.append('1');
+                case 'P' -> out.append(next == 'H' ? '3' : '1');
+                case 'D', 'T' -> out.append("CSZ".indexOf(next) >= 0 ? '8' : '2');
+                case 'F', 'V', 'W' -> out.append('3');
+                case 'G', 'K', 'Q' -> out.append('4');
+                case 'C' -> {
+                    if (i == 0) {
+                        out.append("AHKLOQRUX".indexOf(next) >= 0 ? '4' : '8');
+                    } else if ("SZ".indexOf(prev) >= 0) {
+                        out.append('8');
+                    } else {
+                        out.append("AHKOQUX".indexOf(next) >= 0 ? '4' : '8');
+                    }
+                }
+                case 'X' -> out.append("CKQ".indexOf(prev) >= 0 ? "8" : "48");
+                case 'L' -> out.append('5');
+                case 'M', 'N' -> out.append('6');
+                case 'R' -> out.append('7');
+                case 'S', 'Z' -> out.append('8');
+                default -> throw new IllegalStateException("letter " + c);
+            }
+        }
+        return out.toString();
+    }
+
+    static String cologne(String input) {
+        String w = colognePreprocess(input);
+        String raw = cologneRaw(w);
+        StringBuilder collapsed = new StringBuilder();
+        for (char c : raw.toCharArray()) {
+            if (collapsed.length() == 0 || collapsed.charAt(collapsed.length() - 1) != c) {
+                collapsed.append(c);
+            }
+        }
+        StringBuilder out = new StringBuilder();
+        for (int i = 0; i < collapsed.length(); i++) {
+            if (i == 0 || collapsed.charAt(i) != '0') {
+                out.append(collapsed.charAt(i));
+            }
+        }
+        return out.toString();
+    }
+
+    @Test
+    void colognePhoneticMatchesTheDocumentedTable() {
+        Hegel.test(tc -> {
+            String raw = name(tc, true);
+            String w = colognePreprocess(raw);
+            String want = cologne(raw);
+            ColognePhonetic codec = new ColognePhonetic();
+            String got = codec.colognePhonetic(raw);
+            if (!got.equals(want)) {
+                // known commons-codec/6: the context rules see characters the encoder itself ignores - punctuation,
+                // digits, letters outside A-Z after the umlaut mapping (step 1 removes them all)
+                String lettersOnly = raw.replaceAll("[^\\p{L}]", "");
+                String kept = cologneKept(raw);
+                if ((!lettersOnly.equals(raw) && !codec.colognePhonetic(lettersOnly).equals(got))
+                        || (!kept.equals(raw.toUpperCase(Locale.GERMAN)) && !codec.colognePhonetic(kept).equals(got))) {
+                    Zoo.count("known commons-codec/6");
+                    return;
+                }
+                // a code repeated across a vowel (X 0 X) is collapsed to X: the class's own tests want that
+                // ("hoffmann" is 036, "Celsius" 858) although its Javadoc describes the opposite order of the
+                // collapsing and 0-removal steps; not counted as a bug
+                String rawCodesW = cologneRaw(w);
+                if (rawCodesW.matches(".*([1-9])0+\\1.*") || rawCodesW.matches(".*8?48.*0+48.*") ) {
+                    Zoo.count("ambiguous-code-repeated-across-vowel");
+                    return;
+                }
+                // two readings the documents leave open: is a letter "at the onset" when only an H precedes it, and
+                // does an H (which has no code) separate two equal codes for the collapsing step?
+                String noH = w.replace("H", "");
+                boolean hOnset = w.startsWith("H") && w.length() > 1 && w.charAt(1) == 'C';
+                boolean hBetween = false;
+                String rawCodes = cologneRaw(w);
+                for (int i = 1; i + 1 < w.length(); i++) {
+                    if (w.charAt(i) == 'H') {
+                        String left = cologneRaw(w.substring(0, i));
+                        String right = cologneRaw(w.substring(i + 1));
+                        hBetween |= !left.isEmpty() && !right.isEmpty() && left.charAt(left.length() - 1) == right.charAt(0);
+                    }
+                }
+                if (hOnset || hBetween || w.indexOf('H') >= 0) {
+                    Zoo.count(hOnset ? "ambiguous-H-onset" : hBetween ? "ambiguous-H-between-equal-codes" : "ambiguous-H-other");
+                    if (!hOnset && !hBetween) {
+                        Zoo.fail("colognePhonetic(" + show(raw) + ") = " + got + " but the documented table gives " + want + " (codes " + rawCodes + ", not an H ambiguity)");
+                    }
+                    return;
+                }
+                Zoo.fail("colognePhonetic(" + show(raw) + ") = " + got + " but the documented table gives " + want + " (raw codes " + rawCodes + ")");
+            }
+            Zoo.check(codec.encode(raw).equals(got), () -> "ColognePhonetic.encode differs from colognePhonetic for " + show(raw));
+            Zoo.check(codec.isEncodeEqual(raw, raw.toLowerCase(Locale.GERMAN)), () -> "ColognePhonetic is case sensitive for " + show(raw));
+        }, Zoo.settings("colognePhoneticMatchesTheDocumentedTable"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS colognePhoneticMatchesTheDocumentedTable " + Zoo.stats());
+        }
+    }
+
+    // ---------------------------------------------------------------- laws for the long specifications
+
+    static final Pattern BM_SHAPE = Pattern.compile("[A-Za-z|()\\-]*");
+
+    @Test
+    void phoneticEncodersObeyTheirStatedShapes() {
+        Hegel.test(tc -> {
+            String raw = name(tc, false);
+            String cleaned = clean(raw);
+            String other = name(tc, false);
+            // Metaphone: A-Z input, code of at most maxCodeLen chars; a shorter maximum truncates
+            Metaphone m = new Metaphone();
+            String code = m.metaphone(raw);
+            Zoo.check(code.length() <= 4 && code.chars().allMatch(c -> (c >= 'A' && c <= 'Z') || c == '0'), () -> "metaphone(" + show(raw) + ") = " + show(code));
+            Zoo.check(m.metaphone(raw.toLowerCase(Locale.ENGLISH)).equals(code), () -> "metaphone is case sensitive for " + show(raw));
+            Zoo.check(m.isMetaphoneEqual(raw, other) == code.equals(m.metaphone(other)), () -> "isMetaphoneEqual disagrees with metaphone for " + show(raw) + ", " + show(other));
+            Metaphone longer = new Metaphone();
+            longer.setMaxCodeLen(10);
+            String longCode = longer.metaphone(raw);
+            Zoo.check(longCode.startsWith(code) && (longCode.length() <= 10), () -> "metaphone(" + show(raw) + ") with max 10 = " + longCode + " does not extend the 4-char code " + code);
+            Zoo.check(code.length() == 4 || longCode.equals(code), () -> "metaphone(" + show(raw) + ") = " + code + " is shorter than 4 yet the 10-char code is " + longCode);
+            // Double Metaphone
+            DoubleMetaphone dm = new DoubleMetaphone();
+            String primary = dm.doubleMetaphone(raw);
+            String alternate = dm.doubleMetaphone(raw, true);
+            if (raw.isBlank()) {
+                Zoo.check(primary == null || primary.isEmpty(), () -> "doubleMetaphone(" + show(raw) + ") = " + show(primary));
+            } else {
+                Zoo.check(primary != null && primary.length() <= 4 && primary.chars().allMatch(c -> (c >= 'A' && c <= 'Z') || c == '0'), () -> "doubleMetaphone(" + show(raw) + ") = " + show(primary));
+                Zoo.check(alternate != null && alternate.length() <= 4, () -> "doubleMetaphone(" + show(raw) + ", alternate) = " + show(alternate));
+                Zoo.check(dm.doubleMetaphone(raw, false).equals(primary), () -> "doubleMetaphone(x, false) differs from doubleMetaphone(x) for " + show(raw));
+                Zoo.check(dm.isDoubleMetaphoneEqual(raw, other) == primary.equals(dm.doubleMetaphone(other)), () -> "isDoubleMetaphoneEqual disagrees with the primary codes for " + show(raw) + ", " + show(other));
+                Zoo.check(dm.isDoubleMetaphoneEqual(raw, other, true) == alternate.equals(dm.doubleMetaphone(other, true)), () -> "isDoubleMetaphoneEqual(alternate) disagrees with the alternate codes for " + show(raw) + ", " + show(other));
+                DoubleMetaphone dmLong = new DoubleMetaphone();
+                dmLong.setMaxCodeLen(12);
+                String primaryLong = dmLong.doubleMetaphone(raw);
+                Zoo.check(primaryLong.startsWith(primary), () -> "doubleMetaphone(" + show(raw) + ") with max 12 = " + primaryLong + " does not extend " + primary);
+                Zoo.count(alternate.equals(primary) ? "dm-same" : "dm-alternate");
+            }
+            // Caverphone 1.0 gives six characters, 2.0 ten, padded with 1
+            try {
+                String c1 = new Caverphone1().encode(raw);
+                String c2 = new Caverphone2().encode(raw);
+                Zoo.check(c1.length() == 6 && c1.matches("[A-Z1]*"), () -> "Caverphone1.encode(" + show(raw) + ") = " + show(c1));
+                Zoo.check(c2.length() == 10 && c2.matches("[A-Z1]*"), () -> "Caverphone2.encode(" + show(raw) + ") = " + show(c2));
+                boolean same = new Caverphone2().isEncodeEqual(raw, other);
+                Zoo.check(same == c2.equals(new Caverphone2().encode(other)), () -> "Caverphone2.isEncodeEqual disagrees for " + show(raw) + ", " + show(other));
+            } catch (EncoderException e) {
+                Zoo.fail("Caverphone threw " + e + " for " + show(raw));
+            }
+            // NYSIIS: strict is the non-strict key cut to six; first letter kept; no repeated adjacent letters
+            String nStrict = new Nysiis(true).encode(raw);
+            String nLoose = new Nysiis(false).encode(raw);
+            Zoo.check(nStrict.equals(nLoose.substring(0, Math.min(6, nLoose.length()))), () -> "Nysiis strict " + nStrict + " is not the six-char cut of " + nLoose + " for " + show(raw));
+            // the key starts with the first letter after the initial transcoding (MAC->MCC, KN->NN, K->C, PH/PF->FF, SCH->SSS)
+            String t = cleaned;
+            if (t.startsWith("MAC")) {
+                t = "MCC" + t.substring(3);
+            } else if (t.startsWith("KN")) {
+                t = "NN" + t.substring(2);
+            } else if (t.startsWith("K")) {
+                t = "C" + t.substring(1);
+            } else if (t.startsWith("PH") || t.startsWith("PF")) {
+                t = "FF" + t.substring(2);
+            } else if (t.startsWith("SCH")) {
+                t = "SSS" + t.substring(3);
+            }
+            if (t.endsWith("EE") || t.endsWith("IE")) {
+                t = t.substring(0, t.length() - 2) + "Y";
+            } else if (t.endsWith("DT") || t.endsWith("RT") || t.endsWith("RD") || t.endsWith("NT") || t.endsWith("ND")) {
+                t = t.substring(0, t.length() - 2) + "D";
+            }
+            char firstKey = t.isEmpty() ? ' ' : t.charAt(0);
+            Zoo.check(cleaned.isEmpty() ? nLoose.isEmpty() : nLoose.charAt(0) == firstKey, () -> "Nysiis(" + show(raw) + ") = " + nLoose + " does not start with " + firstKey + " for " + cleaned);
+            boolean repeated = false;
+            for (int i = 1; i < nLoose.length(); i++) {
+                repeated |= nLoose.charAt(i) == nLoose.charAt(i - 1);
+            }
+            if (repeated) {
+                // known commons-codec/7: the documented step 8 (collapse repeated characters) does not run after
+                // steps 5-7, so "...YAY" -> "...YY" survives
+                Zoo.count("known commons-codec/7");
+            }
+            Zoo.check(new Nysiis().encode(raw).equals(nStrict), () -> "new Nysiis() is not strict for " + show(raw));
+            // Daitch-Mokotoff: six digits per branch, encode is the first branch, whitespace ignored
+            DaitchMokotoffSoundex dms = new DaitchMokotoffSoundex();
+            String all = dms.soundex(raw);
+            String first = dms.encode(raw);
+            for (String branch : all.split("\\|")) {
+                Zoo.check(branch.matches("[0-9]{6}") || (cleaned.isEmpty() && branch.isEmpty()), () -> "DaitchMokotoffSoundex.soundex(" + show(raw) + ") has the branch " + show(branch) + " in " + all);
+            }
+            Zoo.check(first.equals(all.split("\\|", -1)[0]), () -> "DaitchMokotoffSoundex.encode(" + show(raw) + ") = " + first + " is not the first branch of " + all);
+            String spaced = raw.replace("", " ").trim();
+            Zoo.check(dms.soundex(spaced).equals(all), () -> "DaitchMokotoffSoundex.soundex ignores whitespace: " + show(spaced) + " gives " + dms.soundex(spaced) + " vs " + all);
+            // Match Rating Approach: at most six letters, empty for names of one letter or less
+            MatchRatingApproachEncoder mra = new MatchRatingApproachEncoder();
+            String mr = mra.encode(raw);
+            Zoo.check(mr.length() <= 6 && mr.matches("[A-Z]*"), () -> "MatchRatingApproachEncoder.encode(" + show(raw) + ") = " + show(mr));
+            Zoo.check(cleaned.length() > 1 || mr.isEmpty(), () -> "MatchRatingApproachEncoder.encode(" + show(raw) + ") = " + show(mr) + " for a name of " + cleaned.length() + " letters");
+            Zoo.check(mra.isEncodeEquals(raw, other) == mra.isEncodeEquals(other, raw), () -> "MatchRatingApproachEncoder.isEncodeEquals is not symmetric for " + show(raw) + ", " + show(other));
+            // Beider-Morse: the documented output shape, and no '|' without concat
+            BeiderMorseEncoder bm = new BeiderMorseEncoder();
+            bm.setNameType(Zoo.pick(tc, NameType.GENERIC, NameType.ASHKENAZI, NameType.SEPHARDIC));
+            bm.setRuleType(Zoo.pick(tc, RuleType.APPROX, RuleType.EXACT));
+            boolean concat = Zoo.chance(tc, 70);
+            bm.setConcat(concat);
+            try {
+                String enc = bm.encode(raw);
+                Zoo.check(BM_SHAPE.matcher(enc).matches(), () -> "BeiderMorseEncoder.encode(" + show(raw) + ") = " + show(enc));
+                Zoo.count(enc.contains("|") ? "bm-several" : "bm-one");
+            } catch (EncoderException e) {
+                Zoo.fail("BeiderMorseEncoder.encode(" + show(raw) + ") threw " + e);
+            }
+        }, Zoo.settings("phoneticEncodersObeyTheirStatedShapes"));
+        if (Zoo.COLLECT) {
+            System.out.println("STATS phoneticEncodersObeyTheirStatedShapes " + Zoo.stats());
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/NetTest.java b/hegel/src/test/java/zoo/NetTest.java
new file mode 100644
index 0000000..bb8738c
