+                            fail("Base16 (" + (codec.isStrictDecoding() ? "strict" : "lenient") + ").decode(" + show(bad) + ") = " + show(got) + " instead of throwing" + ctx);
+                        } catch (IllegalArgumentException expected) {
+                            count("b16-invalid-rejected");
+                        }
+                    }
+                }
+                case 1 -> {
