+                    String bad = enc.substring(0, at) + pick(tc, "g", "G", " ", "-", "z", "é") + enc.substring(at + 1);
+                    try {
+                        byte[] got = Hex.decodeHex(bad);
+                        fail("Hex.decodeHex(" + show(bad) + ") = " + show(got) + " instead of throwing DecoderException" + ctx);
