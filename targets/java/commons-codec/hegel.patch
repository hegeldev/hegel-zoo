@@ -0,0 +1,104 @@
+package zoo;
+
+import java.util.Arrays;
+import org.apache.commons.codec.binary.Base32;
+import org.apache.commons.codec.binary.Base58;
+import org.apache.commons.codec.digest.Blake3;
+import org.apache.commons.codec.digest.Crypt;
+import org.apache.commons.codec.language.ColognePhonetic;
+import org.apache.commons.codec.language.Nysiis;
+import org.apache.commons.codec.net.QuotedPrintableCodec;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Hegel zoo: one plain test per recorded bug (bugs.toml). Each must fail while the bug is present
+ * and pass once it is fixed; target.toml lists them as expected failures.
+ */
+class CodecPinsTest {
+
+    /** commons-codec/1: Base58.getEncodedLength divides by zero (BaseNCodec's block arithmetic with a 0 block size). */
+    @Test
+    void pinBase58EncodedLengthDoesNotThrow() {
+        byte[] data = {0, 0, 1, 2, (byte) 0xff};
+        Base58 codec = new Base58();
+        long len = codec.getEncodedLength(data);
+        int actual = codec.encodeToString(data).length();
+        Assertions.assertTrue(len >= actual, "getEncodedLength = " + len + " for an encoding of " + actual + " characters");
+    }
+
+    /** commons-codec/2: a dangling Base32 character (5 bits) cannot carry a byte, but the lenient decoder emits one. */
+    @Test
+    void pinLenientBase32IgnoresADanglingCharacter() {
+        // "MFRGGZDF" is "abcde"; one more character adds 5 bits, not a byte
+        byte[] got = new Base32().decode("MFRGGZDFA");
+        Assertions.assertArrayEquals("abcde".getBytes(), got, "decode(\"MFRGGZDFA\") = " + Arrays.toString(got));
+    }
+
+    /**
+     * commons-codec/3: doFinalize is documented to continue the extensible output ("depends on ... any previously
+     * finalized bytes"; the class example derives txKey then rxKey), but every call restarts at output block 0.
+     */
+    @Test
+    void pinBlake3FinalizeContinuesTheOutputStream() {
+        byte[] context = "org.apache.commons.codec.digest.Blake3Example".getBytes(java.nio.charset.StandardCharsets.UTF_8);
+        byte[] secret = "shared secret".getBytes(java.nio.charset.StandardCharsets.UTF_8);
+        byte[] whole = Blake3.initKeyDerivationFunction(context).update(secret).doFinalize(64);
+        Blake3 kdf = Blake3.initKeyDerivationFunction(context).update(secret);
+        byte[] txKey = kdf.doFinalize(32);
+        byte[] rxKey = kdf.doFinalize(32);
+        Assertions.assertArrayEquals(Arrays.copyOfRange(whole, 0, 32), txKey, "first 32 bytes");
+        Assertions.assertArrayEquals(Arrays.copyOfRange(whole, 32, 64), rxKey, "second doFinalize(32) should be bytes 32..64 of the output stream, got the first 32 again: " + Arrays.equals(txKey, rxKey));
+    }
+
+    /**
+     * commons-codec/4: RFC 1521 rule #5 limits encoded lines to 76 characters (the soft break "=" counts, the CRLF
+     * does not); the strict encoder lets a line reach 77 or 78 characters when two escaped bytes straddle the limit.
+     */
+    @Test
+    void pinStrictQuotedPrintableLinesFitInSeventySix() {
+        byte[] data = new byte[76];
+        Arrays.fill(data, (byte) 'a');
+        data[71] = (byte) 0xff;
+        data[72] = (byte) 0xff;
+        data[73] = 'x';
+        data[74] = 'y';
+        data[75] = 'z';
+        String encoded = new String(new QuotedPrintableCodec(true).encode(data), java.nio.charset.StandardCharsets.US_ASCII);
+        for (String line : encoded.split("\r\n", -1)) {
+            Assertions.assertTrue(line.length() <= 76, "a " + line.length() + "-character line: " + line);
+        }
+    }
+
+    /**
+     * commons-codec/5: a malformed "rounds=" specification is not rejected but hashed with the literal salt
+     * "rounds", which libc (whose output the class promises to match) refuses.
+     */
+    @Test
+    void pinMalformedRoundsSaltIsRejected() {
+        Assertions.assertThrows(IllegalArgumentException.class, () -> Crypt.crypt("secret", "$6$rounds=abc$xyz"));
+    }
+
+    /**
+     * commons-codec/6: step 1 removes non-alphabetical characters, but the context rules look at the raw next
+     * character, so a hyphen between T and C codes the T as 2 (not before C/S/Z) instead of 8.
+     */
+    @Test
+    void pinColognePhoneticIgnoresPunctuationInContextRules() {
+        ColognePhonetic codec = new ColognePhonetic();
+        Assertions.assertEquals(codec.colognePhonetic("BrandtCohn"), codec.colognePhonetic("Brandt-Cohn"));
+    }
+
+    /**
+     * commons-codec/7: NYSIIS step 8 "Collapse all strings of repeated characters" follows steps 5-7 in the class's
+     * algorithm, but the implementation only de-duplicates while transcoding (step 4j): "Yaay" gives the key YAY,
+     * step 6 turns the final AY into Y, and the resulting YY is never collapsed.
+     */
+    @Test
+    void pinNysiisCollapsesRepeatedLetters() {
+        String key = new Nysiis(false).encode("Yaay");
+        for (int i = 1; i < key.length(); i++) {
+            Assertions.assertNotEquals(key.charAt(i - 1), key.charAt(i), "repeated letter in " + key);
+        }
+    }
+}
