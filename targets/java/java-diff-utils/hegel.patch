+    @Test
+    void inlineDiffsRebuildTheRevisedString() {
+        Hegel.test(tc -> {
+            String a = tc.draw(ABCD, "a"), b = tc.draw(ABCD, "b");
+            Patch<String> patch = DiffUtils.diffInline(a, b);
+            // each delta's chunks hold one joined string (or none); replace from the back
+            StringBuilder cur = new StringBuilder(a);
+            List<AbstractDelta<String>> deltas = new ArrayList<>(patch.getDeltas());
+            java.util.Collections.reverse(deltas);
+            for (AbstractDelta<String> d : deltas) {
+                final AbstractDelta<String> df = d;
+                check(d.getSource().size() <= 1 && d.getTarget().size() <= 1, () -> "diffInline chunk not compressed: " + df);
+                String from = d.getSource().size() == 0 ? "" : d.getSource().getLines().get(0);
+                String to = d.getTarget().size() == 0 ? "" : d.getTarget().getLines().get(0);
+                int pos = d.getSource().getPosition();
+                check(pos + from.length() <= cur.length() && cur.substring(pos, pos + from.length()).equals(from), () -> "diffInline source \"" + from + "\" at " + pos + " not in \"" + a + "\"");
+                cur.replace(pos, pos + from.length(), to);
+            }
+            check(cur.toString().equals(b), () -> "diffInline(\"" + a + "\", \"" + b + "\") rebuilt \"" + cur + "\": " + patch);
+            int minimal = a.length() + b.length() - 2 * lcs(Arrays.asList(a.split("")), Arrays.asList(b.split("")), Object::equals);
+            int cost = patch.getDeltas().stream().mapToInt(d -> (d.getSource().size() == 0 ? 0 : d.getSource().getLines().get(0).length()) + (d.getTarget().size() == 0 ? 0 : d.getTarget().getLines().get(0).length())).sum();
+            check(a.isEmpty() || b.isEmpty() ? true : cost == minimal, () -> "diffInline cost " + cost + " != " + minimal + " for \"" + a + "\" -> \"" + b + "\"");
+        }, Zoo.settings("inlineDiffsRebuildTheRevisedString"));
+    }
