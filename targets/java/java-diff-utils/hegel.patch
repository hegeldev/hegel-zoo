+            Options opts = tc.draw(OPTIONS, "options");
+            boolean inline = opts.inline(), byWord = opts.byWord(), merge = opts.merge(), unchanged = opts.unchanged(), ignoreWs = opts.ignoreWs(), decompress = opts.decompress(), html = opts.html();
+            int width = opts.width();
+            DiffRowGenerator.Builder b = DiffRowGenerator.create()
+                    .showInlineDiffs(inline)
+                    .inlineDiffByWord(byWord)
+                    .mergeOriginalRevised(merge)
+                    .reportLinesUnchanged(unchanged)
+                    .ignoreWhiteSpaces(ignoreWs)
+                    .decompressDeltas(decompress)
+                    .columnWidth(width)
+                    .oldTag(f -> f ? OLD_OPEN : OLD_CLOSE)
+                    .newTag(f -> f ? NEW_OPEN : NEW_CLOSE);
+            if (!html) {
