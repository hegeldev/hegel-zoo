index 0000000..baf2662
--- /dev/null
+++ b/hegel/src/test/java/zoo/DiffUtilsTest.java
@@ -0,0 +1,874 @@
+package zoo;
+
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+
+import com.github.difflib.DiffUtils;
+import com.github.difflib.UnifiedDiffUtils;
+import com.github.difflib.algorithm.DiffAlgorithmI;
+import com.github.difflib.algorithm.DiffAlgorithmListener;
+import com.github.difflib.algorithm.myers.MyersDiff;
+import com.github.difflib.algorithm.myers.MyersDiffWithLinearSpace;
+import com.github.difflib.patch.AbstractDelta;
+import com.github.difflib.patch.ChangeDelta;
+import com.github.difflib.patch.Chunk;
+import com.github.difflib.patch.DeltaType;
+import com.github.difflib.patch.Patch;
+import com.github.difflib.patch.PatchFailedException;
+import com.github.difflib.patch.VerifyChunk;
+import com.github.difflib.text.DiffRow;
+import com.github.difflib.text.DiffRowGenerator;
+import com.github.difflib.unifieddiff.UnifiedDiff;
+import com.github.difflib.unifieddiff.UnifiedDiffFile;
+import com.github.difflib.unifieddiff.UnifiedDiffReader;
+import com.github.difflib.unifieddiff.UnifiedDiffWriter;
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import dev.hegel.Hegel;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.ObjectInputStream;
+import java.io.ObjectOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.BiPredicate;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+import org.junit.jupiter.api.Test;
+
+/** The diff/patch engine, the unified-diff text format and DiffRowGenerator against models built from the Javadoc. */
+class DiffUtilsTest {
+
+    // ---- generators --------------------------------------------------------------------------------
+
+    /** A weighted alternative for {@link #weighted}. */
+    record Choice<T>(int weight, Generator<T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        int total = 0;
+        for (Choice<T> c : choices) {
+            total += c.weight();
+        }
+        return Generators.integers().min(0).max(total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : choices) {
+                acc += c.weight();
+                if (i < acc) {
+                    return c.gen();
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return Generators.integers().min(0).max(99).map(x -> x >= 100 - pct);
+    }
+
+    static final String[] WORDS = {"a", "b", "c", "d", "e", "", "a b", "  a", "a  ", "\t", "x", "<", "&", "y.z", "a,b", "\uD83D\uDE00", "a\uD83D\uDE00"};
+    static final Generator<String> WORD = Generators.sampledFrom(WORDS);
+
+    /** 0..max lines over the first k of the WORDS (k drawn per case), so that repeats and long common runs are frequent. */
+    static Generator<List<String>> lines(int max) {
+        return Generators.integers().min(2).max(WORDS.length)
+                .flatMap(k -> Generators.lists(Generators.sampledFrom(Arrays.asList(WORDS).subList(0, k))).maxSize(max));
+    }
+
+    enum Op { INSERT, REMOVE, REPLACE, MOVE }
+
+    /** One edit of a line list; the positions are taken modulo the list's size when applied, so every edit is applicable. */
+    record Edit(Op op, int at, int to, String word) {}
+
+    static final Generator<Edit> EDIT = Generators.tuples(Generators.sampledFrom(Op.values()), Generators.integers().min(0).max(29), Generators.integers().min(0).max(29), WORD)
+            .map(t -> new Edit(t.value1(), t.value2(), t.value3(), t.value4()));
+    static final Generator<List<Edit>> EDITS = Generators.lists(EDIT).maxSize(5);
+
+    static List<String> edit(List<String> orig, List<Edit> edits) {
+        List<String> rev = new ArrayList<>(orig);
+        for (Edit e : edits) {
+            switch (e.op()) {
+                case INSERT -> rev.add(e.at() % (rev.size() + 1), e.word());
+                case REMOVE -> {
+                    if (!rev.isEmpty()) {
+                        rev.remove(e.at() % rev.size());
+                    }
+                }
+                case REPLACE -> {
+                    if (!rev.isEmpty()) {
+                        rev.set(e.at() % rev.size(), e.word());
+                    }
+                }
+                case MOVE -> {
+                    if (rev.size() >= 2) {
+                        int to = e.to() % rev.size();
+                        String moved = rev.remove(e.at() % rev.size());
+                        rev.add(to, moved);
+                    }
+                }
+            }
+        }
+        return rev;
+    }
+
+    /** An original text and its revision. */
+    record Texts(List<String> orig, List<String> rev) {}
+
+    /** The original (0..max lines) and its revision: the original under 0\u20135 edits, or an unrelated list. */
+    static Generator<Texts> texts(int max) {
+        return lines(max).flatMap(orig -> weighted(w(3, EDITS.map(es -> edit(orig, es))), w(1, lines(25))).map(rev -> new Texts(orig, rev)));
+    }
+
+    /** A file name with the prefix, or null (the "/dev/null" side) 15% of the time. */
+    static Generator<String> fileName(String prefix) {
+        return weighted(w(3, Generators.<String>just(null)), w(17, Generators.sampledFrom("file.txt", "x").map(s -> prefix + s)));
+    }
+
+    /** The string of {@code diffInline}'s inputs: 0..12 characters from a..d. */
+    static final Generator<String> ABCD = Generators.text().codepoints('a', 'd').maxSize(12);
+
+    /** DiffRowGenerator's builder options; {@code merge} only with inline diffs. */
+    record Options(boolean inline, boolean byWord, boolean merge, boolean unchanged, boolean ignoreWs, boolean decompress, boolean html, int width) {}
+
+    static final Generator<Options> OPTIONS = Generators.tuples(chance(50), chance(40), chance(30), chance(20), chance(30), chance(70), chance(30), Generators.sampledFrom(0, 0, 0, 3, 8))
+            .map(t -> new Options(t.value1(), t.value2(), t.value1() && t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    /** The splitters' input: 0..20 pieces of words, whitespace, punctuation and an emoji. */
+    static final String[] PIECES = {"a", "bc", " ", "  ", ",", ".", "(", ")", "-", "\t", "x", "'", "/", "\\", "*", "+", "#", "<", ">", ";", ":", "&", "[", "]", "{", "}", "1", "\uD83D\uDE00"};
+    static final Generator<String> PIECEWISE = Generators.lists(Generators.sampledFrom(PIECES)).maxSize(20).map(l -> String.join("", l));
+
+    enum Header { NONE, GIT, TEXT }
+
+    /** The multi-file diff's file names, header kind and whether it has a tail; {@code to} is {@code from} 70% of the time. */
+    record Names(String from, String to, Header header, boolean tail) {}
+
+    // a header starting with "diff " is read as the diff command line; with fewer than four tokens the reader
+    // throws ArrayIndexOutOfBoundsException (java-diff-utils/11), so only the git form is generated here
+    static final Generator<Names> NAMES = Generators.tuples(
+                    Generators.sampledFrom("x.txt", "src/main/Foo.java", "dir/with space.txt", "a"),
+                    chance(30),
+                    weighted(w(56, Generators.just(Header.NONE)), w(24, Generators.just(Header.GIT)), w(20, Generators.just(Header.TEXT))),
+                    chance(30))
+            .map(t -> new Names(t.value1(), t.value2() ? "y.txt" : t.value1(), t.value3(), t.value4()));
+
+    static int lcs(List<String> a, List<String> b, BiPredicate<String, String> eq) {
+        int[][] dp = new int[a.size() + 1][b.size() + 1];
+        for (int i = a.size() - 1; i >= 0; i--) {
+            for (int j = b.size() - 1; j >= 0; j--) {
+                dp[i][j] = eq.test(a.get(i), b.get(j)) ? dp[i + 1][j + 1] + 1 : Math.max(dp[i + 1][j], dp[i][j + 1]);
+            }
+        }
+        return dp[0][0];
+    }
+
+    static <T> String show(List<T> l) {
+        return l.stream().map(x -> "\"" + String.valueOf(x).replace("\t", "\\t") + "\"").collect(Collectors.joining(", ", "[", "]"));
+    }
+
+    static byte[] serialize(Object o) throws IOException {
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        try (ObjectOutputStream out = new ObjectOutputStream(bytes)) {
+            out.writeObject(o);
+        }
+        return bytes.toByteArray();
+    }
+
+    static Object deserialize(byte[] b) throws IOException, ClassNotFoundException {
+        try (ObjectInputStream in = new ObjectInputStream(new ByteArrayInputStream(b))) {
+            return in.readObject();
+        }
+    }
+
+    static final class Progress implements DiffAlgorithmListener {
+        int starts, ends, steps;
+
+        @Override
+        public void diffStart() {
+            starts++;
+        }
+
+        @Override
+        public void diffStep(int value, int max) {
+            steps++;
+            check(value <= max, () -> "diffStep(" + value + ", " + max + ") beyond max");
+        }
+
+        @Override
+        public void diffEnd() {
+            ends++;
+        }
+    }
+
+    // ---- 1. diff and patch -----------------------------------------------------------------------
+
+    @Test
+    void diffsAreMinimalAndPatchesRoundTrip() {
+        Hegel.test(tc -> {
+            Texts texts = tc.draw(texts(25), "texts");
+            List<String> orig = texts.orig(), rev = texts.rev();
+            boolean linear = tc.draw(chance(40), "linear");
+            boolean equalParts = tc.draw(chance(30), "equalParts");
+            boolean lenient = tc.draw(chance(20), "lenient");
+            BiPredicate<String, String> eq = lenient ? (x, y) -> x.trim().equals(y.trim()) : Object::equals;
+            DiffAlgorithmI<String> algorithm = linear ? new MyersDiffWithLinearSpace<>(eq) : new MyersDiff<>(eq);
+            Progress progress = new Progress();
+            Patch<String> patch = DiffUtils.diff(orig, rev, algorithm, progress, equalParts);
+            String tag = (linear ? "linear " : "myers ") + (equalParts ? "+equal " : "") + (lenient ? "trim-eq " : "") + show(orig) + " -> " + show(rev);
+            check(progress.starts == 1 && progress.ends == 1, () -> "listener start/end " + progress.starts + "/" + progress.ends + " for " + tag);
+
+            // structure: sorted, disjoint, chunks quote the texts, types match the chunk sizes
+            List<AbstractDelta<String>> deltas = patch.getDeltas();
+            int cost = 0, prevEnd = -1, prevRevEnd = -1;
+            List<String> fromSource = new ArrayList<>(), fromTarget = new ArrayList<>();
+            for (AbstractDelta<String> d : deltas) {
+                Chunk<String> s = d.getSource(), t = d.getTarget();
+                final AbstractDelta<String> df = d;
+                check(s.getPosition() >= 0 && s.getPosition() + s.size() <= orig.size() && s.getLines().equals(orig.subList(s.getPosition(), s.getPosition() + s.size())), () -> "source chunk " + df + " does not quote the original for " + tag);
+                check(t.getPosition() >= 0 && t.getPosition() + t.size() <= rev.size() && t.getLines().equals(rev.subList(t.getPosition(), t.getPosition() + t.size())), () -> "target chunk " + df + " does not quote the revised for " + tag);
+                check(s.getPosition() >= prevEnd && t.getPosition() >= prevRevEnd, () -> "deltas overlap or are out of order at " + df + " for " + tag);
+                check(s.last() == s.getPosition() + s.size() - 1 && s.getChangePosition() == null, () -> "Chunk.last()/getChangePosition " + df);
+                if (equalParts) {
+                    check(s.getPosition() == prevEnd || prevEnd == -1 && s.getPosition() == 0, () -> "with includeEqualParts the deltas must be contiguous; gap before " + df + " for " + tag);
+                }
+                prevEnd = s.getPosition() + s.size();
+                prevRevEnd = t.getPosition() + t.size();
+                switch (d.getType()) {
+                    case INSERT:
+                        check(s.size() == 0 && t.size() > 0, () -> "INSERT sizes " + df);
+                        break;
+                    case DELETE:
+                        check(s.size() > 0 && t.size() == 0, () -> "DELETE sizes " + df);
+                        break;
+                    case CHANGE:
+                        check(s.size() > 0 && t.size() > 0, () -> "CHANGE sizes " + df);
+                        break;
+                    default:
+                        check(equalParts && s.size() == t.size() && s.size() > 0, () -> "EQUAL delta " + df + " without includeEqualParts or with unequal sizes for " + tag);
+                        for (int i = 0; i < s.size(); i++) {
+                            final int fi = i;
+                            check(eq.test(s.getLines().get(i), t.getLines().get(i)), () -> "EQUAL delta line " + fi + " differs " + df);
+                        }
+                }
+                if (d.getType() != DeltaType.EQUAL) {
+                    cost += s.size() + t.size();
+                }
+                fromSource.addAll(s.getLines());
+                fromTarget.addAll(t.getLines());
+            }
+            if (equalParts) {
+                check(fromSource.equals(orig) && fromTarget.equals(rev), () -> "with includeEqualParts the chunks must concatenate to the texts; got " + show(fromSource) + " / " + show(fromTarget) + " for " + tag);
+            }
+            int minimal = orig.size() + rev.size() - 2 * lcs(orig, rev, eq);
+            final int costF = cost;
+            check(cost == minimal, () -> "edit cost " + costF + " != minimal " + minimal + " (Myers) for " + tag + ": " + deltas);
+            if (orig.equals(rev)) {
+                check(deltas.stream().allMatch(d -> d.getType() == DeltaType.EQUAL), () -> "identical texts produced " + deltas);
+            }
+
+            // applying: the Javadoc's "creates a new list, the patch is being applied to"
+            try {
+                List<String> applied = patch.applyTo(orig);
+                List<String> restored = patch.restore(rev);
+                if (lenient) {
+                    check(applied.size() == rev.size(), () -> "applyTo size under an equalizer " + show(applied) + " for " + tag);
+                    for (int i = 0; i < applied.size(); i++) {
