+            check(minus.equals(deleted) && plus.equals(inserted), () -> "generateOriginalAndDiff -/+ lines " + show(minus) + "/" + show(plus) + " != " + show(deleted) + "/" + show(inserted) + ":\n" + String.join("\n", both) + "\nfor " + tag);
+        }, Zoo.settings("unifiedDiffsAreWellFormedAndParseBack"));
+    }
