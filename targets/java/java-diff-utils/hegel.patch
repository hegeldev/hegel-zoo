+                    check(restored.equals(orig), () -> "restore " + show(restored) + " != " + show(orig) + " for " + tag);
+                    check(DiffUtils.patch(orig, patch).equals(rev) && DiffUtils.unpatch(rev, patch).equals(orig), () -> "DiffUtils.patch/unpatch for " + tag);
+                    List<String> existing = new ArrayList<>(orig);
