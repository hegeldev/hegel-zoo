+    // ---- 4. DiffRowGenerator ---------------------------------------------------------------------
+
+    static final String OLD_OPEN = "[-", OLD_CLOSE = "-]", NEW_OPEN = "{+", NEW_CLOSE = "+}";
+    static final Pattern ENTITY_TORN = Pattern.compile("&(?:\\[-|\\{\\+|-\\]|\\+\\})*(?:lt|gt)(?:\\[-|\\{\\+|-\\]|\\+\\})*;");
+
+    static boolean entityTorn(String s) {
+        Matcher m = ENTITY_TORN.matcher(s);
+        while (m.find()) {
+            if (m.group().length() > 4) { // longer than "&lt;": a tag sits inside the entity
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static String strip(String s) {
+        return s.replace(OLD_OPEN, "").replace(OLD_CLOSE, "").replace(NEW_OPEN, "").replace(NEW_CLOSE, "");
+    }
+
+    static boolean balanced(String s, String open, String close) {
+        int depth = 0, i = 0;
+        while (i < s.length()) {
+            if (s.startsWith(open, i)) {
+                if (depth != 0) {
+                    return false;
+                }
+                depth = 1;
+                i += open.length();
+            } else if (s.startsWith(close, i)) {
+                if (depth != 1) {
+                    return false;
+                }
+                depth = 0;
+                i += close.length();
+            } else {
+                i++;
+            }
+        }
+        return depth == 0;
+    }
