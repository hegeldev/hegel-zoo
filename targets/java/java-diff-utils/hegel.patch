+    // ---- 3. unified diff text -------------------------------------------------------------------
+
+    static final Pattern HUNK = Pattern.compile("^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@$");
+
+    /** Applies unified-diff hunks to the original the way GNU patch reads them. */
+    static List<String> applyUnified(List<String> lines, List<String> orig, String tag) {
+        List<String> out = new ArrayList<>();
+        int origIdx = 0;
+        int i = 0;
+        check(lines.size() >= 3 && lines.get(0).startsWith("--- ") && lines.get(1).startsWith("+++ "), () -> "unified diff header " + lines.subList(0, Math.min(2, lines.size())) + " for " + tag);
+        i = 2;
+        int lastHunkEnd = -1;
+        while (i < lines.size()) {
+            Matcher m = HUNK.matcher(lines.get(i));
+            final int fi = i;
+            check(m.matches(), () -> "expected a hunk header at line " + fi + ": " + lines.get(fi) + " for " + tag);
+            int oStart = Integer.parseInt(m.group(1)), oCount = m.group(2) == null ? 1 : Integer.parseInt(m.group(2));
+            int nStart = Integer.parseInt(m.group(3)), nCount = m.group(4) == null ? 1 : Integer.parseInt(m.group(4));
+            // The unified format numbers an empty range with the line before it (`-0,0` for an empty original); the
+            // library numbers it with the line after (java-diff-utils/1) and a null original name from 0 (/2), so
+            // the model follows the library's numbering for those shapes and checks the format only for the others.
+            boolean headerBug = oCount == 0 || nCount == 0 || oStart == 0;
+            int oIdx = oStart == 0 ? 0 : oStart - 1;
+            final int lastEndF = lastHunkEnd;
+            check(oIdx >= origIdx && oIdx > lastHunkEnd, () -> "hunk " + lines.get(fi) + " starts before the previous hunk ended (" + lastEndF + ") for " + tag);
+            check(oIdx <= orig.size(), () -> "hunk " + lines.get(fi) + " starts beyond the original (" + orig.size() + " lines) for " + tag);
+            out.addAll(orig.subList(origIdx, oIdx));
+            if (!headerBug) {
+                check(nStart - 1 == out.size(), () -> "hunk " + lines.get(fi) + ": revised start " + nStart + " but " + out.size() + " lines produced so far for " + tag);
+            }
+            origIdx = oIdx;
+            i++;
+            int seenO = 0, seenN = 0;
+            while (i < lines.size() && !lines.get(i).startsWith("@@")) {
+                String l = lines.get(i);
+                final int li = i;
+                check(!l.isEmpty() && (l.charAt(0) == ' ' || l.charAt(0) == '-' || l.charAt(0) == '+'), () -> "hunk body line " + li + " has no tag: \"" + l + "\" for " + tag);
+                if (l.charAt(0) == ' ' || l.charAt(0) == '-') {
+                    final int oi = origIdx;
+                    check(origIdx < orig.size() && orig.get(origIdx).equals(l.substring(1)), () -> "hunk line " + li + " \"" + l + "\" does not match the original at " + oi + " for " + tag);
+                    origIdx++;
+                    seenO++;
+                }
+                if (l.charAt(0) == ' ' || l.charAt(0) == '+') {
+                    out.add(l.substring(1));
+                    seenN++;
+                }
+                i++;
+            }
+            final int so = seenO, sn = seenN;
+            check(so == oCount && sn == nCount, () -> "hunk " + lines.get(fi) + " counts " + so + "/" + sn + " for " + tag);
+            lastHunkEnd = origIdx - 1;
+        }
+        out.addAll(orig.subList(origIdx, orig.size()));
+        return out;
+    }
