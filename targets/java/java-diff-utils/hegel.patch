+    @Test
+    void unifiedDiffsAreWellFormedAndParseBack() {
+        Hegel.test(tc -> {
+            Texts texts = tc.draw(texts(20), "texts");
+            List<String> orig = texts.orig(), rev = texts.rev();
+            int context = tc.draw(Generators.sampledFrom(0, 1, 2, 3, 5), "context");
+            String oName = tc.draw(fileName("a/"), "oName");
+            String nName = tc.draw(fileName("b/"), "nName");
+            Patch<String> patch = DiffUtils.diff(orig, rev);
+            List<String> ud = UnifiedDiffUtils.generateUnifiedDiff(oName, nName, orig, patch, context);
+            String tag = "context " + context + ", " + show(orig) + " -> " + show(rev);
+            if (patch.getDeltas().isEmpty()) {
+                check(ud.isEmpty(), () -> "no deltas but a diff " + ud);
+                return;
+            }
+            check(ud.get(0).equals("--- " + (oName == null ? "/dev/null" : oName)) && ud.get(1).equals("+++ " + (nName == null ? "/dev/null" : nName)), () -> "file header " + ud.subList(0, 2));
+            long hunksEarly = ud.stream().filter(l -> l.startsWith("@@")).count();
+            tc.assume(!(oName == null && hunksEarly == 1 && !orig.isEmpty())); // java-diff-utils/2: the hunk is numbered from 0 and loses its position
+            List<String> viaModel = applyUnified(ud, orig, tag);
+            check(viaModel.equals(rev), () -> "the unified diff applied by the model gives " + show(viaModel) + " != " + show(rev) + ":\n" + String.join("\n", ud) + "\nfor " + tag);
+            // context lines: at most `context` before the first and after the last change of a hunk
+            long contextLines = ud.stream().skip(2).filter(l -> l.startsWith(" ")).count();
+            long hunks = ud.stream().filter(l -> l.startsWith("@@")).count();
+            check(contextLines <= patch.getDeltas().size() * 2L * context, () -> "more context lines (" + contextLines + ") than " + patch.getDeltas().size() + " deltas allow for " + tag);
+            if (context == 0) {
+                check(contextLines == 0, () -> "context 0 but context lines in\n" + String.join("\n", ud));
+            }
+            // parse back: applyTo(original) == revised, restore(revised) == original
+            Patch<String> parsed = UnifiedDiffUtils.parseUnifiedDiff(ud);
+            check(parsed.getDeltas().size() == hunks, () -> "parseUnifiedDiff made " + parsed.getDeltas().size() + " deltas for " + hunks + " hunks for " + tag);
+            try {
+                List<String> applied = parsed.applyTo(orig);
+                check(applied.equals(rev), () -> "parsed patch applyTo " + show(applied) + " != " + show(rev) + "\n" + String.join("\n", ud) + "\nfor " + tag);
+                List<String> restored = parsed.restore(rev);
+                check(restored.equals(orig), () -> "parsed patch restore " + show(restored) + " != " + show(orig) + "\n" + String.join("\n", ud) + "\nfor " + tag);
+                // the parsed deltas remember which lines changed (1-based positions, documented "positions of changed lines")
+                for (AbstractDelta<String> d : parsed.getDeltas()) {
+                    final AbstractDelta<String> df = d;
+                    check(d instanceof ChangeDelta && d.getSource().getChangePosition() != null && d.getTarget().getChangePosition() != null, () -> "parsed delta without change positions: " + df);
+                }
+                // fuzzy application at the recorded positions is the plain one
+                List<AbstractDelta<String>> pd = parsed.getDeltas();
+                boolean sizeChangeBeforeAnother = false;
+                for (int i = 0; i + 1 < pd.size(); i++) {
+                    sizeChangeBeforeAnother |= pd.get(i).getSource().size() != pd.get(i).getTarget().size();
+                }
+                if (!sizeChangeBeforeAnother) { // java-diff-utils/7: applyFuzzy keeps the stale positions after a hunk that changed the line count
+                    try {
+                        List<String> fuzzy = parsed.applyFuzzy(new ArrayList<>(orig), 0);
+                        check(fuzzy.equals(rev), () -> "applyFuzzy(orig, 0) " + show(fuzzy) + " != " + show(rev) + "\n" + String.join("\n", ud) + "\nfor " + tag);
+                    } catch (IndexOutOfBoundsException ex) {
+                        // java-diff-utils/3: verifyChunk reads one line past the target while searching for the position
+                    }
+                }
+                // shifted target: GNU patch finds the hunk by its context; the fuzzy search does the same
+                int shift = tc.draw(Generators.integers().min(1).max(3), "shift");
+                List<String> shifted = new ArrayList<>();
+                for (int i = 0; i < shift; i++) {
+                    shifted.add("shift" + i);
+                }
+                shifted.addAll(orig);
+                List<String> want = new ArrayList<>(shifted.subList(0, shift));
+                want.addAll(rev);
+                boolean ambiguous = false;
+                for (AbstractDelta<String> d : pd) {
+                    int hits = 0;
+                    List<String> src = d.getSource().getLines();
+                    for (int p = 0; p + src.size() <= shifted.size(); p++) {
+                        if (shifted.subList(p, p + src.size()).equals(src)) {
+                            hits++;
+                        }
+                    }
+                    ambiguous |= hits != 1;
+                }
+                if (!orig.isEmpty() && !sizeChangeBeforeAnother && !ambiguous) { // an empty original is a new file (inserted at 0); /7 as above; a chunk matching at several positions may legitimately land elsewhere
+                    try {
+                        List<String> shiftedOut = parsed.applyFuzzy(shifted, 0);
+                        check(shiftedOut.equals(want), () -> "applyFuzzy on a target shifted by " + shift + " gave " + show(shiftedOut) + " != " + show(want) + "\n" + String.join("\n", ud) + "\nfor " + tag);
+                    } catch (IndexOutOfBoundsException ex) {
+                        // java-diff-utils/3: verifyChunk reads one line past the target while searching for the position
+                    }
+                }
+            } catch (PatchFailedException ex) {
+                fail("parsed patch failed: " + ex.getMessage() + "\n" + String.join("\n", ud) + "\nfor " + tag);
+            } catch (UnsupportedOperationException ex) {
+                fail("parsed patch: " + ex.getMessage() + "\n" + String.join("\n", ud) + "\nfor " + tag);
+            }
+            // generateOriginalAndDiff: every original line once (as context), the changes as -/+ lines
+            List<String> both = UnifiedDiffUtils.generateOriginalAndDiff(orig, rev, oName, nName);
+            List<String> ctx = both.stream().filter(l -> l.startsWith(" ")).map(l -> l.substring(1)).collect(Collectors.toList());
+            List<String> minus = both.stream().filter(l -> l.startsWith("-") && !l.startsWith("--- ")).map(l -> l.substring(1)).collect(Collectors.toList());
+            List<String> plus = both.stream().filter(l -> l.startsWith("+") && !l.startsWith("+++ ")).map(l -> l.substring(1)).collect(Collectors.toList());
+            List<String> deleted = new ArrayList<>(), inserted = new ArrayList<>(), unchanged = new ArrayList<>(orig);
+            for (AbstractDelta<String> d : patch.getDeltas()) {
+                deleted.addAll(d.getSource().getLines());
+                inserted.addAll(d.getTarget().getLines());
+            }
+            {
+                int at = 0;
+                unchanged.clear();
+                for (AbstractDelta<String> d : patch.getDeltas()) {
+                    unchanged.addAll(orig.subList(at, d.getSource().getPosition()));
+                    at = d.getSource().getPosition() + d.getSource().size();
+                }
+                unchanged.addAll(orig.subList(at, orig.size()));
+            }
+            check(both.size() >= 2 && both.get(0).equals("--- " + (oName == null ? "original" : oName)) && both.get(1).equals("+++ " + (nName == null ? "revised" : nName)), () -> "generateOriginalAndDiff header " + both.subList(0, Math.min(2, both.size())));
