index 0000000..e16d178
--- /dev/null
+++ b/hegel/src/test/java/zoo/DiffPinsTest.java
@@ -0,0 +1,110 @@
+package zoo;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.github.difflib.DiffUtils;
+import com.github.difflib.UnifiedDiffUtils;
+import com.github.difflib.patch.Chunk;
+import com.github.difflib.patch.Patch;
+import com.github.difflib.patch.VerifyChunk;
+import com.github.difflib.text.DiffRow;
+import com.github.difflib.text.DiffRowGenerator;
+import com.github.difflib.unifieddiff.UnifiedDiff;
+import com.github.difflib.unifieddiff.UnifiedDiffParserException;
+import com.github.difflib.unifieddiff.UnifiedDiffReader;
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+
+/**
+ * One pin per bug in bugs.toml: each asserts the documented (correct) behaviour and fails while the
+ * bug exists; `zoo` expects them to fail (target.toml `[expected_failures]`).
+ */
+class DiffPinsTest {
+
+    @Test
+    void pinEmptyHunkRangesAreNumberedWithTheLineBefore() { // java-diff-utils/1
+        List<String> orig = Arrays.asList("a", "b", "c");
+        Patch<String> patch = DiffUtils.diff(orig, Collections.<String>emptyList());
+        List<String> ud = UnifiedDiffUtils.generateUnifiedDiff("a", "b", orig, patch, 0);
+        assertEquals("@@ -1,3 +0,0 @@", ud.get(2));
+    }
+
+    @Test
+    void pinNullOriginalNameKeepsTheOriginalLineNumbers() { // java-diff-utils/2
+        List<String> orig = Arrays.asList("a", "b", "c");
+        Patch<String> patch = DiffUtils.diff(orig, Arrays.asList("a", "x", "c"));
+        List<String> ud = UnifiedDiffUtils.generateUnifiedDiff(null, "b", orig, patch, 0);
+        assertEquals("@@ -2,1 +2,1 @@", ud.get(2));
+    }
+
+    @Test
+    void pinVerifyChunkReportsAChunkEndingPastTheTarget() throws Exception { // java-diff-utils/3
+        Chunk<String> chunk = new Chunk<>(2, Arrays.asList("c", "y"));
+        assertEquals(VerifyChunk.POSITION_OUT_OF_TARGET, chunk.verifyChunk(Arrays.asList("a", "b", "c")));
+    }
+
+    @Test
+    void pinReportLinesUnchangedSuppressesInlineMarkup() { // java-diff-utils/4
+        DiffRowGenerator gen = DiffRowGenerator.create().showInlineDiffs(true).reportLinesUnchanged(true).oldTag(f -> "~").newTag(f -> "*").build();
+        List<DiffRow> rows = gen.generateDiffRows(Arrays.asList("a"), Arrays.asList("b"));
+        assertEquals("[CHANGE,a,b]", rows.get(0).toString());
+    }
+
+    @Test
+    void pinColumnWidthWrappingKeepsInlineTagsIntact() { // java-diff-utils/5
+        DiffRowGenerator gen = DiffRowGenerator.create().showInlineDiffs(true).columnWidth(3).oldTag(f -> f ? "[-" : "-]").newTag(f -> f ? "{+" : "+}").build();
+        String old = gen.generateDiffRows(Arrays.asList("abcdef"), Arrays.asList("abXdef")).get(0).getOldLine();
+        assertTrue(old.contains("[-c-]"), old);
+    }
+
+    @Test
+    void pinWordInlineDiffsTagEachRowSeparately() { // java-diff-utils/6
+        DiffRowGenerator gen = DiffRowGenerator.create().showInlineDiffs(true).inlineDiffByWord(true).decompressDeltas(false).oldTag(f -> f ? "[-" : "-]").newTag(f -> f ? "{+" : "+}").build();
+        List<DiffRow> rows = gen.generateDiffRows(Arrays.asList("c", "  a"), Arrays.asList("b"));
+        assertEquals("[-c-]", rows.get(0).getOldLine());
+    }
+
+    @Test
+    void pinApplyFuzzyFollowsEarlierHunksThatChangedTheLineCount() throws Exception { // java-diff-utils/7
+        List<String> orig = Arrays.asList("d");
+        List<String> rev = Arrays.asList("a  ", "c", "d", "e");
+        List<String> ud = UnifiedDiffUtils.generateUnifiedDiff("a", "b", orig, DiffUtils.diff(orig, rev), 0);
+        Patch<String> parsed = UnifiedDiffUtils.parseUnifiedDiff(ud);
+        assertEquals(rev, parsed.applyFuzzy(new java.util.ArrayList<>(orig), 0));
+    }
+
+    @Test
+    void pinWordInlineDiffsKeepHtmlEntitiesWhole() { // java-diff-utils/8
+        DiffRowGenerator gen = DiffRowGenerator.create().showInlineDiffs(true).inlineDiffByWord(true).oldTag(f -> f ? "[-" : "-]").newTag(f -> f ? "{+" : "+}").build();
+        assertEquals("a[-&lt;-]b", gen.generateDiffRows(Arrays.asList("a<b"), Arrays.asList("a>b")).get(0).getOldLine());
+    }
+
+    @Test
+    void pinColumnWidthWrappingDoesNotBreakBeforeASupplementaryCharacter() { // java-diff-utils/9
+        DiffRowGenerator gen = DiffRowGenerator.create().columnWidth(1).lineNormalizer(s -> s).build();
+        assertEquals("\uD83D\uDE00", gen.generateDiffRows(Arrays.asList("\uD83D\uDE00"), Arrays.asList("\uD83D\uDE00")).get(0).getOldLine());
+    }
+
+    @Test
+    void pinMergeConflictOutputHandlesAChunkPastTheEnd() throws Exception { // java-diff-utils/10
+        Patch<String> patch = DiffUtils.diff(Arrays.asList("a", "b", "c", "d"), Arrays.asList("a", "x", "y", "z"));
+        patch.withConflictOutput(Patch.CONFLICT_PRODUCES_MERGE_CONFLICT);
+        assertEquals(Arrays.asList("a", "<<<<<< HEAD", "q", "======", "b", "c", "d", ">>>>>>> PATCH"), patch.applyTo(Arrays.asList("a", "q")));
+    }
+
+    @Test
+    void pinReaderRejectsAShortDiffLineWithAParserException() throws Exception { // java-diff-utils/11
+        String text = "diff x\n--- a\n+++ b\n@@ -1,1 +1,1 @@\n-a\n+b\n";
+        try {
+            UnifiedDiff diff = UnifiedDiffReader.parseUnifiedDiff(new ByteArrayInputStream(text.getBytes(StandardCharsets.UTF_8)));
+            assertEquals(1, diff.getFiles().size());
+        } catch (UnifiedDiffParserException expected) {
+            // a malformed diff command line may be rejected, but only with the documented exception
+        }
+    }
+}
