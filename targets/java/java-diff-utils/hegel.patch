+            boolean markupDespiteUnchanged = inline && unchanged; // java-diff-utils/4: reportLinesUnchanged is ignored by the inline diff
+            String tag = "inline=" + inline + " byWord=" + byWord + " merge=" + merge + " unchanged=" + unchanged + " ignoreWs=" + ignoreWs + " decompress=" + decompress + " width=" + width + " html=" + html + " " + show(orig) + " -> " + show(rev);
+            java.util.function.Function<String, String> norm = s -> {
+                String t = html && !unchanged ? s.replace("<", "&lt;").replace(">", "&gt;").replace("\t", "    ") : s;
+                return t;
+            };
+            java.util.function.Function<String, String> unwrap = s -> width == 0 ? s : s.replace("<br/>", "");
+            List<String> oldSide = new ArrayList<>(), newSide = new ArrayList<>();
+            int equalRows = 0;
+            for (DiffRow r : rows) {
+                final DiffRow rf = r;
+                check(r.getOldLine() != null && r.getNewLine() != null && r.getTag() != null, () -> "row with nulls " + rf);
+                String o = unwrap.apply(r.getOldLine()), nw = unwrap.apply(r.getNewLine());
+                if (!tagsCrossRows && !tagsSplit) {
+                    check(balanced(o, OLD_OPEN, OLD_CLOSE) && balanced(nw, NEW_OPEN, NEW_CLOSE) && balanced(o, NEW_OPEN, NEW_CLOSE), () -> "unbalanced tags in " + rf + " for " + tag);
+                }
+                if (html && inline && !(byWord)) { // java-diff-utils/8: the word splitter tears "&lt;"/"&gt;" apart, so tags land inside entities
+                    check(!entityTorn(o) && !entityTorn(nw), () -> "a tag inside an HTML entity in " + rf + " for " + tag);
+                }
+                if (width > 0) {
+                    boolean surrogates = orig.stream().anyMatch(l -> l.codePoints().anyMatch(Character::isSupplementaryCodePoint)) || rev.stream().anyMatch(l -> l.codePoints().anyMatch(Character::isSupplementaryCodePoint));
+                    if (!surrogates) { // java-diff-utils/9: a supplementary character at a break yields a leading or doubled <br/>
+                        check(!r.getOldLine().startsWith("<br/>") && !r.getOldLine().contains("<br/><br/>") && !r.getNewLine().startsWith("<br/>") && !r.getNewLine().contains("<br/><br/>"), () -> "misplaced <br/> in " + rf + " for " + tag);
+                    }
+                }
+                if (unchanged && !markupDespiteUnchanged) {
+                    check(o.equals(r.getOldLine()) && !o.contains(OLD_OPEN) && !nw.contains(NEW_OPEN) && !o.contains(NEW_OPEN), () -> "reportLinesUnchanged but markup in " + rf + " for " + tag);
+                }
+                switch (r.getTag()) {
+                    case EQUAL:
+                        equalRows++;
+                        check(o.equals(nw), () -> "EQUAL row with different sides " + rf + " for " + tag);
+                        oldSide.add(strip(o));
+                        newSide.add(strip(nw));
+                        break;
+                    case INSERT:
+                        if (merge) {
+                            newSide.add(strip(unchanged ? nw : o));
+                        } else {
+                            check(o.isEmpty(), () -> "INSERT row with an old side " + rf + " for " + tag);
+                            newSide.add(strip(nw));
+                        }
+                        break;
+                    case DELETE:
+                        check(nw.isEmpty(), () -> "DELETE row with a new side " + rf + " for " + tag);
+                        oldSide.add(strip(o));
+                        break;
+                    default:
+                        if (merge) {
+                            // the old side carries both texts; only check the tags below
+                        } else {
+                            oldSide.add(strip(o));
+                            newSide.add(strip(nw));
+                        }
+                }
+            }
+            if (!(inline && !decompress)) {
+                // without inline diffs (or with decompressed deltas) each original line is one row's old side and each revised line one row's new side
+                List<String> wantOld = orig.stream().map(norm).collect(Collectors.toList());
+                List<String> wantNew = rev.stream().map(norm).collect(Collectors.toList());
+                List<String> oldNonEmpty = new ArrayList<>(), wantOldNonEmpty = new ArrayList<>();
+                // CHANGE rows pad the shorter side with "" — compare the concatenations instead of row by row
+                String oldJoined = String.join("\u0001", oldSide), wantOldJoined = String.join("\u0001", wantOld);
+                if (!inline && !merge) {
+                    check(oldSide.stream().filter(s -> !s.isEmpty()).collect(Collectors.toList()).equals(wantOld.stream().filter(s -> !s.isEmpty()).collect(Collectors.toList())), () -> "old sides " + show(oldSide) + " != original " + show(wantOld) + " for " + tag + "\n" + rows);
+                    if (!ignoreWs) {
+                        check(newSide.stream().filter(s -> !s.isEmpty()).collect(Collectors.toList()).equals(wantNew.stream().filter(s -> !s.isEmpty()).collect(Collectors.toList())), () -> "new sides " + show(newSide) + " != revised " + show(wantNew) + " for " + tag + "\n" + rows);
+                    }
+                }
+            }
+            if (!inline && !merge) {
+                check(rows.size() >= Math.max(orig.size(), rev.size()) && rows.size() <= orig.size() + rev.size(), () -> "row count " + rows.size() + " for " + tag);
+            }
+            if (orig.equals(rev)) {
+                final int eqRows = equalRows;
+                check(rows.size() == orig.size() && eqRows == rows.size(), () -> "identical texts gave non-EQUAL rows " + rows + " for " + tag);
+            }
+            if (inline && !merge && !unchanged && !tagsCrossRows && !tagsSplit) {
+                // every INSERT/CHANGE new side that differs from the old side carries a new tag, every DELETE old side an old tag
+                for (DiffRow r : rows) {
+                    final DiffRow rf = r;
+                    if (r.getTag() == DiffRow.Tag.DELETE) {
+                        check(r.getOldLine().startsWith(OLD_OPEN) && r.getOldLine().endsWith(OLD_CLOSE), () -> "inline DELETE row not wrapped in old tags " + rf + " for " + tag);
+                    }
+                    if (r.getTag() == DiffRow.Tag.INSERT) {
+                        check(r.getNewLine().startsWith(NEW_OPEN) && r.getNewLine().endsWith(NEW_CLOSE), () -> "inline INSERT row not wrapped in new tags " + rf + " for " + tag);
+                    }
+                    if (r.getTag() == DiffRow.Tag.CHANGE) {
+                        String o = unwrap.apply(r.getOldLine()), nw = unwrap.apply(r.getNewLine());
+                        boolean oTagged = o.contains(OLD_OPEN), nTagged = nw.contains(NEW_OPEN);
+                        check(oTagged || nTagged || strip(o).equals(strip(nw)) || ignoreWs || byWord, () -> "inline CHANGE row without any tag although the sides differ " + rf + " for " + tag);
+                        // the tagged parts are exactly what the untagged remainders miss: removing the tagged spans from both sides leaves equal text
+                        // (only for single-line changes: a multi-line change is diffed as one text, so common text may sit on different rows of the two sides,
+                        // as in ["a"] -> ["b", "a b"] giving [CHANGE,a,{+b+}] then [CHANGE,,a{+ b+}])
+                        String oRest = o.replaceAll(Pattern.quote(OLD_OPEN) + ".*?" + Pattern.quote(OLD_CLOSE), "");
+                        String nRest = nw.replaceAll(Pattern.quote(NEW_OPEN) + ".*?" + Pattern.quote(NEW_CLOSE), "");
+                        if (!ignoreWs && width == 0 && !multiLineChange) {
+                            check(oRest.equals(nRest), () -> "inline CHANGE row: the untagged remainders differ: \"" + oRest + "\" vs \"" + nRest + "\" in " + rf + " for " + tag);
+                        }
+                    }
+                }
+            }
+            // the README's example of the character-wise inline diff
+            if (!inline && !merge && !unchanged && !ignoreWs && width == 0 && !html) {
+                DiffRowGenerator g2 = DiffRowGenerator.create().showInlineDiffs(true).inlineDiffByWord(true).oldTag(f -> "~").newTag(f -> "**").build();
+                List<DiffRow> r2 = g2.generateDiffRows(Arrays.asList("This is a test sentence.", "This is the second line.", "And here is the finish."), Arrays.asList("This is a test for diffutils.", "This is the second line."));
+                check(r2.size() == 3 && r2.get(0).toString().equals("[CHANGE,This is a test ~sentence~.,This is a test **for diffutils**.]") && r2.get(1).toString().equals("[EQUAL,This is the second line.,This is the second line.]") && r2.get(2).toString().equals("[DELETE,~And here is the finish.~,]"), () -> "README side-by-side example: " + r2);
+                DiffRowGenerator g3 = DiffRowGenerator.create().showInlineDiffs(true).mergeOriginalRevised(true).inlineDiffByWord(true).oldTag(f -> "~").newTag(f -> "**").build();
+                List<DiffRow> r3 = g3.generateDiffRows(Arrays.asList("This is a test sentence."), Arrays.asList("This is a test for diffutils."));
+                check(r3.size() == 1 && r3.get(0).getOldLine().equals("This is a test ~sentence~**for diffutils**."), () -> "README merged example: " + r3);
+            }
+        }, Zoo.settings("diffRowsReconstructBothTexts"));
+    }
+
+    // ---- 5. splitters and the whitespace equalizer -----------------------------------------------
+
+    @Test
+    void splittersPreserveTextAndEqualizersFollowTheirRules() {
+        Hegel.test(tc -> {
+            String s = tc.draw(PIECEWISE, "s");
+            boolean respaced = tc.draw(Generators.booleans(), "respaced");
+            List<String> words = DiffRowGenerator.SPLITTER_BY_WORD.apply(s);
+            List<String> chars = DiffRowGenerator.SPLITTER_BY_CHARACTER.apply(s);
+            check(String.join("", words).equals(s), () -> "SPLITTER_BY_WORD loses text: " + show(words) + " for \"" + s + "\"");
+            check(words.stream().noneMatch(String::isEmpty), () -> "SPLITTER_BY_WORD yields an empty piece: " + show(words));
+            check(String.join("", chars).equals(s) && chars.size() == s.length() && chars.stream().allMatch(c -> c.length() == 1), () -> "SPLITTER_BY_CHARACTER: " + show(chars) + " for \"" + s + "\"");
+            // delimiters and words alternate: no two adjacent word pieces, no two adjacent delimiter runs
+            for (int i = 1; i < words.size(); i++) {
+                boolean d1 = DiffRowGenerator.SPLIT_BY_WORD_PATTERN.matcher(words.get(i - 1)).matches();
+                boolean d2 = DiffRowGenerator.SPLIT_BY_WORD_PATTERN.matcher(words.get(i)).matches();
+                final int fi = i;
+                check(d1 || d2, () -> "SPLITTER_BY_WORD pieces " + (fi - 1) + " and " + fi + " are both words: " + show(words));
+            }
+            String t = respaced ? s.replace(" ", "  ").replace("\t", " ") : s;
+            boolean eq = DiffRowGenerator.IGNORE_WHITESPACE_EQUALIZER.test(s, t);
+            boolean want = s.trim().replaceAll("\\s+", " ").equals(t.trim().replaceAll("\\s+", " "));
+            check(eq == want, () -> "IGNORE_WHITESPACE_EQUALIZER(\"" + s + "\", \"" + t + "\") = " + eq + ", want " + want);
+            check(DiffRowGenerator.DEFAULT_EQUALIZER.test(s, t) == s.equals(t), "DEFAULT_EQUALIZER");
+            check(DiffRowGenerator.LINE_NORMALIZER_FOR_HTML.apply(s).equals(s.replace("<", "&lt;").replace(">", "&gt;").replace("\t", "    ")), () -> "LINE_NORMALIZER_FOR_HTML(\"" + s + "\") = " + DiffRowGenerator.LINE_NORMALIZER_FOR_HTML.apply(s));
+        }, Zoo.settings("splittersPreserveTextAndEqualizersFollowTheirRules"));
+    }
+
+    // ---- 6. the multi-file unified diff reader and writer -------------------------------------------
+
+    static UnifiedDiff read(List<String> lines) throws IOException {
+        return UnifiedDiffReader.parseUnifiedDiff(new ByteArrayInputStream((String.join("\n", lines) + "\n").getBytes(StandardCharsets.UTF_8)));
+    }
+
+    @Test
+    void unifiedDiffReaderAndWriterRoundTrip() {
+        Hegel.test(tc -> {
+            Texts texts = tc.draw(texts(20), "texts");
+            List<String> orig = texts.orig(), rev = texts.rev();
+            int context = tc.draw(Generators.sampledFrom(0, 1, 3), "context");
+            Names names = tc.draw(NAMES, "names");
+            String from = names.from(), to = names.to();
+            String header = switch (names.header()) {
+                case NONE -> null;
+                case GIT -> "diff --git a/" + from + " b/" + to;
+                case TEXT -> "some header text";
+            };
+            String tail = names.tail() ? "tail text" : null;
+            Patch<String> patch = DiffUtils.diff(orig, rev);
+            tc.assume(!patch.getDeltas().isEmpty());
+            String tag = "context " + context + ", " + from + " -> " + to + ", header " + header + ", tail " + tail + ", " + show(orig) + " -> " + show(rev);
+            UnifiedDiff diff = UnifiedDiff.from(header, tail, UnifiedDiffFile.from(from, to, patch));
+            List<String> lines = new ArrayList<>();
+            try {
+                UnifiedDiffWriter.write(diff, name -> orig, lines::add, context);
+            } catch (IOException ex) {
+                fail("UnifiedDiffWriter threw " + ex + " for " + tag);
+                return;
+            }
+            int start = 0;
+            while (start < lines.size() && !lines.get(start).startsWith("--- ")) {
+                start++;
+            }
+            final int startF = start;
+            check(start + 1 < lines.size() && lines.get(start).equals("--- " + from) && lines.get(start + 1).equals("+++ " + to), () -> "writer file header at " + startF + ": " + lines + " for " + tag);
+            check(header == null ? start == 0 : lines.get(0).equals(header), () -> "writer header lines " + lines.subList(0, startF) + " for " + tag);
+            int end = lines.size();
+            if (tail != null) {
+                end = lines.indexOf("--");
+                check(end > start && lines.subList(end + 1, lines.size()).equals(Arrays.asList(tail)), () -> "writer tail " + lines + " for " + tag);
+            }
+            if (end > start) {
+                List<String> viaModel = applyUnified(new ArrayList<>(lines.subList(start, end)), orig, tag);
+                check(viaModel.equals(rev), () -> "the writer's diff applied by the model gives " + show(viaModel) + " != " + show(rev) + ":\n" + String.join("\n", lines) + "\nfor " + tag);
+            }
+            try {
+                UnifiedDiff back = read(lines);
+                check(back.getFiles().size() == 1, () -> "reader found " + back.getFiles().size() + " files in\n" + String.join("\n", lines) + "\nfor " + tag);
+                UnifiedDiffFile f = back.getFiles().get(0);
+                check(Objects.equals(f.getFromFile(), from) && Objects.equals(f.getToFile(), to), () -> "reader file names " + f.getFromFile() + " / " + f.getToFile() + " for " + tag);
+                List<String> applied = back.applyPatchTo(name -> name.equals(from), orig);
+                check(applied.equals(rev), () -> "UnifiedDiff.applyPatchTo gave " + show(applied) + " != " + show(rev) + ":\n" + String.join("\n", lines) + "\nfor " + tag);
+                check(f.getPatch().applyTo(orig).equals(rev), () -> "the read file's patch does not apply for " + tag);
+                if (header != null && header.startsWith("diff ")) {
+                    check(header.equals(f.getDiffCommand()), () -> "reader diff command \"" + f.getDiffCommand() + "\" for " + tag);
+                } else {
+                    check(header == null ? back.getHeader() == null || back.getHeader().trim().isEmpty() : back.getHeader().trim().equals(header), () -> "reader header \"" + back.getHeader() + "\" for " + tag);
+                }
+                check(tail == null ? back.getTail() == null || back.getTail().trim().isEmpty() : back.getTail().trim().equals(tail), () -> "reader tail \"" + back.getTail() + "\" for " + tag);
+                UnifiedDiff back2 = read(UnifiedDiffUtils.generateUnifiedDiff(from, to, orig, patch, context));
+                check(back2.getFiles().size() == 1 && back2.applyPatchTo(name -> true, orig).equals(rev), () -> "the reader on UnifiedDiffUtils' output: " + back2.getFiles().size() + " files, " + tag);
+            } catch (IOException | PatchFailedException | RuntimeException ex) {
+                fail("reading the written diff failed: " + ex + "\n" + String.join("\n", lines) + "\nfor " + tag);
+            }
+        }, Zoo.settings("unifiedDiffReaderAndWriterRoundTrip"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..b19422a
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,88 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
