+    /**
+     * normalizeSpace against the model and its own idempotence. A string with U+00A0 is commons-lang/9's shape (the
+     * character is turned into a space but not collapsed): judged by default, left out under HEGEL_NO_KNOWN.
+     */
+    static void checkNormalizeSpace(String s, String ctx) {
+        if (Zoo.NO_KNOWN && s.indexOf(0xa0) >= 0) {
+            Zoo.count("not checked: normalizeSpace of a string with U+00A0 (commons-lang/9)");
+            return;
+        }
+        eq("normalizeSpace" + ctx, StringUtils.normalizeSpace(s), modelNormalizeSpace(s));
+        eq("normalizeSpace is idempotent" + ctx, StringUtils.normalizeSpace(StringUtils.normalizeSpace(s)), StringUtils.normalizeSpace(s));
+    }
