+
+    @Test
+    void shortClassNameOfAnArrayOfADescriptorLetterClass() {
+        Zoo.run("shortClassNameOfAnArrayOfADescriptorLetterClass", tc -> {
+            CommonsLangMoreTest.checkClassName(tc.draw(DESCRIPTOR_CLASS, "class"));
+        });
+    }
+
+    // ------------------------------------------------------------------ commons-lang/11
+
+    /** A plus sign with the l/L suffix; beside it (HEGEL_NO_KNOWN) the other signs with l/L, or the plus with the other suffixes. */
+    static final Generator<String> DIGITS = tuples(word("123456789", 1, 1), word(CommonsLangMoreTest.DEC, 0, 22)).map(t -> t.value1() + t.value2());
