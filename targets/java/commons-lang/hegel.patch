+    /**
+     * join(Object[], String, start, end): the joined sublist on a valid range, the documented
+     * ArrayIndexOutOfBoundsException on an invalid one ({@code start < 0}, {@code start >= length}, {@code end < 0},
+     * {@code end > length}; commons-lang/3's shape, judged by default and left out under HEGEL_NO_KNOWN).
+     */
+    static void checkJoinRange(String[] parts, String sep, int st, int en, String ctx) {
+        String what = "join(Object[], String, " + st + ", " + en + ")" + ctx;
+        boolean valid = st >= 0 && st < parts.length && en >= 0 && en <= parts.length;
+        if (valid) {
+            eq(what, StringUtils.join(parts, sep, st, en), String.join(sep, Arrays.asList(parts).subList(st, Math.max(st, en))));
+        } else if (Zoo.NO_KNOWN) {
+            Zoo.count("not checked: join with an invalid range (commons-lang/3)");
+        } else {
+            Assertions.assertThrows(ArrayIndexOutOfBoundsException.class, () -> StringUtils.join(parts, sep, st, en), what);
+        }
+    }
