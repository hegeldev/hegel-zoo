+
+/**
+ * Apache Commons Lang, part 2: numbers, fractions, bit conversions, character sets, the small utility tables,
+ * ranges, durations and dates, builders, mutables, tuples and serialization.
+ *
+ * <p>The generators are values (see {@link CommonsLangTest}); the recorded bugs' shapes are drawn by default and
+ * judged, so the wide properties fail on them: a plus sign with the L suffix (commons-lang/11), pow(+-1) of an
+ * unreduced fraction (/8), the hex digits 10..15 (/7), a null member of a bit vector's Iterable (/2), an array of a
+ * default-package class named like a descriptor letter (/10), a negative random-string count's message (/6).
+ * {@code HEGEL_NO_KNOWN=1} ({@link Zoo#NO_KNOWN}) switches the shapes off; {@link CommonsLangShapesTest} has one
+ * narrow property per bug.
+ */
+class CommonsLangMoreTest {
+
+    static final TimeZone UTC = TimeZone.getTimeZone("UTC");
+
+    static {
+        TimeZone.setDefault(UTC);
+    }
+
+    static void eq(String what, Object got, Object want) {
+        check(Objects.equals(got, want), () -> what + ": got " + show(got) + ", want " + show(want));
+    }
+
+    static void throwsA(Class<? extends Throwable> type, Supplier<?> call, String what) {
+        try {
+            Object r = call.get();
+            fail(what + ": expected " + type.getSimpleName() + ", got " + show(r));
+        } catch (Throwable t) {
+            check(type.isInstance(t), () -> what + ": expected " + type.getSimpleName() + ", got " + t);
+        }
+    }
+
+    // ------------------------------------------------------------------ NumberUtils
+
+    /** A text for createNumber, in one of its grammar's shapes. */
+    sealed interface NumText permits Integral, Decimal, Hex, Octal, Junk {
+        String text();
+    }
+
+    /** An integral without a leading zero, with an optional type suffix (l, f or d in either case). */
+    record Integral(String sign, String digits, String suffix) implements NumText {
+        public String text() {
+            return sign + digits + suffix;
+        }
+    }
+
+    /** A decimal with a point, an optional exponent and an optional f/d suffix. */
+    record Decimal(String sign, String intPart, String frac, String exp, String suffix) implements NumText {
+        public String text() {
+            return body() + suffix;
+        }
+
+        String body() {
+            return sign + intPart + "." + frac + exp;
+        }
+    }
+
+    /** A hexadecimal with the 0x, 0X or # prefix. */
+    record Hex(String sign, String prefix, String hex) implements NumText {
+        public String text() {
+            return sign + prefix + hex;
+        }
+    }
+
+    /** An octal (a leading zero); with {@code badAt >= 0} the digit at that position (modulo the length) is an 8 or a 9, which makes it invalid. */
+    record Octal(String sign, String oct, int badAt, String badDigit) implements NumText {
+        boolean bad() {
+            return badAt >= 0;
+        }
+
+        String digits() {
+            if (!bad()) {
+                return oct;
+            }
+            int at = Math.floorMod(badAt, oct.length());
+            return oct.substring(0, at) + badDigit + oct.substring(at + 1);
+        }
+
+        public String text() {
+            return sign + "0" + digits();
+        }
+    }
+
+    /** One of the texts createNumber must reject. */
+    record Junk(String text) implements NumText {}
+
+    static final Generator<String> SIGN = pick("", "", "-", "+");
+    static final String DEC = "0123456789";
+    static final Generator<String> TYPE_SUFFIX = pick("l", "L", "f", "F", "d", "D");
+
+    static final Generator<NumText> INTEGRAL = tuples(SIGN, tuples(word("123456789", 1, 1), word(DEC, 0, 22)).map(t -> t.value1() + t.value2()), maybe(50, "", TYPE_SUFFIX))
+        .<NumText>map(t -> new Integral(t.value1(), t.value2(), t.value3()));
+
+    static final Generator<String> EXPONENT = tuples(pick("e", "E"), pick("", "-", "+"), word(DEC, 1, 3)).map(t -> t.value1() + t.value2() + t.value3());
+
+    static final Generator<NumText> DECIMAL = tuples(SIGN, word(DEC, 0, 10).flatMap(ip -> tuples(just(ip), word(DEC, ip.isEmpty() ? 1 : 0, 12))), maybe(40, "", EXPONENT), maybe(50, "", pick("f", "F", "d", "D")))
+        .<NumText>map(t -> new Decimal(t.value1(), t.value2().value1(), t.value2().value2(), t.value3(), t.value4()));
+
+    static final Generator<NumText> HEX = tuples(SIGN, pick("0x", "0X", "#"), word("0123456789abcdefABCDEF", 1, 20)).<NumText>map(t -> new Hex(t.value1(), t.value2(), t.value3()));
+
+    static final Generator<NumText> OCTAL = tuples(SIGN, word("01234567", 1, 24), maybe(30, -1, INDEX), pick("8", "9")).<NumText>map(t -> new Octal(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    static final Generator<NumText> JUNK = pick("", " ", "1..2", "1e", "-", "1.5L", "0x", "1_0", "1 ", " 1", "--1", "+-1", "1e5e5", "1ff", "1dd", ".", "e5", "0x1.8", "1.2.3", "abc").<NumText>map(Junk::new);
+
+    /** A number text: integral (2), decimal (2), hexadecimal, octal, junk (1 each). */
+    static final Generator<NumText> NUM = weighted(w(2, INTEGRAL), w(2, DECIMAL), w(1, HEX), w(1, OCTAL), w(1, JUNK));
+
+    /** An int and a double (NaN one time in seven) for the min/max functions. */
+    static final Generator<Tuple2<Integer, Double>> SAMPLE = tuples(ints(-100, 100), weighted(w(85, ints(-100, 100).map(i -> i / 4.0)), v(15, Double.NaN)));
+
+    record NumCase(NumText num, List<Tuple2<Integer, Double>> samples) {}
+
+    static final Generator<NumCase> NUM_CASE = tuples(NUM, many(SAMPLE, 1, 6)).map(t -> new NumCase(t.value1(), t.value2()));
+
+    /**
+     * createNumber on an integral: the Integer -> Long -> BigInteger ladder, the l/f/d suffixes with their promotions,
+     * isCreatable, isParsable, the toX and createX functions. A plus sign with the L suffix is commons-lang/11's shape
+     * (rejected as "not a valid number"): judged by default, left out under HEGEL_NO_KNOWN.
+     */
+    static void checkIntegral(Integral in) {
+        String text = in.text();
+        String digits = in.digits();
+        String suffix = in.suffix();
+        String ctx = " for " + show(text);
+        if (Zoo.NO_KNOWN && in.sign().equals("+") && suffix.equalsIgnoreCase("l")) {
+            Zoo.count("not checked: createNumber of a plus sign with the L suffix (commons-lang/11)");
+            return;
+        }
+        BigInteger value = new BigInteger(in.sign().equals("-") ? "-" + digits : digits);
+        Number got;
+        try {
+            got = NumberUtils.createNumber(text);
+        } catch (RuntimeException e) {
+            fail("createNumber threw " + e + ctx);
+            return;
+        }
+        eq("isCreatable" + ctx, NumberUtils.isCreatable(text), true);
+        String wantType;
+        switch (suffix.toLowerCase(Locale.ROOT)) {
+            case "" -> wantType = value.bitLength() < 32 ? "Integer" : value.bitLength() < 64 ? "Long" : "BigInteger";
+            case "l" -> wantType = value.bitLength() < 64 ? "Long" : "BigInteger";
+            case "f" -> wantType = Float.isInfinite(Float.parseFloat(digits)) ? Double.isInfinite(Double.parseDouble(digits)) ? "BigDecimal" : "Double" : "Float";
+            default -> wantType = Double.isInfinite(Double.parseDouble(digits)) ? "BigDecimal" : "Double";
+        }
+        eq("createNumber type" + ctx, got.getClass().getSimpleName(), wantType);
+        // the value: exact for integral types, the closest float/double otherwise
+        if (got instanceof Float f) {
+            eq("createNumber value" + ctx, f, (float) value.doubleValue());
+        } else if (got instanceof Double d) {
+            eq("createNumber value" + ctx, d, value.doubleValue());
+        } else {
+            eq("createNumber value" + ctx, new BigDecimal(got.toString()).toBigIntegerExact(), value);
+        }
+        if (suffix.isEmpty()) {
+            eq("isParsable" + ctx, NumberUtils.isParsable(text), true);
+            eq("toInt" + ctx, NumberUtils.toInt(text, 7), value.bitLength() < 32 ? value.intValue() : 7);
+            eq("toLong" + ctx, NumberUtils.toLong(text, 7L), value.bitLength() < 64 ? value.longValue() : 7L);
+            eq("toDouble" + ctx, NumberUtils.toDouble(text, 7.5), value.doubleValue());
+            eq("createBigInteger" + ctx, NumberUtils.createBigInteger(text), value);
+        } else {
+            eq("toInt with suffix" + ctx, NumberUtils.toInt(text, 7), 7);
+        }
+    }
+
+    /** createNumber on a decimal with an optional exponent: Float -> Double -> BigDecimal, promoted when the digits would be lost. */
+    static void checkDecimal(Decimal dec) {
+        String text = dec.text();
+        String suffix = dec.suffix();
+        String ctx = " for " + show(text);
+        BigDecimal value = new BigDecimal(dec.body());
+        Number got;
+        try {
+            got = NumberUtils.createNumber(text);
+        } catch (RuntimeException e) {
+            fail("createNumber threw " + e + ctx);
+            return;
+        }
+        eq("isCreatable" + ctx, NumberUtils.isCreatable(text), true);
+        String type = got.getClass().getSimpleName();
+        check(type.equals("Float") || type.equals("Double") || type.equals("BigDecimal"), () -> "createNumber type " + type + ctx);
+        if (suffix.toLowerCase(Locale.ROOT).equals("d")) {
+            check(!type.equals("Float"), () -> "d suffix gave a Float" + ctx);
+        }
+        // without a suffix, printing the result back must give the same number (that is what the promotion promises);
+        // an explicit f/d suffix asks for that type and accepts its precision
+        BigDecimal back = new BigDecimal(got.toString());
+        boolean zero = value.signum() == 0;
+        String body = dec.body();
+        if (!suffix.isEmpty()) {
+            // overflow or underflow of the requested type promotes to the next one
+            float f = Float.parseFloat(body);
+            double dd = Double.parseDouble(body);
+            if (suffix.equalsIgnoreCase("f") && !Float.isInfinite(f) && (f != 0.0f || zero)) {
+                eq("createNumber F suffix" + ctx, got, f);
+            } else if (!Double.isInfinite(dd) && (dd != 0.0 || zero)) {
+                eq("createNumber D suffix" + ctx, got, dd);
+            } else {
+                eq("createNumber overflowing suffix" + ctx, back.compareTo(value) == 0, true);
+            }
+        } else if (zero) {
+            check(back.signum() == 0, () -> "createNumber of a zero" + ctx + ": " + got);
+        } else if (got instanceof Float || got instanceof Double) {
+            double d = got.doubleValue();
+            check(!Double.isInfinite(d) && d != 0.0, () -> "createNumber lost the magnitude" + ctx + ": " + got);
+            eq("createNumber round trip" + ctx, back.compareTo(value) == 0, true);
+        } else {
+            eq("createNumber BigDecimal" + ctx, back.compareTo(value) == 0, true);
+        }
+        if (suffix.isEmpty()) {
+            eq("isParsable" + ctx, NumberUtils.isParsable(text), true);
+            eq("toDouble" + ctx, NumberUtils.toDouble(text, 7.5), value.doubleValue());
+            eq("createDouble" + ctx, NumberUtils.createDouble(text), value.doubleValue());
+        }
+    }
+
+    /** createNumber on a hexadecimal: leading zeros ignored, the width decides Integer / Long / BigInteger. */
+    static void checkHex(Hex h) {
+        String text = h.text();
+        String ctx = " for " + show(text);
+        BigInteger magnitude = new BigInteger(h.hex(), 16);
+        BigInteger value = h.sign().equals("-") ? magnitude.negate() : magnitude;
+        Number got;
+        try {
+            got = NumberUtils.createNumber(text);
+        } catch (RuntimeException e) {
+            fail("createNumber threw " + e + ctx);
+            return;
+        }
+        String stripped = h.hex().replaceFirst("^0+", "");
+        int digits = stripped.length();
+        char first = digits == 0 ? '0' : stripped.charAt(0);
+        String wantType = digits > 16 || digits == 16 && first > '7' ? "BigInteger" : digits > 8 || digits == 8 && first > '7' ? "Long" : "Integer";
+        eq("createNumber hex type" + ctx, got.getClass().getSimpleName(), wantType);
+        eq("createNumber hex value" + ctx, new BigInteger(got.toString()), value);
+        eq("isCreatable hex" + ctx, NumberUtils.isCreatable(text), true);
+        eq("isParsable hex" + ctx, NumberUtils.isParsable(text), false);
+    }
+
+    /** createNumber on an octal: Integer / Long / BigInteger by value; an 8 or 9 makes it invalid. */
+    static void checkOctal(Octal o) {
+        String text = o.text();
+        String ctx = " for " + show(text);
+        if (o.bad()) {
+            throwsA(NumberFormatException.class, () -> NumberUtils.createNumber(text), "createNumber of a bad octal" + ctx);
+            eq("isCreatable bad octal" + ctx, NumberUtils.isCreatable(text), false);
+            return;
+        }
+        BigInteger magnitude = new BigInteger(o.oct(), 8);
+        BigInteger value = o.sign().equals("-") ? magnitude.negate() : magnitude;
+        Number got;
+        try {
+            got = NumberUtils.createNumber(text);
+        } catch (RuntimeException e) {
+            fail("createNumber threw " + e + ctx);
+            return;
+        }
+        eq("createNumber octal value" + ctx, new BigInteger(got.toString()), value);
+        eq("createNumber octal type" + ctx, got.getClass().getSimpleName(), value.bitLength() < 32 ? "Integer" : value.bitLength() < 64 ? "Long" : "BigInteger");
+        eq("isCreatable octal" + ctx, NumberUtils.isCreatable(text), true);
+    }
+
+    /** createNumber rejects junk; the to* functions give their defaults. */
+    static void checkJunk(Junk j) {
+        String text = j.text();
+        String ctx = " for " + show(text);
+        throwsA(NumberFormatException.class, () -> NumberUtils.createNumber(text), "createNumber of junk" + ctx);
+        eq("isCreatable junk" + ctx, NumberUtils.isCreatable(text), false);
+        eq("toInt junk" + ctx, NumberUtils.toInt(text, 7), 7);
+        if (!text.isBlank() && text.trim().equals(text)) {
+            eq("toDouble junk" + ctx, NumberUtils.toDouble(text, 7.5), 7.5);
+        }
+    }
+
+    @Test
+    void numberUtilsCreateNumberFollowsItsGrammar() {
+        Zoo.run("numberUtilsCreateNumberFollowsItsGrammar", tc -> {
+            NumCase c = tc.draw(NUM_CASE, "case");
+            String text = c.num().text();
+            switch (c.num()) {
+                case Integral i -> checkIntegral(i);
+                case Decimal d -> checkDecimal(d);
+                case Hex h -> checkHex(h);
+                case Octal o -> checkOctal(o);
+                case Junk j -> checkJunk(j);
+            }
+            // min / max over arrays, NaN handling in NumberUtils (propagates) versus IEEE754rUtils (ignores)
+            int len = c.samples().size();
+            int[] ints = new int[len];
+            double[] doubles = new double[len];
+            boolean anyNaN = false;
+            for (int i = 0; i < len; i++) {
+                ints[i] = c.samples().get(i).value1();
+                doubles[i] = c.samples().get(i).value2();
+                anyNaN |= Double.isNaN(doubles[i]);
+            }
+            eq("NumberUtils.max(int...)", NumberUtils.max(ints), Arrays.stream(ints).max().getAsInt());
+            eq("NumberUtils.min(int...)", NumberUtils.min(ints), Arrays.stream(ints).min().getAsInt());
+            double maxIgnoring = Arrays.stream(doubles).filter(d -> !Double.isNaN(d)).max().orElse(Double.NaN);
+            double minIgnoring = Arrays.stream(doubles).filter(d -> !Double.isNaN(d)).min().orElse(Double.NaN);
+            eq("IEEE754rUtils.max ignores NaN for " + Arrays.toString(doubles), IEEE754rUtils.max(doubles), maxIgnoring);
+            eq("IEEE754rUtils.min ignores NaN for " + Arrays.toString(doubles), IEEE754rUtils.min(doubles), minIgnoring);
+            eq("NumberUtils.max(double...) propagates NaN for " + Arrays.toString(doubles), Double.isNaN(NumberUtils.max(doubles)), anyNaN);
+            if (!anyNaN) {
+                eq("NumberUtils.max(double...)", NumberUtils.max(doubles), maxIgnoring);
+                eq("NumberUtils.min(double...)", NumberUtils.min(doubles), minIgnoring);
+            }
+            eq("compare(int,int)", NumberUtils.compare(ints[0], ints[len - 1]), Integer.compare(ints[0], ints[len - 1]));
+            eq("isDigits", NumberUtils.isDigits(text), !text.isEmpty() && text.chars().allMatch(Character::isDigit));
+        });
+    }
+
+    /** Known bug commons-lang/11: createNumber("+7L") throws "+7L is not a valid number" while "+7", "-7L", "+7f", "+7d" and "+0x7" are all accepted. */
+    @Test
+    void pinCreateNumberAcceptsAPlusWithTheLongSuffix() {
+        Assertions.assertEquals(7L, NumberUtils.createNumber("+7L"));
+    }
+
+    // ------------------------------------------------------------------ Fraction
+
+    static BigInteger[] rational(long n, long d) {
+        BigInteger bn = BigInteger.valueOf(n);
+        BigInteger bd = BigInteger.valueOf(d);
+        if (bd.signum() < 0) {
+            bn = bn.negate();
+            bd = bd.negate();
+        }
+        BigInteger g = bn.gcd(bd);
+        if (g.signum() == 0) {
+            g = BigInteger.ONE;
+        }
+        return new BigInteger[] {bn.divide(g), bd.divide(g)};
+    }
+
+    static void eqFraction(String what, Fraction got, BigInteger[] want) {
+        check(BigInteger.valueOf(got.getNumerator()).equals(want[0]) && BigInteger.valueOf(got.getDenominator()).equals(want[1]),
+            () -> what + ": got " + got + " (" + got.getNumerator() + "/" + got.getDenominator() + "), want " + want[0] + "/" + want[1]);
+    }
+
+    /** Two fractions' parts and a power. */
+    record FracCase(int n1, int d1, int n2, int d2, int p) {}
+
+    static final Generator<Integer> PART = ints(-60, 60);
