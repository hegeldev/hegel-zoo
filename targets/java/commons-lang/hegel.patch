+                lo++;
+            }
+        }
+        if (end) {
+            while (hi > lo && (stripChars == null ? Character.isWhitespace(s.charAt(hi - 1)) : stripChars.indexOf(s.charAt(hi - 1)) >= 0)) {
+                hi--;
+            }
+        }
+        return s.substring(lo, hi);
+    }
+
+    static String modelTrim(String s) {
