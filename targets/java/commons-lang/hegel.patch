+    /**
+     * ArrayUtils.insert(index, array, values...) against the list model; out of range it documents
+     * IndexOutOfBoundsException, which it skips when there are no values (commons-lang/5's shape: judged by default,
+     * left out under HEGEL_NO_KNOWN).
+     */
+    static void checkInsert(int[] arr, int a, int[] vals, String ctx) {
+        List<Integer> model = asList(arr);
+        if (a >= 0 && a <= arr.length) {
+            List<Integer> want = new ArrayList<>(model);
+            want.addAll(a, asList(vals));
+            eq("insert(" + a + ", arr, " + Arrays.toString(vals) + ")" + ctx, asList(ArrayUtils.insert(a, arr, vals)), want);
+        } else if (Zoo.NO_KNOWN && vals.length == 0) {
+            Zoo.count("not checked: an out-of-range insert without values (commons-lang/5)");
+        } else {
+            Assertions.assertThrows(IndexOutOfBoundsException.class, () -> ArrayUtils.insert(a, arr, vals), "insert(" + a + ", arr, " + Arrays.toString(vals) + ") out of range" + ctx);
+        }
+    }
