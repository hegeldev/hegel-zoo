+    /** The positional grammar of CharSet.getInstance: "^a-z", "a-z", "^a", "a" tried at each position. */
+    static java.util.function.IntPredicate modelCharSet(String set) {
+        List<java.util.function.IntPredicate> ranges = new ArrayList<>();
+        int len = set.length();
+        int pos = 0;
+        while (pos < len) {
+            int remainder = len - pos;
+            if (remainder >= 4 && set.charAt(pos) == '^' && set.charAt(pos + 2) == '-') {
+                char lo = set.charAt(pos + 1);
+                char hi = set.charAt(pos + 3);
+                char a = (char) Math.min(lo, hi);
+                char b = (char) Math.max(lo, hi);
+                ranges.add(c -> c < a || c > b);
+                pos += 4;
+            } else if (remainder >= 3 && set.charAt(pos + 1) == '-') {
+                char lo = set.charAt(pos);
+                char hi = set.charAt(pos + 2);
+                char a = (char) Math.min(lo, hi);
+                char b = (char) Math.max(lo, hi);
+                ranges.add(c -> c >= a && c <= b);
+                pos += 3;
+            } else if (remainder >= 2 && set.charAt(pos) == '^') {
+                char x = set.charAt(pos + 1);
+                ranges.add(c -> c != x);
+                pos += 2;
+            } else {
+                char x = set.charAt(pos);
+                ranges.add(c -> c == x);
+                pos += 1;
+            }
+        }
+        return c -> ranges.stream().anyMatch(r -> r.test(c));
+    }
