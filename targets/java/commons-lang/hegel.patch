+    // ------------------------------------------------------------------ generators
+
+    /** A string of ASCII words, spaces, punctuation, a few non-ASCII letters and surrogate pairs (never a lone surrogate). */
+    static String anyStr(TestCase tc, int maxPieces) {
+        StringBuilder sb = new StringBuilder();
+        int pieces = n(tc, 0, maxPieces);
+        for (int k = 0; k < pieces; k++) {
+            switch (n(tc, 0, 9)) {
+                case 0, 1, 2 -> sb.append(Zoo.word(tc, "abcABC", 1, 4));
+                case 3 -> sb.append(Zoo.word(tc, "012", 1, 3));
+                case 4 -> sb.append(Zoo.word(tc, " ", 1, 3));
+                case 5 -> sb.append(Zoo.word(tc, ".,-_:/", 1, 2));
+                case 6 -> sb.append(pick(tc, "é", "İ", "ß", "\u00a0", "\t", "\n", "\r\n", "\u0000", " "));
+                case 7 -> sb.append("😀");
+                default -> sb.append(Zoo.word(tc, "aA ", 1, 5));
+            }
+        }
+        return sb.toString();
+    }
+
+    @SafeVarargs
+    static <T> T pickN(TestCase tc, T... opts) {
+        return opts[n(tc, 0, opts.length - 1)];
+    }
+
+    static boolean wellFormed(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 >= s.length() || !Character.isLowSurrogate(s.charAt(i + 1))) {
+                    return false;
+                }
+                i++;
+            } else if (Character.isLowSurrogate(c)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static boolean hasPair(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            if (Character.isSurrogate(s.charAt(i))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static void eq(String what, Object got, Object want) {
+        check(java.util.Objects.equals(got, want), () -> what + ": got " + show(got) + ", want " + show(want));
+    }
+
+    // ------------------------------------------------------------------ models: substrings and padding
+
+    static String modelSubstring(String s, int start) {
+        if (start < 0) {
+            start = s.length() + start;
+        }
+        if (start < 0) {
+            start = 0;
+        }
+        if (start > s.length()) {
+            return "";
+        }
+        return s.substring(start);
+    }
+
+    static String modelSubstring(String s, int start, int end) {
+        if (end < 0) {
+            end = s.length() + end;
+        }
+        if (start < 0) {
+            start = s.length() + start;
+        }
+        if (end > s.length()) {
+            end = s.length();
+        }
+        if (start > end) {
+            return "";
+        }
+        if (start < 0) {
+            start = 0;
+        }
+        if (end < 0) {
+            end = 0;
+        }
+        return s.substring(start, end);
+    }
+
+    static String modelLeft(String s, int len) {
+        if (len < 0) {
+            return "";
+        }
+        return s.length() <= len ? s : s.substring(0, len);
+    }
+
+    static String modelRight(String s, int len) {
+        if (len < 0) {
+            return "";
+        }
+        return s.length() <= len ? s : s.substring(s.length() - len);
+    }
+
+    static String modelMid(String s, int pos, int len) {
+        if (len < 0 || pos > s.length()) {
+            return "";
+        }
+        if (pos < 0) {
+            pos = 0;
+        }
+        if (s.length() - pos <= len) {
+            return s.substring(pos);
+        }
+        return s.substring(pos, pos + len);
+    }
+
+    /** abbreviate(str, marker, offset, maxWidth) as its example table defines it (strings without surrogate pairs). */
+    static String modelAbbreviate(String str, String marker, int offset, int maxWidth) {
+        if (str.isEmpty()) {
+            return str;
+        }
+        if (marker == null) {
+            marker = "";
+        }
+        int markerLen = marker.length();
+        if (maxWidth < markerLen + 1) {
+            throw new IllegalArgumentException("min width");
+        }
+        int strLen = str.length();
+        if (strLen <= maxWidth) {
+            return str;
+        }
+        if (strLen - offset <= maxWidth - markerLen) {
+            return marker + str.substring(strLen - (maxWidth - markerLen));
+        }
+        if (offset <= markerLen + 1) {
+            return str.substring(0, maxWidth - markerLen) + marker;
+        }
+        if (maxWidth < 2 * markerLen + 1) {
+            throw new IllegalArgumentException("min width with offset");
+        }
+        return marker + modelAbbreviate(str.substring(offset), marker, 0, maxWidth - markerLen);
+    }
+
+    static boolean splitsPair(String s, int i) {
+        return i > 0 && i < s.length() && Character.isHighSurrogate(s.charAt(i - 1)) && Character.isLowSurrogate(s.charAt(i));
+    }
+
+    static String modelAbbreviateMiddle(String str, String middle, int length) {
+        if (str.isEmpty() || middle == null || middle.isEmpty() || length >= str.length() || length < middle.length() + 2) {
+            return str;
+        }
+        int target = length - middle.length();
+        int startOffset = target / 2 + target % 2;
+        int endOffset = str.length() - target / 2;
+        return str.substring(0, startOffset) + middle + str.substring(endOffset);
+    }
+
+    static String cyclicPad(String padStr, int pads) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < pads; i++) {
+            sb.append(padStr.charAt(i % padStr.length()));
+        }
+        return sb.toString();
+    }
+
+    static String modelLeftPad(String s, int size, String padStr) {
+        if (padStr == null || padStr.isEmpty()) {
+            padStr = " ";
+        }
+        int pads = size - s.length();
+        return pads <= 0 ? s : cyclicPad(padStr, pads) + s;
+    }
+
+    static String modelRightPad(String s, int size, String padStr) {
+        if (padStr == null || padStr.isEmpty()) {
+            padStr = " ";
+        }
+        int pads = size - s.length();
+        return pads <= 0 ? s : s + cyclicPad(padStr, pads);
+    }
+
+    static String modelCenter(String s, int size, String padStr) {
+        if (size <= 0) {
+            return s;
+        }
+        int pads = size - s.length();
+        if (pads <= 0) {
+            return s;
+        }
+        String left = modelLeftPad(s, s.length() + pads / 2, padStr);
+        return modelRightPad(left, size, padStr);
+    }
+
+    static String modelRotate(String s, int shift) {
+        int len = s.length();
+        if (len == 0 || shift % len == 0) {
+            return s;
+        }
+        int k = ((shift % len) + len) % len;
+        return s.substring(len - k) + s.substring(0, len - k);
+    }
+
+    static String modelOverlay(String str, String overlay, int start, int end) {
+        if (overlay == null) {
+            overlay = "";
+        }
+        int len = str.length();
+        if (start < 0) {
+            start = 0;
+        }
+        if (start > len) {
+            start = len;
+        }
+        if (end < 0) {
+            end = 0;
+        }
+        if (end > len) {
+            end = len;
+        }
+        if (start > end) {
+            int t = start;
+            start = end;
+            end = t;
+        }
+        if (splitsPair(str, start)) {
+            start--;
+        }
+        if (splitsPair(str, end)) {
+            end++;
+        }
+        return str.substring(0, start) + overlay + str.substring(end);
+    }
+
+    static String modelChomp(String s) {
+        if (s.isEmpty()) {
+            return s;
+        }
+        if (s.length() == 1) {
+            char c = s.charAt(0);
+            return c == '\r' || c == '\n' ? "" : s;
+        }
+        int last = s.length() - 1;
+        char c = s.charAt(last);
+        if (c == '\n') {
+            if (s.charAt(last - 1) == '\r') {
+                last--;
+            }
+        } else if (c != '\r') {
+            last++;
+        }
+        return s.substring(0, last);
+    }
+
+    static String modelChop(String s) {
+        int len = s.length();
+        if (len < 2) {
+            return "";
+        }
+        int last = len - 1;
+        if (splitsPair(s, last)) {
+            return s.substring(0, last - 1);
+        }
+        String ret = s.substring(0, last);
+        if (s.charAt(last) == '\n' && ret.charAt(last - 1) == '\r') {
+            return ret.substring(0, last - 1);
+        }
+        return ret;
+    }
+
+    static String modelStrip(String s, String stripChars, boolean start, boolean end) {
+        int lo = 0;
+        int hi = s.length();
+        if (start) {
+            while (lo < hi && (stripChars == null ? Character.isWhitespace(s.charAt(lo)) : stripChars.indexOf(s.charAt(lo)) >= 0)) {
+                lo++;
+            }
+        }
+        if (end) {
+            while (hi > lo && (stripChars == null ? Character.isWhitespace(s.charAt(hi - 1)) : stripChars.indexOf(s.charAt(hi - 1)) >= 0)) {
+                hi--;
+            }
+        }
+        return s.substring(lo, hi);
+    }
+
+    static String modelTrim(String s) {
+        int lo = 0;
+        int hi = s.length();
+        while (lo < hi && s.charAt(lo) <= ' ') {
+            lo++;
+        }
+        while (hi > lo && s.charAt(hi - 1) <= ' ') {
+            hi--;
+        }
+        return s.substring(lo, hi);
+    }
+
+    /** Runs of Character.isWhitespace become one space, then trim(String) at both ends (strings without U+00A0). */
+    static String modelNormalizeSpace(String s) {
+        StringBuilder sb = new StringBuilder();
+        boolean pendingSpace = false;
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isWhitespace(c)) {
+                pendingSpace = sb.length() > 0;
+            } else {
+                if (pendingSpace) {
+                    sb.append(' ');
+                    pendingSpace = false;
+                }
+                sb.append(c);
+            }
+        }
+        return modelTrim(sb.toString());
+    }
+
+    static String modelSwapCase(String s) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < s.length(); ) {
+            int cp = s.codePointAt(i);
+            i += Character.charCount(cp);
+            if (Character.isUpperCase(cp) || Character.isTitleCase(cp)) {
+                sb.appendCodePoint(Character.toLowerCase(cp));
+            } else if (Character.isLowerCase(cp)) {
+                sb.appendCodePoint(Character.toUpperCase(cp));
+            } else {
+                sb.appendCodePoint(cp);
+            }
+        }
+        return sb.toString();
+    }
+
+    static String modelCapitalize(String s, boolean up) {
+        if (s.isEmpty()) {
+            return s;
+        }
+        int cp = s.codePointAt(0);
+        int mapped = up ? Character.toTitleCase(cp) : Character.toLowerCase(cp);
+        if (mapped == cp) {
+            return s;
+        }
+        return new StringBuilder().appendCodePoint(mapped).append(s, Character.charCount(cp), s.length()).toString();
+    }
