+    /**
+     * The hex digit functions on a nibble: intToHexDigit as documented ("10 returns 'A' and so on"; the code returns
+     * lower case, commons-lang/7 - judged by default, compared ignoring case under HEGEL_NO_KNOWN), its inverse, the
+     * bit-reversed Msb0 twin and the binary forms.
+     */
+    static void checkHexDigit(int nibble) {
+        char lower = Character.forDigit(nibble, 16);
+        char documented = Character.toUpperCase(lower);
+        char got = Conversion.intToHexDigit(nibble);
+        if (Zoo.NO_KNOWN && nibble >= 10) {
+            Zoo.count("compared ignoring case: intToHexDigit of 10..15 (commons-lang/7)");
+            eq("intToHexDigit(" + nibble + ") ignoring case", Character.toUpperCase(got), documented);
+        } else {
+            eq("intToHexDigit(" + nibble + ")", got, documented);
+        }
+        eq("hexDigitToInt(intToHexDigit)", Conversion.hexDigitToInt(got), nibble);
+        eq("hexDigitToInt lower", Conversion.hexDigitToInt(lower), nibble);
+        eq("hexDigitToInt upper", Conversion.hexDigitToInt(documented), nibble);
+        eq("intToHexDigitMsb0 is the bit-reversed nibble", Conversion.intToHexDigitMsb0(nibble), Character.forDigit(reverse4(nibble), 16));
+        eq("hexDigitMsb0ToInt(intToHexDigitMsb0)", Conversion.hexDigitMsb0ToInt(Conversion.intToHexDigitMsb0(nibble)), nibble);
+        boolean[] nb = {(nibble & 1) != 0, (nibble & 2) != 0, (nibble & 4) != 0, (nibble & 8) != 0};
+        eq("binaryToHexDigit", Conversion.binaryToHexDigit(nb), lower);
+        eq("hexDigitToBinary", Arrays.toString(Conversion.hexDigitToBinary(lower)), Arrays.toString(nb));
+        boolean[] nbMsb = {nb[3], nb[2], nb[1], nb[0]};
+        eq("binaryBeMsb0ToHexDigit", Conversion.binaryBeMsb0ToHexDigit(nbMsb), lower);
+        eq("binaryToHexDigitMsb0_4bits", Conversion.binaryToHexDigitMsb0_4bits(nb), Character.forDigit(reverse4(nibble), 16));
+    }
