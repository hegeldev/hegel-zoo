+    static List<String> modelSplit(String s, String seps, int max, boolean preserve) {
+        // seps == null means whitespace; adjacent separators are merged unless preserve
+        List<String> out = new ArrayList<>();
+        if (s.isEmpty()) {
+            return out;
+        }
+        int len = s.length();
+        int i = 0;
+        int start = 0;
+        boolean match = false;
+        boolean lastMatch = false;
+        int sizePlus1 = 1;
+        while (i < len) {
+            boolean isSep = seps == null ? Character.isWhitespace(s.charAt(i)) : seps.indexOf(s.charAt(i)) >= 0;
+            if (isSep) {
+                if (match || preserve) {
+                    lastMatch = true;
+                    if (sizePlus1++ == max) {
+                        i = len;
+                        lastMatch = false;
+                    }
+                    out.add(s.substring(start, i));
+                    match = false;
+                }
+                start = ++i;
+                continue;
+            }
+            lastMatch = false;
+            match = true;
+            i++;
+        }
+        if (match || preserve && lastMatch) {
+            out.add(s.substring(start, i));
+        }
+        return out;
+    }
+
+    static List<String> modelSplitWhole(String s, String sep, int max, boolean preserve) {
+        List<String> out = new ArrayList<>();
+        if (s.isEmpty()) {
+            return out;
+        }
+        if (sep == null || sep.isEmpty()) {
+            return modelSplit(s, null, max, preserve);
+        }
+        int len = s.length();
+        int sepLen = sep.length();
+        int numberOfSubstrings = 0;
+        int beg = 0;
+        int end = 0;
+        while (end < len) {
+            end = s.indexOf(sep, beg);
+            if (end > -1) {
+                if (end > beg) {
+                    numberOfSubstrings++;
+                    if (numberOfSubstrings == max) {
+                        end = len;
+                        out.add(s.substring(beg));
+                    } else {
+                        out.add(s.substring(beg, end));
+                        beg = end + sepLen;
+                    }
+                } else {
+                    if (preserve) {
+                        numberOfSubstrings++;
+                        if (numberOfSubstrings == max) {
+                            end = len;
+                            out.add(s.substring(beg));
+                        } else {
+                            out.add("");
+                        }
+                    }
+                    beg = end + sepLen;
+                }
+            } else {
+                if (preserve || beg < len) {
+                    out.add(s.substring(beg));
+                }
+                end = len;
+            }
+        }
+        return out;
+    }
+
+    static List<String> modelSplitByCharacterType(String s, boolean camel) {
+        List<String> out = new ArrayList<>();
+        if (s.isEmpty()) {
+            return out;
+        }
+        int tokenStart = 0;
+        int currentType = Character.getType(s.charAt(0));
+        for (int pos = 1; pos < s.length(); pos++) {
+            int type = Character.getType(s.charAt(pos));
+            if (type == currentType) {
+                continue;
+            }
+            if (camel && type == Character.LOWERCASE_LETTER && currentType == Character.UPPERCASE_LETTER) {
+                int newTokenStart = pos - 1;
+                if (newTokenStart != tokenStart) {
+                    out.add(s.substring(tokenStart, newTokenStart));
+                    tokenStart = newTokenStart;
+                }
+            } else {
+                out.add(s.substring(tokenStart, pos));
+                tokenStart = pos;
+            }
+            currentType = type;
+        }
+        out.add(s.substring(tokenStart));
+        return out;
+    }
+
+    static String modelReplace(String text, String search, String rep, int max, boolean ignoreCase) {
+        if (text.isEmpty() || search.isEmpty() || rep == null || max == 0) {
+            return text;
+        }
+        StringBuilder sb = new StringBuilder();
+        int i = 0;
+        while (i < text.length()) {
+            if (max != 0 && text.regionMatches(ignoreCase, i, search, 0, search.length())) {
+                sb.append(rep);
+                i += search.length();
+                if (max > 0) {
+                    max--;
+                }
+            } else {
+                sb.append(text.charAt(i));
+                i++;
+            }
+        }
+        return sb.toString();
+    }
+
+    static String modelReplaceChars(String s, String searchChars, String replaceChars) {
+        if (replaceChars == null) {
+            replaceChars = "";
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            int idx = searchChars.indexOf(c);
+            if (idx >= 0) {
+                if (idx < replaceChars.length()) {
+                    sb.append(replaceChars.charAt(idx));
+                }
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.toString();
+    }
+
+    /** replaceEach: at each position the earliest match wins, ties go to the first entry in the list. */
+    static String modelReplaceEach(String text, String[] search, String[] rep) {
+        StringBuilder sb = new StringBuilder();
+        int i = 0;
+        while (i < text.length()) {
+            int bestLen = -1;
+            String bestRep = null;
+            int nearest = Integer.MAX_VALUE;
+            int nearestIdx = -1;
+            for (int k = 0; k < search.length; k++) {
+                if (search[k] == null || search[k].isEmpty() || rep[k] == null) {
+                    continue;
+                }
+                int at = text.indexOf(search[k], i);
+                if (at >= 0 && at < nearest) {
+                    nearest = at;
+                    nearestIdx = k;
+                }
+            }
+            if (nearestIdx < 0) {
+                sb.append(text, i, text.length());
+                break;
+            }
+            sb.append(text, i, nearest).append(rep[nearestIdx]);
+            i = nearest + search[nearestIdx].length();
+            bestLen = bestRep == null ? bestLen : bestLen;
+        }
+        return sb.toString();
+    }
+
+    static boolean all(String s, java.util.function.IntPredicate p, boolean emptyValue) {
+        if (s.isEmpty()) {
+            return emptyValue;
+        }
+        return s.chars().allMatch(p);
+    }
