+    }
+
+    static String modelRotate(String s, int shift) {
+        int len = s.length();
+        if (len == 0 || shift % len == 0) {
+            return s;
+        }
+        int k = ((shift % len) + len) % len;
+        return s.substring(len - k) + s.substring(0, len - k);
+    }
+
+    static String modelOverlay(String str, String overlay, int start, int end) {
+        if (overlay == null) {
+            overlay = "";
+        }
+        int len = str.length();
+        if (start < 0) {
+            start = 0;
+        }
+        if (start > len) {
+            start = len;
+        }
+        if (end < 0) {
+            end = 0;
+        }
+        if (end > len) {
+            end = len;
+        }
+        if (start > end) {
+            int t = start;
+            start = end;
+            end = t;
+        }
+        if (splitsPair(str, start)) {
+            start--;
+        }
+        if (splitsPair(str, end)) {
+            end++;
+        }
+        return str.substring(0, start) + overlay + str.substring(end);
+    }
+
+    static String modelChomp(String s) {
+        if (s.isEmpty()) {
+            return s;
+        }
+        if (s.length() == 1) {
+            char c = s.charAt(0);
+            return c == '\r' || c == '\n' ? "" : s;
+        }
+        int last = s.length() - 1;
+        char c = s.charAt(last);
+        if (c == '\n') {
+            if (s.charAt(last - 1) == '\r') {
+                last--;
+            }
+        } else if (c != '\r') {
+            last++;
+        }
+        return s.substring(0, last);
+    }
+
+    static String modelChop(String s) {
+        int len = s.length();
+        if (len < 2) {
+            return "";
+        }
+        int last = len - 1;
+        if (splitsPair(s, last)) {
+            return s.substring(0, last - 1);
+        }
+        String ret = s.substring(0, last);
+        if (s.charAt(last) == '\n' && ret.charAt(last - 1) == '\r') {
+            return ret.substring(0, last - 1);
+        }
+        return ret;
+    }
+
+    static String modelStrip(String s, String stripChars, boolean start, boolean end) {
