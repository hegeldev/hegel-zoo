+    // ------------------------------------------------------------------ models: search, split, join, replace, predicates
+
+    static int modelOrdinalIndexOf(String s, String search, int ordinal, boolean last) {
+        if (ordinal <= 0) {
+            return -1;
+        }
+        if (search.isEmpty()) {
+            return last ? s.length() : 0;
+        }
+        int found = 0;
+        int index = last ? s.length() : -1;
+        do {
+            index = last ? s.lastIndexOf(search, index - 1) : s.indexOf(search, index + 1);
+            if (index < 0) {
+                return index;
+            }
+            found++;
+        } while (found < ordinal);
+        return index;
+    }
+
+    static int modelCountMatches(String s, String sub) {
+        if (s.isEmpty() || sub.isEmpty()) {
+            return 0;
+        }
+        int count = 0;
+        int idx = 0;
+        while ((idx = s.indexOf(sub, idx)) >= 0) {
+            count++;
+            idx += sub.length();
+        }
+        return count;
+    }
