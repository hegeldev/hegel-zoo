+
+    @Test
+    void createNumberAcceptsAPlusWithTheLongSuffix() {
+        Zoo.run("createNumberAcceptsAPlusWithTheLongSuffix", tc -> {
+            CommonsLangMoreTest.checkIntegral(tc.draw(PLUS_LONG, "number"));
+        });
+    }
