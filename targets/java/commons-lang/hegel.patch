+    /**
+     * pow against the reduced rational power ("The returned fraction is in reduced form"): a zero to a negative power
+     * throws, pow(0) is ONE. pow(1) returns the fraction itself and pow(-1) its plain inverse, unreduced (commons-lang/8):
+     * judged by default; under HEGEL_NO_KNOWN only the value is compared for |power| == 1.
+     */
+    static void checkPow(Fraction f1, int n1, int d1, int p, String ctx) {
+        if (n1 == 0 && p < 0) {
+            throwsA(ArithmeticException.class, () -> f1.pow(p), "pow of zero to a negative" + ctx);
+            return;
+        }
+        if (p == 0) {
+            eq("pow(0)" + ctx, f1.pow(0), Fraction.ONE);
+            return;
+        }
+        if (Zoo.NO_KNOWN && Math.abs(p) == 1) {
+            Zoo.count("compared by value only: pow(+-1) (commons-lang/8)");
+            eq("pow(" + p + ") value" + ctx, f1.pow(p).compareTo(p == 1 ? f1 : f1.invert()), 0);
+            return;
+        }
+        BigInteger[] r = rational(n1, d1);
+        BigInteger pn = r[0].pow(Math.abs(p));
+        BigInteger pd = r[1].pow(Math.abs(p));
+        BigInteger[] want = p > 0 ? new BigInteger[] {pn, pd} : pn.signum() < 0 ? new BigInteger[] {pd.negate(), pn.negate()} : new BigInteger[] {pd, pn};
+        eqFraction("pow(" + p + ")" + ctx, f1.pow(p), want);
+    }
