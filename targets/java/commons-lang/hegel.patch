+        return Gen.join(pieces.subList(0, at)) + odd + Gen.join(pieces.subList(at, pieces.size()));
+    });
+
+    @Test
+    void normalizeSpaceCollapsesNoBreakSpaces() {
+        Zoo.run("normalizeSpaceCollapsesNoBreakSpaces", tc -> {
+            String s = tc.draw(WITH_NBSP, "text");
+            CommonsLangTest.checkNormalizeSpace(s, " for " + show(s));
+        });
+    }
+
+    // ------------------------------------------------------------------ commons-lang/10
+
+    /** An array of a default-package class named like a descriptor letter; beside it (HEGEL_NO_KNOWN) the same class in a package, or a two-letter class. */
+    static final Generator<String> LETTER = pick("Z", "B", "C", "D", "F", "I", "J", "S", "V");
+
+    static final Generator<CommonsLangMoreTest.Cls> DESCRIPTOR_CLASS = Zoo.NO_KNOWN
