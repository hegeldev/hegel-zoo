+            }, "validState");
+            Integer[] array = new Integer[count + 1];
+            int idx = into(x.idxRaw(), -1, count + 1);
+            if (idx >= 0 && idx <= count) {
+                eq("validIndex returns the array", Validate.validIndex(array, idx), array);
+            } else {
+                throwsA(IndexOutOfBoundsException.class, () -> Validate.validIndex(array, idx), "validIndex " + idx + " of " + array.length);
+            }
+            long v = x.v();
+            if (v >= 0 && v <= 10) {
+                Validate.inclusiveBetween(0L, 10L, v);
+            } else {
+                throwsA(IllegalArgumentException.class, () -> {
+                    Validate.inclusiveBetween(0L, 10L, v);
+                    return null;
+                }, "inclusiveBetween " + v);
+            }
+            if (v > 0 && v < 10) {
+                Validate.exclusiveBetween(0L, 10L, v);
+            } else {
+                throwsA(IllegalArgumentException.class, () -> {
+                    Validate.exclusiveBetween(0L, 10L, v);
+                    return null;
+                }, "exclusiveBetween " + v);
+            }
+            Validate.matchesPattern("abc123", "[a-c]+\\d+");
+            throwsA(IllegalArgumentException.class, () -> {
+                Validate.matchesPattern("abc123", "\\d+");
+                return null;
+            }, "matchesPattern mismatch");
+            String[] withNull = {"a", null, "c"};
+            try {
+                Validate.noNullElements(withNull);
+                fail("noNullElements accepted a null");
+            } catch (IllegalArgumentException e) {
+                eq("noNullElements message", e.getMessage(), "The validated array contains null element at index: 1");
+            }
+            try {
+                Validate.isTrue(false, "value %d bad", 42L);
+                fail("isTrue accepted false");
+            } catch (IllegalArgumentException e) {
+                eq("isTrue message", e.getMessage(), "value 42 bad");
+            }
+            // ObjectUtils
+            Integer[] values = x.values().toArray(new Integer[0]);
+            List<Integer> nonNull = Arrays.stream(values).filter(Objects::nonNull).sorted().toList();
+            String octx = " for " + Arrays.toString(values);
+            eq("ObjectUtils.max ignores nulls" + octx, ObjectUtils.max(values), nonNull.isEmpty() ? null : nonNull.get(nonNull.size() - 1));
+            eq("ObjectUtils.min ignores nulls" + octx, ObjectUtils.min(values), nonNull.isEmpty() ? null : nonNull.get(0));
+            if (nonNull.size() == values.length) {
+                eq("ObjectUtils.median" + octx, ObjectUtils.median(values), nonNull.get((nonNull.size() - 1) / 2));
+                Map<Integer, Integer> freq = new HashMap<>();
+                for (Integer y : values) {
+                    freq.merge(y, 1, Integer::sum);
+                }
+                int best = freq.values().stream().max(Integer::compare).orElse(0);
+                List<Integer> modes = freq.entrySet().stream().filter(e -> e.getValue() == best).map(Map.Entry::getKey).toList();
+                eq("ObjectUtils.mode" + octx, ObjectUtils.mode(values), modes.size() == 1 ? modes.get(0) : null);
+            } else {
