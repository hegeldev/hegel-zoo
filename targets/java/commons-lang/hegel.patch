+    // ------------------------------------------------------------------ models: search, split, join, replace, predicates
+
+    static int modelOrdinalIndexOf(String s, String search, int ordinal, boolean last) {
+        if (ordinal <= 0) {
+            return -1;
+        }
+        if (search.isEmpty()) {
+            return last ? s.length() : 0;
+        }
+        int found = 0;
+        int index = last ? s.length() : -1;
+        do {
+            index = last ? s.lastIndexOf(search, index - 1) : s.indexOf(search, index + 1);
+            if (index < 0) {
+                return index;
+            }
+            found++;
+        } while (found < ordinal);
+        return index;
+    }
+
+    static int modelCountMatches(String s, String sub) {
+        if (s.isEmpty() || sub.isEmpty()) {
+            return 0;
+        }
+        int count = 0;
+        int idx = 0;
+        while ((idx = s.indexOf(sub, idx)) >= 0) {
+            count++;
+            idx += sub.length();
+        }
+        return count;
+    }
+
+    static int modelIndexOfAny(String s, String chars, boolean but) {
+        for (int i = 0; i < s.length(); i++) {
+            int cp = s.codePointAt(i);
+            boolean in = chars.indexOf(cp) >= 0 && (cp < 0x10000 || chars.codePoints().anyMatch(c -> c == cp));
+            if (cp >= 0x10000) {
+                // a supplementary character is in the set only if the whole pair is
+                in = chars.codePoints().anyMatch(c -> c == cp);
+            }
+            if (in != but) {
+                return i;
+            }
+            i += Character.charCount(cp) - 1;
+        }
+        return -1;
+    }
+
+    static List<String> modelSplit(String s, String seps, int max, boolean preserve) {
+        // seps == null means whitespace; adjacent separators are merged unless preserve
+        List<String> out = new ArrayList<>();
+        if (s.isEmpty()) {
+            return out;
+        }
+        int len = s.length();
+        int i = 0;
+        int start = 0;
+        boolean match = false;
+        boolean lastMatch = false;
+        int sizePlus1 = 1;
+        while (i < len) {
+            boolean isSep = seps == null ? Character.isWhitespace(s.charAt(i)) : seps.indexOf(s.charAt(i)) >= 0;
+            if (isSep) {
+                if (match || preserve) {
+                    lastMatch = true;
+                    if (sizePlus1++ == max) {
+                        i = len;
+                        lastMatch = false;
+                    }
+                    out.add(s.substring(start, i));
+                    match = false;
+                }
+                start = ++i;
+                continue;
+            }
+            lastMatch = false;
+            match = true;
+            i++;
+        }
+        if (match || preserve && lastMatch) {
+            out.add(s.substring(start, i));
+        }
+        return out;
+    }
+
+    static List<String> modelSplitWhole(String s, String sep, int max, boolean preserve) {
+        List<String> out = new ArrayList<>();
+        if (s.isEmpty()) {
+            return out;
+        }
+        if (sep == null || sep.isEmpty()) {
+            return modelSplit(s, null, max, preserve);
+        }
+        int len = s.length();
+        int sepLen = sep.length();
+        int numberOfSubstrings = 0;
+        int beg = 0;
+        int end = 0;
+        while (end < len) {
+            end = s.indexOf(sep, beg);
+            if (end > -1) {
+                if (end > beg) {
+                    numberOfSubstrings++;
+                    if (numberOfSubstrings == max) {
+                        end = len;
+                        out.add(s.substring(beg));
+                    } else {
+                        out.add(s.substring(beg, end));
+                        beg = end + sepLen;
+                    }
+                } else {
+                    if (preserve) {
+                        numberOfSubstrings++;
+                        if (numberOfSubstrings == max) {
+                            end = len;
+                            out.add(s.substring(beg));
+                        } else {
+                            out.add("");
+                        }
+                    }
+                    beg = end + sepLen;
+                }
+            } else {
+                if (preserve || beg < len) {
+                    out.add(s.substring(beg));
+                }
+                end = len;
+            }
+        }
+        return out;
+    }
+
+    static List<String> modelSplitByCharacterType(String s, boolean camel) {
+        List<String> out = new ArrayList<>();
+        if (s.isEmpty()) {
+            return out;
+        }
+        int tokenStart = 0;
+        int currentType = Character.getType(s.charAt(0));
+        for (int pos = 1; pos < s.length(); pos++) {
+            int type = Character.getType(s.charAt(pos));
+            if (type == currentType) {
+                continue;
+            }
+            if (camel && type == Character.LOWERCASE_LETTER && currentType == Character.UPPERCASE_LETTER) {
+                int newTokenStart = pos - 1;
+                if (newTokenStart != tokenStart) {
+                    out.add(s.substring(tokenStart, newTokenStart));
+                    tokenStart = newTokenStart;
+                }
+            } else {
+                out.add(s.substring(tokenStart, pos));
+                tokenStart = pos;
+            }
+            currentType = type;
+        }
+        out.add(s.substring(tokenStart));
+        return out;
+    }
+
+    static String modelReplace(String text, String search, String rep, int max, boolean ignoreCase) {
+        if (text.isEmpty() || search.isEmpty() || rep == null || max == 0) {
+            return text;
+        }
+        StringBuilder sb = new StringBuilder();
+        int i = 0;
+        while (i < text.length()) {
+            if (max != 0 && text.regionMatches(ignoreCase, i, search, 0, search.length())) {
+                sb.append(rep);
+                i += search.length();
+                if (max > 0) {
+                    max--;
+                }
+            } else {
+                sb.append(text.charAt(i));
+                i++;
+            }
+        }
+        return sb.toString();
+    }
+
+    static String modelReplaceChars(String s, String searchChars, String replaceChars) {
+        if (replaceChars == null) {
+            replaceChars = "";
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            int idx = searchChars.indexOf(c);
+            if (idx >= 0) {
+                if (idx < replaceChars.length()) {
+                    sb.append(replaceChars.charAt(idx));
+                }
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.toString();
+    }
+
+    /** replaceEach: at each position the earliest match wins, ties go to the first entry in the list; null when nothing matched. */
+    static String modelReplaceEachOnce(String text, String[] search, String[] rep) {
+        StringBuilder sb = new StringBuilder();
+        boolean matched = false;
+        int i = 0;
+        while (i < text.length()) {
+            int nearest = Integer.MAX_VALUE;
+            int nearestIdx = -1;
+            for (int k = 0; k < search.length; k++) {
+                if (search[k] == null || search[k].isEmpty() || rep[k] == null) {
+                    continue;
+                }
+                int at = text.indexOf(search[k], i);
+                if (at >= 0 && at < nearest) {
+                    nearest = at;
+                    nearestIdx = k;
+                }
+            }
+            if (nearestIdx < 0) {
+                sb.append(text, i, text.length());
+                break;
+            }
+            matched = true;
+            sb.append(text, i, nearest).append(rep[nearestIdx]);
+            i = nearest + search[nearestIdx].length();
+        }
+        return matched ? sb.toString() : null;
+    }
+
+    static String modelReplaceEach(String text, String[] search, String[] rep) {
+        String once = modelReplaceEachOnce(text, search, rep);
+        return once == null ? text : once;
+    }
+
+    /**
+     * The rounds of replaceEach until none matches, each round's text in order (empty when the first round matches
+     * nothing); null when the replacements never settle (a match in every one of 64 rounds, or a text past 4096 chars).
+     */
+    static List<String> modelReplaceEachRounds(String text, String[] search, String[] rep) {
+        List<String> rounds = new ArrayList<>();
+        String cur = text;
+        for (int round = 0; round < 64; round++) {
+            String next = modelReplaceEachOnce(cur, search, rep);
+            if (next == null) {
+                return rounds;
+            }
+            if (next.length() > 4096) {
+                return null;
+            }
+            rounds.add(next);
+            cur = next;
+        }
+        return null;
+    }
+
+    static boolean all(String s, java.util.function.IntPredicate p, boolean emptyValue) {
+        if (s.isEmpty()) {
+            return emptyValue;
+        }
+        return s.chars().allMatch(p);
+    }
+
+    static String[] searches(List<Pair> pairs) {
+        return pairs.stream().map(Pair::search).toArray(String[]::new);
+    }
+
+    static String[] replacements(List<Pair> pairs) {
+        return pairs.stream().map(Pair::rep).toArray(String[]::new);
+    }
