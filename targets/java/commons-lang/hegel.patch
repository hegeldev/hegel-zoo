+    static int reverse4(int nibble) {
+        return (nibble & 1) << 3 | (nibble & 2) << 1 | (nibble & 4) >> 1 | (nibble & 8) >> 3;
+    }
+
+    /** An int (a product of two draws, or one time in five a boundary value), the shift and xor that make the long, a partial conversion's width and position, a destination and a nibble. */
+    record ConvCase(int x, int shift, int xor, int nHexs, int dstPos, int dstInit, int nibble) {
+        long l() {
+            return (long) x << shift ^ xor;
+        }
+    }
