+            int wantCmp = p.age != q.age ? Integer.compare(p.age, q.age) : p.name == null ? q.name == null ? 0 : -1 : q.name == null ? 1 : Integer.signum(p.name.compareTo(q.name));
+            eq("CompareToBuilder" + ctx, Integer.signum(cmp), wantCmp);
+            DiffResult<Person> diff = DiffBuilder.<Person>builder().setLeft(p).setRight(q).setStyle(ToStringStyle.SHORT_PREFIX_STYLE).build()
+                .append("name", p.name, q.name).append("age", p.age, q.age).append("smoker", p.smoker, q.smoker).build();
+            int diffs = (Objects.equals(p.name, q.name) ? 0 : 1) + (p.age == q.age ? 0 : 1) + (p.smoker == q.smoker ? 0 : 1);
