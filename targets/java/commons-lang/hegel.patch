+    /** A boolean word in a case spelt by a tape of coins (an empty tape: lower case), with an optional space before and after. */
+    record WordCase(String base, List<Boolean> caps, String before, String after) {
+        String text() {
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < base.length(); i++) {
+                char c = base.charAt(i);
+                sb.append(tape(caps, i, false) ? Character.toUpperCase(c) : Character.toLowerCase(c));
+            }
+            return before + sb + after;
+        }
