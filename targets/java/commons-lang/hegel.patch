+        w(80, tuples(ints(-1_000_000, 1_000_000), ints(1, 4000)).map(t -> (int) (t.value1() * (long) t.value2()))),
+        w(20, pick(0, -1, Integer.MIN_VALUE, Integer.MAX_VALUE, 0x12345678)));
