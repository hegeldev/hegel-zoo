+            }
+            // mutables follow int/long arithmetic with pre/post semantics
+            MutableInt mi = new MutableInt(p.age);
+            MutableLong ml = new MutableLong(p.age);
+            long model = p.age;
+            for (MutOp op : c.ops()) {
+                switch (op) {
+                    case Add o -> {
+                        mi.add(o.v());
+                        ml.add(o.v());
+                        model += o.v();
+                    }
+                    case AddAndGet o -> {
+                        eq("addAndGet" + ctx, (long) mi.addAndGet(o.v()), model + o.v());
+                        ml.addAndGet(o.v());
+                        model += o.v();
+                    }
+                    case GetAndAdd o -> {
+                        eq("getAndAdd" + ctx, (long) mi.getAndAdd(o.v()), model);
+                        ml.getAndAdd(o.v());
+                        model += o.v();
+                    }
+                    case Increment o -> {
+                        mi.increment();
+                        ml.increment();
+                        model++;
+                    }
+                    case GetAndDecrement o -> {
+                        eq("getAndDecrement" + ctx, (long) mi.getAndDecrement(), model);
+                        ml.getAndDecrement();
+                        model--;
+                    }
+                    case IncrementAndGet o -> {
+                        eq("incrementAndGet" + ctx, (long) mi.incrementAndGet(), model + 1);
+                        ml.incrementAndGet();
+                        model++;
+                    }
+                    case Subtract o -> {
+                        mi.subtract(o.v());
+                        ml.subtract(o.v());
+                        model -= o.v();
+                    }
+                    case SetValue o -> {
+                        mi.setValue(o.v());
+                        ml.setValue(o.v());
+                        model = o.v();
+                    }
+                }
