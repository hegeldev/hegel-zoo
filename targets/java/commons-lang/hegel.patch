+            }
+        }
+        return modelTrim(sb.toString());
+    }
+
+    static String modelSwapCase(String s) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < s.length(); ) {
+            int cp = s.codePointAt(i);
+            i += Character.charCount(cp);
+            if (Character.isUpperCase(cp) || Character.isTitleCase(cp)) {
+                sb.appendCodePoint(Character.toLowerCase(cp));
+            } else if (Character.isLowerCase(cp)) {
+                sb.appendCodePoint(Character.toUpperCase(cp));
+            } else {
+                sb.appendCodePoint(cp);
+            }
+        }
+        return sb.toString();
+    }
+
+    static String modelCapitalize(String s, boolean up) {
+        if (s.isEmpty()) {
+            return s;
+        }
+        int cp = s.codePointAt(0);
+        int mapped = up ? Character.toTitleCase(cp) : Character.toLowerCase(cp);
+        if (mapped == cp) {
+            return s;
+        }
+        return new StringBuilder().appendCodePoint(mapped).append(s, Character.charCount(cp), s.length()).toString();
+    }
