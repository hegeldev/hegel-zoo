+            eq("literal with quote" + ctx, DurationFormatUtils.formatDuration(ms, "s''s"), ms / 1000 + "'" + ms / 1000);
+            eq("literal with quote and minutes" + ctx, DurationFormatUtils.formatDuration(ms, "m's''s'"), ms / 60_000 + "s's");
