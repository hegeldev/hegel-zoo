+    static final Generator<ConvCase> CONV_CASE = tuples(X, ints(0, 32), ints(-1000, 1000), ints(0, 8).flatMap(nh -> tuples(just(nh), ints(0, 32 - 4 * nh))), ints(-1_000_000, 1_000_000), ints(0, 15))
+        .map(t -> new ConvCase(t.value1(), t.value2(), t.value3(), t.value4().value1(), t.value4().value2(), t.value5(), t.value6()));
