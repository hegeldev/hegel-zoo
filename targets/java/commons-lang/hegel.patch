+/**
+ * Apache Commons Lang, part 1: StringUtils and ArrayUtils against models written from the Javadoc's
+ * rules and example tables, with java.lang.String and java.util.List as the oracles.
+ *
+ * <p>The generators are values: each property draws one case record built from {@link Gen}'s combinators
+ * and applies it. They draw the recorded bugs' shapes (bugs.toml) by default, so the wide properties fail on
+ * them and are the expected failures beside the pins: abbreviate's head branch (commons-lang/1), an invalid
+ * join range (/3), a rename chain of six or more links for replaceEachRepeatedly (/4), an out-of-range insert
+ * without values (/5), a negative random-string count's message (/6, in CommonsLangMoreTest), a string with
+ * U+00A0 for normalizeSpace (/9). {@code HEGEL_NO_KNOWN=1} ({@link Zoo#NO_KNOWN}) switches the shapes off, for a
+ * run that looks past the known bugs; {@link CommonsLangShapesTest} has one narrow property per bug.
+ */
+class CommonsLangTest {
+
+    // ------------------------------------------------------------------ generators
+
+    /** A surrogate pair (U+1F600). */
+    static final String SMILE = "\ud83d\ude00";
+    /** e with an acute accent (U+00E9). */
+    static final String E_ACUTE = "\u00e9";
+    /** A no-break space (U+00A0): normalizeSpace's commons-lang/9 shape. */
+    static final String NBSP = "\u00a0";
+
+    /**
+     * A piece of a string: ASCII letters (3), digits, spaces, punctuation, one special (a non-ASCII letter, U+00A0,
+     * a tab, line breaks, NUL, a space), the emoji pair, letters and spaces (2).
+     */
+    static final Generator<String> PIECE = weighted(
+        w(3, word("abcABC", 1, 4)),
+        w(1, word("012", 1, 3)),
+        w(1, word(" ", 1, 3)),
+        w(1, word(".,-_:/", 1, 2)),
+        w(1, pick(E_ACUTE, "\u0130", "\u00df", NBSP, "\t", "\n", "\r\n", "\u0000", " ")),
+        w(1, just(SMILE)),
+        w(2, word("aA ", 1, 5)));
+
+    /** A string of up to maxPieces pieces (never a lone surrogate). */
+    static Generator<String> anyStr(int maxPieces) {
+        return many(PIECE, 0, maxPieces).map(Gen::join);
+    }
+
+    /** Two indices around a string of the given length: negative, inside, and past the end. */
+    record Probe(int a, int b) {}
+
+    static Generator<Probe> probe(int len) {
+        return tuples(ints(-len - 2, len + 2), ints(-len - 2, len + 2)).map(t -> new Probe(t.value1(), t.value2()));
+    }
+
+    /** The left-edge promise probed on a string of {@code letters} distinct letters: the offset, the width and the marker. */
+    record LeftEdge(int letters, int off, int mw, String mk) {
+        String text() {
+            return "abcdefghijklmnopqrstuvwxyz".substring(0, letters);
+        }
+    }
+
+    static final Generator<String> EDGE_MARKER = pick("...", "", "~", "..", "~~~~");
+
+    static final Generator<LeftEdge> LEFT_EDGE = ints(1, 26).flatMap(k -> tuples(just(k), ints(0, k - 1), ints(1, k + 1), EDGE_MARKER)
+        .map(t -> new LeftEdge(t.value1(), t.value2(), t.value3(), t.value4())));
+
+    /** abbreviate's width, marker (null one time in six) and offset, and one time in two a left-edge probe. */
+    record Abbrev(int width, String marker, int offset, LeftEdge edge) {}
+
+    static Generator<Abbrev> abbrev(int len) {
+        return tuples(ints(0, len + 4), orNull(17, pick("...", "", "x", "..", "~~~~")), ints(-2, len + 2), maybe(50, (LeftEdge) null, LEFT_EDGE))
+            .map(t -> new Abbrev(t.value1(), t.value2(), t.value3(), t.value4()));
+    }
+
+    /** Padding: the target size, a pad string (null one time in six), a pad char and, one time in twenty, an excess near the 8192 pad limit (0: none). */
+    record Padding(int size, String pad, char padChar, int big) {}
+
+    static Generator<Padding> padding(int len) {
+        return tuples(ints(-1, len + 20), orNull(17, pick(" ", "ab", "xyz", "", SMILE)), pick(' ', '-', 'z'), maybe(5, 0, pick(8191, 8192, 8193, 8194)))
+            .map(t -> new Padding(t.value1(), t.value2(), t.value3(), t.value4()));
+    }
+
+    /** The arguments of repeat, overlay, strip, wrap, the affix functions and substringBetween. */
+    record Edits(int count, String sep, String over, String stripChars, String wrap, String affix, String close) {}
+
+    static final Generator<Edits> EDITS = tuples(ints(-2, 5), pick(",", "", "--"), orNull(25, pick("", "Z", "zz")), orNull(20, pick(" ", "ab", "a" + E_ACUTE, "")),
+            pick("'", "\"", "ab", ""), pick("a", "ab", " ", SMILE, ""), pick("a", "b", "-", " "))
+        .map(t -> new Edits(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    /** A case of the substrings-and-padding property: the string and the arguments that depend on its length. */
+    record SubstrCase(String s, Probe probe, Abbrev abbrev, Padding padding, Edits edits) {}
+
+    static final Generator<SubstrCase> SUBSTR_CASE = anyStr(6).flatMap(s -> tuples(just(s), probe(s.length()), abbrev(s.length()), padding(s.length()), EDITS)
+        .map(t -> new SubstrCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5())));
+
+    /** A needle: one of the short strings (70%) or a random string of up to three pieces, with a start index and an ordinal. */
+    record Needle(String t, int from, int ordinal) {}
+
+    static Generator<Needle> needle(int len) {
+        return tuples(weighted(w(70, pick("a", "ab", "A", " ", E_ACUTE, SMILE, "", "..", "aA")), w(30, anyStr(3))), ints(-2, len + 2), ints(0, 4))
+            .map(t -> new Needle(t.value1(), t.value2(), t.value3()));
+    }
+
+    /**
+     * split/join arguments: a separator char, a max, a whole separator, and the range of join(Object[], String, start,
+     * end): two positions taken into [0, parts) and [0, parts] (a valid range), or one time in five ({@code out}) into
+     * [-1, parts + 1], which reaches the documented invalid ranges (commons-lang/3's shape; not drawn under HEGEL_NO_KNOWN).
+     */
+    record Split(char sepChar, int max, String whole, int rawSt, int rawEn, boolean out) {}
+
+    static final Generator<Split> SPLIT = tuples(pick(' ', 'a', '.', ','), ints(-1, 4), pick("ab", ". ", "aa", "a", SMILE, ""), INDEX, INDEX, Zoo.NO_KNOWN ? just(false) : chance(20))
+        .map(t -> new Split(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+
+    /** A search/replacement pair of replaceEach. */
+    record Pair(String search, String rep) {}
+
+    static final Generator<Pair> PAIR = tuples(pick("a", "ab", "b", " ", "A", "aa", "c", ".", E_ACUTE, "ba", "", "a"), pick("1", "", "aa", "2", "b", "3", "abc"))
+        .map(t -> new Pair(t.value1(), t.value2()));
+
+    /** The letters a rename chain runs over: those the strings are made of. */
+    static final String CHAIN_LETTERS = "abcABC012";
+
+    /**
+     * A rename chain of {@code links} pairs x1 -> x2, x2 -> x3, ... over distinct letters starting at {@code start} (in the
+     * order of {@link #CHAIN_LETTERS}); replaceEachRepeatedly on a text holding x1 converges in {@code links} rounds.
+     */
+    static List<Pair> chain(int start, int links) {
+        List<Pair> out = new ArrayList<>();
+        for (int i = 0; i < links; i++) {
+            out.add(new Pair(String.valueOf(CHAIN_LETTERS.charAt((start + i) % CHAIN_LETTERS.length())), String.valueOf(CHAIN_LETTERS.charAt((start + i + 1) % CHAIN_LETTERS.length()))));
+        }
+        return out;
+    }
+
+    static final Generator<List<Pair>> CHAIN = tuples(ints(0, CHAIN_LETTERS.length() - 1), ints(1, CHAIN_LETTERS.length() - 1)).map(t -> chain(t.value1(), t.value2()));
+
+    /** The pairs of replaceEach: one to four from the pools (70%), or a rename chain of one to eight links (30%; six or more is commons-lang/4's shape). */
+    static final Generator<List<Pair>> PAIRS = weighted(w(70, many(PAIR, 1, 4)), w(30, CHAIN));
+
+    /** The replace family's arguments. */
+    record Replace(String rep, String searchChars, String replaceChars, List<Pair> pairs) {}
+
+    static final Generator<Replace> REPLACE = tuples(orNull(20, pick("", "X", "xy", SMILE)), pick("abc", "a ", ".,", ""), orNull(25, pick("xyz", "x", "")), PAIRS)
+        .map(t -> new Replace(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    /** A case of the search/split/join/replace property. */
+    record SearchCase(String s, Needle needle, Split split, Replace replace) {}
+
+    static final Generator<SearchCase> SEARCH_CASE = anyStr(7).flatMap(s -> tuples(just(s), needle(s.length()), SPLIT, REPLACE)
+        .map(t -> new SearchCase(t.value1(), t.value2(), t.value3(), t.value4())));
+
+    /** An int array with two indices around its length, a value, a swap length, a shuffle seed and zero to three values to insert. */
+    record ArrayCase(List<Integer> arr, int a, int b, int v, int swapLen, int seed, List<Integer> values) {}
+
+    static final Generator<ArrayCase> ARRAY_CASE = many(ints(-3, 3), 0, 8).flatMap(arr -> {
+        int len = arr.size();
+        return tuples(just(arr), ints(-3, len + 3), ints(-3, len + 3), ints(-3, 3), ints(-1, 4), ints(0, 1000), many(ints(-3, 3), 0, 3))
+            .map(t -> new ArrayCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+    });
+
+    static boolean wellFormed(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 >= s.length() || !Character.isLowSurrogate(s.charAt(i + 1))) {
+                    return false;
+                }
+                i++;
+            } else if (Character.isLowSurrogate(c)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static boolean hasPair(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            if (Character.isSurrogate(s.charAt(i))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static void eq(String what, Object got, Object want) {
+        check(java.util.Objects.equals(got, want), () -> what + ": got " + show(got) + ", want " + show(want));
+    }
+
+    // ------------------------------------------------------------------ models: substrings and padding
+
+    static String modelSubstring(String s, int start) {
+        if (start < 0) {
+            start = s.length() + start;
+        }
+        if (start < 0) {
+            start = 0;
+        }
+        if (start > s.length()) {
+            return "";
+        }
+        return s.substring(start);
+    }
+
+    static String modelSubstring(String s, int start, int end) {
+        if (end < 0) {
+            end = s.length() + end;
+        }
+        if (start < 0) {
+            start = s.length() + start;
+        }
+        if (end > s.length()) {
+            end = s.length();
+        }
+        if (start > end) {
+            return "";
+        }
+        if (start < 0) {
+            start = 0;
+        }
+        if (end < 0) {
+            end = 0;
+        }
+        return s.substring(start, end);
+    }
+
+    static String modelLeft(String s, int len) {
+        if (len < 0) {
+            return "";
+        }
+        return s.length() <= len ? s : s.substring(0, len);
+    }
+
+    static String modelRight(String s, int len) {
+        if (len < 0) {
+            return "";
+        }
+        return s.length() <= len ? s : s.substring(s.length() - len);
+    }
+
+    static String modelMid(String s, int pos, int len) {
+        if (len < 0 || pos > s.length()) {
+            return "";
+        }
+        if (pos < 0) {
+            pos = 0;
+        }
+        if (s.length() - pos <= len) {
+            return s.substring(pos);
+        }
+        return s.substring(pos, pos + len);
+    }
+
+    /** abbreviate(str, marker, offset, maxWidth) as its example table defines it (strings without surrogate pairs). */
+    static String modelAbbreviate(String str, String marker, int offset, int maxWidth) {
+        if (str.isEmpty()) {
+            return str;
+        }
+        if (marker == null) {
+            marker = "";
+        }
+        int markerLen = marker.length();
+        if (maxWidth < markerLen + 1) {
+            throw new IllegalArgumentException("min width");
+        }
+        int strLen = str.length();
+        if (strLen <= maxWidth) {
+            return str;
+        }
+        if (strLen - offset <= maxWidth - markerLen) {
+            return marker + str.substring(strLen - (maxWidth - markerLen));
+        }
+        if (offset <= markerLen + 1) {
+            return str.substring(0, maxWidth - markerLen) + marker;
+        }
+        if (maxWidth < 2 * markerLen + 1) {
+            throw new IllegalArgumentException("min width with offset");
+        }
+        return marker + modelAbbreviate(str.substring(offset), marker, 0, maxWidth - markerLen);
+    }
+
+    static boolean splitsPair(String s, int i) {
+        return i > 0 && i < s.length() && Character.isHighSurrogate(s.charAt(i - 1)) && Character.isLowSurrogate(s.charAt(i));
+    }
+
+    static String modelAbbreviateMiddle(String str, String middle, int length) {
+        if (str.isEmpty() || middle == null || middle.isEmpty() || length >= str.length() || length < middle.length() + 2) {
+            return str;
+        }
+        int target = length - middle.length();
+        int startOffset = target / 2 + target % 2;
+        int endOffset = str.length() - target / 2;
+        return str.substring(0, startOffset) + middle + str.substring(endOffset);
+    }
+
+    static String cyclicPad(String padStr, int pads) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < pads; i++) {
+            sb.append(padStr.charAt(i % padStr.length()));
+        }
+        return sb.toString();
+    }
+
+    static String modelLeftPad(String s, int size, String padStr) {
+        if (padStr == null || padStr.isEmpty()) {
+            padStr = " ";
+        }
+        int pads = size - s.length();
+        return pads <= 0 ? s : cyclicPad(padStr, pads) + s;
+    }
+
+    static String modelRightPad(String s, int size, String padStr) {
+        if (padStr == null || padStr.isEmpty()) {
+            padStr = " ";
+        }
+        int pads = size - s.length();
+        return pads <= 0 ? s : s + cyclicPad(padStr, pads);
+    }
+
+    static String modelCenter(String s, int size, String padStr) {
+        if (size <= 0) {
+            return s;
+        }
+        int pads = size - s.length();
+        if (pads <= 0) {
+            return s;
+        }
+        String left = modelLeftPad(s, s.length() + pads / 2, padStr);
