+    @Test
+    void fractionArithmeticMatchesBigIntegerRationals() {
+        Zoo.run("fractionArithmeticMatchesBigIntegerRationals", tc -> {
+            FracCase c = tc.draw(FRAC_CASE, "case");
+            int n1 = c.n1();
+            int d1 = c.d1();
+            int n2 = c.n2();
+            int d2 = c.d2();
+            if (d1 == 0 || d2 == 0) {
+                int dz = d1 == 0 ? d1 : d2;
+                throwsA(ArithmeticException.class, () -> Fraction.getFraction(n1, dz), "getFraction with a zero denominator");
+                return;
+            }
+            String ctx = " for " + n1 + "/" + d1 + " and " + n2 + "/" + d2;
+            Fraction f1 = Fraction.getFraction(n1, d1);
+            Fraction f2 = Fraction.getFraction(n2, d2);
+            // stored form: the sign moves to the numerator, nothing is reduced
+            eq("numerator" + ctx, f1.getNumerator(), d1 < 0 ? -n1 : n1);
+            eq("denominator" + ctx, f1.getDenominator(), Math.abs(d1));
+            eqFraction("getReducedFraction" + ctx, Fraction.getReducedFraction(n1, d1), rational(n1, d1));
+            eqFraction("reduce" + ctx, f1.reduce(), rational(n1, d1));
+            eq("equals is by stored parts" + ctx, f1.equals(Fraction.getFraction(n2, d2)), f1.getNumerator() == f2.getNumerator() && f1.getDenominator() == f2.getDenominator());
+            eq("hashCode of equal fractions" + ctx, Fraction.getFraction(n1, d1).hashCode(), f1.hashCode());
+            // order and value
+            BigInteger lhs = BigInteger.valueOf((long) f1.getNumerator() * f2.getDenominator());
+            BigInteger rhs = BigInteger.valueOf((long) f2.getNumerator() * f1.getDenominator());
+            eq("compareTo" + ctx, Integer.signum(f1.compareTo(f2)), lhs.compareTo(rhs));
+            eq("doubleValue" + ctx, f1.doubleValue(), (double) f1.getNumerator() / f1.getDenominator());
+            eq("intValue" + ctx, f1.intValue(), n1 / d1);
+            // arithmetic against reduced rationals (results are reduced, Knuth 4.5.1)
+            eqFraction("add" + ctx, f1.add(f2), rational((long) n1 * d2 + (long) n2 * d1, (long) d1 * d2));
+            eqFraction("subtract" + ctx, f1.subtract(f2), rational((long) n1 * d2 - (long) n2 * d1, (long) d1 * d2));
+            eqFraction("multiplyBy" + ctx, f1.multiplyBy(f2), rational((long) n1 * n2, (long) d1 * d2));
+            if (n2 == 0) {
+                throwsA(ArithmeticException.class, () -> f1.divideBy(f2), "divideBy zero" + ctx);
+                throwsA(ArithmeticException.class, f2::invert, "invert zero" + ctx);
+            } else {
+                eqFraction("divideBy" + ctx, f1.divideBy(f2), rational((long) n1 * d2, (long) d1 * n2));
+                eq("invert" + ctx, f2.invert(), Fraction.getFraction(n2 < 0 ^ d2 < 0 ? -Math.abs(d2) : Math.abs(d2), Math.abs(n2)));
+            }
+            eq("negate" + ctx, f1.negate(), Fraction.getFraction(-n1, d1));
+            eq("abs" + ctx, f1.abs(), Fraction.getFraction(Math.abs(n1), Math.abs(d1)));
+            checkPow(f1, n1, d1, c.p(), ctx);
+            // strings: toString and toProperString parse back to the same rational
+            Fraction back = Fraction.getFraction(f1.toString());
+            eq("toString round trip" + ctx, back, f1);
+            Fraction backProper = Fraction.getFraction(f1.toProperString());
+            eq("toProperString round trip" + ctx, backProper.compareTo(f1), 0);
+            eq("toString" + ctx, f1.toString(), f1.getNumerator() + "/" + f1.getDenominator());
+            int whole = f1.getProperWhole();
+            int properNum = f1.getProperNumerator();
+            eq("proper parts" + ctx, (long) whole * f1.getDenominator() + (whole < 0 || f1.getNumerator() < 0 ? -properNum : properNum), (long) f1.getNumerator());
+            // the continued fraction conversion recovers small rationals exactly
+            eq("getFraction(double)" + ctx, Fraction.getFraction((double) n1 / d1), Fraction.getReducedFraction(n1, d1));
+            eq("getFraction(whole, n, d)" + ctx, Fraction.getFraction(Math.abs(whole), properNum, f1.getDenominator()), Fraction.getFraction(Math.abs(f1.getNumerator()), f1.getDenominator()));
+        });
+    }
