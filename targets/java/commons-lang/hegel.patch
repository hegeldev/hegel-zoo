+    /**
+     * EnumUtils.generateBitVector(s) and processBitVector(s) on the members: the bits of their set, and the documented
+     * IllegalArgumentException for a null element from both the varargs and the Iterable form (the Iterable form
+     * throws NullPointerException, commons-lang/2: judged by default, left out under HEGEL_NO_KNOWN).
+     */
+    static void checkBitVector(Bits bits) {
+        List<Colour> elements = bits.elements();
+        Colour[] array = elements.toArray(new Colour[0]);
+        String what = " for " + elements;
+        if (bits.hasNull()) {
+            throwsA(IllegalArgumentException.class, () -> EnumUtils.generateBitVector(Colour.class, array), "generateBitVector varargs with null" + what);
+            if (Zoo.NO_KNOWN) {
+                Zoo.count("not checked: generateBitVector(Class, Iterable) with a null element (commons-lang/2)");
+            } else {
+                throwsA(IllegalArgumentException.class, () -> EnumUtils.generateBitVector(Colour.class, elements), "generateBitVector Iterable with null" + what);
+            }
+            return;
+        }
+        EnumSet<Colour> subset = bits.set();
+        long bitsWanted = 0;
+        for (Colour c : subset) {
+            bitsWanted |= 1L << c.ordinal();
+        }
+        eq("generateBitVector" + what, EnumUtils.generateBitVector(Colour.class, elements), bitsWanted);
+        eq("generateBitVector varargs" + what, EnumUtils.generateBitVector(Colour.class, array), bitsWanted);
+        eq("generateBitVectors" + what, Arrays.toString(EnumUtils.generateBitVectors(Colour.class, elements)), Arrays.toString(new long[] {bitsWanted}));
+        eq("processBitVector " + bitsWanted, EnumUtils.processBitVector(Colour.class, bitsWanted), subset);
+        eq("processBitVectors " + bitsWanted, EnumUtils.processBitVectors(Colour.class, bitsWanted), subset);
+    }
