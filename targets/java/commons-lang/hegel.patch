+            eq("ObjectUtils.anyNull" + octx, ObjectUtils.anyNull((Object[]) values), nonNull.size() != values.length);
+            eq("ObjectUtils.identityToString", ObjectUtils.identityToString(p), cls + "@" + hash);
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/CommonsLangShapesTest.java b/hegel/src/test/java/zoo/CommonsLangShapesTest.java
new file mode 100644
index 0000000..01ebd5e
--- /dev/null
+++ b/hegel/src/test/java/zoo/CommonsLangShapesTest.java
@@ -0,0 +1,263 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.INDEX;
+import static zoo.Gen.into;
+import static zoo.Gen.ints;
+import static zoo.Gen.many;
+import static zoo.Gen.maybe;
+import static zoo.Gen.pick;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Gen.word;
+import static zoo.Zoo.check;
+import static zoo.Zoo.show;
+
+import dev.hegel.Generator;
+import java.util.List;
+import org.apache.commons.lang3.RandomStringUtils;
+import org.apache.commons.lang3.math.Fraction;
+import org.junit.jupiter.api.Test;
+
+/**
+ * One narrow property per recorded bug, judged by the oracle the wide properties use ({@link CommonsLangTest} and
+ * {@link CommonsLangMoreTest}'s shared checks). By default each draws the bug's shape and fails on it; under
+ * {@code HEGEL_NO_KNOWN=1} ({@link Zoo#NO_KNOWN}) it draws the neighbouring region, where the promise holds.
+ */
+class CommonsLangShapesTest {
+
+    // ------------------------------------------------------------------ commons-lang/1
+
+    /**
+     * abbreviate's head branch ({@code 1 <= offset <= marker.length() + 1}, {@code maxWidth <= offset + marker.length()})
+     * on a string of distinct letters, with a legal width; beside it (HEGEL_NO_KNOWN) the widths one past the branch.
+     */
+    static final Generator<CommonsLangTest.LeftEdge> HEAD_EDGE = CommonsLangTest.EDGE_MARKER.flatMap(mk -> ints(1, mk.length() + 1).flatMap(off -> {
+        int branch = off + mk.length();
+        Generator<Integer> letters = ints(branch + 1, 26);
+        return letters.flatMap(k -> tuples(just(k), just(off), Zoo.NO_KNOWN ? ints(branch + 1, k + 1) : ints(1, branch), just(mk))
+            .map(t -> new CommonsLangTest.LeftEdge(t.value1(), t.value2(), t.value3(), t.value4())));
+    }));
+
+    @Test
+    void abbreviateKeepsTheLeftEdge() {
+        Zoo.run("abbreviateKeepsTheLeftEdge", tc -> {
+            CommonsLangTest.LeftEdge e = tc.draw(HEAD_EDGE, "edge");
+            CommonsLangTest.checkAbbreviateEdge(e.text(), e.mk(), e.off(), e.mw());
+        });
+    }
+
+    // ------------------------------------------------------------------ commons-lang/2
+
+    /** Members with a null element at a drawn position; beside it (HEGEL_NO_KNOWN) one time in two without the null. */
+    static final Generator<CommonsLangMoreTest.Bits> NULL_BITS = tuples(many(pick(CommonsLangMoreTest.Colour.values()), 0, 8), Zoo.NO_KNOWN ? maybe(50, -1, INDEX) : INDEX)
+        .map(t -> new CommonsLangMoreTest.Bits(t.value1(), t.value2()));
+
+    @Test
+    void generateBitVectorRejectsNullElementsWithIAE() {
+        Zoo.run("generateBitVectorRejectsNullElementsWithIAE", tc -> {
+            CommonsLangMoreTest.checkBitVector(tc.draw(NULL_BITS, "bits"));
+        });
+    }
+
+    // ------------------------------------------------------------------ commons-lang/3
+
+    /** join's array, separator and a range: one bound invalid in each of the four documented ways; beside it (HEGEL_NO_KNOWN) a valid range. */
+    record JoinRange(List<String> parts, String sep, int st, int en) {}
+
+    static Generator<JoinRange> joinRange(List<String> parts) {
+        int len = parts.size();
+        Generator<Integer> inSt = ints(0, Math.max(0, len - 1));
+        Generator<Integer> inEn = ints(0, len);
+        Generator<Integer> anySt = ints(-1, len + 1);
+        Generator<Integer> anyEn = ints(-1, len + 1);
+        Generator<dev.hegel.Tuple2<Integer, Integer>> range = Zoo.NO_KNOWN
+            ? tuples(inSt, inEn)
+            : weighted(
+                w(1, tuples(just(-1), anyEn)),
+                w(1, tuples(just(len), anyEn)),
+                w(1, tuples(anySt, just(-1))),
+                w(1, tuples(anySt, just(len + 1))));
+        return tuples(pick(",", "", " - "), range).map(t -> new JoinRange(parts, t.value1(), t.value2().value1(), t.value2().value2()));
+    }
+
+    static final Generator<JoinRange> JOIN_RANGE = many(word("ab", 0, 2), Zoo.NO_KNOWN ? 1 : 0, 4).flatMap(CommonsLangShapesTest::joinRange);
+
+    @Test
+    void joinWithAnInvalidRangeThrowsAIOOBE() {
+        Zoo.run("joinWithAnInvalidRangeThrowsAIOOBE", tc -> {
+            JoinRange r = tc.draw(JOIN_RANGE, "range");
+            String[] parts = r.parts().toArray(new String[0]);
+            CommonsLangTest.checkJoinRange(parts, r.sep(), r.st(), r.en(), " for " + r.parts() + ", " + show(r.sep()));
+        });
+    }
+
+    // ------------------------------------------------------------------ commons-lang/4
+
+    /** A rename chain of six to eight links (beside it, HEGEL_NO_KNOWN: one to five) and a text holding its first letter. */
+    record LongChain(int start, int links, String before, String after) {
+        String text() {
+            return before + CommonsLangTest.CHAIN_LETTERS.charAt(start) + after;
+        }
+
+        List<CommonsLangTest.Pair> pairs() {
+            return CommonsLangTest.chain(start, links);
+        }
+    }
+
+    static final Generator<LongChain> LONG_CHAIN = tuples(ints(0, CommonsLangTest.CHAIN_LETTERS.length() - 1), Zoo.NO_KNOWN ? ints(1, 5) : ints(6, CommonsLangTest.CHAIN_LETTERS.length() - 1),
+            word(CommonsLangTest.CHAIN_LETTERS + " .", 0, 3), word(CommonsLangTest.CHAIN_LETTERS + " .", 0, 3))
+        .map(t -> new LongChain(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    @Test
+    void replaceEachRepeatedlyConvergesForLongChains() {
+        Zoo.run("replaceEachRepeatedlyConvergesForLongChains", tc -> {
+            LongChain c = tc.draw(LONG_CHAIN, "chain");
+            List<CommonsLangTest.Pair> pairs = c.pairs();
+            String[] search = pairs.stream().map(CommonsLangTest.Pair::search).toArray(String[]::new);
+            String[] rep = pairs.stream().map(CommonsLangTest.Pair::rep).toArray(String[]::new);
+            CommonsLangTest.checkReplaceEachRepeatedly(c.text(), search, rep, " for " + show(c.text()));
+        });
+    }
+
+    // ------------------------------------------------------------------ commons-lang/5
+
+    /** An array and an out-of-range index (below or above, by one to three) without values; beside it (HEGEL_NO_KNOWN) the same index with values, or an in-range index without. */
+    record Insert(List<Integer> arr, int index, List<Integer> values) {}
+
+    static Generator<Insert> insert(List<Integer> arr) {
+        int len = arr.size();
+        Generator<Integer> outside = tuples(pick(false, true), ints(1, 3)).map(t -> t.value1() ? len + t.value2() : -t.value2());
+        Generator<Insert> bugShape = outside.map(i -> new Insert(arr, i, List.of()));
+        Generator<Insert> beside = weighted(
+            w(1, tuples(outside, many(ints(-3, 3), 1, 3)).map(t -> new Insert(arr, t.value1(), t.value2()))),
+            w(1, ints(0, len).map(i -> new Insert(arr, i, List.of()))));
+        return Zoo.NO_KNOWN ? beside : bugShape;
+    }
+
+    static final Generator<Insert> INSERT = many(ints(-3, 3), 0, 6).flatMap(CommonsLangShapesTest::insert);
+
+    @Test
+    void insertWithoutValuesChecksTheIndex() {
+        Zoo.run("insertWithoutValuesChecksTheIndex", tc -> {
+            Insert c = tc.draw(INSERT, "insert");
+            int[] arr = c.arr().stream().mapToInt(Integer::intValue).toArray();
+            int[] vals = c.values().stream().mapToInt(Integer::intValue).toArray();
+            CommonsLangTest.checkInsert(arr, c.index(), vals, " for " + c.arr());
+        });
+    }
+
+    // ------------------------------------------------------------------ commons-lang/6
+
+    /** A negative count; beside it (HEGEL_NO_KNOWN) a count of zero or more, whose string has that length. */
+    static final Generator<Integer> COUNT = Zoo.NO_KNOWN ? ints(0, 20) : ints(-1_000_000, -1);
+
+    @Test
+    void negativeRandomStringCountMessageNamesTheCount() {
+        Zoo.run("negativeRandomStringCountMessageNamesTheCount", tc -> {
+            int count = tc.draw(COUNT, "count");
+            RandomStringUtils rs = RandomStringUtils.insecure();
+            if (count < 0) {
+                CommonsLangMoreTest.checkNegativeCount(count, () -> rs.next(count), "next(" + count + ")");
+                CommonsLangMoreTest.checkNegativeCount(count, () -> rs.next(count, "abc"), "next(" + count + ", \"abc\")");
+                CommonsLangMoreTest.checkNegativeCount(count, () -> rs.nextAlphanumeric(count), "nextAlphanumeric(" + count + ")");
+            } else {
+                check(rs.next(count).length() == count, () -> "next(" + count + ") has the wrong length");
+                check(rs.next(count, "abc").length() == count, () -> "next(" + count + ", \"abc\") has the wrong length");
+            }
+        });
+    }
+
+    // ------------------------------------------------------------------ commons-lang/7
+
+    /** The nibbles 10..15, whose documented digits are letters; beside them (HEGEL_NO_KNOWN) 0..9. */
+    static final Generator<Integer> NIBBLE = Zoo.NO_KNOWN ? ints(0, 9) : ints(10, 15);
+
+    @Test
+    void intToHexDigitReturnsUpperCaseAsDocumented() {
+        Zoo.run("intToHexDigitReturnsUpperCaseAsDocumented", tc -> {
+            CommonsLangMoreTest.checkHexDigit(tc.draw(NIBBLE, "nibble"));
+        });
+    }
+
+    // ------------------------------------------------------------------ commons-lang/8
+
+    /** An unreduced fraction (a common factor of two to six, or a zero over more than one) and a power of +-1; beside it (HEGEL_NO_KNOWN) the powers +-2 and +-3. */
+    record Unreduced(int g, int a, int b, int p) {
+        int n() {
+            return g * a;
+        }
+
+        int d() {
+            return g * b;
+        }
+    }
+
+    static final Generator<Unreduced> UNREDUCED = tuples(ints(2, 6), ints(-8, 8), ints(1, 8), Zoo.NO_KNOWN ? pick(2, -2, 3, -3) : pick(1, -1))
+        .map(t -> new Unreduced(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    @Test
+    void powOfOneAndMinusOneIsReduced() {
+        Zoo.run("powOfOneAndMinusOneIsReduced", tc -> {
+            Unreduced u = tc.draw(UNREDUCED, "fraction");
+            CommonsLangMoreTest.checkPow(Fraction.getFraction(u.n(), u.d()), u.n(), u.d(), u.p(), " for " + u.n() + "/" + u.d());
+        });
+    }
+
+    // ------------------------------------------------------------------ commons-lang/9
+
+    /** Pieces of letters and blanks, with at least one U+00A0 among them; beside it (HEGEL_NO_KNOWN) the same pieces with a tab instead. */
+    static final Generator<String> BLANK_PIECE = pick("a", " ", "b", "  ", "\t", CommonsLangTest.NBSP, CommonsLangTest.NBSP + CommonsLangTest.NBSP, " " + CommonsLangTest.NBSP);
+
