+    /**
+     * replaceEachRepeatedly against repeated rounds of the replaceEach model: the settled text when the rounds settle,
+     * the documented IllegalStateException when they never do. A text that settles after six or more rounds is
+     * commons-lang/4's shape (the library gives up after five): judged by default, left out under HEGEL_NO_KNOWN.
+     */
+    static void checkReplaceEachRepeatedly(String s, String[] search, String[] rep, String ctx) {
+        List<String> rounds = modelReplaceEachRounds(s, search, rep);
+        String what = "replaceEachRepeatedly" + ctx + " with " + Arrays.toString(search) + " -> " + Arrays.toString(rep);
+        if (rounds == null) {
+            CommonsLangMoreTest.throwsA(IllegalStateException.class, () -> StringUtils.replaceEachRepeatedly(s, search, rep), what + " (endless)");
+            return;
+        }
+        if (Zoo.NO_KNOWN && rounds.size() > 5) {
+            Zoo.count("not checked: replaceEachRepeatedly settling after six or more rounds (commons-lang/4)");
+            return;
+        }
+        String want = rounds.isEmpty() ? s : rounds.get(rounds.size() - 1);
+        String got;
+        try {
+            got = StringUtils.replaceEachRepeatedly(s, search, rep);
+        } catch (IllegalStateException e) {
+            Zoo.fail(what + " threw " + e.getMessage() + " although the rounds settle after " + rounds.size() + ": " + rounds);
+            return;
+        }
+        eq(what + " (" + rounds.size() + " rounds)", got, want);
+    }
