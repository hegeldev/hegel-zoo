+
+    static ZonedDateTime zdt(long ms) {
+        return Instant.ofEpochMilli(ms).atZone(ZoneOffset.UTC);
+    }
+
+    static ZonedDateTime truncateTo(ZonedDateTime t, int field) {
+        return switch (field) {
+            case Calendar.SECOND -> t.truncatedTo(ChronoUnit.SECONDS);
+            case Calendar.MINUTE -> t.truncatedTo(ChronoUnit.MINUTES);
+            case Calendar.HOUR_OF_DAY, Calendar.HOUR -> t.truncatedTo(ChronoUnit.HOURS);
+            case Calendar.DATE -> t.truncatedTo(ChronoUnit.DAYS);
+            case Calendar.MONTH -> t.truncatedTo(ChronoUnit.DAYS).withDayOfMonth(1);
+            case Calendar.YEAR -> t.truncatedTo(ChronoUnit.DAYS).withDayOfYear(1);
+            default -> throw new IllegalArgumentException("field " + field);
+        };
+    }
+
+    static ZonedDateTime plusOne(ZonedDateTime t, int field) {
+        return switch (field) {
+            case Calendar.SECOND -> t.plusSeconds(1);
+            case Calendar.MINUTE -> t.plusMinutes(1);
+            case Calendar.HOUR_OF_DAY, Calendar.HOUR -> t.plusHours(1);
+            case Calendar.DATE -> t.plusDays(1);
+            case Calendar.MONTH -> t.plusMonths(1);
+            case Calendar.YEAR -> t.plusYears(1);
+            default -> throw new IllegalArgumentException("field " + field);
+        };
+    }
+
+    /** round: the most significant dropped field decides, "more than halfway" with integer halves (so exactly half rounds up). */
+    static boolean roundsUp(ZonedDateTime t, int field) {
+        return switch (field) {
+            case Calendar.SECOND -> t.getNano() / 1_000_000 > 499;
+            case Calendar.MINUTE -> t.getSecond() > 29;
+            case Calendar.HOUR_OF_DAY, Calendar.HOUR -> t.getMinute() > 29;
+            case Calendar.DATE -> t.getHour() > 11;
+            case Calendar.MONTH -> t.getDayOfMonth() - 1 > (t.toLocalDate().lengthOfMonth() - 1) / 2;
+            case Calendar.YEAR -> t.getMonthValue() - 1 > 5;
+            default -> throw new IllegalArgumentException("field " + field);
+        };
+    }
+
+    /**
+     * An instant in 1900-2090 as a day, a second of the day and a millisecond; one time in five the millisecond is
+     * snapped to 0, 500 or 999 (a half boundary), one time in five the time to a half-hour boundary.
+     */
+    record Stamp(int day, int sec, int milli, int snapMs, long snapHalfHour) {
+        long ms() {
+            long ms = day * 86_400_000L + sec * 1000L + milli;
+            if (snapMs >= 0) {
+                ms = ms / 1000 * 1000 + snapMs;
+            }
+            if (snapHalfHour >= 0) {
+                ms = ms / 3_600_000L * 3_600_000L + snapHalfHour;
+            }
+            return ms;
+        }
+    }
+
+    static final Generator<Stamp> STAMP = tuples(ints(-25_000, 45_000), ints(0, 86_399), ints(0, 999), maybe(20, -1, pick(0, 500, 999)), maybe(20, -1L, pick(0L, 1_800_000L, 1_799_999L)))
+        .map(t -> new Stamp(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    /** An instant, a calendar field, an amount to add, an hour and a year to set, and a format pattern. */
+    record DateCase(Stamp stamp, int field, int k, int hour, int year, String pattern) {}
