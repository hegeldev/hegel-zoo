+            eq("Pair equals MutablePair" + ctx, pair, MutablePair.of(p.name, p.age));
+            eq("Pair compareTo" + ctx, Integer.signum(Pair.of(p.age, "a").compareTo(Pair.of(q.age, "b"))), p.age != q.age ? Integer.compare(p.age, q.age) : -1);
+            throwsA(UnsupportedOperationException.class, () -> pair.setValue(1), "ImmutablePair.setValue");
+            MutablePair<String, Integer> mp = MutablePair.of(p.name, p.age);
+            mp.setValue(q.age);
+            eq("MutablePair.setValue" + ctx, mp.getRight(), q.age);
+            eq("ImmutablePair.nullPair", ImmutablePair.nullPair().getLeft(), null);
+            Triple<String, Integer, Boolean> triple = Triple.of(p.name, p.age, p.smoker);
+            eq("Triple toString" + ctx, triple.toString(), "(" + p.name + "," + p.age + "," + p.smoker + ")");
+            eq("Triple hashCode" + ctx, triple.hashCode(), Objects.hashCode(p.name) ^ Objects.hashCode(p.age) ^ Objects.hashCode(p.smoker));
+            eq("Triple equals" + ctx, triple.equals(Triple.of(q.name, q.age, q.smoker)), same);
+            eq("Triple compareTo" + ctx, Integer.signum(Triple.of(1, p.age, p.smoker).compareTo(Triple.of(1, q.age, q.smoker))), p.age != q.age ? Integer.compare(p.age, q.age) : Boolean.compare(p.smoker, q.smoker));
+            // serialization
+            Person clone = SerializationUtils.clone(p);
+            eq("SerializationUtils.clone" + ctx, EqualsBuilder.reflectionEquals(clone, p), true);
+            eq("clone is a copy" + ctx, clone == p, false);
+            eq("SerializationUtils.roundtrip" + ctx, EqualsBuilder.reflectionEquals(SerializationUtils.roundtrip(p), p), true);
+            byte[] bytes = SerializationUtils.serialize(p);
+            eq("deserialize(serialize)" + ctx, EqualsBuilder.reflectionEquals(SerializationUtils.<Person>deserialize(bytes), p), true);
+            eq("deserialize(stream)" + ctx, EqualsBuilder.reflectionEquals(SerializationUtils.<Person>deserialize(new java.io.ByteArrayInputStream(bytes)), p), true);
+            eq("clone(null)", SerializationUtils.clone(null), null);
+            // random strings: length, alphabet, well-formed UTF-16
+            Extras x = c.extras();
+            int count = x.count();
+            RandomStringUtils rs = RandomStringUtils.insecure();
+            eq("next(count) length", rs.next(count).length(), count);
+            String fromAlphabet = rs.next(count, "abc");
+            eq("next(count, chars) alphabet " + show(fromAlphabet), fromAlphabet.chars().allMatch(ch -> "abc".indexOf(ch) >= 0) && fromAlphabet.length() == count, true);
+            String numeric = rs.nextNumeric(count);
+            eq("nextNumeric " + show(numeric), numeric.length() == count && numeric.chars().allMatch(ch -> ch >= '0' && ch <= '9'), true);
+            String alpha = rs.nextAlphabetic(count);
+            eq("nextAlphabetic " + show(alpha), alpha.length() == count && alpha.chars().allMatch(ch -> ch >= 'a' && ch <= 'z' || ch >= 'A' && ch <= 'Z'), true);
+            String alnum = rs.nextAlphanumeric(count);
+            eq("nextAlphanumeric " + show(alnum), alnum.length() == count && alnum.chars().allMatch(ch -> Character.isLetterOrDigit(ch) && ch < 128), true);
+            String ascii = rs.nextAscii(count);
+            eq("nextAscii " + show(ascii), ascii.length() == count && ascii.chars().allMatch(ch -> ch >= 32 && ch <= 126), true);
+            String ranged = rs.next(count, 'a', 'f' + 1, true, false);
+            eq("next(count, start, end, letters) " + show(ranged), ranged.length() == count && ranged.chars().allMatch(ch -> ch >= 'a' && ch <= 'f'), true);
+            String unicode = rs.next(count, 0, 0, false, false);
+            eq("next(count, 0, 0, false, false) is well formed " + show(unicode), CommonsLangTest.wellFormed(unicode), true);
+            int lo = x.lo();
+            int hi = lo + x.span();
+            int between = rs.nextAlphanumeric(lo, hi).length();
+            eq("nextAlphanumeric(min, max) length " + between + " in [" + lo + ", " + hi + ")", between >= lo && between < hi, true);
+            int neg = -1 - count;
+            checkNegativeCount(neg, () -> rs.next(neg), "next(" + neg + ")");
+            throwsA(IllegalArgumentException.class, () -> rs.next(count + 1, ""), "next with an empty alphabet");
+            throwsA(IllegalArgumentException.class, () -> rs.next(count + 1, 'z', 'a', true, true), "next with end <= start");
+            // Validate: exception mapping and messages
+            throwsA(IllegalArgumentException.class, () -> {
+                Validate.isTrue(count > 100);
+                return null;
+            }, "isTrue");
+            throwsA(NullPointerException.class, () -> Validate.notNull(null), "notNull");
+            throwsA(IllegalArgumentException.class, () -> Validate.notEmpty(""), "notEmpty(\"\")");
+            throwsA(NullPointerException.class, () -> Validate.notEmpty((String) null), "notEmpty(null)");
+            throwsA(IllegalArgumentException.class, () -> Validate.notBlank("  "), "notBlank");
+            throwsA(IllegalStateException.class, () -> {
+                Validate.validState(false);
