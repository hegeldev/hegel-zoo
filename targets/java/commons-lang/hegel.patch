+    static Boolean modelToBooleanObject(String s) {
+        switch (s.length()) {
+            case 1 -> {
+                char c = s.charAt(0);
+                if (c == 'y' || c == 'Y' || c == 't' || c == 'T' || c == '1') {
+                    return Boolean.TRUE;
+                }
+                if (c == 'n' || c == 'N' || c == 'f' || c == 'F' || c == '0') {
+                    return Boolean.FALSE;
+                }
+                return null;
+            }
+            case 2 -> {
+                if (s.equalsIgnoreCase("on")) {
+                    return Boolean.TRUE;
+                }
+                if (s.equalsIgnoreCase("no")) {
+                    return Boolean.FALSE;
+                }
+                return null;
+            }
+            case 3 -> {
+                if (s.equalsIgnoreCase("yes")) {
+                    return Boolean.TRUE;
+                }
+                if (s.equalsIgnoreCase("off")) {
+                    return Boolean.FALSE;
+                }
+                return null;
+            }
+            case 4 -> {
+                return s.equalsIgnoreCase("true") ? Boolean.TRUE : null;
+            }
+            case 5 -> {
+                return s.equalsIgnoreCase("false") ? Boolean.FALSE : null;
+            }
+            default -> {
+                return null;
+            }
+        }
+    }
