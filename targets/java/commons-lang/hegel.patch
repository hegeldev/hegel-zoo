+    static String modelWords(long ms, boolean lead, boolean trail) {
+        long d = ms / 86_400_000L;
+        long h = ms / 3_600_000L % 24;
+        long m = ms / 60_000L % 60;
+        long s = ms / 1000L % 60;
+        String duration = d + " days " + h + " hours " + m + " minutes " + s + " seconds";
+        if (lead) {
+            duration = " " + duration;
+            String tmp = duration.replaceFirst(" 0 days", "");
+            if (tmp.length() != duration.length()) {
+                duration = tmp;
+                tmp = duration.replaceFirst(" 0 hours", "");
+                if (tmp.length() != duration.length()) {
+                    duration = tmp;
+                    duration = duration.replaceFirst(" 0 minutes", "");
+                }
+            }
+            if (!duration.isEmpty()) {
+                duration = duration.substring(1);
+            }
+        }
+        if (trail) {
+            String tmp = duration.replaceFirst(" 0 seconds", "");
+            if (tmp.length() != duration.length()) {
+                duration = tmp;
+                tmp = duration.replaceFirst(" 0 minutes", "");
+                if (tmp.length() != duration.length()) {
+                    duration = tmp;
+                    tmp = duration.replaceFirst(" 0 hours", "");
+                    if (tmp.length() != duration.length()) {
+                        duration = tmp.replaceFirst(" 0 days", "");
+                    }
+                }
+            }
+        }
+        duration = " " + duration;
+        duration = duration.replaceFirst(" 1 seconds", " 1 second").replaceFirst(" 1 minutes", " 1 minute").replaceFirst(" 1 hours", " 1 hour").replaceFirst(" 1 days", " 1 day");
+        return duration.trim();
+    }
+
