+    /**
+     * abbreviate(str, marker, offset, maxWidth) on a string of distinct letters: the example table (the model), "in no
+     * case ... longer than maxWidth", and "the left edge ... will appear somewhere in the result". The head branch with
+     * {@code 1 <= offset <= marker.length() + 1} and {@code maxWidth <= offset + marker.length()} drops the edge
+     * (commons-lang/1); it is judged by default and left out under HEGEL_NO_KNOWN.
+     */
+    static void checkAbbreviateEdge(String d, String mk, int off, int mw) {
+        String what = "abbreviate(" + show(d) + ", " + show(mk) + ", " + off + ", " + mw + ")";
+        String want;
+        try {
+            want = modelAbbreviate(d, mk, off, mw);
+        } catch (IllegalArgumentException e) {
+            Assertions.assertThrows(IllegalArgumentException.class, () -> StringUtils.abbreviate(d, mk, off, mw), what);
+            return;
+        }
+        String got = StringUtils.abbreviate(d, mk, off, mw);
+        eq(what, got, want);
+        check(got.length() <= Math.max(mw, d.length() <= mw ? d.length() : 0), () -> "abbreviate longer than maxWidth: " + show(got) + " for " + what);
+        boolean headShape = off >= 1 && off <= mk.length() + 1 && mw <= off + mk.length();
+        if (Zoo.NO_KNOWN && headShape) {
+            Zoo.count("not checked: the left edge of a head-branch abbreviation (commons-lang/1)");
+            return;
+        }
+        check(got.indexOf(d.charAt(off)) >= 0, () -> "abbreviate lost its left edge " + d.charAt(off) + ": " + show(got) + " for " + what);
+    }
