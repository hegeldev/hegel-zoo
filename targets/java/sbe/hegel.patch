+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.maps;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.INDEX;
+import static zoo.Gen.at;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.longs;
+import static zoo.Gen.many;
+import static zoo.Gen.maybe;
+import static zoo.Gen.pick;
+import static zoo.Gen.v;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Gen.word;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import uk.co.real_logic.sbe.PrimitiveType;
+
+/**
+ * Random SBE message schemas, wider than upstream's jqwik arbitraries: big-endian byte order, constant fields and
+ * members (with values or enum valueRefs), custom min/max/null values, explicit offsets (padding), sinceVersion and
+ * deprecated on fields, groups, data and composite members, custom group dimension types, UTF-8 var data, a second
+ * message, and descriptions/semantic types. The message under test is always {@code TestMessage} (template id 1).
+ *
+ * <p>A schema is drawn as a tree of records ({@link Spec}: messages of members, members of types, types of members)
+ * from a {@link Grammar} built once per flavour, and {@link #render rendered} to XML by a pure function that also
+ * numbers the types and members and returns the {@link LBody layout} the value generator ({@link SbeGen#values})
+ * reads. Types are declared where they are first used; a {@link Reuse} refers back to one declared earlier (an index
+ * modulo the fitting declarations), which is how the old generator's type pool is spelled as data. The first
+ * alternative of every choice is the plainest, so a shrunk schema is a small message of plain types.
+ *
+ * <p>The recorded bugs' shapes (bugs.toml) are drawn: uint64 types span their whole unsigned range (bug sbe/1), a
+ * group drawn as {@code type} is named like a set or composite type among its fields (bug sbe/6), and the
+ * {@link Grammar}'s shape regions (one per bug, drawn by SbeTest's narrow properties) put each bug's shape into an
+ * otherwise random schema. Under {@code HEGEL_NO_KNOWN} ({@link Zoo#NO_KNOWN}) such groups are plain members and the
+ * regions take the shapes the library handles.
+ */
+final class SchemaGen {
+    private SchemaGen() {}
+
+    static final String PACKAGE = "uk.co.real_logic.sbe.properties";
+    static final int MAX_COMPOSITE_DEPTH = 3;
+    static final int MAX_GROUP_DEPTH = 3;
+
+    // ------------------------------------------------------------------ the drawn schema
+
+    /** A presence attribute: not written, or one of the two values (constant presence follows from the type). */
+    enum Presence { DEFAULT, REQUIRED, OPTIONAL }
+
+    sealed interface TypeSpec permits Encoded, EnumSpec, SetSpec, CompositeSpec, Reuse, ConstEnum {}
+
+    /** A custom range and/or null value of an encoded type; null where the primitive's default applies. */
+    record Custom(Long lo, Long hi, Long nul) {
+        static final Custom NONE = new Custom(null, null, null);
+    }
+
+    /** A {@code <type>}; constant is the constant's text when the type is a constant, else null. */
+    record Encoded(PrimitiveType pt, int length, Presence presence, Custom custom, String charset, String semanticType, String description, String constant)
+            implements TypeSpec {
+        boolean isConstant() {
+            return constant != null;
+        }
+    }
+
+    record EnumValue(int since, String description) {}
+
+    /** An {@code <enum>}: the valid values by their encoded value (a char enum holds the letter's code), named Case0.. in order. */
+    record EnumSpec(String encodingType, Map<Long, EnumValue> values, boolean explicitNull) implements TypeSpec {}
+
+    /** A {@code <set>}: the choices by bit, each with its sinceVersion (0 for none). */
+    record SetSpec(int bits, Map<Integer, Integer> choices) implements TypeSpec {}
+
+    /** A composite member: its type, an offset padding (0 for none) and a sinceVersion (0 for none). */
+    record Member(TypeSpec type, int pad, int since) {}
+
+    /** A member repeated: the one at {@code of} inserted again at {@code at} (both modulo the live count). */
+    record Dup(int of, int at) {}
+
+    /** A constant member inserted at {@code at} (modulo the live count). */
+    record Insert(Encoded constant, int at) {}
+
+    record CompositeSpec(List<Member> members, Dup dup, Insert insert, String description) implements TypeSpec {}
+
+    /** A type declared earlier that fits the nesting level it was drawn at: an index modulo those; a plain int32 when there is none. */
+    record Reuse(int index, int level) implements TypeSpec {}
+
+    /** The type of a constant field referring to a valid value (value, modulo them) of an enum declared earlier (index, modulo them); the encoded constant when there is none. */
+    record ConstEnum(int index, int value, Encoded fallback) implements TypeSpec {}
+
+    /** A field's sinceVersion and deprecated (0 for none each). */
+    record Version(int since, int deprecated) {}
+
+    record Field(String name, TypeSpec type, Version version, Presence presence, int pad, String description) {}
+
+    /** numInGroup: the custom dimension type's count type, or null for groupSizeEncoding; extraBlock: padding after the fields, -1 for no blockLength attribute. */
+    record Group(String name, String numInGroup, int since, String description, Members members, int extraBlock) {}
+
+    /** Var data: the length type, its character encoding ("" for none), a maxValue (null for none) and a sinceVersion. */
+    record Data(String name, String lengthType, String charset, Integer maxValue, int since) {}
+
+    record Members(List<Field> fields, List<Group> groups, List<Data> data) {}
+
+    record Message(Members members, int extraBlock, String semanticType, String description) {}
+
+    /** A whole schema; other is the second message or null. */
+    record Spec(boolean extended, boolean bigEndian, String semanticVersion, String description, Message main, Message other) {}
+
+    // ------------------------------------------------------------------ the grammar
+
+    static final String[] TRICKY_NAMES = {
+        "value", "type", "name", "id", "length", "offset", "version", "count", "index", "data", "header", "limit",
+        "encodedLength", "sbeSchemaId", "blockLength", "wrap", "buffer", "string", "object", "record", "var",
+        "Int", "Class", "Enum", "Set", "Group", "Field", "select", "match", "package", "import", "self", "super",
+    };
+
+    static final Generator<PrimitiveType> PRIMITIVE = sampledFrom(PrimitiveType.values());
+    static final Generator<Integer> LENGTH = pick(1, 1, 1, 2, 13);
+    /** A type's presence attribute: written three times in five. */
+    static final Generator<Presence> TYPE_PRESENCE = weighted(v(40, Presence.DEFAULT), v(30, Presence.REQUIRED), v(30, Presence.OPTIONAL));
+    /** A field's presence attribute: written two times in five. */
+    static final Generator<Presence> FIELD_PRESENCE = weighted(v(60, Presence.DEFAULT), v(20, Presence.REQUIRED), v(20, Presence.OPTIONAL));
+    static final String CONST_CHAR = "ABCXYZabcxyz0123456789.-_!#$%*+/=?@";
+    static final String CONST_CHARS = "ABCXYZabcxyz0123456789 .-_";
+    static final Generator<String> TEXT = word("abc XYZ09-_.,:;!?()'", 1, 24);
+    /** A sinceVersion later than any drawn one (at most 2): the version a schema's latest members were added in. */
+    static final int LATEST = 3;
+
+    /** The primitive types but the given ones. */
+    static PrimitiveType[] without(PrimitiveType... excluded) {
+        List<PrimitiveType> out = new ArrayList<>(Arrays.asList(PrimitiveType.values()));
+        out.removeAll(Arrays.asList(excluded));
+        return out.toArray(PrimitiveType[]::new);
+    }
+
+    // (after the constants the grammars are built from: a static initialiser runs in declaration order)
+    private static final Grammar PLAIN = new Grammar(false);
+    private static final Grammar EXTENDED = new Grammar(true);
+
+    /** The grammar of upstream's shapes (no constants, offsets, custom values or big-endian) or of the zoo's extended ones. */
+    static Grammar grammar(boolean extended) {
+        return extended ? EXTENDED : PLAIN;
+    }
+
+    /** The generators of one flavour; extended = false reproduces upstream's shapes. */
+    static final class Grammar {
+        final boolean ext;
+        final Generator<String> name;
+        final Generator<Encoded> encoded;
+        final Generator<Encoded> constant;
+        final Generator<EnumSpec> enumType;
+        final Generator<SetSpec> setType;
+        /** The types usable at nesting level 1..3 (index level - 1): composites only from level 2 up. */
+        final List<Generator<TypeSpec>> types = new ArrayList<>();
+        final Generator<TypeSpec> fieldType;
+        final Generator<Field> field;
+        final Generator<Field> laterField;
+        /** A schema of this flavour. */
+        final Generator<Spec> spec;
+        /** As {@link #spec}, with a field added to the main message in version 3, later than anything else: the schema has older versions to evolve from. */
+        final Generator<Spec> versionedSpec;
+
+        // the recorded bugs' shape regions (bugs.toml), each a schema of this flavour holding the bug's shape
+
+        /** sbe/1: a uint64 field (its value drawn above Long.MAX_VALUE by the property) first in the main message. */
+        final Generator<Spec> uint64FieldSpec;
+        /** sbe/2: a big-endian schema whose main message starts with a set of 16 bits or more. */
+        final Generator<Spec> bigEndianSetSpec;
+        /** sbe/5: a set of 16 bits or more first in the main message (of 8 bits under HEGEL_NO_KNOWN, which the Go flyweight reads whole). */
+        final Generator<Spec> wideSetSpec;
+        /** sbe/6: a group drawn as "type" (so named like the first set or composite type among its fields) holding such a field, among the main message's groups. */
+        final Generator<Spec> groupNamedLikeItsTypeSpec;
+        /** sbe/3 and sbe/4: a schema whose main message gained a composite field in its latest version (a versioned schema with a version-0 composite field under HEGEL_NO_KNOWN). */
+        final Generator<Spec> laterCompositeSpec;
+        /** sbe/7: a versioned schema with a group holding a field among the main message's groups. */
+        final Generator<Spec> versionedGroupSpec;
+        /** sbe/8: a schema whose main message gained a numeric array field in its latest version. */
+        final Generator<Spec> laterArraySpec;
+        /** sbe/9: a schema whose main message gained a set field in its latest version. */
+        final Generator<Spec> laterSetSpec;
+        /** sbe/10: a main message of fields only, the last a constant enum field, without a blockLength attribute. */
+        final Generator<Spec> constantEnumLastSpec;
+
+        Grammar(boolean ext) {
+            this(ext, true);
+        }
+
+        /**
+         * The grammar of the flavour; without uint64 the encoded types and constants are of the other primitives: the
+         * contents of the shape regions, since a uint64 above Long.MAX_VALUE (bug sbe/1's shape) fails every oracle
+         * printing a message, and each region must shrink to its own bug.
+         */
+        Grammar(boolean ext, boolean uint64) {
+            this.ext = ext;
+            name = ext ? weighted(w(92, just("member")), w(8, pick(TRICKY_NAMES))) : just("member");
+            Generator<PrimitiveType> primitive = uint64 ? PRIMITIVE : sampledFrom(without(PrimitiveType.UINT64));
+            encoded = primitive.flatMap(this::encodedOf);
+            constant = primitive.flatMap(pt -> LENGTH.flatMap(len -> constantOf(pt, len)));
+            Generator<EnumValue> enumValue = tuples(since(10), described(10)).map(t -> new EnumValue(t.value1(), t.value2()));
+            Generator<EnumSpec> charEnum = maps(ints(0, 25).map(i -> (long) ('A' + i)), enumValue).minSize(1).maxSize(10)
+                .map(m -> new EnumSpec("char", m, false));
+            Generator<String> enumEncoding = ext ? pick("uint8", "uint8", "int8", "uint16", "int16", "int32") : just("uint8");
+            Generator<EnumSpec> numberEnum = enumEncoding.flatMap(enc -> {
+                long[] r = defaultRange(PrimitiveType.get(enc));
+                return tuples(maps(longs(Math.max(r[0], -1000), Math.min(r[1], 1000)), enumValue).minSize(1).maxSize(12), ext ? chance(15) : just(false))
+                    .map(t -> new EnumSpec(enc, t.value1(), t.value2()));
+            });
+            enumType = weighted(w(1, charEnum), w(1, numberEnum));
+            setType = pick(8, 16, 32, 64).flatMap(bits -> maps(ints(0, bits - 1), since(10)).maxSize(Math.min(bits, 8)).map(m -> new SetSpec(bits, m)));
+            for (int level = 1; level <= MAX_COMPOSITE_DEPTH; level++) {
+                int lvl = level;
+                List<Gen.Choice<TypeSpec>> fresh = new ArrayList<>();
+                fresh.add(Gen.<TypeSpec>w(1, encoded));
+                fresh.add(Gen.<TypeSpec>w(1, enumType));
+                fresh.add(Gen.<TypeSpec>w(1, setType));
+                if (level >= 2) {
+                    fresh.add(Gen.<TypeSpec>w(1, composite(level - 1)));
+                }
+                types.add(Gen.<TypeSpec>weighted(w(75, weighted(fresh)), w(25, INDEX.map(i -> new Reuse(i, lvl)))));
+            }
+            // a constant field: one time in eight, half of them a valueRef to an enum declared earlier
+            Generator<ConstEnum> constEnum = tuples(INDEX, INDEX, constant).map(t -> new ConstEnum(t.value1(), t.value2(), t.value3()));
+            fieldType = ext ? Gen.<TypeSpec>weighted(w(88, type(MAX_COMPOSITE_DEPTH)), w(6, constEnum), w(6, constant)) : type(MAX_COMPOSITE_DEPTH);
+            field = field(maybe(25, 0, pick(1, 2)), fieldType);
+            // a plain (never composite) field added after every composite member (sinceVersion at most 2): the
+            // older versions the evolution property encodes at, where every composite member is present, always exist
+            laterField = field(just(LATEST), type(1));
+            spec = spec(false);
+            versionedSpec = spec(true);
+
+            // the shape regions: a bug's shape put into a schema of the flavour without uint64 fields (see above)
+            Grammar c = uint64 ? new Grammar(ext, false) : this;
+            Encoded uint64Type = new Encoded(PrimitiveType.UINT64, 1, Presence.DEFAULT, Custom.NONE, null, null, null, null);
+            uint64FieldSpec = tuples(c.spec, c.fieldOf(0, just(uint64Type))).map(t -> withFirstField(t.value1(), t.value2()));
+            Generator<Integer> wideBits = pick(16, 32, 64);
+            bigEndianSetSpec = tuples(c.spec, c.fieldOf(0, c.setWith(wideBits))).map(t -> withFirstField(bigEndian(t.value1()), t.value2()));
+            wideSetSpec = tuples(c.spec, c.fieldOf(0, c.setWith(Zoo.NO_KNOWN ? just(8) : wideBits))).map(t -> withFirstField(t.value1(), t.value2()));
+            Generator<Field> classField = c.fieldOf(0, Gen.<TypeSpec>weighted(w(1, c.setType), w(1, c.composite(1))));
+            Generator<Group> likeItsType = tuples(c.group(MAX_GROUP_DEPTH - 1), classField).map(t -> withFirstField(named(t.value1(), "type"), t.value2()));
+            groupNamedLikeItsTypeSpec = tuples(c.spec, likeItsType, INDEX).map(t -> withGroup(t.value1(), t.value2(), t.value3()));
+            // (the later members go last, added in version LATEST, later than any other member's sinceVersion: at the
+            // version before, the message lacks exactly them)
+            Generator<CompositeSpec> composite = c.composite(MAX_COMPOSITE_DEPTH - 1);
+            laterCompositeSpec = Zoo.NO_KNOWN
+                ? tuples(c.versionedSpec, c.fieldOf(0, composite)).map(t -> withFirstField(t.value1(), t.value2()))
+                : tuples(c.spec, c.fieldOf(LATEST, composite)).map(t -> withLastField(t.value1(), t.value2()));
+            Generator<Group> fieldGroup = tuples(c.group(MAX_GROUP_DEPTH - 1), c.fieldOf(0, c.type(MAX_COMPOSITE_DEPTH))).map(t -> withFirstField(t.value1(), t.value2()));
+            versionedGroupSpec = tuples(c.versionedSpec, fieldGroup, INDEX).map(t -> withGroup(t.value1(), t.value2(), t.value3()));
+            Generator<Encoded> numericArray = sampledFrom(without(PrimitiveType.CHAR, PrimitiveType.UINT64)).flatMap(pt ->
+                tuples(pick(2, 13), TYPE_PRESENCE, c.custom(pt), c.described(10))
+                    .map(t -> new Encoded(pt, t.value1(), t.value2(), t.value3(), null, null, t.value4(), null)));
+            laterArraySpec = tuples(c.spec, c.fieldOf(LATEST, numericArray)).map(t -> withLastField(t.value1(), t.value2()));
+            laterSetSpec = tuples(c.spec, c.fieldOf(LATEST, c.setWith(pick(8, 16, 32, 64)))).map(t -> withLastField(t.value1(), t.value2()));
+            Generator<Field> constantEnum = tuples(c.name, INDEX, INDEX, c.constant, c.described(10))
+                .map(t -> new Field(t.value1(), new ConstEnum(t.value2(), t.value3(), t.value4()), new Version(0, 0), Presence.DEFAULT, 0, t.value5()));
+            constantEnumLastSpec = tuples(c.spec, c.fieldOf(0, c.enumType), constantEnum).map(t -> fieldsOnly(withFirstField(t.value1(), t.value2()), t.value3()));
+        }
+
+        /** A field of the type, added in version {@code since} (0 for none). */
+        Generator<Field> fieldOf(int since, Generator<? extends TypeSpec> type) {
+            return field(just(since), Gen.<TypeSpec>widen(type));
+        }
+
+        /** A set of the given bits with at least one choice. */
+        Generator<SetSpec> setWith(Generator<Integer> bits) {
+            return bits.flatMap(b -> maps(ints(0, b - 1), since(10)).minSize(1).maxSize(Math.min(b, 8)).map(m -> new SetSpec(b, m)));
+        }
+
+        Generator<TypeSpec> type(int level) {
+            return types.get(level - 1);
+        }
+
+        /** A value present pct/100 of the time in extended schemas, absent otherwise. */
+        <T> Generator<T> extended(int pct, T absent, Generator<? extends T> present) {
+            return ext ? maybe(pct, absent, present) : just(absent);
+        }
+
+        Generator<String> described(int pct) {
+            return extended(pct, (String) null, TEXT);
+        }
+
+        /** A sinceVersion of a type's part (extended schemas only). */
+        Generator<Integer> since(int pct) {
+            return extended(pct, 0, pick(1, 2));
+        }
+
+        // ---- types
+
+        Generator<Encoded> encodedOf(PrimitiveType pt) {
+            Generator<String> charset = pt == PrimitiveType.CHAR ? extended(20, (String) null, pick("US-ASCII", "ASCII", "UTF-8")) : just((String) null);
+            return tuples(just(pt), LENGTH, TYPE_PRESENCE, custom(pt), charset, extended(10, (String) null, pick("int", "Qty", "UTCTimestamp")), described(10))
+                .map(t -> new Encoded(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), null));
+        }
+
+        Generator<Encoded> constantOf(PrimitiveType pt, int length) {
+            Generator<String> charset = pt == PrimitiveType.CHAR ? extended(20, (String) null, pick("US-ASCII", "ASCII", "UTF-8")) : just((String) null);
+            return tuples(constantValue(pt, length), charset, extended(10, (String) null, pick("int", "Qty", "UTCTimestamp")), described(10))
+                .map(t -> new Encoded(pt, length, Presence.DEFAULT, Custom.NONE, t.value2(), t.value3(), t.value4(), t.value1()));
+        }
+
+        /** A custom range (one time in four) and a null value outside it (two times in five), or a custom null alone (one time in ten); integral types of extended schemas only. */
+        Generator<Custom> custom(PrimitiveType pt) {
+            if (!ext || pt == PrimitiveType.FLOAT || pt == PrimitiveType.DOUBLE) {
+                return just(Custom.NONE);
+            }
+            long[] r = drawableRange(pt);
+            Generator<long[]> range = tuples(longs(r[0], r[1]), longs(r[0], r[1])).map(t -> {
+                long lo = Math.min(t.value1(), t.value2());
+                long hi = Math.max(t.value1(), t.value2());
+                if (pt == PrimitiveType.CHAR) {
+                    lo = Math.max(lo, 0x21);
+                    hi = Math.max(hi, lo);
+                }
+                return new long[] {lo, hi};
+            });
+            Generator<Long> nullAlone = pt == PrimitiveType.CHAR ? pick(0x7eL, 0x21L, 0x40L) : pick(r[0], r[1], 0L);
+            return weighted(
+                v(675, Custom.NONE),
+                w(75, nullAlone.map(n -> new Custom(null, null, n))),
+                w(150, range.map(x -> new Custom(x[0], x[1], null))),
+                w(100, range.flatMap(x -> nullOutside(pt, x[0], x[1]).map(n -> new Custom(x[0], x[1], n)))));
+        }
+
+        /** A null value outside the custom range: below it, above it, or the default (a printable character for char). */
+        static Generator<Long> nullOutside(PrimitiveType pt, long lo, long hi) {
+            long[] r = drawableRange(pt);
+            List<Gen.Choice<Long>> gaps = new ArrayList<>();
+            if (lo > r[0]) {
+                gaps.add(w(1, longs(r[0], lo - 1)));
+            }
+            gaps.add(hi < r[1] ? w(1, longs(hi + 1, r[1])) : v(1, defaultNull(pt)));
+            Generator<Long> g = weighted(gaps);
+            return pt == PrimitiveType.CHAR ? g.map(n -> n < 0x21 || n > 0x7e ? (lo > 0x21 ? 0x21L : 0x7eL) : n) : g;
+        }
+
+        static Generator<String> constantValue(PrimitiveType pt, int length) {
+            switch (pt) {
+                case CHAR -> {
+                    if (length == 1) {
+                        return word(CONST_CHAR, 1, 1);
+                    }
+                    return weighted(w(7, word(CONST_CHARS, length, length)), w(3, ints(1, length).flatMap(k -> word(CONST_CHARS, k, k))));
+                }
+                case FLOAT -> {
+                    return pick("0.0", "1.5", "-2.25", "3.4028235E38", "1.0E-10");
+                }
+                case DOUBLE -> {
+                    return pick("0.0", "1.5", "-2.25", "1.7976931348623157E308", "4.9E-324");
+                }
+                default -> {
+                    long[] r = drawableRange(pt);
+                    return Gen.<Long>weighted(w(6, longs(r[0], r[1])), w(4, pick(r[0], r[1], 0L, 1L))).map(x -> Long.toString(x));
+                }
+            }
+        }
+
+        /** A composite whose members are types of the given level: one to three members, one repeated (30%), a constant inserted (15%). */
+        Generator<CompositeSpec> composite(int memberLevel) {
+            Generator<Member> member = tuples(type(memberLevel), extended(15, 0, ints(1, 4)), since(10)).map(t -> new Member(t.value1(), t.value2(), t.value3()));
+            return tuples(
+                    many(member, 1, 3),
+                    maybe(30, (Dup) null, tuples(INDEX, INDEX).map(t -> new Dup(t.value1(), t.value2()))),
+                    extended(15, (Insert) null, tuples(constant, INDEX).map(t -> new Insert(t.value1(), t.value2()))),
+                    described(10))
+                .map(t -> new CompositeSpec(t.value1(), t.value2(), t.value3(), t.value4()));
+        }
+
+        // ---- members
+
+        /** A field with the given sinceVersion; deprecated one to two versions after it (30%), or one to three when it has none (10%). */
+        Generator<Field> field(Generator<Integer> since, Generator<TypeSpec> type) {
+            Generator<Version> version = since.flatMap(s -> (s > 0 ? extended(30, 0, ints(1, 2).map(d -> s + d)) : extended(10, 0, ints(1, 3))).map(d -> new Version(s, d)));
+            return tuples(name, type, version, FIELD_PRESENCE, extended(15, 0, ints(1, 4)), described(10))
+                .map(t -> new Field(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+        }
+
+        Generator<Data> data(boolean isMessage) {
+            Generator<String> charset = ext ? pick("US-ASCII", "US-ASCII", "UTF-8", "") : pick("US-ASCII", "");
+            return pick("uint8", "uint16", "uint32").flatMap(lt -> tuples(name, just(lt), charset, maxValue(lt), isMessage ? maybe(25, 0, pick(1, 2)) : just(0))
+                .map(t -> new Data(t.value1(), t.value2(), t.value3(), t.value4(), t.value5())));
+        }
+
+        /** A maxValue: always for uint32 (up to 1000), else one time in three in extended schemas. */
+        Generator<Integer> maxValue(String lengthType) {
+            if (lengthType.equals("uint32")) {
+                return ints(1, 1000);
+            }
+            return extended(30, (Integer) null, lengthType.equals("uint8") ? ints(1, 254) : ints(1, 1000));
+        }
+
+        /** Fields (none to two three times in ten, else up to ten in a message and five in a group), groups, data. */
+        Generator<Members> members(int groupDepth, boolean isMessage, boolean versioned) {
+            Generator<List<Field>> fields = weighted(w(3, many(field, 0, 2)), w(7, many(field, 0, isMessage ? 10 : 5)));
+            if (versioned) {
+                fields = tuples(fields, laterField).map(t -> {
+                    List<Field> out = new ArrayList<>(t.value1());
+                    out.add(t.value2());
+                    return out;
+                });
+            }
+            Generator<List<Group>> groups = groupDepth > 0 ? maybe(isMessage ? 60 : 40, List.<Group>of(), many(group(groupDepth - 1), 1, 3)) : just(List.<Group>of());
+            Generator<List<Data>> data = maybe(50, List.<Data>of(), many(data(isMessage), 1, 3));
+            // fields added in later versions come last (the parser requires ascending sinceVersion)
+            return tuples(fields.map(SchemaGen::bySince), groups, data).map(t -> new Members(t.value1(), t.value2(), t.value3()));
+        }
+
+        Generator<Group> group(int groupDepth) {
+            return tuples(name, extended(30, (String) null, pick("uint8", "uint16")), since(15), described(10), members(groupDepth, false, false), extended(15, -1, ints(0, 4)))
+                .map(t -> new Group(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+        }
+
+        Generator<Message> message(int groupDepth, boolean versioned) {
+            return tuples(members(groupDepth, true, versioned), extended(15, -1, ints(0, 8)), extended(15, (String) null, pick("Order", "Quote", "8")), described(15))
+                .map(t -> new Message(t.value1(), t.value2(), t.value3(), t.value4()));
+        }
+
+        Generator<Spec> spec(boolean versioned) {
+            return tuples(just(ext), ext ? chance(30) : just(false), extended(30, (String) null, pick("1.0", "5.2.1", "FIX.5.0SP2")), described(20),
+                    message(MAX_GROUP_DEPTH, versioned), extended(20, (Message) null, message(1, false)))
+                .map(t -> new Spec(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+        }
+    }
+
+    static List<Field> bySince(List<Field> fields) {
+        List<Field> out = new ArrayList<>(fields);
+        out.sort((a, b) -> Integer.compare(a.version().since(), b.version().since()));
+        return out;
+    }
+
+    // ---- the shape regions' surgery on a drawn tree (pure functions of records)
+
+    static Spec withMain(Spec s, Message main) {
+        return new Spec(s.extended(), s.bigEndian(), s.semanticVersion(), s.description(), main, s.other());
+    }
+
+    static Spec bigEndian(Spec s) {
+        return new Spec(s.extended(), true, s.semanticVersion(), s.description(), s.main(), s.other());
+    }
+
+    static Group named(Group g, String name) {
+        return new Group(name, g.numInGroup(), g.since(), g.description(), g.members(), g.extraBlock());
+    }
+
+    /** The members with the field first (a field of version 0, so the order by sinceVersion holds). */
+    static Members withFirstField(Members m, Field f) {
+        List<Field> fields = new ArrayList<>(m.fields());
+        fields.add(0, f);
+        return new Members(fields, m.groups(), m.data());
+    }
+
+    static Spec withFirstField(Spec s, Field f) {
+        Message main = s.main();
+        return withMain(s, new Message(withFirstField(main.members(), f), main.extraBlock(), main.semanticType(), main.description()));
+    }
+
+    static Group withFirstField(Group g, Field f) {
+        return new Group(g.name(), g.numInGroup(), g.since(), g.description(), withFirstField(g.members(), f), g.extraBlock());
+    }
+
+    /** The spec with the field last among the main message's (its sinceVersion at least the others', so the order holds). */
+    static Spec withLastField(Spec s, Field f) {
+        Message main = s.main();
+        Members m = main.members();
+        List<Field> fields = new ArrayList<>(m.fields());
+        fields.add(f);
+        return withMain(s, new Message(new Members(fields, m.groups(), m.data()), main.extraBlock(), main.semanticType(), main.description()));
+    }
+
+    /** The spec with the group inserted among the main message's at {@code at} (modulo their count plus one). */
+    static Spec withGroup(Spec s, Group g, int at) {
+        Message main = s.main();
+        Members m = main.members();
+        List<Group> groups = new ArrayList<>(m.groups());
+        groups.add(Math.floorMod(at, groups.size() + 1), g);
+        return withMain(s, new Message(new Members(m.fields(), groups, m.data()), main.extraBlock(), main.semanticType(), main.description()));
+    }
+
+    /** The spec's main message reduced to its fields followed by {@code last} (given the sinceVersion of the field before it), without groups, var data or a blockLength attribute. */
+    static Spec fieldsOnly(Spec s, Field last) {
+        Message main = s.main();
+        List<Field> fields = new ArrayList<>(main.members().fields());
+        int since = fields.isEmpty() ? 0 : fields.get(fields.size() - 1).version().since();
+        fields.add(new Field(last.name(), last.type(), new Version(since, 0), last.presence(), last.pad(), last.description()));
+        return withMain(s, new Message(new Members(fields, List.of(), List.of()), -1, main.semanticType(), main.description()));
+    }
+
+    /** The valid range of the primitive with default null value: SBE's defaults (a uint64 as the signed longs of PrimitiveValue, 2^64 - 2 being -2). */
+    static long[] defaultRange(PrimitiveType pt) {
+        return switch (pt) {
+            case CHAR -> new long[] {0x20, 0x7e};
+            case INT8 -> new long[] {-127, 127};
+            case UINT8 -> new long[] {0, 254};
+            case INT16 -> new long[] {-32767, 32767};
+            case UINT16 -> new long[] {0, 65534};
+            case INT32 -> new long[] {Integer.MIN_VALUE + 1, Integer.MAX_VALUE};
+            case UINT32 -> new long[] {0, 0xFFFF_FFFEL};
+            case INT64 -> new long[] {Long.MIN_VALUE + 1, Long.MAX_VALUE};
+            case UINT64 -> new long[] {0, -2L};
+            default -> new long[] {0, 0};
+        };
+    }
+
+    /** The range custom bounds, null values and constants are drawn from: {@link #defaultRange}, a uint64's cut at Long.MAX_VALUE (they are written as decimal text). */
+    static long[] drawableRange(PrimitiveType pt) {
+        return pt == PrimitiveType.UINT64 ? new long[] {0, Long.MAX_VALUE} : defaultRange(pt);
+    }
+
+    /** The name with its first letter in lower case: how the Java generator relates a group's class to a type's. */
+    static String lowerFirst(String name) {
+        return Character.toLowerCase(name.charAt(0)) + name.substring(1);
+    }
+
+    static long defaultNull(PrimitiveType pt) {
+        return switch (pt) {
+            case CHAR -> 0;
+            case INT8 -> -128;
+            case UINT8 -> 255;
+            case INT16 -> -32768;
+            case UINT16 -> 65535;
+            case INT32 -> Integer.MIN_VALUE;
+            case UINT32 -> 0xFFFF_FFFFL;
+            case INT64 -> Long.MIN_VALUE;
+            case UINT64 -> -1L;
+            default -> 0;
+        };
+    }
+
+    // ------------------------------------------------------------------ the rendered schema and its layout
+
+    /** What the value generator needs to know about a declared type. */
+    sealed interface LType permits LEncoded, LEnum, LSet, LComposite {}
+
+    /** An encoded type: its value range, null value and character encoding; optional when its own presence says so. */
+    record LEncoded(PrimitiveType pt, int length, long lo, long hi, long nul, String charset, boolean optional) implements LType {}
+
+    record LEnum() implements LType {}
+
+    record LSet(int choices) implements LType {}
+
+    record LMember(String name, LType type, boolean constant) {}
+
+    record LComposite(List<LMember> members) implements LType {}
+
+    record LField(String name, LType type, boolean optional, boolean constant) {}
+
+    record LGroup(String name, LBody body) {}
+
+    /** Var data: its character encoding (null for raw bytes) and the longest value the encoder writes. */
+    record LData(String name, String charset, int maxLength) {}
+
+    /** The members of a message or group element, in order and by their rendered names. */
+    record LBody(List<LField> fields, List<LGroup> groups, List<LData> data) {}
+
+    /** The schema as text, its version, byte order and the layout of message 1. */
+    record Schema(String xml, int version, boolean bigEndian, LBody layout) {
+        @Override
+        public String toString() {
+            return "version " + version + (bigEndian ? " bigEndian" : "") + "\n" + xml;
+        }
+    }
+
+    static Schema render(Spec spec) {
+        return new Render(spec).render();
+    }
+
+    /** A declared type: its name, encoded size (0 for constants), composite nesting, layout and valid value names (enums). */
+    record Emitted(String name, int size, int nesting, LType layout, List<String> enumValues, boolean constant) {}
+
+    /** Writes the tree as XML, numbering types and members in order; a pure function of the tree. */
+    static final class Render {
+        final Spec s;
+        final StringBuilder types = new StringBuilder();
+        /** The variable types declared so far, for {@link Reuse}. */
+        final List<Emitted> emitted = new ArrayList<>();
+        final List<Emitted> enums = new ArrayList<>();
+        final Set<String> groupSizes = new LinkedHashSet<>();
+        /** The member names given so far: a group named like a type (bug sbe/6's shape) could take another member's. */
+        final Set<String> memberNames = new LinkedHashSet<>();
+        int nextType;
+        int nextMember;
+        int version;
+
+        Render(Spec s) {
+            this.s = s;
+        }
+
+        /** The name, made distinct from the members named so far. */
+        String memberName(String name) {
+            while (!memberNames.add(name)) {
+                name += "x";
+            }
+            return name;
+        }
+
+        Schema render() {
+            StringBuilder body = new StringBuilder();
+            LBody layout = message(body, "TestMessage", 1, s.main());
+            if (s.other() != null) {
+                message(body, "OtherMessage", 2, s.other());
+            }
+            StringBuilder xml = new StringBuilder();
+            xml.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
+            xml.append("<sbe:messageSchema xmlns:sbe=\"http://fixprotocol.io/2016/sbe\" package=\"").append(PACKAGE)
+                .append("\" id=\"42\" version=\"").append(version).append('"');
+            if (s.bigEndian()) {
+                xml.append(" byteOrder=\"bigEndian\"");
+            }
+            if (s.semanticVersion() != null) {
+                xml.append(" semanticVersion=\"").append(s.semanticVersion()).append('"');
+            }
+            if (s.description() != null) {
+                xml.append(" description=\"").append(s.description()).append('"');
+            }
+            xml.append(">\n  <types>\n");
+            xml.append("    <composite name=\"messageHeader\">\n");
+            xml.append("      <type name=\"blockLength\" primitiveType=\"uint16\"/>\n");
+            xml.append("      <type name=\"templateId\" primitiveType=\"uint16\"/>\n");
+            xml.append("      <type name=\"schemaId\" primitiveType=\"uint16\"/>\n");
+            xml.append("      <type name=\"version\" primitiveType=\"uint16\"/>\n");
+            xml.append("    </composite>\n");
+            xml.append("    <composite name=\"groupSizeEncoding\">\n");
+            xml.append("      <type name=\"blockLength\" primitiveType=\"uint16\"/>\n");
+            xml.append("      <type name=\"numInGroup\" primitiveType=\"uint16\"/>\n");
+            xml.append("    </composite>\n");
+            for (String gs : groupSizes) {
+                String numType = gs.substring("groupSize".length());
+                xml.append("    <composite name=\"").append(gs).append("\">\n");
+                xml.append("      <type name=\"blockLength\" primitiveType=\"uint16\"/>\n");
+                xml.append("      <type name=\"numInGroup\" primitiveType=\"").append(numType).append("\"/>\n");
+                xml.append("    </composite>\n");
+            }
+            xml.append(types);
+            xml.append("  </types>\n");
+            xml.append(body);
+            xml.append("</sbe:messageSchema>\n");
+            return new Schema(xml.toString(), version, s.bigEndian(), layout);
+        }
+
+        // ---- messages
+
+        /** The members rendered: the fields' extent, the layout, and the names of the set and composite types the fields use. */
+        record Rendered(int blockLength, LBody layout, List<String> classTypes) {}
+
+        LBody message(StringBuilder out, String name, int id, Message m) {
+            StringBuilder members = new StringBuilder();
+            Rendered r = members(members, "    ", m.members());
+            out.append("  <sbe:message name=\"").append(name).append("\" id=\"").append(id).append('"');
+            if (m.extraBlock() >= 0) {
+                out.append(" blockLength=\"").append(r.blockLength() + m.extraBlock()).append('"');
+            }
+            if (m.semanticType() != null) {
+                out.append(" semanticType=\"").append(m.semanticType()).append('"');
+            }
+            if (m.description() != null) {
+                out.append(" description=\"").append(m.description()).append('"');
+            }
+            out.append(">\n").append(members).append("  </sbe:message>\n");
+            return r.layout();
+        }
+
+        /** Fields, then groups, then data; the block length is the fields' extent. */
+        Rendered members(StringBuilder out, String indent, Members m) {
+            int offset = 0;
+            List<LField> fields = new ArrayList<>();
+            List<LGroup> groups = new ArrayList<>();
+            List<LData> data = new ArrayList<>();
+            List<String> classTypes = new ArrayList<>();
+            for (Field f : m.fields()) {
+                offset = field(out, indent, offset, f, fields, classTypes);
+            }
+            for (Group g : m.groups()) {
+                groups.add(group(out, indent, g));
+            }
+            int dataSince = 0;
+            for (Data d : m.data()) {
+                // var data added later come last, like fields
+                dataSince = Math.max(dataSince, d.since());
+                data.add(data(out, indent, d, dataSince));
+            }
+            return new Rendered(offset, new LBody(fields, groups, data), classTypes);
+        }
+
+        int field(StringBuilder out, String indent, int offset, Field f, List<LField> layout, List<String> classTypes) {
+            int id = nextMember++;
+            String name = memberName(f.name() + id);
+            Resolved r = resolve(f.type(), MAX_COMPOSITE_DEPTH);
+            Emitted type = r.type();
+            if (type.layout() instanceof LSet || type.layout() instanceof LComposite) {
+                classTypes.add(type.name());
+            }
+            boolean constant = type.constant() || r.valueRef() != null;
+            int since = f.version().since();
+            out.append(indent).append("<field name=\"").append(name).append("\" id=\"").append(id).append("\" type=\"").append(type.name()).append('"');
+            if (constant) {
+                out.append(" presence=\"constant\"");
+                if (r.valueRef() != null) {
+                    out.append(" valueRef=\"").append(r.valueRef()).append('"');
+                }
+            } else if (since > 0) {
+                out.append(" presence=\"optional\"");
+            } else if (f.presence() != Presence.DEFAULT) {
+                out.append(" presence=\"").append(f.presence().name().toLowerCase()).append('"');
+            }
+            if (!constant && f.pad() > 0) {
+                offset += f.pad();
+                out.append(" offset=\"").append(offset).append('"');
+            }
+            if (since > 0) {
+                version = Math.max(version, since);
+                out.append(" sinceVersion=\"").append(since).append('"');
+            }
+            if (f.version().deprecated() > 0) {
+                version = Math.max(version, f.version().deprecated());
+                out.append(" deprecated=\"").append(f.version().deprecated()).append('"');
+            }
+            if (f.description() != null) {
+                out.append(" description=\"").append(f.description()).append('"');
+            }
+            out.append("/>\n");
+            // the parser takes the field's presence, else the type's, else required
+            boolean optional = !constant && (since > 0 || f.presence() == Presence.OPTIONAL
+                || f.presence() == Presence.DEFAULT && type.layout() instanceof LEncoded e && e.optional());
+            layout.add(new LField(name, type.layout(), optional, constant));
+            return constant ? offset : offset + type.size();
+        }
+
+        LGroup group(StringBuilder out, String indent, Group g) {
+            int id = nextMember++;
+            StringBuilder members = new StringBuilder();
+            Rendered r = members(members, indent + "  ", g.members());
+            // a group drawn as "type" is named like the first set or composite type among its fields, up to the case
+            // of the first letter: the Java generator's nested class for the group then shadows that type's codec in
+            // the field's declaration (bug sbe/6); under HEGEL_NO_KNOWN such a group is a plain member
+            String name;
+            if (Zoo.NO_KNOWN && g.name().equals("type")) {
+                name = memberName("member" + id);
+            } else if (g.name().equals("type") && !r.classTypes().isEmpty()) {
+                name = memberName(lowerFirst(r.classTypes().get(0)));
+            } else {
+                name = memberName(g.name() + id);
+            }
+            out.append(indent).append("<group name=\"").append(name).append("\" id=\"").append(id).append('"');
+            if (g.numInGroup() != null) {
+                String gs = "groupSize" + g.numInGroup();
+                groupSizes.add(gs);
+                out.append(" dimensionType=\"").append(gs).append('"');
+            }
+            if (g.since() > 0) {
+                version = Math.max(version, g.since());
+                out.append(" sinceVersion=\"").append(g.since()).append('"');
+            }
+            if (g.description() != null) {
+                out.append(" description=\"").append(g.description()).append('"');
+            }
+            if (g.extraBlock() >= 0) {
+                out.append(" blockLength=\"").append(r.blockLength() + g.extraBlock()).append('"');
+            }
+            out.append(">\n").append(members).append(indent).append("</group>\n");
+            return new LGroup(name, r.layout());
+        }
+
+        LData data(StringBuilder out, String indent, Data d, int since) {
+            int id = nextMember++;
+            String name = memberName(d.name() + id);
+            String typeName = "Type" + nextType++;
+            types.append("    <composite name=\"").append(typeName).append("\">\n");
+            types.append("      <type name=\"length\" primitiveType=\"").append(d.lengthType()).append('"');
+            if (d.maxValue() != null) {
+                types.append(" maxValue=\"").append(d.maxValue()).append('"');
+            }
+            types.append("/>\n");
+            types.append("      <type name=\"varData\" primitiveType=\"uint8\" length=\"0\"");
+            if (!d.charset().isEmpty()) {
+                types.append(" characterEncoding=\"").append(d.charset()).append('"');
+            }
+            types.append("/>\n    </composite>\n");
+            out.append(indent).append("<data name=\"").append(name).append("\" id=\"").append(id).append("\" type=\"").append(typeName).append('"');
+            if (since > 0) {
+                version = Math.max(version, since);
+                out.append(" sinceVersion=\"").append(since).append('"');
+            }
+            out.append("/>\n");
+            long max = d.maxValue() != null ? d.maxValue() : d.lengthType().equals("uint8") ? 254 : d.lengthType().equals("uint16") ? 65534 : 0xFFFF_FFFEL;
+            return new LData(name, d.charset().isEmpty() ? null : d.charset(), (int) Math.min(max, 260L));
+        }
+
+        // ---- types
+
+        /** A field's or member's type as declared, with the valueRef of a constant enum field. */
+        record Resolved(Emitted type, String valueRef) {}
+
+        static final Encoded PLAIN_INT32 = new Encoded(PrimitiveType.INT32, 1, Presence.DEFAULT, Custom.NONE, null, null, null, null);
+
+        /** Declares the type (or finds the one reused) at the nesting level: a level-l type nests at most l - 1 composites. */
+        Resolved resolve(TypeSpec t, int level) {
+            switch (t) {
+                case Encoded e -> {
+                    return new Resolved(encoded(e), null);
+                }
+                case EnumSpec e -> {
+                    return new Resolved(enumType(e), null);
+                }
+                case SetSpec e -> {
+                    return new Resolved(setType(e), null);
+                }
+                case CompositeSpec c -> {
+                    return new Resolved(composite(c, level - 1), null);
+                }
+                case Reuse r -> {
+                    // (a level-l type nests at most l - 1 composites: the level the Reuse was drawn at, which is
+                    // below the field level for the plain field the versioned schema adds)
+                    int maxNesting = Math.min(level, r.level()) - 1;
+                    List<Emitted> fit = new ArrayList<>();
+                    for (Emitted e : emitted) {
+                        if (e.nesting() <= maxNesting) {
+                            fit.add(e);
+                        }
+                    }
+                    return new Resolved(fit.isEmpty() ? encoded(PLAIN_INT32) : at(fit, r.index()), null);
+                }
+                case ConstEnum ce -> {
+                    if (enums.isEmpty()) {
+                        return new Resolved(encoded(ce.fallback()), null);
+                    }
+                    Emitted e = at(enums, ce.index());
+                    return new Resolved(e, e.name() + "." + at(e.enumValues(), ce.value()));
+                }
+            }
+        }
+
+        Emitted encoded(Encoded e) {
+            String name = "Type" + nextType++;
+            PrimitiveType pt = e.pt();
+            long[] r = defaultRange(pt);
+            Custom c = e.custom();
+            StringBuilder t = new StringBuilder();
+            t.append("    <type name=\"").append(name).append("\" primitiveType=\"").append(pt.primitiveName()).append('"');
+            if (e.length() > 1) {
+                t.append(" length=\"").append(e.length()).append('"');
+            }
+            if (e.isConstant()) {
+                t.append(" presence=\"constant\"");
+            } else if (c.nul() != null) {
+                // a null value only with presence="optional"
+                t.append(" presence=\"optional\"");
+            } else if (e.presence() != Presence.DEFAULT) {
+                t.append(" presence=\"").append(e.presence().name().toLowerCase()).append('"');
+            }
+            if (c.lo() != null) {
+                t.append(" minValue=\"").append(xmlValue(pt, c.lo())).append("\" maxValue=\"").append(xmlValue(pt, c.hi())).append('"');
+            }
+            if (c.nul() != null) {
+                t.append(" nullValue=\"").append(xmlValue(pt, c.nul())).append('"');
+            }
+            if (e.charset() != null) {
+                t.append(" characterEncoding=\"").append(e.charset()).append('"');
+            }
+            if (e.semanticType() != null) {
+                t.append(" semanticType=\"").append(e.semanticType()).append('"');
+            }
+            if (e.description() != null) {
+                t.append(" description=\"").append(e.description()).append('"');
+            }
+            if (e.isConstant()) {
+                t.append('>').append(e.constant()).append("</type>\n");
+            } else {
+                t.append("/>\n");
+            }
+            types.append(t);
+            boolean optional = !e.isConstant() && (c.nul() != null || e.presence() == Presence.OPTIONAL);
+            LEncoded layout = new LEncoded(pt, e.length(), c.lo() != null ? c.lo() : r[0], c.hi() != null ? c.hi() : r[1],
+                c.nul() != null ? c.nul() : defaultNull(pt), e.charset(), optional);
+            Emitted em = new Emitted(name, e.isConstant() ? 0 : pt.size() * e.length(), 0, layout, null, e.isConstant());
+            if (!e.isConstant()) {
+                emitted.add(em);
+            }
+            return em;
+        }
+
+        Emitted enumType(EnumSpec e) {
+            String name = "Type" + nextType++;
+            PrimitiveType pt = PrimitiveType.get(e.encodingType());
+            types.append("    <enum name=\"").append(name).append("\" encodingType=\"").append(e.encodingType()).append('"');
+            if (e.explicitNull()) {
+                // an explicit null value not among the valid values
+                types.append(" nullValue=\"").append(defaultNull(pt)).append('"');
+            }
+            types.append(">\n");
+            List<String> names = new ArrayList<>();
+            for (Map.Entry<Long, EnumValue> en : e.values().entrySet()) {
+                String caseName = "Case" + names.size();
+                names.add(caseName);
+                types.append("      <validValue name=\"").append(caseName).append('"');
+                if (en.getValue().since() > 0) {
+                    version = Math.max(version, en.getValue().since());
+                    types.append(" sinceVersion=\"").append(en.getValue().since()).append('"');
+                }
+                if (en.getValue().description() != null) {
+                    types.append(" description=\"").append(en.getValue().description()).append('"');
+                }
+                types.append('>').append(pt == PrimitiveType.CHAR ? String.valueOf((char) en.getKey().longValue()) : Long.toString(en.getKey())).append("</validValue>\n");
+            }
+            types.append("    </enum>\n");
+            Emitted em = new Emitted(name, pt.size(), 0, new LEnum(), names, false);
+            emitted.add(em);
+            enums.add(em);
+            return em;
+        }
+
+        Emitted setType(SetSpec e) {
+            String name = "Type" + nextType++;
+            types.append("    <set name=\"").append(name).append("\" encodingType=\"uint").append(e.bits()).append("\">\n");
+            for (Map.Entry<Integer, Integer> c : e.choices().entrySet()) {
+                types.append("      <choice name=\"option").append(c.getKey()).append('"');
+                if (c.getValue() > 0) {
+                    version = Math.max(version, c.getValue());
+                    types.append(" sinceVersion=\"").append(c.getValue()).append('"');
+                }
+                types.append('>').append(c.getKey()).append("</choice>\n");
+            }
+            types.append("    </set>\n");
+            Emitted em = new Emitted(name, e.bits() / 8, 0, new LSet(e.choices().size()), null, false);
+            emitted.add(em);
+            return em;
+        }
+
+        /** A composite named before its members are declared (as the old generator numbered them), written after them. */
+        Emitted composite(CompositeSpec c, int memberLevel) {
+            String name = "Type" + nextType++;
+            List<Member> members = new ArrayList<>(c.members());
+            if (c.dup() != null) {
+                members.add(Math.floorMod(c.dup().at(), members.size() + 1), at(members, c.dup().of()));
+            }
+            if (c.insert() != null) {
+                members.add(Math.floorMod(c.insert().at(), members.size() + 1), new Member(c.insert().constant(), 0, 0));
+            }
+            StringBuilder cb = new StringBuilder();
+            cb.append("    <composite name=\"").append(name).append('"');
+            if (c.description() != null) {
+                cb.append(" description=\"").append(c.description()).append('"');
+            }
+            cb.append(">\n");
+            int offset = 0;
+            int nesting = 0;
+            List<LMember> layout = new ArrayList<>();
+            for (Member m : members) {
+                Emitted e = resolve(m.type(), memberLevel).type();
+                String memberName = "member" + layout.size() + "Of" + e.name();
+                cb.append("      <ref name=\"").append(memberName).append("\" type=\"").append(e.name()).append('"');
+                if (!e.constant() && m.pad() > 0) {
+                    offset += m.pad();
+                    cb.append(" offset=\"").append(offset).append('"');
+                }
+                if (m.since() > 0) {
+                    version = Math.max(version, m.since());
+                    cb.append(" sinceVersion=\"").append(m.since()).append('"');
+                }
+                cb.append("/>\n");
+                offset += e.size();
+                nesting = Math.max(nesting, 1 + e.nesting());
+                layout.add(new LMember(memberName, e.layout(), e.constant()));
+            }
+            cb.append("    </composite>\n");
+            types.append(cb);
+            Emitted em = new Emitted(name, offset, nesting, new LComposite(layout), null, false);
+            emitted.add(em);
+            return em;
+        }
+
+        /** A value as an XML attribute: the character itself for char, escaped. */
+        static String xmlValue(PrimitiveType pt, long v) {
+            String s = pt == PrimitiveType.CHAR ? String.valueOf((char) v) : Long.toString(v);
+            return s.replace("&", "&amp;").replace("<", "&lt;").replace("\"", "&quot;");
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..23ac696
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,117 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once. {@link #NO_KNOWN}
+ * ({@code HEGEL_NO_KNOWN=1}) switches the recorded bugs' shapes off for a run that looks past them.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    /** Off by default: the properties draw the recorded bugs' shapes and fail on them (they are the expected failures). */
+    static final boolean NO_KNOWN = notEmpty(System.getenv("HEGEL_NO_KNOWN"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
