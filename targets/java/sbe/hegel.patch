+        check(parsed.similar(msg.expected), () -> "JsonPrinter output differs from the encoded values:\n" + jsonDifference(msg.expected, parsed) + "\nprinted:\n" + text + "\nexpected:\n" + msg.expected.toString(2) + "\n" + msg.xml);
+        // the ByteBuffer entry points print the same text
+        String viaByteBuffer = printer.print(ByteBuffer.wrap(paddedBytes(msg)));
+        check(viaByteBuffer.equals(text), () -> "JsonPrinter.print(ByteBuffer) differs from print(StringBuilder, DirectBuffer, int):\n" + firstDifference(text, viaByteBuffer));
+        StringBuilder out2 = new StringBuilder();
+        printer.print(ByteBuffer.wrap(paddedBytes(msg)), out2);
+        check(out2.toString().equals(text), () -> "JsonPrinter.print(ByteBuffer, StringBuilder) differs:\n" + firstDifference(text, out2.toString()));
