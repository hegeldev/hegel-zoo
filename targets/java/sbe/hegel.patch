+            // IR binary round trip
+            ByteBuffer bytes = ByteBuffer.allocate(8 << 20);
+            int length;
+            try (IrEncoder enc = new IrEncoder(bytes, ir)) {
+                length = enc.encode();
+            }
+            check(length == bytes.position(), () -> "IrEncoder returned " + length + " but wrote " + bytes.position() + " bytes");
+            bytes.flip();
+            Ir back;
+            try (IrDecoder dec = new IrDecoder(bytes)) {
+                back = dec.decode();
+            }
+            check(back.id() == ir.id() && back.version() == ir.version(), () -> "decoded IR id/version " + back.id() + "/" + back.version() + " for " + ir.id() + "/" + ir.version());
