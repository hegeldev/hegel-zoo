+            check(back.id() == ir.id() && back.version() == ir.version(), () -> "decoded IR id/version " + back.id() + "/" + back.version() + " for " + ir.id() + "/" + ir.version());
+            check(ir.packageName().equals(back.packageName()), () -> "decoded IR package " + back.packageName() + " for " + ir.packageName());
+            check(ir.byteOrder().equals(back.byteOrder()), () -> "decoded IR byte order " + back.byteOrder() + " for " + ir.byteOrder());
+            check(String.valueOf(ir.semanticVersion()).equals(String.valueOf(back.semanticVersion())), () -> "decoded IR semantic version " + back.semanticVersion() + " for " + ir.semanticVersion());
+            check(tokensText(ir.headerStructure().tokens()).equals(tokensText(back.headerStructure().tokens())), () -> "decoded IR header differs:\n" + tokensText(ir.headerStructure().tokens()) + "\n---\n" + tokensText(back.headerStructure().tokens()));
+            List<Token> before = ir.getMessage(1);
+            List<Token> after = back.getMessage(1);
+            check(after != null, () -> "decoded IR has no message 1");
+            if (after != null) {
+                String a = tokensText(before);
+                String b = tokensText(after);
+                check(a.equals(b), () -> "decoded IR message tokens differ:\n" + firstDifference(a, b) + "\n" + xml);
+            }
+            // the generated Java code from the decoded IR is the original's
+            Map<String, CharSequence> fromOriginal = javaSources(ir, false, false, false, false);
+            Map<String, CharSequence> fromDecoded = javaSources(back, false, false, false, false);
+            check(fromOriginal.keySet().equals(fromDecoded.keySet()), () -> "generated classes differ after the IR round trip: " + fromOriginal.keySet() + " vs " + fromDecoded.keySet());
+            for (Map.Entry<String, CharSequence> e : fromOriginal.entrySet()) {
+                CharSequence other = fromDecoded.get(e.getKey());
+                // (package-info carries the schema description, which the IR frame has no field for)
+                if (other != null && !e.getKey().endsWith("package-info")) {
+                    String a = e.getValue().toString();
+                    String b = other.toString();
+                    check(a.equals(b), () -> "generated " + e.getKey() + " differs after the IR round trip:\n" + firstDifference(a, b));
+                }
+            }
+        }), Zoo.settings("sbe.schemasParseAndIrRoundTrips"));
+    }
