+    /** The printer's oracle: the JSON of the message (encoded trusting the IR, in a buffer of exactly its length) is the model's, from every entry point. */
+    static void printerShows(MsgCase c) {
+        SbeGen.Msg msg = encode(c, false, true);
+        JsonPrinter printer = new JsonPrinter(msg.ir);
+        StringBuilder out = new StringBuilder();
+        try {
+            printer.print(out, padded(msg), 0);
+        } catch (RuntimeException e) {
+            fail("JsonPrinter threw on the message: " + e + "\n" + msg.xml + "\nexpected values: " + msg.expected);
+            return;
+        }
+        String text = out.toString();
+        JSONObject parsed;
+        try {
+            parsed = new JSONObject(text);
+        } catch (JSONException e) {
+            fail("JsonPrinter output is not JSON: " + e.getMessage() + "\n" + text + "\n" + msg.xml);
+            return;
