@@ -0,0 +1,103 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for Simple Binary Encoding (sbe-tool), added by the Hegel zoo (targets/java/sbe).
+     Upstream builds with Gradle, so this module compiles sbe-tool's own sources (../sbe-tool/src/main/java) as its
+     main sources; nothing is installed. The oracles are an independent message encoder written from the IR,
+     the JSON printer (on-the-fly decoding), the generated codecs compiled in memory (Java) or with g++ (C++),
+     all compared with one another; upstream's C++ round-trip driver is taken from its propertyTest resources. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>sbe-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <!-- the versions of gradle/libs.versions.toml at the pinned commit -->
+    <agrona.version>2.6.0</agrona.version>
+    <json.version>20260814</json.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.agrona</groupId>
+      <artifactId>agrona</artifactId>
+      <version>${agrona.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>org.json</groupId>
+      <artifactId>json</artifactId>
+      <version>${json.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <sourceDirectory>${project.basedir}/../sbe-tool/src/main/java</sourceDirectory>
+    <resources>
+      <resource>
+        <directory>${project.basedir}/../sbe-tool/src/main/resources</directory>
+      </resource>
+    </resources>
+    <testResources>
+      <testResource>
+        <directory>${project.basedir}/src/test/resources</directory>
+      </testResource>
+      <!-- upstream's C++ round-trip driver (CppDtosPropertyTest/main.cpp) -->
+      <testResource>
+        <directory>${project.basedir}/../sbe-tool/src/propertyTest/resources</directory>
+        <excludes>
+          <exclude>junit-platform.properties</exclude>
+        </excludes>
+      </testResource>
+    </testResources>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+        <configuration>
+          <showWarnings>false</showWarnings>
+          <compilerArgs>
+            <arg>-Xlint:none</arg>
+          </compilerArgs>
+        </configuration>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--add-opens java.base/jdk.internal.misc=ALL-UNNAMED --enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g -Xss4m</argLine>
+          <!-- the generated codecs are compiled in memory with javac reading java.class.path -->
+          <useManifestOnlyJar>false</useManifestOnlyJar>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..73a52db
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,126 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The combinators the binding lacks: weighted choice, a biased coin, an optional with a probability, int and long
+ * ranges, bounded lists, words over an alphabet, a tuple of any arity, and positions taken modulo a live size.
+ */
+final class Gen {
+    private Gen() {}
+
+    /** A weighted alternative for {@link #weighted}; the generator may produce a subtype of the choice's type. */
+    record Choice<T>(int weight, Generator<? extends T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<? extends T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** A constant alternative. */
+    static <T> Choice<T> v(int weight, T value) {
+        return new Choice<>(weight, just(value));
+    }
+
+    /** All the generators, in order, as one list (a tuple of any arity). */
+    static <T> Generator<List<T>> all(List<Generator<T>> gens) {
+        Generator<List<T>> acc = just(List.of());
+        for (Generator<T> g : gens) {
+            acc = tuples(acc, g).map(t -> {
+                List<T> out = new ArrayList<>(t.value1());
+                out.add(t.value2());
+                return out;
+            });
+        }
+        return acc;
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    static <T> Generator<T> weighted(List<Choice<T>> cs) {
+        int total = 0;
+        for (Choice<T> c : cs) {
+            total += c.weight();
+        }
+        return ints(0, total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : cs) {
+                acc += c.weight();
+                if (i < acc) {
+                    return widen(c.gen());
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** A generator of a subtype is a generator of the supertype: it only ever produces values. */
+    @SuppressWarnings("unchecked")
+    static <T> Generator<T> widen(Generator<? extends T> g) {
+        return (Generator<T>) g;
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return ints(0, 99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<? extends T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** One of the values, equally likely; shrinks to the first. */
+    @SafeVarargs
+    static <T> Generator<T> pick(T... xs) {
+        return sampledFrom(xs);
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A long in [lo, hi]; shrinks to lo. */
+    static Generator<Long> longs(long lo, long hi) {
+        return dev.hegel.Generators.longs().min(lo).max(hi);
+    }
+
+    /** A position, taken modulo the live size where it is used. */
+    static final Generator<Integer> INDEX = ints(0, 999);
+
+    /** lo..hi values of the generator. */
+    static <T> Generator<List<T>> many(Generator<T> g, int lo, int hi) {
+        return lists(g).minSize(lo).maxSize(hi);
+    }
+
+    /** One UTF-16 unit of the alphabet, as a string. */
+    static Generator<String> chars(String alphabet) {
+        List<String> cs = new ArrayList<>();
+        for (int i = 0; i < alphabet.length(); i++) {
+            cs.add(String.valueOf(alphabet.charAt(i)));
+        }
+        return sampledFrom(cs);
+    }
+
+    /** A string of lo..hi units drawn from the alphabet; shrinks to lo units of the first. */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        return many(chars(alphabet), lo, hi).map(parts -> String.join("", parts));
+    }
+
+    /** The element of the list at a drawn position, modulo its size (the list must not be empty). */
+    static <T> T at(List<T> xs, int index) {
+        return xs.get(Math.floorMod(index, xs.size()));
+    }
+}
diff --git a/hegel/src/test/java/zoo/SbeGen.java b/hegel/src/test/java/zoo/SbeGen.java
new file mode 100644
index 0000000..756f25b
--- /dev/null
+++ b/hegel/src/test/java/zoo/SbeGen.java
@@ -0,0 +1,818 @@
+package zoo;
+
+import static dev.hegel.Generators.doubles;
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static uk.co.real_logic.sbe.ir.Signal.BEGIN_FIELD;
+import static uk.co.real_logic.sbe.ir.Signal.BEGIN_GROUP;
+import static uk.co.real_logic.sbe.ir.Signal.BEGIN_MESSAGE;
+import static uk.co.real_logic.sbe.ir.Signal.BEGIN_VAR_DATA;
+import static uk.co.real_logic.sbe.ir.Signal.CHOICE;
+import static uk.co.real_logic.sbe.ir.Signal.VALID_VALUE;
+import static zoo.Gen.INDEX;
+import static zoo.Gen.at;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.longs;
+import static zoo.Gen.many;
+import static zoo.Gen.pick;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+
+import dev.hegel.Generator;
+import dev.hegel.Tuple2;
+import java.io.ByteArrayInputStream;
+import java.io.InputStream;
+import java.math.BigInteger;
+import java.nio.ByteOrder;
+import java.nio.charset.Charset;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import org.agrona.ExpandableArrayBuffer;
+import org.agrona.PrintBufferUtil;
+import org.agrona.collections.MutableInteger;
+import org.agrona.concurrent.UnsafeBuffer;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import uk.co.real_logic.sbe.PrimitiveType;
+import uk.co.real_logic.sbe.PrimitiveValue;
+import uk.co.real_logic.sbe.ir.Encoding;
+import uk.co.real_logic.sbe.ir.Ir;
+import uk.co.real_logic.sbe.ir.Token;
+import uk.co.real_logic.sbe.xml.IrGenerator;
+import uk.co.real_logic.sbe.xml.ParserOptions;
+import uk.co.real_logic.sbe.xml.XmlSchemaParser;
+import zoo.SchemaGen.LBody;
+import zoo.SchemaGen.LComposite;
+import zoo.SchemaGen.LData;
+import zoo.SchemaGen.LEncoded;
+import zoo.SchemaGen.LEnum;
+import zoo.SchemaGen.LField;
+import zoo.SchemaGen.LGroup;
+import zoo.SchemaGen.LMember;
+import zoo.SchemaGen.LSet;
+import zoo.SchemaGen.LType;
+
+/**
+ * An independent SBE message encoder (a Hegel port of the encoder in upstream's jqwik {@code SbeArbitraries}). The
+ * values of a message are drawn as a tree of records matched to the schema's {@link LBody layout} ({@link #values}:
+ * a value per field by name, a list of element bodies per group, a text or byte list per var data), and
+ * {@link #encode} is a pure function of the IR and that tree: it walks the message tokens, writes each value into a
+ * buffer and records, as it goes, the JSON the on-the-fly JsonPrinter must produce. Values that the acting version
+ * or the type's valid values do not admit are taken modulo what is live (an enum index modulo the valid values,
+ * a choice only when present), so the same tree encodes against an older version of the schema.
+ *
+ * <p>The model records what a correct printer shows, so the recorded bugs' shapes make the properties fail: a uint64
+ * is its unsigned value (bug sbe/1), and for the printer's properties a bit set is written in the byte order of its
+ * IR token, as an encoder trusting the IR writes it (bug sbe/2). Under {@code HEGEL_NO_KNOWN} ({@link Zoo#NO_KNOWN})
+ * the model expects the printer's signed rendering and writes every set in the schema's byte order.
+ */
+final class SbeGen {
+    private SbeGen() {}
+
+    static final String PACKAGE = SchemaGen.PACKAGE;
+
+    static uk.co.real_logic.sbe.xml.MessageSchema parse(String xml, boolean strict) throws Exception {
+        java.io.ByteArrayOutputStream errors = new java.io.ByteArrayOutputStream();
+        ParserOptions options = strict
+            ? ParserOptions.builder().suppressOutput(false).warningsFatal(true).stopOnError(true)
+                .errorPrintStream(new java.io.PrintStream(errors, true, StandardCharsets.UTF_8)).build()
+            : ParserOptions.builder().suppressOutput(false).warningsFatal(false).stopOnError(false)
+                .errorPrintStream(new java.io.PrintStream(errors, true, StandardCharsets.UTF_8)).build();
+        try (InputStream in = new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8))) {
+            return XmlSchemaParser.parse(in, options);
+        } catch (IllegalStateException e) {
+            throw new IllegalStateException(e.getMessage() + ": " + errors.toString(StandardCharsets.UTF_8).trim().replace('\n', ' '), e);
+        }
+    }
+
+    static Ir ir(String xml) throws Exception {
+        return new IrGenerator().generate(parse(xml, true));
+    }
+
+    // ------------------------------------------------------------------ the drawn values
+
+    sealed interface Value permits Int, Flt, Dbl, Arr, EnumV, SetV, CompositeV {}
+
+    /** An integral or char value; nul: written as the null value where the field is optional. */
+    record Int(boolean nul, long v) implements Value {}
+
+    record Flt(boolean nul, float v) implements Value {}
+
+    record Dbl(boolean nul, double v) implements Value {}
+
+    /** The elements of an array type, as many as its length. */
+    record Arr(List<Value> items) implements Value {}
+
+    /** An enum: the null value (where optional), else the valid value at index modulo the ones the acting version admits. */
+    record EnumV(boolean nul, int index) implements Value {}
+
+    /** A bit set: a flag per choice, in declaration order. */
+    record SetV(List<Boolean> on) implements Value {}
+
+    /** A composite: a value per variable member, by name. */
+    record CompositeV(Map<String, Value> members) implements Value {}
+
+    /** Var data: text for a character encoding (already within the length limit), else raw bytes. */
+    record DataV(String text, List<Integer> raw) {}
+
+    /** The values of a message or group element: fields by name, group elements by group name, var data by name. */
+    record Body(Map<String, Value> fields, Map<String, List<Body>> groups, Map<String, DataV> data) {}
+
+    // ------------------------------------------------------------------ their generators
+
+    private static final long[] SPECIALS = {0L, 1L, -1L, 127L, 128L, 255L, 256L, 32767L, 65535L, Integer.MAX_VALUE, Integer.MIN_VALUE, Long.MAX_VALUE, Long.MIN_VALUE};
+
+    /** A long in [lo, hi]: any (70%), or a bound or a notable value inside the range (30%). */
+    static Generator<Long> longIn(long lo, long hi) {
+        List<Long> specials = new ArrayList<>(List.of(lo, hi));
+        for (long v : SPECIALS) {
+            if (v >= lo && v <= hi) {
+                specials.add(v);
+            }
+        }
+        return weighted(w(7, longs(lo, hi)), w(3, sampledFrom(specials)));
+    }
+
+    /** A uint64 in [lo, hi], both as the signed longs of PrimitiveValue (negative = above Long.MAX_VALUE). */
+    static Generator<Long> uint64In(long lo, long hi) {
+        if ((lo >= 0) == (hi >= 0)) {
+            return longIn(lo, hi);
+        }
+        return weighted(w(1, longIn(lo, Long.MAX_VALUE)), w(1, longIn(Long.MIN_VALUE, hi)));
+    }
+
+    /** A float: a notable value (25%), any bit pattern (22%), a double narrowed (53%). */
+    static final Generator<Float> FLOAT = weighted(
+        w(25, pick(0f, -0f, 1f, -1f, Float.MIN_VALUE, Float.MAX_VALUE, Float.MIN_NORMAL, 0.1f, 1e10f, 3.4028235e38f, Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY)),
+        w(22, integers().map(Float::intBitsToFloat)),
+        w(53, doubles().map(Double::floatValue)));
+
+    static final Generator<Double> DOUBLE = weighted(
+        w(25, pick(0d, -0d, 1d, -1d, Double.MIN_VALUE, Double.MAX_VALUE, Double.MIN_NORMAL, 0.1, 1e300, 1e-300, Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY)),
+        w(22, dev.hegel.Generators.longs().map(Double::longBitsToDouble)),
+        w(53, doubles()));
+
+    /** A code point for UTF-8 var data: ASCII (50%), two bytes (25%), three (17%), four (8%). */
+    static final Generator<Integer> CODE_POINT = weighted(w(50, ints(0x20, 0x7e)), w(25, ints(0x80, 0x7ff)), w(17, ints(0x800, 0xd7ff)), w(8, ints(0x10000, 0x10ffff)));
+
+    /** The null coin of an optional field: null one time in five; never for a required one. */
+    static Generator<Boolean> nul(boolean optional) {
+        return optional ? chance(20) : just(false);
+    }
+
+    /** One value of an encoded type; the range is the type's, US-ASCII chars stop at 0x7f. */
+    static Generator<Value> scalar(LEncoded e, boolean optional) {
+        Generator<Boolean> nul = nul(optional);
+        switch (e.pt()) {
+            case CHAR -> {
+                long hi = "US-ASCII".equals(e.charset()) ? Math.min(e.hi(), 0x7f) : e.hi();
+                return tuples(nul, ints((int) e.lo(), (int) hi)).map(t -> new Int(t.value1(), t.value2()));
+            }
+            case FLOAT -> {
+                return tuples(nul, FLOAT).map(t -> new Flt(t.value1(), t.value2()));
+            }
+            case DOUBLE -> {
+                return tuples(nul, DOUBLE).map(t -> new Dbl(t.value1(), t.value2()));
+            }
+            case UINT64 -> {
+                // a value equal to the null value would read back as null
+                return tuples(nul, uint64In(e.lo(), e.hi()).map(v -> v == e.nul() ? e.lo() : v)).map(t -> new Int(t.value1(), t.value2()));
+            }
+            default -> {
+                return tuples(nul, longIn(e.lo(), e.hi())).map(t -> new Int(t.value1(), t.value2()));
+            }
+        }
+    }
+
+    /** A value of a declared type: an array of scalars, an enum index, a flag per choice, or a composite's members. */
+    static Generator<Value> value(LType t, boolean optional) {
+        switch (t) {
+            case LEncoded e -> {
+                Generator<Value> one = scalar(e, optional);
+                return e.length() == 1 ? one : many(one, e.length(), e.length()).<Value>map(Arr::new);
+            }
+            case LEnum x -> {
+                return tuples(nul(optional), INDEX).<Value>map(p -> new EnumV(p.value1(), p.value2()));
+            }
+            case LSet s -> {
+                return many(chance(50), s.choices(), s.choices()).<Value>map(SetV::new);
+            }
+            case LComposite c -> {
+                List<Generator<Tuple2<String, Value>>> members = new ArrayList<>();
+                for (LMember m : c.members()) {
+                    if (!m.constant()) {
+                        // a composite member is optional when its own type is
+                        members.add(tuples(just(m.name()), value(m.type(), m.type() instanceof LEncoded le && le.optional())));
+                    }
+                }
+                return Gen.all(members).<Value>map(xs -> new CompositeV(toMap(xs)));
+            }
+        }
+    }
+
+    /** Group elements: none or one (40%), or up to six. */
+    static Generator<List<Body>> elements(Generator<Body> element) {
+        return weighted(w(4, many(element, 0, 1)), w(6, many(element, 0, 6)));
+    }
+
+    /** Up to two items (30%) or up to max. */
+    static <T> Generator<List<T>> shortOrLong(Generator<T> item, int max) {
+        return weighted(w(3, many(item, 0, Math.min(2, max))), w(7, many(item, 0, max)));
+    }
+
+    /** Var data: UTF-8 text cut to the length limit, US-ASCII characters (0..0x7f), or raw bytes. */
+    static Generator<DataV> data(LData d) {
+        int max = d.maxLength();
+        if ("UTF-8".equalsIgnoreCase(d.charset())) {
+            return shortOrLong(CODE_POINT, max).map(cps -> new DataV(fitUtf8(cps, max), null));
+        }
+        if (d.charset() != null) {
+            return shortOrLong(ints(0, 0x7f), max).map(cs -> {
+                StringBuilder sb = new StringBuilder();
+                for (int c : cs) {
+                    sb.append((char) c);
+                }
+                return new DataV(sb.toString(), null);
+            });
+        }
+        return shortOrLong(ints(-128, 127), max).map(bs -> new DataV(null, bs));
+    }
+
+    /** The code points, up to the first that would take the UTF-8 length past max. */
+    static String fitUtf8(List<Integer> cps, int max) {
+        StringBuilder sb = new StringBuilder();
+        int bytes = 0;
+        for (int cp : cps) {
+            int n = cp < 0x80 ? 1 : cp < 0x800 ? 2 : cp < 0x10000 ? 3 : 4;
+            if (bytes + n > max) {
+                break;
+            }
+            sb.appendCodePoint(cp);
+            bytes += n;
+        }
+        return sb.toString();
+    }
+
+    /** The values of a message or group element with this layout. */
+    static Generator<Body> values(LBody b) {
+        List<Generator<Tuple2<String, Value>>> fields = new ArrayList<>();
+        for (LField f : b.fields()) {
+            if (!f.constant()) {
+                fields.add(tuples(just(f.name()), value(f.type(), f.optional())));
+            }
+        }
+        List<Generator<Tuple2<String, List<Body>>>> groups = new ArrayList<>();
+        for (LGroup g : b.groups()) {
+            groups.add(tuples(just(g.name()), elements(values(g.body()))));
+        }
+        List<Generator<Tuple2<String, DataV>>> data = new ArrayList<>();
+        for (LData d : b.data()) {
+            data.add(tuples(just(d.name()), data(d)));
+        }
+        return tuples(Gen.all(fields), Gen.all(groups), Gen.all(data)).map(t -> new Body(toMap(t.value1()), toMap(t.value2()), toMap(t.value3())));
+    }
+
+    static <V> Map<String, V> toMap(List<Tuple2<String, V>> pairs) {
+        Map<String, V> out = new LinkedHashMap<>();
+        for (Tuple2<String, V> p : pairs) {
+            out.put(p.value1(), p.value2());
+        }
+        return out;
+    }
+
+    // ------------------------------------------------------------------ messages
+
+    /** An encoded message with the JSON the printer must produce for it. */
+    static final class Msg {
+        final String xml;
+        final Ir ir;
+        final UnsafeBuffer buffer;
+        final int length;
+        final JSONObject expected;
+
+        Msg(String xml, Ir ir, byte[] bytes, JSONObject expected) {
+            this.xml = xml;
+            this.ir = ir;
+            this.buffer = new UnsafeBuffer(bytes);
+            this.length = bytes.length;
+            this.expected = expected;
+        }
+
+        byte[] bytes() {
+            byte[] out = new byte[length];
+            buffer.getBytes(0, out);
+            return out;
+        }
+
+        int headerBlockLength() {
+            return buffer.getShort(0, ir.byteOrder()) & 0xFFFF;
+        }
+
+        int headerVersion() {
+            return buffer.getShort(6, ir.byteOrder()) & 0xFFFF;
+        }
+    }
+
+    /**
+     * The message of template templateId at the IR's version, holding the drawn values. nullTerminates is upstream's
+     * firstNullTerminatesCharArray: after a 0 in a char array the rest is 0 (DTOs use Strings).
+     */
+    static Msg encode(String xml, Ir ir, int templateId, Body values, boolean nullTerminates) {
+        return encode(xml, ir, templateId, values, nullTerminates, false);
+    }
+
+    /**
+     * As {@link #encode(String, Ir, int, Body, boolean)}; with irSets the sets are written in the byte order of their
+     * BEGIN_SET token, as an encoder trusting the IR writes them, which in a big-endian schema is the wrong one (bug
+     * sbe/2: the printer reads with the CHOICE tokens, which carry the schema's). The generated codecs use the
+     * schema's order, so their round trips encode without it. Under HEGEL_NO_KNOWN every set is written in the
+     * schema's byte order.
+     */
+    static Msg encode(String xml, Ir ir, int templateId, Body values, boolean nullTerminates, boolean irSets) {
+        return new Encoder(ir, nullTerminates, irSets && !Zoo.NO_KNOWN).encode(xml, templateId, values);
+    }
+
+    /** The JSON the printer shows for a member or field that is absent at the acting version. */
+    static Object notPresent(List<Token> tokens, int typeIdx, Token type) {
+        Encoding enc = type.encoding();
+        switch (type.signal()) {
+            case BEGIN_ENUM -> {
+                long nul = enc.applicableNullValue().longValue();
+                for (int i = typeIdx + 1; i < typeIdx + type.componentTokenCount() - 1; i++) {
+                    Token v = tokens.get(i);
+                    if (v.signal() == VALID_VALUE && v.encoding().constValue().longValue() == nul) {
+                        return v.name();
+                    }
+                }
+                return "null";
+            }
+            case BEGIN_SET -> {
+                JSONObject flags = new JSONObject();
+                for (int i = typeIdx + 1; i < typeIdx + type.componentTokenCount() - 1; i++) {
+                    Token c = tokens.get(i);
+                    if (c.signal() == CHOICE) {
+                        flags.put(c.name(), false);
+                    }
+                }
+                return flags;
+            }
+            case BEGIN_COMPOSITE -> {
+                // the values of a not-present composite are its members' null values (the printer reads them from the
+                // buffer instead, bug sbe/3)
+                JSONObject members = new JSONObject();
+                int i = typeIdx + 1;
+                int end = typeIdx + type.componentTokenCount() - 1;
+                while (i < end) {
+                    Token m = tokens.get(i);
+                    if (!m.isConstantEncoding()) {
+                        members.put(m.name(), notPresent(tokens, i, m));
+                    } else {
+                        members.put(m.name(), constantOf(m, m));
+                    }
+                    i += m.componentTokenCount();
+                }
+                return members;
+            }
+            default -> {
+                PrimitiveValue nul = enc.applicableNullValue();
+                if (enc.characterEncoding() != null) {
+                    if (nul.representation() == PrimitiveValue.Representation.LONG) {
+                        return nul.longValue() == PrimitiveValue.NULL_VALUE_CHAR ? "" : String.valueOf((char) nul.longValue());
+                    }
+                    return nul.toString();
+                }
+                Object one = jsonOf(nul, enc);
+                if (type.arrayLength() < 2) {
+                    return one;
+                }
+                JSONArray arr = new JSONArray();
+                for (int k = 0; k < type.arrayLength(); k++) {
+                    arr.put(one);
+                }
+                return arr;
+            }
+        }
+    }
+
+    static Object constantOf(Token member, Token type) {
+        Encoding enc = type.encoding();
+        if (type.signal() == uk.co.real_logic.sbe.ir.Signal.BEGIN_ENUM) {
+            String ref = member.encoding().constValue().toString();
+            int dot = ref.indexOf('.');
+            return dot < 0 ? ref : ref.substring(dot + 1);
+        }
+        PrimitiveValue v = enc.constValue();
+        if (enc.characterEncoding() != null) {
+            StringBuilder sb = new StringBuilder();
+            if (v.representation() == PrimitiveValue.Representation.LONG) {
+                if (v.longValue() != PrimitiveValue.NULL_VALUE_CHAR) {
+                    sb.append((char) v.longValue());
+                }
+            } else {
+                sb.append(v);
+            }
+            return sb.toString();
+        }
+        Object one = jsonOf(v, enc);
+        if (type.arrayLength() < 2) {
+            return one;
+        }
+        JSONArray arr = new JSONArray();
+        for (int i = 0; i < type.arrayLength(); i++) {
+            arr.put(one);
+        }
+        return arr;
+    }
+
+    private static Object jsonOf(PrimitiveValue v, Encoding enc) {
+        return switch (enc.primitiveType()) {
+            case CHAR -> String.valueOf((char) v.longValue());
+            // the printer appends a float constant or null value widened to double (1.0E-10 -> 1.000000013351432E-10)
+            case FLOAT -> doubleJson((double) (float) v.doubleValue());
+            case DOUBLE -> doubleJson(v.doubleValue());
+            case UINT64 -> uint64Json(v.longValue());
+            default -> v.longValue();
+        };
+    }
+
+    /**
+     * A uint64 (held as a signed long, as PrimitiveValue does) as JSON: its unsigned value; under HEGEL_NO_KNOWN the
+     * signed long the printer shows (bug sbe/1: 18446744073709551585 prints as -31, the null value as -1).
+     */
+    static Object uint64Json(long v) {
+        return v >= 0 || Zoo.NO_KNOWN ? (Object) v : new BigInteger(Long.toUnsignedString(v));
+    }
+
+    static Object floatJson(float f) {
+        if (Float.isNaN(f)) {
+            return "0/0";
+        }
+        if (f == Float.POSITIVE_INFINITY) {
+            return "1/0";
+        }
+        if (f == Float.NEGATIVE_INFINITY) {
+            return "-1/0";
+        }
+        return f;
+    }
+
+    static Object doubleJson(double d) {
+        if (Double.isNaN(d)) {
+            return "0/0";
+        }
+        if (d == Double.POSITIVE_INFINITY) {
+            return "1/0";
+        }
+        if (d == Double.NEGATIVE_INFINITY) {
+            return "-1/0";
+        }
+        return d;
+    }
+
+    /** Walks the message tokens writing the drawn values; a pure function of the IR and the values. */
+    private static final class Encoder {
+        final Ir ir;
+        final boolean nullTerminates;
+        /** Sets written in the byte order of their BEGIN_SET token (an encoder trusting the IR) rather than the schema's. */
+        final boolean irSets;
+        final int actingVersion;
+        final ExpandableArrayBuffer buffer = new ExpandableArrayBuffer(1024);
+
+        Encoder(Ir ir, boolean nullTerminates, boolean irSets) {
+            this.ir = ir;
+            this.nullTerminates = nullTerminates;
+            this.irSets = irSets;
+            this.actingVersion = ir.version();
+        }
+
+        Msg encode(String xml, int templateId, Body values) {
+            List<Token> tokens = ir.getMessage(templateId);
+            Token msg = tokens.get(0);
+            if (msg.signal() != BEGIN_MESSAGE) {
+                throw new IllegalStateException("first token is " + msg);
+            }
+            int blockLength = msg.encodedLength();
+            ByteOrder bo = ir.byteOrder();
+            buffer.putShort(0, (short) blockLength, bo);
+            buffer.putShort(2, (short) templateId, bo);
+            buffer.putShort(4, (short) ir.id(), bo);
+            buffer.putShort(6, (short) ir.version(), bo);
+            int headerLength = 8;
+            JSONObject root = new JSONObject();
+            MutableInteger cursor = new MutableInteger(1);
+            MutableInteger limit = new MutableInteger(headerLength + blockLength);
+            fields(tokens, cursor, tokens.size() - 1, true, headerLength, values.fields(), root);
+            groups(tokens, cursor, tokens.size() - 1, limit, values, root);
+            varData(tokens, cursor, tokens.size() - 1, limit, values.data(), root);
+            byte[] bytes = new byte[limit.get()];
+            buffer.getBytes(0, bytes);
+            return new Msg(xml, ir, bytes, root);
+        }
+
+        static <V> V drawn(Map<String, V> values, String name) {
+            V v = values.get(name);
+            if (v == null) {
+                throw new IllegalStateException("no value drawn for " + name + " (drawn: " + values.keySet() + ")");
+            }
+            return v;
+        }
+
+        private void fields(List<Token> tokens, MutableInteger cursor, int endIdx, boolean expectFields, int base, Map<String, Value> values, JSONObject out) {
+            while (cursor.get() <= endIdx) {
+                Token member = tokens.get(cursor.get());
+                int next = cursor.get() + member.componentTokenCount();
+                Token type = member;
+                int endFieldTokens = 0;
+                if (member.signal() == BEGIN_FIELD) {
+                    cursor.increment();
+                    type = tokens.get(cursor.get());
+                    endFieldTokens = 1;
+                } else if (expectFields) {
+                    break;
+                }
+                int offset = base + type.offset();
+                String name = member.name();
+                if (member.isConstantEncoding()) {
+                    out.put(name, constantOf(member, type));
+                } else if (!expectFields && member.isOptionalEncoding() && member.version() > actingVersion) {
+                    // a composite member added after the acting version: not present, nothing written
+                    out.put(name, notPresent(tokens, cursor.get(), type));
+                } else {
+                    switch (type.signal()) {
+                        case BEGIN_COMPOSITE -> {
+                            cursor.increment();
+                            int last = next - 1 - endFieldTokens - 1;
+                            JSONObject nested = new JSONObject();
+                            fields(tokens, cursor, last, false, offset, ((CompositeV) drawn(values, name)).members(), nested);
+                            out.put(name, nested);
+                        }
+                        case BEGIN_ENUM -> {
+                            int last = next - endFieldTokens - 1 - 1;
+                            out.put(name, enumValue(offset, tokens, member, type, cursor, last, (EnumV) drawn(values, name)));
+                        }
+                        case BEGIN_SET -> {
+                            int last = next - endFieldTokens - 1 - 1;
+                            out.put(name, bitSet(offset, tokens, type, cursor, last, (SetV) drawn(values, name)));
+                        }
+                        case ENCODING -> out.put(name, encoded(offset, member, type, drawn(values, name)));
+                        default -> throw new IllegalStateException("unexpected member " + type);
+                    }
+                }
+                cursor.set(next);
+            }
+        }
+
+        /** Writes the value of the encoding at the offset (the null value where drawn so and optional) and returns its JSON. */
+        private Object writeOne(int off, Encoding enc, boolean optional, Value value) {
+            PrimitiveType pt = enc.primitiveType();
+            ByteOrder bo = enc.byteOrder();
+            boolean integral = pt != PrimitiveType.FLOAT && pt != PrimitiveType.DOUBLE;
+            long lo = integral ? enc.applicableMinValue().longValue() : 0;
+            long nullValue = integral ? enc.applicableNullValue().longValue() : 0;
+            switch (pt) {
+                case CHAR -> {
+                    Int x = (Int) value;
+                    boolean nul = optional && x.nul();
+                    char c = nul ? (char) nullValue : (char) x.v();
+                    buffer.putByte(off, (byte) c);
+                    return String.valueOf((char) buffer.getByte(off));
+                }
+                case INT8, UINT8 -> {
+                    Int x = (Int) value;
+                    long v = optional && x.nul() ? nullValue : x.v();
+                    buffer.putByte(off, (byte) v);
+                    return pt == PrimitiveType.UINT8 ? (long) (buffer.getByte(off) & 0xFF) : (long) buffer.getByte(off);
+                }
+                case INT16, UINT16 -> {
+                    Int x = (Int) value;
+                    long v = optional && x.nul() ? nullValue : x.v();
+                    buffer.putShort(off, (short) v, bo);
+                    return pt == PrimitiveType.UINT16 ? (long) (buffer.getShort(off, bo) & 0xFFFF) : (long) buffer.getShort(off, bo);
+                }
+                case INT32, UINT32 -> {
+                    Int x = (Int) value;
+                    long v = optional && x.nul() ? nullValue : x.v();
+                    buffer.putInt(off, (int) v, bo);
+                    return pt == PrimitiveType.UINT32 ? buffer.getInt(off, bo) & 0xFFFF_FFFFL : (long) buffer.getInt(off, bo);
+                }
+                case INT64 -> {
+                    Int x = (Int) value;
+                    long v = optional && x.nul() ? nullValue : x.v();
+                    buffer.putLong(off, v, bo);
+                    return v;
+                }
+                case UINT64 -> {
+                    Int x = (Int) value;
+                    boolean nul = optional && x.nul();
+                    long v = nul ? nullValue : x.v();
+                    if (!nul && v == nullValue) {
+                        v = lo;
+                    }
+                    buffer.putLong(off, v, bo);
+                    return uint64Json(v);
+                }
+                case FLOAT -> {
+                    Flt x = (Flt) value;
+                    float f = optional && x.nul() ? (float) enc.applicableNullValue().doubleValue() : x.v();
+                    buffer.putFloat(off, f, bo);
+                    return floatJson(f);
+                }
+                case DOUBLE -> {
+                    Dbl x = (Dbl) value;
+                    double d = optional && x.nul() ? enc.applicableNullValue().doubleValue() : x.v();
+                    buffer.putDouble(off, d, bo);
+                    return doubleJson(d);
+                }
+                default -> throw new IllegalArgumentException("unsupported " + pt);
+            }
+        }
+
+        private Object encoded(int offset, Token member, Token type, Value value) {
+            Encoding enc = type.encoding();
+            int count = type.arrayLength();
+            PrimitiveType pt = enc.primitiveType();
+            boolean optional = member.isOptionalEncoding();
+            if (count == 1) {
+                return writeOne(offset, enc, optional, value);
+            }
+            List<Value> items = ((Arr) value).items();
+            if (pt == PrimitiveType.CHAR) {
+                boolean ended = false;
+                for (int i = 0; i < count; i++) {
+                    int off = offset + i;
+                    if (ended) {
+                        buffer.putByte(off, (byte) 0);
+                    } else {
+                        writeOne(off, enc, optional, at(items, i));
+                        if (nullTerminates && buffer.getByte(off) == 0) {
+                            ended = true;
+                        }
+                    }
+                }
+                // the printer shows the characters up to the first byte that is 0 (or negative)
+                StringBuilder sb = new StringBuilder();
+                for (int i = 0; i < count; i++) {
+                    byte b = buffer.getByte(offset + i);
+                    if (b <= 0) {
+                        break;
+                    }
+                    sb.append((char) b);
+                }
+                return sb.toString();
+            }
+            JSONArray arr = new JSONArray();
+            for (int i = 0; i < count; i++) {
+                arr.put(writeOne(offset + i * pt.size(), enc, optional, at(items, i)));
+            }
+            return arr;
+        }
+
+        private void writeInt(int off, Encoding enc, long value) {
+            ByteOrder bo = enc.byteOrder();
+            switch (enc.primitiveType()) {
+                case CHAR, INT8, UINT8 -> buffer.putByte(off, (byte) value);
+                case INT16, UINT16 -> buffer.putShort(off, (short) value, bo);
+                case INT32, UINT32 -> buffer.putInt(off, (int) value, bo);
+                case INT64, UINT64 -> buffer.putLong(off, value, bo);
+                default -> throw new IllegalArgumentException("unsupported " + enc.primitiveType());
+            }
+        }
+
+        private Object enumValue(int offset, List<Token> tokens, Token member, Token type, MutableInteger cursor, int last, EnumV drawn) {
+            cursor.increment();
+            List<Token> valid = new ArrayList<>();
+            for (; cursor.get() <= last; cursor.increment()) {
+                Token t = tokens.get(cursor.get());
+                if (t.signal() != VALID_VALUE) {
+                    throw new IllegalStateException("expected VALID_VALUE, got " + t);
+                }
+                if (t.version() <= actingVersion) {
+                    valid.add(t);
+                }
+            }
+            if (valid.isEmpty() || (member.isOptionalEncoding() && drawn.nul())) {
+                writeInt(offset, schemaOrder(type.encoding()), type.encoding().nullValue().longValue());
+                return "null";
+            }
+            Token v = at(valid, drawn.index());
+            writeInt(offset, v.encoding(), v.encoding().constValue().longValue());
+            return v.name();
+        }
+
+        private Object bitSet(int offset, List<Token> tokens, Token type, MutableInteger cursor, int last, SetV drawn) {
+            cursor.increment();
+            JSONObject flags = new JSONObject();
+            long value = 0;
+            int k = 0;
+            for (; cursor.get() <= last; cursor.increment(), k++) {
+                Token t = tokens.get(cursor.get());
+                if (t.signal() != CHOICE) {
+                    throw new IllegalStateException("expected CHOICE, got " + t);
+                }
+                boolean on = t.version() <= actingVersion && !drawn.on().isEmpty() && at(drawn.on(), k);
+                if (on) {
+                    value |= 1L << t.encoding().constValue().longValue();
+                }
+                flags.put(t.name(), on);
+            }
+            // the BEGIN_SET token's encoding carries the default (little-endian) byte order whatever the schema says
+            // (bug sbe/2), so with irSets a big-endian schema's set is written little-endian (see encode)
+            writeInt(offset, irSets ? type.encoding() : schemaOrder(type.encoding()), value);
+            return flags;
+        }
+
+        /** The encoding with the schema's byte order (which the IR's set tokens lack, bug sbe/2). */
+        private Encoding schemaOrder(Encoding enc) {
+            return enc.byteOrder() == ir.byteOrder() ? enc
+                : new Encoding.Builder().primitiveType(enc.primitiveType()).byteOrder(ir.byteOrder()).build();
+        }
+
+        private void groups(List<Token> tokens, MutableInteger cursor, int endIdx, MutableInteger limit, Body body, JSONObject out) {
+            while (cursor.get() <= endIdx) {
+                Token g = tokens.get(cursor.get());
+                if (g.signal() != BEGIN_GROUP) {
+                    break;
+                }
+                int next = cursor.get() + g.componentTokenCount();
+                cursor.increment(); // BEGIN_GROUP
+                cursor.increment(); // BEGIN_COMPOSITE (the dimensions)
+                Token blockLengthTok = tokens.get(cursor.get());
+                int blockLength = g.encodedLength();
+                cursor.increment();
+                Token numInGroupTok = tokens.get(cursor.get());
+                cursor.increment(); // ENCODING
+                cursor.increment(); // END_COMPOSITE
+                int headerLength = blockLengthTok.encodedLength() + numInGroupTok.encodedLength();
+                List<Body> elements = drawn(body.groups(), g.name());
+                int off = limit.get();
+                writeInt(off, blockLengthTok.encoding(), blockLength);
+                writeInt(off + blockLengthTok.encodedLength(), numInGroupTok.encoding(), elements.size());
+                limit.set(off + headerLength);
+                JSONArray json = new JSONArray();
+                int bodyStart = cursor.get();
+                for (Body element : elements) {
+                    cursor.set(bodyStart);
+                    JSONObject el = new JSONObject();
+                    int eo = limit.get();
+                    fields(tokens, cursor, next - 1, true, eo, element.fields(), el);
+                    limit.set(eo + blockLength);
+                    groups(tokens, cursor, next - 1, limit, element, el);
+                    varData(tokens, cursor, next - 1, limit, element.data(), el);
+                    json.put(el);
+                }
+                out.put(g.name(), json);
+                cursor.set(next);
+            }
+        }
+
+        private void varData(List<Token> tokens, MutableInteger cursor, int endIdx, MutableInteger limit, Map<String, DataV> values, JSONObject out) {
+            while (cursor.get() <= endIdx) {
+                Token t = tokens.get(cursor.get());
+                if (t.signal() != BEGIN_VAR_DATA) {
+                    break;
+                }
+                int next = cursor.get() + t.componentTokenCount();
+                cursor.increment(); // BEGIN_COMPOSITE
+                cursor.increment(); // ENCODING (length)
+                Token lengthTok = tokens.get(cursor.get());
+                cursor.increment();
+                Token dataTok = tokens.get(cursor.get());
+                cursor.increment(); // END_COMPOSITE
+                String charset = dataTok.encoding().characterEncoding();
+                int max = (int) Math.min(lengthTok.encoding().applicableMaxValue().longValue(), 260L);
+                DataV drawn = drawn(values, t.name());
+                byte[] data;
+                if (drawn.text() != null) {
+                    data = drawn.text().getBytes(Charset.forName(charset));
+                } else {
+                    data = new byte[drawn.raw().size()];
+                    for (int i = 0; i < data.length; i++) {
+                        data[i] = (byte) (int) drawn.raw().get(i);
+                    }
+                }
+                if (data.length > max) {
+                    throw new IllegalStateException("var data " + t.name() + " drawn longer (" + data.length + ") than its limit " + max);
+                }
+                int len = data.length;
+                int off = limit.get();
+                writeInt(off, lengthTok.encoding(), len);
+                buffer.putBytes(off + lengthTok.encodedLength(), data);
+                limit.set(off + lengthTok.encodedLength() + len);
+                Object json;
+                try {
+                    json = charset != null ? new String(data, charset) : PrintBufferUtil.hexDump(data);
+                } catch (Exception e) {
+                    throw new IllegalStateException(e);
+                }
+                out.put(t.name(), json);
+                cursor.set(next);
+            }
+        }
+    }
+}
