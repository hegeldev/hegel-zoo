+    /** The Java oracle: the codecs and DTOs generate and compile, the DTO decoded from the message re-encodes its bytes and prints the same after a second round. */
+    static void javaRoundTrip(JavaCase c) {
+        SbeGen.Msg msg = encode(c.msg(), true, false);
+        JavaOpts options = c.options();
+        RecordingOutput om = new RecordingOutput();
+        try {
+            new JavaGenerator(msg.ir, SbeTool.JAVA_DEFAULT_ENCODING_BUFFER_TYPE, SbeTool.JAVA_DEFAULT_DECODING_BUFFER_TYPE,
+                options.groupOrder(), options.interfaces(), options.unknownEnums(), false,
+                PrecedenceChecks.newInstance(new PrecedenceChecks.Context().shouldGeneratePrecedenceChecks(options.precedence())), om).generate();
+            new JavaDtoGenerator(msg.ir, false, om).generate();
+        } catch (Exception e) {
+            fail("Java code generation failed (" + options + "): " + e + "\n" + msg.xml);
+            return;
+        }
+        Class<?> dtoClass;
+        try {
+            // (CompilerUtil returns null, with the diagnostics on stderr, when the sources do not compile)
+            dtoClass = om.compileAndLoad(SbeGen.PACKAGE + ".TestMessageDto");
+        } catch (Exception e) {
+            fail("generated Java code does not compile (" + options + "): " + e + "\n" + msg.xml + "\n" + abbreviate(om.dump(), 6000));
+            return;
+        }
+        if (dtoClass == null) {
+            fail("generated Java code does not compile (" + options + ")\n" + msg.xml + "\n" + abbreviate(om.dump(), 6000));
+            return;
+        }
+        try {
+            Method decodeFrom = dtoClass.getMethod("decodeFrom", DirectBuffer.class, int.class, int.class, int.class);
+            Method encodeWith = dtoClass.getMethod("encodeWithHeaderWith", dtoClass, MutableDirectBuffer.class, int.class);
+            Object dto = decodeFrom.invoke(null, msg.buffer, MessageHeaderDecoder.ENCODED_LENGTH, msg.headerBlockLength(), msg.headerVersion());
+            // (the DTOs define no equals/hashCode, so only toString is checked)
+            String text = dto.toString();
+            check(text != null && text.startsWith("[TestMessage]"), () -> "DTO toString: " + text);
+            ExpandableArrayBuffer outBuf = new ExpandableArrayBuffer(Math.max(64, msg.length));
+            int outLength = (int) encodeWith.invoke(null, dto, outBuf, 0);
+            byte[] out = new byte[outLength];
+            outBuf.getBytes(0, out, 0, outLength);
+            byte[] in = msg.bytes();
+            check(Arrays.equals(in, out), () -> "DTO decode → encode changed the bytes (" + options + "): " + bytesDifference(in, out) + "\n" + msg.xml + "\nexpected values: " + msg.expected);
+            // the DTO of the re-encoded bytes prints the same
+            Object dto3 = decodeFrom.invoke(null, outBuf, MessageHeaderDecoder.ENCODED_LENGTH, outBuf.getShort(0, msg.ir.byteOrder()) & 0xFFFF, outBuf.getShort(6, msg.ir.byteOrder()) & 0xFFFF);
+            check(text.equals(dto3.toString()), () -> "the DTO of the re-encoded bytes prints differently (" + options + "):\n" + text + "\n" + dto3);
+        } catch (ReflectiveOperationException e) {
+            Throwable cause = e.getCause() != null ? e.getCause() : e;
+            fail("DTO round trip threw (" + options + "): " + cause + "\n" + msg.xml + "\nexpected values: " + msg.expected);
+        }
+    }
