+    /**
+     * Schema evolution: a message of an older schema version (the schema transformed to that version) decoded with
+     * the current schema's printer and codecs shows the old values, and null/empty for what was added since.
+     */
+    @Test
+    void olderMessagesDecodeWithNewerCodecs() {
+        Hegel.test(tc -> guard(() -> {
+            SchemaGen.Schema schema = new SchemaGen(tc, chance(tc, 70)).schema();
+            if (schema.version() == 0) {
+                return;
+            }
+            Ir newIr;
+            Ir oldIr;
+            Ir transformed;
+            SbeGen.Msg msg;
+            int v;
+            try {
+                uk.co.real_logic.sbe.xml.MessageSchema parsed = SbeGen.parse(schema.xml(), true);
+                newIr = new uk.co.real_logic.sbe.xml.IrGenerator().generate(parsed);
+                // composite fields added after the acting version are read from the buffer anyway (bugs sbe/3 and
+                // sbe/4): the acting version is chosen so that every composite field is present
+                // ... and composite members added later cannot be expressed in the older schema's XML (the parser
+                // rejects sinceVersion above the schema version), so they are present too
+                List<Token> tokens = newIr.getMessage(1);
+                int minV = 0;
+                int depth = 0;
+                for (int i = 1; i < tokens.size() - 1; i++) {
+                    Token t = tokens.get(i);
+                    if (t.signal() == Signal.BEGIN_FIELD && tokens.get(i + 1).signal() == Signal.BEGIN_COMPOSITE) {
+                        minV = Math.max(minV, t.version());
+                    }
+                    if (t.signal() == Signal.END_COMPOSITE) {
+                        depth--;
+                    }
+                    if (depth > 0 && t.signal() != Signal.VALID_VALUE && t.signal() != Signal.CHOICE) {
+                        minV = Math.max(minV, t.version());
+                    }
+                    if (t.signal() == Signal.BEGIN_COMPOSITE) {
+                        depth++;
+                    }
+                }
+                if (minV > schema.version() - 1) {
+                    return;
+                }
+                v = Zoo.n(tc, minV, schema.version() - 1);
+                // the schema as of version v: the model prunes the XML itself, since upstream's transformer loses
+                // the block lengths of groups (bug sbe/7); where there are no groups the two must agree
+                String oldXml = olderSchema(schema.xml(), v);
+                oldIr = SbeGen.ir(oldXml);
+                transformed = new uk.co.real_logic.sbe.xml.IrGenerator().generate(
+                    new uk.co.real_logic.sbe.xml.SchemaTransformerFactory("*:" + v).transform(parsed));
+                msg = new SbeGen(tc, true).encode(oldXml, oldIr, 1);
+            } catch (Exception e) {
+                throw control(e, "schema transformation to an older version failed: " + e + "\n" + schema.xml());
+            }
+            // (the transformer keeps valid values and choices newer than v, which the pruned XML cannot)
+            boolean newerValues = java.util.regex.Pattern.compile("<(validValue|choice) [^>]*sinceVersion=\"(\\d+)\"")
+                .matcher(schema.xml()).results().anyMatch(m -> Integer.parseInt(m.group(2)) > v);
+            if (!newerValues && newIr.getMessage(1).stream().noneMatch(t -> t.signal() == Signal.BEGIN_GROUP)) {
+                String mine = transformerText(oldIr.getMessage(1));
+                String theirs = transformerText(transformed.getMessage(1));
+                check(theirs.equals(mine),
+                    () -> "SchemaTransformerFactory(\"*:" + v + "\") differs from pruning the XML to version " + v + ":\n"
+                        + firstDifference(mine, theirs) + "\n" + schema.xml());
+            }
+            check(oldIr.version() == v, () -> "the schema transformed to version " + v + " has IR version " + oldIr.version());
+            // expected: the old values plus the defaults of everything added after version v
+            JSONObject expected = new JSONObject(msg.expected.toString());
+            addDefaults(newIr.getMessage(1), 1, newIr.getMessage(1).size() - 1, v, expected, false);
+            // the DTO re-encodes not-present optional numeric arrays as zeros, not null values (bug sbe/8)
+            JSONObject expectedDto = new JSONObject(msg.expected.toString());
+            addDefaults(newIr.getMessage(1), 1, newIr.getMessage(1).size() - 1, v, expectedDto, true);
+            JsonPrinter printer = new JsonPrinter(newIr);
+            StringBuilder out = new StringBuilder();
+            String text;
+            try {
+                printer.print(out, padded(msg), 0);
+                text = out.toString();
+            } catch (RuntimeException e) {
+                fail("JsonPrinter of the current schema threw on a version-" + v + " message: " + e + "\n" + schema.xml() + "\nold values: " + msg.expected);
+                return;
+            }
+            JSONObject parsed;
+            try {
+                parsed = new JSONObject(text);
+            } catch (JSONException e) {
+                fail("JsonPrinter output for a version-" + v + " message is not JSON: " + e.getMessage() + "\n" + text + "\n" + schema.xml());
+                return;
+            }
+            check(parsed.similar(expected), () -> "JsonPrinter of the current schema shows a version-" + v + " message differently from its values:\n" + jsonDifference(expected, parsed) + "\nprinted:\n" + text + "\nexpected:\n" + expected.toString(2) + "\n" + schema.xml());
+            // the current codecs' DTO decodes it and re-encodes it as a current-version message with the same values
+            RecordingOutput om = new RecordingOutput();
+            Class<?> dtoClass;
+            try {
+                new JavaGenerator(newIr, SbeTool.JAVA_DEFAULT_ENCODING_BUFFER_TYPE, SbeTool.JAVA_DEFAULT_DECODING_BUFFER_TYPE,
+                    false, false, false, false, PrecedenceChecks.newInstance(new PrecedenceChecks.Context()), om).generate();
+                new JavaDtoGenerator(newIr, false, om).generate();
+                dtoClass = om.compileAndLoad(SbeGen.PACKAGE + ".TestMessageDto");
+            } catch (Exception e) {
+                fail("Java code generation/compilation failed: " + e + "\n" + schema.xml());
+                return;
+            }
+            try {
+                Method decodeFrom = dtoClass.getMethod("decodeFrom", DirectBuffer.class, int.class, int.class, int.class);
+                Method encodeWith = dtoClass.getMethod("encodeWithHeaderWith", dtoClass, MutableDirectBuffer.class, int.class);
+                check(msg.headerVersion() == v, () -> "header version " + msg.headerVersion() + " for a version-" + v + " message");
+                Object dto = decodeFrom.invoke(null, msg.buffer, MessageHeaderDecoder.ENCODED_LENGTH, msg.headerBlockLength(), msg.headerVersion());
+                ExpandableArrayBuffer outBuf = new ExpandableArrayBuffer(Math.max(64, msg.length));
+                int outLength = (int) encodeWith.invoke(null, dto, outBuf, 0);
+                String reprinted = printer.print(ByteBuffer.wrap(Arrays.copyOf(outBuf.byteArray(), outLength + 8))); // padded, bug sbe/10
+                JSONObject reparsed = new JSONObject(reprinted);
+                check(reparsed.similar(expectedDto), () -> "a version-" + v + " message decoded by the current DTO and re-encoded prints differently:\n" + jsonDifference(expectedDto, reparsed) + "\nreprinted:\n" + reprinted + "\nexpected:\n" + expectedDto.toString(2) + "\n" + schema.xml());
+            } catch (ReflectiveOperationException e) {
+                Throwable cause = e.getCause() != null ? e.getCause() : e;
+                fail("current DTO on a version-" + v + " message threw: " + cause + "\n" + schema.xml() + "\nold values: " + msg.expected);
+            } catch (JSONException e) {
+                fail("re-encoded version-" + v + " message does not print as JSON: " + e.getMessage() + "\n" + schema.xml());
+            } catch (RuntimeException e) {
+                throw control(e, "re-encoding a version-" + v + " message through the current DTO failed: " + e + "\n" + schema.xml());
+            }
+        }), Zoo.settings("sbe.olderMessagesDecodeWithNewerCodecs"));
+    }
