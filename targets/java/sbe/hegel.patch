+import uk.co.real_logic.sbe.xml.IrGenerator;
+import uk.co.real_logic.sbe.xml.SchemaTransformerFactory;
+
+/**
+ * Pins for the recorded bugs (bugs.toml): each asserts the correct behaviour on a minimal schema and fails
+ * while the bug exists.
+ */
+class SbePinsTest {
+    private static final String STANDARD_TYPES = """
+            <composite name="messageHeader">
+              <type name="blockLength" primitiveType="uint16"/>
+              <type name="templateId" primitiveType="uint16"/>
+              <type name="schemaId" primitiveType="uint16"/>
+              <type name="version" primitiveType="uint16"/>
+            </composite>
+            <composite name="groupSizeEncoding">
+              <type name="blockLength" primitiveType="uint16"/>
+              <type name="numInGroup" primitiveType="uint16"/>
+            </composite>
+        """;
+
+    private static final String PAIR = """
+            <composite name="Pair">
+              <type name="p" primitiveType="int16"/>
+              <type name="q" primitiveType="int16"/>
+            </composite>
+        """;
+
+    private static final String FLAGS = """
+            <set name="Flags" encodingType="uint16">
+              <choice name="a">0</choice>
+              <choice name="b">9</choice>
+            </set>
+        """;
+
+    private static final String ENUM = """
+            <enum name="E" encodingType="uint8">
+              <validValue name="Case0">0</validValue>
+              <validValue name="Case1">1</validValue>
+            </enum>
+        """;
+
+    /** Schema version 1 whose message gained a composite field in version 1. */
+    private static final String LATER_COMPOSITE = schema("1", "", PAIR, """
+            <field name="x" id="1" type="int32"/>
+            <field name="c" id="2" type="Pair" presence="optional" sinceVersion="1"/>
+        """);
+
+    /** sbe/1: uint64 values are printed as JSON numbers with their unsigned value. */
+    @Test
+    void pin_uint64ValuesPrintUnsigned() throws Exception {
+        Ir ir = SbeGen.ir(schema("0", "", "", "    <field name=\"big\" id=\"1\" type=\"uint64\"/>\n"));
+        UnsafeBuffer buf = message(ir, 8, 0, 8);
+        buf.putLong(8, -31L, ir.byteOrder()); // 18446744073709551585 as a uint64
+        StringBuilder out = new StringBuilder();
+        new JsonPrinter(ir).print(out, buf, 0);
+        BigInteger printed = new JSONObject(out.toString()).getBigInteger("big");
+        check(new BigInteger("18446744073709551585").equals(printed),
+            () -> "JsonPrinter printed the uint64 value 18446744073709551585 as " + printed);
+    }
+
+    /** sbe/2: the IR's BEGIN_SET token carries the schema's byte order, like its choices. */
+    @Test
+    void pin_setTokensCarryTheSchemaByteOrder() throws Exception {
+        Ir ir = SbeGen.ir(schema("0", " byteOrder=\"bigEndian\"", FLAGS, "    <field name=\"flags\" id=\"1\" type=\"Flags\"/>\n"));
+        List<Token> set = ir.getType("Flags");
+        ByteOrder setOrder = set.get(0).encoding().byteOrder();
+        ByteOrder choiceOrder = set.get(1).encoding().byteOrder();
+        check(setOrder == ir.byteOrder() && choiceOrder == ir.byteOrder(),
+            () -> "in a bigEndian schema the BEGIN_SET token has byte order " + setOrder + " and its CHOICE tokens " + choiceOrder);
+    }
+
+    /** sbe/3: the printer treats a composite field added after the message's version as not present. */
+    @Test
+    void pin_printerSkipsCompositesAddedAfterTheActingVersion() throws Exception {
+        Ir ir = SbeGen.ir(LATER_COMPOSITE);
+        UnsafeBuffer buf = message(ir, 4, 0, 4);
+        buf.putInt(8, 7, ir.byteOrder());
+        StringBuilder out = new StringBuilder();
+        try {
+            new JsonPrinter(ir).print(out, buf, 0);
+        } catch (RuntimeException e) {
+            fail("JsonPrinter threw on a version-0 message whose composite field c was added in version 1: " + e);
+            return;
+        }
+        JSONObject printed = new JSONObject(out.toString());
+        check(printed.optInt("x") == 7, () -> "printed " + out);
+    }
+
+    /** sbe/4: the generated DTO decodes an older message whose composite field was added later. */
+    @Test
+    void pin_dtoDecodesOlderMessagesWithLaterComposites() throws Exception {
+        Ir ir = SbeGen.ir(LATER_COMPOSITE);
+        UnsafeBuffer buf = message(ir, 4, 0, 4);
+        buf.putInt(8, 7, ir.byteOrder());
+        Class<?> dto = generateJava(ir, true).compileAndLoad(SbeGen.PACKAGE + ".MDto");
+        Method decodeFrom = dto.getMethod("decodeFrom", DirectBuffer.class, int.class, int.class, int.class);
+        Object decoded;
+        try {
+            decoded = decodeFrom.invoke(null, buf, 8, 4, 0);
+        } catch (InvocationTargetException e) {
+            fail("MDto.decodeFrom threw on a version-0 message whose composite field c was added in version 1: " + e.getCause());
+            return;
+        }
+        check(String.valueOf(decoded).contains("x=7"), () -> "decoded " + decoded);
+    }
+
+    /** sbe/5: the Go flyweight codec's RawValue() reads the whole set, not its first byte. */
+    @Test
+    void pin_goFlyweightRawValueReadsTheWholeSet() throws Exception {
+        Ir ir = SbeGen.ir(schema("0", "", FLAGS, "    <field name=\"flags\" id=\"1\" type=\"Flags\"/>\n"));
+        SbeTest.MemoryOutput om = new SbeTest.MemoryOutput();
+        new GolangFlyweightGenerator(ir, false, om).generate();
+        String source = String.valueOf(om.files.get("Flags"));
+        int at = source.indexOf("RawValue()");
+        check(at >= 0, () -> "no RawValue() in the generated Flags.go:\n" + source);
+        String body = source.substring(at, source.indexOf('}', at) + 1);
+        check(body.contains("Uint16"), () -> "RawValue() of a uint16 set reads a single byte:\n" + body);
+    }
+
+    /** sbe/6: a group named like a type (differing in the first letter's case) still yields compilable Java. */
+    @Test
+    void pin_groupsNamedLikeATypeCompile() throws Exception {
+        Ir ir = SbeGen.ir(schema("0", "", PAIR, """
+                <group name="pair" id="1" dimensionType="groupSizeEncoding">
+                  <field name="value" id="2" type="Pair"/>
+                </group>
+            """));
+        Class<?> decoder = null;
+        try {
+            decoder = generateJava(ir, false).compileAndLoad(SbeGen.PACKAGE + ".MDecoder");
+        } catch (Exception e) {
+            fail("the Java codecs of a message with group 'pair' holding a 'Pair' composite do not compile: " + e);
+        }
+        check(decoder != null, "the Java codecs of a message with group 'pair' holding a 'Pair' composite do not compile");
+    }
+
+    /** sbe/7: transforming a schema to an older version keeps the block lengths of its groups. */
+    @Test
+    void pin_transformedSchemasKeepGroupBlockLengths() throws Exception {
+        String xml = schema("1", "", "", """
+                <field name="x" id="1" type="int32"/>
+                <field name="y" id="2" type="int32" presence="optional" sinceVersion="1"/>
+                <group name="g" id="3" dimensionType="groupSizeEncoding">
+                  <field name="a" id="4" type="int32"/>
+                  <field name="b" id="5" type="int16"/>
+                  <group name="h" id="6" dimensionType="groupSizeEncoding">
+                    <field name="c" id="7" type="int64"/>
+                  </group>
+                </group>
+            """);
+        Ir ir = SbeGen.ir(xml);
+        Ir old = new IrGenerator().generate(new SchemaTransformerFactory("*:0").transform(SbeGen.parse(xml, true)));
+        StringBuilder diff = new StringBuilder();
+        for (Token t : ir.getMessage(1)) {
+            if (t.signal() == Signal.BEGIN_GROUP) {
+                Token o = old.getMessage(1).stream().filter(k -> k.signal() == Signal.BEGIN_GROUP && k.name().equals(t.name())).findFirst().orElseThrow();
+                if (o.encodedLength() != t.encodedLength()) {
+                    diff.append("group ").append(t.name()).append(": block length ").append(t.encodedLength())
+                        .append(" in the original, ").append(o.encodedLength()).append(" after SchemaTransformerFactory(\"*:0\")\n");
+                }
+            }
+        }
+        check(diff.isEmpty(), () -> diff.toString());
+    }
+
+    /** sbe/8: the DTO re-encodes a not-present optional array field as null values, like a not-present scalar. */
+    @Test
+    void pin_dtoEncodesAbsentOptionalArraysAsNulls() throws Exception {
+        Ir ir = SbeGen.ir(schema("1", "", "    <type name=\"D2\" primitiveType=\"double\" length=\"2\" presence=\"optional\"/>\n", """
+                <field name="x" id="1" type="int32"/>
+                <field name="s" id="2" type="double" presence="optional" sinceVersion="1"/>
+                <field name="t" id="3" type="D2" presence="optional" sinceVersion="1"/>
+            """));
+        UnsafeBuffer buf = message(ir, 4, 0, 4);
+        buf.putInt(8, 7, ir.byteOrder());
+        Class<?> dto = generateJava(ir, true).compileAndLoad(SbeGen.PACKAGE + ".MDto");
+        Object decoded = dto.getMethod("decodeFrom", DirectBuffer.class, int.class, int.class, int.class).invoke(null, buf, 8, 4, 0);
+        UnsafeBuffer re = new UnsafeBuffer(new byte[64]);
+        dto.getMethod("encodeWithHeaderWith", dto, MutableDirectBuffer.class, int.class).invoke(null, decoded, re, 0);
+        StringBuilder out = new StringBuilder();
+        new JsonPrinter(ir).print(out, re, 0);
+        JSONObject printed = new JSONObject(out.toString());
+        check("0/0".equals(printed.opt("s")) && new JSONArray(List.of("0/0", "0/0")).similar(printed.optJSONArray("t")),
+            () -> "a version-0 message re-encoded by the current DTO has s (not present, scalar) = " + printed.opt("s")
+                + " and t (not present, array) = " + printed.opt("t"));
+    }
+
+    /** sbe/9: a bit set added after the message's version prints with every choice false. */
+    @Test
+    void pin_absentSetsPrintNoChoices() throws Exception {
+        Ir ir = SbeGen.ir(schema("1", "", FLAGS, """
+                <field name="x" id="1" type="int32"/>
+                <field name="flags" id="2" type="Flags" presence="optional" sinceVersion="1"/>
+            """));
+        UnsafeBuffer buf = message(ir, 4, 0, 4);
+        buf.putInt(8, 7, ir.byteOrder());
+        StringBuilder out = new StringBuilder();
+        new JsonPrinter(ir).print(out, buf, 0);
+        JSONObject flags = new JSONObject(out.toString()).getJSONObject("flags");
+        check(!flags.getBoolean("a") && !flags.getBoolean("b"),
+            () -> "a version-0 message prints the set added in version 1 as " + flags);
+    }
+
+    /** sbe/10: a message ending in a constant enum field prints from a buffer of exactly its length. */
+    @Test
+    void pin_printerReadsNothingForConstantEnums() throws Exception {
+        Ir ir = SbeGen.ir(schema("0", "", ENUM, """
+                <field name="x" id="1" type="int32"/>
+                <field name="e" id="2" type="E" presence="constant" valueRef="E.Case1"/>
+            """));
+        UnsafeBuffer buf = message(ir, 4, 0, 4);
+        buf.putInt(8, 7, ir.byteOrder());
+        StringBuilder out = new StringBuilder();
+        try {
+            new JsonPrinter(ir).print(out, buf, 0);
+        } catch (RuntimeException e) {
+            fail("JsonPrinter threw on a 12-byte message whose last field is the constant enum e: " + e);
+            return;
+        }
+        check("Case1".equals(new JSONObject(out.toString()).optString("e")), () -> "printed " + out);
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    static String schema(String version, String attributes, String types, String members) {
+        return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+            + "<sbe:messageSchema xmlns:sbe=\"http://fixprotocol.io/2016/sbe\" package=\"" + SbeGen.PACKAGE
+            + "\" id=\"42\" version=\"" + version + "\"" + attributes + ">\n"
+            + "  <types>\n" + STANDARD_TYPES + types + "  </types>\n"
+            + "  <sbe:message name=\"M\" id=\"1\">\n" + members + "  </sbe:message>\n"
+            + "</sbe:messageSchema>\n";
+    }
+
+    /** A buffer holding the message header of template 1 followed by bodyLength zero bytes. */
+    static UnsafeBuffer message(Ir ir, int blockLength, int version, int bodyLength) {
+        UnsafeBuffer buf = new UnsafeBuffer(new byte[8 + bodyLength]);
+        ByteOrder bo = ir.byteOrder();
+        buf.putShort(0, (short) blockLength, bo);
+        buf.putShort(2, (short) 1, bo);
+        buf.putShort(4, (short) ir.id(), bo);
+        buf.putShort(6, (short) version, bo);
+        return buf;
+    }
+
+    static SbeTest.RecordingOutput generateJava(Ir ir, boolean dto) throws java.io.IOException {
+        SbeTest.RecordingOutput om = new SbeTest.RecordingOutput();
+        new JavaGenerator(ir, SbeTool.JAVA_DEFAULT_ENCODING_BUFFER_TYPE, SbeTool.JAVA_DEFAULT_DECODING_BUFFER_TYPE,
+            false, false, false, false, PrecedenceChecks.newInstance(new PrecedenceChecks.Context()), om).generate();
+        if (dto) {
+            new JavaDtoGenerator(ir, false, om).generate();
+        }
+        return om;
+    }
+}
