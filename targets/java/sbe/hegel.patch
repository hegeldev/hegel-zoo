+    /** Token text for comparing with upstream's transformer, whose group and var-data tokens keep the original layout's offsets (bug sbe/7). */
+    static String transformerText(List<Token> tokens) {
+        return tokensText(tokens).replaceAll("offset=\\d+", "offset=?");
+    }
+
+    /** The schema XML as of version v: members (fields, groups, var data) added later removed, version set to v. */
+    static String olderSchema(String xml, int v) throws Exception {
+        org.w3c.dom.Document doc = javax.xml.parsers.DocumentBuilderFactory.newInstance().newDocumentBuilder()
+            .parse(new org.xml.sax.InputSource(new java.io.StringReader(xml)));
+        org.w3c.dom.Element root = doc.getDocumentElement();
+        root.setAttribute("version", Integer.toString(v));
+        java.util.Set<String> referenced = new java.util.HashSet<>();
+        java.util.regex.Matcher m = java.util.regex.Pattern.compile("valueRef=\"([^\"]+)\"").matcher(xml);
+        while (m.find()) {
+            referenced.add(m.group(1));
+        }
+        prune(root, v, referenced);
+        java.io.StringWriter w = new java.io.StringWriter();
+        javax.xml.transform.TransformerFactory.newInstance().newTransformer().transform(
+            new javax.xml.transform.dom.DOMSource(doc), new javax.xml.transform.stream.StreamResult(w));
+        return w.toString();
+    }
+
+    private static void prune(org.w3c.dom.Element e, int v, java.util.Set<String> referenced) {
+        List<org.w3c.dom.Element> gone = new ArrayList<>();
+        org.w3c.dom.NodeList kids = e.getChildNodes();
+        for (int i = 0; i < kids.getLength(); i++) {
+            if (kids.item(i) instanceof org.w3c.dom.Element k) {
+                String name = k.getNodeName();
+                String since = k.getAttribute("sinceVersion");
+                // members added later go; so do valid values and choices (never written for version v anyway)
+                boolean member = name.equals("field") || name.equals("group") || name.equals("data")
+                    || name.equals("validValue") || name.equals("choice");
+                // a valid value a constant field refers to must stay (clamped below)
+                if (name.equals("validValue") && referenced.contains(e.getAttribute("name") + "." + k.getAttribute("name"))) {
+                    member = false;
+                }
+                if (member && !since.isEmpty() && Integer.parseInt(since) > v) {
+                    gone.add(k);
+                } else {
+                    if (!since.isEmpty() && Integer.parseInt(since) > v) {
+                        // a composite member (or type) newer than v: the parser rejects sinceVersion above the schema
+                        // version; message 1 never uses such members (see the acting version choice), so clamp
+                        k.setAttribute("sinceVersion", Integer.toString(v));
+                    }
+                    prune(k, v, referenced);
+                }
+            }
+        }
+        for (org.w3c.dom.Element k : gone) {
+            e.removeChild(k);
+        }
+    }
+
+    /** The message followed by eight zero bytes: the printer reads past a trailing constant enum field (bug sbe/10). */
+    static byte[] paddedBytes(SbeGen.Msg msg) {
+        return Arrays.copyOf(msg.bytes(), msg.length + 8);
+    }
+
+    static UnsafeBuffer padded(SbeGen.Msg msg) {
+        return new UnsafeBuffer(paddedBytes(msg));
+    }
+
+    /** Every choice of the set token at typeIdx mapped to flag. */
+    static JSONObject allChoices(List<Token> tokens, int typeIdx, Token type, boolean flag) {
+        JSONObject flags = new JSONObject();
+        for (int i = typeIdx + 1; i < typeIdx + type.componentTokenCount() - 1; i++) {
+            if (tokens.get(i).signal() == Signal.CHOICE) {
+                flags.put(tokens.get(i).name(), flag);
+            }
+        }
+        return flags;
+    }
+
+    /** Adds the choices newer than v (which an older message's set cannot have) as false; recurses into composites. */
+    static void fillChoices(List<Token> tokens, int typeIdx, Token type, int v, Object value) {
+        if (type.signal() == Signal.BEGIN_SET && value instanceof JSONObject flags) {
+            for (int i = typeIdx + 1; i < typeIdx + type.componentTokenCount() - 1; i++) {
+                Token c = tokens.get(i);
+                if (c.signal() == Signal.CHOICE && c.version() > v && !flags.has(c.name())) {
+                    flags.put(c.name(), false);
+                }
+            }
+        } else if (type.signal() == Signal.BEGIN_COMPOSITE && value instanceof JSONObject members) {
+            int i = typeIdx + 1;
+            int end = typeIdx + type.componentTokenCount() - 1;
+            while (i < end) {
+                Token m = tokens.get(i);
+                fillChoices(tokens, i, m, v, members.opt(m.name()));
+                i += m.componentTokenCount();
+            }
+        }
+    }
+
+    /** Adds to obj (the values of an older message) what the current tokens define after version v. */
+    static void addDefaults(List<Token> tokens, int from, int endIdx, int v, JSONObject obj, boolean dtoArraysAsZeros) {
+        int i = from;
+        while (i <= endIdx) {
+            Token t = tokens.get(i);
+            int next = i + t.componentTokenCount();
+            switch (t.signal()) {
+                case BEGIN_FIELD -> {
+                    Token type = tokens.get(i + 1);
+                    if (obj.has(t.name())) {
+                        fillChoices(tokens, i + 1, type, v, obj.opt(t.name()));
+                    } else if (t.version() > v) {
+                        Object value = t.isConstantEncoding() ? SbeGen.constantOf(t, type) : SbeGen.notPresent(tokens, i + 1, type);
+                        if (dtoArraysAsZeros && !t.isConstantEncoding() && type.signal() == Signal.ENCODING && type.arrayLength() <= 1
+                            && type.encoding().primitiveType() == PrimitiveType.CHAR) {
+                            value = "\u0000"; // the DTO writes the char null value; the printer shows a present NUL as \u0000
+                        }
+                        if (!dtoArraysAsZeros && type.signal() == Signal.BEGIN_SET) {
+                            // the printer shows the null value (all bits) for a not-present set (bug sbe/9)
+                            value = allChoices(tokens, i + 1, type, true);
+                        }
+                        if (dtoArraysAsZeros && !t.isConstantEncoding() && type.signal() == Signal.ENCODING && type.arrayLength() > 1
+                            && type.encoding().primitiveType() != PrimitiveType.CHAR) {
+                            org.json.JSONArray zeros = new org.json.JSONArray();
+                            boolean floating = type.encoding().primitiveType() == PrimitiveType.FLOAT || type.encoding().primitiveType() == PrimitiveType.DOUBLE;
+                            for (int k = 0; k < type.arrayLength(); k++) {
+                                zeros.put(floating ? (Object) 0.0d : (Object) 0L);
+                            }
+                            value = zeros;
+                        }
+                        obj.put(t.name(), value);
+                    }
+                }
+                case BEGIN_GROUP -> {
+                    if (t.version() > v) {
+                        if (!obj.has(t.name())) {
+                            obj.put(t.name(), new org.json.JSONArray());
+                        }
+                    } else {
+                        org.json.JSONArray elements = obj.optJSONArray(t.name());
+                        if (elements != null) {
+                            int dims = tokens.get(i + 1).componentTokenCount();
+                            for (int k = 0; k < elements.length(); k++) {
+                                addDefaults(tokens, i + 1 + dims, next - 2, v, elements.getJSONObject(k), dtoArraysAsZeros);
+                            }
+                        }
+                    }
+                }
+                case BEGIN_VAR_DATA -> {
+                    if (t.version() > v && !obj.has(t.name())) {
+                        obj.put(t.name(), "");
+                    }
+                }
+                default -> {
+                    return;
+                }
+            }
+            i = next;
+        }
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    /** Hegel's control-flow exceptions must pass; anything else is a finding (in COLLECT mode the case ends). */
+    static RuntimeException control(Exception e, String message) {
+        if (e instanceof RuntimeException r && e.getClass().getName().startsWith("dev.hegel.")) {
+            return r;
+        }
+        fail(message);
+        return new CaseDone();
+    }
+
+    static void guard(Runnable body) {
+        try {
+            body.run();
+        } catch (CaseDone ignored) {
+            // COLLECT mode: the finding is printed, the case ends
+        }
+    }
+
+    static final class CaseDone extends RuntimeException {
+        CaseDone() {
+            super(null, null, false, false);
+        }
+    }
+
+    interface Body {
+        void run() throws Exception;
+    }
+
+    static void run(String language, String xml, Body body) {
+        try {
+            body.run();
+        } catch (Exception | StackOverflowError e) {
+            fail("the " + language + " generator failed: " + e + "\n" + xml);
+        }
+    }
+
+    /** An OutputManager keeping the generated sources in memory. */
+    static final class MemoryOutput implements OutputManager {
+        final Map<String, StringWriter> files = new LinkedHashMap<>();
+
+        @Override
+        public Writer createOutput(String name) {
+            StringWriter w = new StringWriter();
+            files.put(name, w);
+            return w;
+        }
+    }
+
+    static Map<String, CharSequence> javaSources(Ir ir, boolean groupOrder, boolean interfaces, boolean unknownEnums, boolean precedence) {
+        RecordingOutput om = new RecordingOutput();
+        try {
+            new JavaGenerator(ir, SbeTool.JAVA_DEFAULT_ENCODING_BUFFER_TYPE, SbeTool.JAVA_DEFAULT_DECODING_BUFFER_TYPE,
+                groupOrder, interfaces, unknownEnums, false,
+                PrecedenceChecks.newInstance(new PrecedenceChecks.Context().shouldGeneratePrecedenceChecks(precedence)), om).generate();
+        } catch (IOException e) {
+            throw new IllegalStateException(e);
+        }
+        return om.sources;
+    }
+
+    static final class RecordingOutput implements org.agrona.generation.DynamicPackageOutputManager {
+        final Map<String, CharSequence> sources = new TreeMap<>();
+        String pkg = SbeGen.PACKAGE;
+
+        @Override
+        public Writer createOutput(String name) {
+            String key = pkg + "." + name;
+            pkg = SbeGen.PACKAGE;
+            return new StringWriter() {
+                @Override
+                public void close() {
+                    sources.put(key, getBuffer().toString());
+                }
+            };
+        }
+
+        @Override
+        public void setPackageName(String packageName) {
+            pkg = packageName;
+        }
+
+        Class<?> compileAndLoad(String className) throws ClassNotFoundException {
+            return org.agrona.generation.CompilerUtil.compileInMemory(className, sources);
+        }
+
+        String dump() {
+            StringBuilder sb = new StringBuilder();
+            sources.forEach((name, src) -> sb.append("\n---- ").append(name).append('\n').append(src));
+            return sb.toString();
+        }
+    }
+
+    static String tokensText(List<Token> tokens) {
+        StringBuilder sb = new StringBuilder();
+        for (Token t : tokens) {
+            sb.append(t).append('\n');
+        }
+        return sb.toString();
+    }
+
+    static String firstDifference(String a, String b) {
+        int i = 0;
+        while (i < a.length() && i < b.length() && a.charAt(i) == b.charAt(i)) {
+            i++;
+        }
+        int from = Math.max(0, i - 200);
+        return "at " + i + ":\n<<< " + a.substring(from, Math.min(a.length(), i + 200)) + "\n>>> " + b.substring(from, Math.min(b.length(), i + 200));
+    }
+
+    static String bytesDifference(byte[] a, byte[] b) {
+        int i = 0;
+        while (i < a.length && i < b.length && a[i] == b[i]) {
+            i++;
+        }
+        return "lengths " + a.length + " vs " + b.length + ", first difference at byte " + i
+            + (i < a.length ? " (" + a[i] : " (end") + (i < b.length ? " vs " + b[i] + ")" : " vs end)");
+    }
+
+    static String jsonDifference(JSONObject expected, JSONObject actual) {
+        List<String> diffs = new ArrayList<>();
+        jsonDifference("", expected, actual, diffs);
+        return diffs.isEmpty() ? "(no difference found by the walker)" : String.join("\n", diffs.subList(0, Math.min(8, diffs.size())));
+    }
+
+    private static void jsonDifference(String path, Object e, Object a, List<String> diffs) {
+        if (e instanceof JSONObject eo && a instanceof JSONObject ao) {
+            for (String k : eo.keySet()) {
+                if (!ao.has(k)) {
+                    diffs.add(path + "/" + k + ": expected " + eo.get(k) + ", missing");
+                } else {
+                    jsonDifference(path + "/" + k, eo.get(k), ao.get(k), diffs);
+                }
+            }
+            for (String k : ao.keySet()) {
+                if (!eo.has(k)) {
+                    diffs.add(path + "/" + k + ": unexpected " + ao.get(k));
+                }
+            }
+        } else if (e instanceof org.json.JSONArray ea && a instanceof org.json.JSONArray aa) {
+            if (ea.length() != aa.length()) {
+                diffs.add(path + ": expected " + ea.length() + " elements, got " + aa.length());
+            }
+            for (int i = 0; i < Math.min(ea.length(), aa.length()); i++) {
+                jsonDifference(path + "[" + i + "]", ea.get(i), aa.get(i), diffs);
+            }
+        } else if (e instanceof JSONObject || a instanceof JSONObject || e instanceof org.json.JSONArray || a instanceof org.json.JSONArray) {
+            diffs.add(path + ": expected " + e + " (" + e.getClass().getSimpleName() + "), got " + a + " (" + a.getClass().getSimpleName() + ")");
+        } else {
+            JSONObject x = new JSONObject().put("v", e);
+            JSONObject y = new JSONObject().put("v", a);
+            if (!x.similar(y)) {
+                diffs.add(path + ": expected " + Zoo.show(e) + ", got " + Zoo.show(a));
+            }
+        }
+    }
+
+    static String abbreviate(String s, int max) {
+        return s.length() > max ? s.substring(0, max) + "…" : s;
+    }
+
+    /** Runs the command in dir; null on success, else a description with the outputs. */
+    static String execute(Path dir, String... args) throws IOException, InterruptedException {
+        Path stdout = dir.resolve("stdout.txt");
+        Path stderr = dir.resolve("stderr.txt");
+        Process p = new ProcessBuilder(args).directory(dir.toFile()).redirectOutput(stdout.toFile()).redirectError(stderr.toFile()).start();
+        int code = p.waitFor();
+        String err = Files.readString(stderr);
+        if (code != 0) {
+            return String.join(" ", args) + " exited " + code + "\nSTDOUT: " + Files.readString(stdout) + "\nSTDERR: " + err;
+        }
+        return null;
+    }
+}
diff --git a/hegel/src/test/java/zoo/SchemaGen.java b/hegel/src/test/java/zoo/SchemaGen.java
new file mode 100644
index 0000000..a5f109c
--- /dev/null
+++ b/hegel/src/test/java/zoo/SchemaGen.java
@@ -0,0 +1,538 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.TestCase;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import uk.co.real_logic.sbe.PrimitiveType;
+
+/**
+ * Random SBE message schemas as XML text, wider than upstream's jqwik arbitraries: big-endian byte order, constant
+ * fields and members (with values or enum valueRefs), custom min/max/null values, explicit offsets (padding),
+ * sinceVersion/deprecated on fields, groups, data and composite members, custom group dimension types, UTF-8 var
+ * data, a second message, and descriptions/semantic types. The message under test is always {@code TestMessage}
+ * (template id 1).
+ */
+final class SchemaGen {
+    static final String PACKAGE = "uk.co.real_logic.sbe.properties";
+    static final int MAX_COMPOSITE_DEPTH = 3;
+    static final int MAX_GROUP_DEPTH = 3;
+
+    /** What the encoder and the properties need to know about the generated schema. */
+    record Schema(String xml, int version, boolean bigEndian, boolean hasConstants, boolean hasOffsets) {}
+
+    /** A named type in {@code <types>}: its encoded size (0 for constants) and, for enums, its valid value names. */
+    record Type(String name, int size, PrimitiveType primitive, List<String> enumValues, boolean constant) {}
+
+    private final TestCase tc;
+    private final StringBuilder types = new StringBuilder();
+    private final Map<Integer, List<Type>> pool = new HashMap<>();
+    private final List<Type> enums = new ArrayList<>();
+    private final Set<String> groupSizes = new LinkedHashSet<>();
+    private int nextType;
+    private int nextMember;
+    private int version;
+    private boolean hasConstants;
+    private boolean hasOffsets;
+    private final boolean bigEndian;
+    private final boolean extended;
+
+    /** extended = false reproduces upstream's shapes (no constants, offsets, custom values or big-endian). */
+    SchemaGen(TestCase tc, boolean extended) {
+        this.tc = tc;
+        this.extended = extended;
+        this.bigEndian = extended && chance(tc, 30);
+    }
+
+    Schema schema() {
+        StringBuilder body = new StringBuilder();
+        // draw the message first so the types it needs exist; sinceVersion/deprecated fix the schema version
+        message(body, "TestMessage", 1, MAX_GROUP_DEPTH);
+        if (extended && chance(tc, 20)) {
+            message(body, "OtherMessage", 2, 1);
+        }
+        StringBuilder xml = new StringBuilder();
+        xml.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
+        xml.append("<sbe:messageSchema xmlns:sbe=\"http://fixprotocol.io/2016/sbe\" package=\"").append(PACKAGE)
+            .append("\" id=\"42\" version=\"").append(version).append('"');
+        if (bigEndian) {
+            xml.append(" byteOrder=\"bigEndian\"");
+        }
+        if (extended && chance(tc, 30)) {
+            xml.append(" semanticVersion=\"").append(pick(tc, "1.0", "5.2.1", "FIX.5.0SP2")).append('"');
+        }
+        if (extended && chance(tc, 20)) {
+            xml.append(" description=\"").append(text()).append('"');
+        }
+        xml.append(">\n  <types>\n");
+        xml.append("    <composite name=\"messageHeader\">\n");
+        xml.append("      <type name=\"blockLength\" primitiveType=\"uint16\"/>\n");
+        xml.append("      <type name=\"templateId\" primitiveType=\"uint16\"/>\n");
+        xml.append("      <type name=\"schemaId\" primitiveType=\"uint16\"/>\n");
+        xml.append("      <type name=\"version\" primitiveType=\"uint16\"/>\n");
+        xml.append("    </composite>\n");
+        xml.append("    <composite name=\"groupSizeEncoding\">\n");
+        xml.append("      <type name=\"blockLength\" primitiveType=\"uint16\"/>\n");
+        xml.append("      <type name=\"numInGroup\" primitiveType=\"uint16\"/>\n");
+        xml.append("    </composite>\n");
+        for (String gs : groupSizes) {
+            String numType = gs.substring("groupSize".length());
+            xml.append("    <composite name=\"").append(gs).append("\">\n");
+            xml.append("      <type name=\"blockLength\" primitiveType=\"uint16\"/>\n");
+            xml.append("      <type name=\"numInGroup\" primitiveType=\"").append(numType).append("\"/>\n");
+            xml.append("    </composite>\n");
+        }
+        xml.append(types);
+        xml.append("  </types>\n");
+        xml.append(body);
+        xml.append("</sbe:messageSchema>\n");
+        return new Schema(xml.toString(), version, bigEndian, hasConstants, hasOffsets);
+    }
+
+    // ------------------------------------------------------------------ messages
+
+    private void message(StringBuilder out, String name, int id, int groupDepth) {
+        StringBuilder members = new StringBuilder();
+        int blockLength = members(members, "    ", groupDepth, true);
+        out.append("  <sbe:message name=\"").append(name).append("\" id=\"").append(id).append('"');
+        if (extended && chance(tc, 15)) {
+            hasOffsets = true;
+            out.append(" blockLength=\"").append(blockLength + n(tc, 0, 8)).append('"');
+        }
+        if (extended && chance(tc, 15)) {
+            out.append(" semanticType=\"").append(pick(tc, "Order", "Quote", "8")).append('"');
+        }
+        if (extended && chance(tc, 15)) {
+            out.append(" description=\"").append(text()).append('"');
+        }
+        out.append(">\n").append(members).append("  </sbe:message>\n");
+    }
+
+    /** Fields, then groups, then data; returns the block length (the fields' extent). */
+    private int members(StringBuilder out, String indent, int groupDepth, boolean isMessage) {
+        int offset = 0;
+        int fieldCount = chance(tc, 30) ? n(tc, 0, 2) : n(tc, 0, isMessage ? 10 : 5);
+        List<Integer> sinceVersions = new ArrayList<>();
+        for (int i = 0; i < fieldCount; i++) {
+            int since = chance(tc, 25) ? pick(tc, 1, 2) : 0;
+            sinceVersions.add(since);
+        }
+        // fields added in later versions come last (the parser requires ascending sinceVersion)
+        sinceVersions.sort(null);
+        for (int since : sinceVersions) {
+            offset = field(out, indent, offset, since);
+        }
+        int groupCount = groupDepth > 0 && chance(tc, isMessage ? 60 : 40) ? n(tc, 1, 3) : 0;
+        for (int i = 0; i < groupCount; i++) {
+            group(out, indent, groupDepth - 1);
+        }
+        int dataCount = chance(tc, 50) ? 0 : n(tc, 1, 3);
+        int dataSince = 0;
+        for (int i = 0; i < dataCount; i++) {
+            if (isMessage) {
+                dataSince = Math.max(dataSince, chance(tc, 25) ? pick(tc, 1, 2) : 0);
+            }
+            data(out, indent, dataSince);
+        }
+        return offset;
+    }
+
+    private int field(StringBuilder out, String indent, int offset, int since) {
+        int id = nextMember++;
+        String name = memberName(id);
+        boolean constant = extended && chance(tc, 12);
+        Type type;
+        String valueRef = null;
+        if (constant && !enums.isEmpty() && chance(tc, 50)) {
+            type = pick(tc, enums.toArray(new Type[0]));
+            valueRef = type.name() + "." + pick(tc, type.enumValues().toArray(new String[0]));
+        } else if (constant) {
+            type = constantType();
+        } else {
+            type = type(MAX_COMPOSITE_DEPTH);
+        }
+        out.append(indent).append("<field name=\"").append(name).append("\" id=\"").append(id).append("\" type=\"").append(type.name()).append('"');
+        if (constant) {
+            hasConstants = true;
+            out.append(" presence=\"constant\"");
+            if (valueRef != null) {
+                out.append(" valueRef=\"").append(valueRef).append('"');
+            }
+        } else if (since > 0) {
+            out.append(" presence=\"optional\"");
+        } else if (chance(tc, 40)) {
+            out.append(" presence=\"").append(pick(tc, "required", "optional")).append('"');
+        }
+        if (!constant && extended && chance(tc, 15)) {
+            hasOffsets = true;
+            offset += n(tc, 1, 4);
+            out.append(" offset=\"").append(offset).append('"');
+        }
+        if (since > 0) {
+            version = Math.max(version, since);
+            out.append(" sinceVersion=\"").append(since).append('"');
+            if (extended && chance(tc, 30)) {
+                int deprecated = since + n(tc, 1, 2);
+                version = Math.max(version, deprecated);
+                out.append(" deprecated=\"").append(deprecated).append('"');
+            }
+        } else if (extended && chance(tc, 10)) {
+            int deprecated = n(tc, 1, 3);
+            version = Math.max(version, deprecated);
+            out.append(" deprecated=\"").append(deprecated).append('"');
+        }
+        if (extended && chance(tc, 10)) {
+            out.append(" description=\"").append(text()).append('"');
+        }
+        out.append("/>\n");
+        return constant ? offset : offset + type.size();
+    }
+
+    private void group(StringBuilder out, String indent, int depth) {
+        int id = nextMember++;
+        out.append(indent).append("<group name=\"").append(groupName(id)).append("\" id=\"").append(id).append('"');
+        if (extended && chance(tc, 30)) {
+            String gs = "groupSize" + pick(tc, "uint8", "uint16");
+            groupSizes.add(gs);
+            out.append(" dimensionType=\"").append(gs).append('"');
+        }
+        if (extended && chance(tc, 15)) {
+            int since = pick(tc, 1, 2);
+            version = Math.max(version, since);
+            out.append(" sinceVersion=\"").append(since).append('"');
+        }
+        if (extended && chance(tc, 10)) {
+            out.append(" description=\"").append(text()).append('"');
+        }
+        out.append(">\n");
+        StringBuilder members = new StringBuilder();
+        int blockLength = members(members, indent + "  ", depth, false);
+        if (extended && chance(tc, 15)) {
+            hasOffsets = true;
+            // the blockLength attribute is set after the members are known: rebuild the opening tag
+            int close = out.lastIndexOf(">\n");
+            out.insert(close, " blockLength=\"" + (blockLength + n(tc, 0, 4)) + "\"");
+        }
+        out.append(members);
+        out.append(indent).append("</group>\n");
+    }
+
+    private void data(StringBuilder out, String indent, int since) {
+        int id = nextMember++;
+        String lengthType = pick(tc, "uint8", "uint16", "uint32");
+        String encoding = extended ? pick(tc, "US-ASCII", "US-ASCII", "UTF-8", "") : pick(tc, "US-ASCII", "");
+        String typeName = "Type" + nextType++;
+        types.append("    <composite name=\"").append(typeName).append("\">\n");
+        types.append("      <type name=\"length\" primitiveType=\"").append(lengthType).append('"');
+        if (lengthType.equals("uint32") || (extended && chance(tc, 30))) {
+            types.append(" maxValue=\"").append(lengthType.equals("uint8") ? n(tc, 1, 254) : n(tc, 1, 1000)).append('"');
+        }
+        types.append("/>\n");
+        types.append("      <type name=\"varData\" primitiveType=\"uint8\" length=\"0\"");
+        if (!encoding.isEmpty()) {
+            types.append(" characterEncoding=\"").append(encoding).append('"');
+        }
+        types.append("/>\n    </composite>\n");
+        out.append(indent).append("<data name=\"").append(memberName(id)).append("\" id=\"").append(id).append("\" type=\"").append(typeName).append('"');
+        if (since > 0) {
+            version = Math.max(version, since);
+            out.append(" sinceVersion=\"").append(since).append('"');
+        }
+        out.append("/>\n");
+    }
+
+    // ------------------------------------------------------------------ types
+
+    private Type type(int depth) {
+        List<Type> pooled = pool.computeIfAbsent(depth, d -> new ArrayList<>());
+        if (!pooled.isEmpty() && chance(tc, 25)) {
+            return pick(tc, pooled.toArray(new Type[0]));
+        }
+        Type t;
+        switch (n(tc, 0, depth > 1 ? 3 : 2)) {
+            case 0 -> t = encodedType(false);
+            case 1 -> t = enumType();
+            case 2 -> t = setType();
+            default -> t = compositeType(depth);
+        }
+        pooled.add(t);
+        return t;
+    }
+
+    private String value(PrimitiveType pt, long v) {
+        return pt == PrimitiveType.CHAR ? String.valueOf((char) v) : Long.toString(v);
+    }
+
+    /** As value(), escaped for an XML attribute. */
+    private String xmlValue(PrimitiveType pt, long v) {
+        return value(pt, v).replace("&", "&amp;").replace("<", "&lt;").replace("\"", "&quot;");
+    }
+
+    private long draw(long lo, long hi) {
+        return tc.draw(dev.hegel.Generators.longs().min(lo).max(hi));
+    }
+
+    /** A {@code <type>} with random presence, length and (extended) custom range or null value. */
+    private Type encodedType(boolean forceConstant) {
+        PrimitiveType pt = pick(tc, PrimitiveType.values());
+        int length = pick(tc, 1, 1, 1, 2, 13);
+        String name = "Type" + nextType++;
+        StringBuilder t = new StringBuilder();
+        t.append("    <type name=\"").append(name).append("\" primitiveType=\"").append(pt.primitiveName()).append('"');
+        if (length > 1) {
+            t.append(" length=\"").append(length).append('"');
+        }
+        boolean constant = forceConstant;
+        boolean integral = pt != PrimitiveType.FLOAT && pt != PrimitiveType.DOUBLE;
+        boolean customRange = !constant && extended && integral && chance(tc, 25);
+        boolean customNull = !constant && extended && integral && (customRange ? chance(tc, 40) : chance(tc, 10));
+        if (constant) {
+            t.append(" presence=\"constant\"");
+        } else if (customNull) {
+            t.append(" presence=\"optional\"");
+        } else if (chance(tc, 60)) {
+            t.append(" presence=\"").append(pick(tc, "required", "optional")).append('"');
+        }
+        if (customRange) {
+            long[] range = defaultRange(pt);
+            long a = draw(range[0], range[1]);
+            long b = draw(range[0], range[1]);
+            long lo = Math.min(a, b);
+            long hi = Math.max(a, b);
+            if (pt == PrimitiveType.CHAR) {
+                lo = Math.max(lo, 0x21);
+                hi = Math.max(hi, lo);
+            }
+            t.append(" minValue=\"").append(xmlValue(pt, lo)).append("\" maxValue=\"").append(xmlValue(pt, hi)).append('"');
+            if (customNull) {
+                // a null value outside the custom range (a printable character for char)
+                long nul = chance(tc, 50) && lo > range[0] ? draw(range[0], lo - 1) : (hi < range[1] ? draw(hi + 1, range[1]) : defaultNull(pt));
+                if (pt == PrimitiveType.CHAR && (nul < 0x21 || nul > 0x7e)) {
+                    nul = lo > 0x21 ? 0x21 : 0x7e;
+                }
+                t.append(" nullValue=\"").append(xmlValue(pt, nul)).append('"');
+            }
+        } else if (customNull) {
+            long[] range = defaultRange(pt);
+            long nul = pt == PrimitiveType.CHAR ? pick(tc, 0x7eL, 0x21L, 0x40L) : pick(tc, range[0], range[1], 0L);
+            t.append(" nullValue=\"").append(xmlValue(pt, nul)).append('"');
+        }
+        if (pt == PrimitiveType.CHAR && extended && chance(tc, 20)) {
+            t.append(" characterEncoding=\"").append(pick(tc, "US-ASCII", "ASCII", "UTF-8")).append('"');
+        }
+        if (extended && chance(tc, 10)) {
+            t.append(" semanticType=\"").append(pick(tc, "int", "Qty", "UTCTimestamp")).append('"');
+        }
+        if (extended && chance(tc, 10)) {
+            t.append(" description=\"").append(text()).append('"');
+        }
+        if (constant) {
+            t.append('>').append(constantValue(pt, length)).append("</type>\n");
+        } else {
+            t.append("/>\n");
+        }
+        types.append(t);
+        return new Type(name, constant ? 0 : pt.size() * length, pt, null, constant);
+    }
+
+    private Type constantType() {
+        return encodedType(true);
+    }
+
+    private String constantValue(PrimitiveType pt, int length) {
+        switch (pt) {
+            case CHAR -> {
+                if (length == 1) {
+                    return Zoo.word(tc, "ABCXYZabcxyz0123456789.-_!#$%*+/=?@", 1, 1);
+                }
+                int len = chance(tc, 30) ? n(tc, 1, length) : length;
+                return Zoo.word(tc, "ABCXYZabcxyz0123456789 .-_", len, len);
+            }
+            case FLOAT -> {
+                return pick(tc, "0.0", "1.5", "-2.25", "3.4028235E38", "1.0E-10");
+            }
+            case DOUBLE -> {
+                return pick(tc, "0.0", "1.5", "-2.25", "1.7976931348623157E308", "4.9E-324");
+            }
+            default -> {
+                long[] range = defaultRange(pt);
+                return Long.toString(chance(tc, 40) ? pick(tc, range[0], range[1], 0L, 1L) : draw(range[0], range[1]));
+            }
+        }
+    }
+
+    /** The valid range of the primitive with default null value: SBE's defaults. */
+    static long[] defaultRange(PrimitiveType pt) {
+        return switch (pt) {
+            case CHAR -> new long[] {0x20, 0x7e};
+            case INT8 -> new long[] {-127, 127};
+            case UINT8 -> new long[] {0, 254};
+            case INT16 -> new long[] {-32767, 32767};
+            case UINT16 -> new long[] {0, 65534};
+            case INT32 -> new long[] {Integer.MIN_VALUE + 1, Integer.MAX_VALUE};
+            case UINT32 -> new long[] {0, 0xFFFF_FFFEL};
+            case INT64 -> new long[] {Long.MIN_VALUE + 1, Long.MAX_VALUE};
+            case UINT64 -> new long[] {0, Long.MAX_VALUE};
+            default -> new long[] {0, 0};
+        };
+    }
+
+    static long defaultNull(PrimitiveType pt) {
+        return switch (pt) {
+            case CHAR -> 0;
+            case INT8 -> -128;
+            case UINT8 -> 255;
+            case INT16 -> -32768;
+            case UINT16 -> 65535;
+            case INT32 -> Integer.MIN_VALUE;
+            case UINT32 -> 0xFFFF_FFFFL;
+            case INT64 -> Long.MIN_VALUE;
+            case UINT64 -> -1L;
+            default -> 0;
+        };
+    }
+
+    private Type enumType() {
+        String name = "Type" + nextType++;
+        String encodingType;
+        List<String> values = new ArrayList<>();
+        Set<String> seen = new LinkedHashSet<>();
+        if (chance(tc, 50)) {
+            encodingType = "char";
+            int count = n(tc, 1, 10);
+            for (int i = 0; i < count; i++) {
+                seen.add(String.valueOf((char) ('A' + n(tc, 0, 25))));
+            }
+        } else {
+            encodingType = extended ? pick(tc, "uint8", "uint8", "int8", "uint16", "int16", "int32") : "uint8";
+            long[] range = defaultRange(PrimitiveType.get(encodingType));
+            int count = n(tc, 1, 12);
+            for (int i = 0; i < count; i++) {
+                seen.add(Long.toString(draw(Math.max(range[0], -1000), Math.min(range[1], 1000))));
+            }
+        }
+        types.append("    <enum name=\"").append(name).append("\" encodingType=\"").append(encodingType).append('"');
+        if (extended && chance(tc, 15) && !encodingType.equals("char")) {
+            // an explicit null value not among the valid values
+            long nul = defaultNull(PrimitiveType.get(encodingType));
+            types.append(" nullValue=\"").append(nul).append('"');
+        }
+        types.append(">\n");
+        int i = 0;
+        for (String v : seen) {
+            String caseName = "Case" + i++;
+            values.add(caseName);
+            types.append("      <validValue name=\"").append(caseName).append('"');
+            if (extended && chance(tc, 10)) {
+                int since = pick(tc, 1, 2);
+                version = Math.max(version, since);
+                types.append(" sinceVersion=\"").append(since).append('"');
+            }
+            if (extended && chance(tc, 10)) {
+                types.append(" description=\"").append(text()).append('"');
+            }
+            types.append('>').append(v).append("</validValue>\n");
+        }
+        types.append("    </enum>\n");
+        Type t = new Type(name, PrimitiveType.get(encodingType).size(), PrimitiveType.get(encodingType), values, false);
+        enums.add(t);
+        return t;
+    }
+
+    private Type setType() {
+        int bits = pick(tc, 8, 16, 32, 64);
+        String name = "Type" + nextType++;
+        Set<Integer> choices = new LinkedHashSet<>();
+        int count = n(tc, 0, Math.min(bits, 8));
+        for (int i = 0; i < count; i++) {
+            choices.add(n(tc, 0, bits - 1));
+        }
+        types.append("    <set name=\"").append(name).append("\" encodingType=\"uint").append(bits).append("\">\n");
+        for (int c : choices) {
+            types.append("      <choice name=\"option").append(c).append('"');
+            if (extended && chance(tc, 10)) {
+                int since = pick(tc, 1, 2);
+                version = Math.max(version, since);
+                types.append(" sinceVersion=\"").append(since).append('"');
+            }
+            types.append('>').append(c).append("</choice>\n");
+        }
+        types.append("    </set>\n");
+        return new Type(name, bits / 8, PrimitiveType.get("uint" + bits), null, false);
+    }
+
+    private Type compositeType(int depth) {
+        String name = "Type" + nextType++;
+        StringBuilder c = new StringBuilder();
+        c.append("    <composite name=\"").append(name).append('"');
+        if (extended && chance(tc, 10)) {
+            c.append(" description=\"").append(text()).append('"');
+        }
+        c.append(">\n");
+        int count = n(tc, 1, 3);
+        int offset = 0;
+        List<Type> members = new ArrayList<>();
+        for (int i = 0; i < count; i++) {
+            members.add(type(depth - 1));
+        }
+        if (chance(tc, 30)) {
+            members.add(n(tc, 0, members.size()), pick(tc, members.toArray(new Type[0])));
+        }
+        if (extended && chance(tc, 15)) {
+            members.add(n(tc, 0, members.size()), constantType());
+        }
+        int i = 0;
+        for (Type m : members) {
+            String memberName = "member" + i++ + "Of" + m.name();
+            c.append("      <ref name=\"").append(memberName).append("\" type=\"").append(m.name()).append('"');
+            if (!m.constant() && extended && chance(tc, 15)) {
+                hasOffsets = true;
+                offset += n(tc, 1, 4);
+                c.append(" offset=\"").append(offset).append('"');
+            }
+            if (extended && chance(tc, 10)) {
+                int since = pick(tc, 1, 2);
+                version = Math.max(version, since);
+                c.append(" sinceVersion=\"").append(since).append('"');
+            }
+            c.append("/>\n");
+            offset += m.size();
+        }
+        c.append("    </composite>\n");
+        types.append(c);
+        hasConstants |= members.stream().anyMatch(Type::constant);
+        return new Type(name, offset, null, null, false);
+    }
+
+    // ------------------------------------------------------------------ names and text
+
+    private static final String[] TRICKY_NAMES = {
+        "value", "type", "name", "id", "length", "offset", "version", "count", "index", "data", "header", "limit",
+        "encodedLength", "sbeSchemaId", "blockLength", "wrap", "buffer", "string", "object", "record", "var",
+        "Int", "Class", "Enum", "Set", "Group", "Field", "select", "match", "package", "import", "self", "super",
+    };
+
+    /** A group name; never "type<id>", which the Java generator turns into a nested class shadowing "Type<id>" (bug sbe/6). */
+    private String groupName(int id) {
+        String name = memberName(id);
+        return name.startsWith("type") ? "member" + id : name;
+    }
+
+    private String memberName(int id) {
+        if (extended && chance(tc, 8)) {
+            return pick(tc, TRICKY_NAMES) + id;
+        }
+        return "member" + id;
+    }
+
+    private String text() {
+        return Zoo.word(tc, "abc XYZ09-_.,:;!?()'", 1, 24).replace("<", "(").replace("&", "+").replace("\"", "'");
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..1fea939
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,114 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
