+    /** For every set type of the schema, the generated Go RawValue() reads the set's width: one byte, or through the Uint<bits> helper. */
+    static void goRawValues(Schema schema) {
+        String xml = schema.xml();
+        Ir ir;
+        try {
+            ir = SbeGen.ir(xml);
+        } catch (Exception e) {
+            throw control(e, "the written schema does not parse: " + e + "\n" + xml);
+        }
+        MemoryOutput om = new MemoryOutput();
+        try {
+            new GolangFlyweightGenerator(ir, false, om).generate();
+        } catch (Exception e) {
+            fail("the Go (flyweight) generator failed: " + e + "\n" + xml);
+            return;
+        }
+        for (List<Token> type : ir.types()) {
+            Token t = type.get(0);
+            int bits = t.encoding().primitiveType() == null ? 0 : t.encoding().primitiveType().size() * 8;
+            // under HEGEL_NO_KNOWN only one-byte sets are judged (bug sbe/5: a wider set's RawValue() reads its first byte)
+            if (t.signal() != Signal.BEGIN_SET || (Zoo.NO_KNOWN && bits > 8)) {
+                continue;
+            }
+            // (the file is named after the type, or after a composite member's name with its first letter upper-cased)
+            String typeName = t.applicableTypeName();
+            String source = String.valueOf(om.files.getOrDefault(typeName, om.files.get(Character.toUpperCase(typeName.charAt(0)) + typeName.substring(1))));
+            int at = source.indexOf("RawValue()");
+            check(at >= 0, () -> "no RawValue() in the generated " + typeName + ".go:\n" + source);
+            if (at < 0) {
+                continue;
+            }
+            String body = source.substring(at, source.indexOf('}', at) + 1);
+            check(bits == 8 || body.contains("Uint" + bits), () -> "RawValue() of the uint" + bits + " set " + t.name() + " reads a single byte:\n" + body + "\n" + xml);
+        }
+    }
