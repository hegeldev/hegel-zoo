+    /** Upstream's ParserPropertyTest, plus: the IR survives its own binary encoding. */
+    @Test
+    void schemasParseAndIrRoundTrips() {
+        Hegel.test(tc -> guard(() -> {
+            SchemaGen.Schema schema = new SchemaGen(tc, chance(tc, 70)).schema();
+            String xml = schema.xml();
+            Ir ir;
+            try {
