+    /** The checks of the evolution oracle: upstream's transformer against the pruned schema, the current printer on the old message, the current DTO on it. */
+    enum Route { TRANSFORMER, PRINTER, DTO }
+
+    /** The evolution oracle on the case's message encoded at an older version, running the given checks. */
+    static void evolves(TestCase tc, EvolutionCase c, Set<Route> routes) {
+        Schema schema = c.schema();
+        uk.co.real_logic.sbe.xml.MessageSchema parsed;
+        Ir newIr;
+        try {
+            parsed = SbeGen.parse(schema.xml(), true);
+            newIr = new uk.co.real_logic.sbe.xml.IrGenerator().generate(parsed);
+        } catch (Exception e) {
+            throw control(e, "the written schema does not parse: " + e + "\n" + schema.xml());
+        }
+        // composite members added after the acting version cannot be expressed in the older schema's XML (the parser
+        // rejects sinceVersion above the schema version), so the acting version keeps every composite member present;
+        // under HEGEL_NO_KNOWN it keeps every composite field present too, since the printer and the DTO read a
+        // composite field added later from the buffer anyway (bugs sbe/3 and sbe/4)
+        int minV = minimumActingVersion(parsed, newIr, Zoo.NO_KNOWN);
+        int v = c.acting() == BEFORE_LATEST ? SchemaGen.LATEST - 1 : minV + Math.floorMod(c.acting(), Math.max(1, schema.version() - minV));
+        // (a composite field added in the schema's latest version leaves no older version to encode at)
+        tc.assume(minV <= v && v <= schema.version() - 1);
+        Ir oldIr;
+        Ir transformed;
+        SbeGen.Msg msg;
+        try {
+            // the schema as of version v: the model prunes the XML itself, since upstream's transformer loses the
+            // block lengths of groups (bug sbe/7); the two must agree
+            String oldXml = olderSchema(schema.xml(), v);
+            oldIr = SbeGen.ir(oldXml);
+            transformed = new uk.co.real_logic.sbe.xml.IrGenerator().generate(
+                new uk.co.real_logic.sbe.xml.SchemaTransformerFactory("*:" + v).transform(parsed));
+            msg = SbeGen.encode(oldXml, oldIr, 1, c.values(), true);
+        } catch (Exception e) {
+            throw control(e, "schema transformation to an older version failed: " + e + "\n" + schema.xml());
+        }
+        // (the transformer keeps valid values and choices newer than v, which the pruned XML cannot)
+        boolean newerValues = java.util.regex.Pattern.compile("<(validValue|choice) [^>]*sinceVersion=\"(\\d+)\"")
+            .matcher(schema.xml()).results().anyMatch(m -> Integer.parseInt(m.group(2)) > v);
+        // the transformer zeroes every group's block length and keeps the groups' and var data's original offsets
+        // (bug sbe/7): under HEGEL_NO_KNOWN only messages without groups are compared, with the offsets masked
+        boolean groups = newIr.getMessage(1).stream().anyMatch(t -> t.signal() == Signal.BEGIN_GROUP);
+        if (routes.contains(Route.TRANSFORMER) && !newerValues && !(Zoo.NO_KNOWN && groups)) {
+            String mine = transformerText(oldIr.getMessage(1));
+            String theirs = transformerText(transformed.getMessage(1));
+            check(theirs.equals(mine),
+                () -> "SchemaTransformerFactory(\"*:" + v + "\") differs from pruning the XML to version " + v + ":\n"
+                    + firstDifference(mine, theirs) + "\n" + schema.xml());
+        }
+        check(oldIr.version() == v, () -> "the schema transformed to version " + v + " has IR version " + oldIr.version());
+        check(msg.headerVersion() == v, () -> "header version " + msg.headerVersion() + " for a version-" + v + " message");
+        // expected: the old values plus the defaults of everything added after version v, as the printer shows them
+        // and as the current DTO re-encodes them
+        JSONObject expected = new JSONObject(msg.expected.toString());
+        addDefaults(newIr.getMessage(1), 1, newIr.getMessage(1).size() - 1, v, expected, false);
+        JSONObject expectedDto = new JSONObject(msg.expected.toString());
+        addDefaults(newIr.getMessage(1), 1, newIr.getMessage(1).size() - 1, v, expectedDto, true);
+        JsonPrinter printer = new JsonPrinter(newIr);
+        if (routes.contains(Route.PRINTER)) {
+            StringBuilder out = new StringBuilder();
+            String text;
+            try {
+                printer.print(out, new UnsafeBuffer(olderBytes(msg, newIr)), 0);
+                text = out.toString();
+            } catch (RuntimeException e) {
+                fail("JsonPrinter of the current schema threw on a version-" + v + " message: " + e + "\n" + schema.xml() + "\nold values: " + msg.expected);
+                return;
+            }
+            JSONObject parsed2;
+            try {
+                parsed2 = new JSONObject(text);
+            } catch (JSONException e) {
+                fail("JsonPrinter output for a version-" + v + " message is not JSON: " + e.getMessage() + "\n" + text + "\n" + schema.xml());
+                return;
+            }
+            check(parsed2.similar(expected), () -> "JsonPrinter of the current schema shows a version-" + v + " message differently from its values:\n" + jsonDifference(expected, parsed2) + "\nprinted:\n" + text + "\nexpected:\n" + expected.toString(2) + "\n" + schema.xml());
+        }
+        if (!routes.contains(Route.DTO)) {
+            return;
+        }
+        // the current codecs' DTO decodes it and re-encodes it as a current-version message with the same values
+        RecordingOutput om = new RecordingOutput();
+        Class<?> dtoClass;
+        try {
+            new JavaGenerator(newIr, SbeTool.JAVA_DEFAULT_ENCODING_BUFFER_TYPE, SbeTool.JAVA_DEFAULT_DECODING_BUFFER_TYPE,
+                false, false, false, false, PrecedenceChecks.newInstance(new PrecedenceChecks.Context()), om).generate();
+            new JavaDtoGenerator(newIr, false, om).generate();
+            dtoClass = om.compileAndLoad(SbeGen.PACKAGE + ".TestMessageDto");
+        } catch (Exception e) {
+            fail("Java code generation/compilation failed: " + e + "\n" + schema.xml());
+            return;
+        }
+        if (dtoClass == null) {
+            fail("generated Java code does not compile\n" + schema.xml() + "\n" + abbreviate(om.dump(), 6000));
+            return;
+        }
+        try {
+            Method decodeFrom = dtoClass.getMethod("decodeFrom", DirectBuffer.class, int.class, int.class, int.class);
+            Method encodeWith = dtoClass.getMethod("encodeWithHeaderWith", dtoClass, MutableDirectBuffer.class, int.class);
+            Object dto = decodeFrom.invoke(null, msg.buffer, MessageHeaderDecoder.ENCODED_LENGTH, msg.headerBlockLength(), msg.headerVersion());
+            ExpandableArrayBuffer outBuf = new ExpandableArrayBuffer(Math.max(64, msg.length));
+            int outLength = (int) encodeWith.invoke(null, dto, outBuf, 0);
+            String reprinted = printer.print(ByteBuffer.wrap(Arrays.copyOf(outBuf.byteArray(), outLength + padding())));
+            JSONObject reparsed = new JSONObject(reprinted);
+            check(reparsed.similar(expectedDto), () -> "a version-" + v + " message decoded by the current DTO and re-encoded prints differently:\n" + jsonDifference(expectedDto, reparsed) + "\nreprinted:\n" + reprinted + "\nexpected:\n" + expectedDto.toString(2) + "\n" + schema.xml());
+        } catch (ReflectiveOperationException e) {
+            Throwable cause = e.getCause() != null ? e.getCause() : e;
+            fail("current DTO on a version-" + v + " message threw: " + cause + "\n" + schema.xml() + "\nold values: " + msg.expected);
+        } catch (JSONException e) {
+            fail("re-encoded version-" + v + " message does not print as JSON: " + e.getMessage() + "\n" + schema.xml());
+        } catch (RuntimeException e) {
+            throw control(e, "re-encoding a version-" + v + " message through the current DTO failed: " + e + "\n" + schema.xml());
+        }
+    }
+
+    /** The drawn message encoded at the schema's version (irSets: trusting the IR's set tokens, see SbeGen.encode); a finding when the schema does not parse. */
+    static SbeGen.Msg encode(MsgCase c, boolean nullTerminates, boolean irSets) {
+        try {
+            String xml = c.schema().xml();
+            return SbeGen.encode(xml, SbeGen.ir(xml), 1, c.values(), nullTerminates, irSets);
+        } catch (Exception e) {
+            throw control(e, "schema/encoding failed: " + e);
+        }
+    }
+
+    /**
+     * The oldest version at which every member of every composite type of the schema is present (asked of the parsed
+     * schema: the IR's member tokens carry their field's version too) and, when compositeFields, every composite field
+     * of message 1.
+     */
+    static int minimumActingVersion(uk.co.real_logic.sbe.xml.MessageSchema schema, Ir ir, boolean compositeFields) {
+        int minV = 0;
+        for (uk.co.real_logic.sbe.xml.Type type : schema.types()) {
+            minV = Math.max(minV, memberVersions(type));
+        }
+        List<Token> tokens = ir.getMessage(1);
+        for (int i = 1; compositeFields && i < tokens.size() - 1; i++) {
+            if (tokens.get(i).signal() == Signal.BEGIN_FIELD && tokens.get(i + 1).signal() == Signal.BEGIN_COMPOSITE) {
+                minV = Math.max(minV, tokens.get(i).version());
+            }
+        }
+        return minV;
+    }
+
+    /** The latest sinceVersion of the members of a composite type, at every depth (0 for other types). */
+    static int memberVersions(uk.co.real_logic.sbe.xml.Type type) {
+        int v = 0;
+        if (type instanceof uk.co.real_logic.sbe.xml.CompositeType composite) {
+            for (uk.co.real_logic.sbe.xml.Type member : composite.getTypeList()) {
+                v = Math.max(v, Math.max(member.sinceVersion(), memberVersions(member)));
+            }
+        }
+        return v;
+    }
+
+    /** Token text for comparing with upstream's transformer; under HEGEL_NO_KNOWN without the offsets, which the transformer leaves as the original layout's for groups and var data (bug sbe/7). */
+    static String transformerText(List<Token> tokens) {
+        String text = tokensText(tokens);
+        return Zoo.NO_KNOWN ? text.replaceAll("offset=\\d+", "offset=?") : text;
+    }
+
+    /** The schema XML as of version v: members (fields, groups, var data) added later removed, version set to v. */
+    static String olderSchema(String xml, int v) throws Exception {
+        org.w3c.dom.Document doc = javax.xml.parsers.DocumentBuilderFactory.newInstance().newDocumentBuilder()
+            .parse(new org.xml.sax.InputSource(new java.io.StringReader(xml)));
+        org.w3c.dom.Element root = doc.getDocumentElement();
+        root.setAttribute("version", Integer.toString(v));
+        java.util.Set<String> referenced = new java.util.HashSet<>();
+        java.util.regex.Matcher m = java.util.regex.Pattern.compile("valueRef=\"([^\"]+)\"").matcher(xml);
+        while (m.find()) {
+            referenced.add(m.group(1));
+        }
+        prune(root, v, referenced);
+        java.io.StringWriter w = new java.io.StringWriter();
+        javax.xml.transform.TransformerFactory.newInstance().newTransformer().transform(
+            new javax.xml.transform.dom.DOMSource(doc), new javax.xml.transform.stream.StreamResult(w));
+        return w.toString();
+    }
+
+    private static void prune(org.w3c.dom.Element e, int v, java.util.Set<String> referenced) {
+        List<org.w3c.dom.Element> gone = new ArrayList<>();
+        org.w3c.dom.NodeList kids = e.getChildNodes();
+        for (int i = 0; i < kids.getLength(); i++) {
+            if (kids.item(i) instanceof org.w3c.dom.Element k) {
+                String name = k.getNodeName();
+                String since = k.getAttribute("sinceVersion");
+                // members added later go; so do valid values and choices (never written for version v anyway)
+                boolean member = name.equals("field") || name.equals("group") || name.equals("data")
+                    || name.equals("validValue") || name.equals("choice");
+                // a valid value a constant field refers to must stay (clamped below)
+                if (name.equals("validValue") && referenced.contains(e.getAttribute("name") + "." + k.getAttribute("name"))) {
+                    member = false;
+                }
+                if (member && !since.isEmpty() && Integer.parseInt(since) > v) {
+                    gone.add(k);
+                } else {
+                    if (!since.isEmpty() && Integer.parseInt(since) > v) {
+                        // a composite member (or type) newer than v: the parser rejects sinceVersion above the schema
+                        // version; message 1 never uses such members (see the acting version choice), so clamp
+                        k.setAttribute("sinceVersion", Integer.toString(v));
+                    }
+                    prune(k, v, referenced);
+                }
+            }
+        }
+        for (org.w3c.dom.Element k : gone) {
+            e.removeChild(k);
+        }
+    }
+
+    /** The zero bytes after a message as printed: none; eight under HEGEL_NO_KNOWN, since the printer reads past a trailing constant enum field (bug sbe/10). */
+    static int padding() {
+        return Zoo.NO_KNOWN ? 8 : 0;
+    }
+
+    /** The message as printed: in a buffer of exactly its length, or padded (see {@link #padding}). */
+    static byte[] paddedBytes(SbeGen.Msg msg) {
+        return Arrays.copyOf(msg.bytes(), msg.length + padding());
+    }
+
+    static UnsafeBuffer padded(SbeGen.Msg msg) {
+        return new UnsafeBuffer(paddedBytes(msg));
+    }
+
+    /**
+     * An older message as printed with the current schema: exactly its bytes; under HEGEL_NO_KNOWN padded to the
+     * current schema's block length plus eight, since the printer reads a constant enum field at its offset in the
+     * current schema, which can lie well past an older message's block (bug sbe/10).
+     */
+    static byte[] olderBytes(SbeGen.Msg msg, Ir newIr) {
+        if (!Zoo.NO_KNOWN) {
+            return msg.bytes();
+        }
+        int newBlock = MessageHeaderDecoder.ENCODED_LENGTH + newIr.getMessage(1).get(0).encodedLength();
+        return Arrays.copyOf(msg.bytes(), Math.max(msg.length, newBlock) + padding());
+    }
+
+    /** Every choice of the set token at typeIdx mapped to flag. */
+    static JSONObject allChoices(List<Token> tokens, int typeIdx, Token type, boolean flag) {
+        JSONObject flags = new JSONObject();
+        for (int i = typeIdx + 1; i < typeIdx + type.componentTokenCount() - 1; i++) {
+            if (tokens.get(i).signal() == Signal.CHOICE) {
+                flags.put(tokens.get(i).name(), flag);
+            }
+        }
+        return flags;
+    }
+
+    /** Adds the choices newer than v (which an older message's set cannot have) as false; recurses into composites. */
+    static void fillChoices(List<Token> tokens, int typeIdx, Token type, int v, Object value) {
+        if (type.signal() == Signal.BEGIN_SET && value instanceof JSONObject flags) {
+            for (int i = typeIdx + 1; i < typeIdx + type.componentTokenCount() - 1; i++) {
+                Token c = tokens.get(i);
+                if (c.signal() == Signal.CHOICE && c.version() > v && !flags.has(c.name())) {
+                    flags.put(c.name(), false);
+                }
+            }
+        } else if (type.signal() == Signal.BEGIN_COMPOSITE && value instanceof JSONObject members) {
+            int i = typeIdx + 1;
+            int end = typeIdx + type.componentTokenCount() - 1;
+            while (i < end) {
+                Token m = tokens.get(i);
+                fillChoices(tokens, i, m, v, members.opt(m.name()));
+                i += m.componentTokenCount();
+            }
+        }
+    }
+
+    /**
+     * Adds to obj (the values of an older message) what the current tokens define after version v: as the printer
+     * shows a not-present member (dto = false), or as the printer shows what the current DTO re-encodes for it (dto =
+     * true). Under HEGEL_NO_KNOWN the recorded renderings are expected instead (bugs sbe/8 and sbe/9).
+     */
+    static void addDefaults(List<Token> tokens, int from, int endIdx, int v, JSONObject obj, boolean dto) {
+        int i = from;
+        while (i <= endIdx) {
+            Token t = tokens.get(i);
+            int next = i + t.componentTokenCount();
+            switch (t.signal()) {
+                case BEGIN_FIELD -> {
+                    Token type = tokens.get(i + 1);
+                    if (obj.has(t.name())) {
+                        fillChoices(tokens, i + 1, type, v, obj.opt(t.name()));
+                    } else if (t.version() > v) {
+                        Object value = t.isConstantEncoding() ? SbeGen.constantOf(t, type) : SbeGen.notPresent(tokens, i + 1, type);
+                        boolean encoded = !t.isConstantEncoding() && type.signal() == Signal.ENCODING;
+                        boolean chars = encoded && type.encoding().primitiveType() == PrimitiveType.CHAR;
+                        if (dto && chars && type.arrayLength() <= 1) {
+                            // the DTO writes the char's null value (NUL, or the type's custom nullValue), which the printer then
+                            // shows as a present character (a NUL as the escape of U+0000)
+                            value = String.valueOf((char) type.encoding().applicableNullValue().longValue());
+                        }
+                        if (dto && chars && type.arrayLength() > 1) {
+                            // the DTO's not-present char array is the empty String, re-encoded zero-padded (the printer
+                            // route shows the type's null character instead)
+                            value = "";
+                        }
+                        if (Zoo.NO_KNOWN && !dto && type.signal() == Signal.BEGIN_SET) {
+                            // the printer shows the null value (all bits) for a not-present set (bug sbe/9)
+                            value = allChoices(tokens, i + 1, type, true);
+                        }
+                        if (Zoo.NO_KNOWN && dto && encoded && !chars && type.arrayLength() > 1) {
+                            // the DTO re-encodes a not-present optional numeric array as zeros, not null values (bug sbe/8)
+                            org.json.JSONArray zeros = new org.json.JSONArray();
+                            boolean floating = type.encoding().primitiveType() == PrimitiveType.FLOAT || type.encoding().primitiveType() == PrimitiveType.DOUBLE;
+                            for (int k = 0; k < type.arrayLength(); k++) {
+                                zeros.put(floating ? (Object) 0.0d : (Object) 0L);
+                            }
+                            value = zeros;
+                        }
+                        obj.put(t.name(), value);
+                    }
+                }
+                case BEGIN_GROUP -> {
+                    if (t.version() > v) {
+                        if (!obj.has(t.name())) {
+                            obj.put(t.name(), new org.json.JSONArray());
+                        }
+                    } else {
+                        org.json.JSONArray elements = obj.optJSONArray(t.name());
+                        if (elements != null) {
+                            int dims = tokens.get(i + 1).componentTokenCount();
+                            for (int k = 0; k < elements.length(); k++) {
+                                addDefaults(tokens, i + 1 + dims, next - 2, v, elements.getJSONObject(k), dto);
+                            }
+                        }
+                    }
+                }
+                case BEGIN_VAR_DATA -> {
+                    if (t.version() > v && !obj.has(t.name())) {
+                        obj.put(t.name(), "");
+                    }
+                }
+                default -> {
+                    return;
+                }
+            }
+            i = next;
+        }
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    /** Hegel's control-flow exceptions must pass; anything else is a finding (in COLLECT mode the case ends). */
+    static RuntimeException control(Exception e, String message) {
+        if (e instanceof RuntimeException r && e.getClass().getName().startsWith("dev.hegel.")) {
+            return r;
+        }
+        fail(message);
+        return new CaseDone();
+    }
+
+    static void guard(Runnable body) {
+        try {
+            body.run();
+        } catch (CaseDone ignored) {
+            // COLLECT mode: the finding is printed, the case ends
+        }
+    }
+
+    static final class CaseDone extends RuntimeException {
+        CaseDone() {
+            super(null, null, false, false);
+        }
+    }
+
+    interface Body {
+        void run() throws Exception;
+    }
+
+    static void run(String language, String xml, Body body) {
+        try {
+            body.run();
+        } catch (Exception | StackOverflowError e) {
+            fail("the " + language + " generator failed: " + e + "\n" + xml);
+        }
+    }
+
+    /** An OutputManager keeping the generated sources in memory. */
+    static final class MemoryOutput implements OutputManager {
+        final Map<String, StringWriter> files = new LinkedHashMap<>();
+
+        @Override
+        public Writer createOutput(String name) {
+            StringWriter w = new StringWriter();
+            files.put(name, w);
+            return w;
+        }
+    }
+
+    static Map<String, CharSequence> javaSources(Ir ir, boolean groupOrder, boolean interfaces, boolean unknownEnums, boolean precedence) {
+        RecordingOutput om = new RecordingOutput();
+        try {
+            new JavaGenerator(ir, SbeTool.JAVA_DEFAULT_ENCODING_BUFFER_TYPE, SbeTool.JAVA_DEFAULT_DECODING_BUFFER_TYPE,
+                groupOrder, interfaces, unknownEnums, false,
+                PrecedenceChecks.newInstance(new PrecedenceChecks.Context().shouldGeneratePrecedenceChecks(precedence)), om).generate();
+        } catch (IOException e) {
+            throw new IllegalStateException(e);
+        }
+        return om.sources;
+    }
+
+    static final class RecordingOutput implements org.agrona.generation.DynamicPackageOutputManager {
+        final Map<String, CharSequence> sources = new TreeMap<>();
+        String pkg = SbeGen.PACKAGE;
+
+        @Override
+        public Writer createOutput(String name) {
+            String key = pkg + "." + name;
+            pkg = SbeGen.PACKAGE;
+            return new StringWriter() {
+                @Override
+                public void close() {
+                    sources.put(key, getBuffer().toString());
+                }
+            };
+        }
+
+        @Override
+        public void setPackageName(String packageName) {
+            pkg = packageName;
+        }
+
+        Class<?> compileAndLoad(String className) throws ClassNotFoundException {
+            return org.agrona.generation.CompilerUtil.compileInMemory(className, sources);
+        }
+
+        String dump() {
+            StringBuilder sb = new StringBuilder();
+            sources.forEach((name, src) -> sb.append("\n---- ").append(name).append('\n').append(src));
+            return sb.toString();
+        }
+    }
+
+    static String tokensText(List<Token> tokens) {
+        StringBuilder sb = new StringBuilder();
+        for (Token t : tokens) {
+            sb.append(t).append('\n');
+        }
+        return sb.toString();
+    }
+
+    static String firstDifference(String a, String b) {
+        int i = 0;
+        while (i < a.length() && i < b.length() && a.charAt(i) == b.charAt(i)) {
+            i++;
+        }
+        int from = Math.max(0, i - 200);
+        return "at " + i + ":\n<<< " + a.substring(from, Math.min(a.length(), i + 200)) + "\n>>> " + b.substring(from, Math.min(b.length(), i + 200));
+    }
+
+    static String bytesDifference(byte[] a, byte[] b) {
+        int i = 0;
+        while (i < a.length && i < b.length && a[i] == b[i]) {
+            i++;
+        }
+        return "lengths " + a.length + " vs " + b.length + ", first difference at byte " + i
+            + (i < a.length ? " (" + a[i] : " (end") + (i < b.length ? " vs " + b[i] + ")" : " vs end)");
+    }
+
+    static String jsonDifference(JSONObject expected, JSONObject actual) {
+        List<String> diffs = new ArrayList<>();
+        jsonDifference("", expected, actual, diffs);
+        return diffs.isEmpty() ? "(no difference found by the walker)" : String.join("\n", diffs.subList(0, Math.min(8, diffs.size())));
+    }
+
+    private static void jsonDifference(String path, Object e, Object a, List<String> diffs) {
+        if (e instanceof JSONObject eo && a instanceof JSONObject ao) {
+            for (String k : eo.keySet()) {
+                if (!ao.has(k)) {
+                    diffs.add(path + "/" + k + ": expected " + eo.get(k) + ", missing");
+                } else {
+                    jsonDifference(path + "/" + k, eo.get(k), ao.get(k), diffs);
+                }
+            }
+            for (String k : ao.keySet()) {
+                if (!eo.has(k)) {
+                    diffs.add(path + "/" + k + ": unexpected " + ao.get(k));
+                }
+            }
+        } else if (e instanceof org.json.JSONArray ea && a instanceof org.json.JSONArray aa) {
+            if (ea.length() != aa.length()) {
+                diffs.add(path + ": expected " + ea.length() + " elements, got " + aa.length());
+            }
+            for (int i = 0; i < Math.min(ea.length(), aa.length()); i++) {
+                jsonDifference(path + "[" + i + "]", ea.get(i), aa.get(i), diffs);
+            }
+        } else if (e instanceof JSONObject || a instanceof JSONObject || e instanceof org.json.JSONArray || a instanceof org.json.JSONArray) {
+            diffs.add(path + ": expected " + e + " (" + e.getClass().getSimpleName() + "), got " + a + " (" + a.getClass().getSimpleName() + ")");
+        } else {
+            JSONObject x = new JSONObject().put("v", e);
+            JSONObject y = new JSONObject().put("v", a);
+            if (!x.similar(y)) {
+                diffs.add(path + ": expected " + Zoo.show(e) + ", got " + Zoo.show(a));
+            }
+        }
+    }
+
+    static String abbreviate(String s, int max) {
+        return s.length() > max ? s.substring(0, max) + "…" : s;
+    }
+
+    /** Runs the command in dir; null on success, else a description with the outputs. */
+    static String execute(Path dir, String... args) throws IOException, InterruptedException {
+        Path stdout = dir.resolve("stdout.txt");
+        Path stderr = dir.resolve("stderr.txt");
+        Process p = new ProcessBuilder(args).directory(dir.toFile()).redirectOutput(stdout.toFile()).redirectError(stderr.toFile()).start();
+        int code = p.waitFor();
+        String err = Files.readString(stderr);
+        if (code != 0) {
+            return String.join(" ", args) + " exited " + code + "\nSTDOUT: " + Files.readString(stdout) + "\nSTDERR: " + err;
+        }
+        return null;
+    }
+}
