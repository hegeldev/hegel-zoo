+++ b/hegel/pom.xml
@@ -0,0 +1,103 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for Simple Binary Encoding (sbe-tool), added by the Hegel zoo (targets/java/sbe).
+     Upstream builds with Gradle, so this module compiles sbe-tool's own sources (../sbe-tool/src/main/java) as its
+     main sources; nothing is installed. The oracles are an independent message encoder written from the IR,
+     the JSON printer (on-the-fly decoding), the generated codecs compiled in memory (Java) or with g++ (C++),
+     all compared with one another; upstream's C++ round-trip driver is taken from its propertyTest resources. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>sbe-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <!-- the versions of gradle/libs.versions.toml at the pinned commit -->
+    <agrona.version>2.6.0</agrona.version>
+    <json.version>20260814</json.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.agrona</groupId>
+      <artifactId>agrona</artifactId>
+      <version>${agrona.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>org.json</groupId>
+      <artifactId>json</artifactId>
+      <version>${json.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <sourceDirectory>${project.basedir}/../sbe-tool/src/main/java</sourceDirectory>
+    <resources>
+      <resource>
+        <directory>${project.basedir}/../sbe-tool/src/main/resources</directory>
+      </resource>
+    </resources>
+    <testResources>
+      <testResource>
+        <directory>${project.basedir}/src/test/resources</directory>
+      </testResource>
+      <!-- upstream's C++ round-trip driver (CppDtosPropertyTest/main.cpp) -->
+      <testResource>
+        <directory>${project.basedir}/../sbe-tool/src/propertyTest/resources</directory>
+        <excludes>
+          <exclude>junit-platform.properties</exclude>
+        </excludes>
+      </testResource>
+    </testResources>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+        <configuration>
+          <showWarnings>false</showWarnings>
+          <compilerArgs>
+            <arg>-Xlint:none</arg>
+          </compilerArgs>
+        </configuration>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--add-opens java.base/jdk.internal.misc=ALL-UNNAMED --enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g -Xss4m</argLine>
+          <!-- the generated codecs are compiled in memory with javac reading java.class.path -->
+          <useManifestOnlyJar>false</useManifestOnlyJar>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/SbeGen.java b/hegel/src/test/java/zoo/SbeGen.java
new file mode 100644
index 0000000..d18d8a8
--- /dev/null
+++ b/hegel/src/test/java/zoo/SbeGen.java
@@ -0,0 +1,612 @@
+package zoo;
+
+import static uk.co.real_logic.sbe.ir.Signal.BEGIN_FIELD;
+import static uk.co.real_logic.sbe.ir.Signal.BEGIN_GROUP;
+import static uk.co.real_logic.sbe.ir.Signal.BEGIN_MESSAGE;
+import static uk.co.real_logic.sbe.ir.Signal.BEGIN_VAR_DATA;
+import static uk.co.real_logic.sbe.ir.Signal.CHOICE;
+import static uk.co.real_logic.sbe.ir.Signal.VALID_VALUE;
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.Generators;
+import dev.hegel.TestCase;
+import java.io.ByteArrayInputStream;
+import java.io.InputStream;
+import java.math.BigInteger;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import org.agrona.ExpandableArrayBuffer;
+import org.agrona.PrintBufferUtil;
+import org.agrona.collections.MutableInteger;
+import org.agrona.concurrent.UnsafeBuffer;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import uk.co.real_logic.sbe.PrimitiveType;
+import uk.co.real_logic.sbe.PrimitiveValue;
+import uk.co.real_logic.sbe.ir.Encoding;
+import uk.co.real_logic.sbe.ir.Ir;
+import uk.co.real_logic.sbe.ir.Token;
+import uk.co.real_logic.sbe.xml.IrGenerator;
+import uk.co.real_logic.sbe.xml.ParserOptions;
+import uk.co.real_logic.sbe.xml.XmlSchemaParser;
+
+/**
+ * An independent SBE message encoder (a Hegel port of the encoder in upstream's jqwik {@code SbeArbitraries}): it
+ * walks the IR tokens of a message, writes values chosen by Hegel and records, as it goes, the JSON the
+ * on-the-fly JsonPrinter must produce for the message.
+ */
+final class SbeGen {
+    static final String PACKAGE = SchemaGen.PACKAGE;
+
+    final TestCase tc;
+    /** Upstream's firstNullTerminatesCharArray: after a 0 in a char array the rest is 0 (DTOs use Strings). */
+    final boolean nullTerminates;
+
+    SbeGen(TestCase tc, boolean nullTerminates) {
+        this.tc = tc;
+        this.nullTerminates = nullTerminates;
+    }
+
+    static uk.co.real_logic.sbe.xml.MessageSchema parse(String xml, boolean strict) throws Exception {
+        java.io.ByteArrayOutputStream errors = new java.io.ByteArrayOutputStream();
+        ParserOptions options = strict
+            ? ParserOptions.builder().suppressOutput(false).warningsFatal(true).stopOnError(true)
+                .errorPrintStream(new java.io.PrintStream(errors, true, StandardCharsets.UTF_8)).build()
+            : ParserOptions.builder().suppressOutput(false).warningsFatal(false).stopOnError(false)
+                .errorPrintStream(new java.io.PrintStream(errors, true, StandardCharsets.UTF_8)).build();
+        try (InputStream in = new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8))) {
+            return XmlSchemaParser.parse(in, options);
+        } catch (IllegalStateException e) {
+            throw new IllegalStateException(e.getMessage() + ": " + errors.toString(StandardCharsets.UTF_8).trim().replace('\n', ' '), e);
+        }
+    }
+
+    static Ir ir(String xml) throws Exception {
+        return new IrGenerator().generate(parse(xml, true));
+    }
+
+    // ------------------------------------------------------------------ messages
+
+    /** An encoded message with the JSON the printer must produce for it. */
+    static final class Msg {
+        final String xml;
+        final Ir ir;
+        final UnsafeBuffer buffer;
+        final int length;
+        final JSONObject expected;
+
+        Msg(String xml, Ir ir, byte[] bytes, JSONObject expected) {
+            this.xml = xml;
+            this.ir = ir;
+            this.buffer = new UnsafeBuffer(bytes);
+            this.length = bytes.length;
+            this.expected = expected;
+        }
+
+        byte[] bytes() {
+            byte[] out = new byte[length];
+            buffer.getBytes(0, out);
+            return out;
+        }
+
+        int headerBlockLength() {
+            return buffer.getShort(0, ir.byteOrder()) & 0xFFFF;
+        }
+
+        int headerVersion() {
+            return buffer.getShort(6, ir.byteOrder()) & 0xFFFF;
+        }
+    }
+
+    private ExpandableArrayBuffer buffer;
+    private int actingVersion;
+    private Ir ir;
+
+    Msg encode(SchemaGen.Schema schema) throws Exception {
+        return encode(schema.xml(), ir(schema.xml()), 1);
+    }
+
+    Msg encode(String xml, Ir ir, int templateId) {
+        buffer = new ExpandableArrayBuffer(1024);
+        List<Token> tokens = ir.getMessage(templateId);
+        Token msg = tokens.get(0);
+        if (msg.signal() != BEGIN_MESSAGE) {
+            throw new IllegalStateException("first token is " + msg);
+        }
+        int blockLength = msg.encodedLength();
+        actingVersion = ir.version();
+        this.ir = ir;
+        ByteOrder bo = ir.byteOrder();
+        buffer.putShort(0, (short) blockLength, bo);
+        buffer.putShort(2, (short) templateId, bo);
+        buffer.putShort(4, (short) ir.id(), bo);
+        buffer.putShort(6, (short) ir.version(), bo);
+        int headerLength = 8;
+        JSONObject root = new JSONObject();
+        MutableInteger cursor = new MutableInteger(1);
+        MutableInteger limit = new MutableInteger(headerLength + blockLength);
+        fields(tokens, cursor, tokens.size() - 1, true, headerLength, root);
+        groups(tokens, cursor, tokens.size() - 1, limit, root);
+        varData(tokens, cursor, tokens.size() - 1, limit, root);
+        byte[] bytes = new byte[limit.get()];
+        buffer.getBytes(0, bytes);
+        return new Msg(xml, ir, bytes, root);
+    }
+
+    private void fields(List<Token> tokens, MutableInteger cursor, int endIdx, boolean expectFields, int base, JSONObject out) {
+        while (cursor.get() <= endIdx) {
+            Token member = tokens.get(cursor.get());
+            int next = cursor.get() + member.componentTokenCount();
+            Token type = member;
+            int endFieldTokens = 0;
+            if (member.signal() == BEGIN_FIELD) {
+                cursor.increment();
+                type = tokens.get(cursor.get());
+                endFieldTokens = 1;
+            } else if (expectFields) {
+                break;
+            }
+            int offset = base + type.offset();
+            String name = member.name();
+            if (member.isConstantEncoding()) {
+                out.put(name, constant(member, type));
+            } else if (!expectFields && member.isOptionalEncoding() && member.version() > actingVersion) {
+                // a composite member added after the acting version: not present, nothing written
+                out.put(name, notPresent(tokens, cursor.get(), type));
+            } else {
+                switch (type.signal()) {
+                    case BEGIN_COMPOSITE -> {
+                        cursor.increment();
+                        int last = next - 1 - endFieldTokens - 1;
+                        JSONObject nested = new JSONObject();
+                        fields(tokens, cursor, last, false, offset, nested);
+                        out.put(name, nested);
+                    }
+                    case BEGIN_ENUM -> {
+                        int last = next - endFieldTokens - 1 - 1;
+                        out.put(name, enumValue(offset, tokens, member, type, cursor, last));
+                    }
+                    case BEGIN_SET -> {
+                        int last = next - endFieldTokens - 1 - 1;
+                        out.put(name, bitSet(offset, tokens, type, cursor, last));
+                    }
+                    case ENCODING -> out.put(name, encoded(offset, member, type));
+                    default -> throw new IllegalStateException("unexpected member " + type);
+                }
+            }
+            cursor.set(next);
+        }
+    }
+
+    /** The JSON the printer shows for a member or field that is absent at the acting version. */
+    static Object notPresent(List<Token> tokens, int typeIdx, Token type) {
+        Encoding enc = type.encoding();
+        switch (type.signal()) {
+            case BEGIN_ENUM -> {
+                long nul = enc.applicableNullValue().longValue();
+                for (int i = typeIdx + 1; i < typeIdx + type.componentTokenCount() - 1; i++) {
+                    Token v = tokens.get(i);
+                    if (v.signal() == VALID_VALUE && v.encoding().constValue().longValue() == nul) {
+                        return v.name();
+                    }
+                }
+                return "null";
+            }
+            case BEGIN_SET -> {
+                JSONObject flags = new JSONObject();
+                for (int i = typeIdx + 1; i < typeIdx + type.componentTokenCount() - 1; i++) {
+                    Token c = tokens.get(i);
+                    if (c.signal() == CHOICE) {
+                        flags.put(c.name(), false);
+                    }
+                }
+                return flags;
+            }
+            case BEGIN_COMPOSITE -> {
+                // the printer reads the members from the buffer (see the versioned property); the values of a
+                // not-present composite would be its members' null values
+                JSONObject members = new JSONObject();
+                int i = typeIdx + 1;
+                int end = typeIdx + type.componentTokenCount() - 1;
+                while (i < end) {
+                    Token m = tokens.get(i);
+                    if (!m.isConstantEncoding()) {
+                        members.put(m.name(), notPresent(tokens, i, m));
+                    } else {
+                        members.put(m.name(), constantOf(m, m));
+                    }
+                    i += m.componentTokenCount();
+                }
+                return members;
+            }
+            default -> {
+                PrimitiveValue nul = enc.applicableNullValue();
+                if (enc.characterEncoding() != null) {
+                    if (nul.representation() == PrimitiveValue.Representation.LONG) {
+                        return nul.longValue() == PrimitiveValue.NULL_VALUE_CHAR ? "" : String.valueOf((char) nul.longValue());
+                    }
+                    return nul.toString();
+                }
+                Object one = jsonOf(nul, enc);
+                if (type.arrayLength() < 2) {
+                    return one;
+                }
+                JSONArray arr = new JSONArray();
+                for (int k = 0; k < type.arrayLength(); k++) {
+                    arr.put(one);
+                }
+                return arr;
+            }
+        }
+    }
+
+    private Object constant(Token member, Token type) {
+        return constantOf(member, type);
+    }
+
+    static Object constantOf(Token member, Token type) {
+        Encoding enc = type.encoding();
+        if (type.signal() == uk.co.real_logic.sbe.ir.Signal.BEGIN_ENUM) {
+            String ref = member.encoding().constValue().toString();
+            int dot = ref.indexOf('.');
+            return dot < 0 ? ref : ref.substring(dot + 1);
+        }
+        PrimitiveValue v = enc.constValue();
+        if (enc.characterEncoding() != null) {
+            StringBuilder sb = new StringBuilder();
+            if (v.representation() == PrimitiveValue.Representation.LONG) {
+                if (v.longValue() != PrimitiveValue.NULL_VALUE_CHAR) {
+                    sb.append((char) v.longValue());
+                }
+            } else {
+                sb.append(v);
+            }
+            return sb.toString();
+        }
+        Object one = jsonOf(v, enc);
+        if (type.arrayLength() < 2) {
+            return one;
+        }
+        JSONArray arr = new JSONArray();
+        for (int i = 0; i < type.arrayLength(); i++) {
+            arr.put(one);
+        }
+        return arr;
+    }
+
+    private static Object jsonOf(PrimitiveValue v, Encoding enc) {
+        return switch (enc.primitiveType()) {
+            case CHAR -> String.valueOf((char) v.longValue());
+            // the printer appends a float constant or null value widened to double (1.0E-10 -> 1.000000013351432E-10)
+            case FLOAT -> doubleJson((double) (float) v.doubleValue());
+            case DOUBLE -> doubleJson(v.doubleValue());
+            default -> v.longValue();
+        };
+    }
+
+    static Object floatJson(float f) {
+        if (Float.isNaN(f)) {
+            return "0/0";
+        }
+        if (f == Float.POSITIVE_INFINITY) {
+            return "1/0";
+        }
+        if (f == Float.NEGATIVE_INFINITY) {
+            return "-1/0";
+        }
+        return f;
+    }
+
+    static Object doubleJson(double d) {
+        if (Double.isNaN(d)) {
+            return "0/0";
+        }
+        if (d == Double.POSITIVE_INFINITY) {
+            return "1/0";
+        }
+        if (d == Double.NEGATIVE_INFINITY) {
+            return "-1/0";
+        }
+        return d;
+    }
+
+    private char drawChar(Encoding enc) {
+        char lo = (char) enc.applicableMinValue().longValue();
+        char hi = (char) enc.applicableMaxValue().longValue();
+        if ("US-ASCII".equals(enc.characterEncoding())) {
+            hi = (char) Math.min(hi, 0x7f);
+        }
+        return (char) n(tc, lo, hi);
+    }
+
+    private static final long[] SPECIALS = {0L, 1L, -1L, 127L, 128L, 255L, 256L, 32767L, 65535L, Integer.MAX_VALUE, Integer.MIN_VALUE, Long.MAX_VALUE, Long.MIN_VALUE};
+
+    private long drawLong(long lo, long hi) {
+        if (chance(tc, 30)) {
+            List<Long> candidates = new ArrayList<>(List.of(lo, hi));
+            for (long v : SPECIALS) {
+                if (v >= lo && v <= hi) {
+                    candidates.add(v);
+                }
+            }
+            return pick(tc, candidates.toArray(new Long[0]));
+        }
+        return tc.draw(Generators.longs().min(lo).max(hi));
+    }
+
+    /** A uint64 in [lo, hi], both as the signed longs of PrimitiveValue (negative = above Long.MAX_VALUE). */
+    private long drawUint64(long lo, long hi) {
+        if ((lo >= 0) == (hi >= 0)) {
+            return drawLong(lo, hi);
+        }
+        return chance(tc, 50) ? drawLong(lo, Long.MAX_VALUE) : drawLong(Long.MIN_VALUE, hi);
+    }
+
+    private float drawFloat() {
+        if (chance(tc, 25)) {
+            return pick(tc, 0f, -0f, 1f, -1f, Float.MIN_VALUE, Float.MAX_VALUE, Float.MIN_NORMAL, 0.1f, 1e10f, 3.4028235e38f, Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY);
+        }
+        if (chance(tc, 30)) {
+            return Float.intBitsToFloat(tc.draw(Generators.integers()));
+        }
+        return tc.draw(Generators.doubles()).floatValue();
+    }
+
+    private double drawDouble() {
+        if (chance(tc, 25)) {
+            return pick(tc, 0d, -0d, 1d, -1d, Double.MIN_VALUE, Double.MAX_VALUE, Double.MIN_NORMAL, 0.1, 1e300, 1e-300, Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY);
+        }
+        if (chance(tc, 30)) {
+            return Double.longBitsToDouble(tc.draw(Generators.longs()));
+        }
+        return tc.draw(Generators.doubles());
+    }
+
+    /** Writes one value of the encoding at the offset (null 20 % of the time when optional) and returns its JSON. */
+    private Object writeOne(int off, Encoding enc, boolean optional) {
+        PrimitiveType pt = enc.primitiveType();
+        ByteOrder bo = enc.byteOrder();
+        boolean nul = optional && chance(tc, 20);
+        boolean integral = pt != PrimitiveType.FLOAT && pt != PrimitiveType.DOUBLE;
+        long lo = integral ? enc.applicableMinValue().longValue() : 0;
+        long hi = integral ? enc.applicableMaxValue().longValue() : 0;
+        long nullValue = integral ? enc.applicableNullValue().longValue() : 0;
+        switch (pt) {
+            case CHAR -> {
+                char c = nul ? (char) nullValue : drawChar(enc);
+                buffer.putByte(off, (byte) c);
+                return String.valueOf((char) buffer.getByte(off));
+            }
+            case INT8, UINT8 -> {
+                long v = nul ? nullValue : drawLong((short) lo, (short) hi);
+                buffer.putByte(off, (byte) v);
+                return pt == PrimitiveType.UINT8 ? (long) (buffer.getByte(off) & 0xFF) : (long) buffer.getByte(off);
+            }
+            case INT16, UINT16 -> {
+                long v = nul ? nullValue : drawLong((int) lo, (int) hi);
+                buffer.putShort(off, (short) v, bo);
+                return pt == PrimitiveType.UINT16 ? (long) (buffer.getShort(off, bo) & 0xFFFF) : (long) buffer.getShort(off, bo);
+            }
+            case INT32, UINT32 -> {
+                long v = nul ? nullValue : drawLong(lo, hi);
+                buffer.putInt(off, (int) v, bo);
+                return pt == PrimitiveType.UINT32 ? buffer.getInt(off, bo) & 0xFFFF_FFFFL : (long) buffer.getInt(off, bo);
+            }
+            case INT64 -> {
+                long v = nul ? nullValue : drawLong(lo, hi);
+                buffer.putLong(off, v, bo);
+                return v;
+            }
+            case UINT64 -> {
+                long v = nul ? nullValue : drawUint64(lo, hi);
+                if (!nul && v == nullValue) {
+                    v = lo;
+                }
+                buffer.putLong(off, v, bo);
+                // bug sbe/1: the printer writes uint64 values as signed longs; the true value would be
+                // new BigInteger(Long.toUnsignedString(v))
+                return v;
+            }
+            case FLOAT -> {
+                float f = nul ? (float) enc.applicableNullValue().doubleValue() : drawFloat();
+                buffer.putFloat(off, f, bo);
+                return floatJson(f);
+            }
+            case DOUBLE -> {
+                double d = nul ? enc.applicableNullValue().doubleValue() : drawDouble();
+                buffer.putDouble(off, d, bo);
+                return doubleJson(d);
+            }
+            default -> throw new IllegalArgumentException("unsupported " + pt);
+        }
+    }
+
+    private Object encoded(int offset, Token member, Token type) {
+        Encoding enc = type.encoding();
+        int count = type.arrayLength();
+        PrimitiveType pt = enc.primitiveType();
+        boolean optional = member.isOptionalEncoding();
+        if (count == 1) {
+            return writeOne(offset, enc, optional);
+        }
+        if (pt == PrimitiveType.CHAR) {
+            boolean ended = false;
+            for (int i = 0; i < count; i++) {
+                int off = offset + i;
+                if (ended) {
+                    buffer.putByte(off, (byte) 0);
+                } else {
+                    writeOne(off, enc, optional);
+                    if (nullTerminates && buffer.getByte(off) == 0) {
+                        ended = true;
+                    }
+                }
+            }
+            // the printer shows the characters up to the first byte that is 0 (or negative)
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < count; i++) {
+                byte b = buffer.getByte(offset + i);
+                if (b <= 0) {
+                    break;
+                }
+                sb.append((char) b);
+            }
+            return sb.toString();
+        }
+        JSONArray arr = new JSONArray();
+        for (int i = 0; i < count; i++) {
+            arr.put(writeOne(offset + i * pt.size(), enc, optional));
+        }
+        return arr;
+    }
+
+    private void writeInt(int off, Encoding enc, long value) {
+        ByteOrder bo = enc.byteOrder();
+        switch (enc.primitiveType()) {
+            case CHAR, INT8, UINT8 -> buffer.putByte(off, (byte) value);
+            case INT16, UINT16 -> buffer.putShort(off, (short) value, bo);
+            case INT32, UINT32 -> buffer.putInt(off, (int) value, bo);
+            case INT64, UINT64 -> buffer.putLong(off, value, bo);
+            default -> throw new IllegalArgumentException("unsupported " + enc.primitiveType());
+        }
+    }
+
+    private Object enumValue(int offset, List<Token> tokens, Token member, Token type, MutableInteger cursor, int last) {
+        cursor.increment();
+        List<Token> valid = new ArrayList<>();
+        for (; cursor.get() <= last; cursor.increment()) {
+            Token t = tokens.get(cursor.get());
+            if (t.signal() != VALID_VALUE) {
+                throw new IllegalStateException("expected VALID_VALUE, got " + t);
+            }
+            if (t.version() <= actingVersion) {
+                valid.add(t);
+            }
+        }
+        if (valid.isEmpty() || (member.isOptionalEncoding() && chance(tc, 20))) {
+            writeInt(offset, schemaOrder(type.encoding()), type.encoding().nullValue().longValue());
+            return "null";
+        }
+        Token v = pick(tc, valid.toArray(new Token[0]));
+        writeInt(offset, v.encoding(), v.encoding().constValue().longValue());
+        return v.name();
+    }
+
+    private Object bitSet(int offset, List<Token> tokens, Token type, MutableInteger cursor, int last) {
+        cursor.increment();
+        JSONObject flags = new JSONObject();
+        long value = 0;
+        for (; cursor.get() <= last; cursor.increment()) {
+            Token t = tokens.get(cursor.get());
+            if (t.signal() != CHOICE) {
+                throw new IllegalStateException("expected CHOICE, got " + t);
+            }
+            boolean on = t.version() <= actingVersion && chance(tc, 50);
+            if (on) {
+                value |= 1L << t.encoding().constValue().longValue();
+            }
+            flags.put(t.name(), on);
+        }
+        // The BEGIN_SET token's encoding carries the default (little-endian) byte order whatever the schema
+        // says (bug sbe/2); the model writes every value in the schema's byte order.
+        writeInt(offset, schemaOrder(type.encoding()), value);
+        return flags;
+    }
+
+    /** The encoding with the schema's byte order (the IR's set tokens do not carry it, bug sbe/2). */
+    private Encoding schemaOrder(Encoding enc) {
+        return enc.byteOrder() == ir.byteOrder() ? enc
+            : new Encoding.Builder().primitiveType(enc.primitiveType()).byteOrder(ir.byteOrder()).build();
+    }
+
+    private void groups(List<Token> tokens, MutableInteger cursor, int endIdx, MutableInteger limit, JSONObject out) {
+        while (cursor.get() <= endIdx) {
+            Token g = tokens.get(cursor.get());
+            if (g.signal() != BEGIN_GROUP) {
+                break;
+            }
+            int next = cursor.get() + g.componentTokenCount();
+            cursor.increment(); // BEGIN_GROUP
+            cursor.increment(); // BEGIN_COMPOSITE (the dimensions)
+            Token blockLengthTok = tokens.get(cursor.get());
+            int blockLength = g.encodedLength();
+            cursor.increment();
+            Token numInGroupTok = tokens.get(cursor.get());
+            cursor.increment(); // ENCODING
+            cursor.increment(); // END_COMPOSITE
+            int headerLength = blockLengthTok.encodedLength() + numInGroupTok.encodedLength();
+            int count = chance(tc, 40) ? n(tc, 0, 1) : n(tc, 0, 6);
+            int off = limit.get();
+            writeInt(off, blockLengthTok.encoding(), blockLength);
+            writeInt(off + blockLengthTok.encodedLength(), numInGroupTok.encoding(), count);
+            limit.set(off + headerLength);
+            JSONArray elements = new JSONArray();
+            int bodyStart = cursor.get();
+            for (int i = 0; i < count; i++) {
+                cursor.set(bodyStart);
+                JSONObject el = new JSONObject();
+                int eo = limit.get();
+                fields(tokens, cursor, next - 1, true, eo, el);
+                limit.set(eo + blockLength);
+                groups(tokens, cursor, next - 1, limit, el);
+                varData(tokens, cursor, next - 1, limit, el);
+                elements.put(el);
+            }
+            out.put(g.name(), elements);
+            cursor.set(next);
+        }
+    }
+
+    private void varData(List<Token> tokens, MutableInteger cursor, int endIdx, MutableInteger limit, JSONObject out) {
+        while (cursor.get() <= endIdx) {
+            Token t = tokens.get(cursor.get());
+            if (t.signal() != BEGIN_VAR_DATA) {
+                break;
+            }
+            int next = cursor.get() + t.componentTokenCount();
+            cursor.increment(); // BEGIN_COMPOSITE
+            cursor.increment(); // ENCODING (length)
+            Token lengthTok = tokens.get(cursor.get());
+            cursor.increment();
+            Token dataTok = tokens.get(cursor.get());
+            cursor.increment(); // END_COMPOSITE
+            String charset = dataTok.encoding().characterEncoding();
+            int max = (int) Math.min(lengthTok.encoding().applicableMaxValue().longValue(), 260L);
+            int len = chance(tc, 30) ? n(tc, 0, Math.min(2, max)) : n(tc, 0, max);
+            byte[] data = new byte[len];
+            if ("UTF-8".equalsIgnoreCase(charset)) {
+                StringBuilder sb = new StringBuilder();
+                while (true) {
+                    int cp = chance(tc, 50) ? n(tc, 0x20, 0x7e) : chance(tc, 50) ? n(tc, 0x80, 0x7ff) : chance(tc, 70) ? n(tc, 0x800, 0xd7ff) : n(tc, 0x10000, 0x10ffff);
+                    String more = sb.toString() + new String(Character.toChars(cp));
+                    if (more.getBytes(StandardCharsets.UTF_8).length > len) {
+                        break;
+                    }
+                    sb.append(new String(Character.toChars(cp)));
+                }
+                data = sb.toString().getBytes(StandardCharsets.UTF_8);
+                len = data.length;
+            } else {
+                for (int i = 0; i < len; i++) {
+                    data[i] = charset != null ? (byte) drawChar(dataTok.encoding()) : (byte) n(tc, -128, 127);
+                }
+            }
+            int off = limit.get();
+            writeInt(off, lengthTok.encoding(), len);
+            buffer.putBytes(off + lengthTok.encodedLength(), data);
+            limit.set(off + lengthTok.encodedLength() + len);
+            Object json;
+            try {
+                json = charset != null ? new String(data, charset) : PrintBufferUtil.hexDump(data);
+            } catch (Exception e) {
+                throw new IllegalStateException(e);
+            }
+            out.put(t.name(), json);
+            cursor.set(next);
+        }
+    }
+}
