+    static <T> Map<T, Integer> counts(Iterable<? extends T> xs) {
+        Map<T, Integer> m = new HashMap<>();
+        for (T x : xs) {
+            m.merge(x, 1, Integer::sum);
+        }
+        return m;
+    }
+
+    static <T> int count(Map<T, Integer> m, T x) {
+        return m.getOrDefault(x, 0);
+    }
+
+    static <T> Set<T> keys(Map<T, Integer> a, Map<T, Integer> b) {
+        Set<T> ks = new HashSet<>(a.keySet());
+        ks.addAll(b.keySet());
+        return ks;
+    }
+
+    static <T> void sameCounts(String what, Iterable<? extends T> got, Map<T, Integer> want, Object a, Object b) {
+        Map<T, Integer> g = counts(got);
+        Map<T, Integer> w = new HashMap<>();
+        want.forEach((k, v) -> {
+            if (v != 0) {
+                w.put(k, v);
+            }
+        });
+        Zoo.check(g.equals(w), () -> what + " of " + a + " and " + b + " = " + got + ": counts " + g + ", expected " + w);
+    }
+
+    /** Whether {@code sub} is a subsequence of {@code xs}. */
+    static <T> boolean subsequence(List<T> sub, List<T> xs) {
+        int i = 0;
+        for (T x : xs) {
+            if (i < sub.size() && java.util.Objects.equals(sub.get(i), x)) {
+                i++;
+            }
+        }
+        return i == sub.size();
+    }
