+    }
+
+    /** An operation on a bag or multiset; the model's answer is computed beside it when applied. */
+    sealed interface BagOp {
+        record Add(Integer e) implements BagOp {}
+
+        record AddN(Integer e, int n) implements BagOp {}
+
+        record Remove(Integer e) implements BagOp {}
+
+        record RemoveN(Integer e, int n) implements BagOp {}
+
+        /** Multisets only. */
+        record SetCount(Integer e, int n) implements BagOp {}
+
+        record RetainAll(List<Integer> other) implements BagOp {}
+
+        record RemoveAll(List<Integer> other) implements BagOp {}
+
+        record ContainsAll(List<Integer> other) implements BagOp {}
+
+        /** Removes the first element through the iterator (nothing when empty). */
+        record IterRemove() implements BagOp {}
+    }
+
+    /** The operations of a kind: add (2), the others once each; setCount only where the kind has it. */
+    static Generator<BagOp> bagOp(Kind kind) {
+        Generator<Integer> e = element(kind.nulls(), 8);
+        Generator<Integer> n = ints(0, 3);
+        Generator<List<Integer>> other = smallInts(kind.nulls());
+        List<Gen.Choice<BagOp>> cs = new ArrayList<>();
+        cs.add(w(2, e.<BagOp>map(BagOp.Add::new)));
+        cs.add(w(1, tuples(e, n).<BagOp>map(t -> new BagOp.AddN(t.value1(), t.value2()))));
+        cs.add(w(1, e.<BagOp>map(BagOp.Remove::new)));
+        cs.add(w(1, tuples(e, n).<BagOp>map(t -> new BagOp.RemoveN(t.value1(), t.value2()))));
+        if (!kind.bag()) {
+            cs.add(w(1, tuples(e, n).<BagOp>map(t -> new BagOp.SetCount(t.value1(), t.value2()))));
+        }
+        cs.add(w(1, other.<BagOp>map(BagOp.RemoveAll::new)));
+        cs.add(w(1, other.<BagOp>map(BagOp.RetainAll::new)));
+        cs.add(w(1, other.<BagOp>map(BagOp.ContainsAll::new)));
+        cs.add(Gen.<BagOp>v(1, new BagOp.IterRemove()));
+        return weighted(cs);
+    }
+
+    static final Map<Kind, Generator<BagOp>> BAG_OPS = new EnumMap<>(Kind.class);
+
+    static {
