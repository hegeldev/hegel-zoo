+                        }
+                        // put at an index: the documented "relative to the original state" rule
+                        if (Zoo.chance(tc, 40)) {
+                            Object pk = key(tc, kind);
+                            int index = Zoo.n(tc, 0, want.size());
+                            int v = Zoo.n(tc, 0, 9);
