+    static final Generator<Second> SECOND = weighted(Gen.<Second>v(15, new Second.Same()), w(60, LETTERS.<Second>map(Second.Fresh::new)), w(25, many(EDIT, 1, 3).<Second>map(Second.Edited::new)));
