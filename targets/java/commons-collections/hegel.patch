+    // ---- bidirectional maps --------------------------------------------------------------------
+
+    enum BidiKind { DUAL_HASH, DUAL_LINKED, DUAL_TREE, TREE }
+
+    /** Small cached Integers: distinct-but-equal key objects are bug commons-collections/2's shape. */
+    static final Generator<Integer> SMALL = ints(0, 6);
+
+    sealed interface BidiOp {
+        record Put(int k, int v) implements BidiOp {}
+
+        record Remove(int k) implements BidiOp {}
+
+        record RemoveValue(int v) implements BidiOp {}
+
+        /** Sets a value through the map iterator after skipping some entries. */
+        record SetValue(int skip, int v) implements BidiOp {}
+    }
+
+    static final Generator<BidiOp> BIDI_OP = weighted(
+            w(4, tuples(SMALL, SMALL).<BidiOp>map(t -> new BidiOp.Put(t.value1(), t.value2()))),
+            w(1, SMALL.<BidiOp>map(BidiOp.Remove::new)),
+            w(1, SMALL.<BidiOp>map(BidiOp.RemoveValue::new)),
+            w(2, tuples(INDEX, SMALL).<BidiOp>map(t -> new BidiOp.SetValue(t.value1(), t.value2()))));
+
+    /** An operation and, for DualTreeBidiMap, the bounds of the sub-map views read afterwards (lo 0..3, hi lo..7). */
+    record BidiStep(BidiOp op, int lo, int hi) {}
+
+    static Generator<BidiStep> bidiStep(BidiKind kind) {
+        if (kind == BidiKind.DUAL_TREE) {
+            return tuples(BIDI_OP, ints(0, 3), ints(0, 7)).map(t -> new BidiStep(t.value1(), t.value2(), t.value2() + Math.floorMod(t.value3(), 8 - t.value2())));
+        }
+        return BIDI_OP.map(op -> new BidiStep(op, 0, 0));
+    }
+
+    record BidiCase(BidiKind kind, List<BidiStep> steps) {}
+
+    static final Map<BidiKind, Generator<BidiCase>> BIDI_CASES = new EnumMap<>(BidiKind.class);
+
+    static {
+        for (BidiKind k : BidiKind.values()) {
+            BIDI_CASES.put(k, many(bidiStep(k), 0, 20).map(steps -> new BidiCase(k, steps)));
+        }
+    }
+
+    static final Generator<BidiCase> BIDI_CASE = pick(BidiKind.values()).flatMap(BIDI_CASES::get);
+
+    @Test
+    void bidiMapsKeepTheInverse() {
+        Zoo.run("bidiMapsKeepTheInverse", tc -> {
+            BidiCase c = tc.draw(BIDI_CASE, "case");
+            BidiKind kind = c.kind();
+            BidiMap<Integer, Integer> map = switch (kind) {
+                case DUAL_HASH -> new DualHashBidiMap<>();
+                case DUAL_LINKED -> new DualLinkedHashBidiMap<>();
+                case DUAL_TREE -> new DualTreeBidiMap<>();
+                case TREE -> new TreeBidiMap<>();
+            };
+            boolean sorted = kind == BidiKind.DUAL_TREE || kind == BidiKind.TREE;
+            // the model: forward and inverse maps kept by the documented put rule; LinkedHashMaps to mirror the linked kind
+            LinkedHashMap<Integer, Integer> fwd = new LinkedHashMap<>();
+            LinkedHashMap<Integer, Integer> inv = new LinkedHashMap<>();
+            StringBuilder log = new StringBuilder(kind.toString());
+            for (BidiStep step : c.steps()) {
+                switch (step.op()) {
+                    case BidiOp.Put p -> {
+                        Integer k = p.k();
+                        Integer v = p.v();
+                        log.append(" put(").append(k).append(", ").append(v).append(')');
+                        Integer got = map.put(k, v);
+                        Integer want = fwd.get(k);
+                        if (fwd.containsKey(k)) {
+                            inv.remove(fwd.get(k));
+                        }
+                        if (inv.containsKey(v)) {
+                            fwd.remove(inv.get(v));
+                        }
+                        fwd.put(k, v);
+                        inv.put(v, k);
+                        Zoo.check(Objects.equals(got, want), () -> log + ": put returned " + got + ", expected " + want);
+                    }
+                    case BidiOp.Remove r -> {
+                        Integer k = r.k();
+                        log.append(" remove(").append(k).append(')');
+                        Integer got = map.remove(k);
+                        Integer want = fwd.remove(k);
+                        if (want != null) {
+                            inv.remove(want);
+                        }
+                        Zoo.check(Objects.equals(got, want), () -> log + ": remove returned " + got + ", expected " + want);
+                    }
+                    case BidiOp.RemoveValue rv -> {
+                        Integer v = rv.v();
+                        log.append(" removeValue(").append(v).append(')');
+                        Integer got = map.removeValue(v);
+                        Integer want = inv.remove(v);
+                        if (want != null) {
+                            fwd.remove(want);
+                        }
+                        Zoo.check(Objects.equals(got, want), () -> log + ": removeValue returned " + got + ", expected " + want);
+                    }
+                    case BidiOp.SetValue sv -> {
+                        if (fwd.isEmpty()) {
+                            Zoo.count("mapIterator.setValue not done: the map is empty");
+                        } else {
+                            // set a value through the map iterator (TreeBidiMap refuses, as documented)
+                            Integer v = sv.v();
+                            MapIterator<Integer, Integer> it = map.mapIterator();
+                            int skip = Math.floorMod(sv.skip(), fwd.size());
+                            for (int i = 0; i <= skip; i++) {
+                                it.next();
+                            }
+                            Integer key = it.getKey();
+                            log.append(" mapIterator(").append(key).append(").setValue(").append(v).append(')');
+                            boolean clash = inv.containsKey(v) && !inv.get(v).equals(key);
+                            try {
+                                it.setValue(v);
+                                Zoo.check(kind != BidiKind.TREE, () -> log + ": TreeBidiMap allowed setValue");
+                                Zoo.check(!clash, () -> log + ": setValue accepted a value mapped to " + inv.get(v));
+                                inv.remove(fwd.get(key));
+                                fwd.put(key, v);
+                                inv.put(v, key);
+                            } catch (UnsupportedOperationException e) {
+                                Zoo.check(kind == BidiKind.TREE, () -> log + ": setValue unsupported: " + e);
+                            } catch (IllegalArgumentException e) {
+                                Zoo.check(clash && kind != BidiKind.TREE, () -> log + ": setValue refused without a clash: " + e);
+                            }
+                        }
+                    }
+                }
+                // compare both directions
+                BidiMap<Integer, Integer> inverse = map.inverseBidiMap();
+                Zoo.check(new HashMap<>(map).equals(fwd) && map.size() == fwd.size() && new HashMap<>(inverse).equals(inv) && inverse.size() == inv.size(),
+                        () -> log + ": map " + map + " inverse " + inverse + ", model " + fwd + " / " + inv);
+                Zoo.check(inverse.inverseBidiMap() == map || new HashMap<>(inverse.inverseBidiMap()).equals(fwd), () -> log + ": inverse of the inverse");
+                for (int x = 0; x <= 6; x++) {
+                    int y = x;
+                    Zoo.check(Objects.equals(map.getKey(y), inv.get(y)) && Objects.equals(map.get(y), fwd.get(y)) && map.containsValue(y) == inv.containsKey(y)
+                            && Objects.equals(inverse.get(y), inv.get(y)) && Objects.equals(inverse.getKey(y), fwd.get(y)),
+                            () -> log + ": getKey(" + y + ") = " + map.getKey(y) + ", get " + map.get(y) + ", containsValue " + map.containsValue(y));
+                }
+                Zoo.check(new LinkedHashSet<>(map.values()).equals(inv.keySet()) && map.values().size() == inv.size(), () -> log + ": values " + map.values());
+                List<Integer> keys = new ArrayList<>(map.keySet());
+                if (sorted) {
+                    List<Integer> want = new ArrayList<>(new TreeMap<>(fwd).keySet());
+                    List<Integer> invKeys = new ArrayList<>(inverse.keySet());
+                    List<Integer> wantInv = new ArrayList<>(new TreeMap<>(inv).keySet());
+                    Zoo.check(keys.equals(want) && invKeys.equals(wantInv), () -> log + ": key order " + keys + ", inverse key order " + invKeys);
+                    OrderedBidiMap<Integer, Integer> om = (OrderedBidiMap<Integer, Integer>) map;
+                    if (!want.isEmpty()) {
+                        Zoo.check(om.firstKey().equals(want.get(0)) && om.lastKey().equals(want.get(want.size() - 1)), () -> log + ": firstKey " + om.firstKey() + " lastKey " + om.lastKey());
+                        for (int i = 0; i < want.size(); i++) {
+                            int ii = i;
+                            // an absent key is bug commons-collections/3's shape for DualTreeBidiMap: only present keys here
+                            Zoo.check(Objects.equals(om.nextKey(want.get(i)), i + 1 < want.size() ? want.get(i + 1) : null)
+                                    && Objects.equals(om.previousKey(want.get(i)), i > 0 ? want.get(i - 1) : null),
+                                    () -> log + ": nextKey/previousKey of " + want.get(ii) + " = " + om.nextKey(want.get(ii)) + " / " + om.previousKey(want.get(ii)));
+                        }
+                    }
+                    if (kind == BidiKind.DUAL_TREE) {
+                        // read-only sub-map views (writing through them is bug commons-collections/4's shape)
+                        DualTreeBidiMap<Integer, Integer> dt = (DualTreeBidiMap<Integer, Integer>) map;
+                        int lo = step.lo();
+                        int hi = step.hi();
+                        TreeMap<Integer, Integer> tm = new TreeMap<>(fwd);
+                        Zoo.check(new TreeMap<>(dt.headMap(hi)).equals(tm.headMap(hi)) && new TreeMap<>(dt.tailMap(lo)).equals(tm.tailMap(lo)) && new TreeMap<>(dt.subMap(lo, hi)).equals(tm.subMap(lo, hi))
+                                && dt.headMap(hi).size() == tm.headMap(hi).size() && dt.subMap(lo, hi).size() == tm.subMap(lo, hi).size(),
+                                () -> log + ": views headMap(" + hi + ") " + dt.headMap(hi) + " tailMap(" + lo + ") " + dt.tailMap(lo) + " subMap " + dt.subMap(lo, hi));
+                        for (int x = 0; x <= 6; x++) {
+                            int y = x;
+                            Zoo.check(dt.headMap(hi).containsValue(y) == tm.headMap(hi).containsValue(y), () -> log + ": headMap(" + hi + ").containsValue(" + y + ")");
+                        }
+                    }
+                } else if (kind == BidiKind.DUAL_LINKED) {
+                    Zoo.check(keys.equals(new ArrayList<>(fwd.keySet())), () -> log + ": key order " + keys + ", model " + fwd.keySet());
+                }
+                // the map iterator agrees with the key set
+                List<Integer> viaIterator = new ArrayList<>();
+                MapIterator<Integer, Integer> mi = map.mapIterator();
+                while (mi.hasNext()) {
+                    Integer key = mi.next();
+                    viaIterator.add(key);
+                    Zoo.check(mi.getKey().equals(key) && mi.getValue().equals(fwd.get(key)), () -> log + ": mapIterator at " + key);
+                }
+                Zoo.check(viaIterator.equals(keys), () -> log + ": mapIterator order " + viaIterator + ", keySet " + keys);
+            }
+            if (kind == BidiKind.TREE) {
+                try {
+                    map.put(null, 1);
+                    Zoo.fail(log + ": TreeBidiMap accepted a null key");
+                } catch (NullPointerException expected) {
+                    // documented
+                }
+            }
+        });
+    }
+
+    // ---- lists ---------------------------------------------------------------------------------
+
+    enum ListKind {
+        TREE("TreeList"), SET_UNIQUE("SetUniqueList"), GROWTH("GrowthList");
+
+        final String label;
+
+        ListKind(String label) {
+            this.label = label;
+        }
+    }
+
+    /** An operation on a list; indexes are taken modulo the live size (plus three beyond it for the growth list). */
+    sealed interface ListOp {
+        record Add(Integer e) implements ListOp {}
+
+        record AddAt(int index, Integer e) implements ListOp {}
+
+        record RemoveAt(int index) implements ListOp {}
+
+        record Set(int index, Integer e) implements ListOp {}
+
+        record RemoveObj(Integer e) implements ListOp {}
+
+        /** addAll of the elements (as a TreeList when asTreeList), at the end when at is -1, else at an index. */
+        record AddAll(List<Integer> more, boolean asTreeList, int at) implements ListOp {}
+
+        /** A list-iterator walk to an index, then a removal or (never on the unique list) a set. */
+        record IterEdit(int at, boolean remove, Integer e) implements ListOp {}
+
+        /** TreeList only: a walk backwards from the end. */
+        record Backward() implements ListOp {}
+
+        record Clear() implements ListOp {}
+
+        record SubList(int from, int to) implements ListOp {}
+    }
+
+    static Generator<ListOp> listOp(ListKind kind) {
+        boolean unique = kind == ListKind.SET_UNIQUE;
+        Generator<Integer> e = unique ? ints(0, 9) : weighted(w(95, ints(0, 9)), w(5, just((Integer) null)));
+        Generator<Boolean> asTreeList = kind == ListKind.TREE ? chance(50) : just(false);
+        Generator<Boolean> remove = unique ? just(true) : chance(50);
+        List<Gen.Choice<ListOp>> cs = new ArrayList<>();
+        cs.add(w(20, e.<ListOp>map(ListOp.Add::new)));
+        cs.add(w(10, tuples(INDEX, e).<ListOp>map(t -> new ListOp.AddAt(t.value1(), t.value2()))));
+        cs.add(w(10, INDEX.<ListOp>map(ListOp.RemoveAt::new)));
+        cs.add(w(10, tuples(INDEX, e).<ListOp>map(t -> new ListOp.Set(t.value1(), t.value2()))));
+        cs.add(w(10, e.<ListOp>map(ListOp.RemoveObj::new)));
+        cs.add(w(10, tuples(many(ints(0, 9), 0, 12), asTreeList, maybe(50, -1, INDEX)).<ListOp>map(t -> new ListOp.AddAll(t.value1(), t.value2(), t.value3()))));
+        cs.add(w(10, tuples(INDEX, remove, e).<ListOp>map(t -> new ListOp.IterEdit(t.value1(), t.value2(), t.value3()))));
+        if (kind == ListKind.TREE) {
+            cs.add(Gen.<ListOp>v(10, new ListOp.Backward()));
+        }
+        cs.add(Gen.<ListOp>v(1, new ListOp.Clear()));
+        cs.add(w(10, tuples(INDEX, INDEX).<ListOp>map(t -> new ListOp.SubList(t.value1(), t.value2()))));
+        return weighted(cs);
+    }
+
+    record ListCase(ListKind kind, List<ListOp> ops) {}
+
+    static final Map<ListKind, Generator<ListCase>> LIST_CASES = new EnumMap<>(ListKind.class);
+
+    static {
+        for (ListKind k : ListKind.values()) {
+            LIST_CASES.put(k, many(listOp(k), 0, 30).map(ops -> new ListCase(k, ops)));
+        }
+    }
+
+    static final Generator<ListCase> LIST_CASE = pick(ListKind.values()).flatMap(LIST_CASES::get);
+
+    @Test
+    void listsMatchArrayList() {
+        Zoo.run("listsMatchArrayList", tc -> {
+            ListCase c = tc.draw(LIST_CASE, "case");
+            ListKind kind = c.kind();
+            List<Integer> list = switch (kind) {
+                case TREE -> new TreeList<>();
+                case SET_UNIQUE -> SetUniqueList.setUniqueList(new ArrayList<>());
+                case GROWTH -> new GrowthList<>();
+            };
+            List<Integer> model = new ArrayList<>();
+            boolean unique = kind == ListKind.SET_UNIQUE;
+            int beyond = kind == ListKind.GROWTH ? 3 : 0;
+            StringBuilder log = new StringBuilder(kind.label);
+            for (ListOp op : c.ops()) {
+                switch (op) {
+                    case ListOp.Add a -> {
+                        Integer e = a.e();
+                        log.append(" add(").append(e).append(')');
+                        boolean got = list.add(e);
+                        boolean want = !unique || !model.contains(e);
+                        if (want) {
+                            model.add(e);
+                        }
+                        Zoo.check(got == want, () -> log + ": add returned " + got);
+                    }
+                    case ListOp.AddAt a -> {
+                        Integer e = a.e();
+                        int i = Math.floorMod(a.index(), model.size() + 1 + beyond);
+                        log.append(" add(").append(i).append(", ").append(e).append(')');
+                        list.add(i, e);
+                        if (i > model.size()) {
+                            while (model.size() < i) {
+                                model.add(null);
+                            }
+                        }
+                        if (!unique || !model.contains(e)) {
+                            model.add(i, e);
+                        }
+                    }
+                    case ListOp.RemoveAt r -> {
+                        if (model.isEmpty()) {
+                            Zoo.count("remove(index) not done: the list is empty");
+                        } else {
+                            int i = Math.floorMod(r.index(), model.size());
+                            log.append(" remove(").append(i).append(')');
+                            Integer got = list.remove(i);
+                            Integer want = model.remove(i);
+                            Zoo.check(Objects.equals(got, want), () -> log + ": remove returned " + got + ", expected " + want);
+                        }
+                    }
+                    case ListOp.Set s -> {
+                        if (model.isEmpty()) {
+                            Zoo.count("set(index) not done: the list is empty");
+                        } else {
+                            Integer e = s.e();
+                            int i = Math.floorMod(s.index(), model.size() + beyond);
+                            log.append(" set(").append(i).append(", ").append(e).append(')');
+                            Integer got = list.set(i, e);
+                            Integer want;
+                            if (i >= model.size()) {
+                                while (model.size() <= i) {
+                                    model.add(null);
+                                }
+                                want = null;
+                                model.set(i, e);
+                            } else if (unique) {
+                                int pos = model.indexOf(e);
+                                want = model.set(i, e);
+                                if (pos >= 0 && pos != i) {
+                                    model.remove(pos);
+                                }
+                            } else {
+                                want = model.set(i, e);
+                            }
+                            Zoo.check(Objects.equals(got, want), () -> log + ": set returned " + got + ", expected " + want);
+                        }
+                    }
+                    case ListOp.RemoveObj r -> {
+                        Integer e = r.e();
+                        log.append(" remove(Object ").append(e).append(')');
+                        boolean got = list.remove(e);
+                        boolean want = model.remove(e);
+                        Zoo.check(got == want, () -> log + ": remove(Object) returned " + got);
+                    }
+                    case ListOp.AddAll aa -> {
+                        List<Integer> more = aa.more();
+                        List<Integer> src = aa.asTreeList() ? new TreeList<>(more) : more;
+                        if (aa.at() < 0) {
+                            log.append(" addAll(").append(more).append(')');
+                            list.addAll(src);
+                            for (Integer x : more) {
+                                if (!unique || !model.contains(x)) {
+                                    model.add(x);
+                                }
+                            }
+                        } else {
+                            int i = Math.floorMod(aa.at(), model.size() + 1);
+                            log.append(" addAll(").append(i).append(", ").append(more).append(')');
+                            list.addAll(i, src);
+                            List<Integer> fresh = new ArrayList<>();
+                            for (Integer x : more) {
+                                if (!unique || !model.contains(x) && !fresh.contains(x)) {
+                                    fresh.add(x);
+                                }
+                            }
+                            model.addAll(i, fresh);
+                        }
+                    }
+                    case ListOp.IterEdit ie -> {
+                        if (model.isEmpty()) {
+                            Zoo.count("listIterator edit not done: the list is empty");
+                        } else {
+                            // list iterator walk with a removal or a set
+                            Integer e = ie.e();
+                            int at = Math.floorMod(ie.at(), model.size());
+                            ListIterator<Integer> it = list.listIterator();
+                            for (int i = 0; i <= at; i++) {
+                                it.next();
+                            }
+                            Zoo.check(it.nextIndex() == at + 1 && it.previousIndex() == at, () -> log + ": listIterator indexes " + it.nextIndex() + "/" + it.previousIndex() + " after " + (at + 1) + " next()s");
+                            if (ie.remove()) {
+                                log.append(" listIterator.remove(at ").append(at).append(')');
+                                it.remove();
+                                model.remove(at);
+                                if (it.hasNext()) {
+                                    Integer nxt = it.next();
+                                    Zoo.check(Objects.equals(nxt, model.get(at)), () -> log + ": next after remove = " + nxt + ", expected " + model.get(at));
+                                }
+                            } else {
+                                log.append(" listIterator.set(at ").append(at).append(", ").append(e).append(')');
+                                it.set(e);
+                                model.set(at, e);
+                                Integer prev = it.previous();
+                                Zoo.check(Objects.equals(prev, e), () -> log + ": previous after set = " + prev);
+                            }
+                        }
+                    }
+                    case ListOp.Backward b -> {
+                        if (model.isEmpty()) {
+                            Zoo.count("backward walk not done: the list is empty");
+                        } else {
+                            // walk backwards from the end
+                            ListIterator<Integer> it = list.listIterator(model.size());
+                            List<Integer> back = new ArrayList<>();
+                            while (it.hasPrevious()) {
+                                back.add(0, it.previous());
+                            }
+                            Zoo.check(back.equals(model), () -> log + ": backward walk " + back);
+                        }
+                    }
+                    case ListOp.Clear cl -> {
+                        log.append(" clear");
+                        list.clear();
+                        model.clear();
+                    }
+                    case ListOp.SubList sl -> {
+                        int from = Math.floorMod(sl.from(), model.size() + 1);
+                        int to = from + Math.floorMod(sl.to(), model.size() - from + 1);
+                        Zoo.check(new ArrayList<>(list.subList(from, to)).equals(model.subList(from, to)), () -> log + ": subList(" + from + ", " + to + ") = " + list.subList(from, to));
+                    }
+                }
+                Zoo.check(list.equals(model) && model.equals(list) && list.size() == model.size() && list.hashCode() == model.hashCode() && list.isEmpty() == model.isEmpty(),
+                        () -> log + ": list " + list + " (size " + list.size() + "), model " + model);
+                Zoo.check(Arrays.equals(list.toArray(), model.toArray()) && new ArrayList<>(list).equals(model), () -> log + ": toArray " + Arrays.toString(list.toArray()));
+                for (int x = -1; x <= 9; x++) {
+                    Integer y = x < 0 ? null : x;
+                    Zoo.check(list.indexOf(y) == model.indexOf(y) && list.lastIndexOf(y) == model.lastIndexOf(y) && list.contains(y) == model.contains(y),
+                            () -> log + ": indexOf(" + y + ") = " + list.indexOf(y) + " lastIndexOf " + list.lastIndexOf(y) + ", model " + model.indexOf(y) + "/" + model.lastIndexOf(y));
+                }
+                for (int i = 0; i < model.size(); i++) {
+                    int ii = i;
+                    Zoo.check(Objects.equals(list.get(i), model.get(i)), () -> log + ": get(" + ii + ") = " + list.get(ii) + ", expected " + model.get(ii));
+                }
+                try {
+                    list.get(model.size());
+                    Zoo.fail(log + ": get(size) returned");
+                } catch (IndexOutOfBoundsException expected) {
+                    // as List
+                }
+                if (unique) {
+                    Zoo.check(((SetUniqueList<Integer>) list).asSet().equals(new LinkedHashSet<>(model)), () -> log + ": asSet " + ((SetUniqueList<Integer>) list).asSet());
+                }
+            }
+        });
+    }
+
+    // ---- the ring queue ------------------------------------------------------------------------
+
+    sealed interface QueueOp {
+        /** Enqueues through add (viaAdd) or offer. */
+        record Add(int e, boolean viaAdd) implements QueueOp {}
+
+        record Poll() implements QueueOp {}
+
+        /** remove() and element(): the head, or NoSuchElementException on an empty queue. */
+        record RemoveHead() implements QueueOp {}
+
+        /** Removes through the iterator after some elements (taken modulo the live size). */
+        record IterRemove(int at) implements QueueOp {}
+
+        record Clear() implements QueueOp {}
+
+        record Peek() implements QueueOp {}
+    }
+
+    static final Generator<QueueOp> QUEUE_OP = weighted(
+            w(30, tuples(ints(0, 99), chance(50)).<QueueOp>map(t -> new QueueOp.Add(t.value1(), t.value2()))),
+            Gen.<QueueOp>v(10, new QueueOp.Poll()),
+            Gen.<QueueOp>v(10, new QueueOp.RemoveHead()),
+            w(10, INDEX.<QueueOp>map(QueueOp.IterRemove::new)),
+            Gen.<QueueOp>v(1, new QueueOp.Clear()),
+            Gen.<QueueOp>v(10, new QueueOp.Peek()));
+
+    record QueueCase(int cap, List<QueueOp> ops) {}
+
+    static final Generator<QueueCase> QUEUE_CASE = tuples(ints(1, 6), many(QUEUE_OP, 0, 30)).map(t -> new QueueCase(t.value1(), t.value2()));
+
+    @Test
+    void ringQueueMatchesArrayDeque() {
+        Zoo.run("ringQueueMatchesArrayDeque", tc -> {
+            QueueCase c = tc.draw(QUEUE_CASE, "case");
+            int cap = c.cap();
+            CircularFifoQueue<Integer> q = new CircularFifoQueue<>(cap);
+            ArrayDeque<Integer> model = new ArrayDeque<>();
+            StringBuilder log = new StringBuilder("ring(" + cap + ")");
+            for (QueueOp op : c.ops()) {
+                switch (op) {
+                    case QueueOp.Add a -> {
+                        int e = a.e();
+                        log.append(a.viaAdd() ? " add(" : " offer(").append(e).append(')');
+                        boolean got = a.viaAdd() ? q.add(e) : q.offer(e);
+                        if (model.size() == cap) {
+                            model.pollFirst();
+                        }
+                        model.addLast(e);
+                        Zoo.check(got, () -> log + ": add/offer returned false");
+                    }
+                    case QueueOp.Poll p -> {
+                        log.append(" poll");
+                        Integer got = q.poll();
+                        Integer want = model.pollFirst();
+                        Zoo.check(Objects.equals(got, want), () -> log + ": poll returned " + got + ", expected " + want);
+                    }
+                    case QueueOp.RemoveHead rh -> {
+                        if (model.isEmpty()) {
+                            try {
+                                q.remove();
+                                Zoo.fail(log + ": remove() on an empty queue returned");
+                            } catch (NoSuchElementException expected) {
+                                // as Queue
+                            }
+                            try {
+                                q.element();
+                                Zoo.fail(log + ": element() on an empty queue returned");
+                            } catch (NoSuchElementException expected) {
+                                // as Queue
+                            }
+                        } else {
+                            log.append(" remove()");
+                            Integer got = q.remove();
+                            Integer want = model.removeFirst();
+                            Zoo.check(Objects.equals(got, want), () -> log + ": remove() returned " + got + ", expected " + want);
+                        }
+                    }
+                    case QueueOp.IterRemove ir -> {
+                        if (model.isEmpty()) {
+                            Zoo.count("iterator.remove not done: the queue is empty");
+                        } else {
+                            int at = Math.floorMod(ir.at(), model.size());
+                            Iterator<Integer> it = q.iterator();
+                            Integer removed = null;
+                            for (int i = 0; i <= at; i++) {
+                                removed = it.next();
+                            }
+                            log.append(" iterator.remove(at ").append(at).append(')');
+                            it.remove();
+                            List<Integer> rest = new ArrayList<>(model);
+                            rest.remove(at);
+                            model.clear();
+                            model.addAll(rest);
+                            List<Integer> tail = new ArrayList<>();
+                            while (it.hasNext()) {
+                                tail.add(it.next());
+                            }
+                            Zoo.check(tail.equals(rest.subList(at, rest.size())), () -> log + ": the iterator continued with " + tail + ", expected " + rest.subList(at, rest.size()));
+                        }
+                    }
+                    case QueueOp.Clear cl -> {
+                        log.append(" clear");
+                        q.clear();
+                        model.clear();
+                    }
+                    case QueueOp.Peek pk -> Zoo.check(Objects.equals(q.peek(), model.peekFirst()), () -> log + ": peek " + q.peek() + ", expected " + model.peekFirst());
+                }
+                List<Integer> want = new ArrayList<>(model);
+                Zoo.check(new ArrayList<>(q).equals(want) && q.size() == want.size() && q.isEmpty() == want.isEmpty() && Arrays.equals(q.toArray(), want.toArray()),
+                        () -> log + ": queue " + q + " (size " + q.size() + "), expected " + want);
+                Zoo.check(q.isAtFullCapacity() == (want.size() == cap) && !q.isFull() && q.maxSize() == cap, () -> log + ": isAtFullCapacity " + q.isAtFullCapacity() + " isFull " + q.isFull());
+                for (int i = 0; i < want.size(); i++) {
+                    int ii = i;
+                    Zoo.check(q.get(i).equals(want.get(i)), () -> log + ": get(" + ii + ") = " + q.get(ii) + ", expected " + want.get(ii));
+                }
+                try {
+                    q.get(want.size());
+                    Zoo.fail(log + ": get(size) returned");
+                } catch (NoSuchElementException expected) {
+                    // documented
+                }
+            }
+        });
+    }
+}
