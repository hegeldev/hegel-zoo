+    /** A sequence of up to twelve letters over "ab" (30%) or "abcd". */
+    static final Generator<List<Character>> LETTERS = weighted(w(30, word("ab", 0, 12)), w(70, word("abcd", 0, 12))).map(CommonsUtilsTest::letters);
