+        boolean hasPrevious = it.hasPrevious();
+        Object prev = hasPrevious ? outcome(it::previous) : "(none)";
+        Zoo.check(hasPrevious && "a".equals(prev), "after next(), next(), remove() on {a, b, c}: hasPrevious = " + hasPrevious + ", previous() -> " + kind(prev));
+    }
+}
