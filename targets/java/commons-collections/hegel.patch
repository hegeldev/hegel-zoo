+                    }
+                    case 9 -> {
+                        if (!model.isEmpty()) {
+                            // set a value through an entry
+                            int skip = Zoo.n(tc, 0, model.size() - 1);
+                            Iterator<Map.Entry<Object, Integer>> it = map.entrySet().iterator();
+                            for (int i = 0; i < skip; i++) {
+                                it.next();
+                            }
+                            Map.Entry<Object, Integer> e = it.next();
+                            int v = Zoo.n(tc, 0, 9);
+                            log.append(" entry(").append(e.getKey()).append(").setValue(").append(v).append(')');
+                            Integer old = e.setValue(v);
+                            Object ek = kind == MapKind.CASE_INSENSITIVE ? norm(e.getKey(), kind) : e.getKey();
+                            List<Object> order = new ArrayList<>(model.keySet());
+                            Integer want = model.get(ek);
+                            model.put(ek, v);
+                            if (kind == MapKind.LRU) {
