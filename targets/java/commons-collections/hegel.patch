+    static void view(String what, SetView<Integer> got, Set<Integer> want, Set<Integer> a, Set<Integer> b) {
+        Set<Integer> iterated = new HashSet<>();
+        for (Integer x : got) {
+            iterated.add(x);
+        }
+        Set<Integer> copy = new HashSet<>();
+        got.copyInto(copy);
+        Zoo.check(got.size() == want.size() && iterated.equals(want) && got.toSet().equals(want) && copy.equals(want) && got.isEmpty() == want.isEmpty()
+                && want.stream().allMatch(got::contains) && got.equals(want) && got.hashCode() == want.hashCode(),
+                () -> what + " view of " + a + " and " + b + ": size " + got.size() + ", iterated " + iterated + ", toSet " + got.toSet() + ", expected " + want);
+        for (int x = -1; x <= 8; x++) {
+            int y = x;
+            Zoo.check(got.contains(y) == want.contains(y), () -> what + " view of " + a + " and " + b + ": contains(" + y + ") = " + got.contains(y));
+        }
+        try {
+            got.add(9);
+            Zoo.fail(what + " view accepted add");
+        } catch (UnsupportedOperationException expected) {
+            // unmodifiable
+        }
+    }
