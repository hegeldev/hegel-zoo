+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String kind(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : "value " + o;
+    }
+
+    /** commons-collections/1: a null key that enters an LRUMap through an eviction is unreachable. */
+    @Test
+    void pin_lruMapNullKeyAfterEviction() {
+        LRUMap<String, Integer> map = new LRUMap<>(2);
+        map.put("a", 1);
+        map.put("b", 2);
+        map.put(null, 3);
+        Zoo.check(map.containsKey(null) && Integer.valueOf(3).equals(map.get(null)), "after put(a), put(b), put(null) into an LRUMap(2): keys " + map.keySet()
+                + ", containsKey(null) = " + map.containsKey(null) + ", get(null) = " + map.get(null));
+        map.put(null, 4);
+        Zoo.check(map.size() == 2 && new ArrayList<>(map.keySet()).stream().filter(k -> k == null).count() == 1, "a second put(null) gives " + map + " (size " + map.size() + ")");
+    }
+
+    /** commons-collections/2: setValue of the value already there fails after the key was re-put with an equal key object. */
+    @Test
