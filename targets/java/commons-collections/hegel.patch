+            List<Integer> list = switch (kind) {
+                case 0 -> new TreeList<>();
+                case 1 -> SetUniqueList.setUniqueList(new ArrayList<>());
+                default -> new GrowthList<>();
+            };
+            String name = kind == 0 ? "TreeList" : kind == 1 ? "SetUniqueList" : "GrowthList";
+            List<Integer> model = new ArrayList<>();
+            boolean unique = kind == 1;
+            int steps = Zoo.n(tc, 0, 30);
+            StringBuilder log = new StringBuilder(name);
+            for (int s = 0; s < steps; s++) {
+                Integer e = Zoo.chance(tc, 5) && !unique ? null : Zoo.n(tc, 0, 9);
+                int op = Zoo.n(tc, 0, 11);
+                switch (op) {
+                    case 0, 1 -> {
+                        log.append(" add(").append(e).append(')');
+                        boolean got = list.add(e);
+                        boolean want = !unique || !model.contains(e);
+                        if (want) {
+                            model.add(e);
+                        }
+                        Zoo.check(got == want, () -> log + ": add returned " + got);
+                    }
+                    case 2 -> {
+                        int i = Zoo.n(tc, 0, model.size() + (kind == 2 ? 3 : 0));
+                        log.append(" add(").append(i).append(", ").append(e).append(')');
+                        list.add(i, e);
+                        if (i > model.size()) {
+                            while (model.size() < i) {
+                                model.add(null);
+                            }
+                        }
+                        if (!unique || !model.contains(e)) {
+                            model.add(i, e);
+                        }
+                    }
+                    case 3 -> {
+                        if (!model.isEmpty()) {
+                            int i = Zoo.n(tc, 0, model.size() - 1);
+                            log.append(" remove(").append(i).append(')');
+                            Integer got = list.remove(i);
+                            Integer want = model.remove(i);
+                            Zoo.check(Objects.equals(got, want), () -> log + ": remove returned " + got + ", expected " + want);
+                        }
+                    }
+                    case 4 -> {
+                        if (!model.isEmpty()) {
+                            int i = Zoo.n(tc, 0, model.size() - 1 + (kind == 2 ? 3 : 0));
+                            log.append(" set(").append(i).append(", ").append(e).append(')');
+                            Integer got = list.set(i, e);
+                            Integer want;
+                            if (i >= model.size()) {
+                                while (model.size() <= i) {
+                                    model.add(null);
+                                }
+                                want = null;
+                                model.set(i, e);
+                            } else if (unique) {
+                                int pos = model.indexOf(e);
+                                want = model.set(i, e);
+                                if (pos >= 0 && pos != i) {
+                                    model.remove(pos);
+                                }
+                            } else {
+                                want = model.set(i, e);
+                            }
+                            Zoo.check(Objects.equals(got, want), () -> log + ": set returned " + got + ", expected " + want);
+                        }
+                    }
+                    case 5 -> {
+                        log.append(" remove(Object ").append(e).append(')');
+                        boolean got = list.remove(e);
+                        boolean want = model.remove(e);
+                        Zoo.check(got == want, () -> log + ": remove(Object) returned " + got);
+                    }
+                    case 6 -> {
+                        List<Integer> more = new ArrayList<>();
+                        int n = Zoo.n(tc, 0, 12);
+                        for (int i = 0; i < n; i++) {
+                            more.add(Zoo.n(tc, 0, 9));
+                        }
+                        List<Integer> src = kind == 0 && Zoo.chance(tc, 50) ? new TreeList<>(more) : more;
+                        if (Zoo.chance(tc, 50)) {
+                            log.append(" addAll(").append(more).append(')');
+                            list.addAll(src);
+                            for (Integer x : more) {
+                                if (!unique || !model.contains(x)) {
+                                    model.add(x);
+                                }
+                            }
+                        } else {
+                            int i = Zoo.n(tc, 0, model.size());
+                            log.append(" addAll(").append(i).append(", ").append(more).append(')');
+                            list.addAll(i, src);
+                            List<Integer> fresh = new ArrayList<>();
+                            for (Integer x : more) {
+                                if (!unique || !model.contains(x) && !fresh.contains(x)) {
+                                    fresh.add(x);
+                                }
+                            }
+                            model.addAll(i, fresh);
+                        }
+                    }
+                    case 7 -> {
+                        if (!model.isEmpty()) {
+                            // list iterator walk with a removal or a set
+                            int at = Zoo.n(tc, 0, model.size() - 1);
+                            ListIterator<Integer> it = list.listIterator();
+                            for (int i = 0; i <= at; i++) {
+                                it.next();
+                            }
+                            Zoo.check(it.nextIndex() == at + 1 && it.previousIndex() == at, () -> log + ": listIterator indexes " + it.nextIndex() + "/" + it.previousIndex() + " after " + (at + 1) + " next()s");
+                            if (Zoo.chance(tc, 50)) {
+                                log.append(" listIterator.remove(at ").append(at).append(')');
+                                it.remove();
+                                model.remove(at);
+                                if (it.hasNext()) {
+                                    Integer nxt = it.next();
+                                    Zoo.check(Objects.equals(nxt, model.get(at)), () -> log + ": next after remove = " + nxt + ", expected " + model.get(at));
+                                }
+                            } else if (!unique) {
+                                log.append(" listIterator.set(at ").append(at).append(", ").append(e).append(')');
+                                it.set(e);
+                                model.set(at, e);
+                                Integer prev = it.previous();
+                                Zoo.check(Objects.equals(prev, e), () -> log + ": previous after set = " + prev);
+                            }
+                        }
+                    }
+                    case 8 -> {
+                        if (kind == 0 && !model.isEmpty()) {
+                            // walk backwards from the end
+                            ListIterator<Integer> it = list.listIterator(model.size());
+                            List<Integer> back = new ArrayList<>();
+                            while (it.hasPrevious()) {
+                                back.add(0, it.previous());
+                            }
+                            Zoo.check(back.equals(model), () -> log + ": backward walk " + back);
+                        }
+                    }
+                    case 9 -> {
+                        if (Zoo.chance(tc, 10)) {
+                            log.append(" clear");
+                            list.clear();
+                            model.clear();
+                        }
+                    }
+                    default -> {
+                        if (!model.isEmpty()) {
+                            int from = Zoo.n(tc, 0, model.size());
+                            int to = Zoo.n(tc, from, model.size());
+                            Zoo.check(new ArrayList<>(list.subList(from, to)).equals(model.subList(from, to)), () -> log + ": subList(" + from + ", " + to + ") = " + list.subList(from, to));
+                        }
+                    }
+                }
+                Zoo.check(list.equals(model) && model.equals(list) && list.size() == model.size() && list.hashCode() == model.hashCode() && list.isEmpty() == model.isEmpty(),
+                        () -> log + ": list " + list + " (size " + list.size() + "), model " + model);
+                Zoo.check(Arrays.equals(list.toArray(), model.toArray()) && new ArrayList<>(list).equals(model), () -> log + ": toArray " + Arrays.toString(list.toArray()));
+                for (int x = -1; x <= 9; x++) {
+                    Integer y = x < 0 ? null : x;
+                    Zoo.check(list.indexOf(y) == model.indexOf(y) && list.lastIndexOf(y) == model.lastIndexOf(y) && list.contains(y) == model.contains(y),
+                            () -> log + ": indexOf(" + y + ") = " + list.indexOf(y) + " lastIndexOf " + list.lastIndexOf(y) + ", model " + model.indexOf(y) + "/" + model.lastIndexOf(y));
+                }
+                for (int i = 0; i < model.size(); i++) {
+                    int ii = i;
+                    Zoo.check(Objects.equals(list.get(i), model.get(i)), () -> log + ": get(" + ii + ") = " + list.get(ii) + ", expected " + model.get(ii));
+                }
+                try {
+                    list.get(model.size());
+                    Zoo.fail(log + ": get(size) returned");
+                } catch (IndexOutOfBoundsException expected) {
+                    // as List
+                }
+                if (unique) {
+                    Zoo.check(((SetUniqueList<Integer>) list).asSet().equals(new LinkedHashSet<>(model)), () -> log + ": asSet " + ((SetUniqueList<Integer>) list).asSet());
+                }
+            }
+        }, Zoo.settings("listsMatchArrayList"));
+    }
