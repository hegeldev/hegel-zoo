+                        }
+                    }
+                    if (kind == MapKind.LIST_ORDERED) {
+                        ListOrderedMap<Object, Integer> lo = (ListOrderedMap<Object, Integer>) map;
+                        Zoo.check(lo.keyList().equals(want) && lo.asList().equals(want) && lo.valueList().equals(new ArrayList<>(model.values())), () -> log + ": keyList " + lo.keyList() + " valueList " + lo.valueList());
+                        for (int i = 0; i < want.size(); i++) {
+                            int ii = i;
+                            Zoo.check(Objects.equals(lo.get(i), want.get(i)) && lo.getValue(i).equals(model.get(want.get(i))) && lo.indexOf(want.get(i)) == i,
