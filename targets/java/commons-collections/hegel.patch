+    @Test
+    void myersScriptIsShortestAndTransformsTheSequence() {
+        Hegel.test(tc -> {
+            List<Character> a = chars(tc);
+            List<Character> b = Zoo.chance(tc, 15) ? new ArrayList<>(a) : chars(tc);
+            if (Zoo.chance(tc, 30) && !a.isEmpty()) {
+                // b = a with a few edits
+                b = new ArrayList<>(a);
+                int edits = Zoo.n(tc, 1, 3);
+                for (int i = 0; i < edits && !b.isEmpty(); i++) {
+                    int at = Zoo.n(tc, 0, b.size() - 1);
+                    if (Zoo.chance(tc, 50)) {
+                        b.remove(at);
+                    } else {
+                        b.add(at, Zoo.pick(tc, 'a', 'b', 'c', 'd'));
+                    }
+                }
+            }
+            List<Character> bb = b;
+            int lcs = lcs(a, b);
+            EditScript<Character> script = new SequencesComparator<>(a, b).getScript();
+            List<Character> out = new ArrayList<>();
+            int[] pos = {0, 0};
+            List<String> ops = new ArrayList<>();
+            script.visit(new CommandVisitor<Character>() {
+                @Override
+                public void visitInsertCommand(Character c) {
+                    ops.add("+" + c);
+                    Zoo.check(pos[1] < bb.size() && bb.get(pos[1]).equals(c), () -> "insert " + c + " at b[" + pos[1] + "] transforming " + a + " -> " + bb + ": " + ops);
+                    out.add(c);
+                    pos[1]++;
+                }
+
+                @Override
+                public void visitKeepCommand(Character c) {
+                    ops.add("=" + c);
+                    Zoo.check(pos[0] < a.size() && pos[1] < bb.size() && a.get(pos[0]).equals(c) && bb.get(pos[1]).equals(c),
+                            () -> "keep " + c + " at a[" + pos[0] + "], b[" + pos[1] + "] transforming " + a + " -> " + bb + ": " + ops);
+                    out.add(c);
+                    pos[0]++;
+                    pos[1]++;
+                }
+
+                @Override
+                public void visitDeleteCommand(Character c) {
+                    ops.add("-" + c);
+                    Zoo.check(pos[0] < a.size() && a.get(pos[0]).equals(c), () -> "delete " + c + " at a[" + pos[0] + "] transforming " + a + " -> " + bb + ": " + ops);
+                    pos[0]++;
+                }
+            });
+            Zoo.check(out.equals(b) && pos[0] == a.size(), () -> "script " + ops + " turns " + a + " into " + out + ", not " + bb);
+            Zoo.check(script.getLCSLength() == lcs, () -> "getLCSLength = " + script.getLCSLength() + " for " + a + " -> " + bb + ", the LCS has " + lcs + "; script " + ops);
