+    static Map<Integer, Integer> positive(Map<Integer, Integer> m) {
+        Map<Integer, Integer> p = new HashMap<>();
+        m.forEach((k, v) -> {
+            if (v > 0) {
+                p.put(k, v);
+            }
+        });
+        return p;
+    }
