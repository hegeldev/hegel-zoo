+    // ---- multi-key map -------------------------------------------------------------------------
+
+    /** Two to five keys of 0..2, null one time in ten. */
+    static final Generator<List<Integer>> MULTI_KEY = many(weighted(w(90, ints(0, 2)), w(10, just((Integer) null))), 2, 5);
+
+    sealed interface MkOp {
+        List<Integer> keys();
+
+        record Put(List<Integer> keys, int v) implements MkOp {}
+
+        record Remove(List<Integer> keys) implements MkOp {}
+
+        /** Removes every entry under the first n keys (1..min(4, arity), taken modulo). */
+        record RemoveAll(List<Integer> keys, int n) implements MkOp {}
+
+        record Get(List<Integer> keys) implements MkOp {}
+    }
+
+    static final Generator<MkOp> MK_OP = weighted(
+            w(3, tuples(MULTI_KEY, VALUE).<MkOp>map(t -> new MkOp.Put(t.value1(), t.value2()))),
+            w(1, MULTI_KEY.<MkOp>map(MkOp.Remove::new)),
+            w(1, tuples(MULTI_KEY, INDEX).<MkOp>map(t -> new MkOp.RemoveAll(t.value1(), t.value2()))),
+            w(1, MULTI_KEY.<MkOp>map(MkOp.Get::new)));
+
+    static final Generator<List<MkOp>> MK_OPS = many(MK_OP, 0, 20);
+
+    @Test
+    void multiKeyMapMatchesAListKeyedMap() {
+        Zoo.run("multiKeyMapMatchesAListKeyedMap", tc -> {
+            MultiKeyMap<Integer, Integer> map = new MultiKeyMap<>();
+            Map<List<Integer>, Integer> model = new HashMap<>();
+            StringBuilder log = new StringBuilder("multikey");
+            for (MkOp op : tc.draw(MK_OPS, "ops")) {
+                Integer[] ks = op.keys().toArray(new Integer[0]);
+                int arity = ks.length;
+                List<Integer> lk = Arrays.asList(ks);
+                switch (op) {
+                    case MkOp.Put p -> {
+                        int v = p.v();
+                        log.append(" put(").append(lk).append(", ").append(v).append(')');
+                        Integer got = switch (arity) {
+                            case 2 -> map.put(ks[0], ks[1], v);
+                            case 3 -> map.put(ks[0], ks[1], ks[2], v);
+                            case 4 -> map.put(ks[0], ks[1], ks[2], ks[3], v);
+                            default -> map.put(ks[0], ks[1], ks[2], ks[3], ks[4], v);
+                        };
+                        Integer want = model.put(lk, v);
+                        Zoo.check(Objects.equals(got, want), () -> log + ": put returned " + got + ", expected " + want);
+                    }
+                    case MkOp.Remove r -> {
+                        log.append(" removeMultiKey(").append(lk).append(')');
+                        Integer got = switch (arity) {
+                            case 2 -> map.removeMultiKey(ks[0], ks[1]);
+                            case 3 -> map.removeMultiKey(ks[0], ks[1], ks[2]);
+                            case 4 -> map.removeMultiKey(ks[0], ks[1], ks[2], ks[3]);
+                            default -> map.removeMultiKey(ks[0], ks[1], ks[2], ks[3], ks[4]);
+                        };
+                        Integer want = model.remove(lk);
+                        Zoo.check(Objects.equals(got, want), () -> log + ": removeMultiKey returned " + got + ", expected " + want);
+                    }
+                    case MkOp.RemoveAll ra -> {
+                        int n = 1 + Math.floorMod(ra.n(), Math.min(4, arity));
+                        List<Integer> prefix = lk.subList(0, n);
+                        log.append(" removeAll(").append(prefix).append(')');
+                        boolean got = switch (n) {
+                            case 1 -> map.removeAll(ks[0]);
+                            case 2 -> map.removeAll(ks[0], ks[1]);
+                            case 3 -> map.removeAll(ks[0], ks[1], ks[2]);
+                            default -> map.removeAll(ks[0], ks[1], ks[2], ks[3]);
+                        };
+                        boolean want = model.keySet().removeIf(key -> key.size() >= n && key.subList(0, n).equals(prefix));
+                        Zoo.check(got == want, () -> log + ": removeAll returned " + got + ", expected " + want);
+                    }
+                    case MkOp.Get g -> {
+                        Integer got = switch (arity) {
+                            case 2 -> map.get(ks[0], ks[1]);
+                            case 3 -> map.get(ks[0], ks[1], ks[2]);
+                            case 4 -> map.get(ks[0], ks[1], ks[2], ks[3]);
+                            default -> map.get(ks[0], ks[1], ks[2], ks[3], ks[4]);
+                        };
+                        boolean has = switch (arity) {
+                            case 2 -> map.containsKey(ks[0], ks[1]);
+                            case 3 -> map.containsKey(ks[0], ks[1], ks[2]);
+                            case 4 -> map.containsKey(ks[0], ks[1], ks[2], ks[3]);
+                            default -> map.containsKey(ks[0], ks[1], ks[2], ks[3], ks[4]);
+                        };
+                        Zoo.check(Objects.equals(got, model.get(lk)) && has == model.containsKey(lk), () -> log + ": get(" + lk + ") = " + got + ", containsKey " + has + ", model " + model.get(lk));
+                    }
+                }
+                Map<List<Integer>, Integer> plain = new HashMap<>();
+                map.forEach((mk, v) -> {
+                    List<Integer> ks2 = new ArrayList<>();
+                    for (Object o : (Object[]) mk.getKeys()) {
+                        ks2.add((Integer) o);
+                    }
+                    plain.put(ks2, v);
+                });
+                Zoo.check(plain.equals(model) && map.size() == model.size(), () -> log + ": entries " + plain + ", model " + model);
+                for (Map.Entry<List<Integer>, Integer> e : model.entrySet()) {
+                    org.apache.commons.collections4.keyvalue.MultiKey<Integer> mk = new org.apache.commons.collections4.keyvalue.MultiKey<>(e.getKey().toArray(new Integer[0]));
+                    Zoo.check(e.getValue().equals(map.get(mk)) && map.containsKey(mk), () -> log + ": get(MultiKey " + e.getKey() + ") = " + map.get(mk));
+                }
+            }
+        });
+    }
