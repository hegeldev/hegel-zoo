+                            model.put(k, keep);
+                        }
+                        boolean wantChanged = !positive(before).equals(positive(model));
+                        Zoo.check(changed == wantChanged, () -> log + ": returned " + changed + ", the counts went " + positive(before) + " -> " + positive(model));
+                    }
+                    case BagOp.ContainsAll ca -> {
+                        List<Integer> other = ca.other();
+                        Map<Integer, Integer> co = counts(other);
+                        boolean want = bag != null ? co.entrySet().stream().allMatch(en -> count(model, en.getKey()) >= en.getValue())
+                                : co.keySet().stream().allMatch(k -> count(model, k) > 0);
+                        Zoo.check(coll.containsAll(other) == want, () -> log + ": containsAll(" + other + ") = " + !want + " with counts " + positive(model));
+                    }
+                    case BagOp.IterRemove ir -> {
+                        // iterator removal of one occurrence
+                        Iterator<Integer> it = coll.iterator();
+                        if (it.hasNext()) {
+                            Integer x = it.next();
+                            log.append(" iterator.remove(").append(x).append(')');
+                            it.remove();
+                            model.put(x, count(model, x) - 1);
+                        } else {
+                            Zoo.count("iterator.remove not done: the bag is empty");
+                        }
+                    }
+                }
+                Map<Integer, Integer> want = positive(model);
+                Map<Integer, Integer> got = counts(coll);
+                int size = want.values().stream().mapToInt(Integer::intValue).sum();
+                Zoo.check(got.equals(want) && coll.size() == size && coll.isEmpty() == (size == 0), () -> log + ": iterated counts " + got + ", size " + coll.size() + ", expected " + want);
+                for (int x = -1; x <= 6; x++) {
+                    Integer y = x;
+                    int cnt = bag != null ? bag.getCount(y) : ms.getCount(y);
+                    Zoo.check(cnt == count(want, y) && coll.contains(y) == (count(want, y) > 0), () -> log + ": getCount(" + y + ") = " + cnt + ", contains " + coll.contains(y));
+                }
+                Set<Integer> unique = bag != null ? bag.uniqueSet() : ms.uniqueSet();
+                Zoo.check(unique.equals(want.keySet()), () -> log + ": uniqueSet " + unique + ", expected " + want.keySet());
+                Zoo.check(coll.toArray().length == size, () -> log + ": toArray has " + coll.toArray().length + " elements");
+                if (kind.sorted() && !want.isEmpty()) {
+                    TreeMap<Integer, Integer> sortedWant = new TreeMap<>(want);
+                    List<Integer> order = new ArrayList<>(coll);
+                    List<Integer> sortedOrder = new ArrayList<>(order);
+                    sortedOrder.sort(null);
+                    Zoo.check(order.equals(sortedOrder), () -> log + ": iteration order " + order);
+                    if (bag != null) {
+                        SortedBag<Integer> sb = (SortedBag<Integer>) bag;
+                        Zoo.check(sb.first().equals(sortedWant.firstKey()) && sb.last().equals(sortedWant.lastKey()), () -> log + ": first " + sb.first() + ", last " + sb.last());
+                    } else {
+                        TreeMultiSet<Integer> tm = (TreeMultiSet<Integer>) ms;
+                        Zoo.check(tm.first().equals(sortedWant.firstKey()) && tm.last().equals(sortedWant.lastKey()), () -> log + ": first " + tm.first() + ", last " + tm.last());
+                    }
+                }
+                if (ms != null) {
+                    Map<Integer, Integer> entries = new HashMap<>();
+                    for (MultiSet.Entry<Integer> en : ms.entrySet()) {
+                        entries.put(en.getElement(), en.getCount());
+                    }
+                    Zoo.check(entries.equals(want) && ms.entrySet().size() == want.size(), () -> log + ": entrySet " + entries);
+                }
+            }
+            // equality with a copy built in another order
+            Collection<Integer> copy;
+            List<Integer> elems = new ArrayList<>(coll);
+            java.util.Collections.reverse(elems);
+            if (bag != null) {
+                copy = kind == Kind.HASH_BAG ? new HashBag<>(elems) : new TreeBag<>(elems);
+            } else {
+                copy = kind == Kind.HASH_MULTISET ? new HashMultiSet<>(elems) : new TreeMultiSet<>(elems);
+            }
+            Zoo.check(copy.equals(coll) && coll.equals(copy) && copy.hashCode() == coll.hashCode(), () -> log + ": a copy from the reversed elements is not equal: " + copy + " vs " + coll);
+        });
+    }
+
+    static Map<Integer, Integer> positive(Map<Integer, Integer> m) {
+        Map<Integer, Integer> p = new HashMap<>();
+        m.forEach((k, v) -> {
+            if (v > 0) {
+                p.put(k, v);
+            }
+        });
+        return p;
+    }
+
+    /** Length of the longest common subsequence by dynamic programming. */
+    static <T> int lcs(List<T> a, List<T> b) {
+        int[][] d = new int[a.size() + 1][b.size() + 1];
+        for (int i = 1; i <= a.size(); i++) {
+            for (int j = 1; j <= b.size(); j++) {
+                d[i][j] = a.get(i - 1).equals(b.get(j - 1)) ? d[i - 1][j - 1] + 1 : Math.max(d[i - 1][j], d[i][j - 1]);
+            }
+        }
+        return d[a.size()][b.size()];
+    }
+
+    @Test
+    void myersScriptIsShortestAndTransformsTheSequence() {
+        Zoo.run("myersScriptIsShortestAndTransformsTheSequence", tc -> {
+            DiffCase c = tc.draw(DIFF_CASE, "case");
+            List<Character> a = c.a();
+            List<Character> b = switch (c.second()) {
+                case Second.Same s -> new ArrayList<>(a);
+                case Second.Fresh f -> f.chars();
+                case Second.Edited e -> edited(a, e.edits());
+            };
+            List<Character> bb = b;
+            int lcs = lcs(a, b);
+            EditScript<Character> script = new SequencesComparator<>(a, b).getScript();
+            List<Character> out = new ArrayList<>();
+            int[] pos = {0, 0};
+            List<String> ops = new ArrayList<>();
+            script.visit(new CommandVisitor<Character>() {
+                @Override
+                public void visitInsertCommand(Character ch) {
+                    ops.add("+" + ch);
+                    Zoo.check(pos[1] < bb.size() && bb.get(pos[1]).equals(ch), () -> "insert " + ch + " at b[" + pos[1] + "] transforming " + a + " -> " + bb + ": " + ops);
+                    out.add(ch);
+                    pos[1]++;
+                }
+
+                @Override
+                public void visitKeepCommand(Character ch) {
+                    ops.add("=" + ch);
+                    Zoo.check(pos[0] < a.size() && pos[1] < bb.size() && a.get(pos[0]).equals(ch) && bb.get(pos[1]).equals(ch),
+                            () -> "keep " + ch + " at a[" + pos[0] + "], b[" + pos[1] + "] transforming " + a + " -> " + bb + ": " + ops);
+                    out.add(ch);
+                    pos[0]++;
+                    pos[1]++;
+                }
+
+                @Override
+                public void visitDeleteCommand(Character ch) {
+                    ops.add("-" + ch);
+                    Zoo.check(pos[0] < a.size() && a.get(pos[0]).equals(ch), () -> "delete " + ch + " at a[" + pos[0] + "] transforming " + a + " -> " + bb + ": " + ops);
+                    pos[0]++;
+                }
+            });
+            Zoo.check(out.equals(b) && pos[0] == a.size(), () -> "script " + ops + " turns " + a + " into " + out + ", not " + bb);
+            Zoo.check(script.getLCSLength() == lcs, () -> "getLCSLength = " + script.getLCSLength() + " for " + a + " -> " + bb + ", the LCS has " + lcs + "; script " + ops);
+            int mods = a.size() + b.size() - 2 * lcs;
+            Zoo.check(script.getModifications() == mods, () -> "getModifications = " + script.getModifications() + " for " + a + " -> " + bb + ", shortest is " + mods + "; script " + ops);
+
+            List<Character> common = ListUtils.longestCommonSubsequence(a, b);
+            Zoo.check(common.size() == lcs && subsequence(common, a) && subsequence(common, b),
+                    () -> "longestCommonSubsequence(" + a + ", " + bb + ") = " + common + ", the LCS has " + lcs);
+            StringBuilder sa = new StringBuilder();
+            StringBuilder sb = new StringBuilder();
+            a.forEach(sa::append);
+            b.forEach(sb::append);
+            String cs = ListUtils.longestCommonSubsequence(sa, sb);
+            Zoo.check(cs.length() == lcs, () -> "longestCommonSubsequence(\"" + sa + "\", \"" + sb + "\") = \"" + cs + "\", the LCS has " + lcs);
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..0b0c14b
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,131 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The combinators the binding lacks: weighted choice, a biased coin, an optional with a probability, int and long
+ * ranges, bounded lists, words over an alphabet, a tuple of any arity, and positions taken modulo a live size.
+ */
+final class Gen {
+    private Gen() {}
+
+    /** A weighted alternative for {@link #weighted}; the generator may produce a subtype of the choice's type. */
+    record Choice<T>(int weight, Generator<? extends T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<? extends T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** A constant alternative. */
+    static <T> Choice<T> v(int weight, T value) {
+        return new Choice<>(weight, just(value));
+    }
+
+    /** All the generators, in order, as one list (a tuple of any arity). */
+    static <T> Generator<List<T>> all(List<Generator<T>> gens) {
+        Generator<List<T>> acc = just(List.of());
+        for (Generator<T> g : gens) {
+            acc = tuples(acc, g).map(t -> {
+                List<T> out = new ArrayList<>(t.value1());
+                out.add(t.value2());
+                return out;
+            });
+        }
+        return acc;
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    static <T> Generator<T> weighted(List<Choice<T>> cs) {
+        int total = 0;
+        for (Choice<T> c : cs) {
+            total += c.weight();
+        }
+        return ints(0, total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : cs) {
+                acc += c.weight();
+                if (i < acc) {
+                    return widen(c.gen());
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** A generator of a subtype is a generator of the supertype: it only ever produces values. */
+    @SuppressWarnings("unchecked")
+    static <T> Generator<T> widen(Generator<? extends T> g) {
+        return (Generator<T>) g;
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return ints(0, 99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<? extends T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** One of the values, equally likely; shrinks to the first. */
+    @SafeVarargs
+    static <T> Generator<T> pick(T... xs) {
+        return sampledFrom(xs);
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A long in [lo, hi]; shrinks to lo. */
+    static Generator<Long> longs(long lo, long hi) {
+        return dev.hegel.Generators.longs().min(lo).max(hi);
+    }
+
+    /** A position, taken modulo the live size where it is used. */
+    static final Generator<Integer> INDEX = ints(0, 999);
+
+    /** lo..hi values of the generator. */
+    static <T> Generator<List<T>> many(Generator<T> g, int lo, int hi) {
+        return lists(g).minSize(lo).maxSize(hi);
+    }
+
+    /** One UTF-16 unit of the alphabet, as a string. */
+    static Generator<String> chars(String alphabet) {
+        List<String> cs = new ArrayList<>();
+        for (int i = 0; i < alphabet.length(); i++) {
+            cs.add(String.valueOf(alphabet.charAt(i)));
+        }
+        return sampledFrom(cs);
+    }
+
+    /** A string of lo..hi units drawn from the alphabet; shrinks to lo units of the first. */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        return many(chars(alphabet), lo, hi).map(parts -> String.join("", parts));
+    }
+
+    /** The element of the list at a drawn position, modulo its size (the list must not be empty). */
+    static <T> T at(List<T> xs, int index) {
+        return xs.get(Math.floorMod(index, xs.size()));
+    }
+
+    /** The element of a tape at a position, modulo its length; {@code plain} when the tape is empty. */
+    static <T> T tape(List<T> xs, int index, T plain) {
+        return xs.isEmpty() ? plain : at(xs, index);
+    }
+}
diff --git a/hegel/src/test/java/zoo/MapsTest.java b/hegel/src/test/java/zoo/MapsTest.java
new file mode 100644
index 0000000..93af2b9
--- /dev/null
+++ b/hegel/src/test/java/zoo/MapsTest.java
@@ -0,0 +1,1087 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.INDEX;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.many;
+import static zoo.Gen.maybe;
+import static zoo.Gen.pick;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+
+import dev.hegel.Generator;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.EnumMap;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.ListIterator;
+import java.util.Map;
+import java.util.NoSuchElementException;
+import java.util.Objects;
+import java.util.Set;
+import java.util.TreeMap;
+import org.apache.commons.collections4.BidiMap;
+import org.apache.commons.collections4.MapIterator;
+import org.apache.commons.collections4.OrderedBidiMap;
+import org.apache.commons.collections4.OrderedMap;
+import org.apache.commons.collections4.bidimap.DualHashBidiMap;
+import org.apache.commons.collections4.bidimap.DualLinkedHashBidiMap;
+import org.apache.commons.collections4.bidimap.DualTreeBidiMap;
+import org.apache.commons.collections4.bidimap.TreeBidiMap;
+import org.apache.commons.collections4.list.GrowthList;
+import org.apache.commons.collections4.list.SetUniqueList;
+import org.apache.commons.collections4.list.TreeList;
+import org.apache.commons.collections4.map.CaseInsensitiveMap;
+import org.apache.commons.collections4.map.Flat3Map;
+import org.apache.commons.collections4.map.HashedMap;
+import org.apache.commons.collections4.map.LRUMap;
+import org.apache.commons.collections4.map.LinkedMap;
+import org.apache.commons.collections4.map.ListOrderedMap;
+import org.apache.commons.collections4.map.MultiKeyMap;
+import org.apache.commons.collections4.queue.CircularFifoQueue;
+import org.junit.jupiter.api.Test;
+
+/** Maps, bidirectional maps, lists and the ring queue against java.util twins and small models under the same operations. */
+class MapsTest {
+
+    // ---- maps ----------------------------------------------------------------------------------
+
+    enum MapKind { HASHED, LINKED, LIST_ORDERED, FLAT3, CASE_INSENSITIVE, LRU }
+
+    /** A key of the kind: a few strings of mixed case, or a small int, null one time in twelve except for the LRU map. */
+    static Generator<Object> key(MapKind kind) {
+        return switch (kind) {
+            case CASE_INSENSITIVE -> pick("a", "A", "b", "B", "ab", "aB", "Ab", "c", "").<Object>map(s -> s);
+            // LRUMap and a null key under eviction is bug commons-collections/1's shape
+            case LRU -> ints(0, 6).<Object>map(i -> i);
+            default -> Gen.<Object>weighted(w(92, ints(0, 6)), Gen.<Object>v(8, null));
+        };
+    }
+
+    static final Generator<Integer> VALUE = ints(0, 9);
+
+    /** An operation on a map; positions are taken modulo the live size. */
+    sealed interface MapOp {
+        record Put(Object k, int v) implements MapOp {}
+
+        record Remove(Object k) implements MapOp {}
+
+        record Get(Object k) implements MapOp {}
+
+        record ContainsKey(Object k) implements MapOp {}
+
+        record PutAll(List<Put> more) implements MapOp {}
+
+        /** Removal through the keySet (0), entrySet (1) or map iterator (2) after skipping some entries. */
+        record IterRemove(int which, int skip) implements MapOp {}
+
+        /** Sets a value through an entry after skipping some. */
+        record SetValue(int skip, int v) implements MapOp {}
+
+        record Clear() implements MapOp {}
+
+        record ContainsValue(int v) implements MapOp {}
+
+        /** ListOrderedMap only: put at an index. */
+        record PutAt(int index, Object k, int v) implements MapOp {}
+    }
+
+    /** The operations of a kind: put four times as often as the queries, clear rarely, put-at-index for the list-ordered map. */
+    static Generator<MapOp> mapOp(MapKind kind) {
+        Generator<Object> k = key(kind);
+        Generator<MapOp.Put> put = tuples(k, VALUE).map(t -> new MapOp.Put(t.value1(), t.value2()));
+        List<Gen.Choice<MapOp>> cs = new ArrayList<>();
+        cs.add(w(20, put));
+        cs.add(w(5, k.<MapOp>map(MapOp.Remove::new)));
+        cs.add(w(5, k.<MapOp>map(MapOp.Get::new)));
+        cs.add(w(5, k.<MapOp>map(MapOp.ContainsKey::new)));
+        cs.add(w(5, many(put, 0, 4).<MapOp>map(MapOp.PutAll::new)));
+        cs.add(w(5, tuples(ints(0, 2), INDEX).<MapOp>map(t -> new MapOp.IterRemove(t.value1(), t.value2()))));
+        cs.add(w(5, tuples(INDEX, VALUE).<MapOp>map(t -> new MapOp.SetValue(t.value1(), t.value2()))));
+        cs.add(Gen.<MapOp>v(1, new MapOp.Clear()));
+        cs.add(w(5, VALUE.<MapOp>map(MapOp.ContainsValue::new)));
+        if (kind == MapKind.LIST_ORDERED) {
+            cs.add(w(20, tuples(INDEX, k, VALUE).<MapOp>map(t -> new MapOp.PutAt(t.value1(), t.value2(), t.value3()))));
+        }
+        return weighted(cs);
+    }
+
+    /** The map kind, the LRU map's capacity and scan flag (unused by the others), and the script. */
+    record MapCase(MapKind kind, int max, boolean scanUntilRemovable, List<MapOp> ops) {}
+
+    static Generator<MapCase> mapCase(MapKind kind) {
+        Generator<List<MapOp>> ops = many(mapOp(kind), 0, 25);
+        if (kind == MapKind.LRU) {
+            return tuples(ints(1, 5), chance(50), ops).map(t -> new MapCase(kind, t.value1(), t.value2(), t.value3()));
+        }
+        return ops.map(o -> new MapCase(kind, 1, false, o));
+    }
+
+    static final Map<MapKind, Generator<MapCase>> MAP_CASES = new EnumMap<>(MapKind.class);
+
+    static {
+        for (MapKind k : MapKind.values()) {
+            MAP_CASES.put(k, mapCase(k));
+        }
+    }
+
+    static final Generator<MapCase> MAP_CASE = pick(MapKind.values()).flatMap(MAP_CASES::get);
+
+    static String norm(Object k, MapKind kind) {
+        return kind == MapKind.CASE_INSENSITIVE ? ((String) k).toLowerCase() : String.valueOf(k);
+    }
+
+    /** The model's key for a map key: normalised for the case-insensitive map. */
+    static Object modelKey(Object k, MapKind kind) {
+        return kind == MapKind.CASE_INSENSITIVE ? norm(k, kind) : k;
+    }
+
+    @Test
+    void mapsMatchJavaUtil() {
+        Zoo.run("mapsMatchJavaUtil", tc -> {
+            MapCase c = tc.draw(MAP_CASE, "case");
+            MapKind kind = c.kind();
+            int max = c.max();
+            Map<Object, Integer> map = switch (kind) {
+                case HASHED -> new HashedMap<>();
+                case LINKED -> new LinkedMap<>();
+                case LIST_ORDERED -> new ListOrderedMap<>();
+                case FLAT3 -> new Flat3Map<>();
+                case CASE_INSENSITIVE -> new CaseInsensitiveMap<>();
+                case LRU -> new LRUMap<>(max, c.scanUntilRemovable());
+            };
+            // the model: a LinkedHashMap (access order for LRU), keys normalised for the case-insensitive map
+            LinkedHashMap<Object, Integer> model = kind == MapKind.LRU ? new LinkedHashMap<>(16, 0.75f, true) : new LinkedHashMap<>();
+            boolean ordered = kind == MapKind.LINKED || kind == MapKind.LIST_ORDERED || kind == MapKind.LRU;
+            StringBuilder log = new StringBuilder(kind + (kind == MapKind.LRU ? "(" + max + ")" : ""));
+            for (MapOp op : c.ops()) {
+                switch (op) {
+                    case MapOp.Put p -> {
+                        Object k = p.k();
+                        Object mk = modelKey(k, kind);
+                        int v = p.v();
+                        log.append(" put(").append(k).append(", ").append(v).append(')');
+                        Integer got = map.put(k, v);
+                        Integer want = model.put(mk, v);
+                        if (kind == MapKind.LRU && model.size() > max) {
+                            model.remove(model.keySet().iterator().next());
+                        }
+                        Zoo.check(Objects.equals(got, want), () -> log + ": put returned " + got + ", expected " + want);
+                    }
+                    case MapOp.Remove r -> {
+                        Object k = r.k();
+                        Object mk = modelKey(k, kind);
+                        log.append(" remove(").append(k).append(')');
+                        Integer got = map.remove(k);
+                        Integer want = model.remove(mk);
+                        Zoo.check(Objects.equals(got, want), () -> log + ": remove returned " + got + ", expected " + want);
+                    }
+                    case MapOp.Get g -> {
+                        Object k = g.k();
+                        Object mk = modelKey(k, kind);
+                        log.append(" get(").append(k).append(')');
+                        Integer got = map.get(k);
+                        Integer want = model.get(mk); // moves to the MRU position in the access-ordered model
+                        Zoo.check(Objects.equals(got, want), () -> log + ": get returned " + got + ", expected " + want);
+                    }
+                    case MapOp.ContainsKey ck -> {
+                        Object k = ck.k();
+                        Object mk = modelKey(k, kind);
+                        boolean got = map.containsKey(k);
+                        boolean want = model.containsKey(mk);
+                        Zoo.check(got == want, () -> log + ": containsKey(" + k + ") = " + got);
+                        if (kind == MapKind.LRU) {
+                            Integer g = ((LRUMap<Object, Integer>) map).get(k, false);
+                            Integer w = want ? model.get(mk) : null; // model.get moves it: undo by re-reading the order below
+                            Zoo.check(Objects.equals(g, w), () -> log + ": get(" + k + ", false) = " + g);
+                        }
+                        if (kind == MapKind.LRU && model.containsKey(mk)) {
+                            // the model's get moved mk to the end; the map's get(k, false) did not: put mk back where the map has it
+                            List<Object> order = new ArrayList<>(map.keySet());
+                            LinkedHashMap<Object, Integer> copy = new LinkedHashMap<>(16, 0.75f, true);
+                            for (Object o : order) {
+                                copy.put(o, model.get(o));
+                            }
+                            Zoo.check(copy.keySet().equals(model.keySet()), () -> log + ": get(k, false) changed the key set: " + map.keySet() + " vs " + model.keySet());
+                            Set<Object> before = new LinkedHashSet<>(order);
+                            before.remove(mk);
+                            List<Object> modelOrder = new ArrayList<>(model.keySet());
+                            modelOrder.remove(mk);
+                            Zoo.check(new ArrayList<>(before).equals(modelOrder), () -> log + ": get(k, false) reordered the map: " + order + " vs model " + model.keySet());
+                            model.clear();
+                            model.putAll(copy);
+                        }
+                    }
+                    case MapOp.PutAll pa -> {
+                        Map<Object, Integer> more = new LinkedHashMap<>();
+                        for (MapOp.Put p : pa.more()) {
+                            more.put(p.k(), p.v());
+                        }
+                        log.append(" putAll(").append(more).append(')');
+                        map.putAll(more);
+                        more.forEach((kk, v) -> {
+                            model.put(modelKey(kk, kind), v);
+                            if (kind == MapKind.LRU && model.size() > max) {
+                                model.remove(model.keySet().iterator().next());
+                            }
+                        });
+                    }
+                    case MapOp.IterRemove ir -> {
+                        if (model.isEmpty()) {
+                            Zoo.count("iterator.remove not done: the map is empty");
+                        } else {
+                            // removal through an iterator (keySet, entrySet or the map iterator)
+                            int which = ir.which();
+                            int skip = Math.floorMod(ir.skip(), model.size());
+                            Object removed;
+                            if (which == 0) {
+                                Iterator<Object> it = map.keySet().iterator();
+                                for (int i = 0; i < skip; i++) {
+                                    it.next();
+                                }
+                                removed = it.next();
+                                it.remove();
+                            } else if (which == 1) {
+                                Iterator<Map.Entry<Object, Integer>> it = map.entrySet().iterator();
+                                for (int i = 0; i < skip; i++) {
+                                    it.next();
+                                }
+                                removed = it.next().getKey();
+                                it.remove();
+                            } else {
+                                MapIterator<Object, Integer> it = ((org.apache.commons.collections4.IterableMap<Object, Integer>) map).mapIterator();
+                                for (int i = 0; i < skip; i++) {
+                                    it.next();
+                                }
+                                removed = it.next();
+                                it.remove();
+                            }
+                            log.append(" iterator.remove(").append(removed).append(')');
+                            Object rk = modelKey(removed, kind);
+                            Zoo.check(model.containsKey(rk), () -> log + ": the iterator removed a key the model does not have");
+                            model.remove(rk);
+                        }
+                    }
+                    case MapOp.SetValue sv -> {
+                        if (model.isEmpty()) {
+                            Zoo.count("entry.setValue not done: the map is empty");
+                        } else {
+                            // set a value through an entry
+                            int skip = Math.floorMod(sv.skip(), model.size());
+                            Iterator<Map.Entry<Object, Integer>> it = map.entrySet().iterator();
+                            for (int i = 0; i < skip; i++) {
+                                it.next();
+                            }
+                            Map.Entry<Object, Integer> e = it.next();
+                            int v = sv.v();
+                            log.append(" entry(").append(e.getKey()).append(").setValue(").append(v).append(')');
+                            Integer old = e.setValue(v);
+                            Object ek = modelKey(e.getKey(), kind);
+                            List<Object> order = new ArrayList<>(model.keySet());
+                            Integer want = model.get(ek);
+                            model.put(ek, v);
+                            if (kind == MapKind.LRU) {
+                                // iteration does not change the order: restore it
+                                LinkedHashMap<Object, Integer> copy = new LinkedHashMap<>(16, 0.75f, true);
+                                for (Object o : order) {
+                                    copy.put(o, model.get(o));
+                                }
+                                model.clear();
+                                model.putAll(copy);
+                            }
+                            Zoo.check(Objects.equals(old, want), () -> log + ": setValue returned " + old + ", expected " + want);
+                        }
+                    }
+                    case MapOp.Clear cl -> {
+                        log.append(" clear");
+                        map.clear();
+                        model.clear();
+                    }
+                    case MapOp.ContainsValue cv -> {
+                        int v = cv.v();
+                        boolean got = map.containsValue(v);
+                        boolean want = model.containsValue(v);
+                        Zoo.check(got == want, () -> log + ": containsValue(" + v + ") = " + got);
+                    }
+                    case MapOp.PutAt pa -> {
+                        // put at an index: the documented "relative to the original state" rule
+                        ListOrderedMap<Object, Integer> lo = (ListOrderedMap<Object, Integer>) map;
+                        List<Object> want = new ArrayList<>(model.keySet());
+                        Object pk = pa.k();
+                        int index = Math.floorMod(pa.index(), want.size() + 1);
+                        int v = pa.v();
+                        log.append(" put(").append(index).append(", ").append(pk).append(", ").append(v).append(')');
+                        Integer old = lo.put(index, pk, v);
+                        List<Object> keys = new ArrayList<>(want);
+                        Integer wantOld = model.get(pk);
+                        int pos = keys.indexOf(pk);
+                        if (pos >= 0) {
+                            keys.remove(pos);
+                            keys.add(pos < index ? index - 1 : index, pk);
+                        } else {
+                            keys.add(index, pk);
+                        }
+                        LinkedHashMap<Object, Integer> rebuilt = new LinkedHashMap<>();
+                        for (Object o : keys) {
+                            rebuilt.put(o, Objects.equals(o, pk) ? v : model.get(o));
+                        }
+                        model.clear();
+                        model.putAll(rebuilt);
+                        Zoo.check(Objects.equals(old, wantOld) && lo.keyList().equals(keys), () -> log + ": put(index) returned " + old + " (expected " + wantOld + "), keys " + lo.keyList() + ", expected " + keys);
+                    }
+                }
+                // compare
+                Map<Object, Integer> plain = new HashMap<>(map);
+                Zoo.check(plain.equals(model) && map.size() == model.size() && map.isEmpty() == model.isEmpty() && map.equals(model) && map.hashCode() == model.hashCode(),
+                        () -> log + ": map " + map + " (size " + map.size() + "), model " + model);
+                if (ordered) {
+                    List<Object> order = new ArrayList<>(map.keySet());
+                    List<Object> want = new ArrayList<>(model.keySet());
+                    Zoo.check(order.equals(want), () -> log + ": key order " + order + ", model " + want);
+                    List<Integer> values = new ArrayList<>(map.values());
+                    Zoo.check(values.equals(new ArrayList<>(model.values())), () -> log + ": value order " + values + ", model " + model.values());
+                    OrderedMap<Object, Integer> om = (OrderedMap<Object, Integer>) map;
+                    if (!want.isEmpty()) {
+                        Object first = want.get(0);
+                        Object last = want.get(want.size() - 1);
+                        Zoo.check(Objects.equals(om.firstKey(), first) && Objects.equals(om.lastKey(), last), () -> log + ": firstKey " + om.firstKey() + " lastKey " + om.lastKey());
+                        for (int i = 0; i < want.size(); i++) {
+                            int ii = i;
+                            Object next = om.nextKey(want.get(i));
+                            Object prev = om.previousKey(want.get(i));
+                            Zoo.check(Objects.equals(next, i + 1 < want.size() ? want.get(i + 1) : null) && Objects.equals(prev, i > 0 ? want.get(i - 1) : null),
+                                    () -> log + ": nextKey/previousKey of " + want.get(ii) + " = " + next + " / " + prev + " in " + want);
+                        }
+                    } else {
+                        try {
+                            om.firstKey();
+                            Zoo.fail(log + ": firstKey on an empty map returned");
+                        } catch (NoSuchElementException expected) {
+                            // documented
+                        }
+                    }
+                    if (kind == MapKind.LINKED) {
+                        LinkedMap<Object, Integer> lm = (LinkedMap<Object, Integer>) map;
+                        Zoo.check(lm.asList().equals(want), () -> log + ": asList " + lm.asList());
+                        for (int i = 0; i < want.size(); i++) {
+                            int ii = i;
+                            Zoo.check(Objects.equals(lm.get(i), want.get(i)) && lm.getValue(i).equals(model.get(want.get(i))) && lm.indexOf(want.get(i)) == i,
+                                    () -> log + ": get(" + ii + ") = " + lm.get(ii) + ", getValue " + lm.getValue(ii) + ", indexOf " + lm.indexOf(want.get(ii)));
+                        }
+                    }
+                    if (kind == MapKind.LIST_ORDERED) {
+                        ListOrderedMap<Object, Integer> lo = (ListOrderedMap<Object, Integer>) map;
+                        Zoo.check(lo.keyList().equals(want) && lo.asList().equals(want) && lo.valueList().equals(new ArrayList<>(model.values())), () -> log + ": keyList " + lo.keyList() + " valueList " + lo.valueList());
+                        for (int i = 0; i < want.size(); i++) {
+                            int ii = i;
+                            Zoo.check(Objects.equals(lo.get(i), want.get(i)) && lo.getValue(i).equals(model.get(want.get(i))) && lo.indexOf(want.get(i)) == i,
+                                    () -> log + ": get(" + ii + ") = " + lo.get(ii));
+                        }
+                    }
+                    if (kind == MapKind.LRU) {
+                        LRUMap<Object, Integer> lru = (LRUMap<Object, Integer>) map;
+                        Zoo.check(lru.isFull() == (model.size() >= max) && lru.maxSize() == max, () -> log + ": isFull " + lru.isFull() + " with " + model.size() + " of " + max);
+                    }
+                }
+                if (kind == MapKind.CASE_INSENSITIVE) {
+                    for (Object o : map.keySet()) {
+                        Zoo.check(o == null || o.equals(((String) o).toLowerCase()), () -> log + ": keySet holds " + o);
+                    }
+                }
+            }
+        });
+    }
