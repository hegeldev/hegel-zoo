+                        for (int i = 0; i < want.size(); i++) {
+                            int ii = i;
+                            // an absent key is bug commons-collections/3's shape for DualTreeBidiMap: only present keys here
+                            Zoo.check(Objects.equals(om.nextKey(want.get(i)), i + 1 < want.size() ? want.get(i + 1) : null)
+                                    && Objects.equals(om.previousKey(want.get(i)), i > 0 ? want.get(i - 1) : null),
+                                    () -> log + ": nextKey/previousKey of " + want.get(ii) + " = " + om.nextKey(want.get(ii)) + " / " + om.previousKey(want.get(ii)));
+                        }
+                    }
+                    if (kind == BidiKind.DUAL_TREE) {
+                        // read-only sub-map views (writing through them is bug commons-collections/4's shape)
+                        DualTreeBidiMap<Integer, Integer> dt = (DualTreeBidiMap<Integer, Integer>) map;
+                        int lo = Zoo.n(tc, 0, 3);
+                        int hi = Zoo.n(tc, lo, 7);
+                        TreeMap<Integer, Integer> tm = new TreeMap<>(fwd);
+                        Zoo.check(new TreeMap<>(dt.headMap(hi)).equals(tm.headMap(hi)) && new TreeMap<>(dt.tailMap(lo)).equals(tm.tailMap(lo)) && new TreeMap<>(dt.subMap(lo, hi)).equals(tm.subMap(lo, hi))
+                                && dt.headMap(hi).size() == tm.headMap(hi).size() && dt.subMap(lo, hi).size() == tm.subMap(lo, hi).size(),
+                                () -> log + ": views headMap(" + hi + ") " + dt.headMap(hi) + " tailMap(" + lo + ") " + dt.tailMap(lo) + " subMap " + dt.subMap(lo, hi));
+                        for (int x = 0; x <= 6; x++) {
+                            int y = x;
+                            Zoo.check(dt.headMap(hi).containsValue(y) == tm.headMap(hi).containsValue(y), () -> log + ": headMap(" + hi + ").containsValue(" + y + ")");
+                        }
+                    }
+                } else if (kind == BidiKind.DUAL_LINKED) {
+                    Zoo.check(keys.equals(new ArrayList<>(fwd.keySet())), () -> log + ": key order " + keys + ", model " + fwd.keySet());
+                }
+                // the map iterator agrees with the key set
+                List<Integer> viaIterator = new ArrayList<>();
+                MapIterator<Integer, Integer> mi = map.mapIterator();
+                while (mi.hasNext()) {
+                    Integer key = mi.next();
+                    viaIterator.add(key);
+                    Zoo.check(mi.getKey().equals(key) && mi.getValue().equals(fwd.get(key)), () -> log + ": mapIterator at " + key);
+                }
+                Zoo.check(viaIterator.equals(keys), () -> log + ": mapIterator order " + viaIterator + ", keySet " + keys);
+            }
+            if (kind == BidiKind.TREE) {
+                try {
+                    map.put(null, 1);
+                    Zoo.fail(log + ": TreeBidiMap accepted a null key");
+                } catch (NullPointerException expected) {
+                    // documented
+                }
+            }
+        }, Zoo.settings("bidiMapsKeepTheInverse"));
+    }
