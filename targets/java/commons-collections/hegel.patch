+import org.junit.jupiter.api.Test;
+
+/** PatriciaTrie against TreeMap: the map itself, its ordered views, the prefix view and the iterators. */
+class TrieTest {
+
+    static final String ALPHABET = "ab" + (char) 0 + "é中😀B";
+
+    static String key(TestCase tc) {
+        return Zoo.word(tc, Zoo.chance(tc, 70) ? "ab" : ALPHABET, 0, 4);
+    }
+
+    static String show(SortedMap<String, Integer> m) {
+        StringBuilder sb = new StringBuilder("{");
+        m.forEach((k, v) -> sb.append(sb.length() > 1 ? ", " : "").append(Zoo.show(k)).append('=').append(v));
+        return sb.append('}').toString();
+    }
+
+    static void same(String what, SortedMap<String, Integer> got, SortedMap<String, Integer> want, StringBuilder log) {
+        List<String> gk = new ArrayList<>(got.keySet());
+        List<String> wk = new ArrayList<>(want.keySet());
+        Zoo.check(gk.equals(wk), () -> log + ": " + what + " keys " + gk.stream().map(Zoo::show).toList() + ", expected " + wk.stream().map(Zoo::show).toList());
+        Zoo.check(new TreeMap<>(got).equals(want) && got.size() == want.size() && got.isEmpty() == want.isEmpty(),
+                () -> log + ": " + what + " = " + show(got) + " (size " + got.size() + "), expected " + show(want));
+        List<Integer> gv = new ArrayList<>(got.values());
+        Zoo.check(gv.equals(new ArrayList<>(want.values())), () -> log + ": " + what + " values " + gv + ", expected " + want.values());
+        if (want.isEmpty()) {
+            for (boolean first : new boolean[] {true, false}) {
+                try {
+                    String k = first ? got.firstKey() : got.lastKey();
+                    Zoo.check(false, () -> log + ": " + what + " is empty but " + (first ? "firstKey" : "lastKey") + " = " + Zoo.show(k));
+                } catch (NoSuchElementException expected) {
+                    // documented
+                }
+            }
+        } else if (want.size() == 1 && want.firstKey().isEmpty()) {
+            // lastKey() of a trie holding only "" throws: bug commons-collections/10, carried by its pin
+            Zoo.check(got.firstKey().equals(want.firstKey()), () -> log + ": " + what + " firstKey " + Zoo.show(got.firstKey()));
+        } else {
+            Zoo.check(got.firstKey().equals(want.firstKey()) && got.lastKey().equals(want.lastKey()),
+                    () -> log + ": " + what + " firstKey " + Zoo.show(got.firstKey()) + " lastKey " + Zoo.show(got.lastKey()) + ", expected " + Zoo.show(want.firstKey()) + " / " + Zoo.show(want.lastKey()));
+        }
+        Zoo.check(got.equals(want) && want.equals(got) && got.hashCode() == want.hashCode(), () -> log + ": " + what + " equals/hashCode differ from the TreeMap " + show(want));
+    }
+
+    static SortedMap<String, Integer> prefixed(TreeMap<String, Integer> m, String prefix) {
+        TreeMap<String, Integer> out = new TreeMap<>();
+        m.forEach((k, v) -> {
+            if (k.startsWith(prefix)) {
+                out.put(k, v);
+            }
+        });
+        return out;
+    }
+
+    @Test
+    void trieMatchesTreeMap() {
+        Hegel.test(tc -> {
+            PatriciaTrie<Integer> trie = new PatriciaTrie<>();
+            TreeMap<String, Integer> model = new TreeMap<>();
+            int steps = Zoo.n(tc, 0, 20);
+            StringBuilder log = new StringBuilder("trie");
+            boolean anyRemoval = false;
+            for (int s = 0; s < steps; s++) {
+                String drawn = key(tc);
+                int op = Zoo.n(tc, 0, 9);
+                // putting "" after a removal hides every other entry from iteration: bug commons-collections/14, carried by its pin
+                String k = drawn.isEmpty() && anyRemoval && op < 5 ? "a" : drawn;
+                if (op < 5) {
+                    int v = Zoo.n(tc, 0, 99);
+                    log.append(" put(").append(Zoo.show(k)).append(", ").append(v).append(')');
+                    Integer got = trie.put(k, v);
+                    Integer want = model.put(k, v);
+                    Zoo.check(java.util.Objects.equals(got, want), () -> log + ": put returned " + got + ", expected " + want);
+                } else if (op < 7) {
+                    log.append(" remove(").append(Zoo.show(k)).append(')');
+                    Integer got = trie.remove(k);
+                    Integer want = model.remove(k);
+                    anyRemoval |= want != null;
+                    Zoo.check(java.util.Objects.equals(got, want), () -> log + ": remove returned " + got + ", expected " + want);
+                } else if (op < 8 && !model.isEmpty()) {
+                    // remove through a view iterator
+                    Iterator<Map.Entry<String, Integer>> it = trie.entrySet().iterator();
+                    int skip = Zoo.n(tc, 0, model.size() - 1);
+                    Map.Entry<String, Integer> e = null;
+                    for (int i = 0; i <= skip; i++) {
+                        e = it.next();
+                    }
+                    log.append(" entrySet.remove(").append(Zoo.show(e.getKey())).append(')');
+                    // the entry is the trie's node: remove() nulls its key, so keep the key first
+                    String removedKey = e.getKey();
+                    Zoo.check(removedKey != null && model.containsKey(removedKey), () -> log + ": the entry iterator returned " + Zoo.show(removedKey) + " which the model does not have (" + model.keySet().stream().map(Zoo::show).toList() + ")");
+                    it.remove();
+                    model.remove(removedKey);
+                    anyRemoval = true;
+                } else {
+                    Zoo.check(java.util.Objects.equals(trie.get(k), model.get(k)) && trie.containsKey(k) == model.containsKey(k),
+                            () -> log + ": get(" + Zoo.show(k) + ") = " + trie.get(k) + ", expected " + model.get(k));
+                }
+                same("trie", trie, model, log);
+                // lastKey/firstKey on a trie holding only "" is bug commons-collections/10's shape and checked by same() otherwise
+                if (!model.isEmpty()) {
+                    String probe = Zoo.chance(tc, 60) ? Zoo.pick(tc, model.keySet().toArray(new String[0])) : key(tc);
+                    String next = trie.nextKey(probe);
+                    String prev = trie.previousKey(probe);
+                    String wantNext = model.containsKey(probe) ? model.higherKey(probe) : null;
+                    String wantPrev = model.containsKey(probe) ? model.lowerKey(probe) : null;
+                    Zoo.check(java.util.Objects.equals(next, wantNext) && java.util.Objects.equals(prev, wantPrev),
+                            () -> log + ": nextKey(" + Zoo.show(probe) + ") = " + Zoo.show(next) + " / previousKey = " + Zoo.show(prev) + ", expected " + Zoo.show(wantNext) + " / " + Zoo.show(wantPrev));
+                    Zoo.check(trie.select(probe) != null && model.containsKey(trie.select(probe).getKey())
+                            && (!model.containsKey(probe) || trie.selectKey(probe).equals(probe) && trie.selectValue(probe).equals(model.get(probe))),
+                            () -> log + ": select(" + Zoo.show(probe) + ") = " + trie.select(probe));
+                }
+                Zoo.check(!trie.containsKey(null) && trie.get(null) == null, () -> log + ": containsKey(null)/get(null)");
+            }
+            // ordered views against TreeMap's
+            String a = key(tc);
+            String b = key(tc);
+            String lo = a.compareTo(b) <= 0 ? a : b;
+            String hi = a.compareTo(b) <= 0 ? b : a;
+            // an empty trie's headMap(x).lastKey() is bug commons-collections/9's shape: only checked with entries
+            if (!model.isEmpty()) {
+                same("headMap(" + Zoo.show(hi) + ")", trie.headMap(hi), model.headMap(hi), log);
+            }
+            same("tailMap(" + Zoo.show(lo) + ")", trie.tailMap(lo), model.tailMap(lo), log);
+            same("subMap(" + Zoo.show(lo) + ", " + Zoo.show(hi) + ")", trie.subMap(lo, hi), model.subMap(lo, hi), log);
+            SortedMap<String, Integer> view = trie.subMap(lo, hi);
+            for (String k : List.of(a, b, key(tc))) {
+                boolean in = k.compareTo(lo) >= 0 && k.compareTo(hi) < 0;
+                Zoo.check(view.containsKey(k) == (in && model.containsKey(k)) && java.util.Objects.equals(view.get(k), in ? model.get(k) : null),
+                        () -> log + ": subMap containsKey(" + Zoo.show(k) + ") = " + view.containsKey(k));
+            }
+            if (lo.compareTo(hi) < 0) {
+                try {
+                    trie.subMap(hi, lo);
+                    Zoo.fail(log + ": subMap(" + Zoo.show(hi) + ", " + Zoo.show(lo) + ") accepted an inverted range");
+                } catch (IllegalArgumentException expected) {
+                    // documented
+                }
+            }
+            // the prefix view
+            String prefix = Zoo.chance(tc, 50) && !model.isEmpty() ? Zoo.pick(tc, model.keySet().toArray(new String[0])) : key(tc);
+            if (Zoo.chance(tc, 40) && prefix.length() > 1) {
+                prefix = prefix.substring(0, Zoo.n(tc, 1, prefix.length() - 1));
+            }
+            String p = prefix;
+            SortedMap<String, Integer> pm = trie.prefixMap(p);
+            SortedMap<String, Integer> wantPm = prefixed(model, p);
+            same("prefixMap(" + Zoo.show(p) + ")", pm, wantPm, log);
+            for (String k : List.of(a, b, p)) {
+                Zoo.check(pm.containsKey(k) == wantPm.containsKey(k) && java.util.Objects.equals(pm.get(k), wantPm.get(k)),
+                        () -> log + ": prefixMap(" + Zoo.show(p) + ").containsKey(" + Zoo.show(k) + ") = " + pm.containsKey(k) + ", expected " + wantPm.containsKey(k));
+            }
+            // the prefix view is live
+            String extra = p + Zoo.word(tc, "ab", 0, 2);
+            if (!model.containsKey(extra) && !(extra.isEmpty() && anyRemoval)) { // "" after a removal: bug commons-collections/14
+                trie.put(extra, -1);
+                model.put(extra, -1);
+                SortedMap<String, Integer> wantPm2 = prefixed(model, p);
+                same("prefixMap(" + Zoo.show(p) + ") after put(" + Zoo.show(extra) + ")", pm, wantPm2, log);
+                if (!p.isEmpty()) {
+                    // removing through the view (bug commons-collections/12: emptying the view through its iterator NPEs; one entry stays)
+                    Iterator<Map.Entry<String, Integer>> it = pm.entrySet().iterator();
+                    int removed = 0;
+                    while (it.hasNext()) {
+                        String key = it.next().getKey(); // the node's key is nulled by remove()
+                        if (Zoo.chance(tc, 50) && wantPm2.size() - removed > 1) {
+                            it.remove();
+                            model.remove(key);
+                            removed++;
+                        }
+                    }
+                    same("prefixMap(" + Zoo.show(p) + ") after iterator removals", pm, prefixed(model, p), log);
+                    same("trie after prefix removals", trie, model, log);
+                }
+            }
+            // the map iterator walks the entries in order, both ways
+            OrderedMapIterator<String, Integer> mi = trie.mapIterator();
+            List<String> forward = new ArrayList<>();
+            while (mi.hasNext()) {
+                String k = mi.next();
+                forward.add(k);
+                Zoo.check(mi.getKey().equals(k) && mi.getValue().equals(model.get(k)), () -> log + ": mapIterator getKey/getValue at " + Zoo.show(k));
+            }
+            List<String> backward = new ArrayList<>();
+            while (mi.hasPrevious()) {
+                backward.add(0, mi.previous());
+            }
+            Zoo.check(forward.equals(new ArrayList<>(model.keySet())) && backward.equals(forward), () -> log + ": mapIterator forward " + forward + ", backward " + backward);
+            // serialization
+            try {
+                ByteArrayOutputStream bos = new ByteArrayOutputStream();
+                try (ObjectOutputStream oos = new ObjectOutputStream(bos)) {
+                    oos.writeObject(trie);
+                }
+                @SuppressWarnings("unchecked")
+                PatriciaTrie<Integer> back = (PatriciaTrie<Integer>) new ObjectInputStream(new ByteArrayInputStream(bos.toByteArray())).readObject();
+                same("deserialized trie", back, model, log);
+            } catch (IOException | ClassNotFoundException e) {
+                Zoo.fail(log + ": serialization failed: " + e);
+            }
+            try {
+                trie.put(null, 1);
+                Zoo.fail(log + ": put(null) accepted");
+            } catch (NullPointerException expected) {
+                // documented
+            }
+        }, Zoo.settings("trieMatchesTreeMap"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..2ca81bf
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,120 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+
+    /** Rethrows any throwable unchecked (for control-flow exceptions such as Hegel's that must not be swallowed). */
+    @SuppressWarnings("unchecked")
+    static <T extends Throwable> void sneaky(Throwable t) throws T {
+        throw (T) t;
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
