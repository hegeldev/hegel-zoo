+    // ---- the drawn data ------------------------------------------------------------------------
+
+    /** A small int, and (nulls) one time in ten null. */
+    static Generator<Integer> element(boolean nulls, int nullPct) {
+        return nulls ? weighted(w(100 - nullPct, ints(0, 5)), w(nullPct, just((Integer) null))) : ints(0, 5);
+    }
+
+    /** A small list of ints with repetitions (and sometimes nulls). */
+    static Generator<List<Integer>> smallInts(boolean nulls) {
