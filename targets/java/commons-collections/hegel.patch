+    @Test
+    void ringQueueMatchesArrayDeque() {
+        Hegel.test(tc -> {
+            int cap = Zoo.n(tc, 1, 6);
+            CircularFifoQueue<Integer> q = new CircularFifoQueue<>(cap);
+            ArrayDeque<Integer> model = new ArrayDeque<>();
+            int steps = Zoo.n(tc, 0, 30);
+            StringBuilder log = new StringBuilder("ring(" + cap + ")");
+            for (int s = 0; s < steps; s++) {
+                int e = Zoo.n(tc, 0, 99);
+                int op = Zoo.n(tc, 0, 7);
+                switch (op) {
+                    case 0, 1, 2 -> {
+                        log.append(Zoo.chance(tc, 50) ? " add(" : " offer(").append(e).append(')');
+                        boolean got = log.charAt(log.length() - 2 - String.valueOf(e).length() - 1) == 'd' ? q.add(e) : q.offer(e);
+                        if (model.size() == cap) {
+                            model.pollFirst();
+                        }
+                        model.addLast(e);
+                        Zoo.check(got, () -> log + ": add/offer returned false");
+                    }
+                    case 3 -> {
+                        log.append(" poll");
+                        Integer got = q.poll();
+                        Integer want = model.pollFirst();
+                        Zoo.check(Objects.equals(got, want), () -> log + ": poll returned " + got + ", expected " + want);
+                    }
+                    case 4 -> {
+                        if (model.isEmpty()) {
+                            try {
+                                q.remove();
+                                Zoo.fail(log + ": remove() on an empty queue returned");
+                            } catch (NoSuchElementException expected) {
+                                // as Queue
+                            }
+                            try {
+                                q.element();
+                                Zoo.fail(log + ": element() on an empty queue returned");
+                            } catch (NoSuchElementException expected) {
+                                // as Queue
+                            }
+                        } else {
+                            log.append(" remove()");
+                            Integer got = q.remove();
+                            Integer want = model.removeFirst();
+                            Zoo.check(Objects.equals(got, want), () -> log + ": remove() returned " + got + ", expected " + want);
+                        }
+                    }
+                    case 5 -> {
+                        if (!model.isEmpty()) {
+                            int at = Zoo.n(tc, 0, model.size() - 1);
+                            Iterator<Integer> it = q.iterator();
+                            Integer removed = null;
+                            for (int i = 0; i <= at; i++) {
+                                removed = it.next();
+                            }
+                            log.append(" iterator.remove(at ").append(at).append(')');
+                            it.remove();
+                            List<Integer> rest = new ArrayList<>(model);
+                            rest.remove(at);
+                            model.clear();
+                            model.addAll(rest);
+                            List<Integer> tail = new ArrayList<>();
+                            while (it.hasNext()) {
+                                tail.add(it.next());
+                            }
+                            Zoo.check(tail.equals(rest.subList(at, rest.size())), () -> log + ": the iterator continued with " + tail + ", expected " + rest.subList(at, rest.size()));
+                        }
+                    }
+                    case 6 -> {
+                        if (Zoo.chance(tc, 10)) {
+                            log.append(" clear");
+                            q.clear();
+                            model.clear();
+                        }
+                    }
+                    default -> {
+                        Zoo.check(Objects.equals(q.peek(), model.peekFirst()), () -> log + ": peek " + q.peek() + ", expected " + model.peekFirst());
+                    }
+                }
+                List<Integer> want = new ArrayList<>(model);
+                Zoo.check(new ArrayList<>(q).equals(want) && q.size() == want.size() && q.isEmpty() == want.isEmpty() && Arrays.equals(q.toArray(), want.toArray()),
+                        () -> log + ": queue " + q + " (size " + q.size() + "), expected " + want);
+                Zoo.check(q.isAtFullCapacity() == (want.size() == cap) && !q.isFull() && q.maxSize() == cap, () -> log + ": isAtFullCapacity " + q.isAtFullCapacity() + " isFull " + q.isFull());
+                for (int i = 0; i < want.size(); i++) {
+                    int ii = i;
+                    Zoo.check(q.get(i).equals(want.get(i)), () -> log + ": get(" + ii + ") = " + q.get(ii) + ", expected " + want.get(ii));
+                }
+                try {
+                    q.get(want.size());
+                    Zoo.fail(log + ": get(size) returned");
+                } catch (NoSuchElementException expected) {
+                    // documented
+                }
+            }
+        }, Zoo.settings("ringQueueMatchesArrayDeque"));
+    }
