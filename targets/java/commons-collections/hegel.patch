+    static final Generator<Edit> EDIT = weighted(w(1, INDEX.<Edit>map(Edit.Del::new)), w(1, tuples(INDEX, pick('a', 'b', 'c', 'd')).<Edit>map(t -> new Edit.Ins(t.value1(), t.value2()))));
