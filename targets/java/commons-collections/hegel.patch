+package zoo;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import org.apache.commons.collections4.Bag;
+import org.apache.commons.collections4.CollectionUtils;
+import org.apache.commons.collections4.ListUtils;
+import org.apache.commons.collections4.MultiSet;
+import org.apache.commons.collections4.SetUtils;
+import org.apache.commons.collections4.SetUtils.SetView;
+import org.apache.commons.collections4.SortedBag;
+import org.apache.commons.collections4.bag.HashBag;
+import org.apache.commons.collections4.bag.TreeBag;
+import org.apache.commons.collections4.multiset.HashMultiSet;
+import org.apache.commons.collections4.multiset.TreeMultiSet;
+import org.apache.commons.collections4.sequence.CommandVisitor;
+import org.apache.commons.collections4.sequence.EditScript;
+import org.apache.commons.collections4.sequence.SequencesComparator;
+import org.junit.jupiter.api.Test;
+
+/** CollectionUtils/ListUtils/SetUtils, bags and multisets, and the Myers diff, against count and LCS models. */
+class CommonsUtilsTest {
+
+    /** A small list of ints with repetitions (and sometimes nulls). */
+    static List<Integer> ints(TestCase tc, boolean nulls) {
+        int n = Zoo.n(tc, 0, 8);
+        List<Integer> xs = new ArrayList<>();
+        for (int i = 0; i < n; i++) {
+            xs.add(nulls && Zoo.chance(tc, 10) ? null : Zoo.n(tc, 0, 5));
+        }
+        return xs;
+    }
+
+    static <T> Map<T, Integer> counts(Iterable<? extends T> xs) {
+        Map<T, Integer> m = new HashMap<>();
+        for (T x : xs) {
+            m.merge(x, 1, Integer::sum);
+        }
+        return m;
+    }
+
+    static <T> int count(Map<T, Integer> m, T x) {
+        return m.getOrDefault(x, 0);
+    }
+
+    static <T> Set<T> keys(Map<T, Integer> a, Map<T, Integer> b) {
+        Set<T> ks = new HashSet<>(a.keySet());
+        ks.addAll(b.keySet());
+        return ks;
+    }
+
+    static <T> void sameCounts(String what, Iterable<? extends T> got, Map<T, Integer> want, Object a, Object b) {
+        Map<T, Integer> g = counts(got);
+        Map<T, Integer> w = new HashMap<>();
+        want.forEach((k, v) -> {
+            if (v != 0) {
+                w.put(k, v);
+            }
+        });
+        Zoo.check(g.equals(w), () -> what + " of " + a + " and " + b + " = " + got + ": counts " + g + ", expected " + w);
+    }
+
+    /** Whether {@code sub} is a subsequence of {@code xs}. */
+    static <T> boolean subsequence(List<T> sub, List<T> xs) {
+        int i = 0;
+        for (T x : xs) {
+            if (i < sub.size() && java.util.Objects.equals(sub.get(i), x)) {
+                i++;
+            }
+        }
+        return i == sub.size();
+    }
+
+    @Test
+    void collectionOpsRespectCardinality() {
+        Hegel.test(tc -> {
+            List<Integer> a = ints(tc, true);
+            List<Integer> b = ints(tc, true);
+            Map<Integer, Integer> ca = counts(a);
+            Map<Integer, Integer> cb = counts(b);
+            Set<Integer> ks = keys(ca, cb);
+            Map<Integer, Integer> union = new HashMap<>();
+            Map<Integer, Integer> inter = new HashMap<>();
+            Map<Integer, Integer> disj = new HashMap<>();
+            Map<Integer, Integer> sub = new HashMap<>();
+            Map<Integer, Integer> retain = new HashMap<>();
+            Map<Integer, Integer> remove = new HashMap<>();
+            for (Integer k : ks) {
+                int x = count(ca, k);
+                int y = count(cb, k);
+                union.put(k, Math.max(x, y));
+                inter.put(k, Math.min(x, y));
+                disj.put(k, Math.max(x, y) - Math.min(x, y));
+                sub.put(k, Math.max(0, x - y));
+                retain.put(k, y > 0 ? x : 0);
+                remove.put(k, y > 0 ? 0 : x);
+            }
+            sameCounts("union", CollectionUtils.union(a, b), union, a, b);
+            sameCounts("intersection", CollectionUtils.intersection(a, b), inter, a, b);
