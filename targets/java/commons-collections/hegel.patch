+    @Test
+    void bagsAndMultiSetsCountLikeTheModel() {
+        Hegel.test(tc -> {
+            Kind kind = Zoo.pick(tc, Kind.values());
+            boolean nulls = kind == Kind.HASH_BAG || kind == Kind.HASH_MULTISET;
+            Bag<Integer> bag = kind == Kind.HASH_BAG ? new HashBag<>() : kind == Kind.TREE_BAG ? new TreeBag<>() : null;
+            MultiSet<Integer> ms = kind == Kind.HASH_MULTISET ? new HashMultiSet<>() : kind == Kind.TREE_MULTISET ? new TreeMultiSet<>() : null;
+            Collection<Integer> coll = bag != null ? bag : ms;
+            Map<Integer, Integer> model = new HashMap<>();
+            int steps = Zoo.n(tc, 0, 25);
+            StringBuilder log = new StringBuilder(kind.toString());
+            for (int s = 0; s < steps; s++) {
+                Integer e = nulls && Zoo.chance(tc, 8) ? null : Zoo.n(tc, 0, 5);
+                int op = Zoo.n(tc, 0, 9);
+                int old = count(model, e);
+                switch (op) {
+                    case 0, 1 -> {
+                        log.append(" add(").append(e).append(')');
+                        boolean r = coll.add(e);
+                        model.merge(e, 1, Integer::sum);
+                        boolean want = bag != null ? old == 0 : true;
+                        Zoo.check(r == want, () -> log + ": add returned " + r);
+                    }
+                    case 2 -> {
+                        int n = Zoo.n(tc, 0, 3);
+                        log.append(" add(").append(e).append(", ").append(n).append(')');
+                        if (bag != null) {
+                            boolean r = bag.add(e, n);
+                            Zoo.check(r == (old == 0 && n > 0), () -> log + ": add returned " + r);
+                        } else {
+                            int r = ms.add(e, n);
+                            Zoo.check(r == old, () -> log + ": add returned " + r + ", the count before was " + old);
+                        }
+                        if (n > 0) {
+                            model.merge(e, n, Integer::sum);
+                        }
+                    }
+                    case 3 -> {
+                        log.append(" remove(").append(e).append(')');
+                        boolean r = coll.remove(e);
+                        Zoo.check(r == (old > 0), () -> log + ": remove returned " + r);
+                        if (bag != null) {
+                            model.remove(e);
+                        } else if (old > 0) {
+                            model.put(e, old - 1);
+                        }
+                    }
+                    case 4 -> {
+                        int n = Zoo.n(tc, 0, 3);
+                        log.append(" remove(").append(e).append(", ").append(n).append(')');
+                        if (bag != null) {
+                            boolean r = bag.remove(e, n);
+                            Zoo.check(r == (old > 0 && n > 0), () -> log + ": remove returned " + r);
+                        } else {
+                            int r = ms.remove(e, n);
+                            Zoo.check(r == old, () -> log + ": remove returned " + r + ", the count before was " + old);
+                        }
+                        if (n > 0) {
+                            model.put(e, Math.max(0, old - n));
+                        }
+                    }
+                    case 5 -> {
+                        if (ms != null) {
+                            int n = Zoo.n(tc, 0, 3);
+                            log.append(" setCount(").append(e).append(", ").append(n).append(')');
+                            int r = ms.setCount(e, n);
+                            Zoo.check(r == old, () -> log + ": setCount returned " + r + ", the count before was " + old);
+                            model.put(e, n);
+                        }
+                    }
+                    case 6, 7 -> {
+                        List<Integer> other = ints(tc, nulls);
+                        Map<Integer, Integer> co = counts(other);
+                        boolean retain = op == 7;
+                        log.append(retain ? " retainAll(" : " removeAll(").append(other).append(')');
+                        Map<Integer, Integer> before = new HashMap<>(model);
+                        boolean changed;
+                        if (retain) {
+                            changed = coll.retainAll(other);
+                            for (Integer k : new ArrayList<>(model.keySet())) {
+                                int have = model.get(k);
+                                int keep = bag != null ? Math.min(have, count(co, k)) : co.containsKey(k) ? have : 0;
+                                model.put(k, keep);
+                            }
+                        } else {
+                            changed = coll.removeAll(other);
+                            for (Integer k : new ArrayList<>(model.keySet())) {
+                                int have = model.get(k);
+                                int keep = bag != null ? Math.max(0, have - count(co, k)) : co.containsKey(k) ? 0 : have;
+                                model.put(k, keep);
+                            }
+                        }
+                        boolean wantChanged = !positive(before).equals(positive(model));
+                        Zoo.check(changed == wantChanged, () -> log + ": returned " + changed + ", the counts went " + positive(before) + " -> " + positive(model));
+                    }
+                    case 8 -> {
+                        List<Integer> other = ints(tc, nulls);
+                        Map<Integer, Integer> co = counts(other);
+                        boolean want = bag != null ? co.entrySet().stream().allMatch(en -> count(model, en.getKey()) >= en.getValue())
+                                : co.keySet().stream().allMatch(k -> count(model, k) > 0);
+                        Zoo.check(coll.containsAll(other) == want, () -> log + ": containsAll(" + other + ") = " + !want + " with counts " + positive(model));
+                    }
+                    default -> {
+                        // iterator removal of one occurrence
+                        Iterator<Integer> it = coll.iterator();
+                        if (it.hasNext()) {
+                            Integer x = it.next();
+                            log.append(" iterator.remove(").append(x).append(')');
+                            it.remove();
+                            model.put(x, count(model, x) - 1);
+                        }
+                    }
+                }
+                Map<Integer, Integer> want = positive(model);
+                Map<Integer, Integer> got = counts(coll);
+                int size = want.values().stream().mapToInt(Integer::intValue).sum();
+                Zoo.check(got.equals(want) && coll.size() == size && coll.isEmpty() == (size == 0), () -> log + ": iterated counts " + got + ", size " + coll.size() + ", expected " + want);
+                for (int x = -1; x <= 6; x++) {
+                    Integer y = x;
+                    int c = bag != null ? bag.getCount(y) : ms.getCount(y);
+                    Zoo.check(c == count(want, y) && coll.contains(y) == (count(want, y) > 0), () -> log + ": getCount(" + y + ") = " + c + ", contains " + coll.contains(y));
+                }
+                Set<Integer> unique = bag != null ? bag.uniqueSet() : ms.uniqueSet();
+                Zoo.check(unique.equals(want.keySet()), () -> log + ": uniqueSet " + unique + ", expected " + want.keySet());
+                Zoo.check(coll.toArray().length == size, () -> log + ": toArray has " + coll.toArray().length + " elements");
+                if (kind.sorted() && !want.isEmpty()) {
+                    TreeMap<Integer, Integer> sortedWant = new TreeMap<>(want);
+                    List<Integer> order = new ArrayList<>(coll);
+                    List<Integer> sortedOrder = new ArrayList<>(order);
+                    sortedOrder.sort(null);
+                    Zoo.check(order.equals(sortedOrder), () -> log + ": iteration order " + order);
+                    if (bag != null) {
+                        SortedBag<Integer> sb = (SortedBag<Integer>) bag;
+                        Zoo.check(sb.first().equals(sortedWant.firstKey()) && sb.last().equals(sortedWant.lastKey()), () -> log + ": first " + sb.first() + ", last " + sb.last());
+                    } else {
+                        TreeMultiSet<Integer> tm = (TreeMultiSet<Integer>) ms;
+                        Zoo.check(tm.first().equals(sortedWant.firstKey()) && tm.last().equals(sortedWant.lastKey()), () -> log + ": first " + tm.first() + ", last " + tm.last());
+                    }
+                }
+                if (ms != null) {
+                    Map<Integer, Integer> entries = new HashMap<>();
+                    for (MultiSet.Entry<Integer> en : ms.entrySet()) {
+                        entries.put(en.getElement(), en.getCount());
+                    }
+                    Zoo.check(entries.equals(want) && ms.entrySet().size() == want.size(), () -> log + ": entrySet " + entries);
+                }
+            }
+            // equality with a copy built in another order
+            Collection<Integer> copy;
+            List<Integer> elems = new ArrayList<>(coll);
+            java.util.Collections.reverse(elems);
+            if (bag != null) {
+                copy = kind == Kind.HASH_BAG ? new HashBag<>(elems) : new TreeBag<>(elems);
+            } else {
+                copy = kind == Kind.HASH_MULTISET ? new HashMultiSet<>(elems) : new TreeMultiSet<>(elems);
+            }
+            Zoo.check(copy.equals(coll) && coll.equals(copy) && copy.hashCode() == coll.hashCode(), () -> log + ": a copy from the reversed elements is not equal: " + copy + " vs " + coll);
+        }, Zoo.settings("bagsAndMultiSetsCountLikeTheModel"));
+    }
