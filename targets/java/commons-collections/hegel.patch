+
+    static final Generator<List<Integer>> INTS_OR_NULLS = smallInts(true);
+
+    /** Two lists, and the partition size (1 to |a| + 1, taken modulo when applied). */
+    record OpsCase(List<Integer> a, List<Integer> b, int size) {}
+
+    static final Generator<OpsCase> OPS_CASE = tuples(INTS_OR_NULLS, INTS_OR_NULLS, INDEX).map(t -> new OpsCase(t.value1(), t.value2(), t.value3()));
+
+    /** One of the four count-based collections under the same script. */
+    enum Kind { HASH_BAG, TREE_BAG, HASH_MULTISET, TREE_MULTISET;
+        boolean bag() {
+            return this == HASH_BAG || this == TREE_BAG;
+        }
+
+        boolean sorted() {
+            return this == TREE_BAG || this == TREE_MULTISET;
+        }
+
+        /** The hashed kinds take null elements. */
+        boolean nulls() {
+            return this == HASH_BAG || this == HASH_MULTISET;
