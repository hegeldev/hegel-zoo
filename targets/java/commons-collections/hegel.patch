+
+    record BagCase(Kind kind, List<BagOp> ops) {}
+
+    static final Generator<BagCase> BAG_CASE = pick(Kind.values()).flatMap(kind -> many(BAG_OPS.get(kind), 0, 25).map(ops -> new BagCase(kind, ops)));
