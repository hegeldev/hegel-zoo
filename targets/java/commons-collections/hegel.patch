+package zoo;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.NoSuchElementException;
+import java.util.SortedMap;
+import java.util.function.Supplier;
+import org.apache.commons.collections4.MapIterator;
+import org.apache.commons.collections4.OrderedMapIterator;
+import org.apache.commons.collections4.bidimap.DualHashBidiMap;
+import org.apache.commons.collections4.bidimap.DualTreeBidiMap;
+import org.apache.commons.collections4.bloomfilter.ArrayCountingBloomFilter;
+import org.apache.commons.collections4.bloomfilter.EnhancedDoubleHasher;
+import org.apache.commons.collections4.bloomfilter.IndexExtractor;
+import org.apache.commons.collections4.bloomfilter.LayerManager;
+import org.apache.commons.collections4.bloomfilter.LayeredBloomFilter;
+import org.apache.commons.collections4.bloomfilter.Shape;
+import org.apache.commons.collections4.bloomfilter.SimpleBloomFilter;
+import org.apache.commons.collections4.map.LRUMap;
+import org.apache.commons.collections4.map.MultiKeyMap;
+import org.apache.commons.collections4.trie.PatriciaTrie;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Pins for the bugs in targets/java/commons-collections/bugs.toml. Each asserts the correct behaviour and therefore fails
+ * while the bug exists; the ids are the keys of [expected_failures] in target.toml.
+ */
+class CommonsCollectionsPinsTest {
+
+    static Object outcome(Supplier<?> f) {
+        try {
+            return f.get();
+        } catch (RuntimeException e) {
+            return e;
+        }
+    }
+
+    static String kind(Object o) {
+        return o instanceof Throwable t ? t.getClass().getSimpleName() + ": " + t.getMessage() : "value " + o;
+    }
+
+    /** commons-collections/1: a null key that enters an LRUMap through an eviction is unreachable. */
+    @Test
+    void pin_lruMapNullKeyAfterEviction() {
+        LRUMap<String, Integer> map = new LRUMap<>(2);
+        map.put("a", 1);
+        map.put("b", 2);
+        map.put(null, 3);
+        Zoo.check(map.containsKey(null) && Integer.valueOf(3).equals(map.get(null)), "after put(a), put(b), put(null) into an LRUMap(2): keys " + map.keySet()
+                + ", containsKey(null) = " + map.containsKey(null) + ", get(null) = " + map.get(null));
+        map.put(null, 4);
+        Zoo.check(map.size() == 2 && new ArrayList<>(map.keySet()).stream().filter(k -> k == null).count() == 1, "a second put(null) gives " + map + " (size " + map.size() + ")");
+    }
+
+    /** commons-collections/2: setValue of the value already there fails after the key was re-put with an equal key object. */
+    @Test
+    void pin_dualBidiMapSetValueSameValue() {
+        Integer k1 = Integer.valueOf(1000);
+        Integer k2 = Integer.valueOf(1000);
+        DualHashBidiMap<Integer, String> map = new DualHashBidiMap<>();
+        map.put(k1, "v1");
+        map.put(k2, "v2");
+        Map.Entry<Integer, String> e = map.entrySet().iterator().next();
+        Object r = outcome(() -> {
+            e.setValue("v2");
+            return map.toString();
+        });
+        MapIterator<Integer, String> it = map.mapIterator();
+        it.next();
+        Object r2 = outcome(() -> {
+            it.setValue("v2");
+            return map.toString();
+        });
+        Zoo.check(!(r instanceof Throwable) && !(r2 instanceof Throwable), "setValue(\"v2\") on the entry 1000=v2 -> " + kind(r) + "; through the map iterator -> " + kind(r2));
+    }
+
+    /** commons-collections/3: DualTreeBidiMap.previousKey finds a lower key for an absent key while nextKey returns null. */
+    @Test
+    void pin_dualTreeBidiMapPreviousKeyOfAbsentKey() {
+        DualTreeBidiMap<Integer, String> map = new DualTreeBidiMap<>();
+        map.put(1, "a");
+        map.put(3, "c");
+        map.put(5, "e");
+        Integer next = map.nextKey(2);
+        Integer prev = map.previousKey(4);
+        Zoo.check(next == null && prev == null || next != null && prev != null, "for the absent keys 2 and 4 in " + map + ": nextKey(2) = " + next + ", previousKey(4) = " + prev);
+    }
+
+    /** commons-collections/4: putting through a DualTreeBidiMap sub-map view a value mapped outside the view leaves the value twice. */
+    @Test
+    void pin_dualTreeBidiMapViewPutKeepsValuesUnique() {
+        DualTreeBidiMap<Integer, String> map = new DualTreeBidiMap<>();
+        map.put(1, "a");
+        map.put(3, "c");
+        map.put(5, "e");
+        SortedMap<Integer, String> head = map.headMap(4);
+        head.put(2, "e");
+        long copies = map.values().stream().filter("e"::equals).count();
+        Zoo.check(copies == 1 && map.size() == map.inverseBidiMap().size(), "after headMap(4).put(2, \"e\"): map " + map + ", inverse " + map.inverseBidiMap() + " (" + copies
+                + " copies of \"e\", size " + map.size() + " vs inverse size " + map.inverseBidiMap().size() + ")");
+    }
+
+    /** commons-collections/5: MultiKeyMap's multi-key get/put bypass the decorated LRUMap's recency. */
+    @Test
+    void pin_multiKeyMapOverLruMapRecency() {
+        MultiKeyMap<String, Integer> map = MultiKeyMap.multiKeyMap(new LRUMap<>(2));
+        map.put("a", "b", 1);
+        map.put("c", "d", 2);
+        map.get("a", "b");
+        map.put("e", "f", 3);
+        Zoo.check(map.containsKey("a", "b") && !map.containsKey("c", "d"), "LRUMap(2): put(a,b), put(c,d), get(a,b), put(e,f) left " + map + " (the least recently used key was (c, d))");
+    }
+
+    /** commons-collections/6: ArrayCountingBloomFilter.clear() does not return the filter to a valid state. */
+    @Test
+    void pin_countingBloomFilterClearResetsValidity() {
+        ArrayCountingBloomFilter f = new ArrayCountingBloomFilter(Shape.fromKM(3, 64));
+        f.merge(IndexExtractor.fromIndexArray(1, 2, 3));
+        f.remove(IndexExtractor.fromIndexArray(1));
+        f.remove(IndexExtractor.fromIndexArray(1));
+        boolean invalid = !f.isValid();
+        f.clear();
+        boolean merged = f.merge(IndexExtractor.fromIndexArray(1));
+        Zoo.check(invalid && f.isValid() && merged, "after an underflow (isValid " + !invalid + ") and clear(): isValid = " + f.isValid() + ", merge returned " + merged);
+    }
+
+    /** commons-collections/7: LayeredBloomFilter.uniqueIndices() repeats indices held by several layers. */
+    @Test
+    void pin_layeredBloomFilterUniqueIndices() {
+        Shape shape = Shape.fromKM(3, 64);
+        LayerManager<SimpleBloomFilter> lm = LayerManager.<SimpleBloomFilter>builder().setSupplier(() -> new SimpleBloomFilter(shape))
+                .setExtendCheck(LayerManager.ExtendCheck.advanceOnPopulated()).get();
+        LayeredBloomFilter<SimpleBloomFilter> f = new LayeredBloomFilter<>(shape, lm);
+        f.merge(IndexExtractor.fromIndexArray(5, 9));
+        f.merge(IndexExtractor.fromIndexArray(5, 7));
+        int[] unique = f.uniqueIndices().asIndexArray();
+        Zoo.check(Arrays.equals(unique, new int[] {5, 7, 9}), "two layers {5, 9} and {5, 7}: uniqueIndices() = " + Arrays.toString(unique) + ", cardinality " + f.cardinality());
+    }
+
+    /** commons-collections/8: EnhancedDoubleHasher leaves the index range for a one-bit shape with four or more hash functions. */
+    @Test
+    void pin_enhancedDoubleHasherOneBitShape() {
+        Shape shape = Shape.fromKM(4, 1);
+        int[] ix = new EnhancedDoubleHasher(0, 0).indices(shape).asIndexArray();
+        Object merged = outcome(() -> new SimpleBloomFilter(shape).merge(new EnhancedDoubleHasher(0, 0)));
+        Zoo.check(Arrays.stream(ix).allMatch(i -> i == 0) && !(merged instanceof Throwable), "indices for " + shape + " = " + Arrays.toString(ix) + "; merging into a SimpleBloomFilter -> " + kind(merged));
+    }
+
+    /** commons-collections/9: headMap(x).lastKey() of an empty trie returns null instead of throwing. */
+    @Test
+    void pin_emptyTrieHeadMapLastKey() {
+        Object r = outcome(() -> new PatriciaTrie<Integer>().headMap("x").lastKey());
+        Zoo.check(r instanceof NoSuchElementException, "new PatriciaTrie().headMap(\"x\").lastKey() -> " + kind(r));
+    }
+
+    /** commons-collections/10: lastKey() of a trie whose only key is the empty string throws. */
+    @Test
+    void pin_trieLastKeyWithOnlyTheEmptyKey() {
+        PatriciaTrie<Integer> trie = new PatriciaTrie<>();
+        trie.put("", 1);
+        Object r = outcome(trie::lastKey);
+        Zoo.check("".equals(r), "trie {\"\"=1} (size " + trie.size() + ", firstKey " + Zoo.show(trie.firstKey()) + "): lastKey() -> " + kind(r));
+    }
+
+    /** commons-collections/11: sub-maps of a prefix view include entries outside the prefix. */
+    @Test
+    void pin_prefixMapSubViews() {
+        PatriciaTrie<Integer> trie = new PatriciaTrie<>();
+        for (String s : new String[] {"a", "pa", "pb", "pc", "z"}) {
+            trie.put(s, s.length());
+        }
+        SortedMap<String, Integer> prefix = trie.prefixMap("p");
+        List<String> head = new ArrayList<>(prefix.headMap("pc").keySet());
+        List<String> tail = new ArrayList<>(prefix.tailMap("pb").keySet());
+        Zoo.check(head.equals(List.of("pa", "pb")) && tail.equals(List.of("pb", "pc")), "prefixMap(\"p\") = " + prefix.keySet() + ": headMap(\"pc\") = " + head + ", tailMap(\"pb\") = " + tail);
+    }
+
+    /** commons-collections/12: emptying a prefix view through its entry iterator throws NullPointerException. */
+    @Test
+    void pin_prefixViewIteratorRemoveToEmpty() {
+        PatriciaTrie<Integer> trie = new PatriciaTrie<>();
+        for (String s : new String[] {"a", "pa", "pb", "z"}) {
+            trie.put(s, 1);
+        }
+        Object r = outcome(() -> {
+            Iterator<Map.Entry<String, Integer>> it = trie.prefixMap("p").entrySet().iterator();
+            while (it.hasNext()) {
+                it.next();
+                it.remove();
+            }
+            return trie.keySet().toString();
+        });
+        Zoo.check(!(r instanceof Throwable) && trie.keySet().equals(new java.util.TreeSet<>(List.of("a", "z"))), "removing pa and pb through prefixMap(\"p\").entrySet().iterator() -> " + kind(r) + "; trie " + trie.keySet());
+    }
+
+    /** commons-collections/14: after a removal, putting the empty key hides every other entry from iteration. */
+    @Test
+    void pin_trieIterationAfterRemovalAndEmptyKey() {
+        PatriciaTrie<Integer> trie = new PatriciaTrie<>();
+        trie.put("b", 1);
+        trie.put("a", 2);
+        trie.remove("b");
+        trie.put("", 0);
+        List<String> keys = new ArrayList<>(trie.keySet());
+        Zoo.check(keys.equals(List.of("", "a")), "put(b), put(a), remove(b), put(\"\"): keySet iterates " + keys.stream().map(Zoo::show).toList() + " while size() = " + trie.size()
+                + " and get(\"a\") = " + trie.get("a") + "; values " + trie.values() + ", entrySet " + trie.entrySet());
+    }
+
+    /** commons-collections/13: after remove() the trie's map iterator still has a previous entry, with a null key. */
+    @Test
+    void pin_trieMapIteratorPreviousAfterRemove() {
+        PatriciaTrie<Integer> trie = new PatriciaTrie<>();
+        for (String s : new String[] {"a", "b", "c"}) {
+            trie.put(s, 1);
+        }
+        OrderedMapIterator<String, Integer> it = trie.mapIterator();
+        it.next();
+        it.next();
+        it.remove();
+        boolean hasPrevious = it.hasPrevious();
+        Object prev = hasPrevious ? outcome(it::previous) : "(none)";
+        Zoo.check(hasPrevious && "a".equals(prev), "after next(), next(), remove() on {a, b, c}: hasPrevious = " + hasPrevious + ", previous() -> " + kind(prev));
+    }
+}
diff --git a/hegel/src/test/java/zoo/CommonsUtilsTest.java b/hegel/src/test/java/zoo/CommonsUtilsTest.java
