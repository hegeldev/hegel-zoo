+                    MapIterator<Integer, Integer> it = map.mapIterator();
+                    int skip = Zoo.n(tc, 0, fwd.size() - 1);
+                    for (int i = 0; i <= skip; i++) {
+                        it.next();
+                    }
+                    Integer key = it.getKey();
+                    log.append(" mapIterator(").append(key).append(").setValue(").append(v).append(')');
