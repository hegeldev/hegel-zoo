+                Integer[] ks = new Integer[arity];
+                for (int i = 0; i < arity; i++) {
+                    ks[i] = Zoo.chance(tc, 10) ? null : Zoo.n(tc, 0, 2);
+                }
+                List<Integer> lk = Arrays.asList(ks);
+                int op = Zoo.n(tc, 0, 5);
+                if (op < 3) {
+                    int v = Zoo.n(tc, 0, 9);
+                    log.append(" put(").append(lk).append(", ").append(v).append(')');
+                    Integer got = switch (arity) {
+                        case 2 -> map.put(ks[0], ks[1], v);
+                        case 3 -> map.put(ks[0], ks[1], ks[2], v);
+                        case 4 -> map.put(ks[0], ks[1], ks[2], ks[3], v);
+                        default -> map.put(ks[0], ks[1], ks[2], ks[3], ks[4], v);
+                    };
+                    Integer want = model.put(lk, v);
+                    Zoo.check(Objects.equals(got, want), () -> log + ": put returned " + got + ", expected " + want);
+                } else if (op < 4) {
+                    log.append(" removeMultiKey(").append(lk).append(')');
+                    Integer got = switch (arity) {
+                        case 2 -> map.removeMultiKey(ks[0], ks[1]);
+                        case 3 -> map.removeMultiKey(ks[0], ks[1], ks[2]);
+                        case 4 -> map.removeMultiKey(ks[0], ks[1], ks[2], ks[3]);
+                        default -> map.removeMultiKey(ks[0], ks[1], ks[2], ks[3], ks[4]);
+                    };
+                    Integer want = model.remove(lk);
+                    Zoo.check(Objects.equals(got, want), () -> log + ": removeMultiKey returned " + got + ", expected " + want);
+                } else if (op < 5) {
+                    int n = Zoo.n(tc, 1, Math.min(4, arity));
+                    List<Integer> prefix = lk.subList(0, n);
+                    log.append(" removeAll(").append(prefix).append(')');
+                    boolean got = switch (n) {
+                        case 1 -> map.removeAll(ks[0]);
+                        case 2 -> map.removeAll(ks[0], ks[1]);
+                        case 3 -> map.removeAll(ks[0], ks[1], ks[2]);
+                        default -> map.removeAll(ks[0], ks[1], ks[2], ks[3]);
+                    };
+                    boolean want = model.keySet().removeIf(key -> key.size() >= n && key.subList(0, n).equals(prefix));
+                    Zoo.check(got == want, () -> log + ": removeAll returned " + got + ", expected " + want);
+                } else {
+                    Integer got = switch (arity) {
+                        case 2 -> map.get(ks[0], ks[1]);
+                        case 3 -> map.get(ks[0], ks[1], ks[2]);
+                        case 4 -> map.get(ks[0], ks[1], ks[2], ks[3]);
+                        default -> map.get(ks[0], ks[1], ks[2], ks[3], ks[4]);
+                    };
+                    boolean has = switch (arity) {
+                        case 2 -> map.containsKey(ks[0], ks[1]);
+                        case 3 -> map.containsKey(ks[0], ks[1], ks[2]);
+                        case 4 -> map.containsKey(ks[0], ks[1], ks[2], ks[3]);
+                        default -> map.containsKey(ks[0], ks[1], ks[2], ks[3], ks[4]);
+                    };
+                    Zoo.check(Objects.equals(got, model.get(lk)) && has == model.containsKey(lk), () -> log + ": get(" + lk + ") = " + got + ", containsKey " + has + ", model " + model.get(lk));
