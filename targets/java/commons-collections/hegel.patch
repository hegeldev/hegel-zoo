+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for Apache Commons Collections, added by the Hegel zoo (targets/java/commons-collections).
+     Runs against the org.apache.commons:commons-collections4 artifact that `[run] setup` installs from this checkout
+     into the local Maven repository. Oracles: java.util twins (TreeMap, LinkedHashMap, ArrayList, ArrayDeque) driven
+     by the same operation sequences, and set/count models written in the tests. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>commons-collections-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <commons-collections.version>4.6.1-SNAPSHOT</commons-collections.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.apache.commons</groupId>
+      <artifactId>commons-collections4</artifactId>
+      <version>${commons-collections.version}</version>
+    </dependency>
+    <dependency>
+      <!-- independent reader/writer of the RFC 4180 dialects -->
+      <groupId>de.siegmar</groupId>
+      <artifactId>fastcsv</artifactId>
+      <version>4.0.0</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <!-- JSON lines to and from the Python csv oracle -->
+      <groupId>com.google.code.gson</groupId>
+      <artifactId>gson</artifactId>
+      <version>2.13.1</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/BloomFilterTest.java b/hegel/src/test/java/zoo/BloomFilterTest.java
new file mode 100644
index 0000000..e3c71f8
--- /dev/null
+++ b/hegel/src/test/java/zoo/BloomFilterTest.java
@@ -0,0 +1,468 @@
+package zoo;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import org.apache.commons.collections4.bloomfilter.ArrayCountingBloomFilter;
+import org.apache.commons.collections4.bloomfilter.BitMapExtractor;
+import org.apache.commons.collections4.bloomfilter.BitMaps;
+import org.apache.commons.collections4.bloomfilter.BloomFilter;
+import org.apache.commons.collections4.bloomfilter.CellExtractor;
+import org.apache.commons.collections4.bloomfilter.EnhancedDoubleHasher;
+import org.apache.commons.collections4.bloomfilter.Hasher;
+import org.apache.commons.collections4.bloomfilter.IndexExtractor;
+import org.apache.commons.collections4.bloomfilter.LayerManager;
+import org.apache.commons.collections4.bloomfilter.LayeredBloomFilter;
+import org.apache.commons.collections4.bloomfilter.SetOperations;
+import org.apache.commons.collections4.bloomfilter.Shape;
+import org.apache.commons.collections4.bloomfilter.SimpleBloomFilter;
+import org.apache.commons.collections4.bloomfilter.SparseBloomFilter;
+import org.junit.jupiter.api.Test;
+
+/** Bloom filters against a set model of the merged indices, and the shape arithmetic against its formulas. */
+class BloomFilterTest {
+
+    static Shape shape(TestCase tc) {
+        // a one-bit shape is bug commons-collections/8's shape (the hasher's indices leave the range): m starts at 2
+        int m = Zoo.chance(tc, 30) ? Zoo.n(tc, 2, 70) : Zoo.n(tc, 64, 300);
+        int k = Zoo.chance(tc, 10) ? Zoo.n(tc, 1, 12) : Zoo.n(tc, 1, 5);
+        return Shape.fromKM(k, m);
+    }
+
+    /** The indices of an enhanced double hasher, from the published recurrence (Dillinger &amp; Manolios). */
+    static TreeSet<Integer> indices(long initial, long increment, Shape shape) {
+        int bits = shape.getNumberOfBits();
+        long index = Long.remainderUnsigned(initial, bits);
+        long inc = Long.remainderUnsigned(increment, bits);
+        TreeSet<Integer> out = new TreeSet<>();
+        out.add((int) index);
+        for (int i = 1; i < shape.getNumberOfHashFunctions(); i++) {
+            index = Math.floorMod(index - inc, bits);
+            out.add((int) index);
+            inc = Math.floorMod(inc - i, bits);
+        }
+        return out;
+    }
+
+    record Item(long initial, long increment) {
+        Hasher hasher() {
+            return new EnhancedDoubleHasher(initial, increment);
+        }
+    }
+
+    static Item item(TestCase tc) {
+        long a = Zoo.chance(tc, 20) ? Zoo.n(tc, -3, 300) : tc.draw(dev.hegel.Generators.longs());
+        long b = Zoo.chance(tc, 20) ? Zoo.n(tc, -3, 300) : tc.draw(dev.hegel.Generators.longs());
+        return new Item(a, b);
+    }
+
+    enum Kind { SIMPLE, SPARSE, COUNTING, LAYERED }
+
+    static BloomFilter<?> filter(Kind kind, Shape shape) {
+        return switch (kind) {
+            case SIMPLE -> new SimpleBloomFilter(shape);
+            case SPARSE -> new SparseBloomFilter(shape);
+            case COUNTING -> new ArrayCountingBloomFilter(shape);
+            case LAYERED -> new LayeredBloomFilter<>(shape, LayerManager.<SimpleBloomFilter>builder().setSupplier(() -> new SimpleBloomFilter(shape))
+                    .setExtendCheck(LayerManager.ExtendCheck.advanceOnCount(3)).get());
+        };
+    }
+
+    static long[] bitMaps(TreeSet<Integer> set, int m) {
+        long[] maps = new long[BitMaps.numberOfBitMaps(m)];
+        for (int i : set) {
+            maps[i >> 6] |= 1L << (i & 63);
+        }
+        return maps;
+    }
+
+    static int[] array(TreeSet<Integer> set) {
+        return set.stream().mapToInt(Integer::intValue).toArray();
+    }
+
+    @Test
+    void hasherIndicesFollowTheRecurrence() {
+        Hegel.test(tc -> {
+            Shape shape = shape(tc);
+            Item it = item(tc);
+            IndexExtractor ix = it.hasher().indices(shape);
+            int[] raw = ix.asIndexArray();
+            TreeSet<Integer> want = indices(it.initial, it.increment, shape);
+            TreeSet<Integer> got = new TreeSet<>();
+            for (int i : raw) {
+                got.add(i);
+            }
+            Zoo.check(raw.length == shape.getNumberOfHashFunctions(), () -> "hasher " + it + " on " + shape + " gave " + raw.length + " indices: " + Arrays.toString(raw));
+            Zoo.check(got.equals(want), () -> "hasher " + it + " on " + shape + " gave " + Arrays.toString(raw) + ", the recurrence gives " + want);
+            for (int i : raw) {
+                Zoo.check(i >= 0 && i < shape.getNumberOfBits(), () -> "hasher " + it + " on " + shape + " gave the index " + i);
+            }
+            // unique indices are ascending and unique; the same hasher is deterministic
+            int[] unique = ix.uniqueIndices().asIndexArray();
+            Zoo.check(Arrays.equals(unique, array(want)), () -> "uniqueIndices of " + Arrays.toString(raw) + " = " + Arrays.toString(unique));
+            Zoo.check(Arrays.equals(raw, it.hasher().indices(shape).asIndexArray()), () -> "hasher " + it + " is not deterministic");
+            // early exit of processIndices
+            int[] seen = {0};
+            boolean r = ix.processIndices(i -> ++seen[0] < 2);
+            Zoo.check(!r == raw.length >= 2 && seen[0] == Math.min(2, raw.length), () -> "processIndices stopped after " + seen[0] + " of " + raw.length + ", returned " + r);
+            // bit map <-> index conversions
+            long[] maps = BitMapExtractor.fromIndexExtractor(ix, shape.getNumberOfBits()).asBitMapArray();
+            Zoo.check(Arrays.equals(maps, bitMaps(want, shape.getNumberOfBits())), () -> "bit maps of " + want + " = " + Arrays.toString(maps));
+            int[] back = IndexExtractor.fromBitMapExtractor(BitMapExtractor.fromBitMapArray(maps)).asIndexArray();
+            Zoo.check(Arrays.equals(back, array(want)), () -> "indices of the bit maps " + Arrays.toString(maps) + " = " + Arrays.toString(back));
+            // a cell extractor counts duplicates
+            Map<Integer, Integer> cells = new TreeMap<>();
+            CellExtractor.from(ix).processCells((i, c) -> {
+                cells.put(i, c);
+                return true;
+            });
+            Map<Integer, Integer> wantCells = new TreeMap<>();
+            for (int i : raw) {
+                wantCells.merge(i, 1, Integer::sum);
+            }
+            Zoo.check(cells.equals(wantCells), () -> "cells of " + Arrays.toString(raw) + " = " + cells);
+        }, Zoo.settings("hasherIndicesFollowTheRecurrence"));
+    }
+
+    @Test
+    void filtersMatchTheSetModel() {
+        Hegel.test(tc -> {
+            Shape shape = shape(tc);
+            int m = shape.getNumberOfBits();
+            Kind kind = Zoo.pick(tc, Kind.values());
+            BloomFilter<?> f = filter(kind, shape);
+            TreeSet<Integer> model = new TreeSet<>();
+            List<Item> merged = new ArrayList<>();
+            List<Item> others = new ArrayList<>();
+            int n = Zoo.n(tc, 0, 12);
+            StringBuilder log = new StringBuilder(kind + " " + shape);
+            for (int s = 0; s < n; s++) {
+                Item it = item(tc);
+                TreeSet<Integer> ix = indices(it.initial, it.increment, shape);
+                int op = Zoo.n(tc, 0, 9);
+                if (op < 5) {
+                    log.append(" merge(hasher ").append(it).append(')');
+                    boolean r = f.merge(it.hasher());
+                    Zoo.check(r, () -> log + ": merge returned false");
+                    merged.add(it);
+                    model.addAll(ix);
+                } else if (op < 7) {
+                    log.append(" merge(indices ").append(ix).append(')');
+                    boolean r = f.merge(IndexExtractor.fromIndexArray(array(ix)));
+                    Zoo.check(r, () -> log + ": merge returned false");
+                    merged.add(it);
+                    model.addAll(ix);
+                } else if (op < 8) {
+                    log.append(" merge(bitmaps of ").append(ix).append(')');
+                    boolean r = f.merge(BitMapExtractor.fromBitMapArray(bitMaps(ix, m)));
+                    Zoo.check(r, () -> log + ": merge returned false");
+                    merged.add(it);
+                    model.addAll(ix);
+                } else if (op < 9) {
+                    // merge another filter
+                    SimpleBloomFilter other = new SimpleBloomFilter(shape);
+                    other.merge(it.hasher());
+                    log.append(" merge(filter of ").append(it).append(')');
+                    boolean r = f.merge(other);
+                    Zoo.check(r, () -> log + ": merge returned false");
+                    merged.add(it);
+                    model.addAll(ix);
+                } else {
+                    others.add(it);
+                }
+                check(f, kind, shape, model, merged, others, log);
+            }
+            // copy is independent
+            BloomFilter<?> copy = f.copy();
+            Item extra = item(tc);
+            copy.merge(extra.hasher());
+            check(f, kind, shape, model, merged, others, log);
+            TreeSet<Integer> copyModel = new TreeSet<>(model);
+            copyModel.addAll(indices(extra.initial, extra.increment, shape));
+            List<Item> copyMerged = new ArrayList<>(merged);
+            copyMerged.add(extra);
+            check(copy, kind, shape, copyModel, copyMerged, List.of(), new StringBuilder(log + " copy+" + extra));
+            // set operations against the model
+            SimpleBloomFilter g = new SimpleBloomFilter(shape);
+            TreeSet<Integer> gm = new TreeSet<>();
+            for (Item o : others) {
+                g.merge(o.hasher());
+                gm.addAll(indices(o.initial, o.increment, shape));
+            }
+            TreeSet<Integer> and = new TreeSet<>(model);
+            and.retainAll(gm);
+            TreeSet<Integer> or = new TreeSet<>(model);
+            or.addAll(gm);
+            int xor = or.size() - and.size();
+            Zoo.check(SetOperations.andCardinality(f, g) == and.size() && SetOperations.orCardinality(f, g) == or.size() && SetOperations.xorCardinality(f, g) == xor
+                    && SetOperations.hammingDistance(f, g) == xor && SetOperations.cardinality(f) == model.size(),
+                    () -> log + " vs " + gm + ": and " + SetOperations.andCardinality(f, g) + " or " + SetOperations.orCardinality(f, g) + " xor " + SetOperations.xorCardinality(f, g)
+                            + ", model and " + and.size() + " or " + or.size() + " xor " + xor);
+            double jaccard = and.isEmpty() ? 0 : and.size() / (double) or.size();
+            double cosine = and.isEmpty() ? 0 : and.size() / Math.sqrt((double) model.size() * gm.size());
+            Zoo.check(Math.abs(SetOperations.jaccardSimilarity(f, g) - jaccard) < 1e-12 && Math.abs(SetOperations.jaccardDistance(f, g) - (1 - jaccard)) < 1e-12
+                    && Math.abs(SetOperations.cosineSimilarity(f, g) - cosine) < 1e-12 && Math.abs(SetOperations.cosineDistance(f, g) - (1 - cosine)) < 1e-12,
+                    () -> log + " vs " + gm + ": jaccard " + SetOperations.jaccardSimilarity(f, g) + " (model " + jaccard + "), cosine " + SetOperations.cosineSimilarity(f, g)
+                            + " (model " + cosine + ")");
+            // estimates: estimateN follows the shape formula, the union estimate is the estimate of the merged filter
+            int estimate = f.estimateN();
+            int wantEstimate = estimateN(shape, model.size());
+            Zoo.check(estimate == wantEstimate, () -> log + ": estimateN " + estimate + ", the formula gives " + wantEstimate + " for cardinality " + model.size());
+            int union = f.estimateUnion(g);
+            int wantUnion = estimateN(shape, or.size());
+            Zoo.check(union == wantUnion, () -> log + " vs " + gm + ": estimateUnion " + union + ", the formula gives " + wantUnion);
+            if (or.size() < m) {
+                long inter = Math.round(shape.estimateN(model.size())) + Math.round(shape.estimateN(gm.size())) - Math.round(shape.estimateN(or.size()));
+                int wantInter = (int) Math.max(0, Math.min(Integer.MAX_VALUE, Math.round(shape.estimateN(model.size()) + shape.estimateN(gm.size()) - shape.estimateN(or.size()))));
+                int got = f.estimateIntersection(g);
+                Zoo.check(got == wantInter, () -> log + " vs " + gm + ": estimateIntersection " + got + ", the formula gives " + wantInter + " (rounded parts " + inter + ")");
+            }
+            // clear
+            f.clear();
+            check(f, kind, shape, new TreeSet<>(), List.of(), merged, new StringBuilder(log + " clear"));
+            Item again = item(tc);
+            Zoo.check(f.merge(again.hasher()), () -> log + " clear: merge after clear returned false");
+            check(f, kind, shape, indices(again.initial, again.increment, shape), List.of(again), List.of(), new StringBuilder(log + " clear merge(" + again + ")"));
+        }, Zoo.settings("filtersMatchTheSetModel"));
+    }
+
+    static int estimateN(Shape shape, int cardinality) {
+        double d = shape.estimateN(cardinality);
+        if (Double.isInfinite(d)) {
+            return Integer.MAX_VALUE;
+        }
+        long l = Math.round(d);
+        return l > Integer.MAX_VALUE ? Integer.MAX_VALUE : (int) l;
+    }
+
+    static void check(BloomFilter<?> f, Kind kind, Shape shape, TreeSet<Integer> model, List<Item> merged, List<Item> others, StringBuilder log) {
+        int m = shape.getNumberOfBits();
+        Zoo.check(f.cardinality() == model.size(), () -> log + ": cardinality " + f.cardinality() + ", model " + model.size());
+        Zoo.check(f.isEmpty() == model.isEmpty(), () -> log + ": isEmpty " + f.isEmpty());
+        Zoo.check(f.isFull() == (model.size() == m), () -> log + ": isFull " + f.isFull() + " with " + model.size() + " of " + m + " bits");
+        if (kind != Kind.LAYERED) {
+            // a layered filter's uniqueIndices() repeats indices across layers: bug commons-collections/7, carried by its pin
+            int[] ix = f.uniqueIndices().asIndexArray();
+            Zoo.check(Arrays.equals(ix, array(model)), () -> log + ": uniqueIndices " + Arrays.toString(ix) + ", model " + model);
+        }
+        long[] maps = f.asBitMapArray();
+        Zoo.check(Arrays.equals(maps, bitMaps(model, m)), () -> log + ": bit maps " + Arrays.toString(maps) + ", model " + Arrays.toString(bitMaps(model, m)));
+        TreeSet<Integer> viaProcess = new TreeSet<>();
+        f.processIndices(i -> viaProcess.add(i) || true);
+        Zoo.check(viaProcess.equals(model), () -> log + ": processIndices gave " + viaProcess);
+        for (Item it : merged) {
+            Zoo.check(f.contains(it.hasher()), () -> log + ": does not contain the merged " + it);
+            Zoo.check(f.contains(IndexExtractor.fromIndexArray(array(indices(it.initial, it.increment, shape)))), () -> log + ": does not contain the indices of the merged " + it);
+            Zoo.check(f.contains(BitMapExtractor.fromBitMapArray(bitMaps(indices(it.initial, it.increment, shape), m))), () -> log + ": does not contain the bit maps of the merged " + it);
+            SimpleBloomFilter single = new SimpleBloomFilter(shape);
+            single.merge(it.hasher());
+            Zoo.check(f.contains(single), () -> log + ": does not contain the filter of the merged " + it);
+        }
+        if (kind != Kind.LAYERED) {
+            // a layered filter contains an item when one of its layers does, not the union: checked in layeredFilterTracksItsLayers
+            for (Item it : others) {
+                boolean want = model.containsAll(indices(it.initial, it.increment, shape));
+                Zoo.check(f.contains(it.hasher()) == want, () -> log + ": contains(" + it + ") = " + !want + ", its indices " + indices(it.initial, it.increment, shape));
+            }
+        }
+        Zoo.check(f.getShape().equals(shape), () -> log + ": shape " + f.getShape());
+        Zoo.check(f.estimateN() == estimateN(shape, model.size()), () -> log + ": estimateN " + f.estimateN());
+    }
+
+    @Test
+    void countingFilterCountsLikeTheModel() {
+        Hegel.test(tc -> {
+            Shape shape = shape(tc);
+            int m = shape.getNumberOfBits();
+            ArrayCountingBloomFilter f = new ArrayCountingBloomFilter(shape);
+            Map<Integer, Integer> cells = new HashMap<>();
+            List<Item> items = new ArrayList<>();
+            boolean valid = true;
+            int n = Zoo.n(tc, 0, 12);
+            StringBuilder log = new StringBuilder("counting " + shape);
+            for (int s = 0; s < n; s++) {
+                Item it = items.isEmpty() || Zoo.chance(tc, 50) ? item(tc) : Zoo.pick(tc, items.toArray(new Item[0]));
+                TreeSet<Integer> ix = indices(it.initial, it.increment, shape);
+                int op = Zoo.n(tc, 0, 5);
+                if (op < 3) {
+                    log.append(" merge(").append(it).append(')');
+                    boolean r = f.merge(it.hasher());
+                    for (int i : ix) {
+                        cells.merge(i, 1, Integer::sum);
+                    }
+                    items.add(it);
+                    Zoo.check(r == valid, () -> log + ": merge returned " + r);
+                } else if (op < 5) {
+                    log.append(" remove(").append(it).append(')');
+                    boolean r = f.remove(it.hasher());
+                    for (int i : ix) {
+                        int c = cells.getOrDefault(i, 0) - 1;
+                        if (c < 0) {
+                            valid = false;
+                        }
+                        cells.put(i, c);
+                    }
+                    boolean v = valid;
+                    Zoo.check(r == v, () -> log + ": remove returned " + r + ", the model is " + (v ? "valid" : "invalid"));
+                } else {
+                    // add the cells of another counting filter
+                    ArrayCountingBloomFilter other = new ArrayCountingBloomFilter(shape);
+                    other.merge(it.hasher());
+                    other.merge(it.hasher());
+                    log.append(" add(2x ").append(it).append(')');
+                    boolean r = f.add(other);
+                    for (int i : ix) {
+                        cells.merge(i, 2, Integer::sum);
+                    }
+                    items.add(it);
+                    Zoo.check(r == valid, () -> log + ": add returned " + r);
+                }
+                if (!valid) {
+                    Zoo.check(!f.isValid(), () -> log + ": isValid is true after an underflow");
+                    break; // the documented invalid state: nothing more is promised
+                }
+                Zoo.check(f.isValid(), () -> log + ": isValid is false");
+                Map<Integer, Integer> got = new TreeMap<>();
+                f.processCells((i, c) -> {
+                    got.put(i, c);
+                    return true;
+                });
+                Map<Integer, Integer> want = new TreeMap<>();
+                cells.forEach((k, v) -> {
+                    if (v != 0) {
+                        want.put(k, v);
+                    }
+                });
+                Zoo.check(got.equals(want), () -> log + ": cells " + got + ", model " + want);
+                Zoo.check(f.cardinality() == want.size(), () -> log + ": cardinality " + f.cardinality() + ", model " + want.size());
+                TreeSet<Integer> set = new TreeSet<>(want.keySet());
+                Zoo.check(Arrays.equals(f.asIndexArray(), array(set)) && Arrays.equals(f.asBitMapArray(), bitMaps(set, m)), () -> log + ": indices " + Arrays.toString(f.asIndexArray()));
+                for (Item i : items) {
+                    TreeSet<Integer> ii = indices(i.initial, i.increment, shape);
+                    boolean present = set.containsAll(ii);
+                    Zoo.check(f.contains(i.hasher()) == present, () -> log + ": contains(" + i + ") = " + !present);
+                    int maxInsert = Integer.MAX_VALUE;
+                    for (int x : ii) {
+                        maxInsert = Math.min(maxInsert, want.getOrDefault(x, 0));
+                    }
+                    int mi = maxInsert;
+                    Zoo.check(f.getMaxInsert(i.hasher()) == mi, () -> log + ": getMaxInsert(" + i + ") = " + f.getMaxInsert(i.hasher()) + ", model " + mi);
+                }
+                Zoo.check(f.getMaxCell() == Integer.MAX_VALUE, () -> log + ": getMaxCell " + f.getMaxCell());
+            }
+        }, Zoo.settings("countingFilterCountsLikeTheModel"));
+    }
+
+    @Test
+    void layeredFilterTracksItsLayers() {
+        Hegel.test(tc -> {
+            Shape shape = shape(tc);
+            int every = Zoo.n(tc, 1, 4);
+            int maxLayers = Zoo.n(tc, 1, 4);
+            boolean countBased = Zoo.chance(tc, 60);
+            LayerManager.Builder<SimpleBloomFilter> b = LayerManager.<SimpleBloomFilter>builder().setSupplier(() -> new SimpleBloomFilter(shape))
+                    .setCleanup(LayerManager.Cleanup.onMaxSize(maxLayers));
+            b.setExtendCheck(countBased ? LayerManager.ExtendCheck.advanceOnCount(every) : LayerManager.ExtendCheck.advanceOnPopulated());
+            LayeredBloomFilter<SimpleBloomFilter> f = new LayeredBloomFilter<>(shape, b.get());
+            // model: a list of layers, each a set of indices; the target is the last
+            List<TreeSet<Integer>> layers = new ArrayList<>();
+            layers.add(new TreeSet<>());
+            int calls = 0;
+            int n = Zoo.n(tc, 0, 10);
+            StringBuilder log = new StringBuilder("layered " + shape + (countBased ? " advanceOnCount(" + every + ")" : " advanceOnPopulated") + " onMaxSize(" + maxLayers + ")");
+            List<Item> items = new ArrayList<>();
+            for (int s = 0; s < n; s++) {
+                Item it = item(tc);
+                TreeSet<Integer> ix = indices(it.initial, it.increment, shape);
+                log.append(" merge(").append(it).append(')');
+                // extend check before the merge
+                calls++;
+                boolean advance = countBased ? calls % every == 0 : !layers.get(layers.size() - 1).isEmpty();
+                if (advance) {
+                    while (layers.size() > maxLayers) {
+                        layers.remove(0);
+                    }
+                    layers.add(new TreeSet<>());
+                }
+                f.merge(it.hasher());
+                layers.get(layers.size() - 1).addAll(ix);
+                items.add(it);
+                Zoo.check(f.getDepth() == layers.size(), () -> log + ": depth " + f.getDepth() + ", model " + layers.size());
+                for (int d = 0; d < layers.size(); d++) {
+                    int dd = d;
+                    int[] got = f.get(d).asIndexArray();
+                    Zoo.check(Arrays.equals(got, array(layers.get(d))), () -> log + ": layer " + dd + " = " + Arrays.toString(got) + ", model " + layers.get(dd));
+                }
+                TreeSet<Integer> union = new TreeSet<>();
+                layers.forEach(union::addAll);
+                Zoo.check(f.cardinality() == union.size() && Arrays.equals(f.flatten().asIndexArray(), array(union)), () -> log + ": cardinality " + f.cardinality() + ", flattened " + Arrays.toString(f.flatten().asIndexArray()) + ", model " + union);
+                for (Item i : items) {
+                    TreeSet<Integer> ii = indices(i.initial, i.increment, shape);
+                    List<Integer> found = new ArrayList<>();
+                    for (int d = 0; d < layers.size(); d++) {
+                        if (layers.get(d).containsAll(ii)) {
+                            found.add(d);
+                        }
+                    }
+                    int[] got = f.find(i.hasher());
+                    Zoo.check(Arrays.equals(got, found.stream().mapToInt(Integer::intValue).toArray()), () -> log + ": find(" + i + ") = " + Arrays.toString(got) + ", model " + found);
+                    Zoo.check(f.contains(i.hasher()) == !found.isEmpty(), () -> log + ": contains(" + i + ") = " + found.isEmpty());
+                }
+            }
+        }, Zoo.settings("layeredFilterTracksItsLayers"));
+    }
+
+    @Test
+    void shapeArithmeticMatchesTheFormulas() {
+        Hegel.test(tc -> {
+            int n = Zoo.n(tc, 1, 100000);
+            double p = Zoo.pick(tc, 0.5, 0.1, 0.01, 0.001, 1e-6);
+            Shape s = Shape.fromNP(n, p);
+            int m = s.getNumberOfBits();
+            int k = s.getNumberOfHashFunctions();
+            double wantM = Math.ceil(n * Math.log(p) / (Math.log(1.0 / Math.pow(2, Math.log(2)))));
+            double wantK = Math.round(Math.log(2) * m / n);
+            Zoo.check(m == (int) wantM && k == (int) Math.max(1, wantK), () -> "fromNP(" + n + ", " + p + ") = " + s + ", the formulas give m=" + wantM + " k=" + wantK);
+            Zoo.check(s.getProbability(n) <= p * 1.05 || s.getProbability(n) <= p + 1e-9, () -> s + " for n=" + n + ": probability " + s.getProbability(n) + " exceeds the requested " + p);
+            Zoo.check(s.getProbability(0) == 0, () -> s + ": getProbability(0) = " + s.getProbability(0));
+            double want = Math.pow(-Math.expm1(-1.0 * k * n / m), k);
+            Zoo.check(Math.abs(s.getProbability(n) - want) < 1e-12, () -> s + ": getProbability(" + n + ") = " + s.getProbability(n) + ", formula " + want);
+            Zoo.check(Shape.fromNM(n, m).equals(Shape.fromKM(k, m)) && Shape.fromNMK(n, m, k).equals(s) && s.hashCode() == Shape.fromKM(k, m).hashCode(), () -> s + ": fromNM/fromNMK differ: " + Shape.fromNM(n, m) + ", " + Shape.fromNMK(n, m, k));
+            Shape pmk = Shape.fromPMK(p, m, k);
+            Zoo.check(pmk.equals(s), () -> "fromPMK(" + p + ", " + m + ", " + k + ") = " + pmk + ", expected " + s);
+            int c = Zoo.n(tc, 0, m);
+            double est = s.estimateN(c);
+            double wantEst = -(m / (double) k) * Math.log1p(-c / (double) m);
+            Zoo.check(c == m ? Double.isInfinite(est) : Math.abs(est - wantEst) < 1e-9 * Math.max(1, Math.abs(wantEst)), () -> s + ": estimateN(" + c + ") = " + est + ", formula " + wantEst);
+            Zoo.check(Double.isNaN(s.estimateN(m + 1)), () -> s + ": estimateN(m+1) = " + s.estimateN(m + 1));
+            Zoo.check(Math.abs(s.estimateMaxN() - m * Math.log(2) / k) < 1e-9, () -> s + ": estimateMaxN " + s.estimateMaxN());
+            Zoo.check(s.isSparse(c) == (c <= BitMaps.numberOfBitMaps(m) * 2), () -> s + ": isSparse(" + c + ") = " + s.isSparse(c));
+            for (int bad : new int[] {0, -1}) {
+                try {
+                    Shape.fromKM(bad, m);
+                    Zoo.fail("fromKM(" + bad + ", " + m + ") accepted");
+                } catch (IllegalArgumentException expected) {
+                    // documented
+                }
+                try {
+                    Shape.fromKM(k, bad);
+                    Zoo.fail("fromKM(" + k + ", " + bad + ") accepted");
+                } catch (IllegalArgumentException expected) {
+                    // documented
+                }
+            }
+            try {
+                Shape.fromNP(n, Zoo.pick(tc, 0.0, 1.0, -0.5, Double.NaN));
+                Zoo.fail("fromNP accepted a probability outside (0, 1)");
+            } catch (IllegalArgumentException expected) {
+                // documented
+            }
+        }, Zoo.settings("shapeArithmeticMatchesTheFormulas"));
+    }
+}
