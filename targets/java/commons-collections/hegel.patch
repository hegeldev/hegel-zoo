+            return Zoo.pick(tc, "a", "A", "b", "B", "ab", "aB", "Ab", "c", "");
+        }
+        if (kind != MapKind.LRU && Zoo.chance(tc, 8)) {
+            return null; // LRUMap and a null key under eviction is bug commons-collections/1's shape
+        }
+        return Zoo.n(tc, 0, 6);
+    }
