+/**
+ * SnakeYAML's dumper side: values dumped under drawn DumperOptions load back equal (and PyYAML
+ * reads them the same), and event/node streams survive emitting and serializing.
+ */
+class SnakeYamlDumpTest {
+
+    // ---- values -------------------------------------------------------------------------------
+
+    /** An Integer when the value fits and 70% of the time, else a Long; 15% of the time a BigInteger, possibly beyond long. */
+    static final Generator<Object> INTEGER_VALUE = tuples(YamlGen.INT, chance(15), sampledFrom(1L, 1000000007L, Long.MAX_VALUE), chance(70)).map(t -> {
+        long v = t.value1();
+        if (t.value2()) {
+            return BigInteger.valueOf(v).multiply(BigInteger.valueOf(t.value3()));
+        }
+        return v >= Integer.MIN_VALUE && v <= Integer.MAX_VALUE && t.value4() ? (Object) (int) v : (Object) v;
+    });
+
+    static final long DATE_LO = -12219292800000L; // 1583-01-01T00:00Z, after the Gregorian cutover
+    static final long DATE_HI = 253402300799999L; // 9999-12-31T23:59:59.999Z
+
+    /** A Date: around 2000 in whole seconds (50%), or anywhere in 1583..9999, in whole seconds 70% of the time. */
+    static final Generator<Date> DATE = weighted(
+        w(50, ints(-1_000_000_000, 1_000_000_000).map(k -> new Date(946684800000L + k * 1000L))),
+        w(50, tuples(ints(0, 1_000_000), chance(70)).map(t -> {
+            long ms = DATE_LO + (long) (t.value1() / 1000000.0 * (DATE_HI - DATE_LO));
+            return new Date(t.value2() ? ms - ms % 1000 : ms);
+        })));
+
+    static final Generator<byte[]> BYTES = lists(ints(0, 255)).maxSize(8).map(l -> {
+        byte[] b = new byte[l.size()];
+        for (int i = 0; i < b.length; i++) {
+            b[i] = (byte) (int) l.get(i);
+        }
+        return b;
+    });
+
+    /** A scalar Java value: null, Boolean, Integer/Long/BigInteger, Double, Date, byte[] or (46%) String. */
+    static final Generator<Object> SCALAR_VALUE = weighted(
+        w(2, Generators.<Object>just(null)),
+        w(2, chance(50)),
+        w(4, INTEGER_VALUE),
+        w(3, YamlGen.FLOAT),
+        w(1, DATE),
+        w(1, BYTES),
+        w(11, YamlGen.STRING));
+
+    /** A mapping key: a string (80%) or any scalar. */
+    static final Generator<Object> MAP_KEY = weighted(w(80, YamlGen.KEY_TEXT), w(20, SCALAR_VALUE));
+
+    /**
+     * The map with one entry per distinct key spelling: {@code maps} keeps keys apart by {@code equals}, but an
+     * Integer 0, a Long 0 and a BigInteger 0 all dump as the one scalar {@code 0}, which loads back as one key.
+     */
+    static Map<Object, Object> distinctKeys(Map<Object, Object> m) {
+        Map<String, Object> seen = new LinkedHashMap<>();
+        Map<Object, Object> out = new LinkedHashMap<>();
+        for (Map.Entry<Object, Object> e : m.entrySet()) {
+            if (seen.putIfAbsent(Oracle.canon(e.getKey()).toString(), e.getKey()) == null) {
+                out.put(e.getKey(), e.getValue());
+            }
+        }
+        return out;
+    }
+
+    /** A Java value at container depth {@code depth}: a scalar (45%), or (above the bottom) a List or LinkedHashMap of up to five children (25% each) or a LinkedHashSet of up to four scalars. */
+    static Generator<Object> value(int depth) {
+        if (depth >= 3) {
+            return SCALAR_VALUE;
+        }
+        Generator<Object> deeper = value(depth + 1);
+        return weighted(
+            w(45, SCALAR_VALUE),
+            w(25, lists(deeper).maxSize(5).map(ArrayList::new)),
+            w(25, maps(MAP_KEY, deeper).maxSize(5).map(m -> distinctKeys(new LinkedHashMap<>(m)))),
+            w(5, sets(SCALAR_VALUE).maxSize(4).map(LinkedHashSet::new)));
+    }
+
+    static final Generator<Object> VALUE = value(0);
+
+    /** A dump's values after the first ({@code dumpAll}). */
+    static final Generator<List<Object>> MORE = lists(value(1)).maxSize(2);
+
+    // ---- options ------------------------------------------------------------------------------
+
+    /** The layout options; {@code indicatorDraw} is the indicator indent when the indent carries the indicator, else taken modulo the indent. */
+    record Layout(DumperOptions.FlowStyle flow, DumperOptions.ScalarStyle scalar, int indent, boolean indentWithIndicator, int indicatorDraw, int width, boolean splitLines, boolean prettyFlow) {}
+
+    record Framing(boolean allowUnicode, boolean canonical, boolean explicitStart, boolean explicitEnd, DumperOptions.LineBreak lineBreak, int maxSimpleKeyLength, DumperOptions.NonPrintableStyle nonPrintable, boolean version11) {}
+
+    record Options(Layout layout, Framing framing) {
+        int indicatorIndent() {
+            return layout.indentWithIndicator() ? layout.indicatorDraw() : layout.indicatorDraw() % layout.indent();
+        }
+
+        /**
+         * snakeyaml/6: indent 10 (and 1) is silently replaced by 2 in the emitter; with an indicator indent of 2
+         * or more the sequence indicators then sit deeper than their content and the dump does not parse.
+         */
+        boolean brokenIndent() {
+            return (layout.indent() == 10 || layout.indent() == 1) && indicatorIndent() >= 2 && !layout.indentWithIndicator();
+        }
+
+        DumperOptions build() {
+            DumperOptions o = new DumperOptions();
+            o.setDefaultFlowStyle(layout.flow());
+            o.setDefaultScalarStyle(layout.scalar());
+            o.setIndent(layout.indent());
+            o.setIndentWithIndicator(layout.indentWithIndicator());
+            o.setIndicatorIndent(indicatorIndent());
+            o.setWidth(layout.width());
+            o.setSplitLines(layout.splitLines());
+            o.setPrettyFlow(layout.prettyFlow());
+            o.setAllowUnicode(framing.allowUnicode());
+            if (framing.canonical()) {
+                o.setCanonical(true);
+            }
+            o.setExplicitStart(framing.explicitStart());
+            o.setExplicitEnd(framing.explicitEnd());
+            o.setLineBreak(framing.lineBreak());
+            o.setMaxSimpleKeyLength(framing.maxSimpleKeyLength());
+            o.setNonPrintableStyle(framing.nonPrintable());
+            if (framing.version11()) {
+                o.setVersion(DumperOptions.Version.V1_1);
+            }
+            return o;
+        }
+    }
+
+    static final Generator<Layout> LAYOUT = tuples(
+            sampledFrom(DumperOptions.FlowStyle.BLOCK, DumperOptions.FlowStyle.BLOCK, DumperOptions.FlowStyle.FLOW, DumperOptions.FlowStyle.AUTO),
+            sampledFrom(DumperOptions.ScalarStyle.PLAIN, DumperOptions.ScalarStyle.PLAIN, DumperOptions.ScalarStyle.SINGLE_QUOTED, DumperOptions.ScalarStyle.DOUBLE_QUOTED, DumperOptions.ScalarStyle.LITERAL, DumperOptions.ScalarStyle.FOLDED),
+            sampledFrom(2, 2, 1, 3, 4, 8, 10), chance(30), ints(0, 9), sampledFrom(80, 80, 1, 10, 20, 40, 200, 1000), chance(70), chance(30))
+        .map(t -> new Layout(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    static final Generator<Framing> FRAMING = tuples(chance(70), chance(10), chance(30), chance(30),
+            sampledFrom(DumperOptions.LineBreak.UNIX, DumperOptions.LineBreak.UNIX, DumperOptions.LineBreak.WIN, DumperOptions.LineBreak.MAC),
+            sampledFrom(128, 128, 8, 1024, 1), sampledFrom(DumperOptions.NonPrintableStyle.BINARY, DumperOptions.NonPrintableStyle.ESCAPE), chance(15))
+        .map(t -> new Framing(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    /** Dumper options; the shape of snakeyaml/6 (about 8% of draws) is kept out. */
+    static final Generator<Options> OPTIONS = tuples(LAYOUT, FRAMING).map(t -> new Options(t.value1(), t.value2())).filter(o -> !o.brokenIndent());
+
+    static final Pattern JAVA_EXPONENT = Pattern.compile("[0-9]\\.[0-9]*E[0-9]");
+    static final Pattern VALUE_SCALAR = Pattern.compile("(^|[\\s\\[{,:-])=(\\s|$|[,\\]}])");
+    static final Pattern INDENTATION_INDICATOR = Pattern.compile("[|>][+-]?[1-9]|[|>][1-9][+-]?");
+    /** snakeyaml/16: a line holding nothing but `\\` inside a double-quoted scalar - an escaped backslash where a continuation was meant. */
+    static final Pattern DOUBLED_CONTINUATION = Pattern.compile("(^|\\r|\\n) *\\\\\\\\(\\r|\\n)");
+
+    /** Whether any string in the value (keys included) satisfies {@code test}. */
+    static boolean anyString(Object v, Predicate<String> test) {
+        if (v instanceof String) {
+            return test.test((String) v);
+        }
+        if (v instanceof List) {
+            return ((List<?>) v).stream().anyMatch(x -> anyString(x, test));
+        }
+        if (v instanceof Set) {
+            return ((Set<?>) v).stream().anyMatch(x -> anyString(x, test));
+        }
+        if (v instanceof Map) {
+            return ((Map<?, ?>) v).entrySet().stream().anyMatch(e -> anyString(e.getKey(), test) || anyString(e.getValue(), test));
+        }
+        return false;
+    }
+
+    /** Whether any string in the value holds one of {@code chars}. */
+    static boolean containsAny(Object v, String chars) {
+        return anyString(v, s -> Doc.hasAny(s, chars));
+    }
+
+    /**
+     * snakeyaml/21: a folded scalar that starts with a space loses it when the header is written past
+     * the width with splitLines on: Emitter.writeFolded replaces a chunk of one space by an indent when the column
+     * is past the width, and at the head of the text that indent is the one already written. [[[" a"]]] dumped with
+     * indent 4, width 10 and the FOLDED default style gives `-   -   - >4-` and a line of twelve spaces and `a`,
+     * which loads (here and in PyYAML) as [[["a"]]]; the LITERAL style and indent 2 keep the space.
+     */
+    static boolean foldedLeadingSpace(Object value, DumperOptions o) {
+        return o.getDefaultScalarStyle() == DumperOptions.ScalarStyle.FOLDED && o.getSplitLines() && anyString(value, s -> s.startsWith(" "));
+    }
+
+    static boolean containsNel(Object v) {
+        return containsAny(v, "\u0085");
+    }
+
+    /**
+     * snakeyaml/12's other face for U+2028 and U+2029: the emitter writes a YAML 1.1 line break found in a block
+     * scalar verbatim (Emitter.writeLiteral) and, when the string ends with one, counts it as the line break it owes,
+     * so the dump ends with the raw separator instead of the configured line break. Unlike NEL these two are not
+     * folded to "\n" by the reader, so the value still loads back; only the line-break check is skipped.
+     */
+    static boolean containsSeparator(Object v) {
+        return containsAny(v, "\u2028\u2029");
+    }
+
+    /** A U+FEFF at the start of a line: libyaml skips it as a byte order mark anywhere at column 0 (pure PyYAML and SnakeYAML read it as content). */
+    static boolean bomAtLineStart(String text) {
+        return leadingBom(text) || text.contains("\n\ufeff") || text.contains("\r\ufeff");
+    }
+
+    /**
+     * Python's numbers are equal across types (False == 0 == 0.0 == -0.0, True == 1 == 1.0), so PyYAML merges
+     * set members and mapping keys that Java keeps apart; the PyYAML comparison is skipped for such values
+     * (an oracle difference, not a SnakeYAML one). Compared as doubles, which is exact for every value drawn.
+     */
+    static boolean pythonMerges(Object v) {
+        if (v instanceof List) {
+            return ((List<?>) v).stream().anyMatch(SnakeYamlDumpTest::pythonMerges);
+        }
+        if (v instanceof Set || v instanceof Map) {
+            Collection<?> members = v instanceof Set ? (Set<?>) v : ((Map<?, ?>) v).keySet();
+            List<Double> numbers = new ArrayList<>();
+            for (Object k : members) {
+                Double d = k instanceof Boolean b ? (b ? 1.0 : 0.0) : k instanceof Number n ? n.doubleValue() : null;
+                if (d == null) {
+                    continue;
+                }
+                for (Double x : numbers) {
+                    if (x.doubleValue() == d.doubleValue()) {
+                        return true;
+                    }
+                }
+                numbers.add(d);
+            }
+            return v instanceof Map && ((Map<?, ?>) v).values().stream().anyMatch(SnakeYamlDumpTest::pythonMerges);
+        }
+        return false;
+    }
+
+    /**
+     * snakeyaml/17: a string beginning with U+FEFF, written plain (allowUnicode) as the first scalar
+     * of the stream, loses that character to the reader, which strips it as the stream's byte order mark: the
+     * dump of the one-character string U+FEFF loads as no document at all, that of U+FEFF followed by "x" as "x"
+     * (PyYAML's emitter quotes any string holding U+FEFF). Inside a collection, or quoted, it round-trips.
+     */
+    static boolean leadingBom(String text) {
+        return text.startsWith("\ufeff");
+    }
+
+    /** What a dump loads back as: with the BINARY style, strings holding non-printable characters come back as their UTF-8 bytes. */
+    static JsonElement expected(Object value, DumperOptions.NonPrintableStyle nps) {
+        return Oracle.canon(nps == DumperOptions.NonPrintableStyle.BINARY ? binarised(value) : value);
+    }
+
+    static Object binarised(Object v) {
+        if (v instanceof String) {
+            return StreamReader.isPrintable((String) v) ? v : ((String) v).getBytes(java.nio.charset.StandardCharsets.UTF_8);
+        }
+        if (v instanceof List) {
+            List<Object> l = new ArrayList<>();
+            for (Object x : (List<?>) v) {
+                l.add(binarised(x));
+            }
+            return l;
+        }
+        if (v instanceof Set) {
+            Set<Object> s = new LinkedHashSet<>();
+            for (Object x : (Set<?>) v) {
+                s.add(binarised(x));
+            }
+            return s;
+        }
+        if (v instanceof Map) {
+            Map<Object, Object> m = new LinkedHashMap<>();
+            for (Map.Entry<?, ?> e : ((Map<?, ?>) v).entrySet()) {
+                m.put(binarised(e.getKey()), binarised(e.getValue()));
+            }
+            return m;
+        }
+        return v;
+    }
+
+    static Yaml yamlFor(DumperOptions o) {
+        LoaderOptions lo = new LoaderOptions();
+        return new Yaml(new SafeConstructor(lo), new Representer(o), o, lo);
+    }
+
+    // ---- 1. dump -> load, in SnakeYAML and in PyYAML --------------------------------------------
+
+    /** A value, the options it is dumped with, and the values dumped after it by {@code dumpAll}. */
+    record DumpCase(Object value, Options options, List<Object> more) {}
+
+    static final Generator<DumpCase> DUMP_CASE = tuples(VALUE, OPTIONS, MORE).map(t -> new DumpCase(t.value1(), t.value2(), t.value3()));
+
+    @Test
+    void dumpedValuesLoadBackAndPyYAMLReadsThem() {
+        Oracle oracle = Oracle.get();
+        Hegel.test(tc -> {
+            DumpCase c = tc.draw(DUMP_CASE, "case");
+            Object value = c.value();
+            DumperOptions o = c.options().build();
+            Yaml yaml = yamlFor(o);
+            JsonElement expected = expected(value, o.getNonPrintableStyle());
+            String text;
+            try {
+                text = yaml.dump(value);
+            } catch (YAMLException ex) {
+                fail("dump threw " + ex.getClass().getSimpleName() + ": " + SnakeYamlTest.firstLine(ex.getMessage()) + " for " + Oracle.show(expected) + " with " + c.options());
+                return;
+            }
+            // snakeyaml/12: a string holding U+0085 dumped as a block scalar comes back with "\n" in its place; and
+            // when the string ends with the NEL the emitter counts it as the line break it owes, so the dump ends
+            // with the raw NEL instead of the line break (dumping the one-character string NEL gives "|2+", a line break and the NEL) - the same bug's
+            // other face, reached by the rewrite's rounds, so the gate comes before the framing checks
+            tc.assume(!containsNel(value));
+            String tag = "options " + c.options() + ", value " + Oracle.show(expected) + SnakeYamlTest.describe(text);
+            String br = o.getLineBreak().getString();
+            check(text.endsWith(br) || containsSeparator(value), () -> "the dump does not end with the line break for " + tag);
+            check(!o.isCanonical() || text.startsWith("---") || text.startsWith("%"), () -> "a canonical dump without --- for " + tag);
+            check(!o.isExplicitStart() || text.startsWith("---") || text.startsWith("%"), () -> "explicitStart without --- for " + tag);
+            // snakeyaml/7: a Double with a positive exponent dumps as 1.0E10, which YAML 1.1 readers take as a string
+            boolean javaFloat = JAVA_EXPONENT.matcher(text).find();
+            // a plain `=` is !!value for YAML 1.1 readers; PyYAML has no constructor for it (its gap, not SnakeYAML's)
+            boolean valueKey = VALUE_SCALAR.matcher(text).find();
+            // snakeyaml/14: with an indicator indent, block scalars that need an indentation indicator get a wrong one
+            boolean brokenIndicator = o.getIndicatorIndent() >= 1 && !o.getIndentWithIndicator() && INDENTATION_INDICATOR.matcher(text).find();
+            // snakeyaml/16: a double-quoted scalar indented past the width gets `\\` for a continuation
+            boolean doubledContinuation = DOUBLED_CONTINUATION.matcher(text).find();
+            tc.assume(!(brokenIndicator || doubledContinuation || leadingBom(text) || foldedLeadingSpace(value, o)));
+            check(!o.isExplicitEnd() || text.endsWith("..." + br), () -> "explicitEnd without ... for " + tag);
+            SnakeYamlTest.Loaded back = SnakeYamlTest.loadAll(yamlFor(o), text);
+            check(back.ok() && back.docs.size() == 1 && Oracle.same(back.canon().get(0), expected), () -> "loads back as " + back + " for " + tag);
+            // PyYAML reads the same
+            if (!javaFloat && !valueKey && !pythonMerges(value) && !bomAtLineStart(text)) {
+                Oracle.Loaded theirs = oracle.load(text);
+                check(theirs.ok() && theirs.docs.size() == 1 && Oracle.same(theirs.docs.get(0), expected), () -> "PyYAML reads " + theirs + " for " + tag);
+            }
+            // dumpAll of a few values loads back as the list (a later value holding NEL is left out, snakeyaml/12)
+            List<Object> several = new ArrayList<>();
+            several.add(value);
+            for (Object v : c.more()) {
+                if (!containsNel(v)) {
+                    several.add(v);
+                }
+            }
+            JsonArray expectedAll = new JsonArray();
+            for (Object v : several) {
+                expectedAll.add(expected(v, o.getNonPrintableStyle()));
+            }
+            try {
+                String all = yamlFor(o).dumpAll(several.iterator());
+                tc.assume(!(o.getIndicatorIndent() >= 1 && !o.getIndentWithIndicator() && INDENTATION_INDICATOR.matcher(all).find())); // snakeyaml/14
+                tc.assume(!DOUBLED_CONTINUATION.matcher(all).find()); // snakeyaml/16
+                tc.assume(!leadingBom(all)); // snakeyaml/17
+                tc.assume(!several.stream().anyMatch(v -> foldedLeadingSpace(v, o))); // snakeyaml/21
+                SnakeYamlTest.Loaded backAll = SnakeYamlTest.loadAll(yamlFor(o), all);
+                check(backAll.ok() && Oracle.same(backAll.canon(), expectedAll), () -> "dumpAll loads back as " + backAll + " instead of " + Oracle.show(expectedAll) + " for options " + c.options() + SnakeYamlTest.describe(all));
+                if (!JAVA_EXPONENT.matcher(all).find() && !VALUE_SCALAR.matcher(all).find() && !several.stream().anyMatch(SnakeYamlDumpTest::pythonMerges) && !bomAtLineStart(all)) {
+                    Oracle.Loaded theirsAll = oracle.load(all);
+                    check(theirsAll.ok() && Oracle.same(theirsAll.docs, expectedAll), () -> "PyYAML reads dumpAll as " + theirsAll + " instead of " + Oracle.show(expectedAll) + " for options " + c.options() + SnakeYamlTest.describe(all));
+                }
+            } catch (YAMLException ex) {
+                fail("dumpAll threw " + ex.getClass().getSimpleName() + ": " + SnakeYamlTest.firstLine(ex.getMessage()) + " for " + tag);
+            }
+            // the default Yaml agrees with itself too
+            String plain = new Yaml().dump(value);
+            tc.assume(!leadingBom(plain)); // snakeyaml/17
+            JsonElement expectedPlain = expected(value, DumperOptions.NonPrintableStyle.BINARY);
+            SnakeYamlTest.Loaded backPlain = SnakeYamlTest.loadAll(SnakeYamlTest.safeYaml(), plain);
+            check(backPlain.ok() && backPlain.docs.size() == 1 && Oracle.same(backPlain.canon().get(0), expectedPlain), () -> "new Yaml().dump loads back as " + backPlain + " for " + Oracle.show(expectedPlain) + SnakeYamlTest.describe(plain));
+        }, Zoo.settings("dumpedValuesLoadBackAndPyYAMLReadsThem"));
+    }
+
+    // ---- 2. events and nodes survive emitting and serializing -----------------------------------
+
+    static List<Event> events(Yaml yaml, String text) {
+        List<Event> events = new ArrayList<>();
+        for (Event e : yaml.parse(new StringReader(text))) {
+            events.add(e);
+        }
+        return events;
+    }
+
+    static String describeEvents(List<Event> events) {
+        StringBuilder sb = new StringBuilder();
+        for (Event e : events) {
+            sb.append("\n    ").append(e);
+        }
+        return sb.toString();
+    }
+
+    static String nodeShape(Node node, boolean styles) {
+        StringBuilder sb = new StringBuilder();
+        shape(node, styles, sb);
+        return sb.toString();
+    }
+
+    static void shape(Node node, boolean styles, StringBuilder sb) {
+        sb.append(node.getTag().getValue()).append(' ');
+        if (node instanceof ScalarNode) {
+            ScalarNode s = (ScalarNode) node;
+            sb.append('"').append(s.getValue().replace("\\", "\\\\").replace("\"", "\\\"")).append('"');
+            if (styles) {
+                sb.append(' ').append(s.getScalarStyle());
+            }
+        } else if (node instanceof SequenceNode) {
+            if (styles) {
+                sb.append(((CollectionNode<?>) node).getFlowStyle()).append(' ');
+            }
+            sb.append('[');
+            for (Node child : ((SequenceNode) node).getValue()) {
+                shape(child, styles, sb);
+                sb.append(", ");
+            }
+            sb.append(']');
+        } else if (node instanceof MappingNode) {
+            if (styles) {
+                sb.append(((CollectionNode<?>) node).getFlowStyle()).append(' ');
+            }
+            sb.append('{');
+            for (NodeTuple t : ((MappingNode) node).getValue()) {
+                shape(t.getKeyNode(), styles, sb);
+                sb.append(": ");
+                shape(t.getValueNode(), styles, sb);
+                sb.append(", ");
+            }
+            sb.append('}');
+        } else {
+            sb.append(node.getClass().getSimpleName());
+        }
+    }
+
+    /** A written stream and the options its events are emitted back with. */
+    record EmitCase(Doc.Stream stream, Options options) {}
+
+    static final Generator<EmitCase> EMIT_CASE = tuples(YamlGen.STREAM, OPTIONS).map(t -> new EmitCase(t.value1(), t.value2()));
+
+    @Test
+    void eventsAndNodesSurviveEmitting() {
+        Hegel.test(tc -> {
+            EmitCase c = tc.draw(EMIT_CASE, "case");
+            String text = c.stream().render();
+            Yaml yaml = SnakeYamlTest.safeYaml();
+            String tag = SnakeYamlTest.describe(text);
+            List<Event> events;
+            try {
+                events = events(yaml, text);
+            } catch (YAMLException ex) {
+                fail("parse threw " + ex.getClass().getSimpleName() + ": " + SnakeYamlTest.firstLine(ex.getMessage()) + " for " + tag);
+                return;
+            }
+            check(events.size() >= 2 && events.get(0).is(Event.ID.StreamStart) && events.get(events.size() - 1).is(Event.ID.StreamEnd), () -> "the event stream is not framed for " + tag + describeEvents(events));
+            SnakeYamlTest.Loaded original = SnakeYamlTest.loadAll(yaml, text);
+            // emit the events back and parse them again
+            DumperOptions o = c.options().build();
+            tc.assume(text.indexOf('\u0085') < 0); // snakeyaml/12
+            // snakeyaml/21: a folded scalar starting with a space, emitted past the width, loses the space
+            tc.assume(!(o.getDefaultScalarStyle() == DumperOptions.ScalarStyle.FOLDED && o.getSplitLines()
+                && events.stream().anyMatch(e -> e instanceof org.yaml.snakeyaml.events.ScalarEvent s && s.getValue().startsWith(" "))));
+            StringWriter sw = new StringWriter();
+            String emitted;
+            try {
+                Emitter emitter = new Emitter(sw, o);
+                for (Event e : events) {
+                    emitter.emit(e);
+                }
+                emitted = sw.toString();
+            } catch (YAMLException | java.io.IOException ex) {
+                fail("emitting the parsed events threw " + ex.getClass().getSimpleName() + ": " + SnakeYamlTest.firstLine(ex.getMessage()) + " with " + c.options() + " for " + tag + describeEvents(events));
+                return;
+            }
+            tc.assume(!(o.getIndicatorIndent() >= 1 && !o.getIndentWithIndicator() && INDENTATION_INDICATOR.matcher(emitted).find())); // snakeyaml/14
+            tc.assume(!DOUBLED_CONTINUATION.matcher(emitted).find()); // snakeyaml/16
+            String etag = "emitted with " + c.options() + SnakeYamlTest.describe(emitted) + "from " + tag;
+            SnakeYamlTest.Loaded reloaded = SnakeYamlTest.loadAll(SnakeYamlTest.safeYaml(), emitted);
+            check(original.ok() && reloaded.ok() && Oracle.same(reloaded.canon(), original.canon()), () -> "the emitted events load as " + reloaded + " instead of " + original + " for " + etag);
+            try {
+                List<Event> again = events(SnakeYamlTest.safeYaml(), emitted);
+                List<String> a = new ArrayList<>(), b = new ArrayList<>();
+                for (Event e : events) {
+                    a.add(eventKey(e));
+                }
+                for (Event e : again) {
+                    b.add(eventKey(e));
+                }
+                check(a.equals(b), () -> "the re-parsed events differ:" + diffLists(a, b) + "\nfor " + etag);
+            } catch (YAMLException ex) {
+                fail("re-parsing the emitted text threw " + ex.getClass().getSimpleName() + ": " + SnakeYamlTest.firstLine(ex.getMessage()) + " for " + etag);
+            }
+            // compose -> serialize -> compose keeps the node shape
+            try {
+                List<Node> nodes = new ArrayList<>();
+                for (Node node : SnakeYamlTest.safeYaml().composeAll(new StringReader(text))) {
+                    nodes.add(node);
+                }
+                for (Node node : nodes) {
+                    StringWriter nw = new StringWriter();
+                    Yaml ny = yamlFor(o);
+                    ny.serialize(node, nw);
+                    String ntext = nw.toString();
+                    tc.assume(!DOUBLED_CONTINUATION.matcher(ntext).find()); // snakeyaml/16
+                    Node back = SnakeYamlTest.safeYaml().compose(new StringReader(ntext));
+                    String before = nodeShape(node, false), after = back == null ? "null" : nodeShape(back, false);
+                    check(before.equals(after), () -> "serialize+compose changed the node from " + before + " to " + after + " with " + c.options() + SnakeYamlTest.describe(ntext) + "for " + tag);
+                    // and the node's events are the document's events
+                    List<Event> nodeEvents = ny.serialize(node);
+                    check(nodeEvents.size() >= 4 && nodeEvents.get(0).is(Event.ID.StreamStart) && nodeEvents.get(1).is(Event.ID.DocumentStart), () -> "serialize(node) gives " + describeEvents(nodeEvents) + " for " + tag);
+                }
+            } catch (YAMLException ex) {
+                fail("compose/serialize threw " + ex.getClass().getSimpleName() + ": " + SnakeYamlTest.firstLine(ex.getMessage()) + " with " + c.options() + " for " + tag);
+            }
+        }, Zoo.settings("eventsAndNodesSurviveEmitting"));
+    }
+
+    /** What must survive an emit: the event kind, anchors, tags, implicitness and scalar values (not styles). */
+    static String eventKey(Event e) {
+        String s = e.toString();
+        // drop the style, which the emitter may legitimately change, and the non-specific tag `!` it
+        // adds when it has to quote a plain implicit scalar (the meaning is the same: a string)
+        return s.replaceAll("style=[^,)]*,", "").replace("tag=!,", "tag=null,");
+    }
+
+    static String diffLists(List<String> a, List<String> b) {
+        StringBuilder sb = new StringBuilder();
+        int max = Math.max(a.size(), b.size());
+        for (int i = 0; i < max; i++) {
+            String x = i < a.size() ? a.get(i) : "<none>", y = i < b.size() ? b.get(i) : "<none>";
+            if (!x.equals(y)) {
+                sb.append("\n    #").append(i).append(": ").append(x).append("\n      -> ").append(y);
+            }
+        }
+        return sb.toString();
+    }
+
+    static String show(Object o) {
+        return Oracle.show(Oracle.canon(o));
+    }
+
+    static List<Object> list(Object... xs) {
+        return new ArrayList<>(Arrays.asList(xs));
+    }
+}
diff --git a/hegel/src/test/java/zoo/SnakeYamlPinsTest.java b/hegel/src/test/java/zoo/SnakeYamlPinsTest.java
new file mode 100644
index 0000000..197882d
--- /dev/null
+++ b/hegel/src/test/java/zoo/SnakeYamlPinsTest.java
@@ -0,0 +1,190 @@
+package zoo;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.time.Instant;
+import java.util.Arrays;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.yaml.snakeyaml.DumperOptions;
+import org.yaml.snakeyaml.LoaderOptions;
+import org.yaml.snakeyaml.Yaml;
+import org.yaml.snakeyaml.constructor.SafeConstructor;
+import org.yaml.snakeyaml.error.YAMLException;
+import org.yaml.snakeyaml.nodes.Tag;
+
+/**
+ * One pin per bug in bugs.toml: each asserts the documented (or YAML 1.1) behaviour and fails while
+ * the bug exists; `zoo` expects them to fail (target.toml `[expected_failures]`).
+ */
+class SnakeYamlPinsTest {
+
+    static Yaml safe() {
+        return new Yaml(new SafeConstructor(new LoaderOptions()));
+    }
+
+    @Test
+    void pinPlainScalarContinuationLinesMayStartWithThreeDashes() { // snakeyaml/1
+        assertEquals("a ---x b", safe().load("a\n---x\nb\n"));
+    }
+
+    @Test
+    void pinTheNonSpecificTagMakesAString() { // snakeyaml/2
+        assertEquals("123", safe().load("! 123"));
+    }
+
+    @Test
+    void pinTimestampsWithOutOfRangeFieldsAreRejected() { // snakeyaml/3
+        assertThrows(YAMLException.class, () -> safe().load("2001-02-30"));
+    }
+
+    @Test
+    void pinDatesBeforeTheGregorianCutoverAreProleptic() { // snakeyaml/4
+        assertEquals(Instant.parse("1500-01-01T00:00:00Z"), ((Date) safe().load("1500-01-01")).toInstant());
+    }
+
+    @Test
+    void pinSexagesimalIntegersDoNotOverflow() { // snakeyaml/5
+        assertEquals(360000000000L, ((Number) safe().load("100000000:0:0")).longValue());
+    }
+
+    @Test
+    void pinIndentTenIsHonoured() { // snakeyaml/6
+        DumperOptions o = new DumperOptions();
+        o.setIndent(10);
+        o.setDefaultFlowStyle(DumperOptions.FlowStyle.BLOCK);
+        Map<String, Object> inner = new LinkedHashMap<>();
+        inner.put("b", 1);
+        Map<String, Object> outer = new LinkedHashMap<>();
+        outer.put("a", inner);
+        String text = new Yaml(o).dump(outer);
+        assertEquals("a:\n          b: 1\n", text);
+    }
+
+    @Test
+    void pinDoublesDumpAsYaml11Floats() { // snakeyaml/7
+        String text = new Yaml().dump(1.0E10);
+        assertTrue(text.matches("[-+]?[0-9][0-9_]*\\.[0-9_]*([eE][-+][0-9]+)?\n"), text);
+    }
+
+    @Test
+    void pinDumpAsRestoresTheFlowStyleAfterAnError() { // snakeyaml/8
+        Yaml yaml = new Yaml();
+        Map<String, Object> inner = new LinkedHashMap<>();
+        inner.put("b", "x\ny");
+        Map<String, Object> outer = new LinkedHashMap<>();
+        outer.put("a", inner);
+        String before = yaml.dump(outer);
+        assertThrows(YAMLException.class, () -> yaml.dumpAs("\uD800", Tag.STR, DumperOptions.FlowStyle.FLOW));
+        assertEquals(before, yaml.dump(outer));
+    }
+
+    @Test
+    void pinNestingDepthCountsCollectionsOnly() { // snakeyaml/9
+        LoaderOptions lo = new LoaderOptions();
+        lo.setNestingDepthLimit(1);
+        Yaml yaml = new Yaml(new SafeConstructor(lo));
+        assertThrows(YAMLException.class, () -> yaml.load("[[1]]"));
+        assertThrows(YAMLException.class, () -> yaml.load("[[]]"));
+    }
+
+    @Test
+    void pinTheBoolTagRejectsOtherWords() { // snakeyaml/10
+        assertThrows(YAMLException.class, () -> safe().load("!!bool maybe"));
+    }
+
+    @Test
+    void pinConstructorFailuresAreYamlExceptions() { // snakeyaml/11
+        assertThrows(YAMLException.class, () -> safe().load("!!int abc"));
+    }
+
+    @Test
+    void pinStringsWithNextLineSurviveADump() { // snakeyaml/12
+        Yaml yaml = new Yaml();
+        String value = "a\u0085b";
+        assertEquals(value, yaml.load(yaml.dump(value)));
+    }
+
+    @Test
+    void pinTagsOnTheWrongNodeKindAreYamlExceptions() { // snakeyaml/13
+        assertThrows(YAMLException.class, () -> safe().load("!!int {a: 1}"));
+        assertThrows(YAMLException.class, () -> safe().load("!!map [1]"));
+    }
+
+    @Test
+    void pinBlockScalarsUnderAnIndicatorIndentLoadBack() { // snakeyaml/14
+        DumperOptions o = new DumperOptions();
+        o.setIndicatorIndent(1);
+        o.setDefaultFlowStyle(DumperOptions.FlowStyle.BLOCK);
+        Yaml yaml = new Yaml(o);
+        java.util.List<String> value = list("\nx");
+        assertEquals(value, safe().load(yaml.dump(value)));
+    }
+
+    @Test
+    void pinQuestionMarksInsideFlowPlainScalarsAreContent() { // snakeyaml/15
+        assertEquals(list("b?c"), safe().load("[b?c]"));
+    }
+
+    @Test
+    void pinDeeplyIndentedDoubleQuotedStringsSurviveADump() { // snakeyaml/16
+        DumperOptions o = new DumperOptions();
+        o.setWidth(10);
+        o.setIndent(4);
+        o.setDefaultFlowStyle(DumperOptions.FlowStyle.BLOCK);
+        Map<String, Object> c = new LinkedHashMap<>();
+        c.put("c", "x \n y");
+        Map<String, Object> b = new LinkedHashMap<>();
+        b.put("b", c);
+        Map<String, Object> a = new LinkedHashMap<>();
+        a.put("a", b);
+        assertEquals(a, safe().load(new Yaml(o).dump(a)));
+    }
+
+    @Test
+    void pinStringsStartingWithABomSurviveADump() { // snakeyaml/17
+        Yaml yaml = new Yaml();
+        String value = "\ufeff";
+        assertEquals(value, yaml.load(yaml.dump(value)));
+    }
+
+    @Test
+    void pinDirectivesNeedADocument() { // snakeyaml/18
+        assertThrows(YAMLException.class, () -> safe().load("%YAML 1.1\n"));
+    }
+
+    @Test
+    void pinTabsBeforeSpacesSeparateInFlowContext() { // snakeyaml/19
+        assertEquals(list(), safe().load("[\t ]"));
+    }
+
+    @Test
+    void pinBackslashTabIsATabEscape() { // snakeyaml/20
+        assertEquals("\tn", safe().load("\"\\\tn\""));
+    }
+
+    @Test
+    void pinFoldedScalarsKeepTheirLeadingSpace() { // snakeyaml/21
+        DumperOptions o = new DumperOptions();
+        o.setIndent(4);
+        o.setWidth(10);
+        o.setSplitLines(true);
+        o.setDefaultScalarStyle(DumperOptions.ScalarStyle.FOLDED);
+        o.setDefaultFlowStyle(DumperOptions.FlowStyle.BLOCK);
+        Object value = list(list(list(" a")));
+        assertEquals(value, safe().load(new Yaml(o).dump(value)));
+    }
+
+    @Test
+    void pinBlockScalarsCannotFollowAnExplicitKeyAsItsValue() { // snakeyaml/22
+        assertThrows(YAMLException.class, () -> safe().load("? a\n>\n  x\n"));
+    }
+
+    static <T> java.util.List<T> list(T... xs) {
+        return Arrays.asList(xs);
+    }
+}
diff --git a/hegel/src/test/java/zoo/SnakeYamlTest.java b/hegel/src/test/java/zoo/SnakeYamlTest.java
new file mode 100644
index 0000000..32ec276
--- /dev/null
+++ b/hegel/src/test/java/zoo/SnakeYamlTest.java
@@ -0,0 +1,501 @@
+package zoo;
+
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static dev.hegel.Generators.lists;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.maybe;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Gen.word;
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import dev.hegel.Generator;
+import dev.hegel.Hegel;
+import java.io.StringReader;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.regex.Pattern;
+import org.junit.jupiter.api.Test;
+import org.yaml.snakeyaml.LoaderOptions;
+import org.yaml.snakeyaml.Yaml;
+import org.yaml.snakeyaml.constructor.SafeConstructor;
+import org.yaml.snakeyaml.error.YAMLException;
+import org.yaml.snakeyaml.nodes.Node;
+
+/**
+ * SnakeYAML's parser side against PyYAML (libyaml): streams drawn by {@link YamlGen} load as
+ * their trees in both readers, mutated streams load the same or fail in both, and plain scalars
+ * resolve alike.
+ */
+class SnakeYamlTest {
+
+    static Yaml safeYaml() {
+        return new Yaml(new SafeConstructor(new LoaderOptions()));
+    }
+
+    /** SnakeYAML's documents for a stream, or the exception's message. */
+    static final class Loaded {
+        final List<Object> docs;
+        final Exception error;
+
+        Loaded(List<Object> docs, Exception error) {
+            this.docs = docs;
+            this.error = error;
+        }
+
+        boolean ok() {
+            return error == null;
+        }
+
+        JsonArray canon() {
+            JsonArray a = new JsonArray();
+            for (Object d : docs) {
+                a.add(Oracle.canon(d));
+            }
+            return a;
+        }
+
+        @Override
+        public String toString() {
+            return ok() ? Oracle.show(canon()) : "error " + error.getClass().getSimpleName() + ": " + firstLine(error.getMessage());
+        }
+    }
+
+    static String firstLine(String s) {
+        if (s == null) {
+            return "null";
+        }
+        int i = s.indexOf('\n');
+        return i < 0 ? s : s.substring(0, i);
+    }
+
+    static Loaded loadAll(Yaml yaml, String text) {
+        List<Object> docs = new ArrayList<>();
+        try {
+            for (Object d : yaml.loadAll(text)) {
+                docs.add(d);
+            }
+            return new Loaded(docs, null);
+        } catch (YAMLException | IllegalArgumentException | IllegalStateException | IndexOutOfBoundsException | NullPointerException | ClassCastException | StackOverflowError ex) {
+            return new Loaded(null, ex instanceof Exception ? (Exception) ex : new RuntimeException(ex));
+        }
+    }
+
+    static String describe(String text) {
+        String s = text.length() > 500 ? text.substring(0, 500) + "\u2026" : text;
+        return "\n" + s.replace("\n", "\n    ").replace("\t", "\\t") + "\n";
+    }
+
+    // ---- 1. written documents load as their trees, in SnakeYAML and in PyYAML -------------------
+
+    @Test
+    void writtenDocumentsLoadAsTheirTrees() {
+        Oracle oracle = Oracle.get();
+        Hegel.test(tc -> {
+            Doc.Stream stream = tc.draw(YamlGen.STREAM, "stream");
+            String text = stream.render();
+            JsonArray expected = stream.canon();
+            String tag = describe(text);
+            Loaded mine = loadAll(safeYaml(), text);
+            check(mine.ok() && Oracle.same(mine.canon(), expected), () -> "SnakeYAML loads " + mine + " instead of " + Oracle.show(expected) + " for " + tag);
+            Oracle.Loaded theirs = oracle.load(text);
+            check(theirs.ok() && Oracle.same(theirs.docs, expected), () -> "PyYAML loads " + theirs + " instead of " + Oracle.show(expected) + " (the writer or the oracle is off) for " + tag);
+            // the default constructor gives the same values for these plain trees
+            Loaded viaDefault = loadAll(new Yaml(), text);
+            check(viaDefault.ok() && Oracle.same(viaDefault.canon(), expected), () -> "new Yaml() loads " + viaDefault + " for " + tag);
+            // compose gives one node per document and parse an event stream ending in StreamEnd
+            try {
+                int nodes = 0;
+                for (Node node : safeYaml().composeAll(new StringReader(text))) {
+                    check(node != null, () -> "composeAll gave a null node for " + tag);
+                    nodes++;
+                }
+                final int nodesF = nodes;
+                check(nodes == stream.docs().size(), () -> "composeAll gave " + nodesF + " nodes for " + stream.docs().size() + " documents for " + tag);
+            } catch (YAMLException ex) {
+                fail("composeAll threw " + ex.getClass().getSimpleName() + ": " + firstLine(ex.getMessage()) + " for " + tag);
+            }
+            // a Windows line ending changes nothing
+            if (!text.contains("\r")) {
+                Loaded crlf = loadAll(safeYaml(), text.replace("\n", "\r\n"));
+                check(crlf.ok() && Oracle.same(crlf.canon(), expected), () -> "with CRLF line ends SnakeYAML loads " + crlf + " for " + tag);
+            }
+        }, Zoo.settings("writtenDocumentsLoadAsTheirTrees"));
+    }
+
+    // ---- 2. mutated documents: both readers accept with the same value, or both reject -----------
+
+    static final String[] MUTATION_CHARS = {" ", " ", "\n", "\n", "\t", "-", ":", "?", ",", "[", "]", "{", "}", "#", "&", "*", "!", "|", ">", "'", "\"", "%", "@", "`", "\\", "a", "0", ".", "~", "---", "...", "  ", ": ", "- ", "&a ", "*a", "!!str ", "!!int ", "!!seq ", "!!map ", "!<tag:yaml.org,2002:str> ", "\r", "%YAML 1.1\n---\n", "\ufeff"};
+
+    /** Shapes where SnakeYAML and PyYAML are known to differ (see bugs.toml and the README). */
+    /** An explicit core-schema tag, in the {@code !!str} or the verbatim {@code !<tag:yaml.org,2002:str>} spelling. */
+    static final Pattern EXPLICIT_TAG = Pattern.compile("(!!|!<tag:yaml\\.org,2002:)(int|float|binary|bool|timestamp|str|null|seq|map|set|omap|pairs)\\b");
+
+    /** Whether a mapping anywhere in the canonical form has a sequence, mapping or set as a key (PyYAML cannot hash those). */
+    static boolean hasCollectionKey(JsonElement e) {
+        if (e instanceof JsonArray a) {
+            for (JsonElement x : a) {
+                if (hasCollectionKey(x)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+        if (e instanceof JsonObject o) {
+            if (o.has("$set")) {
+                return hasCollectionKey(o.get("$set"));
+            }
+            if (o.has("$m")) {
+                for (JsonElement pair : o.getAsJsonArray("$m")) {
+                    JsonElement k = pair.getAsJsonArray().get(0);
+                    if (k instanceof JsonArray || (k instanceof JsonObject ko && (ko.has("$m") || ko.has("$set")))) {
+                        return true;
+                    }
+                    if (hasCollectionKey(k) || hasCollectionKey(pair.getAsJsonArray().get(1))) {
+                        return true;
+                    }
+                }
+            }
+        }
+        return false;
+    }
+
+    static String knownDifference(String text) {
+        if (Pattern.compile("(^|[\\s\\[{,:?-])!\\s").matcher(text).find()) {
+            return "the non-specific tag ! (snakeyaml/2)"; // `! 123` is an int here, a string in the spec; `! ` null vs ""
+        }
+        if (Pattern.compile("(^|\\n)---[^\\s]").matcher(text).find()) {
+            return "a line starting with ---x (snakeyaml/1)";
+        }
+        // a `%` at the start of a line is a directive wherever a new token may start (also right after a document's root node)
+        if (Pattern.compile("(^|\\n)(%[^\\n]*\\n)*%(?!YAML |TAG )").matcher(text).find()) {
+            return "an unknown directive (ignored here and by pure PyYAML, rejected by libyaml)";
+        }
+        if (Pattern.compile("(^|\\n)(%[^\\n]*\\n)+(?!---)").matcher(text).find()) {
+            // snakeyaml/18: directives with no document after them (`%YAML 1.1` and then the end of the
+            // stream) are accepted here as an empty stream; the spec wants an explicit document, PyYAML and libyaml
+            // report "expected '<document start>'"
+            return "directives without a document after them (silently accepted here as an empty stream, an error in PyYAML)";
+        }
+        if (Pattern.compile("(^|[^\\w.])[-+]?[0-9][0-9_]*[eE][-+]?[0-9]+(?![\\w.])").matcher(text).find()) {
+            return "an exponent without a dot (SnakeYAML reads 1e3 as a float, YAML 1.1 as a string)";
+        }
+        if (Pattern.compile("\\.[0-9_]*[eE][0-9]").matcher(text).find()) {
+            return "an exponent without a sign (SnakeYAML reads 1.0E10 and .5e3 as floats, YAML 1.1 as strings; snakeyaml/7 on the dump side)";
+        }
+        if (Pattern.compile("[\\[,]\\s*\\?\\s*[\\],]").matcher(text).find()) {
+            return "an empty explicit key as a flow sequence entry (`[?]` is a single-pair mapping here and in pure PyYAML, an error in libyaml)";
+        }
+        if (Pattern.compile("[\\[{][\\s\\S]*[^\\s\\[{,?:]\\s*\\?").matcher(text).find()) {
+            // `[a, b?]`, `[[], n?ull]`, `[\nn?ull]` and `{a: null ?}` alike: SnakeYAML ends the plain scalar at the `?` (a ParserException follows)
+            return "a question mark inside a flow-context plain scalar (snakeyaml/15)";
+        }
+        if (Pattern.compile("[|>][^\\s]*#").matcher(text).find()) {
+            return "a comment glued to a block scalar header (rejected here and by pure PyYAML, accepted by libyaml)";
+        }
+        if (Doc.hasSurrogate(text)) {
+            return "a lone surrogate (rejected here, passed through by PyYAML)";
+        }
+        if (EXPLICIT_TAG.matcher(text).find()) {
+            return "an explicit tag (snakeyaml/10, /11, /13: null for !!bool, NumberFormatException, ClassCastException on the wrong node kind)";
+        }
+        if (Pattern.compile("[^\\[{,]:[\\[\\]{},]").matcher(text).find()) {
+            return "a colon directly before a flow indicator (`[a:]` is a single-pair mapping here as in YAML 1.2, an error in PyYAML; `{b :[]}` and `{a :, b}` are read here and by pure PyYAML, rejected by libyaml)";
+        }
+        if (Pattern.compile("(^|[\\s\\[{,])[&*][\\w-]*[^\\w\\s\\[\\]{},-]").matcher(text).find()) {
+            return "an anchor or alias name with a character outside [A-Za-z0-9_-] (any non-space, non-flow-indicator character is allowed here as in YAML 1.2, an error in PyYAML)";
+        }
+        if (text.indexOf('\ufeff') > 0) {
+            return "a byte order mark inside the stream";
+        }
+        if (Pattern.compile("[-:?] *\\t").matcher(text).find()) {
+            return "a tab as separation after an indicator (rejected here and by pure PyYAML, accepted by libyaml)";
+        }
+        if (Pattern.compile("\\\\\\t").matcher(text).find()) {
+            // snakeyaml/20: a backslash followed by a real tab inside a double-quoted scalar is the
+            // escape for a tab in YAML 1.1 and 1.2 (`\` followed by #x9), read by PyYAML and libyaml; ScannerImpl's
+            // ESCAPE_REPLACEMENTS has `\t` and `\ ` but not the tab itself, so it is "found unknown escape character (9)"
+            return "a backslash-tab escape (a tab in YAML and PyYAML, an unknown escape here)";
+        }
+        if (Pattern.compile("[\\[{,][^\\n\\]}]*\\t +").matcher(text).find()) {
+            // snakeyaml/19: `[\t ]` is a ScannerException ("found character ' ' that cannot start any
+            // token") while `[ \t]`, `[\t]` and `[a\tb]` are read: ScannerImpl.scanToNextToken skips spaces, then tabs
+            // in flow context, but never spaces after the tabs; libyaml reads all of them
+            return "a tab followed by a space inside a flow collection (rejected here, read by libyaml)";
+        }
+        if (Pattern.compile("[|>][^\\n]*\\n *\\t").matcher(text).find()) {
+            return "a tab right after the indentation of a block scalar's first line (content here and in pure PyYAML, rejected by libyaml)";
+        }
+        if (Pattern.compile("(^|[\\r\\n])\\t").matcher(text).find()) {
+            return "a line beginning with a tab (rejected here and by pure PyYAML, skipped by libyaml while continuing a plain scalar)";
+        }
+        if (Pattern.compile("\\t[ \\t]*(#|\\r|\\n|$)").matcher(text).find()) {
+            return "a tab as trailing white space or before a comment (after a quoted scalar or flow collection in block context it is rejected here and by pure PyYAML, accepted by libyaml)";
+        }
+        if (Pattern.compile("(^|[^\\w.])[-+]\\.[0-9_]|(^|[^\\w.])\\._").matcher(text).find()) {
+            return "a signed or underscored leading-dot float (PyYAML reads +.5 as a string)";
+        }
+        if (Pattern.compile("(^|[^\\w.])[-+]?0[xb]?_+(?![\\w])").matcher(text).find()) {
+            return "an underscores-only radix literal (0_ is 0 in PyYAML, a string here)";
+        }
+        if (Pattern.compile("[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}").matcher(text).find()) {
+            return "a timestamp (out-of-range fields, the Julian calendar and fraction rounding differ)";
+        }
+        if (Pattern.compile("(^|[^\\w.:])[-+]?[0-9][0-9_]*(:[0-5]?[0-9]){2,}(\\.[0-9_]*)?(?![\\w.:])").matcher(text).find()) {
+            return "a sexagesimal number with three or more groups (snakeyaml/5 overflow)";
+        }
+        if (Pattern.compile("(^|\\n)( *)\\? [^\\n]*\\n\\2[|>]").matcher(text).find()) {
+            return "a block scalar at the mapping's indentation after an explicit key without a value (taken as the key's value here, rejected by PyYAML; snakeyaml/22)";
+        }
+        return null;
+    }
+
+    /** An edit of the text; positions are taken modulo the live size when applied. */
+    sealed interface Edit permits Delete, Insert, Replace, Reindent, Swap {}
+
+    record Delete(int at) implements Edit {}
+
+    record Insert(int at, String what) implements Edit {}
+
+    record Replace(int at, String what) implements Edit {}
+
+    /** Re-indent one line to {@code spaces} spaces. */
+    record Reindent(int line, int spaces) implements Edit {}
+
+    /** Swap a line with the next. */
+    record Swap(int line) implements Edit {}
+
+    static final Generator<Integer> POSITION = ints(0, 4095);
+
+    /** An edit: a deletion (20%), an insertion (40%) or replacement (20%) of a mutation string, a re-indented line (10%), two swapped lines (10%). */
+    static final Generator<Edit> EDIT = weighted(
+        w(20, POSITION.map(Delete::new)),
+        w(40, tuples(POSITION, sampledFrom(MUTATION_CHARS)).map(t -> new Insert(t.value1(), t.value2()))),
+        w(20, tuples(POSITION, sampledFrom(MUTATION_CHARS)).map(t -> new Replace(t.value1(), t.value2()))),
+        w(10, tuples(POSITION, ints(0, 6)).map(t -> new Reindent(t.value1(), t.value2()))),
+        w(10, POSITION.map(Swap::new)));
+
+    static final Generator<List<Edit>> EDITS = lists(EDIT).minSize(1).maxSize(3);
+
+    /** The text after the edits, applied in turn while there is text left; a position is taken modulo the size of what it edits. */
+    static String mutate(String text, List<Edit> edits) {
+        StringBuilder sb = new StringBuilder(text);
+        for (Edit e : edits) {
+            if (sb.length() == 0) {
+                break;
+            }
+            switch (e) {
+                case Delete d -> {
+                    int at = d.at() % (sb.length() + 1);
+                    if (at < sb.length()) {
+                        sb.deleteCharAt(at);
+                    }
+                }
+                case Insert i -> sb.insert(i.at() % (sb.length() + 1), i.what());
+                case Replace r -> {
+                    int at = r.at() % (sb.length() + 1);
+                    if (at < sb.length()) {
+                        sb.replace(at, at + 1, r.what());
+                    }
+                }
+                case Reindent r -> {
+                    List<String> lines = new ArrayList<>(Arrays.asList(sb.toString().split("\n", -1)));
+                    int li = r.line() % lines.size();
+                    lines.set(li, " ".repeat(r.spaces()) + lines.get(li).replaceFirst("^ +", ""));
+                    sb = new StringBuilder(String.join("\n", lines));
+                }
+                case Swap s -> {
+                    List<String> lines = new ArrayList<>(Arrays.asList(sb.toString().split("\n", -1)));
+                    if (lines.size() >= 2) {
+                        int li = s.line() % (lines.size() - 1);
+                        String a = lines.get(li);
+                        lines.set(li, lines.get(li + 1));
+                        lines.set(li + 1, a);
+                        sb = new StringBuilder(String.join("\n", lines));
+                    }
+                }
+            }
+        }
+        return sb.toString();
+    }
+
+    record MutationCase(Doc.Stream stream, List<Edit> edits) {}
+
+    static final Generator<MutationCase> MUTATION_CASE = tuples(YamlGen.STREAM, EDITS).map(t -> new MutationCase(t.value1(), t.value2()));
+
+    @Test
+    void mutatedDocumentsLoadLikePyYAML() {
+        Oracle oracle = Oracle.get();
+        Hegel.test(tc -> {
+            MutationCase c = tc.draw(MUTATION_CASE, "case");
+            String text = mutate(c.stream().render(), c.edits());
+            String tag = describe(text);
+            Loaded mine = loadAll(safeYaml(), text);
+            Oracle.Loaded theirs = oracle.load(text);
+            String known = knownDifference(text);
+            if (known != null) {
+                // still: no unexpected exception types below
+            } else if (!theirs.ok() && (String.valueOf(theirs.error).contains("unhashable")
+                    || (String.valueOf(theirs.error).contains("while constructing a mapping") && mine.ok() && hasCollectionKey(mine.canon())))) {
+                // PyYAML cannot build a dict with a list or dict key; SnakeYAML can - the oracle's limitation (the
+                // oracle passes on the first line of the error, "while constructing a mapping", not the "unhashable" one)
+            } else if (mine.ok() && theirs.ok()) {
+                check(Oracle.same(mine.canon(), theirs.docs), () -> "SnakeYAML loads " + mine + " but PyYAML " + theirs + " for " + tag);
+            } else if (mine.ok() != theirs.ok()) {
+                check(false, () -> "SnakeYAML: " + mine + "; PyYAML: " + theirs + " for " + tag);
+            }
+            // whatever happens, the exception is a YAMLException (or a documented IllegalArgument on limits)
+            if (!mine.ok() && !EXPLICIT_TAG.matcher(text).find()) {
+                check(mine.error instanceof YAMLException, () -> "SnakeYAML threw " + mine.error.getClass().getName() + ": " + firstLine(mine.error.getMessage()) + " for " + tag);
+            }
+        }, Zoo.settings("mutatedDocumentsLoadLikePyYAML"));
+    }
+
+    // ---- 3. plain scalars resolve alike -------------------------------------------------------
+
+    static final String[] BOOL_WORDS = {"y", "Y", "yes", "Yes", "YES", "n", "N", "no", "No", "NO", "true", "True", "TRUE", "false", "False", "FALSE", "on", "On", "ON", "off", "Off", "OFF"};
+    static final String[] NULL_WORDS = {"~", "null", "Null", "NULL", ""};
+    static final String[] SPECIAL_FLOATS = {".inf", ".Inf", ".INF", "+.inf", "-.inf", "-.Inf", "-.INF", ".nan", ".NaN", ".NAN"};
+    static final String[] ODD_SCALARS = {"0o17", "0o", "0x", "0b", "0b102", "08", "09", "1_", "_1", "1__0", "1._5", ".", "+", "-", "1:60", "1:5", "190:20:30", "-1:30", "1:30.5", "1:30.", "0:0", "12e3", "1E3", "1.e3", "1e+3", ".5e3", "5.e", "1e", "0.", "-0", "+0", "-0.0", "0x_1", "0b_1", "0o_7", "0_7", "07_7", "1,000", "1.2.3", "2001-12-14", "2001-12-14t21:59:43.10-05:00", "2001-12-14 21:59:43.10 -5", "2001-12-15T02:59:43.1Z", "2001-12-14 21:59:43", "2001-12-14 21:59:43.123456789", "2001-12-14 21:59:43 +5:30", "2001-12-14   21:59:43", "2001-1-1", "2001-01-01 1:2:3", "0001-01-01", "9999-12-31T23:59:59Z", "2001-02-30", "2001-13-01", "2001-12-14 24:00:00", "2001-12-14T21:59:43.10+14:00", "2001-12-14T21:59:43-00:00", "=", "<<", "!", "yes ", " yes", "Yes!", "y3", "no1", "nul", "TRUE.", "1 000", "1.0.", "\u0661\u0662\u0663", "1e309", "-1e309", "1e-400", "4.9e-324", "0.1e1", "3.", "3.e2"};
+
+    static final String WORDISH = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.";
+    static final String DIGITISH = "0123456789abcdefxo_.:-+eE";
+
+    /** The digits with an underscore at the drawn position (null: none), or as they are when too short for one. */
+    static String underscore(String digits, Integer at) {
+        if (at == null || digits.length() < 2) {
+            return digits;
+        }
+        int i = 1 + at % (digits.length() - 1);
+        return digits.substring(0, i) + "_" + digits.substring(i);
+    }
+
+    static final Generator<String> SIGN = sampledFrom("", "-", "+");
+
+    /** A decimal integer of up to nine digits, a thousand million times larger 30% of the time, underscored 30% of the time, signed half the time. */
+    static final Generator<String> DECIMAL = tuples(ints(0, 999_999_999), chance(30), maybe(30, (Integer) null, ints(0, 99)), sampledFrom("", "", "-", "+"))
+        .map(t -> t.value4() + underscore(Long.toString(t.value1() * (t.value2() ? 1_000_000_000L : 1L)), t.value3()));
+
+    /** A hexadecimal, binary or octal literal (or a leading-zero decimal) with an underscore in it. */
+    static final Generator<String> RADIX = tuples(SIGN, sampledFrom("0x", "0X", "0b", "0", "0o"), sampledFrom("1f", "7", "101", "0", "ff_ff", "17", "9", "a"), ints(0, 99))
+        .map(t -> t.value1() + t.value2() + underscore(t.value3(), t.value4()));
+
+    /** A sexagesimal number of two (60%) or three groups, with a fraction 30% of the time. */
+    static final Generator<String> SEXAGESIMAL = tuples(SIGN, ints(0, 99), sampledFrom("0", "5", "30", "59", "60", "05"),
+            maybe(40, "", sampledFrom("0", "30", "59", "5").map(x -> ":" + x)), maybe(30, "", ints(0, 99).map(x -> "." + x)))
+        .map(t -> t.value1() + t.value2() + ":" + t.value3() + t.value4() + t.value5());
+
+    /** A float: a sign, an integer part (80%), a dot, a fraction (85%), an exponent (40%), an underscore somewhere (20%). */
+    static final Generator<String> FLOAT_TEXT = tuples(SIGN, maybe(80, "", ints(0, 999).map(String::valueOf)), maybe(85, "", ints(0, 9999).map(String::valueOf)),
+            maybe(40, "", tuples(sampledFrom("e", "E"), SIGN, ints(0, 400)).map(e -> e.value1() + e.value2() + e.value3())), maybe(20, (Integer) null, ints(0, 99)))
+        .map(t -> underscore(t.value1() + t.value2() + "." + t.value3() + t.value4(), t.value5()));
+
+    /** The time part of a timestamp: a separator, hours, minutes and seconds one past their range, a fraction (50%), a zone (60%). */
+    static final Generator<String> TIME = tuples(sampledFrom("T", "t", " ", "  "), ints(0, 24), ints(0, 60), ints(0, 60),
+            maybe(50, "", sampledFrom("1", "12", "123", "1234567", "000").map(f -> "." + f)),
+            maybe(60, "", sampledFrom("Z", " Z", "+5", "-5", " -5", "+05:30", "-05:30", " +00:00", "+14", "-0", "+5:3")))
+        .map(t -> t.value1() + t.value2() + ":" + t.value3() + ":" + t.value4() + t.value5() + t.value6());
+
+    /** A timestamp: a year 1..9999, a month and a day (some out of range), a time 60% of the time. */
+    static final Generator<String> TIMESTAMP = tuples(ints(1, 9999), sampledFrom("1", "01", "12", "6", "00", "13"), sampledFrom("1", "01", "31", "30", "9", "00", "32"), maybe(60, "", TIME))
+        .map(t -> t.value1() + "-" + t.value2() + "-" + t.value3() + t.value4());
+
+    /** The pool strings that fit a plain scalar. */
+    static final List<String> PLAIN_POOL = Arrays.stream(Doc.STRING_POOL)
+        .filter(s -> !s.isEmpty() && !Doc.hasAny(s, "\n\r\t") && !Doc.hasControl(s) && Doc.PLAIN_BAN_FIRST.indexOf(s.charAt(0)) < 0 && !s.contains(": ") && !s.contains(" #") && !s.endsWith(":") && !s.endsWith(" ") && !s.startsWith("---") && !s.startsWith("...") && s.length() < 100)
+        .toList();
+
+    /** A plain scalar: the YAML 1.1 words, odd spellings, ints in every base, sexagesimals, floats, timestamps, word-ish strings, pool strings. */
+    static final Generator<String> PLAIN_SCALAR = weighted(
+        w(1, sampledFrom(BOOL_WORDS)),
+        w(1, sampledFrom(NULL_WORDS)),
+        w(1, sampledFrom(SPECIAL_FLOATS)),
+        w(2, sampledFrom(ODD_SCALARS)),
+        w(1, DECIMAL),
+        w(1, RADIX),
+        w(1, SEXAGESIMAL),
+        w(1, FLOAT_TEXT),
+        w(1, TIMESTAMP),
+        w(1, word(WORDISH, 1, 8)),
+        w(1, word(DIGITISH, 1, 8)),
+        w(2, sampledFrom(PLAIN_POOL)));
+
+    /** Where the scalar stands: alone, after a marker, as a mapping value, a sequence item, in a flow sequence, in a flow mapping (the shapes differ in the scanner). */
+    enum Frame {
+        DOC, MARKED, VALUE, ITEM, FLOW_SEQ, FLOW_MAP;
+
+        String text(String s) {
+            return switch (this) {
+                case DOC -> s + "\n";
+                case MARKED -> "--- " + s + "\n";
+                case VALUE -> "k: " + s + "\n";
+                case ITEM -> "- " + s + "\n";
+                case FLOW_SEQ -> "[" + s + "]\n";
+                case FLOW_MAP -> "{k: " + s + "}\n";
+            };
+        }
+
+        /** Whether the scalar stands whole in the frame (no flow indicator of the frame inside it). */
+        boolean fits(String s) {
+            return switch (this) {
+                case FLOW_SEQ -> !Doc.hasAny(s, ",[]");
+                case FLOW_MAP -> !Doc.hasAny(s, ",{}:");
+                default -> true;
+            };
+        }
+    }
+
+    record ScalarCase(String s, Frame frame) {
+        String text() {
+            return frame.text(s);
+        }
+    }
+
+    /** An indicator rather than a plain scalar (`=` alone is !!value, `<<` !!merge). */
+    static boolean indicator(String s) {
+        return s.startsWith("-") && (s.length() == 1 || s.charAt(1) == ' ') || s.startsWith("?") || s.startsWith(":") || s.startsWith("!") || s.startsWith("%")
+            || s.startsWith("@") || s.startsWith("`") || s.equals("=") || s.equals("<<");
+    }
+
+    static final Generator<ScalarCase> SCALAR_CASE = PLAIN_SCALAR
+        .filter(s -> !s.isEmpty() && !s.startsWith("#") && !indicator(s))
+        .flatMap(s -> sampledFrom(Arrays.stream(Frame.values()).filter(f -> f.fits(s)).toList()).map(f -> new ScalarCase(s, f)));
+
+    @Test
+    void plainScalarsResolveLikePyYAML() {
+        Oracle oracle = Oracle.get();
+        Hegel.test(tc -> {
+            ScalarCase c = tc.draw(SCALAR_CASE, "case");
+            String s = c.s();
+            String text = c.text();
+            String tag = "scalar \"" + s + "\" in " + describe(text);
+            Loaded mine = loadAll(safeYaml(), text);
+            Oracle.Loaded theirs = oracle.load(text);
+            if (knownDifference(s) != null || knownDifference(text) != null) {
+                // a recorded difference; the base loader check below still applies
+            } else if (mine.ok() && theirs.ok()) {
+                check(Oracle.same(mine.canon(), theirs.docs), () -> "SnakeYAML loads " + mine + " but PyYAML " + theirs + " for " + tag);
+            } else if (mine.ok() != theirs.ok()) {
+                check(false, () -> "SnakeYAML: " + mine + "; PyYAML: " + theirs + " for " + tag);
+            }
+            // the base loader gives the raw string
+            Oracle.Loaded base = oracle.load(text, "base");
+            if (base.ok() && !text.startsWith("[") && !text.startsWith("{") && !s.endsWith(":") && !s.contains(": ") && !s.contains(" #")) {
+                JsonElement doc = base.docs.get(0);
+                JsonElement rawEl = text.startsWith("k: ") ? doc.getAsJsonObject().getAsJsonArray("$m").get(0).getAsJsonArray().get(1)
+                        : text.startsWith("- ") ? doc.getAsJsonArray().get(0) : doc;
+                if (rawEl.isJsonPrimitive()) {
+                    String raw = rawEl.getAsString();
+                    check(raw.equals(s.trim()) || raw.equals(s), () -> "the base loader gives \"" + raw + "\" for " + tag);
+                }
+            }
+        }, Zoo.settings("plainScalarsResolveLikePyYAML"));
+    }
+}
