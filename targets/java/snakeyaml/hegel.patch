+++ b/hegel/pom.xml
@@ -0,0 +1,74 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel zoo: property-based tests for SnakeYAML against the library built from this checkout
+     (`mvn -DskipTests install` at the root first; see targets/java/snakeyaml in the zoo). The tests hold a
+     python3 child with PyYAML open as the oracle (hegel-yaml-oracle.py); Gson carries the JSON between them. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>snakeyaml-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <snakeyaml.version>2.8-SNAPSHOT</snakeyaml.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.yaml</groupId>
+      <artifactId>snakeyaml</artifactId>
+      <version>${snakeyaml.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>com.google.code.gson</groupId>
+      <artifactId>gson</artifactId>
+      <version>2.13.1</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g</argLine>
+          <trimStackTrace>false</trimStackTrace>
+          <!-- every test's `ZOO …` line is what the zoo judges; Maven's exit code is not -->
+          <testFailureIgnore>true</testFailureIgnore>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Doc.java b/hegel/src/test/java/zoo/Doc.java
new file mode 100644
index 0000000..54cab4e
--- /dev/null
+++ b/hegel/src/test/java/zoo/Doc.java
@@ -0,0 +1,788 @@
+package zoo;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonNull;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonPrimitive;
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import org.yaml.snakeyaml.nodes.NodeId;
+import org.yaml.snakeyaml.nodes.Tag;
+import org.yaml.snakeyaml.resolver.Resolver;
+
+/**
+ * The tree a generated YAML stream is rendered from ({@link YamlGen} draws it): every node carries its value and
+ * the spelling it is written in (quoting, block scalar form, flow layout, how it sits under its parent), so that
+ * {@link Stream#render()} is a pure function of the tree and a failing case is a small record in the draw report.
+ * Ported from the zoo's js-yaml and go-yaml harnesses: block and flow collections at odd indentation, plain /
+ * single-quoted / double-quoted / literal / folded scalars, explicit keys, comments, document markers - staying
+ * inside what YAML 1.1 readers (SnakeYAML, PyYAML) must read back as the same tree. SnakeYAML's own
+ * {@code Resolver} decides when a string must be quoted.
+ */
+final class Doc {
+    private Doc() {}
+
+    // ---------------------------------------------------------------- styles
+
+    /** How a non-empty collection is laid out under a block-style parent: on the lines below, inline in flow style, or (in a sequence) compact after the dash. */
+    enum Nest { BLOCK, FLOW, COMPACT }
+
+    /**
+     * How a node sits under its block-style parent (unused at the root): a comment line before it and an explicit
+     * {@code ? } key (mapping values only), a null written as nothing after the dash or colon, the nesting of a
+     * collection with its indentation step (0: a sequence flush with its key), spaces before an inline scalar, a
+     * comment after the line ("" for none), and a blank line after the node.
+     */
+    record Place(boolean commentBefore, boolean explicitKey, boolean bareNull, Nest nest, int step, int sp, String comment, boolean blankAfter) {}
+
+    /** The quoting of a string; a spelling the string does not fit falls through to the next (plain to single, single to double). */
+    enum Quote { PLAIN, SINGLE, DOUBLE }
+
+    enum BlockKind { NONE, LITERAL, FOLDED }
+
+    /**
+     * A string's block scalar form in block context (NONE: inline; a form the string does not fit falls through to
+     * the other, then inline), its indentation step, whether the indentation indicator is written and comes before
+     * the chomping indicator, a comment after the header, and dice 0..99 taken in turn: an empty line of a literal
+     * is written as its indentation from 50, a folded line breaks at a space from 60.
+     */
+    record BlockStyle(BlockKind kind, int step, boolean indicator, boolean indicatorFirst, boolean comment, List<Integer> dice) {}
+
+    /** The spaces inside a flow collection: after the opening and before the closing bracket, around the commas and colons, a trailing comma. */
+    record Flow(int open, int close, int beforeComma, String afterComma, boolean trailingComma, int beforeColon, int afterColon) {}
+
+    // ---------------------------------------------------------------- nodes
+
+    /** A node of the tree: its value, and how it is written. */
+    sealed interface Node permits Null, Bool, Int, Flt, Str, Seq, Mapping {
+        Place place();
+
+        /** The canonical form (Oracle's) of the value a YAML 1.1 reader gives for this node. */
+        JsonElement canon();
+
+        default boolean isColl() {
+            return false;
+        }
+
+        default int size() {
+            return 0;
+        }
+    }
+
+    /** A null; {@code variant} picks the spelling. */
+    record Null(int variant, Place place) implements Node {
+        @Override
+        public JsonElement canon() {
+            return JsonNull.INSTANCE;
+        }
+    }
+
+    record Bool(boolean value, int variant, Place place) implements Node {
+        @Override
+        public JsonElement canon() {
+            return new JsonPrimitive(value);
+        }
+    }
+
+    /** An integer; {@code variant} picks decimal (0..6), hexadecimal (7, 8) or a leading plus (9). */
+    record Int(long value, int variant, Place place) implements Node {
+        @Override
+        public JsonElement canon() {
+            return Oracle.integer(value);
+        }
+    }
+
+    /** A double; {@code variant} picks the spelling, {@code dropZero} writes .5 for 0.5, {@code plus} a leading plus. */
+    record Flt(double value, int variant, boolean dropZero, boolean plus, Place place) implements Node {
+        @Override
+        public JsonElement canon() {
+            return Oracle.floating(value);
+        }
+    }
+
+    /** A string with its quoting, the dice 0..99 of its double-quoted escapes (taken per character), and its block scalar form. */
+    record Str(String value, Quote quote, List<Integer> dq, BlockStyle block, Place place) implements Node {
+        @Override
+        public JsonElement canon() {
+            return new JsonPrimitive(value);
+        }
+    }
+
+    record Seq(List<Node> items, Flow flow, Place place) implements Node {
+        @Override
+        public boolean isColl() {
+            return true;
+        }
+
+        @Override
+        public int size() {
+            return items.size();
+        }
+
+        @Override
+        public JsonElement canon() {
+            JsonArray a = new JsonArray();
+            for (Node t : items) {
+                a.add(t.canon());
+            }
+            return a;
+        }
+    }
+
+    /** A mapping key with its quoting. */
+    record Key(String text, Quote quote, List<Integer> dq) {}
+
+    record Entry(Key key, Node value) {}
+
+    record Mapping(List<Entry> entries, Flow flow, Place place) implements Node {
+        @Override
+        public boolean isColl() {
+            return true;
+        }
+
+        @Override
+        public int size() {
+            return entries.size();
+        }
+
+        @Override
+        public JsonElement canon() {
+            JsonArray pairs = new JsonArray();
+            for (Entry e : entries) {
+                JsonArray pair = new JsonArray();
+                pair.add(new JsonPrimitive(e.key().text()));
+                pair.add(e.value().canon());
+                pairs.add(pair);
+            }
+            JsonObject o = new JsonObject();
+            o.add("$m", pairs);
+            return o;
+        }
+    }
+
+    /**
+     * A document's framing: a leading comment line, a blank first line, the {@code ---} marker (forced on every
+     * document but the first) and the comment after it, the root collection's indentation, a non-empty root
+     * collection in flow style, the {@code ...} end marker, a trailing comment line.
+     */
+    record DocStyle(boolean leadingComment, boolean blankFirst, boolean marker, String markerComment, int rootIndent, boolean flowRoot, boolean endMarker, boolean trailingComment) {}
+
+    record Document(Node root, DocStyle style) {
+        /**
+         * Whether the document's text ends inside a block scalar that keeps its trailing line breaks, so that a
+         * blank line before the next document's {@code ---} would join that scalar's content.
+         */
+        boolean endsOpen() {
+            if (style.endMarker() || style.trailingComment()) {
+                return false;
+            }
+            if (root.isColl()) {
+                return root.size() > 0 && !style.flowRoot() && endsKeep(root, style.rootIndent());
+            }
+            return root instanceof Str s && isKeep(blockScalar(s, 0, true));
+        }
+
+        /**
+         * The document as text; a block scalar at the root is written without an indentation indicator. After a
+         * document that {@link #endsOpen() ends open} the leading blank line is left out.
+         */
+        String render(boolean forceMarker, boolean afterOpen) {
+            StringBuilder out = new StringBuilder();
+            if (style.leadingComment()) {
+                out.append("# leading comment\n");
+            }
+            if (style.blankFirst() && !afterOpen) {
+                out.append("\n");
+            }
+            boolean marker = forceMarker || style.marker();
+            if (root.isColl() && root.size() > 0 && !style.flowRoot()) {
+                if (marker) {
+                    out.append("---").append(style.markerComment()).append("\n");
+                }
+                out.append(String.join("\n", blockLines(root, style.rootIndent()))).append("\n");
+            } else if (root.isColl()) {
+                if (marker) {
+                    out.append("--- ");
+                }
+                out.append(flow(root)).append("\n");
+            } else {
+                List<String> block = root instanceof Str s ? blockScalar(s, 0, true) : null;
+                if (marker) {
+                    out.append("--- ");
+                }
+                out.append(block != null ? String.join("\n", block) : scalar(root, false)).append("\n");
+            }
+            if (style.endMarker()) {
+                out.append("...\n");
+            }
+            if (style.trailingComment()) {
+                out.append("# trailing comment\n");
+            }
+            return out.toString();
+        }
+    }
+
+    /** A stream of documents, later documents always marked with {@code ---}. */
+    record Stream(List<Document> docs) {
+        String render() {
+            StringBuilder out = new StringBuilder();
+            for (int i = 0; i < docs.size(); i++) {
+                out.append(docs.get(i).render(i > 0, i > 0 && docs.get(i - 1).endsOpen()));
+            }
+            return out.toString();
+        }
+
+        JsonArray canon() {
+            JsonArray a = new JsonArray();
+            for (Document d : docs) {
+                a.add(d.root().canon());
+            }
+            return a;
+        }
+    }
+
+    // ---------------------------------------------------------------- tables
+
+    static final String[] STRING_POOL = {
+        "", " ", "a", "x y", "a: b", "a:b", "- x", "? x", "# c", "x #y", "x#y", ": x", "key:", "yes", "no", "on", "off", "y", "n",
+        "true", "false", "null", "~", "Null", "1", "-1", "+1", "0", "00", "017", "0x1f", "0o17", "0b11", "1_000", "1.5", ".5", "5.", "1e3",
+        "1.0e+3", ".inf", "-.inf", ".nan", "1:30", "12:30:45", "2001-12-14", "2001-12-14t21:59:43.10-05:00", "2001-12-14 21:59:43.10 -5",
+        "<<", "=", "---", "...", "--- x", "... x", "-", "?", ":", ",", "[", "]", "{", "}", "&a", "*a", "!x", "|", ">", "%x", "@x", "`x",
+        "'q'", "\"q\"", "\\", "a\\b", "a\nb", "a\n\nb", "a\n", "\na", "a\n\n", "  a", "a  ", "a\tb", "\t", "\u00e9", "\u4e00", "\ud83d\ude00",
+        "\u0085", "\u00a0", "\u2028", "\ufeff", "\u0000", "\u001b", "\u007f", "a\rb", "0.5.2", "1__0", "1.e3", "-.5", "+.5", "._5",
+        "a b c d e f g", "line one\nline two\nline three", "trailing space \nnext", "x".repeat(200), "w ".repeat(50).trim(),
+    };
+
+    static final String[] COMMENTS = {" # c", " #", "  # comment: with [flow] and 'quotes'", " # \u65e5\u672c"};
+
+    static final String[] NULLS = {"null", "null", "Null", "NULL", "~"};
+    static final String[] TRUES = {"true", "true", "True", "TRUE"};
+    static final String[] FALSES = {"false", "false", "False", "FALSE"};
+    static final String[] ZEROS = {"0", "0", "+0", "0x0"};
+    static final String[] INFINITIES = {".inf", ".Inf", ".INF", "+.inf"};
+    static final String[] NEGATIVE_INFINITIES = {"-.inf", "-.Inf", "-.INF"};
+    static final String[] NANS = {".nan", ".NaN", ".NAN"};
+    static final String[] NEGATIVE_ZEROS = {"-0.0", "-0.0e+0"};
+
+    static final Resolver RESOLVER = new Resolver();
+    static final String PLAIN_BAN_FIRST = "-?:,[]{}#&*!|>'\"%@` \t";
+
+    static <T> T pick(T[] xs, int variant) {
+        return xs[variant % xs.length];
+    }
+
+    // ---------------------------------------------------------------- scalars
+
+    static boolean isControl(int c) {
+        return c <= 0x08 || c == 0x0b || c == 0x0c || (c >= 0x0e && c <= 0x1f) || c == 0x7f || c == 0x85 || c == 0x2028 || c == 0x2029 || c == 0xfeff;
+    }
+
+    static boolean hasControl(String s) {
+        return s.codePoints().anyMatch(Doc::isControl);
+    }
+
+    static boolean hasSurrogate(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
+                    i++;
+                    continue;
+                }
+                return true;
+            }
+            if (Character.isLowSurrogate(c)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean hasAny(String s, String chars) {
+        for (int i = 0; i < s.length(); i++) {
+            if (chars.indexOf(s.charAt(i)) >= 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * A string may be plain when the syntax leaves it whole and the 1.1 resolver (SnakeYAML's own,
+     * checked by the oracle) gives a string back. Not: empty, multi-line, tabs, leading/trailing space.
+     */
+    static boolean plainSafe(String s, boolean flow) {
+        if (s.isEmpty() || hasAny(s, "\n\r\t") || hasControl(s) || hasSurrogate(s)) {
+            return false;
+        }
+        if (PLAIN_BAN_FIRST.indexOf(s.charAt(0)) >= 0) {
+            return false;
+        }
+        if (s.contains(": ") || s.contains(" #") || s.endsWith(":") || s.endsWith(" ")) {
+            return false;
+        }
+        if (s.startsWith("---") || s.startsWith("...")) {
+            return false;
+        }
+        if (s.equals("=") || s.equals("<<")) {
+            return false; // !!value and !!merge
+        }
+        if (flow && hasAny(s, ",[]{}:?")) {
+            return false;
+        }
+        if (s.length() > 1000) {
+            return false;
+        }
+        return RESOLVER.resolve(NodeId.scalar, s, true).equals(Tag.STR);
+    }
+
+    static boolean singleOK(String s) {
+        return !hasAny(s, "\n\r\t") && !hasControl(s) && !hasSurrogate(s) && s.length() <= 1000;
+    }
+
+    /**
+     * The string double-quoted; the dice pick between the escapes of a character: {@code \x0a} for a newline from
+     * 80, {@code \x09} for a tab from 70, {@code \xa0} for a no-break space from 50, an escaped space from 90, a
+     * backslash-u (or backslash-U) escape for a non-ASCII character from 70.
+     */
+    static String doubleQuoted(String s, List<Integer> dice) {
+        StringBuilder out = new StringBuilder("\"");
+        int i = 0;
+        int k = 0;
+        while (i < s.length()) {
+            int c = s.codePointAt(i);
+            i += Character.charCount(c);
+            int d = dice.get(k++ % dice.size());
+            if (c == '"') {
+                out.append("\\\"");
+            } else if (c == '\\') {
+                out.append("\\\\");
+            } else if (c == '\n') {
+                out.append(d >= 80 ? "\\x0a" : "\\n");
+            } else if (c == '\r') {
+                out.append("\\r");
+            } else if (c == '\t') {
+                out.append(d >= 70 ? "\\x09" : "\\t");
+            } else if (c == 0x85) {
+                out.append("\\N");
+            } else if (c == 0xa0) {
+                out.append(d >= 50 ? "\\xa0" : "\\_");
+            } else if (c == 0x2028) {
+                out.append("\\L");
+            } else if (c == 0x2029) {
+                out.append("\\P");
+            } else if (c == 0xfeff) {
+                out.append("\\ufeff");
+            } else if (c < 0x20 || c == 0x7f) {
+                out.append(String.format("\\x%02x", c));
+            } else if (c >= 0xd800 && c <= 0xdfff) {
+                out.append(String.format("\\u%04x", c));
+            } else if (c == ' ' && d >= 90) {
+                out.append("\\ ");
+            } else if (c > 0x7f && d >= 70) {
+                out.append(c < 0x10000 ? String.format("\\u%04x", c) : String.format("\\U%08x", c));
+            } else {
+                out.appendCodePoint(c);
+            }
+        }
+        return out.append('"').toString();
+    }
+
+    static String single(String s) {
+        return "'" + s.replace("'", "''") + "'";
+    }
+
+    /** The string in the quoting it fits: a plain spelling falls through to single quotes, single to double. */
+    static String quoted(String s, Quote quote, List<Integer> dq, boolean flow) {
+        if (quote == Quote.PLAIN && plainSafe(s, flow)) {
+            return s;
+        }
+        if (quote != Quote.DOUBLE && singleOK(s)) {
+            return single(s);
+        }
+        return doubleQuoted(s, dq);
+    }
+
+    static String integer(long v, int variant) {
+        if (v == 0) {
+            return pick(ZEROS, variant);
+        }
+        if (v < 0) {
+            return Long.toString(v);
+        }
+        return switch (variant % 10) {
+            case 7 -> "0x" + Long.toHexString(v);
+            case 8 -> "0x" + Long.toHexString(v).toUpperCase();
+            case 9 -> "+" + v;
+            default -> Long.toString(v);
+        };
+    }
+
+    static String floating(double f, int variant, boolean dropZero, boolean plus) {
+        if (f == Double.POSITIVE_INFINITY) {
+            return pick(INFINITIES, variant);
+        }
+        if (f == Double.NEGATIVE_INFINITY) {
+            return pick(NEGATIVE_INFINITIES, variant);
+        }
+        if (Double.isNaN(f)) {
+            return pick(NANS, variant);
+        }
+        if (f == 0 && 1 / f < 0) {
+            return pick(NEGATIVE_ZEROS, variant);
+        }
+        String plain = Double.toString(f); // 1.5, 1.0E21, 1.0E-7
+        String s = switch (variant % 4) {
+            case 1 -> plain;
+            case 2 -> Math.abs(f) < 1e17 && Math.abs(f) >= 1e-6 ? new BigDecimal(f).toPlainString() : plain.toLowerCase();
+            default -> plain.toLowerCase();
+        };
+        // both readers want a dot and YAML 1.1 wants the exponent signed
+        s = s.replaceFirst("^([-+]?\\d+)([eE])", "$1.0$2");
+        s = s.replaceFirst("([eE])(\\d)", "$1+$2");
+        if (!s.contains(".")) {
+            s += ".0";
+        }
+        if (s.startsWith("0.") && dropZero) {
+            s = s.substring(1);
+        }
+        if (Character.isDigit(s.charAt(0)) && plus) {
+            s = "+" + s;
+        }
+        return s;
+    }
+
+    /** A scalar node inline (in flow context: quoted where flow indicators would end it). */
+    static String scalar(Node n, boolean flow) {
+        return switch (n) {
+            case Null x -> pick(NULLS, x.variant());
+            case Bool x -> x.value() ? pick(TRUES, x.variant()) : pick(FALSES, x.variant());
+            case Int x -> integer(x.value(), x.variant());
+            case Flt x -> floating(x.value(), x.variant(), x.dropZero(), x.plus());
+            case Str x -> quoted(x.value(), x.quote(), x.dq(), flow);
+            default -> throw new IllegalArgumentException("not a scalar: " + n);
+        };
+    }
+
+    static String key(Key k, boolean flow) {
+        return quoted(k.text(), k.quote(), k.dq(), flow);
+    }
+
+    // ---------------------------------------------------------------- block scalars
+
+    static List<String> splitLines(String s) {
+        return new ArrayList<>(Arrays.asList(s.split("\n", -1)));
+    }
+
+    /**
+     * A literal block can hold s when it is multi-line, free of CR/tab/controls, not all whitespace,
+     * no line ends in a space and the first non-empty line does not start with one.
+     */
+    static boolean literalOK(String s) {
+        if (!s.contains("\n") || hasAny(s, "\r\t") || hasControl(s) || s.trim().isEmpty() || hasSurrogate(s)) {
+            return false;
+        }
+        String first = null;
+        for (String l : splitLines(s)) {
+            if (!l.isEmpty() && l.trim().isEmpty()) {
+                return false;
+            }
+            if (l.endsWith(" ")) {
+                return false;
+            }
+            if (first == null && !l.isEmpty()) {
+                first = l;
+            }
+        }
+        return first != null && !first.startsWith(" ");
+    }
+
+    /** A folded block can hold s when no line is empty or starts/ends with a space or holds two. */
+    static boolean foldedOK(String s) {
+        if (!literalOK(s) && !(!s.isEmpty() && !s.contains("\n") && s.contains(" "))) {
+            return false;
+        }
+        if (hasAny(s, "\r\t") || hasControl(s) || hasSurrogate(s)) {
+            return false;
+        }
+        for (String l : splitLines(s.replaceAll("\n+$", ""))) {
+            if (l.isEmpty() || l.startsWith(" ") || l.endsWith(" ") || l.contains("  ")) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    /** The string without its trailing line breaks, their number, and the chomping indicator that restores them. */
+    record Chomp(String trimmed, int trailing, String chomp) {
+        static Chomp of(String s) {
+            String trimmed = s.replaceAll("\n+$", "");
+            int trailing = s.length() - trimmed.length();
+            return new Chomp(trimmed, trailing, trailing == 0 ? "-" : trailing == 1 ? "" : "+");
+        }
+    }
+
+    static int die(BlockStyle st, int k) {
+        return st.dice().get(k % st.dice().size());
+    }
+
+    static String header(String kind, String chomp, String ind, BlockStyle st) {
+        String h = kind + (st.indicatorFirst() ? ind + chomp : chomp + ind);
+        return st.comment() ? h + " # comment" : h;
+    }
+
+    /** Lines of a literal block for s, content indented by {@code indent} spaces; {@code indicator} is the indentation indicator to write (0: none). */
+    static List<String> literal(String s, int indent, int indicator, BlockStyle st) {
+        Chomp c = Chomp.of(s);
+        String ind = indicator > 0 && !c.chomp().equals("+") ? Integer.toString(indicator) : "";
+        List<String> out = new ArrayList<>();
+        out.add(header("|", c.chomp(), ind, st));
+        String pad = " ".repeat(indent);
+        int k = 0;
+        for (String l : splitLines(c.trimmed())) {
+            out.add(l.isEmpty() ? (die(st, k++) >= 50 ? pad : "") : pad + l);
+        }
+        for (int i = 1; i < c.trailing(); i++) {
+            out.add("");
+        }
+        return out;
+    }
+
+    /** Lines of a folded block for s: single spaces may become line breaks, a newline an empty line. */
+    static List<String> folded(String s, int indent, int indicator, BlockStyle st) {
+        Chomp c = Chomp.of(s);
+        String ind = indicator > 0 && !c.chomp().equals("+") ? Integer.toString(indicator) : "";
+        List<String> out = new ArrayList<>();
+        out.add(header(">", c.chomp(), ind, st));
+        String pad = " ".repeat(indent);
+        List<String> srcLines = splitLines(c.trimmed());
+        int k = 0;
+        for (int i = 0; i < srcLines.size(); i++) {
+            if (i > 0) {
+                out.add("");
+            }
+            String[] words = srcLines.get(i).split(" ", -1);
+            String cur = words[0];
+            for (int w = 1; w < words.length; w++) {
+                if (die(st, k++) >= 60) {
+                    out.add(pad + cur);
+                    cur = words[w];
+                } else {
+                    cur += " " + words[w];
+                }
+            }
+            out.add(pad + cur);
+        }
+        for (int i = 1; i < c.trailing(); i++) {
+            out.add("");
+        }
+        return out;
+    }
+
+    /**
+     * The lines of a block scalar for the string, or null when it is written inline; {@code indent} is the
+     * parent's column, {@code top} the document root (no indentation indicator there).
+     */
+    static List<String> blockScalar(Str x, int indent, boolean top) {
+        BlockStyle st = x.block();
+        String s = x.value();
+        BlockKind kind = st.kind();
+        if (kind == BlockKind.LITERAL && !literalOK(s)) {
+            kind = foldedOK(s) ? BlockKind.FOLDED : BlockKind.NONE;
+        }
+        if (kind == BlockKind.FOLDED && !foldedOK(s)) {
+            kind = literalOK(s) ? BlockKind.LITERAL : BlockKind.NONE;
+        }
+        if (kind == BlockKind.NONE) {
+            return null;
+        }
+        int indicator = st.indicator() && !top ? st.step() : 0;
+        return kind == BlockKind.LITERAL ? literal(s, indent + st.step(), indicator, st) : folded(s, indent + st.step(), indicator, st);
+    }
+
+    /** Whether the block scalar keeps its trailing line breaks (an empty line after it would join its content). */
+    static boolean isKeep(List<String> block) {
+        return block != null && block.get(0).matches("^[|>][0-9]?\\+.*|^[|>]\\+.*");
+    }
+
+    /**
+     * Whether the block rendering of {@code t} at {@code indent} (as {@link #blockLines} lays it out) ends inside a
+     * block scalar that keeps its trailing line breaks, so that a blank line after the whole of it would join that
+     * scalar's content.
+     */
+    static boolean endsKeep(Node t, int indent) {
+        return switch (t) {
+            case Str s -> isKeep(blockScalar(s, indent, false));
+            case Mapping m when !m.entries().isEmpty() -> {
+                Entry e = m.entries().get(m.entries().size() - 1);
+                Node kid = e.value();
+                Place p = kid.place();
+                boolean explicit = p.explicitKey() && !e.key().text().contains("\n");
+                if (kid instanceof Str) {
+                    yield endsKeep(kid, indent);
+                }
+                if (kid.isColl() && kid.size() > 0 && p.nest() != Nest.FLOW) {
+                    int step = p.step() == 0 && kid instanceof Seq && !explicit ? 0 : Math.max(1, p.step());
+                    yield endsKeep(kid, indent + step);
+                }
+                yield false;
+            }
+            case Seq q when !q.items().isEmpty() -> {
+                Node it = q.items().get(q.items().size() - 1);
+                Place p = it.place();
+                if (it instanceof Str) {
+                    yield endsKeep(it, indent);
+                }
+                if (it.isColl() && it.size() > 0 && p.nest() == Nest.COMPACT) {
+                    yield endsKeep(it, indent + 2);
+                }
+                if (it.isColl() && it.size() > 0 && p.nest() == Nest.BLOCK) {
+                    yield endsKeep(it, indent + Math.max(1, p.step()));
+                }
+                yield false;
+            }
+            default -> false;
+        };
+    }
+
+    // ---------------------------------------------------------------- collections
+
+    static String sp(int n) {
+        return " ".repeat(n);
+    }
+
+    static String ascii(String s) {
+        StringBuilder sb = new StringBuilder();
+        for (char c : s.toCharArray()) {
+            if (c >= 0x20 && c <= 0x7e) {
+                sb.append(c);
+            }
+        }
+        return sb.length() > 20 ? sb.substring(0, 20) : sb.toString();
+    }
+
+    /** A node in flow style. */
+    static String flow(Node t) {
+        return switch (t) {
+            case Seq q -> {
+                Flow f = q.flow();
+                if (q.items().isEmpty()) {
+                    yield "[" + sp(f.open()) + "]";
+                }
+                String sep = sp(f.beforeComma()) + "," + f.afterComma();
+                StringBuilder s = new StringBuilder("[").append(sp(f.open()));
+                for (int i = 0; i < q.items().size(); i++) {
+                    if (i > 0) {
+                        s.append(sep);
+                    }
+                    s.append(flow(q.items().get(i)));
+                }
+                if (f.trailingComma()) {
+                    s.append(sp(f.beforeComma())).append(",");
+                }
+                yield s.append(sp(f.close())).append("]").toString();
+            }
+            case Mapping m -> {
+                Flow f = m.flow();
+                if (m.entries().isEmpty()) {
+                    yield "{" + sp(f.open()) + "}";
+                }
+                String sep = sp(f.beforeComma()) + "," + f.afterComma();
+                StringBuilder s = new StringBuilder("{").append(sp(f.open()));
+                for (int i = 0; i < m.entries().size(); i++) {
+                    if (i > 0) {
+                        s.append(sep);
+                    }
+                    Entry e = m.entries().get(i);
+                    s.append(key(e.key(), true)).append(sp(f.beforeColon())).append(": ").append(sp(f.afterColon())).append(flow(e.value()));
+                }
+                if (f.trailingComma()) {
+                    s.append(sp(f.beforeComma())).append(",");
+                }
+                yield s.append(sp(f.close())).append("}").toString();
+            }
+            default -> scalar(t, true);
+        };
+    }
+
+    /** Lines of a collection in block style, every line indented by {@code indent} spaces; a scalar is one line. */
+    static List<String> blockLines(Node t, int indent) {
+        String pad = " ".repeat(indent);
+        List<String> lines = new ArrayList<>();
+        switch (t) {
+            case Mapping m -> {
+                for (Entry e : m.entries()) {
+                    Node kid = e.value();
+                    Place p = kid.place();
+                    boolean keep = false;
+                    if (p.commentBefore()) {
+                        lines.add(pad + "# before " + ascii(e.key().text()));
+                    }
+                    String head = pad + key(e.key(), false) + ":";
+                    boolean explicit = p.explicitKey() && !e.key().text().contains("\n");
+                    if (explicit) {
+                        lines.add(pad + "? " + key(e.key(), false));
+                        head = pad + ":";
+                    }
+                    List<String> block = kid instanceof Str s ? blockScalar(s, indent, false) : null;
+                    if (kid instanceof Null && p.bareNull()) {
+                        lines.add(head + p.comment());
+                    } else if (block != null) {
+                        lines.add(head + " " + block.get(0));
+                        lines.addAll(block.subList(1, block.size()));
+                        keep = isKeep(block);
+                    } else if (kid.isColl() && kid.size() > 0 && p.nest() != Nest.FLOW) {
+                        // a sequence may sit flush with its key (step 0), any other child steps in
+                        int step = p.step() == 0 && kid instanceof Seq && !explicit ? 0 : Math.max(1, p.step());
+                        lines.add(head + p.comment());
+                        lines.addAll(blockLines(kid, indent + step));
+                        keep = endsKeep(kid, indent + step);
+                    } else if (kid.isColl()) {
+                        lines.add(head + " " + flow(kid) + p.comment());
+                    } else {
+                        lines.add(head + " " + sp(p.sp()) + scalar(kid, false) + p.comment());
+                    }
+                    if (p.blankAfter() && !keep) {
+                        lines.add("");
+                    }
+                }
+            }
+            case Seq q -> {
+                for (Node it : q.items()) {
+                    Place p = it.place();
+                    boolean keep = false;
+                    List<String> block = it instanceof Str s ? blockScalar(s, indent, false) : null;
+                    if (it.isColl() && it.size() > 0 && p.nest() == Nest.COMPACT) {
+                        // compact: "- k: v" / "- - a", the rest aligned under the first entry
+                        List<String> sub = blockLines(it, indent + 2);
+                        sub.set(0, pad + "- " + sub.get(0).substring(indent + 2));
+                        lines.addAll(sub);
+                        keep = endsKeep(it, indent + 2);
+                    } else if (it.isColl() && it.size() > 0 && p.nest() == Nest.BLOCK) {
+                        lines.add(pad + "-" + p.comment());
+                        lines.addAll(blockLines(it, indent + Math.max(1, p.step())));
+                        keep = endsKeep(it, indent + Math.max(1, p.step()));
+                    } else if (block != null) {
+                        lines.add(pad + "- " + block.get(0));
+                        lines.addAll(block.subList(1, block.size()));
+                        keep = isKeep(block);
+                    } else if (it.isColl()) {
+                        lines.add(pad + "- " + flow(it) + p.comment());
+                    } else if (it instanceof Null && p.bareNull()) {
+                        lines.add(pad + "-");
+                    } else {
+                        lines.add(pad + "- " + sp(p.sp()) + scalar(it, false) + p.comment());
+                    }
+                    if (p.blankAfter() && !keep) {
+                        lines.add("");
+                    }
+                }
+            }
+            default -> lines.add(pad + scalar(t, false));
+        }
+        return lines;
+    }
+}
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..05c963d
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,88 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The combinators the binding lacks: weighted choice, a biased coin, an optional with a probability, an int range,
+ * and text over an alphabet ({@code TextGenerator} takes code point ranges, not an alphabet).
+ */
+final class Gen {
+    private Gen() {}
+
+    /** A weighted alternative for {@link #weighted}; the generator may produce a subtype of the choice's type. */
+    record Choice<T>(int weight, Generator<? extends T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<? extends T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    static <T> Generator<T> weighted(List<Choice<T>> choices) {
+        List<Choice<T>> cs = List.copyOf(choices);
+        int total = 0;
+        for (Choice<T> c : cs) {
+            total += c.weight();
+        }
+        return ints(0, total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : cs) {
+                acc += c.weight();
+                if (i < acc) {
+                    return widen(c.gen());
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** A generator of a subtype is a generator of the supertype: it only ever produces values. */
+    @SuppressWarnings("unchecked")
+    static <T> Generator<T> widen(Generator<? extends T> g) {
+        return (Generator<T>) g;
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return ints(0, 99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<? extends T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** One character of the alphabet (by UTF-16 unit). */
+    static Generator<String> chars(String alphabet) {
+        List<String> cs = new ArrayList<>();
+        for (int i = 0; i < alphabet.length(); i++) {
+            cs.add(String.valueOf(alphabet.charAt(i)));
+        }
+        return sampledFrom(cs);
+    }
+
+    /** A string of lo..hi characters of the alphabet; shrinks to lo characters. */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        return lists(chars(alphabet)).minSize(lo).maxSize(hi).map(Gen::join);
+    }
+
+    static String join(List<String> parts) {
+        return String.join("", parts);
+    }
+}
diff --git a/hegel/src/test/java/zoo/Oracle.java b/hegel/src/test/java/zoo/Oracle.java
new file mode 100644
index 0000000..3597132
--- /dev/null
+++ b/hegel/src/test/java/zoo/Oracle.java
@@ -0,0 +1,293 @@
+package zoo;
+
+import com.google.gson.Gson;
+import com.google.gson.GsonBuilder;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonNull;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonPrimitive;
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.time.ZoneOffset;
+import java.time.format.DateTimeFormatter;
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * PyYAML (libyaml when available) held open in a python3 child, one JSON request per line on its
+ * stdin, one JSON answer per line on its stdout. Values cross in the canonical form described in
+ * hegel-yaml-oracle.py; {@link #canon(Object)} produces it from what SnakeYAML constructs and
+ * {@link #same(JsonElement, JsonElement)} compares two forms with mappings and sets unordered.
+ */
+final class Oracle {
+
+    static final Gson GSON = new GsonBuilder().disableHtmlEscaping().serializeNulls().create();
+    private static Oracle instance;
+
+    final String pyyaml;
+    final boolean libyaml;
+    private final Process process;
+    private final BufferedWriter in;
+    private final BufferedReader out;
+
+    private Oracle() throws IOException {
+        Path script = Files.createTempFile("hegel-yaml-oracle", ".py");
+        try (InputStream src = Oracle.class.getResourceAsStream("/hegel-yaml-oracle.py")) {
+            if (src == null) {
+                throw new IllegalStateException("hegel-yaml-oracle.py is not on the class path");
+            }
+            Files.copy(src, script, java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+        }
+        script.toFile().deleteOnExit();
+        process = new ProcessBuilder("python3", script.toString()).redirectError(ProcessBuilder.Redirect.INHERIT).start();
+        in = new BufferedWriter(new OutputStreamWriter(process.getOutputStream(), StandardCharsets.UTF_8));
+        out = new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8));
+        JsonObject ping = new JsonObject();
+        ping.addProperty("op", "ping");
+        JsonObject answer = call(ping);
+        pyyaml = answer.get("pyyaml").getAsString();
+        libyaml = answer.get("libyaml").getAsBoolean();
+        Runtime.getRuntime().addShutdownHook(new Thread(process::destroy));
+    }
+
+    static synchronized Oracle get() {
+        if (instance == null) {
+            try {
+                instance = new Oracle();
+            } catch (IOException ex) {
+                throw new IllegalStateException("cannot start the PyYAML oracle: " + ex, ex);
+            }
+        }
+        return instance;
+    }
+
+    private synchronized JsonObject call(JsonObject req) {
+        try {
+            in.write(GSON.toJson(req));
+            in.write('\n');
+            in.flush();
+            String line = out.readLine();
+            if (line == null) {
+                throw new IllegalStateException("the PyYAML oracle died (exit " + (process.isAlive() ? "?" : process.exitValue()) + ")");
+            }
+            return JsonParser.parseString(line).getAsJsonObject();
+        } catch (IOException ex) {
+            throw new IllegalStateException("talking to the PyYAML oracle: " + ex, ex);
+        }
+    }
+
+    /** The outcome of a load: either the documents or the first line of the error. */
+    static final class Loaded {
+        final JsonArray docs;
+        final String error;
+
+        Loaded(JsonArray docs, String error) {
+            this.docs = docs;
+            this.error = error;
+        }
+
+        boolean ok() {
+            return error == null;
+        }
+
+        @Override
+        public String toString() {
+            return ok() ? GSON.toJson(docs) : "error " + error;
+        }
+    }
+
+    /** All documents of {@code text} through the given loader: "safe" (libyaml), "base" or "pysafe" (pure Python). */
+    Loaded load(String text, String loader) {
+        JsonObject req = new JsonObject();
+        req.addProperty("op", "load");
+        req.addProperty("text", text);
+        req.addProperty("loader", loader);
+        JsonObject answer = call(req);
+        if (answer.get("ok").getAsBoolean()) {
+            return new Loaded(answer.getAsJsonArray("docs"), null);
+        }
+        return new Loaded(null, answer.get("error").getAsString());
+    }
+
+    Loaded load(String text) {
+        return load(text, "safe");
+    }
+
+    /** PyYAML's dump of a canonical value, or null with the error in {@code error[0]}. */
+    String dump(JsonElement value, JsonObject options, String[] error) {
+        JsonObject req = new JsonObject();
+        req.addProperty("op", "dump");
+        req.add("value", value);
+        req.add("options", options);
+        JsonObject answer = call(req);
+        if (answer.get("ok").getAsBoolean()) {
+            return answer.get("text").getAsString();
+        }
+        error[0] = answer.get("error").getAsString();
+        return null;
+    }
+
+    // ---------------------------------------------------------------- canonical form
+
+    private static final DateTimeFormatter ISO_MS = DateTimeFormatter.ofPattern("uuuu-MM-dd'T'HH:mm:ss.SSS").withZone(ZoneOffset.UTC);
+
+    static JsonElement canon(Object v) {
+        if (v == null) {
+            return JsonNull.INSTANCE;
+        }
+        if (v instanceof Boolean) {
+            return new JsonPrimitive((Boolean) v);
+        }
+        if (v instanceof String) {
+            return new JsonPrimitive((String) v);
+        }
+        if (v instanceof Integer || v instanceof Long || v instanceof BigInteger || v instanceof Short || v instanceof Byte) {
+            return tagged("$n", v.toString());
+        }
+        if (v instanceof Double || v instanceof Float) {
+            return tagged("$f", floatBits(((Number) v).doubleValue()));
+        }
+        if (v instanceof BigDecimal) {
+            return tagged("$f", floatBits(((BigDecimal) v).doubleValue()));
+        }
+        if (v instanceof Date) {
+            return tagged("$t", ISO_MS.format(Instant.ofEpochMilli(((Date) v).getTime())));
+        }
+        if (v instanceof byte[]) {
+            return tagged("$b", Base64.getEncoder().encodeToString((byte[]) v));
+        }
+        if (v instanceof Set) {
+            JsonArray members = new JsonArray();
+            for (Object x : (Set<?>) v) {
+                members.add(canon(x));
+            }
+            JsonObject o = new JsonObject();
+            o.add("$set", members);
+            return o;
+        }
+        if (v instanceof Map) {
+            JsonArray pairs = new JsonArray();
+            for (Map.Entry<?, ?> e : ((Map<?, ?>) v).entrySet()) {
+                JsonArray pair = new JsonArray();
+                pair.add(canon(e.getKey()));
+                pair.add(canon(e.getValue()));
+                pairs.add(pair);
+            }
+            JsonObject o = new JsonObject();
+            o.add("$m", pairs);
+            return o;
+        }
+        if (v instanceof List) {
+            JsonArray items = new JsonArray();
+            for (Object x : (List<?>) v) {
+                items.add(canon(x));
+            }
+            return items;
+        }
+        if (v instanceof Object[]) {
+            return canon(Arrays.asList((Object[]) v));
+        }
+        return tagged("$other", v.getClass().getName() + " " + v);
+    }
+
+    static JsonElement tagged(String tag, String text) {
+        JsonObject o = new JsonObject();
+        o.addProperty(tag, text);
+        return o;
+    }
+
+    static String floatBits(double d) {
+        if (Double.isNaN(d)) {
+            return "nan";
+        }
+        return String.format("%016x", Double.doubleToRawLongBits(d));
+    }
+
+    static JsonElement integer(long v) {
+        return tagged("$n", Long.toString(v));
+    }
+
+    static JsonElement floating(double d) {
+        return tagged("$f", floatBits(d));
+    }
+
+    /** Structural equality with `$m` pairs and `$set` members in any order (keys compared by their JSON text). */
+    static boolean same(JsonElement a, JsonElement b) {
+        if (a == null || b == null) {
+            return a == b;
+        }
+        if (a.isJsonArray() && b.isJsonArray()) {
+            JsonArray x = a.getAsJsonArray(), y = b.getAsJsonArray();
+            if (x.size() != y.size()) {
+                return false;
+            }
+            for (int i = 0; i < x.size(); i++) {
+                if (!same(x.get(i), y.get(i))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a.isJsonObject() && b.isJsonObject()) {
+            JsonObject x = a.getAsJsonObject(), y = b.getAsJsonObject();
+            if (x.has("$m") && y.has("$m")) {
+                Map<String, JsonElement> mx = pairs(x.getAsJsonArray("$m")), my = pairs(y.getAsJsonArray("$m"));
+                if (mx == null || my == null || mx.size() != my.size()) {
+                    return false;
+                }
+                for (Map.Entry<String, JsonElement> e : mx.entrySet()) {
+                    if (!my.containsKey(e.getKey()) || !same(e.getValue(), my.get(e.getKey()))) {
+                        return false;
+                    }
+                }
+                return true;
+            }
+            if (x.has("$set") && y.has("$set")) {
+                Set<String> sx = new HashSet<>(), sy = new HashSet<>();
+                for (JsonElement m : x.getAsJsonArray("$set")) {
+                    sx.add(GSON.toJson(m));
+                }
+                for (JsonElement m : y.getAsJsonArray("$set")) {
+                    sy.add(GSON.toJson(m));
+                }
+                return sx.equals(sy);
+            }
+            return x.equals(y);
+        }
+        return a.equals(b);
+    }
+
+    private static Map<String, JsonElement> pairs(JsonArray array) {
+        Map<String, JsonElement> m = new HashMap<>();
+        for (JsonElement p : array) {
+            JsonArray pair = p.getAsJsonArray();
+            if (m.put(GSON.toJson(pair.get(0)), pair.get(1)) != null) {
+                return null; // a duplicate key: never equal to anything
+            }
+        }
+        return m;
+    }
+
+    static String show(JsonElement e) {
+        String s = GSON.toJson(e);
+        return s.length() > 600 ? s.substring(0, 600) + "…" : s;
+    }
+}
