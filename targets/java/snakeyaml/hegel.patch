+    }
+
+    // ---- 3. plain scalars resolve alike -------------------------------------------------------
+
+    static final String[] BOOL_WORDS = {"y", "Y", "yes", "Yes", "YES", "n", "N", "no", "No", "NO", "true", "True", "TRUE", "false", "False", "FALSE", "on", "On", "ON", "off", "Off", "OFF"};
+    static final String[] NULL_WORDS = {"~", "null", "Null", "NULL", ""};
+    static final String[] SPECIAL_FLOATS = {".inf", ".Inf", ".INF", "+.inf", "-.inf", "-.Inf", "-.INF", ".nan", ".NaN", ".NAN"};
+    static final String[] ODD_SCALARS = {"0o17", "0o", "0x", "0b", "0b102", "08", "09", "1_", "_1", "1__0", "1._5", ".", "+", "-", "1:60", "1:5", "190:20:30", "-1:30", "1:30.5", "1:30.", "0:0", "12e3", "1E3", "1.e3", "1e+3", ".5e3", "5.e", "1e", "0.", "-0", "+0", "-0.0", "0x_1", "0b_1", "0o_7", "0_7", "07_7", "1,000", "1.2.3", "2001-12-14", "2001-12-14t21:59:43.10-05:00", "2001-12-14 21:59:43.10 -5", "2001-12-15T02:59:43.1Z", "2001-12-14 21:59:43", "2001-12-14 21:59:43.123456789", "2001-12-14 21:59:43 +5:30", "2001-12-14   21:59:43", "2001-1-1", "2001-01-01 1:2:3", "0001-01-01", "9999-12-31T23:59:59Z", "2001-02-30", "2001-13-01", "2001-12-14 24:00:00", "2001-12-14T21:59:43.10+14:00", "2001-12-14T21:59:43-00:00", "=", "<<", "!", "yes ", " yes", "Yes!", "y3", "no1", "nul", "TRUE.", "1 000", "1.0.", "١٢٣", "1e309", "-1e309", "1e-400", "4.9e-324", "0.1e1", "3.", "3.e2"};
+
+    String plainScalar(TestCase tc) {
+        int r = n(tc, 1, 14);
+        switch (r) {
+            case 1:
+                return pick(tc, BOOL_WORDS);
+            case 2:
+                return pick(tc, NULL_WORDS);
+            case 3:
+                return pick(tc, SPECIAL_FLOATS);
+            case 4:
+            case 5:
+                return pick(tc, ODD_SCALARS);
+            case 6: { // decimal int with optional sign and underscores
+                String d = Long.toString(Math.abs((long) n(tc, 0, 999999999) * (chance(tc, 30) ? 1000000000L : 1)));
+                if (chance(tc, 30)) {
+                    d = underscore(tc, d);
+                }
+                return pick(tc, "", "", "-", "+") + d;
+            }
+            case 7: // other bases
+                return pick(tc, "", "-", "+") + pick(tc, "0x", "0X", "0b", "0", "0o") + underscore(tc, pick(tc, "1f", "7", "101", "0", "ff_ff", "17", "9", "a"));
+            case 8: // sexagesimal
+                return pick(tc, "", "-", "+") + n(tc, 0, 99) + ":" + pick(tc, "0", "5", "30", "59", "60", "05") + (chance(tc, 40) ? ":" + pick(tc, "0", "30", "59", "5") : "") + (chance(tc, 30) ? "." + n(tc, 0, 99) : "");
+            case 9: { // float
+                String f = pick(tc, "", "-", "+") + (chance(tc, 80) ? Integer.toString(n(tc, 0, 999)) : "") + "." + (chance(tc, 85) ? Integer.toString(n(tc, 0, 9999)) : "");
+                if (chance(tc, 40)) {
+                    f += pick(tc, "e", "E") + pick(tc, "", "+", "-") + n(tc, 0, 400);
+                }
+                return chance(tc, 20) ? underscore(tc, f) : f;
+            }
+            case 10: // timestamp
+                return n(tc, 1, 9999) + "-" + pick(tc, "1", "01", "12", "6", "00", "13") + "-" + pick(tc, "1", "01", "31", "30", "9", "00", "32")
+                        + (chance(tc, 60) ? pick(tc, "T", "t", " ", "  ") + n(tc, 0, 24) + ":" + n(tc, 0, 60) + ":" + n(tc, 0, 60) + (chance(tc, 50) ? "." + pick(tc, "1", "12", "123", "1234567", "000") : "") + (chance(tc, 60) ? pick(tc, "Z", " Z", "+5", "-5", " -5", "+05:30", "-05:30", " +00:00", "+14", "-0", "+5:3") : "") : "");
+            case 11: // a word-ish string
+                return Zoo.word(tc, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.", 1, 8);
+            case 12: // digits and letters
+                return Zoo.word(tc, "0123456789abcdefxo_.:-+eE", 1, 8);
+            default: // a string from the pool that fits a plain scalar
+                for (int i = 0; i < 10; i++) {
+                    String s = pick(tc, YamlGen.STRING_POOL);
+                    if (!s.isEmpty() && !YamlGen.hasAny(s, "\n\r\t") && !YamlGen.hasControl(s) && YamlGen.PLAIN_BAN_FIRST.indexOf(s.charAt(0)) < 0 && !s.contains(": ") && !s.contains(" #") && !s.endsWith(":") && !s.endsWith(" ") && !s.startsWith("---") && !s.startsWith("...") && s.length() < 100) {
+                        return s;
+                    }
+                }
+                return "plain";
+        }
+    }
+
+    static String underscore(TestCase tc, String digits) {
+        if (digits.length() < 2) {
+            return digits;
+        }
+        int at = n(tc, 1, digits.length() - 1);
+        return digits.substring(0, at) + "_" + digits.substring(at);
+    }
+
+    @Test
+    void plainScalarsResolveLikePyYAML() {
+        Oracle oracle = Oracle.get();
+        Hegel.test(tc -> {
+            String s = plainScalar(tc);
+            if (s.startsWith("-") && (s.length() == 1 || s.charAt(1) == ' ') || s.startsWith("?") || s.startsWith(":") || s.startsWith("!") || s.startsWith("%") || s.startsWith("@") || s.startsWith("`") || s.startsWith("=") && s.length() == 1) {
+                return; // an indicator, not a plain scalar (`=` alone is !!value)
+            }
+            if (s.equals("<<")) {
+                return; // !!merge as a value
+            }
+            // as a document, as a mapping value and as a sequence item (the shapes differ in the scanner)
+            String[] texts = {s + "\n", "--- " + s + "\n", "k: " + s + "\n", "- " + s + "\n", "[" + s + "]\n", "{k: " + s + "}\n"};
+            for (String text : texts) {
+                if (text.startsWith("[") && (s.contains(",") || s.contains("]") || s.contains("["))) {
+                    continue;
+                }
+                if (text.startsWith("{") && (s.contains(",") || s.contains("}") || s.contains("{") || s.contains(":"))) {
+                    continue;
+                }
+                if (s.startsWith("#") || s.isEmpty()) {
+                    continue;
+                }
+                String tag = "scalar \"" + s + "\" in " + describe(text);
+                Loaded mine = loadAll(safeYaml(), text);
+                Oracle.Loaded theirs = oracle.load(text);
+                if (knownDifference(s) != null || knownDifference(text) != null) {
+                    // a recorded difference; the base loader check below still applies
+                } else if (mine.ok() && theirs.ok()) {
+                    check(Oracle.same(mine.canon(), theirs.docs), () -> "SnakeYAML loads " + mine + " but PyYAML " + theirs + " for " + tag);
+                } else if (mine.ok() != theirs.ok()) {
+                    check(false, () -> "SnakeYAML: " + mine + "; PyYAML: " + theirs + " for " + tag);
+                }
+                // the base loader gives the raw string
+                Oracle.Loaded base = oracle.load(text, "base");
+                if (base.ok() && !text.startsWith("[") && !text.startsWith("{") && !s.endsWith(":") && !s.contains(": ") && !s.contains(" #")) {
+                    JsonElement doc = base.docs.get(0);
+                    JsonElement rawEl = text.startsWith("k: ") ? doc.getAsJsonObject().getAsJsonArray("$m").get(0).getAsJsonArray().get(1)
+                            : text.startsWith("- ") ? doc.getAsJsonArray().get(0) : doc;
+                    if (rawEl.isJsonPrimitive()) {
+                        String raw = rawEl.getAsString();
+                        check(raw.equals(s.trim()) || raw.equals(s), () -> "the base loader gives \"" + raw + "\" for " + tag);
+                    }
+                }
+            }
+        }, Zoo.settings("plainScalarsResolveLikePyYAML"));
+    }
