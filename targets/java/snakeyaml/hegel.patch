+    String integer(long v) {
+        if (v == 0) {
+            return pick(tc, "0", "0", "+0", "0x0");
+        }
+        if (v < 0) {
+            return Long.toString(v);
+        }
+        int r = n(tc, 1, 10);
+        if (r == 1) {
+            return "0x" + Long.toHexString(v);
+        }
+        if (r == 2) {
+            return "0x" + Long.toHexString(v).toUpperCase();
+        }
+        if (r == 3) {
+            return "+" + v;
+        }
+        return Long.toString(v);
+    }
+
+    String floating(double f) {
+        if (f == Double.POSITIVE_INFINITY) {
+            return pick(tc, ".inf", ".Inf", ".INF", "+.inf");
+        }
+        if (f == Double.NEGATIVE_INFINITY) {
+            return pick(tc, "-.inf", "-.Inf", "-.INF");
+        }
+        if (Double.isNaN(f)) {
+            return pick(tc, ".nan", ".NaN", ".NAN");
+        }
+        if (f == 0 && 1 / f < 0) {
+            return pick(tc, "-0.0", "-0.0e+0");
+        }
+        String s;
+        int r = n(tc, 1, 4);
+        String plain = Double.toString(f); // 1.5, 1.0E21, 1.0E-7
+        if (r == 1) {
+            s = plain.toLowerCase();
+        } else if (r == 2) {
+            s = plain;
+        } else if (r == 3 && Math.abs(f) < 1e17 && Math.abs(f) >= 1e-6) {
+            s = new java.math.BigDecimal(f).toPlainString();
+        } else {
+            s = plain.toLowerCase();
+        }
+        // both readers want a dot and YAML 1.1 wants the exponent signed
+        s = s.replaceFirst("^([-+]?\\d+)([eE])", "$1.0$2");
+        s = s.replaceFirst("([eE])(\\d)", "$1+$2");
+        if (!s.contains(".")) {
+            s += ".0";
+        }
+        if (s.startsWith("0.") && chance(tc, 20)) {
+            s = s.substring(1);
+        }
+        if (Character.isDigit(s.charAt(0)) && chance(tc, 15)) {
+            s = "+" + s;
+        }
+        return s;
+    }
