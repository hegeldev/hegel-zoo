+            return false;
+        }
+        if (PLAIN_BAN_FIRST.indexOf(s.charAt(0)) >= 0) {
+            return false;
+        }
+        if (s.contains(": ") || s.contains(" #") || s.endsWith(":") || s.endsWith(" ")) {
+            return false;
+        }
+        if (s.startsWith("---") || s.startsWith("...")) {
+            return false;
+        }
+        if (s.equals("=") || s.equals("<<")) {
