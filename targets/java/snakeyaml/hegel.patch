+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel zoo: property-based tests for SnakeYAML against the library built from this checkout
+     (`mvn -DskipTests install` at the root first; see targets/java/snakeyaml in the zoo). The tests hold a
+     python3 child with PyYAML open as the oracle (hegel-yaml-oracle.py); Gson carries the JSON between them. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>snakeyaml-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <snakeyaml.version>2.8-SNAPSHOT</snakeyaml.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.yaml</groupId>
+      <artifactId>snakeyaml</artifactId>
+      <version>${snakeyaml.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>com.google.code.gson</groupId>
+      <artifactId>gson</artifactId>
+      <version>2.13.1</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g</argLine>
+          <trimStackTrace>false</trimStackTrace>
+          <!-- every test's `ZOO …` line is what the zoo judges; Maven's exit code is not -->
+          <testFailureIgnore>true</testFailureIgnore>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/Oracle.java b/hegel/src/test/java/zoo/Oracle.java
new file mode 100644
index 0000000..3597132
--- /dev/null
+++ b/hegel/src/test/java/zoo/Oracle.java
@@ -0,0 +1,293 @@
+package zoo;
+
+import com.google.gson.Gson;
+import com.google.gson.GsonBuilder;
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonNull;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import com.google.gson.JsonPrimitive;
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.time.ZoneOffset;
+import java.time.format.DateTimeFormatter;
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * PyYAML (libyaml when available) held open in a python3 child, one JSON request per line on its
+ * stdin, one JSON answer per line on its stdout. Values cross in the canonical form described in
+ * hegel-yaml-oracle.py; {@link #canon(Object)} produces it from what SnakeYAML constructs and
+ * {@link #same(JsonElement, JsonElement)} compares two forms with mappings and sets unordered.
+ */
+final class Oracle {
+
+    static final Gson GSON = new GsonBuilder().disableHtmlEscaping().serializeNulls().create();
+    private static Oracle instance;
+
+    final String pyyaml;
+    final boolean libyaml;
+    private final Process process;
+    private final BufferedWriter in;
+    private final BufferedReader out;
+
+    private Oracle() throws IOException {
+        Path script = Files.createTempFile("hegel-yaml-oracle", ".py");
+        try (InputStream src = Oracle.class.getResourceAsStream("/hegel-yaml-oracle.py")) {
+            if (src == null) {
+                throw new IllegalStateException("hegel-yaml-oracle.py is not on the class path");
+            }
+            Files.copy(src, script, java.nio.file.StandardCopyOption.REPLACE_EXISTING);
+        }
+        script.toFile().deleteOnExit();
+        process = new ProcessBuilder("python3", script.toString()).redirectError(ProcessBuilder.Redirect.INHERIT).start();
+        in = new BufferedWriter(new OutputStreamWriter(process.getOutputStream(), StandardCharsets.UTF_8));
+        out = new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8));
+        JsonObject ping = new JsonObject();
+        ping.addProperty("op", "ping");
+        JsonObject answer = call(ping);
+        pyyaml = answer.get("pyyaml").getAsString();
+        libyaml = answer.get("libyaml").getAsBoolean();
+        Runtime.getRuntime().addShutdownHook(new Thread(process::destroy));
+    }
+
+    static synchronized Oracle get() {
+        if (instance == null) {
+            try {
+                instance = new Oracle();
+            } catch (IOException ex) {
+                throw new IllegalStateException("cannot start the PyYAML oracle: " + ex, ex);
+            }
+        }
+        return instance;
+    }
+
+    private synchronized JsonObject call(JsonObject req) {
+        try {
+            in.write(GSON.toJson(req));
+            in.write('\n');
+            in.flush();
+            String line = out.readLine();
+            if (line == null) {
+                throw new IllegalStateException("the PyYAML oracle died (exit " + (process.isAlive() ? "?" : process.exitValue()) + ")");
+            }
+            return JsonParser.parseString(line).getAsJsonObject();
+        } catch (IOException ex) {
+            throw new IllegalStateException("talking to the PyYAML oracle: " + ex, ex);
+        }
+    }
+
+    /** The outcome of a load: either the documents or the first line of the error. */
+    static final class Loaded {
+        final JsonArray docs;
+        final String error;
+
+        Loaded(JsonArray docs, String error) {
+            this.docs = docs;
+            this.error = error;
+        }
+
+        boolean ok() {
+            return error == null;
+        }
+
+        @Override
+        public String toString() {
+            return ok() ? GSON.toJson(docs) : "error " + error;
+        }
+    }
+
+    /** All documents of {@code text} through the given loader: "safe" (libyaml), "base" or "pysafe" (pure Python). */
+    Loaded load(String text, String loader) {
+        JsonObject req = new JsonObject();
+        req.addProperty("op", "load");
+        req.addProperty("text", text);
+        req.addProperty("loader", loader);
+        JsonObject answer = call(req);
+        if (answer.get("ok").getAsBoolean()) {
+            return new Loaded(answer.getAsJsonArray("docs"), null);
+        }
+        return new Loaded(null, answer.get("error").getAsString());
+    }
+
+    Loaded load(String text) {
+        return load(text, "safe");
+    }
+
+    /** PyYAML's dump of a canonical value, or null with the error in {@code error[0]}. */
+    String dump(JsonElement value, JsonObject options, String[] error) {
+        JsonObject req = new JsonObject();
+        req.addProperty("op", "dump");
+        req.add("value", value);
+        req.add("options", options);
+        JsonObject answer = call(req);
+        if (answer.get("ok").getAsBoolean()) {
+            return answer.get("text").getAsString();
+        }
+        error[0] = answer.get("error").getAsString();
+        return null;
+    }
+
+    // ---------------------------------------------------------------- canonical form
+
+    private static final DateTimeFormatter ISO_MS = DateTimeFormatter.ofPattern("uuuu-MM-dd'T'HH:mm:ss.SSS").withZone(ZoneOffset.UTC);
+
+    static JsonElement canon(Object v) {
+        if (v == null) {
+            return JsonNull.INSTANCE;
+        }
+        if (v instanceof Boolean) {
+            return new JsonPrimitive((Boolean) v);
+        }
+        if (v instanceof String) {
+            return new JsonPrimitive((String) v);
+        }
+        if (v instanceof Integer || v instanceof Long || v instanceof BigInteger || v instanceof Short || v instanceof Byte) {
+            return tagged("$n", v.toString());
+        }
+        if (v instanceof Double || v instanceof Float) {
+            return tagged("$f", floatBits(((Number) v).doubleValue()));
+        }
+        if (v instanceof BigDecimal) {
+            return tagged("$f", floatBits(((BigDecimal) v).doubleValue()));
+        }
+        if (v instanceof Date) {
+            return tagged("$t", ISO_MS.format(Instant.ofEpochMilli(((Date) v).getTime())));
+        }
+        if (v instanceof byte[]) {
+            return tagged("$b", Base64.getEncoder().encodeToString((byte[]) v));
+        }
+        if (v instanceof Set) {
+            JsonArray members = new JsonArray();
+            for (Object x : (Set<?>) v) {
+                members.add(canon(x));
+            }
+            JsonObject o = new JsonObject();
+            o.add("$set", members);
+            return o;
+        }
+        if (v instanceof Map) {
+            JsonArray pairs = new JsonArray();
+            for (Map.Entry<?, ?> e : ((Map<?, ?>) v).entrySet()) {
+                JsonArray pair = new JsonArray();
+                pair.add(canon(e.getKey()));
+                pair.add(canon(e.getValue()));
+                pairs.add(pair);
+            }
+            JsonObject o = new JsonObject();
+            o.add("$m", pairs);
+            return o;
+        }
+        if (v instanceof List) {
+            JsonArray items = new JsonArray();
+            for (Object x : (List<?>) v) {
+                items.add(canon(x));
+            }
+            return items;
+        }
+        if (v instanceof Object[]) {
+            return canon(Arrays.asList((Object[]) v));
+        }
+        return tagged("$other", v.getClass().getName() + " " + v);
+    }
+
+    static JsonElement tagged(String tag, String text) {
+        JsonObject o = new JsonObject();
+        o.addProperty(tag, text);
+        return o;
+    }
+
+    static String floatBits(double d) {
+        if (Double.isNaN(d)) {
+            return "nan";
+        }
+        return String.format("%016x", Double.doubleToRawLongBits(d));
+    }
+
+    static JsonElement integer(long v) {
+        return tagged("$n", Long.toString(v));
+    }
+
+    static JsonElement floating(double d) {
+        return tagged("$f", floatBits(d));
+    }
+
+    /** Structural equality with `$m` pairs and `$set` members in any order (keys compared by their JSON text). */
+    static boolean same(JsonElement a, JsonElement b) {
+        if (a == null || b == null) {
+            return a == b;
+        }
+        if (a.isJsonArray() && b.isJsonArray()) {
+            JsonArray x = a.getAsJsonArray(), y = b.getAsJsonArray();
+            if (x.size() != y.size()) {
+                return false;
+            }
+            for (int i = 0; i < x.size(); i++) {
+                if (!same(x.get(i), y.get(i))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (a.isJsonObject() && b.isJsonObject()) {
+            JsonObject x = a.getAsJsonObject(), y = b.getAsJsonObject();
+            if (x.has("$m") && y.has("$m")) {
+                Map<String, JsonElement> mx = pairs(x.getAsJsonArray("$m")), my = pairs(y.getAsJsonArray("$m"));
+                if (mx == null || my == null || mx.size() != my.size()) {
+                    return false;
+                }
+                for (Map.Entry<String, JsonElement> e : mx.entrySet()) {
+                    if (!my.containsKey(e.getKey()) || !same(e.getValue(), my.get(e.getKey()))) {
+                        return false;
+                    }
+                }
+                return true;
+            }
+            if (x.has("$set") && y.has("$set")) {
+                Set<String> sx = new HashSet<>(), sy = new HashSet<>();
+                for (JsonElement m : x.getAsJsonArray("$set")) {
+                    sx.add(GSON.toJson(m));
+                }
+                for (JsonElement m : y.getAsJsonArray("$set")) {
+                    sy.add(GSON.toJson(m));
+                }
+                return sx.equals(sy);
+            }
+            return x.equals(y);
+        }
+        return a.equals(b);
+    }
+
+    private static Map<String, JsonElement> pairs(JsonArray array) {
+        Map<String, JsonElement> m = new HashMap<>();
+        for (JsonElement p : array) {
+            JsonArray pair = p.getAsJsonArray();
+            if (m.put(GSON.toJson(pair.get(0)), pair.get(1)) != null) {
+                return null; // a duplicate key: never equal to anything
+            }
+        }
+        return m;
+    }
+
+    static String show(JsonElement e) {
+        String s = GSON.toJson(e);
+        return s.length() > 600 ? s.substring(0, 600) + "…" : s;
+    }
+}
diff --git a/hegel/src/test/java/zoo/SnakeYamlDumpTest.java b/hegel/src/test/java/zoo/SnakeYamlDumpTest.java
new file mode 100644
index 0000000..7274eab
--- /dev/null
+++ b/hegel/src/test/java/zoo/SnakeYamlDumpTest.java
@@ -0,0 +1,501 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.StringReader;
+import java.io.StringWriter;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Pattern;
+import org.junit.jupiter.api.Test;
+import org.yaml.snakeyaml.DumperOptions;
+import org.yaml.snakeyaml.LoaderOptions;
+import org.yaml.snakeyaml.Yaml;
+import org.yaml.snakeyaml.constructor.SafeConstructor;
+import org.yaml.snakeyaml.emitter.Emitter;
+import org.yaml.snakeyaml.error.YAMLException;
+import org.yaml.snakeyaml.events.Event;
+import org.yaml.snakeyaml.nodes.CollectionNode;
+import org.yaml.snakeyaml.nodes.MappingNode;
+import org.yaml.snakeyaml.nodes.Node;
+import org.yaml.snakeyaml.nodes.NodeTuple;
+import org.yaml.snakeyaml.nodes.ScalarNode;
+import org.yaml.snakeyaml.nodes.SequenceNode;
+import org.yaml.snakeyaml.reader.StreamReader;
+import org.yaml.snakeyaml.representer.Representer;
+
+/**
+ * SnakeYAML's dumper side: values dumped under random DumperOptions load back equal (and PyYAML
+ * reads them the same), and event/node streams survive emitting and serializing.
+ */
+class SnakeYamlDumpTest {
+
+    // ---- values -------------------------------------------------------------------------------
+
+    static Object javaValue(TestCase tc, YamlGen g, int depth) {
+        int r = n(tc, 1, 100);
+        if (depth < 3 && r <= 25) {
+            int len = chance(tc, 10) ? 0 : n(tc, 1, 5);
+            List<Object> l = new ArrayList<>();
+            for (int i = 0; i < len; i++) {
+                l.add(javaValue(tc, g, depth + 1));
+            }
+            return l;
+        }
+        if (depth < 3 && r <= 50) {
+            int len = chance(tc, 10) ? 0 : n(tc, 1, 5);
+            Map<Object, Object> m = new LinkedHashMap<>();
+            for (int i = 0; i < len; i++) {
+                Object k = chance(tc, 80) ? g.genKey(new java.util.HashSet<>()) : scalarValue(tc, g);
+                m.put(k, javaValue(tc, g, depth + 1));
+            }
+            return m;
+        }
+        if (depth < 3 && r <= 55) {
+            Set<Object> s = new LinkedHashSet<>();
+            int len = n(tc, 0, 4);
+            for (int i = 0; i < len; i++) {
+                s.add(scalarValue(tc, g));
+            }
+            return s;
+        }
+        return scalarValue(tc, g);
+    }
+
+    static Object scalarValue(TestCase tc, YamlGen g) {
+        int r = n(tc, 1, 24);
+        if (r <= 2) {
+            return null;
+        }
+        if (r <= 4) {
+            return chance(tc, 50);
+        }
+        if (r <= 8) {
+            long v = g.genInt();
+            if (chance(tc, 15)) {
+                return BigInteger.valueOf(v).multiply(BigInteger.valueOf(pick(tc, 1L, 1000000007L, Long.MAX_VALUE)));
+            }
+            return v >= Integer.MIN_VALUE && v <= Integer.MAX_VALUE && chance(tc, 70) ? (Object) (int) v : (Object) v;
+        }
+        if (r <= 11) {
+            return g.genFloat();
+        }
+        if (r == 12) {
+            // 1583-01-01 .. 9999-12-31 in UTC, mostly whole seconds
+            long lo = -12219292800000L, hi = 253402300799999L;
+            long ms = lo + (long) (n(tc, 0, 1000000) / 1000000.0 * (hi - lo));
+            if (chance(tc, 70)) {
+                ms -= ms % 1000;
+            }
+            if (chance(tc, 50)) {
+                ms = 946684800000L + n(tc, -1000000000, 1000000000) * 1000L; // around 2000
+            }
+            return new Date(ms);
+        }
+        if (r == 13) {
+            byte[] b = new byte[n(tc, 0, 8)];
+            for (int i = 0; i < b.length; i++) {
+                b[i] = (byte) n(tc, 0, 255);
+            }
+            return b;
+        }
+        return g.genString();
+    }
+
+    static DumperOptions randomOptions(TestCase tc, List<String> style) {
+        DumperOptions o = new DumperOptions();
+        DumperOptions.FlowStyle flow = pick(tc, DumperOptions.FlowStyle.BLOCK, DumperOptions.FlowStyle.BLOCK, DumperOptions.FlowStyle.FLOW, DumperOptions.FlowStyle.AUTO);
+        o.setDefaultFlowStyle(flow);
+        style.add(flow.toString());
+        DumperOptions.ScalarStyle scalar = pick(tc, DumperOptions.ScalarStyle.PLAIN, DumperOptions.ScalarStyle.PLAIN, DumperOptions.ScalarStyle.SINGLE_QUOTED, DumperOptions.ScalarStyle.DOUBLE_QUOTED, DumperOptions.ScalarStyle.LITERAL, DumperOptions.ScalarStyle.FOLDED);
+        o.setDefaultScalarStyle(scalar);
+        style.add(scalar.toString());
+        int indent = pick(tc, 2, 2, 1, 3, 4, 8, 10);
+        o.setIndent(indent);
+        style.add("indent " + indent);
+        boolean withIndicator = chance(tc, 30);
+        o.setIndentWithIndicator(withIndicator);
+        int indicator = withIndicator ? n(tc, 0, 9) : n(tc, 0, indent - 1);
+        o.setIndicatorIndent(indicator);
+        style.add("indicator " + indicator + (withIndicator ? " with" : ""));
+        int width = pick(tc, 80, 80, 1, 10, 20, 40, 200, 1000);
+        o.setWidth(width);
+        style.add("width " + width);
+        o.setSplitLines(chance(tc, 70));
+        o.setAllowUnicode(chance(tc, 70));
+        if (chance(tc, 10)) {
+            o.setCanonical(true);
+            style.add("canonical");
+        }
+        o.setPrettyFlow(chance(tc, 30));
+        o.setExplicitStart(chance(tc, 30));
+        o.setExplicitEnd(chance(tc, 30));
+        DumperOptions.LineBreak lb = pick(tc, DumperOptions.LineBreak.UNIX, DumperOptions.LineBreak.UNIX, DumperOptions.LineBreak.WIN, DumperOptions.LineBreak.MAC);
+        o.setLineBreak(lb);
+        style.add(lb.toString());
+        int keyLen = pick(tc, 128, 128, 8, 1024, 1);
+        o.setMaxSimpleKeyLength(keyLen);
+        style.add("keylen " + keyLen);
+        DumperOptions.NonPrintableStyle nps = pick(tc, DumperOptions.NonPrintableStyle.BINARY, DumperOptions.NonPrintableStyle.ESCAPE);
+        o.setNonPrintableStyle(nps);
+        style.add(nps.toString());
+        if (chance(tc, 15)) {
+            o.setVersion(DumperOptions.Version.V1_1);
+            style.add("v1.1");
+        }
+        return o;
+    }
+
+    static final Pattern JAVA_EXPONENT = Pattern.compile("[0-9]\\.[0-9]*E[0-9]");
+    static final Pattern VALUE_SCALAR = Pattern.compile("(^|[\\s\\[{,:-])=(\\s|$|[,\\]}])");
+    static final Pattern INDENTATION_INDICATOR = Pattern.compile("[|>][+-]?[1-9]|[|>][1-9][+-]?");
+    /** snakeyaml/16: a line holding nothing but `\\` inside a double-quoted scalar — an escaped backslash where a continuation was meant. */
+    static final Pattern DOUBLED_CONTINUATION = Pattern.compile("(^|\\r|\\n) *\\\\\\\\(\\r|\\n)");
+
+    static boolean containsNel(Object v) {
+        if (v instanceof String) {
+            return ((String) v).indexOf('\u0085') >= 0;
+        }
+        if (v instanceof List) {
+            return ((List<?>) v).stream().anyMatch(SnakeYamlDumpTest::containsNel);
+        }
+        if (v instanceof Set) {
+            return ((Set<?>) v).stream().anyMatch(SnakeYamlDumpTest::containsNel);
+        }
+        if (v instanceof Map) {
+            return ((Map<?, ?>) v).entrySet().stream().anyMatch(e -> containsNel(e.getKey()) || containsNel(e.getValue()));
+        }
+        return false;
+    }
+
+    /** What a dump loads back as: with the BINARY style, strings holding non-printable characters come back as their UTF-8 bytes. */
+    static JsonElement expected(Object value, DumperOptions.NonPrintableStyle nps) {
+        return Oracle.canon(nps == DumperOptions.NonPrintableStyle.BINARY ? binarised(value) : value);
+    }
+
+    static Object binarised(Object v) {
+        if (v instanceof String) {
+            return StreamReader.isPrintable((String) v) ? v : ((String) v).getBytes(java.nio.charset.StandardCharsets.UTF_8);
+        }
+        if (v instanceof List) {
+            List<Object> l = new ArrayList<>();
+            for (Object x : (List<?>) v) {
+                l.add(binarised(x));
+            }
+            return l;
+        }
+        if (v instanceof Set) {
+            Set<Object> s = new LinkedHashSet<>();
+            for (Object x : (Set<?>) v) {
+                s.add(binarised(x));
+            }
+            return s;
+        }
+        if (v instanceof Map) {
+            Map<Object, Object> m = new LinkedHashMap<>();
+            for (Map.Entry<?, ?> e : ((Map<?, ?>) v).entrySet()) {
+                m.put(binarised(e.getKey()), binarised(e.getValue()));
+            }
+            return m;
+        }
+        return v;
+    }
+
+    static Yaml yamlFor(DumperOptions o) {
+        LoaderOptions lo = new LoaderOptions();
+        return new Yaml(new SafeConstructor(lo), new Representer(o), o, lo);
+    }
+
+    static boolean hasUnpairedSurrogate(Object v) {
+        if (v instanceof String) {
+            return YamlGen.hasSurrogate((String) v);
+        }
+        if (v instanceof List) {
+            return ((List<?>) v).stream().anyMatch(SnakeYamlDumpTest::hasUnpairedSurrogate);
+        }
+        if (v instanceof Set) {
+            return ((Set<?>) v).stream().anyMatch(SnakeYamlDumpTest::hasUnpairedSurrogate);
+        }
+        if (v instanceof Map) {
+            return ((Map<?, ?>) v).entrySet().stream().anyMatch(e -> hasUnpairedSurrogate(e.getKey()) || hasUnpairedSurrogate(e.getValue()));
+        }
+        return false;
+    }
+
+    // ---- 1. dump → load, in SnakeYAML and in PyYAML ---------------------------------------------
+
+    @Test
+    void dumpedValuesLoadBackAndPyYAMLReadsThem() {
+        Oracle oracle = Oracle.get();
+        Hegel.test(tc -> {
+            YamlGen g = new YamlGen(tc);
+            Object value = javaValue(tc, g, 0);
+            List<String> style = new ArrayList<>();
+            DumperOptions o = randomOptions(tc, style);
+            Yaml yaml = yamlFor(o);
+            JsonElement expected = expected(value, o.getNonPrintableStyle());
+            String text;
+            try {
+                text = yaml.dump(value);
+            } catch (YAMLException ex) {
+                fail("dump threw " + ex.getClass().getSimpleName() + ": " + SnakeYamlTest.firstLine(ex.getMessage()) + " for " + Oracle.show(expected) + " with " + style);
+                return;
+            }
+            String tag = "options " + style + ", value " + Oracle.show(expected) + SnakeYamlTest.describe(text);
+            String br = o.getLineBreak().getString();
+            check(text.endsWith(br), () -> "the dump does not end with the line break for " + tag);
+            check(!o.isCanonical() || text.startsWith("---") || text.startsWith("%"), () -> "a canonical dump without --- for " + tag);
+            check(!o.isExplicitStart() || text.startsWith("---") || text.startsWith("%"), () -> "explicitStart without --- for " + tag);
+            // snakeyaml/6: indent 10 (and 1) is silently replaced by 2 in the emitter; with an indicator indent of 2
+            // or more the sequence indicators then sit deeper than their content and the dump does not parse
+            boolean brokenIndent = (o.getIndent() == 10 || o.getIndent() == 1) && o.getIndicatorIndent() >= 2 && !o.getIndentWithIndicator();
+            // snakeyaml/7: a Double with a positive exponent dumps as 1.0E10, which YAML 1.1 readers take as a string
+            boolean javaFloat = JAVA_EXPONENT.matcher(text).find();
+            // snakeyaml/12: a string holding U+0085 dumped as a block scalar comes back with "\n" in its place
+            boolean nel = containsNel(value);
+            // a plain `=` is !!value for YAML 1.1 readers; PyYAML has no constructor for it (its gap, not SnakeYAML's)
+            boolean valueKey = VALUE_SCALAR.matcher(text).find();
+            // snakeyaml/14: with an indicator indent, block scalars that need an indentation indicator get a wrong one
+            boolean brokenIndicator = o.getIndicatorIndent() >= 1 && !o.getIndentWithIndicator() && INDENTATION_INDICATOR.matcher(text).find();
+            // snakeyaml/16: a double-quoted scalar indented past the width gets `\\` for a continuation
+            boolean doubledContinuation = DOUBLED_CONTINUATION.matcher(text).find();
+            if (brokenIndent || nel || brokenIndicator || doubledContinuation) {
+                return;
+            }
+            check(!o.isExplicitEnd() || text.endsWith("..." + br), () -> "explicitEnd without ... for " + tag);
+            SnakeYamlTest.Loaded back = SnakeYamlTest.loadAll(yamlFor(o), text);
+            check(back.ok() && back.docs.size() == 1 && Oracle.same(back.canon().get(0), expected), () -> "loads back as " + back + " for " + tag);
+            // PyYAML reads the same
+            if (!javaFloat && !valueKey) {
+                Oracle.Loaded theirs = oracle.load(text);
+                check(theirs.ok() && theirs.docs.size() == 1 && Oracle.same(theirs.docs.get(0), expected), () -> "PyYAML reads " + theirs + " for " + tag);
+            }
+            // dumpAll of a few values loads back as the list
+            List<Object> several = new ArrayList<>();
+            several.add(value);
+            int more = n(tc, 0, 2);
+            for (int i = 0; i < more; i++) {
+                Object v = javaValue(tc, g, 1);
+                if (!containsNel(v)) {
+                    several.add(v);
+                }
+            }
+            JsonArray expectedAll = new JsonArray();
+            for (Object v : several) {
+                expectedAll.add(expected(v, o.getNonPrintableStyle()));
+            }
+            try {
+                String all = yamlFor(o).dumpAll(several.iterator());
+                if (o.getIndicatorIndent() >= 1 && !o.getIndentWithIndicator() && INDENTATION_INDICATOR.matcher(all).find()) {
+                    return; // snakeyaml/14
+                }
+                if (DOUBLED_CONTINUATION.matcher(all).find()) {
+                    return; // snakeyaml/16
+                }
+                SnakeYamlTest.Loaded backAll = SnakeYamlTest.loadAll(yamlFor(o), all);
+                check(backAll.ok() && Oracle.same(backAll.canon(), expectedAll), () -> "dumpAll loads back as " + backAll + " instead of " + Oracle.show(expectedAll) + " for options " + style + SnakeYamlTest.describe(all));
+                if (!JAVA_EXPONENT.matcher(all).find() && !VALUE_SCALAR.matcher(all).find()) {
+                    Oracle.Loaded theirsAll = oracle.load(all);
+                    check(theirsAll.ok() && Oracle.same(theirsAll.docs, expectedAll), () -> "PyYAML reads dumpAll as " + theirsAll + " instead of " + Oracle.show(expectedAll) + " for options " + style + SnakeYamlTest.describe(all));
+                }
+            } catch (YAMLException ex) {
+                fail("dumpAll threw " + ex.getClass().getSimpleName() + ": " + SnakeYamlTest.firstLine(ex.getMessage()) + " for " + tag);
+            }
+            // the default Yaml agrees with itself too
+            String plain = new Yaml().dump(value);
+            JsonElement expectedPlain = expected(value, DumperOptions.NonPrintableStyle.BINARY);
+            SnakeYamlTest.Loaded backPlain = SnakeYamlTest.loadAll(SnakeYamlTest.safeYaml(), plain);
+            check(backPlain.ok() && backPlain.docs.size() == 1 && Oracle.same(backPlain.canon().get(0), expectedPlain), () -> "new Yaml().dump loads back as " + backPlain + " for " + Oracle.show(expectedPlain) + SnakeYamlTest.describe(plain));
+        }, Zoo.settings("dumpedValuesLoadBackAndPyYAMLReadsThem"));
+    }
+
+    // ---- 2. events and nodes survive emitting and serializing -----------------------------------
+
+    static List<Event> events(Yaml yaml, String text) {
+        List<Event> events = new ArrayList<>();
+        for (Event e : yaml.parse(new StringReader(text))) {
+            events.add(e);
+        }
+        return events;
+    }
+
+    static String describeEvents(List<Event> events) {
+        StringBuilder sb = new StringBuilder();
+        for (Event e : events) {
+            sb.append("\n    ").append(e);
+        }
+        return sb.toString();
+    }
+
+    static String nodeShape(Node node, boolean styles) {
+        StringBuilder sb = new StringBuilder();
+        shape(node, styles, sb);
+        return sb.toString();
+    }
+
+    static void shape(Node node, boolean styles, StringBuilder sb) {
+        sb.append(node.getTag().getValue()).append(' ');
+        if (node instanceof ScalarNode) {
+            ScalarNode s = (ScalarNode) node;
+            sb.append('"').append(s.getValue().replace("\\", "\\\\").replace("\"", "\\\"")).append('"');
+            if (styles) {
+                sb.append(' ').append(s.getScalarStyle());
+            }
+        } else if (node instanceof SequenceNode) {
+            if (styles) {
+                sb.append(((CollectionNode<?>) node).getFlowStyle()).append(' ');
+            }
+            sb.append('[');
+            for (Node child : ((SequenceNode) node).getValue()) {
+                shape(child, styles, sb);
+                sb.append(", ");
+            }
+            sb.append(']');
+        } else if (node instanceof MappingNode) {
+            if (styles) {
+                sb.append(((CollectionNode<?>) node).getFlowStyle()).append(' ');
+            }
+            sb.append('{');
+            for (NodeTuple t : ((MappingNode) node).getValue()) {
+                shape(t.getKeyNode(), styles, sb);
+                sb.append(": ");
+                shape(t.getValueNode(), styles, sb);
+                sb.append(", ");
+            }
+            sb.append('}');
+        } else {
+            sb.append(node.getClass().getSimpleName());
+        }
+    }
+
+    @Test
+    void eventsAndNodesSurviveEmitting() {
+        Hegel.test(tc -> {
+            YamlGen g = new YamlGen(tc);
+            List<YamlGen.Tree> trees = SnakeYamlTest.genTrees(g);
+            List<String> style = new ArrayList<>();
+            String text = g.writeStream(trees, style);
+            Yaml yaml = SnakeYamlTest.safeYaml();
+            String tag = "style " + style + SnakeYamlTest.describe(text);
+            List<Event> events;
+            try {
+                events = events(yaml, text);
+            } catch (YAMLException ex) {
+                fail("parse threw " + ex.getClass().getSimpleName() + ": " + SnakeYamlTest.firstLine(ex.getMessage()) + " for " + tag);
+                return;
+            }
+            check(events.size() >= 2 && events.get(0).is(Event.ID.StreamStart) && events.get(events.size() - 1).is(Event.ID.StreamEnd), () -> "the event stream is not framed for " + tag + describeEvents(events));
+            SnakeYamlTest.Loaded original = SnakeYamlTest.loadAll(yaml, text);
+            // emit the events back and parse them again
+            List<String> dstyle = new ArrayList<>();
+            DumperOptions o = randomOptions(tc, dstyle);
+            if ((o.getIndent() == 10 || o.getIndent() == 1) && o.getIndicatorIndent() >= 2 && !o.getIndentWithIndicator()) {
+                return; // snakeyaml/6
+            }
+            if (text.indexOf('\u0085') >= 0) {
+                return; // snakeyaml/12
+            }
+            StringWriter sw = new StringWriter();
+            String emitted;
+            try {
+                Emitter emitter = new Emitter(sw, o);
+                for (Event e : events) {
+                    emitter.emit(e);
+                }
+                emitted = sw.toString();
+            } catch (YAMLException | java.io.IOException ex) {
+                fail("emitting the parsed events threw " + ex.getClass().getSimpleName() + ": " + SnakeYamlTest.firstLine(ex.getMessage()) + " with " + dstyle + " for " + tag + describeEvents(events));
+                return;
+            }
+            if (o.getIndicatorIndent() >= 1 && !o.getIndentWithIndicator() && INDENTATION_INDICATOR.matcher(emitted).find()) {
+                return; // snakeyaml/14
+            }
+            if (DOUBLED_CONTINUATION.matcher(emitted).find()) {
+                return; // snakeyaml/16
+            }
+            String etag = "emitted with " + dstyle + SnakeYamlTest.describe(emitted) + "from " + tag;
+            SnakeYamlTest.Loaded reloaded = SnakeYamlTest.loadAll(SnakeYamlTest.safeYaml(), emitted);
+            check(original.ok() && reloaded.ok() && Oracle.same(reloaded.canon(), original.canon()), () -> "the emitted events load as " + reloaded + " instead of " + original + " for " + etag);
+            try {
+                List<Event> again = events(SnakeYamlTest.safeYaml(), emitted);
+                List<String> a = new ArrayList<>(), b = new ArrayList<>();
+                for (Event e : events) {
+                    a.add(eventKey(e));
+                }
+                for (Event e : again) {
+                    b.add(eventKey(e));
+                }
+                check(a.equals(b), () -> "the re-parsed events differ:" + diffLists(a, b) + "\nfor " + etag);
+            } catch (YAMLException ex) {
+                fail("re-parsing the emitted text threw " + ex.getClass().getSimpleName() + ": " + SnakeYamlTest.firstLine(ex.getMessage()) + " for " + etag);
+            }
+            // compose → serialize → compose keeps the node shape
+            try {
+                List<Node> nodes = new ArrayList<>();
+                for (Node node : SnakeYamlTest.safeYaml().composeAll(new StringReader(text))) {
+                    nodes.add(node);
+                }
+                for (Node node : nodes) {
+                    StringWriter nw = new StringWriter();
+                    Yaml ny = yamlFor(o);
+                    ny.serialize(node, nw);
+                    String ntext = nw.toString();
+                    if (DOUBLED_CONTINUATION.matcher(ntext).find()) {
+                        continue; // snakeyaml/16
+                    }
+                    Node back = SnakeYamlTest.safeYaml().compose(new StringReader(ntext));
+                    String before = nodeShape(node, false), after = back == null ? "null" : nodeShape(back, false);
+                    check(before.equals(after), () -> "serialize+compose changed the node from " + before + " to " + after + " with " + dstyle + SnakeYamlTest.describe(ntext) + "for " + tag);
+                    // and the node's events are the document's events
+                    List<Event> nodeEvents = ny.serialize(node);
+                    check(nodeEvents.size() >= 4 && nodeEvents.get(0).is(Event.ID.StreamStart) && nodeEvents.get(1).is(Event.ID.DocumentStart), () -> "serialize(node) gives " + describeEvents(nodeEvents) + " for " + tag);
+                }
+            } catch (YAMLException ex) {
+                fail("compose/serialize threw " + ex.getClass().getSimpleName() + ": " + SnakeYamlTest.firstLine(ex.getMessage()) + " with " + dstyle + " for " + tag);
+            }
+        }, Zoo.settings("eventsAndNodesSurviveEmitting"));
+    }
+
+    /** What must survive an emit: the event kind, anchors, tags, implicitness and scalar values (not styles). */
+    static String eventKey(Event e) {
+        String s = e.toString();
+        // drop the style, which the emitter may legitimately change, and the non-specific tag `!` it
+        // adds when it has to quote a plain implicit scalar (the meaning is the same: a string)
+        return s.replaceAll("style=[^,)]*,", "").replace("tag=!,", "tag=null,");
+    }
+
+    static String diffLists(List<String> a, List<String> b) {
+        StringBuilder sb = new StringBuilder();
+        int max = Math.max(a.size(), b.size());
+        for (int i = 0; i < max; i++) {
+            String x = i < a.size() ? a.get(i) : "<none>", y = i < b.size() ? b.get(i) : "<none>";
+            if (!x.equals(y)) {
+                sb.append("\n    #").append(i).append(": ").append(x).append("\n      -> ").append(y);
+            }
+        }
+        return sb.toString();
+    }
+
+    static String show(Object o) {
+        return Oracle.show(Oracle.canon(o));
+    }
+
+    static List<Object> list(Object... xs) {
+        return new ArrayList<>(Arrays.asList(xs));
+    }
+}
diff --git a/hegel/src/test/java/zoo/SnakeYamlPinsTest.java b/hegel/src/test/java/zoo/SnakeYamlPinsTest.java
new file mode 100644
index 0000000..147556f
--- /dev/null
+++ b/hegel/src/test/java/zoo/SnakeYamlPinsTest.java
@@ -0,0 +1,151 @@
+package zoo;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.time.Instant;
+import java.util.Arrays;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.yaml.snakeyaml.DumperOptions;
+import org.yaml.snakeyaml.LoaderOptions;
+import org.yaml.snakeyaml.Yaml;
+import org.yaml.snakeyaml.constructor.SafeConstructor;
+import org.yaml.snakeyaml.error.YAMLException;
+import org.yaml.snakeyaml.nodes.Tag;
+
+/**
+ * One pin per bug in bugs.toml: each asserts the documented (or YAML 1.1) behaviour and fails while
+ * the bug exists; `zoo` expects them to fail (target.toml `[expected_failures]`).
+ */
+class SnakeYamlPinsTest {
+
+    static Yaml safe() {
+        return new Yaml(new SafeConstructor(new LoaderOptions()));
+    }
+
+    @Test
+    void pinPlainScalarContinuationLinesMayStartWithThreeDashes() { // snakeyaml/1
+        assertEquals("a ---x b", safe().load("a\n---x\nb\n"));
+    }
+
+    @Test
+    void pinTheNonSpecificTagMakesAString() { // snakeyaml/2
+        assertEquals("123", safe().load("! 123"));
+    }
+
+    @Test
+    void pinTimestampsWithOutOfRangeFieldsAreRejected() { // snakeyaml/3
+        assertThrows(YAMLException.class, () -> safe().load("2001-02-30"));
+    }
+
+    @Test
+    void pinDatesBeforeTheGregorianCutoverAreProleptic() { // snakeyaml/4
+        assertEquals(Instant.parse("1500-01-01T00:00:00Z"), ((Date) safe().load("1500-01-01")).toInstant());
+    }
+
+    @Test
+    void pinSexagesimalIntegersDoNotOverflow() { // snakeyaml/5
+        assertEquals(360000000000L, ((Number) safe().load("100000000:0:0")).longValue());
+    }
+
+    @Test
+    void pinIndentTenIsHonoured() { // snakeyaml/6
+        DumperOptions o = new DumperOptions();
+        o.setIndent(10);
+        o.setDefaultFlowStyle(DumperOptions.FlowStyle.BLOCK);
+        Map<String, Object> inner = new LinkedHashMap<>();
+        inner.put("b", 1);
+        Map<String, Object> outer = new LinkedHashMap<>();
+        outer.put("a", inner);
+        String text = new Yaml(o).dump(outer);
+        assertEquals("a:\n          b: 1\n", text);
+    }
+
+    @Test
+    void pinDoublesDumpAsYaml11Floats() { // snakeyaml/7
+        String text = new Yaml().dump(1.0E10);
+        assertTrue(text.matches("[-+]?[0-9][0-9_]*\\.[0-9_]*([eE][-+][0-9]+)?\n"), text);
+    }
+
+    @Test
+    void pinDumpAsRestoresTheFlowStyleAfterAnError() { // snakeyaml/8
+        Yaml yaml = new Yaml();
+        Map<String, Object> inner = new LinkedHashMap<>();
+        inner.put("b", "x\ny");
+        Map<String, Object> outer = new LinkedHashMap<>();
+        outer.put("a", inner);
+        String before = yaml.dump(outer);
+        assertThrows(YAMLException.class, () -> yaml.dumpAs("\uD800", Tag.STR, DumperOptions.FlowStyle.FLOW));
+        assertEquals(before, yaml.dump(outer));
+    }
+
+    @Test
+    void pinNestingDepthCountsCollectionsOnly() { // snakeyaml/9
+        LoaderOptions lo = new LoaderOptions();
+        lo.setNestingDepthLimit(1);
+        Yaml yaml = new Yaml(new SafeConstructor(lo));
+        assertThrows(YAMLException.class, () -> yaml.load("[[1]]"));
+        assertThrows(YAMLException.class, () -> yaml.load("[[]]"));
+    }
+
+    @Test
+    void pinTheBoolTagRejectsOtherWords() { // snakeyaml/10
+        assertThrows(YAMLException.class, () -> safe().load("!!bool maybe"));
+    }
+
+    @Test
+    void pinConstructorFailuresAreYamlExceptions() { // snakeyaml/11
+        assertThrows(YAMLException.class, () -> safe().load("!!int abc"));
+    }
+
+    @Test
+    void pinStringsWithNextLineSurviveADump() { // snakeyaml/12
+        Yaml yaml = new Yaml();
+        String value = "a\u0085b";
+        assertEquals(value, yaml.load(yaml.dump(value)));
+    }
+
+    @Test
+    void pinTagsOnTheWrongNodeKindAreYamlExceptions() { // snakeyaml/13
+        assertThrows(YAMLException.class, () -> safe().load("!!int {a: 1}"));
+        assertThrows(YAMLException.class, () -> safe().load("!!map [1]"));
+    }
+
+    @Test
+    void pinBlockScalarsUnderAnIndicatorIndentLoadBack() { // snakeyaml/14
+        DumperOptions o = new DumperOptions();
+        o.setIndicatorIndent(1);
+        o.setDefaultFlowStyle(DumperOptions.FlowStyle.BLOCK);
+        Yaml yaml = new Yaml(o);
+        java.util.List<String> value = list("\nx");
+        assertEquals(value, safe().load(yaml.dump(value)));
+    }
+
+    @Test
+    void pinQuestionMarksInsideFlowPlainScalarsAreContent() { // snakeyaml/15
+        assertEquals(list("b?c"), safe().load("[b?c]"));
+    }
+
+    @Test
+    void pinDeeplyIndentedDoubleQuotedStringsSurviveADump() { // snakeyaml/16
+        DumperOptions o = new DumperOptions();
+        o.setWidth(10);
+        o.setIndent(4);
+        o.setDefaultFlowStyle(DumperOptions.FlowStyle.BLOCK);
+        Map<String, Object> c = new LinkedHashMap<>();
+        c.put("c", "x \n y");
+        Map<String, Object> b = new LinkedHashMap<>();
+        b.put("b", c);
+        Map<String, Object> a = new LinkedHashMap<>();
+        a.put("a", b);
+        assertEquals(a, safe().load(new Yaml(o).dump(a)));
+    }
+
+    static <T> java.util.List<T> list(T... xs) {
+        return Arrays.asList(xs);
+    }
+}
diff --git a/hegel/src/test/java/zoo/SnakeYamlTest.java b/hegel/src/test/java/zoo/SnakeYamlTest.java
new file mode 100644
index 0000000..0743fbe
--- /dev/null
+++ b/hegel/src/test/java/zoo/SnakeYamlTest.java
@@ -0,0 +1,369 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.StringReader;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.regex.Pattern;
+import org.junit.jupiter.api.Test;
+import org.yaml.snakeyaml.LoaderOptions;
+import org.yaml.snakeyaml.Yaml;
+import org.yaml.snakeyaml.constructor.SafeConstructor;
+import org.yaml.snakeyaml.error.YAMLException;
+import org.yaml.snakeyaml.nodes.Node;
+
+/**
+ * SnakeYAML's parser side against PyYAML (libyaml): documents written by {@link YamlGen} load as
+ * their trees in both readers, mutated documents load the same or fail in both, and plain scalars
+ * resolve alike.
+ */
+class SnakeYamlTest {
+
+    static Yaml safeYaml() {
+        return new Yaml(new SafeConstructor(new LoaderOptions()));
+    }
+
+    /** SnakeYAML's documents for a stream, or the exception's message. */
+    static final class Loaded {
+        final List<Object> docs;
+        final Exception error;
+
+        Loaded(List<Object> docs, Exception error) {
+            this.docs = docs;
+            this.error = error;
+        }
+
+        boolean ok() {
+            return error == null;
+        }
+
+        JsonArray canon() {
+            JsonArray a = new JsonArray();
+            for (Object d : docs) {
+                a.add(Oracle.canon(d));
+            }
+            return a;
+        }
+
+        @Override
+        public String toString() {
+            return ok() ? Oracle.show(canon()) : "error " + error.getClass().getSimpleName() + ": " + firstLine(error.getMessage());
+        }
+    }
+
+    static String firstLine(String s) {
+        if (s == null) {
+            return "null";
+        }
+        int i = s.indexOf('\n');
+        return i < 0 ? s : s.substring(0, i);
+    }
+
+    static Loaded loadAll(Yaml yaml, String text) {
+        List<Object> docs = new ArrayList<>();
+        try {
+            for (Object d : yaml.loadAll(text)) {
+                docs.add(d);
+            }
+            return new Loaded(docs, null);
+        } catch (YAMLException | IllegalArgumentException | IllegalStateException | IndexOutOfBoundsException | NullPointerException | ClassCastException | StackOverflowError ex) {
+            return new Loaded(null, ex instanceof Exception ? (Exception) ex : new RuntimeException(ex));
+        }
+    }
+
+    static String describe(String text) {
+        String s = text.length() > 500 ? text.substring(0, 500) + "…" : text;
+        return "\n" + s.replace("\n", "\n    ").replace("\t", "\\t") + "\n";
+    }
+
+    static List<YamlGen.Tree> genTrees(YamlGen g) {
+        List<YamlGen.Tree> trees = new ArrayList<>();
+        int docs = chance(g.tc, 25) ? n(g.tc, 2, 3) : 1;
+        for (int i = 0; i < docs; i++) {
+            trees.add(g.genTree(0));
+        }
+        return trees;
+    }
+
+    // ---- 1. written documents load as their trees, in SnakeYAML and in PyYAML -------------------
+
+    @Test
+    void writtenDocumentsLoadAsTheirTrees() {
+        Oracle oracle = Oracle.get();
+        Hegel.test(tc -> {
+            YamlGen g = new YamlGen(tc);
+            List<YamlGen.Tree> trees = genTrees(g);
+            List<String> style = new ArrayList<>();
