+            } else if (c == '\r') {
+                out.append("\\r");
+            } else if (c == '\t') {
+                out.append(chance(tc, 70) ? "\\t" : "\\x09");
+            } else if (c == 0x85) {
+                out.append("\\N");
+            } else if (c == 0xa0) {
