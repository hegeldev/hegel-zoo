+/**
+ * A randomised YAML writer for the parser side (ported from the zoo's js-yaml and go-yaml
+ * harnesses): a generated tree of plain values is written as a document in random styles —
+ * block and flow collections at random indentation, plain / single-quoted / double-quoted /
+ * literal / folded scalars, explicit keys, comments, document markers — staying inside what
+ * YAML 1.1 readers (SnakeYAML, PyYAML) must read back as the same tree.
+ */
+final class YamlGen {
+
+    /** A tree node: kind is null, bool, int, float, string, seq or map. */
+    static final class Tree {
+        final String kind;
+        final Object value; // Boolean, Long, Double or String
+        final List<Tree> items; // seq
+        final List<Map.Entry<String, Tree>> entries; // map
+
+        Tree(String kind, Object value, List<Tree> items, List<Map.Entry<String, Tree>> entries) {
+            this.kind = kind;
+            this.value = value;
+            this.items = items;
+            this.entries = entries;
+        }
+
+        static Tree scalar(String kind, Object value) {
+            return new Tree(kind, value, null, null);
+        }
+
+        boolean isColl() {
+            return kind.equals("seq") || kind.equals("map");
+        }
+
+        int size() {
+            return kind.equals("seq") ? items.size() : kind.equals("map") ? entries.size() : 0;
+        }
+
+        /** The canonical form (Oracle's) of the value a YAML 1.1 reader gives for this tree. */
+        JsonElement canon() {
+            switch (kind) {
+                case "null":
+                    return JsonNull.INSTANCE;
+                case "bool":
+                    return new JsonPrimitive((Boolean) value);
+                case "int":
+                    return Oracle.integer((Long) value);
+                case "float":
+                    return Oracle.floating((Double) value);
+                case "string":
+                    return new JsonPrimitive((String) value);
+                case "seq": {
+                    JsonArray a = new JsonArray();
+                    for (Tree t : items) {
+                        a.add(t.canon());
+                    }
+                    return a;
+                }
+                default: {
+                    JsonArray pairs = new JsonArray();
+                    for (Map.Entry<String, Tree> e : entries) {
+                        JsonArray pair = new JsonArray();
+                        pair.add(new JsonPrimitive(e.getKey()));
+                        pair.add(e.getValue().canon());
+                        pairs.add(pair);
+                    }
+                    JsonObject o = new JsonObject();
+                    o.add("$m", pairs);
+                    return o;
+                }
+            }
+        }
+
+        /** The Java value SnakeYAML's SafeConstructor gives (ints as Integer/Long, maps as LinkedHashMap). */
+        Object java() {
+            switch (kind) {
+                case "null":
+                    return null;
+                case "int": {
+                    long v = (Long) value;
+                    return v >= Integer.MIN_VALUE && v <= Integer.MAX_VALUE ? (Object) (int) v : (Object) v;
+                }
+                case "seq": {
+                    List<Object> l = new ArrayList<>();
+                    for (Tree t : items) {
+                        l.add(t.java());
+                    }
+                    return l;
+                }
+                case "map": {
+                    Map<Object, Object> m = new LinkedHashMap<>();
+                    for (Map.Entry<String, Tree> e : entries) {
+                        m.put(e.getKey(), e.getValue().java());
+                    }
+                    return m;
+                }
+                default:
+                    return value;
+            }
+        }
+    }
+
