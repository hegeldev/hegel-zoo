diff --git a/hegel/src/test/resources/hegel-yaml-oracle.py b/hegel/src/test/resources/hegel-yaml-oracle.py
new file mode 100644
index 0000000..4b4a12a
--- /dev/null
+++ b/hegel/src/test/resources/hegel-yaml-oracle.py
@@ -0,0 +1,130 @@
+#!/usr/bin/env python3
+"""Hegel zoo: PyYAML (libyaml when available) as the oracle for SnakeYAML, held open by the tests.
+
+Reads one JSON request per line from stdin and writes one JSON response per line to stdout.
+Values cross the boundary in a canonical form that both sides can produce:
+
+  null / true / false / "string"   as themselves
+  {"$n": "123"}                     an integer, in decimal
+  {"$f": "<16 hex digits>"}         a float, by its IEEE 754 bits ("nan" for NaN)
+  {"$t": "YYYY-MM-DDTHH:MM:SS.mmm"} a timestamp in UTC, truncated to milliseconds
+  {"$b": "<base64>"}                bytes (!!binary)
+  {"$set": [..]}                    a set (member order is not significant)
+  {"$m": [[k, v], ..]}              a mapping (pair order is not significant)
+  {"$omap": [[k, v], ..]}           an ordered mapping / pairs (order significant)
+  [..]                              a sequence
+"""
+import base64
+import datetime
+import json
+import math
+import struct
+import sys
+
+import yaml
+
+LOADERS = {
+    "safe": getattr(yaml, "CSafeLoader", yaml.SafeLoader),
+    "base": getattr(yaml, "CBaseLoader", yaml.BaseLoader),
+    "pysafe": yaml.SafeLoader,
+}
+DUMPER = getattr(yaml, "CSafeDumper", yaml.SafeDumper)
+
+
+def canon(v):
+    if v is None or isinstance(v, (bool, str)):
+        return v
+    if isinstance(v, int):
+        return {"$n": str(v)}
+    if isinstance(v, float):
+        return {"$f": float_bits(v)}
+    if isinstance(v, datetime.datetime):
+        if v.tzinfo is not None:
+            v = v.astimezone(datetime.timezone.utc).replace(tzinfo=None)
+        v = v.replace(microsecond=(v.microsecond // 1000) * 1000)
+        return {"$t": v.isoformat(timespec="milliseconds")}
+    if isinstance(v, datetime.date):
+        return {"$t": v.isoformat() + "T00:00:00.000"}
+    if isinstance(v, bytes):
+        return {"$b": base64.b64encode(v).decode("ascii")}
+    if isinstance(v, (list, tuple)):
+        return [canon(x) for x in v]
+    if isinstance(v, (set, frozenset)):
+        return {"$set": [canon(x) for x in v]}
+    if isinstance(v, dict):
+        return {"$m": [[canon(k), canon(x)] for k, x in v.items()]}
+    return {"$other": type(v).__name__ + " " + repr(v)[:100]}
+
+
+def float_bits(f):
+    if math.isnan(f):
+        return "nan"
+    return struct.pack(">d", f).hex()
+
+
+def uncanon(v):
+    if v is None or isinstance(v, (bool, str)):
+        return v
+    if isinstance(v, list):
+        return [uncanon(x) for x in v]
+    if "$n" in v:
+        return int(v["$n"])
+    if "$f" in v:
+        if v["$f"] == "nan":
+            return math.nan
+        return struct.unpack(">d", bytes.fromhex(v["$f"]))[0]
+    if "$t" in v:
+        return datetime.datetime.fromisoformat(v["$t"])
+    if "$b" in v:
+        return base64.b64decode(v["$b"])
+    if "$set" in v:
+        return set(uncanon(x) for x in v["$set"])
+    if "$m" in v:
+        return {uncanon(k): uncanon(x) for k, x in v["$m"]}
+    raise ValueError("bad canonical value %r" % (v,))
+
+
+def handle(req):
+    op = req["op"]
+    if op == "load":
+        loader = LOADERS[req.get("loader", "safe")]
+        try:
+            docs = list(yaml.load_all(req["text"], Loader=loader))
+        except Exception as e:  # noqa: BLE001 - any failure is an answer
+            return {"ok": False, "error": type(e).__name__ + ": " + str(e).split("\n")[0][:200]}
+        try:
+            return {"ok": True, "docs": [canon(d) for d in docs]}
+        except Exception as e:  # noqa: BLE001
+            return {"ok": False, "error": "canon: " + type(e).__name__ + ": " + str(e)[:200]}
+    if op == "dump":
+        try:
+            value = uncanon(req["value"])
+            opts = req.get("options", {})
+            text = yaml.dump(value, Dumper=DUMPER, allow_unicode=opts.get("allow_unicode", True),
+                             default_flow_style=opts.get("default_flow_style", False),
+                             width=opts.get("width", 80), indent=opts.get("indent", 2),
+                             default_style=opts.get("default_style", None), sort_keys=False)
+            return {"ok": True, "text": text}
+        except Exception as e:  # noqa: BLE001
+            return {"ok": False, "error": type(e).__name__ + ": " + str(e).split("\n")[0][:200]}
+    if op == "ping":
+        return {"ok": True, "pyyaml": yaml.__version__, "libyaml": yaml.__with_libyaml__}
+    return {"ok": False, "error": "unknown op"}
+
+
+def main():
+    out = sys.stdout
+    for line in sys.stdin:
+        line = line.strip()
+        if not line:
+            continue
+        try:
+            answer = handle(json.loads(line))
+        except Exception as e:  # noqa: BLE001
+            answer = {"ok": False, "error": "oracle: " + type(e).__name__ + ": " + str(e)[:200]}
+        out.write(json.dumps(answer, ensure_ascii=True) + "\n")
+        out.flush()
+
+
+if __name__ == "__main__":
+    main()
