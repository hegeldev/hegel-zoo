+/**
+ * Random YAML streams as trees ({@link Doc}): null, bool, int, float and string scalars (strings from a pool with
+ * Unicode, controls, NEL, BOM, emoji, indicator characters and YAML-looking words, or built from small pieces),
+ * sequences and mappings three levels deep with distinct keys by construction, every node with the spelling it is
+ * written in, and one to three documents per stream.
+ */
+final class YamlGen {
+    private YamlGen() {}
+
+    static final String LETTERS = "abcdefghijklmnopqrstuvwxyz";
+
+    // ---------------------------------------------------------------- values
+
+    static final Generator<String> WORD = word(LETTERS, 1, 6);
+
+    /** A piece of a built string: a word (half the time), a number, white space, an indicator or another odd character, a non-ASCII character. */
+    static final Generator<String> PIECE = weighted(
+        w(6, WORD),
+        w(2, ints(0, 999).map(String::valueOf)),
+        w(1, sampledFrom(" ", "  ", "\n", "\n\n", "\t")),
+        w(1, sampledFrom("-", ":", "#", ",", "[", "]", "{", "}", "?", "!", "&", "*", "|", ">", "'", "\"", "%", "@", "`", "\\", "/", ".", "_", "=", "<<")),
+        w(1, sampledFrom("\u00e9", "\u4e00", "\ud83d\ude00", "\u00a0", "\u0085", "\u2028")),
+        w(1, sampledFrom(" ", "-", ":", " ")));
+
+    /** A string: one of the pool (45%), or one to five pieces joined by nothing (40%), a space, a dash or a colon. */
+    static final Generator<String> STRING = weighted(
+        w(45, sampledFrom(Doc.STRING_POOL)),
+        w(55, tuples(sampledFrom("", "", " ", "-", ":"), lists(PIECE).minSize(1).maxSize(5)).map(t -> String.join(t.value1(), t.value2()))));
+
+    /** A long: small (40%), up to a million (30%), a boundary (10%) or up to a million million (20%). */
+    static final Generator<Long> INT = weighted(
+        w(40, ints(-100, 100).map(i -> (long) i)),
+        w(30, ints(-1_000_000, 1_000_000).map(i -> (long) i)),
+        w(10, sampledFrom(0L, 1L, -1L, 255L, 256L, 65535L, 2147483647L, -2147483648L, 2147483648L, 4294967295L, 9007199254740991L, -9007199254740991L, Long.MAX_VALUE, Long.MIN_VALUE)),
+        w(20, tuples(ints(-999_999_999, 999_999_999), ints(0, 999)).map(t -> t.value1() * 1000L + t.value2())));
+
+    /** A double: a small fraction (30%), a notable value (20%), an infinity or NaN (20%), a mantissa and decimal exponent (10%), a three-decimal number (20%). */
+    static final Generator<Double> FLOAT = weighted(
+        w(30, tuples(ints(-1000, 1000), sampledFrom(2, 4, 8, 10, 100)).map(t -> t.value1() / (double) t.value2())),
+        w(20, sampledFrom(0.1, 0.5, 1.5, -2.5, 1e-7, 1e21, 1e300, 5e-324, 123456.789, -0.0, 0.0)),
+        w(20, sampledFrom(Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY, Double.NaN)),
+        w(10, tuples(ints(-1_000_000, 1_000_000), ints(-12, 12)).map(t -> t.value1() * Math.pow(10, t.value2()))),
+        w(20, tuples(ints(1, 999), ints(0, 999)).map(t -> t.value1() + t.value2() / 1000.0)));
+
+    /** A mapping key: a word with a number after it 30% of the time (70%), or any string. */
+    static final Generator<String> KEY_TEXT = weighted(
+        w(70, tuples(WORD, maybe(30, "", ints(0, 99).map(String::valueOf))).map(t -> t.value1() + t.value2())),
+        w(30, STRING));
+
+    // ---------------------------------------------------------------- styles
+
+    static final Generator<String> COMMENT = maybe(15, "", sampledFrom(Doc.COMMENTS));
+
+    static final Generator<Place> PLACE = tuples(chance(15), chance(8), chance(25), sampledFrom(Nest.BLOCK, Nest.BLOCK, Nest.FLOW, Nest.COMPACT), ints(0, 4), ints(0, 2), COMMENT, chance(10))
+        .map(t -> new Place(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    static final Generator<List<Integer>> DICE = lists(ints(0, 99)).minSize(1).maxSize(6);
+
+    static final Generator<Quote> QUOTE = sampledFrom(Quote.PLAIN, Quote.PLAIN, Quote.PLAIN, Quote.SINGLE, Quote.DOUBLE);
+
+    static final Generator<BlockStyle> BLOCK_STYLE = tuples(
+            weighted(w(50, just(BlockKind.NONE)), w(30, just(BlockKind.LITERAL)), w(20, just(BlockKind.FOLDED))),
+            ints(1, 4), chance(20), chance(50), chance(20), DICE)
+        .map(t -> new BlockStyle(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+
+    static final Generator<Flow> FLOW = tuples(ints(0, 2), ints(0, 2), ints(0, 2), sampledFrom(" ", " ", "", "  "), chance(15), ints(0, 2), ints(0, 2))
+        .map(t -> new Flow(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    // ---------------------------------------------------------------- nodes
+
+    static final Generator<Node> NULL_NODE = tuples(ints(0, 9), PLACE).map(t -> new Null(t.value1(), t.value2()));
+    static final Generator<Node> BOOL_NODE = tuples(chance(50), ints(0, 9), PLACE).map(t -> new Bool(t.value1(), t.value2(), t.value3()));
+    static final Generator<Node> INT_NODE = tuples(INT, ints(0, 9), PLACE).map(t -> new Int(t.value1(), t.value2(), t.value3()));
+    static final Generator<Node> FLOAT_NODE = tuples(FLOAT, ints(0, 9), chance(20), chance(15), PLACE).map(t -> new Flt(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+    static final Generator<Node> STR_NODE = tuples(STRING, QUOTE, DICE, BLOCK_STYLE, PLACE).map(t -> new Str(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    static final Generator<Node> SCALAR = weighted(w(10, NULL_NODE), w(10, BOOL_NODE), w(20, INT_NODE), w(15, FLOAT_NODE), w(45, STR_NODE));
+
+    static List<Entry> entries(Map<String, Tuple3<Quote, List<Integer>, Node>> m) {
+        List<Entry> out = new ArrayList<>();
+        for (Map.Entry<String, Tuple3<Quote, List<Integer>, Node>> e : m.entrySet()) {
+            out.add(new Entry(new Key(e.getKey(), e.getValue().value1(), e.getValue().value2()), e.getValue().value3()));
+        }
+        return out;
+    }
+
+    /** A node at container depth {@code depth}: a scalar (44%), or (above the bottom) a sequence or mapping of up to five children. */
+    static Generator<Node> level(int depth) {
+        if (depth >= 3) {
+            return SCALAR;
+        }
+        Generator<Node> deeper = level(depth + 1);
+        Generator<Node> seq = tuples(lists(deeper).maxSize(5), FLOW, PLACE).map(t -> new Seq(t.value1(), t.value2(), t.value3()));
+        Generator<Node> map = tuples(maps(KEY_TEXT, tuples(QUOTE, DICE, deeper)).maxSize(5), FLOW, PLACE).map(t -> new Mapping(entries(t.value1()), t.value2(), t.value3()));
+        return weighted(w(44, SCALAR), w(28, seq), w(28, map));
+    }
+
+    static final Generator<Node> NODE = level(0);
+
+    // ---------------------------------------------------------------- documents
+
+    static final Generator<DocStyle> DOC_STYLE = tuples(chance(20), chance(15), chance(30), maybe(30, "", sampledFrom(Doc.COMMENTS)), maybe(15, 0, ints(1, 3)), chance(20), chance(20), chance(10))
+        .map(t -> new DocStyle(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    static final Generator<Document> DOCUMENT = tuples(NODE, DOC_STYLE).map(t -> new Document(t.value1(), t.value2()));
+
+    /** A stream of one to three documents. */
+    static final Generator<Stream> STREAM = lists(DOCUMENT).minSize(1).maxSize(3).map(Stream::new);
+}
