+            sampledFrom(DSRecord.Digest.SHA1, DSRecord.Digest.SHA256, DSRecord.Digest.SHA384))
+        .map(t -> new DnssecCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+
+    /** ECDSA P-256 keys: sign an RRset, verify it, refuse a modified set, and DS/DNSKEY conversions agree. */
