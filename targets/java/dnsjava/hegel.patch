+            for (Record r : set.rrs(false)) {
+                Zoo.check(r.getTTL() == minTtl, () -> "member TTL " + r.getTTL() + " in " + set);
+            }
+            Zoo.check(new ArrayList<>(set.rrs(false)).equals(members), () -> "rrs(false) " + set.rrs(false) + ", expected " + members);
+            List<Record> cycled = set.rrs(true);
