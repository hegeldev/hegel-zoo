+        assertNull(Record.newRecord(N, Type.NSEC, DClass.IN, 0, rdata));
+    }
+
+    /** dnsjava/8: LOC seconds lose their milliseconds ("1.001" becomes "1"). */
+    @Test
+    void pinLocKeepsMilliseconds() throws Exception {
