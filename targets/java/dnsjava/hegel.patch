+            String line = r.toString();
+            Zoo.check(line.contains("\t" + DClass.string(dclass) + "\t" + Type.string(g.type())) || (dclass == DClass.IN && line.contains("\tIN\t")), () -> what + ": line " + line);
+            // a message carrying the record twice with different owner case still round-trips, with compression
+            Message msg = new Message(Zoo.n(tc, 0, 65535));
+            msg.addRecord(Record.newRecord(owner, g.type(), dclass), Section.QUESTION);
+            msg.addRecord(r, Section.ANSWER);
+            Record rUpper = r.withName(name(owner.toString().toUpperCase()));
+            msg.addRecord(rUpper, Section.ANSWER);
+            byte[] mw = msg.toWire();
