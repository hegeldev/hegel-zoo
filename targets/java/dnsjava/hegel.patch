+            DnsGen.Rdata g = DnsGen.record(tc);
+            Name owner = DnsGen.simpleName(tc, 3);
+            long ttl = Zoo.chance(tc, 10) ? 0 : Zoo.n(tc, 1, Integer.MAX_VALUE); // wire TTLs past 2^31 are bug dnsjava/43's shape
+            int dclass = Zoo.chance(tc, 90) ? DClass.IN : Zoo.pick(tc, DClass.CH, DClass.HS, 254);
+            String what = Type.string(g.type()) + " " + g.text();
+            Record r;
+            try {
+                r = Record.fromString(owner, g.type(), dclass, ttl, g.text(), Name.root);
+            } catch (Exception e) {
+                Zoo.fail(what + ": fromString threw " + e);
+                return;
+            }
+            // presentation form: rdataToString reparses to an equal record with identical text; the whole line parses in a Master
+            String text = r.rdataToString();
+            Record r2 = Record.fromString(owner, g.type(), dclass, ttl, text, Name.root);
+            Zoo.check(r2.equals(r), () -> what + ": text " + text + " reparsed as " + flat(r2) + ", not " + flat(r));
+            Zoo.check(r2.rdataToString().equals(text), () -> what + ": text not stable, " + text + " -> " + r2.rdataToString());
+            Zoo.check(r.compareTo(r2) == 0 && r.hashCode() == r2.hashCode(), () -> what + ": equal records compare " + r.compareTo(r2) + ", hashes " + r.hashCode() + "/" + r2.hashCode());
+            Master m = new Master(new ByteArrayInputStream((r + "\n").getBytes()), Name.root);
+            Record r3 = m.nextRecord();
+            Zoo.check(r.equals(r3) && r3 != null && r3.getTTL() == ttl, () -> what + ": Master read " + flat(r) + " as " + flat(r3));
+            Zoo.check(m.nextRecord() == null, () -> what + ": Master found a second record in " + flat(r));
+            // wire form, plain and canonical
+            byte[] w = r.toWire(Section.ANSWER);
+            Record r4 = Record.fromWire(w, Section.ANSWER);
+            Zoo.check(r4.equals(r) && r4.getTTL() == ttl && r4.getDClass() == dclass, () -> what + ": wire round trip gave " + flat(r4));
+            Zoo.check(r4.rdataToString().equals(text), () -> what + ": text after the wire trip " + r4.rdataToString() + " differs from " + text);
+            Zoo.check(Arrays.equals(r4.toWire(Section.ANSWER), w), () -> what + ": wire not stable");
+            byte[] rd = r.rdataToWireCanonical();
