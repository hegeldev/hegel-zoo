+
+    /** A TTL in text with its value: plain seconds or fully unit-suffixed (a trailing unitless part is bug dnsjava/26's shape). */
+    static String ttlText(TestCase tc, long[] value) {
+        if (Zoo.chance(tc, 60)) {
+            long v = Zoo.chance(tc, 80) ? Zoo.n(tc, 0, 86400 * 7) : Zoo.n(tc, 0, Integer.MAX_VALUE);
+            value[0] = v;
+            return Long.toString(v);
+        }
+        String[] units = {"w", "d", "h", "m", "s"};
+        long[] mult = {604800, 86400, 3600, 60, 1};
+        StringBuilder sb = new StringBuilder();
+        long sum = 0;
+        int from = 0;
+        int parts = Zoo.n(tc, 1, 3);
+        for (int p = 0; p < parts && from < units.length; p++) {
+            int u = Zoo.n(tc, from, units.length - 1);
