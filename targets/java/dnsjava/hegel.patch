+            Name owner = c.ownerLabel() == null ? zone : Name.fromString(c.ownerLabel() + "." + zone);
+            int type = c.set().type();
+            RRset set = new RRset();
+            for (String rdata : c.set().rdatas()) {
+                set.addRR(Record.fromString(owner, type, DClass.IN, 300, rdata, Name.root));
+            }
+            Instant inception = Instant.ofEpochSecond(c.inception());
+            Instant expiration = inception.plusSeconds(c.validity());
+            Instant now = inception.plusSeconds(1);
+            RRSIGRecord sig = DNSSEC.sign(set, dnskey, kp.getPrivate(), inception, expiration);
+            Zoo.check(sig.getTypeCovered() == type && sig.getFootprint() == dnskey.getFootprint() && sig.getSigner().equals(zone) && sig.getLabels() == owner.labels() - 1 && sig.getOrigTTL() == 300, () -> "RRSIG fields " + flat(sig));
+            DNSSEC.verify(set, sig, dnskey, now);
+            RRSIGRecord sigBack = (RRSIGRecord) Record.fromWire(sig.toWire(Section.ANSWER), Section.ANSWER);
+            DNSSEC.verify(set, sigBack, dnskey, now);
+            // the same set in another order and case verifies too
+            RRset shuffled = new RRset();
+            List<Record> rrs = new ArrayList<>(set.rrs(false));
