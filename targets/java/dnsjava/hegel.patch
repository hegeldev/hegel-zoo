+/** Master files against a model of RFC 1035 §5 syntax and $GENERATE; zone lookups against RFC 1034 §4.3.2 / RFC 4592. */
+class ZoneTest {
+
+    static final int[] MASTER_TYPES = {Type.A, Type.AAAA, Type.TXT, Type.MX, Type.NS, Type.PTR, Type.SRV, Type.HINFO, Type.CNAME};
+    static final int[] GEN_TYPES = {Type.A, Type.AAAA, Type.PTR, Type.CNAME, Type.NS, Type.DNAME};
