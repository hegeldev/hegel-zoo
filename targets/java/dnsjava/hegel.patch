+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for dnsjava, added by the Hegel zoo (targets/java/dnsjava).
+     Runs against the dnsjava:dnsjava artifact that `[run] setup` installs from this checkout
+     into the local Maven repository. Oracles: java.util twins (TreeMap, LinkedHashMap, ArrayList, ArrayDeque) driven
+     by the same operation sequences, and set/count models written in the tests. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>dnsjava-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <dnsjava.version>3.6.6-SNAPSHOT</dnsjava.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>dnsjava</groupId>
+      <artifactId>dnsjava</artifactId>
+      <version>${dnsjava.version}</version>
+    </dependency>
+    <dependency>
+      <!-- independent reader/writer of the RFC 4180 dialects -->
+      <groupId>de.siegmar</groupId>
+      <artifactId>fastcsv</artifactId>
+      <version>4.0.0</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <!-- JSON lines to and from the Python csv oracle -->
+      <groupId>com.google.code.gson</groupId>
+      <artifactId>gson</artifactId>
+      <version>2.13.1</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/DnsGen.java b/hegel/src/test/java/zoo/DnsGen.java
new file mode 100644
index 0000000..4c1faf1
--- /dev/null
+++ b/hegel/src/test/java/zoo/DnsGen.java
@@ -0,0 +1,629 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.oneOf;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.sets;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.maybe;
+import static zoo.Gen.seq;
+import static zoo.Gen.spaced;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Gen.word;
+
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeSet;
+import org.xbill.DNS.Name;
+import org.xbill.DNS.Type;
+
+/**
+ * Generators for dnsjava: bytes and their encodings, addresses, names as label lists, and records of ~58 types as
+ * (type, presentation rdata) pairs whose text is valid input for {@code Record.fromString}. Every generator is a value
+ * built from the binding's combinators; the drawn data is rendered by pure functions. Known-bug shapes are avoided
+ * here and named in the comments.
+ */
+final class DnsGen {
+    private DnsGen() {}
+
+    static final String LDH = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-";
+    static final String LOWER_ALNUM = "abcdefghijklmnopqrstuvwxyz0123456789";
+
+    /** A record in presentation form: the type and the rdata text. */
+    record Rdata(int type, String text) {}
+
+    static Name name(String s) {
+        try {
+            return Name.fromString(s);
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    // ---- bytes and encodings -------------------------------------------------------------------------------------
+
+    /** A byte: printable ASCII (70%) or any. */
+    static final Generator<Integer> BYTE = weighted(w(70, ints(0x20, 0x7e)), w(30, ints(0, 255)));
+
+    /** lo..hi bytes. */
+    static Generator<byte[]> bytes(int lo, int hi) {
+        return lists(BYTE).minSize(lo).maxSize(hi).map(DnsGen::toBytes);
+    }
+
+    static byte[] toBytes(List<Integer> xs) {
+        byte[] b = new byte[xs.size()];
+        for (int i = 0; i < b.length; i++) {
+            b[i] = (byte) (int) xs.get(i);
+        }
+        return b;
+    }
+
+    static byte[] ascii(String s) {
+        return s.getBytes(StandardCharsets.US_ASCII);
+    }
+
+    static String hex(byte[] b) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : b) {
+            sb.append(String.format("%02X", x & 0xff));
+        }
+        return sb.toString();
+    }
+
+    static String b64(byte[] b) {
+        return Base64.getEncoder().encodeToString(b);
+    }
+
+    /** RFC 4648 base32hex, unpadded, as NSEC3 uses it. */
+    static String base32hex(byte[] b) {
+        String alpha = "0123456789ABCDEFGHIJKLMNOPQRSTUV";
+        StringBuilder sb = new StringBuilder();
+        int buffer = 0;
+        int bits = 0;
+        for (byte x : b) {
+            buffer = (buffer << 8) | (x & 0xff);
+            bits += 8;
+            while (bits >= 5) {
+                sb.append(alpha.charAt((buffer >> (bits - 5)) & 31));
+                bits -= 5;
+            }
+        }
+        if (bits > 0) {
+            sb.append(alpha.charAt((buffer << (5 - bits)) & 31));
+        }
+        return sb.toString();
+    }
+
+    /** The master-file character-string form of arbitrary bytes, quoted. */
+    static String quoted(byte[] b) {
+        StringBuilder sb = new StringBuilder("\"");
+        for (byte x : b) {
+            int c = x & 0xff;
+            if (c < 0x20 || c >= 0x7f) {
+                sb.append(String.format("\\%03d", c));
+            } else if (c == '"' || c == '\\') {
+                sb.append('\\').append((char) c);
+            } else {
+                sb.append((char) c);
+            }
+        }
+        return sb.append('"').toString();
+    }
+
+    /** A quoted character-string of up to max bytes; empty one time in ten. */
+    static Generator<String> charString(int max) {
+        return weighted(w(10, bytes(0, max)), w(90, bytes(1, max))).map(DnsGen::quoted);
+    }
+
+    static final Generator<String> B64_40 = bytes(1, 40).map(DnsGen::b64);
+    static final Generator<String> B64_60 = bytes(1, 60).map(DnsGen::b64);
+    static final Generator<String> B64_80 = bytes(1, 80).map(DnsGen::b64);
+    static final Generator<String> HEX_40 = bytes(1, 40).map(DnsGen::hex);
+
+    // ---- addresses -----------------------------------------------------------------------------------------------
+
+    static final Generator<String> OCTET = ints(0, 255).map(String::valueOf);
+
+    static final Generator<String> IPV4 = tuples(OCTET, OCTET, OCTET, OCTET)
+        .map(t -> t.value1() + "." + t.value2() + "." + t.value3() + "." + t.value4());
+
+    /** A 16-bit group of an IPv6 address: small (half the time) or any. */
+    static final Generator<Integer> GROUP = weighted(w(1, ints(0, 3)), w(1, ints(0, 0xffff)));
+
+    static final Generator<List<Integer>> GROUPS = lists(GROUP).minSize(8).maxSize(8);
+
+    /** An IPv6 address: eight groups with a run of zeros of the given length from the given start; never IPv4-mapped (the ::ffff: family of bugs, dnsjava/3 and /23, is pinned). */
+    record V6(List<Integer> groups, int zeroStart, int zeroLen) {
+        String text() {
+            int[] g = new int[8];
+            for (int i = 0; i < 8; i++) {
+                g[i] = groups.get(i);
+            }
+            for (int i = zeroStart; i < Math.min(8, zeroStart + zeroLen); i++) {
+                g[i] = 0;
+            }
+            if (g[0] == 0 && g[1] == 0 && g[2] == 0 && g[3] == 0 && g[4] == 0 && g[5] == 0xffff) {
+                g[5] = 1;
+            }
+            return groupsText(g);
+        }
+    }
+
+    static String groupsText(int[] g) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < 8; i++) {
+            sb.append(i > 0 ? ":" : "").append(Integer.toHexString(g[i]));
+        }
+        return sb.toString();
+    }
+
+    static final Generator<String> IPV6 = tuples(GROUPS, ints(0, 7), ints(0, 8)).map(t -> new V6(t.value1(), t.value2(), t.value3()).text());
+
+    /** An A6 suffix in full eight-group form whose first prefix bits are zero (RFC 2874 section 3.1.1), never IPv4-mapped. */
+    static String a6Suffix(byte[] bytes, int prefix) {
+        byte[] b = bytes.clone();
+        for (int bit = 0; bit < prefix; bit++) {
+            b[bit / 8] &= (byte) ~(0x80 >> (bit % 8));
+        }
+        boolean zeroHead = true;
+        for (int i = 0; i < 10; i++) {
+            zeroHead &= b[i] == 0;
+        }
+        if (zeroHead && b[10] == (byte) 0xff && b[11] == (byte) 0xff) {
+            b[11] = 1;
+        }
+        int[] g = new int[8];
+        for (int i = 0; i < 8; i++) {
+            g[i] = ((b[2 * i] & 0xff) << 8) | (b[2 * i + 1] & 0xff);
+        }
+        return groupsText(g);
+    }
+
+    // ---- names --------------------------------------------------------------------------------------------------
+
+    /** A label as bytes: mostly letters/digits/hyphens (short, or up to 63), sometimes anything (escaped in the text form). */
+    static final Generator<byte[]> LABEL = weighted(
+        w(76, word(LDH, 1, 8).map(DnsGen::ascii)),
+        w(4, word(LDH, 1, 63).map(DnsGen::ascii)),
+        w(19, bytes(1, 6)),
+        w(1, bytes(1, 63)));
+
+    /** The presentation form of a label: RFC 1035 escapes for everything a tokenizer or Name parser treats specially. */
+    static String labelText(byte[] label) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : label) {
+            int c = x & 0xff;
+            if (c <= 0x20 || c >= 0x7f) {
+                sb.append(String.format("\\%03d", c));
+            } else if ("\"().;\\@$".indexOf(c) >= 0) {
+                sb.append('\\').append((char) c);
+            } else {
+                sb.append((char) c);
+            }
+        }
+        return sb.toString();
+    }
+
+    /** An absolute name of 1..depth simple lower-case labels plus a final dot; never longer than 255 octets. */
+    static Generator<Name> simpleName(int depth) {
+        return lists(word(LOWER_ALNUM, 1, 8)).minSize(1).maxSize(depth).map(ls -> name(String.join(".", ls) + "."));
+    }
+
+    /** An absolute name in text: the root one time in twenty, else up to four labels. */
+    static final Generator<String> ABS_NAME = weighted(w(5, just(".")), w(95, simpleName(4).map(Name::toString)));
+
+    // ---- record fields -----------------------------------------------------------------------------------------
+
+    static final Generator<String> U8 = ints(0, 255).map(String::valueOf);
+    static final Generator<String> U16 = ints(0, 65535).map(String::valueOf);
+
+    /** A 32-bit value: below 2^31 (80%) or within 1000 of 2^32 - 1. */
+    static final Generator<String> U32 = weighted(
+        w(80, ints(0, Integer.MAX_VALUE).map(String::valueOf)),
+        w(20, ints(0, 1000).map(d -> String.valueOf(4294967295L - d))));
+
+    /** A sorted, duplicate-free type list for NSEC/NSEC3/NXT bitmaps (up to six mnemonics, mostly below 60), or nothing. */
+    static Generator<String> typeList(int max) {
+        return sets(weighted(w(70, ints(1, 60)), w(30, ints(1, max)))).maxSize(6).map(ts -> {
+            List<String> out = new ArrayList<>();
+            for (int t : new TreeSet<>(ts)) {
+                out.add(Type.string(t));
+            }
+            return spaced(out);
+        });
+    }
+
+    /** 1971..2100 in YYYYMMDDHHmmSS; SIGBase writes the epoch second as u32, so nothing before 1970 (bug dnsjava/13) or past 2106. */
+    static final Generator<String> SIG_TIME = tuples(ints(1971, 2100), ints(1, 12), ints(1, 28), ints(0, 23), ints(0, 59), ints(0, 59))
+        .map(t -> String.format("%04d%02d%02d%02d%02d%02d", t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+
+    /** An NSEC3 salt: "-" for none. */
+    static final Generator<String> SALT = bytes(0, 8).map(s -> s.length == 0 ? "-" : hex(s));
+
+    static final Generator<String> ZERO_OR_ONE = oneOf(just("0"), just("1"));
+
+    // ---- rdata by type ------------------------------------------------------------------------------------------
+
+    static final Generator<String> PREF_NAME = seq(U16, ABS_NAME);
+    static final Generator<String> TWO_NAMES = seq(ABS_NAME, ABS_NAME);
+    static final Generator<String> PX = seq(U16, ABS_NAME, ABS_NAME);
+    static final Generator<String> SOA = seq(ABS_NAME, ABS_NAME, U32, U32, U32, U32, U32);
+
+    /** One to four character-strings, one in twenty up to 255 bytes. */
+    static final Generator<String> TXT = lists(weighted(w(95, charString(20)), w(5, charString(255)))).minSize(1).maxSize(4).map(Gen::spaced);
+
+    static final Generator<String> HINFO = seq(charString(20), charString(20));
+    static final Generator<String> X25 = word("0123456789", 1, 20).map(s -> quoted(ascii(s)));
+
+    /** GPOS validates longitude against +-90 and latitude against +-180 (bug dnsjava/18): stay within +-90. */
+    static final Generator<String> GPOS = tuples(ints(-9000, 9000), ints(-9000, 9000), ints(-100000, 100000))
+        .map(t -> "\"" + (t.value1() / 100.0) + "\" \"" + (t.value2() / 100.0) + "\" \"" + (t.value3() / 10.0) + "\"");
+
+    static final Generator<String> SRV = seq(U16, U16, U16, ABS_NAME);
+    static final Generator<String> NAPTR = seq(U16, U16, charString(8), charString(20), charString(30), ABS_NAME);
+
+    /** The tag is printed unquoted (bug dnsjava/14): letters and digits only, as RFC 8659 requires anyway. */
+    static final Generator<String> CAA = seq(oneOf(just("0"), just("128"), U8), word(LDH.substring(0, 62), 1, 15), charString(100));
+
+    static final Generator<String> URI = seq(U16, U16, charString(100));
+    static final Generator<String> TLSA = seq(U8, U8, U8, HEX_40);
+    static final Generator<String> SSHFP = seq(U8, U8, HEX_40);
+
+    /** A DS: the digest length follows the digest type (1, 2 and 4 are fixed; 0 and 9 are anything). */
+    static final Generator<String> DS = sampledFrom(0, 1, 2, 4, 9).flatMap(digest -> {
+        Generator<byte[]> hash = digest == 1 ? bytes(20, 20) : digest == 2 ? bytes(32, 32) : digest == 4 ? bytes(48, 48) : bytes(1, 40);
+        return tuples(U16, U8, hash).map(t -> t.value1() + " " + t.value2() + " " + digest + " " + hex(t.value3()));
+    });
+
+    static final Generator<String> DNSKEY = seq(oneOf(just("256"), just("257"), just("0"), U16), just("3"), U8, B64_80);
+
+    /** Numeric flags below 0xC000: NOKEY (0xC000) with key data is another writer/reader asymmetry. */
+    static final Generator<String> KEY = seq(ints(0, 0xbfff).map(String::valueOf), U8, U8, B64_40);
+
+    static final Generator<String> RRSIG = seq(ints(1, 65535).map(Type::string), U8, U8, ints(0, Integer.MAX_VALUE).map(String::valueOf),
+        SIG_TIME, SIG_TIME, U16, ABS_NAME, B64_80);
+    static final Generator<String> NSEC = seq(ABS_NAME, typeList(65535));
+    static final Generator<String> NSEC3 = seq(just("1"), ZERO_OR_ONE, U16, SALT, bytes(1, 32).map(DnsGen::base32hex), typeList(65535));
+    static final Generator<String> NSEC3PARAM = seq(just("1"), ZERO_OR_ONE, U16, SALT);
+
+    /** A LOC position: degrees, minutes, whole seconds (fractions are bug dnsjava/8's shape) and the hemisphere; 90 or 180 degrees have no minutes or seconds. */
+    record Position(int deg, int min, int sec, String hemisphere) {
+        String text(int max) {
+            return (deg == max ? max + " 0 0" : deg + " " + min + " " + sec) + " " + hemisphere;
+        }
+    }
+
+    static Generator<Position> position(int maxDeg, String positive, String negative) {
+        return tuples(ints(0, maxDeg), ints(0, 59), ints(0, 59), sampledFrom(positive, negative)).map(t -> new Position(t.value1(), t.value2(), t.value3(), t.value4()));
+    }
+
+    /** An altitude in centimetres: non-negative, or a whole negative metre count (negative fractions are bug dnsjava/1's shape). */
+    static final Generator<Long> ALTITUDE_CM = weighted(
+        w(70, ints(0, Integer.MAX_VALUE).map(Integer::longValue)),
+        w(30, ints(0, 100000).map(m -> -100L * m)));
+
+    /** A size or precision in centimetres: one digit times a power of ten, as RFC 1876 encodes it. */
+    static final Generator<Long> PRECISION_CM = tuples(ints(0, 9), ints(0, 9)).map(t -> t.value1() * (long) Math.pow(10, t.value2()));
+
+    static String metres(long cm) {
+        return cm < 0 ? String.valueOf(cm / 100) + "m" : (cm / 100) + "." + String.format("%02d", cm % 100) + "m";
+    }
+
+    /** LOC text: latitude, longitude, altitude and up to three of size, horizontal and vertical precision. */
+    static final Generator<String> LOC = tuples(position(90, "N", "S"), position(180, "E", "W"), ALTITUDE_CM, lists(PRECISION_CM).maxSize(3)).map(t -> {
+        List<String> parts = new ArrayList<>(List.of(t.value1().text(90), t.value2().text(180), metres(t.value3())));
+        for (long cm : t.value4()) {
+            parts.add(metres(cm));
+        }
+        return spaced(parts);
+    });
+
+    /** HIP with up to three rendezvous servers, absolute: relative ones are bug dnsjava/12's shape. */
+    static final Generator<String> HIP = seq(U8, HEX_40, B64_60, lists(simpleName(3).map(Name::toString)).maxSize(3).map(Gen::spaced));
+
+    /** An APL item: a negated or plain IPv4 or IPv6 prefix whose address bits beyond the prefix are zero. */
+    record V4Item(boolean negate, int prefix, int hi, int lo) {
+        String text() {
+            long a = ((long) hi << 16) | lo;
+            long mask = prefix == 0 ? 0 : (0xffffffffL << (32 - prefix)) & 0xffffffffL;
+            a &= mask;
+            return (negate ? "!" : "") + "1:" + (a >> 24) + "." + ((a >> 16) & 255) + "." + ((a >> 8) & 255) + "." + (a & 255) + "/" + prefix;
+        }
+    }
+
+    record V6Item(boolean negate, int prefix, List<Integer> groups) {
+        String text() {
+            int[] g = new int[8];
+            for (int i = 0; i < 8; i++) {
+                int bits = Math.max(0, Math.min(16, prefix - 16 * i));
+                int mask = bits == 0 ? 0 : (0xffff << (16 - bits)) & 0xffff;
+                g[i] = groups.get(i) & mask;
+            }
+            if (g[0] == 0 && g[1] == 0 && g[2] == 0 && g[3] == 0 && g[4] == 0 && g[5] == 0xffff) {
+                g[5] = 0xfffe;
+            }
+            return (negate ? "!" : "") + "2:" + groupsText(g) + "/" + prefix;
+        }
+    }
+
+    static final Generator<String> APL_ITEM = weighted(
+        w(60, tuples(chance(30), ints(0, 32), ints(0, 0xffff), ints(0, 0xffff)).map(t -> new V4Item(t.value1(), t.value2(), t.value3(), t.value4()).text())),
+        w(40, tuples(chance(30), ints(0, 128), GROUPS).map(t -> new V6Item(t.value1(), t.value2(), t.value3()).text())));
+
+    static final Generator<String> APL = lists(APL_ITEM).maxSize(4).map(Gen::spaced);
+
+    /** An IPSECKEY gateway: none, an IPv4 or IPv6 address, or a name. */
+    record Gateway(int kind, String text) {}
+
+    static final Generator<Gateway> GATEWAY = Generators.<Gateway>oneOf(
+        just(new Gateway(0, ".")), IPV4.map(a -> new Gateway(1, a)), IPV6.map(a -> new Gateway(2, a)), ABS_NAME.map(n -> new Gateway(3, n)));
+
+    static final Generator<String> IPSECKEY = tuples(U8, GATEWAY, U8, B64_40)
+        .map(t -> t.value1() + " " + t.value2().kind() + " " + t.value3() + " " + t.value2().text() + " " + t.value4());
+
+    static final Generator<String> CERT = seq(U16, U16, U8, B64_60);
+    static final Generator<String> NXT = seq(ABS_NAME, typeList(127));
+
+    /** ZONEMD: the hash length follows the scheme (48 bytes for SHA-384, 64 for SHA-512). */
+    static final Generator<String> ZONEMD = sampledFrom(1, 2).flatMap(alg -> {
+        int len = alg == 1 ? 48 : 64;
+        return tuples(U32, U8, bytes(len, len)).map(t -> t.value1() + " " + t.value2() + " " + alg + " " + hex(t.value3()));
+    });
+
+    /** A WKS port: mostly well-known. */
+    static final Generator<Integer> PORT = weighted(w(80, ints(1, 1024)), w(20, ints(1, 65535)));
+
+    /** WKS: an address, a protocol and one or more distinct ports, ascending: an empty or unsorted list is bug dnsjava/2. */
+    static final Generator<String> WKS = tuples(IPV4, oneOf(just(6), just(17), ints(0, 255)), sets(PORT).minSize(1).maxSize(5)).map(t -> {
+        StringBuilder sb = new StringBuilder(t.value1() + " " + t.value2());
+        for (int p : new TreeSet<>(t.value3())) {
+            sb.append(' ').append(p);
+        }
+        return sb.toString();
+    });
+
+    static final Generator<String> NSAP = bytes(1, 20).map(b -> "0x" + hex(b));
+
+    /** A6: a prefix length, the suffix (absent for 128) and the prefix name (absent for 0). */
+    static final Generator<String> A6 = tuples(ints(0, 128), bytes(16, 16), ABS_NAME)
+        .map(t -> t.value1() + (t.value1() < 128 ? " " + a6Suffix(t.value2(), t.value1()) : "") + (t.value1() > 0 ? " " + t.value3() : ""));
+
+    // ---- SVCB/HTTPS ---------------------------------------------------------------------------------------------
+
+    /** A ServiceMode parameter within the parts of RFC 9460 dnsjava handles faithfully (bugs dnsjava/19-21 cover the rest). */
+    sealed interface Param permits Alpn, NoDefaultAlpn, Port, Ipv4Hint, Ech, Ipv6Hint, Generic {
+        String key();
+
+        String text();
+    }
+
+    record Alpn(List<String> ids) implements Param {
+        @Override
+        public String key() {
+            return "alpn";
+        }
+
+        @Override
+        public String text() {
+            return "alpn=" + String.join(",", ids);
+        }
+    }
+
+    record NoDefaultAlpn() implements Param {
+        @Override
+        public String key() {
+            return "no-default-alpn";
+        }
+
+        @Override
+        public String text() {
+            return "no-default-alpn";
+        }
+    }
+
+    record Port(int port) implements Param {
+        @Override
+        public String key() {
+            return "port";
+        }
+
+        @Override
+        public String text() {
+            return "port=" + port;
+        }
+    }
+
+    record Ipv4Hint(List<String> addresses) implements Param {
+        @Override
+        public String key() {
+            return "ipv4hint";
+        }
+
+        @Override
+        public String text() {
+            return "ipv4hint=" + String.join(",", addresses);
+        }
+    }
+
+    record Ech(byte[] data) implements Param {
+        @Override
+        public String key() {
+            return "ech";
+        }
+
+        @Override
+        public String text() {
+            return "ech=" + b64(data);
+        }
+
+        @Override
+        public String toString() {
+            return "Ech[" + hex(data) + "]";
+        }
+    }
+
+    record Ipv6Hint(List<String> addresses) implements Param {
+        @Override
+        public String key() {
+            return "ipv6hint";
+        }
+
+        @Override
+        public String text() {
+            return "ipv6hint=" + String.join(",", addresses);
+        }
+    }
+
+    /** A private-use key, bare (value null) or with a value. */
+    record Generic(int number, String value) implements Param {
+        @Override
+        public String key() {
+            return "key" + number;
+        }
+
+        @Override
+        public String text() {
+            return value == null ? key() : key() + "=" + value;
+        }
+    }
+
+    /**
+     * The parameters of a ServiceMode record, each present or not (no-default-alpn only beside alpn); the mandatory
+     * list names present keys by index modulo their count; the order picks the rendered parameters by index modulo
+     * what is left, the rest follow in declaration order.
+     */
+    record Params(Alpn alpn, boolean noDefaultAlpn, Port port, Ipv4Hint ipv4, Ech ech, Ipv6Hint ipv6, Generic generic, List<Integer> mandatory) {
+        List<String> render(List<Integer> order) {
+            List<Param> present = new ArrayList<>();
+            if (alpn != null) {
+                present.add(alpn);
+                if (noDefaultAlpn) {
+                    present.add(new NoDefaultAlpn());
+                }
+            }
+            for (Param p : new Param[] {port, ipv4, ech, ipv6, generic}) {
+                if (p != null) {
+                    present.add(p);
+                }
+            }
+            List<String> texts = new ArrayList<>();
+            for (Param p : present) {
+                texts.add(p.text());
+            }
+            if (!present.isEmpty() && !mandatory.isEmpty()) {
+                Set<String> keys = new TreeSet<>();
+                for (int m : mandatory) {
+                    keys.add(present.get(m % present.size()).key());
+                }
+                texts.add(0, "mandatory=" + String.join(",", keys));
+            }
+            List<String> out = new ArrayList<>();
+            for (int i : order) {
+                if (texts.isEmpty()) {
+                    break;
+                }
+                out.add(texts.remove(i % texts.size()));
+            }
+            out.addAll(texts);
+            return out;
+        }
+    }
+
+    /** alpn ids over [a-z0-9-]: escaping is bug dnsjava/19's shape. */
+    static final Generator<Alpn> ALPN = lists(word(LOWER_ALNUM + "-", 1, 6)).minSize(1).maxSize(3).map(Alpn::new);
+
+    /** A private-use key, with a value over [a-z0-9-_./:=] (70%) or bare; spaces in values are bug dnsjava/20's shape. */
+    static final Generator<Generic> GENERIC = tuples(ints(65280, 65534), maybe(70, (String) null, word(LOWER_ALNUM + "-_./:=", 1, 12)))
+        .map(t -> new Generic(t.value1(), t.value2()));
+
+    static final Generator<Params> PARAMS = tuples(
+            maybe(60, (Alpn) null, ALPN),
+            chance(30),
+            maybe(50, (Port) null, ints(0, 65535).map(Port::new)),
+            maybe(40, (Ipv4Hint) null, lists(IPV4).minSize(1).maxSize(3).map(Ipv4Hint::new)),
+            maybe(30, (Ech) null, bytes(1, 30).map(Ech::new)),
+            maybe(40, (Ipv6Hint) null, lists(IPV6).minSize(1).maxSize(2).map(Ipv6Hint::new)),
+            maybe(40, (Generic) null, GENERIC),
+            maybe(30, List.<Integer>of(), lists(Gen.INDEX).minSize(1).maxSize(6)))
+        .map(t -> new Params(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    /** SVCB/HTTPS: AliasMode (priority 0, no parameters) or ServiceMode with parameters in a drawn order. */
+    static final Generator<String> SVCB = weighted(
+        w(15, ABS_NAME.map(n -> "0 " + n)),
+        w(85, tuples(ints(1, 65535), ABS_NAME, PARAMS, lists(ints(0, 7)).maxSize(8))
+            .map(t -> spaced(List.of(String.valueOf(t.value1()), t.value2(), spaced(t.value3().render(t.value4())))))));
+
+    /** The unknown (\#) form: up to 30 bytes. */
+    static final Generator<String> UNKNOWN = bytes(0, 30).map(b -> "\\# " + b.length + (b.length == 0 ? "" : " " + hex(b)));
+
+    // ---- records -----------------------------------------------------------------------------------------------
+
+    /** Types the text/wire round trip covers; the rest of the registry goes through the unknown (\#) form. */
+    static final List<Integer> TYPES = List.of(
+        Type.A, Type.AAAA, Type.NS, Type.CNAME, Type.PTR, Type.DNAME, Type.MX, Type.KX, Type.AFSDB, Type.RT, Type.PX,
+        Type.RP, Type.MINFO, Type.SOA, Type.TXT, Type.SPF, Type.HINFO, Type.ISDN, Type.X25, Type.GPOS, Type.SRV,
+        Type.NAPTR, Type.CAA, Type.URI, Type.TLSA, Type.SMIMEA, Type.SSHFP, Type.DS, Type.CDS, Type.DLV, Type.DNSKEY,
+        Type.CDNSKEY, Type.KEY, Type.RRSIG, Type.SIG, Type.NSEC, Type.NSEC3, Type.NSEC3PARAM, Type.LOC, Type.HIP,
+        Type.APL, Type.IPSECKEY, Type.CERT, Type.NXT, Type.OPENPGPKEY, Type.DHCID, Type.ZONEMD, Type.WKS, Type.NSAP,
+        Type.NSAP_PTR, Type.A6, Type.SVCB, Type.HTTPS, Type.EUI48, Type.EUI64, Type.AMTRELAY, 65280, 65534);
+
+    /** The rdata generator of a type. */
+    static Generator<String> rdata(int type) {
+        return switch (type) {
+            case Type.A -> IPV4;
+            case Type.AAAA -> IPV6;
+            case Type.NS, Type.CNAME, Type.PTR, Type.DNAME, Type.NSAP_PTR -> ABS_NAME;
+            case Type.MX, Type.KX, Type.AFSDB, Type.RT -> PREF_NAME;
+            case Type.PX -> PX;
+            case Type.RP, Type.MINFO -> TWO_NAMES;
+            case Type.SOA -> SOA;
+            case Type.TXT, Type.SPF -> TXT;
+            case Type.HINFO, Type.ISDN -> HINFO;
+            case Type.X25 -> X25;
+            case Type.GPOS -> GPOS;
+            case Type.SRV -> SRV;
+            case Type.NAPTR -> NAPTR;
+            case Type.CAA -> CAA;
+            case Type.URI -> URI;
+            case Type.TLSA, Type.SMIMEA -> TLSA;
+            case Type.SSHFP -> SSHFP;
+            case Type.DS, Type.CDS, Type.DLV -> DS;
+            case Type.DNSKEY, Type.CDNSKEY -> DNSKEY;
+            case Type.KEY -> KEY;
+            case Type.RRSIG, Type.SIG -> RRSIG;
+            case Type.NSEC -> NSEC;
+            case Type.NSEC3 -> NSEC3;
+            case Type.NSEC3PARAM -> NSEC3PARAM;
+            case Type.LOC -> LOC;
+            case Type.HIP -> HIP;
+            case Type.APL -> APL;
+            case Type.IPSECKEY -> IPSECKEY;
+            case Type.CERT -> CERT;
+            case Type.NXT -> NXT;
+            case Type.OPENPGPKEY, Type.DHCID -> B64_80;
+            case Type.ZONEMD -> ZONEMD;
+            case Type.WKS -> WKS;
+            case Type.NSAP -> NSAP;
+            case Type.A6 -> A6;
+            case Type.SVCB, Type.HTTPS -> SVCB;
+            default -> UNKNOWN;
+        };
+    }
+
+    /** A record of one of the given types with rdata of that type. */
+    static Generator<Rdata> rdataOf(Generator<Integer> types) {
+        return types.flatMap(type -> rdata(type).map(text -> new Rdata(type, text)));
+    }
+
+    /** A record of any covered type. */
+    static final Generator<Rdata> RECORD = rdataOf(sampledFrom(TYPES));
+}
