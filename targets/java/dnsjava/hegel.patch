+            Zoo.check(answers.size() == 2 && answers.get(0).equals(r) && answers.get(1).equals(r) && answers.get(0).getTTL() == ttl, () -> what + ": message round trip gave " + answers);
+            Zoo.check(Arrays.equals(back.toWire(), mw), () -> what + ": message wire not stable");
+            // equals/compareTo/hashCode against variants
+            Zoo.check(rUpper.equals(r) && rUpper.hashCode() == r.hashCode() && rUpper.compareTo(r) == 0, () -> what + ": owner case changes equality");
+            Record otherTtl = Record.fromString(owner, g.type(), dclass, ttl == 5 ? 6 : 5, text, Name.root);
+            Zoo.check(otherTtl.equals(r) && otherTtl.sameRRset(r), () -> what + ": TTL takes part in equals");
