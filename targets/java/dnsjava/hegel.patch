+            int best = -1;
+            for (CacheAdd add : c.cache().adds()) {
+                int cred = add.credibility();
+                Record r = Record.fromString(cn, ctype, DClass.IN, add.member().ttl(), add.member().rdata(), Name.root);
+                cache.addRecord(r, cred);
+                if (cred > best) {
+                    best = cred;
+                    byCred.clear();
+                }
+                if (cred == best) {
