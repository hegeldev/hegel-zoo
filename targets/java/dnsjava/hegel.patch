+
+    /** dnsjava/21: SVCB rdata from the wire is not validated (keys out of order are accepted). */
+    @Test
+    void pinSvcbWireValidation() {
+        byte[] rdata = {0, 1, 0, 0, 3, 0, 2, 1, (byte) 0xbb, 0, 1, 0, 3, 2, 'h', '2'}; // port before alpn
+        assertNull(Record.newRecord(N, Type.SVCB, DClass.IN, 0, rdata));
+    }
+
+    /** dnsjava/22: an empty hex field (SSHFP fingerprint) prints as nothing and the text cannot be re-read. */
+    @Test
+    void pinEmptyHexFieldText() throws Exception {
+        Record r = Record.newRecord(N, Type.SSHFP, DClass.IN, 0, new byte[] {1, 1});
+        if (r != null) {
+            assertEquals(r, reparse(r));
+        }
+    }
+
+    /** dnsjava/23: an IPv4-mapped IPv6 gateway is printed as a dotted quad, which the IPv6 field then refuses. */
+    @Test
+    void pinMappedIpv6Text() throws Exception {
+        Record r = rec(Type.IPSECKEY, "10 2 2 ::ffff:192.0.2.1 AQID");
+        assertEquals(r, reparse(r));
+    }
+
+    /** dnsjava/24: a URI target longer than 255 octets is read from the wire but its text cannot be re-read. */
+    @Test
+    void pinUriLongTargetText() throws Exception {
+        byte[] rdata = new byte[4 + 300];
+        rdata[1] = 2;
+        rdata[3] = 2;
+        Arrays.fill(rdata, 4, rdata.length, (byte) 'a');
+        Record r = Record.newRecord(N, Type.URI, DClass.IN, 0, rdata);
+        if (r != null) {
+            assertEquals(r, reparse(r));
+        }
+    }
+
+    /** dnsjava/25: Record.fromString encodes non-ASCII text twice ("café" becomes 7 octets, not 5). */
+    @Test
+    void pinTxtUtf8Once() throws Exception {
+        Record r = rec(Type.TXT, "\"café\"");
+        assertEquals(6, r.rdataToWireCanonical().length, r.rdataToString());
+    }
+
+    /** dnsjava/26: TTL.parse drops trailing digits without a unit ("1h30" parses as 3600). */
+    @Test
+    void pinTtlTrailingDigits() {
+        assertThrows(NumberFormatException.class, () -> TTL.parse("1h30", false));
+        assertThrows(NumberFormatException.class, () -> TTL.parse("5s5", false));
+    }
+
+    // ---- messages, zones, cache
+
+    /** dnsjava/27: Generator.expand() produces one record too few and repeats the first value. */
+    @Test
+    void pinGeneratorExpand() throws Exception {
+        Record[] rs = new Generator(1, 3, 1, "host$", Type.A, DClass.IN, 3600, "10.0.0.$", N).expand();
+        assertEquals(3, rs.length);
+        for (int i = 0; i < 3; i++) {
+            assertEquals(name("host" + (i + 1) + ".example."), rs[i].getName());
+            assertEquals("10.0.0." + (i + 1), rs[i].rdataToString());
+        }
+    }
+
+    /** dnsjava/28: Message.toWire(max) exceeds max when the OPT record does not fit, and toWire(max, false) does not throw. */
+    @Test
+    void pinToWireHonoursMaxWithOpt() throws Exception {
+        Message m = new Message();
+        m.addRecord(new OPTRecord(4096, 0, 0), Section.ADDITIONAL);
+        assertThrows(MessageSizeExceededException.class, () -> m.toWire(12, false));
+        assertTrue(m.toWire(12).length <= 12);
+    }
+
+    /** dnsjava/29: getTSIG() throws IndexOutOfBounds on a truncated message whose ARCOUNT exceeds its records. */
+    @Test
+    void pinGetTsigOnTruncatedMessage() {
+        byte[] wire = {0, 0, 2, 0, 0, 0, 0, 0, 0, 0, 0, 1}; // TC set, ARCOUNT 1, no records
+        Message m;
+        try {
+            m = new Message(wire);
+        } catch (java.io.IOException e) {
+            return; // refusing the message is fine
+        }
+        assertDoesNotThrow(m::getTSIG);
+        assertNull(m.getTSIG());
+    }
+
+    /** dnsjava/30: Zone.removeRecord of a record that is not in the zone removes a single-record RRset anyway. */
+    @Test
+    void pinZoneRemoveNonMember() throws Exception {
+        Name a = name("a.example.");
+        Zone zone = new Zone(N, soa(), ns(), rec(a, Type.A, "192.0.2.1"));
+        zone.removeRecord(rec(a, Type.A, "192.0.2.2"));
+        RRset set = zone.findExactMatch(a, Type.A);
+        assertNotNull(set);
+        assertEquals(1, set.size());
+    }
+
+    /** dnsjava/31: Update(zone, dclass) puts class IN in the zone section regardless of dclass. */
+    @Test
+    void pinUpdateZoneClass() {
+        assertEquals(DClass.CH, new Update(N, DClass.CH).getQuestion().getDClass());
+    }
+
+    /** dnsjava/32: after truncation the compression table still points into dropped records, corrupting the TSIG owner. */
+    @Test
+    void pinTsigAfterTruncation() throws Exception {
+        Name key = name("key.example.com.");
+        TSIG tsig = new TSIG(TSIG.HMAC_SHA256, key, new byte[16]);
+        Message m = new Message(1);
+        m.addRecord(Record.newRecord(name("q.example.com."), Type.A, DClass.IN), Section.QUESTION);
+        for (int i = 1; i <= 5; i++) {
+            m.addRecord(rec(key, Type.A, "192.0.2." + i), Section.ANSWER);
+        }
+        m.setTSIG(tsig, 0, null);
+        int max = 12 + 19 + tsig.recordLength() + 4; // header, question, TSIG: no room for an answer
+        byte[] w = m.toWire(max);
+        Message back = assertDoesNotThrow(() -> new Message(w));
+        assertTrue(back.getHeader().getFlag(Flags.TC));
+        // the TSIG record must have survived parsing (a failed additional record is swallowed when TC is set)
+        assertEquals(1, back.getSection(Section.ADDITIONAL).size());
+        assertEquals(key, back.getSection(Section.ADDITIONAL).get(0).getName());
+        assertEquals(Type.TSIG, back.getSection(Section.ADDITIONAL).get(0).getType());
+    }
+
+    /** dnsjava/33: Cache.addMessage looks at the header rcode only, so a BADVERS response is cached as NXRRSET. */
+    @Test
+    void pinCacheIgnoresExtendedRcode() throws Exception {
+        Name q = name("x.example.");
+        Message m = new Message(1);
+        m.getHeader().setFlag(Flags.QR);
+        m.addRecord(Record.newRecord(q, Type.A, DClass.IN), Section.QUESTION);
+        m.addRecord(soa(), Section.AUTHORITY);
+        m.addRecord(new OPTRecord(4096, 1, 0), Section.ADDITIONAL); // extended rcode 1 -> BADVERS (16)
+        assertEquals(16, m.getRcode());
+        Cache cache = new Cache();
+        cache.addMessage(m);
+        SetResponse sr = cache.lookupRecords(q, Type.A, Credibility.NORMAL);
+        assertFalse(sr.isNXRRSET(), sr.toString());
+        assertTrue(sr.isUnknown(), sr.toString());
+    }
+
+    /** dnsjava/34: ExtendedFlags.CO is 0x8001; RFC 9660 puts the Compact Answers OK bit at 0x4000. */
+    @Test
+    void pinCompactAnswersFlag() {
+        assertEquals(0x4000, ExtendedFlags.CO);
+    }
+
+    /** dnsjava/35: a wildcard synthesizes below an existing (empty non-terminal) closer encloser. */
+    @Test
+    void pinWildcardClosestEncloser() throws Exception {
+        Zone zone = new Zone(N, soa(), ns(), rec(name("*.example."), Type.A, "192.0.2.1"), rec(name("x.sub.example."), Type.A, "192.0.2.2"));
+        SetResponse sr = zone.findRecords(name("y.sub.example."), Type.A);
+        assertTrue(sr.isNXDOMAIN(), sr.toString());
+    }
+
+    /** dnsjava/36: a query at an empty non-terminal answers NXDOMAIN instead of NODATA. */
+    @Test
+    void pinEmptyNonTerminal() throws Exception {
+        Zone zone = new Zone(N, soa(), ns(), rec(name("x.sub.example."), Type.A, "192.0.2.2"));
+        SetResponse sr = zone.findRecords(name("sub.example."), Type.A);
+        assertTrue(sr.isNXRRSET(), sr.toString());
+    }
+
+    /** dnsjava/37: a wildcard match without the queried type answers NXDOMAIN instead of NODATA. */
+    @Test
+    void pinWildcardNoData() throws Exception {
+        Zone zone = new Zone(N, soa(), ns(), rec(name("*.example."), Type.A, "192.0.2.1"));
+        SetResponse sr = zone.findRecords(name("y.example."), Type.TXT);
+        assertTrue(sr.isNXRRSET(), sr.toString());
+    }
+
+    /** dnsjava/38: Cache.addRecord cannot replace a negative entry of equal credibility. */
+    @Test
+    void pinCachePositiveReplacesNegative() throws Exception {
+        Name q = name("x.example.");
+        Cache cache = new Cache();
+        cache.addNegative(q, Type.A, soa(), Credibility.NORMAL);
+        cache.addRecord(rec(q, Type.A, "192.0.2.1"), Credibility.NORMAL);
+        SetResponse sr = cache.lookupRecords(q, Type.A, Credibility.NORMAL);
+        assertTrue(sr.isSuccessful(), sr.toString());
+    }
+
+    /** dnsjava/39: RRset.equals and hashCode depend on insertion order. */
+    @Test
+    void pinRRsetEqualsIgnoresOrder() throws Exception {
+        Record a = rec(Type.A, "192.0.2.1");
+        Record b = rec(Type.A, "192.0.2.2");
+        RRset ab = new RRset(a, b);
+        RRset ba = new RRset(b, a);
+        assertEquals(ab, ba);
+        assertEquals(ab.hashCode(), ba.hashCode());
+    }
+
+    /** dnsjava/40: a $GENERATE width beyond int range is truncated instead of refused. */
+    @Test
+    void pinGeneratorWidthRange() {
+        Generator g = new Generator(1, 1, 1, "host${0,4294967299,d}", Type.A, DClass.IN, 3600, "10.0.0.$", N);
+        assertThrows(Exception.class, g::nextRecord); // nextRecord rather than expand(): expand() has its own bug (dnsjava/27)
+    }
+
+    /** dnsjava/41: ReverseMap.fromName wraps octets above 255 instead of refusing them. */
+    @Test
+    void pinReverseMapOctetRange() {
+        assertThrows(Exception.class, () -> ReverseMap.fromName("999.2.0.192.in-addr.arpa."));
+    }
+
+    /** dnsjava/42: Message.addRecord with an invalid section throws ArrayIndexOutOfBounds. */
+    @Test
+    void pinAddRecordSectionRange() throws Exception {
+        Record r = rec(Type.A, "192.0.2.1");
+        assertThrows(IllegalArgumentException.class, () -> new Message().addRecord(r, 4));
+    }
+
+    /** dnsjava/43: a wire TTL with the high bit set is kept, although text and constructors refuse it (RFC 2181 section 8: treat as 0). */
+    @Test
+    void pinWireTtlHighBit() throws Exception {
+        byte[] wire = {7, 'e', 'x', 'a', 'm', 'p', 'l', 'e', 0, 0, 1, 0, 1, (byte) 0xff, (byte) 0xff, (byte) 0xff, (byte) 0xff, 0, 4, (byte) 192, 0, 2, 1};
+        Record r;
+        try {
+            r = Record.fromWire(wire, Section.ANSWER);
+        } catch (WireParseException e) {
+            return; // refusing it is fine too
+        }
+        assertEquals(0, r.getTTL());
+    }
+
+    /** dnsjava/44: $GENERATE modifiers with one or two fields ("${1}", "${1,3}") are rejected as invalid. */
+    @Test
+    void pinGeneratorShortModifiers() throws Exception {
+        Record one = new Generator(1, 1, 1, "host${1}", Type.A, DClass.IN, 3600, "10.0.0.$", N).nextRecord();
+        assertEquals(name("host2.example."), one.getName());
+        Record two = new Generator(1, 1, 1, "host${1,3}", Type.A, DClass.IN, 3600, "10.0.0.$", N).nextRecord();
+        assertEquals(name("host002.example."), two.getName());
+    }
+
+    /** dnsjava/45: toWire(max, false) throws for any message whose TC flag is already set, even when it fits. */
+    @Test
+    void pinStrictToWireWithPresetTc() throws Exception {
+        Message m = new Message(1);
+        m.getHeader().setFlag(Flags.TC);
+        m.addRecord(Record.newRecord(N, Type.A, DClass.IN), Section.QUESTION);
+        byte[] w = assertDoesNotThrow(() -> m.toWire(512, false));
+        assertEquals(m.toWire().length, w.length);
+    }
+}
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..55cff63
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,120 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.longs;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The combinators the binding lacks: weighted choice, a biased coin, an optional with a probability, int and long
+ * ranges, text over an alphabet ({@code TextGenerator} takes code point ranges, not an alphabet), and a
+ * space-separated sequence of text parts.
+ */
+final class Gen {
+    private Gen() {}
+
+    /** A weighted alternative for {@link #weighted}; the generator may produce a subtype of the choice's type. */
+    record Choice<T>(int weight, Generator<? extends T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<? extends T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    static <T> Generator<T> weighted(List<Choice<T>> choices) {
+        List<Choice<T>> cs = List.copyOf(choices);
+        int total = 0;
+        for (Choice<T> c : cs) {
+            total += c.weight();
+        }
+        return ints(0, total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : cs) {
+                acc += c.weight();
+                if (i < acc) {
+                    return widen(c.gen());
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** A generator of a subtype is a generator of the supertype: it only ever produces values. */
+    @SuppressWarnings("unchecked")
+    static <T> Generator<T> widen(Generator<? extends T> g) {
+        return (Generator<T>) g;
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return ints(0, 99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<? extends T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A long in [lo, hi]; shrinks to lo. */
+    static Generator<Long> longRange(long lo, long hi) {
+        return longs().min(lo).max(hi);
+    }
+
+    /** An index into a live collection, taken modulo its size when applied. */
+    static final Generator<Integer> INDEX = ints(0, 99);
+
+    /** One character of the alphabet (by UTF-16 unit). */
+    static Generator<String> chars(String alphabet) {
+        List<String> cs = new ArrayList<>();
+        for (int i = 0; i < alphabet.length(); i++) {
+            cs.add(String.valueOf(alphabet.charAt(i)));
+        }
+        return sampledFrom(cs);
+    }
+
+    /** A string of lo..hi characters of the alphabet; shrinks to lo characters. */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        return lists(chars(alphabet)).minSize(lo).maxSize(hi).map(Gen::join);
+    }
+
+    static String join(List<String> parts) {
+        return String.join("", parts);
+    }
+
+    /** The non-empty parts joined by single spaces. */
+    static String spaced(List<String> parts) {
+        StringBuilder sb = new StringBuilder();
+        for (String p : parts) {
+            if (!p.isEmpty()) {
+                sb.append(sb.isEmpty() ? "" : " ").append(p);
+            }
+        }
+        return sb.toString();
+    }
+
+    /** The parts drawn in order and joined by single spaces (empty parts are skipped): a presentation-form field list. */
+    @SafeVarargs
+    static Generator<String> seq(Generator<String>... parts) {
+        Generator<String> acc = just("");
+        for (Generator<String> part : parts) {
+            acc = tuples(acc, part).map(t -> spaced(List.of(t.value1(), t.value2())));
+        }
+        return acc;
+    }
+}
