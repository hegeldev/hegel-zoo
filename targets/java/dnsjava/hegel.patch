+                m.addRecord(record(tc, DnsGen.simpleName(tc, 2), Zoo.n(tc, 0, 3600)), Section.ANSWER);
+            }
+            if (Zoo.chance(tc, 30)) {
+                m.addRecord(opt, Section.ADDITIONAL);
+            }
+            m.setTSIG(tsig, Rcode.NOERROR, null);
+            byte[] signed = m.toWire(Message.MAXLENGTH); // toWire() without a length does not sign
+            Message sm = new Message(signed);
+            Zoo.check(sm.getTSIG() != null && sm.getTSIG().getName().equals(keyName) && sm.getTSIG().getAlgorithm().equals(alg), () -> "signed message has TSIG " + flat(sm.getTSIG()));
+            int v = tsig.verify(sm, signed, null);
+            Zoo.check(v == Rcode.NOERROR && sm.isVerified() && sm.isSigned(), () -> "verify of a freshly signed message with " + alg + " = " + Rcode.TSIGstring(v));
+            Zoo.check(sm.getSection(Section.ANSWER).equals(m.getSection(Section.ANSWER)) && sm.getHeader().getCount(Section.ADDITIONAL) == m.getSection(Section.ADDITIONAL).size() + 1 && sm.getSection(Section.ADDITIONAL).get(sm.getSection(Section.ADDITIONAL).size() - 1).getType() == Type.TSIG, () -> "signed message sections " + flat(sm) + " (additional count " + sm.getHeader().getCount(Section.ADDITIONAL) + " for " + m.getSection(Section.ADDITIONAL).size() + " records)");
+            // tampering: a flipped byte in the question or a different key fails verification
+            byte[] tampered = signed.clone();
+            int pos = Zoo.n(tc, 12, 12 + 5);
+            tampered[pos] ^= (byte) (1 << Zoo.n(tc, 0, 7));
+            Message tm;
+            try {
+                tm = new Message(tampered);
+            } catch (Exception e) {
+                tm = null; // a flipped length byte can make it unparseable, which is fine
+            }
+            if (tm != null) {
+                Message ftm = tm;
