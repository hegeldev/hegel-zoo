@@ -0,0 +1,679 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.maybe;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Gen.word;
+
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import java.net.InetAddress;
+import java.net.UnknownHostException;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.security.spec.ECGenParameterSpec;
+import java.time.Duration;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.xbill.DNS.Address;
+import org.xbill.DNS.Cache;
+import org.xbill.DNS.ClientSubnetOption;
+import org.xbill.DNS.CookieOption;
+import org.xbill.DNS.Credibility;
+import org.xbill.DNS.DClass;
+import org.xbill.DNS.DNSKEYRecord;
+import org.xbill.DNS.DNSSEC;
+import org.xbill.DNS.DSRecord;
+import org.xbill.DNS.DnssecAlgorithmOption;
+import org.xbill.DNS.EDNSOption;
+import org.xbill.DNS.ExtendedErrorCodeOption;
+import org.xbill.DNS.ExtendedFlags;
+import org.xbill.DNS.Flags;
+import org.xbill.DNS.GenericEDNSOption;
+import org.xbill.DNS.Header;
+import org.xbill.DNS.Message;
+import org.xbill.DNS.NSIDOption;
+import org.xbill.DNS.Name;
+import org.xbill.DNS.OPTRecord;
+import org.xbill.DNS.RRSIGRecord;
+import org.xbill.DNS.RRset;
+import org.xbill.DNS.Rcode;
+import org.xbill.DNS.Record;
+import org.xbill.DNS.Section;
+import org.xbill.DNS.SetResponse;
+import org.xbill.DNS.TSIG;
+import org.xbill.DNS.TcpKeepaliveOption;
+import org.xbill.DNS.Type;
+import org.xbill.DNS.Update;
+
+/** Messages, EDNS, TSIG, dynamic update, RRsets, the cache and DNSSEC signing against their documented rules. */
+class MessagesTest {
+
+    static final int[] FLAGS = {Flags.QR, Flags.AA, Flags.TC, Flags.RD, Flags.RA, Flags.AD, Flags.CD};
+
+    static String flat(Object o) {
+        return String.valueOf(o).replace("\t", " ").replace("\n", " / ");
+    }
+
+    /** The record of the drawn rdata at the owner, or a plain A record when the text does not parse (the generator's own fault; recordsRoundTripThroughTextAndWire reports those). */
+    static Record parse(Name owner, DnsGen.Rdata rdata, long ttl) throws Exception {
+        try {
+            return Record.fromString(owner, rdata.type(), DClass.IN, ttl, rdata.text(), Name.root);
+        } catch (Exception e) {
+            return Record.fromString(owner, Type.A, DClass.IN, ttl, "192.0.2.1", Name.root);
+        }
+    }
+
+    static int otherType(int type) {
+        return type == Type.A ? Type.TXT : Type.A;
+    }
+
+    // ------------------------------------------------------------------ 1. messages
+
+    /** An owner below the zone: the apex (20%) or a short label, under "sub" 30% of the time; upper-cased 20%, so that compression has something to do. */
+    record OwnerSpec(String label, boolean sub, boolean upper) {
+        Name at(Name zone) {
+            String text = (label.isEmpty() ? "" : label + (sub ? ".sub" : "") + ".") + zone;
+            return DnsGen.name(upper ? text.toUpperCase() : text);
+        }
+    }
+
+    static final Generator<OwnerSpec> OWNER = tuples(maybe(80, "", word("abcxyz", 1, 3)), chance(30), chance(20))
+        .map(t -> new OwnerSpec(t.value1(), t.value2(), t.value3()));
+
+    /** A type with one or two rdatas of it: the members of one RRset. */
+    record Rdatas(int type, List<String> texts) {}
+
+    static final Generator<Rdatas> RDATAS = sampledFrom(DnsGen.TYPES)
+        .flatMap(type -> lists(DnsGen.rdata(type)).minSize(1).maxSize(2).map(texts -> new Rdatas(type, texts)));
+
+    /** An RRset of a section: its owner (null: the previous set's), its members and their TTL. */
+    record RRsetSpec(OwnerSpec owner, Rdatas rdatas, long ttl) {}
+
+    static final Generator<RRsetSpec> RRSET = tuples(maybe(40, (OwnerSpec) null, OWNER), RDATAS, ints(0, 86400).map(Integer::longValue))
+        .map(t -> new RRsetSpec(t.value1(), t.value2(), t.value3()));
+
+    /** A section: the first owner and up to three RRsets. */
+    record SectionSpec(OwnerSpec first, List<RRsetSpec> sets) {
+        List<Record> build(Name zone) throws Exception {
+            List<Record> out = new ArrayList<>();
+            Name owner = first.at(zone);
+            for (RRsetSpec set : sets) {
+                if (set.owner() != null) {
+                    owner = set.owner().at(zone);
+                }
+                for (String text : set.rdatas().texts()) {
+                    out.add(parse(owner, new DnsGen.Rdata(set.rdatas().type(), text), set.ttl()));
+                }
+            }
+            return out;
+        }
+    }
+
+    static final Generator<SectionSpec> SECTION = tuples(OWNER, lists(RRSET).maxSize(3)).map(t -> new SectionSpec(t.value1(), t.value2()));
+
+    record Question(OwnerSpec owner, int type) {}
+
+    static final Generator<Question> QUESTION = tuples(OWNER, sampledFrom(Type.A, Type.AAAA, Type.MX, Type.ANY, Type.TXT)).map(t -> new Question(t.value1(), t.value2()));
+
+    /** The header: an id, which of the seven flags are set, the opcode (QUERY 70%) and the rcode (NOERROR 70%). */
+    record HeaderSpec(int id, List<Boolean> flags, int opcode, int rcode) {}
+
+    static final Generator<HeaderSpec> HEADER = tuples(ints(0, 65535), lists(chance(40)).minSize(7).maxSize(7),
+            weighted(w(70, just(0)), w(30, ints(0, 15))), weighted(w(70, just(Rcode.NOERROR)), w(30, ints(0, 15))))
+        .map(t -> new HeaderSpec(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    // EDNS options
+
+    static EDNSOption ecsOption(int source, int scope, String address) {
+        try {
+            return new ClientSubnetOption(source, scope, Address.truncate(InetAddress.getByName(address), source));
+        } catch (UnknownHostException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    /** A client-subnet option of one family: source and scope prefix lengths (scope zero 60%) and an address truncated to the source. */
+    static Generator<EDNSOption> ecs(int bits, Generator<String> address) {
+        return tuples(ints(0, bits), weighted(w(60, just(0)), w(40, ints(0, bits))), address).map(t -> ecsOption(t.value1(), t.value2(), t.value3()));
+    }
+
+    static final Generator<EDNSOption> ECS = weighted(w(60, ecs(32, DnsGen.IPV4)), w(40, ecs(128, DnsGen.IPV6)));
+
+    static final Generator<EDNSOption> COOKIE = Generators.<EDNSOption>oneOf(
+        DnsGen.bytes(8, 8).map(c -> new CookieOption(c)),
+        tuples(DnsGen.bytes(8, 8), DnsGen.bytes(8, 32)).map(t -> new CookieOption(t.value1(), t.value2())));
+
+    static final Generator<EDNSOption> NSID = DnsGen.bytes(0, 20).map(b -> new NSIDOption(b));
+
+    static final Generator<EDNSOption> KEEPALIVE = weighted(
+        w(30, Generators.<EDNSOption>just(new TcpKeepaliveOption())),
+        w(70, ints(0, 65535).<EDNSOption>map(TcpKeepaliveOption::new)));
+
