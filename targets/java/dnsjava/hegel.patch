+
+    /** dnsjava/18: GPOS validates longitude against the latitude range and vice versa. */
+    @Test
+    void pinGposRanges() throws Exception {
+        assertDoesNotThrow(() -> rec(Type.GPOS, "-100.0 45.0 100.0")); // longitude -100 is fine
+        assertThrows(TextParseException.class, () -> rec(Type.GPOS, "45.0 100.0 0.0")); // latitude 100 is not
+    }
+
+    /** dnsjava/19: SVCB alpn values are unescaped once instead of twice (RFC 9460 section 7.1.1). */
+    @Test
+    void pinSvcbAlpnEscaping() throws Exception {
+        Record r = rec(Type.SVCB, "1 . alpn=\"f\\\\\\\\oo\\\\,bar,h2\"");
