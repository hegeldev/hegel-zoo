+                for (int s = Section.QUESTION; s <= Section.ADDITIONAL; s++) {
+                    List<Record> a = m.getSection(s);
+                    List<Record> b = t.getSection(s);
+                    int fs = s;
+                    Zoo.check(t.getHeader().getCount(s) == b.size(), () -> what + ": truncated count of section " + fs + " is " + t.getHeader().getCount(fs) + " for " + b.size() + " records");
+                    List<Record> aNoOpt = new ArrayList<>(a);
+                    aNoOpt.removeIf(r -> r.getType() == Type.OPT);
+                    List<Record> bNoOpt = new ArrayList<>(b);
+                    bNoOpt.removeIf(r -> r.getType() == Type.OPT);
+                    Zoo.check(bNoOpt.size() <= aNoOpt.size() && aNoOpt.subList(0, bNoOpt.size()).equals(bNoOpt), () -> what + ": truncated section " + fs + " is not a prefix: " + flat(bNoOpt));
