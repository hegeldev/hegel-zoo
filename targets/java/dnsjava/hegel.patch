+            Zoo.check(Zoo.throwsA(IllegalArgumentException.class, () -> set.addRR(Record.fromString(Name.fromString("x." + owner), type, DClass.IN, 1, DnsGen.rdata(tc, type), Name.root))), () -> "a foreign owner joined " + set);
+            Zoo.check(Zoo.throwsA(IllegalArgumentException.class, () -> set.addRR(Record.fromString(owner, type == Type.A ? Type.TXT : Type.A, DClass.IN, 1, DnsGen.rdata(tc, type == Type.A ? Type.TXT : Type.A), Name.root))), () -> "a foreign type joined " + set);
+            Record victim = members.get(Zoo.n(tc, 0, members.size() - 1));
+            set.deleteRR(victim);
+            Zoo.check(set.size() == members.size() - 1 && !set.rrs(false).contains(victim), () -> "deleteRR left " + set);
+            // the cache: positive answers only, two credibility levels
+            Cache cache = new Cache();
+            Name cn = DnsGen.simpleName(tc, 2);
+            int ctype = Zoo.pick(tc, Type.A, Type.TXT);
+            Map<Integer, List<Record>> byCred = new HashMap<>();
+            int best = -1;
+            int adds = Zoo.n(tc, 1, 5);
+            for (int i = 0; i < adds; i++) {
