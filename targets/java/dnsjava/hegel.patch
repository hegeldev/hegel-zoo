+    /** A message survives the wire: header, sections, OPT; truncation keeps whole RRsets, sets TC, respects maxLength. */
+    @Test
+    void messagesRoundTripThroughWire() {
+        Zoo.property("messagesRoundTripThroughWire", tc -> {
+            MessageCase c = tc.draw(MESSAGE_CASE, "case");
+            Name zone = c.zone();
+            Message m = new Message(c.header().id());
+            Header h = m.getHeader();
+            List<Integer> set = new ArrayList<>();
+            for (int i = 0; i < FLAGS.length; i++) {
+                if (c.header().flags().get(i)) {
+                    h.setFlag(FLAGS[i]);
+                    set.add(FLAGS[i]);
+                }
+            }
+            int opcode = c.header().opcode();
+            h.setOpcode(opcode);
+            int rcode = c.header().rcode();
+            h.setRcode(rcode);
+            for (Question q : c.questions()) {
+                m.addRecord(Record.newRecord(q.owner().at(zone), q.type(), DClass.IN), Section.QUESTION);
+            }
+            for (int s = Section.ANSWER; s <= Section.ADDITIONAL; s++) {
+                for (Record r : c.sections().get(s - Section.ANSWER).build(zone)) {
+                    m.addRecord(r, s);
+                }
+            }
+            OPTRecord opt = null;
+            int extRcode = 0;
+            if (c.opt() != null) {
+                extRcode = c.opt().extRcode();
+                opt = c.opt().build();
+                m.addRecord(opt, Section.ADDITIONAL);
+            }
+            boolean tcPreset = set.contains((int) Flags.TC); // the Flags constants are bytes: contains(Flags.TC) would box a Byte
+            byte[] w = m.toWire();
+            Message back = new Message(w);
+            String what = "message " + flat(m);
+            Header hb = back.getHeader();
+            Zoo.check(hb.getID() == h.getID() && hb.getOpcode() == opcode && hb.getRcode() == rcode, () -> what + ": header back " + flat(hb));
+            for (int f : FLAGS) {
+                boolean want = set.contains(f);
+                Zoo.check(hb.getFlag(f) == want, () -> what + ": flag " + Flags.string(f) + " back as " + hb.getFlag(f));
+            }
+            int wantRcode = (extRcode << 4) | rcode;
+            Zoo.check(back.getRcode() == wantRcode && m.getRcode() == wantRcode, () -> what + ": extended rcode " + back.getRcode() + ", expected " + wantRcode);
+            for (int s = Section.QUESTION; s <= Section.ADDITIONAL; s++) {
+                List<Record> a = m.getSection(s);
+                List<Record> b = back.getSection(s);
+                int fs = s;
+                Zoo.check(a.equals(b) && hb.getCount(s) == b.size(), () -> what + ": section " + fs + " back as " + flat(b) + " (count " + hb.getCount(fs) + ")");
+                for (int i = 0; i < Math.min(a.size(), b.size()); i++) {
+                    int fi = i;
+                    Zoo.check(a.get(i).getTTL() == b.get(i).getTTL() && a.get(i).getName().toString().equalsIgnoreCase(b.get(i).getName().toString()), () -> what + ": record " + fi + " of section " + fs + " back as " + flat(b.get(fi)));
+                }
+            }
+            Zoo.check(opt == null ? back.getOPT() == null : opt.equals(back.getOPT()) && back.getOPT().getOptions().equals(opt.getOptions()) && back.getOPT().getPayloadSize() == opt.getPayloadSize() && back.getOPT().getFlags() == opt.getFlags(), () -> what + ": OPT back as " + flat(back.getOPT()));
+            Zoo.check(Arrays.equals(back.toWire(), w), () -> what + ": wire not stable");
+            Zoo.check(w.length <= 65535 && new Message(w).toString().equals(back.toString()), () -> what + ": toString unstable");
+            // findRecord/findRRset/removeRecord agree with the lists
+            for (int s = Section.ANSWER; s <= Section.ADDITIONAL; s++) {
+                for (Record r : m.getSection(s)) {
+                    int fs = s;
+                    Zoo.check(back.findRecord(r, s) && back.findRecord(r) && back.findRRset(r.getName(), r.getType(), s), () -> what + ": findRecord misses " + flat(r) + " in " + fs);
+                }
+            }
+            Message copy = new Message(w);
+            List<Record> answers = new ArrayList<>(copy.getSection(Section.ANSWER));
+            if (!answers.isEmpty()) {
+                Record victim = answers.get(c.victim() % answers.size());
+                Zoo.check(copy.removeRecord(victim, Section.ANSWER) && copy.getSection(Section.ANSWER).size() == answers.size() - 1 && copy.getHeader().getCount(Section.ANSWER) == answers.size() - 1, () -> what + ": removeRecord of " + flat(victim));
+                Zoo.check(new Message(copy.toWire()).getSection(Section.ANSWER).equals(copy.getSection(Section.ANSWER)), () -> what + ": wire after removeRecord");
+            }
+            // truncation
+            int max = c.max().of(w.length);
+            byte[] tw = m.toWire(max);
+            int optLen = opt == null ? 0 : opt.toWire(Section.ADDITIONAL).length;
+            boolean skipLengthCheck = opt != null && max < 12 + optLen; // bug dnsjava/28: OPT is appended even past maxLength
+            boolean tcSet = false;
+            if (max >= w.length) {
+                Zoo.check(Arrays.equals(tw, w), () -> what + ": toWire(" + max + ") changed a fitting message");
+            } else {
+                Message t = new Message(tw);
