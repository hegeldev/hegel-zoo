+/**
+ * One pin per bug in bugs.toml. Each asserts the correct behaviour and fails while the bug exists; the
+ * target's [expected_failures] table lists them, and a pin that starts passing means the bug was fixed.
+ */
+class DnsjavaPinsTest {
+
+    static final Name N = name("example.");
+
+    static Name name(String s) {
+        try {
+            return Name.fromString(s);
+        } catch (TextParseException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    static Record rec(int type, String text) throws Exception {
+        return rec(N, type, text);
+    }
+
+    static Record rec(Name owner, int type, String text) throws Exception {
+        return Record.fromString(owner, type, DClass.IN, 3600, text, Name.root);
+    }
+
+    static Record reparse(Record r) throws Exception {
+        return Record.fromString(r.getName(), r.getType(), r.getDClass(), r.getTTL(), r.rdataToString(), Name.root);
+    }
+
+    static SOARecord soa() {
+        return new SOARecord(N, DClass.IN, 3600, name("ns.example."), name("hostmaster.example."), 1, 7200, 3600, 1209600, 300);
+    }
+
+    static Record ns() throws Exception {
+        return rec(Type.NS, "ns.example.");
+    }
+
+    // ---- records
+
+    /** dnsjava/1: a negative LOC altitude with a fraction is printed as "-99999.-99m". */
+    @Test
+    void pinLocNegativeAltitudeText() throws Exception {
+        Record r = rec(Type.LOC, "42 21 54 N 71 06 18 W -99999.99m 30m 10m 10m");
+        assertTrue(r.rdataToString().contains("-99999.99m"), r.rdataToString());
+        assertEquals(r, reparse(r));
+    }
+
+    /** dnsjava/2: WKS with no services, or with unsorted ports in text, throws ArrayIndexOutOfBounds. */
+    @Test
+    void pinWksEmptyOrUnsortedServices() throws Exception {
+        Record unsorted = rec(Type.WKS, "192.0.2.1 6 80 25");
+        assertDoesNotThrow(() -> unsorted.toWire(Section.ANSWER));
+        assertEquals(Arrays.asList(25, 80), Arrays.stream(((WKSRecord) unsorted).getServices()).boxed().toList());
+        WKSRecord empty = new WKSRecord(N, DClass.IN, 3600, InetAddress.getByName("192.0.2.1"), 6, new int[0]);
+        assertDoesNotThrow(() -> empty.toWire(Section.ANSWER));
+        assertDoesNotThrow(empty::hashCode);
+    }
+
+    /** dnsjava/3: an A6 suffix in IPv4-mapped form breaks toWire and its text cannot be re-read. */
+    @Test
+    void pinA6MappedSuffix() throws Exception {
+        Record r = rec(Type.A6, "64 ::ffff:192.0.2.1 host.example.");
+        assertDoesNotThrow(() -> r.toWire(Section.ANSWER));
+        assertEquals(r, reparse(r));
+    }
+
+    /** dnsjava/4: base64.fromString accepts characters outside the alphabet and decodes garbage. */
+    @Test
+    void pinBase64RejectsForeignCharacters() {
+        assertNull(base64.fromString("AQ.D"));
+        assertNull(base64.fromString("AQI!"));
+    }
+
+    /** dnsjava/5: DNSOutput.writeU8/U16/U32 accept 2^8, 2^16 and 2^32 and write zero. */
+    @Test
+    void pinDnsOutputRejectsPowerOfTwo() {
+        assertThrows(IllegalArgumentException.class, () -> new DNSOutput().writeU8(256));
+        assertThrows(IllegalArgumentException.class, () -> new DNSOutput().writeU16(65536));
+        assertThrows(IllegalArgumentException.class, () -> new DNSOutput().writeU32(4294967296L));
+    }
+
+    /** dnsjava/6: the AAAARecord constructor accepts an IPv4 address and produces 4-byte rdata. */
+    @Test
+    void pinAaaaRefusesIpv4() throws Exception {
+        InetAddress v4 = InetAddress.getByName("192.0.2.1");
+        assertThrows(IllegalArgumentException.class, () -> new AAAARecord(N, DClass.IN, 3600, v4));
+    }
+
+    /** dnsjava/7: an NSEC type bitmap whose window blocks are out of order is accepted and silently re-sorted. */
+    @Test
+    void pinTypeBitmapWindowOrder() {
