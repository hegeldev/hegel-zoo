+                sum += parts.get(i).value() * MULT[us[i]];
+            }
+            return sum;
+        }
+    }
+
+    static final Generator<Ttl> TTL = weighted(
+        w(60, weighted(w(80, ints(0, 86400 * 7)), w(20, ints(0, Integer.MAX_VALUE))).<Ttl>map(v -> new Seconds(v))),
+        w(40, lists(tuples(ints(0, 4), ints(0, 30), chance(30)).map(t -> new UnitPart(t.value1(), t.value2(), t.value3()))).minSize(1).maxSize(3).<Ttl>map(Units::new)));
+
+    static String pad(long v, long width, int base, boolean upper) {
+        String s = base == 8 ? Long.toOctalString(v) : base == 16 ? Long.toHexString(v) : Long.toString(v);
+        if (upper) {
+            s = s.toUpperCase();
+        }
+        StringBuilder sb = new StringBuilder();
+        for (long i = s.length(); i < width; i++) {
+            sb.append('0');
+        }
+        return sb.append(s).toString();
+    }
+
+    /** A $GENERATE substitution spec and its model: "$" or "${offset,width,base}" ("${offset}" and "${offset,width}" are bug dnsjava/44's shape). */
+    record Subst(String spec, long offset, long width, int base, boolean upper) {
+        String apply(long i) {
+            return pad(i + offset, width, base, upper);
+        }
+    }
+
+    static final Subst DOLLAR = new Subst("$", 0, 0, 10, false);
+
+    static Subst subst(int offset, int width, int which) {
+        int base = which == 1 ? 8 : which >= 2 ? 16 : 10;
+        String b = which == 0 ? "d" : which == 1 ? "o" : which == 2 ? "x" : "X";
+        return new Subst("${" + offset + "," + width + "," + b + "}", offset, width, base, which == 3);
+    }
+
+    static final Generator<Subst> SUBST = weighted(
+        w(40, just(DOLLAR)),
+        w(60, tuples(ints(0, 20), ints(0, 5), ints(0, 3)).map(t -> subst(t.value1(), t.value2(), t.value3()))));
+
+    /** A line of the file: a record or a $GENERATE directive. */
+    sealed interface Entry permits Line, Generate {}
+
+    /** The rest of a $GENERATE line: whether the owner and target are written absolute, the third octet of an A target, the TTL (null: the default) and whether "IN" is written. */
+    record GenTail(boolean ownerAbsolute, int octet, boolean targetAbsolute, Ttl ttl, boolean cls) {}
+
+    static final Generator<GenTail> GEN_TAIL = tuples(chance(30), ints(0, 255), chance(50), maybe(50, (Ttl) null, TTL), chance(50))
+        .map(t -> new GenTail(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    /** $GENERATE start-end[/step] host<owner> [ttl] [IN] TYPE target<target>. */
+    record Generate(int start, int span, int step, boolean hideStep, int type, Subst owner, Subst target, GenTail tail) implements Entry {
+        long end() {
+            return start + span;
+        }
+
+        /** The target substitution as it can be written for the type: at most four hex digits in an AAAA group, no padding or wide values in an A octet ("08" is not an octet). */
+        Subst effectiveTarget() {
+            if (type == Type.AAAA && target.width() > 4) {
+                return new Subst("${0,4,x}", 0, 4, 16, false);
+            }
+            if (type == Type.A && (target.base() != 10 || target.width() > 1 || target.offset() + end() > 255)) {
+                return DOLLAR;
+            }
+            return target;
+        }
+
+        String lhs(Name origin) {
+            return "host" + owner.spec() + (tail.ownerAbsolute() ? "." + origin : "");
+        }
+
+        String rhs(Name origin) {
+            Subst rs = effectiveTarget();
+            return switch (type) {
+                case Type.A -> "10.0." + tail.octet() + "." + rs.spec();
+                case Type.AAAA -> "2001:db8::" + rs.spec();
+                default -> "target" + rs.spec() + (tail.targetAbsolute() ? "." + origin : "");
+            };
+        }
+
+        String text(Name origin) {
+            StringBuilder sb = new StringBuilder("$GENERATE ").append(start).append("-").append(end()).append(step == 1 && hideStep ? "" : "/" + step).append(" ").append(lhs(origin)).append(" ");
+            if (tail.ttl() != null) {
+                sb.append(tail.ttl().text()).append(" ");
+            }
+            if (tail.cls()) {
+                sb.append("IN ");
+            }
+            return sb.append(Type.string(type)).append(" ").append(rhs(origin)).append("\n").toString();
+        }
+
+        List<Record> expected(Name origin, long defaultTtl) throws Exception {
+            long ttl = tail.ttl() == null ? defaultTtl : tail.ttl().value();
+            Subst rs = effectiveTarget();
+            List<Record> out = new ArrayList<>();
+            for (long k = start; k <= end(); k += step) {
+                String o = lhs(origin).replace(owner.spec(), owner.apply(k));
+                String r = rhs(origin).replace(rs.spec(), rs.apply(k));
+                out.add(Record.fromString(Name.fromString(o, origin), type, DClass.IN, ttl, r, origin));
+            }
+            return out;
+        }
+    }
+
+    static final Generator<Entry> GENERATE = tuples(ints(0, 30), ints(0, 12), weighted(w(70, just(1)), w(30, ints(1, 5))), chance(50), sampledFrom(GEN_TYPES), SUBST, SUBST, GEN_TAIL)
+        .map(t -> new Generate(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    /** How the owner is written: relative to the origin, absolute (upper-cased 30%), "@", or blank (the previous owner; relative when there is none). */
+    enum OwnerForm { RELATIVE, ABSOLUTE, AT, BLANK }
+
+    record Owner(OwnerForm form, String label, boolean upper) {}
+
+    /** A label over letters, digits and hyphens, not starting or ending with a hyphen. */
+    static final Generator<String> LABEL = word(DnsGen.LOWER_ALNUM + "-", 1, 8).map(l -> l.startsWith("-") || l.endsWith("-") ? "x" + l + "x" : l);
+
+    static final Generator<Owner> OWNER = tuples(sampledFrom(OwnerForm.values()), LABEL, chance(30)).map(t -> new Owner(t.value1(), t.value2(), t.value3()));
+
+    /** The TTL (null: omitted, 40%) and class ("IN", 50%) of a line, their order, and whether the type is written in lower case. */
+    record Fields(Ttl ttl, boolean cls, boolean ttlFirst, boolean lowerType) {}
+
+    static final Generator<Fields> FIELDS = tuples(maybe(60, (Ttl) null, TTL), chance(50), chance(50), chance(20)).map(t -> new Fields(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    /** Rdata in parentheses across lines: whether each token starts a new line (recycled modulo the token count), whether a comment follows it, and whether ")" is on its own line. */
+    record Parens(List<Boolean> breaks, List<Boolean> comments, boolean closeOnNewLine) {}
+
+    static final Generator<Parens> PARENS = tuples(lists(chance(40)).minSize(1).maxSize(8), lists(chance(15)).minSize(1).maxSize(8), chance(30))
+        .map(t -> new Parens(t.value1(), t.value2(), t.value3()));
+
+    /** The whitespace after the owner, the parentheses (null: none, 70%; never around quoted rdata) and a trailing comment (null: none, 70%). */
+    record Layout(String sep, Parens parens, String trailing) {}
+
+    static final Generator<Layout> LAYOUT = tuples(sampledFrom(" ", "\t", "  ", "    "), maybe(30, (Parens) null, PARENS), maybe(30, (String) null, sampledFrom(" ; trailing", ";c", "\t;")))
+        .map(t -> new Layout(t.value1(), t.value2(), t.value3()));
+
+    record Line(Owner owner, DnsGen.Rdata rdata, Fields fields, Layout layout) implements Entry {
+        String text(Name origin, String ownerText) {
+            StringBuilder line = new StringBuilder(ownerText).append(layout.sep());
+            String ttl = fields.ttl() == null ? "" : fields.ttl().text() + " ";
+            String cls = fields.cls() ? "IN " : "";
+            line.append(fields.ttlFirst() ? ttl + cls : cls + ttl);
+            line.append(fields.lowerType() ? Type.string(rdata.type()).toLowerCase() : Type.string(rdata.type())).append(" ");
+            Parens p = layout.parens();
+            if (p != null && !rdata.text().contains("\"")) {
+                String[] toks = rdata.text().split(" ");
+                line.append("(");
+                boolean comment = false;
+                for (int i = 0; i < toks.length; i++) {
+                    line.append(comment || p.breaks().get(i % p.breaks().size()) ? "\n\t" : " ").append(toks[i]);
+                    comment = p.comments().get(i % p.comments().size());
+                    if (comment) {
+                        line.append(" ; inside");
+                    }
+                }
+                line.append(comment || p.closeOnNewLine() ? "\n)" : " )");
+            } else {
+                line.append(rdata.text());
+            }
+            if (layout.trailing() != null) {
+                line.append(layout.trailing());
+            }
+            return line.append("\n").toString();
+        }
+    }
+
+    static final Generator<Entry> LINE = tuples(OWNER, DnsGen.rdataOf(sampledFrom(MASTER_TYPES)), FIELDS, LAYOUT)
+        .map(t -> new Line(t.value1(), t.value2(), t.value3(), t.value4()));
+
+    static final Generator<Entry> ENTRY = weighted(w(85, LINE), w(15, GENERATE));
+
+    /** A master file: the origin, the $TTL line (with a comment 30%), whether $ORIGIN is in the file, a comment line, one to eight entries, and whether the Master gets no origin when the file has one. */
+    record MasterFile(Name origin, Ttl defaultTtl, boolean ttlComment, boolean originInFile, boolean commentLine, List<Entry> entries, boolean omitOrigin) {}
+
+    static final Generator<MasterFile> MASTER_FILE = tuples(ORIGIN, TTL, chance(30), chance(50), chance(30), lists(ENTRY).minSize(1).maxSize(8), chance(50))
+        .map(t -> new MasterFile(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    /** Master files: owners (relative, absolute, @, blank), TTL/class in either order or omitted, parentheses, comments, $GENERATE. */
+    @Test
+    void masterFilesParseLikeTheModel() {
+        Zoo.property("masterFilesParseLikeTheModel", tc -> {
+            MasterFile f = tc.draw(MASTER_FILE, "file");
+            StringBuilder text = new StringBuilder();
+            try {
+                masterFile(f, text);
+            } catch (Exception e) {
+                Zoo.fail("master file property threw " + e + " with the file so far:\n" + text);
+            }
+        });
+    }
+
+    /** Renders the file and the records it should parse to, then checks Master against them. */
+    static void masterFile(MasterFile f, StringBuilder text) throws Exception {
+        Name origin = f.origin();
+        List<Record> expected = new ArrayList<>();
+        long defaultTtl = f.defaultTtl().value();
+        text.append("$TTL ").append(f.defaultTtl().text()).append(f.ttlComment() ? " ; default ttl" : "").append("\n");
+        if (f.originInFile()) {
+            text.append("$ORIGIN ").append(origin).append("\n");
+        }
+        if (f.commentLine()) {
+            text.append("\n; a comment line\n");
+        }
+        Name lastOwner = null;
+        for (Entry e : f.entries()) {
+            switch (e) {
+                case Generate g -> {
+                    text.append(g.text(origin));
+                    expected.addAll(g.expected(origin, defaultTtl));
+                    lastOwner = null; // a blank owner after $GENERATE is unspecified: give the next record an explicit owner
+                }
+                case Line l -> {
+                    Name owner;
+                    String ownerText;
+                    OwnerForm form = l.owner().form() == OwnerForm.BLANK && lastOwner == null ? OwnerForm.RELATIVE : l.owner().form();
+                    String label = l.owner().label();
+                    switch (form) {
+                        case RELATIVE -> {
+                            owner = Name.fromString(label, origin);
+                            ownerText = label;
+                        }
+                        case ABSOLUTE -> {
+                            String abs = Name.fromString(label, origin).toString();
+                            ownerText = l.owner().upper() ? abs.toUpperCase() : abs;
+                            owner = Name.fromString(ownerText);
+                        }
+                        case AT -> {
+                            owner = origin;
+                            ownerText = "@";
+                        }
+                        default -> {
+                            owner = lastOwner;
+                            ownerText = "";
+                        }
+                    }
+                    text.append(l.text(origin, ownerText));
+                    long ttl = l.fields().ttl() == null ? defaultTtl : l.fields().ttl().value();
+                    expected.add(Record.fromString(owner, l.rdata().type(), DClass.IN, ttl, l.rdata().text(), origin));
+                    lastOwner = owner;
+                }
+            }
+        }
+        String file = text.toString();
+        Master master = new Master(new ByteArrayInputStream(file.getBytes(StandardCharsets.UTF_8)), f.originInFile() && f.omitOrigin() ? null : origin);
+        List<Record> got = new ArrayList<>();
+        Record r;
+        try {
+            while ((r = master.nextRecord()) != null) {
+                got.add(r);
+            }
+        } catch (Exception e) {
+            Zoo.fail("master file\n" + file + "threw " + e + " after " + flat(got));
+            return;
+        }
+        // Master reuses the previous record's Name object for an equal owner, so the owner's case may follow the earlier line: compare owners case-insensitively
+        List<String> want = new ArrayList<>();
+        for (Record e : expected) {
+            want.add(recordKey(e));
+        }
+        List<String> have = new ArrayList<>();
+        for (Record g : got) {
+            have.add(recordKey(g));
+        }
+        Zoo.check(have.equals(want), () -> "master file\n" + file + "parsed as\n" + String.join("\n", have) + "\nexpected\n" + String.join("\n", want));
+        // the records re-read from their own text agree
+        StringBuilder again = new StringBuilder("$TTL 1\n");
+        for (Record g : got) {
+            again.append(g).append("\n");
+        }
+        Master m2 = new Master(new ByteArrayInputStream(again.toString().getBytes(StandardCharsets.UTF_8)), Name.root);
+        List<Record> got2 = new ArrayList<>();
+        while ((r = m2.nextRecord()) != null) {
+            got2.add(r);
+        }
+        Zoo.check(got2.equals(got), () -> "re-read of\n" + again + "gave\n" + flat(got2));
+    }
+
+    static String recordKey(Record r) {
+        return r.getName().toString().toLowerCase() + " " + r.getTTL() + " " + DClass.string(r.getDClass()) + " " + Type.string(r.getType()) + " " + r.rdataToString();
+    }
+
+    // ------------------------------------------------------------------ 2. zone lookups
+
+    static final List<Integer> DATA_TYPES = List.of(Type.A, Type.TXT, Type.MX, Type.AAAA);
+
+    /** A data record: its type, TTL and rdata. */
+    record Data(int type, long ttl, String rdata) {
+        Record at(Name owner) throws Exception {
+            return Record.fromString(owner, type, DClass.IN, ttl, rdata, Name.root);
+        }
+    }
+
+    static Generator<Data> data(int type) {
+        return tuples(ints(1, 3600).map(Integer::longValue), DnsGen.rdata(type)).map(t -> new Data(type, t.value1(), t.value2()));
+    }
+
+    /** What a name holds. */
+    sealed interface Kind permits DataSets, Cname, Delegation, Dname, Wildcard {}
+
+    /** One or two RRsets of data records (one or two members each). */
+    record DataSets(List<List<Data>> sets) implements Kind {}
+
+    /** A CNAME to the candidate at the index (modulo their count). */
+    record Cname(int target) implements Kind {}
+
+    /** A delegation: ns.<name>, and a second NS elsewhere half the time. */
+    record Delegation(boolean second) implements Kind {}
+
+    record Dname() implements Kind {}
+
+    /** A wildcard below the name: an A or TXT record and, 30% of the time, one of the other type. */
+    record Wildcard(Data first, Data second) implements Kind {}
+
+    static final Generator<Kind> KIND = weighted(
+        w(40, lists(sampledFrom(DATA_TYPES).flatMap(type -> lists(data(type)).minSize(1).maxSize(2))).minSize(1).maxSize(2).<Kind>map(DataSets::new)),
+        w(10, Gen.INDEX.<Kind>map(Cname::new)),
+        w(20, chance(50).<Kind>map(Delegation::new)),
+        w(10, Generators.<Kind>just(new Dname())),
+        w(20, sampledFrom(Type.A, Type.TXT).flatMap(type -> tuples(data(type), maybe(30, (Data) null, data(type == Type.A ? Type.TXT : Type.A))))
+            .<Kind>map(t -> new Wildcard(t.value1(), t.value2()))));
+
+    /** A name of the zone: the candidate at the index (modulo their count) and what it holds. */
+    record Entry2(int candidate, Kind kind) {}
+
+    static final Generator<Entry2> ZONE_ENTRY = tuples(Gen.INDEX, KIND).map(t -> new Entry2(t.value1(), t.value2()));
+
+    /**
+     * A query: at a name of the model (by index; below a wildcard with the prefix) or at a candidate (with "zz." in
+     * front 30% of the time), for ANY (15%) or one of six types.
+     */
+    record Query(boolean fromModel, int index, String wildPrefix, boolean zz, int qtype) {}
+
+    static final Generator<Query> QUERY = tuples(chance(50), Gen.INDEX, sampledFrom("x", "y", "x.y"), chance(30),
+            weighted(w(15, just(Type.ANY)), w(85, sampledFrom(Type.A, Type.TXT, Type.MX, Type.AAAA, Type.CNAME, Type.NS))))
+        .map(t -> new Query(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    /** A zone: the origin, ns1's address, the apex A record (null: none, 60%), which of the nine "d.<l2>.<l1>" candidates exist, the names, the queries and the record to remove (by index). */
+    record ZoneCase(Name origin, Data ns1, Data apex, List<Boolean> deeper, List<Entry2> entries, List<Query> queries, int victim) {}
+
+    static final Generator<ZoneCase> ZONE_CASE = tuples(sampledFrom("example.", "zone.test.", "z.").map(DnsGen::name), data(Type.A), maybe(40, (Data) null, data(Type.A)),
+            lists(chance(30)).minSize(9).maxSize(9), lists(ZONE_ENTRY).minSize(1).maxSize(7), lists(QUERY).minSize(1).maxSize(6), Gen.INDEX)
+        .map(t -> new ZoneCase(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    static Set<String> rdataSet(RRset set) {
+        return rdataSet(set.rrs(false));
+    }
+
+    static Set<String> rdataSet(List<Record> rs) {
+        Set<String> s = new java.util.TreeSet<>();
+        for (Record r : rs) {
+            s.add(r.getType() + " " + r.rdataToString());
+        }
+        return s;
+    }
+
+    static boolean under(Name nm, Set<Name> parents) {
+        for (Name d : parents) {
+            if (nm.subdomain(d)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean hasBelow(Map<Name, ?> model, Name nm) {
+        for (Name existing : model.keySet()) {
+            if (existing.subdomain(nm) && !existing.equals(nm)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** The zone's model built from a case: the records by name and type, all records in insertion order, and the candidate names. */
+    record Built(Map<Name, Map<Integer, List<Record>>> model, List<Record> all, List<Name> candidates) {}
+
+    static Built build(ZoneCase c) throws Exception {
+        Name origin = c.origin();
+        Map<Name, Map<Integer, List<Record>>> model = new LinkedHashMap<>();
+        List<Record> all = new ArrayList<>();
+        java.util.function.BiConsumer<Name, Record> put = (nm, rec) -> {
+            List<Record> list = model.computeIfAbsent(nm, x -> new TreeMap<>()).computeIfAbsent(rec.getType(), x -> new ArrayList<>());
+            if (!list.contains(rec)) {
+                list.add(rec);
+                all.add(rec);
+            }
+        };
+        Name ns1 = Name.fromString("ns1." + origin);
+        put.accept(origin, Record.fromString(origin, Type.SOA, DClass.IN, 3600, ns1 + " hostmaster." + origin + " 1 7200 3600 1209600 300", Name.root));
+        put.accept(origin, Record.fromString(origin, Type.NS, DClass.IN, 3600, ns1.toString(), Name.root));
+        put.accept(ns1, c.ns1().at(ns1));
+        if (c.apex() != null) {
+            put.accept(origin, c.apex().at(origin));
+        }
+        List<Name> candidates = new ArrayList<>();
+        String[] labels = {"a", "b", "c"};
+        int coin = 0;
+        for (String l1 : labels) {
+            candidates.add(Name.fromString(l1 + "." + origin));
+            for (String l2 : labels) {
+                candidates.add(Name.fromString(l2 + "." + l1 + "." + origin));
+                if (c.deeper().get(coin++)) {
+                    candidates.add(Name.fromString("d." + l2 + "." + l1 + "." + origin));
+                }
+            }
+        }
+        Set<Name> delegated = new HashSet<>();
+        Set<Name> dnamed = new HashSet<>();
+        for (Entry2 e : c.entries()) {
+            Name nm = candidates.get(e.candidate() % candidates.size());
+            if (model.containsKey(nm) || under(nm, delegated) || under(nm, dnamed)) {
+                continue; // taken, or occluded data: not part of the model
+            }
+            switch (e.kind()) {
+                case DataSets d -> {
+                    for (List<Data> set : d.sets()) {
+                        for (Data x : set) {
+                            put.accept(nm, x.at(nm));
+                        }
+                    }
+                }
+                case Cname x -> put.accept(nm, Record.fromString(nm, Type.CNAME, DClass.IN, 300, candidates.get(x.target() % candidates.size()).toString(), Name.root));
+                case Delegation d -> {
+                    if (hasBelow(model, nm)) {
+                        continue;
+                    }
+                    Name ns = Name.fromString("ns." + nm);
+                    put.accept(nm, Record.fromString(nm, Type.NS, DClass.IN, 300, ns.toString(), Name.root));
+                    if (d.second()) {
+                        put.accept(nm, Record.fromString(nm, Type.NS, DClass.IN, 300, "ns2.elsewhere.", Name.root));
+                    }
+                    delegated.add(nm);
+                }
+                case Dname d -> {
+                    if (hasBelow(model, nm)) {
+                        continue;
+                    }
+                    put.accept(nm, Record.fromString(nm, Type.DNAME, DClass.IN, 300, "elsewhere.", Name.root));
+                    dnamed.add(nm);
+                }
+                case Wildcard wc -> {
+                    Name wild = Name.fromString("*." + nm);
+                    put.accept(wild, wc.first().at(wild));
+                    if (wc.second() != null) {
+                        put.accept(wild, wc.second().at(wild));
+                    }
+                }
+            }
+        }
+        return new Built(model, all, candidates);
+    }
+
+    /** The name a query asks for. */
+    static Name queryName(Query q, Built b) throws Exception {
+        if (q.fromModel()) {
+            List<Name> keys = new ArrayList<>(b.model().keySet());
+            Name qn = keys.get(q.index() % keys.size());
+            return qn.isWild() ? Name.fromString(q.wildPrefix() + "." + new Name(qn, 1)) : qn;
+        }
+        Name qn = b.candidates().get(q.index() % b.candidates().size());
+        return q.zz() ? Name.fromString("zz." + qn) : qn;
+    }
+
+    /** Lookups: exact data, NODATA, CNAME, delegations (also below), DNAME, wildcards at the closest encloser, NXDOMAIN. */
+    @Test
+    void zoneLookupsMatchTheModel() {
+        Zoo.property("zoneLookupsMatchTheModel", tc -> {
+            ZoneCase c = tc.draw(ZONE_CASE, "case");
+            Name origin = c.origin();
+            Built b = build(c);
+            Map<Name, Map<Integer, List<Record>>> model = b.model();
+            List<Record> all = b.all();
+            // glue below delegations is allowed and occluded
+            Zone zone = new Zone(origin, all.toArray(new Record[0]));
+            String what = "zone\n" + zone.toMasterFile();
+            // the zone holds exactly the model's records
+            List<Record> inZone = new ArrayList<>();
+            for (java.util.Iterator<RRset> it = zone.iterator(); it.hasNext(); ) {
+                inZone.addAll(it.next().rrs(false));
+            }
+            Zoo.check(inZone.size() == all.size() && new HashSet<>(inZone).equals(new HashSet<>(all)), () -> what + "holds " + flat(inZone) + "\nexpected " + flat(all));
+            Zoo.check(zone.getSOA().equals(all.get(0)) && zone.getOrigin().equals(origin) && zone.getNS().size() == model.get(origin).get(Type.NS).size(), () -> what + "SOA/NS/origin accessors");
+            // queries
+            for (Query q : c.queries()) {
+                Name qn = queryName(q, b);
+                int qt = q.qtype();
+                String expect = model(model, origin, qn, qt);
+                if (expect == null) {
+                    continue; // a known-bug shape (dnsjava/35, 36, 37) or a wildcard CNAME
+                }
+                Name fqn = qn;
+                SetResponse sr = zone.findRecords(qn, qt);
+                String got = describe(sr, qn);
+                Zoo.check(got.equals(expect), () -> what + "query " + fqn + " " + Type.string(qt) + " -> " + got + "\nexpected " + expect);
+            }
+            // removing a member of a set shrinks it, and removing the last member removes the set
+            List<Record> removable = new ArrayList<>();
+            for (Record r : all) {
+                if (r.getType() != Type.SOA && r.getType() != Type.NS) {
+                    removable.add(r);
+                }
+            }
+            if (!removable.isEmpty()) {
+                Record victim = removable.get(c.victim() % removable.size());
+                int before = model.get(victim.getName()).get(victim.getType()).size();
+                zone.removeRecord(victim);
+                RRset after = zone.findExactMatch(victim.getName(), victim.getType());
+                Zoo.check(before == 1 ? after == null : after.size() == before - 1 && !after.rrs(false).contains(victim), () -> what + "after removing " + flat(victim) + ": " + flat(after));
+            }
+            // the master file text re-creates the same zone
+            Zone again = new Zone(origin, new ByteArrayInputStream(zone.toMasterFile().getBytes(StandardCharsets.UTF_8)));
+            List<Record> inAgain = new ArrayList<>();
+            for (java.util.Iterator<RRset> it = again.iterator(); it.hasNext(); ) {
+                inAgain.addAll(it.next().rrs(false));
+            }
+            List<Record> inNow = new ArrayList<>();
+            for (java.util.Iterator<RRset> it = zone.iterator(); it.hasNext(); ) {
+                inNow.addAll(it.next().rrs(false));
+            }
+            Zoo.check(new HashSet<>(inAgain).equals(new HashSet<>(inNow)) && inAgain.size() == inNow.size(), () -> what + "re-read from toMasterFile as " + flat(inAgain));
+        });
+    }
+
+    static String describe(SetResponse sr, Name qn) {
+        if (sr.isNXDOMAIN()) {
+            return "NXDOMAIN";
+        }
+        if (sr.isNXRRSET()) {
+            return "NXRRSET";
+        }
+        if (sr.isDelegation()) {
+            return "DELEGATION " + sr.getNS().getName() + " " + rdataSet(sr.getNS());
+        }
+        if (sr.isCNAME()) {
+            return "CNAME " + sr.getCNAME().getTarget();
+        }
+        if (sr.isDNAME()) {
+            return "DNAME " + sr.getDNAME().getName() + " " + sr.getDNAME().getTarget();
+        }
+        if (sr.isSuccessful()) {
+            TreeMap<Integer, Set<String>> sets = new TreeMap<>();
+            for (RRset set : sr.answers()) {
+                if (!set.getName().equals(qn)) {
+                    return "SUCCESS with owner " + set.getName();
+                }
+                sets.put(set.getType(), rdataSet(set));
+            }
+            return "SUCCESS " + sets;
+        }
+        return "UNKNOWN";
+    }
+
+    /** RFC 1034 §4.3.2 with RFC 4592 wildcards; null = a shape dnsjava is known to get wrong (skipped). */
+    static String model(Map<Name, Map<Integer, List<Record>>> model, Name origin, Name qn, int qt) {
+        int labels = qn.labels();
+        for (int t = origin.labels(); t <= labels; t++) {
+            Name anc = t == labels ? qn : new Name(qn, labels - t);
+            Map<Integer, List<Record>> sets = model.get(anc);
+            if (sets == null) {
+                continue;
+            }
+            if (!anc.equals(origin) && sets.containsKey(Type.NS)) {
+                return "DELEGATION " + anc + " " + rdataSet(sets.get(Type.NS));
+            }
+            if (anc.equals(qn)) {
+                if (qt == Type.ANY) {
+                    TreeMap<Integer, Set<String>> out = new TreeMap<>();
+                    for (Map.Entry<Integer, List<Record>> e : sets.entrySet()) {
+                        out.put(e.getKey(), rdataSet(e.getValue()));
+                    }
+                    return "SUCCESS " + out;
+                }
+                if (sets.containsKey(qt)) {
+                    return "SUCCESS " + new TreeMap<>(Map.of(qt, rdataSet(sets.get(qt))));
+                }
+                if (sets.containsKey(Type.CNAME)) {
+                    return "CNAME " + ((org.xbill.DNS.CNAMERecord) sets.get(Type.CNAME).get(0)).getTarget();
+                }
+                return "NXRRSET";
+            }
+            if (sets.containsKey(Type.DNAME)) {
+                return "DNAME " + anc + " " + ((org.xbill.DNS.DNAMERecord) sets.get(Type.DNAME).get(0)).getTarget();
+            }
+        }
+        // qn does not exist. Empty non-terminal?
+        for (Name existing : model.keySet()) {
+            if (existing.subdomain(qn) && !existing.equals(qn)) {
+                return null; // NODATA at an empty non-terminal: bug dnsjava/36's shape
+            }
+        }
+        // closest encloser: the longest ancestor that exists or is an empty non-terminal
+        Name ce = origin;
+        for (int t = origin.labels(); t < labels; t++) {
+            Name anc = new Name(qn, labels - t);
+            boolean exists = false;
+            for (Name existing : model.keySet()) {
+                if (existing.subdomain(anc)) {
+                    exists = true;
+                }
+            }
+            if (exists) {
+                ce = anc;
+            }
+        }
+        Name wild;
+        try {
+            wild = Name.fromString("*." + ce);
+        } catch (Exception e) {
+            return null;
+        }
+        Map<Integer, List<Record>> wsets = model.get(wild);
+        if (wsets != null) {
+            if (qt == Type.ANY) {
+                TreeMap<Integer, Set<String>> out = new TreeMap<>();
+                for (Map.Entry<Integer, List<Record>> e : wsets.entrySet()) {
+                    out.put(e.getKey(), rdataSet(e.getValue()));
+                }
+                return "SUCCESS " + out;
+            }
+            if (wsets.containsKey(qt)) {
+                return "SUCCESS " + new TreeMap<>(Map.of(qt, rdataSet(wsets.get(qt))));
+            }
+            return null; // NODATA from a wildcard: bug dnsjava/37's shape
+        }
+        // no wildcard at the closest encloser: NXDOMAIN, unless a wildcard higher up would wrongly match (bug dnsjava/35)
+        for (int t = origin.labels(); t < labels; t++) {
+            Name anc = new Name(qn, labels - t);
+            if (!anc.equals(ce)) {
+                try {
+                    if (model.containsKey(Name.fromString("*." + anc))) {
+                        return null;
+                    }
+                } catch (Exception e) {
+                    return null;
+                }
+            }
+        }
+        return "NXDOMAIN";
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..43dff67
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,125 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "\u2026" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+
+    /** Rethrows any throwable unchecked (for control-flow exceptions such as Hegel's that must not be swallowed). */
+    @SuppressWarnings("unchecked")
+    static <T extends Throwable> void sneaky(Throwable t) throws T {
+        throw (T) t;
+    }
+
+    /** A property body that may throw checked exceptions. */
+    interface Body {
+        void run(TestCase tc) throws Exception;
+    }
+
+    /** Runs {@code body} as a Hegel property named {@code name}; checked exceptions escape as they are. */
+    static void property(String name, Body body) {
+        dev.hegel.Hegel.test(tc -> {
+            try {
+                body.run(tc);
+            } catch (Exception e) {
+                Zoo.<RuntimeException>sneaky(e);
+            }
+        }, settings(name));
+    }
+
+    /** Whether {@code t} throws an instance of {@code type} (or, with {@code type} null, anything at all). */
+    static boolean throwsA(Class<? extends Throwable> type, Body0 t) {
+        try {
+            t.run();
+            return false;
+        } catch (Throwable e) {
+            return type == null || type.isInstance(e);
+        }
+    }
+
+    interface Body0 {
+        void run() throws Exception;
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
