+
+    /** dnsjava/20: SVCB values containing spaces are printed unescaped and cannot be re-read. */
+    @Test
+    void pinSvcbValueEscaping() throws Exception {
+        Record r = rec(Type.SVCB, "1 . key999=\"a b\"");
