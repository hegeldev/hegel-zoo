+    /** RFC 4034 section 6.1: compare label by label from the right, unsigned octets, ASCII case folded, shorter label first. */
+    static int canonicalCompare(Name a, Name b) {
+        int la = a.labels();
+        int lb = b.labels();
+        for (int i = 1; i <= Math.min(la, lb); i++) {
+            byte[] x = a.getLabel(la - i);
+            byte[] y = b.getLabel(lb - i);
+            for (int j = 1; j < Math.min(x.length, y.length); j++) {
+                int cx = fold(x[j] & 0xff);
+                int cy = fold(y[j] & 0xff);
+                if (cx != cy) {
+                    return cx < cy ? -1 : 1;
+                }
+            }
+            if (x.length != y.length) {
+                return x.length < y.length ? -1 : 1;
+            }
+        }
+        return Integer.signum(la - lb);
+    }
+
+    static int fold(int c) {
+        return c >= 'A' && c <= 'Z' ? c + 32 : c;
+    }
