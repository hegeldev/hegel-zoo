+            Zoo.check(r5 != null && r5.equals(r) && Arrays.equals(r5.rdataToWireCanonical(), rd), () -> what + ": canonical rdata " + DnsGen.hex(rd) + " rebuilt as " + flat(r5));
+            byte[] cw = r.toWireCanonical();
