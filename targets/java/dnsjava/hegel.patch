+    }
+
+    static String key(Record r, int dclass, long ttl, boolean rdata) {
+        return r.getName() + " " + r.getType() + " " + dclass + " " + ttl + " " + (rdata ? r.rdataToString() : "");
+    }
+
+    // ------------------------------------------------------------------ 4. DNSSEC
+
+    /** The set to sign: its type, one to three rdatas, and one more rdata of the type for the modified set. */
+    record SignSpec(int type, List<String> rdatas, String extra) {}
+
+    static final Generator<SignSpec> SIGN_SPEC = sampledFrom(Type.A, Type.TXT, Type.MX, Type.AAAA).flatMap(type ->
+        tuples(lists(DnsGen.rdata(type)).minSize(1).maxSize(3), DnsGen.rdata(type)).map(t -> new SignSpec(type, t.value1(), t.value2())));
+
+    /** A zone, the signed owner below it (null: the apex, 30%), the set, the inception second, the validity in seconds, and the DS digest type. */
+    record DnssecCase(Name zone, String ownerLabel, SignSpec set, int inception, int validity, int digest) {}
