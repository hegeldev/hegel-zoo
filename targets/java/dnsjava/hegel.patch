+            Name owner = Zoo.chance(tc, 30) ? zone : Name.fromString(Zoo.word(tc, "abc", 1, 3) + "." + zone);
+            int type = Zoo.pick(tc, Type.A, Type.TXT, Type.MX, Type.AAAA);
+            RRset set = new RRset();
+            int k = Zoo.n(tc, 1, 3);
+            for (int i = 0; i < k; i++) {
+                set.addRR(Record.fromString(owner, type, DClass.IN, 300, DnsGen.rdata(tc, type), Name.root));
+            }
+            Instant inception = Instant.ofEpochSecond(Zoo.n(tc, 0, 1000000000));
+            Instant expiration = inception.plusSeconds(Zoo.n(tc, 1, 100000000));
+            Instant now = inception.plusSeconds(1);
