+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for dnsjava, added by the Hegel zoo (targets/java/dnsjava).
+     Runs against the dnsjava:dnsjava artifact that `[run] setup` installs from this checkout
+     into the local Maven repository. Oracles: java.util twins (TreeMap, LinkedHashMap, ArrayList, ArrayDeque) driven
+     by the same operation sequences, and set/count models written in the tests. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>dnsjava-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <dnsjava.version>3.6.6-SNAPSHOT</dnsjava.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>dnsjava</groupId>
+      <artifactId>dnsjava</artifactId>
+      <version>${dnsjava.version}</version>
+    </dependency>
+    <dependency>
+      <!-- independent reader/writer of the RFC 4180 dialects -->
+      <groupId>de.siegmar</groupId>
+      <artifactId>fastcsv</artifactId>
+      <version>4.0.0</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <!-- JSON lines to and from the Python csv oracle -->
+      <groupId>com.google.code.gson</groupId>
+      <artifactId>gson</artifactId>
+      <version>2.13.1</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/DnsGen.java b/hegel/src/test/java/zoo/DnsGen.java
new file mode 100644
index 0000000..9ebac9c
--- /dev/null
+++ b/hegel/src/test/java/zoo/DnsGen.java
@@ -0,0 +1,491 @@
+package zoo;
+
+import dev.hegel.TestCase;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.TreeSet;
+import org.xbill.DNS.Name;
+import org.xbill.DNS.Type;
+
+/**
+ * Generators for dnsjava: names as label models, and records of ~45 types as (type, presentation rdata) pairs whose
+ * text is valid input for {@code Record.fromString}. Known-bug shapes are avoided here and named in the comments.
+ */
+final class DnsGen {
+    private DnsGen() {}
+
+    static final String LDH = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-";
+
+    /** A record in presentation form: the type and the rdata text. */
+    record Rdata(int type, String text) {}
+
+    // ---- bytes and encodings -------------------------------------------------------------------------------------
+
+    static byte[] bytes(TestCase tc, int lo, int hi) {
+        int n = Zoo.n(tc, lo, hi);
+        byte[] b = new byte[n];
+        for (int i = 0; i < n; i++) {
+            b[i] = (byte) (Zoo.chance(tc, 30) ? Zoo.n(tc, 0, 255) : Zoo.n(tc, 0x20, 0x7e));
+        }
+        return b;
+    }
+
+    static String hex(byte[] b) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : b) {
+            sb.append(String.format("%02X", x & 0xff));
+        }
+        return sb.toString();
+    }
+
+    static String b64(byte[] b) {
+        return Base64.getEncoder().encodeToString(b);
+    }
+
+    /** RFC 4648 base32hex, unpadded, as NSEC3 uses it. */
+    static String base32hex(byte[] b) {
+        String alpha = "0123456789ABCDEFGHIJKLMNOPQRSTUV";
+        StringBuilder sb = new StringBuilder();
+        int buffer = 0;
+        int bits = 0;
+        for (byte x : b) {
+            buffer = (buffer << 8) | (x & 0xff);
+            bits += 8;
+            while (bits >= 5) {
+                sb.append(alpha.charAt((buffer >> (bits - 5)) & 31));
+                bits -= 5;
+            }
+        }
+        if (bits > 0) {
+            sb.append(alpha.charAt((buffer << (5 - bits)) & 31));
+        }
+        return sb.toString();
+    }
+
+    /** The master-file character-string form of arbitrary bytes, quoted. */
+    static String quoted(byte[] b) {
+        StringBuilder sb = new StringBuilder("\"");
+        for (byte x : b) {
+            int c = x & 0xff;
+            if (c < 0x20 || c >= 0x7f) {
+                sb.append(String.format("\\%03d", c));
+            } else if (c == '"' || c == '\\') {
+                sb.append('\\').append((char) c);
+            } else {
+                sb.append((char) c);
+            }
+        }
+        return sb.append('"').toString();
+    }
+
+    /** A character-string of 1..max bytes, quoted. */
+    static String charString(TestCase tc, int max) {
+        return quoted(bytes(tc, Zoo.chance(tc, 10) ? 0 : 1, max));
+    }
+
+    static String ipv4(TestCase tc) {
+        return Zoo.n(tc, 0, 255) + "." + Zoo.n(tc, 0, 255) + "." + Zoo.n(tc, 0, 255) + "." + Zoo.n(tc, 0, 255);
+    }
+
+    /** An IPv6 address in full eight-group form (never IPv4-mapped: the ::ffff: family of bugs is pinned). */
+    /** An IPv6 address suffix whose first prefix bits are zero (RFC 2874 section 3.1.1), never IPv4-mapped. */
+    static String a6Suffix(TestCase tc, int prefix) {
+        byte[] b = bytes(tc, 16, 16);
+        for (int bit = 0; bit < prefix; bit++) {
+            b[bit / 8] &= (byte) ~(0x80 >> (bit % 8));
+        }
+        boolean zeroHead = true;
+        for (int i = 0; i < 10; i++) {
+            zeroHead &= b[i] == 0;
+        }
+        if (zeroHead && b[10] == (byte) 0xff && b[11] == (byte) 0xff) {
+            b[11] = 1;
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < 8; i++) {
+            if (i > 0) {
+                sb.append(':');
+            }
+            sb.append(Integer.toHexString(((b[2 * i] & 0xff) << 8) | (b[2 * i + 1] & 0xff)));
+        }
+        return sb.toString();
+    }
+
+    static String ipv6(TestCase tc) {
+        int[] g = new int[8];
+        int zeros = Zoo.n(tc, 0, 8);
+        int start = Zoo.n(tc, 0, 7);
+        for (int i = 0; i < 8; i++) {
+            g[i] = Zoo.chance(tc, 50) ? Zoo.n(tc, 0, 0xffff) : Zoo.n(tc, 0, 3);
+        }
+        for (int i = start; i < Math.min(8, start + zeros); i++) {
+            g[i] = 0;
+        }
+        if (g[0] == 0 && g[1] == 0 && g[2] == 0 && g[3] == 0 && g[4] == 0 && g[5] == 0xffff) {
+            g[5] = 1; // no IPv4-mapped forms
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < 8; i++) {
+            if (i > 0) {
+                sb.append(':');
+            }
+            sb.append(Integer.toHexString(g[i]));
+        }
+        return sb.toString();
+    }
+
+    // ---- names --------------------------------------------------------------------------------------------------
+
+    /** A label as bytes: mostly letters/digits/hyphens, sometimes anything (escaped in the text form). */
+    static byte[] label(TestCase tc) {
+        if (Zoo.chance(tc, 80)) {
+            return Zoo.word(tc, LDH, 1, Zoo.chance(tc, 5) ? 63 : 8).getBytes(StandardCharsets.US_ASCII);
+        }
+        return bytes(tc, 1, Zoo.chance(tc, 5) ? 63 : 6);
+    }
+
+    /** The presentation form of a label: RFC 1035 escapes for everything a tokenizer or Name parser treats specially. */
+    static String labelText(byte[] label) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : label) {
+            int c = x & 0xff;
+            if (c <= 0x20 || c >= 0x7f) {
+                sb.append(String.format("\\%03d", c));
+            } else if ("\"().;\\@$".indexOf(c) >= 0) {
+                sb.append('\\').append((char) c);
+            } else {
+                sb.append((char) c);
+            }
+        }
+        return sb.toString();
+    }
+
+    /** An absolute name of 1..depth simple LDH labels plus a final dot; never longer than 255 octets. */
+    static Name simpleName(TestCase tc, int depth) {
+        int n = Zoo.n(tc, 1, depth);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < n; i++) {
+            sb.append(Zoo.word(tc, "abcdefghijklmnopqrstuvwxyz0123456789", 1, 8)).append('.');
+        }
+        try {
+            return Name.fromString(sb.toString());
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    static String absName(TestCase tc) {
+        return Zoo.chance(tc, 5) ? "." : simpleName(tc, 4).toString();
+    }
+
+    // ---- records -----------------------------------------------------------------------------------------------
+
+    /** Types the text/wire round trip covers; the rest of the registry goes through the unknown (\#) form. */
+    static final int[] TYPES = {
+        Type.A, Type.AAAA, Type.NS, Type.CNAME, Type.PTR, Type.DNAME, Type.MX, Type.KX, Type.AFSDB, Type.RT, Type.PX,
+        Type.RP, Type.MINFO, Type.SOA, Type.TXT, Type.SPF, Type.HINFO, Type.ISDN, Type.X25, Type.GPOS, Type.SRV,
+        Type.NAPTR, Type.CAA, Type.URI, Type.TLSA, Type.SMIMEA, Type.SSHFP, Type.DS, Type.CDS, Type.DLV, Type.DNSKEY,
+        Type.CDNSKEY, Type.KEY, Type.RRSIG, Type.SIG, Type.NSEC, Type.NSEC3, Type.NSEC3PARAM, Type.LOC, Type.HIP,
+        Type.APL, Type.IPSECKEY, Type.CERT, Type.NXT, Type.OPENPGPKEY, Type.DHCID, Type.ZONEMD, Type.WKS, Type.NSAP,
+        Type.NSAP_PTR, Type.A6, Type.SVCB, Type.HTTPS, Type.EUI48, Type.EUI64, Type.AMTRELAY, 65280, 65534
+    };
+
+    static Rdata record(TestCase tc) {
+        int type = TYPES[Zoo.n(tc, 0, TYPES.length - 1)];
+        return new Rdata(type, rdata(tc, type));
+    }
+
+    static String u16(TestCase tc) {
+        return String.valueOf(Zoo.n(tc, 0, 65535));
+    }
+
+    static String u8(TestCase tc) {
+        return String.valueOf(Zoo.n(tc, 0, 255));
+    }
+
+    static String u32(TestCase tc) {
+        return String.valueOf(Zoo.chance(tc, 20) ? 4294967295L - Zoo.n(tc, 0, 1000) : Zoo.n(tc, 0, Integer.MAX_VALUE));
+    }
+
+    /** A sorted, duplicate-free type list for NSEC/NSEC3 bitmaps, at most one entry per window, all below 65536. */
+    static String typeList(TestCase tc, int max) {
+        TreeSet<Integer> ts = new TreeSet<>();
+        int n = Zoo.n(tc, 0, 6);
+        for (int i = 0; i < n; i++) {
+            ts.add(Zoo.chance(tc, 70) ? Zoo.n(tc, 1, 60) : Zoo.n(tc, 1, max));
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int t : ts) {
+            sb.append(' ').append(Type.string(t));
+        }
+        return sb.toString();
+    }
+
+    static String sigTime(TestCase tc) {
+        // 1971..2100, in YYYYMMDDHHmmSS; SIGBase writes the epoch second as u32, so nothing before 1970 or past 2106
+        return String.format("%04d%02d%02d%02d%02d%02d", Zoo.n(tc, 1971, 2100), Zoo.n(tc, 1, 12), Zoo.n(tc, 1, 28),
+                Zoo.n(tc, 0, 23), Zoo.n(tc, 0, 59), Zoo.n(tc, 0, 59));
+    }
+
+    static String rdata(TestCase tc, int type) {
+        switch (type) {
+            case Type.A:
+                return ipv4(tc);
+            case Type.AAAA:
+                return ipv6(tc);
+            case Type.NS:
+            case Type.CNAME:
+            case Type.PTR:
+            case Type.DNAME:
+            case Type.NSAP_PTR:
+                return absName(tc);
+            case Type.MX:
+            case Type.KX:
+            case Type.AFSDB:
+            case Type.RT:
+                return u16(tc) + " " + absName(tc);
+            case Type.PX:
+                return u16(tc) + " " + absName(tc) + " " + absName(tc);
+            case Type.RP:
+            case Type.MINFO:
+                return absName(tc) + " " + absName(tc);
+            case Type.SOA:
+                return absName(tc) + " " + absName(tc) + " " + u32(tc) + " " + u32(tc) + " " + u32(tc) + " " + u32(tc) + " " + u32(tc);
+            case Type.TXT:
+            case Type.SPF: {
+                int n = Zoo.n(tc, 1, 4);
+                StringBuilder sb = new StringBuilder();
+                for (int i = 0; i < n; i++) {
+                    sb.append(i > 0 ? " " : "").append(charString(tc, Zoo.chance(tc, 5) ? 255 : 20));
+                }
+                return sb.toString();
+            }
+            case Type.HINFO:
+            case Type.ISDN:
+                return charString(tc, 20) + " " + charString(tc, 20);
+            case Type.X25:
+                return quoted(Zoo.word(tc, "0123456789", 1, 20).getBytes(StandardCharsets.US_ASCII));
+            case Type.GPOS:
+                // GPOS validates longitude against +-90 and latitude against +-180 (bug dnsjava/19): stay within +-90
+                return "\"" + (Zoo.n(tc, -9000, 9000) / 100.0) + "\" \"" + (Zoo.n(tc, -9000, 9000) / 100.0) + "\" \"" + (Zoo.n(tc, -100000, 100000) / 10.0) + "\"";
+            case Type.SRV:
+                return u16(tc) + " " + u16(tc) + " " + u16(tc) + " " + absName(tc);
+            case Type.NAPTR:
+                return u16(tc) + " " + u16(tc) + " " + charString(tc, 8) + " " + charString(tc, 20) + " " + charString(tc, 30) + " " + absName(tc);
+            case Type.CAA:
+                // the tag is printed unquoted (bug dnsjava/15): letters and digits only, as RFC 8659 requires anyway
+                return Zoo.pick(tc, "0", "128", u8(tc)) + " " + Zoo.word(tc, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", 1, 15) + " " + charString(tc, 100);
+            case Type.URI:
+                return u16(tc) + " " + u16(tc) + " " + charString(tc, 100);
+            case Type.TLSA:
+            case Type.SMIMEA:
+                return u8(tc) + " " + u8(tc) + " " + u8(tc) + " " + hex(bytes(tc, 1, 40));
+            case Type.SSHFP:
+                return u8(tc) + " " + u8(tc) + " " + hex(bytes(tc, 1, 40));
+            case Type.DS:
+            case Type.CDS:
+            case Type.DLV: {
+                int digest = Zoo.pick(tc, 0, 1, 2, 4, 9);
+                int len = digest == 1 ? 20 : digest == 2 ? 32 : digest == 4 ? 48 : Zoo.n(tc, 1, 40);
+                return u16(tc) + " " + u8(tc) + " " + digest + " " + hex(bytes(tc, len, len));
+            }
+            case Type.DNSKEY:
+            case Type.CDNSKEY:
+                return Zoo.pick(tc, "256", "257", "0", u16(tc)) + " 3 " + u8(tc) + " " + b64(bytes(tc, 1, 80));
+            case Type.KEY:
+                // numeric flags below 0xC000: NOKEY (0xC000) with key data is another writer/reader asymmetry
+                return Zoo.n(tc, 0, 0xbfff) + " " + u8(tc) + " " + u8(tc) + " " + b64(bytes(tc, 1, 40));
+            case Type.RRSIG:
+            case Type.SIG:
+                return Type.string(Zoo.n(tc, 1, 65535)) + " " + u8(tc) + " " + u8(tc) + " " + Zoo.n(tc, 0, Integer.MAX_VALUE) + " " + sigTime(tc) + " " + sigTime(tc) + " " + u16(tc) + " " + absName(tc) + " " + b64(bytes(tc, 1, 80));
+            case Type.NSEC:
+                return absName(tc) + typeList(tc, 65535);
+            case Type.NSEC3: {
+                byte[] salt = bytes(tc, 0, 8);
+                return "1 " + Zoo.pick(tc, "0", "1") + " " + u16(tc) + " " + (salt.length == 0 ? "-" : hex(salt)) + " " + base32hex(bytes(tc, 1, 32)) + typeList(tc, 65535);
+            }
+            case Type.NSEC3PARAM: {
+                byte[] salt = bytes(tc, 0, 8);
+                return "1 " + Zoo.pick(tc, "0", "1") + " " + u16(tc) + " " + (salt.length == 0 ? "-" : hex(salt));
+            }
+            case Type.LOC:
+                return loc(tc);
+            case Type.HIP: {
+                StringBuilder sb = new StringBuilder(u8(tc) + " " + hex(bytes(tc, 1, 40)) + " " + b64(bytes(tc, 1, 60)));
+                int n = Zoo.n(tc, 0, 3);
+                for (int i = 0; i < n; i++) {
+                    sb.append(' ').append(simpleName(tc, 3)); // absolute: relative rendezvous servers are bug dnsjava/13
+                }
+                return sb.toString();
+            }
+            case Type.APL: {
+                int n = Zoo.n(tc, 0, 4);
+                StringBuilder sb = new StringBuilder();
+                for (int i = 0; i < n; i++) {
+                    boolean v4 = Zoo.chance(tc, 60);
+                    int prefix = Zoo.n(tc, 0, v4 ? 32 : 128);
+                    sb.append(i > 0 ? " " : "").append(Zoo.chance(tc, 30) ? "!" : "").append(v4 ? "1:" : "2:")
+                            .append(v4 ? maskedV4(tc, prefix) : maskedV6(tc, prefix)).append('/').append(prefix);
+                }
+                return sb.toString();
+            }
+            case Type.IPSECKEY: {
+                int gw = Zoo.n(tc, 0, 3);
+                String g = gw == 0 ? "." : gw == 1 ? ipv4(tc) : gw == 2 ? ipv6(tc) : absName(tc);
+                return u8(tc) + " " + gw + " " + u8(tc) + " " + g + " " + b64(bytes(tc, 1, 40));
+            }
+            case Type.CERT:
+                return u16(tc) + " " + u16(tc) + " " + u8(tc) + " " + b64(bytes(tc, 1, 60));
+            case Type.NXT:
+                return absName(tc) + typeList(tc, 127);
+            case Type.OPENPGPKEY:
+            case Type.DHCID:
+                return b64(bytes(tc, 1, 80));
+            case Type.ZONEMD: {
+                int alg = Zoo.pick(tc, 1, 2);
+                return u32(tc) + " " + u8(tc) + " " + alg + " " + hex(bytes(tc, alg == 1 ? 48 : 64, alg == 1 ? 48 : 64));
+            }
+            case Type.WKS: {
+                // one or more ports, ascending: an empty or unsorted list is bug dnsjava/2
+                TreeSet<Integer> ports = new TreeSet<>();
+                int n = Zoo.n(tc, 1, 5);
+                for (int i = 0; i < n; i++) {
+                    ports.add(Zoo.chance(tc, 80) ? Zoo.n(tc, 1, 1024) : Zoo.n(tc, 1, 65535));
+                }
+                StringBuilder sb = new StringBuilder(ipv4(tc) + " " + Zoo.pick(tc, 6, 17, Zoo.n(tc, 0, 255)));
+                for (int p : ports) {
+                    sb.append(' ').append(p);
+                }
+                return sb.toString();
+            }
+            case Type.NSAP:
+                return "0x" + hex(bytes(tc, 1, 20));
+            case Type.A6: {
+                int prefix = Zoo.n(tc, 0, 128);
+                return prefix + (prefix < 128 ? " " + a6Suffix(tc, prefix) : "") + (prefix > 0 ? " " + absName(tc) : "");
+            }
+            case Type.SVCB:
+            case Type.HTTPS:
+                return svcb(tc);
+            default:
+                return unknown(tc);
+        }
+    }
+
+    static String maskedV4(TestCase tc, int prefix) {
+        long a = ((long) Zoo.n(tc, 0, 0xffff) << 16) | Zoo.n(tc, 0, 0xffff);
+        long mask = prefix == 0 ? 0 : (0xffffffffL << (32 - prefix)) & 0xffffffffL;
+        a &= mask;
+        return (a >> 24) + "." + ((a >> 16) & 255) + "." + ((a >> 8) & 255) + "." + (a & 255);
+    }
+
+    static String maskedV6(TestCase tc, int prefix) {
+        int[] g = new int[8];
+        for (int i = 0; i < 8; i++) {
+            int bits = Math.max(0, Math.min(16, prefix - 16 * i));
+            int mask = bits == 0 ? 0 : (0xffff << (16 - bits)) & 0xffff;
+            g[i] = Zoo.n(tc, 0, 0xffff) & mask;
+        }
+        if (g[0] == 0 && g[1] == 0 && g[2] == 0 && g[3] == 0 && g[4] == 0 && g[5] == 0xffff) {
+            g[5] = 0xfffe;
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < 8; i++) {
+            sb.append(i > 0 ? ":" : "").append(Integer.toHexString(g[i]));
+        }
+        return sb.toString();
+    }
+
+    /** LOC text with whole seconds and whole-metre negative altitudes (bugs dnsjava/1 and /8 cover the rest). */
+    static String loc(TestCase tc) {
+        int latDeg = Zoo.n(tc, 0, 90);
+        int lonDeg = Zoo.n(tc, 0, 180);
+        String lat = latDeg == 90 ? "90 0 0" : latDeg + " " + Zoo.n(tc, 0, 59) + " " + Zoo.n(tc, 0, 59);
+        String lon = lonDeg == 180 ? "180 0 0" : lonDeg + " " + Zoo.n(tc, 0, 59) + " " + Zoo.n(tc, 0, 59);
+        long altCm = Zoo.chance(tc, 30) ? -100L * Zoo.n(tc, 0, 100000) : Zoo.n(tc, 0, Integer.MAX_VALUE) % 4284967295L;
+        String alt = altCm < 0 ? String.valueOf(altCm / 100) : (altCm / 100) + "." + String.format("%02d", altCm % 100);
+        StringBuilder sb = new StringBuilder(lat + " " + Zoo.pick(tc, "N", "S") + " " + lon + " " + Zoo.pick(tc, "E", "W") + " " + alt + "m");
+        int extras = Zoo.n(tc, 0, 3);
+        for (int i = 0; i < extras; i++) {
+            long cm = (long) Zoo.n(tc, 0, 9) * (long) Math.pow(10, Zoo.n(tc, 0, 9));
+            sb.append(' ').append(cm / 100).append('.').append(String.format("%02d", cm % 100)).append('m');
+        }
+        return sb.toString();
+    }
+
+    /** SVCB/HTTPS rdata within the parts of RFC 9460 dnsjava handles faithfully (bugs dnsjava/20-22 cover the rest). */
+    static String svcb(TestCase tc) {
+        int priority = Zoo.chance(tc, 15) ? 0 : Zoo.n(tc, 1, 65535);
+        StringBuilder sb = new StringBuilder(priority + " " + absName(tc));
+        if (priority == 0) {
+            return sb.toString();
+        }
+        List<String> keys = new ArrayList<>();
+        List<String> params = new ArrayList<>();
+        boolean alpn = Zoo.chance(tc, 60);
+        if (alpn) {
+            int n = Zoo.n(tc, 1, 3);
+            StringBuilder ids = new StringBuilder();
+            for (int i = 0; i < n; i++) {
+                ids.append(i > 0 ? "," : "").append(Zoo.word(tc, "abcdefghijklmnopqrstuvwxyz0123456789-", 1, 6));
+            }
+            keys.add("alpn");
+            params.add("alpn=" + ids);
+            if (Zoo.chance(tc, 30)) {
+                keys.add("no-default-alpn");
+                params.add("no-default-alpn");
+            }
+        }
+        if (Zoo.chance(tc, 50)) {
+            keys.add("port");
+            params.add("port=" + Zoo.n(tc, 0, 65535));
+        }
+        if (Zoo.chance(tc, 40)) {
+            int n = Zoo.n(tc, 1, 3);
+            StringBuilder ips = new StringBuilder();
+            for (int i = 0; i < n; i++) {
+                ips.append(i > 0 ? "," : "").append(ipv4(tc));
+            }
+            keys.add("ipv4hint");
+            params.add("ipv4hint=" + ips);
+        }
+        if (Zoo.chance(tc, 30)) {
+            keys.add("ech");
+            params.add("ech=" + b64(bytes(tc, 1, 30)));
+        }
+        if (Zoo.chance(tc, 40)) {
+            int n = Zoo.n(tc, 1, 2);
+            StringBuilder ips = new StringBuilder();
+            for (int i = 0; i < n; i++) {
+                ips.append(i > 0 ? "," : "").append(ipv6(tc));
+            }
+            keys.add("ipv6hint");
+            params.add("ipv6hint=" + ips);
+        }
+        if (Zoo.chance(tc, 40)) {
+            String key = "key" + Zoo.n(tc, 65280, 65534);
+            keys.add(key);
+            params.add(Zoo.chance(tc, 30) ? key : key + "=" + Zoo.word(tc, "abcdefghijklmnopqrstuvwxyz0123456789-_./:=", 1, 12));
+        }
+        if (!keys.isEmpty() && Zoo.chance(tc, 30)) {
+            TreeSet<String> mandatory = new TreeSet<>();
+            int n = Zoo.n(tc, 1, keys.size());
+            for (int i = 0; i < n; i++) {
+                mandatory.add(keys.get(Zoo.n(tc, 0, keys.size() - 1)));
+            }
+            params.add(0, "mandatory=" + String.join(",", mandatory));
+        }
+        // the parameters may come in any order in the presentation form
+        while (!params.isEmpty()) {
+            sb.append(' ').append(params.remove(Zoo.n(tc, 0, params.size() - 1)));
+        }
+        return sb.toString();
+    }
+
+    static String unknown(TestCase tc) {
+        byte[] b = bytes(tc, 0, 30);
+        return "\\# " + b.length + (b.length == 0 ? "" : " " + hex(b));
+    }
+}
