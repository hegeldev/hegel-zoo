+            Zoo.check(sig.getTypeCovered() == type && sig.getFootprint() == dnskey.getFootprint() && sig.getSigner().equals(zone) && sig.getLabels() == owner.labels() - 1 && sig.getOrigTTL() == 300, () -> "RRSIG fields " + flat(sig));
