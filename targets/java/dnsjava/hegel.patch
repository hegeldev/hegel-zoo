+
+    /** dnsjava/33: Cache.addMessage looks at the header rcode only, so a BADVERS response is cached as NXRRSET. */
+    @Test
+    void pinCacheIgnoresExtendedRcode() throws Exception {
+        Name q = name("x.example.");
