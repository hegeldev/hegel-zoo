+package com.github.benmanes.caffeine.cache;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+
+import java.util.concurrent.Callable;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.ScheduledFuture;
+import java.util.concurrent.ScheduledThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import org.junit.jupiter.api.Test;
+
+/** One pin per recorded bug (bugs.toml). Each asserts the documented behaviour and fails while the bug exists. */
+class CaffeinePinsTest {
+
+    /** caffeine/1 */
+    @Test
+    void schedulerIgnoresARejectedSubmission() {
+        // "this implementation will ignore scheduling the task if the executor was shutdown or the submission was rejected"
+        var pool = new ScheduledThreadPoolExecutor(1) {
+            @Override public ScheduledFuture<?> schedule(Runnable command, long delay, TimeUnit unit) {
+                throw new RejectedExecutionException("saturated");
+            }
+            @Override public <V> ScheduledFuture<V> schedule(Callable<V> callable, long delay, TimeUnit unit) {
+                throw new RejectedExecutionException("saturated");
+            }
+        };
+        try {
+            Scheduler scheduler = Scheduler.forScheduledExecutorService(pool);
+            assertDoesNotThrow(() -> scheduler.schedule(Runnable::run, () -> {}, 1, TimeUnit.SECONDS));
+        } finally {
+            pool.shutdownNow();
+        }
+    }
+}
diff --git a/hegel/tests/src/test/java/com/github/benmanes/caffeine/cache/InternalsTest.java b/hegel/tests/src/test/java/com/github/benmanes/caffeine/cache/InternalsTest.java
