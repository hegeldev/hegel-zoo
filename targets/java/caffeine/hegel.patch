+import org.junit.jupiter.api.Test;
+import org.mockito.Mockito;
+
+/** The package-private data structures: the hierarchical timer wheel, the frequency sketch and the linked deques. */
+class InternalsTest {
+
+    /** A node with plain fields for every order the structures link through. */
+    static final class TestNode extends Node<Integer, Integer> {
+        final int id;
+        long variableTime;
+        long scheduledAt; // the wheel's clock when the test last scheduled it (a past time lands in the current bucket)
+        long accessTime;
+        long writeTime;
+        Node<Integer, Integer> prevVar, nextVar, prevAccess, nextAccess, prevWrite, nextWrite;
+
+        TestNode(int id, long variableTime) { this.id = id; this.variableTime = variableTime; }
+
+        @Override public Integer getKey() { return id; }
+        @Override public Object getKeyReference() { return id; }
+        @Override public Object getKeyReferenceOrNull() { return id; }
+        @Override public Integer getValue() { return -id; }
+        @Override public Object getValueReference() { return -id; }
+        @Override public void setValue(Integer value, ReferenceQueue<Integer> referenceQueue) {}
+        @Override public boolean containsValue(Object value) { return Integer.valueOf(-id).equals(value); }
+        @Override public boolean isAlive() { return true; }
+        @Override public boolean isRetired() { return false; }
+        @Override public boolean isDead() { return false; }
+        @Override public void retire() {}
+        @Override public void die() {}
+        @Override public long getVariableTime() { return variableTime; }
+        @Override public void setVariableTime(long t) { variableTime = t; }
+        @Override public boolean casVariableTime(long expect, long update) {
+            if (variableTime == expect) { variableTime = update; return true; }
+            return false;
+        }
+        @Override public Node<Integer, Integer> getPreviousInVariableOrder() { return prevVar; }
+        @Override public void setPreviousInVariableOrder(Node<Integer, Integer> p) { prevVar = p; }
+        @Override public Node<Integer, Integer> getNextInVariableOrder() { return nextVar; }
+        @Override public void setNextInVariableOrder(Node<Integer, Integer> p) { nextVar = p; }
+        @Override public long getAccessTime() { return accessTime; }
+        @Override public void setAccessTime(long t) { accessTime = t; }
+        @Override public Node<Integer, Integer> getPreviousInAccessOrder() { return prevAccess; }
+        @Override public void setPreviousInAccessOrder(Node<Integer, Integer> p) { prevAccess = p; }
+        @Override public Node<Integer, Integer> getNextInAccessOrder() { return nextAccess; }
+        @Override public void setNextInAccessOrder(Node<Integer, Integer> p) { nextAccess = p; }
+        @Override public long getWriteTime() { return writeTime; }
+        @Override public void setWriteTime(long t) { writeTime = t; }
+        @Override public boolean casWriteTime(long expect, long update) {
+            if (writeTime == expect) { writeTime = update; return true; }
+            return false;
+        }
+        @Override public Node<Integer, Integer> getPreviousInWriteOrder() { return prevWrite; }
+        @Override public void setPreviousInWriteOrder(Node<Integer, Integer> p) { prevWrite = p; }
+        @Override public Node<Integer, Integer> getNextInWriteOrder() { return nextWrite; }
+        @Override public void setNextInWriteOrder(Node<Integer, Integer> p) { nextWrite = p; }
+    }
+
+    static final long TICK = TimerWheel.SPANS[0];
+
+    /**
+     * Timers fire no earlier than their time; after an advance every remaining timer is either in the future or
+     * still inside the current finest bucket (the wheel expires whole buckets, so a timer can be up to one tick
+     * late); no timer is lost or duplicated, deschedule removes, and the iterators visit everything once.
+     */
+    @Test
+    void timerWheelExpiresByBucketAndNeverEarly() {
+        property("timerWheelExpiresByBucketAndNeverEarly", tc -> {
+            @SuppressWarnings("unchecked")
+            BoundedLocalCache<Integer, Integer> cache = Mockito.mock(BoundedLocalCache.class);
+            List<TestNode> evicted = new ArrayList<>();
+            long[] evictedAt = {0};
+            when(cache.evictEntry(any(), any(), anyLong())).thenAnswer(inv -> {
+                TestNode node = inv.getArgument(0);
+                evicted.add(node);
+                check(node.variableTime <= evictedAt[0], () -> "timer " + node.id + " at " + node.variableTime + " fired at " + evictedAt[0] + " (early by " + (node.variableTime - evictedAt[0]) + " ns)");
+                check(inv.getArgument(1) == RemovalCause.EXPIRED, () -> "cause " + inv.getArgument(1));
+                return true;
+            });
+            var wheel = new TimerWheel<Integer, Integer>();
+            long now = chance(tc, 20) ? ln(tc, -10L * TimerWheel.SPANS[4], 0) : ln(tc, 0, 1L << 50);
+            wheel.nanos = now;
+            Map<Integer, TestNode> scheduled = new HashMap<>();
+            int id = 0;
+            int steps = n(tc, 1, 40);
+            for (int s = 0; s < steps; s++) {
+                int count = n(tc, 0, 6);
+                for (int i = 0; i < count; i++) {
+                    long delay = switch (n(tc, 0, 3)) {
+                        case 0 -> ln(tc, -TICK, 2 * TICK);          // around the current tick (also the past)
+                        case 1 -> ln(tc, 0, TimerWheel.SPANS[2]);   // minutes
+                        case 2 -> ln(tc, 0, TimerWheel.SPANS[3]);   // hours
+                        default -> ln(tc, 0, 20L * TimerWheel.SPANS[4]); // months
+                    };
+                    TestNode node = new TestNode(id++, now + delay);
+                    node.scheduledAt = now;
+                    wheel.schedule(node);
+                    scheduled.put(node.id, node);
+                }
+                if (!scheduled.isEmpty() && chance(tc, 25)) {
+                    TestNode victim = scheduled.remove(scheduled.keySet().iterator().next());
+                    wheel.deschedule(victim);
+                    check(victim.nextVar == null && victim.prevVar == null, () -> "deschedule left links on " + victim.id);
+                }
+                if (!scheduled.isEmpty() && chance(tc, 25)) {
+                    TestNode moved = scheduled.values().iterator().next();
+                    moved.variableTime = now + ln(tc, -TICK, 3 * TimerWheel.SPANS[1]);
+                    moved.scheduledAt = now;
+                    wheel.reschedule(moved);
+                }
+                long delayHint = wheel.getExpirationDelay();
+                long at = now;
+                check(delayHint > 0, () -> "getExpirationDelay " + delayHint + " at " + at);
+                long step = switch (n(tc, 0, 4)) {
+                    case 0 -> ln(tc, 0, TICK / 4);
+                    case 1 -> ln(tc, 0, 4 * TICK);
+                    case 2 -> ln(tc, 0, TimerWheel.SPANS[2]);
+                    case 3 -> delayHint == Long.MAX_VALUE ? TICK : delayHint;
+                    default -> ln(tc, 0, 3 * TimerWheel.SPANS[4]);
+                };
+                if (now > Long.MAX_VALUE - step) {
+                    break;
+                }
+                now += step;
+                evictedAt[0] = now;
+                int before = evicted.size();
+                wheel.advance(cache, now, Integer.MAX_VALUE);
+                for (int i = before; i < evicted.size(); i++) {
+                    TestNode node = evicted.get(i);
+                    check(scheduled.remove(node.id) != null, () -> "timer " + node.id + " fired although not scheduled (twice?)");
+                }
+                // what remains: in the future, or due but still in the current finest bucket
+                Set<Integer> seen = new java.util.HashSet<>();
+                for (Node<Integer, Integer> node : wheel) {
+                    TestNode t = (TestNode) node;
+                    check(seen.add(t.id), () -> "iterator visited timer " + t.id + " twice");
+                    check(scheduled.containsKey(t.id), () -> "timer " + t.id + " in the wheel but not scheduled");
+                    long finalNow = now;
+                    // due timers may only remain in the current finest bucket: placed there by their own time, or
+                    // by the clock when they were scheduled already in the past
+                    long bucketTime = t.variableTime <= t.scheduledAt ? t.scheduledAt : t.variableTime;
+                    check(t.variableTime > now || (bucketTime >>> TimerWheel.SHIFT[0]) == (now >>> TimerWheel.SHIFT[0]),
+                        () -> "timer " + t.id + " at " + t.variableTime + " is " + (finalNow - t.variableTime) + " ns overdue at " + finalNow + " (" + TimeUnit.NANOSECONDS.toSeconds(finalNow - t.variableTime) + " s)");
+                }
+                check(seen.equals(scheduled.keySet()), () -> "wheel holds " + seen + " but scheduled " + scheduled.keySet());
+                Set<Integer> desc = new java.util.HashSet<>();
+                for (Iterator<Node<Integer, Integer>> it = wheel.descendingIterator(); it.hasNext();) {
+                    desc.add(((TestNode) it.next()).id);
+                }
+                check(desc.equals(seen), () -> "descendingIterator visits " + desc + " vs " + seen);
+            }
+        });
+    }
+
+    /** A count-min sketch never under-counts before it is reset, saturates at 15 and is monotone. */
+    @Test
+    void frequencySketchNeverUndercountsBeforeAReset() {
+        property("frequencySketchNeverUndercountsBeforeAReset", tc -> {
+            var sketch = new FrequencySketch();
+            check(sketch.frequency(1) == 0, "uninitialised frequency is 0");
+            sketch.increment(1);
+            check(sketch.isNotInitialized(), "increment before ensureCapacity initialised the sketch");
+            long capacity = chance(tc, 20) ? ln(tc, 0, 5) : ln(tc, 1, 1 << 12);
+            sketch.ensureCapacity(capacity);
+            check(!sketch.isNotInitialized(), "ensureCapacity did not initialise");
+            check(sketch.table.length >= Math.min(Math.max(capacity, 256), Integer.MAX_VALUE >>> 1) / 2, () -> "table length " + sketch.table.length + " for " + capacity);
+            Map<Integer, Integer> counts = new HashMap<>();
+            int universe = n(tc, 1, 50);
+            int increments = n(tc, 0, Math.min(2000, Math.max(1, sketch.sampleSize - 1)));
+            for (int i = 0; i < increments; i++) {
+                int e = chance(tc, 30) ? n(tc, 0, 3) : n(tc, 0, universe);
+                int before = sketch.frequency(e);
+                sketch.increment(e);
+                counts.merge(e, 1, Integer::sum);
+                int after = sketch.frequency(e);
+                check(after >= before, () -> "frequency(" + e + ") fell from " + before + " to " + after);
+                check(after <= 15, () -> "frequency(" + e + ") = " + after + " > 15");
+            }
+            check(sketch.size == increments || sketch.size >= 0, "size");
+            for (var en : counts.entrySet()) {
+                int f = sketch.frequency(en.getKey());
+                int want = Math.min(15, en.getValue());
+                check(f >= want, () -> "frequency(" + en.getKey() + ") = " + f + " after " + en.getValue() + " increments, no reset (size " + sketch.size + " of " + sketch.sampleSize + ")");
+            }
+            // a reset halves every counter (rounding down), so the bound halves too
+            sketch.reset();
+            for (var en : counts.entrySet()) {
+                int f = sketch.frequency(en.getKey());
+                int want = Math.min(15, en.getValue()) / 2;
+                check(f >= want, () -> "frequency(" + en.getKey() + ") = " + f + " after a reset, at least " + want + " expected");
+            }
+            // growing keeps the table; shrinking below the table length is a no-op
+            int len = sketch.table.length;
+            sketch.ensureCapacity(capacity / 2);
+            check(sketch.table.length == len, "ensureCapacity with a smaller size replaced the table");
+        });
+    }
+
+    /** The access-order deque behaves like an ArrayDeque of the same nodes (identity), with its extras. */
+    @Test
+    void linkedDequeAgreesWithArrayDeque() {
+        property("linkedDequeAgreesWithArrayDeque", tc -> {
+            boolean access = chance(tc, 50);
+            LinkedDeque<Node<Integer, Integer>> deque = access ? new AccessOrderDeque<>() : new WriteOrderDeque<>();
+            ArrayDeque<Node<Integer, Integer>> model = new ArrayDeque<>();
+            List<TestNode> pool = new ArrayList<>();
+            for (int i = 0; i < n(tc, 1, 8); i++) {
+                pool.add(new TestNode(i, 0));
+            }
+            int ops = n(tc, 1, 60);
+            for (int i = 0; i < ops; i++) {
+                TestNode x = pool.get(n(tc, 0, pool.size() - 1));
+                boolean present = model.contains(x);
+                String op;
+                switch (n(tc, 0, 13)) {
+                    case 0 -> { op = "offerLast"; boolean r = deque.offerLast(x); check(r == !present, () -> "offerLast returned " + r + " present=" + present); if (!present) model.offerLast(x); }
+                    case 1 -> { op = "offerFirst"; boolean r = deque.offerFirst(x); check(r == !present, () -> "offerFirst returned " + r + " present=" + present); if (!present) model.offerFirst(x); }
+                    case 2 -> { op = "add"; boolean r = deque.add(x); check(r == !present, () -> "add returned " + r); if (!present) model.addLast(x); }
+                    case 3 -> { op = "remove(o)"; boolean r = deque.remove(x); check(r == present, () -> "remove(o) returned " + r + " present=" + present); model.remove(x); }
+                    case 4 -> { op = "poll"; var r = deque.poll(); var w = model.poll(); check(r == w, () -> "poll " + id(r) + " vs " + id(w)); }
+                    case 5 -> { op = "pollLast"; var r = deque.pollLast(); var w = model.pollLast(); check(r == w, () -> "pollLast " + id(r) + " vs " + id(w)); }
+                    case 6 -> { op = "moveToBack"; if (present) { deque.moveToBack(x); model.remove(x); model.addLast(x); } }
+                    case 7 -> { op = "moveToFront"; if (present) { deque.moveToFront(x); model.remove(x); model.addFirst(x); } }
+                    case 8 -> { op = "push/pop"; if (!model.isEmpty()) { var r = deque.pop(); var w = model.pop(); check(r == w, () -> "pop " + id(r) + " vs " + id(w)); } else { deque.push(x); model.push(x); } }
+                    case 9 -> { op = "iterator.remove"; if (present) { for (Iterator<Node<Integer, Integer>> it = deque.iterator(); it.hasNext();) { if (it.next() == x) { it.remove(); break; } } model.remove(x); } }
+                    case 10 -> { op = "removeFirstOccurrence"; boolean r = deque.removeFirstOccurrence(x); check(r == present, () -> "removeFirstOccurrence returned " + r); model.remove(x); }
+                    case 11 -> { op = "clear"; if (chance(tc, 20)) { deque.clear(); model.clear(); } }
+                    case 12 -> { op = "removeAll"; List<Node<Integer, Integer>> some = List.of(x, pool.get(n(tc, 0, pool.size() - 1))); boolean r = deque.removeAll(some); boolean w = model.removeAll(some); check(r == w, () -> "removeAll returned " + r + " vs " + w); }
+                    default -> { op = "addLast"; if (!present) { deque.addLast(x); model.addLast(x); } else { boolean threw = false; try { deque.addLast(x); } catch (IllegalArgumentException e) { threw = true; } check(threw, "addLast of a linked node did not throw IllegalArgumentException"); } }
+                }
+                String finalOp = op;
+                check(deque.size() == model.size(), () -> finalOp + ": size " + deque.size() + " vs " + model.size());
+                check(deque.isEmpty() == model.isEmpty(), () -> finalOp + ": isEmpty");
+                List<Integer> got = ids(deque.iterator());
+                List<Integer> want = ids(model.iterator());
+                check(got.equals(want), () -> finalOp + ": " + got + " vs " + want);
+                List<Integer> gotDesc = ids(deque.descendingIterator());
+                List<Integer> wantDesc = ids(model.descendingIterator());
+                check(gotDesc.equals(wantDesc), () -> finalOp + ": descending " + gotDesc + " vs " + wantDesc);
+                check(deque.peekFirst() == model.peekFirst() && deque.peekLast() == model.peekLast(), () -> finalOp + ": peeks");
+                check(deque.peek() == model.peek(), () -> finalOp + ": peek");
+                for (TestNode p : pool) {
+                    check(deque.contains(p) == model.contains(p), () -> finalOp + ": contains(" + p.id + ")");
+                    check(deque.isFirst(p) == (model.peekFirst() == p), () -> finalOp + ": isFirst(" + p.id + ")");
+                    check(deque.isLast(p) == (model.peekLast() == p), () -> finalOp + ": isLast(" + p.id + ")");
+                }
+                if (model.isEmpty()) {
+                    boolean threw = false;
+                    try { deque.getFirst(); } catch (java.util.NoSuchElementException e) { threw = true; }
+                    check(threw, "getFirst on an empty deque did not throw");
+                } else {
+                    check(deque.getFirst() == model.getFirst() && deque.getLast() == model.getLast() && deque.element() == model.element(), () -> finalOp + ": getFirst/getLast/element");
+                }
+                // the unlinked nodes carry no stale links
+                for (TestNode p : pool) {
+                    if (!model.contains(p)) {
+                        boolean clean = access ? (p.prevAccess == null && p.nextAccess == null) : (p.prevWrite == null && p.nextWrite == null);
+                        check(clean, () -> finalOp + ": removed node " + p.id + " still has links");
+                    }
+                }
+            }
+        });
+    }
+
+    static String id(Node<Integer, Integer> n) { return n == null ? "null" : Integer.toString(((TestNode) n).id); }
+
+    static List<Integer> ids(Iterator<? extends Node<Integer, Integer>> it) {
+        List<Integer> out = new ArrayList<>();
+        while (it.hasNext()) {
+            out.add(((TestNode) it.next()).id);
+        }
+        return out;
+    }
+
+    static <T> Set<T> identitySet() {
+        return java.util.Collections.newSetFromMap(new IdentityHashMap<>());
+    }
+}
