+            ArrayDeque<Node<Integer, Integer>> model = new ArrayDeque<>();
+            List<TestNode> pool = new ArrayList<>();
+            for (int i = 0; i < dc.poolSize(); i++) {
+                pool.add(new TestNode(i, 0));
+            }
+            for (DequeOp op : dc.ops()) {
+                switch (op) {
+                    case Poll o -> { var r = deque.poll(); var w = model.poll(); check(r == w, () -> "poll " + id(r) + " vs " + id(w)); }
