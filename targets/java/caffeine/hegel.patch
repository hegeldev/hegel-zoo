+                            }
+                        }
+                    }
+                    case IteratorRemove o -> {
+                        Integer k = o.k();
+                        String old = model.get(k);
+                        for (Iterator<Map.Entry<Integer, String>> it = map.entrySet().iterator(); it.hasNext();) {
+                            var en = it.next();
+                            if (en.getKey().equals(k)) { it.remove(); model.remove(k); expected.add(new Event(k, old, RemovalCause.EXPLICIT)); break; }
+                        }
+                    }
+                    case ReplaceAll o -> { map.replaceAll((kk, ov) -> ov + "!"); for (var en : new ArrayList<>(model.entrySet())) { expected.add(new Event(en.getKey(), en.getValue(), RemovalCause.REPLACED)); model.put(en.getKey(), en.getValue() + "!"); } }
+                    case Clear o -> { map.clear(); for (var en : model.entrySet()) expected.add(new Event(en.getKey(), en.getValue(), RemovalCause.EXPLICIT)); model.clear(); }
+                    case InvalidateAll o -> { cache.invalidateAll(); for (var en : model.entrySet()) expected.add(new Event(en.getKey(), en.getValue(), RemovalCause.EXPLICIT)); model.clear(); }
+                    case KeySetRetainAll o -> { Set<Integer> keep = o.keep(); boolean r = map.keySet().retainAll(keep); boolean w = false; for (var it = model.entrySet().iterator(); it.hasNext();) { var en = it.next(); if (!keep.contains(en.getKey())) { expected.add(new Event(en.getKey(), en.getValue(), RemovalCause.EXPLICIT)); it.remove(); w = true; } } boolean fw = w; check(r == fw, () -> "retainAll returned " + r + " vs " + fw); }
+                    case PutSameInstance o -> { Integer k = o.k(); if (model.get(k) != null) { String same = map.get(k); String r = map.put(k, same); check(r == same, () -> "put of the same instance returned " + r); /* no notification for an identical value */ } }
+                    case ValuesRemoveAll o -> { Set<String> drop = new HashSet<>(List.of(o.v(), "v0")); boolean r = map.values().removeAll(drop); boolean w = false; for (var it = model.entrySet().iterator(); it.hasNext();) { var en = it.next(); if (drop.contains(en.getValue())) { expected.add(new Event(en.getKey(), en.getValue(), RemovalCause.EXPLICIT)); it.remove(); w = true; } } boolean fw = w; check(r == fw, () -> "values.removeAll returned " + r + " vs " + fw); }
+                    case KeySetRemoveAll o -> { Set<Integer> drop = new HashSet<>(List.of(o.k(), o.k2())); boolean r = map.keySet().removeAll(drop); boolean w = false; for (Integer d : drop) { String old = model.remove(d); if (old != null) { expected.add(new Event(d, old, RemovalCause.EXPLICIT)); w = true; } } boolean fw = w; check(r == fw, () -> "keySet.removeAll returned " + r + " vs " + fw); }
+                }
+                String fop = op.toString();
+                // the view equals the model in every respect a Map promises
+                check(map.size() == model.size() && map.isEmpty() == model.isEmpty(), () -> kind + " " + fop + ": size " + map.size() + " vs " + model.size());
+                check(map.equals(model) && model.equals(map), () -> kind + " " + fop + ": equals " + map + " vs " + model);
+                check(map.hashCode() == model.hashCode(), () -> kind + " " + fop + ": hashCode");
+                check(new HashMap<>(map).equals(model), () -> kind + " " + fop + ": copy " + new HashMap<>(map) + " vs " + model);
+                check(map.keySet().equals(model.keySet()) && map.entrySet().equals(model.entrySet()), () -> kind + " " + fop + ": keySet/entrySet");
+                check(new ArrayList<>(map.values()).size() == model.size() && new HashSet<>(map.values()).equals(new HashSet<>(model.values())), () -> kind + " " + fop + ": values");
+                for (int j = 0; j <= 12; j++) {
+                    int fj = j;
+                    check(map.containsKey(j) == model.containsKey(j), () -> kind + " " + fop + ": containsKey(" + fj + ")");
+                    check(map.containsValue("v" + (j % 6)) == model.containsValue("v" + (j % 6)), () -> kind + " " + fop + ": containsValue");
+                }
+                check(cache.estimatedSize() == model.size(), () -> kind + " " + fop + ": estimatedSize " + cache.estimatedSize() + " vs " + model.size());
+                Map<Integer, String> present = cache.getAllPresent(model.keySet());
+                check(present.equals(model), () -> kind + " " + fop + ": getAllPresent " + present + " vs " + model);
+                check(map.toString().length() == model.toString().length(), () -> kind + " " + fop + ": toString " + map + " vs " + model);
+                // notifications so far: same multiset
+                List<Event> pending = new ArrayList<>(expected);
+                List<Event> extra = new ArrayList<>();
+                for (Event e : events) {
+                    if (!pending.remove(e)) extra.add(e);
+                }
+                check(extra.isEmpty(), () -> kind + " " + fop + ": unexpected removal notifications " + extra + " (expected " + expected + ")");
+                check(pending.isEmpty(), () -> kind + " " + fop + ": missing removal notifications " + pending + " (got " + events + ")");
+                events.clear();
+                expected.clear();
+            }
+            // the unsupported operations
+            boolean threw = false;
+            try { map.entrySet().add(Map.entry(1, "x")); } catch (UnsupportedOperationException e) { threw = true; }
+            check(threw, kind + ": entrySet().add did not throw UnsupportedOperationException");
+            for (Integer key : List.of(1, 2)) {
+                boolean npe = false;
+                try { map.put(key, null); } catch (NullPointerException e) { npe = true; }
+                check(npe, kind + ": put(k, null) did not throw NullPointerException");
+            }
+        });
+    }
+}
