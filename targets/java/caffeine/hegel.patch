+    // ---- frequency sketch --------------------------------------------------------------------------------------
+
+    /** The sketch's capacity: 1..4096, or (20%) 0..5. */
+    static final Generator<Long> CAPACITY = weighted(w(80, longs(1, 1 << 12)), w(20, longs(0, 5)));
+
+    /**
+     * The capacity, the universe of elements (0..universe, the first four three times in ten) and up to 2000 increments
+     * over it; the sketch's own sample size caps how many are applied, so that no reset happens.
+     */
+    record SketchCase(long capacity, int universe, List<Integer> increments) {}
+
+    static final Generator<SketchCase> SKETCH_CASE = tuples(CAPACITY, ints(1, 50)).flatMap(t ->
+            lists(weighted(w(70, ints(0, t.value2())), w(30, ints(0, 3)))).maxSize(2000).map(l -> new SketchCase(t.value1(), t.value2(), l)));
+
+    /** A count-min sketch never under-counts before it is reset, saturates at 15 and is monotone. */
+    @Test
+    void frequencySketchNeverUndercountsBeforeAReset() {
+        property("frequencySketchNeverUndercountsBeforeAReset", tc -> {
+            SketchCase sc = tc.draw(SKETCH_CASE, "case");
+            var sketch = new FrequencySketch();
+            check(sketch.frequency(1) == 0, "uninitialised frequency is 0");
+            sketch.increment(1);
+            check(sketch.isNotInitialized(), "increment before ensureCapacity initialised the sketch");
+            long capacity = sc.capacity();
+            sketch.ensureCapacity(capacity);
+            check(!sketch.isNotInitialized(), "ensureCapacity did not initialise");
+            check(sketch.table.length >= Math.min(Math.max(capacity, 256), Integer.MAX_VALUE >>> 1) / 2, () -> "table length " + sketch.table.length + " for " + capacity);
+            Map<Integer, Integer> counts = new HashMap<>();
+            List<Integer> increments = sc.increments().subList(0, Math.min(sc.increments().size(), Math.max(1, sketch.sampleSize - 1)));
+            for (int e : increments) {
+                int before = sketch.frequency(e);
+                sketch.increment(e);
+                counts.merge(e, 1, Integer::sum);
+                int after = sketch.frequency(e);
+                check(after >= before, () -> "frequency(" + e + ") fell from " + before + " to " + after);
+                check(after <= 15, () -> "frequency(" + e + ") = " + after + " > 15");
+            }
+            check(sketch.size == increments.size() || sketch.size >= 0, "size");
+            for (var en : counts.entrySet()) {
+                int f = sketch.frequency(en.getKey());
+                int want = Math.min(15, en.getValue());
+                check(f >= want, () -> "frequency(" + en.getKey() + ") = " + f + " after " + en.getValue() + " increments, no reset (size " + sketch.size + " of " + sketch.sampleSize + ")");
+            }
+            // a reset halves every counter (rounding down), so the bound halves too
+            sketch.reset();
+            for (var en : counts.entrySet()) {
+                int f = sketch.frequency(en.getKey());
+                int want = Math.min(15, en.getValue()) / 2;
+                check(f >= want, () -> "frequency(" + en.getKey() + ") = " + f + " after a reset, at least " + want + " expected");
+            }
+            // growing keeps the table; shrinking below the table length is a no-op
+            int len = sketch.table.length;
+            sketch.ensureCapacity(capacity / 2);
+            check(sketch.table.length == len, "ensureCapacity with a smaller size replaced the table");
+        });
+    }
+
+    // ---- linked deques -----------------------------------------------------------------------------------------
+
+    /** One operation on the deque and its ArrayDeque model; {@code x} and {@code y} index the pool of nodes. */
+    sealed interface DequeOp permits Poll, PollLast, OfferLast, OfferFirst, Add, Remove, MoveToBack, MoveToFront, PushPop, IteratorRemove,
+            RemoveFirstOccurrence, Clear, RemoveAll, AddLast {}
+
+    record Poll() implements DequeOp {}
+
+    record PollLast() implements DequeOp {}
+
+    record OfferLast(int x) implements DequeOp {}
+
+    record OfferFirst(int x) implements DequeOp {}
+
+    record Add(int x) implements DequeOp {}
+
+    record Remove(int x) implements DequeOp {}
+
+    record MoveToBack(int x) implements DequeOp {}
+
+    record MoveToFront(int x) implements DequeOp {}
+
+    /** pop when the deque has elements, else push {@code x}. */
+    record PushPop(int x) implements DequeOp {}
+
+    record IteratorRemove(int x) implements DequeOp {}
+
+    record RemoveFirstOccurrence(int x) implements DequeOp {}
+
+    record Clear() implements DequeOp {}
+
+    record RemoveAll(int x, int y) implements DequeOp {}
+
+    /** addLast, which must throw for a node that is already linked. */
+    record AddLast(int x) implements DequeOp {}
+
+    /** The operations over a pool of {@code size} nodes, equally likely except clear (one time in five of a slot); the polls first. */
+    static Generator<DequeOp> dequeOp(int size) {
+        Generator<Integer> x = ints(0, size - 1);
+        return weighted(
+                w(5, Generators.<DequeOp>just(new Poll())),
+                w(5, Generators.<DequeOp>just(new PollLast())),
+                w(5, x.<DequeOp>map(OfferLast::new)),
+                w(5, x.<DequeOp>map(OfferFirst::new)),
+                w(5, x.<DequeOp>map(Add::new)),
+                w(5, x.<DequeOp>map(Remove::new)),
+                w(5, x.<DequeOp>map(MoveToBack::new)),
+                w(5, x.<DequeOp>map(MoveToFront::new)),
+                w(5, x.<DequeOp>map(PushPop::new)),
+                w(5, x.<DequeOp>map(IteratorRemove::new)),
+                w(5, x.<DequeOp>map(RemoveFirstOccurrence::new)),
+                w(1, Generators.<DequeOp>just(new Clear())),
+                w(5, tuples(x, x).<DequeOp>map(t -> new RemoveAll(t.value1(), t.value2()))),
+                w(5, x.<DequeOp>map(AddLast::new)));
+    }
+
+    /** An access-order (else write-order) deque, a pool of 1..8 nodes and the operations on it. */
+    record DequeCase(boolean access, int poolSize, List<DequeOp> ops) {}
+
+    static final Generator<DequeCase> DEQUE_CASE = ints(1, 8).flatMap(size ->
+            tuples(chance(50), lists(dequeOp(size)).minSize(1).maxSize(60)).map(t -> new DequeCase(t.value1(), size, t.value2())));
+
+    /** The access-order deque behaves like an ArrayDeque of the same nodes (identity), with its extras. */
+    @Test
+    void linkedDequeAgreesWithArrayDeque() {
+        property("linkedDequeAgreesWithArrayDeque", tc -> {
+            DequeCase dc = tc.draw(DEQUE_CASE, "case");
+            boolean access = dc.access();
