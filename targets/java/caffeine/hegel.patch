+            }
+            check(spec.toParsableString().equals(text), () -> "toParsableString " + spec.toParsableString() + " for " + text);
+            check(CaffeineSpec.parse(text).equals(spec) && CaffeineSpec.parse(text).hashCode() == spec.hashCode(), () -> "parse is not stable for " + text);
+            check(spec.equals(CaffeineSpec.parse(spec.toParsableString())), () -> "round trip differs for " + text);
+            check(spec.toString().equals("CaffeineSpec{" + text + "}"), () -> "toString " + spec.toString());
+            // the same options in canonical form parse to an equal spec
+            StringBuilder canonical = new StringBuilder();
+            for (Opt o : opts) {
+                if (canonical.length() > 0) {
+                    canonical.append(", ");
+                }
+                canonical.append(o.key());
+                if (o.text() != null) {
+                    canonical.append('=').append(o.value() instanceof Duration d ? d.toString() : o.text().replace("_", "").replace("+", ""));
+                }
+            }
+            CaffeineSpec canon = CaffeineSpec.parse(canonical.toString());
+            check(canon.equals(spec), () -> "canonical form " + canonical + " differs from " + text);
+            // the builder carries the values
+            Caffeine<Object, Object> b = Caffeine.from(spec);
+            for (Opt o : opts) {
+                switch (o.key()) {
+                    case "initialCapacity" -> check(b.getInitialCapacity() == (int) o.value(), () -> "initialCapacity " + b.getInitialCapacity() + " for " + text);
+                    case "maximumSize" -> check(b.getMaximum() == (long) o.value() && !b.isWeighted(), () -> "maximumSize " + b.getMaximum() + " for " + text);
+                    case "maximumWeight" -> check(b.maximumWeight == (long) o.value() && b.maximumSize == Caffeine.UNSET_INT, () -> "maximumWeight " + b.maximumWeight + " for " + text);
+                    case "expireAfterAccess" -> check(b.getExpiresAfterAccessNanos() == ((Duration) o.value()).toNanos(), () -> "expireAfterAccess " + b.getExpiresAfterAccessNanos() + " vs " + o.value() + " for " + text);
+                    case "expireAfterWrite" -> check(b.getExpiresAfterWriteNanos() == ((Duration) o.value()).toNanos(), () -> "expireAfterWrite " + b.getExpiresAfterWriteNanos() + " vs " + o.value() + " for " + text);
+                    case "refreshAfterWrite" -> check(b.getRefreshAfterWriteNanos() == ((Duration) o.value()).toNanos(), () -> "refreshAfterWrite " + b.getRefreshAfterWriteNanos() + " vs " + o.value() + " for " + text);
+                    case "weakKeys" -> check(!b.isStrongKeys(), () -> "weakKeys ignored for " + text);
+                    case "weakValues" -> check(!b.isStrongValues() && b.valueStrength == Caffeine.Strength.WEAK, () -> "weakValues ignored for " + text);
+                    case "softValues" -> check(!b.isStrongValues() && b.valueStrength == Caffeine.Strength.SOFT, () -> "softValues ignored for " + text);
+                    case "recordStats" -> check(b.isRecordingStats(), () -> "recordStats ignored for " + text);
+                    default -> check(false, o.key());
+                }
+            }
+            check(Caffeine.from(text).toString().equals(b.toString()), () -> "from(String) differs from from(spec): " + Caffeine.from(text) + " vs " + b);
+        });
+    }
+
+    static final String[] MALFORMED = {
+        "maximumSize=1,maximumSize=2", "maximumSize=1,maximumWeight=2", "weakValues,softValues", "weakKeys,weakKeys",
+        "recordStats=true", "weakKeys=true", "maximumSize", "maximumSize=", "maximumSize=-1", "maximumSize=1.5",
+        "maximumSize=1=2", "expireAfterWrite=10", "expireAfterWrite=10ms", "expireAfterWrite=-1s", "expireAfterWrite=PT-1S",
+        "expireAfterWrite=1.5h", "initialCapacity=99999999999", "bogus=1", "bogus", "maximumSize=_1", "maximumSize=1_",
+        "refreshAfterWrite=0x10s", "expireAfterAccess=P1D2", "maximumWeight=1, maximumSize=2",
+    };
+
+    @Test
+    void malformedSpecificationsAreRejected() {
+        property("malformedSpecificationsAreRejected", tc -> {
+            String bad = tc.draw(sampledFrom(MALFORMED), "bad");
+            // grammar faults are IllegalArgumentException at parse; range faults surface from the builder (the
+            // specification only checks the grammar and non-negative durations, like Guava's CacheBuilderSpec)
+            boolean threw;
+            try {
+                Caffeine.from(bad).build();
+                threw = false;
+            } catch (IllegalArgumentException | IllegalStateException e) {
+                threw = true;
+            }
+            check(threw, () -> "from(" + bad + ").build() accepted a malformed specification: " + safeParse(bad));
+        });
+    }
+
+    static String safeParse(String s) {
+        try {
+            return Caffeine.from(s).toString();
+        } catch (RuntimeException e) {
+            return e.toString();
+        }
+    }
+
+    // ---- the builder -------------------------------------------------------------------------------------------
+
+    /** A negative long, a non-negative one, and a Duration beyond Long.MAX_VALUE nanoseconds. */
+    record BuilderCase(long neg, long pos, Duration huge) {}
+
+    static final Generator<BuilderCase> BUILDER_CASE = tuples(longs(1, Long.MAX_VALUE).map(n -> -n), longs(0, Long.MAX_VALUE),
+            tuples(longs(Long.MAX_VALUE / 1_000_000_000L + 1, Long.MAX_VALUE / 1000), ints(0, 999_999_999)).map(t -> Duration.ofSeconds(t.value1(), t.value2())))
+            .map(t -> new BuilderCase(t.value1(), t.value2(), t.value3()));
+
+    /** Builder validation: negatives, repeats, incompatible pairs and saturation of Duration arguments. */
+    @Test
+    void builderValidatesItsArguments() {
+        property("builderValidatesItsArguments", tc -> {
+            BuilderCase bc = tc.draw(BUILDER_CASE, "case");
+            long neg = bc.neg();
+            check(throwsA(IllegalArgumentException.class, () -> Caffeine.newBuilder().maximumSize(neg)), "negative maximumSize accepted");
+            check(throwsA(IllegalArgumentException.class, () -> Caffeine.newBuilder().maximumWeight(neg)), "negative maximumWeight accepted");
+            check(throwsA(IllegalArgumentException.class, () -> Caffeine.newBuilder().initialCapacity((int) Math.max(neg, Integer.MIN_VALUE))), "negative initialCapacity accepted");
+            check(throwsA(IllegalArgumentException.class, () -> Caffeine.newBuilder().expireAfterWrite(neg, TimeUnit.NANOSECONDS)), "negative expireAfterWrite accepted");
+            check(throwsA(IllegalArgumentException.class, () -> Caffeine.newBuilder().expireAfterAccess(Duration.ofNanos(neg))), "negative expireAfterAccess accepted");
+            check(throwsA(IllegalArgumentException.class, () -> Caffeine.newBuilder().refreshAfterWrite(0, TimeUnit.SECONDS)), "zero refreshAfterWrite accepted");
+            long pos = bc.pos();
+            check(throwsA(IllegalStateException.class, () -> Caffeine.newBuilder().maximumSize(pos).maximumSize(pos)), "maximumSize twice accepted");
+            check(throwsA(IllegalStateException.class, () -> Caffeine.newBuilder().maximumSize(pos).maximumWeight(pos)), "maximumSize + maximumWeight accepted");
+            check(throwsA(IllegalStateException.class, () -> Caffeine.newBuilder().maximumWeight(pos).build()), "maximumWeight without weigher built");
+            check(throwsA(IllegalStateException.class, () -> Caffeine.newBuilder().weigher((k, v) -> 1).build()), "weigher without maximumWeight built");
+            check(throwsA(IllegalStateException.class, () -> Caffeine.newBuilder().refreshAfterWrite(Duration.ofSeconds(1)).build()), "refreshAfterWrite without a loader built");
+            check(throwsA(IllegalStateException.class, () -> Caffeine.newBuilder().weakValues().buildAsync()), "weakValues with buildAsync accepted");
+            check(throwsA(IllegalStateException.class, () -> Caffeine.newBuilder().expireAfterWrite(Duration.ofSeconds(1)).expireAfter(new Expiry<Object, Object>() {
+                @Override public long expireAfterCreate(Object k, Object v, long t) { return 0; }
+                @Override public long expireAfterUpdate(Object k, Object v, long t, long d) { return d; }
+                @Override public long expireAfterRead(Object k, Object v, long t, long d) { return d; }
+            })), "expireAfterWrite + expireAfter accepted");
+            // Duration arguments saturate at Long.MAX_VALUE nanoseconds instead of overflowing
+            Duration huge = bc.huge();
+            Caffeine<Object, Object> b = Caffeine.newBuilder().expireAfterWrite(huge).expireAfterAccess(huge);
+            check(b.getExpiresAfterWriteNanos() == Long.MAX_VALUE, () -> "expireAfterWrite(" + huge + ") = " + b.getExpiresAfterWriteNanos());
+            check(b.getExpiresAfterAccessNanos() == Long.MAX_VALUE, () -> "expireAfterAccess(" + huge + ") = " + b.getExpiresAfterAccessNanos());
+            Duration fits = Duration.ofNanos(pos);
+            check(Caffeine.newBuilder().expireAfterWrite(fits).getExpiresAfterWriteNanos() == pos, () -> "expireAfterWrite(" + fits + ")");
+            // the maximum is clamped to what the policy can track
+            Caffeine<Object, Object> m = Caffeine.newBuilder().maximumSize(pos);
+            check(m.getMaximum() == pos, () -> "getMaximum " + m.getMaximum() + " for " + pos);
+            Cache<Integer, Integer> cache = m.executor(Runnable::run).build();
+            long tracked = cache.policy().eviction().orElseThrow().getMaximum();
+            check(tracked == Math.min(pos, BoundedLocalCache.MAXIMUM_CAPACITY), () -> "policy maximum " + tracked + " for " + pos);
+            check(cache.toString() != null && m.toString().contains("maximumSize"), () -> "toString " + m);
+        });
+    }
+
+    // ---- statistics --------------------------------------------------------------------------------------------
+
+    /** A statistic: up to 1000, or (25%) in the upper half of the long range, so that sums saturate. */
+    static final Generator<Long> STAT = weighted(w(75, longs(0, 1000)), w(25, longs(Long.MAX_VALUE / 2, Long.MAX_VALUE)));
+
+    /** The seven fields of a CacheStats. */
+    static final Generator<List<Long>> FIELDS = lists(STAT).minSize(7).maxSize(7);
+
+    record StatsCase(List<Long> a, List<Long> b) {}
+
+    static final Generator<StatsCase> STATS_CASE = tuples(FIELDS, FIELDS).map(t -> new StatsCase(t.value1(), t.value2()));
+
+    static long[] array(List<Long> l) {
+        return l.stream().mapToLong(Long::longValue).toArray();
+    }
+
+    /** CacheStats: saturating sums, floored differences, rates with their zero conventions, equality. */
+    @Test
+    void cacheStatsArithmeticSaturates() {
+        property("cacheStatsArithmeticSaturates", tc -> {
+            StatsCase sc = tc.draw(STATS_CASE, "case");
+            long[] a = array(sc.a());
+            long[] b = array(sc.b());
+            CacheStats x = CacheStats.of(a[0], a[1], a[2], a[3], a[4], a[5], a[6]);
+            CacheStats y = CacheStats.of(b[0], b[1], b[2], b[3], b[4], b[5], b[6]);
+            CacheStats sum = x.plus(y);
+            CacheStats diff = x.minus(y);
+            long[] s = fields(sum);
+            long[] d = fields(diff);
+            for (int i = 0; i < 7; i++) {
+                BigInteger exact = BigInteger.valueOf(a[i]).add(BigInteger.valueOf(b[i]));
+                long wantSum = exact.min(BigInteger.valueOf(Long.MAX_VALUE)).longValueExact();
+                long wantDiff = Math.max(0, a[i] - b[i]);
+                int fi = i;
+                check(s[i] == wantSum, () -> "plus field " + fi + " = " + s[fi] + ", exact " + wantSum);
+                check(d[i] == wantDiff, () -> "minus field " + fi + " = " + d[fi] + ", want " + wantDiff);
+            }
+            check(x.plus(y).equals(y.plus(x)) && x.plus(y).hashCode() == y.plus(x).hashCode(), "plus is not commutative");
+            check(x.plus(CacheStats.empty()).equals(x) && x.minus(CacheStats.empty()).equals(x), "empty is not neutral");
+            check(x.minus(x).equals(CacheStats.empty()), "x - x is not empty");
+            BigInteger requests = BigInteger.valueOf(a[0]).add(BigInteger.valueOf(a[1])).min(BigInteger.valueOf(Long.MAX_VALUE));
+            check(x.requestCount() == requests.longValueExact(), () -> "requestCount " + x.requestCount());
+            double hitRate = requests.signum() == 0 ? 1.0 : (double) a[0] / requests.doubleValue();
+            check(Math.abs(x.hitRate() - hitRate) <= 1e-12 && Math.abs(x.missRate() - (requests.signum() == 0 ? 0.0 : (double) a[1] / requests.doubleValue())) <= 1e-12,
+                () -> "hitRate " + x.hitRate() + " missRate " + x.missRate());
+            check(x.hitRate() >= 0 && x.hitRate() <= 1 && x.missRate() >= 0 && x.missRate() <= 1, "rates outside [0, 1]");
+            BigInteger loads = BigInteger.valueOf(a[2]).add(BigInteger.valueOf(a[3])).min(BigInteger.valueOf(Long.MAX_VALUE));
+            check(x.loadCount() == loads.longValueExact(), () -> "loadCount " + x.loadCount());
+            double penalty = loads.signum() == 0 ? 0.0 : (double) a[4] / loads.doubleValue();
+            check(Math.abs(x.averageLoadPenalty() - penalty) <= Math.max(1e-9, 1e-12 * Math.abs(penalty)), () -> "averageLoadPenalty " + x.averageLoadPenalty() + " vs " + penalty);
+            check(throwsA(IllegalArgumentException.class, () -> CacheStats.of(-1, 0, 0, 0, 0, 0, 0)), "negative hit count accepted");
+            check(x.toString().contains("hitCount=" + a[0]), () -> "toString " + x);
+        });
+    }
+
+    static long[] fields(CacheStats s) {
+        return new long[] {s.hitCount(), s.missCount(), s.loadSuccessCount(), s.loadFailureCount(), s.totalLoadTime(), s.evictionCount(), s.evictionWeight()};
+    }
+
+    // ---- the interner ------------------------------------------------------------------------------------------
+
+    /** A weak (else strong) interner and the keys k0..k20 to intern, each a fresh String instance when applied. */
+    record InternerCase(boolean weak, List<Integer> keys) {}
+
+    static final Generator<InternerCase> INTERNER_CASE = tuples(chance(50), lists(ints(0, 20)).minSize(1).maxSize(100)).map(t -> new InternerCase(t.value1(), t.value2()));
+
+    /** An interner returns one canonical instance per equal value and keeps it while strongly referenced. */
+    @Test
+    void internerIsCanonical() {
+        property("internerIsCanonical", tc -> {
+            InternerCase ic = tc.draw(INTERNER_CASE, "case");
+            Interner<String> interner = ic.weak() ? Interner.newWeakInterner() : Interner.newStrongInterner();
+            java.util.Map<String, String> canonical = new java.util.HashMap<>();
+            List<String> keep = new ArrayList<>();
+            for (Integer i : ic.keys()) {
+                String s = new String("k" + i);
+                String got = interner.intern(s);
+                check(got.equals(s), () -> "intern(" + s + ") = " + got);
+                String prior = canonical.putIfAbsent(s, got);
+                if (prior != null) {
+                    check(prior == got, () -> "intern(" + s + ") gave a different instance than before");
+                } else {
+                    check(got == s, () -> "first intern(" + s + ") did not return the sample itself");
+                    keep.add(got);
+                }
+            }
+            check(!keep.isEmpty(), "kept");
+        });
+    }
+}
diff --git a/hegel/tests/src/test/java/zoo/Gen.java b/hegel/tests/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..1272b95
--- /dev/null
+++ b/hegel/tests/src/test/java/zoo/Gen.java
@@ -0,0 +1,63 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import java.util.List;
+
+/** The combinators the binding lacks: weighted choice, a biased coin, an optional with a probability, int and long ranges. */
+public final class Gen {
+    private Gen() {}
+
+    /** A weighted alternative for {@link #weighted}. */
+    public record Choice<T>(int weight, Generator<T> gen) {}
+
+    public static <T> Choice<T> w(int weight, Generator<T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    public static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    public static <T> Generator<T> weighted(List<Choice<T>> choices) {
+        int total = 0;
+        for (Choice<T> c : choices) {
+            total += c.weight();
+        }
+        return integers().min(0).max(total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : choices) {
+                acc += c.weight();
+                if (i < acc) {
+                    return c.gen();
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    public static Generator<Boolean> chance(int pct) {
+        return integers().min(0).max(99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    public static <T> Generator<T> maybe(int pct, T absent, Generator<T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    public static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A long in [lo, hi]; shrinks to lo. */
+    public static Generator<Long> longs(long lo, long hi) {
+        return Generators.longs().min(lo).max(hi);
+    }
+}
diff --git a/hegel/tests/src/test/java/zoo/Zoo.java b/hegel/tests/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..e370b43
--- /dev/null
+++ b/hegel/tests/src/test/java/zoo/Zoo.java
@@ -0,0 +1,99 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+public final class Zoo {
+    private Zoo() {}
+
+    public static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    public static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    public static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    public static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    public static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    public static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+
+    /** Rethrows any throwable unchecked. */
+    @SuppressWarnings("unchecked")
+    public static <T extends Throwable> void sneaky(Throwable t) throws T {
+        throw (T) t;
+    }
+
+    /** A property body that may throw checked exceptions. */
+    public interface Body {
+        void run(TestCase tc) throws Exception;
+    }
+
+    /** Runs {@code body} as a Hegel property named {@code name}; checked exceptions escape as they are (Hegel.test takes a Consumer). */
+    public static void property(String name, Body body) {
+        dev.hegel.Hegel.test(tc -> {
+            try {
+                body.run(tc);
+            } catch (Exception e) {
+                Zoo.<RuntimeException>sneaky(e);
+            }
+        }, settings(name));
+    }
+
+    /** Whether {@code t} throws an instance of {@code type} (or, with {@code type} null, anything at all). */
+    public static boolean throwsA(Class<? extends Throwable> type, Body0 t) {
+        try {
+            t.run();
+            return false;
+        } catch (Throwable e) {
+            return type == null || type.isInstance(e);
+        }
+    }
+
+    public interface Body0 {
+        void run() throws Exception;
+    }
+}
