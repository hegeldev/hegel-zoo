@@ -0,0 +1,19 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for Caffeine, added by the Hegel zoo (targets/java/caffeine). Upstream builds with Gradle
+     and generates its Node and LocalCache specialisations at build time (caffeine/src/javaPoet), so this reactor
+     first runs those generators (codegen) and then compiles caffeine's sources plus the generated classes as the
+     test module's own main sources (tests). Nothing is installed. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>caffeine-hegel-parent</artifactId>
+  <version>0</version>
+  <packaging>pom</packaging>
+
+  <modules>
+    <module>codegen</module>
+    <module>tests</module>
+  </modules>
+</project>
diff --git a/hegel/tests/pom.xml b/hegel/tests/pom.xml
new file mode 100644
index 0000000..dd0ceab
--- /dev/null
+++ b/hegel/tests/pom.xml
@@ -0,0 +1,127 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Compiles caffeine/src/main/java (minus module-info.java) together with the generated Node/LocalCache classes
+     from ../codegen as this module's main sources, and runs the Hegel properties against them. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <parent>
+    <groupId>dev.hegel.zoo</groupId>
+    <artifactId>caffeine-hegel-parent</artifactId>
+    <version>0</version>
+  </parent>
+  <artifactId>caffeine-hegel</artifactId>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.jspecify</groupId>
+      <artifactId>jspecify</artifactId>
+      <version>1.0.1</version>
+    </dependency>
+    <dependency>
+      <groupId>com.google.errorprone</groupId>
+      <artifactId>error_prone_annotations</artifactId>
+      <version>2.50.0</version>
+    </dependency>
+    <dependency>
+      <groupId>org.mockito</groupId>
+      <artifactId>mockito-core</artifactId>
+      <version>5.23.0</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <!-- caffeine's sources are copied minus module-info.java: javac would otherwise discover the descriptor on the
+         source path and compile in module mode, where the (unpublished) annotation modules cannot be resolved -->
+    <sourceDirectory>${project.build.directory}/upstream</sourceDirectory>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-resources-plugin</artifactId>
+        <version>3.3.1</version>
+        <executions>
+          <execution>
+            <id>copy-upstream-sources</id>
+            <phase>generate-sources</phase>
+            <goals><goal>copy-resources</goal></goals>
+            <configuration>
+              <outputDirectory>${project.build.directory}/upstream</outputDirectory>
+              <resources>
+                <resource>
+                  <directory>${project.basedir}/../../caffeine/src/main/java</directory>
+                  <excludes><exclude>module-info.java</exclude></excludes>
+                </resource>
+              </resources>
+            </configuration>
+          </execution>
+        </executions>
+      </plugin>
+      <plugin>
+        <groupId>org.codehaus.mojo</groupId>
+        <artifactId>build-helper-maven-plugin</artifactId>
+        <version>3.6.0</version>
+        <executions>
+          <execution>
+            <id>add-generated</id>
+            <phase>generate-sources</phase>
+            <goals><goal>add-source</goal></goals>
+            <configuration>
+              <sources>
+                <source>${project.basedir}/../codegen/target/generated/node</source>
+                <source>${project.basedir}/../codegen/target/generated/local-cache</source>
+              </sources>
+            </configuration>
+          </execution>
+        </executions>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+        <configuration>
+          <showWarnings>false</showWarnings>
+          <compilerArgs>
+            <arg>-Xlint:none</arg>
+          </compilerArgs>
+        </configuration>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>-XX:+EnableDynamicAgentLoading --add-opens java.base/java.lang=ALL-UNNAMED -XX:+UseParallelGC -XX:-OmitStackTraceInFastThrow -Xmx2g</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/tests/src/test/java/com/github/benmanes/caffeine/cache/AsMapTest.java b/hegel/tests/src/test/java/com/github/benmanes/caffeine/cache/AsMapTest.java
new file mode 100644
index 0000000..f7e55e0
--- /dev/null
+++ b/hegel/tests/src/test/java/com/github/benmanes/caffeine/cache/AsMapTest.java
@@ -0,0 +1,188 @@
+package com.github.benmanes.caffeine.cache;
+
+import static zoo.Zoo.check;
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+import static zoo.Zoo.property;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.concurrent.ConcurrentMap;
+import org.junit.jupiter.api.Test;
+
+/**
+ * The asMap() view of a bounded and an unbounded cache against java.util.HashMap: every ConcurrentMap operation,
+ * the collection views, write-through entries and the removal notifications each operation must produce.
+ */
+class AsMapTest {
+
+    record Event(Integer key, String value, RemovalCause cause) {}
+
+    @Test
+    void asMapFollowsTheMapContract() {
+        property("asMapFollowsTheMapContract", tc -> {
+            boolean bounded = chance(tc, 60);
+            List<Event> events = new ArrayList<>();
+            List<Event> expected = new ArrayList<>();
+            Caffeine<Object, Object> b = Caffeine.newBuilder().executor(Runnable::run).recordStats();
+            if (bounded) {
+                b.maximumSize(10_000);
+            }
+            Cache<Integer, String> cache = b.removalListener((Integer k, String v, RemovalCause c) -> events.add(new Event(k, v, c))).build();
+            ConcurrentMap<Integer, String> map = cache.asMap();
+            Map<Integer, String> model = new HashMap<>();
+            String kind = bounded ? "bounded" : "unbounded";
+            int ops = n(tc, 1, 80);
+            for (int i = 0; i < ops; i++) {
+                Integer k = n(tc, 0, 12);
+                String v = "v" + n(tc, 0, 5);
+                String old = model.get(k);
+                String op;
+                switch (n(tc, 0, 24)) {
+                    case 0 -> { op = "put"; String r = map.put(k, v); check(Objects.equals(r, old), () -> "put returned " + r + " vs " + old); model.put(k, v); if (old != null) expected.add(new Event(k, old, RemovalCause.REPLACED)); }
+                    case 1 -> { op = "putIfAbsent"; String r = map.putIfAbsent(k, v); check(Objects.equals(r, old), () -> "putIfAbsent returned " + r + " vs " + old); model.putIfAbsent(k, v); }
+                    case 2 -> { op = "remove"; String r = map.remove(k); check(Objects.equals(r, old), () -> "remove returned " + r + " vs " + old); model.remove(k); if (old != null) expected.add(new Event(k, old, RemovalCause.EXPLICIT)); }
+                    case 3 -> { op = "remove(k,v)"; String probe = chance(tc, 50) && old != null ? old : v; boolean r = map.remove(k, probe); boolean w = model.remove(k, probe); check(r == w, () -> "remove(k, v) returned " + r + " vs " + w); if (w) expected.add(new Event(k, old, RemovalCause.EXPLICIT)); }
+                    case 4 -> { op = "replace"; String r = map.replace(k, v); check(Objects.equals(r, old), () -> "replace returned " + r + " vs " + old); model.replace(k, v); if (old != null) expected.add(new Event(k, old, RemovalCause.REPLACED)); }
+                    case 5 -> { op = "replace(k,o,n)"; String probe = chance(tc, 50) && old != null ? old : "v9"; boolean r = map.replace(k, probe, v); boolean w = model.replace(k, probe, v); check(r == w, () -> "replace(k, o, n) returned " + r + " vs " + w); if (w) expected.add(new Event(k, old, RemovalCause.REPLACED)); }
+                    case 6 -> { // compute
+                        op = "compute";
+                        String nv = chance(tc, 25) ? null : v;
+                        String[] seen = {"?"};
+                        String r = map.compute(k, (kk, ov) -> { seen[0] = ov; return nv; });
+                        check(Objects.equals(seen[0], old), () -> "compute saw " + seen[0] + " vs " + old);
+                        check(Objects.equals(r, nv), () -> "compute returned " + r + " vs " + nv);
+                        model.compute(k, (kk, ov) -> nv);
+                        if (old != null) expected.add(new Event(k, old, nv == null ? RemovalCause.EXPLICIT : RemovalCause.REPLACED));
+                    }
+                    case 7 -> { // computeIfAbsent
+                        op = "computeIfAbsent";
+                        String nv = chance(tc, 25) ? null : v;
+                        int[] calls = {0};
+                        String r = map.computeIfAbsent(k, kk -> { calls[0]++; return nv; });
+                        String w = model.computeIfAbsent(k, kk -> nv);
+                        check(Objects.equals(r, w), () -> "computeIfAbsent returned " + r + " vs " + w);
+                        check(calls[0] == (old == null ? 1 : 0), () -> "computeIfAbsent called the function " + calls[0] + " times, present=" + (old != null));
+                    }
+                    case 8 -> { // computeIfPresent
+                        op = "computeIfPresent";
+                        String nv = chance(tc, 25) ? null : v;
+                        String r = map.computeIfPresent(k, (kk, ov) -> nv);
+                        String w = model.computeIfPresent(k, (kk, ov) -> nv);
+                        check(Objects.equals(r, w), () -> "computeIfPresent returned " + r + " vs " + w);
+                        if (old != null) expected.add(new Event(k, old, nv == null ? RemovalCause.EXPLICIT : RemovalCause.REPLACED));
+                    }
+                    case 9 -> { // merge
+                        op = "merge";
+                        boolean drop = chance(tc, 20);
+                        String r = map.merge(k, v, (a, bb) -> drop ? null : a + "+" + bb);
+                        String w = model.merge(k, v, (a, bb) -> drop ? null : a + "+" + bb);
+                        check(Objects.equals(r, w), () -> "merge returned " + r + " vs " + w);
+                        if (old != null) expected.add(new Event(k, old, drop ? RemovalCause.EXPLICIT : RemovalCause.REPLACED));
+                    }
+                    case 10 -> { // putAll
+                        op = "putAll";
+                        Map<Integer, String> batch = new HashMap<>();
+                        for (int j = 0; j < n(tc, 0, 4); j++) batch.put(n(tc, 0, 12), "b" + n(tc, 0, 5));
+                        map.putAll(batch);
+                        for (var en : batch.entrySet()) { String o = model.put(en.getKey(), en.getValue()); if (o != null) expected.add(new Event(en.getKey(), o, RemovalCause.REPLACED)); }
+                    }
+                    case 11 -> { op = "keySet.remove"; boolean r = map.keySet().remove(k); check(r == (old != null), () -> "keySet.remove returned " + r); model.remove(k); if (old != null) expected.add(new Event(k, old, RemovalCause.EXPLICIT)); }
+                    case 12 -> { // values.remove removes one mapping with that value
+                        op = "values.remove";
+                        boolean r = map.values().remove(v);
+                        boolean w = model.containsValue(v);
+                        check(r == w, () -> "values.remove(" + v + ") returned " + r + " vs " + w);
+                        if (w) {
+                            Integer victim = null;
+                            for (var en : model.entrySet()) if (en.getValue().equals(v) && !map.containsKey(en.getKey())) victim = en.getKey();
+                            Integer fv = victim;
+                            check(victim != null, () -> "values.remove(" + v + ") removed nothing the model had");
+                            if (victim != null) { model.remove(victim); expected.add(new Event(fv, v, RemovalCause.EXPLICIT)); }
+                        }
+                    }
+                    case 13 -> { // entrySet.removeIf
+                        op = "entrySet.removeIf";
+                        String target = v;
+                        boolean r = map.entrySet().removeIf(en -> en.getValue().equals(target));
+                        List<Integer> gone = new ArrayList<>();
+                        for (var en : model.entrySet()) if (en.getValue().equals(target)) gone.add(en.getKey());
+                        check(r == !gone.isEmpty(), () -> "entrySet.removeIf returned " + r);
+                        for (Integer g : gone) { expected.add(new Event(g, model.remove(g), RemovalCause.EXPLICIT)); }
+                    }
+                    case 14 -> { // write-through entry
+                        op = "entry.setValue";
+                        for (Map.Entry<Integer, String> en : map.entrySet()) {
+                            if (en.getKey().equals(k)) {
+                                String r = en.setValue(v);
+                                check(Objects.equals(r, old), () -> "setValue returned " + r + " vs " + old);
+                                check(en.getValue().equals(v), () -> "entry.getValue after setValue " + en.getValue());
+                                model.put(k, v);
+                                expected.add(new Event(k, old, RemovalCause.REPLACED));
+                                break;
+                            }
+                        }
+                    }
+                    case 15 -> { // iterator removal
+                        op = "iterator.remove";
+                        for (Iterator<Map.Entry<Integer, String>> it = map.entrySet().iterator(); it.hasNext();) {
+                            var en = it.next();
+                            if (en.getKey().equals(k)) { it.remove(); model.remove(k); expected.add(new Event(k, old, RemovalCause.EXPLICIT)); break; }
+                        }
+                    }
+                    case 16 -> { op = "replaceAll"; map.replaceAll((kk, ov) -> ov + "!"); for (var en : new ArrayList<>(model.entrySet())) { expected.add(new Event(en.getKey(), en.getValue(), RemovalCause.REPLACED)); model.put(en.getKey(), en.getValue() + "!"); } }
+                    case 17 -> { op = "clear"; if (chance(tc, 30)) { map.clear(); for (var en : model.entrySet()) expected.add(new Event(en.getKey(), en.getValue(), RemovalCause.EXPLICIT)); model.clear(); } }
+                    case 18 -> { op = "invalidateAll"; if (chance(tc, 30)) { cache.invalidateAll(); for (var en : model.entrySet()) expected.add(new Event(en.getKey(), en.getValue(), RemovalCause.EXPLICIT)); model.clear(); } }
+                    case 19 -> { op = "keySet.retainAll"; Set<Integer> keep = new HashSet<>(); for (int j = 0; j < n(tc, 0, 6); j++) keep.add(n(tc, 0, 12)); boolean r = map.keySet().retainAll(keep); boolean w = false; for (var it = model.entrySet().iterator(); it.hasNext();) { var en = it.next(); if (!keep.contains(en.getKey())) { expected.add(new Event(en.getKey(), en.getValue(), RemovalCause.EXPLICIT)); it.remove(); w = true; } } boolean fw = w; check(r == fw, () -> "retainAll returned " + r + " vs " + fw); }
+                    case 20 -> { op = "getOrDefault"; String r = map.getOrDefault(k, "dflt"); String w = model.getOrDefault(k, "dflt"); check(r.equals(w), () -> "getOrDefault " + r + " vs " + w); }
+                    case 21 -> { op = "put same instance"; if (old != null) { String same = map.get(k); String r = map.put(k, same); check(r == same, () -> "put of the same instance returned " + r); /* no notification for an identical value */ } }
+                    case 22 -> { op = "values.removeAll"; Set<String> drop = new HashSet<>(List.of(v, "v0")); boolean r = map.values().removeAll(drop); boolean w = false; for (var it = model.entrySet().iterator(); it.hasNext();) { var en = it.next(); if (drop.contains(en.getValue())) { expected.add(new Event(en.getKey(), en.getValue(), RemovalCause.EXPLICIT)); it.remove(); w = true; } } boolean fw = w; check(r == fw, () -> "values.removeAll returned " + r + " vs " + fw); }
+                    case 23 -> { op = "keySet.removeAll"; Set<Integer> drop = new HashSet<>(List.of(k, n(tc, 0, 12))); boolean r = map.keySet().removeAll(drop); boolean w = false; for (Integer d : drop) { String o = model.remove(d); if (o != null) { expected.add(new Event(d, o, RemovalCause.EXPLICIT)); w = true; } } boolean fw = w; check(r == fw, () -> "keySet.removeAll returned " + r + " vs " + fw); }
+                    default -> { op = "get"; String r = map.get(k); check(Objects.equals(r, old), () -> "get " + r + " vs " + old); }
+                }
+                String fop = op;
+                // the view equals the model in every respect a Map promises
+                check(map.size() == model.size() && map.isEmpty() == model.isEmpty(), () -> kind + " " + fop + ": size " + map.size() + " vs " + model.size());
+                check(map.equals(model) && model.equals(map), () -> kind + " " + fop + ": equals " + map + " vs " + model);
+                check(map.hashCode() == model.hashCode(), () -> kind + " " + fop + ": hashCode");
+                check(new HashMap<>(map).equals(model), () -> kind + " " + fop + ": copy " + new HashMap<>(map) + " vs " + model);
+                check(map.keySet().equals(model.keySet()) && map.entrySet().equals(model.entrySet()), () -> kind + " " + fop + ": keySet/entrySet");
+                check(new ArrayList<>(map.values()).size() == model.size() && new HashSet<>(map.values()).equals(new HashSet<>(model.values())), () -> kind + " " + fop + ": values");
+                for (int j = 0; j <= 12; j++) {
+                    int fj = j;
+                    check(map.containsKey(j) == model.containsKey(j), () -> kind + " " + fop + ": containsKey(" + fj + ")");
+                    check(map.containsValue("v" + (j % 6)) == model.containsValue("v" + (j % 6)), () -> kind + " " + fop + ": containsValue");
+                }
+                check(cache.estimatedSize() == model.size(), () -> kind + " " + fop + ": estimatedSize " + cache.estimatedSize() + " vs " + model.size());
+                Map<Integer, String> present = cache.getAllPresent(model.keySet());
+                check(present.equals(model), () -> kind + " " + fop + ": getAllPresent " + present + " vs " + model);
+                check(map.toString().length() == model.toString().length(), () -> kind + " " + fop + ": toString " + map + " vs " + model);
+                // notifications so far: same multiset
+                List<Event> pending = new ArrayList<>(expected);
+                List<Event> extra = new ArrayList<>();
+                for (Event e : events) {
+                    if (!pending.remove(e)) extra.add(e);
+                }
+                check(extra.isEmpty(), () -> kind + " " + fop + ": unexpected removal notifications " + extra + " (expected " + expected + ")");
+                check(pending.isEmpty(), () -> kind + " " + fop + ": missing removal notifications " + pending + " (got " + events + ")");
+                events.clear();
+                expected.clear();
+            }
+            // the unsupported operations
+            boolean threw = false;
+            try { map.entrySet().add(Map.entry(1, "x")); } catch (UnsupportedOperationException e) { threw = true; }
+            check(threw, kind + ": entrySet().add did not throw UnsupportedOperationException");
+            for (Integer key : List.of(1, 2)) {
+                boolean npe = false;
+                try { map.put(key, null); } catch (NullPointerException e) { npe = true; }
+                check(npe, kind + ": put(k, null) did not throw NullPointerException");
+            }
+        });
+    }
+}
