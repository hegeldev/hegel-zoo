@@ -0,0 +1,19 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for Caffeine, added by the Hegel zoo (targets/java/caffeine). Upstream builds with Gradle
+     and generates its Node and LocalCache specialisations at build time (caffeine/src/javaPoet), so this reactor
+     first runs those generators (codegen) and then compiles caffeine's sources plus the generated classes as the
+     test module's own main sources (tests). Nothing is installed. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>caffeine-hegel-parent</artifactId>
+  <version>0</version>
+  <packaging>pom</packaging>
+
+  <modules>
+    <module>codegen</module>
+    <module>tests</module>
+  </modules>
+</project>
diff --git a/hegel/tests/pom.xml b/hegel/tests/pom.xml
new file mode 100644
index 0000000..dd0ceab
--- /dev/null
+++ b/hegel/tests/pom.xml
@@ -0,0 +1,127 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Compiles caffeine/src/main/java (minus module-info.java) together with the generated Node/LocalCache classes
+     from ../codegen as this module's main sources, and runs the Hegel properties against them. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <parent>
+    <groupId>dev.hegel.zoo</groupId>
+    <artifactId>caffeine-hegel-parent</artifactId>
+    <version>0</version>
+  </parent>
+  <artifactId>caffeine-hegel</artifactId>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.release>22</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>org.jspecify</groupId>
+      <artifactId>jspecify</artifactId>
+      <version>1.0.1</version>
+    </dependency>
+    <dependency>
+      <groupId>com.google.errorprone</groupId>
+      <artifactId>error_prone_annotations</artifactId>
+      <version>2.50.0</version>
+    </dependency>
+    <dependency>
+      <groupId>org.mockito</groupId>
+      <artifactId>mockito-core</artifactId>
+      <version>5.23.0</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <!-- caffeine's sources are copied minus module-info.java: javac would otherwise discover the descriptor on the
+         source path and compile in module mode, where the (unpublished) annotation modules cannot be resolved -->
+    <sourceDirectory>${project.build.directory}/upstream</sourceDirectory>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-resources-plugin</artifactId>
+        <version>3.3.1</version>
+        <executions>
+          <execution>
+            <id>copy-upstream-sources</id>
+            <phase>generate-sources</phase>
+            <goals><goal>copy-resources</goal></goals>
+            <configuration>
+              <outputDirectory>${project.build.directory}/upstream</outputDirectory>
+              <resources>
+                <resource>
+                  <directory>${project.basedir}/../../caffeine/src/main/java</directory>
+                  <excludes><exclude>module-info.java</exclude></excludes>
+                </resource>
+              </resources>
+            </configuration>
+          </execution>
+        </executions>
+      </plugin>
+      <plugin>
+        <groupId>org.codehaus.mojo</groupId>
+        <artifactId>build-helper-maven-plugin</artifactId>
+        <version>3.6.0</version>
+        <executions>
+          <execution>
+            <id>add-generated</id>
+            <phase>generate-sources</phase>
+            <goals><goal>add-source</goal></goals>
+            <configuration>
+              <sources>
+                <source>${project.basedir}/../codegen/target/generated/node</source>
+                <source>${project.basedir}/../codegen/target/generated/local-cache</source>
+              </sources>
+            </configuration>
+          </execution>
+        </executions>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+        <configuration>
+          <showWarnings>false</showWarnings>
+          <compilerArgs>
+            <arg>-Xlint:none</arg>
+          </compilerArgs>
+        </configuration>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>-XX:+EnableDynamicAgentLoading --add-opens java.base/java.lang=ALL-UNNAMED -XX:+UseParallelGC -XX:-OmitStackTraceInFastThrow -Xmx2g</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/tests/src/test/java/com/github/benmanes/caffeine/cache/AsMapTest.java b/hegel/tests/src/test/java/com/github/benmanes/caffeine/cache/AsMapTest.java
new file mode 100644
index 0000000..d739669
--- /dev/null
+++ b/hegel/tests/src/test/java/com/github/benmanes/caffeine/cache/AsMapTest.java
@@ -0,0 +1,298 @@
+package com.github.benmanes.caffeine.cache;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sets;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.maybe;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Zoo.check;
+import static zoo.Zoo.property;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.concurrent.ConcurrentMap;
+import org.junit.jupiter.api.Test;
+
+/**
+ * The asMap() view of a bounded and an unbounded cache against java.util.HashMap: every ConcurrentMap operation,
+ * the collection views, write-through entries and the removal notifications each operation must produce.
+ */
+class AsMapTest {
+
+    record Event(Integer key, String value, RemovalCause cause) {}
+
+    /** One operation on the view and the model; keys are 0..12 and values v0..v5, so that collisions are common. */
+    sealed interface Op permits Get, GetOrDefault, Put, PutIfAbsent, Remove, RemoveValue, Replace, ReplaceValue, Compute, ComputeIfAbsent,
+            ComputeIfPresent, Merge, PutAll, KeySetRemove, ValuesRemove, EntrySetRemoveIf, EntrySetValue, IteratorRemove, ReplaceAll, Clear,
+            InvalidateAll, KeySetRetainAll, PutSameInstance, ValuesRemoveAll, KeySetRemoveAll {}
+
+    record Get(int k) implements Op {}
+
+    record GetOrDefault(int k) implements Op {}
+
+    record Put(int k, String v) implements Op {}
+
+    record PutIfAbsent(int k, String v) implements Op {}
+
+    record Remove(int k) implements Op {}
+
+    /** remove(k, value): the live value when {@code live} and the key is present, else {@code v}. */
+    record RemoveValue(int k, boolean live, String v) implements Op {}
+
+    record Replace(int k, String v) implements Op {}
+
+    /** replace(k, old, v): {@code old} is the live value when {@code live} and the key is present, else "v9". */
+    record ReplaceValue(int k, boolean live, String v) implements Op {}
+
+    /** compute to {@code v}, or a removal when it is null. */
+    record Compute(int k, String v) implements Op {}
+
+    record ComputeIfAbsent(int k, String v) implements Op {}
+
+    record ComputeIfPresent(int k, String v) implements Op {}
+
+    /** merge {@code v} in by concatenation, or ({@code drop}) by removing the entry. */
+    record Merge(int k, String v, boolean drop) implements Op {}
+
+    record KV(int k, String v) {}
+
+    record PutAll(List<KV> batch) implements Op {}
+
+    record KeySetRemove(int k) implements Op {}
+
+    record ValuesRemove(String v) implements Op {}
+
+    record EntrySetRemoveIf(String v) implements Op {}
+
+    /** setValue on the entry of {@code k} while iterating entrySet. */
+    record EntrySetValue(int k, String v) implements Op {}
+
+    record IteratorRemove(int k) implements Op {}
+
+    record ReplaceAll() implements Op {}
+
+    record Clear() implements Op {}
+
+    record InvalidateAll() implements Op {}
+
+    record KeySetRetainAll(Set<Integer> keep) implements Op {}
+
+    record PutSameInstance(int k) implements Op {}
+
+    /** values().removeAll of {@code v} and v0. */
+    record ValuesRemoveAll(String v) implements Op {}
+
+    record KeySetRemoveAll(int k, int k2) implements Op {}
+
+    static final Generator<Integer> KEY = ints(0, 12);
+    static final Generator<String> VALUE = ints(0, 5).map(i -> "v" + i);
+    /** A value, or (25%) null. */
+    static final Generator<String> NULLABLE = maybe(25, (String) null, VALUE);
+    static final Generator<KV> BATCH_ENTRY = tuples(KEY, ints(0, 5)).map(t -> new KV(t.value1(), "b" + t.value2()));
+
+    /** The operations, equally likely except clear and invalidateAll (three times in ten of a slot); the reads first. */
+    static final Generator<Op> OP = weighted(
+            w(10, KEY.<Op>map(Get::new)),
+            w(10, KEY.<Op>map(GetOrDefault::new)),
+            w(10, tuples(KEY, VALUE).<Op>map(t -> new Put(t.value1(), t.value2()))),
+            w(10, tuples(KEY, VALUE).<Op>map(t -> new PutIfAbsent(t.value1(), t.value2()))),
+            w(10, KEY.<Op>map(Remove::new)),
+            w(10, tuples(KEY, chance(50), VALUE).<Op>map(t -> new RemoveValue(t.value1(), t.value2(), t.value3()))),
+            w(10, tuples(KEY, VALUE).<Op>map(t -> new Replace(t.value1(), t.value2()))),
+            w(10, tuples(KEY, chance(50), VALUE).<Op>map(t -> new ReplaceValue(t.value1(), t.value2(), t.value3()))),
+            w(10, tuples(KEY, NULLABLE).<Op>map(t -> new Compute(t.value1(), t.value2()))),
+            w(10, tuples(KEY, NULLABLE).<Op>map(t -> new ComputeIfAbsent(t.value1(), t.value2()))),
+            w(10, tuples(KEY, NULLABLE).<Op>map(t -> new ComputeIfPresent(t.value1(), t.value2()))),
+            w(10, tuples(KEY, VALUE, chance(20)).<Op>map(t -> new Merge(t.value1(), t.value2(), t.value3()))),
+            w(10, lists(BATCH_ENTRY).maxSize(4).<Op>map(PutAll::new)),
+            w(10, KEY.<Op>map(KeySetRemove::new)),
+            w(10, VALUE.<Op>map(ValuesRemove::new)),
+            w(10, VALUE.<Op>map(EntrySetRemoveIf::new)),
+            w(10, tuples(KEY, VALUE).<Op>map(t -> new EntrySetValue(t.value1(), t.value2()))),
+            w(10, KEY.<Op>map(IteratorRemove::new)),
+            w(10, just((Op) new ReplaceAll())),
+            w(3, just((Op) new Clear())),
+            w(3, just((Op) new InvalidateAll())),
+            w(10, sets(KEY).maxSize(6).<Op>map(KeySetRetainAll::new)),
+            w(10, KEY.<Op>map(PutSameInstance::new)),
+            w(10, VALUE.<Op>map(ValuesRemoveAll::new)),
+            w(10, tuples(KEY, KEY).<Op>map(t -> new KeySetRemoveAll(t.value1(), t.value2()))));
+
+    /** A bounded (60%) or unbounded cache and the operations on its view. */
+    record AsMapCase(boolean bounded, List<Op> ops) {}
+
+    static final Generator<AsMapCase> AS_MAP_CASE = tuples(chance(60), lists(OP).minSize(1).maxSize(80)).map(t -> new AsMapCase(t.value1(), t.value2()));
+
+    @Test
+    void asMapFollowsTheMapContract() {
+        property("asMapFollowsTheMapContract", tc -> {
+            AsMapCase c = tc.draw(AS_MAP_CASE, "case");
+            boolean bounded = c.bounded();
+            List<Event> events = new ArrayList<>();
+            List<Event> expected = new ArrayList<>();
+            Caffeine<Object, Object> b = Caffeine.newBuilder().executor(Runnable::run).recordStats();
+            if (bounded) {
+                b.maximumSize(10_000);
+            }
+            Cache<Integer, String> cache = b.removalListener((Integer k, String v, RemovalCause cause) -> events.add(new Event(k, v, cause))).build();
+            ConcurrentMap<Integer, String> map = cache.asMap();
+            Map<Integer, String> model = new HashMap<>();
+            String kind = bounded ? "bounded" : "unbounded";
+            for (Op op : c.ops()) {
+                switch (op) {
+                    case Get o -> { Integer k = o.k(); String old = model.get(k); String r = map.get(k); check(Objects.equals(r, old), () -> "get " + r + " vs " + old); }
+                    case GetOrDefault o -> { String r = map.getOrDefault(o.k(), "dflt"); String w = model.getOrDefault(o.k(), "dflt"); check(r.equals(w), () -> "getOrDefault " + r + " vs " + w); }
+                    case Put o -> { Integer k = o.k(); String old = model.get(k); String r = map.put(k, o.v()); check(Objects.equals(r, old), () -> "put returned " + r + " vs " + old); model.put(k, o.v()); if (old != null) expected.add(new Event(k, old, RemovalCause.REPLACED)); }
+                    case PutIfAbsent o -> { Integer k = o.k(); String old = model.get(k); String r = map.putIfAbsent(k, o.v()); check(Objects.equals(r, old), () -> "putIfAbsent returned " + r + " vs " + old); model.putIfAbsent(k, o.v()); }
+                    case Remove o -> { Integer k = o.k(); String old = model.get(k); String r = map.remove(k); check(Objects.equals(r, old), () -> "remove returned " + r + " vs " + old); model.remove(k); if (old != null) expected.add(new Event(k, old, RemovalCause.EXPLICIT)); }
+                    case RemoveValue o -> { Integer k = o.k(); String old = model.get(k); String probe = o.live() && old != null ? old : o.v(); boolean r = map.remove(k, probe); boolean w = model.remove(k, probe); check(r == w, () -> "remove(k, v) returned " + r + " vs " + w); if (w) expected.add(new Event(k, old, RemovalCause.EXPLICIT)); }
+                    case Replace o -> { Integer k = o.k(); String old = model.get(k); String r = map.replace(k, o.v()); check(Objects.equals(r, old), () -> "replace returned " + r + " vs " + old); model.replace(k, o.v()); if (old != null) expected.add(new Event(k, old, RemovalCause.REPLACED)); }
+                    case ReplaceValue o -> { Integer k = o.k(); String old = model.get(k); String probe = o.live() && old != null ? old : "v9"; boolean r = map.replace(k, probe, o.v()); boolean w = model.replace(k, probe, o.v()); check(r == w, () -> "replace(k, o, n) returned " + r + " vs " + w); if (w) expected.add(new Event(k, old, RemovalCause.REPLACED)); }
+                    case Compute o -> {
+                        Integer k = o.k();
+                        String old = model.get(k);
+                        String nv = o.v();
+                        String[] seen = {"?"};
+                        String r = map.compute(k, (kk, ov) -> { seen[0] = ov; return nv; });
+                        check(Objects.equals(seen[0], old), () -> "compute saw " + seen[0] + " vs " + old);
+                        check(Objects.equals(r, nv), () -> "compute returned " + r + " vs " + nv);
+                        model.compute(k, (kk, ov) -> nv);
+                        if (old != null) expected.add(new Event(k, old, nv == null ? RemovalCause.EXPLICIT : RemovalCause.REPLACED));
+                    }
+                    case ComputeIfAbsent o -> {
+                        Integer k = o.k();
+                        String old = model.get(k);
+                        String nv = o.v();
+                        int[] calls = {0};
+                        String r = map.computeIfAbsent(k, kk -> { calls[0]++; return nv; });
+                        String w = model.computeIfAbsent(k, kk -> nv);
+                        check(Objects.equals(r, w), () -> "computeIfAbsent returned " + r + " vs " + w);
+                        check(calls[0] == (old == null ? 1 : 0), () -> "computeIfAbsent called the function " + calls[0] + " times, present=" + (old != null));
+                    }
+                    case ComputeIfPresent o -> {
+                        Integer k = o.k();
+                        String old = model.get(k);
+                        String nv = o.v();
+                        String r = map.computeIfPresent(k, (kk, ov) -> nv);
+                        String w = model.computeIfPresent(k, (kk, ov) -> nv);
+                        check(Objects.equals(r, w), () -> "computeIfPresent returned " + r + " vs " + w);
+                        if (old != null) expected.add(new Event(k, old, nv == null ? RemovalCause.EXPLICIT : RemovalCause.REPLACED));
+                    }
+                    case Merge o -> {
+                        Integer k = o.k();
+                        String old = model.get(k);
+                        boolean drop = o.drop();
+                        String r = map.merge(k, o.v(), (a, bb) -> drop ? null : a + "+" + bb);
+                        String w = model.merge(k, o.v(), (a, bb) -> drop ? null : a + "+" + bb);
+                        check(Objects.equals(r, w), () -> "merge returned " + r + " vs " + w);
+                        if (old != null) expected.add(new Event(k, old, drop ? RemovalCause.EXPLICIT : RemovalCause.REPLACED));
+                    }
+                    case PutAll o -> {
+                        Map<Integer, String> batch = new HashMap<>();
+                        for (KV kv : o.batch()) batch.put(kv.k(), kv.v());
+                        map.putAll(batch);
+                        for (var en : batch.entrySet()) { String old = model.put(en.getKey(), en.getValue()); if (old != null) expected.add(new Event(en.getKey(), old, RemovalCause.REPLACED)); }
+                    }
+                    case KeySetRemove o -> { Integer k = o.k(); String old = model.get(k); boolean r = map.keySet().remove(k); check(r == (old != null), () -> "keySet.remove returned " + r); model.remove(k); if (old != null) expected.add(new Event(k, old, RemovalCause.EXPLICIT)); }
+                    case ValuesRemove o -> { // removes one mapping with that value
+                        String v = o.v();
+                        boolean r = map.values().remove(v);
+                        boolean w = model.containsValue(v);
+                        check(r == w, () -> "values.remove(" + v + ") returned " + r + " vs " + w);
+                        if (w) {
+                            Integer victim = null;
+                            for (var en : model.entrySet()) if (en.getValue().equals(v) && !map.containsKey(en.getKey())) victim = en.getKey();
+                            Integer fv = victim;
+                            check(victim != null, () -> "values.remove(" + v + ") removed nothing the model had");
+                            if (victim != null) { model.remove(victim); expected.add(new Event(fv, v, RemovalCause.EXPLICIT)); }
+                        }
+                    }
+                    case EntrySetRemoveIf o -> {
