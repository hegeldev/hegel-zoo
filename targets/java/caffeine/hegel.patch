+package com.github.benmanes.caffeine.cache;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.sets;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.maybe;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Zoo.check;
+import static zoo.Zoo.property;
+
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+import com.github.benmanes.caffeine.cache.stats.CacheStats;
+import dev.hegel.Generator;
+import dev.hegel.Generators;
+import org.junit.jupiter.api.Test;
+
+/**
+ * The cache against a java.util model under a fake ticker with maintenance run inline
+ * ({@code executor(Runnable::run)} + {@code cleanUp()}): presence, values, expiration (fixed and variable), the
+ * size/weight bound, removal notifications, statistics and the Policy views.
+ */
+class CacheModelTest {
+
+    static final long TOL = BoundedLocalCache.EXPIRE_TOLERANCE; // 1 s: access/write times move only past it
+    static final long SEC = TimeUnit.SECONDS.toNanos(1);
+
+    enum Bound { NONE, SIZE, WEIGHT }
+    enum Expire { NONE, WRITE, ACCESS, BOTH, VARIABLE }
+
+    /** Configuration of one cache under test. */
+    record Config(Bound bound, long maximum, Expire expire, long ttlWrite, long ttlAccess, boolean loading) {
+        boolean bounded() { return bound != Bound.NONE || expire != Expire.NONE; }
+        boolean expiresWrite() { return expire == Expire.WRITE || expire == Expire.BOTH; }
+        boolean expiresAccess() { return expire == Expire.ACCESS || expire == Expire.BOTH; }
+        boolean variable() { return expire == Expire.VARIABLE; }
+        boolean fixedExpiry() { return expiresWrite() || expiresAccess(); }
+    }
+
+    /** The bound and its maximum: none, a size of up to 12 entries, or a weight of up to 30. */
+    record Limit(Bound bound, long maximum) {}
+
+    static final Generator<Limit> LIMIT = Generators.<Limit>oneOf(just(new Limit(Bound.NONE, 0)),
+            ints(0, 12).map(n -> new Limit(Bound.SIZE, n)), ints(0, 30).map(n -> new Limit(Bound.WEIGHT, n)));
+
+    /** A time to live: 1..40 whole seconds, or (30%) 0.5, 1 or 1.5 s, around the tolerance. */
+    static final Generator<Long> TTL = weighted(w(70, ints(1, 40).map(n -> n * SEC)), w(30, ints(1, 3).map(n -> n * SEC / 2)));
+
+    static final Generator<Config> CONFIG = tuples(LIMIT, sampledFrom(Expire.values()), TTL, TTL, chance(40))
+            .map(t -> new Config(t.value1().bound(), t.value1().maximum(), t.value2(), t.value3(), t.value4(), t.value5()));
+
+    static int weight(Integer k, String v) {
+        return (k * 7 + v.length()) % 4;
+    }
+
+    /** Variable expiry: a duration decided by the key and value on create/update, kept on read. */
+    static long varDuration(Integer k, String v) {
+        return ((k * 31 + v.hashCode()) & 15) * SEC / 2; // 0 .. 7.5 s
+    }
+
+    /** One operation on the cache and the model; keys are 0..15. */
+    sealed interface Op permits GetIfPresent, Checkpoint, Advance, Put, Invalidate, Get, GetAllPresent, PutIfAbsent, RemoveValue, Replace, InvalidateAll, Compute {}
+
+    record GetIfPresent(int k) implements Op {}
+
+    /** cleanUp, then compare everything. */
+    record Checkpoint() implements Op {}
+
+    /** Advance the fake clock by an even number of nanoseconds (the low bit of a write time marks a refresh). */
+    record Advance(long nanos) implements Op {}
+
+    record Put(int k, String v) implements Op {}
+
+    record Invalidate(int k) implements Op {}
+
+    /** LoadingCache.get(k), or on a manual cache get(k, fn) with fn returning {@code v}. */
+    record Get(int k, String v) implements Op {}
+
+    record GetAllPresent(Set<Integer> keys) implements Op {}
+
+    record PutIfAbsent(int k, String v) implements Op {}
+
+    /** asMap().remove(k, value): the live value when {@code live} and the key is present, else {@code v}. */
+    record RemoveValue(int k, boolean live, String v) implements Op {}
+
+    record Replace(int k, String v) implements Op {}
+
+    record InvalidateAll(List<Integer> keys) implements Op {}
+
+    /** asMap().compute to {@code v}, or a removal when it is null (20%). */
+    record Compute(int k, String v) implements Op {}
+
+    static final Generator<Integer> KEY = ints(0, 15);
+
+    /** "v" and a digit, followed (70%) by up to three x's, so that the weight varies with the value. */
+    static final Generator<String> VALUE = tuples(ints(0, 9), weighted(w(30, just("")), w(70, ints(0, 3).map("x"::repeat))))
+            .map(t -> "v" + t.value1() + t.value2());
+
+    /** A clock step: up to 30 whole seconds, or (40%) up to 900 ms. */
+    static final Generator<Long> STEP = weighted(w(60, ints(0, 30).map(s -> s * SEC)), w(40, ints(0, 900).map(ms -> ms * 1_000_000L)));
+
+    /** The operations: a put twice as often as the rest, remove(k, v) and replace half as often; the reads first. */
+    static final Generator<Op> OP = weighted(
+            w(2, KEY.<Op>map(GetIfPresent::new)),
+            w(2, just((Op) new Checkpoint())),
+            w(2, STEP.<Op>map(Advance::new)),
+            w(4, tuples(KEY, VALUE).<Op>map(t -> new Put(t.value1(), t.value2()))),
+            w(2, KEY.<Op>map(Invalidate::new)),
+            w(2, tuples(KEY, VALUE).<Op>map(t -> new Get(t.value1(), t.value2()))),
+            w(2, sets(KEY).maxSize(5).<Op>map(GetAllPresent::new)),
+            w(2, tuples(KEY, VALUE).<Op>map(t -> new PutIfAbsent(t.value1(), t.value2()))),
+            w(1, tuples(KEY, chance(70), VALUE).<Op>map(t -> new RemoveValue(t.value1(), t.value2(), t.value3()))),
+            w(1, tuples(KEY, VALUE).<Op>map(t -> new Replace(t.value1(), t.value2()))),
+            w(2, lists(KEY).maxSize(4).<Op>map(InvalidateAll::new)),
+            w(2, tuples(KEY, maybe(20, (String) null, VALUE)).<Op>map(t -> new Compute(t.value1(), t.value2()))));
+
+    /** A configuration and the operations run against the cache it builds. */
+    record CacheCase(Config cfg, List<Op> ops) {}
+
+    static final Generator<CacheCase> CACHE_CASE = tuples(CONFIG, lists(OP).minSize(1).maxSize(60)).map(t -> new CacheCase(t.value1(), t.value2()));
+
+    record Event(Integer key, String value, RemovalCause cause) {}
+
+    /** The model's entry. */
+    static final class Entry {
+        String value;
+        long writeTime;    // as stored by the cache (tolerance applied)
+        long accessTime;   // as stored by the cache (tolerance applied)
+        long varExpiresAt; // variable expiry
+        int weight;
+        Entry(String value, long now, int weight, long varExpiresAt) {
+            this.value = value; writeTime = now; accessTime = now; this.weight = weight; this.varExpiresAt = varExpiresAt;
+        }
+    }
+
+    static final class Model {
+        final Config cfg;
+        final Map<Integer, Entry> map = new LinkedHashMap<>();
+        final List<Event> events = new ArrayList<>();
+        long hits, misses, loadSuccess, loadFailure;
+        Model(Config cfg) { this.cfg = cfg; }
+
+        boolean expired(Entry e, long now) {
+            return (cfg.expiresAccess() && now - e.accessTime >= cfg.ttlAccess)
+                || (cfg.expiresWrite() && now - e.writeTime >= cfg.ttlWrite)
+                || (cfg.variable() && now - e.varExpiresAt >= 0);
+        }
+        /** A live (present, unexpired) entry or null. */
+        Entry live(Integer k, long now) {
+            Entry e = map.get(k);
+            return e == null || expired(e, now) ? null : e;
+        }
+        /** Drops the expired entry for k if there is one, recording the notification. */
+        void expireIfNeeded(Integer k, long now) {
+            Entry e = map.get(k);
+            if (e != null && expired(e, now)) {
+                map.remove(k);
+                events.add(new Event(k, e.value, RemovalCause.EXPIRED));
+            }
+        }
+        void touch(Entry e, long now) { // a read hit
+            if (cfg.expiresAccess() && (cfg.ttlAccess <= TOL || Math.abs(now - e.accessTime) > TOL)) {
+                e.accessTime = now;
+            }
+        }
+        /** put; returns the previous live value or null. */
+        String put(Integer k, String v, long now) {
+            expireIfNeeded(k, now);
+            Entry e = map.get(k);
+            if (e == null) {
+                map.put(k, new Entry(v, now, weight(k, v), now + varDuration(k, v)));
+                return null;
+            }
+            String old = e.value;
+            long newVar = now + varDuration(k, v);
+            boolean exceeds = (cfg.expiresWrite() && (cfg.ttlWrite <= TOL || Math.abs(now - e.writeTime) > TOL))
+                || (cfg.variable() && Math.abs(newVar - e.varExpiresAt) > TOL);
+            e.value = v;
+            e.weight = weight(k, v);
+            if (exceeds) {
+                e.writeTime = now;
+            }
+            e.varExpiresAt = newVar;
+            if (cfg.expiresAccess() && (cfg.ttlAccess <= TOL || Math.abs(now - e.accessTime) > TOL)) {
+                e.accessTime = now;
+            }
+            events.add(new Event(k, old, RemovalCause.REPLACED));
+            return old;
+        }
+        String remove(Integer k, long now) {
+            expireIfNeeded(k, now);
+            Entry e = map.remove(k);
+            if (e == null) {
+                return null;
+            }
+            events.add(new Event(k, e.value, RemovalCause.EXPLICIT));
+            return e.value;
+        }
+        String get(Integer k, long now) { // getIfPresent
+            Entry e = live(k, now);
+            if (e == null) {
+                misses++;
+                return null;
+            }
+            hits++;
+            touch(e, now);
+            return e.value;
+        }
+        void expireAll(long now) {
+            for (Integer k : new ArrayList<>(map.keySet())) {
+                expireIfNeeded(k, now);
+            }
+        }
+    }
+
+    /** A cache whose loader is deterministic: null for keys divisible by 7, otherwise "L<key>/<load number>". */
+    static final class Harness {
+        final Config cfg;
+        final AtomicLong now = new AtomicLong(1L << 40);
+        final List<Event> events = new ArrayList<>();
+        final Cache<Integer, String> cache;
+        final LoadingCache<Integer, String> loading;
+        final Model model;
+        final List<String> log = new ArrayList<>();
+        int loads;
+
+        String recent() {
+            return " ops " + log.subList(Math.max(0, log.size() - 14), log.size());
+        }
+
+        Harness(Config cfg) {
+            this.cfg = cfg;
+            model = new Model(cfg);
+            Caffeine<Object, Object> b = Caffeine.newBuilder().executor(Runnable::run).ticker(now::get).recordStats();
+            if (cfg.bound == Bound.SIZE) {
+                b.maximumSize(cfg.maximum);
+            } else if (cfg.bound == Bound.WEIGHT) {
+                b.maximumWeight(cfg.maximum).weigher((Integer k, String v) -> weight(k, v));
+            }
+            if (cfg.expiresWrite()) {
+                b.expireAfterWrite(Duration.ofNanos(cfg.ttlWrite));
+            }
+            if (cfg.expiresAccess()) {
+                b.expireAfterAccess(Duration.ofNanos(cfg.ttlAccess));
+            }
+            if (cfg.variable()) {
+                b.expireAfter(new Expiry<Integer, String>() {
+                    @Override public long expireAfterCreate(Integer k, String v, long t) { return varDuration(k, v); }
+                    @Override public long expireAfterUpdate(Integer k, String v, long t, long d) { return varDuration(k, v); }
+                    @Override public long expireAfterRead(Integer k, String v, long t, long d) { return d; }
+                });
+            }
+            Caffeine<Integer, String> typed = b.removalListener((Integer k, String v, RemovalCause c) -> events.add(new Event(k, v, c)));
+            if (cfg.loading) {
+                loading = typed.build(this::load);
+                cache = loading;
+            } else {
+                loading = null;
+                cache = typed.build();
+            }
+        }
+
+        String load(Integer k) {
+            loads++;
+            return k % 7 == 0 ? null : "L" + k + "/" + loads;
+        }
+    }
+
+    @Test
+    void cacheAgreesWithTheModel() {
+        property("cacheAgreesWithTheModel", tc -> {
+            CacheCase cc = tc.draw(CACHE_CASE, "case");
+            Config cfg = cc.cfg();
+            Harness h = new Harness(cfg);
+            Model m = h.model;
+            for (Op op : cc.ops()) {
+                long now = h.now.get();
+                syncSizeEvictions(h, m, cfg);
+                h.log.add(op + "@" + (now - (1L << 40)) / 1_000_000 + "ms");
+                switch (op) {
+                    case Put o -> {
+                        h.cache.put(o.k(), o.v());
+                        m.put(o.k(), o.v(), now);
+                    }
+                    case GetIfPresent o -> {
+                        Integer k = o.k();
+                        String got = h.cache.getIfPresent(k);
+                        String want = m.get(k, now);
+                        check(Objects.equals(got, want), () -> "getIfPresent(" + k + ") = " + got + ", model " + want + " " + cfg);
+                    }
+                    case Invalidate o -> {
+                        h.cache.invalidate(o.k());
+                        m.remove(o.k(), now);
+                    }
+                    case Get o -> { // get with a mapping function / loader
+                        Integer k = o.k();
+                        if (cfg.loading) {
+                            int before = h.loads;
+                            String got = h.loading.get(k);
+                            Entry e = m.live(k, now);
+                            if (e != null) {
+                                m.hits++;
+                                m.touch(e, now);
+                                check(Objects.equals(got, e.value), () -> "LoadingCache.get(" + k + ") = " + got + ", model " + e.value + " " + cfg);
+                                check(h.loads == before, () -> "LoadingCache.get(" + k + ") loaded although present " + cfg);
+                            } else {
+                                m.misses++;
+                                check(h.loads == before + 1, () -> "LoadingCache.get(" + k + ") loads = " + (h.loads - before) + " " + cfg);
+                                String loaded = k % 7 == 0 ? null : "L" + k + "/" + h.loads;
+                                check(Objects.equals(got, loaded), () -> "LoadingCache.get(" + k + ") = " + got + ", loader gave " + loaded + " " + cfg);
+                                if (loaded == null) {
+                                    m.loadFailure++;
+                                    m.expireIfNeeded(k, now);
+                                } else {
+                                    m.loadSuccess++;
+                                    m.expireIfNeeded(k, now);
+                                    m.map.put(k, new Entry(loaded, now, weight(k, loaded), now + varDuration(k, loaded)));
+                                }
+                            }
+                        } else {
+                            int[] calls = {0};
+                            String v = o.v();
+                            String got = h.cache.get(k, key -> { calls[0]++; return v; });
+                            Entry e = m.live(k, now);
+                            if (e != null) {
+                                m.hits++;
+                                m.touch(e, now);
+                                check(Objects.equals(got, e.value), () -> "get(" + k + ", fn) = " + got + ", model " + e.value + " " + cfg);
+                                check(calls[0] == 0, () -> "get(" + k + ", fn) called the function although present " + cfg);
+                            } else {
+                                m.misses++;
+                                m.loadSuccess++;
+                                check(calls[0] == 1, () -> "get(" + k + ", fn) called the function " + calls[0] + " times " + cfg);
+                                check(Objects.equals(got, v), () -> "get(" + k + ", fn) = " + got + ", function gave " + v + " " + cfg);
+                                m.expireIfNeeded(k, now);
+                                m.map.put(k, new Entry(v, now, weight(k, v), now + varDuration(k, v)));
+                            }
+                        }
+                    }
+                    case GetAllPresent o -> {
+                        Set<Integer> keys = o.keys();
+                        Map<Integer, String> got = h.cache.getAllPresent(keys);
+                        Map<Integer, String> want = new HashMap<>();
+                        for (Integer key : keys) {
+                            Entry e = m.live(key, now);
+                            if (e != null) {
+                                want.put(key, e.value);
+                                m.touch(e, now);
+                            }
+                        }
+                        m.hits += want.size();
+                        m.misses += keys.size() - want.size();
+                        check(got.equals(want), () -> "getAllPresent(" + keys + ") = " + got + ", model " + want + " " + cfg);
+                    }
+                    case PutIfAbsent o -> {
+                        Integer k = o.k();
+                        String v = o.v();
+                        String got = h.cache.asMap().putIfAbsent(k, v);
+                        m.expireIfNeeded(k, now);
+                        Entry e = m.map.get(k);
+                        if (e == null) {
+                            m.map.put(k, new Entry(v, now, weight(k, v), now + varDuration(k, v)));
+                            check(got == null, () -> "putIfAbsent(" + k + ") on an absent key = " + got + " " + cfg);
+                        } else {
+                            check(Objects.equals(got, e.value), () -> "putIfAbsent(" + k + ") = " + got + ", model " + e.value + " " + cfg);
+                            m.touch(e, now);
+                        }
+                    }
+                    case RemoveValue o -> {
+                        Integer k = o.k();
+                        Entry e = m.live(k, now);
+                        String v = e != null && o.live() ? e.value : o.v();
+                        boolean got = h.cache.asMap().remove(k, v);
+                        boolean want = e != null && e.value.equals(v);
+                        check(got == want, () -> "asMap.remove(" + k + ", " + v + ") = " + got + ", model " + want + " " + cfg);
+                        if (want) {
+                            m.remove(k, now);
+                        } else {
+                            m.expireIfNeeded(k, now);
+                        }
+                    }
+                    case Replace o -> {
+                        Integer k = o.k();
+                        Entry e = m.live(k, now);
+                        String v = o.v();
+                        String got = h.cache.asMap().replace(k, v);
+                        String want = e == null ? null : e.value;
+                        check(Objects.equals(got, want), () -> "asMap.replace(" + k + ") = " + got + ", model " + want + " " + cfg);
+                        if (e != null) {
+                            m.put(k, v, now);
+                        } else {
+                            m.expireIfNeeded(k, now);
+                        }
+                    }
+                    case Advance o -> h.now.addAndGet(o.nanos() & ~1L);
+                    case InvalidateAll o -> {
+                        h.cache.invalidateAll(o.keys());
+                        for (Integer key : new HashSet<>(o.keys())) {
+                            m.remove(key, now);
+                        }
+                    }
+                    case Compute o -> {
+                        Integer k = o.k();
+                        String v = o.v();
+                        Entry e = m.live(k, now);
+                        String[] seen = {"unset"};
+                        String got = h.cache.asMap().compute(k, (key, old) -> { seen[0] = old; return v; });
+                        String oldWant = e == null ? null : e.value;
+                        check(Objects.equals(seen[0], oldWant), () -> "compute(" + k + ") saw " + seen[0] + ", model " + oldWant + " " + cfg);
+                        check(Objects.equals(got, v), () -> "compute(" + k + ") returned " + got + " for " + v + " " + cfg);
+                        if (v == null) {
+                            m.loadFailure++; // compute records a load
+                            m.remove(k, now);
+                        } else if (e == null) {
+                            m.loadSuccess++;
+                            m.expireIfNeeded(k, now);
+                            m.map.put(k, new Entry(v, now, weight(k, v), now + varDuration(k, v)));
+                        } else {
+                            m.loadSuccess++;
+                            m.put(k, v, now);
+                        }
+                    }
+                    case Checkpoint o -> checkpoint(h, m, cfg);
+                }
+            }
+            checkpoint(h, m, cfg);
+        });
+    }
+
+    /**
+     * SIZE evictions are the policy's choice and happen inline during writes: each must name a live model entry
+     * with its current value, which then leaves the model.
+     */
+    static void syncSizeEvictions(Harness h, Model m, Config cfg) {
+        long now = h.now.get();
+        for (var it = h.events.iterator(); it.hasNext();) {
+            Event ev = it.next();
+            if (ev.cause() != RemovalCause.SIZE) {
+                continue;
+            }
+            it.remove();
+            check(cfg.bound != Bound.NONE, () -> "SIZE eviction " + ev + " from an unbounded cache " + cfg);
+            Entry e = m.map.get(ev.key());
+            if (e != null && m.expired(e, now)) {
+                // the cache may evict an expired entry by size before it notices the expiry; either cause is honest
+                m.map.remove(ev.key());
+                continue;
+            }
+            check(e != null && e.value.equals(ev.value()), () -> "SIZE eviction " + ev + " does not match the model's " + (e == null ? null : e.value) + " " + cfg);
+            if (e != null) {
+                m.map.remove(ev.key());
+            }
+        }
+    }
+
+    /** cleanUp, then compare presence, size bounds, notifications, stats and the policy views. */
+    static void checkpoint(Harness h, Model m, Config cfg) {
+        long now = h.now.get();
+        h.cache.cleanUp();
+        syncSizeEvictions(h, m, cfg);
+        m.expireAll(now);
+        Map<Integer, String> live = new TreeMap<>();
+        for (var en : m.map.entrySet()) {
+            live.put(en.getKey(), en.getValue().value);
+        }
+        Map<Integer, String> got = new TreeMap<>(h.cache.asMap());
+        List<Event> unexplained = new ArrayList<>();
+        List<Event> cacheEvents = new ArrayList<>(h.events);
+        List<Event> modelEvents = new ArrayList<>(m.events);
+        for (Event ev : cacheEvents) {
+            if (ev.cause() != RemovalCause.SIZE) {
+                if (!modelEvents.remove(ev)) {
+                    unexplained.add(ev);
+                }
+            }
+        }
+        if (cfg.variable()) {
+            // the timer wheel expires by bucket, so expired entries may linger until their bucket passes
+            modelEvents.removeIf(ev -> ev.cause() == RemovalCause.EXPIRED);
+            unexplained.removeIf(ev -> ev.cause() == RemovalCause.EXPIRED);
+        }
+        check(unexplained.isEmpty(), () -> "removal notifications the model did not expect: " + unexplained + " " + cfg);
+        check(modelEvents.isEmpty(), () -> "removal notifications missing: " + modelEvents + " (cache sent " + cacheEvents + ") " + cfg);
+        for (Integer k : got.keySet()) {
+            Entry e = m.map.get(k);
+            if (cfg.variable() && e == null) {
+                continue; // may be an expired entry in a bucket not yet passed; getIfPresent hides it
+            }
+            check(e != null, () -> "key " + k + " is in the cache but not in the model " + cfg);
+            if (e != null) {
+                check(e.value.equals(got.get(k)), () -> "key " + k + " = " + got.get(k) + " in the cache, " + e.value + " in the model " + cfg);
+            }
+        }
+        for (Integer k : live.keySet()) {
+            if (!got.containsKey(k)) {
+                check(false, () -> "key " + k + " = " + live.get(k) + " is in the model but not in the cache after cleanUp (events " + h.events + ") " + cfg);
+                m.map.remove(k);
+            }
+        }
+        if (cfg.variable()) {
+            for (Integer k : live.keySet()) {
+                String v = h.cache.getIfPresent(k);
+                if (m.map.containsKey(k)) {
+                    m.hits++;
+                    m.touch(m.map.get(k), now);
+                    check(live.get(k).equals(v), () -> "getIfPresent(" + k + ") = " + v + " after cleanUp, model " + live.get(k) + " " + cfg);
+                } else {
+                    m.misses++;
+                }
+            }
+        }
+        h.events.removeAll(cacheEvents);
+        m.events.clear();
+        // bounds
+        long size = h.cache.estimatedSize();
+        check(size == h.cache.asMap().size(), () -> "estimatedSize " + size + " vs asMap().size() " + h.cache.asMap().size() + " after cleanUp " + cfg);
+        if (cfg.bound == Bound.SIZE) {
+            check(size <= cfg.maximum, () -> "size " + size + " exceeds maximumSize " + cfg.maximum + " " + cfg);
+        } else if (cfg.bound == Bound.WEIGHT) {
+            long total = 0;
+            for (var en : h.cache.asMap().entrySet()) {
+                total += weight(en.getKey(), en.getValue());
+            }
+            long finalTotal = total;
+            var eviction = h.cache.policy().eviction().orElseThrow();
+            check(total <= cfg.maximum, () -> "weight " + finalTotal + " exceeds maximumWeight " + cfg.maximum + " " + cfg);
+            long weighted = eviction.weightedSize().orElse(-1);
+            if (cfg.variable()) { // expired entries linger in their bucket and keep their weight, but asMap hides them
+                check(weighted >= total && weighted <= cfg.maximum, () -> "weightedSize " + weighted + " vs summed " + finalTotal + " " + cfg);
+            } else {
+                check(weighted == total, () -> "weightedSize " + weighted + " vs summed " + finalTotal + " " + cfg);
+            }
+            for (var en : h.cache.asMap().entrySet()) {
+                int w = eviction.weightOf(en.getKey()).orElse(-1);
+                check(w == weight(en.getKey(), en.getValue()), () -> "weightOf(" + en.getKey() + ") = " + w + " " + cfg);
+            }
+        }
+        // stats
+        CacheStats stats = h.cache.stats();
+        check(stats.hitCount() == m.hits && stats.missCount() == m.misses,
+            () -> "hits/misses " + stats.hitCount() + "/" + stats.missCount() + ", model " + m.hits + "/" + m.misses + " " + cfg);
+        check(stats.loadSuccessCount() == m.loadSuccess && stats.loadFailureCount() == m.loadFailure,
+            () -> "loads " + stats.loadSuccessCount() + "/" + stats.loadFailureCount() + ", model " + m.loadSuccess + "/" + m.loadFailure + " " + cfg);
+        // policy views
+        policyViews(h, m, cfg, now, got);
+    }
+
+    static void policyViews(Harness h, Model m, Config cfg, long now, Map<Integer, String> snapshot) {
+        Set<Integer> keys = new HashSet<>(snapshot.keySet());
+        Policy<Integer, String> policy = h.cache.policy();
+        check(policy.isRecordingStats(), () -> "isRecordingStats false " + cfg);
+        policy.eviction().ifPresent(ev -> {
+            Map<Integer, String> coldest = ev.coldest(Integer.MAX_VALUE);
+            Map<Integer, String> hottest = ev.hottest(Integer.MAX_VALUE);
+            check(coldest.keySet().equals(keys), () -> "coldest keys " + coldest.keySet() + " vs " + keys + " " + cfg);
+            check(hottest.keySet().equals(keys), () -> "hottest keys " + hottest.keySet() + " vs " + keys + " " + cfg);
+            List<Integer> c = new ArrayList<>(coldest.keySet());
+            // every policy snapshot runs a maintenance cycle (the climber may reorder), so only the size is compared
+            int limit = Math.min(2, keys.size());
+            Set<Integer> some = ev.coldest(limit).keySet();
+            check(some.size() == limit && keys.containsAll(some), () -> "coldest(" + limit + ") = " + some + " of " + keys + " " + cfg);
+            check(ev.getMaximum() == cfg.maximum, () -> "getMaximum " + ev.getMaximum() + " " + cfg);
+            check(ev.isWeighted() == (cfg.bound == Bound.WEIGHT), () -> "isWeighted " + ev.isWeighted() + " " + cfg);
+        });
+        policy.expireAfterWrite().ifPresent(ex -> {
+            check(ex.getExpiresAfter(TimeUnit.NANOSECONDS) == cfg.ttlWrite, () -> "getExpiresAfter " + ex.getExpiresAfter(TimeUnit.NANOSECONDS) + " " + cfg);
+            Map<Integer, String> oldest = ex.oldest(Integer.MAX_VALUE);
+            check(oldest.keySet().equals(keys), () -> "oldest keys " + oldest.keySet() + " vs " + keys + " " + cfg);
+            long prev = Long.MIN_VALUE / 2;
+            for (Integer k : oldest.keySet()) {
+                long wt = m.map.get(k).writeTime;
+                long p = prev;
+                check(wt >= p - TOL, () -> "oldest() is not in write order at " + k + ": " + wt + " after " + p + " " + cfg);
+                prev = wt;
+            }
+            List<Integer> youngest = new ArrayList<>(ex.youngest(Integer.MAX_VALUE).keySet());
+            java.util.Collections.reverse(youngest);
+            check(youngest.equals(new ArrayList<>(oldest.keySet())), () -> "youngest is not the reverse of oldest " + cfg);
+            for (Integer k : keys) {
+                if (m.map.get(k) == null) {
+                    continue;
+                }
+                long age = ex.ageOf(k, TimeUnit.NANOSECONDS).orElse(-1);
+                long want = now - m.map.get(k).writeTime;
+                check(Math.abs(age - want) <= 1, () -> "ageOf(" + k + ") = " + age + ", model " + want + " " + cfg + h.recent());
+            }
+        });
+        policy.expireAfterAccess().ifPresent(ex -> {
+            check(ex.getExpiresAfter(TimeUnit.NANOSECONDS) == cfg.ttlAccess, () -> "getExpiresAfter " + ex.getExpiresAfter(TimeUnit.NANOSECONDS) + " " + cfg);
+            Map<Integer, String> oldest = ex.oldest(Integer.MAX_VALUE);
+            check(oldest.keySet().equals(keys), () -> "oldest (access) keys " + oldest.keySet() + " vs " + keys + " " + cfg);
+            Set<Integer> youngestKeys = ex.youngest(Integer.MAX_VALUE).keySet();
+            check(youngestKeys.equals(keys), () -> "youngest (access) keys " + youngestKeys + " vs " + keys + " " + cfg);
+            if (cfg.bound == Bound.NONE) {
+                List<Integer> youngest = new ArrayList<>(youngestKeys);
+                java.util.Collections.reverse(youngest);
+                check(youngest.equals(new ArrayList<>(oldest.keySet())), () -> "youngest (access) is not the reverse of oldest " + cfg);
+            }
+            for (Integer k : keys) {
+                if (m.map.get(k) == null) {
+                    continue;
+                }
+                long age = ex.ageOf(k, TimeUnit.NANOSECONDS).orElse(-1);
+                long want = now - m.map.get(k).accessTime;
+                check(age == want, () -> "ageOf(" + k + ") (access) = " + age + ", model " + want + " (now " + now + ", model access time " + m.map.get(k).accessTime + ") " + cfg + h.recent());
+            }
+        });
+        policy.expireVariably().ifPresent(ex -> {
+            for (Integer k : keys) {
+                Entry e = m.map.get(k);
+                if (e == null) {
+                    continue;
+                }
+                long left = ex.getExpiresAfter(k, TimeUnit.NANOSECONDS).orElse(Long.MIN_VALUE);
+                long want = e.varExpiresAt - now;
+                check(left == want, () -> "getExpiresAfter(" + k + ") = " + left + ", model " + want + " " + cfg);
+            }
+            Map<Integer, String> oldest = ex.oldest(Integer.MAX_VALUE);
+            check(oldest.keySet().equals(keys), () -> "oldest (variable) keys " + oldest.keySet() + " vs " + keys + " " + cfg);
+        });
+        // asMap().get would record a read (and move the access time): compare with the snapshot instead
+        for (Integer k : keys) {
+            String v = policy.getIfPresentQuietly(k);
+            String want = snapshot.get(k);
+            check(Objects.equals(v, want), () -> "getIfPresentQuietly(" + k + ") = " + v + " vs asMap snapshot " + want + " " + cfg);
+        }
+    }
+}
