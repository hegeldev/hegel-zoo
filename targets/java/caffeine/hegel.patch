+                    case OfferLast o -> { TestNode x = pool.get(o.x()); boolean present = model.contains(x); boolean r = deque.offerLast(x); check(r == !present, () -> "offerLast returned " + r + " present=" + present); if (!present) model.offerLast(x); }
+                    case OfferFirst o -> { TestNode x = pool.get(o.x()); boolean present = model.contains(x); boolean r = deque.offerFirst(x); check(r == !present, () -> "offerFirst returned " + r + " present=" + present); if (!present) model.offerFirst(x); }
+                    case Add o -> { TestNode x = pool.get(o.x()); boolean present = model.contains(x); boolean r = deque.add(x); check(r == !present, () -> "add returned " + r); if (!present) model.addLast(x); }
+                    case Remove o -> { TestNode x = pool.get(o.x()); boolean present = model.contains(x); boolean r = deque.remove(x); check(r == present, () -> "remove(o) returned " + r + " present=" + present); model.remove(x); }
+                    case MoveToBack o -> { TestNode x = pool.get(o.x()); if (model.contains(x)) { deque.moveToBack(x); model.remove(x); model.addLast(x); } }
+                    case MoveToFront o -> { TestNode x = pool.get(o.x()); if (model.contains(x)) { deque.moveToFront(x); model.remove(x); model.addFirst(x); } }
+                    case PushPop o -> { TestNode x = pool.get(o.x()); if (!model.isEmpty()) { var r = deque.pop(); var w = model.pop(); check(r == w, () -> "pop " + id(r) + " vs " + id(w)); } else { deque.push(x); model.push(x); } }
+                    case IteratorRemove o -> { TestNode x = pool.get(o.x()); if (model.contains(x)) { for (Iterator<Node<Integer, Integer>> it = deque.iterator(); it.hasNext();) { if (it.next() == x) { it.remove(); break; } } model.remove(x); } }
+                    case RemoveFirstOccurrence o -> { TestNode x = pool.get(o.x()); boolean present = model.contains(x); boolean r = deque.removeFirstOccurrence(x); check(r == present, () -> "removeFirstOccurrence returned " + r); model.remove(x); }
+                    case Clear o -> { deque.clear(); model.clear(); }
+                    case RemoveAll o -> { List<Node<Integer, Integer>> some = List.of(pool.get(o.x()), pool.get(o.y())); boolean r = deque.removeAll(some); boolean w = model.removeAll(some); check(r == w, () -> "removeAll returned " + r + " vs " + w); }
