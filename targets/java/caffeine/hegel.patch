+    }
+
+    /** A duration of at least one unit when {@code positive}, else at least zero: a small count (80%) or a huge one, or ISO seconds with (30%) milliseconds. */
+    static Generator<Dur> dur(boolean positive) {
+        long lo = positive ? 1 : 0;
