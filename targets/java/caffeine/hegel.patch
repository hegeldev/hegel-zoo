+    /** An option in its place: the key it is ordered by (a stable sort, so equal keys keep the declaration order) and the whitespace around its separators. */
+    record Placed(Opt opt, int order, String wsBeforeComma, String wsAfterComma, String wsBeforeEq, String wsAfterEq) {}
