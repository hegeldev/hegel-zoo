+                        check(r == !gone.isEmpty(), () -> "entrySet.removeIf returned " + r);
+                        for (Integer g : gone) { expected.add(new Event(g, model.remove(g), RemovalCause.EXPLICIT)); }
+                    }
+                    case EntrySetValue o -> { // write-through entry
+                        Integer k = o.k();
+                        String old = model.get(k);
+                        for (Map.Entry<Integer, String> en : map.entrySet()) {
+                            if (en.getKey().equals(k)) {
+                                String r = en.setValue(o.v());
+                                check(Objects.equals(r, old), () -> "setValue returned " + r + " vs " + old);
+                                check(en.getValue().equals(o.v()), () -> "entry.getValue after setValue " + en.getValue());
