+    /** Random digit strings (with signs, leading zeros, stray characters) parsed by Agrona and by the JDK. */
+    @Test
+    void asciiParsersMatchTheJdk() {
+        Hegel.test(tc -> {
+            String text;
+            switch (n(tc, 0, 5)) {
+                case 0 -> text = word(tc, DIGITS, 1, 21);
+                case 1 -> text = "-" + word(tc, DIGITS, 1, 20);
+                case 2 -> text = (chance(tc, 50) ? "-" : "") + "0".repeat(n(tc, 1, 20)) + word(tc, DIGITS, 0, 10); // leading zeros, often more than 10 characters in all
+                case 3 -> text = word(tc, DIGITS + "-", 1, 12);
+                default -> text = word(tc, DIGITS + "- +.aZ\u0000\u007f", 1, 12);
+            }
+            int index = n(tc, 0, 20);
+            MutableDirectBuffer b = buffer(tc, 64);
+            b.setMemory(0, b.capacity(), (byte) '7'); // digits around the span must not leak in
+            b.putStringWithoutLengthAscii(index, text);
+            Supplier<String> ctx = () -> "text " + show(text) + " at " + index + " in " + b.getClass().getSimpleName();
+
+            boolean wellFormed = text.matches("-?[0-9]+");
+            BigInteger big = wellFormed ? new BigInteger(text) : null;
+            boolean fitsInt = wellFormed && big.bitLength() < 32;
+            boolean fitsLong = wellFormed && big.bitLength() < 64;
+            boolean natural = wellFormed && !text.startsWith("-");
+            int digits = wellFormed ? text.length() - (natural ? 0 : 1) : 0;
+            if (fitsInt && digits > AsciiEncoding.INT_MAX_DIGITS || fitsLong && digits > AsciiEncoding.LONG_MAX_DIGITS) {
+                return; // bug agrona/2: leading zeros beyond the digit budget are rejected as overflow (pin_leadingZerosParse)
+            }
+
+            Object viaInt = attempt(() -> b.parseIntAscii(index, text.length()));
+            Object viaLong = attempt(() -> b.parseLongAscii(index, text.length()));
+            Object viaNaturalInt = attempt(() -> b.parseNaturalIntAscii(index, text.length()));
+            Object viaNaturalLong = attempt(() -> b.parseNaturalLongAscii(index, text.length()));
+            Object viaCsInt = attempt(() -> AsciiEncoding.parseIntAscii(text, 0, text.length()));
+            Object viaCsLong = attempt(() -> AsciiEncoding.parseLongAscii(text, 0, text.length()));
+
+            expect("parseIntAscii", fitsInt ? big.intValue() : null, viaInt, ctx);
+            expect("AsciiEncoding.parseIntAscii", fitsInt ? big.intValue() : null, viaCsInt, ctx);
+            expect("parseLongAscii", fitsLong ? big.longValue() : null, viaLong, ctx);
+            expect("AsciiEncoding.parseLongAscii", fitsLong ? big.longValue() : null, viaCsLong, ctx);
+            expect("parseNaturalIntAscii", natural && fitsInt ? big.intValue() : null, viaNaturalInt, ctx);
+            expect("parseNaturalLongAscii", natural && fitsLong ? big.longValue() : null, viaNaturalLong, ctx);
+        }, Zoo.settings("agrona.asciiParsersMatchTheJdk"));
+    }
+
+    static Object attempt(Supplier<Object> parse) {
+        try {
+            return parse.get();
+        } catch (NumberFormatException e) {
+            return e;
+        }
+    }
