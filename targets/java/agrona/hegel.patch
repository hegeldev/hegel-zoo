index 0000000..f1e1daf
--- /dev/null
+++ b/hegel/src/test/java/zoo/AgronaPinsTest.java
@@ -0,0 +1,116 @@
+package zoo;
+
+import static zoo.Zoo.check;
+
+import java.nio.charset.StandardCharsets;
+import org.agrona.AsciiEncoding;
+import org.agrona.ExpandableArrayBuffer;
+import org.agrona.ExpandableDirectByteBuffer;
+import org.agrona.ExpandableRingBuffer;
+import org.agrona.MutableDirectBuffer;
+import org.agrona.concurrent.UnsafeBuffer;
+import org.junit.jupiter.api.Test;
+
+/**
+ * One pin per recorded bug (bugs.toml). Each asserts the correct behaviour on a minimal input and is listed in
+ * [expected_failures] of target.toml, so it fails while the bug exists and flags the fix when it stops failing.
+ */
+class AgronaPinsTest {
+
+    /** agrona/1: putNaturalIntAsciiFromEnd(0, end) must write "0" and return end - 1; it writes nothing and returns end. */
+    @Test
+    void pin_naturalIntFromEndWritesZero() {
+        UnsafeBuffer b = new UnsafeBuffer(new byte[8]);
+        b.setMemory(0, 8, (byte) 'x');
+        int start = b.putNaturalIntAsciiFromEnd(0, 5);
+        String written = b.getStringWithoutLengthAscii(0, 8);
+        check(start == 4 && written.equals("xxxx0xxx"), () -> "putNaturalIntAsciiFromEnd(0, 5) returned " + start + " and left " + written + " (digitCount(0) is " + AsciiEncoding.digitCount(0) + ")");
+    }
+
+    /** agrona/2: a decimal int with leading zeros is rejected as "int overflow" once it is longer than 10 characters. */
+    @Test
+    void pin_leadingZerosParse() {
+        UnsafeBuffer b = new UnsafeBuffer(new byte[32]);
+        String text = "00000000001";
+        int length = b.putStringWithoutLengthAscii(0, text);
+        check(parseInt(() -> b.parseIntAscii(0, length)).equals("1"), () -> "parseIntAscii(" + text + ") gave " + parseInt(() -> b.parseIntAscii(0, length)) + "; parseLongAscii gives " + b.parseLongAscii(0, length));
+        check(parseInt(() -> b.parseNaturalIntAscii(0, length)).equals("1"), () -> "parseNaturalIntAscii(" + text + ") gave " + parseInt(() -> b.parseNaturalIntAscii(0, length)));
+        check(parseInt(() -> AsciiEncoding.parseIntAscii(text, 0, text.length())).equals("1"), () -> "AsciiEncoding.parseIntAscii(" + text + ") gave " + parseInt(() -> AsciiEncoding.parseIntAscii(text, 0, text.length())));
+        // the same in the long parser past 19 characters
+        String longText = "00000000000000000001";
+        int longLength = b.putStringWithoutLengthAscii(0, longText);
+        check(parseInt(() -> b.parseLongAscii(0, longLength)).equals("1"), () -> "parseLongAscii(" + longText + ") gave " + parseInt(() -> b.parseLongAscii(0, longLength)));
+        // and Agrona's own padded writer produces such strings
+        b.putNaturalPaddedIntAscii(0, 11, 5);
+        String padded = b.getStringWithoutLengthAscii(0, 11);
+        check(parseInt(() -> b.parseNaturalIntAscii(0, 11)).equals("5"), () -> "putNaturalPaddedIntAscii(0, 11, 5) wrote " + padded + " which parseNaturalIntAscii(0, 11) reads as " + parseInt(() -> b.parseNaturalIntAscii(0, 11)));
+    }
+
+    static String parseInt(java.util.function.Supplier<Object> parse) {
+        try {
+            return String.valueOf(parse.get());
+        } catch (NumberFormatException e) {
+            return e.getClass().getSimpleName() + ": " + e.getMessage();
+        }
+    }
+
+    /**
+     * agrona/3: ExpandableRingBuffer.append writes past the end of its buffer when the free space is split between
+     * the end and the front, the record fits in neither part and the ring may not grow; it must return false instead.
+     */
+    @Test
+    void pin_expandableRingAppendSplitSpace() {
+        ExpandableRingBuffer ring = new ExpandableRingBuffer(64, 64, false);
+        UnsafeBuffer src = new UnsafeBuffer(new byte[64]);
+        for (int i = 0; i < 64; i++) {
+            src.putByte(i, (byte) (i + 1));
+        }
+        check(ring.append(src, 0, 8) && ring.append(src, 0, 32), () -> "setup appends failed");
+        check(ring.consume((b, o, l, h) -> true, 1) == 16, () -> "setup consume did not remove the first record");
+        // head 16, tail 56: 8 bytes free at the end, 16 at the front; a 24-byte record fits in neither
+        boolean appended;
+        try {
+            appended = ring.append(src, 0, 15);
+        } catch (RuntimeException e) {
+            check(false, () -> "append threw " + e + " with size " + ring.size() + " of capacity " + ring.capacity());
+            return;
+        }
+        check(!appended || ring.size() == 40 + 24, () -> "append returned " + appended + " with size " + ring.size());
+        // whatever it returned, the ring must still hand back the 32-byte message intact
+        byte[][] seen = new byte[1][];
+        ring.consume((b, o, l, h) -> { seen[0] = new byte[l]; b.getBytes(o, seen[0]); return true; }, 1);
+        check(seen[0] != null && seen[0].length == 32 && seen[0][0] == 1 && seen[0][31] == 32, () -> "the queued message came back damaged");
+    }
+
+    /**
+     * agrona/4: an expandable buffer copying from itself grows for the destination before the source range is
+     * checked, so a source beyond the capacity is read (as zeros) instead of throwing IndexOutOfBoundsException.
+     */
+    @Test
+    void pin_expandableSelfCopyChecksSource() {
+        ExpandableArrayBuffer array = new ExpandableArrayBuffer(16);
+        ExpandableDirectByteBuffer direct = new ExpandableDirectByteBuffer(16);
+        check(threw(() -> array.getBytes(8, array, 20, 12)), () -> "ExpandableArrayBuffer(16).getBytes(8, this, 20, 12) read past the capacity and grew to " + array.capacity());
+        check(threw(() -> direct.getBytes(8, direct, 20, 12)), () -> "ExpandableDirectByteBuffer(16).getBytes(8, this, 20, 12) read past the capacity and grew to " + direct.capacity());
+        ExpandableArrayBuffer array2 = new ExpandableArrayBuffer(16);
+        check(threw(() -> array2.putBytes(20, array2, 8, 12)), () -> "ExpandableArrayBuffer(16).putBytes(20, this, 8, 12) read past the capacity and grew to " + array2.capacity());
+    }
+
+    static boolean threw(Runnable r) {
+        try {
+            r.run();
+            return false;
+        } catch (IndexOutOfBoundsException e) {
+            return true;
+        }
+    }
+
+    /** Sanity: the harness itself sees the documented behaviours these pins build on. */
+    @Test
+    void pinsPreconditions() {
+        MutableDirectBuffer b = new ExpandableArrayBuffer(4);
+        check(b.putIntAscii(0, 0) == 1 && b.getStringWithoutLengthAscii(0, 1).equals("0"), () -> "putIntAscii(0)");
+        check(b.parseIntAscii(0, b.putStringWithoutLengthAscii(0, "0000000001")) == 1, () -> "ten characters with leading zeros parse");
+        check(new String(AsciiEncoding.MIN_INTEGER_VALUE, StandardCharsets.US_ASCII).equals("-2147483648"), () -> "MIN_INTEGER_VALUE");
+    }
+}
diff --git a/hegel/src/test/java/zoo/BuffersTest.java b/hegel/src/test/java/zoo/BuffersTest.java
new file mode 100644
index 0000000..ba82877
--- /dev/null
+++ b/hegel/src/test/java/zoo/BuffersTest.java
@@ -0,0 +1,455 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+import static zoo.Zoo.show;
+
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.function.Supplier;
+import org.agrona.DirectBuffer;
+import org.agrona.ExpandableArrayBuffer;
+import org.agrona.ExpandableDirectByteBuffer;
+import org.agrona.MutableDirectBuffer;
+import org.agrona.concurrent.UnsafeBuffer;
+import org.junit.jupiter.api.Test;
+
+/**
+ * The three buffer implementations against a plain {@code byte[]} model driven through {@link ByteBuffer}: every
+ * primitive put/get with every byte order, byte-array/ByteBuffer/DirectBuffer copies (including overlapping self
+ * copies), setMemory, bounds checks (an exception for fixed buffers, growth for expandable ones), and equals/hashCode/
+ * compareTo against a twin holding the same bytes.
+ */
+class BuffersTest {
+
+    static final class Sut {
+        final MutableDirectBuffer buffer;
+        final String kind;
+        final boolean expandable;
+        byte[] model;
+
+        Sut(MutableDirectBuffer buffer, String kind, boolean expandable, int capacity) {
+            this.buffer = buffer;
+            this.kind = kind;
+            this.expandable = expandable;
+            this.model = new byte[capacity];
+        }
+
+        /** A buffer of the same class holding the given bytes (equals requires the same class). */
+        MutableDirectBuffer twin(byte[] bytes) {
+            if (buffer instanceof ExpandableArrayBuffer) {
+                ExpandableArrayBuffer t = new ExpandableArrayBuffer(bytes.length);
+                t.putBytes(0, bytes);
+                return t;
+            }
+            if (buffer instanceof ExpandableDirectByteBuffer) {
+                ExpandableDirectByteBuffer t = new ExpandableDirectByteBuffer(bytes.length);
+                t.putBytes(0, bytes);
+                return t;
+            }
+            return new UnsafeBuffer(bytes.clone());
+        }
+    }
+
+    static Sut sut(TestCase tc, int capacity) {
+        switch (n(tc, 0, 5)) {
+            case 0 -> { return new Sut(new UnsafeBuffer(new byte[capacity]), "UnsafeBuffer(byte[])", false, capacity); }
+            case 1 -> {
+                int offset = n(tc, 0, 16);
+                return new Sut(new UnsafeBuffer(new byte[capacity + offset + n(tc, 0, 16)], offset, capacity), "UnsafeBuffer(byte[], " + offset + ", " + capacity + ")", false, capacity);
+            }
+            case 2 -> {
+                int offset = n(tc, 0, 8);
+                return new Sut(new UnsafeBuffer(ByteBuffer.allocate(capacity + offset + 8), offset, capacity), "UnsafeBuffer(heap ByteBuffer, " + offset + ")", false, capacity);
+            }
+            case 3 -> {
+                int offset = n(tc, 0, 8);
+                return new Sut(new UnsafeBuffer(ByteBuffer.allocateDirect(capacity + offset + 8), offset, capacity), "UnsafeBuffer(direct ByteBuffer, " + offset + ")", false, capacity);
+            }
+            case 4 -> { return new Sut(new ExpandableArrayBuffer(capacity), "ExpandableArrayBuffer", true, capacity); }
+            default -> { return new Sut(new ExpandableDirectByteBuffer(capacity), "ExpandableDirectByteBuffer", true, capacity); }
+        }
+    }
+
+    static ByteOrder order(TestCase tc) {
+        return switch (n(tc, 0, 2)) {
+            case 0 -> ByteOrder.nativeOrder();
+            case 1 -> ByteOrder.LITTLE_ENDIAN;
+            default -> ByteOrder.BIG_ENDIAN;
+        };
+    }
+
+    /** An index that is usually valid, sometimes just outside, occasionally negative. */
+    static int index(TestCase tc, int capacity) {
+        return switch (n(tc, 0, 9)) {
+            case 0 -> n(tc, capacity - 8, capacity + 8);
+            case 1 -> pick(tc, -1, Integer.MIN_VALUE, Integer.MAX_VALUE, capacity, capacity + 1);
+            default -> n(tc, 0, Math.max(0, capacity - 1));
+        };
+    }
+
+    static int length(TestCase tc, int max) {
+        return switch (n(tc, 0, 9)) {
+            case 0 -> pick(tc, -1, Integer.MIN_VALUE, Integer.MAX_VALUE, max + 1);
+            case 1 -> 0;
+            default -> n(tc, 0, Math.max(0, max));
+        };
+    }
+
+    interface Op {
+        void run() throws Throwable;
+    }
+
+    /** Runs the operation on the buffer and the model: both must succeed, or both must fail with IndexOutOfBounds. */
+    static void both(String what, Sut s, Op onBuffer, Op onModel, boolean modelFits, Supplier<String> ctx) {
+        Throwable fromBuffer = attempt(onBuffer);
+        if (s.expandable && modelFits && s.buffer.capacity() > s.model.length) {
+            s.model = Arrays.copyOf(s.model, s.buffer.capacity()); // the buffer grew; new bytes are zero
+        }
+        Throwable fromModel = modelFits ? attempt(onModel) : new IndexOutOfBoundsException("model");
+        if (fromModel == null) {
+            check(fromBuffer == null, () -> what + " threw " + fromBuffer + " but the model succeeded\n" + ctx.get());
+        } else {
+            check(fromBuffer instanceof IndexOutOfBoundsException, () -> what + (fromBuffer == null ? " succeeded" : " threw " + fromBuffer) + " but the model threw " + fromModel + "\n" + ctx.get());
+        }
+    }
+
+    static Throwable attempt(Op op) {
+        try {
+            op.run();
+            return null;
+        } catch (Throwable t) {
+            if (t.getClass().getName().startsWith("dev.hegel.")) {
+                Zoo.<RuntimeException>sneaky(t);
+            }
+            return t;
+        }
+    }
+
+    static boolean fits(Sut s, long index, long length) {
+        if (index < 0 || length < 0) {
+            return false;
+        }
+        if (s.expandable) {
+            return index + length <= ExpandableArrayBuffer.MAX_ARRAY_LENGTH && index + length <= 1 << 20; // keep growth bounded
+        }
+        return index + length <= s.model.length;
+    }
+
+    static boolean readable(Sut s, long index, long length) {
+        return index >= 0 && length >= 0 && index + length <= s.model.length;
+    }
+
+    /** Grows the model to the buffer's capacity after a put on an expandable buffer (new bytes are zero). */
+    static void syncCapacity(Sut s, Supplier<String> ctx) {
+        int capacity = s.buffer.capacity();
+        if (s.expandable) {
+            check(capacity >= s.model.length, () -> "capacity shrank to " + capacity + "\n" + ctx.get());
+            if (capacity > s.model.length) {
+                s.model = Arrays.copyOf(s.model, capacity);
+            }
+        } else {
+            check(capacity == s.model.length, () -> "capacity changed to " + capacity + "\n" + ctx.get());
+        }
+    }
+
+    static byte[] contents(MutableDirectBuffer b) {
+        byte[] bytes = new byte[b.capacity()];
+        b.getBytes(0, bytes);
+        return bytes;
+    }
+
+    @Test
+    void buffersMatchAByteArrayModel() {
+        Hegel.test(tc -> {
+            int capacity = pick(tc, n(tc, 0, 24), n(tc, 8, 96), 128, 200);
+            Sut s = sut(tc, capacity);
+            List<String> log = new ArrayList<>();
+            Supplier<String> ctx = () -> s.kind + " capacity " + s.model.length + " after " + log + "\nmodel  " + show(s.model) + "\nagrona " + show(contents(s.buffer));
+            int steps = n(tc, 1, 40);
+            for (int step = 0; step < steps; step++) {
+                MutableDirectBuffer b = s.buffer;
+                int cap = s.model.length;
+                int i = index(tc, cap);
+                ByteOrder o = order(tc);
+                switch (n(tc, 0, 17)) {
+                    case 0 -> {
