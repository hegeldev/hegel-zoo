+            int minCapacity = oneToOne ? OneToOneRingBuffer.MIN_CAPACITY : ManyToOneRingBuffer.MIN_CAPACITY;
+            int maxMsg = capacity == minCapacity ? 0 : Math.max(HEADER, capacity >> 3); // the smallest ring only carries empty messages
+            check(ring.maxMsgLength() == maxMsg, () -> "maxMsgLength " + ring.maxMsgLength() + ", expected " + maxMsg + "\n" + ctx.get());
