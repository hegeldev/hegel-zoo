+    /** {@code expected == null} means "must throw a NumberFormatException (Agrona's AsciiNumberFormatException)". */
+    static void expect(String what, Object expected, Object actual, Supplier<String> ctx) {
+        if (expected == null) {
+            check(actual instanceof AsciiNumberFormatException, () -> what + " should have thrown, gave " + show(actual) + "\n" + ctx.get());
+        } else {
+            check(expected.equals(actual), () -> what + " gave " + show(actual) + ", expected " + expected + "\n" + ctx.get());
+        }
+    }
