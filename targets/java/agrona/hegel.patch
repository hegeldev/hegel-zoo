+    /** old + 1, avoiding the missing value (which a mapping function may not return unless it means removal). */
+    static int plusOne(int old, int missing) {
+        int next = old == Integer.MAX_VALUE ? Integer.MIN_VALUE : old + 1;
+        return next == missing ? (next == Integer.MAX_VALUE ? Integer.MIN_VALUE : next + 1) : next;
+    }
