+    @Test
+    void stringCodecsRoundTrip() {
+        Hegel.test(tc -> {
+            boolean utf8 = chance(tc, 50);
+            String s = anyString(tc, !utf8);
+            byte[] encoded = s.getBytes(utf8 ? StandardCharsets.UTF_8 : StandardCharsets.ISO_8859_1);
+            int index = n(tc, 0, 20);
+            MutableDirectBuffer b = buffer(tc, encoded.length + 64);
+            int orderChoice = n(tc, 0, 2);
+            ByteOrder order = orderChoice == 0 ? null : orderChoice == 1 ? ByteOrder.LITTLE_ENDIAN : ByteOrder.BIG_ENDIAN;
+            Supplier<String> ctx = () -> (utf8 ? "utf8 " : "ascii ") + show(s) + " at " + index + " order " + order + " in " + b.getClass().getSimpleName();
+            int written;
+            String back;
+            String backWithLength;
+            int prefix;
+            if (utf8) {
+                written = order == null ? b.putStringUtf8(index, s) : b.putStringUtf8(index, s, order);
+                back = order == null ? b.getStringUtf8(index) : b.getStringUtf8(index, order);
+                prefix = order == null ? b.getInt(index) : b.getInt(index, order);
+                backWithLength = b.getStringUtf8(index, prefix);
+            } else {
+                written = order == null ? b.putStringAscii(index, s) : b.putStringAscii(index, s, order);
+                back = order == null ? b.getStringAscii(index) : b.getStringAscii(index, order);
+                prefix = order == null ? b.getInt(index) : b.getInt(index, order);
+                backWithLength = b.getStringAscii(index, prefix);
+            }
+            check(written == 4 + encoded.length, () -> "put returned " + written + ", expected " + (4 + encoded.length) + "\n" + ctx.get());
+            check(prefix == encoded.length, () -> "length prefix " + prefix + ", expected " + encoded.length + "\n" + ctx.get());
+            check(s.equals(back), () -> "round trip gave " + show(back) + "\n" + ctx.get());
+            check(s.equals(backWithLength), () -> "get with explicit length gave " + show(backWithLength) + "\n" + ctx.get());
+            byte[] raw = new byte[encoded.length];
+            b.getBytes(index + 4, raw);
+            check(Arrays.equals(raw, encoded), () -> "bytes differ from the JDK encoding\n" + ctx.get());
+
+            // the length-less variants
+            b.setMemory(0, b.capacity(), (byte) 0);
+            int w2 = utf8 ? b.putStringWithoutLengthUtf8(index, s) : b.putStringWithoutLengthAscii(index, s);
+            check(w2 == encoded.length, () -> "putStringWithoutLength returned " + w2 + "\n" + ctx.get());
