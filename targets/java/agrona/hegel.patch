+            if (!utf8) {
+                StringBuilder sb = new StringBuilder();
+                int n1 = b.getStringWithoutLengthAscii(index, encoded.length, sb);
+                check(n1 == encoded.length && sb.toString().equals(s), () -> "getStringWithoutLengthAscii(Appendable) gave " + show(sb) + " (" + n1 + ")\n" + ctx.get());
+                int from = n(tc, 0, s.length());
+                int len = n(tc, 0, s.length() - from);
+                int w3 = b.putStringWithoutLengthAscii(index, s, from, len);
+                check(w3 == len && b.getStringWithoutLengthAscii(index, len).equals(s.substring(from, from + len)), () -> "putStringWithoutLengthAscii(offset, length) wrong\n" + ctx.get());
+            } else {
+                int max = n(tc, 0, encoded.length + 4);
+                boolean threw = false;
+                try {
+                    b.putStringUtf8(index, s, max);
+                } catch (IllegalArgumentException e) {
+                    threw = true;
+                }
+                boolean t = threw;
+                check(t == (encoded.length > max), () -> "putStringUtf8 with maxEncodedLength " + max + (t ? " threw" : " accepted") + " " + encoded.length + " bytes\n" + ctx.get());
+            }
+        }, Zoo.settings("agrona.stringCodecsRoundTrip"));
+    }
