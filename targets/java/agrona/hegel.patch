+    @Test
+    void fourAndEightDigitHelpers() {
+        Hegel.test(tc -> {
+            byte[] bytes = new byte[8];
+            for (int i = 0; i < 8; i++) {
+                int alt = pick(tc, '0' - 1, '9' + 1, (int) ' ', (int) '-', 0, 0x7f, 0x80, 0xff, n(tc, 0, 255));
+                bytes[i] = (byte) (chance(tc, 85) ? '0' + n(tc, 0, 9) : alt);
+            }
+            int four = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN).getInt(0);
+            long eight = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN).getLong(0);
+            boolean fourDigits = true;
+            boolean eightDigits = true;
+            for (int i = 0; i < 8; i++) {
+                boolean digit = bytes[i] >= '0' && bytes[i] <= '9';
+                eightDigits &= digit;
+                if (i < 4) {
+                    fourDigits &= digit;
+                }
+                byte bi = bytes[i];
+                check(AsciiEncoding.isDigit(bi) == digit, () -> "isDigit(" + bi + ")");
+            }
+            String text = new String(bytes, StandardCharsets.ISO_8859_1);
+            boolean four4 = fourDigits;
+            boolean eight8 = eightDigits;
+            check(AsciiEncoding.isFourDigitsAsciiEncodedNumber(four) == four4, () -> "isFourDigitsAsciiEncodedNumber(" + show(text.substring(0, 4)) + ") = " + !four4);
+            check(AsciiEncoding.isEightDigitAsciiEncodedNumber(eight) == eight8, () -> "isEightDigitAsciiEncodedNumber(" + show(text) + ") = " + !eight8);
+            if (fourDigits) {
+                check(AsciiEncoding.parseFourDigitsLittleEndian(four) == Integer.parseInt(text.substring(0, 4)), () -> "parseFourDigitsLittleEndian(" + text.substring(0, 4) + ") = " + AsciiEncoding.parseFourDigitsLittleEndian(four));
+            }
+            if (eightDigits) {
+                check(AsciiEncoding.parseEightDigitsLittleEndian(eight) == Integer.parseInt(text), () -> "parseEightDigitsLittleEndian(" + text + ") = " + AsciiEncoding.parseEightDigitsLittleEndian(eight));
+            }
+            for (int i = 0; i < 4; i++) {
+                if (bytes[i] >= '0' && bytes[i] <= '9') {
+                    check(AsciiEncoding.getDigit(i, bytes[i]) == bytes[i] - '0', () -> "getDigit");
+                } else {
+                    byte value = bytes[i];
+                    boolean threw = false;
+                    try {
+                        AsciiEncoding.getDigit(i, value);
+                    } catch (AsciiNumberFormatException e) {
+                        threw = true;
+                    }
+                    check(threw, () -> "getDigit(" + value + ") did not throw");
+                }
+            }
+        }, Zoo.settings("agrona.fourAndEightDigitHelpers"));
+    }
