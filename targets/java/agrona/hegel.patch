+            List<String> log = new ArrayList<>();
+            Supplier<String> ctx = () -> (oneToOne ? "OneToOne" : "ManyToOne") + " capacity " + capacity + " after " + log + "\nmodel head " + model.head + " tail " + model.tail + " records " + model.records + "\nring producer " + ring.producerPosition() + " consumer " + ring.consumerPosition() + " size " + ring.size();
