+    static String anyString(TestCase tc, boolean asciiOnly) {
+        if (asciiOnly) {
+            return word(tc, " !\"#$%&'()*+,-./0123456789:;<=>?@ABCXYZ[\\]^_`abcxyz{|}~\u0000\u007f", 0, 40);
+        }
+        return switch (n(tc, 0, 3)) {
+            case 0 -> word(tc, "aZ0 éßЖ中€한ﬁ", 0, 30);
+            case 1 -> {
+                StringBuilder sb = new StringBuilder();
+                for (int i = n(tc, 0, 6); i > 0; i--) {
+                    sb.appendCodePoint(pick(tc, 0x1F600, 0x10000, 0x10FFFF, 0x1D11E, 0x7FF, 0x800, 0xFFFF, 0x7F, 0x80, 0xD7FF, 0xE000));
+                }
+                yield sb.toString();
+            }
+            default -> word(tc, "abcé中", 0, 200);
+        };
+    }
