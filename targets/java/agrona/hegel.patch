+
+/**
+ * The two inter-thread ring buffers driven from a single thread against a model that replicates the documented
+ * record layout (8-byte aligned records, padding at the wrap, one header of slack in the one-to-one variant):
+ * write/tryClaim/commit/abort results, positions, sizes and everything read back in order.
+ */
+class RingBufferTest {
+
+    static final int HEADER = 8;
+
+    static final class Rec {
+        final int index;
+        final int aligned;
+        final int type;
+        final byte[] payload;
+        boolean padding;
+        boolean committed;
+
+        Rec(int index, int aligned, int type, byte[] payload, boolean padding, boolean committed) {
+            this.index = index;
+            this.aligned = aligned;
+            this.type = type;
+            this.payload = payload;
+            this.padding = padding;
+            this.committed = committed;
+        }
+
+        @Override
+        public String toString() {
+            return (padding ? "pad" : committed ? "msg" : "claim") + "@" + index + "[" + aligned + (padding ? "" : ", type " + type + ", " + payload.length + " bytes") + "]";
+        }
+    }
+
+    /** A sequential model of the ring: positions plus the records between head and tail. */
+    static final class Model {
+        final int capacity;
+        final boolean oneToOne;
+        long head;
+        long tail;
+        final ArrayDeque<Rec> records = new ArrayDeque<>();
+
+        Model(int capacity, boolean oneToOne) {
+            this.capacity = capacity;
+            this.oneToOne = oneToOne;
+        }
+
+        /** Claims space for a message; returns the record index or -1 for insufficient capacity. */
+        int claim(int type, byte[] payload, boolean committed) {
+            int mask = capacity - 1;
+            int aligned = BitUtil.align(payload.length + HEADER, 8);
+            int required = oneToOne ? aligned + HEADER : aligned;
+            if (required > capacity - (int) (tail - head)) {
+                return -1;
+            }
+            int tailIndex = (int) tail & mask;
+            int toEnd = capacity - tailIndex;
+            if (oneToOne && aligned == toEnd) {
+                records.add(new Rec(tailIndex, aligned, type, payload, false, committed));
+                tail += aligned;
+                return tailIndex;
+            }
+            if (required > toEnd) {
+                int headIndex = (int) head & mask;
+                records.add(new Rec(tailIndex, toEnd, 0, new byte[0], true, true));
+                tail += toEnd;
+                if (required > headIndex) {
+                    return -1;
+                }
+                records.add(new Rec(0, aligned, type, payload, false, committed));
+                tail += aligned;
+                return 0;
+            }
+            records.add(new Rec(tailIndex, aligned, type, payload, false, committed));
+            tail += aligned;
+            return tailIndex;
+        }
+
+        /**
+         * Reads as the ring buffer does: a contiguous block up to the end of the buffer, stopping at a claim. A COMMIT
+         * moves the head but the read never continues past the end of the buffer (the block boundary is fixed when the
+         * read starts: the javadoc allows an implementation to return at the wrap and be called again).
+         */
+        List<Rec> read(int limit, List<ControlledMessageHandler.Action> actions) {
+            int mask = capacity - 1;
+            int position = (int) head & mask;
+            int bytesRead = 0;
+            List<Rec> delivered = new ArrayList<>();
+            Iterator<Rec> it = records.iterator();
+            while (position + bytesRead < capacity && delivered.size() < limit && it.hasNext()) {
+                Rec r = it.next();
+                if (!r.committed) {
+                    break;
+                }
+                if (r.padding) {
+                    bytesRead += r.aligned;
+                    it.remove();
+                    continue;
+                }
+                ControlledMessageHandler.Action action = actions == null ? ControlledMessageHandler.Action.CONTINUE : actions.get(delivered.size());
+                if (action == ControlledMessageHandler.Action.ABORT) {
+                    break;
+                }
+                bytesRead += r.aligned;
+                it.remove();
+                delivered.add(r);
+                if (action == ControlledMessageHandler.Action.BREAK) {
+                    break;
+                }
+                if (action == ControlledMessageHandler.Action.COMMIT) {
+                    head += bytesRead;
+                    position += bytesRead;
+                    bytesRead = 0;
+                }
+            }
+            head += bytesRead;
+            return delivered;
+        }
+
+        long size() {
+            return tail - head;
+        }
+    }
+
+    static RingBuffer ring(boolean oneToOne, int capacity) {
+        UnsafeBuffer buffer = new UnsafeBuffer(BufferUtil.allocateDirectAligned(capacity + RingBufferDescriptor.TRAILER_LENGTH, 8));
+        return oneToOne ? new OneToOneRingBuffer(buffer) : new ManyToOneRingBuffer(buffer);
+    }
+
+    static byte[] bytes(dev.hegel.TestCase tc, int length) {
+        byte[] b = new byte[length];
+        for (int i = 0; i < length; i++) {
+            b[i] = (byte) n(tc, -128, 127);
+        }
+        return b;
+    }
+
+    record Delivered(int type, byte[] payload) {
+        @Override
+        public String toString() {
+            return type + ":" + show(payload);
+        }
+    }
+
+    @Test
+    void ringBuffersMatchTheRecordModel() {
