@@ -0,0 +1,48 @@
+package zoo;
+
+import com.networknt.schema.Error;
+import com.networknt.schema.Schema;
+import com.networknt.schema.SchemaRegistry;
+import com.networknt.schema.SchemaRegistryConfig;
+import com.networknt.schema.SpecificationVersion;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.JsonNode;
+
+/** One plain test per recorded bug (bugs.toml); each fails while the bug is present. */
+class PinsTest {
+    static List<Error> failFast(String schema, String instance) {
+        SchemaRegistryConfig config = SchemaRegistryConfig.builder().failFast(true).build();
+        Schema s = SchemaRegistry.withDefaultDialect(SpecificationVersion.DRAFT_2020_12, b -> b.schemaRegistryConfig(config)).getSchema(Gen.M.readTree(schema));
+        return s.validate(Gen.M.readTree(instance));
+    }
+
+    static List<Error> validate(SpecificationVersion v, String schema, String instance) {
+        return SchemaRegistry.withDefaultDialect(v).getSchema(Gen.M.readTree(schema)).validate(Gen.M.readTree(instance));
+    }
+
+    /** Bug 2: contains with maxContains below (the default) minContains makes non-arrays invalid. */
+    @Test
+    void hegelPinContainsBoundsIgnoreNonArrays() {
+        for (SpecificationVersion v : new SpecificationVersion[] {SpecificationVersion.DRAFT_2019_09, SpecificationVersion.DRAFT_2020_12}) {
+            List<Error> plain = validate(v, "{\"contains\":true,\"maxContains\":0}", "5");
+            Zoo.check(plain.isEmpty(), v + ": {contains: true, maxContains: 0} rejects the integer 5: " + plain);
+            List<Error> typed = validate(v, "{\"type\":\"integer\",\"contains\":true,\"maxContains\":0}", "5");
+            Zoo.check(typed.isEmpty(), v + ": {type: integer, contains: true, maxContains: 0} rejects the integer 5: " + typed);
+            List<Error> explicit = validate(v, "{\"contains\":true,\"minContains\":2,\"maxContains\":1}", "\"x\"");
+            Zoo.check(explicit.isEmpty(), v + ": {contains: true, minContains: 2, maxContains: 1} rejects the string x with " + explicit.size() + " errors: " + explicit);
+        }
+    }
+
+    /** Bug 1: unevaluatedProperties reports every offending property under failFast. */
+    @Test
+    void hegelPinUnevaluatedPropertiesHonoursFailFast() {
+        String instance = "{\"a\":1,\"b\":2,\"c\":3}";
+        List<Error> additional = failFast("{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\"}}", instance);
+        Zoo.check(additional.size() == 1, "additionalProperties under failFast: " + additional);
+        List<Error> unevaluated = failFast("{\"type\":\"object\",\"unevaluatedProperties\":{\"type\":\"string\"}}", instance);
+        Zoo.check(unevaluated.size() == 1, "unevaluatedProperties under failFast reports " + unevaluated.size() + " errors: " + unevaluated);
+        List<Error> forbidden = failFast("{\"type\":\"object\",\"unevaluatedProperties\":false}", instance);
+        Zoo.check(forbidden.size() == 1, "unevaluatedProperties: false under failFast reports " + forbidden.size() + " errors: " + forbidden);
+    }
+}
diff --git a/hegel/src/test/java/zoo/SchemaTest.java b/hegel/src/test/java/zoo/SchemaTest.java
new file mode 100644
index 0000000..6fd3dd0
--- /dev/null
+++ b/hegel/src/test/java/zoo/SchemaTest.java
@@ -0,0 +1,401 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import com.networknt.schema.Error;
+import com.networknt.schema.InputFormat;
+import com.networknt.schema.OutputFormat;
+import com.networknt.schema.output.OutputFlag;
+import com.networknt.schema.output.OutputUnit;
+import com.networknt.schema.Schema;
+import com.networknt.schema.SchemaLocation;
+import com.networknt.schema.SchemaRegistry;
+import com.networknt.schema.SchemaRegistryConfig;
+import com.networknt.schema.SchemaException;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.node.ObjectNode;
+import tools.jackson.dataformat.yaml.YAMLMapper;
+
+/**
+ * networknt/json-schema-validator against Python's jsonschema (the oracle in {@link Oracle}) and
+ * against its own documentation: validity across drafts, error locations, output formats and
+ * meta-schema validation.
+ */
+class SchemaTest {
+    static final YAMLMapper YAML = YAMLMapper.builder().build();
+
+    /** Findings recorded in bugs.toml; each gate keeps the property from re-reporting one. */
+    static final class Known {
+        /** Bug 1: unevaluatedProperties disables fail-fast for its own errors, so validation reports them all. */
+        static boolean unevaluatedPropertiesIgnoreFailFast(JsonNode schema) {
+            return Gen.M.writeValueAsString(schema).contains("\"unevaluatedProperties\"");
+        }
+
+        /** Bug 2: minContains above maxContains is reported as an instance error, even for non-arrays. */
+        static boolean minContainsAboveMaxContains(List<Error> errors) {
+            for (Error e : errors) {
+                if (e.getKeyword().equals("minContainsVsMaxContains")) {
+                    return true;
+                }
+            }
+            return false;
+        }
+    }
+
+    /** Whether Zoo counts should be printed (collect mode). */
+    static void stats(String name) {
+        if (Zoo.COLLECT) {
+            System.out.println("STATS " + name + " " + Zoo.stats());
+        }
+    }
+
+    static SchemaRegistry registry(Gen.Draft d, Boolean formats) {
+        SchemaRegistryConfig config = SchemaRegistryConfig.builder().formatAssertionsEnabled(formats).build();
+        return SchemaRegistry.withDefaultDialect(d.version, b -> b.schemaRegistryConfig(config));
+    }
+
+    static Schema compile(Gen.Draft d, JsonNode schema, boolean formats) {
+        return registry(d, formats).getSchema(schema);
+    }
+
+    static String pointer(Error e) {
+        return e.getInstanceLocation().toString();
+    }
+
+    /** Sorted "path keyword" lines, the shape shared with the oracle. */
+    static List<String> lines(List<String> paths, List<String> keywords) {
+        return lines(paths, keywords, false);
+    }
+
+    /**
+     * With {@code comparable}, the lines are normalised for the comparison with python-jsonschema:
+     * python attributes too few contains matches to "contains" or "minContains" depending on the
+     * count (this library always to minContains when the keyword is present), and reports a
+     * {@code false} subschema's error at the parent's location with no keyword (a quirk of its
+     * descend), so those errors are left out on both sides.
+     */
+    static List<String> lines(List<String> paths, List<String> keywords, boolean comparable) {
+        List<String> out = new ArrayList<>();
+        for (int i = 0; i < paths.size(); i++) {
+            String kw = keywords.get(i);
+            if (comparable) {
+                if (kw.equals("false") || kw.isEmpty()) {
+                    continue;
+                }
+                if (kw.equals("minContains")) {
+                    kw = "contains";
+                }
+            }
+            out.add(paths.get(i) + " " + kw);
+        }
+        java.util.Collections.sort(out);
+        return out;
+    }
+
+    static List<String> lines(List<Error> errors) {
+        return lines(errors, false);
+    }
+
+    static List<String> lines(List<Error> errors, boolean comparable) {
+        List<String> paths = new ArrayList<>();
+        List<String> keywords = new ArrayList<>();
+        for (Error e : errors) {
+            paths.add(pointer(e));
+            keywords.add(e.getKeyword());
+        }
+        return lines(paths, keywords, comparable);
+    }
+
+    static java.util.Set<String> pathsOf(List<String> lines) {
+        java.util.Set<String> out = new java.util.TreeSet<>();
+        for (String l : lines) {
+            out.add(l.substring(0, l.lastIndexOf(' ')));
+        }
+        return out;
+    }
+
+    static String describe(Gen.Draft d, JsonNode schema, JsonNode instance) {
+        return "draft " + d + " schema " + schema + " instance " + instance;
+    }
+
+    /** Property 1: valid/invalid agrees with python-jsonschema on every draft, with and without format assertions. */
+    @Test
+    void hegelValidationAgreesWithPythonJsonschema() {
+        Oracle oracle = Oracle.get();
+        Hegel.test(tc -> {
+            Gen.Draft d = Gen.draft(tc);
+            Gen.Options opt = new Gen.Options();
+            ObjectNode schema = Gen.root(tc, d, opt);
+            boolean formats = chance(tc, 50);
+            Schema compiled;
+            try {
+                compiled = compile(d, schema, formats);
+            } catch (SchemaException e) {
+                Zoo.fail("compiling a schema the generator built: " + e + " for " + schema);
+                return;
+            }
+            int cases = n(tc, 1, 4);
+            for (int i = 0; i < cases; i++) {
+                JsonNode instance = Gen.guided(tc, schema, 3);
+                Oracle.Verdict py = oracle.validate(schema, instance, formats);
+                if (py == null) {
+                    continue;
+                }
+                List<Error> errors = compiled.validate(instance);
+                boolean valid = errors.isEmpty();
+                if (Known.minContainsAboveMaxContains(errors)) {
+                    continue;
+                }
+                Zoo.count(valid ? "valid" : "invalid");
+                Zoo.count("draft " + d);
+                Zoo.check(valid == py.valid, "validity " + valid + " but python says " + py.valid + " (python errors " + lines(py.paths, py.keywords) + ", java " + lines(errors) + ", formats " + formats + ") for " + describe(d, schema, instance));
+            }
+        }, Zoo.settings("hegelValidationAgreesWithPythonJsonschema"));
+        stats("hegelValidationAgreesWithPythonJsonschema");
+    }
+
+    /** Property 2: for flat schemas the failing instance locations and keywords agree with python. */
+    @Test
+    void hegelErrorLocationsMatchTheFailingInstances() {
+        Oracle oracle = Oracle.get();
+        Hegel.test(tc -> {
+            Gen.Draft d = Gen.draft(tc);
+            Gen.Options opt = new Gen.Options();
+            opt.combinators = false;
+            opt.refs = false;
+            opt.unevaluated = false;
+            ObjectNode schema = Gen.root(tc, d, opt);
+            boolean formats = chance(tc, 50);
+            Schema compiled = compile(d, schema, formats);
+            JsonNode instance = Gen.guided(tc, schema, 3);
+            Oracle.Verdict py = oracle.validate(schema, instance, formats);
+            if (py == null) {
+                return;
+            }
+            List<Error> errors = compiled.validate(instance);
+            if (py.valid != errors.isEmpty() || Known.minContainsAboveMaxContains(errors)) {
+                return; // property 1's business
+            }
+            List<String> expected = lines(py.paths, py.keywords, true);
+            List<String> actual = lines(errors, true);
+            Zoo.count(expected.isEmpty() ? "no errors" : expected.size() == 1 ? "one error" : "several errors");
+            java.util.Set<String> expectedPaths = pathsOf(expected);
+            java.util.Set<String> actualPaths = pathsOf(actual);
+            Zoo.check(expectedPaths.equals(actualPaths), "error locations " + actualPaths + " but python has " + expectedPaths + " (java " + actual + ", python " + expected + ", formats " + formats + ") for " + describe(d, schema, instance));
+            // keywords: compare as sets of (path, keyword) - python reports one error for every extra
+            // property or item of additionalProperties/items: false, this library one per offender
+            java.util.Set<String> ek = new java.util.TreeSet<>(expected);
+            java.util.Set<String> ak = new java.util.TreeSet<>(actual);
+            Zoo.check(ek.equals(ak), "errors " + actual + " but python has " + expected + " (formats " + formats + ") for " + describe(d, schema, instance));
+        }, Zoo.settings("hegelErrorLocationsMatchTheFailingInstances"));
+        stats("hegelErrorLocationsMatchTheFailingInstances");
+    }
+
+    /** Property 3: every output format, fail-fast and the string/YAML inputs agree with validate(JsonNode). */
+    @Test
+    void hegelOutputFormatsAgree() {
+        Hegel.test(tc -> {
+            Gen.Draft d = Gen.draft(tc);
+            Gen.Options opt = new Gen.Options();
+            ObjectNode schema = Gen.root(tc, d, opt);
+            boolean formats = chance(tc, 50);
+            Schema compiled = compile(d, schema, formats);
+            JsonNode instance = Gen.guided(tc, schema, 3);
+            List<Error> errors = compiled.validate(instance);
+            boolean valid = errors.isEmpty();
+            String what = describe(d, schema, instance);
+            Zoo.count(valid ? "valid" : "invalid");
+
+            Zoo.check(compiled.validate(instance, OutputFormat.BOOLEAN) == valid, "BOOLEAN output " + !valid + " but validate() gives " + valid + " for " + what);
+            OutputFlag flag = compiled.validate(instance, OutputFormat.FLAG);
+            Zoo.check(flag.isValid() == valid, "FLAG output " + flag.isValid() + " but validate() gives " + valid + " for " + what);
+            List<Error> again = compiled.validate(instance, OutputFormat.DEFAULT);
+            Zoo.check(lines(again).equals(lines(errors)), "DEFAULT output " + lines(again) + " but validate() gives " + lines(errors) + " for " + what);
+
+            OutputUnit list = compiled.validate(instance, OutputFormat.LIST);
+            Zoo.check(list.isValid() == valid, "LIST output valid=" + list.isValid() + " but validate() gives " + valid + " for " + what);
+            java.util.Set<String> listPaths = new java.util.TreeSet<>();
+            collectPaths(list, listPaths);
+            java.util.Set<String> errorPaths = new java.util.TreeSet<>();
+            for (Error e : errors) {
+                errorPaths.add(pointer(e));
+            }
+            Zoo.check(valid || listPaths.equals(errorPaths), "LIST output error locations " + listPaths + " but validate() gives " + errorPaths + " for " + what);
+
+            OutputUnit tree = compiled.validate(instance, OutputFormat.HIERARCHICAL);
+            Zoo.check(tree.isValid() == valid, "HIERARCHICAL output valid=" + tree.isValid() + " but validate() gives " + valid + " for " + what);
+            java.util.Set<String> treePaths = new java.util.TreeSet<>();
+            collectPaths(tree, treePaths);
+            Zoo.check(valid || treePaths.equals(errorPaths), "HIERARCHICAL output error locations " + treePaths + " but validate() gives " + errorPaths + " for " + what);
+
+            com.networknt.schema.Result result = compiled.validate(instance, OutputFormat.RESULT);
+            Zoo.check(result.getErrors().isEmpty() == valid, "RESULT output " + result.getErrors().size() + " errors but validate() gives " + errors.size() + " for " + what);
+
+            List<Error> fast = compiled.validate(instance, exec -> exec.executionConfig(b -> b.failFast(true)));
+            Zoo.check(fast.isEmpty() == valid, "fail-fast validation " + fast + " but validate() gives " + errors + " for " + what);
+            // anyOf/oneOf evaluate their branches without fail-fast and report every branch's errors
+            // together when the keyword fails, so only schemas without them must stop at one error
+            String text = Gen.M.writeValueAsString(schema);
+            if (!text.contains("\"anyOf\"") && !text.contains("\"oneOf\"") && !Known.unevaluatedPropertiesIgnoreFailFast(schema)) {
+                Zoo.check(fast.size() <= 1, "fail-fast validation reports " + fast.size() + " errors " + lines(fast) + " for " + what);
+            }
+
+            String json = Gen.M.writeValueAsString(instance);
+            List<Error> fromString = compiled.validate(json, InputFormat.JSON);
+            Zoo.check(lines(fromString).equals(lines(errors)), "validate(String) gives " + lines(fromString) + " but validate(JsonNode) " + lines(errors) + " for " + what);
+            if (!hasProblemYaml(instance)) {
+                String yaml = YAML.writeValueAsString(instance);
+                List<Error> fromYaml;
+                try {
+                    fromYaml = compiled.validate(yaml, InputFormat.YAML);
+                } catch (RuntimeException e) {
+                    Zoo.fail("validate(YAML) threw " + e + " on " + Zoo.show(yaml) + " for " + what);
+                    return;
+                }
+                Zoo.check(fromYaml.isEmpty() == valid, "validate(YAML) gives " + lines(fromYaml) + " but validate(JsonNode) " + lines(errors) + " on " + Zoo.show(yaml) + " for " + what);
+            }
+        }, Zoo.settings("hegelOutputFormatsAgree"));
+        stats("hegelOutputFormatsAgree");
+    }
+
+    /** YAML has no way to keep 1.0 apart from 1 across a Jackson round trip for every case; skip floats that print as integers. */
+    static boolean hasProblemYaml(JsonNode node) {
+        if (node.isFloatingPointNumber()) {
+            return true;
+        }
+        for (JsonNode c : node) {
+            if (hasProblemYaml(c)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static void collectPaths(OutputUnit unit, java.util.Set<String> out) {
+        if (unit.getErrors() != null && !unit.getErrors().isEmpty()) {
+            out.add(unit.getInstanceLocation() == null ? "" : unit.getInstanceLocation());
+        }
+        if (unit.getDetails() != null) {
+            for (OutputUnit child : unit.getDetails()) {
+                collectPaths(child, out);
+            }
+        }
+    }
+
+    /** Property 4: schema documents (mutated at random) validated against the draft meta-schema agree with python's check_schema. */
+    @Test
+    void hegelMetaSchemaValidationAgreesWithCheckSchema() {
+        Oracle oracle = Oracle.get();
+        Hegel.test(tc -> {
+            Gen.Draft d = Gen.draft(tc);
+            Gen.Options opt = new Gen.Options();
+            ObjectNode doc = Gen.root(tc, d, opt);
+            int mutations = n(tc, 0, 3);
+            for (int i = 0; i < mutations; i++) {
+                Gen.mutate(tc, doc);
+            }
+            doc.put("$schema", d.id); // the mutation may have touched it; keep the draft fixed
+            boolean py = oracle.checkSchema(doc);
+            Schema meta = registry(d, null).getSchema(SchemaLocation.of(d.id));
+            List<Error> errors = new ArrayList<>(meta.validate(doc));
+            if (d.level == 6 || d.level == 7) {
+                // python's vendored draft-06/07 meta-schemas predate the published ones' enum
+                // constraints (minItems 1, uniqueItems), which this library's copies carry
+                errors.removeIf(e -> (e.getKeyword().equals("minItems") || e.getKeyword().equals("uniqueItems")) && pointer(e).endsWith("/enum"));
+            }
+            Zoo.count(py ? "valid schema" : "invalid schema");
+            Zoo.check(errors.isEmpty() == py, "meta-schema validation " + (errors.isEmpty() ? "accepts" : "rejects " + lines(errors)) + " but python check_schema says " + py + " for draft " + d + " document " + doc);
+            if (py) {
+                // a valid schema compiles and validates something; a $ref that is not a string (which
+                // only the draft 4 meta-schema leaves unconstrained) may be refused with the documented
+                // SchemaException
+                try {
+                    compile(d, doc, false).validate(Gen.value(tc, 2));
+                } catch (SchemaException e) {
+                    Zoo.check(hasNonStringRef(doc), "a schema python accepts fails to compile or validate: " + e + " for draft " + d + " document " + doc);
+                } catch (RuntimeException e) {
+                    Zoo.fail("a schema python accepts fails to compile or validate: " + e + " for draft " + d + " document " + doc);
+                }
+            }
+        }, Zoo.settings("hegelMetaSchemaValidationAgreesWithCheckSchema"));
+        stats("hegelMetaSchemaValidationAgreesWithCheckSchema");
+    }
+
+    static boolean hasNonStringRef(JsonNode node) {
+        if (node.isObject()) {
+            if (node.has("$ref") && !node.get("$ref").isString()) {
+                return true;
+            }
+            for (JsonNode c : node) {
+                if (hasNonStringRef(c)) {
+                    return true;
+                }
+            }
+        } else if (node.isArray()) {
+            for (JsonNode c : node) {
+                if (hasNonStringRef(c)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    /** Property 5: typeLoose and losslessNarrowing follow their documentation. */
+    @Test
+    void hegelTypeLooseAndNarrowingFollowTheirDocs() {
+        Hegel.test(tc -> {
+            Gen.Draft d = Gen.draft(tc);
+            String type = pick(tc, "integer", "number", "boolean", "array", "null", "string", "object");
+            ObjectNode schema = Gen.M.createObjectNode();
+            schema.put("$schema", d.id);
+            schema.put("type", type);
+            boolean loose = chance(tc, 50);
+            SchemaRegistryConfig config = SchemaRegistryConfig.builder().typeLoose(loose).build();
+            Schema compiled = SchemaRegistry.withDefaultDialect(d.version, b -> b.schemaRegistryConfig(config)).getSchema(schema);
+            JsonNode instance = Gen.value(tc, 2);
+            boolean strict = strictType(d, type, instance);
+            boolean expected = strict;
+            if (loose && !strict) {
+                if (instance.isString()) {
+                    String s = instance.asString();
+                    expected = switch (type) {
+                        case "integer" -> s.matches("[+-]?[0-9]+");
+                        case "number" -> s.matches("[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)([eE][+-]?[0-9]+)?");
+                        case "boolean" -> s.equals("true") || s.equals("false");
+                        default -> false;
+                    };
+                }
+                if (type.equals("array") && !instance.isArray()) {
+                    expected = true; // "a scalar is treated as a one-element array"
+                }
+            }
+            List<Error> errors = compiled.validate(instance);
+            Zoo.count(loose ? "loose" : "strict");
+            Zoo.check(errors.isEmpty() == expected, "typeLoose=" + loose + " type " + type + " on " + instance + " gives " + (errors.isEmpty() ? "valid" : "invalid") + " but the documentation says " + (expected ? "valid" : "invalid"));
+        }, Zoo.settings("hegelTypeLooseAndNarrowingFollowTheirDocs"));
+        stats("hegelTypeLooseAndNarrowingFollowTheirDocs");
+    }
+
+    /** Draft 4 defines integer as a number without fraction or exponent; drafts 6+ accept 3.0 as an integer. */
+    static boolean strictType(Gen.Draft d, String type, JsonNode v) {
+        return switch (type) {
+            case "integer" -> v.isNumber() && (v.isIntegralNumber() || (d.atLeast(6) && v.asDouble() == Math.rint(v.asDouble())));
+            case "number" -> v.isNumber();
+            case "boolean" -> v.isBoolean();
+            case "array" -> v.isArray();
+            case "null" -> v.isNull();
+            case "string" -> v.isString();
+            default -> v.isObject();
+        };
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..3a4b425
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,128 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    private static final java.util.Map<String, Integer> STATS = new java.util.TreeMap<>();
+
+    /** Bumps a statistic; the counts are printed in collect mode (ZOO_COLLECT=1) via {@link #stats()}. */
+    static synchronized void count(String key) {
+        STATS.merge(key, 1, Integer::sum);
+    }
+
+    /** The statistics so far, cleared, as one line. */
+    static synchronized String stats() {
+        String s = STATS.toString();
+        STATS.clear();
+        return s;
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
