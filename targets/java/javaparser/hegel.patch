+    // ---- compilation units ----------------------------------------------------------------------
+
+    /** One (70%) or two to three top-level types. */
+    static Generator<List<String>> types(Flags f) {
+        Generator<String> top = level(TOP, f).typeDeclTop;
+        return weighted(w(7, many(top, 1, 1)), w(3, many(top, 2, 3)));
+    }
+
+    /** A class with a method body first, then zero to two more types. */
+    static Generator<List<String>> typesWithBody(Flags f) {
+        return tuples(level(TOP, f).classWithBody(), many(level(TOP, f).typeDeclTop, 0, 2)).map(t -> {
+            List<String> out = new ArrayList<>();
+            out.add(t.value1());
+            out.addAll(t.value2());
+            return out;
+        });
+    }
+
+    /** A compilation unit with marks: a comment (15%), a package (50%), imports (50%), the types, a stray `;` after the first (10%). */
+    static Generator<String> unit(Generator<List<String>> types) {
+        return unit(types, Gen.<List<String>>maybe(50, List.of(), many(IMPORT, 1, 3)));
+    }
+
+    /** The same with the given imports. */
+    static Generator<String> unit(Generator<List<String>> types, Generator<List<String>> imports) {
+        return tuples(opt(15, COMMENT.map(c -> c + NL)), opt(50, QUALIFIED_NAME.map(q -> "package" + SP + q + OSP + ";" + NL)), imports,
+                types, chance(10))
+            .map(t -> {
+                StringBuilder sb = new StringBuilder(t.value1()).append(t.value2()).append(joined(t.value3(), ""));
+                List<String> decls = t.value4();
+                for (int i = 0; i < decls.size(); i++) {
+                    // a stray semicolon after the first declaration (javac rejects one right after the imports)
+                    sb.append(i == 1 && t.value5() ? ";" + NL : "").append(decls.get(i)).append(NL);
+                }
+                return sb.toString();
+            });
+    }
+
+    /** The marked text rendered: separators and line breaks from the trivia tapes, `var` for the remaining lambda marks, the feature marks collected. */
+    static Program render(String marked, Trivia trivia, boolean crlf) {
+        StringBuilder sb = new StringBuilder();
+        Set<String> features = new HashSet<>();
+        int sp = 0;
+        int osp = 0;
+        int nl = 0;
+        for (int i = 0; i < marked.length(); i++) {
+            char c = marked.charAt(i);
+            switch (c) {
+                case '\001' -> sb.append(at(trivia.seps(), sp++));
+                case '\002' -> sb.append(at(trivia.oseps(), osp++));
+                case '\003' -> sb.append(at(trivia.lines(), nl++));
+                case '\004' -> sb.append("var");
+                case '\005' -> sb.append("Anon");
+                case '\006' -> features.add("nestedUnary");
+                case '\007' -> features.add("legacyDims");
+                case '\016' -> features.add("methodDims");
+                default -> sb.append(c);
+            }
+        }
+        String text = sb.toString();
+        return new Program(crlf ? text.replace("\n", "\r\n") : text, features);
+    }
+
+    static Generator<Program> program(Generator<List<String>> types) {
+        return rendered(unit(types));
+    }
+
+    /** The marked unit rendered with a drawn trivia tape, one time in seven with CRLF line endings. */
+    static Generator<Program> rendered(Generator<String> unit) {
+        return tuples(unit, TRIVIA, chance(15)).map(t -> render(t.value1(), t.value2(), t.value3()));
+    }
