+            cs.add(w(1, forStmt));
+            cs.add(w(1, forEach));
+            cs.add(w(1, jump));
+            cs.add(w(1, labelled));
+            cs.add(w(1, bblock(ctx)));
+            cs.add(w(1, sync));
+            cs.add(w(1, assertStmt));
+            cs.add(w(1, tryStmt(ctx)));
+            cs.add(w(2, switchStmt(ctx)));
+            if (ctx.decl()) {
+                cs.add(w(1, d >= LOCAL_TYPES ? (b == null ? just(";") : b.typeDeclLocal) : just(";")));
+            }
+            cs.add(w(1, ctx.yield() ? yieldExpr().map(e -> "yield" + SP + e + ";") : expressionStmt));
+            return weighted(cs);
+        }
