+import java.util.TreeSet;
+
+/**
+ * JavaParser's AST as a canonical S-expression, in the vocabulary {@link JavacShape} also produces from javac's tree:
+ * declarations, statements and expressions by kind and operator, types and names as whitespace-free text, literals
+ * by their decoded value, one entry per declared variable, modifiers as a sorted keyword set.
+ */
+final class Shape {
+
+    private final StringBuilder sb = new StringBuilder();
+
+    static String of(CompilationUnit cu) {
+        Shape s = new Shape();
+        s.compilationUnit(cu);
+        return s.sb.toString();
+    }
+
+    static String ofExpression(Expression e) {
+        Shape s = new Shape();
+        s.expr(e);
+        return s.sb.toString();
+    }
+
+    static String ofStatement(Statement st) {
+        Shape s = new Shape();
+        s.stmt(st);
+        return s.sb.toString();
+    }
+
+    private void open(String tag) {
+        sb.append('(').append(tag);
+    }
+
+    private void close() {
+        sb.append(')');
+    }
+
+    private void atom(String s) {
+        sb.append(' ').append(s);
+    }
+
+    private void text(String s) {
+        sb.append(" \"").append(s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r")).append('"');
+    }
+
+    // ---- compilation unit -----------------------------------------------------------------------
+
+    void compilationUnit(CompilationUnit cu) {
+        open("cu");
+        Optional<PackageDeclaration> pkg = cu.getPackageDeclaration();
+        if (pkg.isPresent()) {
+            open("pkg");
+            name(pkg.get().getName());
+            close();
+        }
+        for (ImportDeclaration imp : cu.getImports()) {
+            open("import");
+            if (imp.isStatic()) {
+                atom("static");
+            }
+            name(imp.getName());
+            if (imp.isAsterisk()) {
+                atom("*");
+            }
+            close();
+        }
+        for (TypeDeclaration<?> t : cu.getTypes()) {
+            typeDecl(t);
+        }
+        close();
+    }
+
+    /** A (possibly qualified) name as nested field accesses, as javac has it. */
+    void name(Name n) {
+        if (n.getQualifier().isPresent()) {
+            open("field");
+            name(n.getQualifier().get());
+            atom(n.getIdentifier());
+            close();
+        } else {
+            open("name");
+            atom(n.getIdentifier());
+            close();
+        }
+    }
+
+    void nameText(String qualified) {
+        int dot = qualified.lastIndexOf('.');
+        if (dot >= 0) {
+            open("field");
+            nameText(qualified.substring(0, dot));
+            atom(qualified.substring(dot + 1));
+            close();
+        } else {
+            open("name");
+            atom(qualified);
+            close();
+        }
+    }
+
+    // ---- declarations ---------------------------------------------------------------------------
+
+    void modifiers(NodeList<Modifier> mods, NodeList<AnnotationExpr> anns) {
+        TreeSet<String> set = new TreeSet<>();
+        for (Modifier m : mods) {
+            set.add(m.getKeyword().asString());
+        }
+        open("mods");
+        for (String s : set) {
+            atom(s);
+        }
+        close();
+        open("anns");
+        for (AnnotationExpr a : anns) {
+            annotation(a);
+        }
+        close();
+    }
+
+    void annotation(AnnotationExpr a) {
+        open("ann");
+        name(a.getName());
+        if (a instanceof SingleMemberAnnotationExpr) {
+            open("pair");
+            atom("value");
+            expr(((SingleMemberAnnotationExpr) a).getMemberValue());
+            close();
+        } else if (a instanceof NormalAnnotationExpr) {
+            for (MemberValuePair p : ((NormalAnnotationExpr) a).getPairs()) {
+                open("pair");
+                atom(p.getNameAsString());
+                expr(p.getValue());
+                close();
+            }
+        } else if (!(a instanceof MarkerAnnotationExpr)) {
+            atom("?" + a.getClass().getSimpleName());
+        }
+        close();
+    }
+
+    void typeDecl(TypeDeclaration<?> t) {
+        if (t instanceof ClassOrInterfaceDeclaration) {
+            ClassOrInterfaceDeclaration c = (ClassOrInterfaceDeclaration) t;
+            open(c.isInterface() ? "interface" : "class");
+            atom(c.getNameAsString());
+            modifiers(c.getModifiers(), c.getAnnotations());
+            typeParameters(c.getTypeParameters());
+            open("extends");
+            for (ClassOrInterfaceType x : c.getExtendedTypes()) {
+                type(x);
+            }
+            close();
+            open("implements");
+            for (ClassOrInterfaceType x : c.getImplementedTypes()) {
+                type(x);
+            }
+            close();
+            open("permits");
+            for (ClassOrInterfaceType x : c.getPermittedTypes()) {
+                type(x);
+            }
+            close();
+            members(c.getMembers(), false);
+            close();
+        } else if (t instanceof EnumDeclaration) {
+            EnumDeclaration e = (EnumDeclaration) t;
+            open("enum");
+            atom(e.getNameAsString());
+            modifiers(e.getModifiers(), e.getAnnotations());
+            open("implements");
+            for (ClassOrInterfaceType x : e.getImplementedTypes()) {
+                type(x);
+            }
+            close();
+            open("members");
+            for (EnumConstantDeclaration k : e.getEntries()) {
+                open("enumconst");
+                atom(k.getNameAsString());
+                open("anns");
+                for (AnnotationExpr a : k.getAnnotations()) {
+                    annotation(a);
+                }
+                close();
+                args(k.getArguments());
+                if (!k.getClassBody().isEmpty()) {
+                    members(k.getClassBody(), false);
+                }
+                close();
+            }
+            for (BodyDeclaration<?> m : e.getMembers()) {
+                member(m, false);
+            }
+            close();
+            close();
+        } else if (t instanceof RecordDeclaration) {
+            RecordDeclaration r = (RecordDeclaration) t;
+            open("record");
+            atom(r.getNameAsString());
+            modifiers(r.getModifiers(), r.getAnnotations());
+            typeParameters(r.getTypeParameters());
+            open("implements");
+            for (ClassOrInterfaceType x : r.getImplementedTypes()) {
+                type(x);
+            }
+            close();
+            open("members");
+            for (Parameter p : r.getParameters()) {
+                open("component");
+                open("anns");
+                for (AnnotationExpr a : p.getAnnotations()) {
+                    annotation(a);
+                }
+                close();
+                atom(typeText(p.getType()) + (p.isVarArgs() ? "[]" : ""));
+                atom(p.getNameAsString());
+                close();
+            }
+            for (BodyDeclaration<?> m : r.getMembers()) {
+                member(m, false);
+            }
+            close();
+            close();
+        } else if (t instanceof AnnotationDeclaration) {
+            AnnotationDeclaration a = (AnnotationDeclaration) t;
+            open("annotationtype");
+            atom(a.getNameAsString());
+            modifiers(a.getModifiers(), a.getAnnotations());
+            members(a.getMembers(), true);
+            close();
+        } else {
+            open("?" + t.getClass().getSimpleName());
+            close();
+        }
+    }
+
+    void typeParameters(NodeList<TypeParameter> tps) {
+        open("tps");
+        for (TypeParameter tp : tps) {
+            open("tp");
+            atom(tp.getNameAsString());
+            open("anns");
+            for (AnnotationExpr a : tp.getAnnotations()) {
+                annotation(a);
+            }
+            close();
+            for (ClassOrInterfaceType b : tp.getTypeBound()) {
+                type(b);
+            }
+            close();
+        }
+        close();
+    }
+
+    void members(NodeList<BodyDeclaration<?>> ms, boolean annotationType) {
+        open("members");
+        for (BodyDeclaration<?> m : ms) {
+            member(m, annotationType);
+        }
+        close();
+    }
+
+    void member(BodyDeclaration<?> m, boolean annotationType) {
+        if (m instanceof FieldDeclaration) {
+            FieldDeclaration f = (FieldDeclaration) m;
+            for (VariableDeclarator v : f.getVariables()) {
+                open("field");
+                modifiers(f.getModifiers(), f.getAnnotations());
+                type(v.getType());
+                atom(v.getNameAsString());
+                if (v.getInitializer().isPresent()) {
+                    expr(v.getInitializer().get());
+                }
+                close();
+            }
+        } else if (m instanceof MethodDeclaration) {
+            MethodDeclaration d = (MethodDeclaration) m;
+            open("method");
+            atom(d.getNameAsString());
+            modifiers(d.getModifiers(), d.getAnnotations());
+            typeParameters(d.getTypeParameters());
+            type(d.getType());
+            parameters(d.getParameters(), d.getReceiverParameter());
+            throwsList(d.getThrownExceptions());
+            if (d.getBody().isPresent()) {
+                stmt(d.getBody().get());
+            }
+            close();
+        } else if (m instanceof ConstructorDeclaration) {
+            ConstructorDeclaration d = (ConstructorDeclaration) m;
+            open("ctor");
+            modifiers(d.getModifiers(), d.getAnnotations());
+            typeParameters(d.getTypeParameters());
+            parameters(d.getParameters(), d.getReceiverParameter());
+            throwsList(d.getThrownExceptions());
+            stmt(d.getBody());
+            close();
+        } else if (m instanceof CompactConstructorDeclaration) {
+            CompactConstructorDeclaration d = (CompactConstructorDeclaration) m;
+            open("compactctor");
+            modifiers(d.getModifiers(), d.getAnnotations());
+            typeParameters(d.getTypeParameters());
+            throwsList(d.getThrownExceptions());
+            stmt(d.getBody());
+            close();
+        } else if (m instanceof InitializerDeclaration) {
+            InitializerDeclaration d = (InitializerDeclaration) m;
+            open("init");
+            if (d.isStatic()) {
+                atom("static");
+            }
+            stmt(d.getBody());
+            close();
+        } else if (m instanceof AnnotationMemberDeclaration) {
+            AnnotationMemberDeclaration d = (AnnotationMemberDeclaration) m;
+            open("annmember");
+            atom(d.getNameAsString());
+            modifiers(d.getModifiers(), d.getAnnotations());
+            type(d.getType());
+            if (d.getDefaultValue().isPresent()) {
+                open("default");
+                expr(d.getDefaultValue().get());
+                close();
+            }
+            close();
+        } else if (m instanceof TypeDeclaration) {
+            typeDecl((TypeDeclaration<?>) m);
+        } else {
+            open("?" + m.getClass().getSimpleName());
+            close();
+        }
+    }
+
+    void parameters(NodeList<Parameter> ps, Optional<ReceiverParameter> receiver) {
+        open("params");
+        if (receiver.isPresent()) {
+            open("receiver");
+            type(receiver.get().getType());
+            atom(receiver.get().getName().asString());
+            close();
+        }
+        for (Parameter p : ps) {
+            parameter(p);
+        }
+        close();
+    }
+
+    void parameter(Parameter p) {
+        open("param");
+        modifiers(p.getModifiers(), p.getAnnotations());
+        atom(typeText(p.getType()) + (p.isVarArgs() ? "[]" : ""));
+        atom(p.getNameAsString());
+        close();
+    }
+
+    void throwsList(NodeList<? extends Type> ts) {
+        open("throws");
+        for (Type t : ts) {
+            type(t);
+        }
+        close();
+    }
+
+    static final com.github.javaparser.printer.configuration.PrinterConfiguration NO_COMMENTS = new com.github.javaparser.printer.configuration.DefaultPrinterConfiguration()
+            .removeOption(new com.github.javaparser.printer.configuration.DefaultConfigurationOption(com.github.javaparser.printer.configuration.DefaultPrinterConfiguration.ConfigOption.PRINT_COMMENTS));
+
+    /** A type as text, annotations included, white space removed. */
+    static String typeText(Type t) {
+        return t instanceof VarType ? "var" : squash(t.toString(NO_COMMENTS));
+    }
+
+    void type(Type t) {
+        atom(typeText(t));
+    }
+
+    // ---- statements -----------------------------------------------------------------------------
+
+    void stmts(NodeList<Statement> list) {
+        for (Statement s : list) {
+            stmt(s);
+        }
+    }
+
+    void stmt(Statement s) {
+        if (s instanceof ExpressionStmt) {
+            Expression e = ((ExpressionStmt) s).getExpression();
+            if (e instanceof VariableDeclarationExpr) {
+                locals((VariableDeclarationExpr) e);
+            } else {
+                open("expr");
+                expr(e);
+                close();
+            }
+        } else if (s instanceof BlockStmt) {
+            open("block");
+            stmts(((BlockStmt) s).getStatements());
+            close();
+        } else if (s instanceof ReturnStmt) {
+            open("return");
+            ((ReturnStmt) s).getExpression().ifPresent(this::expr);
+            close();
+        } else if (s instanceof IfStmt) {
+            IfStmt i = (IfStmt) s;
+            open("if");
+            expr(i.getCondition());
+            stmt(i.getThenStmt());
+            i.getElseStmt().ifPresent(this::stmt);
+            close();
+        } else if (s instanceof WhileStmt) {
+            open("while");
+            expr(((WhileStmt) s).getCondition());
+            stmt(((WhileStmt) s).getBody());
+            close();
+        } else if (s instanceof DoStmt) {
+            open("do");
+            stmt(((DoStmt) s).getBody());
+            expr(((DoStmt) s).getCondition());
+            close();
+        } else if (s instanceof ForStmt) {
+            ForStmt f = (ForStmt) s;
+            open("for");
+            open("init");
+            for (Expression e : f.getInitialization()) {
+                if (e instanceof VariableDeclarationExpr) {
+                    locals((VariableDeclarationExpr) e);
+                } else {
+                    expr(e);
+                }
+            }
+            close();
+            open("cond");
+            f.getCompare().ifPresent(this::expr);
+            close();
+            open("update");
+            for (Expression e : f.getUpdate()) {
+                expr(e);
+            }
+            close();
+            stmt(f.getBody());
+            close();
+        } else if (s instanceof ForEachStmt) {
+            ForEachStmt f = (ForEachStmt) s;
+            open("foreach");
+            locals(f.getVariable());
+            expr(f.getIterable());
+            stmt(f.getBody());
+            close();
+        } else if (s instanceof BreakStmt) {
+            open("break");
+            ((BreakStmt) s).getLabel().ifPresent(l -> atom(l.asString()));
+            close();
+        } else if (s instanceof ContinueStmt) {
+            open("continue");
+            ((ContinueStmt) s).getLabel().ifPresent(l -> atom(l.asString()));
+            close();
+        } else if (s instanceof ThrowStmt) {
+            open("throw");
+            expr(((ThrowStmt) s).getExpression());
+            close();
+        } else if (s instanceof YieldStmt) {
+            open("yield");
+            expr(((YieldStmt) s).getExpression());
+            close();
+        } else if (s instanceof EmptyStmt) {
+            open("empty");
+            close();
+        } else if (s instanceof LabeledStmt) {
+            open("label");
+            atom(((LabeledStmt) s).getLabel().asString());
+            stmt(((LabeledStmt) s).getStatement());
+            close();
+        } else if (s instanceof SynchronizedStmt) {
+            open("sync");
+            expr(((SynchronizedStmt) s).getExpression());
+            stmt(((SynchronizedStmt) s).getBody());
+            close();
+        } else if (s instanceof AssertStmt) {
+            open("assert");
+            expr(((AssertStmt) s).getCheck());
+            ((AssertStmt) s).getMessage().ifPresent(this::expr);
+            close();
+        } else if (s instanceof TryStmt) {
+            TryStmt t = (TryStmt) s;
+            open("try");
+            open("resources");
+            for (Expression r : t.getResources()) {
+                if (r instanceof VariableDeclarationExpr) {
+                    locals((VariableDeclarationExpr) r);
+                } else {
+                    expr(r);
+                }
+            }
+            close();
+            stmt(t.getTryBlock());
+            for (CatchClause c : t.getCatchClauses()) {
+                open("catch");
+                parameter(c.getParameter());
+                stmt(c.getBody());
+                close();
+            }
+            if (t.getFinallyBlock().isPresent()) {
+                open("finally");
+                stmt(t.getFinallyBlock().get());
+                close();
+            }
+            close();
+        } else if (s instanceof SwitchStmt) {
+            open("switch");
+            expr(((SwitchStmt) s).getSelector());
+            for (SwitchEntry e : ((SwitchStmt) s).getEntries()) {
+                switchEntry(e);
+            }
+            close();
+        } else if (s instanceof ExplicitConstructorInvocationStmt) {
+            ExplicitConstructorInvocationStmt c = (ExplicitConstructorInvocationStmt) s;
+            open("ctorcall");
+            atom(c.isThis() ? "this" : "super");
+            if (c.getExpression().isPresent()) {
+                expr(c.getExpression().get());
+            }
+            typeArgs(c.getTypeArguments());
+            args(c.getArguments());
+            close();
+        } else if (s instanceof LocalClassDeclarationStmt) {
+            typeDecl(((LocalClassDeclarationStmt) s).getClassDeclaration());
+        } else if (s instanceof LocalRecordDeclarationStmt) {
+            typeDecl(((LocalRecordDeclarationStmt) s).getRecordDeclaration());
+        } else {
+            open("?" + s.getClass().getSimpleName());
+            close();
+        }
+    }
+
+    void locals(VariableDeclarationExpr d) {
+        for (VariableDeclarator v : d.getVariables()) {
+            open("local");
+            modifiers(d.getModifiers(), d.getAnnotations());
+            type(v.getType());
+            atom(v.getNameAsString());
+            if (v.getInitializer().isPresent()) {
+                expr(v.getInitializer().get());
+            }
+            close();
+        }
+    }
+
+    void switchEntry(SwitchEntry e) {
+        open("case");
+        open("labels");
+        for (Expression l : e.getLabels()) {
+            expr(l);
+        }
+        if (e.isDefault()) {
+            atom("default");
+        }
+        close();
+        if (e.getGuard().isPresent()) {
+            open("guard");
+            expr(e.getGuard().get());
+            close();
+        }
+        switch (e.getType()) {
+            case STATEMENT_GROUP:
+                atom("group");
+                stmts(e.getStatements());
+                break;
+            case EXPRESSION:
+                atom("rule");
+                if (e.getStatements().size() == 1 && e.getStatements().get(0) instanceof ExpressionStmt) {
+                    expr(((ExpressionStmt) e.getStatements().get(0)).getExpression());
+                } else {
+                    stmts(e.getStatements());
+                }
+                break;
+            default:
+                atom("rule");
+                stmts(e.getStatements());
+        }
+        close();
+    }
