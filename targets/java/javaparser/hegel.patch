+            w(chance(tc, 50) ? "0x" : "0X").w(underscore(tc, pick(tc, "0", "1F", "ff", "7fffffff", "80000000", "FFFFFFFF", "CAFE", "0a", Integer.toHexString(n(tc, 0, 99999)))));
