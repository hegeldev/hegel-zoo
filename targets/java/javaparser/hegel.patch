+     * A lambda, a cast lambda or a method reference standing alone (as a whole argument, in parentheses or as an
+     * assignment's right side). Known bug: JavaParser cannot parse a cast lambda or a method reference used as an operand
+     * (`(Runnable) () -> {} == r`, `this::m ? a : b`), so those never appear as operands (pins carry them).
+     */
+    /** Contexts where javac's parser refuses lambdas (case guards). */
+    int noLambda;
+
+    void standaloneFunctional() {
+        int r = n(tc, 1, 4);
+        if (noLambda > 0) {
+            r = r == 2 ? 2 : 0;
+        }
+        if (r == 0) {
+            expression(0);
+            return;
+        }
+        if (r == 1) {
+            w("(");
+            classType();
+            if (chance(tc, 20)) {
+                osp().w("&").osp();
+                classType();
+            }
+            w(")").osp();
+            lambda();
+        } else if (r == 2) {
+            methodReference();
+        } else {
+            lambda();
+        }
+    }
+
+    void postfix() {
+        if (chance(tc, 15)) {
+            assignable();
+            w(chance(tc, 50) ? "++" : "--");
+        } else {
+            primary();
+        }
+    }
+
+    /** A variable, field or array element: the operand of ++/-- and the target of an assignment. */
