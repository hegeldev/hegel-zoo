+        Generator<String> member(Body kind) {
+            boolean iface = kind == Body.INTERFACE;
+            Generator<String> field = tuples(modifiers(iface ? new String[] {"public", "static", "final"} : new String[] {"public", "private", "protected", "static", "final", "transient", "volatile"}),
+                    typeN, declarators(true, iface))
