+            w(".").osp().w(varName());
+        } else {
+            qualifier(true);
+            w("[").osp();
+            expression(0);
+            osp().w("]");
+        }
+    }
+
+    /** A primary that may be followed by `.`, `[` or `::` (no numeric literal: `1.x` would lex as a float). */
+    /** A primary that may be followed by `.`, `[` or `::`. */
