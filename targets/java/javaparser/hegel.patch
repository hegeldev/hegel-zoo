+    /** Whether javac's tree has an assignment or an increment whose target is not a variable, field or element. */
+    static boolean assignsToAnExpression(CompilationUnitTree cu) {
+        if (cu == null) {
+            return false;
+        }
+        boolean[] found = {false};
+        new TreeScanner<Void, Void>() {
+            boolean variable(ExpressionTree e) {
+                while (e != null && e.getKind() == Tree.Kind.PARENTHESIZED) {
+                    e = ((ParenthesizedTree) e).getExpression();
+                }
+                if (e == null) {
+                    return true;
+                }
+                switch (e.getKind()) {
+                    case IDENTIFIER:
+                    case MEMBER_SELECT:
+                    case ARRAY_ACCESS:
+                    case METHOD_INVOCATION: // JavaParser parses these and lets its validator reject them
+                    case ERRONEOUS:
+                        return true;
+                    default:
+                        return false;
+                }
+            }
