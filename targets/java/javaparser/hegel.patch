+            for (Expression v : ((ArrayInitializerExpr) e).getValues()) {
+                expr(v);
+            }
+            close();
+        } else if (e instanceof ArrayAccessExpr) {
+            open("index");
+            expr(((ArrayAccessExpr) e).getName());
+            expr(((ArrayAccessExpr) e).getIndex());
+            close();
+        } else if (e instanceof LambdaExpr) {
+            LambdaExpr l = (LambdaExpr) e;
+            open("lambda");
+            open("params");
+            for (Parameter p : l.getParameters()) {
