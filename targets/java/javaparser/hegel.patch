+    /** Whether JavaParser reported its VarType ClassCastException on a program with a `var.` qualified name (bug 21). */
+    static boolean varQualifiedType(Readers.Jp jp, String text) {
+        return String.join(" | ", jp.problems).contains("VarType cannot be cast") && text.matches("(?s).*\\bvar\\s*\\..*");
