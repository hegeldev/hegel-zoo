+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for JavaParser, added by the Hegel zoo (targets/java/javaparser). Runs against the
+     com.github.javaparser:javaparser-core artifact that `[run] setup` installs from this checkout into the local Maven repository. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>javaparser-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.source>22</maven.compiler.source>
+    <maven.compiler.target>22</maven.compiler.target>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <javaparser.version>3.29.0-SNAPSHOT</javaparser.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>com.github.javaparser</groupId>
+      <artifactId>javaparser-core</artifactId>
+      <version>${javaparser.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+        <configuration>
+          <compilerArgs>
+            <arg>--add-exports</arg>
+            <arg>jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
+            <arg>--add-exports</arg>
+            <arg>jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
+          </compilerArgs>
+        </configuration>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g -Xss4m</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/EngineText.java b/hegel/src/test/java/zoo/EngineText.java
new file mode 100644
index 0000000..43611cc
--- /dev/null
+++ b/hegel/src/test/java/zoo/EngineText.java
@@ -0,0 +1,59 @@
+package zoo;
+
+/** Text helpers shared by the tests. */
+final class EngineText {
+
+    static String firstLine(String s) {
+        if (s == null) {
+            return "null";
+        }
+        int i = s.indexOf('\n');
+        String l = i < 0 ? s : s.substring(0, i);
+        return l.length() > 300 ? l.substring(0, 300) + "…" : l;
+    }
+
+    /** The text, indented and with invisible characters made visible, for messages. */
+    static String describe(String text) {
+        StringBuilder sb = new StringBuilder("\n    ");
+        String shown = text.length() > 3000 ? text.substring(0, 3000) + "…" : text;
+        for (int i = 0; i < shown.length(); i++) {
+            char c = shown.charAt(i);
+            if (c == '\n') {
+                sb.append("\n    ");
+            } else if (c == '\t') {
+                sb.append("\\t");
+            } else if (c == '\r') {
+                sb.append("\\r");
+            } else if (c == '\f') {
+                sb.append("\\f");
+            } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff)) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.append('\n').toString();
+    }
+
+    /** Whitespace removed (types are compared as text). */
+    static String squash(String s) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (!Character.isWhitespace(c)) {
+                sb.append(c);
+            }
+        }
+        return sb.toString();
+    }
+
+    /** The first differing position of two shapes, with context, for messages. */
+    static String diff(String a, String b) {
+        int i = 0;
+        while (i < a.length() && i < b.length() && a.charAt(i) == b.charAt(i)) {
+            i++;
+        }
+        int from = Math.max(0, i - 80);
+        return "\n    javaparser: …" + a.substring(from, Math.min(a.length(), i + 160)) + "\n    javac:      …" + b.substring(from, Math.min(b.length(), i + 160));
+    }
+}
diff --git a/hegel/src/test/java/zoo/JavaGen.java b/hegel/src/test/java/zoo/JavaGen.java
new file mode 100644
index 0000000..00c14b8
--- /dev/null
+++ b/hegel/src/test/java/zoo/JavaGen.java
@@ -0,0 +1,1822 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.TestCase;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Deque;
+import java.util.List;
+
+/**
+ * A randomised writer of syntactically valid Java 21 compilation units: every construct is drawn from the JLS
+ * grammar (declarations, statements, the full expression precedence ladder, literals in every spelling, patterns,
+ * switch expressions, records, sealed types, lambdas, method references, text blocks, comments and whitespace
+ * variety). Only syntax matters here: names need not resolve and types need not exist, since both readers
+ * (JavaParser and javac's parser) are used for parsing only. javac is the arbiter of what is valid; a program it
+ * rejects is a fault of this writer, not of JavaParser.
+ */
+final class JavaGen {
+
+    final TestCase tc;
+    final boolean trivia; // comments and irregular whitespace
+    final boolean crlf;
+    final StringBuilder out = new StringBuilder();
+    int depth = 0;
+    int inSwitchExpr = 0;
+    int inLoop = 0;
+    int labels = 0;
+    /** The enclosing class-like declaration's name (null in anonymous bodies), for constructors. */
+    final Deque<String> typeNames = new ArrayDeque<>();
+    final List<String> literalTexts = new ArrayList<>();
+    /** Shapes the properties need to know about: "methodDims" (`int m()[]`), "legacyDims" (`int x[]`). */
+    final java.util.Set<String> features = new java.util.HashSet<>();
+
+    static final String[] NAMES = {"a", "b", "c", "x", "y", "z", "foo", "bar", "baz", "value", "count", "item", "list", "map", "result", "tmp",
+        "i", "j", "k", "n", "s", "t", "record", "sealed", "permits", "when", "module", "open", "to", "with", "transitive", "exports", "non", "var",
+        "_x", "$y", "été", "日本", "aB1", "__", "x1", "y2", "α", "über", "strictfp_", "enum_", "assert_"};
+    static final String[] TYPE_NAMES = {"Foo", "Bar", "Baz", "String", "Object", "Integer", "List", "Map", "Runnable", "Comparable",
+        "T", "U", "E", "Point", "Shape", "Circle", "Node", "Outer", "Inner", "java.util.List", "java.lang.String", "Map.Entry", "Outer.Inner", "École"};
+    static final String[] PRIMITIVES = {"int", "long", "short", "byte", "char", "boolean", "float", "double"};
+    static final String[] SPACES = {" ", " ", " ", "  ", "\t", "\n", "\n  ", "\n\t\t", " \n ", "\f", "\n\n\n", " \t "};
+    static final String[] COMMENTS = {"// c", "/* c */", "/** doc */", "/* multi\n line */", "// trailing", "/**/", "/***/", "/* * */", "/** @param x y */",
+        "// é 日本", "/* a // b */", "// /* not a block", "/* \"quoted\" */", "//"};
+
+    JavaGen(TestCase tc, boolean trivia, boolean crlf) {
+        this.tc = tc;
+        this.trivia = trivia;
+        this.crlf = crlf;
+    }
+
+    // ---- writing helpers ------------------------------------------------------------------------
+
+    /** Mandatory separation between tokens (at least one space, maybe a comment). */
+    JavaGen sp() {
+        if (trivia && chance(tc, 10)) {
+            String c = pick(tc, COMMENTS);
+            out.append(pick(tc, SPACES)).append(c).append(c.startsWith("//") ? "\n" : pick(tc, SPACES));
+        } else if (trivia && chance(tc, 20)) {
+            out.append(pick(tc, SPACES));
+        } else {
+            out.append(' ');
+        }
+        return this;
+    }
+
+    /** Optional separation (where no token boundary needs it). */
+    JavaGen osp() {
+        if (trivia && chance(tc, 8)) {
+            sp();
+        } else if (chance(tc, 30)) {
+            out.append(' ');
+        }
+        return this;
+    }
+
+    JavaGen w(String s) {
+        out.append(s);
+        return this;
+    }
+
+    JavaGen nl() {
+        out.append('\n');
+        if (trivia && chance(tc, 15)) {
+            out.append(pick(tc, COMMENTS)).append('\n');
+        }
+        return this;
+    }
+
+    String name() {
+        return pick(tc, NAMES);
+    }
+
+    /** A name usable for variables, fields, methods and lambda parameters. */
+    String varName() {
+        return name();
+    }
+
+    /** A lambda parameter's name: `var` is not allowed there. */
+    String lambdaName() {
+        String s = name();
+        return s.equals("var") ? "v" : s;
+    }
+
+    String typeName() {
+        return pick(tc, TYPE_NAMES);
+    }
+
+    String simpleTypeName() {
+        return pick(tc, "Foo", "Bar", "Baz", "Point", "Shape", "Circle", "Outer", "Inner", "Node", "École", "A", "B", "C", "Rec", "Impl", "Sealed_", "Record1");
+    }
+
+    String methodName() {
+        return pick(tc, "m", "run", "get", "set", "compute", "apply", "accept", "toString", "record", "sealed", "when", "permits", "méthode", "_m", "$m", "with");
+    }
+
+    String constantName(int i) {
+        return pick(tc, "RED", "GREEN", "BLUE", "A", "B", "C", "ONE", "TWO", "É") + (chance(tc, 30) ? i : "");
+    }
+
+    // ---- compilation unit -----------------------------------------------------------------------
+
+    String compilationUnit() {
+        out.setLength(0);
+        literalTexts.clear();
+        features.clear();
+        if (trivia && chance(tc, 30)) {
+            w(pick(tc, COMMENTS)).nl();
+        }
+        if (chance(tc, 50)) {
+            w("package").sp().w(qualifiedName()).osp().w(";").nl();
+        }
+        int imports = chance(tc, 50) ? n(tc, 1, 3) : 0;
+        for (int i = 0; i < imports; i++) {
+            w("import");
+            if (chance(tc, 30)) {
+                sp().w("static");
+            }
+            String q = qualifiedName();
+            sp().w(q.contains(".") ? q : q + "." + typeName().replace(".", ""));
+            if (chance(tc, 30)) {
+                osp().w(".").osp().w("*");
+            }
+            osp().w(";").nl();
+        }
+        boolean stray = trivia && chance(tc, 20); // a stray semicolon after the first declaration (javac rejects one right after the imports)
+        int types = chance(tc, 70) ? 1 : n(tc, 2, 3);
+        for (int i = 0; i < types; i++) {
+            if (i == 1 && stray) {
+                w(";").nl();
+            }
+            typeDeclaration(true, false);
+            nl();
+        }
+        String s = out.toString();
+        if (crlf) {
+            s = s.replace("\n", "\r\n");
+        }
+        return s;
+    }
+
+    String qualifiedName() {
+        StringBuilder sb = new StringBuilder(name());
+        int parts = n(tc, 0, 3);
+        for (int i = 0; i < parts; i++) {
+            sb.append(chance(tc, 80) ? "." : " . ").append(chance(tc, 70) ? name() : typeName().replace(".", ""));
+        }
+        return sb.toString();
+    }
+
+    // ---- declarations ---------------------------------------------------------------------------
+
+    /** The enclosing named type (for constructors), or null inside interfaces and anonymous bodies. */
+    String enclosingType() {
+        String t = typeNames.peek();
+        return t == null || t.isEmpty() ? null : t;
+    }
+
+    /** The modifiers the last modifiers() call wrote. */
+    List<String> lastModifiers = new ArrayList<>();
+
+    void modifiers(String... allowed) {
+        if (chance(tc, 25)) {
+            annotations(n(tc, 1, 2));
+        }
+        List<String> used = new ArrayList<>();
+        lastModifiers = used;
+        int count = chance(tc, 50) ? 0 : n(tc, 1, 2);
+        for (int i = 0; i < count; i++) {
+            String m = pick(tc, allowed);
+            if (used.contains(m) || conflicts(used, m)) {
+                continue;
+            }
+            used.add(m);
+            w(m).sp();
+        }
+    }
+
+    static final String[][] EXCLUSIVE = {{"public", "private", "protected"}, {"abstract", "final"}, {"sealed", "non-sealed", "final"}, {"abstract", "strictfp"},
+        {"abstract", "private"}, {"abstract", "static"}, {"abstract", "synchronized"}, {"abstract", "native"}};
+
+    static boolean conflicts(List<String> used, String m) {
+        for (String[] group : EXCLUSIVE) {
+            if (Arrays.asList(group).contains(m)) {
+                for (String g : group) {
+                    if (!g.equals(m) && used.contains(g)) {
+                        return true;
+                    }
+                }
+            }
+        }
+        return false;
+    }
+
+    /** An annotation on a type (compared as text with javac's printing): simple arguments only. */
+    void typeAnnotation() {
+        w("@").w(pick(tc, "A", "B", "Tag", "a.b.C", "Foo"));
+        int r = n(tc, 1, 6);
+        if (r == 2) {
+            w("(").w(pick(tc, "1", "0", "true", "Foo.class", "\"ab\"", "@B")).w(")");
+        } else if (r == 3) {
+            w("(a=").w(pick(tc, "1", "false", "Foo.class")).w(",b=@B)");
+        }
+        sp();
+    }
+
+    void annotations(int count) {
+        for (int i = 0; i < count; i++) {
+            w("@").osp().w(chance(tc, 70) ? typeName().replace(".", "") : qualifiedName());
+            int r = n(tc, 1, 3);
+            if (r == 2) {
+                w("(").osp();
+                annotationValue();
+                osp().w(")");
+            } else if (r == 3) {
+                w("(");
+                int pairs = n(tc, 1, 3);
+                for (int p = 0; p < pairs; p++) {
+                    if (p > 0) {
+                        w(",").osp();
+                    }
+                    w(name()).osp().w("=").osp();
+                    annotationValue();
+                }
+                w(")");
+            }
+            sp();
+        }
+    }
+
+    void annotationValue() {
+        int r = n(tc, 1, 5);
+        if (r == 1) {
+            w("{");
+            int k = n(tc, 0, 3);
+            for (int i = 0; i < k; i++) {
+                if (i > 0) {
+                    w(",").osp();
+                }
+                literal();
+            }
+            if (k > 0 && chance(tc, 30)) {
+                w(",");
+            }
+            w("}");
+        } else if (r == 2) {
+            w("@").w(typeName().replace(".", "")).w("(").w(name()).w("=").w("1").w(")");
+        } else if (r == 3) {
+            w(typeName().replace(".", "")).w(".class");
+        } else {
+            literal();
+        }
+    }
+
+    /** A class, interface, enum, record or (not locally) annotation type declaration. */
+    void typeDeclaration(boolean topLevel, boolean local) {
+        depth++;
+        int kind = n(tc, 1, local ? 9 : 10);
+        if (local && kind == 8) {
+            kind = 9; // known bug: JavaParser cannot parse local enum declarations (a pin carries it)
+        }
+        String[] mods = topLevel ? new String[] {"public", "abstract", "final", "strictfp", "sealed", "non-sealed"}
+            : local ? new String[] {"abstract", "final", "strictfp"}
+            : new String[] {"public", "private", "protected", "static", "abstract", "final", "strictfp", "sealed", "non-sealed"};
+        if (kind <= 5) {
+            modifiers(mods);
+            boolean sealed = lastModifiers.contains("sealed");
+            String tn = simpleTypeName();
+            w("class").sp().w(tn);
+            typeParameters(30);
+            if (chance(tc, 40)) {
+                sp().w("extends").sp();
+                classType();
+            }
+            if (chance(tc, 40)) {
+                sp().w("implements").sp();
+                classTypeList();
+            }
+            if (sealed && chance(tc, 60)) {
+                sp().w("permits").sp();
+                typeNameList();
+            }
+            sp();
+            typeNames.push(tn);
+            classBody(false, false);
+            typeNames.pop();
+        } else if (kind <= 7) {
+            modifiers(topLevel ? new String[] {"public", "abstract", "strictfp", "sealed", "non-sealed"}
+                : local ? new String[] {"abstract", "strictfp"} : new String[] {"public", "private", "static", "abstract", "sealed"});
+            boolean sealed = lastModifiers.contains("sealed");
+            w("interface").sp().w(simpleTypeName());
+            typeParameters(30);
+            if (chance(tc, 40)) {
+                sp().w("extends").sp();
+                classTypeList();
+            }
+            if (sealed && chance(tc, 60)) {
+                sp().w("permits").sp();
+                typeNameList();
+            }
+            sp();
+            typeNames.push("");
+            classBody(true, false);
+            typeNames.pop();
+        } else if (kind == 8) {
+            modifiers(topLevel ? new String[] {"public", "strictfp"} : local ? new String[] {"strictfp"} : new String[] {"public", "private", "static", "strictfp"});
+            String tn = simpleTypeName();
+            w("enum").sp().w(tn);
+            if (chance(tc, 30)) {
+                sp().w("implements").sp();
+                classTypeList();
+            }
+            sp().w("{").nl();
+            int constants = n(tc, 0, 3);
+            for (int i = 0; i < constants; i++) {
+                if (i > 0) {
+                    w(",").nl();
+                }
+                if (chance(tc, 20)) {
+                    annotations(1);
+                }
+                w(constantName(i));
+                if (chance(tc, 40)) {
+                    arguments();
+                }
+                if (chance(tc, 20) && depth < 4) {
+                    sp();
+                    typeNames.push("");
+                    classBody(false, false);
+                    typeNames.pop();
+                }
+            }
+            if (constants > 0 && chance(tc, 40)) {
+                w(",");
+            }
+            if (chance(tc, 60)) {
+                w(";").nl();
+                typeNames.push(tn);
+                members(false, false, n(tc, 0, 3));
+                typeNames.pop();
+            }
+            nl().w("}");
+        } else if (kind == 9) {
+            modifiers(topLevel ? new String[] {"public", "final", "strictfp"} : local ? new String[] {"final", "strictfp"} : new String[] {"public", "private", "static", "final", "strictfp"});
+            String tn = simpleTypeName();
+            w("record").sp().w(tn);
+            typeParameters(30);
+            w("(");
+            int comps = n(tc, 0, 3);
+            for (int i = 0; i < comps; i++) {
+                if (i > 0) {
+                    w(",").osp();
+                }
+                if (chance(tc, 20)) {
+                    annotations(1);
+                }
+                type(true);
+                if (i == comps - 1 && chance(tc, 20)) {
+                    w("...");
+                }
+                sp().w(varName());
+            }
+            w(")");
+            if (chance(tc, 30)) {
+                sp().w("implements").sp();
+                classTypeList();
+            }
+            sp();
+            typeNames.push(tn);
+            classBody(false, true);
+            typeNames.pop();
+        } else {
+            modifiers(topLevel ? new String[] {"public", "abstract"} : new String[] {"public", "private", "static", "abstract"});
+            w("@").osp().w("interface").sp().w(simpleTypeName()).sp().w("{").nl();
+            int m = n(tc, 0, 3);
+            for (int i = 0; i < m; i++) {
+                modifiers("public", "abstract");
+                type(false);
+                sp().w(name()).osp().w("(").osp().w(")");
+                if (chance(tc, 50)) {
+                    sp().w("default").sp();
+                    annotationValue();
+                }
+                w(";").nl();
+            }
+            if (chance(tc, 30)) {
+                modifiers("public", "static", "final");
+                type(false);
+                sp().w(varName()).osp().w("=").osp();
+                literal();
+                w(";").nl();
+            }
+            w("}");
+        }
+        depth--;
+    }
+
+    void typeParameters(int pct) {
+        if (!chance(tc, pct)) {
+            return;
+        }
+        osp().w("<");
+        int k = n(tc, 1, 3);
+        for (int i = 0; i < k; i++) {
+            if (i > 0) {
+                w(",").osp();
+            }
+            if (chance(tc, 15)) {
+                typeAnnotation();
+            }
+            w(pick(tc, "T", "U", "V", "E", "K", "R"));
+            if (chance(tc, 30)) {
+                sp().w("extends").sp();
+                classType();
+                if (chance(tc, 30)) {
+                    osp().w("&").osp();
+                    classType();
+                }
+            }
+        }
+        w(">");
+    }
+
+    void classTypeList() {
+        int k = n(tc, 1, 3);
+        for (int i = 0; i < k; i++) {
+            if (i > 0) {
+                w(",").osp();
+            }
+            classType();
+        }
+    }
+
+    void classBody(boolean iface, boolean record) {
+        w("{").nl();
+        members(iface, record, record ? n(tc, 0, 3) : n(tc, 0, 4));
+        if (record && chance(tc, 40)) {
+            modifiers("public", "private", "protected");
+            w(enclosingType()).sp();
+            block(false);
+            nl();
+        }
+        w("}");
+    }
+
+    void members(boolean iface, boolean record, int count) {
+        for (int i = 0; i < count; i++) {
+            member(iface, record);
+            nl();
+        }
+    }
+
+    void member(boolean iface, boolean record) {
+        int r = n(tc, 1, 12);
+        String ctorName = enclosingType();
+        if (r <= 4) {
