+            close();
+        } else if (e instanceof AnnotationExpr) {
+            annotation((AnnotationExpr) e);
+        } else if (e instanceof VariableDeclarationExpr) {
+            locals((VariableDeclarationExpr) e);
+        } else if (e instanceof TypeExpr) {
+            open("type");
+            type(((TypeExpr) e).getType());
+            close();
+        } else if (e instanceof PatternExpr) {
+            open("?" + e.getClass().getSimpleName());
+            close();
+        } else {
+            open("?" + e.getClass().getSimpleName());
+            close();
+        }
+    }
+
+    /** Every node of a tree, for the position checks. */
+    /** A `+` chain at the top of its run of binary operators with two adjacent string literals somewhere in it. */
+    static boolean isFoldedChain(BinaryExpr b) {
+        if (b.getOperator() != BinaryExpr.Operator.PLUS) {
+            return false;
+        }
+        Node parent = b.getParentNode().orElse(null);
+        if (parent instanceof BinaryExpr || parent instanceof InstanceOfExpr) {
+            return false; // not the top of the run: javac folds nothing inside it
+        }
+        List<Expression> operands = plusOperands(b);
+        for (int i = 1; i < operands.size(); i++) {
+            if (isStringLiteral(operands.get(i - 1)) && isStringLiteral(operands.get(i))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** The operands of a left-associative `+` chain, left to right. */
+    static List<Expression> plusOperands(Expression e) {
+        List<Expression> out = new ArrayList<>();
+        while (e instanceof BinaryExpr && ((BinaryExpr) e).getOperator() == BinaryExpr.Operator.PLUS) {
+            out.add(0, ((BinaryExpr) e).getRight());
+            e = ((BinaryExpr) e).getLeft();
+        }
+        out.add(0, e);
+        return out;
+    }
+
+    static boolean isStringLiteral(Expression e) {
+        return e instanceof StringLiteralExpr || e instanceof TextBlockLiteralExpr;
+    }
+
+    static String literalValue(Expression e) {
+        return e instanceof TextBlockLiteralExpr ? ((TextBlockLiteralExpr) e).asString() : ((StringLiteralExpr) e).asString();
+    }
+
+    void foldedOperand(Object o) {
+        if (o instanceof String) {
+            open("lit");
+            atom("string");
+            text((String) o);
+            close();
+        } else {
+            expr((Expression) o);
+        }
+    }
+
+    static List<Node> all(Node root) {
+        List<Node> out = new ArrayList<>();
+        root.walk(out::add);
+        return out;
+    }
+}
