+import com.sun.source.tree.AnnotationTree;
+import com.sun.source.tree.AssignmentTree;
+import com.sun.source.tree.BinaryTree;
+import com.sun.source.tree.BindingPatternTree;
+import com.sun.source.tree.CaseLabelTree;
+import com.sun.source.tree.CaseTree;
+import com.sun.source.tree.ClassTree;
+import com.sun.source.tree.CompilationUnitTree;
+import com.sun.source.tree.CompoundAssignmentTree;
+import com.sun.source.tree.ConditionalExpressionTree;
+import com.sun.source.tree.ConstantCaseLabelTree;
+import com.sun.source.tree.ExpressionTree;
+import com.sun.source.tree.IdentifierTree;
+import com.sun.source.tree.InstanceOfTree;
+import com.sun.source.tree.LambdaExpressionTree;
+import com.sun.source.tree.MemberReferenceTree;
+import com.sun.source.tree.MemberSelectTree;
+import com.sun.source.tree.MethodTree;
+import com.sun.source.tree.ParenthesizedTree;
+import com.sun.source.tree.PatternCaseLabelTree;
+import com.sun.source.tree.PrimitiveTypeTree;
+import com.sun.source.tree.Tree;
+import com.sun.source.tree.TypeCastTree;
+import com.sun.source.tree.UnaryTree;
+import com.sun.source.tree.VariableTree;
+import com.sun.source.util.TreeScanner;
+import dev.hegel.Generator;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import dev.hegel.Tuple2;
+import dev.hegel.Tuple3;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+import zoo.JavaGen.Program;
+
+/**
+ * JavaParser against javac's parser on generated Java 21 programs: acceptance and tree agreement (through a canonical
+ * shape), pretty-printer and lexical-preservation round trips, positions, mutated texts, the fragment parsers and the
+ * clone/equals laws. The generators draw the recorded bugs' shapes (bugs.toml), so the wide properties fail on them,
+ * and the narrow properties at the end - one per bug, over that bug's shape region with random contents, checked by
+ * the same oracles - fail on them too; all are the expected failures beside the pins. {@code HEGEL_NO_KNOWN=1}
+ * ({@link Zoo#NO_KNOWN}) switches the shapes off: the generators draw the neighbouring shapes and the checks the bugs
+ * falsify are left out.
+ */
+class JavaParserTest {
+
+    /** Both parsers accept the generated program and see the same tree. */
+    @Test
+    void agreesWithJavac() {
+        Hegel.test(tc -> agrees(tc, tc.draw(JavaGen.PROGRAM, "program").text()), Zoo.settings("agreesWithJavac"));
+    }
+
+    /** The oracle of agreesWithJavac and of the narrow acceptance properties: javac accepts (else the generator is at fault), JavaParser accepts, the shapes are equal. */
+    static void agrees(TestCase tc, String text) {
+        Readers.Jc jc = Readers.javac(text);
+        if (!jc.ok()) {
+            Zoo.fail("generator: javac rejects the program: " + jc + describe(text));
+            return;
+        }
+        agrees(tc, jc, text);
+    }
+
+    static void agrees(TestCase tc, Readers.Jc jc, String text) {
+        Readers.Jp jp = Readers.javaparser(text, true);
+        if (!accepted(tc, jp, text)) {
+            return;
+        }
+        String a = Shape.of(jp.cu);
+        String b = JavacShape.of(jc.cu, text);
+        check(a.equals(b), () -> "tree differs from javac's:" + diff(a, b) + describe(text));
+    }
+
+    /**
+     * The acceptance check of every property that goes on to use JavaParser's tree of a program javac accepts: a
+     * rejection fails, except a `var::m` method reference (candidate/java/javaparser-1) and, under HEGEL_NO_KNOWN, a
+     * qualified type starting with `var` (bug 21, a ClassCastException reported as a problem; the generator then writes
+     * no such qualifier of its own). Whether the tree is there to use.
+     */
+    static boolean accepted(TestCase tc, Readers.Jp jp, String text) {
+        tc.assume(!Zoo.NO_KNOWN || jp.ok() || !varQualifiedType(jp, text));
+        tc.assume(jp.ok() || !candidateVarMethodReference(jp, text));
+        check(jp.ok(), () -> "javac accepts, JavaParser: " + jp + describe(text));
+        return jp.ok();
+    }
+
+    /** The acceptance oracle both ways: what javac rejects, JavaParser rejects; what javac accepts, both read alike. */
+    static void acceptanceAgrees(TestCase tc, String text) {
+        Readers.Jc jc = Readers.javac(text);
+        if (jc.ok()) {
+            agrees(tc, jc, text);
+            return;
+        }
+        Readers.Jp jp = Readers.javaparser(text, true);
+        check(!jp.ok(), () -> "javac rejects the program (" + jc + "), JavaParser accepts it" + describe(text));
+    }
+
+    /** toString() (the default pretty printer) prints a program both parsers accept with the same shape; equals holds. */
+    @Test
+    void prettyPrintRoundTrip() {
+        Hegel.test(tc -> printsBack(tc, tc.draw(JavaGen.PRINTABLE_PROGRAM, "program")), Zoo.settings("prettyPrintRoundTrip"));
+    }
+
+    /** The oracle of prettyPrintRoundTrip: a program javac accepts is accepted and prints to one both parsers accept with the same shape, and equal. */
+    static void printsBack(TestCase tc, Program program) {
+        String text = program.text();
+        Readers.Jc jc = Readers.javac(text);
+        tc.assume(jc.ok());
+        Readers.Jp jp = Readers.javaparser(text, false);
+        if (!accepted(tc, jp, text)) {
+            return;
+        }
+        String shape = Shape.of(jp.cu);
+        // equals() sees ArrayType.origin (`int x[]` prints as `int[] x`) and a text block's raw indentation, which
+        // the printer changes on purpose; both are documented, so equals is only checked without them
+        boolean equalsApplies = !program.features().contains("legacyDims") && !jp.cu.findFirst(com.github.javaparser.ast.expr.TextBlockLiteralExpr.class).isPresent();
+        String printed;
+        try {
+            printed = jp.cu.toString();
+        } catch (RuntimeException | StackOverflowError e) {
+            Zoo.fail("toString() crashes: " + e.getClass().getName() + ": " + firstLine(e.getMessage()) + describe(text));
+            return;
+        }
+        Readers.Jc jc2 = Readers.javac(printed);
+        check(jc2.ok(), () -> "pretty-printed program is rejected by javac: " + jc2 + describe(printed) + "  original:" + describe(text));
+        Readers.Jp jp2 = Readers.javaparser(printed, false);
+        check(jp2.ok(), () -> "pretty-printed program is rejected by JavaParser: " + jp2 + describe(printed) + "  original:" + describe(text));
+        if (!jp2.ok()) {
+            return;
+        }
