+                    || parent instanceof com.github.javaparser.ast.body.Parameter && parent.getParentNode().filter(g -> g instanceof com.github.javaparser.ast.stmt.CatchClause).isPresent() && node instanceof com.github.javaparser.ast.type.Type);
