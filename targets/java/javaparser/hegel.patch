+        // ---- declarations
+
+        Generator<String> typeParameters(int pct) {
+            Generator<String> bound = opt(30, tuples(classType, opt(30, classType.map(t -> OSP + "&" + OSP + t))).map(t -> SP + "extends" + SP + t.value1() + t.value2()));
