+    static final Flags PRINTABLE = new Flags(false, Zoo.NO_KNOWN, false);
+
+    /** A Java 21 compilation unit, its trivia and line endings drawn with it. */
+    static final Generator<Program> PROGRAM = program(types(PLAIN));
+    /** The program the printing round trips draw (see {@link #PRINTABLE}). */
+    static final Generator<Program> PRINTABLE_PROGRAM = program(types(PRINTABLE));
+    /** A printable program whose first type is a class with a method body, so that there is always a fragment to re-parse. */
+    static final Generator<Program> FRAGMENT_PROGRAM = program(typesWithBody(PRINTABLE));
+    /** The program the lexical-preservation round trip draws: PROGRAM, under HEGEL_NO_KNOWN without `int m()[]` (bug 10), which the lexical-preserving printer prints wrongly. */
+    static final Generator<Program> LEXICAL_PROGRAM = program(types(new Flags(false, false, Zoo.NO_KNOWN)));
