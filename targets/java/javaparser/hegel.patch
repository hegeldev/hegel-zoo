+    }
+
+    static final com.github.javaparser.printer.configuration.PrinterConfiguration NO_COMMENTS = new com.github.javaparser.printer.configuration.DefaultPrinterConfiguration()
+            .removeOption(new com.github.javaparser.printer.configuration.DefaultConfigurationOption(com.github.javaparser.printer.configuration.DefaultPrinterConfiguration.ConfigOption.PRINT_COMMENTS));
+
+    static String slice(String[] lines, Range r) {
+        Position b = r.begin;
+        Position e = r.end;
+        if (b.line < 1 || e.line > lines.length) {
+            return null;
+        }
+        if (b.line == e.line) {
+            String l = lines[b.line - 1];
+            if (b.column < 1 || e.column > l.length() || e.column < b.column) {
+                return null;
+            }
+            return l.substring(b.column - 1, e.column);
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int i = b.line; i <= e.line; i++) {
+            String l = lines[i - 1];
+            int from = i == b.line ? b.column - 1 : 0;
+            int to = i == e.line ? e.column : l.length();
+            if (from < 0 || from > l.length() || to > l.length() || to < from) {
+                return null;
+            }
+            sb.append(l, from, to);
+            if (i < e.line) {
+                sb.append('\n');
+            }
+        }
+        return sb.toString();
+    }
