+    }
+
+    /** The lexical-preserving printer reproduces the original text exactly. */
+    @Test
+    void lexicalPreservationIsIdentity() {
+        Hegel.test(tc -> {
+            Program program = new Program(tc);
+            String text = program.text;
+            if (program.features.contains("methodDims")) {
+                return; // known bug: `int m()[]` is printed as `int ()[]m` (a pin carries it)
+            }
+            Readers.Jc jc = Readers.javac(text);
+            if (!jc.ok()) {
+                return;
+            }
+            CompilationUnit cu;
+            try {
+                ParseResult<CompilationUnit> r = new JavaParser(Readers.config(true).setLexicalPreservationEnabled(true)).parse(text);
+                if (!r.isSuccessful() || !r.getResult().isPresent()) {
+                    return;
+                }
+                cu = r.getResult().get();
+            } catch (RuntimeException | StackOverflowError e) {
+                return;
+            }
+            String printed;
+            try {
+                LexicalPreservingPrinter.setup(cu);
+                printed = LexicalPreservingPrinter.print(cu);
+            } catch (RuntimeException | StackOverflowError e) {
+                Zoo.fail("LexicalPreservingPrinter crashes: " + e.getClass().getName() + ": " + firstLine(e.getMessage()) + describe(text));
+                return;
+            }
+            check(printed.equals(text), () -> "LexicalPreservingPrinter changes the text:" + diff(printed, text) + describe(text));
+        }, Zoo.settings("lexicalPreservationIsIdentity"));
+    }
+
+    /** Ranges nest, and literals and simple names cover exactly their own text. */
+    @Test
+    void positionsAreConsistent() {
+        Hegel.test(tc -> {
+            String text = program(tc);
+            Readers.Jc jc = Readers.javac(text);
+            if (!jc.ok()) {
+                return;
+            }
+            Readers.Jp jp = Readers.javaparser(text, chance(tc, 50));
+            if (!jp.ok()) {
+                return;
+            }
+            String[] lines = text.split("\r\n|\r|\n", -1);
+            for (Node node : Shape.all(jp.cu)) {
+                Optional<Range> r = node.getRange();
+                if (node instanceof com.github.javaparser.ast.type.UnknownType) {
+                    continue; // the type of an implicitly typed lambda parameter has no text
+                }
+                check(r.isPresent() || node instanceof CompilationUnit, () -> "node without a range: " + node.getClass().getSimpleName() + " " + firstLine(node.toString()) + describe(text));
+                if (!r.isPresent()) {
