+            open("pair");
+            atom("value");
+            expr(((SingleMemberAnnotationExpr) a).getMemberValue());
+            close();
+        } else if (a instanceof NormalAnnotationExpr) {
+            for (MemberValuePair p : ((NormalAnnotationExpr) a).getPairs()) {
+                open("pair");
+                atom(p.getNameAsString());
+                expr(p.getValue());
+                close();
+            }
+        } else if (!(a instanceof MarkerAnnotationExpr)) {
