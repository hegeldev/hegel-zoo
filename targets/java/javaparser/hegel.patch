+    /** The innermost pair of unequal nodes whose children are all equal, for messages. */
+    static String firstDifference(Node a, Node b) {
+        List<Node> ca = a.getChildNodes();
+        List<Node> cb = b.getChildNodes();
+        if (ca.size() == cb.size()) {
+            for (int i = 0; i < ca.size(); i++) {
+                if (!ca.get(i).equals(cb.get(i))) {
+                    return firstDifference(ca.get(i), cb.get(i));
+                }
+            }
+        }
+        return a.getClass().getSimpleName() + " " + Zoo.show(firstLine(a.toString(NO_COMMENTS))) + " vs " + Zoo.show(firstLine(b.toString(NO_COMMENTS)))
+                + (a instanceof com.github.javaparser.ast.expr.LiteralStringValueExpr ? " (values " + Zoo.show(((com.github.javaparser.ast.expr.LiteralStringValueExpr) a).getValue()) + " vs " + Zoo.show(((com.github.javaparser.ast.expr.LiteralStringValueExpr) b).getValue()) + ")" : "");
+    }
+
+    /** An expression the fragment parser can be asked about: not a name, annotation, pattern, lambda, method reference, switch, array initializer or super, nor a method reference's or `new`'s scope. */
+    static boolean fragmentExpression(Node node) {
+        if (!(node instanceof Expression) || node instanceof com.github.javaparser.ast.expr.Name || node instanceof SimpleName
+                || node instanceof com.github.javaparser.ast.expr.AnnotationExpr || node instanceof com.github.javaparser.ast.expr.MarkerAnnotationExpr
+                || node instanceof com.github.javaparser.ast.expr.TypeExpr || node instanceof com.github.javaparser.ast.expr.VariableDeclarationExpr
+                || node instanceof com.github.javaparser.ast.expr.PatternExpr || node instanceof com.github.javaparser.ast.expr.LambdaExpr
+                || node instanceof com.github.javaparser.ast.expr.MethodReferenceExpr || node instanceof com.github.javaparser.ast.expr.SwitchExpr
+                || node instanceof com.github.javaparser.ast.expr.ArrayInitializerExpr || node instanceof com.github.javaparser.ast.expr.SuperExpr) {
+            return false;
+        }
+        return !node.getParentNode().map(p -> p instanceof com.github.javaparser.ast.expr.MethodReferenceExpr
+                || p instanceof com.github.javaparser.ast.expr.ObjectCreationExpr && ((com.github.javaparser.ast.expr.ObjectCreationExpr) p).getScope().filter(s -> s == node).isPresent()).orElse(false);
+    }
+
+    /** A statement the fragment parser can be asked about: not a switch entry, an explicit constructor call, a yield, nor the body of a switch entry or lambda. */
+    static boolean fragmentStatement(Node node) {
+        if (!(node instanceof Statement) || node instanceof com.github.javaparser.ast.stmt.SwitchEntry
+                || node instanceof com.github.javaparser.ast.stmt.ExplicitConstructorInvocationStmt || node instanceof com.github.javaparser.ast.stmt.YieldStmt) {
+            return false;
+        }
+        return !node.getParentNode().filter(p -> p instanceof com.github.javaparser.ast.stmt.SwitchEntry || p instanceof com.github.javaparser.ast.expr.LambdaExpr).isPresent();
+    }
+
+    /** A program and the positions (modulo the number of eligible nodes) of the fragments to re-parse. */
+    static final Generator<Tuple2<Program, List<Integer>>> FRAGMENTS = tuples(JavaGen.FRAGMENT_PROGRAM, many(INDEX, 1, 40));
+
+    /** A program javac accepts is accepted, and parseExpression/parseStatement/parseBlock see the same fragments the compilation-unit parse saw. */
+    @Test
+    void fragmentParsersAgree() {
+        Hegel.test(tc -> {
+            // the first type has a method body, so that there are statements to re-parse
+            Tuple2<Program, List<Integer>> c = tc.draw(FRAGMENTS, "case");
+            String text = c.value1().text();
+            Readers.Jc jc = Readers.javac(text);
+            tc.assume(jc.ok());
+            Readers.Jp jp = Readers.javaparser(text, false);
+            if (!accepted(tc, jp, text)) {
+                return;
+            }
+            JavaParser parser = new JavaParser(Readers.config(false));
+            List<Node> eligible = new ArrayList<>();
+            for (Node node : Shape.all(jp.cu)) {
+                if (fragmentExpression(node) || fragmentStatement(node)) {
+                    eligible.add(node);
+                }
+            }
+            tc.assume(!eligible.isEmpty());
+            for (int index : c.value2()) {
+                Node node = at(eligible, index);
+                if (node instanceof Expression) {
+                    Expression e = (Expression) node;
+                    String src = e.toString();
+                    // the shape of the node on its own: a `+` chain of string literals folds (as javac's does) only at
+                    // the top of a run of binary operators, and a printed fragment is always at the top
+                    String shape = Shape.ofExpression(e.clone());
+                    ParseResult<Expression> r;
+                    try {
+                        r = parser.parseExpression(src);
+                    } catch (RuntimeException | StackOverflowError ex) {
+                        Zoo.fail("parseExpression crashes: " + ex.getClass().getName() + ": " + firstLine(ex.getMessage()) + describe(src));
+                        continue;
+                    }
+                    check(r.isSuccessful() && r.getResult().isPresent(), () -> "parseExpression rejects a printed " + e.getClass().getSimpleName() + ": " + firstLine(r.getProblems().toString()) + describe(src));
+                    if (r.isSuccessful() && r.getResult().isPresent()) {
+                        String shape2 = Shape.ofExpression(r.getResult().get());
+                        check(shape.equals(shape2), () -> "parseExpression reads a printed " + e.getClass().getSimpleName() + " differently:" + diff(shape, shape2) + describe(src));
+                    }
+                } else {
+                    Statement s = (Statement) node;
+                    String src = s.toString();
+                    String shape = Shape.ofStatement(s);
+                    ParseResult<? extends Statement> r;
+                    try {
+                        r = s instanceof com.github.javaparser.ast.stmt.BlockStmt ? parser.parseBlock(src) : parser.parseStatement(src);
+                    } catch (RuntimeException | StackOverflowError ex) {
+                        Zoo.fail("parseStatement crashes: " + ex.getClass().getName() + ": " + firstLine(ex.getMessage()) + describe(src));
+                        continue;
+                    }
+                    check(r.isSuccessful() && r.getResult().isPresent(), () -> "parseStatement rejects a printed " + s.getClass().getSimpleName() + ": " + firstLine(r.getProblems().toString()) + describe(src));
+                    if (r.isSuccessful() && r.getResult().isPresent()) {
+                        String shape2 = Shape.ofStatement(r.getResult().get());
+                        check(shape.equals(shape2), () -> "parseStatement reads a printed " + s.getClass().getSimpleName() + " differently:" + diff(shape, shape2) + describe(src));
+                    }
+                }
+            }
+        }, Zoo.settings("fragmentParsersAgree"));
+    }
