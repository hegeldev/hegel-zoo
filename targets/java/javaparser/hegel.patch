+            ((SuperExpr) e).getTypeName().ifPresent(this::name);
+            close();
+        } else if (e instanceof ClassExpr) {
+            open("classlit");
+            type(((ClassExpr) e).getType());
+            close();
+        } else if (e instanceof ObjectCreationExpr) {
+            ObjectCreationExpr o = (ObjectCreationExpr) e;
+            open("new");
+            open("outer");
+            o.getScope().ifPresent(this::expr);
+            close();
+            typeArgs(o.getTypeArguments());
+            type(o.getType());
+            args(o.getArguments());
+            if (o.getAnonymousClassBody().isPresent()) {
+                members(o.getAnonymousClassBody().get(), false);
+            }
+            close();
+        } else if (e instanceof ArrayCreationExpr) {
+            ArrayCreationExpr a = (ArrayCreationExpr) e;
+            open("newarray");
+            type(a.getElementType());
+            atom(String.valueOf(a.getLevels().size()));
+            open("dims");
+            for (ArrayCreationLevel l : a.getLevels()) {
+                l.getDimension().ifPresent(this::expr);
+            }
+            close();
+            a.getInitializer().ifPresent(this::expr);
+            close();
+        } else if (e instanceof ArrayInitializerExpr) {
