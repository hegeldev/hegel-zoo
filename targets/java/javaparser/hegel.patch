+                // modifiers, a catch parameter's the qualifier of its type.
+                boolean knownBug = (parent instanceof com.github.javaparser.ast.type.TypeParameter || parent instanceof com.github.javaparser.ast.type.Type) && node instanceof com.github.javaparser.ast.expr.AnnotationExpr
+                        || parent instanceof com.github.javaparser.ast.expr.TypePatternExpr && node instanceof com.github.javaparser.ast.Modifier
+                        || parent instanceof com.github.javaparser.ast.body.Parameter && parent.getParentNode().filter(g -> g instanceof com.github.javaparser.ast.stmt.CatchClause).isPresent() && node instanceof com.github.javaparser.ast.type.Type;
