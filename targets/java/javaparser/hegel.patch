@@ -0,0 +1,259 @@
+package zoo;
+
+import static zoo.Zoo.check;
+
+import com.github.javaparser.JavaParser;
+import com.github.javaparser.ParseResult;
+import com.github.javaparser.Range;
+import com.github.javaparser.ast.CompilationUnit;
+import com.github.javaparser.ast.Node;
+import com.github.javaparser.ast.body.MethodDeclaration;
+import com.github.javaparser.ast.body.Parameter;
+import com.github.javaparser.ast.body.VariableDeclarator;
+import com.github.javaparser.ast.expr.AnnotationExpr;
+import com.github.javaparser.ast.expr.BinaryExpr;
+import com.github.javaparser.ast.expr.CharLiteralExpr;
+import com.github.javaparser.ast.expr.Expression;
+import com.github.javaparser.ast.expr.MethodReferenceExpr;
+import com.github.javaparser.ast.expr.StringLiteralExpr;
+import com.github.javaparser.ast.expr.TextBlockLiteralExpr;
+import com.github.javaparser.ast.expr.ThisExpr;
+import com.github.javaparser.ast.expr.TypePatternExpr;
+import com.github.javaparser.ast.expr.UnaryExpr;
+import com.github.javaparser.ast.type.Type;
+import com.github.javaparser.ast.type.TypeParameter;
+import com.github.javaparser.printer.lexicalpreservation.LexicalPreservingPrinter;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Pins for the bugs in bugs.toml: each asserts the correct behaviour and fails while the bug exists (see
+ * target.toml [expected_failures]).
+ */
+class JavaParserPinsTest {
+
+    static final JavaParser PARSER = new JavaParser(Readers.config(false));
+
+    static CompilationUnit parse(String text) {
+        ParseResult<CompilationUnit> r = PARSER.parse(text);
+        check(r.isSuccessful(), () -> "rejected: " + r.getProblems() + EngineText.describe(text));
+        return r.getResult().orElse(null);
+    }
+
+    static <T extends Node> T first(CompilationUnit cu, Class<T> c) {
+        return cu.findFirst(c).orElseThrow(() -> new AssertionError("no " + c.getSimpleName()));
+    }
+
+    static String range(Node n) {
+        return n.getRange().map(Object::toString).orElse("none");
+    }
+
+    /** bug javaparser/20: Unicode escapes in an identifier are translated before lexing (JLS 3.3): backslash-u0041 b is Ab. */
+    @Test
+    void pin_unicodeEscapesInIdentifiersAreTranslated() {
+        CompilationUnit cu = parse("class A { int \\u0041b; }");
+        String name = first(cu, com.github.javaparser.ast.body.VariableDeclarator.class).getNameAsString();
+        check(name.equals("Ab"), () -> "identifier of `int \\u0041b;` is " + name);
+    }
+
+    /** bug javaparser/21: `var` is a valid package name, so `var.X` is a qualified type (JLS 3.9, 6.5). */
+    @Test
+    void pin_qualifiedTypeStartingWithVar() {
+        CompilationUnit cu = parse("class A { var.X f; }");
+        check(cu != null, () -> "no tree");
+    }
+
+    /** bug javaparser/22: a relational operator or another `instanceof` may follow an `instanceof` (JLS 15.20). */
+    @Test
+    void pin_relationalAfterInstanceOf() {
+        parse("class A { boolean m(Object a, int s) { return a instanceof String p < s; } }");
+        parse("class A { boolean m(Object a) { return a instanceof String p instanceof Object; } }");
+    }
+
+    /** bug castLambdaOperand: a cast lambda may be an operand of a binary operator (JLS 15.16, 15.21). */
+    @Test
+    void pin_castLambdaAsOperand() {
+        parse("class A { Runnable r; boolean b = (Runnable) () -> {} == r; }");
+    }
+
+    /** bug varLambdaParameterInInitializer: `var` lambda parameters are legal inside a variable initializer. */
+    @Test
+    void pin_varLambdaParameterInInitializer() {
+        parse("class A { java.util.function.Function<Integer, Integer> f = (var x) -> x; }");
+    }
+
+    /** bug localEnum: local enum declarations (Java 16). */
+    @Test
+    void pin_localEnum() {
+        parse("class A { void m() { enum E { X, Y } } }");
+    }
+
+    /** bug unicodeEscapedBackslashInCharLiteral: `'\''` is `'\''` (JLS 3.3, 3.10.4). */
+    @Test
+    void pin_unicodeEscapedBackslashInCharLiteral() {
+        CompilationUnit cu = parse("class A { char c = '\\u005c\\u0027'; }");
+        if (cu != null) {
+            char c = first(cu, CharLiteralExpr.class).asChar();
+            check(c == '\'', () -> "asChar() is " + (int) c + ", expected 39");
+        }
+    }
+
+    /** bug spaceEscape: the `\s` escape (Java 15) is a space. */
+    @Test
+    void pin_spaceEscape() {
+        CompilationUnit cu = parse("class A { String s = \"a\\sb\"; char c = '\\s'; }");
+        String s = first(cu, StringLiteralExpr.class).asString();
+        char c = first(cu, CharLiteralExpr.class).asChar();
+        check(s.equals("a b"), () -> "StringLiteralExpr.asString() of \"a\\sb\" is " + Zoo.show(s) + ", expected \"a b\"");
+        check(c == ' ', () -> "CharLiteralExpr.asChar() of '\\s' is " + (int) c + ", expected 32");
+    }
+
+    /** bug unicodeEscapedBackslashInString: `"\""` is `"\""` (JLS 3.3). */
+    @Test
+    void pin_unicodeEscapedBackslashInString() {
+        CompilationUnit cu = parse("class A { String s = \"\\u005c\\u0022\"; }");
+        String s = first(cu, StringLiteralExpr.class).asString();
+        check(s.equals("\""), () -> "asString() is " + Zoo.show(s) + ", expected a lone double quote");
+    }
+
+    /** bug textBlockOpeningLine: white space after the opening delimiter is not content (JLS 3.10.6). */
+    @Test
+    void pin_textBlockOpeningLineTrailingSpace() {
+        CompilationUnit cu = parse("class A { String s = \"\"\"  \nx\n\"\"\"; }");
+        String s = first(cu, TextBlockLiteralExpr.class).asString();
+        check(s.equals("x\n"), () -> "asString() is " + Zoo.show(s) + ", expected \"x\\n\"");
+    }
+
+    /** bug textBlockFormFeed: a form feed is white space inside a text block, not a line terminator (JLS 3.4, 3.6). */
+    @Test
+    void pin_textBlockFormFeed() {
+        CompilationUnit cu = parse("class A { String s = \"\"\"\nx\f\ny\n\"\"\"; }");
+        TextBlockLiteralExpr tb = first(cu, TextBlockLiteralExpr.class);
+        String s = tb.asString();
+        check(s.equals("x\ny\n"), () -> "asString() is " + Zoo.show(s) + ", expected \"x\\ny\\n\"");
+        String printed = tb.toString();
+        check(!printed.contains("\n    \n"), () -> "the printer turned the form feed into a line break: " + Zoo.show(printed));
+    }
+
+    /** bug nestedUnaryPrinting: `- -x` must not print as `--x`. */
+    @Test
+    void pin_nestedUnaryPrinting() {
+        CompilationUnit cu = parse("class A { int a = - -x; int b = + +x; }");
+        for (VariableDeclarator vd : cu.findAll(VariableDeclarator.class)) {
+            Expression init = vd.getInitializer().get();
+            String printed = init.toString();
+            ParseResult<Expression> back = PARSER.parseExpression(printed);
+            boolean same = back.isSuccessful() && back.getResult().get() instanceof UnaryExpr && ((UnaryExpr) back.getResult().get()).getExpression() instanceof UnaryExpr;
+            check(same, () -> "the printer wrote " + Zoo.show(printed) + " for a unary operator applied to a unary expression, which reads back as " + back.getResult().map(Object::toString).orElse("nothing"));
+        }
+    }
+
+    /** bug lexicalPreservationMethodDims: `int m()[]` must be printed as written. */
+    @Test
+    void pin_lexicalPreservationMethodDims() {
+        String text = "class A { int m()[] { return null; } }";
+        CompilationUnit cu = new JavaParser(Readers.config(true).setLexicalPreservationEnabled(true)).parse(text).getResult().get();
+        LexicalPreservingPrinter.setup(cu);
+        String printed = LexicalPreservingPrinter.print(cu);
+        check(printed.equals(text), () -> "LexicalPreservingPrinter printed " + Zoo.show(printed));
+    }
+
+    /** bug typeParameterRange: a TypeParameter's range starts at its annotations. */
+    @Test
+    void pin_typeParameterRangeIncludesAnnotations() {
+        CompilationUnit cu = parse("class A<@B T> { }");
+        TypeParameter tp = first(cu, TypeParameter.class);
+        Range ann = tp.getAnnotations().get(0).getRange().get();
+        check(tp.getRange().get().contains(ann), () -> "TypeParameter " + range(tp) + " does not contain its annotation " + ann);
+    }
+
+    /** bug typePatternRange: a TypePatternExpr's range starts at its modifiers. */
+    @Test
+    void pin_typePatternRangeIncludesModifier() {
+        CompilationUnit cu = parse("class A { void m() { if (o instanceof final Bar b) { } } }");
+        TypePatternExpr p = first(cu, TypePatternExpr.class);
+        Range mod = p.getModifiers().get(0).getRange().get();
+        check(p.getRange().get().contains(mod), () -> "TypePatternExpr " + range(p) + " does not contain its modifier " + mod);
+    }
+
+    /** bug declaratorNameRange: the name of `int x[]` is `x`, its range must not cover the brackets. */
+    @Test
+    void pin_declaratorNameRangeExcludesBrackets() {
+        CompilationUnit cu = parse("class A { int x[]; }");
+        VariableDeclarator vd = first(cu, VariableDeclarator.class);
+        Range r = vd.getName().getRange().get();
+        check(r.begin.column == 15 && r.end.column == 15, () -> "SimpleName x has range " + r + ", expected (line 1,col 15)-(line 1,col 15)");
+    }
+
+    /** bug catchParameterRange: a catch parameter's range starts at its type, qualifier included. */
+    @Test
+    void pin_catchParameterRange() {
+        CompilationUnit cu = parse("class A { void m() { try { } catch (java.lang.Exception e) { } } }");
+        Parameter p = first(cu, Parameter.class);
+        Range t = p.getType().getRange().get();
+        check(p.getRange().get().contains(t), () -> "Parameter " + range(p) + " does not contain its type " + t);
+    }
+
+    /** bug typeAnnotationRange: a type's range includes its type annotations. */
+    @Test
+    void pin_typeAnnotationInsideTypeRange() {
+        CompilationUnit cu = parse("class A { void m() throws @B Foo { } java.util.List<@B Foo> f; }");
+        for (AnnotationExpr a : cu.findAll(AnnotationExpr.class)) {
+            Node type = a.getParentNode().get();
+            check(type instanceof Type && type.getRange().get().contains(a.getRange().get()), () -> type.getClass().getSimpleName() + " " + range(type) + " does not contain its annotation " + a + " " + range(a));
+        }
+    }
+
+    /** bug patternTypeParent: a parsed TypePatternExpr/RecordPatternExpr owns its type node (parent link, child list, findAll). */
+    @Test
+    void pin_patternTypeIsChildOfPattern() {
+        CompilationUnit cu = parse("class A { void m() { if (o instanceof Bar b) { } if (o instanceof Rec(Bar c)) { } } }");
+        TypePatternExpr p = first(cu, TypePatternExpr.class);
+        Node parent = p.getType().getParentNode().orElse(null);
+        check(parent == p, () -> "the type pattern type's parent is " + (parent == null ? "none" : parent.getClass().getSimpleName()) + ", expected the TypePatternExpr");
+        check(p.getChildNodes().contains(p.getType()), () -> "the type pattern's child nodes are " + p.getChildNodes() + ", missing its type");
+        com.github.javaparser.ast.expr.RecordPatternExpr r = first(cu, com.github.javaparser.ast.expr.RecordPatternExpr.class);
+        Node rparent = r.getType().getParentNode().orElse(null);
+        check(rparent == r, () -> "the record pattern type's parent is " + (rparent == null ? "none" : rparent.getClass().getSimpleName()) + ", expected the RecordPatternExpr");
+    }
+
+    /** bug methodReferenceAsOperand: a method reference is a Primary and may be an operand (JLS 15.8, 15.13). */
+    @Test
+    void pin_methodReferenceAsOperand() {
+        parse("class A { Object o = this::m ? 1 : 2; }");
+    }
+
+    /** bug javaparser/23: in `x * this::m` the `::m` belongs to the primary `this` (JLS 15.13), so the tree is `x * (this::m)`, not `(x * this)::m`. */
+    @Test
+    void pin_methodReferenceAfterOperatorScope() {
+        CompilationUnit cu = parse("class A { Object o = x * this::m; }");
+        Expression init = first(cu, VariableDeclarator.class).getInitializer().get();
+        boolean right = init instanceof BinaryExpr && ((BinaryExpr) init).getRight() instanceof MethodReferenceExpr
+                && ((MethodReferenceExpr) ((BinaryExpr) init).getRight()).getScope() instanceof ThisExpr;
+        check(right, () -> "`x * this::m` parsed as " + describe(init) + ", expected a BinaryExpr whose right operand is the method reference `this::m`");
+    }
+
+    static String describe(Expression e) {
+        if (e instanceof MethodReferenceExpr) {
+            Expression scope = ((MethodReferenceExpr) e).getScope();
+            return "a MethodReferenceExpr whose scope is the " + scope.getClass().getSimpleName() + " `" + scope + "`";
+        }
+        return "a " + e.getClass().getSimpleName() + " `" + e + "`";
+    }
+
+    /** bug enumConstantEmptyBody: `A {}` declares an anonymous class body, `A` does not; printing must keep it. */
+    @Test
+    void pin_enumConstantEmptyBody() {
+        CompilationUnit cu = parse("enum E { A { }, B }");
+        String printed = cu.toString();
+        check(printed.contains("A {"), () -> "the empty constant body was dropped: " + Zoo.show(printed));
+    }
+
+    /** bug lenientImportsAndPermits: `import static x;` and `permits Foo<T>` are not Java (JLS 7.5.3, 8.1.6). */
+    @Test
+    void pin_rejectsUnqualifiedStaticImportAndPermitsTypeArguments() {
+        ParseResult<CompilationUnit> a = PARSER.parse("import static x; class A { }");
+        check(!a.isSuccessful(), "`import static x;` was accepted");
+        ParseResult<CompilationUnit> b = PARSER.parse("sealed class A permits B<C> { }");
+        check(!b.isSuccessful(), "`permits B<C>` was accepted");
+    }
+}
