+    static final int NARROW = 6;
+    /** The surroundings of the narrow shapes; under HEGEL_NO_KNOWN without the two printer bugs' shapes (bugs 9, 10), which the printing properties would see. */
+    static final Lvl N = level(NARROW, Zoo.NO_KNOWN ? new Flags(false, true, true) : PLAIN);
