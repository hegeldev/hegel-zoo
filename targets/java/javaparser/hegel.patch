+            w("0").w(underscore(tc, pick(tc, "0", "7", "17", "777", "17777777777", "37777777777", "012")));
+        } else {
+            w(chance(tc, 50) ? "0b" : "0B").w(underscore(tc, pick(tc, "0", "1", "1010", "11111111", "1" + "0".repeat(31), "1".repeat(32))));
+        }
+    }
+
+    void longLiteral() {
+        int r = n(tc, 1, 4);
+        if (r == 1) {
