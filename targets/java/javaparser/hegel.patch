+            @Override
+            public Void visitInstanceOf(InstanceOfTree t, Void v) {
+                found[0] |= t.getExpression() instanceof InstanceOfTree;
+                return super.visitInstanceOf(t, v);
+            }
+        }.scan(cu, null);
+        return found[0];
+    }
