+
+/** javac's parse tree in the vocabulary of {@link Shape}. */
+final class JavacShape {
+
+    private final StringBuilder sb = new StringBuilder();
+    private final String text;
+
+    JavacShape(String text) {
+        this.text = text;
+    }
+
+    static String of(CompilationUnitTree cu, String text) {
+        JavacShape s = new JavacShape(text);
+        s.compilationUnit(cu);
+        return s.sb.toString();
+    }
+
+    private void open(String tag) {
+        sb.append('(').append(tag);
+    }
+
+    private void close() {
+        sb.append(')');
+    }
+
+    private void atom(String s) {
+        sb.append(' ').append(s);
+    }
+
+    private void text(String s) {
+        sb.append(" \"").append(s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r")).append('"');
+    }
+
+    static long flags(ModifiersTree m) {
+        return m == null ? 0 : ((JCTree.JCModifiers) m).flags;
+    }
+
+    void compilationUnit(CompilationUnitTree cu) {
+        open("cu");
+        if (cu.getPackage() != null) {
+            open("pkg");
+            expr(cu.getPackage().getPackageName());
+            close();
+        }
+        for (ImportTree imp : cu.getImports()) {
+            open("import");
+            if (imp.isStatic()) {
+                atom("static");
+            }
+            Tree q = imp.getQualifiedIdentifier();
+            boolean star = q instanceof MemberSelectTree && ((MemberSelectTree) q).getIdentifier().contentEquals("*");
+            expr(star ? ((MemberSelectTree) q).getExpression() : q);
+            if (star) {
+                atom("*");
+            }
+            close();
+        }
+        for (Tree t : cu.getTypeDecls()) {
+            if (t instanceof ClassTree) {
+                classDecl((ClassTree) t);
+            } else if (t.getKind() == Tree.Kind.EMPTY_STATEMENT) {
+                continue;
+            } else {
+                open("?" + t.getKind());
+                close();
+            }
+        }
+        close();
+    }
+
+    static final String[][] KEYWORDS = {
+        {"public", String.valueOf(Flags.PUBLIC)}, {"private", String.valueOf(Flags.PRIVATE)}, {"protected", String.valueOf(Flags.PROTECTED)},
+        {"static", String.valueOf(Flags.STATIC)}, {"final", String.valueOf(Flags.FINAL)}, {"synchronized", String.valueOf(Flags.SYNCHRONIZED)},
+        {"volatile", String.valueOf(Flags.VOLATILE)}, {"transient", String.valueOf(Flags.TRANSIENT)}, {"native", String.valueOf(Flags.NATIVE)},
+        {"abstract", String.valueOf(Flags.ABSTRACT)}, {"strictfp", String.valueOf(Flags.STRICTFP)}, {"default", String.valueOf(Flags.DEFAULT)},
+        {"sealed", String.valueOf(Flags.SEALED)}, {"non-sealed", String.valueOf(Flags.NON_SEALED)},
+    };
+
+    void modifiers(ModifiersTree m) {
+        long f = flags(m);
+        TreeSet<String> set = new TreeSet<>();
+        for (String[] k : KEYWORDS) {
+            if ((f & Long.parseLong(k[1])) != 0) {
+                set.add(k[0]);
+            }
+        }
+        open("mods");
+        for (String s : set) {
+            atom(s);
+        }
+        close();
+        open("anns");
+        if (m != null) {
+            for (AnnotationTree a : m.getAnnotations()) {
+                annotation(a);
+            }
+        }
+        close();
+    }
+
+    void annotationsOnly(ModifiersTree m) {
+        open("anns");
+        if (m != null) {
+            for (AnnotationTree a : m.getAnnotations()) {
+                annotation(a);
+            }
+        }
+        close();
+    }
+
+    void annotation(AnnotationTree a) {
+        open("ann");
+        expr(a.getAnnotationType());
+        for (ExpressionTree arg : a.getArguments()) {
+            open("pair");
+            if (arg instanceof AssignmentTree) {
+                atom(((IdentifierTree) ((AssignmentTree) arg).getVariable()).getName().toString());
+                expr(((AssignmentTree) arg).getExpression());
+            } else {
+                atom("value");
+                expr(arg);
+            }
+            close();
+        }
+        close();
+    }
+
+    void classDecl(ClassTree c) {
+        long f = flags(c.getModifiers());
+        boolean annotationType = c.getKind() == Tree.Kind.ANNOTATION_TYPE;
+        switch (c.getKind()) {
+            case INTERFACE:
+                open("interface");
+                break;
+            case ENUM:
+                open("enum");
+                break;
+            case RECORD:
+                open("record");
+                break;
+            case ANNOTATION_TYPE:
+                open("annotationtype");
+                break;
+            default:
+                open("class");
+        }
+        atom(c.getSimpleName().toString());
+        modifiers(c.getModifiers());
+        if (c.getKind() == Tree.Kind.CLASS || c.getKind() == Tree.Kind.INTERFACE || c.getKind() == Tree.Kind.RECORD) {
+            typeParameters(c.getTypeParameters());
+        }
+        if (c.getKind() == Tree.Kind.CLASS) {
+            open("extends");
+            if (c.getExtendsClause() != null) {
+                type(c.getExtendsClause());
+            }
+            close();
+        } else if (c.getKind() == Tree.Kind.INTERFACE) {
+            open("extends");
+            for (Tree t : c.getImplementsClause()) {
+                type(t);
+            }
+            close();
+        }
+        if (c.getKind() != Tree.Kind.ANNOTATION_TYPE) {
+            open("implements");
+            if (c.getKind() != Tree.Kind.INTERFACE) {
+                for (Tree t : c.getImplementsClause()) {
+                    type(t);
+                }
+            }
+            close();
+        }
+        if (c.getKind() == Tree.Kind.CLASS || c.getKind() == Tree.Kind.INTERFACE) {
+            open("permits");
+            for (Tree t : c.getPermitsClause()) {
+                type(t);
+            }
+            close();
+        }
+        members(c.getMembers(), annotationType);
+        close();
+    }
+
+    void typeParameters(List<? extends TypeParameterTree> tps) {
+        open("tps");
+        for (TypeParameterTree tp : tps) {
+            open("tp");
+            atom(tp.getName().toString());
+            open("anns");
+            for (AnnotationTree a : tp.getAnnotations()) {
+                annotation(a);
+            }
+            close();
+            for (Tree b : tp.getBounds()) {
+                type(b);
+            }
+            close();
+        }
+        close();
+    }
+
+    void members(List<? extends Tree> ms, boolean annotationType) {
+        open("members");
+        for (Tree m : ms) {
+            member(m, annotationType);
+        }
+        close();
+    }
+
+    void member(Tree m, boolean annotationType) {
+        if (m instanceof VariableTree) {
+            VariableTree v = (VariableTree) m;
+            long f = flags(v.getModifiers());
+            if ((f & Flags.ENUM) != 0) {
+                open("enumconst");
+                atom(v.getName().toString());
+                annotationsOnly(v.getModifiers());
+                NewClassTree init = (NewClassTree) v.getInitializer();
+                args(init == null ? List.of() : init.getArguments());
+                if (init != null && init.getClassBody() != null && !init.getClassBody().getMembers().isEmpty()) {
+                    members(init.getClassBody().getMembers(), false); // JavaParser cannot tell `A {}` from `A` (known bug, a pin carries it)
+                }
+                close();
+            } else if ((f & Flags.RECORD) != 0) {
+                open("component");
+                annotationsOnly(v.getModifiers());
+                atom(paramType(v));
+                atom(v.getName().toString());
+                close();
+            } else {
+                open("field");
+                modifiers(v.getModifiers());
+                type(v.getType());
+                atom(v.getName().toString());
+                if (v.getInitializer() != null) {
+                    expr(v.getInitializer());
+                }
+                close();
+            }
+        } else if (m instanceof MethodTree) {
+            MethodTree d = (MethodTree) m;
+            long f = flags(d.getModifiers());
+            if (d.getName().contentEquals("<init>")) {
+                if ((f & Flags.COMPACT_RECORD_CONSTRUCTOR) != 0) {
+                    open("compactctor");
+                    modifiers(d.getModifiers());
+                    typeParameters(d.getTypeParameters());
+                    throwsList(d.getThrows());
+                    stmt(d.getBody());
+                    close();
+                } else {
+                    open("ctor");
+                    modifiers(d.getModifiers());
+                    typeParameters(d.getTypeParameters());
+                    parameters(d.getParameters(), d.getReceiverParameter());
+                    throwsList(d.getThrows());
+                    stmt(d.getBody());
+                    close();
+                }
+            } else if (annotationType) {
+                open("annmember");
+                atom(d.getName().toString());
+                modifiers(d.getModifiers());
+                type(d.getReturnType());
+                if (d.getDefaultValue() != null) {
+                    open("default");
+                    expr(d.getDefaultValue());
+                    close();
+                }
+                close();
+            } else {
+                open("method");
+                atom(d.getName().toString());
+                modifiers(d.getModifiers());
+                typeParameters(d.getTypeParameters());
+                type(d.getReturnType());
+                parameters(d.getParameters(), d.getReceiverParameter());
+                throwsList(d.getThrows());
+                if (d.getBody() != null) {
+                    stmt(d.getBody());
+                }
+                close();
+            }
+        } else if (m instanceof BlockTree) {
+            open("init");
+            if (((BlockTree) m).isStatic()) {
+                atom("static");
+            }
+            stmt((BlockTree) m);
+            close();
+        } else if (m instanceof ClassTree) {
+            classDecl((ClassTree) m);
+        } else {
+            open("?" + m.getKind());
+            close();
+        }
+    }
+
+    void parameters(List<? extends VariableTree> ps, VariableTree receiver) {
+        open("params");
+        if (receiver != null) {
+            open("receiver");
+            type(receiver.getType());
+            atom(receiver.getNameExpression() != null ? squash(receiver.getNameExpression().toString()) : receiver.getName().toString());
+            close();
+        }
+        for (VariableTree p : ps) {
+            parameter(p);
+        }
+        close();
+    }
+
+    void parameter(VariableTree p) {
+        open("param");
+        modifiers(p.getModifiers());
+        atom(paramType(p));
+        atom(p.getName().toString());
+        close();
+    }
+
+    /** A parameter's type text; a varargs parameter's type is an array type in the tree already. */
+    String paramType(VariableTree p) {
+        return typeText(p.getType());
+    }
+
+    void throwsList(List<? extends ExpressionTree> ts) {
+        open("throws");
+        for (Tree t : ts) {
+            type(t);
+        }
+        close();
+    }
+
+    void type(Tree t) {
+        atom(typeText(t));
+    }
+
+    String typeText(Tree t) {
+        if (t == null) {
+            return "var";
+        }
+        return unescapeUnicode(squash(t.toString()));
+    }
+
+    /** javac's printer writes non-ASCII characters as \\uXXXX. */
+    static String unescapeUnicode(String s) {
+        if (s.indexOf("\\u") < 0) {
+            return s;
+        }
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < s.length(); i++) {
+            if (s.charAt(i) == '\\' && i + 5 < s.length() + 0 && i + 5 <= s.length() - 1 + 1 && s.charAt(i + 1) == 'u' && i + 6 <= s.length()) {
+                try {
+                    sb.append((char) Integer.parseInt(s.substring(i + 2, i + 6), 16));
+                    i += 5;
+                    continue;
+                } catch (NumberFormatException e) {
+                    // not an escape
+                }
+            }
+            sb.append(s.charAt(i));
+        }
+        return sb.toString();
+    }
+
+    // ---- statements -----------------------------------------------------------------------------
+
+    void stmts(List<? extends StatementTree> list) {
+        for (StatementTree s : list) {
+            stmt(s);
+        }
+    }
+
+    void stmt(Tree s) {
+        switch (s.getKind()) {
+            case EXPRESSION_STATEMENT: {
+                ExpressionTree e = ((ExpressionStatementTree) s).getExpression();
+                if (e instanceof MethodInvocationTree && ctorCall((MethodInvocationTree) e)) {
+                    return;
+                }
+                open("expr");
+                expr(e);
+                close();
+                return;
+            }
+            case VARIABLE:
+                local((VariableTree) s);
+                return;
+            case BLOCK:
+                open("block");
+                stmts(((BlockTree) s).getStatements());
+                close();
+                return;
+            case RETURN:
+                open("return");
+                if (((ReturnTree) s).getExpression() != null) {
+                    expr(((ReturnTree) s).getExpression());
+                }
+                close();
+                return;
+            case IF: {
+                IfTree i = (IfTree) s;
+                open("if");
+                expr(unparen(i.getCondition()));
+                stmt(i.getThenStatement());
+                if (i.getElseStatement() != null) {
+                    stmt(i.getElseStatement());
+                }
+                close();
+                return;
+            }
+            case WHILE_LOOP:
+                open("while");
+                expr(unparen(((WhileLoopTree) s).getCondition()));
+                stmt(((WhileLoopTree) s).getStatement());
+                close();
+                return;
+            case DO_WHILE_LOOP:
+                open("do");
+                stmt(((DoWhileLoopTree) s).getStatement());
+                expr(unparen(((DoWhileLoopTree) s).getCondition()));
+                close();
+                return;
+            case FOR_LOOP: {
+                ForLoopTree f = (ForLoopTree) s;
+                open("for");
+                open("init");
+                for (StatementTree i : f.getInitializer()) {
+                    if (i instanceof VariableTree) {
+                        local((VariableTree) i);
+                    } else {
+                        expr(((ExpressionStatementTree) i).getExpression());
+                    }
+                }
+                close();
+                open("cond");
+                if (f.getCondition() != null) {
+                    expr(f.getCondition());
+                }
+                close();
+                open("update");
+                for (ExpressionStatementTree u : f.getUpdate()) {
+                    expr(u.getExpression());
+                }
+                close();
+                stmt(f.getStatement());
+                close();
+                return;
+            }
+            case ENHANCED_FOR_LOOP: {
+                EnhancedForLoopTree f = (EnhancedForLoopTree) s;
+                open("foreach");
+                local(f.getVariable());
+                expr(f.getExpression());
+                stmt(f.getStatement());
+                close();
+                return;
+            }
+            case BREAK:
+                open("break");
+                if (((BreakTree) s).getLabel() != null) {
+                    atom(((BreakTree) s).getLabel().toString());
+                }
+                close();
+                return;
+            case CONTINUE:
+                open("continue");
+                if (((ContinueTree) s).getLabel() != null) {
+                    atom(((ContinueTree) s).getLabel().toString());
+                }
+                close();
+                return;
+            case THROW:
+                open("throw");
+                expr(((ThrowTree) s).getExpression());
+                close();
+                return;
+            case YIELD:
+                open("yield");
+                expr(((YieldTree) s).getValue());
+                close();
+                return;
+            case EMPTY_STATEMENT:
+                open("empty");
+                close();
+                return;
+            case LABELED_STATEMENT:
+                open("label");
+                atom(((LabeledStatementTree) s).getLabel().toString());
+                stmt(((LabeledStatementTree) s).getStatement());
+                close();
+                return;
+            case SYNCHRONIZED:
+                open("sync");
+                expr(unparen(((SynchronizedTree) s).getExpression()));
+                stmt(((SynchronizedTree) s).getBlock());
+                close();
+                return;
+            case ASSERT:
+                open("assert");
+                expr(((AssertTree) s).getCondition());
+                if (((AssertTree) s).getDetail() != null) {
+                    expr(((AssertTree) s).getDetail());
+                }
+                close();
+                return;
+            case TRY: {
+                TryTree t = (TryTree) s;
+                open("try");
+                open("resources");
+                for (Tree r : t.getResources()) {
+                    if (r instanceof VariableTree) {
+                        local((VariableTree) r);
+                    } else {
+                        expr(r);
+                    }
+                }
+                close();
+                stmt(t.getBlock());
+                for (CatchTree c : t.getCatches()) {
+                    open("catch");
+                    parameter(c.getParameter());
+                    stmt(c.getBlock());
+                    close();
+                }
+                if (t.getFinallyBlock() != null) {
+                    open("finally");
+                    stmt(t.getFinallyBlock());
+                    close();
+                }
+                close();
+                return;
+            }
+            case SWITCH:
+                open("switch");
+                expr(unparen(((SwitchTree) s).getExpression()));
+                for (CaseTree c : ((SwitchTree) s).getCases()) {
+                    switchCase(c);
+                }
+                close();
+                return;
+            case CLASS:
+            case INTERFACE:
+            case ENUM:
+            case RECORD:
+            case ANNOTATION_TYPE:
+                classDecl((ClassTree) s);
+                return;
+            default:
+                open("?" + s.getKind());
+                close();
+        }
+    }
+
+    /** javac keeps the parentheses of if/while/switch conditions as a ParenthesizedTree; JavaParser does not. */
+    static ExpressionTree unparen(ExpressionTree e) {
+        return e instanceof ParenthesizedTree ? ((ParenthesizedTree) e).getExpression() : e;
+    }
+
+    boolean ctorCall(MethodInvocationTree m) {
+        ExpressionTree sel = m.getMethodSelect();
+        String which = null;
+        ExpressionTree outer = null;
+        if (sel instanceof IdentifierTree) {
+            String n = ((IdentifierTree) sel).getName().toString();
+            if (n.equals("this") || n.equals("super")) {
+                which = n;
+            }
+        } else if (sel instanceof MemberSelectTree && ((MemberSelectTree) sel).getIdentifier().contentEquals("super")) {
+            which = "super";
+            outer = ((MemberSelectTree) sel).getExpression();
+        }
+        if (which == null) {
+            return false;
+        }
+        open("ctorcall");
+        atom(which);
+        if (outer != null) {
+            expr(outer);
+        }
+        typeArgs(m.getTypeArguments());
+        args(m.getArguments());
+        close();
+        return true;
+    }
+
+    void local(VariableTree v) {
+        open("local");
+        modifiers(v.getModifiers());
+        type(v.getType());
+        atom(v.getName().toString());
+        if (v.getInitializer() != null) {
+            expr(v.getInitializer());
+        }
+        close();
+    }
+
+    void switchCase(CaseTree c) {
+        open("case");
+        open("labels");
+        boolean dflt = false;
+        for (CaseLabelTree l : c.getLabels()) {
+            if (l instanceof ConstantCaseLabelTree) {
+                expr(((ConstantCaseLabelTree) l).getConstantExpression());
+            } else if (l instanceof PatternCaseLabelTree) {
+                pattern(((PatternCaseLabelTree) l).getPattern());
+            } else {
+                dflt = true;
+            }
+        }
+        if (dflt) {
+            atom("default");
+        }
+        close();
+        if (c.getGuard() != null) {
+            open("guard");
+            expr(c.getGuard());
+            close();
+        }
+        if (c.getCaseKind() == CaseTree.CaseKind.RULE) {
+            atom("rule");
+            Tree body = c.getBody();
+            if (body instanceof ExpressionStatementTree) {
+                expr(((ExpressionStatementTree) body).getExpression());
+            } else if (body instanceof ExpressionTree) {
+                expr((ExpressionTree) body);
+            } else {
+                stmt(body);
+            }
+        } else {
+            atom("group");
+            stmts(c.getStatements());
+        }
+        close();
+    }
+
+    void pattern(PatternTree p) {
+        if (p instanceof BindingPatternTree) {
+            VariableTree v = ((BindingPatternTree) p).getVariable();
+            open("typepat");
+            modifiers(v.getModifiers());
+            type(v.getType());
+            atom(v.getName().toString());
+            close();
+        } else if (p instanceof DeconstructionPatternTree) {
+            DeconstructionPatternTree d = (DeconstructionPatternTree) p;
+            open("recpat");
+            type(d.getDeconstructor());
+            for (PatternTree sub : d.getNestedPatterns()) {
+                pattern(sub);
+            }
+            close();
+        } else if (p.getKind() == Tree.Kind.ANY_PATTERN) {
+            open("anypat");
+            close();
+        } else {
+            open("?" + p.getKind());
+            close();
+        }
+    }
+
+    // ---- expressions ----------------------------------------------------------------------------
+
+    void args(List<? extends ExpressionTree> es) {
+        open("args");
+        for (ExpressionTree e : es) {
+            expr(e);
+        }
+        close();
+    }
+
+    void typeArgs(List<? extends Tree> ts) {
+        open("targs");
+        if (ts != null) {
+            for (Tree t : ts) {
+                type(t);
+            }
+        }
+        close();
+    }
+
+    static String binaryOp(Tree.Kind k) {
+        switch (k) {
+            case PLUS: return "+";
+            case MINUS: return "-";
+            case MULTIPLY: return "*";
+            case DIVIDE: return "/";
+            case REMAINDER: return "%";
+            case LEFT_SHIFT: return "<<";
+            case RIGHT_SHIFT: return ">>";
+            case UNSIGNED_RIGHT_SHIFT: return ">>>";
+            case LESS_THAN: return "<";
+            case GREATER_THAN: return ">";
+            case LESS_THAN_EQUAL: return "<=";
+            case GREATER_THAN_EQUAL: return ">=";
+            case EQUAL_TO: return "==";
+            case NOT_EQUAL_TO: return "!=";
+            case AND: return "&";
+            case XOR: return "^";
+            case OR: return "|";
+            case CONDITIONAL_AND: return "&&";
+            case CONDITIONAL_OR: return "||";
+            default: return "?" + k;
+        }
+    }
+
+    static String compoundOp(Tree.Kind k) {
+        switch (k) {
+            case PLUS_ASSIGNMENT: return "+=";
+            case MINUS_ASSIGNMENT: return "-=";
+            case MULTIPLY_ASSIGNMENT: return "*=";
+            case DIVIDE_ASSIGNMENT: return "/=";
+            case REMAINDER_ASSIGNMENT: return "%=";
+            case LEFT_SHIFT_ASSIGNMENT: return "<<=";
+            case RIGHT_SHIFT_ASSIGNMENT: return ">>=";
+            case UNSIGNED_RIGHT_SHIFT_ASSIGNMENT: return ">>>=";
+            case AND_ASSIGNMENT: return "&=";
+            case XOR_ASSIGNMENT: return "^=";
+            case OR_ASSIGNMENT: return "|=";
+            default: return "?" + k;
+        }
+    }
+
+    static String unaryOp(Tree.Kind k) {
+        switch (k) {
+            case UNARY_PLUS: return "+";
+            case UNARY_MINUS: return "-";
+            case BITWISE_COMPLEMENT: return "~";
+            case LOGICAL_COMPLEMENT: return "!";
+            case PREFIX_INCREMENT: return "++";
+            case PREFIX_DECREMENT: return "--";
+            case POSTFIX_INCREMENT: return "++post";
+            case POSTFIX_DECREMENT: return "--post";
+            default: return "?" + k;
+        }
+    }
+
+    boolean startsWithMinus(Tree e) {
+        int pos = ((JCTree) e).getStartPosition();
+        return pos >= 0 && pos < text.length() && text.charAt(pos) == '-';
+    }
+
+    static boolean isTypeTree(Tree t) {
+        switch (t.getKind()) {
+            case ARRAY_TYPE:
+            case PARAMETERIZED_TYPE:
+            case PRIMITIVE_TYPE:
+            case ANNOTATED_TYPE:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    void expr(Tree e) {
+        switch (e.getKind()) {
+            case IDENTIFIER: {
+                String n = ((IdentifierTree) e).getName().toString();
+                if (n.equals("this") || n.equals("super")) {
+                    open(n);
+                    close();
+                } else {
+                    open("name");
+                    atom(n);
+                    close();
+                }
+                return;
+            }
+            case MEMBER_SELECT: {
+                MemberSelectTree m = (MemberSelectTree) e;
+                String id = m.getIdentifier().toString();
+                if (id.equals("this") || id.equals("super")) {
+                    open(id);
+                    expr(m.getExpression());
+                    close();
+                } else if (id.equals("class")) {
+                    open("classlit");
+                    type(m.getExpression());
+                    close();
+                } else if (isTypeTree(m.getExpression())) {
+                    open("type"); // a method reference's scope `Foo<T>.Node::m`: JavaParser has one TypeExpr for it
+                    type(m);
+                    close();
+                } else {
+                    open("field");
+                    expr(m.getExpression());
+                    atom(id);
+                    close();
+                }
+                return;
+            }
+            case INT_LITERAL:
+            case LONG_LITERAL:
+            case FLOAT_LITERAL:
+            case DOUBLE_LITERAL:
+            case BOOLEAN_LITERAL:
+            case CHAR_LITERAL:
+            case STRING_LITERAL:
+            case NULL_LITERAL: {
+                Object v = ((LiteralTree) e).getValue();
+                if ((e.getKind() == Tree.Kind.INT_LITERAL || e.getKind() == Tree.Kind.LONG_LITERAL) && startsWithMinus(e)) {
+                    // javac folds `-` into a following decimal literal; JavaParser keeps the unary minus
+                    open("un");
+                    atom("-");
+                    open("lit");
+                    atom(e.getKind() == Tree.Kind.INT_LITERAL ? "int" : "long");
+                    atom(java.math.BigInteger.valueOf(((Number) v).longValue()).negate().toString());
+                    close();
+                    close();
+                    return;
+                }
+                open("lit");
+                switch (e.getKind()) {
+                    case INT_LITERAL:
+                        atom("int");
+                        atom(String.valueOf(v));
+                        break;
+                    case LONG_LITERAL:
+                        atom("long");
+                        atom(String.valueOf(v));
+                        break;
+                    case FLOAT_LITERAL:
+                        atom("float");
+                        atom(Float.toString((Float) v));
+                        break;
+                    case DOUBLE_LITERAL:
+                        atom("double");
+                        atom(Double.toString((Double) v));
+                        break;
+                    case BOOLEAN_LITERAL:
+                        atom("bool");
+                        atom(String.valueOf(v));
+                        break;
+                    case CHAR_LITERAL:
+                        atom("char");
+                        atom(String.valueOf((int) (Character) v));
+                        break;
+                    case STRING_LITERAL:
+                        atom("string");
+                        text((String) v);
+                        break;
+                    default:
+                        atom("null");
+                }
+                close();
+                return;
+            }
+            case PARENTHESIZED:
+                open("paren");
+                expr(((ParenthesizedTree) e).getExpression());
+                close();
+                return;
+            case ASSIGNMENT:
+                open("assign");
+                atom("=");
+                expr(((AssignmentTree) e).getVariable());
+                expr(((AssignmentTree) e).getExpression());
+                close();
+                return;
+            case CONDITIONAL_EXPRESSION: {
+                ConditionalExpressionTree c = (ConditionalExpressionTree) e;
+                open("cond");
+                expr(c.getCondition());
+                expr(c.getTrueExpression());
+                expr(c.getFalseExpression());
+                close();
+                return;
+            }
+            case TYPE_CAST:
+                open("cast");
+                type(((TypeCastTree) e).getType());
+                expr(((TypeCastTree) e).getExpression());
+                close();
+                return;
+            case INSTANCE_OF: {
+                InstanceOfTree i = (InstanceOfTree) e;
+                open("instanceof");
+                expr(i.getExpression());
+                if (i.getPattern() != null) {
+                    pattern(i.getPattern());
+                } else {
+                    type(i.getType());
+                }
+                close();
+                return;
+            }
+            case METHOD_INVOCATION: {
+                MethodInvocationTree m = (MethodInvocationTree) e;
+                ExpressionTree sel = m.getMethodSelect();
+                open("call");
+                if (sel instanceof MemberSelectTree) {
+                    atom(((MemberSelectTree) sel).getIdentifier().toString());
+                    open("scope");
+                    expr(((MemberSelectTree) sel).getExpression());
+                    close();
+                } else {
+                    atom(((IdentifierTree) sel).getName().toString());
+                    open("scope");
+                    close();
+                }
+                typeArgs(m.getTypeArguments());
+                args(m.getArguments());
+                close();
+                return;
+            }
+            case NEW_CLASS: {
+                NewClassTree n = (NewClassTree) e;
+                open("new");
+                open("outer");
+                if (n.getEnclosingExpression() != null) {
+                    expr(n.getEnclosingExpression());
+                }
+                close();
+                typeArgs(n.getTypeArguments());
+                type(n.getIdentifier());
+                args(n.getArguments());
+                if (n.getClassBody() != null) {
+                    members(n.getClassBody().getMembers(), false);
+                }
+                close();
+                return;
+            }
+            case NEW_ARRAY: {
+                NewArrayTree n = (NewArrayTree) e;
+                if (n.getType() == null) {
+                    open("arrayinit");
+                    for (ExpressionTree v : n.getInitializers()) {
+                        expr(v);
+                    }
+                    close();
+                    return;
+                }
+                Tree base = n.getType();
+                // javac drops the `[]` that an initializer replaces: `new int[] {..}` has element type int and no dims
+                int rank = n.getInitializers() != null ? 1 : n.getDimensions().size();
+                while (base instanceof ArrayTypeTree) {
+                    base = ((ArrayTypeTree) base).getType();
+                    rank++;
+                }
+                open("newarray");
+                type(base);
+                atom(String.valueOf(rank));
+                open("dims");
+                for (ExpressionTree d : n.getDimensions()) {
+                    expr(d);
+                }
+                close();
+                if (n.getInitializers() != null) {
+                    open("arrayinit");
+                    for (ExpressionTree v : n.getInitializers()) {
+                        expr(v);
+                    }
+                    close();
+                }
+                close();
+                return;
+            }
+            case ARRAY_ACCESS:
+                open("index");
+                expr(((ArrayAccessTree) e).getExpression());
+                expr(((ArrayAccessTree) e).getIndex());
+                close();
+                return;
+            case LAMBDA_EXPRESSION: {
+                LambdaExpressionTree l = (LambdaExpressionTree) e;
+                open("lambda");
+                open("params");
+                for (VariableTree p : l.getParameters()) {
+                    open("param");
+                    modifiers(p.getModifiers());
+                    atom(p.getType() == null || ((JCTree.JCLambda) l).paramKind == JCTree.JCLambda.ParameterKind.IMPLICIT ? "?" : paramType(p));
+                    atom(p.getName().toString());
+                    close();
+                }
+                close();
+                if (l.getBodyKind() == LambdaExpressionTree.BodyKind.EXPRESSION) {
+                    expr(l.getBody());
+                } else {
+                    stmt(l.getBody());
+                }
+                close();
+                return;
+            }
+            case MEMBER_REFERENCE: {
+                MemberReferenceTree m = (MemberReferenceTree) e;
+                open("mref");
+                atom(m.getMode() == MemberReferenceTree.ReferenceMode.NEW ? "new" : m.getName().toString());
+                ExpressionTree q = m.getQualifierExpression();
+                if (isTypeTree(q)) {
+                    open("type");
+                    type(q);
+                    close();
+                } else {
+                    expr(q);
+                }
+                typeArgs(m.getTypeArguments());
+                close();
+                return;
+            }
+            case SWITCH_EXPRESSION:
+                open("switchexpr");
+                expr(unparen(((SwitchExpressionTree) e).getExpression()));
+                for (CaseTree c : ((SwitchExpressionTree) e).getCases()) {
+                    switchCase(c);
+                }
+                close();
+                return;
+            case ANNOTATION:
+            case TYPE_ANNOTATION:
+                annotation((AnnotationTree) e);
+                return;
+            case ARRAY_TYPE:
+            case PARAMETERIZED_TYPE:
+            case PRIMITIVE_TYPE:
+            case ANNOTATED_TYPE:
+                open("type");
+                type(e);
+                close();
+                return;
+            case BINDING_PATTERN:
+            case DECONSTRUCTION_PATTERN:
+            case ANY_PATTERN:
+                pattern((PatternTree) e);
+                return;
+            default:
+                if (e instanceof BinaryTree) {
+                    open("bin");
+                    atom(binaryOp(e.getKind()));
+                    expr(((BinaryTree) e).getLeftOperand());
+                    expr(((BinaryTree) e).getRightOperand());
+                    close();
+                } else if (e instanceof CompoundAssignmentTree) {
+                    open("assign");
+                    atom(compoundOp(e.getKind()));
+                    expr(((CompoundAssignmentTree) e).getVariable());
+                    expr(((CompoundAssignmentTree) e).getExpression());
+                    close();
+                } else if (e instanceof UnaryTree) {
+                    open("un");
+                    atom(unaryOp(e.getKind()));
+                    expr(((UnaryTree) e).getExpression());
+                    close();
+                } else {
+                    open("?" + e.getKind());
+                    close();
+                }
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/Readers.java b/hegel/src/test/java/zoo/Readers.java
new file mode 100644
index 0000000..a3bb0bc
--- /dev/null
+++ b/hegel/src/test/java/zoo/Readers.java
@@ -0,0 +1,126 @@
+package zoo;
+
+import com.github.javaparser.JavaParser;
+import com.github.javaparser.ParseResult;
+import com.github.javaparser.ParserConfiguration;
+import com.github.javaparser.ParserConfiguration.LanguageLevel;
+import com.github.javaparser.Problem;
+import com.github.javaparser.ast.CompilationUnit;
+import com.sun.source.tree.CompilationUnitTree;
+import com.sun.source.util.JavacTask;
+import java.io.IOException;
+import java.net.URI;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import javax.tools.Diagnostic;
+import javax.tools.DiagnosticCollector;
+import javax.tools.JavaCompiler;
+import javax.tools.JavaFileObject;
+import javax.tools.SimpleJavaFileObject;
+import javax.tools.StandardJavaFileManager;
+import javax.tools.ToolProvider;
+
+/** The two readers: JavaParser (the target) and javac's own parser (the oracle), both at Java 21. */
+final class Readers {
+
+    static final String RELEASE = "21";
+
+    static ParserConfiguration config(boolean comments) {
+        return new ParserConfiguration().setLanguageLevel(LanguageLevel.JAVA_21).setAttributeComments(comments).setLexicalPreservationEnabled(false);
+    }
+
+    /** What JavaParser made of a text. */
+    static final class Jp {
+        final CompilationUnit cu;
+        final List<String> problems;
+        final Throwable crash;
+
+        Jp(CompilationUnit cu, List<String> problems, Throwable crash) {
+            this.cu = cu;
+            this.problems = problems;
+            this.crash = crash;
+        }
+
+        boolean ok() {
+            return cu != null && problems.isEmpty() && crash == null;
+        }
+
+        @Override
+        public String toString() {
+            if (crash != null) {
+                return "crash " + crash.getClass().getName() + ": " + EngineText.firstLine(crash.getMessage());
+            }
+            return ok() ? "ok" : problems.size() + " problem(s): " + EngineText.firstLine(String.join(" | ", problems));
+        }
+    }
+
+    static Jp javaparser(String text, boolean comments) {
+        try {
+            ParseResult<CompilationUnit> r = new JavaParser(config(comments)).parse(text);
+            List<String> problems = new ArrayList<>();
+            for (Problem p : r.getProblems()) {
+                problems.add(p.getVerboseMessage());
+            }
+            return new Jp(r.getResult().orElse(null), problems, null);
+        } catch (RuntimeException | StackOverflowError e) {
+            return new Jp(null, List.of(), e);
+        }
+    }
+
+    /** What javac's parser made of a text. */
+    static final class Jc {
+        final CompilationUnitTree cu;
+        final JavacTask task;
+        final List<String> errors;
+        final Throwable crash;
+
+        Jc(CompilationUnitTree cu, JavacTask task, List<String> errors, Throwable crash) {
+            this.cu = cu;
+            this.task = task;
+            this.errors = errors;
+            this.crash = crash;
+        }
+
+        boolean ok() {
+            return cu != null && errors.isEmpty() && crash == null;
+        }
+
+        @Override
+        public String toString() {
+            if (crash != null) {
+                return "crash " + crash.getClass().getName() + ": " + EngineText.firstLine(crash.getMessage());
+            }
+            return ok() ? "ok" : errors.size() + " error(s): " + EngineText.firstLine(String.join(" | ", errors));
+        }
+    }
+
+    static final JavaCompiler COMPILER = ToolProvider.getSystemJavaCompiler();
+    static final StandardJavaFileManager FILES = COMPILER.getStandardFileManager(null, Locale.ROOT, null);
+
+    static Jc javac(String text) {
+        DiagnosticCollector<JavaFileObject> diags = new DiagnosticCollector<>();
+        JavaFileObject file = new SimpleJavaFileObject(URI.create("string:///Gen.java"), JavaFileObject.Kind.SOURCE) {
+            @Override
+            public CharSequence getCharContent(boolean ignoreEncodingErrors) {
+                return text;
+            }
+        };
+        try {
+            JavacTask task = (JavacTask) COMPILER.getTask(null, FILES, diags, List.of("-proc:none", "--release", RELEASE, "-Xlint:none", "-XDshould-stop.at=PARSE"), null, List.of(file));
+            CompilationUnitTree cu = null;
+            for (CompilationUnitTree u : task.parse()) {
+                cu = u;
+            }
+            List<String> errors = new ArrayList<>();
+            for (Diagnostic<? extends JavaFileObject> d : diags.getDiagnostics()) {
+                if (d.getKind() == Diagnostic.Kind.ERROR) {
+                    errors.add(d.getLineNumber() + ":" + d.getColumnNumber() + " " + d.getMessage(Locale.ROOT));
+                }
+            }
+            return new Jc(cu, task, errors, null);
+        } catch (IOException | RuntimeException | StackOverflowError e) {
+            return new Jc(null, null, List.of(), e);
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/Shape.java b/hegel/src/test/java/zoo/Shape.java
new file mode 100644
index 0000000..e1022e9
--- /dev/null
+++ b/hegel/src/test/java/zoo/Shape.java
@@ -0,0 +1,964 @@
+package zoo;
+
+import static zoo.EngineText.squash;
+
+import com.github.javaparser.ast.ArrayCreationLevel;
+import com.github.javaparser.ast.CompilationUnit;
+import com.github.javaparser.ast.ImportDeclaration;
+import com.github.javaparser.ast.Modifier;
+import com.github.javaparser.ast.Node;
+import com.github.javaparser.ast.NodeList;
+import com.github.javaparser.ast.PackageDeclaration;
+import com.github.javaparser.ast.body.AnnotationDeclaration;
