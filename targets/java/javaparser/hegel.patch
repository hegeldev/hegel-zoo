+                modifiers(p.getModifiers(), p.getAnnotations());
+                String t = p.getType() instanceof VarType || p.getType().isUnknownType() ? "?" : squash(p.getType().asString()) + (p.isVarArgs() ? "[]" : "");
+                atom(t);
+                atom(p.getNameAsString());
+                close();
+            }
+            close();
+            if (l.getExpressionBody().isPresent()) {
+                expr(l.getExpressionBody().get());
+            } else {
+                stmt(l.getBody());
+            }
+            close();
+        } else if (e instanceof MethodReferenceExpr) {
+            MethodReferenceExpr m = (MethodReferenceExpr) e;
+            open("mref");
+            atom(m.getIdentifier());
+            Expression scope = m.getScope();
+            if (scope instanceof TypeExpr) {
+                Type t = ((TypeExpr) scope).getType();
+                String text = typeText(t);
+                if (t instanceof ClassOrInterfaceType && !text.contains("<") && !text.contains("@") || t instanceof VarType) {
+                    nameText(text); // javac reads `var::m` as a name
+                } else {
+                    open("type");
+                    type(t);
+                    close();
+                }
