+                expr(e);
+                close();
+            }
+        } else if (s instanceof BlockStmt) {
+            open("block");
+            stmts(((BlockStmt) s).getStatements());
+            close();
+        } else if (s instanceof ReturnStmt) {
+            open("return");
+            ((ReturnStmt) s).getExpression().ifPresent(this::expr);
+            close();
+        } else if (s instanceof IfStmt) {
+            IfStmt i = (IfStmt) s;
+            open("if");
+            expr(i.getCondition());
+            stmt(i.getThenStmt());
+            i.getElseStmt().ifPresent(this::stmt);
+            close();
+        } else if (s instanceof WhileStmt) {
+            open("while");
+            expr(((WhileStmt) s).getCondition());
+            stmt(((WhileStmt) s).getBody());
+            close();
+        } else if (s instanceof DoStmt) {
+            open("do");
+            stmt(((DoStmt) s).getBody());
+            expr(((DoStmt) s).getCondition());
+            close();
+        } else if (s instanceof ForStmt) {
+            ForStmt f = (ForStmt) s;
+            open("for");
+            open("init");
+            for (Expression e : f.getInitialization()) {
+                if (e instanceof VariableDeclarationExpr) {
+                    locals((VariableDeclarationExpr) e);
+                } else {
+                    expr(e);
+                }
+            }
+            close();
+            open("cond");
+            f.getCompare().ifPresent(this::expr);
+            close();
+            open("update");
+            for (Expression e : f.getUpdate()) {
+                expr(e);
+            }
+            close();
+            stmt(f.getBody());
+            close();
+        } else if (s instanceof ForEachStmt) {
+            ForEachStmt f = (ForEachStmt) s;
+            open("foreach");
+            locals(f.getVariable());
+            expr(f.getIterable());
+            stmt(f.getBody());
+            close();
+        } else if (s instanceof BreakStmt) {
+            open("break");
+            ((BreakStmt) s).getLabel().ifPresent(l -> atom(l.asString()));
+            close();
+        } else if (s instanceof ContinueStmt) {
+            open("continue");
+            ((ContinueStmt) s).getLabel().ifPresent(l -> atom(l.asString()));
+            close();
+        } else if (s instanceof ThrowStmt) {
+            open("throw");
+            expr(((ThrowStmt) s).getExpression());
+            close();
+        } else if (s instanceof YieldStmt) {
+            open("yield");
+            expr(((YieldStmt) s).getExpression());
+            close();
+        } else if (s instanceof EmptyStmt) {
+            open("empty");
+            close();
+        } else if (s instanceof LabeledStmt) {
+            open("label");
+            atom(((LabeledStmt) s).getLabel().asString());
+            stmt(((LabeledStmt) s).getStatement());
+            close();
+        } else if (s instanceof SynchronizedStmt) {
+            open("sync");
+            expr(((SynchronizedStmt) s).getExpression());
+            stmt(((SynchronizedStmt) s).getBody());
+            close();
+        } else if (s instanceof AssertStmt) {
+            open("assert");
+            expr(((AssertStmt) s).getCheck());
+            ((AssertStmt) s).getMessage().ifPresent(this::expr);
+            close();
+        } else if (s instanceof TryStmt) {
+            TryStmt t = (TryStmt) s;
+            open("try");
+            open("resources");
+            for (Expression r : t.getResources()) {
+                if (r instanceof VariableDeclarationExpr) {
+                    locals((VariableDeclarationExpr) r);
+                } else {
+                    expr(r);
+                }
+            }
+            close();
+            stmt(t.getTryBlock());
+            for (CatchClause c : t.getCatchClauses()) {
+                open("catch");
+                parameter(c.getParameter());
+                stmt(c.getBody());
+                close();
+            }
+            if (t.getFinallyBlock().isPresent()) {
+                open("finally");
+                stmt(t.getFinallyBlock().get());
+                close();
+            }
+            close();
+        } else if (s instanceof SwitchStmt) {
+            open("switch");
+            expr(((SwitchStmt) s).getSelector());
+            for (SwitchEntry e : ((SwitchStmt) s).getEntries()) {
+                switchEntry(e);
+            }
+            close();
+        } else if (s instanceof ExplicitConstructorInvocationStmt) {
+            ExplicitConstructorInvocationStmt c = (ExplicitConstructorInvocationStmt) s;
+            open("ctorcall");
+            atom(c.isThis() ? "this" : "super");
+            if (c.getExpression().isPresent()) {
+                expr(c.getExpression().get());
+            }
+            typeArgs(c.getTypeArguments());
+            args(c.getArguments());
+            close();
+        } else if (s instanceof LocalClassDeclarationStmt) {
+            typeDecl(((LocalClassDeclarationStmt) s).getClassDeclaration());
+        } else if (s instanceof LocalRecordDeclarationStmt) {
+            typeDecl(((LocalRecordDeclarationStmt) s).getRecordDeclaration());
+        } else {
+            open("?" + s.getClass().getSimpleName());
+            close();
+        }
+    }
+
+    void locals(VariableDeclarationExpr d) {
+        for (VariableDeclarator v : d.getVariables()) {
+            open("local");
+            modifiers(d.getModifiers(), d.getAnnotations());
+            type(v.getType());
+            atom(v.getNameAsString());
+            if (v.getInitializer().isPresent()) {
+                expr(v.getInitializer().get());
+            }
+            close();
+        }
+    }
+
+    void switchEntry(SwitchEntry e) {
+        open("case");
+        open("labels");
+        for (Expression l : e.getLabels()) {
+            expr(l);
+        }
+        if (e.isDefault()) {
+            atom("default");
+        }
+        close();
+        if (e.getGuard().isPresent()) {
+            open("guard");
+            expr(e.getGuard().get());
+            close();
+        }
+        switch (e.getType()) {
+            case STATEMENT_GROUP:
+                atom("group");
+                stmts(e.getStatements());
+                break;
+            case EXPRESSION:
+                atom("rule");
+                if (e.getStatements().size() == 1 && e.getStatements().get(0) instanceof ExpressionStmt) {
+                    expr(((ExpressionStmt) e.getStatements().get(0)).getExpression());
+                } else {
+                    stmts(e.getStatements());
+                }
+                break;
+            default:
+                atom("rule");
+                stmts(e.getStatements());
+        }
+        close();
+    }
+
+    // ---- expressions ----------------------------------------------------------------------------
+
+    void args(NodeList<Expression> es) {
+        open("args");
+        for (Expression e : es) {
+            expr(e);
+        }
+        close();
+    }
+
+    void typeArgs(Optional<NodeList<Type>> ts) {
+        open("targs");
+        if (ts.isPresent()) {
+            for (Type t : ts.get()) {
+                type(t);
+            }
+        }
+        close();
+    }
+
+    void expr(Expression e) {
+        if (e instanceof NameExpr) {
+            open("name");
+            atom(((NameExpr) e).getNameAsString());
+            close();
+        } else if (e instanceof FieldAccessExpr) {
+            FieldAccessExpr f = (FieldAccessExpr) e;
+            open("field");
+            expr(f.getScope());
+            atom(f.getNameAsString());
+            close();
+        } else if (e instanceof IntegerLiteralExpr) {
+            open("lit");
+            atom("int");
+            atom(String.valueOf(((IntegerLiteralExpr) e).asNumber()));
+            close();
+        } else if (e instanceof LongLiteralExpr) {
+            open("lit");
+            atom("long");
+            atom(String.valueOf(((LongLiteralExpr) e).asNumber()));
+            close();
+        } else if (e instanceof DoubleLiteralExpr) {
+            DoubleLiteralExpr d = (DoubleLiteralExpr) e;
+            String v = d.getValue();
+            boolean isFloat = v.endsWith("f") || v.endsWith("F");
+            open("lit");
+            atom(isFloat ? "float" : "double");
+            atom(isFloat ? Float.toString((float) d.asDouble()) : Double.toString(d.asDouble()));
+            close();
+        } else if (e instanceof CharLiteralExpr) {
+            open("lit");
+            atom("char");
+            atom(String.valueOf((int) ((CharLiteralExpr) e).asChar()));
+            close();
+        } else if (e instanceof TextBlockLiteralExpr) {
+            open("lit");
+            atom("string");
+            text(((TextBlockLiteralExpr) e).asString());
+            close();
+        } else if (e instanceof StringLiteralExpr) {
+            open("lit");
+            atom("string");
+            text(((StringLiteralExpr) e).asString());
+            close();
+        } else if (e instanceof BooleanLiteralExpr) {
+            open("lit");
+            atom("bool");
+            atom(String.valueOf(((BooleanLiteralExpr) e).getValue()));
+            close();
+        } else if (e instanceof NullLiteralExpr) {
+            open("lit");
+            atom("null");
+            close();
+        } else if (e instanceof BinaryExpr && foldedString(e) != null) {
+            open("lit"); // javac's parser folds `"a" + "b"` into one literal
+            atom("string");
+            text(foldedString(e));
+            close();
+        } else if (e instanceof BinaryExpr) {
+            BinaryExpr b = (BinaryExpr) e;
+            open("bin");
+            atom(b.getOperator().asString());
+            expr(b.getLeft());
+            expr(b.getRight());
+            close();
+        } else if (e instanceof UnaryExpr) {
+            UnaryExpr u = (UnaryExpr) e;
+            open("un");
+            atom(u.getOperator().asString() + (u.getOperator().isPostfix() ? "post" : ""));
+            expr(u.getExpression());
+            close();
+        } else if (e instanceof AssignExpr) {
+            AssignExpr a = (AssignExpr) e;
+            open("assign");
+            atom(a.getOperator().asString());
+            expr(a.getTarget());
+            expr(a.getValue());
+            close();
+        } else if (e instanceof ConditionalExpr) {
+            ConditionalExpr c = (ConditionalExpr) e;
+            open("cond");
+            expr(c.getCondition());
+            expr(c.getThenExpr());
+            expr(c.getElseExpr());
+            close();
+        } else if (e instanceof EnclosedExpr) {
+            open("paren");
+            expr(((EnclosedExpr) e).getInner());
+            close();
+        } else if (e instanceof CastExpr) {
+            open("cast");
+            type(((CastExpr) e).getType());
+            expr(((CastExpr) e).getExpression());
+            close();
+        } else if (e instanceof InstanceOfExpr) {
+            InstanceOfExpr i = (InstanceOfExpr) e;
+            open("instanceof");
+            expr(i.getExpression());
+            if (i.getPattern().isPresent()) {
+                expr(i.getPattern().get());
+            } else {
+                type(i.getType());
+            }
+            close();
+        } else if (e instanceof TypePatternExpr) {
+            TypePatternExpr p = (TypePatternExpr) e;
+            open("typepat");
+            modifiers(p.getModifiers(), new NodeList<>());
+            type(p.getType());
+            atom(p.getNameAsString());
+            close();
+        } else if (e instanceof RecordPatternExpr) {
+            RecordPatternExpr p = (RecordPatternExpr) e;
+            open("recpat");
+            type(p.getType());
+            for (Expression sub : p.getPatternList()) {
+                expr(sub);
+            }
+            close();
+        } else if (e instanceof MatchAllPatternExpr) {
+            open("anypat");
+            close();
+        } else if (e instanceof MethodCallExpr) {
+            MethodCallExpr m = (MethodCallExpr) e;
+            open("call");
+            atom(m.getNameAsString());
+            open("scope");
+            m.getScope().ifPresent(this::expr);
+            close();
+            typeArgs(m.getTypeArguments());
+            args(m.getArguments());
+            close();
+        } else if (e instanceof ThisExpr) {
+            open("this");
+            ((ThisExpr) e).getTypeName().ifPresent(this::name);
+            close();
+        } else if (e instanceof SuperExpr) {
+            open("super");
+            ((SuperExpr) e).getTypeName().ifPresent(this::name);
+            close();
+        } else if (e instanceof ClassExpr) {
+            open("classlit");
+            type(((ClassExpr) e).getType());
+            close();
+        } else if (e instanceof ObjectCreationExpr) {
+            ObjectCreationExpr o = (ObjectCreationExpr) e;
+            open("new");
+            open("outer");
+            o.getScope().ifPresent(this::expr);
+            close();
+            typeArgs(o.getTypeArguments());
+            type(o.getType());
+            args(o.getArguments());
+            if (o.getAnonymousClassBody().isPresent()) {
+                members(o.getAnonymousClassBody().get(), false);
+            }
+            close();
+        } else if (e instanceof ArrayCreationExpr) {
+            ArrayCreationExpr a = (ArrayCreationExpr) e;
+            open("newarray");
+            type(a.getElementType());
+            atom(String.valueOf(a.getLevels().size()));
+            open("dims");
+            for (ArrayCreationLevel l : a.getLevels()) {
+                l.getDimension().ifPresent(this::expr);
+            }
+            close();
+            a.getInitializer().ifPresent(this::expr);
+            close();
+        } else if (e instanceof ArrayInitializerExpr) {
+            open("arrayinit");
+            for (Expression v : ((ArrayInitializerExpr) e).getValues()) {
+                expr(v);
+            }
+            close();
+        } else if (e instanceof ArrayAccessExpr) {
+            open("index");
+            expr(((ArrayAccessExpr) e).getName());
+            expr(((ArrayAccessExpr) e).getIndex());
+            close();
+        } else if (e instanceof LambdaExpr) {
+            LambdaExpr l = (LambdaExpr) e;
+            open("lambda");
+            open("params");
+            for (Parameter p : l.getParameters()) {
+                open("param");
+                modifiers(p.getModifiers(), p.getAnnotations());
+                String t = p.getType() instanceof VarType || p.getType().isUnknownType() ? "?" : squash(p.getType().asString()) + (p.isVarArgs() ? "[]" : "");
+                atom(t);
+                atom(p.getNameAsString());
+                close();
+            }
+            close();
+            if (l.getExpressionBody().isPresent()) {
+                expr(l.getExpressionBody().get());
+            } else {
+                stmt(l.getBody());
+            }
+            close();
+        } else if (e instanceof MethodReferenceExpr) {
+            MethodReferenceExpr m = (MethodReferenceExpr) e;
+            open("mref");
+            atom(m.getIdentifier());
+            Expression scope = m.getScope();
+            if (scope instanceof TypeExpr) {
+                Type t = ((TypeExpr) scope).getType();
+                String text = typeText(t);
+                if (t instanceof ClassOrInterfaceType && !text.contains("<") && !text.contains("@") || t instanceof VarType) {
+                    nameText(text); // javac reads `var::m` as a name
+                } else {
+                    open("type");
+                    type(t);
+                    close();
+                }
+            } else {
+                expr(scope);
+            }
+            typeArgs(m.getTypeArguments());
+            close();
+        } else if (e instanceof SwitchExpr) {
+            open("switchexpr");
+            expr(((SwitchExpr) e).getSelector());
+            for (SwitchEntry en : ((SwitchExpr) e).getEntries()) {
+                switchEntry(en);
+            }
+            close();
+        } else if (e instanceof AnnotationExpr) {
+            annotation((AnnotationExpr) e);
+        } else if (e instanceof VariableDeclarationExpr) {
+            locals((VariableDeclarationExpr) e);
+        } else if (e instanceof TypeExpr) {
+            open("type");
+            type(((TypeExpr) e).getType());
+            close();
+        } else if (e instanceof PatternExpr) {
+            open("?" + e.getClass().getSimpleName());
+            close();
+        } else {
+            open("?" + e.getClass().getSimpleName());
+            close();
+        }
+    }
+
+    /** Every node of a tree, for the position checks. */
+    /** The value of a `+` chain of plain string literals (which javac's parser folds; text blocks it leaves), else null. */
+    static String foldedString(Expression e) {
+        if (e instanceof StringLiteralExpr) {
+            return ((StringLiteralExpr) e).asString();
+        }
+        if (e instanceof BinaryExpr && ((BinaryExpr) e).getOperator() == BinaryExpr.Operator.PLUS) {
+            String l = foldedString(((BinaryExpr) e).getLeft());
+            Expression r = ((BinaryExpr) e).getRight();
+            if (l != null && r instanceof StringLiteralExpr) {
+                return l + foldedString(r);
+            }
+        }
+        return null;
+    }
+
+    static List<Node> all(Node root) {
+        List<Node> out = new ArrayList<>();
+        root.walk(out::add);
+        return out;
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..1fea939
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,114 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', '\u23ce'));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
