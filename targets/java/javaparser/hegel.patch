+    /**
+     * candidate/java/javaparser-1: whether JavaParser rejected a method reference whose scope is a variable named `var`
+     * (`var::m`, which javac accepts: `var` is a legal variable name) with `"var" is not allowed here` at that `var`.
+     */
+    static boolean candidateVarMethodReference(Readers.Jp jp, String text) {
+        java.util.regex.Matcher m = java.util.regex.Pattern.compile("\\(line (\\d+),col (\\d+)\\) \"var\" is not allowed here").matcher(String.join(" | ", jp.problems));
+        String[] lines = text.split("\r\n|\r|\n", -1);
+        while (m.find()) {
+            int line = Integer.parseInt(m.group(1));
+            int col = Integer.parseInt(m.group(2));
+            if (line >= 1 && line <= lines.length && col >= 1 && col <= lines[line - 1].length()) {
+                String rest = String.join("\n", java.util.Arrays.asList(lines).subList(line - 1, lines.length)).substring(col - 1);
+                if (rest.matches("(?s)var(\\s|/\\*.*?\\*/|//[^\\n]*\\n)*::.*")) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
