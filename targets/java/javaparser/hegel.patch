new file mode 100644
index 0000000..a3bb0bc
--- /dev/null
+++ b/hegel/src/test/java/zoo/Readers.java
@@ -0,0 +1,126 @@
+package zoo;
+
+import com.github.javaparser.JavaParser;
+import com.github.javaparser.ParseResult;
+import com.github.javaparser.ParserConfiguration;
+import com.github.javaparser.ParserConfiguration.LanguageLevel;
+import com.github.javaparser.Problem;
+import com.github.javaparser.ast.CompilationUnit;
+import com.sun.source.tree.CompilationUnitTree;
+import com.sun.source.util.JavacTask;
+import java.io.IOException;
+import java.net.URI;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import javax.tools.Diagnostic;
+import javax.tools.DiagnosticCollector;
+import javax.tools.JavaCompiler;
+import javax.tools.JavaFileObject;
+import javax.tools.SimpleJavaFileObject;
+import javax.tools.StandardJavaFileManager;
+import javax.tools.ToolProvider;
+
+/** The two readers: JavaParser (the target) and javac's own parser (the oracle), both at Java 21. */
+final class Readers {
+
+    static final String RELEASE = "21";
+
+    static ParserConfiguration config(boolean comments) {
+        return new ParserConfiguration().setLanguageLevel(LanguageLevel.JAVA_21).setAttributeComments(comments).setLexicalPreservationEnabled(false);
+    }
+
+    /** What JavaParser made of a text. */
+    static final class Jp {
+        final CompilationUnit cu;
+        final List<String> problems;
+        final Throwable crash;
+
+        Jp(CompilationUnit cu, List<String> problems, Throwable crash) {
+            this.cu = cu;
+            this.problems = problems;
+            this.crash = crash;
+        }
+
+        boolean ok() {
+            return cu != null && problems.isEmpty() && crash == null;
+        }
+
+        @Override
+        public String toString() {
+            if (crash != null) {
+                return "crash " + crash.getClass().getName() + ": " + EngineText.firstLine(crash.getMessage());
+            }
+            return ok() ? "ok" : problems.size() + " problem(s): " + EngineText.firstLine(String.join(" | ", problems));
+        }
+    }
+
+    static Jp javaparser(String text, boolean comments) {
+        try {
+            ParseResult<CompilationUnit> r = new JavaParser(config(comments)).parse(text);
+            List<String> problems = new ArrayList<>();
+            for (Problem p : r.getProblems()) {
+                problems.add(p.getVerboseMessage());
+            }
+            return new Jp(r.getResult().orElse(null), problems, null);
+        } catch (RuntimeException | StackOverflowError e) {
+            return new Jp(null, List.of(), e);
+        }
+    }
+
+    /** What javac's parser made of a text. */
+    static final class Jc {
+        final CompilationUnitTree cu;
+        final JavacTask task;
+        final List<String> errors;
+        final Throwable crash;
+
+        Jc(CompilationUnitTree cu, JavacTask task, List<String> errors, Throwable crash) {
+            this.cu = cu;
+            this.task = task;
+            this.errors = errors;
+            this.crash = crash;
+        }
+
+        boolean ok() {
+            return cu != null && errors.isEmpty() && crash == null;
+        }
+
+        @Override
+        public String toString() {
+            if (crash != null) {
+                return "crash " + crash.getClass().getName() + ": " + EngineText.firstLine(crash.getMessage());
+            }
+            return ok() ? "ok" : errors.size() + " error(s): " + EngineText.firstLine(String.join(" | ", errors));
+        }
+    }
+
+    static final JavaCompiler COMPILER = ToolProvider.getSystemJavaCompiler();
+    static final StandardJavaFileManager FILES = COMPILER.getStandardFileManager(null, Locale.ROOT, null);
+
+    static Jc javac(String text) {
+        DiagnosticCollector<JavaFileObject> diags = new DiagnosticCollector<>();
+        JavaFileObject file = new SimpleJavaFileObject(URI.create("string:///Gen.java"), JavaFileObject.Kind.SOURCE) {
+            @Override
+            public CharSequence getCharContent(boolean ignoreEncodingErrors) {
+                return text;
+            }
+        };
+        try {
+            JavacTask task = (JavacTask) COMPILER.getTask(null, FILES, diags, List.of("-proc:none", "--release", RELEASE, "-Xlint:none", "-XDshould-stop.at=PARSE"), null, List.of(file));
+            CompilationUnitTree cu = null;
+            for (CompilationUnitTree u : task.parse()) {
+                cu = u;
+            }
+            List<String> errors = new ArrayList<>();
+            for (Diagnostic<? extends JavaFileObject> d : diags.getDiagnostics()) {
+                if (d.getKind() == Diagnostic.Kind.ERROR) {
+                    errors.add(d.getLineNumber() + ":" + d.getColumnNumber() + " " + d.getMessage(Locale.ROOT));
+                }
+            }
+            return new Jc(cu, task, errors, null);
+        } catch (IOException | RuntimeException | StackOverflowError e) {
+            return new Jc(null, null, List.of(), e);
+        }
+    }
+}
