+        String s = tb.asString();
+        check(s.equals("x\ny\n"), () -> "asString() is " + Zoo.show(s) + ", expected \"x\\ny\\n\"");
+        String printed = tb.toString();
+        check(!printed.contains("\n    \n"), () -> "the printer turned the form feed into a line break: " + Zoo.show(printed));
+    }
+
+    /** bug nestedUnaryPrinting: `- -x` must not print as `--x`. */
+    @Test
+    void pin_nestedUnaryPrinting() {
+        CompilationUnit cu = parse("class A { int a = - -x; int b = + +x; }");
+        for (VariableDeclarator vd : cu.findAll(VariableDeclarator.class)) {
+            Expression init = vd.getInitializer().get();
