+        /** `try` with catches and perhaps a finally (70%), or with resources and then catches, a finally, or both. */
+        Generator<String> tryStmt(SCtx ctx) {
+            Generator<String> resource = weighted(
+                w(1, tuples(NAME, opt(30, NAME.map(n -> "." + n))).map(t -> t.value1() + t.value2())),
+                w(1, tuples(pick("var", "final var"), NAME, bx(1)).map(t -> t.value1() + SP + t.value2() + OSP + "=" + OSP + t.value3())),
+                w(1, tuples(classType, NAME, bx(1)).map(t -> t.value1() + SP + t.value2() + OSP + "=" + OSP + t.value3())));
+            Generator<String> resources = tuples(many(resource, 1, 2), opt(20, ";")).map(t -> OSP + "(" + joined(t.value1(), ";" + OSP) + t.value2() + ")");
+            Generator<String> catchClause = tuples(opt(20, "final" + SP), classType, opt(30, classType.map(t -> OSP + "|" + OSP + t)), NAME, bblock(ctx))
+                .map(t -> SP + "catch" + OSP + "(" + t.value1() + t.value2() + t.value3() + SP + t.value4() + ")" + SP + t.value5());
+            Generator<String> finallyClause = bblock(ctx).map(x -> SP + "finally" + SP + x);
+            Generator<String> catches = tuples(many(catchClause, 1, 2), opt(30, finallyClause)).map(t -> joined(t.value1(), "") + t.value2());
+            return weighted(
+                w(7, tuples(bblock(ctx), catches).map(t -> "try" + SP + t.value1() + t.value2())),
+                w(3, tuples(resources, bblock(ctx), weighted(w(1, finallyClause), w(2, catches))).map(t -> "try" + t.value1() + SP + t.value2() + t.value3())));
+        }
+
+        /** A switch statement: colon or arrow form, over constants or patterns. */
+        Generator<String> switchStmt(SCtx ctx) {
+            return weighted(w(35, switchStmt(ctx, false, false)), w(15, switchStmt(ctx, false, true)), w(35, switchStmt(ctx, true, false)), w(15, switchStmt(ctx, true, true)));
+        }
+
+        Generator<String> switchStmt(SCtx ctx, boolean arrows, boolean patterns) {
+            Generator<String> arrowBody = weighted(
+                w(1, stmtExpr.map(s -> SP + "->" + SP + s + ";")),
+                w(1, bblock(ctx).map(x -> SP + "->" + SP + x)),
+                w(1, bx(0).map(e -> SP + "->" + SP + "throw" + SP + e + ";")));
+            Generator<String> colonBody = tuples(many(bstmt(ctx.withDecl()), 0, 2), chance(50)).map(t -> {
+                StringBuilder sb = new StringBuilder(":" + NL);
+                for (String s : t.value1()) {
+                    sb.append(s).append(NL);
+                }
+                return sb.append(t.value2() ? "break;" : "").toString();
+            });
+            Generator<Tuple2<Label, String>> entry = tuples(label(patterns), arrows ? arrowBody : colonBody);
+            return tuples(bx(0), many(entry, 0, 3)).map(t -> {
+                StringBuilder sb = new StringBuilder("switch" + OSP + "(" + OSP + t.value1() + OSP + ")" + SP + "{" + NL);
+                boolean hadDefault = false;
+                for (Tuple2<Label, String> e : t.value2()) {
+                    sb.append(e.value1().render(hadDefault)).append(e.value2()).append(NL);
+                    hadDefault |= e.value1().isDefault(hadDefault);
+                }
+                return sb.append("}").toString();
+            });
+        }
