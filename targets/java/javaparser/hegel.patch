+    /** The declaration first, then zero to `more` random top-level types. */
+    static Generator<List<String>> withMore(Generator<String> first, int more) {
+        return tuples(first, many(N.typeDeclTop, 0, more)).map(t -> {
+            List<String> out = new ArrayList<>();
+            out.add(t.value1());
+            out.addAll(t.value2());
+            return out;
+        });
+    }
