+/**
+ * JavaParser's AST as a canonical S-expression, in the vocabulary {@link JavacShape} also produces from javac's tree:
+ * declarations, statements and expressions by kind and operator, types and names as whitespace-free text, literals
+ * by their decoded value, one entry per declared variable, modifiers as a sorted keyword set.
+ */
+final class Shape {
+
+    private final StringBuilder sb = new StringBuilder();
+
+    static String of(CompilationUnit cu) {
+        Shape s = new Shape();
+        s.compilationUnit(cu);
+        return s.sb.toString();
+    }
+
+    static String ofExpression(Expression e) {
+        Shape s = new Shape();
+        s.expr(e);
+        return s.sb.toString();
+    }
+
+    static String ofStatement(Statement st) {
+        Shape s = new Shape();
+        s.stmt(st);
+        return s.sb.toString();
+    }
+
+    private void open(String tag) {
+        sb.append('(').append(tag);
+    }
+
+    private void close() {
+        sb.append(')');
+    }
+
+    private void atom(String s) {
+        sb.append(' ').append(s);
+    }
+
+    private void text(String s) {
+        sb.append(" \"").append(s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r")).append('"');
+    }
+
+    // ---- compilation unit -----------------------------------------------------------------------
+
+    void compilationUnit(CompilationUnit cu) {
+        open("cu");
+        Optional<PackageDeclaration> pkg = cu.getPackageDeclaration();
+        if (pkg.isPresent()) {
+            open("pkg");
+            name(pkg.get().getName());
+            close();
+        }
+        for (ImportDeclaration imp : cu.getImports()) {
+            open("import");
+            if (imp.isStatic()) {
+                atom("static");
+            }
+            name(imp.getName());
+            if (imp.isAsterisk()) {
+                atom("*");
+            }
+            close();
+        }
+        for (TypeDeclaration<?> t : cu.getTypes()) {
+            typeDecl(t);
+        }
+        close();
+    }
+
+    /** A (possibly qualified) name as nested field accesses, as javac has it. */
+    void name(Name n) {
+        if (n.getQualifier().isPresent()) {
+            open("field");
+            name(n.getQualifier().get());
+            atom(n.getIdentifier());
+            close();
+        } else {
+            open("name");
+            atom(n.getIdentifier());
+            close();
+        }
+    }
+
+    void nameText(String qualified) {
+        int dot = qualified.lastIndexOf('.');
+        if (dot >= 0) {
+            open("field");
+            nameText(qualified.substring(0, dot));
+            atom(qualified.substring(dot + 1));
+            close();
+        } else {
+            open("name");
+            atom(qualified);
+            close();
+        }
+    }
+
+    // ---- declarations ---------------------------------------------------------------------------
+
+    void modifiers(NodeList<Modifier> mods, NodeList<AnnotationExpr> anns) {
+        TreeSet<String> set = new TreeSet<>();
+        for (Modifier m : mods) {
+            set.add(m.getKeyword().asString());
+        }
+        open("mods");
+        for (String s : set) {
+            atom(s);
+        }
+        close();
+        open("anns");
+        for (AnnotationExpr a : anns) {
+            annotation(a);
+        }
+        close();
+    }
+
+    void annotation(AnnotationExpr a) {
+        open("ann");
+        name(a.getName());
