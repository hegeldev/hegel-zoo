+    /** One edit of the text: delete a character (0), insert a token (1), replace a character by a token's first (2), delete a span (3); positions modulo the live length. */
+    record Edit(int kind, int at, String token, int span) {
+        String apply(String s) {
+            StringBuilder sb = new StringBuilder(s);
+            int len = sb.length();
+            switch (kind) {
+                case 0 -> {
+                    if (len > 0) {
+                        sb.deleteCharAt(Math.floorMod(at, len));
+                    }
+                }
+                case 1 -> sb.insert(Math.floorMod(at, len + 1), token);
+                case 2 -> {
+                    if (len > 0) {
+                        sb.setCharAt(Math.floorMod(at, len), token.charAt(0));
+                    }
+                }
+                default -> {
+                    int from = Math.floorMod(at, len + 1);
+                    sb.delete(from, Math.min(len, from + span));
+                }
+            }
+            return sb.toString();
+        }
+    }
