+                    // `a ? b : c = d` is not Java (JLS 15.25, 15.26): javac assigns to the conditional, JavaParser
+                    // assigns inside its third operand, so the trees differ where javac's assigns to an expression
+                    boolean notJava = !a.equals(b) && assignsToAnExpression(jc.cu);
+                    // bug 23: a method reference on a primary after an operator takes the left side for its scope
+                    // (`x * this::m` as `(x * this)::m`); judged by default, tolerated under HEGEL_NO_KNOWN
+                    boolean afterOperatorScope = !a.equals(b) && methodReferenceAfterOperator(jc.cu);
+                    check(a.equals(b) || escapedName || notJava || Zoo.NO_KNOWN && afterOperatorScope, () -> "mutated program: tree differs from javac's"
+                            + (afterOperatorScope ? " (javaparser/23: a method reference on a primary after an operator takes the whole left side as its scope)" : "") + ":" + diff(a, b) + describe(mutated));
+                }
+            }
+            if (jp.cu != null) {
+                try {
+                    jp.cu.toString();
+                    jp.cu.clone();
+                } catch (RuntimeException | StackOverflowError e) {
+                    Zoo.fail("toString()/clone() of a partially parsed program crashes: " + e.getClass().getName() + ": " + firstLine(e.getMessage()) + describe(mutated));
+                }
+            }
+        }, Zoo.settings("mutationsNeverCrash"));
+    }
