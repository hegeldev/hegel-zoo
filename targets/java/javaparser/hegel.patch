+                if (!k.getClassBody().isEmpty()) {
+                    members(k.getClassBody(), false);
+                }
+                close();
+            }
+            for (BodyDeclaration<?> m : e.getMembers()) {
+                member(m, false);
+            }
+            close();
+            close();
+        } else if (t instanceof RecordDeclaration) {
+            RecordDeclaration r = (RecordDeclaration) t;
+            open("record");
+            atom(r.getNameAsString());
+            modifiers(r.getModifiers(), r.getAnnotations());
+            typeParameters(r.getTypeParameters());
+            open("implements");
+            for (ClassOrInterfaceType x : r.getImplementedTypes()) {
+                type(x);
+            }
+            close();
+            open("members");
+            for (Parameter p : r.getParameters()) {
+                open("component");
+                open("anns");
+                for (AnnotationExpr a : p.getAnnotations()) {
+                    annotation(a);
+                }
+                close();
+                atom(typeText(p.getType()) + (p.isVarArgs() ? "[]" : ""));
+                atom(p.getNameAsString());
+                close();
+            }
+            for (BodyDeclaration<?> m : r.getMembers()) {
+                member(m, false);
+            }
+            close();
+            close();
+        } else if (t instanceof AnnotationDeclaration) {
+            AnnotationDeclaration a = (AnnotationDeclaration) t;
+            open("annotationtype");
+            atom(a.getNameAsString());
+            modifiers(a.getModifiers(), a.getAnnotations());
+            members(a.getMembers(), true);
+            close();
+        } else {
+            open("?" + t.getClass().getSimpleName());
+            close();
+        }
+    }
+
+    void typeParameters(NodeList<TypeParameter> tps) {
+        open("tps");
+        for (TypeParameter tp : tps) {
+            open("tp");
+            atom(tp.getNameAsString());
+            open("anns");
+            for (AnnotationExpr a : tp.getAnnotations()) {
+                annotation(a);
+            }
+            close();
+            for (ClassOrInterfaceType b : tp.getTypeBound()) {
+                type(b);
+            }
+            close();
+        }
+        close();
+    }
+
+    void members(NodeList<BodyDeclaration<?>> ms, boolean annotationType) {
+        open("members");
+        for (BodyDeclaration<?> m : ms) {
+            member(m, annotationType);
+        }
+        close();
+    }
+
+    void member(BodyDeclaration<?> m, boolean annotationType) {
+        if (m instanceof FieldDeclaration) {
+            FieldDeclaration f = (FieldDeclaration) m;
+            for (VariableDeclarator v : f.getVariables()) {
+                open("field");
+                modifiers(f.getModifiers(), f.getAnnotations());
+                type(v.getType());
+                atom(v.getNameAsString());
+                if (v.getInitializer().isPresent()) {
+                    expr(v.getInitializer().get());
+                }
+                close();
+            }
+        } else if (m instanceof MethodDeclaration) {
+            MethodDeclaration d = (MethodDeclaration) m;
+            open("method");
+            atom(d.getNameAsString());
+            modifiers(d.getModifiers(), d.getAnnotations());
+            typeParameters(d.getTypeParameters());
+            type(d.getType());
+            parameters(d.getParameters(), d.getReceiverParameter());
+            throwsList(d.getThrownExceptions());
+            if (d.getBody().isPresent()) {
+                stmt(d.getBody().get());
+            }
+            close();
+        } else if (m instanceof ConstructorDeclaration) {
+            ConstructorDeclaration d = (ConstructorDeclaration) m;
+            open("ctor");
+            modifiers(d.getModifiers(), d.getAnnotations());
+            typeParameters(d.getTypeParameters());
+            parameters(d.getParameters(), d.getReceiverParameter());
+            throwsList(d.getThrownExceptions());
+            stmt(d.getBody());
+            close();
+        } else if (m instanceof CompactConstructorDeclaration) {
+            CompactConstructorDeclaration d = (CompactConstructorDeclaration) m;
+            open("compactctor");
+            modifiers(d.getModifiers(), d.getAnnotations());
+            typeParameters(d.getTypeParameters());
+            throwsList(d.getThrownExceptions());
+            stmt(d.getBody());
+            close();
+        } else if (m instanceof InitializerDeclaration) {
+            InitializerDeclaration d = (InitializerDeclaration) m;
+            open("init");
+            if (d.isStatic()) {
+                atom("static");
+            }
+            stmt(d.getBody());
+            close();
+        } else if (m instanceof AnnotationMemberDeclaration) {
+            AnnotationMemberDeclaration d = (AnnotationMemberDeclaration) m;
+            open("annmember");
+            atom(d.getNameAsString());
+            modifiers(d.getModifiers(), d.getAnnotations());
+            type(d.getType());
+            if (d.getDefaultValue().isPresent()) {
+                open("default");
+                expr(d.getDefaultValue().get());
+                close();
+            }
+            close();
+        } else if (m instanceof TypeDeclaration) {
+            typeDecl((TypeDeclaration<?>) m);
+        } else {
+            open("?" + m.getClass().getSimpleName());
+            close();
+        }
+    }
+
+    void parameters(NodeList<Parameter> ps, Optional<ReceiverParameter> receiver) {
+        open("params");
+        if (receiver.isPresent()) {
+            open("receiver");
+            type(receiver.get().getType());
+            atom(receiver.get().getName().asString());
+            close();
+        }
+        for (Parameter p : ps) {
+            parameter(p);
+        }
+        close();
+    }
+
+    void parameter(Parameter p) {
+        open("param");
+        modifiers(p.getModifiers(), p.getAnnotations());
+        atom(typeText(p.getType()) + (p.isVarArgs() ? "[]" : ""));
+        atom(p.getNameAsString());
+        close();
+    }
+
+    void throwsList(NodeList<? extends Type> ts) {
+        open("throws");
+        for (Type t : ts) {
+            type(t);
+        }
+        close();
+    }
+
+    static final com.github.javaparser.printer.configuration.PrinterConfiguration NO_COMMENTS = new com.github.javaparser.printer.configuration.DefaultPrinterConfiguration()
+            .removeOption(new com.github.javaparser.printer.configuration.DefaultConfigurationOption(com.github.javaparser.printer.configuration.DefaultPrinterConfiguration.ConfigOption.PRINT_COMMENTS));
+
+    /** A type as text, annotations included, white space removed. */
+    static String typeText(Type t) {
+        return t instanceof VarType ? "var" : squash(t.toString(NO_COMMENTS));
+    }
+
+    void type(Type t) {
+        atom(typeText(t));
+    }
+
+    // ---- statements -----------------------------------------------------------------------------
+
+    void stmts(NodeList<Statement> list) {
+        for (Statement s : list) {
+            stmt(s);
+        }
+    }
+
+    void stmt(Statement s) {
