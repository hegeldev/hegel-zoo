+        w("}");
+        inSwitchExpr--;
+    }
+
+    // ---- literals -------------------------------------------------------------------------------
+
+    void literal() {
+        int start = out.length();
+        int r = n(tc, 1, 12);
+        if (r <= 3) {
+            intLiteral();
+        } else if (r == 4) {
+            longLiteral();
+        } else if (r == 5) {
+            floatLiteral();
+        } else if (r == 6) {
+            doubleLiteral();
+        } else if (r == 7) {
+            charLiteral();
+        } else if (r <= 9) {
+            stringLiteral();
+        } else if (r == 10) {
+            textBlock();
+        } else if (r == 11) {
+            w(chance(tc, 50) ? "true" : "false");
+        } else {
+            w("null");
+        }
+        literalTexts.add(out.substring(start));
+    }
+
+    static String underscore(TestCase tc, String digits) {
+        if (digits.length() < 3 || !chance(tc, 25)) {
+            return digits;
+        }
+        int at = n(tc, 1, digits.length() - 1);
+        return digits.substring(0, at) + (chance(tc, 30) ? "__" : "_") + digits.substring(at);
+    }
+
+    void intLiteral() {
+        int r = n(tc, 1, 10);
+        if (r <= 5) {
+            w(underscore(tc, String.valueOf(pick(tc, 0, 1, 7, 10, 42, 255, 1000, 65535, 123456789, 2147483647, n(tc, 0, 99999)))));
