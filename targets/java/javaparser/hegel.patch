+                    parent.getRange().ifPresent(pr -> check(pr.contains(range),
+                            () -> "range " + range + " of " + node.getClass().getSimpleName() + " outside its parent's " + pr + " (" + parent.getClass().getSimpleName() + ")" + describe(text)));
+                }
