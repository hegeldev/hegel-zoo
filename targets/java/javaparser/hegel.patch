+        w(1, tuples(N.classMethodHead(), METHOD_NAME, VAR_QUALIFIED_TYPE, NAME, N.bblock(SCtx.FRESH)).map(t -> t.value1() + "void" + SP + t.value2() + OSP + "(" + t.value3() + SP + t.value4() + ")" + SP + t.value5())),
+        w(1, tuples(N.classMethodHead(), METHOD_NAME, N.parameters(false), VAR_QUALIFIED_TYPE, N.bblock(SCtx.FRESH)).map(t -> t.value1() + "void" + SP + t.value2() + OSP + t.value3() + SP + "throws" + SP + t.value4() + SP + t.value5())),
+        w(1, tuples(modifiers("static", "final"), DECL_NAME, VAR_QUALIFIED_TYPE, N.classBody(Body.CLASS, null)).map(t -> t.value1().text() + "class" + SP + t.value2() + SP + "extends" + SP + t.value3() + SP + t.value4().replace(CTOR, t.value2()))),
+        w(1, tuples(modifiers("private", "static"), SIMPLE_TYPE_NAME, VAR_QUALIFIED_TYPE, NAME).map(t -> t.value1().text() + t.value2() + "<" + t.value3() + ">" + SP + t.value4() + ";")));
+    static final Generator<Program> VAR_QUALIFIED_TYPE_REGION = programWith(VAR_QUALIFIED_SITE);
+
+    /** javaparser/22: an `instanceof` with a pattern followed by a relational operator or a second `instanceof` (the first one parenthesised under HEGEL_NO_KNOWN). */
+    static final Generator<String> RELATIONAL_AFTER_INSTANCEOF = tuples(N.bx(10), ANY_PATTERN, weighted(
+            w(3, tuples(pick("<", ">", "<=", ">="), N.bx(10)).map(t -> t.value1() + OSP + t.value2())),
+            w(1, N.refOrPrimArray.map(t -> "instanceof" + SP + t))))
+        .map(t -> {
+            String test = t.value1() + SP + "instanceof" + SP + t.value2();
+            return shape(test, "(" + test + ")") + SP + t.value3();
+        });
+    static final Generator<Program> RELATIONAL_AFTER_INSTANCEOF_REGION = programWith(weighted(
+        w(1, initializedWith(RELATIONAL_AFTER_INSTANCEOF)),
+        w(1, methodWith(tuples(RELATIONAL_AFTER_INSTANCEOF, N.bblock(SCtx.FRESH)).map(t -> "if" + OSP + "(" + OSP + t.value1() + OSP + ")" + SP + t.value2())))));
+}
