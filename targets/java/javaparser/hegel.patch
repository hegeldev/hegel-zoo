+            open("enum");
+            atom(e.getNameAsString());
+            modifiers(e.getModifiers(), e.getAnnotations());
+            open("implements");
+            for (ClassOrInterfaceType x : e.getImplementedTypes()) {
+                type(x);
+            }
+            close();
+            open("members");
+            for (EnumConstantDeclaration k : e.getEntries()) {
+                open("enumconst");
+                atom(k.getNameAsString());
+                open("anns");
+                for (AnnotationExpr a : k.getAnnotations()) {
