+<?xml version="1.0" encoding="UTF-8"?>
+<!-- Hegel property tests for JavaParser, added by the Hegel zoo (targets/java/javaparser). Runs against the
+     com.github.javaparser:javaparser-core artifact that `[run] setup` installs from this checkout into the local Maven repository. -->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <groupId>dev.hegel.zoo</groupId>
+  <artifactId>javaparser-hegel</artifactId>
+  <version>0</version>
+  <packaging>jar</packaging>
+
+  <properties>
+    <maven.compiler.source>22</maven.compiler.source>
+    <maven.compiler.target>22</maven.compiler.target>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <javaparser.version>3.29.0-SNAPSHOT</javaparser.version>
+    <hegel.version>0.6.0</hegel.version>
+    <junit.version>5.11.4</junit.version>
+  </properties>
+
+  <dependencies>
+    <dependency>
+      <groupId>com.github.javaparser</groupId>
+      <artifactId>javaparser-core</artifactId>
+      <version>${javaparser.version}</version>
+    </dependency>
+    <dependency>
+      <groupId>dev.hegel</groupId>
+      <artifactId>hegel</artifactId>
+      <version>${hegel.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <version>${junit.version}</version>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.platform</groupId>
+      <artifactId>junit-platform-launcher</artifactId>
+      <version>1.11.4</version>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+
+  <build>
+    <plugins>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-compiler-plugin</artifactId>
+        <version>3.13.0</version>
+        <configuration>
+          <compilerArgs>
+            <arg>--add-exports</arg>
+            <arg>jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
+            <arg>--add-exports</arg>
+            <arg>jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
+          </compilerArgs>
+        </configuration>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
+        <configuration>
+          <argLine>--enable-native-access=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED -XX:-OmitStackTraceInFastThrow -Xmx1g -Xss4m</argLine>
+          <testFailureIgnore>true</testFailureIgnore>
+          <trimStackTrace>false</trimStackTrace>
+        </configuration>
+      </plugin>
+    </plugins>
+  </build>
+</project>
diff --git a/hegel/src/test/java/zoo/EngineText.java b/hegel/src/test/java/zoo/EngineText.java
new file mode 100644
index 0000000..56ca788
--- /dev/null
+++ b/hegel/src/test/java/zoo/EngineText.java
@@ -0,0 +1,59 @@
+package zoo;
+
+/** Text helpers shared by the tests. */
+final class EngineText {
+
+    static String firstLine(String s) {
+        if (s == null) {
+            return "null";
+        }
+        int i = s.indexOf('\n');
+        String l = i < 0 ? s : s.substring(0, i);
+        return l.length() > 300 ? l.substring(0, 300) + "…" : l;
+    }
+
+    /** The text, indented and with invisible characters made visible, for messages. */
+    static String describe(String text) {
+        StringBuilder sb = new StringBuilder("\n    ");
+        String shown = text.length() > 12000 ? text.substring(0, 12000) + "…" : text;
+        for (int i = 0; i < shown.length(); i++) {
+            char c = shown.charAt(i);
+            if (c == '\n') {
+                sb.append("\n    ");
+            } else if (c == '\t') {
+                sb.append("\\t");
+            } else if (c == '\r') {
+                sb.append("\\r");
+            } else if (c == '\f') {
+                sb.append("\\f");
+            } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff)) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.append('\n').toString();
+    }
+
+    /** Whitespace removed (types are compared as text). */
+    static String squash(String s) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (!Character.isWhitespace(c)) {
+                sb.append(c);
+            }
+        }
+        return sb.toString();
+    }
+
+    /** The first differing position of two shapes, with context, for messages. */
+    static String diff(String a, String b) {
+        int i = 0;
+        while (i < a.length() && i < b.length() && a.charAt(i) == b.charAt(i)) {
+            i++;
+        }
+        int from = Math.max(0, i - 80);
+        return "\n    javaparser: …" + a.substring(from, Math.min(a.length(), i + 160)) + "\n    javac:      …" + b.substring(from, Math.min(b.length(), i + 160));
+    }
+}
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..2a778f3
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,135 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+import static dev.hegel.Generators.tuples;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The combinators the binding lacks: weighted choice, a biased coin, an optional with a probability, int ranges,
+ * bounded lists, words over an alphabet, and the concatenation of any number of text generators.
+ */
+final class Gen {
+    private Gen() {}
+
+    /** A weighted alternative for {@link #weighted}; the generator may produce a subtype of the choice's type. */
+    record Choice<T>(int weight, Generator<? extends T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<? extends T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** A constant alternative. */
+    static <T> Choice<T> v(int weight, T value) {
+        return new Choice<>(weight, just(value));
+    }
+
+    /** All the generators, in order, as one list (a tuple of any arity). */
+    static <T> Generator<List<T>> all(List<Generator<T>> gens) {
+        Generator<List<T>> acc = just(List.of());
+        for (Generator<T> g : gens) {
+            acc = tuples(acc, g).map(t -> {
+                List<T> out = new ArrayList<>(t.value1());
+                out.add(t.value2());
+                return out;
+            });
+        }
+        return acc;
+    }
+
+    /** The texts, in order, concatenated. */
+    @SafeVarargs
+    static Generator<String> seq(Generator<String>... parts) {
+        return all(List.of(parts)).map(xs -> String.join("", xs));
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    static <T> Generator<T> weighted(List<Choice<T>> cs) {
+        int total = 0;
+        for (Choice<T> c : cs) {
+            total += c.weight();
+        }
+        return ints(0, total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : cs) {
+                acc += c.weight();
+                if (i < acc) {
+                    return widen(c.gen());
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** A generator of a subtype is a generator of the supertype: it only ever produces values. */
+    @SuppressWarnings("unchecked")
+    static <T> Generator<T> widen(Generator<? extends T> g) {
+        return (Generator<T>) g;
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return ints(0, 99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<? extends T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** The empty string, or {@code present} with probability pct/100. */
+    static Generator<String> opt(int pct, String present) {
+        return maybe(pct, "", just(present));
+    }
+
+    /** The empty string, or a value of {@code present} with probability pct/100. */
+    static Generator<String> opt(int pct, Generator<String> present) {
+        return maybe(pct, "", present);
+    }
+
+    /** One of the values, equally likely; shrinks to the first. */
+    @SafeVarargs
+    static <T> Generator<T> pick(T... xs) {
+        return sampledFrom(xs);
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** A position, taken modulo the live size where it is used. */
+    static final Generator<Integer> INDEX = ints(0, 999);
+
+    /** lo..hi values of the generator. */
+    static <T> Generator<List<T>> many(Generator<T> g, int lo, int hi) {
+        return lists(g).minSize(lo).maxSize(hi);
+    }
+
+    /** One character of the alphabet, as a string. */
+    static Generator<String> chars(String alphabet) {
+        List<String> cs = new ArrayList<>();
+        alphabet.codePoints().forEach(cp -> cs.add(new String(Character.toChars(cp))));
+        return sampledFrom(cs);
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        return many(chars(alphabet), lo, hi).map(parts -> String.join("", parts));
+    }
+
+    /** The element of the list at a drawn position, modulo its size (the list must not be empty). */
+    static <T> T at(List<T> xs, int index) {
+        return xs.get(Math.floorMod(index, xs.size()));
+    }
+}
diff --git a/hegel/src/test/java/zoo/JavaGen.java b/hegel/src/test/java/zoo/JavaGen.java
new file mode 100644
index 0000000..046e912
--- /dev/null
+++ b/hegel/src/test/java/zoo/JavaGen.java
@@ -0,0 +1,1631 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.INDEX;
+import static zoo.Gen.at;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.many;
+import static zoo.Gen.maybe;
+import static zoo.Gen.opt;
+import static zoo.Gen.pick;
+import static zoo.Gen.seq;
+import static zoo.Gen.v;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+
+import dev.hegel.Generator;
+import dev.hegel.Tuple2;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.function.IntFunction;
+
+/**
+ * A generator of syntactically valid Java 21 compilation units: every construct is drawn from the JLS grammar
+ * (declarations, statements, the full expression precedence ladder, literals in every spelling, patterns, switch
+ * expressions, records, sealed types, lambdas, method references, text blocks, comments and white-space variety).
+ * Only syntax matters: names need not resolve and types need not exist, since both readers (JavaParser and javac's
+ * parser) are used for parsing only. javac is the arbiter of what is valid; a program it rejects is a fault of this
+ * generator, not of JavaParser.
+ *
+ * <p>The generators are values. Every syntactic category is a field of a depth level ({@link Lvl}); a level's
+ * generators draw their children from the level below, so nesting is bounded by the number of levels and no depth
+ * counter is threaded through the draws. The text is built with marks in it - a mandatory separator, an optional
+ * separator, a line break, the enclosing type's name, a lambda parameter's {@code var}, and the feature flags the
+ * properties ask about - which {@link #render} resolves at the end from a drawn {@link Trivia} tape, so that the
+ * comments and odd white space are one record applied by a pure function and the plainest tape renders the plain
+ * program. The first alternative of every choice is the plainest, so a shrunk program is small.
+ *
+ * <p>The shapes of the recorded bugs (bugs.toml) are drawn like any other: cast lambdas and method references as
+ * operands (bugs 1, 17; a method reference on a primary as the right operand, whose scope JavaParser takes to be the
+ * whole left side, is 23), {@code var} lambda parameters under a variable initializer (2), local enums (3), {@code \s}
+ * and Unicode-escaped backslash escapes (4-6), text blocks with white space after the opening delimiter or a form feed
+ * (7, 8), {@code - -x} (9), {@code int m()[]} (10), a {@code var} package qualifier (21), a relational operator after
+ * an {@code instanceof} pattern (22); the properties fail on them and are the expected failures, beside the pins.
+ * Under {@code HEGEL_NO_KNOWN=1} ({@link Zoo#NO_KNOWN}) every such shape is switched off - the generator draws the
+ * neighbouring shape JavaParser handles - and {@link #PRINTABLE_PROGRAM} and {@link #LEXICAL_PROGRAM} differ from
+ * {@link #PROGRAM} (no unary sign applied to a unary sign, no method dimensions); by default they are the same
+ * generator. The {@code *_REGION} generators at the end draw one bug's shape each, with random contents around it,
+ * for the narrow properties.
+ */
+final class JavaGen {
+    private JavaGen() {}
+
+    // ---- marks resolved by render() -------------------------------------------------------------
+
+    /** Mandatory separation between two tokens (at least one space). */
+    static final String SP = "\001";
+    /** Optional separation (where no token boundary needs it). */
+    static final String OSP = "\002";
+    /** A line break. */
+    static final String NL = "\003";
+    /** A lambda parameter's {@code var}: rendered as {@code Object} under a variable initializer (bug 2). */
+    static final String VAR = "\004";
+    /** The enclosing type's name, for constructors; the type declaration's renderer replaces it. */
+    static final String CTOR = "\005";
+    /** Feature marks, collected into {@link Program#features}: `- -x`, `int x[]`, `int m()[]`. */
+    static final String F_NESTED = "\006";
+    static final String F_LEGACY = "\007";
+    static final String F_METHOD = "\016";
+
+    /** A program and the shapes the properties need to know about: "nestedUnary", "legacyDims", "methodDims". */
+    record Program(String text, Set<String> features) {
+        @Override
+        public String toString() {
+            return text;
+        }
+    }
+
+    /** The known bug's shape by default, the plain neighbouring one under HEGEL_NO_KNOWN. */
+    static <T> T shape(T known, T plain) {
+        return Zoo.NO_KNOWN ? plain : known;
+    }
+
+    /** A lambda's `var` parameter marks under a variable initializer: kept (bug 2's shape) by default, `Object` under HEGEL_NO_KNOWN. */
+    static String typedVar(String s) {
+        return Zoo.NO_KNOWN ? s.replace(VAR, "Object") : s;
+    }
+
+    // ---- depth levels ---------------------------------------------------------------------------
+
+    /** The top level: a compilation unit's type declarations. */
+    static final int TOP = 12;
+    /** Expressions at or below this level are a name, a literal or `this`. */
+    static final int EXPR_LEAF = 4;
+    /** Blocks at or below this level are empty; statements at or below STMT_SIMPLE are the five simplest forms. */
+    static final int BLOCK_EMPTY = 1;
+    static final int STMT_SIMPLE = 2;
+    /** Nested member types, local types, anonymous bodies, type arguments, record patterns and nested array initializers need this many levels left. */
+    static final int NESTED_TYPES = 10;
+    static final int LOCAL_TYPES = 8;
+    static final int ANON_BODIES = 9;
+    static final int TYPE_ARGS = 9;
+    static final int NESTED_PATTERNS = 8;
+    static final int NESTED_INITS = 8;
+
+    // ---- names ----------------------------------------------------------------------------------
+
+    static final String[] NAMES = {"a", "b", "c", "x", "y", "z", "foo", "bar", "baz", "value", "count", "item", "list", "map", "result", "tmp",
+        "i", "j", "k", "n", "s", "t", "record", "sealed", "permits", "when", "module", "open", "to", "with", "transitive", "exports", "non", "var",
+        "_x", "$y", "\u00e9t\u00e9", "\u65e5\u672c", "aB1", "__", "x1", "y2", "\u03b1", "\u00fcber", "strictfp_", "enum_", "assert_"};
+    static final String[] TYPE_NAMES = {"Foo", "Bar", "Baz", "String", "Object", "Integer", "List", "Map", "Runnable", "Comparable",
+        "T", "U", "E", "Point", "Shape", "Circle", "Node", "Outer", "Inner", "java.util.List", "java.lang.String", "Map.Entry", "Outer.Inner", "\u00c9cole"};
+    static final String[] PRIMITIVES = {"int", "long", "short", "byte", "char", "boolean", "float", "double"};
+
+    static final Generator<String> NAME = pick(NAMES);
+    /** A lambda parameter's name: `var` is not allowed there. */
+    static final Generator<String> LAMBDA_NAME = NAME.map(s -> s.equals("var") ? "v" : s);
+    /** A record component's name: none that a method of the body may bear, since an accessor must return the component's type (JLS 8.10.3, which JavaParser checks). */
+    static final Generator<String> COMPONENT_NAME = NAME.map(s -> switch (s) {
+        case "record", "sealed", "permits", "when", "with" -> s + "_";
+        default -> s;
+    });
+    static final Generator<String> TYPE_NAME = pick(TYPE_NAMES);
+    /** A type name without a qualifier. */
+    static final Generator<String> SIMPLE_TYPE_NAME = TYPE_NAME.map(s -> s.replace(".", ""));
+    /** The name of a declared type. */
+    static final Generator<String> DECL_NAME = pick("Foo", "Bar", "Baz", "Point", "Shape", "Circle", "Outer", "Inner", "Node", "\u00c9cole", "A", "B", "C", "Rec", "Impl", "Sealed_", "Record1");
+    static final Generator<String> METHOD_NAME = pick("m", "run", "get", "set", "compute", "apply", "accept", "toString", "record", "sealed", "when", "permits", "m\u00e9thode", "_m", "$m", "with");
+    static final Generator<String> PRIMITIVE = pick(PRIMITIVES);
+    static final Generator<String> TYPE_VAR = pick("T", "U", "V", "E", "K", "R");
+
+    /** An enum constant's or case constant's name, numbered by its position when the coin says so. */
+    record ConstName(String base, boolean numbered) {
+        String at(int i) {
+            return numbered ? base + i : base;
+        }
+    }
+
+    static final Generator<ConstName> CONST_NAME = tuples(pick("RED", "GREEN", "BLUE", "A", "B", "C", "ONE", "TWO", "\u00c9"), chance(30)).map(t -> new ConstName(t.value1(), t.value2()));
+
+    /** `a.b.C` with zero to three dots (one time in five written ` . `). */
+    static final Generator<String> QUALIFIED_NAME = tuples(NAME, many(tuples(maybe(20, ".", just(" . ")), weighted(w(7, NAME), w(3, SIMPLE_TYPE_NAME))), 0, 3)).map(t -> {
+        StringBuilder sb = new StringBuilder(t.value1());
+        for (Tuple2<String, String> part : t.value2()) {
+            sb.append(part.value1()).append(part.value2());
+        }
+        return sb.toString();
+    });
+
+    // ---- trivia ---------------------------------------------------------------------------------
+
+    static final String[] SPACES = {" ", " ", " ", "  ", "\t", "\n", "\n  ", "\n\t\t", " \n ", "\f", "\n\n\n", " \t "};
+    static final String[] COMMENTS = {"// c", "/* c */", "/** doc */", "/* multi\n line */", "// trailing", "/**/", "/***/", "/* * */", "/** @param x y */",
+        "// \u00e9 \u65e5\u672c", "/* a // b */", "// /* not a block", "/* \"quoted\" */", "//"};
+
+    static final Generator<String> COMMENT = pick(COMMENTS);
+    /** A comment between two tokens, with white space around it (a line comment ends with its line break). */
+    static final Generator<String> COMMENT_SEP = tuples(pick(SPACES), COMMENT, pick(SPACES)).map(t -> t.value1() + t.value2() + (t.value2().startsWith("//") ? "\n" : t.value3()));
+    /** A mandatory separator: a space (70%), odd white space (20%), a comment (10%). */
+    static final Generator<String> SEP = weighted(v(70, " "), w(20, pick(SPACES)), w(10, COMMENT_SEP));
+    /** An optional separator: nothing (62%), a space (30%), a mandatory separator (8%). */
+    static final Generator<String> OSEP = weighted(v(62, ""), v(30, " "), w(8, SEP));
+    /** A line break, one time in seven followed by a comment line. */
+    static final Generator<String> LINE = weighted(v(85, "\n"), w(15, COMMENT.map(c -> "\n" + c + "\n")));
+
+    /** How the marks render: the separators used in turn for the mandatory and the optional slots, and the line breaks. */
+    record Trivia(List<String> seps, List<String> oseps, List<String> lines) {}
+
+    static final Generator<Trivia> TRIVIA = tuples(many(SEP, 1, 8), many(OSEP, 1, 8), many(LINE, 1, 8)).map(t -> new Trivia(t.value1(), t.value2(), t.value3()));
+
+    // ---- literals -------------------------------------------------------------------------------
+
+    static String underscore(String digits, boolean yes, int at, boolean twice) {
+        if (digits.length() < 3 || !yes) {
+            return digits;
+        }
+        int i = 1 + Math.floorMod(at, digits.length() - 1);
+        return digits.substring(0, i) + (twice ? "__" : "_") + digits.substring(i);
+    }
+
+    /** The digits, one time in four with an underscore (or two) inside. */
+    static Generator<String> underscored(Generator<String> digits) {
+        return tuples(digits, chance(25), INDEX, chance(30)).map(t -> underscore(t.value1(), t.value2(), t.value3(), t.value4()));
+    }
+
+    static final Generator<String> DECIMAL_DIGITS = weighted(w(10, pick("0", "1", "7", "10", "42", "255", "1000", "65535", "123456789", "2147483647")), w(1, ints(0, 99999).map(String::valueOf)));
+    static final Generator<String> HEX_DIGITS = weighted(w(8, pick("0", "1F", "ff", "7fffffff", "80000000", "FFFFFFFF", "CAFE", "0a")), w(1, ints(0, 99999).map(Integer::toHexString)));
+
+    static final Generator<String> INT_LITERAL = weighted(
+        w(5, underscored(DECIMAL_DIGITS)),
+        w(2, tuples(pick("0x", "0X"), underscored(HEX_DIGITS)).map(t -> t.value1() + t.value2())),
+        w(1, underscored(pick("0", "7", "17", "777", "17777777777", "37777777777", "012")).map(s -> "0" + s)),
+        w(2, tuples(pick("0b", "0B"), underscored(pick("0", "1", "1010", "11111111", "1" + "0".repeat(31), "1".repeat(32)))).map(t -> t.value1() + t.value2())));
+
+    static final Generator<String> LONG_LITERAL = tuples(weighted(
