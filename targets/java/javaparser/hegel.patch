+            w(varName());
+        } else if (r == 3) {
+            w("this");
+        } else if (r == 4) {
+            w("(").osp();
+            expression(0);
+            osp().w(")");
+        } else if (r == 5) {
+            methodCall();
+        } else if (r == 6) {
+            objectCreation();
+        } else if (r == 7) {
+            stringLiteral();
+        } else if (r == 8) {
+            qualifier(false);
+            w("[").osp();
+            expression(0);
+            osp().w("]");
+        } else {
+            w(typeName().replace(".", "")).w(".").w("this");
+        }
+        depth--;
+    }
+
+    void primary() {
+        depth++;
+        int r = depth > 7 ? 1 : n(tc, 1, 14);
+        if (r <= 3) {
+            simplePrimary();
+        } else if (r <= 5) {
+            methodCall();
+        } else if (r == 6) {
+            w("(").osp();
+            if (chance(tc, 15)) {
+                standaloneFunctional();
+            } else {
+                expression(0);
+            }
+            osp().w(")");
+        } else if (r == 7) {
+            objectCreation();
+        } else if (r == 8) {
+            arrayCreation();
+        } else if (r == 9) {
+            qualifier(false);
+            w("[").osp();
+            expression(0);
+            osp().w("]");
+        } else if (r == 10) {
+            qualifier(true);
+            w(".").osp().w(varName());
+        } else if (r == 11) {
+            simplePrimary();
+        } else if (r == 12) {
+            classLiteral();
+        } else if (r == 13) {
+            switchExpression();
+        } else {
+            thisOrSuper();
+        }
+        depth--;
+    }
+
+    void simplePrimary() {
+        int r = n(tc, 1, 5);
+        if (r <= 2) {
+            literal();
+        } else if (r == 3) {
+            w("this");
+        } else {
+            w(varName());
+        }
+    }
+
+    void classLiteral() {
+        int r = n(tc, 1, 3);
+        if (r == 1) {
+            w(pick(tc, PRIMITIVES));
+            if (chance(tc, 30)) {
+                w("[]");
+            }
+        } else if (r == 2) {
+            w("void");
+        } else {
+            w(typeName());
+            if (chance(tc, 20)) {
+                w("[]");
+            }
+        }
+        w(".").osp().w("class");
+    }
+
+    void thisOrSuper() {
+        int r = n(tc, 1, 5);
+        if (r == 1) {
+            w("this");
+        } else if (r == 2) {
+            w(typeName().replace(".", "")).w(".").w("this");
+        } else if (r == 3) {
+            w("super").w(".").w(varName());
+        } else if (r == 4) {
+            w("super").w(".").w(methodName());
+            arguments();
+        } else {
+            w(typeName().replace(".", "")).w(".").w("super").w(".").w(methodName());
+            arguments();
+        }
+    }
+
+    void methodCall() {
+        int r = n(tc, 1, 5);
+        if (r == 1) {
+            w(methodName());
+        } else if (r == 2) {
+            qualifier(true);
+            w(".").osp();
+            if (chance(tc, 20)) {
+                w("<");
+                referenceType();
+                w(">");
+            }
+            w(methodName());
+        } else if (r == 3) {
+            w(typeName()).w(".").w(methodName());
+        } else if (r == 4) {
+            w("super").w(".").w(methodName());
+        } else {
+            w("this").w(".").w(methodName());
+        }
+        arguments();
+    }
+
+    void arguments() {
+        osp().w("(");
+        int k = n(tc, 0, 3);
+        for (int i = 0; i < k; i++) {
+            if (i > 0) {
+                w(",").osp();
+            }
+            if (chance(tc, 20)) {
+                standaloneFunctional();
+            } else {
+                expression(0);
+            }
+        }
+        osp().w(")");
+    }
+
+    void objectCreation() {
+        boolean qualified = chance(tc, 15);
+        if (qualified) {
+            qualifier(true);
+            w(".");
+        }
+        w("new").sp();
+        if (chance(tc, 10)) {
+            w("<").w(pick(tc, TYPE_NAMES).replace(".", "")).w(">").osp();
+        }
+        if (chance(tc, 10)) {
+            typeAnnotation();
+        }
+        w(qualified ? typeName().replace(".", "") : typeName()); // `a.new Inner()`: the inner type is a simple name
+        if (chance(tc, 30)) {
+            w("<>");
+        } else if (chance(tc, 30)) {
+            w("<");
+            referenceType();
+            w(">");
+        }
+        arguments();
+        if (depth < 4 && chance(tc, 20)) {
+            sp();
+            typeNames.push("");
+            classBody(false, false);
+            typeNames.pop();
+        }
+    }
+
+    void arrayCreation() {
+        w("new").sp();
+        if (chance(tc, 50)) {
+            w(pick(tc, PRIMITIVES));
+        } else {
+            classType();
+        }
+        if (chance(tc, 50)) {
+            int dims = n(tc, 1, 2);
+            for (int i = 0; i < dims; i++) {
+                w("[").osp();
+                expression(0);
+                osp().w("]");
+            }
+            if (chance(tc, 30)) {
+                w("[]");
+            }
+        } else {
+            w("[]");
+            if (chance(tc, 30)) {
+                w("[]");
+            }
+            osp();
+            arrayInitializer();
+        }
+    }
+
+    void methodReference() {
+        int r = n(tc, 1, 6);
+        if (r == 1) {
+            w(typeName());
+        } else if (r == 2) {
+            w(pick(tc, PRIMITIVES)).w("[]");
+        } else if (r == 3) {
+            classType();
+            if (chance(tc, 30)) {
+                w("[]");
+            }
+        } else if (r == 4) {
+            w("this");
+        } else if (r == 5) {
+            w("super");
+        } else {
+            qualifier(true);
+        }
+        osp().w("::").osp();
+        if (chance(tc, 20)) {
+            w("<");
+            referenceType();
+            w(">");
+        }
+        w(chance(tc, 25) && r != 4 && r != 5 && r != 6 ? "new" : methodName());
+    }
+
+    void lambda() {
+        int r = n(tc, 1, 5);
+        if (r == 1) {
+            w(lambdaName());
+        } else {
+            w("(");
+            int k = r == 2 ? 0 : n(tc, 1, 3);
+            boolean typed = chance(tc, 40);
+            boolean useVar = inInitializer == 0 && chance(tc, 20);
+            for (int i = 0; i < k; i++) {
+                if (i > 0) {
+                    w(",").osp();
+                }
+                if (typed) {
+                    if (chance(tc, 20)) {
+                        w("final").sp();
+                    }
+                    if (useVar) {
+                        w("var");
+                    } else {
+                        type(true);
+                        if (i == k - 1 && chance(tc, 15)) {
+                            w("...");
+                        }
+                    }
+                    sp();
+                }
+                w(lambdaName());
+            }
+            w(")");
+        }
+        osp().w("->").osp();
+        if (chance(tc, 50)) {
+            block(false);
+        } else {
+            expression(1);
+        }
+    }
+
+    void assignment() {
+        assignable();
+        osp().w(pick(tc, "=", "=", "=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<=", ">>=", ">>>=")).osp();
+        if (chance(tc, 20)) {
+            standaloneFunctional();
+        } else {
+            expression(0);
+        }
+    }
+
+    void switchExpression() {
+        inSwitchExpr++;
+        w("switch").osp().w("(").osp();
+        expression(0);
+        osp().w(")").sp().w("{").nl();
+        depth++;
+        int k = n(tc, 1, 3);
+        boolean patterns = chance(tc, 40);
+        boolean hadDefault = false;
+        boolean hasResult = false;
+        for (int i = 0; i < k; i++) {
+            hadDefault = caseLabel(patterns, hadDefault);
+            sp().w("->").sp();
+            int r = n(tc, 1, 4);
+            if (i == k - 1 && !hasResult && r == 2) {
+                r = 3; // javac (and JavaParser) reject a switch expression whose rules all throw
+            }
+            if (r != 2) {
+                hasResult = true;
+            }
+            if (r == 1) {
+                w("{").nl();
+                if (chance(tc, 50)) {
+                    statement(true);
+                    nl();
+                }
+                w("yield").sp();
+                expression(0);
+                w(";").nl().w("}");
+            } else if (r == 2) {
+                w("throw").sp();
