+            // but only for the chain at the top of a run of binary operators: term2Rest folds its final result when
+            // that is a `+`, so `"a" + "b"` and `x + "a" + "b"` (-> `x + "ab"`) fold while `"a" + "b" <= x` and
+            // `"a" + "b" instanceof T` keep both literals. Text blocks are string literals to javac and fold too.
+            List<Expression> operands = plusOperands(e);
+            List<Object> merged = new ArrayList<>(); // Expression, or String for a folded run
+            int i = 0;
+            while (i < operands.size()) {
+                int j = i;
+                while (j < operands.size() && isStringLiteral(operands.get(j))) {
+                    j++;
+                }
+                if (j - i >= 2) {
+                    StringBuilder sb = new StringBuilder();
+                    for (int k = i; k < j; k++) {
+                        sb.append(literalValue(operands.get(k)));
+                    }
+                    merged.add(sb.toString());
+                    i = j;
+                } else {
+                    merged.add(operands.get(i));
+                    i++;
+                }
+            }
+            for (int k = 1; k < merged.size(); k++) {
+                open("bin");
+                atom("+");
+            }
+            foldedOperand(merged.get(0));
+            for (int k = 1; k < merged.size(); k++) {
