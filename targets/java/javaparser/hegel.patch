+    // ---- expressions ----------------------------------------------------------------------------
+
+    void args(NodeList<Expression> es) {
+        open("args");
+        for (Expression e : es) {
+            expr(e);
+        }
+        close();
+    }
+
+    void typeArgs(Optional<NodeList<Type>> ts) {
+        open("targs");
+        if (ts.isPresent()) {
+            for (Type t : ts.get()) {
+                type(t);
+            }
+        }
+        close();
+    }
+
+    void expr(Expression e) {
+        if (e instanceof NameExpr) {
+            open("name");
+            atom(((NameExpr) e).getNameAsString());
+            close();
+        } else if (e instanceof FieldAccessExpr) {
+            FieldAccessExpr f = (FieldAccessExpr) e;
+            open("field");
+            expr(f.getScope());
+            atom(f.getNameAsString());
+            close();
+        } else if (e instanceof IntegerLiteralExpr) {
+            open("lit");
+            atom("int");
+            atom(String.valueOf(((IntegerLiteralExpr) e).asNumber()));
+            close();
+        } else if (e instanceof LongLiteralExpr) {
+            open("lit");
+            atom("long");
+            atom(String.valueOf(((LongLiteralExpr) e).asNumber()));
+            close();
+        } else if (e instanceof DoubleLiteralExpr) {
+            DoubleLiteralExpr d = (DoubleLiteralExpr) e;
+            String v = d.getValue();
+            boolean isFloat = v.endsWith("f") || v.endsWith("F");
+            open("lit");
+            atom(isFloat ? "float" : "double");
+            atom(isFloat ? Float.toString((float) d.asDouble()) : Double.toString(d.asDouble()));
+            close();
+        } else if (e instanceof CharLiteralExpr) {
+            open("lit");
+            atom("char");
+            atom(String.valueOf((int) ((CharLiteralExpr) e).asChar()));
+            close();
+        } else if (e instanceof TextBlockLiteralExpr) {
+            open("lit");
+            atom("string");
+            text(((TextBlockLiteralExpr) e).asString());
+            close();
+        } else if (e instanceof StringLiteralExpr) {
+            open("lit");
+            atom("string");
+            text(((StringLiteralExpr) e).asString());
+            close();
+        } else if (e instanceof BooleanLiteralExpr) {
+            open("lit");
+            atom("bool");
+            atom(String.valueOf(((BooleanLiteralExpr) e).getValue()));
+            close();
+        } else if (e instanceof NullLiteralExpr) {
+            open("lit");
+            atom("null");
+            close();
+        } else if (e instanceof BinaryExpr && isFoldedChain((BinaryExpr) e)) {
