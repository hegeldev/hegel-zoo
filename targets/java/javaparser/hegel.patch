+    }
+
+    void floatLiteral() {
+        w(pick(tc, "1.5", "0.1", "1e10", "1E-5", "3.", ".5", "1.0e+3", "0x1.8p1", "0x1p-2", "0xAp0", "1_0.5", "3.4028235e38", "1.4e-45", "100"));
+        w(chance(tc, 70) ? "f" : "F");
+    }
+
+    void doubleLiteral() {
+        w(pick(tc, "1.5", "0.1", "1e10", "1E-5", "3.", ".5", "1.0e+3", "0x1.8p1", "0x1p-2", "0x.8p1", "0xAp0", "1_0.5", "1.7976931348623157e308", "4.9e-324", "2.", "1e-1"));
+        if (chance(tc, 40)) {
+            w(chance(tc, 70) ? "d" : "D");
+        }
+    }
+
+    static final String[] ESCAPES = {"\\n", "\\t", "\\b", "\\r", "\\f", "\\0", "\\7", "\\77", "\\377", "\\'", "\\\"", "\\\\", "\\u0041", "\\u00e9", "\\uu0041", "\\u65e5", "\\12", "\\1234"}; // no \s and no \u005c: known asString()/lexer bugs (pins carry them)
+    static final String[] PLAIN_CHARS = {"a", "Z", "0", " ", "é", "日", "$", "_", "!", "#", " ", "😀", "", " "};
+
+    void charLiteral() {
+        w("'");
+        if (chance(tc, 40)) {
+            String e = pick(tc, ESCAPES);
+            if (e.equals("\\1234")) {
+                e = "\\123"; // two characters would not be a char literal
+            }
+            if (e.equals("\\u005c\\u005c")) {
+                e = "\\u005c\\u0027"; // \' is the escaped quote \'
+            }
+            w(e);
+        } else {
+            String c = pick(tc, PLAIN_CHARS);
+            if (c.equals("😀") || c.isEmpty()) {
+                c = "a"; // a supplementary character is two chars; an empty char literal is none
+            }
+            w(c);
+        }
+        w("'");
+    }
+
+    void stringLiteral() {
+        w("\"");
+        int k = n(tc, 0, 5);
+        for (int i = 0; i < k; i++) {
+            if (chance(tc, 30)) {
+                w(pick(tc, ESCAPES));
+            } else {
+                w(pick(tc, PLAIN_CHARS));
+            }
+        }
+        w("\"");
+    }
+
+    void textBlock() {
+        w("\"\"\"").w("\n"); // known bug: trailing white space on the opening line breaks asString() (a pin carries it)
+        int lines = n(tc, 0, 3);
+        for (int i = 0; i < lines; i++) {
+            w(pick(tc, "", "  ", "\t", "    "));
+            int k = n(tc, 0, 3);
+            boolean lastQuote = false;
+            for (int j = 0; j < k; j++) {
+                int r = n(tc, 1, 6);
+                if (r == 1) {
+                    w(pick(tc, "\\n", "\\t", "\\\"", "\\\\", "\\u0041", "\\0", "\\\"\\\"\\\"", "\\\n"));
+                    lastQuote = false;
+                } else if (r == 2 && !lastQuote) {
+                    w("\""); // never two quote tokens in a row: three quotes would close the block
+                    lastQuote = true;
+                } else {
+                    String c = pick(tc, PLAIN_CHARS);
+                    w(c.isEmpty() ? "x" : c);
+                    lastQuote = false;
+                }
+            }
+            if (chance(tc, 20)) {
+                w(pick(tc, " ", "\t")); // no form feed: JavaParser treats it as a line terminator (known bug, a pin carries it)
+            }
+            w("\n");
+        }
+        w(pick(tc, "", "  ", "\t")).w("\"\"\"");
+    }
+}
