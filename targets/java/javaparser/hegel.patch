+        /** `{ ... }` with members of the kind; a record body may end with a compact constructor. */
+        Generator<String> classBody(Body kind, Generator<String> tail) {
+            Generator<String> members = many(member(kind), 0, kind == Body.RECORD ? 3 : 4).map(xs -> {
+                StringBuilder sb = new StringBuilder("{" + NL);
+                for (String m : xs) {
+                    sb.append(m).append(NL);
+                }
+                return sb.toString();
+            });
+            return tuples(members, tail == null ? just("") : tail).map(t -> t.value1() + t.value2() + "}");
+        }
