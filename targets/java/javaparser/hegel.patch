+                    Expression e = (Expression) node;
+                    if (e.getParentNode().map(p -> p instanceof com.github.javaparser.ast.expr.MethodReferenceExpr || p instanceof com.github.javaparser.ast.expr.ObjectCreationExpr && ((com.github.javaparser.ast.expr.ObjectCreationExpr) p).getScope().filter(s -> s == e).isPresent()).orElse(false)) {
+                        continue;
+                    }
+                    String src = e.toString();
+                    String shape = Shape.ofExpression(e);
+                    checked++;
+                    ParseResult<Expression> r;
+                    try {
+                        r = parser.parseExpression(src);
+                    } catch (RuntimeException | StackOverflowError ex) {
+                        Zoo.fail("parseExpression crashes: " + ex.getClass().getName() + ": " + firstLine(ex.getMessage()) + describe(src));
+                        continue;
+                    }
+                    check(r.isSuccessful() && r.getResult().isPresent(), () -> "parseExpression rejects a printed " + e.getClass().getSimpleName() + ": " + firstLine(r.getProblems().toString()) + describe(src));
+                    if (r.isSuccessful() && r.getResult().isPresent()) {
+                        String shape2 = Shape.ofExpression(r.getResult().get());
+                        check(shape.equals(shape2), () -> "parseExpression reads a printed " + e.getClass().getSimpleName() + " differently:" + diff(shape, shape2) + describe(src));
+                    }
+                } else if (node instanceof Statement && !(node instanceof com.github.javaparser.ast.stmt.SwitchEntry) && chance(tc, 20)) {
+                    Statement s = (Statement) node;
+                    if (s instanceof com.github.javaparser.ast.stmt.ExplicitConstructorInvocationStmt || s instanceof com.github.javaparser.ast.stmt.YieldStmt
+                            || s.getParentNode().filter(p -> p instanceof com.github.javaparser.ast.stmt.SwitchEntry || p instanceof com.github.javaparser.ast.expr.LambdaExpr).isPresent()) {
+                        continue;
+                    }
+                    String src = s.toString();
+                    String shape = Shape.ofStatement(s);
+                    checked++;
+                    ParseResult<? extends Statement> r;
+                    try {
+                        r = s instanceof com.github.javaparser.ast.stmt.BlockStmt ? parser.parseBlock(src) : parser.parseStatement(src);
+                    } catch (RuntimeException | StackOverflowError ex) {
+                        Zoo.fail("parseStatement crashes: " + ex.getClass().getName() + ": " + firstLine(ex.getMessage()) + describe(src));
+                        continue;
+                    }
+                    check(r.isSuccessful() && r.getResult().isPresent(), () -> "parseStatement rejects a printed " + s.getClass().getSimpleName() + ": " + firstLine(r.getProblems().toString()) + describe(src));
+                    if (r.isSuccessful() && r.getResult().isPresent()) {
+                        String shape2 = Shape.ofStatement(r.getResult().get());
+                        check(shape.equals(shape2), () -> "parseStatement reads a printed " + s.getClass().getSimpleName() + " differently:" + diff(shape, shape2) + describe(src));
+                    }
+                }
+            }
+        }, Zoo.settings("fragmentParsersAgree"));
+    }
+
+    /** clone() is equal with the same hashCode and shape; the clone is detached; equal nodes print the same. */
+    @Test
+    void cloneEqualsLaws() {
+        Hegel.test(tc -> {
+            String text = program(tc);
+            Readers.Jc jc = Readers.javac(text);
+            if (!jc.ok()) {
+                return;
+            }
+            Readers.Jp jp = Readers.javaparser(text, false); // comments: clone() drops those on pattern types (known bug, see below)
+            if (!jp.ok()) {
+                return;
+            }
+            CompilationUnit cu = jp.cu;
+            CompilationUnit copy;
+            try {
+                copy = cu.clone();
+            } catch (RuntimeException | StackOverflowError e) {
+                Zoo.fail("clone() crashes: " + e.getClass().getName() + ": " + firstLine(e.getMessage()) + describe(text));
+                return;
+            }
+            check(cu.equals(copy), () -> "clone() is not equal to the original" + describe(text));
+            check(cu.hashCode() == copy.hashCode(), () -> "clone() has a different hashCode" + describe(text));
+            String a = Shape.of(cu);
+            String b = Shape.of(copy);
+            check(a.equals(b), () -> "clone() has a different shape:" + diff(a, b) + describe(text));
+            String pa = cu.toString();
+            String pb = copy.toString();
+            check(pa.equals(pb), () -> "clone() prints differently:" + diff(pa, pb) + describe(text));
+            // known bug: a parsed TypePatternExpr/RecordPatternExpr does not own its type node, the clone does (a pin carries it)
+            List<Node> nodes = new ArrayList<>();
+            for (Node x : Shape.all(cu)) {
+                if (!underPatternType(x)) {
+                    nodes.add(x);
+                }
+            }
+            List<Node> copies = new ArrayList<>();
+            for (Node y : Shape.all(copy)) {
+                if (!underPatternType(y)) {
+                    copies.add(y);
+                }
+            }
+            check(nodes.size() == copies.size(), () -> "clone() has " + copies.size() + " nodes, the original " + nodes.size() + describe(text));
+            List<String> tagsA = new ArrayList<>();
+            List<String> tagsB = new ArrayList<>();
+            for (Node x : nodes) {
+                tagsA.add(tag(x));
+            }
+            for (Node y : copies) {
+                tagsB.add(tag(y));
+            }
+            java.util.Collections.sort(tagsA);
+            java.util.Collections.sort(tagsB);
+            check(tagsA.equals(tagsB), () -> "clone() has different nodes or ranges: " + firstMismatch(tagsA, tagsB) + describe(text));
+            java.util.Set<Node> originals = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<>());
+            originals.addAll(nodes);
+            for (Node y : copies) {
+                y.getParentNode().ifPresent(p -> check(!originals.contains(p), () -> "a cloned " + y.getClass().getSimpleName() + " has its parent in the original tree" + describe(text)));
+            }
+        }, Zoo.settings("cloneEqualsLaws"));
+    }
+
+    static boolean underPatternType(Node x) {
+        Node n = x;
+        while (n instanceof com.github.javaparser.ast.type.Type || n instanceof SimpleName || n instanceof com.github.javaparser.ast.expr.AnnotationExpr || n instanceof com.github.javaparser.ast.expr.Name) {
+            Node p = n.getParentNode().orElse(null);
+            if (p instanceof com.github.javaparser.ast.expr.TypePatternExpr || p instanceof com.github.javaparser.ast.expr.RecordPatternExpr) {
+                return true;
+            }
+            n = p;
+        }
+        return false;
+    }
+
+    static String tag(Node x) {
+        return x.getClass().getSimpleName() + "@" + x.getRange().map(Object::toString).orElse("-") + "<" + x.getParentNode().map(p -> p.getClass().getSimpleName()).orElse("-") + "> "
+                + Zoo.show(firstLine(x.toString(NO_COMMENTS)));
+    }
+
+    static String firstMismatch(List<String> a, List<String> b) {
+        List<String> onlyA = new ArrayList<>(a);
+        List<String> onlyB = new ArrayList<>(b);
+        for (String x : a) {
+            onlyB.remove(x);
+        }
+        for (String x : b) {
+            onlyA.remove(x);
+        }
+        return "only in the original: " + onlyA.subList(0, Math.min(4, onlyA.size())) + "; only in the clone: " + onlyB.subList(0, Math.min(4, onlyB.size()));
+    }
+}
