+        /** `(...)` formal parameters; the first may be a receiver parameter. */
+        Generator<String> parameters(boolean allowReceiver) {
+            Generator<Param> param = tuples(chance(20), opt(15, annotations(1, 1)), typeA, chance(20), NAME, chance(10))
+                .map(t -> new Param(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+            return tuples(allowReceiver ? opt(5, classType.map(t -> t + SP + "this")) : just(""), many(param, 0, 3)).map(t -> {
+                List<String> out = new ArrayList<>();
+                List<Param> ps = t.value2();
+                for (int i = 0; i < ps.size(); i++) {
+                    out.add(i == 0 && !t.value1().isEmpty() ? t.value1() : ps.get(i).text(i == ps.size() - 1));
+                }
+                return "(" + joined(out, "," + OSP) + OSP + ")";
+            });
+        }
