+            atom(a.getOperator().asString());
+            expr(a.getTarget());
+            expr(a.getValue());
+            close();
+        } else if (e instanceof ConditionalExpr) {
+            ConditionalExpr c = (ConditionalExpr) e;
+            open("cond");
+            expr(c.getCondition());
+            expr(c.getThenExpr());
+            expr(c.getElseExpr());
+            close();
+        } else if (e instanceof EnclosedExpr) {
