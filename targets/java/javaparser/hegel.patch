+            typeParameters(c.getTypeParameters());
+            open("extends");
+            for (ClassOrInterfaceType x : c.getExtendedTypes()) {
+                type(x);
+            }
+            close();
+            open("implements");
+            for (ClassOrInterfaceType x : c.getImplementedTypes()) {
+                type(x);
+            }
+            close();
+            open("permits");
+            for (ClassOrInterfaceType x : c.getPermittedTypes()) {
+                type(x);
+            }
+            close();
+            members(c.getMembers(), false);
+            close();
