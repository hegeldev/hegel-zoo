+
+    static boolean hasLoneSurrogate(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
+                    i++;
+                } else {
+                    return true;
+                }
+            } else if (Character.isLowSurrogate(c)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean allScalarsAreStrings(List<JsonElement> docs) {
+        for (JsonElement d : docs) {
+            if (!stringsOnly(d)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static boolean stringsOnly(JsonElement e) {
+        if (e.isJsonNull()) {
+            return false; // a null scalar would be the string "null" under failsafe
+        }
+        if (e.isJsonPrimitive()) {
+            return e.getAsJsonPrimitive().isString();
+        }
+        if (e.isJsonArray()) {
+            for (JsonElement c : e.getAsJsonArray()) {
+                if (!stringsOnly(c)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (e.getAsJsonObject().has("$m")) {
+            for (JsonElement pair : e.getAsJsonObject().getAsJsonArray("$m")) {
+                if (!stringsOnly(pair.getAsJsonArray().get(0)) || !stringsOnly(pair.getAsJsonArray().get(1))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        return false; // $n, $f, $b, $set
+    }
+
+    // ---- 2. mutated documents fail like YAML processors do -------------------------------------
+
+    static final String[] MUTATION_CHARS = {" ", " ", "\n", "\n", "\t", "-", ":", "?", ",", "[", "]", "{", "}", "#", "&", "*", "!", "|", ">", "'", "\"", "%", "@", "`", "\\", "a", "0", ".", "~", "---", "...", "  ", ": ", "- ", "&a ", "*a", "!!str ", "!!int ", "!!float ", "!!bool ", "!!null ", "!!binary ", "!!seq ", "!!map ", "!!set ", "!<tag:yaml.org,2002:str> ", "!foo ", "\r", "%YAML 1.2\n---\n", "%TAG ! tag:x,2000:\n---\n", "\ufeff", "<<: ", "+", "e", "E", "0x", "0o", ".inf", ".nan", "\\x41", "\\u00", "\\L"};
+
+    /** An edit of the text; positions are taken modulo the live size when applied. */
+    sealed interface Edit permits Delete, Insert, Replace, Reindent, Swap {}
+
+    record Delete(int at) implements Edit {}
+
+    record Insert(int at, String what) implements Edit {}
+
+    record Replace(int at, String what) implements Edit {}
+
+    /** Re-indent one line to {@code spaces} spaces. */
+    record Reindent(int line, int spaces) implements Edit {}
+
+    /** Swap a line with the next. */
+    record Swap(int line) implements Edit {}
+
+    static final Generator<Integer> POSITION = ints(0, 4095);
+
+    /** An edit: a deletion (20%), an insertion (40%) or replacement (20%) of a mutation string, a re-indented line (10%), two swapped lines (10%). */
+    static final Generator<Edit> EDIT = weighted(
+        w(20, POSITION.map(Delete::new)),
+        w(40, tuples(POSITION, pick(MUTATION_CHARS)).map(t -> new Insert(t.value1(), t.value2()))),
+        w(20, tuples(POSITION, pick(MUTATION_CHARS)).map(t -> new Replace(t.value1(), t.value2()))),
+        w(10, tuples(POSITION, ints(0, 6)).map(t -> new Reindent(t.value1(), t.value2()))),
+        w(10, POSITION.map(Swap::new)));
+
+    /** The text after the edits, applied in turn while there is text left; a position is taken modulo the size of what it edits. */
+    static String mutate(String text, List<Edit> edits) {
+        StringBuilder sb = new StringBuilder(text);
+        for (Edit e : edits) {
+            if (sb.length() == 0) {
+                break;
+            }
+            switch (e) {
+                case Delete d -> {
+                    int at = d.at() % (sb.length() + 1);
+                    if (at < sb.length()) {
+                        sb.deleteCharAt(at);
+                    }
+                }
+                case Insert i -> sb.insert(i.at() % (sb.length() + 1), i.what());
+                case Replace r -> {
+                    int at = r.at() % (sb.length() + 1);
+                    if (at < sb.length()) {
+                        sb.replace(at, at + 1, r.what());
+                    }
+                }
+                case Reindent r -> {
+                    List<String> lines = new ArrayList<>(Arrays.asList(sb.toString().split("\n", -1)));
+                    int li = r.line() % lines.size();
+                    lines.set(li, " ".repeat(r.spaces()) + lines.get(li).replaceFirst("^ +", ""));
+                    sb = new StringBuilder(String.join("\n", lines));
+                }
+                case Swap s -> {
+                    List<String> lines = new ArrayList<>(Arrays.asList(sb.toString().split("\n", -1)));
+                    if (lines.size() >= 2) {
+                        int li = s.line() % (lines.size() - 1);
+                        String a = lines.get(li);
+                        lines.set(li, lines.get(li + 1));
+                        lines.set(li + 1, a);
+                        sb = new StringBuilder(String.join("\n", lines));
+                    }
+                }
+            }
+        }
+        return sb.toString();
+    }
+
