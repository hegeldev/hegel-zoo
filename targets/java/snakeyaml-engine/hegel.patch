+            if (!hasLoneSurrogate(text)) { // a lone surrogate has no UTF-8 encoding: the bytes carry "?" instead
+                check(stream.ok() == mine.ok() && (!mine.ok() || stream.docs.equals(mine.docs)), () -> "loadAllFromInputStream gives " + stream + " but loadAllFromString " + mine + " for " + tag);
+            }
+            // composing succeeds exactly when loading does, except for construction failures
+            String composeError = null;
+            try {
+                for (Node nd : new Compose(s).composeAllFromString(text)) {
+                    // walk
+                }
+            } catch (RuntimeException e) {
+                composeError = e.getClass().getSimpleName() + ": " + firstLine(e.getMessage());
+            }
+            String ce = composeError;
+            if (mine.ok()) {
+                check(ce == null, () -> "loading succeeds but composing throws " + ce + " for " + tag);
+            } else if (!mine.error.startsWith("ConstructorException") && !mine.error.startsWith("DuplicateKeyException") && !mine.error.startsWith("YamlEngineException")) {
+                check(ce != null, () -> "loading throws " + mine.error + " but composing succeeds for " + tag);
