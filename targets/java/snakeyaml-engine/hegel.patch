+            return "the escapes \\L and \\P (snakeyaml-engine/2)";
+        }
+        return null;
+    }
+
+    // ---- 1. written documents load as their trees ----------------------------------------------
+
+    /**
+     * The schema to write for and load with, whether the failsafe schema is tried too (then the stream has every
+     * scalar spelled out: the failsafe schema cannot construct an empty scalar, snakeyaml-engine/7), the stream, and
+     * the second input path to try (1: a Reader, 2: an InputStream).
+     */
+    record WrittenCase(boolean core, boolean failsafe, Doc.Stream stream, int path) {}
+
+    static final Generator<WrittenCase> WRITTEN_CASE = tuples(chance(50), chance(70), pick(1, 2))
+        .flatMap(t -> (t.value2() ? YamlGen.SPELLED_STREAM : YamlGen.STREAM).map(s -> new WrittenCase(t.value1(), t.value2(), s, t.value3())));
