+    record MutationCase(boolean core, Doc.Stream stream, List<Edit> edits) {}
+
+    static final Generator<MutationCase> MUTATION_CASE = tuples(chance(50), YamlGen.STREAM, many(EDIT, 1, 3)).map(t -> new MutationCase(t.value1(), t.value2(), t.value3()));
