+    @Test
+    void mutatedDocumentsFailCleanly() {
+        Hegel.test(tc -> {
+            boolean core = chance(tc, 50);
+            YamlGen g = new YamlGen(tc, core);
+            String text = mutate(tc, g.writeStream(genTrees(g), new ArrayList<>()));
+            String tag = (core ? "core schema" : "json schema") + describe(text);
+            LoadSettings s = settings(core);
+            Loaded mine = loadAll(s, text);
+            if (!mine.ok()) {
+                // every failure is a YamlEngineException (the documented family), never a raw runtime exception
+                boolean explicitTag = text.contains("!!") || text.contains("!<");
+                boolean wrongKindTag = mine.cause.getCause() instanceof ClassCastException && explicitTag; // snakeyaml-engine/8
+                boolean wrongValueTag = (mine.cause.getCause() instanceof IllegalArgumentException || mine.cause.getCause() instanceof IndexOutOfBoundsException) && explicitTag; // snakeyaml-engine/10
+                check(wrongKindTag || wrongValueTag || (mine.cause instanceof YamlEngineException && !(mine.cause.getCause() instanceof NumberFormatException) && !(mine.cause.getCause() instanceof ClassCastException) && !(mine.cause.getCause() instanceof NullPointerException)), () -> "loading threw " + mine.cause.getClass().getName() + ": " + firstLine(mine.cause.getMessage()) + (mine.cause.getCause() != null ? " caused by " + mine.cause.getCause().getClass().getName() : "") + " for " + tag);
