diff --git a/hegel/src/test/java/zoo/Canon.java b/hegel/src/test/java/zoo/Canon.java
new file mode 100644
index 0000000..3ae5373
--- /dev/null
+++ b/hegel/src/test/java/zoo/Canon.java
@@ -0,0 +1,146 @@
+package zoo;
+
+import com.google.gson.JsonArray;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonNull;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonPrimitive;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * One canonical form for values snakeyaml-engine constructs (plain Java objects) and for the
+ * generator's trees, so they can be compared exactly: null, booleans and strings as themselves,
+ * integers of any size as {@code {"$n": digits}}, floats as {@code {"$f": hex bits}} ("nan" for
+ * NaN), binary as {@code {"$b": base64}}, sets as {@code {"$set": [...]}}, mappings as
+ * {@code {"$m": [[k, v], ...]}} with the pairs sorted by the key's text (so equality is unordered),
+ * sequences as arrays. Gson's {@code JsonElement.equals} on the result is the comparison.
+ */
+final class Canon {
+
+    static JsonElement nul() {
+        return JsonNull.INSTANCE;
+    }
+
+    static JsonElement bool(boolean b) {
+        return new JsonPrimitive(b);
+    }
+
+    static JsonElement string(String s) {
+        return new JsonPrimitive(s);
+    }
+
+    static JsonElement integer(BigInteger v) {
+        JsonObject o = new JsonObject();
+        o.addProperty("$n", v.toString());
+        return o;
+    }
+
+    static JsonElement integer(long v) {
+        return integer(BigInteger.valueOf(v));
+    }
+
+    static JsonElement floating(double d) {
+        JsonObject o = new JsonObject();
+        o.addProperty("$f", Double.isNaN(d) ? "nan" : Long.toHexString(Double.doubleToLongBits(d)));
+        return o;
+    }
+
+    static JsonElement binary(byte[] b) {
+        JsonObject o = new JsonObject();
+        o.addProperty("$b", Base64.getEncoder().encodeToString(b));
+        return o;
+    }
+
+    static JsonElement seq(List<JsonElement> items) {
+        JsonArray a = new JsonArray();
+        for (JsonElement n : items) {
+            a.add(n);
+        }
+        return a;
+    }
+
+    static JsonElement set(List<JsonElement> items) {
+        List<JsonElement> sorted = new ArrayList<>(items);
+        sorted.sort((x, y) -> x.toString().compareTo(y.toString()));
+        JsonObject o = new JsonObject();
+        o.add("$set", seq(sorted));
+        return o;
+    }
+
+    /** A mapping from key/value pairs (keys already canonical); duplicate keys keep every pair. */
+    static JsonElement map(List<JsonElement[]> pairs) {
+        List<JsonElement[]> sorted = new ArrayList<>(pairs);
+        sorted.sort((x, y) -> x[0].toString().compareTo(y[0].toString()));
+        JsonArray a = new JsonArray();
+        for (JsonElement[] p : sorted) {
+            JsonArray pair = new JsonArray();
+            pair.add(p[0]);
+            pair.add(p[1]);
+            a.add(pair);
+        }
+        JsonObject o = new JsonObject();
+        o.add("$m", a);
+        return o;
+    }
+
+    /** The canonical form of a value snakeyaml-engine constructed. */
+    static JsonElement ofObject(Object v) {
+        if (v == null) {
+            return nul();
+        }
+        if (v instanceof Boolean) {
+            return bool((Boolean) v);
+        }
+        if (v instanceof BigInteger) {
+            return integer((BigInteger) v);
+        }
+        if (v instanceof Integer || v instanceof Long || v instanceof Short || v instanceof Byte) {
+            return integer(((Number) v).longValue());
+        }
+        if (v instanceof BigDecimal) {
+            return floating(((BigDecimal) v).doubleValue());
+        }
+        if (v instanceof Double || v instanceof Float) {
+            return floating(((Number) v).doubleValue());
+        }
+        if (v instanceof String) {
+            return string((String) v);
+        }
+        if (v instanceof byte[]) {
+            return binary((byte[]) v);
+        }
+        if (v instanceof List) {
+            List<JsonElement> items = new ArrayList<>();
+            for (Object x : (List<?>) v) {
+                items.add(ofObject(x));
+            }
+            return seq(items);
+        }
+        if (v instanceof Set) {
+            List<JsonElement> items = new ArrayList<>();
+            for (Object x : (Set<?>) v) {
+                items.add(ofObject(x));
+            }
+            return set(items);
+        }
+        if (v instanceof Map) {
+            List<JsonElement[]> pairs = new ArrayList<>();
+            for (Map.Entry<?, ?> e : ((Map<?, ?>) v).entrySet()) {
+                pairs.add(new JsonElement[] {ofObject(e.getKey()), ofObject(e.getValue())});
+            }
+            return map(pairs);
+        }
+        throw new IllegalArgumentException("no canonical form for " + v.getClass().getName() + " " + v);
+    }
+
+    static String show(JsonElement n) {
+        String s = String.valueOf(n);
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+}
diff --git a/hegel/src/test/java/zoo/EngineDumpTest.java b/hegel/src/test/java/zoo/EngineDumpTest.java
new file mode 100644
index 0000000..9a0cbd4
--- /dev/null
+++ b/hegel/src/test/java/zoo/EngineDumpTest.java
@@ -0,0 +1,495 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.fail;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import com.google.gson.JsonElement;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Optional;
+import java.util.regex.Pattern;
+import org.junit.jupiter.api.Test;
+import org.snakeyaml.engine.v2.api.Dump;
+import org.snakeyaml.engine.v2.api.DumpSettings;
+import org.snakeyaml.engine.v2.api.DumpSettingsBuilder;
+import org.snakeyaml.engine.v2.api.LoadSettings;
+import org.snakeyaml.engine.v2.api.StreamDataWriter;
+import org.snakeyaml.engine.v2.api.lowlevel.Compose;
+import org.snakeyaml.engine.v2.api.lowlevel.Parse;
+import org.snakeyaml.engine.v2.api.lowlevel.Present;
+import org.snakeyaml.engine.v2.api.lowlevel.Serialize;
+import org.snakeyaml.engine.v2.common.FlowStyle;
+import org.snakeyaml.engine.v2.common.NonPrintableStyle;
+import org.snakeyaml.engine.v2.common.ScalarStyle;
+import org.snakeyaml.engine.v2.common.SpecVersion;
+import org.snakeyaml.engine.v2.common.Anchor;
+import org.snakeyaml.engine.v2.events.CollectionStartEvent;
+import org.snakeyaml.engine.v2.events.Event;
+import org.snakeyaml.engine.v2.events.ScalarEvent;
+import org.snakeyaml.engine.v2.nodes.MappingNode;
+import org.snakeyaml.engine.v2.nodes.Node;
+import org.snakeyaml.engine.v2.nodes.NodeTuple;
+import org.snakeyaml.engine.v2.nodes.ScalarNode;
+import org.snakeyaml.engine.v2.nodes.SequenceNode;
+import org.snakeyaml.engine.v2.schema.CoreSchema;
+import org.snakeyaml.engine.v2.schema.JsonSchema;
+
+/**
+ * snakeyaml-engine's emitter: values dumped under random settings load back as themselves; the
+ * event stream of a parse survives Present → Parse; the node graph of a compose survives
+ * Serialize → Present → Compose.
+ */
+class EngineDumpTest {
+
+    /** Random dump settings, described for the failure messages. */
+    static final class Options {
+        final DumpSettings dump;
+        final boolean core;
+        final List<String> style = new ArrayList<>();
+        final int indent;
+        final int effectiveIndent;
+        final int indicatorIndent;
+        final boolean indentWithIndicator;
+        final int width;
+        final String lineBreak;
+        final boolean binaryNonPrintable;
+        final boolean canonical;
+        final boolean directive;
+        final boolean explicitEnd;
+
+        Options(TestCase tc, boolean allowBadIndicator) {
+            DumpSettingsBuilder b = DumpSettings.builder();
+            core = chance(tc, 50);
+            b.setSchema(core ? new CoreSchema() : new JsonSchema());
+            style.add(core ? "core" : "json");
+            int ind = 2;
+            if (chance(tc, 50)) {
+                ind = pick(tc, 1, 2, 3, 4, 8, 9, 10);
+                b.setIndent(ind);
+                style.add("indent=" + ind);
+            }
+            indent = ind;
+            effectiveIndent = ind > 1 && ind < 10 ? ind : 2; // the emitter ignores 1 and 10 (snakeyaml-engine/9)
+            int ii = 0;
+            boolean iwi = false;
+            if (chance(tc, 40)) {
+                ii = pick(tc, 0, 1, 2, 3, 4);
+                if (ii >= indent && !allowBadIndicator) {
+                    ii = indent - 1;
+                }
+                b.setIndicatorIndent(ii);
+                style.add("indicatorIndent=" + ii);
+                if (chance(tc, 50)) {
+                    iwi = true;
+                    b.setIndentWithIndicator(true);
+                    style.add("indentWithIndicator");
+                }
+            }
+            indicatorIndent = ii;
+            indentWithIndicator = iwi;
+            int w = 80;
+            if (chance(tc, 50)) {
+                w = pick(tc, 1, 5, 10, 20, 40, 80, 200, 1000);
+                b.setWidth(w);
+                style.add("width=" + w);
+            }
+            width = w;
+            String br = "\n";
+            if (chance(tc, 30)) {
+                br = pick(tc, "\r\n", "\r");
+                b.setBestLineBreak(br);
+                style.add(br.equals("\r") ? "MAC" : "WIN");
+            }
+            lineBreak = br;
+            if (chance(tc, 30)) {
+                b.setSplitLines(false);
+                style.add("splitLines=false");
+            }
+            if (chance(tc, 30)) {
+                int k = pick(tc, 1, 8, 128, 1024);
+                b.setMaxSimpleKeyLength(k);
+                style.add("maxSimpleKeyLength=" + k);
+            }
+            binaryNonPrintable = chance(tc, 30);
+            if (binaryNonPrintable) {
+                b.setNonPrintableStyle(NonPrintableStyle.BINARY);
+                style.add("nonPrintable=BINARY");
+            }
+            canonical = chance(tc, 15);
+            if (canonical) {
+                b.setCanonical(true);
+                style.add("canonical");
+            }
+            explicitEnd = chance(tc, 20);
+            if (explicitEnd) {
+                b.setExplicitEnd(true);
+                style.add("explicitEnd");
+            }
+            if (chance(tc, 20)) {
+                b.setExplicitStart(true);
+                style.add("explicitStart");
+            }
+            directive = chance(tc, 15);
+            if (directive) {
+                b.setYamlDirective(Optional.of(new SpecVersion(1, 2)));
+                style.add("%YAML 1.2");
+            }
+            if (chance(tc, 40)) {
+                FlowStyle fs = pick(tc, FlowStyle.FLOW, FlowStyle.BLOCK, FlowStyle.AUTO);
+                b.setDefaultFlowStyle(fs);
+                style.add("flow=" + fs);
+            }
+            if (chance(tc, 40)) {
+                ScalarStyle ss = pick(tc, ScalarStyle.SINGLE_QUOTED, ScalarStyle.DOUBLE_QUOTED, ScalarStyle.LITERAL, ScalarStyle.FOLDED, ScalarStyle.PLAIN, ScalarStyle.JSON_SCALAR_STYLE);
+                b.setDefaultScalarStyle(ss);
+                style.add("scalar=" + ss);
+            }
+            if (chance(tc, 30)) {
+                b.setMultiLineFlow(true);
+                style.add("multiLineFlow");
+            }
+            if (chance(tc, 20)) {
+                b.setUseUnicodeEncoding(false);
+                style.add("noUnicode");
+            }
+            if (chance(tc, 20)) {
+                b.setDumpComments(true);
+                style.add("dumpComments");
+            }
+            dump = b.build();
+        }
+
+        LoadSettings load() {
+            return LoadSettings.builder().setSchema(core ? new CoreSchema() : new JsonSchema()).build();
+        }
+    }
+
+    /** Strings of the tree (values and keys). */
+    static void strings(YamlGen.Tree t, List<String> out) {
+        if (t.kind.equals("string")) {
+            out.add((String) t.value);
+        } else if (t.kind.equals("seq")) {
+            for (YamlGen.Tree c : t.items) {
+                strings(c, out);
+            }
+        } else if (t.kind.equals("map")) {
+            for (java.util.Map.Entry<String, YamlGen.Tree> e : t.entries) {
+                out.add(e.getKey());
+                strings(e.getValue(), out);
+            }
+        }
+    }
+
+    static boolean hasNonPrintable(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            boolean printable = c == '\n' || c == '\t' || c == '\r' || (c >= 0x20 && c <= 0x7e) || c == 0x85 || (c >= 0xa0 && c <= 0xd7ff) || (c >= 0xe000 && c <= 0xfffd && c != 0xfeff) || Character.isSurrogate(c);
+            if (!printable) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Shapes whose loss is a recorded bug (bugs.toml) or a design choice (README): not compared. */
+    static String knownLoss(Options o, List<String> strings) {
+        if (o.binaryNonPrintable && strings.stream().anyMatch(EngineDumpTest::hasNonPrintable)) {
+            return "NonPrintableStyle.BINARY turns a string with non-printable characters into bytes (design)";
+        }
+        if (!o.indentWithIndicator && o.indicatorIndent >= o.effectiveIndent) {
+            return "an indicator indent not smaller than the indent (snakeyaml-engine/5" + (o.effectiveIndent != o.indent ? ", the indent setting being ignored, snakeyaml-engine/9" : "") + ")";
+        }
+        if (o.indicatorIndent > 0 && !o.indentWithIndicator && strings.stream().anyMatch(s -> s.contains("\n") && (s.startsWith(" ") || s.startsWith("\n")))) {
+            return "a block scalar's indentation indicator under an indented sequence indicator (snakeyaml-engine/4)";
+        }
+        if (o.directive) {
+            return "several documents after a %YAML directive (snakeyaml-engine/3) — the single-document case is compared";
+        }
+        return null;
+    }
+
+    /**
+     * The double-quoted split corruption: a line holding nothing but one or two backslashes (snakeyaml-engine/6).
+     * The emitter splits only at spaces, after content, so a correct dump never has such a line.
+     */
+    static final Pattern DOUBLED_CONTINUATION = Pattern.compile("(^|\\r|\\n) *\\\\\\\\?(\\r|\\n)");
+
+    // ---- 1. dumped values load back --------------------------------------------------------------
+
+    @Test
+    void dumpedValuesLoadBack() {
+        Hegel.test(tc -> {
+            Options o = new Options(tc, true);
+            YamlGen g = new YamlGen(tc, o.core);
+            List<YamlGen.Tree> trees = EngineTest.genTrees(g);
+            List<JsonElement> expected = new ArrayList<>();
+            List<Object> values = new ArrayList<>();
+            List<String> strs = new ArrayList<>();
+            for (YamlGen.Tree t : trees) {
+                expected.add(t.canon());
+                values.add(t.java());
+                strings(t, strs);
+            }
+            String text;
+            try {
+                text = trees.size() == 1 ? new Dump(o.dump).dumpToString(values.get(0)) : new Dump(o.dump).dumpAllToString(values.iterator());
+            } catch (RuntimeException e) {
+                fail("dumping threw " + e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + " with " + o.style + " for " + EngineTest.show(expected));
+                return;
+            }
+            String tag = "options " + o.style + ", value " + EngineTest.show(expected) + EngineTest.describe(text);
+            check(text.endsWith(o.lineBreak), () -> "the dump does not end with the line break for " + tag);
+            if (DOUBLED_CONTINUATION.matcher(text).find()) {
+                return; // the double-quoted split corruption (snakeyaml-engine/6), pinned
+            }
+            String known = knownLoss(o, strs);
+            if (known != null && !(known.startsWith("several documents") && trees.size() == 1)) {
+                return;
+            }
+            EngineTest.Loaded back = EngineTest.loadAll(o.load(), text);
+            check(back.ok() && back.docs.equals(expected), () -> "the dump loads back as " + back + " instead of " + EngineTest.show(expected) + " for " + tag);
+            // the failsafe-free path: composing the dump gives one node per document
+            int count = 0;
+            try {
+                for (Node nd : new Compose(o.load()).composeAllFromString(text)) {
+                    count++;
+                }
+            } catch (RuntimeException e) {
+                count = -1;
+            }
+            int c = count;
+            check(c == trees.size(), () -> "composing the dump gives " + c + " nodes for " + tag);
+        }, Zoo.settings("dumpedValuesLoadBack"));
+    }
+
+    // ---- 2. events survive Present → Parse --------------------------------------------------------
+
+    /**
+     * An event's identity up to style: the emitter may quote an implicit plain scalar (and then adds the "!" tag),
+     * choose flow or block for a collection, and write or omit the document markers.
+     */
+    static String eventKey(Event e) {
+        switch (e.getEventId()) {
+            case Scalar: {
+                ScalarEvent s = (ScalarEvent) e;
+                return "=VAL" + anchorKey(s.getAnchor()) + tagKey(s.getTag()) + " " + s.getValue();
+            }
+            case SequenceStart:
+            case MappingStart: {
+                CollectionStartEvent c = (CollectionStartEvent) e;
+                return (e.getEventId() == Event.ID.SequenceStart ? "+SEQ" : "+MAP") + anchorKey(c.getAnchor()) + tagKey(c.getTag());
+            }
+            case DocumentStart:
+                return "+DOC";
+            case DocumentEnd:
+                return "-DOC";
+            default:
+                return e.toString();
+        }
+    }
+
+    static String anchorKey(Optional<Anchor> a) {
+        return a.map(x -> " &" + x.getValue()).orElse("");
+    }
+
+    static String tagKey(Optional<String> t) {
+        return t.filter(x -> !x.equals("!")).map(x -> " <" + x + ">").orElse("");
+    }
+
+    static List<String> keys(Iterable<Event> events) {
+        List<String> out = new ArrayList<>();
+        for (Event e : events) {
+            if (e.getEventId() == Event.ID.Comment) {
+                continue;
+            }
+            out.add(eventKey(e));
+        }
+        return out;
+    }
+
+    static String diffLists(List<String> a, List<String> b) {
+        StringBuilder sb = new StringBuilder();
+        int max = Math.max(a.size(), b.size());
+        int shown = 0;
+        for (int i = 0; i < max && shown < 5; i++) {
+            String x = i < a.size() ? a.get(i) : "<none>", y = i < b.size() ? b.get(i) : "<none>";
+            if (!x.equals(y)) {
+                sb.append("\n    #").append(i).append(": ").append(x).append("\n      -> ").append(y);
+                shown++;
+            }
+        }
+        return sb.toString();
+    }
+
+    @Test
+    void eventsSurvivePresentAndParse() {
+        Hegel.test(tc -> {
+            Options o = new Options(tc, false);
+            YamlGen g = new YamlGen(tc, o.core);
+            List<YamlGen.Tree> trees = EngineTest.genTrees(g);
+            List<String> style = new ArrayList<>();
+            String text = g.writeStream(trees, style);
+            if (EngineTest.knownShape(text) != null) {
+                return;
+            }
+            List<String> strs = new ArrayList<>();
+            for (YamlGen.Tree t : trees) {
+                strings(t, strs);
+            }
+            if (knownLoss(o, strs) != null) {
+                return;
+            }
+            LoadSettings ls = LoadSettings.builder().setSchema(o.core ? new CoreSchema() : new JsonSchema()).build();
+            List<Event> events = new ArrayList<>();
+            for (Event e : new Parse(ls).parseString(text)) {
+                events.add(e);
+            }
+            String presented;
+            try {
+                presented = new Present(o.dump).emitToString(events.iterator());
+            } catch (RuntimeException e) {
+                fail("Present threw " + e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + " with " + o.style + " for style " + style + EngineTest.describe(text));
+                return;
+            }
+            if (DOUBLED_CONTINUATION.matcher(presented).find()) {
+                return; // the double-quoted split corruption (snakeyaml-engine/6), pinned
+            }
+            String tag = "options " + o.style + ", source style " + style + EngineTest.describe(text) + "presented as" + EngineTest.describe(presented);
+            List<String> before = keys(events);
+            List<String> after;
+            try {
+                after = keys(new Parse(ls).parseString(presented));
+            } catch (RuntimeException e) {
+                fail("parsing the presented text threw " + e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + " for " + tag);
+                return;
+            }
+            check(before.equals(after), () -> "the events changed:" + diffLists(before, after) + "\nfor " + tag);
+            // and the values are the same
+            List<JsonElement> expected = new ArrayList<>();
+            for (YamlGen.Tree t : trees) {
+                expected.add(t.canon());
+            }
+            EngineTest.Loaded back = EngineTest.loadAll(ls, presented);
+            if (String.valueOf(o.style).contains("canonical")) {
+                // parsed events carry no tag; the canonical presentation quotes every scalar and so must write one,
+                // and writes the non-specific "!" (as libyaml does): the plain scalars become strings (README)
+                check(back.ok() && back.docs.size() == expected.size(), () -> "the canonical presentation loads as " + back + " for " + tag);
+                return;
+            }
+            check(back.ok() && back.docs.equals(expected), () -> "the presented text loads as " + back + " instead of " + EngineTest.show(expected) + " for " + tag);
+        }, Zoo.settings("eventsSurvivePresentAndParse"));
+    }
+
+    // ---- 3. nodes survive Serialize → Present → Compose --------------------------------------------
+
+    static String nodeKey(Node n) {
+        StringBuilder sb = new StringBuilder();
+        nodeKey(n, sb);
+        return sb.toString();
+    }
+
+    static void nodeKey(Node n, StringBuilder sb) {
+        if (n instanceof ScalarNode) {
+            ScalarNode s = (ScalarNode) n;
+            sb.append("S(").append(s.getTag()).append(':').append(s.getValue()).append(')');
+        } else if (n instanceof SequenceNode) {
+            sb.append("[").append(n.getTag());
+            for (Node c : ((SequenceNode) n).getValue()) {
+                sb.append(' ');
+                nodeKey(c, sb);
+            }
+            sb.append(']');
+        } else if (n instanceof MappingNode) {
+            sb.append("{").append(n.getTag());
+            for (NodeTuple t : ((MappingNode) n).getValue()) {
+                sb.append(' ');
+                nodeKey(t.getKeyNode(), sb);
+                sb.append('=');
+                nodeKey(t.getValueNode(), sb);
+            }
+            sb.append('}');
+        } else {
+            sb.append(n);
+        }
+    }
+
+    @Test
+    void nodesSurviveSerializeAndCompose() {
+        Hegel.test(tc -> {
+            Options o = new Options(tc, false);
+            YamlGen g = new YamlGen(tc, o.core);
+            List<YamlGen.Tree> trees = EngineTest.genTrees(g);
+            List<String> style = new ArrayList<>();
+            String text = g.writeStream(trees, style);
+            if (EngineTest.knownShape(text) != null) {
+                return;
+            }
+            List<String> strs = new ArrayList<>();
+            for (YamlGen.Tree t : trees) {
+                strings(t, strs);
+            }
+            if (knownLoss(o, strs) != null) {
+                return;
+            }
+            LoadSettings ls = LoadSettings.builder().setSchema(o.core ? new CoreSchema() : new JsonSchema()).build();
+            List<Node> nodes = new ArrayList<>();
+            for (Node nd : new Compose(ls).composeAllFromString(text)) {
+                nodes.add(nd);
+            }
+            List<String> before = new ArrayList<>();
+            for (Node nd : nodes) {
+                before.add(nodeKey(nd));
+            }
+            String presented;
+            try {
+                List<Event> events = new Serialize(o.dump).serializeAll(nodes);
+                presented = new Present(o.dump).emitToString(events.iterator());
+            } catch (RuntimeException e) {
+                fail("serializing threw " + e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + " with " + o.style + " for style " + style + EngineTest.describe(text));
+                return;
+            }
+            if (DOUBLED_CONTINUATION.matcher(presented).find()) {
+                return; // the double-quoted split corruption (snakeyaml-engine/6), pinned
+            }
+            String tag = "options " + o.style + ", source style " + style + EngineTest.describe(text) + "serialized as" + EngineTest.describe(presented);
+            List<String> after = new ArrayList<>();
+            try {
+                for (Node nd : new Compose(ls).composeAllFromString(presented)) {
+                    after.add(nodeKey(nd));
+                }
+            } catch (RuntimeException e) {
+                fail("composing the serialized text threw " + e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + " for " + tag);
+                return;
+            }
+            check(before.equals(after), () -> "the nodes changed:" + diffLists(before, after) + "\nfor " + tag);
+            // dumpNode agrees with Serialize + Present
+            if (nodes.size() == 1) {
+                StringBuilder sb = new StringBuilder();
+                try {
+                    new Dump(o.dump).dumpNode(nodes.get(0), new StreamDataWriter() {
+                        @Override
+                        public void write(String str) {
+                            sb.append(str);
+                        }
+
+                        @Override
+                        public void write(String str, int off, int len) {
+                            sb.append(str, off, off + len);
+                        }
+                    });
+                } catch (RuntimeException e) {
+                    fail("dumpNode threw " + e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + " for " + tag);
+                    return;
+                }
+                String dumped = sb.toString();
+                check(dumped.equals(presented), () -> "dumpNode gives" + EngineTest.describe(dumped) + "but Serialize + Present" + EngineTest.describe(presented) + "for " + tag);
+            }
+        }, Zoo.settings("nodesSurviveSerializeAndCompose"));
+    }
+}
diff --git a/hegel/src/test/java/zoo/EnginePinsTest.java b/hegel/src/test/java/zoo/EnginePinsTest.java
