+
+/**
+ * snakeyaml-engine's emitter: values dumped under random settings load back as themselves; the
+ * event stream of a parse survives Present \u2192 Parse; the node graph of a compose survives
+ * Serialize \u2192 Present \u2192 Compose.
+ */
+class EngineDumpTest {
+
+    // ---------------------------------------------------------------- dump settings
+
+    /**
+     * How the emitter lays text out: the indent (1 and 10 are ignored by the emitter, snakeyaml-engine/9), the
+     * sequence indicator's indent as drawn (see {@link Options#indicatorIndent()}), whether items are indented
+     * with the indicator, the width, no splitting of long lines, multi-line flow collections, and the default
+     * flow and scalar styles.
+     */
+    record Layout(int indent, int indicatorDraw, boolean indentWithIndicator, int width, boolean noSplitLines, boolean multiLineFlow, FlowStyle flow, ScalarStyle scalar) {}
+
+    /** The schema and the stream framing: canonical output, explicit document markers, a {@code %YAML 1.2} directive, the line break, comments dumped. */
+    record Framing(boolean core, boolean canonical, boolean explicitStart, boolean explicitEnd, boolean directive, String lineBreak, boolean dumpComments) {}
+
+    /** How characters are written: non-printable strings as binary, no Unicode (escaped), the longest simple key. */
+    record Chars(boolean binaryNonPrintable, boolean noUnicode, int maxSimpleKeyLength) {}
+
+    record Options(Layout layout, Framing framing, Chars chars) {
+        boolean core() {
+            return framing.core();
+        }
+
+        /** The indent the emitter uses: 1 and 10 are ignored (snakeyaml-engine/9). */
+        int effectiveIndent() {
+            return layout.indent() > 1 && layout.indent() < 10 ? layout.indent() : 2;
+        }
+
+        /**
+         * The sequence indicator's indent. Without {@code indentWithIndicator} an indicator indent not smaller
+         * than the indent breaks the output (snakeyaml-engine/5, also through the ignored indents of /9), so the
+         * draw is taken modulo the effective indent; with it any value is fine.
+         */
+        int indicatorIndent() {
+            return layout.indentWithIndicator() ? layout.indicatorDraw() : layout.indicatorDraw() % effectiveIndent();
+        }
+
+        DumpSettings build() {
+            DumpSettingsBuilder b = DumpSettings.builder();
+            b.setSchema(core() ? new CoreSchema() : new JsonSchema());
+            b.setIndent(layout.indent());
+            b.setIndicatorIndent(indicatorIndent());
+            b.setIndentWithIndicator(layout.indentWithIndicator());
+            b.setWidth(layout.width());
+            b.setSplitLines(!layout.noSplitLines());
+            b.setMultiLineFlow(layout.multiLineFlow());
+            b.setDefaultFlowStyle(layout.flow());
+            b.setDefaultScalarStyle(layout.scalar());
+            b.setCanonical(framing.canonical());
+            b.setExplicitStart(framing.explicitStart());
+            b.setExplicitEnd(framing.explicitEnd());
+            if (framing.directive()) {
+                b.setYamlDirective(Optional.of(new SpecVersion(1, 2)));
+            }
+            b.setBestLineBreak(framing.lineBreak());
+            b.setDumpComments(framing.dumpComments());
+            if (chars.binaryNonPrintable()) {
+                b.setNonPrintableStyle(NonPrintableStyle.BINARY);
+            }
+            b.setUseUnicodeEncoding(!chars.noUnicode());
+            b.setMaxSimpleKeyLength(chars.maxSimpleKeyLength());
+            return b.build();
+        }
+
+        LoadSettings load() {
+            return EngineTest.settings(core());
+        }
+    }
+
+    static final Generator<Layout> LAYOUT = tuples(
+            pick(2, 2, 1, 3, 4, 8, 9, 10), pick(0, 0, 0, 1, 2, 3, 4), chance(20), pick(80, 80, 1, 5, 10, 20, 40, 200, 1000),
+            chance(30), chance(30), pick(FlowStyle.AUTO, FlowStyle.AUTO, FlowStyle.AUTO, FlowStyle.FLOW, FlowStyle.BLOCK),
+            pick(ScalarStyle.PLAIN, ScalarStyle.PLAIN, ScalarStyle.PLAIN, ScalarStyle.SINGLE_QUOTED, ScalarStyle.DOUBLE_QUOTED, ScalarStyle.LITERAL, ScalarStyle.FOLDED, ScalarStyle.JSON_SCALAR_STYLE))
+        .map(t -> new Layout(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    static final Generator<Framing> FRAMING = tuples(chance(50), chance(15), chance(20), chance(20), chance(15), pick("\n", "\n", "\n", "\r\n", "\r"), chance(20))
+        .map(t -> new Framing(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    static final Generator<Chars> CHARS = tuples(chance(30), chance(20), pick(128, 128, 1, 8, 1024))
+        .map(t -> new Chars(t.value1(), t.value2(), t.value3()));
+
+    static final Generator<Options> OPTIONS = tuples(LAYOUT, FRAMING, CHARS).map(t -> new Options(t.value1(), t.value2(), t.value3()));
+
+    /** Dump settings and a stream; with a {@code %YAML} directive the stream has one document (several are snakeyaml-engine/3). */
+    record Case(Options options, Doc.Stream stream) {}
+
+    static final Generator<Case> CASE = OPTIONS.flatMap(o -> tuples(just(o), YamlGen.stream(o.framing().directive())).map(t -> new Case(t.value1(), t.value2())));
+
+    // ---------------------------------------------------------------- shared checks
+
+    static boolean hasNonPrintable(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            boolean printable = c == '\n' || c == '\t' || c == '\r' || (c >= 0x20 && c <= 0x7e) || c == 0x85 || (c >= 0xa0 && c <= 0xd7ff) || (c >= 0xe000 && c <= 0xfffd && c != 0xfeff) || Character.isSurrogate(c);
+            if (!printable) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Shapes whose loss is a recorded bug (bugs.toml) or a design choice (README): not compared. */
+    static String knownLoss(Options o, List<String> strings) {
+        if (o.chars().binaryNonPrintable() && strings.stream().anyMatch(EngineDumpTest::hasNonPrintable)) {
+            return "NonPrintableStyle.BINARY turns a string with non-printable characters into bytes (design)";
+        }
+        // a string starting with a space or a line break is written as a block scalar with an indentation indicator
+        // when it has several lines, or always when the default scalar style is a block style
+        boolean blockStyle = o.layout().scalar() == ScalarStyle.LITERAL || o.layout().scalar() == ScalarStyle.FOLDED;
+        if (o.indicatorIndent() > 0 && !o.layout().indentWithIndicator() && strings.stream().anyMatch(s -> (blockStyle || s.contains("\n")) && (s.startsWith(" ") || s.startsWith("\n")))) {
+            return "a block scalar's indentation indicator under an indented sequence indicator (snakeyaml-engine/4)";
+        }
+        return null;
+    }
+
+    /**
+     * The double-quoted split corruption: a line holding nothing but one or two backslashes (snakeyaml-engine/6).
+     * The emitter splits only at spaces, after content, so a correct dump never has such a line.
+     */
+    static final Pattern DOUBLED_CONTINUATION = Pattern.compile("(^|\\r|\\n) *\\\\\\\\?(\\r|\\n)");
+
+    // ---- 1. dumped values load back --------------------------------------------------------------
+
+    @Test
+    void dumpedValuesLoadBack() {
+        Zoo.run("dumpedValuesLoadBack", tc -> {
+            Case c = tc.draw(CASE, "case");
+            Options o = c.options();
+            Doc.Stream stream = c.stream();
+            DumpSettings ds = o.build();
+            List<JsonElement> expected = stream.canon();
+            List<Object> values = stream.java();
+            String text;
+            try {
+                text = values.size() == 1 ? new Dump(ds).dumpToString(values.get(0)) : new Dump(ds).dumpAllToString(values.iterator());
+            } catch (RuntimeException e) {
+                fail("dumping threw " + e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + " with " + o + " for " + EngineTest.show(expected));
+                return;
+            }
+            String tag = "options " + o + ", value " + EngineTest.show(expected) + EngineTest.describe(text);
+            check(text.endsWith(o.framing().lineBreak()), () -> "the dump does not end with the line break for " + tag);
+            Zoo.assume(tc, !DOUBLED_CONTINUATION.matcher(text).find(), "the double-quoted split corruption (snakeyaml-engine/6)");
+            String known = knownLoss(o, stream.strings());
+            Zoo.assume(tc, known == null, "a recorded loss: " + known);
+            EngineTest.Loaded back = EngineTest.loadAll(o.load(), text);
+            check(back.ok() && back.docs.equals(expected), () -> "the dump loads back as " + back + " instead of " + EngineTest.show(expected) + " for " + tag);
+            // the failsafe-free path: composing the dump gives one node per document
+            int count = 0;
+            try {
+                for (Node nd : new Compose(o.load()).composeAllFromString(text)) {
+                    count++;
+                }
+            } catch (RuntimeException e) {
+                count = -1;
+            }
+            int n = count;
+            check(n == values.size(), () -> "composing the dump gives " + n + " nodes for " + tag);
+        });
+    }
+
+    // ---- 2. events survive Present -> Parse --------------------------------------------------------
+
+    /**
+     * An event's identity up to style: the emitter may quote an implicit plain scalar (and then adds the "!" tag),
+     * choose flow or block for a collection, and write or omit the document markers.
+     */
+    static String eventKey(Event e) {
+        switch (e.getEventId()) {
+            case Scalar: {
+                ScalarEvent s = (ScalarEvent) e;
+                return "=VAL" + anchorKey(s.getAnchor()) + tagKey(s.getTag()) + " " + s.getValue();
+            }
+            case SequenceStart:
+            case MappingStart: {
+                CollectionStartEvent c = (CollectionStartEvent) e;
+                return (e.getEventId() == Event.ID.SequenceStart ? "+SEQ" : "+MAP") + anchorKey(c.getAnchor()) + tagKey(c.getTag());
+            }
+            case DocumentStart:
+                return "+DOC";
+            case DocumentEnd:
+                return "-DOC";
+            default:
+                return e.toString();
+        }
+    }
+
+    static String anchorKey(Optional<Anchor> a) {
+        return a.map(x -> " &" + x.getValue()).orElse("");
+    }
+
+    static String tagKey(Optional<String> t) {
+        return t.filter(x -> !x.equals("!")).map(x -> " <" + x + ">").orElse("");
+    }
+
+    static List<String> keys(Iterable<Event> events) {
+        List<String> out = new ArrayList<>();
+        for (Event e : events) {
+            if (e.getEventId() == Event.ID.Comment) {
+                continue;
+            }
+            out.add(eventKey(e));
+        }
+        return out;
+    }
+
+    static String diffLists(List<String> a, List<String> b) {
+        StringBuilder sb = new StringBuilder();
+        int max = Math.max(a.size(), b.size());
+        int shown = 0;
+        for (int i = 0; i < max && shown < 5; i++) {
+            String x = i < a.size() ? a.get(i) : "<none>", y = i < b.size() ? b.get(i) : "<none>";
+            if (!x.equals(y)) {
+                sb.append("\n    #").append(i).append(": ").append(x).append("\n      -> ").append(y);
+                shown++;
+            }
+        }
+        return sb.toString();
+    }
+
+    @Test
+    void eventsSurvivePresentAndParse() {
+        Zoo.run("eventsSurvivePresentAndParse", tc -> {
+            Case c = tc.draw(CASE, "case");
+            Options o = c.options();
+            Doc.Stream stream = c.stream();
+            String text = stream.render(o.core());
+            String knownShape = EngineTest.knownShape(text);
+            Zoo.assume(tc, knownShape == null, "a recorded shape of the writer: " + knownShape);
+            String known = knownLoss(o, stream.strings());
+            Zoo.assume(tc, known == null, "a recorded loss: " + known);
+            DumpSettings ds = o.build();
+            LoadSettings ls = o.load();
+            List<Event> events = new ArrayList<>();
+            for (Event e : new Parse(ls).parseString(text)) {
+                events.add(e);
+            }
+            String presented;
+            try {
+                presented = new Present(ds).emitToString(events.iterator());
+            } catch (RuntimeException e) {
+                fail("Present threw " + e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + " with " + o + " for" + EngineTest.describe(text));
+                return;
+            }
+            Zoo.assume(tc, !DOUBLED_CONTINUATION.matcher(presented).find(), "the double-quoted split corruption (snakeyaml-engine/6)");
+            String tag = "options " + o + ", source" + EngineTest.describe(text) + "presented as" + EngineTest.describe(presented);
+            List<String> before = keys(events);
+            List<String> after;
+            try {
+                after = keys(new Parse(ls).parseString(presented));
+            } catch (RuntimeException e) {
+                fail("parsing the presented text threw " + e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + " for " + tag);
+                return;
+            }
+            check(before.equals(after), () -> "the events changed:" + diffLists(before, after) + "\nfor " + tag);
+            // and the values are the same
+            List<JsonElement> expected = stream.canon();
+            EngineTest.Loaded back = EngineTest.loadAll(ls, presented);
+            if (o.framing().canonical()) {
+                // parsed events carry no tag; the canonical presentation quotes every scalar and so must write one,
+                // and writes the non-specific "!" (as libyaml does): the plain scalars become strings (README)
+                check(back.ok() && back.docs.size() == expected.size(), () -> "the canonical presentation loads as " + back + " for " + tag);
+                return;
+            }
+            check(back.ok() && back.docs.equals(expected), () -> "the presented text loads as " + back + " instead of " + EngineTest.show(expected) + " for " + tag);
+        });
+    }
+
+    // ---- 3. nodes survive Serialize -> Present -> Compose --------------------------------------------
+
+    static String nodeKey(Node n) {
+        StringBuilder sb = new StringBuilder();
+        nodeKey(n, sb);
+        return sb.toString();
+    }
+
+    static void nodeKey(Node n, StringBuilder sb) {
+        if (n instanceof ScalarNode) {
+            ScalarNode s = (ScalarNode) n;
+            sb.append("S(").append(s.getTag()).append(':').append(s.getValue()).append(')');
+        } else if (n instanceof SequenceNode) {
+            sb.append("[").append(n.getTag());
+            for (Node c : ((SequenceNode) n).getValue()) {
+                sb.append(' ');
+                nodeKey(c, sb);
+            }
+            sb.append(']');
+        } else if (n instanceof MappingNode) {
+            sb.append("{").append(n.getTag());
+            for (NodeTuple t : ((MappingNode) n).getValue()) {
+                sb.append(' ');
+                nodeKey(t.getKeyNode(), sb);
+                sb.append('=');
+                nodeKey(t.getValueNode(), sb);
+            }
+            sb.append('}');
+        } else {
+            sb.append(n);
+        }
+    }
+
+    @Test
+    void nodesSurviveSerializeAndCompose() {
+        Zoo.run("nodesSurviveSerializeAndCompose", tc -> {
+            Case c = tc.draw(CASE, "case");
+            Options o = c.options();
+            Doc.Stream stream = c.stream();
+            String text = stream.render(o.core());
+            String knownShape = EngineTest.knownShape(text);
+            Zoo.assume(tc, knownShape == null, "a recorded shape of the writer: " + knownShape);
+            String known = knownLoss(o, stream.strings());
+            Zoo.assume(tc, known == null, "a recorded loss: " + known);
+            DumpSettings ds = o.build();
+            LoadSettings ls = o.load();
+            List<Node> nodes = new ArrayList<>();
+            for (Node nd : new Compose(ls).composeAllFromString(text)) {
+                nodes.add(nd);
+            }
+            List<String> before = new ArrayList<>();
+            for (Node nd : nodes) {
+                before.add(nodeKey(nd));
+            }
+            String presented;
+            try {
+                List<Event> events = new Serialize(ds).serializeAll(nodes);
+                presented = new Present(ds).emitToString(events.iterator());
+            } catch (RuntimeException e) {
+                fail("serializing threw " + e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + " with " + o + " for" + EngineTest.describe(text));
+                return;
+            }
+            Zoo.assume(tc, !DOUBLED_CONTINUATION.matcher(presented).find(), "the double-quoted split corruption (snakeyaml-engine/6)");
+            String tag = "options " + o + ", source" + EngineTest.describe(text) + "serialized as" + EngineTest.describe(presented);
+            List<String> after = new ArrayList<>();
+            try {
+                for (Node nd : new Compose(ls).composeAllFromString(presented)) {
+                    after.add(nodeKey(nd));
+                }
+            } catch (RuntimeException e) {
+                fail("composing the serialized text threw " + e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + " for " + tag);
+                return;
+            }
+            check(before.equals(after), () -> "the nodes changed:" + diffLists(before, after) + "\nfor " + tag);
+            // dumpNode agrees with Serialize + Present
+            if (nodes.size() == 1) {
+                StringBuilder sb = new StringBuilder();
+                try {
+                    new Dump(ds).dumpNode(nodes.get(0), new StreamDataWriter() {
+                        @Override
+                        public void write(String str) {
+                            sb.append(str);
+                        }
+
+                        @Override
+                        public void write(String str, int off, int len) {
+                            sb.append(str, off, off + len);
+                        }
+                    });
+                } catch (RuntimeException e) {
+                    fail("dumpNode threw " + e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + " for " + tag);
+                    return;
+                }
+                String dumped = sb.toString();
+                check(dumped.equals(presented), () -> "dumpNode gives" + EngineTest.describe(dumped) + "but Serialize + Present" + EngineTest.describe(presented) + "for " + tag);
+            }
+        });
+    }
+}
