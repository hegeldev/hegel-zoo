+
+    // ---- 3. scalars type like the spec's schemas -----------------------------------------------
+
+    static final String[] ODD_SCALARS = {"0o17", "0o", "0x", "0b", "0b11", "08", "09", "017", "007", "00", "1_", "_1", "1_000", "1__0", ".", "+", "-", "1:60", "12e3", "1E3", "1.e3", "1e+3", ".5e3", "5.e", "1e", "0.", "5.", "-0", "+0", "-0.0", "+1", "+1.5", "+.5", "-.5", ".5", "0x_1", "1,000", "1.2.3", "2001-12-14", "=", "<<", "yes", "Yes", "no", "on", "off", "y", "n", "true", "True", "TRUE", "tRue", "false", "False", "FALSE", "null", "Null", "NULL", "nulL", "~", "~x", ".inf", ".Inf", ".INF", "+.inf", "+.Inf", "+.INF", "-.inf", "-.Inf", "-.INF", ".nan", ".NaN", ".NAN", "-.nan", "+.nan", "Infinity", "NaN", "1e309", "-1e309", "1e-400", "4.9e-324", "0.1e1", "3.", "3.e2", "9223372036854775807", "9223372036854775808", "-9223372036854775808", "-9223372036854775809", "2147483647", "2147483648", "-2147483648", "-2147483649", "0x7fffffff", "0x80000000", "0xffffffff", "0x7fffffffffffffff", "0x8000000000000000", "0xffffffffffffffff", "0o17777777777", "0o20000000000", "0o777777777777777777777", "1" + "0".repeat(30), "0x" + "f".repeat(40), "0o" + "7".repeat(40), "1234567890", "12345678901234567890", "0000000001", "0", "1", "-1", "42", "3.14", "1.0", "1.5e300", "1e400", "1E-7", "0.000001", "\u0661\u0662\u0663", "1\u0662", "x", "0xg", "0o8", "0x1.8p1", "1e1.5", "+-1", "--1", "-+1", "1e+", "1e-", ".e1", "0e0", "00.0", "-0e0", "+0.0", "0X1F", "0O17", "-0x1", "+0x1", "-0o7"};
+
+    // the 1.2 schemas' regular expressions (spec 10.2.1 / 10.3.2), independent of the engine's
+    static final Pattern JSON_INT = Pattern.compile("-?(0|[1-9][0-9]*)");
+    static final Pattern JSON_FLOAT = Pattern.compile("-?(0|[1-9][0-9]*)(\\.[0-9]*)?([eE][-+]?[0-9]+)?");
+    static final Pattern CORE_INT = Pattern.compile("[-+]?[0-9]+|0o[0-7]+|0x[0-9a-fA-F]+");
+    static final Pattern CORE_FLOAT = Pattern.compile("[-+]?(\\.[0-9]+|[0-9]+(\\.[0-9]*)?)([eE][-+]?[0-9]+)?|[-+]?\\.(inf|Inf|INF)|\\.(nan|NaN|NAN)");
+    static final Pattern CORE_BOOL = Pattern.compile("true|True|TRUE|false|False|FALSE");
+    static final Pattern CORE_NULL = Pattern.compile("null|Null|NULL|~|");
+
+    /** The kind the spec gives a plain scalar under the schema. */
+    static String specKind(String s, boolean core) {
+        if (core) {
+            if (CORE_NULL.matcher(s).matches()) {
+                return "null";
+            }
+            if (CORE_BOOL.matcher(s).matches()) {
+                return "bool";
+            }
+            if (CORE_INT.matcher(s).matches()) {
+                return "int";
+            }
+            if (CORE_FLOAT.matcher(s).matches()) {
+                return "float";
+            }
+            return "string";
+        }
+        if (s.equals("null")) {
+            return "null";
+        }
+        if (s.equals("true") || s.equals("false")) {
+            return "bool";
+        }
+        if (JSON_INT.matcher(s).matches()) {
+            return "int";
+        }
+        if (JSON_FLOAT.matcher(s).matches() || s.equals(".inf") || s.equals("-.inf") || s.equals(".nan")) {
+            return "float";
+        }
+        return "string";
+    }
+
+    static String kindOf(JsonElement canon) {
+        if (canon.isJsonNull()) {
+            return "null";
+        }
+        if (canon.isJsonPrimitive()) {
+            return canon.getAsJsonPrimitive().isBoolean() ? "bool" : "string";
+        }
+        if (canon.isJsonObject() && canon.getAsJsonObject().has("$n")) {
+            return "int";
+        }
+        if (canon.isJsonObject() && canon.getAsJsonObject().has("$f")) {
+            return "float";
+        }
+        return "other";
+    }
+
+    /** The spec's value of a numeric plain scalar. */
+    static JsonElement specValue(String s, String kind, boolean core) {
+        if (kind.equals("int")) {
+            String t = s.startsWith("+") ? s.substring(1) : s;
+            if (core && t.startsWith("0o")) {
+                return Canon.integer(new BigInteger(t.substring(2), 8));
+            }
+            if (core && t.startsWith("0x")) {
+                return Canon.integer(new BigInteger(t.substring(2), 16));
+            }
+            return Canon.integer(new BigInteger(t));
+        }
+        String l = s.toLowerCase();
+        if (l.endsWith(".inf")) {
+            return Canon.floating(l.startsWith("-") ? Double.NEGATIVE_INFINITY : Double.POSITIVE_INFINITY);
+        }
+        if (l.endsWith(".nan")) {
+            return Canon.floating(Double.NaN);
+        }
+        String t = s.startsWith("+") ? s.substring(1) : s;
+        if (t.endsWith(".") || t.contains(".e") || t.contains(".E")) {
+            t = t.replace(".", ".0"); // "5." and "3.e2" are floats the spec allows and Java's parser does not
+        }
+        return Canon.floating(new BigDecimal(t).doubleValue() == 0.0 && t.startsWith("-") ? -0.0 : Double.parseDouble(t));
+    }
+
+    static final String WORDISH = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.";
+    static final String DIGITISH = "0123456789abcdefxo_.:-+eE";
+
+    /** A decimal of up to nine digits, a thousand million times larger 30% of the time, with a leading zero 15% of the time, signed half the time. */
+    static final Generator<String> DECIMAL = tuples(ints(0, 999_999_999), chance(30), chance(15), pick("", "", "-", "+"))
+        .map(t -> t.value4() + (t.value3() ? "0" : "") + Long.toString(t.value1() * (t.value2() ? 1_000_000_000L : 1L)));
+
+    /** A radix literal: a sign, a 0x/0X/0b/0o/0O/0 prefix and digits (some outside the base, some none). */
+    static final Generator<String> RADIX = tuples(pick("", "-", "+"), pick("0x", "0X", "0b", "0o", "0O", "0"), pick("1f", "7", "101", "0", "17", "9", "a", "8", "ffffffff", "1ffffffff", ""))
+        .map(t -> t.value1() + t.value2() + t.value3());
+
+    /** A float text: a sign, an integer part (80%), a dot, a fraction (85%), an exponent (40%). */
+    static final Generator<String> FLOAT_TEXT = tuples(pick("", "-", "+"), maybe(80, "", ints(0, 999).map(String::valueOf)), maybe(85, "", ints(0, 9999).map(String::valueOf)),
+            maybe(40, "", tuples(pick("e", "E"), pick("", "+", "-"), ints(0, 400)).map(e -> e.value1() + e.value2() + e.value3())))
+        .map(t -> t.value1() + t.value2() + "." + t.value3() + t.value4());
+
+    /** An indicator or an unsafe plain scalar: not a plain scalar the property can write. */
+    static boolean unsafePlain(String s) {
+        return s.isEmpty() || s.startsWith("-") && (s.length() == 1 || s.charAt(1) == ' ') || "?:!%@`#&*".indexOf(s.charAt(0)) >= 0 || s.equals("<<") || s.contains(": ") || s.contains(" #") || s.endsWith(":") || s.endsWith(" ");
+    }
+
+    /** A plain scalar: a word (30%), an edge spelling of the table (30%), a decimal, a radix literal, a float text or a word over the digit alphabet (10% each). */
+    static final Generator<String> PLAIN_SCALAR = weighted(
+        w(30, word(WORDISH, 1, 8)),
+        w(30, pick(ODD_SCALARS)),
+        w(10, DECIMAL),
+        w(10, RADIX),
+        w(10, FLOAT_TEXT),
+        w(10, word(DIGITISH, 1, 8)))
+        .filter(s -> !unsafePlain(s));
+
+    /** Where the scalar stands: alone, after a marker, as a mapping value, a sequence item, in a flow sequence, in a flow mapping (the shapes differ in the scanner). */
+    enum Frame {
+        DOC, MARKED, VALUE, ITEM, FLOW_SEQ, FLOW_MAP;
+
+        String text(String s) {
+            return switch (this) {
+                case DOC -> s + "\n";
+                case MARKED -> "--- " + s + "\n";
+                case VALUE -> "k: " + s + "\n";
+                case ITEM -> "- " + s + "\n";
+                case FLOW_SEQ -> "[" + s + "]\n";
+                case FLOW_MAP -> "{k: " + s + "}\n";
+            };
+        }
+
+        /** Whether the scalar stands whole in the frame (no flow indicator inside it in flow context). */
+        boolean fits(String s) {
+            return switch (this) {
+                case FLOW_SEQ, FLOW_MAP -> !Doc.hasAny(s, ",[]{}:?");
+                default -> true;
+            };
+        }
+
+        /** The scalar's value out of the loaded document. */
+        JsonElement extract(JsonElement doc) {
+            return switch (this) {
+                case VALUE, FLOW_MAP -> doc.getAsJsonObject().getAsJsonArray("$m").get(0).getAsJsonArray().get(1);
+                case ITEM, FLOW_SEQ -> doc.getAsJsonArray().get(0);
+                default -> doc;
+            };
+        }
+    }
+
+    /** The schema, a plain scalar and the frame it stands in. */
+    record ScalarCase(boolean core, String s, Frame frame) {}
+
+    static final Generator<ScalarCase> SCALAR_CASE = tuples(chance(50), PLAIN_SCALAR)
+        .flatMap(t -> pick(Arrays.stream(Frame.values()).filter(f -> f.fits(t.value2())).toArray(Frame[]::new)).map(f -> new ScalarCase(t.value1(), t.value2(), f)));
+
+    @Test
+    void scalarsTypeLikeTheSpec() {
+        Zoo.run("scalarsTypeLikeTheSpec", tc -> {
+            ScalarCase c = tc.draw(SCALAR_CASE, "case");
+            boolean core = c.core();
+            String s = c.s();
+            Zoo.assume(tc, !(core && s.matches("\\+\\.(inf|Inf|INF)")), "+.inf under the core schema (snakeyaml-engine/1)");
+            String kind = specKind(s, core);
+            // the engine's resolver agrees with the spec's regular expressions
+            ScalarResolver r = core ? Doc.CORE_RESOLVER : Doc.JSON_RESOLVER;
+            Tag t = r.resolve(s, true);
+            String resolved = t.equals(Tag.INT) ? "int" : t.equals(Tag.FLOAT) ? "float" : t.equals(Tag.BOOL) ? "bool" : t.equals(Tag.NULL) ? "null" : t.equals(Tag.STR) ? "string" : t.toString();
+            check(resolved.equals(kind), () -> "the " + (core ? "core" : "json") + " resolver gives " + resolved + " for \"" + s + "\" where the spec says " + kind);
+            String text = c.frame().text(s);
+            String tag = "scalar \"" + s + "\" (" + kind + " in the " + (core ? "core" : "json") + " schema) in " + describe(text);
+            Loaded mine = loadAll(settings(core), text);
+            if (!mine.ok()) {
+                fail("loading throws " + mine.error + " for " + tag);
+                return;
+            }
+            JsonElement v = c.frame().extract(mine.docs.get(0));
+            check(kindOf(v).equals(kind), () -> "the engine gives a " + kindOf(v) + " " + Canon.show(v) + " where the spec says " + kind + " for " + tag);
+            if (kind.equals("string")) {
+                check(v.isJsonPrimitive() && v.getAsString().equals(s), () -> "the engine gives the string " + Canon.show(v) + " for " + tag);
+            } else if (kind.equals("int") || kind.equals("float")) {
+                JsonElement want = specValue(s, kind, core);
+                check(v.equals(want), () -> "the engine gives " + Canon.show(v) + " instead of " + Canon.show(want) + " for " + tag);
+            } else if (kind.equals("bool")) {
+                check(v.getAsBoolean() == s.toLowerCase().equals("true"), () -> "the engine gives " + Canon.show(v) + " for " + tag);
+            }
+        });
+    }
+}
diff --git a/hegel/src/test/java/zoo/Gen.java b/hegel/src/test/java/zoo/Gen.java
new file mode 100644
index 0000000..6fc2e8f
--- /dev/null
+++ b/hegel/src/test/java/zoo/Gen.java
@@ -0,0 +1,100 @@
+package zoo;
+
+import static dev.hegel.Generators.integers;
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.sampledFrom;
+
+import dev.hegel.Generator;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The combinators the binding lacks: weighted choice, a biased coin, an optional with a probability, an int range,
+ * bounded lists, and words over an alphabet ({@code TextGenerator} takes code point ranges, not an alphabet).
+ */
+final class Gen {
+    private Gen() {}
+
+    /** A weighted alternative for {@link #weighted}; the generator may produce a subtype of the choice's type. */
+    record Choice<T>(int weight, Generator<? extends T> gen) {}
+
+    static <T> Choice<T> w(int weight, Generator<? extends T> gen) {
+        return new Choice<>(weight, gen);
+    }
+
+    /** A constant alternative. */
+    static <T> Choice<T> v(int weight, T value) {
+        return new Choice<>(weight, just(value));
+    }
+
+    /** One of the generators, chosen in proportion to the weights; one draw, shrinks towards the first. */
+    @SafeVarargs
+    static <T> Generator<T> weighted(Choice<T>... choices) {
+        return weighted(List.of(choices));
+    }
+
+    static <T> Generator<T> weighted(List<Choice<T>> choices) {
+        List<Choice<T>> cs = List.copyOf(choices);
+        int total = 0;
+        for (Choice<T> c : cs) {
+            total += c.weight();
+        }
+        return ints(0, total - 1).flatMap(i -> {
+            int acc = 0;
+            for (Choice<T> c : cs) {
+                acc += c.weight();
+                if (i < acc) {
+                    return widen(c.gen());
+                }
+            }
+            throw new IllegalStateException("weighted: " + i + " beyond " + acc);
+        });
+    }
+
+    /** A generator of a subtype is a generator of the supertype: it only ever produces values. */
+    @SuppressWarnings("unchecked")
+    static <T> Generator<T> widen(Generator<? extends T> g) {
+        return (Generator<T>) g;
+    }
+
+    /** True with probability pct/100; shrinks to false. */
+    static Generator<Boolean> chance(int pct) {
+        return ints(0, 99).map(x -> x >= 100 - pct);
+    }
+
+    /** {@code absent} (weight 100 - pct), or a value of {@code present} (weight pct); shrinks to absent. */
+    static <T> Generator<T> maybe(int pct, T absent, Generator<? extends T> present) {
+        return weighted(w(100 - pct, just(absent)), w(pct, present));
+    }
+
+    /** One of the values, equally likely; shrinks to the first. */
+    @SafeVarargs
+    static <T> Generator<T> pick(T... xs) {
+        return sampledFrom(xs);
+    }
+
+    /** An int in [lo, hi]; shrinks to lo. */
+    static Generator<Integer> ints(int lo, int hi) {
+        return integers().min(lo).max(hi);
+    }
+
+    /** lo..hi values of the generator. */
+    static <T> Generator<List<T>> many(Generator<T> g, int lo, int hi) {
+        return lists(g).minSize(lo).maxSize(hi);
+    }
+
+    /** One UTF-16 unit of the alphabet, as a string. */
+    static Generator<String> chars(String alphabet) {
+        List<String> cs = new ArrayList<>();
+        for (int i = 0; i < alphabet.length(); i++) {
+            cs.add(String.valueOf(alphabet.charAt(i)));
+        }
+        return sampledFrom(cs);
+    }
+
+    /** A string of lo..hi units drawn from the alphabet; shrinks to lo units of the first. */
+    static Generator<String> word(String alphabet, int lo, int hi) {
+        return many(chars(alphabet), lo, hi).map(parts -> String.join("", parts));
+    }
+}
diff --git a/hegel/src/test/java/zoo/YamlGen.java b/hegel/src/test/java/zoo/YamlGen.java
new file mode 100644
index 0000000..165a8bf
--- /dev/null
+++ b/hegel/src/test/java/zoo/YamlGen.java
@@ -0,0 +1,183 @@
+package zoo;
+
+import static dev.hegel.Generators.just;
+import static dev.hegel.Generators.lists;
+import static dev.hegel.Generators.maps;
+import static dev.hegel.Generators.tuples;
+import static zoo.Gen.chance;
+import static zoo.Gen.ints;
+import static zoo.Gen.many;
+import static zoo.Gen.maybe;
+import static zoo.Gen.pick;
+import static zoo.Gen.v;
+import static zoo.Gen.w;
+import static zoo.Gen.weighted;
+import static zoo.Gen.word;
+
+import dev.hegel.Generator;
+import dev.hegel.Tuple3;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import zoo.Doc.BlockKind;
+import zoo.Doc.BlockStyle;
+import zoo.Doc.Bool;
+import zoo.Doc.DocStyle;
+import zoo.Doc.Document;
+import zoo.Doc.Entry;
+import zoo.Doc.Flow;
+import zoo.Doc.Flt;
+import zoo.Doc.Int;
+import zoo.Doc.Key;
+import zoo.Doc.Mapping;
+import zoo.Doc.Nest;
+import zoo.Doc.Node;
+import zoo.Doc.Null;
+import zoo.Doc.Place;
+import zoo.Doc.Quote;
+import zoo.Doc.Seq;
+import zoo.Doc.Str;
+import zoo.Doc.Stream;
+
+/**
+ * Random YAML streams as trees ({@link Doc}): null, bool, int, float and string scalars (strings from a pool with
+ * Unicode, controls, BOM, emoji, indicator characters and YAML-looking words, or built from small pieces),
+ * sequences and mappings three levels deep with distinct keys by construction, every node with the spelling it is
+ * written in, and one document per stream (80%) or two to four. The schema the stream is written for is not part
+ * of the tree: {@link Stream#render(boolean)} takes it.
+ */
+final class YamlGen {
+    private YamlGen() {}
+
+    static final String LETTERS = "abcdefghijklmnopqrstuvwxyz";
+
+    // ---------------------------------------------------------------- values
+
+    static final Generator<String> WORD = word(LETTERS, 1, 6);
+
+    /** A piece of a built string: a word (half the time), a number, white space, an indicator or another odd character, a non-ASCII character. */
+    static final Generator<String> PIECE = weighted(
+        w(6, WORD),
+        w(2, ints(0, 999).map(String::valueOf)),
+        w(1, pick(" ", "  ", "\n", "\n\n", "\t")),
+        w(1, pick("-", ":", "#", ",", "[", "]", "{", "}", "?", "!", "&", "*", "|", ">", "'", "\"", "%", "@", "`", "\\", "/", ".", "_", "=", "<<")),
+        w(1, pick("\u00e9", "\u4e00", "\ud83d\ude00", "\u00a0", "", "\u2028")),
+        w(1, pick(" ", "-", ":", " ")));
+
+    /** A string: one of the pool (45%), or one to five pieces joined by nothing (40%), a space, a dash or a colon. */
+    static final Generator<String> STRING = weighted(
+        w(45, pick(Doc.STRING_POOL)),
+        w(55, tuples(pick("", "", " ", "-", ":"), many(PIECE, 1, 5)).map(t -> String.join(t.value1(), t.value2()))));
+
+    /** A long: small (40%), up to a million (30%), a boundary (10%) or up to a million million (20%). */
+    static final Generator<Long> INT = weighted(
+        w(40, ints(-100, 100).map(i -> (long) i)),
+        w(30, ints(-1_000_000, 1_000_000).map(i -> (long) i)),
+        w(10, pick(0L, 1L, -1L, 255L, 256L, 65535L, 2147483647L, -2147483648L, 2147483648L, 4294967295L, 9007199254740991L, -9007199254740991L, Long.MAX_VALUE, Long.MIN_VALUE)),
+        w(20, tuples(ints(-999_999_999, 999_999_999), ints(0, 999)).map(t -> t.value1() * 1000L + t.value2())));
+
+    /** A double: a small fraction (30%), a notable value (20%), an infinity or NaN (20%), a mantissa and decimal exponent (10%), a three-decimal number (20%). */
+    static final Generator<Double> FLOAT = weighted(
+        w(30, tuples(ints(-1000, 1000), pick(2, 4, 8, 10, 100)).map(t -> t.value1() / (double) t.value2())),
+        w(20, pick(0.1, 0.5, 1.5, -2.5, 1e-7, 1e21, 1e300, 5e-324, 123456.789, -0.0, 0.0)),
+        w(20, pick(Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY, Double.NaN)),
+        w(10, tuples(ints(-1_000_000, 1_000_000), ints(-12, 12)).map(t -> t.value1() * Math.pow(10, t.value2()))),
+        w(20, tuples(ints(1, 999), ints(0, 999)).map(t -> t.value1() + t.value2() / 1000.0)));
+
+    /** A mapping key: a word with a number after it 30% of the time (70%), or any string. */
+    static final Generator<String> KEY_TEXT = weighted(
+        w(70, tuples(WORD, maybe(30, "", ints(0, 99).map(String::valueOf))).map(t -> t.value1() + t.value2())),
+        w(30, STRING));
+
+    // ---------------------------------------------------------------- styles
+
+    static final Generator<String> COMMENT = maybe(15, "", pick(Doc.COMMENTS));
+
+    /**
+     * Where and how a node sits in its parent; {@code bareNull} says whether a null value or item may be left out
+     * of a block collection (an empty scalar, which the failsafe schema cannot construct, snakeyaml-engine/7).
+     */
+    static Generator<Place> place(Generator<Boolean> bareNull) {
+        return tuples(chance(15), chance(8), bareNull, pick(Nest.BLOCK, Nest.BLOCK, Nest.FLOW, Nest.COMPACT), ints(0, 4), ints(0, 2), COMMENT, chance(10))
+            .map(t -> new Place(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+    }
+
+    static final Generator<List<Integer>> DICE = many(ints(0, 99), 1, 6);
+
+    static final Generator<Quote> QUOTE = pick(Quote.PLAIN, Quote.PLAIN, Quote.PLAIN, Quote.SINGLE, Quote.DOUBLE);
+
+    static final Generator<BlockStyle> BLOCK_STYLE = tuples(
+            weighted(v(50, BlockKind.NONE), v(30, BlockKind.LITERAL), v(20, BlockKind.FOLDED)),
+            ints(1, 4), chance(20), chance(50), chance(20), DICE)
+        .map(t -> new BlockStyle(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6()));
+
+    static final Generator<Flow> FLOW = tuples(ints(0, 2), ints(0, 2), ints(0, 2), pick(" ", " ", "", "  "), chance(15), ints(0, 2), ints(0, 2))
+        .map(t -> new Flow(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+
+    // ---------------------------------------------------------------- nodes
+
+    /** The nodes of a grammar: scalars and, above the bottom level, sequences and mappings; built once per kind of place. */
+    record Nodes(Generator<Node> scalar, Generator<Node> node) {
+        static Nodes of(Generator<Place> place) {
+            Generator<Node> nulls = tuples(ints(0, 9), place).map(t -> new Null(t.value1(), t.value2()));
+            Generator<Node> bools = tuples(chance(50), ints(0, 9), place).map(t -> new Bool(t.value1(), t.value2(), t.value3()));
+            Generator<Node> ints = tuples(INT, ints(0, 11), place).map(t -> new Int(t.value1(), t.value2(), t.value3()));
+            Generator<Node> floats = tuples(FLOAT, ints(0, 9), chance(30), chance(50), chance(20), chance(15), place)
+                .map(t -> new Flt(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7()));
+            Generator<Node> strs = tuples(STRING, QUOTE, DICE, BLOCK_STYLE, place).map(t -> new Str(t.value1(), t.value2(), t.value3(), t.value4(), t.value5()));
+            // a scalar: null (10%), bool (10%), int (20%), float (15%) or string (45%)
+            Generator<Node> scalar = weighted(w(10, nulls), w(10, bools), w(20, ints), w(15, floats), w(45, strs));
+            return new Nodes(scalar, level(0, scalar, place));
+        }
+
+        /** A node at container depth {@code depth}: a scalar (44%), or (above the bottom) a sequence or mapping of up to five children. */
+        static Generator<Node> level(int depth, Generator<Node> scalar, Generator<Place> place) {
+            if (depth >= 3) {
+                return scalar;
+            }
+            Generator<Node> deeper = level(depth + 1, scalar, place);
+            Generator<Node> seq = tuples(lists(deeper).maxSize(5), FLOW, place).map(t -> new Seq(t.value1(), t.value2(), t.value3()));
+            Generator<Node> map = tuples(maps(KEY_TEXT, tuples(QUOTE, DICE, deeper)).maxSize(5), FLOW, place).map(t -> new Mapping(entries(t.value1()), t.value2(), t.value3()));
+            return weighted(w(44, scalar), w(28, seq), w(28, map));
+        }
+    }
+
+    static List<Entry> entries(Map<String, Tuple3<Quote, List<Integer>, Node>> m) {
+        List<Entry> out = new ArrayList<>();
+        for (Map.Entry<String, Tuple3<Quote, List<Integer>, Node>> e : m.entrySet()) {
+            out.add(new Entry(new Key(e.getKey(), e.getValue().value1(), e.getValue().value2()), e.getValue().value3()));
+        }
+        return out;
+    }
+
+    /** Nodes whose nulls are left out of block collections 30% of the time. */
+    static final Nodes NODES = Nodes.of(place(chance(30)));
+
+    /** Nodes with every scalar spelled out: no empty scalars, so the failsafe schema loads the stream. */
+    static final Nodes SPELLED_NODES = Nodes.of(place(just(false)));
+
+    // ---------------------------------------------------------------- documents
+
+    static final Generator<DocStyle> DOC_STYLE = tuples(chance(20), chance(15), chance(30), maybe(30, "", pick(Doc.COMMENTS)), maybe(15, 0, ints(1, 3)), chance(20), chance(20), chance(10))
+        .map(t -> new DocStyle(t.value1(), t.value2(), t.value3(), t.value4(), t.value5(), t.value6(), t.value7(), t.value8()));
+
+    static Generator<Document> document(Nodes nodes) {
+        return tuples(nodes.node(), DOC_STYLE).map(t -> new Document(t.value1(), t.value2()));
+    }
+
+    static final Generator<Document> DOCUMENT = document(NODES);
+
+    /** A stream of one document. */
+    static final Generator<Stream> ONE_DOCUMENT = many(DOCUMENT, 1, 1).map(Stream::new);
+
+    /** A stream of one document (80%) or two to four. */
+    static final Generator<Stream> STREAM = weighted(w(80, many(DOCUMENT, 1, 1)), w(20, many(DOCUMENT, 2, 4))).map(Stream::new);
+
+    /** {@link #STREAM} with every scalar spelled out (no empty scalars). */
+    static final Generator<Stream> SPELLED_STREAM = weighted(w(80, many(document(SPELLED_NODES), 1, 1)), w(20, many(document(SPELLED_NODES), 2, 4))).map(Stream::new);
+
+    /** {@link #ONE_DOCUMENT} when {@code single}, else {@link #STREAM}. */
+    static Generator<Stream> stream(boolean single) {
+        return single ? ONE_DOCUMENT : STREAM;
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..e5f3271
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,127 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Hegel;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    /** Runs a property under {@link #settings}; in collect mode the {@link #count statistics} follow as a {@code STATS} line. */
+    static void run(String name, Consumer<TestCase> body) {
+        Hegel.test(body, settings(name));
+        if (COLLECT) {
+            String st = stats();
+            if (!st.equals("{}")) {
+                System.out.println("STATS " + name + " " + st);
+                System.out.flush();
+            }
+        }
+    }
+
+    private static final Map<String, Integer> STATS = new TreeMap<>();
+
+    /** Bumps a statistic (the shape of a case, the reason a check was not run); printed in collect mode. */
+    static synchronized void count(String key) {
+        STATS.merge(key, 1, Integer::sum);
+    }
+
+    /** The statistics so far, cleared, as one line. */
+    static synchronized String stats() {
+        String s = STATS.toString();
+        STATS.clear();
+        return s;
+    }
+
+    /** Rejects the case unless {@code ok}, counting the reason so that collect mode shows every gate's rate. */
+    static void assume(TestCase tc, boolean ok, String reason) {
+        if (!ok) {
+            count("rejected: " + reason);
+        }
+        tc.assume(ok);
+    }
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "\u2026" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
