+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import dev.hegel.TestCase;
+import java.util.AbstractMap.SimpleEntry;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.snakeyaml.engine.v2.nodes.Tag;
+import org.snakeyaml.engine.v2.resolver.ScalarResolver;
+import org.snakeyaml.engine.v2.schema.CoreSchema;
+import org.snakeyaml.engine.v2.schema.JsonSchema;
+import com.google.gson.JsonElement;
+
+/**
+ * A randomised YAML writer for the parser side (ported from the zoo's js-yaml, go-yaml and
+ * snakeyaml harnesses): a generated tree of plain values is written as a document in random
+ * styles — block and flow collections at random indentation, plain / single-quoted /
+ * double-quoted / literal / folded scalars, explicit keys, comments, document markers — staying
+ * inside what YAML 1.2 core-schema readers (snakeyaml-engine, and Jackson on top of it) must read
+ * back as the same tree.
+ */
+final class YamlGen {
+
+    /** A tree node: kind is null, bool, int, float, string, seq or map. */
+    static final class Tree {
+        final String kind;
+        final Object value; // Boolean, Long, Double or String
+        final List<Tree> items; // seq
+        final List<Map.Entry<String, Tree>> entries; // map
+
+        Tree(String kind, Object value, List<Tree> items, List<Map.Entry<String, Tree>> entries) {
+            this.kind = kind;
+            this.value = value;
+            this.items = items;
+            this.entries = entries;
+        }
+
+        static Tree scalar(String kind, Object value) {
+            return new Tree(kind, value, null, null);
+        }
+
+        boolean isColl() {
+            return kind.equals("seq") || kind.equals("map");
+        }
+
+        int size() {
+            return kind.equals("seq") ? items.size() : kind.equals("map") ? entries.size() : 0;
+        }
+
+        /** The canonical form (Canon's) of the value a YAML 1.2 reader gives for this tree. */
+        JsonElement canon() {
+            switch (kind) {
+                case "null":
+                    return Canon.nul();
+                case "bool":
+                    return Canon.bool((Boolean) value);
+                case "int":
+                    return Canon.integer((Long) value);
+                case "float":
+                    return Canon.floating((Double) value);
+                case "string":
+                    return Canon.string((String) value);
+                case "seq": {
+                    List<JsonElement> a = new ArrayList<>();
+                    for (Tree t : items) {
+                        a.add(t.canon());
+                    }
+                    return Canon.seq(a);
+                }
+                default: {
+                    List<JsonElement[]> pairs = new ArrayList<>();
+                    for (Map.Entry<String, Tree> e : entries) {
+                        pairs.add(new JsonElement[] {Canon.string(e.getKey()), e.getValue().canon()});
+                    }
+                    return Canon.map(pairs);
+                }
+            }
+        }
+
+        /** The Java value a core-schema constructor gives (ints as Integer/Long, maps as LinkedHashMap). */
+        Object java() {
+            switch (kind) {
+                case "null":
+                    return null;
+                case "int": {
+                    long v = (Long) value;
+                    return v >= Integer.MIN_VALUE && v <= Integer.MAX_VALUE ? (Object) (int) v : (Object) v;
+                }
+                case "seq": {
+                    List<Object> l = new ArrayList<>();
+                    for (Tree t : items) {
+                        l.add(t.java());
+                    }
+                    return l;
+                }
+                case "map": {
+                    Map<Object, Object> m = new LinkedHashMap<>();
+                    for (Map.Entry<String, Tree> e : entries) {
+                        m.put(e.getKey(), e.getValue().java());
+                    }
+                    return m;
+                }
+                default:
+                    return value;
+            }
+        }
+
+        /** The JSON text of the tree (for Jackson's JSON reader as a third view of the same value). */
+        String json() {
+            StringBuilder sb = new StringBuilder();
+            json(sb);
+            return sb.toString();
+        }
+
+        private void json(StringBuilder sb) {
+            switch (kind) {
+                case "null":
+                    sb.append("null");
+                    break;
+                case "bool":
+                    sb.append(value);
+                    break;
+                case "int":
+                    sb.append(value);
+                    break;
+                case "float": {
+                    double d = (Double) value;
+                    if (Double.isNaN(d) || Double.isInfinite(d)) {
+                        sb.append(Double.isNaN(d) ? "NaN" : d > 0 ? "Infinity" : "-Infinity");
+                    } else {
+                        sb.append(Double.toString(d));
+                    }
+                    break;
+                }
+                case "string":
+                    jsonString((String) value, sb);
+                    break;
+                case "seq":
+                    sb.append('[');
+                    for (int i = 0; i < items.size(); i++) {
+                        if (i > 0) {
+                            sb.append(',');
+                        }
+                        items.get(i).json(sb);
+                    }
+                    sb.append(']');
+                    break;
+                default:
+                    sb.append('{');
+                    for (int i = 0; i < entries.size(); i++) {
+                        if (i > 0) {
+                            sb.append(',');
+                        }
+                        jsonString(entries.get(i).getKey(), sb);
+                        sb.append(':');
+                        entries.get(i).getValue().json(sb);
+                    }
+                    sb.append('}');
+            }
+        }
+
+        static void jsonString(String s, StringBuilder sb) {
+            sb.append('"');
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || (c >= 0xd800 && c <= 0xdfff) || c == 0x2028 || c == 0x2029 || c == 0xfeff || c == 0x85 || c == 0x7f) {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            sb.append('"');
+        }
+    }
+
+    static final String[] STRING_POOL = {
+        "", " ", "a", "x y", "a: b", "a:b", "- x", "? x", "# c", "x #y", "x#y", ": x", "key:", "yes", "no", "on", "off", "y", "n",
+        "true", "false", "null", "~", "Null", "1", "-1", "+1", "0", "00", "017", "0x1f", "0o17", "0b11", "1_000", "1.5", ".5", "5.", "1e3",
+        "1.0e+3", ".inf", "-.inf", ".nan", "1:30", "12:30:45", "2001-12-14", "2001-12-14t21:59:43.10-05:00", "2001-12-14 21:59:43.10 -5",
+        "<<", "=", "---", "...", "--- x", "... x", "-", "?", ":", ",", "[", "]", "{", "}", "&a", "*a", "!x", "|", ">", "%x", "@x", "`x",
+        "'q'", "\"q\"", "\\", "a\\b", "a\nb", "a\n\nb", "a\n", "\na", "a\n\n", "  a", "a  ", "a\tb", "\t", "é", "一", "😀",
+        "", "\u00a0", "\u2028", "\ufeff", "\u0000", "\u001b", "\u007f", "a\rb", "0.5.2", "1__0", "1.e3", "-.5", "+.5", "._5",
+        "0x", "0o", "0o8", "0x1g", "1e", "e3", "+", "-0", "+.inf", "-.nan", "Infinity", "NaN", "1E3", "1.", "-1.5e-3", "007", "1.0.0", "1,000",
+        "True", "FALSE", "NULL", "tRue", "nulL", "0.0", "-0.0", "9223372036854775808", "-9223372036854775809", "1" + "0".repeat(30),
+        "a b c d e f g", "line one\nline two\nline three", "trailing space \nnext", "x".repeat(200), "w ".repeat(50).trim(),
+    };
+
+    static final ScalarResolver JSON_RESOLVER = new JsonSchema().getScalarResolver();
+    static final ScalarResolver CORE_RESOLVER = new CoreSchema().getScalarResolver();
+    static final String LETTERS = "abcdefghijklmnopqrstuvwxyz";
+    static final String PLAIN_BAN_FIRST = "-?:,[]{}#&*!|>'\"%@` \t";
+
+    final TestCase tc;
+    /** Write in the spellings of the core schema (0x, 0o, +1, ~, Null, True, .Inf) or only the JSON schema's. */
+    final boolean core;
+    final ScalarResolver resolver;
+    boolean fragileTail; // after a keep-chomped block scalar an empty line would join its content
+
+    YamlGen(TestCase tc, boolean core) {
+        this.tc = tc;
+        this.core = core;
+        this.resolver = core ? CORE_RESOLVER : JSON_RESOLVER;
+    }
+
+    String word() {
+        return Zoo.word(tc, LETTERS, 1, 6);
+    }
+
+    // ---------------------------------------------------------------- trees
+
+    String genString() {
+        if (chance(tc, 45)) {
+            return pick(tc, STRING_POOL);
+        }
+        StringBuilder sb = new StringBuilder();
+        int len = n(tc, 1, 5);
+        String joiner = pick(tc, "", "", " ", "-", ":");
+        for (int i = 0; i < len; i++) {
+            if (i > 0) {
+                sb.append(joiner);
+            }
+            int r = n(tc, 1, 12);
+            if (r <= 6) {
+                sb.append(word());
+            } else if (r <= 8) {
+                sb.append(n(tc, 0, 999));
+            } else if (r == 9) {
+                sb.append(pick(tc, " ", "  ", "\n", "\n\n", "\t"));
+            } else if (r == 10) {
+                sb.append(pick(tc, "-", ":", "#", ",", "[", "]", "{", "}", "?", "!", "&", "*", "|", ">", "'", "\"", "%", "@", "`", "\\", "/", ".", "_", "=", "<<"));
+            } else if (r == 11) {
+                sb.append(pick(tc, "é", "一", "😀", "\u00a0", "", "\u2028"));
+            } else {
+                sb.append(pick(tc, " ", "-", ":", " "));
+            }
+        }
+        return sb.toString();
+    }
+
+    long genInt() {
+        int r = n(tc, 1, 10);
+        if (r <= 4) {
+            return n(tc, -100, 100);
+        }
+        if (r <= 7) {
+            return n(tc, -1000000, 1000000);
+        }
+        if (r == 8) {
+            return pick(tc, 0L, 1L, -1L, 255L, 256L, 65535L, 2147483647L, -2147483648L, 2147483648L, 4294967295L, 9007199254740991L, -9007199254740991L, Long.MAX_VALUE, Long.MIN_VALUE);
+        }
+        return (long) n(tc, -999999999, 999999999) * 1000L + n(tc, 0, 999);
+    }
+
+    double genFloat() {
+        int r = n(tc, 1, 10);
+        if (r <= 3) {
+            return n(tc, -1000, 1000) / (double) pick(tc, 2, 4, 8, 10, 100);
+        }
+        if (r <= 5) {
+            return pick(tc, 0.1, 0.5, 1.5, -2.5, 1e-7, 1e21, 1e300, 5e-324, 123456.789, -0.0, 0.0);
+        }
+        if (r <= 7) {
+            return pick(tc, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY, Double.NaN);
+        }
+        if (r == 8) {
+            return n(tc, -1000000, 1000000) * Math.pow(10, n(tc, -12, 12));
+        }
+        return n(tc, 1, 999) + n(tc, 0, 999) / 1000.0;
+    }
+
+    String genKey(Set<String> used) {
+        for (int i = 0; i < 20; i++) {
+            String k = chance(tc, 70) ? word() + (chance(tc, 30) ? Integer.toString(n(tc, 0, 99)) : "") : genString();
+            if (k.length() > 200) {
+                k = k.substring(0, 200);
+            }
+            if (!used.contains(k)) {
+                return k;
+            }
+        }
+        String k = "k" + used.size();
+        while (used.contains(k)) {
+            k += "_";
+        }
+        return k;
+    }
+
+    Tree genTree(int depth) {
+        int r = n(tc, 1, 100);
+        if (depth < 3 && r <= 28) {
+            return genSeq(depth);
+        }
+        if (depth < 3 && r <= 56) {
+            return genMap(depth);
+        }
+        return genScalar();
+    }
+
+    Tree genScalar() {
+        int r = n(tc, 1, 20);
+        if (r <= 2) {
+            return Tree.scalar("null", null);
+        }
+        if (r <= 4) {
+            return Tree.scalar("bool", chance(tc, 50));
+        }
+        if (r <= 8) {
+            return Tree.scalar("int", genInt());
+        }
+        if (r <= 11) {
+            return Tree.scalar("float", genFloat());
+        }
+        return Tree.scalar("string", genString());
+    }
+
+    Tree genSeq(int depth) {
+        int len = chance(tc, 10) ? 0 : n(tc, 1, 5);
+        List<Tree> items = new ArrayList<>();
+        for (int i = 0; i < len; i++) {
+            items.add(genTree(depth + 1));
+        }
+        return new Tree("seq", null, items, null);
+    }
+
+    Tree genMap(int depth) {
+        int len = chance(tc, 10) ? 0 : n(tc, 1, 5);
+        Set<String> used = new HashSet<>();
+        List<Map.Entry<String, Tree>> entries = new ArrayList<>();
+        for (int i = 0; i < len; i++) {
+            String k = genKey(used);
+            used.add(k);
+            entries.add(new SimpleEntry<>(k, genTree(depth + 1)));
+        }
+        return new Tree("map", null, null, entries);
+    }
+
+    // ---------------------------------------------------------------- scalars
+
+    static boolean isControl(int c) {
+        return c <= 0x08 || c == 0x0b || c == 0x0c || (c >= 0x0e && c <= 0x1f) || c == 0x7f || c == 0x85 || c == 0x2028 || c == 0x2029 || c == 0xfeff;
+    }
+
+    static boolean hasControl(String s) {
+        return s.codePoints().anyMatch(YamlGen::isControl);
+    }
+
+    static boolean hasSurrogate(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
+                    i++;
+                    continue;
+                }
+                return true;
+            }
+            if (Character.isLowSurrogate(c)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean hasAny(String s, String chars) {
+        for (int i = 0; i < s.length(); i++) {
+            if (chars.indexOf(s.charAt(i)) >= 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** The tag the schema's resolver gives an implicit plain scalar. */
+    Tag resolve(String s) {
+        return resolver.resolve(s, true);
+    }
+
+    boolean plainSafe(String s, boolean flow) {
+        return plainSafe(s, flow, resolver);
+    }
+
+    /**
+     * A string may be plain when the syntax leaves it whole and the schema's resolver gives a
+     * string back. Not: empty, multi-line, tabs, leading/trailing space.
+     */
+    static boolean plainSafe(String s, boolean flow, ScalarResolver resolver) {
+        if (s.isEmpty() || hasAny(s, "\n\r\t") || hasControl(s) || hasSurrogate(s)) {
+            return false;
+        }
+        if (PLAIN_BAN_FIRST.indexOf(s.charAt(0)) >= 0) {
+            return false;
+        }
+        if (s.contains(": ") || s.contains(" #") || s.endsWith(":") || s.endsWith(" ")) {
+            return false;
+        }
+        if (s.startsWith("---") || s.startsWith("...")) {
+            return false;
+        }
+        if (s.equals("<<")) {
+            return false; // the merge key
+        }
+        if (flow && hasAny(s, ",[]{}:?")) {
+            return false;
+        }
+        if (s.length() > 1000) {
+            return false;
+        }
+        return resolver.resolve(s, true).equals(Tag.STR);
+    }
+
+    static boolean singleOK(String s) {
+        return !hasAny(s, "\n\r\t") && !hasControl(s) && !hasSurrogate(s) && s.length() <= 1000;
+    }
+
+    String doubleQuoted(String s) {
+        StringBuilder out = new StringBuilder("\"");
+        int i = 0;
+        while (i < s.length()) {
+            int c = s.codePointAt(i);
+            i += Character.charCount(c);
+            if (c == '"') {
+                out.append("\\\"");
+            } else if (c == '\\') {
+                out.append("\\\\");
+            } else if (c == '\n') {
+                out.append(chance(tc, 80) ? "\\n" : "\\x0a");
+            } else if (c == '\r') {
+                out.append("\\r");
+            } else if (c == '\t') {
+                out.append(chance(tc, 70) ? "\\t" : "\\x09");
+            } else if (c == 0x85) {
+                out.append("\\N");
+            } else if (c == 0xa0) {
+                out.append(chance(tc, 50) ? "\\_" : "\\xa0");
+            } else if (c == 0x2028) {
+                out.append("\\u2028"); // snakeyaml-engine rejects the 1.2 escapes \L and \P
+            } else if (c == 0x2029) {
+                out.append("\\u2029");
+            } else if (c == 0xfeff) {
+                out.append("\\ufeff");
+            } else if (c == '/' && chance(tc, 30)) {
+                out.append("\\/"); // YAML 1.2 has the escape
+            } else if (c < 0x20 || c == 0x7f) {
+                out.append(String.format("\\x%02x", c));
+            } else if (c >= 0xd800 && c <= 0xdfff) {
+                out.append(String.format("\\u%04x", c));
+            } else if (c == ' ' && chance(tc, 10)) {
+                out.append("\\ ");
+            } else if (c > 0x7f && chance(tc, 30)) {
+                out.append(c < 0x10000 ? String.format("\\u%04x", c) : String.format("\\U%08x", c));
+            } else {
+                out.appendCodePoint(c);
+            }
+        }
+        return out.append('"').toString();
+    }
+
+    static String single(String s) {
+        return "'" + s.replace("'", "''") + "'";
+    }
+
+    static List<String> splitLines(String s) {
+        return new ArrayList<>(Arrays.asList(s.split("\n", -1)));
+    }
+
+    /**
+     * A literal block can hold s when it is multi-line, free of CR/tab/controls, not all whitespace,
+     * no line ends in a space and the first non-empty line does not start with one.
+     */
+    static boolean literalOK(String s) {
+        if (!s.contains("\n") || hasAny(s, "\r\t") || hasControl(s) || s.trim().isEmpty() || hasSurrogate(s)) {
+            return false;
+        }
+        List<String> lines = splitLines(s);
+        String first = null;
+        for (String l : lines) {
+            if (!l.isEmpty() && l.trim().isEmpty()) {
+                return false;
+            }
+            if (l.endsWith(" ")) {
+                return false;
+            }
+            if (first == null && !l.isEmpty()) {
+                first = l;
+            }
+        }
+        return first != null && !first.startsWith(" ");
+    }
+
+    /** A folded block can hold s when no line is empty or starts/ends with a space or holds two. */
+    static boolean foldedOK(String s) {
+        if (!literalOK(s) && !(!s.isEmpty() && !s.contains("\n") && s.contains(" "))) {
+            return false;
+        }
+        if (hasAny(s, "\r\t") || hasControl(s) || hasSurrogate(s)) {
+            return false;
+        }
+        for (String l : splitLines(s.replaceAll("\n+$", ""))) {
+            if (l.isEmpty() || l.startsWith(" ") || l.endsWith(" ") || l.contains("  ")) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static final class Chomp {
+        final String trimmed;
+        final int trailing;
+        final String chomp;
+
+        Chomp(String s) {
+            trimmed = s.replaceAll("\n+$", "");
+            trailing = s.length() - trimmed.length();
+            chomp = trailing == 0 ? "-" : trailing == 1 ? "" : "+";
+        }
+    }
+
+    String header(String kind, String chomp, String ind) {
+        String h = kind;
+        if (chance(tc, 50)) {
+            h += ind + chomp;
+        } else {
+            h += chomp + ind;
+        }
+        if (chance(tc, 20)) {
+            h += " # comment";
+        }
+        return h;
+    }
+
+    /** Lines of a literal block for s, content indented by `indent` spaces (parent at parentIndent). */
+    List<String> literal(String s, int parentIndent, int indent) {
+        Chomp c = new Chomp(s);
+        List<String> lines = splitLines(c.trimmed);
+        String ind = "";
+        if (!c.chomp.equals("+") && indent - parentIndent <= 9 && chance(tc, 20)) {
+            ind = Integer.toString(indent - parentIndent);
+        }
+        List<String> out = new ArrayList<>();
+        out.add(header("|", c.chomp, ind));
+        String pad = " ".repeat(indent);
+        for (String l : lines) {
+            out.add(l.isEmpty() ? (chance(tc, 50) ? "" : pad) : pad + l);
+        }
+        for (int i = 1; i < c.trailing; i++) {
+            out.add("");
+        }
+        return out;
+    }
+
+    /** Lines of a folded block for s: single spaces may become line breaks, a newline an empty line. */
+    List<String> folded(String s, int parentIndent, int indent) {
+        Chomp c = new Chomp(s);
+        List<String> srcLines = splitLines(c.trimmed);
+        String ind = "";
+        if (!c.chomp.equals("+") && indent - parentIndent <= 9 && chance(tc, 20)) {
+            ind = Integer.toString(indent - parentIndent);
+        }
+        List<String> out = new ArrayList<>();
+        out.add(header(">", c.chomp, ind));
+        String pad = " ".repeat(indent);
+        for (int i = 0; i < srcLines.size(); i++) {
+            if (i > 0) {
+                out.add("");
+            }
+            String[] words = srcLines.get(i).split(" ", -1);
+            String cur = words[0];
+            for (int w = 1; w < words.length; w++) {
+                if (chance(tc, 40)) {
+                    out.add(pad + cur);
+                    cur = words[w];
+                } else {
+                    cur += " " + words[w];
+                }
+            }
+            out.add(pad + cur);
+        }
+        for (int i = 1; i < c.trailing; i++) {
+            out.add("");
+        }
+        return out;
+    }
+
+    /**
+     * An integer: decimal in the JSON schema; in the core schema also signed, 0x hex or 0o octal
+     * (never with leading zeros — a Jackson feature reads those as octal).
+     */
+    String integer(long v) {
+        if (!core) {
+            return v == 0 && chance(tc, 30) ? "-0" : Long.toString(v);
+        }
+        if (v == 0) {
+            return pick(tc, "0", "0", "+0", "0x0", "0o0", "-0");
+        }
+        if (v < 0) {
+            return Long.toString(v);
+        }
+        int r = n(tc, 1, 12);
+        if (r == 1) {
+            return "0x" + Long.toHexString(v);
+        }
+        if (r == 2) {
+            return "0x" + Long.toHexString(v).toUpperCase();
+        }
+        if (r == 3) {
+            return "0o" + Long.toOctalString(v);
+        }
+        if (r == 4) {
+            return "+" + v;
+        }
+        return Long.toString(v);
+    }
+
+    /**
+     * A float in the schema's spelling: the JSON schema's `-?(0|[1-9][0-9]*)(\.[0-9]*)?([eE][-+]?[0-9]+)?`
+     * plus `.inf`/`-.inf`/`.nan`; the core schema also `+`, a leading dot and the capitalised words.
+     */
+    String floating(double f) {
+        if (f == Double.POSITIVE_INFINITY) {
+            return core ? pick(tc, ".inf", ".Inf", ".INF") : ".inf"; // not "+.inf": snakeyaml-engine's core float constructor fails on it
+        }
+        if (f == Double.NEGATIVE_INFINITY) {
+            return core ? pick(tc, "-.inf", "-.Inf", "-.INF") : "-.inf";
+        }
+        if (Double.isNaN(f)) {
+            return core ? pick(tc, ".nan", ".NaN", ".NAN") : ".nan";
+        }
+        if (f == 0 && 1 / f < 0) {
+            return pick(tc, "-0.0", "-0.0e+0", "-0.");
+        }
+        String s;
+        int r = n(tc, 1, 4);
+        String plain = Double.toString(f); // 1.5, 1.0E21, 1.0E-7
+        if (r == 1) {
+            s = plain.toLowerCase();
+        } else if (r == 2) {
+            s = plain;
+        } else if (r == 3 && Math.abs(f) < 1e17 && Math.abs(f) >= 1e-6) {
+            s = new java.math.BigDecimal(f).toPlainString();
+        } else {
+            s = plain.toLowerCase();
+        }
+        if (chance(tc, 70)) {
+            // a dot and a signed exponent: the spelling every YAML version accepts
+            s = s.replaceFirst("^([-+]?\\d+)([eE])", "$1.0$2");
+            s = s.replaceFirst("([eE])(\\d)", "$1+$2");
+            if (!s.contains(".")) {
+                s += ".0";
+            }
+        } else {
+            // 1.2 spellings: 1e21, 5., 1.0E21
+            s = s.replaceFirst("\\.0([eE])", "$1");
+            if (s.endsWith(".0") && chance(tc, 50)) {
+                s = s.substring(0, s.length() - 1);
+            }
+            if (!s.contains(".") && !s.contains("e") && !s.contains("E")) {
+                s += ".";
+            }
+        }
+        if (core && s.startsWith("0.") && s.length() > 2 && Character.isDigit(s.charAt(2)) && chance(tc, 20)) {
+            s = s.substring(1);
+        }
+        if (core && Character.isDigit(s.charAt(0)) && chance(tc, 15)) {
+            s = "+" + s;
+        }
+        return s;
+    }
+
+    String scalar(Tree t, boolean flow) {
+        switch (t.kind) {
+            case "null":
+                return core ? pick(tc, "null", "null", "Null", "NULL", "~") : "null";
+            case "bool":
+                if (!core) {
+                    return (Boolean) t.value ? "true" : "false";
+                }
+                return (Boolean) t.value ? pick(tc, "true", "true", "True", "TRUE") : pick(tc, "false", "false", "False", "FALSE");
+            case "int":
+                return integer((Long) t.value);
+            case "float":
+                return floating((Double) t.value);
+            default: {
+                String s = (String) t.value;
+                if (plainSafe(s, flow) && chance(tc, 65)) {
+                    return s;
+                }
+                if (singleOK(s) && chance(tc, 45)) {
+                    return single(s);
+                }
+                return doubleQuoted(s);
+            }
+        }
+    }
+
+    String key(String k, boolean flow) {
+        if (plainSafe(k, flow) && chance(tc, 75)) {
+            return k;
+        }
+        if (singleOK(k) && chance(tc, 40)) {
+            return single(k);
+        }
+        return doubleQuoted(k);
+    }
+
+    // ---------------------------------------------------------------- collections
+
+    String sp() {
+        return " ".repeat(n(tc, 0, 2));
+    }
+
+    String flow(Tree t) {
+        if (t.kind.equals("seq")) {
+            if (t.items.isEmpty()) {
+                return "[" + sp() + "]";
+            }
+            String sep = sp() + "," + pick(tc, " ", " ", "", "  ");
+            StringBuilder s = new StringBuilder("[").append(sp());
+            for (int i = 0; i < t.items.size(); i++) {
+                if (i > 0) {
+                    s.append(sep);
+                }
+                s.append(flow(t.items.get(i)));
+            }
+            if (chance(tc, 15)) {
+                s.append(sp()).append(",");
+            }
+            return s.append(sp()).append("]").toString();
+        }
+        if (t.kind.equals("map")) {
+            if (t.entries.isEmpty()) {
+                return "{" + sp() + "}";
+            }
+            String sep = sp() + "," + pick(tc, " ", " ", "", "  ");
+            StringBuilder s = new StringBuilder("{").append(sp());
+            for (int i = 0; i < t.entries.size(); i++) {
+                if (i > 0) {
+                    s.append(sep);
+                }
+                Map.Entry<String, Tree> e = t.entries.get(i);
+                s.append(key(e.getKey(), true)).append(sp()).append(": ").append(sp()).append(flow(e.getValue()));
+            }
+            if (chance(tc, 15)) {
+                s.append(sp()).append(",");
+            }
+            return s.append(sp()).append("}").toString();
+        }
+        return scalar(t, true);
+    }
+
+    String comment() {
+        return pick(tc, " # c", " #", "  # comment: with [flow] and 'quotes'", " # 日本");
+    }
+
+    String maybeComment() {
+        return chance(tc, 15) ? comment() : "";
+    }
+
+    /** A block scalar's lines after the head (key or `-`), or null when s does not fit one. */
+    List<String> blockScalarLines(String s, int indent) {
+        int step = n(tc, 1, 4);
+        if (literalOK(s) && chance(tc, 60)) {
+            return literal(s, indent, indent + step);
+        }
+        if (foldedOK(s) && chance(tc, 40)) {
+            return folded(s, indent, indent + step);
+        }
+        return null;
+    }
+
+    static boolean isKeep(List<String> block) {
+        return block != null && block.get(0).matches("^[|>][0-9]?\\+.*|^[|>]\\+.*");
+    }
+
+    static String ascii(String s) {
+        StringBuilder sb = new StringBuilder();
+        for (char c : s.toCharArray()) {
+            if (c >= 0x20 && c <= 0x7e) {
+                sb.append(c);
+            }
+        }
+        return sb.length() > 20 ? sb.substring(0, 20) : sb.toString();
+    }
+
+    /** Lines of a collection in block style, every line indented by `indent` spaces. */
+    List<String> blockLines(Tree t, int indent) {
+        String pad = " ".repeat(indent);
+        List<String> lines = new ArrayList<>();
+        if (t.kind.equals("map")) {
+            for (Map.Entry<String, Tree> e : t.entries) {
+                String k = e.getKey();
+                Tree kid = e.getValue();
+                fragileTail = false;
+                if (chance(tc, 15)) {
+                    lines.add(pad + "# before " + ascii(k));
+                }
+                String head = pad + key(k, false) + ":";
+                boolean explicit = false;
+                if (chance(tc, 8) && !k.contains("\n")) {
+                    lines.add(pad + "? " + key(k, false));
+                    head = pad + ":";
+                    explicit = true;
+                }
+                List<String> block = kid.kind.equals("string") ? blockScalarLines((String) kid.value, indent) : null;
+                if (kid.kind.equals("null") && chance(tc, 30)) {
+                    lines.add(head + maybeComment());
+                } else if (block != null) {
+                    lines.add(head + " " + block.get(0));
+                    lines.addAll(block.subList(1, block.size()));
+                    fragileTail = isKeep(block);
+                } else if (kid.isColl() && kid.size() > 0 && chance(tc, 75)) {
+                    int step = n(tc, 1, 4);
+                    if (kid.kind.equals("seq") && !explicit && chance(tc, 35)) {
+                        step = 0;
+                    }
+                    lines.add(head + maybeComment());
+                    lines.addAll(blockLines(kid, indent + step));
+                } else if (kid.isColl()) {
+                    lines.add(head + " " + flow(kid) + maybeComment());
+                } else {
+                    lines.add(head + " " + sp() + scalar(kid, false) + maybeComment());
+                }
+                if (chance(tc, 10) && !fragileTail) {
+                    lines.add("");
+                }
+            }
+        } else if (t.kind.equals("seq")) {
+            for (Tree it : t.items) {
+                fragileTail = false;
+                List<String> block = it.kind.equals("string") ? blockScalarLines((String) it.value, indent) : null;
+                if (it.isColl() && it.size() > 0 && chance(tc, 50)) {
+                    // compact: "- k: v" / "- - a", the rest aligned under the first entry
+                    List<String> sub = blockLines(it, indent + 2);
+                    sub.set(0, pad + "- " + sub.get(0).substring(indent + 2));
+                    lines.addAll(sub);
+                } else if (it.isColl() && it.size() > 0) {
+                    lines.add(pad + "-" + maybeComment());
+                    lines.addAll(blockLines(it, indent + n(tc, 1, 4)));
+                } else if (block != null) {
+                    lines.add(pad + "- " + block.get(0));
+                    lines.addAll(block.subList(1, block.size()));
+                    fragileTail = isKeep(block);
+                } else if (it.isColl()) {
+                    lines.add(pad + "- " + flow(it) + maybeComment());
+                } else if (it.kind.equals("null") && chance(tc, 20)) {
+                    lines.add(pad + "-");
+                } else {
+                    lines.add(pad + "- " + sp() + scalar(it, false) + maybeComment());
+                }
+                if (chance(tc, 8) && !fragileTail) {
+                    lines.add("");
+                }
+            }
+        } else {
+            lines.add(pad + scalar(t, false));
+        }
+        return lines;
+    }
+
+    /** A whole document for the tree, as text; `style` records the top-level choices. */
+    String writeDocument(Tree t, boolean forceMarker, List<String> style) {
+        StringBuilder out = new StringBuilder();
+        if (chance(tc, 20)) {
+            out.append("# leading comment\n");
+            style.add("leading-comment");
+        }
+        if (chance(tc, 15)) {
+            out.append("\n");
+        }
+        boolean marker = forceMarker || chance(tc, 30);
+        if (marker) {
+            style.add("marker");
+        }
+        if (t.isColl() && t.size() > 0 && chance(tc, 80)) {
+            if (marker) {
+                out.append("---").append(chance(tc, 30) ? comment() : "").append("\n");
+            }
+            int indent = 0;
+            if (chance(tc, 15)) {
+                indent = n(tc, 1, 3);
+                style.add("indented-root");
+            }
+            out.append(String.join("\n", blockLines(t, indent))).append("\n");
+            style.add("block");
+        } else if (t.isColl()) {
+            if (marker) {
+                out.append("--- ");
+            }
+            out.append(flow(t)).append("\n");
+            style.add("flow");
+        } else if (t.kind.equals("string") && (literalOK((String) t.value) || foldedOK((String) t.value)) && chance(tc, 50)) {
+            // a top-level block scalar without an indentation indicator
+            String s = (String) t.value;
+            boolean useLiteral = literalOK(s) && (!foldedOK(s) || chance(tc, 60));
+            List<String> lines = useLiteral ? literal(s, -1, n(tc, 1, 4)) : folded(s, -1, n(tc, 1, 4));
+            lines.set(0, lines.get(0).replaceFirst("^([|>])([+-]?)[0-9]", "$1$2").replaceFirst("^([|>])[0-9]([+-])", "$1$2"));
+            out.append(marker ? "--- " : "").append(String.join("\n", lines)).append("\n");
+            style.add("block-scalar");
+        } else {
+            if (marker) {
+                out.append("--- ");
+            }
+            out.append(scalar(t, false)).append("\n");
+            style.add("scalar");
+        }
+        if (chance(tc, 20)) {
+            out.append("...\n");
+            style.add("end-marker");
+        }
+        if (chance(tc, 10)) {
+            out.append("# trailing comment\n");
+        }
+        return out.toString();
+    }
+
+    /** A stream of the given trees, later documents always marked with `---`. */
+    String writeStream(List<Tree> trees, List<String> style) {
+        StringBuilder out = new StringBuilder();
+        for (int i = 0; i < trees.size(); i++) {
+            out.append(writeDocument(trees.get(i), i > 0, style));
+        }
+        return out.toString();
+    }
+}
diff --git a/hegel/src/test/java/zoo/Zoo.java b/hegel/src/test/java/zoo/Zoo.java
new file mode 100644
index 0000000..ef08243
--- /dev/null
+++ b/hegel/src/test/java/zoo/Zoo.java
@@ -0,0 +1,114 @@
+package zoo;
+
+import dev.hegel.Database;
+import dev.hegel.Generators;
+import dev.hegel.Settings;
+import dev.hegel.TestCase;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Hegel zoo harness. {@link #settings} reads {@code HEGEL_TEST_CASES} and {@code HEGEL_DATABASE}
+ * (hegel-java itself reads no environment variable); {@link #fail} throws, or under
+ * {@code ZOO_COLLECT=1} prints a {@code COLLECT <message>} line once per distinct message and
+ * lets the test case go on, so one run shows every kind of mismatch at once.
+ */
+final class Zoo {
+    private Zoo() {}
+
+    static final boolean COLLECT = notEmpty(System.getenv("ZOO_COLLECT"));
+    private static final Set<String> SEEN = new LinkedHashSet<>();
+
+    static Settings settings(String name) {
+        Settings s = new Settings().name(name).testCases(testCases());
+        String db = System.getenv("HEGEL_DATABASE");
+        if (notEmpty(db)) {
+            s = s.database(Database.path(db));
+        }
+        return s;
+    }
+
+    static long testCases() {
+        String n = System.getenv("HEGEL_TEST_CASES");
+        return notEmpty(n) ? Long.parseLong(n.trim()) : 100;
+    }
+
+    static void fail(String msg) {
+        if (COLLECT) {
+            String key = msg.length() > 300 ? msg.substring(0, 300) : msg;
+            if (SEEN.add(key)) {
+                System.out.println("COLLECT " + msg.replace('\n', ' '));
+                System.out.flush();
+            }
+            return;
+        }
+        throw new AssertionError(msg);
+    }
+
+    static void check(boolean ok, Supplier<String> msg) {
+        if (!ok) {
+            fail(msg.get());
+        }
+    }
+
+    static void check(boolean ok, String msg) {
+        if (!ok) {
+            fail(msg);
+        }
+    }
+
+    /** An int in [lo, hi]. */
+    static int n(TestCase tc, int lo, int hi) {
+        return tc.draw(Generators.integers().min(lo).max(hi));
+    }
+
+    static boolean chance(TestCase tc, int pct) {
+        return n(tc, 0, 99) < pct;
+    }
+
+    @SafeVarargs
+    static <T> T pick(TestCase tc, T... xs) {
+        return tc.draw(Generators.sampledFrom(xs));
+    }
+
+    /** A string of lo..hi characters drawn from the alphabet. */
+    static String word(TestCase tc, String alphabet, int lo, int hi) {
+        int len = n(tc, lo, hi);
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(alphabet.charAt(n(tc, 0, alphabet.length() - 1)));
+        }
+        return sb.toString();
+    }
+
+    /** A readable rendering of a value: strings quoted with unprintables escaped, null as "null". */
+    static String show(Object o) {
+        if (o == null) {
+            return "null";
+        }
+        if (o instanceof String s) {
+            StringBuilder sb = new StringBuilder("\"");
+            for (int i = 0; i < s.length(); i++) {
+                char c = s.charAt(i);
+                if (c == '"' || c == '\\') {
+                    sb.append('\\').append(c);
+                } else if (c < 0x20 || c == 0x7f || (c >= 0xd800 && c <= 0xdfff) || c == '\u2028' || c == '\u2029') {
+                    sb.append(String.format("\\u%04x", (int) c));
+                } else {
+                    sb.append(c);
+                }
+            }
+            return sb.append('"').toString();
+        }
+        String s = o.toString();
+        if (o instanceof Number || o instanceof Boolean) {
+            return s + " (" + o.getClass().getSimpleName() + ")";
+        }
+        return s.length() > 400 ? s.substring(0, 400) + "…" : s;
+    }
+
+    private static boolean notEmpty(String s) {
+        return s != null && !s.isEmpty();
+    }
+}
diff --git a/hegel/src/test/java/zoo/ZooListener.java b/hegel/src/test/java/zoo/ZooListener.java
new file mode 100644
index 0000000..7e317bb
--- /dev/null
+++ b/hegel/src/test/java/zoo/ZooListener.java
@@ -0,0 +1,40 @@
+package zoo;
+
+import org.junit.platform.engine.TestExecutionResult;
+import org.junit.platform.engine.support.descriptor.MethodSource;
+import org.junit.platform.launcher.TestExecutionListener;
+import org.junit.platform.launcher.TestIdentifier;
+
+/**
+ * Hegel zoo: prints one {@code ZOO ok|FAILED|ignored <method>} line per test method on stdout;
+ * the zoo's judge reads these lines (registered in META-INF/services).
+ */
+public final class ZooListener implements TestExecutionListener {
+    private static String name(TestIdentifier id) {
+        return id.getSource()
+                .filter(s -> s instanceof MethodSource)
+                .map(s -> ((MethodSource) s).getMethodName())
+                .orElse(null);
+    }
+
+    @Override
+    public void executionFinished(TestIdentifier id, TestExecutionResult result) {
+        String n = name(id);
+        if (n == null || !id.isTest()) {
+            return;
+        }
+        String v = result.getStatus() == TestExecutionResult.Status.SUCCESSFUL ? "ok"
+                : result.getStatus() == TestExecutionResult.Status.ABORTED ? "ignored" : "FAILED";
+        System.out.println("ZOO " + v + " " + n);
+        System.out.flush();
+    }
+
+    @Override
+    public void executionSkipped(TestIdentifier id, String reason) {
+        String n = name(id);
+        if (n != null) {
+            System.out.println("ZOO ignored " + n);
+            System.out.flush();
+        }
+    }
+}
