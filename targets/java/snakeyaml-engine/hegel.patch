+package zoo;
+
+import static zoo.Zoo.check;
+
+import com.google.gson.JsonElement;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import org.junit.jupiter.api.Test;
+import org.snakeyaml.engine.v2.api.Dump;
+import org.snakeyaml.engine.v2.api.DumpSettings;
+import org.snakeyaml.engine.v2.api.DumpSettingsBuilder;
+import org.snakeyaml.engine.v2.api.Load;
+import org.snakeyaml.engine.v2.api.LoadSettings;
+import org.snakeyaml.engine.v2.common.FlowStyle;
+import org.snakeyaml.engine.v2.common.ScalarStyle;
+import org.snakeyaml.engine.v2.common.SpecVersion;
+import org.snakeyaml.engine.v2.schema.CoreSchema;
+import org.snakeyaml.engine.v2.schema.FailsafeSchema;
+
+/**
+ * One pin per recorded bug (bugs.toml). Each asserts the YAML 1.2 behaviour (or the engine's own
+ * documented behaviour) and so fails while the bug exists; target.toml lists them as expected failures.
+ */
+class EnginePinsTest {
+
+    static final LoadSettings CORE = LoadSettings.builder().setSchema(new CoreSchema()).build();
+    static final LoadSettings JSON = LoadSettings.builder().build();
+
+    static String load(LoadSettings s, String text) {
+        try {
+            return Canon.show(Canon.ofObject(new Load(s).loadFromString(text)));
+        } catch (RuntimeException e) {
+            return e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage()) + (e.getCause() != null ? " (caused by " + e.getCause().getClass().getSimpleName() + ")" : "");
+        }
+    }
+
+    static String loadAll(LoadSettings s, String text) {
+        List<JsonElement> docs = new ArrayList<>();
+        try {
+            for (Object o : new Load(s).loadAllFromString(text)) {
+                docs.add(Canon.ofObject(o));
+            }
+            return EngineTest.show(docs);
+        } catch (RuntimeException e) {
+            return e.getClass().getSimpleName() + ": " + EngineTest.firstLine(e.getMessage());
+        }
+    }
+
+    /** snakeyaml-engine/1: the core schema's float constructor fails on "+.inf". */
+    @Test
+    void pin1_plusInfinityUnderTheCoreSchema() {
+        for (String s : new String[] {"+.inf", "+.Inf", "+.INF"}) {
+            String back = load(CORE, s + "\n");
+            check(back.equals("{\"$f\":\"7ff0000000000000\"}"), () -> "'" + s + "' under the core schema loads as " + back);
+        }
+    }
+
+    /** snakeyaml-engine/2: the double-quoted escapes \L (U+2028) and \P (U+2029) are rejected. */
+    @Test
+    void pin2_lineAndParagraphSeparatorEscapes() {
+        String l = load(JSON, "\"a\\Lb\"\n");
+        check(l.equals("\"a\\u2028b\""), () -> "\"a\\Lb\" loads as " + l);
+        String p = load(JSON, "\"a\\Pb\"\n");
+        check(p.equals("\"a\\u2029b\""), () -> "\"a\\Pb\" loads as " + p);
+    }
+
+    /**
+     * snakeyaml-engine/3: dumpAll with a %YAML directive writes no "..." before the second document's directive
+     * (unless the first document was a plain scalar, after which the emitter is "open ended").
+     */
+    @Test
+    void pin3_severalDocumentsWithADirective() {
+        DumpSettings ds = DumpSettings.builder().setYamlDirective(Optional.of(new SpecVersion(1, 2))).build();
+        String[][] cases = {
+            {"{\"$m\":[[\"a\",{\"$n\":\"1\"}]]} | [{\"$n\":\"2\"}]"},
+            {"[{\"$n\":\"1\"}] | \"b\""},
+        };
+        List<List<Object>> streams = List.of(List.of(Map.of("a", 1), List.of(2)), List.of(List.of(1), "b"));
+        for (int i = 0; i < streams.size(); i++) {
+            String text = new Dump(ds).dumpAllToString(streams.get(i).iterator());
+            String back = loadAll(JSON, text);
+            String want = cases[i][0];
+            check(back.equals(want), () -> "the stream" + EngineTest.describe(text) + "loads back as " + back + " instead of " + want);
+        }
+    }
+
+    /** snakeyaml-engine/4: a literal block under an indented sequence indicator gets the wrong indentation indicator. */
+    @Test
+    void pin4_blockScalarsUnderAnIndicatorIndentLoadBack() {
+        DumpSettings ds = DumpSettings.builder().setIndent(2).setIndicatorIndent(1).setDefaultScalarStyle(ScalarStyle.LITERAL).build();
+        for (Object value : new Object[] {List.of(List.of("\n x")), Map.of("k", List.of("\n x")), List.of(" a\nb"), List.of(List.of("  x\ny"))}) {
+            String text = new Dump(ds).dumpToString(value);
+            String want = Canon.show(Canon.ofObject(value));
+            String back = load(JSON, text);
+            check(back.equals(want), () -> "the dump" + EngineTest.describe(text) + "loads back as " + back + " instead of " + want);
+        }
+    }
+
+    /**
+     * snakeyaml-engine/5: an indicator indent not smaller than the indent is accepted (without indentWithIndicator),
+     * and a block mapping inside a sequence is then written level with the "-" and the dump does not load back.
+     */
+    @Test
+    void pin5_indicatorIndentAtLeastTheIndent() {
+        Map<String, Object> inner = new LinkedHashMap<>();
+        inner.put("a", List.of(1, 2));
+        inner.put("b", 3);
+        Map<String, Object> outer = new LinkedHashMap<>();
+        outer.put("k", List.of(inner, "x", List.of(Map.of("c", 4))));
+        String want = Canon.show(Canon.ofObject(outer));
+        for (int[] ii : new int[][] {{1, 2}, {2, 2}, {2, 3}, {3, 3}, {4, 4}, {4, 9}}) {
+            for (FlowStyle fs : new FlowStyle[] {FlowStyle.AUTO, FlowStyle.BLOCK}) {
+                DumpSettingsBuilder b = DumpSettings.builder().setIndent(ii[0]).setIndicatorIndent(ii[1]).setDefaultFlowStyle(fs);
+                String text;
+                try {
+                    text = new Dump(b.build()).dumpToString(outer);
+                } catch (IllegalArgumentException e) {
+                    continue; // rejecting the setting would be right
+                }
+                String back = load(JSON, text);
+                check(back.equals(want), () -> "indent " + ii[0] + ", indicatorIndent " + ii[1] + ", " + fs + ": the dump" + EngineTest.describe(text) + "loads back as " + back + " instead of " + want);
+            }
+        }
+    }
+
+    /** snakeyaml-engine/6: a deeply indented double-quoted scalar is split into a bare backslash line and changes value. */
+    @Test
+    void pin6_deeplyIndentedDoubleQuotedStringsSurviveADump() {
+        Map<String, Object> value = Map.of("a", Map.of("b", Map.of("c", "x \n y")));
+        for (int width : new int[] {10, 12}) {
+            DumpSettings ds = DumpSettings.builder().setIndent(4).setWidth(width).setDefaultScalarStyle(ScalarStyle.DOUBLE_QUOTED).build();
+            String text = new Dump(ds).dumpToString(value);
+            String want = Canon.show(Canon.ofObject(value));
+            String back = load(JSON, text);
+            check(back.equals(want), () -> "width " + width + ": the dump" + EngineTest.describe(text) + "loads back as " + back + " instead of " + want);
+        }
+    }
+
+    /** snakeyaml-engine/7: the failsafe schema resolves empty scalars to !!null but has no constructor for that tag. */
+    @Test
+    void pin7_theFailsafeSchemaLoadsEmptyScalars() {
+        LoadSettings fs = LoadSettings.builder().setSchema(new FailsafeSchema()).build();
+        String[][] cases = {
+            {"a:\n", "{\"$m\":[[\"a\",\"\"]]}"},
+            {"- \n", "[\"\"]"},
+            {"{a: }\n", "{\"$m\":[[\"a\",\"\"]]}"},
+            {"- \n- x\n", "[\"\",\"x\"]"},
+            {"---\n", "\"\""},
+        };
+        for (String[] c : cases) {
+            String back = load(fs, c[0]);
+            check(back.equals(c[1]), () -> "the document" + EngineTest.describe(c[0]) + "loads under the failsafe schema as " + back + " instead of " + c[1]);
+        }
+        String empty = load(fs, "");
+        check(!empty.contains("NullPointerException"), () -> "the empty stream loads under the failsafe schema as " + empty);
+    }
+
+    /** snakeyaml-engine/9: the builder accepts an indent of 1 or 10 (its documented range) and the emitter then indents by 2. */
+    @Test
+    void pin9_theIndentSettingIsHonouredAtTheEndsOfItsRange() {
+        Map<String, Object> value = new LinkedHashMap<>();
+        Map<String, Object> inner = new LinkedHashMap<>();
+        inner.put("b", 1);
+        inner.put("c", List.of(2));
+        value.put("a", inner);
+        for (int indent : new int[] {1, 2, 3, 9, 10}) {
+            DumpSettings ds = DumpSettings.builder().setIndent(indent).build();
+            String text = new Dump(ds).dumpToString(value);
+            String pad = " ".repeat(indent);
+            String want = "a:\n" + pad + "b: 1\n" + pad + "c:\n" + pad + "- 2\n";
+            check(text.equals(want), () -> "indent " + indent + " gives" + EngineTest.describe(text) + "instead of" + EngineTest.describe(want));
+        }
+    }
+
+    /** snakeyaml-engine/10: an explicit !!int, !!float or !!binary tag on a scalar it does not fit leaks a raw exception; !!bool on a non-boolean is null. */
+    @Test
+    void pin10_aStandardTagOnAScalarItDoesNotFitFailsCleanly() {
+        String[] texts = {"!!int abc\n", "!!int 1.5\n", "!!int 0x\n", "!!float abc\n", "!!float ''\n", "!!float 1e\n", "!!binary '***'\n"};
+        for (String text : texts) {
+            for (LoadSettings s : new LoadSettings[] {CORE, JSON}) {
+                String back = load(s, text);
+                check(back.contains("Exception") && !back.contains("NumberFormatException") && !back.contains("IndexOutOfBounds") && !back.contains("IllegalArgumentException"), () -> text.trim() + " loads under the " + (s == CORE ? "core" : "json") + " schema as " + back);
+            }
+        }
+        for (LoadSettings s : new LoadSettings[] {CORE, JSON}) {
+            String back = load(s, "!!bool maybe\n");
+            check(back.contains("Exception"), () -> "!!bool maybe loads under the " + (s == CORE ? "core" : "json") + " schema as " + back);
+        }
+    }
+
+    /** snakeyaml-engine/8: a standard tag on the wrong node kind fails with a ClassCastException instead of a constructor error. */
+    @Test
+    void pin8_aStandardTagOnTheWrongNodeKindFailsCleanly() {
+        for (String text : new String[] {"!!bool [a]\n", "!!int [1]\n", "!!float {a: b}\n", "!!str [1]\n", "!!seq 1\n", "!!map x\n", "!!binary [1]\n", "!!set 1\n"}) {
+            for (LoadSettings s : new LoadSettings[] {CORE, JSON}) {
+                String back = load(s, text);
+                check(back.contains("Exception") && !back.contains("ClassCastException"), () -> text.trim() + " loads under the " + (s == CORE ? "core" : "json") + " schema as " + back);
+            }
+        }
+    }
+}
diff --git a/hegel/src/test/java/zoo/EngineTest.java b/hegel/src/test/java/zoo/EngineTest.java
new file mode 100644
index 0000000..4c0ee40
--- /dev/null
+++ b/hegel/src/test/java/zoo/EngineTest.java
@@ -0,0 +1,502 @@
+package zoo;
+
+import static zoo.Zoo.chance;
+import static zoo.Zoo.check;
+import static zoo.Zoo.n;
+import static zoo.Zoo.pick;
+
+import com.google.gson.JsonElement;
+import dev.hegel.Hegel;
+import dev.hegel.TestCase;
+import java.io.ByteArrayInputStream;
+import java.io.StringReader;
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.regex.Pattern;
+import org.junit.jupiter.api.Test;
+import org.snakeyaml.engine.v2.api.Load;
+import org.snakeyaml.engine.v2.api.LoadSettings;
+import org.snakeyaml.engine.v2.api.lowlevel.Compose;
+import org.snakeyaml.engine.v2.exceptions.YamlEngineException;
+import org.snakeyaml.engine.v2.nodes.Node;
+import org.snakeyaml.engine.v2.nodes.Tag;
+import org.snakeyaml.engine.v2.resolver.ScalarResolver;
+import org.snakeyaml.engine.v2.schema.CoreSchema;
+import org.snakeyaml.engine.v2.schema.FailsafeSchema;
+import org.snakeyaml.engine.v2.schema.JsonSchema;
+
+/**
+ * snakeyaml-engine's loader: a randomised YAML 1.2 writer produces documents whose value is known
+ * by construction (in the JSON schema's spellings or the core schema's), and the engine must load
+ * them as that value, from every input path; mutated documents must fail with the engine's own
+ * exceptions; plain scalars must type as the spec's regular expressions say.
+ */
+class EngineTest {
+
+    static LoadSettings settings(boolean core) {
+        return LoadSettings.builder().setSchema(core ? new CoreSchema() : new JsonSchema()).build();
+    }
+
+    /** What a load gave: the canonical form of every document, or an error. */
+    static final class Loaded {
+        final List<JsonElement> docs;
+        final Throwable cause;
+        final String error;
+
+        Loaded(List<JsonElement> docs, Throwable cause) {
+            this.docs = docs;
+            this.cause = cause;
+            this.error = cause == null ? null : cause.getClass().getSimpleName() + ": " + firstLine(cause.getMessage());
+        }
+
+        boolean ok() {
+            return cause == null;
+        }
+
+        @Override
+        public String toString() {
+            return ok() ? docs.size() + " doc(s): " + show(docs) : "error " + error;
+        }
+    }
+
+    static String firstLine(String s) {
+        if (s == null) {
+            return "null";
+        }
+        int i = s.indexOf('\n');
+        String l = i < 0 ? s : s.substring(0, i);
+        return l.length() > 200 ? l.substring(0, 200) + "…" : l;
+    }
+
+    static String show(List<JsonElement> docs) {
+        StringBuilder sb = new StringBuilder();
+        for (JsonElement d : docs) {
+            sb.append(sb.length() == 0 ? "" : " | ").append(Canon.show(d));
+        }
+        return sb.toString();
+    }
+
+    static Loaded loadAll(LoadSettings s, String text, int path) {
+        List<JsonElement> docs = new ArrayList<>();
+        try {
+            Load load = new Load(s);
+            Iterable<Object> it;
+            switch (path) {
+                case 1:
+                    it = load.loadAllFromReader(new StringReader(text));
+                    break;
+                case 2:
+                    it = load.loadAllFromInputStream(new ByteArrayInputStream(text.getBytes(StandardCharsets.UTF_8)));
+                    break;
+                default:
+                    it = load.loadAllFromString(text);
+            }
+            for (Object o : it) {
+                docs.add(Canon.ofObject(o));
+            }
+            return new Loaded(docs, null);
+        } catch (RuntimeException | StackOverflowError e) {
+            return new Loaded(null, e);
+        }
+    }
+
+    static Loaded loadAll(LoadSettings s, String text) {
+        return loadAll(s, text, 0);
+    }
+
+    static String describe(String text) {
+        StringBuilder sb = new StringBuilder("\n    ");
+        String shown = text.length() > 1500 ? text.substring(0, 1500) + "…" : text;
+        for (int i = 0; i < shown.length(); i++) {
+            char c = shown.charAt(i);
+            if (c == '\n') {
+                sb.append("\n    ");
+            } else if (c == '\t') {
+                sb.append("\\t");
+            } else if (c == '\r') {
+                sb.append("\\r");
+            } else if (c < 0x20 || c == 0x7f || c == 0x85 || c == 0xa0 || c == 0x2028 || c == 0x2029 || c == 0xfeff || (c >= 0xd800 && c <= 0xdfff)) {
+                sb.append(String.format("\\u%04x", (int) c));
+            } else {
+                sb.append(c);
+            }
+        }
+        return sb.append('\n').toString();
+    }
+
+    static List<YamlGen.Tree> genTrees(YamlGen g) {
+        int docs = chance(g.tc, 80) ? 1 : n(g.tc, 2, 4);
+        List<YamlGen.Tree> trees = new ArrayList<>();
+        for (int i = 0; i < docs; i++) {
+            trees.add(g.genTree(0));
+        }
+        return trees;
+    }
+
+    /** Shapes the writer may produce whose loading is a recorded bug (bugs.toml): compared no further. */
+    static String knownShape(String text) {
+        if (Pattern.compile("(^|[\\s\\[{,])\\+\\.(inf|Inf|INF)\\s*($|[\\s,\\]}#])").matcher(text).find()) {
+            return "+.inf (snakeyaml-engine/1)";
+        }
+        if (text.contains("\\L") || text.contains("\\P")) {
+            return "the escapes \\L and \\P (snakeyaml-engine/2)";
+        }
+        return null;
+    }
+
+    // ---- 1. written documents load as their trees ----------------------------------------------
+
+    @Test
+    void writtenDocumentsLoadAsTheirTrees() {
+        Hegel.test(tc -> {
+            boolean core = chance(tc, 50);
+            YamlGen g = new YamlGen(tc, core);
+            List<YamlGen.Tree> trees = genTrees(g);
+            List<String> style = new ArrayList<>();
+            String text = g.writeStream(trees, style);
+            if (knownShape(text) != null) {
+                return;
+            }
+            List<JsonElement> expected = new ArrayList<>();
+            for (YamlGen.Tree t : trees) {
+                expected.add(t.canon());
+            }
+            String tag = "style " + style + (core ? " core schema" : " json schema") + describe(text);
+            LoadSettings s = settings(core);
+            Loaded mine = loadAll(s, text);
+            check(mine.ok() && mine.docs.equals(expected), () -> "the engine loads " + mine + " instead of " + show(expected) + " for " + tag);
+            // the same through a Reader or an InputStream
+            int path = n(tc, 1, 2);
+            Loaded again = loadAll(s, text, path);
+            check(again.ok() && again.docs.equals(expected), () -> "loadAllFrom" + (path == 1 ? "Reader" : "InputStream") + " gives " + again + " instead of " + show(expected) + " for " + tag);
+            // one document: loadFromString agrees, composeString gives one node
+            if (trees.size() == 1 && !style.contains("end-marker")) {
+                try {
+                    JsonElement one = Canon.ofObject(new Load(s).loadFromString(text));
+                    check(one.equals(expected.get(0)), () -> "loadFromString gives " + Canon.show(one) + " instead of " + Canon.show(expected.get(0)) + " for " + tag);
+                } catch (RuntimeException e) {
+                    Zoo.fail("loadFromString threw " + e.getClass().getSimpleName() + ": " + firstLine(e.getMessage()) + " for " + tag);
+                }
+            }
+            // compose gives as many nodes as documents; the failsafe schema reads every scalar as a string
+            int count = 0;
+            for (Node nd : new Compose(s).composeAllFromString(text)) {
+                count++;
+            }
+            int c = count;
+            check(c == trees.size(), () -> "composeAllFromString gives " + c + " nodes for " + trees.size() + " documents for " + tag);
+            Loaded failsafe = loadAll(LoadSettings.builder().setSchema(new FailsafeSchema()).build(), text);
+            if (!failsafe.ok() && (String.valueOf(failsafe.error).contains("tag:yaml.org,2002:null") || (failsafe.cause instanceof NullPointerException && hasNullRoot(trees)))) {
+                return; // snakeyaml-engine/7: the failsafe schema tags empty scalars !!null and has no constructor for it
+            }
+            check(failsafe.ok() && failsafe.docs.size() == trees.size() && allScalarsAreStrings(failsafe.docs), () -> "the failsafe schema loads " + failsafe + " for " + tag);
+        }, Zoo.settings("writtenDocumentsLoadAsTheirTrees"));
+    }
+
+    static boolean hasLoneSurrogate(String s) {
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            if (Character.isHighSurrogate(c)) {
+                if (i + 1 < s.length() && Character.isLowSurrogate(s.charAt(i + 1))) {
+                    i++;
+                } else {
+                    return true;
+                }
+            } else if (Character.isLowSurrogate(c)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean hasNullRoot(List<YamlGen.Tree> trees) {
+        for (YamlGen.Tree t : trees) {
+            if (t.canon().isJsonNull()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    static boolean allScalarsAreStrings(List<JsonElement> docs) {
+        for (JsonElement d : docs) {
+            if (!stringsOnly(d)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static boolean stringsOnly(JsonElement e) {
+        if (e.isJsonNull()) {
+            return false; // a null scalar would be the string "null" under failsafe
+        }
+        if (e.isJsonPrimitive()) {
+            return e.getAsJsonPrimitive().isString();
+        }
+        if (e.isJsonArray()) {
+            for (JsonElement c : e.getAsJsonArray()) {
+                if (!stringsOnly(c)) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        if (e.getAsJsonObject().has("$m")) {
+            for (JsonElement pair : e.getAsJsonObject().getAsJsonArray("$m")) {
+                if (!stringsOnly(pair.getAsJsonArray().get(0)) || !stringsOnly(pair.getAsJsonArray().get(1))) {
+                    return false;
+                }
+            }
+            return true;
+        }
+        return false; // $n, $f, $b, $set
+    }
+
+    // ---- 2. mutated documents fail like YAML processors do -------------------------------------
+
+    static final String[] MUTATION_CHARS = {" ", " ", "\n", "\n", "\t", "-", ":", "?", ",", "[", "]", "{", "}", "#", "&", "*", "!", "|", ">", "'", "\"", "%", "@", "`", "\\", "a", "0", ".", "~", "---", "...", "  ", ": ", "- ", "&a ", "*a", "!!str ", "!!int ", "!!float ", "!!bool ", "!!null ", "!!binary ", "!!seq ", "!!map ", "!!set ", "!<tag:yaml.org,2002:str> ", "!foo ", "\r", "%YAML 1.2\n---\n", "%TAG ! tag:x,2000:\n---\n", "\ufeff", "<<: ", "+", "e", "E", "0x", "0o", ".inf", ".nan", "\\x41", "\\u00", "\\L"};
+
+    static String mutate(TestCase tc, String text) {
+        int edits = n(tc, 1, 3);
+        StringBuilder sb = new StringBuilder(text);
+        for (int e = 0; e < edits && sb.length() > 0; e++) {
+            int r = n(tc, 1, 10);
+            int at = n(tc, 0, sb.length());
+            if (r <= 4) {
+                sb.insert(at, pick(tc, MUTATION_CHARS));
+            } else if (r <= 6) {
+                if (at < sb.length()) {
+                    sb.deleteCharAt(at);
+                }
+            } else if (r <= 8) {
+                if (at < sb.length()) {
+                    sb.replace(at, at + 1, pick(tc, MUTATION_CHARS));
+                }
+            } else if (r == 9) {
+                List<String> lines = new ArrayList<>(java.util.Arrays.asList(sb.toString().split("\n", -1)));
+                int li = n(tc, 0, lines.size() - 1);
+                lines.set(li, " ".repeat(n(tc, 0, 6)) + lines.get(li).replaceFirst("^ +", ""));
+                sb = new StringBuilder(String.join("\n", lines));
+            } else {
+                List<String> lines = new ArrayList<>(java.util.Arrays.asList(sb.toString().split("\n", -1)));
+                if (lines.size() >= 2) {
+                    int li = n(tc, 0, lines.size() - 2);
+                    String a = lines.get(li);
+                    lines.set(li, lines.get(li + 1));
+                    lines.set(li + 1, a);
+                    sb = new StringBuilder(String.join("\n", lines));
+                }
+            }
+        }
+        return sb.toString();
+    }
